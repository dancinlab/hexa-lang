fn _flush_runtime_core_hxlcl_shim(out_path: str, buf: str) {
    let _ = exec("cat >> \"" + out_path + "\" <<'GEN_runtime_core_hxlcl_shim_EOF'\n" + buf + "GEN_runtime_core_hxlcl_shim_EOF")
}

