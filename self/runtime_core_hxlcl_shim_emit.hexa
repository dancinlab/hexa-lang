    buf = buf + " * byte-identical. */\n"
    buf = buf + "#ifndef HEXA_RT_SELFEMIT_POLL\n"
    buf = buf + "/* zero-c #29: raw-svc on 64-bit Linux via ppoll(fds,nfds,tmo,NULL,8) (SYS_ppoll x86_64=271 / arm64=73; arm64 has no legacy poll). timeout_ms<0 => NULL tmo (infinite). x86_64 4th=r10, 5th=r8. darwin/other keep libc. */\n"
    buf = buf + "int    hxlcl_poll(void *fds, unsigned int nfds, int timeout) {\n"
    buf = buf + "#if defined(__linux__) && (defined(__x86_64__) || defined(__aarch64__))\n"
    buf = buf + "    struct timespec _ts; long _tp = 0;\n"
