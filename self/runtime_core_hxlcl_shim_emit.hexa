    buf = buf + "    long _r; register long _r10 __asm__(\"r10\") = 0644L;\n"
    buf = buf + "    __asm__ volatile(\"syscall\" : \"=a\"(_r) : \"a\"(257L), \"D\"(-100L), \"S\"((long)path), \"d\"((long)flags), \"r\"(_r10) : \"rcx\", \"r11\", \"memory\"); return (int)(_r < 0 ? -1 : (int)_r);\n"
    buf = buf + "#elif defined(__linux__) && defined(__aarch64__)\n"
    buf = buf + "    register long _x8 __asm__(\"x8\") = 56L; register long _x0 __asm__(\"x0\") = -100L; register long _x1 __asm__(\"x1\") = (long)path; register long _x2 __asm__(\"x2\") = (long)flags; register long _x3 __asm__(\"x3\") = 0644L;\n"
    buf = buf + "    __asm__ volatile(\"svc 0\" : \"+r\"(_x0) : \"r\"(_x8), \"r\"(_x1), \"r\"(_x2), \"r\"(_x3) : \"memory\"); return (int)(_x0 < 0 ? -1 : (int)_x0);\n"
    buf = buf + "#else\n"
    buf = buf + "    return open(path, flags, 0644);\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "/* SELFEMIT (HEXA_RT_SELFEMIT_READ, default OFF · RFC061 §M8 family r3): like\n"
