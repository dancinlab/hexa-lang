    buf = buf + "#endif\n"
    buf = buf + "#endif\n"
    buf = buf + "/* RT-NATIVE-ATOF (HEXA_RT_NATIVE_ATOF, default OFF · fp-ABI xmm Route C · MIXED-ABI\n"
