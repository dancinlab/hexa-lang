    buf = buf + " * still link-present — the coupled-leaf reloc resolves either way. */\n"
    buf = buf + "#ifndef HEXA_RT_NATIVE_OPEN_SYS\n"
    buf = buf + "/* zero-c #29: raw-svc on 64-bit Linux via openat(AT_FDCWD,path,flags,0644) (SYS_openat x86_64=257 / arm64=56; arm64 has no legacy open). x86_64 4th arg in r10. Returns the fd, or -1 on error. darwin/other keep libc. */\n"
    buf = buf + "int    hxlcl_open_sys(const char *path, int flags, ...) {\n"
