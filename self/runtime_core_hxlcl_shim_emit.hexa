    buf = buf + "#endif\n"
    buf = buf + "/* SELFEMIT (HEXA_RT_SELFEMIT_ATOI, default OFF · RFC061 §M8 family r10): hxlcl_atoi is\n"
    buf = buf + " * supplied by the hexa-NATIVE self-emitted .o (test/native_build/emit_hxlcl_atoi_o.hexa\n"
