    buf = buf + " * dup2/close/execve/waitpid/malloc/fdopen + __errno_location as undefined externs resolved at\n"
    buf = buf + " * link by the rest of runtime.a (the SAME composition model pipe #4256 / fopen Wall 3-a use;\n"
    buf = buf + " * NO new provider). The whole emit (x86_64-linux) keeps the linux syscall legs and DCE's the\n"
    buf = buf + " * arm64/darwin legs; objcopy keeps ONLY hxlcl_popen + hxlcl_pclose global (the 3 table/exit\n"
    buf = buf + " * helpers stay local intra-.o). ld -r multidef gate (S5) is the AUTHORITY. The native bodies\n"
    if buf.len() > 65536 { _flush_runtime_core_hxlcl_shim(out_path, buf); buf = "" }
    buf = buf + " * are FAITHFUL to the frozen 0-libc floor emitter (self/runtime_emit_full.hexa:3051-3091),\n"
    buf = buf + " * NOT to this shim's libc popen/pclose delegate (standalone-libc measurement TU only).\n"
    buf = buf + " * \"r\"-mode only (the only mode hexa_exec uses). Under HEXA_RT_NATIVE_POPEN=1 /\n"
    buf = buf + " * HEXA_RT_NATIVE_PCLOSE=1 (x86_64-linux gate in tool/stage_resolve_runtime_a) the shim drops\n"
    buf = buf + " * each. DEFAULT (both unset) keeps these libc delegates → shim.o + archive byte-identical\n"
    buf = buf + " * (release-integrity invariant). default-OFF byteeq-neutral. */\n"
    buf = buf + "#ifndef HEXA_RT_NATIVE_POPEN\n"
    buf = buf + "void  *hxlcl_popen(const char *cmd, const char *mode) { return (void *)popen(cmd, mode); }\n"
