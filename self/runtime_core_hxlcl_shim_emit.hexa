    buf = buf + "void  *hxlcl_calloc(size_t nmemb, size_t size)        { size_t total = (nmemb ? nmemb : 1) * (size ? size : 1); void *p = hxlcl_malloc(total); if (p) hxlcl_memset(p, 0, total); return p; }\n"
    buf = buf + "#else\n"
    buf = buf + "void  *hxlcl_calloc(size_t nmemb, size_t size)        { return calloc(nmemb ? nmemb : 1, size ? size : 1); }\n"
    buf = buf + "#endif\n"
    buf = buf + "#endif\n"
    buf = buf + "#endif\n"
    buf = buf + "#endif /* !HEXA_RT_NATIVE_CALLOC */\n"
    buf = buf + "/* SELFEMIT (HEXA_RT_SELFEMIT_MEMCPY, default OFF · RFC061 §M8 family r3):\n"
