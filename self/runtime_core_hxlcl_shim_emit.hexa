    if buf.len() > 65536 { _flush_runtime_core_hxlcl_shim(out_path, buf); buf = "" }
    buf = buf + " * Self-contained leaf — no external callee, no errno provider. DEFAULT (macro undefined)\n"
    buf = buf + " * keeps this libc delegate → shim.o byte-identical. */\n"
    buf = buf + "#ifndef HEXA_RT_SELFEMIT_FCNTL\n"
    buf = buf + "/* zero-c #29: raw-svc on 64-bit Linux (SYS_fcntl x86_64=72 / arm64=25); darwin/other keep libc. Returns the fcntl result (fd/flags), or -1 on error. */\n"
    buf = buf + "int    hxlcl_fcntl(int fd, int cmd, long arg) {\n"
