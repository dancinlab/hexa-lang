    buf = buf + "#ifndef HEXA_RT_NATIVE_PCLOSE\n"
    buf = buf + "int    hxlcl_pclose(void *stream)                     { return pclose((FILE *)stream); }\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "/* ── time ────────────────────────────────────────────────────────────────── */\n"
    buf = buf + "/* RT-NATIVE-TIME (HEXA_RT_NATIVE_TIME, default OFF · proc group): hxlcl_time leaves the\n"
    buf = buf + " * shim via the fp-ABI Route C whole-module emit. The native body\n"
    buf = buf + " * (stdlib/runtime/hxlcl_core.hexa::hxlcl_time) is a PURE syscall leaf under the\n"
    buf = buf + " * x86_64-linux emit target: the live leg is `__hx_syscall6(201, …)` (__NR_time —\n"
    buf = buf + " * REGISTER-CLEAN, the kernel returns the epoch in the result reg, no buffer) + a\n"
    buf = buf + " * NULL-gated `__hx_ptr_store32(t, …)` out-param write. ZERO inner C-ABI callee, zero\n"
    buf = buf + " * errno, zero extern-data (the arm64/darwin gettimeofday legs that pull hxlcl_malloc are\n"
    buf = buf + " * DCE'd out under target_is_x86_64). objcopy isolates ONLY hxlcl_time. Under\n"
    buf = buf + " * HEXA_RT_NATIVE_TIME=1 (x86_64-linux gate in tool/stage_resolve_runtime_a) the shim\n"
    buf = buf + " * drops time (#ifndef below). DEFAULT (unset) keeps this libc delegate → shim.o + archive\n"
    buf = buf + " * byte-identical (release-integrity invariant). */\n"
    buf = buf + "#ifndef HEXA_RT_NATIVE_TIME\n"
    buf = buf + "/* zero-c #29: raw-svc time via clock_gettime(CLOCK_REALTIME=0) on 64-bit Linux — musl src/time/time.c (no __NR_time on arm64); SYS_clock_gettime x86_64=228 / arm64=113; darwin/other keep libc time(). */\n"
    buf = buf + "int    hxlcl_time(int *t) {\n"
    buf = buf + "#if defined(__linux__) && defined(__x86_64__)\n"
    buf = buf + "    long _ts[2] = {0L, 0L}; long _r; __asm__ volatile(\"syscall\" : \"=a\"(_r) : \"a\"(228L), \"D\"(0L), \"S\"((long)_ts) : \"rcx\", \"r11\", \"memory\"); (void)_r; if (t) *t = (int)_ts[0]; return (int)_ts[0];\n"
    buf = buf + "#elif defined(__linux__) && defined(__aarch64__)\n"
    buf = buf + "    long _ts[2] = {0L, 0L}; register long _x8 __asm__(\"x8\") = 113L; register long _x0 __asm__(\"x0\") = 0L; register long _x1 __asm__(\"x1\") = (long)_ts; __asm__ volatile(\"svc 0\" : \"+r\"(_x0) : \"r\"(_x8), \"r\"(_x1) : \"memory\"); (void)_x0; if (t) *t = (int)_ts[0]; return (int)_ts[0];\n"
    buf = buf + "#else\n"
    buf = buf + "    time_t r = time(NULL); if (t) *t = (int)r; return (int)r;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "/* RT-NATIVE-CLOCK_GETTIME (HEXA_RT_NATIVE_CLOCK_GETTIME, default OFF · proc group):\n"
    buf = buf + " * hxlcl_clock_gettime leaves the shim via the fp-ABI Route C whole-module emit (time\n"
    buf = buf + " * #4250-era / open_sys / fork precedent). The native body\n"
    buf = buf + " * (stdlib/runtime/hxlcl_core.hexa::hxlcl_clock_gettime, whitelisted in _is_cabi) is a\n"
    buf = buf + " * syscall leaf: under the x86_64-linux emit target the live leg is\n"
    buf = buf + " * `__hx_syscall6(228, clk, ts, …)` (__NR_clock_gettime — the kernel writes the caller's\n"
    buf = buf + " * timespec out-ptr) + a negative-result errno store via `bl __errno_location` (glibc-\n"
    buf = buf + " * provided, resolved at link — the same errno provider the libc-delegate shim already\n"
    buf = buf + " * pulls; NO new provider). The arm64 (NR 113) + darwin (no trap → gettimeofday(116)\n"
    buf = buf + " * synthesize, sec/usec*1000 into the out-ptr, leak-free) legs are DCE'd out under\n"
    buf = buf + " * target_is_x86_64. ZERO inner C-ABI callee, zero extern-data, zero malloc scratch.\n"
    buf = buf + " * objcopy isolates ONLY hxlcl_clock_gettime; its `bl __errno_location` is an undefined\n"
    buf = buf + " * external resolved by libc. BYTE-FAITHFUL to the frozen 0-libc floor body\n"
    buf = buf + " * (self/runtime_emit_full.hexa:1977-1990 darwin gettimeofday synth / linux syscall leg),\n"
    buf = buf + " * NOT to this shim's libc clock_gettime(3) delegate (standalone-libc measurement TU only).\n"
    buf = buf + " * Under HEXA_RT_NATIVE_CLOCK_GETTIME=1 (x86_64-linux gate in tool/stage_resolve_runtime_a)\n"
    buf = buf + " * the shim drops clock_gettime (#ifndef below). DEFAULT (unset) keeps this libc delegate →\n"
    buf = buf + " * shim.o + archive byte-identical (release-integrity invariant). */\n"
    buf = buf + "#ifndef HEXA_RT_NATIVE_CLOCK_GETTIME\n"
    buf = buf + "/* zero-c #29: raw-svc on 64-bit Linux (SYS_clock_gettime x86_64=228 / arm64=113); darwin/other keep libc. */\n"
    buf = buf + "int    hxlcl_clock_gettime(int clk, void *ts) {\n"
    buf = buf + "#if defined(__linux__) && defined(__x86_64__)\n"
    buf = buf + "    long _r; __asm__ volatile(\"syscall\" : \"=a\"(_r) : \"a\"(228L), \"D\"((long)clk), \"S\"((long)ts) : \"rcx\", \"r11\", \"memory\"); return (int)(_r < 0 ? -1 : 0);\n"
    buf = buf + "#elif defined(__linux__) && defined(__aarch64__)\n"
    buf = buf + "    register long _x8 __asm__(\"x8\") = 113L; register long _x0 __asm__(\"x0\") = (long)clk; register long _x1 __asm__(\"x1\") = (long)ts;\n"
    buf = buf + "    __asm__ volatile(\"svc 0\" : \"+r\"(_x0) : \"r\"(_x8), \"r\"(_x1) : \"memory\"); return (int)(_x0 < 0 ? -1 : 0);\n"
    buf = buf + "#else\n"
    buf = buf + "    return clock_gettime((clockid_t)clk, (struct timespec *)ts);\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "size_t hxlcl_strftime(char *buf, size_t cap, const char *fmt, void *tm) { return strftime(buf, cap, fmt, (struct tm *)tm); }\n"
    if buf.len() > 65536 { _flush_runtime_core_hxlcl_shim(out_path, buf); buf = "" }
    buf = buf + "/* SELFEMIT (HEXA_RT_SELFEMIT_GETRUSAGE, default OFF · RFC061 §M8 family #29): hxlcl_getrusage\n"
    buf = buf + " * is supplied by the hexa-NATIVE self-emitted .o (test/native_build/emit_hxlcl_getrusage_o.hexa\n"
    buf = buf + " * — class-C `svc #0x80` SYS_getrusage trap + carry-flag errno store, byte-identical to\n"
    buf = buf + " * self/codegen/runtime_arm64.hexa::rt_getrusage, refs the shared `_hxlcl_errno`). DEFAULT\n"
    buf = buf + " * (macro undefined) keeps this libc delegate → shim.o byte-identical. */\n"
    buf = buf + "#ifndef HEXA_RT_SELFEMIT_GETRUSAGE\n"
    buf = buf + "/* zero-c #29: raw-svc on 64-bit Linux (SYS_getrusage x86_64=98 / arm64=165); darwin/other keep libc. */\n"
    buf = buf + "int    hxlcl_getrusage(int who, void *usage) {\n"
    buf = buf + "#if defined(__linux__) && defined(__x86_64__)\n"
    buf = buf + "    long _r; __asm__ volatile(\"syscall\" : \"=a\"(_r) : \"a\"(98L), \"D\"((long)who), \"S\"((long)usage) : \"rcx\", \"r11\", \"memory\"); return (int)(_r < 0 ? -1 : 0);\n"
    buf = buf + "#elif defined(__linux__) && defined(__aarch64__)\n"
    buf = buf + "    register long _x8 __asm__(\"x8\") = 165L; register long _x0 __asm__(\"x0\") = (long)who; register long _x1 __asm__(\"x1\") = (long)usage;\n"
    buf = buf + "    __asm__ volatile(\"svc 0\" : \"+r\"(_x0) : \"r\"(_x8), \"r\"(_x1) : \"memory\"); return (int)(_x0 < 0 ? -1 : 0);\n"
    buf = buf + "#else\n"
    buf = buf + "    return getrusage(who, (struct rusage *)usage);\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "/* ── exceptions (setjmp/longjmp) ─────────────────────────────────────────── */\n"
    buf = buf + "/* OWNER POLARITY (RFC061 #29 multi-object flip · darwin multidef fix):\n"
    buf = buf + " * On darwin-arm64 the FROZEN runtime.c blob already DEFINES `_hxlcl_setjmp` /\n"
    buf = buf + " * `_hxlcl_longjmp` with EXTERNAL linkage — the hand-written naked-asm pair\n"
    buf = buf + " * (runtime.c tail, cycle 86) that compiled programs' try-blocks bind via\n"
    buf = buf + " * `bl _hxlcl_setjmp` (codegen arm64_darwin.hexa). Under the include-drop\n"
    buf = buf + " * multi-object archive that global pair lives in runtime.o, so the sibling\n"
    buf = buf + " * shim must NOT re-define it (ld would see 2 duplicate global symbols and the\n"
    buf = buf + " * Case-B multidef gate FATALs). On Linux runtime.c uses `#define hxlcl_setjmp`\n"
    buf = buf + " * (a libc-setjmp call-site macro) + a `static` hxlcl_longjmp — neither is an\n"
    buf = buf + " * externally-linkable symbol in runtime.o — so the shim is the SOLE provider\n"
    buf = buf + " * of the global pair the standalone runtime_core.o references. Hence: define\n"
    buf = buf + " * the libc-delegate pair here EXCEPT on Apple, where runtime.o owns it. This\n"
    buf = buf + " * is the same owner-dedup discipline the gate already relies on for\n"
    buf = buf + " * _hexa_init_fn_shims (runtime.o=1T, sibling=U). DEFAULT single-TU build never\n"
    buf = buf + " * compiles this shim, so byteeq is unaffected. */\n"
    buf = buf + "/* RFC061 §M8 ∅−8 re-baseline: x86_64-linux is EXCLUDED here — the re-baselined\n"
    buf = buf + " * runtime.o now OWNS the native musl-layout hxlcl_setjmp/hxlcl_longjmp pair on\n"
    buf = buf + " * x86_64 (self/runtime_emit_full.hexa / synthesized runtime.c\n"
    buf = buf + " * `#if defined(__x86_64__)`), mirroring the darwin owner-dedup above (runtime.o\n"
    buf = buf + " * owns _hxlcl_*; the shim excludes it to avoid a Case-B multidef). The shim\n"
    buf = buf + " * keeps the libc-delegate wrapper ONLY for arm64-linux (and any other\n"
    buf = buf + " * non-x86_64 non-Apple linux arch), where runtime.c still uses the macro form. */\n"
    buf = buf + "#if !defined(__APPLE__) && !defined(__x86_64__)\n"
    buf = buf + "int    hxlcl_setjmp(void *buf)                        { return setjmp(*(jmp_buf *)buf); }\n"
    buf = buf + "void   hxlcl_longjmp(void *buf, int val)              { longjmp(*(jmp_buf *)buf, val ? val : 1); }\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "/* ── backtrace (best-effort; no-op where unavailable) ────────────────────── */\n"
    buf = buf + "#ifdef __linux__\n"
    buf = buf + "/* real backtrace()/backtrace_symbols_fd() are glibc-only — gate on __GLIBC__ so\n"
    buf = buf + " * musl-linux (static release) takes the stub arm instead of an undefined symbol. */\n"
    buf = buf + "#if defined(HEXA_ZEROC_SHIM_BYTEID_EMIT) || !defined(__GLIBC__)\n"
    buf = buf + "/* byte-identical to frozen self/runtime.c hxlcl_backtrace (verbatim 0-libc floor body) */\n"
    buf = buf + "int __attribute__((noinline)) hxlcl_backtrace(void **buf, int sz) {\n"
    buf = buf + "    (void)buf; (void)sz;\n"
    buf = buf + "    return 0;  // 0 frames captured — hexa-native stub, no real unwinder\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "int  hxlcl_backtrace(void **buf, int sz)              { return backtrace(buf, sz); }\n"
    buf = buf + "#endif\n"
    if buf.len() > 65536 { _flush_runtime_core_hxlcl_shim(out_path, buf); buf = "" }
    buf = buf + "#if defined(HEXA_ZEROC_SHIM_BYTEID_EMIT)\n"
    buf = buf + "/* byte-identical to frozen self/runtime.c hxlcl_backtrace_symbols_fd (verbatim 0-libc floor body) */\n"
    buf = buf + "void __attribute__((noinline)) hxlcl_backtrace_symbols_fd(void *const *buf, int sz, int fd) {\n"
    buf = buf + "    (void)buf; (void)sz;\n"
    buf = buf + "    static const char msg[] = \"(backtrace unavailable — hexa-native stub)\\n\";\n"
    buf = buf + "    hxlcl_write(fd, msg, sizeof(msg) - 1);\n"
    buf = buf + "}\n"
    buf = buf + "#elif defined(__GLIBC__)\n"
    buf = buf + "void hxlcl_backtrace_symbols_fd(void *const *buf, int sz, int fd) { backtrace_symbols_fd(buf, sz, fd); }\n"
    buf = buf + "#else\n"
    buf = buf + "/* musl: pure no-op — the BYTEID stub's hxlcl_write isn't linked in non-BYTEID musl builds. */\n"
    buf = buf + "void hxlcl_backtrace_symbols_fd(void *const *buf, int sz, int fd) { (void)buf; (void)sz; (void)fd; }\n"
    buf = buf + "#endif\n"
    buf = buf + "#else\n"
    buf = buf + "int  hxlcl_backtrace(void **buf, int sz)              { (void)buf; (void)sz; return 0; }\n"
    buf = buf + "void hxlcl_backtrace_symbols_fd(void *const *buf, int sz, int fd) { (void)buf; (void)sz; (void)fd; }\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "/* ── darwin mach task_info (no-op on linux; runtime_core.c guards usage) ──── */\n"
    buf = buf + "int  hxlcl_task_info(unsigned int target, unsigned int flavor, void *info_out, unsigned int *count) {\n"
    buf = buf + "    (void)target; (void)flavor; (void)info_out; (void)count; return -1;\n"
    buf = buf + "}\n"
    if buf.len() > 0 { _flush_runtime_core_hxlcl_shim(out_path, buf) }
}

fn main() {
    let argv = real_args()
    let out_path = if argv.len() >= 1 { argv[0] } else { "runtime_core_hxlcl_shim.c" }
    emit_runtime_core_hxlcl_shim_to(out_path)
    let exists_check = exec("[ -f \"" + out_path + "\" ] && echo y || echo n").trim()
    if exists_check != "y" {
        println("[runtime_core_hxlcl_shim_emit] FATAL: failed to write " + out_path)
        exit(1)
    }
    println("[runtime_core_hxlcl_shim_emit] wrote " + out_path)
    exit(0)
}
