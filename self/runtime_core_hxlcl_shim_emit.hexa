    buf = buf + "\n"
    buf = buf + "/* ── string ──────────────────────────────────────────────────────────────── */\n"
    buf = buf + "/* SELFEMIT (HEXA_RT_SELFEMIT_STRLEN, default OFF · RFC061 §M8 family r3):\n"
