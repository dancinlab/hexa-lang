    buf = buf + "/* zeroc #29 str-leaf DEFAULT-native: musl word-at-a-time scan. S4 MUST compile with\n"
    buf = buf + " * -fno-builtin-strlen (the align-prologue and tail byte loops are strlen-shaped; clang's\n"
