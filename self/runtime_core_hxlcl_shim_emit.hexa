    buf = buf + "#ifndef HEXA_RT_NATIVE_STRCMP\n"
    buf = buf + "#ifndef HEXA_RT_SELFEMIT_STRCMP\n"
    buf = buf + "#ifdef HEXA_ZEROC_SHIM_BYTEID_EMIT\n"
    buf = buf + "/* byte-identical to frozen self/runtime.c hxlcl_strcmp (verbatim 0-libc floor body) */\n"
    buf = buf + "int __attribute__((noinline)) hxlcl_strcmp(const char *a, const char *b) {\n"
    buf = buf + "    for (size_t i = 0; ; i++) {\n"
    buf = buf + "        unsigned char ca = (unsigned char)a[i];\n"
