    buf = buf + "#endif\n"
    buf = buf + "/* SELFEMIT (HEXA_RT_SELFEMIT_FCNTL, default OFF · RFC061 §M8 family r10): hxlcl_fcntl is\n"
    buf = buf + " * supplied by the hexa-NATIVE self-emitted .o (test/native_build/emit_hxlcl_fcntl_o.hexa\n"
    buf = buf + " * — class-C SYS_fcntl `svc #0x80` via plain _hxlcl_syscall3, NON-_cf no-errno: dual-sxtw\n"
