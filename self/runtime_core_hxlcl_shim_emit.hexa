    buf = buf + "/* byte-identical to frozen self/runtime.c hxlcl_strdup (verbatim 0-libc floor body) */\n"
    buf = buf + "char *__attribute__((noinline)) hxlcl_strdup(const char *s) {\n"
    buf = buf + "    if (!s) return NULL;\n"
