    buf = buf + "#endif /* !HEXA_RT_NATIVE_STRCHR */\n"
    buf = buf + "/* RT-NATIVE-STRSTR (HEXA_RT_NATIVE_STRSTR, default OFF · literal-∅ non-libm leaf):\n"
