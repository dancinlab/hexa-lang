    buf = buf + "#elif defined(__linux__) && defined(__aarch64__)\n"
    buf = buf + "    register long _x8 __asm__(\"x8\") = 79L; register long _x0 __asm__(\"x0\") = -100L; register long _x1 __asm__(\"x1\") = (long)path; register long _x2 __asm__(\"x2\") = (long)buf; register long _x3 __asm__(\"x3\") = 0L;\n"
    buf = buf + "    __asm__ volatile(\"svc 0\" : \"+r\"(_x0) : \"r\"(_x8), \"r\"(_x1), \"r\"(_x2), \"r\"(_x3) : \"memory\"); return (int)(_x0 < 0 ? -1 : 0);\n"
    buf = buf + "#else\n"
