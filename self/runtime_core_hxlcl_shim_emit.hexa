    buf = buf + "#ifndef HEXA_RT_NATIVE_STRNCMP\n"
    buf = buf + "#ifndef HEXA_RT_SELFEMIT_STRNCMP\n"
    buf = buf + "#ifdef HEXA_ZEROC_SHIM_BYTEID_EMIT\n"
