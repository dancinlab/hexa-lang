    buf = buf + " * setvbuf noop stay byte-equivalent to the proven ship path — with fopen now\n"
    buf = buf + " * fake-fd, a bare-glibc setvbuf/fputs handed a (void*)(fd+1) would SIGSEGV. */\n"
    buf = buf + "int __attribute__((noinline)) hxlcl_fputs(const char *s, void *fp) {\n"
    buf = buf + "    int fd = 1; if (fp == (void *)stderr) fd = 2;\n"
    buf = buf + "    if (!s) return -1;\n"
    buf = buf + "    size_t n = 0; while (((const volatile char *)s)[n]) n++;\n"
    buf = buf + "    return (int)hxlcl_write(fd, s, n);\n"
    buf = buf + "}\n"
