    buf = buf + "#elif defined(__linux__) && defined(__aarch64__)\n"
    buf = buf + "    register long _x8 __asm__(\"x8\") = 25L; register long _x0 __asm__(\"x0\") = (long)fd; register long _x1 __asm__(\"x1\") = (long)cmd; register long _x2 __asm__(\"x2\") = arg;\n"
    buf = buf + "    __asm__ volatile(\"svc 0\" : \"+r\"(_x0) : \"r\"(_x8), \"r\"(_x1), \"r\"(_x2) : \"memory\"); return (_x0 < 0) ? -1 : (int)_x0;\n"
    buf = buf + "#else\n"
