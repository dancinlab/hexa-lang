    buf = buf + "}\n"
    buf = buf + "int __attribute__((noinline)) hxlcl_fflush(void *fp) {\n"
    buf = buf + "    (void)fp;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "/* fputs/fputc/setvbuf: mirror the single-TU amalgam's coherent redirect set so\n"
