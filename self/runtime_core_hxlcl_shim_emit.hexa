    buf = buf + "#if defined(__x86_64__)\n"
    buf = buf + "    long _r; register long _r10 __asm__(\"r10\") = 0L; register long _r8 __asm__(\"r8\") = 8L;\n"
    buf = buf + "    __asm__ volatile(\"syscall\" : \"=a\"(_r) : \"a\"(271L), \"D\"((long)fds), \"S\"((long)nfds), \"d\"(_tp), \"r\"(_r10), \"r\"(_r8) : \"rcx\", \"r11\", \"memory\"); return (int)(_r < 0 ? -1 : (int)_r);\n"
    buf = buf + "#else\n"
    buf = buf + "    register long _x8 __asm__(\"x8\") = 73L; register long _x0 __asm__(\"x0\") = (long)fds; register long _x1 __asm__(\"x1\") = (long)nfds; register long _x2 __asm__(\"x2\") = _tp; register long _x3 __asm__(\"x3\") = 0L; register long _x4 __asm__(\"x4\") = 8L;\n"
    buf = buf + "    __asm__ volatile(\"svc 0\" : \"+r\"(_x0) : \"r\"(_x8), \"r\"(_x1), \"r\"(_x2), \"r\"(_x3), \"r\"(_x4) : \"memory\"); return (int)(_x0 < 0 ? -1 : (int)_x0);\n"
    buf = buf + "#endif\n"
