    buf = buf + " * abort: runtime_core map keys were hxlcl_strdup'd=base+16 but freed via bare libc). */\n"
    buf = buf + "#ifndef HXLCL_ALLOC_MAGIC\n"
    buf = buf + "#define HXLCL_ALLOC_MAGIC ((size_t)0xA110CA7EDA7A600DULL)\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifdef HEXA_RT_HEAP_NATIVE\n"
    buf = buf + "/* FLIP-6 - native RECLAIMING heap allocator (HEXA_RT_HEAP_NATIVE, default OFF ,\n"
    buf = buf + " * axis-2 terminal flip). Segregated size-class free-lists (non-coalescing, LIFO)\n"
