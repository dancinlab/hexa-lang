    buf = buf + "#endif\n"
    buf = buf + "/* RT-NATIVE-POPEN / RT-NATIVE-PCLOSE (HEXA_RT_NATIVE_POPEN / _PCLOSE, default OFF ·\n"
    buf = buf + " * Route C whole-module emit · Wall 3-c COMPOSITE · the LAST drop-ready frozen-safe leaf\n"
    buf = buf + " * pair). popen/pclose leave the shim together: the native bodies\n"
    buf = buf + " * (stdlib/runtime/hxlcl_core.hexa::hxlcl_popen :2642 / hxlcl_pclose :2716, whitelisted in\n"
    buf = buf + " * _is_cabi at x86_64_linux.hexa:2404-2421) replicate libc popen/pclose with NO libc popen\n"
    buf = buf + " * call — popen(\"cmd\",\"r\") = pipe()+fork()+dup2()+execve(\"/bin/sh\",\"-c\",cmd) (ALL already-\n"
    buf = buf + " * dissolved Route C leaves) returning the CORE-family (read_fd+1) fake FILE*; pclose decodes\n"
    buf = buf + " * fd=fp-1, looks the child pid up in a file-local fd→pid table and close()+waitpid()s it.\n"
