    buf = buf + " * base[8..16)=MAGIC, user ptr base+16) UNCHANGED. Reference-match: tcmalloc\n"
    buf = buf + " * central-freelist size classes + O(1) LIFO push (per-thread caches stripped) for\n"
    buf = buf + " * the small path; dlmalloc mmap_threshold behavior (each large chunk its own\n"
    buf = buf + " * mapping, free==munmap, RSS returns to the OS immediately) for the large path.\n"
    buf = buf + " * DEFAULT (macro undefined) -> this whole block preprocesses away -> shim.o + the\n"
    buf = buf + " * archive byte-identical (release-integrity invariant, PR-A byteeq-neutral). */\n"
    buf = buf + "#include <sys/mman.h>\n"
    buf = buf + "extern void *hxlcl_memset(void *s, int c, size_t n);\n"
    buf = buf + "#define HXHEAP_ARENA_SZ  (4u*1024u*1024u)\n"
    buf = buf + "#define HXHEAP_SMALL_MAX 4096\n"
    buf = buf + "static const unsigned short hxheap_class_sz[27] = {\n"
    buf = buf + "  32,48,64,80,96,112,128,160,192,224,256,320,384,448,512,\n"
    buf = buf + "  640,768,896,1024,1280,1536,1792,2048,2560,3072,3584,4096 };\n"
    buf = buf + "static void *hxheap_freelist[27];\n"
    buf = buf + "static char *hxheap_arena_ptr, *hxheap_arena_end;\n"
    buf = buf + "static volatile int hxheap_lock;\n"
    buf = buf + "static inline void hxheap_lock_acquire(void) {\n"
    buf = buf + "    while (__atomic_test_and_set(&hxheap_lock, __ATOMIC_ACQUIRE)) { }\n"
    buf = buf + "}\n"
    buf = buf + "static inline void hxheap_lock_release(void) {\n"
    buf = buf + "    __atomic_clear(&hxheap_lock, __ATOMIC_RELEASE);\n"
    buf = buf + "}\n"
    buf = buf + "static inline size_t hxheap_align16(size_t n) { return (n + 15u) & ~(size_t)15u; }\n"
    buf = buf + "static int hxheap_class_of(size_t total) {\n"
    buf = buf + "    if (total > (size_t)HXHEAP_SMALL_MAX) return -1;\n"
    buf = buf + "    for (int i = 0; i < 27; i++) if ((size_t)hxheap_class_sz[i] >= total) return i;\n"
    buf = buf + "    return -1;\n"
    buf = buf + "}\n"
    buf = buf + "void *hxheap_alloc(size_t n) {\n"
    buf = buf + "    size_t total = hxheap_align16(n + HXLCL_HDR_BYTES);\n"
    buf = buf + "    unsigned char *base;\n"
    buf = buf + "    int ci = hxheap_class_of(total);\n"
    buf = buf + "    if (ci < 0) {\n"
    buf = buf + "        base = (unsigned char *)mmap((void *)0, total, PROT_READ | PROT_WRITE,\n"
    buf = buf + "                                     MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);\n"
    buf = buf + "        if (base == (unsigned char *)MAP_FAILED) return (void *)0;\n"
    buf = buf + "    } else {\n"
    buf = buf + "        size_t csz = (size_t)hxheap_class_sz[ci];\n"
    buf = buf + "        hxheap_lock_acquire();\n"
    buf = buf + "        void *blk = hxheap_freelist[ci];\n"
    buf = buf + "        if (blk) {\n"
    buf = buf + "            hxheap_freelist[ci] = *(void **)blk;\n"
    buf = buf + "            base = (unsigned char *)blk;\n"
    buf = buf + "        } else {\n"
    buf = buf + "            if ((size_t)(hxheap_arena_end - hxheap_arena_ptr) < csz) {\n"
    buf = buf + "                char *a = (char *)mmap((void *)0, (size_t)HXHEAP_ARENA_SZ,\n"
    buf = buf + "                                       PROT_READ | PROT_WRITE,\n"
    buf = buf + "                                       MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);\n"
    buf = buf + "                if (a == (char *)MAP_FAILED) { hxheap_lock_release(); return (void *)0; }\n"
    buf = buf + "                hxheap_arena_ptr = a;\n"
    buf = buf + "                hxheap_arena_end = a + (size_t)HXHEAP_ARENA_SZ;\n"
    buf = buf + "            }\n"
    buf = buf + "            base = (unsigned char *)hxheap_arena_ptr;\n"
    buf = buf + "            hxheap_arena_ptr += csz;\n"
    buf = buf + "        }\n"
    buf = buf + "        hxheap_lock_release();\n"
    buf = buf + "    }\n"
    buf = buf + "    ((size_t *)base)[0] = n;\n"
    buf = buf + "    ((size_t *)base)[1] = HXLCL_ALLOC_MAGIC;\n"
    buf = buf + "    return base + HXLCL_HDR_BYTES;\n"
    buf = buf + "}\n"
    buf = buf + "void hxheap_free(void *p) {\n"
    buf = buf + "    if (!p) return;\n"
    buf = buf + "    unsigned char *base = (unsigned char *)p - HXLCL_HDR_BYTES;\n"
    buf = buf + "    if (((size_t *)base)[1] != HXLCL_ALLOC_MAGIC) return;\n"
    buf = buf + "    size_t n = ((size_t *)base)[0];\n"
    buf = buf + "    ((size_t *)base)[1] = 0;\n"
    buf = buf + "    size_t total = hxheap_align16(n + HXLCL_HDR_BYTES);\n"
    buf = buf + "    int ci = hxheap_class_of(total);\n"
    buf = buf + "    if (ci < 0) {\n"
    buf = buf + "        munmap(base, total);\n"
    buf = buf + "    } else {\n"
    buf = buf + "        hxheap_lock_acquire();\n"
    buf = buf + "        *(void **)base = hxheap_freelist[ci];\n"
    buf = buf + "        hxheap_freelist[ci] = (void *)base;\n"
    buf = buf + "        hxheap_lock_release();\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "void *hxheap_calloc(size_t nmemb, size_t size) {\n"
    buf = buf + "    size_t nm = nmemb ? nmemb : 1;\n"
    buf = buf + "    size_t sz = size ? size : 1;\n"
    buf = buf + "    if (sz && nm > ((size_t)-1) / sz) return (void *)0;\n"
    buf = buf + "    size_t nbytes = nm * sz;\n"
    buf = buf + "    size_t total = hxheap_align16(nbytes + HXLCL_HDR_BYTES);\n"
    buf = buf + "    void *p = hxheap_alloc(nbytes);\n"
    buf = buf + "    if (!p) return (void *)0;\n"
    buf = buf + "    if (hxheap_class_of(total) >= 0) hxlcl_memset(p, 0, nbytes);\n"
    buf = buf + "    return p;\n"
    buf = buf + "}\n"
    buf = buf + "void *hxlcl_heap_calloc(size_t nmemb, size_t size) { return hxheap_calloc(nmemb, size); }\n"
    buf = buf + "void  hxlcl_heap_free(void *p) { hxheap_free(p); }\n"
    buf = buf + "#endif /* HEXA_RT_HEAP_NATIVE */\n"
    if buf.len() > 65536 { _flush_runtime_core_hxlcl_shim(out_path, buf); buf = "" }
    buf = buf + "#ifdef HEXA_RT_NATIVE_REALLOC\n"
    buf = buf + "extern void *__attribute__((noinline)) hxlcl_memcpy(void *d, const void *s, size_t n);\n"
    buf = buf + "extern size_t hxlcl_strlen(const char *s);\n"
    buf = buf + "extern void *__attribute__((noinline)) hxlcl_memset(void *s, int c, size_t n);\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifdef HEXA_RT_HEAP_NATIVE\n"
    buf = buf + "void *__attribute__((noinline)) hxlcl_malloc(size_t n) { return hxheap_alloc(n); }\n"
    buf = buf + "#elif defined(HEXA_RT_NATIVE_REALLOC)\n"
    buf = buf + "/* F1 header-parity (zeroc #29): the native Route C hxlcl_realloc (hxlcl_core.hexa:1249)\n"
    buf = buf + " * recovers old_n from the 16-byte size header at p-16 — the frozen-floor allocator ABI.\n"
    buf = buf + " * When that member is adopted (-DHEXA_RT_NATIVE_REALLOC) this provider writes the same\n"
    buf = buf + " * header so the negative-offset read is defined for every hxlcl-family pointer\n"
    buf = buf + " * (malloc/calloc/realloc/strdup all route through here). Verbatim the\n"
    buf = buf + " * routec_alloc_native_verify.sh harness malloc (smoke-proven). DEFAULT (macro unset)\n"
    buf = buf + " * keeps the headerless libc delegate below -> shim.o byte-identical (byteeq-neutral). */\n"
    buf = buf + "void *__attribute__((noinline)) hxlcl_malloc(size_t n) {\n"
    buf = buf + "    size_t want = n ? n : 1;\n"
    buf = buf + "    unsigned char *base = (unsigned char *)malloc(want + HXLCL_HDR_BYTES);\n"
    buf = buf + "    if (!base) return (void *)0;\n"
    buf = buf + "    ((size_t *)base)[0] = want;        /* size header at [base .. base+8) */\n"
    buf = buf + "    ((size_t *)base)[1] = HXLCL_ALLOC_MAGIC; /* F2 family tag at [base+8 .. base+16) */\n"
    buf = buf + "    return base + HXLCL_HDR_BYTES;     /* user pointer (header is at p-16) */\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "void *__attribute__((noinline)) hxlcl_malloc(size_t n) { return malloc(n ? n : 1); }\n"
    buf = buf + "#endif\n"
    buf = buf + "/* RT-NATIVE-FREE (HEXA_RT_NATIVE_FREE, default OFF · literal-∅ non-libm leaf RUNG 3):\n"
    buf = buf + " * THIRD non-libm hxlcl_* to LEAVE the shim via the fp-ABI Route C whole-module emit\n"
    buf = buf + " * (strstr #4240 / strtoll #4241 precedent). hxlcl_free is the PUREST self-contained\n"
    buf = buf + " * leaf — the frozen 0-libc floor's no-op free (the bump arena from hxlcl_malloc\n"
    buf = buf + " * never reclaims), so the native body is `(void)p; return p` (zero syscall, zero\n"
    buf = buf + " * errno, zero inner callee, zero extern-data). The Route C native body is\n"
    buf = buf + " * FAITHFUL to the frozen floor / BYTEID arm (no-op), NOT to this shim's libc-only\n"
    buf = buf + " * `free(p)` delegate (which exists solely for the standalone-libc measurement TU).\n"
    buf = buf + " * Under HEXA_RT_NATIVE_FREE=1 (x86_64-linux gate in tool/stage_resolve_runtime_a)\n"
    buf = buf + " * the shim drops free and the objcopy-isolated native .o supplies it. DEFAULT\n"
    buf = buf + " * (unset) keeps this libc delegate; shim.o + archive byte-identical (release-\n"
    buf = buf + " * integrity invariant). */\n"
    buf = buf + "#ifndef HEXA_RT_NATIVE_FREE\n"
    buf = buf + "#ifdef HEXA_RT_HEAP_NATIVE\n"
    buf = buf + "void   hxlcl_free(void *p) { hxheap_free(p); }\n"
    buf = buf + "#else\n"
    buf = buf + "#ifdef HEXA_ZEROC_SHIM_BYTEID_EMIT\n"
    buf = buf + "/* byte-identical to frozen self/runtime.c hxlcl_free (verbatim 0-libc floor body) */\n"
    buf = buf + "void __attribute__((noinline)) hxlcl_free(void *p) {\n"
    buf = buf + "    (void)p;\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "#ifdef HEXA_RT_NATIVE_REALLOC\n"
    buf = buf + "/* F2: magic-GUARDED. Family pointers (magic present) free at base-16; foreign pointers\n"
    buf = buf + " * (magic-miss: arena kdup keys, direct-libc allocs) free at p verbatim = today's behavior.\n"
    buf = buf + " * This is the load-bearing fix — the blind free(p-16) aborted darwin on foreign pointers. */\n"
    buf = buf + "void   hxlcl_free(void *p) {\n"
    buf = buf + "    if (!p) return;\n"
    buf = buf + "    unsigned char *base = (unsigned char *)p - HXLCL_HDR_BYTES;\n"
    buf = buf + "    if (((size_t *)base)[1] == HXLCL_ALLOC_MAGIC) { ((size_t *)base)[1] = 0; free(base); }\n"
    buf = buf + "    else free(p);\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "void   hxlcl_free(void *p)                            { free(p); }\n"
    buf = buf + "#endif\n"
    buf = buf + "#endif\n"
    buf = buf + "#endif\n"
    buf = buf + "#endif /* !HEXA_RT_NATIVE_FREE */\n"
    buf = buf + "/* RT-NATIVE-REALLOC (HEXA_RT_NATIVE_REALLOC, default OFF · COMPOSITE non-libm leaf,\n"
    buf = buf + " * inner C-ABI `bl hxlcl_malloc`):\n"
    buf = buf + " * hxlcl_realloc leaves the shim via the fp-ABI Route C whole-module emit (free\n"
    buf = buf + " * #4242 / strstr #4240 / strtoll #4241 precedent). It is NOT a pure leaf — its\n"
    buf = buf + " * native body (hxlcl_core.hexa:1249) calls the RETAINED shim provider hxlcl_malloc\n"
    buf = buf + " * (shim:101, ungated permanent malloc delegate) via an inner C-ABI `bl`, plus a\n"
    buf = buf + " * NEGATIVE-offset header read (p-16) + byte copy. The inner callee stays served by\n"
    buf = buf + " * the shim, so NO co-drop of malloc is needed; only realloc's own member drops.\n"
    buf = buf + " * The Route C native body is BYTE-FAITHFUL to the BYTEID 0-libc floor arm below\n"
    buf = buf + " * (grow/shrink min(n,old_n) preserve), NOT to this shim's libc realloc(p,n) delegate\n"
    buf = buf + " * (which exists solely for the standalone-libc measurement TU). Under\n"
    buf = buf + " * HEXA_RT_NATIVE_REALLOC=1 (x86_64-linux gate in tool/stage_resolve_runtime_a) the\n"
    buf = buf + " * shim drops realloc and the objcopy-isolated native .o supplies it (malloc still\n"
    buf = buf + " * the shim's). DEFAULT (unset) keeps this delegate; shim.o + archive byte-identical\n"
    buf = buf + " * (release-integrity invariant). */\n"
    buf = buf + "#ifndef HEXA_RT_NATIVE_REALLOC\n"
    buf = buf + "#ifdef HEXA_ZEROC_SHIM_BYTEID_EMIT\n"
    buf = buf + "/* byte-identical to frozen self/runtime.c hxlcl_realloc (verbatim 0-libc floor body) */\n"
    buf = buf + "void *__attribute__((noinline)) hxlcl_realloc(void *p, size_t n) {\n"
    buf = buf + "    if (!p) return hxlcl_malloc(n);\n"
    buf = buf + "    if (n == 0) return (void *)0;\n"
    buf = buf + "    void *np = hxlcl_malloc(n);\n"
    buf = buf + "    if (!np) return (void *)0;\n"
    buf = buf + "    // Header-tracked old size: clamp the memcpy so we never read past\n"
    buf = buf + "    // the original allocation's end (the pre-fix over-read crashed when\n"
    buf = buf + "    // n > old_n and old_n's chunk boundary fell inside [p .. p+n)).\n"
    buf = buf + "    size_t old_n = *(size_t *)((char *)p - HXLCL_HDR_BYTES);\n"
    if buf.len() > 65536 { _flush_runtime_core_hxlcl_shim(out_path, buf); buf = "" }
    buf = buf + "    size_t copy_n = (n < old_n) ? n : old_n;\n"
    buf = buf + "    unsigned char *d = (unsigned char *)np;\n"
    buf = buf + "    const unsigned char *s = (const unsigned char *)p;\n"
    buf = buf + "    for (size_t i = 0; i < copy_n; i++) d[i] = s[i];\n"
    buf = buf + "    return np;\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "void  *hxlcl_realloc(void *p, size_t n)               { return realloc(p, n); }\n"
    buf = buf + "#endif\n"
    buf = buf + "#else\n"
    buf = buf + "/* F2: under the flip the SHIM provides realloc (self-contained, magic-guarded; the frozen\n"
    buf = buf + " * seed path is retired). realloc(NULL,n)=malloc; realloc(p,0)=NULL (frozen-floor contract);\n"
    buf = buf + " * foreign pointer (magic-miss) is a hard bug -> trap LOUD (a libc-realloc fallback would\n"
    buf = buf + " * keep realloc on the nm-UND floor). All family-internal (hxlcl_malloc/memcpy/free). */\n"
    buf = buf + "void *__attribute__((noinline)) hxlcl_realloc(void *p, size_t n) {\n"
    buf = buf + "    if (!p) return hxlcl_malloc(n);\n"
    buf = buf + "    if (n == 0) return (void *)0;\n"
    buf = buf + "    unsigned char *base = (unsigned char *)p - HXLCL_HDR_BYTES;\n"
    buf = buf + "    if (((size_t *)base)[1] != HXLCL_ALLOC_MAGIC) { __builtin_trap(); }\n"
    buf = buf + "    size_t old_n = ((size_t *)base)[0];\n"
    buf = buf + "    void *np = hxlcl_malloc(n);\n"
    buf = buf + "    if (!np) return (void *)0;\n"
    buf = buf + "    size_t copy_n = (n < old_n) ? n : old_n;\n"
    buf = buf + "    hxlcl_memcpy(np, p, copy_n);\n"
    buf = buf + "    hxlcl_free(p);\n"
    buf = buf + "    return np;\n"
    buf = buf + "}\n"
    buf = buf + "#endif /* !HEXA_RT_NATIVE_REALLOC */\n"
    buf = buf + "/* RT-NATIVE-CALLOC (HEXA_RT_NATIVE_CALLOC, default OFF · COMPOSITE non-libm leaf,\n"
    buf = buf + " * inner C-ABI `bl hxlcl_malloc`):\n"
    buf = buf + " * hxlcl_calloc leaves the shim via the fp-ABI Route C whole-module emit (free #4242\n"
    buf = buf + " * precedent). It is NOT a pure leaf — its native body (hxlcl_core.hexa:1216) calls\n"
    buf = buf + " * the RETAINED shim provider hxlcl_malloc (shim:101, ungated permanent malloc\n"
    buf = buf + " * delegate) via an inner C-ABI `bl`, then a zero-fill byte loop. The inner callee\n"
    buf = buf + " * stays served by the shim, so NO co-drop of malloc is needed; only calloc's own\n"
    buf = buf + " * member drops. The Route C native body is BYTE-FAITHFUL to the BYTEID 0-libc floor\n"
    buf = buf + " * arm below (total=nmemb*size; p=malloc(total); zero p[0..total)), NOT to this\n"
    buf = buf + " * shim's libc calloc(nmemb,size) delegate (standalone-libc measurement TU only).\n"
    buf = buf + " * Under HEXA_RT_NATIVE_CALLOC=1 (x86_64-linux gate in tool/stage_resolve_runtime_a)\n"
    buf = buf + " * the shim drops calloc and the objcopy-isolated native .o supplies it (malloc\n"
    buf = buf + " * still the shim's). DEFAULT (unset) keeps this delegate; shim.o + archive byte-\n"
    buf = buf + " * identical (release-integrity invariant). */\n"
    buf = buf + "#ifndef HEXA_RT_NATIVE_CALLOC\n"
    buf = buf + "#ifdef HEXA_RT_HEAP_NATIVE\n"
    buf = buf + "void  *hxlcl_calloc(size_t nmemb, size_t size)        { return hxheap_calloc(nmemb, size); }\n"
    buf = buf + "#else\n"
    buf = buf + "#ifdef HEXA_ZEROC_SHIM_BYTEID_EMIT\n"
    buf = buf + "/* byte-identical to frozen self/runtime.c hxlcl_calloc (verbatim 0-libc floor body) */\n"
    buf = buf + "void *__attribute__((noinline)) hxlcl_calloc(size_t nmemb, size_t size) {\n"
    buf = buf + "    size_t total = nmemb * size;\n"
    buf = buf + "    void *p = hxlcl_malloc(total);\n"
    buf = buf + "    if (p) {\n"
