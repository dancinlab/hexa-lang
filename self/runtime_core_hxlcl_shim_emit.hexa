    buf = buf + "#endif\n"
    buf = buf + "#endif  /* HXLCL_STDIO_LINK */\n"
    buf = buf + "/* RT-NATIVE-OPEN_SYS (HEXA_RT_NATIVE_OPEN_SYS, default OFF · proc group): hxlcl_open_sys\n"
