    buf = buf + " * (macro undefined) keeps this libc delegate → shim.o byte-identical. */\n"
    buf = buf + "#ifndef HEXA_RT_SELFEMIT_STAT\n"
    buf = buf + "/* zero-c #29: raw-svc on 64-bit Linux via newfstatat(AT_FDCWD,path,buf,0) (SYS_newfstatat x86_64=262 / arm64=79; arm64 has no legacy stat). x86_64 4th arg goes in r10 (rcx is clobbered by syscall). darwin/other keep libc. */\n"
    buf = buf + "int    hxlcl_stat(const char *path, void *buf) {\n"
