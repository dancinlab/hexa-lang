    buf = buf + "}\n"
    buf = buf + "int __attribute__((noinline)) hxlcl_setvbuf(void *fp, char *buf_, int mode, size_t sz) {\n"
    buf = buf + "    (void)fp; (void)buf_; (void)mode; (void)sz;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "#else  /* !HXLCL_STDIO_LINK — frozen libc-delegate FILE* family (byte-identical default) */\n"
