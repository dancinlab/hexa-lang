    buf = buf + "/* byte-identical to frozen self/runtime.c hxlcl_strchr (verbatim 0-libc floor body) */\n"
    buf = buf + "const char *__attribute__((noinline)) hxlcl_strchr(const char *s, int c) {\n"
    buf = buf + "    if (!s) return NULL;\n"
    buf = buf + "    unsigned char target = (unsigned char)c;\n"
    buf = buf + "    for (size_t i = 0; ; i++) {\n"
    buf = buf + "        unsigned char x = (unsigned char)((const volatile char *)s)[i];\n"
    buf = buf + "        if (x == target) return s + i;\n"
