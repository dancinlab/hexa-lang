    buf = buf + "double    hxlcl_atof(const char *s)                   { return s ? atof(s) : 0.0; }\n"
    buf = buf + "#endif\n"
    buf = buf + "/* RT-NATIVE-STRTOLL (HEXA_RT_NATIVE_STRTOLL, default OFF · literal-∅ non-libm leaf\n"
    buf = buf + " * RUNG 2): SECOND non-libm hxlcl_* to LEAVE the shim via the fp-ABI Route C\n"
    buf = buf + " * whole-module emit (strstr precedent). hxlcl_strtoll is a PURE self-contained\n"
    buf = buf + " * byte-walk parse leaf — no syscall, no errno, no inner C-ABI callee, no\n"
    buf = buf + " * extern-data; the only memory write is `*endptr` to the CALLER-supplied pointer\n"
    buf = buf + " * (a function argument, not a global — same class as memcpy's dst). The native\n"
    buf = buf + " * body is stdlib/runtime/hxlcl_core.hexa::hxlcl_strtoll (Route C, whitelisted in\n"
    buf = buf + " * _is_cabi, integer C-ABI). Under HEXA_RT_NATIVE_STRTOLL=1 (x86_64-linux gate in\n"
    if buf.len() > 65536 { _flush_runtime_core_hxlcl_shim(out_path, buf); buf = "" }
    buf = buf + " * tool/stage_resolve_runtime_a) the shim drops strtoll and the staged native .o\n"
    buf = buf + " * (objcopy-isolated) supplies it. DEFAULT (unset) adds NO -D and NO member →\n"
    buf = buf + " * shim.o + archive byte-identical (release-integrity invariant). */\n"
    buf = buf + "#ifndef HEXA_RT_NATIVE_STRTOLL\n"
    buf = buf + "#ifdef HEXA_ZEROC_SHIM_BYTEID_EMIT\n"
    buf = buf + "/* byte-identical to frozen self/runtime.c hxlcl_strtoll (verbatim 0-libc floor body) */\n"
    buf = buf + "long long __attribute__((noinline)) hxlcl_strtoll(const char *nptr, char **endptr, int base) {\n"
    buf = buf + "    if (!nptr) { if (endptr) *endptr = (char *)nptr; return 0; }\n"
    buf = buf + "    const char *s = nptr;\n"
    buf = buf + "    while (*s == ' ' || *s == '\\t' || *s == '\\n') s++;\n"
    buf = buf + "    int sign = 1;\n"
    buf = buf + "    if (*s == '-') { sign = -1; s++; }\n"
    buf = buf + "    else if (*s == '+') s++;\n"
    buf = buf + "    const char *z = s;\n"
    buf = buf + "    if (base == 0) {\n"
    buf = buf + "        if (s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) { base = 16; s += 2; }\n"
    buf = buf + "        else if (s[0] == '0') { base = 8; s++; }\n"
    buf = buf + "        else base = 10;\n"
    buf = buf + "    } else if (base == 16 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) {\n"
    buf = buf + "        s += 2;\n"
    buf = buf + "    }\n"
    buf = buf + "    unsigned long long n = 0;\n"
    buf = buf + "    int any = 0;\n"
    buf = buf + "    for (;;) {\n"
    buf = buf + "        char c = *s;\n"
    buf = buf + "        int d;\n"
    buf = buf + "        if (c >= '0' && c <= '9') d = c - '0';\n"
    buf = buf + "        else if (c >= 'a' && c <= 'z') d = c - 'a' + 10;\n"
    buf = buf + "        else if (c >= 'A' && c <= 'Z') d = c - 'A' + 10;\n"
    buf = buf + "        else break;\n"
    buf = buf + "        if (d >= base) break;\n"
    buf = buf + "        n = n * (unsigned long long)base + (unsigned long long)d;\n"
    buf = buf + "        any = 1;\n"
    buf = buf + "        s++;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (!any) s = (s != z) ? z + 1 : nptr;\n"
    buf = buf + "    if (endptr) *endptr = (char *)s;\n"
    buf = buf + "    return (long long)((sign < 0) ? -(long long)n : (long long)n);\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "long long hxlcl_strtoll(const char *p, char **e, int b){ return strtoll(p, e, b); }\n"
    buf = buf + "#endif\n"
    buf = buf + "#endif /* !HEXA_RT_NATIVE_STRTOLL */\n"
    buf = buf + "\n"
    buf = buf + "/* ── math (libm) ─────────────────────────────────────────────────────────── */\n"
    buf = buf + "/* zero-c #29: hxlcl_sin/cos/exp/log delegate to the runtime.o native math (_hx_*, external linkage);\n"
    buf = buf + " * cross-TU resolved within runtime.a (runtime.o defines T _hx_sin; hxlcl_shim.o references U _hx_sin). */\n"
    buf = buf + "double _hx_sin(double); double _hx_cos(double); double _hx_exp(double); double _hx_log(double);\n"
    buf = buf + "/* RT-NATIVE-SIN (HEXA_RT_NATIVE_SIN, default OFF · literal-∅ libm-leaf RUNG 3):\n"
    buf = buf + " * when set, hxlcl_sin is supplied by the hexa-NATIVE Route C fp-ABI (xmm) .o emitted\n"
    buf = buf + " * from stdlib/runtime/hxlcl_core.hexa (HEXA_CABI_HXLCL=1) — a 1:1 musl src/math/\n"
    buf = buf + " * {sin,__sin,__cos,__rem_pio2}.c port (libm-free; small + medium argument-reduction\n"
    buf = buf + " * paths, the __sin/__cos kernels inlined into the single body; the table-based\n"
    buf = buf + " * __rem_pio2_large LARGE path is a separate next rung). The shim drops the hxlcl_sin\n"
    buf = buf + " * member below so `ld -r` sees no duplicate def.\n"
    buf = buf + " * stage_resolve_runtime_a passes -DHEXA_RT_NATIVE_SIN when it links the native sin .o;\n"
    buf = buf + " * default (macro undefined) keeps the libc delegate → shim.o byte-identical. */\n"
    if buf.len() > 65536 { _flush_runtime_core_hxlcl_shim(out_path, buf); buf = "" }
    buf = buf + "#ifndef HEXA_RT_NATIVE_SIN\n"
    buf = buf + "double hxlcl_sin(double x)                            { return _hx_sin(x); }  /* zero-c #29: native (runtime.o _hx_sin) */\n"
    buf = buf + "#endif\n"
    buf = buf + "/* RT-NATIVE-COS (HEXA_RT_NATIVE_COS, default OFF · literal-∅ libm-leaf RUNG 4):\n"
    buf = buf + " * when set, hxlcl_cos is supplied by the hexa-NATIVE Route C fp-ABI (xmm) .o emitted\n"
    buf = buf + " * from stdlib/runtime/hxlcl_core.hexa (HEXA_CABI_HXLCL=1) — a 1:1 musl src/math/\n"
    buf = buf + " * {cos,__sin,__cos,__rem_pio2}.c port (libm-free; small + medium argument-reduction\n"
    buf = buf + " * paths; shares hxlcl_sin's reduction + inlined __sin/__cos kernels — only the tiny/\n"
    buf = buf + " * |x|<pi/4 special cases and the n&3 dispatch differ; the table-based __rem_pio2_large\n"
    buf = buf + " * LARGE path is a separate next rung). The shim drops the hxlcl_cos member below so\n"
    buf = buf + " * `ld -r` sees no duplicate def.\n"
    buf = buf + " * stage_resolve_runtime_a passes -DHEXA_RT_NATIVE_COS when it links the native cos .o;\n"
    buf = buf + " * default (macro undefined) keeps the libc delegate → shim.o byte-identical. */\n"
    buf = buf + "#ifndef HEXA_RT_NATIVE_COS\n"
    buf = buf + "double hxlcl_cos(double x)                            { return _hx_cos(x); }  /* zero-c #29: native (runtime.o _hx_cos) */\n"
    buf = buf + "#endif\n"
    buf = buf + "/* RT-NATIVE-EXP (HEXA_RT_NATIVE_EXP, default OFF · literal-∅ libm-leaf RUNG 5):\n"
    buf = buf + " * when set, hxlcl_exp is supplied by the hexa-NATIVE Route C fp-ABI (xmm) .o emitted\n"
    buf = buf + " * from stdlib/runtime/hxlcl_core.hexa (HEXA_CABI_HXLCL=1) — a 1:1 musl src/math/exp.c\n"
    buf = buf + " * port (N=128, POLY_ORDER=5, non-FMA path), the FIRST TABLE-DRIVEN libm leaf: it\n"
    buf = buf + " * reads the 256-entry __exp_data.tab through the §M8 named-rodata-table codegen\n"
    buf = buf + " * mechanism (rotab_1 / __hx_rodata_tab_ptr(1)) — the data-leaf wall named at\n"
    buf = buf + " * fmod/sin/cos. The shim drops the hxlcl_exp member below so `ld -r` sees no\n"
    buf = buf + " * duplicate def. stage_resolve_runtime_a passes -DHEXA_RT_NATIVE_EXP when it links\n"
    buf = buf + " * the native exp .o; default (macro undefined) keeps the libc delegate → shim.o\n"
    buf = buf + " * byte-identical (release-integrity invariant). */\n"
    buf = buf + "#ifndef HEXA_RT_NATIVE_EXP\n"
    buf = buf + "double hxlcl_exp(double x)                            { return _hx_exp(x); }  /* zero-c #29: native (runtime.o _hx_exp) */\n"
    buf = buf + "#endif\n"
    buf = buf + "/* RT-NATIVE-LOG (HEXA_RT_NATIVE_LOG, default OFF · literal-∅ libm-leaf RUNG 6):\n"
    buf = buf + " * when set, hxlcl_log is supplied by the hexa-NATIVE Route C fp-ABI (xmm) .o emitted\n"
    buf = buf + " * from stdlib/runtime/hxlcl_core.hexa (HEXA_CABI_HXLCL=1) — a 1:1 musl src/math/log.c\n"
    buf = buf + " * port (LOG_TABLE_BITS=7, N=128, NON-FMA path), the SECOND TABLE-DRIVEN libm leaf and\n"
    buf = buf + " * the LAST clean libm shim symbol (sin/cos/fmod/exp already native): it reads the 512-\n"
    buf = buf + " * double __log_data (tab[128]×{invc,logc} + tab2[128]×{chi,clo}) through the §M8 named-\n"
    buf = buf + " * rodata-table codegen mechanism (rotab_2 / __hx_rodata_tab_ptr(2)). The shim drops the\n"
    buf = buf + " * hxlcl_log member below so `ld -r` sees no duplicate def. stage_resolve_runtime_a passes\n"
    buf = buf + " * -DHEXA_RT_NATIVE_LOG when it links the native log .o; default (macro undefined) keeps\n"
    buf = buf + " * the libc delegate → shim.o byte-identical (release-integrity invariant). When this drops,\n"
    buf = buf + " * the libm shim member count is 4→3 (only sin/cos in the now-native set leave fmod/exp/log;\n"
    buf = buf + " * exp/log are the table-driven pair). */\n"
    buf = buf + "#ifndef HEXA_RT_NATIVE_LOG\n"
    buf = buf + "double hxlcl_log(double x)                            { return _hx_log(x); }  /* zero-c #29: native (runtime.o _hx_log) */\n"
    buf = buf + "#endif\n"
    buf = buf + "/* RT-NATIVE-FMOD (HEXA_RT_NATIVE_FMOD, default OFF · literal-∅ libm-leaf RUNG 2):\n"
    buf = buf + " * when set, hxlcl_fmod is supplied by the hexa-NATIVE Route C fp-ABI (xmm) .o\n"
    buf = buf + " * emitted from stdlib/runtime/hxlcl_core.hexa (HEXA_CABI_HXLCL=1) — the FIRST real\n"
    buf = buf + " * libm-floor symbol that LEAVES this libc shim (literal-∅ progress: shim member\n"
    buf = buf + " * count N→N-1). The shim drops BOTH arms below so ld -r sees no duplicate def.\n"
    buf = buf + " * stage_resolve_runtime_a passes -DHEXA_RT_NATIVE_FMOD when it links the native\n"
    if buf.len() > 65536 { _flush_runtime_core_hxlcl_shim(out_path, buf); buf = "" }
    buf = buf + " * fmod .o; default (macro undefined) keeps the existing arms → shim.o byte-id. */\n"
    buf = buf + "#ifndef HEXA_RT_NATIVE_FMOD\n"
    buf = buf + "/* LIBM-NATIVE (zero-c #29: now DEFAULT-ON via #ifndef HEXA_FMOD_LIBC · libm-leaf rung 1):\n"
    buf = buf + " * hxlcl_fmod is supplied by a SELF-CONTAINED, libm-free body — a VERBATIM port of\n"
    buf = buf + " * SunPro fdlibm `e_fmod.c` (`__ieee754_fmod`, netlib.org/fdlibm/e_fmod.c L28-150;\n"
    buf = buf + " * the identical algorithm ships as musl src/math/fmod.c). It computes the exact\n"
    buf = buf + " * IEEE-754 remainder by pure INTEGER bit-manipulation of the operands' bit\n"
    buf = buf + " * patterns — NO `fmod()` call, NO `<math.h>` function. The only FP ops are the\n"
    buf = buf + " * NaN/Inf exception propagation `(x*y)/(x*y)` and the final subnormal-signal\n"
    buf = buf + " * `x*one`, both bare hardware ops (no `-lm` symbol). Because fmod's mathematical\n"
    buf = buf + " * result is EXACT, this port is CORRECTLY-ROUNDED: bit-identical (0 ULP) to libc\n"
    buf = buf + " * fmod for every finite input (verified N-point on aiden). EXTRACT/INSERT_WORDS\n"
    buf = buf + " * are open-coded via a uint64 reinterpret union (no math_private.h). zero-c #29:\n"
    buf = buf + " * native-canonical polarity — this body is DEFAULT (libm-free); the raw libc fmod\n"
    buf = buf + " * delegate below is the opt-OUT escape hatch (-DHEXA_FMOD_LIBC). byteeq reconverges\n"
    buf = buf + " * (shim.o changes; runtime 0-ULP identical so no numeric drift). */\n"
    buf = buf + "#ifndef HEXA_FMOD_LIBC\n"
    buf = buf + "double __attribute__((noinline)) hxlcl_fmod(double x, double y) {\n"
    buf = buf + "    static const double one = 1.0, Zero[] = {0.0, -0.0};\n"
    buf = buf + "    union { double d; uint64_t u; } ux, uy, ur;\n"
    buf = buf + "    int32_t n, hx, hy, hz, ix, iy, sx, i;\n"
    buf = buf + "    uint32_t lx, ly, lz;\n"
    buf = buf + "\n"
    buf = buf + "    ux.d = x; hx = (int32_t)(ux.u >> 32); lx = (uint32_t)(ux.u);\n"
    buf = buf + "    uy.d = y; hy = (int32_t)(uy.u >> 32); ly = (uint32_t)(uy.u);\n"
    buf = buf + "    sx = hx & 0x80000000;          /* sign of x */\n"
    buf = buf + "    hx ^= sx;                      /* |x| */\n"
    buf = buf + "    hy &= 0x7fffffff;              /* |y| */\n"
    buf = buf + "\n"
    buf = buf + "    /* purge off exception values */\n"
    buf = buf + "    if ((hy | ly) == 0 || (hx >= 0x7ff00000) ||           /* y=0, or x not finite */\n"
    buf = buf + "        ((hy | ((ly | (uint32_t)(-(int32_t)ly)) >> 31)) > 0x7ff00000)) /* or y NaN */\n"
    buf = buf + "        return (x * y) / (x * y);\n"
    buf = buf + "    if (hx <= hy) {\n"
    buf = buf + "        if ((hx < hy) || (lx < ly)) return x;             /* |x|<|y| return x */\n"
    buf = buf + "        if (lx == ly)\n"
    buf = buf + "            return Zero[(uint32_t)sx >> 31];              /* |x|=|y| return x*0 */\n"
    buf = buf + "    }\n"
    buf = buf + "\n"
    buf = buf + "    /* determine ix = ilogb(x) */\n"
    buf = buf + "    if (hx < 0x00100000) {         /* subnormal x */\n"
    buf = buf + "        if (hx == 0) {\n"
    buf = buf + "            for (ix = -1043, i = (int32_t)lx; i > 0; i <<= 1) ix -= 1;\n"
    buf = buf + "        } else {\n"
    buf = buf + "            for (ix = -1022, i = (hx << 11); i > 0; i <<= 1) ix -= 1;\n"
    buf = buf + "        }\n"
    buf = buf + "    } else ix = (hx >> 20) - 1023;\n"
    buf = buf + "\n"
    buf = buf + "    /* determine iy = ilogb(y) */\n"
    buf = buf + "    if (hy < 0x00100000) {         /* subnormal y */\n"
    buf = buf + "        if (hy == 0) {\n"
    if buf.len() > 65536 { _flush_runtime_core_hxlcl_shim(out_path, buf); buf = "" }
    buf = buf + "            for (iy = -1043, i = (int32_t)ly; i > 0; i <<= 1) iy -= 1;\n"
    buf = buf + "        } else {\n"
    buf = buf + "            for (iy = -1022, i = (hy << 11); i > 0; i <<= 1) iy -= 1;\n"
    buf = buf + "        }\n"
    buf = buf + "    } else iy = (hy >> 20) - 1023;\n"
    buf = buf + "\n"
    buf = buf + "    /* set up {hx,lx}, {hy,ly} and align y to x */\n"
    buf = buf + "    if (ix >= -1022)\n"
    buf = buf + "        hx = 0x00100000 | (0x000fffff & hx);\n"
    buf = buf + "    else {                         /* subnormal x, shift x to normal */\n"
    buf = buf + "        n = -1022 - ix;\n"
    buf = buf + "        if (n <= 31) {\n"
    buf = buf + "            hx = (hx << n) | (int32_t)(lx >> (32 - n));\n"
    buf = buf + "            lx <<= n;\n"
    buf = buf + "        } else {\n"
    buf = buf + "            hx = (int32_t)(lx << (n - 32));\n"
    buf = buf + "            lx = 0;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    if (iy >= -1022)\n"
    buf = buf + "        hy = 0x00100000 | (0x000fffff & hy);\n"
    buf = buf + "    else {                         /* subnormal y, shift y to normal */\n"
    buf = buf + "        n = -1022 - iy;\n"
    buf = buf + "        if (n <= 31) {\n"
    buf = buf + "            hy = (hy << n) | (int32_t)(ly >> (32 - n));\n"
    buf = buf + "            ly <<= n;\n"
    buf = buf + "        } else {\n"
    buf = buf + "            hy = (int32_t)(ly << (n - 32));\n"
    buf = buf + "            ly = 0;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "\n"
    buf = buf + "    /* fix point fmod */\n"
    buf = buf + "    n = ix - iy;\n"
    buf = buf + "    while (n--) {\n"
    buf = buf + "        hz = hx - hy; lz = lx - ly; if (lx < ly) hz -= 1;\n"
    buf = buf + "        if (hz < 0) { hx = hx + hx + (int32_t)(lx >> 31); lx = lx + lx; }\n"
    buf = buf + "        else {\n"
    buf = buf + "            if ((hz | (int32_t)lz) == 0)                  /* return sign(x)*0 */\n"
    buf = buf + "                return Zero[(uint32_t)sx >> 31];\n"
    buf = buf + "            hx = hz + hz + (int32_t)(lz >> 31); lx = lz + lz;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    hz = hx - hy; lz = lx - ly; if (lx < ly) hz -= 1;\n"
    buf = buf + "    if (hz >= 0) { hx = hz; lx = lz; }\n"
    buf = buf + "\n"
    buf = buf + "    /* convert back to floating value and restore the sign */\n"
    buf = buf + "    if ((hx | (int32_t)lx) == 0)                          /* return sign(x)*0 */\n"
    buf = buf + "        return Zero[(uint32_t)sx >> 31];\n"
    buf = buf + "    while (hx < 0x00100000) {                             /* normalize x */\n"
    if buf.len() > 65536 { _flush_runtime_core_hxlcl_shim(out_path, buf); buf = "" }
    buf = buf + "        hx = hx + hx + (int32_t)(lx >> 31); lx = lx + lx;\n"
    buf = buf + "        iy -= 1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (iy >= -1022) {             /* normalize output */\n"
    buf = buf + "        hx = ((hx - 0x00100000) | ((iy + 1023) << 20));\n"
    buf = buf + "        ur.u = ((uint64_t)(uint32_t)(hx | sx) << 32) | (uint64_t)lx;\n"
    buf = buf + "        x = ur.d;\n"
    buf = buf + "    } else {                       /* subnormal output */\n"
    buf = buf + "        n = -1022 - iy;\n"
    buf = buf + "        if (n <= 20) {\n"
    buf = buf + "            lx = (lx >> n) | ((uint32_t)hx << (32 - n));\n"
    buf = buf + "            hx >>= n;\n"
    buf = buf + "        } else if (n <= 31) {\n"
    buf = buf + "            lx = (uint32_t)(hx << (32 - n)) | (lx >> n); hx = sx;\n"
    buf = buf + "        } else {\n"
    buf = buf + "            lx = (uint32_t)hx >> (n - 32); hx = sx;\n"
    buf = buf + "        }\n"
    buf = buf + "        ur.u = ((uint64_t)(uint32_t)(hx | sx) << 32) | (uint64_t)lx;\n"
    buf = buf + "        x = ur.d;\n"
    buf = buf + "        x *= one;                  /* create necessary signal */\n"
    buf = buf + "    }\n"
    buf = buf + "    return x;                      /* exact output */\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "double hxlcl_fmod(double x, double y)                 { return fmod(x, y); }\n"
    buf = buf + "#endif\n"
    buf = buf + "#endif /* !HEXA_RT_NATIVE_FMOD */\n"
    buf = buf + "\n"
    buf = buf + "/* ── env / process ───────────────────────────────────────────────────────── */\n"
    buf = buf + "/* RT-NATIVE-GETENV (HEXA_RT_NATIVE_GETENV, default OFF · literal-∅ non-libm leaf\n"
    buf = buf + " * RUNG 4): FOURTH non-libm hxlcl_* to LEAVE the shim via the Route C whole-module\n"
    buf = buf + " * emit (strstr #4240 / strtoll #4241 / free #4242 precedent). hxlcl_getenv is the\n"
    buf = buf + " * FIRST extern-DATA leaf to drop — it is NOT a pure self-contained leaf: it reads\n"
    buf = buf + " * the libc `extern char **environ` global. The native Route C body\n"
    buf = buf + " * (stdlib/runtime/hxlcl_core.hexa::hxlcl_getenv, whitelisted in _is_cabi) loads\n"
    buf = buf + " * `&environ` through the GOT via the __hx_environ_ptr intrinsic (#4098), so the\n"
    buf = buf + " * isolated native .o carries exactly ONE external reloc — `environ@GOTPCREL` —\n"
    buf = buf + " * which the final link satisfies from libc (provider-PRESENT; every binary links\n"
    buf = buf + " * libc, the shim itself declares `extern char **environ` above). No syscall, no\n"
    buf = buf + " * errno, no inner C-ABI callee (the strlen is INLINED in the native body). Under\n"
    buf = buf + " * HEXA_RT_NATIVE_GETENV=1 (x86_64-linux gate in tool/stage_resolve_runtime_a) the\n"
    buf = buf + " * shim drops getenv and the objcopy-isolated native .o supplies it. DEFAULT\n"
    buf = buf + " * (unset) keeps this libc delegate; shim.o + archive byte-identical (release-\n"
    buf = buf + " * integrity invariant). */\n"
    buf = buf + "/* zeroc #29 PR-2 fix: the environ-walk getenv/setenv bodies below call hxlcl_strlen,\n"
    buf = buf + " * but under HEXA_RT_SELFEMIT_STRLEN the shim's own hxlcl_strlen body is dropped (it is\n"
    buf = buf + " * self-emitted as a separate .o) -> implicit-declaration error at the getenv/setenv use.\n"
    buf = buf + " * Forward-declare it so the call is valid in every config (resolved at link). */\n"
    buf = buf + "size_t hxlcl_strlen(const char *s);\n"
    buf = buf + "#ifndef HEXA_RT_NATIVE_GETENV\n"
    buf = buf + "#ifdef HEXA_ZEROC_SHIM_BYTEID_EMIT\n"
    buf = buf + "/* byte-identical to frozen self/runtime.c hxlcl_getenv (verbatim 0-libc floor body) */\n"
    buf = buf + "char *__attribute__((noinline)) hxlcl_getenv(const char *name) {\n"
    buf = buf + "    if (!name) return (char *)0;\n"
    buf = buf + "    char **e = environ;\n"
    if buf.len() > 65536 { _flush_runtime_core_hxlcl_shim(out_path, buf); buf = "" }
    buf = buf + "    if (!e) return (char *)0;\n"
    buf = buf + "    size_t nlen = hxlcl_strlen(name);\n"
    buf = buf + "    while (*e) {\n"
    buf = buf + "        const char *entry = *e;\n"
    buf = buf + "        size_t i = 0;\n"
    buf = buf + "        while (i < nlen && entry[i] && entry[i] == name[i]) i++;\n"
    buf = buf + "        if (i == nlen && entry[i] == '=') return (char *)(entry + nlen + 1);\n"
    buf = buf + "        e++;\n"
    buf = buf + "    }\n"
    buf = buf + "    return (char *)0;\n"
    buf = buf + "}\n"
    buf = buf + "#elif defined(HEXA_RT_ENV_LIBC)\n"
    buf = buf + "char *hxlcl_getenv(const char *name)                  { return getenv(name); }\n"
    buf = buf + "#else\n"
    buf = buf + "/* zeroc #29 env-leaf DEFAULT-native: environ-walk (verbatim BYTEID body promoted\n"
    buf = buf + " * to default). Reads the libc `extern char **environ` global — the ONLY external\n"
    buf = buf + " * reloc (environ data UND, a separate floor entry that dissolves only with FLIP-7).\n"
    buf = buf + " * NO syscall, NO errno; the strlen is INLINED via hxlcl_strlen. Semantics identical\n"
    buf = buf + " * to the prior libc delegate for a ctor-snapshot environ. Opt-out: -DHEXA_RT_ENV_LIBC. */\n"
    buf = buf + "char *__attribute__((noinline)) hxlcl_getenv(const char *name) {\n"
    buf = buf + "    if (!name) return (char *)0;\n"
    buf = buf + "    char **e = environ;\n"
    buf = buf + "    if (!e) return (char *)0;\n"
    buf = buf + "    size_t nlen = hxlcl_strlen(name);\n"
    buf = buf + "    while (*e) {\n"
    buf = buf + "        const char *entry = *e;\n"
    buf = buf + "        size_t i = 0;\n"
    buf = buf + "        while (i < nlen && entry[i] && entry[i] == name[i]) i++;\n"
    buf = buf + "        if (i == nlen && entry[i] == '=') return (char *)(entry + nlen + 1);\n"
    buf = buf + "        e++;\n"
    buf = buf + "    }\n"
    buf = buf + "    return (char *)0;\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "#endif /* !HEXA_RT_NATIVE_GETENV */\n"
    buf = buf + "/* RT-NATIVE-SETENV (HEXA_RT_NATIVE_SETENV, default OFF · proc group): hxlcl_setenv\n"
    buf = buf + " * leaves the shim via the fp-ABI Route C whole-module emit (strstr/strtoll/free/getenv\n"
    buf = buf + " * precedent). The native body (stdlib/runtime/hxlcl_core.hexa::hxlcl_setenv —\n"
    buf = buf + " * REFERENCE-MATCH musl src/env/setenv.c) is a COMPOSITE leaf: it composes the already-\n"
    buf = buf + " * whitelisted __hx_environ_ptr (returns &environ — the `environ` glibc symbol provides\n"
    buf = buf + " * the extern-data, same as the already-dropped getenv #4243) + __hx_ptr_load/store\n"
    buf = buf + " * intrinsics + an inner `bl hxlcl_malloc` C-ABI call. objcopy --keep-global-symbol\n"
    buf = buf + " * isolates ONLY hxlcl_setenv; its `bl hxlcl_malloc` becomes an undefined external that\n"
    buf = buf + " * the RETAINED shim global hxlcl_malloc resolves (exactly the atoi→atoll composite),\n"
    buf = buf + " * and `environ` is resolved by libc — NO new provider. Under HEXA_RT_NATIVE_SETENV=1\n"
    buf = buf + " * (x86_64-linux gate in tool/stage_resolve_runtime_a) the shim drops setenv (#ifndef\n"
    buf = buf + " * below). DEFAULT (unset) keeps this libc delegate → shim.o + archive byte-identical. */\n"
    buf = buf + "#ifndef HEXA_RT_NATIVE_SETENV\n"
    buf = buf + "#if defined(HEXA_RT_ENV_LIBC)\n"
    buf = buf + "int   hxlcl_setenv(const char *n, const char *v, int o){ return setenv(n, v, o); }\n"
    buf = buf + "#else\n"
    buf = buf + "/* zeroc #29 env-leaf DEFAULT-native: self-contained musl-shaped setenv. Mutates the\n"
    buf = buf + " * libc `environ` global directly (same `environ` data UND as getenv — no NEW reloc),\n"
    buf = buf + " * so semantics match the prior libc delegate for the in-tree PATH-augment caller.\n"
    buf = buf + " * Composite leaf: strlen INLINED via hxlcl_strlen, growth via hxlcl_malloc (retained\n"
    buf = buf + " * shim provider). DELIBERATELY leaky-simple: never frees the replaced string or the\n"
    buf = buf + " * old environ array (setenv is startup-frequency; sole in-tree caller = runtime_core\n"
    buf = buf + " * PATH augment). DEVIATION FROM musl: NO errno store (the #4591 errno-isolation lesson —\n"
    buf = buf + " * musl's EINVAL/ENOMEM are omitted; in-tree callers ignore rc). Opt-out: -DHEXA_RT_ENV_LIBC. */\n"
    buf = buf + "int __attribute__((noinline)) hxlcl_setenv(const char *name, const char *value, int overwrite) {\n"
    buf = buf + "    if (!name || !value) return -1;\n"
    buf = buf + "    size_t nl = 0;\n"
    buf = buf + "    for (; name[nl]; nl++) if (name[nl] == '=') return -1;\n"
    buf = buf + "    if (nl == 0) return -1;\n"
    buf = buf + "    size_t vl = hxlcl_strlen(value);\n"
    buf = buf + "    char **e = environ;\n"
    buf = buf + "    size_t n = 0;\n"
    buf = buf + "    if (e) {\n"
    buf = buf + "        for (; e[n]; n++) {\n"
    buf = buf + "            const char *entry = e[n];\n"
    buf = buf + "            size_t i = 0;\n"
    buf = buf + "            while (i < nl && entry[i] && entry[i] == name[i]) i++;\n"
    buf = buf + "            if (i == nl && entry[i] == '=') {\n"
    buf = buf + "                if (!overwrite) return 0;\n"
    buf = buf + "                char *rec = (char *)hxlcl_malloc(nl + vl + 2);\n"
    buf = buf + "                if (!rec) return -1;\n"
    buf = buf + "                size_t k = 0;\n"
    buf = buf + "                for (size_t j = 0; j < nl; j++) rec[k++] = name[j];\n"
    buf = buf + "                rec[k++] = '=';\n"
    buf = buf + "                for (size_t j = 0; j < vl; j++) rec[k++] = value[j];\n"
    buf = buf + "                rec[k] = '\\0';\n"
    buf = buf + "                e[n] = rec;\n"
    buf = buf + "                return 0;\n"
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    char **na = (char **)hxlcl_malloc((n + 2) * sizeof(char *));\n"
    buf = buf + "    if (!na) return -1;\n"
    buf = buf + "    for (size_t j = 0; j < n; j++) na[j] = e[j];\n"
    buf = buf + "    char *rec = (char *)hxlcl_malloc(nl + vl + 2);\n"
    buf = buf + "    if (!rec) return -1;\n"
    buf = buf + "    size_t k = 0;\n"
    buf = buf + "    for (size_t j = 0; j < nl; j++) rec[k++] = name[j];\n"
    buf = buf + "    rec[k++] = '=';\n"
    buf = buf + "    for (size_t j = 0; j < vl; j++) rec[k++] = value[j];\n"
    buf = buf + "    rec[k] = '\\0';\n"
    buf = buf + "    na[n] = rec;\n"
    buf = buf + "    na[n + 1] = (char *)0;\n"
    buf = buf + "    environ = na;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "#endif\n"
    buf = buf + "/* own-start #29 coherence: under HEXA_ZEROC_OWN_START the ship link is\n"
    buf = buf + " * -nostartfiles (no crt1/crtbegin), so a glibc `atexit` U-ref here pulls\n"
    buf = buf + " * libc_nonshared.a(atexit.oS) whose `__dso_handle` (a crtbegin symbol) is then\n"
    buf = buf + " * undefined -> hexat/hexa link FATAL (measured aiden release_build, main\n"
    buf = buf + " * a372449a). Route to the own 64-slot LIFO exported by runtime.o\n"
    buf = buf + " * (_hxlcl_atexit_register, drained by hxlcl_exit) instead. OFF-path (darwin /\n"
    buf = buf + " * env=0) keeps the libc delegate byte-identical. */\n"
    buf = buf + "#ifdef HEXA_ZEROC_OWN_START\n"
    buf = buf + "extern int _hxlcl_atexit_register(void (*fn)(void));\n"
    buf = buf + "int   hxlcl_atexit(void (*fn)(void))                  { return _hxlcl_atexit_register(fn); }\n"
    buf = buf + "#else\n"
    buf = buf + "int   hxlcl_atexit(void (*fn)(void))                  { return atexit(fn); }\n"
    buf = buf + "#endif\n"
    buf = buf + "/* RT-NATIVE-FORK (HEXA_RT_NATIVE_FORK, default OFF · proc group): hxlcl_fork leaves the\n"
    buf = buf + " * shim via the fp-ABI Route C whole-module emit. The native body\n"
    buf = buf + " * (stdlib/runtime/hxlcl_core.hexa::hxlcl_fork) is a syscall leaf: under the x86_64-linux\n"
    buf = buf + " * emit target the live leg is `__hx_syscall6(57, …)` (__NR_fork) + a negative-result\n"
    buf = buf + " * errno store via `bl __errno_location` (glibc-provided, resolved at link — the same\n"
    buf = buf + " * errno provider the libc-delegate shim already pulls; NO new provider). The arm64/darwin\n"
    buf = buf + " * legs (clone / dual-return fork) are DCE'd out under target_is_x86_64. objcopy isolates\n"
    buf = buf + " * ONLY hxlcl_fork; its `bl __errno_location` is an undefined external resolved by libc.\n"
    buf = buf + " * Under HEXA_RT_NATIVE_FORK=1 (x86_64-linux gate in tool/stage_resolve_runtime_a) the\n"
    buf = buf + " * shim drops fork (#ifndef below). DEFAULT (unset) keeps this libc delegate → shim.o +\n"
    buf = buf + " * archive byte-identical (release-integrity invariant). */\n"
    buf = buf + "#ifndef HEXA_RT_NATIVE_FORK\n"
    buf = buf + "int   hxlcl_fork(void)                                { return (int)fork(); }\n"
    buf = buf + "#endif\n"
    buf = buf + "/* RT-NATIVE-EXECVP (HEXA_RT_NATIVE_EXECVP, default OFF · RFC061 §M8 Wall 3-c COMPOSITE,\n"
    buf = buf + " * exec family TAIL): hxlcl_execvp is supplied by the hexa-NATIVE Route C whole-module\n"
    buf = buf + " * emit (stdlib/runtime/hxlcl_core.hexa::hxlcl_execvp, whitelisted in _is_cabi). The\n"
    buf = buf + " * native body is a $PATH search wrapping execve — has_slash → direct hxlcl_execve, else\n"
    buf = buf + " * split getenv(\"PATH\") on ':' and try each dir+'/'+file via hxlcl_execve (all already-\n"
    if buf.len() > 65536 { _flush_runtime_core_hxlcl_shim(out_path, buf); buf = "" }
    buf = buf + " * dissolved Route C leaves: getenv #4243 / strlen / malloc / execve #4222 / environ via\n"
    buf = buf + " * __hx_environ_ptr). The candidate-path buffer is a hxlcl_malloc HEAP scratch (no in-body\n"
    buf = buf + " * stack-alloc intrinsic on this campaign; popen/fputc/pipe heap-scratch precedent). The\n"
    buf = buf + " * arm64/darwin legs DCE out under target_is_x86_64 (execve carries the per-target NR).\n"
    buf = buf + " * Reference-matched to musl src/process/execvp.c __execvpe + the frozen 0-libc floor body\n"
    buf = buf + " * self/runtime_emit_full.hexa:2963-2986. Under HEXA_RT_NATIVE_EXECVP=1 (x86_64-linux gate\n"
    buf = buf + " * in tool/stage_resolve_runtime_a) the shim drops execvp; DEFAULT (macro undefined) keeps\n"
    buf = buf + " * this libc delegate → shim.o + archive byte-identical (release-integrity invariant). */\n"
    buf = buf + "#ifndef HEXA_RT_NATIVE_EXECVP\n"
    buf = buf + "int   hxlcl_execvp(const char *file, char *const argv[]) { return execvp(file, argv); }\n"
    buf = buf + "#endif\n"
    buf = buf + "/* SELFEMIT (HEXA_RT_SELFEMIT_WAITPID, default OFF · RFC061 §M8 family r9): hxlcl_waitpid\n"
    buf = buf + " * is supplied by the hexa-NATIVE self-emitted .o (test/native_build/emit_hxlcl_waitpid_o.hexa\n"
    buf = buf + " * — class-C `svc #0x80` SYS_wait4 trap + carry-flag errno store, byte-identical to\n"
    buf = buf + " * self/codegen/runtime_arm64.hexa::rt_waitpid, refs the shared `_hxlcl_errno`). DEFAULT\n"
    buf = buf + " * (macro undefined) keeps this libc delegate → shim.o byte-identical. */\n"
    buf = buf + "#ifndef HEXA_RT_SELFEMIT_WAITPID\n"
    buf = buf + "int   hxlcl_waitpid(int pid, int *status, int options){ return (int)waitpid((pid_t)pid, status, options); }\n"
    buf = buf + "#endif\n"
    buf = buf + "/* SELFEMIT (HEXA_RT_SELFEMIT_DUP2, default OFF · RFC061 §M8 family r9): hxlcl_dup2 is\n"
    buf = buf + " * supplied by the hexa-NATIVE self-emitted .o (test/native_build/emit_hxlcl_dup2_o.hexa\n"
    buf = buf + " * — class-C `svc #0x80` SYS_dup2 trap + carry-flag errno store, byte-identical to\n"
    buf = buf + " * self/codegen/runtime_arm64.hexa::rt_dup2, refs the shared `_hxlcl_errno`). DEFAULT\n"
    buf = buf + " * (macro undefined) keeps this libc delegate → shim.o byte-identical. */\n"
    buf = buf + "#ifndef HEXA_RT_SELFEMIT_DUP2\n"
    buf = buf + "int   hxlcl_dup2(int o, int n)                        { return dup2(o, n); }\n"
    buf = buf + "#endif\n"
    buf = buf + "/* RT-NATIVE-PIPE (HEXA_RT_NATIVE_PIPE, default OFF · proc group · errno-bearing chain\n"
    buf = buf + " * batch E): hxlcl_pipe leaves the shim via the Route C whole-module emit (fork / time /\n"
    buf = buf + " * open_sys / clock_gettime precedent). The native body (stdlib/runtime/hxlcl_core.hexa::\n"
    buf = buf + " * hxlcl_pipe, whitelisted in _is_cabi at x86_64_linux.hexa:2290) is an OUT-POINTER syscall\n"
    buf = buf + " * leaf on the x86_64-linux emit target: the kernel WRITES both fds into the caller's int[2]\n"
    buf = buf + " * and returns 0/-errno (the same out-ptr shape as getrusage/stat). The live x86_64-linux leg\n"
    buf = buf + " * is `__hx_syscall6(293, fds, 0, …)` (__NR_pipe2 with flags=0 — the \"flags-trailing uniform\"\n"
    buf = buf + " * dup3 pattern) + a negative-result errno store via `bl __errno_location` (glibc-provided,\n"
    buf = buf + " * resolved at link — the same errno provider the libc-delegate shim already pulls; NO new\n"
    buf = buf + " * provider). The arm64-linux leg (NR 59) and the DARWIN leg (BSD SYS_pipe 42 — a genuine\n"
    buf = buf + " * 2nd-return-register syscall captured via __hx_syscall6_out2 into a 24-byte hxlcl_malloc\n"
    buf = buf + " * bump-arena heap scratch) are DCE'd OUT under the --target=x86_64-linux-gnu emit\n"
    buf = buf + " * (target_is_linux()/target_is_x86_64() are compile-time-resolved per emit target) — so the\n"
    buf = buf + " * isolated pipe .o references NEITHER __hx_syscall6_out2 NOR hxlcl_malloc; its only undefined\n"
    buf = buf + " * external is __errno_location (libc-resolved). The darwin 24B heap-scratch leak is therefore\n"
    buf = buf + " * inert on this gate (darwin path not emitted); it mirrors the frozen floor _hxlcl_pipe_cf\n"
    buf = buf + " * dual-register asm shim's transient scratch (self/runtime_emit_full.hexa:1794) and the\n"
    buf = buf + " * already-landed batch-H time/poll legs' same bump-arena scratch caveat — reference-faithful,\n"
    buf = buf + " * not a new regression. objcopy isolates ONLY hxlcl_pipe; the ld -r multidef gate (S5) is the\n"
    buf = buf + " * authority. BYTE-FAITHFUL to the frozen 0-libc floor body (linux pipe2 syscall leg), NOT to\n"
    buf = buf + " * this shim's libc pipe(2) delegate (standalone-libc measurement TU only). Under\n"
    buf = buf + " * HEXA_RT_NATIVE_PIPE=1 (x86_64-linux gate in tool/stage_resolve_runtime_a) the shim drops\n"
    buf = buf + " * pipe (#ifndef below). DEFAULT (unset) keeps this libc delegate → shim.o + archive\n"
    if buf.len() > 65536 { _flush_runtime_core_hxlcl_shim(out_path, buf); buf = "" }
    buf = buf + " * byte-identical (release-integrity invariant). */\n"
    buf = buf + "#ifndef HEXA_RT_NATIVE_PIPE\n"
    buf = buf + "/* zero-c #29: raw-svc on 64-bit Linux via pipe2(fds,0) (SYS_pipe2 x86_64=293 / arm64=59; arm64 has no legacy pipe); darwin/other keep libc. */\n"
    buf = buf + "int   hxlcl_pipe(int fds[2]) {\n"
    buf = buf + "#if defined(__linux__) && defined(__x86_64__)\n"
    buf = buf + "    long _r; __asm__ volatile(\"syscall\" : \"=a\"(_r) : \"a\"(293L), \"D\"((long)fds), \"S\"(0L) : \"rcx\", \"r11\", \"memory\"); return (int)(_r < 0 ? -1 : 0);\n"
    buf = buf + "#elif defined(__linux__) && defined(__aarch64__)\n"
    buf = buf + "    register long _x8 __asm__(\"x8\") = 59L; register long _x0 __asm__(\"x0\") = (long)fds; register long _x1 __asm__(\"x1\") = 0L;\n"
    buf = buf + "    __asm__ volatile(\"svc 0\" : \"+r\"(_x0) : \"r\"(_x8), \"r\"(_x1) : \"memory\"); return (int)(_x0 < 0 ? -1 : 0);\n"
    buf = buf + "#else\n"
    buf = buf + "    return pipe(fds);\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "/* RT-NATIVE SIGNAL (HEXA_RT_NATIVE_SIGNAL, default OFF · Route C ING#29 ∅−7 · sa_restorer\n"
    buf = buf + " * WIRED). The shim member delegates to libc signal(3) (which does the full __libc_sigaction\n"
    buf = buf + " * bookkeeping — restorer trampoline, rt_sigprocmask SIGPT_SET unblock, handler_set). The\n"
    buf = buf + " * native Route C body (stdlib/runtime/hxlcl_core.hexa hxlcl_signal) reproduces the musl\n"
    buf = buf + " * signal.c→rt_sigaction path via heap-scratch k_sigaction + __hx_syscall6, and wires the\n"
    buf = buf + " * x86_64 sa_restorer field with __hx_fn_addr(_hx_rt_sigreturn_trampoline) — a @naked\n"
    buf = buf + " * trampoline (mov rax,15 ; syscall = rt_sigreturn NR 15, reference-match glibc restore_rt /\n"
    buf = buf + " * musl __restore_rt). This dissolves the prior SA_RESTORER wall (commit 01f13609b): the\n"
    buf = buf + " * kernel now has a valid restorer, so the handler returns cleanly (RC=0, not SIGSEGV 139).\n"
    buf = buf + " * arm64 needs no restorer (kernel supplies the trampoline). Under HEXA_RT_NATIVE_SIGNAL=1\n"
    buf = buf + " * (x86_64-linux gate in tool/stage_resolve_runtime_a) the shim drops signal (#ifndef below).\n"
    buf = buf + " * DEFAULT (unset) keeps this libc delegate → shim.o + archive byte-identical (release-\n"
    buf = buf + " * integrity invariant). */\n"
    buf = buf + "#ifndef HEXA_RT_NATIVE_SIGNAL\n"
    buf = buf + "void *hxlcl_signal(int signum, void *handler)         { return (void *)signal(signum, (void (*)(int))handler); }\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "/* ── file / io ───────────────────────────────────────────────────────────── */\n"
    buf = buf + "/* RT-NATIVE CORE FILE* family (HEXA_RT_NATIVE_{FOPEN,FREAD,FTELL,FSEEK}, default\n"
    buf = buf + " * OFF · Route C whole-module emit · COUPLED leaves, NOT pure like strstr/free):\n"
    buf = buf + " * the frozen 0-libc floor models a FILE* as `(void*)(uintptr_t)(fd+1)` (NOT a libc\n"
    buf = buf + " * stdio struct), so the native Route C bodies (stdlib/runtime/hxlcl_core.hexa:\n"
    buf = buf + " * 2264 fopen · 2351 fread · 2415 ftell · 2427 fseek) are a PURE COMPOSITION over\n"
    buf = buf + " * the already-dissolved syscall LEAVES — fopen→hxlcl_open_sys, fread→hxlcl_read,\n"
    buf = buf + " * ftell/fseek→hxlcl_lseek — plus raw-payload pointer arithmetic. Those inner\n"
    buf = buf + " * callees stay RETAINED shim globals (below), so the objcopy-isolated native .o's\n"
    buf = buf + " * external relocs (bl hxlcl_open_sys/read/lseek) resolve from the shim (the\n"
    buf = buf + " * atoi→atoll / strdup→malloc coupled-leaf class, NOT the strstr/free zero-reloc\n"
    buf = buf + " * class). The libc-global stdout/stderr/stdin (fp>=0x1000) branch is out of scope\n"
    buf = buf + " * — high pointers fail safe (shim-resident std-stream family). Under\n"
    buf = buf + " * HEXA_RT_NATIVE_<SYM>=1 (x86_64-linux gate in tool/stage_resolve_runtime_a) the\n"
    buf = buf + " * shim drops that member and the isolated native .o supplies it. DEFAULT (unset)\n"
    buf = buf + " * keeps these libc delegates; shim.o + archive byte-identical (release-integrity\n"
    buf = buf + " * invariant). Reference-matched to the frozen emitter bodies\n"
    buf = buf + " * self/runtime_emit_full.hexa:1153-1242. */\n"
    buf = buf + "/* L3 axis-② FILE* MULTIOBJ swap (HXLCL_STDIO_LINK, default OFF · zero-c #29):\n"
    buf = buf + " * re-supply the WHOLE FILE* subset as the frozen fake-fd bodies\n"
    buf = buf + " * (FILE* == (void*)(uintptr_t)(fd+1)), byte-for-byte the single-TU amalgam\n"
    buf = buf + " * (runtime_emit_full.hexa) impl, so the MULTIOBJ runtime_core.o FILE* call\n"
    buf = buf + " * sites — redirected via runtime_core_sysheaders.h under the SAME gate — route\n"
    buf = buf + " * HERE instead of glibc, dropping fopen/fread/fwrite/fclose/ftell/fseek from\n"
    buf = buf + " * the runtime.a nm-UND floor. Inner callees hxlcl_open_sys/read/close/lseek are\n"
    buf = buf + " * RETAINED shim globals; hxlcl_fwrite's hxlcl_write is the runtime.o export\n"
    buf = buf + " * (HEXA_RT_STDIO_NATIVE, on in MULTIOBJ — the coupling this gate requires).\n"
    buf = buf + " * ATOMIC subset (incl. fflush) so fuel_abort's real-fopen'd log\n"
    buf = buf + " * (fopen+fwrite+fflush(f)) stays coherent — no partial-redirect SIGSEGV. This\n"
    buf = buf + " * arm is MUTUALLY EXCLUSIVE with the per-symbol HEXA_RT_NATIVE_F{OPEN,READ,\n"
    buf = buf + " * TELL,SEEK} Route-C-.o gates in the #else branch (it supplies the bodies\n"
    buf = buf + " * inline instead of dropping the symbol). DEFAULT (gate OFF) preprocesses to\n"
    buf = buf + " * the #else branch VERBATIM → shim.o + archive byte-identical. */\n"
    buf = buf + "#ifdef HXLCL_STDIO_LINK\n"
    buf = buf + "/* forward decls for the inner syscall leaves (defined below in this TU) + the\n"
    buf = buf + " * runtime.o-exported hxlcl_write (HEXA_RT_STDIO_NATIVE) — the fake-fd bodies\n"
    buf = buf + " * below call them before their in-file definitions/imports. */\n"
    buf = buf + "int    hxlcl_open_sys(const char *path, int flags, ...);\n"
    buf = buf + "long   hxlcl_read(int fd, void *buf, unsigned long n);\n"
    buf = buf + "long   hxlcl_write(int fd, const void *buf, unsigned long n);\n"
    buf = buf + "int    hxlcl_close(int fd);\n"
    buf = buf + "long   hxlcl_lseek(int fd, long off, int whence);\n"
    buf = buf + "void *__attribute__((noinline)) hxlcl_fopen(const char *path, const char *mode) {\n"
    buf = buf + "    if (!path || !mode) return (void *)0;\n"
    buf = buf + "    int flags = 0;\n"
    buf = buf + "    if (mode[0] == 'r') flags = O_RDONLY;\n"
    buf = buf + "    else if (mode[0] == 'w') flags = O_WRONLY | O_CREAT | O_TRUNC;\n"
    buf = buf + "    else if (mode[0] == 'a') flags = O_WRONLY | O_CREAT | O_APPEND;\n"
    buf = buf + "    else return (void *)0;\n"
    buf = buf + "    if (mode[1] == '+' || (mode[1] != 0 && mode[2] == '+')) {\n"
    buf = buf + "        flags = (flags & ~(O_RDONLY | O_WRONLY)) | O_RDWR;\n"
    buf = buf + "    }\n"
    buf = buf + "    int fd = hxlcl_open_sys(path, flags, 0644);\n"
    buf = buf + "    if (fd < 0) return (void *)0;\n"
    buf = buf + "    if (fd <= 2) return (void *)0;  /* never alias stdin/out/err (content-leak guard) */\n"
    buf = buf + "    return (void *)(uintptr_t)(fd + 1);\n"
    buf = buf + "}\n"
    buf = buf + "int __attribute__((noinline)) hxlcl_fclose(void *fp) {\n"
    buf = buf + "    if (!fp) return -1;\n"
    buf = buf + "    uintptr_t v = (uintptr_t)fp;\n"
    buf = buf + "    if (v >= 0x1000) return 0;  /* libc FILE* — don't close */\n"
    buf = buf + "    int fd = (int)v - 1;\n"
    buf = buf + "    if (fd < 3) return 0;  /* safety: never close 0/1/2 */\n"
    buf = buf + "    return hxlcl_close(fd);\n"
    buf = buf + "}\n"
    buf = buf + "int __attribute__((noinline)) _hxlcl_fp_fd(void *fp) {\n"
    buf = buf + "    uintptr_t v = (uintptr_t)fp;\n"
    buf = buf + "    if (v >= 0x1000) {\n"
    buf = buf + "        if (fp == (void *)stderr) return 2;\n"
    buf = buf + "        if (fp == (void *)stdout) return 1;\n"
    buf = buf + "        if (fp == (void *)stdin) return 0;\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    return (int)v - 1;\n"
    buf = buf + "}\n"
    if buf.len() > 65536 { _flush_runtime_core_hxlcl_shim(out_path, buf); buf = "" }
    buf = buf + "size_t __attribute__((noinline)) hxlcl_fread(void *buf_, size_t sz, size_t n, void *fp) {\n"
    buf = buf + "    if (!buf_ || sz == 0 || n == 0) return 0;\n"
    buf = buf + "    int fd = _hxlcl_fp_fd(fp);\n"
    buf = buf + "    if (fd < 0) return 0;\n"
    buf = buf + "    size_t total = sz * n;\n"
    buf = buf + "    size_t got = 0;\n"
    buf = buf + "    unsigned char *p = (unsigned char *)buf_;\n"
    buf = buf + "    while (got < total) {\n"
    buf = buf + "        long r = (long)hxlcl_read(fd, p + got, total - got);\n"
    buf = buf + "        if (r <= 0) break;\n"
    buf = buf + "        got += (size_t)r;\n"
    buf = buf + "    }\n"
    buf = buf + "    return got / sz;\n"
    buf = buf + "}\n"
    buf = buf + "size_t __attribute__((noinline)) hxlcl_fwrite(const void *buf_, size_t sz, size_t n, void *fp) {\n"
    buf = buf + "    if (!buf_ || sz == 0 || n == 0) return 0;\n"
    buf = buf + "    int fd = _hxlcl_fp_fd(fp);\n"
    buf = buf + "    if (fd < 0) return 0;\n"
    buf = buf + "    size_t total = sz * n;\n"
    buf = buf + "    size_t put = 0;\n"
    buf = buf + "    const unsigned char *p = (const unsigned char *)buf_;\n"
    buf = buf + "    while (put < total) {\n"
    buf = buf + "        long r = (long)hxlcl_write(fd, p + put, total - put);\n"
    buf = buf + "        if (r <= 0) break;\n"
    buf = buf + "        put += (size_t)r;\n"
    buf = buf + "    }\n"
    buf = buf + "    return put / sz;\n"
    buf = buf + "}\n"
    buf = buf + "long __attribute__((noinline)) hxlcl_ftell(void *fp) {\n"
    buf = buf + "    int fd = _hxlcl_fp_fd(fp);\n"
    buf = buf + "    if (fd < 0) return -1;\n"
    buf = buf + "    return (long)hxlcl_lseek(fd, 0, SEEK_CUR);\n"
    buf = buf + "}\n"
    buf = buf + "int __attribute__((noinline)) hxlcl_fseek(void *fp, long offset, int whence) {\n"
    buf = buf + "    int fd = _hxlcl_fp_fd(fp);\n"
    buf = buf + "    if (fd < 0) return -1;\n"
    buf = buf + "    return hxlcl_lseek(fd, (off_t)offset, whence) < 0 ? -1 : 0;\n"
    buf = buf + "}\n"
    buf = buf + "void *__attribute__((noinline)) hxlcl_fdopen(int fd, const char *mode) {\n"
    buf = buf + "    (void)mode;\n"
    buf = buf + "    if (fd < 0) return (void *)0;\n"
