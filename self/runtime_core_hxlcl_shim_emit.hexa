    buf = buf + " * decimal-parse leaf (stdlib/runtime/hxlcl_core.hexa::hxlcl_atoll — whitespace skip +\n"
    buf = buf + " * sign + base-10 digit accumulation via raw __hx_payload_* intrinsics): zero syscall,\n"
    if buf.len() > 65536 { _flush_runtime_core_hxlcl_shim(out_path, buf); buf = "" }
    buf = buf + " * zero errno, zero inner C-ABI callee, zero extern-data — exactly the strstr/strtoll\n"
    buf = buf + " * pure-leaf class. Under HEXA_RT_NATIVE_ATOLL=1 (x86_64-linux gate in\n"
