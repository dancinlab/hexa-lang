    buf = buf + " * Opt-out: -DHEXA_RT_MEM_LIBC. */\n"
    buf = buf + "#define HXLCL_SL_ONES  ((size_t)-1 / 0xff)\n"
    buf = buf + "#define HXLCL_SL_HIGHS (HXLCL_SL_ONES * 0x80)\n"
    buf = buf + "#define HXLCL_SL_HASZERO(x) (((x) - HXLCL_SL_ONES) & ~(x) & HXLCL_SL_HIGHS)\n"
    buf = buf + "size_t __attribute__((noinline)) hxlcl_strlen(const char *s) {\n"
