    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "/* ── time ────────────────────────────────────────────────────────────────── */\n"
    buf = buf + "/* RT-NATIVE-TIME (HEXA_RT_NATIVE_TIME, default OFF · proc group): hxlcl_time leaves the\n"
    buf = buf + " * shim via the fp-ABI Route C whole-module emit. The native body\n"
