    buf = buf + "/* F1 header-parity (zeroc #29): HXLCL_HDR_BYTES serves the HEXA_RT_NATIVE_REALLOC\n"
    buf = buf + " * header-write arms below as well as the BYTEID measurement arm above. */\n"
    buf = buf + "#ifndef HXLCL_HDR_BYTES\n"
    buf = buf + "#define HXLCL_HDR_BYTES 16\n"
    buf = buf + "#endif\n"
    buf = buf + "/* F2 (zeroc #29 realloc re-arch): the reserved 8 bytes at base[8..16) hold a family\n"
    buf = buf + " * MAGIC so free/realloc are magic-GUARDED — a foreign pointer (arena kdup key, any\n"
