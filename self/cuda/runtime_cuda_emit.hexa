    buf = buf + "\n"
    buf = buf + "/* ── RoPE host wrappers (RFC 041 Phase B completion) ────────────────\n"
    buf = buf + " * Signature: (t_id, cos_id, sin_id, T, nheads, hd, out_id). Caller\n"
    buf = buf + " * (self/runtime.c) has pre-allocated out_id via hexa_farr_zeros with\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + " * len = T·nheads·hd. Validate → H2D the 3 inputs → ensure output\n"
    buf = buf + " * device buffer → launch the per-element kernel → D2H → MIRRORED.\n"
    buf = buf + " * `out` is a fresh buffer (separate from the input) so the rotation\n"
    buf = buf + " * reads originals — the byte-exact contract holds. */\n"
    buf = buf + "\n"
    buf = buf + "static int _hx_cuda_rope_common(int64_t t_id, int64_t cos_id,\n"
    buf = buf + "                                int64_t sin_id, int64_t T,\n"
    buf = buf + "                                int64_t nheads, int64_t hd,\n"
    buf = buf + "                                int64_t out_id, int is_bwd) {\n"
    buf = buf + "    const char* tag = is_bwd ? \"rope_bwd\" : \"rope\";\n"
    buf = buf + "    if (T <= 0 || nheads <= 0 || hd <= 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] %s: bad shape T=%lld nheads=%lld hd=%lld\\n\",\n"
    buf = buf + "                tag, (long long)T, (long long)nheads, (long long)hd);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if ((hd & 1) != 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] %s: hd=%lld must be even\\n\",\n"
    buf = buf + "                tag, (long long)hd);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (t_id < 0 || cos_id < 0 || sin_id < 0 || out_id < 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] %s: bad ids %lld %lld %lld %lld\\n\",\n"
    buf = buf + "                tag, (long long)t_id, (long long)cos_id,\n"
    buf = buf + "                (long long)sin_id, (long long)out_id);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (t_id >= _hx_farr_count || cos_id >= _hx_farr_count ||\n"
    buf = buf + "        sin_id >= _hx_farr_count || out_id >= _hx_farr_count) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] %s: id out of range\\n\", tag);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    int64_t total = T * nheads * hd;\n"
    buf = buf + "    if (_hx_farr_table[t_id].len < total ||\n"
    buf = buf + "        _hx_farr_table[out_id].len < total) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] %s: tensor host len < T*nheads*hd %lld\\n\",\n"
    buf = buf + "                tag, (long long)total);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_hx_farr_table[cos_id].len < T * hd ||\n"
    buf = buf + "        _hx_farr_table[sin_id].len < T * hd) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] %s: cos/sin host len < T*hd %lld\\n\",\n"
    buf = buf + "                tag, (long long)(T * hd));\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_h2d(t_id) != 0)   return -1;\n"
    buf = buf + "    if (_h2d(cos_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(sin_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_buf(out_id, total) != 0) return -1;\n"
    buf = buf + "    const double* X   = g_slots[t_id].d_buf;\n"
    buf = buf + "    const double* COS = g_slots[cos_id].d_buf;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    const double* SIN = g_slots[sin_id].d_buf;\n"
    buf = buf + "    double*       Y   = g_slots[out_id].d_buf;\n"
    buf = buf + "    int grid = _hx_cuda_elem_grid(total);\n"
    buf = buf + "    if (is_bwd) {\n"
    buf = buf + "        _hx_cuda_kern_rope_bwd<<<grid, _HX_CUDA_ELEM_BLOCK, 0, _forge_stream()>>>(\n"
    buf = buf + "            X, COS, SIN, Y, T, nheads, hd);\n"
    buf = buf + "    } else {\n"
    buf = buf + "        _hx_cuda_kern_rope_fwd<<<grid, _HX_CUDA_ELEM_BLOCK, 0, _forge_stream()>>>(\n"
    buf = buf + "            X, COS, SIN, Y, T, nheads, hd);\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_forge_launch_check(tag) != 0) return -1;\n"
    buf = buf + "    if (_d2h_out(out_id, total) != 0) return -1;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "int _hx_cuda_farr_rope_gpu(int64_t t_id, int64_t cos_id, int64_t sin_id,\n"
    buf = buf + "                           int64_t T, int64_t nheads, int64_t hd,\n"
    buf = buf + "                           int64_t out_id) {\n"
    buf = buf + "    return _hx_cuda_rope_common(t_id, cos_id, sin_id, T, nheads, hd,\n"
    buf = buf + "                                out_id, 0);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "int _hx_cuda_farr_rope_bwd_gpu(int64_t t_id, int64_t cos_id, int64_t sin_id,\n"
    buf = buf + "                               int64_t T, int64_t nheads, int64_t hd,\n"
    buf = buf + "                               int64_t out_id) {\n"
    buf = buf + "    return _hx_cuda_rope_common(t_id, cos_id, sin_id, T, nheads, hd,\n"
    buf = buf + "                                out_id, 1);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ── Transpose-scatter host wrapper (RFC 058 §5.2) ──────────────────\n"
    buf = buf + " *\n"
    buf = buf + " * Fills a slab of dst with the transpose of src on-device:\n"
    buf = buf + " *   dst[dst_off + c*rows + r] = src[r*cols + c]   (rows×cols → cols×rows)\n"
    buf = buf + " *\n"
    buf = buf + " * src is the cuBLAS projection output C — left FARR_DEVICE/dirty_dev by\n"
    buf = buf + " * RFC 057 §6.1, so _h2d(src_id) SKIPs the redundant H2D (H2D-skip\n"
    buf = buf + " * predicate, line ~190). dst is Bc — populated slab-by-slab. The kernel\n"
    buf = buf + " * writes ONLY the [dst_off, dst_off+rows*cols) range, so dst's current\n"
    buf = buf + " * device contents must be correct outside that range; _h2d(dst_id)\n"
    buf = buf + " * uploads dst's host bytes first (and SKIPs once dst is already\n"
    buf = buf + " * device-authoritative — exactly the residency win RFC 058 unlocks).\n"
    buf = buf + " *\n"
    buf = buf + " * On return dst (Bc) is MIRRORED — the kernel result is copied D2H back\n"
    buf = buf + " * to the host buffer so host Bc == device Bc byte-identically.\n"
    buf = buf + " *\n"
    buf = buf + " * RFC 058 byte-eq fix (fire #13 regression): the original wrapper marked\n"
    buf = buf + " * dst loc=FARR_DEVICE/dirty_host=1 and SKIPPED the D2H (\"device freshest,\n"
    buf = buf + " * a host reader triggers a lazy D2H\"). But the downstream A2-block ops\n"
    buf = buf + " * (RMSNorm/RoPE/attention/SwiGLU slabs in flame_phase4d7_block_*_\n"
    buf = buf + " * primitive.c) read Bc via the RAW host pointer `_hx_farr_table[Bc].buf`\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + " * — NOT through a farr API — so the lazy-D2H trigger never fires. They\n"
    buf = buf + " * read STALE host Bc bytes → wrong numerics (d768 init gn2 3.98438 vs\n"
    buf = buf + " * the correct 3.99026 of fires #8–#12).\n"
    buf = buf + " *\n"
    buf = buf + " * Device residency is all-or-nothing: marking Bc device-authoritative\n"
    buf = buf + " * while consumers still host-read it breaks byte-eq. Until every Bc\n"
    buf = buf + " * reader is converted to hexa_farr_dev_view (RFC 057 §6.2 consume wiring,\n"
    buf = buf + " * flame Phase 4-D-9 — element-loop kernels for RMSNorm/RoPE/attention/\n"
    buf = buf + " * SwiGLU not yet landed), the wrapper MUST D2H so the host buffer is\n"
    buf = buf + " * correct. The full-buffer _d2h is valid here: _h2d(dst_id) above\n"
    buf = buf + " * uploaded dst's whole host buffer, the kernel wrote only the slab, so\n"
    buf = buf + " * the device buffer holds the entire correct Bc; _d2h copies it all\n"
    buf = buf + " * back, sets dirty_host=0, loc=FARR_MIRRORED. The device copy stays live\n"
    buf = buf + " * (MIRRORED) so a later GPU op's _h2d still SKIPs — no wall regression\n"
    buf = buf + " * beyond the D2H round-trip itself.\n"
    buf = buf + " *\n"
    buf = buf + " * NOTE the d=32 path NEVER reaches this wrapper — the consumer keeps the\n"
    buf = buf + " * host transpose loop below the dim-gate (RFC 058 §5.4) so d=32 stays\n"
    buf = buf + " * byte-identical. This is purely the d768 GPU-resident path. */\n"
    buf = buf + "int _hx_cuda_farr_transpose_scatter_gpu(int64_t src_id, int64_t dst_id,\n"
    buf = buf + "                                        int64_t rows, int64_t cols,\n"
    buf = buf + "                                        int64_t dst_off) {\n"
    buf = buf + "    if (src_id < 0 || dst_id < 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] transpose_scatter: bad ids %lld %lld\\n\",\n"
    buf = buf + "                (long long)src_id, (long long)dst_id);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (rows <= 0 || cols <= 0 || dst_off < 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] transpose_scatter: bad shape \"\n"
    buf = buf + "                \"rows=%lld cols=%lld dst_off=%lld\\n\",\n"
    buf = buf + "                (long long)rows, (long long)cols, (long long)dst_off);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (src_id >= _hx_farr_count || dst_id >= _hx_farr_count) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] transpose_scatter: id out of range\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    int64_t total = rows * cols;\n"
    buf = buf + "    if (_hx_farr_table[src_id].len < total) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] transpose_scatter: src host len %lld \"\n"
    buf = buf + "                \"< rows*cols %lld\\n\",\n"
    buf = buf + "                (long long)_hx_farr_table[src_id].len, (long long)total);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_hx_farr_table[dst_id].len < dst_off + total) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] transpose_scatter: dst host len %lld \"\n"
    buf = buf + "                \"< dst_off+rows*cols %lld\\n\",\n"
    buf = buf + "                (long long)_hx_farr_table[dst_id].len,\n"
    buf = buf + "                (long long)(dst_off + total));\n"
    buf = buf + "        return -1;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    }\n"
    buf = buf + "    /* src device-resident → _h2d SKIPs (RFC 057 §6.1). dst current host\n"
    buf = buf + "     * bytes uploaded so the kernel preserves regions outside the slab;\n"
    buf = buf + "     * SKIPs once dst is already device-authoritative. */\n"
    buf = buf + "    if (_h2d(src_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(dst_id) != 0) return -1;\n"
    buf = buf + "    const double* SRC = g_slots[src_id].d_buf;\n"
    buf = buf + "    double*       DST = g_slots[dst_id].d_buf;\n"
    buf = buf + "    if (!SRC || !DST) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] transpose_scatter: null device buf\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    int grid = _hx_cuda_elem_grid(total);\n"
    buf = buf + "    _hx_cuda_kern_transpose_scatter<<<grid, _HX_CUDA_ELEM_BLOCK, 0, _forge_stream()>>>(\n"
    buf = buf + "        SRC, DST, rows, cols, dst_off);\n"
    buf = buf + "    if (_forge_launch_check(\"transpose_scatter\") != 0) return -1;\n"
    buf = buf + "    /* RFC 058 byte-eq fix — D2H the kernel result back to the host buffer.\n"
    buf = buf + "     * Downstream A2-block consumers (RMSNorm/RoPE/attention/SwiGLU slabs)\n"
    buf = buf + "     * read Bc via the RAW host pointer, NOT a farr API, so the lazy-D2H\n"
    buf = buf + "     * trigger never fires; the host buffer MUST therefore be made fresh\n"
    buf = buf + "     * here. _d2h copies the whole device buffer back (it holds the entire\n"
    buf = buf + "     * correct Bc — see header), sets dirty_host=0, loc=FARR_MIRRORED. The\n"
    buf = buf + "     * device pointer stays live so a later GPU op's _h2d still SKIPs. The\n"
    buf = buf + "     * resident-residency win (dropping this D2H) lands once all Bc readers\n"
    buf = buf + "     * are converted to hexa_farr_dev_view — flame Phase 4-D-9. */\n"
    buf = buf + "    if (_d2h(dst_id) != 0) return -1;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "\n"
    buf = buf + "\n"
    buf = buf + "\n"
    buf = buf + "/* ── mk2 dt_* faithful device transcendentals restored from e030fa31 ─\n"
    buf = buf + " * _hx_cuda_dt_exp_d / _hx_cuda_dt_sqrt_d: non-contracted (__dmul_rn/\n"
    buf = buf + " * __dadd_rn/__ddiv_rn) device mirrors of the CPU _hx_dt_*_d, byte-eq\n"
    buf = buf + " * under FP_CONTRACT OFF (commit b73269ea discipline). Called by the\n"
    buf = buf + " * mk2-C5 device kernels below — must precede them. */\n"
    buf = buf + "__device__ __forceinline__ double _hx_cuda_dt_exp_d(double x) {\n"
    buf = buf + "    int r = 0;\n"
    buf = buf + "    double xr = x;\n"
    buf = buf + "    while ((xr > 0.0 ? xr : 0.0 - xr) > 0.25) { xr = xr / 2.0; r = r + 1; }\n"
    buf = buf + "    double term = 1.0;\n"
    buf = buf + "    double acc  = 1.0;\n"
    buf = buf + "    int k = 1;\n"
    buf = buf + "    while (k < 12) {\n"
    buf = buf + "        term = __ddiv_rn(__dmul_rn(term, xr), (double)k);\n"
    buf = buf + "        acc  = __dadd_rn(acc, term);\n"
    buf = buf + "        k = k + 1;\n"
    buf = buf + "    }\n"
    buf = buf + "    int s = 0;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    while (s < r) { acc = __dmul_rn(acc, acc); s = s + 1; }\n"
    buf = buf + "    return acc;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* mk2-C2 (2026-05-19): dt_sqrt byte-exact device mirror of hexa\n"
    buf = buf + " * flame_math `dt_sqrt` (24-iter Newton from g0 = max(x,1)). The\n"
    buf = buf + " * decoder-block rmsnorm reference uses dt_sqrt, NOT libm sqrt —\n"
    buf = buf + " * same FMA / transcendental hazard as dt_exp. __dmul_rn / __ddiv_rn /\n"
    buf = buf + " * __dadd_rn = contraction-immune, byte-eq to host _hx_dt_sqrt_d\n"
    buf = buf + " * under FP_CONTRACT OFF (same discipline as the silu-gate dt_exp\n"
    buf = buf + " * mirror, commit e5faa8b0). */\n"
    buf = buf + "__device__ __forceinline__ double _hx_cuda_dt_sqrt_d(double x) {\n"
    buf = buf + "    if (x <= 0.0) return 0.0;\n"
    buf = buf + "    double g = x > 1.0 ? x : 1.0;\n"
    buf = buf + "    int i = 0;\n"
    buf = buf + "    while (i < 24) {\n"
    buf = buf + "        g = __dmul_rn(0.5, __dadd_rn(g, __ddiv_rn(x, g)));\n"
    buf = buf + "        i = i + 1;\n"
    buf = buf + "    }\n"
    buf = buf + "    return g;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ── mk2-C5 __global__ device kernels restored from e030fa31 ───────\n"
    buf = buf + " * Launched by the host wrappers immediately below; the A/B/C merge\n"
    buf = buf + " * dropped both halves. Pure double* math kernels, FP_CONTRACT-safe\n"
    buf = buf + " * (compiled by nvcc -x cu). Must precede the host launchers. */\n"
    buf = buf + "__global__ void _hx_cuda_kern_rmsnorm_mh(const double* __restrict__ X,\n"
    buf = buf + "                                         const double* __restrict__ G,\n"
    buf = buf + "                                         double* __restrict__ Y,\n"
    buf = buf + "                                         double* __restrict__ XN,\n"
    buf = buf + "                                         double* __restrict__ I,\n"
    buf = buf + "                                         int64_t T, int64_t d) {\n"
    buf = buf + "    int64_t i      = (int64_t)blockIdx.x * (int64_t)blockDim.x + (int64_t)threadIdx.x;\n"
    buf = buf + "    int64_t stride = (int64_t)gridDim.x  * (int64_t)blockDim.x;\n"
    buf = buf + "    const double eps = 0.000001;\n"
    buf = buf + "    for (; i < T; i += stride) {\n"
    buf = buf + "        double ms = 0.0;\n"
    buf = buf + "        for (int64_t c = 0; c < d; c++) {\n"
    buf = buf + "            double xv = X[i*d + c];\n"
    buf = buf + "            ms = __dadd_rn(ms, __dmul_rn(xv, xv));\n"
    buf = buf + "        }\n"
    buf = buf + "        ms = __ddiv_rn(ms, (double)d);\n"
    buf = buf + "        double iv = __ddiv_rn(1.0, _hx_cuda_dt_sqrt_d(__dadd_rn(ms, eps)));\n"
    buf = buf + "        I[i] = iv;\n"
    buf = buf + "        for (int64_t c = 0; c < d; c++) {\n"
    buf = buf + "            double xni = __dmul_rn(X[i*d + c], iv);\n"
    buf = buf + "            XN[i*d + c] = xni;\n"
    buf = buf + "            Y[i*d + c]  = __dmul_rn(G[c], xni);\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* mk2-C5 (2026-05-19): farr_copy_slice + farr_transpose_2d device\n"
    buf = buf + " * kernels — bandwidth-bound memcpy / memory rearrangement. No FP\n"
    buf = buf + " * arithmetic → trivially byte-eq with the host scalar t_get/t_set\n"
    buf = buf + " * loop. Eliminates the ~412M scalar HexaVal-box prelude that\n"
    buf = buf + " * dominated the d768·12L generic ag_tape step (mk2-FINAL #1 fire\n"
    buf = buf + " * 2026-05-19 timeout at 901s with 14min GPU idle). */\n"
    buf = buf + "__global__ void _hx_cuda_kern_copy_slice(const double* __restrict__ src,\n"
    buf = buf + "                                         double* __restrict__ dst,\n"
    buf = buf + "                                         int64_t n) {\n"
    buf = buf + "    int64_t i      = (int64_t)blockIdx.x * (int64_t)blockDim.x + (int64_t)threadIdx.x;\n"
    buf = buf + "    int64_t stride = (int64_t)gridDim.x  * (int64_t)blockDim.x;\n"
    buf = buf + "    for (; i < n; i += stride) {\n"
    buf = buf + "        dst[i] = src[i];\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* transpose: dst[c·d_out + r] = src[soff + r·d_in + c], one thread per\n"
    buf = buf + " * (r, c) cell. byte-identical to the agt_wT_slice / agt_wT_off host\n"
    buf = buf + " * loop (no FP — pure memory rearrangement). */\n"
    buf = buf + "__global__ void _hx_cuda_kern_transpose_2d(const double* __restrict__ src,\n"
    buf = buf + "                                           int64_t soff,\n"
    buf = buf + "                                           double* __restrict__ dst,\n"
    buf = buf + "                                           int64_t doff,\n"
    buf = buf + "                                           int64_t d_out, int64_t d_in) {\n"
    buf = buf + "    int64_t flat   = (int64_t)blockIdx.x * (int64_t)blockDim.x + (int64_t)threadIdx.x;\n"
    buf = buf + "    int64_t total  = d_out * d_in;\n"
    buf = buf + "    int64_t stride = (int64_t)gridDim.x  * (int64_t)blockDim.x;\n"
    buf = buf + "    for (; flat < total; flat += stride) {\n"
    buf = buf + "        int64_t r = flat / d_in;\n"
    buf = buf + "        int64_t c = flat - r * d_in;\n"
    buf = buf + "        dst[doff + c * d_out + r] = src[soff + r * d_in + c];\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* mk2-C4 (2026-05-19): GQA attention-dt forge-route. One thread per\n"
    buf = buf + " * (head, query) pair = nh·T threads (strict per-pair sequential for\n"
    buf = buf + " * byte-eq with the host loop's nested hh→i→j order). Memory contract:\n"
    buf = buf + " *   in:  Q[T·nh·hd], K[T·nkv·hd], V[T·nkv·hd]\n"
    buf = buf + " *   out: P[nh·T·T]   — causal probs, j ∈ [0,i+1); j ∈ [i+1,T) is 0.\n"
    buf = buf + " *        CTX[T·nh·hd]\n"
    buf = buf + " * Uses dt_sqrt mirror (scale=1/√hd) + dt_exp mirror (stable softmax).\n"
    buf = buf + " * P doubles as scratch: step 1 writes raw scores; steps 3-4 transform\n"
    buf = buf + " * in place to probs. Op order byte-identical to ag_tape.hexa\n"
    buf = buf + " * _ag_attn_dt_fwd (causal mask + per-row stable softmax + GQA kvh =\n"
    buf = buf + " * hh/n_rep). */\n"
    buf = buf + "__global__ void _hx_cuda_kern_attn_dt_fwd(const double* __restrict__ Q,\n"
    buf = buf + "                                          const double* __restrict__ K,\n"
    buf = buf + "                                          const double* __restrict__ V,\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "                                          double* __restrict__ P,\n"
    buf = buf + "                                          double* __restrict__ CTX,\n"
    buf = buf + "                                          int64_t T, int64_t nh,\n"
    buf = buf + "                                          int64_t nkv, int64_t hd) {\n"
    buf = buf + "    int64_t flat   = (int64_t)blockIdx.x * (int64_t)blockDim.x + (int64_t)threadIdx.x;\n"
    buf = buf + "    int64_t total  = nh * T;\n"
    buf = buf + "    int64_t stride = (int64_t)gridDim.x  * (int64_t)blockDim.x;\n"
    buf = buf + "    int64_t n_rep  = nh / nkv;\n"
    buf = buf + "    int64_t d      = nh * hd;\n"
    buf = buf + "    /* scale = 1 / dt_sqrt(hd). dt_sqrt-faithful (NOT libm sqrt) —\n"
    buf = buf + "     * same hazard as rmsnorm. */\n"
    buf = buf + "    double scale = __ddiv_rn(1.0, _hx_cuda_dt_sqrt_d((double)hd));\n"
    buf = buf + "    for (; flat < total; flat += stride) {\n"
    buf = buf + "        int64_t hh  = flat / T;\n"
    buf = buf + "        int64_t i   = flat % T;\n"
    buf = buf + "        int64_t kvh = hh / n_rep;\n"
    buf = buf + "        int64_t L   = i + 1;\n"
    buf = buf + "        /* Step 1: P[hh,i,j] = dot(Q[i,hh,·], K[j,kvh,·]) * scale */\n"
    buf = buf + "        for (int64_t j = 0; j < L; j++) {\n"
    buf = buf + "            double dot = 0.0;\n"
    buf = buf + "            for (int64_t c = 0; c < hd; c++) {\n"
    buf = buf + "                dot = __dadd_rn(dot,\n"
    buf = buf + "                                __dmul_rn(Q[(i*nh + hh)*hd + c],\n"
    buf = buf + "                                          K[(j*nkv + kvh)*hd + c]));\n"
    buf = buf + "            }\n"
    buf = buf + "            P[(hh*T + i)*T + j] = __dmul_rn(dot, scale);\n"
    buf = buf + "        }\n"
    buf = buf + "        /* Step 2: max */\n"
    buf = buf + "        double mx = P[(hh*T + i)*T + 0];\n"
    buf = buf + "        for (int64_t j = 1; j < L; j++) {\n"
    buf = buf + "            double v = P[(hh*T + i)*T + j];\n"
    buf = buf + "            if (v > mx) mx = v;\n"
    buf = buf + "        }\n"
    buf = buf + "        /* Step 3: e = dt_exp(P − mx); P := e; tot += e. */\n"
    buf = buf + "        double tot = 0.0;\n"
    buf = buf + "        for (int64_t j = 0; j < L; j++) {\n"
    buf = buf + "            double e = _hx_cuda_dt_exp_d(P[(hh*T + i)*T + j] - mx);\n"
    buf = buf + "            P[(hh*T + i)*T + j] = e;\n"
    buf = buf + "            tot = __dadd_rn(tot, e);\n"
    buf = buf + "        }\n"
    buf = buf + "        /* Step 4: normalize */\n"
    buf = buf + "        for (int64_t j = 0; j < L; j++) {\n"
    buf = buf + "            P[(hh*T + i)*T + j] = __ddiv_rn(P[(hh*T + i)*T + j], tot);\n"
    buf = buf + "        }\n"
    buf = buf + "        /* Step 5: ctx[i,hh,c2] = Σ P[hh,i,j] · V[j,kvh,c2] */\n"
    buf = buf + "        for (int64_t c2 = 0; c2 < hd; c2++) {\n"
    buf = buf + "            double acc = 0.0;\n"
    buf = buf + "            for (int64_t j = 0; j < L; j++) {\n"
    buf = buf + "                acc = __dadd_rn(acc,\n"
    buf = buf + "                                __dmul_rn(P[(hh*T + i)*T + j],\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "                                          V[(j*nkv + kvh)*hd + c2]));\n"
    buf = buf + "            }\n"
    buf = buf + "            CTX[i*d + hh*hd + c2] = acc;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* mk2-C4-bwd (2026-05-19): GQA attention-dt bwd. Three kernels with\n"
    buf = buf + " * a shared scratch buffer (dP_row[nh·T·T], allocated by the host\n"
    buf = buf + " * wrapper).\n"
    buf = buf + " *   Step 1 (dProw kernel) — per (hh,i,j): dP_row[hh,i,j] = Σ_c\n"
    buf = buf + " *     dctx[i,hh,c]·V[j,kvh,c], j < L only.\n"
    buf = buf + " *   Step 2 (dS+dQ kernel) — per (hh,i): sdot=Σ_j P·dP_row; then for\n"
    buf = buf + " *     j<L overwrite dP_row[hh,i,j] := P·(dP_row[hh,i,j]-sdot)·scale\n"
    buf = buf + " *     (this IS dS); then dQ[i,hh,c2] = Σ_j dS·K[j,kvh,c2]. Each\n"
    buf = buf + " *     thread owns its dQ[(i*nh+hh)*hd + c2] cell — no race.\n"
    buf = buf + " *   Step 3a (dV kernel) — per (j,kvh,c): dV[j,kvh,c] = Σ_{hh in\n"
    buf = buf + " *     group, i ≥ j} P[hh,i,j]·dctx[i,hh,c]. Output-centric strict\n"
    buf = buf + " *     sequential = byte-eq with CPU canonical (hh,i) order.\n"
    buf = buf + " *   Step 3b (dK kernel) — per (j,kvh,c): dK[j,kvh,c] = Σ_{hh in\n"
    buf = buf + " *     group, i ≥ j} dS[hh,i,j]·Q[i,hh,c]. (dS lives in dP_row\n"
    buf = buf + " *     scratch after step 2.)\n"
    buf = buf + " * dQ/dK/dV are assumed FRESH t_zeros at the call site (the tape\n"
    buf = buf + " * replay site allocates them inline). */\n"
    buf = buf + "__global__ void _hx_cuda_kern_attn_dt_bwd_dProw(\n"
    buf = buf + "    const double* __restrict__ V,\n"
    buf = buf + "    const double* __restrict__ dctx,\n"
    buf = buf + "    double* __restrict__ dProw,\n"
    buf = buf + "    int64_t T, int64_t nh, int64_t nkv, int64_t hd) {\n"
    buf = buf + "    int64_t flat   = (int64_t)blockIdx.x * (int64_t)blockDim.x + (int64_t)threadIdx.x;\n"
    buf = buf + "    int64_t total  = nh * T * T;\n"
    buf = buf + "    int64_t stride = (int64_t)gridDim.x  * (int64_t)blockDim.x;\n"
    buf = buf + "    int64_t n_rep  = nh / nkv;\n"
    buf = buf + "    int64_t d      = nh * hd;\n"
    buf = buf + "    for (; flat < total; flat += stride) {\n"
    buf = buf + "        int64_t hh = flat / (T * T);\n"
    buf = buf + "        int64_t r  = flat - hh * T * T;\n"
    buf = buf + "        int64_t i  = r / T;\n"
    buf = buf + "        int64_t j  = r - i * T;\n"
    buf = buf + "        if (j > i) { dProw[flat] = 0.0; continue; }\n"
    buf = buf + "        int64_t kvh = hh / n_rep;\n"
    buf = buf + "        double acc = 0.0;\n"
    buf = buf + "        for (int64_t c = 0; c < hd; c++) {\n"
    buf = buf + "            acc = __dadd_rn(acc,\n"
    buf = buf + "                            __dmul_rn(dctx[i*d + hh*hd + c],\n"
    buf = buf + "                                      V[(j*nkv + kvh)*hd + c]));\n"
    buf = buf + "        }\n"
    buf = buf + "        dProw[flat] = acc;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "\n"
    buf = buf + "__global__ void _hx_cuda_kern_attn_dt_bwd_dS_dQ(\n"
    buf = buf + "    const double* __restrict__ Q,\n"
    buf = buf + "    const double* __restrict__ K,\n"
    buf = buf + "    const double* __restrict__ P,\n"
    buf = buf + "    double* __restrict__ dProw,    /* in: dP_row, out: dS (same buffer) */\n"
    buf = buf + "    double* __restrict__ dQ,\n"
    buf = buf + "    int64_t T, int64_t nh, int64_t nkv, int64_t hd) {\n"
    buf = buf + "    int64_t flat   = (int64_t)blockIdx.x * (int64_t)blockDim.x + (int64_t)threadIdx.x;\n"
    buf = buf + "    int64_t total  = nh * T;\n"
    buf = buf + "    int64_t stride = (int64_t)gridDim.x  * (int64_t)blockDim.x;\n"
    buf = buf + "    int64_t n_rep  = nh / nkv;\n"
    buf = buf + "    /* Compute scale device-side (no cross-TU call to host static\n"
    buf = buf + "     * `_hx_dt_sqrt_d`). 25 Newton iters × per-thread ≈ 300K ops total\n"
    buf = buf + "     * at d768·12L — negligible. */\n"
    buf = buf + "    double scale = __ddiv_rn(1.0, _hx_cuda_dt_sqrt_d((double)hd));\n"
    buf = buf + "    for (; flat < total; flat += stride) {\n"
    buf = buf + "        int64_t hh = flat / T;\n"
    buf = buf + "        int64_t i  = flat - hh * T;\n"
    buf = buf + "        int64_t kvh = hh / n_rep;\n"
    buf = buf + "        int64_t L = i + 1;\n"
    buf = buf + "        /* sdot = Σ_j P[hh,i,j] · dP_row[hh,i,j], j∈[0,L) */\n"
    buf = buf + "        double sdot = 0.0;\n"
    buf = buf + "        for (int64_t j = 0; j < L; j++) {\n"
    buf = buf + "            sdot = __dadd_rn(sdot,\n"
    buf = buf + "                             __dmul_rn(P[(hh*T + i)*T + j],\n"
    buf = buf + "                                       dProw[(hh*T + i)*T + j]));\n"
    buf = buf + "        }\n"
    buf = buf + "        /* in-place: dProw[hh,i,j] := P · (dProw - sdot) · scale = dS */\n"
    buf = buf + "        for (int64_t j = 0; j < L; j++) {\n"
    buf = buf + "            double v = dProw[(hh*T + i)*T + j] - sdot;\n"
    buf = buf + "            dProw[(hh*T + i)*T + j] = __dmul_rn(\n"
    buf = buf + "                __dmul_rn(P[(hh*T + i)*T + j], v), scale);\n"
    buf = buf + "        }\n"
    buf = buf + "        /* dQ[i,hh,c2] = Σ_j dS[hh,i,j] · K[j,kvh,c2]\n"
    buf = buf + "         * CPU canonical: outer j, inner c2 — accumulator per c2.\n"
    buf = buf + "         * Reproduce: keep separate dQ acc per c2 (registers), j outer. */\n"
    buf = buf + "        /* For each c2 ∈ [0..hd), the strict j-ascending fold matches\n"
    buf = buf + "         * CPU exactly. (kvh constant for this thread.) */\n"
    buf = buf + "        for (int64_t c2 = 0; c2 < hd; c2++) {\n"
    buf = buf + "            double acc = 0.0;\n"
    buf = buf + "            for (int64_t j = 0; j < L; j++) {\n"
    buf = buf + "                acc = __dadd_rn(acc,\n"
    buf = buf + "                                __dmul_rn(dProw[(hh*T + i)*T + j],\n"
    buf = buf + "                                          K[(j*nkv + kvh)*hd + c2]));\n"
    buf = buf + "            }\n"
    buf = buf + "            dQ[(i*nh + hh)*hd + c2] = acc;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "\n"
    buf = buf + "__global__ void _hx_cuda_kern_attn_dt_bwd_dV(\n"
    buf = buf + "    const double* __restrict__ P,\n"
    buf = buf + "    const double* __restrict__ dctx,\n"
    buf = buf + "    double* __restrict__ dV,\n"
    buf = buf + "    int64_t T, int64_t nh, int64_t nkv, int64_t hd) {\n"
    buf = buf + "    int64_t flat   = (int64_t)blockIdx.x * (int64_t)blockDim.x + (int64_t)threadIdx.x;\n"
    buf = buf + "    int64_t total  = T * nkv * hd;\n"
    buf = buf + "    int64_t stride = (int64_t)gridDim.x  * (int64_t)blockDim.x;\n"
    buf = buf + "    int64_t n_rep  = nh / nkv;\n"
    buf = buf + "    int64_t d      = nh * hd;\n"
    buf = buf + "    for (; flat < total; flat += stride) {\n"
    buf = buf + "        int64_t j   = flat / (nkv * hd);\n"
    buf = buf + "        int64_t r   = flat - j * (nkv * hd);\n"
    buf = buf + "        int64_t kvh = r / hd;\n"
    buf = buf + "        int64_t c   = r - kvh * hd;\n"
    buf = buf + "        int64_t hh0 = kvh * n_rep;\n"
    buf = buf + "        double acc = 0.0;\n"
    buf = buf + "        /* CPU canonical order: hh ascending, then i ascending (i ≥ j) */\n"
    buf = buf + "        for (int64_t hh = hh0; hh < hh0 + n_rep; hh++) {\n"
    buf = buf + "            for (int64_t i = j; i < T; i++) {\n"
    buf = buf + "                acc = __dadd_rn(acc,\n"
    buf = buf + "                                __dmul_rn(P[(hh*T + i)*T + j],\n"
    buf = buf + "                                          dctx[i*d + hh*hd + c]));\n"
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "        dV[(j*nkv + kvh)*hd + c] = acc;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "__global__ void _hx_cuda_kern_attn_dt_bwd_dK(\n"
    buf = buf + "    const double* __restrict__ Q,\n"
    buf = buf + "    const double* __restrict__ dS,    /* same buffer as dProw after step 2 */\n"
    buf = buf + "    double* __restrict__ dK,\n"
    buf = buf + "    int64_t T, int64_t nh, int64_t nkv, int64_t hd) {\n"
    buf = buf + "    int64_t flat   = (int64_t)blockIdx.x * (int64_t)blockDim.x + (int64_t)threadIdx.x;\n"
    buf = buf + "    int64_t total  = T * nkv * hd;\n"
    buf = buf + "    int64_t stride = (int64_t)gridDim.x  * (int64_t)blockDim.x;\n"
    buf = buf + "    int64_t n_rep  = nh / nkv;\n"
    buf = buf + "    for (; flat < total; flat += stride) {\n"
    buf = buf + "        int64_t j   = flat / (nkv * hd);\n"
    buf = buf + "        int64_t r   = flat - j * (nkv * hd);\n"
    buf = buf + "        int64_t kvh = r / hd;\n"
    buf = buf + "        int64_t c   = r - kvh * hd;\n"
    buf = buf + "        int64_t hh0 = kvh * n_rep;\n"
    buf = buf + "        double acc = 0.0;\n"
    buf = buf + "        for (int64_t hh = hh0; hh < hh0 + n_rep; hh++) {\n"
    buf = buf + "            for (int64_t i = j; i < T; i++) {\n"
    buf = buf + "                acc = __dadd_rn(acc,\n"
    buf = buf + "                                __dmul_rn(dS[(hh*T + i)*T + j],\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "                                          Q[(i*nh + hh)*hd + c]));\n"
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "        dK[(j*nkv + kvh)*hd + c] = acc;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* silu-gate: O[i] = (A[i]·σ(A[i]))·B[i], σ=1/(1+dt_exp(-x)).\n"
    buf = buf + " * dt_exp-faithful (NOT _hx_cuda_sigmoid_d's libm exp). Op order\n"
    buf = buf + " * byte-identical to CPU _hx_farr_silu_gate_cpu / ag_tape\n"
    buf = buf + " * _ag_silu(a)*b. */\n"
    buf = buf + "__global__ void _hx_cuda_kern_silu_gate(const double* __restrict__ A,\n"
    buf = buf + "                                        const double* __restrict__ B,\n"
    buf = buf + "                                        double* __restrict__ O,\n"
    buf = buf + "                                        int64_t n) {\n"
    buf = buf + "    int64_t i      = (int64_t)blockIdx.x * (int64_t)blockDim.x + (int64_t)threadIdx.x;\n"
    buf = buf + "    int64_t stride = (int64_t)gridDim.x  * (int64_t)blockDim.x;\n"
    buf = buf + "    for (; i < n; i += stride) {\n"
    buf = buf + "        double ai  = A[i];\n"
    buf = buf + "        double sig = 1.0 / (1.0 + _hx_cuda_dt_exp_d(0.0 - ai));\n"
    buf = buf + "        O[i] = __dmul_rn(__dmul_rn(ai, sig), B[i]);\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "\n"
    buf = buf + "/* ── mk2-C5 GPU kernels restored from e030fa31 (rfc043-flame-camp) ──\n"
    buf = buf + " * The A/B/C three-way merge dropped Cycle A's runtime_cuda.c additions;\n"
    buf = buf + " * these 9 device kernels are the GPU side of the HEXA_CUDA seam in\n"
    buf = buf + " * self/runtime.c (silu_gate/rmsnorm_mh/attn_dt_fwd+bwd/copy_slice/\n"
    buf = buf + " * fill_dt_lcg/add_inplace/zero_slice/transpose_2d). byte-eq oracle-\n"
    buf = buf + " * gated vs the _hx_farr_*_cpu mirrors. */\n"
    buf = buf + "/* mk2-C1b: silu-gate O = (A·σ(A))·B (dt_exp-faithful). Two host\n"
    buf = buf + " * inputs H2D'd; byte-eq oracle-gated vs CPU _hx_farr_silu_gate_cpu. */\n"
    buf = buf + "int _hx_cuda_farr_silu_gate_gpu(int64_t a_id, int64_t b_id,\n"
    buf = buf + "                                int64_t n, int64_t out_id) {\n"
    buf = buf + "    if (a_id < 0 || b_id < 0 || out_id < 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] silu_gate: bad ids %lld %lld %lld\\n\",\n"
    buf = buf + "                (long long)a_id, (long long)b_id, (long long)out_id);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (n <= 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] silu_gate: bad n=%lld\\n\", (long long)n);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (a_id >= _hx_farr_count || b_id >= _hx_farr_count ||\n"
    buf = buf + "        out_id >= _hx_farr_count) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] silu_gate: id out of range\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_hx_farr_table[a_id].len < n || _hx_farr_table[b_id].len < n ||\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "        _hx_farr_table[out_id].len < n) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] silu_gate: host len < n\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_h2d(a_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(b_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_buf(out_id, n) != 0) return -1;\n"
    buf = buf + "    double* A = g_slots[a_id].d_buf;\n"
    buf = buf + "    double* B = g_slots[b_id].d_buf;\n"
    buf = buf + "    double* O = g_slots[out_id].d_buf;\n"
    buf = buf + "    int grid = _hx_cuda_elem_grid(n);\n"
    buf = buf + "    _hx_cuda_kern_silu_gate<<<grid, _HX_CUDA_ELEM_BLOCK, 0, _forge_stream()>>>(A, B, O, n);\n"
    buf = buf + "    if (_forge_launch_check(\"silu_gate\") != 0) return -1;\n"
    buf = buf + "    if (_d2h_out(out_id, n) != 0) return -1;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* mk2-C2 (2026-05-19): rmsnorm-mh fwd forge-route. fwd kernel above\n"
    buf = buf + " * computes y[T·d], xn[T·d], inv[T] in one launch (one thread per row,\n"
    buf = buf + " * sequential reduction for byte-eq). All three outputs go through\n"
    buf = buf + " * _d2h_out → DEVICE_KEEP register honoured (mk2-C3) so the next forge\n"
    buf = buf + " * op's _h2d sees them via the §6.1 skip path. Replaces the host-scalar\n"
    buf = buf + " * t_get/t_set loop in ag_tape.hexa::ag_rmsnorm_mh, byte-eq oracle-\n"
    buf = buf + " * gated vs CPU _hx_farr_rmsnorm_mh_cpu (FP_CONTRACT OFF, dt_sqrt-\n"
    buf = buf + " * faithful). */\n"
    buf = buf + "int _hx_cuda_farr_rmsnorm_mh_gpu(int64_t x_id, int64_t g_id,\n"
    buf = buf + "                                 int64_t y_id, int64_t xn_id,\n"
    buf = buf + "                                 int64_t inv_id, int64_t T, int64_t d) {\n"
    buf = buf + "    if (x_id < 0 || g_id < 0 || y_id < 0 || xn_id < 0 || inv_id < 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] rmsnorm_mh: bad ids\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (T <= 0 || d <= 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] rmsnorm_mh: bad T=%lld d=%lld\\n\",\n"
    buf = buf + "                (long long)T, (long long)d);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (x_id >= _hx_farr_count || g_id >= _hx_farr_count ||\n"
    buf = buf + "        y_id >= _hx_farr_count || xn_id >= _hx_farr_count ||\n"
    buf = buf + "        inv_id >= _hx_farr_count) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] rmsnorm_mh: id out of range\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    int64_t n_xy = T * d;\n"
    buf = buf + "    if (_hx_farr_table[x_id].len  < n_xy || _hx_farr_table[g_id].len  < d ||\n"
    buf = buf + "        _hx_farr_table[y_id].len  < n_xy || _hx_farr_table[xn_id].len < n_xy ||\n"
    buf = buf + "        _hx_farr_table[inv_id].len < T) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] rmsnorm_mh: host len mismatch\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    if (_h2d(x_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(g_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_buf(y_id,   n_xy) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_buf(xn_id,  n_xy) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_buf(inv_id, T)    != 0) return -1;\n"
    buf = buf + "    double* X = g_slots[x_id].d_buf;\n"
    buf = buf + "    double* G = g_slots[g_id].d_buf;\n"
    buf = buf + "    double* Y = g_slots[y_id].d_buf;\n"
    buf = buf + "    double* XN= g_slots[xn_id].d_buf;\n"
    buf = buf + "    double* I = g_slots[inv_id].d_buf;\n"
    buf = buf + "    /* one thread per row; T parallel. Cap grid at 65535 (legacy CUDA\n"
    buf = buf + "     * 1-D grid ceiling we already use elsewhere). */\n"
    buf = buf + "    int block = 256;\n"
    buf = buf + "    int64_t need = (T + block - 1) / block;\n"
    buf = buf + "    int grid = (int)(need < 1 ? 1 : (need > 65535 ? 65535 : need));\n"
    buf = buf + "    _hx_cuda_kern_rmsnorm_mh<<<grid, block, 0, _forge_stream()>>>(X, G, Y, XN, I, T, d);\n"
    buf = buf + "    if (_forge_launch_check(\"rmsnorm_mh\") != 0) return -1;\n"
    buf = buf + "    if (_d2h_out(y_id,   n_xy) != 0) return -1;\n"
    buf = buf + "    if (_d2h_out(xn_id,  n_xy) != 0) return -1;\n"
    buf = buf + "    if (_d2h_out(inv_id, T)    != 0) return -1;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* mk2-C4 (2026-05-19): GQA attention-dt fwd forge-route. One kernel\n"
    buf = buf + " * launch computes P[nh·T·T] (causal probs, j<L only) and CTX[T·nh·hd]\n"
    buf = buf + " * from Q/K/V. dt_sqrt + dt_exp mirrors guarantee byte-eq with the host\n"
    buf = buf + " * loop. Outputs honour DEVICE_KEEP via _d2h_out. */\n"
    buf = buf + "int _hx_cuda_farr_attn_dt_fwd_gpu(int64_t q_id, int64_t k_id, int64_t v_id,\n"
    buf = buf + "                                  int64_t p_id, int64_t ctx_id,\n"
    buf = buf + "                                  int64_t T, int64_t nh, int64_t nkv,\n"
    buf = buf + "                                  int64_t hd) {\n"
    buf = buf + "    if (q_id < 0 || k_id < 0 || v_id < 0 || p_id < 0 || ctx_id < 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] attn_dt_fwd: bad ids\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (T <= 0 || nh <= 0 || nkv <= 0 || hd <= 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] attn_dt_fwd: bad dims T=%lld nh=%lld nkv=%lld hd=%lld\\n\",\n"
    buf = buf + "                (long long)T, (long long)nh, (long long)nkv, (long long)hd);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (nh % nkv != 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] attn_dt_fwd: nh=%lld not divisible by nkv=%lld\\n\",\n"
    buf = buf + "                (long long)nh, (long long)nkv);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (q_id >= _hx_farr_count || k_id >= _hx_farr_count ||\n"
    buf = buf + "        v_id >= _hx_farr_count || p_id >= _hx_farr_count ||\n"
    buf = buf + "        ctx_id >= _hx_farr_count) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] attn_dt_fwd: id out of range\\n\");\n"
    buf = buf + "        return -1;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    }\n"
    buf = buf + "    int64_t nq = T * nh  * hd;\n"
    buf = buf + "    int64_t nk = T * nkv * hd;\n"
    buf = buf + "    int64_t np = nh * T * T;\n"
    buf = buf + "    if (_hx_farr_table[q_id].len   < nq ||\n"
    buf = buf + "        _hx_farr_table[k_id].len   < nk ||\n"
    buf = buf + "        _hx_farr_table[v_id].len   < nk ||\n"
    buf = buf + "        _hx_farr_table[p_id].len   < np ||\n"
    buf = buf + "        _hx_farr_table[ctx_id].len < nq) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] attn_dt_fwd: host len mismatch\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_h2d(q_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(k_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(v_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_buf(p_id,   np) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_buf(ctx_id, nq) != 0) return -1;\n"
    buf = buf + "    /* Zero P first — only j < L positions are written, the upper\n"
    buf = buf + "     * triangle (j ≥ L per row) must stay 0 to match the t_zeros init\n"
    buf = buf + "     * on the host side. cudaMemset is fine (P is doubles; 0x00·8 == 0.0). */\n"
    buf = buf + "    cudaError_t ze = cudaMemsetAsync(g_slots[p_id].d_buf, 0,\n"
    buf = buf + "                                (size_t)np * sizeof(double), _forge_stream());\n"
    buf = buf + "    if (ze != cudaSuccess) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] attn_dt_fwd: cudaMemset P failed: %s\\n\",\n"
    buf = buf + "                cudaGetErrorString(ze));\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    double* Q = g_slots[q_id].d_buf;\n"
    buf = buf + "    double* K = g_slots[k_id].d_buf;\n"
    buf = buf + "    double* V = g_slots[v_id].d_buf;\n"
    buf = buf + "    double* P = g_slots[p_id].d_buf;\n"
    buf = buf + "    double* C = g_slots[ctx_id].d_buf;\n"
    buf = buf + "    /* one thread per (hh, i) — nh·T threads. */\n"
    buf = buf + "    int64_t total = nh * T;\n"
    buf = buf + "    int block = 64;\n"
    buf = buf + "    int64_t need = (total + block - 1) / block;\n"
    buf = buf + "    int grid = (int)(need < 1 ? 1 : (need > 65535 ? 65535 : need));\n"
    buf = buf + "    _hx_cuda_kern_attn_dt_fwd<<<grid, block, 0, _forge_stream()>>>(Q, K, V, P, C, T, nh, nkv, hd);\n"
    buf = buf + "    if (_forge_launch_check(\"attn_dt_fwd\") != 0) return -1;\n"
    buf = buf + "    if (_d2h_out(p_id,   np) != 0) return -1;\n"
    buf = buf + "    if (_d2h_out(ctx_id, nq) != 0) return -1;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ────────────────────────────────────────────────────────────────────\n"
    buf = buf + " * P1a — layernorm_rows (device-resident decode): mirrors host\n"
    buf = buf + " *   _bg_layernorm (anima bytegpt_decode.hexa): per row r,\n"
    buf = buf + " *     mean = mean_j X[r,j];  var = mean_j (X[r,j]-mean)^2  (population);\n"
    buf = buf + " *     inv  = 1 / dt_sqrt(var + eps);\n"
    buf = buf + " *     Y[r,j] = G[j]*(X[r,j]-mean)*inv + B[j].\n"
    buf = buf + " *   dt_sqrt (NOT libm sqrt) = host parity; non-contracted __d*_rn ops\n"
    buf = buf + " *   (no FMA fusion) = host per-op parity. One block per row, two block\n"
    buf = buf + " *   reductions (mean, then var). NOTE: the block tree-reduction sums in\n"
    buf = buf + " *   a different order than the host serial loop, so this is argmax-eq\n"
    buf = buf + " *   (~1e-16), not bit-eq, to host LN (owner-accepted for the decode gate).\n"
    buf = buf + " * ──────────────────────────────────────────────────────────────────── */\n"
    buf = buf + "__global__ void _hx_k_layernorm_rows(const double* __restrict__ X,\n"
    buf = buf + "                                     const double* __restrict__ G,\n"
    buf = buf + "                                     const double* __restrict__ B,\n"
    buf = buf + "                                     double* __restrict__ Y,\n"
    buf = buf + "                                     int64_t R, int64_t C, double eps) {\n"
    buf = buf + "    int64_t r = blockIdx.x;\n"
    buf = buf + "    if (r >= R) return;\n"
    buf = buf + "    const double* xr = X + r * C;\n"
    buf = buf + "    double*       yr = Y + r * C;\n"
    buf = buf + "    __shared__ double smem[HX_RR_BLOCK / 32];\n"
    buf = buf + "    /* pass 1 — mean */\n"
    buf = buf + "    double s = 0.0;\n"
    buf = buf + "    for (int64_t j = threadIdx.x; j < C; j += blockDim.x) s = __dadd_rn(s, xr[j]);\n"
    buf = buf + "    double mean = __ddiv_rn(_hx_block_sum(s, smem), (double)C);\n"
    buf = buf + "    __syncthreads();  /* guard smem[0] before reusing _hx_block_sum */\n"
    buf = buf + "    /* pass 2 — population variance about mean (host two-pass formula) */\n"
    buf = buf + "    double v = 0.0;\n"
    buf = buf + "    for (int64_t j = threadIdx.x; j < C; j += blockDim.x) {\n"
    buf = buf + "        double d = __dadd_rn(xr[j], -mean);\n"
    buf = buf + "        v = __dadd_rn(v, __dmul_rn(d, d));\n"
    buf = buf + "    }\n"
    buf = buf + "    double var = __ddiv_rn(_hx_block_sum(v, smem), (double)C);\n"
    buf = buf + "    double inv = __ddiv_rn(1.0, _hx_cuda_dt_sqrt_d(__dadd_rn(var, eps)));\n"
    buf = buf + "    /* affine */\n"
    buf = buf + "    for (int64_t j = threadIdx.x; j < C; j += blockDim.x) {\n"
    buf = buf + "        double xn = __dmul_rn(__dadd_rn(xr[j], -mean), inv);\n"
    buf = buf + "        yr[j] = __dadd_rn(__dmul_rn(G[j], xn), B[j]);\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* Host launcher for _hx_k_layernorm_rows — DEVICE-RESIDENT (keeps OUT\n"
    buf = buf + " * FARR_DEVICE, no d2h; clone of the gelu resident wrapper). H2D-pins X,\n"
    buf = buf + " * G, B; one block per row on _forge_stream(). */\n"
    buf = buf + "int _hx_cuda_farr_layernorm_rows_gpu(int64_t x_id, int64_t g_id, int64_t b_id,\n"
    buf = buf + "                                     int64_t out_id, int64_t R, int64_t C,\n"
    buf = buf + "                                     double eps) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (R <= 0 || C <= 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] layernorm_rows: bad shape R=%lld C=%lld\\n\",\n"
    buf = buf + "                (long long)R, (long long)C);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (!(eps >= 0.0)) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] layernorm_rows: bad eps %g\\n\", eps);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_h2d(x_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(g_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(b_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(out_id, R * C) != 0) return -1;\n"
    buf = buf + "    const double* X = g_slots[x_id].d_buf;\n"
    buf = buf + "    const double* G = g_slots[g_id].d_buf;\n"
    buf = buf + "    const double* B = g_slots[b_id].d_buf;\n"
    buf = buf + "    double*       Y = g_slots[out_id].d_buf;\n"
    buf = buf + "    _hx_k_layernorm_rows<<<(unsigned)R, HX_RR_BLOCK, 0, _forge_stream()>>>(\n"
    buf = buf + "        X, G, B, Y, R, C, eps);\n"
    buf = buf + "    if (_forge_launch_check(\"layernorm_rows\") != 0) return -1;\n"
    buf = buf + "    {\n"
    buf = buf + "        HexaFarrEntry* e = &_hx_farr_table[out_id];\n"
    buf = buf + "        e->d_buf      = (void*)g_slots[out_id].d_buf;\n"
    buf = buf + "        e->loc        = FARR_DEVICE;\n"
    buf = buf + "        e->dirty_host = 0;\n"
    buf = buf + "        e->dirty_dev  = 0;\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)x_id; (void)g_id; (void)b_id; (void)out_id;\n"
    buf = buf + "    (void)R; (void)C; (void)eps;\n"
    buf = buf + "    fprintf(stderr, \"[cuda] layernorm_rows: built without __CUDACC__\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "/* P2 device-resident decode (2026-07-01): single-query KV-cache decode\n"
    buf = buf + " * attention. Mirrors _hx_cuda_kern_attn_dt_fwd's per-(hh,i) body\n"
    buf = buf + " * (dt_sqrt scale + dt_exp softmax, normalize-first, non-contracted\n"
    buf = buf + " * __d*_rn) but with ONE query row q[nh*hd] attending over Lrows cached\n"
    buf = buf + " * K/V rows (L = Lrows, NOT i+1) → the decode ctx equals the full-forward\n"
    buf = buf + " * last row byte-for-byte. GQA kvh = hh/n_rep (nkv=nh no-GQA in bytegpt).\n"
    buf = buf + " * S[nh*Lrows] = per-head score scratch (every element written). */\n"
    buf = buf + "__global__ void _hx_cuda_kern_attn_dt_decode(const double* __restrict__ Q,\n"
    buf = buf + "                                             const double* __restrict__ K,\n"
    buf = buf + "                                             const double* __restrict__ V,\n"
    buf = buf + "                                             double* __restrict__ S,\n"
    buf = buf + "                                             double* __restrict__ CTX,\n"
    buf = buf + "                                             int64_t Lrows, int64_t nh,\n"
    buf = buf + "                                             int64_t nkv, int64_t hd) {\n"
    buf = buf + "    int64_t flat   = (int64_t)blockIdx.x * (int64_t)blockDim.x + (int64_t)threadIdx.x;\n"
    buf = buf + "    int64_t stride = (int64_t)gridDim.x  * (int64_t)blockDim.x;\n"
    buf = buf + "    int64_t n_rep  = nh / nkv;\n"
    buf = buf + "    double scale = __ddiv_rn(1.0, _hx_cuda_dt_sqrt_d((double)hd));\n"
    buf = buf + "    for (; flat < nh; flat += stride) {\n"
    buf = buf + "        int64_t hh  = flat;\n"
    buf = buf + "        int64_t kvh = hh / n_rep;\n"
    buf = buf + "        /* Step 1: S[hh,j] = dot(q[hh,.], K[j,kvh,.]) * scale, j<Lrows */\n"
    buf = buf + "        for (int64_t j = 0; j < Lrows; j++) {\n"
    buf = buf + "            double dot = 0.0;\n"
    buf = buf + "            for (int64_t c = 0; c < hd; c++) {\n"
    buf = buf + "                dot = __dadd_rn(dot,\n"
    buf = buf + "                                __dmul_rn(Q[hh*hd + c],\n"
    buf = buf + "                                          K[(j*nkv + kvh)*hd + c]));\n"
    buf = buf + "            }\n"
    buf = buf + "            S[hh*Lrows + j] = __dmul_rn(dot, scale);\n"
    buf = buf + "        }\n"
    buf = buf + "        /* Step 2: max */\n"
    buf = buf + "        double mx = S[hh*Lrows + 0];\n"
    buf = buf + "        for (int64_t j = 1; j < Lrows; j++) {\n"
    buf = buf + "            double v = S[hh*Lrows + j];\n"
    buf = buf + "            if (v > mx) mx = v;\n"
    buf = buf + "        }\n"
    buf = buf + "        /* Step 3: e = dt_exp(S - mx); S := e; tot += e. */\n"
    buf = buf + "        double tot = 0.0;\n"
    buf = buf + "        for (int64_t j = 0; j < Lrows; j++) {\n"
    buf = buf + "            double e = _hx_cuda_dt_exp_d(S[hh*Lrows + j] - mx);\n"
    buf = buf + "            S[hh*Lrows + j] = e;\n"
    buf = buf + "            tot = __dadd_rn(tot, e);\n"
    buf = buf + "        }\n"
    buf = buf + "        /* Step 4: normalize */\n"
    buf = buf + "        for (int64_t j = 0; j < Lrows; j++) {\n"
    buf = buf + "            S[hh*Lrows + j] = __ddiv_rn(S[hh*Lrows + j], tot);\n"
    buf = buf + "        }\n"
    buf = buf + "        /* Step 5: ctx[hh,c2] = sum_j S[hh,j] * V[j,kvh,c2] */\n"
    buf = buf + "        for (int64_t c2 = 0; c2 < hd; c2++) {\n"
    buf = buf + "            double acc = 0.0;\n"
    buf = buf + "            for (int64_t j = 0; j < Lrows; j++) {\n"
    buf = buf + "                acc = __dadd_rn(acc,\n"
    buf = buf + "                                __dmul_rn(S[hh*Lrows + j],\n"
    buf = buf + "                                          V[(j*nkv + kvh)*hd + c2]));\n"
    buf = buf + "            }\n"
    buf = buf + "            CTX[hh*hd + c2] = acc;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* P2 (2026-07-01): single-query KV-decode forge-route. q[d]=1 query row,\n"
    buf = buf + " * K/V caches with Lrows live rows (row-major [row*d + kvh*hd + c]),\n"
    buf = buf + " * S[nh*Lrows] score scratch, CTX[d] out. Honours DEVICE_KEEP via _d2h_out. */\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "int _hx_cuda_farr_attn_dt_decode_gpu(int64_t q_id, int64_t k_id, int64_t v_id,\n"
    buf = buf + "                                     int64_t s_id, int64_t ctx_id,\n"
    buf = buf + "                                     int64_t Lrows, int64_t nh, int64_t nkv,\n"
    buf = buf + "                                     int64_t hd) {\n"
    buf = buf + "    if (q_id < 0 || k_id < 0 || v_id < 0 || s_id < 0 || ctx_id < 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] attn_dt_decode: bad ids\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (Lrows <= 0 || nh <= 0 || nkv <= 0 || hd <= 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] attn_dt_decode: bad dims Lrows=%lld nh=%lld nkv=%lld hd=%lld\\n\",\n"
    buf = buf + "                (long long)Lrows, (long long)nh, (long long)nkv, (long long)hd);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (nh % nkv != 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] attn_dt_decode: nh=%lld not divisible by nkv=%lld\\n\",\n"
    buf = buf + "                (long long)nh, (long long)nkv);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (q_id >= _hx_farr_count || k_id >= _hx_farr_count ||\n"
    buf = buf + "        v_id >= _hx_farr_count || s_id >= _hx_farr_count ||\n"
    buf = buf + "        ctx_id >= _hx_farr_count) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] attn_dt_decode: id out of range\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    int64_t nqd = nh    * hd;\n"
    buf = buf + "    int64_t nk  = Lrows * nkv * hd;\n"
    buf = buf + "    int64_t ns  = nh    * Lrows;\n"
    buf = buf + "    if (_hx_farr_table[q_id].len   < nqd ||\n"
    buf = buf + "        _hx_farr_table[k_id].len   < nk  ||\n"
    buf = buf + "        _hx_farr_table[v_id].len   < nk  ||\n"
    buf = buf + "        _hx_farr_table[s_id].len   < ns  ||\n"
    buf = buf + "        _hx_farr_table[ctx_id].len < nqd) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] attn_dt_decode: host len mismatch\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_h2d(q_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(k_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(v_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_buf(s_id,   ns)  != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_buf(ctx_id, nqd) != 0) return -1;\n"
    buf = buf + "    double* Q = g_slots[q_id].d_buf;\n"
    buf = buf + "    double* K = g_slots[k_id].d_buf;\n"
    buf = buf + "    double* V = g_slots[v_id].d_buf;\n"
    buf = buf + "    double* S = g_slots[s_id].d_buf;\n"
    buf = buf + "    double* C = g_slots[ctx_id].d_buf;\n"
    buf = buf + "    /* one thread per head — nh threads. */\n"
    buf = buf + "    int block = 64;\n"
    buf = buf + "    int64_t need = (nh + block - 1) / block;\n"
    buf = buf + "    int grid = (int)(need < 1 ? 1 : (need > 65535 ? 65535 : need));\n"
    buf = buf + "    _hx_cuda_kern_attn_dt_decode<<<grid, block, 0, _forge_stream()>>>(Q, K, V, S, C, Lrows, nh, nkv, hd);\n"
    buf = buf + "    if (_forge_launch_check(\"attn_dt_decode\") != 0) return -1;\n"
    buf = buf + "    if (_d2h_out(ctx_id, nqd) != 0) return -1;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* lever3 batched decode (2026-07-02, #21 P2 launch-bound amortizer):\n"
    buf = buf + " * N INDEPENDENT single-query KV-decode attentions in ONE launch. Grid-\n"
    buf = buf + " * strides over flat in [0, N*nh): n = flat/nh (sequence), hh = flat%nh\n"
    buf = buf + " * (head). Per-seq bases with a FIXED cap row-stride so a fixed-stride KV\n"
    buf = buf + " * cache slabs straight in: Q[n*nh*hd], K/V[n*cap*nkv*hd], S[n*nh*Lrows],\n"
    buf = buf + " * CTX[n*nh*hd]. The per-(n,hh) body is BYTE-IDENTICAL to\n"
    buf = buf + " * _hx_cuda_kern_attn_dt_decode on that sequence alone (same dt_sqrt\n"
    buf = buf + " * scale, __d*_rn dot, normalize-first _hx_cuda_dt_exp_d, __ddiv_rn) so\n"
    buf = buf + " * batched argmax == N sequential single decodes. v1: SCALAR uniform\n"
    buf = buf + " * Lrows (bucket equal-length seeds); ragged Lrows[] is the follow-on.\n"
    buf = buf + " * No KV-append fold (kept as caller copy_slice for v1). */\n"
    buf = buf + "__global__ void _hx_cuda_kern_attn_dt_decode_batch(const double* __restrict__ Q,\n"
    buf = buf + "                                                   const double* __restrict__ K,\n"
    buf = buf + "                                                   const double* __restrict__ V,\n"
    buf = buf + "                                                   double* __restrict__ S,\n"
    buf = buf + "                                                   double* __restrict__ CTX,\n"
    buf = buf + "                                                   int64_t N, int64_t Lrows,\n"
    buf = buf + "                                                   int64_t cap, int64_t nh,\n"
    buf = buf + "                                                   int64_t nkv, int64_t hd) {\n"
    buf = buf + "    int64_t flat   = (int64_t)blockIdx.x * (int64_t)blockDim.x + (int64_t)threadIdx.x;\n"
    buf = buf + "    int64_t stride = (int64_t)gridDim.x  * (int64_t)blockDim.x;\n"
    buf = buf + "    int64_t n_rep  = nh / nkv;\n"
    buf = buf + "    int64_t total  = N * nh;\n"
    buf = buf + "    double scale = __ddiv_rn(1.0, _hx_cuda_dt_sqrt_d((double)hd));\n"
    buf = buf + "    for (; flat < total; flat += stride) {\n"
    buf = buf + "        int64_t n   = flat / nh;\n"
    buf = buf + "        int64_t hh  = flat % nh;\n"
    buf = buf + "        int64_t kvh = hh / n_rep;\n"
    buf = buf + "        const double* Qb = Q + n * nh * hd;\n"
    buf = buf + "        const double* Kb = K + n * cap * nkv * hd;\n"
    buf = buf + "        const double* Vb = V + n * cap * nkv * hd;\n"
    buf = buf + "        double* Sb   = S + n * nh * Lrows;\n"
    buf = buf + "        double* CTXb = CTX + n * nh * hd;\n"
    buf = buf + "        /* Step 1: S[hh,j] = dot(q[hh,.], K[j,kvh,.]) * scale, j<Lrows */\n"
    buf = buf + "        for (int64_t j = 0; j < Lrows; j++) {\n"
    buf = buf + "            double dot = 0.0;\n"
    buf = buf + "            for (int64_t c = 0; c < hd; c++) {\n"
    buf = buf + "                dot = __dadd_rn(dot,\n"
    buf = buf + "                                __dmul_rn(Qb[hh*hd + c],\n"
    buf = buf + "                                          Kb[(j*nkv + kvh)*hd + c]));\n"
    buf = buf + "            }\n"
    buf = buf + "            Sb[hh*Lrows + j] = __dmul_rn(dot, scale);\n"
    buf = buf + "        }\n"
    buf = buf + "        /* Step 2: max */\n"
    buf = buf + "        double mx = Sb[hh*Lrows + 0];\n"
    buf = buf + "        for (int64_t j = 1; j < Lrows; j++) {\n"
    buf = buf + "            double v = Sb[hh*Lrows + j];\n"
    buf = buf + "            if (v > mx) mx = v;\n"
    buf = buf + "        }\n"
    buf = buf + "        /* Step 3: e = dt_exp(S - mx); S := e; tot += e. */\n"
    buf = buf + "        double tot = 0.0;\n"
    buf = buf + "        for (int64_t j = 0; j < Lrows; j++) {\n"
    buf = buf + "            double e = _hx_cuda_dt_exp_d(Sb[hh*Lrows + j] - mx);\n"
    buf = buf + "            Sb[hh*Lrows + j] = e;\n"
    buf = buf + "            tot = __dadd_rn(tot, e);\n"
    buf = buf + "        }\n"
    buf = buf + "        /* Step 4: normalize */\n"
    buf = buf + "        for (int64_t j = 0; j < Lrows; j++) {\n"
    buf = buf + "            Sb[hh*Lrows + j] = __ddiv_rn(Sb[hh*Lrows + j], tot);\n"
    buf = buf + "        }\n"
    buf = buf + "        /* Step 5: ctx[hh,c2] = sum_j S[hh,j] * V[j,kvh,c2] */\n"
    buf = buf + "        for (int64_t c2 = 0; c2 < hd; c2++) {\n"
    buf = buf + "            double acc = 0.0;\n"
    buf = buf + "            for (int64_t j = 0; j < Lrows; j++) {\n"
    buf = buf + "                acc = __dadd_rn(acc,\n"
    buf = buf + "                                __dmul_rn(Sb[hh*Lrows + j],\n"
    buf = buf + "                                          Vb[(j*nkv + kvh)*hd + c2]));\n"
    buf = buf + "            }\n"
    buf = buf + "            CTXb[hh*hd + c2] = acc;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* lever3 (2026-07-02): batched single-query KV-decode forge-route. N seqs,\n"
    buf = buf + " * each Q[nh*hd] query attending over Lrows live rows of its own cap-strided\n"
    buf = buf + " * K/V slab; S[N*nh*Lrows] score scratch, CTX[N*nh*hd] out. DEVICE_KEEP via\n"
    buf = buf + " * _d2h_out. Lrows<=cap enforced. */\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "int _hx_cuda_farr_attn_dt_decode_batch_gpu(int64_t q_id, int64_t k_id, int64_t v_id,\n"
    buf = buf + "                                           int64_t s_id, int64_t ctx_id,\n"
    buf = buf + "                                           int64_t N, int64_t Lrows, int64_t cap,\n"
    buf = buf + "                                           int64_t nh, int64_t nkv, int64_t hd) {\n"
    buf = buf + "    if (q_id < 0 || k_id < 0 || v_id < 0 || s_id < 0 || ctx_id < 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] attn_dt_decode_batch: bad ids\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (N <= 0 || Lrows <= 0 || cap <= 0 || nh <= 0 || nkv <= 0 || hd <= 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] attn_dt_decode_batch: bad dims N=%lld Lrows=%lld cap=%lld nh=%lld nkv=%lld hd=%lld\\n\",\n"
    buf = buf + "                (long long)N, (long long)Lrows, (long long)cap, (long long)nh, (long long)nkv, (long long)hd);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (Lrows > cap) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] attn_dt_decode_batch: Lrows=%lld exceeds cap=%lld\\n\",\n"
    buf = buf + "                (long long)Lrows, (long long)cap);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (nh % nkv != 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] attn_dt_decode_batch: nh=%lld not divisible by nkv=%lld\\n\",\n"
    buf = buf + "                (long long)nh, (long long)nkv);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (q_id >= _hx_farr_count || k_id >= _hx_farr_count ||\n"
    buf = buf + "        v_id >= _hx_farr_count || s_id >= _hx_farr_count ||\n"
    buf = buf + "        ctx_id >= _hx_farr_count) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] attn_dt_decode_batch: id out of range\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    int64_t nqd = N * nh  * hd;\n"
    buf = buf + "    int64_t nk  = N * cap * nkv * hd;\n"
    buf = buf + "    int64_t ns  = N * nh  * Lrows;\n"
    buf = buf + "    if (_hx_farr_table[q_id].len   < nqd ||\n"
    buf = buf + "        _hx_farr_table[k_id].len   < nk  ||\n"
    buf = buf + "        _hx_farr_table[v_id].len   < nk  ||\n"
    buf = buf + "        _hx_farr_table[s_id].len   < ns  ||\n"
    buf = buf + "        _hx_farr_table[ctx_id].len < nqd) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] attn_dt_decode_batch: host len mismatch\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_h2d(q_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(k_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(v_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_buf(s_id,   ns)  != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_buf(ctx_id, nqd) != 0) return -1;\n"
    buf = buf + "    double* Q = g_slots[q_id].d_buf;\n"
    buf = buf + "    double* K = g_slots[k_id].d_buf;\n"
    buf = buf + "    double* V = g_slots[v_id].d_buf;\n"
    buf = buf + "    double* S = g_slots[s_id].d_buf;\n"
    buf = buf + "    double* C = g_slots[ctx_id].d_buf;\n"
    buf = buf + "    /* one thread per (seq, head) — N*nh threads. */\n"
    buf = buf + "    int64_t total = N * nh;\n"
    buf = buf + "    int block = 64;\n"
    buf = buf + "    int64_t need = (total + block - 1) / block;\n"
    buf = buf + "    int grid = (int)(need < 1 ? 1 : (need > 65535 ? 65535 : need));\n"
    buf = buf + "    _hx_cuda_kern_attn_dt_decode_batch<<<grid, block, 0, _forge_stream()>>>(Q, K, V, S, C, N, Lrows, cap, nh, nkv, hd);\n"
    buf = buf + "    if (_forge_launch_check(\"attn_dt_decode_batch\") != 0) return -1;\n"
    buf = buf + "    if (_d2h_out(ctx_id, nqd) != 0) return -1;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ════════════════════════════════════════════════════════════════════\n"
    buf = buf + " * S1 FP32-e2e decode (#21 gold campaign, opt-in HEXA_DECODE_FP32).\n"
    buf = buf + " *\n"
    buf = buf + " * Structural-wall #1 (FP64 activations e2e → 2x bandwidth + per-op d2f/f2d\n"
    buf = buf + " * casts): the linear decode ops (LN, matmul, gelu, residual, KV) flow f32\n"
    buf = buf + " * device→f32 device through the additive g_slots[].d_f32 mirror — NO cast\n"
    buf = buf + " * per op, HALF the activation bandwidth. Weights are cast ONCE (farr_to_f32,\n"
    buf = buf + " * hoisted). Matmul reuses the mma.sync m16n8k8 own-GEMM verbatim (already\n"
    buf = buf + " * pure-f32, argmax-faithful vs FP64/torch 24/24 — the TF32 rung proof).\n"
    buf = buf + " * Attention stays the FP64 kernel via an explicit f32↔f64 ROUNDTRIP island\n"
    buf = buf + " * ([ATTN-F64-ROUNDTRIP] banner) — S2 replaces it with a fused f32 kernel;\n"
    buf = buf + " * the roundtrip cast cost is isolated in nsys for the S1 verdict.\n"
    buf = buf + " * FP64 d_buf path is byte-untouched → default byteeq neutral (gate 3). */\n"
    buf = buf + "static int _ensure_d_f32(int64_t id, int64_t n) {\n"
    buf = buf + "    if (id < 0) return -1;\n"
    buf = buf + "    if (_ensure_slot_cap(id) != 0) return -1;\n"
    buf = buf + "    _CudaFarrSlot* s = &g_slots[id];\n"
    buf = buf + "    if (n > s->f32_cap) {\n"
    buf = buf + "        if (s->d_f32) cudaFree(s->d_f32);\n"
    buf = buf + "        cudaError_t er = cudaMalloc((void**)&s->d_f32, (size_t)n * sizeof(float));\n"
    buf = buf + "        if (er != cudaSuccess) {\n"
    buf = buf + "            fprintf(stderr, \"[cuda] f32 mirror alloc id=%lld n=%lld: %s\\n\",\n"
    buf = buf + "                    (long long)id, (long long)n, cudaGetErrorString(er));\n"
    buf = buf + "            s->d_f32 = NULL; s->f32_cap = 0; return -1;\n"
    buf = buf + "        }\n"
    buf = buf + "        s->f32_cap = n;\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* f32 LayerNorm — byte-shape clone of _hx_k_layernorm_rows, float storage +\n"
    buf = buf + " * float accumulation (two-pass mean/var, population variance). */\n"
    buf = buf + "__global__ void _hx_k_layernorm_rows_f32(const float* __restrict__ X,\n"
    buf = buf + "                                         const float* __restrict__ G,\n"
    buf = buf + "                                         const float* __restrict__ B,\n"
    buf = buf + "                                         float* __restrict__ Y,\n"
    buf = buf + "                                         int64_t R, int64_t C, double eps) {\n"
    buf = buf + "    int64_t r = blockIdx.x;\n"
    buf = buf + "    if (r >= R) return;\n"
    buf = buf + "    const float* xr = X + r * C;\n"
    buf = buf + "    float*       yr = Y + r * C;\n"
    buf = buf + "    __shared__ float smem[HX_RR_BLOCK / 32];\n"
    buf = buf + "    float s = 0.0f;\n"
    buf = buf + "    for (int64_t j = threadIdx.x; j < C; j += blockDim.x) s += xr[j];\n"
    buf = buf + "    float mean = _hx_block_sum_f32(s, smem) / (float)C;\n"
    buf = buf + "    __syncthreads();\n"
    buf = buf + "    float v = 0.0f;\n"
    buf = buf + "    for (int64_t j = threadIdx.x; j < C; j += blockDim.x) {\n"
    buf = buf + "        float d = xr[j] - mean; v += d * d;\n"
    buf = buf + "    }\n"
    buf = buf + "    float var = _hx_block_sum_f32(v, smem) / (float)C;\n"
    buf = buf + "    float inv = rsqrtf(var + (float)eps);\n"
    buf = buf + "    for (int64_t j = threadIdx.x; j < C; j += blockDim.x) {\n"
    buf = buf + "        float xn = (xr[j] - mean) * inv;\n"
    buf = buf + "        yr[j] = G[j] * xn + B[j];\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "/* f32 GELU — f32 IO, erf computed in double for argmax fidelity to the FP64\n"
    buf = buf + " * dt_erf path (element-wise, not bandwidth-bound — the f32 storage keeps\n"
    buf = buf + " * the S1 bandwidth win). */\n"
    buf = buf + "__global__ void _hx_k_gelu_f32(const float* __restrict__ IN,\n"
    buf = buf + "                               float* __restrict__ OUT, int64_t n) {\n"
    buf = buf + "    const double inv_sqrt2 = 0.70710678118654752440;\n"
    buf = buf + "    int64_t stride = (int64_t)blockDim.x * (int64_t)gridDim.x;\n"
    buf = buf + "    for (int64_t i = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;\n"
    buf = buf + "         i < n; i += stride) {\n"
    buf = buf + "        double x = (double)IN[i];\n"
    buf = buf + "        double cdf = 0.5 * (1.0 + _hx_dt_erf_dev(x * inv_sqrt2));\n"
    buf = buf + "        OUT[i] = (float)(x * cdf);\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* RANK-4 (#21 gold-v2 attn-f32-fast): fp32-erff GELU variant. Same disease as\n"
    buf = buf + " * RANK-1 — the FP64 _hx_dt_erf_dev Taylor per element on 1:64-FP64 sm_120\n"
    buf = buf + " * (gelu 5.5-10.9% GPU time, ~37us for a ~3-5us memory-floor op). erff is a\n"
    buf = buf + " * single-issue SFU op (reference-match torch exact-erf GELU x·0.5·(1+erf(x/√2))).\n"
    buf = buf + " * Opt-in HEXA_GELU_F32ERF, default-OFF = FP64 kernel byte-identical (retained). */\n"
    buf = buf + "__global__ void _hx_k_gelu_f32_ferf(const float* __restrict__ IN,\n"
    buf = buf + "                               float* __restrict__ OUT, int64_t n) {\n"
    buf = buf + "    const float inv_sqrt2 = 0.70710678118654752440f;\n"
    buf = buf + "    int64_t stride = (int64_t)blockDim.x * (int64_t)gridDim.x;\n"
    buf = buf + "    for (int64_t i = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;\n"
    buf = buf + "         i < n; i += stride) {\n"
    buf = buf + "        float x = IN[i];\n"
    buf = buf + "        float cdf = 0.5f * (1.0f + erff(x * inv_sqrt2));\n"
    buf = buf + "        OUT[i] = x * cdf;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* RANK-4 gate: opt-in fp32-erff GELU. Default-OFF = FP64 kernel byte-identical. */\n"
    buf = buf + "static int _forge_gelu_ferf_on(void) {\n"
    buf = buf + "    const char* v = getenv(\"HEXA_GELU_F32ERF\");\n"
    buf = buf + "    return (v && v[0] && v[0] != '0') ? 1 : 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* f32 residual add — OUT[i] = A[i] + B[i], float. */\n"
    buf = buf + "__global__ void _hx_k_residual_add_f32(const float* __restrict__ A,\n"
    buf = buf + "                                       const float* __restrict__ B,\n"
    buf = buf + "                                       float* __restrict__ OUT, int64_t n) {\n"
    buf = buf + "    int64_t stride = (int64_t)blockDim.x * (int64_t)gridDim.x;\n"
    buf = buf + "    for (int64_t i = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;\n"
    buf = buf + "         i < n; i += stride) {\n"
    buf = buf + "        OUT[i] = A[i] + B[i];\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* #21 gold rank-7 EPILOGUE FUSION: residual-add + LayerNorm in ONE launch\n"
    buf = buf + " * (optional pre-residual bias). Replaces the separate _hx_k_residual_add_f32\n"
    buf = buf + " * (192 launches/step) + _hx_k_layernorm_rows_f32 (49/step) = ~9% of decode GPU\n"
    buf = buf + " * time spent in pure memory-bound epilogue launches — the SANCTIONED fusion\n"
    buf = buf + " * class (both are bandwidth-bound: elementwise add + row-reduction LN, so the\n"
    buf = buf + " * fusing!=gain rule is satisfied). One block per row, HX_RR_BLOCK threads:\n"
    buf = buf + " * pass0 writes the residual stream H IN PLACE (h = h + add [+ bias]) with the\n"
    buf = buf + " * SAME float add as _hx_k_residual_add_f32; passes 1-3 are _hx_k_layernorm_rows_f32\n"
    buf = buf + " * VERBATIM (same _hx_block_sum_f32 two-pass reduction reading the stored H[j]).\n"
    buf = buf + " * Each H[j] is written and re-read by the SAME thread (j = tid, stride blockDim),\n"
    buf = buf + " * so the fused result is BIT-IDENTICAL to residual_add-then-layernorm ->\n"
    buf = buf + " * byteeq-neutral (HEXA_DET exact-compare gated, not assumed). Works for BOTH the\n"
    buf = buf + " * own-GEMM and cuBLAS paths (it is a TRAILING epilogue, GEMM-type agnostic — the\n"
    buf = buf + " * cuBLAS opt-in is untouched). BIAS may be NULL (pure resid+LN, the measured\n"
    buf = buf + " * share). Reference-match: CUTLASS epilogue visitor (LayerNorm/residual epilogue,\n"
    buf = buf + " * EpilogueWithBroadcast) + torch/apex fused add+LayerNorm. */\n"
    buf = buf + "__global__ void _hx_k_resid_layernorm_f32(float* __restrict__ H,\n"
    buf = buf + "                                          const float* __restrict__ ADD,\n"
    buf = buf + "                                          const float* __restrict__ BIAS,\n"
    buf = buf + "                                          const float* __restrict__ G,\n"
    buf = buf + "                                          const float* __restrict__ B,\n"
    buf = buf + "                                          float* __restrict__ Y,\n"
    buf = buf + "                                          int64_t R, int64_t C, double eps) {\n"
    buf = buf + "    int64_t r = blockIdx.x;\n"
    buf = buf + "    if (r >= R) return;\n"
    buf = buf + "    float*       hr = H + r * C;\n"
    buf = buf + "    const float* ar = ADD + r * C;\n"
    buf = buf + "    float*       yr = Y + r * C;\n"
    buf = buf + "    __shared__ float smem[HX_RR_BLOCK / 32];\n"
    buf = buf + "    /* pass0: residual (+ optional bias) in place — bit-matches _hx_k_residual_add_f32. */\n"
    buf = buf + "    for (int64_t j = threadIdx.x; j < C; j += blockDim.x) {\n"
    buf = buf + "        float h = hr[j] + ar[j];\n"
    buf = buf + "        if (BIAS) h += BIAS[j];\n"
    buf = buf + "        hr[j] = h;\n"
    buf = buf + "    }\n"
    buf = buf + "    __syncthreads();\n"
    buf = buf + "    /* pass1-3: _hx_k_layernorm_rows_f32 verbatim over the updated H row. */\n"
    buf = buf + "    float s = 0.0f;\n"
    buf = buf + "    for (int64_t j = threadIdx.x; j < C; j += blockDim.x) s += hr[j];\n"
    buf = buf + "    float mean = _hx_block_sum_f32(s, smem) / (float)C;\n"
    buf = buf + "    __syncthreads();\n"
    buf = buf + "    float v = 0.0f;\n"
    buf = buf + "    for (int64_t j = threadIdx.x; j < C; j += blockDim.x) {\n"
    buf = buf + "        float d = hr[j] - mean; v += d * d;\n"
    buf = buf + "    }\n"
    buf = buf + "    float var = _hx_block_sum_f32(v, smem) / (float)C;\n"
    buf = buf + "    float inv = rsqrtf(var + (float)eps);\n"
    buf = buf + "    for (int64_t j = threadIdx.x; j < C; j += blockDim.x) {\n"
    buf = buf + "        float xn = (hr[j] - mean) * inv;\n"
    buf = buf + "        yr[j] = G[j] * xn + B[j];\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "/* #21 gold rank-7: epilogue fusion is OPT-IN default-OFF (HEXA_EPI_FUSE). The\n"
    buf = buf + " * fused path is bit-identical to the separate kernels by construction, so this\n"
    buf = buf + " * gates a byteeq-neutral A/B (fused-vs-separate) rather than a behavior change. */\n"
    buf = buf + "static int _forge_epi_fuse_on(void) {\n"
    buf = buf + "    const char* v = getenv(\"HEXA_EPI_FUSE\");\n"
    buf = buf + "    return (v && v[0] && v[0] != '0') ? 1 : 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* farr_mark_f32(id, n) — allocate + zero the f32 mirror (farr_zeros_f32). */\n"
    buf = buf + "int _hx_cuda_farr_mark_f32(int64_t id, int64_t n) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (n <= 0) return -1;\n"
    buf = buf + "    if (_ensure_d_f32(id, n) != 0) return -1;\n"
    buf = buf + "    cudaMemsetAsync(g_slots[id].d_f32, 0, (size_t)n * sizeof(float), _forge_stream());\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)id; (void)n; return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* farr_to_f32(id, n) — H2D the f64 host buf then cast d_buf→d_f32 (weights,\n"
    buf = buf + " * cast ONCE; _h2d H2D-skips on pinned device-resident weights). */\n"
    buf = buf + "int _hx_cuda_farr_to_f32(int64_t id, int64_t n) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (n <= 0) return -1;\n"
    buf = buf + "    if (_h2d(id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_d_f32(id, n) != 0) return -1;\n"
    buf = buf + "    const double* src = g_slots[id].d_buf;\n"
    buf = buf + "    float* dst = g_slots[id].d_f32;\n"
    buf = buf + "    dim3 b(256); dim3 g((unsigned)((n + 255) / 256));\n"
    buf = buf + "    _hx_k_cast_d2f<<<g, b, 0, _forge_stream()>>>(src, dst, n);\n"
    buf = buf + "    if (_forge_launch_check(\"to_f32\") != 0) return -1;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)id; (void)n; return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "/* farr_to_f64(id, n) — cast d_f32→d_buf and materialize to host (head/logits\n"
    buf = buf + " * boundary). Leaves the entry host-authoritative for farr_get. */\n"
    buf = buf + "int _hx_cuda_farr_to_f64(int64_t id, int64_t n) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (n <= 0) return -1;\n"
    buf = buf + "    if (g_slots[id].d_f32 == NULL) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(id, n) != 0) return -1;\n"
    buf = buf + "    const float* src = g_slots[id].d_f32;\n"
    buf = buf + "    double* dst = g_slots[id].d_buf;\n"
    buf = buf + "    dim3 b(256); dim3 g((unsigned)((n + 255) / 256));\n"
    buf = buf + "    _hx_k_cast_f2d<<<g, b, 0, _forge_stream()>>>(src, dst, n);\n"
    buf = buf + "    if (_forge_launch_check(\"to_f64\") != 0) return -1;\n"
    buf = buf + "    {\n"
    buf = buf + "        HexaFarrEntry* e = &_hx_farr_table[id];\n"
    buf = buf + "        e->d_buf = (void*)g_slots[id].d_buf;\n"
    buf = buf + "        e->loc = FARR_DEVICE; e->dirty_host = 0; e->dirty_dev = 1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_d2h(id) != 0) return -1;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)id; (void)n; return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* farr_matmul_f32_gpu(a, M, K, w, N, out) — cast-FREE f32 GEMM: reuse the\n"
    buf = buf + " * mma.sync m16n8k8 own-GEMM on d_f32 inputs directly. out.d_f32 grown. */\n"
    buf = buf + "int _hx_cuda_farr_matmul_f32_gpu(int64_t a_id, int64_t M, int64_t K,\n"
    buf = buf + "                                 int64_t w_id, int64_t N, int64_t out_id) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (M <= 0 || K <= 0 || N <= 0) return -1;\n"
    buf = buf + "    if (g_slots[a_id].d_f32 == NULL || g_slots[w_id].d_f32 == NULL) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] matmul_f32: inputs not f32-resident a=%lld w=%lld\\n\",\n"
    buf = buf + "                (long long)a_id, (long long)w_id);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_ensure_d_f32(out_id, M * N) != 0) return -1;\n"
    buf = buf + "    static int _fp32_e2e_fired = 0;\n"
    buf = buf + "    if (!_fp32_e2e_fired) { _fp32_e2e_fired = 1;\n"
    buf = buf + "        fprintf(stderr, \"[FP32-E2E-FIRED] farr_matmul_f32_gpu own mma.sync m16n8k8, no d2f/f2d cast (S1 #21 gold, opt-in)\\n\"); }\n"
    buf = buf + "    const float* A = g_slots[a_id].d_f32;\n"
    buf = buf + "    const float* B = g_slots[w_id].d_f32;\n"
    buf = buf + "    float* C = g_slots[out_id].d_f32;\n"
    buf = buf + "#ifdef HEXA_USE_CUBLAS\n"
    buf = buf + "    /* B-probe (#21 gold): cuBLAS-TF32 GEMM ceiling on the f32 decode path — inputs\n"
    buf = buf + "     * already f32 (d_f32) so NO cast; same row-major→col-major arg layout as the\n"
    buf = buf + "     * FP64 cublasGemmEx path. opt-in = HEXA_USE_CUBLAS build + HEXA_TF32_OWN=0\n"
    buf = buf + "     * (polarity: own mma.sync is DEFAULT; cuBLAS is the opt-out external dep). */\n"
    buf = buf + "    if (!_forge_tf32_own_on()) {\n"
    buf = buf + "        if (_ensure_cublas_tf32() != 0) return -1;\n"
    buf = buf + "        static int _cub_f32_fired = 0;\n"
    buf = buf + "        if (!_cub_f32_fired) { _cub_f32_fired = 1;\n"
    buf = buf + "            fprintf(stderr, \"[FP32-E2E-CUBLAS-FIRED] cublasGemmEx COMPUTE_32F_FAST_TF32 on f32 decode matmul (B-probe GEMM ceiling)\\n\"); }\n"
    buf = buf + "        const float alpha = 1.0f; const float beta = 0.0f;\n"
    buf = buf + "        cublasStatus_t st = cublasGemmEx(g_cublas_tf32, CUBLAS_OP_N, CUBLAS_OP_N,\n"
    buf = buf + "                                         (int)N, (int)M, (int)K, &alpha,\n"
    buf = buf + "                                         B, CUDA_R_32F, (int)N,\n"
    buf = buf + "                                         A, CUDA_R_32F, (int)K,\n"
    buf = buf + "                                         &beta, C, CUDA_R_32F, (int)N,\n"
    buf = buf + "                                         CUBLAS_COMPUTE_32F_FAST_TF32,\n"
    buf = buf + "                                         CUBLAS_GEMM_DEFAULT_TENSOR_OP);\n"
    buf = buf + "        if (st != CUBLAS_STATUS_SUCCESS) { fprintf(stderr, \"[cuda] matmul_f32 cublasGemmEx: %d\\n\", (int)st); return -1; }\n"
    buf = buf + "        return 0;\n"
    buf = buf + "    }\n"
    buf = buf + "#endif\n"
    buf = buf + "    /* #21 gold rank-2 skinny-M split-K dispatch (opt-in, canonical own path).\n"
    buf = buf + "     * Engage only in the MEASURED-WIN region: M<=8 (HX_SKINNY_M_MAX) AND the\n"
    buf = buf + "     * owngemm tile underfills (ceil(N/64)*ceil(M/64) < the 128-block DRAM-95% knee).\n"
    buf = buf + "     * The M<=8 bound is measured, not assumed: decode M=1/8 win 1.27x/1.16x but\n"
    buf = buf + "     * M=16/32 lose 0.95x/0.78x, so the gate excludes the loss cases (see the kernel\n"
    buf = buf + "     * header for the numbers). Square/large-M GEMMs (M>=64) fail the M<=8 test\n"
    buf = buf + "     * outright and keep the owngemm tile bit-unchanged. KS fills to the knee\n"
    buf = buf + "     * (never a swept constant). */\n"
    buf = buf + "    if (_forge_skinny_splitk_on() && _hx_skinny_shape_ok(M, N)) {\n"
    buf = buf + "        {\n"
    buf = buf + "            dim3 _skblk(HX_SKINNY_BN, HX_SKINNY_BMROWS);\n"
    buf = buf + "            unsigned _gx = (unsigned)((N + HX_SKINNY_BN - 1)/HX_SKINNY_BN);\n"
    buf = buf + "            unsigned _gy = (unsigned)((M + HX_SKINNY_BMROWS - 1)/HX_SKINNY_BMROWS);\n"
    buf = buf + "            long long _base = (long long)_gx * (long long)_gy;\n"
    buf = buf + "            int _ks = (int)((HX_SKINNY_KNEE + _base - 1) / _base);\n"
    buf = buf + "            if (_ks < 1) _ks = 1;\n"
    buf = buf + "            if (_ks > HX_SKINNY_KS_MAX) _ks = HX_SKINNY_KS_MAX;\n"
    buf = buf + "            dim3 _skgrd(_gx, _gy, (unsigned)_ks);\n"
    buf = buf + "            if (!_forge_det_on()) {\n"
    buf = buf + "                /* fast NON-DET default (polarity exception): atomic split-K, C pre-zeroed. */\n"
    buf = buf + "                static int _skinny_fired = 0;\n"
    buf = buf + "                if (!_skinny_fired) { _skinny_fired = 1;\n"
    buf = buf + "                    fprintf(stderr, \"[SKINNY-SPLITK-FIRED] f32 atomic split-K M<=%d fill-to-knee (opt-in, non-det)\\n\", HX_SKINNY_M_MAX); }\n"
    buf = buf + "                cudaMemsetAsync(C, 0, (size_t)(M*N)*sizeof(float), _forge_stream());\n"
    buf = buf + "                _hx_k_gemm_f32_splitk<<<_skgrd, _skblk, 0, _forge_stream()>>>(A, B, C, (int)M, (int)N, (int)K, _ks);\n"
    buf = buf + "                if (_forge_launch_check(\"matmul_f32_skinny_splitk\") != 0) return -1;\n"
    buf = buf + "                return 0;\n"
    buf = buf + "            } else {\n"
    buf = buf + "                /* HEXA_DET: fixed-order two-pass split-K (deterministic, still filled).\n"
    buf = buf + "                 * Persistent grow-on-demand partials slab (NO per-call cudaMalloc/Free\n"
    buf = buf + "                 * — the 35K malloc/free lesson). */\n"
    buf = buf + "                static float* g_skinny_P = NULL; static size_t g_skinny_P_cap = 0;\n"
    buf = buf + "                size_t _need = (size_t)_ks * (size_t)M * (size_t)N;\n"
    buf = buf + "                if (_need > g_skinny_P_cap) {\n"
    buf = buf + "                    if (g_skinny_P) cudaFree(g_skinny_P);\n"
    buf = buf + "                    cudaError_t _er = cudaMalloc((void**)&g_skinny_P, _need*sizeof(float));\n"
    buf = buf + "                    if (_er != cudaSuccess) { fprintf(stderr, \"[cuda] skinny split-K partials(%zu): %s\\n\", _need, cudaGetErrorString(_er)); g_skinny_P=NULL; g_skinny_P_cap=0; return -1; }\n"
    buf = buf + "                    g_skinny_P_cap = _need;\n"
    buf = buf + "                }\n"
    buf = buf + "                static int _skinny_det_fired = 0;\n"
    buf = buf + "                if (!_skinny_det_fired) { _skinny_det_fired = 1;\n"
    buf = buf + "                    fprintf(stderr, \"[SKINNY-SPLITK-DET-FIRED] f32 two-pass fixed-order split-K M<=%d (opt-in, deterministic)\\n\", HX_SKINNY_M_MAX); }\n"
    buf = buf + "                _hx_k_gemm_f32_splitk_partial<<<_skgrd, _skblk, 0, _forge_stream()>>>(A, B, g_skinny_P, (int)M, (int)N, (int)K, _ks);\n"
    buf = buf + "                if (_forge_launch_check(\"matmul_f32_skinny_partial\") != 0) return -1;\n"
    buf = buf + "                dim3 _rdgrd(_gx, _gy);\n"
    buf = buf + "                _hx_k_splitk_reduce_f32<<<_rdgrd, _skblk, 0, _forge_stream()>>>(g_skinny_P, C, (int)M, (int)N, _ks);\n"
    buf = buf + "                if (_forge_launch_check(\"matmul_f32_skinny_reduce\") != 0) return -1;\n"
    buf = buf + "                return 0;\n"
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    dim3 blk(HX_OWNTF_NTHREAD);\n"
    buf = buf + "    dim3 grd((unsigned)((N + HX_OWNTF_BN - 1) / HX_OWNTF_BN),\n"
    buf = buf + "             (unsigned)((M + HX_OWNTF_BM - 1) / HX_OWNTF_BM));\n"
    buf = buf + "    _hx_k_gemm_tf32_owngemm<<<grd, blk, 0, _forge_stream()>>>(A, B, C, (int)M, (int)N, (int)K);\n"
    buf = buf + "    if (_forge_launch_check(\"matmul_f32\") != 0) return -1;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)a_id; (void)M; (void)K; (void)w_id; (void)N; (void)out_id; return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "/* farr_layernorm_f32_gpu(x, g, b, out, R, C, eps) — one block/row, f32. */\n"
    buf = buf + "int _hx_cuda_farr_layernorm_f32_gpu(int64_t x_id, int64_t g_id, int64_t b_id,\n"
    buf = buf + "                                    int64_t out_id, int64_t R, int64_t C,\n"
    buf = buf + "                                    double eps) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (R <= 0 || C <= 0 || !(eps >= 0.0)) return -1;\n"
    buf = buf + "    if (g_slots[x_id].d_f32 == NULL || g_slots[g_id].d_f32 == NULL ||\n"
    buf = buf + "        g_slots[b_id].d_f32 == NULL) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] layernorm_f32: inputs not f32-resident\\n\"); return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_ensure_d_f32(out_id, R * C) != 0) return -1;\n"
    buf = buf + "    const float* X = g_slots[x_id].d_f32;\n"
    buf = buf + "    const float* G = g_slots[g_id].d_f32;\n"
    buf = buf + "    const float* B = g_slots[b_id].d_f32;\n"
    buf = buf + "    float* Y = g_slots[out_id].d_f32;\n"
    buf = buf + "    _hx_k_layernorm_rows_f32<<<(unsigned)R, HX_RR_BLOCK, 0, _forge_stream()>>>(X, G, B, Y, R, C, eps);\n"
    buf = buf + "    if (_forge_launch_check(\"layernorm_f32\") != 0) return -1;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)x_id; (void)g_id; (void)b_id; (void)out_id; (void)R; (void)C; (void)eps; return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* farr_gelu_f32_gpu(in, out, n). */\n"
    buf = buf + "int _hx_cuda_farr_gelu_f32_gpu(int64_t in_id, int64_t out_id, int64_t n) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (n <= 0) return -1;\n"
    buf = buf + "    if (g_slots[in_id].d_f32 == NULL) return -1;\n"
    buf = buf + "    if (_ensure_d_f32(out_id, n) != 0) return -1;\n"
    buf = buf + "    const float* IN = g_slots[in_id].d_f32;\n"
    buf = buf + "    float* OUT = g_slots[out_id].d_f32;\n"
    buf = buf + "    int block_sz = 256;\n"
    buf = buf + "    int64_t want = (n + block_sz - 1) / block_sz;\n"
    buf = buf + "    int grid_sz = (want > 1024) ? 1024 : (int)want; if (grid_sz < 1) grid_sz = 1;\n"
    buf = buf + "    if (_forge_gelu_ferf_on()) {\n"
    buf = buf + "        static int _gelu_ferf_fired = 0;\n"
    buf = buf + "        if (!_gelu_ferf_fired) { _gelu_ferf_fired = 1;\n"
    buf = buf + "            fprintf(stderr, \"[GELU-F32ERF-FIRED] fp32 erff GELU (RANK-4 gold-v2, opt-in HEXA_GELU_F32ERF)\\n\"); }\n"
    buf = buf + "        _hx_k_gelu_f32_ferf<<<grid_sz, block_sz, 0, _forge_stream()>>>(IN, OUT, n);\n"
    buf = buf + "    } else {\n"
    buf = buf + "        _hx_k_gelu_f32<<<grid_sz, block_sz, 0, _forge_stream()>>>(IN, OUT, n);\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_forge_launch_check(\"gelu_f32\") != 0) return -1;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)in_id; (void)out_id; (void)n; return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "/* farr_residual_add_f32_gpu(a, b, out, n). */\n"
    buf = buf + "int _hx_cuda_farr_residual_add_f32_gpu(int64_t a_id, int64_t b_id,\n"
    buf = buf + "                                       int64_t out_id, int64_t n) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (n <= 0) return -1;\n"
    buf = buf + "    if (g_slots[a_id].d_f32 == NULL || g_slots[b_id].d_f32 == NULL) return -1;\n"
    buf = buf + "    if (_ensure_d_f32(out_id, n) != 0) return -1;\n"
    buf = buf + "    const float* A = g_slots[a_id].d_f32;\n"
    buf = buf + "    const float* B = g_slots[b_id].d_f32;\n"
    buf = buf + "    float* OUT = g_slots[out_id].d_f32;\n"
    buf = buf + "    int block_sz = 256;\n"
    buf = buf + "    int64_t want = (n + block_sz - 1) / block_sz;\n"
    buf = buf + "    int grid_sz = (want > 1024) ? 1024 : (int)want; if (grid_sz < 1) grid_sz = 1;\n"
    buf = buf + "    _hx_k_residual_add_f32<<<grid_sz, block_sz, 0, _forge_stream()>>>(A, B, OUT, n);\n"
    buf = buf + "    if (_forge_launch_check(\"residual_add_f32\") != 0) return -1;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)a_id; (void)b_id; (void)out_id; (void)n; return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* farr_resid_layernorm_f32_gpu(h, add, g, b, y, R, C, eps) — #21 gold rank-7\n"
    buf = buf + " * epilogue-fusion entry: h += add (in place), then LayerNorm(h) -> y, in ONE\n"
    buf = buf + " * launch when HEXA_EPI_FUSE is on; OFF runs the SEPARATE _hx_k_residual_add_f32\n"
    buf = buf + " * + _hx_k_layernorm_rows_f32 = today's exact byte reference (the fused kernel is\n"
    buf = buf + " * bit-identical by construction, so ON-vs-OFF is a byteeq-neutral A/B). GEMM-type\n"
    buf = buf + " * agnostic trailing epilogue — serves the own-GEMM AND cuBLAS paths, breaks\n"
    buf = buf + " * neither. (BIAS fold is plumbed in the kernel but not wired here: the measured\n"
    buf = buf + " * 9%% share is bias-free resid+LN, and a per-col bias would need a matching\n"
    buf = buf + " * broadcast add in the OFF reference to keep the A/B exact.) The 9% share is\n"
    buf = buf + " * bias-free resid+LN. */\n"
    buf = buf + "int _hx_cuda_farr_resid_layernorm_f32_gpu(int64_t h_id, int64_t add_id,\n"
    buf = buf + "                                          int64_t g_id, int64_t b_id, int64_t y_id,\n"
    buf = buf + "                                          int64_t R, int64_t C, double eps) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (R <= 0 || C <= 0 || !(eps >= 0.0)) return -1;\n"
    buf = buf + "    if (g_slots[h_id].d_f32 == NULL || g_slots[add_id].d_f32 == NULL ||\n"
    buf = buf + "        g_slots[g_id].d_f32 == NULL || g_slots[b_id].d_f32 == NULL) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] resid_layernorm_f32: inputs not f32-resident\\n\"); return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_ensure_d_f32(y_id, R * C) != 0) return -1;\n"
    buf = buf + "    float* H = g_slots[h_id].d_f32;\n"
    buf = buf + "    const float* ADD = g_slots[add_id].d_f32;\n"
    buf = buf + "    const float* G = g_slots[g_id].d_f32;\n"
    buf = buf + "    const float* B = g_slots[b_id].d_f32;\n"
    buf = buf + "    float* Y = g_slots[y_id].d_f32;\n"
    buf = buf + "    int64_t n = R * C;\n"
    buf = buf + "    if (_forge_epi_fuse_on()) {\n"
    buf = buf + "        static int _epi_fired = 0;\n"
    buf = buf + "        if (!_epi_fired) { _epi_fired = 1;\n"
    buf = buf + "            fprintf(stderr, \"[EPI-FUSE-FIRED] fused resid+LN 1-launch (RANK-7, opt-in HEXA_EPI_FUSE)\\n\"); }\n"
    buf = buf + "        _hx_k_resid_layernorm_f32<<<(unsigned)R, HX_RR_BLOCK, 0, _forge_stream()>>>(H, ADD, NULL, G, B, Y, R, C, eps);\n"
    buf = buf + "        if (_forge_launch_check(\"resid_layernorm_f32_fused\") != 0) return -1;\n"
    buf = buf + "    } else {\n"
    buf = buf + "        /* separate = today's byte reference: in-place residual then LayerNorm. */\n"
    buf = buf + "        int block_sz = 256;\n"
    buf = buf + "        int64_t want = (n + block_sz - 1) / block_sz;\n"
    buf = buf + "        int grid_sz = (want > 1024) ? 1024 : (int)want; if (grid_sz < 1) grid_sz = 1;\n"
    buf = buf + "        _hx_k_residual_add_f32<<<grid_sz, block_sz, 0, _forge_stream()>>>(H, ADD, H, n);\n"
    buf = buf + "        if (_forge_launch_check(\"resid_layernorm_f32_sep_resid\") != 0) return -1;\n"
    buf = buf + "        _hx_k_layernorm_rows_f32<<<(unsigned)R, HX_RR_BLOCK, 0, _forge_stream()>>>(H, G, B, Y, R, C, eps);\n"
    buf = buf + "        if (_forge_launch_check(\"resid_layernorm_f32_sep_ln\") != 0) return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)h_id; (void)add_id; (void)g_id; (void)b_id; (void)y_id;\n"
    buf = buf + "    (void)R; (void)C; (void)eps; return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* farr_copy_slice_f32_gpu(src, soff, dst, doff, n) — D2D f32 KV append. */\n"
    buf = buf + "int _hx_cuda_farr_copy_slice_f32_gpu(int64_t src_id, int64_t soff,\n"
    buf = buf + "                                     int64_t dst_id, int64_t doff, int64_t n) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (n <= 0) return -1;\n"
    buf = buf + "    if (g_slots[src_id].d_f32 == NULL || g_slots[dst_id].d_f32 == NULL) return -1;\n"
    buf = buf + "    cudaMemcpyAsync(g_slots[dst_id].d_f32 + doff, g_slots[src_id].d_f32 + soff,\n"
    buf = buf + "                    (size_t)n * sizeof(float), cudaMemcpyDeviceToDevice, _forge_stream());\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)src_id; (void)soff; (void)dst_id; (void)doff; (void)n; return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "/* S2 (#21 gold): fused f32 flash-decode attention. Warp-per-(seq,head),\n"
    buf = buf + " * online-softmax (running max/sum, NO S materialization to HBM), reads q /\n"
    buf = buf + " * cap-strided K/V slab from d_f32 DIRECTLY (no f32↔f64 roundtrip, no f64 temp\n"
    buf = buf + " * slabs → closes the S1 N=32 OOM), writes ctx d_f32. Closes wall#2 (scalar\n"
    buf = buf + " * 1-thread → warp-parallel + fused). dt_exp/dt_sqrt-faithful (exp/scale in\n"
    buf = buf + " * double) — only the softmax ACCUMULATION is reassociated (online form);\n"
    buf = buf + " * argmax-gated vs FP64. Each lane owns the hd dims c≡lane (mod 32). */\n"
    buf = buf + "__global__ void _hx_cuda_kern_attn_flash_decode_batch_f32(const float* __restrict__ Q,\n"
    buf = buf + "                                                         const float* __restrict__ K,\n"
    buf = buf + "                                                         const float* __restrict__ V,\n"
    buf = buf + "                                                         float* __restrict__ CTX,\n"
    buf = buf + "                                                         int64_t N, int64_t Lrows,\n"
    buf = buf + "                                                         int64_t cap, int64_t nh,\n"
    buf = buf + "                                                         int64_t nkv, int64_t hd) {\n"
    buf = buf + "    int lane = threadIdx.x & 31;\n"
    buf = buf + "    int64_t warp_id = ((int64_t)blockIdx.x * blockDim.x + threadIdx.x) >> 5;\n"
    buf = buf + "    int64_t warp_stride = ((int64_t)gridDim.x * blockDim.x) >> 5;\n"
    buf = buf + "    int64_t total = N * nh;\n"
    buf = buf + "    int64_t n_rep = nh / nkv;\n"
    buf = buf + "    double scale = __ddiv_rn(1.0, _hx_cuda_dt_sqrt_d((double)hd));\n"
    buf = buf + "    for (int64_t wg = warp_id; wg < total; wg += warp_stride) {\n"
    buf = buf + "        int64_t n  = wg / nh;\n"
    buf = buf + "        int64_t hh = wg % nh;\n"
    buf = buf + "        int64_t kvh = hh / n_rep;\n"
    buf = buf + "        const float* Qb = Q + n * nh * hd + hh * hd;\n"
    buf = buf + "        const float* Kb = K + n * cap * nkv * hd;\n"
    buf = buf + "        const float* Vb = V + n * cap * nkv * hd;\n"
    buf = buf + "        /* each lane caches its dims of q + a running ctx accumulator (hd<=256). */\n"
    buf = buf + "        float qreg[8]; float acc[8]; int dpl = 0;\n"
    buf = buf + "        for (int c = lane; c < hd; c += 32) { qreg[dpl] = Qb[c]; acc[dpl] = 0.0f; dpl++; }\n"
    buf = buf + "        float m = -3.4028235e38f; float l = 0.0f;\n"
    buf = buf + "        for (int64_t j = 0; j < Lrows; j++) {\n"
    buf = buf + "            const float* kj = Kb + (j * nkv + kvh) * hd;\n"
    buf = buf + "            float partial = 0.0f; int t = 0;\n"
    buf = buf + "            for (int c = lane; c < hd; c += 32) { partial += qreg[t] * kj[c]; t++; }\n"
    buf = buf + "            for (int o = 16; o > 0; o >>= 1) partial += __shfl_down_sync(0xffffffffu, partial, o);\n"
    buf = buf + "            float dot = __shfl_sync(0xffffffffu, partial, 0);\n"
    buf = buf + "            float score = (float)__dmul_rn((double)dot, scale);\n"
    buf = buf + "            float m_new = fmaxf(m, score);\n"
    buf = buf + "            float corr = (float)_hx_cuda_dt_exp_d((double)(m - m_new));\n"
    buf = buf + "            float p    = (float)_hx_cuda_dt_exp_d((double)(score - m_new));\n"
    buf = buf + "            l = l * corr + p;\n"
    buf = buf + "            const float* vj = Vb + (j * nkv + kvh) * hd;\n"
    buf = buf + "            t = 0;\n"
    buf = buf + "            for (int c = lane; c < hd; c += 32) { acc[t] = acc[t] * corr + p * vj[c]; t++; }\n"
    buf = buf + "            m = m_new;\n"
    buf = buf + "        }\n"
    buf = buf + "        float inv = (l > 0.0f) ? (1.0f / l) : 0.0f;\n"
    buf = buf + "        float* Cb = CTX + n * nh * hd + hh * hd;\n"
    buf = buf + "        int t = 0;\n"
    buf = buf + "        for (int c = lane; c < hd; c += 32) { Cb[c] = acc[t] * inv; t++; }\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "/* RANK-1 (#21 gold-v2 attn-f32-fast): fp32-exp variant of the flash-decode\n"
    buf = buf + " * kernel. IDENTICAL structure/reduction-order to the FP64-exp kernel above\n"
    buf = buf + " * (parallel dot, shfl reduce, online m/l in original j order) — the ONLY\n"
    buf = buf + " * change is softmax exp/scale in fp32: the two per-KV-row FP64 Taylor\n"
    buf = buf + " * _hx_cuda_dt_exp_d (~22 __ddiv_rn/row on 1:64-FP64 sm_120) → __expf (single\n"
    buf = buf + " * MUFU.EX2), and the per-row __dmul_rn scale → fp32 mul. Reference-match:\n"
    buf = buf + " * llama.cpp fattn-vec 'expf(KQ_reg - KQ_max)', FA softmax.h fp32 exp2f — no\n"
    buf = buf + " * double in the online softmax. Softmax weight bits shift ~1e-7 (argmax-\n"
    buf = buf + " * gated, opt-in HEXA_ATTN_F32EXP, default-OFF = FP64 kernel byte-identical). */\n"
    buf = buf + "__global__ void _hx_cuda_kern_attn_flash_decode_batch_f32_fexp(const float* __restrict__ Q,\n"
    buf = buf + "                                                         const float* __restrict__ K,\n"
    buf = buf + "                                                         const float* __restrict__ V,\n"
    buf = buf + "                                                         float* __restrict__ CTX,\n"
    buf = buf + "                                                         int64_t N, int64_t Lrows,\n"
    buf = buf + "                                                         int64_t cap, int64_t nh,\n"
    buf = buf + "                                                         int64_t nkv, int64_t hd) {\n"
    buf = buf + "    int lane = threadIdx.x & 31;\n"
    buf = buf + "    int64_t warp_id = ((int64_t)blockIdx.x * blockDim.x + threadIdx.x) >> 5;\n"
    buf = buf + "    int64_t warp_stride = ((int64_t)gridDim.x * blockDim.x) >> 5;\n"
    buf = buf + "    int64_t total = N * nh;\n"
    buf = buf + "    int64_t n_rep = nh / nkv;\n"
    buf = buf + "    float scale = 1.0f / sqrtf((float)hd);\n"
    buf = buf + "    for (int64_t wg = warp_id; wg < total; wg += warp_stride) {\n"
    buf = buf + "        int64_t n  = wg / nh;\n"
    buf = buf + "        int64_t hh = wg % nh;\n"
    buf = buf + "        int64_t kvh = hh / n_rep;\n"
    buf = buf + "        const float* Qb = Q + n * nh * hd + hh * hd;\n"
    buf = buf + "        const float* Kb = K + n * cap * nkv * hd;\n"
    buf = buf + "        const float* Vb = V + n * cap * nkv * hd;\n"
    buf = buf + "        float qreg[8]; float acc[8]; int dpl = 0;\n"
    buf = buf + "        for (int c = lane; c < hd; c += 32) { qreg[dpl] = Qb[c]; acc[dpl] = 0.0f; dpl++; }\n"
    buf = buf + "        float m = -3.4028235e38f; float l = 0.0f;\n"
    buf = buf + "        for (int64_t j = 0; j < Lrows; j++) {\n"
    buf = buf + "            const float* kj = Kb + (j * nkv + kvh) * hd;\n"
    buf = buf + "            float partial = 0.0f; int t = 0;\n"
    buf = buf + "            for (int c = lane; c < hd; c += 32) { partial += qreg[t] * kj[c]; t++; }\n"
    buf = buf + "            for (int o = 16; o > 0; o >>= 1) partial += __shfl_down_sync(0xffffffffu, partial, o);\n"
    buf = buf + "            float dot = __shfl_sync(0xffffffffu, partial, 0);\n"
    buf = buf + "            float score = dot * scale;\n"
    buf = buf + "            float m_new = fmaxf(m, score);\n"
    buf = buf + "            float corr = __expf(m - m_new);\n"
    buf = buf + "            float p    = __expf(score - m_new);\n"
    buf = buf + "            l = l * corr + p;\n"
    buf = buf + "            const float* vj = Vb + (j * nkv + kvh) * hd;\n"
    buf = buf + "            t = 0;\n"
    buf = buf + "            for (int c = lane; c < hd; c += 32) { acc[t] = acc[t] * corr + p * vj[c]; t++; }\n"
    buf = buf + "            m = m_new;\n"
    buf = buf + "        }\n"
    buf = buf + "        float inv = (l > 0.0f) ? (1.0f / l) : 0.0f;\n"
    buf = buf + "        float* Cb = CTX + n * nh * hd + hh * hd;\n"
    buf = buf + "        int t = 0;\n"
    buf = buf + "        for (int c = lane; c < hd; c += 32) { Cb[c] = acc[t] * inv; t++; }\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* RANK-1 gate: opt-in fp32-exp attn path. Default-OFF (unset/0) → FP64-exp\n"
    buf = buf + " * kernel = S2 byte-identical. HEXA_ATTN_F32EXP=1 → fp32-exp kernel. */\n"
    buf = buf + "static int _forge_attn_f32exp_on(void) {\n"
    buf = buf + "    const char* v = getenv(\"HEXA_ATTN_F32EXP\");\n"
    buf = buf + "    return (v && v[0] && v[0] != '0') ? 1 : 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "/* RANK-3 (#21 gold-v2 attn-f32-fast): 4-row j-unroll of the fp32-exp kernel.\n"
    buf = buf + " * BIT-IDENTICAL to fexp: the 4 K-row dots are issued together (loads pipeline,\n"
    buf = buf + " * hiding DRAM latency at low occupancy) but each dot uses the SAME lane-strided\n"
    buf = buf + " * reduction and the online m/l/acc updates are applied SEQUENTIALLY in original\n"
    buf = buf + " * j order → same reduction order, same bits (byte-compare vs fexp). NOTE: float4\n"
    buf = buf + " * relayout was NOT taken — it reorders the dot FP reduction (breaks bit-identity\n"
    buf = buf + " * for a ~4%%-ceiling kernel now that fexp cut attn to 9%%). Gate HEXA_ATTN_U4. */\n"
    buf = buf + "__global__ void _hx_cuda_kern_attn_flash_decode_batch_f32_fexp_u4(const float* __restrict__ Q,\n"
    buf = buf + "                                                         const float* __restrict__ K,\n"
    buf = buf + "                                                         const float* __restrict__ V,\n"
    buf = buf + "                                                         float* __restrict__ CTX,\n"
    buf = buf + "                                                         int64_t N, int64_t Lrows,\n"
    buf = buf + "                                                         int64_t cap, int64_t nh,\n"
    buf = buf + "                                                         int64_t nkv, int64_t hd) {\n"
    buf = buf + "    int lane = threadIdx.x & 31;\n"
    buf = buf + "    int64_t warp_id = ((int64_t)blockIdx.x * blockDim.x + threadIdx.x) >> 5;\n"
    buf = buf + "    int64_t warp_stride = ((int64_t)gridDim.x * blockDim.x) >> 5;\n"
    buf = buf + "    int64_t total = N * nh;\n"
    buf = buf + "    int64_t n_rep = nh / nkv;\n"
    buf = buf + "    float scale = 1.0f / sqrtf((float)hd);\n"
    buf = buf + "    for (int64_t wg = warp_id; wg < total; wg += warp_stride) {\n"
    buf = buf + "        int64_t n  = wg / nh;\n"
    buf = buf + "        int64_t hh = wg % nh;\n"
    buf = buf + "        int64_t kvh = hh / n_rep;\n"
    buf = buf + "        const float* Qb = Q + n * nh * hd + hh * hd;\n"
    buf = buf + "        const float* Kb = K + n * cap * nkv * hd;\n"
    buf = buf + "        const float* Vb = V + n * cap * nkv * hd;\n"
    buf = buf + "        float qreg[8]; float acc[8]; int dpl = 0;\n"
    buf = buf + "        for (int c = lane; c < hd; c += 32) { qreg[dpl] = Qb[c]; acc[dpl] = 0.0f; dpl++; }\n"
    buf = buf + "        float m = -3.4028235e38f; float l = 0.0f;\n"
    buf = buf + "        int64_t j = 0;\n"
    buf = buf + "        for (; j + 4 <= Lrows; j += 4) {\n"
    buf = buf + "            const float* k0 = Kb + ((j+0) * nkv + kvh) * hd;\n"
    buf = buf + "            const float* k1 = Kb + ((j+1) * nkv + kvh) * hd;\n"
    buf = buf + "            const float* k2 = Kb + ((j+2) * nkv + kvh) * hd;\n"
    buf = buf + "            const float* k3 = Kb + ((j+3) * nkv + kvh) * hd;\n"
    buf = buf + "            float p0=0.0f, p1=0.0f, p2=0.0f, p3=0.0f; int t = 0;\n"
    buf = buf + "            for (int c = lane; c < hd; c += 32) { float qv = qreg[t]; p0 += qv*k0[c]; p1 += qv*k1[c]; p2 += qv*k2[c]; p3 += qv*k3[c]; t++; }\n"
    buf = buf + "            for (int o = 16; o > 0; o >>= 1) { p0 += __shfl_down_sync(0xffffffffu, p0, o); p1 += __shfl_down_sync(0xffffffffu, p1, o); p2 += __shfl_down_sync(0xffffffffu, p2, o); p3 += __shfl_down_sync(0xffffffffu, p3, o); }\n"
    buf = buf + "            float dd[4]; dd[0] = __shfl_sync(0xffffffffu, p0, 0); dd[1] = __shfl_sync(0xffffffffu, p1, 0); dd[2] = __shfl_sync(0xffffffffu, p2, 0); dd[3] = __shfl_sync(0xffffffffu, p3, 0);\n"
    buf = buf + "            const float* vv[4]; vv[0]=Vb+((j+0)*nkv+kvh)*hd; vv[1]=Vb+((j+1)*nkv+kvh)*hd; vv[2]=Vb+((j+2)*nkv+kvh)*hd; vv[3]=Vb+((j+3)*nkv+kvh)*hd;\n"
    buf = buf + "            for (int u = 0; u < 4; u++) {\n"
    buf = buf + "                float score = dd[u] * scale;\n"
    buf = buf + "                float m_new = fmaxf(m, score);\n"
    buf = buf + "                float corr = __expf(m - m_new);\n"
    buf = buf + "                float p    = __expf(score - m_new);\n"
    buf = buf + "                l = l * corr + p;\n"
    buf = buf + "                const float* vj = vv[u]; t = 0;\n"
    buf = buf + "                for (int c = lane; c < hd; c += 32) { acc[t] = acc[t] * corr + p * vj[c]; t++; }\n"
    buf = buf + "                m = m_new;\n"
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "        for (; j < Lrows; j++) {\n"
    buf = buf + "            const float* kj = Kb + (j * nkv + kvh) * hd;\n"
    buf = buf + "            float partial = 0.0f; int t = 0;\n"
    buf = buf + "            for (int c = lane; c < hd; c += 32) { partial += qreg[t] * kj[c]; t++; }\n"
    buf = buf + "            for (int o = 16; o > 0; o >>= 1) partial += __shfl_down_sync(0xffffffffu, partial, o);\n"
    buf = buf + "            float dot = __shfl_sync(0xffffffffu, partial, 0);\n"
    buf = buf + "            float score = dot * scale;\n"
    buf = buf + "            float m_new = fmaxf(m, score);\n"
    buf = buf + "            float corr = __expf(m - m_new);\n"
    buf = buf + "            float p    = __expf(score - m_new);\n"
    buf = buf + "            l = l * corr + p;\n"
    buf = buf + "            const float* vj = Vb + (j * nkv + kvh) * hd; t = 0;\n"
    buf = buf + "            for (int c = lane; c < hd; c += 32) { acc[t] = acc[t] * corr + p * vj[c]; t++; }\n"
    buf = buf + "            m = m_new;\n"
    buf = buf + "        }\n"
    buf = buf + "        float inv = (l > 0.0f) ? (1.0f / l) : 0.0f;\n"
    buf = buf + "        float* Cb = CTX + n * nh * hd + hh * hd;\n"
    buf = buf + "        int t = 0;\n"
    buf = buf + "        for (int c = lane; c < hd; c += 32) { Cb[c] = acc[t] * inv; t++; }\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* RANK-3 gate: opt-in 4-row j-unroll (only meaningful with fexp on). */\n"
    buf = buf + "static int _forge_attn_u4_on(void) {\n"
    buf = buf + "    const char* v = getenv(\"HEXA_ATTN_U4\");\n"
    buf = buf + "    return (v && v[0] && v[0] != '0') ? 1 : 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "/* farr_attn_dt_decode_batch_f32_gpu — S2 fused f32 flash-decode. q/K/V/ctx are\n"
    buf = buf + " * f32-resident (d_f32); s_id is unused (online-softmax needs no S scratch).\n"
    buf = buf + " * No f64 roundtrip, no per-step slab casts. hd<=256 (8 dims/lane cap). */\n"
    buf = buf + "int _hx_cuda_farr_attn_dt_decode_batch_f32_gpu(int64_t q_id, int64_t k_id,\n"
    buf = buf + "                                               int64_t v_id, int64_t s_id,\n"
    buf = buf + "                                               int64_t ctx_id, int64_t N,\n"
    buf = buf + "                                               int64_t Lrows, int64_t cap,\n"
    buf = buf + "                                               int64_t nh, int64_t nkv,\n"
    buf = buf + "                                               int64_t hd) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    (void)s_id;\n"
    buf = buf + "    if (N <= 0 || Lrows <= 0 || cap <= 0 || nh <= 0 || nkv <= 0 || hd <= 0) return -1;\n"
    buf = buf + "    if (hd > 256 || (hd & 31) != 0) { fprintf(stderr, \"[cuda] flash_f32: hd=%lld unsupported (need <=256, mult of 32)\\n\", (long long)hd); return -1; }\n"
    buf = buf + "    if (g_slots[q_id].d_f32 == NULL || g_slots[k_id].d_f32 == NULL ||\n"
    buf = buf + "        g_slots[v_id].d_f32 == NULL) { fprintf(stderr, \"[cuda] flash_f32: inputs not f32-resident\\n\"); return -1; }\n"
    buf = buf + "    int64_t nqd = N * nh * hd;\n"
    buf = buf + "    if (_ensure_d_f32(ctx_id, nqd) != 0) return -1;\n"
    buf = buf + "    static int _flash_f32_fired = 0;\n"
    buf = buf + "    if (!_flash_f32_fired) { _flash_f32_fired = 1;\n"
    buf = buf + "        fprintf(stderr, \"[ATTN-FLASH-F32-FIRED] fused warp-per-head online-softmax f32 flash-decode (S2 wall#2, no roundtrip/OOM)\\n\"); }\n"
    buf = buf + "    const float* Q = g_slots[q_id].d_f32;\n"
    buf = buf + "    const float* K = g_slots[k_id].d_f32;\n"
    buf = buf + "    const float* V = g_slots[v_id].d_f32;\n"
    buf = buf + "    float* C = g_slots[ctx_id].d_f32;\n"
    buf = buf + "    int64_t total = N * nh;\n"
    buf = buf + "    int wpb = 4; int block = wpb * 32;\n"
    buf = buf + "    int64_t nb = (total + wpb - 1) / wpb;\n"
    buf = buf + "    int grid = (int)(nb < 1 ? 1 : (nb > 65535 ? 65535 : nb));\n"
    buf = buf + "    if (_forge_attn_f32exp_on()) {\n"
    buf = buf + "        static int _flash_f32exp_fired = 0;\n"
    buf = buf + "        if (!_flash_f32exp_fired) { _flash_f32exp_fired = 1;\n"
    buf = buf + "            fprintf(stderr, \"[ATTN-FLASH-F32EXP-FIRED] fp32 __expf online softmax (RANK-1 gold-v2, opt-in HEXA_ATTN_F32EXP)\\n\"); }\n"
    buf = buf + "        if (_forge_attn_u4_on()) {\n"
    buf = buf + "            static int _flash_u4_fired = 0;\n"
    buf = buf + "            if (!_flash_u4_fired) { _flash_u4_fired = 1;\n"
    buf = buf + "                fprintf(stderr, \"[ATTN-FLASH-F32EXP-U4-FIRED] 4-row j-unroll, bit-identical to fexp (RANK-3, opt-in HEXA_ATTN_U4)\\n\"); }\n"
    buf = buf + "            _hx_cuda_kern_attn_flash_decode_batch_f32_fexp_u4<<<grid, block, 0, _forge_stream()>>>(Q, K, V, C, N, Lrows, cap, nh, nkv, hd);\n"
    buf = buf + "        } else {\n"
    buf = buf + "            _hx_cuda_kern_attn_flash_decode_batch_f32_fexp<<<grid, block, 0, _forge_stream()>>>(Q, K, V, C, N, Lrows, cap, nh, nkv, hd);\n"
    buf = buf + "        }\n"
    buf = buf + "    } else {\n"
    buf = buf + "        _hx_cuda_kern_attn_flash_decode_batch_f32<<<grid, block, 0, _forge_stream()>>>(Q, K, V, C, N, Lrows, cap, nh, nkv, hd);\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_forge_launch_check(\"attn_flash_f32\") != 0) return -1;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)q_id; (void)k_id; (void)v_id; (void)s_id; (void)ctx_id; (void)N;\n"
    buf = buf + "    (void)Lrows; (void)cap; (void)nh; (void)nkv; (void)hd; return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "/* mk2-C4-bwd (2026-05-19): GQA attention-dt bwd forge-route. 3-kernel\n"
    buf = buf + " * pipeline using a temporary dP_row[nh·T·T] scratch (reused as dS\n"
    buf = buf + " * after step 2). dQ/dK/dV must be FRESH t_zeros at the call site —\n"
    buf = buf + " * the tape replay in ag_tape.hexa allocates them with t_zeros and the\n"
    buf = buf + " * kernel writes acc directly (no read-modify-write). All outputs go\n"
    buf = buf + " * through _d2h_out → DEVICE_KEEP honoured. */\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "int _hx_cuda_farr_attn_dt_bwd_gpu(int64_t q_id, int64_t k_id, int64_t v_id,\n"
    buf = buf + "                                  int64_t p_id, int64_t dctx_id,\n"
    buf = buf + "                                  int64_t dq_id, int64_t dk_id, int64_t dv_id,\n"
    buf = buf + "                                  int64_t T, int64_t nh, int64_t nkv,\n"
    buf = buf + "                                  int64_t hd) {\n"
    buf = buf + "    if (q_id < 0 || k_id < 0 || v_id < 0 || p_id < 0 || dctx_id < 0 ||\n"
    buf = buf + "        dq_id < 0 || dk_id < 0 || dv_id < 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] attn_dt_bwd: bad ids\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (T <= 0 || nh <= 0 || nkv <= 0 || hd <= 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] attn_dt_bwd: bad dims T=%lld nh=%lld nkv=%lld hd=%lld\\n\",\n"
    buf = buf + "                (long long)T, (long long)nh, (long long)nkv, (long long)hd);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (nh % nkv != 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] attn_dt_bwd: nh not multiple of nkv\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (q_id >= _hx_farr_count || k_id >= _hx_farr_count ||\n"
    buf = buf + "        v_id >= _hx_farr_count || p_id >= _hx_farr_count ||\n"
    buf = buf + "        dctx_id >= _hx_farr_count || dq_id >= _hx_farr_count ||\n"
    buf = buf + "        dk_id >= _hx_farr_count || dv_id >= _hx_farr_count) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] attn_dt_bwd: id out of range\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    int64_t nq = T * nh  * hd;\n"
    buf = buf + "    int64_t nk = T * nkv * hd;\n"
    buf = buf + "    int64_t np = nh * T * T;\n"
    buf = buf + "    if (_hx_farr_table[q_id].len    < nq ||\n"
    buf = buf + "        _hx_farr_table[k_id].len    < nk ||\n"
    buf = buf + "        _hx_farr_table[v_id].len    < nk ||\n"
    buf = buf + "        _hx_farr_table[p_id].len    < np ||\n"
    buf = buf + "        _hx_farr_table[dctx_id].len < nq ||\n"
    buf = buf + "        _hx_farr_table[dq_id].len   < nq ||\n"
    buf = buf + "        _hx_farr_table[dk_id].len   < nk ||\n"
    buf = buf + "        _hx_farr_table[dv_id].len   < nk) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] attn_dt_bwd: host len mismatch\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_h2d(q_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(k_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(v_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(p_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(dctx_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_buf(dq_id, nq) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_buf(dk_id, nk) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_buf(dv_id, nk) != 0) return -1;\n"
    buf = buf + "    /* dP_row scratch (reused as dS after step 2) */\n"
    buf = buf + "    double* dProw = NULL;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    cudaError_t er = cudaMalloc(&dProw, (size_t)np * sizeof(double));\n"
    buf = buf + "    if (er != cudaSuccess) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] attn_dt_bwd: dProw malloc failed: %s\\n\",\n"
    buf = buf + "                cudaGetErrorString(er));\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    double* Q = g_slots[q_id].d_buf;\n"
    buf = buf + "    double* K = g_slots[k_id].d_buf;\n"
    buf = buf + "    double* V = g_slots[v_id].d_buf;\n"
    buf = buf + "    double* P = g_slots[p_id].d_buf;\n"
    buf = buf + "    double* dctx = g_slots[dctx_id].d_buf;\n"
    buf = buf + "    double* dQ = g_slots[dq_id].d_buf;\n"
    buf = buf + "    double* dK = g_slots[dk_id].d_buf;\n"
    buf = buf + "    double* dV = g_slots[dv_id].d_buf;\n"
    buf = buf + "    /* Step 1: dProw per (hh, i, j). nh·T·T threads. */\n"
    buf = buf + "    {\n"
    buf = buf + "        int64_t total = nh * T * T;\n"
    buf = buf + "        int block = 64;\n"
    buf = buf + "        int64_t need = (total + block - 1) / block;\n"
    buf = buf + "        int grid = (int)(need < 1 ? 1 : (need > 65535 ? 65535 : need));\n"
    buf = buf + "        _hx_cuda_kern_attn_dt_bwd_dProw<<<grid, block>>>(V, dctx, dProw,\n"
    buf = buf + "                                                         T, nh, nkv, hd);\n"
    buf = buf + "        er = cudaGetLastError();\n"
    buf = buf + "        if (er != cudaSuccess) {\n"
    buf = buf + "            fprintf(stderr, \"[cuda] attn_dt_bwd dProw kernel failed: %s\\n\",\n"
    buf = buf + "                    cudaGetErrorString(er));\n"
    buf = buf + "            cudaFree(dProw);\n"
    buf = buf + "            return -1;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    /* Step 2: dS in-place (overwrite dProw) + dQ. nh·T threads. */\n"
    buf = buf + "    {\n"
    buf = buf + "        int64_t total = nh * T;\n"
    buf = buf + "        int block = 64;\n"
    buf = buf + "        int64_t need = (total + block - 1) / block;\n"
    buf = buf + "        int grid = (int)(need < 1 ? 1 : (need > 65535 ? 65535 : need));\n"
    buf = buf + "        _hx_cuda_kern_attn_dt_bwd_dS_dQ<<<grid, block>>>(Q, K, P, dProw, dQ,\n"
    buf = buf + "                                                         T, nh, nkv, hd);\n"
    buf = buf + "        er = cudaGetLastError();\n"
    buf = buf + "        if (er != cudaSuccess) {\n"
    buf = buf + "            fprintf(stderr, \"[cuda] attn_dt_bwd dS+dQ kernel failed: %s\\n\",\n"
    buf = buf + "                    cudaGetErrorString(er));\n"
    buf = buf + "            cudaFree(dProw);\n"
    buf = buf + "            return -1;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    /* Step 3a: dV per (j, kvh, c). T·nkv·hd threads. */\n"
    buf = buf + "    {\n"
    buf = buf + "        int64_t total = T * nkv * hd;\n"
    buf = buf + "        int block = 64;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "        int64_t need = (total + block - 1) / block;\n"
    buf = buf + "        int grid = (int)(need < 1 ? 1 : (need > 65535 ? 65535 : need));\n"
    buf = buf + "        _hx_cuda_kern_attn_dt_bwd_dV<<<grid, block>>>(P, dctx, dV,\n"
    buf = buf + "                                                      T, nh, nkv, hd);\n"
    buf = buf + "        er = cudaGetLastError();\n"
    buf = buf + "        if (er != cudaSuccess) {\n"
    buf = buf + "            fprintf(stderr, \"[cuda] attn_dt_bwd dV kernel failed: %s\\n\",\n"
    buf = buf + "                    cudaGetErrorString(er));\n"
    buf = buf + "            cudaFree(dProw);\n"
    buf = buf + "            return -1;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    /* Step 3b: dK per (j, kvh, c). Same shape. */\n"
    buf = buf + "    {\n"
    buf = buf + "        int64_t total = T * nkv * hd;\n"
    buf = buf + "        int block = 64;\n"
    buf = buf + "        int64_t need = (total + block - 1) / block;\n"
    buf = buf + "        int grid = (int)(need < 1 ? 1 : (need > 65535 ? 65535 : need));\n"
    buf = buf + "        _hx_cuda_kern_attn_dt_bwd_dK<<<grid, block>>>(Q, dProw, dK,\n"
    buf = buf + "                                                      T, nh, nkv, hd);\n"
    buf = buf + "        er = cudaGetLastError();\n"
    buf = buf + "        if (er != cudaSuccess) {\n"
    buf = buf + "            fprintf(stderr, \"[cuda] attn_dt_bwd dK kernel failed: %s\\n\",\n"
    buf = buf + "                    cudaGetErrorString(er));\n"
    buf = buf + "            cudaFree(dProw);\n"
    buf = buf + "            return -1;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    cudaFree(dProw);\n"
    buf = buf + "    if (_d2h_out(dq_id, nq) != 0) return -1;\n"
    buf = buf + "    if (_d2h_out(dk_id, nk) != 0) return -1;\n"
    buf = buf + "    if (_d2h_out(dv_id, nk) != 0) return -1;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* mk2-C5: device-resident slice copy. Reads src[soff..soff+n) and\n"
    buf = buf + " * writes dst[doff..doff+n). DEVICE_KEEP honoured via _d2h_out. */\n"
    buf = buf + "int _hx_cuda_farr_copy_slice_gpu(int64_t src_id, int64_t soff,\n"
    buf = buf + "                                 int64_t dst_id, int64_t doff,\n"
    buf = buf + "                                 int64_t n) {\n"
    buf = buf + "    if (src_id < 0 || dst_id < 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] copy_slice: bad ids %lld %lld\\n\",\n"
    buf = buf + "                (long long)src_id, (long long)dst_id);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (n <= 0 || soff < 0 || doff < 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] copy_slice: bad n=%lld soff=%lld doff=%lld\\n\",\n"
    buf = buf + "                (long long)n, (long long)soff, (long long)doff);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    if (src_id >= _hx_farr_count || dst_id >= _hx_farr_count) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] copy_slice: id out of range\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    HexaFarrEntry* se = &_hx_farr_table[src_id];\n"
    buf = buf + "    HexaFarrEntry* de = &_hx_farr_table[dst_id];\n"
    buf = buf + "    if (se->len < soff + n || de->len < doff + n) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] copy_slice: range out of bounds\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_h2d(src_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_buf(dst_id, de->len) != 0) return -1;\n"
    buf = buf + "    const double* S = g_slots[src_id].d_buf;\n"
    buf = buf + "    double* D = g_slots[dst_id].d_buf;\n"
    buf = buf + "    /* Device-to-device cudaMemcpy is the canonical (and fastest) form\n"
    buf = buf + "     * for a contiguous slice — saturates HBM bandwidth, no kernel\n"
    buf = buf + "     * launch overhead per element. */\n"
    buf = buf + "    cudaError_t er = cudaMemcpy(D + doff, S + soff,\n"
    buf = buf + "                                (size_t)n * sizeof(double),\n"
    buf = buf + "                                cudaMemcpyDeviceToDevice);\n"
    buf = buf + "    if (er != cudaSuccess) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] copy_slice cudaMemcpy failed: %s\\n\",\n"
    buf = buf + "                cudaGetErrorString(er));\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    /* Mark dst as device-current; lazy-D2H handles host readback. */\n"
    buf = buf + "    if (_d2h_out(dst_id, de->len) != 0) return -1;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* mk2-C5: device-side dt_lcg fill (single thread sequential to match\n"
    buf = buf + " * the hexa nn_decoder_init / _train_fill_dt_lcg byte-eq exactly —\n"
    buf = buf + " * each value depends on the previous LCG state). int64_t modular\n"
    buf = buf + " * arithmetic is byte-identical to the hexa `(s * 1103515245 + 12345)\n"
    buf = buf + " * % 2^31`. ~100M elements/init × 25ns = ~2.5s on A100, vs ~10min on\n"
    buf = buf + " * host via HexaVal-box farr_set. The init runs once at startup,\n"
    buf = buf + " * before any forge ops fire — eliminating it is what lets the d768\n"
    buf = buf + " * trainer actually reach step 1. */\n"
    buf = buf + "__global__ void _hx_cuda_kern_fill_dt_lcg(double* __restrict__ dst,\n"
    buf = buf + "                                          int64_t off, int64_t n,\n"
    buf = buf + "                                          int64_t seed, double scale) {\n"
    buf = buf + "    if (blockIdx.x == 0 && threadIdx.x == 0) {\n"
    buf = buf + "        int64_t s = seed;\n"
    buf = buf + "        for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "            s = (s * (int64_t)1103515245 + (int64_t)12345) % (int64_t)2147483648;\n"
    buf = buf + "            double rv = (double)(s % 1000) / 1000.0 - 0.5;\n"
    buf = buf + "            dst[off + i] = rv * scale;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "int _hx_cuda_farr_fill_dt_lcg_gpu(int64_t dst_id, int64_t doff, int64_t n,\n"
    buf = buf + "                                  int64_t seed, double scale) {\n"
    buf = buf + "    /* IMPORTANT (mk2-FINAL #2 measured): the LCG state evolves\n"
    buf = buf + "     * sequentially (s_{i+1} = f(s_i)), so the kernel is necessarily\n"
    buf = buf + "     * single-thread. A GPU thread runs ~100ns/iter — 20× slower than\n"
    buf = buf + "     * a host C loop (~5ns/iter). For ~100M elements per nn_decoder_\n"
    buf = buf + "     * init, that's 10s/call on GPU vs 0.5s/call on CPU; 121 calls\n"
    buf = buf + "     * blew the 901s budget on the v6 fire (GPU 100% util, never\n"
    buf = buf + "     * reached step 1). Switch to host-side fill: the next forge op\n"
    buf = buf + "     * (`farr_copy_slice_gpu(M, oTE, tokE, …)` in _agt_decoder_step)\n"
    buf = buf + "     * triggers _h2d on M as a side-effect of the host-write path\n"
    buf = buf + "     * marking dirty_host=1, so the data lands on device exactly once\n"
    buf = buf + "     * per farr, lazily, when it's actually needed. */\n"
    buf = buf + "    if (dst_id < 0 || dst_id >= _hx_farr_count) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] fill_dt_lcg: bad id\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (n <= 0 || doff < 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] fill_dt_lcg: bad n=%lld doff=%lld\\n\",\n"
    buf = buf + "                (long long)n, (long long)doff);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    HexaFarrEntry* de = &_hx_farr_table[dst_id];\n"
    buf = buf + "    if (!de->buf || de->len < doff + n) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] fill_dt_lcg: range out of bounds\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    /* Pure C host loop — int64_t modular arithmetic byte-identical\n"
    buf = buf + "     * to the hexa source (`(s * 1103515245 + 12345) % 2^31`). */\n"
    buf = buf + "    int64_t s = seed;\n"
    buf = buf + "    double* H = de->buf + doff;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        s = (s * (int64_t)1103515245 + (int64_t)12345) % (int64_t)2147483648;\n"
    buf = buf + "        double rv = (double)(s % 1000) / 1000.0 - 0.5;\n"
    buf = buf + "        H[i] = rv * scale;\n"
    buf = buf + "    }\n"
    buf = buf + "    /* Mark host-fresh; the next _h2d uploads the new bytes. Do NOT\n"
    buf = buf + "     * call _d2h_out here — we want the host buffer to be the source\n"
    buf = buf + "     * of truth, not the device. */\n"
    buf = buf + "    de->loc        = FARR_HOST;\n"
    buf = buf + "    de->dirty_host = 1;\n"
    buf = buf + "    de->dirty_dev  = 0;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* mk2-C5: device in-place elementwise add dst[i] += src[i] for i ∈\n"
    buf = buf + " * [0..n). Used by the gradient accumulator (Mg_acc += Mg across the\n"
    buf = buf + " * micro-batch samples). No FMA-contraction concern — a single\n"
    buf = buf + " * __dadd_rn per element, byte-eq with host `dst + src` under\n"
    buf = buf + " * FP_CONTRACT OFF. */\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "__global__ void _hx_cuda_kern_add_inplace(double* __restrict__ dst,\n"
    buf = buf + "                                          const double* __restrict__ src,\n"
    buf = buf + "                                          int64_t n) {\n"
    buf = buf + "    int64_t i      = (int64_t)blockIdx.x * (int64_t)blockDim.x + (int64_t)threadIdx.x;\n"
    buf = buf + "    int64_t stride = (int64_t)gridDim.x  * (int64_t)blockDim.x;\n"
    buf = buf + "    for (; i < n; i += stride) {\n"
    buf = buf + "        dst[i] = __dadd_rn(dst[i], src[i]);\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "int _hx_cuda_farr_add_inplace_gpu(int64_t dst_id, int64_t src_id, int64_t n) {\n"
    buf = buf + "    if (dst_id < 0 || src_id < 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] add_inplace: bad ids\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (n <= 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] add_inplace: bad n=%lld\\n\", (long long)n);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (dst_id >= _hx_farr_count || src_id >= _hx_farr_count) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] add_inplace: id out of range\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    HexaFarrEntry* de = &_hx_farr_table[dst_id];\n"
    buf = buf + "    HexaFarrEntry* se = &_hx_farr_table[src_id];\n"
    buf = buf + "    if (de->len < n || se->len < n) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] add_inplace: range out of bounds\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_h2d(dst_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(src_id) != 0) return -1;\n"
    buf = buf + "    double* D = g_slots[dst_id].d_buf;\n"
    buf = buf + "    const double* S = g_slots[src_id].d_buf;\n"
    buf = buf + "    int block = 256;\n"
    buf = buf + "    int64_t need = (n + block - 1) / block;\n"
    buf = buf + "    int grid = (int)(need < 1 ? 1 : (need > 65535 ? 65535 : need));\n"
    buf = buf + "    _hx_cuda_kern_add_inplace<<<grid, block, 0, _forge_stream()>>>(D, S, n);\n"
    buf = buf + "    if (_forge_launch_check(\"add_inplace\") != 0) return -1;\n"
    buf = buf + "    if (_d2h_out(dst_id, de->len) != 0) return -1;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* mk2-C5: device zero-fill of dst[doff..doff+n). Used to clear MgOut\n"
    buf = buf + " * at the top of each grad-gather postlude (~100M-double memset). */\n"
    buf = buf + "int _hx_cuda_farr_zero_slice_gpu(int64_t dst_id, int64_t doff, int64_t n) {\n"
    buf = buf + "    if (dst_id < 0 || dst_id >= _hx_farr_count) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] zero_slice: bad id %lld\\n\", (long long)dst_id);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (n <= 0 || doff < 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] zero_slice: bad n=%lld doff=%lld\\n\",\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "                (long long)n, (long long)doff);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    HexaFarrEntry* de = &_hx_farr_table[dst_id];\n"
    buf = buf + "    if (de->len < doff + n) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] zero_slice: range out of bounds\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_ensure_dev_buf(dst_id, de->len) != 0) return -1;\n"
    buf = buf + "    double* D = g_slots[dst_id].d_buf;\n"
    buf = buf + "    cudaError_t er = cudaMemset(D + doff, 0, (size_t)n * sizeof(double));\n"
    buf = buf + "    if (er != cudaSuccess) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] zero_slice cudaMemset failed: %s\\n\",\n"
    buf = buf + "                cudaGetErrorString(er));\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_d2h_out(dst_id, de->len) != 0) return -1;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* mk2-C5: device-resident 2-D transpose (dst[c·d_out + r] = src[soff +\n"
    buf = buf + " * r·d_in + c]), byte-eq with agt_wT_slice / agt_wT_off host loop. */\n"
    buf = buf + "int _hx_cuda_farr_transpose_2d_gpu(int64_t src_id, int64_t soff,\n"
    buf = buf + "                                   int64_t dst_id, int64_t doff,\n"
    buf = buf + "                                   int64_t d_out, int64_t d_in) {\n"
    buf = buf + "    if (src_id < 0 || dst_id < 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] transpose_2d: bad ids\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (d_out <= 0 || d_in <= 0 || soff < 0 || doff < 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] transpose_2d: bad dims\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (src_id >= _hx_farr_count || dst_id >= _hx_farr_count) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] transpose_2d: id out of range\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    HexaFarrEntry* se = &_hx_farr_table[src_id];\n"
    buf = buf + "    HexaFarrEntry* de = &_hx_farr_table[dst_id];\n"
    buf = buf + "    int64_t total = d_out * d_in;\n"
    buf = buf + "    if (se->len < soff + total || de->len < doff + total) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] transpose_2d: range out of bounds\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_h2d(src_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_buf(dst_id, de->len) != 0) return -1;\n"
    buf = buf + "    const double* S = g_slots[src_id].d_buf;\n"
    buf = buf + "    double* D = g_slots[dst_id].d_buf;\n"
    buf = buf + "    int block = 256;\n"
    buf = buf + "    int64_t need = (total + block - 1) / block;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    int grid = (int)(need < 1 ? 1 : (need > 65535 ? 65535 : need));\n"
    buf = buf + "    _hx_cuda_kern_transpose_2d<<<grid, block, 0, _forge_stream()>>>(S, soff, D, doff, d_out, d_in);\n"
    buf = buf + "    if (_forge_launch_check(\"transpose_2d\") != 0) return -1;\n"
    buf = buf + "    if (_d2h_out(dst_id, de->len) != 0) return -1;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ── flame spiking STDP pair-based GPU kernel ───────────────────────\n"
    buf = buf + " * inbox/patches/flame-stdp-pair-gpu-kernel.md (anima LEGO arc §141).\n"
    buf = buf + " * One thread per (i, j) weight cell on an N×N grid. Output bytes\n"
    buf = buf + " * match the CPU oracle spiking_lib.hexa::flame_stdp_pair exactly —\n"
    buf = buf + " * single-precision-free scalar fp64 arithmetic, no fma/__dmul_rn\n"
    buf = buf + " * substitution, same (ltp - ltd) subtraction order, same diagonal\n"
    buf = buf + " * passthrough + clip. F-STDP-GPU-1 / -2 / -3 are enforced by\n"
    buf = buf + " * construction. F-STDP-GPU-4 (scale speedup) is a fire-time measure-\n"
    buf = buf + " * ment gate, not a construction-time invariant. */\n"
    buf = buf + "__global__ void _hx_cuda_kern_stdp_pair(const double* __restrict__ W,\n"
    buf = buf + "                                        const double* __restrict__ tr_pre,\n"
    buf = buf + "                                        const double* __restrict__ tr_post,\n"
    buf = buf + "                                        const double* __restrict__ spike,\n"
    buf = buf + "                                        double* __restrict__ out,\n"
    buf = buf + "                                        int64_t n,\n"
    buf = buf + "                                        double A_plus, double A_minus,\n"
    buf = buf + "                                        double w_max) {\n"
    buf = buf + "    int64_t i = (int64_t)blockIdx.y * (int64_t)blockDim.y + (int64_t)threadIdx.y;\n"
    buf = buf + "    int64_t j = (int64_t)blockIdx.x * (int64_t)blockDim.x + (int64_t)threadIdx.x;\n"
    buf = buf + "    if (i >= n || j >= n) return;\n"
    buf = buf + "    int64_t idx = i * n + j;\n"
    buf = buf + "    double  w_ij = W[idx];\n"
    buf = buf + "    double  wd;\n"
    buf = buf + "    if (i == j) {\n"
    buf = buf + "        wd = w_ij;\n"
    buf = buf + "    } else {\n"
    buf = buf + "        /* IMPORTANT — fma-free byte-equality with the CPU oracle.\n"
    buf = buf + "         * nvcc auto-fuses `a*b + c` into __fma_rn by default; this would\n"
    buf = buf + "         * silently diverge from the CPU loop (single-precision-free fp64\n"
    buf = buf + "         * mul-then-add). Use __dmul_rn / __dadd_rn / __dsub_rn so each\n"
    buf = buf + "         * scalar op rounds at IEEE-754 round-to-nearest in isolation,\n"
    buf = buf + "         * matching the host scalar order in spiking_lib.hexa\n"
    buf = buf + "         * flame_stdp_pair exactly. See feedback memory\n"
    buf = buf + "         * flame_transcendental_byteeq_hazard.md mechanism (3). */\n"
    buf = buf + "        double s_i      = spike[i];\n"
    buf = buf + "        double trpost_i = tr_post[i];\n"
    buf = buf + "        double tmp1     = __dmul_rn(A_plus,  s_i);\n"
    buf = buf + "        double ltp      = __dmul_rn(tmp1,    tr_pre[j]);\n"
    buf = buf + "        double tmp2     = __dmul_rn(A_minus, trpost_i);\n"
    buf = buf + "        double ltd      = __dmul_rn(tmp2,    spike[j]);\n"
    buf = buf + "        double dlt      = __dsub_rn(ltp, ltd);\n"
    buf = buf + "        wd              = __dadd_rn(w_ij, dlt);\n"
    buf = buf + "    }\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    double neg_w_max = 0.0 - w_max;\n"
    buf = buf + "    if (wd > w_max)     wd = w_max;\n"
    buf = buf + "    if (wd < neg_w_max) wd = neg_w_max;\n"
    buf = buf + "    out[idx] = wd;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "int _hx_cuda_farr_stdp_pair_gpu(int64_t W_id, int64_t tr_pre_id,\n"
    buf = buf + "                                int64_t tr_post_id, int64_t spike_id,\n"
    buf = buf + "                                int64_t out_id, int64_t n,\n"
    buf = buf + "                                double A_plus, double A_minus,\n"
    buf = buf + "                                double w_max) {\n"
    buf = buf + "    if (W_id < 0 || tr_pre_id < 0 || tr_post_id < 0 ||\n"
    buf = buf + "        spike_id < 0 || out_id < 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] stdp_pair: bad ids\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (n <= 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] stdp_pair: bad n=%lld\\n\", (long long)n);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (W_id      >= _hx_farr_count || tr_pre_id >= _hx_farr_count ||\n"
    buf = buf + "        tr_post_id>= _hx_farr_count || spike_id  >= _hx_farr_count ||\n"
    buf = buf + "        out_id    >= _hx_farr_count) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] stdp_pair: id out of range\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    int64_t nn = n * n;\n"
    buf = buf + "    if (_hx_farr_table[W_id].len      < nn ||\n"
    buf = buf + "        _hx_farr_table[tr_pre_id].len < n  ||\n"
    buf = buf + "        _hx_farr_table[tr_post_id].len< n  ||\n"
    buf = buf + "        _hx_farr_table[spike_id].len  < n  ||\n"
    buf = buf + "        _hx_farr_table[out_id].len    < nn) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] stdp_pair: host len mismatch\\n\");\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_h2d(W_id) != 0)       return -1;\n"
    buf = buf + "    if (_h2d(tr_pre_id) != 0)  return -1;\n"
    buf = buf + "    if (_h2d(tr_post_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(spike_id) != 0)   return -1;\n"
    buf = buf + "    if (_ensure_dev_buf(out_id, nn) != 0) return -1;\n"
    buf = buf + "    const double* W      = g_slots[W_id].d_buf;\n"
    buf = buf + "    const double* tr_pre = g_slots[tr_pre_id].d_buf;\n"
    buf = buf + "    const double* tr_post= g_slots[tr_post_id].d_buf;\n"
    buf = buf + "    const double* spike  = g_slots[spike_id].d_buf;\n"
    buf = buf + "    double*       out    = g_slots[out_id].d_buf;\n"
    buf = buf + "    /* 2D grid, 16×16 block — one thread per (i,j) cell. Cap each grid\n"
    buf = buf + "     * dim at 65535 (legacy CUDA 1-D grid ceiling we use elsewhere); at\n"
    buf = buf + "     * block=16 that covers N up to 16·65535 = 1,048,560 per dim, well\n"
    buf = buf + "     * past the LEGO arc target (N≤16k). */\n"
    buf = buf + "    int block_dim = 16;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    int64_t need = (n + block_dim - 1) / block_dim;\n"
    buf = buf + "    int grid_dim = (int)(need < 1 ? 1 : (need > 65535 ? 65535 : need));\n"
    buf = buf + "    dim3 block(block_dim, block_dim, 1);\n"
    buf = buf + "    dim3 grid(grid_dim, grid_dim, 1);\n"
    buf = buf + "    _hx_cuda_kern_stdp_pair<<<grid, block>>>(W, tr_pre, tr_post, spike,\n"
    buf = buf + "                                             out, n, A_plus, A_minus, w_max);\n"
    buf = buf + "    cudaError_t er = cudaGetLastError();\n"
    buf = buf + "    if (er != cudaSuccess) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] stdp_pair launch failed: %s\\n\",\n"
    buf = buf + "                cudaGetErrorString(er));\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_d2h_out(out_id, nn) != 0) return -1;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "\n"
    buf = buf + "#endif /* HEXA_CUDA — Agent #25 Phase B elementwise block (opened at line 944) */\n"
    buf = buf + "\n"
    buf = buf + "#ifdef __cplusplus\n"
    buf = buf + "}  /* extern \"C\" */\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "/* ════════════════════════════════════════════════════════════════════\n"
    buf = buf + " * forge RFC 049 Stage 2 — BF16 mixed-precision substrate.\n"
    buf = buf + " *\n"
    buf = buf + " * The `farr_bf16` storage class + `*_bf16_gpu` kernel entry points live\n"
    buf = buf + " * in the sibling TU runtime_bf16.c. It is `#include`d here (not compiled\n"
    buf = buf + " * separately) so the BF16 tier shares this file's single `nvcc -x cu`\n"
    buf = buf + " * build — the same way the FP64 substrate above is one TU. runtime_bf16.c\n"
    buf = buf + " * carries its own `extern \"C\"` + `#include` guards and gates every\n"
    buf = buf + " * CUDA-only line behind `#ifdef HEXA_CUDA`, so on a no-CUDA host it\n"
    buf = buf + " * `cc -fsyntax-only`s clean as plain C.\n"
    buf = buf + " *\n"
    buf = buf + " * Stage 2 status: storage-class + kernel-entry SCAFFOLD. The Stage 1\n"
    buf = buf + " * BF16 fused FFN kernel is already MEASURED PASS (9.67x FP64 cuBLAS,\n"
    buf = buf + " * self/cuda/experiments/r049_bf16_fused_ffn.cu); the production kernel\n"
    buf = buf + " * fire-validation is a follow-up cost-bearing cycle.\n"
    buf = buf + " * ════════════════════════════════════════════════════════════════════ */\n"
    buf = buf + "#include \"runtime_bf16.c\"\n"
    if buf.len() > 0 { _flush_runtime_cuda(out_path, buf) }
}

fn main() {
    let argv = real_args()
    let out_path = if argv.len() >= 1 { argv[0] } else { "runtime_cuda.c" }
    emit_runtime_cuda_to(out_path)
    let exists_check = exec("[ -f \"" + out_path + "\" ] && echo y || echo n").trim()
    if exists_check != "y" {
        println("[runtime_cuda_emit] FATAL: failed to write " + out_path)
        exit(1)
    }
    println("[runtime_cuda_emit] wrote " + out_path)
    exit(0)
}
