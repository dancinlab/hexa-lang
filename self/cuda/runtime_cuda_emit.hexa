    buf = buf + "    _hx_k_rmsnorm_bwd<<<1, block_sz, 0, _forge_stream()>>>(X, G, XN, inv, DY, DX, DG, d);\n"
    buf = buf + "    if (_forge_launch_check(\"rmsnorm_bwd\") != 0) return -1;\n"
    buf = buf + "    {\n"
    buf = buf + "        int64_t outs[2] = { dx_id, dg_id };\n"
    buf = buf + "        for (int k = 0; k < 2; k++) {\n"
    buf = buf + "            HexaFarrEntry* e = &_hx_farr_table[outs[k]];\n"
    buf = buf + "            e->d_buf      = (void*)g_slots[outs[k]].d_buf;\n"
    buf = buf + "            e->loc        = FARR_DEVICE;\n"
    buf = buf + "            e->dirty_host = 0;\n"
    buf = buf + "            e->dirty_dev  = 0;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)x_id; (void)g_id; (void)xn_id; (void)inv; (void)dy_id; (void)dx_id; (void)dg_id; (void)d;\n"
    buf = buf + "    fprintf(stderr, \"[cuda] rmsnorm_bwd: built without __CUDACC__\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "/* HEXA-FUSION L3 (LLM-path ATTN FWD glue half) — device-resident GQA\n"
    buf = buf + " * attention-core forward. Reproduces stdlib/flame/nn_lib.hexa\n"
    buf = buf + " * nn_attn_core_fwd EXACTLY:\n"
    buf = buf + " *   scale = 1/sqrt(hd)   [libm sqrt — the bare `sqrt` builtin the host\n"
    buf = buf + " *     softmax scale uses; sqrt(double) is IEEE correctly-rounded == device\n"
    buf = buf + " *     sqrt, NOT dt_sqrt/Newton, so bit-identical]\n"
    buf = buf + " *   scores[j] = Σ_c Q[i,hh,c]·K[j,kvh,c]·scale   (SEQUENTIAL over c)\n"
    buf = buf + " *   causal softmax over scores[0..L]: m=max, e=_hx_dt_exp_dev(s−m),\n"
    buf = buf + " *     P[hh,i,j]=e/Σe   (F-OP19: the host _nn_softmax_row migrated libm\n"
    buf = buf + " *     exp → dt_exp, so this device _hx_dt_exp_dev twin is bit-exact —\n"
    buf = buf + " *     the reason the FWD seam is no longer DEFERRED)\n"
    buf = buf + " *   ctx[i,hh,c] = Σ_j P[hh,i,j]·V[j,kvh,c]\n"
    buf = buf + " * BYTE-EQ DISCIPLINE: the ENTIRE kernel runs on ONE thread (thread 0 of a\n"
    buf = buf + " * single block) replaying the host loop nest verbatim — NO atomics, NO\n"
    buf = buf + " * tree re-assoc, NO parallel partials. srow is per-(hh,i) scratch in a\n"
    buf = buf + " * fixed-size stack array. Every mul-into-add uses __dmul_rn/__dadd_rn to\n"
    buf = buf + " * defeat nvcc FMA contraction (host FP_CONTRACT OFF) → max|Δ|=0. P_out/\n"
    buf = buf + " * ctx_out are WRITTEN (caller pre-zeros the causal j>i region). Keeps\n"
    buf = buf + " * P_out/ctx_out FARR_DEVICE. no-CUDA → -1 → host nn_attn_core_fwd (byte-eq). */\n"
    buf = buf + "__global__ void _hx_k_attn_core_fwd(const double* __restrict__ Q,\n"
    buf = buf + "                                    const double* __restrict__ K,\n"
    buf = buf + "                                    const double* __restrict__ V,\n"
    buf = buf + "                                    double* __restrict__ P,\n"
    buf = buf + "                                    double* __restrict__ ctx,\n"
    buf = buf + "                                    int64_t T, int64_t nh,\n"
    buf = buf + "                                    int64_t nkv, int64_t hd) {\n"
    buf = buf + "    if (threadIdx.x != 0 || blockIdx.x != 0) return;\n"
    buf = buf + "    int64_t n_rep = nh / nkv;\n"
    buf = buf + "    int64_t d     = nh * hd;\n"
    buf = buf + "    double  scale = 1.0 / sqrt((double)hd);\n"
    buf = buf + "    for (int64_t hh = 0; hh < nh; hh++) {\n"
    buf = buf + "        int64_t kvh = hh / n_rep;\n"
    buf = buf + "        for (int64_t i = 0; i < T; i++) {\n"
    buf = buf + "            int64_t L = i + 1;\n"
    buf = buf + "            int64_t base = (hh*T + i)*T;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "            /* scores[j] = Σ_c Q·K·scale, stashed into P[base + j]. */\n"
    buf = buf + "            for (int64_t j = 0; j < L; j++) {\n"
    buf = buf + "                double dot = 0.0;\n"
    buf = buf + "                for (int64_t c = 0; c < hd; c++) {\n"
    buf = buf + "                    dot = __dadd_rn(dot, __dmul_rn(Q[(i*nh + hh)*hd + c],\n"
    buf = buf + "                                                  K[(j*nkv + kvh)*hd + c]));\n"
    buf = buf + "                }\n"
    buf = buf + "                P[base + j] = __dmul_rn(dot, scale);\n"
    buf = buf + "            }\n"
    buf = buf + "            /* causal softmax over P[base + 0..L]: m=max, e=dt_exp(s−m). */\n"
    buf = buf + "            double m = P[base];\n"
    buf = buf + "            for (int64_t i1 = 1; i1 < L; i1++) { if (P[base + i1] > m) m = P[base + i1]; }\n"
    buf = buf + "            double tot = 0.0;\n"
    buf = buf + "            for (int64_t i2 = 0; i2 < L; i2++) {\n"
    buf = buf + "                double e = _hx_dt_exp_dev(P[base + i2] - m);\n"
    buf = buf + "                P[base + i2] = e;\n"
    buf = buf + "                tot = __dadd_rn(tot, e);\n"
    buf = buf + "            }\n"
    buf = buf + "            for (int64_t i3 = 0; i3 < L; i3++) {\n"
    buf = buf + "                P[base + i3] = P[base + i3] / tot;\n"
    buf = buf + "            }\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "            /* ctx[i,hh,c] = Σ_j P·V. */\n"
    buf = buf + "            for (int64_t c2 = 0; c2 < hd; c2++) {\n"
    buf = buf + "                double acc = 0.0;\n"
    buf = buf + "                for (int64_t jj = 0; jj < L; jj++) {\n"
    buf = buf + "                    acc = __dadd_rn(acc, __dmul_rn(P[base + jj],\n"
    buf = buf + "                                                  V[(jj*nkv + kvh)*hd + c2]));\n"
    buf = buf + "                }\n"
    buf = buf + "                ctx[i*d + hh*hd + c2] = acc;\n"
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "int _hx_cuda_farr_attn_core_fwd_gpu(int64_t Q_id, int64_t K_id, int64_t V_id,\n"
    buf = buf + "                                    int64_t P_id, int64_t ctx_id, int64_t T,\n"
    buf = buf + "                                    int64_t nh, int64_t nkv, int64_t hd) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (T <= 0 || nh <= 0 || nkv <= 0 || hd <= 0 || (nh % nkv) != 0) return -1;\n"
    buf = buf + "    if (_h2d(Q_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(K_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(V_id) != 0) return -1;\n"
    buf = buf + "    /* P_out/ctx_out are WRITTEN in place (caller pre-zeroed the causal j>i\n"
    buf = buf + "     * region); allocate device buffers of the exact output extent. */\n"
    buf = buf + "    if (_ensure_dev_alloc_out(P_id, nh * T * T) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(ctx_id, T * nh * hd) != 0) return -1;\n"
    buf = buf + "    const double* Q   = g_slots[Q_id].d_buf;\n"
    buf = buf + "    const double* K   = g_slots[K_id].d_buf;\n"
    buf = buf + "    const double* V   = g_slots[V_id].d_buf;\n"
    buf = buf + "    double*       P   = g_slots[P_id].d_buf;\n"
    buf = buf + "    double*       ctx = g_slots[ctx_id].d_buf;\n"
    buf = buf + "    int block_sz = 256;\n"
    buf = buf + "    _hx_k_attn_core_fwd<<<1, block_sz, 0, _forge_stream()>>>(Q, K, V, P, ctx,\n"
    buf = buf + "                                                            T, nh, nkv, hd);\n"
    buf = buf + "    if (_forge_launch_check(\"attn_core_fwd\") != 0) return -1;\n"
    buf = buf + "    {\n"
    buf = buf + "        int64_t outs[2] = { P_id, ctx_id };\n"
    buf = buf + "        for (int k = 0; k < 2; k++) {\n"
    buf = buf + "            HexaFarrEntry* e = &_hx_farr_table[outs[k]];\n"
    buf = buf + "            e->d_buf      = (void*)g_slots[outs[k]].d_buf;\n"
    buf = buf + "            e->loc        = FARR_DEVICE;\n"
    buf = buf + "            e->dirty_host = 0;\n"
    buf = buf + "            e->dirty_dev  = 0;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)Q_id; (void)K_id; (void)V_id; (void)P_id; (void)ctx_id;\n"
    buf = buf + "    (void)T; (void)nh; (void)nkv; (void)hd;\n"
    buf = buf + "    fprintf(stderr, \"[cuda] attn_core_fwd: built without __CUDACC__\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "/* HEXA-FUSION L3 (LLM-path ATTN BWD glue half) — device-resident GQA\n"
    buf = buf + " * attention-core backward. Reproduces stdlib/flame/nn_lib.hexa\n"
    buf = buf + " * nn_attn_core_bwd EXACTLY (closed vjp, d5_attn_bwd):\n"
    buf = buf + " *   scale = 1/sqrt(hd)   [libm sqrt — the bare `sqrt` builtin the host\n"
    buf = buf + " *     softmax scale uses; sqrt(double) is IEEE correctly-rounded == device\n"
    buf = buf + " *     sqrt, NOT dt_sqrt/Newton, so bit-identical]\n"
    buf = buf + " *   dP_row[j] = Σ_c dctx[i,hh,c]·V[j,kvh,c]  (SEQUENTIAL over c)\n"
    buf = buf + " *   sdot      = Σ_j P[hh,i,j]·dP_row[j]\n"
    buf = buf + " *   dV[j,kvh,c] += P[hh,i,j]·dctx[i,hh,c]         (accum over hh,i)\n"
    buf = buf + " *   dS = P[hh,i,j]·(dP_row[j] − sdot)·scale\n"
    buf = buf + " *   dQ[i,hh,c] += Σ_j dS·K[j,kvh,c] ; dK[j,kvh,c] += Σ_i dS·Q[i,hh,c]\n"
    buf = buf + " * NO exp / transcendental on the bwd path (the softmax Jacobian is closed\n"
    buf = buf + " * in P). BYTE-EQ DISCIPLINE: the cross-head dV/dK accumulation is byte-eq\n"
    buf = buf + " * ONLY in the host (hh→i→j→c) order, so the ENTIRE kernel runs on ONE\n"
    buf = buf + " * thread (thread 0 of a single block) — NO atomics, NO tree re-assoc, NO\n"
    buf = buf + " * parallel partials — replaying the host loop nest verbatim. dP_row is\n"
    buf = buf + " * RECOMPUTED where the host reads its scratch (Σ_c is deterministic →\n"
    buf = buf + " * bit-identical bits, no device scratch needed). Every mul-into-add/sub\n"
    buf = buf + " * uses __dmul_rn/__dadd_rn/__dsub_rn to defeat nvcc FMA contraction (host\n"
    buf = buf + " * FP_CONTRACT OFF) → max|Δ|=0. dQ/dK/dV ACCUMULATE INTO the caller-zeroed\n"
    buf = buf + " * buffers (uploaded via _h2d first). Keeps dQ/dK/dV FARR_DEVICE.\n"
    buf = buf + " * no-CUDA → -1 → host nn_attn_core_bwd (byte-eq). */\n"
    buf = buf + "__global__ void _hx_k_attn_core_bwd(const double* __restrict__ Q,\n"
    buf = buf + "                                    const double* __restrict__ K,\n"
    buf = buf + "                                    const double* __restrict__ V,\n"
    buf = buf + "                                    const double* __restrict__ P,\n"
    buf = buf + "                                    const double* __restrict__ dctx,\n"
    buf = buf + "                                    double* __restrict__ dQ,\n"
    buf = buf + "                                    double* __restrict__ dK,\n"
    buf = buf + "                                    double* __restrict__ dV,\n"
    buf = buf + "                                    int64_t T, int64_t nh,\n"
    buf = buf + "                                    int64_t nkv, int64_t hd) {\n"
    buf = buf + "    if (threadIdx.x != 0 || blockIdx.x != 0) return;\n"
    buf = buf + "    int64_t n_rep = nh / nkv;\n"
    buf = buf + "    int64_t d     = nh * hd;\n"
    buf = buf + "    double  scale = 1.0 / sqrt((double)hd);\n"
    buf = buf + "    for (int64_t hh = 0; hh < nh; hh++) {\n"
    buf = buf + "        int64_t kvh = hh / n_rep;\n"
    buf = buf + "        for (int64_t i = 0; i < T; i++) {\n"
    buf = buf + "            int64_t L = i + 1;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "            /* sdot = Σ_j P·dP_row[j] ; dP_row[j]=Σ_c dctx·V (recomputed). */\n"
    buf = buf + "            double sdot = 0.0;\n"
    buf = buf + "            for (int64_t j = 0; j < L; j++) {\n"
    buf = buf + "                double acc = 0.0;\n"
    buf = buf + "                for (int64_t c = 0; c < hd; c++) {\n"
    buf = buf + "                    acc = __dadd_rn(acc, __dmul_rn(dctx[i*d + hh*hd + c],\n"
    buf = buf + "                                                  V[(j*nkv + kvh)*hd + c]));\n"
    buf = buf + "                }\n"
    buf = buf + "                sdot = __dadd_rn(sdot, __dmul_rn(P[(hh*T + i)*T + j], acc));\n"
    buf = buf + "            }\n"
    buf = buf + "            /* dV[j,kvh,c] += P·dctx  (accumulate, host hh→i→j→c order). */\n"
    buf = buf + "            for (int64_t j3 = 0; j3 < L; j3++) {\n"
    buf = buf + "                double pij = P[(hh*T + i)*T + j3];\n"
    buf = buf + "                for (int64_t c = 0; c < hd; c++) {\n"
    buf = buf + "                    int64_t dv_idx = (j3*nkv + kvh)*hd + c;\n"
    buf = buf + "                    dV[dv_idx] = __dadd_rn(dV[dv_idx],\n"
    buf = buf + "                                          __dmul_rn(pij, dctx[i*d + hh*hd + c]));\n"
    buf = buf + "                }\n"
    buf = buf + "            }\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "            /* dS = P·(dP_row − sdot)·scale ; dQ += dS·K ; dK += dS·Q. */\n"
    buf = buf + "            for (int64_t j4 = 0; j4 < L; j4++) {\n"
    buf = buf + "                double acc = 0.0;\n"
    buf = buf + "                for (int64_t c = 0; c < hd; c++) {\n"
    buf = buf + "                    acc = __dadd_rn(acc, __dmul_rn(dctx[i*d + hh*hd + c],\n"
    buf = buf + "                                                  V[(j4*nkv + kvh)*hd + c]));\n"
    buf = buf + "                }\n"
    buf = buf + "                double dS = __dmul_rn(__dmul_rn(P[(hh*T + i)*T + j4],\n"
    buf = buf + "                                                __dsub_rn(acc, sdot)), scale);\n"
    buf = buf + "                for (int64_t c2 = 0; c2 < hd; c2++) {\n"
    buf = buf + "                    int64_t dq_idx = (i*nh + hh)*hd + c2;\n"
    buf = buf + "                    int64_t dk_idx = (j4*nkv + kvh)*hd + c2;\n"
    buf = buf + "                    dQ[dq_idx] = __dadd_rn(dQ[dq_idx],\n"
    buf = buf + "                                          __dmul_rn(dS, K[(j4*nkv + kvh)*hd + c2]));\n"
    buf = buf + "                    dK[dk_idx] = __dadd_rn(dK[dk_idx],\n"
    buf = buf + "                                          __dmul_rn(dS, Q[(i*nh + hh)*hd + c2]));\n"
    buf = buf + "                }\n"
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "int _hx_cuda_farr_attn_core_bwd_gpu(int64_t Q_id, int64_t K_id, int64_t V_id,\n"
    buf = buf + "                                    int64_t P_id, int64_t dctx_id, int64_t dQ_id,\n"
    buf = buf + "                                    int64_t dK_id, int64_t dV_id, int64_t T,\n"
    buf = buf + "                                    int64_t nh, int64_t nkv, int64_t hd) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (T <= 0 || nh <= 0 || nkv <= 0 || hd <= 0 || (nh % nkv) != 0) return -1;\n"
    buf = buf + "    if (_h2d(Q_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(K_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(V_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(P_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(dctx_id) != 0) return -1;\n"
    buf = buf + "    /* dQ/dK/dV ACCUMULATE INTO caller-zeroed buffers — upload their current\n"
    buf = buf + "     * (zeroed) contents so the kernel adds onto the same base as the host\n"
    buf = buf + "     * reference (NOT _ensure_dev_alloc_out, which leaves garbage). */\n"
    buf = buf + "    if (_h2d(dQ_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(dK_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(dV_id) != 0) return -1;\n"
    buf = buf + "    const double* Q    = g_slots[Q_id].d_buf;\n"
    buf = buf + "    const double* K    = g_slots[K_id].d_buf;\n"
    buf = buf + "    const double* V    = g_slots[V_id].d_buf;\n"
    buf = buf + "    const double* P    = g_slots[P_id].d_buf;\n"
    buf = buf + "    const double* dctx = g_slots[dctx_id].d_buf;\n"
    buf = buf + "    double*       dQ   = g_slots[dQ_id].d_buf;\n"
    buf = buf + "    double*       dK   = g_slots[dK_id].d_buf;\n"
    buf = buf + "    double*       dV   = g_slots[dV_id].d_buf;\n"
    buf = buf + "    int block_sz = 256;\n"
    buf = buf + "    _hx_k_attn_core_bwd<<<1, block_sz, 0, _forge_stream()>>>(Q, K, V, P, dctx,\n"
    buf = buf + "                                                            dQ, dK, dV, T, nh, nkv, hd);\n"
    buf = buf + "    if (_forge_launch_check(\"attn_core_bwd\") != 0) return -1;\n"
    buf = buf + "    {\n"
    buf = buf + "        int64_t outs[3] = { dQ_id, dK_id, dV_id };\n"
    buf = buf + "        for (int k = 0; k < 3; k++) {\n"
    buf = buf + "            HexaFarrEntry* e = &_hx_farr_table[outs[k]];\n"
    buf = buf + "            e->d_buf      = (void*)g_slots[outs[k]].d_buf;\n"
    buf = buf + "            e->loc        = FARR_DEVICE;\n"
    buf = buf + "            e->dirty_host = 0;\n"
    buf = buf + "            e->dirty_dev  = 0;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)Q_id; (void)K_id; (void)V_id; (void)P_id; (void)dctx_id; (void)dQ_id;\n"
    buf = buf + "    (void)dK_id; (void)dV_id; (void)T; (void)nh; (void)nkv; (void)hd;\n"
    buf = buf + "    fprintf(stderr, \"[cuda] attn_core_bwd: built without __CUDACC__\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "/* HEXA-FUSION L3 (BWD glue half) — device-resident elementwise GELU backward.\n"
    buf = buf + " * Reproduces stdlib/flame/nn_lib.hexa nn_gelu_bwd EXACTLY:\n"
    buf = buf + " *   DG[i] = DA[i] · GELU'(G[i]) ; GELU'(x) = Φ(x) + x·φ(x)\n"
    buf = buf + " *   Φ(x) = 0.5·(1 + erf(x·(1/√2)))   (_nn_normal_cdf)\n"
    buf = buf + " *   φ(x) = (1/√(2π))·exp(-0.5·x²)    (_nn_normal_pdf)\n"
    buf = buf + " * G is the PRE-activation saved from forward. The constants are the SAME\n"
    buf = buf + " * literals the host uses (1/√2 = _nn_inv_sqrt2, 1/√(2π) = _nn_inv_sqrt2pi)\n"
    buf = buf + " * and the op order matches _nn_gelu_grad verbatim (cdf + x·pdf). Device erf()\n"
    buf = buf + " * and exp() are the IEEE-correct libm contract (same as the host builtins).\n"
    buf = buf + " * Pure elementwise, NO reduction → bit-exact to the host scalar loop\n"
    buf = buf + " * (max|Δ|=0). Fuses the gelu_bwd ×3 host glue in clm_prod_bwd (deo0/deo1/dhn0\n"
    buf = buf + " * — the bwd mirror of the fwd gelu ×3) and keeps DG FARR_DEVICE so the\n"
    buf = buf + " * follow-up conv-bwd GEMM H2D-skips it. */\n"
    buf = buf + "__global__ void _hx_k_gelu_bwd(const double* __restrict__ G,\n"
    buf = buf + "                               const double* __restrict__ DA,\n"
    buf = buf + "                               double* __restrict__ DG, int64_t n) {\n"
    buf = buf + "    const double inv_sqrt2   = 0.70710678118654752440;\n"
    buf = buf + "    const double inv_sqrt2pi = 0.39894228040143267794;\n"
    buf = buf + "    int64_t stride = (int64_t)blockDim.x * (int64_t)gridDim.x;\n"
    buf = buf + "    for (int64_t i = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;\n"
    buf = buf + "         i < n; i += stride) {\n"
    buf = buf + "        double x   = G[i];\n"
    buf = buf + "        double cdf = 0.5 * (1.0 + _hx_dt_erf_dev(x * inv_sqrt2));\n"
    buf = buf + "        double pdf = inv_sqrt2pi * _hx_dt_exp_dev(0.0 - 0.5 * x * x);\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "        double grad = cdf + x * pdf;\n"
    buf = buf + "        DG[i] = DA[i] * grad;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "int _hx_cuda_farr_gelu_bwd_gpu(int64_t g_id, int64_t da_id,\n"
    buf = buf + "                               int64_t dg_id, int64_t n) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (n <= 0) return -1;\n"
    buf = buf + "    if (_h2d(g_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(da_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(dg_id, n) != 0) return -1;\n"
    buf = buf + "    const double* G  = g_slots[g_id].d_buf;\n"
    buf = buf + "    const double* DA = g_slots[da_id].d_buf;\n"
    buf = buf + "    double*       DG = g_slots[dg_id].d_buf;\n"
    buf = buf + "    int block_sz = 256;\n"
    buf = buf + "    int64_t want = (n + block_sz - 1) / block_sz;\n"
    buf = buf + "    int grid_sz = (want > 1024) ? 1024 : (int)want;\n"
    buf = buf + "    if (grid_sz < 1) grid_sz = 1;\n"
    buf = buf + "    _hx_k_gelu_bwd<<<grid_sz, block_sz, 0, _forge_stream()>>>(G, DA, DG, n);\n"
    buf = buf + "    if (_forge_launch_check(\"gelu_bwd\") != 0) return -1;\n"
    buf = buf + "    {\n"
    buf = buf + "        HexaFarrEntry* e = &_hx_farr_table[dg_id];\n"
    buf = buf + "        e->d_buf      = (void*)g_slots[dg_id].d_buf;\n"
    buf = buf + "        e->loc        = FARR_DEVICE;\n"
    buf = buf + "        e->dirty_host = 0;\n"
    buf = buf + "        e->dirty_dev  = 0;\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)g_id; (void)da_id; (void)dg_id; (void)n;\n"
    buf = buf + "    fprintf(stderr, \"[cuda] gelu_bwd: built without __CUDACC__\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* HEXA-FUSION L3 (BWD glue half) — device-resident GroupNorm backward.\n"
    buf = buf + " * Reproduces stdlib/flame/gn_lib.hexa nn_groupnorm_bwd EXACTLY:\n"
    buf = buf + " *   per channel c: DGAMMA[c] = Σ_t DY[t,c]·XHAT[t,c] ; DBETA[c] = Σ_t DY[t,c]\n"
    buf = buf + " *   per group  g: s1 = Σ dxh ; s2 = Σ dxh·xhat  (dxh = DY·GAMMA over the group)\n"
    buf = buf + " *                 DX[t,c] = INV[g]·(dxh - s1/m - XHAT[t,c]·s2/m) , m = Cg·T\n"
    buf = buf + " * BIT-EXACTNESS: every reduction accumulates SEQUENTIALLY in the host order —\n"
    buf = buf + " * the per-channel sums over t (one thread per channel, t ascending), and the\n"
    buf = buf + " * per-group s1/s2 over (t outer, c inner) under ONE thread per group — NO tree\n"
    buf = buf + " * re-association, NO warp/atomic partials → max|Δ|=0. (No sqrt here; INV is the\n"
    buf = buf + " * saved forward reciprocal-stddev, read verbatim.) Fuses the groupnorm_bwd ×2\n"
    buf = buf + " * host glue in clm_prod_bwd (dy←dynorm, dh0←dhn0 — the bwd mirror of the fwd\n"
    buf = buf + " * groupnorm ×2). Keeps DGAMMA/DBETA/DX FARR_DEVICE. NOTE the kernel is split\n"
    buf = buf + " * into TWO launches sharing the grid (channel pass, then group pass) because\n"
    buf = buf + " * the DX pass depends on the per-group s1/s2 reductions — each pass is itself a\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + " * single-thread sequential reduction, preserving the host accumulation order. */\n"
    buf = buf + "__global__ void _hx_k_groupnorm_bwd_affine(const double* __restrict__ XHAT,\n"
    buf = buf + "                                           const double* __restrict__ DY,\n"
    buf = buf + "                                           double* __restrict__ DGAMMA,\n"
    buf = buf + "                                           double* __restrict__ DBETA,\n"
    buf = buf + "                                           int64_t T, int64_t C) {\n"
    buf = buf + "    for (int64_t c = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;\n"
    buf = buf + "         c < C; c += (int64_t)blockDim.x * gridDim.x) {\n"
    buf = buf + "        double sg = 0.0;\n"
    buf = buf + "        double sb = 0.0;\n"
    buf = buf + "        for (int64_t t = 0; t < T; t++) {\n"
    buf = buf + "            int64_t idx = t * C + c;\n"
    buf = buf + "            double gy = DY[idx];\n"
    buf = buf + "            sg += gy * XHAT[idx];\n"
    buf = buf + "            sb += gy;\n"
    buf = buf + "        }\n"
    buf = buf + "        DGAMMA[c] = sg;\n"
    buf = buf + "        DBETA[c]  = sb;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "__global__ void _hx_k_groupnorm_bwd_dx(const double* __restrict__ XHAT,\n"
    buf = buf + "                                       const double* __restrict__ INV,\n"
    buf = buf + "                                       const double* __restrict__ GAMMA,\n"
    buf = buf + "                                       const double* __restrict__ DY,\n"
    buf = buf + "                                       double* __restrict__ DX,\n"
    buf = buf + "                                       int64_t T, int64_t C, int64_t G) {\n"
    buf = buf + "    int64_t cg = C / G;\n"
    buf = buf + "    double m = (double)(cg * T);\n"
    buf = buf + "    for (int64_t g = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;\n"
    buf = buf + "         g < G; g += (int64_t)blockDim.x * gridDim.x) {\n"
    buf = buf + "        int64_t c0 = g * cg;\n"
    buf = buf + "        double inv_g = INV[g];\n"
    buf = buf + "        double s1 = 0.0;\n"
    buf = buf + "        double s2 = 0.0;\n"
    buf = buf + "        for (int64_t t = 0; t < T; t++)\n"
    buf = buf + "            for (int64_t cc = 0; cc < cg; cc++) {\n"
    buf = buf + "                int64_t ch = c0 + cc;\n"
    buf = buf + "                int64_t idx = t * C + ch;\n"
    buf = buf + "                double dxh = DY[idx] * GAMMA[ch];\n"
    buf = buf + "                s1 += dxh;\n"
    buf = buf + "                s2 += dxh * XHAT[idx];\n"
    buf = buf + "            }\n"
    buf = buf + "        for (int64_t t = 0; t < T; t++)\n"
    buf = buf + "            for (int64_t cc = 0; cc < cg; cc++) {\n"
    buf = buf + "                int64_t ch = c0 + cc;\n"
    buf = buf + "                int64_t idx = t * C + ch;\n"
    buf = buf + "                double dxh = DY[idx] * GAMMA[ch];\n"
    buf = buf + "                DX[idx] = inv_g * (dxh - s1 / m - XHAT[idx] * s2 / m);\n"
    buf = buf + "            }\n"
    buf = buf + "    }\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* HEXA-GN-PARALLEL bwd-dx (fast non-det default) — one block per group +\n"
    buf = buf + " * intra-block shared-mem tree reduction for s1/s2, then parallel DX write.\n"
    buf = buf + " * Removes the single-block sequential wall of _hx_k_groupnorm_bwd_dx. Tree\n"
    buf = buf + " * re-association of the FP64 sum -> NOT bit-exact (training-OK); DET opt-in\n"
    buf = buf + " * routes to the sequential _hx_k_groupnorm_bwd_dx (byte-exact oracle). Shared\n"
    buf = buf + " * mem = 2*block_sz doubles (s1 then s2). */\n"
    buf = buf + "__global__ void _hx_k_groupnorm_bwd_dx_par(const double* __restrict__ XHAT,\n"
    buf = buf + "                                           const double* __restrict__ INV,\n"
    buf = buf + "                                           const double* __restrict__ GAMMA,\n"
    buf = buf + "                                           const double* __restrict__ DY,\n"
    buf = buf + "                                           double* __restrict__ DX,\n"
    buf = buf + "                                           int64_t T, int64_t C, int64_t G) {\n"
    buf = buf + "    extern __shared__ double _gnb_sh[];\n"
    buf = buf + "    int64_t cg = C / G;\n"
    buf = buf + "    double m = (double)(cg * T);\n"
    buf = buf + "    int tid = (int)threadIdx.x;\n"
    buf = buf + "    int nth = (int)blockDim.x;\n"
    buf = buf + "    double* s1a = _gnb_sh;\n"
    buf = buf + "    double* s2a = _gnb_sh + nth;\n"
    buf = buf + "    int64_t N = (int64_t)T * cg;\n"
    buf = buf + "    for (int64_t g = blockIdx.x; g < G; g += gridDim.x) {\n"
    buf = buf + "        int64_t c0 = g * cg;\n"
    buf = buf + "        double inv_g = INV[g];\n"
    buf = buf + "        double q1 = 0.0, q2 = 0.0;\n"
    buf = buf + "        for (int64_t i = tid; i < N; i += nth) {\n"
    buf = buf + "            int64_t t = i / cg, cc = i % cg;\n"
    buf = buf + "            int64_t ch = c0 + cc;\n"
    buf = buf + "            int64_t idx = t * C + ch;\n"
    buf = buf + "            double dxh = DY[idx] * GAMMA[ch];\n"
    buf = buf + "            q1 += dxh;\n"
    buf = buf + "            q2 += dxh * XHAT[idx];\n"
    buf = buf + "        }\n"
    buf = buf + "        s1a[tid] = q1; s2a[tid] = q2;\n"
    buf = buf + "        __syncthreads();\n"
    buf = buf + "        for (int s = nth >> 1; s > 0; s >>= 1) {\n"
    buf = buf + "            if (tid < s) { s1a[tid] += s1a[tid + s]; s2a[tid] += s2a[tid + s]; }\n"
    buf = buf + "            __syncthreads();\n"
    buf = buf + "        }\n"
    buf = buf + "        double s1 = s1a[0], s2 = s2a[0];\n"
    buf = buf + "        __syncthreads();\n"
    buf = buf + "        for (int64_t i = tid; i < N; i += nth) {\n"
    buf = buf + "            int64_t t = i / cg, cc = i % cg;\n"
    buf = buf + "            int64_t ch = c0 + cc;\n"
    buf = buf + "            int64_t idx = t * C + ch;\n"
    buf = buf + "            double dxh = DY[idx] * GAMMA[ch];\n"
    buf = buf + "            DX[idx] = inv_g * (dxh - s1 / m - XHAT[idx] * s2 / m);\n"
    buf = buf + "        }\n"
    buf = buf + "        __syncthreads();\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "int _hx_cuda_farr_groupnorm_bwd_gpu(int64_t xhat_id, int64_t inv_id,\n"
    buf = buf + "                                    int64_t gamma_id, int64_t dy_id,\n"
    buf = buf + "                                    int64_t dgamma_id, int64_t dbeta_id,\n"
    buf = buf + "                                    int64_t dx_id,\n"
    buf = buf + "                                    int64_t T, int64_t C, int64_t G) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (T <= 0 || C <= 0 || G <= 0 || (C % G) != 0) return -1;\n"
    buf = buf + "    if (_h2d(xhat_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(inv_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(gamma_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(dy_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(dgamma_id, C) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(dbeta_id, C) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(dx_id, T * C) != 0) return -1;\n"
    buf = buf + "    const double* XHAT  = g_slots[xhat_id].d_buf;\n"
    buf = buf + "    const double* INV   = g_slots[inv_id].d_buf;\n"
    buf = buf + "    const double* GAMMA = g_slots[gamma_id].d_buf;\n"
    buf = buf + "    const double* DY    = g_slots[dy_id].d_buf;\n"
    buf = buf + "    double*       DGAMMA = g_slots[dgamma_id].d_buf;\n"
    buf = buf + "    double*       DBETA  = g_slots[dbeta_id].d_buf;\n"
    buf = buf + "    double*       DX     = g_slots[dx_id].d_buf;\n"
    buf = buf + "    {\n"
    buf = buf + "        int block_sz = 128;\n"
    buf = buf + "        int64_t want = (C + block_sz - 1) / block_sz;\n"
    buf = buf + "        int grid_sz = (want > 1024) ? 1024 : (int)want;\n"
    buf = buf + "        if (grid_sz < 1) grid_sz = 1;\n"
    buf = buf + "        _hx_k_groupnorm_bwd_affine<<<grid_sz, block_sz, 0, _forge_stream()>>>(XHAT, DY,\n"
    buf = buf + "                                                          DGAMMA, DBETA, T, C);\n"
    buf = buf + "    }\n"
    buf = buf + "    {\n"
    buf = buf + "        if (!_forge_det_on()) {\n"
    buf = buf + "            int block_sz = 256;\n"
    buf = buf + "            int grid_sz = (G > 65535) ? 65535 : (int)G;\n"
    buf = buf + "            if (grid_sz < 1) grid_sz = 1;\n"
    buf = buf + "            size_t shmem = (size_t)block_sz * 2 * sizeof(double);\n"
    buf = buf + "            _hx_k_groupnorm_bwd_dx_par<<<grid_sz, block_sz, shmem, _forge_stream()>>>(XHAT, INV, GAMMA, DY,\n"
    buf = buf + "                                                          DX, T, C, G);\n"
    buf = buf + "        } else {\n"
    buf = buf + "            int block_sz = 64;\n"
    buf = buf + "            int64_t want = (G + block_sz - 1) / block_sz;\n"
    buf = buf + "            int grid_sz = (want > 1024) ? 1024 : (int)want;\n"
    buf = buf + "            if (grid_sz < 1) grid_sz = 1;\n"
    buf = buf + "            _hx_k_groupnorm_bwd_dx<<<grid_sz, block_sz, 0, _forge_stream()>>>(XHAT, INV, GAMMA, DY,\n"
    buf = buf + "                                                          DX, T, C, G);\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_forge_launch_check(\"groupnorm_bwd\") != 0) return -1;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    {\n"
    buf = buf + "        int64_t outs[3] = { dgamma_id, dbeta_id, dx_id };\n"
    buf = buf + "        for (int k = 0; k < 3; k++) {\n"
    buf = buf + "            HexaFarrEntry* e = &_hx_farr_table[outs[k]];\n"
    buf = buf + "            e->d_buf      = (void*)g_slots[outs[k]].d_buf;\n"
    buf = buf + "            e->loc        = FARR_DEVICE;\n"
    buf = buf + "            e->dirty_host = 0;\n"
    buf = buf + "            e->dirty_dev  = 0;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)xhat_id; (void)inv_id; (void)gamma_id; (void)dy_id;\n"
    buf = buf + "    (void)dgamma_id; (void)dbeta_id; (void)dx_id; (void)T; (void)C; (void)G;\n"
    buf = buf + "    fprintf(stderr, \"[cuda] groupnorm_bwd: built without __CUDACC__\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* HEXA-FUSION L3 (BWD glue half) — device-resident expert-unpack (residual\n"
    buf = buf + " * grad split). The bwd MIRROR of expert_pack2: reproduces the clm_prod_bwd\n"
    buf = buf + " * ei-loop EXACTLY: for i in 0..n,\n"
    buf = buf + " *   DEX0[i] = DEX_OUT[0·n + i] ; DEX1[i] = DEX_OUT[1·n + i]   (n = T·d)\n"
    buf = buf + " * = the moe-router grad dex_out[E·T·d] split back into the 2 per-expert grads.\n"
    buf = buf + " * Pure copy, NO arithmetic, NO reduction → trivially bit-exact (max|Δ|=0).\n"
    buf = buf + " * Fuses the T·d host t_get/t_set unpack loop in clm_prod_bwd (between the\n"
    buf = buf + " * moe-router bwd and the 2 gelu_bwd). Keeps DEX0/DEX1 FARR_DEVICE so the\n"
    buf = buf + " * follow-up gelu_bwd H2D-skips them. */\n"
    buf = buf + "__global__ void _hx_k_expert_unpack2(const double* __restrict__ DEX_OUT,\n"
    buf = buf + "                                     double* __restrict__ DEX0,\n"
    buf = buf + "                                     double* __restrict__ DEX1, int64_t n) {\n"
    buf = buf + "    int64_t stride = (int64_t)blockDim.x * (int64_t)gridDim.x;\n"
    buf = buf + "    for (int64_t i = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;\n"
    buf = buf + "         i < n; i += stride) {\n"
    buf = buf + "        DEX0[i] = DEX_OUT[i];\n"
    buf = buf + "        DEX1[i] = DEX_OUT[n + i];\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "int _hx_cuda_farr_expert_unpack2_gpu(int64_t dex_out_id, int64_t dex0_id,\n"
    buf = buf + "                                     int64_t dex1_id, int64_t n) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (n <= 0) return -1;\n"
    buf = buf + "    if (_h2d(dex_out_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(dex0_id, n) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(dex1_id, n) != 0) return -1;\n"
    buf = buf + "    const double* DEX_OUT = g_slots[dex_out_id].d_buf;\n"
    buf = buf + "    double*       DEX0    = g_slots[dex0_id].d_buf;\n"
    buf = buf + "    double*       DEX1    = g_slots[dex1_id].d_buf;\n"
    buf = buf + "    int block_sz = 256;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    int64_t want = (n + block_sz - 1) / block_sz;\n"
    buf = buf + "    int grid_sz = (want > 1024) ? 1024 : (int)want;\n"
    buf = buf + "    if (grid_sz < 1) grid_sz = 1;\n"
    buf = buf + "    _hx_k_expert_unpack2<<<grid_sz, block_sz, 0, _forge_stream()>>>(DEX_OUT, DEX0, DEX1, n);\n"
    buf = buf + "    if (_forge_launch_check(\"expert_unpack2\") != 0) return -1;\n"
    buf = buf + "    {\n"
    buf = buf + "        int64_t outs[2] = { dex0_id, dex1_id };\n"
    buf = buf + "        for (int k = 0; k < 2; k++) {\n"
    buf = buf + "            HexaFarrEntry* e = &_hx_farr_table[outs[k]];\n"
    buf = buf + "            e->d_buf      = (void*)g_slots[outs[k]].d_buf;\n"
    buf = buf + "            e->loc        = FARR_DEVICE;\n"
    buf = buf + "            e->dirty_host = 0;\n"
    buf = buf + "            e->dirty_dev  = 0;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)dex_out_id; (void)dex0_id; (void)dex1_id; (void)n;\n"
    buf = buf + "    fprintf(stderr, \"[cuda] expert_unpack2: built without __CUDACC__\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* HEXA-FUSION L3 (BWD glue half · ⑤-bwd2) — device-resident CE softmax grad.\n"
    buf = buf + " * Reproduces clm_prod.hexa clm_ce_grad EXACTLY: per position t (one thread),\n"
    buf = buf + " *   mx = max_v LOGITS[t,v] ; sm = Σ_v exp(LOGITS[t,v] - mx)\n"
    buf = buf + " *   DLOGITS[t,v] = (exp(LOGITS[t,v] - mx)/sm) · (1/T)   for all v\n"
    buf = buf + " *   DLOGITS[t, tgt] -= 1/T          (tgt = (int)TARGETS[t])\n"
    buf = buf + " * The max + the sum + the per-col writes all run SEQUENTIALLY in the host\n"
    buf = buf + " * scan order (one thread per t, v ascending) — NO tree re-assoc, NO atomics.\n"
    buf = buf + " * F-OP19: exp = the HAND-ROLLED dt_exp Taylor (replayed term-for-term in\n"
    buf = buf + " * _hx_dt_exp_dev), NOT CUDA exp()/expf — so it is bit-exact to the host\n"
    buf = buf + " * clm_ce_grad (which ALSO uses dt_exp as of F-OP19) AND cross-platform\n"
    buf = buf + " * deterministic (CUDA exp, like host libm exp, diverged across arch/OS —\n"
    buf = buf + " * measured 1 ULP arm64-macos vs x86-linux). The _moe_exp_dev precedent.\n"
    buf = buf + " * The 1/T = 1.0/(double)T scaling matches `1.0 / to_float(T)` exactly →\n"
    buf = buf + " * bit-exact (max|Δ|=0). Fuses the clm_ce_grad host glue at the head of the\n"
    buf = buf + " * full-step driver (before clm_prod_bwd). Keeps DLOGITS FARR_DEVICE so the\n"
    buf = buf + " * first conv-bwd GEMM H2D-skips it. */\n"
    buf = buf + "/* HEXA-0POD OP-19b: _hx_dt_exp_dev is now defined ONCE above (before the\n"
    buf = buf + " * device GELU kernels, which also need it for the bwd pdf) — the F-OP19\n"
    buf = buf + " * definition formerly inlined here was hoisted to avoid a redefinition. */\n"
    buf = buf + "__global__ void _hx_k_ce_grad(const double* __restrict__ LOGITS,\n"
    buf = buf + "                              const double* __restrict__ TARGETS,\n"
    buf = buf + "                              double* __restrict__ DLOGITS,\n"
    buf = buf + "                              int64_t T, int64_t V) {\n"
    buf = buf + "    double invT = 1.0 / (double)T;\n"
    buf = buf + "    for (int64_t t = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;\n"
    buf = buf + "         t < T; t += (int64_t)blockDim.x * gridDim.x) {\n"
    buf = buf + "        int64_t base = t * V;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "        double mx = LOGITS[base];\n"
    buf = buf + "        for (int64_t i = 1; i < V; i++) {\n"
    buf = buf + "            double v = LOGITS[base + i];\n"
    buf = buf + "            if (v > mx) mx = v;\n"
    buf = buf + "        }\n"
    buf = buf + "        double sm = 0.0;\n"
    buf = buf + "        for (int64_t i2 = 0; i2 < V; i2++)\n"
    buf = buf + "            sm += _hx_dt_exp_dev(LOGITS[base + i2] - mx);\n"
    buf = buf + "        for (int64_t v3 = 0; v3 < V; v3++) {\n"
    buf = buf + "            double p = _hx_dt_exp_dev(LOGITS[base + v3] - mx) / sm;\n"
    buf = buf + "            DLOGITS[base + v3] = p * invT;\n"
    buf = buf + "        }\n"
    buf = buf + "        int64_t tgt = (int64_t)TARGETS[t];\n"
    buf = buf + "        DLOGITS[base + tgt] = DLOGITS[base + tgt] - invT;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "int _hx_cuda_farr_ce_grad_gpu(int64_t logits_id, int64_t targets_id,\n"
    buf = buf + "                              int64_t dlogits_id, int64_t T, int64_t V) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (T <= 0 || V <= 0) return -1;\n"
    buf = buf + "    if (_h2d(logits_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(targets_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(dlogits_id, T * V) != 0) return -1;\n"
    buf = buf + "    const double* LOGITS  = g_slots[logits_id].d_buf;\n"
    buf = buf + "    const double* TARGETS = g_slots[targets_id].d_buf;\n"
    buf = buf + "    double*       DLOGITS = g_slots[dlogits_id].d_buf;\n"
    buf = buf + "    int block_sz = 64;\n"
    buf = buf + "    int64_t want = (T + block_sz - 1) / block_sz;\n"
    buf = buf + "    int grid_sz = (want > 1024) ? 1024 : (int)want;\n"
    buf = buf + "    if (grid_sz < 1) grid_sz = 1;\n"
    buf = buf + "    _hx_k_ce_grad<<<grid_sz, block_sz, 0, _forge_stream()>>>(LOGITS, TARGETS, DLOGITS, T, V);\n"
    buf = buf + "    if (_forge_launch_check(\"ce_grad\") != 0) return -1;\n"
    buf = buf + "    {\n"
    buf = buf + "        HexaFarrEntry* e = &_hx_farr_table[dlogits_id];\n"
    buf = buf + "        e->d_buf      = (void*)g_slots[dlogits_id].d_buf;\n"
    buf = buf + "        e->loc        = FARR_DEVICE;\n"
    buf = buf + "        e->dirty_host = 0;\n"
    buf = buf + "        e->dirty_dev  = 0;\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)logits_id; (void)targets_id; (void)dlogits_id; (void)T; (void)V;\n"
    buf = buf + "    fprintf(stderr, \"[cuda] ce_grad: built without __CUDACC__\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* HEXA-FUSION L3 (BWD glue half · ⑤-bwd2) — device-resident MoE-router bwd.\n"
    buf = buf + " * Reproduces moe_lib.hexa nn_moe_router_bwd EXACTLY (reads CACHED probs from\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + " * fwd — NO _moe_exp replay needed). Per position t (one thread):\n"
    buf = buf + " *   pass 1 (e ascending): pte = PROBS[t,e] ; dg = Σ_c DY[t,c]·EX_OUT[e,t,c]\n"
    buf = buf + " *                         DEX_OUT[e,t,c] = pte·DY[t,c]  (c ascending)\n"
    buf = buf + " *                         stash dg in DLOGITS[t,e] ; dot += pte·dg\n"
    buf = buf + " *   pass 2 (e ascending): DLOGITS[t,e] = PROBS[t,e]·(DLOGITS[t,e] - dot)\n"
    buf = buf + " * Every reduction (the inner Σ_c and the dot Σ_e) accumulates SEQUENTIALLY in\n"
    buf = buf + " * the host order under ONE thread per t — NO tree re-assoc, NO atomics → bit-\n"
    buf = buf + " * exact (max|Δ|=0). dot is read AFTER pass-1 completes the full E scan, so the\n"
    buf = buf + " * 2-pass dependency is preserved within the single thread (no cross-thread\n"
    buf = buf + " * sync). Fuses the nn_moe_router_bwd host glue in clm_prod_bwd; keeps\n"
    buf = buf + " * DLOGITS/DEX_OUT FARR_DEVICE so the follow-up conv-bwd + expert-unpack\n"
    buf = buf + " * H2D-skip them. */\n"
    buf = buf + "__global__ void _hx_k_moe_router_bwd(const double* __restrict__ PROBS,\n"
    buf = buf + "                                     const double* __restrict__ EX_OUT,\n"
    buf = buf + "                                     const double* __restrict__ DY,\n"
    buf = buf + "                                     double* __restrict__ DLOGITS,\n"
    buf = buf + "                                     double* __restrict__ DEX_OUT,\n"
    buf = buf + "                                     int64_t T, int64_t E, int64_t C) {\n"
    buf = buf + "    for (int64_t t = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;\n"
    buf = buf + "         t < T; t += (int64_t)blockDim.x * gridDim.x) {\n"
    buf = buf + "        double dot = 0.0;\n"
    buf = buf + "        for (int64_t e = 0; e < E; e++) {\n"
    buf = buf + "            double pte = PROBS[t * E + e];\n"
    buf = buf + "            double dg = 0.0;\n"
    buf = buf + "            for (int64_t c = 0; c < C; c++) {\n"
    buf = buf + "                double gy = DY[t * C + c];\n"
    buf = buf + "                dg += gy * EX_OUT[e * T * C + t * C + c];\n"
    buf = buf + "                DEX_OUT[e * T * C + t * C + c] = pte * gy;\n"
    buf = buf + "            }\n"
    buf = buf + "            DLOGITS[t * E + e] = dg;\n"
    buf = buf + "            dot += pte * dg;\n"
    buf = buf + "        }\n"
    buf = buf + "        for (int64_t e2 = 0; e2 < E; e2++) {\n"
    buf = buf + "            double pte = PROBS[t * E + e2];\n"
    buf = buf + "            double dg = DLOGITS[t * E + e2];\n"
    buf = buf + "            DLOGITS[t * E + e2] = pte * (dg - dot);\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "int _hx_cuda_farr_moe_router_bwd_gpu(int64_t probs_id, int64_t ex_out_id,\n"
    buf = buf + "                                     int64_t dy_id, int64_t dlogits_id,\n"
    buf = buf + "                                     int64_t dex_out_id,\n"
    buf = buf + "                                     int64_t T, int64_t E, int64_t C) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (T <= 0 || E <= 0 || C <= 0) return -1;\n"
    buf = buf + "    if (_h2d(probs_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(ex_out_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(dy_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(dlogits_id, T * E) != 0) return -1;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    if (_ensure_dev_alloc_out(dex_out_id, E * T * C) != 0) return -1;\n"
    buf = buf + "    const double* PROBS  = g_slots[probs_id].d_buf;\n"
    buf = buf + "    const double* EX_OUT = g_slots[ex_out_id].d_buf;\n"
    buf = buf + "    const double* DY     = g_slots[dy_id].d_buf;\n"
    buf = buf + "    double*       DLOGITS = g_slots[dlogits_id].d_buf;\n"
    buf = buf + "    double*       DEX_OUT = g_slots[dex_out_id].d_buf;\n"
    buf = buf + "    int block_sz = 64;\n"
    buf = buf + "    int64_t want = (T + block_sz - 1) / block_sz;\n"
    buf = buf + "    int grid_sz = (want > 1024) ? 1024 : (int)want;\n"
    buf = buf + "    if (grid_sz < 1) grid_sz = 1;\n"
    buf = buf + "    _hx_k_moe_router_bwd<<<grid_sz, block_sz, 0, _forge_stream()>>>(PROBS, EX_OUT, DY,\n"
    buf = buf + "                                               DLOGITS, DEX_OUT, T, E, C);\n"
    buf = buf + "    if (_forge_launch_check(\"moe_router_bwd\") != 0) return -1;\n"
    buf = buf + "    {\n"
    buf = buf + "        int64_t outs[2] = { dlogits_id, dex_out_id };\n"
    buf = buf + "        for (int k = 0; k < 2; k++) {\n"
    buf = buf + "            HexaFarrEntry* e = &_hx_farr_table[outs[k]];\n"
    buf = buf + "            e->d_buf      = (void*)g_slots[outs[k]].d_buf;\n"
    buf = buf + "            e->loc        = FARR_DEVICE;\n"
    buf = buf + "            e->dirty_host = 0;\n"
    buf = buf + "            e->dirty_dev  = 0;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)probs_id; (void)ex_out_id; (void)dy_id; (void)dlogits_id;\n"
    buf = buf + "    (void)dex_out_id; (void)T; (void)E; (void)C;\n"
    buf = buf + "    fprintf(stderr, \"[cuda] moe_router_bwd: built without __CUDACC__\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* HEXA-FUSION L3 (BWD glue half · ⑤-bwd2) — device-resident 3-way grad sum.\n"
    buf = buf + " * Reproduces the clm_prod_bwd dxt accumulation EXACTLY:\n"
    buf = buf + " *   OUT[i] = A[i] + B[i] + C[i]   for i in 0..n  (left-to-right, host order)\n"
    buf = buf + " * = dxt = dxt_r + dxt_e0 + dxt_e1 (the router + 2 expert dX paths summed).\n"
    buf = buf + " * Pure elementwise, NO reduction across i, fixed (A+B)+C association matching\n"
    buf = buf + " * the host `t_get(a)+t_get(b)+t_get(c)` → bit-exact (max|Δ|=0). Fuses the dxt\n"
    buf = buf + " * 3-way host sum loop; keeps OUT FARR_DEVICE for the follow-up gelu_bwd. */\n"
    buf = buf + "__global__ void _hx_k_grad_sum3(const double* __restrict__ A,\n"
    buf = buf + "                                const double* __restrict__ B,\n"
    buf = buf + "                                const double* __restrict__ C,\n"
    buf = buf + "                                double* __restrict__ OUT, int64_t n) {\n"
    buf = buf + "    int64_t stride = (int64_t)blockDim.x * (int64_t)gridDim.x;\n"
    buf = buf + "    for (int64_t i = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;\n"
    buf = buf + "         i < n; i += stride) {\n"
    buf = buf + "        OUT[i] = A[i] + B[i] + C[i];\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "int _hx_cuda_farr_grad_sum3_gpu(int64_t a_id, int64_t b_id, int64_t c_id,\n"
    buf = buf + "                                int64_t out_id, int64_t n) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (n <= 0) return -1;\n"
    buf = buf + "    if (_h2d(a_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(b_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(c_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(out_id, n) != 0) return -1;\n"
    buf = buf + "    const double* A = g_slots[a_id].d_buf;\n"
    buf = buf + "    const double* B = g_slots[b_id].d_buf;\n"
    buf = buf + "    const double* C = g_slots[c_id].d_buf;\n"
    buf = buf + "    double*       OUT = g_slots[out_id].d_buf;\n"
    buf = buf + "    int block_sz = 256;\n"
    buf = buf + "    int64_t want = (n + block_sz - 1) / block_sz;\n"
    buf = buf + "    int grid_sz = (want > 1024) ? 1024 : (int)want;\n"
    buf = buf + "    if (grid_sz < 1) grid_sz = 1;\n"
    buf = buf + "    _hx_k_grad_sum3<<<grid_sz, block_sz, 0, _forge_stream()>>>(A, B, C, OUT, n);\n"
    buf = buf + "    if (_forge_launch_check(\"grad_sum3\") != 0) return -1;\n"
    buf = buf + "    {\n"
    buf = buf + "        HexaFarrEntry* e = &_hx_farr_table[out_id];\n"
    buf = buf + "        e->d_buf      = (void*)g_slots[out_id].d_buf;\n"
    buf = buf + "        e->loc        = FARR_DEVICE;\n"
    buf = buf + "        e->dirty_host = 0;\n"
    buf = buf + "        e->dirty_dev  = 0;\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)a_id; (void)b_id; (void)c_id; (void)out_id; (void)n;\n"
    buf = buf + "    fprintf(stderr, \"[cuda] grad_sum3: built without __CUDACC__\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* HEXA-FUSION L3 (BWD glue half · ⑤-bwd2) — device-resident 2-way grad sum.\n"
    buf = buf + " * Reproduces the clm_prod_bwd dxec accumulation EXACTLY:\n"
    buf = buf + " *   OUT[i] = A[i] + B[i]   for i in 0..n  (host order) = dxec = dxt + dxec_b.\n"
    buf = buf + " * Pure elementwise, NO reduction → bit-exact (max|Δ|=0). Fuses the dxec 2-way\n"
    buf = buf + " * host sum loop; keeps OUT FARR_DEVICE for the follow-up conv-bwd GEMM. */\n"
    buf = buf + "__global__ void _hx_k_grad_sum2(const double* __restrict__ A,\n"
    buf = buf + "                                const double* __restrict__ B,\n"
    buf = buf + "                                double* __restrict__ OUT, int64_t n) {\n"
    buf = buf + "    int64_t stride = (int64_t)blockDim.x * (int64_t)gridDim.x;\n"
    buf = buf + "    for (int64_t i = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;\n"
    buf = buf + "         i < n; i += stride) {\n"
    buf = buf + "        OUT[i] = A[i] + B[i];\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "int _hx_cuda_farr_grad_sum2_gpu(int64_t a_id, int64_t b_id,\n"
    buf = buf + "                                int64_t out_id, int64_t n) {\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (n <= 0) return -1;\n"
    buf = buf + "    if (_h2d(a_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(b_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(out_id, n) != 0) return -1;\n"
    buf = buf + "    const double* A = g_slots[a_id].d_buf;\n"
    buf = buf + "    const double* B = g_slots[b_id].d_buf;\n"
    buf = buf + "    double*       OUT = g_slots[out_id].d_buf;\n"
    buf = buf + "    int block_sz = 256;\n"
    buf = buf + "    int64_t want = (n + block_sz - 1) / block_sz;\n"
    buf = buf + "    int grid_sz = (want > 1024) ? 1024 : (int)want;\n"
    buf = buf + "    if (grid_sz < 1) grid_sz = 1;\n"
    buf = buf + "    _hx_k_grad_sum2<<<grid_sz, block_sz, 0, _forge_stream()>>>(A, B, OUT, n);\n"
    buf = buf + "    if (_forge_launch_check(\"grad_sum2\") != 0) return -1;\n"
    buf = buf + "    {\n"
    buf = buf + "        HexaFarrEntry* e = &_hx_farr_table[out_id];\n"
    buf = buf + "        e->d_buf      = (void*)g_slots[out_id].d_buf;\n"
    buf = buf + "        e->loc        = FARR_DEVICE;\n"
    buf = buf + "        e->dirty_host = 0;\n"
    buf = buf + "        e->dirty_dev  = 0;\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)a_id; (void)b_id; (void)out_id; (void)n;\n"
    buf = buf + "    fprintf(stderr, \"[cuda] grad_sum2: built without __CUDACC__\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* HEXA-FUSION L3 (BWD glue half · ⑤-bwd2) — device-resident deterministic\n"
    buf = buf + " * embedding scatter (grad accumulate into the table). Reproduces nn_lib.hexa\n"
    buf = buf + " * nn_embedding_bwd_scatter EXACTLY but WITHOUT atomics: the host loops i in\n"
    buf = buf + " * 0..T and does DTABLE[tok·d + c] += DX[i·d + c] (tok = (int)IDS[i]); colliding\n"
    buf = buf + " * tokens accumulate in i-ascending order. To preserve that order bit-exactly\n"
    buf = buf + " * with NO atomics and NO tree re-assoc, we assign ONE THREAD PER VOCAB ROW r:\n"
    buf = buf + " * each thread scans i = 0..T ascending and, for every i with tok==r, adds\n"
    buf = buf + " * DX[i·d + c] into DTABLE[r·d + c] (c ascending) — so each table row is touched\n"
    buf = buf + " * by exactly one thread, accumulating its colliding tokens in the SAME\n"
    buf = buf + " * ascending-i order the host uses. DTABLE is pre-zeroed on the host (the\n"
    buf = buf + " * clm_prod_bwd zero loop). Sequential per-row accumulation → bit-exact\n"
    buf = buf + " * (max|Δ|=0). Fuses the nn_embedding_bwd_scatter host glue at the tail of\n"
    buf = buf + " * clm_prod_bwd; keeps DTABLE FARR_DEVICE for the follow-up AdamW. */\n"
    buf = buf + "__global__ void _hx_k_embedding_bwd_scatter(const double* __restrict__ DX,\n"
    buf = buf + "                                            const double* __restrict__ IDS,\n"
    buf = buf + "                                            double* __restrict__ DTABLE,\n"
    buf = buf + "                                            int64_t T, int64_t d, int64_t V) {\n"
    buf = buf + "    for (int64_t r = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;\n"
    buf = buf + "         r < V; r += (int64_t)blockDim.x * gridDim.x) {\n"
    buf = buf + "        for (int64_t i = 0; i < T; i++) {\n"
    buf = buf + "            int64_t tok = (int64_t)IDS[i];\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "            if (tok != r) continue;\n"
    buf = buf + "            for (int64_t c = 0; c < d; c++)\n"
    buf = buf + "                DTABLE[r * d + c] = DTABLE[r * d + c] + DX[i * d + c];\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* #4204 own-native fast-default — atomic embedding grad-accum. One thread\n"
    buf = buf + " * per (i,c): atomicAdd's DX[i*d+c] into DTABLE[tok*d+c] (tok=(int)IDS[i]).\n"
    buf = buf + " * Colliding tokens accumulate in nondeterministic order (NOT bit-id) ->\n"
    buf = buf + " * fast non-det DEFAULT (training); replaces the O(V*T) per-vocab-row scan.\n"
    buf = buf + " * DTABLE is pre-zeroed on the host (clm_prod_bwd) then H2D'd, so the\n"
    buf = buf + " * atomicAdds land on a clean table. HEXA_DET selects the deterministic\n"
    buf = buf + " * per-row scan _hx_k_embedding_bwd_scatter. gpu_only: needs nvcc compile +\n"
    buf = buf + " * clm_prod_embed_scatter_eq oracle (det path) on summer. */\n"
    buf = buf + "__global__ void _hx_k_embedding_bwd_scatter_atomic(const double* __restrict__ DX,\n"
    buf = buf + "                                                   const double* __restrict__ IDS,\n"
    buf = buf + "                                                   double* __restrict__ DTABLE,\n"
    buf = buf + "                                                   int64_t T, int64_t d, int64_t V) {\n"
    buf = buf + "    int64_t total = T * d;\n"
    buf = buf + "    int64_t stride = (int64_t)blockDim.x * (int64_t)gridDim.x;\n"
    buf = buf + "    for (int64_t idx = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;\n"
    buf = buf + "         idx < total; idx += stride) {\n"
    buf = buf + "        int64_t i = idx / d;\n"
    buf = buf + "        int64_t c = idx - i * d;\n"
    buf = buf + "        int64_t tok = (int64_t)IDS[i];\n"
    buf = buf + "        if (tok >= 0 && tok < V) atomicAdd(&DTABLE[tok * d + c], DX[i * d + c]);\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "int _hx_cuda_farr_embedding_bwd_scatter_gpu(int64_t dx_id, int64_t ids_id,\n"
    buf = buf + "                                            int64_t dtable_id,\n"
    buf = buf + "                                            int64_t T, int64_t d, int64_t V) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (T <= 0 || d <= 0 || V <= 0) return -1;\n"
    buf = buf + "    if (_h2d(dx_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(ids_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(dtable_id) != 0) return -1;   /* pre-zeroed host buffer → device */\n"
    buf = buf + "    const double* DX  = g_slots[dx_id].d_buf;\n"
    buf = buf + "    const double* IDS = g_slots[ids_id].d_buf;\n"
    buf = buf + "    double*       DTABLE = g_slots[dtable_id].d_buf;\n"
    buf = buf + "    if (!_forge_det_on()) {\n"
    buf = buf + "        /* #4204 fast-default: atomic grad-accum (NOT bit-id), one thread per\n"
    buf = buf + "         * (i,c). DTABLE is the host-pre-zeroed table just H2D'd above. */\n"
    buf = buf + "        int eblk = 256;\n"
    buf = buf + "        int64_t ewant = (T * d + eblk - 1) / eblk;\n"
    buf = buf + "        int egrid = (ewant > 1024) ? 1024 : (int)ewant;\n"
    buf = buf + "        if (egrid < 1) egrid = 1;\n"
    buf = buf + "        _hx_k_embedding_bwd_scatter_atomic<<<egrid, eblk, 0, _forge_stream()>>>(DX, IDS, DTABLE, T, d, V);\n"
    buf = buf + "        if (_forge_launch_check(\"embedding_bwd_scatter_atomic\") != 0) return -1;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    } else {\n"
    buf = buf + "    int block_sz = 128;\n"
    buf = buf + "    int64_t want = (V + block_sz - 1) / block_sz;\n"
    buf = buf + "    int grid_sz = (want > 1024) ? 1024 : (int)want;\n"
    buf = buf + "    if (grid_sz < 1) grid_sz = 1;\n"
    buf = buf + "    _hx_k_embedding_bwd_scatter<<<grid_sz, block_sz, 0, _forge_stream()>>>(DX, IDS, DTABLE, T, d, V);\n"
    buf = buf + "    if (_forge_launch_check(\"embedding_bwd_scatter\") != 0) return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    {\n"
    buf = buf + "        HexaFarrEntry* e = &_hx_farr_table[dtable_id];\n"
    buf = buf + "        e->d_buf      = (void*)g_slots[dtable_id].d_buf;\n"
    buf = buf + "        e->loc        = FARR_DEVICE;\n"
    buf = buf + "        e->dirty_host = 0;\n"
    buf = buf + "        e->dirty_dev  = 0;\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)dx_id; (void)ids_id; (void)dtable_id; (void)T; (void)d; (void)V;\n"
    buf = buf + "    fprintf(stderr, \"[cuda] embedding_bwd_scatter: built without __CUDACC__\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ════════════════════════════════════════════════════════════════════\n"
    buf = buf + " * RFC 041 Phase 4-D-5-2 — Phase B reduction + Phase B2 real CUDA kernels\n"
    buf = buf + " * ────────────────────────────────────────────────────────────────────\n"
    buf = buf + " * 6 ops landed this cycle (reduction + matmul-variants split; the\n"
    buf = buf + " * elementwise split — mul/add/scale/silu/silu_grad — is the parallel\n"
    buf = buf + " * Agent's deliverable):\n"
    buf = buf + " *\n"
    buf = buf + " *   reduction (block-per-row, warp-shuffle, no atomics):\n"
    buf = buf + " *     - _hx_cuda_farr_softmax_rows_gpu     (Phase B)\n"
    buf = buf + " *     - _hx_cuda_farr_rmsnorm_rows_gpu     (Phase B)\n"
    buf = buf + " *     - _hx_cuda_farr_rmsnorm_bwd_rows_gpu (Phase B2; two row reductions)\n"
    buf = buf + " *\n"
    buf = buf + " *   matmul-variants (cuBLAS Dgemm reshape per RFC 041 §1):\n"
    buf = buf + " *     - _hx_cuda_farr_matmul_t_gpu  (Mᵀ·u   = cublasDgemm u[1×R]·M[R×C]→[1×C])\n"
    buf = buf + " *     - _hx_cuda_farr_outer_gpu     (u⊗v    = cublasDgemm u[R×1]·v[1×C]→[R×C])\n"
    buf = buf + " *\n"
    buf = buf + " *   1-D fused in-place update (no cross-element reduction):\n"
    buf = buf + " *     - _hx_cuda_farr_adamw_step_gpu (decoupled-wd AdamW, mirrors dt2_adamw_step)\n"
    buf = buf + " *\n"
    buf = buf + " * Wiring contract (matches existing Phase A `_hx_cuda_farr_matmul_gpu`):\n"
    buf = buf + " *   - Caller (self/runtime.c) has already allocated `out_id` via\n"
    buf = buf + " *     hexa_farr_zeros with the correct length.\n"
    buf = buf + " *   - We H2D-upload inputs (idempotent), cudaMalloc the output device\n"
    buf = buf + " *     buffer (if not resident), launch the kernel / cuBLAS, then D2H\n"
    buf = buf + " *     the result back to the caller's host buffer.\n"
    buf = buf + " *   - Returns 0 ok / -1 err. Every error path prints `[cuda] <op>: ...`\n"
    buf = buf + " *     to stderr; no silent fallback, no fake PASS.\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + " *\n"
    buf = buf + " * Determinism (F-RFC041-DETERMINISM):\n"
    buf = buf + " *   - Reductions use FIXED block size + warp-shuffle/shared-mem tree\n"
    buf = buf + " *     (no `atomicAdd`). Run-to-run byte-identical at fixed shape.\n"
    buf = buf + " *   - cuBLAS Dgemm: same handle, no Tensor-Op math mode flip → bit-eq\n"
    buf = buf + " *     across invocations on the same shape (per Phase D evidence).\n"
    buf = buf + " *\n"
    buf = buf + " * Tolerance choices (CALIBRATED — not asserted by hope):\n"
    buf = buf + " *   - matmul_t   : TOL_MATMUL ≈ 2e-9 relative (carries RFC 040 §2.2 H100\n"
    buf = buf + " *                  cuBLAS Dgemm measurement; same kernel, same caveat)\n"
    buf = buf + " *   - outer      : |Δ| = 0 BIT-EXACT (single product term per cell,\n"
    buf = buf + " *                  zero reduction → no fp non-associativity; RFC 041\n"
    buf = buf + " *                  F-RFC041-OUTER-EXACT demands exactness)\n"
    buf = buf + " *   - softmax_rows / rmsnorm_rows / rmsnorm_bwd_rows : TOL_ELEM ≈ 1e-12\n"
    buf = buf + " *                  (one row-length reduction, C ≤ ~4096; warp-shuffle\n"
    buf = buf + " *                  tree reorders pairwise sums relative to CPU sequential\n"
    buf = buf + " *                  loop — the fp non-associativity bound for sum of N\n"
    buf = buf + " *                  doubles is ~N·ε ≈ 4096·2.22e-16 ≈ 1e-12. Conservative.)\n"
    buf = buf + " *   - adamw_step : TOL_ELEM ≈ 1e-12 (no cross-element reduction; only the\n"
    buf = buf + " *                  per-element sqrt/division ULP — essentially bit-eq\n"
    buf = buf + " *                  modulo the libm sqrt platform ulp delta. The CPU side\n"
    buf = buf + " *                  also uses libm sqrt; bit-eq expected on modern x86/A64\n"
    buf = buf + " *                  but a 1e-15 cushion guards against IEEE-754 corner\n"
    buf = buf + " *                  cases on the GPU sqrt.)\n"
    buf = buf + " *\n"
    buf = buf + " * Build:\n"
    buf = buf + " *   - Real kernels are compiled by `nvcc -x cu -c runtime_cuda.c` only\n"
    buf = buf + " *     (the gcc-on-no-GPU path in PHASE_D_H100_EVIDENCE remains valid\n"
    buf = buf + " *     for Phase A — it never enters the `__CUDACC__`-guarded bodies and\n"
    buf = buf + " *     would link-fail at runtime if the new symbols are called without\n"
    buf = buf + " *     nvcc; that link-fail is the correct, honest behaviour).\n"
    buf = buf + " *   - On Mac dev (clang -DHEXA_CUDA -I /usr/local/cuda/include) the\n"
    buf = buf + " *     `__CUDACC__` macro is undefined, so the wrappers below compile as\n"
    buf = buf + " *     `return -1` stubs — syntactic check passes, no fake PASS.\n"
    buf = buf + " * ════════════════════════════════════════════════════════════════════ */\n"
    buf = buf + "\n"
    buf = buf + "/* ── Output-allocation helper (no H2D upload — output starts fresh). ── */\n"
    buf = buf + "static int _ensure_dev_alloc_out(int64_t out_id, int64_t need_len) {\n"
    buf = buf + "    if (out_id < 0 || out_id >= _hx_farr_count) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] out: bad id %lld\\n\", (long long)out_id);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_ensure_slot_cap(out_id) != 0) return -1;\n"
    buf = buf + "    HexaFarrEntry* e = &_hx_farr_table[out_id];\n"
    buf = buf + "    _CudaFarrSlot* s = &g_slots[out_id];\n"
    buf = buf + "    /* RFC 056 §6.2: a non-owning view must never be used as a kernel\n"
    buf = buf + "     * OUTPUT through this allocator (it would realloc/own the alias and\n"
    buf = buf + "     * corrupt the base). Views are read-only slices in the A2 design;\n"
    buf = buf + "     * reject defensively rather than risk the verified base buffer. */\n"
    buf = buf + "    if (s->view_base >= 0) {\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "        fprintf(stderr, \"[cuda] out: id %lld is a non-owning device view \"\n"
    buf = buf + "                \"(cannot be a kernel output)\\n\", (long long)out_id);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (!e->buf || e->len < need_len) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] out: host len %lld < need %lld\\n\",\n"
    buf = buf + "                (long long)e->len, (long long)need_len);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    /* HEXA-FUSION N2 RACEFIX (F-FUSION-N1N2-DETERMINISM, 2nd hazard):\n"
    buf = buf + "     * same cross-stream race as _h2d. The cudaFree/cudaMalloc/cudaMemset\n"
    buf = buf + "     * below run on the DEFAULT stream; when async is ON a still-queued\n"
    buf = buf + "     * forge-stream kernel may reference this slot's old d_buf ->\n"
    buf = buf + "     * cudaFree-under-use / concurrent memset. Drain the forge stream first\n"
    buf = buf + "     * (no-op async-off => byte-eq legacy). */\n"
    buf = buf + "    if (_forge_sync() != 0) return -1;\n"
    buf = buf + "    if (!s->d_buf || s->len != e->len) {\n"
    buf = buf + "        if (s->d_buf) cudaFree(s->d_buf);\n"
    buf = buf + "        cudaError_t er = cudaMalloc((void**)&s->d_buf,\n"
    buf = buf + "                                    (size_t)e->len * sizeof(double));\n"
    buf = buf + "        if (er != cudaSuccess) {\n"
    buf = buf + "            fprintf(stderr, \"[cuda] cudaMalloc out(%lld) failed: %s\\n\",\n"
    buf = buf + "                    (long long)e->len, cudaGetErrorString(er));\n"
    buf = buf + "            s->d_buf = NULL; s->len = 0;\n"
    buf = buf + "            return -1;\n"
    buf = buf + "        }\n"
    buf = buf + "        s->len = e->len;\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ── D2H of an output buffer with explicit length (post-kernel copy). ──\n"
    buf = buf + " *\n"
    buf = buf + " * RFC 056 §6.1/§6.4 D2H-defer. When the caller set the disposition\n"
    buf = buf + " * register to FORGE_OUT_DEVICE_KEEP (output is consumed by the next GPU\n"
    buf = buf + " * op, no host reader in between), the cudaMemcpy DeviceToHost is\n"
    buf = buf + " * DEFERRED: the output stays loc=FARR_DEVICE, dirty_dev=1 with a live\n"
    buf = buf + " * device slot. The very next forge op's _h2d sees DEVICE && !dirty_host\n"
    buf = buf + " * and SKIPs the redundant H2D — the value never round-trips. A later\n"
    buf = buf + " * host reader (or an explicit hexa_farr_to_host) does the lazy D2H.\n"
    buf = buf + " *\n"
    buf = buf + " * The DEFAULT (FORGE_OUT_HOST_NOW) is byte-identical to the verified\n"
    buf = buf + " * pre-RFC-056 substrate: same cudaMemcpy, same loc=FARR_MIRRORED,\n"
    buf = buf + " * dirty flags cleared. F-RFC056-BYTEEQ-PRESERVE re-runs the 12-kernel\n"
    buf = buf + " * oracle harnesses (which never set the register → always HOST_NOW)\n"
    buf = buf + " * and requires max|Δ|=0.0. */\n"
    buf = buf + "static int _d2h_out(int64_t out_id, int64_t copy_len) {\n"
    buf = buf + "    HexaFarrEntry* e = &_hx_farr_table[out_id];\n"
    buf = buf + "    _CudaFarrSlot* s = &g_slots[out_id];\n"
    buf = buf + "    if (_forge_out_keep()) {\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "        /* Defer D2H — device authoritative, host stale. No bytes\n"
    buf = buf + "         * copied; the next op reads s->d_buf directly via H2D-skip. */\n"
    buf = buf + "        e->d_buf      = (void*)s->d_buf;\n"
    buf = buf + "        e->loc        = FARR_DEVICE;\n"
    buf = buf + "        /* residency-fix: dirty_host MUST stay 0 here. The host buf is\n"
    buf = buf + "         * stale, but that is tracked by loc=FARR_DEVICE + dirty_dev=1 (a\n"
    buf = buf + "         * host-read materialises via hexa_farr_get loc==FARR_DEVICE D2H).\n"
    buf = buf + "         * dirty_host=1 means the USER mutated the host buf (hexa_farr_set)\n"
    buf = buf + "         * and forces a re-upload; setting it on a DEVICE_KEEP output wrongly\n"
    buf = buf + "         * BLOCKED the _h2d skip (which keys on !dirty_host) so the next GPU\n"
    buf = buf + "         * op re-uploaded the never-written host buffer, CLOBBERING this\n"
    buf = buf + "         * kernel device output with stale zeros -> device-resident fwd/grad\n"
    buf = buf + "         * garbage -> CLM_PROD_DEVRESIDENT/DEVFEED frozen-train (measured\n"
    buf = buf + "         * 4.7990 constant vs REF 3.5508 descend). Default = HOST_NOW so the\n"
    buf = buf + "         * shipped build stays byte-identical; only the opt-in path fixed. */\n"
    buf = buf + "        e->dirty_host = 0;\n"
    buf = buf + "        e->dirty_dev  = 1;   /* device holds the freshest value */\n"
    buf = buf + "        (void)copy_len;\n"
    buf = buf + "        return 0;\n"
    buf = buf + "    }\n"
    buf = buf + "    /* HOST_NOW path = host readback boundary → drain the forge stream\n"
    buf = buf + "     * first (no-op when async off). The DEVICE_KEEP path above returned\n"
    buf = buf + "     * without a D2H, so it correctly leaves the kernel queued. */\n"
    buf = buf + "    if (_forge_sync() != 0) return -1;\n"
    buf = buf + "    cudaError_t er = cudaMemcpy(e->buf, s->d_buf,\n"
    buf = buf + "                                (size_t)copy_len * sizeof(double),\n"
    buf = buf + "                                cudaMemcpyDeviceToHost);\n"
    buf = buf + "    if (er != cudaSuccess) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] D2H out failed: %s\\n\", cudaGetErrorString(er));\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    e->d_buf      = (void*)s->d_buf;\n"
    buf = buf + "    e->loc        = FARR_MIRRORED;\n"
    buf = buf + "    e->dirty_host = 0;\n"
    buf = buf + "    e->dirty_dev  = 0;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "\n"
    buf = buf + "/* ── Warp + block sum-reduction primitives (deterministic tree). ── */\n"
    buf = buf + "/* Block size for row-reduction kernels. 256 threads = 8 warps, fits\n"
    buf = buf + " * even long rows (C up to ~4096 with grid-stride within the block). */\n"
    buf = buf + "#define HX_RR_BLOCK 256\n"
    buf = buf + "\n"
    buf = buf + "__device__ __forceinline__ double _hx_warp_sum(double v) {\n"
    buf = buf + "    /* unsigned mask = 0xFFFFFFFF — all 32 threads of the warp. */\n"
    buf = buf + "    for (int offset = 16; offset > 0; offset >>= 1) {\n"
    buf = buf + "        v += __shfl_down_sync(0xFFFFFFFFu, v, offset);\n"
    buf = buf + "    }\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    return v;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "__device__ __forceinline__ double _hx_warp_max(double v) {\n"
    buf = buf + "    for (int offset = 16; offset > 0; offset >>= 1) {\n"
    buf = buf + "        double o = __shfl_down_sync(0xFFFFFFFFu, v, offset);\n"
    buf = buf + "        if (o > v) v = o;\n"
    buf = buf + "    }\n"
    buf = buf + "    return v;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* Block-wide sum: warp-reduce → shared-mem (one slot per warp) → first\n"
    buf = buf + " * warp re-reduces. HX_RR_BLOCK=256 → 8 warps → 8 shared slots. Returns\n"
    buf = buf + " * the total on thread 0; other threads see garbage. */\n"
    buf = buf + "__device__ __forceinline__ double _hx_block_sum(double v, double* smem) {\n"
    buf = buf + "    int lane = threadIdx.x & 31;\n"
    buf = buf + "    int wid  = threadIdx.x >> 5;\n"
    buf = buf + "    v = _hx_warp_sum(v);\n"
    buf = buf + "    if (lane == 0) smem[wid] = v;\n"
    buf = buf + "    __syncthreads();\n"
    buf = buf + "    /* First warp reads up-to-(HX_RR_BLOCK/32) warp sums + reduces. */\n"
    buf = buf + "    int n_warps = (blockDim.x + 31) >> 5;\n"
    buf = buf + "    if (wid == 0) {\n"
    buf = buf + "        double w = (lane < n_warps) ? smem[lane] : 0.0;\n"
    buf = buf + "        w = _hx_warp_sum(w);\n"
    buf = buf + "        if (lane == 0) smem[0] = w;\n"
    buf = buf + "    }\n"
    buf = buf + "    __syncthreads();\n"
    buf = buf + "    return smem[0];\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* f32 block-sum (S1 FP32-e2e layernorm) — same warp→smem→first-warp tree as\n"
    buf = buf + " * _hx_block_sum, float storage, self-contained shfl warp reduce. */\n"
    buf = buf + "__device__ __forceinline__ float _hx_block_sum_f32(float v, float* smem) {\n"
    buf = buf + "    int lane = threadIdx.x & 31;\n"
    buf = buf + "    int wid  = threadIdx.x >> 5;\n"
    buf = buf + "    for (int o = 16; o > 0; o >>= 1) v += __shfl_down_sync(0xffffffffu, v, o);\n"
    buf = buf + "    if (lane == 0) smem[wid] = v;\n"
    buf = buf + "    __syncthreads();\n"
    buf = buf + "    int n_warps = (blockDim.x + 31) >> 5;\n"
    buf = buf + "    if (wid == 0) {\n"
    buf = buf + "        float w = (lane < n_warps) ? smem[lane] : 0.0f;\n"
    buf = buf + "        for (int o = 16; o > 0; o >>= 1) w += __shfl_down_sync(0xffffffffu, w, o);\n"
    buf = buf + "        if (lane == 0) smem[0] = w;\n"
    buf = buf + "    }\n"
    buf = buf + "    __syncthreads();\n"
    buf = buf + "    return smem[0];\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "__device__ __forceinline__ double _hx_block_max(double v, double* smem) {\n"
    buf = buf + "    int lane = threadIdx.x & 31;\n"
    buf = buf + "    int wid  = threadIdx.x >> 5;\n"
    buf = buf + "    v = _hx_warp_max(v);\n"
    buf = buf + "    if (lane == 0) smem[wid] = v;\n"
    buf = buf + "    __syncthreads();\n"
    buf = buf + "    int n_warps = (blockDim.x + 31) >> 5;\n"
    buf = buf + "    if (wid == 0) {\n"
    buf = buf + "        /* -inf-equivalent for unused slots; rows always have ≥1 valid val. */\n"
    buf = buf + "        double w = (lane < n_warps) ? smem[lane] : -1.0e308;\n"
    buf = buf + "        w = _hx_warp_max(w);\n"
    buf = buf + "        if (lane == 0) smem[0] = w;\n"
    buf = buf + "    }\n"
    buf = buf + "    __syncthreads();\n"
    buf = buf + "    return smem[0];\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ────────────────────────────────────────────────────────────────────\n"
    buf = buf + " * Kernel 1 — softmax_rows: numerically-stable row-wise softmax.\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + " *   Y[r,j] = exp(X[r,j] - max_j X[r,j]) / Σ_j exp(...)\n"
    buf = buf + " * Layout: one block per row (gridDim.x = R), HX_RR_BLOCK threads per\n"
    buf = buf + " * block. Each thread strides across the row.\n"
    buf = buf + " * Two reductions per row (max, then sum). Fixed tree → deterministic.\n"
    buf = buf + " * ──────────────────────────────────────────────────────────────────── */\n"
    buf = buf + "__global__ void _hx_k_softmax_rows(const double* __restrict__ X,\n"
    buf = buf + "                                   double* __restrict__ Y,\n"
    buf = buf + "                                   int64_t R, int64_t C) {\n"
    buf = buf + "    int64_t r = blockIdx.x;\n"
    buf = buf + "    if (r >= R) return;\n"
    buf = buf + "    const double* xr = X + r * C;\n"
    buf = buf + "    double*       yr = Y + r * C;\n"
    buf = buf + "\n"
    buf = buf + "    __shared__ double smem[HX_RR_BLOCK / 32];\n"
    buf = buf + "\n"
    buf = buf + "    /* Pass 1: row max. */\n"
    buf = buf + "    double vmax = -1.0e308;\n"
    buf = buf + "    for (int64_t j = threadIdx.x; j < C; j += blockDim.x) {\n"
    buf = buf + "        double v = xr[j];\n"
    buf = buf + "        if (v > vmax) vmax = v;\n"
    buf = buf + "    }\n"
    buf = buf + "    double zmax = _hx_block_max(vmax, smem);\n"
    buf = buf + "\n"
    buf = buf + "    /* Pass 2: write exp(x - max) into Y, accumulate sum. */\n"
    buf = buf + "    double vsum = 0.0;\n"
    buf = buf + "    for (int64_t j = threadIdx.x; j < C; j += blockDim.x) {\n"
    buf = buf + "        double e = exp(xr[j] - zmax);\n"
    buf = buf + "        yr[j] = e;\n"
    buf = buf + "        vsum += e;\n"
    buf = buf + "    }\n"
    buf = buf + "    double s = _hx_block_sum(vsum, smem);\n"
    buf = buf + "    double inv = (s > 0.0) ? (1.0 / s) : 0.0;\n"
    buf = buf + "\n"
    buf = buf + "    /* Pass 3: normalize. */\n"
    buf = buf + "    for (int64_t j = threadIdx.x; j < C; j += blockDim.x) {\n"
    buf = buf + "        yr[j] *= inv;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ────────────────────────────────────────────────────────────────────\n"
    buf = buf + " * Kernel 1c (RFC gpu-resident-large-vocab-lmhead-loss, ADDITIVE) —\n"
    buf = buf + " * ce_seed: GPU-resident large-vocab lm-head cross-entropy loss + seed\n"
    buf = buf + " * gradient, ONE kernel, logits never leave the device.\n"
    buf = buf + " *\n"
    buf = buf + " *   row r ∈ [0,R), logits L[r,*] over a vocab of size V:\n"
    buf = buf + " *     m       = max_v L[r,v]                          (block-reduce)\n"
    buf = buf + " *     s       = Σ_v exp(L[r,v] - m)                    (block-reduce)\n"
    buf = buf + " *     lse     = m + log(s)                             (log-sum-exp)\n"
    buf = buf + " *     loss[r] = lse - L[r, target[r]]                 = -log softmax(target)\n"
    buf = buf + " *     dlogits[r,v] = softmax(L[r,v]) - onehot(v == target[r])\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + " *\n"
    buf = buf + " * Layout matches _hx_k_softmax_rows: one block per row (gridDim.x = R),\n"
    buf = buf + " * HX_RR_BLOCK threads striding the row; the two reductions use the same\n"
    buf = buf + " * deterministic _hx_block_max / _hx_block_sum tree. Per-row loss is\n"
    buf = buf + " * written to OUT_LOSS[r] (length R; the caller sums the R values on host\n"
    buf = buf + " * — R is small, e.g. 512). The seed grad fills OUT_DL[r*V + v] in place.\n"
    buf = buf + " *\n"
    buf = buf + " * HONEST SCOPE — bit-identity NOT claimed (online/parallel reduce order\n"
    buf = buf + " * differs from the host FP64 sequential loop); follows the forge `_gpu`\n"
    buf = buf + " * convention (rel-err tolerance, not max|Δ|=0). The targets arrive as a\n"
    buf = buf + " * double-encoded farr (token ids stored as doubles); each is rounded to\n"
    buf = buf + " * the nearest int64 vocab index.\n"
    buf = buf + " * ──────────────────────────────────────────────────────────────────── */\n"
    buf = buf + "__global__ void _hx_k_ce_seed(const double* __restrict__ L,\n"
    buf = buf + "                              const double* __restrict__ TGT,\n"
    buf = buf + "                              double* __restrict__ OUT_LOSS,\n"
    buf = buf + "                              double* __restrict__ OUT_DL,\n"
    buf = buf + "                              int64_t R, int64_t V) {\n"
    buf = buf + "    int64_t r = blockIdx.x;\n"
    buf = buf + "    if (r >= R) return;\n"
    buf = buf + "    const double* lr = L + r * V;\n"
    buf = buf + "    double*       dr = OUT_DL + r * V;\n"
    buf = buf + "\n"
    buf = buf + "    __shared__ double smem[HX_RR_BLOCK / 32];\n"
    buf = buf + "\n"
    buf = buf + "    /* target index for this row (double-encoded → rounded int64). */\n"
    buf = buf + "    int64_t tgt = (int64_t)(TGT[r] + (TGT[r] >= 0.0 ? 0.5 : -0.5));\n"
    buf = buf + "\n"
    buf = buf + "    /* Pass 1: row max. */\n"
    buf = buf + "    double vmax = -1.0e308;\n"
    buf = buf + "    for (int64_t j = threadIdx.x; j < V; j += blockDim.x) {\n"
    buf = buf + "        double v = lr[j];\n"
    buf = buf + "        if (v > vmax) vmax = v;\n"
    buf = buf + "    }\n"
    buf = buf + "    double m = _hx_block_max(vmax, smem);\n"
    buf = buf + "\n"
    buf = buf + "    /* Pass 2: write exp(x - m) into dlogits, accumulate sum-exp. */\n"
    buf = buf + "    double vsum = 0.0;\n"
    buf = buf + "    for (int64_t j = threadIdx.x; j < V; j += blockDim.x) {\n"
    buf = buf + "        double e = exp(lr[j] - m);\n"
    buf = buf + "        dr[j] = e;\n"
    buf = buf + "        vsum += e;\n"
    buf = buf + "    }\n"
    buf = buf + "    double s   = _hx_block_sum(vsum, smem);\n"
    buf = buf + "    double inv = (s > 0.0) ? (1.0 / s) : 0.0;\n"
    buf = buf + "\n"
    buf = buf + "    /* CE loss for this row = lse - L[target] = (m + log s) - L[target].\n"
    buf = buf + "     * One thread (lane 0 of block) writes OUT_LOSS[r]; guard tgt range. */\n"
    buf = buf + "    if (threadIdx.x == 0) {\n"
    buf = buf + "        double lse = m + log(s);\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "        double lt  = (tgt >= 0 && tgt < V) ? lr[tgt] : 0.0;\n"
    buf = buf + "        OUT_LOSS[r] = lse - lt;\n"
    buf = buf + "    }\n"
    buf = buf + "\n"
    buf = buf + "    /* Pass 3: normalize → softmax, then subtract onehot(target). */\n"
    buf = buf + "    for (int64_t j = threadIdx.x; j < V; j += blockDim.x) {\n"
    buf = buf + "        double p = dr[j] * inv;\n"
    buf = buf + "        if (j == tgt) p -= 1.0;\n"
    buf = buf + "        dr[j] = p;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ────────────────────────────────────────────────────────────────────\n"
    buf = buf + " * Kernel 1b (flame Phase 4-D-9, ADDITIVE — RFC 058 12→13→14 precedent)\n"
    buf = buf + " * ────────────────────────────────────────────────────────────────────\n"
    buf = buf + " * causal_softmax_rows: per-row causal-prefix softmax for the attention\n"
    buf = buf + " * block (tool/flame_phase4d7_block_fwd_primitive.c L767-789). For row i,\n"
    buf = buf + " * with the causal prefix length L = i+1:\n"
    buf = buf + " *\n"
    buf = buf + " *     m_max  = max_{j∈[0,L)}  X[i*T+j]\n"
    buf = buf + " *     e_j    = _hx_dt_exp_dev(X[i*T+j] - m_max)              j∈[0,L)\n"
    buf = buf + " *     tot    = Σ_{j∈[0,L)} e_j\n"
    buf = buf + " *     Y[i*T+j] = e_j / tot                                   j∈[0,L)\n"
    buf = buf + " *     Y[i*T+j] = 0.0                                         j∈[L,T)\n"
    buf = buf + " *\n"
    buf = buf + " * BYTE-EQ CONTRACT — the CPU reference uses `flame_g7_dt_exp`, a\n"
    buf = buf + " * deterministic 12-term-Taylor / range-halving polynomial, NOT libm\n"
    buf = buf + " * `exp()`. _hx_dt_exp_dev below is that algorithm ported VERBATIM\n"
    buf = buf + " * (same constants, same loop bounds 1..11 / 0..r-1, same order) so the\n"
    buf = buf + " * only numerical gap vs the CPU reference is the row-reduction reorder\n"
    buf = buf + " * (deterministic tree, ~1e-12 band), never an exp-algorithm error.\n"
    buf = buf + " *\n"
    buf = buf + " * The existing _hx_k_softmax_rows (Kernel 1 above) softmaxes the FULL\n"
    buf = buf + " * row with libm exp() and is UNTOUCHED — this is a separate, additive\n"
    buf = buf + " * kernel for the causal-masked attention path.\n"
    buf = buf + " * ──────────────────────────────────────────────────────────────────── */\n"
    buf = buf + "\n"
    buf = buf + "/* _hx_dt_exp_dev (flame_g7_dt_exp device port) is emitted ONCE near the\n"
    buf = buf + " * top of this TU (OP-19b canonical __device__ static def, before the\n"
    buf = buf + " * causal-softmax / GELU kernels). The previously-duplicated second\n"
    buf = buf + " * definition here was a hard nvcc redefinition error under -DHEXA_CUDA\n"
    buf = buf + " * (ing-cuda-build) — removed; the single canonical def is reachable from\n"
    buf = buf + " * every kernel below. */\n"
    buf = buf + "\n"
    buf = buf + "__global__ void _hx_cuda_kern_causal_softmax_rows(const double* __restrict__ X,\n"
    buf = buf + "                                                  double* __restrict__ Y,\n"
    buf = buf + "                                                  int64_t R, int64_t T) {\n"
    buf = buf + "    int64_t i = blockIdx.x;                 /* one block per row i */\n"
    buf = buf + "    if (i >= R) return;\n"
    buf = buf + "    const double* xr = X + i * T;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    double*       yr = Y + i * T;\n"
    buf = buf + "    int64_t L = i + 1;                      /* causal prefix length */\n"
    buf = buf + "\n"
    buf = buf + "    __shared__ double smem[HX_RR_BLOCK / 32];\n"
    buf = buf + "\n"
    buf = buf + "    /* Pass 1: max over the causal prefix [0, L). Threads outside the\n"
    buf = buf + "     * prefix contribute the -inf-equivalent identity (matches the CPU\n"
    buf = buf + "     * reference which seeds m_max = sc[i*T+0] and scans j∈[1,L)). */\n"
    buf = buf + "    double vmax = -1.0e308;\n"
    buf = buf + "    for (int64_t j = threadIdx.x; j < L; j += blockDim.x) {\n"
    buf = buf + "        double v = xr[j];\n"
    buf = buf + "        if (v > vmax) vmax = v;\n"
    buf = buf + "    }\n"
    buf = buf + "    double zmax = _hx_block_max(vmax, smem);\n"
    buf = buf + "\n"
    buf = buf + "    /* Pass 2: e_j = dt_exp(x - max) into Y[0,L); accumulate the prefix\n"
    buf = buf + "     * sum. j∈[L,T) is written exactly 0.0 (the CPU code only writes /\n"
    buf = buf + "     * normalizes [0,L) and leaves the rest of the Bc slab as its prior\n"
    buf = buf + "     * zeros — here Y is the dedicated output so we zero it explicitly). */\n"
    buf = buf + "    double vsum = 0.0;\n"
    buf = buf + "    for (int64_t j = threadIdx.x; j < T; j += blockDim.x) {\n"
    buf = buf + "        if (j < L) {\n"
    buf = buf + "            double e = _hx_dt_exp_dev(xr[j] - zmax);\n"
    buf = buf + "            yr[j] = e;\n"
    buf = buf + "            vsum += e;\n"
    buf = buf + "        } else {\n"
    buf = buf + "            yr[j] = 0.0;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    double tot = _hx_block_sum(vsum, smem);\n"
    buf = buf + "\n"
    buf = buf + "    /* Pass 3: normalize the causal prefix. The CPU reference divides\n"
    buf = buf + "     * (`Bc[oP+...] /= tot`) — use the SAME divide here (NOT a\n"
    buf = buf + "     * multiply-by-reciprocal) so the only residual numerical gap vs the\n"
    buf = buf + "     * CPU reference is the deterministic-tree reorder of m_max and tot.\n"
    buf = buf + "     * The CPU `tot` is always > 0 (≥ exp(0)=1 from the j=i diagonal),\n"
    buf = buf + "     * so no /0 guard is needed to mirror it; guard defensively anyway. */\n"
    buf = buf + "    for (int64_t j = threadIdx.x; j < L; j += blockDim.x) {\n"
    buf = buf + "        if (tot != 0.0) yr[j] = yr[j] / tot;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ────────────────────────────────────────────────────────────────────\n"
    buf = buf + " * Kernel 2 — rmsnorm_rows: Y[r,j] = X[r,j] / sqrt(mean_j(X²) + eps)\n"
    buf = buf + " *   One block per row; one reduction (sum of squares).\n"
    buf = buf + " * ──────────────────────────────────────────────────────────────────── */\n"
    buf = buf + "__global__ void _hx_k_rmsnorm_rows(const double* __restrict__ X,\n"
    buf = buf + "                                   double* __restrict__ Y,\n"
    buf = buf + "                                   int64_t R, int64_t C, double eps) {\n"
    buf = buf + "    int64_t r = blockIdx.x;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    if (r >= R) return;\n"
    buf = buf + "    const double* xr = X + r * C;\n"
    buf = buf + "    double*       yr = Y + r * C;\n"
    buf = buf + "\n"
    buf = buf + "    __shared__ double smem[HX_RR_BLOCK / 32];\n"
    buf = buf + "\n"
    buf = buf + "    double v = 0.0;\n"
    buf = buf + "    for (int64_t j = threadIdx.x; j < C; j += blockDim.x) {\n"
    buf = buf + "        double x = xr[j];\n"
    buf = buf + "        v += x * x;\n"
    buf = buf + "    }\n"
    buf = buf + "    double ss = _hx_block_sum(v, smem);\n"
    buf = buf + "    double ms = ss / (double)C;\n"
    buf = buf + "    double inv = 1.0 / sqrt(ms + eps);\n"
    buf = buf + "\n"
    buf = buf + "    for (int64_t j = threadIdx.x; j < C; j += blockDim.x) {\n"
    buf = buf + "        yr[j] = xr[j] * inv;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ────────────────────────────────────────────────────────────────────\n"
    buf = buf + " * Kernel 3 — rmsnorm_bwd_rows: exact dx-branch of RMSNorm vjp.\n"
    buf = buf + " *   inv  = (mean_j(x²)+ε)^(−1/2)\n"
    buf = buf + " *   dot  = Σ_k dxn_k · x_k\n"
    buf = buf + " *   dx_i = inv·dxn_i − (inv³·x_i / C)·dot\n"
    buf = buf + " *   ε = 1e-6 (mirrors CPU c3_rmsnorm_bwd contract).\n"
    buf = buf + " * Two reductions per row (ms = Σx², dot = Σdxn·x).\n"
    buf = buf + " * ──────────────────────────────────────────────────────────────────── */\n"
    buf = buf + "__global__ void _hx_k_rmsnorm_bwd_rows(const double* __restrict__ X,\n"
    buf = buf + "                                       const double* __restrict__ DXN,\n"
    buf = buf + "                                       double* __restrict__ O,\n"
    buf = buf + "                                       int64_t R, int64_t C) {\n"
    buf = buf + "    int64_t r = blockIdx.x;\n"
    buf = buf + "    if (r >= R) return;\n"
    buf = buf + "    const double* xr  = X   + r * C;\n"
    buf = buf + "    const double* dxr = DXN + r * C;\n"
    buf = buf + "    double*       orr = O   + r * C;\n"
    buf = buf + "\n"
    buf = buf + "    __shared__ double smem[HX_RR_BLOCK / 32];\n"
    buf = buf + "\n"
    buf = buf + "    /* Reduction 1: sum of squares. */\n"
    buf = buf + "    double ssq = 0.0;\n"
    buf = buf + "    for (int64_t j = threadIdx.x; j < C; j += blockDim.x) {\n"
    buf = buf + "        double x = xr[j];\n"
    buf = buf + "        ssq += x * x;\n"
    buf = buf + "    }\n"
    buf = buf + "    double ms_total = _hx_block_sum(ssq, smem);\n"
    buf = buf + "    double ms       = ms_total / (double)C;\n"
    buf = buf + "    double inv      = 1.0 / sqrt(ms + 1e-6);\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    /* Reduction 2: dot(dxn, x). */\n"
    buf = buf + "    double dotp = 0.0;\n"
    buf = buf + "    for (int64_t k = threadIdx.x; k < C; k += blockDim.x) {\n"
    buf = buf + "        dotp += dxr[k] * xr[k];\n"
    buf = buf + "    }\n"
    buf = buf + "    double dot  = _hx_block_sum(dotp, smem);\n"
    buf = buf + "    double coef = (inv * inv * inv) / (double)C;\n"
    buf = buf + "\n"
    buf = buf + "    /* Write dx. */\n"
    buf = buf + "    for (int64_t i = threadIdx.x; i < C; i += blockDim.x) {\n"
    buf = buf + "        orr[i] = inv * dxr[i] - coef * xr[i] * dot;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ────────────────────────────────────────────────────────────────────\n"
    buf = buf + " * Kernel 4 — adamw_step: decoupled-wd AdamW in-place.\n"
    buf = buf + " *   m_i  ← β1·m_i + (1-β1)·g_i\n"
    buf = buf + " *   v_i  ← β2·v_i + (1-β2)·g_i²\n"
    buf = buf + " *   mhat = m_i / (1-β1^t)\n"
    buf = buf + " *   vhat = v_i / (1-β2^t)\n"
    buf = buf + " *   W_i  ← W_i - lr·wd·W_i - lr·mhat/(sqrt(vhat)+eps)   (out → O[i])\n"
    buf = buf + " *   m, v updated in-place on their device buffers.\n"
    buf = buf + " * 1-D grid-stride; no cross-element reduction → bit-eq per element\n"
    buf = buf + " * (modulo sqrt ULP).\n"
    buf = buf + " * ──────────────────────────────────────────────────────────────────── */\n"
    buf = buf + "__global__ void _hx_k_adamw_step(double* __restrict__ W,\n"
    buf = buf + "                                 double* __restrict__ Mm,\n"
    buf = buf + "                                 double* __restrict__ Vv,\n"
    buf = buf + "                                 const double* __restrict__ G,\n"
    buf = buf + "                                 double* __restrict__ O,\n"
    buf = buf + "                                 int64_t n,\n"
    buf = buf + "                                 double lr, double b1, double b2,\n"
    buf = buf + "                                 double eps, double wd,\n"
    buf = buf + "                                 double c1, double c2) {\n"
    buf = buf + "    int64_t stride = (int64_t)blockDim.x * (int64_t)gridDim.x;\n"
    buf = buf + "    for (int64_t i = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;\n"
    buf = buf + "         i < n;\n"
    buf = buf + "         i += stride) {\n"
    buf = buf + "        double g    = G[i];\n"
    buf = buf + "        double mi   = b1 * Mm[i] + (1.0 - b1) * g;\n"
    buf = buf + "        double vi   = b2 * Vv[i] + (1.0 - b2) * g * g;\n"
    buf = buf + "        double mhat = mi / c1;\n"
    buf = buf + "        double vhat = vi / c2;\n"
    buf = buf + "        double denom = sqrt(vhat) + eps;\n"
    buf = buf + "        double wi   = W[i] - lr * wd * W[i] - lr * mhat / denom;\n"
    buf = buf + "        Mm[i] = mi;     /* in-place optimizer state */\n"
    buf = buf + "        Vv[i] = vi;\n"
    buf = buf + "        O[i]  = wi;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "\n"
    buf = buf + "/* In-place AdamW kernel — IDENTICAL arithmetic to _hx_k_adamw_step,\n"
    buf = buf + " * but W is both the read source AND the write destination (no separate\n"
    buf = buf + " * O). No `__restrict__` aliasing hazard (a single W pointer). Each\n"
    buf = buf + " * thread reads W[i] then writes W[i] within its own iteration → safe. */\n"
    buf = buf + "__global__ void _hx_k_adamw_step_inplace(double* __restrict__ W,\n"
    buf = buf + "                                 double* __restrict__ Mm,\n"
    buf = buf + "                                 double* __restrict__ Vv,\n"
    buf = buf + "                                 const double* __restrict__ G,\n"
    buf = buf + "                                 int64_t n,\n"
    buf = buf + "                                 double lr, double b1, double b2,\n"
    buf = buf + "                                 double eps, double wd,\n"
    buf = buf + "                                 double c1, double c2) {\n"
    buf = buf + "    int64_t stride = (int64_t)blockDim.x * (int64_t)gridDim.x;\n"
    buf = buf + "    for (int64_t i = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;\n"
    buf = buf + "         i < n;\n"
    buf = buf + "         i += stride) {\n"
    buf = buf + "        double g    = G[i];\n"
    buf = buf + "        double mi   = b1 * Mm[i] + (1.0 - b1) * g;\n"
    buf = buf + "        double vi   = b2 * Vv[i] + (1.0 - b2) * g * g;\n"
    buf = buf + "        double mhat = mi / c1;\n"
    buf = buf + "        double vhat = vi / c2;\n"
    buf = buf + "        double denom = sqrt(vhat) + eps;\n"
    buf = buf + "        double wi   = W[i] - lr * wd * W[i] - lr * mhat / denom;\n"
    buf = buf + "        Mm[i] = mi;     /* in-place optimizer state */\n"
    buf = buf + "        Vv[i] = vi;\n"
    buf = buf + "        W[i]  = wi;     /* W updated IN PLACE — no out buffer */\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ────────────────────────────────────────────────────────────────────\n"
    buf = buf + " * Kernel — packed_gemv_offset (small-dim fallback for cuBLAS Dgemv).\n"
    buf = buf + " *   out[i] = Σ_j P[off + i·cols + j] · U[j],  i in [0,rows).\n"
    buf = buf + " * Layout matches _hx_k_softmax_rows: one block per output row\n"
    buf = buf + " * (gridDim.x = rows), HX_RR_BLOCK threads stride across `cols`, then a\n"
    buf = buf + " * single block-sum reduction. Reduction order is the SAME fixed tree as\n"
    buf = buf + " * the softmax/ce kernels (warp-shfl → shared → re-reduce), NOT the\n"
    buf = buf + " * cuBLAS-tiled order — so this path carries the matmul tolerance caveat\n"
    buf = buf + " * (not bit-eq vs cuBLAS), same as the existing block-reduction kernels.\n"
    buf = buf + " * Used only when `rows` is small (see HEXA_GEMV_CUBLAS_MIN_ROWS gate in\n"
    buf = buf + " * the host wrapper); at small output dims the one-block-per-row launch\n"
    buf = buf + " * beats the cuBLAS Dgemv dispatch+sync cost (M7 RTX 5070 crossover).\n"
    buf = buf + " * ──────────────────────────────────────────────────────────────────── */\n"
    buf = buf + "__global__ void _hx_k_packed_gemv_offset(const double* __restrict__ P,\n"
    buf = buf + "                                 int64_t off,\n"
    buf = buf + "                                 const double* __restrict__ U,\n"
    buf = buf + "                                 double* __restrict__ O,\n"
    buf = buf + "                                 int64_t rows, int64_t cols) {\n"
    buf = buf + "    __shared__ double smem[HX_RR_BLOCK / 32];\n"
    buf = buf + "    int64_t r = (int64_t)blockIdx.x;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    if (r >= rows) return;\n"
    buf = buf + "    const double* row = P + off + r * cols;\n"
    buf = buf + "    double acc = 0.0;\n"
    buf = buf + "    for (int64_t j = (int64_t)threadIdx.x; j < cols; j += blockDim.x) {\n"
    buf = buf + "        acc += row[j] * U[j];\n"
    buf = buf + "    }\n"
    buf = buf + "    double total = _hx_block_sum(acc, smem);\n"
    buf = buf + "    if (threadIdx.x == 0) O[r] = total;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ────────────────────────────────────────────────────────────────────\n"
    buf = buf + " * HEXA-TRAIN-FLOOR M6 — fp32 dtype slice for packed_gemv_offset.\n"
    buf = buf + " *   out[i] = Σ_j P[off + i·cols + j] · U[j],  computed in fp32.\n"
    buf = buf + " *\n"
    buf = buf + " * SAME layout / reduction shape as _hx_k_packed_gemv_offset (one block\n"
    buf = buf + " * per output row, HX_RR_BLOCK threads stride `cols`, single block-sum),\n"
    buf = buf + " * but the per-thread products + accumulator are `float` (fp32) instead\n"
    buf = buf + " * of `double`. The device storage stays fp64 (_CudaFarrSlot.d_buf is\n"
    buf = buf + " * `double*`); each operand is narrowed fp64→fp32 AT THE LOAD and the\n"
    buf = buf + " * row dot-product reduces in fp32. The result is widened fp32→fp64 at\n"
    buf = buf + " * the store so the host ABI (packed-double farr) is unchanged.\n"
    buf = buf + " *\n"
    buf = buf + " * Why this is the M4-identified lever (HEXA-TRAIN-FLOOR.md §M4): the\n"
    buf = buf + " * trainer is fp64 COMPUTE-bound; the gemv contraction is the hot path.\n"
    buf = buf + " * fp32 multiply-accumulate runs at the device's fp32 throughput\n"
    buf = buf + " * (A100/5070: 32–64× the fp64 rate) — this kernel is the first slice\n"
    buf = buf + " * that exercises that rate without touching the fp64 storage layout.\n"
    buf = buf + " *\n"
    buf = buf + " * ACCURACY CAVEAT (opt-in only): fp32 has a 24-bit mantissa vs fp64's\n"
    buf = buf + " * 53-bit; the accumulator carries ~7 significant decimal digits. For a\n"
    buf = buf + " * length-`cols` dot product the relative error grows ~cols·2^-24. This\n"
    buf = buf + " * is mixed-precision training territory — it DOES perturb convergence\n"
    buf = buf + " * and is therefore OFF BY DEFAULT (HEXA_TRAIN_DTYPE unset/`fp64` keeps\n"
    buf = buf + " * the exact fp64 path). No bit-eq vs the fp64 reference is claimed; the\n"
    buf = buf + " * caller opts in only when the fp32 throughput win outweighs the loss\n"
    buf = buf + " * of mantissa bits (the M6→M7 measurement gate decides that per model).\n"
    buf = buf + " * ──────────────────────────────────────────────────────────────────── */\n"
    buf = buf + "__device__ __forceinline__ float _hx_warp_sum_f(float v) {\n"
    buf = buf + "    for (int offset = 16; offset > 0; offset >>= 1) {\n"
    buf = buf + "        v += __shfl_down_sync(0xFFFFFFFFu, v, offset);\n"
    buf = buf + "    }\n"
    buf = buf + "    return v;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "__device__ __forceinline__ float _hx_block_sum_f(float v, float* smem) {\n"
    buf = buf + "    int lane = threadIdx.x & 31;\n"
    buf = buf + "    int wid  = threadIdx.x >> 5;\n"
    buf = buf + "    v = _hx_warp_sum_f(v);\n"
    buf = buf + "    if (lane == 0) smem[wid] = v;\n"
    buf = buf + "    __syncthreads();\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    int n_warps = (blockDim.x + 31) >> 5;\n"
    buf = buf + "    if (wid == 0) {\n"
    buf = buf + "        float w = (lane < n_warps) ? smem[lane] : 0.0f;\n"
    buf = buf + "        w = _hx_warp_sum_f(w);\n"
    buf = buf + "        if (lane == 0) smem[0] = w;\n"
    buf = buf + "    }\n"
    buf = buf + "    __syncthreads();\n"
    buf = buf + "    return smem[0];\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "__global__ void _hx_k_packed_gemv_offset_f32(const double* __restrict__ P,\n"
    buf = buf + "                                 int64_t off,\n"
    buf = buf + "                                 const double* __restrict__ U,\n"
    buf = buf + "                                 double* __restrict__ O,\n"
    buf = buf + "                                 int64_t rows, int64_t cols) {\n"
    buf = buf + "    __shared__ float smem[HX_RR_BLOCK / 32];\n"
    buf = buf + "    int64_t r = (int64_t)blockIdx.x;\n"
    buf = buf + "    if (r >= rows) return;\n"
    buf = buf + "    const double* row = P + off + r * cols;\n"
    buf = buf + "    float acc = 0.0f;\n"
    buf = buf + "    for (int64_t j = (int64_t)threadIdx.x; j < cols; j += blockDim.x) {\n"
    buf = buf + "        /* narrow fp64→fp32 at load; multiply-accumulate in fp32. */\n"
    buf = buf + "        acc += (float)row[j] * (float)U[j];\n"
    buf = buf + "    }\n"
    buf = buf + "    float total = _hx_block_sum_f(acc, smem);\n"
    buf = buf + "    if (threadIdx.x == 0) O[r] = (double)total;  /* widen fp32→fp64 store */\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ────────────────────────────────────────────────────────────────────\n"
    buf = buf + " * HEXA-TRAIN-FLOOR bf16 lever — bf16 dtype slice for packed_gemv_offset.\n"
    buf = buf + " *   out[i] = Σ_j P[off + i·cols + j] · U[j],  operands cast to bf16,\n"
    buf = buf + " *   multiply-accumulated in fp32 (mixed precision, FP32 accumulator).\n"
    buf = buf + " *\n"
    buf = buf + " * SAME block-per-row / HX_RR_BLOCK-stride / single-block-sum shape as the\n"
    buf = buf + " * M6 fp32 sibling _hx_k_packed_gemv_offset_f32; the ONLY change is the\n"
    buf = buf + " * per-operand narrowing: fp64 → __nv_bfloat16 (RNE via __double2bfloat16)\n"
    buf = buf + " * → fp32 product. The accumulator + block reduction stay fp32 (the same\n"
    buf = buf + " * CUBLAS_COMPUTE_32F discipline the RFC 049 cublasGemmEx bf16 path uses)\n"
    buf = buf + " * for convergence stability — bf16 has only an 8-bit mantissa, so a\n"
    buf = buf + " * bf16 accumulator would lose almost all precision over a length-`cols`\n"
    buf = buf + " * dot product. Storage stays fp64 (d_buf is double*) so the host ABI is\n"
    buf = buf + " * unchanged; this is the COMPUTE-precision slice, not a storage rewrite.\n"
    buf = buf + " *\n"
    buf = buf + " * Why bf16 (vs the M6 fp32 lever): bf16 multiply feeds the device's bf16\n"
    buf = buf + " * units; on a TensorCore-class GPU (A100 / RTX 5070) the bf16 rate is the\n"
    buf = buf + " * full mixed-precision throughput the M4 roofline identified as the fp64\n"
    buf = buf + " * ceiling-break. This per-row reduction kernel exercises bf16 *scalar*\n"
    buf = buf + " * math (not WMMA tiles — see the honest-scope note in the dispatcher);\n"
    buf = buf + " * the WMMA / cublasGemmEx TENSOR_OP route is the RFC 049 substrate\n"
    buf = buf + " * (_hx_gemm_ex_bf16 in the #include'd runtime_bf16.c), reachable once the\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + " * gemm operands live in bf16 storage tiles (residual scope).\n"
    buf = buf + " *\n"
    buf = buf + " * ACCURACY CAVEAT (opt-in only): bf16 keeps 8 mantissa bits (~2-3 sig\n"
    buf = buf + " * decimal digits per operand) — strictly coarser than fp32's 24. NOT\n"
    buf = buf + " * bit-eq vs fp64; perturbs convergence more than fp32. OFF BY DEFAULT\n"
    buf = buf + " * (HEXA_TRAIN_DTYPE unset/`fp64`). Measured accuracy: max|rel| ~1.3e-2\n"
    buf = buf + " * for cols>=128 (RTX 5070, fp32 accumulator working as designed).\n"
    buf = buf + " *\n"
    buf = buf + " * MEASURED PERF — 🔴 NOT RECOMMENDED for the gemv shape\n"
    buf = buf + " * (.verdicts/hexa-train-floor/bf16-lever.txt, RTX 5070): this in-place\n"
    buf = buf + " * bf16-MAC kernel is SLOWER than fp64/fp32 (bf16/f64 0.85–5.67x latency).\n"
    buf = buf + " * The per-element __double2bfloat16 narrowing adds cost on a memory-\n"
    buf = buf + " * bound per-row reduction, and scalar bf16 math does NOT engage Tensor-\n"
    buf = buf + " * Core (which needs WMMA tile ops). The bf16 ceiling-break (24.9–123x\n"
    buf = buf + " * vs fp64) lives in the square-GEMM cublasGemmEx TENSOR_OP path — the\n"
    buf = buf + " * RFC 049 _hx_gemm_ex_bf16 substrate — reachable only with bf16 STORAGE\n"
    buf = buf + " * tiles (residual M9+). This kernel is landed opt-in for completeness +\n"
    buf = buf + " * dtype-selector parity, NOT as a recommended speedup. fp32 (M6) stays\n"
    buf = buf + " * the best in-place lever (f32/f64 0.66–0.94).\n"
    buf = buf + " * ──────────────────────────────────────────────────────────────────── */\n"
    buf = buf + "__global__ void _hx_k_packed_gemv_offset_bf16(const double* __restrict__ P,\n"
    buf = buf + "                                 int64_t off,\n"
    buf = buf + "                                 const double* __restrict__ U,\n"
    buf = buf + "                                 double* __restrict__ O,\n"
    buf = buf + "                                 int64_t rows, int64_t cols) {\n"
    buf = buf + "    __shared__ float smem[HX_RR_BLOCK / 32];\n"
    buf = buf + "    int64_t r = (int64_t)blockIdx.x;\n"
    buf = buf + "    if (r >= rows) return;\n"
    buf = buf + "    const double* row = P + off + r * cols;\n"
    buf = buf + "    float acc = 0.0f;\n"
    buf = buf + "    for (int64_t j = (int64_t)threadIdx.x; j < cols; j += blockDim.x) {\n"
    buf = buf + "        /* narrow fp64→bf16 (RNE) at load; product widens to fp32; the\n"
    buf = buf + "         * accumulator stays fp32 (CUBLAS_COMPUTE_32F discipline). */\n"
    buf = buf + "        __nv_bfloat16 a = __double2bfloat16(row[j]);\n"
    buf = buf + "        __nv_bfloat16 b = __double2bfloat16(U[j]);\n"
    buf = buf + "        acc += __bfloat162float(a) * __bfloat162float(b);\n"
    buf = buf + "    }\n"
    buf = buf + "    float total = _hx_block_sum_f(acc, smem);\n"
    buf = buf + "    if (threadIdx.x == 0) O[r] = (double)total;  /* widen fp32→fp64 store */\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "#endif /* __CUDACC__ — kernel bodies (compiled by nvcc only) */\n"
    buf = buf + "\n"
    buf = buf + "/* ════════════════════════════════════════════════════════════════════\n"
    buf = buf + " * Host wrappers — match the extern decls in self/runtime.c §10941-10954\n"
    buf = buf + " * (Phase B) and §11181-11200 (Phase B2). Signature: caller owns the\n"
    buf = buf + " * pre-allocated out_id farr; we return 0 ok / -1 err.\n"
    buf = buf + " * ════════════════════════════════════════════════════════════════════ */\n"
    buf = buf + "\n"
    buf = buf + "int _hx_cuda_farr_softmax_rows_gpu(int64_t x_id, int64_t R, int64_t C,\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "                                   int64_t out_id) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (R <= 0 || C <= 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] softmax_rows: bad shape R=%lld C=%lld\\n\",\n"
    buf = buf + "                (long long)R, (long long)C);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_h2d(x_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(out_id, R * C) != 0) return -1;\n"
    buf = buf + "    const double* X = g_slots[x_id].d_buf;\n"
    buf = buf + "    double*       Y = g_slots[out_id].d_buf;\n"
    buf = buf + "    dim3 grid((unsigned)R), block(HX_RR_BLOCK);\n"
    buf = buf + "    _hx_k_softmax_rows<<<grid, block>>>(X, Y, R, C);\n"
    buf = buf + "    cudaError_t er = cudaDeviceSynchronize();\n"
    buf = buf + "    if (er != cudaSuccess) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] softmax_rows launch failed: %s\\n\",\n"
    buf = buf + "                cudaGetErrorString(er));\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    return _d2h_out(out_id, R * C);\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)x_id; (void)R; (void)C; (void)out_id;\n"
    buf = buf + "    fprintf(stderr, \"[cuda] softmax_rows: built without __CUDACC__ \"\n"
    buf = buf + "                    \"(use nvcc -x cu)\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ── ce_seed host wrapper (RFC gpu-resident-large-vocab-lmhead-loss).\n"
    buf = buf + " * GPU-resident large-vocab lm-head CE loss + seed grad in ONE kernel.\n"
    buf = buf + " * Mirrors _hx_cuda_farr_softmax_rows_gpu's contract: validate → H2D the\n"
    buf = buf + " * two inputs (logits[R*V], targets[R]) → _ensure_dev_alloc_out for the\n"
    buf = buf + " * two caller-allocated outputs (out_loss[R], out_dlogits[R*V]) → launch\n"
    buf = buf + " * one block-per-row kernel → cudaDeviceSynchronize → D2H both outputs.\n"
    buf = buf + " * The logits farr is the lm-head matmul output that STAYS device-\n"
    buf = buf + " * resident (the RFC's whole point — no 78M H2D round-trip); _h2d() sees\n"
    buf = buf + " * it DEVICE && !dirty_host and SKIPs the redundant copy (RFC 056 §6.1).\n"
    buf = buf + " * loss is per-row (caller sums R values on host). Returns 0 ok / -1. */\n"
    buf = buf + "int _hx_cuda_farr_ce_seed_gpu(int64_t logits_id, int64_t target_ids_id,\n"
    buf = buf + "                              int64_t R, int64_t V,\n"
    buf = buf + "                              int64_t out_loss_id, int64_t out_dlogits_id) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (R <= 0 || V <= 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] ce_seed: bad shape R=%lld V=%lld\\n\",\n"
    buf = buf + "                (long long)R, (long long)V);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_h2d(logits_id) != 0)     return -1;\n"
    buf = buf + "    if (_h2d(target_ids_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(out_loss_id, R) != 0)         return -1;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    if (_ensure_dev_alloc_out(out_dlogits_id, R * V) != 0)  return -1;\n"
    buf = buf + "    const double* L   = g_slots[logits_id].d_buf;\n"
    buf = buf + "    const double* TGT = g_slots[target_ids_id].d_buf;\n"
    buf = buf + "    double* OUT_LOSS  = g_slots[out_loss_id].d_buf;\n"
    buf = buf + "    double* OUT_DL    = g_slots[out_dlogits_id].d_buf;\n"
    buf = buf + "    dim3 grid((unsigned)R), block(HX_RR_BLOCK);\n"
    buf = buf + "    _hx_k_ce_seed<<<grid, block>>>(L, TGT, OUT_LOSS, OUT_DL, R, V);\n"
    buf = buf + "    cudaError_t er = cudaDeviceSynchronize();\n"
    buf = buf + "    if (er != cudaSuccess) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] ce_seed launch failed: %s\\n\",\n"
    buf = buf + "                cudaGetErrorString(er));\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_d2h_out(out_loss_id, R) != 0)        return -1;\n"
    buf = buf + "    return _d2h_out(out_dlogits_id, R * V);\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)logits_id; (void)target_ids_id; (void)R; (void)V;\n"
    buf = buf + "    (void)out_loss_id; (void)out_dlogits_id;\n"
    buf = buf + "    fprintf(stderr, \"[cuda] ce_seed: built without __CUDACC__ \"\n"
    buf = buf + "                    \"(use nvcc -x cu)\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ────────────────────────────────────────────────────────────────────\n"
    buf = buf + " * BC-ANIMA M3 (2026-05-28): seed-only CE gradient kernel (5-arg).\n"
    buf = buf + " *\n"
    buf = buf + " *   row r ∈ [0,R), softmax S[r,*] over columns C:\n"
    buf = buf + " *     dlogits[r,c] = S[r,c] - onehot(c == target[r])\n"
    buf = buf + " *\n"
    buf = buf + " * Lighter sibling of _hx_k_ce_seed (which fuses loss + seed + softmax).\n"
    buf = buf + " * Used when softmax is already computed via M2 farr_softmax_rows. Single\n"
    buf = buf + " * pass — no reductions. One block per row; HX_RR_BLOCK threads stride C.\n"
    buf = buf + " * ──────────────────────────────────────────────────────────────────── */\n"
    buf = buf + "__global__ void _hx_k_ce_seed_only(const double* __restrict__ S,\n"
    buf = buf + "                                   const double* __restrict__ TGT,\n"
    buf = buf + "                                   double* __restrict__ DL,\n"
    buf = buf + "                                   int64_t R, int64_t C) {\n"
    buf = buf + "    int64_t r = blockIdx.x;\n"
    buf = buf + "    if (r >= R) return;\n"
    buf = buf + "    const double* sr = S + r * C;\n"
    buf = buf + "    double*       dr = DL + r * C;\n"
    buf = buf + "    int64_t tgt = (int64_t)(TGT[r] + (TGT[r] >= 0.0 ? 0.5 : -0.5));\n"
    buf = buf + "    for (int64_t c = threadIdx.x; c < C; c += blockDim.x) {\n"
    buf = buf + "        double p = sr[c];\n"
    buf = buf + "        if (c == tgt) p -= 1.0;\n"
    buf = buf + "        dr[c] = p;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "/* ── BC-ANIMA M3 (2026-05-28): farr_ce_seed host wrapper.\n"
    buf = buf + " * 5-arg seed-only CE gradient — softmax precomputed (anima M2). H2D\n"
    buf = buf + " * the two inputs (softmax[R*C], targets[R]) → _ensure_dev_alloc_out\n"
    buf = buf + " * for caller-allocated dlogits[R*C] → launch slim block-per-row kernel\n"
    buf = buf + " * → cudaDeviceSynchronize → D2H dlogits. Returns 0 ok / -1. */\n"
    buf = buf + "int _hx_cuda_farr_ce_seed(int64_t softmax_id, int64_t target_ids_id,\n"
    buf = buf + "                          int64_t dlogits_id,\n"
    buf = buf + "                          int64_t R, int64_t C) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (R <= 0 || C <= 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] ce_seed_only: bad shape R=%lld C=%lld\\n\",\n"
    buf = buf + "                (long long)R, (long long)C);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_h2d(softmax_id) != 0)    return -1;\n"
    buf = buf + "    if (_h2d(target_ids_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(dlogits_id, R * C) != 0) return -1;\n"
    buf = buf + "    const double* S   = g_slots[softmax_id].d_buf;\n"
    buf = buf + "    const double* TGT = g_slots[target_ids_id].d_buf;\n"
    buf = buf + "    double*       DL  = g_slots[dlogits_id].d_buf;\n"
    buf = buf + "    dim3 grid((unsigned)R), block(HX_RR_BLOCK);\n"
    buf = buf + "    _hx_k_ce_seed_only<<<grid, block>>>(S, TGT, DL, R, C);\n"
    buf = buf + "    cudaError_t er = cudaDeviceSynchronize();\n"
    buf = buf + "    if (er != cudaSuccess) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] ce_seed_only launch failed: %s\\n\",\n"
    buf = buf + "                cudaGetErrorString(er));\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    return _d2h_out(dlogits_id, R * C);\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)softmax_id; (void)target_ids_id; (void)dlogits_id;\n"
    buf = buf + "    (void)R; (void)C;\n"
    buf = buf + "    fprintf(stderr, \"[cuda] ce_seed_only: built without __CUDACC__ \"\n"
    buf = buf + "                    \"(use nvcc -x cu)\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ── causal_softmax_rows host wrapper (flame Phase 4-D-9, the 14th\n"
    buf = buf + " * kernel — ADDITIVE; the 12 verified kernels + RFC 058 13th + all\n"
    buf = buf + " * existing wrappers are UNTOUCHED). Mirrors _hx_cuda_farr_softmax_rows_\n"
    buf = buf + " * gpu EXACTLY: validate → _h2d(x) → _ensure_dev_alloc_out(R*T) → launch\n"
    buf = buf + " * → cudaDeviceSynchronize/cudaGetLastError → _d2h_out(R*T) → mark. The\n"
    buf = buf + " * X buffer is R×T causal scores; Y[i*T+j] = softmax over [0,i+1) (the\n"
    buf = buf + " * causal prefix), 0.0 for j ≥ i+1. Per-row reduction is the same\n"
    buf = buf + " * deterministic _hx_block_max/_hx_block_sum tree as Kernel 1. */\n"
    buf = buf + "int _hx_cuda_farr_causal_softmax_rows_gpu(int64_t x_id, int64_t R,\n"
    buf = buf + "                                          int64_t T, int64_t out_id) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (R <= 0 || T <= 0) {\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "        fprintf(stderr, \"[cuda] causal_softmax_rows: bad shape \"\n"
    buf = buf + "                \"R=%lld T=%lld\\n\", (long long)R, (long long)T);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_h2d(x_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(out_id, R * T) != 0) return -1;\n"
    buf = buf + "    const double* X = g_slots[x_id].d_buf;\n"
    buf = buf + "    double*       Y = g_slots[out_id].d_buf;\n"
    buf = buf + "    dim3 grid((unsigned)R), block(HX_RR_BLOCK);\n"
    buf = buf + "    _hx_cuda_kern_causal_softmax_rows<<<grid, block>>>(X, Y, R, T);\n"
    buf = buf + "    cudaError_t er = cudaDeviceSynchronize();\n"
    buf = buf + "    if (er != cudaSuccess) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] causal_softmax_rows launch failed: %s\\n\",\n"
    buf = buf + "                cudaGetErrorString(er));\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    return _d2h_out(out_id, R * T);\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)x_id; (void)R; (void)T; (void)out_id;\n"
    buf = buf + "    fprintf(stderr, \"[cuda] causal_softmax_rows: built without __CUDACC__ \"\n"
    buf = buf + "                    \"(use nvcc -x cu)\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "int _hx_cuda_farr_rmsnorm_rows_gpu(int64_t x_id, int64_t R, int64_t C,\n"
    buf = buf + "                                   double eps, int64_t out_id) {\n"
