    buf = buf + "                (long long)R, (long long)C);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (!(eps >= 0.0)) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] rmsnorm_rows: bad eps %g\\n\", eps);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_h2d(x_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(out_id, R * C) != 0) return -1;\n"
    buf = buf + "    const double* X = g_slots[x_id].d_buf;\n"
    buf = buf + "    double*       Y = g_slots[out_id].d_buf;\n"
    buf = buf + "    dim3 grid((unsigned)R), block(HX_RR_BLOCK);\n"
    buf = buf + "    _hx_k_rmsnorm_rows<<<grid, block>>>(X, Y, R, C, eps);\n"
    buf = buf + "    cudaError_t er = cudaDeviceSynchronize();\n"
    buf = buf + "    if (er != cudaSuccess) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] rmsnorm_rows launch failed: %s\\n\",\n"
    buf = buf + "                cudaGetErrorString(er));\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    return _d2h_out(out_id, R * C);\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "#else\n"
    buf = buf + "    (void)x_id; (void)R; (void)C; (void)eps; (void)out_id;\n"
    buf = buf + "    fprintf(stderr, \"[cuda] rmsnorm_rows: built without __CUDACC__\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "int _hx_cuda_farr_rmsnorm_bwd_rows_gpu(int64_t x_id, int64_t dxn_id,\n"
    buf = buf + "                                       int64_t R, int64_t C,\n"
    buf = buf + "                                       int64_t out_id) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (R <= 0 || C <= 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] rmsnorm_bwd: bad shape R=%lld C=%lld\\n\",\n"
    buf = buf + "                (long long)R, (long long)C);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_h2d(x_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(dxn_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(out_id, R * C) != 0) return -1;\n"
    buf = buf + "    const double* X   = g_slots[x_id].d_buf;\n"
    buf = buf + "    const double* DXN = g_slots[dxn_id].d_buf;\n"
    buf = buf + "    double*       O   = g_slots[out_id].d_buf;\n"
    buf = buf + "    dim3 grid((unsigned)R), block(HX_RR_BLOCK);\n"
    buf = buf + "    _hx_k_rmsnorm_bwd_rows<<<grid, block>>>(X, DXN, O, R, C);\n"
    buf = buf + "    cudaError_t er = cudaDeviceSynchronize();\n"
    buf = buf + "    if (er != cudaSuccess) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] rmsnorm_bwd launch failed: %s\\n\",\n"
    buf = buf + "                cudaGetErrorString(er));\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    return _d2h_out(out_id, R * C);\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)x_id; (void)dxn_id; (void)R; (void)C; (void)out_id;\n"
    buf = buf + "    fprintf(stderr, \"[cuda] rmsnorm_bwd: built without __CUDACC__\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "int _hx_cuda_farr_adamw_step_gpu(int64_t w_id, int64_t m_id,\n"
    buf = buf + "                                  int64_t v_id, int64_t g_id,\n"
    buf = buf + "                                  int64_t n, double lr, double b1,\n"
    buf = buf + "                                  double b2, double eps, double wd,\n"
    buf = buf + "                                  int64_t step_t, int64_t out_id) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (n <= 0 || step_t < 1) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] adamw_step: bad n=%lld step_t=%lld\\n\",\n"
    buf = buf + "                (long long)n, (long long)step_t);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    /* H2D for ALL four operands. W/m/v get updated (in-place on device);\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "     * we then D2H W back to the CALLER's out buf and ALSO D2H m,v back\n"
    buf = buf + "     * to their host bufs so the optimizer-state contract holds\n"
    buf = buf + "     * (CPU oracle updates m,v in place on the host buffers). */\n"
    buf = buf + "    if (_h2d(w_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(m_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(v_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(g_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(out_id, n) != 0) return -1;\n"
    buf = buf + "\n"
    buf = buf + "    /* Compute c1 = 1 - β1^t, c2 = 1 - β2^t on host (deterministic,\n"
    buf = buf + "     * matches CPU oracle's per-step repeated mul: see runtime.c\n"
    buf = buf + "     * §11419-11422). */\n"
    buf = buf + "    double b1t = 1.0, b2t = 1.0;\n"
    buf = buf + "    for (int64_t e = 0; e < step_t; e++) { b1t *= b1; b2t *= b2; }\n"
    buf = buf + "    double c1 = 1.0 - b1t;\n"
    buf = buf + "    double c2 = 1.0 - b2t;\n"
    buf = buf + "\n"
    buf = buf + "    double* W  = g_slots[w_id].d_buf;\n"
    buf = buf + "    double* Mm = g_slots[m_id].d_buf;\n"
    buf = buf + "    double* Vv = g_slots[v_id].d_buf;\n"
    buf = buf + "    const double* G = g_slots[g_id].d_buf;\n"
    buf = buf + "    double* O  = g_slots[out_id].d_buf;\n"
    buf = buf + "\n"
    buf = buf + "    /* 1-D grid-stride: ~256 threads/block, blocks = min(1024, ceil(n/256)).\n"
    buf = buf + "     * Cap at 1024 blocks to keep stride pattern compact + deterministic. */\n"
    buf = buf + "    int block_sz = 256;\n"
    buf = buf + "    int64_t want_blocks = (n + block_sz - 1) / block_sz;\n"
    buf = buf + "    int grid_sz = (want_blocks > 1024) ? 1024 : (int)want_blocks;\n"
    buf = buf + "    if (grid_sz < 1) grid_sz = 1;\n"
    buf = buf + "\n"
    buf = buf + "    _hx_k_adamw_step<<<grid_sz, block_sz, 0, _forge_stream()>>>(W, Mm, Vv, G, O, n,\n"
    buf = buf + "                                            lr, b1, b2, eps, wd, c1, c2);\n"
    buf = buf + "    cudaError_t er = cudaDeviceSynchronize();\n"
    buf = buf + "    if (er != cudaSuccess) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] adamw_step launch failed: %s\\n\",\n"
    buf = buf + "                cudaGetErrorString(er));\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    /* Write back W (out_id) AND in-place-updated m, v (their own ids). */\n"
    buf = buf + "    if (_d2h_out(out_id, n) != 0) return -1;\n"
    buf = buf + "    if (_d2h(m_id) != 0)          return -1;\n"
    buf = buf + "    if (_d2h(v_id) != 0)          return -1;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)w_id; (void)m_id; (void)v_id; (void)g_id;\n"
    buf = buf + "    (void)n; (void)lr; (void)b1; (void)b2; (void)eps; (void)wd;\n"
    buf = buf + "    (void)step_t; (void)out_id;\n"
    buf = buf + "    fprintf(stderr, \"[cuda] adamw_step: built without __CUDACC__\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* In-place AdamW host wrapper — no fresh device output buffer; W is\n"
    buf = buf + " * updated in place on its own device slot (out == W). H2D W/m/v/g,\n"
    buf = buf + " * launch _hx_k_adamw_step_inplace, then D2H W AND m,v back to host\n"
    buf = buf + " * (optimizer-state contract). Byte-eq to _hx_cuda_farr_adamw_step_gpu\n"
    buf = buf + " * with out_id == w_id (same arithmetic, O ≡ W). Returns 0 ok / -1. */\n"
    buf = buf + "int _hx_cuda_farr_adamw_step_inplace_gpu(int64_t w_id, int64_t m_id,\n"
    buf = buf + "                                  int64_t v_id, int64_t g_id,\n"
    buf = buf + "                                  int64_t n, double lr, double b1,\n"
    buf = buf + "                                  double b2, double eps, double wd,\n"
    buf = buf + "                                  int64_t step_t) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (n <= 0 || step_t < 1) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] adamw_step_inplace: bad n=%lld step_t=%lld\\n\",\n"
    buf = buf + "                (long long)n, (long long)step_t);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_h2d(w_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(m_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(v_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(g_id) != 0) return -1;\n"
    buf = buf + "\n"
    buf = buf + "    double b1t = 1.0, b2t = 1.0;\n"
    buf = buf + "    for (int64_t e = 0; e < step_t; e++) { b1t *= b1; b2t *= b2; }\n"
    buf = buf + "    double c1 = 1.0 - b1t;\n"
    buf = buf + "    double c2 = 1.0 - b2t;\n"
    buf = buf + "\n"
    buf = buf + "    double* W  = g_slots[w_id].d_buf;\n"
    buf = buf + "    double* Mm = g_slots[m_id].d_buf;\n"
    buf = buf + "    double* Vv = g_slots[v_id].d_buf;\n"
    buf = buf + "    const double* G = g_slots[g_id].d_buf;\n"
    buf = buf + "\n"
    buf = buf + "    int block_sz = 256;\n"
    buf = buf + "    int64_t want_blocks = (n + block_sz - 1) / block_sz;\n"
    buf = buf + "    int grid_sz = (want_blocks > 1024) ? 1024 : (int)want_blocks;\n"
    buf = buf + "    if (grid_sz < 1) grid_sz = 1;\n"
    buf = buf + "\n"
    buf = buf + "    _hx_k_adamw_step_inplace<<<grid_sz, block_sz, 0, _forge_stream()>>>(W, Mm, Vv, G, n,\n"
    buf = buf + "                                            lr, b1, b2, eps, wd, c1, c2);\n"
    buf = buf + "    cudaError_t er = cudaDeviceSynchronize();\n"
    buf = buf + "    if (er != cudaSuccess) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] adamw_step_inplace launch failed: %s\\n\",\n"
    buf = buf + "                cudaGetErrorString(er));\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    /* Write back the in-place-updated W, m, v to their host buffers. */\n"
    buf = buf + "    if (_d2h(w_id) != 0) return -1;\n"
    buf = buf + "    if (_d2h(m_id) != 0) return -1;\n"
    buf = buf + "    if (_d2h(v_id) != 0) return -1;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)w_id; (void)m_id; (void)v_id; (void)g_id;\n"
    buf = buf + "    (void)n; (void)lr; (void)b1; (void)b2; (void)eps; (void)wd;\n"
    buf = buf + "    (void)step_t;\n"
    buf = buf + "    fprintf(stderr, \"[cuda] adamw_step_inplace: built without __CUDACC__\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ════════════════════════════════════════════════════════════════════════\n"
    buf = buf + " * HEXA-FUSION M2 (FULL-STEP) — fused cooperative AdamW over ALL params.\n"
    buf = buf + " * ════════════════════════════════════════════════════════════════════════\n"
    buf = buf + " * The clm_prod training step ends with ~36 SEPARATE _adam(W_i,...) calls,\n"
    buf = buf + " * each a distinct <<<>>> kernel launch with its own launch+sync gap. With\n"
    buf = buf + " * the host on the critical path between every micro-launch, the optimizer\n"
    buf = buf + " * TAIL of the step under-fills the H100 exactly like the fwd glue DAG P1\n"
    buf = buf + " * attacked. M2 collapses ALL param updates into ONE cooperativeLaunch:\n"
    buf = buf + " * the grid strides over the CONCATENATION of every param tensor (prefix-\n"
    buf = buf + " * offset lookup per global index), so 36 launches → 1 persistent grid,\n"
    buf = buf + " * host fully off the optimizer critical path. Arithmetic is BYTE-IDENTICAL\n"
    buf = buf + " * to _hx_k_adamw_step_inplace (same per-element AdamW; each tensor carries\n"
    buf = buf + " * its own bias-correction c1/c2 since they share the same global step_t).\n"
    buf = buf + " * This is the M2 full-step lever's first landed chunk — the optimizer step\n"
    buf = buf + " * fused inside a cooperative launch alongside P1's fwd megakernel. */\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "#define HX_FS_MAXP 64   /* max param tensors in one fused AdamW launch */\n"
    buf = buf + "struct _HxAdamFused {\n"
    buf = buf + "    double* W[HX_FS_MAXP];\n"
    buf = buf + "    double* Mm[HX_FS_MAXP];\n"
    buf = buf + "    double* Vv[HX_FS_MAXP];\n"
    buf = buf + "    const double* G[HX_FS_MAXP];\n"
    buf = buf + "    int64_t off[HX_FS_MAXP + 1];  /* prefix-sum offsets; off[np]=total */\n"
    buf = buf + "    int np;\n"
    buf = buf + "    double lr, b1, b2, eps, wd, c1, c2;\n"
    buf = buf + "};\n"
    buf = buf + "/* Cooperative fused-AdamW. ONE persistent grid strides over off[np] total\n"
    buf = buf + " * elements; for each global idx, find the owning tensor p (off[p]<=idx<\n"
    buf = buf + " * off[p+1]) then run the IDENTICAL AdamW update on element (idx-off[p]).\n"
    buf = buf + " * grid.sync() is unnecessary (no cross-element dependency) but the launch\n"
    buf = buf + " * is cooperative so it composes with the full-step megakernel chain and\n"
    buf = buf + " * incurs exactly ONE launch for the whole optimizer tail. */\n"
    buf = buf + "__global__ void _hx_k_adamw_fused(_HxAdamFused f) {\n"
    buf = buf + "    int64_t total = f.off[f.np];\n"
    buf = buf + "    int64_t stride = (int64_t)gridDim.x * blockDim.x;\n"
    buf = buf + "    for (int64_t idx = (int64_t)blockIdx.x * blockDim.x + threadIdx.x;\n"
    buf = buf + "         idx < total; idx += stride) {\n"
    buf = buf + "        /* linear scan np<=64 — cheap, branch-coherent within a warp for the\n"
    buf = buf + "         * large contiguous tensors that dominate the element count. */\n"
    buf = buf + "        int p = 0;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "        while (p + 1 < f.np && idx >= f.off[p + 1]) p++;\n"
    buf = buf + "        int64_t i = idx - f.off[p];\n"
    buf = buf + "        double g    = f.G[p][i];\n"
    buf = buf + "        double mi   = f.b1 * f.Mm[p][i] + (1.0 - f.b1) * g;\n"
    buf = buf + "        double vi   = f.b2 * f.Vv[p][i] + (1.0 - f.b2) * g * g;\n"
    buf = buf + "        double mhat = mi / f.c1;\n"
    buf = buf + "        double vhat = vi / f.c2;\n"
    buf = buf + "        double denom = sqrt(vhat) + f.eps;\n"
    buf = buf + "        double wi   = f.W[p][i] - f.lr * f.wd * f.W[p][i] - f.lr * mhat / denom;\n"
    buf = buf + "        f.Mm[p][i] = mi;\n"
    buf = buf + "        f.Vv[p][i] = vi;\n"
    buf = buf + "        f.W[p][i]  = wi;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "#endif /* __CUDACC__ */\n"
    buf = buf + "/* Launcher — accepts up to HX_FS_MAXP (w,m,v,g,n) quintuples flattened into\n"
    buf = buf + " * parallel id arrays + a count. Resolves all to device buffers (H2D each),\n"
    buf = buf + " * builds the prefix-offset table, cooperativeLaunch ONE _hx_k_adamw_fused,\n"
    buf = buf + " * then D2H W/m/v for every tensor (same write-back contract as the per-\n"
    buf = buf + " * param inplace path). Returns 0 ok / -1 (→ caller falls back to the per-\n"
    buf = buf + " * param _adam loop, byte-eq). step_t/lr/b1/b2/eps/wd shared (clm uses one\n"
    buf = buf + " * global schedule). assert_eq unused (arithmetic is byte-eq by construction). */\n"
    buf = buf + "int _hx_cuda_farr_adamw_fused_gpu(const int64_t* w_ids, const int64_t* m_ids,\n"
    buf = buf + "                                  const int64_t* v_ids, const int64_t* g_ids,\n"
    buf = buf + "                                  const int64_t* ns, int np,\n"
    buf = buf + "                                  double lr, double b1, double b2,\n"
    buf = buf + "                                  double eps, double wd, int64_t step_t) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (np <= 0 || np > HX_FS_MAXP || step_t < 1) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] adamw_fused: bad np=%d step_t=%lld\\n\",\n"
    buf = buf + "                np, (long long)step_t);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    int dev = 0; cudaGetDevice(&dev);\n"
    buf = buf + "    int coop = 0;\n"
    buf = buf + "    cudaDeviceGetAttribute(&coop, cudaDevAttrCooperativeLaunch, dev);\n"
    buf = buf + "    if (!coop) { fprintf(stderr, \"[cuda] adamw_fused: no cooperativeLaunch\\n\"); return -1; }\n"
    buf = buf + "    for (int p = 0; p < np; p++) {\n"
    buf = buf + "        if (ns[p] <= 0) { fprintf(stderr, \"[cuda] adamw_fused: bad n[%d]\\n\", p); return -1; }\n"
    buf = buf + "        if (_h2d(w_ids[p]) != 0) return -1;\n"
    buf = buf + "        if (_h2d(m_ids[p]) != 0) return -1;\n"
    buf = buf + "        if (_h2d(v_ids[p]) != 0) return -1;\n"
    buf = buf + "        if (_h2d(g_ids[p]) != 0) return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    double b1t = 1.0, b2t = 1.0;\n"
    buf = buf + "    for (int64_t e = 0; e < step_t; e++) { b1t *= b1; b2t *= b2; }\n"
    buf = buf + "    _HxAdamFused f;\n"
    buf = buf + "    f.np = np; f.lr = lr; f.b1 = b1; f.b2 = b2; f.eps = eps; f.wd = wd;\n"
    buf = buf + "    f.c1 = 1.0 - b1t; f.c2 = 1.0 - b2t;\n"
    buf = buf + "    f.off[0] = 0;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    for (int p = 0; p < np; p++) {\n"
    buf = buf + "        f.W[p]  = g_slots[w_ids[p]].d_buf;\n"
    buf = buf + "        f.Mm[p] = g_slots[m_ids[p]].d_buf;\n"
    buf = buf + "        f.Vv[p] = g_slots[v_ids[p]].d_buf;\n"
    buf = buf + "        f.G[p]  = g_slots[g_ids[p]].d_buf;\n"
    buf = buf + "        f.off[p + 1] = f.off[p] + ns[p];\n"
    buf = buf + "    }\n"
    buf = buf + "    int blk = 256;\n"
    buf = buf + "    int numBlocksPerSm = 0;\n"
    buf = buf + "    cudaOccupancyMaxActiveBlocksPerMultiprocessor(&numBlocksPerSm,\n"
    buf = buf + "        (void*)_hx_k_adamw_fused, blk, 0);\n"
    buf = buf + "    if (numBlocksPerSm < 1) numBlocksPerSm = 1;\n"
    buf = buf + "    int numSm = 0; cudaDeviceGetAttribute(&numSm, cudaDevAttrMultiProcessorCount, dev);\n"
    buf = buf + "    if (numSm < 1) numSm = 1;\n"
    buf = buf + "    int grid_sz = numSm * numBlocksPerSm;\n"
    buf = buf + "    dim3 gdim(grid_sz), bdim(blk);\n"
    buf = buf + "    void* args[] = { (void*)&f };\n"
    buf = buf + "    cudaError_t le = cudaLaunchCooperativeKernel((void*)_hx_k_adamw_fused,\n"
    buf = buf + "                        gdim, bdim, args, 0, _forge_stream());\n"
    buf = buf + "    if (le != cudaSuccess) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] adamw_fused coop launch: %s\\n\", cudaGetErrorString(le));\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_forge_launch_check(\"adamw_fused\") != 0) return -1;\n"
    buf = buf + "    { static int _af_fired = 0; if (!_af_fired) { _af_fired = 1;\n"
    buf = buf + "        fprintf(stderr, \"[FULLSTEP-FIRED] _hx_k_adamw_fused cooperative AdamW over %d params in ONE launch (grid=%d blk=%d, optimizer tail collapsed)\\n\", np, grid_sz, blk); } }\n"
    buf = buf + "    for (int p = 0; p < np; p++) {\n"
    buf = buf + "        if (_d2h(w_ids[p]) != 0) return -1;\n"
    buf = buf + "        if (_d2h(m_ids[p]) != 0) return -1;\n"
    buf = buf + "        if (_d2h(v_ids[p]) != 0) return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)w_ids;(void)m_ids;(void)v_ids;(void)g_ids;(void)ns;(void)np;\n"
    buf = buf + "    (void)lr;(void)b1;(void)b2;(void)eps;(void)wd;(void)step_t;\n"
    buf = buf + "    fprintf(stderr, \"[cuda] adamw_fused: built without __CUDACC__\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ════════════════════════════════════════════════════════════════════\n"
    buf = buf + " * HEXA-FUSION L1 — device-resident moment lifetime (m, v).\n"
    buf = buf + " *\n"
    buf = buf + " * Identical arithmetic to _hx_cuda_farr_adamw_step_inplace_gpu, but the\n"
    buf = buf + " * Adam first/second moments m and v are kept DEVICE-RESIDENT across the\n"
    buf = buf + " * step boundary: NO D2H of m/v after the kernel. They are only ever\n"
    buf = buf + " * read + written by AdamW itself (never by the host fwd/bwd — in\n"
    buf = buf + " * clm_prod.hexa m_* / v_* escape ONLY into _adam), so there is no host\n"
    buf = buf + " * reader between steps and the device buffer is the sole authoritative\n"
    buf = buf + " * copy. W IS still D2H'd (the host forward re-quantizes the conv\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + " * weights, so W must materialize on host every step — contract kept).\n"
    buf = buf + " *\n"
    buf = buf + " * Residence contract for m/v after this call:\n"
    buf = buf + " *   loc = FARR_DEVICE, dirty_host = 0, live device slot, matching len.\n"
    buf = buf + " * The NEXT step's _h2d(m)/_h2d(v) then hits the RFC 056 §6.1 H2D-skip\n"
    buf = buf + " * (loc∈{DEVICE,MIRRORED} && !dirty_host && s->d_buf && s->len==e->len)\n"
    buf = buf + " * and SKIPs the cudaMemcpy HostToDevice — the device accumulator is\n"
    buf = buf + " * reused in place. We leave dirty_host=0 (NOT 1): host m/v is stale but\n"
    buf = buf + " * is provably never read, so the skip is byte-eq to the always-D2H\n"
    buf = buf + " * path — both leave the device holding the same fresh moments the next\n"
    buf = buf + " * kernel reads. Removes 2 (m,v) × 2 (D2H now + H2D next) cudaMemcpy per\n"
    buf = buf + " * param-tensor / step (pure roundtrip/boundary removal; NOT a kernel\n"
    buf = buf + " * speed claim). Gated in clm_prod.hexa behind env CLM_PROD_DEVRESIDENT;\n"
    buf = buf + " * default off → existing inplace path unchanged (F-CLM-DEVFEED-* 0.0). */\n"
    buf = buf + "int _hx_cuda_farr_adamw_step_inplace_keepmv_gpu(int64_t w_id, int64_t m_id,\n"
    buf = buf + "                                  int64_t v_id, int64_t g_id,\n"
    buf = buf + "                                  int64_t n, double lr, double b1,\n"
    buf = buf + "                                  double b2, double eps, double wd,\n"
    buf = buf + "                                  int64_t step_t) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (n <= 0 || step_t < 1) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] adamw_keepmv: bad n=%lld step_t=%lld\\n\",\n"
    buf = buf + "                (long long)n, (long long)step_t);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_h2d(w_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(m_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(v_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(g_id) != 0) return -1;\n"
    buf = buf + "\n"
    buf = buf + "    double b1t = 1.0, b2t = 1.0;\n"
    buf = buf + "    for (int64_t e = 0; e < step_t; e++) { b1t *= b1; b2t *= b2; }\n"
    buf = buf + "    double c1 = 1.0 - b1t;\n"
    buf = buf + "    double c2 = 1.0 - b2t;\n"
    buf = buf + "\n"
    buf = buf + "    double* W  = g_slots[w_id].d_buf;\n"
    buf = buf + "    double* Mm = g_slots[m_id].d_buf;\n"
    buf = buf + "    double* Vv = g_slots[v_id].d_buf;\n"
    buf = buf + "    const double* G = g_slots[g_id].d_buf;\n"
    buf = buf + "\n"
    buf = buf + "    int block_sz = 256;\n"
    buf = buf + "    int64_t want_blocks = (n + block_sz - 1) / block_sz;\n"
    buf = buf + "    int grid_sz = (want_blocks > 1024) ? 1024 : (int)want_blocks;\n"
    buf = buf + "    if (grid_sz < 1) grid_sz = 1;\n"
    buf = buf + "\n"
    buf = buf + "    _hx_k_adamw_step_inplace<<<grid_sz, block_sz, 0, _forge_stream()>>>(W, Mm, Vv, G, n,\n"
    buf = buf + "                                            lr, b1, b2, eps, wd, c1, c2);\n"
    buf = buf + "    cudaError_t er = cudaDeviceSynchronize();\n"
    buf = buf + "    if (er != cudaSuccess) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] adamw_keepmv launch failed: %s\\n\",\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "                cudaGetErrorString(er));\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    /* W materializes on host (host fwd reads it). m, v stay DEVICE-\n"
    buf = buf + "     * RESIDENT: mark loc=FARR_DEVICE, dirty_host=0 so the next step's\n"
    buf = buf + "     * _h2d SKIPs the H2D and reuses the device accumulator in place\n"
    buf = buf + "     * — host m/v never read (byte-eq to the always-D2H inplace path). */\n"
    buf = buf + "    if (_d2h(w_id) != 0) return -1;\n"
    buf = buf + "    {\n"
    buf = buf + "        HexaFarrEntry* em = &_hx_farr_table[m_id];\n"
    buf = buf + "        HexaFarrEntry* ev = &_hx_farr_table[v_id];\n"
    buf = buf + "        em->d_buf = (void*)g_slots[m_id].d_buf;\n"
    buf = buf + "        ev->d_buf = (void*)g_slots[v_id].d_buf;\n"
    buf = buf + "        em->loc = FARR_DEVICE; ev->loc = FARR_DEVICE;\n"
    buf = buf + "        em->dirty_host = 0;    ev->dirty_host = 0;\n"
    buf = buf + "        em->dirty_dev  = 0;    ev->dirty_dev  = 0;\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)w_id; (void)m_id; (void)v_id; (void)g_id;\n"
    buf = buf + "    (void)n; (void)lr; (void)b1; (void)b2; (void)eps; (void)wd;\n"
    buf = buf + "    (void)step_t;\n"
    buf = buf + "    fprintf(stderr, \"[cuda] adamw_keepmv: built without __CUDACC__\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ════════════════════════════════════════════════════════════════════\n"
    buf = buf + " * matmul_t and outer — cuBLAS Dgemm reshape (RFC 041 §1, proven exact\n"
    buf = buf + " * on real hardware for the outer case; same Dgemm path as Phase A\n"
    buf = buf + " * for matmul_t — TOL_MATMUL ≈ 2e-9 inherited).\n"
    buf = buf + " *\n"
    buf = buf + " * Row-major→column-major trick recap (same as _hx_cuda_farr_matmul_gpu):\n"
    buf = buf + " *   to compute row-major C[M,N] = A[M,K]·B[K,N] via column-major Dgemm,\n"
    buf = buf + " *   call cublasDgemm(N,N, m=N, n=M, k=K, alpha, B_dev, ldb=N,\n"
    buf = buf + " *                    A_dev, lda=K, beta, C_dev, ldc=N).\n"
    buf = buf + " * ════════════════════════════════════════════════════════════════════ */\n"
    buf = buf + "\n"
    buf = buf + "/* matmul_t: Mᵀ·u = [C].  M row-major [R,C], u [R], out [C].\n"
    buf = buf + " *\n"
    buf = buf + " * View as the matmul of u-as-row-vector with M:  out[1,C] = u[1,R] · M[R,C].\n"
    buf = buf + " * Plug into the row-major→col trick with M_outer=1, K=R, N=C:\n"
    buf = buf + " *   cublasDgemm(N, N, m=C, n=1, k=R, alpha, M_dev, ldb=C, U_dev, lda=R,\n"
    buf = buf + " *               beta, O_dev, ldc=C).\n"
    buf = buf + " * Reduction order: cuBLAS-tiled (NOT the CPU c3_matvec_t r-outer/k-inner\n"
    buf = buf + " * order) → reduction-tolerance applies. TOL_MATMUL ≈ 2e-9 (RFC 040 §2.2).\n"
    buf = buf + " */\n"
    buf = buf + "int _hx_cuda_farr_matmul_t_gpu(int64_t m_id, int64_t R, int64_t C,\n"
    buf = buf + "                               int64_t u_id, int64_t out_id) {\n"
    buf = buf + "    if (_ensure_cublas() != 0) return -1;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    if (R <= 0 || C <= 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] matmul_t: bad shape R=%lld C=%lld\\n\",\n"
    buf = buf + "                (long long)R, (long long)C);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_h2d(m_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(u_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(out_id, C) != 0) return -1;\n"
    buf = buf + "\n"
    buf = buf + "    double* M_dev = g_slots[m_id].d_buf;\n"
    buf = buf + "    double* U_dev = g_slots[u_id].d_buf;\n"
    buf = buf + "    double* O_dev = g_slots[out_id].d_buf;\n"
    buf = buf + "    const double alpha = 1.0, beta = 0.0;\n"
    buf = buf + "    /* HEXA_OWN_GEMM (CUDA-OWN) — reuse the in-file _hx_k_gemm row-major\n"
    buf = buf + "     * C=A·B kernel for out[1,C] = u[1,R] · M[R,C] (M_outer=1, K=R, N=C;\n"
    buf = buf + "     * A=U_dev[1,R], B=M_dev[R,C], C=O_dev[1,C]). NOT bit-eq vs cuBLAS\n"
    buf = buf + "     * (naive K-accum order vs cuBLAS-tiled) — rel-RMS within TOL_MATMUL,\n"
    buf = buf + "     * cuBLAS demoted to correctness oracle. OFF (default) keeps the exact\n"
    buf = buf + "     * cublasDgemm path below byte-identical to the prior build. */\n"
    buf = buf + "    if (_forge_own_gemm_on()) {\n"
    buf = buf + "        static int _own_matmult_fired = 0;\n"
    buf = buf + "        if (!_own_matmult_fired) { _own_matmult_fired = 1;\n"
    buf = buf + "            fprintf(stderr, \"[OWN-GEMM-FIRED] _hx_k_gemm (matmul_t) DEVICE path (no cuBLAS)\\n\"); }\n"
    buf = buf + "        dim3 _mblk(16, 16);\n"
    buf = buf + "        dim3 _mgrd((unsigned)((C + 15) / 16), 1u);\n"
    buf = buf + "        _hx_k_gemm<<<_mgrd, _mblk, 0, _forge_stream()>>>(U_dev, M_dev, O_dev,\n"
    buf = buf + "                                                         (int64_t)1, R, C);\n"
    buf = buf + "        if (_forge_launch_check(\"own_matmul_t\") != 0) return -1;\n"
    buf = buf + "        return _d2h_out(out_id, C);\n"
    buf = buf + "    }\n"
    buf = buf + "#ifdef HEXA_USE_CUBLAS\n"
    buf = buf + "    /* row-major: out[1·C] = u[1·R] · M[R·C]\n"
    buf = buf + "     * → cuBLAS Dgemm(N,N, m=C, n=1, k=R, alpha, M_dev, ldb=C, U_dev, lda=R,\n"
    buf = buf + "     *                beta, O_dev, ldc=C) */\n"
    buf = buf + "    cublasStatus_t st = cublasDgemm(g_cublas,\n"
    buf = buf + "                                    CUBLAS_OP_N, CUBLAS_OP_N,\n"
    buf = buf + "                                    (int)C, 1, (int)R,\n"
    buf = buf + "                                    &alpha,\n"
    buf = buf + "                                    M_dev, (int)C,\n"
    buf = buf + "                                    U_dev, (int)R,\n"
    buf = buf + "                                    &beta,\n"
    buf = buf + "                                    O_dev, (int)C);\n"
    buf = buf + "    if (st != CUBLAS_STATUS_SUCCESS) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] cublasDgemm(matmul_t) failed: %d\\n\", (int)st);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    return _d2h_out(out_id, C);\n"
    buf = buf + "#else\n"
    buf = buf + "    fprintf(stderr, \"[cuda] matmul_t: own path should have returned\\n\");\n"
    buf = buf + "    return -1;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* packed_gemv_offset: out[i] = Σ_j P[off + i·cols + j]·U[j], out[rows].\n"
    buf = buf + " * P is a packed-double buffer; the [rows×cols] row-major sub-block\n"
    buf = buf + " * starts at element `off`. anima mm_packed_gemv 1:1.\n"
    buf = buf + " *\n"
    buf = buf + " * cuBLAS sees the (row-major) sub-block P[off..] as a column-major\n"
    buf = buf + " * [cols×rows] matrix A with lda=cols. Then A^T (= [rows×cols], our\n"
    buf = buf + " * row-major block) times U[cols] gives out[rows]:\n"
    buf = buf + " *   cublasDgemv(handle, CUBLAS_OP_T, m=cols, n=rows, alpha,\n"
    buf = buf + " *               A=P_dev+off, lda=cols, U_dev, incx=1, beta,\n"
    buf = buf + " *               O_dev, incy=1).\n"
    buf = buf + " * Single dot-product per output row, cuBLAS-tiled reduction →\n"
    buf = buf + " * TOL_MATMUL ≈ 2e-9 (same caveat as matmul_t). H2D P once (whole\n"
    buf = buf + " * buffer), base+offset device pointer, D2H out. */\n"
    buf = buf + "/* HEXA-TRAIN-FLOOR M6/bf16 — training compute dtype selector (3-way).\n"
    buf = buf + " *   Reads HEXA_TRAIN_DTYPE once per call (cheap; process-stable in\n"
    buf = buf + " *   practice) and maps it to a compute-precision tier:\n"
    buf = buf + " *     HX_TRAIN_DTYPE_FP64 (0) — default / `fp64`/`f64`/`double`/unset\n"
    buf = buf + " *     HX_TRAIN_DTYPE_FP32 (1) — `fp32`/`f32`/`float`     (M6 slice)\n"
    buf = buf + " *     HX_TRAIN_DTYPE_BF16 (2) — `bf16`/`bfloat16`        (bf16 lever)\n"
    buf = buf + " *   Any UNRECOGNIZED value keeps fp64 — an unknown value NEVER silently\n"
    buf = buf + " *   downgrades precision (fail-safe to the exact path). Only fp64 is\n"
    buf = buf + " *   bit-eq vs the reference; fp32/bf16 are opt-in mixed precision. The\n"
    buf = buf + " *   bf16 tier here drives the in-place bf16-MAC gemv kernel (bf16\n"
    buf = buf + " *   operands, FP32 accumulator); the WMMA/cublasGemmEx TENSOR_OP route\n"
    buf = buf + " *   is the RFC 049 runtime_bf16.c substrate (residual scope). */\n"
    buf = buf + "enum { HX_TRAIN_DTYPE_FP64 = 0, HX_TRAIN_DTYPE_FP32 = 1, HX_TRAIN_DTYPE_BF16 = 2 };\n"
    buf = buf + "static int _hx_train_dtype(void) {\n"
    buf = buf + "    const char* d = getenv(\"HEXA_TRAIN_DTYPE\");\n"
    buf = buf + "    if (!d || !*d) return HX_TRAIN_DTYPE_FP64;\n"
    buf = buf + "    if (strcmp(d, \"fp32\")     == 0) return HX_TRAIN_DTYPE_FP32;\n"
    buf = buf + "    if (strcmp(d, \"f32\")      == 0) return HX_TRAIN_DTYPE_FP32;\n"
    buf = buf + "    if (strcmp(d, \"float\")    == 0) return HX_TRAIN_DTYPE_FP32;\n"
    buf = buf + "    if (strcmp(d, \"bf16\")     == 0) return HX_TRAIN_DTYPE_BF16;\n"
    buf = buf + "    if (strcmp(d, \"bfloat16\") == 0) return HX_TRAIN_DTYPE_BF16;\n"
    buf = buf + "    return HX_TRAIN_DTYPE_FP64;  /* fp64 / fp64-spellings / unknown → exact */\n"
    buf = buf + "}\n"
    buf = buf + "/* M6 back-compat shim — the fp32 predicate now delegates to the 3-way\n"
    buf = buf + " * selector (no behavior change for existing fp32 callers). */\n"
    buf = buf + "static int _hx_train_dtype_is_fp32(void) {\n"
    buf = buf + "    return _hx_train_dtype() == HX_TRAIN_DTYPE_FP32;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "int _hx_cuda_farr_packed_gemv_offset_gpu(int64_t p_id, int64_t off,\n"
    buf = buf + "                               int64_t rows, int64_t cols,\n"
    buf = buf + "                               int64_t u_id, int64_t out_id) {\n"
    buf = buf + "    if (rows <= 0 || cols <= 0 || off < 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] packed_gemv_offset: bad off=%lld rows=%lld cols=%lld\\n\",\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "                (long long)off, (long long)rows, (long long)cols);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_h2d(p_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(u_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(out_id, rows) != 0) return -1;\n"
    buf = buf + "\n"
    buf = buf + "    double* P_dev = g_slots[p_id].d_buf + off;\n"
    buf = buf + "    double* U_dev = g_slots[u_id].d_buf;\n"
    buf = buf + "    double* O_dev = g_slots[out_id].d_buf;\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    /* HEXA_OWN_GEMM (CUDA-OWN) — force the in-file FP64 on-device gemv\n"
    buf = buf + "     * kernel _hx_k_packed_gemv_offset (one block per output row, fixed\n"
    buf = buf + "     * block-tree reduction) regardless of the rows-size crossover gate\n"
    buf = buf + "     * below. This OWNS the cublasDgemv(packed_gemv_offset) call: under\n"
    buf = buf + "     * HEXA_OWN_GEMM the FP64 path never reaches cuBLAS. NOT bit-eq vs\n"
    buf = buf + "     * cuBLAS (block-tree reduction order vs cuBLAS-tiled) — rel-RMS within\n"
    buf = buf + "     * TOL_MATMUL, cuBLAS demoted to oracle. Checked before the dtype\n"
    buf = buf + "     * slices so own-FP64 wins for the default (fp64) dtype; the opt-in\n"
    buf = buf + "     * fp32/bf16 mixed-precision kernels still take precedence (a separate,\n"
    buf = buf + "     * deliberately-narrowed-precision choice). OFF (default) → falls\n"
    buf = buf + "     * through to the existing gate, byte-identical to the prior build. */\n"
    buf = buf + "    if (_forge_own_gemm_on() &&\n"
    buf = buf + "        _hx_train_dtype() == HX_TRAIN_DTYPE_FP64) {\n"
    buf = buf + "        static int _own_gemv_fired = 0;\n"
    buf = buf + "        if (!_own_gemv_fired) { _own_gemv_fired = 1;\n"
    buf = buf + "            fprintf(stderr, \"[OWN-GEMM-FIRED] _hx_k_packed_gemv_offset DEVICE path (no cuBLAS)\\n\"); }\n"
    buf = buf + "        dim3 grid_o((unsigned)rows), block_o(HX_RR_BLOCK);\n"
    buf = buf + "        _hx_k_packed_gemv_offset<<<grid_o, block_o>>>(g_slots[p_id].d_buf, off,\n"
    buf = buf + "                                                      U_dev, O_dev, rows, cols);\n"
    buf = buf + "        cudaError_t oer = cudaDeviceSynchronize();\n"
    buf = buf + "        if (oer != cudaSuccess) {\n"
    buf = buf + "            fprintf(stderr, \"[cuda] packed_gemv_offset own kernel failed: %s\\n\",\n"
    buf = buf + "                    cudaGetErrorString(oer));\n"
    buf = buf + "            return -1;\n"
    buf = buf + "        }\n"
    buf = buf + "        return _d2h_out(out_id, rows);\n"
    buf = buf + "    }\n"
    buf = buf + "    /* HEXA-TRAIN-FLOOR bf16 lever — bf16 dtype slice (opt-in). When\n"
    buf = buf + "     * HEXA_TRAIN_DTYPE selects bf16, run the bf16-MAC on-device gemv\n"
    buf = buf + "     * kernel: operands narrowed fp64→bf16 (RNE) at load, multiply-\n"
    buf = buf + "     * accumulated in fp32 (FP32 accumulator for convergence stability,\n"
    buf = buf + "     * mirroring the RFC 049 cublasGemmEx CUBLAS_COMPUTE_32F discipline).\n"
    buf = buf + "     * Exercises the device's bf16 throughput — the M4-identified fp64-\n"
    buf = buf + "     * compute-bound ceiling-break. Checked before fp32 (more aggressive\n"
    buf = buf + "     * precision opt-in). NOT bit-eq vs fp64; default keeps fp64. */\n"
    buf = buf + "    if (_hx_train_dtype() == HX_TRAIN_DTYPE_BF16) {\n"
    buf = buf + "        dim3 grid_b((unsigned)rows), block_b(HX_RR_BLOCK);\n"
    buf = buf + "        _hx_k_packed_gemv_offset_bf16<<<grid_b, block_b>>>(\n"
    buf = buf + "            g_slots[p_id].d_buf, off, U_dev, O_dev, rows, cols);\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "        cudaError_t ber = cudaDeviceSynchronize();\n"
    buf = buf + "        if (ber != cudaSuccess) {\n"
    buf = buf + "            fprintf(stderr, \"[cuda] packed_gemv_offset bf16 kernel failed: %s\\n\",\n"
    buf = buf + "                    cudaGetErrorString(ber));\n"
    buf = buf + "            return -1;\n"
    buf = buf + "        }\n"
    buf = buf + "        return _d2h_out(out_id, rows);\n"
    buf = buf + "    }\n"
    buf = buf + "    /* HEXA-TRAIN-FLOOR M6 — fp32 dtype slice (opt-in). When\n"
    buf = buf + "     * HEXA_TRAIN_DTYPE selects fp32, run the fp32-accumulating on-device\n"
    buf = buf + "     * gemv kernel: it narrows the fp64 device operands to fp32 at load\n"
    buf = buf + "     * and reduces in fp32, exercising the device's fp32 throughput (the\n"
    buf = buf + "     * M4-identified fp64-compute-bound lever). Independent of the cuBLAS\n"
    buf = buf + "     * min-dim sync gate below — fp32 is a COMPUTE-precision choice, not a\n"
    buf = buf + "     * dispatch-cost one. NOT bit-eq vs fp64 (mantissa loss); default\n"
    buf = buf + "     * (unset/fp64) keeps the exact fp64 path unchanged. */\n"
    buf = buf + "    if (_hx_train_dtype_is_fp32()) {\n"
    buf = buf + "        dim3 grid_f((unsigned)rows), block_f(HX_RR_BLOCK);\n"
    buf = buf + "        _hx_k_packed_gemv_offset_f32<<<grid_f, block_f>>>(\n"
    buf = buf + "            g_slots[p_id].d_buf, off, U_dev, O_dev, rows, cols);\n"
    buf = buf + "        cudaError_t fer = cudaDeviceSynchronize();\n"
    buf = buf + "        if (fer != cudaSuccess) {\n"
    buf = buf + "            fprintf(stderr, \"[cuda] packed_gemv_offset fp32 kernel failed: %s\\n\",\n"
    buf = buf + "                    cudaGetErrorString(fer));\n"
    buf = buf + "            return -1;\n"
    buf = buf + "        }\n"
    buf = buf + "        return _d2h_out(out_id, rows);\n"
    buf = buf + "    }\n"
    buf = buf + "    /* work-size gate (hexa-lang #1354, rekeyed by HEXA-TRAIN-FLOOR M8).\n"
    buf = buf + "     * The on-device kernel is one-block-per-row, so its true cost\n"
    buf = buf + "     * predictor is `rows` (= #blocks = output dim), NOT the contraction\n"
    buf = buf + "     * dim `cols`. M7 RTX 5070 microbench (.verdicts/hexa-train-floor/\n"
    buf = buf + "     * M7-gemv-dthreshold.txt): on-device beats cuBLAS Dgemv at rows<=256\n"
    buf = buf + "     * across ALL cols (f64/cuBLAS 0.63-0.99), but LOSES at rows=768\n"
    buf = buf + "     * (1.11-1.34x) even for cols=64 — so a cols<128 gate would regress\n"
    buf = buf + "     * large-output gemv. Rekeyed to rows: use the on-device block-\n"
    buf = buf + "     * reduction kernel only when rows < threshold; large rows keeps\n"
    buf = buf + "     * cuBLAS (regression-free). Default 512, between the measured\n"
    buf = buf + "     * win@256 and loss@768 crossover. Override via\n"
    buf = buf + "     * HEXA_GEMV_CUBLAS_MIN_ROWS; legacy HEXA_GEMV_CUBLAS_MIN_DIM still\n"
    buf = buf + "     * honored as an alias for back-compat. */\n"
    buf = buf + "    long min_rows = 512;\n"
    buf = buf + "    const char* _mr = getenv(\"HEXA_GEMV_CUBLAS_MIN_ROWS\");\n"
    buf = buf + "    if (!(_mr && *_mr)) _mr = getenv(\"HEXA_GEMV_CUBLAS_MIN_DIM\");\n"
    buf = buf + "    if (_mr && *_mr) { long v = atol(_mr); if (v > 0) min_rows = v; }\n"
    buf = buf + "    if (rows < min_rows) {\n"
    buf = buf + "        dim3 grid((unsigned)rows), block(HX_RR_BLOCK);\n"
    buf = buf + "        _hx_k_packed_gemv_offset<<<grid, block>>>(g_slots[p_id].d_buf, off,\n"
    buf = buf + "                                                  U_dev, O_dev, rows, cols);\n"
    buf = buf + "        cudaError_t ker = cudaDeviceSynchronize();\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "        if (ker != cudaSuccess) {\n"
    buf = buf + "            fprintf(stderr, \"[cuda] packed_gemv_offset kernel failed: %s\\n\",\n"
    buf = buf + "                    cudaGetErrorString(ker));\n"
    buf = buf + "            return -1;\n"
    buf = buf + "        }\n"
    buf = buf + "        return _d2h_out(out_id, rows);\n"
    buf = buf + "    }\n"
    buf = buf + "#ifndef HEXA_USE_CUBLAS\n"
    buf = buf + "    /* cuBLAS-free: large-rows also goes own (the own FP64 kernel fired above\n"
    buf = buf + "     * under _forge_own_gemm_on()==1, so this point is unreachable for CUDACC;\n"
    buf = buf + "     * run the own kernel here too for robustness, then return). */\n"
    buf = buf + "    {\n"
    buf = buf + "        dim3 grid((unsigned)rows), block(HX_RR_BLOCK);\n"
    buf = buf + "        _hx_k_packed_gemv_offset<<<grid, block>>>(g_slots[p_id].d_buf, off,\n"
    buf = buf + "                                                  U_dev, O_dev, rows, cols);\n"
    buf = buf + "        cudaError_t ker = cudaDeviceSynchronize();\n"
    buf = buf + "        if (ker != cudaSuccess) {\n"
    buf = buf + "            fprintf(stderr, \"[cuda] packed_gemv_offset own(large) failed: %s\\n\",\n"
    buf = buf + "                    cudaGetErrorString(ker));\n"
    buf = buf + "            return -1;\n"
    buf = buf + "        }\n"
    buf = buf + "        return _d2h_out(out_id, rows);\n"
    buf = buf + "    }\n"
    buf = buf + "#endif\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifdef HEXA_USE_CUBLAS\n"
    buf = buf + "    if (_ensure_cublas() != 0) return -1;\n"
    buf = buf + "    const double alpha = 1.0, beta = 0.0;\n"
    buf = buf + "    cublasStatus_t st = cublasDgemv(g_cublas, CUBLAS_OP_T,\n"
    buf = buf + "                                    (int)cols, (int)rows,\n"
    buf = buf + "                                    &alpha,\n"
    buf = buf + "                                    P_dev, (int)cols,\n"
    buf = buf + "                                    U_dev, 1,\n"
    buf = buf + "                                    &beta,\n"
    buf = buf + "                                    O_dev, 1);\n"
    buf = buf + "    if (st != CUBLAS_STATUS_SUCCESS) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] cublasDgemv(packed_gemv_offset) failed: %d\\n\", (int)st);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    return _d2h_out(out_id, rows);\n"
    buf = buf + "#else\n"
    buf = buf + "    fprintf(stderr, \"[cuda] packed_gemv_offset: no CUDA device path\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* outer: u⊗v = [R·C].  u [R], v [C], out row-major [R,C].\n"
    buf = buf + " *\n"
    buf = buf + " * out[R,C] = u[R,1] · v[1,C]. Plug into the trick with M_outer=R, K=1, N=C:\n"
    buf = buf + " *   cublasDgemm(N, N, m=C, n=R, k=1, alpha, V_dev, ldb=C, U_dev, lda=1,\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + " *               beta, O_dev, ldc=C).\n"
    buf = buf + " * K=1 → SINGLE product term per output cell → ZERO reduction →\n"
    buf = buf + " * BIT-EXACT vs CPU c3_outer (F-RFC041-OUTER-EXACT demands |Δ| = 0).\n"
    buf = buf + " */\n"
    buf = buf + "int _hx_cuda_farr_outer_gpu(int64_t u_id, int64_t v_id,\n"
    buf = buf + "                            int64_t R, int64_t C, int64_t out_id) {\n"
    buf = buf + "    if (_ensure_cublas() != 0) return -1;\n"
    buf = buf + "    if (R <= 0 || C <= 0) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] outer: bad shape R=%lld C=%lld\\n\",\n"
    buf = buf + "                (long long)R, (long long)C);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_h2d(u_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(v_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(out_id, R * C) != 0) return -1;\n"
    buf = buf + "\n"
    buf = buf + "    double* U_dev = g_slots[u_id].d_buf;\n"
    buf = buf + "    double* V_dev = g_slots[v_id].d_buf;\n"
    buf = buf + "    double* O_dev = g_slots[out_id].d_buf;\n"
    buf = buf + "    const double alpha = 1.0, beta = 0.0;\n"
    buf = buf + "    /* HEXA_OWN_GEMM (CUDA-OWN) — reuse the in-file _hx_k_gemm row-major\n"
    buf = buf + "     * C=A·B kernel for out[R,C] = u[R,1] · v[1,C] (M_outer=R, K=1, N=C;\n"
    buf = buf + "     * A=U_dev[R,1], B=V_dev[1,C], C=O_dev[R,C]). K=1 → SINGLE product per\n"
    buf = buf + "     * output cell → ZERO reduction → BIT-EXACT vs cuBLAS (and vs the CPU\n"
    buf = buf + "     * c3_outer oracle): max|Δ| = 0, same as the F-RFC041-OUTER-EXACT\n"
    buf = buf + "     * contract. OFF (default) keeps the exact cublasDgemm path byte-id. */\n"
    buf = buf + "    if (_forge_own_gemm_on()) {\n"
    buf = buf + "        static int _own_outer_fired = 0;\n"
    buf = buf + "        if (!_own_outer_fired) { _own_outer_fired = 1;\n"
    buf = buf + "            fprintf(stderr, \"[OWN-GEMM-FIRED] _hx_k_gemm (outer, k=1) DEVICE path (no cuBLAS)\\n\"); }\n"
    buf = buf + "        dim3 _oblk(16, 16);\n"
    buf = buf + "        dim3 _ogrd((unsigned)((C + 15) / 16), (unsigned)((R + 15) / 16));\n"
    buf = buf + "        _hx_k_gemm<<<_ogrd, _oblk, 0, _forge_stream()>>>(U_dev, V_dev, O_dev,\n"
    buf = buf + "                                                         R, (int64_t)1, C);\n"
    buf = buf + "        if (_forge_launch_check(\"own_outer\") != 0) return -1;\n"
    buf = buf + "        return _d2h_out(out_id, R * C);\n"
    buf = buf + "    }\n"
    buf = buf + "#ifdef HEXA_USE_CUBLAS\n"
    buf = buf + "    cublasStatus_t st = cublasDgemm(g_cublas,\n"
    buf = buf + "                                    CUBLAS_OP_N, CUBLAS_OP_N,\n"
    buf = buf + "                                    (int)C, (int)R, 1,\n"
    buf = buf + "                                    &alpha,\n"
    buf = buf + "                                    V_dev, (int)C,\n"
    buf = buf + "                                    U_dev, 1,\n"
    buf = buf + "                                    &beta,\n"
    buf = buf + "                                    O_dev, (int)C);\n"
    buf = buf + "    if (st != CUBLAS_STATUS_SUCCESS) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] cublasDgemm(outer) failed: %d\\n\", (int)st);\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    return _d2h_out(out_id, R * C);\n"
    buf = buf + "#else\n"
    buf = buf + "    fprintf(stderr, \"[cuda] outer: own path should have returned\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ══════════════════════════════════════════════════════════════════\n"
    buf = buf + " * RFC 041 Phase B — elementwise CUDA kernels (5 ops)\n"
    buf = buf + " *\n"
    buf = buf + " *   _hx_cuda_farr_add_gpu        C[i] = A[i] + B[i]\n"
    buf = buf + " *   _hx_cuda_farr_scale_gpu      Y[i] = α · X[i]\n"
    buf = buf + " *   _hx_cuda_farr_mul_gpu        C[i] = A[i] · B[i]   (Hadamard)\n"
    buf = buf + " *   _hx_cuda_farr_silu_gpu       Y[i] = X[i] · σ(X[i])\n"
    buf = buf + " *   _hx_cuda_farr_silu_grad_gpu  Y[i] = σ(X[i]) · (1 + X[i] · (1 − σ(X[i])))\n"
    buf = buf + " *\n"
    buf = buf + " * Math contract — bit-identical to the CPU oracles\n"
    buf = buf + " * (`self/runtime.c` `_hx_farr_{add,scale,mul,silu,silu_grad}_cpu`):\n"
    buf = buf + " *   - add / scale / mul: no cross-thread reduction → falsifier demands\n"
    buf = buf + " *     `|Δ| = 0` exact vs the CPU loop (F-RFC041-ADD-EXACT,\n"
    buf = buf + " *     -SCALE-EXACT, -MUL-EXACT).\n"
    buf = buf + " *   - silu / silu_grad: per-element transcendental (`exp` in fp64);\n"
    buf = buf + " *     tolerance is the f64 `exp` ULP — `TOL_ELEM` per RFC 041\n"
    buf = buf + " *     §\"Falsifier battery\" (F-RFC041-SILU-EQ, -SILU-GRAD-EQ).\n"
    buf = buf + " *\n"
    buf = buf + " * ABI — each host wrapper matches the existing `extern int _hx_cuda_*`\n"
    buf = buf + " * forward-decl in `self/runtime.c` (lines 10950-10953, 11188-11192).\n"
    buf = buf + " * Output farr_id is caller-allocated (host-side `hexa_farr_zeros`); this\n"
    buf = buf + " * TU H2D's inputs, ensures the device output slot is sized, launches the\n"
    buf = buf + " * kernel on the default stream, D2H's the result back, and marks the\n"
    buf = buf + " * output entry MIRRORED/clean — mirrors the Phase A `_hx_cuda_farr_matmul_gpu`\n"
    buf = buf + " * residence protocol.\n"
    buf = buf + " *\n"
    buf = buf + " * Determinism — 1-D grid-stride elementwise; no atomics, no cross-thread\n"
    buf = buf + " * reduction; the output for thread `i` is a pure function of input[i]\n"
    buf = buf + " * (and α for scale). Hence run-to-run byte-identical\n"
    buf = buf + " * (F-RFC041-DETERMINISM extends trivially here).\n"
    buf = buf + " *\n"
    buf = buf + " * Honest caveats:\n"
    buf = buf + " *   - `exp()` device-side resolves to the CUDA math device library\n"
    buf = buf + " *     fp64 `exp` (matches host libm fp64 `exp` to within 1 ULP per the\n"
    buf = buf + " *     CUDA math API contract; the silu falsifier framing accounts for\n"
    buf = buf + " *     this — `TOL_ELEM`, not bit-exact).\n"
    buf = buf + " *   - No tensor-core / mixed-precision path here; this is the strict\n"
    buf = buf + " *     fp64 elementwise reference. A bf16 / fp16 variant is RFC 044+/049.\n"
    buf = buf + " *   - Host wrappers compile only under `#ifdef HEXA_CUDA` (Mac no-CUDA\n"
    buf = buf + " *     build is unchanged — the wrapper symbols are simply absent;\n"
    buf = buf + " *     `self/runtime.c`'s `hexa_farr_*_gpu` dispatcher already returns\n"
    buf = buf + " *     -1 from the CUDA branch when the symbol isn't wired by the\n"
    buf = buf + " *     caller path, preserving the F-RFC041-NO-CUDA-FALLBACK contract).\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + " *\n"
    buf = buf + " * Kernel launch geometry — block=256, grid=min((n+255)/256, 65535).\n"
    buf = buf + " * Grid-stride loop covers any n (no upper bound from grid cap).\n"
    buf = buf + " *\n"
    buf = buf + " * The `__global__` kernels and `cudaLaunchKernel`-style `<<<...>>>`\n"
    buf = buf + " * launch syntax require the TU to be compiled with nvcc (CUDA C++) or\n"
    buf = buf + " * with clang's `-x cuda --cuda-path=...` mode. The build-system rename\n"
    buf = buf + " * `runtime_cuda.c` → `runtime_cuda.cu` (or nvcc `-x cu`) is the\n"
    buf = buf + " * concern of Phase 4-D-5-3 (CUDA-host link verify). This TU stays\n"
    buf = buf + " * `*.c` for the no-CUDA path — every existing build remains\n"
    buf = buf + " * byte-identical when HEXA_CUDA is undefined (the entire Phase B\n"
    buf = buf + " * elementwise block below is inside `#ifdef HEXA_CUDA`).\n"
    buf = buf + " * ══════════════════════════════════════════════════════════════════ */\n"
    buf = buf + "\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "\n"
    buf = buf + "/* Default 1-D launch geometry. 256 threads/block balances occupancy on\n"
    buf = buf + " * SM 7.0+ (V100/A100/H100) without wasting SM resources on the simple\n"
    buf = buf + " * elementwise body; grid is capped at 65535 blocks (well under any\n"
    buf = buf + " * device's gridDim.x max — 2^31-1 on SM 3.0+, but 65535 fits the\n"
    buf = buf + " * grid-stride loop naturally and avoids over-subscription for small n).\n"
    buf = buf + " */\n"
    buf = buf + "#define _HX_CUDA_ELEM_BLOCK 256\n"
    buf = buf + "#define _HX_CUDA_ELEM_MAX_GRID 65535\n"
    buf = buf + "\n"
    buf = buf + "static int _hx_cuda_elem_grid(int64_t n) {\n"
    buf = buf + "    int64_t blocks = (n + (_HX_CUDA_ELEM_BLOCK - 1)) / _HX_CUDA_ELEM_BLOCK;\n"
    buf = buf + "    if (blocks < 1) blocks = 1;\n"
    buf = buf + "    if (blocks > _HX_CUDA_ELEM_MAX_GRID) blocks = _HX_CUDA_ELEM_MAX_GRID;\n"
    buf = buf + "    return (int)blocks;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* Ensure the device-side slot for `id` has an allocated buffer of `len`\n"
    buf = buf + " * doubles. Re-allocs if size changed. Returns 0 ok / -1 err. */\n"
    buf = buf + "static int _ensure_dev_buf(int64_t id, int64_t len) {\n"
    buf = buf + "    if (id < 0 || len <= 0) return -1;\n"
    buf = buf + "    if (_ensure_slot_cap(id) != 0) return -1;\n"
    buf = buf + "    _CudaFarrSlot* s = &g_slots[id];\n"
    buf = buf + "    if (!s->d_buf || s->len != len) {\n"
    buf = buf + "        if (s->d_buf) cudaFree(s->d_buf);\n"
    buf = buf + "        cudaError_t er = cudaMalloc((void**)&s->d_buf,\n"
    buf = buf + "                                    (size_t)len * sizeof(double));\n"
    buf = buf + "        if (er != cudaSuccess) {\n"
    buf = buf + "            fprintf(stderr, \"[cuda] cudaMalloc(%lld doubles) failed: %s\\n\",\n"
    buf = buf + "                    (long long)len, cudaGetErrorString(er));\n"
    buf = buf + "            s->d_buf = NULL; s->len = 0;\n"
    buf = buf + "            return -1;\n"
    buf = buf + "        }\n"
    buf = buf + "        s->len = len;\n"
    buf = buf + "    }\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* D2H copy `len` doubles from device slot `id` to its host buf, then\n"
    buf = buf + " * mark MIRRORED/clean. Returns 0 ok / -1 err.\n"
    buf = buf + " * (Agent #25 Phase B elementwise variant with bounds checks; the Phase B\n"
    buf = buf + " *  reduction code uses the simpler `_d2h_out` at line 403. Renamed here\n"
    buf = buf + " *  to avoid redefinition.) */\n"
    buf = buf + "static int _d2h_out_elem(int64_t id, int64_t len) {\n"
    buf = buf + "    if (id < 0 || id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (id >= g_slot_cap)               return -1;\n"
    buf = buf + "    HexaFarrEntry* e = &_hx_farr_table[id];\n"
    buf = buf + "    _CudaFarrSlot* s = &g_slots[id];\n"
    buf = buf + "    if (!e->buf || !s->d_buf || e->len < len || s->len < len) return -1;\n"
    buf = buf + "    /* RFC 056 §6.1/§6.4 D2H-defer — same contract as _d2h_out. Default\n"
    buf = buf + "     * FORGE_OUT_HOST_NOW = byte-identical to the verified substrate. */\n"
    buf = buf + "    if (_forge_out_keep()) {\n"
    buf = buf + "        e->d_buf      = (void*)s->d_buf;\n"
    buf = buf + "        e->loc        = FARR_DEVICE;\n"
    buf = buf + "        /* residency-fix (same bug as _d2h_out): device-keep output is\n"
    buf = buf + "         * NOT user-mutated. dirty_host=1 here blocked the _h2d skip\n"
    buf = buf + "         * (!dirty_host) so the next op re-uploaded the never-written host\n"
    buf = buf + "         * buffer, clobbering this device output with stale zeros. loc=\n"
    buf = buf + "         * FARR_DEVICE + dirty_dev=1 already track host-staleness. */\n"
    buf = buf + "        e->dirty_host = 0;\n"
    buf = buf + "        e->dirty_dev  = 1;\n"
    buf = buf + "        return 0;\n"
    buf = buf + "    }\n"
    buf = buf + "    cudaError_t er = cudaMemcpy(e->buf, s->d_buf,\n"
    buf = buf + "                                (size_t)len * sizeof(double),\n"
    buf = buf + "                                cudaMemcpyDeviceToHost);\n"
    buf = buf + "    if (er != cudaSuccess) {\n"
    buf = buf + "        fprintf(stderr, \"[cuda] cudaMemcpy elem D2H failed: %s\\n\",\n"
    buf = buf + "                cudaGetErrorString(er));\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    e->d_buf      = (void*)s->d_buf;\n"
    buf = buf + "    e->loc        = FARR_MIRRORED;\n"
    buf = buf + "    e->dirty_host = 0;\n"
    buf = buf + "    e->dirty_dev  = 0;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ── __global__ kernels (1-D grid-stride, fp64) ────────────────────── */\n"
    buf = buf + "\n"
    buf = buf + "__global__ void _hx_cuda_kern_add(const double* __restrict__ A,\n"
    buf = buf + "                                  const double* __restrict__ B,\n"
    buf = buf + "                                  double* __restrict__ C,\n"
    buf = buf + "                                  int64_t n) {\n"
    buf = buf + "    int64_t i      = (int64_t)blockIdx.x * (int64_t)blockDim.x + (int64_t)threadIdx.x;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    int64_t stride = (int64_t)gridDim.x  * (int64_t)blockDim.x;\n"
    buf = buf + "    for (; i < n; i += stride) {\n"
    buf = buf + "        C[i] = A[i] + B[i];\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "__global__ void _hx_cuda_kern_scale(const double* __restrict__ X,\n"
    buf = buf + "                                    double alpha,\n"
    buf = buf + "                                    double* __restrict__ Y,\n"
    buf = buf + "                                    int64_t n) {\n"
    buf = buf + "    int64_t i      = (int64_t)blockIdx.x * (int64_t)blockDim.x + (int64_t)threadIdx.x;\n"
    buf = buf + "    int64_t stride = (int64_t)gridDim.x  * (int64_t)blockDim.x;\n"
    buf = buf + "    for (; i < n; i += stride) {\n"
    buf = buf + "        Y[i] = alpha * X[i];\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "__global__ void _hx_cuda_kern_mul(const double* __restrict__ A,\n"
    buf = buf + "                                  const double* __restrict__ B,\n"
    buf = buf + "                                  double* __restrict__ C,\n"
    buf = buf + "                                  int64_t n) {\n"
    buf = buf + "    int64_t i      = (int64_t)blockIdx.x * (int64_t)blockDim.x + (int64_t)threadIdx.x;\n"
    buf = buf + "    int64_t stride = (int64_t)gridDim.x  * (int64_t)blockDim.x;\n"
    buf = buf + "    for (; i < n; i += stride) {\n"
    buf = buf + "        C[i] = A[i] * B[i];\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* σ(x) = 1 / (1 + exp(-x)), fp64 device math. Matches the CPU\n"
    buf = buf + " * `_hx_sigmoid_d` (host libm `exp`) to within the CUDA fp64 `exp` ULP. */\n"
    buf = buf + "__device__ __forceinline__ double _hx_cuda_sigmoid_d(double x) {\n"
    buf = buf + "    return 1.0 / (1.0 + exp(-x));\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "__global__ void _hx_cuda_kern_silu(const double* __restrict__ X,\n"
    buf = buf + "                                   double* __restrict__ Y,\n"
    buf = buf + "                                   int64_t n) {\n"
    buf = buf + "    int64_t i      = (int64_t)blockIdx.x * (int64_t)blockDim.x + (int64_t)threadIdx.x;\n"
    buf = buf + "    int64_t stride = (int64_t)gridDim.x  * (int64_t)blockDim.x;\n"
    buf = buf + "    for (; i < n; i += stride) {\n"
    buf = buf + "        double xi = X[i];\n"
    buf = buf + "        Y[i] = xi * _hx_cuda_sigmoid_d(xi);\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* silu'(x) = σ(x) · (1 + x · (1 − σ(x))). Mirrors CPU `_hx_farr_silu_grad_cpu`\n"
    buf = buf + " * (`self/runtime.c` §11314-11332) — same algebraic form, same single\n"
    buf = buf + " * `exp` call per element. */\n"
    buf = buf + "__global__ void _hx_cuda_kern_silu_grad(const double* __restrict__ X,\n"
    buf = buf + "                                        double* __restrict__ Y,\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "                                        int64_t n) {\n"
    buf = buf + "    int64_t i      = (int64_t)blockIdx.x * (int64_t)blockDim.x + (int64_t)threadIdx.x;\n"
    buf = buf + "    int64_t stride = (int64_t)gridDim.x  * (int64_t)blockDim.x;\n"
    buf = buf + "    for (; i < n; i += stride) {\n"
    buf = buf + "        double xi = X[i];\n"
    buf = buf + "        double s  = _hx_cuda_sigmoid_d(xi);\n"
    buf = buf + "        Y[i] = s * (1.0 + xi * (1.0 - s));\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ── RoPE kernels (RFC 041 Phase B completion, 2026-05-17) ──────────\n"
    buf = buf + " *\n"
    buf = buf + " * Rotary position embedding. The flame decoder block (RFC 043,\n"
    buf = buf + " * stdlib/flame/decoder_block_lib.hexa §3 fwd / §3rev bwd; CPU reference\n"
    buf = buf + " * tool/flame_phase4d6_block_{fwd,bwd}_primitive.c) consumes PRECOMPUTED\n"
    buf = buf + " * cos/sin tables — the kernel does NOT recompute angles.\n"
    buf = buf + " *\n"
    buf = buf + " * Layout — tensor T_buf is row-major [T · nheads · hd]; the row for\n"
    buf = buf + " * position t, head hh starts at (t·nheads + hh)·hd. cos/sin are\n"
    buf = buf + " * row-major [T · hd], indexed bse + c with bse = t·hd. `half = hd/2`.\n"
    buf = buf + " *\n"
    buf = buf + " * Forward (mirrors fwd_primitive.c lines 162-167):\n"
    buf = buf + " *   rh_c   = (c < half) ? -x[row+half+c] : x[row+c-half]\n"
    buf = buf + " *   out[c] = x[row+c]·cos[bse+c] + rh_c·sin[bse+c]\n"
    buf = buf + " *\n"
    buf = buf + " * Backward — inverse rotation (mirrors bwd_primitive.c lines 322-327):\n"
    buf = buf + " *   gs   = (c < half) ?  dx[row+half+c]·sin[bse+half+c]\n"
    buf = buf + " *                     : -dx[row+c-half]·sin[bse+c-half]\n"
    buf = buf + " *   out[c] = dx[row+c]·cos[bse+c] + gs\n"
    buf = buf + " *\n"
    buf = buf + " * Each output element is a pure function of TWO input-row elements\n"
    buf = buf + " * (index c and c±half) plus cos/sin — NO cross-element reduction. A\n"
    buf = buf + " * thread-per-element kernel reading from a SEPARATE input buffer is\n"
    buf = buf + " * therefore BIT-EXACT vs the CPU scratch-buffer loop: same two\n"
    buf = buf + " * fp64 products + one add, no reordering (F-RFC041-ROPE-EXACT,\n"
    buf = buf + " * F-RFC041-ROPE-BWD-EXACT demand |Δ| = 0).\n"
    buf = buf + " *\n"
    buf = buf + " * 1-D grid-stride over the flat index e ∈ [0, T·nheads·hd). For each e\n"
    buf = buf + " * we recover t = e/(nheads·hd), c = e mod hd, and the row base.\n"
    buf = buf + " */\n"
    buf = buf + "\n"
    buf = buf + "__global__ void _hx_cuda_kern_rope_fwd(const double* __restrict__ X,\n"
    buf = buf + "                                       const double* __restrict__ COS,\n"
    buf = buf + "                                       const double* __restrict__ SIN,\n"
    buf = buf + "                                       double* __restrict__ Y,\n"
    buf = buf + "                                       int64_t T, int64_t nheads,\n"
    buf = buf + "                                       int64_t hd) {\n"
    buf = buf + "    int64_t total  = T * nheads * hd;\n"
    buf = buf + "    int64_t half   = hd / 2;\n"
    buf = buf + "    int64_t i      = (int64_t)blockIdx.x * (int64_t)blockDim.x + (int64_t)threadIdx.x;\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "    int64_t stride = (int64_t)gridDim.x  * (int64_t)blockDim.x;\n"
    buf = buf + "    for (; i < total; i += stride) {\n"
    buf = buf + "        int64_t c   = i % hd;\n"
    buf = buf + "        int64_t row = i - c;             /* (t·nheads+hh)·hd */\n"
    buf = buf + "        int64_t t   = i / (nheads * hd);\n"
    buf = buf + "        int64_t bse = t * hd;\n"
    buf = buf + "        double rh_c = (c < half)\n"
    buf = buf + "            ? (0.0 - X[row + half + c])\n"
    buf = buf + "            : X[row + c - half];\n"
    buf = buf + "        /* __dmul_rn/__dadd_rn: explicit round-to-nearest, no FMA\n"
    buf = buf + "         * contraction. nvcc device default (--fmad=true) would fuse\n"
    buf = buf + "         * a*b+c*d into one fma() (1 rounding); the verified flame\n"
    buf = buf + "         * reference nn_rope_apply_fwd (and the CPU fallback, pinned\n"
    buf = buf + "         * by #pragma STDC FP_CONTRACT OFF, commit c0789e05) does 2\n"
    buf = buf + "         * roundings. The RoPE GPU byte-eq oracle measured the fused\n"
    buf = buf + "         * form diverging max|Δ|=4.441e-16 — this conforms the kernel\n"
    buf = buf + "         * to the reference's rounding (F-RFC041-ROPE-EXACT |Δ|=0). */\n"
    buf = buf + "        Y[i] = __dadd_rn(__dmul_rn(X[row + c], COS[bse + c]),\n"
    buf = buf + "                         __dmul_rn(rh_c, SIN[bse + c]));\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "__global__ void _hx_cuda_kern_rope_bwd(const double* __restrict__ DX,\n"
    buf = buf + "                                       const double* __restrict__ COS,\n"
    buf = buf + "                                       const double* __restrict__ SIN,\n"
    buf = buf + "                                       double* __restrict__ Y,\n"
    buf = buf + "                                       int64_t T, int64_t nheads,\n"
    buf = buf + "                                       int64_t hd) {\n"
    buf = buf + "    int64_t total  = T * nheads * hd;\n"
    buf = buf + "    int64_t half   = hd / 2;\n"
    buf = buf + "    int64_t i      = (int64_t)blockIdx.x * (int64_t)blockDim.x + (int64_t)threadIdx.x;\n"
    buf = buf + "    int64_t stride = (int64_t)gridDim.x  * (int64_t)blockDim.x;\n"
    buf = buf + "    for (; i < total; i += stride) {\n"
    buf = buf + "        int64_t c   = i % hd;\n"
    buf = buf + "        int64_t row = i - c;\n"
    buf = buf + "        int64_t t   = i / (nheads * hd);\n"
    buf = buf + "        int64_t bse = t * hd;\n"
    buf = buf + "        /* __dmul_rn/__dadd_rn — no FMA contraction; conform to the\n"
    buf = buf + "         * non-contracted reference (see fwd kernel note + c0789e05). */\n"
    buf = buf + "        double gs = (c < half)\n"
    buf = buf + "            ? __dmul_rn(DX[row + half + c], SIN[bse + half + c])\n"
    buf = buf + "            : (0.0 - __dmul_rn(DX[row + c - half], SIN[bse + c - half]));\n"
    buf = buf + "        Y[i] = __dadd_rn(__dmul_rn(DX[row + c], COS[bse + c]), gs);\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ── Transpose-scatter kernel (RFC 058 §5.1, 13th forge kernel) ──────\n"
    buf = buf + " *\n"
    buf = buf + " * Pure index permutation: src (rows×cols, row-major) → dst transposed\n"
    buf = buf + " * (cols×rows, row-major) at byte-offset dst_off:\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + " *\n"
    buf = buf + " *   dst[dst_off + c*rows + r] = src[r*cols + c]\n"
    buf = buf + " *\n"
    buf = buf + " * ZERO floating-point operations — a `double` is copied bit-for-bit\n"
    buf = buf + " * from one slot to another, no add / mul / fma / rounding. The output\n"
    buf = buf + " * is a reindexing of the input bits, so byte-equality vs the CPU host\n"
    buf = buf + " * transpose loop `Y[Y_off + t*d_out + r] = C[r*T + t]` is mathematically\n"
    buf = buf + " * trivial (no accumulation order, no fp ULP — F-RFC058-KERNEL-BYTEEQ\n"
    buf = buf + " * |Δ|=0 by construction; the d768 GPU fire confirms it empirically).\n"
    buf = buf + " *\n"
    buf = buf + " * The flat thread index e ∈ [0, rows*cols) decomposes as r = e/cols,\n"
    buf = buf + " * c = e%cols — the SAME (r,c) the CPU loop visits (CPU iterates r outer,\n"
    buf = buf + " * c inner over the *transposed* read C[r*T+t]; here src has rows=d_out,\n"
    buf = buf + " * cols=T so r∈[0,d_out), c∈[0,T) and dst[dst_off+c*rows+r] is exactly\n"
    buf = buf + " * Y[Y_off + t*d_out + r] with t=c). No cross-element dependency, so a\n"
    buf = buf + " * thread-per-element grid-stride kernel is order-independent and exact.\n"
    buf = buf + " *\n"
    buf = buf + " * dst is NOT a fresh buffer — it is Bc, populated slab-by-slab across\n"
    buf = buf + " * projections. Only the [dst_off, dst_off+rows*cols) range is written;\n"
    buf = buf + " * the host wrapper H2D-uploads dst's current contents first so untouched\n"
    buf = buf + " * regions are preserved. The 12 verified kernels above are UNTOUCHED —\n"
    buf = buf + " * this is purely additive (RFC 058 §1, g_forge_verify_oracle 12→13). */\n"
    buf = buf + "__global__ void _hx_cuda_kern_transpose_scatter(const double* __restrict__ src,\n"
    buf = buf + "                                                double* __restrict__ dst,\n"
    buf = buf + "                                                int64_t rows, int64_t cols,\n"
    buf = buf + "                                                int64_t dst_off) {\n"
    buf = buf + "    int64_t total  = rows * cols;\n"
    buf = buf + "    int64_t i      = (int64_t)blockIdx.x * (int64_t)blockDim.x + (int64_t)threadIdx.x;\n"
    buf = buf + "    int64_t stride = (int64_t)gridDim.x  * (int64_t)blockDim.x;\n"
    buf = buf + "    for (; i < total; i += stride) {\n"
    buf = buf + "        int64_t r = i / cols;\n"
    buf = buf + "        int64_t c = i % cols;\n"
    buf = buf + "        dst[dst_off + c * rows + r] = src[r * cols + c];\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ── Host wrappers (extern surface — match runtime.c forward-decls) ──\n"
    buf = buf + " * Each: validate → H2D inputs → ensure output device buf sized → launch\n"
    buf = buf + " * → cudaGetLastError → D2H output → mark MIRRORED/clean. Returns 0 ok /\n"
    buf = buf + " * -1 err with a one-line stderr message (no silent fallback). */\n"
    buf = buf + "\n"
    buf = buf + "int _hx_cuda_farr_add_gpu(int64_t a_id, int64_t b_id,\n"
    buf = buf + "                          int64_t n, int64_t out_id) {\n"
