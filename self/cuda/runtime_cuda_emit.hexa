    buf = buf + "            HexaFarrEntry* e = &_hx_farr_table[outs[k]];\n"
    buf = buf + "            e->d_buf      = (void*)g_slots[outs[k]].d_buf;\n"
    buf = buf + "            e->loc        = FARR_DEVICE;\n"
    buf = buf + "            e->dirty_host = 0;\n"
    buf = buf + "            e->dirty_dev  = 0;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)x_id; (void)g_id; (void)y_id; (void)xn_id; (void)inv_id; (void)d;\n"
    buf = buf + "    fprintf(stderr, \"[cuda] rmsnorm_fwd: built without __CUDACC__\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "/* HEXA-FUSION L3 (LLM-path BWD glue half) — device-resident RMSNorm backward.\n"
    buf = buf + " * Reproduces stdlib/flame/nn_lib.hexa nn_rmsnorm_bwd EXACTLY (closed vjp):\n"
    buf = buf + " *   dxn_i = dy_i·g_i ; dg_i = dy_i·xn_i ; dot = Σ_k dxn_k·x_k (SEQUENTIAL)\n"
    buf = buf + " *   inv3 = inv·inv·inv ; scale = (inv3/d)·dot ; dx_i = inv·dxn_i − scale·x_i\n"
    buf = buf + " * `inv` is the saved fwd reciprocal-rms passed BY VALUE (double kernel arg,\n"
    buf = buf + " * NOT a farr). NO sqrt/exp on this path. The dot reduction runs on ONE thread\n"
    buf = buf + " * (thread 0) ascending (NO tree re-assoc, NO atomics); the mul-into-add (dot)\n"
    buf = buf + " * and the mul−mul (dx) use __dmul_rn/__dadd_rn/__dsub_rn to defeat FMA\n"
    buf = buf + " * contraction (host FP_CONTRACT OFF) → max|Δ|=0. Single-block launch: thread 0\n"
    buf = buf + " * reduces dot → shared scale, __syncthreads, all threads grid-stride the\n"
    buf = buf + " * dg/dx writes. Keeps DX/DG FARR_DEVICE. */\n"
    buf = buf + "__global__ void _hx_k_rmsnorm_bwd(const double* __restrict__ X,\n"
    buf = buf + "                                  const double* __restrict__ G,\n"
    buf = buf + "                                  const double* __restrict__ XN,\n"
    buf = buf + "                                  double inv,\n"
    buf = buf + "                                  const double* __restrict__ DY,\n"
    buf = buf + "                                  double* __restrict__ DX,\n"
    buf = buf + "                                  double* __restrict__ DG,\n"
    buf = buf + "                                  int64_t d) {\n"
    buf = buf + "    __shared__ double sh_scale;\n"
    buf = buf + "    if (threadIdx.x == 0) {\n"
    buf = buf + "        double dot = 0.0;\n"
    buf = buf + "        for (int64_t i = 0; i < d; i++) {\n"
    buf = buf + "            double dxn_i = DY[i] * G[i];\n"
    buf = buf + "            dot = __dadd_rn(dot, __dmul_rn(dxn_i, X[i]));\n"
    buf = buf + "        }\n"
    buf = buf + "        double inv3  = inv * inv * inv;\n"
    buf = buf + "        double scale = (inv3 / (double)d) * dot;\n"
    buf = buf + "        sh_scale = scale;\n"
    buf = buf + "    }\n"
    buf = buf + "    __syncthreads();\n"
    buf = buf + "    double scale = sh_scale;\n"
    buf = buf + "    for (int64_t j = (int64_t)threadIdx.x; j < d; j += (int64_t)blockDim.x) {\n"
    buf = buf + "        double dxn_j = DY[j] * G[j];\n"
    buf = buf + "        DG[j] = DY[j] * XN[j];\n"
    buf = buf + "        DX[j] = __dsub_rn(__dmul_rn(inv, dxn_j), __dmul_rn(scale, X[j]));\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "int _hx_cuda_farr_rmsnorm_bwd_gpu(int64_t x_id, int64_t g_id, int64_t xn_id,\n"
    buf = buf + "                                  double inv, int64_t dy_id, int64_t dx_id,\n"
    buf = buf + "                                  int64_t dg_id, int64_t d) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (d <= 0) return -1;\n"
    buf = buf + "    if (_h2d(x_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(g_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(xn_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(dy_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(dx_id, d) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(dg_id, d) != 0) return -1;\n"
    buf = buf + "    const double* X  = g_slots[x_id].d_buf;\n"
    buf = buf + "    const double* G  = g_slots[g_id].d_buf;\n"
    buf = buf + "    const double* XN = g_slots[xn_id].d_buf;\n"
    buf = buf + "    const double* DY = g_slots[dy_id].d_buf;\n"
