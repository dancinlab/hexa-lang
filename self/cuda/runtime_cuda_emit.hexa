    buf = buf + "    int grid_sz = (want > 1024) ? 1024 : (int)want;\n"
    buf = buf + "    if (grid_sz < 1) grid_sz = 1;\n"
    buf = buf + "    _hx_k_embedding<<<grid_sz, block_sz, 0, _forge_stream()>>>(IDS, TABLE, OUT, T, d);\n"
    buf = buf + "    if (_forge_launch_check(\"embedding\") != 0) return -1;\n"
    buf = buf + "    {\n"
    buf = buf + "        HexaFarrEntry* e = &_hx_farr_table[out_id];\n"
    buf = buf + "        e->d_buf      = (void*)g_slots[out_id].d_buf;\n"
    buf = buf + "        e->loc        = FARR_DEVICE;\n"
    buf = buf + "        e->dirty_host = 0;\n"
    buf = buf + "        e->dirty_dev  = 0;\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)ids_id; (void)table_id; (void)out_id; (void)T; (void)d;\n"
    buf = buf + "    fprintf(stderr, \"[cuda] embedding: built without __CUDACC__\\n\");\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* HEXA-FUSION L3 (LLM-path glue half) — device-resident RMSNorm forward.\n"
    buf = buf + " * Reproduces stdlib/flame/nn_lib.hexa nn_rmsnorm_fwd EXACTLY:\n"
    buf = buf + " *   ms = Σ_i x_i·x_i (SEQUENTIAL) ; ms /= d ; inv = 1/_nn_sqrt(ms+1e-6)\n"
    buf = buf + " *   xn_j = x_j·inv ; y_j = g_j·xn_j\n"
    buf = buf + " * _nn_sqrt is libm sqrt — the IEEE-754 CORRECTLY-ROUNDED sqrt (NOT dt_sqrt/\n"
    buf = buf + " * Newton like groupnorm/layernorm), so device sqrt(double) (== __dsqrt_rn,\n"
    buf = buf + " * correctly-rounded) is bit-identical. The ms reduction runs on ONE thread\n"
    buf = buf + " * (thread 0) in ascending order (NO tree re-assoc, NO warp/atomic partials);\n"
    buf = buf + " * the mul-into-add uses __dmul_rn/__dadd_rn to defeat nvcc FMA contraction\n"
    buf = buf + " * (host FP_CONTRACT OFF = 2 roundings) → max|Δ|=0. Single-block launch:\n"
    buf = buf + " * thread 0 reduces into shared inv, __syncthreads, then all threads grid-\n"
    buf = buf + " * stride the elementwise xn/y writes. Keeps Y/XN/INV FARR_DEVICE. */\n"
    buf = buf + "__global__ void _hx_k_rmsnorm_fwd(const double* __restrict__ X,\n"
    buf = buf + "                                  const double* __restrict__ G,\n"
    buf = buf + "                                  double* __restrict__ Y,\n"
    buf = buf + "                                  double* __restrict__ XN,\n"
    buf = buf + "                                  double* __restrict__ INV,\n"
    buf = buf + "                                  int64_t d) {\n"
    buf = buf + "    __shared__ double sh_inv;\n"
    buf = buf + "    if (threadIdx.x == 0) {\n"
    buf = buf + "        double ms = 0.0;\n"
    buf = buf + "        for (int64_t i = 0; i < d; i++) {\n"
    buf = buf + "            double xi = X[i];\n"
    buf = buf + "            ms = __dadd_rn(ms, __dmul_rn(xi, xi));\n"
    buf = buf + "        }\n"
    buf = buf + "        ms = ms / (double)d;\n"
    buf = buf + "        double inv = 1.0 / sqrt(ms + 0.000001);\n"
    buf = buf + "        INV[0] = inv;\n"
    buf = buf + "        sh_inv = inv;\n"
    buf = buf + "    }\n"
    buf = buf + "    __syncthreads();\n"
    buf = buf + "    double inv = sh_inv;\n"
    buf = buf + "    for (int64_t j = (int64_t)threadIdx.x; j < d; j += (int64_t)blockDim.x) {\n"
    buf = buf + "        double xnj = X[j] * inv;\n"
    buf = buf + "        XN[j] = xnj;\n"
    buf = buf + "        Y[j]  = G[j] * xnj;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime_cuda(out_path, buf); buf = "" }
    buf = buf + "int _hx_cuda_farr_rmsnorm_fwd_gpu(int64_t x_id, int64_t g_id, int64_t y_id,\n"
    buf = buf + "                                  int64_t xn_id, int64_t inv_id, int64_t d) {\n"
    buf = buf + "#ifdef __CUDACC__\n"
    buf = buf + "    if (d <= 0) return -1;\n"
    buf = buf + "    if (_h2d(x_id) != 0) return -1;\n"
    buf = buf + "    if (_h2d(g_id) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(y_id, d) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(xn_id, d) != 0) return -1;\n"
    buf = buf + "    if (_ensure_dev_alloc_out(inv_id, 1) != 0) return -1;\n"
    buf = buf + "    const double* X = g_slots[x_id].d_buf;\n"
    buf = buf + "    const double* G = g_slots[g_id].d_buf;\n"
    buf = buf + "    double*       Y   = g_slots[y_id].d_buf;\n"
    buf = buf + "    double*       XN  = g_slots[xn_id].d_buf;\n"
    buf = buf + "    double*       INV = g_slots[inv_id].d_buf;\n"
    buf = buf + "    int block_sz = 256;\n"
    buf = buf + "    _hx_k_rmsnorm_fwd<<<1, block_sz, 0, _forge_stream()>>>(X, G, Y, XN, INV, d);\n"
    buf = buf + "    if (_forge_launch_check(\"rmsnorm_fwd\") != 0) return -1;\n"
    buf = buf + "    {\n"
