    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// silu/gelu/argmax: Step-3 cycle 17 port.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_silu(HexaVal a) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(a)) return out;\n"
    buf = buf + "    int64_t n = (int64_t)HX_ARR_LEN(a);\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        double x = __hx_to_double(hexa_array_get(a, i));\n"
    buf = buf + "        out = hexa_array_push(out, hexa_float(x / (1.0 + hxlcl_exp(-x))));\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_gelu(HexaVal a) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(a)) return out;\n"
    buf = buf + "    int64_t n = (int64_t)HX_ARR_LEN(a);\n"
    buf = buf + "    const double k = 0.7978845608028654; // sqrt(2/pi)\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        double x = __hx_to_double(hexa_array_get(a, i));\n"
    buf = buf + "        double inner = k * (x + 0.044715 * x * x * x);\n"
    buf = buf + "        out = hexa_array_push(out, hexa_float(0.5 * x * (1.0 + _hx_tanh(inner))));\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_argmax(HexaVal a) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(a)) return hexa_int(-1);\n"
    buf = buf + "    int64_t n = (int64_t)HX_ARR_LEN(a);\n"
    buf = buf + "    if (n == 0) return hexa_int(-1);\n"
    buf = buf + "    int64_t best_i = 0;\n"
    buf = buf + "    double best_v = __hx_to_double(hexa_array_get(a, 0));\n"
    buf = buf + "    for (int64_t i = 1; i < n; i++) {\n"
    buf = buf + "        double v = __hx_to_double(hexa_array_get(a, i));\n"
    buf = buf + "        if (v > best_v) { best_v = v; best_i = i; }\n"
