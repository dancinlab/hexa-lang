    buf = buf + "    return rt_argmax(a);\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// sum(a): reduce-sum; returns int if all elements int, float otherwise.\n"
    buf = buf + "// Matches interpreter hexa_full.hexa:13232. Step-3 cycle 23 port (all-\n"
    buf = buf + "// float fast path via hexa-source; mixed arrays stay polymorphic C).\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_sum(HexaVal a) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(a)) return hexa_int(0);\n"
    buf = buf + "    int64_t n = (int64_t)HX_ARR_LEN(a);\n"
    buf = buf + "    int has_float = 0;\n"
    buf = buf + "    int64_t int_total = 0;\n"
    buf = buf + "    double float_total = 0.0;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        HexaVal e = hexa_array_get(a, i);\n"
