    buf = buf + "    safetensors_mmap_read_bytes     = hexa_fn_new((void*)hexa_safetensors_mmap_read_bytes,     3);\n"
    buf = buf + "    safetensors_mmap_close          = hexa_fn_new((void*)hexa_safetensors_mmap_close,          1);\n"
    buf = buf + "    // RFC 032 (2026-05-12): farr_matmul — packed-double matrix multiply.\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    farr_matmul_shim                = hexa_fn_new((void*)hexa_farr_matmul,                     5);\n"
    buf = buf + "    // METAL_INTEGRATION.md step 3 of 5 (2026-05-21): HX_FARR32 shims.\n"
