    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "            char fpadc = (zeropad && !leftalign) ? '0' : ' ';\n"
    buf = buf + "            if (!leftalign) for (int k = 0; k < fpad; k++) HXLCL_PUT(fpadc);\n"
    buf = buf + "            for (int k = 0; k < fn; k++) HXLCL_PUT(fbuf[k]);\n"
    buf = buf + "            if (leftalign) for (int k = 0; k < fpad; k++) HXLCL_PUT(' ');\n"
    buf = buf + "            continue;\n"
    buf = buf + "        } else {\n"
    buf = buf + "            HXLCL_PUT('%'); HXLCL_PUT(conv); continue;\n"
    buf = buf + "        }\n"
    buf = buf + "        int pad = width - tn; if (pad < 0) pad = 0;\n"
    buf = buf + "        char padc = (zeropad && !leftalign) ? '0' : ' ';\n"
    buf = buf + "        if (!leftalign) for (int k = 0; k < pad; k++) HXLCL_PUT(padc);\n"
    buf = buf + "        for (int i = tn - 1; i >= 0; i--) HXLCL_PUT(tmp[i]);\n"
    buf = buf + "        if (leftalign) for (int k = 0; k < pad; k++) HXLCL_PUT(' ');\n"
    buf = buf + "    }\n"
    buf = buf + "    #undef HXLCL_PUT\n"
    buf = buf + "    if (cap > 0) buf[pos < cap ? pos : cap - 1] = '\\0';\n"
    buf = buf + "    return (int)pos;\n"
    buf = buf + "}\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_snprintf(char *buf, size_t cap, const char *fmt, ...) {\n"
    buf = buf + "    va_list ap; va_start(ap, fmt);\n"
    buf = buf + "    int r = hxlcl_vsnprintf(buf, cap, fmt, ap);\n"
    buf = buf + "    va_end(ap);\n"
    buf = buf + "    return r;\n"
    buf = buf + "}\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_sprintf(char *buf, const char *fmt, ...) {\n"
    buf = buf + "    va_list ap; va_start(ap, fmt);\n"
    buf = buf + "    int r = hxlcl_vsnprintf(buf, 0x7FFFFFFF, fmt, ap);\n"
    buf = buf + "    va_end(ap);\n"
    buf = buf + "    return r;\n"
    buf = buf + "}\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_vfprintf_fd(int fd, const char *fmt, va_list ap) {\n"
    buf = buf + "    char buf[4096];\n"
    buf = buf + "    va_list ap2;\n"
    buf = buf + "    va_copy(ap2, ap);\n"
    buf = buf + "    int n = hxlcl_vsnprintf(buf, sizeof(buf), fmt, ap);\n"
    buf = buf + "    if (n < 0) { va_end(ap2); return -1; }\n"
    buf = buf + "    if (n < (int)sizeof(buf)) {\n"
    buf = buf + "        va_end(ap2);\n"
    buf = buf + "        return (int)hxlcl_write(fd, buf, (size_t)n);\n"
    buf = buf + "    }\n"
    buf = buf + "    /* formatted output exceeds the 4096-byte stack buffer — reformat on\n"
    buf = buf + "       the heap so large output (e.g. println of a multi-KB string) is\n"
    buf = buf + "       written in full instead of being truncated at 4095 bytes. */\n"
    buf = buf + "    char *big = (char *)hxlcl_malloc((size_t)n + 1);\n"
    buf = buf + "    if (!big) { va_end(ap2); return (int)hxlcl_write(fd, buf, sizeof(buf) - 1); }\n"
    buf = buf + "    int n2 = hxlcl_vsnprintf(big, (size_t)n + 1, fmt, ap2);\n"
    buf = buf + "    va_end(ap2);\n"
    buf = buf + "    if (n2 < 0) n2 = 0;\n"
    buf = buf + "    int w = (int)hxlcl_write(fd, big, (size_t)n2);\n"
    buf = buf + "    hxlcl_free(big);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    return w;\n"
    buf = buf + "}\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_printf(const char *fmt, ...) {\n"
    buf = buf + "    va_list ap; va_start(ap, fmt);\n"
    buf = buf + "    int r = hxlcl_vfprintf_fd(1, fmt, ap);\n"
    buf = buf + "    va_end(ap);\n"
    buf = buf + "    return r;\n"
    buf = buf + "}\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_fprintf(void *fp, const char *fmt, ...) {\n"
    buf = buf + "    int fd = 1;\n"
    buf = buf + "    if (fp == (void *)stderr) fd = 2;\n"
    buf = buf + "    va_list ap; va_start(ap, fmt);\n"
    buf = buf + "    int r = hxlcl_vfprintf_fd(fd, fmt, ap);\n"
    buf = buf + "    va_end(ap);\n"
    buf = buf + "    return r;\n"
    buf = buf + "}\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_fputs(const char *s, void *fp) {\n"
    buf = buf + "    int fd = 1; if (fp == (void *)stderr) fd = 2;\n"
    buf = buf + "    if (!s) return -1;\n"
    buf = buf + "    size_t n = 0; while (((const volatile char *)s)[n]) n++;\n"
    buf = buf + "    return (int)hxlcl_write(fd, s, n);\n"
    buf = buf + "}\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_fputc(int c, void *fp) {\n"
    buf = buf + "    int fd = 1; if (fp == (void *)stderr) fd = 2;\n"
    buf = buf + "    unsigned char ch = (unsigned char)c;\n"
    buf = buf + "    return hxlcl_write(fd, &ch, 1) == 1 ? c : -1;\n"
    buf = buf + "}\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_fflush(void *fp) {\n"
    buf = buf + "    (void)fp;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_putchar(int c) {\n"
    buf = buf + "    unsigned char ch = (unsigned char)c;\n"
    buf = buf + "    return hxlcl_write(1, &ch, 1) == 1 ? c : -1;\n"
    buf = buf + "}\n"
    buf = buf + "static void __attribute__((noinline)) hxlcl_perror(const char *s) {\n"
    buf = buf + "    if (s && s[0]) {\n"
    buf = buf + "        size_t n = 0; while (((const volatile char *)s)[n]) n++;\n"
    buf = buf + "        hxlcl_write(2, s, n);\n"
    buf = buf + "        hxlcl_write(2, \": \", 2);\n"
    buf = buf + "    }\n"
    buf = buf + "    hxlcl_write(2, \"error\\n\", 6);\n"
    buf = buf + "}\n"
    buf = buf + "// Cycle 53 — Tier-A.2 mmap-backed bump allocator. malloc never frees;\n"
    buf = buf + "// free is a noop; realloc bump-allocates new region + byte copy.\n"
    buf = buf + "// Trade-off: compiler binary leaks memory until exit (a one-shot tool;\n"
    buf = buf + "// acceptable). Calls libc `mmap` for fresh 4 MB chunks; that single\n"
    buf = buf + "// `_mmap` extern is the floor for the allocator family. Once @asm\n"
    buf = buf + "// blocks are wired (Tier-A.4 path), `mmap` itself can be syscall-\n"
    buf = buf + "// inlined and the family becomes zero-extern.\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "#define HXLCL_ALLOC_CHUNK_SZ (4u * 1024u * 1024u)\n"
    buf = buf + "// Step 5 fix (2026-05-22 잔여 #3 unblocker): track each allocation's\n"
    buf = buf + "// size in a 16-byte header so realloc knows how many bytes are safe to\n"
    buf = buf + "// read from the source. Pre-fix: hxlcl_realloc unconditionally copied\n"
    buf = buf + "// `n` bytes from `p` regardless of `p`'s original allocation size,\n"
    buf = buf + "// over-reading past chunk boundaries when n > old_size — latent\n"
    buf = buf + "// SIGSEGV in geometric hexa_array_push growth. Surfaced by the\n"
    buf = buf + "// `rt_str_concat` hexa port (RUNTIME.md 잔여 #3) which pushes la+lb\n"
    buf = buf + "// HexaVal int elements during atlas_hxc load (la, lb in the thousands).\n"
    buf = buf + "//\n"
    buf = buf + "// Header layout: HXLCL_HDR_BYTES (16) bytes at raw_ptr; first 8 bytes\n"
    buf = buf + "// store `size_t user_n`; remaining 8 bytes reserved (alignment pad).\n"
    buf = buf + "// User pointer = raw_ptr + 16. All hxlcl_{malloc,realloc,calloc}\n"
    buf = buf + "// allocations carry the header so hxlcl_realloc's memcpy can clamp\n"
    buf = buf + "// the copy count to old_n.\n"
    buf = buf + "//\n"
    buf = buf + "// Memory cost: +16 B per allocation. The bump allocator is mmap-backed,\n"
    buf = buf + "// 16-byte aligned, never frees — header cost is amortised across the\n"
    buf = buf + "// one-shot compiler lifetime. Smoke binary size delta ≈ 0 (header runs\n"
    buf = buf + "// inside the same 4 MB chunk).\n"
    buf = buf + "#define HXLCL_HDR_BYTES 16\n"
    buf = buf + "static char *_hxlcl_alloc_ptr = (char *)0;\n"
    buf = buf + "static char *_hxlcl_alloc_end = (char *)0;\n"
    buf = buf + "// F3 B9.6-B2 callee-export: HXLCL_MALLOC_SC flips between `static` (default)\n"
    buf = buf + "// and empty (guard on, exported) so the self-emit rt_strdup .o's BRANCH26 reloc\n"
    buf = buf + "// against `_hxlcl_malloc` can be bound by ld64. `noinline` retained either way.\n"
    buf = buf + "HXLCL_MALLOC_SC void *__attribute__((noinline)) hxlcl_malloc(size_t n) {\n"
    buf = buf + "    if (n == 0) n = 1;\n"
    buf = buf + "    size_t total = n + HXLCL_HDR_BYTES;\n"
    buf = buf + "    total = (total + (size_t)15) & ~(size_t)15;\n"
    buf = buf + "    if (!_hxlcl_alloc_ptr || _hxlcl_alloc_ptr + total > _hxlcl_alloc_end) {\n"
    buf = buf + "        size_t chunk = (total > HXLCL_ALLOC_CHUNK_SZ) ? total : HXLCL_ALLOC_CHUNK_SZ;\n"
    buf = buf + "        void *m = hxlcl_mmap((void *)0, chunk, PROT_READ | PROT_WRITE,\n"
    buf = buf + "                       MAP_PRIVATE | MAP_ANON, -1, 0);\n"
    buf = buf + "        if (m == MAP_FAILED) return (void *)0;\n"
    buf = buf + "        _hxlcl_alloc_ptr = (char *)m;\n"
    buf = buf + "        _hxlcl_alloc_end = _hxlcl_alloc_ptr + chunk;\n"
    buf = buf + "    }\n"
    buf = buf + "    char *raw = _hxlcl_alloc_ptr;\n"
    buf = buf + "    _hxlcl_alloc_ptr += total;\n"
    buf = buf + "    *(size_t *)raw = n;  // record user-requested size for safe realloc\n"
    buf = buf + "    return (void *)(raw + HXLCL_HDR_BYTES);\n"
    buf = buf + "}\n"
    buf = buf + "// F3 class-B HARD libc-routed scale-out — hxlcl_free Path-A activation.\n"
    buf = buf + "// Under HEXA_RT_SELFEMIT hxlcl_free is `extern` (body supplied by\n"
    buf = buf + "// emit_hxlcl_free_o.hexa's .o = a single `ret` instruction, 4 B, ZERO\n"
    buf = buf + "// relocs). The C body is a literal noop (bump allocator never reclaims),\n"
    buf = buf + "// so the self-emit body is byte-equivalent: both discard `p`. Cheapest\n"
    buf = buf + "// possible class-B activation — no frame, no callee, no relocs to bind.\n"
    buf = buf + "// Default (guard off) keeps the static noop = 0-libc-extern preserved.\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern void hxlcl_free(void *p);\n"
    buf = buf + "#else\n"
    buf = buf + "static void __attribute__((noinline)) hxlcl_free(void *p) {\n"
    buf = buf + "    (void)p;\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "static void *__attribute__((noinline)) hxlcl_realloc(void *p, size_t n) {\n"
    buf = buf + "    if (!p) return hxlcl_malloc(n);\n"
    buf = buf + "    if (n == 0) return (void *)0;\n"
    buf = buf + "    void *np = hxlcl_malloc(n);\n"
    buf = buf + "    if (!np) return (void *)0;\n"
    buf = buf + "    // Header-tracked old size: clamp the memcpy so we never read past\n"
    buf = buf + "    // the original allocation's end (the pre-fix over-read crashed when\n"
    buf = buf + "    // n > old_n and old_n's chunk boundary fell inside [p .. p+n)).\n"
    buf = buf + "    size_t old_n = *(size_t *)((char *)p - HXLCL_HDR_BYTES);\n"
    buf = buf + "    size_t copy_n = (n < old_n) ? n : old_n;\n"
    buf = buf + "    unsigned char *d = (unsigned char *)np;\n"
    buf = buf + "    const unsigned char *s = (const unsigned char *)p;\n"
    buf = buf + "    for (size_t i = 0; i < copy_n; i++) d[i] = s[i];\n"
    buf = buf + "    return np;\n"
    buf = buf + "}\n"
    buf = buf + "static void *__attribute__((noinline)) hxlcl_calloc(size_t nmemb, size_t size) {\n"
    buf = buf + "    size_t total = nmemb * size;\n"
    buf = buf + "    void *p = hxlcl_malloc(total);\n"
    buf = buf + "    if (p) {\n"
    buf = buf + "        unsigned char *q = (unsigned char *)p;\n"
    buf = buf + "        for (size_t i = 0; i < total; i++) q[i] = 0;\n"
    buf = buf + "    }\n"
    buf = buf + "    return p;\n"
    buf = buf + "}\n"
    buf = buf + "// B9.6-E1 (F3 Path A) — class-E memory-lifecycle FIRST LIVE wire. Under\n"
    buf = buf + "// HEXA_RT_SELFEMIT hxlcl_munmap is `extern` (body supplied by\n"
    buf = buf + "// emit_hxlcl_munmap_o.hexa's .o = a 2-instr `mov w0,#0 / ret` leaf — the\n"
    buf = buf + "// unmap/dealloc side of class-E). The bump allocator never frees, so the C\n"
    buf = buf + "// stub is a constant-0 success; the self-emit replaces it byte-identically.\n"
    buf = buf + "// Like getpid (#1860) the linkage must flip to `extern` under the guard, else\n"
    buf = buf + "// the `static` masks the self-emit symbol (-Wundefined-internal). Default\n"
    buf = buf + "// build keeps the file-local `static` stub (0-libc-extern preserved).\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int __attribute__((noinline)) hxlcl_munmap(void *addr, size_t length);\n"
    buf = buf + "#else\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_munmap(void *addr, size_t length) {\n"
    buf = buf + "    (void)addr; (void)length;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "// Cycle 54 — Tier-A.3 file-stream subset. FILE* encoded as\n"
    buf = buf + "// (void *)(uintptr_t)(fd + 1) so 0 doesn't alias NULL. stderr/\n"
    buf = buf + "// stdout/stdin (libc pointers) preserved by hxlcl_fprintf/fputs/\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// fputc/fflush path; those keep using libc globals (one extern\n"
    buf = buf + "// each — addressed later via @asm + fd constants).\n"
    buf = buf + "static void *__attribute__((noinline)) hxlcl_fopen(const char *path, const char *mode) {\n"
    buf = buf + "    if (!path || !mode) return (void *)0;\n"
    buf = buf + "    int flags = 0;\n"
    buf = buf + "    if (mode[0] == 'r') flags = O_RDONLY;\n"
    buf = buf + "    else if (mode[0] == 'w') flags = O_WRONLY | O_CREAT | O_TRUNC;\n"
    buf = buf + "    else if (mode[0] == 'a') flags = O_WRONLY | O_CREAT | O_APPEND;\n"
    buf = buf + "    else return (void *)0;\n"
    buf = buf + "    if (mode[1] == '+' || (mode[1] != 0 && mode[2] == '+')) {\n"
    buf = buf + "        flags = (flags & ~(O_RDONLY | O_WRONLY)) | O_RDWR;\n"
    buf = buf + "    }\n"
    buf = buf + "    int fd = hxlcl_open_sys(path, flags, 0644);\n"
    buf = buf + "    if (fd < 0) return (void *)0;\n"
    buf = buf + "    /* Defense-in-depth (PR #414 inbox patch write-file-content-leak-root-cause):\n"
    buf = buf + "     * a freshly-opened user file cannot legitimately be 0/1/2 unless the\n"
    buf = buf + "     * runtime first closed stdin/stdout/stderr — which it never does (audit:\n"
    buf = buf + "     * no `hxlcl_close(0|1|2)` or `close(0|1|2)` in self/runtime.c). Anything\n"
    buf = buf + "     * in this range from open(2) here is almost certainly a future\n"
    buf = buf + "     * syscall-wrapper regression returning errno-as-fd (the carry-flag class\n"
    buf = buf + "     * of bug that cycle-66 fixed for read/write/close/dup2/pipe/fork/waitpid\n"
    buf = buf + "     * and that the recent hxlcl_open_sys libc-wrapper fixed for open). Fail\n"
    buf = buf + "     * closed rather than alias a small errno onto stdin/stdout/stderr and\n"
    buf = buf + "     * leak user content via fwrite. */\n"
    buf = buf + "    if (fd <= 2) return (void *)0;\n"
    buf = buf + "    return (void *)(uintptr_t)(fd + 1);\n"
    buf = buf + "}\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_fclose(void *fp) {\n"
    buf = buf + "    if (!fp) return -1;\n"
    buf = buf + "    uintptr_t v = (uintptr_t)fp;\n"
    buf = buf + "    // libc stderr/stdout/stdin: pointers in __DATA, very high addresses.\n"
    buf = buf + "    // Our encoding: small ints (fd+1, typically <1024).\n"
    buf = buf + "    if (v >= 0x1000) return 0;  // libc FILE* — don't close\n"
    buf = buf + "    int fd = (int)v - 1;\n"
    buf = buf + "    if (fd < 3) return 0;  // safety: never close 0/1/2\n"
    buf = buf + "    return hxlcl_close(fd);\n"
    buf = buf + "}\n"
    buf = buf + "static int __attribute__((noinline)) _hxlcl_fp_fd(void *fp) {\n"
    buf = buf + "    uintptr_t v = (uintptr_t)fp;\n"
    buf = buf + "    if (v >= 0x1000) {\n"
    buf = buf + "        // libc FILE* — best effort by pointer comparison.\n"
    buf = buf + "        if (fp == (void *)stderr) return 2;\n"
    buf = buf + "        if (fp == (void *)stdout) return 1;\n"
    buf = buf + "        if (fp == (void *)stdin) return 0;\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    return (int)v - 1;\n"
    buf = buf + "}\n"
    buf = buf + "static size_t __attribute__((noinline)) hxlcl_fread(void *buf, size_t sz, size_t n, void *fp) {\n"
    buf = buf + "    if (!buf || sz == 0 || n == 0) return 0;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    int fd = _hxlcl_fp_fd(fp);\n"
    buf = buf + "    if (fd < 0) return 0;\n"
    buf = buf + "    size_t total = sz * n;\n"
    buf = buf + "    size_t got = 0;\n"
    buf = buf + "    unsigned char *p = (unsigned char *)buf;\n"
    buf = buf + "    while (got < total) {\n"
    buf = buf + "        long r = (long)hxlcl_read(fd, p + got, total - got);\n"
    buf = buf + "        if (r <= 0) break;\n"
    buf = buf + "        got += (size_t)r;\n"
    buf = buf + "    }\n"
    buf = buf + "    return got / sz;\n"
    buf = buf + "}\n"
    buf = buf + "static size_t __attribute__((noinline)) hxlcl_fwrite(const void *buf, size_t sz, size_t n, void *fp) {\n"
    buf = buf + "    if (!buf || sz == 0 || n == 0) return 0;\n"
    buf = buf + "    int fd = _hxlcl_fp_fd(fp);\n"
    buf = buf + "    if (fd < 0) return 0;\n"
    buf = buf + "    size_t total = sz * n;\n"
    buf = buf + "    size_t put = 0;\n"
    buf = buf + "    const unsigned char *p = (const unsigned char *)buf;\n"
    buf = buf + "    while (put < total) {\n"
    buf = buf + "        long r = (long)hxlcl_write(fd, p + put, total - put);\n"
    buf = buf + "        if (r <= 0) break;\n"
    buf = buf + "        put += (size_t)r;\n"
    buf = buf + "    }\n"
    buf = buf + "    return put / sz;\n"
    buf = buf + "}\n"
    buf = buf + "static long __attribute__((noinline)) hxlcl_ftell(void *fp) {\n"
    buf = buf + "    int fd = _hxlcl_fp_fd(fp);\n"
    buf = buf + "    if (fd < 0) return -1;\n"
    buf = buf + "    return (long)hxlcl_lseek(fd, 0, SEEK_CUR);\n"
    buf = buf + "}\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_fseek(void *fp, long offset, int whence) {\n"
    buf = buf + "    int fd = _hxlcl_fp_fd(fp);\n"
    buf = buf + "    if (fd < 0) return -1;\n"
    buf = buf + "    return hxlcl_lseek(fd, (off_t)offset, whence) < 0 ? -1 : 0;\n"
    buf = buf + "}\n"
    buf = buf + "static void *__attribute__((noinline)) hxlcl_fdopen(int fd, const char *mode) {\n"
    buf = buf + "    (void)mode;\n"
    buf = buf + "    if (fd < 0) return (void *)0;\n"
