    buf = buf + "        if (!HX_IS_ARRAY(HX_ARR_ITEMS(arr)[i])) { all_array = 0; break; }\n"
    buf = buf + "    }\n"
    buf = buf + "    if (all_array) return rt_array_flatten_aoa(arr);\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        HexaVal it = HX_ARR_ITEMS(arr)[i];\n"
    buf = buf + "        if (HX_IS_ARRAY(it)) {\n"
    buf = buf + "            for (int64_t j = 0; j < HX_ARR_LEN(it); j++) {\n"
    buf = buf + "                out = hexa_array_push(out, HX_ARR_ITEMS(it)[j]);\n"
    buf = buf + "            }\n"
    buf = buf + "        } else {\n"
    buf = buf + "            out = hexa_array_push(out, it);\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// for_each: side-effect iteration. Returns void (hexa_full.hexa:15187).\n"
    buf = buf + "// Step-3 cycle 66 port — for_each dispatch (void-return hexa fn).\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_array_for_each(HexaVal arr, HexaVal fn) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_void();\n"
    buf = buf + "    for (int64_t i = 0; i < HX_ARR_LEN(arr); i++) {\n"
    buf = buf + "        hexa_call1(fn, HX_ARR_ITEMS(arr)[i]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_array_for_each(HexaVal arr, HexaVal fn_v);\n"
    buf = buf + "HexaVal hexa_array_for_each(HexaVal arr, HexaVal fn) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_void();\n"
    buf = buf + "    return rt_array_for_each(arr, fn);\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// fill: new array of same length, every slot set to v.\n"
    buf = buf + "// Matches interpreter: returns a NEW array rather than mutating in place\n"
    buf = buf + "// (hexa_full.hexa:15486-15494).\n"
    buf = buf + "// Step-3 cycle 34 port — float fast-path dispatches to rt_array_fill_float\n"
    buf = buf + "// when both the array is all-float and the fill value is float; mixed-type\n"
    buf = buf + "// arrays stay on the polymorphic C body.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_array_fill(HexaVal arr, HexaVal v) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int64_t n = HX_ARR_LEN(arr);\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        out = hexa_array_push(out, v);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_array_fill_float(HexaVal arr, HexaVal v);\n"
    buf = buf + "HexaVal hexa_array_fill(HexaVal arr, HexaVal v) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    if (HX_IS_FLOAT(v) && _arr_all_float(arr)) {\n"
    buf = buf + "        return rt_array_fill_float(arr, v);\n"
    buf = buf + "    }\n"
    buf = buf + "    int64_t n = HX_ARR_LEN(arr);\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        out = hexa_array_push(out, v);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// rt#32-O (r5-a10.5-A, 2026-04-20): leak-fix primitives for CLM training.\n"
    buf = buf + "//\n"
    buf = buf + "// Root cause: train_clm.hexa per-step has ~88 _tz(N) calls (decoder forward\n"
    buf = buf + "// 12-block stack). Each _tz did N hexa_array_push() from cap=0, accumulating\n"
    buf = buf + "// to a malloc'd buffer of N*sizeof(HexaVal) ~= N*32B that hexa never frees\n"
    buf = buf + "// (no GC, value-typed). At seq=512 d=768 that is 12.6 MB per call, ~1.1 GB\n"
    buf = buf + "// per step = 1.5 GB/min observed leak. Two new primitives fix this:\n"
    buf = buf + "//\n"
    buf = buf + "// 1) hexa_array_zeros_float(n): single-shot calloc of N HexaVal slots\n"
    buf = buf + "//    pre-filled with hexa_float(0.0). Returns array with cap=len=n. No\n"
    buf = buf + "//    realloc churn (was 17 grows per call at N=393K). Replaces _tz body.\n"
    buf = buf + "//\n"
    buf = buf + "// 2) hexa_array_free(arr): frees items buffer + descriptor. Hexa is\n"
    buf = buf + "//    pass-by-value at HexaVal level, but the .arr_ptr / .items pointers\n"
    buf = buf + "//    are shared. Caller MUST guarantee no other live alias. Used at\n"
    buf = buf + "//    end-of-train_step to reclaim block_hs / fwd / bwd buffers known to\n"
    buf = buf + "//    be local. Returns hexa_void().\n"
    buf = buf + "// Step-3 cycle 105 port — single-shot zeroed-array fast-paths now have\n"
    buf = buf + "// hexa-source bodies (rt_array_zeros_float / rt_array_alloc) backed by the\n"
    buf = buf + "// __arr_alloc_items_zero{,_int} codegen-inline builtins. The C wrapper\n"
    buf = buf + "// normalizes the float/int `n` arg, then dispatches. 잔여 #6.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_array_zeros_float(HexaVal nv) {\n"
    buf = buf + "    if (_hx_stats_on()) _hx_stats_array_new++;\n"
    buf = buf + "    HexaVal out = {.tag=TAG_ARRAY};\n"
    buf = buf + "    HX_SET_ARR_PTR(out, (HexaArr*)calloc(1, sizeof(HexaArr)));\n"
    buf = buf + "    int64_t n = HX_IS_INT(nv) ? HX_INT(nv) : (int64_t)__hx_to_double(nv);\n"
    buf = buf + "    if (n <= 0) return out;\n"
    buf = buf + "    HexaVal* items = (HexaVal*)malloc(sizeof(HexaVal) * (size_t)n);\n"
    buf = buf + "    if (!items) { fprintf(stderr, \"OOM in array_zeros_float n=%lld\\n\", (long long)n); exit(1); }\n"
    buf = buf + "    HexaVal zero = {.tag=TAG_FLOAT, .f=0.0};\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) items[i] = zero;\n"
    buf = buf + "    HX_SET_ARR_ITEMS(out, items);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    HX_SET_ARR_LEN(out, (int)n);\n"
    buf = buf + "    HX_SET_ARR_CAP(out, (int)n);  // positive → heap\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_array_zeros_float(HexaVal n);\n"
    buf = buf + "HexaVal hexa_array_zeros_float(HexaVal nv) {\n"
    buf = buf + "    if (_hx_stats_on()) _hx_stats_array_new++;\n"
    buf = buf + "    int64_t n = HX_IS_INT(nv) ? HX_INT(nv) : (int64_t)__hx_to_double(nv);\n"
    buf = buf + "    return rt_array_zeros_float(hexa_int(n));\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// ω-interp-3 (2026-04-26): array_alloc(n) — pre-allocate N-element int array,\n"
    buf = buf + "// all slots = 0. Counterpart to hexa_array_zeros_float for int buffers.\n"
    buf = buf + "// O(n) once + O(1) per element via indexed assign.\n"
    buf = buf + "//\n"
    buf = buf + "// Use case: ω-audio-3 vocal_hexa knows N=4800 bytes upfront; replacing N×\n"
    buf = buf + "// hexa_array_push with array_alloc(N) + indexed assign drops per-element\n"
    buf = buf + "// dispatch overhead 2-4× (single store vs method-call + env_set rebind).\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_array_alloc(HexaVal nv) {\n"
    buf = buf + "    if (_hx_stats_on()) _hx_stats_array_new++;\n"
    buf = buf + "    HexaVal out = {.tag=TAG_ARRAY};\n"
    buf = buf + "    HX_SET_ARR_PTR(out, (HexaArr*)calloc(1, sizeof(HexaArr)));\n"
    buf = buf + "    int64_t n = HX_IS_INT(nv) ? HX_INT(nv) : (int64_t)__hx_to_double(nv);\n"
    buf = buf + "    if (n <= 0) return out;\n"
    buf = buf + "    HexaVal* items = (HexaVal*)malloc(sizeof(HexaVal) * (size_t)n);\n"
    buf = buf + "    if (!items) { fprintf(stderr, \"OOM in array_alloc n=%lld\\n\", (long long)n); exit(1); }\n"
    buf = buf + "    HexaVal zero = {.tag=TAG_INT, .i=0};\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) items[i] = zero;\n"
    buf = buf + "    HX_SET_ARR_ITEMS(out, items);\n"
    buf = buf + "    HX_SET_ARR_LEN(out, (int)n);\n"
    buf = buf + "    HX_SET_ARR_CAP(out, (int)n);  // positive → heap\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_array_alloc(HexaVal n);\n"
    buf = buf + "HexaVal hexa_array_alloc(HexaVal nv) {\n"
    buf = buf + "    if (_hx_stats_on()) _hx_stats_array_new++;\n"
    buf = buf + "    int64_t n = HX_IS_INT(nv) ? HX_INT(nv) : (int64_t)__hx_to_double(nv);\n"
    buf = buf + "    return rt_array_alloc(hexa_int(n));\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_array_free(HexaVal arr) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_void();\n"
    buf = buf + "    HexaArr* p = arr.arr_ptr;\n"
    buf = buf + "    if (!p) return hexa_void();\n"
    buf = buf + "    // Only free heap-backed buffers (cap>0). Arena-backed (cap<0) belong\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    // to the arena slab and must not be passed to free().\n"
    buf = buf + "    if (p->items && p->cap > 0) {\n"
    buf = buf + "        free(p->items);\n"
    buf = buf + "    }\n"
    buf = buf + "    p->items = NULL;\n"
    buf = buf + "    p->len = 0;\n"
    buf = buf + "    p->cap = 0;\n"
    buf = buf + "    free(p);\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// take(n) / drop(n). Step-3 cycle 24 port (float-only fast path).\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_array_take(HexaVal arr, HexaVal nv) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int64_t n = HX_IS_INT(nv) ? HX_INT(nv) : (int64_t)__hx_to_double(nv);\n"
    buf = buf + "    int64_t len = HX_ARR_LEN(arr);\n"
    buf = buf + "    int64_t k = n < len ? n : len;\n"
    buf = buf + "    if (k < 0) k = 0;\n"
    buf = buf + "    for (int64_t i = 0; i < k; i++) {\n"
    buf = buf + "        out = hexa_array_push(out, HX_ARR_ITEMS(arr)[i]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_array_drop(HexaVal arr, HexaVal nv) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int64_t n = HX_IS_INT(nv) ? HX_INT(nv) : (int64_t)__hx_to_double(nv);\n"
    buf = buf + "    int64_t len = HX_ARR_LEN(arr);\n"
    buf = buf + "    int64_t start = n < 0 ? 0 : (n > len ? len : n);\n"
    buf = buf + "    for (int64_t i = start; i < len; i++) {\n"
    buf = buf + "        out = hexa_array_push(out, HX_ARR_ITEMS(arr)[i]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_array_take_float(HexaVal arr, HexaVal n);\n"
    buf = buf + "extern HexaVal rt_array_drop_float(HexaVal arr, HexaVal n);\n"
    buf = buf + "HexaVal hexa_array_take(HexaVal arr, HexaVal nv) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int64_t n = HX_IS_INT(nv) ? HX_INT(nv) : (int64_t)__hx_to_double(nv);\n"
    buf = buf + "    if (_arr_all_float(arr)) return rt_array_take_float(arr, hexa_int(n));\n"
    buf = buf + "    int64_t len = HX_ARR_LEN(arr);\n"
    buf = buf + "    int64_t k = n < len ? n : len;\n"
    buf = buf + "    if (k < 0) k = 0;\n"
    buf = buf + "    for (int64_t i = 0; i < k; i++) {\n"
    buf = buf + "        out = hexa_array_push(out, HX_ARR_ITEMS(arr)[i]);\n"
    buf = buf + "    }\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_array_drop(HexaVal arr, HexaVal nv) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int64_t n = HX_IS_INT(nv) ? HX_INT(nv) : (int64_t)__hx_to_double(nv);\n"
    buf = buf + "    if (_arr_all_float(arr)) return rt_array_drop_float(arr, hexa_int(n));\n"
    buf = buf + "    int64_t len = HX_ARR_LEN(arr);\n"
    buf = buf + "    int64_t start = n < 0 ? 0 : (n > len ? len : n);\n"
    buf = buf + "    for (int64_t i = start; i < len; i++) {\n"
    buf = buf + "        out = hexa_array_push(out, HX_ARR_ITEMS(arr)[i]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// zip(other): pairs [a_i, b_i] up to min(len(a), len(b)). Step-3 cycle 25.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_array_zip(HexaVal a, HexaVal b) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(a) || !HX_IS_ARRAY(b)) return out;\n"
    buf = buf + "    int64_t na = HX_ARR_LEN(a), nb = HX_ARR_LEN(b);\n"
    buf = buf + "    int64_t k = na < nb ? na : nb;\n"
    buf = buf + "    for (int64_t i = 0; i < k; i++) {\n"
    buf = buf + "        HexaVal pair = hexa_array_new();\n"
    buf = buf + "        pair = hexa_array_push(pair, HX_ARR_ITEMS(a)[i]);\n"
    buf = buf + "        pair = hexa_array_push(pair, HX_ARR_ITEMS(b)[i]);\n"
    buf = buf + "        out = hexa_array_push(out, pair);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_array_zip_float(HexaVal a, HexaVal b);\n"
    buf = buf + "HexaVal hexa_array_zip(HexaVal a, HexaVal b) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(a) || !HX_IS_ARRAY(b)) return out;\n"
    buf = buf + "    if (_arr_all_float(a) && _arr_all_float(b)) return rt_array_zip_float(a, b);\n"
    buf = buf + "    int64_t na = HX_ARR_LEN(a), nb = HX_ARR_LEN(b);\n"
    buf = buf + "    int64_t k = na < nb ? na : nb;\n"
    buf = buf + "    for (int64_t i = 0; i < k; i++) {\n"
    buf = buf + "        HexaVal pair = hexa_array_new();\n"
    buf = buf + "        pair = hexa_array_push(pair, HX_ARR_ITEMS(a)[i]);\n"
    buf = buf + "        pair = hexa_array_push(pair, HX_ARR_ITEMS(b)[i]);\n"
    buf = buf + "        out = hexa_array_push(out, pair);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// chain(other): concatenate two arrays end-to-end. Matches Rust's\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// `Iterator::chain`; `.chain(b)` returns [a_0..a_n, b_0..b_m]. Eager\n"
    buf = buf + "// (hexa iterators are arrays). PROBE r14-JJJJ (2026-05-24).\n"
    buf = buf + "HexaVal hexa_array_concat(HexaVal a, HexaVal b) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (HX_IS_ARRAY(a)) {\n"
    buf = buf + "        for (int64_t i = 0; i < HX_ARR_LEN(a); i++) {\n"
    buf = buf + "            out = hexa_array_push(out, HX_ARR_ITEMS(a)[i]);\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    if (HX_IS_ARRAY(b)) {\n"
    buf = buf + "        for (int64_t i = 0; i < HX_ARR_LEN(b); i++) {\n"
    buf = buf + "            out = hexa_array_push(out, HX_ARR_ITEMS(b)[i]);\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// chunk(n): split into non-overlapping chunks of size n (last may be shorter).\n"
    buf = buf + "// Matches interpreter at hexa_full.hexa:15363-15378. Step-3 cycle 26.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_array_chunk(HexaVal arr, HexaVal nv) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int64_t n = HX_IS_INT(nv) ? HX_INT(nv) : (int64_t)__hx_to_double(nv);\n"
    buf = buf + "    if (n <= 0) return out;\n"
    buf = buf + "    int64_t len = HX_ARR_LEN(arr);\n"
    buf = buf + "    for (int64_t i = 0; i < len; i += n) {\n"
    buf = buf + "        HexaVal chunk = hexa_array_new();\n"
    buf = buf + "        int64_t stop = i + n;\n"
    buf = buf + "        if (stop > len) stop = len;\n"
    buf = buf + "        for (int64_t j = i; j < stop; j++) {\n"
    buf = buf + "            chunk = hexa_array_push(chunk, HX_ARR_ITEMS(arr)[j]);\n"
    buf = buf + "        }\n"
    buf = buf + "        out = hexa_array_push(out, chunk);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_array_chunk_float(HexaVal arr, HexaVal n);\n"
    buf = buf + "HexaVal hexa_array_chunk(HexaVal arr, HexaVal nv) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int64_t n = HX_IS_INT(nv) ? HX_INT(nv) : (int64_t)__hx_to_double(nv);\n"
    buf = buf + "    if (_arr_all_float(arr)) return rt_array_chunk_float(arr, hexa_int(n));\n"
    buf = buf + "    if (n <= 0) return out;\n"
    buf = buf + "    int64_t len = HX_ARR_LEN(arr);\n"
    buf = buf + "    for (int64_t i = 0; i < len; i += n) {\n"
    buf = buf + "        HexaVal chunk = hexa_array_new();\n"
    buf = buf + "        int64_t stop = i + n;\n"
    buf = buf + "        if (stop > len) stop = len;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        for (int64_t j = i; j < stop; j++) {\n"
    buf = buf + "            chunk = hexa_array_push(chunk, HX_ARR_ITEMS(arr)[j]);\n"
    buf = buf + "        }\n"
    buf = buf + "        out = hexa_array_push(out, chunk);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// window(n): sliding windows of size n (step 1). Empty if n > len or n ≤ 0.\n"
    buf = buf + "// Matches interpreter at hexa_full.hexa:15380-15395.\n"
    buf = buf + "// Step-3 cycle 31 port — float-typed arrays dispatch to rt_array_window_float\n"
    buf = buf + "// in stdlib/runtime/numeric.hexa; mixed-typed arrays stay on the C path.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_array_window(HexaVal arr, HexaVal nv) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int64_t n = HX_IS_INT(nv) ? HX_INT(nv) : (int64_t)__hx_to_double(nv);\n"
    buf = buf + "    int64_t len = HX_ARR_LEN(arr);\n"
    buf = buf + "    if (n <= 0 || n > len) return out;\n"
    buf = buf + "    for (int64_t i = 0; i + n <= len; i++) {\n"
    buf = buf + "        HexaVal win = hexa_array_new();\n"
    buf = buf + "        for (int64_t j = 0; j < n; j++) {\n"
    buf = buf + "            win = hexa_array_push(win, HX_ARR_ITEMS(arr)[i + j]);\n"
    buf = buf + "        }\n"
    buf = buf + "        out = hexa_array_push(out, win);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_array_window_float(HexaVal arr, HexaVal n);\n"
    buf = buf + "HexaVal hexa_array_window(HexaVal arr, HexaVal nv) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int64_t n = HX_IS_INT(nv) ? HX_INT(nv) : (int64_t)__hx_to_double(nv);\n"
    buf = buf + "    if (_arr_all_float(arr)) return rt_array_window_float(arr, hexa_int(n));\n"
    buf = buf + "    int64_t len = HX_ARR_LEN(arr);\n"
    buf = buf + "    if (n <= 0 || n > len) return out;\n"
    buf = buf + "    for (int64_t i = 0; i + n <= len; i++) {\n"
    buf = buf + "        HexaVal win = hexa_array_new();\n"
    buf = buf + "        for (int64_t j = 0; j < n; j++) {\n"
    buf = buf + "            win = hexa_array_push(win, HX_ARR_ITEMS(arr)[i + j]);\n"
    buf = buf + "        }\n"
    buf = buf + "        out = hexa_array_push(out, win);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// unique: dedupe by hexa_eq. O(n²) — matches interpreter's equality\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// check (hexa_full.hexa:15263-15277). Step-3 cycle 29 port.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_array_unique(HexaVal arr) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int64_t len = HX_ARR_LEN(arr);\n"
    buf = buf + "    for (int64_t i = 0; i < len; i++) {\n"
    buf = buf + "        HexaVal it = HX_ARR_ITEMS(arr)[i];\n"
    buf = buf + "        int seen = 0;\n"
    buf = buf + "        for (int64_t j = 0; j < HX_ARR_LEN(out); j++) {\n"
    buf = buf + "            if (hexa_truthy(hexa_eq(HX_ARR_ITEMS(out)[j], it))) { seen = 1; break; }\n"
    buf = buf + "        }\n"
    buf = buf + "        if (!seen) out = hexa_array_push(out, it);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_array_unique_float(HexaVal arr);\n"
    buf = buf + "HexaVal hexa_array_unique(HexaVal arr) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    if (_arr_all_float(arr)) return rt_array_unique_float(arr);\n"
    buf = buf + "    int64_t len = HX_ARR_LEN(arr);\n"
    buf = buf + "    for (int64_t i = 0; i < len; i++) {\n"
    buf = buf + "        HexaVal it = HX_ARR_ITEMS(arr)[i];\n"
    buf = buf + "        int seen = 0;\n"
    buf = buf + "        for (int64_t j = 0; j < HX_ARR_LEN(out); j++) {\n"
    buf = buf + "            if (hexa_truthy(hexa_eq(HX_ARR_ITEMS(out)[j], it))) { seen = 1; break; }\n"
    buf = buf + "        }\n"
    buf = buf + "        if (!seen) out = hexa_array_push(out, it);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// ── PROBE r16 Q5: additional iterator adapters ──────────────────────────────\n"
    buf = buf + "// Direct-C implementations (compiled in ALL build modes — these are new\n"
    buf = buf + "// symbols with no rt_* counterpart, so no #ifdef HEXA_HAS_HEXA_RT_STDLIB pair\n"
    buf = buf + "// is needed). Each mirrors the established higher-order idiom (hexa_call1/2 for\n"
    buf = buf + "// callback dispatch, hexa_array_push to build the result, hexa_truthy/hexa_cmp_*\n"
    buf = buf + "// for comparison). Wired into codegen dispatch at self/codegen.hexa.\n"
    buf = buf + "\n"
    buf = buf + "// take_while(pred): leading run where pred(x) is truthy; stops at first false.\n"
    buf = buf + "HexaVal hexa_array_take_while(HexaVal arr, HexaVal fn) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int64_t len = HX_ARR_LEN(arr);\n"
    buf = buf + "    for (int64_t i = 0; i < len; i++) {\n"
    buf = buf + "        if (!hexa_truthy(hexa_call1(fn, HX_ARR_ITEMS(arr)[i]))) break;\n"
    buf = buf + "        out = hexa_array_push(out, HX_ARR_ITEMS(arr)[i]);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// skip_while(pred): drop the leading run where pred(x) is truthy; keep the rest.\n"
    buf = buf + "HexaVal hexa_array_skip_while(HexaVal arr, HexaVal fn) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int64_t len = HX_ARR_LEN(arr);\n"
    buf = buf + "    int64_t i = 0;\n"
    buf = buf + "    while (i < len && hexa_truthy(hexa_call1(fn, HX_ARR_ITEMS(arr)[i]))) i++;\n"
    buf = buf + "    for (; i < len; i++) out = hexa_array_push(out, HX_ARR_ITEMS(arr)[i]);\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// min_by(key_fn): element with the smallest key_fn(x) value. Empty → void.\n"
    buf = buf + "HexaVal hexa_array_min_by(HexaVal arr, HexaVal fn) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr) || HX_ARR_LEN(arr) == 0) return hexa_void();\n"
    buf = buf + "    int64_t len = HX_ARR_LEN(arr);\n"
    buf = buf + "    HexaVal best = HX_ARR_ITEMS(arr)[0];\n"
    buf = buf + "    HexaVal best_key = hexa_call1(fn, best);\n"
    buf = buf + "    for (int64_t i = 1; i < len; i++) {\n"
    buf = buf + "        HexaVal it = HX_ARR_ITEMS(arr)[i];\n"
    buf = buf + "        HexaVal k = hexa_call1(fn, it);\n"
    buf = buf + "        if (hexa_truthy(hexa_cmp_lt(k, best_key))) { best = it; best_key = k; }\n"
    buf = buf + "    }\n"
    buf = buf + "    return best;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// max_by(key_fn): element with the largest key_fn(x) value. Empty → void.\n"
    buf = buf + "HexaVal hexa_array_max_by(HexaVal arr, HexaVal fn) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr) || HX_ARR_LEN(arr) == 0) return hexa_void();\n"
    buf = buf + "    int64_t len = HX_ARR_LEN(arr);\n"
    buf = buf + "    HexaVal best = HX_ARR_ITEMS(arr)[0];\n"
    buf = buf + "    HexaVal best_key = hexa_call1(fn, best);\n"
    buf = buf + "    for (int64_t i = 1; i < len; i++) {\n"
    buf = buf + "        HexaVal it = HX_ARR_ITEMS(arr)[i];\n"
    buf = buf + "        HexaVal k = hexa_call1(fn, it);\n"
    buf = buf + "        if (hexa_truthy(hexa_cmp_gt(k, best_key))) { best = it; best_key = k; }\n"
    buf = buf + "    }\n"
    buf = buf + "    return best;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// position(pred): index of the first element where pred(x) is truthy, else -1.\n"
    buf = buf + "HexaVal hexa_array_position(HexaVal arr, HexaVal fn) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_int(-1);\n"
    buf = buf + "    int64_t len = HX_ARR_LEN(arr);\n"
    buf = buf + "    for (int64_t i = 0; i < len; i++) {\n"
    buf = buf + "        if (hexa_truthy(hexa_call1(fn, HX_ARR_ITEMS(arr)[i]))) return hexa_int(i);\n"
    buf = buf + "    }\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    return hexa_int(-1);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// reduce(fn): init-less left fold — seeds with element 0, folds the rest.\n"
    buf = buf + "// Empty array throws (no initial value, like Rust Iterator::reduce → None but\n"
    buf = buf + "// hexa has no Option here; a clear throw beats a silent void miscompile).\n"
    buf = buf + "HexaVal hexa_array_reduce(HexaVal arr, HexaVal fn) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr) || HX_ARR_LEN(arr) == 0) {\n"
    buf = buf + "        hexa_throw(hexa_str(\"reduce of empty array (no initial value)\"));\n"
    buf = buf + "        return hexa_void();\n"
    buf = buf + "    }\n"
    buf = buf + "    int64_t len = HX_ARR_LEN(arr);\n"
    buf = buf + "    HexaVal acc = HX_ARR_ITEMS(arr)[0];\n"
    buf = buf + "    for (int64_t i = 1; i < len; i++) acc = hexa_call2(fn, acc, HX_ARR_ITEMS(arr)[i]);\n"
    buf = buf + "    return acc;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// dedup(): collapse runs of ADJACENT equal elements (Rust Vec::dedup). Distinct\n"
    buf = buf + "// from unique() which removes ALL duplicates. Equality via hexa_eq.\n"
    buf = buf + "HexaVal hexa_array_dedup(HexaVal arr) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int64_t len = HX_ARR_LEN(arr);\n"
    buf = buf + "    for (int64_t i = 0; i < len; i++) {\n"
    buf = buf + "        HexaVal it = HX_ARR_ITEMS(arr)[i];\n"
    buf = buf + "        if (i == 0 || !hexa_truthy(hexa_eq(HX_ARR_ITEMS(arr)[i - 1], it))) {\n"
    buf = buf + "            out = hexa_array_push(out, it);\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// step_by(n): every n-th element starting at index 0. n<=0 → empty.\n"
    buf = buf + "HexaVal hexa_array_step_by(HexaVal arr, HexaVal nv) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int64_t n = HX_IS_INT(nv) ? HX_INT(nv) : (int64_t)__hx_to_double(nv);\n"
    buf = buf + "    if (n <= 0) return out;\n"
    buf = buf + "    int64_t len = HX_ARR_LEN(arr);\n"
    buf = buf + "    for (int64_t i = 0; i < len; i += n) out = hexa_array_push(out, HX_ARR_ITEMS(arr)[i]);\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// rotate(k): k>0 shifts left (items[k] becomes new head); k<0 shifts right.\n"
    buf = buf + "// k normalized mod len. Step-3 cycle 30 port.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_array_rotate(HexaVal arr, HexaVal kv) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int64_t n = HX_ARR_LEN(arr);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    if (n == 0) return out;\n"
    buf = buf + "    int64_t k = HX_IS_INT(kv) ? HX_INT(kv) : (int64_t)__hx_to_double(kv);\n"
    buf = buf + "    k = k % n;\n"
    buf = buf + "    if (k < 0) k += n;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        out = hexa_array_push(out, HX_ARR_ITEMS(arr)[(i + k) % n]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_array_rotate_float(HexaVal arr, HexaVal k);\n"
    buf = buf + "HexaVal hexa_array_rotate(HexaVal arr, HexaVal kv) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int64_t n = HX_ARR_LEN(arr);\n"
    buf = buf + "    if (n == 0) return out;\n"
    buf = buf + "    int64_t k = HX_IS_INT(kv) ? HX_INT(kv) : (int64_t)__hx_to_double(kv);\n"
    buf = buf + "    if (_arr_all_float(arr)) return rt_array_rotate_float(arr, hexa_int(k));\n"
    buf = buf + "    k = k % n;\n"
    buf = buf + "    if (k < 0) k += n;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        out = hexa_array_push(out, HX_ARR_ITEMS(arr)[(i + k) % n]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// partition(pred): returns [matching, non_matching] as a 2-element array.\n"
    buf = buf + "// Matches interpreter at hexa_full.hexa:15437-15449.\n"
    buf = buf + "// Step-3 cycle 67 port — partition dispatch.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_array_partition(HexaVal arr, HexaVal fn) {\n"
    buf = buf + "    HexaVal matching = hexa_array_new();\n"
    buf = buf + "    HexaVal rest = hexa_array_new();\n"
    buf = buf + "    if (HX_IS_ARRAY(arr)) {\n"
    buf = buf + "        for (int64_t i = 0; i < HX_ARR_LEN(arr); i++) {\n"
    buf = buf + "            HexaVal it = HX_ARR_ITEMS(arr)[i];\n"
    buf = buf + "            if (hexa_truthy(hexa_call1(fn, it))) {\n"
    buf = buf + "                matching = hexa_array_push(matching, it);\n"
    buf = buf + "            } else {\n"
    buf = buf + "                rest = hexa_array_push(rest, it);\n"
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    out = hexa_array_push(out, matching);\n"
    buf = buf + "    out = hexa_array_push(out, rest);\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "extern HexaVal rt_array_partition(HexaVal arr, HexaVal fn_v);\n"
    buf = buf + "HexaVal hexa_array_partition(HexaVal arr, HexaVal fn) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) {\n"
    buf = buf + "        HexaVal out = hexa_array_new();\n"
    buf = buf + "        out = hexa_array_push(out, hexa_array_new());\n"
    buf = buf + "        out = hexa_array_push(out, hexa_array_new());\n"
    buf = buf + "        return out;\n"
    buf = buf + "    }\n"
    buf = buf + "    return rt_array_partition(arr, fn);\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// interleave(other): alternates items from both arrays up to max length.\n"
    buf = buf + "// When one array runs out, the other's remaining items still alternate in.\n"
    buf = buf + "// Matches interpreter at hexa_full.hexa:15451-15464.\n"
    buf = buf + "// Step-3 cycle 37 port — float fast-path dispatches when both arrays\n"
    buf = buf + "// are all-float; mixed-type stays on the polymorphic C body.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_array_interleave(HexaVal a, HexaVal b) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(a)) {\n"
    buf = buf + "        return HX_IS_ARRAY(b) ? b : out;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (!HX_IS_ARRAY(b)) return a;\n"
    buf = buf + "    int64_t na = HX_ARR_LEN(a), nb = HX_ARR_LEN(b);\n"
    buf = buf + "    int64_t m = na > nb ? na : nb;\n"
    buf = buf + "    for (int64_t i = 0; i < m; i++) {\n"
    buf = buf + "        if (i < na) out = hexa_array_push(out, HX_ARR_ITEMS(a)[i]);\n"
    buf = buf + "        if (i < nb) out = hexa_array_push(out, HX_ARR_ITEMS(b)[i]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_array_interleave_float(HexaVal a, HexaVal b);\n"
    buf = buf + "HexaVal hexa_array_interleave(HexaVal a, HexaVal b) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(a)) {\n"
    buf = buf + "        return HX_IS_ARRAY(b) ? b : out;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (!HX_IS_ARRAY(b)) return a;\n"
    buf = buf + "    if (_arr_all_float(a) && _arr_all_float(b)) {\n"
    buf = buf + "        return rt_array_interleave_float(a, b);\n"
    buf = buf + "    }\n"
    buf = buf + "    int64_t na = HX_ARR_LEN(a), nb = HX_ARR_LEN(b);\n"
    buf = buf + "    int64_t m = na > nb ? na : nb;\n"
    buf = buf + "    for (int64_t i = 0; i < m; i++) {\n"
    buf = buf + "        if (i < na) out = hexa_array_push(out, HX_ARR_ITEMS(a)[i]);\n"
    buf = buf + "        if (i < nb) out = hexa_array_push(out, HX_ARR_ITEMS(b)[i]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// scan(init, fn): like fold but returns all intermediate accumulators.\n"
    buf = buf + "// Result length is len(arr) + 1 (includes init as first element).\n"
    buf = buf + "// Matches interpreter at hexa_full.hexa:15426-15435.\n"
    buf = buf + "// Step-3 cycle 67 port — scan dispatch.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_array_scan(HexaVal arr, HexaVal init, HexaVal fn) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    out = hexa_array_push(out, init);\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    HexaVal acc = init;\n"
    buf = buf + "    for (int64_t i = 0; i < HX_ARR_LEN(arr); i++) {\n"
    buf = buf + "        acc = hexa_call2(fn, acc, HX_ARR_ITEMS(arr)[i]);\n"
    buf = buf + "        out = hexa_array_push(out, acc);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_array_scan(HexaVal arr, HexaVal init, HexaVal fn_v);\n"
    buf = buf + "HexaVal hexa_array_scan(HexaVal arr, HexaVal init, HexaVal fn) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) {\n"
    buf = buf + "        HexaVal out = hexa_array_new();\n"
    buf = buf + "        return hexa_array_push(out, init);\n"
    buf = buf + "    }\n"
    buf = buf + "    return rt_array_scan(arr, init, fn);\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// product(a): multiplicative reduce. Mirrors hexa_sum but with mult.\n"
    buf = buf + "// Empty array returns int 1 (multiplicative identity). Step-3 cycle 23\n"
    buf = buf + "// port (all-float fast path).\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_array_product(HexaVal arr) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_int(1);\n"
    buf = buf + "    int64_t n = HX_ARR_LEN(arr);\n"
    buf = buf + "    int has_float = 0;\n"
    buf = buf + "    int64_t int_total = 1;\n"
    buf = buf + "    double float_total = 1.0;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        HexaVal e = HX_ARR_ITEMS(arr)[i];\n"
    buf = buf + "        if (HX_IS_FLOAT(e)) { has_float = 1; float_total *= HX_FLOAT(e); }\n"
    buf = buf + "        else { int_total *= HX_INT(e); }\n"
    buf = buf + "    }\n"
    buf = buf + "    if (has_float) return hexa_float((double)int_total * float_total);\n"
    buf = buf + "    return hexa_int(int_total);\n"
