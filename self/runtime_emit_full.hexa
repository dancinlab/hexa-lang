    buf = buf + "//       free per ANSI C).\n"
    buf = buf + "//\n"
    buf = buf + "// F3 ACTIVATION RUNBOOK · Path A — class-D HexaVal-repr body self-emit slot.\n"
    buf = buf + "// Distinct gating shape from class-B leaf primitives (see L218-L233 strdup\n"
    buf = buf + "// block):\n"
