    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_setvbuf(void *fp, char *buf, int mode, size_t sz) {\n"
    buf = buf + "    (void)fp; (void)buf; (void)mode; (void)sz;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "// Cycle 57 — Tier-A.4 trivial POSIX stubs. The compiler binary calls\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// these for cleanup / TTY detection / signal hooks / env access / socket\n"
    buf = buf + "// options / pty handling / resource limits — none load-bearing for the\n"
    buf = buf + "// compile-then-exit path. Return safe defaults. `getenv` reads from a\n"
    buf = buf + "// minimal copy of envp captured at first call (Cycle 57+ may wire envp\n"
    buf = buf + "// in main; for now returns NULL = \"var not set\").\n"
    buf = buf + "// step-2 cycle 6 — ISO bisect identified `getenv` as init-time blocker:\n"
    buf = buf + "// hxlcl_getenv() is called by hexa_val_arena_init() / similar startup\n"
    buf = buf + "// paths BEFORE hexa TAG_FN globals (`rt_posix_ok` etc) bind via\n"
    buf = buf + "// `_hexa_init_fn_shims`. Calling rt_posix_ok() then dereferences an\n"
    buf = buf + "// unbound TAG_FN slot → SIGSEGV. Keep init-time helpers (getenv, atexit,\n"
    buf = buf + "// isatty, signal) as plain C; only port post-init helpers.\n"
    buf = buf + "// Ported (post-init, safe): atexit + isatty + signal — actually these\n"
    buf = buf + "// are also called early but their hexa-delegation didn't crash in ISO-C.\n"
    buf = buf + "// The dividing line is: fns called by runtime_init code paths.\n"
    buf = buf + "// Conservative safe set: 5 fns kept as C; 5 ported.\n"
    buf = buf + "static int hxlcl_atexit(void (*fn)(void));\n"
    buf = buf + "static int hxlcl_isatty(int fd);\n"
    buf = buf + "static void *hxlcl_signal(int signum, void *handler);\n"
    buf = buf + "static int hxlcl_sigaction(int signum, const void *act, void *oldact);\n"
    buf = buf + "static int hxlcl_sigprocmask(int how, const void *set, void *oldset);\n"
    buf = buf + "// getenv: cycle 66 — restore real environ-walk (cycle 61's noop stub\n"
    buf = buf + "// silently disabled every env-flag in the runtime, including\n"
    buf = buf + "// HEXA_EXEC_NO_SHELL → posix_spawnp fast path → exec() returned \"\").\n"
    buf = buf + "// Resolves inbox/patches/yosys-exec-runtime-regression-cycles-61-64.md\n"
    buf = buf + "// + inbox/patches/runtime-env-and-exec-capture-stubs-block-cli-tools.md.\n"
    buf = buf + "// Walks the `environ` global directly; matches libc getenv semantics\n"
    buf = buf + "// (case-sensitive, returns first match, NULL on miss). `environ` is our\n"
    buf = buf + "// own captured copy (see the priority-101 constructor near the top).\n"
    buf = buf + "static char *__attribute__((noinline)) hxlcl_getenv(const char *name) {\n"
    buf = buf + "    if (!name) return (char *)0;\n"
    buf = buf + "    char **e = environ;\n"
    buf = buf + "    if (!e) return (char *)0;\n"
    buf = buf + "    size_t nlen = hxlcl_strlen(name);\n"
    buf = buf + "    while (*e) {\n"
    buf = buf + "        const char *entry = *e;\n"
    buf = buf + "        size_t i = 0;\n"
    buf = buf + "        while (i < nlen && entry[i] && entry[i] == name[i]) i++;\n"
    buf = buf + "        if (i == nlen && entry[i] == '=') return (char *)(entry + nlen + 1);\n"
    buf = buf + "        e++;\n"
    buf = buf + "    }\n"
    buf = buf + "    return (char *)0;\n"
    buf = buf + "}\n"
    buf = buf + "static int hxlcl_setenv(const char *name, const char *val, int overwrite);\n"
    buf = buf + "static int hxlcl_setsockopt(int sockfd, int level, int optname, const void *optval, unsigned int optlen);\n"
    buf = buf + "static int hxlcl_grantpt(int fd);\n"
    buf = buf + "static int hxlcl_unlockpt(int fd);\n"
    buf = buf + "// cycle 6: setsockopt/grantpt/unlockpt bodies moved below — see thin shims after #include\n"
    buf = buf + "// cycle 6: ptsname/ttyname/getrlimit/getrusage forward decls — bodies after #include\n"
    buf = buf + "static char *hxlcl_ptsname(int fd);\n"
    buf = buf + "static char *hxlcl_ttyname(int fd);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "static int hxlcl_getrlimit(int resource, void *rlim);\n"
    buf = buf + "static int hxlcl_getrusage(int who, void *usage);\n"
    buf = buf + "// Cycle 59 — Tier-A.5 libm + ctype stubs. The compiler binary doesn't\n"
    buf = buf + "// call cos/exp/log/fmod at all (flame/NN code paths are linked but\n"
    buf = buf + "// unreachable from aprime_cc's compile-then-exit flow). These are 5-7\n"
    buf = buf + "// term Taylor approximations sufficient for any unreachable execution.\n"
    buf = buf + "// `isalnum`/`isalpha` are pure ASCII classification — called by lexer\n"
    buf = buf + "// `_is_ident_cont` / `_is_ident_start`, which IS load-bearing.\n"
    buf = buf + "// RUNTIME.md step-2 cycle 2 — math helper bodies MOVED to stdlib/\n"
    buf = buf + "// runtime/math.hexa. Thin C shims defined below `#include\n"
    buf = buf + "// \"runtime_core.c\"` use HexaVal wrap/unwrap. Forward decls only here\n"
    buf = buf + "// so cycle-46 callers earlier in the file can still link.\n"
    buf = buf + "static double hxlcl_fmod(double x, double y);\n"
    buf = buf + "static double hxlcl_exp(double x);\n"
    buf = buf + "static double hxlcl_log(double x);\n"
    buf = buf + "static double hxlcl_cos(double x);\n"
    buf = buf + "static double hxlcl_sin(double x);\n"
    buf = buf + "// RUNTIME.md step-2 cycle 1 — bodies MOVED below `#include\n"
    buf = buf + "// \"runtime_core.c\"` so they can use HexaVal / hexa_int / hexa_truthy\n"
    buf = buf + "// to delegate to the hexa-source `rt_isalnum`/_isalpha (defined in\n"
    buf = buf + "// stdlib/runtime/ctype.hexa, transpile-emitted into ap_post.c).\n"
    buf = buf + "// Forward decl here so call sites in cycle-46 helpers earlier in\n"
    buf = buf + "// this file can still link.\n"
