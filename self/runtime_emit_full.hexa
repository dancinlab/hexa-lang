    buf = buf + "                                        int64_t out_id);\n"
    buf = buf + "extern int  _hx_cuda_farr_transpose_scatter_gpu(int64_t src_id,\n"
    buf = buf + "                                                int64_t dst_id,\n"
    buf = buf + "                                                int64_t rows, int64_t cols,\n"
    buf = buf + "                                                int64_t dst_off);\n"
    buf = buf + "// RFC gpu-resident-large-vocab-lmhead-loss: GPU CE loss + seed grad.\n"
    buf = buf + "extern int  _hx_cuda_farr_ce_seed_gpu(int64_t logits_id,\n"
    buf = buf + "                                      int64_t target_ids_id,\n"
    buf = buf + "                                      int64_t R, int64_t V,\n"
    buf = buf + "                                      int64_t out_loss_id,\n"
    buf = buf + "                                      int64_t out_dlogits_id);\n"
    buf = buf + "// BC-ANIMA M3 (2026-05-28): 5-arg seed-only CE gradient (softmax →\n"
    buf = buf + "// dlogits = softmax - onehot(target)). Lighter sibling of the fused\n"
    buf = buf + "// 6-arg _hx_cuda_farr_ce_seed_gpu — used when softmax is already\n"
    buf = buf + "// computed (anima trainer separates softmax via M2 farr_softmax_rows).\n"
    buf = buf + "extern int  _hx_cuda_farr_ce_seed(int64_t softmax_id,\n"
    buf = buf + "                                  int64_t target_ids_id,\n"
    buf = buf + "                                  int64_t dlogits_id,\n"
    buf = buf + "                                  int64_t R, int64_t C);\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// ── CPU helpers (Phase B2 no-CUDA fallback). Each: (a) validate ids,\n"
    buf = buf + "//    (b) hexa_farr_zeros output, (c) RE-FETCH entry ptrs post-alloc\n"
    buf = buf + "//    (RFC 032 use-after-realloc guard), (d) compute. ────────────────\n"
    buf = buf + "\n"
    buf = buf + "// _hx_farr_matmul_t_cpu(M, R, C, u) -> new farr_id [C]. Mᵀ·u where M is\n"
    buf = buf + "// row-major [R·C], u is [R]. out[k] = Σ_r M[r·C+k]·u[r]. Mirrors\n"
    buf = buf + "// d_train3_lib c3_matvec_t EXACTLY (same r-outer / k-inner accumulation\n"
    buf = buf + "// order → bit-identical on no-CUDA). -1 on err.\n"
    buf = buf + "static int64_t _hx_farr_matmul_t_cpu(int64_t m_id, int64_t R, int64_t C,\n"
    buf = buf + "                                     int64_t u_id) {\n"
    buf = buf + "    if (m_id < 0 || m_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (u_id < 0 || u_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (R <= 0 || C <= 0)                   return -1;\n"
    buf = buf + "    HexaFarrEntry* me = &_hx_farr_table[m_id];\n"
    buf = buf + "    HexaFarrEntry* ue = &_hx_farr_table[u_id];\n"
    buf = buf + "    if (!me->buf || !ue->buf)               return -1;\n"
    buf = buf + "    if (me->len < R * C || ue->len < R)     return -1;\n"
    buf = buf + "    HexaVal out_h = hexa_farr_zeros(hexa_int(C));\n"
    buf = buf + "    int64_t out_id = HX_INT(out_h);\n"
    buf = buf + "    if (out_id < 0 || out_id >= _hx_farr_count) return -1;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    me = &_hx_farr_table[m_id];\n"
    buf = buf + "    ue = &_hx_farr_table[u_id];\n"
    buf = buf + "    HexaFarrEntry* oe = &_hx_farr_table[out_id];\n"
    buf = buf + "    if (!me->buf || !ue->buf || !oe->buf || oe->len < C) return -1;\n"
    buf = buf + "    const double* M = me->buf;\n"
    buf = buf + "    const double* U = ue->buf;\n"
    buf = buf + "    double*       O = oe->buf;\n"
    buf = buf + "    for (int64_t k = 0; k < C; k++) O[k] = 0.0;\n"
    buf = buf + "    for (int64_t r = 0; r < R; r++) {\n"
    buf = buf + "        const double* mr = M + r * C;\n"
    buf = buf + "        double ur = U[r];\n"
    buf = buf + "        for (int64_t k = 0; k < C; k++) O[k] += mr[k] * ur;\n"
    buf = buf + "    }\n"
    buf = buf + "    return out_id;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// _hx_farr_packed_gemv_offset_cpu(p_id, off, rows, cols, u_id) -> new\n"
    buf = buf + "// farr_id [rows]. P is a packed double buffer; the [rows×cols] sub-block\n"
    buf = buf + "// starts at element `off`. out[i] = Σ_j P[off + i·cols + j] · U[j].\n"
    buf = buf + "// Mirrors anima flame_mm.hexa mm_packed_gemv EXACTLY — same i-outer /\n"
    buf = buf + "// j-inner accumulation order → bit-identical on no-CUDA. -1 on err.\n"
    buf = buf + "static int64_t _hx_farr_packed_gemv_offset_cpu(int64_t p_id, int64_t off,\n"
    buf = buf + "                                               int64_t rows, int64_t cols,\n"
    buf = buf + "                                               int64_t u_id) {\n"
    buf = buf + "    if (p_id < 0 || p_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (u_id < 0 || u_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (rows <= 0 || cols <= 0 || off < 0)  return -1;\n"
    buf = buf + "    HexaFarrEntry* pe = &_hx_farr_table[p_id];\n"
    buf = buf + "    HexaFarrEntry* ue = &_hx_farr_table[u_id];\n"
    buf = buf + "    if (!pe->buf || !ue->buf)               return -1;\n"
    buf = buf + "    if (pe->len < off + rows * cols || ue->len < cols) return -1;\n"
    buf = buf + "    HexaVal out_h = hexa_farr_zeros(hexa_int(rows));\n"
    buf = buf + "    int64_t out_id = HX_INT(out_h);\n"
    buf = buf + "    if (out_id < 0 || out_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    pe = &_hx_farr_table[p_id];\n"
    buf = buf + "    ue = &_hx_farr_table[u_id];\n"
    buf = buf + "    HexaFarrEntry* oe = &_hx_farr_table[out_id];\n"
    buf = buf + "    if (!pe->buf || !ue->buf || !oe->buf || oe->len < rows) return -1;\n"
    buf = buf + "    const double* P = pe->buf;\n"
    buf = buf + "    const double* U = ue->buf;\n"
    buf = buf + "    double*       O = oe->buf;\n"
    buf = buf + "    for (int64_t i = 0; i < rows; i++) {\n"
    buf = buf + "        double acc = 0.0;\n"
    buf = buf + "        const double* pr = P + off + i * cols;\n"
    buf = buf + "        for (int64_t j = 0; j < cols; j++) acc += pr[j] * U[j];\n"
    buf = buf + "        O[i] = acc;\n"
    buf = buf + "    }\n"
    buf = buf + "    return out_id;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// _hx_farr_outer_cpu(u, v, R, C) -> new farr_id [R·C]. out[r·C+c] =\n"
    buf = buf + "// u[r]·v[c]. Mirrors c3_outer EXACTLY. -1 on err.\n"
    buf = buf + "static int64_t _hx_farr_outer_cpu(int64_t u_id, int64_t v_id,\n"
    buf = buf + "                                  int64_t R, int64_t C) {\n"
    buf = buf + "    if (u_id < 0 || u_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (v_id < 0 || v_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (R <= 0 || C <= 0)                   return -1;\n"
    buf = buf + "    HexaFarrEntry* ue = &_hx_farr_table[u_id];\n"
    buf = buf + "    HexaFarrEntry* ve = &_hx_farr_table[v_id];\n"
    buf = buf + "    if (!ue->buf || !ve->buf)               return -1;\n"
    buf = buf + "    if (ue->len < R || ve->len < C)         return -1;\n"
    buf = buf + "    HexaVal out_h = hexa_farr_zeros(hexa_int(R * C));\n"
    buf = buf + "    int64_t out_id = HX_INT(out_h);\n"
    buf = buf + "    if (out_id < 0 || out_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    ue = &_hx_farr_table[u_id];\n"
    buf = buf + "    ve = &_hx_farr_table[v_id];\n"
    buf = buf + "    HexaFarrEntry* oe = &_hx_farr_table[out_id];\n"
    buf = buf + "    if (!ue->buf || !ve->buf || !oe->buf || oe->len < R * C) return -1;\n"
    buf = buf + "    const double* U = ue->buf;\n"
    buf = buf + "    const double* V = ve->buf;\n"
    buf = buf + "    double*       O = oe->buf;\n"
    buf = buf + "    for (int64_t r = 0; r < R; r++) {\n"
    buf = buf + "        double ur = U[r];\n"
    buf = buf + "        double* orow = O + r * C;\n"
    buf = buf + "        for (int64_t c = 0; c < C; c++) orow[c] = ur * V[c];\n"
    buf = buf + "    }\n"
    buf = buf + "    return out_id;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// _hx_farr_mul_cpu(a, b, n) -> new farr_id. C = A⊙B (Hadamard). -1 err.\n"
    buf = buf + "static int64_t _hx_farr_mul_cpu(int64_t a_id, int64_t b_id, int64_t n) {\n"
    buf = buf + "    if (a_id < 0 || a_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (b_id < 0 || b_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (n <= 0)                              return -1;\n"
    buf = buf + "    HexaFarrEntry* ae = &_hx_farr_table[a_id];\n"
    buf = buf + "    HexaFarrEntry* be = &_hx_farr_table[b_id];\n"
    buf = buf + "    if (!ae->buf || !be->buf)                return -1;\n"
    buf = buf + "    if (ae->len < n || be->len < n)          return -1;\n"
    buf = buf + "    HexaVal out_h = hexa_farr_zeros(hexa_int(n));\n"
    buf = buf + "    int64_t out_id = HX_INT(out_h);\n"
    buf = buf + "    if (out_id < 0 || out_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    ae = &_hx_farr_table[a_id];\n"
    buf = buf + "    be = &_hx_farr_table[b_id];\n"
    buf = buf + "    HexaFarrEntry* oe = &_hx_farr_table[out_id];\n"
    buf = buf + "    if (!ae->buf || !be->buf || !oe->buf || oe->len < n) return -1;\n"
    buf = buf + "    const double* A = ae->buf;\n"
    buf = buf + "    const double* B = be->buf;\n"
    buf = buf + "    double*       O = oe->buf;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) O[i] = A[i] * B[i];\n"
    buf = buf + "    return out_id;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// silu(x) = x · σ(x), σ(x) = 1/(1+exp(-x)). Mirrors c3_sigmoid/c3_silu.\n"
    buf = buf + "static inline double _hx_sigmoid_d(double x) { return 1.0 / (1.0 + hxlcl_exp(-x)); }\n"
    buf = buf + "\n"
    buf = buf + "// _hx_farr_silu_cpu(x, n) -> new farr_id. y[i] = silu(x[i]). -1 err.\n"
    buf = buf + "static int64_t _hx_farr_silu_cpu(int64_t x_id, int64_t n) {\n"
    buf = buf + "    if (x_id < 0 || x_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (n <= 0)                              return -1;\n"
    buf = buf + "    HexaFarrEntry* xe = &_hx_farr_table[x_id];\n"
    buf = buf + "    if (!xe->buf || xe->len < n)             return -1;\n"
    buf = buf + "    HexaVal out_h = hexa_farr_zeros(hexa_int(n));\n"
    buf = buf + "    int64_t out_id = HX_INT(out_h);\n"
    buf = buf + "    if (out_id < 0 || out_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    xe = &_hx_farr_table[x_id];\n"
    buf = buf + "    HexaFarrEntry* oe = &_hx_farr_table[out_id];\n"
    buf = buf + "    if (!xe->buf || !oe->buf || oe->len < n) return -1;\n"
    buf = buf + "    const double* X = xe->buf;\n"
    buf = buf + "    double*       Y = oe->buf;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) Y[i] = X[i] * _hx_sigmoid_d(X[i]);\n"
    buf = buf + "    return out_id;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// _hx_farr_silu_grad_cpu(x, n) -> new farr_id.\n"
    buf = buf + "// silu'(x) = σ(x)·(1 + x·(1−σ(x))). Mirrors c3_silu_grad EXACTLY. -1 err.\n"
    buf = buf + "static int64_t _hx_farr_silu_grad_cpu(int64_t x_id, int64_t n) {\n"
    buf = buf + "    if (x_id < 0 || x_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (n <= 0)                              return -1;\n"
    buf = buf + "    HexaFarrEntry* xe = &_hx_farr_table[x_id];\n"
    buf = buf + "    if (!xe->buf || xe->len < n)             return -1;\n"
    buf = buf + "    HexaVal out_h = hexa_farr_zeros(hexa_int(n));\n"
    buf = buf + "    int64_t out_id = HX_INT(out_h);\n"
    buf = buf + "    if (out_id < 0 || out_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    xe = &_hx_farr_table[x_id];\n"
    buf = buf + "    HexaFarrEntry* oe = &_hx_farr_table[out_id];\n"
    buf = buf + "    if (!xe->buf || !oe->buf || oe->len < n) return -1;\n"
    buf = buf + "    const double* X = xe->buf;\n"
    buf = buf + "    double*       Y = oe->buf;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        double s = _hx_sigmoid_d(X[i]);\n"
    buf = buf + "        Y[i] = s * (1.0 + X[i] * (1.0 - s));\n"
    buf = buf + "    }\n"
    buf = buf + "    return out_id;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// _hx_farr_rmsnorm_bwd_rows_cpu(x, dxn, R, C) -> new farr_id [R·C].\n"
    buf = buf + "// The EXACT RMSNorm vjp dx-branch (per row), inv-rms recomputed from x\n"
    buf = buf + "// (eps=1e-6, matches c3_rmsnorm_fwd) so the kernel is self-contained\n"
    buf = buf + "// (caller supplies dxn = dy⊙g; the per-channel-gain split mirrors the\n"
    buf = buf + "// Phase B fwd rmsnorm_rows gain-free convention):\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "//   inv  = (mean_j(x²)+ε)^(−1/2)\n"
    buf = buf + "//   dot  = Σ_k dxn_k·x_k\n"
    buf = buf + "//   dx_i = inv·dxn_i − (inv³·x_i/C)·dot\n"
    buf = buf + "// Mirrors d_train3_lib c3_rmsnorm_bwd dx formula EXACTLY. -1 err.\n"
    buf = buf + "static int64_t _hx_farr_rmsnorm_bwd_rows_cpu(int64_t x_id, int64_t dxn_id,\n"
    buf = buf + "                                             int64_t R, int64_t C) {\n"
    buf = buf + "    if (x_id < 0   || x_id >= _hx_farr_count)   return -1;\n"
    buf = buf + "    if (dxn_id < 0 || dxn_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (R <= 0 || C <= 0)                       return -1;\n"
    buf = buf + "    HexaFarrEntry* xe = &_hx_farr_table[x_id];\n"
    buf = buf + "    HexaFarrEntry* de = &_hx_farr_table[dxn_id];\n"
    buf = buf + "    if (!xe->buf || !de->buf)                   return -1;\n"
    buf = buf + "    if (xe->len < R * C || de->len < R * C)     return -1;\n"
    buf = buf + "    HexaVal out_h = hexa_farr_zeros(hexa_int(R * C));\n"
    buf = buf + "    int64_t out_id = HX_INT(out_h);\n"
    buf = buf + "    if (out_id < 0 || out_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    xe = &_hx_farr_table[x_id];\n"
    buf = buf + "    de = &_hx_farr_table[dxn_id];\n"
    buf = buf + "    HexaFarrEntry* oe = &_hx_farr_table[out_id];\n"
    buf = buf + "    if (!xe->buf || !de->buf || !oe->buf || oe->len < R * C) return -1;\n"
    buf = buf + "    const double* X   = xe->buf;\n"
    buf = buf + "    const double* DXN = de->buf;\n"
    buf = buf + "    double*       O   = oe->buf;\n"
    buf = buf + "    double inv_C = 1.0 / (double)C;\n"
    buf = buf + "    for (int64_t r = 0; r < R; r++) {\n"
    buf = buf + "        const double* xr  = X   + r * C;\n"
    buf = buf + "        const double* dxr = DXN + r * C;\n"
    buf = buf + "        double*       orr = O   + r * C;\n"
    buf = buf + "        double ms = 0.0;\n"
    buf = buf + "        for (int64_t j = 0; j < C; j++) ms += xr[j] * xr[j];\n"
    buf = buf + "        ms *= inv_C;\n"
    buf = buf + "        double inv  = 1.0 / _hx_sqrt(ms + 1e-6);\n"
    buf = buf + "        double dot  = 0.0;\n"
    buf = buf + "        for (int64_t k = 0; k < C; k++) dot += dxr[k] * xr[k];\n"
    buf = buf + "        double coef = (inv * inv * inv) * inv_C;\n"
    buf = buf + "        for (int64_t i = 0; i < C; i++)\n"
    buf = buf + "            orr[i] = inv * dxr[i] - coef * xr[i] * dot;\n"
    buf = buf + "    }\n"
    buf = buf + "    return out_id;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// _hx_farr_rope_cpu(t_id, cos, sin, T, nheads, hd, is_bwd) -> new\n"
    buf = buf + "// farr_id [T·nheads·hd]. Rotary position embedding (RFC 041 Phase B\n"
    buf = buf + "// completion). Consumes PRECOMPUTED cos/sin tables [T·hd] — does NOT\n"
    buf = buf + "// recompute angles. Mirrors flame decoder_block_lib.hexa §3 (fwd) /\n"
    buf = buf + "// §3rev (bwd); CPU reference tool/flame_phase4d6_block_{fwd,bwd}_\n"
    buf = buf + "// primitive.c. Tensor T_buf row-major [T·nheads·hd], row for (t,hh)\n"
    buf = buf + "// at (t·nheads+hh)·hd; cos/sin [T·hd] indexed bse+c, bse=t·hd.\n"
    buf = buf + "//   fwd:  rh_c = (c<half)? -x[row+half+c] : x[row+c-half]\n"
    buf = buf + "//         out  = x[row+c]·cos[bse+c] + rh_c·sin[bse+c]\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "//   bwd:  gs   = (c<half)?  dx[row+half+c]·sin[bse+half+c]\n"
    buf = buf + "//                        : -dx[row+c-half]·sin[bse+c-half]\n"
    buf = buf + "//         out  = dx[row+c]·cos[bse+c] + gs\n"
    buf = buf + "// Pure per-element (out depends only on row elements c and c±half) —\n"
    buf = buf + "// the GPU kernel reads from a separate input buffer so it is byte-eq.\n"
    buf = buf + "// -1 err.\n"
    buf = buf + "//\n"
    buf = buf + "// FP_CONTRACT OFF: the byte-eq oracle (flame_ag_tape_test Test 9)\n"
    buf = buf + "// pins this against the verified hexa primitive nn_rope_apply_fwd,\n"
    buf = buf + "// which codegens through opaque farr_get() calls and is therefore\n"
    buf = buf + "// NOT FMA-contracted (2 roundings for a*b+c*d). Raw double[] here\n"
    buf = buf + "// lets clang contract a*b+c*d into one fma() (1 rounding) → a\n"
    buf = buf + "// ~1e-17 mismatch that fails the leaf-op max|Δ|=0 bar. Disabling\n"
    buf = buf + "// contraction for this kernel only makes the CPU fallback conform\n"
    buf = buf + "// to the reference's rounding, restoring exact byte-eq without\n"
    buf = buf + "// de-optimizing the rest of the runtime.\n"
    buf = buf + "#pragma STDC FP_CONTRACT OFF\n"
    buf = buf + "static int64_t _hx_farr_rope_cpu(int64_t t_id, int64_t cos_id,\n"
    buf = buf + "                                 int64_t sin_id, int64_t T,\n"
    buf = buf + "                                 int64_t nheads, int64_t hd,\n"
    buf = buf + "                                 int is_bwd) {\n"
    buf = buf + "    if (t_id < 0   || t_id >= _hx_farr_count)   return -1;\n"
    buf = buf + "    if (cos_id < 0 || cos_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (sin_id < 0 || sin_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (T <= 0 || nheads <= 0 || hd <= 0)       return -1;\n"
    buf = buf + "    if ((hd & 1) != 0)                          return -1;\n"
    buf = buf + "    int64_t total = T * nheads * hd;\n"
    buf = buf + "    HexaFarrEntry* te = &_hx_farr_table[t_id];\n"
    buf = buf + "    HexaFarrEntry* ce = &_hx_farr_table[cos_id];\n"
    buf = buf + "    HexaFarrEntry* se = &_hx_farr_table[sin_id];\n"
    buf = buf + "    if (!te->buf || !ce->buf || !se->buf)       return -1;\n"
    buf = buf + "    if (te->len < total)                        return -1;\n"
    buf = buf + "    if (ce->len < T * hd || se->len < T * hd)   return -1;\n"
    buf = buf + "    HexaVal out_h = hexa_farr_zeros(hexa_int(total));\n"
    buf = buf + "    int64_t out_id = HX_INT(out_h);\n"
    buf = buf + "    if (out_id < 0 || out_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    te = &_hx_farr_table[t_id];\n"
    buf = buf + "    ce = &_hx_farr_table[cos_id];\n"
    buf = buf + "    se = &_hx_farr_table[sin_id];\n"
    buf = buf + "    HexaFarrEntry* oe = &_hx_farr_table[out_id];\n"
    buf = buf + "    if (!te->buf || !ce->buf || !se->buf || !oe->buf) return -1;\n"
    buf = buf + "    if (oe->len < total)                        return -1;\n"
    buf = buf + "    const double* X   = te->buf;\n"
    buf = buf + "    const double* COS = ce->buf;\n"
    buf = buf + "    const double* SIN = se->buf;\n"
    buf = buf + "    double*       O   = oe->buf;\n"
    buf = buf + "    int64_t half = hd / 2;\n"
    buf = buf + "    for (int64_t t = 0; t < T; t++) {\n"
    buf = buf + "        int64_t bse = t * hd;\n"
    buf = buf + "        for (int64_t hh = 0; hh < nheads; hh++) {\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "            int64_t row = (t * nheads + hh) * hd;\n"
    buf = buf + "            for (int64_t c = 0; c < hd; c++) {\n"
    buf = buf + "                if (is_bwd) {\n"
    buf = buf + "                    double gs = (c < half)\n"
    buf = buf + "                        ? (X[row + half + c] * SIN[bse + half + c])\n"
    buf = buf + "                        : (0.0 - X[row + c - half] * SIN[bse + c - half]);\n"
    buf = buf + "                    O[row + c] = X[row + c] * COS[bse + c] + gs;\n"
    buf = buf + "                } else {\n"
    buf = buf + "                    double rh_c = (c < half)\n"
    buf = buf + "                        ? (0.0 - X[row + half + c])\n"
    buf = buf + "                        : X[row + c - half];\n"
    buf = buf + "                    O[row + c] = X[row + c] * COS[bse + c]\n"
    buf = buf + "                               + rh_c * SIN[bse + c];\n"
    buf = buf + "                }\n"
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return out_id;\n"
    buf = buf + "}\n"
    buf = buf + "#pragma STDC FP_CONTRACT DEFAULT\n"
    buf = buf + "\n"
    buf = buf + "// BC-ANIMA M3 (2026-05-28): 5-arg seed-only CE gradient — host FP64\n"
    buf = buf + "// reference + no-CUDA fallback for the new `farr_ce_seed` builtin.\n"
    buf = buf + "//   _hx_farr_ce_seed_cpu_v2(softmax_id, target_ids_id, dlogits_id, R, C)\n"
    buf = buf + "//                            -> int rc (0 ok / -1)\n"
    buf = buf + "// Writes dlogits[r,c] = softmax[r,c] - (c == target[r] ? 1.0 : 0.0) per\n"
    buf = buf + "// row. Caller-allocated dlogits (in place); targets are double-encoded\n"
    buf = buf + "// vocab ids (rounded to int64). This is the LIGHTER sibling of the\n"
    buf = buf + "// fused 6-arg _hx_farr_ce_seed_cpu — softmax is precomputed (anima\n"
    buf = buf + "// trainer's M2 farr_softmax_rows step), so no exp/log here.\n"
    buf = buf + "static int _hx_farr_ce_seed_cpu_v2(int64_t softmax_id, int64_t target_ids_id,\n"
    buf = buf + "                                   int64_t dlogits_id,\n"
    buf = buf + "                                   int64_t R, int64_t C) {\n"
    buf = buf + "    if (softmax_id < 0    || softmax_id    >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (target_ids_id < 0 || target_ids_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (dlogits_id < 0    || dlogits_id    >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (R <= 0 || C <= 0) return -1;\n"
    buf = buf + "    HexaFarrEntry* se = &_hx_farr_table[softmax_id];\n"
    buf = buf + "    HexaFarrEntry* te = &_hx_farr_table[target_ids_id];\n"
    buf = buf + "    HexaFarrEntry* de = &_hx_farr_table[dlogits_id];\n"
    buf = buf + "    if (!se->buf || !te->buf || !de->buf) return -1;\n"
    buf = buf + "    if (se->len < R * C || te->len < R || de->len < R * C) return -1;\n"
    buf = buf + "    const double* S   = se->buf;\n"
    buf = buf + "    const double* TGT = te->buf;\n"
    buf = buf + "    double*       DL  = de->buf;\n"
    buf = buf + "    for (int64_t r = 0; r < R; r++) {\n"
    buf = buf + "        const double* sr = S + r * C;\n"
    buf = buf + "        double*       dr = DL + r * C;\n"
    buf = buf + "        double tf = TGT[r];\n"
    buf = buf + "        int64_t tgt = (int64_t)(tf + (tf >= 0.0 ? 0.5 : -0.5));\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        for (int64_t c = 0; c < C; c++) {\n"
    buf = buf + "            double p = sr[c];\n"
    buf = buf + "            if (c == tgt) p -= 1.0;\n"
    buf = buf + "            dr[c] = p;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// _hx_farr_ce_seed_cpu(logits_id, target_ids_id, R, V, out_loss_id,\n"
    buf = buf + "//   out_dlogits_id) -> int rc (0 ok / -1). The host FP64 reference for\n"
    buf = buf + "//   the GPU CE/seed kernel (RFC gpu-resident-large-vocab-lmhead-loss)\n"
    buf = buf + "//   AND the no-CUDA fallback. Unlike the other farr CPU helpers this\n"
    buf = buf + "//   does NOT allocate — the two outputs are CALLER-allocated and filled\n"
    buf = buf + "//   in place: out_loss[r] = per-row CE = (max - L[target]) + log(Σexp),\n"
    buf = buf + "//   out_dlogits[r*V+v] = softmax(L[r,v]) - onehot(v==target[r]). Targets\n"
    buf = buf + "//   arrive double-encoded (token ids as doubles) — rounded to int64.\n"
    buf = buf + "//   libm exp/log (hxlcl_exp/hxlcl_log) match the GPU kernel's path.\n"
    buf = buf + "static int _hx_farr_ce_seed_cpu(int64_t logits_id, int64_t target_ids_id,\n"
    buf = buf + "                                int64_t R, int64_t V,\n"
    buf = buf + "                                int64_t out_loss_id, int64_t out_dlogits_id) {\n"
    buf = buf + "    if (logits_id < 0     || logits_id >= _hx_farr_count)     return -1;\n"
    buf = buf + "    if (target_ids_id < 0 || target_ids_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (out_loss_id < 0   || out_loss_id >= _hx_farr_count)   return -1;\n"
    buf = buf + "    if (out_dlogits_id < 0|| out_dlogits_id >= _hx_farr_count)return -1;\n"
    buf = buf + "    if (R <= 0 || V <= 0) return -1;\n"
    buf = buf + "    HexaFarrEntry* le = &_hx_farr_table[logits_id];\n"
    buf = buf + "    HexaFarrEntry* te = &_hx_farr_table[target_ids_id];\n"
    buf = buf + "    HexaFarrEntry* lo = &_hx_farr_table[out_loss_id];\n"
    buf = buf + "    HexaFarrEntry* dl = &_hx_farr_table[out_dlogits_id];\n"
    buf = buf + "    if (!le->buf || !te->buf || !lo->buf || !dl->buf) return -1;\n"
    buf = buf + "    if (le->len < R * V || te->len < R || lo->len < R || dl->len < R * V)\n"
    buf = buf + "        return -1;\n"
    buf = buf + "    const double* L   = le->buf;\n"
    buf = buf + "    const double* TGT = te->buf;\n"
    buf = buf + "    double* OUT_LOSS  = lo->buf;\n"
    buf = buf + "    double* OUT_DL    = dl->buf;\n"
    buf = buf + "    for (int64_t r = 0; r < R; r++) {\n"
    buf = buf + "        const double* lr = L + r * V;\n"
    buf = buf + "        double*       dr = OUT_DL + r * V;\n"
    buf = buf + "        double tf = TGT[r];\n"
    buf = buf + "        int64_t tgt = (int64_t)(tf + (tf >= 0.0 ? 0.5 : -0.5));\n"
    buf = buf + "        double m = lr[0];\n"
    buf = buf + "        for (int64_t j = 1; j < V; j++) if (lr[j] > m) m = lr[j];\n"
    buf = buf + "        double s = 0.0;\n"
    buf = buf + "        for (int64_t j = 0; j < V; j++) {\n"
    buf = buf + "            double e = hxlcl_exp(lr[j] - m);\n"
    buf = buf + "            dr[j] = e;\n"
    buf = buf + "            s += e;\n"
    buf = buf + "        }\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        double inv = (s > 0.0) ? (1.0 / s) : 0.0;\n"
    buf = buf + "        double lt  = (tgt >= 0 && tgt < V) ? lr[tgt] : 0.0;\n"
    buf = buf + "        OUT_LOSS[r] = (m + hxlcl_log(s)) - lt;\n"
    buf = buf + "        for (int64_t j = 0; j < V; j++) {\n"
    buf = buf + "            double p = dr[j] * inv;\n"
    buf = buf + "            if (j == tgt) p -= 1.0;\n"
    buf = buf + "            dr[j] = p;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// _hx_farr_adamw_step_cpu(...) -> new farr_id [n] = updated W. m,v\n"
    buf = buf + "// updated IN PLACE on their farr buffers (matches the AdamW state\n"
    buf = buf + "// contract — the optimizer owns m/v across steps). Decoupled weight\n"
    buf = buf + "// decay. Mirrors d_train2_lib dt2_adamw_step EXACTLY (same β^t via\n"
    buf = buf + "// repeated mul, same c1/c2 bias-correction, same update form). The\n"
    buf = buf + "// √ uses libm sqrt (the boxed dt_sqrt is a 24-iter Newton converging\n"
    buf = buf + "// to the same double — verified ≡ in the smoke). -1 err.\n"
    buf = buf + "static int64_t _hx_farr_adamw_step_cpu(int64_t w_id, int64_t m_id,\n"
    buf = buf + "                                       int64_t v_id, int64_t g_id,\n"
    buf = buf + "                                       int64_t n, double lr, double b1,\n"
    buf = buf + "                                       double b2, double eps, double wd,\n"
    buf = buf + "                                       int64_t step_t) {\n"
    buf = buf + "    if (w_id < 0 || w_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (m_id < 0 || m_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (v_id < 0 || v_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (g_id < 0 || g_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (n <= 0 || step_t < 1)               return -1;\n"
    buf = buf + "    HexaFarrEntry* we = &_hx_farr_table[w_id];\n"
    buf = buf + "    HexaFarrEntry* me = &_hx_farr_table[m_id];\n"
    buf = buf + "    HexaFarrEntry* ve = &_hx_farr_table[v_id];\n"
    buf = buf + "    HexaFarrEntry* ge = &_hx_farr_table[g_id];\n"
    buf = buf + "    if (!we->buf || !me->buf || !ve->buf || !ge->buf) return -1;\n"
    buf = buf + "    if (we->len < n || me->len < n || ve->len < n || ge->len < n) return -1;\n"
    buf = buf + "    HexaVal out_h = hexa_farr_zeros(hexa_int(n));\n"
    buf = buf + "    int64_t out_id = HX_INT(out_h);\n"
    buf = buf + "    if (out_id < 0 || out_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    /* re-fetch ALL entry pointers post-alloc (RFC 032 guard). */\n"
    buf = buf + "    we = &_hx_farr_table[w_id];\n"
    buf = buf + "    me = &_hx_farr_table[m_id];\n"
    buf = buf + "    ve = &_hx_farr_table[v_id];\n"
    buf = buf + "    ge = &_hx_farr_table[g_id];\n"
    buf = buf + "    HexaFarrEntry* oe = &_hx_farr_table[out_id];\n"
    buf = buf + "    if (!we->buf || !me->buf || !ve->buf || !ge->buf || !oe->buf\n"
    buf = buf + "        || oe->len < n) return -1;\n"
    buf = buf + "    double* W = we->buf;\n"
    buf = buf + "    double* Mm = me->buf;\n"
    buf = buf + "    double* Vv = ve->buf;\n"
    buf = buf + "    const double* G = ge->buf;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    double* O = oe->buf;\n"
    buf = buf + "    double b1t = 1.0, b2t = 1.0;\n"
    buf = buf + "    for (int64_t e = 0; e < step_t; e++) { b1t *= b1; b2t *= b2; }\n"
    buf = buf + "    double c1 = 1.0 - b1t;\n"
    buf = buf + "    double c2 = 1.0 - b2t;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        double g  = G[i];\n"
    buf = buf + "        double mi = b1 * Mm[i] + (1.0 - b1) * g;\n"
    buf = buf + "        double vi = b2 * Vv[i] + (1.0 - b2) * g * g;\n"
    buf = buf + "        double mhat = mi / c1;\n"
    buf = buf + "        double vhat = vi / c2;\n"
    buf = buf + "        double denom = _hx_sqrt(vhat) + eps;\n"
    buf = buf + "        double wi = W[i] - lr * wd * W[i] - lr * mhat / denom;\n"
    buf = buf + "        Mm[i] = mi;       /* m,v updated in place (optimizer state) */\n"
    buf = buf + "        Vv[i] = vi;\n"
    buf = buf + "        O[i]  = wi;       /* fresh W returned as a new farr */\n"
    buf = buf + "    }\n"
    buf = buf + "    return out_id;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// _hx_farr_adamw_step_inplace_cpu(...) -> w_id = updated W, written IN\n"
    buf = buf + "// PLACE on W's own farr buffer (ZERO `out` allocation). Byte-identical\n"
    buf = buf + "// arithmetic to _hx_farr_adamw_step_cpu — same β^t repeated-mul, same\n"
    buf = buf + "// c1/c2 bias-correction, same decoupled-wd update form, same libm sqrt.\n"
    buf = buf + "// The ONLY difference vs the allocating variant is the destination of\n"
    buf = buf + "// the write: O[i] (a fresh farr) → W[i] (in place). m,v stay in place\n"
    buf = buf + "// (optimizer-state contract, unchanged). This kills the per-step n=m_size\n"
    buf = buf + "// FP64 `out` farr alloc (V·d·E doubles/step → glibc-arena RSS leak under\n"
    buf = buf + "// long training). Returns w_id (the in-place-updated W). -1 on err.\n"
    buf = buf + "static int64_t _hx_farr_adamw_step_inplace_cpu(int64_t w_id, int64_t m_id,\n"
    buf = buf + "                                               int64_t v_id, int64_t g_id,\n"
    buf = buf + "                                               int64_t n, double lr,\n"
    buf = buf + "                                               double b1, double b2,\n"
    buf = buf + "                                               double eps, double wd,\n"
    buf = buf + "                                               int64_t step_t) {\n"
    buf = buf + "    if (w_id < 0 || w_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (m_id < 0 || m_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (v_id < 0 || v_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (g_id < 0 || g_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (n <= 0 || step_t < 1)               return -1;\n"
    buf = buf + "    HexaFarrEntry* we = &_hx_farr_table[w_id];\n"
    buf = buf + "    HexaFarrEntry* me = &_hx_farr_table[m_id];\n"
    buf = buf + "    HexaFarrEntry* ve = &_hx_farr_table[v_id];\n"
    buf = buf + "    HexaFarrEntry* ge = &_hx_farr_table[g_id];\n"
    buf = buf + "    if (!we->buf || !me->buf || !ve->buf || !ge->buf) return -1;\n"
    buf = buf + "    if (we->len < n || me->len < n || ve->len < n || ge->len < n) return -1;\n"
    buf = buf + "    double* W = we->buf;\n"
    buf = buf + "    double* Mm = me->buf;\n"
    buf = buf + "    double* Vv = ve->buf;\n"
    buf = buf + "    const double* G = ge->buf;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    double b1t = 1.0, b2t = 1.0;\n"
    buf = buf + "    for (int64_t e = 0; e < step_t; e++) { b1t *= b1; b2t *= b2; }\n"
    buf = buf + "    double c1 = 1.0 - b1t;\n"
    buf = buf + "    double c2 = 1.0 - b2t;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        double g  = G[i];\n"
    buf = buf + "        double mi = b1 * Mm[i] + (1.0 - b1) * g;\n"
    buf = buf + "        double vi = b2 * Vv[i] + (1.0 - b2) * g * g;\n"
    buf = buf + "        double mhat = mi / c1;\n"
    buf = buf + "        double vhat = vi / c2;\n"
    buf = buf + "        double denom = _hx_sqrt(vhat) + eps;\n"
    buf = buf + "        double wi = W[i] - lr * wd * W[i] - lr * mhat / denom;\n"
    buf = buf + "        Mm[i] = mi;       /* m,v updated in place (optimizer state) */\n"
    buf = buf + "        Vv[i] = vi;\n"
    buf = buf + "        W[i]  = wi;       /* W updated IN PLACE — no `out` farr alloc */\n"
    buf = buf + "    }\n"
    buf = buf + "    return w_id;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ── Phase B2 dispatchers ────────────────────────────────────────────\n"
    buf = buf + "\n"
    buf = buf + "// farr_matmul_t_gpu(M, R, C, u) -> int new farr_id [C] (Mᵀ·u).\n"
    buf = buf + "// On HEXA_CUDA: wired (Phase 4-D-5-4 step 1, 2026-05-17) to\n"
    buf = buf + "// _hx_cuda_farr_matmul_t_gpu (cuBLAS Dgemv CUBLAS_OP_T or tiled\n"
    buf = buf + "// transpose-GEMM, byte-eq Phase 4-D-5-3).\n"
    buf = buf + "HexaVal hexa_farr_matmul_t_gpu(HexaVal m_v, HexaVal r_v, HexaVal c_v,\n"
    buf = buf + "                               HexaVal u_v) {\n"
    buf = buf + "    int64_t m_id = hexa_as_num(m_v);\n"
    buf = buf + "    int64_t R    = hexa_as_num(r_v);\n"
    buf = buf + "    int64_t C    = hexa_as_num(c_v);\n"
    buf = buf + "    int64_t u_id = hexa_as_num(u_v);\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "    if (R <= 0 || C <= 0) return hexa_int(-1);\n"
    buf = buf + "    if (m_id < 0 || m_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (u_id < 0 || u_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    HexaVal out_h = hexa_farr_zeros(hexa_int(C));\n"
    buf = buf + "    int64_t out_id = hexa_as_num(out_h);\n"
    buf = buf + "    if (out_id < 0) return hexa_int(-1);\n"
    buf = buf + "    int rc = _hx_cuda_farr_matmul_t_gpu(m_id, R, C, u_id, out_id);\n"
    buf = buf + "    if (rc != 0) return hexa_int(-1);\n"
    buf = buf + "    return hexa_int(out_id);\n"
    buf = buf + "#else\n"
    buf = buf + "    return hexa_int(_hx_farr_matmul_t_cpu(m_id, R, C, u_id));\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// farr_packed_gemv_offset(P, off, rows, cols, u) -> int new farr_id\n"
    buf = buf + "// [rows]. out[i] = Σ_j P[off + i·cols + j]·U[j] — offset-aware gemv on a\n"
    buf = buf + "// packed-double sub-block (anima mm_packed_gemv 1:1 semantics). 5-arg →\n"
    buf = buf + "// past the hexa_callN ceiling → bare direct-C entry + codegen 5-arg map\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// (RFC 032 farr_matmul pattern). On HEXA_CUDA the dim-gate (rows·cols >\n"
    buf = buf + "// 8192) routes to the cuBLAS Dgemv path (CUBLAS_OP_T, base+offset\n"
    buf = buf + "// pointer, lda=cols); small blocks stay on the CPU helper to dodge the\n"
    buf = buf + "// H2D/D2H round-trip overhead.\n"
    buf = buf + "HexaVal hexa_farr_packed_gemv_offset(HexaVal p_v, HexaVal off_v,\n"
    buf = buf + "                                     HexaVal rows_v, HexaVal cols_v,\n"
    buf = buf + "                                     HexaVal u_v) {\n"
    buf = buf + "    int64_t p_id  = hexa_as_num(p_v);\n"
    buf = buf + "    int64_t off   = hexa_as_num(off_v);\n"
    buf = buf + "    int64_t rows  = hexa_as_num(rows_v);\n"
    buf = buf + "    int64_t cols  = hexa_as_num(cols_v);\n"
    buf = buf + "    int64_t u_id  = hexa_as_num(u_v);\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "    if (rows > 0 && cols > 0 && rows * cols > 8192) {\n"
    buf = buf + "        if (off < 0) return hexa_int(-1);\n"
    buf = buf + "        if (p_id < 0 || p_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "        if (u_id < 0 || u_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "        HexaVal out_h = hexa_farr_zeros(hexa_int(rows));\n"
    buf = buf + "        int64_t out_id = hexa_as_num(out_h);\n"
    buf = buf + "        if (out_id < 0) return hexa_int(-1);\n"
    buf = buf + "        int rc = _hx_cuda_farr_packed_gemv_offset_gpu(p_id, off, rows, cols,\n"
    buf = buf + "                                                      u_id, out_id);\n"
    buf = buf + "        if (rc != 0) return hexa_int(-1);\n"
    buf = buf + "        return hexa_int(out_id);\n"
    buf = buf + "    }\n"
    buf = buf + "    /* small block → CPU (avoid H2D/D2H overhead). */\n"
    buf = buf + "    return hexa_int(_hx_farr_packed_gemv_offset_cpu(p_id, off, rows, cols, u_id));\n"
    buf = buf + "#else\n"
    buf = buf + "    return hexa_int(_hx_farr_packed_gemv_offset_cpu(p_id, off, rows, cols, u_id));\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Bare direct-C entry (5-arg, past hexa_callN ceiling — codegen maps the\n"
    buf = buf + "// 5-arg name to this hexa_ wrapper, RFC 032 farr_matmul pattern).\n"
    buf = buf + "HexaVal farr_packed_gemv_offset(HexaVal p, HexaVal off, HexaVal rows,\n"
    buf = buf + "                                HexaVal cols, HexaVal u) {\n"
    buf = buf + "    return hexa_farr_packed_gemv_offset(p, off, rows, cols, u);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// farr_outer_gpu(u, v, R, C) -> int new farr_id [R·C] (u⊗v).\n"
    buf = buf + "// On HEXA_CUDA: wired (Phase 4-D-5-4 step 1, 2026-05-17) to\n"
    buf = buf + "// _hx_cuda_farr_outer_gpu (cublasDger rank-1 or 2-D grid, byte-eq\n"
    buf = buf + "// Phase 4-D-5-3).\n"
    buf = buf + "HexaVal hexa_farr_outer_gpu(HexaVal u_v, HexaVal v_v, HexaVal r_v,\n"
    buf = buf + "                            HexaVal c_v) {\n"
    buf = buf + "    int64_t u_id = hexa_as_num(u_v);\n"
    buf = buf + "    int64_t v_id = hexa_as_num(v_v);\n"
    buf = buf + "    int64_t R    = hexa_as_num(r_v);\n"
    buf = buf + "    int64_t C    = hexa_as_num(c_v);\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    if (R <= 0 || C <= 0) return hexa_int(-1);\n"
    buf = buf + "    if (u_id < 0 || u_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (v_id < 0 || v_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    HexaVal out_h = hexa_farr_zeros(hexa_int(R * C));\n"
