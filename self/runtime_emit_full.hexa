    buf = buf + "    return hexa_int(x | y);\n"
    buf = buf + "}\n"
    buf = buf + "/* De-staticized 2026-05-17 (wilson P0#2): interp transpile takes\n"
    buf = buf + " * `&bit_or` for `hexa_call2(bit_or, x, y)` across the runtime.o TU\n"
    buf = buf + " * boundary. File-scope `static` was invisible to user.c TU. */\n"
    buf = buf + "HexaVal bit_or;\n"
    buf = buf + "\n"
    buf = buf + "// ── Added: method-dispatch helpers (bt 34) ────────────────────\n"
    buf = buf + "// Step-4 cycle 92 port — strtoll replacement in hexa source.\n"
    buf = buf + "#ifdef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "extern HexaVal rt_str_parse_int(HexaVal s);\n"
    buf = buf + "HexaVal hexa_str_parse_int(HexaVal s) {\n"
    buf = buf + "    if (!HX_IS_STR(s)) return hexa_int(0);\n"
    buf = buf + "    return rt_str_parse_int(s);\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "HexaVal hexa_str_parse_int(HexaVal s) {\n"
    buf = buf + "    if (!HX_IS_STR(s)) return hexa_int(0);\n"
    buf = buf + "    const char* cs = HX_STR(s);\n"
    buf = buf + "    // hxa-20260423-013: throw on non-integer input so `try/catch` around\n"
    buf = buf + "    // to_int(\"abc\") (T24) and uncaught to_int(\"1.01\") (T34) behave as\n"
    buf = buf + "    // the language documents. Empty / whitespace-only input still\n"
    buf = buf + "    // returns 0 — 812 callsites (env-var + optional-argv parsing)\n"
    buf = buf + "    // depend on that defensive-fallback shape.\n"
    buf = buf + "    const char* p = cs;\n"
    buf = buf + "    while (*p == ' ' || *p == '\\t' || *p == '\\n' || *p == '\\r') p++;\n"
    buf = buf + "    if (*p == 0) return hexa_int(0);\n"
    buf = buf + "    // P39 fix: auto-detect hex prefix (0x/0X) while preserving decimal\n"
    buf = buf + "    // semantics for leading-zero inputs (\"0777\" -> 777, not octal 511).\n"
    buf = buf + "    const char* digit_start = p;\n"
    buf = buf + "    if (*digit_start == '+' || *digit_start == '-') digit_start++;\n"
    buf = buf + "    int base = 10;\n"
    buf = buf + "    if (digit_start[0] == '0' && (digit_start[1] == 'x' || digit_start[1] == 'X')) base = 16;\n"
    buf = buf + "    char* endptr = NULL;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    long long v = hxlcl_strtoll(p, &endptr, base);\n"
    buf = buf + "    if (endptr == p) {\n"
    buf = buf + "        // no digits consumed — \"abc\", \"--\", \"\" after trim handled above\n"
    buf = buf + "        char msg[256];\n"
    buf = buf + "        snprintf(msg, sizeof(msg), \"error: to_int: not an integer: \\\"%s\\\"\", cs);\n"
    buf = buf + "        hexa_throw(hexa_str(msg));\n"
    buf = buf + "        return hexa_int(0);\n"
    buf = buf + "    }\n"
    buf = buf + "    // Reject trailing non-whitespace garbage (\"1.01\", \"123abc\", \"5 six\").\n"
    buf = buf + "    while (*endptr == ' ' || *endptr == '\\t' || *endptr == '\\n' || *endptr == '\\r') endptr++;\n"
    buf = buf + "    if (*endptr != 0) {\n"
    buf = buf + "        char msg[256];\n"
    buf = buf + "        snprintf(msg, sizeof(msg), \"error: to_int: trailing garbage in \\\"%s\\\"\", cs);\n"
    buf = buf + "        hexa_throw(hexa_str(msg));\n"
    buf = buf + "        return hexa_int(0);\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int((int64_t)v);\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// Step-3 cycle 73 port — strtod replacement. Hexa source parses\n"
    buf = buf + "// whitespace + sign + integer + optional fractional + optional\n"
    buf = buf + "// exponent. Edge cases (subnormals/INF/NaN/hex floats) fall short of\n"
    buf = buf + "// libm strtod — acceptable for typical user-input parse.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_str_parse_float(HexaVal s) {\n"
    buf = buf + "    if (!HX_IS_STR(s)) return hexa_float(0.0);\n"
    buf = buf + "    return hexa_float(strtod(HX_STR(s), NULL));\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_str_parse_float(HexaVal s);\n"
    buf = buf + "HexaVal hexa_str_parse_float(HexaVal s) {\n"
    buf = buf + "    if (!HX_IS_STR(s)) return hexa_float(0.0);\n"
    buf = buf + "    return rt_str_parse_float(s);\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// M1 full · str_ext Step 5 (hxa-20260423-003): rt_str_trim_start/end —\n"
    buf = buf + "// codegen emits rt_str_* directly; hexa_str_trim_start/end shims retired.\n"
    buf = buf + "// Step-3 cycle 48 — rt_str_trim_start moves to hexa source under\n"
    buf = buf + "// HEXA_HAS_HEXA_RT_STDLIB. The C body stays for the no-stdlib path.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal rt_str_trim_start(HexaVal s) {\n"
    buf = buf + "    if (!HX_IS_STR(s)) return s;\n"
    buf = buf + "    char* p = HX_STR(s);\n"
    buf = buf + "    while (*p == ' ' || *p == '\\t' || *p == '\\n' || *p == '\\r') p++;\n"
    buf = buf + "    return hexa_str_own(hxlcl_strdup(p));\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// Step-3 cycle 49 — rt_str_trim_end moves to hexa source. C body stays\n"
    buf = buf + "// for the no-stdlib path.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal rt_str_trim_end(HexaVal s) {\n"
    buf = buf + "    if (!HX_IS_STR(s)) return s;\n"
    buf = buf + "    int len = (int)HX_STRLEN(s);\n"
    buf = buf + "    while (len > 0 && (HX_STR(s)[len-1] == ' ' || HX_STR(s)[len-1] == '\\t' || HX_STR(s)[len-1] == '\\n' || HX_STR(s)[len-1] == '\\r')) len--;\n"
    buf = buf + "    return hexa_str_own_with_len(hxlcl_strndup(HX_STR(s), len), (size_t)len);\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// Byte-based slice: [start, end) clamped to length\n"
    buf = buf + "// Step-3 cycle 46 port — byte slice dispatches to rt_str_slice\n"
    buf = buf + "// (ctype.hexa). Hexa side uses byte_len + substring builtin so the\n"
    buf = buf + "// allocation path is the perf-31 hexa_strbuf_alloc + memcpy single-\n"
    buf = buf + "// shot (vs strndup + hexa_str_own_with_len which double-allocates).\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_str_slice(HexaVal s, HexaVal start, HexaVal end) {\n"
    buf = buf + "    if (!HX_IS_STR(s)) return hexa_str(\"\");\n"
    buf = buf + "    int len = (int)HX_STRLEN(s);\n"
    buf = buf + "    int a = (int)HX_INT(start), b = (int)HX_INT(end);\n"
    buf = buf + "    if (a < 0) a = 0;\n"
    buf = buf + "    if (b > len) b = len;\n"
    buf = buf + "    if (a > b) a = b;\n"
    buf = buf + "    return hexa_str_own_with_len(hxlcl_strndup(HX_STR(s) + a, b - a), (size_t)(b - a));\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_str_slice(HexaVal s, HexaVal start, HexaVal end);\n"
    buf = buf + "HexaVal hexa_str_slice(HexaVal s, HexaVal start, HexaVal end) {\n"
    buf = buf + "    if (!HX_IS_STR(s)) return hexa_str(\"\");\n"
    buf = buf + "    return rt_str_slice(s, start, end);\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// Step-3 cycle 35 port — float fast-path for the array branch. The str\n"
    buf = buf + "// branch is polymorphic (byte-indexed substring) and stays in C; the\n"
    buf = buf + "// array branch dispatches to rt_array_slice_float when the array is\n"
    buf = buf + "// all-float. Mixed-type arrays stay on the C body.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_array_slice(HexaVal arr, HexaVal start, HexaVal end) {\n"
    buf = buf + "    // 2026-05-19 parity-gate t45b — polymorphic slice + 1-arg form.\n"
    buf = buf + "    // (1) HX_IS_VOID(end) ⇒ 1-arg `.slice(start)` form — default end to\n"
    buf = buf + "    // len(obj). (2) HX_IS_STR(obj) ⇒ string slice via byte-indexed\n"
    buf = buf + "    // substring (mirrors interp's `.slice` on strings). Array path\n"
    buf = buf + "    // unchanged for the common case.\n"
    buf = buf + "    if (HX_IS_STR(arr)) {\n"
    buf = buf + "        int n = (int)HX_STRLEN(arr);\n"
    buf = buf + "        int a = (int)HX_INT(start);\n"
    buf = buf + "        int b = HX_IS_VOID(end) ? n : (int)HX_INT(end);\n"
    buf = buf + "        if (a < 0) a += n;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        if (b < 0) b += n;\n"
    buf = buf + "        if (a < 0) a = 0;\n"
    buf = buf + "        if (b > n) b = n;\n"
    buf = buf + "        if (a > b) return hexa_str(\"\");\n"
    buf = buf + "        int len = b - a;\n"
    buf = buf + "        char* buf = (char*)malloc(len + 1);\n"
    buf = buf + "        if (!buf) return hexa_str(\"\");\n"
    buf = buf + "        int j = 0;\n"
    buf = buf + "        while (j < len) { buf[j] = HX_STR(arr)[a + j]; j++; }\n"
    buf = buf + "        buf[len] = 0;\n"
    buf = buf + "        return hexa_str_own(buf);\n"
    buf = buf + "    }\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_array_new();\n"
    buf = buf + "    int n = HX_ARR_LEN(arr);\n"
    buf = buf + "    int a = (int)HX_INT(start);\n"
    buf = buf + "    int b = HX_IS_VOID(end) ? n : (int)HX_INT(end);\n"
    buf = buf + "    // PROBE r14-D — Python-canonical negative wrap before clamp.\n"
    buf = buf + "    // arr[-2..] ≡ arr[len-2..]; arr[..-1] ≡ arr[..len-1]. After wrap, still\n"
    buf = buf + "    // out-of-range bounds clamp to [0, n] (Python slice semantics, distinct\n"
    buf = buf + "    // from indexing which throws).\n"
    buf = buf + "    if (a < 0) a += n;\n"
    buf = buf + "    if (b < 0) b += n;\n"
    buf = buf + "    if (a < 0) a = 0;\n"
    buf = buf + "    if (b > n) b = n;\n"
    buf = buf + "    if (a > b) a = b;\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    for (int i = a; i < b; i++) out = hexa_array_push(out, HX_ARR_ITEMS(arr)[i]);\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "static int _arr_all_float(HexaVal arr);  /* forward decl — defined later */\n"
    buf = buf + "extern HexaVal rt_array_slice_float(HexaVal arr, HexaVal start, HexaVal end);\n"
    buf = buf + "HexaVal hexa_array_slice(HexaVal arr, HexaVal start, HexaVal end) {\n"
    buf = buf + "    if (HX_IS_STR(arr)) {\n"
    buf = buf + "        int n = (int)HX_STRLEN(arr);\n"
    buf = buf + "        int a = (int)HX_INT(start);\n"
    buf = buf + "        int b = HX_IS_VOID(end) ? n : (int)HX_INT(end);\n"
    buf = buf + "        if (a < 0) a += n;\n"
    buf = buf + "        if (b < 0) b += n;\n"
    buf = buf + "        if (a < 0) a = 0;\n"
    buf = buf + "        if (b > n) b = n;\n"
    buf = buf + "        if (a > b) return hexa_str(\"\");\n"
    buf = buf + "        int len = b - a;\n"
    buf = buf + "        char* buf = (char*)malloc(len + 1);\n"
    buf = buf + "        if (!buf) return hexa_str(\"\");\n"
    buf = buf + "        int j = 0;\n"
    buf = buf + "        while (j < len) { buf[j] = HX_STR(arr)[a + j]; j++; }\n"
    buf = buf + "        buf[len] = 0;\n"
    buf = buf + "        return hexa_str_own(buf);\n"
    buf = buf + "    }\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_array_new();\n"
    buf = buf + "    int n = HX_ARR_LEN(arr);\n"
    buf = buf + "    int64_t a = HX_INT(start);\n"
    buf = buf + "    int64_t b = HX_IS_VOID(end) ? n : HX_INT(end);\n"
    buf = buf + "    // PROBE r14-D — Python-canonical negative wrap before clamp (mirrors the\n"
    buf = buf + "    // string path above and the #ifndef HEXA_HAS_HEXA_RT_STDLIB sibling).\n"
    buf = buf + "    // Wrap here so rt_array_slice_float receives already-normalized bounds.\n"
    buf = buf + "    if (a < 0) a += n;\n"
    buf = buf + "    if (b < 0) b += n;\n"
    buf = buf + "    if (_arr_all_float(arr)) {\n"
    buf = buf + "        return rt_array_slice_float(arr, hexa_int(a), hexa_int(b));\n"
    buf = buf + "    }\n"
    buf = buf + "    if (a < 0) a = 0;\n"
    buf = buf + "    if (b > n) b = n;\n"
    buf = buf + "    if (a > b) a = b;\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    for (int64_t i = a; i < b; i++) out = hexa_array_push(out, HX_ARR_ITEMS(arr)[i]);\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// Step-3 cycle 36 port — int range. The `int inclusive` switch is\n"
    buf = buf + "// plain C (not HexaVal), so two hexa entry points handle the cases\n"
    buf = buf + "// rather than threading a hexa-bool through the ABI.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal __hexa_range_array(HexaVal start, HexaVal end, int inclusive) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    int64_t s = HX_INT(start), e = HX_INT(end);\n"
    buf = buf + "    if (inclusive) {\n"
    buf = buf + "        for (int64_t i = s; i <= e; i++) out = hexa_array_push(out, hexa_int(i));\n"
    buf = buf + "    } else {\n"
    buf = buf + "        for (int64_t i = s; i < e; i++) out = hexa_array_push(out, hexa_int(i));\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_range_int_excl(HexaVal start, HexaVal end);\n"
    buf = buf + "extern HexaVal rt_range_int_incl(HexaVal start, HexaVal end);\n"
    buf = buf + "HexaVal __hexa_range_array(HexaVal start, HexaVal end, int inclusive) {\n"
    buf = buf + "    if (inclusive) return rt_range_int_incl(start, end);\n"
    buf = buf + "    return rt_range_int_excl(start, end);\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// Step-3 cycle 63 port — callback dispatch POC. Unlocks the callback\n"
    buf = buf + "// family by leveraging HexaVal-typed hexa-source params (codegen lowers\n"
    buf = buf + "// `fn(item)` to hexa_call1 when fn is HexaVal — verified on ubu-2).\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_array_map(HexaVal arr, HexaVal fn) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_array_new();\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    for (int i = 0; i < HX_ARR_LEN(arr); i++) {\n"
    buf = buf + "        out = hexa_array_push(out, hexa_call1(fn, HX_ARR_ITEMS(arr)[i]));\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_array_map(HexaVal arr, HexaVal fn_v);\n"
    buf = buf + "HexaVal hexa_array_map(HexaVal arr, HexaVal fn) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_array_new();\n"
    buf = buf + "    return rt_array_map(arr, fn);\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// Step-3 cycle 64 port — filter + fold callback dispatch.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_array_filter(HexaVal arr, HexaVal fn) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_array_new();\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    for (int i = 0; i < HX_ARR_LEN(arr); i++) {\n"
    buf = buf + "        HexaVal keep = hexa_call1(fn, HX_ARR_ITEMS(arr)[i]);\n"
    buf = buf + "        if (hexa_truthy(keep)) out = hexa_array_push(out, HX_ARR_ITEMS(arr)[i]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_array_fold(HexaVal arr, HexaVal init, HexaVal fn) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return init;\n"
    buf = buf + "    HexaVal acc = init;\n"
    buf = buf + "    for (int i = 0; i < HX_ARR_LEN(arr); i++) {\n"
    buf = buf + "        acc = hexa_call2(fn, acc, HX_ARR_ITEMS(arr)[i]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return acc;\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_array_filter(HexaVal arr, HexaVal fn_v);\n"
    buf = buf + "extern HexaVal rt_array_fold(HexaVal arr, HexaVal init, HexaVal fn_v);\n"
    buf = buf + "HexaVal hexa_array_filter(HexaVal arr, HexaVal fn) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_array_new();\n"
    buf = buf + "    return rt_array_filter(arr, fn);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_array_fold(HexaVal arr, HexaVal init, HexaVal fn) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return init;\n"
    buf = buf + "    return rt_array_fold(arr, init, fn);\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// Step-3 cycle 33 port — float fast-path dispatches to rt_array_index_of_float\n"
    buf = buf + "// when both the array is all-float and the item is float; otherwise the\n"
    buf = buf + "// polymorphic hexa_eq path stays.\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_array_index_of(HexaVal arr, HexaVal item) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_int(-1);\n"
    buf = buf + "    for (int i = 0; i < HX_ARR_LEN(arr); i++) {\n"
    buf = buf + "        if (hexa_truthy(hexa_eq(HX_ARR_ITEMS(arr)[i], item))) return hexa_int(i);\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int(-1);\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "static int _arr_all_float(HexaVal arr);  /* forward decl — defined below */\n"
    buf = buf + "extern HexaVal rt_array_index_of_float(HexaVal arr, HexaVal item);\n"
    buf = buf + "HexaVal hexa_array_index_of(HexaVal arr, HexaVal item) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_int(-1);\n"
    buf = buf + "    if (HX_IS_FLOAT(item) && _arr_all_float(arr)) {\n"
    buf = buf + "        return rt_array_index_of_float(arr, item);\n"
    buf = buf + "    }\n"
    buf = buf + "    for (int i = 0; i < HX_ARR_LEN(arr); i++) {\n"
    buf = buf + "        if (hexa_truthy(hexa_eq(HX_ARR_ITEMS(arr)[i], item))) return hexa_int(i);\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int(-1);\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// Higher-order array predicates + scans. Mirror interpreter semantics\n"
    buf = buf + "// at self/hexa_full.hexa:15189+ using hexa_call1 for callback dispatch\n"
    buf = buf + "// (same pattern as hexa_array_map/filter/fold).\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_map_any(HexaVal m, HexaVal pred);\n"
    buf = buf + "HexaVal hexa_map_all(HexaVal m, HexaVal pred);\n"
    buf = buf + "\n"
    buf = buf + "// Step-3 cycle 65 port — any/all/count callback predicates. Map-\n"
    buf = buf + "// receiver branch stays C-side (delegates to hexa_map_any/all/count);\n"
    buf = buf + "// the array branch dispatches to rt_array_*_pred in numeric.hexa.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_array_any(HexaVal arr, HexaVal fn) {\n"
