    buf = buf + "// `0..5` / `1..=10` / `0..10 step 2` — evaluates a Range at expression\n"
    buf = buf + "// position to an int array. 이전엔 ForStmt 경로에만 Range codegen 이 있어\n"
    buf = buf + "// `let r = 0..5` 같은 일반 expr 사용 시 \"CODEGEN ERROR: unhandled expr\n"
