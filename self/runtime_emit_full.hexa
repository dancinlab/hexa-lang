    buf = buf + "#endif\n"
    buf = buf + "// RUNTIME net/exec ① (cycle 77): hexa-native inet_pton — drops the libc\n"
    buf = buf + "// _inet_pton extern. AF_INET only (the sole call site, net.c, passes\n"
    buf = buf + "// AF_INET); AF_INET6 returns -1 (= unsupported af) per the libc contract.\n"
    buf = buf + "// Returns 1 = parsed, 0 = malformed, -1 = unsupported af.\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_inet_pton(int af, const char *src, void *dst) {\n"
    buf = buf + "    if (af != AF_INET) return -1;\n"
    buf = buf + "    unsigned char b[4];\n"
    buf = buf + "    int oct = 0, val = -1;\n"
    buf = buf + "    const char *p = src;\n"
    buf = buf + "    for (;;) {\n"
    buf = buf + "        char c = *p++;\n"
    buf = buf + "        if (c >= '0' && c <= '9') {\n"
    buf = buf + "            val = (val < 0 ? 0 : val) * 10 + (c - '0');\n"
    buf = buf + "            if (val > 255) return 0;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        } else if (c == '.' || c == '\\0') {\n"
    buf = buf + "            if (val < 0 || oct >= 4) return 0;\n"
    buf = buf + "            b[oct++] = (unsigned char)val;\n"
    buf = buf + "            val = -1;\n"
    buf = buf + "            if (c == '\\0') break;\n"
    buf = buf + "        } else {\n"
    buf = buf + "            return 0;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    if (oct != 4) return 0;\n"
    buf = buf + "    unsigned char *d = (unsigned char *)dst;\n"
    buf = buf + "    d[0] = b[0]; d[1] = b[1]; d[2] = b[2]; d[3] = b[3];\n"
    buf = buf + "    return 1;\n"
    buf = buf + "}\n"
    buf = buf + "// cycle 66 — restore real exec/popen bodies. Cycle 61 dropped these as\n"
    buf = buf + "// noop stubs with rationale \"aprime_cc never spawns children\". But the\n"
    buf = buf + "// runtime that backs `hexa run` and stdlib's exec() / exec_capture() /\n"
    buf = buf + "// gate_record DOES spawn children — and the stubs silently broke every\n"
    buf = buf + "// subprocess-dependent stdlib (yosys/ABC, anima trainers, pool CLI).\n"
    buf = buf + "// posix_spawnp + posix_spawn_file_actions_* are already linked in via\n"
    buf = buf + "// runtime_core.c's hexa_spawn_no_shell, so the libc symbols for\n"
    buf = buf + "// execve/execvp/execl/popen/pclose are also reachable — just pass\n"
    buf = buf + "// through. Resolves inbox/patches/yosys-exec-runtime-regression-cycles-\n"
    buf = buf + "// 61-64.md (Part 1, exec path).\n"
    buf = buf + "extern int execve(const char *path, char *const argv[], char *const envp[]);\n"
    buf = buf + "extern int execvp(const char *file, char *const argv[]);\n"
    buf = buf + "// RUNTIME net/exec ⑤ (cycle 79): svc-trap execve (59). On success it never\n"
    buf = buf + "// returns; on failure carry-flag -> -1 + errno via _cf.\n"
    buf = buf + "// F3 ACTIVATION · Path A — execve class-C svc-wrapper self-emit slot.\n"
    buf = buf + "// 3-arg via syscall3_cf, all 3 args POINTERS (path/argv/envp) → NO sxtw\n"
    buf = buf + "// prologue, just mov w16,#59 + svc + _cf tail. 8 instr / 32 B, errno reloc\n"
    buf = buf + "// 0x10/0x14. SELF-EMIT → extern, resolved by emit_hxlcl_execve_o.hexa\n"
    buf = buf + "// (byte-eq to clang -O2, SYS#59).\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int hxlcl_execve(const char *path, char *const argv[], char *const envp[]);\n"
    buf = buf + "#else\n"
    buf = buf + "static int hxlcl_execve(const char *path, char *const argv[], char *const envp[]) {\n"
    buf = buf + "#if (defined(__arm64__) || defined(__aarch64__)) && defined(__APPLE__)\n"
    buf = buf + "    return (int)_hxlcl_syscall3_cf(HXLCL_SYS_EXECVE, (long)path, (long)argv, (long)envp);\n"
    buf = buf + "#else\n"
    buf = buf + "    return execve(path, argv, envp);\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "// execvp = native PATH search over execve (no libc dependency). If file has\n"
    buf = buf + "// a '/', exec directly; else try each $PATH dir. Byte-loop path-join avoids\n"
    buf = buf + "// strcpy/memcpy/strchr re-pulling those libc externs.\n"
    buf = buf + "static int hxlcl_execvp(const char *file, char *const argv[]) {\n"
    buf = buf + "    int has_slash = 0;\n"
    buf = buf + "    for (const char *q = file; *q; q++) { if (*q == '/') { has_slash = 1; break; } }\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    if (has_slash) return hxlcl_execve(file, argv, environ);\n"
    buf = buf + "    const char *path = hxlcl_getenv(\"PATH\");\n"
    buf = buf + "    if (!path || !*path) path = \"/usr/bin:/bin:/usr/local/bin\";\n"
    buf = buf + "    size_t flen = hxlcl_strlen(file);\n"
    buf = buf + "    char buf[1024];\n"
    buf = buf + "    const char *p = path;\n"
    buf = buf + "    while (*p) {\n"
    buf = buf + "        size_t dlen = 0;\n"
    buf = buf + "        while (p[dlen] && p[dlen] != ':') dlen++;\n"
    buf = buf + "        if (dlen + 1 + flen + 1 <= sizeof(buf)) {\n"
    buf = buf + "            size_t k = 0;\n"
    buf = buf + "            for (size_t i = 0; i < dlen; i++) buf[k++] = p[i];\n"
    buf = buf + "            buf[k++] = '/';\n"
    buf = buf + "            for (size_t i = 0; i <= flen; i++) buf[k++] = file[i]; // incl. NUL\n"
    buf = buf + "            hxlcl_execve(buf, argv, environ);                       // returns only on failure\n"
    buf = buf + "        }\n"
    buf = buf + "        p += dlen;\n"
    buf = buf + "        if (*p == ':') p++;\n"
    buf = buf + "    }\n"
    buf = buf + "    return -1;\n"
    buf = buf + "}\n"
    buf = buf + "// execl is variadic; gather varargs into a char* argv[] then call execvp.\n"
    buf = buf + "// Mirrors libc semantics — last arg must be (char*)NULL.\n"
    buf = buf + "static int hxlcl_execl(const char *path, const char *arg, ...) {\n"
    buf = buf + "    enum { HXLCL_EXECL_MAX = 256 };\n"
    buf = buf + "    char *argv[HXLCL_EXECL_MAX];\n"
    buf = buf + "    int n = 0;\n"
    buf = buf + "    argv[n++] = (char *)arg;\n"
    buf = buf + "    va_list ap;\n"
    buf = buf + "    va_start(ap, arg);\n"
    buf = buf + "    while (n < HXLCL_EXECL_MAX - 1) {\n"
    buf = buf + "        char *next = va_arg(ap, char *);\n"
    buf = buf + "        argv[n++] = next;\n"
    buf = buf + "        if (!next) break;\n"
    buf = buf + "    }\n"
    buf = buf + "    argv[HXLCL_EXECL_MAX - 1] = (char *)0;\n"
    buf = buf + "    va_end(ap);\n"
    buf = buf + "    return hxlcl_execve(path, argv, environ);\n"
    buf = buf + "}\n"
    buf = buf + "// hxlcl_popen — manual pipe+fork+execve replacement for libc popen.\n"
    buf = buf + "// Returns a \"fake FILE*\" compatible with hxlcl_fdopen's `(void*)(fd+1)`\n"
    buf = buf + "// convention so hxlcl_fread can read from it. The libc popen path\n"
    buf = buf + "// (extern FILE* popen) returns a real heap FILE* which the hxlcl_fread\n"
    buf = buf + "// macro mis-interprets (it expects fd-encoded \"FILE*\"s from\n"
    buf = buf + "// hxlcl_fdopen, not heap pointers) — so we replicate popen here using\n"
    buf = buf + "// the syscall primitives that now work post cycles 63/64 + the cycle\n"
    buf = buf + "// 66 fix to libc pipe/execve. To track the child pid for pclose we\n"
    buf = buf + "// stash it in a small linear table keyed by the read-fd. Mode \"r\"\n"
    buf = buf + "// only — the only mode hexa_exec uses.\n"
    buf = buf + "#define HXLCL_POPEN_MAX 64\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "static int  _hxlcl_popen_fds[HXLCL_POPEN_MAX];\n"
    buf = buf + "static int  _hxlcl_popen_pids[HXLCL_POPEN_MAX];\n"
    buf = buf + "static int  _hxlcl_popen_init_done = 0;\n"
    buf = buf + "static void _hxlcl_popen_init(void) {\n"
    buf = buf + "    if (_hxlcl_popen_init_done) return;\n"
    buf = buf + "    for (int i = 0; i < HXLCL_POPEN_MAX; i++) {\n"
    buf = buf + "        _hxlcl_popen_fds[i] = -1;\n"
    buf = buf + "        _hxlcl_popen_pids[i] = -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    _hxlcl_popen_init_done = 1;\n"
    buf = buf + "}\n"
    buf = buf + "static void _hxlcl_popen_remember(int fd, int pid) {\n"
    buf = buf + "    _hxlcl_popen_init();\n"
    buf = buf + "    for (int i = 0; i < HXLCL_POPEN_MAX; i++) {\n"
    buf = buf + "        if (_hxlcl_popen_fds[i] < 0) {\n"
    buf = buf + "            _hxlcl_popen_fds[i] = fd;\n"
    buf = buf + "            _hxlcl_popen_pids[i] = pid;\n"
    buf = buf + "            return;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "static int _hxlcl_popen_forget(int fd) {\n"
    buf = buf + "    _hxlcl_popen_init();\n"
    buf = buf + "    for (int i = 0; i < HXLCL_POPEN_MAX; i++) {\n"
    buf = buf + "        if (_hxlcl_popen_fds[i] == fd) {\n"
    buf = buf + "            int pid = _hxlcl_popen_pids[i];\n"
    buf = buf + "            _hxlcl_popen_fds[i] = -1;\n"
    buf = buf + "            _hxlcl_popen_pids[i] = -1;\n"
    buf = buf + "            return pid;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return -1;\n"
    buf = buf + "}\n"
    buf = buf + "static void *hxlcl_popen(const char *cmd, const char *mode) {\n"
    buf = buf + "    if (!cmd) return (void *)0;\n"
    buf = buf + "    /* Only \"r\" supported — hexa_exec only reads child stdout. */\n"
    buf = buf + "    if (!mode || mode[0] != 'r') return (void *)0;\n"
    buf = buf + "    int pfd[2];\n"
    buf = buf + "    if (hxlcl_pipe(pfd) != 0) return (void *)0;\n"
    buf = buf + "    fflush(NULL);\n"
    buf = buf + "    pid_t pid = hxlcl_fork();\n"
    buf = buf + "    if (pid < 0) {\n"
    buf = buf + "        hxlcl_close(pfd[0]); hxlcl_close(pfd[1]);\n"
    buf = buf + "        return (void *)0;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (pid == 0) {\n"
    buf = buf + "        /* child */\n"
    buf = buf + "        hxlcl_dup2(pfd[1], 1);\n"
    buf = buf + "        hxlcl_close(pfd[0]);\n"
    buf = buf + "        hxlcl_close(pfd[1]);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        hxlcl_execl(\"/bin/sh\", \"sh\", \"-c\", cmd, (char *)0);\n"
    buf = buf + "        _exit(127);\n"
    buf = buf + "    }\n"
    buf = buf + "    /* parent */\n"
    buf = buf + "    hxlcl_close(pfd[1]);\n"
    buf = buf + "    _hxlcl_popen_remember(pfd[0], pid);\n"
    buf = buf + "    /* hxlcl_fdopen returns (void*)(fd+1); hxlcl_fread expects this\n"
    buf = buf + "     * encoding via _hxlcl_fp_fd. */\n"
    buf = buf + "    return hxlcl_fdopen(pfd[0], \"r\");\n"
    buf = buf + "}\n"
    buf = buf + "static int hxlcl_pclose(void *stream) {\n"
    buf = buf + "    if (!stream) return -1;\n"
    buf = buf + "    /* Decode the fd from the fake FILE* via the same offset\n"
    buf = buf + "     * hxlcl_fdopen uses. */\n"
    buf = buf + "    int fd = (int)((uintptr_t)stream) - 1;\n"
    buf = buf + "    if (fd < 0) return -1;\n"
    buf = buf + "    int pid = _hxlcl_popen_forget(fd);\n"
    buf = buf + "    hxlcl_close(fd);\n"
    buf = buf + "    if (pid <= 0) return -1;\n"
    buf = buf + "    int status = 0;\n"
    buf = buf + "    (void)hxlcl_waitpid(pid, &status, 0);\n"
    buf = buf + "    return status;\n"
    buf = buf + "}\n"
    buf = buf + "static int hxlcl_forkpty(int *amaster, char *name, void *termp, void *winp) {\n"
    buf = buf + "    (void)amaster; (void)name; (void)termp; (void)winp; return (int)HX_INT(rt_net_fail());\n"
    buf = buf + "}\n"
    buf = buf + "static int hxlcl_posix_openpt(int flags) {\n"
    buf = buf + "    (void)flags; return (int)HX_INT(rt_net_fail());\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ── Extern FFI: dlopen / dlsym / dispatch ───────────────\n"
    buf = buf + "\n"
    buf = buf + "// Resolve a library path for dlopen.\n"
    buf = buf + "// If lib_name is NULL or empty, use RTLD_DEFAULT (search default symbols).\n"
    buf = buf + "// Helper: extract the basename (without \"lib\" prefix and without\n"
    buf = buf + "// \".dylib\"/\".so\" suffix) from a possibly-absolute library path. Used so\n"
    buf = buf + "// `@link(\"/abs/path/libhxblas.dylib\")` can fall back to a Linux\n"
    buf = buf + "// `libhxblas.so` (or vice-versa) without source changes — see the\n"
    buf = buf + "// hxblas-linux port (2026-04-16, c6_hxblas_linux_port_20260416.json).\n"
    buf = buf + "//\n"
    buf = buf + "// Returns 1 on success and writes the extracted name into out_name (max\n"
    buf = buf + "// out_cap bytes). Returns 0 if the input doesn't look like an\n"
    buf = buf + "// absolute lib path.\n"
    buf = buf + "static int hexa_ffi_extract_libname(const char* path, char* out_name, size_t out_cap) {\n"
    buf = buf + "    if (!path || !out_name || out_cap == 0) return 0;\n"
    buf = buf + "    // Find the basename (after the last '/')\n"
    buf = buf + "    const char* base = hxlcl_strrchr(path, '/');\n"
    buf = buf + "    base = base ? base + 1 : path;\n"
    buf = buf + "    // Must start with \"lib\"\n"
    buf = buf + "    if (hxlcl_strncmp(base, \"lib\", 3) != 0) return 0;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    base += 3;\n"
    buf = buf + "    // Must end in .dylib or .so or .so.N\n"
    buf = buf + "    size_t blen = hxlcl_strlen(base);\n"
    buf = buf + "    const char* end = NULL;\n"
    buf = buf + "    if (blen > 6 && hxlcl_strcmp(base + blen - 6, \".dylib\") == 0) {\n"
    buf = buf + "        end = base + blen - 6;\n"
    buf = buf + "    } else if (blen > 3 && hxlcl_strcmp(base + blen - 3, \".so\") == 0) {\n"
    buf = buf + "        end = base + blen - 3;\n"
    buf = buf + "    } else {\n"
    buf = buf + "        // .so.N case — find \".so.\" substring\n"
    buf = buf + "        const char* p = hxlcl_strstr(base, \".so.\");\n"
    buf = buf + "        if (p) end = p;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (!end) return 0;\n"
    buf = buf + "    size_t nlen = (size_t)(end - base);\n"
    buf = buf + "    if (nlen == 0 || nlen >= out_cap) return 0;\n"
    buf = buf + "    hxlcl_memcpy(out_name, base, nlen);\n"
    buf = buf + "    out_name[nlen] = '\\0';\n"
    buf = buf + "    return 1;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* PHASE 1.5 (2026-05-15): de-staticized. hexat emits direct calls to\n"
    buf = buf + " * hexa_ffi_dlopen/dlsym from user.c for FFI shim setup; runtime.h-built\n"
    buf = buf + " * user.c needs cross-TU access. */\n"
    buf = buf + "void* hexa_ffi_dlopen(const char* lib_name) {\n"
    buf = buf + "    if (!lib_name || lib_name[0] == '\\0') {\n"
    buf = buf + "        return dlopen(NULL, RTLD_LAZY);\n"
    buf = buf + "    }\n"
    buf = buf + "#ifdef __APPLE__\n"
    buf = buf + "    // Try framework path first\n"
    buf = buf + "    char framework[512];\n"
    buf = buf + "    snprintf(framework, sizeof(framework),\n"
    buf = buf + "        \"/System/Library/Frameworks/%s.framework/%s\", lib_name, lib_name);\n"
    buf = buf + "    void* h = dlopen(framework, RTLD_LAZY);\n"
    buf = buf + "    if (h) return h;\n"
    buf = buf + "    // Try dylib\n"
    buf = buf + "    char dylib[512];\n"
    buf = buf + "    snprintf(dylib, sizeof(dylib), \"/usr/lib/lib%s.dylib\", lib_name);\n"
    buf = buf + "    h = dlopen(dylib, RTLD_LAZY);\n"
    buf = buf + "    if (h) return h;\n"
    buf = buf + "    // ── New (2026-04-16): also try `lib<name>.dylib` so a bare\n"
    buf = buf + "    //    @link(\"hxblas\") + DYLD_LIBRARY_PATH=<dir> works on Mac\n"
    buf = buf + "    //    just like `lib<name>.so` + LD_LIBRARY_PATH does on Linux. ──\n"
    buf = buf + "    char dylib_bare[512];\n"
    buf = buf + "    snprintf(dylib_bare, sizeof(dylib_bare), \"lib%s.dylib\", lib_name);\n"
    buf = buf + "    h = dlopen(dylib_bare, RTLD_LAZY);\n"
    buf = buf + "    if (h) return h;\n"
    buf = buf + "    // ── C2 Step 3 (2026-04-16): macOS SIP strips DYLD_LIBRARY_PATH\n"
    buf = buf + "    //    when crossing any system-signed binary (/bin/sh, etc). So\n"
    buf = buf + "    //    `./hexa run` → popen → sh -c → interp loses DYLD. Work around\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    //    by searching a few known repo-relative install dirs for the\n"
    buf = buf + "    //    hexa-lang native build output before giving up. ──\n"
    buf = buf + "    {\n"
    buf = buf + "        const char* search_prefixes[8];\n"
    buf = buf + "        int sp_n = 0;\n"
    buf = buf + "        const char* hl = hxlcl_getenv(\"HEXA_LANG\");\n"
    buf = buf + "        if (hl && hl[0]) search_prefixes[sp_n++] = hl;\n"
    buf = buf + "        const char* nld = hxlcl_getenv(\"HEXA_NATIVE_LIB_DIR\");\n"
    buf = buf + "        if (nld && nld[0]) search_prefixes[sp_n++] = nld;\n"
    buf = buf + "        search_prefixes[sp_n++] = \".\";\n"
    buf = buf + "        search_prefixes[sp_n++] = \"/Users/ghost/Dev/hexa-lang\";\n"
    buf = buf + "        search_prefixes[sp_n++] = \"/Users/ghost/dev/hexa-lang\";\n"
    buf = buf + "        // Try <prefix>/self/native/build/lib<name>.dylib for each prefix.\n"
    buf = buf + "        const char* rel_patterns[] = {\n"
    buf = buf + "            \"%s/self/native/build/lib%s.dylib\",\n"
    buf = buf + "            \"%s/build/lib%s.dylib\",\n"
    buf = buf + "            \"%s/lib%s.dylib\",\n"
    buf = buf + "            NULL\n"
    buf = buf + "        };\n"
    buf = buf + "        for (int i = 0; i < sp_n; i++) {\n"
    buf = buf + "            for (int j = 0; rel_patterns[j]; j++) {\n"
    buf = buf + "                char p[512];\n"
    buf = buf + "                snprintf(p, sizeof(p), rel_patterns[j], search_prefixes[i], lib_name);\n"
    buf = buf + "                void* hr = dlopen(p, RTLD_LAZY);\n"
    buf = buf + "                if (hr) return hr;\n"
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "#endif\n"
    buf = buf + "    // Try as-is (Linux .so or absolute path)\n"
    buf = buf + "    char sopath[512];\n"
    buf = buf + "    snprintf(sopath, sizeof(sopath), \"lib%s.so\", lib_name);\n"
    buf = buf + "    void* h2 = dlopen(sopath, RTLD_LAZY);\n"
    buf = buf + "    if (h2) return h2;\n"
    buf = buf + "#ifndef __APPLE__\n"
    buf = buf + "    // CUDA path + soname version fallbacks (Linux)\n"
    buf = buf + "    {\n"
    buf = buf + "        char path[512];\n"
    buf = buf + "        const char* cuda_dirs[] = {\n"
    buf = buf + "            \"/usr/local/cuda/lib64/lib%s.so\",\n"
    buf = buf + "            \"/usr/local/cuda/lib64/lib%s.so.12\",\n"
    buf = buf + "            \"/usr/local/cuda/lib64/lib%s.so.11\",\n"
    buf = buf + "            NULL\n"
    buf = buf + "        };\n"
    buf = buf + "        for (int j = 0; cuda_dirs[j]; j++) {\n"
    buf = buf + "            snprintf(path, sizeof(path), cuda_dirs[j], lib_name);\n"
    buf = buf + "            void* hc = dlopen(path, RTLD_LAZY);\n"
    buf = buf + "            if (hc) return hc;\n"
    buf = buf + "        }\n"
    buf = buf + "        const char* sonames[] = {\"lib%s.so.12\", \"lib%s.so.11\", NULL};\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        for (int j = 0; sonames[j]; j++) {\n"
    buf = buf + "            snprintf(path, sizeof(path), sonames[j], lib_name);\n"
    buf = buf + "            void* hc = dlopen(path, RTLD_LAZY);\n"
    buf = buf + "            if (hc) return hc;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "#endif\n"
    buf = buf + "    // ── New (2026-04-16, hxblas linux port): when the user passes\n"
    buf = buf + "    //    an absolute Mac/Linux library path that doesn't resolve\n"
    buf = buf + "    //    on this host (e.g. @link(\"/Users/.../libhxblas.dylib\") on a\n"
    buf = buf + "    //    Linux pod), strip the dirname + lib prefix + .{dylib,so}\n"
    buf = buf + "    //    suffix and retry the search with just the base name. This\n"
    buf = buf + "    //    lets the same hexa source resolve `libhxblas.so` on Linux\n"
    buf = buf + "    //    via LD_LIBRARY_PATH and `libhxblas.dylib` on Mac via\n"
    buf = buf + "    //    DYLD_LIBRARY_PATH without #ifdef in the hexa file. ──\n"
    buf = buf + "    if (lib_name[0] == '/') {\n"
    buf = buf + "        char base[256];\n"
    buf = buf + "        if (hexa_ffi_extract_libname(lib_name, base, sizeof(base))) {\n"
    buf = buf + "#ifdef __APPLE__\n"
    buf = buf + "            char p[512];\n"
    buf = buf + "            snprintf(p, sizeof(p), \"lib%s.dylib\", base);\n"
    buf = buf + "            void* hb = dlopen(p, RTLD_LAZY);\n"
    buf = buf + "            if (hb) return hb;\n"
    buf = buf + "#else\n"
    buf = buf + "            char p[512];\n"
    buf = buf + "            snprintf(p, sizeof(p), \"lib%s.so\", base);\n"
    buf = buf + "            void* hb = dlopen(p, RTLD_LAZY);\n"
    buf = buf + "            if (hb) return hb;\n"
    buf = buf + "#endif\n"
    buf = buf + "            // Also honour HEXA_NATIVE_LIB_DIR explicit search prefix\n"
    buf = buf + "            const char* dir = hxlcl_getenv(\"HEXA_NATIVE_LIB_DIR\");\n"
    buf = buf + "            if (dir && dir[0]) {\n"
    buf = buf + "                char p2[512];\n"
    buf = buf + "#ifdef __APPLE__\n"
    buf = buf + "                snprintf(p2, sizeof(p2), \"%s/lib%s.dylib\", dir, base);\n"
    buf = buf + "#else\n"
    buf = buf + "                snprintf(p2, sizeof(p2), \"%s/lib%s.so\", dir, base);\n"
    buf = buf + "#endif\n"
    buf = buf + "                void* hb2 = dlopen(p2, RTLD_LAZY);\n"
    buf = buf + "                if (hb2) return hb2;\n"
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    // Final attempt: bare name\n"
    buf = buf + "    return dlopen(lib_name, RTLD_LAZY);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Resolve a symbol from an already-opened library handle.\n"
    buf = buf + "/* PHASE 1.5 (2026-05-15): de-staticized (paired with hexa_ffi_dlopen above). */\n"
    buf = buf + "void* hexa_ffi_dlsym(void* handle, const char* symbol) {\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    void* sym = dlsym(handle, symbol);\n"
    buf = buf + "    if (!sym) {\n"
    buf = buf + "        fprintf(stderr, \"[hexa-ffi] dlsym failed for '%s': %s\\n\", symbol, dlerror());\n"
    buf = buf + "    }\n"
    buf = buf + "    return sym;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Marshal a HexaVal to a raw i64 for C ABI passing.\n"
    buf = buf + "static int64_t hexa_ffi_marshal_arg(HexaVal v) {\n"
    buf = buf + "    switch (HX_TAG(v)) {\n"
    buf = buf + "        case TAG_INT:   return HX_INT(v);\n"
    buf = buf + "        case TAG_FLOAT: { union { double d; int64_t i; } u; u.d = HX_FLOAT(v); return u.i; }\n"
    buf = buf + "        case TAG_BOOL:  return (int64_t)HX_BOOL(v);\n"
    buf = buf + "        case TAG_STR:   return (int64_t)(uintptr_t)HX_STR(v);\n"
    buf = buf + "        case TAG_VOID:  return 0;\n"
    buf = buf + "        default:        return 0;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Raw extern call dispatch — supports 0 to 14 arguments.\n"
    buf = buf + "// Extended 2026-04-16 from 12 to 14 to support cblas_sgemm (14 args).\n"
    buf = buf + "// Uses transmute (cast) to call through a function pointer with the right arity.\n"
    buf = buf + "static int64_t hexa_call_extern_raw(void* fn_ptr, int64_t* args, int nargs) {\n"
    buf = buf + "    typedef int64_t (*Fn0)(void);\n"
    buf = buf + "    typedef int64_t (*Fn1)(int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn2)(int64_t,int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn3)(int64_t,int64_t,int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn4)(int64_t,int64_t,int64_t,int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn5)(int64_t,int64_t,int64_t,int64_t,int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn6)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn7)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn8)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn9)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn10)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn11)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn12)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn13)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn14)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t);\n"
    buf = buf + "\n"
    buf = buf + "    switch (nargs) {\n"
    buf = buf + "        case 0:  return ((Fn0)fn_ptr)();\n"
    buf = buf + "        case 1:  return ((Fn1)fn_ptr)(args[0]);\n"
    buf = buf + "        case 2:  return ((Fn2)fn_ptr)(args[0],args[1]);\n"
    buf = buf + "        case 3:  return ((Fn3)fn_ptr)(args[0],args[1],args[2]);\n"
    buf = buf + "        case 4:  return ((Fn4)fn_ptr)(args[0],args[1],args[2],args[3]);\n"
    buf = buf + "        case 5:  return ((Fn5)fn_ptr)(args[0],args[1],args[2],args[3],args[4]);\n"
    buf = buf + "        case 6:  return ((Fn6)fn_ptr)(args[0],args[1],args[2],args[3],args[4],args[5]);\n"
    buf = buf + "        case 7:  return ((Fn7)fn_ptr)(args[0],args[1],args[2],args[3],args[4],args[5],args[6]);\n"
    buf = buf + "        case 8:  return ((Fn8)fn_ptr)(args[0],args[1],args[2],args[3],args[4],args[5],args[6],args[7]);\n"
    buf = buf + "        case 9:  return ((Fn9)fn_ptr)(args[0],args[1],args[2],args[3],args[4],args[5],args[6],args[7],args[8]);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        case 10: return ((Fn10)fn_ptr)(args[0],args[1],args[2],args[3],args[4],args[5],args[6],args[7],args[8],args[9]);\n"
    buf = buf + "        case 11: return ((Fn11)fn_ptr)(args[0],args[1],args[2],args[3],args[4],args[5],args[6],args[7],args[8],args[9],args[10]);\n"
    buf = buf + "        case 12: return ((Fn12)fn_ptr)(args[0],args[1],args[2],args[3],args[4],args[5],args[6],args[7],args[8],args[9],args[10],args[11]);\n"
    buf = buf + "        case 13: return ((Fn13)fn_ptr)(args[0],args[1],args[2],args[3],args[4],args[5],args[6],args[7],args[8],args[9],args[10],args[11],args[12]);\n"
    buf = buf + "        case 14: return ((Fn14)fn_ptr)(args[0],args[1],args[2],args[3],args[4],args[5],args[6],args[7],args[8],args[9],args[10],args[11],args[12],args[13]);\n"
    buf = buf + "        default:\n"
    buf = buf + "            fprintf(stderr, \"[hexa-ffi] extern call with %d args not supported (max 14)\\n\", nargs);\n"
    buf = buf + "            return 0;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// High-level extern call: resolve, marshal, call, unmarshal.\n"
    buf = buf + "// ret_kind: 0=void, 1=int, 2=float, 3=bool, 4=pointer/string\n"
    buf = buf + "HexaVal hexa_extern_call(void* fn_ptr, HexaVal* hargs, int nargs, int ret_kind) {\n"
    buf = buf + "    int64_t cargs[14];  // extended for cblas_sgemm (14 args)\n"
    buf = buf + "    for (int i = 0; i < nargs && i < 14; i++) {\n"
    buf = buf + "        cargs[i] = hexa_ffi_marshal_arg(hargs[i]);\n"
    buf = buf + "    }\n"
    buf = buf + "    int64_t ret = hexa_call_extern_raw(fn_ptr, cargs, nargs);\n"
    buf = buf + "    switch (ret_kind) {\n"
    buf = buf + "        case 0:  return hexa_void();\n"
    buf = buf + "        case 1:  return hexa_int(ret);\n"
    buf = buf + "        case 2:  { union { int64_t i; double d; } u; u.i = ret; return hexa_float(u.d); }\n"
    buf = buf + "        case 3:  return hexa_bool(ret != 0);\n"
    buf = buf + "        case 4:  return hexa_int(ret); // pointer as int\n"
    buf = buf + "        default: return hexa_int(ret);\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ── G3: Typed extern call with float support ─────────────\n"
    buf = buf + "// float_mask is a bitmask: bit i set means arg i is a double (SIMD register).\n"
    buf = buf + "// This generates correct ARM64 calling convention for mixed int/float args.\n"
    buf = buf + "// Supports up to 14 args (covers vDSP_mmul 9-arg, cblas_sgemm 14-arg).\n"
    buf = buf + "// The C compiler sees typed args and emits correct register moves.\n"
    buf = buf + "HexaVal hexa_extern_call_typed(void* fn_ptr, HexaVal* hargs, int nargs, int ret_kind, int float_mask) {\n"
    buf = buf + "    // Extract values: doubles from .f, integers from .i\n"
    buf = buf + "    double  fv[14]; // float values\n"
    buf = buf + "    int64_t iv[14]; // int values\n"
    buf = buf + "    for (int i = 0; i < nargs && i < 14; i++) {\n"
    buf = buf + "        if (float_mask & (1 << i)) {\n"
    buf = buf + "            fv[i] = HX_IS_FLOAT(hargs[i]) ? HX_FLOAT(hargs[i]) : (double)HX_INT(hargs[i]);\n"
    buf = buf + "        } else {\n"
    buf = buf + "            iv[i] = hexa_ffi_marshal_arg(hargs[i]);\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    // Dispatch by nargs and float_mask pattern\n"
    buf = buf + "    // Common patterns: all-int (mask=0), trailing floats, all-float\n"
    buf = buf + "    // For arbitrary patterns, we use a switch on nargs with typed casts.\n"
    buf = buf + "    // The C compiler handles register allocation from the typed call.\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    // Helper macros for arg extraction\n"
    buf = buf + "    #define A(i) ((float_mask & (1<<(i))) ? 0 : iv[i])\n"
    buf = buf + "    #define F(i) ((float_mask & (1<<(i))) ? fv[i] : 0.0)\n"
    buf = buf + "    #define IS_F(i) (float_mask & (1<<(i)))\n"
    buf = buf + "\n"
    buf = buf + "    int64_t reti = 0;\n"
    buf = buf + "    double  retf = 0.0;\n"
    buf = buf + "    int ret_is_float = (ret_kind == 2);\n"
    buf = buf + "\n"
    buf = buf + "    // For each arity, generate all-int call if mask==0, else use typed dispatch\n"
    buf = buf + "    switch (nargs) {\n"
    buf = buf + "        case 0: {\n"
    buf = buf + "            if (ret_is_float) { retf = ((double(*)(void))fn_ptr)(); }\n"
    buf = buf + "            else { reti = ((int64_t(*)(void))fn_ptr)(); }\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "        case 1: {\n"
    buf = buf + "            if (IS_F(0)) {\n"
    buf = buf + "                if (ret_is_float) retf = ((double(*)(double))fn_ptr)(fv[0]);\n"
    buf = buf + "                else reti = ((int64_t(*)(double))fn_ptr)(fv[0]);\n"
    buf = buf + "            } else {\n"
    buf = buf + "                if (ret_is_float) retf = ((double(*)(int64_t))fn_ptr)(iv[0]);\n"
    buf = buf + "                else reti = ((int64_t(*)(int64_t))fn_ptr)(iv[0]);\n"
    buf = buf + "            }\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "        case 2: {\n"
    buf = buf + "            // 4 combinations for 2 args\n"
    buf = buf + "            int p = (IS_F(0)?2:0) | (IS_F(1)?1:0);\n"
    buf = buf + "            switch (p) {\n"
    buf = buf + "                case 0: // ii\n"
    buf = buf + "                    if (ret_is_float) retf = ((double(*)(int64_t,int64_t))fn_ptr)(iv[0],iv[1]);\n"
    buf = buf + "                    else reti = ((int64_t(*)(int64_t,int64_t))fn_ptr)(iv[0],iv[1]);\n"
    buf = buf + "                    break;\n"
    buf = buf + "                case 1: // if\n"
    buf = buf + "                    if (ret_is_float) retf = ((double(*)(int64_t,double))fn_ptr)(iv[0],fv[1]);\n"
    buf = buf + "                    else reti = ((int64_t(*)(int64_t,double))fn_ptr)(iv[0],fv[1]);\n"
    buf = buf + "                    break;\n"
    buf = buf + "                case 2: // fi\n"
    buf = buf + "                    if (ret_is_float) retf = ((double(*)(double,int64_t))fn_ptr)(fv[0],iv[1]);\n"
    buf = buf + "                    else reti = ((int64_t(*)(double,int64_t))fn_ptr)(fv[0],iv[1]);\n"
    buf = buf + "                    break;\n"
    buf = buf + "                case 3: // ff\n"
    buf = buf + "                    if (ret_is_float) retf = ((double(*)(double,double))fn_ptr)(fv[0],fv[1]);\n"
    buf = buf + "                    else reti = ((int64_t(*)(double,double))fn_ptr)(fv[0],fv[1]);\n"
    buf = buf + "                    break;\n"
    buf = buf + "            }\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "        case 3: {\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "            // 3 args — dispatch 2^3 = 8 patterns for int/float lane mapping.\n"
    buf = buf + "            int p = (IS_F(0)?4:0) | (IS_F(1)?2:0) | (IS_F(2)?1:0);\n"
    buf = buf + "            switch (p) {\n"
    buf = buf + "                case 0: if (ret_is_float) retf = ((double(*)(int64_t,int64_t,int64_t))fn_ptr)(iv[0],iv[1],iv[2]); else reti = ((int64_t(*)(int64_t,int64_t,int64_t))fn_ptr)(iv[0],iv[1],iv[2]); break;\n"
    buf = buf + "                case 1: if (ret_is_float) retf = ((double(*)(int64_t,int64_t,double))fn_ptr)(iv[0],iv[1],fv[2]); else reti = ((int64_t(*)(int64_t,int64_t,double))fn_ptr)(iv[0],iv[1],fv[2]); break;\n"
    buf = buf + "                case 2: if (ret_is_float) retf = ((double(*)(int64_t,double,int64_t))fn_ptr)(iv[0],fv[1],iv[2]); else reti = ((int64_t(*)(int64_t,double,int64_t))fn_ptr)(iv[0],fv[1],iv[2]); break;\n"
    buf = buf + "                case 3: if (ret_is_float) retf = ((double(*)(int64_t,double,double))fn_ptr)(iv[0],fv[1],fv[2]); else reti = ((int64_t(*)(int64_t,double,double))fn_ptr)(iv[0],fv[1],fv[2]); break;\n"
    buf = buf + "                case 4: if (ret_is_float) retf = ((double(*)(double,int64_t,int64_t))fn_ptr)(fv[0],iv[1],iv[2]); else reti = ((int64_t(*)(double,int64_t,int64_t))fn_ptr)(fv[0],iv[1],iv[2]); break;\n"
    buf = buf + "                case 5: if (ret_is_float) retf = ((double(*)(double,int64_t,double))fn_ptr)(fv[0],iv[1],fv[2]); else reti = ((int64_t(*)(double,int64_t,double))fn_ptr)(fv[0],iv[1],fv[2]); break;\n"
    buf = buf + "                case 6: if (ret_is_float) retf = ((double(*)(double,double,int64_t))fn_ptr)(fv[0],fv[1],iv[2]); else reti = ((int64_t(*)(double,double,int64_t))fn_ptr)(fv[0],fv[1],iv[2]); break;\n"
    buf = buf + "                case 7: if (ret_is_float) retf = ((double(*)(double,double,double))fn_ptr)(fv[0],fv[1],fv[2]); else reti = ((int64_t(*)(double,double,double))fn_ptr)(fv[0],fv[1],fv[2]); break;\n"
    buf = buf + "            }\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "        case 4: {\n"
    buf = buf + "            // 4 args — only handle common trailing-float patterns explicitly.\n"
    buf = buf + "            int p = (IS_F(0)?8:0) | (IS_F(1)?4:0) | (IS_F(2)?2:0) | (IS_F(3)?1:0);\n"
    buf = buf + "            if (p == 0) {\n"
    buf = buf + "                if (ret_is_float) retf = ((double(*)(int64_t,int64_t,int64_t,int64_t))fn_ptr)(iv[0],iv[1],iv[2],iv[3]);\n"
    buf = buf + "                else reti = ((int64_t(*)(int64_t,int64_t,int64_t,int64_t))fn_ptr)(iv[0],iv[1],iv[2],iv[3]);\n"
    buf = buf + "            } else if (p == 1) { // iiif\n"
    buf = buf + "                if (ret_is_float) retf = ((double(*)(int64_t,int64_t,int64_t,double))fn_ptr)(iv[0],iv[1],iv[2],fv[3]);\n"
    buf = buf + "                else reti = ((int64_t(*)(int64_t,int64_t,int64_t,double))fn_ptr)(iv[0],iv[1],iv[2],fv[3]);\n"
    buf = buf + "            } else {\n"
    buf = buf + "                fprintf(stderr, \"[hexa-ffi] unsupported 4-arg float pattern p=%d\\n\", p);\n"
    buf = buf + "                reti = 0;\n"
    buf = buf + "            }\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "        case 5: {\n"
    buf = buf + "            // 5 args — hxlayer_rmsnorm_silu(N:int, out:*, x:*, g:*, eps:f32)\n"
    buf = buf + "            // is the driving case: (int,int,int,int,float) = p==1.\n"
    buf = buf + "            int p = (IS_F(0)?16:0) | (IS_F(1)?8:0) | (IS_F(2)?4:0) | (IS_F(3)?2:0) | (IS_F(4)?1:0);\n"
    buf = buf + "            if (p == 0) {\n"
    buf = buf + "                if (ret_is_float) retf = ((double(*)(int64_t,int64_t,int64_t,int64_t,int64_t))fn_ptr)(iv[0],iv[1],iv[2],iv[3],iv[4]);\n"
    buf = buf + "                else reti = ((int64_t(*)(int64_t,int64_t,int64_t,int64_t,int64_t))fn_ptr)(iv[0],iv[1],iv[2],iv[3],iv[4]);\n"
    buf = buf + "            } else if (p == 1) { // iiiif\n"
    buf = buf + "                if (ret_is_float) retf = ((double(*)(int64_t,int64_t,int64_t,int64_t,double))fn_ptr)(iv[0],iv[1],iv[2],iv[3],fv[4]);\n"
    buf = buf + "                else reti = ((int64_t(*)(int64_t,int64_t,int64_t,int64_t,double))fn_ptr)(iv[0],iv[1],iv[2],iv[3],fv[4]);\n"
    buf = buf + "            } else {\n"
    buf = buf + "                fprintf(stderr, \"[hexa-ffi] unsupported 5-arg float pattern p=%d\\n\", p);\n"
    buf = buf + "                reti = 0;\n"
    buf = buf + "            }\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "        case 6: {\n"
    buf = buf + "            // 6 args — cblas_saxpy(N, alpha, x, incx, y, incy)\n"
    buf = buf + "            if (float_mask == 0) {\n"
    buf = buf + "                reti = ((int64_t(*)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t))fn_ptr)(iv[0],iv[1],iv[2],iv[3],iv[4],iv[5]);\n"
    buf = buf + "            } else if (float_mask == 0x02) { // i f i i i i — cblas_saxpy(N,alpha,x,incx,y,incy)\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "                ((void(*)(int64_t,double,int64_t,int64_t,int64_t,int64_t))fn_ptr)(iv[0],fv[1],iv[2],iv[3],iv[4],iv[5]);\n"
    buf = buf + "                reti = 0;\n"
    buf = buf + "            } else {\n"
    buf = buf + "                reti = hexa_call_extern_raw(fn_ptr, iv, nargs);\n"
    buf = buf + "            }\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "        case 7: {\n"
    buf = buf + "            // 7 args — vDSP_vadd/vmul(A,sA,B,sB,C,sC,N)\n"
    buf = buf + "            if (float_mask == 0) {\n"
    buf = buf + "                ((void(*)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t))fn_ptr)(iv[0],iv[1],iv[2],iv[3],iv[4],iv[5],iv[6]);\n"
    buf = buf + "                reti = 0;\n"
    buf = buf + "            } else {\n"
    buf = buf + "                reti = hexa_call_extern_raw(fn_ptr, iv, nargs);\n"
    buf = buf + "            }\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "        case 8: {\n"
    buf = buf + "            // 8 args\n"
    buf = buf + "            if (float_mask == 0) {\n"
    buf = buf + "                reti = ((int64_t(*)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t))fn_ptr)(iv[0],iv[1],iv[2],iv[3],iv[4],iv[5],iv[6],iv[7]);\n"
    buf = buf + "            } else {\n"
    buf = buf + "                reti = hexa_call_extern_raw(fn_ptr, iv, nargs);\n"
    buf = buf + "            }\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "        case 9: {\n"
    buf = buf + "            // 9 args — vDSP_mmul(A,sA,B,sB,C,sC,M,N,K)\n"
    buf = buf + "            if (float_mask == 0) {\n"
    buf = buf + "                ((void(*)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t))fn_ptr)(iv[0],iv[1],iv[2],iv[3],iv[4],iv[5],iv[6],iv[7],iv[8]);\n"
    buf = buf + "                reti = 0;\n"
    buf = buf + "            } else {\n"
    buf = buf + "                reti = hexa_call_extern_raw(fn_ptr, iv, nargs);\n"
    buf = buf + "            }\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "        default: {\n"
    buf = buf + "            // 10-14 args: fall back to raw int dispatch (handles up to 14).\n"
    buf = buf + "            reti = hexa_call_extern_raw(fn_ptr, iv, nargs);\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    #undef A\n"
    buf = buf + "    #undef F\n"
    buf = buf + "    #undef IS_F\n"
    buf = buf + "\n"
    buf = buf + "    switch (ret_kind) {\n"
    buf = buf + "        case 0:  return hexa_void();\n"
    buf = buf + "        case 1:  return hexa_int(reti);\n"
    buf = buf + "        case 2:  return hexa_float(retf);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        case 3:  return hexa_bool(reti != 0);\n"
    buf = buf + "        case 4:  return hexa_int(reti);\n"
    buf = buf + "        default: return hexa_int(reti);\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Convenience: cstring <-> HexaVal\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_from_cstring(HexaVal ptr) {\n"
    buf = buf + "    uint64_t p = HX_IS_INT(ptr) ? HX_INT_U(ptr) : 0;\n"
    buf = buf + "    if (p == 0) return hexa_str(\"\");\n"
    buf = buf + "    return hexa_str((const char*)(uintptr_t)p);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ── C2 Step 3: Dynamic FFI host dispatch (interpreter path) ──\n"
    buf = buf + "//\n"
    buf = buf + "// Purpose: expose dlopen+dlsym+extern_call as HexaVal builtins so the\n"
    buf = buf + "// self-host interpreter (self/interpreter.hexa) can dispatch @link externs\n"
    buf = buf + "// at runtime without going through codegen.hexa's static __ffi_sym_*\n"
    buf = buf + "// registration. The native (compile-to-native) path already works via\n"
    buf = buf + "// codegen; this reopens the same pipeline for `./hexa run`.\n"
    buf = buf + "//\n"
    buf = buf + "// Forward declaration — defined alongside hexa_host_ffi_call below.\n"
    buf = buf + "static HexaVal hexa_host_ffi_unwrap(HexaVal v);\n"
    buf = buf + "\n"
    buf = buf + "// hexa_host_ffi_open(lib_name: str) -> ptr(int)\n"
    buf = buf + "//   0 on failure (e.g. library not found under any search strategy).\n"
    buf = buf + "HexaVal hexa_host_ffi_open(HexaVal lib_name) {\n"
    buf = buf + "    HexaVal uv = hexa_host_ffi_unwrap(lib_name);\n"
    buf = buf + "    const char* name = (HX_IS_STR(uv) && HX_STR(uv)) ? HX_STR(uv) : \"\";\n"
    buf = buf + "    void* h = hexa_ffi_dlopen(name);\n"
    buf = buf + "    return hexa_int((int64_t)(uintptr_t)h);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// hexa_host_ffi_sym(handle: int, symbol: str) -> ptr(int)\n"
    buf = buf + "//   0 on failure.\n"
    buf = buf + "HexaVal hexa_host_ffi_sym(HexaVal handle, HexaVal symbol) {\n"
    buf = buf + "    HexaVal uh = hexa_host_ffi_unwrap(handle);\n"
    buf = buf + "    HexaVal us = hexa_host_ffi_unwrap(symbol);\n"
    buf = buf + "    void* h = HX_IS_INT(uh) ? (void*)(uintptr_t)HX_INT_U(uh) : NULL;\n"
    buf = buf + "    const char* sym = (HX_IS_STR(us) && HX_STR(us)) ? HX_STR(us) : \"\";\n"
    buf = buf + "    if (!h || !sym || !*sym) return hexa_int(0);\n"
    buf = buf + "    void* fn = dlsym(h, sym);\n"
    buf = buf + "    if (!fn) {\n"
    buf = buf + "        fprintf(stderr, \"[hexa-ffi] dlsym failed for '%s': %s\\n\", sym, dlerror());\n"
    buf = buf + "        return hexa_int(0);\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int((int64_t)(uintptr_t)fn);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// hexa_host_ffi_call(fn_ptr: int, args_arr: array, float_mask: int, ret_kind: int) -> int|float\n"
    buf = buf + "//   ret_kind: 0=void, 1=int, 2=float, 3=bool, 4=pointer\n"
    buf = buf + "//   float_mask: bit i set => arg i is double\n"
    buf = buf + "//\n"
    buf = buf + "// Unwraps any HexaValStruct-wrapped args (the interpreter's native Val\n"
    buf = buf + "// representation) down to the corresponding primitive HexaVal so that\n"
    buf = buf + "// hexa_ffi_marshal_arg / hexa_extern_call_typed read the right lane.\n"
    buf = buf + "// Without this the interpreter-produced TAG_VALSTRUCT falls through the\n"
    buf = buf + "// marshal switch default and every arg becomes 0.\n"
    buf = buf + "static HexaVal hexa_host_ffi_unwrap(HexaVal v) {\n"
    buf = buf + "    if (!HX_IS_VALSTRUCT(v) || !HX_VS(v)) return v;\n"
    buf = buf + "    int64_t t = HX_VSF(v, tag_i);\n"
    buf = buf + "    // Hexa-level tag values: 0=INT, 1=FLOAT, 2=BOOL, 3=STR, 8=VOID, 13=POINTER\n"
    buf = buf + "    // See self/interpreter.hexa let TAG_* constants.\n"
    buf = buf + "    if (t == 0)  return hexa_int(HX_VSF(v, int_val));\n"
    buf = buf + "    if (t == 1)  return hexa_float(HX_VSF(v, float_val));\n"
    buf = buf + "    if (t == 2)  return hexa_bool(HX_VSF(v, bool_val));\n"
    buf = buf + "    if (t == 3)  return HX_VSF(v, str_val);       // already TAG_STR\n"
    buf = buf + "    if (t == 13) return hexa_int(HX_VSF(v, int_val));  // pointer → int ABI lane\n"
    buf = buf + "    return hexa_int(HX_VSF(v, int_val));\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_host_ffi_call(HexaVal fn_ptr, HexaVal args_arr, HexaVal float_mask, HexaVal ret_kind) {\n"
    buf = buf + "    HexaVal fp_v = hexa_host_ffi_unwrap(fn_ptr);\n"
    buf = buf + "    void* fp = HX_IS_INT(fp_v) ? (void*)(uintptr_t)HX_INT_U(fp_v) : NULL;\n"
    buf = buf + "    if (!fp) return hexa_int(0);\n"
    buf = buf + "    HexaVal rk_v = hexa_host_ffi_unwrap(ret_kind);\n"
    buf = buf + "    HexaVal fm_v = hexa_host_ffi_unwrap(float_mask);\n"
    buf = buf + "    int rk   = HX_IS_INT(rk_v) ? (int)HX_INT(rk_v) : 1;\n"
    buf = buf + "    int mask = HX_IS_INT(fm_v) ? (int)HX_INT(fm_v) : 0;\n"
    buf = buf + "    // args_arr may be (a) a TAG_ARRAY built by the native-compiled hexa\n"
    buf = buf + "    // runtime (hexa_array_new — direct member access works) OR\n"
    buf = buf + "    // (b) a TAG_VALSTRUCT whose tag_i == TAG_ARRAY (hexa level 5) — the\n"
    buf = buf + "    // form used by the self-host interpreter's val_array(). In case (b)\n"
    buf = buf + "    // the real data lives behind the hexa-level array_store, which this\n"
    buf = buf + "    // native wrapper cannot reach. So we require native-array input and\n"
    buf = buf + "    // error out otherwise.\n"
    buf = buf + "    if (!HX_IS_ARRAY(args_arr)) {\n"
    buf = buf + "        fprintf(stderr,\n"
    buf = buf + "            \"[hexa-ffi] host_ffi_call: expected native array (tag=%d), got tag=%d. \"\n"
    buf = buf + "            \"Self-host interpreter must marshal through hexa_host_ffi_call_6 instead.\\n\",\n"
    buf = buf + "            (int)TAG_ARRAY, (int)HX_TAG(args_arr));\n"
    buf = buf + "        return hexa_int(0);\n"
    buf = buf + "    }\n"
    buf = buf + "    int nargs = hexa_len(args_arr);\n"
    buf = buf + "    if (nargs > 12) nargs = 12;\n"
    buf = buf + "    HexaVal hargs[12];\n"
    buf = buf + "    for (int i = 0; i < nargs; i++) {\n"
    buf = buf + "        hargs[i] = hexa_host_ffi_unwrap(hexa_array_get(args_arr, i));\n"
    buf = buf + "    }\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    if (mask) {\n"
    buf = buf + "        return hexa_extern_call_typed(fp, hargs, nargs, rk, mask);\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_extern_call(fp, hargs, nargs, rk);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Static overflow buffer for >6 arg FFI calls.\n"
    buf = buf + "// The interpreter stores overflow args here via magic fn_ptr sentinel\n"
    buf = buf + "// values (-1, -2) before the real dispatch call.\n"
    buf = buf + "static HexaVal g_ffi_overflow[14];\n"
    buf = buf + "\n"
    buf = buf + "// hexa_host_ffi_call_6(fn_ptr, nargs, float_mask, ret_kind, a0, a1, a2, a3, a4, a5)\n"
    buf = buf + "//   Scalar-fanout variant used by the self-host interpreter which\n"
    buf = buf + "//   cannot pass its array_store-backed TAG_VALSTRUCT array through\n"
    buf = buf + "//   hexa_array_get. Up to 6 positional args; unused slots are TAG_VOID.\n"
    buf = buf + "//\n"
    buf = buf + "//   Extended 2026-04-16: overflow protocol for >6 args (vDSP_mmul 9, cblas_sgemm 14).\n"
    buf = buf + "//   Magic fn_ptr sentinels:\n"
    buf = buf + "//     fn_ptr == -1 : store a0..a5 into g_ffi_overflow[0..5] (args 6-11)\n"
    buf = buf + "//     fn_ptr == -2 : store a0..a1 into g_ffi_overflow[6..7] (args 12-13)\n"
    buf = buf + "//   When fn_ptr is a real pointer and nargs > 6, read g_ffi_overflow for args 6+.\n"
    buf = buf + "HexaVal hexa_host_ffi_call_6(\n"
    buf = buf + "    HexaVal fn_ptr, HexaVal nargs_v, HexaVal float_mask, HexaVal ret_kind,\n"
    buf = buf + "    HexaVal a0, HexaVal a1, HexaVal a2, HexaVal a3, HexaVal a4, HexaVal a5\n"
    buf = buf + ") {\n"
    buf = buf + "    HexaVal fp_v = hexa_host_ffi_unwrap(fn_ptr);\n"
    buf = buf + "    int64_t fp_raw = HX_IS_INT(fp_v) ? HX_INT(fp_v) : 0;\n"
    buf = buf + "\n"
    buf = buf + "    // Magic sentinel: store overflow args\n"
    buf = buf + "    if (fp_raw == -1) {\n"
    buf = buf + "        g_ffi_overflow[0] = hexa_host_ffi_unwrap(a0);\n"
    buf = buf + "        g_ffi_overflow[1] = hexa_host_ffi_unwrap(a1);\n"
    buf = buf + "        g_ffi_overflow[2] = hexa_host_ffi_unwrap(a2);\n"
    buf = buf + "        g_ffi_overflow[3] = hexa_host_ffi_unwrap(a3);\n"
    buf = buf + "        g_ffi_overflow[4] = hexa_host_ffi_unwrap(a4);\n"
    buf = buf + "        g_ffi_overflow[5] = hexa_host_ffi_unwrap(a5);\n"
    buf = buf + "        return hexa_int(0);\n"
    buf = buf + "    }\n"
    buf = buf + "    if (fp_raw == -2) {\n"
    buf = buf + "        g_ffi_overflow[6] = hexa_host_ffi_unwrap(a0);\n"
    buf = buf + "        g_ffi_overflow[7] = hexa_host_ffi_unwrap(a1);\n"
    buf = buf + "        return hexa_int(0);\n"
    buf = buf + "    }\n"
    buf = buf + "\n"
    buf = buf + "    void* fp = (fp_raw != 0) ? (void*)(uintptr_t)fp_raw : NULL;\n"
    buf = buf + "    if (!fp) return hexa_int(0);\n"
    buf = buf + "    HexaVal na_v = hexa_host_ffi_unwrap(nargs_v);\n"
    buf = buf + "    HexaVal rk_v = hexa_host_ffi_unwrap(ret_kind);\n"
    buf = buf + "    HexaVal fm_v = hexa_host_ffi_unwrap(float_mask);\n"
    buf = buf + "    int nargs = HX_IS_INT(na_v) ? (int)HX_INT(na_v) : 0;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    int rk    = HX_IS_INT(rk_v) ? (int)HX_INT(rk_v) : 1;\n"
    buf = buf + "    int mask  = HX_IS_INT(fm_v) ? (int)HX_INT(fm_v) : 0;\n"
    buf = buf + "    if (nargs < 0) nargs = 0;\n"
    buf = buf + "    if (nargs > 14) nargs = 14;\n"
    buf = buf + "\n"
    buf = buf + "    // Build hargs: first 6 from direct params, 6+ from overflow buffer\n"
    buf = buf + "    HexaVal hargs[14];\n"
    buf = buf + "    hargs[0] = hexa_host_ffi_unwrap(a0);\n"
    buf = buf + "    hargs[1] = hexa_host_ffi_unwrap(a1);\n"
    buf = buf + "    hargs[2] = hexa_host_ffi_unwrap(a2);\n"
    buf = buf + "    hargs[3] = hexa_host_ffi_unwrap(a3);\n"
    buf = buf + "    hargs[4] = hexa_host_ffi_unwrap(a4);\n"
    buf = buf + "    hargs[5] = hexa_host_ffi_unwrap(a5);\n"
    buf = buf + "    for (int i = 6; i < nargs; i++) {\n"
    buf = buf + "        hargs[i] = g_ffi_overflow[i - 6];\n"
    buf = buf + "    }\n"
    buf = buf + "\n"
    buf = buf + "    HexaVal native_ret;\n"
    buf = buf + "    if (mask) {\n"
    buf = buf + "        native_ret = hexa_extern_call_typed(fp, hargs, nargs, rk, mask);\n"
    buf = buf + "    } else {\n"
    buf = buf + "        native_ret = hexa_extern_call(fp, hargs, nargs, rk);\n"
    buf = buf + "    }\n"
    buf = buf + "    // Wrap the native HexaVal (tag=TAG_INT / TAG_FLOAT / TAG_VOID / TAG_BOOL)\n"
    buf = buf + "    // into a hexa-level Val so the self-host interpreter can .tag/.int_val\n"
    buf = buf + "    // through it. Without this the interpreter reads garbage from the\n"
    buf = buf + "    // HexaVal-as-map fallback in hexa_map_get.\n"
    buf = buf + "    int64_t iv = 0;\n"
    buf = buf + "    double  fv = 0.0;\n"
    buf = buf + "    int bv = 0;\n"
    buf = buf + "    if (HX_IS_INT(native_ret))   iv = HX_INT(native_ret);\n"
    buf = buf + "    if (HX_IS_FLOAT(native_ret)) fv = HX_FLOAT(native_ret);\n"
    buf = buf + "    if (HX_IS_BOOL(native_ret))  bv = HX_BOOL(native_ret);\n"
    buf = buf + "    // Hexa-level tag constants: INT=0, FLOAT=1, BOOL=2, VOID=8.\n"
    buf = buf + "    int hexa_tag = 0;\n"
    buf = buf + "    if (rk == 2) hexa_tag = 1;\n"
    buf = buf + "    if (rk == 3) hexa_tag = 2;\n"
    buf = buf + "    if (rk == 0) hexa_tag = 8;\n"
    buf = buf + "    HexaVal empty_str = hexa_str(\"\");\n"
    buf = buf + "    return hexa_valstruct_new_v(\n"
    buf = buf + "        hexa_int(hexa_tag), hexa_int(iv), hexa_float(fv), hexa_bool(bv),\n"
    buf = buf + "        empty_str, empty_str, empty_str,\n"
    buf = buf + "        empty_str, empty_str, empty_str,\n"
    buf = buf + "        empty_str, empty_str);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ── G5: Pointer arithmetic builtins ─────────────────────\n"
    buf = buf + "\n"
    buf = buf + "/* @hot_kernel f32/f64/i32 ptr read/write — extracted to tensor_kernels.c\n"
    buf = buf + " * (included at end of this file). hexa_ptr_read (untyped 64-bit) kept here\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + " * as general-purpose. */\n"
    buf = buf + "\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════\n"
    buf = buf + "//  G2: Struct Value Passing — struct packing builtins\n"
    buf = buf + "//  Allows constructing C structs in heap memory for FFI.\n"
    buf = buf + "//  struct_pack(v0, v1, ...) — N*8 bytes of f64 values\n"
    buf = buf + "//  struct_pack_f32(v0, ...) — N*4 bytes of f32 values\n"
    buf = buf + "//  struct_unpack(ptr, idx) — read Nth f64 from packed struct\n"
    buf = buf + "//  struct_unpack_f32(ptr, idx) — read Nth f32\n"
    buf = buf + "//  struct_rect/point/size — Cocoa geometry helpers\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════\n"
    buf = buf + "\n"
    buf = buf + "// Pack N f64 values into a newly allocated buffer. Returns pointer as int.\n"
    buf = buf + "HexaVal hexa_struct_pack(HexaVal* args, int nargs) {\n"
    buf = buf + "    if (nargs <= 0) return hexa_int(0);\n"
    buf = buf + "    size_t total = (size_t)nargs * sizeof(double);\n"
    buf = buf + "    double* buf = (double*)calloc(1, total);\n"
    buf = buf + "    for (int i = 0; i < nargs; i++) {\n"
    buf = buf + "        buf[i] = HX_IS_FLOAT(args[i]) ? HX_FLOAT(args[i]) : (double)HX_INT(args[i]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int((int64_t)(uintptr_t)buf);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* @hot_kernel hexa_struct_pack_f32 / hexa_struct_unpack_f32 extracted to\n"
    buf = buf + " * tensor_kernels.c (see include at end of this file). */\n"
    buf = buf + "\n"
    buf = buf + "// Read the Nth f64 from a struct pointer.\n"
    buf = buf + "HexaVal hexa_struct_unpack(HexaVal ptr, HexaVal index) {\n"
    buf = buf + "    uint64_t p = HX_IS_INT(ptr) ? HX_INT_U(ptr) : 0;\n"
    buf = buf + "    int64_t idx = HX_IS_INT(index) ? HX_INT(index) : 0;\n"
    buf = buf + "    if (p == 0) return hexa_float(0.0);\n"
    buf = buf + "    double* buf = (double*)(uintptr_t)p;\n"
    buf = buf + "    return hexa_float(buf[idx]);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Convenience: pack an NSRect (4x f64 = 32 bytes).\n"
    buf = buf + "HexaVal hexa_struct_rect(HexaVal x, HexaVal y, HexaVal w, HexaVal h) {\n"
    buf = buf + "    double* buf = (double*)calloc(1, 4 * sizeof(double));\n"
    buf = buf + "    buf[0] = HX_IS_FLOAT(x) ? HX_FLOAT(x) : (double)HX_INT(x);\n"
    buf = buf + "    buf[1] = HX_IS_FLOAT(y) ? HX_FLOAT(y) : (double)HX_INT(y);\n"
    buf = buf + "    buf[2] = HX_IS_FLOAT(w) ? HX_FLOAT(w) : (double)HX_INT(w);\n"
    buf = buf + "    buf[3] = HX_IS_FLOAT(h) ? HX_FLOAT(h) : (double)HX_INT(h);\n"
    buf = buf + "    return hexa_int((int64_t)(uintptr_t)buf);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Convenience: pack an NSPoint (2x f64 = 16 bytes).\n"
    buf = buf + "HexaVal hexa_struct_point(HexaVal x, HexaVal y) {\n"
    buf = buf + "    double* buf = (double*)calloc(1, 2 * sizeof(double));\n"
    buf = buf + "    buf[0] = HX_IS_FLOAT(x) ? HX_FLOAT(x) : (double)HX_INT(x);\n"
    buf = buf + "    buf[1] = HX_IS_FLOAT(y) ? HX_FLOAT(y) : (double)HX_INT(y);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    return hexa_int((int64_t)(uintptr_t)buf);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Convenience: pack an NSSize (2x f64 = 16 bytes).\n"
    buf = buf + "HexaVal hexa_struct_size_pack(HexaVal w, HexaVal h) {\n"
    buf = buf + "    double* buf = (double*)calloc(1, 2 * sizeof(double));\n"
    buf = buf + "    buf[0] = HX_IS_FLOAT(w) ? HX_FLOAT(w) : (double)HX_INT(w);\n"
    buf = buf + "    buf[1] = HX_IS_FLOAT(h) ? HX_FLOAT(h) : (double)HX_INT(h);\n"
    buf = buf + "    return hexa_int((int64_t)(uintptr_t)buf);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Free a struct pointer (allocated by struct_pack/struct_rect/etc).\n"
    buf = buf + "HexaVal hexa_struct_free(HexaVal ptr) {\n"
    buf = buf + "    uint64_t p = HX_IS_INT(ptr) ? HX_INT_U(ptr) : 0;\n"
    buf = buf + "    if (p != 0) free((void*)(uintptr_t)p);\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════\n"
    buf = buf + "//  G4: Callback Trampoline Pool\n"
    buf = buf + "//  Provides C function pointers that dispatch back into hexa.\n"
    buf = buf + "//  16 pre-allocated slots — sufficient for Cocoa delegates,\n"
    buf = buf + "//  menu actions, timers, qsort comparators, etc.\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════\n"
    buf = buf + "\n"
    buf = buf + "#define HEXA_TRAMPOLINE_POOL_SIZE 16\n"
    buf = buf + "\n"
    buf = buf + "// Callback entry: stores a HexaVal function reference (TAG_FN)\n"
    buf = buf + "// and metadata for the dispatch.\n"
    buf = buf + "typedef struct {\n"
    buf = buf + "    int in_use;\n"
    buf = buf + "    HexaVal hexa_fn;        // The hexa function value (TAG_FN)\n"
    buf = buf + "    void* fn_ptr;           // The C trampoline pointer for this slot\n"
    buf = buf + "    int expected_argc;      // How many C args the trampoline receives\n"
    buf = buf + "} HexaCallbackSlot;\n"
    buf = buf + "\n"
    buf = buf + "static HexaCallbackSlot __hexa_cb_slots[HEXA_TRAMPOLINE_POOL_SIZE];\n"
    buf = buf + "\n"
    buf = buf + "// User-supplied dispatch hook: the interpreter or compiled code sets this.\n"
    buf = buf + "// Signature: dispatch(slot_id, argc, args[]) -> HexaVal\n"
    buf = buf + "// For compiled code, this is wired at link time.\n"
    buf = buf + "// For interpreter, the interpreter sets this to its own dispatcher.\n"
    buf = buf + "typedef HexaVal (*hexa_cb_dispatch_fn)(int slot_id, int argc, int64_t* args);\n"
    buf = buf + "static hexa_cb_dispatch_fn __hexa_cb_dispatcher = NULL;\n"
    buf = buf + "\n"
    buf = buf + "// Internal dispatch: called by every trampoline.\n"
    buf = buf + "// Converts raw C int64 args back to HexaVal and calls the registered function.\n"
    buf = buf + "static int64_t hexa_trampoline_dispatch(int slot_id, int argc, int64_t* args) {\n"
    buf = buf + "    if (slot_id < 0 || slot_id >= HEXA_TRAMPOLINE_POOL_SIZE) return 0;\n"
    buf = buf + "    if (!__hexa_cb_slots[slot_id].in_use) return 0;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "\n"
    buf = buf + "    // If a custom dispatcher is set (e.g. interpreter), use it\n"
    buf = buf + "    if (__hexa_cb_dispatcher) {\n"
    buf = buf + "        HexaVal result = __hexa_cb_dispatcher(slot_id, argc, args);\n"
    buf = buf + "        if (HX_IS_INT(result)) return HX_INT(result);\n"
    buf = buf + "        if (HX_IS_FLOAT(result)) { union { double d; int64_t i; } u; u.d = HX_FLOAT(result); return u.i; }\n"
    buf = buf + "        return 0;\n"
    buf = buf + "    }\n"
    buf = buf + "\n"
    buf = buf + "    // For compiled code: call the fn_ptr stored in the slot directly.\n"
    buf = buf + "    // Compiled hexa functions take HexaVal args and return HexaVal.\n"
    buf = buf + "    // We wrap each raw int64 arg as hexa_int() before calling.\n"
    buf = buf + "    HexaCallbackSlot* slot = &__hexa_cb_slots[slot_id];\n"
    buf = buf + "    if (HX_IS_FN(slot->hexa_fn) && HX_FN_PTR(slot->hexa_fn)) {\n"
    buf = buf + "        typedef HexaVal (*HFn0)(void);\n"
    buf = buf + "        typedef HexaVal (*HFn1)(HexaVal);\n"
    buf = buf + "        typedef HexaVal (*HFn2)(HexaVal, HexaVal);\n"
    buf = buf + "        typedef HexaVal (*HFn3)(HexaVal, HexaVal, HexaVal);\n"
    buf = buf + "        typedef HexaVal (*HFn4)(HexaVal, HexaVal, HexaVal, HexaVal);\n"
    buf = buf + "        void* fp = HX_FN_PTR(slot->hexa_fn);\n"
    buf = buf + "        HexaVal result;\n"
    buf = buf + "        switch (argc) {\n"
    buf = buf + "            case 0: result = ((HFn0)fp)(); break;\n"
    buf = buf + "            case 1: result = ((HFn1)fp)(hexa_int(args[0])); break;\n"
    buf = buf + "            case 2: result = ((HFn2)fp)(hexa_int(args[0]), hexa_int(args[1])); break;\n"
    buf = buf + "            case 3: result = ((HFn3)fp)(hexa_int(args[0]), hexa_int(args[1]), hexa_int(args[2])); break;\n"
    buf = buf + "            default: result = ((HFn4)fp)(hexa_int(args[0]), hexa_int(args[1]), hexa_int(args[2]), hexa_int(args[3])); break;\n"
    buf = buf + "        }\n"
    buf = buf + "        if (HX_IS_INT(result)) return HX_INT(result);\n"
    buf = buf + "        if (HX_IS_FLOAT(result)) { union { double d; int64_t i; } u; u.d = HX_FLOAT(result); return u.i; }\n"
    buf = buf + "        return 0;\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ── 16 static trampoline functions ──────────────────────\n"
    buf = buf + "// Each takes up to 4 int64_t args (covers qsort comparator, ObjC IMP,\n"
    buf = buf + "// NSTimer callback, etc.). Extra args beyond 4 are passed as 0.\n"
    buf = buf + "// For Cocoa IMP: (id self, SEL _cmd, ...) = 2-3 pointer-sized args.\n"
    buf = buf + "\n"
    buf = buf + "#define TRAMP_DEF(N) \\\n"
    buf = buf + "static int64_t _hexa_tramp_##N(int64_t a0, int64_t a1, int64_t a2, int64_t a3) { \\\n"
    buf = buf + "    int64_t args[4] = {a0, a1, a2, a3}; \\\n"
    buf = buf + "    return hexa_trampoline_dispatch(N, 4, args); \\\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "TRAMP_DEF(0)  TRAMP_DEF(1)  TRAMP_DEF(2)  TRAMP_DEF(3)\n"
    buf = buf + "TRAMP_DEF(4)  TRAMP_DEF(5)  TRAMP_DEF(6)  TRAMP_DEF(7)\n"
    buf = buf + "TRAMP_DEF(8)  TRAMP_DEF(9)  TRAMP_DEF(10) TRAMP_DEF(11)\n"
    buf = buf + "TRAMP_DEF(12) TRAMP_DEF(13) TRAMP_DEF(14) TRAMP_DEF(15)\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "\n"
    buf = buf + "typedef int64_t (*tramp_fn_t)(int64_t, int64_t, int64_t, int64_t);\n"
    buf = buf + "\n"
    buf = buf + "static tramp_fn_t __hexa_tramp_table[HEXA_TRAMPOLINE_POOL_SIZE] = {\n"
    buf = buf + "    _hexa_tramp_0,  _hexa_tramp_1,  _hexa_tramp_2,  _hexa_tramp_3,\n"
    buf = buf + "    _hexa_tramp_4,  _hexa_tramp_5,  _hexa_tramp_6,  _hexa_tramp_7,\n"
    buf = buf + "    _hexa_tramp_8,  _hexa_tramp_9,  _hexa_tramp_10, _hexa_tramp_11,\n"
    buf = buf + "    _hexa_tramp_12, _hexa_tramp_13, _hexa_tramp_14, _hexa_tramp_15\n"
    buf = buf + "};\n"
    buf = buf + "\n"
    buf = buf + "// Initialize trampoline pool (call once at startup)\n"
    buf = buf + "static void hexa_trampoline_init(void) {\n"
    buf = buf + "    for (int i = 0; i < HEXA_TRAMPOLINE_POOL_SIZE; i++) {\n"
    buf = buf + "        __hexa_cb_slots[i].in_use = 0;\n"
    buf = buf + "        __hexa_cb_slots[i].fn_ptr = (void*)__hexa_tramp_table[i];\n"
    buf = buf + "        __hexa_cb_slots[i].hexa_fn = hexa_void();\n"
    buf = buf + "        __hexa_cb_slots[i].expected_argc = 0;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ── Public API ──────────────────────────────────────────\n"
    buf = buf + "\n"
    buf = buf + "// callback_create(hexa_fn_val) -> int (C function pointer as integer)\n"
    buf = buf + "// Allocates a trampoline slot and returns the C function pointer.\n"
    buf = buf + "HexaVal hexa_callback_create(HexaVal fn_val) {\n"
    buf = buf + "    // Lazy init\n"
    buf = buf + "    static int inited = 0;\n"
    buf = buf + "    if (!inited) { hexa_trampoline_init(); inited = 1; }\n"
    buf = buf + "\n"
    buf = buf + "    for (int i = 0; i < HEXA_TRAMPOLINE_POOL_SIZE; i++) {\n"
    buf = buf + "        if (!__hexa_cb_slots[i].in_use) {\n"
    buf = buf + "            __hexa_cb_slots[i].in_use = 1;\n"
    buf = buf + "            __hexa_cb_slots[i].hexa_fn = fn_val;\n"
    buf = buf + "            return hexa_int((int64_t)(uintptr_t)__hexa_cb_slots[i].fn_ptr);\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    fprintf(stderr, \"[hexa-callback] trampoline pool exhausted (%d slots)\\n\",\n"
    buf = buf + "            HEXA_TRAMPOLINE_POOL_SIZE);\n"
    buf = buf + "    return hexa_int(0);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// fn_new_native(fn_ptr, arity) -> TAG_FN HexaVal — LINKABLE (global) wrapper\n"
    buf = buf + "// around the `static inline hexa_fn_new` in runtime.h. The native backend\n"
    buf = buf + "// (compiler/codegen/*.hexa op=\"fn_ref\") emits a `call hexa_fn_new_native`\n"
    buf = buf + "// to box a bare top-level-fn ident used in value position (e.g.\n"
    buf = buf + "// `thread_spawn(worker, 1)`). The inline `hexa_fn_new` resolves inside the\n"
    buf = buf + "// single-TU C-transpile build, but a separately-emitted native .o needs a\n"
    buf = buf + "// real linkable symbol (the inline is `t`, not `T`) — mirrors how\n"
    buf = buf + "// hexa_closure_new is a global `T` for op=\"closure_new\". TAG_FN (no env\n"
    buf = buf + "// prepend in hexa_call1_hv) — correct for a plain fn vs a lifted lambda.\n"
    buf = buf + "// Additive global; byteeq-neutral (no existing emit references it).\n"
    buf = buf + "HexaVal hexa_fn_new_native(void* fn_ptr, int arity) {\n"
    buf = buf + "    return hexa_fn_new(fn_ptr, arity);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// callN_native(f, args…) -> LINKABLE (global) wrappers around the\n"
    buf = buf + "// `static inline hexa_callN_hv` dispatchers in runtime.h. The native backend\n"
    buf = buf + "// (compiler/codegen/*.hexa op=\"carrier_call\") emits a call to one of these\n"
    buf = buf + "// to invoke a RUNTIME TAG_FN/TAG_CLOSURE CARRIER global (e.g. thread_spawn,\n"
    buf = buf + "// thread_join, thread_channel_*, atomic_cell_*, now_ms — the\n"
    buf = buf + "// _hexa_init_thread_fn_shims carriers): `thread_spawn(worker, 1)` →\n"
    buf = buf + "// hexa_call2_native(thread_spawn, <fn-value>, 1). The carrier is a\n"
    buf = buf + "// `HexaVal <name>;` DATA global, NOT a C function, so a direct `call <name>`\n"
    buf = buf + "// (the default named-call lowering) jumps into BSS data → SIGSEGV. These\n"
    buf = buf + "// wrappers route through the proper hexa_callN_hv dispatch (handles both\n"
    buf = buf + "// TAG_FN — fp(a…) — and TAG_CLOSURE — fp(env, a…)). The inline dispatchers\n"
    buf = buf + "// resolve in the single-TU C-transpile build; a separately-emitted native\n"
    buf = buf + "// .o needs these real linkable `T` symbols. Additive globals; byteeq-neutral.\n"
    buf = buf + "HexaVal hexa_call0_native(HexaVal f) { return hexa_call0(f); }\n"
    buf = buf + "HexaVal hexa_call1_native(HexaVal f, HexaVal a1) { return hexa_call1_hv(f, a1); }\n"
    buf = buf + "HexaVal hexa_call2_native(HexaVal f, HexaVal a1, HexaVal a2) { return hexa_call2_hv(f, a1, a2); }\n"
    buf = buf + "HexaVal hexa_call3_native(HexaVal f, HexaVal a1, HexaVal a2, HexaVal a3) { return hexa_call3(f, a1, a2, a3); }\n"
    buf = buf + "HexaVal hexa_call4_native(HexaVal f, HexaVal a1, HexaVal a2, HexaVal a3, HexaVal a4) { return hexa_call4(f, a1, a2, a3, a4); }\n"
    buf = buf + "\n"
    buf = buf + "// callback_free(ptr) -> void\n"
    buf = buf + "// Frees the trampoline slot associated with the given C function pointer.\n"
    buf = buf + "HexaVal hexa_callback_free(HexaVal ptr) {\n"
    buf = buf + "    uint64_t p = HX_IS_INT(ptr) ? HX_INT_U(ptr) : 0;\n"
    buf = buf + "    for (int i = 0; i < HEXA_TRAMPOLINE_POOL_SIZE; i++) {\n"
    buf = buf + "        if ((uint64_t)(uintptr_t)__hexa_cb_slots[i].fn_ptr == p) {\n"
    buf = buf + "            __hexa_cb_slots[i].in_use = 0;\n"
    buf = buf + "            __hexa_cb_slots[i].hexa_fn = hexa_void();\n"
    buf = buf + "            return hexa_void();\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// callback_slot_id(ptr) -> int\n"
    buf = buf + "// Returns the slot index for a given trampoline pointer (-1 if not found).\n"
    buf = buf + "HexaVal hexa_callback_slot_id(HexaVal ptr) {\n"
    buf = buf + "    uint64_t p = HX_IS_INT(ptr) ? HX_INT_U(ptr) : 0;\n"
    buf = buf + "    for (int i = 0; i < HEXA_TRAMPOLINE_POOL_SIZE; i++) {\n"
    buf = buf + "        if ((uint64_t)(uintptr_t)__hexa_cb_slots[i].fn_ptr == p) {\n"
    buf = buf + "            return hexa_int(i);\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int(-1);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* @hot_kernel B4 tensor stubs extracted to tensor_kernels.c (see include\n"
    buf = buf + " * at end of this file). clock/random stay here (OS utility, not hot). */\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_clock(void) {\n"
    buf = buf + "    struct timespec ts;\n"
    buf = buf + "    hxlcl_clock_gettime(CLOCK_MONOTONIC, &ts);\n"
    buf = buf + "    return hexa_float((double)ts.tv_sec + (double)ts.tv_nsec/1e9);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_random(void) { return hexa_float(rand() / (double)RAND_MAX); }\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_char_code(HexaVal s, HexaVal idx);\n"
    buf = buf + "// Bootstrap shim (same rationale as `join` above): SSOT modules use\n"
    buf = buf + "// `char_code(s, i)` free-fn idiom which old hexat emits as\n"
    buf = buf + "// `hexa_call2(char_code, ...)`. Shim binds the bare identifier to TAG_FN.\n"
    buf = buf + "static HexaVal char_code;\n"
    buf = buf + "// Step-3 cycle 72 port — hexa_char_code dispatch.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_char_code(HexaVal s, HexaVal idx) {\n"
    buf = buf + "    if (!HX_IS_STR(s)) return hexa_int(0);\n"
    buf = buf + "    int i = HX_INT(idx);\n"
    buf = buf + "    if (i < 0 || i >= (int)HX_STRLEN(s)) return hexa_int(0);\n"
    buf = buf + "    return hexa_int((unsigned char)HX_STR(s)[i]);\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_char_code(HexaVal s, HexaVal idx);\n"
    buf = buf + "HexaVal hexa_char_code(HexaVal s, HexaVal idx) {\n"
    buf = buf + "    if (!HX_IS_STR(s)) return hexa_int(0);\n"
    buf = buf + "    return rt_char_code(s, idx);\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// `chr(n)` — Python/Ruby-style inverse of char_code: int byte → 1-char str.\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// Used by void's sys_pty accumulator (chr(b) reassembles bytes from\n"
    buf = buf + "// line_buf int values). Binds the free-fn idiom the way char_code does.\n"
    buf = buf + "HexaVal hexa_from_char_code(HexaVal n);\n"
    buf = buf + "static HexaVal chr;\n"
    buf = buf + "\n"
    buf = buf + "// RFC 030 (2026-05-12): bytes_to_str_raw([int]) — see implementation\n"
    buf = buf + "// below near hexa_from_char_code. Declared here so it's reachable as\n"
    buf = buf + "// a bare C identifier from `hexa_call1(bytes_to_str_raw, arr)` emitted\n"
    buf = buf + "// by precompiled hexat (which doesn't have the codegen entry yet).\n"
    buf = buf + "HexaVal hexa_bytes_to_str_raw(HexaVal arr);\n"
    buf = buf + "static HexaVal bytes_to_str_raw;\n"
    buf = buf + "\n"
    buf = buf + "// 2026-05-12 (RFC 030 sibling fix): farr_* primitive shims. The\n"
    buf = buf + "// codegen.hexa entries route `farr_zeros / get / set / len / free`\n"
    buf = buf + "// to their hexa_farr_* C impls (added recently), but the currently\n"
    buf = buf + "// shipped hexat binary predates those entries, so transpiles of the\n"
    buf = buf + "// interpreter dispatch handlers (hexa_full.hexa:~10700) emit bare\n"
    buf = buf + "// `hexa_call1(farr_zeros, ...)` lookups against undeclared symbols.\n"
    buf = buf + "// Declare the static carriers so the resulting C compiles;\n"
    buf = buf + "// _hexa_init_fn_shims wires fn_ptr to the hexa_farr_* impl below.\n"
    buf = buf + "HexaVal hexa_farr_zeros(HexaVal n_v);\n"
    buf = buf + "HexaVal hexa_farr_get(HexaVal h_v, HexaVal i_v);\n"
    buf = buf + "HexaVal hexa_farr_set(HexaVal h_v, HexaVal i_v, HexaVal x_v);\n"
    buf = buf + "HexaVal hexa_farr_len(HexaVal h_v);\n"
    buf = buf + "HexaVal hexa_farr_free(HexaVal h_v);\n"
    buf = buf + "static HexaVal farr_zeros;\n"
    buf = buf + "static HexaVal farr_get;\n"
    buf = buf + "static HexaVal farr_set;\n"
    buf = buf + "static HexaVal farr_len;\n"
    buf = buf + "static HexaVal farr_free;\n"
    buf = buf + "\n"
    buf = buf + "// RFC 036 (2026-05-13): farr_int_array — packed int64_t* handle table.\n"
    buf = buf + "// Same shape as RFC 030 farr (packed double[]), but for int64_t storage.\n"
    buf = buf + "// Motivation: replaces `[int]` mask tables (ham_flip, ham_z, ham_y, ham_cy,\n"
    buf = buf + "// exc_flip, exc_z, exc_y, exc_cy, exc_param_idx) in qmirror chemistry_vqe\n"
    buf = buf + "// hot loops. At 4e/6o (10 qubits, ~2-3k Pauli terms) the boxed-HexaVal\n"
    buf = buf + "// retention from these arrays binds the in-process NM optimizer at the\n"
    buf = buf + "// 768 MB cap. Packed int64_t cuts arena retention by ~50× and removes\n"
    buf = buf + "// the HEXA_MEM_CAP_MB=2048 workaround for 4e/6o.\n"
    buf = buf + "HexaVal hexa_farr_int_zeros(HexaVal n_v);\n"
    buf = buf + "HexaVal hexa_farr_int_get(HexaVal h_v, HexaVal i_v);\n"
    buf = buf + "HexaVal hexa_farr_int_set(HexaVal h_v, HexaVal i_v, HexaVal x_v);\n"
    buf = buf + "HexaVal hexa_farr_int_len(HexaVal h_v);\n"
    buf = buf + "HexaVal hexa_farr_int_fill_from_array(HexaVal h_v, HexaVal arr_v);\n"
    buf = buf + "HexaVal hexa_farr_int_copy(HexaVal src_v);\n"
    buf = buf + "HexaVal hexa_farr_int_sum(HexaVal h_v);\n"
    buf = buf + "HexaVal hexa_farr_int_free(HexaVal h_v);\n"
    buf = buf + "static HexaVal farr_int_zeros;\n"
    buf = buf + "static HexaVal farr_int_get;\n"
    buf = buf + "static HexaVal farr_int_set;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "static HexaVal farr_int_len;\n"
    buf = buf + "static HexaVal farr_int_fill_from_array;\n"
    buf = buf + "static HexaVal farr_int_copy;\n"
    buf = buf + "static HexaVal farr_int_sum;\n"
    buf = buf + "static HexaVal farr_int_free;\n"
    buf = buf + "\n"
    buf = buf + "// RFC 025 (2026-05-12): safetensors mmap-backed zero-copy load shims.\n"
    buf = buf + "// Mirror the farr_* pattern: bare static carriers so transpiled C\n"
    buf = buf + "// resolves `hexa_call*(safetensors_mmap_*, ...)` to direct calls into\n"
    buf = buf + "// the hexa_safetensors_mmap_* impls below. fn_shim registration in\n"
    buf = buf + "// _hexa_init_fn_shims; AOT codegen entries in codegen.hexa.\n"
    buf = buf + "HexaVal hexa_safetensors_mmap_open(HexaVal path_v);\n"
    buf = buf + "HexaVal hexa_safetensors_mmap_header(HexaVal h_v);\n"
    buf = buf + "HexaVal hexa_safetensors_mmap_data_offset(HexaVal h_v);\n"
    buf = buf + "HexaVal hexa_safetensors_mmap_size(HexaVal h_v);\n"
    buf = buf + "HexaVal hexa_safetensors_mmap_read_f32_farr(HexaVal h_v, HexaVal off_v, HexaVal n_v);\n"
    buf = buf + "HexaVal hexa_safetensors_mmap_read_bf16_to_f32_farr(HexaVal h_v, HexaVal off_v, HexaVal n_v);\n"
    buf = buf + "HexaVal hexa_safetensors_mmap_read_bytes(HexaVal h_v, HexaVal off_v, HexaVal n_v);\n"
    buf = buf + "HexaVal hexa_safetensors_mmap_close(HexaVal h_v);\n"
    buf = buf + "static HexaVal safetensors_mmap_open;\n"
    buf = buf + "static HexaVal safetensors_mmap_header;\n"
    buf = buf + "static HexaVal safetensors_mmap_data_offset;\n"
    buf = buf + "static HexaVal safetensors_mmap_size;\n"
    buf = buf + "static HexaVal safetensors_mmap_read_f32_farr;\n"
    buf = buf + "static HexaVal safetensors_mmap_read_bf16_to_f32_farr;\n"
    buf = buf + "static HexaVal safetensors_mmap_read_bytes;\n"
    buf = buf + "static HexaVal safetensors_mmap_close;\n"
    buf = buf + "// RFC 032 (2026-05-12): farr_matmul — packed-double matrix multiply.\n"
    buf = buf + "HexaVal hexa_farr_matmul(HexaVal a_v, HexaVal ar_v, HexaVal ac_v,\n"
    buf = buf + "                         HexaVal b_v, HexaVal bc_v);\n"
    buf = buf + "static HexaVal farr_matmul_shim;\n"
    buf = buf + "// METAL_INTEGRATION.md step 3 of 5 (2026-05-21): HX_FARR32 — packed-float\n"
    buf = buf + "// farr table. Parallel to the FP64 _hx_farr_table above, but with float*\n"
    buf = buf + "// storage so the HEXA_METAL MPS shim (step 2, runtime_metal.m) can accept\n"
    buf = buf + "// the matmul operands without an FP64→FP32 down-cast at the dispatch\n"
    buf = buf + "// boundary. The two tables share NO state: handles are independent\n"
    buf = buf + "// namespaces (a farr32_id is meaningless to hexa_farr_*, and vice versa).\n"
    buf = buf + "// This is gap #1 of METAL_INTEGRATION.md: native FP32 storage path.\n"
    buf = buf + "HexaVal hexa_farr32_zeros(HexaVal n_v);\n"
    buf = buf + "HexaVal hexa_farr32_get(HexaVal h_v, HexaVal i_v);\n"
    buf = buf + "HexaVal hexa_farr32_set(HexaVal h_v, HexaVal i_v, HexaVal x_v);\n"
    buf = buf + "HexaVal hexa_farr32_len(HexaVal h_v);\n"
    buf = buf + "HexaVal hexa_farr32_free(HexaVal h_v);\n"
    buf = buf + "HexaVal hexa_farr32_matmul(HexaVal a_v, HexaVal ar_v, HexaVal ac_v,\n"
    buf = buf + "                           HexaVal b_v, HexaVal bc_v);\n"
    buf = buf + "// METAL_INTEGRATION.md step 4 of 5 (2026-05-21): farr32_matmul_NT_b —\n"
    buf = buf + "// FP32 SGEMM with B transposed (right operand). For ag_linear bwd via\n"
    buf = buf + "// matmul_bwd_auto (stdlib/flame/ag_tape.hexa:630): gradient input is\n"
    buf = buf + "// dC of shape M×N and weight is N×K row-major (same memory layout as\n"
    buf = buf + "// the forward weight); the bwd-wrt-input gradient is dC · W = M×K\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// computed as C[i,k] = sum_j dC[i,j] * W[j,k] which when expressed in\n"
    buf = buf + "// matmul-NT form (B^T = W viewed transposed) is exactly A · B^T with\n"
    buf = buf + "// A=dC (M×N), B=W (N×K row-major contiguous). Routed through MPS with\n"
    buf = buf + "// transposeRight:YES when HEXA_METAL=1 + large shape; CPU SGEMM ikj\n"
    buf = buf + "// otherwise (same fallback shape as the no-transpose variant).\n"
    buf = buf + "HexaVal hexa_farr32_matmul_NT_b(HexaVal a_v, HexaVal ar_v, HexaVal ac_v,\n"
    buf = buf + "                                HexaVal b_v, HexaVal br_v);\n"
    buf = buf + "// METAL_INTEGRATION.md step 5 of 5 (2026-05-21): farr32_matmul_NT_a —\n"
    buf = buf + "// FP32 SGEMM with A transposed (left operand). For ag_linear bwd via\n"
    buf = buf + "// matmul_bwd_auto (stdlib/flame/ag_tape.hexa): bwd-wrt-weight gradient\n"
    buf = buf + "// is dW = X^T · dY where X is M×K row-major and dY is M×N row-major.\n"
    buf = buf + "// In matmul-NT form (A^T = X viewed transposed), this is exactly A^T · B\n"
    buf = buf + "// with A=X (M×K row-major contiguous, treated as K×M transposed), B=dY\n"
    buf = buf + "// (M×N row-major). The result C is K×N row-major. Routed through MPS\n"
    buf = buf + "// with transposeLeft:YES when HEXA_METAL=1 + large shape; CPU SGEMM ikj\n"
    buf = buf + "// otherwise. Symmetric to NT_b — together NT_a + NT_b close the full\n"
    buf = buf + "// transposed-matmul family needed for ag_linear backward.\n"
    buf = buf + "HexaVal hexa_farr32_matmul_NT_a(HexaVal a_v, HexaVal ar_v, HexaVal ac_v,\n"
    buf = buf + "                                HexaVal b_v, HexaVal bc_v);\n"
    buf = buf + "static HexaVal farr32_zeros;\n"
    buf = buf + "static HexaVal farr32_get;\n"
    buf = buf + "static HexaVal farr32_set;\n"
    buf = buf + "static HexaVal farr32_len;\n"
    buf = buf + "static HexaVal farr32_free;\n"
    buf = buf + "static HexaVal farr32_matmul_shim;\n"
    buf = buf + "static HexaVal farr32_matmul_NT_b_shim;\n"
    buf = buf + "static HexaVal farr32_matmul_NT_a_shim;\n"
    buf = buf + "// hexat (bootstrap transpiler) emits direct C calls for ≥5 args\n"
    buf = buf + "// (no `hexa_callN` indirection exists past N=4). The dispatch in\n"
    buf = buf + "// hexa_full.hexa::call_builtin uses `farr_matmul(...)` literally —\n"
    buf = buf + "// provide an inline wrapper so that compiles to a single jump.\n"
    buf = buf + "HexaVal hexa_farr_apply_single_farr(HexaVal re_v, HexaVal im_v,\n"
    buf = buf + "                                    HexaVal gre_h, HexaVal gim_h,\n"
    buf = buf + "                                    HexaVal target_v, HexaVal nq_v);\n"
    buf = buf + "HexaVal hexa_farr_apply_cnot(HexaVal src_re_v, HexaVal src_im_v,\n"
    buf = buf + "                             HexaVal dst_re_v, HexaVal dst_im_v,\n"
    buf = buf + "                             HexaVal control_v, HexaVal target_v,\n"
    buf = buf + "                             HexaVal nq_v);\n"
    buf = buf + "static inline HexaVal farr_matmul(HexaVal a, HexaVal ar, HexaVal ac,\n"
    buf = buf + "                                  HexaVal b, HexaVal bc) {\n"
    buf = buf + "    return hexa_farr_matmul(a, ar, ac, b, bc);\n"
    buf = buf + "}\n"
    buf = buf + "// RFC 050 L1 slice 1 — bare-wrapper seam for the forge dispatcher.\n"
    buf = buf + "// codegen.hexa registers `forge_dispatch_matmul` as a 5-arg builtin\n"
    buf = buf + "// lowering to hexa_forge_dispatch_matmul, but the deployed hexat\n"
    buf = buf + "// bootstrap (not yet rebuilt from that SSOT codegen) emits the bare\n"
    buf = buf + "// `forge_dispatch_matmul(...)` call literally — same ≥5-arg direct-C\n"
    buf = buf + "// path as farr_matmul above. The generated user.c TU only #includes\n"
    buf = buf + "// runtime.h, so this is an extern (non-static) definition paired with a\n"
    buf = buf + "// runtime.h prototype, the same runtime.h-split seam the farr ABI uses.\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
