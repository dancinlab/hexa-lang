    buf = buf + "#if (defined(__arm64__) || defined(__aarch64__)) && defined(__APPLE__)\n"
    buf = buf + "    return (int)_hxlcl_syscall3_cf(HXLCL_SYS_CONNECT, (long)s, (long)addr, (long)len);\n"
