    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + "// mk2-closure port (rfc043-flame-camp e030fa31 et al, 2026-05-19):\n"
    buf = buf + "//   - mk2-C2 _hx_farr_rmsnorm_mh_cpu + dt_sqrt mirror\n"
    buf = buf + "//   - mk2-C4 _hx_farr_attn_dt_fwd_cpu + _hx_farr_attn_dt_bwd_cpu\n"
    buf = buf + "//   - mk2-C5 batch slice/transpose/zero/add-inplace/fill_dt_lcg CPU mirrors\n"
    buf = buf + "//   - Dispatchers: rmsnorm_mh, attn_dt_fwd/bwd, zero_slice, add_inplace,\n"
    buf = buf + "//     fill_dt_lcg, copy_slice, transpose_2d — bare or 3-arg HexaVal carriers.\n"
    buf = buf + "//   - All HEXA_CUDA-gated: no-CUDA build uses CPU helpers byte-eq with\n"
    buf = buf + "//     ag_tape.hexa host loops. FP_CONTRACT OFF (proven recipe — see\n"
    buf = buf + "//     c0789e05 RoPE FMA, e5faa8b0 silu_gate dt_exp).\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + "#pragma STDC FP_CONTRACT OFF\n"
    buf = buf + "// mk2-C2 (2026-05-19): dt_sqrt byte-exact C mirror of hexa flame_math\n"
    buf = buf + "// `dt_sqrt` (24-iter Newton, g0 = max(x, 1.0)). The decoder-block\n"
    buf = buf + "// rmsnorm reference uses dt_sqrt, NOT libm sqrt — same hazard as\n"
    buf = buf + "// dt_exp ([[flame-transcendental-byteeq-hazard]]). All ops single-\n"
    buf = buf + "// rounding sequential; FP_CONTRACT OFF scope (this block) is the\n"
    buf = buf + "// proven recipe (see commits c0789e05 RoPE FMA, e5faa8b0 silu_gate\n"
    buf = buf + "// dt_exp).\n"
    buf = buf + "static double _hx_dt_sqrt_d(double x) {\n"
    buf = buf + "    if (x <= 0.0) return 0.0;\n"
    buf = buf + "    double g = x > 1.0 ? x : 1.0;\n"
    buf = buf + "    int i = 0;\n"
    buf = buf + "    while (i < 24) { g = 0.5 * (g + x / g); i = i + 1; }\n"
    buf = buf + "    return g;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// _hx_farr_rmsnorm_mh_cpu(x, g, y_out, xn_out, inv_out, T, d) -> 0 ok / -1 err.\n"
    buf = buf + "// Per-row (i ∈ [0..T)): ms = Σ x[i,c]² / d; iv = 1 / dt_sqrt(ms + eps);\n"
    buf = buf + "// inv[i] = iv; xn[i,c] = x[i,c]·iv; y[i,c] = g[c]·xn[i,c]. Byte-identical\n"
    buf = buf + "// to ag_tape.hexa `ag_rmsnorm_mh` host-scalar loop. eps = 1e-6.\n"
    buf = buf + "static int _hx_farr_rmsnorm_mh_cpu(int64_t x_id, int64_t g_id,\n"
    buf = buf + "                                   int64_t y_id, int64_t xn_id,\n"
    buf = buf + "                                   int64_t inv_id, int64_t T, int64_t d) {\n"
    buf = buf + "    if (x_id < 0 || x_id >= _hx_farr_count)     return -1;\n"
    buf = buf + "    if (g_id < 0 || g_id >= _hx_farr_count)     return -1;\n"
    buf = buf + "    if (y_id < 0 || y_id >= _hx_farr_count)     return -1;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    if (xn_id < 0 || xn_id >= _hx_farr_count)   return -1;\n"
    buf = buf + "    if (inv_id < 0 || inv_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (T <= 0 || d <= 0)                       return -1;\n"
    buf = buf + "    HexaFarrEntry* xe  = &_hx_farr_table[x_id];\n"
    buf = buf + "    HexaFarrEntry* ge  = &_hx_farr_table[g_id];\n"
    buf = buf + "    HexaFarrEntry* ye  = &_hx_farr_table[y_id];\n"
    buf = buf + "    HexaFarrEntry* xne = &_hx_farr_table[xn_id];\n"
    buf = buf + "    HexaFarrEntry* ie  = &_hx_farr_table[inv_id];\n"
    buf = buf + "    if (!xe->buf || !ge->buf || !ye->buf || !xne->buf || !ie->buf) return -1;\n"
    buf = buf + "    if (xe->len < T*d || ge->len < d || ye->len < T*d ||\n"
    buf = buf + "        xne->len < T*d || ie->len < T)          return -1;\n"
    buf = buf + "    const double* X = xe->buf;\n"
    buf = buf + "    const double* G = ge->buf;\n"
    buf = buf + "    double* Y  = ye->buf;\n"
    buf = buf + "    double* XN = xne->buf;\n"
    buf = buf + "    double* I  = ie->buf;\n"
    buf = buf + "    const double eps = 0.000001;\n"
    buf = buf + "    for (int64_t i = 0; i < T; i++) {\n"
    buf = buf + "        double ms = 0.0;\n"
    buf = buf + "        for (int64_t c = 0; c < d; c++) {\n"
    buf = buf + "            double xv = X[i*d + c];\n"
    buf = buf + "            ms = ms + xv * xv;\n"
    buf = buf + "        }\n"
    buf = buf + "        ms = ms / (double)d;  /* byte-eq with hexa `ms / to_float(d)` */\n"
    buf = buf + "        double iv = 1.0 / _hx_dt_sqrt_d(ms + eps);\n"
    buf = buf + "        I[i] = iv;\n"
    buf = buf + "        for (int64_t c = 0; c < d; c++) {\n"
    buf = buf + "            double xni = X[i*d + c] * iv;\n"
    buf = buf + "            XN[i*d + c] = xni;\n"
    buf = buf + "            Y[i*d + c]  = G[c] * xni;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// mk2-C5 (2026-05-19): farr_copy_slice + farr_transpose_2d CPU mirrors.\n"
    buf = buf + "// Pure memcpy / memory rearrangement — no FP arithmetic, byte-eq with\n"
    buf = buf + "// host scalar t_get/t_set is automatic. Used as the no-CUDA fallback\n"
    buf = buf + "// and (when the runtime is built without -DHEXA_CUDA) as the entire\n"
    buf = buf + "// implementation.\n"
    buf = buf + "static int _hx_farr_copy_slice_cpu(int64_t src_id, int64_t soff,\n"
    buf = buf + "                                   int64_t dst_id, int64_t doff,\n"
    buf = buf + "                                   int64_t n) {\n"
    buf = buf + "    if (src_id < 0 || src_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (dst_id < 0 || dst_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (n <= 0 || soff < 0 || doff < 0) return -1;\n"
    buf = buf + "    HexaFarrEntry* se = &_hx_farr_table[src_id];\n"
    buf = buf + "    HexaFarrEntry* de = &_hx_farr_table[dst_id];\n"
    buf = buf + "    if (!se->buf || !de->buf) return -1;\n"
    buf = buf + "    if (se->len < soff + n || de->len < doff + n) return -1;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    hxlcl_memcpy(de->buf + doff, se->buf + soff, (size_t)n * sizeof(double));\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "static int _hx_farr_fill_dt_lcg_cpu(int64_t dst_id, int64_t doff, int64_t n,\n"
    buf = buf + "                                    int64_t seed, double scale) {\n"
    buf = buf + "    if (dst_id < 0 || dst_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (n <= 0 || doff < 0) return -1;\n"
    buf = buf + "    HexaFarrEntry* de = &_hx_farr_table[dst_id];\n"
    buf = buf + "    if (!de->buf || de->len < doff + n) return -1;\n"
    buf = buf + "    double* D = de->buf;\n"
    buf = buf + "    int64_t s = seed;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        s = (s * (int64_t)1103515245 + (int64_t)12345) % (int64_t)2147483648;\n"
    buf = buf + "        double rv = (double)(s % 1000) / 1000.0 - 0.5;\n"
    buf = buf + "        D[doff + i] = rv * scale;\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "static int _hx_farr_add_inplace_cpu(int64_t dst_id, int64_t src_id, int64_t n) {\n"
    buf = buf + "    if (dst_id < 0 || dst_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (src_id < 0 || src_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (n <= 0) return -1;\n"
    buf = buf + "    HexaFarrEntry* de = &_hx_farr_table[dst_id];\n"
    buf = buf + "    HexaFarrEntry* se = &_hx_farr_table[src_id];\n"
    buf = buf + "    if (!de->buf || !se->buf || de->len < n || se->len < n) return -1;\n"
    buf = buf + "    double* D = de->buf;\n"
    buf = buf + "    const double* S = se->buf;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) D[i] = D[i] + S[i];\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "static int _hx_farr_zero_slice_cpu(int64_t dst_id, int64_t doff, int64_t n) {\n"
    buf = buf + "    if (dst_id < 0 || dst_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (n <= 0 || doff < 0) return -1;\n"
    buf = buf + "    HexaFarrEntry* de = &_hx_farr_table[dst_id];\n"
    buf = buf + "    if (!de->buf || de->len < doff + n) return -1;\n"
    buf = buf + "    hxlcl_memset(de->buf + doff, 0, (size_t)n * sizeof(double));\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "static int _hx_farr_transpose_2d_cpu(int64_t src_id, int64_t soff,\n"
    buf = buf + "                                     int64_t dst_id, int64_t doff,\n"
    buf = buf + "                                     int64_t d_out, int64_t d_in) {\n"
    buf = buf + "    if (src_id < 0 || src_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (dst_id < 0 || dst_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (d_out <= 0 || d_in <= 0 || soff < 0 || doff < 0) return -1;\n"
    buf = buf + "    HexaFarrEntry* se = &_hx_farr_table[src_id];\n"
    buf = buf + "    HexaFarrEntry* de = &_hx_farr_table[dst_id];\n"
    buf = buf + "    if (!se->buf || !de->buf) return -1;\n"
    buf = buf + "    int64_t total = d_out * d_in;\n"
    buf = buf + "    if (se->len < soff + total || de->len < doff + total) return -1;\n"
    buf = buf + "    const double* S = se->buf;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    double* D = de->buf;\n"
    buf = buf + "    for (int64_t r = 0; r < d_out; r++) {\n"
    buf = buf + "        for (int64_t c = 0; c < d_in; c++) {\n"
    buf = buf + "            D[doff + c * d_out + r] = S[soff + r * d_in + c];\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// mk2-C4 (2026-05-19): GQA attention-dt fwd CPU mirror. Byte-eq with\n"
    buf = buf + "// ag_tape.hexa::_ag_attn_dt_fwd host loop (causal mask + GQA kvh =\n"
    buf = buf + "// hh/n_rep + stable softmax via dt_exp + dt_sqrt scale). Memory:\n"
    buf = buf + "// Q[T·nh·hd], K[T·nkv·hd], V[T·nkv·hd]; out P[nh·T·T] (j<L only,\n"
    buf = buf + "// j≥L stays 0 per caller's t_zeros init) and CTX[T·nh·hd]. 0/-1 rc.\n"
    buf = buf + "static int _hx_farr_attn_dt_fwd_cpu(int64_t q_id, int64_t k_id, int64_t v_id,\n"
    buf = buf + "                                    int64_t p_id, int64_t ctx_id,\n"
    buf = buf + "                                    int64_t T, int64_t nh, int64_t nkv,\n"
    buf = buf + "                                    int64_t hd) {\n"
    buf = buf + "    if (q_id < 0 || q_id >= _hx_farr_count)     return -1;\n"
    buf = buf + "    if (k_id < 0 || k_id >= _hx_farr_count)     return -1;\n"
    buf = buf + "    if (v_id < 0 || v_id >= _hx_farr_count)     return -1;\n"
    buf = buf + "    if (p_id < 0 || p_id >= _hx_farr_count)     return -1;\n"
    buf = buf + "    if (ctx_id < 0 || ctx_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (T <= 0 || nh <= 0 || nkv <= 0 || hd <= 0) return -1;\n"
    buf = buf + "    if (nh % nkv != 0) return -1;\n"
    buf = buf + "    HexaFarrEntry* qe = &_hx_farr_table[q_id];\n"
    buf = buf + "    HexaFarrEntry* ke = &_hx_farr_table[k_id];\n"
    buf = buf + "    HexaFarrEntry* ve = &_hx_farr_table[v_id];\n"
    buf = buf + "    HexaFarrEntry* pe = &_hx_farr_table[p_id];\n"
    buf = buf + "    HexaFarrEntry* ce = &_hx_farr_table[ctx_id];\n"
    buf = buf + "    if (!qe->buf || !ke->buf || !ve->buf || !pe->buf || !ce->buf) return -1;\n"
    buf = buf + "    int64_t nq = T * nh  * hd;\n"
    buf = buf + "    int64_t nk = T * nkv * hd;\n"
    buf = buf + "    int64_t np = nh * T * T;\n"
    buf = buf + "    if (qe->len < nq || ke->len < nk || ve->len < nk ||\n"
    buf = buf + "        pe->len < np || ce->len < nq) return -1;\n"
    buf = buf + "    const double* Q = qe->buf;\n"
    buf = buf + "    const double* K = ke->buf;\n"
    buf = buf + "    const double* V = ve->buf;\n"
    buf = buf + "    double* P = pe->buf;\n"
    buf = buf + "    double* C = ce->buf;\n"
    buf = buf + "    int64_t n_rep = nh / nkv;\n"
    buf = buf + "    int64_t d     = nh * hd;\n"
    buf = buf + "    double scale = 1.0 / _hx_dt_sqrt_d((double)hd);\n"
    buf = buf + "    for (int64_t hh = 0; hh < nh; hh++) {\n"
    buf = buf + "        int64_t kvh = hh / n_rep;\n"
    buf = buf + "        for (int64_t i = 0; i < T; i++) {\n"
    buf = buf + "            int64_t L = i + 1;\n"
    buf = buf + "            for (int64_t j = 0; j < L; j++) {\n"
    buf = buf + "                double dot = 0.0;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "                for (int64_t c = 0; c < hd; c++) {\n"
    buf = buf + "                    dot = dot + Q[(i*nh + hh)*hd + c]\n"
    buf = buf + "                              * K[(j*nkv + kvh)*hd + c];\n"
    buf = buf + "                }\n"
    buf = buf + "                P[(hh*T + i)*T + j] = dot * scale;\n"
    buf = buf + "            }\n"
    buf = buf + "            double mx = P[(hh*T + i)*T + 0];\n"
    buf = buf + "            for (int64_t j = 1; j < L; j++) {\n"
    buf = buf + "                double v = P[(hh*T + i)*T + j];\n"
    buf = buf + "                if (v > mx) mx = v;\n"
    buf = buf + "            }\n"
    buf = buf + "            double tot = 0.0;\n"
    buf = buf + "            for (int64_t j = 0; j < L; j++) {\n"
    buf = buf + "                double e = _hx_dt_exp_d(P[(hh*T + i)*T + j] - mx);\n"
    buf = buf + "                P[(hh*T + i)*T + j] = e;\n"
    buf = buf + "                tot = tot + e;\n"
    buf = buf + "            }\n"
    buf = buf + "            for (int64_t j = 0; j < L; j++) {\n"
    buf = buf + "                P[(hh*T + i)*T + j] = P[(hh*T + i)*T + j] / tot;\n"
    buf = buf + "            }\n"
    buf = buf + "            for (int64_t c2 = 0; c2 < hd; c2++) {\n"
    buf = buf + "                double acc = 0.0;\n"
    buf = buf + "                for (int64_t j = 0; j < L; j++) {\n"
    buf = buf + "                    acc = acc + P[(hh*T + i)*T + j]\n"
    buf = buf + "                              * V[(j*nkv + kvh)*hd + c2];\n"
    buf = buf + "                }\n"
    buf = buf + "                C[i*d + hh*hd + c2] = acc;\n"
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// mk2-C4-bwd (2026-05-19): GQA attention-dt bwd CPU mirror. Byte-eq\n"
    buf = buf + "// with ag_tape.hexa::_ag_attn_dt_bwd host loop. dQ/dK/dV are FRESH\n"
    buf = buf + "// t_zeros from the tape-replay site (`else if kind == ag_k_attn_dt()`\n"
    buf = buf + "// at ag_tape.hexa:655) so we treat them as zero-init accumulators —\n"
    buf = buf + "// no read-modify-write hazard. Returns 0 ok / -1 err.\n"
    buf = buf + "static int _hx_farr_attn_dt_bwd_cpu(int64_t q_id, int64_t k_id, int64_t v_id,\n"
    buf = buf + "                                    int64_t p_id, int64_t dctx_id,\n"
    buf = buf + "                                    int64_t dq_id, int64_t dk_id, int64_t dv_id,\n"
    buf = buf + "                                    int64_t T, int64_t nh, int64_t nkv,\n"
    buf = buf + "                                    int64_t hd) {\n"
    buf = buf + "    if (q_id < 0 || q_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (k_id < 0 || k_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (v_id < 0 || v_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (p_id < 0 || p_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (dctx_id < 0 || dctx_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (dq_id < 0 || dq_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (dk_id < 0 || dk_id >= _hx_farr_count) return -1;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    if (dv_id < 0 || dv_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (T <= 0 || nh <= 0 || nkv <= 0 || hd <= 0) return -1;\n"
    buf = buf + "    if (nh % nkv != 0) return -1;\n"
    buf = buf + "    HexaFarrEntry* qe = &_hx_farr_table[q_id];\n"
    buf = buf + "    HexaFarrEntry* ke = &_hx_farr_table[k_id];\n"
    buf = buf + "    HexaFarrEntry* ve = &_hx_farr_table[v_id];\n"
    buf = buf + "    HexaFarrEntry* pe = &_hx_farr_table[p_id];\n"
    buf = buf + "    HexaFarrEntry* de = &_hx_farr_table[dctx_id];\n"
    buf = buf + "    HexaFarrEntry* dqe= &_hx_farr_table[dq_id];\n"
    buf = buf + "    HexaFarrEntry* dke= &_hx_farr_table[dk_id];\n"
    buf = buf + "    HexaFarrEntry* dve= &_hx_farr_table[dv_id];\n"
    buf = buf + "    if (!qe->buf || !ke->buf || !ve->buf || !pe->buf || !de->buf ||\n"
    buf = buf + "        !dqe->buf || !dke->buf || !dve->buf) return -1;\n"
    buf = buf + "    int64_t nq = T * nh  * hd;\n"
    buf = buf + "    int64_t nk = T * nkv * hd;\n"
    buf = buf + "    int64_t np = nh * T * T;\n"
    buf = buf + "    if (qe->len < nq || ke->len < nk || ve->len < nk ||\n"
    buf = buf + "        pe->len < np || de->len < nq ||\n"
    buf = buf + "        dqe->len < nq || dke->len < nk || dve->len < nk) return -1;\n"
    buf = buf + "    const double* Q = qe->buf;\n"
    buf = buf + "    const double* K = ke->buf;\n"
    buf = buf + "    const double* V = ve->buf;\n"
    buf = buf + "    const double* P = pe->buf;\n"
    buf = buf + "    const double* dctx = de->buf;\n"
    buf = buf + "    double* dQ = dqe->buf;\n"
    buf = buf + "    double* dK = dke->buf;\n"
    buf = buf + "    double* dV = dve->buf;\n"
    buf = buf + "    int64_t n_rep = nh / nkv;\n"
    buf = buf + "    int64_t d     = nh * hd;\n"
    buf = buf + "    double scale = 1.0 / _hx_dt_sqrt_d((double)hd);\n"
    buf = buf + "    /* Per-row scratch dP_row[T]; freed at end (matches hexa t_free). */\n"
    buf = buf + "    double* dP_row = (double*)malloc((size_t)T * sizeof(double));\n"
    buf = buf + "    if (!dP_row) return -1;\n"
    buf = buf + "    for (int64_t hh = 0; hh < nh; hh++) {\n"
    buf = buf + "        int64_t kvh = hh / n_rep;\n"
    buf = buf + "        for (int64_t i = 0; i < T; i++) {\n"
    buf = buf + "            int64_t L = i + 1;\n"
    buf = buf + "            for (int64_t j = 0; j < L; j++) {\n"
    buf = buf + "                double acc = 0.0;\n"
    buf = buf + "                for (int64_t c = 0; c < hd; c++) {\n"
    buf = buf + "                    acc = acc + dctx[i*d + hh*hd + c]\n"
    buf = buf + "                              * V[(j*nkv + kvh)*hd + c];\n"
    buf = buf + "                }\n"
    buf = buf + "                dP_row[j] = acc;\n"
    buf = buf + "            }\n"
    buf = buf + "            double sdot = 0.0;\n"
    buf = buf + "            for (int64_t j2 = 0; j2 < L; j2++) {\n"
    buf = buf + "                sdot = sdot + P[(hh*T + i)*T + j2] * dP_row[j2];\n"
    buf = buf + "            }\n"
    buf = buf + "            for (int64_t j3 = 0; j3 < L; j3++) {\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "                double pij = P[(hh*T + i)*T + j3];\n"
    buf = buf + "                for (int64_t c = 0; c < hd; c++) {\n"
    buf = buf + "                    int64_t dv_idx = (j3*nkv + kvh)*hd + c;\n"
    buf = buf + "                    dV[dv_idx] = dV[dv_idx] + pij * dctx[i*d + hh*hd + c];\n"
    buf = buf + "                }\n"
    buf = buf + "            }\n"
    buf = buf + "            for (int64_t j4 = 0; j4 < L; j4++) {\n"
    buf = buf + "                double dS = P[(hh*T + i)*T + j4]\n"
    buf = buf + "                          * (dP_row[j4] - sdot) * scale;\n"
    buf = buf + "                for (int64_t c2 = 0; c2 < hd; c2++) {\n"
    buf = buf + "                    int64_t dq_idx = (i*nh + hh)*hd + c2;\n"
    buf = buf + "                    int64_t dk_idx = (j4*nkv + kvh)*hd + c2;\n"
    buf = buf + "                    dQ[dq_idx] = dQ[dq_idx] + dS * K[(j4*nkv + kvh)*hd + c2];\n"
    buf = buf + "                    dK[dk_idx] = dK[dk_idx] + dS * Q[(i*nh + hh)*hd + c2];\n"
    buf = buf + "                }\n"
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    free(dP_row);\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "#pragma STDC FP_CONTRACT DEFAULT\n"
    buf = buf + "\n"
    buf = buf + "// mk2-C2 (2026-05-19): RMSNorm-mh forge-route. Bare 7-arg function\n"
    buf = buf + "// (exceeds hexa_callN ≤4-arg ceiling; same pattern as farr_rope_gpu).\n"
    buf = buf + "// fwd: per-row ms = Σ x²/d → iv = 1/dt_sqrt(ms+eps) → y[c]=g[c]·x[c]·iv;\n"
    buf = buf + "// caller supplies pre-allocated y[T·d], xn[T·d], inv[T] buffers + reads\n"
    buf = buf + "// back via lazy-D2H (mk2-C3 §6.4) on host scalar access. Returns 0 on\n"
    buf = buf + "// ok / -1 err. The CUDA kernel + host wrapper live in\n"
