    buf = buf + "    // same pattern as RFC 032 farr_matmul + RFC 034 ad_matmul).\n"
    buf = buf + "    // Forward decls for wired-fn stubs (defined at end-of-file, hotfix 2026-05-27).\n"
    buf = buf + "    extern HexaVal hexa_cuda_available(void);\n"
    buf = buf + "    extern HexaVal hexa_cuda_device_count(void);\n"
    buf = buf + "    extern HexaVal hexa_set_deterministic(HexaVal);\n"
    buf = buf + "    extern HexaVal hexa_is_deterministic(void);\n"
