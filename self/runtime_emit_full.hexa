    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// one_hot(idx, n): n-length binary vector, 1.0 at idx, 0.0 elsewhere.\n"
    buf = buf + "// Matches interpreter hexa_full.hexa:10512. Step-3 cycle 12 port.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_one_hot(HexaVal idxv, HexaVal nv) {\n"
