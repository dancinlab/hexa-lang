    buf = buf + "                                   int64_t n, int64_t out_id);\n"
    buf = buf + "extern int  _hx_cuda_farr_silu_gpu(int64_t x_id, int64_t n, int64_t out_id);\n"
    buf = buf + "extern int  _hx_cuda_farr_silu_grad_gpu(int64_t x_id, int64_t n,\n"
