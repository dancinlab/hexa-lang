    buf = buf + "\n"
    buf = buf + "// ── Phase B carriers (3-arg / 4-arg → hexa_callN dispatch). ───────\n"
    buf = buf + "// All 4 ops fit within the hexa_callN ceiling (≤4-arg), so each gets a\n"
