    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "// net/exec ④ (cycle 78): message-group svc-trap. recv/send have no Darwin\n"
    buf = buf + "// syscall — route to recvfrom(29)/sendto(133) with NULL addr (= recv/send).\n"
    buf = buf + "// ARCH GATE for message-group family (same Darwin arm64 only).\n"
    buf = buf + "// F3 ACTIVATION · Path A — recv/send class-C svc-wrapper self-emit slots.\n"
    buf = buf + "// 6-arg _cf via syscall6 (sendto/recvfrom with NULL addr): sxtw x0(s) + buf/x1\n"
    buf = buf + "// & n/x2 untouched + sxtw x3(flags) + mov x4,#0 + mov x5,#0. 12 instr / 48 B,\n"
    buf = buf + "// errno reloc 0x20/0x24. SELF-EMIT → extern, resolved by emit_hxlcl_{recv,send}_o.hexa\n"
    buf = buf + "// (byte-eq to clang -O2). SYS#: RECVFROM=29 / SENDTO=133.\n"
