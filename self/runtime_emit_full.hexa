#!hexa strict
// runtime_emit.hexa
//   B9.C (.c-text · #1850 pattern) — runtime.c source emitter.
//
// ING #29 M3 RUNTIME-PORT — full SSOT emitter for self/runtime.c frozen-blob image (151c52c8)
//
// Emits runtime.c VERBATIM. The hexa build regenerates the .c from
// this emitter before compiling, so the emitter becomes the SSOT and the
// .c becomes a build artifact. Byte-identity (gate-1 source-SHA, proven by
// runtime_byte_diff.hexa) ⇒ identical .o/.so ⇒ PERF UNCHANGED.
//
// GENERATED by tool/gen_c_text_emitter.hexa — do not hand-edit; re-run the
// generator against the hand-written .c if it ever changes.
//
// Invocation:  hexa-run runtime_emit.hexa <output-path>
// Default output path (if argv missing): "runtime.c" in cwd.

let MODULE_NAME = "runtime_emit"

fn _flush_runtime(out_path: str, buf: str) {
    let _ = exec("cat >> \"" + out_path + "\" <<'GEN_runtime_EOF'\n" + buf + "GEN_runtime_EOF")
}

fn emit_runtime_to(out_path: str) {
    // Verbatim content of hand-written self/native/runtime.c, streamed in
    // size-bounded chunks (see generator note on the per-command exec limit).
    let _ = exec("printf '' > \"" + out_path + "\"")
    let mut buf = ""
    buf = buf + "// ═══════════════════════════════════════════════════════════\n"
    buf = buf + "//  HEXA C Runtime Library — Phase 5 self-hosting support\n"
    buf = buf + "//  Provides: tagged values, strings, arrays, maps, GC\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════\n"
    buf = buf + "\n"
    buf = buf + "#include <stdio.h>\n"
    buf = buf + "#include <stdlib.h>\n"
    buf = buf + "#include <string.h>\n"
    buf = buf + "#include <stdint.h>\n"
    buf = buf + "#include <stdarg.h>     // 2026-05-22 iter-2a: va_list/va_arg explicit (Linux GCC); macOS clang gets it transitively from <stdio.h>\n"
    buf = buf + "#include <math.h>\n"
    buf = buf + "#include <ctype.h>\n"
    buf = buf + "#include <dlfcn.h>\n"
    buf = buf + "#include <time.h>\n"
    buf = buf + "#include <unistd.h>\n"
    buf = buf + "#include <sys/resource.h>\n"
    buf = buf + "#include <sys/stat.h>\n"
    buf = buf + "#include <sys/wait.h>\n"
    buf = buf + "#include <spawn.h>      // posix_spawnp / posix_spawn_file_actions_* used in runtime_core.c (cold-compile fix)\n"
    buf = buf + "#include <errno.h>      // EINTR for waitpid retry loop in spawn reap\n"
    buf = buf + "#include <fcntl.h>      // TL;DR #4: F_SETPIPE_SZ on Linux for pipe enlarge\n"
    buf = buf + "#include <signal.h>     // 2026-05-06: SIGPIPE SIG_IGN install in stdio init\n"
    buf = buf + "#include <regex.h>      // G3-REGEX 2026-05-06: POSIX ERE regcomp/regexec\n"
    buf = buf + "#include <sys/mman.h>   // RFC 025 (2026-05-12): mmap-backed safetensors load\n"
    buf = buf + "#include <sys/socket.h> // GO M10 (RFC 093): hexa daemon unix-socket primitives\n"
    buf = buf + "#include <arpa/inet.h>  // GO M10: inet_pton for AF_INET addr parse\n"
    buf = buf + "// RUNTIME tail (cycle 85): own the environ global instead of libc's. A\n"
    buf = buf + "// priority-101 constructor (runs before all default-priority ctors — incl.\n"
    buf = buf + "// the arena init that calls getenv) captures envp, which Darwin/dyld passes\n"
    buf = buf + "// to __mod_init_func routines as (argc, argv, envp, apple). Drops the libc\n"
    buf = buf + "// _environ extern. <unistd.h> (line 15) is already parsed, so this #define\n"
    buf = buf + "// does not corrupt its prototype; later guarded re-includes are no-ops.\n"
    buf = buf + "static char **hxlcl_environ = 0;\n"
    buf = buf + "__attribute__((constructor(101)))\n"
    buf = buf + "static void hxlcl_capture_environ(int argc, char **argv, char **envp) {\n"
    buf = buf + "    (void)argc; (void)argv; hxlcl_environ = envp;\n"
    buf = buf + "}\n"
    buf = buf + "#define environ hxlcl_environ\n"
    buf = buf + "// RUNTIME.md Tier-A.4 (cycle 76): the HEXA_OOB_TRACE backtrace path is now\n"
    buf = buf + "// served by hexa-native stubs (hxlcl_backtrace / hxlcl_backtrace_symbols_fd\n"
    buf = buf + "// below) instead of libc execinfo(3). <execinfo.h> is therefore no longer\n"
    buf = buf + "// needed — dropping it removes the only declaration site for the libc\n"
    buf = buf + "// _backtrace / _backtrace_symbols_fd externs (RFC 063/064 ubu-pool include\n"
    buf = buf + "// concern moot now that no execinfo fn is referenced).\n"
    buf = buf + "#if defined(__APPLE__)\n"
    buf = buf + "#include <mach/mach.h>\n"
    buf = buf + "#include <mach/task.h>\n"
    buf = buf + "#include <mach/task_info.h>\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// ═══════════════════════════════════════════════════════════\n"
    buf = buf + "//  RFC 061 Phase P1 — 2-layer runtime split.\n"
    buf = buf + "//  The CORE tier (HexaVal representation, allocator/arena, the\n"
    buf = buf + "//  universal codegen-emitted primitives + their transitive closure)\n"
    buf = buf + "//  lives in runtime_core.c and is textually included here, right\n"
    buf = buf + "//  after the system #include block, so all of its macros, file-scope\n"
    buf = buf + "//  statics and internal forward declarations are visible to the\n"
    buf = buf + "//  HI-tier code below exactly as before the split.\n"
    buf = buf + "//\n"
    buf = buf + "//  This #include + the HI tier below re-concatenate to a translation\n"
    buf = buf + "//  unit byte-identical to the pre-split runtime.c — a pure file\n"
    buf = buf + "//  partition with ZERO behavior change. See runtime_core.c header.\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════\n"
    buf = buf + "// Cycle 55: override macOS libc stderr/stdout/stdin/errno (= __stderrp/\n"
    buf = buf + "// __stdoutp/__stdinp + __error extern globals) with encoded FILE*\n"
    buf = buf + "// constants + plain int store. Placed BEFORE helper definitions so\n"
    buf = buf + "// they see our values. Drops ___stderrp + ___stdoutp + ___stdinp +\n"
    buf = buf + "// ___error from extern list.\n"
    buf = buf + "#undef stderr\n"
    buf = buf + "#undef stdout\n"
    buf = buf + "#undef stdin\n"
    buf = buf + "#define stderr ((FILE *)(uintptr_t)3)\n"
    buf = buf + "#define stdout ((FILE *)(uintptr_t)2)\n"
    buf = buf + "#define stdin  ((FILE *)(uintptr_t)1)\n"
    buf = buf + "// B9.6-C2 (F3 Path A) — `hxlcl_errno` is the hexa-native errno cell. Under\n"
    buf = buf + "// HEXA_RT_SELFEMIT it must be EXTERNALLY LINKABLE: the self-emitted\n"
    buf = buf + "// `hxlcl_close` (emit_hxlcl_close_o.hexa) stores the errno via a PAGE21/\n"
    buf = buf + "// PAGEOFF12 reloc against an UNDEFINED-external `_hxlcl_errno` symbol, which\n"
    buf = buf + "// ld64 binds to THIS cell. A `static` definition would be invisible to that\n"
    buf = buf + "// cross-object reloc (ld64: \"undefined symbol _hxlcl_errno\"). Default build\n"
    buf = buf + "// keeps it `static` (file-local, 0-libc-extern invariant preserved). The\n"
    buf = buf + "// symbol name is `hxlcl_errno`, NOT libc `errno`, so no libc clash.\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "int hxlcl_errno = 0;\n"
    buf = buf + "#else\n"
    buf = buf + "static int hxlcl_errno = 0;\n"
    buf = buf + "#endif\n"
    buf = buf + "#undef errno\n"
    buf = buf + "#define errno hxlcl_errno\n"
    buf = buf + "// Cycle 63 forward decls — syscall wrappers used by earlier helpers\n"
    buf = buf + "// (e.g. hxlcl_printf line 451+ calls write). Bodies live in the\n"
    buf = buf + "// syscall block at line ~825 below.\n"
    buf = buf + "// B9.6-C12/C13 (F3 Path A) — under HEXA_RT_SELFEMIT hxlcl_read/hxlcl_write are\n"
    buf = buf + "// `extern` (resolved by the hexa-emitted .o — rt_read/rt_write are the rt_close\n"
    buf = buf + "// 3-arg _cf shape: only fd/x0 sxtw, buf/n untouched; errno store via PC-relative\n"
    buf = buf + "// adrp/str to the hxlcl_errno SYMBOL, externally linkable under the guard).\n"
    buf = buf + "// Forward decls flip to external linkage too, else the `static` masks the\n"
    buf = buf + "// self-emit symbol (-Wundefined-internal). hxlcl_printf (line ~451) calls write.\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern long hxlcl_read(int fd, void *buf, unsigned long n);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "extern long hxlcl_write(int fd, const void *buf, unsigned long n);\n"
    buf = buf + "#else\n"
    buf = buf + "static long hxlcl_read(int fd, void *buf, unsigned long n);\n"
    buf = buf + "static long hxlcl_write(int fd, const void *buf, unsigned long n);\n"
    buf = buf + "#endif\n"
    buf = buf + "// B9.6-C2 (F3 Path A) — under HEXA_RT_SELFEMIT hxlcl_close is `extern`\n"
    buf = buf + "// (resolved by emit_hxlcl_close_o.hexa's .o). As with getpid (#1860) the\n"
    buf = buf + "// forward decl must flip to external linkage too, else the `static` decl\n"
    buf = buf + "// masks the self-emit symbol (-Wundefined-internal). The self-emit close\n"
    buf = buf + "// stores errno via a PC-relative `adrp/str` to the `hxlcl_errno` SYMBOL, so\n"
    buf = buf + "// that symbol must be externally linkable under the guard (see below).\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int  hxlcl_close(int fd);\n"
    buf = buf + "#else\n"
    buf = buf + "static int  hxlcl_close(int fd);\n"
    buf = buf + "#endif\n"
    buf = buf + "// F3 wave 3 — 1-arg / errno-reloc family. chdir/unlink/rmdir use the NEW\n"
    buf = buf + "// ptr-arg sub-template (no leading sxtw, 8-instr 32 B body), fsync/dup are\n"
    buf = buf + "// byte-for-byte close clones (int-arg sxtw, 9-instr 36 B). All five flip to\n"
    buf = buf + "// extern under HEXA_RT_SELFEMIT; default stays static svc-trap.\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int  hxlcl_chdir(const char *path);\n"
    buf = buf + "extern int  hxlcl_unlink(const char *path);\n"
    buf = buf + "extern int  hxlcl_rmdir(const char *path);\n"
    buf = buf + "extern int  hxlcl_fsync(int fd);\n"
    buf = buf + "extern int  hxlcl_dup(int oldfd);\n"
    buf = buf + "#else\n"
    buf = buf + "static int  hxlcl_chdir(const char *path);\n"
    buf = buf + "static int  hxlcl_unlink(const char *path);\n"
    buf = buf + "static int  hxlcl_rmdir(const char *path);\n"
    buf = buf + "static int  hxlcl_fsync(int fd);\n"
    buf = buf + "static int  hxlcl_dup(int oldfd);\n"
    buf = buf + "#endif\n"
    buf = buf + "// F3 wave 4 — 2-arg + 3-arg errno-reloc family. chmod/access use the mkdir\n"
    buf = buf + "// sub-template (9-instr 36 B, single sxtw on x1, relocs @0x14/0x18).\n"
    buf = buf + "// truncate uses the stat sub-template (8-instr 32 B, NO sxtw — both args\n"
    buf = buf + "// already 64-bit, relocs @0x10/0x14). chown/lchown use the NEW ptr+int+int\n"
    buf = buf + "// sub-template (10-instr 40 B, sxtw on x1+x2, relocs @0x18/0x1c — same\n"
    buf = buf + "// reloc offsets as lseek which has a different sxtw pair (x0+x2)).\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int  hxlcl_chmod(const char *path, int mode);\n"
    buf = buf + "extern int  hxlcl_access(const char *path, int amode);\n"
    buf = buf + "extern int  hxlcl_truncate(const char *path, long length);\n"
    buf = buf + "extern int  hxlcl_chown(const char *path, int uid, int gid);\n"
    buf = buf + "extern int  hxlcl_lchown(const char *path, int uid, int gid);\n"
    buf = buf + "#else\n"
    buf = buf + "static int  hxlcl_chmod(const char *path, int mode);\n"
    buf = buf + "static int  hxlcl_access(const char *path, int amode);\n"
    buf = buf + "static int  hxlcl_truncate(const char *path, long length);\n"
    buf = buf + "static int  hxlcl_chown(const char *path, int uid, int gid);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "static int  hxlcl_lchown(const char *path, int uid, int gid);\n"
    buf = buf + "#endif\n"
    buf = buf + "// B9.6-C1 (F3 Path A) — under HEXA_RT_SELFEMIT hxlcl_getpid is `extern`\n"
    buf = buf + "// (resolved by emit_hxlcl_getpid_o.hexa's .o); the forward decl must match\n"
    buf = buf + "// that external linkage, else the `static` here wins and masks the self-emit\n"
    buf = buf + "// symbol (-Wundefined-internal). Default build keeps the internal-linkage\n"
    buf = buf + "// forward decl that pairs with the `static` svc-trap body below.\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int  hxlcl_getpid(void);\n"
    buf = buf + "#else\n"
    buf = buf + "static int  hxlcl_getpid(void);\n"
    buf = buf + "#endif\n"
    buf = buf + "// B9.6-C3 (F3 Path A) — under HEXA_RT_SELFEMIT hxlcl_getuid is `extern`\n"
    buf = buf + "// (resolved by emit_hxlcl_getuid_o.hexa's .o). Mirrors getpid (#1860): a\n"
    buf = buf + "// 0-arg / cannot-fail svc-trap, no errno path. Forward decl must flip to\n"
    buf = buf + "// external linkage too, else the `static` masks the self-emit symbol.\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int  hxlcl_getuid(void);\n"
    buf = buf + "#else\n"
    buf = buf + "static int  hxlcl_getuid(void);\n"
    buf = buf + "#endif\n"
    buf = buf + "// RUNTIME.md Tier-A.4 — frame walker stubs (diagnostic-only, HEXA_OOB_TRACE\n"
    buf = buf + "// path in runtime_core.c). A self-host compiler needs no real unwinder; the\n"
    buf = buf + "// stub returns 0 frames + writes a single \"(backtrace unavailable)\" line via\n"
    buf = buf + "// hxlcl_write. Drops the libc _backtrace / _backtrace_symbols_fd externs.\n"
    buf = buf + "static int  hxlcl_backtrace(void **buf, int sz);\n"
    buf = buf + "static void hxlcl_backtrace_symbols_fd(void *const *buf, int sz, int fd);\n"
    buf = buf + "// B9.6-C4 (F3 Path A) — under HEXA_RT_SELFEMIT hxlcl_dup2 is `extern`\n"
    buf = buf + "// (resolved by emit_hxlcl_dup2_o.hexa's .o). A 2-arg _cf svc with the\n"
    buf = buf + "// carry-flag errno store (PC-relative adrp/str to hxlcl_errno SYMBOL, so\n"
    buf = buf + "// that symbol must stay externally linkable under the guard — same as close).\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int  hxlcl_dup2(int oldfd, int newfd);\n"
    buf = buf + "#else\n"
    buf = buf + "static int  hxlcl_dup2(int oldfd, int newfd);\n"
    buf = buf + "#endif\n"
    buf = buf + "static int  hxlcl_pipe(int fds[2]);\n"
    buf = buf + "static int  hxlcl_fork(void);\n"
    buf = buf + "// B9.6-C8 (F3 Path A) — under HEXA_RT_SELFEMIT hxlcl_kill is `extern`\n"
    buf = buf + "// (resolved by the hexa-emitted .o). A 2-arg NON-_cf svc (no errno path,\n"
    buf = buf + "// getuid's 2-arg analogue: both int args sxtw, trap, ret). Forward decl must\n"
    buf = buf + "// flip to external linkage too, else the `static` masks the self-emit symbol.\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int  hxlcl_kill(int pid, int sig);\n"
    buf = buf + "#else\n"
    buf = buf + "static int  hxlcl_kill(int pid, int sig);\n"
    buf = buf + "#endif\n"
    buf = buf + "// B9.6-C9/C10/C11 (F3 Path A) — under HEXA_RT_SELFEMIT hxlcl_lseek (3-arg _cf),\n"
    buf = buf + "// hxlcl_fcntl and hxlcl_ioctl (3-arg NON-_cf) are `extern` (resolved by the\n"
    buf = buf + "// hexa-emitted .o). lseek stores errno via a PC-relative adrp/str to the\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// hxlcl_errno SYMBOL (externally linkable under the guard — same as dup2/lseek\n"
    buf = buf + "// shares the dup2 reloc offsets). fcntl/ioctl have NO errno path → no reloc\n"
    buf = buf + "// (the 3-arg analogues of rt_kill). Forward decls flip to external linkage too,\n"
    buf = buf + "// else the `static` here masks the self-emit symbol (-Wundefined-internal).\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int  hxlcl_fcntl(int fd, int cmd, long arg);\n"
    buf = buf + "extern int  hxlcl_ioctl(int fd, unsigned long req, void *arg);\n"
    buf = buf + "extern long hxlcl_lseek(int fd, long off, int whence);\n"
    buf = buf + "#else\n"
    buf = buf + "static int  hxlcl_fcntl(int fd, int cmd, long arg);\n"
    buf = buf + "static int  hxlcl_ioctl(int fd, unsigned long req, void *arg);\n"
    buf = buf + "static long hxlcl_lseek(int fd, long off, int whence);\n"
    buf = buf + "#endif\n"
    buf = buf + "// B9.6-C14/C15/C16 (F3 Path A) — under HEXA_RT_SELFEMIT hxlcl_select (6-arg\n"
    buf = buf + "// NON-_cf), hxlcl_poll (3-arg NON-_cf, the FIRST uxtw `mov w1,w1` for the\n"
    buf = buf + "// unsigned nfds) and hxlcl_waitpid (the FIRST 4-arg _cf, errno reloc) are\n"
    buf = buf + "// `extern` (resolved by the hexa-emitted .o). select/poll have NO errno path →\n"
    buf = buf + "// no reloc; waitpid stores errno via PC-relative adrp/str to the hxlcl_errno\n"
    buf = buf + "// SYMBOL. Forward decls flip to external linkage too.\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int  hxlcl_select(int nfds, void *r, void *w, void *e, void *t);\n"
    buf = buf + "extern int  hxlcl_poll(void *fds, unsigned int nfds, int timeout);\n"
    buf = buf + "extern int  hxlcl_waitpid(int pid, int *status, int options);\n"
    buf = buf + "#else\n"
    buf = buf + "static int  hxlcl_select(int nfds, void *r, void *w, void *e, void *t);\n"
    buf = buf + "static int  hxlcl_poll(void *fds, unsigned int nfds, int timeout);\n"
    buf = buf + "static int  hxlcl_waitpid(int pid, int *status, int options);\n"
    buf = buf + "#endif\n"
    buf = buf + "// B9.6-C6/C7 (F3 Path A) — under HEXA_RT_SELFEMIT hxlcl_fstat (int+ptr) and\n"
    buf = buf + "// hxlcl_stat (ptr+ptr) are `extern` (resolved by the hexa-emitted .o). Both\n"
    buf = buf + "// are 2-arg _cf svc bodies with the carry-flag errno store (PC-relative adrp/\n"
    buf = buf + "// str to the hxlcl_errno SYMBOL, externally linkable under the guard — same as\n"
    buf = buf + "// dup2/mkdir). Forward decls flip to external linkage too.\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int  hxlcl_fstat(int fd, void *buf);\n"
    buf = buf + "extern int  hxlcl_stat(const char *path, void *buf);\n"
    buf = buf + "#else\n"
    buf = buf + "static int  hxlcl_fstat(int fd, void *buf);\n"
    buf = buf + "static int  hxlcl_stat(const char *path, void *buf);\n"
    buf = buf + "#endif\n"
    buf = buf + "static int  hxlcl_open_sys(const char *path, int flags, ...);\n"
    buf = buf + "// F3 ACTIVATION · Path A — exit forward decl (extern under guard; resolved by\n"
    buf = buf + "// emit_hxlcl_exit_o.hexa's no-reloc-v3 .o on arm64).\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern void hxlcl_exit(int code) __attribute__((noreturn));\n"
    buf = buf + "#else\n"
    buf = buf + "static void hxlcl_exit(int code) __attribute__((noreturn));\n"
    buf = buf + "#endif\n"
    buf = buf + "// B9.6-C17 (F3 Path A) — under HEXA_RT_SELFEMIT hxlcl_mmap is `extern`\n"
    buf = buf + "// (resolved by the hexa-emitted .o — rt_mmap is a 6-arg _cf: sxtw x2/x3/x4 for\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// prot/flags/fd, addr/len/off untouched; errno store via PC-relative adrp/str to\n"
    buf = buf + "// the hxlcl_errno SYMBOL; -1 == MAP_FAILED). Forward decl flips to external\n"
    buf = buf + "// linkage too. The arena bump-allocator state machine is elsewhere — this is\n"
    buf = buf + "// just the kernel mmap trap.\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern void *hxlcl_mmap(void *addr, unsigned long len, int prot, int flags, int fd, long off);\n"
    buf = buf + "#else\n"
    buf = buf + "static void *hxlcl_mmap(void *addr, unsigned long len, int prot, int flags, int fd, long off);\n"
    buf = buf + "#endif\n"
    buf = buf + "// F3 B9.6-B2 — class-B HARD `rt_strdup` Path-A activation. hxlcl_strdup is\n"
    buf = buf + "// `extern` under HEXA_RT_SELFEMIT (body supplied by emit_hxlcl_strdup_o.hexa's\n"
    buf = buf + "// .o = frame + scalar strlen loop + `bl _hxlcl_malloc` + scalar copy loop +\n"
    buf = buf + "// epilogue, 28 instr / 112 B, 1 ARM64_RELOC_BRANCH26 @0x30). The BL TARGET\n"
    buf = buf + "// hxlcl_malloc is EXPORTED (non-static) so ld64 can bind the .o's BRANCH26\n"
    buf = buf + "// reloc to runtime.c's hxlcl_malloc — same callee-export wrinkle as B9.6-B1\n"
    buf = buf + "// rt_atoi → hxlcl_atoll. Default (guard off) keeps malloc file-local `static`\n"
    buf = buf + "// = 0-libc-extern invariant preserved. (Both forward decl AND definition flip\n"
    buf = buf + "// for malloc; #1860 lesson — else -Wundefined-internal masks the symbol.)\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "#define HXLCL_MALLOC_SC          /* exported: ld64 binds the .o's BRANCH26 here */\n"
    buf = buf + "void *hxlcl_malloc(size_t n);\n"
    buf = buf + "#else\n"
    buf = buf + "#define HXLCL_MALLOC_SC static    /* default: file-local (0-libc-extern) */\n"
    buf = buf + "static void *hxlcl_malloc(size_t n);  /* cycle 73: route pre-#define helpers off libc malloc */\n"
    buf = buf + "#endif\n"
    buf = buf + "static void  hxlcl_free(void *p);     /* cycle 73: noop free — keeps _free extern out */\n"
    buf = buf + "static int  hxlcl_clock_gettime(int clk, void *ts);  /* re-decl: cycle 65 syscall body overrides cycle 62 stub */\n"
    buf = buf + "\n"
    buf = buf + "// ─── RUNTIME.md Phase 1 Tier-A.1 — libc unhook helpers ───\n"
    buf = buf + "// Step-1 of the hexa-native runtime rewrite (RUNTIME.md cycle 46):\n"
    buf = buf + "// local C-source replacements for the most-called libc string fns\n"
    buf = buf + "// so the linker no longer pulls in _strlen / _strcmp / _memcmp.\n"
    buf = buf + "// Defined BEFORE `#include \"runtime_core.c\"` so CORE-tier call sites\n"
    buf = buf + "// resolve to these too (runtime_core.c is textually concatenated).\n"
    buf = buf + "// Step-2 (later cycle) ports each helper to stdlib/runtime/<name>.hexa\n"
    buf = buf + "// + codegen routing. `noinline` + volatile read defeat clang's\n"
    buf = buf + "// libcall recognition under -Oz. The trailing `#define strlen ...`\n"
    buf = buf + "// textually overrides any residual libc strlen / memcmp / strcmp\n"
    buf = buf + "// references in macro expansions / inline header bodies that the\n"
    buf = buf + "// perl substitution couldn't reach.\n"
    buf = buf + "// F3 ACTIVATION RUNBOOK · Path A — hxlcl_strlen self-emit slot.\n"
    buf = buf + "// DEFAULT (guard off): file-local `static` body (0-libc-extern preserved).\n"
    buf = buf + "// HEXA_RT_SELFEMIT: `extern`, resolved by emit_hxlcl_strlen_o.hexa's .o\n"
    buf = buf + "// (rt_str_len's 40 bytes). See the hxlcl_memset slot below for the full\n"
    buf = buf + "// rationale. ABI: strlen(x0=s) -> x0=len, matches rt_str_len.\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern size_t hxlcl_strlen(const char *s);\n"
    buf = buf + "#else\n"
    buf = buf + "static size_t __attribute__((noinline)) hxlcl_strlen(const char *s) {\n"
    buf = buf + "    if (!s) return 0;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    size_t n = 0;\n"
    buf = buf + "    while (((const volatile char *)s)[n]) n++;\n"
    buf = buf + "    return n;\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "// F3 ACTIVATION RUNBOOK · Path A — hxlcl_memcmp self-emit slot (rt_memcmp, 52 B).\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int hxlcl_memcmp(const void *a, const void *b, size_t n);\n"
    buf = buf + "#else\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_memcmp(const void *a, const void *b, size_t n) {\n"
    buf = buf + "    const unsigned char *pa = (const unsigned char *)a;\n"
    buf = buf + "    const unsigned char *pb = (const unsigned char *)b;\n"
    buf = buf + "    for (size_t i = 0; i < n; i++) {\n"
    buf = buf + "        int d = (int)pa[i] - (int)pb[i];\n"
    buf = buf + "        if (d != 0) return d;\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "// F3 ACTIVATION RUNBOOK · Path A — hxlcl_strcmp self-emit slot (rt_strcmp, 48 B).\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int hxlcl_strcmp(const char *a, const char *b);\n"
    buf = buf + "#else\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_strcmp(const char *a, const char *b) {\n"
    buf = buf + "    for (size_t i = 0; ; i++) {\n"
    buf = buf + "        unsigned char ca = (unsigned char)a[i];\n"
    buf = buf + "        unsigned char cb = (unsigned char)b[i];\n"
    buf = buf + "        if (ca != cb) return (int)ca - (int)cb;\n"
    buf = buf + "        if (ca == 0) return 0;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "// Cycle 47: `strcat` unhook. Same loop pattern in `hxlcl_strcat` body\n"
    buf = buf + "// would let clang's libcall recognizer convert it back to `strcat` +\n"
    buf = buf + "// `strlen`; the volatile read on the dest scan defeats that, mirroring\n"
    buf = buf + "// the cycle-46 helpers. Returns dest per C99 strcat semantics.\n"
    buf = buf + "// F3 ACTIVATION RUNBOOK · Path A — hxlcl_strcat self-emit slot (rt_strcat, 48 B).\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern char *hxlcl_strcat(char *dest, const char *src);\n"
    buf = buf + "#else\n"
    buf = buf + "static char *__attribute__((noinline)) hxlcl_strcat(char *dest, const char *src) {\n"
    buf = buf + "    char *p = dest;\n"
    buf = buf + "    while (((const volatile char *)p)[0]) p++;\n"
    buf = buf + "    size_t i = 0;\n"
    buf = buf + "    while (((const volatile char *)src)[i]) {\n"
    buf = buf + "        p[i] = src[i];\n"
    buf = buf + "        i++;\n"
    buf = buf + "    }\n"
    buf = buf + "    p[i] = '\\0';\n"
    buf = buf + "    return dest;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "// Cycle 47 batch: strncmp, strstr, strrchr, strchr, strdup, strndup.\n"
    buf = buf + "// F3 ACTIVATION RUNBOOK · Path A — hxlcl_strncmp self-emit slot (rt_strncmp, 56 B).\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int hxlcl_strncmp(const char *a, const char *b, size_t n);\n"
    buf = buf + "#else\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_strncmp(const char *a, const char *b, size_t n) {\n"
    buf = buf + "    for (size_t i = 0; i < n; i++) {\n"
    buf = buf + "        unsigned char ca = (unsigned char)a[i];\n"
    buf = buf + "        unsigned char cb = (unsigned char)b[i];\n"
    buf = buf + "        if (ca != cb) return (int)ca - (int)cb;\n"
    buf = buf + "        if (ca == 0) return 0;\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "// F3 ACTIVATION RUNBOOK · Path A — hxlcl_strchr self-emit slot (rt_strchr, 44 B).\n"
    buf = buf + "// NOTE: rt_strchr has no NULL-input guard (the C body's `if (!s)` is dropped);\n"
    buf = buf + "// C strchr(NULL,...) is UB anyway, so non-NULL callers are byte-identical.\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern const char *hxlcl_strchr(const char *s, int c);\n"
    buf = buf + "#else\n"
    buf = buf + "static const char *__attribute__((noinline)) hxlcl_strchr(const char *s, int c) {\n"
    buf = buf + "    if (!s) return NULL;\n"
    buf = buf + "    unsigned char target = (unsigned char)c;\n"
    buf = buf + "    for (size_t i = 0; ; i++) {\n"
    buf = buf + "        unsigned char x = (unsigned char)((const volatile char *)s)[i];\n"
    buf = buf + "        if (x == target) return s + i;\n"
    buf = buf + "        if (x == 0) return (target == 0) ? (s + i) : NULL;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "// F3 ACTIVATION RUNBOOK · Path A — hxlcl_strrchr self-emit slot (rt_strrchr, 44 B).\n"
    buf = buf + "// NOTE: rt_strrchr has no NULL-input guard (same UB caveat as hxlcl_strchr).\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern const char *hxlcl_strrchr(const char *s, int c);\n"
    buf = buf + "#else\n"
    buf = buf + "static const char *__attribute__((noinline)) hxlcl_strrchr(const char *s, int c) {\n"
    buf = buf + "    if (!s) return NULL;\n"
    buf = buf + "    unsigned char target = (unsigned char)c;\n"
    buf = buf + "    const char *last = NULL;\n"
    buf = buf + "    for (size_t i = 0; ; i++) {\n"
    buf = buf + "        unsigned char x = (unsigned char)((const volatile char *)s)[i];\n"
    buf = buf + "        if (x == target) last = s + i;\n"
    buf = buf + "        if (x == 0) return last;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "static const char *__attribute__((noinline)) hxlcl_strstr(const char *h, const char *n) {\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    if (!h || !n) return NULL;\n"
    buf = buf + "    if (n[0] == 0) return h;\n"
    buf = buf + "    for (size_t i = 0; ((const volatile char *)h)[i]; i++) {\n"
    buf = buf + "        size_t j = 0;\n"
    buf = buf + "        while (n[j] && h[i + j] == n[j]) j++;\n"
    buf = buf + "        if (n[j] == 0) return h + i;\n"
    buf = buf + "    }\n"
    buf = buf + "    return NULL;\n"
    buf = buf + "}\n"
    buf = buf + "// F3 B9.6-B2 (F3 Path A) — under HEXA_RT_SELFEMIT hxlcl_strdup is `extern`\n"
    buf = buf + "// (resolved by emit_hxlcl_strdup_o.hexa's .o = frame + scalar strlen loop +\n"
    buf = buf + "// `bl _hxlcl_malloc` + scalar copy loop + epilogue, 28 instr / 112 B, 1\n"
    buf = buf + "// ARM64_RELOC_BRANCH26 @0x30). The BL target hxlcl_malloc is EXPORTED via\n"
    buf = buf + "// HXLCL_MALLOC_SC (see L218-block) so ld64 can bind the cross-object call.\n"
    buf = buf + "// Default (guard off) keeps the static body below = 0-libc-extern preserved.\n"
    buf = buf + "// FIRST ACTIVATED class-B HARD primitive (38/640) — behavioral-equivalence\n"
    buf = buf + "// gate proven in #1911 (6/6 JIT-exec); this PR wires it into the live runtime.\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern char *hxlcl_strdup(const char *s);\n"
    buf = buf + "#else\n"
    buf = buf + "static char *__attribute__((noinline)) hxlcl_strdup(const char *s) {\n"
    buf = buf + "    if (!s) return NULL;\n"
    buf = buf + "    size_t n = 0;\n"
    buf = buf + "    while (((const volatile char *)s)[n]) n++;\n"
    buf = buf + "    char *out = (char *)hxlcl_malloc(n + 1);\n"
    buf = buf + "    if (!out) return NULL;\n"
    buf = buf + "    for (size_t i = 0; i < n; i++) out[i] = s[i];\n"
    buf = buf + "    out[n] = '\\0';\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "// F3 class-B HARD SCALE-OUT — hxlcl_strndup Path-A activation (2nd class-B HARD).\n"
    buf = buf + "// `extern` under HEXA_RT_SELFEMIT (body supplied by emit_hxlcl_strndup_o.hexa's\n"
    buf = buf + "// .o = frame + cap-bounded scalar strlen loop + `bl _hxlcl_malloc` + scalar\n"
    buf = buf + "// copy loop + explicit NUL terminator + epilogue, 36 instr / 144 B, 1\n"
    buf = buf + "// ARM64_RELOC_BRANCH26 @ 0x40). The BL target hxlcl_malloc is already EXPORTED\n"
    buf = buf + "// via HXLCL_MALLOC_SC (see L218-block, landed by PR #1917 for rt_strdup) so\n"
    buf = buf + "// ld64 can bind the cross-object call — no NEW callee-export macro needed\n"
    buf = buf + "// (strndup REUSES the strdup-era export macro since both call _hxlcl_malloc).\n"
    buf = buf + "// Default (guard off) keeps the static body below = 0-libc-extern preserved.\n"
    buf = buf + "// 2nd ACTIVATED class-B HARD primitive (39/640) — behavioral-equivalence gate\n"
    buf = buf + "// proven by the 4-gate sweep (0-extern byte-id default · self-host fixpoint ·\n"
    buf = buf + "// JIT-exec behavioral battery: empty / NUL-before-cap / no-NUL-within-cap /\n"
    buf = buf + "// cap=0 / NULL passthrough).\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern char *hxlcl_strndup(const char *s, size_t cap);\n"
    buf = buf + "#else\n"
    buf = buf + "static char *__attribute__((noinline)) hxlcl_strndup(const char *s, size_t cap) {\n"
    buf = buf + "    if (!s) return NULL;\n"
    buf = buf + "    size_t n = 0;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    while (n < cap && ((const volatile char *)s)[n]) n++;\n"
    buf = buf + "    char *out = (char *)hxlcl_malloc(n + 1);\n"
    buf = buf + "    if (!out) return NULL;\n"
    buf = buf + "    for (size_t i = 0; i < n; i++) out[i] = s[i];\n"
    buf = buf + "    out[n] = '\\0';\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "// Cycle 48 batch — numeric parse + bzero.\n"
    buf = buf + "// RUNTIME.md step-2 — hxlcl_atoll forward-decl; the two-mode DEFINITION\n"
    buf = buf + "// (delegating to hexa-source rt_atoll) lives below, after the cycle-5 atof\n"
    buf = buf + "// def — this early helper zone is pre-HexaVal (same relocate technique as atof).\n"
    buf = buf + "// F3 B9.6-B1 — class-B calling-convention composite self-emit (Path A).\n"
    buf = buf + "// Under HEXA_RT_SELFEMIT: hxlcl_atoi is `extern` (body supplied by the\n"
    buf = buf + "// hexa-emitted _hxlcl_atoi .o = frame + `bl _hxlcl_atoll` + epilogue), and\n"
    buf = buf + "// the BL TARGET hxlcl_atoll is EXPORTED (non-static) so ld64 can bind the\n"
    buf = buf + "// .o's ARM64_RELOC_BRANCH26 reloc to it. Default (guard off) keeps both\n"
    buf = buf + "// file-local `static` = 0-libc-extern invariant preserved. (Both forward\n"
    buf = buf + "// decl AND definition must flip, else -Wundefined-internal masks the\n"
    buf = buf + "// self-emit symbol — same lesson as #1860 rt_getpid.)\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "#define HXLCL_ATOLL_SC          /* exported: ld64 binds the .o's BRANCH26 here */\n"
    buf = buf + "long long __attribute__((noinline)) hxlcl_atoll(const char *s);\n"
    buf = buf + "extern int __attribute__((noinline)) hxlcl_atoi(const char *s);\n"
    buf = buf + "#else\n"
    buf = buf + "#define HXLCL_ATOLL_SC static    /* default: file-local (0-libc-extern) */\n"
    buf = buf + "static long long __attribute__((noinline)) hxlcl_atoll(const char *s);\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_atoi(const char *s) { return (int)hxlcl_atoll(s); }\n"
    buf = buf + "#endif\n"
    buf = buf + "static long long __attribute__((noinline)) hxlcl_strtoll(const char *nptr, char **endptr, int base) {\n"
    buf = buf + "    if (!nptr) { if (endptr) *endptr = (char *)nptr; return 0; }\n"
    buf = buf + "    const char *s = nptr;\n"
    buf = buf + "    while (*s == ' ' || *s == '\\t' || *s == '\\n') s++;\n"
    buf = buf + "    int sign = 1;\n"
    buf = buf + "    if (*s == '-') { sign = -1; s++; }\n"
    buf = buf + "    else if (*s == '+') s++;\n"
    buf = buf + "    if (base == 0) {\n"
    buf = buf + "        if (s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) { base = 16; s += 2; }\n"
    buf = buf + "        else if (s[0] == '0') { base = 8; s++; }\n"
    buf = buf + "        else base = 10;\n"
    buf = buf + "    } else if (base == 16 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) {\n"
    buf = buf + "        s += 2;\n"
    buf = buf + "    }\n"
    buf = buf + "    unsigned long long n = 0;\n"
    buf = buf + "    for (;;) {\n"
    buf = buf + "        char c = *s;\n"
    buf = buf + "        int d;\n"
    buf = buf + "        if (c >= '0' && c <= '9') d = c - '0';\n"
    buf = buf + "        else if (c >= 'a' && c <= 'z') d = c - 'a' + 10;\n"
    buf = buf + "        else if (c >= 'A' && c <= 'Z') d = c - 'A' + 10;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        else break;\n"
    buf = buf + "        if (d >= base) break;\n"
    buf = buf + "        n = n * (unsigned long long)base + (unsigned long long)d;\n"
    buf = buf + "        s++;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (endptr) *endptr = (char *)s;\n"
    buf = buf + "    return (long long)((sign < 0) ? -(long long)n : (long long)n);\n"
    buf = buf + "}\n"
    buf = buf + "static unsigned long long __attribute__((noinline)) hxlcl_strtoull(const char *nptr, char **endptr, int base) {\n"
    buf = buf + "    if (!nptr) { if (endptr) *endptr = (char *)nptr; return 0; }\n"
    buf = buf + "    const char *s = nptr;\n"
    buf = buf + "    while (*s == ' ' || *s == '\\t' || *s == '\\n') s++;\n"
    buf = buf + "    if (*s == '+') s++;\n"
    buf = buf + "    if (base == 0) {\n"
    buf = buf + "        if (s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) { base = 16; s += 2; }\n"
    buf = buf + "        else if (s[0] == '0') { base = 8; s++; }\n"
    buf = buf + "        else base = 10;\n"
    buf = buf + "    } else if (base == 16 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) {\n"
    buf = buf + "        s += 2;\n"
    buf = buf + "    }\n"
    buf = buf + "    unsigned long long n = 0;\n"
    buf = buf + "    for (;;) {\n"
    buf = buf + "        char c = *s;\n"
    buf = buf + "        int d;\n"
    buf = buf + "        if (c >= '0' && c <= '9') d = c - '0';\n"
    buf = buf + "        else if (c >= 'a' && c <= 'z') d = c - 'a' + 10;\n"
    buf = buf + "        else if (c >= 'A' && c <= 'Z') d = c - 'A' + 10;\n"
    buf = buf + "        else break;\n"
    buf = buf + "        if (d >= base) break;\n"
    buf = buf + "        n = n * (unsigned long long)base + (unsigned long long)d;\n"
    buf = buf + "        s++;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (endptr) *endptr = (char *)s;\n"
    buf = buf + "    return n;\n"
    buf = buf + "}\n"
    buf = buf + "// RUNTIME.md step-2 cycle 5 — hxlcl_atof forward-decl only. The two-mode\n"
    buf = buf + "// DEFINITION (delegating to hexa-source rt_str_parse_float under\n"
    buf = buf + "// HEXA_HAS_HEXA_RT_STDLIB) lives below, after the cycle-1 isalnum shim:\n"
    buf = buf + "// this early helper zone is pre-HexaVal, so the HexaVal-typed delegation\n"
    buf = buf + "// must be placed where HexaVal / hexa_str / HX_FLOAT are already declared.\n"
    buf = buf + "static double __attribute__((noinline)) hxlcl_atof(const char *s);\n"
    buf = buf + "static void __attribute__((noinline)) hxlcl_bzero(void *s, size_t n) {\n"
    buf = buf + "    unsigned char *p = (unsigned char *)s;\n"
    buf = buf + "    for (size_t i = 0; i < n; i++) {\n"
    buf = buf + "        p[i] = 0;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "// Cycle 49 batch — memory triple + Tier-A.1 stragglers.\n"
    buf = buf + "// F3 ACTIVATION RUNBOOK · Path A — hxlcl_memcpy self-emit slot (rt_memcpy, 32 B).\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "extern void *hxlcl_memcpy(void *dst, const void *src, size_t n);\n"
    buf = buf + "#else\n"
    buf = buf + "static void *__attribute__((noinline)) hxlcl_memcpy(void *dst, const void *src, size_t n) {\n"
    buf = buf + "    unsigned char *d = (unsigned char *)dst;\n"
    buf = buf + "    const unsigned char *s = (const unsigned char *)src;\n"
    buf = buf + "    for (size_t i = 0; i < n; i++) d[i] = s[i];\n"
    buf = buf + "    return dst;\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "/* F3 ACTIVATION RUNBOOK · Path A — hxlcl_memset self-emit slot.\n"
    buf = buf + " *\n"
    buf = buf + " * DEFAULT build (HEXA_RT_SELFEMIT undefined): the file-local `static`\n"
    buf = buf + " * definition below is used — clang inlines TU-internal calls and pulls in\n"
    buf = buf + " * ZERO libc `memset` extern (preserves the B9.3/RFC-063 0-libc-extern\n"
    buf = buf + " * freestanding invariant). This is the unchanged behavior.\n"
    buf = buf + " *\n"
    buf = buf + " * SELF-EMIT build (HEXA_RT_SELFEMIT defined): `hxlcl_memset` becomes an\n"
    buf = buf + " * `extern` declaration (no body here); the strong external `_hxlcl_memset`\n"
    buf = buf + " * symbol is provided by the hexa-emitted Mach-O .o\n"
    buf = buf + " * (test/native_build/emit_hxlcl_memset_o.hexa → rt_memset's 28 bytes),\n"
    buf = buf + " * ahead-linked. ld64 binds every `bl _hxlcl_memset` callsite to the\n"
    buf = buf + " * self-emitted bytes — the C runtime's memset is replaced end-to-end.\n"
    buf = buf + " *\n"
    buf = buf + " * The .o's symbol is an OPT-IN self-emit extern, NOT a libc extern; the\n"
    buf = buf + " * default build (guard off) must keep the libc-extern count unchanged.\n"
    buf = buf + " */\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern void *hxlcl_memset(void *s, int c, size_t n);\n"
    buf = buf + "#else\n"
    buf = buf + "static void *__attribute__((noinline)) hxlcl_memset(void *s, int c, size_t n) {\n"
    buf = buf + "    unsigned char *p = (unsigned char *)s;\n"
    buf = buf + "    unsigned char v = (unsigned char)c;\n"
    buf = buf + "    for (size_t i = 0; i < n; i++) p[i] = v;\n"
    buf = buf + "    return s;\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "// F3 ACTIVATION RUNBOOK · Path A — hxlcl_memmove self-emit slot (rt_memmove, 64 B).\n"
    buf = buf + "// NOTE: rt_memmove uses `dst <= src ? forward` (vs C body `dst < src`); the two\n"
    buf = buf + "// differ only at dst==src, where a forward copy of identical bytes is a no-op —\n"
    buf = buf + "// output byte-identical to the early-return C path.\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern void *hxlcl_memmove(void *dst, const void *src, size_t n);\n"
    buf = buf + "#else\n"
    buf = buf + "static void *__attribute__((noinline)) hxlcl_memmove(void *dst, const void *src, size_t n) {\n"
    buf = buf + "    unsigned char *d = (unsigned char *)dst;\n"
    buf = buf + "    const unsigned char *s = (const unsigned char *)src;\n"
    buf = buf + "    if (d == s || n == 0) return dst;\n"
    buf = buf + "    if (d < s) {\n"
    buf = buf + "        for (size_t i = 0; i < n; i++) d[i] = s[i];\n"
    buf = buf + "    } else {\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        for (size_t i = n; i > 0; i--) d[i - 1] = s[i - 1];\n"
    buf = buf + "    }\n"
    buf = buf + "    return dst;\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "// F3 ACTIVATION RUNBOOK · Path A — hxlcl_strncpy self-emit slot (rt_strncpy, 56 B).\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern char *hxlcl_strncpy(char *dst, const char *src, size_t n);\n"
    buf = buf + "#else\n"
    buf = buf + "static char *__attribute__((noinline)) hxlcl_strncpy(char *dst, const char *src, size_t n) {\n"
    buf = buf + "    size_t i = 0;\n"
    buf = buf + "    for (; i < n && src[i]; i++) dst[i] = src[i];\n"
    buf = buf + "    for (; i < n; i++) dst[i] = '\\0';\n"
    buf = buf + "    return dst;\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "// F3 ACTIVATION RUNBOOK · Path A — hxlcl_strcpy self-emit slot (rt_strcpy, 28 B).\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern char *hxlcl_strcpy(char *dst, const char *src);\n"
    buf = buf + "#else\n"
    buf = buf + "static char *__attribute__((noinline)) hxlcl_strcpy(char *dst, const char *src) {\n"
    buf = buf + "    size_t i = 0;\n"
    buf = buf + "    while (((const volatile char *)src)[i]) { dst[i] = src[i]; i++; }\n"
    buf = buf + "    dst[i] = '\\0';\n"
    buf = buf + "    return dst;\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "static const char *__attribute__((noinline)) hxlcl_strerror(int errnum) {\n"
    buf = buf + "    switch (errnum) {\n"
    buf = buf + "        case 0: return \"no error\";\n"
    buf = buf + "        case 1: return \"EPERM\";\n"
    buf = buf + "        case 2: return \"ENOENT\";\n"
    buf = buf + "        case 4: return \"EINTR\";\n"
    buf = buf + "        case 5: return \"EIO\";\n"
    buf = buf + "        case 9: return \"EBADF\";\n"
    buf = buf + "        case 11: return \"EAGAIN\";\n"
    buf = buf + "        case 12: return \"ENOMEM\";\n"
    buf = buf + "        case 13: return \"EACCES\";\n"
    buf = buf + "        case 17: return \"EEXIST\";\n"
    buf = buf + "        case 22: return \"EINVAL\";\n"
    buf = buf + "        case 24: return \"EMFILE\";\n"
    buf = buf + "        case 32: return \"EPIPE\";\n"
    buf = buf + "        default: return \"unknown error\";\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "// cycle 6: strftime forward decl — body after #include\n"
    buf = buf + "static size_t hxlcl_strftime(char *buf, size_t cap, const char *fmt, void *tm);\n"
    buf = buf + "static void *hxlcl_gmtime_r(const void *tp, void *out);\n"
    buf = buf + "// Cycle 52 — minimal printf family. Handles %s/%d/%i/%u/%lld/%ld/%llu/\n"
    buf = buf + "// %lu/%zu/%c/%x/%X/%p/%%, basic width + zero-pad.\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// Cycle 56 (2026-05-21) — real %f/%g/%e/%F/%G/%E formatting added\n"
    buf = buf + "// (default 6 sig digits / 6 fractional digits; rounding via peek-next).\n"
    buf = buf + "// Resolves inbox/patches/stdlib-print-float-emits-type-tag-not-value.md\n"
    buf = buf + "// (anima trainer per-step loss/grad-norm monitoring blocker). Not\n"
    buf = buf + "// bit-exact with libc's Grisu/Ryu — last few ULPs may differ — but\n"
    buf = buf + "// adequate for training observability and diagnostic output.\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_vsnprintf(char *buf, size_t cap, const char *fmt, va_list ap) {\n"
    buf = buf + "    size_t pos = 0;\n"
    buf = buf + "    #define HXLCL_PUT(ch) do { if (pos + 1 < cap) buf[pos] = (ch); pos++; } while (0)\n"
    buf = buf + "    while (*fmt) {\n"
    buf = buf + "        if (*fmt != '%') { HXLCL_PUT(*fmt); fmt++; continue; }\n"
    buf = buf + "        fmt++;\n"
    buf = buf + "        int leftalign = 0, zeropad = 0, width = 0;\n"
    buf = buf + "        int prec = -1;  /* -1 = unset (defaults applied per-conv) */\n"
    buf = buf + "        if (*fmt == '-') { leftalign = 1; fmt++; }\n"
    buf = buf + "        if (*fmt == '+') fmt++;\n"
    buf = buf + "        if (*fmt == ' ') fmt++;\n"
    buf = buf + "        if (*fmt == '#') fmt++;\n"
    buf = buf + "        if (*fmt == '0') { zeropad = 1; fmt++; }\n"
    buf = buf + "        while (*fmt >= '0' && *fmt <= '9') { width = width * 10 + (*fmt - '0'); fmt++; }\n"
    buf = buf + "        if (*fmt == '.') {\n"
    buf = buf + "            fmt++;\n"
    buf = buf + "            prec = 0;\n"
    buf = buf + "            if (*fmt == '*') { prec = va_arg(ap, int); fmt++; if (prec < 0) prec = 0; }\n"
    buf = buf + "            else while (*fmt >= '0' && *fmt <= '9') { prec = prec * 10 + (*fmt - '0'); fmt++; }\n"
    buf = buf + "        }\n"
    buf = buf + "        int lng = 0;\n"
    buf = buf + "        if (*fmt == 'h') { fmt++; if (*fmt == 'h') fmt++; }\n"
    buf = buf + "        else if (*fmt == 'l') { lng = 1; fmt++; if (*fmt == 'l') { lng = 2; fmt++; } }\n"
    buf = buf + "        else if (*fmt == 'z' || *fmt == 'j' || *fmt == 't') { lng = 2; fmt++; }\n"
    buf = buf + "        char conv = *fmt; if (conv == 0) break; fmt++;\n"
    buf = buf + "        char tmp[32]; int tn = 0;\n"
    buf = buf + "        if (conv == '%') { HXLCL_PUT('%'); continue; }\n"
    buf = buf + "        if (conv == 'c') { HXLCL_PUT((char)va_arg(ap, int)); continue; }\n"
    buf = buf + "        if (conv == 's') {\n"
    buf = buf + "            const char *s = va_arg(ap, const char *);\n"
    buf = buf + "            if (!s) s = \"(null)\";\n"
    buf = buf + "            int slen = 0; while (s[slen]) slen++;\n"
    buf = buf + "            int pad = width - slen; if (pad < 0) pad = 0;\n"
    buf = buf + "            if (!leftalign) for (int k = 0; k < pad; k++) HXLCL_PUT(' ');\n"
    buf = buf + "            for (int k = 0; k < slen; k++) HXLCL_PUT(s[k]);\n"
    buf = buf + "            if (leftalign) for (int k = 0; k < pad; k++) HXLCL_PUT(' ');\n"
    buf = buf + "            continue;\n"
    buf = buf + "        }\n"
    buf = buf + "        if (conv == 'd' || conv == 'i') {\n"
    buf = buf + "            long long v;\n"
    buf = buf + "            if (lng == 2) v = va_arg(ap, long long);\n"
    buf = buf + "            else if (lng == 1) v = va_arg(ap, long);\n"
    buf = buf + "            else v = va_arg(ap, int);\n"
    buf = buf + "            int neg = (v < 0);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "            unsigned long long uv = neg ? (unsigned long long)(-(v + 1)) + 1ULL : (unsigned long long)v;\n"
    buf = buf + "            if (uv == 0) tmp[tn++] = '0';\n"
    buf = buf + "            else while (uv) { tmp[tn++] = '0' + (char)(uv % 10); uv /= 10; }\n"
    buf = buf + "            if (neg) tmp[tn++] = '-';\n"
    buf = buf + "        } else if (conv == 'u') {\n"
    buf = buf + "            unsigned long long v;\n"
    buf = buf + "            if (lng == 2) v = va_arg(ap, unsigned long long);\n"
    buf = buf + "            else if (lng == 1) v = va_arg(ap, unsigned long);\n"
    buf = buf + "            else v = va_arg(ap, unsigned int);\n"
    buf = buf + "            if (v == 0) tmp[tn++] = '0';\n"
    buf = buf + "            else while (v) { tmp[tn++] = '0' + (char)(v % 10); v /= 10; }\n"
    buf = buf + "        } else if (conv == 'x' || conv == 'X' || conv == 'p') {\n"
    buf = buf + "            unsigned long long v;\n"
    buf = buf + "            if (conv == 'p') v = (unsigned long long)(uintptr_t)va_arg(ap, void *);\n"
    buf = buf + "            else if (lng == 2) v = va_arg(ap, unsigned long long);\n"
    buf = buf + "            else if (lng == 1) v = va_arg(ap, unsigned long);\n"
    buf = buf + "            else v = va_arg(ap, unsigned int);\n"
    buf = buf + "            char hi = (conv == 'X') ? 'A' : 'a';\n"
    buf = buf + "            if (v == 0) tmp[tn++] = '0';\n"
    buf = buf + "            else while (v) { int d = (int)(v & 0xF); tmp[tn++] = (d < 10) ? ('0' + (char)d) : (hi + (char)d - 10); v >>= 4; }\n"
    buf = buf + "            if (conv == 'p') { tmp[tn++] = 'x'; tmp[tn++] = '0'; }\n"
    buf = buf + "        } else if (conv == 'f' || conv == 'g' || conv == 'e' || conv == 'F' || conv == 'G' || conv == 'E') {\n"
    buf = buf + "            /* Cycle 56 — real double-to-string for %f/%g/%e (default 6 sig\n"
    buf = buf + "             * digits / 6 fractional digits). Not bit-exact with libc's\n"
    buf = buf + "             * Grisu/Ryu but adequate for training observability + diagnostic\n"
    buf = buf + "             * use (println(float), step loss/grad-norm logs). Resolves\n"
    buf = buf + "             * inbox/patches/stdlib-print-float-emits-type-tag-not-value.md. */\n"
    buf = buf + "            double dv = va_arg(ap, double);\n"
    buf = buf + "            /* nan/inf via bit pattern (no libc isnan/isinf available). */\n"
    buf = buf + "            union { double d; unsigned long long u; } __pun;\n"
    buf = buf + "            __pun.d = dv;\n"
    buf = buf + "            unsigned long long bits = __pun.u;\n"
    buf = buf + "            int signbit = (int)(bits >> 63);\n"
    buf = buf + "            unsigned long long exp_bits = (bits >> 52) & 0x7FFULL;\n"
    buf = buf + "            unsigned long long mant_bits = bits & 0xFFFFFFFFFFFFFULL;\n"
    buf = buf + "            /* fbuf sized for worst case %f of ~1e308 (sign + ~310 digits +\n"
    buf = buf + "             * '.' + 6 frac + null). */\n"
    buf = buf + "            char fbuf[352]; int fn = 0;\n"
    buf = buf + "            int is_upper = (conv == 'F' || conv == 'G' || conv == 'E');\n"
    buf = buf + "            if (exp_bits == 0x7FF) {\n"
    buf = buf + "                if (mant_bits) {\n"
    buf = buf + "                    const char *s = is_upper ? \"NAN\" : \"nan\";\n"
    buf = buf + "                    for (int k = 0; s[k]; k++) fbuf[fn++] = s[k];\n"
    buf = buf + "                } else {\n"
    buf = buf + "                    if (signbit) fbuf[fn++] = '-';\n"
    buf = buf + "                    const char *s = is_upper ? \"INF\" : \"inf\";\n"
    buf = buf + "                    for (int k = 0; s[k]; k++) fbuf[fn++] = s[k];\n"
    buf = buf + "                }\n"
    buf = buf + "            } else {\n"
    buf = buf + "                if (signbit) { fbuf[fn++] = '-'; dv = -dv; }\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "                /* %f default prec = 6 (fractional digits); %g default = 6\n"
    buf = buf + "                 * (significant digits); %e default = 6 (digits after\n"
    buf = buf + "                 * decimal in scientific). */\n"
    buf = buf + "                int prec_eff = (prec < 0) ? 6 : prec;\n"
    buf = buf + "                if ((conv == 'g' || conv == 'G') && prec_eff == 0) prec_eff = 1;\n"
    buf = buf + "                if (dv == 0.0) {\n"
    buf = buf + "                    fbuf[fn++] = '0';\n"
    buf = buf + "                    if (conv == 'f' || conv == 'F') {\n"
    buf = buf + "                        if (prec_eff > 0) {\n"
    buf = buf + "                            fbuf[fn++] = '.';\n"
    buf = buf + "                            for (int k = 0; k < prec_eff; k++) fbuf[fn++] = '0';\n"
    buf = buf + "                        }\n"
    buf = buf + "                    } else if (conv == 'e' || conv == 'E') {\n"
    buf = buf + "                        if (prec_eff > 0) {\n"
    buf = buf + "                            fbuf[fn++] = '.';\n"
    buf = buf + "                            for (int k = 0; k < prec_eff; k++) fbuf[fn++] = '0';\n"
    buf = buf + "                        }\n"
    buf = buf + "                        fbuf[fn++] = is_upper ? 'E' : 'e';\n"
    buf = buf + "                        fbuf[fn++] = '+'; fbuf[fn++] = '0'; fbuf[fn++] = '0';\n"
    buf = buf + "                    }\n"
    buf = buf + "                    /* %g of 0.0 → just \"0\" */\n"
    buf = buf + "                } else {\n"
    buf = buf + "                    /* Normalize: 1.0 <= dv < 10.0, track decimal exponent. */\n"
    buf = buf + "                    int e10 = 0;\n"
    buf = buf + "                    while (dv >= 1e16) { dv *= 1e-16; e10 += 16; }\n"
    buf = buf + "                    while (dv >= 1e4)  { dv *= 1e-4;  e10 += 4;  }\n"
    buf = buf + "                    while (dv >= 10.0) { dv *= 0.1;   e10 += 1;  }\n"
    buf = buf + "                    while (dv < 1e-15) { dv *= 1e16;  e10 -= 16; }\n"
    buf = buf + "                    while (dv < 1e-3)  { dv *= 1e4;   e10 -= 4;  }\n"
