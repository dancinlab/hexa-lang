    buf = buf + "    int64_t na = (int64_t)HX_ARR_LEN(a), nb = (int64_t)HX_ARR_LEN(b);\n"
    buf = buf + "    int64_t k = na < nb ? na : nb;\n"
    buf = buf + "    double s = 0.0;\n"
    buf = buf + "    for (int64_t i = 0; i < k; i++) {\n"
