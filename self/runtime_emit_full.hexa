    buf = buf + "// SAME errno every other runtime syscall reads. Verified byte-identical to\n"
    buf = buf + "// `as -arch arm64` AND JIT-exec-correct: close(valid)→0/errno untouched,\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// close(bad)→-1/errno=EBADF(9) (see the emit driver's §HONESTY).\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int hxlcl_close(int fd);\n"
    buf = buf + "#else\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_close(int fd) { return (int)_hxlcl_syscall1_cf(HXLCL_SYS_CLOSE, (long)fd); }\n"
    buf = buf + "#endif\n"
    buf = buf + "// F3 wave 3 — 1-arg / errno-reloc family bodies. Three ptr-arg primitives\n"
    buf = buf + "// (chdir/unlink/rmdir, no sxtw — 8-instr 32 B body) AUTHOR the NEW sub-template\n"
