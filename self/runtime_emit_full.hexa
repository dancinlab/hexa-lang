    buf = buf + "static int hxlcl_isalpha(int c);\n"
    buf = buf + "// RUNTIME.md step-2 cycle 3 — pthread stubs MOVED to\n"
    buf = buf + "// stdlib/runtime/thread.hexa (single noop + create policy hexa fns).\n"
    buf = buf + "// Thin C shims delegate. forward decls only here; bodies after include.\n"
    buf = buf + "static int hxlcl_pthread_mutex_init(void *m, const void *a);\n"
    buf = buf + "static int hxlcl_pthread_mutex_destroy(void *m);\n"
    buf = buf + "static int hxlcl_pthread_mutex_lock(void *m);\n"
    buf = buf + "static int hxlcl_pthread_mutex_unlock(void *m);\n"
    buf = buf + "static int hxlcl_pthread_cond_init(void *c, const void *a);\n"
    buf = buf + "static int hxlcl_pthread_cond_destroy(void *c);\n"
    buf = buf + "static int hxlcl_pthread_cond_signal(void *c);\n"
    buf = buf + "static int hxlcl_pthread_cond_broadcast(void *c);\n"
    buf = buf + "static int hxlcl_pthread_cond_wait(void *c, void *m);\n"
    buf = buf + "static int hxlcl_pthread_cond_timedwait(void *c, void *m, const void *ts);\n"
    buf = buf + "static int hxlcl_pthread_create(void *thread, const void *attr, void *(*start)(void *), void *arg);\n"
    buf = buf + "static int hxlcl_pthread_join(void *thread, void **retval);\n"
    buf = buf + "// Cycle 63 — Darwin BSD ABI syscall wrappers via inline `svc 0x80`.\n"
    buf = buf + "// Each call: x16 = syscall number, x0..x5 = args, svc 0x80 → x0 = ret.\n"
    buf = buf + "// Replaces libc syscall wrappers (_read, _write, _open, etc) with\n"
    buf = buf + "// direct kernel trap. Darwin arm64 ONLY — `svc #0x80` + the BSD SYS_*\n"
    buf = buf + "// numbers below are the Darwin ABI. `__aarch64__` alone is NOT enough:\n"
    buf = buf + "// it is also defined on arm64 Linux (which needs `svc #0` + a different\n"
    buf = buf + "// table), so the gate requires `__APPLE__`. Linux of any arch routes\n"
    buf = buf + "// through the libc branch below.\n"
    buf = buf + "#if (defined(__arm64__) || defined(__aarch64__)) && defined(__APPLE__)\n"
    buf = buf + "#define HXLCL_SYS_EXIT      1\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "#define HXLCL_SYS_FORK      2\n"
    buf = buf + "#define HXLCL_SYS_READ      3\n"
    buf = buf + "#define HXLCL_SYS_WRITE     4\n"
    buf = buf + "#define HXLCL_SYS_OPEN      5\n"
    buf = buf + "#define HXLCL_SYS_CLOSE     6\n"
    buf = buf + "#define HXLCL_SYS_WAIT4     7\n"
    buf = buf + "#define HXLCL_SYS_KILL     37\n"
    buf = buf + "#define HXLCL_SYS_PIPE     42\n"
    buf = buf + "#define HXLCL_SYS_DUP2     90\n"
    buf = buf + "#define HXLCL_SYS_FCNTL    92\n"
    buf = buf + "#define HXLCL_SYS_SELECT   93\n"
    buf = buf + "#define HXLCL_SYS_GETPID   20\n"
    buf = buf + "#define HXLCL_SYS_GETUID   24\n"
    buf = buf + "#define HXLCL_SYS_IOCTL    54\n"
    buf = buf + "#define HXLCL_SYS_POLL    230\n"
    buf = buf + "#define HXLCL_SYS_FSTAT   339\n"
    buf = buf + "#define HXLCL_SYS_STAT    338\n"
    buf = buf + "#define HXLCL_SYS_LSEEK   199\n"
    buf = buf + "#define HXLCL_SYS_MMAP    197\n"
    buf = buf + "#define HXLCL_SYS_FLOCK   131\n"
    buf = buf + "#define HXLCL_SYS_EXECVE   59\n"
    buf = buf + "#define HXLCL_SYS_MKDIR   136\n"
    buf = buf + "// RUNTIME net/exec ③④ (cycle 78): socket + message-group Darwin syscall #s.\n"
    buf = buf + "// NB: no SYS_recv/SYS_send on Darwin — recv/send are libc wrappers over\n"
    buf = buf + "// recvfrom/sendto, so we route to those with NULL addr args.\n"
    buf = buf + "#define HXLCL_SYS_RECVMSG      27\n"
    buf = buf + "#define HXLCL_SYS_SENDMSG      28\n"
    buf = buf + "#define HXLCL_SYS_RECVFROM     29\n"
    buf = buf + "#define HXLCL_SYS_ACCEPT       30\n"
    buf = buf + "#define HXLCL_SYS_SENDTO      133\n"
    buf = buf + "#define HXLCL_SYS_SOCKET       97\n"
    buf = buf + "#define HXLCL_SYS_CONNECT      98\n"
    buf = buf + "#define HXLCL_SYS_BIND        104\n"
    buf = buf + "#define HXLCL_SYS_SETSOCKOPT  105\n"
    buf = buf + "#define HXLCL_SYS_LISTEN      106\n"
    buf = buf + "// F3 wave 2 — class-C 0-arg / cannot-fail svc-traps (getuid family extension)\n"
    buf = buf + "#define HXLCL_SYS_GETEUID      25\n"
    buf = buf + "#define HXLCL_SYS_GETEGID      43\n"
    buf = buf + "#define HXLCL_SYS_GETGID       47\n"
    buf = buf + "#define HXLCL_SYS_GETPPID      39\n"
    buf = buf + "// F3 wave 3 — class-C 1-arg / errno-reloc svc-traps (close family extension)\n"
    buf = buf + "// Two sub-templates:\n"
    buf = buf + "//   ptr-arg   (no sxtw)  : chdir(12), unlink(10), rmdir(137) — 8-instr 32 B\n"
    buf = buf + "//   int-arg   (sxtw x0)  : fsync(95), dup(41) — 9-instr 36 B (close shape)\n"
    buf = buf + "#define HXLCL_SYS_CHDIR        12\n"
    buf = buf + "#define HXLCL_SYS_UNLINK       10\n"
    buf = buf + "#define HXLCL_SYS_RMDIR       137\n"
    buf = buf + "#define HXLCL_SYS_FSYNC        95\n"
    buf = buf + "#define HXLCL_SYS_DUP          41\n"
    buf = buf + "// F3 wave 4 — class-C 2-arg / 3-arg errno-reloc svc-traps. Three sub-templates:\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "//   2-arg ptr+int  (sxtw x1)         : chmod(15), access(33) — 9-instr 36 B (mkdir shape)\n"
    buf = buf + "//   2-arg ptr+long (no sxtw)         : truncate(200) — 8-instr 32 B (stat shape)\n"
    buf = buf + "//   3-arg ptr+int+int (sxtw x1+x2)   : chown(16), lchown(364) — 10-instr 40 B (NEW shape)\n"
    buf = buf + "#define HXLCL_SYS_CHMOD        15\n"
    buf = buf + "#define HXLCL_SYS_ACCESS       33\n"
    buf = buf + "#define HXLCL_SYS_TRUNCATE    200\n"
    buf = buf + "#define HXLCL_SYS_CHOWN        16\n"
    buf = buf + "#define HXLCL_SYS_LCHOWN      364\n"
    buf = buf + "\n"
    buf = buf + "static inline long _hxlcl_syscall1(long nr, long a0) {\n"
    buf = buf + "    register long x0 __asm__(\"x0\") = a0;\n"
    buf = buf + "    register long x16 __asm__(\"x16\") = nr;\n"
    buf = buf + "    __asm__ volatile(\"svc #0x80\" : \"+r\"(x0) : \"r\"(x16) : \"memory\", \"cc\");\n"
    buf = buf + "    return x0;\n"
    buf = buf + "}\n"
    buf = buf + "static inline long _hxlcl_syscall2(long nr, long a0, long a1) {\n"
    buf = buf + "    register long x0 __asm__(\"x0\") = a0;\n"
    buf = buf + "    register long x1 __asm__(\"x1\") = a1;\n"
    buf = buf + "    register long x16 __asm__(\"x16\") = nr;\n"
    buf = buf + "    __asm__ volatile(\"svc #0x80\" : \"+r\"(x0) : \"r\"(x1), \"r\"(x16) : \"memory\", \"cc\");\n"
    buf = buf + "    return x0;\n"
    buf = buf + "}\n"
    buf = buf + "static inline long _hxlcl_syscall3(long nr, long a0, long a1, long a2) {\n"
    buf = buf + "    register long x0 __asm__(\"x0\") = a0;\n"
    buf = buf + "    register long x1 __asm__(\"x1\") = a1;\n"
    buf = buf + "    register long x2 __asm__(\"x2\") = a2;\n"
    buf = buf + "    register long x16 __asm__(\"x16\") = nr;\n"
    buf = buf + "    __asm__ volatile(\"svc #0x80\" : \"+r\"(x0) : \"r\"(x1), \"r\"(x2), \"r\"(x16) : \"memory\", \"cc\");\n"
    buf = buf + "    return x0;\n"
    buf = buf + "}\n"
    buf = buf + "static inline long _hxlcl_syscall4(long nr, long a0, long a1, long a2, long a3) {\n"
    buf = buf + "    register long x0 __asm__(\"x0\") = a0;\n"
    buf = buf + "    register long x1 __asm__(\"x1\") = a1;\n"
    buf = buf + "    register long x2 __asm__(\"x2\") = a2;\n"
    buf = buf + "    register long x3 __asm__(\"x3\") = a3;\n"
    buf = buf + "    register long x16 __asm__(\"x16\") = nr;\n"
    buf = buf + "    __asm__ volatile(\"svc #0x80\" : \"+r\"(x0) : \"r\"(x1), \"r\"(x2), \"r\"(x3), \"r\"(x16) : \"memory\", \"cc\");\n"
    buf = buf + "    return x0;\n"
    buf = buf + "}\n"
    buf = buf + "static inline long _hxlcl_syscall6(long nr, long a0, long a1, long a2, long a3, long a4, long a5) {\n"
    buf = buf + "    register long x0 __asm__(\"x0\") = a0;\n"
    buf = buf + "    register long x1 __asm__(\"x1\") = a1;\n"
    buf = buf + "    register long x2 __asm__(\"x2\") = a2;\n"
    buf = buf + "    register long x3 __asm__(\"x3\") = a3;\n"
    buf = buf + "    register long x4 __asm__(\"x4\") = a4;\n"
    buf = buf + "    register long x5 __asm__(\"x5\") = a5;\n"
    buf = buf + "    register long x16 __asm__(\"x16\") = nr;\n"
    buf = buf + "    __asm__ volatile(\"svc #0x80\" : \"+r\"(x0) : \"r\"(x1), \"r\"(x2), \"r\"(x3), \"r\"(x4), \"r\"(x5), \"r\"(x16) : \"memory\", \"cc\");\n"
    buf = buf + "    return x0;\n"
    buf = buf + "}\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "\n"
    buf = buf + "// cycle 70 — CARRY-FLAG-CORRECT svc 0x80 syscall traps.\n"
    buf = buf + "//\n"
    buf = buf + "// The Darwin arm64 BSD syscall ABI (`svc #0x80`) signals an ERROR by\n"
    buf = buf + "// setting the carry flag (C bit of NZCV/PSTATE) and returning the\n"
    buf = buf + "// POSITIVE errno in x0; on success the carry flag is clear and x0 holds\n"
    buf = buf + "// the result. The cycle-63/64 `_hxlcl_syscall{1..6}` helpers above\n"
    buf = buf + "// IGNORE the carry flag, so a failed syscall returned a small positive\n"
    buf = buf + "// errno that callers mistook for a valid fd/offset (e.g. ENOENT=2 looked\n"
    buf = buf + "// like fd 2). That is exactly why PR #251 (`8ea4b75e`) reverted the\n"
    buf = buf + "// read/write/close/... bodies to libc.\n"
    buf = buf + "//\n"
    buf = buf + "// These `_cf` variants capture the carry flag with `cset cs` immediately\n"
    buf = buf + "// after `svc`, then translate the kernel convention into the libc-style\n"
    buf = buf + "// convention the rest of the runtime expects: on carry, set the\n"
    buf = buf + "// hexa-native `errno` (= `hxlcl_errno` via the top-of-file #define) to\n"
    buf = buf + "// the positive errno and return -1; on success return x0 unchanged.\n"
    buf = buf + "static inline long _hxlcl_syscall1_cf(long nr, long a0) {\n"
    buf = buf + "    register long x0 __asm__(\"x0\") = a0;\n"
    buf = buf + "    register long x16 __asm__(\"x16\") = nr;\n"
    buf = buf + "    register long cf;\n"
    buf = buf + "    __asm__ volatile(\"svc #0x80\\n\\tcset %1, cs\"\n"
    buf = buf + "                     : \"+r\"(x0), \"=r\"(cf) : \"r\"(x16) : \"memory\", \"cc\");\n"
    buf = buf + "    if (cf) { errno = (int)x0; return -1; }\n"
    buf = buf + "    return x0;\n"
    buf = buf + "}\n"
    buf = buf + "static inline long _hxlcl_syscall3_cf(long nr, long a0, long a1, long a2) {\n"
    buf = buf + "    register long x0 __asm__(\"x0\") = a0;\n"
    buf = buf + "    register long x1 __asm__(\"x1\") = a1;\n"
    buf = buf + "    register long x2 __asm__(\"x2\") = a2;\n"
    buf = buf + "    register long x16 __asm__(\"x16\") = nr;\n"
    buf = buf + "    register long cf;\n"
    buf = buf + "    __asm__ volatile(\"svc #0x80\\n\\tcset %1, cs\"\n"
    buf = buf + "                     : \"+r\"(x0), \"=r\"(cf) : \"r\"(x1), \"r\"(x2), \"r\"(x16) : \"memory\", \"cc\");\n"
    buf = buf + "    if (cf) { errno = (int)x0; return -1; }\n"
    buf = buf + "    return x0;\n"
    buf = buf + "}\n"
    buf = buf + "// cycle 71 — additional carry-flag-correct arities for the remaining R\n"
    buf = buf + "// syscall group (dup2/fstat/stat = 2-arg, lseek/open = 3-arg already via\n"
    buf = buf + "// _cf3, wait4 = 4-arg, mmap = 6-arg). Same carry-on-error -> -1 + errno\n"
    buf = buf + "// translation as the cycle-70 cf1/cf3 helpers.\n"
    buf = buf + "static inline long _hxlcl_syscall2_cf(long nr, long a0, long a1) {\n"
    buf = buf + "    register long x0 __asm__(\"x0\") = a0;\n"
    buf = buf + "    register long x1 __asm__(\"x1\") = a1;\n"
    buf = buf + "    register long x16 __asm__(\"x16\") = nr;\n"
    buf = buf + "    register long cf;\n"
    buf = buf + "    __asm__ volatile(\"svc #0x80\\n\\tcset %1, cs\"\n"
    buf = buf + "                     : \"+r\"(x0), \"=r\"(cf) : \"r\"(x1), \"r\"(x16) : \"memory\", \"cc\");\n"
    buf = buf + "    if (cf) { errno = (int)x0; return -1; }\n"
    buf = buf + "    return x0;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "}\n"
    buf = buf + "static inline long _hxlcl_syscall4_cf(long nr, long a0, long a1, long a2, long a3) {\n"
    buf = buf + "    register long x0 __asm__(\"x0\") = a0;\n"
    buf = buf + "    register long x1 __asm__(\"x1\") = a1;\n"
    buf = buf + "    register long x2 __asm__(\"x2\") = a2;\n"
    buf = buf + "    register long x3 __asm__(\"x3\") = a3;\n"
    buf = buf + "    register long x16 __asm__(\"x16\") = nr;\n"
    buf = buf + "    register long cf;\n"
    buf = buf + "    __asm__ volatile(\"svc #0x80\\n\\tcset %1, cs\"\n"
    buf = buf + "                     : \"+r\"(x0), \"=r\"(cf) : \"r\"(x1), \"r\"(x2), \"r\"(x3), \"r\"(x16) : \"memory\", \"cc\");\n"
    buf = buf + "    if (cf) { errno = (int)x0; return -1; }\n"
    buf = buf + "    return x0;\n"
    buf = buf + "}\n"
    buf = buf + "static inline long _hxlcl_syscall6_cf(long nr, long a0, long a1, long a2, long a3, long a4, long a5) {\n"
    buf = buf + "    register long x0 __asm__(\"x0\") = a0;\n"
    buf = buf + "    register long x1 __asm__(\"x1\") = a1;\n"
    buf = buf + "    register long x2 __asm__(\"x2\") = a2;\n"
    buf = buf + "    register long x3 __asm__(\"x3\") = a3;\n"
    buf = buf + "    register long x4 __asm__(\"x4\") = a4;\n"
    buf = buf + "    register long x5 __asm__(\"x5\") = a5;\n"
    buf = buf + "    register long x16 __asm__(\"x16\") = nr;\n"
    buf = buf + "    register long cf;\n"
    buf = buf + "    __asm__ volatile(\"svc #0x80\\n\\tcset %1, cs\"\n"
    buf = buf + "                     : \"+r\"(x0), \"=r\"(cf) : \"r\"(x1), \"r\"(x2), \"r\"(x3), \"r\"(x4), \"r\"(x5), \"r\"(x16) : \"memory\", \"cc\");\n"
    buf = buf + "    if (cf) { errno = (int)x0; return -1; }\n"
    buf = buf + "    return x0;\n"
    buf = buf + "}\n"
    buf = buf + "// cycle 71 — pipe(2) PAIR-RETURN carry-flag trap. The Darwin BSD pipe\n"
    buf = buf + "// syscall returns the two fds in x0 AND x1 registers (NOT in the user\n"
    buf = buf + "// int[2] -- that was the cycle-63/64 bug that left fds[1] garbage). This\n"
    buf = buf + "// helper captures BOTH registers via an explicit asm block (the\n"
    buf = buf + "// register-constrained `\"=r\"(x1)` form confused clang into a hang during\n"
    buf = buf + "// validation), checks the carry flag for failure, and writes both fds on\n"
    buf = buf + "// success. Probe-verified: pipe->fds 3,4 + write(6)/read(6) roundtrip OK.\n"
    buf = buf + "static inline int _hxlcl_pipe_cf(int fds[2]) {\n"
    buf = buf + "    long r0, r1, cf;\n"
    buf = buf + "    __asm__ volatile(\"mov x16, #42\\n\\tsvc #0x80\\n\\tcset %2, cs\\n\\tmov %0, x0\\n\\tmov %1, x1\"\n"
    buf = buf + "                     : \"=r\"(r0), \"=r\"(r1), \"=r\"(cf) :: \"x0\", \"x1\", \"x16\", \"memory\", \"cc\");\n"
    buf = buf + "    if (cf) { errno = (int)r0; return -1; }\n"
    buf = buf + "    fds[0] = (int)r0; fds[1] = (int)r1;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// cycle 70 — read/write/close re-trapped via carry-flag-correct svc 0x80\n"
    buf = buf + "// (the inverse of PR #251's revert, but carry-correct this time). This is\n"
    buf = buf + "// the 3-syscall PROOF: read=SYS_READ(3), write=SYS_WRITE(4),\n"
    buf = buf + "// close=SYS_CLOSE(6). The remaining 31 R syscalls stay on libc until a\n"
    buf = buf + "// follow-up cycle scales this same `_cf` pattern. A failed read/close now\n"
    buf = buf + "// returns -1 + sets errno (not a bogus positive errno-as-result), so the\n"
    buf = buf + "// content-leak / bogus-fd hazards that motivated #251 cannot recur.\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// B9.6-C12 (F3 Path A) — DEFAULT: file-local `static` 3-arg _cf svc-trap\n"
    buf = buf + "// (0-libc-extern preserved). HEXA_RT_SELFEMIT: `extern`, body supplied by the\n"
    buf = buf + "// self-emit .o (rt_read's 36-byte rt_close-shape body: sxtw x0/fd only, buf/n\n"
    buf = buf + "// untouched, full _cf errno tail, errno relocs @0x14/0x18, SYS_READ=3).\n"
    buf = buf + "#ifndef HEXA_RT_SELFEMIT\n"
    buf = buf + "static long __attribute__((noinline)) hxlcl_read(int fd, void *buf, unsigned long n) { return _hxlcl_syscall3_cf(HXLCL_SYS_READ, (long)fd, (long)buf, (long)n); }\n"
    buf = buf + "#endif\n"
    buf = buf + "// RUNTIME tail (cycle 82): svc-trap mkdir (136) — a direct kernel syscall,\n"
    buf = buf + "// 2 args. Replaces the libc mkdir call in runtime_core.c + the generated\n"
    buf = buf + "// code's s4-lowered mkdir. carry-set -> -1 + errno.\n"
    buf = buf + "// F3 ACTIVATION · Path A — B9.6-C5 class-C syscall-ABI self-emit slot.\n"
    buf = buf + "// hxlcl_mkdir is a 2-arg _cf with a POINTER first arg (path, x0 untouched) +\n"
    buf = buf + "// an int second arg (mode, x1 sign-extended) — same 9-instr length as close,\n"
    buf = buf + "// only the sxtw register + SYS number differ. DEFAULT build keeps the static\n"
    buf = buf + "// _cf svc-trap. SELF-EMIT build flips to extern; the strong `_hxlcl_mkdir`\n"
    buf = buf + "// symbol comes from the hexa-emitted .o (rt_mkdir's 36-byte body), ahead-\n"
    buf = buf + "// linked. errno store = PC-relative adrp/str to hxlcl_errno (links under guard).\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int hxlcl_mkdir(const char *path, int mode);\n"
    buf = buf + "#else\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_mkdir(const char *path, int mode) { return (int)_hxlcl_syscall2_cf(HXLCL_SYS_MKDIR, (long)path, (long)mode); }\n"
    buf = buf + "#endif\n"
    buf = buf + "// B9.6-C13 (F3 Path A) — DEFAULT: file-local `static` 3-arg _cf svc-trap.\n"
    buf = buf + "// HEXA_RT_SELFEMIT: `extern`, body supplied by the self-emit .o (rt_write's\n"
    buf = buf + "// 36-byte rt_read twin, SYS_WRITE=4, errno relocs @0x14/0x18).\n"
    buf = buf + "#ifndef HEXA_RT_SELFEMIT\n"
    buf = buf + "static long __attribute__((noinline)) hxlcl_write(int fd, const void *buf, unsigned long n) { return _hxlcl_syscall3_cf(HXLCL_SYS_WRITE, (long)fd, (long)buf, (long)n); }\n"
    buf = buf + "#endif\n"
    buf = buf + "// F3 ACTIVATION RUNBOOK · Path A — B9.6-C2 class-C syscall WITH arg + errno.\n"
    buf = buf + "//\n"
    buf = buf + "// hxlcl_close is the SECOND class-C svc emitter (after #1860 getpid) and the\n"
    buf = buf + "// FIRST carrying a syscall ARGUMENT (fd) + the Darwin CARRY-FLAG error path +\n"
    buf = buf + "// an errno store. SYS_CLOSE(6), 1 arg; on carry the positive errno is written\n"
    buf = buf + "// to `hxlcl_errno` (a fixed DATA SYMBOL reached PC-relatively via adrp/str —\n"
    buf = buf + "// REQUIRED, since the close svc clobbers the arg registers on the error path)\n"
    buf = buf + "// and -1 returned.\n"
    buf = buf + "//\n"
    buf = buf + "// DEFAULT build (HEXA_RT_SELFEMIT undefined): the file-local `static` _cf\n"
    buf = buf + "// svc-trap body below is used — UNCHANGED behavior, 0-libc-extern invariant\n"
    buf = buf + "// preserved (close is issued via inline svc asm, never a libc symbol).\n"
    buf = buf + "//\n"
    buf = buf + "// SELF-EMIT build (HEXA_RT_SELFEMIT defined): becomes an `extern` declaration\n"
    buf = buf + "// (no body); the strong external `_hxlcl_close` symbol comes from the\n"
    buf = buf + "// hexa-emitted Mach-O .o (test/native_build/emit_hxlcl_close_o.hexa →\n"
    buf = buf + "// rt_close's 36-byte sxtw / mov w16,#6 / svc / cset / cbz / adrp,errno / str /\n"
    buf = buf + "// mov x0,#-1 / ret), ahead-linked. The .o declares `_hxlcl_errno` as an\n"
    buf = buf + "// UNDEFINED external; ld64 binds it to the `hxlcl_errno` cell (made non-static\n"
