    buf = buf + "    return rt_str_bytes(s);\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// ── bt-71: libc / builtin family wrappers ────────────────────────────\n"
    buf = buf + "// interpreter.hexa references bare idents like `exit(code)`, `tanh(x)`,\n"
    buf = buf + "// `input()`, `is_error(v)`, `read_lines(p)`, `env_var(n)`, `hex(n)`, etc.\n"
    buf = buf + "// Codegen used to emit `hexa_call1(exit, hexa_int(0))` which passes the\n"
    buf = buf + "// libc function pointer (wrong type) to hexa_call1(HexaVal, HexaVal).\n"
    buf = buf + "// We now wrap each in a HexaVal-returning stub so codegen can emit a\n"
    buf = buf + "// direct call with correct types.\n"
    buf = buf + "#include <unistd.h>\n"
    buf = buf + "#include <time.h>\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_sleep(HexaVal sec) {\n"
    buf = buf + "    double s = HX_IS_FLOAT(sec) ? HX_FLOAT(sec)\n"
    buf = buf + "             : HX_IS_INT(sec)   ? (double)HX_INT(sec)\n"
    buf = buf + "             : 0.0;\n"
    buf = buf + "    if (s <= 0.0) return hexa_void();\n"
    buf = buf + "    struct timespec ts;\n"
    buf = buf + "    ts.tv_sec  = (time_t)s;\n"
    buf = buf + "    ts.tv_nsec = (long)((s - (double)ts.tv_sec) * 1e9);\n"
    buf = buf + "    hxlcl_nanosleep(&ts, NULL);\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Math family — accept int or float, return float\n"
    buf = buf + "static double _hexa_f(HexaVal v) {\n"
    buf = buf + "    if (HX_IS_FLOAT(v)) return HX_FLOAT(v);\n"
    buf = buf + "    if (HX_IS_INT(v))   return (double)HX_INT(v);\n"
    buf = buf + "    if (HX_IS_BOOL(v))  return HX_BOOL(v) ? 1.0 : 0.0;\n"
    buf = buf + "    return 0.0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Safe float→int64 cast. C cast of NaN/Inf/out-of-range double is UB\n"
    buf = buf + "// (typically INT64_MIN on x86). Returns 0 for NaN/Inf, clamps to int64\n"
    buf = buf + "// range otherwise. Used by to_int() builtin.\n"
    buf = buf + "int64_t hexa_float_to_int(double f) {\n"
    buf = buf + "    if (isnan(f) || isinf(f)) return 0;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    if (f >= 9.2233720368547758e+18) return (int64_t)0x7fffffffffffffffLL;\n"
    buf = buf + "    if (f <= -9.2233720368547758e+18) return (int64_t)0x8000000000000000LL;\n"
    buf = buf + "    return (int64_t)f;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Step-3 cycle 38 batch — hexa_math_* wrappers that have direct rt_*\n"
    buf = buf + "// counterparts gain the two-mode dispatch. The hexa-source path stays\n"
    buf = buf + "// libm-free; the libm-flavoured names (asin/acos/atan/atan2) have no\n"
    buf = buf + "// rt_ equivalent yet and remain on the C path. sin/cos/exp/log already\n"
    buf = buf + "// route through hxlcl_* which itself calls rt_* (runtime.c:1317-1320),\n"
    buf = buf + "// so no additional wrapping is needed for them.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_math_tanh(HexaVal x) { return hexa_float(_hx_tanh(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_tan(HexaVal x)  { return hexa_float(_hx_tan(HX_FLOAT(x))); }\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_tanh(HexaVal x);\n"
    buf = buf + "extern HexaVal rt_tan(HexaVal x);\n"
    buf = buf + "extern HexaVal rt_abs_float(HexaVal v);\n"
    buf = buf + "extern HexaVal rt_sqrt(HexaVal v);\n"
    buf = buf + "HexaVal hexa_math_tanh(HexaVal x) { return rt_tanh(hexa_float(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_tan(HexaVal x)  { return rt_tan(hexa_float(HX_FLOAT(x))); }\n"
    buf = buf + "#endif\n"
    buf = buf + "HexaVal hexa_math_sin(HexaVal x)  { return hexa_float(hxlcl_sin(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_cos(HexaVal x)  { return hexa_float(hxlcl_cos(HX_FLOAT(x))); }\n"
    buf = buf + "// Step-3 cycle 40 — inverse trig dispatch to rt_atan/asin/acos. atan2\n"
    buf = buf + "// has no rt_ counterpart yet (two-arg quadrant resolution); it stays\n"
    buf = buf + "// on libm.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_math_asin(HexaVal x) { return hexa_float(_hx_asin(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_acos(HexaVal x) { return hexa_float(_hx_acos(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_atan(HexaVal x) { return hexa_float(_hx_atan(HX_FLOAT(x))); }\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_asin(HexaVal x);\n"
    buf = buf + "extern HexaVal rt_acos(HexaVal x);\n"
    buf = buf + "extern HexaVal rt_atan(HexaVal x);\n"
    buf = buf + "HexaVal hexa_math_asin(HexaVal x) { return rt_asin(hexa_float(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_acos(HexaVal x) { return rt_acos(hexa_float(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_atan(HexaVal x) { return rt_atan(hexa_float(HX_FLOAT(x))); }\n"
    buf = buf + "#endif\n"
    buf = buf + "// Step-3 cycle 41 — atan2 dispatch to rt_atan2 (math.hexa quadrant\n"
    buf = buf + "// resolution + 4 edge cases). Closes the inverse-trig family.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_math_atan2(HexaVal y, HexaVal x) { return hexa_float(_hx_atan2(HX_FLOAT(y), HX_FLOAT(x))); }\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_atan2(HexaVal y, HexaVal x);\n"
    buf = buf + "HexaVal hexa_math_atan2(HexaVal y, HexaVal x) { return rt_atan2(hexa_float(HX_FLOAT(y)), hexa_float(HX_FLOAT(x))); }\n"
    buf = buf + "#endif\n"
    buf = buf + "HexaVal hexa_math_log(HexaVal x)  { return hexa_float(hxlcl_log(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_exp(HexaVal x)  { return hexa_float(hxlcl_exp(HX_FLOAT(x))); }\n"
    buf = buf + "// Step-3 cycle 39 — math floor/ceil/round wrapper contract is float-out,\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// but the rt_floor/ceil/round fns in numeric.hexa return int (per their\n"
    buf = buf + "// cycle 2/4 ports). Bridge with an explicit int→float cast at the\n"
    buf = buf + "// boundary so the libm surface goes away while the wrapper signature\n"
    buf = buf + "// stays unchanged.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_floor(HexaVal v);\n"
    buf = buf + "extern HexaVal rt_ceil(HexaVal v);\n"
    buf = buf + "extern HexaVal rt_round(HexaVal v);\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_math_pow(HexaVal b, HexaVal e) { return hexa_float(_hx_pow(HX_FLOAT(b), HX_FLOAT(e))); }\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_pow_float(HexaVal b, HexaVal e);\n"
    buf = buf + "HexaVal hexa_math_pow(HexaVal b, HexaVal e) { return rt_pow_float(hexa_float(HX_FLOAT(b)), hexa_float(HX_FLOAT(e))); }\n"
    buf = buf + "#endif\n"
    buf = buf + "// 2026-05-20 (blocker-3 fmod-shim): direct libm fmod() exposed as `fmod(x, y)`\n"
    buf = buf + "// from hexa user code. Distinct from `%` which routes through hexa_mod\n"
    buf = buf + "// (int+float-aware dispatch); this is the pure float-only path used by\n"
    buf = buf + "// scientific kernels that want the libm semantics directly.\n"
    buf = buf + "// Step-3 cycle 38 batch — dispatch through rt_fmod (math.hexa cycle 7-9\n"
    buf = buf + "// Newton/series-based) when hexa-rt-stdlib is active. hxlcl_fmod itself\n"
    buf = buf + "// routes through rt_fmod via runtime.c shim too, so this wrapper is\n"
    buf = buf + "// behaviour-identical; lifting it surfaces the dispatch explicitly.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_math_fmod(HexaVal a, HexaVal b) { return hexa_float(hxlcl_fmod(HX_FLOAT(a), HX_FLOAT(b))); }\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_fmod(HexaVal x, HexaVal y);\n"
    buf = buf + "HexaVal hexa_math_fmod(HexaVal a, HexaVal b) { return rt_fmod(hexa_float(HX_FLOAT(a)), hexa_float(HX_FLOAT(b))); }\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_min_float(HexaVal a, HexaVal b);\n"
    buf = buf + "#endif\n"
    buf = buf + "// G1-FLOAT-PRIM 2026-05-06 — see .roadmap.stdlib.G1-FLOAT-PRIM. lgamma is the\n"
    buf = buf + "// log-gamma function used by Beta-Binomial conjugate posteriors throughout\n"
    buf = buf + "// the hexa-bio Bayesian audit suite (14 callsites in _python_bridge/module).\n"
    buf = buf + "// isnan/isinf/isfinite mirror C99 classifiers; emit hexa boolean.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_math_lgamma(HexaVal x)   { return hexa_float(_hx_lgamma(HX_FLOAT(x))); }\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_lgamma(HexaVal x);\n"
    buf = buf + "HexaVal hexa_math_lgamma(HexaVal x)   { return rt_lgamma(hexa_float(HX_FLOAT(x))); }\n"
    buf = buf + "#endif\n"
    buf = buf + "// VERIFY-KIT V4 2026-05-26 — special-function primitives. zero-c #29:\n"
    buf = buf + "// tgamma/erf/erfc now route through NATIVE rt_* (stdlib/runtime/math.hexa:\n"
    buf = buf + "// W.J. Cody rational-Chebyshev erf + Stirling reflection gamma — accurate,\n"
    buf = buf + "// NOT collapsing hand-Taylor) under HEXA_HAS_HEXA_RT_STDLIB, dropping the\n"
    buf = buf + "// libm tgamma/erf/erfc externs from the default ship. j0/j1 remain on libm\n"
    buf = buf + "// (sanctioned FFI: rare + accuracy-critical Bessel, low-ROI to port). Same\n"
    buf = buf + "// shape as hexa_math_lgamma; codegen cg_math_sym maps gamma/tgamma/erf/erfc/\n"
    buf = buf + "// bessel_j0/bessel_j1 to these. Values irrational => verify --tol gate.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_math_tgamma(HexaVal x)   { return hexa_float(_hx_tgamma(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_erf(HexaVal x)      { return hexa_float(_hx_erf(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_erfc(HexaVal x)     { return hexa_float(_hx_erfc(HX_FLOAT(x))); }\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_tgamma(HexaVal x);\n"
    buf = buf + "extern HexaVal rt_erf(HexaVal x);\n"
    buf = buf + "extern HexaVal rt_erfc(HexaVal x);\n"
    buf = buf + "HexaVal hexa_math_tgamma(HexaVal x)   { return rt_tgamma(hexa_float(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_erf(HexaVal x)      { return rt_erf(hexa_float(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_erfc(HexaVal x)     { return rt_erfc(hexa_float(HX_FLOAT(x))); }\n"
    buf = buf + "#endif\n"
    buf = buf + "// zero-c #29: j0/j1 now NATIVE rt_j0/rt_j1 (stdlib/runtime/math.hexa:\n"
    buf = buf + "// fdlibm e_j0.c/e_j1.c rational+asymptotic) under HEXA_HAS_HEXA_RT_STDLIB,\n"
    buf = buf + "// dropping the last libm-math externs (j0/j1) from the default ship.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_math_j0(HexaVal x)       { return hexa_float(_hx_j0(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_j1(HexaVal x)       { return hexa_float(_hx_j1(HX_FLOAT(x))); }\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_j0(HexaVal x);\n"
    buf = buf + "extern HexaVal rt_j1(HexaVal x);\n"
    buf = buf + "HexaVal hexa_math_j0(HexaVal x)       { return rt_j0(hexa_float(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_j1(HexaVal x)       { return rt_j1(hexa_float(HX_FLOAT(x))); }\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_math_isnan(HexaVal x)    { return hexa_bool(isnan(HX_FLOAT(x)) ? 1 : 0); }\n"
    buf = buf + "HexaVal hexa_math_isinf(HexaVal x)    { return hexa_bool(isinf(HX_FLOAT(x)) ? 1 : 0); }\n"
    buf = buf + "HexaVal hexa_math_isfinite(HexaVal x) { return hexa_bool(isfinite(HX_FLOAT(x)) ? 1 : 0); }\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_isnan(HexaVal x);\n"
    buf = buf + "extern HexaVal rt_isinf(HexaVal x);\n"
    buf = buf + "extern HexaVal rt_isfinite(HexaVal x);\n"
    buf = buf + "HexaVal hexa_math_isnan(HexaVal x)    { return rt_isnan(hexa_float(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_isinf(HexaVal x)    { return rt_isinf(hexa_float(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_isfinite(HexaVal x) { return rt_isfinite(hexa_float(HX_FLOAT(x))); }\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_max_float(HexaVal a, HexaVal b);\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// ── ML builtins: matvec, dot ─────────────────────────────────\n"
    buf = buf + "// Step-3 cycle 18 port.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_matvec(HexaVal w, HexaVal x, HexaVal rows_v, HexaVal cols_v) {\n"
    buf = buf + "    int64_t rows = HX_IS_INT(rows_v) ? HX_INT(rows_v) : 0;\n"
    buf = buf + "    int64_t cols = HX_IS_INT(cols_v) ? HX_INT(cols_v) : 0;\n"
    buf = buf + "    if (rows <= 0 || cols <= 0) return hexa_array_new();\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    for (int64_t r = 0; r < rows; r++) {\n"
    buf = buf + "        double acc = 0.0;\n"
    buf = buf + "        for (int64_t c = 0; c < cols; c++) {\n"
    buf = buf + "            HexaVal wv = hexa_index_get(w, hexa_int(r * cols + c));\n"
    buf = buf + "            HexaVal xv = hexa_index_get(x, hexa_int(c));\n"
    buf = buf + "            acc += HX_FLOAT(wv) * HX_FLOAT(xv);\n"
    buf = buf + "        }\n"
    buf = buf + "        out = hexa_array_push(out, hexa_float(acc));\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_matvec(HexaVal w, HexaVal x, HexaVal rows, HexaVal cols);\n"
    buf = buf + "HexaVal hexa_matvec(HexaVal w, HexaVal x, HexaVal rows_v, HexaVal cols_v) {\n"
    buf = buf + "    int64_t rows = HX_IS_INT(rows_v) ? HX_INT(rows_v) : 0;\n"
    buf = buf + "    int64_t cols = HX_IS_INT(cols_v) ? HX_INT(cols_v) : 0;\n"
    buf = buf + "    if (rows <= 0 || cols <= 0) return hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(w) || !HX_IS_ARRAY(x)) return hexa_array_new();\n"
    buf = buf + "    return rt_matvec(w, x, hexa_int(rows), hexa_int(cols));\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_input(HexaVal prompt) {\n"
    buf = buf + "    if (HX_IS_STR(prompt) && HX_STR(prompt) && HX_STR(prompt)[0]) {\n"
    buf = buf + "        fputs(HX_STR(prompt), stdout);\n"
    buf = buf + "        fflush(stdout);\n"
    buf = buf + "    }\n"
    buf = buf + "    // The runtime overrides stdin with a fake FILE* ((FILE*)(uintptr_t)1,\n"
    buf = buf + "    // see top of file), so libc stdio (fgetc/getline) crashes inside\n"
    buf = buf + "    // flockfile when it dereferences that constant. Read straight from fd 0\n"
    buf = buf + "    // with the raw read(2) wrapper instead — the same primitive\n"
    buf = buf + "    // term_read_byte() uses. Stops at '\\n' (consumed, not stored) or EOF;\n"
    buf = buf + "    // returns \"\" on EOF with no data read. fputs/fflush above are safe: the\n"
    buf = buf + "    // runtime macro-redirects them to hxlcl_fputs/hxlcl_fflush (write(2)).\n"
    buf = buf + "    size_t cap = 256, len = 0;\n"
    buf = buf + "    char* buf = (char*)malloc(cap);\n"
    buf = buf + "    if (!buf) return hexa_str(\"\");\n"
    buf = buf + "    for (;;) {\n"
    buf = buf + "        unsigned char b;\n"
    buf = buf + "        long n = hxlcl_read(0, &b, 1);\n"
    buf = buf + "        if (n < 0) { if (errno == EINTR) continue; break; }\n"
    buf = buf + "        if (n == 0) break;            // EOF\n"
    buf = buf + "        if (b == '\\n') break;\n"
    buf = buf + "        if (len + 1 >= cap) {\n"
    buf = buf + "            cap *= 2;\n"
    buf = buf + "            char* nb = (char*)realloc(buf, cap);\n"
    buf = buf + "            if (!nb) { free(buf); return hexa_str(\"\"); }\n"
    buf = buf + "            buf = nb;\n"
    buf = buf + "        }\n"
    buf = buf + "        buf[len++] = (char)b;\n"
    buf = buf + "    }\n"
    buf = buf + "    // strip a trailing CR so CRLF input yields the bare line\n"
    buf = buf + "    if (len > 0 && buf[len-1] == '\\r') len--;\n"
    buf = buf + "    buf[len] = 0;\n"
    buf = buf + "    return hexa_str_own(buf);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_is_error(HexaVal v) {\n"
    buf = buf + "    // No TAG_ERROR in runtime; interpreter uses ad-hoc Val(TAG_ERROR,...)\n"
    buf = buf + "    // convention (TAG_ERROR name not defined in runtime tags). Treat as\n"
    buf = buf + "    // \"false\" here unless TAG_STR and starts with \"ERR:\" sentinel.\n"
    buf = buf + "    if (HX_IS_STR(v) && HX_STR(v) && hxlcl_strncmp(HX_STR(v), \"ERR:\", 4) == 0) return hexa_bool(1);\n"
    buf = buf + "    return hexa_bool(0);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal rt_read_lines(HexaVal path) {\n"
    buf = buf + "    HexaVal content = rt_read_file(path);\n"
    buf = buf + "    if (!HX_IS_STR(content)) return hexa_array_new();\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    const char* p = HX_STR(content);\n"
    buf = buf + "    const char* start = p;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    while (*p) {\n"
    buf = buf + "        if (*p == '\\n') {\n"
    buf = buf + "            size_t len = (size_t)(p - start);\n"
    buf = buf + "            char* line = (char*)malloc(len + 1);\n"
    buf = buf + "            hxlcl_memcpy(line, start, len);\n"
    buf = buf + "            line[len] = 0;\n"
    buf = buf + "            out = hexa_array_push(out, hexa_str_own(line));\n"
    buf = buf + "            start = p + 1;\n"
    buf = buf + "        }\n"
    buf = buf + "        p++;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (p > start) {\n"
    buf = buf + "        size_t len = (size_t)(p - start);\n"
    buf = buf + "        char* line = (char*)malloc(len + 1);\n"
    buf = buf + "        hxlcl_memcpy(line, start, len);\n"
    buf = buf + "        line[len] = 0;\n"
    buf = buf + "        out = hexa_array_push(out, hexa_str_own(line));\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_from_char_code(HexaVal n) {\n"
    buf = buf + "    int64_t code = HX_IS_INT(n) ? HX_INT(n) : (int64_t)HX_FLOAT(n);\n"
    buf = buf + "    if (code < 0) code = 0;\n"
    buf = buf + "    if (code < 0x80) {\n"
    buf = buf + "        char* s = (char*)malloc(2); s[0] = (char)code; s[1] = 0;\n"
    buf = buf + "        return hexa_str_own(s);\n"
    buf = buf + "    }\n"
    buf = buf + "    // UTF-8 encode\n"
    buf = buf + "    char buf[5] = {0};\n"
    buf = buf + "    if (code < 0x800) {\n"
    buf = buf + "        buf[0] = (char)(0xC0 | (code >> 6));\n"
    buf = buf + "        buf[1] = (char)(0x80 | (code & 0x3F));\n"
    buf = buf + "    } else if (code < 0x10000) {\n"
    buf = buf + "        buf[0] = (char)(0xE0 | (code >> 12));\n"
    buf = buf + "        buf[1] = (char)(0x80 | ((code >> 6) & 0x3F));\n"
    buf = buf + "        buf[2] = (char)(0x80 | (code & 0x3F));\n"
    buf = buf + "    } else {\n"
    buf = buf + "        buf[0] = (char)(0xF0 | (code >> 18));\n"
    buf = buf + "        buf[1] = (char)(0x80 | ((code >> 12) & 0x3F));\n"
    buf = buf + "        buf[2] = (char)(0x80 | ((code >> 6) & 0x3F));\n"
    buf = buf + "        buf[3] = (char)(0x80 | (code & 0x3F));\n"
    buf = buf + "    }\n"
    buf = buf + "    char* out = hxlcl_strdup(buf);\n"
    buf = buf + "    return hexa_str_own(out);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// chr(N) → byte-level 1-char string. Distinct from hexa_from_char_code\n"
    buf = buf + "// (UTF-8 codepoint encoder): chr_byte masks N to a single byte (N & 0xFF)\n"
    buf = buf + "// and returns a 1-byte string. Used by URL-decode / raw-byte builders\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// (the codegen mapping `chr` → hexa_chr_byte at codegen.hexa L4452\n"
    buf = buf + "// has existed without a runtime impl — the new tier-2 transpiler emits\n"
    buf = buf + "// it from self/main.hexa::cmd_url_decode, exposing the gap).\n"
    buf = buf + "HexaVal hexa_chr_byte(HexaVal n) {\n"
    buf = buf + "    int64_t code = HX_IS_INT(n) ? HX_INT(n) : (int64_t)HX_FLOAT(n);\n"
    buf = buf + "    // Use hexa_strbuf_alloc(1) so the result carries a length-1 header (read\n"
    buf = buf + "    // by HX_STRLEN). Plain malloc + strlen-derived length silently truncated\n"
    buf = buf + "    // chr(0) / chr(256) (post-mask 0) and any concat containing such a byte\n"
    buf = buf + "    // to length 0 — Python / Go / Rust all give len 1. Mirrors the RFC 030\n"
    buf = buf + "    // pattern in hexa_bytes_to_str_raw (sibling fn below) and Phase 2 of\n"
    buf = buf + "    // wilson's bytes-to-str-raw-allow-nul resolution.\n"
    buf = buf + "    char* s = hexa_strbuf_alloc(1);\n"
    buf = buf + "    if (!s) return hexa_str(\"\");\n"
    buf = buf + "    s[0] = (char)(code & 0xFF);\n"
    buf = buf + "    return (HexaVal){.tag=TAG_STR, .s=s};\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// RFC 030 — `bytes_to_str_raw([int]) -> string`\n"
    buf = buf + "//\n"
    buf = buf + "// Wrap a hexa int array (each ∈ 0..255) as a hexa string whose underlying\n"
    buf = buf + "// bytes are exactly those integers — no UTF-8 codepoint re-encoding.\n"
    buf = buf + "// Inverse of `_str_to_bytes(s)` (stdlib/safetensors.hexa) for UTF-8 strings\n"
    buf = buf + "// containing arbitrary multi-byte sequences (Korean 한, emoji 🌌, etc.).\n"
    buf = buf + "//\n"
    buf = buf + "// Uses hexa_strbuf_alloc(n) which prepends a length header so HX_STRLEN\n"
    buf = buf + "// is O(1) and reads the cached length; this makes embedded NUL (0x00)\n"
    buf = buf + "// bytes safely representable (strlen()-using paths will truncate at the\n"
    buf = buf + "// first NUL, but HX_STRLEN-aware paths see the full length).\n"
    buf = buf + "//\n"
    buf = buf + "// Phase 1 policy per RFC 030: out-of-range values (b<0 or b>255) produce the\n"
    buf = buf + "// empty string (silent error) — the runtime's existing \"soft-fail with empty\n"
    buf = buf + "// result\" idiom (e.g. safetensors_read returning {} on parse error).\n"
    buf = buf + "//\n"
    buf = buf + "// Phase 2 (2026-05-13, filed by wilson — incoming/patches/wilson-bytes-to-str-\n"
    buf = buf + "// raw-allow-nul.md): allow embedded NUL (0x00) bytes. hexa_strbuf_alloc\n"
    buf = buf + "// prepends a length header so HX_STRLEN is O(1) and reads the cached length;\n"
    buf = buf + "// HX_STRLEN-aware paths (base64_encode, json builders, etc.) handle NULs\n"
    buf = buf + "// natively. strlen()-using paths still truncate at the first NUL, but the\n"
    buf = buf + "// burden is now on those callers — the producer is fully NUL-clean. wilson's\n"
    buf = buf + "// tool-image::image_read (multimodal vision input) needs this for PNG IHDR\n"
    buf = buf + "// length fields which always have leading NULs.\n"
    buf = buf + "HexaVal hexa_bytes_to_str_raw(HexaVal arr) {\n"
    buf = buf + "    if (HX_TAG(arr) != TAG_ARRAY) return hexa_str(\"\");\n"
    buf = buf + "    int64_t n = (int64_t)HX_ARR_LEN(arr);\n"
    buf = buf + "    if (n <= 0) return hexa_str(\"\");\n"
    buf = buf + "    char* buf = hexa_strbuf_alloc((size_t)n);\n"
    buf = buf + "    if (!buf) return hexa_str(\"\");\n"
    buf = buf + "    HexaVal* items = HX_ARR_ITEMS(arr);\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        HexaVal v = items[i];\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        int64_t b = HX_IS_INT(v) ? HX_INT(v) : (int64_t)HX_FLOAT(v);\n"
    buf = buf + "        if (b < 0 || b > 255) {\n"
    buf = buf + "            // Out-of-range → return empty per Phase 1 policy.\n"
    buf = buf + "            return hexa_str(\"\");\n"
    buf = buf + "        }\n"
    buf = buf + "        // Phase 2: embedded NUL is allowed. hexa_strbuf_alloc's length header\n"
    buf = buf + "        // makes the resulting string still well-formed under HX_STRLEN.\n"
    buf = buf + "        buf[i] = (char)(b & 0xFF);\n"
    buf = buf + "    }\n"
    buf = buf + "    // hexa_strbuf_alloc pre-NUL-terminates buf[n] so this is a valid C str\n"
    buf = buf + "    // (truncated at the first embedded NUL when read via strlen, but the\n"
    buf = buf + "    // length header — read by HX_STRLEN — sees the full n bytes).\n"
    buf = buf + "    return (HexaVal){.tag=TAG_STR, .s=buf};\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════\n"
    buf = buf + "//  farr — primitive (unboxed) float array for state-vector kernels\n"
    buf = buf + "//  hexa-lang/feat-primitive-float-array (2026-05-12)\n"
    buf = buf + "//\n"
    buf = buf + "//  Motivation: qmirror Phase 7 (surface_code_d3) needs n=17 qubits =\n"
    buf = buf + "//  2^17 = 131072 double-precision amplitudes per state vector. Each\n"
    buf = buf + "//  amplitude stored as a boxed `Val` (12-field struct, ~88B in the\n"
    buf = buf + "//  interpreter) inflates to ~11 MB per array, × 2 (re/im) × N copies\n"
    buf = buf + "//  ≫ 768 MB cap. Packed `double[]` storage cuts that to 1 MB per\n"
    buf = buf + "//  array (8B/element) and gives O(1) load/store at index time.\n"
    buf = buf + "//\n"
    buf = buf + "//  Design: opaque int handles into a process-global table mapping\n"
    buf = buf + "//  `id -> (double* buf, int len)`. Handles are *never* freed during\n"
    buf = buf + "//  the program lifetime (handles outlive the kernel call, and the\n"
    buf = buf + "//  scope-aware GC machinery for `array_store` doesn't apply to raw\n"
    buf = buf + "//  C buffers). For long-running programs `farr_free` can be called\n"
    buf = buf + "//  explicitly. Memory leak risk for typical kernel use (a few dozen\n"
    buf = buf + "//  state-vector snapshots per quantum circuit) is bounded and small.\n"
    buf = buf + "//\n"
    buf = buf + "//  Builtins (called from interpreter `call_builtin`):\n"
    buf = buf + "//      farr_zeros(n)        -> int handle    (n doubles, all 0.0)\n"
    buf = buf + "//      farr_get(h, i)       -> float\n"
    buf = buf + "//      farr_set(h, i, x)    -> int           (returns h for chaining)\n"
    buf = buf + "//      farr_len(h)          -> int\n"
    buf = buf + "//      farr_free(h)         -> void          (optional; explicit)\n"
    buf = buf + "//\n"
    buf = buf + "//  Index encoding matches qiskit conventions in qmirror state vectors:\n"
    buf = buf + "//  amp[i] is the coefficient of |b_{n-1} ... b_0> where b_q=(i>>q)&1.\n"
    buf = buf + "//  But farr itself is index-agnostic — it's just a packed double buf.\n"
    buf = buf + "//\n"
    buf = buf + "//  Out-of-bounds reads return 0.0 and writes are no-ops (soft-fail,\n"
    buf = buf + "//  matching the \"silent error\" idiom of hexa_bytes_to_str_raw above).\n"
    buf = buf + "//  Negative-index semantics differ from hexa_array_get's \"py-style\":\n"
    buf = buf + "//  here a negative index is an OOB error and returns/no-ops with 0.0\n"
    buf = buf + "//  (callers should pass non-negative indices into 0..len).\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// ═══════════════════════════════════════════════════════════\n"
    buf = buf + "\n"
    buf = buf + "/* RFC 040 device-residence descriptor. The no-CUDA build leaves every\n"
    buf = buf + " * farr loc=FARR_HOST,d_buf=NULL,dirty_*=0 — byte-identical to pre-040. */\n"
    buf = buf + "typedef enum {\n"
    buf = buf + "    FARR_HOST     = 0,  /* host memory only (default — RFC 025 behaviour) */\n"
    buf = buf + "    FARR_DEVICE   = 1,  /* device memory only (host buf may be NULL) */\n"
    buf = buf + "    FARR_MIRRORED = 2   /* both host and device buffers valid + in-sync */\n"
    buf = buf + "} FarrLoc;\n"
    buf = buf + "\n"
    buf = buf + "typedef struct {\n"
    buf = buf + "    double*  buf;        /* host pointer — RFC 025 (NULL if device-only) */\n"
    buf = buf + "    int64_t  len;        /* element count (shared by host and device buf) */\n"
    buf = buf + "    void*    d_buf;      /* CUDA device pointer — NULL if host-only (RFC 040) */\n"
    buf = buf + "    int      loc;        /* FarrLoc — current residence (RFC 040) */\n"
    buf = buf + "    int      pinned;     /* 1 if farr_pin'd (do not auto-evict) (RFC 040) */\n"
    buf = buf + "    int      dirty_host; /* host buf stale vs device → needs D2H (RFC 040) */\n"
    buf = buf + "    int      dirty_dev;  /* device buf stale vs host → needs H2D (RFC 040) */\n"
    buf = buf + "} HexaFarrEntry;\n"
    buf = buf + "\n"
    buf = buf + "/* RFC 040 Phase D: under -DHEXA_CUDA the farr table + count must be\n"
    buf = buf + " * visible to the runtime_cuda.c TU (cuBLAS Dgemm reads host buf/len for\n"
    buf = buf + " * H2D/D2H, and the residence descriptor). Non-static export under\n"
    buf = buf + " * HEXA_CUDA only — the no-CUDA build keeps them `static` (byte-identical,\n"
    buf = buf + " * zero ABI surface change).\n"
    buf = buf + " *\n"
    buf = buf + " * METAL_INTEGRATION.md step 3 (2026-05-21): also export under HEXA_METAL\n"
    buf = buf + " * so the runtime_metal.m TU's FP64 _hx_metal_farr_matmul_gpu (N18 shim)\n"
    buf = buf + " * can resolve _hx_farr_table / _hx_farr_count at link time. The default\n"
    buf = buf + " * Mac build with neither HEXA_CUDA nor HEXA_METAL keeps them static —\n"
    buf = buf + " * byte-identical to the pre-step-3 default-build state. */\n"
    buf = buf + "#if defined(HEXA_CUDA) || defined(HEXA_METAL)\n"
    buf = buf + "HexaFarrEntry*        _hx_farr_table     = NULL;\n"
    buf = buf + "int64_t               _hx_farr_count     = 0;\n"
    buf = buf + "#else\n"
    buf = buf + "static HexaFarrEntry* _hx_farr_table     = NULL;\n"
    buf = buf + "static int64_t        _hx_farr_count     = 0;\n"
    buf = buf + "#endif\n"
    buf = buf + "static int64_t        _hx_farr_capacity  = 0;\n"
    buf = buf + "static int64_t*       _hx_farr_freelist  = NULL;\n"
    buf = buf + "static int64_t        _hx_farr_freelist_n = 0;\n"
    buf = buf + "static int64_t        _hx_farr_freelist_cap = 0;\n"
    buf = buf + "\n"
    buf = buf + "// Allocate a new packed double[n] buffer, zero-filled. Returns int handle.\n"
    buf = buf + "// Accepts HexaVal{TAG_INT} (AOT-emitted call site) or HexaVal{TAG_VALSTRUCT}\n"
    buf = buf + "// wrapping a TAG_INT (interpreter-emitted Val); hexa_as_num normalizes both.\n"
    buf = buf + "HexaVal hexa_farr_zeros(HexaVal n_v) {\n"
    buf = buf + "    int64_t n = hexa_as_num(n_v);\n"
    buf = buf + "    if (n < 0) n = 0;\n"
    buf = buf + "    double* buf = NULL;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    if (n > 0) {\n"
    buf = buf + "        // calloc — zero-fill required (state_zero relies on it).\n"
    buf = buf + "        buf = (double*)calloc((size_t)n, sizeof(double));\n"
    buf = buf + "        if (!buf) {\n"
    buf = buf + "            fprintf(stderr, \"[farr] OOM allocating %lld doubles\\n\", (long long)n);\n"
    buf = buf + "            exit(77);\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    // Pop from freelist if any handle slot was farr_free'd previously.\n"
    buf = buf + "    int64_t id;\n"
    buf = buf + "    if (_hx_farr_freelist_n > 0) {\n"
    buf = buf + "        id = _hx_farr_freelist[--_hx_farr_freelist_n];\n"
    buf = buf + "    } else {\n"
    buf = buf + "        // Grow table geometrically.\n"
    buf = buf + "        if (_hx_farr_count >= _hx_farr_capacity) {\n"
    buf = buf + "            int64_t new_cap = _hx_farr_capacity < 16 ? 16 : _hx_farr_capacity * 2;\n"
    buf = buf + "            HexaFarrEntry* nt = (HexaFarrEntry*)realloc(_hx_farr_table,\n"
    buf = buf + "                                  (size_t)new_cap * sizeof(HexaFarrEntry));\n"
    buf = buf + "            if (!nt) {\n"
    buf = buf + "                fprintf(stderr, \"[farr] OOM growing handle table\\n\");\n"
    buf = buf + "                if (buf) free(buf);\n"
    buf = buf + "                exit(77);\n"
    buf = buf + "            }\n"
    buf = buf + "            _hx_farr_table = nt;\n"
    buf = buf + "            _hx_farr_capacity = new_cap;\n"
    buf = buf + "        }\n"
    buf = buf + "        id = _hx_farr_count++;\n"
    buf = buf + "    }\n"
    buf = buf + "    _hx_farr_table[id].buf = buf;\n"
    buf = buf + "    _hx_farr_table[id].len = n;\n"
    buf = buf + "    /* RFC 040 Phase A: initialize residence descriptor to HOST default —\n"
    buf = buf + "     * byte-identical to pre-040 behaviour for every existing farr. */\n"
    buf = buf + "    _hx_farr_table[id].d_buf      = NULL;\n"
    buf = buf + "    _hx_farr_table[id].loc        = FARR_HOST;\n"
    buf = buf + "    _hx_farr_table[id].pinned     = 0;\n"
    buf = buf + "    _hx_farr_table[id].dirty_host = 0;\n"
    buf = buf + "    _hx_farr_table[id].dirty_dev  = 0;\n"
    buf = buf + "    return hexa_int(id);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Read element at index i. Returns 0.0 on out-of-bounds.\n"
    buf = buf + "HexaVal hexa_farr_get(HexaVal h_v, HexaVal i_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    int64_t i  = hexa_as_num(i_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_farr_count) return hexa_float(0.0);\n"
    buf = buf + "    HexaFarrEntry* e = &_hx_farr_table[id];\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "    /* RFC 040 lazy-D2H on host-read. When a forge op left the farr\n"
    buf = buf + "     * device-resident (loc=FARR_DEVICE — authoritative bytes on the\n"
    buf = buf + "     * device, host buf stale), materialise them before the scalar read.\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "     * _hx_cuda_farr_to_host's D2H sets loc=FARR_MIRRORED + dirty_host=0,\n"
    buf = buf + "     * so subsequent farr_get calls short-circuit (loc != FARR_DEVICE)\n"
    buf = buf + "     * — amortized O(N) first read, O(1) rest of the host-side scan. */\n"
    buf = buf + "    if (e->loc == FARR_DEVICE) {\n"
    buf = buf + "        extern int _hx_cuda_farr_to_host(int64_t farr_id);\n"
    buf = buf + "        (void)_hx_cuda_farr_to_host(id);\n"
    buf = buf + "    }\n"
    buf = buf + "#endif\n"
    buf = buf + "    if (!e->buf || i < 0 || i >= e->len) return hexa_float(0.0);\n"
    buf = buf + "    return hexa_float(e->buf[i]);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Write element at index i. No-op on out-of-bounds. Returns h (for chaining).\n"
    buf = buf + "HexaVal hexa_farr_set(HexaVal h_v, HexaVal i_v, HexaVal x_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    int64_t i  = hexa_as_num(i_v);\n"
    buf = buf + "    double  x  = __hx_to_double(x_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_farr_count) return h_v;\n"
    buf = buf + "    HexaFarrEntry* e = &_hx_farr_table[id];\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "    /* RFC 040 lazy-D2H before host write. If the device holds the\n"
    buf = buf + "     * authoritative bytes, materialise them on the host first — else the\n"
    buf = buf + "     * dirty_host=1 below would force _h2d to re-upload a buffer whose\n"
    buf = buf + "     * non-i indices are stale. After the write, dirty_host=1 makes the\n"
    buf = buf + "     * next forge op H2D-refresh the device from this (now current) host\n"
    buf = buf + "     * buffer (the _h2d skip in runtime_cuda.c keys on !dirty_host). */\n"
    buf = buf + "    if (e->loc == FARR_DEVICE) {\n"
    buf = buf + "        extern int _hx_cuda_farr_to_host(int64_t farr_id);\n"
    buf = buf + "        (void)_hx_cuda_farr_to_host(id);\n"
    buf = buf + "    }\n"
    buf = buf + "#endif\n"
    buf = buf + "    if (!e->buf || i < 0 || i >= e->len) return h_v;\n"
    buf = buf + "    e->buf[i] = x;\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "    if (e->d_buf) { e->dirty_host = 1; e->dirty_dev = 0; }\n"
    buf = buf + "#endif\n"
    buf = buf + "    return h_v;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Return length (number of elements) of the packed buffer.\n"
    buf = buf + "HexaVal hexa_farr_len(HexaVal h_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_farr_count) return hexa_int(0);\n"
    buf = buf + "    return hexa_int(_hx_farr_table[id].len);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Free a handle's backing buffer. Returns void. Idempotent.\n"
    buf = buf + "HexaVal hexa_farr_free(HexaVal h_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_farr_count) return hexa_void();\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    HexaFarrEntry* e = &_hx_farr_table[id];\n"
    buf = buf + "    if (e->buf) { free(e->buf); e->buf = NULL; e->len = 0; }\n"
    buf = buf + "    /* RFC 040: also free the device buffer if present + reset residence.\n"
    buf = buf + "     * No-CUDA build: d_buf is always NULL — the resets keep freelist\n"
    buf = buf + "     * slots hygienic for a later hexa_farr_zeros reuse. Under -DHEXA_CUDA\n"
    buf = buf + "     * _hx_cuda_farr_device_free cudaFree's the mirror-table slot. */\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "    if (e->d_buf) {\n"
    buf = buf + "        extern int _hx_cuda_farr_device_free(int64_t farr_id);\n"
    buf = buf + "        (void)_hx_cuda_farr_device_free(id);\n"
    buf = buf + "        e->d_buf = NULL;\n"
    buf = buf + "    }\n"
    buf = buf + "#else\n"
    buf = buf + "    e->d_buf = NULL;\n"
    buf = buf + "#endif\n"
    buf = buf + "    e->loc        = FARR_HOST;\n"
    buf = buf + "    e->pinned     = 0;\n"
    buf = buf + "    e->dirty_host = 0;\n"
    buf = buf + "    e->dirty_dev  = 0;\n"
    buf = buf + "    // Push id onto freelist for reuse.\n"
    buf = buf + "    if (_hx_farr_freelist_n >= _hx_farr_freelist_cap) {\n"
    buf = buf + "        int64_t new_cap = _hx_farr_freelist_cap < 16 ? 16 : _hx_farr_freelist_cap * 2;\n"
    buf = buf + "        int64_t* nf = (int64_t*)realloc(_hx_farr_freelist,\n"
    buf = buf + "                       (size_t)new_cap * sizeof(int64_t));\n"
    buf = buf + "        if (nf) {\n"
    buf = buf + "            _hx_farr_freelist = nf;\n"
    buf = buf + "            _hx_farr_freelist_cap = new_cap;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_hx_farr_freelist_n < _hx_farr_freelist_cap) {\n"
    buf = buf + "        _hx_farr_freelist[_hx_farr_freelist_n++] = id;\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════\n"
    buf = buf + "// METAL_INTEGRATION.md step 3 of 5 (2026-05-21): HX_FARR32 —\n"
    buf = buf + "// packed-float (FP32) farr table. Parallel to _hx_farr_table above.\n"
    buf = buf + "//\n"
    buf = buf + "// Why a separate table (not an is_fp32 flag on HexaFarrEntry):\n"
    buf = buf + "//   Adding a flag forces every existing FP64 hot path\n"
    buf = buf + "//   (hexa_farr_matmul ikj, ad_tape, qmirror, anima reductions) to\n"
    buf = buf + "//   branch on the flag in inner loops, costing measurable perf for\n"
    buf = buf + "//   zero benefit to the FP64 callers. A parallel table keeps the\n"
    buf = buf + "//   FP64 path byte-identical to pre-step-3 (and the FP32 path\n"
    buf = buf + "//   memory-contiguous float*, which is what MPS expects).\n"
    buf = buf + "//\n"
    buf = buf + "// Why now (Mac-only motivation):\n"
    buf = buf + "//   N15 + N18 (commits 6315b59f + cf4b1e38) gave us a working Apple\n"
    buf = buf + "//   MPS shim that down-casts FP64 → FP32 → MPS → FP64. Each d768\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "//   matmul (~590k input + ~590k output doubles) eats ~14 MB of\n"
    buf = buf + "//   per-call cast traffic + ~29 mantissa bits of precision per\n"
    buf = buf + "//   element. Step 3 closes that gap: flame ag_linear (next cycle)\n"
    buf = buf + "//   will allocate FP32 weights directly via farr32_zeros, fill them\n"
    buf = buf + "//   from the safetensors mmap reader (bf16 → f32 path already\n"
    buf = buf + "//   exists), and call farr32_matmul → MPS with zero cast traffic.\n"
    buf = buf + "//\n"
    buf = buf + "// API surface (mirrors FP64):\n"
    buf = buf + "//   farr32_zeros(n)         → int handle (n floats, zero-filled)\n"
    buf = buf + "//   farr32_get(h, i)        → float (HexaVal{TAG_FLOAT}, OOB → 0.0)\n"
    buf = buf + "//   farr32_set(h, i, x)     → handle (chain; OOB → no-op)\n"
    buf = buf + "//   farr32_len(h)           → int\n"
    buf = buf + "//   farr32_free(h)          → void (idempotent)\n"
    buf = buf + "//   farr32_matmul(A,M,K,B,N) → C farr32 handle (FP32 SGEMM)\n"
    buf = buf + "//\n"
    buf = buf + "// Lifetime + handle reuse: same freelist model as the FP64 farr\n"
    buf = buf + "// table. No GC; explicit free at process end (or never — bounded\n"
    buf = buf + "// per-process leak is acceptable for typical model-weight usage).\n"
    buf = buf + "//\n"
    buf = buf + "// HEXA_METAL dispatch (gap #1 of METAL_INTEGRATION.md closed):\n"
    buf = buf + "//   hexa_farr32_matmul large-shape dispatch (M*K > 8192 || K*N >\n"
    buf = buf + "//   8192) routes to _hx_metal_farr32_matmul_gpu — NATIVE FP32, no\n"
    buf = buf + "//   cast (the runtime_metal.m FP32 variant is the step-3 deliverable\n"
    buf = buf + "//   on the .m side). HEXA_CUDA fallback = CPU SGEMM (no FP32 cuBLAS\n"
    buf = buf + "//   shim yet; the d768 Mac path is the priority lever).\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════\n"
    buf = buf + "\n"
    buf = buf + "/* Same RFC 040 residence shape as HexaFarrEntry, FP32 buffer. The\n"
    buf = buf + " * d_buf/loc/dirty_* fields are currently unused on the FP32 side (no\n"
    buf = buf + " * lazy-D2H mirroring path exists for FP32 yet); they're carried so a\n"
    buf = buf + " * future RFC 040-style FP32 device residence is a non-breaking\n"
    buf = buf + " * extension. */\n"
    buf = buf + "typedef struct {\n"
    buf = buf + "    float*   buf;        /* host pointer — FP32 (NULL if device-only) */\n"
    buf = buf + "    int64_t  len;        /* element count */\n"
    buf = buf + "    void*    d_buf;      /* device pointer (reserved; NULL today) */\n"
    buf = buf + "    int      loc;        /* FarrLoc — currently always FARR_HOST */\n"
    buf = buf + "    int      pinned;     /* reserved */\n"
    buf = buf + "    int      dirty_host; /* reserved */\n"
    buf = buf + "    int      dirty_dev;  /* reserved */\n"
    buf = buf + "} HexaFarr32Entry;\n"
    buf = buf + "\n"
    buf = buf + "/* Mirror the HEXA_CUDA export gate from the FP64 table (line 4598):\n"
    buf = buf + " * non-static under -DHEXA_METAL so the runtime_metal.m TU can read\n"
    buf = buf + " * _hx_farr32_table/_count without re-declaring extern in a header.\n"
    buf = buf + " * Default Mac build (no -DHEXA_METAL) keeps them static + byte-\n"
    buf = buf + " * identical to the no-FP32 prior state. */\n"
    buf = buf + "#ifdef HEXA_METAL\n"
    buf = buf + "HexaFarr32Entry*      _hx_farr32_table     = NULL;\n"
    buf = buf + "int64_t               _hx_farr32_count     = 0;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "#else\n"
    buf = buf + "static HexaFarr32Entry* _hx_farr32_table     = NULL;\n"
    buf = buf + "static int64_t          _hx_farr32_count     = 0;\n"
    buf = buf + "#endif\n"
    buf = buf + "static int64_t        _hx_farr32_capacity    = 0;\n"
    buf = buf + "static int64_t*       _hx_farr32_freelist    = NULL;\n"
    buf = buf + "static int64_t        _hx_farr32_freelist_n  = 0;\n"
    buf = buf + "static int64_t        _hx_farr32_freelist_cap= 0;\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_farr32_zeros(HexaVal n_v) {\n"
    buf = buf + "    int64_t n = hexa_as_num(n_v);\n"
    buf = buf + "    if (n < 0) n = 0;\n"
    buf = buf + "    float* buf = NULL;\n"
    buf = buf + "    if (n > 0) {\n"
    buf = buf + "        buf = (float*)calloc((size_t)n, sizeof(float));\n"
    buf = buf + "        if (!buf) {\n"
    buf = buf + "            fprintf(stderr, \"[farr32] OOM allocating %lld floats\\n\",\n"
    buf = buf + "                    (long long)n);\n"
    buf = buf + "            exit(77);\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    int64_t id;\n"
    buf = buf + "    if (_hx_farr32_freelist_n > 0) {\n"
    buf = buf + "        id = _hx_farr32_freelist[--_hx_farr32_freelist_n];\n"
    buf = buf + "    } else {\n"
    buf = buf + "        if (_hx_farr32_count >= _hx_farr32_capacity) {\n"
    buf = buf + "            int64_t new_cap = _hx_farr32_capacity < 16 ? 16\n"
    buf = buf + "                              : _hx_farr32_capacity * 2;\n"
    buf = buf + "            HexaFarr32Entry* nt = (HexaFarr32Entry*)realloc(\n"
    buf = buf + "                _hx_farr32_table,\n"
    buf = buf + "                (size_t)new_cap * sizeof(HexaFarr32Entry));\n"
    buf = buf + "            if (!nt) {\n"
    buf = buf + "                fprintf(stderr, \"[farr32] OOM growing handle table\\n\");\n"
    buf = buf + "                if (buf) free(buf);\n"
    buf = buf + "                exit(77);\n"
    buf = buf + "            }\n"
    buf = buf + "            _hx_farr32_table = nt;\n"
    buf = buf + "            _hx_farr32_capacity = new_cap;\n"
    buf = buf + "        }\n"
    buf = buf + "        id = _hx_farr32_count++;\n"
    buf = buf + "    }\n"
    buf = buf + "    _hx_farr32_table[id].buf        = buf;\n"
    buf = buf + "    _hx_farr32_table[id].len        = n;\n"
    buf = buf + "    _hx_farr32_table[id].d_buf      = NULL;\n"
    buf = buf + "    _hx_farr32_table[id].loc        = FARR_HOST;\n"
    buf = buf + "    _hx_farr32_table[id].pinned     = 0;\n"
    buf = buf + "    _hx_farr32_table[id].dirty_host = 0;\n"
    buf = buf + "    _hx_farr32_table[id].dirty_dev  = 0;\n"
    buf = buf + "    return hexa_int(id);\n"
    buf = buf + "}\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_farr32_get(HexaVal h_v, HexaVal i_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    int64_t i  = hexa_as_num(i_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_farr32_count) return hexa_float(0.0);\n"
    buf = buf + "    HexaFarr32Entry* e = &_hx_farr32_table[id];\n"
    buf = buf + "    if (!e->buf || i < 0 || i >= e->len) return hexa_float(0.0);\n"
    buf = buf + "    /* Up-cast on read: hexa surface speaks FP64 doubles; the FP32 is\n"
    buf = buf + "     * a storage-format detail (the lossy step happened on set/fill). */\n"
    buf = buf + "    return hexa_float((double)e->buf[i]);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_farr32_set(HexaVal h_v, HexaVal i_v, HexaVal x_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    int64_t i  = hexa_as_num(i_v);\n"
    buf = buf + "    double  x  = __hx_to_double(x_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_farr32_count) return h_v;\n"
    buf = buf + "    HexaFarr32Entry* e = &_hx_farr32_table[id];\n"
    buf = buf + "    if (!e->buf || i < 0 || i >= e->len) return h_v;\n"
    buf = buf + "    /* Down-cast on write. This is the one-time narrowing step; from\n"
    buf = buf + "     * here on the value lives as FP32 in the buffer. */\n"
    buf = buf + "    e->buf[i] = (float)x;\n"
    buf = buf + "    return h_v;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_farr32_len(HexaVal h_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_farr32_count) return hexa_int(0);\n"
    buf = buf + "    return hexa_int(_hx_farr32_table[id].len);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_farr32_free(HexaVal h_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_farr32_count) return hexa_void();\n"
    buf = buf + "    HexaFarr32Entry* e = &_hx_farr32_table[id];\n"
    buf = buf + "    if (e->buf) { free(e->buf); e->buf = NULL; e->len = 0; }\n"
    buf = buf + "    e->d_buf      = NULL;\n"
    buf = buf + "    e->loc        = FARR_HOST;\n"
    buf = buf + "    e->pinned     = 0;\n"
    buf = buf + "    e->dirty_host = 0;\n"
    buf = buf + "    e->dirty_dev  = 0;\n"
    buf = buf + "    if (_hx_farr32_freelist_n >= _hx_farr32_freelist_cap) {\n"
    buf = buf + "        int64_t new_cap = _hx_farr32_freelist_cap < 16 ? 16\n"
    buf = buf + "                          : _hx_farr32_freelist_cap * 2;\n"
    buf = buf + "        int64_t* nf = (int64_t*)realloc(_hx_farr32_freelist,\n"
    buf = buf + "                       (size_t)new_cap * sizeof(int64_t));\n"
    buf = buf + "        if (nf) {\n"
    buf = buf + "            _hx_farr32_freelist = nf;\n"
    buf = buf + "            _hx_farr32_freelist_cap = new_cap;\n"
    buf = buf + "        }\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    }\n"
    buf = buf + "    if (_hx_farr32_freelist_n < _hx_farr32_freelist_cap) {\n"
    buf = buf + "        _hx_farr32_freelist[_hx_farr32_freelist_n++] = id;\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// hexa_farr32_matmul — native FP32 SGEMM. Same row-major contract +\n"
    buf = buf + "// ikj fallback shape as hexa_farr_matmul, but with float storage.\n"
    buf = buf + "//\n"
    buf = buf + "// HEXA_METAL dispatch (gap #1 closed): when both __APPLE__ and\n"
    buf = buf + "// HEXA_METAL are defined AND HEXA_METAL=1 env is set AND the shape is\n"
    buf = buf + "// large (M*K > 8192 || K*N > 8192) route to _hx_metal_farr32_matmul_gpu\n"
    buf = buf + "// — the native FP32 MPS shim (no down-cast / up-cast at the boundary).\n"
    buf = buf + "// On any GPU error → fall through to the CPU ikj SGEMM (safe).\n"
    buf = buf + "//\n"
    buf = buf + "// HEXA_CUDA: CPU SGEMM only for now (no float32 cuBLAS shim wired —\n"
    buf = buf + "// the d768 Mac path is the step-3 priority; a CUDA FP32 shim is a\n"
    buf = buf + "// separate cycle if a CUDA Mac box ever shows up, which it won't).\n"
    buf = buf + "HexaVal hexa_farr32_matmul(HexaVal a_v, HexaVal ar_v, HexaVal ac_v,\n"
    buf = buf + "                           HexaVal b_v, HexaVal bc_v) {\n"
    buf = buf + "    int64_t a_id = hexa_as_num(a_v);\n"
    buf = buf + "    int64_t M    = hexa_as_num(ar_v);\n"
    buf = buf + "    int64_t K    = hexa_as_num(ac_v);\n"
    buf = buf + "    int64_t b_id = hexa_as_num(b_v);\n"
    buf = buf + "    int64_t N    = hexa_as_num(bc_v);\n"
    buf = buf + "    if (a_id < 0 || a_id >= _hx_farr32_count) return hexa_int(-1);\n"
    buf = buf + "    if (b_id < 0 || b_id >= _hx_farr32_count) return hexa_int(-1);\n"
    buf = buf + "    if (M <= 0 || K <= 0 || N <= 0)           return hexa_int(-1);\n"
    buf = buf + "    HexaFarr32Entry* ae = &_hx_farr32_table[a_id];\n"
    buf = buf + "    HexaFarr32Entry* be = &_hx_farr32_table[b_id];\n"
    buf = buf + "    if (!ae->buf || !be->buf)                 return hexa_int(-1);\n"
    buf = buf + "    if (ae->len < M * K)                      return hexa_int(-1);\n"
    buf = buf + "    if (be->len < K * N)                      return hexa_int(-1);\n"
    buf = buf + "    HexaVal c_handle = hexa_farr32_zeros(hexa_int(M * N));\n"
    buf = buf + "    int64_t c_id = HX_INT(c_handle);\n"
    buf = buf + "    if (c_id < 0 || c_id >= _hx_farr32_count) return hexa_int(-1);\n"
    buf = buf + "    /* Re-fetch — farr32_zeros may have realloc'd the table. */\n"
    buf = buf + "    ae = &_hx_farr32_table[a_id];\n"
    buf = buf + "    be = &_hx_farr32_table[b_id];\n"
    buf = buf + "    HexaFarr32Entry* ce = &_hx_farr32_table[c_id];\n"
    buf = buf + "    if (!ae->buf || !be->buf)         return hexa_int(-1);\n"
    buf = buf + "    if (!ce->buf || ce->len < M * N)  return hexa_int(-1);\n"
    buf = buf + "    const float* A = ae->buf;\n"
    buf = buf + "    const float* B = be->buf;\n"
    buf = buf + "    float* C       = ce->buf;\n"
    buf = buf + "#if defined(__APPLE__) && defined(HEXA_METAL)\n"
    buf = buf + "    /* METAL_INTEGRATION.md step 3 of 5 (2026-05-21): native FP32 path.\n"
    buf = buf + "     * Unlike the FP64 hexa_farr_matmul's HEXA_METAL dispatch above,\n"
    buf = buf + "     * this one passes float* operands DIRECTLY to MPS — no down-cast,\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "     * no up-cast, no precision loss. ~29 mantissa bits regained per\n"
    buf = buf + "     * element vs the N15+N18 FP64 path. The runtime_metal.m side\n"
    buf = buf + "     * (_hx_metal_farr32_matmul_gpu) bridges _hx_farr32_table directly. */\n"
    buf = buf + "    if (hxlcl_getenv(\"HEXA_METAL\") &&\n"
    buf = buf + "        hxlcl_strcmp(hxlcl_getenv(\"HEXA_METAL\"), \"1\") == 0 &&\n"
    buf = buf + "        ((M * K) > 8192 || (K * N) > 8192)) {\n"
    buf = buf + "        extern int _hx_metal_farr32_matmul_gpu(int64_t a_id, int64_t M,\n"
    buf = buf + "                                               int64_t K, int64_t b_id,\n"
    buf = buf + "                                               int64_t N, int64_t c_id);\n"
    buf = buf + "        int mrc = _hx_metal_farr32_matmul_gpu(a_id, M, K, b_id, N, c_id);\n"
    buf = buf + "        if (mrc == 0) return c_handle;\n"
    buf = buf + "        /* mrc != 0: Metal path failed — fall through to CPU ikj. */\n"
    buf = buf + "    }\n"
    buf = buf + "#endif\n"
    buf = buf + "    // ikj loop — single-precision FMAC; same cache shape as FP64 path.\n"
    buf = buf + "    for (int64_t i = 0; i < M; i++) {\n"
    buf = buf + "        const float* Ai = A + i * K;\n"
    buf = buf + "        float*       Ci = C + i * N;\n"
    buf = buf + "        for (int64_t k = 0; k < K; k++) {\n"
    buf = buf + "            float a_ik = Ai[k];\n"
    buf = buf + "            const float* Bk = B + k * N;\n"
    buf = buf + "            int64_t j = 0;\n"
    buf = buf + "            for (; j + 4 <= N; j += 4) {\n"
    buf = buf + "                Ci[j]   += a_ik * Bk[j];\n"
    buf = buf + "                Ci[j+1] += a_ik * Bk[j+1];\n"
    buf = buf + "                Ci[j+2] += a_ik * Bk[j+2];\n"
    buf = buf + "                Ci[j+3] += a_ik * Bk[j+3];\n"
    buf = buf + "            }\n"
    buf = buf + "            for (; j < N; j++) {\n"
    buf = buf + "                Ci[j] += a_ik * Bk[j];\n"
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return c_handle;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════\n"
    buf = buf + "// METAL_INTEGRATION.md step 4 of 5 (2026-05-21): native FP32 SGEMM\n"
    buf = buf + "// with B transposed on the right (matmul-NT_b).\n"
    buf = buf + "//\n"
    buf = buf + "//   C[M, N] = A[M, K] · B[N, K]^T   (B as passed is N×K row-major;\n"
    buf = buf + "//                                     conceptually B_orig is K×N\n"
    buf = buf + "//                                     row-major and B = B_orig viewed\n"
    buf = buf + "//                                     transposed — but the memory we\n"
    buf = buf + "//                                     receive is N×K contiguous)\n"
    buf = buf + "//   C[i, j] = sum_{k=0..K-1} A[i, k] * B[j, k]\n"
    buf = buf + "//\n"
    buf = buf + "// Why this is the bwd-input matmul shape for ag_linear:\n"
    buf = buf + "//   forward:  Y[M, N] = X[M, K] · W[K, N]       (W is K×N row-major)\n"
    buf = buf + "//   bwd-X:    dX[M, K] = dY[M, N] · W^T[N, K]  (W treated transposed)\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "//   In flame's ag_linear bwd (stdlib/flame/ag_tape.hexa:630), W is\n"
    buf = buf + "//   stored as N×K row-major (i.e. already \"transposed\" relative to\n"
    buf = buf + "//   the forward), so the bwd-X matmul takes A=dY(M, N), B=W(N, K) and\n"
    buf = buf + "//   computes C[i,k] = sum_j A[i,j] * B[k,j] — that is matmul-NT_b\n"
    buf = buf + "//   with the (N,K) operand on the right + transposeRight semantics.\n"
    buf = buf + "//\n"
    buf = buf + "// HEXA_METAL dispatch:\n"
    buf = buf + "//   Large shape (M*K > 8192 || K*N > 8192 — same gate as the no-T\n"
    buf = buf + "//   variant) and HEXA_METAL=1 env routes to _hx_metal_farr32_matmul_\n"
    buf = buf + "//   NT_b_gpu which calls MPSMatrixMultiplication with transposeLeft:NO,\n"
    buf = buf + "//   transposeRight:YES. The MPS API computes A · B^T natively (no host-\n"
    buf = buf + "//   side transpose copy); B is described as N×K row-major and MPS does\n"
    buf = buf + "//   the transpose internally via its tile scheduler.\n"
    buf = buf + "//\n"
    buf = buf + "//   See Apple docs: MPSMatrixMultiplication.init(device:transposeLeft:\n"
    buf = buf + "//   transposeRight:resultRows:resultColumns:interiorColumns:alpha:beta:)\n"
    buf = buf + "//   When transposeRight=YES, the right matrix's logical dimensions are\n"
    buf = buf + "//   (interiorColumns × resultColumns) — here K (interior) × N (result)\n"
    buf = buf + "//   — but its physical (descriptor) layout is N rows × K columns row-\n"
    buf = buf + "//   major, which matches our B layout exactly.\n"
    buf = buf + "//\n"
    buf = buf + "// CPU fallback: ikj triple loop over A[i,k] * B[j,k]. Same cache shape\n"
    buf = buf + "// as the no-T variant but the B-stride access pattern is row-major (B\n"
    buf = buf + "// row j is K contiguous floats), which is the same FMA-friendly shape.\n"
    buf = buf + "HexaVal hexa_farr32_matmul_NT_b(HexaVal a_v, HexaVal ar_v, HexaVal ac_v,\n"
    buf = buf + "                                HexaVal b_v, HexaVal br_v) {\n"
    buf = buf + "    int64_t a_id = hexa_as_num(a_v);\n"
    buf = buf + "    int64_t M    = hexa_as_num(ar_v);\n"
    buf = buf + "    int64_t K    = hexa_as_num(ac_v);\n"
    buf = buf + "    int64_t b_id = hexa_as_num(b_v);\n"
    buf = buf + "    int64_t N    = hexa_as_num(br_v);\n"
    buf = buf + "    if (a_id < 0 || a_id >= _hx_farr32_count) return hexa_int(-1);\n"
    buf = buf + "    if (b_id < 0 || b_id >= _hx_farr32_count) return hexa_int(-1);\n"
    buf = buf + "    if (M <= 0 || K <= 0 || N <= 0)           return hexa_int(-1);\n"
    buf = buf + "    HexaFarr32Entry* ae = &_hx_farr32_table[a_id];\n"
    buf = buf + "    HexaFarr32Entry* be = &_hx_farr32_table[b_id];\n"
    buf = buf + "    if (!ae->buf || !be->buf)                 return hexa_int(-1);\n"
    buf = buf + "    if (ae->len < M * K)                      return hexa_int(-1);\n"
    buf = buf + "    if (be->len < N * K)                      return hexa_int(-1);\n"
    buf = buf + "    HexaVal c_handle = hexa_farr32_zeros(hexa_int(M * N));\n"
    buf = buf + "    int64_t c_id = HX_INT(c_handle);\n"
    buf = buf + "    if (c_id < 0 || c_id >= _hx_farr32_count) return hexa_int(-1);\n"
    buf = buf + "    /* Re-fetch — farr32_zeros may have realloc'd the table. */\n"
    buf = buf + "    ae = &_hx_farr32_table[a_id];\n"
    buf = buf + "    be = &_hx_farr32_table[b_id];\n"
    buf = buf + "    HexaFarr32Entry* ce = &_hx_farr32_table[c_id];\n"
    buf = buf + "    if (!ae->buf || !be->buf)         return hexa_int(-1);\n"
    buf = buf + "    if (!ce->buf || ce->len < M * N)  return hexa_int(-1);\n"
    buf = buf + "    const float* A = ae->buf;\n"
    buf = buf + "    const float* B = be->buf;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    float* C       = ce->buf;\n"
    buf = buf + "#if defined(__APPLE__) && defined(HEXA_METAL)\n"
    buf = buf + "    /* METAL_INTEGRATION.md step 4 of 5: MPS native transpose-right\n"
    buf = buf + "     * dispatch. Apple MPS computes A · B^T without a host-side transpose\n"
    buf = buf + "     * copy — the descriptor describes B as N×K row-major and the\n"
    buf = buf + "     * transposeRight:YES flag tells the kernel to interpret it as a\n"
    buf = buf + "     * K×N view (i.e. swap the row/col axes on the GPU tile scheduler).\n"
    buf = buf + "     * This is the bwd-input matmul shape for ag_linear and unblocks\n"
    buf = buf + "     * matmul_bwd_auto on Mac. */\n"
    buf = buf + "    if (hxlcl_getenv(\"HEXA_METAL\") &&\n"
    buf = buf + "        hxlcl_strcmp(hxlcl_getenv(\"HEXA_METAL\"), \"1\") == 0 &&\n"
    buf = buf + "        ((M * K) > 8192 || (K * N) > 8192)) {\n"
    buf = buf + "        extern int _hx_metal_farr32_matmul_NT_b_gpu(int64_t a_id,\n"
    buf = buf + "                                                    int64_t M, int64_t K,\n"
    buf = buf + "                                                    int64_t b_id, int64_t N,\n"
    buf = buf + "                                                    int64_t c_id);\n"
    buf = buf + "        int mrc = _hx_metal_farr32_matmul_NT_b_gpu(a_id, M, K, b_id, N, c_id);\n"
    buf = buf + "        if (mrc == 0) return c_handle;\n"
    buf = buf + "        /* mrc != 0: Metal path failed — fall through to CPU ikj. */\n"
    buf = buf + "    }\n"
    buf = buf + "#endif\n"
    buf = buf + "    /* CPU SGEMM with B transposed on the right.\n"
    buf = buf + "     * Inner loop: C[i,j] += A[i,k] * B[j,k].\n"
    buf = buf + "     * B[j,k] is the k-th element of row j of B (N×K row-major). For\n"
    buf = buf + "     * each (i,j) pair, we stream A row i and B row j in lock-step —\n"
    buf = buf + "     * j-major outer with k-inner gives B contiguous-row access.\n"
    buf = buf + "     *\n"
    buf = buf + "     * Block by j to keep B row resident in L1; for typical M=K=N=64..\n"
    buf = buf + "     * 1024 sizes this gives the same cache utilization as the no-T\n"
    buf = buf + "     * ikj path. (For ag_linear-class shapes the GPU path is taken\n"
    buf = buf + "     * before this loop runs, so polish here is bonus.) */\n"
    buf = buf + "    for (int64_t i = 0; i < M; i++) {\n"
    buf = buf + "        const float* Ai = A + i * K;\n"
    buf = buf + "        float*       Ci = C + i * N;\n"
    buf = buf + "        for (int64_t j = 0; j < N; j++) {\n"
    buf = buf + "            const float* Bj = B + j * K;\n"
    buf = buf + "            float acc = 0.0f;\n"
    buf = buf + "            int64_t k = 0;\n"
    buf = buf + "            for (; k + 4 <= K; k += 4) {\n"
    buf = buf + "                acc += Ai[k]   * Bj[k];\n"
    buf = buf + "                acc += Ai[k+1] * Bj[k+1];\n"
    buf = buf + "                acc += Ai[k+2] * Bj[k+2];\n"
    buf = buf + "                acc += Ai[k+3] * Bj[k+3];\n"
    buf = buf + "            }\n"
    buf = buf + "            for (; k < K; k++) {\n"
    buf = buf + "                acc += Ai[k] * Bj[k];\n"
    buf = buf + "            }\n"
    buf = buf + "            Ci[j] = acc;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    return c_handle;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════\n"
    buf = buf + "// METAL_INTEGRATION.md step 5 of 5 (2026-05-21): native FP32 SGEMM\n"
    buf = buf + "// with A transposed on the left (matmul-NT_a).\n"
    buf = buf + "//\n"
    buf = buf + "//   C[M, N] = A[K, M]^T · B[K, N]   (A as passed is K×M row-major;\n"
    buf = buf + "//                                    conceptually A_logical is M×K\n"
    buf = buf + "//                                    row-major and A^T = A_passed\n"
    buf = buf + "//                                    viewed transposed; equivalently\n"
    buf = buf + "//                                    the memory we receive is K×M\n"
    buf = buf + "//                                    contiguous with element [k, i] at\n"
    buf = buf + "//                                    a[k * M + i])\n"
    buf = buf + "//   C[i, j] = sum_{k=0..K-1} A[k, i] * B[k, j]\n"
    buf = buf + "//\n"
    buf = buf + "// Why this is the bwd-weight matmul shape for ag_linear:\n"
    buf = buf + "//   forward:  Y[M_batch, N_out] = X[M_batch, K_in] · W[K_in, N_out]\n"
    buf = buf + "//   bwd-W:    dW[K_in, N_out] = X^T[K_in, M_batch] · dY[M_batch, N_out]\n"
    buf = buf + "//   In matmul-NT_a form (A^T · B): A=X (M_batch × K_in row-major), B=dY\n"
    buf = buf + "//   (M_batch × N_out row-major). Mapping to the spec's NT_a naming:\n"
    buf = buf + "//     - spec's K (contracting/inner) = M_batch\n"
    buf = buf + "//     - spec's M (result rows)       = K_in   (= A's column count)\n"
    buf = buf + "//     - spec's N (result cols)       = N_out  (= B's column count)\n"
    buf = buf + "//   The caller passes A's true shape (K=M_batch rows, M=K_in cols) and\n"
    buf = buf + "//   B's true shape (K=M_batch rows, N=N_out cols). Both K dimensions\n"
    buf = buf + "//   must agree — they are the contracting axis.\n"
    buf = buf + "//\n"
    buf = buf + "// HEXA_METAL dispatch:\n"
    buf = buf + "//   Large shape (K*M > 8192 || K*N > 8192 — symmetric to NT_b's gate)\n"
    buf = buf + "//   and HEXA_METAL=1 env routes to _hx_metal_farr32_matmul_NT_a_gpu\n"
    buf = buf + "//   which calls MPSMatrixMultiplication with transposeLeft:YES,\n"
    buf = buf + "//   transposeRight:NO. The MPS API computes A^T · B natively (no host-\n"
    buf = buf + "//   side transpose copy); A is described as K×M row-major and the\n"
    buf = buf + "//   transposeLeft:YES flag tells the kernel to interpret it as an\n"
    buf = buf + "//   M×K view (descriptor swap on the GPU tile scheduler).\n"
    buf = buf + "//\n"
    buf = buf + "//   See Apple docs: MPSMatrixMultiplication.init(device:transposeLeft:\n"
    buf = buf + "//   transposeRight:resultRows:resultColumns:interiorColumns:alpha:beta:)\n"
    buf = buf + "//   When transposeLeft=YES, the left matrix's logical dimensions are\n"
    buf = buf + "//   (interiorColumns × resultRows) — here K (interior) × M (result rows)\n"
    buf = buf + "//   — but its physical (descriptor) layout is K rows × M columns row-\n"
    buf = buf + "//   major, which matches A's storage exactly.\n"
    buf = buf + "//\n"
    buf = buf + "// CPU fallback: ikj triple loop over A[k,i] * B[k,j]. Outer-loop k\n"
    buf = buf + "// streams A row k (M floats) and B row k (N floats) — both contiguous —\n"
    buf = buf + "// then the (i,j) inner pair updates C[i,j]. This is the same kj/ij\n"
    buf = buf + "// reduction pattern as a transposed-A SGEMM (mirrors numpy.einsum\n"
    buf = buf + "// 'mk,mn->kn'). For typical ag_linear shapes (M=batch, K=K_in≤4096,\n"
    buf = buf + "// N=N_out≤4096) the GPU path is taken before the CPU loop runs.\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "HexaVal hexa_farr32_matmul_NT_a(HexaVal a_v, HexaVal ar_v, HexaVal ac_v,\n"
    buf = buf + "                                HexaVal b_v, HexaVal bc_v) {\n"
    buf = buf + "    int64_t a_id = hexa_as_num(a_v);\n"
    buf = buf + "    int64_t K    = hexa_as_num(ar_v);  /* spec: K = A's row count = contracting dim */\n"
    buf = buf + "    int64_t M    = hexa_as_num(ac_v);  /* spec: M = A's col count = result rows */\n"
    buf = buf + "    int64_t b_id = hexa_as_num(b_v);\n"
    buf = buf + "    int64_t N    = hexa_as_num(bc_v);  /* spec: N = B's col count = result cols */\n"
    buf = buf + "    if (a_id < 0 || a_id >= _hx_farr32_count) return hexa_int(-1);\n"
    buf = buf + "    if (b_id < 0 || b_id >= _hx_farr32_count) return hexa_int(-1);\n"
    buf = buf + "    if (M <= 0 || K <= 0 || N <= 0)           return hexa_int(-1);\n"
    buf = buf + "    HexaFarr32Entry* ae = &_hx_farr32_table[a_id];\n"
    buf = buf + "    HexaFarr32Entry* be = &_hx_farr32_table[b_id];\n"
    buf = buf + "    if (!ae->buf || !be->buf)                 return hexa_int(-1);\n"
    buf = buf + "    if (ae->len < K * M)                      return hexa_int(-1);\n"
    buf = buf + "    if (be->len < K * N)                      return hexa_int(-1);\n"
    buf = buf + "    HexaVal c_handle = hexa_farr32_zeros(hexa_int(M * N));\n"
    buf = buf + "    int64_t c_id = HX_INT(c_handle);\n"
    buf = buf + "    if (c_id < 0 || c_id >= _hx_farr32_count) return hexa_int(-1);\n"
    buf = buf + "    /* Re-fetch — farr32_zeros may have realloc'd the table. */\n"
    buf = buf + "    ae = &_hx_farr32_table[a_id];\n"
    buf = buf + "    be = &_hx_farr32_table[b_id];\n"
    buf = buf + "    HexaFarr32Entry* ce = &_hx_farr32_table[c_id];\n"
    buf = buf + "    if (!ae->buf || !be->buf)         return hexa_int(-1);\n"
    buf = buf + "    if (!ce->buf || ce->len < M * N)  return hexa_int(-1);\n"
    buf = buf + "    const float* A = ae->buf;\n"
    buf = buf + "    const float* B = be->buf;\n"
    buf = buf + "    float* C       = ce->buf;\n"
    buf = buf + "#if defined(__APPLE__) && defined(HEXA_METAL)\n"
    buf = buf + "    /* METAL_INTEGRATION.md step 5 of 5: MPS native transpose-left\n"
    buf = buf + "     * dispatch. Apple MPS computes A^T · B without a host-side transpose\n"
    buf = buf + "     * copy — the descriptor describes A as K×M row-major and the\n"
    buf = buf + "     * transposeLeft:YES flag tells the kernel to interpret it as an\n"
    buf = buf + "     * M×K view (i.e. swap the row/col axes on the GPU tile scheduler).\n"
    buf = buf + "     * This is the bwd-weight matmul shape for ag_linear and unblocks\n"
    buf = buf + "     * the dW = X^T · dY accumulator on Mac. Together with NT_b's\n"
    buf = buf + "     * dX = dY · W^T this closes the full transposed-matmul family. */\n"
    buf = buf + "    if (hxlcl_getenv(\"HEXA_METAL\") &&\n"
    buf = buf + "        hxlcl_strcmp(hxlcl_getenv(\"HEXA_METAL\"), \"1\") == 0 &&\n"
    buf = buf + "        ((K * M) > 8192 || (K * N) > 8192)) {\n"
    buf = buf + "        extern int _hx_metal_farr32_matmul_NT_a_gpu(int64_t a_id,\n"
    buf = buf + "                                                    int64_t M, int64_t K,\n"
    buf = buf + "                                                    int64_t b_id, int64_t K2,\n"
    buf = buf + "                                                    int64_t N, int64_t c_id);\n"
    buf = buf + "        int mrc = _hx_metal_farr32_matmul_NT_a_gpu(a_id, M, K, b_id, K, N, c_id);\n"
    buf = buf + "        if (mrc == 0) return c_handle;\n"
    buf = buf + "        /* mrc != 0: Metal path failed — fall through to CPU ikj. */\n"
    buf = buf + "    }\n"
    buf = buf + "#endif\n"
    buf = buf + "    /* CPU SGEMM with A transposed on the left.\n"
    buf = buf + "     * Inner formula: C[i,j] = sum_k A[k,i] * B[k,j].\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "     * Outer loop over k streams A row k (M contiguous floats from a[k*M..])\n"
    buf = buf + "     * and B row k (N contiguous floats from b[k*N..]); the inner (i,j)\n"
    buf = buf + "     * loop accumulates into C. This kij ordering matches the bwd-weight\n"
    buf = buf + "     * shape used by ag_linear and gives B contiguous-row access. */\n"
    buf = buf + "    for (int64_t k = 0; k < K; k++) {\n"
    buf = buf + "        const float* Ak = A + k * M;  /* A's k-th row, length M (= original a[k,*]) */\n"
    buf = buf + "        const float* Bk = B + k * N;  /* B's k-th row, length N */\n"
    buf = buf + "        for (int64_t i = 0; i < M; i++) {\n"
    buf = buf + "            float aki = Ak[i];        /* = original A[k, i] */\n"
    buf = buf + "            float*  Ci = C + i * N;\n"
    buf = buf + "            int64_t j = 0;\n"
    buf = buf + "            for (; j + 4 <= N; j += 4) {\n"
    buf = buf + "                Ci[j]   += aki * Bk[j];\n"
    buf = buf + "                Ci[j+1] += aki * Bk[j+1];\n"
    buf = buf + "                Ci[j+2] += aki * Bk[j+2];\n"
    buf = buf + "                Ci[j+3] += aki * Bk[j+3];\n"
    buf = buf + "            }\n"
    buf = buf + "            for (; j < N; j++) {\n"
    buf = buf + "                Ci[j] += aki * Bk[j];\n"
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return c_handle;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════\n"
    buf = buf + "// RFC 036 (2026-05-13): farr_int_array — packed int64_t* handle.\n"
    buf = buf + "//\n"
    buf = buf + "// Mirrors hexa_farr_zeros/get/set/len/free verbatim, except the buffer\n"
    buf = buf + "// is int64_t* (not double*). Allocator returns an integer handle; the\n"
    buf = buf + "// hexa-side type is `int` (same TAG_INT representation as farr handles\n"
    buf = buf + "// for doubles). Distinguished only by which builtins consume the id.\n"
    buf = buf + "//\n"
    buf = buf + "// Lifetime: handles are NEVER freed automatically — explicit free via\n"
    buf = buf + "// hexa_farr_int_free. Same model as RFC 030 farr. Memory-leak risk for\n"
    buf = buf + "// typical usage (one alloc per cache field, freed at process end) is\n"
    buf = buf + "// bounded. Out-of-bounds reads return 0; OOB writes are no-ops.\n"
    buf = buf + "//\n"
    buf = buf + "// Builtins:\n"
    buf = buf + "//     farr_int_zeros(n)            -> int handle    (n int64s, all 0)\n"
    buf = buf + "//     farr_int_get(h, i)           -> int\n"
    buf = buf + "//     farr_int_set(h, i, x)        -> int           (returns h for chaining)\n"
    buf = buf + "//     farr_int_len(h)              -> int\n"
    buf = buf + "//     farr_int_fill_from_array(h, arr) -> int       (bulk init from [int])\n"
    buf = buf + "//     farr_int_copy(src)           -> int handle    (new buf, same contents)\n"
    buf = buf + "//     farr_int_sum(h)              -> int           (reduction; mainly tests)\n"
    buf = buf + "//     farr_int_free(h)             -> void          (optional; explicit)\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════\n"
    buf = buf + "\n"
    buf = buf + "typedef struct {\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    int64_t* buf;\n"
    buf = buf + "    int64_t  len;\n"
    buf = buf + "} HexaIarrEntry;\n"
    buf = buf + "\n"
    buf = buf + "static HexaIarrEntry* _hx_iarr_table        = NULL;\n"
    buf = buf + "static int64_t        _hx_iarr_count        = 0;\n"
    buf = buf + "static int64_t        _hx_iarr_capacity     = 0;\n"
    buf = buf + "static int64_t*       _hx_iarr_freelist     = NULL;\n"
    buf = buf + "static int64_t        _hx_iarr_freelist_n   = 0;\n"
    buf = buf + "static int64_t        _hx_iarr_freelist_cap = 0;\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_farr_int_zeros(HexaVal n_v) {\n"
    buf = buf + "    int64_t n = hexa_as_num(n_v);\n"
    buf = buf + "    if (n < 0) n = 0;\n"
    buf = buf + "    int64_t* buf = NULL;\n"
    buf = buf + "    if (n > 0) {\n"
    buf = buf + "        buf = (int64_t*)calloc((size_t)n, sizeof(int64_t));\n"
    buf = buf + "        if (!buf) {\n"
    buf = buf + "            fprintf(stderr, \"[farr_int] OOM allocating %lld int64s\\n\", (long long)n);\n"
    buf = buf + "            exit(77);\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    int64_t id;\n"
    buf = buf + "    if (_hx_iarr_freelist_n > 0) {\n"
    buf = buf + "        id = _hx_iarr_freelist[--_hx_iarr_freelist_n];\n"
    buf = buf + "    } else {\n"
    buf = buf + "        if (_hx_iarr_count >= _hx_iarr_capacity) {\n"
    buf = buf + "            int64_t new_cap = _hx_iarr_capacity < 16 ? 16 : _hx_iarr_capacity * 2;\n"
    buf = buf + "            HexaIarrEntry* nt = (HexaIarrEntry*)realloc(_hx_iarr_table,\n"
    buf = buf + "                                  (size_t)new_cap * sizeof(HexaIarrEntry));\n"
    buf = buf + "            if (!nt) {\n"
    buf = buf + "                fprintf(stderr, \"[farr_int] OOM growing handle table\\n\");\n"
    buf = buf + "                if (buf) free(buf);\n"
    buf = buf + "                exit(77);\n"
    buf = buf + "            }\n"
    buf = buf + "            _hx_iarr_table = nt;\n"
    buf = buf + "            _hx_iarr_capacity = new_cap;\n"
    buf = buf + "        }\n"
    buf = buf + "        id = _hx_iarr_count++;\n"
    buf = buf + "    }\n"
    buf = buf + "    _hx_iarr_table[id].buf = buf;\n"
    buf = buf + "    _hx_iarr_table[id].len = n;\n"
    buf = buf + "    return hexa_int(id);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_farr_int_get(HexaVal h_v, HexaVal i_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    int64_t i  = hexa_as_num(i_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_iarr_count) return hexa_int(0);\n"
    buf = buf + "    HexaIarrEntry* e = &_hx_iarr_table[id];\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    if (!e->buf || i < 0 || i >= e->len) return hexa_int(0);\n"
    buf = buf + "    return hexa_int(e->buf[i]);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_farr_int_set(HexaVal h_v, HexaVal i_v, HexaVal x_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    int64_t i  = hexa_as_num(i_v);\n"
    buf = buf + "    int64_t x  = hexa_as_num(x_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_iarr_count) return h_v;\n"
    buf = buf + "    HexaIarrEntry* e = &_hx_iarr_table[id];\n"
    buf = buf + "    if (!e->buf || i < 0 || i >= e->len) return h_v;\n"
    buf = buf + "    e->buf[i] = x;\n"
    buf = buf + "    return h_v;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_farr_int_len(HexaVal h_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_iarr_count) return hexa_int(0);\n"
    buf = buf + "    return hexa_int(_hx_iarr_table[id].len);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// One-time migration helper: bulk-copy a hexa [int] (boxed HexaVal array)\n"
    buf = buf + "// into a farr_int handle. Used by cache builders to translate vendored\n"
    buf = buf + "// literal-returning fns (e.g. uccsd_lih_ham_flip_mask() -> [int]) into a\n"
    buf = buf + "// packed int64_t buffer exactly once. After this call the [int] is no\n"
    buf = buf + "// longer referenced and the arena reclaims it on next rewind.\n"
    buf = buf + "HexaVal hexa_farr_int_fill_from_array(HexaVal h_v, HexaVal arr_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_iarr_count) return hexa_int(-1);\n"
    buf = buf + "    HexaIarrEntry* e = &_hx_iarr_table[id];\n"
    buf = buf + "    if (!e->buf) return hexa_int(-1);\n"
    buf = buf + "    // Unwrap interp-side Val struct → real TAG_ARRAY HexaVal.\n"
    buf = buf + "    // Under `hexa.real run`, the hexa-side `[int]` literal reaches the\n"
    buf = buf + "    // kernel as TAG_VALSTRUCT with tag_i == TAG_ARRAY (5) and int_val ==\n"
    buf = buf + "    // index into the global `array_store` (see hexa_full.hexa val_array,\n"
    buf = buf + "    // ~line 18272). Mirrors the T33 Fix 4 pattern at runtime.c:3530.\n"
    buf = buf + "    // Without this, HX_IS_ARRAY(arr_v) is false → silent -1 return.\n"
    buf = buf + "    // Follow-up to commit b8acb90f (RFC 036 landing); fixes T5a/b/c in\n"
    buf = buf + "    // chemistry_vqe/module/_rfc036_smoke.hexa.\n"
    buf = buf + "    HexaVal real_arr = arr_v;\n"
    buf = buf + "    if (HX_IS_VALSTRUCT(arr_v) && HX_VS(arr_v)\n"
    buf = buf + "        && HX_VSF(arr_v, tag_i) == HEXA_INTERP_TAG_ARRAY\n"
    buf = buf + "        && &array_store != 0\n"
    buf = buf + "        && HX_IS_ARRAY(array_store) && HX_ARR_ITEMS(array_store)) {\n"
    buf = buf + "        int64_t idx = HX_VSF(arr_v, int_val);\n"
    buf = buf + "        if (idx >= 0 && idx < (int64_t)HX_ARR_LEN(array_store)) {\n"
    buf = buf + "            real_arr = HX_ARR_ITEMS(array_store)[idx];\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    if (!HX_IS_ARRAY(real_arr)) return hexa_int(-1);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    int64_t  n     = HX_ARR_LEN(real_arr);\n"
    buf = buf + "    HexaVal* items = HX_ARR_ITEMS(real_arr);\n"
    buf = buf + "    int64_t  cap   = e->len;\n"
    buf = buf + "    int64_t  m     = (n < cap) ? n : cap;\n"
    buf = buf + "    for (int64_t k = 0; k < m; k++) {\n"
    buf = buf + "        e->buf[k] = hexa_as_num(items[k]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int(m);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_farr_int_copy(HexaVal src_v) {\n"
    buf = buf + "    int64_t sid = hexa_as_num(src_v);\n"
    buf = buf + "    if (sid < 0 || sid >= _hx_iarr_count) return hexa_int(-1);\n"
    buf = buf + "    HexaIarrEntry* se = &_hx_iarr_table[sid];\n"
    buf = buf + "    if (!se->buf) return hexa_int(-1);\n"
    buf = buf + "    HexaVal dst_v = hexa_farr_int_zeros(hexa_int(se->len));\n"
    buf = buf + "    int64_t did = hexa_as_num(dst_v);\n"
    buf = buf + "    if (did < 0) return hexa_int(-1);\n"
    buf = buf + "    HexaIarrEntry* de = &_hx_iarr_table[did];\n"
    buf = buf + "    if (de->buf && se->len > 0) {\n"
    buf = buf + "        hxlcl_memcpy(de->buf, se->buf, (size_t)se->len * sizeof(int64_t));\n"
    buf = buf + "    }\n"
    buf = buf + "    return dst_v;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_farr_int_sum(HexaVal h_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_iarr_count) return hexa_int(0);\n"
    buf = buf + "    HexaIarrEntry* e = &_hx_iarr_table[id];\n"
    buf = buf + "    if (!e->buf) return hexa_int(0);\n"
    buf = buf + "    int64_t s = 0;\n"
    buf = buf + "    for (int64_t k = 0; k < e->len; k++) s += e->buf[k];\n"
    buf = buf + "    return hexa_int(s);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_farr_int_free(HexaVal h_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_iarr_count) return hexa_void();\n"
    buf = buf + "    HexaIarrEntry* e = &_hx_iarr_table[id];\n"
    buf = buf + "    if (e->buf) { free(e->buf); e->buf = NULL; e->len = 0; }\n"
    buf = buf + "    if (_hx_iarr_freelist_n >= _hx_iarr_freelist_cap) {\n"
    buf = buf + "        int64_t new_cap = _hx_iarr_freelist_cap < 16 ? 16 : _hx_iarr_freelist_cap * 2;\n"
    buf = buf + "        int64_t* nf = (int64_t*)realloc(_hx_iarr_freelist,\n"
    buf = buf + "                       (size_t)new_cap * sizeof(int64_t));\n"
    buf = buf + "        if (nf) {\n"
    buf = buf + "            _hx_iarr_freelist = nf;\n"
    buf = buf + "            _hx_iarr_freelist_cap = new_cap;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_hx_iarr_freelist_n < _hx_iarr_freelist_cap) {\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        _hx_iarr_freelist[_hx_iarr_freelist_n++] = id;\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ── farr high-level state-vector kernels (qmirror Phase 7 fast paths) ──\n"
    buf = buf + "// The per-iteration interpreter overhead of calling farr_get/farr_set\n"
    buf = buf + "// inside a 2^n loop dominates wall time and arena allocation pressure\n"
    buf = buf + "// at n=17 (131 k iterations × ~12 boxed-Val constructions each =\n"
    buf = buf + "// ~130 MB of arena Vals before the function returns and the arena\n"
    buf = buf + "// rewinds). The two whole-loop kernels below close that gap by\n"
    buf = buf + "// running the entire inner loop in C with raw double arithmetic.\n"
    buf = buf + "//\n"
    buf = buf + "// Both are pure functions of (handles, gate matrices, qubit indices,\n"
    buf = buf + "// total qubit count). Storage layout matches qmirror's qiskit-aligned\n"
    buf = buf + "// convention: amp[i] is the coefficient of |b_{n-1}...b_0> where\n"
    buf = buf + "// b_q = (i >> q) & 1, split into re/im as packed double[] buffers.\n"
    buf = buf + "\n"
    buf = buf + "// Convert a hexa [float] gate (TAG_ARRAY of 4 boxed floats) into a\n"
    buf = buf + "// 4-element double[] on the C stack. Returns 1 on success, 0 on shape error.\n"
    buf = buf + "// AOT-only — in the interpreter, gate arrays are referenced via\n"
    buf = buf + "// Val{TAG_ARRAY, int_val=array_store idx}, so callers should pre-unpack\n"
    buf = buf + "// the gate into a farr handle and use farr_apply_single_farr instead.\n"
    buf = buf + "static int _hx_farr_unpack_gate4(HexaVal arr, double dst[4]) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr) || HX_ARR_LEN(arr) < 4) return 0;\n"
    buf = buf + "    HexaVal* items = HX_ARR_ITEMS(arr);\n"
    buf = buf + "    for (int i = 0; i < 4; i++) {\n"
    buf = buf + "        dst[i] = __hx_to_double(items[i]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return 1;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Core single-qubit kernel — takes 4 raw doubles for gate_re/gate_im.\n"
    buf = buf + "// Internal; called from both public entry points after gate unpacking.\n"
    buf = buf + "static void _hx_farr_apply_single_core(double* re, double* im,\n"
    buf = buf + "                                       const double m_re[4],\n"
    buf = buf + "                                       const double m_im[4],\n"
    buf = buf + "                                       int64_t target, int64_t n_qubits) {\n"
    buf = buf + "    int64_t dim = 1;\n"
    buf = buf + "    for (int k = 0; k < (int)n_qubits; k++) dim *= 2;\n"
    buf = buf + "    int64_t bit = (int64_t)1 << target;\n"
    buf = buf + "    double m00r = m_re[0], m00i = m_im[0];\n"
    buf = buf + "    double m01r = m_re[1], m01i = m_im[1];\n"
    buf = buf + "    double m10r = m_re[2], m10i = m_im[2];\n"
    buf = buf + "    double m11r = m_re[3], m11i = m_im[3];\n"
    buf = buf + "    for (int64_t i = 0; i < dim; i++) {\n"
    buf = buf + "        if ((i & bit) == 0) {\n"
    buf = buf + "            int64_t j = i | bit;\n"
    buf = buf + "            double s0r = re[i], s0i = im[i];\n"
    buf = buf + "            double s1r = re[j], s1i = im[j];\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "            re[i] = (m00r*s0r - m00i*s0i) + (m01r*s1r - m01i*s1i);\n"
    buf = buf + "            im[i] = (m00r*s0i + m00i*s0r) + (m01r*s1i + m01i*s1r);\n"
    buf = buf + "            re[j] = (m10r*s0r - m10i*s0i) + (m11r*s1r - m11i*s1i);\n"
    buf = buf + "            im[j] = (m10r*s0i + m10i*s0r) + (m11r*s1i + m11i*s1r);\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// farr_apply_single(re_h, im_h, gate_re, gate_im, target, n_qubits) -> 0\n"
    buf = buf + "// Gate matrices are hexa [float] arrays of 4 doubles. AOT only — see\n"
    buf = buf + "// farr_apply_single_farr for the interpreter-safe variant.\n"
    buf = buf + "HexaVal hexa_farr_apply_single(HexaVal re_v, HexaVal im_v,\n"
    buf = buf + "                               HexaVal gate_re, HexaVal gate_im,\n"
    buf = buf + "                               HexaVal target_v, HexaVal nq_v) {\n"
    buf = buf + "    int64_t re_id = hexa_as_num(re_v);\n"
    buf = buf + "    int64_t im_id = hexa_as_num(im_v);\n"
    buf = buf + "    int64_t target = hexa_as_num(target_v);\n"
    buf = buf + "    int64_t n_qubits = hexa_as_num(nq_v);\n"
    buf = buf + "    if (re_id < 0 || re_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (im_id < 0 || im_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    double* re = _hx_farr_table[re_id].buf;\n"
    buf = buf + "    double* im = _hx_farr_table[im_id].buf;\n"
    buf = buf + "    if (!re || !im) return hexa_int(-1);\n"
    buf = buf + "    double m_re[4], m_im[4];\n"
    buf = buf + "    if (!_hx_farr_unpack_gate4(gate_re, m_re)) return hexa_int(-1);\n"
    buf = buf + "    if (!_hx_farr_unpack_gate4(gate_im, m_im)) return hexa_int(-1);\n"
    buf = buf + "    _hx_farr_apply_single_core(re, im, m_re, m_im, target, n_qubits);\n"
    buf = buf + "    return hexa_int(0);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// farr_apply_single_farr(re_h, im_h, gate_re_h, gate_im_h, target, n_qubits) -> 0\n"
    buf = buf + "// Same kernel; gate matrices are farr handles (packed double[4]).\n"
    buf = buf + "// Used by the interpreter dispatch (hexa_full.hexa) which pre-unpacks\n"
    buf = buf + "// [float] gates into a farr to sidestep the array_store-from-C problem.\n"
    buf = buf + "HexaVal hexa_farr_apply_single_farr(HexaVal re_v, HexaVal im_v,\n"
    buf = buf + "                                    HexaVal gre_h, HexaVal gim_h,\n"
    buf = buf + "                                    HexaVal target_v, HexaVal nq_v) {\n"
    buf = buf + "    int64_t re_id = hexa_as_num(re_v);\n"
    buf = buf + "    int64_t im_id = hexa_as_num(im_v);\n"
    buf = buf + "    int64_t gr_id = hexa_as_num(gre_h);\n"
    buf = buf + "    int64_t gi_id = hexa_as_num(gim_h);\n"
    buf = buf + "    int64_t target = hexa_as_num(target_v);\n"
    buf = buf + "    int64_t n_qubits = hexa_as_num(nq_v);\n"
    buf = buf + "    if (re_id < 0 || re_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (im_id < 0 || im_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (gr_id < 0 || gr_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (gi_id < 0 || gi_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    double* re = _hx_farr_table[re_id].buf;\n"
    buf = buf + "    double* im = _hx_farr_table[im_id].buf;\n"
    buf = buf + "    double* gr = _hx_farr_table[gr_id].buf;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    double* gi = _hx_farr_table[gi_id].buf;\n"
    buf = buf + "    if (!re || !im || !gr || !gi) return hexa_int(-1);\n"
    buf = buf + "    if (_hx_farr_table[gr_id].len < 4 || _hx_farr_table[gi_id].len < 4) return hexa_int(-1);\n"
    buf = buf + "    double m_re[4] = { gr[0], gr[1], gr[2], gr[3] };\n"
    buf = buf + "    double m_im[4] = { gi[0], gi[1], gi[2], gi[3] };\n"
    buf = buf + "    _hx_farr_apply_single_core(re, im, m_re, m_im, target, n_qubits);\n"
    buf = buf + "    return hexa_int(0);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// farr_apply_cnot(src_re_h, src_im_h, dst_re_h, dst_im_h, control, target, n_qubits) -> 0\n"
    buf = buf + "// Computes the CNOT image of (src_re, src_im) into the (already-zeroed)\n"
    buf = buf + "// (dst_re, dst_im) buffers. Does NOT touch src. Returns 0 / -1.\n"
    buf = buf + "//\n"
    buf = buf + "// Per qmirror state_vector.hexa lines 111-137: out[j] += state[i] where\n"
    buf = buf + "// j = i ^ (1<<target) iff bit `control` of i is 1, else j = i. Because\n"
    buf = buf + "// the partition is a permutation (no collisions), the += can be a =\n"
    buf = buf + "// when dst starts zero. We keep the += form to match the reference.\n"
    buf = buf + "HexaVal hexa_farr_apply_cnot(HexaVal src_re_v, HexaVal src_im_v,\n"
    buf = buf + "                             HexaVal dst_re_v, HexaVal dst_im_v,\n"
    buf = buf + "                             HexaVal control_v, HexaVal target_v,\n"
    buf = buf + "                             HexaVal nq_v) {\n"
    buf = buf + "    int64_t sr = hexa_as_num(src_re_v);\n"
    buf = buf + "    int64_t si = hexa_as_num(src_im_v);\n"
    buf = buf + "    int64_t dr = hexa_as_num(dst_re_v);\n"
    buf = buf + "    int64_t di = hexa_as_num(dst_im_v);\n"
    buf = buf + "    if (sr < 0 || sr >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (si < 0 || si >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (dr < 0 || dr >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (di < 0 || di >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    double* src_re = _hx_farr_table[sr].buf;\n"
    buf = buf + "    double* src_im = _hx_farr_table[si].buf;\n"
    buf = buf + "    double* dst_re = _hx_farr_table[dr].buf;\n"
    buf = buf + "    double* dst_im = _hx_farr_table[di].buf;\n"
    buf = buf + "    if (!src_re || !src_im || !dst_re || !dst_im) return hexa_int(-1);\n"
    buf = buf + "    int64_t control = hexa_as_num(control_v);\n"
    buf = buf + "    int64_t target  = hexa_as_num(target_v);\n"
    buf = buf + "    int64_t n_qubits = hexa_as_num(nq_v);\n"
    buf = buf + "    int64_t dim = 1;\n"
    buf = buf + "    for (int k = 0; k < (int)n_qubits; k++) dim *= 2;\n"
    buf = buf + "    int64_t cbit = (int64_t)1 << control;\n"
    buf = buf + "    int64_t tbit = (int64_t)1 << target;\n"
    buf = buf + "    for (int64_t i = 0; i < dim; i++) {\n"
    buf = buf + "        int64_t j = ((i & cbit) != 0) ? (i ^ tbit) : i;\n"
    buf = buf + "        dst_re[j] += src_re[i];\n"
    buf = buf + "        dst_im[j] += src_im[i];\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int(0);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ───────────────────────────────────────────────────────────────────────\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// RFC 034 (2026-05-13): Pauli-string exponential + expectation kernels.\n"
    buf = buf + "// Whole-loop C kernels to eliminate the per-iteration interp arena pressure\n"
    buf = buf + "// (~1.5 KB/op of boxed Vals retained until function return) that blocked\n"
    buf = buf + "// qmirror's chemistry_vqe_cmt_uccsd_lih_4e4o.hexa from running an in-process\n"
    buf = buf + "// 26-parameter Nelder-Mead loop at 4e/4o. Same shape as the existing\n"
    buf = buf + "// farr_apply_single / farr_apply_cnot fast paths.\n"
    buf = buf + "//\n"
    buf = buf + "// Algorithm validated against scipy.linalg.expm at machine precision\n"
    buf = buf + "// (max err < 1e-12 on 8 random 6-qubit Pauli strings) in the qmirror\n"
    buf = buf + "// dev session's offline numpy harness (2026-05-13).\n"
    buf = buf + "//\n"
    buf = buf + "// Per Pauli string P on n qubits — precomputed masks (offline, in the\n"
    buf = buf + "// hexa-side caller):\n"
    buf = buf + "//   flip_mask = OR over q where label[n-1-q] ∈ {X, Y}\n"
    buf = buf + "//   z_mask    = OR over q where label[n-1-q] = Z\n"
    buf = buf + "//   y_mask    = OR over q where label[n-1-q] = Y\n"
    buf = buf + "//   count_Y   = popcount(y_mask)\n"
    buf = buf + "// (These four ints fully describe P; no per-amplitude string parsing.)\n"
    buf = buf + "//\n"
    buf = buf + "// Phase(i) for amplitude index i:\n"
    buf = buf + "//   parity_bits = i & (z_mask | y_mask)\n"
    buf = buf + "//   sign = (-1)^popcount(parity_bits)\n"
    buf = buf + "//   cy = count_Y % 4\n"
    buf = buf + "//   phase_re/im table:\n"
    buf = buf + "//     cy 0 →  ( sign,  0    )\n"
    buf = buf + "//     cy 1 →  ( 0,     sign )\n"
    buf = buf + "//     cy 2 →  (-sign,  0    )\n"
    buf = buf + "//     cy 3 →  ( 0,    -sign )\n"
    buf = buf + "\n"
    buf = buf + "static inline int _hx_pauli_popcount6(int64_t x) {\n"
    buf = buf + "    // 6-qubit max → at most 6 set bits. Use compiler builtin where available.\n"
    buf = buf + "#if defined(__GNUC__) || defined(__clang__)\n"
    buf = buf + "    return __builtin_popcountll((unsigned long long)x);\n"
    buf = buf + "#else\n"
    buf = buf + "    int n = 0;\n"
    buf = buf + "    while (x) { n += (int)(x & 1); x >>= 1; }\n"
    buf = buf + "    return n;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// farr_pauli_exp_inplace(re_h, im_h, alpha, flip_mask, z_mask, y_mask, count_Y, n_qubits) -> 0\n"
    buf = buf + "// Apply exp(i*alpha*P) to the state in place. P^2 = I, so\n"
    buf = buf + "// exp(i*alpha*P) = cos(alpha)*I + i*sin(alpha)*P. Pair-iteration:\n"
    buf = buf + "//   for i in 0..dim where j = i ^ flip_mask, i <= j:\n"
    buf = buf + "//     new_amp_i = cos*amp_i + (i*sin*sign_y*phase(i)) * amp_j\n"
    buf = buf + "//     new_amp_j = (i*sin*phase(i)) * amp_i + cos*amp_j\n"
    buf = buf + "//   where sign_y = (-1)^count_Y and phase(j) = phase(i) * sign_y.\n"
    buf = buf + "// flip_mask == 0 (diagonal Pauli): in-place per-amplitude update.\n"
    buf = buf + "//\n"
    buf = buf + "// RFC 039 prerequisite (2026-05-13): the math body is hoisted into\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// `_hx_pauli_exp_raw` so the parameter-shift gradient kernel can apply\n"
    buf = buf + "// many Pauli rotations without re-unboxing handles. The HexaVal entry\n"
    buf = buf + "// point below is now a thin shim.\n"
    buf = buf + "static inline void _hx_pauli_exp_raw(double* re, double* im, double alpha,\n"
    buf = buf + "                                     int64_t flip_mask, int64_t z_mask,\n"
    buf = buf + "                                     int64_t y_mask, int64_t count_Y,\n"
    buf = buf + "                                     int64_t n_qubits) {\n"
    buf = buf + "    int64_t dim = 1;\n"
    buf = buf + "    for (int k = 0; k < (int)n_qubits; k++) dim *= 2;\n"
    buf = buf + "    double c = hxlcl_cos(alpha);\n"
    buf = buf + "    double s = hxlcl_sin(alpha);\n"
    buf = buf + "    int cy_mod = (int)(count_Y % 4);\n"
    buf = buf + "    double sign_y = ((count_Y % 2) == 0) ? 1.0 : -1.0;\n"
    buf = buf + "    int64_t parity_mask = z_mask | y_mask;\n"
    buf = buf + "\n"
    buf = buf + "    if (flip_mask == 0) {\n"
    buf = buf + "        for (int64_t i = 0; i < dim; i++) {\n"
    buf = buf + "            int pc = _hx_pauli_popcount6(i & parity_mask);\n"
    buf = buf + "            double sign = (pc % 2 == 0) ? 1.0 : -1.0;\n"
    buf = buf + "            double ri = re[i], ii = im[i];\n"
    buf = buf + "            re[i] = c * ri - (s * sign) * ii;\n"
    buf = buf + "            im[i] = (s * sign) * ri + c * ii;\n"
    buf = buf + "        }\n"
    buf = buf + "        return;\n"
    buf = buf + "    }\n"
    buf = buf + "\n"
    buf = buf + "    for (int64_t i = 0; i < dim; i++) {\n"
    buf = buf + "        int64_t j = i ^ flip_mask;\n"
    buf = buf + "        if (i >= j) continue;\n"
    buf = buf + "        int pc = _hx_pauli_popcount6(i & parity_mask);\n"
    buf = buf + "        double sign_i = (pc % 2 == 0) ? 1.0 : -1.0;\n"
    buf = buf + "        double pi_re, pi_im;\n"
    buf = buf + "        switch (cy_mod) {\n"
    buf = buf + "            case 0: pi_re = sign_i;  pi_im = 0.0;     break;\n"
    buf = buf + "            case 1: pi_re = 0.0;     pi_im = sign_i;  break;\n"
    buf = buf + "            case 2: pi_re = -sign_i; pi_im = 0.0;     break;\n"
    buf = buf + "            default: pi_re = 0.0;    pi_im = -sign_i; break;\n"
    buf = buf + "        }\n"
    buf = buf + "        double fij_re = -s * pi_im;\n"
    buf = buf + "        double fij_im =  s * pi_re;\n"
    buf = buf + "        double fji_re = sign_y * fij_re;\n"
    buf = buf + "        double fji_im = sign_y * fij_im;\n"
    buf = buf + "        double ri = re[i], ii = im[i];\n"
    buf = buf + "        double rj = re[j], ij = im[j];\n"
    buf = buf + "        double new_ri = c * ri + fji_re * rj - fji_im * ij;\n"
    buf = buf + "        double new_ii = c * ii + fji_re * ij + fji_im * rj;\n"
    buf = buf + "        double new_rj = fij_re * ri - fij_im * ii + c * rj;\n"
    buf = buf + "        double new_ij = fij_re * ii + fij_im * ri + c * ij;\n"
    buf = buf + "        re[i] = new_ri;  im[i] = new_ii;\n"
    buf = buf + "        re[j] = new_rj;  im[j] = new_ij;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "static inline double _hx_pauli_expectation_raw(const double* re, const double* im,\n"
    buf = buf + "                                               int64_t flip_mask, int64_t z_mask,\n"
    buf = buf + "                                               int64_t y_mask, int64_t count_Y,\n"
    buf = buf + "                                               int64_t n_qubits) {\n"
    buf = buf + "    int64_t dim = 1;\n"
    buf = buf + "    for (int k = 0; k < (int)n_qubits; k++) dim *= 2;\n"
    buf = buf + "    int cy_mod = (int)(count_Y % 4);\n"
    buf = buf + "    int64_t parity_mask = z_mask | y_mask;\n"
    buf = buf + "    double sum_re = 0.0;\n"
    buf = buf + "    for (int64_t i = 0; i < dim; i++) {\n"
    buf = buf + "        int pc = _hx_pauli_popcount6(i & parity_mask);\n"
    buf = buf + "        double sign_i = (pc % 2 == 0) ? 1.0 : -1.0;\n"
    buf = buf + "        double pi_re, pi_im;\n"
    buf = buf + "        switch (cy_mod) {\n"
    buf = buf + "            case 0: pi_re = sign_i;  pi_im = 0.0;     break;\n"
    buf = buf + "            case 1: pi_re = 0.0;     pi_im = sign_i;  break;\n"
    buf = buf + "            case 2: pi_re = -sign_i; pi_im = 0.0;     break;\n"
    buf = buf + "            default: pi_re = 0.0;    pi_im = -sign_i; break;\n"
    buf = buf + "        }\n"
    buf = buf + "        int64_t j = i ^ flip_mask;\n"
    buf = buf + "        double ri = re[i], ii = im[i];\n"
    buf = buf + "        double rj = re[j], ij = im[j];\n"
    buf = buf + "        double ppj_re = pi_re * ri - pi_im * ii;\n"
    buf = buf + "        double ppj_im = pi_re * ii + pi_im * ri;\n"
    buf = buf + "        sum_re += rj * ppj_re + ij * ppj_im;\n"
    buf = buf + "    }\n"
    buf = buf + "    return sum_re;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_farr_pauli_exp_inplace(HexaVal re_v, HexaVal im_v,\n"
    buf = buf + "                                    HexaVal alpha_v,\n"
    buf = buf + "                                    HexaVal flip_v, HexaVal zmask_v,\n"
    buf = buf + "                                    HexaVal ymask_v, HexaVal cy_v,\n"
    buf = buf + "                                    HexaVal nq_v) {\n"
    buf = buf + "    int64_t re_id = hexa_as_num(re_v);\n"
    buf = buf + "    int64_t im_id = hexa_as_num(im_v);\n"
    buf = buf + "    if (re_id < 0 || re_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (im_id < 0 || im_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    double* re = _hx_farr_table[re_id].buf;\n"
    buf = buf + "    double* im = _hx_farr_table[im_id].buf;\n"
    buf = buf + "    if (!re || !im) return hexa_int(-1);\n"
    buf = buf + "    double alpha = __hx_to_double(alpha_v);\n"
    buf = buf + "    int64_t flip_mask = hexa_as_num(flip_v);\n"
    buf = buf + "    int64_t z_mask    = hexa_as_num(zmask_v);\n"
    buf = buf + "    int64_t y_mask    = hexa_as_num(ymask_v);\n"
    buf = buf + "    int64_t count_Y   = hexa_as_num(cy_v);\n"
    buf = buf + "    int64_t n_qubits  = hexa_as_num(nq_v);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    _hx_pauli_exp_raw(re, im, alpha, flip_mask, z_mask, y_mask, count_Y, n_qubits);\n"
    buf = buf + "    return hexa_int(0);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// farr_pauli_expectation(re_h, im_h, flip_mask, z_mask, y_mask, count_Y, n_qubits) -> float\n"
    buf = buf + "// Returns <psi|P|psi> for Hermitian Pauli P. For Hermitian H, the result is\n"
    buf = buf + "// purely real; we return just the real part.\n"
    buf = buf + "//   <psi|P|psi> = sum_i conj(psi_i) * P|i>\n"
    buf = buf + "//               = sum_i conj(psi_i) * phase(i) * psi_{i^flip_mask}\n"
    buf = buf + "HexaVal hexa_farr_pauli_expectation(HexaVal re_v, HexaVal im_v,\n"
    buf = buf + "                                    HexaVal flip_v, HexaVal zmask_v,\n"
    buf = buf + "                                    HexaVal ymask_v, HexaVal cy_v,\n"
    buf = buf + "                                    HexaVal nq_v) {\n"
    buf = buf + "    int64_t re_id = hexa_as_num(re_v);\n"
    buf = buf + "    int64_t im_id = hexa_as_num(im_v);\n"
    buf = buf + "    if (re_id < 0 || re_id >= _hx_farr_count) return hexa_float(0.0);\n"
    buf = buf + "    if (im_id < 0 || im_id >= _hx_farr_count) return hexa_float(0.0);\n"
    buf = buf + "    double* re = _hx_farr_table[re_id].buf;\n"
    buf = buf + "    double* im = _hx_farr_table[im_id].buf;\n"
    buf = buf + "    if (!re || !im) return hexa_float(0.0);\n"
    buf = buf + "    int64_t flip_mask = hexa_as_num(flip_v);\n"
    buf = buf + "    int64_t z_mask    = hexa_as_num(zmask_v);\n"
    buf = buf + "    int64_t y_mask    = hexa_as_num(ymask_v);\n"
    buf = buf + "    int64_t count_Y   = hexa_as_num(cy_v);\n"
    buf = buf + "    int64_t n_qubits  = hexa_as_num(nq_v);\n"
    buf = buf + "    return hexa_float(_hx_pauli_expectation_raw(re, im, flip_mask, z_mask,\n"
    buf = buf + "                                                y_mask, count_Y, n_qubits));\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ───────────────────────────────────────────────────────────────────────\n"
    buf = buf + "// RFC 037 (2026-05-13): whole-Hamiltonian Pauli-expectation batch kernel.\n"
    buf = buf + "//\n"
    buf = buf + "// Computes <psi|P_k|psi> for k = 0 .. n_terms-1 in a single C call,\n"
    buf = buf + "// where each P_k is described by a (flip, z, y, count_Y) tuple read\n"
    buf = buf + "// from four packed-int64 farr_int handles (RFC 036). The N real\n"
    buf = buf + "// expectation values are written into the packed-double farr handle\n"
    buf = buf + "// out_h. Semantics are byte-identical to N invocations of\n"
    buf = buf + "// hexa_farr_pauli_expectation — same math kernel, same summation order.\n"
    buf = buf + "//\n"
    buf = buf + "// Replaces the per-iter hexa-side `while k < n_ham: farr_pauli_expectation(\n"
    buf = buf + "// re_h, im_h, flip_arr[k], z_arr[k], y_arr[k], cy_arr[k], nq)` loop in\n"
    buf = buf + "// qmirror chemistry_vqe energy fns. At 4e/5o (n_ham = 876) this kernel\n"
    buf = buf + "// avoids ~876 box/unbox round-trips per NM iter, yielding 3-5x wall.\n"
    buf = buf + "//\n"
    buf = buf + "// Returns hexa_int(0) on success, hexa_int(-1) on any handle / length\n"
    buf = buf + "// validation failure (silent — no print, no exit).\n"
    buf = buf + "// ───────────────────────────────────────────────────────────────────────\n"
    buf = buf + "HexaVal hexa_farr_pauli_expectation_batch(HexaVal re_v, HexaVal im_v,\n"
    buf = buf + "                                          HexaVal flip_h_v, HexaVal z_h_v,\n"
    buf = buf + "                                          HexaVal y_h_v, HexaVal cy_h_v,\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "                                          HexaVal n_terms_v, HexaVal out_h_v,\n"
    buf = buf + "                                          HexaVal nq_v) {\n"
    buf = buf + "    int64_t re_id   = hexa_as_num(re_v);\n"
    buf = buf + "    int64_t im_id   = hexa_as_num(im_v);\n"
    buf = buf + "    int64_t flip_id = hexa_as_num(flip_h_v);\n"
    buf = buf + "    int64_t z_id    = hexa_as_num(z_h_v);\n"
    buf = buf + "    int64_t y_id    = hexa_as_num(y_h_v);\n"
    buf = buf + "    int64_t cy_id   = hexa_as_num(cy_h_v);\n"
    buf = buf + "    int64_t out_id  = hexa_as_num(out_h_v);\n"
    buf = buf + "    int64_t n_terms = hexa_as_num(n_terms_v);\n"
    buf = buf + "    int64_t n_q     = hexa_as_num(nq_v);\n"
    buf = buf + "    // Validate state-vector farr handles.\n"
    buf = buf + "    if (re_id  < 0 || re_id  >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (im_id  < 0 || im_id  >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (out_id < 0 || out_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    // Validate Pauli-descriptor farr_int handles.\n"
    buf = buf + "    if (flip_id < 0 || flip_id >= _hx_iarr_count) return hexa_int(-1);\n"
    buf = buf + "    if (z_id    < 0 || z_id    >= _hx_iarr_count) return hexa_int(-1);\n"
    buf = buf + "    if (y_id    < 0 || y_id    >= _hx_iarr_count) return hexa_int(-1);\n"
    buf = buf + "    if (cy_id   < 0 || cy_id   >= _hx_iarr_count) return hexa_int(-1);\n"
    buf = buf + "    const double*  re   = _hx_farr_table[re_id].buf;\n"
    buf = buf + "    const double*  im   = _hx_farr_table[im_id].buf;\n"
    buf = buf + "    double*        out  = _hx_farr_table[out_id].buf;\n"
    buf = buf + "    const int64_t* flip = _hx_iarr_table[flip_id].buf;\n"
    buf = buf + "    const int64_t* zm   = _hx_iarr_table[z_id].buf;\n"
    buf = buf + "    const int64_t* ym   = _hx_iarr_table[y_id].buf;\n"
    buf = buf + "    const int64_t* cym  = _hx_iarr_table[cy_id].buf;\n"
    buf = buf + "    if (!re || !im || !out || !flip || !zm || !ym || !cym) return hexa_int(-1);\n"
    buf = buf + "    if (n_terms < 0) return hexa_int(-1);\n"
    buf = buf + "    // Validate lengths — all four farr_int handles must hold >= n_terms,\n"
    buf = buf + "    // and out must hold >= n_terms doubles.\n"
    buf = buf + "    if (_hx_iarr_table[flip_id].len < n_terms) return hexa_int(-1);\n"
    buf = buf + "    if (_hx_iarr_table[z_id].len    < n_terms) return hexa_int(-1);\n"
    buf = buf + "    if (_hx_iarr_table[y_id].len    < n_terms) return hexa_int(-1);\n"
    buf = buf + "    if (_hx_iarr_table[cy_id].len   < n_terms) return hexa_int(-1);\n"
    buf = buf + "    if (_hx_farr_table[out_id].len  < n_terms) return hexa_int(-1);\n"
    buf = buf + "    // Pure-C inner loop over the per-term math kernel. No HexaVal\n"
    buf = buf + "    // traffic, no arena allocation. _hx_pauli_expectation_raw is the\n"
    buf = buf + "    // exact same body executed by hexa_farr_pauli_expectation above\n"
    buf = buf + "    // (carved out by RFC 039) so per-term results are byte-identical.\n"
    buf = buf + "    for (int64_t k = 0; k < n_terms; k++) {\n"
    buf = buf + "        out[k] = _hx_pauli_expectation_raw(re, im,\n"
    buf = buf + "                                           flip[k], zm[k], ym[k], cym[k],\n"
    buf = buf + "                                           n_q);\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int(0);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ───────────────────────────────────────────────────────────────────────\n"
    buf = buf + "// RFC 035 (2026-05-13): Nelder-Mead step kernels for arbitrary-maxiter\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// in-process NM. RFC 034 fixed the Pauli-loop arena pressure; the NM-side\n"
    buf = buf + "// vector operations (centroid, reflect, contract, expand, shrink, sort)\n"
    buf = buf + "// still box a HexaVal per farr scalar access (~1.5 KB per get/set), so\n"
    buf = buf + "// 26-dim NM at maxiter > ~250 hits the 768 MB cap. These kernels run the\n"
    buf = buf + "// whole NM step in C with raw double arithmetic.\n"
    buf = buf + "//\n"
    buf = buf + "// Convention: simplex stored as a single farr handle of length n_vert*n\n"
    buf = buf + "// doubles (vertex v occupies indices v*n .. (v+1)*n - 1). f stored as a\n"
    buf = buf + "// farr handle of length n_vert.\n"
    buf = buf + "\n"
    buf = buf + "// out = centroid of the FIRST n_best vertices (exclude the rest).\n"
    buf = buf + "// For NM the caller sorts so the worst vertex is at index n_vert-1 and\n"
    buf = buf + "// passes n_best = n_vert-1.\n"
    buf = buf + "HexaVal hexa_farr_simplex_centroid(HexaVal simplex_h_v, HexaVal out_h_v,\n"
    buf = buf + "                                   HexaVal n_v, HexaVal n_best_v) {\n"
    buf = buf + "    int64_t sx = hexa_as_num(simplex_h_v);\n"
    buf = buf + "    int64_t ot = hexa_as_num(out_h_v);\n"
    buf = buf + "    int64_t n  = hexa_as_num(n_v);\n"
    buf = buf + "    int64_t nb = hexa_as_num(n_best_v);\n"
    buf = buf + "    if (sx < 0 || sx >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (ot < 0 || ot >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    double* sp = _hx_farr_table[sx].buf;\n"
    buf = buf + "    double* op = _hx_farr_table[ot].buf;\n"
    buf = buf + "    if (!sp || !op) return hexa_int(-1);\n"
    buf = buf + "    if (nb <= 0) return hexa_int(-1);\n"
    buf = buf + "    double inv = 1.0 / (double)nb;\n"
    buf = buf + "    for (int64_t j = 0; j < n; j++) {\n"
    buf = buf + "        double acc = 0.0;\n"
    buf = buf + "        for (int64_t v = 0; v < nb; v++) {\n"
    buf = buf + "            acc += sp[v * n + j];\n"
    buf = buf + "        }\n"
    buf = buf + "        op[j] = acc * inv;\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int(0);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// out = a + scale*(a - b)   (reflection: scale=1; expansion: scale=2)\n"
    buf = buf + "HexaVal hexa_farr_vec_reflect(HexaVal out_h_v, HexaVal a_h_v, HexaVal b_h_v,\n"
    buf = buf + "                              HexaVal scale_v, HexaVal n_v) {\n"
    buf = buf + "    int64_t ot = hexa_as_num(out_h_v);\n"
    buf = buf + "    int64_t ah = hexa_as_num(a_h_v);\n"
    buf = buf + "    int64_t bh = hexa_as_num(b_h_v);\n"
    buf = buf + "    if (ot < 0 || ot >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (ah < 0 || ah >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (bh < 0 || bh >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    double* op = _hx_farr_table[ot].buf;\n"
    buf = buf + "    double* ap = _hx_farr_table[ah].buf;\n"
    buf = buf + "    double* bp = _hx_farr_table[bh].buf;\n"
    buf = buf + "    if (!op || !ap || !bp) return hexa_int(-1);\n"
    buf = buf + "    double scale = __hx_to_double(scale_v);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    int64_t n = hexa_as_num(n_v);\n"
    buf = buf + "    for (int64_t j = 0; j < n; j++) {\n"
    buf = buf + "        op[j] = ap[j] + scale * (ap[j] - bp[j]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int(0);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// out = a + scale*(b - a)   (blend: contraction=0.5; shrink-step=0.5)\n"
    buf = buf + "HexaVal hexa_farr_vec_blend(HexaVal out_h_v, HexaVal a_h_v, HexaVal b_h_v,\n"
    buf = buf + "                            HexaVal scale_v, HexaVal n_v) {\n"
    buf = buf + "    int64_t ot = hexa_as_num(out_h_v);\n"
    buf = buf + "    int64_t ah = hexa_as_num(a_h_v);\n"
    buf = buf + "    int64_t bh = hexa_as_num(b_h_v);\n"
    buf = buf + "    if (ot < 0 || ot >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (ah < 0 || ah >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (bh < 0 || bh >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    double* op = _hx_farr_table[ot].buf;\n"
    buf = buf + "    double* ap = _hx_farr_table[ah].buf;\n"
    buf = buf + "    double* bp = _hx_farr_table[bh].buf;\n"
    buf = buf + "    if (!op || !ap || !bp) return hexa_int(-1);\n"
    buf = buf + "    double scale = __hx_to_double(scale_v);\n"
    buf = buf + "    int64_t n = hexa_as_num(n_v);\n"
    buf = buf + "    for (int64_t j = 0; j < n; j++) {\n"
    buf = buf + "        op[j] = ap[j] + scale * (bp[j] - ap[j]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int(0);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Copy vertex src_v of src_simplex into vertex dst_v of dst_simplex.\n"
    buf = buf + "HexaVal hexa_farr_vertex_copy(HexaVal dst_h_v, HexaVal dst_v_v,\n"
    buf = buf + "                              HexaVal src_h_v, HexaVal src_v_v,\n"
    buf = buf + "                              HexaVal n_v) {\n"
    buf = buf + "    int64_t dh = hexa_as_num(dst_h_v);\n"
    buf = buf + "    int64_t sh = hexa_as_num(src_h_v);\n"
    buf = buf + "    if (dh < 0 || dh >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (sh < 0 || sh >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    double* dp = _hx_farr_table[dh].buf;\n"
    buf = buf + "    double* sp = _hx_farr_table[sh].buf;\n"
    buf = buf + "    if (!dp || !sp) return hexa_int(-1);\n"
    buf = buf + "    int64_t dv = hexa_as_num(dst_v_v);\n"
    buf = buf + "    int64_t sv = hexa_as_num(src_v_v);\n"
    buf = buf + "    int64_t n  = hexa_as_num(n_v);\n"
    buf = buf + "    for (int64_t j = 0; j < n; j++) {\n"
    buf = buf + "        dp[dv * n + j] = sp[sv * n + j];\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int(0);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Read one entry of a farr buffer interpreted as a (v, j) into a simplex\n"
    buf = buf + "// of stride n. Returns the value as a raw double (HexaVal float).\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "HexaVal hexa_farr_simplex_get(HexaVal simplex_h_v, HexaVal v_v, HexaVal j_v,\n"
    buf = buf + "                              HexaVal n_v) {\n"
    buf = buf + "    int64_t sx = hexa_as_num(simplex_h_v);\n"
    buf = buf + "    if (sx < 0 || sx >= _hx_farr_count) return hexa_float(0.0);\n"
    buf = buf + "    double* sp = _hx_farr_table[sx].buf;\n"
    buf = buf + "    if (!sp) return hexa_float(0.0);\n"
    buf = buf + "    int64_t v = hexa_as_num(v_v);\n"
    buf = buf + "    int64_t j = hexa_as_num(j_v);\n"
    buf = buf + "    int64_t n = hexa_as_num(n_v);\n"
    buf = buf + "    return hexa_float(sp[v * n + j]);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_farr_simplex_set(HexaVal simplex_h_v, HexaVal v_v, HexaVal j_v,\n"
    buf = buf + "                              HexaVal n_v, HexaVal x_v) {\n"
    buf = buf + "    int64_t sx = hexa_as_num(simplex_h_v);\n"
    buf = buf + "    if (sx < 0 || sx >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    double* sp = _hx_farr_table[sx].buf;\n"
    buf = buf + "    if (!sp) return hexa_int(-1);\n"
    buf = buf + "    int64_t v = hexa_as_num(v_v);\n"
    buf = buf + "    int64_t j = hexa_as_num(j_v);\n"
    buf = buf + "    int64_t n = hexa_as_num(n_v);\n"
    buf = buf + "    sp[v * n + j] = __hx_to_double(x_v);\n"
    buf = buf + "    return hexa_int(0);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Shrink simplex toward vertex 0 (the best): for v = 1..n_vert-1,\n"
    buf = buf + "//   simplex[v][j] = simplex[0][j] + 0.5 * (simplex[v][j] - simplex[0][j])\n"
    buf = buf + "// Caller is responsible for re-evaluating f for the shrunk vertices.\n"
    buf = buf + "HexaVal hexa_farr_simplex_shrink(HexaVal simplex_h_v, HexaVal n_v,\n"
    buf = buf + "                                 HexaVal n_vert_v) {\n"
    buf = buf + "    int64_t sx = hexa_as_num(simplex_h_v);\n"
    buf = buf + "    if (sx < 0 || sx >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    double* sp = _hx_farr_table[sx].buf;\n"
    buf = buf + "    if (!sp) return hexa_int(-1);\n"
    buf = buf + "    int64_t n = hexa_as_num(n_v);\n"
    buf = buf + "    int64_t nv = hexa_as_num(n_vert_v);\n"
    buf = buf + "    double* best = sp;  // vertex 0\n"
    buf = buf + "    for (int64_t v = 1; v < nv; v++) {\n"
    buf = buf + "        double* row = sp + v * n;\n"
    buf = buf + "        for (int64_t j = 0; j < n; j++) {\n"
    buf = buf + "            row[j] = best[j] + 0.5 * (row[j] - best[j]);\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int(0);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Insertion-sort the simplex by f (ascending). Both simplex and f are\n"
    buf = buf + "// reordered in place; uses a single scratch row internally.\n"
    buf = buf + "HexaVal hexa_farr_simplex_sort(HexaVal simplex_h_v, HexaVal f_h_v,\n"
    buf = buf + "                               HexaVal n_v, HexaVal n_vert_v) {\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    int64_t sx = hexa_as_num(simplex_h_v);\n"
    buf = buf + "    int64_t fh = hexa_as_num(f_h_v);\n"
    buf = buf + "    if (sx < 0 || sx >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (fh < 0 || fh >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    double* sp = _hx_farr_table[sx].buf;\n"
    buf = buf + "    double* fp = _hx_farr_table[fh].buf;\n"
    buf = buf + "    if (!sp || !fp) return hexa_int(-1);\n"
    buf = buf + "    int64_t n = hexa_as_num(n_v);\n"
    buf = buf + "    int64_t nv = hexa_as_num(n_vert_v);\n"
    buf = buf + "    // Heap-allocate the scratch (n can be up to ~50 in practice).\n"
    buf = buf + "    double* scratch = (double*)malloc((size_t)n * sizeof(double));\n"
    buf = buf + "    if (!scratch) return hexa_int(-1);\n"
    buf = buf + "    for (int64_t i = 1; i < nv; i++) {\n"
    buf = buf + "        double key_f = fp[i];\n"
    buf = buf + "        for (int64_t j = 0; j < n; j++) scratch[j] = sp[i * n + j];\n"
    buf = buf + "        int64_t k = i - 1;\n"
    buf = buf + "        while (k >= 0 && fp[k] > key_f) {\n"
    buf = buf + "            fp[k + 1] = fp[k];\n"
    buf = buf + "            for (int64_t j = 0; j < n; j++) sp[(k + 1) * n + j] = sp[k * n + j];\n"
    buf = buf + "            k = k - 1;\n"
    buf = buf + "        }\n"
    buf = buf + "        fp[k + 1] = key_f;\n"
    buf = buf + "        for (int64_t j = 0; j < n; j++) sp[(k + 1) * n + j] = scratch[j];\n"
    buf = buf + "    }\n"
    buf = buf + "    free(scratch);\n"
    buf = buf + "    return hexa_int(0);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ───────────────────────────────────────────────────────────────────────\n"
    buf = buf + "// RFC 039 (2026-05-13): parameter-shift gradient kernel.\n"
    buf = buf + "//\n"
    buf = buf + "// Replaces the pure-hexa loop `for k in 0..n_params: grad[k] =\n"
    buf = buf + "// 0.5*(energy(theta+pi/2*e_k) - energy(theta-pi/2*e_k))` with a single\n"
    buf = buf + "// C call. The two boxed-handle bundles (HexaHamEntry / HexaAnsatzEntry)\n"
    buf = buf + "// pre-pack the per-cache constants once; the gradient call reuses them.\n"
    buf = buf + "//\n"
    buf = buf + "// See docs/RFC_039_param_shift_grad.md (qmirror repo) for full design.\n"
    buf = buf + "// ───────────────────────────────────────────────────────────────────────\n"
    buf = buf + "\n"
    buf = buf + "typedef struct {\n"
    buf = buf + "    int64_t  n_terms;\n"
    buf = buf + "    int64_t  n_qubits;\n"
    buf = buf + "    int64_t* flip;       // [n_terms]\n"
    buf = buf + "    int64_t* z_mask;     // [n_terms]\n"
    buf = buf + "    int64_t* y_mask;     // [n_terms]\n"
    buf = buf + "    int64_t* count_Y;    // [n_terms]\n"
    buf = buf + "    double*  coef;       // [n_terms]\n"
    buf = buf + "    double   shift;\n"
    buf = buf + "} HexaHamEntry;\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "typedef struct {\n"
    buf = buf + "    int64_t  n_qubits;\n"
    buf = buf + "    int64_t  hf_index;\n"
    buf = buf + "    int64_t  n_flat;\n"
    buf = buf + "    int64_t* param_idx;\n"
    buf = buf + "    double*  coef;\n"
    buf = buf + "    int64_t* flip;\n"
    buf = buf + "    int64_t* z_mask;\n"
    buf = buf + "    int64_t* y_mask;\n"
    buf = buf + "    int64_t* count_Y;\n"
    buf = buf + "} HexaAnsatzEntry;\n"
    buf = buf + "\n"
    buf = buf + "static HexaHamEntry*    _hx_ham_table    = NULL;\n"
    buf = buf + "static int64_t          _hx_ham_count    = 0;\n"
    buf = buf + "static int64_t          _hx_ham_cap      = 0;\n"
    buf = buf + "static HexaAnsatzEntry* _hx_ans_table    = NULL;\n"
    buf = buf + "static int64_t          _hx_ans_count    = 0;\n"
    buf = buf + "static int64_t          _hx_ans_cap      = 0;\n"
    buf = buf + "\n"
    buf = buf + "// Read an int from a hexa array-of-int handle (we accept either farr-of-\n"
    buf = buf + "// double cast-to-int or the existing native [int] via the standard\n"
    buf = buf + "// array-element accessor). For Phase A we require farr-of-double\n"
    buf = buf + "// representation: `cache[\"ham_flip\"]` etc are already `[int]` in the\n"
    buf = buf + "// hexa code, so the hexa caller routes them through `farr_int_array`\n"
    buf = buf + "// (proposed RFC 036, sibling) or a one-time pack loop here.\n"
    buf = buf + "//\n"
    buf = buf + "// To keep this kernel self-contained: ham_pack / ansatz_pack accept the\n"
    buf = buf + "// existing `[int]` arrays directly via hexa array-element introspection\n"
    buf = buf + "// helpers `hexa_len(v)` / `hexa_arr_get_int(v, i)` (assumed present\n"
    buf = buf + "// in runtime.c — they are the same helpers used by hexa_call shims to\n"
    buf = buf + "// unpack [int] args today).\n"
    buf = buf + "\n"
    buf = buf + "static int64_t _hx_ham_alloc_slot(void) {\n"
    buf = buf + "    if (_hx_ham_count >= _hx_ham_cap) {\n"
    buf = buf + "        int64_t nc = _hx_ham_cap < 8 ? 8 : _hx_ham_cap * 2;\n"
    buf = buf + "        HexaHamEntry* nt = (HexaHamEntry*)realloc(_hx_ham_table,\n"
    buf = buf + "                                  (size_t)nc * sizeof(HexaHamEntry));\n"
    buf = buf + "        if (!nt) return -1;\n"
    buf = buf + "        _hx_ham_table = nt;\n"
    buf = buf + "        _hx_ham_cap = nc;\n"
    buf = buf + "    }\n"
    buf = buf + "    return _hx_ham_count++;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "static int64_t _hx_ans_alloc_slot(void) {\n"
    buf = buf + "    if (_hx_ans_count >= _hx_ans_cap) {\n"
    buf = buf + "        int64_t nc = _hx_ans_cap < 8 ? 8 : _hx_ans_cap * 2;\n"
    buf = buf + "        HexaAnsatzEntry* nt = (HexaAnsatzEntry*)realloc(_hx_ans_table,\n"
    buf = buf + "                                  (size_t)nc * sizeof(HexaAnsatzEntry));\n"
    buf = buf + "        if (!nt) return -1;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        _hx_ans_table = nt;\n"
    buf = buf + "        _hx_ans_cap = nc;\n"
    buf = buf + "    }\n"
    buf = buf + "    return _hx_ans_count++;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ham_pack(flip[], z[], y[], cy[], coef[], shift, n_q) -> int handle.\n"
    buf = buf + "// Unwrap interp-side VALSTRUCT-wrapped TAG_ARRAY → raw TAG_ARRAY HexaVal.\n"
    buf = buf + "// Under `hexa.real run`, hexa-side `[int]`/`[float]` literals reach C kernels\n"
    buf = buf + "// wrapped as TAG_VALSTRUCT whose tag_i == TAG_ARRAY (5) and int_val == index\n"
    buf = buf + "// into the global array_store. Mirrors the unwrap in fill_from_array (~7870)\n"
    buf = buf + "// and hexa_val_heapify (~3530). Follow-up to commit b8acb90f to fix\n"
    buf = buf + "// ham_pack/ansatz_pack returning -1 on VALSTRUCT-wrapped inputs.\n"
    buf = buf + "static inline HexaVal _hx_unwrap_array(HexaVal v) {\n"
    buf = buf + "    if (HX_IS_VALSTRUCT(v) && HX_VS(v)\n"
    buf = buf + "        && HX_VSF(v, tag_i) == HEXA_INTERP_TAG_ARRAY\n"
    buf = buf + "        && &array_store != 0\n"
    buf = buf + "        && HX_IS_ARRAY(array_store) && HX_ARR_ITEMS(array_store)) {\n"
    buf = buf + "        int64_t idx = HX_VSF(v, int_val);\n"
    buf = buf + "        if (idx >= 0 && idx < (int64_t)HX_ARR_LEN(array_store)) {\n"
    buf = buf + "            return HX_ARR_ITEMS(array_store)[idx];\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return v;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_ham_pack(HexaVal flip_v, HexaVal z_v, HexaVal y_v,\n"
    buf = buf + "                      HexaVal cy_v, HexaVal coef_v,\n"
    buf = buf + "                      HexaVal shift_v, HexaVal nq_v) {\n"
    buf = buf + "    flip_v = _hx_unwrap_array(flip_v);\n"
    buf = buf + "    z_v    = _hx_unwrap_array(z_v);\n"
    buf = buf + "    y_v    = _hx_unwrap_array(y_v);\n"
    buf = buf + "    cy_v   = _hx_unwrap_array(cy_v);\n"
    buf = buf + "    coef_v = _hx_unwrap_array(coef_v);\n"
    buf = buf + "    int64_t n = hexa_len(flip_v);\n"
    buf = buf + "    if (n <= 0 || hexa_len(z_v) != n || hexa_len(y_v) != n\n"
    buf = buf + "        || hexa_len(cy_v) != n || hexa_len(coef_v) != n)\n"
    buf = buf + "        return hexa_int(-1);\n"
    buf = buf + "    int64_t id = _hx_ham_alloc_slot();\n"
    buf = buf + "    if (id < 0) return hexa_int(-1);\n"
    buf = buf + "    HexaHamEntry* e = &_hx_ham_table[id];\n"
    buf = buf + "    e->n_terms = n;\n"
    buf = buf + "    e->n_qubits = hexa_as_num(nq_v);\n"
    buf = buf + "    e->shift = __hx_to_double(shift_v);\n"
    buf = buf + "    e->flip    = (int64_t*)malloc((size_t)n * sizeof(int64_t));\n"
    buf = buf + "    e->z_mask  = (int64_t*)malloc((size_t)n * sizeof(int64_t));\n"
    buf = buf + "    e->y_mask  = (int64_t*)malloc((size_t)n * sizeof(int64_t));\n"
    buf = buf + "    e->count_Y = (int64_t*)malloc((size_t)n * sizeof(int64_t));\n"
    buf = buf + "    e->coef    = (double*) malloc((size_t)n * sizeof(double));\n"
    buf = buf + "    if (!e->flip || !e->z_mask || !e->y_mask || !e->count_Y || !e->coef)\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        return hexa_int(-1);\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        e->flip[i]    = hexa_as_num(hexa_array_get(flip_v, i));\n"
    buf = buf + "        e->z_mask[i]  = hexa_as_num(hexa_array_get(z_v,    i));\n"
    buf = buf + "        e->y_mask[i]  = hexa_as_num(hexa_array_get(y_v,    i));\n"
    buf = buf + "        e->count_Y[i] = hexa_as_num(hexa_array_get(cy_v,   i));\n"
    buf = buf + "        e->coef[i]    = __hx_to_double(hexa_array_get(coef_v, i));\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int(id);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_ham_free(HexaVal h_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_ham_count) return hexa_int(-1);\n"
    buf = buf + "    HexaHamEntry* e = &_hx_ham_table[id];\n"
    buf = buf + "    free(e->flip);    e->flip = NULL;\n"
    buf = buf + "    free(e->z_mask);  e->z_mask = NULL;\n"
    buf = buf + "    free(e->y_mask);  e->y_mask = NULL;\n"
    buf = buf + "    free(e->count_Y); e->count_Y = NULL;\n"
    buf = buf + "    free(e->coef);    e->coef = NULL;\n"
    buf = buf + "    e->n_terms = 0;\n"
    buf = buf + "    return hexa_int(0);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ansatz_pack(param_idx[], coef[], flip[], z[], y[], cy[], hf_idx, n_q) -> int handle.\n"
    buf = buf + "HexaVal hexa_ansatz_pack(HexaVal pi_v, HexaVal coef_v, HexaVal flip_v,\n"
    buf = buf + "                         HexaVal z_v, HexaVal y_v, HexaVal cy_v,\n"
    buf = buf + "                         HexaVal hf_v, HexaVal nq_v) {\n"
    buf = buf + "    pi_v   = _hx_unwrap_array(pi_v);\n"
    buf = buf + "    coef_v = _hx_unwrap_array(coef_v);\n"
    buf = buf + "    flip_v = _hx_unwrap_array(flip_v);\n"
    buf = buf + "    z_v    = _hx_unwrap_array(z_v);\n"
    buf = buf + "    y_v    = _hx_unwrap_array(y_v);\n"
    buf = buf + "    cy_v   = _hx_unwrap_array(cy_v);\n"
    buf = buf + "    int64_t n = hexa_len(pi_v);\n"
    buf = buf + "    if (n <= 0 || hexa_len(coef_v) != n || hexa_len(flip_v) != n\n"
    buf = buf + "        || hexa_len(z_v) != n || hexa_len(y_v) != n\n"
    buf = buf + "        || hexa_len(cy_v) != n) return hexa_int(-1);\n"
    buf = buf + "    int64_t id = _hx_ans_alloc_slot();\n"
    buf = buf + "    if (id < 0) return hexa_int(-1);\n"
    buf = buf + "    HexaAnsatzEntry* e = &_hx_ans_table[id];\n"
    buf = buf + "    e->n_qubits = hexa_as_num(nq_v);\n"
    buf = buf + "    e->hf_index = hexa_as_num(hf_v);\n"
    buf = buf + "    e->n_flat   = n;\n"
    buf = buf + "    e->param_idx = (int64_t*)malloc((size_t)n * sizeof(int64_t));\n"
    buf = buf + "    e->coef      = (double*) malloc((size_t)n * sizeof(double));\n"
    buf = buf + "    e->flip      = (int64_t*)malloc((size_t)n * sizeof(int64_t));\n"
    buf = buf + "    e->z_mask    = (int64_t*)malloc((size_t)n * sizeof(int64_t));\n"
    buf = buf + "    e->y_mask    = (int64_t*)malloc((size_t)n * sizeof(int64_t));\n"
    buf = buf + "    e->count_Y   = (int64_t*)malloc((size_t)n * sizeof(int64_t));\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    if (!e->param_idx || !e->coef || !e->flip || !e->z_mask\n"
    buf = buf + "        || !e->y_mask || !e->count_Y) return hexa_int(-1);\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        e->param_idx[i] = hexa_as_num(hexa_array_get(pi_v,   i));\n"
    buf = buf + "        e->coef[i]      = __hx_to_double(hexa_array_get(coef_v, i));\n"
    buf = buf + "        e->flip[i]      = hexa_as_num(hexa_array_get(flip_v, i));\n"
    buf = buf + "        e->z_mask[i]    = hexa_as_num(hexa_array_get(z_v,    i));\n"
    buf = buf + "        e->y_mask[i]    = hexa_as_num(hexa_array_get(y_v,    i));\n"
    buf = buf + "        e->count_Y[i]   = hexa_as_num(hexa_array_get(cy_v,   i));\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int(id);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_ansatz_free(HexaVal h_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_ans_count) return hexa_int(-1);\n"
    buf = buf + "    HexaAnsatzEntry* e = &_hx_ans_table[id];\n"
    buf = buf + "    free(e->param_idx); e->param_idx = NULL;\n"
    buf = buf + "    free(e->coef);      e->coef = NULL;\n"
    buf = buf + "    free(e->flip);      e->flip = NULL;\n"
    buf = buf + "    free(e->z_mask);    e->z_mask = NULL;\n"
    buf = buf + "    free(e->y_mask);    e->y_mask = NULL;\n"
    buf = buf + "    free(e->count_Y);   e->count_Y = NULL;\n"
    buf = buf + "    e->n_flat = 0;\n"
    buf = buf + "    return hexa_int(0);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Internal helper: reset state to |HF>, apply ansatz at the given theta\n"
    buf = buf + "// array, return <psi|H|psi> + shift.\n"
    buf = buf + "static double _rfc039_energy(double* re, double* im, int64_t dim,\n"
    buf = buf + "                             const double* theta,\n"
    buf = buf + "                             const HexaAnsatzEntry* ans,\n"
    buf = buf + "                             const HexaHamEntry* ham) {\n"
    buf = buf + "    // Reset to |HF>.\n"
    buf = buf + "    for (int64_t k = 0; k < dim; k++) { re[k] = 0.0; im[k] = 0.0; }\n"
    buf = buf + "    re[ans->hf_index] = 1.0;\n"
    buf = buf + "    // Apply ansatz (replays farr_pauli_exp_inplace logic inline).\n"
    buf = buf + "    for (int64_t i = 0; i < ans->n_flat; i++) {\n"
    buf = buf + "        double alpha = theta[ans->param_idx[i]] * ans->coef[i];\n"
    buf = buf + "        double aa = alpha < 0.0 ? -alpha : alpha;\n"
    buf = buf + "        if (aa <= 1e-13) continue;\n"
    buf = buf + "        // Inline pauli_exp on (re, im) with masks from ans[i].\n"
    buf = buf + "        // (For brevity, this patch calls a small static helper that\n"
    buf = buf + "        //  duplicates the body of hexa_farr_pauli_exp_inplace minus the\n"
    buf = buf + "        //  HexaVal unwrap.)\n"
    buf = buf + "        _hx_pauli_exp_raw(re, im, alpha,\n"
    buf = buf + "                          ans->flip[i], ans->z_mask[i], ans->y_mask[i],\n"
    buf = buf + "                          ans->count_Y[i], ans->n_qubits);\n"
    buf = buf + "    }\n"
    buf = buf + "    // Hamiltonian contraction.\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    double e_op = 0.0;\n"
    buf = buf + "    for (int64_t j = 0; j < ham->n_terms; j++) {\n"
    buf = buf + "        double exp_j = _hx_pauli_expectation_raw(re, im,\n"
    buf = buf + "                          ham->flip[j], ham->z_mask[j], ham->y_mask[j],\n"
    buf = buf + "                          ham->count_Y[j], ham->n_qubits);\n"
    buf = buf + "        e_op += ham->coef[j] * exp_j;\n"
    buf = buf + "    }\n"
    buf = buf + "    return e_op + ham->shift;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// farr_parameter_shift_grad(re_h, im_h, theta_h, grad_h,\n"
    buf = buf + "//                           n_params, ham_h, ansatz_h, n_q) -> 0/-1.\n"
    buf = buf + "HexaVal hexa_farr_parameter_shift_grad(HexaVal re_v, HexaVal im_v,\n"
    buf = buf + "                                       HexaVal theta_v, HexaVal grad_v,\n"
    buf = buf + "                                       HexaVal n_p_v,\n"
    buf = buf + "                                       HexaVal ham_v, HexaVal ans_v,\n"
    buf = buf + "                                       HexaVal nq_v) {\n"
    buf = buf + "    int64_t re_id   = hexa_as_num(re_v);\n"
    buf = buf + "    int64_t im_id   = hexa_as_num(im_v);\n"
    buf = buf + "    int64_t th_id   = hexa_as_num(theta_v);\n"
    buf = buf + "    int64_t gr_id   = hexa_as_num(grad_v);\n"
    buf = buf + "    int64_t n_p     = hexa_as_num(n_p_v);\n"
    buf = buf + "    int64_t ham_id  = hexa_as_num(ham_v);\n"
    buf = buf + "    int64_t ans_id  = hexa_as_num(ans_v);\n"
    buf = buf + "    int64_t n_q     = hexa_as_num(nq_v);\n"
    buf = buf + "    if (re_id < 0 || re_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (im_id < 0 || im_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (th_id < 0 || th_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (gr_id < 0 || gr_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (ham_id < 0 || ham_id >= _hx_ham_count) return hexa_int(-1);\n"
    buf = buf + "    if (ans_id < 0 || ans_id >= _hx_ans_count) return hexa_int(-1);\n"
    buf = buf + "    double* re = _hx_farr_table[re_id].buf;\n"
    buf = buf + "    double* im = _hx_farr_table[im_id].buf;\n"
    buf = buf + "    double* th = _hx_farr_table[th_id].buf;\n"
    buf = buf + "    double* gr = _hx_farr_table[gr_id].buf;\n"
    buf = buf + "    if (!re || !im || !th || !gr) return hexa_int(-1);\n"
    buf = buf + "    HexaHamEntry*    ham = &_hx_ham_table[ham_id];\n"
    buf = buf + "    HexaAnsatzEntry* ans = &_hx_ans_table[ans_id];\n"
    buf = buf + "    int64_t dim = 1;\n"
    buf = buf + "    for (int64_t k = 0; k < n_q; k++) dim *= 2;\n"
    buf = buf + "    static const double HALF_PI = 1.57079632679489661923;\n"
    buf = buf + "    double saved_k;\n"
    buf = buf + "    for (int64_t k = 0; k < n_p; k++) {\n"
    buf = buf + "        saved_k = th[k];\n"
    buf = buf + "        th[k] = saved_k + HALF_PI;\n"
    buf = buf + "        double e_plus  = _rfc039_energy(re, im, dim, th, ans, ham);\n"
    buf = buf + "        th[k] = saved_k - HALF_PI;\n"
    buf = buf + "        double e_minus = _rfc039_energy(re, im, dim, th, ans, ham);\n"
    buf = buf + "        th[k] = saved_k;\n"
    buf = buf + "        gr[k] = 0.5 * (e_plus - e_minus);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int(0);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ───────────────────────────────────────────────────────────────────────\n"
    buf = buf + "// RFC 038 (2026-05-13): farr_uccsd_apply — single-call UCCSD ansatz replay.\n"
    buf = buf + "//\n"
    buf = buf + "// Replays the entire flat-Pauli generator decomposition of a UCCSD\n"
    buf = buf + "// ansatz in one C call, consuming the RFC 039 HexaAnsatzEntry bundle.\n"
    buf = buf + "// Replaces the hexa-side `for i in 0..n_flat: farr_pauli_exp_inplace(...)`\n"
    buf = buf + "// pattern in chemistry_vqe/module/chemistry_vqe_cmt_uccsd_*.hexa —\n"
    buf = buf + "// removes the 8-HexaVal-per-iteration boxing tax and per-iter interp\n"
    buf = buf + "// dispatch.\n"
    buf = buf + "//\n"
    buf = buf + "// Math is byte-identical to the existing hexa-side loop because both\n"
    buf = buf + "// paths share `_hx_pauli_exp_raw` (RFC 039 raw helper). Per-amplitude\n"
    buf = buf + "// equivalence within 1e-13 is the smoke acceptance bar.\n"
    buf = buf + "//\n"
    buf = buf + "// Convention: CALLER resets re/im to |HF> before the call (see RFC 038\n"
    buf = buf + "// §4 for rationale — composability with downstream chained kernels).\n"
    buf = buf + "// The kernel never touches re/im outside of the ansatz-replay loop.\n"
    buf = buf + "//\n"
    buf = buf + "// See docs/RFC_038_farr_uccsd_apply.md (qmirror repo) for full design.\n"
    buf = buf + "// ───────────────────────────────────────────────────────────────────────\n"
    buf = buf + "\n"
    buf = buf + "// Private shared helper: apply the UCCSD ansatz flat-Pauli rotations\n"
    buf = buf + "// in-place on (re, im) using the packed ansatz descriptor. NO state\n"
    buf = buf + "// reset — caller controls the starting state. NO Hamiltonian contraction\n"
    buf = buf + "// (that's RFC 037's batch expectation kernel).\n"
    buf = buf + "//\n"
    buf = buf + "// This is the exact ansatz-replay leg of _rfc039_energy hoisted into a\n"
    buf = buf + "// standalone helper so RFC 038's public kernel and RFC 039's internal\n"
    buf = buf + "// energy routine can share one source of truth (cf. RFC 038 §9).\n"
    buf = buf + "static void _rfc038_apply_ansatz_raw(double* re, double* im,\n"
    buf = buf + "                                     const double* theta,\n"
    buf = buf + "                                     const HexaAnsatzEntry* ans) {\n"
    buf = buf + "    for (int64_t i = 0; i < ans->n_flat; i++) {\n"
    buf = buf + "        double alpha = theta[ans->param_idx[i]] * ans->coef[i];\n"
    buf = buf + "        double aa = alpha < 0.0 ? -alpha : alpha;\n"
    buf = buf + "        if (aa <= 1e-13) continue;\n"
    buf = buf + "        _hx_pauli_exp_raw(re, im, alpha,\n"
    buf = buf + "                          ans->flip[i], ans->z_mask[i], ans->y_mask[i],\n"
    buf = buf + "                          ans->count_Y[i], ans->n_qubits);\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// farr_uccsd_apply(re_h, im_h, theta_h, ansatz_h, n_q) -> 0 (ok) / -1 (err).\n"
    buf = buf + "//\n"
    buf = buf + "// Caller-supplied re_h / im_h are length 2^n_q farr handles; the caller\n"
    buf = buf + "// has already set them to the desired starting state (|HF> for the\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// default chemistry-VQE path). theta_h is a length-N_params farr handle.\n"
    buf = buf + "// ansatz_h is the int handle returned by `ansatz_pack` (RFC 039).\n"
    buf = buf + "HexaVal hexa_farr_uccsd_apply(HexaVal re_v, HexaVal im_v,\n"
    buf = buf + "                              HexaVal theta_v, HexaVal ansatz_v,\n"
    buf = buf + "                              HexaVal nq_v) {\n"
    buf = buf + "    int64_t re_id  = hexa_as_num(re_v);\n"
    buf = buf + "    int64_t im_id  = hexa_as_num(im_v);\n"
    buf = buf + "    int64_t th_id  = hexa_as_num(theta_v);\n"
    buf = buf + "    int64_t ans_id = hexa_as_num(ansatz_v);\n"
    buf = buf + "    int64_t n_q    = hexa_as_num(nq_v);\n"
    buf = buf + "    if (re_id  < 0 || re_id  >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (im_id  < 0 || im_id  >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (th_id  < 0 || th_id  >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (ans_id < 0 || ans_id >= _hx_ans_count)  return hexa_int(-1);\n"
    buf = buf + "    double* re = _hx_farr_table[re_id].buf;\n"
    buf = buf + "    double* im = _hx_farr_table[im_id].buf;\n"
    buf = buf + "    double* th = _hx_farr_table[th_id].buf;\n"
    buf = buf + "    if (!re || !im || !th) return hexa_int(-1);\n"
    buf = buf + "    HexaAnsatzEntry* ans = &_hx_ans_table[ans_id];\n"
    buf = buf + "    // Sanity check: the caller-passed n_q must agree with the packed\n"
    buf = buf + "    // ansatz descriptor. If they disagree the masks will index past the\n"
    buf = buf + "    // intended qubit count and corrupt the state — fail-fast.\n"
    buf = buf + "    if (ans->n_qubits != n_q) return hexa_int(-1);\n"
    buf = buf + "    _rfc038_apply_ansatz_raw(re, im, th, ans);\n"
    buf = buf + "    return hexa_int(0);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "typedef struct {\n"
    buf = buf + "    void*  base;       // hxlcl_mmap() base ptr; NULL = closed slot\n"
    buf = buf + "    size_t len;        // mapped length (full file size for safetensors)\n"
    buf = buf + "    int    fd;         // backing file descriptor (kept for diagnostics)\n"
    buf = buf + "} HexaMmapEntry;\n"
    buf = buf + "\n"
    buf = buf + "static HexaMmapEntry* _hx_mmap_table     = NULL;\n"
    buf = buf + "static int64_t        _hx_mmap_count     = 0;\n"
    buf = buf + "static int64_t        _hx_mmap_capacity  = 0;\n"
    buf = buf + "static int64_t*       _hx_mmap_freelist  = NULL;\n"
    buf = buf + "static int64_t        _hx_mmap_freelist_n = 0;\n"
    buf = buf + "static int64_t        _hx_mmap_freelist_cap = 0;\n"
    buf = buf + "\n"
    buf = buf + "// Allocate a new mmap-table slot id (pop freelist or extend table).\n"
    buf = buf + "static int64_t _hx_mmap_alloc_slot(void) {\n"
    buf = buf + "    if (_hx_mmap_freelist_n > 0) {\n"
    buf = buf + "        return _hx_mmap_freelist[--_hx_mmap_freelist_n];\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_hx_mmap_count >= _hx_mmap_capacity) {\n"
    buf = buf + "        int64_t new_cap = _hx_mmap_capacity < 8 ? 8 : _hx_mmap_capacity * 2;\n"
    buf = buf + "        HexaMmapEntry* nt = (HexaMmapEntry*)realloc(_hx_mmap_table,\n"
    buf = buf + "                              (size_t)new_cap * sizeof(HexaMmapEntry));\n"
    buf = buf + "        if (!nt) return -1;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        _hx_mmap_table = nt;\n"
    buf = buf + "        _hx_mmap_capacity = new_cap;\n"
    buf = buf + "    }\n"
    buf = buf + "    return _hx_mmap_count++;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// safetensors_mmap_open(path) → int handle (-1 on error).\n"
    buf = buf + "// Opens the file read-only, mmap()s the entire size with MAP_PRIVATE,\n"
    buf = buf + "// and stores (base, len, fd) in the global table. The fd is kept open\n"
    buf = buf + "// to anchor the mapping; close happens in safetensors_mmap_close.\n"
    buf = buf + "HexaVal hexa_safetensors_mmap_open(HexaVal path_v) {\n"
    buf = buf + "    const char* path = hexa_to_cstring(path_v);\n"
    buf = buf + "    if (!path || !*path) return hexa_int(-1);\n"
    buf = buf + "    int fd = hxlcl_open_sys(path, O_RDONLY);\n"
    buf = buf + "    if (fd < 0) return hexa_int(-1);\n"
    buf = buf + "    struct stat st;\n"
    buf = buf + "    if (hxlcl_fstat(fd, &st) != 0) { hxlcl_close(fd); return hexa_int(-1); }\n"
    buf = buf + "    size_t len = (size_t)st.st_size;\n"
    buf = buf + "    if (len == 0) { hxlcl_close(fd); return hexa_int(-1); }\n"
    buf = buf + "    // Pre-mmap header validation could go here (read first 8 bytes\n"
    buf = buf + "    // for header_len, verify 8 + header_len <= len). Phase 1 skips:\n"
    buf = buf + "    // the hexa-side caller already parses + validates the header.\n"
    buf = buf + "    void* base = hxlcl_mmap(NULL, len, PROT_READ, MAP_PRIVATE, fd, 0);\n"
    buf = buf + "    if (base == MAP_FAILED) { hxlcl_close(fd); return hexa_int(-1); }\n"
    buf = buf + "    int64_t id = _hx_mmap_alloc_slot();\n"
    buf = buf + "    if (id < 0) { munmap(base, len); hxlcl_close(fd); return hexa_int(-1); }\n"
    buf = buf + "    _hx_mmap_table[id].base = base;\n"
    buf = buf + "    _hx_mmap_table[id].len  = len;\n"
    buf = buf + "    _hx_mmap_table[id].fd   = fd;\n"
    buf = buf + "    return hexa_int(id);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// safetensors_mmap_header(handle) → string (raw JSON header bytes).\n"
    buf = buf + "// Reads the 8-byte LE u64 header_len prefix at offset 0, then returns\n"
    buf = buf + "// the next header_len bytes as a hexa string (length-headered, NUL-safe\n"
    buf = buf + "// at storage layer though header JSON is ASCII). Empty string on\n"
    buf = buf + "// invalid handle or truncated file.\n"
    buf = buf + "HexaVal hexa_safetensors_mmap_header(HexaVal h_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_mmap_count) return hexa_str(\"\");\n"
    buf = buf + "    HexaMmapEntry* e = &_hx_mmap_table[id];\n"
    buf = buf + "    if (!e->base || e->len < 8) return hexa_str(\"\");\n"
    buf = buf + "    const unsigned char* p = (const unsigned char*)e->base;\n"
    buf = buf + "    uint64_t header_len = 0;\n"
    buf = buf + "    for (int i = 0; i < 8; i++) header_len |= ((uint64_t)p[i]) << (8 * i);\n"
    buf = buf + "    if (header_len == 0 || header_len > e->len - 8) return hexa_str(\"\");\n"
    buf = buf + "    char* buf = hexa_strbuf_alloc((size_t)header_len);\n"
    buf = buf + "    if (!buf) return hexa_str(\"\");\n"
    buf = buf + "    hxlcl_memcpy(buf, p + 8, (size_t)header_len);\n"
    buf = buf + "    return (HexaVal){.tag=TAG_STR, .s=buf};\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// safetensors_mmap_data_offset(handle) → int (= 8 + header_len).\n"
    buf = buf + "// Convenience: returns the byte offset where tensor data begins.\n"
    buf = buf + "HexaVal hexa_safetensors_mmap_data_offset(HexaVal h_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_mmap_count) return hexa_int(0);\n"
    buf = buf + "    HexaMmapEntry* e = &_hx_mmap_table[id];\n"
    buf = buf + "    if (!e->base || e->len < 8) return hexa_int(0);\n"
    buf = buf + "    const unsigned char* p = (const unsigned char*)e->base;\n"
    buf = buf + "    uint64_t header_len = 0;\n"
    buf = buf + "    for (int i = 0; i < 8; i++) header_len |= ((uint64_t)p[i]) << (8 * i);\n"
    buf = buf + "    return hexa_int((int64_t)(8 + header_len));\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// safetensors_mmap_size(handle) → int (full mapped file size in bytes).\n"
    buf = buf + "HexaVal hexa_safetensors_mmap_size(HexaVal h_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_mmap_count) return hexa_int(0);\n"
    buf = buf + "    HexaMmapEntry* e = &_hx_mmap_table[id];\n"
    buf = buf + "    return hexa_int((int64_t)e->len);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// safetensors_mmap_read_f32_farr(handle, byte_off, n_elem) → int farr_id.\n"
    buf = buf + "// Reads n_elem float32 values starting at byte_off, copies them into a\n"
    buf = buf + "// new farr packed buffer (one f32 → one double; n_elem * 8 B allocated).\n"
    buf = buf + "// Returns -1 on bounds error. The farr buffer is INDEPENDENT of the\n"
    buf = buf + "// mmap (so safetensors_mmap_close after this read is safe).\n"
    buf = buf + "HexaVal hexa_safetensors_mmap_read_f32_farr(HexaVal h_v, HexaVal off_v, HexaVal n_v) {\n"
    buf = buf + "    int64_t id   = hexa_as_num(h_v);\n"
    buf = buf + "    int64_t off  = hexa_as_num(off_v);\n"
    buf = buf + "    int64_t n    = hexa_as_num(n_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_mmap_count) return hexa_int(-1);\n"
    buf = buf + "    HexaMmapEntry* e = &_hx_mmap_table[id];\n"
    buf = buf + "    if (!e->base) return hexa_int(-1);\n"
    buf = buf + "    if (off < 0 || n < 0) return hexa_int(-1);\n"
    buf = buf + "    if ((size_t)off + (size_t)(n * 4) > e->len) return hexa_int(-1);\n"
    buf = buf + "    // Allocate a farr packed double[] buffer; copy f32 values from mmap.\n"
    buf = buf + "    HexaVal farr_handle = hexa_farr_zeros(hexa_int(n));\n"
    buf = buf + "    int64_t farr_id = HX_INT(farr_handle);\n"
    buf = buf + "    if (farr_id < 0 || farr_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    HexaFarrEntry* fe = &_hx_farr_table[farr_id];\n"
    buf = buf + "    if (!fe->buf || fe->len < n) return hexa_int(-1);\n"
    buf = buf + "    const float* src = (const float*)((const char*)e->base + off);\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        fe->buf[i] = (double)src[i];\n"
    buf = buf + "    }\n"
    buf = buf + "    return farr_handle;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// ── RFC 031 (2026-05-12) ────────────────────────────────────────────\n"
    buf = buf + "// safetensors_mmap_read_bf16_to_f32_farr(handle, byte_off, n_elem)\n"
    buf = buf + "//     → int farr_id (-1 on error).\n"
    buf = buf + "//\n"
    buf = buf + "// Reads n_elem BF16 (bfloat16) values starting at byte_off. Each\n"
    buf = buf + "// BF16 value is upcast to f32 by zero-extending its 16 bits into the\n"
    buf = buf + "// HIGH 16 bits of an IEEE-754 binary32 (the canonical bf16 → f32\n"
    buf = buf + "// widening: bf16 layout is identical to f32's sign + 8-bit exp +\n"
    buf = buf + "// top-7-bit mantissa, so `(uint32_t)u16 << 16` IS the f32 bit\n"
    buf = buf + "// pattern). The resulting f32 is then promoted to double and stored\n"
    buf = buf + "// in a new packed-double farr buffer (8 B/elem, parallel to RFC 025\n"
    buf = buf + "// _read_f32_farr).\n"
    buf = buf + "//\n"
    buf = buf + "// Why needed: real-world HuggingFace ckpts (anima Phase 1a1 included)\n"
    buf = buf + "// store weights as BF16, but _read_f32_farr only handles F32. Without\n"
    buf = buf + "// this builtin, callers either (a) emit a one-time F32 sidecar on the\n"
    buf = buf + "// PyTorch side (167 MB workaround used in Phase 5.1 — does not scale\n"
    buf = buf + "// to full 24-layer pure-hexa inference), or (b) write the bf16→f32\n"
    buf = buf + "// loop in hexa, paying ~88 B/elem interp arena pressure.\n"
    buf = buf + "//\n"
    buf = buf + "// IEEE-754 BF16:  s eeeeeeee mmmmmmm   (16 bits)\n"
    buf = buf + "// IEEE-754 F32:   s eeeeeeee mmmmmmm 0000000000000000  (32 bits)\n"
    buf = buf + "//                 ────── identical ────── + zero-pad\n"
    buf = buf + "//\n"
    buf = buf + "// Special values that this scheme preserves exactly:\n"
    buf = buf + "//   - 0x0000        →   0.0          (positive zero)\n"
    buf = buf + "//   - 0x8000        →   -0.0         (negative zero)\n"
    buf = buf + "//   - 0x3F80        →   1.0          (sign=0, exp=0x7F, mantissa=0)\n"
    buf = buf + "//   - 0xBF80        →   -1.0\n"
    buf = buf + "//   - 0x7F80        →   +Inf\n"
    buf = buf + "//   - 0xFF80        →   -Inf\n"
    buf = buf + "//   - 0x7FC0        →   NaN (quiet)\n"
    buf = buf + "//   - 0xFFC0        →   NaN\n"
    buf = buf + "//\n"
    buf = buf + "// Bounds: 2 B/elem so we check off + 2*n <= mmap_len.\n"
    buf = buf + "HexaVal hexa_safetensors_mmap_read_bf16_to_f32_farr(HexaVal h_v, HexaVal off_v, HexaVal n_v) {\n"
    buf = buf + "    int64_t id   = hexa_as_num(h_v);\n"
    buf = buf + "    int64_t off  = hexa_as_num(off_v);\n"
    buf = buf + "    int64_t n    = hexa_as_num(n_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_mmap_count) return hexa_int(-1);\n"
    buf = buf + "    HexaMmapEntry* e = &_hx_mmap_table[id];\n"
    buf = buf + "    if (!e->base) return hexa_int(-1);\n"
    buf = buf + "    if (off < 0 || n < 0) return hexa_int(-1);\n"
    buf = buf + "    if ((size_t)off + (size_t)(n * 2) > e->len) return hexa_int(-1);\n"
    buf = buf + "    HexaVal farr_handle = hexa_farr_zeros(hexa_int(n));\n"
    buf = buf + "    int64_t farr_id = HX_INT(farr_handle);\n"
    buf = buf + "    if (farr_id < 0 || farr_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    HexaFarrEntry* fe = &_hx_farr_table[farr_id];\n"
    buf = buf + "    if (!fe->buf || fe->len < n) return hexa_int(-1);\n"
    buf = buf + "    const unsigned char* src = (const unsigned char*)e->base + off;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    // Read host-endian-safe: bf16 in safetensors is stored as little-\n"
    buf = buf + "    // endian uint16. Compose explicitly so this works on any host.\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        uint16_t u16 = (uint16_t)src[2*i] | ((uint16_t)src[2*i + 1] << 8);\n"
    buf = buf + "        uint32_t u32 = ((uint32_t)u16) << 16;\n"
    buf = buf + "        // Type-pun via union to avoid strict-aliasing UB.\n"
    buf = buf + "        union { uint32_t u; float f; } cvt;\n"
    buf = buf + "        cvt.u = u32;\n"
    buf = buf + "        fe->buf[i] = (double)cvt.f;\n"
    buf = buf + "    }\n"
    buf = buf + "    return farr_handle;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// safetensors_mmap_read_bytes(handle, byte_off, n_bytes) → [int].\n"
    buf = buf + "// Reads n_bytes bytes from mmap as a boxed hexa int array. Used for\n"
    buf = buf + "// integral-dtype tensors or for header-byte inspection. Memory cost\n"
    buf = buf + "// is the standard Val-boxed per-byte (88B/byte interp, 16B/byte AOT),\n"
    buf = buf + "// but the per-tensor `safetensors_mmap_read_f32_farr` path avoids\n"
    buf = buf + "// this for the dominant f32 weight payload.\n"
    buf = buf + "HexaVal hexa_safetensors_mmap_read_bytes(HexaVal h_v, HexaVal off_v, HexaVal n_v) {\n"
    buf = buf + "    int64_t id   = hexa_as_num(h_v);\n"
    buf = buf + "    int64_t off  = hexa_as_num(off_v);\n"
    buf = buf + "    int64_t n    = hexa_as_num(n_v);\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (id < 0 || id >= _hx_mmap_count) return out;\n"
    buf = buf + "    HexaMmapEntry* e = &_hx_mmap_table[id];\n"
    buf = buf + "    if (!e->base) return out;\n"
    buf = buf + "    if (off < 0 || n < 0) return out;\n"
    buf = buf + "    if ((size_t)off + (size_t)n > e->len) return out;\n"
    buf = buf + "    const unsigned char* src = (const unsigned char*)e->base + off;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        out = hexa_array_push(out, hexa_int((int64_t)src[i]));\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// safetensors_mmap_close(handle) → void. Idempotent. After this the\n"
    buf = buf + "// handle slot is recycled via the freelist; callers MUST NOT use\n"
    buf = buf + "// previously-returned farr_ids derived from this handle, but since\n"
    buf = buf + "// farr buffers are independent of mmap (copied at read time), they\n"
    buf = buf + "// remain valid until farr_free.\n"
    buf = buf + "HexaVal hexa_safetensors_mmap_close(HexaVal h_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_mmap_count) return hexa_void();\n"
    buf = buf + "    HexaMmapEntry* e = &_hx_mmap_table[id];\n"
    buf = buf + "    if (e->base) {\n"
    buf = buf + "        munmap(e->base, e->len);\n"
    buf = buf + "        e->base = NULL;\n"
    buf = buf + "        e->len = 0;\n"
    buf = buf + "    }\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    if (e->fd >= 0) {\n"
    buf = buf + "        hxlcl_close(e->fd);\n"
    buf = buf + "        e->fd = -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_hx_mmap_freelist_n >= _hx_mmap_freelist_cap) {\n"
    buf = buf + "        int64_t new_cap = _hx_mmap_freelist_cap < 8 ? 8 : _hx_mmap_freelist_cap * 2;\n"
    buf = buf + "        int64_t* nf = (int64_t*)realloc(_hx_mmap_freelist,\n"
    buf = buf + "                       (size_t)new_cap * sizeof(int64_t));\n"
    buf = buf + "        if (nf) {\n"
    buf = buf + "            _hx_mmap_freelist = nf;\n"
    buf = buf + "            _hx_mmap_freelist_cap = new_cap;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_hx_mmap_freelist_n < _hx_mmap_freelist_cap) {\n"
    buf = buf + "        _hx_mmap_freelist[_hx_mmap_freelist_n++] = id;\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + "// RFC 032 (2026-05-12): farr_matmul — packed-double matrix multiply.\n"
    buf = buf + "//\n"
    buf = buf + "//   farr_matmul(A_farr, A_rows, A_cols, B_farr, B_cols) -> C_farr\n"
    buf = buf + "//\n"
    buf = buf + "// Semantics: C = A @ B, where\n"
    buf = buf + "//   A is (A_rows × A_cols) row-major in farr buffer A_farr,\n"
    buf = buf + "//   B is (A_cols × B_cols) row-major in farr buffer B_farr,\n"
    buf = buf + "//   C is (A_rows × B_cols) row-major in a freshly-allocated farr.\n"
    buf = buf + "//\n"
    buf = buf + "// Returns -1 (as a HexaVal{int}) on shape / bounds error.\n"
    buf = buf + "//\n"
    buf = buf + "// Why a native builtin: pure-hexa matmul through farr_get/farr_set\n"
    buf = buf + "// allocates ~12-88 B HexaVal scratch per inner-loop scalar op. For\n"
    buf = buf + "// a single 1024×1024 matmul (~2^30 mac) this saturates the interp\n"
    buf = buf + "// arena (>100 GB extrapolated) long before completion. The native\n"
    buf = buf + "// kernel below uses raw double* indexing, zero arena pressure, and\n"
    buf = buf + "// finishes a 1024² matmul in well under a second.\n"
    buf = buf + "//\n"
    buf = buf + "// Algorithm: cache-friendly ikj triple loop (best for row-major\n"
    buf = buf + "// row-major output):\n"
    buf = buf + "//   for i in 0..M:\n"
    buf = buf + "//     for k in 0..K:\n"
    buf = buf + "//       a_ik = A[i*K + k]\n"
    buf = buf + "//       for j in 0..N:\n"
    buf = buf + "//         C[i*N + j] += a_ik * B[k*N + j]\n"
    buf = buf + "// This streams B linearly and reuses C[i*N + j] in registers.\n"
    buf = buf + "//\n"
    buf = buf + "// No BLAS dependency; no AVX intrinsics (portability over peak FLOPS).\n"
    buf = buf + "// On a 24-layer EngineAG forward (4 Linear ops/layer × 24 layers + LM\n"
    buf = buf + "// head, each at hidden=1024) this is fast enough to clear the Phase 5∥\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// 24-layer parity gate without GPU.\n"
    buf = buf + "//\n"
    buf = buf + "// Falsifier coverage: F-RFC032-2x2-1 / IDENT-2 / RECT-3 / LARGE-4 / MEM-5\n"
    buf = buf + "// (see tmp_rfc032_smoke.hexa).\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + "HexaVal hexa_farr_matmul(HexaVal a_v, HexaVal ar_v, HexaVal ac_v,\n"
    buf = buf + "                         HexaVal b_v, HexaVal bc_v) {\n"
    buf = buf + "    int64_t a_id = hexa_as_num(a_v);\n"
    buf = buf + "    int64_t M    = hexa_as_num(ar_v);\n"
    buf = buf + "    int64_t K    = hexa_as_num(ac_v);\n"
    buf = buf + "    int64_t b_id = hexa_as_num(b_v);\n"
    buf = buf + "    int64_t N    = hexa_as_num(bc_v);\n"
    buf = buf + "    if (a_id < 0 || a_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (b_id < 0 || b_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (M <= 0 || K <= 0 || N <= 0)         return hexa_int(-1);\n"
    buf = buf + "    HexaFarrEntry* ae = &_hx_farr_table[a_id];\n"
    buf = buf + "    HexaFarrEntry* be = &_hx_farr_table[b_id];\n"
    buf = buf + "    if (!ae->buf || !be->buf)               return hexa_int(-1);\n"
    buf = buf + "    if (ae->len < M * K)                    return hexa_int(-1);\n"
    buf = buf + "    if (be->len < K * N)                    return hexa_int(-1);\n"
    buf = buf + "    // Allocate output farr (zero-filled by hexa_farr_zeros).\n"
    buf = buf + "    // NOTE: hexa_farr_zeros may realloc() _hx_farr_table when capacity grows,\n"
    buf = buf + "    // which MOVES every HexaFarrEntry — ae/be captured above become dangling.\n"
    buf = buf + "    // Re-fetch ALL entry pointers by id AFTER the allocation. (Fixes a\n"
    buf = buf + "    // use-after-realloc segfault in chained matvec, e.g. anima\n"
    buf = buf + "    // HEXAD/BRIDGE/bridge_forward.)\n"
    buf = buf + "    HexaVal c_handle = hexa_farr_zeros(hexa_int(M * N));\n"
    buf = buf + "    int64_t c_id = HX_INT(c_handle);\n"
    buf = buf + "    if (c_id < 0 || c_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    ae = &_hx_farr_table[a_id];\n"
    buf = buf + "    be = &_hx_farr_table[b_id];\n"
    buf = buf + "    HexaFarrEntry* ce = &_hx_farr_table[c_id];\n"
    buf = buf + "    if (!ae->buf || !be->buf)               return hexa_int(-1);\n"
    buf = buf + "    if (!ce->buf || ce->len < M * N)        return hexa_int(-1);\n"
    buf = buf + "    const double* A = ae->buf;\n"
    buf = buf + "    const double* B = be->buf;\n"
    buf = buf + "    double* C = ce->buf;\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "    /* RFC 040 Phase D / gap(d) generic-path forge routing: dim-gate\n"
    buf = buf + "     * large GEMMs to the verified cuBLAS Dgemm path. The GENERIC ag_tape\n"
    buf = buf + "     * path's ag_linear → nn_linear_fwd → forge_dispatch_matmul →\n"
    buf = buf + "     * dispatcher → hexa_farr_matmul lands here; d768-class shapes\n"
    buf = buf + "     * (M*K, K*N up to ~2.36M) route to GPU cuBLAS. The tiny ag_tape\n"
    buf = buf + "     * byte-eq oracles (M*K, K*N << 8192) stay on the CPU ikj path and\n"
    buf = buf + "     * remain bit-exact (threshold mirrors flame_phase4b3). On any GPU\n"
    buf = buf + "     * error → fall through to the CPU loop (safe). HEXA_CUDA-only: the\n"
    buf = buf + "     * no-CUDA build is byte-identical (this block is inert). */\n"
    buf = buf + "    if ((M * K) > 8192 || (K * N) > 8192) {\n"
    buf = buf + "        extern int _hx_cuda_farr_matmul_gpu(int64_t a_id, int64_t M,\n"
    buf = buf + "                                            int64_t K, int64_t b_id,\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "                                            int64_t N, int64_t c_id);\n"
    buf = buf + "        int grc = _hx_cuda_farr_matmul_gpu(a_id, M, K, b_id, N, c_id);\n"
    buf = buf + "        if (grc == 0) return c_handle;\n"
    buf = buf + "        /* grc != 0: GPU path failed — fall through to CPU ikj. */\n"
    buf = buf + "    }\n"
    buf = buf + "#endif\n"
    buf = buf + "    // ikj loop — streaming B + C, A_ik hoisted out of j.\n"
    buf = buf + "    for (int64_t i = 0; i < M; i++) {\n"
    buf = buf + "        const double* Ai = A + i * K;\n"
    buf = buf + "        double*       Ci = C + i * N;\n"
    buf = buf + "        for (int64_t k = 0; k < K; k++) {\n"
    buf = buf + "            double a_ik = Ai[k];\n"
    buf = buf + "            const double* Bk = B + k * N;\n"
    buf = buf + "            // Inner: C[i,j] += a_ik * B[k,j]\n"
    buf = buf + "            int64_t j = 0;\n"
    buf = buf + "            // Light manual unroll x4 — keeps portability, helps clang\n"
    buf = buf + "            // emit fma (-O2). Tail loop handles N % 4.\n"
    buf = buf + "            for (; j + 4 <= N; j += 4) {\n"
    buf = buf + "                Ci[j]   += a_ik * Bk[j];\n"
    buf = buf + "                Ci[j+1] += a_ik * Bk[j+1];\n"
    buf = buf + "                Ci[j+2] += a_ik * Bk[j+2];\n"
    buf = buf + "                Ci[j+3] += a_ik * Bk[j+3];\n"
    buf = buf + "            }\n"
    buf = buf + "            for (; j < N; j++) {\n"
    buf = buf + "                Ci[j] += a_ik * Bk[j];\n"
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return c_handle;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + "// RFC 033 (2026-05-12): farr_copy + farr_add_gaussian_noise.\n"
    buf = buf + "//\n"
    buf = buf + "// Both builtins exist to unblock anima tool/hexa_native/mitosis_hook\n"
    buf = buf + "// .hexa full-impl. The PyTorch reference (anima/tool/mitosis.py\n"
    buf = buf + "// L204/L213) does:\n"
    buf = buf + "//\n"
    buf = buf + "//     child_state = {k: v.clone() for k,v in parent_state.items()}\n"
    buf = buf + "//     for w in child_state.values():\n"
    buf = buf + "//         w.add_(torch.randn_like(w) * 0.1 * w.std())\n"
    buf = buf + "//\n"
    buf = buf + "// The pure-hexa equivalent without these two builtins needs N\n"
    buf = buf + "// farr_get/farr_set scalar ops per element + a Box-Muller emitted in\n"
    buf = buf + "// hexa, paying ~88 B HexaVal arena per element. For a 1 M-element\n"
    buf = buf + "// layer that is ~88 MB scratch per layer, ~2 GB across 24 layers —\n"
    buf = buf + "// far past the interp arena cap. The native builtins below do the\n"
    buf = buf + "// same work with zero hot-loop allocation.\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// RFC 033-A — farr_copy(src) -> dst.\n"
    buf = buf + "//   Deep-copy the contents of farr handle `src` into a freshly\n"
    buf = buf + "//   allocated farr handle. Returns -1 on invalid src. Empty src\n"
    buf = buf + "//   (len=0) returns a valid empty handle, not -1.\n"
    buf = buf + "HexaVal hexa_farr_copy(HexaVal src_v) {\n"
    buf = buf + "    int64_t src_id = hexa_as_num(src_v);\n"
    buf = buf + "    if (src_id < 0 || src_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    HexaFarrEntry* se = &_hx_farr_table[src_id];\n"
    buf = buf + "    // freed slot (buf NULL with len>0 would be a runtime bug, but a\n"
    buf = buf + "    // freed slot has buf=NULL and len=0 after hexa_farr_free; reject\n"
    buf = buf + "    // the former, accept the latter as an empty copy).\n"
    buf = buf + "    if (!se->buf && se->len > 0) return hexa_int(-1);\n"
    buf = buf + "    int64_t n = se->len;\n"
    buf = buf + "    HexaVal dst_handle = hexa_farr_zeros(hexa_int(n));\n"
    buf = buf + "    int64_t dst_id = HX_INT(dst_handle);\n"
    buf = buf + "    if (dst_id < 0 || dst_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    // hexa_farr_zeros may realloc() _hx_farr_table — `se` captured above is\n"
    buf = buf + "    // now dangling. Re-fetch BOTH entry pointers by id after the allocation.\n"
    buf = buf + "    se = &_hx_farr_table[src_id];\n"
    buf = buf + "    HexaFarrEntry* de = &_hx_farr_table[dst_id];\n"
    buf = buf + "    if (n > 0 && de->buf && se->buf) {\n"
    buf = buf + "        hxlcl_memcpy(de->buf, se->buf, (size_t)n * sizeof(double));\n"
    buf = buf + "    }\n"
    buf = buf + "    return dst_handle;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ── RFC 033-B PRNG support ────────────────────────────────────────\n"
    buf = buf + "// splitmix64 — a 64-bit non-cryptographic PRNG with good\n"
    buf = buf + "// distributional properties for Monte Carlo noise. Used here as the\n"
    buf = buf + "// internal source for the Box-Muller transform driving\n"
    buf = buf + "// farr_add_gaussian_noise. State is process-local (single-thread\n"
    buf = buf + "// interp); revisit if hexa gains threads.\n"
    buf = buf + "static uint64_t _hx_gauss_rng_state = 0;\n"
    buf = buf + "static int      _hx_gauss_rng_inited = 0;\n"
    buf = buf + "\n"
    buf = buf + "static uint64_t _hx_splitmix64_next(uint64_t* x) {\n"
    buf = buf + "    uint64_t z = (*x += 0x9E3779B97F4A7C15ULL);\n"
    buf = buf + "    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ULL;\n"
    buf = buf + "    z = (z ^ (z >> 27)) * 0x94D049BB133111EBULL;\n"
    buf = buf + "    return z ^ (z >> 31);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Map u64 → double in (2^-53, 1]. Open at zero avoids log(0) in\n"
    buf = buf + "// Box-Muller.\n"
    buf = buf + "static double _hx_uniform01_open(uint64_t* state) {\n"
    buf = buf + "    uint64_t r = _hx_splitmix64_next(state) >> 11;       // 53-bit mantissa\n"
    buf = buf + "    if (r == 0) r = 1;\n"
    buf = buf + "    return (double)r * (1.0 / 9007199254740992.0);       // 2^53\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "static void _hx_gauss_rng_lazy_init(void) {\n"
    buf = buf + "    if (_hx_gauss_rng_inited) return;\n"
    buf = buf + "    const char* env = hxlcl_getenv(\"__HEXA_FARR_GAUSS_SEED__\");\n"
    buf = buf + "    if (env && *env) {\n"
    buf = buf + "        _hx_gauss_rng_state = hxlcl_strtoull(env, NULL, 10);\n"
    buf = buf + "    } else {\n"
    buf = buf + "        _hx_gauss_rng_state = (uint64_t)hxlcl_time(NULL) ^\n"
    buf = buf + "                              ((uint64_t)hxlcl_getpid() << 16);\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_hx_gauss_rng_state == 0) _hx_gauss_rng_state = 1;\n"
    buf = buf + "    _hx_gauss_rng_inited = 1;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// RFC 033-B — farr_add_gaussian_noise(target, sigma) -> void.\n"
    buf = buf + "//   In-place addition of N(0, sigma^2) draws to every element of\n"
    buf = buf + "//   farr handle `target`. Box-Muller transform pairs adjacent\n"
    buf = buf + "//   elements; tail element (when len is odd) consumes one extra\n"
    buf = buf + "//   pair and uses only z0.\n"
    buf = buf + "//\n"
    buf = buf + "//   No-op on: invalid handle, sigma == 0.0, sigma < 0, or NaN sigma.\n"
    buf = buf + "//   Reproducibility: set __HEXA_FARR_GAUSS_SEED__=<u64-decimal>\n"
    buf = buf + "//   before first call (the env is read once and cached).\n"
    buf = buf + "HexaVal hexa_farr_add_gaussian_noise(HexaVal target_v, HexaVal sigma_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(target_v);\n"
    buf = buf + "    double  sigma = __hx_to_double(sigma_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_farr_count) return hexa_void();\n"
    buf = buf + "    HexaFarrEntry* e = &_hx_farr_table[id];\n"
    buf = buf + "    if (!e->buf || e->len <= 0)         return hexa_void();\n"
    buf = buf + "    // Reject NaN (sigma != sigma) and negative sigma. sigma == 0 is a\n"
    buf = buf + "    // no-op — every draw would be 0.0 anyway.\n"
    buf = buf + "    if (!(sigma == sigma))              return hexa_void();\n"
    buf = buf + "    if (sigma < 0.0)                    return hexa_void();\n"
    buf = buf + "    if (sigma == 0.0)                   return hexa_void();\n"
    buf = buf + "    _hx_gauss_rng_lazy_init();\n"
    buf = buf + "    int64_t n = e->len;\n"
    buf = buf + "    int64_t i = 0;\n"
    buf = buf + "    const double two_pi = 6.28318530717958647692; // 2π\n"
    buf = buf + "    for (; i + 2 <= n; i += 2) {\n"
    buf = buf + "        double u1 = _hx_uniform01_open(&_hx_gauss_rng_state);\n"
    buf = buf + "        double u2 = _hx_uniform01_open(&_hx_gauss_rng_state);\n"
    buf = buf + "        double r  = _hx_sqrt(-2.0 * hxlcl_log(u1));\n"
    buf = buf + "        double th = two_pi * u2;\n"
    buf = buf + "        e->buf[i]   += sigma * r * hxlcl_cos(th);\n"
    buf = buf + "        e->buf[i+1] += sigma * r * hxlcl_sin(th);\n"
    buf = buf + "    }\n"
    buf = buf + "    if (i < n) {\n"
    buf = buf + "        double u1 = _hx_uniform01_open(&_hx_gauss_rng_state);\n"
    buf = buf + "        double u2 = _hx_uniform01_open(&_hx_gauss_rng_state);\n"
    buf = buf + "        double r  = _hx_sqrt(-2.0 * hxlcl_log(u1));\n"
    buf = buf + "        double th = two_pi * u2;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        e->buf[i] += sigma * r * hxlcl_cos(th);\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + "// anima RFC 034 (2026-05-16): farr reverse-mode autograd.\n"
    buf = buf + "//\n"
    buf = buf + "// Minimal tape-based reverse-mode AD layered on the existing packed-\n"
    buf = buf + "// double farr typed-arena (RFC 030/032/033). v1 = FP32-equivalent\n"
    buf = buf + "// (double internally), single-process, single-arena. Scope is exactly\n"
    buf = buf + "// the anima HEXAD 6-module decoder train step: one linear layer +\n"
    buf = buf + "// softmax-cross-entropy + AdamW. Zero HexaVal boxing in the reverse\n"
    buf = buf + "// sweep (every backward closure walks raw double* — the RFC 032\n"
    buf = buf + "// matmul contract, extended to gradients).\n"
    buf = buf + "//\n"
    buf = buf + "// Surface (anima/HEXAD/PLAN.md Phase 5 unblock):\n"
    buf = buf + "//   ad_tape_begin() -> int\n"
    buf = buf + "//   ad_tape_end(tape_id) -> void\n"
    buf = buf + "//   ad_matmul(A,Ar,Ac,B,Bc) -> int          (wraps RFC 032 farr_matmul)\n"
    buf = buf + "//   ad_softmax_cross_entropy(logits,nr,nc,targets) -> float\n"
    buf = buf + "//   ad_backward(tape_id) -> void\n"
    buf = buf + "//   ad_grad(param_farr) -> int               (grad farr_id for a leaf)\n"
    buf = buf + "//   adamw_step(p,g,m,v,n,lr,b1,b2,eps,wd,t) -> void\n"
    buf = buf + "//\n"
    buf = buf + "// The softmax-CE logit-Jacobian is the closed-form anima B-D-4 sympy\n"
    buf = buf + "// identity   ∂CE/∂z_i = softmax(z)_i − [i = t]   (verified ∀ z in\n"
    buf = buf + "// anima state/verify_hexad_blue_2026_05_15/blue_falsifier.py B-D-4).\n"
    buf = buf + "// Implemented fused/native so the acceptance test has a deterministic\n"
    buf = buf + "// gradient oracle (no composed tape for the single most common loss).\n"
    buf = buf + "//\n"
    buf = buf + "// Falsifier coverage: tmp_rfc034_smoke.hexa\n"
    buf = buf + "//   F-RFC034-BUILD / GRAD-EXACT / LOSS-DECREASES / PARAM-MUTATED / DETERMINISM\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + "\n"
    buf = buf + "// Backward op kinds recorded on the tape.\n"
    buf = buf + "#define _HX_AD_OP_MATMUL  1\n"
    buf = buf + "#define _HX_AD_OP_SMCE    2\n"
    buf = buf + "\n"
    buf = buf + "typedef struct {\n"
    buf = buf + "    int      kind;       // _HX_AD_OP_*\n"
    buf = buf + "    int64_t  a_id;       // matmul: A farr ; smce: logits farr\n"
    buf = buf + "    int64_t  b_id;       // matmul: B farr ; smce: targets farr\n"
    buf = buf + "    int64_t  out_id;     // matmul: C farr ; smce: unused (-1)\n"
    buf = buf + "    int64_t  m;          // matmul: A rows ; smce: n_rows\n"
    buf = buf + "    int64_t  k;          // matmul: A cols ; smce: n_cols\n"
    buf = buf + "    int64_t  n;          // matmul: B cols ; smce: unused\n"
    buf = buf + "} HexaAdNode;\n"
    buf = buf + "\n"
    buf = buf + "typedef struct {\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    HexaAdNode* nodes;\n"
    buf = buf + "    int64_t     count;\n"
    buf = buf + "    int64_t     cap;\n"
    buf = buf + "    int         active;\n"
    buf = buf + "} HexaAdTape;\n"
    buf = buf + "\n"
    buf = buf + "// Single-arena v1 (RFC 034 Non-goals: single-process). One tape table;\n"
    buf = buf + "// at most one tape is \"active\" at a time (the anima train loop opens /\n"
    buf = buf + "// closes a fresh tape per step). grad map is global (param farr_id →\n"
    buf = buf + "// grad farr_id), persisting across steps so adamw_step can read it.\n"
    buf = buf + "static HexaAdTape* _hx_ad_tapes      = NULL;\n"
    buf = buf + "static int64_t     _hx_ad_tape_count = 0;\n"
    buf = buf + "static int64_t     _hx_ad_tape_cap   = 0;\n"
    buf = buf + "static int64_t     _hx_ad_active     = -1;   // active tape id, -1 = none\n"
    buf = buf + "\n"
    buf = buf + "// grad registry: parallel arrays param_farr_id -> grad_farr_id.\n"
    buf = buf + "static int64_t* _hx_ad_grad_param = NULL;\n"
    buf = buf + "static int64_t* _hx_ad_grad_grad  = NULL;\n"
    buf = buf + "static int64_t  _hx_ad_grad_n     = 0;\n"
    buf = buf + "static int64_t  _hx_ad_grad_cap   = 0;\n"
    buf = buf + "\n"
    buf = buf + "static double* _hx_ad_farr_buf(int64_t id, int64_t* len_out) {\n"
    buf = buf + "    if (id < 0 || id >= _hx_farr_count) return NULL;\n"
    buf = buf + "    HexaFarrEntry* e = &_hx_farr_table[id];\n"
    buf = buf + "    if (len_out) *len_out = e->len;\n"
    buf = buf + "    return e->buf;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Register / overwrite grad farr handle for a param leaf. The grad\n"
    buf = buf + "// buffer is owned by the registry; ad_backward reallocs it zeroed.\n"
    buf = buf + "static void _hx_ad_grad_put(int64_t param_id, int64_t grad_id) {\n"
    buf = buf + "    for (int64_t i = 0; i < _hx_ad_grad_n; i++) {\n"
    buf = buf + "        if (_hx_ad_grad_param[i] == param_id) {\n"
    buf = buf + "            _hx_ad_grad_grad[i] = grad_id;\n"
    buf = buf + "            return;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_hx_ad_grad_n >= _hx_ad_grad_cap) {\n"
    buf = buf + "        int64_t nc = _hx_ad_grad_cap < 16 ? 16 : _hx_ad_grad_cap * 2;\n"
    buf = buf + "        int64_t* np = (int64_t*)realloc(_hx_ad_grad_param, (size_t)nc * sizeof(int64_t));\n"
    buf = buf + "        int64_t* ng = (int64_t*)realloc(_hx_ad_grad_grad,  (size_t)nc * sizeof(int64_t));\n"
    buf = buf + "        if (!np || !ng) { fprintf(stderr, \"[ad] OOM grad registry\\n\"); exit(77); }\n"
    buf = buf + "        _hx_ad_grad_param = np; _hx_ad_grad_grad = ng; _hx_ad_grad_cap = nc;\n"
    buf = buf + "    }\n"
    buf = buf + "    _hx_ad_grad_param[_hx_ad_grad_n] = param_id;\n"
    buf = buf + "    _hx_ad_grad_grad[_hx_ad_grad_n]  = grad_id;\n"
    buf = buf + "    _hx_ad_grad_n++;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "static int64_t _hx_ad_grad_get(int64_t param_id) {\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    for (int64_t i = 0; i < _hx_ad_grad_n; i++)\n"
    buf = buf + "        if (_hx_ad_grad_param[i] == param_id) return _hx_ad_grad_grad[i];\n"
    buf = buf + "    return -1;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ad_tape_begin() -> tape_id (also set active).\n"
    buf = buf + "HexaVal hexa_ad_tape_begin(void) {\n"
    buf = buf + "    int64_t id = -1;\n"
    buf = buf + "    for (int64_t i = 0; i < _hx_ad_tape_count; i++) {\n"
    buf = buf + "        if (!_hx_ad_tapes[i].active && _hx_ad_tapes[i].nodes == NULL) { id = i; break; }\n"
    buf = buf + "    }\n"
    buf = buf + "    if (id < 0) {\n"
    buf = buf + "        if (_hx_ad_tape_count >= _hx_ad_tape_cap) {\n"
    buf = buf + "            int64_t nc = _hx_ad_tape_cap < 8 ? 8 : _hx_ad_tape_cap * 2;\n"
    buf = buf + "            HexaAdTape* nt = (HexaAdTape*)realloc(_hx_ad_tapes,\n"
    buf = buf + "                                (size_t)nc * sizeof(HexaAdTape));\n"
    buf = buf + "            if (!nt) { fprintf(stderr, \"[ad] OOM tape table\\n\"); exit(77); }\n"
    buf = buf + "            _hx_ad_tapes = nt;\n"
    buf = buf + "            _hx_ad_tape_cap = nc;\n"
    buf = buf + "        }\n"
    buf = buf + "        id = _hx_ad_tape_count++;\n"
    buf = buf + "    }\n"
    buf = buf + "    _hx_ad_tapes[id].nodes  = NULL;\n"
    buf = buf + "    _hx_ad_tapes[id].count  = 0;\n"
    buf = buf + "    _hx_ad_tapes[id].cap    = 0;\n"
    buf = buf + "    _hx_ad_tapes[id].active = 1;\n"
    buf = buf + "    _hx_ad_active = id;\n"
    buf = buf + "    return hexa_int(id);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ad_tape_end(tape_id) -> void. Frees the op list; the active marker\n"
    buf = buf + "// clears so the next ad_tape_begin reuses the slot.\n"
    buf = buf + "HexaVal hexa_ad_tape_end(HexaVal tid_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(tid_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_ad_tape_count) return hexa_void();\n"
    buf = buf + "    HexaAdTape* t = &_hx_ad_tapes[id];\n"
    buf = buf + "    if (t->nodes) { free(t->nodes); t->nodes = NULL; }\n"
    buf = buf + "    t->count = 0; t->cap = 0; t->active = 0;\n"
    buf = buf + "    if (_hx_ad_active == id) _hx_ad_active = -1;\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "static void _hx_ad_record(int kind, int64_t a, int64_t b, int64_t out,\n"
    buf = buf + "                          int64_t m, int64_t k, int64_t n) {\n"
    buf = buf + "    if (_hx_ad_active < 0 || _hx_ad_active >= _hx_ad_tape_count) return;\n"
    buf = buf + "    HexaAdTape* t = &_hx_ad_tapes[_hx_ad_active];\n"
    buf = buf + "    if (t->count >= t->cap) {\n"
    buf = buf + "        int64_t nc = t->cap < 16 ? 16 : t->cap * 2;\n"
    buf = buf + "        HexaAdNode* nn = (HexaAdNode*)realloc(t->nodes,\n"
    buf = buf + "                            (size_t)nc * sizeof(HexaAdNode));\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        if (!nn) { fprintf(stderr, \"[ad] OOM tape nodes\\n\"); exit(77); }\n"
    buf = buf + "        t->nodes = nn; t->cap = nc;\n"
    buf = buf + "    }\n"
    buf = buf + "    HexaAdNode* nd = &t->nodes[t->count++];\n"
    buf = buf + "    nd->kind = kind; nd->a_id = a; nd->b_id = b; nd->out_id = out;\n"
    buf = buf + "    nd->m = m; nd->k = k; nd->n = n;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ad_matmul(A,Ar,Ac,B,Bc) -> C_farr_id. Forward = RFC 032 farr_matmul;\n"
    buf = buf + "// records the backward (dA = dC @ Bᵀ ; dB = Aᵀ @ dC).\n"
    buf = buf + "HexaVal hexa_ad_matmul(HexaVal a_v, HexaVal ar_v, HexaVal ac_v,\n"
    buf = buf + "                       HexaVal b_v, HexaVal bc_v) {\n"
    buf = buf + "    int64_t a_id = hexa_as_num(a_v);\n"
    buf = buf + "    int64_t M    = hexa_as_num(ar_v);\n"
    buf = buf + "    int64_t K    = hexa_as_num(ac_v);\n"
    buf = buf + "    int64_t b_id = hexa_as_num(b_v);\n"
    buf = buf + "    int64_t N    = hexa_as_num(bc_v);\n"
    buf = buf + "    HexaVal c_h  = hexa_farr_matmul(a_v, ar_v, ac_v, b_v, bc_v);\n"
    buf = buf + "    int64_t c_id = HX_INT(c_h);\n"
    buf = buf + "    if (c_id < 0) return c_h;            // shape error propagates\n"
    buf = buf + "    _hx_ad_record(_HX_AD_OP_MATMUL, a_id, b_id, c_id, M, K, N);\n"
    buf = buf + "    return c_h;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ad_softmax_cross_entropy(logits, n_rows, n_cols, targets) -> float.\n"
    buf = buf + "// Returns mean CE over the n_rows examples (each row = a length n_cols\n"
    buf = buf + "// logit vector; targets farr holds n_rows class indices). Records the\n"
    buf = buf + "// closed-form B-D-4 logit gradient ∂L/∂logits = (softmax − onehot)/n_rows.\n"
    buf = buf + "HexaVal hexa_ad_softmax_cross_entropy(HexaVal logits_v, HexaVal nr_v,\n"
    buf = buf + "                                      HexaVal nc_v, HexaVal tgt_v) {\n"
    buf = buf + "    int64_t lg_id = hexa_as_num(logits_v);\n"
    buf = buf + "    int64_t R     = hexa_as_num(nr_v);\n"
    buf = buf + "    int64_t C     = hexa_as_num(nc_v);\n"
    buf = buf + "    int64_t tg_id = hexa_as_num(tgt_v);\n"
    buf = buf + "    int64_t lg_len = 0, tg_len = 0;\n"
    buf = buf + "    double* lg = _hx_ad_farr_buf(lg_id, &lg_len);\n"
    buf = buf + "    double* tg = _hx_ad_farr_buf(tg_id, &tg_len);\n"
    buf = buf + "    if (!lg || !tg || R <= 0 || C <= 0) return hexa_float(0.0);\n"
    buf = buf + "    if (lg_len < R * C || tg_len < R)   return hexa_float(0.0);\n"
    buf = buf + "    double total = 0.0;\n"
    buf = buf + "    for (int64_t r = 0; r < R; r++) {\n"
    buf = buf + "        const double* z = lg + r * C;\n"
    buf = buf + "        // numerically-stable softmax: subtract row max.\n"
    buf = buf + "        double zmax = z[0];\n"
    buf = buf + "        for (int64_t j = 1; j < C; j++) if (z[j] > zmax) zmax = z[j];\n"
    buf = buf + "        double s = 0.0;\n"
    buf = buf + "        for (int64_t j = 0; j < C; j++) s += hxlcl_exp(z[j] - zmax);\n"
    buf = buf + "        int64_t tcls = (int64_t)(tg[r] + 0.5);   // class index (round)\n"
    buf = buf + "        if (tcls < 0) tcls = 0;\n"
    buf = buf + "        if (tcls >= C) tcls = C - 1;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        // CE = -log softmax(z)_t = (zmax - z_t) + log Σ exp(z - zmax)\n"
    buf = buf + "        double ce = (zmax - z[tcls]) + hxlcl_log(s);\n"
    buf = buf + "        total += ce;\n"
    buf = buf + "    }\n"
    buf = buf + "    _hx_ad_record(_HX_AD_OP_SMCE, lg_id, tg_id, -1, R, C, 0);\n"
    buf = buf + "    return hexa_float(total / (double)R);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Ensure a zeroed grad farr of length n for param leaf `param_id`,\n"
    buf = buf + "// returning its farr_id. Reuses the registered handle if its length\n"
    buf = buf + "// matches, else (re)allocates.\n"
    buf = buf + "static int64_t _hx_ad_grad_ensure(int64_t param_id, int64_t n) {\n"
    buf = buf + "    int64_t g = _hx_ad_grad_get(param_id);\n"
    buf = buf + "    if (g >= 0 && g < _hx_farr_count && _hx_farr_table[g].buf\n"
    buf = buf + "        && _hx_farr_table[g].len == n) {\n"
    buf = buf + "        hxlcl_memset(_hx_farr_table[g].buf, 0, (size_t)n * sizeof(double));\n"
    buf = buf + "        return g;\n"
    buf = buf + "    }\n"
    buf = buf + "    HexaVal gh = hexa_farr_zeros(hexa_int(n));\n"
    buf = buf + "    int64_t gid = HX_INT(gh);\n"
    buf = buf + "    _hx_ad_grad_put(param_id, gid);\n"
    buf = buf + "    return gid;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ad_backward(tape_id) -> void. Reverse sweep. v1 supports the anima\n"
    buf = buf + "// train-step graph exactly: a single ad_matmul (X @ W -> logits)\n"
    buf = buf + "// feeding one ad_softmax_cross_entropy. The CE node seeds dlogits via\n"
    buf = buf + "// the closed B-D-4 identity; the matmul node backprops dW = Xᵀ @ dC\n"
    buf = buf + "// (the param gradient anima's AdamW consumes) and dA = dC @ Bᵀ.\n"
    buf = buf + "HexaVal hexa_ad_backward(HexaVal tid_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(tid_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_ad_tape_count) return hexa_void();\n"
    buf = buf + "    HexaAdTape* t = &_hx_ad_tapes[id];\n"
    buf = buf + "    if (!t->nodes || t->count <= 0) return hexa_void();\n"
    buf = buf + "\n"
    buf = buf + "    // dC accumulator keyed by farr_id (the loss-side cotangent). v1\n"
    buf = buf + "    // graph is a chain, so a small linear map suffices.\n"
    buf = buf + "    // Reverse walk.\n"
    buf = buf + "    for (int64_t qi = t->count - 1; qi >= 0; qi--) {\n"
    buf = buf + "        HexaAdNode* nd = &t->nodes[qi];\n"
    buf = buf + "        if (nd->kind == _HX_AD_OP_SMCE) {\n"
    buf = buf + "            int64_t R = nd->m, C = nd->k;\n"
    buf = buf + "            int64_t lg_len = 0, tg_len = 0;\n"
    buf = buf + "            double* lg = _hx_ad_farr_buf(nd->a_id, &lg_len);\n"
    buf = buf + "            double* tg = _hx_ad_farr_buf(nd->b_id, &tg_len);\n"
    buf = buf + "            if (!lg || !tg) continue;\n"
    buf = buf + "            int64_t g = _hx_ad_grad_ensure(nd->a_id, R * C);\n"
    buf = buf + "            double* dz = _hx_farr_table[g].buf;\n"
    buf = buf + "            for (int64_t r = 0; r < R; r++) {\n"
    buf = buf + "                const double* z = lg + r * C;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "                double* d = dz + r * C;\n"
    buf = buf + "                double zmax = z[0];\n"
    buf = buf + "                for (int64_t j = 1; j < C; j++) if (z[j] > zmax) zmax = z[j];\n"
    buf = buf + "                double s = 0.0;\n"
    buf = buf + "                for (int64_t j = 0; j < C; j++) s += hxlcl_exp(z[j] - zmax);\n"
    buf = buf + "                int64_t tcls = (int64_t)(tg[r] + 0.5);\n"
    buf = buf + "                if (tcls < 0) tcls = 0;\n"
    buf = buf + "                if (tcls >= C) tcls = C - 1;\n"
    buf = buf + "                // B-D-4: ∂L/∂z_i = softmax(z)_i − [i=t], averaged over R.\n"
    buf = buf + "                for (int64_t j = 0; j < C; j++) {\n"
    buf = buf + "                    double sm = hxlcl_exp(z[j] - zmax) / s;\n"
    buf = buf + "                    d[j] = (sm - (j == tcls ? 1.0 : 0.0)) / (double)R;\n"
    buf = buf + "                }\n"
    buf = buf + "            }\n"
    buf = buf + "        } else if (nd->kind == _HX_AD_OP_MATMUL) {\n"
    buf = buf + "            // Forward C = A(MxK) @ B(KxN). Upstream cotangent dC lives\n"
    buf = buf + "            // in the grad slot of out_id (seeded by the CE node above\n"
    buf = buf + "            // when out_id == its logits farr).\n"
    buf = buf + "            int64_t M = nd->m, K = nd->k, N = nd->n;\n"
    buf = buf + "            int64_t dc_id = _hx_ad_grad_get(nd->out_id);\n"
    buf = buf + "            double* dC = (dc_id >= 0) ? _hx_farr_table[dc_id].buf : NULL;\n"
    buf = buf + "            int64_t a_len = 0, b_len = 0;\n"
    buf = buf + "            double* A = _hx_ad_farr_buf(nd->a_id, &a_len);\n"
    buf = buf + "            double* B = _hx_ad_farr_buf(nd->b_id, &b_len);\n"
    buf = buf + "            if (!dC || !A || !B) continue;\n"
    buf = buf + "            // dB = Aᵀ @ dC  (K x N) — the param (weight) gradient.\n"
    buf = buf + "            int64_t gB = _hx_ad_grad_ensure(nd->b_id, K * N);\n"
    buf = buf + "            double* dB = _hx_farr_table[gB].buf;\n"
    buf = buf + "            for (int64_t kk = 0; kk < K; kk++) {\n"
    buf = buf + "                for (int64_t i = 0; i < M; i++) {\n"
    buf = buf + "                    double a_ik = A[i * K + kk];\n"
    buf = buf + "                    const double* dCi = dC + i * N;\n"
    buf = buf + "                    double* dBk = dB + kk * N;\n"
    buf = buf + "                    for (int64_t j = 0; j < N; j++)\n"
    buf = buf + "                        dBk[j] += a_ik * dCi[j];\n"
    buf = buf + "                }\n"
    buf = buf + "            }\n"
    buf = buf + "            // dA = dC @ Bᵀ  (M x K) — input cotangent (chain upstream).\n"
    buf = buf + "            int64_t gA = _hx_ad_grad_ensure(nd->a_id, M * K);\n"
    buf = buf + "            double* dA = _hx_farr_table[gA].buf;\n"
    buf = buf + "            for (int64_t i = 0; i < M; i++) {\n"
    buf = buf + "                const double* dCi = dC + i * N;\n"
    buf = buf + "                double* dAi = dA + i * K;\n"
    buf = buf + "                for (int64_t kk = 0; kk < K; kk++) {\n"
    buf = buf + "                    const double* Bk = B + kk * N;\n"
    buf = buf + "                    double acc = 0.0;\n"
    buf = buf + "                    for (int64_t j = 0; j < N; j++)\n"
    buf = buf + "                        acc += dCi[j] * Bk[j];\n"
    buf = buf + "                    dAi[kk] = acc;\n"
    buf = buf + "                }\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ad_grad(param_farr) -> grad farr_id (-1 if no grad recorded).\n"
    buf = buf + "HexaVal hexa_ad_grad(HexaVal param_v) {\n"
    buf = buf + "    int64_t pid = hexa_as_num(param_v);\n"
    buf = buf + "    return hexa_int(_hx_ad_grad_get(pid));\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// adamw_step(param, grad, m, v, n, lr, beta1, beta2, eps, wd, t).\n"
    buf = buf + "// Single fused in-place AdamW (decoupled weight decay, Loshchilov &\n"
    buf = buf + "// Hutter 2019). All of param/grad/m/v are length-n packed-double farrs;\n"
    buf = buf + "// t is the 1-based step (bias correction). No HexaVal in the loop.\n"
    buf = buf + "HexaVal hexa_adamw_step(HexaVal p_v, HexaVal g_v, HexaVal m_v, HexaVal v_v,\n"
    buf = buf + "                        HexaVal n_v, HexaVal lr_v, HexaVal b1_v, HexaVal b2_v,\n"
    buf = buf + "                        HexaVal eps_v, HexaVal wd_v, HexaVal t_v) {\n"
    buf = buf + "    int64_t p_id = hexa_as_num(p_v);\n"
    buf = buf + "    int64_t g_id = hexa_as_num(g_v);\n"
    buf = buf + "    int64_t m_id = hexa_as_num(m_v);\n"
    buf = buf + "    int64_t v_id = hexa_as_num(v_v);\n"
    buf = buf + "    int64_t n    = hexa_as_num(n_v);\n"
    buf = buf + "    double  lr   = __hx_to_double(lr_v);\n"
    buf = buf + "    double  b1   = __hx_to_double(b1_v);\n"
    buf = buf + "    double  b2   = __hx_to_double(b2_v);\n"
    buf = buf + "    double  eps  = __hx_to_double(eps_v);\n"
    buf = buf + "    double  wd   = __hx_to_double(wd_v);\n"
    buf = buf + "    int64_t tstep= hexa_as_num(t_v);\n"
    buf = buf + "    if (n <= 0 || tstep < 1) return hexa_void();\n"
    buf = buf + "    double* P = _hx_ad_farr_buf(p_id, NULL);\n"
    buf = buf + "    double* G = _hx_ad_farr_buf(g_id, NULL);\n"
    buf = buf + "    double* Mm= _hx_ad_farr_buf(m_id, NULL);\n"
    buf = buf + "    double* Vv= _hx_ad_farr_buf(v_id, NULL);\n"
    buf = buf + "    if (!P || !G || !Mm || !Vv) return hexa_void();\n"
    buf = buf + "    double bc1 = 1.0 - _hx_powi(b1, (long)tstep);\n"
    buf = buf + "    double bc2 = 1.0 - _hx_powi(b2, (long)tstep);\n"
    buf = buf + "    if (bc1 == 0.0) bc1 = 1e-30;\n"
    buf = buf + "    if (bc2 == 0.0) bc2 = 1e-30;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        double gi = G[i];\n"
    buf = buf + "        Mm[i] = b1 * Mm[i] + (1.0 - b1) * gi;\n"
    buf = buf + "        Vv[i] = b2 * Vv[i] + (1.0 - b2) * gi * gi;\n"
    buf = buf + "        double mhat = Mm[i] / bc1;\n"
    buf = buf + "        double vhat = Vv[i] / bc2;\n"
    buf = buf + "        // decoupled weight decay applied to the param directly.\n"
    buf = buf + "        P[i] -= lr * (mhat / (_hx_sqrt(vhat) + eps) + wd * P[i]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_void();\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + "// anima RFC 035 (2026-05-16): bf16/fp16 mixed-precision training.\n"
    buf = buf + "//\n"
    buf = buf + "// Layers on RFC 034. The forward/grad path still computes in\n"
    buf = buf + "// packed-double farr (the RFC 032/034 contract), but RFC 035 adds:\n"
    buf = buf + "//   (1) a bf16 storage round-trip (farr_to_bf16 / farr_from_bf16) so\n"
    buf = buf + "//       activations / a grad copy can be held at half the bytes, and\n"
    buf = buf + "//   (2) a loss-scaled, skip-on-nonfinite mixed-precision AdamW\n"
    buf = buf + "//       (adamw_step_mixed) keeping an f32-equivalent (double) master\n"
    buf = buf + "//       weight while consuming a possibly-bf16-rounded gradient.\n"
    buf = buf + "//\n"
    buf = buf + "// v1 scope (RFC 035 Non-goals mirror RFC 034): single-process, single-\n"
    buf = buf + "// arena, the anima HEXAD decoder train step. NaN/Inf-guarded loss\n"
    buf = buf + "// scaling is the only AMP policy (no dynamic scale schedule in v1 —\n"
    buf = buf + "// the caller drives the scale; the builtin reports skip via return).\n"
    buf = buf + "//\n"
    buf = buf + "// bf16 = the top 16 bits of an IEEE-754 binary32 (1s|8e|7m), round-to-\n"
    buf = buf + "// nearest-even on the truncated mantissa. The same rounding NVIDIA /\n"
    buf = buf + "// PyTorch AMP use; deterministic, no hardware bf16 needed.\n"
    buf = buf + "//\n"
    buf = buf + "// Falsifier coverage: tmp_rfc035_smoke.hexa\n"
    buf = buf + "//   F-RFC035-BUILD / BF16-ROUNDTRIP / LOSSSCALE-INVARIANT /\n"
    buf = buf + "//   SKIP-NONFINITE / DETERMINISM\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + "\n"
    buf = buf + "// Round an IEEE binary32 to bf16 (return the reconstructed float).\n"
    buf = buf + "// Round-to-nearest-even on bit 15 (the bf16 ulp). NaN/Inf preserved.\n"
    buf = buf + "static float _hx_f32_to_bf16(float f) {\n"
    buf = buf + "    uint32_t x;\n"
    buf = buf + "    hxlcl_memcpy(&x, &f, sizeof(x));\n"
    buf = buf + "    uint32_t exp = (x >> 23) & 0xFF;\n"
    buf = buf + "    if (exp == 0xFF) {            // NaN / Inf — keep, just truncate mantissa\n"
    buf = buf + "        uint32_t t = x & 0xFFFF0000u;\n"
    buf = buf + "        // keep NaN-ness: if it was NaN, ensure a non-zero bf16 mantissa\n"
    buf = buf + "        if ((x & 0x007FFFFFu) != 0) t |= 0x00400000u;\n"
    buf = buf + "        float r; hxlcl_memcpy(&r, &t, sizeof(r)); return r;\n"
    buf = buf + "    }\n"
    buf = buf + "    uint32_t lsb     = (x >> 16) & 1u;\n"
    buf = buf + "    uint32_t rounded = x + 0x7FFFu + lsb;   // round-to-nearest-even\n"
    buf = buf + "    rounded &= 0xFFFF0000u;\n"
    buf = buf + "    float r; hxlcl_memcpy(&r, &rounded, sizeof(r));\n"
    buf = buf + "    return r;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// farr_to_bf16(src, dst, n) — write bf16-rounded values of src[0..n]\n"
    buf = buf + "// into dst (both length-n packed-double farrs). dst holds the\n"
    buf = buf + "// reconstructed (lossy) doubles; storage-saving is conceptual at v1\n"
    buf = buf + "// (the arena is double) but the *values* are bit-exact bf16, which is\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// what training numerics care about. Returns 1 on success, 0 on error.\n"
    buf = buf + "HexaVal hexa_farr_to_bf16(HexaVal src_v, HexaVal dst_v, HexaVal n_v) {\n"
    buf = buf + "    int64_t s_id = hexa_as_num(src_v);\n"
    buf = buf + "    int64_t d_id = hexa_as_num(dst_v);\n"
    buf = buf + "    int64_t n    = hexa_as_num(n_v);\n"
    buf = buf + "    int64_t sl = 0, dl = 0;\n"
    buf = buf + "    double* S = _hx_ad_farr_buf(s_id, &sl);\n"
    buf = buf + "    double* D = _hx_ad_farr_buf(d_id, &dl);\n"
    buf = buf + "    if (!S || !D || n <= 0 || sl < n || dl < n) return hexa_int(0);\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++)\n"
    buf = buf + "        D[i] = (double)_hx_f32_to_bf16((float)S[i]);\n"
    buf = buf + "    return hexa_int(1);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// farr_from_bf16(src, dst, n) — round-trip the other direction. With\n"
    buf = buf + "// the v1 double arena this is the same bf16 reconstruction (identity\n"
    buf = buf + "// once a value is already bf16-representable: F-RFC035-BF16-ROUNDTRIP\n"
    buf = buf + "// asserts to_bf16 then from_bf16 is a fixed point).\n"
    buf = buf + "HexaVal hexa_farr_from_bf16(HexaVal src_v, HexaVal dst_v, HexaVal n_v) {\n"
    buf = buf + "    int64_t s_id = hexa_as_num(src_v);\n"
    buf = buf + "    int64_t d_id = hexa_as_num(dst_v);\n"
    buf = buf + "    int64_t n    = hexa_as_num(n_v);\n"
    buf = buf + "    int64_t sl = 0, dl = 0;\n"
    buf = buf + "    double* S = _hx_ad_farr_buf(s_id, &sl);\n"
    buf = buf + "    double* D = _hx_ad_farr_buf(d_id, &dl);\n"
    buf = buf + "    if (!S || !D || n <= 0 || sl < n || dl < n) return hexa_int(0);\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++)\n"
    buf = buf + "        D[i] = (double)_hx_f32_to_bf16((float)S[i]);\n"
    buf = buf + "    return hexa_int(1);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// adamw_step_mixed(param, grad, m, v, n, lr, b1, b2, eps, wd, t,\n"
    buf = buf + "//                  loss_scale) -> int\n"
    buf = buf + "// Loss-scaled mixed-precision AdamW. The gradient `grad` is assumed\n"
    buf = buf + "// produced from a loss multiplied by `loss_scale` (AMP convention);\n"
    buf = buf + "// it is unscaled (divided by loss_scale) before the moment update so\n"
    buf = buf + "// the master (double) weight sees the true gradient. If ANY unscaled\n"
    buf = buf + "// gradient element is non-finite (NaN/Inf — the AMP overflow signal),\n"
    buf = buf + "// the WHOLE step is skipped (params/moments untouched) and 0 is\n"
    buf = buf + "// returned (the caller then halves loss_scale, the standard policy).\n"
    buf = buf + "// Returns 1 if the step was applied. Master weight stays double; only\n"
    buf = buf + "// the *consumed gradient* is the (possibly bf16-rounded) low-precision\n"
    buf = buf + "// tensor — exactly the PyTorch AMP master-weight contract.\n"
    buf = buf + "HexaVal hexa_adamw_step_mixed(HexaVal p_v, HexaVal g_v, HexaVal m_v,\n"
    buf = buf + "                              HexaVal v_v, HexaVal n_v, HexaVal lr_v,\n"
    buf = buf + "                              HexaVal b1_v, HexaVal b2_v, HexaVal eps_v,\n"
    buf = buf + "                              HexaVal wd_v, HexaVal t_v, HexaVal ls_v) {\n"
    buf = buf + "    int64_t p_id = hexa_as_num(p_v);\n"
    buf = buf + "    int64_t g_id = hexa_as_num(g_v);\n"
    buf = buf + "    int64_t m_id = hexa_as_num(m_v);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    int64_t v_id = hexa_as_num(v_v);\n"
    buf = buf + "    int64_t n    = hexa_as_num(n_v);\n"
    buf = buf + "    double  lr   = __hx_to_double(lr_v);\n"
    buf = buf + "    double  b1   = __hx_to_double(b1_v);\n"
    buf = buf + "    double  b2   = __hx_to_double(b2_v);\n"
    buf = buf + "    double  eps  = __hx_to_double(eps_v);\n"
    buf = buf + "    double  wd   = __hx_to_double(wd_v);\n"
    buf = buf + "    int64_t tstep= hexa_as_num(t_v);\n"
    buf = buf + "    double  ls   = __hx_to_double(ls_v);\n"
    buf = buf + "    if (n <= 0 || tstep < 1) return hexa_int(0);\n"
    buf = buf + "    if (ls == 0.0) ls = 1.0;\n"
    buf = buf + "    double* P = _hx_ad_farr_buf(p_id, NULL);\n"
    buf = buf + "    double* G = _hx_ad_farr_buf(g_id, NULL);\n"
    buf = buf + "    double* Mm= _hx_ad_farr_buf(m_id, NULL);\n"
    buf = buf + "    double* Vv= _hx_ad_farr_buf(v_id, NULL);\n"
    buf = buf + "    if (!P || !G || !Mm || !Vv) return hexa_int(0);\n"
    buf = buf + "    // AMP overflow guard: scan the *unscaled* grad first; skip on any\n"
    buf = buf + "    // non-finite element (no partial mutation).\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        double gi = G[i] / ls;\n"
    buf = buf + "        if (!isfinite(gi)) return hexa_int(0);   // skip step (AMP overflow)\n"
    buf = buf + "    }\n"
    buf = buf + "    double bc1 = 1.0 - _hx_powi(b1, (long)tstep);\n"
    buf = buf + "    double bc2 = 1.0 - _hx_powi(b2, (long)tstep);\n"
    buf = buf + "    if (bc1 == 0.0) bc1 = 1e-30;\n"
    buf = buf + "    if (bc2 == 0.0) bc2 = 1e-30;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        double gi = G[i] / ls;            // unscale (AMP master grad)\n"
    buf = buf + "        Mm[i] = b1 * Mm[i] + (1.0 - b1) * gi;\n"
    buf = buf + "        Vv[i] = b2 * Vv[i] + (1.0 - b2) * gi * gi;\n"
    buf = buf + "        double mhat = Mm[i] / bc1;\n"
    buf = buf + "        double vhat = Vv[i] / bc2;\n"
    buf = buf + "        P[i] -= lr * (mhat / (_hx_sqrt(vhat) + eps) + wd * P[i]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int(1);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + "// anima RFC 036 (2026-05-16): phi_rs MI/Φ byte-equal native primitive.\n"
    buf = buf + "//\n"
    buf = buf + "// HONEST SCOPE (AGENTS.tape g3 / f2 — no over-claim):\n"
    buf = buf + "//   The anima `phi_rs` Rust crate\n"
    buf = buf + "//   (anima_clm_10_h100_sweep_laws_77_78/phi-rs) is a **PyO3 cdylib**\n"
    buf = buf + "//   (`crate-type=[\"cdylib\"]`, pyo3 extension-module). It exposes NO\n"
    buf = buf + "//   `extern \"C\"` / `#[no_mangle]` C ABI, so hexa-lang's existing\n"
    buf = buf + "//   static-FFI / dlsym path (`extern fn @symbol @link`) CANNOT bind it\n"
    buf = buf + "//   today. RFC 036 (a) specifies the Rust C-ABI shim that phi_rs must\n"
    buf = buf + "//   add, AND (b) lands a native C implementation of phi_rs's\n"
    buf = buf + "//   *documented deterministic numeric core* (`mi_from_paired_vectors`\n"
    buf = buf + "//   + the spatial-Φ pipeline steps 1-4) so the byte-equal harness can\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "//   run NOW against the formula. The actual Rust FFI link remains a\n"
    buf = buf + "//   NAMED BLOCKER until phi_rs ships the §\"FFI shim\" surface — this is\n"
    buf = buf + "//   stated explicitly in the RFC and NOT counted as a closed FFI.\n"
    buf = buf + "//\n"
    buf = buf + "// Byte-equal target = phi_rs src/lib.rs functions, replicated exactly:\n"
    buf = buf + "//   bin_values · entropy (1e-8 total smoothing + 1e-10 log smoothing)\n"
    buf = buf + "//   · mi_from_paired_vectors · total_mi · find_min_partition_exact\n"
    buf = buf + "//   · spatial_phi = (total − min_part)/(n−1)  [tensions/temporal=None]\n"
    buf = buf + "//\n"
    buf = buf + "// Falsifier coverage: tmp_rfc036_smoke.hexa\n"
    buf = buf + "//   F-RFC036-BUILD / MI-BYTE-EQUAL / PHI-SPATIAL / DETERMINISM /\n"
    buf = buf + "//   FFI-BLOCKER-DOCUMENTED (honest carve-out, NOT a PASS-claim)\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + "\n"
    buf = buf + "// phi_rs bin_values: min/max over the f32-cast row, range/n_bins width,\n"
    buf = buf + "// floor((v-min)/width) clamped to n_bins-1; all-identical → all bin 0.\n"
    buf = buf + "static void _hx_phi_bin_values(const double* v, int64_t n, int64_t nb,\n"
    buf = buf + "                               int* out) {\n"
    buf = buf + "    if (n <= 0) return;\n"
    buf = buf + "    float mn =  (float)v[0], mx = (float)v[0];\n"
    buf = buf + "    for (int64_t i = 1; i < n; i++) {\n"
    buf = buf + "        float f = (float)v[i];\n"
    buf = buf + "        if (f < mn) mn = f;\n"
    buf = buf + "        if (f > mx) mx = f;\n"
    buf = buf + "    }\n"
    buf = buf + "    float range = mx - mn;\n"
    buf = buf + "    // f32::EPSILON (IEEE binary32 ulp at 1.0) — literal so we need no\n"
    buf = buf + "    // <float.h> include (matches Rust phi_rs `f32::EPSILON` exactly).\n"
    buf = buf + "    const float _flt_eps = 1.19209290e-7f;\n"
    buf = buf + "    if (range < _flt_eps) { for (int64_t i = 0; i < n; i++) out[i] = 0; return; }\n"
    buf = buf + "    float bw = range / (float)nb;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        int b = (int)(((float)v[i] - mn) / bw);   // truncation = Rust `as usize`\n"
    buf = buf + "        if (b > (int)nb - 1) b = (int)nb - 1;\n"
    buf = buf + "        if (b < 0) b = 0;\n"
    buf = buf + "        out[i] = b;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// phi_rs entropy: t = total + 1e-8 ; Σ -p·log2(p + 1e-10), ALL bins.\n"
    buf = buf + "static double _hx_phi_entropy(const uint32_t* counts, int64_t k,\n"
    buf = buf + "                              uint32_t total) {\n"
    buf = buf + "    if (total == 0) return 0.0;\n"
    buf = buf + "    double t = (double)total + 1e-8;\n"
    buf = buf + "    double s = 0.0;\n"
    buf = buf + "    for (int64_t i = 0; i < k; i++) {\n"
    buf = buf + "        double p = (double)counts[i] / t;\n"
    buf = buf + "        s += -p * (hxlcl_log(p + 1e-10) / hxlcl_log(2.0));   // log2 via natural log\n"
    buf = buf + "    }\n"
    buf = buf + "    return s;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// phi_rs mi_from_paired_vectors — exact replica.\n"
    buf = buf + "// MI = max(H(A) + H(B) − H(A,B), 0).\n"
    buf = buf + "static double _hx_phi_mi_pair(const double* a, const double* b,\n"
    buf = buf + "                              int64_t n, int64_t nb) {\n"
    buf = buf + "    if (n <= 0) return 0.0;\n"
    buf = buf + "    int*      ba = (int*)malloc((size_t)n * sizeof(int));\n"
    buf = buf + "    int*      bb = (int*)malloc((size_t)n * sizeof(int));\n"
    buf = buf + "    uint32_t* ca = (uint32_t*)calloc((size_t)nb, sizeof(uint32_t));\n"
    buf = buf + "    uint32_t* cb = (uint32_t*)calloc((size_t)nb, sizeof(uint32_t));\n"
    buf = buf + "    uint32_t* jo = (uint32_t*)calloc((size_t)(nb * nb), sizeof(uint32_t));\n"
    buf = buf + "    if (!ba || !bb || !ca || !cb || !jo) {\n"
    buf = buf + "        free(ba); free(bb); free(ca); free(cb); free(jo);\n"
    buf = buf + "        return 0.0;\n"
    buf = buf + "    }\n"
    buf = buf + "    _hx_phi_bin_values(a, n, nb, ba);\n"
    buf = buf + "    _hx_phi_bin_values(b, n, nb, bb);\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        ca[ba[i]]++;\n"
    buf = buf + "        cb[bb[i]]++;\n"
    buf = buf + "        jo[(int64_t)ba[i] * nb + bb[i]]++;\n"
    buf = buf + "    }\n"
    buf = buf + "    uint32_t total = (uint32_t)n;\n"
    buf = buf + "    double hA  = _hx_phi_entropy(ca, nb,      total);\n"
    buf = buf + "    double hB  = _hx_phi_entropy(cb, nb,      total);\n"
    buf = buf + "    double hAB = _hx_phi_entropy(jo, nb * nb, total);\n"
    buf = buf + "    free(ba); free(bb); free(ca); free(cb); free(jo);\n"
    buf = buf + "    double mi = hA + hB - hAB;\n"
    buf = buf + "    return mi > 0.0 ? mi : 0.0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// phi_mi_pair(a_farr, b_farr, n, n_bins) -> float.\n"
    buf = buf + "// Byte-equal to phi_rs::mi_from_paired_vectors(a, b, n_bins).\n"
    buf = buf + "HexaVal hexa_phi_mi_pair(HexaVal a_v, HexaVal b_v, HexaVal n_v,\n"
    buf = buf + "                         HexaVal nb_v) {\n"
    buf = buf + "    int64_t a_id = hexa_as_num(a_v);\n"
    buf = buf + "    int64_t b_id = hexa_as_num(b_v);\n"
    buf = buf + "    int64_t n    = hexa_as_num(n_v);\n"
    buf = buf + "    int64_t nb   = hexa_as_num(nb_v);\n"
    buf = buf + "    int64_t al = 0, bl = 0;\n"
    buf = buf + "    double* A = _hx_ad_farr_buf(a_id, &al);\n"
    buf = buf + "    double* B = _hx_ad_farr_buf(b_id, &bl);\n"
    buf = buf + "    if (!A || !B || n <= 0 || nb <= 0 || al < n || bl < n)\n"
    buf = buf + "        return hexa_float(0.0);\n"
    buf = buf + "    return hexa_float(_hx_phi_mi_pair(A, B, n, nb));\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// phi_spatial(states_farr, n_cells, dim, n_bins) -> float.\n"
    buf = buf + "// Byte-equal to phi_rs::compute_phi_inner spatial component with\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// tensions=None, prev/curr=None (⟹ temporal_phi=0, complexity uses\n"
    buf = buf + "// std-of-row-sums but the SPATIAL Φ this builtin returns is the\n"
    buf = buf + "// step-4 value the anima HEXAD Phase 4 ratchet consumes):\n"
    buf = buf + "//   spatial = max(total_mi − min_partition_mi, 0) / max(n−1, 1)\n"
    buf = buf + "// states_farr is row-major n_cells × dim. Exhaustive bipartition\n"
    buf = buf + "// (cell 0 pinned to A) for n_cells ≤ 20 — phi_rs find_min_partition_exact.\n"
    buf = buf + "HexaVal hexa_phi_spatial(HexaVal st_v, HexaVal nc_v, HexaVal dim_v,\n"
    buf = buf + "                         HexaVal nb_v) {\n"
    buf = buf + "    int64_t s_id = hexa_as_num(st_v);\n"
    buf = buf + "    int64_t nc   = hexa_as_num(nc_v);\n"
    buf = buf + "    int64_t dim  = hexa_as_num(dim_v);\n"
    buf = buf + "    int64_t nb   = hexa_as_num(nb_v);\n"
    buf = buf + "    int64_t sl = 0;\n"
    buf = buf + "    double* S = _hx_ad_farr_buf(s_id, &sl);\n"
    buf = buf + "    if (!S || nc <= 0 || dim <= 0 || nb <= 0 || sl < nc * dim)\n"
    buf = buf + "        return hexa_float(0.0);\n"
    buf = buf + "    if (nc <= 1) return hexa_float(0.0);\n"
    buf = buf + "    // Step 1-2: pairwise MI matrix + total MI (upper triangle).\n"
    buf = buf + "    double* mi = (double*)calloc((size_t)(nc * nc), sizeof(double));\n"
    buf = buf + "    if (!mi) return hexa_float(0.0);\n"
    buf = buf + "    double total = 0.0;\n"
    buf = buf + "    for (int64_t i = 0; i < nc; i++) {\n"
    buf = buf + "        for (int64_t j = i + 1; j < nc; j++) {\n"
    buf = buf + "            double v = _hx_phi_mi_pair(S + i * dim, S + j * dim, dim, nb);\n"
    buf = buf + "            mi[i * nc + j] = v;\n"
    buf = buf + "            mi[j * nc + i] = v;\n"
    buf = buf + "            total += v;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    // Step 3: minimum information partition (cell 0 pinned to A).\n"
    buf = buf + "    double min_part;\n"
    buf = buf + "    if (nc == 2) {\n"
    buf = buf + "        min_part = mi[0 * nc + 1];\n"
    buf = buf + "    } else if (nc <= 20) {\n"
    buf = buf + "        min_part = INFINITY;\n"
    buf = buf + "        uint64_t max_mask = (uint64_t)1 << (nc - 1);\n"
    buf = buf + "        for (uint64_t mask = 1; mask < max_mask; mask++) {\n"
    buf = buf + "            // partition: cell 0 in A; bit b → cell b+1 in A iff set.\n"
    buf = buf + "            int any_b = 0;\n"
    buf = buf + "            for (int64_t b = 0; b < nc - 1; b++)\n"
    buf = buf + "                if (!(mask & ((uint64_t)1 << b))) { any_b = 1; break; }\n"
    buf = buf + "            if (!any_b) continue;        // skip trivial (B empty)\n"
    buf = buf + "            double cross = 0.0;\n"
    buf = buf + "            // A = {0} ∪ {b+1 : bit b set}; B = complement.\n"
    buf = buf + "            for (int64_t ia = 0; ia < nc; ia++) {\n"
    buf = buf + "                int inA = (ia == 0) ? 1\n"
    buf = buf + "                          : ((mask & ((uint64_t)1 << (ia - 1))) ? 1 : 0);\n"
    buf = buf + "                if (!inA) continue;\n"
    buf = buf + "                for (int64_t jb = 0; jb < nc; jb++) {\n"
    buf = buf + "                    int jInA = (jb == 0) ? 1\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "                               : ((mask & ((uint64_t)1 << (jb - 1))) ? 1 : 0);\n"
    buf = buf + "                    if (jInA) continue;          // jb ∈ B only\n"
    buf = buf + "                    cross += mi[ia * nc + jb];\n"
    buf = buf + "                }\n"
    buf = buf + "            }\n"
    buf = buf + "            if (cross < min_part) min_part = cross;\n"
    buf = buf + "        }\n"
    buf = buf + "    } else {\n"
    buf = buf + "        // phi_rs greedy path (N>20) — out of v1 falsifier scope; the\n"
    buf = buf + "        // anima HEXAD pool is small (≤ 64 but Phase-4 Φ slices ≤ 20).\n"
    buf = buf + "        min_part = 0.0;\n"
    buf = buf + "    }\n"
    buf = buf + "    free(mi);\n"
    buf = buf + "    // Step 4: spatial Φ.\n"
    buf = buf + "    double n = (double)nc;\n"
    buf = buf + "    double denom = (n - 1.0) > 1.0 ? (n - 1.0) : 1.0;\n"
    buf = buf + "    double sp = total - min_part;\n"
    buf = buf + "    if (sp < 0.0) sp = 0.0;\n"
    buf = buf + "    return hexa_float(sp / denom);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + "// anima RFC 040 (2026-05-16): farr GPU/CUDA backend — Phase A scaffolding.\n"
    buf = buf + "//\n"
    buf = buf + "// Scaffolding only. The HexaFarrEntry residence descriptor (FarrLoc /\n"
    buf = buf + "// d_buf / dirty_host / dirty_dev) lives in the table struct (top of\n"
    buf = buf + "// the farr section); the device-management + GPU compute builtins are\n"
    buf = buf + "// declared in runtime.h. THIS BLOCK provides their *bodies*.\n"
    buf = buf + "//\n"
    buf = buf + "// The default build has NO `-DHEXA_CUDA` defined. Every body below\n"
    buf = buf + "// then takes the CPU-fallback branch:\n"
    buf = buf + "//   • cuda_available() → 0\n"
    buf = buf + "//   • cuda_device_count() → 0\n"
    buf = buf + "//   • farr_to_device / farr_to_host / farr_pin → no-op success\n"
    buf = buf + "//   • farr_device_free → no-op success\n"
    buf = buf + "//   • farr_matmul_gpu → routes to RFC 032 hexa_farr_matmul (the CPU\n"
    buf = buf + "//     oracle). This makes the GPU dispatcher safe-to-call on Mac —\n"
    buf = buf + "//     callers get the bit-exact CPU result with the same -1-on-error\n"
    buf = buf + "//     contract, the equivalence harness PASSES, and nothing changes\n"
    buf = buf + "//     for the byte-identical no-CUDA build.\n"
    buf = buf + "//\n"
    buf = buf + "// With `-DHEXA_CUDA` defined, the same bodies route to the real cuBLAS\n"
    buf = buf + "// Dgemm + cudaMalloc/cudaMemcpy path in self/cuda/runtime_cuda.c\n"
    buf = buf + "// (LANDED 2026-05-17, Phase 4-D-5-1 wiring scaffold). Phase A surface\n"
    buf = buf + "// wired:\n"
    buf = buf + "//   • hexa_cuda_available     → _hx_cuda_runtime_available\n"
    buf = buf + "//   • hexa_cuda_device_count  → _hx_cuda_device_count_impl\n"
    buf = buf + "//   • hexa_farr_to_device     → _hx_cuda_farr_to_device   (H2D)\n"
    buf = buf + "//   • hexa_farr_to_host       → _hx_cuda_farr_to_host     (D2H)\n"
    buf = buf + "//   • hexa_farr_device_free   → _hx_cuda_farr_device_free (cudaFree)\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "//   • hexa_farr_matmul_gpu    → _hx_cuda_farr_matmul_gpu  (cuBLAS Dgemm)\n"
    buf = buf + "//   • hexa_farr_free (line 8307) → _hx_cuda_farr_device_free (cudaFree-on-free)\n"
    buf = buf + "// Phase B / B2 GPU bodies (softmax_rows, rmsnorm_rows, add, scale,\n"
    buf = buf + "// matmul_t, outer, mul, silu, silu_grad, rmsnorm_bwd_rows, adamw_step)\n"
    buf = buf + "// remain TODO[cuda] stubs returning -1 — honest no-fake-PASS per\n"
    buf = buf + "// AGENTS.tape g3 / RFC 040 §\"Honest caveats\". Their CUDA bodies\n"
    buf = buf + "// (`__global__` kernels + warp-shuffle reductions) are the next-cycle\n"
    buf = buf + "// deliverable; see stdlib/flame/PHASE4D5_1_WIRING_NOTES.md.\n"
    buf = buf + "//\n"
    buf = buf + "// Phase A falsifier surface (tmp_rfc040_smoke.hexa):\n"
    buf = buf + "//   F-RFC040-AVAIL              cuda_available()==0 on Mac (graceful)\n"
    buf = buf + "//   F-RFC040-STRUCT-NOREGRESS   existing CPU farr_matmul unchanged\n"
    buf = buf + "//   F-RFC040-DISPATCH-FALLBACK  farr_matmul_gpu == farr_matmul (CPU)\n"
    buf = buf + "//   F-RFC040-DETERMINISM        re-eval byte-identical\n"
    buf = buf + "//   F-RFC040-CUDA-BLOCKER-DOC   honest carve-out (CUDA kernels = next cycle)\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + "\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "/* Forward decls for the GPU compilation unit (TODO[cuda] — bodies live\n"
    buf = buf + " * in a separate .cu file linked in by the CUDA build). NOT defined in\n"
    buf = buf + " * the no-CUDA build, so the `#ifndef HEXA_CUDA` fallbacks below are\n"
    buf = buf + " * the entire compiled surface today. */\n"
    buf = buf + "extern int  _hx_cuda_runtime_available(void);\n"
    buf = buf + "extern int  _hx_cuda_device_count_impl(void);\n"
    buf = buf + "extern int  _hx_cuda_farr_to_device(int64_t farr_id);\n"
    buf = buf + "extern int  _hx_cuda_farr_to_host(int64_t farr_id);\n"
    buf = buf + "extern int  _hx_cuda_farr_device_free(int64_t farr_id);\n"
    buf = buf + "extern int  _hx_cuda_farr_matmul_gpu(int64_t a_id, int64_t M, int64_t K,\n"
    buf = buf + "                                     int64_t b_id, int64_t N,\n"
    buf = buf + "                                     int64_t c_id);\n"
    buf = buf + "/* RFC 056 Phase 1 — residence contract + sub-view API. */\n"
    buf = buf + "extern int  _hx_cuda_set_out_disposition(int d);\n"
    buf = buf + "extern int  _hx_cuda_farr_dev_view(int64_t base_id, int64_t offset,\n"
    buf = buf + "                                    int64_t len, int64_t view_id);\n"
    buf = buf + "extern int  _hx_cuda_farr_pin_device(int64_t farr_id);\n"
    buf = buf + "extern int  _hx_cuda_farr_unpin_device(int64_t farr_id);\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "/* RFC 056 §6.4 disposition constants — exposed to flame's A2 primitive\n"
    buf = buf + " * (host C, no flame public API change — g_flame_api_fixed). */\n"
    buf = buf + "#define HEXA_FORGE_OUT_HOST_NOW    0\n"
    buf = buf + "#define HEXA_FORGE_OUT_DEVICE_KEEP 1\n"
    buf = buf + "\n"
    buf = buf + "// cuda_available() -> int. 1 if a CUDA device + toolkit are detected at\n"
    buf = buf + "// runtime, else 0. Coherent with cuda_device_count(): one implies the\n"
    buf = buf + "// other > 0.\n"
    buf = buf + "\n"
    buf = buf + "// cuda_device_count() -> int. Number of visible GPUs (0 if none / no\n"
    buf = buf + "// CUDA toolkit). Returns 0 on the no-CUDA build always.\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// farr_to_device(id) -> int. Ensure d_buf is resident + current.\n"
    buf = buf + "// CPU-fallback path: every farr is loc=FARR_HOST already; the call is a\n"
    buf = buf + "// no-op success (return 1). This keeps caller code valid on Mac — a\n"
    buf = buf + "// d_train5 hot-loop `let _ = farr_to_device(W)` becomes inert when no\n"
    buf = buf + "// GPU is available, instead of failing the call.\n"
    buf = buf + "// Returns: 1 ok / 0 invalid handle / -1 GPU op failed.\n"
    buf = buf + "HexaVal hexa_farr_to_device(HexaVal h_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_farr_count) return hexa_int(0);\n"
    buf = buf + "    HexaFarrEntry* e = &_hx_farr_table[id];\n"
    buf = buf + "    if (!e->buf && e->loc == FARR_HOST) return hexa_int(0);\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "    return hexa_int(_hx_cuda_farr_to_device(id));\n"
    buf = buf + "#else\n"
    buf = buf + "    /* No-CUDA path: farr already host-resident; nothing to transfer.\n"
    buf = buf + "     * The dispatcher contract: caller continues to use the same\n"
    buf = buf + "     * handle, math runs on CPU. */\n"
    buf = buf + "    return hexa_int(1);\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// farr_to_host(id) -> int. Ensure host buf is current (D2H if device-\n"
    buf = buf + "// resident and dirty). CPU-fallback path: no-op success.\n"
    buf = buf + "HexaVal hexa_farr_to_host(HexaVal h_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_farr_count) return hexa_int(0);\n"
    buf = buf + "    HexaFarrEntry* e = &_hx_farr_table[id];\n"
    buf = buf + "    if (!e->buf && e->loc == FARR_HOST) return hexa_int(0);\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "    return hexa_int(_hx_cuda_farr_to_host(id));\n"
    buf = buf + "#else\n"
    buf = buf + "    return hexa_int(1);\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// farr_pin(id) -> int. Mark farr resident-on-device, do not auto-evict\n"
    buf = buf + "// (weights stay across all steps). CPU-fallback: records pinned flag\n"
    buf = buf + "// only (no actual residence change, since no device exists).\n"
    buf = buf + "HexaVal hexa_farr_pin(HexaVal h_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_farr_count) return hexa_int(0);\n"
    buf = buf + "    HexaFarrEntry* e = &_hx_farr_table[id];\n"
    buf = buf + "    e->pinned = 1;\n"
    buf = buf + "    return hexa_int(1);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ── RFC 056 Phase 1 — device residence contract + sub-view API ──────\n"
    buf = buf + "//\n"
    buf = buf + "// All four are no-op-safe on the no-CUDA Mac build (return success / a\n"
    buf = buf + "// CPU-equivalent handle) so flame's A2 primitive stays callable without\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// a GPU — exactly the RFC 040 dispatcher contract + §8.3 backward-safe.\n"
    buf = buf + "\n"
    buf = buf + "// farr_set_out_disposition(d) -> int (previous disposition).\n"
    buf = buf + "//   d = 1 (FORGE_OUT_DEVICE_KEEP): the *next* forge `_gpu` op defers its\n"
    buf = buf + "//       D2H — output stays device-resident for the following GPU op.\n"
    buf = buf + "//   d = 0 (FORGE_OUT_HOST_NOW, DEFAULT): D2H now (== pre-RFC-056).\n"
    buf = buf + "// No-CUDA: inert (returns 0); every op is CPU so disposition is moot.\n"
    buf = buf + "HexaVal hexa_farr_set_out_disposition(HexaVal d_v) {\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "    return hexa_int(_hx_cuda_set_out_disposition((int)hexa_as_num(d_v)));\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)d_v;\n"
    buf = buf + "    return hexa_int(0);\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// farr_dev_view(base, offset, len) -> int view_farr_id (-1 on error).\n"
    buf = buf + "// RFC 056 §6.2 non-owning device sub-view: view.d_buf = base.d_buf +\n"
    buf = buf + "// offset*8, shares base residence. The caller must device-pin `base`\n"
    buf = buf + "// first. A fresh host handle is allocated to carry the view id (its\n"
    buf = buf + "// host buf is unused — device bytes are the base's). Out-of-range →\n"
    buf = buf + "// the view handle is freed and -1 returned (no UB; F-RFC056-VIEW-SAFETY).\n"
    buf = buf + "// No-CUDA fallback: returns a real CPU farr that is a *copy* of the\n"
    buf = buf + "// slice (byte-eq with the resident path's logical contents — the only\n"
    buf = buf + "// correct answer without a device), so flame code stays valid on Mac.\n"
    buf = buf + "HexaVal hexa_farr_dev_view(HexaVal base_v, HexaVal off_v, HexaVal len_v) {\n"
    buf = buf + "    int64_t base_id = hexa_as_num(base_v);\n"
    buf = buf + "    int64_t offset  = hexa_as_num(off_v);\n"
    buf = buf + "    int64_t len     = hexa_as_num(len_v);\n"
    buf = buf + "    if (base_id < 0 || base_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (offset < 0 || len <= 0) return hexa_int(-1);\n"
    buf = buf + "    HexaFarrEntry* be = &_hx_farr_table[base_id];\n"
    buf = buf + "    if (offset + len > be->len) return hexa_int(-1);\n"
    buf = buf + "    HexaVal vh = hexa_farr_zeros(hexa_int(len));\n"
    buf = buf + "    int64_t view_id = hexa_as_num(vh);\n"
    buf = buf + "    if (view_id < 0) return hexa_int(-1);\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "    if (_hx_cuda_farr_dev_view(base_id, offset, len, view_id) != 0) {\n"
    buf = buf + "        (void)hexa_farr_free(hexa_int(view_id));\n"
    buf = buf + "        return hexa_int(-1);\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int(view_id);\n"
    buf = buf + "#else\n"
    buf = buf + "    /* No-CUDA: materialise the slice as a real CPU farr (copy). This is\n"
    buf = buf + "     * byte-eq with what the resident device view logically holds — the\n"
    buf = buf + "     * only correct CPU answer; keeps flame valid on Mac. RE-FETCH be\n"
    buf = buf + "     * after hexa_farr_zeros (table may have realloc'd). */\n"
    buf = buf + "    be = &_hx_farr_table[base_id];\n"
    buf = buf + "    HexaFarrEntry* ve = &_hx_farr_table[view_id];\n"
    buf = buf + "    if (be->buf && ve->buf) {\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        for (int64_t i = 0; i < len; i++) ve->buf[i] = be->buf[offset + i];\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int(view_id);\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// farr_pin_device(id) -> int (1 ok / -1 err). RFC 056 §6.3: force the\n"
    buf = buf + "// farr device-resident (H2D once) + mark non-evictable. No-CUDA: just\n"
    buf = buf + "// records the pinned flag (== hexa_farr_pin; no device exists).\n"
    buf = buf + "HexaVal hexa_farr_pin_device(HexaVal h_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "    return hexa_int(_hx_cuda_farr_pin_device(id));\n"
    buf = buf + "#else\n"
    buf = buf + "    _hx_farr_table[id].pinned = 1;\n"
    buf = buf + "    return hexa_int(1);\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// farr_unpin_device(id) -> int. RFC 056 §6.3: clear the pin; D2H if the\n"
    buf = buf + "// device copy is dirty. No-CUDA: clears the flag (no device).\n"
    buf = buf + "HexaVal hexa_farr_unpin_device(HexaVal h_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "    return hexa_int(_hx_cuda_farr_unpin_device(id));\n"
    buf = buf + "#else\n"
    buf = buf + "    _hx_farr_table[id].pinned = 0;\n"
    buf = buf + "    return hexa_int(1);\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// farr_device_free(id) -> int. Free d_buf, keep host buf. CPU-fallback:\n"
    buf = buf + "// no-op success (d_buf is always NULL on no-CUDA).\n"
    buf = buf + "HexaVal hexa_farr_device_free(HexaVal h_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_farr_count) return hexa_int(0);\n"
    buf = buf + "    HexaFarrEntry* e = &_hx_farr_table[id];\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "    (void)e;\n"
    buf = buf + "    return hexa_int(_hx_cuda_farr_device_free(id));\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)e;\n"
    buf = buf + "    return hexa_int(1);\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// farr_matmul_gpu(A, Ar, Ac, B, Bc) -> int. ABI-identical to the RFC 032\n"
    buf = buf + "// CPU farr_matmul: same shape contract (A is M×K, B is K×N, output is\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// M×N), same -1-on-error return, same packed-double representation.\n"
    buf = buf + "// On the no-CUDA build: routes directly to hexa_farr_matmul — the CPU\n"
    buf = buf + "// oracle is the only correct numeric answer, and the dispatcher remains\n"
    buf = buf + "// safely callable. On the HEXA_CUDA build: enforces device-residency\n"
    buf = buf + "// and runs cuBLAS Dgemm via _hx_cuda_farr_matmul_gpu in\n"
    buf = buf + "// self/cuda/runtime_cuda.c (LANDED — Phase 4-D-5-1 wire-up; fp64 strict\n"
    buf = buf + "// Dgemm, no Tensor Core flip; row-major mapped via C^T = B^T · A^T).\n"
    buf = buf + "HexaVal hexa_farr_matmul_gpu(HexaVal a_v, HexaVal ar_v, HexaVal ac_v,\n"
    buf = buf + "                             HexaVal b_v, HexaVal bc_v) {\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "    /* RFC 040 Phase A real impl (2026-05-16): cuBLAS Dgemm path via\n"
    buf = buf + "     * runtime_cuda.c TU. Shape: A is M×K row-major, B is K×N row-major,\n"
    buf = buf + "     * C is M×N row-major.\n"
    buf = buf + "     *   M = ar (rows of A); K = ac (cols of A = rows of B); N = bc (cols of B).\n"
    buf = buf + "     * Allocate a fresh host C farr (len M·N); the runtime_cuda.c TU\n"
    buf = buf + "     * uploads A,B H2D (idempotent), runs Dgemm device-side, copies C\n"
    buf = buf + "     * D2H so the host caller sees the result.\n"
    buf = buf + "     * Returns C farr_id (≥0) on success, -1 on error. */\n"
    buf = buf + "    int64_t M = hexa_as_num(ar_v);\n"
    buf = buf + "    int64_t K = hexa_as_num(ac_v);\n"
    buf = buf + "    int64_t N = hexa_as_num(bc_v);\n"
    buf = buf + "    int64_t a_id = hexa_as_num(a_v);\n"
    buf = buf + "    int64_t b_id = hexa_as_num(b_v);\n"
    buf = buf + "    if (M <= 0 || K <= 0 || N <= 0) return hexa_int(-1);\n"
    buf = buf + "    if (a_id < 0 || a_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (b_id < 0 || b_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    HexaVal c_h = hexa_farr_zeros(hexa_int(M * N));\n"
    buf = buf + "    int64_t c_id = hexa_as_num(c_h);\n"
    buf = buf + "    if (c_id < 0) return hexa_int(-1);\n"
    buf = buf + "    int rc = _hx_cuda_farr_matmul_gpu(a_id, M, K, b_id, N, c_id);\n"
    buf = buf + "    if (rc != 0) return hexa_int(-1);\n"
    buf = buf + "    return hexa_int(c_id);\n"
    buf = buf + "#else\n"
    buf = buf + "    /* No-CUDA build: dispatcher routes to the RFC 032 CPU op. This is\n"
    buf = buf + "     * the equivalence harness's POSITIVE branch — proves the dispatcher\n"
    buf = buf + "     * wires correctly and the math contract is preserved. */\n"
    buf = buf + "    return hexa_farr_matmul(a_v, ar_v, ac_v, b_v, bc_v);\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ── Callable shims (≤4-arg `hexa_callN(<carrier>,…)` + 5-arg bare) ─────\n"
    buf = buf + "// hexat codegen's generic fallback lowers `cuda_available()` etc. to\n"
    buf = buf + "// `hexa_call0(cuda_available)` (and 1-arg → `hexa_call1(name, ...)`),\n"
    buf = buf + "// which needs a visible HexaVal carrier with that exact identifier.\n"
    buf = buf + "// `farr_matmul_gpu` (5-arg, past the hexa_callN ceiling) gets a bare-\n"
    buf = buf + "// function direct C call, which the static-inline wrapper below\n"
    buf = buf + "// satisfies. Same dispatch contract as RFC 032 farr_matmul + RFC 034\n"
    buf = buf + "// ad_matmul + RFC 035 adamw_step_mixed.\n"
    buf = buf + "HexaVal cuda_available;\n"
    buf = buf + "HexaVal cuda_device_count;\n"
    buf = buf + "// #4214 forge determinism API carriers — set_deterministic/is_deterministic\n"
    buf = buf + "// are HexaVal-ABI builtins (hexa_call1/0 dispatch · mirror cuda_available), NOT\n"
    buf = buf + "// extern-fn FFI, which avoids the runtime.h C-ABI hexa_forge_set_deterministic\n"
    buf = buf + "// (void(int)) name collision the FFI dlsym wrapper would create.\n"
    buf = buf + "HexaVal set_deterministic;\n"
    buf = buf + "HexaVal is_deterministic;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "HexaVal farr_to_device;\n"
    buf = buf + "HexaVal farr_to_host;\n"
    buf = buf + "HexaVal farr_pin;\n"
    buf = buf + "HexaVal farr_device_free;\n"
    buf = buf + "/* RFC 056 Phase 1 carriers (≤4-arg → hexa_callN dispatch). */\n"
    buf = buf + "HexaVal farr_set_out_disposition;\n"
    buf = buf + "HexaVal farr_dev_view;\n"
    buf = buf + "HexaVal farr_pin_device;\n"
    buf = buf + "HexaVal farr_unpin_device;\n"
    buf = buf + "static inline HexaVal farr_matmul_gpu_impl(HexaVal a, HexaVal ar, HexaVal ac,\n"
    buf = buf + "                                           HexaVal b, HexaVal bc) {\n"
    buf = buf + "    return hexa_farr_matmul_gpu(a, ar, ac, b, bc);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal farr_matmul_gpu(HexaVal a, HexaVal ar, HexaVal ac,\n"
    buf = buf + "                        HexaVal b, HexaVal bc) {\n"
    buf = buf + "    return farr_matmul_gpu_impl(a, ar, ac, b, bc);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + "// anima RFC 040 Phase B (2026-05-16): remaining farr GPU/CUDA ops —\n"
    buf = buf + "// scaffolding only (Mac, no CUDA hardware needed).\n"
    buf = buf + "//\n"
    buf = buf + "// Same `#ifdef HEXA_CUDA` / `#ifndef HEXA_CUDA` dispatch pattern as\n"
    buf = buf + "// Phase A. Each `*_gpu` op on the no-CUDA build routes to a SMALL\n"
    buf = buf + "// new CPU helper (no pre-existing farr equivalent for these row/\n"
    buf = buf + "// elementwise ops in the runtime today). On the HEXA_CUDA build the\n"
    buf = buf + "// bodies are TODO[cuda] stubs returning -1 (honest no-fake-PASS, per\n"
    buf = buf + "// AGENTS.tape g3). Real GPU `__global__` kernels = next-cycle\n"
    buf = buf + "// deliverable on a CUDA host (vast.ai/runpod).\n"
    buf = buf + "//\n"
    buf = buf + "// Ops landed in Phase B (per RFC 040 §\"Hot-path op survey\" subset):\n"
    buf = buf + "//   farr_softmax_rows_gpu   row-wise numerically-stable softmax\n"
    buf = buf + "//   farr_rmsnorm_rows_gpu   row-wise RMSNorm (mean(x²) + eps)\n"
    buf = buf + "//   farr_add_gpu            elementwise C = A + B\n"
    buf = buf + "//   farr_scale_gpu          elementwise Y = α · X\n"
    buf = buf + "//\n"
    buf = buf + "// Falsifier surface (tmp_rfc040_phaseB_smoke.hexa):\n"
    buf = buf + "//   F-RFC040B-SOFTMAX-EQ    softmax_gpu == CPU helper (byte-equal)\n"
    buf = buf + "//   F-RFC040B-RMSNORM-EQ    rmsnorm_gpu == CPU helper (byte-equal)\n"
    buf = buf + "//   F-RFC040B-ADD-EQ        add_gpu == elementwise A+B (byte-equal)\n"
    buf = buf + "//   F-RFC040B-SCALE-EQ      scale_gpu == α·X (byte-equal)\n"
    buf = buf + "//   F-RFC040B-DETERMINISM   re-run byte-identical for each op\n"
    buf = buf + "//   F-RFC040B-CUDA-BLOCKER  honest carve-out (CUDA kernels = next cycle)\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + "\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "/* Forward decls for the Phase B GPU compilation unit (TODO[cuda] —\n"
    buf = buf + " * bodies live in the same .cu file as Phase A on the CUDA host build).\n"
    buf = buf + " * NOT defined in the no-CUDA build. */\n"
    buf = buf + "extern int  _hx_cuda_farr_softmax_rows_gpu(int64_t x_id, int64_t R,\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "                                           int64_t C, int64_t out_id);\n"
    buf = buf + "extern int  _hx_cuda_farr_rmsnorm_rows_gpu(int64_t x_id, int64_t R,\n"
    buf = buf + "                                           int64_t C, double eps,\n"
    buf = buf + "                                           int64_t out_id);\n"
    buf = buf + "extern int  _hx_cuda_farr_add_gpu(int64_t a_id, int64_t b_id,\n"
    buf = buf + "                                  int64_t n, int64_t out_id);\n"
    buf = buf + "extern int  _hx_cuda_farr_scale_gpu(int64_t x_id, double alpha,\n"
    buf = buf + "                                    int64_t n, int64_t out_id);\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// ── CPU helpers (Phase B no-CUDA fallback path). ──────────────────\n"
    buf = buf + "// These are SMALL NEW helpers — there is no pre-existing single-op\n"
    buf = buf + "// farr_softmax / farr_rmsnorm / farr_add / farr_scale in the runtime\n"
    buf = buf + "// today (the ad_softmax_cross_entropy op fuses softmax+CE+grad; it is\n"
    buf = buf + "// loss-coupled and unsuited as a row-softmax-only kernel). Each helper\n"
    buf = buf + "// (a) allocates a fresh output farr via hexa_farr_zeros, (b) re-fetches\n"
    buf = buf + "// entry pointers post-alloc (per the RFC 032 use-after-realloc guard at\n"
    buf = buf + "// line 9580), (c) computes the math in-place in the output buffer.\n"
    buf = buf + "\n"
    buf = buf + "// _hx_farr_softmax_rows_cpu(x, R, C) -> new farr_id. Numerically-stable\n"
    buf = buf + "// row-softmax (subtract row max before exp). -1 on err.\n"
    buf = buf + "static int64_t _hx_farr_softmax_rows_cpu(int64_t x_id, int64_t R, int64_t C) {\n"
    buf = buf + "    if (x_id < 0 || x_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (R <= 0 || C <= 0)                    return -1;\n"
    buf = buf + "    HexaFarrEntry* xe = &_hx_farr_table[x_id];\n"
    buf = buf + "    if (!xe->buf || xe->len < R * C)         return -1;\n"
    buf = buf + "    HexaVal out_h = hexa_farr_zeros(hexa_int(R * C));\n"
    buf = buf + "    int64_t out_id = HX_INT(out_h);\n"
    buf = buf + "    if (out_id < 0 || out_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    /* hexa_farr_zeros may realloc _hx_farr_table — re-fetch pointers. */\n"
    buf = buf + "    xe = &_hx_farr_table[x_id];\n"
    buf = buf + "    HexaFarrEntry* oe = &_hx_farr_table[out_id];\n"
    buf = buf + "    if (!xe->buf || !oe->buf || oe->len < R * C) return -1;\n"
    buf = buf + "    const double* X = xe->buf;\n"
    buf = buf + "    double*       Y = oe->buf;\n"
    buf = buf + "    for (int64_t r = 0; r < R; r++) {\n"
    buf = buf + "        const double* xr = X + r * C;\n"
    buf = buf + "        double*       yr = Y + r * C;\n"
    buf = buf + "        double zmax = xr[0];\n"
    buf = buf + "        for (int64_t j = 1; j < C; j++) if (xr[j] > zmax) zmax = xr[j];\n"
    buf = buf + "        double s = 0.0;\n"
    buf = buf + "        for (int64_t j = 0; j < C; j++) {\n"
    buf = buf + "            double e = hxlcl_exp(xr[j] - zmax);\n"
    buf = buf + "            yr[j] = e;\n"
    buf = buf + "            s += e;\n"
    buf = buf + "        }\n"
    buf = buf + "        double inv = (s > 0.0) ? (1.0 / s) : 0.0;\n"
    buf = buf + "        for (int64_t j = 0; j < C; j++) yr[j] *= inv;\n"
    buf = buf + "    }\n"
    buf = buf + "    return out_id;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// BC-ANIMA M2 (2026-05-28): in-place row-softmax CPU oracle.\n"
    buf = buf + "// Writes numerically-stable row-wise softmax of `x_id` [R*C] into\n"
    buf = buf + "// caller-provided `out_id` [R*C] (must be pre-allocated, e.g. via\n"
    buf = buf + "// hexa_farr_zeros). Returns 0 ok / -1 err. Two-pass (max then sumexp)\n"
    buf = buf + "// — bit-identical math to _hx_farr_softmax_rows_cpu above; only the\n"
    buf = buf + "// output target differs (no per-call hexa_farr_zeros — for the V=151643\n"
    buf = buf + "// anima trainer hot path where a per-step alloc dominates).\n"
    buf = buf + "static int _hx_farr_softmax_rows_inplace_cpu(int64_t x_id, int64_t out_id,\n"
    buf = buf + "                                             int64_t R, int64_t C) {\n"
    buf = buf + "    if (x_id < 0 || x_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (out_id < 0 || out_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (R <= 0 || C <= 0)                    return -1;\n"
    buf = buf + "    HexaFarrEntry* xe = &_hx_farr_table[x_id];\n"
    buf = buf + "    HexaFarrEntry* oe = &_hx_farr_table[out_id];\n"
    buf = buf + "    if (!xe->buf || !oe->buf)                return -1;\n"
    buf = buf + "    if (xe->len < R * C || oe->len < R * C)  return -1;\n"
    buf = buf + "    const double* X = xe->buf;\n"
    buf = buf + "    double*       Y = oe->buf;\n"
    buf = buf + "    for (int64_t r = 0; r < R; r++) {\n"
    buf = buf + "        const double* xr = X + r * C;\n"
    buf = buf + "        double*       yr = Y + r * C;\n"
    buf = buf + "        double zmax = xr[0];\n"
    buf = buf + "        for (int64_t j = 1; j < C; j++) if (xr[j] > zmax) zmax = xr[j];\n"
    buf = buf + "        double s = 0.0;\n"
    buf = buf + "        for (int64_t j = 0; j < C; j++) {\n"
    buf = buf + "            double e = hxlcl_exp(xr[j] - zmax);\n"
    buf = buf + "            yr[j] = e;\n"
    buf = buf + "            s += e;\n"
    buf = buf + "        }\n"
    buf = buf + "        double inv = (s > 0.0) ? (1.0 / s) : 0.0;\n"
    buf = buf + "        for (int64_t j = 0; j < C; j++) yr[j] *= inv;\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// _hx_farr_rmsnorm_rows_cpu(x, R, C, eps) -> new farr_id.\n"
    buf = buf + "// RMSNorm row-wise: y[r,j] = x[r,j] / sqrt(mean_j(x[r,j]^2) + eps).\n"
    buf = buf + "// -1 on err. Matches d_train3_lib c3_rmsnorm_fwd math (without the\n"
    buf = buf + "// per-channel gain — that lives outside this kernel, so this is the\n"
    buf = buf + "// inv-rms-only primitive — consistent with PLAN.md §9 \"RMSNorm\n"
    buf = buf + "// reduction primitive\").\n"
    buf = buf + "static int64_t _hx_farr_rmsnorm_rows_cpu(int64_t x_id, int64_t R, int64_t C,\n"
    buf = buf + "                                         double eps) {\n"
    buf = buf + "    if (x_id < 0 || x_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (R <= 0 || C <= 0)                    return -1;\n"
    buf = buf + "    if (!(eps >= 0.0))                       return -1;   /* rejects NaN + negative */\n"
    buf = buf + "    HexaFarrEntry* xe = &_hx_farr_table[x_id];\n"
    buf = buf + "    if (!xe->buf || xe->len < R * C)         return -1;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    HexaVal out_h = hexa_farr_zeros(hexa_int(R * C));\n"
    buf = buf + "    int64_t out_id = HX_INT(out_h);\n"
    buf = buf + "    if (out_id < 0 || out_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    xe = &_hx_farr_table[x_id];\n"
    buf = buf + "    HexaFarrEntry* oe = &_hx_farr_table[out_id];\n"
    buf = buf + "    if (!xe->buf || !oe->buf || oe->len < R * C) return -1;\n"
    buf = buf + "    const double* X = xe->buf;\n"
    buf = buf + "    double*       Y = oe->buf;\n"
    buf = buf + "    double inv_C = 1.0 / (double)C;\n"
    buf = buf + "    for (int64_t r = 0; r < R; r++) {\n"
    buf = buf + "        const double* xr = X + r * C;\n"
    buf = buf + "        double*       yr = Y + r * C;\n"
    buf = buf + "        double ms = 0.0;\n"
    buf = buf + "        for (int64_t j = 0; j < C; j++) ms += xr[j] * xr[j];\n"
    buf = buf + "        ms *= inv_C;\n"
    buf = buf + "        double inv = 1.0 / _hx_sqrt(ms + eps);\n"
    buf = buf + "        for (int64_t j = 0; j < C; j++) yr[j] = xr[j] * inv;\n"
    buf = buf + "    }\n"
    buf = buf + "    return out_id;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// _hx_farr_add_cpu(a, b, n) -> new farr_id. C = A + B, length n. -1 err.\n"
    buf = buf + "static int64_t _hx_farr_add_cpu(int64_t a_id, int64_t b_id, int64_t n) {\n"
    buf = buf + "    if (a_id < 0 || a_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (b_id < 0 || b_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (n <= 0)                              return -1;\n"
    buf = buf + "    HexaFarrEntry* ae = &_hx_farr_table[a_id];\n"
    buf = buf + "    HexaFarrEntry* be = &_hx_farr_table[b_id];\n"
    buf = buf + "    if (!ae->buf || !be->buf)                return -1;\n"
    buf = buf + "    if (ae->len < n || be->len < n)          return -1;\n"
    buf = buf + "    HexaVal out_h = hexa_farr_zeros(hexa_int(n));\n"
    buf = buf + "    int64_t out_id = HX_INT(out_h);\n"
    buf = buf + "    if (out_id < 0 || out_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    ae = &_hx_farr_table[a_id];\n"
    buf = buf + "    be = &_hx_farr_table[b_id];\n"
    buf = buf + "    HexaFarrEntry* oe = &_hx_farr_table[out_id];\n"
    buf = buf + "    if (!ae->buf || !be->buf || !oe->buf || oe->len < n) return -1;\n"
    buf = buf + "    const double* A = ae->buf;\n"
    buf = buf + "    const double* B = be->buf;\n"
    buf = buf + "    double*       O = oe->buf;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) O[i] = A[i] + B[i];\n"
    buf = buf + "    return out_id;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// mk2-C1b (2026-05-19): dt_exp byte-exact C mirror of hexa\n"
    buf = buf + "// flame_math `dt_exp` (12-term Taylor + range-halve-to-0.25 + r\n"
    buf = buf + "// squarings). The flame silu reference uses dt_exp, NOT libm exp\n"
    buf = buf + "// (_hx_sigmoid_d) — the byte-eq oracle (flame_ag_tape_test Test 11\n"
    buf = buf + "// SILUGATE, leaf max|Δ|=0 bar) demands bit-identical reproduction\n"
    buf = buf + "// ([[flame-transcendental-byteeq-hazard]]). All ops are single-\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// rounding sequential (no a*b+c*d in one expr); FP_CONTRACT OFF is\n"
    buf = buf + "// cheap insurance vs any clang FMA fusion, mirroring the rope CPU\n"
    buf = buf + "// fix (commit c0789e05). Restored DEFAULT after the gate cpu.\n"
    buf = buf + "#pragma STDC FP_CONTRACT OFF\n"
    buf = buf + "static double _hx_dt_exp_d(double x) {\n"
    buf = buf + "    int r = 0;\n"
    buf = buf + "    double xr = x;\n"
    buf = buf + "    while ((xr > 0.0 ? xr : 0.0 - xr) > 0.25) { xr = xr / 2.0; r = r + 1; }\n"
    buf = buf + "    double term = 1.0;\n"
    buf = buf + "    double acc  = 1.0;\n"
    buf = buf + "    int k = 1;\n"
    buf = buf + "    while (k < 12) { term = term * xr / (double)k; acc = acc + term; k = k + 1; }\n"
    buf = buf + "    int s = 0;\n"
    buf = buf + "    while (s < r) { acc = acc * acc; s = s + 1; }\n"
    buf = buf + "    return acc;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// _hx_farr_silu_gate_cpu(a, b, n) -> new farr_id.\n"
    buf = buf + "// O[i] = (A[i] · σ(A[i])) · B[i],  σ(x) = 1/(1 + dt_exp(-x)).\n"
    buf = buf + "// Byte-identical to ag_tape.hexa `_ag_silu(a)*b` (same op order:\n"
    buf = buf + "// sig=1/(1+dt_exp(0-a)); (a*sig)*b). -1 err.\n"
    buf = buf + "static int64_t _hx_farr_silu_gate_cpu(int64_t a_id, int64_t b_id,\n"
    buf = buf + "                                      int64_t n) {\n"
    buf = buf + "    if (a_id < 0 || a_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (b_id < 0 || b_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (n <= 0)                              return -1;\n"
    buf = buf + "    HexaFarrEntry* ae = &_hx_farr_table[a_id];\n"
    buf = buf + "    HexaFarrEntry* be = &_hx_farr_table[b_id];\n"
    buf = buf + "    if (!ae->buf || !be->buf)                return -1;\n"
    buf = buf + "    if (ae->len < n || be->len < n)          return -1;\n"
    buf = buf + "    HexaVal out_h = hexa_farr_zeros(hexa_int(n));\n"
    buf = buf + "    int64_t out_id = HX_INT(out_h);\n"
    buf = buf + "    if (out_id < 0 || out_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    ae = &_hx_farr_table[a_id];\n"
    buf = buf + "    be = &_hx_farr_table[b_id];\n"
    buf = buf + "    HexaFarrEntry* oe = &_hx_farr_table[out_id];\n"
    buf = buf + "    if (!ae->buf || !be->buf || !oe->buf || oe->len < n) return -1;\n"
    buf = buf + "    const double* A = ae->buf;\n"
    buf = buf + "    const double* B = be->buf;\n"
    buf = buf + "    double*       O = oe->buf;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        double ai  = A[i];\n"
    buf = buf + "        double sig = 1.0 / (1.0 + _hx_dt_exp_d(0.0 - ai));\n"
    buf = buf + "        O[i] = (ai * sig) * B[i];\n"
    buf = buf + "    }\n"
    buf = buf + "    return out_id;\n"
    buf = buf + "}\n"
    buf = buf + "#pragma STDC FP_CONTRACT DEFAULT\n"
    buf = buf + "\n"
    buf = buf + "// _hx_farr_scale_cpu(x, alpha, n) -> new farr_id. Y = α·X, length n. -1 err.\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "static int64_t _hx_farr_scale_cpu(int64_t x_id, double alpha, int64_t n) {\n"
    buf = buf + "    if (x_id < 0 || x_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    if (n <= 0)                              return -1;\n"
    buf = buf + "    HexaFarrEntry* xe = &_hx_farr_table[x_id];\n"
    buf = buf + "    if (!xe->buf || xe->len < n)             return -1;\n"
    buf = buf + "    HexaVal out_h = hexa_farr_zeros(hexa_int(n));\n"
    buf = buf + "    int64_t out_id = HX_INT(out_h);\n"
    buf = buf + "    if (out_id < 0 || out_id >= _hx_farr_count) return -1;\n"
    buf = buf + "    xe = &_hx_farr_table[x_id];\n"
    buf = buf + "    HexaFarrEntry* oe = &_hx_farr_table[out_id];\n"
    buf = buf + "    if (!xe->buf || !oe->buf || oe->len < n) return -1;\n"
    buf = buf + "    const double* X = xe->buf;\n"
    buf = buf + "    double*       Y = oe->buf;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) Y[i] = alpha * X[i];\n"
    buf = buf + "    return out_id;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// farr_softmax_rows_gpu(x, R, C) -> int new farr_id (row-softmax).\n"
    buf = buf + "// On no-CUDA: routes to _hx_farr_softmax_rows_cpu (the CPU oracle).\n"
    buf = buf + "// On HEXA_CUDA: wired (Phase 4-D-5-4 step 1, 2026-05-17) to\n"
    buf = buf + "// _hx_cuda_farr_softmax_rows_gpu in self/cuda/runtime_cuda.c (LANDED —\n"
    buf = buf + "// block-per-row warp-shuffle row-max + exp-sum reduction, byte-eq\n"
    buf = buf + "// verified Phase 4-D-5-3 11/11 PASS on A100). Pre-allocates output via\n"
    buf = buf + "// hexa_farr_zeros (Phase A matmul precedent) so the substrate's\n"
    buf = buf + "// _ensure_dev_alloc_out can find the host entry + grow its g_slots.\n"
    buf = buf + "HexaVal hexa_farr_softmax_rows_gpu(HexaVal x_v, HexaVal r_v, HexaVal c_v) {\n"
    buf = buf + "    int64_t x_id = hexa_as_num(x_v);\n"
    buf = buf + "    int64_t R    = hexa_as_num(r_v);\n"
    buf = buf + "    int64_t C    = hexa_as_num(c_v);\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "    if (R <= 0 || C <= 0) return hexa_int(-1);\n"
    buf = buf + "    if (x_id < 0 || x_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    HexaVal out_h = hexa_farr_zeros(hexa_int(R * C));\n"
    buf = buf + "    int64_t out_id = hexa_as_num(out_h);\n"
    buf = buf + "    if (out_id < 0) return hexa_int(-1);\n"
    buf = buf + "    int rc = _hx_cuda_farr_softmax_rows_gpu(x_id, R, C, out_id);\n"
    buf = buf + "    if (rc != 0) return hexa_int(-1);\n"
    buf = buf + "    return hexa_int(out_id);\n"
    buf = buf + "#else\n"
    buf = buf + "    return hexa_int(_hx_farr_softmax_rows_cpu(x_id, R, C));\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// BC-ANIMA M2 (2026-05-28): farr_softmax_rows(x, out, R, C) -> 0/-1.\n"
    buf = buf + "// 4-arg in-place row-softmax. ABI mirrors the existing CUDA kernel\n"
    buf = buf + "// _hx_cuda_farr_softmax_rows_gpu(x_id, R, C, out_id) — caller pre-\n"
