    buf = buf + "// ARCH GATE for the BSD socket family: svc-trap path is Darwin arm64 only;\n"
    buf = buf + "// Linux/other arches fall through to libc (same prototypes from <sys/socket.h>).\n"
    buf = buf + "// F3 ACTIVATION · Path A — socket class-C svc-wrapper self-emit slot.\n"
    buf = buf + "// 3-arg int+int+int _cf (d, t, p) — all three ints sign-extended (3× sxtw on\n"
    buf = buf + "// x0/x1/x2), then mov w16,#97 / svc / _cf errno tail. 11 instr / 44 B, errno\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// reloc 0x1c/0x20. SELF-EMIT → extern, resolved by emit_hxlcl_socket_o.hexa's\n"
    buf = buf + "// .o (byte-eq to clang -O2, SYS#97). Completes the socket-family core set.\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int hxlcl_socket(int d, int t, int p);\n"
    buf = buf + "#else\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_socket(int d, int t, int p) {\n"
    buf = buf + "#if (defined(__arm64__) || defined(__aarch64__)) && defined(__APPLE__)\n"
    buf = buf + "    return (int)_hxlcl_syscall3_cf(HXLCL_SYS_SOCKET, (long)d, (long)t, (long)p);\n"
    buf = buf + "#else\n"
    buf = buf + "    return socket(d, t, p);\n"
