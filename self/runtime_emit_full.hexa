    buf = buf + "static int __attribute__((noinline)) hxlcl_chdir(const char *path)  { return (int)_hxlcl_syscall1_cf(HXLCL_SYS_CHDIR,  (long)path); }\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_unlink(const char *path) { return (int)_hxlcl_syscall1_cf(HXLCL_SYS_UNLINK, (long)path); }\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_rmdir(const char *path)  { return (int)_hxlcl_syscall1_cf(HXLCL_SYS_RMDIR,  (long)path); }\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_fsync(int fd)            { return (int)_hxlcl_syscall1_cf(HXLCL_SYS_FSYNC,  (long)fd); }\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_dup(int oldfd)           { return (int)_hxlcl_syscall1_cf(HXLCL_SYS_DUP,    (long)oldfd); }\n"
    buf = buf + "#endif\n"
    buf = buf + "// F3 wave 4 — DEFAULT: file-local `static` 2-arg / 3-arg _cf svc-trap\n"
    buf = buf + "// bodies. SELFEMIT flips to extern (decls above). The 2-arg bodies route\n"
    buf = buf + "// through _hxlcl_syscall2_cf, the 3-arg through _hxlcl_syscall3_cf — clang\n"
    buf = buf + "// -O2 emits IDENTICAL bytes to rt_chmod/rt_access (mkdir shape), rt_truncate\n"
    buf = buf + "// (stat shape), rt_chown/rt_lchown (NEW 3-arg ptr+int+int shape).\n"
    buf = buf + "#ifndef HEXA_RT_SELFEMIT\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_chmod(const char *path, int mode)         { return (int)_hxlcl_syscall2_cf(HXLCL_SYS_CHMOD,    (long)path, (long)mode); }\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_access(const char *path, int amode)       { return (int)_hxlcl_syscall2_cf(HXLCL_SYS_ACCESS,   (long)path, (long)amode); }\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_truncate(const char *path, long length)   { return (int)_hxlcl_syscall2_cf(HXLCL_SYS_TRUNCATE, (long)path, (long)length); }\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_chown(const char *path, int uid, int gid) { return (int)_hxlcl_syscall3_cf(HXLCL_SYS_CHOWN,    (long)path, (long)uid, (long)gid); }\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_lchown(const char *path, int uid, int gid){ return (int)_hxlcl_syscall3_cf(HXLCL_SYS_LCHOWN,   (long)path, (long)uid, (long)gid); }\n"
    buf = buf + "#endif\n"
    buf = buf + "// F3 ACTIVATION RUNBOOK · Path A — B9.6-C1 class-C syscall-ABI self-emit slot.\n"
    buf = buf + "//\n"
    buf = buf + "// hxlcl_getpid is the FIRST class-C (raw `svc #0x80` syscall wrapper) primitive\n"
    buf = buf + "// activated. SYS_GETPID(20) takes no args and cannot fail (no errno/carry-flag\n"
    buf = buf + "// path), so the plain trap below is the simplest svc wrapper in the runtime.\n"
    buf = buf + "//\n"
    buf = buf + "// DEFAULT build (HEXA_RT_SELFEMIT undefined): the file-local `static` svc-trap\n"
    buf = buf + "// body below is used — UNCHANGED behavior, 0-libc-extern invariant preserved\n"
    buf = buf + "// (this was never a libc symbol; the BSD getpid is issued via inline svc asm).\n"
    buf = buf + "//\n"
    buf = buf + "// SELF-EMIT build (HEXA_RT_SELFEMIT defined): becomes an `extern` declaration\n"
    buf = buf + "// (no body); the strong external `_hxlcl_getpid` symbol is provided by the\n"
    buf = buf + "// hexa-emitted Mach-O .o (test/native_build/emit_hxlcl_getpid_o.hexa →\n"
    buf = buf + "// rt_getpid's 16-byte `mov w16,#20 / mov x0,#0 / svc #0x80 / ret`), ahead-\n"
    buf = buf + "// linked. ld64 binds every callsite to the self-emit bytes — verified\n"
    buf = buf + "// byte-identical to `as -arch arm64` AND JIT-exec-correct (the returned pid\n"
    buf = buf + "// reads back == libc getpid(); see the emit driver's §HONESTY).\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int hxlcl_getpid(void);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "#else\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_getpid(void) { return (int)_hxlcl_syscall1(HXLCL_SYS_GETPID, 0); }\n"
    buf = buf + "#endif\n"
    buf = buf + "// RUNTIME Tier-A.6 — ___chkstk_darwin native stack-probe.\n"
    buf = buf + "// 8 large-frame functions (net.c hexa_net_read_n has a 64 KB\n"
    buf = buf + "// `char stackbuf[65536]`, plus hexa_exec / exec_capture / sha256_file /\n"
    buf = buf + "// vfprintf_fd / … — all > Darwin arm64's 4 KB guard-page probe threshold)\n"
    buf = buf + "// make clang emit a call to libSystem's `___chkstk_darwin` at prologue.\n"
    buf = buf + "// Provide it natively: one naked-asm page-walk in the Apple fixed-frame\n"
    buf = buf + "// ABI (requested frame size arrives in x9; clobbers only x16/x17, the\n"
    buf = buf + "// IP scratch regs). Touch one byte of each 4 KB page down to the new SP\n"
    buf = buf + "// so the guard page is committed before the frame is used. Drops the\n"
    buf = buf + "// libSystem `___chkstk_darwin` extern (26 -> 25).\n"
    buf = buf + "void hxlcl_chkstk(void) __asm__(\"___chkstk_darwin\");\n"
    buf = buf + "__attribute__((naked,used)) void hxlcl_chkstk(void){ __asm__ volatile(\n"
    buf = buf + "  \"mov x17, sp\\n mov x16, x9\\n 1: subs x16, x16, #0x1000\\n b.lt 2f\\n\"\n"
    buf = buf + "  \" sub x17, x17, #0x1000\\n ldr xzr, [x17]\\n b 1b\\n 2: ret\\n\"); }\n"
    buf = buf + "// RUNTIME tail (cycle 86): native setjmp/longjmp pair (Darwin arm64) — drops\n"
    buf = buf + "// the LAST libc extern (_longjmp). Saves callee-saved GPRs (x19-x28), fp/lr,\n"
    buf = buf + "// sp, and FP callee-saved (d8-d15) into the 192-byte jmp_buf slot the codegen\n"
    buf = buf + "// allocates (uses 168 B). hxlcl_setjmp is GLOBAL — compiled programs' try\n"
    buf = buf + "// blocks emit `bl _hxlcl_setjmp` (codegen arm64_darwin.hexa), paired with\n"
    buf = buf + "// hexa_throw's hxlcl_longjmp. csinc makes longjmp(buf,0) return 1.\n"
    buf = buf + "int hxlcl_setjmp(void *buf) __asm__(\"_hxlcl_setjmp\");\n"
    buf = buf + "__attribute__((naked,used,returns_twice)) int hxlcl_setjmp(void *buf) { __asm__ volatile(\n"
    buf = buf + "  \"stp x19, x20, [x0, #0]\\n  stp x21, x22, [x0, #16]\\n\"\n"
    buf = buf + "  \"stp x23, x24, [x0, #32]\\n stp x25, x26, [x0, #48]\\n\"\n"
    buf = buf + "  \"stp x27, x28, [x0, #64]\\n stp x29, x30, [x0, #80]\\n\"\n"
    buf = buf + "  \"mov x9, sp\\n str x9, [x0, #96]\\n\"\n"
    buf = buf + "  \"stp d8,  d9,  [x0, #104]\\n stp d10, d11, [x0, #120]\\n\"\n"
    buf = buf + "  \"stp d12, d13, [x0, #136]\\n stp d14, d15, [x0, #152]\\n\"\n"
    buf = buf + "  \"mov w0, #0\\n ret\\n\"); }\n"
    buf = buf + "void hxlcl_longjmp(void *buf, int val) __asm__(\"_hxlcl_longjmp\");\n"
    buf = buf + "__attribute__((naked,used,noreturn)) void hxlcl_longjmp(void *buf, int val) { __asm__ volatile(\n"
    buf = buf + "  \"ldp x19, x20, [x0, #0]\\n  ldp x21, x22, [x0, #16]\\n\"\n"
    buf = buf + "  \"ldp x23, x24, [x0, #32]\\n ldp x25, x26, [x0, #48]\\n\"\n"
    buf = buf + "  \"ldp x27, x28, [x0, #64]\\n ldp x29, x30, [x0, #80]\\n\"\n"
    buf = buf + "  \"ldr x9, [x0, #96]\\n mov sp, x9\\n\"\n"
    buf = buf + "  \"ldp d8,  d9,  [x0, #104]\\n ldp d10, d11, [x0, #120]\\n\"\n"
    buf = buf + "  \"ldp d12, d13, [x0, #136]\\n ldp d14, d15, [x0, #152]\\n\"\n"
    buf = buf + "  \"cmp w1, #0\\n csinc w0, w1, wzr, ne\\n ret\\n\"); }\n"
    buf = buf + "// getuid(2) — SYS_GETUID=24. Like getpid, this BSD syscall cannot fail\n"
    buf = buf + "// (no errno / carry-flag path), so the plain _hxlcl_syscall1 trap (not the\n"
    buf = buf + "// _cf carry-flag variant) is correct. Drops the libc `_getuid` extern that\n"
    buf = buf + "// net.c's os_getuid() pulled in (RUNTIME Tier-A.4 POSIX direct svc trap).\n"
    buf = buf + "// F3 ACTIVATION · Path A — B9.6-C3 class-C syscall-ABI self-emit slot.\n"
    buf = buf + "// hxlcl_getuid mirrors getpid (#1860): a 0-arg / cannot-fail svc-trap with no\n"
    buf = buf + "// errno path. DEFAULT build keeps the static svc-trap (0-libc-extern preserved;\n"
    buf = buf + "// BSD getuid issued via inline svc, never a libc symbol). SELF-EMIT build flips\n"
    buf = buf + "// to extern; the strong `_hxlcl_getuid` symbol comes from the hexa-emitted .o\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// (rt_getuid's 16-byte `mov w16,#24 / mov x0,#0 / svc #0x80 / ret`), ahead-\n"
    buf = buf + "// linked. Byte-identical to `as -arch arm64` AND JIT-exec-correct (returned\n"
    buf = buf + "// uid == libc getuid()).\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int hxlcl_getuid(void);\n"
    buf = buf + "#else\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_getuid(void) { return (int)_hxlcl_syscall1(HXLCL_SYS_GETUID, 0); }\n"
    buf = buf + "#endif\n"
    buf = buf + "// F3 ACTIVATION · Path A · wave 2 — class-C 0-arg / cannot-fail svc-traps.\n"
    buf = buf + "// hxlcl_geteuid / hxlcl_getegid / hxlcl_getgid / hxlcl_getppid are exact\n"
    buf = buf + "// rt_getuid-template extensions (4-instr 16-byte body, only the `mov w16,#N`\n"
    buf = buf + "// immediate differs per primitive). Like getuid/getpid, none can fail (no\n"
    buf = buf + "// errno / carry-flag path), so the plain _hxlcl_syscall1 trap is correct.\n"
    buf = buf + "// DEFAULT build keeps the static svc-trap (0-libc-extern preserved). SELF-EMIT\n"
    buf = buf + "// flips to extern; ld64 binds to the hexa-emitted .o (rt_<n>'s 16-byte body).\n"
    buf = buf + "// Byte-identical to `as -arch arm64` AND JIT-exec-correct (returned value ==\n"
    buf = buf + "// libc geteuid/getegid/getgid/getppid).\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int hxlcl_geteuid(void);\n"
    buf = buf + "#else\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_geteuid(void) { return (int)_hxlcl_syscall1(HXLCL_SYS_GETEUID, 0); }\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int hxlcl_getegid(void);\n"
    buf = buf + "#else\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_getegid(void) { return (int)_hxlcl_syscall1(HXLCL_SYS_GETEGID, 0); }\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int hxlcl_getgid(void);\n"
    buf = buf + "#else\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_getgid(void) { return (int)_hxlcl_syscall1(HXLCL_SYS_GETGID, 0); }\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int hxlcl_getppid(void);\n"
    buf = buf + "#else\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_getppid(void) { return (int)_hxlcl_syscall1(HXLCL_SYS_GETPPID, 0); }\n"
    buf = buf + "#endif\n"
    buf = buf + "// RUNTIME.md Tier-A.4 — backtrace / backtrace_symbols_fd hexa-native stubs.\n"
    buf = buf + "// These libc execinfo(3) fns are pulled in ONLY by the HEXA_OOB_TRACE\n"
    buf = buf + "// diagnostic path in runtime_core.c (array OOB tracer). A self-host compiler\n"
    buf = buf + "// has no need for a real frame walker; the stub returns \"no frames captured\"\n"
    buf = buf + "// and writes a single advisory line to fd via the svc-trap hxlcl_write. The\n"
    buf = buf + "// HEXA_OOB_TRACE [OOB] message + the actual hexa_throw still surface — only\n"
    buf = buf + "// the (unavailable on a stripped self-host binary) symbolized frames go away.\n"
    buf = buf + "// Drops the libc _backtrace + _backtrace_symbols_fd externs (29 -> 27).\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_backtrace(void **buf, int sz) {\n"
    buf = buf + "    (void)buf; (void)sz;\n"
    buf = buf + "    return 0;  // 0 frames captured — hexa-native stub, no real unwinder\n"
    buf = buf + "}\n"
    buf = buf + "static void __attribute__((noinline)) hxlcl_backtrace_symbols_fd(void *const *buf, int sz, int fd) {\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    (void)buf; (void)sz;\n"
    buf = buf + "    static const char msg[] = \"(backtrace unavailable — hexa-native stub)\\n\";\n"
    buf = buf + "    hxlcl_write(fd, msg, sizeof(msg) - 1);\n"
    buf = buf + "}\n"
    buf = buf + "// cycle 66 — libc dup2 (same carry-flag issue as close).\n"
    buf = buf + "extern int dup2(int oldfd, int newfd);\n"
    buf = buf + "// cycle 71 — dup2 re-trapped via carry-flag-correct svc 0x80 (SYS_DUP2=90).\n"
    buf = buf + "// F3 ACTIVATION · Path A — B9.6-C4 class-C syscall-ABI self-emit slot.\n"
    buf = buf + "// hxlcl_dup2 extends the close (#1861) 1-arg carry-flag template to 2 int\n"
    buf = buf + "// args (a second sxtw). DEFAULT build keeps the static _cf svc-trap (errno\n"
    buf = buf + "// stored to the shared hxlcl_errno cell). SELF-EMIT build flips to extern; the\n"
    buf = buf + "// strong `_hxlcl_dup2` symbol comes from the hexa-emitted .o (rt_dup2's 40-byte\n"
    buf = buf + "// body), ahead-linked. The errno store is a PC-relative adrp/str to the\n"
    buf = buf + "// hxlcl_errno SYMBOL — externally linkable under the guard, same as close.\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int hxlcl_dup2(int oldfd, int newfd);\n"
    buf = buf + "#else\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_dup2(int oldfd, int newfd) { return (int)_hxlcl_syscall2_cf(HXLCL_SYS_DUP2, (long)oldfd, (long)newfd); }\n"
    buf = buf + "#endif\n"
    buf = buf + "// cycle 66 — restore libc pipe() backing. The cycle 63+64 svc-0x80\n"
    buf = buf + "// path mis-handled the Darwin pipe(2) pair-return: the kernel\n"
    buf = buf + "// returns the two fds in x0/x1 registers, NOT in the user-provided\n"
    buf = buf + "// int[2] memory. The svc wrapper only captures x0, so fds[1] stayed\n"
    buf = buf + "// uninitialized → child's dup2(pipe[1], 1) wrote to a garbage fd →\n"
    buf = buf + "// parent's read(pipe[0], …) saw EOF immediately → exec() emitted\n"
    buf = buf + "// \"\". Resolves inbox/patches/yosys-exec-runtime-regression-cycles-\n"
    buf = buf + "// 61-64.md Secondary suspect (cycles 63+64 pipe machinery).\n"
    buf = buf + "extern int pipe(int fds[2]);\n"
    buf = buf + "// cycle 71 — pipe re-trapped via the carry-flag PAIR-RETURN trap\n"
    buf = buf + "// (_hxlcl_pipe_cf captures BOTH x0/x1 fds — fixes the cycle-63/64\n"
    buf = buf + "// garbage-fds[1] bug that PR #251 reverted to libc to escape).\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_pipe(int fds[2]) { return _hxlcl_pipe_cf(fds); }\n"
    buf = buf + "// RUNTIME net/exec ⑥ (cycle 80): svc-trap fork (2) — Darwin BSD PAIR-RETURN.\n"
    buf = buf + "// fork returns the child pid in x0 for BOTH processes; the child is\n"
    buf = buf + "// disambiguated by x1==1 (parent has x1==0). cycle-66 left this on libc\n"
    buf = buf + "// because the cycle-63 x0-only svc path misread the convention. We mirror\n"
    buf = buf + "// _hxlcl_pipe_cf's explicit-asm dual-register capture (the register-\n"
    buf = buf + "// constrained \"=r\"(x1) form hung clang). carry-set -> failure (EAGAIN).\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_fork(void) {\n"
    buf = buf + "    long r0, r1, cf;\n"
    buf = buf + "    __asm__ volatile(\"mov x16, #2\\n\\tsvc #0x80\\n\\tcset %2, cs\\n\\tmov %0, x0\\n\\tmov %1, x1\"\n"
    buf = buf + "                     : \"=r\"(r0), \"=r\"(r1), \"=r\"(cf) :: \"x0\", \"x1\", \"x16\", \"memory\", \"cc\");\n"
    buf = buf + "    if (cf) { errno = (int)r0; return -1; }\n"
    buf = buf + "    if (r1 == 1) return 0;   // child\n"
    buf = buf + "    return (int)r0;          // parent: child pid\n"
    buf = buf + "}\n"
    buf = buf + "// F3 ACTIVATION · Path A — B9.6-C8 class-C syscall-ABI self-emit slot.\n"
    buf = buf + "// hxlcl_kill is a 2-arg NON-_cf svc (plain _hxlcl_syscall2, no carry-flag /\n"
    buf = buf + "// errno path) — the 2-arg analogue of getuid (#1860). DEFAULT build keeps the\n"
    buf = buf + "// static svc-trap. SELF-EMIT build flips to extern; the strong `_hxlcl_kill`\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// symbol comes from the hexa-emitted .o (rt_kill's 20-byte `sxtw x0 / sxtw x1\n"
    buf = buf + "// / mov w16,#37 / svc #0x80 / ret`), ahead-linked. No errno store → NO reloc.\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int hxlcl_kill(int pid, int sig);\n"
    buf = buf + "#else\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_kill(int pid, int sig) { return (int)_hxlcl_syscall2(HXLCL_SYS_KILL, (long)pid, (long)sig); }\n"
    buf = buf + "#endif\n"
    buf = buf + "// B9.6-C10 (F3 Path A) — DEFAULT: file-local `static` 3-arg non-_cf svc-trap\n"
    buf = buf + "// (0-libc-extern preserved). HEXA_RT_SELFEMIT: `extern`, body supplied by the\n"
    buf = buf + "// self-emit .o (rt_fcntl's 20-byte `sxtw x0 / sxtw x1 / mov w16,#92 / svc / ret`,\n"
    buf = buf + "// the 3-arg analogue of rt_kill — no errno store → NO reloc).\n"
    buf = buf + "#ifndef HEXA_RT_SELFEMIT\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_fcntl(int fd, int cmd, long arg) { return (int)_hxlcl_syscall3(HXLCL_SYS_FCNTL, (long)fd, (long)cmd, arg); }\n"
    buf = buf + "#endif\n"
    buf = buf + "// B9.6-C11 (F3 Path A) — DEFAULT: file-local `static` 3-arg non-_cf svc-trap.\n"
    buf = buf + "// HEXA_RT_SELFEMIT: `extern`, body supplied by the self-emit .o (rt_ioctl's\n"
    buf = buf + "// 16-byte `sxtw x0 / mov w16,#54 / svc / ret` — only fd sign-extended, req/arg\n"
    buf = buf + "// already 64-bit, no errno store → NO reloc).\n"
    buf = buf + "#ifndef HEXA_RT_SELFEMIT\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_ioctl(int fd, unsigned long req, void *arg) { return (int)_hxlcl_syscall3(HXLCL_SYS_IOCTL, (long)fd, (long)req, (long)arg); }\n"
    buf = buf + "#endif\n"
    buf = buf + "// PR #426 follow-up — libc lseek (same Darwin arm64 carry-flag class as\n"
    buf = buf + "// open/read/write/close/dup2 in cycle-66 / #414). The raw `svc #0x80`\n"
    buf = buf + "// `_hxlcl_syscall3` cannot read the carry flag, so a failed lseek returns\n"
    buf = buf + "// the positive errno (e.g. EBADF=9 / ESPIPE=29) that callers mistake for\n"
    buf = buf + "// a valid small offset. Latent today (no `< 0` test bypass in current\n"
    buf = buf + "// hot paths) but identical structural hazard — route through libc so\n"
    buf = buf + "// failures return -1 + set errno. lseek prototype comes from the\n"
    buf = buf + "// top-of-file <unistd.h> include (uses off_t — no extern decl to avoid\n"
    buf = buf + "// conflicting with the libc signature).\n"
    buf = buf + "// cycle 71 — lseek re-trapped via carry-flag-correct svc 0x80 (SYS_LSEEK=199).\n"
    buf = buf + "// A failed lseek now returns -1+errno instead of a positive errno that a\n"
    buf = buf + "// `< 0` sentinel test would mistake for a valid offset (PR #426 hazard).\n"
    buf = buf + "// B9.6-C9 (F3 Path A) — DEFAULT: file-local `static` 3-arg _cf svc-trap (carry-\n"
    buf = buf + "// flag-correct, 0-libc-extern preserved). HEXA_RT_SELFEMIT: `extern`, body\n"
    buf = buf + "// supplied by the self-emit .o (rt_lseek's 40-byte FIRST 3-arg _cf body: sxtw\n"
    buf = buf + "// x0/fd + sxtw x2/whence — the MIDDLE x1/off long left untouched — then the full\n"
    buf = buf + "// _cf errno tail with adrp/str to the externally-linkable hxlcl_errno symbol;\n"
    buf = buf + "// errno relocs at the rt_dup2 offsets 0x18/0x1c).\n"
    buf = buf + "#ifndef HEXA_RT_SELFEMIT\n"
    buf = buf + "static long __attribute__((noinline)) hxlcl_lseek(int fd, long off, int whence) { return _hxlcl_syscall3_cf(HXLCL_SYS_LSEEK, (long)fd, off, (long)whence); }\n"
    buf = buf + "#endif\n"
    buf = buf + "// B9.6-C14 (F3 Path A) — DEFAULT: file-local `static` 6-arg NON-_cf svc-trap.\n"
    buf = buf + "// HEXA_RT_SELFEMIT: `extern`, body supplied by the self-emit .o (rt_select's\n"
    buf = buf + "// 20-byte body: nfds/x0 sxtw + mov x5,#0 — r/w/e/t pointers untouched — trap,\n"
    buf = buf + "// ret, NO errno store → NO reloc, SYS_SELECT=93).\n"
    buf = buf + "#ifndef HEXA_RT_SELFEMIT\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_select(int nfds, void *r, void *w, void *e, void *t) { return (int)_hxlcl_syscall6(HXLCL_SYS_SELECT, (long)nfds, (long)r, (long)w, (long)e, (long)t, 0); }\n"
    buf = buf + "#endif\n"
    buf = buf + "// B9.6-C15 (F3 Path A) — DEFAULT: file-local `static` 3-arg NON-_cf svc-trap.\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// HEXA_RT_SELFEMIT: `extern`, body supplied by the self-emit .o (rt_poll's\n"
    buf = buf + "// 20-byte body: fds/x0 ptr untouched, `mov w1,w1` uxtw the UNSIGNED nfds,\n"
    buf = buf + "// sxtw x2/timeout — trap, ret, NO reloc, SYS_POLL=230).\n"
    buf = buf + "#ifndef HEXA_RT_SELFEMIT\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_poll(void *fds, unsigned int nfds, int timeout) { return (int)_hxlcl_syscall3(HXLCL_SYS_POLL, (long)fds, (long)nfds, (long)timeout); }\n"
    buf = buf + "#endif\n"
    buf = buf + "// cycle 66 — libc waitpid (wait4 syscall has 4 args + needs proper\n"
    buf = buf + "// errno/EINTR handling that the raw syscall path drops).\n"
    buf = buf + "extern int waitpid(int pid, int *status, int options);\n"
    buf = buf + "// cycle 71 — waitpid re-trapped via the wait4 syscall (SYS_WAIT4=7) with\n"
    buf = buf + "// carry-flag-correct error handling; 4th arg (struct rusage*) = NULL.\n"
    buf = buf + "// B9.6-C16 (F3 Path A) — DEFAULT: file-local `static` 4-arg _cf svc-trap (routes\n"
    buf = buf + "// waitpid to wait4(2) with a NULL rusage 4th arg). HEXA_RT_SELFEMIT: `extern`,\n"
    buf = buf + "// body supplied by the self-emit .o (rt_waitpid's 44-byte FIRST 4-arg _cf body:\n"
    buf = buf + "// sxtw x0/pid + sxtw x2/options + mov x3,#0 — status/x1 untouched — full _cf\n"
    buf = buf + "// errno tail, errno relocs @0x1c/0x20, SYS_WAIT4=7).\n"
    buf = buf + "#ifndef HEXA_RT_SELFEMIT\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_waitpid(int pid, int *status, int options) { return (int)_hxlcl_syscall4_cf(HXLCL_SYS_WAIT4, (long)pid, (long)status, (long)options, 0); }\n"
    buf = buf + "#endif\n"
    buf = buf + "/* Cycle 65: variadic to handle both 2-arg and 3-arg open() callers. */\n"
    buf = buf + "extern int open(const char *path, int flags, ...);\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_open_sys(const char *path, int flags, ...) {\n"
    buf = buf + "    int mode = 0;\n"
    buf = buf + "    __builtin_va_list ap;\n"
    buf = buf + "    __builtin_va_start(ap, flags);\n"
    buf = buf + "    mode = __builtin_va_arg(ap, int);\n"
    buf = buf + "    __builtin_va_end(ap);\n"
    buf = buf + "    /* Route through libc open() rather than a raw `svc #0x80`. The macOS\n"
    buf = buf + "     * arm64 syscall ABI signals failure via the carry flag and returns the\n"
    buf = buf + "     * positive errno in x0; the inline-asm `_hxlcl_syscall3` cannot read the\n"
    buf = buf + "     * carry flag, so a failed open (e.g. ENOENT → 2) came back as a small\n"
    buf = buf + "     * positive value that callers mistook for a valid fd — fopen()-style\n"
    buf = buf + "     * sites then wrote content to that low descriptor instead of returning\n"
    buf = buf + "     * failure. Same carry-flag fix already applied to read/write/close/dup2\n"
    buf = buf + "     * in cycle 66; open was missed. (inbox patch canonical-audit-round-8:\n"
    buf = buf + "     * write_file content-leak + false `true` return.)\n"
    buf = buf + "     * cycle 71: re-trapped via carry-flag-correct svc 0x80 (SYS_OPEN=5) —\n"
    buf = buf + "     * a failed open now returns -1+errno (ENOENT etc) instead of a small\n"
    buf = buf + "     * positive errno-as-fd that defeated the content-leak guard. */\n"
    buf = buf + "    return (int)_hxlcl_syscall3_cf(HXLCL_SYS_OPEN, (long)path, (long)flags, (long)mode);\n"
    buf = buf + "}\n"
    buf = buf + "// PR #426 follow-up — libc fstat/stat (same Darwin arm64 carry-flag class\n"
    buf = buf + "// as open in #414). Raw syscall returned positive errno on failure that\n"
    buf = buf + "// future callers could mis-treat (a `< 0` sentinel test would be defeated\n"
    buf = buf + "// by the encoded-positive-errno return). Latent today but identical\n"
    buf = buf + "// structural hazard. Route through libc for uniform errno semantics —\n"
    buf = buf + "// matches Linux block. Prototypes come from top-of-file <sys/stat.h>\n"
    buf = buf + "// (Darwin uses __DARWIN_INODE64 symbol renaming — no extern decl, must\n"
    buf = buf + "// use the header's `struct stat *` signature).\n"
    buf = buf + "// cycle 71 — fstat re-trapped via carry-flag-correct svc 0x80 (SYS_FSTAT=339).\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// F3 ACTIVATION · Path A — B9.6-C6 class-C syscall-ABI self-emit slot.\n"
    buf = buf + "// hxlcl_fstat is a 2-arg _cf with an int FIRST arg (fd, x0 sign-extended) + a\n"
    buf = buf + "// pointer SECOND arg (buf, x1 untouched) — the mirror of mkdir (which signs\n"
    buf = buf + "// the 2nd arg). SYS_FSTAT=339 is the first class-C SYS number > 255, exercising\n"
    buf = buf + "// the full 16-bit `mov w16` immediate. DEFAULT build keeps the static _cf\n"
    buf = buf + "// svc-trap. SELF-EMIT build flips to extern; the strong `_hxlcl_fstat` symbol\n"
    buf = buf + "// comes from the hexa-emitted .o (rt_fstat's 36-byte body), ahead-linked.\n"
    buf = buf + "// errno store = PC-relative adrp/str to hxlcl_errno (links under guard).\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int hxlcl_fstat(int fd, void *buf);\n"
    buf = buf + "#else\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_fstat(int fd, void *buf) { return (int)_hxlcl_syscall2_cf(HXLCL_SYS_FSTAT, (long)fd, (long)buf); }\n"
    buf = buf + "#endif\n"
    buf = buf + "// cycle 71 — stat re-trapped via carry-flag-correct svc 0x80 (SYS_STAT=338).\n"
    buf = buf + "// F3 ACTIVATION · Path A — B9.6-C7 class-C syscall-ABI self-emit slot.\n"
    buf = buf + "// hxlcl_stat is a 2-arg _cf where BOTH args are pointers (path x0, buf x1) — so\n"
    buf = buf + "// NEITHER is sign-extended. It is the FIRST no-sxtw 2-arg svc body (32 B, 4 B\n"
    buf = buf + "// shorter than mkdir/fstat — exactly the dropped sxtw). DEFAULT build keeps the\n"
    buf = buf + "// static _cf svc-trap. SELF-EMIT build flips to extern; the strong `_hxlcl_stat`\n"
    buf = buf + "// symbol comes from the hexa-emitted .o (rt_stat's 32-byte body), ahead-linked.\n"
    buf = buf + "// errno store = PC-relative adrp/str to hxlcl_errno (links under guard).\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int hxlcl_stat(const char *path, void *buf);\n"
    buf = buf + "#else\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_stat(const char *path, void *buf) { return (int)_hxlcl_syscall2_cf(HXLCL_SYS_STAT, (long)path, (long)buf); }\n"
    buf = buf + "#endif\n"
    buf = buf + "// Cycle 65 — close out remaining real syscalls.\n"
    buf = buf + "#define HXLCL_SYS_GETTIMEOFDAY 116\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "// F3 ACTIVATION · Path A — exit self-emit slot. DEFAULT build keeps the static\n"
    buf = buf + "// svc-trap below; SELF-EMIT flips to extern, resolved by emit_hxlcl_exit_o.hexa\n"
    buf = buf + "// (rt_exit's 16-byte body: sxtw x0 / mov w16,#1 / svc / brk — no-reloc-v3 .o).\n"
    buf = buf + "#else\n"
    buf = buf + "static void __attribute__((noinline, noreturn)) hxlcl_exit(int code) {\n"
    buf = buf + "    (void)_hxlcl_syscall1(HXLCL_SYS_EXIT, (long)code);\n"
    buf = buf + "    __builtin_trap();  // unreachable; ensure noreturn satisfaction\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "// PR #426 follow-up — libc mmap (same Darwin arm64 carry-flag class).\n"
    buf = buf + "// On failure the kernel returns errno in x0 instead of MAP_FAILED, so\n"
    buf = buf + "// the raw `_hxlcl_syscall6` path returned a small positive integer cast\n"
    buf = buf + "// to `void *` — callers comparing against MAP_FAILED ((void *)-1) would\n"
    buf = buf + "// treat that errno-pointer as a valid mapping and dereference into the\n"
    buf = buf + "// low VA space (segfault or, worse, silent data into a low page).\n"
    buf = buf + "// Latent today (hxlcl_malloc / safetensors loader compare against\n"
    buf = buf + "// MAP_FAILED — a stray small-int \"pointer\" would fail later) but the\n"
    buf = buf + "// structural hazard is identical to PR #414's open carry-flag bug.\n"
    buf = buf + "// Route through libc for proper MAP_FAILED + errno semantics — matches\n"
    buf = buf + "// the Linux block below. Prototype from top-of-file <sys/mman.h>.\n"
    buf = buf + "// cycle 71 — mmap re-trapped via carry-flag-correct svc 0x80 (SYS_MMAP=197).\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// On error the cf6 helper returns -1, which cast to (void *) is exactly\n"
    buf = buf + "// MAP_FAILED ((void *)-1) — probe-verified mmap(badfd) -> MAP_FAILED+EBADF.\n"
    buf = buf + "// B9.6-C17 (F3 Path A) — DEFAULT: file-local `static` 6-arg _cf svc-trap.\n"
    buf = buf + "// HEXA_RT_SELFEMIT: `extern`, body supplied by the self-emit .o (rt_mmap's\n"
    buf = buf + "// 44-byte 6-arg _cf body: sxtw x2/prot + sxtw x3/flags + sxtw x4/fd —\n"
    buf = buf + "// addr/len/off untouched — full _cf errno tail, errno relocs @0x1c/0x20,\n"
    buf = buf + "// -1 == MAP_FAILED, SYS_MMAP=197).\n"
    buf = buf + "#ifndef HEXA_RT_SELFEMIT\n"
    buf = buf + "static void *__attribute__((noinline)) hxlcl_mmap(void *addr, unsigned long len, int prot, int flags, int fd, long off) { return (void *)_hxlcl_syscall6_cf(HXLCL_SYS_MMAP, (long)addr, (long)len, (long)prot, (long)flags, (long)fd, off); }\n"
    buf = buf + "#endif\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_clock_gettime(int clk, void *ts) {\n"
    buf = buf + "    // Use gettimeofday(2) (syscall 116) since clock_gettime is a vDSO\n"
    buf = buf + "    // function on Darwin with no direct syscall number. timespec[0..1]\n"
    buf = buf + "    // is sec/nsec; we fill from sec/microsec*1000.\n"
    buf = buf + "    (void)clk;\n"
    buf = buf + "    long tv[2] = {0, 0};\n"
    buf = buf + "    (void)_hxlcl_syscall2(HXLCL_SYS_GETTIMEOFDAY, (long)tv, 0);\n"
    buf = buf + "    if (ts) {\n"
    buf = buf + "        long long *p = (long long *)ts;\n"
    buf = buf + "        p[0] = tv[0];\n"
    buf = buf + "        p[1] = tv[1] * 1000;\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "// RUNTIME Tier-A.6 — ___darwin_check_fd_set_overflow native def.\n"
    buf = buf + "// The SDK FD_SET/FD_CLR/FD_ISSET macros (expanded in net.c et al via\n"
    buf = buf + "// <sys/select.h>) emit a call to the 3-underscore symbol\n"
    buf = buf + "// `___darwin_check_fd_set_overflow`; libSystem normally satisfies it.\n"
    buf = buf + "// A plain C identifier `hxlcl_…` mangles to `_hxlcl_…` and never binds\n"
    buf = buf + "// that symbol, so the prior dead stub (wrong name, never called, AND\n"
    buf = buf + "// returned 0 — a latent bug: a 0 return tells the SDK macro the fd is\n"
    buf = buf + "// out of range and SKIPS the bit op). Bind the real 3-underscore symbol\n"
    buf = buf + "// via an __asm__ label and return 1 (in-range, do the bit op) — dropping\n"
    buf = buf + "// the libSystem `___darwin_check_fd_set_overflow` extern (27 -> 26).\n"
    buf = buf + "int hxlcl_fd_overflow(int a, const void *b, int n) __asm__(\"___darwin_check_fd_set_overflow\");\n"
    buf = buf + "__attribute__((used,noinline)) int hxlcl_fd_overflow(int a, const void *b, int n){ (void)a;(void)b;(void)n; return 1; }\n"
    buf = buf + "#elif defined(__linux__)\n"
    buf = buf + "// libc-fallback syscall layer for Linux — every architecture (x86_64\n"
    buf = buf + "// AND arm64). The branch above raw-traps via `svc #0x80` with Darwin\n"
    buf = buf + "// BSD syscall numbers, correct ONLY on Darwin arm64. On Linux the\n"
    buf = buf + "// Darwin SYS_* numbers and the `svc #0x80` trap do not apply (Linux\n"
    buf = buf + "// arm64 = `svc #0` + a different table; x86_64 = the `syscall` insn),\n"
    buf = buf + "// and the toolchain always links libc — so route the hxlcl_* wrappers\n"
    buf = buf + "// through thin glibc calls. One architecture-neutral libc layer serves\n"
    buf = buf + "// every Linux arch; no per-arch raw-syscall port is needed.\n"
    buf = buf + "//\n"
    buf = buf + "// Note: cycle-66 already used this exact pattern for read/write/close/dup2/\n"
    buf = buf + "// pipe/fork/waitpid on arm64 (carry-flag + EINTR + pair-return bugs in the\n"
    buf = buf + "// raw trap). Here we extend the same libc-wrapper approach to the full set.\n"
    buf = buf + "#include <unistd.h>\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "#include <fcntl.h>\n"
    buf = buf + "#include <sys/types.h>\n"
    buf = buf + "#include <sys/stat.h>\n"
    buf = buf + "#include <sys/mman.h>\n"
    buf = buf + "#include <sys/select.h>\n"
    buf = buf + "#include <sys/wait.h>\n"
    buf = buf + "#include <sys/ioctl.h>\n"
    buf = buf + "#include <signal.h>\n"
    buf = buf + "#include <poll.h>\n"
    buf = buf + "#include <time.h>\n"
    buf = buf + "#include <stdarg.h>\n"
    buf = buf + "\n"
    buf = buf + "// RFC061 §M8 (ING#29) Linux raw-syscall layer: direct kernel traps replacing the\n"
    buf = buf + "// glibc delegates below, dropping read/write/close/getpid/dup2/pipe/fork/kill/\n"
    buf = buf + "// fcntl/ioctl/lseek/poll/wait4/mkdir/open/clock_gettime libc externs on both arches.\n"
    buf = buf + "// Reference-match musl arch/<a>/syscall_arch.h + src/internal/syscall_ret.c. Linux\n"
    buf = buf + "// returns -errno in the result reg (not carry like darwin); _hxlcl_lx_ret maps it.\n"
    buf = buf + "static inline long _hxlcl_lx_ret(long r) {\n"
    buf = buf + "    if ((unsigned long)r > (unsigned long)-4096L) { errno = (int)(-r); return -1; }\n"
    buf = buf + "    return r;\n"
    buf = buf + "}\n"
    buf = buf + "#if defined(__x86_64__)\n"
    buf = buf + "static inline long _hxlcl_lx_sc0(long n) { unsigned long ret; __asm__ volatile(\"syscall\" : \"=a\"(ret) : \"a\"(n) : \"rcx\", \"r11\", \"memory\"); return _hxlcl_lx_ret((long)ret); }\n"
    buf = buf + "static inline long _hxlcl_lx_sc1(long n, long a1) { unsigned long ret; __asm__ volatile(\"syscall\" : \"=a\"(ret) : \"a\"(n), \"D\"(a1) : \"rcx\", \"r11\", \"memory\"); return _hxlcl_lx_ret((long)ret); }\n"
    buf = buf + "static inline long _hxlcl_lx_sc2(long n, long a1, long a2) { unsigned long ret; __asm__ volatile(\"syscall\" : \"=a\"(ret) : \"a\"(n), \"D\"(a1), \"S\"(a2) : \"rcx\", \"r11\", \"memory\"); return _hxlcl_lx_ret((long)ret); }\n"
    buf = buf + "static inline long _hxlcl_lx_sc3(long n, long a1, long a2, long a3) { unsigned long ret; __asm__ volatile(\"syscall\" : \"=a\"(ret) : \"a\"(n), \"D\"(a1), \"S\"(a2), \"d\"(a3) : \"rcx\", \"r11\", \"memory\"); return _hxlcl_lx_ret((long)ret); }\n"
    buf = buf + "static inline long _hxlcl_lx_sc4(long n, long a1, long a2, long a3, long a4) { unsigned long ret; register long r10 __asm__(\"r10\") = a4; __asm__ volatile(\"syscall\" : \"=a\"(ret) : \"a\"(n), \"D\"(a1), \"S\"(a2), \"d\"(a3), \"r\"(r10) : \"rcx\", \"r11\", \"memory\"); return _hxlcl_lx_ret((long)ret); }\n"
    buf = buf + "static inline long _hxlcl_lx_sc5(long n, long a1, long a2, long a3, long a4, long a5) { unsigned long ret; register long r10 __asm__(\"r10\") = a4; register long r8 __asm__(\"r8\") = a5; __asm__ volatile(\"syscall\" : \"=a\"(ret) : \"a\"(n), \"D\"(a1), \"S\"(a2), \"d\"(a3), \"r\"(r10), \"r\"(r8) : \"rcx\", \"r11\", \"memory\"); return _hxlcl_lx_ret((long)ret); }\n"
    buf = buf + "#elif defined(__aarch64__)\n"
    buf = buf + "static inline long _hxlcl_lx_sc0(long n) { register long x8 __asm__(\"x8\") = n; register long x0 __asm__(\"x0\"); __asm__ volatile(\"svc 0\" : \"=r\"(x0) : \"r\"(x8) : \"memory\", \"cc\"); return _hxlcl_lx_ret(x0); }\n"
    buf = buf + "static inline long _hxlcl_lx_sc1(long n, long a1) { register long x8 __asm__(\"x8\") = n; register long x0 __asm__(\"x0\") = a1; __asm__ volatile(\"svc 0\" : \"=r\"(x0) : \"r\"(x8), \"0\"(x0) : \"memory\", \"cc\"); return _hxlcl_lx_ret(x0); }\n"
    buf = buf + "static inline long _hxlcl_lx_sc2(long n, long a1, long a2) { register long x8 __asm__(\"x8\") = n; register long x0 __asm__(\"x0\") = a1; register long x1 __asm__(\"x1\") = a2; __asm__ volatile(\"svc 0\" : \"=r\"(x0) : \"r\"(x8), \"0\"(x0), \"r\"(x1) : \"memory\", \"cc\"); return _hxlcl_lx_ret(x0); }\n"
    buf = buf + "static inline long _hxlcl_lx_sc3(long n, long a1, long a2, long a3) { register long x8 __asm__(\"x8\") = n; register long x0 __asm__(\"x0\") = a1; register long x1 __asm__(\"x1\") = a2; register long x2 __asm__(\"x2\") = a3; __asm__ volatile(\"svc 0\" : \"=r\"(x0) : \"r\"(x8), \"0\"(x0), \"r\"(x1), \"r\"(x2) : \"memory\", \"cc\"); return _hxlcl_lx_ret(x0); }\n"
    buf = buf + "static inline long _hxlcl_lx_sc4(long n, long a1, long a2, long a3, long a4) { register long x8 __asm__(\"x8\") = n; register long x0 __asm__(\"x0\") = a1; register long x1 __asm__(\"x1\") = a2; register long x2 __asm__(\"x2\") = a3; register long x3 __asm__(\"x3\") = a4; __asm__ volatile(\"svc 0\" : \"=r\"(x0) : \"r\"(x8), \"0\"(x0), \"r\"(x1), \"r\"(x2), \"r\"(x3) : \"memory\", \"cc\"); return _hxlcl_lx_ret(x0); }\n"
    buf = buf + "static inline long _hxlcl_lx_sc5(long n, long a1, long a2, long a3, long a4, long a5) { register long x8 __asm__(\"x8\") = n; register long x0 __asm__(\"x0\") = a1; register long x1 __asm__(\"x1\") = a2; register long x2 __asm__(\"x2\") = a3; register long x3 __asm__(\"x3\") = a4; register long x4 __asm__(\"x4\") = a5; __asm__ volatile(\"svc 0\" : \"=r\"(x0) : \"r\"(x8), \"0\"(x0), \"r\"(x1), \"r\"(x2), \"r\"(x3), \"r\"(x4) : \"memory\", \"cc\"); return _hxlcl_lx_ret(x0); }\n"
