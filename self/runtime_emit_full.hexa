    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        else { int_total += HX_INT(e); }\n"
    buf = buf + "    }\n"
    buf = buf + "    if (has_float) return hexa_float((double)int_total + float_total);\n"
    buf = buf + "    return hexa_int(int_total);\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_array_sum_float(HexaVal arr);\n"
    buf = buf + "HexaVal hexa_sum(HexaVal a) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(a)) return hexa_int(0);\n"
    buf = buf + "    int64_t n = (int64_t)HX_ARR_LEN(a);\n"
    buf = buf + "    if (n == 0) return hexa_int(0);\n"
    buf = buf + "    if (_arr_all_float(a)) return rt_array_sum_float(a);\n"
    buf = buf + "    int has_float = 0;\n"
    buf = buf + "    int64_t int_total = 0;\n"
    buf = buf + "    double float_total = 0.0;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        HexaVal e = hexa_array_get(a, i);\n"
    buf = buf + "        if (HX_IS_FLOAT(e)) { has_float = 1; float_total += HX_FLOAT(e); }\n"
    buf = buf + "        else { int_total += HX_INT(e); }\n"
