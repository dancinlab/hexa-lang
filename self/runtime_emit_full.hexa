    buf = buf + "                    }\n"
    buf = buf + "                    if (sig_digits > 18) sig_digits = 18;\n"
    buf = buf + "                    if (sig_digits < 1) sig_digits = 1;\n"
    buf = buf + "                    char digits[24]; int n_dig = 0;\n"
    buf = buf + "                    for (int k = 0; k < sig_digits; k++) {\n"
