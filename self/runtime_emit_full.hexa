    buf = buf + " *\n"
    buf = buf + " *   hexa_pty_open()                              -> map {master, slave, slave_name} or {error}\n"
    buf = buf + " *   hexa_pty_get_winsize(fd)                     -> map {rows, cols, xpix, ypix} or {error}\n"
    buf = buf + " *   hexa_pty_set_winsize(fd, r, c, xp, yp)       -> 0 or -errno\n"
    buf = buf + " *   hexa_tcgetattr(fd)                           -> map {iflag, oflag, cflag, lflag, cc[]} or {error}\n"
    buf = buf + " *   hexa_tcsetattr(fd, when, attrs)              -> 0 or -errno\n"
    buf = buf + " *   hexa_tty_isatty(fd)                          -> bool\n"
    buf = buf + " *   hexa_tty_ttyname(fd)                         -> string or \"\"\n"
    buf = buf + " *   hexa_pty_forkexec(argv, env, rows, cols)     -> map {pid, master_fd} or {error}\n"
    buf = buf + " *\n"
    buf = buf + " * Source: native/pty.c (RFC: incoming/patches/stdlib-os-pty.md)\n"
    buf = buf + " * Cross-platform (macOS + Linux). Linux requires `-lutil` for forkpty;\n"
    buf = buf + " * macOS bundles it in libsystem.\n"
    buf = buf + " * ═══════════════════════════════════════════════════════════════════ */\n"
    buf = buf + "#include \"native/pty.c\"\n"
    buf = buf + "\n"
    buf = buf + "/* ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + " * stdlib/os/mount + stdlib/os/namespace -- Linux mount(2) / umount(2) +\n"
    buf = buf + " * unshare / setns / pivot_root. Functions return 0 on success, -errno\n"
    buf = buf + " * on failure. macOS returns -ENOSYS (graceful degradation for\n"
    buf = buf + " * downstream code that targets both platforms).\n"
    buf = buf + " *\n"
    buf = buf + " *   hexa_mount(src, tgt, fs, flags, data)        -> 0 or -errno\n"
    buf = buf + " *   hexa_umount(tgt, flags)                      -> 0 or -errno\n"
    buf = buf + " *   hexa_unshare(flags)                          -> 0 or -errno\n"
    buf = buf + " *   hexa_setns(fd, nstype)                       -> 0 or -errno\n"
    buf = buf + " *   hexa_pivot_root(new_root, put_old)           -> 0 or -errno\n"
    buf = buf + " *   hexa_namespace_clone_const(name)             -> int (CLONE_NEW* value)\n"
    buf = buf + " *\n"
    buf = buf + " * RFCs: incoming/patches/stdlib-os-{mount,namespace}-linux.md\n"
    buf = buf + " * ═══════════════════════════════════════════════════════════════════ */\n"
    buf = buf + "#include \"native/mount.c\"\n"
    buf = buf + "#include \"native/namespace.c\"\n"
    buf = buf + "\n"
    buf = buf + "/* ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + " * stdlib/proc/wait — hxlcl_waitpid(2) wrapper for SIGCHLD reaping.\n"
    buf = buf + " *\n"
    buf = buf + " *   hexa_proc_wait(pid, flags)        -> map { pid, exited, signaled,\n"
    buf = buf + " *                                              exit_code, term_sig,\n"
    buf = buf + " *                                              raw_status } or { error, errno }\n"
    buf = buf + " *   hexa_proc_wait_flag_const(name)   -> int (WNOHANG / WUNTRACED / WCONTINUED)\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + " *\n"
    buf = buf + " * Consumer: pty_forkexec, pool_on — any hexa fork+exec pattern that\n"
    buf = buf + " * needs to reap its zombies. RFC stdlib-for-cpu-port.md P1 signal-ext.\n"
    buf = buf + " * ═══════════════════════════════════════════════════════════════════ */\n"
    buf = buf + "#include \"native/wait.c\"\n"
    buf = buf + "\n"
    buf = buf + "/* ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + " * stdlib/crypto — libsodium-backed primitives for SSH (and any\n"
    buf = buf + " * downstream that needs vetted modern crypto).\n"
    buf = buf + " *\n"
    buf = buf + " *   hexa_libsodium_available()         -> bool\n"
    buf = buf + " *   hexa_sha512(data)                  -> [int] 64\n"
    buf = buf + " *   hexa_ed25519_keypair()              -> map { pub, priv }\n"
    buf = buf + " *   hexa_ed25519_sign(priv, msg)        -> [int] 64\n"
    buf = buf + " *   hexa_ed25519_verify(pub, msg, sig)  -> bool\n"
    buf = buf + " *   hexa_x25519_keypair()                -> map { pub, priv }\n"
    buf = buf + " *   hexa_x25519_scalarmult(scalar, point)-> [int] 32 | { error }\n"
    buf = buf + " *   hexa_chacha20_poly1305_encrypt(key, nonce, aad, pt) -> [int] | { error }\n"
    buf = buf + " *   hexa_chacha20_poly1305_decrypt(key, nonce, aad, ct) -> [int] | { error }\n"
    buf = buf + " *\n"
    buf = buf + " * Linking: when cmd_build detects libsodium via pkg-config, it adds\n"
    buf = buf + " * -DHEXA_HAS_LIBSODIUM + -lsodium and these are real. Without\n"
    buf = buf + " * libsodium they return { error: \"libsodium not linked\" } — caller\n"
    buf = buf + " * should check `libsodium_available()` first.\n"
    buf = buf + " *\n"
    buf = buf + " * RFC: incoming/patches/stdlib-ssh-client.md (crypto suite prereq)\n"
    buf = buf + " * ═══════════════════════════════════════════════════════════════════ */\n"
    buf = buf + "#include \"native/crypto_sodium.c\"\n"
    buf = buf + "#include \"native/crypto_openssl.c\"\n"
    buf = buf + "#include \"native/exec_pipe.c\"\n"
    buf = buf + "#include \"native/proc_fork.c\"\n"
    buf = buf + "\n"
    buf = buf + "/* ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + " * B20 / roadmap 55 Phase 1 — deterministic FP control-word init.\n"
    buf = buf + " *\n"
    buf = buf + " * Exposes void hexa_fp_init(void). codegen.hexa emits a call to it\n"
    buf = buf + " * as the first statement of generated main(). Implementation in\n"
    buf = buf + " * self/native/fp_init.c normalizes MXCSR (x86_64) or FPCR (aarch64)\n"
    buf = buf + " * to IEEE-default behavior (no FTZ/DAZ/FZ, round-to-nearest-even) so\n"
    buf = buf + " * @strict_fp functions can rely on bit-exact FP semantics.\n"
    buf = buf + " *\n"
    buf = buf + " * Phase 2 scope: crlibm vendoring for cross-substrate transcendental\n"
    buf = buf + " * identity; pthread_create trampoline. Not shipped in Phase 1.\n"
    buf = buf + " * ═══════════════════════════════════════════════════════════════════ */\n"
    buf = buf + "#include \"native/fp_init.c\"\n"
    buf = buf + "\n"
    buf = buf + "/* ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + " * stdlib/os — signal + flock builtins (roadmap 62, 2026-04-22)\n"
    buf = buf + " *\n"
    buf = buf + " * Exposes hexa_os_sig_* (install / raise / drain / block / …) and\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + " * hexa_os_flock_* (open / close) for the stdlib/os/{signal,flock}.hexa\n"
    buf = buf + " * modules. Async-signal-safe self-pipe trampoline; O_CLOEXEC on flock\n"
    buf = buf + " * fds so hxlcl_execve(3) does not leak locks into children.\n"
    buf = buf + " *\n"
    buf = buf + " * Implementation: native/signal_flock.c (see header comment for full\n"
    buf = buf + " * contract + semantics).\n"
    buf = buf + " * ═══════════════════════════════════════════════════════════════════ */\n"
    buf = buf + "/* iter-2c (2026-05-22): on Linux glibc, <sys/file.h> declares\n"
    buf = buf + " * `extern int flock(int __fd, int __operation)`. The `#define flock(fd,op)\n"
    buf = buf + " * hxlcl_flock(...)` macro at runtime.c:1187 textually replaces the\n"
    buf = buf + " * prototype's parameter names with a call expression, so the parser sees\n"
    buf = buf + " * `int hxlcl_flock((int)(__fd), (int)(__operation));` and dies at the `(`.\n"
    buf = buf + " * macOS clang's <sys/file.h> does not expose a function-like flock so the\n"
    buf = buf + " * macro is a no-op there. Undef just for this include; signal_flock.c uses\n"
    buf = buf + " * the libc `flock(fd, op)` form internally (LOCK_EX/LOCK_UN), which is the\n"
    buf = buf + " * intended behavior on both platforms. Minimal scope: only this include. */\n"
    buf = buf + "#undef flock\n"
    buf = buf + "#include \"native/signal_flock.c\"\n"
    buf = buf + "\n"
    buf = buf + "/* ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + " * hxa-20260424-005 items #1 + #7 — exec_argv + sha256 (2026-04-24)\n"
    buf = buf + " *\n"
    buf = buf + " * Exposes:\n"
    buf = buf + " *   hexa_exec_argv(argv_arr)             : fork/execvp, no /bin/sh -c\n"
    buf = buf + " *   hexa_exec_argv_with_status(argv_arr) : same + exit code\n"
    buf = buf + " *   hexa_sha256(s)                       : lowercase hex digest\n"
    buf = buf + " *   hexa_sha256_file(path)               : lowercase hex digest of file\n"
    buf = buf + " *\n"
    buf = buf + " * Implementation: native/exec_argv_sha256.c (pure libc + FIPS 180-4\n"
    buf = buf + " * reference sha256). TAG_FN shims registered from _hexa_init_fn_shims\n"
    buf = buf + " * so the interpreter path resolves `exec_argv`/`sha256` names before\n"
    buf = buf + " * the transpiler learns direct-lowering.\n"
    buf = buf + " * ═══════════════════════════════════════════════════════════════════ */\n"
    buf = buf + "#include \"native/exec_argv_sha256.c\"\n"
    buf = buf + "\n"
    buf = buf + "/* ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + " * persistent_pipe — ω-runtime-1 Phase A (2026-04-26)\n"
    buf = buf + " *\n"
    buf = buf + " * Handle-based bidirectional child-process API. Five new builtins:\n"
    buf = buf + " *   pipe_spawn(cmd) -> int\n"
    buf = buf + " *   pipe_send_line(h, payload) -> bool\n"
    buf = buf + " *   pipe_recv_line(h, timeout_ms) -> string\n"
    buf = buf + " *   pipe_close(h) -> bool\n"
    buf = buf + " *   pipe_alive(h) -> bool\n"
    buf = buf + " * Powers ω-audio-2 60× chain target (replaces _audio_worker_call.sh\n"
    buf = buf + " * 133-line bash shim with sub-ms send/recv via persistent fork).\n"
    buf = buf + " * ═══════════════════════════════════════════════════════════════════ */\n"
    buf = buf + "#include \"native/persistent_pipe.c\"\n"
    buf = buf + "\n"
    buf = buf + "/* ═══════════════════════════════════════════════════════════════════\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + " * TUI-PRIM L1 FFI shim — POSIX termios + ioctl + signal\n"
    buf = buf + " *\n"
    buf = buf + " * Source: self/native/term_ffi.c — 12 raw POSIX symbols (no HexaVal).\n"
    buf = buf + " * Wrappers below bridge to HexaVal for hexa source dispatch.\n"
    buf = buf + " *\n"
    buf = buf + " * Builtin names exposed to hexa (codegen.hexa + env.hexa + hexa_full.hexa):\n"
    buf = buf + " *   term_raw_enter()         -> Int (rc 0/-1)\n"
    buf = buf + " *   term_raw_restore()       -> Int (rc 0/-1)\n"
    buf = buf + " *   term_winsize_rows()      -> Int (rows or -1)\n"
    buf = buf + " *   term_winsize_cols()      -> Int (cols or -1)\n"
    buf = buf + " *   term_poll_stdin(ms)      -> Int (1/0/-1)\n"
    buf = buf + " *   term_read_byte()         -> Int (byte 0..255 or -1)\n"
    buf = buf + " *   term_write_str(s)        -> Int (bytes-written or -1)\n"
    buf = buf + " *   term_install_sigwinch()  -> Int\n"
    buf = buf + " *   term_sigwinch_pending()  -> Int (1/0)\n"
    buf = buf + " *   term_install_sigint()    -> Int\n"
    buf = buf + " *   term_sigint_pending()    -> Int (1/0)\n"
    buf = buf + " *   term_isatty_stdin()      -> Int\n"
    buf = buf + " *   term_isatty_stdout()     -> Int\n"
    buf = buf + " *   term_getppid()           -> Int (parent pid; 1 = orphaned to init)\n"
    buf = buf + " *\n"
    buf = buf + " * Kick witness:\n"
    buf = buf + " *   state/design_strategy_trawl/2026-04-27_hexa-native-tui-implementation-plan_KICK_omega_cycle.json\n"
    buf = buf + " * ═══════════════════════════════════════════════════════════════════ */\n"
    buf = buf + "#include \"native/term_ffi.c\"\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_term_raw_enter(void) { return hexa_int((int64_t)term_raw_enter()); }\n"
    buf = buf + "HexaVal hexa_term_raw_restore(void) { return hexa_int((int64_t)term_raw_restore()); }\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_term_winsize_rows(void) {\n"
    buf = buf + "    int r = -1, c = -1;\n"
    buf = buf + "    if (term_get_winsize(&r, &c) != 0) return hexa_int(-1);\n"
    buf = buf + "    return hexa_int((int64_t)r);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_term_winsize_cols(void) {\n"
    buf = buf + "    int r = -1, c = -1;\n"
    buf = buf + "    if (term_get_winsize(&r, &c) != 0) return hexa_int(-1);\n"
    buf = buf + "    return hexa_int((int64_t)c);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_term_poll_stdin(HexaVal ms) {\n"
    buf = buf + "    int t = (int)__hx_to_double(ms);\n"
    buf = buf + "    return hexa_int((int64_t)term_poll_stdin(t));\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_term_read_byte(void) { return hexa_int((int64_t)term_read_byte()); }\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_term_write_str(HexaVal s) {\n"
    buf = buf + "    if (!HX_IS_STR(s) || HX_STR(s) == NULL) {\n"
    buf = buf + "        return hexa_int(-1);\n"
    buf = buf + "    }\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    const char *buf = HX_STR(s);\n"
    buf = buf + "    int n = (int)hxlcl_strlen(buf);\n"
    buf = buf + "    return hexa_int((int64_t)term_write(buf, n));\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_term_install_sigwinch(void) { return hexa_int((int64_t)term_install_sigwinch()); }\n"
    buf = buf + "HexaVal hexa_term_sigwinch_pending(void) { return hexa_int((int64_t)term_sigwinch_pending()); }\n"
    buf = buf + "HexaVal hexa_term_install_sigint(void) { return hexa_int((int64_t)term_install_sigint()); }\n"
    buf = buf + "HexaVal hexa_term_sigint_pending(void) { return hexa_int((int64_t)term_sigint_pending()); }\n"
    buf = buf + "HexaVal hexa_term_isatty_stdin(void) { return hexa_int((int64_t)term_isatty_stdin()); }\n"
    buf = buf + "HexaVal hexa_term_isatty_stdout(void) { return hexa_int((int64_t)term_isatty_stdout()); }\n"
    buf = buf + "HexaVal hexa_term_getppid(void) { return hexa_int((int64_t)term_getppid()); }\n"
    buf = buf + "\n"
    buf = buf + "/* PTY harness builtins (forward-only \"real PTY\" closure, commit 43bec17b). */\n"
    buf = buf + "\n"
    buf = buf + "extern int term_pty_spawn_sh(const char *cmd, int rows, int cols, int *out_pid);\n"
    buf = buf + "extern int term_fd_read(int fd, unsigned char *buf, int max_bytes);\n"
    buf = buf + "extern int term_fd_write(int fd, const unsigned char *buf, int n);\n"
    buf = buf + "extern int term_fd_close(int fd);\n"
    buf = buf + "extern int term_fd_poll(int fd, int timeout_ms);\n"
    buf = buf + "extern int term_pty_reap(int pid, int *out_status);\n"
    buf = buf + "\n"
    buf = buf + "/* Returns [mfd, pid] as a 2-element int array. mfd=-1 on error. */\n"
    buf = buf + "HexaVal hexa_term_pty_spawn_sh(HexaVal cmd, HexaVal rows, HexaVal cols) {\n"
    buf = buf + "    if (!HX_IS_STR(cmd) || HX_STR(cmd) == NULL) {\n"
    buf = buf + "        HexaVal arr = hexa_array_new();\n"
    buf = buf + "        hexa_array_push(arr, hexa_int(-1));\n"
    buf = buf + "        hexa_array_push(arr, hexa_int(-1));\n"
    buf = buf + "        return arr;\n"
    buf = buf + "    }\n"
    buf = buf + "    const char *c = HX_STR(cmd);\n"
    buf = buf + "    int r = (int)__hx_to_double(rows);\n"
    buf = buf + "    int co = (int)__hx_to_double(cols);\n"
    buf = buf + "    int pid = -1;\n"
    buf = buf + "    int mfd = term_pty_spawn_sh(c, r, co, &pid);\n"
    buf = buf + "    HexaVal arr = hexa_array_new();\n"
    buf = buf + "    hexa_array_push(arr, hexa_int((int64_t)mfd));\n"
    buf = buf + "    hexa_array_push(arr, hexa_int((int64_t)pid));\n"
    buf = buf + "    return arr;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* Read up to max_bytes from fd. Returns the bytes as a Hexa string\n"
    buf = buf + " * (raw byte concat — caller may need to decode if utf-8 boundary). */\n"
    buf = buf + "HexaVal hexa_term_fd_read(HexaVal fd, HexaVal max_bytes) {\n"
    buf = buf + "    int f = (int)__hx_to_double(fd);\n"
    buf = buf + "    int m = (int)__hx_to_double(max_bytes);\n"
    buf = buf + "    if (m <= 0 || m > 65536) m = 4096;\n"
    buf = buf + "    unsigned char buf[65536];\n"
    buf = buf + "    if (m > 65536) m = 65536;\n"
    buf = buf + "    int n = term_fd_read(f, buf, m);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    if (n <= 0) return hexa_str(\"\");\n"
    buf = buf + "    /* hexa_str_n if available; otherwise null-terminate after copy */\n"
    buf = buf + "    char tmp[65537];\n"
    buf = buf + "    hxlcl_memcpy(tmp, buf, (size_t)n);\n"
    buf = buf + "    tmp[n] = '\\0';\n"
    buf = buf + "    return hexa_str(tmp);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_term_fd_write(HexaVal fd, HexaVal data) {\n"
    buf = buf + "    int f = (int)__hx_to_double(fd);\n"
    buf = buf + "    if (!HX_IS_STR(data) || HX_STR(data) == NULL) return hexa_int(-1);\n"
    buf = buf + "    const char *s = HX_STR(data);\n"
    buf = buf + "    int n = (int)hxlcl_strlen(s);\n"
    buf = buf + "    int w = term_fd_write(f, (const unsigned char *)s, n);\n"
    buf = buf + "    return hexa_int((int64_t)w);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_term_fd_close(HexaVal fd) {\n"
    buf = buf + "    int f = (int)__hx_to_double(fd);\n"
    buf = buf + "    return hexa_int((int64_t)term_fd_close(f));\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_term_fd_poll(HexaVal fd, HexaVal timeout_ms) {\n"
    buf = buf + "    int f = (int)__hx_to_double(fd);\n"
    buf = buf + "    int t = (int)__hx_to_double(timeout_ms);\n"
    buf = buf + "    return hexa_int((int64_t)term_fd_poll(f, t));\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* Returns [exited_flag, status]. exited_flag: 1 done, 0 running, -1 err */\n"
    buf = buf + "HexaVal hexa_term_pty_reap(HexaVal pid) {\n"
    buf = buf + "    int p = (int)__hx_to_double(pid);\n"
    buf = buf + "    int st = 0;\n"
    buf = buf + "    int r = term_pty_reap(p, &st);\n"
    buf = buf + "    HexaVal arr = hexa_array_new();\n"
    buf = buf + "    hexa_array_push(arr, hexa_int((int64_t)r));\n"
    buf = buf + "    hexa_array_push(arr, hexa_int((int64_t)st));\n"
    buf = buf + "    return arr;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ── exec_stream_async / poll / close stub primitives (KI-4 fix, 2026-05-01) ──\n"
    buf = buf + "// Origin: hive 7-bucket closure cycle KI-4 fix. cli_mvp.hexa async streaming\n"
    buf = buf + "// (follow-up8 minimum-viable input-during-processing) 23 caller가 이 primitive\n"
    buf = buf + "// 의존. 직전 hexa-lang commit drift로 native impl 부재 → cli_mvp build fail.\n"
    buf = buf + "//\n"
    buf = buf + "// Real impl semantics (v1.8, KI-4 stub → actual async impl 2026-05-01):\n"
    buf = buf + "//   exec_stream_async(cmd) -> int   : popen(cmd, \"r\") + fcntl O_NONBLOCK,\n"
    buf = buf + "//                                      slot table에 FILE* 저장 후 handle return.\n"
    buf = buf + "//                                      handle ≥ 0 = 성공, -1 = popen 실패.\n"
    buf = buf + "//   exec_stream_poll(handle) -> any  : drain available newline-terminated\n"
    buf = buf + "//                                      lines (non-blocking). EOF 시 EOF marker\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "//                                      삽입. line array return.\n"
    buf = buf + "//   exec_stream_close(handle) -> int : pclose() rc → WIFEXITED + WEXITSTATUS\n"
    buf = buf + "//                                      decode (signal exit 시 -signal). slot\n"
    buf = buf + "//                                      release. handle stale 시 -1.\n"
    buf = buf + "//\n"
    buf = buf + "// v1.1 enhancements (2026-05-01):\n"
    buf = buf + "//   - Dynamic line buffer: 8KB initial → realloc doubling up to 1MB cap (raw\n"
    buf = buf + "//     49 additive-first growth). silent-error silent-error-ban 정합 (long line\n"
    buf = buf + "//     truncate 회피; 단 1MB cap 도달 시 silent drop 잔존 — C3 honest C3).\n"
    buf = buf + "//   - pclose rc proper decode: WIFEXITED → WEXITSTATUS, WIFSIGNALED →\n"
    buf = buf + "//     -WTERMSIG. Caller가 표준 exit code 패턴 (`if rc == 0`) 사용 가능.\n"
    buf = buf + "//\n"
    buf = buf + "// C3 honest C3: 8-slot table (single-process limit). Concurrent stream >8\n"
    buf = buf + "// 시 spawn fail (-1 return → caller sync fallback). cli_mvp는 _stream_handle\n"
    buf = buf + "// 단일 slot이므로 충분. realloc fail / 1MB cap hit 시 silent drop — v1.2에서\n"
    buf = buf + "// stderr advisory 추가 예정.\n"
    buf = buf + "//\n"
    buf = buf + "// codegen은 `hexa_exec_stream_async_impl` (impl suffix) + raw `exec_stream_*`\n"
    buf = buf + "// 두 path 모두 emit (hexa_call1 _Generic dispatch에 의존).\n"
    buf = buf + "\n"
    buf = buf + "#include <fcntl.h>\n"
    buf = buf + "#include <errno.h>\n"
    buf = buf + "\n"
    buf = buf + "#define HEXA_STREAM_SLOT_COUNT 8\n"
    buf = buf + "#define HEXA_STREAM_LINE_BUF_INITIAL 8192\n"
    buf = buf + "#define HEXA_STREAM_LINE_BUF_MAX 1048576  /* 1MB cap (additive-first growth) */\n"
    buf = buf + "typedef struct {\n"
    buf = buf + "    FILE* fp;\n"
    buf = buf + "    char* buf;          /* dynamic alloc (v1.1 silent-error long-line truncate 회피) */\n"
    buf = buf + "    int   buf_cap;      /* current capacity */\n"
    buf = buf + "    int   buf_len;      /* current length */\n"
    buf = buf + "    int   eof;\n"
    buf = buf + "    int   in_use;\n"
    buf = buf + "    /* v1.3 (2026-05-11, wilson tool-core ESC-cancel): own child pid so\n"
    buf = buf + "       exec_stream_kill can SIGTERM->SIGKILL the whole process *group*.\n"
    buf = buf + "       _async forks /bin/sh -c cmd directly (setpgid(0,0) in the child)\n"
    buf = buf + "       instead of hxlcl_popen(), so pid == child sh pid == the group leader pgid.\n"
    buf = buf + "       pid <= 0 -> legacy popen fallback (fork/pipe failed): no pid, so\n"
    buf = buf + "       exec_stream_kill on that slot is best-effort fclose only & returns\n"
    buf = buf + "       -1 (C3 honest C3 - prompt-kill needs the fork path). */\n"
    buf = buf + "    pid_t pid;\n"
    buf = buf + "    /* v1.4 (2026-05-13, wilson MCP bidi): write-end fd of child stdin pipe\n"
    buf = buf + "       when slot was opened via hexa_exec_stream_open (the bidi variant).\n"
    buf = buf + "       -1 = read-only slot (exec_stream_async path; no stdin pipe). Used\n"
    buf = buf + "       by hexa_exec_stream_write to send data to the child's stdin and\n"
    buf = buf + "       hexa_exec_stream_close_stdin to signal EOF on the child side.\n"
    buf = buf + "       Filed at incoming/patches/wilson-mcp-needs-bidi-stdio.md. */\n"
    buf = buf + "    int   stdin_fd;\n"
    buf = buf + "} HexaStreamSlot;\n"
    buf = buf + "static HexaStreamSlot _hexa_stream_slots[HEXA_STREAM_SLOT_COUNT];\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "static int _hexa_stream_slots_init = 0;\n"
    buf = buf + "\n"
    buf = buf + "static void _hexa_stream_slots_ensure_init(void) {\n"
    buf = buf + "    if (_hexa_stream_slots_init) return;\n"
    buf = buf + "    for (int i = 0; i < HEXA_STREAM_SLOT_COUNT; i++) {\n"
    buf = buf + "        _hexa_stream_slots[i].fp = NULL;\n"
    buf = buf + "        _hexa_stream_slots[i].buf = (char*)malloc(HEXA_STREAM_LINE_BUF_INITIAL);\n"
    buf = buf + "        _hexa_stream_slots[i].buf_cap = _hexa_stream_slots[i].buf\n"
    buf = buf + "                                          ? HEXA_STREAM_LINE_BUF_INITIAL : 0;\n"
    buf = buf + "        _hexa_stream_slots[i].buf_len = 0;\n"
    buf = buf + "        _hexa_stream_slots[i].eof = 0;\n"
    buf = buf + "        _hexa_stream_slots[i].in_use = 0;\n"
    buf = buf + "        _hexa_stream_slots[i].pid = (pid_t)-1;\n"
    buf = buf + "        _hexa_stream_slots[i].stdin_fd = -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    _hexa_stream_slots_init = 1;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_exec_stream_async_impl(HexaVal cmd) {\n"
    buf = buf + "    _hexa_stream_slots_ensure_init();\n"
    buf = buf + "    const char* cmd_s = HX_IS_STR(cmd) ? HX_STR(cmd) : NULL;\n"
    buf = buf + "    if (!cmd_s) return hexa_int((int64_t)-1);\n"
    buf = buf + "    int slot = -1;\n"
    buf = buf + "    for (int i = 0; i < HEXA_STREAM_SLOT_COUNT; i++) {\n"
    buf = buf + "        if (!_hexa_stream_slots[i].in_use) { slot = i; break; }\n"
    buf = buf + "    }\n"
    buf = buf + "    if (slot < 0) return hexa_int((int64_t)-1);\n"
    buf = buf + "    /* v1.1 defensive: ensure_init malloc failure 시 lazy retry */\n"
    buf = buf + "    if (!_hexa_stream_slots[slot].buf) {\n"
    buf = buf + "        _hexa_stream_slots[slot].buf = (char*)malloc(HEXA_STREAM_LINE_BUF_INITIAL);\n"
    buf = buf + "        if (!_hexa_stream_slots[slot].buf) return hexa_int((int64_t)-1);\n"
    buf = buf + "        _hexa_stream_slots[slot].buf_cap = HEXA_STREAM_LINE_BUF_INITIAL;\n"
    buf = buf + "    }\n"
    buf = buf + "    // 2026-05-06 — POSIX fork buffer flush before fork/popen (mirrors hexa_exec)\n"
    buf = buf + "    fflush(NULL);\n"
    buf = buf + "    // v1.3 (2026-05-11): own the child pid so exec_stream_kill can SIGKILL the\n"
    buf = buf + "    // whole process group. fork() + setpgid(0,0) in the child + exec /bin/sh\n"
    buf = buf + "    // -c cmd; parent keeps the read end of a pipe (matches popen(\"r\") FILE*\n"
    buf = buf + "    // semantics). On any fork/pipe step failure we fall back to popen() with\n"
    buf = buf + "    // pid = -1 (exec_stream_kill on that slot then degrades to fclose + -1).\n"
    buf = buf + "    FILE* fp = NULL;\n"
    buf = buf + "    pid_t child_pid = (pid_t)-1;\n"
    buf = buf + "    {\n"
    buf = buf + "        int pipefd[2];\n"
    buf = buf + "        if (hxlcl_pipe(pipefd) == 0) {\n"
    buf = buf + "            pid_t pid = hxlcl_fork();\n"
    buf = buf + "            if (pid == 0) {\n"
    buf = buf + "                // child\n"
    buf = buf + "                setpgid(0, 0);                 // own process group -> killpg target\n"
    buf = buf + "                hxlcl_close(pipefd[0]);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "                if (pipefd[1] != STDOUT_FILENO) {\n"
    buf = buf + "                    hxlcl_dup2(pipefd[1], STDOUT_FILENO);\n"
    buf = buf + "                    hxlcl_close(pipefd[1]);\n"
    buf = buf + "                }\n"
    buf = buf + "                hxlcl_execl(\"/bin/sh\", \"sh\", \"-c\", cmd_s, (char*)NULL);\n"
    buf = buf + "                _exit(127);                    // execl failed\n"
    buf = buf + "            } else if (pid > 0) {\n"
    buf = buf + "                // parent\n"
    buf = buf + "                hxlcl_close(pipefd[1]);\n"
    buf = buf + "                setpgid(pid, pid);             // race-safe (also set on child side)\n"
    buf = buf + "                fp = fdopen(pipefd[0], \"r\");\n"
    buf = buf + "                if (!fp) { hxlcl_close(pipefd[0]); hxlcl_kill(-pid, SIGKILL); hxlcl_waitpid(pid, NULL, 0); }\n"
    buf = buf + "                else child_pid = pid;\n"
    buf = buf + "            } else {\n"
    buf = buf + "                // fork failed\n"
    buf = buf + "                hxlcl_close(pipefd[0]); hxlcl_close(pipefd[1]);\n"
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    if (!fp) {\n"
    buf = buf + "        fp = hxlcl_popen(cmd_s, \"r\");\n"
    buf = buf + "        if (!fp) return hexa_int((int64_t)-1);\n"
    buf = buf + "        child_pid = (pid_t)-1;                  // popen path: no usable pid\n"
    buf = buf + "    }\n"
    buf = buf + "    int fd = fileno(fp);\n"
    buf = buf + "    int flags = hxlcl_fcntl(fd, F_GETFL, 0);\n"
    buf = buf + "    if (flags >= 0) hxlcl_fcntl(fd, F_SETFL, flags | O_NONBLOCK);\n"
    buf = buf + "    _hexa_stream_slots[slot].fp = fp;\n"
    buf = buf + "    _hexa_stream_slots[slot].pid = child_pid;\n"
    buf = buf + "    _hexa_stream_slots[slot].buf_len = 0;\n"
    buf = buf + "    _hexa_stream_slots[slot].eof = 0;\n"
    buf = buf + "    _hexa_stream_slots[slot].in_use = 1;\n"
    buf = buf + "    _hexa_stream_slots[slot].stdin_fd = -1;     // exec_stream_async path is read-only\n"
    buf = buf + "    return hexa_int((int64_t)slot);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_exec_stream_async(HexaVal cmd) { return hexa_exec_stream_async_impl(cmd); }\n"
    buf = buf + "\n"
    buf = buf + "/* v1.2 (KI-5 RESOLVED, 2026-05-01) — per-call [done_int, line_str] protocol.\n"
    buf = buf + " *\n"
    buf = buf + " * Prior contract (v1.0/1.1): array-of-lines [line1, line2, ...] drained\n"
    buf = buf + " *   in one call. cli_mvp _stream_drain expected per-call [done, line]\n"
    buf = buf + " *   tuple → semantic mismatch → TUI 첫 chat 입력 시 crash (KI-5).\n"
    buf = buf + " *\n"
    buf = buf + " * New contract: each call extracts AT MOST one complete line.\n"
    buf = buf + " *   Returns: [done_int, line_str]\n"
    buf = buf + " *     done_int == 1 → stream EOF + buf drained (caller should close).\n"
    buf = buf + " *     done_int == 0 + line_str non-empty → one line ready, more may follow.\n"
    buf = buf + " *     done_int == 0 + line_str empty → EAGAIN (no data yet, not EOF).\n"
    buf = buf + " *   EOF with trailing partial buf (no final \\n): emit buf as final line\n"
    buf = buf + " *   on this call (done_int=0), then [1, \"\"] on next call.\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + " *\n"
    buf = buf + " * cli_mvp expectation (cli_mvp.hexa _stream_drain line 4703-4732):\n"
    buf = buf + " *   let r = exec_stream_poll(_stream_handle)\n"
    buf = buf + " *   let done = r[0]                 // bool/int 1=stream-finished\n"
    buf = buf + " *   let line = to_string(r[1])      // single complete line OR \"\"\n"
    buf = buf + " *   if len(line) > 0 { dispatch_line(line); ... }\n"
    buf = buf + " *   if done { return 1 }            // _stream_finish triggers\n"
    buf = buf + " *   if len(line) == 0 { return 0 }  // EAGAIN — wait next tick\n"
    buf = buf + " *\n"
    buf = buf + " * C3 honest C3: per-call drain ≤1 line. cli_mvp loops up to 64 times\n"
    buf = buf + " * per tick → 64 lines/tick max throughput. SSE typical throughput well\n"
    buf = buf + " * within bounds. follow-up8 minimum-viable.\n"
    buf = buf + " */\n"
    buf = buf + "HexaVal hexa_exec_stream_poll_impl(HexaVal handle) {\n"
    buf = buf + "    _hexa_stream_slots_ensure_init();\n"
    buf = buf + "    int h = (int)__hx_to_double(handle);\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (h < 0 || h >= HEXA_STREAM_SLOT_COUNT) {\n"
    buf = buf + "        hexa_array_push(out, hexa_int((int64_t)1));\n"
    buf = buf + "        hexa_array_push(out, hexa_str(\"\"));\n"
    buf = buf + "        return out;\n"
    buf = buf + "    }\n"
    buf = buf + "    HexaStreamSlot* s = &_hexa_stream_slots[h];\n"
    buf = buf + "    if (!s->in_use || !s->fp) {\n"
    buf = buf + "        hexa_array_push(out, hexa_int((int64_t)1));\n"
    buf = buf + "        hexa_array_push(out, hexa_str(\"\"));\n"
    buf = buf + "        return out;\n"
    buf = buf + "    }\n"
    buf = buf + "    /* Step 1: scan current buf for first newline. */\n"
    buf = buf + "    int nl_pos = -1;\n"
    buf = buf + "    for (int i = 0; i < s->buf_len; i++) {\n"
    buf = buf + "        if (s->buf[i] == '\\n') { nl_pos = i; break; }\n"
    buf = buf + "    }\n"
    buf = buf + "    /* Step 2: if no newline yet AND not EOF, try one non-blocking read.\n"
    buf = buf + "       Append bytes; rescan only newly-appended region for first newline. */\n"
    buf = buf + "    if (nl_pos < 0 && !s->eof) {\n"
    buf = buf + "        char chunk[4096];\n"
    buf = buf + "        ssize_t n = hxlcl_read(fileno(s->fp), chunk, sizeof(chunk));\n"
    buf = buf + "        if (n == 0) {\n"
    buf = buf + "            s->eof = 1;\n"
    buf = buf + "        } else if (n > 0) {\n"
    buf = buf + "            int start = s->buf_len;\n"
    buf = buf + "            for (ssize_t i = 0; i < n; i++) {\n"
    buf = buf + "                char c = chunk[i];\n"
    buf = buf + "                if (s->buf_len < s->buf_cap - 1) {\n"
    buf = buf + "                    s->buf[s->buf_len++] = c;\n"
    buf = buf + "                } else if (s->buf_cap < HEXA_STREAM_LINE_BUF_MAX) {\n"
    buf = buf + "                    int new_cap = s->buf_cap * 2;\n"
    buf = buf + "                    if (new_cap > HEXA_STREAM_LINE_BUF_MAX) new_cap = HEXA_STREAM_LINE_BUF_MAX;\n"
    buf = buf + "                    char* new_buf = (char*)realloc(s->buf, new_cap);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "                    if (new_buf) {\n"
    buf = buf + "                        s->buf = new_buf;\n"
    buf = buf + "                        s->buf_cap = new_cap;\n"
    buf = buf + "                        s->buf[s->buf_len++] = c;\n"
    buf = buf + "                    }\n"
    buf = buf + "                    /* realloc fail / 1MB cap hit 시 silent drop. C3 honest C3. */\n"
    buf = buf + "                }\n"
    buf = buf + "            }\n"
    buf = buf + "            /* Rescan from `start` (newly-appended region) for first newline. */\n"
    buf = buf + "            for (int i = start; i < s->buf_len; i++) {\n"
    buf = buf + "                if (s->buf[i] == '\\n') { nl_pos = i; break; }\n"
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "        /* n < 0 (EAGAIN) → fall through with nl_pos == -1, eof unchanged. */\n"
    buf = buf + "    }\n"
    buf = buf + "    /* Step 3: newline found → extract first line, shift buf. */\n"
    buf = buf + "    if (nl_pos >= 0) {\n"
    buf = buf + "        s->buf[nl_pos] = '\\0';\n"
    buf = buf + "        HexaVal line_v = hexa_str(s->buf);\n"
    buf = buf + "        int rem = s->buf_len - nl_pos - 1;\n"
    buf = buf + "        if (rem > 0) hxlcl_memmove(s->buf, s->buf + nl_pos + 1, rem);\n"
    buf = buf + "        s->buf_len = rem;\n"
    buf = buf + "        hexa_array_push(out, hexa_int((int64_t)0));\n"
    buf = buf + "        hexa_array_push(out, line_v);\n"
    buf = buf + "        return out;\n"
    buf = buf + "    }\n"
    buf = buf + "    /* Step 4: no newline. Handle EOF. */\n"
    buf = buf + "    if (s->eof) {\n"
    buf = buf + "        if (s->buf_len > 0) {\n"
    buf = buf + "            /* EOF + trailing partial buf (no final \\n) — emit as final line. */\n"
    buf = buf + "            s->buf[s->buf_len] = '\\0';\n"
    buf = buf + "            HexaVal line_v = hexa_str(s->buf);\n"
    buf = buf + "            s->buf_len = 0;\n"
    buf = buf + "            hexa_array_push(out, hexa_int((int64_t)0));\n"
    buf = buf + "            hexa_array_push(out, line_v);\n"
    buf = buf + "            return out;\n"
    buf = buf + "        }\n"
    buf = buf + "        /* Truly done. */\n"
    buf = buf + "        hexa_array_push(out, hexa_int((int64_t)1));\n"
    buf = buf + "        hexa_array_push(out, hexa_str(\"\"));\n"
    buf = buf + "        return out;\n"
    buf = buf + "    }\n"
    buf = buf + "    /* Step 5: EAGAIN. */\n"
    buf = buf + "    hexa_array_push(out, hexa_int((int64_t)0));\n"
    buf = buf + "    hexa_array_push(out, hexa_str(\"\"));\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_exec_stream_poll(HexaVal handle) { return hexa_exec_stream_poll_impl(handle); }\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_exec_stream_close_impl(HexaVal handle) {\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    _hexa_stream_slots_ensure_init();\n"
    buf = buf + "    int h = (int)__hx_to_double(handle);\n"
    buf = buf + "    if (h < 0 || h >= HEXA_STREAM_SLOT_COUNT) return hexa_int((int64_t)-1);\n"
    buf = buf + "    HexaStreamSlot* s = &_hexa_stream_slots[h];\n"
    buf = buf + "    if (!s->in_use || !s->fp) return hexa_int((int64_t)-1);\n"
    buf = buf + "    int raw_rc;\n"
    buf = buf + "    if (s->pid > 0) {\n"
    buf = buf + "        /* v1.3 fork path: close our pipe end, then reap the child. */\n"
    buf = buf + "        fclose(s->fp);\n"
    buf = buf + "        raw_rc = -1;\n"
    buf = buf + "        for (;;) {\n"
    buf = buf + "            int st = 0;\n"
    buf = buf + "            pid_t r = hxlcl_waitpid(s->pid, &st, 0);\n"
    buf = buf + "            if (r < 0) { if (errno == EINTR) continue; raw_rc = -1; break; }\n"
    buf = buf + "            raw_rc = st;  /* pclose-style encoded status */\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "    } else {\n"
    buf = buf + "        raw_rc = hxlcl_pclose(s->fp);  /* legacy popen fallback */\n"
    buf = buf + "    }\n"
    buf = buf + "    /* v1.1 WIFEXITED + WEXITSTATUS proper rc decode (C3 honest C3 — caller가\n"
    buf = buf + "       표준 exit code 패턴 사용 가능). Signal exit 시 negative signal 반환. */\n"
    buf = buf + "    int proper_rc;\n"
    buf = buf + "    if (raw_rc == -1) {\n"
    buf = buf + "        proper_rc = -1;  /* pclose/waitpid itself failed */\n"
    buf = buf + "    } else if (WIFEXITED(raw_rc)) {\n"
    buf = buf + "        proper_rc = WEXITSTATUS(raw_rc);\n"
    buf = buf + "    } else if (WIFSIGNALED(raw_rc)) {\n"
    buf = buf + "        proper_rc = -WTERMSIG(raw_rc);\n"
    buf = buf + "    } else {\n"
    buf = buf + "        proper_rc = -1;\n"
    buf = buf + "    }\n"
    buf = buf + "    s->fp = NULL;\n"
    buf = buf + "    s->pid = (pid_t)-1;\n"
    buf = buf + "    s->buf_len = 0;\n"
    buf = buf + "    s->eof = 0;\n"
    buf = buf + "    s->in_use = 0;\n"
    buf = buf + "    /* v1.4 — close stdin_fd if still hxlcl_open_sys(bidi path; safe no-op for read-only). */\n"
    buf = buf + "    if (s->stdin_fd >= 0) { hxlcl_close(s->stdin_fd); s->stdin_fd = -1; }\n"
    buf = buf + "    /* Note: s->buf 보존 (재사용 위해 free 안 함; 다음 spawn 시 재초기화). */\n"
    buf = buf + "    return hexa_int((int64_t)proper_rc);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_exec_stream_close(HexaVal handle) { return hexa_exec_stream_close_impl(handle); }\n"
    buf = buf + "\n"
    buf = buf + "// exec_stream_kill(handle) -> int (2026-05-11, wilson tool-core ESC-cancel) --\n"
    buf = buf + "// Promptly terminate the streaming child *process group*: SIGTERM, a short\n"
    buf = buf + "// grace poll, then SIGKILL -- then close our pipe end and reap. exec_stream_close\n"
    buf = buf + "// only pclose/waitpid-joins (blocks until the child exits on its own), so a\n"
    buf = buf + "// long-running `bash` tool would not die quickly on ESC. Returns:\n"
    buf = buf + "//   >= 0  : child terminated; value = -WTERMSIG (negative) when it exited via\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "//           signal (the SIGTERM/SIGKILL we sent), or its own WEXITSTATUS if it\n"
    buf = buf + "//           happened to exit cleanly during the grace window.\n"
    buf = buf + "//   -1    : stale/invalid handle, or a popen-fallback slot with no usable pid\n"
    buf = buf + "//           (C3 honest C3 -- prompt-kill needs exec_stream_async's fork\n"
    buf = buf + "//           path; on a popen slot the pipe is still fclose'd but the child is\n"
    buf = buf + "//           only reaped opportunistically and rc is -1).\n"
    buf = buf + "HexaVal hexa_exec_stream_kill_impl(HexaVal handle) {\n"
    buf = buf + "    _hexa_stream_slots_ensure_init();\n"
    buf = buf + "    int h = (int)__hx_to_double(handle);\n"
    buf = buf + "    if (h < 0 || h >= HEXA_STREAM_SLOT_COUNT) return hexa_int((int64_t)-1);\n"
    buf = buf + "    HexaStreamSlot* s = &_hexa_stream_slots[h];\n"
    buf = buf + "    if (!s->in_use || !s->fp) return hexa_int((int64_t)-1);\n"
    buf = buf + "    if (s->pid <= 0) {\n"
    buf = buf + "        /* popen fallback slot -- no pid. Best-effort: close the hxlcl_pipe(the child\n"
    buf = buf + "           sees EOF/SIGPIPE on its next write) and release the slot. */\n"
    buf = buf + "        fclose(s->fp);\n"
    buf = buf + "        s->fp = NULL; s->pid = (pid_t)-1; s->buf_len = 0; s->eof = 0; s->in_use = 0;\n"
    buf = buf + "        return hexa_int((int64_t)-1);\n"
    buf = buf + "    }\n"
    buf = buf + "    pid_t pid = s->pid;\n"
    buf = buf + "    pid_t pgid = pid;  /* setpgid(0,0) in the child made pid the group leader */\n"
    buf = buf + "    /* Step 1: polite SIGTERM to the whole group. */\n"
    buf = buf + "    hxlcl_kill(-pgid, SIGTERM);\n"
    buf = buf + "    /* Step 2: ~200ms grace, polled every 10ms via hxlcl_waitpid(WNOHANG). */\n"
    buf = buf + "    int reaped = 0; int raw_rc = -1;\n"
    buf = buf + "    for (int i = 0; i < 20; i++) {\n"
    buf = buf + "        int st = 0;\n"
    buf = buf + "        pid_t r = hxlcl_waitpid(pid, &st, WNOHANG);\n"
    buf = buf + "        if (r == pid) { reaped = 1; raw_rc = st; break; }\n"
    buf = buf + "        if (r < 0 && errno != EINTR && errno != 0) break;  /* ECHILD etc. */\n"
    buf = buf + "        struct timespec ts; ts.tv_sec = 0; ts.tv_nsec = 10L * 1000L * 1000L;  /* 10ms */\n"
    buf = buf + "        hxlcl_nanosleep(&ts, NULL);\n"
    buf = buf + "    }\n"
    buf = buf + "    /* Step 3: still alive -> SIGKILL the group and blocking-reap. */\n"
    buf = buf + "    if (!reaped) {\n"
    buf = buf + "        hxlcl_kill(-pgid, SIGKILL);\n"
    buf = buf + "        for (;;) {\n"
    buf = buf + "            int st = 0;\n"
    buf = buf + "            pid_t r = hxlcl_waitpid(pid, &st, 0);\n"
    buf = buf + "            if (r < 0) { if (errno == EINTR) continue; raw_rc = -1; break; }\n"
    buf = buf + "            raw_rc = st; break;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    /* Step 4: close our pipe end + release the slot. */\n"
    buf = buf + "    fclose(s->fp);\n"
    buf = buf + "    s->fp = NULL; s->pid = (pid_t)-1; s->buf_len = 0; s->eof = 0; s->in_use = 0;\n"
    buf = buf + "    int proper_rc;\n"
    buf = buf + "    if (raw_rc == -1) proper_rc = -1;\n"
    buf = buf + "    else if (WIFEXITED(raw_rc)) proper_rc = WEXITSTATUS(raw_rc);\n"
    buf = buf + "    else if (WIFSIGNALED(raw_rc)) proper_rc = -WTERMSIG(raw_rc);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    else proper_rc = -1;\n"
    buf = buf + "    return hexa_int((int64_t)proper_rc);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_exec_stream_kill(HexaVal handle) { return hexa_exec_stream_kill_impl(handle); }\n"
    buf = buf + "\n"
    buf = buf + "// codegen이 raw symbol `exec_stream_*` 도 emit (hexa_call1 indirect 패턴) —\n"
    buf = buf + "// non-prefixed alias 함수도 추가 (hexa_ prefix 미사용 form).\n"
    buf = buf + "HexaVal exec_stream_async(HexaVal cmd) { return hexa_exec_stream_async_impl(cmd); }\n"
    buf = buf + "HexaVal exec_stream_poll(HexaVal handle) { return hexa_exec_stream_poll_impl(handle); }\n"
    buf = buf + "HexaVal exec_stream_close(HexaVal handle) { return hexa_exec_stream_close_impl(handle); }\n"
    buf = buf + "HexaVal exec_stream_kill(HexaVal handle) { return hexa_exec_stream_kill_impl(handle); }\n"
    buf = buf + "\n"
    buf = buf + "// ── bidi-stdio primitives (2026-05-13, wilson MCP enabler) ──\n"
    buf = buf + "// hexa_exec_stream_open / _write / _close_stdin extend the existing read-only\n"
    buf = buf + "// async stream with a *write* side. Two-pipe variant: parent gets pipefd_in[1]\n"
    buf = buf + "// for writing to child stdin + pipefd_out[0] for reading child stdout.\n"
    buf = buf + "// Filed at incoming/patches/wilson-mcp-needs-bidi-stdio.md.\n"
    buf = buf + "//\n"
    buf = buf + "// Use case: MCP servers (JSON-RPC over stdio) — wilson sends `initialize`,\n"
    buf = buf + "// reads `result`, sends `tools/list`, reads `result`, etc. Same pattern any\n"
    buf = buf + "// long-running interactive subprocess (LSP, debug adapter, custom RPC).\n"
    buf = buf + "//\n"
    buf = buf + "// API (returns same int handle the read-only flavor returns; -1 on error):\n"
    buf = buf + "//   hexa_exec_stream_open(cmd)      — like async but bidi; returns handle\n"
    buf = buf + "//   hexa_exec_stream_write(h, data) — write to child stdin; returns bytes or -1\n"
    buf = buf + "//   hexa_exec_stream_close_stdin(h) — close write end (signals EOF to child);\n"
    buf = buf + "//                                      returns 0/-1\n"
    buf = buf + "//\n"
    buf = buf + "// Reads use the same hexa_exec_stream_poll. Final cleanup is the same\n"
    buf = buf + "// hexa_exec_stream_close (which also closes the stdin fd if open).\n"
    buf = buf + "HexaVal hexa_exec_stream_open_impl(HexaVal cmd) {\n"
    buf = buf + "    _hexa_stream_slots_ensure_init();\n"
    buf = buf + "    const char* cmd_s = HX_IS_STR(cmd) ? HX_STR(cmd) : NULL;\n"
    buf = buf + "    if (!cmd_s) return hexa_int((int64_t)-1);\n"
    buf = buf + "    int slot = -1;\n"
    buf = buf + "    for (int i = 0; i < HEXA_STREAM_SLOT_COUNT; i++) {\n"
    buf = buf + "        if (!_hexa_stream_slots[i].in_use) { slot = i; break; }\n"
    buf = buf + "    }\n"
    buf = buf + "    if (slot < 0) return hexa_int((int64_t)-1);\n"
    buf = buf + "    if (!_hexa_stream_slots[slot].buf) {\n"
    buf = buf + "        _hexa_stream_slots[slot].buf = (char*)malloc(HEXA_STREAM_LINE_BUF_INITIAL);\n"
    buf = buf + "        if (!_hexa_stream_slots[slot].buf) return hexa_int((int64_t)-1);\n"
    buf = buf + "        _hexa_stream_slots[slot].buf_cap = HEXA_STREAM_LINE_BUF_INITIAL;\n"
    buf = buf + "    }\n"
    buf = buf + "    fflush(NULL);\n"
    buf = buf + "    // Two pipes — pipe_in for parent→child stdin, pipe_out for child→parent stdout.\n"
    buf = buf + "    int pipe_in[2]  = { -1, -1 };\n"
    buf = buf + "    int pipe_out[2] = { -1, -1 };\n"
    buf = buf + "    if (hxlcl_pipe(pipe_in) != 0) return hexa_int((int64_t)-1);\n"
    buf = buf + "    if (hxlcl_pipe(pipe_out) != 0) {\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        hxlcl_close(pipe_in[0]); hxlcl_close(pipe_in[1]);\n"
    buf = buf + "        return hexa_int((int64_t)-1);\n"
    buf = buf + "    }\n"
    buf = buf + "    pid_t pid = hxlcl_fork();\n"
    buf = buf + "    if (pid < 0) {\n"
    buf = buf + "        hxlcl_close(pipe_in[0]); hxlcl_close(pipe_in[1]);\n"
    buf = buf + "        hxlcl_close(pipe_out[0]); hxlcl_close(pipe_out[1]);\n"
    buf = buf + "        return hexa_int((int64_t)-1);\n"
    buf = buf + "    }\n"
    buf = buf + "    if (pid == 0) {\n"
    buf = buf + "        // child\n"
    buf = buf + "        setpgid(0, 0);\n"
    buf = buf + "        // stdin ← pipe_in[0]\n"
    buf = buf + "        if (pipe_in[0] != STDIN_FILENO) {\n"
    buf = buf + "            hxlcl_dup2(pipe_in[0], STDIN_FILENO);\n"
    buf = buf + "            hxlcl_close(pipe_in[0]);\n"
    buf = buf + "        }\n"
    buf = buf + "        hxlcl_close(pipe_in[1]);\n"
    buf = buf + "        // stdout → pipe_out[1]\n"
    buf = buf + "        if (pipe_out[1] != STDOUT_FILENO) {\n"
    buf = buf + "            hxlcl_dup2(pipe_out[1], STDOUT_FILENO);\n"
    buf = buf + "            hxlcl_close(pipe_out[1]);\n"
    buf = buf + "        }\n"
    buf = buf + "        hxlcl_close(pipe_out[0]);\n"
    buf = buf + "        hxlcl_execl(\"/bin/sh\", \"sh\", \"-c\", cmd_s, (char*)NULL);\n"
    buf = buf + "        _exit(127);\n"
    buf = buf + "    }\n"
    buf = buf + "    // parent\n"
    buf = buf + "    hxlcl_close(pipe_in[0]);\n"
    buf = buf + "    hxlcl_close(pipe_out[1]);\n"
    buf = buf + "    setpgid(pid, pid);\n"
    buf = buf + "    FILE* fp = fdopen(pipe_out[0], \"r\");\n"
    buf = buf + "    if (!fp) {\n"
    buf = buf + "        hxlcl_close(pipe_out[0]); hxlcl_close(pipe_in[1]);\n"
    buf = buf + "        hxlcl_kill(-pid, SIGKILL); hxlcl_waitpid(pid, NULL, 0);\n"
    buf = buf + "        return hexa_int((int64_t)-1);\n"
    buf = buf + "    }\n"
    buf = buf + "    int rfd = fileno(fp);\n"
    buf = buf + "    int rflags = hxlcl_fcntl(rfd, F_GETFL, 0);\n"
    buf = buf + "    if (rflags >= 0) hxlcl_fcntl(rfd, F_SETFL, rflags | O_NONBLOCK);\n"
    buf = buf + "    // stdin fd kept blocking — caller decides write strategy via exec_stream_write.\n"
    buf = buf + "    _hexa_stream_slots[slot].fp = fp;\n"
    buf = buf + "    _hexa_stream_slots[slot].pid = pid;\n"
    buf = buf + "    _hexa_stream_slots[slot].stdin_fd = pipe_in[1];\n"
    buf = buf + "    _hexa_stream_slots[slot].buf_len = 0;\n"
    buf = buf + "    _hexa_stream_slots[slot].eof = 0;\n"
    buf = buf + "    _hexa_stream_slots[slot].in_use = 1;\n"
    buf = buf + "    return hexa_int((int64_t)slot);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "HexaVal hexa_exec_stream_write_impl(HexaVal handle, HexaVal data) {\n"
    buf = buf + "    int h = HX_IS_INT(handle) ? (int)HX_INT(handle) : -1;\n"
    buf = buf + "    if (h < 0 || h >= HEXA_STREAM_SLOT_COUNT) return hexa_int((int64_t)-1);\n"
    buf = buf + "    if (!_hexa_stream_slots[h].in_use) return hexa_int((int64_t)-1);\n"
    buf = buf + "    int fd = _hexa_stream_slots[h].stdin_fd;\n"
    buf = buf + "    if (fd < 0) return hexa_int((int64_t)-1);   // read-only slot\n"
    buf = buf + "    const char* s = HX_IS_STR(data) ? HX_STR(data) : NULL;\n"
    buf = buf + "    if (!s) return hexa_int((int64_t)-1);\n"
    buf = buf + "    size_t total = hxlcl_strlen(s);\n"
    buf = buf + "    size_t written = 0;\n"
    buf = buf + "    while (written < total) {\n"
    buf = buf + "        ssize_t n = hxlcl_write(fd, s + written, total - written);\n"
    buf = buf + "        if (n < 0) {\n"
    buf = buf + "            if (errno == EINTR) continue;\n"
    buf = buf + "            return hexa_int((int64_t)-1);\n"
    buf = buf + "        }\n"
    buf = buf + "        if (n == 0) break;\n"
    buf = buf + "        written += (size_t)n;\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int((int64_t)written);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_exec_stream_close_stdin_impl(HexaVal handle) {\n"
    buf = buf + "    int h = HX_IS_INT(handle) ? (int)HX_INT(handle) : -1;\n"
    buf = buf + "    if (h < 0 || h >= HEXA_STREAM_SLOT_COUNT) return hexa_int((int64_t)-1);\n"
    buf = buf + "    if (!_hexa_stream_slots[h].in_use) return hexa_int((int64_t)-1);\n"
    buf = buf + "    int fd = _hexa_stream_slots[h].stdin_fd;\n"
    buf = buf + "    if (fd < 0) return hexa_int((int64_t)-1);\n"
    buf = buf + "    hxlcl_close(fd);\n"
    buf = buf + "    _hexa_stream_slots[h].stdin_fd = -1;\n"
    buf = buf + "    return hexa_int((int64_t)0);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Wrappers — hexa_ prefix forwards + raw symbol aliases for codegen indirect path.\n"
    buf = buf + "HexaVal hexa_exec_stream_open(HexaVal cmd) { return hexa_exec_stream_open_impl(cmd); }\n"
    buf = buf + "HexaVal hexa_exec_stream_write(HexaVal handle, HexaVal data) { return hexa_exec_stream_write_impl(handle, data); }\n"
    buf = buf + "HexaVal hexa_exec_stream_close_stdin(HexaVal handle) { return hexa_exec_stream_close_stdin_impl(handle); }\n"
    buf = buf + "HexaVal exec_stream_open(HexaVal cmd) { return hexa_exec_stream_open_impl(cmd); }\n"
    buf = buf + "HexaVal exec_stream_write(HexaVal handle, HexaVal data) { return hexa_exec_stream_write_impl(handle, data); }\n"
    buf = buf + "HexaVal exec_stream_close_stdin(HexaVal handle) { return hexa_exec_stream_close_stdin_impl(handle); }\n"
    buf = buf + "\n"
    buf = buf + "/* Path A (A′) builtin shims — is_alpha/is_alphanumeric have no runtime\n"
    buf = buf + " * symbol (legacy codegen inlines them as C exprs). The native\n"
    buf = buf + " * compiler codegen backend calls them as functions, so provide additive\n"
    buf = buf + " * linkable wrappers mirroring codegen:3527/3535 exactly. Pure-\n"
    buf = buf + " * additive: legacy C path inlines and never calls these → no collision. */\n"
    buf = buf + "HexaVal hexa_is_alpha(HexaVal a) {\n"
    buf = buf + "    return hexa_bool((HX_IS_STR(a) && HX_STR(a) && hxlcl_isalpha((unsigned char)HX_STR(a)[0]))\n"
    buf = buf + "                  || (HX_TAG(a) == TAG_CHAR && hxlcl_isalpha((unsigned char)HX_INT(a))));\n"
    buf = buf + "}\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "HexaVal hexa_is_alphanumeric(HexaVal a) {\n"
    buf = buf + "    return hexa_bool((HX_IS_STR(a) && HX_STR(a) && hxlcl_isalnum((unsigned char)HX_STR(a)[0]))\n"
    buf = buf + "                  || (HX_TAG(a) == TAG_CHAR && hxlcl_isalnum((unsigned char)HX_INT(a))));\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + " * forge_tier_v1 — flame <-> forge integration ABI (RFC 050 Stage A).\n"
    buf = buf + " *\n"
    buf = buf + " * v1 dispatch surface: forge_api_version_v1, forge_tier_dispatch_v1,\n"
    buf = buf + " * forge_register_specialized_v1. Stage A lands the API surface +\n"
    buf = buf + " * stub dispatcher; Stage 2 substrates (RFC 044 A'/B'/C', RFC 049\n"
    buf = buf + " * BF16, RFC 048 fused) wire kernel-by-kernel through the same v1\n"
    buf = buf + " * entry points.\n"
    buf = buf + " *\n"
    buf = buf + " * Inlined here so the dispatcher's MATMUL+FP64 path can call\n"
    buf = buf + " * hexa_farr_matmul directly (no forward-decl skew). Header at\n"
    buf = buf + " * self/forge/forge_tier_v1.h is the stable public surface.\n"
    buf = buf + " *\n"
    buf = buf + " * SSOT: inbox/rfc_drafts_2026_05_12/rfc_050_flame_forge_integration.md\n"
    buf = buf + " * ═══════════════════════════════════════════════════════════════════ */\n"
    buf = buf + "#define FORGE_TIER_V1_LIVE 1\n"
    buf = buf + "/* RFC 050 PERF-INHERITANCE: open the dispatcher's BF16 substrate path\n"
    buf = buf + " * when CUDA is compiled in. The substrate's hexa_farr_*_bf16_gpu symbols\n"
    buf = buf + " * live in runtime_cuda.c (which #includes runtime_bf16.c) — already\n"
    buf = buf + " * link-resolved in any -DHEXA_CUDA build. On no-CUDA hosts the macro\n"
    buf = buf + " * stays undefined so forge_tier_v1.c keeps returning\n"
    buf = buf + " * FORGE_PRECISION_UNSUPPORTED gracefully (no link dependency). */\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "#define FORGE_TIER_V1_BF16 1\n"
    buf = buf + "#endif\n"
    buf = buf + "#include \"forge/forge_tier_v1.c\"\n"
    buf = buf + "\n"
    buf = buf + "/* ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + " * hexa_forge_dispatch_matmul — RFC 050 L1 slice 1.\n"
    buf = buf + " *\n"
    buf = buf + " * The hexa-callable wrapper around the forge dispatcher. flame's NN\n"
    buf = buf + " * stdlib calls the `forge_dispatch_matmul` builtin (codegen.hexa\n"
    buf = buf + " * lowers it here) so its FP64 GPU matmul routes through the RFC 050\n"
    buf = buf + " * dispatch contract instead of calling hexa_farr_matmul directly.\n"
    buf = buf + " *\n"
    buf = buf + " *   forge_dispatch_matmul(a_farr, M, K, b_farr, N) -> c_farr\n"
    buf = buf + " *\n"
    buf = buf + " * Packs a ForgeShapeInfo (M,K,N) + a ForgeArgs in=[A,B] / out=[C] and\n"
    buf = buf + " * invokes forge_tier_dispatch_v1(FORGE_KERNEL_MATMUL, ..., FP64,\n"
    buf = buf + " * DET_DEFAULT, ...). The dispatcher's MATMUL+FP64 path (RFC 040\n"
    buf = buf + " * baseline) writes the produced farr id back into out.farr_ids[0] —\n"
    buf = buf + " * see the output-farr contract comment in forge_tier_v1.c. This\n"
    buf = buf + " * wrapper unwraps that id and returns it as a HexaVal handle.\n"
    buf = buf + " *\n"
    buf = buf + " * Return codes: forge_tier_dispatch_v1 returns FORGE_OK or\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + " * FORGE_FALLBACK_USED on a successful dispatch (Stage A always reports\n"
    buf = buf + " * FALLBACK_USED — the specialized registry is empty). Any negative\n"
    buf = buf + " * return code, or a negative produced id, surfaces as hexa_int(-1) so\n"
    buf = buf + " * the hexa caller can branch on failure exactly like hexa_farr_matmul.\n"
    buf = buf + " *\n"
    buf = buf + " * Defined here (after the forge_tier_v1.c inline include) so\n"
    buf = buf + " * forge_tier_dispatch_v1 + the ForgeShapeInfo/ForgeArgs types are in\n"
    buf = buf + " * scope without a forward declaration.\n"
    buf = buf + " * ═══════════════════════════════════════════════════════════════════ */\n"
    buf = buf + "HexaVal hexa_forge_dispatch_matmul(HexaVal a_v, HexaVal m_v, HexaVal k_v,\n"
    buf = buf + "                                   HexaVal b_v, HexaVal n_v) {\n"
    buf = buf + "    int64_t a_id = hexa_as_num(a_v);\n"
    buf = buf + "    int64_t M    = hexa_as_num(m_v);\n"
    buf = buf + "    int64_t K    = hexa_as_num(k_v);\n"
    buf = buf + "    int64_t b_id = hexa_as_num(b_v);\n"
    buf = buf + "    int64_t N    = hexa_as_num(n_v);\n"
    buf = buf + "\n"
    buf = buf + "    ForgeShapeInfo shape;\n"
    buf = buf + "    shape.M = M;\n"
    buf = buf + "    shape.N = N;\n"
    buf = buf + "    shape.K = K;\n"
    buf = buf + "    shape.batch = 0;\n"
    buf = buf + "\n"
    buf = buf + "    ForgeArgs in;\n"
    buf = buf + "    in.farr_ids[0] = a_id;\n"
    buf = buf + "    in.farr_ids[1] = b_id;\n"
    buf = buf + "    in.count = 2;\n"
    buf = buf + "\n"
    buf = buf + "    ForgeArgs out;\n"
    buf = buf + "    out.farr_ids[0] = -1;  /* OUT slot — dispatcher overwrites with produced id */\n"
    buf = buf + "    out.count = 1;\n"
    buf = buf + "\n"
    buf = buf + "    int rc = forge_tier_dispatch_v1(FORGE_KERNEL_MATMUL, &shape,\n"
    buf = buf + "                                    FORGE_REGIME_AUTO, FORGE_PREC_FP64,\n"
    buf = buf + "                                    FORGE_DET_DEFAULT, &in, &out);\n"
    buf = buf + "    /* FORGE_OK (0) and FORGE_FALLBACK_USED (1) are both successful\n"
    buf = buf + "     * dispatches; negative codes are genuine errors. */\n"
    buf = buf + "    if (rc < 0)                  return hexa_int(-1);\n"
    buf = buf + "    int64_t c_id = out.farr_ids[0];\n"
    buf = buf + "    if (c_id < 0)                return hexa_int(-1);\n"
    buf = buf + "    return hexa_int(c_id);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + " * BF16 substrate externs (RFC 049 / RFC 050 PERF-INHERITANCE).\n"
    buf = buf + " *\n"
    buf = buf + " * runtime_bf16.c lives in a sibling TU compiled with HEXA_CUDA — its\n"
    buf = buf + " * symbols (HexaFarrBf16 + hexa_farr_bf16_*) are linked at build time\n"
    buf = buf + " * when HEXA_CUDA is set. Declare the surface here so the wrapper below\n"
    buf = buf + " * compiles. Mirrors the FORGE_TIER_V1_BF16 forward decls in\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + " * forge_tier_v1.c — same opaque-pointer ABI (RFC 050 §6.3).\n"
    buf = buf + " *\n"
    buf = buf + " * On no-CUDA hosts these externs are never referenced (the wrapper's\n"
    buf = buf + " * body is guarded with `#ifdef HEXA_CUDA`), so the link surface stays\n"
    buf = buf + " * unchanged for portable builds.\n"
    buf = buf + " * ═══════════════════════════════════════════════════════════════════ */\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "typedef struct HexaFarrBf16 HexaFarrBf16;\n"
    buf = buf + "extern HexaFarrBf16* hexa_farr_bf16_alloc(int64_t len);\n"
    buf = buf + "extern void          hexa_farr_bf16_free(HexaFarrBf16* f);\n"
    buf = buf + "extern int           hexa_farr_bf16_from_f64(const double* src,\n"
    buf = buf + "                                             HexaFarrBf16* dst, int64_t n);\n"
    buf = buf + "extern int           hexa_farr_bf16_to_f64(const HexaFarrBf16* src,\n"
    buf = buf + "                                           double* dst, int64_t n);\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "/* ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + " * hexa_forge_dispatch_ffn_fp64_via_bf16 — RFC 050 PERF-INHERITANCE.\n"
    buf = buf + " *\n"
    buf = buf + " * The hexa-callable wrapper around the forge BF16 FFN substrate. flame's\n"
    buf = buf + " * NN stdlib gets a 7-arg builtin `forge_dispatch_ffn_fp64_via_bf16` whose\n"
    buf = buf + " * signature is in FP64 farrs (the hexa-side currency) — the wrapper\n"
    buf = buf + " * internally allocates HexaFarrBf16 handles, RNE-casts FP64 → BF16,\n"
    buf = buf + " * routes through forge_tier_dispatch_v1(FFN_FUSED, PURE_BF16), then\n"
    buf = buf + " * casts BF16 → FP64 back into the caller-supplied output FP64 farr.\n"
    buf = buf + " *\n"
    buf = buf + " *   forge_dispatch_ffn_fp64_via_bf16(x_id, w1_id, w2_id, y_id,\n"
    buf = buf + " *                                    M, D, FD) -> int rc\n"
    buf = buf + " *\n"
    buf = buf + " * Shapes: X[M·D], W1[D·FD], W2[FD·D], Y[M·D] — same as the substrate\n"
    buf = buf + " * kernel hexa_farr_ffn_bf16_gpu. Returns 0 on success, -1 on any error\n"
    buf = buf + " * (no-CUDA host, OOM, dispatch failure, shape mismatch with the FP64\n"
    buf = buf + " * farr lengths in the global table).\n"
    buf = buf + " *\n"
    buf = buf + " * Falsifier anchor: RFC 049 Stage 2 measured hexa_farr_ffn_bf16_gpu at\n"
    buf = buf + " * 11.66× FP64 cuBLAS Dgemm (128·768·3072 FFN, A100). This wrapper adds\n"
    buf = buf + " * host↔device + FP64↔BF16 cast overhead; the falsifier gate is ≥5×\n"
    buf = buf + " * over FP64 cuBLAS to absorb that overhead honestly. The state design\n"
    buf = buf + " * doc state/forge_rfc050_perf_inherit_2026_05_19/design.md tracks the\n"
    buf = buf + " * scope: routing capability + measurement; flame call-site rewiring\n"
    buf = buf + " * is a follow-up.\n"
    buf = buf + " *\n"
    buf = buf + " * No-CUDA fallback: when HEXA_CUDA is not defined the BF16 substrate\n"
    buf = buf + " * is not linked in, so the wrapper short-circuits to -1. Callers\n"
    buf = buf + " * (flame nn_lib::nn_ffn_bf16_fwd) MUST check the rc and fall back to\n"
    buf = buf + " * the FP64 nn_swiglu / nn_linear path.\n"
    buf = buf + " * ═══════════════════════════════════════════════════════════════════ */\n"
    buf = buf + "HexaVal hexa_forge_dispatch_ffn_fp64_via_bf16(HexaVal x_v, HexaVal w1_v,\n"
    buf = buf + "                                              HexaVal w2_v, HexaVal y_v,\n"
    buf = buf + "                                              HexaVal m_v, HexaVal d_v,\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "                                              HexaVal fd_v) {\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "    int64_t x_id  = hexa_as_num(x_v);\n"
    buf = buf + "    int64_t w1_id = hexa_as_num(w1_v);\n"
    buf = buf + "    int64_t w2_id = hexa_as_num(w2_v);\n"
    buf = buf + "    int64_t y_id  = hexa_as_num(y_v);\n"
    buf = buf + "    int64_t M     = hexa_as_num(m_v);\n"
    buf = buf + "    int64_t D     = hexa_as_num(d_v);\n"
    buf = buf + "    int64_t FD    = hexa_as_num(fd_v);\n"
    buf = buf + "\n"
    buf = buf + "    /* Validate the FP64 farr handles + lengths against the host\n"
    buf = buf + "     * _hx_farr_table. The BF16 wrapper is a no-op on bad inputs — never\n"
    buf = buf + "     * crash the caller (mirrors hexa_farr_get / _set soft-fail). */\n"
    buf = buf + "    if (x_id  < 0 || x_id  >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (w1_id < 0 || w1_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (w2_id < 0 || w2_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (y_id  < 0 || y_id  >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (M <= 0 || D <= 0 || FD <= 0)          return hexa_int(-1);\n"
    buf = buf + "\n"
    buf = buf + "    HexaFarrEntry *eX  = &_hx_farr_table[x_id];\n"
    buf = buf + "    HexaFarrEntry *eW1 = &_hx_farr_table[w1_id];\n"
    buf = buf + "    HexaFarrEntry *eW2 = &_hx_farr_table[w2_id];\n"
    buf = buf + "    HexaFarrEntry *eY  = &_hx_farr_table[y_id];\n"
    buf = buf + "    int64_t nX = M * D, nW1 = D * FD, nW2 = FD * D, nY = M * D;\n"
    buf = buf + "    if (!eX->buf  || eX->len  < nX)           return hexa_int(-1);\n"
    buf = buf + "    if (!eW1->buf || eW1->len < nW1)          return hexa_int(-1);\n"
    buf = buf + "    if (!eW2->buf || eW2->len < nW2)          return hexa_int(-1);\n"
    buf = buf + "    if (!eY->buf  || eY->len  < nY)           return hexa_int(-1);\n"
    buf = buf + "\n"
    buf = buf + "    /* Allocate BF16 staging buffers. Lifetime is THIS call only; the\n"
    buf = buf + "     * substrate's HexaFarrBf16 lifecycle is private to the wrapper. */\n"
    buf = buf + "    HexaFarrBf16 *bfX  = hexa_farr_bf16_alloc(nX);\n"
    buf = buf + "    HexaFarrBf16 *bfW1 = hexa_farr_bf16_alloc(nW1);\n"
    buf = buf + "    HexaFarrBf16 *bfW2 = hexa_farr_bf16_alloc(nW2);\n"
    buf = buf + "    HexaFarrBf16 *bfY  = hexa_farr_bf16_alloc(nY);\n"
    buf = buf + "    if (!bfX || !bfW1 || !bfW2 || !bfY) {\n"
    buf = buf + "        if (bfX)  hexa_farr_bf16_free(bfX);\n"
    buf = buf + "        if (bfW1) hexa_farr_bf16_free(bfW1);\n"
    buf = buf + "        if (bfW2) hexa_farr_bf16_free(bfW2);\n"
    buf = buf + "        if (bfY)  hexa_farr_bf16_free(bfY);\n"
    buf = buf + "        return hexa_int(-1);\n"
    buf = buf + "    }\n"
    buf = buf + "\n"
    buf = buf + "    /* RNE cast FP64 host master → BF16 host buffer (host-side; the\n"
    buf = buf + "     * substrate's _to_device upload happens inside the kernel). */\n"
    buf = buf + "    if (hexa_farr_bf16_from_f64(eX->buf,  bfX,  nX)  != 0 ||\n"
    buf = buf + "        hexa_farr_bf16_from_f64(eW1->buf, bfW1, nW1) != 0 ||\n"
    buf = buf + "        hexa_farr_bf16_from_f64(eW2->buf, bfW2, nW2) != 0) {\n"
    buf = buf + "        hexa_farr_bf16_free(bfX);  hexa_farr_bf16_free(bfW1);\n"
    buf = buf + "        hexa_farr_bf16_free(bfW2); hexa_farr_bf16_free(bfY);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        return hexa_int(-1);\n"
    buf = buf + "    }\n"
    buf = buf + "\n"
    buf = buf + "    /* Pack ForgeArgs (RFC 050 §6.3 BF16 ABI — farr_ids carry the\n"
    buf = buf + "     * HexaFarrBf16* cast through intptr_t). */\n"
    buf = buf + "    ForgeShapeInfo shape;\n"
    buf = buf + "    shape.M     = M;\n"
    buf = buf + "    shape.K     = D;   /* FFN_FUSED mapping: shape.K -> kernel D */\n"
    buf = buf + "    shape.N     = FD;  /* shape.N -> kernel FD                     */\n"
    buf = buf + "    shape.batch = 0;\n"
    buf = buf + "\n"
    buf = buf + "    ForgeArgs in;\n"
    buf = buf + "    in.farr_ids[0] = (int64_t)(intptr_t)bfX;\n"
    buf = buf + "    in.farr_ids[1] = (int64_t)(intptr_t)bfW1;\n"
    buf = buf + "    in.farr_ids[2] = (int64_t)(intptr_t)bfW2;\n"
    buf = buf + "    in.count       = 3;\n"
    buf = buf + "\n"
    buf = buf + "    ForgeArgs out;\n"
    buf = buf + "    out.farr_ids[0] = (int64_t)(intptr_t)bfY;\n"
    buf = buf + "    out.count       = 1;\n"
    buf = buf + "\n"
    buf = buf + "    int rc = forge_tier_dispatch_v1(FORGE_KERNEL_FFN_FUSED, &shape,\n"
    buf = buf + "                                    FORGE_REGIME_AUTO, FORGE_PREC_PURE_BF16,\n"
    buf = buf + "                                    FORGE_DET_DEFAULT, &in, &out);\n"
    buf = buf + "\n"
    buf = buf + "    /* On dispatcher OK, BF16 host buffer is authoritative (substrate\n"
    buf = buf + "     * D2H'd after the kernel). Cast BF16 → FP64 back into the caller's\n"
    buf = buf + "     * FP64 farr. */\n"
    buf = buf + "    int wrapper_rc = -1;\n"
    buf = buf + "    if (rc == FORGE_OK) {\n"
    buf = buf + "        if (hexa_farr_bf16_to_f64(bfY, eY->buf, nY) == 0) {\n"
    buf = buf + "            wrapper_rc = 0;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "\n"
    buf = buf + "    hexa_farr_bf16_free(bfX);  hexa_farr_bf16_free(bfW1);\n"
    buf = buf + "    hexa_farr_bf16_free(bfW2); hexa_farr_bf16_free(bfY);\n"
    buf = buf + "    return hexa_int(wrapper_rc);\n"
    buf = buf + "#else\n"
    buf = buf + "    /* No-CUDA host: BF16 substrate not linked in; honest -1.\n"
    buf = buf + "     * Suppress unused-arg warnings. */\n"
    buf = buf + "    (void)x_v; (void)w1_v; (void)w2_v; (void)y_v;\n"
    buf = buf + "    (void)m_v; (void)d_v;  (void)fd_v;\n"
    buf = buf + "    return hexa_int(-1);\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* Cycle 55 recovery — bodies for rt_fs_* declared in runtime.h §G5.\n"
    buf = buf + " * Origin/main left these as orphaned declarations (no bodies anywhere on\n"
    buf = buf + " * disk). append_atomic/stat/rotate remain failure-default stubs; mkdir_p\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + " * now carries the real fork-free recursive POSIX mkdir(2) impl that the\n"
    buf = buf + " * deleted body and self/stdlib/fs.hexa tests 26-28 + the codegen comment\n"
    buf = buf + " * (self/codegen.hexa fs_mkdir_p arm) specify.\n"
    buf = buf + " *\n"
    buf = buf + " * F3 class-D new-axes batch (this PR) extends the 2-way gate to 3-way:\n"
    buf = buf + " *   - HEXA_RT_SELFEMIT       → extern (self-emit .o defines _rt_fs_*)\n"
    buf = buf + " *   - !HEXA_HAS_HEXA_RT_STDLIB → standalone C body (origin/main shape)\n"
    buf = buf + " *   - else                   → extern (aprime_cc hexa transpile defines)\n"
    buf = buf + " * Default build (neither flag) hits path 3 → BYTE-IDENTICAL to origin/main.\n"
    buf = buf + " *\n"
    buf = buf + " * Class-D pool axes covered:\n"
    buf = buf + " *   - rt_fs_stat            : 1-HexaVal arg discarded + hexa_void() return\n"
    buf = buf + " *                             (NEW SHAPE: 5 instr · 20 B · BRANCH26 @0x08;\n"
    buf = buf + " *                             no arg-setup before `bl _hexa_void`).\n"
    buf = buf + " *   - rt_fs_append_atomic   : 2-HexaVal args discarded + hexa_int(-1) MOVN\n"
    buf = buf + " *                             (structural replicate of rt_net_fail; same 24 B).\n"
    buf = buf + " *   - rt_fs_rotate_if_over  : 3-HexaVal args discarded + hexa_int(0)\n"
    buf = buf + " *                             (structural replicate of rt_posix_ok; same 24 B).\n"
    buf = buf + " */\n"
    buf = buf + "#if defined(HEXA_RT_SELFEMIT)\n"
    buf = buf + "extern HexaVal rt_fs_append_atomic(HexaVal path, HexaVal data);\n"
    buf = buf + "extern HexaVal rt_fs_stat(HexaVal path);\n"
    buf = buf + "extern HexaVal rt_fs_rotate_if_over(HexaVal path, HexaVal max_bytes, HexaVal keep);\n"
    buf = buf + "#elif !defined(HEXA_HAS_HEXA_RT_STDLIB)\n"
    buf = buf + "HexaVal rt_fs_append_atomic(HexaVal path, HexaVal data) {\n"
    buf = buf + "    (void)path; (void)data;\n"
    buf = buf + "    return hexa_int(-1);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal rt_fs_stat(HexaVal path) {\n"
    buf = buf + "    (void)path;\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal rt_fs_rotate_if_over(HexaVal path, HexaVal max_bytes, HexaVal keep) {\n"
    buf = buf + "    (void)path; (void)max_bytes; (void)keep;\n"
    buf = buf + "    return hexa_int(0);\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_fs_append_atomic(HexaVal path, HexaVal data);\n"
    buf = buf + "extern HexaVal rt_fs_stat(HexaVal path);\n"
    buf = buf + "extern HexaVal rt_fs_rotate_if_over(HexaVal path, HexaVal max_bytes, HexaVal keep);\n"
    buf = buf + "#endif\n"
    buf = buf + "/* Returns 0 on success (incl. already-exists / idempotent), or -errno on\n"
    buf = buf + " * failure (e.g. -ENOTDIR when a path prefix is a regular file). EEXIST on an\n"
    buf = buf + " * intermediate component is \"present, continue\"; a non-dir prefix surfaces\n"
    buf = buf + " * via the next-level mkdir's ENOTDIR. */\n"
    buf = buf + "HexaVal rt_fs_mkdir_p(HexaVal path) {\n"
    buf = buf + "    const char* p = HX_STR(path);\n"
    buf = buf + "    if (!p || !*p) return hexa_int(-EINVAL);\n"
    buf = buf + "    size_t plen = strlen(p);\n"
    buf = buf + "    char* buf = (char*)malloc(plen + 1);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    if (!buf) return hexa_int(-ENOMEM);\n"
    buf = buf + "    memcpy(buf, p, plen + 1);\n"
    buf = buf + "    if (plen > 1 && buf[plen - 1] == '/') buf[plen - 1] = '\\0';\n"
    buf = buf + "    int rc = 0;\n"
    buf = buf + "    for (char* q = buf + 1; *q; q++) {\n"
    buf = buf + "        if (*q == '/') {\n"
    buf = buf + "            *q = '\\0';\n"
    buf = buf + "            if (hxlcl_mkdir(buf, 0755) != 0 && errno != EEXIST) { rc = -errno; break; }\n"
    buf = buf + "            *q = '/';\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    if (rc == 0 && hxlcl_mkdir(buf, 0755) != 0 && errno != EEXIST) rc = -errno;\n"
    buf = buf + "    free(buf);\n"
    buf = buf + "    return hexa_int(rc);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + "// HOTFIX 2026-05-27 — production-safety stubs for hexa-emit-wired fns.\n"
    buf = buf + "//\n"
    buf = buf + "// PR #1391/#1394 deleted the C bodies for 20 wires (#1331 table),\n"
    buf = buf + "// expecting only builds that include the strong hexa-emit .o to link.\n"
    buf = buf + "// However `hexa run`/`hexa build` (via hexat transpiler) does NOT\n"
    buf = buf + "// include strong .o overrides → undefined-symbol link failures for\n"
    buf = buf + "// any compiled hexa program that references these symbols.\n"
    buf = buf + "//\n"
    buf = buf + "// Restoration: weak stubs matching the wired behavior. The hexa-emit\n"
    buf = buf + "// strong .o still wins at link time when present (production); the\n"
    buf = buf + "// stubs satisfy link otherwise (default hexa run/build).\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + "\n"
    buf = buf + "__attribute__((weak)) HexaVal hexa_exit(HexaVal code) { hxlcl_exit((int)HX_INT(code)); return hexa_void(); }\n"
    buf = buf + "__attribute__((weak)) HexaVal hexa_ptr_null(void) { return hexa_int(0); }\n"
    buf = buf + "__attribute__((weak)) HexaVal hexa_ptr_addr(HexaVal v) { return hexa_int((int64_t)HX_INT_U(v)); }\n"
    buf = buf + "__attribute__((weak)) HexaVal hexa_ptr_alloc(HexaVal size_v) {\n"
    buf = buf + "    int64_t sz = HX_IS_INT(size_v) ? HX_INT(size_v) : 0;\n"
    buf = buf + "    if (sz <= 0) return hexa_int(0);\n"
    buf = buf + "    void* p = malloc((size_t)sz);\n"
    buf = buf + "    return hexa_int((int64_t)(uintptr_t)p);\n"
    buf = buf + "}\n"
    buf = buf + "__attribute__((weak)) HexaVal hexa_ptr_free(HexaVal ptr_v, HexaVal size_v) {\n"
    buf = buf + "    (void)size_v;\n"
    buf = buf + "    uint64_t p = HX_IS_INT(ptr_v) ? HX_INT_U(ptr_v) : 0;\n"
    buf = buf + "    if (p != 0) free((void*)(uintptr_t)p);\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "__attribute__((weak)) HexaVal hexa_ptr_offset(HexaVal ptr_v, HexaVal off_v) {\n"
    buf = buf + "    uint64_t p = HX_IS_INT(ptr_v) ? HX_INT_U(ptr_v) : 0;\n"
    buf = buf + "    int64_t off = HX_IS_INT(off_v) ? HX_INT(off_v) : 0;\n"
    buf = buf + "    return hexa_int((int64_t)(p + (uint64_t)off));\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "}\n"
    buf = buf + "__attribute__((weak)) HexaVal hexa_deref(HexaVal ptr_v) {\n"
    buf = buf + "    uint64_t p = HX_IS_INT(ptr_v) ? HX_INT_U(ptr_v) : 0;\n"
    buf = buf + "    if (p == 0) return hexa_int(0);\n"
    buf = buf + "    return hexa_int(*(int64_t*)(uintptr_t)p);\n"
    buf = buf + "}\n"
    buf = buf + "__attribute__((weak)) HexaVal hexa_ptr_read(HexaVal ptr_v, HexaVal off_v) {\n"
    buf = buf + "    uint64_t p = HX_IS_INT(ptr_v) ? HX_INT_U(ptr_v) : 0;\n"
    buf = buf + "    int64_t off = HX_IS_INT(off_v) ? HX_INT(off_v) : 0;\n"
    buf = buf + "    if (p == 0) return hexa_int(0);\n"
    buf = buf + "    return hexa_int(*(int64_t*)(uintptr_t)(p + (uint64_t)off));\n"
    buf = buf + "}\n"
    buf = buf + "__attribute__((weak)) HexaVal hexa_ptr_write(HexaVal ptr_v, HexaVal off_v, HexaVal val_v) {\n"
    buf = buf + "    uint64_t p = HX_IS_INT(ptr_v) ? HX_INT_U(ptr_v) : 0;\n"
    buf = buf + "    int64_t off = HX_IS_INT(off_v) ? HX_INT(off_v) : 0;\n"
    buf = buf + "    if (p == 0) return hexa_void();\n"
    buf = buf + "    *(int64_t*)(uintptr_t)(p + (uint64_t)off) = HX_IS_INT(val_v) ? HX_INT(val_v) : 0;\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "/* INBOX #1676 (2026-05-27, anima H100 fire) — strong overrides for the\n"
    buf = buf + " * HEXA_CUDA build. Without these, the weak stubs below win and\n"
    buf = buf + " * `cuda_available()` returns 0 even with a real GPU + cuBLAS link,\n"
    buf = buf + " * silently routing every dispatch site to the CPU fallback. Externs\n"
    buf = buf + " * forward-declared at runtime.c:8405-8406; bodies live in\n"
    buf = buf + " * self/cuda/runtime_cuda.c (lines 248, 255). */\n"
    buf = buf + "HexaVal hexa_cuda_available(void)    { return hexa_int(_hx_cuda_runtime_available()); }\n"
    buf = buf + "HexaVal hexa_cuda_device_count(void) { return hexa_int(_hx_cuda_device_count_impl()); }\n"
    buf = buf + "/* #4214 forge determinism API builtins — CUDA branch bridges the real C-ABI\n"
    buf = buf + " * hexa_forge_set_deterministic (body in runtime_cuda.c). Forward-declare the\n"
    buf = buf + " * C-ABI fns HERE (mirrors cuda_available's `extern int _hx_cuda_runtime_available`\n"
    buf = buf + " * forward-decl above) — the frozen-seed runtime.h does NOT declare them, so the\n"
    buf = buf + " * -DHEXA_CUDA compile (install.sh gate) would otherwise hit 'undeclared function'.\n"
    buf = buf + " * Carrier path (hexa_call1/0) avoids the `extern fn` FFI-wrapper name collision. */\n"
    buf = buf + "extern void hexa_forge_set_deterministic(int);\n"
    buf = buf + "extern int  hexa_forge_is_deterministic(void);\n"
    buf = buf + "HexaVal hexa_set_deterministic(HexaVal on) { hexa_forge_set_deterministic(hexa_truthy(on) ? 1 : 0); return hexa_int(hexa_forge_is_deterministic()); }\n"
    buf = buf + "HexaVal hexa_is_deterministic(void) { return hexa_int(hexa_forge_is_deterministic()); }\n"
    buf = buf + "#else\n"
    buf = buf + "__attribute__((weak)) HexaVal hexa_cuda_available(void) { return hexa_int(0); }\n"
    buf = buf + "__attribute__((weak)) HexaVal hexa_cuda_device_count(void) { return hexa_int(0); }\n"
    buf = buf + "/* #4214 forge determinism API builtins — non-CUDA weak stubs. No GPU = no\n"
    buf = buf + " * atomic-kernel determinism axis, so these are inert (det mode only governs\n"
    buf = buf + " * CUDA kernels). Crucially they do NOT reference the C-ABI hexa_forge_* (absent\n"
    buf = buf + " * in the frozen-seed non-CUDA runtime.h the install.sh gate restores) — mirrors\n"
    buf = buf + " * hexa_cuda_available's #else weak stub. */\n"
    buf = buf + "__attribute__((weak)) HexaVal hexa_set_deterministic(HexaVal on) { (void)on; return hexa_int(0); }\n"
    buf = buf + "__attribute__((weak)) HexaVal hexa_is_deterministic(void) { return hexa_int(0); }\n"
    buf = buf + "#endif\n"
    buf = buf + "__attribute__((weak)) HexaVal hexa_mono_ns(void) {\n"
    buf = buf + "    struct timespec ts;\n"
    buf = buf + "    hxlcl_clock_gettime(CLOCK_MONOTONIC, &ts);\n"
    buf = buf + "    return hexa_int((int64_t)ts.tv_sec * 1000000000LL + (int64_t)ts.tv_nsec);\n"
    buf = buf + "}\n"
    buf = buf + "__attribute__((weak)) HexaVal hexa_math_sqrt(HexaVal x) { return hexa_float(_hx_sqrt(HX_FLOAT(x))); }\n"
    buf = buf + "/* f64<->bits reinterpret primitives (RUNTIME, INBOX 2026-05-27). Real impl\n"
    buf = buf + " * replacing the nanbox.hexa stub (return 0). union-pun, tagged in/out. */\n"
    buf = buf + "__attribute__((weak)) HexaVal hexa_float_to_bits(HexaVal x) { union { double d; int64_t i; } u; u.d = HX_FLOAT(x); return hexa_int(u.i); }\n"
    buf = buf + "__attribute__((weak)) HexaVal hexa_bits_to_float(HexaVal x) { union { int64_t i; double d; } u; u.i = HX_INT(x); return hexa_float(u.d); }\n"
    buf = buf + "/* Bare-name aliases (2026-05-28): self/main.hexa's const-fold path emits\n"
    buf = buf + " * `hexa_call1(float_to_bits, ...)` / `hexa_call1(bits_to_float, ...)` using\n"
    buf = buf + " * the UNPREFIXED builtin name as a function-pointer symbol (codegen builtin\n"
    buf = buf + " * map gap — the `hexa_*` rename is applied to direct calls but not to the\n"
    buf = buf + " * &fn-ptr forms hexa_call1 takes). Without these symbols the transpiled\n"
    buf = buf + " * `build/stage1/main_native.c` fails to link (\"use of undeclared identifier\n"
    buf = buf + " * 'float_to_bits'\"), blocking every dispatcher rebuild. Provide weak C\n"
    buf = buf + " * aliases under the bare names so the function-pointer reference resolves;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + " * weak so any future real definition supersedes without a duplicate-symbol. */\n"
    buf = buf + "__attribute__((weak)) HexaVal float_to_bits(HexaVal x) { return hexa_float_to_bits(x); }\n"
    buf = buf + "__attribute__((weak)) HexaVal bits_to_float(HexaVal x) { return hexa_bits_to_float(x); }\n"
    buf = buf + "__attribute__((weak)) HexaVal hexa_math_abs(HexaVal x)  { return hexa_float(fabs(HX_FLOAT(x))); }\n"
    buf = buf + "__attribute__((weak)) HexaVal hexa_math_floor(HexaVal x){ double d=HX_FLOAT(x); if(!isfinite(d)||d<=-9007199254740992.0||d>=9007199254740992.0) return hexa_float(d); int64_t i=(int64_t)d; double r=(double)i; return hexa_float((d<0.0&&r!=d)?r-1.0:r); }\n"
    buf = buf + "__attribute__((weak)) HexaVal hexa_math_ceil(HexaVal x) { double d=HX_FLOAT(x); if(!isfinite(d)||d<=-9007199254740992.0||d>=9007199254740992.0) return hexa_float(d); int64_t i=(int64_t)d; double r=(double)i; return hexa_float((d>0.0&&r!=d)?r+1.0:r); }\n"
    buf = buf + "__attribute__((weak)) HexaVal hexa_math_round(HexaVal x){ double d=HX_FLOAT(x); if(!isfinite(d)||d<=-9007199254740992.0||d>=9007199254740992.0) return hexa_float(d); return hexa_float((double)(int64_t)(d<0.0?d-0.5:d+0.5)); }\n"
    buf = buf + "__attribute__((weak)) HexaVal hexa_math_min(HexaVal a, HexaVal b) { double x=HX_FLOAT(a),y=HX_FLOAT(b); return hexa_float((x<y||y!=y)?x:y); }  /* zero-c #29: native fmin (NaN->other) */\n"
    buf = buf + "__attribute__((weak)) HexaVal hexa_math_max(HexaVal a, HexaVal b) { double x=HX_FLOAT(a),y=HX_FLOAT(b); return hexa_float((x>y||y!=y)?x:y); }  /* zero-c #29: native fmax (NaN->other) */\n"
    buf = buf + "__attribute__((weak)) HexaVal hexa_cstring(HexaVal s) {\n"
    buf = buf + "    if (!HX_IS_STR(s)) return hexa_int(0);\n"
    buf = buf + "    return hexa_int((int64_t)(uintptr_t)HX_STR(s));\n"
    buf = buf + "}\n"
    if buf.len() > 0 { _flush_runtime(out_path, buf) }
}

fn main() {
    let argv = real_args()
    let out_path = if argv.len() >= 1 { argv[0] } else { "runtime.c" }
    emit_runtime_to(out_path)
    let exists_check = exec("[ -f \"" + out_path + "\" ] && echo y || echo n").trim()
    if exists_check != "y" {
        println("[runtime_emit] FATAL: failed to write " + out_path)
        exit(1)
    }
    println("[runtime_emit] wrote " + out_path)
    exit(0)
}
