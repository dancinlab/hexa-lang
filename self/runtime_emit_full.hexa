    buf = buf + "// On HEXA_CUDA: dispatches to _hx_cuda_farr_softmax_rows_gpu directly.\n"
    buf = buf + "// On no-CUDA: dispatches to _hx_farr_softmax_rows_inplace_cpu (the\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// byte-eq oracle — same two-pass max/sumexp math as the 3-arg variant).\n"
    buf = buf + "HexaVal hexa_farr_softmax_rows(HexaVal x_v, HexaVal out_v,\n"
    buf = buf + "                               HexaVal r_v, HexaVal c_v) {\n"
    buf = buf + "    int64_t x_id   = hexa_as_num(x_v);\n"
    buf = buf + "    int64_t out_id = hexa_as_num(out_v);\n"
