    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_select(int nfds, void *r, void *w, void *e, void *t) { return select(nfds, (fd_set *)r, (fd_set *)w, (fd_set *)e, (struct timeval *)t); }\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_poll(void *fds, unsigned int nfds, int timeout) {\n"
    buf = buf + "#if defined(__x86_64__)\n"
    buf = buf + "    return (int)_hxlcl_lx_sc3(7, (long)fds, (long)nfds, (long)timeout);\n"
    buf = buf + "#elif defined(__aarch64__)\n"
