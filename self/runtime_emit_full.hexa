    buf = buf + "    return hexa_int(int_total);\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// clamp(x, lo, hi): scalar clamp, float result. Step-3 cycle 3 port.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_clamp(HexaVal xv, HexaVal lov, HexaVal hiv) {\n"
    buf = buf + "    double x = __hx_to_double(xv);\n"
    buf = buf + "    double lo = __hx_to_double(lov);\n"
    buf = buf + "    double hi = __hx_to_double(hiv);\n"
