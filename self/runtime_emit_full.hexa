    buf = buf + "#define setvbuf(fp,b,m,sz) hxlcl_setvbuf((void *)(fp), (char *)(b), (int)(m), (size_t)(sz))\n"
    buf = buf + "// Cycle 62 — ctype.h pre-defines isalnum/isalpha as `__istype(...)`\n"
    buf = buf + "// inline calls; ap_post.c expands them BEFORE perl substitution sees\n"
    buf = buf + "// them. #undef + #define here unhooks any subsequent expansion to our\n"
