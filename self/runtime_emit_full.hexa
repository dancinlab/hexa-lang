    buf = buf + "    bit_or     = hexa_fn_new((void*)_hx_bit_or,           2);\n"
    buf = buf + "    // bt73 free-fn shims (timestamp, base64_encode, base64_decode)\n"
    buf = buf + "    timestamp     = hexa_fn_new((void*)_bt73_timestamp_w,     0);\n"
    buf = buf + "    base64_encode = hexa_fn_new((void*)_bt73_base64_encode_w, 1);\n"
    buf = buf + "    base64_decode = hexa_fn_new((void*)_bt73_base64_decode_w, 1);\n"
    buf = buf + "    // RFC 6455 WS handshake bare-ident bridge (regen-gated codegen fallback).\n"
    buf = buf + "    sha1          = hexa_fn_new((void*)_bt73_sha1_w,          1);\n"
    buf = buf + "    sha1_bytes    = hexa_fn_new((void*)_bt73_sha1_bytes_w,    1);\n"
    buf = buf + "    // interp exec/env primitives — bootstrap-gap bridge\n"
    buf = buf + "    hx_setenv       = hexa_fn_new((void*)_w_setenv,       2);\n"
    buf = buf + "    hx_exec_capture = hexa_fn_new((void*)_w_exec_capture, 1);\n"
    buf = buf + "    // PROBE r8 3-tuple bridge (regen-gated codegen fallback).\n"
    buf = buf + "    exec_with_status3 = hexa_fn_new((void*)_w_exec_with_status3, 1);\n"
    buf = buf + "    // hxa-004 ext: bare `push(arr, v)` emitted by legacy hexat as hexa_call2\n"
    buf = buf + "    hx_push         = hexa_fn_new((void*)_w_push,         2);\n"
    buf = buf + "    // Cycle 55 recovery — stdlib/fs builtins. codegen.hexa maps the\n"
    buf = buf + "    // bare names `fs_append_atomic/fs_stat/fs_rotate_if_over/fs_mkdir_p`\n"
    buf = buf + "    // to rt_fs_* C names, but the bootstrap hexat binary hasn't been\n"
    buf = buf + "    // re-deployed with that mapping. Bridge via bt73-style TAG_FN.\n"
    buf = buf + "    fs_append_atomic    = hexa_fn_new((void*)rt_fs_append_atomic,    2);\n"
    buf = buf + "    fs_stat             = hexa_fn_new((void*)rt_fs_stat,             1);\n"
    buf = buf + "    fs_rotate_if_over   = hexa_fn_new((void*)rt_fs_rotate_if_over,   3);\n"
    buf = buf + "    fs_mkdir_p          = hexa_fn_new((void*)rt_fs_mkdir_p,          1);\n"
    buf = buf + "    // std::net free-fn shims — bridges transpiler bootstrap gap for\n"
    buf = buf + "    // net_connect / net_read / net_write until hexat learns the\n"
    buf = buf + "    // direct-lowering for these names (see native/net.c comment).\n"
    buf = buf + "    _hexa_init_net_fn_shims();\n"
    buf = buf + "    // stdlib/os signal + flock free-fn shims (roadmap 62, 2026-04-22)\n"
    buf = buf + "    _hexa_init_os_fn_shims();\n"
    buf = buf + "    // hxa-20260424-005 items #1 + #7: exec_argv + sha256 shims\n"
    buf = buf + "    _hexa_init_exec_sha_fn_shims();\n"
    buf = buf + "    // ω-runtime-1 Phase A (2026-04-26): persistent-pipe primitive shims\n"
    buf = buf + "    _hexa_init_persistent_pipe_fn_shims();\n"
    buf = buf + "    // 2026-05-13: anima daemon Phase 2 — pthread + channel primitives.\n"
    buf = buf + "    _hexa_init_thread_fn_shims();\n"
    buf = buf + "    // 2026-05-13: wilson harness-cli + cpu port — pty + termios primitives.\n"
    buf = buf + "    _hexa_init_pty_fn_shims();\n"
    buf = buf + "    // Wilson 2026-05-13 — std_time.hexa wrapper name shims (time_now_ms etc.)\n"
    buf = buf + "    _hexa_init_time_fn_shims();\n"
    buf = buf + "    _fn_shims_ready = 1;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// NATIVE-EMIT startup hook — ensure the TAG_FN carrier globals are wired\n"
    buf = buf + "// before main() runs. The C-transpile path calls _hexa_init_fn_shims via\n"
    buf = buf + "// hexa_set_args(argc,argv) from its generated main wrapper, but a raw\n"
    buf = buf + "// `aprime --emit` native binary emits a BARE `main` (no hexa_set_args call),\n"
    buf = buf + "// so the carriers stayed zero-initialised (tag=0) → `not callable: tag=0`\n"
    buf = buf + "// when user code calls a carrier (e.g. thread_spawn(worker, 1)). A\n"
    buf = buf + "// constructor runs in BOTH paths; _hexa_init_fn_shims is idempotent\n"
    buf = buf + "// (_fn_shims_ready guard) so the C-transpile path's later hexa_set_args call\n"
    buf = buf + "// is a no-op → byteeq-neutral (the emitted bytes are unchanged; only the\n"
    buf = buf + "// init TIMING moves earlier for the native path that never called it).\n"
    buf = buf + "__attribute__((constructor))\n"
    buf = buf + "static void _hexa_ctor_init_fn_shims(void) { _hexa_init_fn_shims(); }\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "/* ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + " * T3 HOT KERNEL INCLUDE — anima training inner-loop fast path.\n"
    buf = buf + " *\n"
    buf = buf + " * f32/f64/i32 ptr r/w + struct_pack_f32/unpack_f32 + tensor stubs are\n"
    buf = buf + " * extracted into native/tensor_kernels.c so anima maintainers can find\n"
    buf = buf + " * the performance-critical boundary without grep'ing through 3600 LOC.\n"
    buf = buf + " *\n"
    buf = buf + " * @hot_kernel markers inside the file describe each function's role.\n"
    buf = buf + " * Whitelist (external consumers): $NEXUS/shared/hexa/hot-path.jsonl.\n"
    buf = buf + " * Migration policy: docs/hexa-hot-path.md.\n"
    buf = buf + " *\n"
    buf = buf + " * NEVER migrate these to HEXA — per-element HexaVal wrap/dispatch would\n"
    buf = buf + " * multiply training time 10-100x. Any future HEXA reimplementation must\n"
    buf = buf + " * preserve raw C float* access patterns.\n"
    buf = buf + " * ═══════════════════════════════════════════════════════════════════ */\n"
    buf = buf + "#include \"native/tensor_kernels.c\"\n"
    buf = buf + "\n"
    buf = buf + "/* ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + " * std::net — POSIX TCP socket builtins (interp resurrection, 2026-04-16)\n"
    buf = buf + " *\n"
    buf = buf + " * Ports the networking surface from the deleted Rust src/std_net.rs\n"
    buf = buf + " * (recovered from commit ef92fc6). 6 primitives; http_get / http_serve\n"
    buf = buf + " * are composed on top of them in self/std_net.hexa.\n"
    buf = buf + " *\n"
    buf = buf + " *   hexa_net_listen(addr)       : string \"host:port\" → TAG_INT fd / -errno\n"
    buf = buf + " *   hexa_net_accept(listen)     : TAG_INT listen_fd  → TAG_INT client_fd\n"
    buf = buf + " *   hexa_net_connect(addr)      : string \"host:port\" → TAG_INT fd / -errno\n"
    buf = buf + " *   hexa_net_read(fd)           : TAG_INT fd         → TAG_STR data\n"
    buf = buf + " *   hexa_net_write(fd, data)    : TAG_INT fd, string → TAG_INT bytes / -errno\n"
    buf = buf + " *   hexa_net_close(fd)          : TAG_INT fd         → TAG_INT 0 / -errno\n"
    buf = buf + " *\n"
    buf = buf + " * Error model: negative TAG_INT (the raw errno). Matches the C-side\n"
    buf = buf + " * convention used by hxcuda/hxblas shims.\n"
    buf = buf + " *\n"
    buf = buf + " * Implementation lives in native/net.c so the net subsystem is a single\n"
    buf = buf + " * file analogous to native/tensor_kernels.c for the hot kernel path.\n"
    buf = buf + " * ═══════════════════════════════════════════════════════════════════ */\n"
    buf = buf + "#include \"native/net.c\"\n"
    buf = buf + "\n"
    buf = buf + "/* ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + " * anima daemon Phase 2 (CHAT.md rev 2) — pthread + channel primitives\n"
    buf = buf + " * for 60+ FPS frame loop with async inference worker offload.\n"
    buf = buf + " *\n"
    buf = buf + " *   hexa_thread_spawn(fn, arg)   → tid (>=0) or -errno\n"
    buf = buf + " *   hexa_thread_join(tid)        → result HexaVal\n"
    buf = buf + " *   hexa_channel_new()           → ch_id (>=0) or -errno\n"
    buf = buf + " *   hexa_channel_send(ch, v)     → 0 ok / -errno\n"
    buf = buf + " *   hexa_channel_recv(ch, ms)    → val or \"\" sentinel\n"
    buf = buf + " *   hexa_channel_close(ch)       → 0 ok / -errno\n"
    buf = buf + " *   hexa_sleep_ms(ms)            → 0\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + " *   hexa_now_ms()                → current monotonic ms (int)\n"
    buf = buf + " *\n"
