    buf = buf + "#endif\n"
    buf = buf + "// F3 ACTIVATION · Path A — connect class-C svc-wrapper self-emit slot.\n"
    buf = buf + "// 3-arg int+ptr+uint _cf (bind twin): sockfd/x0 sxtw, addr/x1 ptr untouched,\n"
