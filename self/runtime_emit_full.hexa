    buf = buf + " * Built into hexa binaries that link -lpthread (added by cmd_build).\n"
    buf = buf + " * ═══════════════════════════════════════════════════════════════════ */\n"
    buf = buf + "#include \"native/thread.c\"\n"
    buf = buf + "\n"
    buf = buf + "/* ═══════════════════════════════════════════════════════════════════\n"
