    buf = buf + "//     emit `.o` exports `_rt_<name>` directly. The HexaVal struct-return ABI\n"
    buf = buf + "//     (x0:x1 register PAIR, NRRP) means the extern decl shape matches the\n"
    buf = buf + "//     def shape exactly (no x8 hidden-pointer wrinkle). The callee in the\n"
    buf = buf + "//     `.o`'s BRANCH26 is `_hexa_bool`/`_hexa_int`, already non-static under\n"
    buf = buf + "//     HEXA_RT_SELFEMIT via the ctor-bundle gate (runtime_core_emit.hexa\n"
    buf = buf + "//     L1338-L1357) — no separate callee-export macro needed.\n"
    buf = buf + "//\n"
    buf = buf + "// Three-way gate ordering:\n"
    buf = buf + "//   (1) HEXA_RT_SELFEMIT defined   → extern (self-emitted `_rt_isalnum`/\n"
    buf = buf + "//                                     `_rt_isalpha` win at link).\n"
    buf = buf + "//   (2) HEXA_HAS_HEXA_RT_STDLIB set → extern (hexa stdlib transpile provides\n"
    buf = buf + "//                                     the strong symbols, per the original\n"
    buf = buf + "//                                     aprime_cc path).\n"
    buf = buf + "//   (3) else (standalone smoke)    → C fallback body (0-extern-delta,\n"
    buf = buf + "//                                     unchanged from origin/main).\n"
    buf = buf + "// Default build (neither flag) lands at path (3) → BYTE-IDENTICAL to\n"
    buf = buf + "// origin/main (additive guards only).\n"
    buf = buf + "#if defined(HEXA_RT_SELFEMIT)\n"
    buf = buf + "extern HexaVal rt_isalnum(HexaVal c);\n"
    buf = buf + "extern HexaVal rt_isalpha(HexaVal c);\n"
    buf = buf + "#elif !defined(HEXA_HAS_HEXA_RT_STDLIB)\n"
    buf = buf + "HexaVal rt_isalnum(HexaVal c) {\n"
    buf = buf + "    int64_t v = HX_INT(c);\n"
    buf = buf + "    int b = ((v >= 48 && v <= 57) ||\n"
    buf = buf + "             (v >= 65 && v <= 90) ||\n"
    buf = buf + "             (v >= 97 && v <= 122)) ? 1 : 0;\n"
    buf = buf + "    return hexa_bool(b);\n"
    buf = buf + "}\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "HexaVal rt_isalpha(HexaVal c) {\n"
    buf = buf + "    int64_t v = HX_INT(c);\n"
    buf = buf + "    int b = ((v >= 65 && v <= 90) ||\n"
    buf = buf + "             (v >= 97 && v <= 122)) ? 1 : 0;\n"
    buf = buf + "    return hexa_bool(b);\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_isalnum(HexaVal c);\n"
    buf = buf + "extern HexaVal rt_isalpha(HexaVal c);\n"
    buf = buf + "#endif\n"
    buf = buf + "static int hxlcl_isalnum(int c) { return hexa_truthy(rt_isalnum(hexa_int((int64_t)c))) ? 1 : 0; }\n"
    buf = buf + "static int hxlcl_isalpha(int c) { return hexa_truthy(rt_isalpha(hexa_int((int64_t)c))) ? 1 : 0; }\n"
    buf = buf + "\n"
    buf = buf + "// RUNTIME.md step-2 cycle 5 — hxlcl_atof DEFINITION (forward-declared in the\n"
    buf = buf + "// early helper zone ~L294). Under HEXA_HAS_HEXA_RT_STDLIB delegate to the\n"
    buf = buf + "// hexa-source rt_str_parse_float (stdlib/runtime/ctype.hexa cycle-73, same\n"
    buf = buf + "// lenient ws+sign+int+.frac+eE parse); #else the C fallback (bit-for-bit).\n"
    buf = buf + "// Placed here (post-cycle-1 shim) because HexaVal/hexa_str/HX_FLOAT are\n"
    buf = buf + "// declared by this point — the L294 bootstrap zone is pre-HexaVal.\n"
    buf = buf + "#ifdef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "extern HexaVal rt_str_parse_float(HexaVal s);\n"
    buf = buf + "static double __attribute__((noinline)) hxlcl_atof(const char *s) {\n"
    buf = buf + "    if (!s) return 0.0;\n"
    buf = buf + "    return HX_FLOAT(rt_str_parse_float(hexa_str((char *)s)));\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "static double __attribute__((noinline)) hxlcl_atof(const char *s) {\n"
    buf = buf + "    if (!s) return 0.0;\n"
    buf = buf + "    size_t i = 0;\n"
    buf = buf + "    while (s[i] == ' ' || s[i] == '\\t' || s[i] == '\\n') i++;\n"
    buf = buf + "    int sign = 1;\n"
    buf = buf + "    if (s[i] == '-') { sign = -1; i++; }\n"
    buf = buf + "    else if (s[i] == '+') i++;\n"
    buf = buf + "    double n = 0.0;\n"
    buf = buf + "    while (s[i] >= '0' && s[i] <= '9') {\n"
    buf = buf + "        n = n * 10.0 + (double)(s[i] - '0');\n"
    buf = buf + "        i++;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (s[i] == '.') {\n"
    buf = buf + "        i++;\n"
    buf = buf + "        double frac = 0.1;\n"
    buf = buf + "        while (s[i] >= '0' && s[i] <= '9') {\n"
    buf = buf + "            n += (double)(s[i] - '0') * frac;\n"
    buf = buf + "            frac *= 0.1;\n"
    buf = buf + "            i++;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    if (s[i] == 'e' || s[i] == 'E') {\n"
    buf = buf + "        i++;\n"
    buf = buf + "        int esign = 1;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        if (s[i] == '-') { esign = -1; i++; }\n"
    buf = buf + "        else if (s[i] == '+') i++;\n"
    buf = buf + "        int exp_val = 0;\n"
    buf = buf + "        while (s[i] >= '0' && s[i] <= '9') {\n"
    buf = buf + "            exp_val = exp_val * 10 + (s[i] - '0');\n"
    buf = buf + "            i++;\n"
    buf = buf + "        }\n"
    buf = buf + "        double mul = 1.0;\n"
    buf = buf + "        for (int k = 0; k < exp_val; k++) mul *= 10.0;\n"
    buf = buf + "        if (esign < 0) n /= mul;\n"
    buf = buf + "        else n *= mul;\n"
    buf = buf + "    }\n"
    buf = buf + "    return (sign < 0) ? -n : n;\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// RUNTIME.md step-2 — hxlcl_atoll DEFINITION (forward-declared in the early\n"
    buf = buf + "// helper zone ~L221). Under HEXA_HAS_HEXA_RT_STDLIB delegate to hexa-source\n"
    buf = buf + "// rt_atoll (ctype.hexa, lenient decimal); #else C fallback (bit-for-bit).\n"
    buf = buf + "// hxlcl_atoi (= (int)hxlcl_atoll, pure C, no HexaVal) stays at its early site.\n"
    buf = buf + "// Same early-zone relocate technique as the cycle-5 atof port.\n"
    buf = buf + "#ifdef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "extern HexaVal rt_atoll(HexaVal s);\n"
    buf = buf + "HXLCL_ATOLL_SC long long __attribute__((noinline)) hxlcl_atoll(const char *s) {\n"
    buf = buf + "    if (!s) return 0;\n"
    buf = buf + "    return (long long)HX_INT(rt_atoll(hexa_str((char *)s)));\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "HXLCL_ATOLL_SC long long __attribute__((noinline)) hxlcl_atoll(const char *s) {\n"
    buf = buf + "    if (!s) return 0;\n"
    buf = buf + "    size_t i = 0;\n"
    buf = buf + "    while (s[i] == ' ' || s[i] == '\\t' || s[i] == '\\n') i++;\n"
    buf = buf + "    int sign = 1;\n"
    buf = buf + "    if (s[i] == '-') { sign = -1; i++; }\n"
    buf = buf + "    else if (s[i] == '+') i++;\n"
    buf = buf + "    unsigned long long n = 0;\n"
    buf = buf + "    while (s[i] >= '0' && s[i] <= '9') {\n"
    buf = buf + "        n = n * 10ULL + (unsigned long long)(s[i] - '0');\n"
    buf = buf + "        i++;\n"
    buf = buf + "    }\n"
    buf = buf + "    return (long long)((sign < 0) ? -(long long)n : (long long)n);\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// RUNTIME.md step-2 cycle 2 — math helper hexa-source delegation.\n"
    buf = buf + "// Source of truth: stdlib/runtime/math.hexa. Same #ifndef pattern\n"
    buf = buf + "// as cycle 1: ap_post.c gets the macro, fallback C body skipped.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal rt_fmod(HexaVal x, HexaVal y) {\n"
    buf = buf + "    double dx = HX_FLOAT(x), dy = HX_FLOAT(y);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    if (dy == 0.0) return hexa_float(0.0);\n"
    buf = buf + "    double q = dx / dy;\n"
    buf = buf + "    long long iq = (long long)q;\n"
    buf = buf + "    return hexa_float(dx - (double)iq * dy);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal rt_exp(HexaVal x) {\n"
    buf = buf + "    double dx = HX_FLOAT(x);\n"
    buf = buf + "    const double LN2 = 0.6931471805599453;\n"
    buf = buf + "    double n_d = dx / LN2;\n"
    buf = buf + "    long long n = (long long)(n_d + (n_d >= 0.0 ? 0.5 : -0.5));\n"
    buf = buf + "    double r = dx - (double)n * LN2;\n"
    buf = buf + "    double r2 = r*r, r3 = r2*r, r4 = r2*r2;\n"
    buf = buf + "    double sum = 1.0 + r + r2*0.5 + r3*(1.0/6.0) + r4*(1.0/24.0)\n"
    buf = buf + "                 + r4*r*(1.0/120.0) + r4*r2*(1.0/720.0) + r4*r3*(1.0/5040.0);\n"
    buf = buf + "    double pow2 = 1.0;\n"
    buf = buf + "    if (n > 1023) n = 1023;\n"
    buf = buf + "    if (n < -1022) n = -1022;\n"
    buf = buf + "    if (n >= 0) for (long long i = 0; i < n; i++) pow2 *= 2.0;\n"
    buf = buf + "    else for (long long i = 0; i < -n; i++) pow2 *= 0.5;\n"
    buf = buf + "    return hexa_float(sum * pow2);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal rt_log(HexaVal x) {\n"
    buf = buf + "    double dx = HX_FLOAT(x);\n"
    buf = buf + "    if (dx <= 0.0) return hexa_float(-1e308);\n"
    buf = buf + "    int e = 0;\n"
    buf = buf + "    while (dx >= 2.0) { dx *= 0.5; e++; }\n"
    buf = buf + "    while (dx < 1.0) { dx *= 2.0; e--; }\n"
    buf = buf + "    double u = (dx - 1.0) / (dx + 1.0);\n"
    buf = buf + "    double u2 = u*u, u3 = u2*u, u5 = u3*u2, u7 = u5*u2;\n"
    buf = buf + "    double sum = 2.0 * (u + u3/3.0 + u5/5.0 + u7/7.0 + u7*u2/9.0);\n"
    buf = buf + "    return hexa_float(sum + (double)e * 0.6931471805599453);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal rt_cos(HexaVal x) {\n"
    buf = buf + "    double dx = HX_FLOAT(x);\n"
    buf = buf + "    const double TWO_PI = 6.283185307179586;\n"
    buf = buf + "    const double PI = 3.141592653589793;\n"
    buf = buf + "    if (dx < 0.0) dx = -dx;\n"
    buf = buf + "    while (dx >= TWO_PI) dx -= TWO_PI;\n"
    buf = buf + "    if (dx > PI) dx = TWO_PI - dx;\n"
    buf = buf + "    double x2 = dx*dx, x4 = x2*x2, x6 = x4*x2, x8 = x4*x4;\n"
    buf = buf + "    double sum = 1.0 - x2/2.0 + x4/24.0 - x6/720.0 + x8/40320.0\n"
    buf = buf + "                 - x8*x2/3628800.0 + x8*x4/479001600.0 - x8*x6/87178291200.0;\n"
    buf = buf + "    return hexa_float(sum);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal rt_sin(HexaVal x) {\n"
    buf = buf + "    const double PI_HALF = 1.5707963267948966;\n"
    buf = buf + "    HexaVal shifted = hexa_float(HX_FLOAT(x) - PI_HALF);\n"
    buf = buf + "    return rt_cos(shifted);\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "extern HexaVal rt_fmod(HexaVal x, HexaVal y);\n"
    buf = buf + "extern HexaVal rt_exp(HexaVal x);\n"
    buf = buf + "extern HexaVal rt_log(HexaVal x);\n"
    buf = buf + "extern HexaVal rt_cos(HexaVal x);\n"
    buf = buf + "extern HexaVal rt_sin(HexaVal x);\n"
    buf = buf + "#endif\n"
    buf = buf + "static double hxlcl_fmod(double x, double y) { return HX_FLOAT(rt_fmod(hexa_float(x), hexa_float(y))); }\n"
    buf = buf + "static double hxlcl_exp(double x) { return HX_FLOAT(rt_exp(hexa_float(x))); }\n"
    buf = buf + "static double hxlcl_log(double x) { return HX_FLOAT(rt_log(hexa_float(x))); }\n"
    buf = buf + "static double hxlcl_cos(double x) { return HX_FLOAT(rt_cos(hexa_float(x))); }\n"
    buf = buf + "static double hxlcl_sin(double x) { return HX_FLOAT(rt_sin(hexa_float(x))); }\n"
    buf = buf + "\n"
    buf = buf + "// RUNTIME.md step-2 cycle 3 — pthread delegation via single noop hexa\n"
    buf = buf + "// fn (`rt_pthread_noop` returns 0) + create policy (returns 1 = run\n"
    buf = buf + "// synchronously).\n"
    buf = buf + "//\n"
    buf = buf + "// F3 ACTIVATION RUNBOOK · Path A — class-D HexaVal-repr body self-emit slot\n"
    buf = buf + "// (see L2029-block above for the gating-shape rationale). 0-arg sister of\n"
    buf = buf + "// the rt_isalnum/rt_isalpha slot: the `.o` is just `mov w0,#imm + bl\n"
    buf = buf + "// _hexa_int + ldp + ret` (6 instr / 24 B). Same 3-way gate; default build\n"
    buf = buf + "// lands at path (3) → byte-identical to origin/main.\n"
    buf = buf + "#if defined(HEXA_RT_SELFEMIT)\n"
    buf = buf + "extern HexaVal rt_pthread_noop(void);\n"
    buf = buf + "extern HexaVal rt_pthread_create_policy(void);\n"
    buf = buf + "#elif !defined(HEXA_HAS_HEXA_RT_STDLIB)\n"
    buf = buf + "HexaVal rt_pthread_noop(void) { return hexa_int(0); }\n"
    buf = buf + "HexaVal rt_pthread_create_policy(void) { return hexa_int(1); }\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_pthread_noop(void);\n"
    buf = buf + "extern HexaVal rt_pthread_create_policy(void);\n"
    buf = buf + "#endif\n"
    // ── ② OPT-IN real OS-thread spawn (-DHEXA_THREADS) ────────────────────────
    // Map the hxlcl_pthread_* libc-floor shims 1:1 onto POSIX pthread. The
    // DEFAULT build (HEXA_THREADS undefined) takes the #else branch = the EXACT
    // pre-existing synchronous stubs, so the runtime.c object stays byte-identical
    // to origin/main and the byteeq gen3≡gen4 fixpoint is unaffected. self-host /
    // byteeq / faithful builds NEVER pass -DHEXA_THREADS, so the deterministic
    // compiler can never observe a non-deterministic thread schedule (determinism
    // isolation). hexa_thread_spawn/_join in native/thread.c already route through
    // these shims — under HEXA_THREADS they become real OS threads with no change
    // to thread.c. Reference-match: POSIX.1-2017 pthread_create / pthread_join
    // (1:1 OS thread, void*(*)(void*) entry, joined by handle); Go runtime v1 and
    // Rust std::thread::spawn are the same 1:1-to-OS-thread model. The
    // (pthread_t)(uintptr_t) join cast bridges the platform pthread_t divergence
    // (Linux glibc unsigned long vs macOS arm64 pointer) — hexa_thread_join boxes
    // the handle as (void*)(uintptr_t)tid, so it round-trips on both.
    buf = buf + "#if defined(HEXA_THREADS)\n"
    buf = buf + "#include <pthread.h>\n"
    buf = buf + "static int hxlcl_pthread_mutex_init(void *m, const void *a) { return pthread_mutex_init((pthread_mutex_t *)m, (const pthread_mutexattr_t *)a); }\n"
    buf = buf + "static int hxlcl_pthread_mutex_destroy(void *m) { return pthread_mutex_destroy((pthread_mutex_t *)m); }\n"
    buf = buf + "static int hxlcl_pthread_mutex_lock(void *m) { return pthread_mutex_lock((pthread_mutex_t *)m); }\n"
    buf = buf + "static int hxlcl_pthread_mutex_unlock(void *m) { return pthread_mutex_unlock((pthread_mutex_t *)m); }\n"
    buf = buf + "static int hxlcl_pthread_cond_init(void *c, const void *a) { return pthread_cond_init((pthread_cond_t *)c, (const pthread_condattr_t *)a); }\n"
    buf = buf + "static int hxlcl_pthread_cond_destroy(void *c) { return pthread_cond_destroy((pthread_cond_t *)c); }\n"
    buf = buf + "static int hxlcl_pthread_cond_signal(void *c) { return pthread_cond_signal((pthread_cond_t *)c); }\n"
    buf = buf + "static int hxlcl_pthread_cond_broadcast(void *c) { return pthread_cond_broadcast((pthread_cond_t *)c); }\n"
    buf = buf + "static int hxlcl_pthread_cond_wait(void *c, void *m) { return pthread_cond_wait((pthread_cond_t *)c, (pthread_mutex_t *)m); }\n"
    buf = buf + "static int hxlcl_pthread_cond_timedwait(void *c, void *m, const void *ts) { return pthread_cond_timedwait((pthread_cond_t *)c, (pthread_mutex_t *)m, (const struct timespec *)ts); }\n"
    buf = buf + "static int hxlcl_pthread_create(void *thread, const void *attr, void *(*start)(void *), void *arg) { return pthread_create((pthread_t *)thread, (const pthread_attr_t *)attr, start, arg); }\n"
    buf = buf + "static int hxlcl_pthread_join(void *thread, void **retval) { return pthread_join((pthread_t)(uintptr_t)thread, retval); }\n"
    buf = buf + "#else\n"
    buf = buf + "static int hxlcl_pthread_mutex_init(void *m, const void *a) {\n"
    buf = buf + "    (void)m; (void)a; return (int)HX_INT(rt_pthread_noop());\n"
    buf = buf + "}\n"
    buf = buf + "static int hxlcl_pthread_mutex_destroy(void *m) {\n"
    buf = buf + "    (void)m; return (int)HX_INT(rt_pthread_noop());\n"
    buf = buf + "}\n"
    buf = buf + "static int hxlcl_pthread_mutex_lock(void *m) {\n"
    buf = buf + "    (void)m; return (int)HX_INT(rt_pthread_noop());\n"
    buf = buf + "}\n"
    buf = buf + "static int hxlcl_pthread_mutex_unlock(void *m) {\n"
    buf = buf + "    (void)m; return (int)HX_INT(rt_pthread_noop());\n"
    buf = buf + "}\n"
    buf = buf + "static int hxlcl_pthread_cond_init(void *c, const void *a) {\n"
    buf = buf + "    (void)c; (void)a; return (int)HX_INT(rt_pthread_noop());\n"
    buf = buf + "}\n"
    buf = buf + "static int hxlcl_pthread_cond_destroy(void *c) {\n"
    buf = buf + "    (void)c; return (int)HX_INT(rt_pthread_noop());\n"
    buf = buf + "}\n"
    buf = buf + "static int hxlcl_pthread_cond_signal(void *c) {\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    (void)c; return (int)HX_INT(rt_pthread_noop());\n"
    buf = buf + "}\n"
    buf = buf + "static int hxlcl_pthread_cond_broadcast(void *c) {\n"
    buf = buf + "    (void)c; return (int)HX_INT(rt_pthread_noop());\n"
    buf = buf + "}\n"
    buf = buf + "static int hxlcl_pthread_cond_wait(void *c, void *m) {\n"
    buf = buf + "    (void)c; (void)m; return (int)HX_INT(rt_pthread_noop());\n"
    buf = buf + "}\n"
    buf = buf + "static int hxlcl_pthread_cond_timedwait(void *c, void *m, const void *ts) {\n"
    buf = buf + "    (void)c; (void)m; (void)ts; return (int)HX_INT(rt_pthread_noop());\n"
    buf = buf + "}\n"
    buf = buf + "static int hxlcl_pthread_create(void *thread, const void *attr, void *(*start)(void *), void *arg) {\n"
    buf = buf + "    (void)thread; (void)attr;\n"
    buf = buf + "    if (start && (int)HX_INT(rt_pthread_create_policy()) == 1) {\n"
    buf = buf + "        (void)start(arg);\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "static int hxlcl_pthread_join(void *thread, void **retval) {\n"
    buf = buf + "    (void)thread;\n"
    buf = buf + "    if (retval) *retval = (void *)0;\n"
    buf = buf + "    return (int)HX_INT(rt_pthread_noop());\n"
    buf = buf + "}\n"
    buf = buf + "#endif /* HEXA_THREADS — real-pthread vs synchronous shims */\n"
    buf = buf + "\n"
    buf = buf + "// RUNTIME.md step-2 cycle 4 — net/exec/pty delegation via single\n"
    buf = buf + "// rt_net_fail (-1) + rt_net_zero (0 for inet_pton invalid).\n"
    buf = buf + "//\n"
    buf = buf + "// F3 class-D batch2 (this PR) extends the 2-way gate to 3-way:\n"
    buf = buf + "//   - HEXA_RT_SELFEMIT       → extern (self-emit .o defines _rt_net_*)\n"
    buf = buf + "//   - !HEXA_HAS_HEXA_RT_STDLIB → standalone C body\n"
    buf = buf + "//   - else                   → extern (aprime_cc hexa transpile defines)\n"
    buf = buf + "// Default build (neither flag) hits path 3 → BYTE-IDENTICAL to origin/main.\n"
    buf = buf + "#if defined(HEXA_RT_SELFEMIT)\n"
    buf = buf + "extern HexaVal rt_net_fail(void);\n"
    buf = buf + "extern HexaVal rt_net_zero(void);\n"
    buf = buf + "extern HexaVal rt_posix_ok(void);  /* cycle 6 ISO-1 */\n"
    buf = buf + "#elif !defined(HEXA_HAS_HEXA_RT_STDLIB)\n"
    buf = buf + "HexaVal rt_net_fail(void) { return hexa_int(-1); }\n"
    buf = buf + "HexaVal rt_net_zero(void) { return hexa_int(0); }\n"
    buf = buf + "HexaVal rt_posix_ok(void) { return hexa_int(0); }  /* cycle 6 ISO-1 */\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_net_fail(void);\n"
    buf = buf + "extern HexaVal rt_net_zero(void);\n"
    buf = buf + "extern HexaVal rt_posix_ok(void);  /* cycle 6 ISO-1 */\n"
    buf = buf + "#endif\n"
    buf = buf + "// cycle 6 SAFE SET: 4 fns kept as rt_posix_ok stubs (isatty/signal/sigaction/sigprocmask)\n"
    buf = buf + "// RFC061 §M8 (ING#29) — hxlcl_atexit FUNCTIONAL: route to libc atexit (musl LIFO\n"
    buf = buf + "// registry, src/exit/atexit.c). The old `(void)fn; return rt_posix_ok()` no-op\n"
    buf = buf + "// SILENTLY DISCARDED the callback — the original SIGSEGV worry was a BOXED TAG_FN\n"
    buf = buf + "// callback (none exist: all 3 runtime callers — _hx_stats_dump [HEXA_ALLOC_STATS],\n"
    buf = buf + "// hexa_ic_dump_stats [HEXA_IC_STATS], _hxp_atexit_cleanup [hexa_pipe_spawn] — pass\n"
    buf = buf + "// RAW C fn-ptrs, never a hexa TAG_FN box). libc atexit at init time touches no\n"
    buf = buf + "// TAG_FN slot, so it is init-safe. Matches the DEFAULT shim (runtime_core_hxlcl_shim.c)\n"
    buf = buf + "// + zeroc_hxlcl_delegate. byteeq-neutral: compiler builds set neither stats env nor\n"
    buf = buf + "// spawn persistent pipes, so no handler is ever registered on the byteeq/ship path.\n"
    buf = buf + "static int hxlcl_atexit(void (*fn)(void)) { return atexit(fn); }\n"
    buf = buf + "static int hxlcl_isatty(int fd) { (void)fd; return (int)HX_INT(rt_posix_ok()); }\n"
    buf = buf + "static void *hxlcl_signal(int signum, void *handler) {\n"
    buf = buf + "    (void)signum; (void)handler; (void)rt_posix_ok(); return (void *)0;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "}\n"
    buf = buf + "static int hxlcl_sigaction(int signum, const void *act, void *oldact) {\n"
    buf = buf + "    (void)signum; (void)act; (void)oldact; return (int)HX_INT(rt_posix_ok());\n"
    buf = buf + "}\n"
    buf = buf + "static int hxlcl_sigprocmask(int how, const void *set, void *oldset) {\n"
    buf = buf + "    (void)how; (void)set; (void)oldset; return (int)HX_INT(rt_posix_ok());\n"
    buf = buf + "}\n"
    buf = buf + "// cycle 6 extension: 4 more post-init POSIX fns\n"
    buf = buf + "static int hxlcl_setenv(const char *name, const char *val, int overwrite) {\n"
    buf = buf + "    (void)name; (void)val; (void)overwrite; return (int)HX_INT(rt_posix_ok());\n"
    buf = buf + "}\n"
    buf = buf + "// GO M10 — restore real libc setsockopt (paired with the socket()/bind()\n"
    buf = buf + "// restore above). The stub returned \"ok\" so callers didn't notice, but\n"
    buf = buf + "// SO_REUSEADDR / SO_RCVTIMEO etc. were no-ops in the compiler binary.\n"
    buf = buf + "// Prototype from the top-of-file <sys/socket.h> include.\n"
    buf = buf + "// F3 ACTIVATION · Path A — setsockopt class-C svc-wrapper self-emit slot.\n"
    buf = buf + "// 5-arg via syscall6 (6th unused=0): sxtw x0/x1/x2 (fd/level/optname) +\n"
    buf = buf + "// optval/x3 ptr untouched + uxtw x4 (mov w4,w4; unsigned optlen) + mov x5,#0.\n"
    buf = buf + "// 13 instr / 52 B, errno reloc 0x24/0x28. SELF-EMIT → extern, resolved by\n"
    buf = buf + "// emit_hxlcl_setsockopt_o.hexa (byte-eq to clang -O2, SYS#105). Completes the\n"
    buf = buf + "// socket-family (incl. options).\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int hxlcl_setsockopt(int sockfd, int level, int optname, const void *optval, unsigned int optlen);\n"
    buf = buf + "#else\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_setsockopt(int sockfd, int level, int optname, const void *optval, unsigned int optlen) {\n"
    buf = buf + "    // net/exec ③: svc-trap setsockopt (105), 5 args -> sc6_cf (6th unused).\n"
    buf = buf + "    // ARCH GATE: HXLCL_SYS_* + _hxlcl_syscall*_cf are Darwin arm64 only.\n"
    buf = buf + "    // Linux/other arches fall back to libc (same errno-set semantics).\n"
    buf = buf + "#if (defined(__arm64__) || defined(__aarch64__)) && defined(__APPLE__)\n"
    buf = buf + "    return (int)_hxlcl_syscall6_cf(HXLCL_SYS_SETSOCKOPT, (long)sockfd, (long)level,\n"
    buf = buf + "                                   (long)optname, (long)optval, (long)optlen, 0);\n"
    buf = buf + "#else\n"
    buf = buf + "    return setsockopt(sockfd, level, optname, optval, (socklen_t)optlen);\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "static int hxlcl_grantpt(int fd) { (void)fd; return (int)HX_INT(rt_posix_ok()); }\n"
    buf = buf + "static int hxlcl_unlockpt(int fd) { (void)fd; return (int)HX_INT(rt_posix_ok()); }\n"
    buf = buf + "static char *hxlcl_ptsname(int fd) { (void)fd; (void)rt_posix_ok(); return (char *)\"/dev/null\"; }\n"
    buf = buf + "static char *hxlcl_ttyname(int fd) { (void)fd; (void)rt_posix_ok(); return (char *)0; }\n"
    buf = buf + "static int hxlcl_getrlimit(int resource, void *rlim) {\n"
    buf = buf + "    (void)resource;\n"
    buf = buf + "    if (rlim) {\n"
    buf = buf + "        unsigned long long *p = (unsigned long long *)rlim;\n"
    buf = buf + "        p[0] = 0xffffffffffffffffULL;\n"
    buf = buf + "        p[1] = 0xffffffffffffffffULL;\n"
    buf = buf + "    }\n"
    buf = buf + "    return (int)HX_INT(rt_posix_ok());\n"
    buf = buf + "}\n"
    buf = buf + "static int hxlcl_getrusage(int who, void *usage) {\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    (void)who;\n"
    buf = buf + "    if (usage) {\n"
    buf = buf + "        unsigned char *p = (unsigned char *)usage;\n"
    buf = buf + "        for (size_t i = 0; i < 144; i++) p[i] = 0;\n"
    buf = buf + "    }\n"
    buf = buf + "    return (int)HX_INT(rt_posix_ok());\n"
    buf = buf + "}\n"
    buf = buf + "// cycle 6: time/term/mach thin shims (5 fns)\n"
    buf = buf + "static int hxlcl_time(int *t) {\n"
    buf = buf + "    if (t) *t = 0;\n"
    buf = buf + "    return (int)HX_INT(rt_posix_ok());\n"
    buf = buf + "}\n"
    buf = buf + "// M16 (GO domain, 2026-05-25): real libc nanosleep. The cycle-6 body was a\n"
    buf = buf + "// no-op stub that ignored `req` and returned immediately — so every sleep\n"
    buf = buf + "// builtin (hexa_sleep / sleep_s / sleep_ms / sleep_ns) and the\n"
    buf = buf + "// persistent_pipe 10ms backoff were silently no-ops on the compiled path\n"
    buf = buf + "// (mono_ns delta ≈ 1µs instead of the requested duration). libc nanosleep\n"
    buf = buf + "// is already linked (the clock_gettime shims above use the same <time.h>\n"
    buf = buf + "// family); pass through so the requested sleep actually elapses. EINTR is\n"
    buf = buf + "// surfaced to callers (return -1, errno set) which loop on `rem` to finish\n"
    buf = buf + "// the remaining time.\n"
    buf = buf + "// RUNTIME tail (cycle 83): nanosleep has NO direct Darwin BSD syscall (libc\n"
    buf = buf + "// implements it over __semwait_signal). Reimplement on select(2) (svc 93,\n"
    buf = buf + "// already trapped): select(0, NULL, NULL, NULL, &tv) with a NULL fd-set and\n"
    buf = buf + "// a timeout is a precise sleep. EINTR is absorbed internally by recomputing\n"
    buf = buf + "// the remaining interval from the clock, so we always sleep the full\n"
    buf = buf + "// duration and return 0 (rem zeroed). Drops the libc _nanosleep extern.\n"
    buf = buf + "static int hxlcl_nanosleep(const void *req_, void *rem_) {\n"
    buf = buf + "    const struct timespec *req = (const struct timespec *)req_;\n"
    buf = buf + "    long long total_ns = (long long)req->tv_sec * 1000000000LL + (long long)req->tv_nsec;\n"
    buf = buf + "    if (rem_) { ((struct timespec *)rem_)->tv_sec = 0; ((struct timespec *)rem_)->tv_nsec = 0; }\n"
    buf = buf + "    if (total_ns <= 0) return 0;\n"
    buf = buf + "    struct timespec start; hxlcl_clock_gettime(CLOCK_MONOTONIC, &start);\n"
    buf = buf + "    for (;;) {\n"
    buf = buf + "        struct timespec now; hxlcl_clock_gettime(CLOCK_MONOTONIC, &now);\n"
    buf = buf + "        long long elapsed = ((long long)now.tv_sec - start.tv_sec) * 1000000000LL\n"
    buf = buf + "                          + ((long long)now.tv_nsec - start.tv_nsec);\n"
    buf = buf + "        long long left = total_ns - elapsed;\n"
    buf = buf + "        if (left <= 0) return 0;\n"
    buf = buf + "#ifdef HXLCL_SYS_SELECT\n"
    buf = buf + "        struct timeval tv;\n"
    buf = buf + "        tv.tv_sec  = (long)(left / 1000000000LL);\n"
    buf = buf + "        tv.tv_usec = (int)((left % 1000000000LL) / 1000);\n"
    buf = buf + "#if (defined(__arm64__) || defined(__aarch64__)) && defined(__APPLE__)\n"
    buf = buf + "        long r = _hxlcl_syscall6_cf(HXLCL_SYS_SELECT, 0, 0, 0, 0, (long)&tv, 0);\n"
    buf = buf + "#else\n"
    buf = buf + "        // Linux: the Apple raw-trap select primitive (_hxlcl_syscall6_cf /\n"
    buf = buf + "        // HXLCL_SYS_SELECT) lives only in the arm64-darwin branch; route the\n"
    buf = buf + "        // NULL-fd-set timeout sleep through libc select() (<sys/select.h>).\n"
    buf = buf + "        long r = select(0, NULL, NULL, NULL, &tv);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "#endif\n"
    buf = buf + "        if (r == 0) return 0;          // timeout elapsed -> full sleep done\n"
    buf = buf + "        if (errno == EINTR) continue;   // signal: recompute remaining, retry\n"
    buf = buf + "        return -1;                      // genuine error\n"
    buf = buf + "#else\n"
    buf = buf + "        // non-Apple (Linux / Intel): HXLCL_SYS_SELECT is the Apple-arm64-only\n"
    buf = buf + "        // raw-syscall number; everywhere else use libc nanosleep (POSIX, present\n"
    buf = buf + "        // in every _GNU_SOURCE build). Same EINTR-resume + full-sleep semantics.\n"
    buf = buf + "        struct timespec ts;\n"
    buf = buf + "        ts.tv_sec  = (long)(left / 1000000000LL);\n"
    buf = buf + "        ts.tv_nsec = (long)(left % 1000000000LL);\n"
    buf = buf + "        int r = nanosleep(&ts, NULL);\n"
    buf = buf + "        if (r == 0) return 0;          // full sleep done\n"
    buf = buf + "        if (errno == EINTR) continue;   // signal: recompute remaining, retry\n"
    buf = buf + "        return -1;                      // genuine error\n"
    buf = buf + "#endif\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "static int hxlcl_tcgetattr(int fd, void *termios) {\n"
    buf = buf + "    (void)fd;\n"
    buf = buf + "    if (termios) {\n"
    buf = buf + "        unsigned char *p = (unsigned char *)termios;\n"
    buf = buf + "        for (size_t i = 0; i < 72; i++) p[i] = 0;\n"
    buf = buf + "    }\n"
    buf = buf + "    // tcgetattr should return -1 (we're not a TTY) — use rt_net_fail\n"
    buf = buf + "    return (int)HX_INT(rt_net_fail());\n"
    buf = buf + "}\n"
    buf = buf + "static int hxlcl_tcsetattr(int fd, int optional_actions, const void *termios) {\n"
    buf = buf + "    (void)fd; (void)optional_actions; (void)termios;\n"
    buf = buf + "    return (int)HX_INT(rt_posix_ok());\n"
    buf = buf + "}\n"
    buf = buf + "static int hxlcl_task_info(unsigned int target, unsigned int flavor, void *info_out, unsigned int *count) {\n"
    buf = buf + "    (void)target; (void)flavor;\n"
    buf = buf + "    if (info_out && count && *count > 0) {\n"
    buf = buf + "        unsigned char *p = (unsigned char *)info_out;\n"
    buf = buf + "        for (size_t i = 0; i < (size_t)(*count) * 4; i++) p[i] = 0;\n"
    buf = buf + "    }\n"
    buf = buf + "    return (int)HX_INT(rt_posix_ok());\n"
    buf = buf + "}\n"
    buf = buf + "// cycle 6: strftime thin shim — return 0 length (empty output)\n"
    buf = buf + "static size_t hxlcl_strftime(char *buf, size_t cap, const char *fmt, void *tm) {\n"
    buf = buf + "    (void)fmt; (void)tm;\n"
    buf = buf + "    if (buf && cap > 0) buf[0] = '\\0';\n"
    buf = buf + "    return (size_t)HX_INT(rt_posix_ok());\n"
    buf = buf + "}\n"
    buf = buf + "// hexa-native gmtime_r — UTC civil time from a Unix epoch, no libc. Uses\n"
    buf = buf + "// Howard Hinnant's public-domain civil-from-days algorithm. Fills the\n"
    buf = buf + "// struct tm fields strftime reads (year/mon/mday/hour/min/sec + wday/yday).\n"
    buf = buf + "static void *hxlcl_gmtime_r(const void *tp, void *out) {\n"
    buf = buf + "    long long t = (long long)(*(const time_t *)tp);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    long long days = t / 86400;\n"
    buf = buf + "    long long secs = t % 86400;\n"
    buf = buf + "    if (secs < 0) { secs += 86400; days -= 1; }   // floor toward -inf\n"
    buf = buf + "    long long z = days + 719468;\n"
    buf = buf + "    long long era = (z >= 0 ? z : z - 146096) / 146097;\n"
    buf = buf + "    unsigned doe = (unsigned)(z - era * 146097);                 // [0,146096]\n"
    buf = buf + "    unsigned yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365; // [0,399]\n"
    buf = buf + "    long long y = (long long)yoe + era * 400;\n"
    buf = buf + "    unsigned doy = doe - (365 * yoe + yoe / 4 - yoe / 100);      // [0,365]\n"
    buf = buf + "    unsigned mp = (5 * doy + 2) / 153;                           // [0,11]\n"
    buf = buf + "    unsigned d = doy - (153 * mp + 2) / 5 + 1;                   // [1,31]\n"
    buf = buf + "    unsigned m = mp < 10 ? mp + 3 : mp - 9;                      // [1,12]\n"
    buf = buf + "    y += (m <= 2);\n"
    buf = buf + "    struct tm *g = (struct tm *)out;\n"
    buf = buf + "    g->tm_year = (int)(y - 1900);\n"
    buf = buf + "    g->tm_mon  = (int)(m - 1);\n"
    buf = buf + "    g->tm_mday = (int)d;\n"
    buf = buf + "    g->tm_hour = (int)(secs / 3600);\n"
    buf = buf + "    g->tm_min  = (int)((secs % 3600) / 60);\n"
    buf = buf + "    g->tm_sec  = (int)(secs % 60);\n"
    buf = buf + "    int wd = (int)((days % 7 + 4) % 7); if (wd < 0) wd += 7;     // 1970-01-01 = Thu(4)\n"
    buf = buf + "    g->tm_wday = wd;\n"
    buf = buf + "    static const int mdays[12] = {31,28,31,30,31,30,31,31,30,31,30,31};\n"
    buf = buf + "    int leap = ((y % 4 == 0 && y % 100 != 0) || y % 400 == 0);\n"
    buf = buf + "    int yd = (int)d - 1;\n"
    buf = buf + "    for (unsigned i = 0; i + 1 < m; i++) { yd += mdays[i]; if (i == 1 && leap) yd += 1; }\n"
    buf = buf + "    g->tm_yday = yd;\n"
    buf = buf + "    g->tm_isdst = 0;\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "// GO M10 (RFC 093 R1 prototype, 2026-05-25) — restore real libc socket\n"
    buf = buf + "// bodies. Cycle 61 stubbed these out with rationale \"aprime_cc doesn't\n"
    buf = buf + "// open network connections during compile\" — true for the compiler, but\n"
    buf = buf + "// `hexa daemon` (and any future net-using `hexa` subverb / stdlib path)\n"
    buf = buf + "// needs working sockets in the same driver binary. Prototypes come from\n"
    buf = buf + "// the top-of-file <sys/socket.h> / <arpa/inet.h> includes (the cmsg/\n"
    buf = buf + "// msghdr structs net.c uses are declared there too). The hxlcl_* names\n"
    buf = buf + "// are the indirection net.c calls through. Mirrors the cycle-66 close/\n"
    buf = buf + "// pipe libc restore. The (void*)-typed addr/msg params widen the libc\n"
    buf = buf + "// `struct sockaddr*` / `struct msghdr*` signatures — the casts at the\n"
    buf = buf + "// call sites are exact, so this is ABI-safe.\n"
    buf = buf + "// net/exec ③ (cycle 78): svc-trap the socket group via carry-flag helpers.\n"
    buf = buf + "// Plain BSD syscalls — same shape as the already-trapped read/write/open;\n"
    buf = buf + "// _cf translates the carry-set error path to -1 + errno. accept returns a\n"
