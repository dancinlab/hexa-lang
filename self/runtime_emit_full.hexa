    buf = buf + "                        hxlcl_memcpy(buf + len, s + *pi, 6);\n"
    buf = buf + "                        len += 6;\n"
    buf = buf + "                        *pi += 6;\n"
    buf = buf + "                        continue;\n"
    buf = buf + "                    }\n"
    buf = buf + "                    out = 'u';\n"
    buf = buf + "                    break;\n"
    buf = buf + "                default:   out = e; break;\n"
    buf = buf + "            }\n"
    buf = buf + "            if (len + 1 >= cap) { cap *= 2; char* nb = (char*)realloc(buf, cap); if (!nb) { free(buf); return hexa_str(\"\"); } buf = nb; }\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "            buf[len++] = out;\n"
    buf = buf + "            *pi += consumed;\n"
    buf = buf + "            continue;\n"
    buf = buf + "        }\n"
    buf = buf + "        if (len + 1 >= cap) { cap *= 2; char* nb = (char*)realloc(buf, cap); if (!nb) { free(buf); return hexa_str(\"\"); } buf = nb; }\n"
    buf = buf + "        buf[len++] = c;\n"
    buf = buf + "        (*pi)++;\n"
    buf = buf + "    }\n"
    buf = buf + "    buf[len] = 0;\n"
    buf = buf + "    return hexa_str_own(buf);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "static HexaVal _jp_parse_number(const char* s, size_t n, size_t* pi) {\n"
    buf = buf + "    size_t start = *pi;\n"
    buf = buf + "    int is_float = 0;\n"
    buf = buf + "    if (*pi < n && (s[*pi] == '-' || s[*pi] == '+')) (*pi)++;\n"
    buf = buf + "    while (*pi < n) {\n"
    buf = buf + "        char c = s[*pi];\n"
    buf = buf + "        if (c >= '0' && c <= '9') { (*pi)++; continue; }\n"
    buf = buf + "        if (c == '.' || c == 'e' || c == 'E' || c == '+' || c == '-') {\n"
    buf = buf + "            is_float = 1;\n"
    buf = buf + "            (*pi)++;\n"
    buf = buf + "            continue;\n"
    buf = buf + "        }\n"
    buf = buf + "        break;\n"
    buf = buf + "    }\n"
    buf = buf + "    size_t k = *pi - start;\n"
    buf = buf + "    char buf[64];\n"
    buf = buf + "    if (k >= sizeof(buf)) k = sizeof(buf) - 1;\n"
    buf = buf + "    hxlcl_memcpy(buf, s + start, k);\n"
    buf = buf + "    buf[k] = 0;\n"
    buf = buf + "    if (is_float) return hexa_float(hxlcl_atof(buf));\n"
    buf = buf + "    return hexa_int((int64_t)hxlcl_strtoll(buf, NULL, 10));\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "static HexaVal _jp_parse_array(const char* s, size_t n, size_t* pi) {\n"
    buf = buf + "    if (*pi >= n || s[*pi] != '[') return hexa_array_new();\n"
    buf = buf + "    (*pi)++;\n"
    buf = buf + "    HexaVal arr = hexa_array_new();\n"
    buf = buf + "    _jp_skip_ws(s, n, pi);\n"
    buf = buf + "    if (*pi < n && s[*pi] == ']') { (*pi)++; return arr; }\n"
    buf = buf + "    while (*pi < n) {\n"
    buf = buf + "        _jp_skip_ws(s, n, pi);\n"
    buf = buf + "        HexaVal v = _jp_parse_value(s, n, pi);\n"
    buf = buf + "        arr = hexa_array_push(arr, v);\n"
    buf = buf + "        _jp_skip_ws(s, n, pi);\n"
    buf = buf + "        if (*pi < n && s[*pi] == ',') { (*pi)++; continue; }\n"
    buf = buf + "        if (*pi < n && s[*pi] == ']') { (*pi)++; break; }\n"
    buf = buf + "        break;\n"
    buf = buf + "    }\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    return arr;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "static HexaVal _jp_parse_object(const char* s, size_t n, size_t* pi) {\n"
    buf = buf + "    if (*pi >= n || s[*pi] != '{') return hexa_map_new();\n"
    buf = buf + "    (*pi)++;\n"
    buf = buf + "    HexaVal m = hexa_map_new();\n"
    buf = buf + "    _jp_skip_ws(s, n, pi);\n"
    buf = buf + "    if (*pi < n && s[*pi] == '}') { (*pi)++; return m; }\n"
    buf = buf + "    while (*pi < n) {\n"
    buf = buf + "        _jp_skip_ws(s, n, pi);\n"
    buf = buf + "        HexaVal key = _jp_parse_string(s, n, pi);\n"
    buf = buf + "        _jp_skip_ws(s, n, pi);\n"
    buf = buf + "        if (*pi < n && s[*pi] == ':') (*pi)++;\n"
    buf = buf + "        _jp_skip_ws(s, n, pi);\n"
    buf = buf + "        HexaVal val = _jp_parse_value(s, n, pi);\n"
    buf = buf + "        if (HX_IS_STR(key) && HX_STR(key)) m = hexa_map_set(m, HX_STR(key), val);\n"
    buf = buf + "        _jp_skip_ws(s, n, pi);\n"
    buf = buf + "        if (*pi < n && s[*pi] == ',') { (*pi)++; continue; }\n"
    buf = buf + "        if (*pi < n && s[*pi] == '}') { (*pi)++; break; }\n"
    buf = buf + "        break;\n"
    buf = buf + "    }\n"
    buf = buf + "    return m;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "static HexaVal _jp_parse_value(const char* s, size_t n, size_t* pi) {\n"
    buf = buf + "    _jp_skip_ws(s, n, pi);\n"
    buf = buf + "    if (*pi >= n) return hexa_void();\n"
    buf = buf + "    char c = s[*pi];\n"
    buf = buf + "    if (c == '\"') return _jp_parse_string(s, n, pi);\n"
    buf = buf + "    if (c == '{') return _jp_parse_object(s, n, pi);\n"
    buf = buf + "    if (c == '[') return _jp_parse_array(s, n, pi);\n"
    buf = buf + "    if (c == 't' && *pi + 3 < n && hxlcl_memcmp(s + *pi, \"true\", 4) == 0) { *pi += 4; return hexa_bool(1); }\n"
    buf = buf + "    if (c == 'f' && *pi + 4 < n && hxlcl_memcmp(s + *pi, \"false\", 5) == 0) { *pi += 5; return hexa_bool(0); }\n"
    buf = buf + "    if (c == 'n' && *pi + 3 < n && hxlcl_memcmp(s + *pi, \"null\", 4) == 0) { *pi += 4; return hexa_void(); }\n"
    buf = buf + "    // CPython json.loads accepts the non-finite literals Infinity / -Infinity\n"
    buf = buf + "    // / NaN (json.dumps emits them for non-finite floats). Standard JSON\n"
    buf = buf + "    // forbids them, but the hexa-bio registry contains `-Infinity` rows, so\n"
    buf = buf + "    // for byte-parity with the Python reference we accept them here. Must\n"
    buf = buf + "    // precede the '-'/digit number branch so \"-Infinity\" is not mis-lexed\n"
    buf = buf + "    // as the number \"-\" (which left \"Infinity\" in the stream and desynced\n"
    buf = buf + "    // the enclosing object parse, dropping every subsequent key).\n"
    buf = buf + "    if (c == 'I' && *pi + 8 <= n && hxlcl_memcmp(s + *pi, \"Infinity\", 8) == 0) { *pi += 8; return hexa_float(INFINITY); }\n"
    buf = buf + "    if (c == '-' && *pi + 9 <= n && hxlcl_memcmp(s + *pi, \"-Infinity\", 9) == 0) { *pi += 9; return hexa_float(-INFINITY); }\n"
    buf = buf + "    if (c == 'N' && *pi + 3 <= n && hxlcl_memcmp(s + *pi, \"NaN\", 3) == 0) { *pi += 3; return hexa_float(NAN); }\n"
    buf = buf + "    if (c == '-' || (c >= '0' && c <= '9')) return _jp_parse_number(s, n, pi);\n"
    buf = buf + "    (*pi)++;  // skip unknown\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "HexaVal hexa_json_parse(HexaVal s) {\n"
    buf = buf + "    if (!HX_IS_STR(s) || !HX_STR(s)) return hexa_void();\n"
    buf = buf + "    const char* cs = HX_STR(s);\n"
    buf = buf + "    size_t n = hxlcl_strlen(cs);\n"
    buf = buf + "    size_t i = 0;\n"
    buf = buf + "    return _jp_parse_value(cs, n, &i);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_json_decode(HexaVal s) { return hexa_json_parse(s); }\n"
    buf = buf + "\n"
    buf = buf + "// Stringify — one-shot growth buffer, no intermediate HexaVals.\n"
    buf = buf + "static void _js_buf_reserve(char** pbuf, size_t* pcap, size_t need) {\n"
    buf = buf + "    if (*pcap >= need) return;\n"
    buf = buf + "    size_t nc = *pcap ? *pcap : 64;\n"
    buf = buf + "    while (nc < need) nc *= 2;\n"
    buf = buf + "    char* nb = (char*)realloc(*pbuf, nc);\n"
    buf = buf + "    if (!nb) return;\n"
    buf = buf + "    *pbuf = nb;\n"
    buf = buf + "    *pcap = nc;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "static void _js_buf_append(char** pbuf, size_t* pcap, size_t* plen, const char* s, size_t n) {\n"
    buf = buf + "    _js_buf_reserve(pbuf, pcap, *plen + n + 1);\n"
    buf = buf + "    if (!*pbuf) return;\n"
    buf = buf + "    hxlcl_memcpy(*pbuf + *plen, s, n);\n"
    buf = buf + "    *plen += n;\n"
    buf = buf + "    (*pbuf)[*plen] = 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "static void _js_emit_string(char** pbuf, size_t* pcap, size_t* plen, const char* s) {\n"
    buf = buf + "    _js_buf_append(pbuf, pcap, plen, \"\\\"\", 1);\n"
    buf = buf + "    if (!s) { _js_buf_append(pbuf, pcap, plen, \"\\\"\", 1); return; }\n"
    buf = buf + "    for (const char* p = s; *p; p++) {\n"
    buf = buf + "        unsigned char c = (unsigned char)*p;\n"
    buf = buf + "        if (c == '\"')       _js_buf_append(pbuf, pcap, plen, \"\\\\\\\"\", 2);\n"
    buf = buf + "        else if (c == '\\\\') _js_buf_append(pbuf, pcap, plen, \"\\\\\\\\\", 2);\n"
    buf = buf + "        else if (c == '\\n') _js_buf_append(pbuf, pcap, plen, \"\\\\n\", 2);\n"
    buf = buf + "        else if (c == '\\r') _js_buf_append(pbuf, pcap, plen, \"\\\\r\", 2);\n"
    buf = buf + "        else if (c == '\\t') _js_buf_append(pbuf, pcap, plen, \"\\\\t\", 2);\n"
    buf = buf + "        else if (c == '\\b') _js_buf_append(pbuf, pcap, plen, \"\\\\b\", 2);\n"
    buf = buf + "        else if (c == '\\f') _js_buf_append(pbuf, pcap, plen, \"\\\\f\", 2);\n"
    buf = buf + "        else if (c < 0x20) {\n"
    buf = buf + "            char esc[8];\n"
    buf = buf + "            int k = snprintf(esc, sizeof(esc), \"\\\\u%04x\", c);\n"
    buf = buf + "            if (k > 0) _js_buf_append(pbuf, pcap, plen, esc, (size_t)k);\n"
    buf = buf + "        } else {\n"
    buf = buf + "            char ch = (char)c;\n"
    buf = buf + "            _js_buf_append(pbuf, pcap, plen, &ch, 1);\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    _js_buf_append(pbuf, pcap, plen, \"\\\"\", 1);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "static void _js_emit_value(char** pbuf, size_t* pcap, size_t* plen, HexaVal v);\n"
    buf = buf + "\n"
    buf = buf + "static void _js_emit_array(char** pbuf, size_t* pcap, size_t* plen, HexaVal v) {\n"
    buf = buf + "    _js_buf_append(pbuf, pcap, plen, \"[\", 1);\n"
    buf = buf + "    int64_t n = (int64_t)HX_ARR_LEN(v);\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        if (i) _js_buf_append(pbuf, pcap, plen, \",\", 1);\n"
    buf = buf + "        _js_emit_value(pbuf, pcap, plen, HX_ARR_ITEMS(v)[i]);\n"
    buf = buf + "    }\n"
    buf = buf + "    _js_buf_append(pbuf, pcap, plen, \"]\", 1);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "static void _js_emit_object(char** pbuf, size_t* pcap, size_t* plen, HexaVal v) {\n"
    buf = buf + "    _js_buf_append(pbuf, pcap, plen, \"{\", 1);\n"
    buf = buf + "    HexaVal keys = hexa_map_keys(v);\n"
    buf = buf + "    int64_t n = (int64_t)HX_ARR_LEN(keys);\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        if (i) _js_buf_append(pbuf, pcap, plen, \",\", 1);\n"
    buf = buf + "        HexaVal k = HX_ARR_ITEMS(keys)[i];\n"
    buf = buf + "        if (HX_IS_STR(k)) _js_emit_string(pbuf, pcap, plen, HX_STR(k));\n"
    buf = buf + "        else              _js_emit_string(pbuf, pcap, plen, \"\");\n"
    buf = buf + "        _js_buf_append(pbuf, pcap, plen, \":\", 1);\n"
    buf = buf + "        HexaVal vv = hexa_map_get(v, HX_IS_STR(k) ? HX_STR(k) : \"\");\n"
    buf = buf + "        _js_emit_value(pbuf, pcap, plen, vv);\n"
    buf = buf + "    }\n"
    buf = buf + "    _js_buf_append(pbuf, pcap, plen, \"}\", 1);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// shortest %g-form decimal that round-trips to the same double — matches\n"
    buf = buf + "// CPython repr()/json.dumps() shortest-representation output. zero-c #29:\n"
    buf = buf + "// when the native FORMAT (rt_format_float_native, byte-exact %g) + EXACT PARSE\n"
    buf = buf + "// (rt_str_parse_float_exact, correctly-rounded over ALL finite decimals — never\n"
    buf = buf + "// declines on %g output) seeds are present, the per-sig round-trip uses them +\n"
    buf = buf + "// the native string copy, dropping the libc snprintf %g / strtod / snprintf %s\n"
    buf = buf + "// from the default ship. The C #else path is retained for the no-seed build.\n"
    buf = buf + "// Mirrors the runtime_core_emit.hexa __hexa_format_float native round-trip.\n"
    buf = buf + "static void _shortest_double(char* buf, size_t cap, double f) {\n"
    buf = buf + "#if defined(HEXA_RT_FORMAT_FLOAT_NATIVE) && defined(HEXA_RT_NUM_PARSE_FLOAT_EXACT)\n"
    buf = buf + "    extern HexaVal rt_format_float_native(HexaVal v, HexaVal sig);\n"
    buf = buf + "    extern HexaVal rt_str_parse_float_exact(HexaVal s);\n"
    buf = buf + "    unsigned long long fb; __builtin_memcpy(&fb, &f, 8);\n"
    buf = buf + "    for (int _p = 1; _p < 17; _p++) {\n"
    buf = buf + "        HexaVal r = rt_format_float_native(hexa_float(f), hexa_int(_p));\n"
    buf = buf + "        if (HX_TAG(r) != TAG_STR || !HX_STR(r)) break;\n"
    buf = buf + "        HexaVal pv = rt_str_parse_float_exact(r);\n"
    buf = buf + "        if (HX_TAG(pv) == TAG_FLOAT) {\n"
    buf = buf + "            double rp = HX_FLOAT(pv);\n"
    buf = buf + "            unsigned long long rb; __builtin_memcpy(&rb, &rp, 8);\n"
    buf = buf + "            if (fb == rb) {\n"
    buf = buf + "                const char* cs = HX_STR(r); unsigned long n = hxlcl_strlen(cs);\n"
    buf = buf + "                if (n >= cap) n = cap - 1; hxlcl_memcpy(buf, cs, n); buf[n] = 0; return;\n"
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    { HexaVal r = rt_format_float_native(hexa_float(f), hexa_int(17));\n"
    buf = buf + "      if (HX_TAG(r) == TAG_STR && HX_STR(r)) {\n"
    buf = buf + "          const char* cs = HX_STR(r); unsigned long n = hxlcl_strlen(cs);\n"
    buf = buf + "          if (n >= cap) n = cap - 1; hxlcl_memcpy(buf, cs, n); buf[n] = 0; return;\n"
    buf = buf + "      } }\n"
    buf = buf + "#endif\n"
    buf = buf + "    for (int _p = 1; _p < 17; _p++) {\n"
    buf = buf + "        snprintf(buf, cap, \"%.*g\", _p, f);\n"
    buf = buf + "        if (strtod(buf, NULL) == f) return;\n"
    buf = buf + "    }\n"
    buf = buf + "    snprintf(buf, cap, \"%.17g\", f);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "static void _js_emit_value(char** pbuf, size_t* pcap, size_t* plen, HexaVal v) {\n"
    buf = buf + "    if (HX_IS_VOID(v))       { _js_buf_append(pbuf, pcap, plen, \"null\", 4); return; }\n"
    buf = buf + "    if (HX_IS_BOOL(v))       { if (HX_BOOL(v)) _js_buf_append(pbuf, pcap, plen, \"true\", 4); else _js_buf_append(pbuf, pcap, plen, \"false\", 5); return; }\n"
    buf = buf + "    if (HX_IS_INT(v))        { char nb[32]; int k = _hx_i64_dec(nb, (long long)HX_INT(v)); if (k > 0) _js_buf_append(pbuf, pcap, plen, nb, (size_t)k); return; }\n"
    buf = buf + "    if (HX_IS_FLOAT(v))      {\n"
    buf = buf + "        double f = HX_FLOAT(v);\n"
    buf = buf + "        char nb[64];\n"
    buf = buf + "        int k;\n"
    buf = buf + "        if (f != f) k = snprintf(nb, sizeof(nb), \"null\");\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        else if (fabs(f) < 1e16 && f == (double)(int64_t)f) { k = _hx_i64_dec(nb, (long long)f); nb[k] = '.'; nb[k+1] = '0'; nb[k+2] = 0; k += 2; }\n"
    buf = buf + "        else { _shortest_double(nb, sizeof(nb), f); k = (int)hxlcl_strlen(nb); }\n"
    buf = buf + "        if (k > 0) _js_buf_append(pbuf, pcap, plen, nb, (size_t)k);\n"
    buf = buf + "        return;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (HX_IS_STR(v))        { _js_emit_string(pbuf, pcap, plen, HX_STR(v) ? HX_STR(v) : \"\"); return; }\n"
    buf = buf + "    if (HX_IS_ARRAY(v))      { _js_emit_array(pbuf, pcap, plen, v); return; }\n"
    buf = buf + "    if (HX_IS_MAP(v))        { _js_emit_object(pbuf, pcap, plen, v); return; }\n"
    buf = buf + "    _js_buf_append(pbuf, pcap, plen, \"null\", 4);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_json_stringify(HexaVal v) {\n"
    buf = buf + "    char* buf = NULL;\n"
    buf = buf + "    size_t cap = 0, len = 0;\n"
    buf = buf + "    _js_emit_value(&buf, &cap, &len, v);\n"
    buf = buf + "    if (!buf) return hexa_str(\"\");\n"
    buf = buf + "    return hexa_str_own(buf);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_json_encode(HexaVal v) { return hexa_json_stringify(v); }\n"
    buf = buf + "\n"
    buf = buf + "// FIX-A (Anima ML eval unblock, 2026-04-19) ─────────────────────────\n"
    buf = buf + "// 8 tensor_* fallback builtins required by anima/serving/eval_alm.hexa\n"
    buf = buf + "// (and siblings) that do not explicitly `use \"self/ml/tensor_ops.hexa\"`.\n"
    buf = buf + "// Semantics mirror the pure-hexa tensor_ops implementation; performance\n"
    buf = buf + "// is intentionally naive — callers on the fast-path still pull the\n"
    buf = buf + "// BLAS/NEON-optimized self/ml/ modules explicitly. All ops operate on\n"
    buf = buf + "// flat row-major arrays of TAG_FLOAT / TAG_INT (coerced via __hx_to_double).\n"
    buf = buf + "\n"
    buf = buf + "// tensor_zeros(n): length-n array filled with 0.0.\n"
    buf = buf + "HexaVal hexa_tensor_zeros(HexaVal nv) {\n"
    buf = buf + "    int64_t n = (int64_t)__hx_to_double(nv);\n"
    buf = buf + "    if (n < 0) n = 0;\n"
    buf = buf + "    HexaVal arr = hexa_array_new();\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) arr = hexa_array_push(arr, hexa_float(0.0));\n"
    buf = buf + "    return arr;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// FIX-A 2nd batch (2026-04-19): tensor_ones(n) — length-n array filled with 1.0.\n"
    buf = buf + "// Pairs with tensor_zeros for anima-speak init paths (ln_g, rms_g).\n"
    buf = buf + "HexaVal hexa_tensor_ones(HexaVal nv) {\n"
