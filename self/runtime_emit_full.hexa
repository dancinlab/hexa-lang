    buf = buf + "#else\n"
    buf = buf + "    return hexa_int(_hx_farr_mul_cpu(a_id, b_id, n));\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// farr_silu_gpu(x, n) -> int new farr_id (y = silu(x)).\n"
    buf = buf + "// On HEXA_CUDA: wired (Phase 4-D-5-4 step 1, 2026-05-17) to\n"
    buf = buf + "// _hx_cuda_farr_silu_gpu (1-D grid-stride, σ via __expf, byte-eq\n"
