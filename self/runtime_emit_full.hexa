    buf = buf + "\n"
    buf = buf + "#include \"runtime_core.c\"\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// RUNTIME.md step-2 cycle 1 POC — thin C shim for `hxlcl_isalnum`/_isalpha\n"
    buf = buf + "// delegating to hexa-source `rt_isalnum`/_isalpha (in stdlib/runtime/\n"
    buf = buf + "// ctype.hexa, emitted into ap_post.c by transpile). Two scenarios:\n"
    buf = buf + "//\n"
    buf = buf + "//   (a) full aprime_cc build: ap_post.c defines `HEXA_HAS_HEXA_RT_STDLIB`\n"
    buf = buf + "//       above `#include \"runtime.c\"` (build_aprime.sh post-process\n"
    buf = buf + "//       prepends it), the hexa-source rt_isalnum/rt_isalpha definitions\n"
    buf = buf + "//       win as the strong symbols, and the C fallbacks here are\n"
    buf = buf + "//       skipped.\n"
    buf = buf + "//\n"
