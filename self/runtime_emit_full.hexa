    buf = buf + "    return hexa_int(int_total);\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// mean(a): float average. Empty array returns float 0.0.\n"
    buf = buf + "// Step-3 cycle 20 port.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_array_mean(HexaVal arr) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_float(0.0);\n"
