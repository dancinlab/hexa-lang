    buf = buf + "HexaVal hx_exec_capture;\n"
    buf = buf + "HexaVal exec_with_status3;\n"
    buf = buf + "HexaVal hx_push;\n"
    buf = buf + "// Cycle 55 recovery — stdlib/fs builtins as bt73 TAG_FN HexaVal globals.\n"
    buf = buf + "HexaVal rt_fs_append_atomic(HexaVal path, HexaVal data);\n"
