    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// swap(i, j): returns new array with items at i and j swapped.\n"
    buf = buf + "// Out-of-range indices return original array copy.\n"
    buf = buf + "// Matches interpreter at hexa_full.hexa:15497-15512. Step-3 cycle 25 port.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_array_swap(HexaVal arr, HexaVal iv, HexaVal jv) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int64_t n = HX_ARR_LEN(arr);\n"
    buf = buf + "    int64_t i = HX_IS_INT(iv) ? HX_INT(iv) : (int64_t)__hx_to_double(iv);\n"
    buf = buf + "    int64_t j = HX_IS_INT(jv) ? HX_INT(jv) : (int64_t)__hx_to_double(jv);\n"
    buf = buf + "    if (i < 0 || j < 0 || i >= n || j >= n) {\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        for (int64_t k = 0; k < n; k++) out = hexa_array_push(out, HX_ARR_ITEMS(arr)[k]);\n"
    buf = buf + "        return out;\n"
    buf = buf + "    }\n"
    buf = buf + "    for (int64_t k = 0; k < n; k++) {\n"
    buf = buf + "        if (k == i) out = hexa_array_push(out, HX_ARR_ITEMS(arr)[j]);\n"
    buf = buf + "        else if (k == j) out = hexa_array_push(out, HX_ARR_ITEMS(arr)[i]);\n"
    buf = buf + "        else out = hexa_array_push(out, HX_ARR_ITEMS(arr)[k]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_array_swap_float(HexaVal arr, HexaVal i, HexaVal j);\n"
    buf = buf + "HexaVal hexa_array_swap(HexaVal arr, HexaVal iv, HexaVal jv) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int64_t i = HX_IS_INT(iv) ? HX_INT(iv) : (int64_t)__hx_to_double(iv);\n"
    buf = buf + "    int64_t j = HX_IS_INT(jv) ? HX_INT(jv) : (int64_t)__hx_to_double(jv);\n"
    buf = buf + "    if (_arr_all_float(arr)) return rt_array_swap_float(arr, hexa_int(i), hexa_int(j));\n"
    buf = buf + "    int64_t n = HX_ARR_LEN(arr);\n"
    buf = buf + "    if (i < 0 || j < 0 || i >= n || j >= n) {\n"
    buf = buf + "        for (int64_t k = 0; k < n; k++) out = hexa_array_push(out, HX_ARR_ITEMS(arr)[k]);\n"
    buf = buf + "        return out;\n"
    buf = buf + "    }\n"
    buf = buf + "    for (int64_t k = 0; k < n; k++) {\n"
    buf = buf + "        if (k == i) out = hexa_array_push(out, HX_ARR_ITEMS(arr)[j]);\n"
    buf = buf + "        else if (k == j) out = hexa_array_push(out, HX_ARR_ITEMS(arr)[i]);\n"
    buf = buf + "        else out = hexa_array_push(out, HX_ARR_ITEMS(arr)[k]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// group_by: apply fn(item) → key, bucket items into map[str(key)] = [items].\n"
    buf = buf + "// Interpreter (self/hexa_full.hexa:15323-15344) compares keys via\n"
    buf = buf + "// val_to_string, so we do the same via hexa_to_string for parity — non-\n"
    buf = buf + "// string keys still group correctly. Values accumulate as arrays.\n"
    buf = buf + "HexaVal hexa_array_group_by(HexaVal arr, HexaVal fn) {\n"
    buf = buf + "    HexaVal out = hexa_map_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    for (int i = 0; i < HX_ARR_LEN(arr); i++) {\n"
    buf = buf + "        HexaVal item = HX_ARR_ITEMS(arr)[i];\n"
    buf = buf + "        HexaVal key = hexa_call1(fn, item);\n"
    buf = buf + "        const char* k_str = hexa_str_as_ptr(hexa_to_string(key));\n"
    buf = buf + "        if (!k_str) continue;\n"
    buf = buf + "        HexaVal bucket;\n"
    buf = buf + "        if (hexa_map_contains_key(out, k_str)) {\n"
    buf = buf + "            bucket = hexa_map_get(out, k_str);\n"
    buf = buf + "        } else {\n"
    buf = buf + "            bucket = hexa_array_new();\n"
    buf = buf + "        }\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        bucket = hexa_array_push(bucket, item);\n"
    buf = buf + "        out = hexa_map_set(out, k_str, bucket);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// frequencies: count occurrences per value; keys are stringified via\n"
    buf = buf + "// hexa_to_string (same as group_by). Returns map<str, int>. Matches\n"
    buf = buf + "// interpreter at self/hexa_full.hexa:15509-15528.\n"
    buf = buf + "HexaVal hexa_array_frequencies(HexaVal arr) {\n"
    buf = buf + "    HexaVal out = hexa_map_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    for (int i = 0; i < HX_ARR_LEN(arr); i++) {\n"
    buf = buf + "        const char* k = hexa_str_as_ptr(hexa_to_string(HX_ARR_ITEMS(arr)[i]));\n"
    buf = buf + "        if (!k) continue;\n"
    buf = buf + "        int64_t cur = 0;\n"
    buf = buf + "        if (hexa_map_contains_key(out, k)) {\n"
    buf = buf + "            HexaVal v = hexa_map_get(out, k);\n"
    buf = buf + "            cur = HX_IS_INT(v) ? HX_INT(v) : (int64_t)__hx_to_double(v);\n"
    buf = buf + "        }\n"
    buf = buf + "        out = hexa_map_set(out, k, hexa_int(cur + 1));\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// sample(n): return n items drawn uniformly at random (with replacement)\n"
    buf = buf + "// from arr. Empty array or n<=0 returns empty array. Uses rand()/RAND_MAX\n"
    buf = buf + "// like hexa_random() so the RNG stream is shared. Matches interpreter at\n"
    buf = buf + "// self/hexa_full.hexa:15544-15556.\n"
    buf = buf + "// Step-3 cycle 70 port — sample dispatch (uses `random()` builtin in\n"
    buf = buf + "// hexa source). C wrapper handles the int coercion from HexaVal nv.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_array_sample(HexaVal arr, HexaVal nv) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int64_t n_items = HX_ARR_LEN(arr);\n"
    buf = buf + "    int64_t n = HX_IS_INT(nv) ? HX_INT(nv) : (int64_t)__hx_to_double(nv);\n"
    buf = buf + "    if (n_items == 0 || n <= 0) return out;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        int64_t idx = (int64_t)(rand() / (double)RAND_MAX * (double)n_items);\n"
    buf = buf + "        if (idx >= n_items) idx = n_items - 1;\n"
    buf = buf + "        out = hexa_array_push(out, HX_ARR_ITEMS(arr)[idx]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_array_sample(HexaVal arr, HexaVal n);\n"
    buf = buf + "HexaVal hexa_array_sample(HexaVal arr, HexaVal nv) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_array_new();\n"
    buf = buf + "    int64_t n = HX_IS_INT(nv) ? HX_INT(nv) : (int64_t)__hx_to_double(nv);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    return rt_array_sample(arr, hexa_int(n));\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// substr: JS-style substring(start, length). length defaults to \"rest of\n"
    buf = buf + "// string\" when not supplied. Negative start clamps to 0, negative length\n"
    buf = buf + "// to 0, end clamps to strlen. Matches interpreter at\n"
    buf = buf + "// self/hexa_full.hexa:14959-14972.\n"
    buf = buf + "// Step-3 cycle 42 port — void-len normalization (which depends on the\n"
    buf = buf + "// HX_TAG runtime check, not expressible in hexa source today) stays in\n"
    buf = buf + "// C; the substring clamps + builtin call go to rt_str_substr in\n"
    buf = buf + "// stdlib/runtime/ctype.hexa.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_str_substr(HexaVal s, HexaVal start_v, HexaVal len_v) {\n"
    buf = buf + "    if (!HX_IS_STR(s)) return hexa_str(\"\");\n"
    buf = buf + "    int64_t slen = (int64_t)HX_STRLEN(s);\n"
    buf = buf + "    int64_t start = HX_IS_INT(start_v) ? HX_INT(start_v) : (int64_t)__hx_to_double(start_v);\n"
    buf = buf + "    if (start < 0) start = 0;\n"
    buf = buf + "    if (start > slen) start = slen;\n"
    buf = buf + "    int64_t count;\n"
    buf = buf + "    if (HX_TAG(len_v) == TAG_VOID) {\n"
    buf = buf + "        count = slen - start;\n"
    buf = buf + "    } else {\n"
    buf = buf + "        count = HX_IS_INT(len_v) ? HX_INT(len_v) : (int64_t)__hx_to_double(len_v);\n"
    buf = buf + "    }\n"
    buf = buf + "    if (count < 0) count = 0;\n"
    buf = buf + "    int64_t end_idx = start + count;\n"
    buf = buf + "    if (end_idx > slen) end_idx = slen;\n"
    buf = buf + "    return hexa_str_substring(s, hexa_int(start), hexa_int(end_idx));\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_str_substr(HexaVal s, HexaVal start, HexaVal count);\n"
    buf = buf + "HexaVal hexa_str_substr(HexaVal s, HexaVal start_v, HexaVal len_v) {\n"
    buf = buf + "    if (!HX_IS_STR(s)) return hexa_str(\"\");\n"
    buf = buf + "    int64_t slen = (int64_t)HX_STRLEN(s);\n"
    buf = buf + "    int64_t start = HX_IS_INT(start_v) ? HX_INT(start_v) : (int64_t)__hx_to_double(start_v);\n"
    buf = buf + "    int64_t count;\n"
    buf = buf + "    if (HX_TAG(len_v) == TAG_VOID) {\n"
    buf = buf + "        /* Default count = slen - start (clamped non-negative in hexa) */\n"
    buf = buf + "        count = slen - start;\n"
    buf = buf + "    } else {\n"
    buf = buf + "        count = HX_IS_INT(len_v) ? HX_INT(len_v) : (int64_t)__hx_to_double(len_v);\n"
    buf = buf + "    }\n"
    buf = buf + "    return rt_str_substr(s, hexa_int(start), hexa_int(count));\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// Step-3 cycle 28 port.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_str_bytes(HexaVal s) {\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    if (!HX_IS_STR(s)) return hexa_array_new();\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    for (const unsigned char* p = (const unsigned char*)HX_STR(s); *p; p++) {\n"
    buf = buf + "        out = hexa_array_push(out, hexa_int((int64_t)*p));\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_str_bytes(HexaVal s);\n"
