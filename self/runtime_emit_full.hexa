    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// tensor_slice(arr, lo, hi): subarray [lo, hi) with clamped bounds.\n"
    buf = buf + "HexaVal hexa_tensor_slice(HexaVal a, HexaVal lov, HexaVal hiv) {\n"
