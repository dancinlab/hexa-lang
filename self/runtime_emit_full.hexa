    buf = buf + "// Cycle 57 — Tier-A.4 POSIX stubs are NOT #define'd here because their\n"
    buf = buf + "// system-header prototypes (signal/sigaction/socket.h declarations)\n"
    buf = buf + "// expand the macro inside the prototype itself (\"function cannot return\n"
