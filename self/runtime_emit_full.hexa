    buf = buf + "#define realloc(p,n)       hxlcl_realloc((void *)(p), (size_t)(n))\n"
    buf = buf + "#define calloc(nm,sz)      hxlcl_calloc((size_t)(nm), (size_t)(sz))\n"
    buf = buf + "#define munmap(a,l)        hxlcl_munmap((void *)(a), (size_t)(l))\n"
    buf = buf + "#define fopen(p,m)         ((FILE *)hxlcl_fopen((const char *)(p), (const char *)(m)))\n"
    buf = buf + "#define fclose(fp)         hxlcl_fclose((void *)(fp))\n"
    buf = buf + "#define fread(b,s,n,fp)    hxlcl_fread((void *)(b), (size_t)(s), (size_t)(n), (void *)(fp))\n"
    buf = buf + "#define fwrite(b,s,n,fp)   hxlcl_fwrite((const void *)(b), (size_t)(s), (size_t)(n), (void *)(fp))\n"
    buf = buf + "#define ftell(fp)          hxlcl_ftell((void *)(fp))\n"
