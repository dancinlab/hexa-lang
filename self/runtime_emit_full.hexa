    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "// F3 ACTIVATION · Path A — bind class-C svc-wrapper self-emit slot.\n"
    buf = buf + "// 3-arg int+ptr+uint _cf: sockfd/x0 sxtw, addr/x1 ptr untouched, len/x2 uxtw\n"
    buf = buf + "// (mov w2,w2 — unsigned, zero-extend). SELF-EMIT → extern, resolved by\n"
    buf = buf + "// emit_hxlcl_bind_o.hexa's .o (byte-eq to clang -O2, SYS#104). errno adrp/str.\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern int hxlcl_bind(int s, const void *addr, unsigned int len);\n"
    buf = buf + "#else\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_bind(int s, const void *addr, unsigned int len) {\n"
