    buf = buf + "    farr32_matmul_NT_a_shim         = hexa_fn_new((void*)hexa_farr32_matmul_NT_a,              5);\n"
    buf = buf + "    // RFC 033 (2026-05-12): farr_copy + farr_add_gaussian_noise.\n"
    buf = buf + "    farr_copy                       = hexa_fn_new((void*)hexa_farr_copy,                       1);\n"
