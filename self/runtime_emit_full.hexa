    buf = buf + "    farr32_matmul_shim              = hexa_fn_new((void*)hexa_farr32_matmul,                   5);\n"
    buf = buf + "    // METAL_INTEGRATION.md step 4 of 5 (2026-05-21): FP32 matmul with B\n"
