    buf = buf + "#endif\n"
    buf = buf + "// F3 ACTIVATION · Path A — recvmsg/sendmsg class-C svc-wrapper self-emit slots.\n"
    buf = buf + "// 3-arg int+ptr+int _cf (s, msg, flags) = the EXACT rt_lseek shape: sxtw x0(s)\n"
    buf = buf + "// + msg/x1 ptr untouched + sxtw x2(flags), differing only in SYS#\n"
    buf = buf + "// (LSEEK=199 → RECVMSG=27 / SENDMSG=28). SELF-EMIT → extern, resolved by\n"
    buf = buf + "// emit_hxlcl_{recvmsg,sendmsg}_o.hexa (byte-eq to clang -O2). errno adrp/str.\n"
    buf = buf + "#ifdef HEXA_RT_SELFEMIT\n"
    buf = buf + "extern long hxlcl_recvmsg(int s, void *m, int f);\n"
