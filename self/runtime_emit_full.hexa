    buf = buf + "    // 4-arg hexa_callN ceiling — same pattern as farr_pauli_exp_inplace).\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    ham_free                        = hexa_fn_new((void*)hexa_ham_free,                        1);\n"
    buf = buf + "    ansatz_free                     = hexa_fn_new((void*)hexa_ansatz_free,                     1);\n"
    buf = buf + "    // RFC 037 (2026-05-13): batch kernel routes via codegen.hexa special\n"
