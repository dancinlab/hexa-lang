    buf = buf + "// runtime_cuda.c.\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "extern int _hx_cuda_farr_attn_dt_bwd_gpu(int64_t q_id, int64_t k_id,\n"
