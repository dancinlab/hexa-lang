    buf = buf + "#define fdopen(fd,m)       ((FILE *)hxlcl_fdopen((int)(fd), (const char *)(m)))\n"
    buf = buf + "// fileno MUST decode the fake FILE* (= (void*)(fd+1) from hxlcl_fdopen /\n"
