    buf = buf + "    if (dst_id < 0 || dst_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    int rc = _hx_cuda_farr_transpose_scatter_gpu(src_id, dst_id,\n"
    buf = buf + "                                                 rows, cols, dst_off);\n"
    buf = buf + "    return hexa_int(rc);\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)src_id; (void)dst_id; (void)rows; (void)cols; (void)dst_off;\n"
    buf = buf + "    return hexa_int(-1);\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// farr_ce_seed_gpu(logits, target_ids, R, V, out_loss, out_dlogits)\n"
    buf = buf + "// -> int rc (0 ok / -1). RFC gpu-resident-large-vocab-lmhead-loss:\n"
    buf = buf + "// GPU-resident large-vocab lm-head CE loss + seed grad in ONE kernel.\n"
    buf = buf + "// 6-arg → past the hexa_callN ceiling → bare direct-C entry (same seam\n"
    buf = buf + "// as farr_rope_gpu). The two outputs are CALLER-allocated (the caller\n"
    buf = buf + "// t_zeros's out_loss[R] and out_dlogits[R*V]) and filled in place; this\n"
    buf = buf + "// returns rc, NOT a new farr handle. On HEXA_CUDA: wired to\n"
    buf = buf + "// _hx_cuda_farr_ce_seed_gpu (logits stay device-resident — the whole\n"
    buf = buf + "// point; no 78M H2D round-trip). No-CUDA: _hx_farr_ce_seed_cpu (the\n"
    buf = buf + "// host FP64 reference / numeric oracle). bit-identity NOT claimed\n"
    buf = buf + "// (parallel reduce order) — forge `_gpu` rel-err convention.\n"
    buf = buf + "HexaVal hexa_farr_ce_seed_gpu(HexaVal logits_v, HexaVal target_ids_v,\n"
    buf = buf + "                              HexaVal R_v, HexaVal V_v,\n"
    buf = buf + "                              HexaVal out_loss_v, HexaVal out_dlogits_v) {\n"
    buf = buf + "    int64_t logits_id  = hexa_as_num(logits_v);\n"
    buf = buf + "    int64_t target_id  = hexa_as_num(target_ids_v);\n"
    buf = buf + "    int64_t R          = hexa_as_num(R_v);\n"
    buf = buf + "    int64_t V          = hexa_as_num(V_v);\n"
    buf = buf + "    int64_t out_loss   = hexa_as_num(out_loss_v);\n"
    buf = buf + "    int64_t out_dl     = hexa_as_num(out_dlogits_v);\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "    if (R <= 0 || V <= 0) return hexa_int(-1);\n"
    buf = buf + "    if (logits_id < 0 || logits_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (target_id < 0 || target_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (out_loss < 0  || out_loss  >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (out_dl < 0    || out_dl    >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    int rc = _hx_cuda_farr_ce_seed_gpu(logits_id, target_id, R, V,\n"
    buf = buf + "                                       out_loss, out_dl);\n"
    buf = buf + "    return hexa_int(rc);\n"
    buf = buf + "#else\n"
    buf = buf + "    return hexa_int(_hx_farr_ce_seed_cpu(logits_id, target_id, R, V,\n"
    buf = buf + "                                         out_loss, out_dl));\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "\n"
    buf = buf + "// 6-arg bare direct-C entry points (past the hexa_callN ceiling).\n"
    buf = buf + "HexaVal farr_rope_gpu(HexaVal t, HexaVal cos, HexaVal sin,\n"
    buf = buf + "                      HexaVal T, HexaVal nh, HexaVal hd) {\n"
    buf = buf + "    return hexa_farr_rope_gpu(t, cos, sin, T, nh, hd);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal farr_rope_bwd_gpu(HexaVal t, HexaVal cos, HexaVal sin,\n"
    buf = buf + "                          HexaVal T, HexaVal nh, HexaVal hd) {\n"
    buf = buf + "    return hexa_farr_rope_bwd_gpu(t, cos, sin, T, nh, hd);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal farr_ce_seed_gpu(HexaVal logits, HexaVal target_ids,\n"
    buf = buf + "                         HexaVal R, HexaVal V,\n"
    buf = buf + "                         HexaVal out_loss, HexaVal out_dlogits) {\n"
    buf = buf + "    return hexa_farr_ce_seed_gpu(logits, target_ids, R, V,\n"
    buf = buf + "                                 out_loss, out_dlogits);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// BC-ANIMA M3 (2026-05-28): farr_ce_seed(softmax, target_ids, dlogits,\n"
    buf = buf + "//   R, C) -> int rc (0 ok / -1). 5-arg seed-only CE gradient:\n"
    buf = buf + "//   dlogits[r,c] = softmax[r,c] - onehot(c == target[r]) in place.\n"
    buf = buf + "//   On HEXA_CUDA: routes to _hx_cuda_farr_ce_seed (slim block-per-row\n"
    buf = buf + "//   kernel). No-CUDA: _hx_farr_ce_seed_cpu_v2 host FP64 reference.\n"
    buf = buf + "//   The lighter sibling of farr_ce_seed_gpu (6-arg fused loss+seed) —\n"
    buf = buf + "//   used when softmax is precomputed via M2 farr_softmax_rows.\n"
    buf = buf + "HexaVal hexa_farr_ce_seed(HexaVal softmax_v, HexaVal target_ids_v,\n"
    buf = buf + "                          HexaVal dlogits_v,\n"
    buf = buf + "                          HexaVal R_v, HexaVal C_v) {\n"
    buf = buf + "    int64_t s_id   = hexa_as_num(softmax_v);\n"
    buf = buf + "    int64_t t_id   = hexa_as_num(target_ids_v);\n"
    buf = buf + "    int64_t dl_id  = hexa_as_num(dlogits_v);\n"
    buf = buf + "    int64_t R      = hexa_as_num(R_v);\n"
    buf = buf + "    int64_t C      = hexa_as_num(C_v);\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "    if (R <= 0 || C <= 0) return hexa_int(-1);\n"
    buf = buf + "    if (s_id  < 0 || s_id  >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (t_id  < 0 || t_id  >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (dl_id < 0 || dl_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    int rc = _hx_cuda_farr_ce_seed(s_id, t_id, dl_id, R, C);\n"
    buf = buf + "    return hexa_int(rc);\n"
    buf = buf + "#else\n"
    buf = buf + "    return hexa_int(_hx_farr_ce_seed_cpu_v2(s_id, t_id, dl_id, R, C));\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "// 5-arg bare direct-C entry — codegen lowers `farr_ce_seed(...)` to\n"
    buf = buf + "// `hexa_farr_ce_seed(...)` (past hexa_callN ceiling, same seam as\n"
    buf = buf + "// farr_matmul). This wrapper preserves the seam-alias symmetry.\n"
    buf = buf + "HexaVal farr_ce_seed(HexaVal softmax, HexaVal target_ids,\n"
    buf = buf + "                     HexaVal dlogits, HexaVal R, HexaVal C) {\n"
    buf = buf + "    return hexa_farr_ce_seed(softmax, target_ids, dlogits, R, C);\n"
    buf = buf + "}\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "\n"
    buf = buf + "// ── A1 (2026-05-10): per-phase arena reset side channel ─────────\n"
    buf = buf + "// Stage 0 host (hexa_real / hexa_interp.real) holds every str-arena\n"
    buf = buf + "// allocation for the whole process lifetime — there is no per-phase\n"
    buf = buf + "// boundary between lex / parse / check / lower / codegen. On the\n"
    buf = buf + "// 25,932-line spliced super-module that compiler/main.hexa now\n"
    buf = buf + "// produces, this drives RSS past the 2 GB cap before any structured\n"
    buf = buf + "// diagnostic surfaces (see doc/stage1_punch_list_v2.md A1, captured\n"
    buf = buf + "// 2026-05-10).\n"
    buf = buf + "//\n"
    buf = buf + "// The fix here is a side-channel that lets compiler/main.hexa drop\n"
    buf = buf + "// the str/Val bump arena at known-safe phase boundaries (after\n"
    buf = buf + "// parse, after type/citation check, after lower, after codegen).\n"
    buf = buf + "// The hexa-side carrier (Module / Diagnostic / HModule / MModule /\n"
    buf = buf + "// LModule) is itself heap-resident — it lives in array_store /\n"
    buf = buf + "// map_store / struct_store and is unaffected by the arena rewind.\n"
    buf = buf + "// What gets reclaimed: the bump-arena strings + struct-literal Vals\n"
    buf = buf + "// produced as scratch during the just-finished phase. Empirically\n"
    buf = buf + "// these dominate RSS growth on spliced compiles where every\n"
    buf = buf + "// _splice_imported_items pass concatenates fresh paths.\n"
    buf = buf + "//\n"
    buf = buf + "// Hooks (all spelled as `env(\"__HEXA_ARENA_<OP>__\")` for the\n"
    buf = buf + "// existing side-channel discipline):\n"
    buf = buf + "//\n"
    buf = buf + "//   PHASE_RESET__    — reset the bump arena to its first block\n"
    buf = buf + "//                      (calls hexa_arena_reset). Safe at phase\n"
    buf = buf + "//                      boundaries where no live Hexa-side struct\n"
    buf = buf + "//                      points into arena-allocated strings; the\n"
    buf = buf + "//                      compiler driver guarantees this by copying\n"
    buf = buf + "//                      slim hand-off shapes (see compiler/main.hexa\n"
    buf = buf + "//                      `phase_reset` callsites).\n"
    buf = buf + "//   RSS_MB__         — return current resident set size in MB\n"
    buf = buf + "//                      as a decimal string. Lets compiler/main.hexa\n"
    buf = buf + "//                      log per-phase RSS deltas to stderr without a\n"
    buf = buf + "//                      transpiler-level builtin.\n"
    buf = buf + "//   ARENA_BYTES__    — return total reserved arena bytes (sum of\n"
    buf = buf + "//                      block caps), decimal string. Diagnostics.\n"
    buf = buf + "//   ARENA_LIVE__     — return currently-used arena bytes (sum of\n"
    buf = buf + "//                      block.used), decimal string. Diagnostics.\n"
    buf = buf + "//   PHASE_LOG__name  — emit \"[hexa-runtime/phase] name rss=NMB\n"
    buf = buf + "//                      arena=NMB\" to stderr; convenience wrapper\n"
    buf = buf + "//                      for compiler/main.hexa --verbose mode.\n"
    buf = buf + "static int64_t _hx_arena_total_bytes(void) {\n"
    buf = buf + "    int64_t total = 0;\n"
    buf = buf + "    for (HexaArenaBlock* b = __hexa_arena.head; b; b = b->next) {\n"
    buf = buf + "        total += (int64_t)b->cap;\n"
    buf = buf + "    }\n"
    buf = buf + "    return total;\n"
    buf = buf + "}\n"
    buf = buf + "static int64_t _hx_arena_live_bytes(void) {\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    int64_t total = 0;\n"
    buf = buf + "    for (HexaArenaBlock* b = __hexa_arena.head; b; b = b->next) {\n"
    buf = buf + "        total += (int64_t)b->used;\n"
    buf = buf + "    }\n"
    buf = buf + "    return total;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_env_var(HexaVal name) {\n"
    buf = buf + "    if (!HX_IS_STR(name) || !HX_STR(name)) return hexa_str(\"\");\n"
    buf = buf + "    // rt 32-L: side-channel for Val arena scope ops. Hexa-side env_push_scope /\n"
    buf = buf + "    // env_pop_scope / call_user_fn invoke env(\"__HEXA_ARENA_*\") to drive the C\n"
    buf = buf + "    // arena without needing a transpiler-level builtin. Returns \"0\" / \"1\" so\n"
    buf = buf + "    // existing callers that ignore the result are unaffected.\n"
    buf = buf + "    if (HX_STR(name)[0] == '_' && HX_STR(name)[1] == '_' && HX_STR(name)[2] == 'H' &&\n"
    buf = buf + "        hxlcl_strncmp(HX_STR(name), \"__HEXA_ARENA_\", 13) == 0) {\n"
    buf = buf + "        const char* op = HX_STR(name) + 13;\n"
    buf = buf + "        if (hxlcl_strcmp(op, \"PUSH__\") == 0) {\n"
    buf = buf + "            hexa_val_arena_scope_push();\n"
    buf = buf + "            return hexa_str(\"1\");\n"
    buf = buf + "        }\n"
    buf = buf + "        if (hxlcl_strcmp(op, \"POP__\") == 0) {\n"
    buf = buf + "            hexa_val_arena_scope_pop();\n"
    buf = buf + "            return hexa_str(\"1\");\n"
    buf = buf + "        }\n"
    buf = buf + "        if (hxlcl_strcmp(op, \"HEAPIFY_RETURN__\") == 0) {\n"
    buf = buf + "            hexa_val_arena_heapify_return();\n"
    buf = buf + "            return hexa_str(\"1\");\n"
    buf = buf + "        }\n"
    buf = buf + "        if (hxlcl_strcmp(op, \"ENABLED__\") == 0) {\n"
    buf = buf + "            return hexa_str(hexa_val_arena_on() ? \"1\" : \"0\");\n"
    buf = buf + "        }\n"
    buf = buf + "        // F6 option A — A3 (PLAN-stage3-footprint-F6-optA.md). Toggle\n"
    buf = buf + "        // region-promote on fn-return for the active frame. ON routes\n"
    buf = buf + "        // __hexa_fn_arena_return through hexa_val_arena_heapify_to_parent\n"
    buf = buf + "        // (callee region → parent arena). OFF restores the default\n"
    buf = buf + "        // heapify-to-malloc behaviour. Default OFF on process start.\n"
    buf = buf + "        if (hxlcl_strcmp(op, \"RETURN_REGION_ON__\") == 0) {\n"
    buf = buf + "            __hexa_val_region_returns_enabled = 1;\n"
    buf = buf + "            return hexa_str(\"1\");\n"
    buf = buf + "        }\n"
    buf = buf + "        if (hxlcl_strcmp(op, \"RETURN_REGION_OFF__\") == 0) {\n"
    buf = buf + "            __hexa_val_region_returns_enabled = 0;\n"
    buf = buf + "            return hexa_str(\"0\");\n"
    buf = buf + "        }\n"
    buf = buf + "        if (hxlcl_strcmp(op, \"RETURN_REGION__\") == 0) {\n"
    buf = buf + "            // Query current state.\n"
    buf = buf + "            return hexa_str(__hexa_val_region_returns_enabled ? \"1\" : \"0\");\n"
    buf = buf + "        }\n"
    buf = buf + "        if (hxlcl_strcmp(op, \"STATS__\") == 0) {\n"
    buf = buf + "            char buf[64];\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "            hxlcl_memcpy(buf, \"marks=\", 6); _hx_i64_dec(buf + 6, (long long)__hexa_val_mark_top);\n"
    buf = buf + "            return hexa_str(buf);\n"
    buf = buf + "        }\n"
    buf = buf + "        // A1 (2026-05-10): per-phase arena reset hooks — see comment above.\n"
    buf = buf + "        if (hxlcl_strcmp(op, \"PHASE_RESET__\") == 0) {\n"
    buf = buf + "            // Drop all bump-arena allocations. Live blocks stay linked\n"
    buf = buf + "            // (ready for reuse on the next phase's allocations) but every\n"
    buf = buf + "            // block.used = 0. O(blocks) — typically a handful.\n"
    buf = buf + "            hexa_arena_reset();\n"
    buf = buf + "            return hexa_str(\"1\");\n"
    buf = buf + "        }\n"
    buf = buf + "        if (hxlcl_strcmp(op, \"RSS_MB__\") == 0) {\n"
    buf = buf + "            char buf[32];\n"
    buf = buf + "            size_t rss = _hx_self_rss_bytes();\n"
    buf = buf + "            _hx_u64_dec(buf, (unsigned long long)(rss / (1024ull * 1024ull)));\n"
    buf = buf + "            return hexa_str(buf);\n"
    buf = buf + "        }\n"
    buf = buf + "        if (hxlcl_strcmp(op, \"ARENA_BYTES__\") == 0) {\n"
    buf = buf + "            char buf[32];\n"
    buf = buf + "            _hx_i64_dec(buf, (long long)_hx_arena_total_bytes());\n"
    buf = buf + "            return hexa_str(buf);\n"
    buf = buf + "        }\n"
    buf = buf + "        if (hxlcl_strcmp(op, \"ARENA_LIVE__\") == 0) {\n"
    buf = buf + "            char buf[32];\n"
    buf = buf + "            _hx_i64_dec(buf, (long long)_hx_arena_live_bytes());\n"
    buf = buf + "            return hexa_str(buf);\n"
    buf = buf + "        }\n"
    buf = buf + "        // Unknown __HEXA_ARENA_* op — fall through to real getenv (returns \"\").\n"
    buf = buf + "    }\n"
    buf = buf + "    // A1 (2026-05-10): __HEXA_PHASE_LOG__<name> — single-line per-phase\n"
    buf = buf + "    // marker on stderr. Encoded as a name prefix so the call site is\n"
    buf = buf + "    // a single env(...) read. Returns the emitted line (sans newline).\n"
    buf = buf + "    if (HX_STR(name)[0] == '_' && HX_STR(name)[1] == '_' && HX_STR(name)[2] == 'H' &&\n"
    buf = buf + "        hxlcl_strncmp(HX_STR(name), \"__HEXA_PHASE_LOG__\", 18) == 0) {\n"
    buf = buf + "        const char* phase = HX_STR(name) + 18;\n"
    buf = buf + "        size_t rss = _hx_self_rss_bytes();\n"
    buf = buf + "        size_t arena_live = (size_t)_hx_arena_live_bytes();\n"
    buf = buf + "        size_t arena_total = (size_t)_hx_arena_total_bytes();\n"
    buf = buf + "        char line[256];\n"
    buf = buf + "        int n = snprintf(line, sizeof(line),\n"
    buf = buf + "            \"[hexa-runtime/phase] %s rss=%zuMB arena_live=%zuKB arena_total=%zuKB\",\n"
    buf = buf + "            phase,\n"
    buf = buf + "            (size_t)(rss / (1024ull * 1024ull)),\n"
    buf = buf + "            (size_t)(arena_live / 1024ull),\n"
    buf = buf + "            (size_t)(arena_total / 1024ull));\n"
    buf = buf + "        if (n > 0) {\n"
    buf = buf + "            fputs(line, stderr);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "            fputc('\\n', stderr);\n"
    buf = buf + "        }\n"
    buf = buf + "        return hexa_str(line);\n"
    buf = buf + "    }\n"
    buf = buf + "    const char* v = hxlcl_getenv(HX_STR(name));\n"
    buf = buf + "    return hexa_str(v ? v : \"\");\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// PROBE r8: `cwd()` — current working directory.  Wraps POSIX getcwd()\n"
    buf = buf + "// with a 4KB stack buffer (matches PATH_MAX on macOS/Linux).  Returns\n"
    buf = buf + "// \"\" on failure (e.g. cwd was unlinked) so call sites match the existing\n"
    buf = buf + "// env_var \"\" empty-string idiom.  Canonical name across Py/Rust/Go.\n"
    buf = buf + "HexaVal hexa_cwd(void) {\n"
    buf = buf + "    char buf[4096];\n"
    buf = buf + "    if (getcwd(buf, sizeof(buf)) == NULL) return hexa_str(\"\");\n"
    buf = buf + "    return hexa_str(buf);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "/* PROBE r8 POSIX-fs cluster (canonical-audit r8 inbox closure) — 4 fns\n"
    buf = buf + " * wrapping glob(3) / opendir+readdir / mkstemp / mkdtemp directly (no\n"
    buf = buf + " * shell exec).  Each returns \"\" / empty-array on failure to match the\n"
    buf = buf + " * existing \"\" empty-string idiom (env_var / cwd).  <dirent.h> is also\n"
    buf = buf + " * included later (line ~10051, for hexa_list_dir); duplicate include is\n"
    buf = buf + " * idempotent via standard header guards. */\n"
    buf = buf + "#include <glob.h>\n"
    buf = buf + "#include <dirent.h>\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_glob(HexaVal pattern) {\n"
    buf = buf + "    if (!HX_IS_STR(pattern) || !HX_STR(pattern)) return hexa_array_new();\n"
    buf = buf + "    glob_t g; HexaVal arr = hexa_array_new();\n"
    buf = buf + "    if (glob(HX_STR(pattern), 0, NULL, &g) == 0) {\n"
    buf = buf + "        for (size_t i = 0; i < g.gl_pathc; i++) arr = hexa_array_push(arr, hexa_str(g.gl_pathv[i]));\n"
    buf = buf + "    }\n"
    buf = buf + "    globfree(&g);\n"
    buf = buf + "    return arr;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_listdir(HexaVal path) {\n"
    buf = buf + "    if (!HX_IS_STR(path) || !HX_STR(path) || !HX_STR(path)[0]) return hexa_array_new();\n"
    buf = buf + "    DIR* d = opendir(HX_STR(path));\n"
    buf = buf + "    if (!d) return hexa_array_new();\n"
    buf = buf + "    HexaVal arr = hexa_array_new();\n"
    buf = buf + "    struct dirent* ent;\n"
    buf = buf + "    while ((ent = readdir(d)) != NULL) {\n"
    buf = buf + "        const char* n = ent->d_name;\n"
    buf = buf + "        if (n[0] == '.' && (n[1] == '\\0' || (n[1] == '.' && n[2] == '\\0'))) continue;\n"
    buf = buf + "        arr = hexa_array_push(arr, hexa_str(n));\n"
    buf = buf + "    }\n"
    buf = buf + "    closedir(d);\n"
    buf = buf + "    return arr;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_tempfile(void) {\n"
    buf = buf + "    char tmpl[] = \"/tmp/hexa_XXXXXX\";\n"
    buf = buf + "    int fd = mkstemp(tmpl);\n"
    buf = buf + "    if (fd < 0) return hexa_str(\"\");\n"
    buf = buf + "    hxlcl_close(fd);\n"
    buf = buf + "    return hexa_str(tmpl);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_tempdir(void) {\n"
    buf = buf + "    char tmpl[] = \"/tmp/hexa_dir_XXXXXX\";\n"
    buf = buf + "    if (mkdtemp(tmpl) == NULL) return hexa_str(\"\");\n"
    buf = buf + "    return hexa_str(tmpl);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// setenv(name, value): POSIX setenv wrapper with overwrite=1. Empty / non-STR\n"
    buf = buf + "// name is a no-op. Returns the stored value on success, \"\" on failure — so\n"
    buf = buf + "// callers can treat it like env() in a set-then-read idiom without a second\n"
    buf = buf + "// getenv round-trip. anima/serve_alm-style bash bridges previously used\n"
    buf = buf + "// `env BAR=baz hexa run …` because the language had no setter; this closes\n"
    buf = buf + "// the gap so .hexa contracts can configure child env directly before exec.\n"
    buf = buf + "HexaVal hexa_setenv(HexaVal name, HexaVal value) {\n"
    buf = buf + "    if (!HX_IS_STR(name) || !HX_STR(name) || HX_STR(name)[0] == '\\0') return hexa_str(\"\");\n"
    buf = buf + "    const char* v = (HX_IS_STR(value) && HX_STR(value)) ? HX_STR(value) : \"\";\n"
    buf = buf + "    if (hxlcl_setenv(HX_STR(name), v, 1) != 0) return hexa_str(\"\");\n"
    buf = buf + "    return hexa_str(v);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// exec_capture(cmd): spawn `/bin/sh -c cmd` and return\n"
    buf = buf + "// [stdout_str, stderr_str, exit_code] with stderr split from stdout. Uses\n"
    buf = buf + "// pipe/fork/execvp (not popen, which merges 2>&1 when you redirect it).\n"
    buf = buf + "// Closes the anima bash-bridge pattern of `tool/serve_alm_persona.bash`\n"
    buf = buf + "// (333 lines) that existed solely to separate stderr capture.\n"
    buf = buf + "HexaVal hexa_exec_capture(HexaVal cmd) {\n"
    buf = buf + "    HexaVal arr = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_STR(cmd) || !HX_STR(cmd)) {\n"
    buf = buf + "        arr = hexa_array_push(arr, hexa_str(\"\"));\n"
    buf = buf + "        arr = hexa_array_push(arr, hexa_str(\"\"));\n"
    buf = buf + "        arr = hexa_array_push(arr, hexa_int(127));\n"
    buf = buf + "        return arr;\n"
    buf = buf + "    }\n"
    buf = buf + "    int out_pipe[2], err_pipe[2];\n"
    buf = buf + "    if (hxlcl_pipe(out_pipe) != 0) {\n"
    buf = buf + "        arr = hexa_array_push(arr, hexa_str(\"\"));\n"
    buf = buf + "        arr = hexa_array_push(arr, hexa_str(\"pipe: stdout\"));\n"
    buf = buf + "        arr = hexa_array_push(arr, hexa_int(127));\n"
    buf = buf + "        return arr;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (hxlcl_pipe(err_pipe) != 0) {\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        hxlcl_close(out_pipe[0]); hxlcl_close(out_pipe[1]);\n"
    buf = buf + "        arr = hexa_array_push(arr, hexa_str(\"\"));\n"
    buf = buf + "        arr = hexa_array_push(arr, hexa_str(\"pipe: stderr\"));\n"
    buf = buf + "        arr = hexa_array_push(arr, hexa_int(127));\n"
    buf = buf + "        return arr;\n"
    buf = buf + "    }\n"
    buf = buf + "    // 2026-05-06 — POSIX fork buffer flush (parent stdio inherited by child)\n"
    buf = buf + "    fflush(NULL);\n"
    buf = buf + "    pid_t pid = hxlcl_fork();\n"
    buf = buf + "    if (pid < 0) {\n"
    buf = buf + "        hxlcl_close(out_pipe[0]); hxlcl_close(out_pipe[1]);\n"
    buf = buf + "        hxlcl_close(err_pipe[0]); hxlcl_close(err_pipe[1]);\n"
    buf = buf + "        arr = hexa_array_push(arr, hexa_str(\"\"));\n"
    buf = buf + "        arr = hexa_array_push(arr, hexa_str(\"fork failed\"));\n"
    buf = buf + "        arr = hexa_array_push(arr, hexa_int(127));\n"
    buf = buf + "        return arr;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (pid == 0) {\n"
    buf = buf + "        // child: rewire stdout/stderr then exec shell\n"
    buf = buf + "        hxlcl_dup2(out_pipe[1], 1);\n"
    buf = buf + "        hxlcl_dup2(err_pipe[1], 2);\n"
    buf = buf + "        hxlcl_close(out_pipe[0]); hxlcl_close(out_pipe[1]);\n"
    buf = buf + "        hxlcl_close(err_pipe[0]); hxlcl_close(err_pipe[1]);\n"
    buf = buf + "        hxlcl_execl(\"/bin/sh\", \"sh\", \"-c\", HX_STR(cmd), (char*)NULL);\n"
    buf = buf + "        _exit(127);\n"
    buf = buf + "    }\n"
    buf = buf + "    // parent: close write ends, drain both pipes via select().\n"
    buf = buf + "    //\n"
    buf = buf + "    // The previous loop read stdout then stderr with BLOCKING reads in\n"
    buf = buf + "    // strict alternation. That deadlocks on any child that writes a lot to\n"
    buf = buf + "    // one stream and little to the other: while the parent blocks reading\n"
    buf = buf + "    // the empty stream, the busy stream's 64 KB kernel pipe buffer fills,\n"
    buf = buf + "    // the child blocks on write(), and so never produces the byte the\n"
    buf = buf + "    // parent is waiting for — a permanent hang. Observed downstream as\n"
    buf = buf + "    // `hexa cloud run` hanging on >1-min remote jobs after they exit clean\n"
    buf = buf + "    // (inbox patch cloud-cli-run-hang). select() reads whichever fd is\n"
    buf = buf + "    // ready, so neither buffer can wedge the other.\n"
    buf = buf + "    hxlcl_close(out_pipe[1]);\n"
    buf = buf + "    hxlcl_close(err_pipe[1]);\n"
    buf = buf + "    char buf[4096];\n"
    buf = buf + "    size_t ocap = 4096, olen = 0;\n"
    buf = buf + "    char* obuf = (char*)malloc(ocap);\n"
    buf = buf + "    if (obuf) obuf[0] = '\\0';\n"
    buf = buf + "    size_t ecap = 4096, elen = 0;\n"
    buf = buf + "    char* ebuf = (char*)malloc(ecap);\n"
    buf = buf + "    if (ebuf) ebuf[0] = '\\0';\n"
    buf = buf + "    int of = out_pipe[0], ef = err_pipe[0];\n"
    buf = buf + "    int open_mask = 3; // bit 0 = stdout, bit 1 = stderr\n"
    buf = buf + "    while (open_mask) {\n"
    buf = buf + "        fd_set rfds;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        FD_ZERO(&rfds);\n"
    buf = buf + "        int maxfd = -1;\n"
    buf = buf + "        if (open_mask & 1) { FD_SET(of, &rfds); if (of > maxfd) maxfd = of; }\n"
    buf = buf + "        if (open_mask & 2) { FD_SET(ef, &rfds); if (ef > maxfd) maxfd = ef; }\n"
    buf = buf + "        if (maxfd < 0) break;\n"
    buf = buf + "        int sr = hxlcl_select(maxfd + 1, &rfds, (void*)0, (void*)0, (void*)0);\n"
    buf = buf + "        // sr < 0: select error (EINTR or otherwise) — stop draining; the\n"
    buf = buf + "        // child is still reaped by waitpid below. Never busy-loop.\n"
    buf = buf + "        if (sr < 0) break;\n"
    buf = buf + "        if ((open_mask & 1) && FD_ISSET(of, &rfds)) {\n"
    buf = buf + "            ssize_t n = hxlcl_read(of, buf, sizeof(buf));\n"
    buf = buf + "            if (n > 0 && obuf) {\n"
    buf = buf + "                while (olen + (size_t)n + 1 > ocap) {\n"
    buf = buf + "                    ocap *= 2;\n"
    buf = buf + "                    char* nb = (char*)realloc(obuf, ocap);\n"
    buf = buf + "                    if (!nb) { free(obuf); obuf = NULL; break; }\n"
    buf = buf + "                    obuf = nb;\n"
    buf = buf + "                }\n"
    buf = buf + "                if (obuf) { hxlcl_memcpy(obuf + olen, buf, (size_t)n); olen += (size_t)n; obuf[olen] = '\\0'; }\n"
    buf = buf + "            } else if (n <= 0) {\n"
    buf = buf + "                open_mask &= ~1;\n"
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "        if ((open_mask & 2) && FD_ISSET(ef, &rfds)) {\n"
    buf = buf + "            ssize_t n = hxlcl_read(ef, buf, sizeof(buf));\n"
    buf = buf + "            if (n > 0 && ebuf) {\n"
    buf = buf + "                while (elen + (size_t)n + 1 > ecap) {\n"
    buf = buf + "                    ecap *= 2;\n"
    buf = buf + "                    char* nb = (char*)realloc(ebuf, ecap);\n"
    buf = buf + "                    if (!nb) { free(ebuf); ebuf = NULL; break; }\n"
    buf = buf + "                    ebuf = nb;\n"
    buf = buf + "                }\n"
    buf = buf + "                if (ebuf) { hxlcl_memcpy(ebuf + elen, buf, (size_t)n); elen += (size_t)n; ebuf[elen] = '\\0'; }\n"
    buf = buf + "            } else if (n <= 0) {\n"
    buf = buf + "                open_mask &= ~2;\n"
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    hxlcl_close(of); hxlcl_close(ef);\n"
    buf = buf + "    int status = 0;\n"
    buf = buf + "    hxlcl_waitpid(pid, &status, 0);\n"
    buf = buf + "    int exit_code;\n"
    buf = buf + "    if (WIFEXITED(status))         exit_code = WEXITSTATUS(status);\n"
    buf = buf + "    else if (WIFSIGNALED(status))  exit_code = 128 + WTERMSIG(status);\n"
    buf = buf + "    else                           exit_code = -1;\n"
    buf = buf + "    arr = hexa_array_push(arr, obuf ? hexa_str_own(obuf) : hexa_str(\"\"));\n"
    buf = buf + "    arr = hexa_array_push(arr, ebuf ? hexa_str_own(ebuf) : hexa_str(\"\"));\n"
    buf = buf + "    arr = hexa_array_push(arr, hexa_int(exit_code));\n"
    buf = buf + "    return arr;\n"
    buf = buf + "}\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "\n"
    buf = buf + "// exec_with_status3(cmd): canonical 3-tuple [stdout, stderr, exit_code]\n"
    buf = buf + "// shape (PROBE r8, inbox/patches/exec-with-status-3tuple-migration.md, PR B\n"
    buf = buf + "// \"Option B1\"). New, non-breaking surface alongside the legacy 2-tuple\n"
    buf = buf + "// `hexa_exec_with_status` so the ~150-file / ~530-binding caller migration\n"
    buf = buf + "// stays a separate stacked PR. Body delegates to hexa_exec_capture, which\n"
    buf = buf + "// already drains stdout+stderr via separate pipes through a select()-\n"
    buf = buf + "// multiplexed reader (no channel merge, no deadlock — PR #423). New callers\n"
    buf = buf + "// that want exit-code AND separate stderr use this name; the 2-tuple\n"
    buf = buf + "// `exec_with_status` keeps r[1]==exit_code for every existing caller.\n"
    buf = buf + "HexaVal hexa_exec_with_status3(HexaVal cmd) { return hexa_exec_capture(cmd); }\n"
    buf = buf + "\n"
    buf = buf + "HexaVal rt_delete_file(HexaVal path) {\n"
    buf = buf + "    if (!HX_IS_STR(path) || !HX_STR(path)) return hexa_void();\n"
    buf = buf + "    (void)unlink(HX_STR(path));\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// R7 track B (2026-05-18): compiled-path `list_dir(path)`. Byte-parity\n"
    buf = buf + "// with the interp impl (self/hexa_full.hexa:14347) — `ls -1 '<path>'\n"
    buf = buf + "// 2>/dev/null`, split on '\\n', array of entries; empty/err → []. Single-\n"
    buf = buf + "// quote-escape the path (same shellout-shape limitation: entries with\n"
    buf = buf + "// '\\n' lost — inherent, matches interp). Needed by\n"
    buf = buf + "// compiler/atlas/merger.hexa::list_dir for the atlas_cli binary.\n"
    buf = buf + "/* opendir/readdir for hexa_list_dir (2026-05-22 fix). Included here\n"
    buf = buf + " * (immediately before the use site) instead of at top-of-file so it\n"
    buf = buf + " * applies to every platform branch — the platform-specific #if/#elif\n"
    buf = buf + " * blocks above include their own subsets and one of them (the Linux\n"
    buf = buf + " * x86_64 fallback) used to mask this header inside an inactive branch\n"
    buf = buf + " * on the Darwin build. */\n"
    buf = buf + "#include <dirent.h>\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_list_dir(HexaVal path) {\n"
    buf = buf + "    if (!HX_IS_STR(path) || !HX_STR(path) || !HX_STR(path)[0]) return hexa_array_new();\n"
    buf = buf + "    const char* p = HX_STR(path);\n"
    buf = buf + "    /* 2026-05-22 fix: switched from popen(\"ls -1 …\") + getline() to\n"
    buf = buf + "     * opendir/readdir. The old shell-out path called libc getline() on a\n"
    buf = buf + "     * hxlcl_popen FAKE FILE* (encoded as (void*)(fd+1)) — getline's\n"
    buf = buf + "     * internal flockfile() dereferences the pointer as a real FILE* and\n"
    buf = buf + "     * segfaults (EXC_BAD_ACCESS at +0x6c). Discovered while wiring the\n"
    buf = buf + "     * no-hxc atlas SSOT: static_atlas → load_atlas → _discover →\n"
    buf = buf + "     * list_dir → CRASH. opendir/readdir is the canonical POSIX path,\n"
    buf = buf + "     * shell-free, and matches ls -1 default semantics (skip hidden). */\n"
    buf = buf + "    DIR* d = opendir(p);\n"
    buf = buf + "    if (!d) return hexa_array_new();\n"
    buf = buf + "    HexaVal arr = hexa_array_new();\n"
    buf = buf + "    struct dirent* ent;\n"
    buf = buf + "    while ((ent = readdir(d)) != NULL) {\n"
    buf = buf + "        if (ent->d_name[0] == '.') continue;     /* skip ., .., and hidden */\n"
    buf = buf + "        arr = hexa_array_push(arr, hexa_str(ent->d_name));\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    }\n"
    buf = buf + "    closedir(d);\n"
    buf = buf + "    return arr;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal rt_append_file(HexaVal path, HexaVal content) {\n"
    buf = buf + "    if (!HX_IS_STR(path) || !HX_STR(path)) return hexa_void();\n"
    buf = buf + "    const char* data = (HX_IS_STR(content) && HX_STR(content)) ? HX_STR(content) : \"\";\n"
    buf = buf + "    FILE* f = fopen(HX_STR(path), \"ab\");\n"
    buf = buf + "    if (!f) return hexa_void();\n"
    buf = buf + "    fwrite(data, 1, hxlcl_strlen(data), f);\n"
    buf = buf + "    fclose(f);\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_bin(HexaVal n) {\n"
    buf = buf + "    uint64_t v = HX_IS_INT(n) ? (uint64_t)HX_INT(n) : (uint64_t)HX_FLOAT(n);\n"
    buf = buf + "    char buf[65]; int pos = 0;\n"
    buf = buf + "    if (v == 0) { buf[pos++] = '0'; }\n"
    buf = buf + "    while (v > 0 && pos < 64) { buf[pos++] = (char)('0' + (v & 1)); v >>= 1; }\n"
    buf = buf + "    char* out = (char*)malloc(pos + 1);\n"
    buf = buf + "    for (int i = 0; i < pos; i++) out[i] = buf[pos - 1 - i];\n"
    buf = buf + "    out[pos] = 0;\n"
    buf = buf + "    return hexa_str_own(out);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_hex(HexaVal n) {\n"
    buf = buf + "    uint64_t v = HX_IS_INT(n) ? (uint64_t)HX_INT(n) : (uint64_t)HX_FLOAT(n);\n"
    buf = buf + "    char* out = (char*)malloc(20);\n"
    buf = buf + "    snprintf(out, 20, \"%llx\", (unsigned long long)v);\n"
    buf = buf + "    return hexa_str_own(out);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Reproducible-emit pin. When SOURCE_DATE_EPOCH is set (GNU/Debian\n"
    buf = buf + "// convention, unix-seconds int) or HEXA_REPRODUCIBLE=1, wall-clock\n"
    buf = buf + "// primitives return a fixed value so emitted artifacts (codegen output,\n"
    buf = buf + "// manifests with embedded `now()`, chain-hash folds) are byte-identical\n"
    buf = buf + "// across runs. Returns -1 when no pin is active.\n"
    buf = buf + "// HEXA_REPRODUCIBLE=1 alone pins to 0 (epoch); SOURCE_DATE_EPOCH wins.\n"
    buf = buf + "static int64_t hexa_pinned_epoch(void) {\n"
    buf = buf + "    const char* sde = hxlcl_getenv(\"SOURCE_DATE_EPOCH\");\n"
    buf = buf + "    if (sde && *sde) {\n"
    buf = buf + "        // strtoll tolerates leading whitespace and stops at first non-digit\n"
    buf = buf + "        char* endp = NULL;\n"
    buf = buf + "        long long v = hxlcl_strtoll(sde, &endp, 10);\n"
    buf = buf + "        if (endp != sde && v >= 0) return (int64_t)v;\n"
    buf = buf + "    }\n"
    buf = buf + "    const char* repro = hxlcl_getenv(\"HEXA_REPRODUCIBLE\");\n"
    buf = buf + "    if (repro && repro[0] == '1' && repro[1] == '\\0') return 0;\n"
    buf = buf + "    return -1;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_timestamp(void) {\n"
    buf = buf + "    int64_t pin = hexa_pinned_epoch();\n"
    buf = buf + "    if (pin >= 0) return hexa_int(pin);\n"
    buf = buf + "    struct timespec ts;\n"
    buf = buf + "    hxlcl_clock_gettime(CLOCK_REALTIME, &ts);\n"
    buf = buf + "    return hexa_int((int64_t)ts.tv_sec);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// FIX-A (Anima serving unblock, 2026-04-18) ─────────────────────────\n"
    buf = buf + "// time_ms(): monotonic wall-clock milliseconds. Used by checkpoint.hexa /\n"
    buf = buf + "// train_logger.hexa / eval_harness.hexa / train_7b_integrated.hexa for\n"
    buf = buf + "// elapsed-time measurement (tok/s, save/load latency, per-step timing).\n"
    buf = buf + "HexaVal hexa_time_ms(void) {\n"
    buf = buf + "    int64_t pin = hexa_pinned_epoch();\n"
    buf = buf + "    if (pin >= 0) return hexa_int(pin * 1000);\n"
    buf = buf + "    struct timespec ts;\n"
    buf = buf + "    hxlcl_clock_gettime(CLOCK_MONOTONIC, &ts);\n"
    buf = buf + "    int64_t ms = (int64_t)ts.tv_sec * 1000\n"
    buf = buf + "               + (int64_t)(ts.tv_nsec / 1000000);\n"
    buf = buf + "    return hexa_int(ms);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Wilson 2026-05-13 — C-level aliases for std_time.hexa wrapper names\n"
    buf = buf + "// (`time_now_ms`, `__builtin_time_now_ms`, etc.). The hexa-side wrappers\n"
    buf = buf + "// in self/std_time.hexa get `extern` forward declarations in the generated\n"
    buf = buf + "// C; without these symbols defined, link fails. Cheaper than the codegen\n"
    buf = buf + "// intercept (which also exists in codegen.hexa) — no hexat rebuild\n"
    buf = buf + "// needed; just runtime.c recompile (every wilson build picks it up).\n"
    buf = buf + "// Filed at incoming/patches/wilson-needs-time-now-ms-builtin.md.\n"
    buf = buf + "// Wilson 2026-05-13 — TAG_FN globals for std_time.hexa wrapper names.\n"
    buf = buf + "// Codegen emits user-side `time_now_ms()` as `hexa_call0(time_now_ms)` —\n"
    buf = buf + "// it treats unrecognized fn names as HexaVal fn-ref values, NOT direct\n"
    buf = buf + "// C function calls. So we declare these as HexaVal globals (TAG_FN shims)\n"
    buf = buf + "// matching the pattern thread.c uses for thread_spawn/channel_*.\n"
    buf = buf + "// Initialized at startup via _hexa_init_time_fn_shims (called from\n"
    buf = buf + "// hexa_set_args alongside _hexa_init_thread_fn_shims).\n"
    buf = buf + "HexaVal time_now_ms;\n"
    buf = buf + "HexaVal timestamp_ms;\n"
    buf = buf + "HexaVal __builtin_time_now_ms;\n"
    buf = buf + "HexaVal time_now;\n"
    buf = buf + "HexaVal __builtin_time_now;\n"
    buf = buf + "static HexaVal _hexa_time_ms_thunk(void) { return hexa_time_ms(); }\n"
    buf = buf + "static HexaVal _hexa_timestamp_thunk(void) { return hexa_timestamp(); }\n"
    buf = buf + "static void _hexa_init_time_fn_shims(void) {\n"
    buf = buf + "    time_now_ms          = hexa_fn_new((void*)_hexa_time_ms_thunk,    0);\n"
    buf = buf + "    timestamp_ms         = hexa_fn_new((void*)_hexa_time_ms_thunk,    0);\n"
    buf = buf + "    __builtin_time_now_ms = hexa_fn_new((void*)_hexa_time_ms_thunk,   0);\n"
    buf = buf + "    time_now             = hexa_fn_new((void*)_hexa_timestamp_thunk,  0);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    __builtin_time_now   = hexa_fn_new((void*)_hexa_timestamp_thunk,  0);\n"
    buf = buf + "}\n"
    buf = buf + "// `now_ms` and `sleep_ms` are owned by self/native/thread.c (HexaVal globals\n"
    buf = buf + "// initialized via _hexa_init_thread_fn_shims). We avoid those names here.\n"
    buf = buf + "\n"
    buf = buf + "// byte_len(v): length in bytes of a string, array, or map. Unlike hexa_len\n"
    buf = buf + "// (which rejects non-container tags), this is permissive — returns 0 on\n"
    buf = buf + "// anything without a measurable length. checkpoint.hexa uses it on byte\n"
    buf = buf + "// arrays returned by read_file_bytes.\n"
    buf = buf + "HexaVal hexa_byte_len(HexaVal v) {\n"
    buf = buf + "    if (HX_IS_STR(v))   return hexa_int(HX_STR(v) ? (int64_t)HX_STRLEN(v) : 0);\n"
    buf = buf + "    if (HX_IS_ARRAY(v)) return hexa_int((int64_t)HX_ARR_LEN(v));\n"
    buf = buf + "    if (HX_IS_MAP(v)) {\n"
    buf = buf + "        HexaMapTable* t = HX_MAP_TBL(v);\n"
    buf = buf + "        return hexa_int(t ? (int64_t)t->len : 0);\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int(0);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// dict_keys(m): return TAG_ARRAY of TAG_STR keys preserving insertion order.\n"
    buf = buf + "// Thin alias over hexa_map_keys (which is already the canonical C symbol for\n"
    buf = buf + "// HX_MAP key iteration). Kept as a distinct builtin so .hexa sources can\n"
    buf = buf + "// use the more familiar `dict_keys(d)` spelling (tokenizer_bpe.hexa etc.).\n"
    buf = buf + "HexaVal hexa_dict_keys(HexaVal m) { return hexa_map_keys(m); }\n"
    buf = buf + "\n"
    buf = buf + "// Step 5 #4 (2026-05-22): __fd_write_bytes(fd, s) — POSIX write(2) thin shim.\n"
    buf = buf + "// Companion to the codegen.hexa inline-emit handler. The SSOT codegen\n"
    buf = buf + "// branch returns `hexa_int((int64_t)write(...))` inline; the shipped\n"
    buf = buf + "// hexat binary still emits this builtin as a hexa_call2() reference\n"
    buf = buf + "// (binary regen pending — Phase C.2 merge gap, see self/main.hexa\n"
    buf = buf + "// cmd_regen_cc() trailing comment). The _Generic dispatcher in\n"
    buf = buf + "// runtime_core.c routes `hexa_call2(__fd_write_bytes, ...)` to\n"
    buf = buf + "// __hexa_call2_fp2 when __fd_write_bytes is a function-pointer C symbol\n"
    buf = buf + "// — exactly what this definition provides. Both activation paths\n"
    buf = buf + "// converge on the same observable behaviour.\n"
    buf = buf + "//\n"
    buf = buf + "// Used by stdlib/runtime/io.hexa rt_print / rt_println / rt_eprint /\n"
    buf = buf + "// rt_eprintln (RUNTIME.md step 3 cycle-76, IO real-port unblocker).\n"
    buf = buf + "// Cycle-102 (2026-05-22): restored after wipe e8c2dc1c silent-removed\n"
    buf = buf + "// the cycle-101 (c25ef75e) port. See inbox/notes/2026-05-22-wipe-* for\n"
    buf = buf + "// the wipe-governance proposal.\n"
    buf = buf + "HexaVal __fd_write_bytes(HexaVal fd, HexaVal s) {\n"
    buf = buf + "    // cycle 70 — route through hxlcl_write (carry-flag svc trap on\n"
    buf = buf + "    // darwin-arm64, libc on linux) rather than a bare libc write(), so the\n"
    buf = buf + "    // `_write` extern drops too (completes the read/write/close proof).\n"
    buf = buf + "    return hexa_int((int64_t)hxlcl_write((int)HX_INT(fd), HX_STR(s), (size_t)HX_STRLEN(s)));\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// FIX-A (Anima stdlib unblock, 2026-04-19) ─────────────────────────\n"
    buf = buf + "// 10 builtins required across ~230 Anima/serve/train .hexa files\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// (read_stdin ×53, json_parse ×119, json_stringify ×37, json_encode ×5,\n"
    buf = buf + "// json_decode ×4, http_get ×6, sleep_s ×2, to_bool/now_monotonic_s/\n"
    buf = buf + "// utc_iso_now/utc_compact_now ×1-2). Keep surface minimal — no libcurl,\n"
    buf = buf + "// no locale tables, no float parse-path perfection: goal is unblock\n"
    buf = buf + "// compilation + serve_alm dogfooding.\n"
    buf = buf + "\n"
    buf = buf + "// read_stdin(): slurp all of stdin into a TAG_STR. Returns \"\" on EOF-only.\n"
    buf = buf + "// Used by cli tools + test harnesses that pipe input.\n"
    buf = buf + "HexaVal hexa_read_stdin(void) {\n"
    buf = buf + "    // stdin is a fake FILE* ((FILE*)(uintptr_t)1) in this runtime, so libc\n"
    buf = buf + "    // stdio (fgetc/getline) crashes inside flockfile when it dereferences the\n"
    buf = buf + "    // constant. Slurp fd 0 directly with the raw read(2) wrapper instead — the\n"
    buf = buf + "    // same primitive hexa_input() uses — in 4 KiB chunks, with EINTR retry.\n"
    buf = buf + "    size_t cap = 4096, len = 0;\n"
    buf = buf + "    char* buf = (char*)malloc(cap);\n"
    buf = buf + "    if (!buf) return hexa_str(\"\");\n"
    buf = buf + "    for (;;) {\n"
    buf = buf + "        if (cap - len < 4097) {            // room for a 4096 read + trailing NUL\n"
    buf = buf + "            cap *= 2;\n"
    buf = buf + "            char* nb = (char*)realloc(buf, cap);\n"
    buf = buf + "            if (!nb) { free(buf); return hexa_str(\"\"); }\n"
    buf = buf + "            buf = nb;\n"
    buf = buf + "        }\n"
    buf = buf + "        long n = hxlcl_read(0, buf + len, 4096);\n"
    buf = buf + "        if (n < 0) { if (errno == EINTR) continue; break; }\n"
    buf = buf + "        if (n == 0) break;                 // EOF\n"
    buf = buf + "        len += (size_t)n;\n"
    buf = buf + "    }\n"
    buf = buf + "    buf[len] = 0;\n"
    buf = buf + "    return hexa_str_own(buf);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// read_stdin_n_c(n): read EXACTLY n bytes from fd 0 (block until n bytes are\n"
    buf = buf + "// read or EOF). Returns the C buffer pointer (NUL-terminated, may hold < n\n"
    buf = buf + "// bytes at EOF); the caller turns it into a hexa string via from_cstring().\n"
    buf = buf + "// Plain C ABI for the `extern fn read_stdin_n_c(n: int) -> int` FFI surface —\n"
    buf = buf + "// the LSP framing layer reads a Content-Length-delimited JSON body with it.\n"
    buf = buf + "// Uses the raw read(2) wrapper (stdin is a fake FILE* in this runtime), the\n"
    buf = buf + "// same primitive as hexa_input / hexa_read_stdin, so it composes byte-exactly\n"
    buf = buf + "// with hexa_input()'s one-byte-at-a-time header reads: no buffered over-read,\n"
    buf = buf + "// the body begins exactly after the header block's terminating newline.\n"
    buf = buf + "// The pointer is a reused, grown-on-demand static buffer — from_cstring copies\n"
    buf = buf + "// it immediately, so the next call may overwrite it (no leak, no aliasing). An\n"
    buf = buf + "// embedded NUL truncates; LSP JSON bodies are NUL-free UTF-8, so that is safe.\n"
    buf = buf + "const char* read_stdin_n_c(int n) {\n"
    buf = buf + "    static char* rsn_buf = NULL;\n"
    buf = buf + "    static size_t rsn_cap = 0;\n"
    buf = buf + "    if (n < 0) n = 0;\n"
    buf = buf + "    if ((size_t)n + 1 > rsn_cap) {\n"
    buf = buf + "        size_t nc = (size_t)n + 1;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        char* nb = (char*)realloc(rsn_buf, nc);\n"
    buf = buf + "        if (!nb) return \"\";\n"
    buf = buf + "        rsn_buf = nb;\n"
    buf = buf + "        rsn_cap = nc;\n"
    buf = buf + "    }\n"
    buf = buf + "    size_t got = 0;\n"
    buf = buf + "    while (got < (size_t)n) {\n"
    buf = buf + "        long r = hxlcl_read(0, rsn_buf + got, (size_t)n - got);\n"
    buf = buf + "        if (r < 0) { if (errno == EINTR) continue; break; }\n"
    buf = buf + "        if (r == 0) break;                 // EOF before n bytes\n"
    buf = buf + "        got += (size_t)r;\n"
    buf = buf + "    }\n"
    buf = buf + "    rsn_buf[got] = 0;\n"
    buf = buf + "    return rsn_buf;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// flush_stdout_c(): force any pending stdout to the OS immediately.\n"
    buf = buf + "// Plain C ABI for the `extern fn flush_stdout_c() -> int` FFI surface —\n"
    buf = buf + "// the write-side counterpart to read_stdin_n_c (#1163) for stdio-protocol\n"
    buf = buf + "// servers (LSP/DAP/JSON-RPC) that emit Content-Length-framed messages with\n"
    buf = buf + "// NO trailing newline. The interpreter (`hexa run`) writes user `print(...)`\n"
    buf = buf + "// output through C stdio (block-buffered on a pipe), so a live editor never\n"
    buf = buf + "// sees the `initialize` response until the 4 KB buffer fills or the process\n"
    buf = buf + "// exits → deadlock. Calling this after each framed message drains it.\n"
    buf = buf + "// `fflush(NULL)` flushes every open stdio stream (no-op for the compiled\n"
    buf = buf + "// path, whose hxlcl_write is a raw write(2) syscall with no buffer). Returns 0.\n"
    buf = buf + "int flush_stdout_c(void) {\n"
    buf = buf + "    fflush(stdout);\n"
    buf = buf + "    fflush(NULL);\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// sleep_s(n): sleep n seconds (int or float). Wraps nanosleep for\n"
    buf = buf + "// sub-second precision. Returns void.\n"
    buf = buf + "HexaVal hexa_sleep_s(HexaVal n) {\n"
    buf = buf + "    double s = 0.0;\n"
    buf = buf + "    if (HX_IS_INT(n))        s = (double)HX_INT(n);\n"
    buf = buf + "    else if (HX_IS_FLOAT(n)) s = HX_FLOAT(n);\n"
    buf = buf + "    else                     s = (double)hexa_as_num(n);\n"
    buf = buf + "    if (s < 0) s = 0;\n"
    buf = buf + "    struct timespec ts;\n"
    buf = buf + "    ts.tv_sec  = (time_t)s;\n"
    buf = buf + "    ts.tv_nsec = (long)((s - (double)ts.tv_sec) * 1e9);\n"
    buf = buf + "    hxlcl_nanosleep(&ts, NULL);\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// sleep_ms(ms): sleep ms milliseconds. nanosleep-backed — no fork. Was\n"
    buf = buf + "// `exec(\"sleep 0.1\")` (fork /bin/sh -> exec /bin/sleep -> waitpid, ~5-8ms\n"
    buf = buf + "// overhead/tick) in sub-second throttle loops; this is the no-fork primitive.\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// Negative -> clamped to 0 (returns immediately). Loops on EINTR with the\n"
    buf = buf + "// remaining time so signal delivery doesn't shorten the sleep. Returns void.\n"
    buf = buf + "HexaVal hexa_sleep_ms(HexaVal ms) {\n"
    buf = buf + "    int64_t m = HX_IS_INT(ms) ? HX_INT(ms)\n"
    buf = buf + "              : HX_IS_FLOAT(ms) ? (int64_t)HX_FLOAT(ms)\n"
    buf = buf + "              : (int64_t)hexa_as_num(ms);\n"
    buf = buf + "    if (m <= 0) return hexa_void();\n"
    buf = buf + "    struct timespec req;\n"
    buf = buf + "    req.tv_sec  = (time_t)(m / 1000);\n"
    buf = buf + "    req.tv_nsec = (long)((m % 1000) * 1000000L);\n"
    buf = buf + "    struct timespec rem;\n"
    buf = buf + "    while (hxlcl_nanosleep(&req, &rem) != 0 && errno == EINTR) req = rem;\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// sleep_ns(ns): sleep ns nanoseconds. nanosleep-backed — no fork. Same\n"
    buf = buf + "// EINTR-resume semantics as sleep_ms. Negative -> clamped to 0. Returns void.\n"
    buf = buf + "HexaVal hexa_sleep_ns(HexaVal ns) {\n"
    buf = buf + "    int64_t n = HX_IS_INT(ns) ? HX_INT(ns)\n"
    buf = buf + "              : HX_IS_FLOAT(ns) ? (int64_t)HX_FLOAT(ns)\n"
    buf = buf + "              : (int64_t)hexa_as_num(ns);\n"
    buf = buf + "    if (n <= 0) return hexa_void();\n"
    buf = buf + "    struct timespec req;\n"
    buf = buf + "    req.tv_sec  = (time_t)(n / 1000000000LL);\n"
    buf = buf + "    req.tv_nsec = (long)(n % 1000000000LL);\n"
    buf = buf + "    struct timespec rem;\n"
    buf = buf + "    while (hxlcl_nanosleep(&req, &rem) != 0 && errno == EINTR) req = rem;\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// now_monotonic_s(): TAG_FLOAT seconds from CLOCK_MONOTONIC (wall-clock\n"
    buf = buf + "// elapsed, immune to system clock adjustment). Paired with time_ms()\n"
    buf = buf + "// for finer-grained benchmarks.\n"
    buf = buf + "HexaVal hexa_now_monotonic_s(void) {\n"
    buf = buf + "    int64_t pin = hexa_pinned_epoch();\n"
    buf = buf + "    if (pin >= 0) return hexa_float((double)pin);\n"
    buf = buf + "    struct timespec ts;\n"
    buf = buf + "    hxlcl_clock_gettime(CLOCK_MONOTONIC, &ts);\n"
    buf = buf + "    return hexa_float((double)ts.tv_sec + (double)ts.tv_nsec / 1e9);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// mono_ns(): TAG_INT nanoseconds from CLOCK_MONOTONIC. Exposed because\n"
    buf = buf + "// to_string(clock()) truncates sub-second precision via double→string\n"
    buf = buf + "// formatting, which caused stderr_tmp collisions (fix 1472b62d). Callers\n"
    buf = buf + "// building unique filenames should use to_string(mono_ns()) directly\n"
    buf = buf + "// and skip the mktemp fork in runtime_tmpname fallback (perf).\n"
    buf = buf + "\n"
    buf = buf + "// utc_iso_now(): RFC-3339 / ISO-8601 UTC \"YYYY-MM-DDTHH:MM:SSZ\".\n"
    buf = buf + "HexaVal hexa_utc_iso_now(void) {\n"
    buf = buf + "    int64_t pin = hexa_pinned_epoch();\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    time_t t = (pin >= 0) ? (time_t)pin : hxlcl_time(NULL);\n"
    buf = buf + "    struct tm g;\n"
    buf = buf + "    gmtime_r(&t, &g);\n"
    buf = buf + "    char buf[32];\n"
    buf = buf + "    hxlcl_strftime(buf, sizeof(buf), \"%Y-%m-%dT%H:%M:%SZ\", &g);\n"
    buf = buf + "    return hexa_str(buf);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// G4-ISO8601 2026-05-06 (.roadmap.stdlib.G4) — format/parse mirrors of\n"
    buf = buf + "// utc_iso_now() so witness rows in hexa-bio _python_bridge can drop\n"
    buf = buf + "// datetime.now(timezone.utc).isoformat() (45 callsites).\n"
    buf = buf + "\n"
    buf = buf + "// utc_iso_format(epoch_sec): epoch sec → \"YYYY-MM-DDTHH:MM:SSZ\".\n"
    buf = buf + "HexaVal hexa_utc_iso_format(HexaVal epoch_v) {\n"
    buf = buf + "    int64_t e = HX_IS_INT(epoch_v) ? HX_INT(epoch_v) : (int64_t)HX_FLOAT(epoch_v);\n"
    buf = buf + "    time_t t = (time_t)e;\n"
    buf = buf + "    struct tm g;\n"
    buf = buf + "    gmtime_r(&t, &g);\n"
    buf = buf + "    char buf[32];\n"
    buf = buf + "    hxlcl_strftime(buf, sizeof(buf), \"%Y-%m-%dT%H:%M:%SZ\", &g);\n"
    buf = buf + "    return hexa_str(buf);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// utc_iso_parse(s): \"YYYY-MM-DDTHH:MM:SS[.fff][Z|+HH:MM|-HH:MM]\" → epoch sec.\n"
    buf = buf + "// Tolerant of fractional seconds (truncated) and timezone offset suffix\n"
    buf = buf + "// (offset interpreted; non-UTC offsets shift the returned epoch).\n"
    // ── zero-c #29: native integer timegm (musl __tm_to_secs / __year_to_secs /
    //    __month_to_secs · bit-exact UTC) — drops the libc `timegm` dependency from
    //    the DEFAULT shipping runtime.c (was the sole raw libc timegm reference).
    buf = buf + "static int _hxrt_month_to_secs(int month, int is_leap) {\n"
    buf = buf + "    static const int _hxrt_smt[] = {0, 31*86400, 59*86400, 90*86400, 120*86400, 151*86400, 181*86400, 212*86400, 243*86400, 273*86400, 304*86400, 334*86400};\n"
    buf = buf + "    int t = _hxrt_smt[month];\n"
    buf = buf + "    if (is_leap && month >= 2) t += 86400;\n"
    buf = buf + "    return t;\n"
    buf = buf + "}\n"
    buf = buf + "static int64_t _hxrt_year_to_secs(int64_t year, int *is_leap) {\n"
    buf = buf + "    if (year - 2ULL <= 136) {\n"
    buf = buf + "        int y = (int)year;\n"
    buf = buf + "        int leaps = (y - 68) >> 2;\n"
    buf = buf + "        if (!((y - 68) & 3)) { leaps--; if (is_leap) *is_leap = 1; }\n"
    buf = buf + "        else if (is_leap) { *is_leap = 0; }\n"
    buf = buf + "        return 31536000LL * (y - 70) + 86400LL * leaps;\n"
    buf = buf + "    }\n"
    buf = buf + "    int cycles, centuries, leaps, rem;\n"
    buf = buf + "    int dummy;\n"
    buf = buf + "    if (!is_leap) is_leap = &dummy;\n"
    buf = buf + "    cycles = (int)((year - 100) / 400);\n"
    buf = buf + "    rem = (int)((year - 100) % 400);\n"
    buf = buf + "    if (rem < 0) { cycles--; rem += 400; }\n"
    buf = buf + "    if (!rem) { *is_leap = 1; centuries = 0; leaps = 0; }\n"
    buf = buf + "    else {\n"
    buf = buf + "        if (rem >= 200) { if (rem >= 300) { centuries = 3; rem -= 300; } else { centuries = 2; rem -= 200; } }\n"
    buf = buf + "        else { if (rem >= 100) { centuries = 1; rem -= 100; } else { centuries = 0; } }\n"
    buf = buf + "        if (!rem) { *is_leap = 0; leaps = 0; }\n"
    buf = buf + "        else { leaps = rem / 4; rem %= 4; *is_leap = !rem; }\n"
    buf = buf + "    }\n"
    buf = buf + "    leaps += 97 * cycles + 24 * centuries - *is_leap;\n"
    buf = buf + "    return (year - 100) * 31536000LL + leaps * 86400LL + 946684800LL + 86400LL;\n"
    buf = buf + "}\n"
    buf = buf + "static int64_t _hxrt_timegm_secs(const struct tm *tm) {\n"
    buf = buf + "    int is_leap;\n"
    buf = buf + "    int64_t year = tm->tm_year;\n"
    buf = buf + "    int month = tm->tm_mon;\n"
    buf = buf + "    if (month >= 12 || month < 0) {\n"
    buf = buf + "        int adj = month / 12; month %= 12;\n"
    buf = buf + "        if (month < 0) { adj--; month += 12; }\n"
    buf = buf + "        year += adj;\n"
    buf = buf + "    }\n"
    buf = buf + "    int64_t t = _hxrt_year_to_secs(year, &is_leap);\n"
    buf = buf + "    t += _hxrt_month_to_secs(month, is_leap);\n"
    buf = buf + "    t += 86400LL * (tm->tm_mday - 1);\n"
    buf = buf + "    t += 3600LL * tm->tm_hour;\n"
    buf = buf + "    t += 60LL * tm->tm_min;\n"
    buf = buf + "    t += tm->tm_sec;\n"
    buf = buf + "    return t;\n"
    buf = buf + "}\n"
    // ── zero-c #29: native integer sscanf replacement (musl vfscanf integer branch ·
    //    musl-free hand parse) — drops the libc `sscanf`/`__isoc99_sscanf` extern from
    //    runtime.c. Subset: '%d', '%<width>d', literal chars, whitespace runs · up to 6
    //    int* outs (NULL=suppress) · returns count assigned (sscanf semantics).
    buf = buf + "static int _hxrt_scan_ints(const char* s, const char* fmt,\n"
    buf = buf + "                           int* a, int* b, int* c, int* d, int* e, int* f) {\n"
    buf = buf + "    int* outs[6]; outs[0]=a; outs[1]=b; outs[2]=c; outs[3]=d; outs[4]=e; outs[5]=f;\n"
    buf = buf + "    int assigned = 0, oi = 0;\n"
    buf = buf + "    const char* p = fmt;\n"
    buf = buf + "    const char* in = s;\n"
    buf = buf + "    while (*p) {\n"
    buf = buf + "        unsigned char fc = (unsigned char)*p;\n"
    buf = buf + "        if (fc == '%') {\n"
    buf = buf + "            p++;\n"
    buf = buf + "            int width = 0, have_width = 0;\n"
    buf = buf + "            while (*p >= '0' && *p <= '9') { have_width = 1; width = width*10 + (*p-'0'); p++; }\n"
    buf = buf + "            if (*p != 'd') break;\n"
    buf = buf + "            p++;\n"
    buf = buf + "            while (*in==' '||*in=='\\t'||*in=='\\n'||*in=='\\r'||*in=='\\f'||*in=='\\v') in++;\n"
    buf = buf + "            int remain = have_width ? width : 2147483647;\n"
    buf = buf + "            int sign = 1;\n"
    buf = buf + "            if (remain > 0 && (*in=='+' || *in=='-')) { if (*in=='-') sign = -1; in++; remain--; }\n"
    buf = buf + "            if (!(*in>='0' && *in<='9')) break;\n"
    buf = buf + "            int val = 0;\n"
    buf = buf + "            while (remain > 0 && *in>='0' && *in<='9') { val = val*10 + (*in-'0'); in++; remain--; }\n"
    buf = buf + "            val *= sign;\n"
    buf = buf + "            if (oi < 6 && outs[oi]) *outs[oi] = val;\n"
    buf = buf + "            oi++; assigned++;\n"
    buf = buf + "        } else if (fc==' '||fc=='\\t'||fc=='\\n'||fc=='\\r'||fc=='\\f'||fc=='\\v') {\n"
    buf = buf + "            p++;\n"
    buf = buf + "            while (*in==' '||*in=='\\t'||*in=='\\n'||*in=='\\r'||*in=='\\f'||*in=='\\v') in++;\n"
    buf = buf + "        } else {\n"
    buf = buf + "            if (*in != (char)fc) break;\n"
    buf = buf + "            in++; p++;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return assigned;\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_utc_iso_parse(HexaVal s_v) {\n"
    buf = buf + "    if (!HX_IS_STR(s_v)) return hexa_int(0);\n"
    buf = buf + "    const char* s = HX_STR(s_v);\n"
    buf = buf + "    if (!s) return hexa_int(0);\n"
    buf = buf + "    int Y=0, M=0, D=0, h=0, m=0, sec=0;\n"
    buf = buf + "    int n = _hxrt_scan_ints(s, \"%d-%d-%dT%d:%d:%d\", &Y, &M, &D, &h, &m, &sec);  // zero-c #29: native, no libc sscanf\n"
    buf = buf + "    if (n < 6) return hexa_int(0);\n"
    buf = buf + "    struct tm g;\n"
    buf = buf + "    hxlcl_memset(&g, 0, sizeof(g));\n"
    buf = buf + "    g.tm_year = Y - 1900;\n"
    buf = buf + "    g.tm_mon  = M - 1;\n"
    buf = buf + "    g.tm_mday = D;\n"
    buf = buf + "    g.tm_hour = h;\n"
    buf = buf + "    g.tm_min  = m;\n"
    buf = buf + "    g.tm_sec  = sec;\n"
    buf = buf + "    int64_t epoch = _hxrt_timegm_secs(&g);  // zero-c #29: native, no libc timegm\n"
    buf = buf + "    // Optional tz offset suffix: scan from end of string for [+-]HH:MM or [+-]HHMM.\n"
    buf = buf + "    size_t L = hxlcl_strlen(s);\n"
    buf = buf + "    if (L >= 5) {\n"
    buf = buf + "        for (ssize_t i = (ssize_t)L - 1; i > 0; i--) {\n"
    buf = buf + "            char c = s[i];\n"
    buf = buf + "            if (c == '+' || c == '-') {\n"
    buf = buf + "                int sign = (c == '+') ? 1 : -1;\n"
    buf = buf + "                int oh = 0, om = 0;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "                const char* off = s + i + 1;\n"
    buf = buf + "                if (_hxrt_scan_ints(off, \"%d:%d\", &oh, &om, 0, 0, 0, 0) == 2 ||\n"
    buf = buf + "                    _hxrt_scan_ints(off, \"%2d%2d\", &oh, &om, 0, 0, 0, 0) == 2) {\n"
    buf = buf + "                    epoch -= sign * (oh * 3600 + om * 60);\n"
    buf = buf + "                }\n"
    buf = buf + "                break;\n"
    buf = buf + "            }\n"
    buf = buf + "            if (c == 'Z' || c == 'z') break;\n"
    buf = buf + "            if (c >= '0' && c <= '9') continue;\n"
    buf = buf + "            if (c == ':' || c == '.') continue;\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int(epoch);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// G3-REGEX 2026-05-06 (.roadmap.stdlib.G3) — POSIX ERE bridge.\n"
    buf = buf + "//\n"
    buf = buf + "// Surface (returns hexa values):\n"
    buf = buf + "//   regex_match(pat, s)           → bool      — does pat match anywhere in s?\n"
    buf = buf + "//   regex_match_full(pat, s)      → bool      — does pat match the whole s?\n"
    buf = buf + "//   regex_search(pat, s)          → array     — [start, end] of first match, [] if none\n"
    buf = buf + "//   regex_findall(pat, s)         → [array]   — list of [start, end] for every match\n"
    buf = buf + "//   regex_replace(pat, s, repl)   → string    — replace all matches with repl (no backrefs)\n"
    buf = buf + "//   regex_split(pat, s)           → [string]  — split s on every pat match\n"
    buf = buf + "//\n"
    buf = buf + "// Flavor: POSIX ERE (Extended Regular Expressions). Supports . [] ^ $ * + ? {n,m}\n"
    buf = buf + "// () |. PCRE shortcuts (\\d \\s \\w \\b) are NOT POSIX-portable — translate at the\n"
    buf = buf + "// hexa stdlib layer (e.g., \\d → [0-9], \\s → [[:space:]], \\w → [[:alnum:]_]).\n"
    buf = buf + "// Inline flag (?i) → REG_ICASE; the wrapper strips and sets the flag.\n"
    buf = buf + "\n"
    buf = buf + "static int _hexa_re_compile(const char* pat, regex_t* out, int icase) {\n"
    buf = buf + "    int flags = REG_EXTENDED;\n"
    buf = buf + "    if (icase) flags |= REG_ICASE;\n"
    buf = buf + "    return regcomp(out, pat, flags);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Strip a leading \"(?i)\" inline flag and set *icase = 1 if present.\n"
    buf = buf + "static const char* _hexa_re_strip_flags(const char* pat, int* icase) {\n"
    buf = buf + "    *icase = 0;\n"
    buf = buf + "    if (pat && pat[0] == '(' && pat[1] == '?' && pat[2] == 'i' && pat[3] == ')') {\n"
    buf = buf + "        *icase = 1;\n"
    buf = buf + "        return pat + 4;\n"
    buf = buf + "    }\n"
    buf = buf + "    return pat;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_regex_match(HexaVal pat_v, HexaVal s_v) {\n"
    buf = buf + "    if (!HX_IS_STR(pat_v) || !HX_IS_STR(s_v)) return hexa_bool(0);\n"
    buf = buf + "    const char* pat_raw = HX_STR(pat_v);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    const char* s = HX_STR(s_v);\n"
    buf = buf + "    if (!pat_raw || !s) return hexa_bool(0);\n"
    buf = buf + "    int icase = 0;\n"
    buf = buf + "    const char* pat = _hexa_re_strip_flags(pat_raw, &icase);\n"
    buf = buf + "    regex_t re;\n"
    buf = buf + "    if (_hexa_re_compile(pat, &re, icase) != 0) return hexa_bool(0);\n"
    buf = buf + "    int ok = regexec(&re, s, 0, NULL, 0);\n"
    buf = buf + "    regfree(&re);\n"
    buf = buf + "    return hexa_bool(ok == 0 ? 1 : 0);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_regex_match_full(HexaVal pat_v, HexaVal s_v) {\n"
    buf = buf + "    if (!HX_IS_STR(pat_v) || !HX_IS_STR(s_v)) return hexa_bool(0);\n"
    buf = buf + "    const char* pat_raw = HX_STR(pat_v);\n"
    buf = buf + "    const char* s = HX_STR(s_v);\n"
    buf = buf + "    if (!pat_raw || !s) return hexa_bool(0);\n"
    buf = buf + "    int icase = 0;\n"
    buf = buf + "    const char* pat = _hexa_re_strip_flags(pat_raw, &icase);\n"
    buf = buf + "    regex_t re;\n"
    buf = buf + "    if (_hexa_re_compile(pat, &re, icase) != 0) return hexa_bool(0);\n"
    buf = buf + "    regmatch_t m;\n"
    buf = buf + "    int ok = regexec(&re, s, 1, &m, 0);\n"
    buf = buf + "    int full = (ok == 0 && m.rm_so == 0 && (size_t)m.rm_eo == hxlcl_strlen(s)) ? 1 : 0;\n"
    buf = buf + "    regfree(&re);\n"
    buf = buf + "    return hexa_bool(full);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_regex_search(HexaVal pat_v, HexaVal s_v) {\n"
    buf = buf + "    if (!HX_IS_STR(pat_v) || !HX_IS_STR(s_v)) return hexa_array_new();\n"
    buf = buf + "    const char* pat_raw = HX_STR(pat_v);\n"
    buf = buf + "    const char* s = HX_STR(s_v);\n"
    buf = buf + "    if (!pat_raw || !s) return hexa_array_new();\n"
    buf = buf + "    int icase = 0;\n"
    buf = buf + "    const char* pat = _hexa_re_strip_flags(pat_raw, &icase);\n"
    buf = buf + "    regex_t re;\n"
    buf = buf + "    if (_hexa_re_compile(pat, &re, icase) != 0) return hexa_array_new();\n"
    buf = buf + "    regmatch_t m;\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (regexec(&re, s, 1, &m, 0) == 0) {\n"
    buf = buf + "        hexa_array_push(out, hexa_int((int64_t)m.rm_so));\n"
    buf = buf + "        hexa_array_push(out, hexa_int((int64_t)m.rm_eo));\n"
    buf = buf + "    }\n"
    buf = buf + "    regfree(&re);\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_regex_findall(HexaVal pat_v, HexaVal s_v) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_STR(pat_v) || !HX_IS_STR(s_v)) return out;\n"
    buf = buf + "    const char* pat_raw = HX_STR(pat_v);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    const char* s = HX_STR(s_v);\n"
    buf = buf + "    if (!pat_raw || !s) return out;\n"
    buf = buf + "    int icase = 0;\n"
    buf = buf + "    const char* pat = _hexa_re_strip_flags(pat_raw, &icase);\n"
    buf = buf + "    regex_t re;\n"
    buf = buf + "    if (_hexa_re_compile(pat, &re, icase) != 0) return out;\n"
    buf = buf + "    regmatch_t m;\n"
    buf = buf + "    size_t off = 0;\n"
    buf = buf + "    size_t L = hxlcl_strlen(s);\n"
    buf = buf + "    while (off <= L) {\n"
    buf = buf + "        if (regexec(&re, s + off, 1, &m, off > 0 ? REG_NOTBOL : 0) != 0) break;\n"
    buf = buf + "        if (m.rm_eo == m.rm_so) {\n"
    buf = buf + "            // zero-width match — advance one to avoid infinite loop\n"
    buf = buf + "            off += 1;\n"
    buf = buf + "            continue;\n"
    buf = buf + "        }\n"
    buf = buf + "        HexaVal pair = hexa_array_new();\n"
    buf = buf + "        hexa_array_push(pair, hexa_int((int64_t)(off + m.rm_so)));\n"
    buf = buf + "        hexa_array_push(pair, hexa_int((int64_t)(off + m.rm_eo)));\n"
    buf = buf + "        hexa_array_push(out, pair);\n"
    buf = buf + "        off += m.rm_eo;\n"
    buf = buf + "    }\n"
    buf = buf + "    regfree(&re);\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_regex_split(HexaVal pat_v, HexaVal s_v) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_STR(pat_v) || !HX_IS_STR(s_v)) return out;\n"
    buf = buf + "    const char* pat_raw = HX_STR(pat_v);\n"
    buf = buf + "    const char* s = HX_STR(s_v);\n"
    buf = buf + "    if (!pat_raw || !s) return out;\n"
    buf = buf + "    int icase = 0;\n"
    buf = buf + "    const char* pat = _hexa_re_strip_flags(pat_raw, &icase);\n"
    buf = buf + "    regex_t re;\n"
    buf = buf + "    if (_hexa_re_compile(pat, &re, icase) != 0) {\n"
    buf = buf + "        hexa_array_push(out, hexa_str(s));\n"
    buf = buf + "        return out;\n"
    buf = buf + "    }\n"
    buf = buf + "    regmatch_t m;\n"
    buf = buf + "    size_t off = 0;\n"
    buf = buf + "    size_t L = hxlcl_strlen(s);\n"
    buf = buf + "    while (off <= L) {\n"
    buf = buf + "        if (regexec(&re, s + off, 1, &m, off > 0 ? REG_NOTBOL : 0) != 0) break;\n"
    buf = buf + "        if (m.rm_eo == m.rm_so) { off += 1; continue; }\n"
    buf = buf + "        size_t seg_len = (size_t)m.rm_so;\n"
    buf = buf + "        char* seg = (char*)malloc(seg_len + 1);\n"
    buf = buf + "        if (!seg) break;\n"
    buf = buf + "        hxlcl_memcpy(seg, s + off, seg_len);\n"
    buf = buf + "        seg[seg_len] = '\\0';\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        hexa_array_push(out, hexa_str(seg));\n"
    buf = buf + "        free(seg);\n"
    buf = buf + "        off += m.rm_eo;\n"
    buf = buf + "    }\n"
    buf = buf + "    // Final segment after last match.\n"
    buf = buf + "    if (off <= L) {\n"
    buf = buf + "        hexa_array_push(out, hexa_str(s + off));\n"
    buf = buf + "    }\n"
    buf = buf + "    regfree(&re);\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_regex_replace(HexaVal pat_v, HexaVal s_v, HexaVal repl_v) {\n"
    buf = buf + "    if (!HX_IS_STR(pat_v) || !HX_IS_STR(s_v) || !HX_IS_STR(repl_v)) return s_v;\n"
    buf = buf + "    const char* pat_raw = HX_STR(pat_v);\n"
    buf = buf + "    const char* s = HX_STR(s_v);\n"
    buf = buf + "    const char* repl = HX_STR(repl_v);\n"
    buf = buf + "    if (!pat_raw || !s) return s_v;\n"
    buf = buf + "    if (!repl) repl = \"\";\n"
    buf = buf + "    int icase = 0;\n"
    buf = buf + "    const char* pat = _hexa_re_strip_flags(pat_raw, &icase);\n"
    buf = buf + "    regex_t re;\n"
    buf = buf + "    if (_hexa_re_compile(pat, &re, icase) != 0) return s_v;\n"
    buf = buf + "    regmatch_t m;\n"
    buf = buf + "    size_t off = 0;\n"
    buf = buf + "    size_t L = hxlcl_strlen(s);\n"
    buf = buf + "    size_t Rlen = hxlcl_strlen(repl);\n"
    buf = buf + "    // Worst-case sizing: every position is a zero-width match → impossible\n"
    buf = buf + "    // with our zero-width skip. Estimate cap = 4 * (L + 1) * (Rlen + 1).\n"
    buf = buf + "    size_t cap = (L + 1) * (Rlen + 1) * 4 + 64;\n"
    buf = buf + "    char* out_buf = (char*)malloc(cap);\n"
    buf = buf + "    if (!out_buf) { regfree(&re); return s_v; }\n"
    buf = buf + "    size_t op = 0;\n"
    buf = buf + "    while (off <= L) {\n"
    buf = buf + "        if (regexec(&re, s + off, 1, &m, off > 0 ? REG_NOTBOL : 0) != 0) break;\n"
    buf = buf + "        if (m.rm_eo == m.rm_so) {\n"
    buf = buf + "            // Copy one char and advance.\n"
    buf = buf + "            if (op + 1 >= cap) break;\n"
    buf = buf + "            out_buf[op++] = s[off];\n"
    buf = buf + "            off += 1;\n"
    buf = buf + "            continue;\n"
    buf = buf + "        }\n"
    buf = buf + "        // Copy unmatched prefix.\n"
    buf = buf + "        size_t pre = (size_t)m.rm_so;\n"
    buf = buf + "        if (op + pre + Rlen + 1 >= cap) {\n"
    buf = buf + "            cap *= 2;\n"
    buf = buf + "            char* nb = (char*)realloc(out_buf, cap);\n"
    buf = buf + "            if (!nb) break;\n"
    buf = buf + "            out_buf = nb;\n"
    buf = buf + "        }\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        hxlcl_memcpy(out_buf + op, s + off, pre);\n"
    buf = buf + "        op += pre;\n"
    buf = buf + "        hxlcl_memcpy(out_buf + op, repl, Rlen);\n"
    buf = buf + "        op += Rlen;\n"
    buf = buf + "        off += m.rm_eo;\n"
    buf = buf + "    }\n"
    buf = buf + "    // Tail.\n"
    buf = buf + "    size_t tail = L - off;\n"
    buf = buf + "    if (op + tail + 1 >= cap) {\n"
    buf = buf + "        cap = op + tail + 1;\n"
    buf = buf + "        char* nb = (char*)realloc(out_buf, cap);\n"
    buf = buf + "        if (nb) out_buf = nb;\n"
    buf = buf + "    }\n"
    buf = buf + "    hxlcl_memcpy(out_buf + op, s + off, tail);\n"
    buf = buf + "    op += tail;\n"
    buf = buf + "    out_buf[op] = '\\0';\n"
    buf = buf + "    HexaVal result = hexa_str(out_buf);\n"
    buf = buf + "    free(out_buf);\n"
    buf = buf + "    regfree(&re);\n"
    buf = buf + "    return result;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// utc_compact_now(): compact \"YYYYMMDDHHMMSS\" UTC (checkpoint filename).\n"
    buf = buf + "HexaVal hexa_utc_compact_now(void) {\n"
    buf = buf + "    int64_t pin = hexa_pinned_epoch();\n"
    buf = buf + "    time_t t = (pin >= 0) ? (time_t)pin : hxlcl_time(NULL);\n"
    buf = buf + "    struct tm g;\n"
    buf = buf + "    gmtime_r(&t, &g);\n"
    buf = buf + "    char buf[32];\n"
    buf = buf + "    hxlcl_strftime(buf, sizeof(buf), \"%Y%m%d%H%M%S\", &g);\n"
    buf = buf + "    return hexa_str(buf);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// to_bool(v): generic truthy coercion. Mirrors hexa_truthy semantics\n"
    buf = buf + "// but returns a TAG_BOOL HexaVal (as opposed to int).\n"
    buf = buf + "// RUNTIME.md Step 4 .c-none: hexa_to_bool delegates to hexa-source rt_to_bool\n"
    buf = buf + "// (numeric.hexa) under HEXA_HAS_HEXA_RT_STDLIB. #else C body kept.\n"
    buf = buf + "#ifdef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "extern HexaVal rt_to_bool(HexaVal v);\n"
    buf = buf + "HexaVal hexa_to_bool(HexaVal v) { return rt_to_bool(v); }\n"
    buf = buf + "#else\n"
    buf = buf + "HexaVal hexa_to_bool(HexaVal v) { return hexa_bool(hexa_truthy(v) ? 1 : 0); }\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// http_get(url): popen(\"curl -s <url>\") → TAG_STR body. Keeps the\n"
    buf = buf + "// dependency surface at /usr/bin/curl (universal on macOS/linux) and\n"
    buf = buf + "// avoids pulling libcurl into runtime.c. Returns \"\" on curl-missing or\n"
    buf = buf + "// non-zero exit. http_get is used by anima serve_alm health-checks +\n"
    buf = buf + "// a handful of blowup-engine scrapers (~6 sites).\n"
    buf = buf + "HexaVal hexa_http_get(HexaVal url) {\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    if (!HX_IS_STR(url) || !HX_STR(url)) return hexa_str(\"\");\n"
    buf = buf + "    const char* u = HX_STR(url);\n"
    buf = buf + "    // Reject URLs with shell-meta chars — we pass through /bin/sh via popen.\n"
    buf = buf + "    for (const char* p = u; *p; p++) {\n"
    buf = buf + "        char c = *p;\n"
    buf = buf + "        if (c == '`' || c == '$' || c == ';' || c == '|' || c == '&'\n"
    buf = buf + "            || c == '<' || c == '>' || c == '\\n' || c == '\\r'\n"
    buf = buf + "            || c == '\\'' || c == '\"' || c == '\\\\') {\n"
    buf = buf + "            return hexa_str(\"\");\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    char cmd[4096];\n"
    buf = buf + "    int k = snprintf(cmd, sizeof(cmd), \"curl -fsSL --max-time 30 '%s' 2>/dev/null\", u);\n"
    buf = buf + "    if (k < 0 || (size_t)k >= sizeof(cmd)) return hexa_str(\"\");\n"
    buf = buf + "    // 2026-05-06 — POSIX fork buffer flush before popen (mirrors hexa_exec)\n"
    buf = buf + "    fflush(NULL);\n"
    buf = buf + "    FILE* fp = hxlcl_popen(cmd, \"r\");\n"
    buf = buf + "    if (!fp) return hexa_str(\"\");\n"
    buf = buf + "    size_t cap = 4096, len = 0;\n"
    buf = buf + "    char* buf = (char*)malloc(cap);\n"
    buf = buf + "    if (!buf) { hxlcl_pclose(fp); return hexa_str(\"\"); }\n"
    buf = buf + "    size_t r;\n"
    buf = buf + "    char chunk[2048];\n"
    buf = buf + "    while ((r = fread(chunk, 1, sizeof(chunk), fp)) > 0) {\n"
    buf = buf + "        if (len + r + 1 >= cap) {\n"
    buf = buf + "            while (len + r + 1 >= cap) cap *= 2;\n"
    buf = buf + "            char* nb = (char*)realloc(buf, cap);\n"
    buf = buf + "            if (!nb) { free(buf); hxlcl_pclose(fp); return hexa_str(\"\"); }\n"
    buf = buf + "            buf = nb;\n"
    buf = buf + "        }\n"
    buf = buf + "        hxlcl_memcpy(buf + len, chunk, r);\n"
    buf = buf + "        len += r;\n"
    buf = buf + "    }\n"
    buf = buf + "    buf[len] = 0;\n"
    buf = buf + "    hxlcl_pclose(fp);\n"
    buf = buf + "    return hexa_str_own(buf);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ── JSON mini (parse + stringify) ─────────────────────────────────\n"
    buf = buf + "// Minimal recursive-descent JSON handler that covers Anima's use\n"
    buf = buf + "// (tokenizer configs, checkpoint metadata, serve_alm request bodies).\n"
    buf = buf + "// Supported: null / bool / int / float / string / array / object.\n"
    buf = buf + "// Limits: no \\uXXXX surrogates (passthrough as raw bytes), no +NaN/Inf.\n"
    buf = buf + "// TAG mapping:\n"
    buf = buf + "//   null   → TAG_VOID  (hexa_void)\n"
    buf = buf + "//   true   → TAG_BOOL 1\n"
    buf = buf + "//   false  → TAG_BOOL 0\n"
    buf = buf + "//   int    → TAG_INT\n"
    buf = buf + "//   float  → TAG_FLOAT\n"
    buf = buf + "//   string → TAG_STR\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "//   array  → TAG_ARRAY\n"
    buf = buf + "//   object → TAG_MAP   (keys always string)\n"
    buf = buf + "\n"
    buf = buf + "static void _jp_skip_ws(const char* s, size_t n, size_t* pi) {\n"
    buf = buf + "    while (*pi < n) {\n"
    buf = buf + "        char c = s[*pi];\n"
    buf = buf + "        if (c == ' ' || c == '\\t' || c == '\\n' || c == '\\r') (*pi)++;\n"
    buf = buf + "        else break;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "static HexaVal _jp_parse_value(const char* s, size_t n, size_t* pi);\n"
    buf = buf + "\n"
    buf = buf + "static HexaVal _jp_parse_string(const char* s, size_t n, size_t* pi) {\n"
    buf = buf + "    if (*pi >= n || s[*pi] != '\"') return hexa_str(\"\");\n"
    buf = buf + "    (*pi)++;\n"
    buf = buf + "    size_t cap = 64, len = 0;\n"
    buf = buf + "    char* buf = (char*)malloc(cap);\n"
    buf = buf + "    if (!buf) return hexa_str(\"\");\n"
    buf = buf + "    while (*pi < n) {\n"
    buf = buf + "        char c = s[*pi];\n"
    buf = buf + "        if (c == '\"') { (*pi)++; buf[len] = 0; return hexa_str_own(buf); }\n"
    buf = buf + "        if (c == '\\\\' && *pi + 1 < n) {\n"
    buf = buf + "            char e = s[*pi + 1];\n"
    buf = buf + "            char out = 0;\n"
    buf = buf + "            int consumed = 2;\n"
    buf = buf + "            switch (e) {\n"
    buf = buf + "                case '\"':  out = '\"';  break;\n"
    buf = buf + "                case '\\\\': out = '\\\\'; break;\n"
    buf = buf + "                case '/':  out = '/';  break;\n"
    buf = buf + "                case 'n':  out = '\\n'; break;\n"
    buf = buf + "                case 'r':  out = '\\r'; break;\n"
    buf = buf + "                case 't':  out = '\\t'; break;\n"
    buf = buf + "                case 'b':  out = '\\b'; break;\n"
    buf = buf + "                case 'f':  out = '\\f'; break;\n"
