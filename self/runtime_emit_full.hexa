    buf = buf + "// handing it a fake (void*)(fd+1) (e.g. 0x4 for fd 3) SIGSEGVs. This bit\n"
    buf = buf + "// hexa_pipe_buf_enlarge_kernel() (runtime_core.c) on the very first\n"
    buf = buf + "// hexa_exec() during install_dir_from_argv0(), crashing the compiled CLI\n"
    buf = buf + "// driver at startup before --version could print.\n"
    buf = buf + "#define fileno(fp)         _hxlcl_fp_fd((void *)(fp))\n"
