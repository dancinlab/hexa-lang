    buf = buf + "HexaVal farr_scale_gpu;\n"
    buf = buf + "HexaVal farr_silu_gate_gpu;\n"
    buf = buf + "// BC-ANIMA M2 (2026-05-28): 4-arg in-place row-softmax carrier.\n"
    buf = buf + "HexaVal farr_softmax_rows;\n"
    buf = buf + "\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + "// anima RFC 040 Phase B2 (2026-05-16): d_train5 hot-path completion —\n"
    buf = buf + "// the remaining DOMINANT-FLOP farr ops the Phase E refactor of\n"
    buf = buf + "// HEXAD/D/d_train5_lib.hexa needs so every c3_*/d5_* boxed op has a\n"
    buf = buf + "// matching `farr_*_gpu` primitive (clean swap target). Scaffolding\n"
    buf = buf + "// only (Mac, no CUDA) — same `#ifdef HEXA_CUDA` (TODO[cuda] stub\n"
    buf = buf + "// returns -1) / `#ifndef HEXA_CUDA` (verified CPU helper) dispatch as\n"
    buf = buf + "// Phase A/B. RFC 032 use-after-realloc guard carried verbatim\n"
    buf = buf + "// (re-fetch _hx_farr_table entry pointers after every hexa_farr_zeros).\n"
    buf = buf + "//\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// d_train5 op-audit → ops landed here (the dominant-FLOP missing set):\n"
    buf = buf + "//   farr_matmul_t_gpu       Mᵀ·u   (c3_matvec_t — dX / dr / dzT vjp)\n"
    buf = buf + "//   farr_outer_gpu          u⊗v    (c3_outer    — dW / dWg / dWh grad)\n"
    buf = buf + "//   farr_mul_gpu            A⊙B    (SwiGLU s=silu(a)⊙b, dq'⊙cos etc.)\n"
    buf = buf + "//   farr_silu_gpu           silu(x)=x·σ(x)        (SwiGLU activation)\n"
    buf = buf + "//   farr_silu_grad_gpu      σ(x)·(1+x·(1−σ(x)))   (SwiGLU bwd)\n"
    buf = buf + "//   farr_rmsnorm_bwd_rows_gpu  exact RMSNorm vjp dy→dx (c3_rmsnorm_bwd\n"
    buf = buf + "//                              dx-branch; per-channel gain handled by\n"
    buf = buf + "//                              caller via farr_mul_gpu — this is the\n"
    buf = buf + "//                              inv-rms vjp core, mirrors the fwd-kernel\n"
    buf = buf + "//                              gain-free split of Phase B rmsnorm_rows)\n"
    buf = buf + "//   farr_adamw_step_gpu     decoupled-wd AdamW in-place (dt2_adamw_step)\n"
    buf = buf + "//\n"
    buf = buf + "// CPU helpers verified vs the trusted boxed c3_*/dt2_* reference in\n"
    buf = buf + "// tmp_rfc040_phaseB2_smoke.hexa (each op's no-CUDA dispatcher proven\n"
    buf = buf + "// ≡ a hexa-side oracle that replays the exact c3_*/dt2_* formula).\n"
    buf = buf + "//\n"
    buf = buf + "// Honestly deferred (low FLOP / memory-bound — NOT dominant): RoPE\n"
    buf = buf + "// scalar trig rotate (d5_rope_*), embedding gather + scatter-add\n"
    buf = buf + "// (d5_forward / d5_grad tied-embed). Named for a follow-on cycle.\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════════════\n"
    buf = buf + "\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "/* Forward decls for the Phase B2 GPU TU (TODO[cuda] — bodies on the\n"
    buf = buf + " * CUDA host build only). NOT defined in the no-CUDA build. */\n"
    buf = buf + "extern int  _hx_cuda_farr_matmul_t_gpu(int64_t m_id, int64_t R, int64_t C,\n"
    buf = buf + "                                        int64_t u_id, int64_t out_id);\n"
