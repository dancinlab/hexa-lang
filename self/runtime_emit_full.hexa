    buf = buf + "    // use bare direct-C calls past the hexa_callN ceiling.\n"
    buf = buf + "    farr_zero_slice_gpu             = hexa_fn_new((void*)hexa_farr_zero_slice_gpu,             3);\n"
    buf = buf + "    farr_add_inplace_gpu            = hexa_fn_new((void*)hexa_farr_add_inplace_gpu,            3);\n"
    buf = buf + "    // anima RFC 040 Phase B2 (2026-05-16): d_train5 hot-path completion —\n"
    buf = buf + "    // matmul_t / outer / mul / silu / silu_grad / rmsnorm_bwd (≤4-arg\n"
    buf = buf + "    // carriers). farr_adamw_step_gpu (11-arg) = bare direct-C entry,\n"
    buf = buf + "    // NOT registered here (RFC 032/035 pattern).\n"
    buf = buf + "    farr_matmul_t_gpu               = hexa_fn_new((void*)hexa_farr_matmul_t_gpu,               4);\n"
    buf = buf + "    farr_outer_gpu                  = hexa_fn_new((void*)hexa_farr_outer_gpu,                  4);\n"
    buf = buf + "    farr_mul_gpu                    = hexa_fn_new((void*)hexa_farr_mul_gpu,                    3);\n"
    buf = buf + "    farr_silu_gpu                   = hexa_fn_new((void*)hexa_farr_silu_gpu,                   2);\n"
    buf = buf + "    farr_silu_grad_gpu              = hexa_fn_new((void*)hexa_farr_silu_grad_gpu,              2);\n"
    buf = buf + "    farr_rmsnorm_bwd_rows_gpu       = hexa_fn_new((void*)hexa_farr_rmsnorm_bwd_rows_gpu,       4);\n"
    buf = buf + "    // RFC 035 (2026-05-13): 3/4-arg NM-step builtins routed through hexa_callN.\n"
    buf = buf + "    farr_simplex_centroid           = hexa_fn_new((void*)hexa_farr_simplex_centroid,           4);\n"
    buf = buf + "    farr_simplex_get                = hexa_fn_new((void*)hexa_farr_simplex_get,                4);\n"
    buf = buf + "    farr_simplex_shrink             = hexa_fn_new((void*)hexa_farr_simplex_shrink,             3);\n"
    buf = buf + "    farr_simplex_sort               = hexa_fn_new((void*)hexa_farr_simplex_sort,               4);\n"
    buf = buf + "    // RFC 039 (2026-05-13): 1-arg ham_free / ansatz_free use hexa_call1 dispatch.\n"
    buf = buf + "    // 7-arg ham_pack / 8-arg ansatz_pack / 8-arg farr_parameter_shift_grad are\n"
