    buf = buf + "#endif\n"
    buf = buf + "// mk2-C5 (2026-05-19): batch slice/transpose builtins. Eliminate the\n"
    buf = buf + "// ~412M per-step host-scalar t_get/t_set prelude (HexaVal box overhead)\n"
