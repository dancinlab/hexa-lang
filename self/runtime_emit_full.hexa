    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_one_hot(HexaVal idx, HexaVal n);\n"
    buf = buf + "HexaVal hexa_one_hot(HexaVal idxv, HexaVal nv) {\n"
    buf = buf + "    int64_t idx = HX_IS_INT(idxv) ? HX_INT(idxv) : (int64_t)__hx_to_double(idxv);\n"
    buf = buf + "    int64_t n = HX_IS_INT(nv) ? HX_INT(nv) : (int64_t)__hx_to_double(nv);\n"
    buf = buf + "    return rt_one_hot(hexa_int(idx), hexa_int(n));\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// rms_norm(x, gamma, eps): gamma[i] * x[i] / sqrt(mean(x^2) + eps).\n"
    buf = buf + "// gamma may be array (per-element scale) or scalar (uniform scale).\n"
    buf = buf + "// Step-3 cycle 16 port.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_rms_norm(HexaVal x, HexaVal gamma, HexaVal epsv) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(x)) return out;\n"
    buf = buf + "    int64_t n = (int64_t)HX_ARR_LEN(x);\n"
    buf = buf + "    if (n == 0) return out;\n"
    buf = buf + "    double ss = 0.0;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        double v = __hx_to_double(hexa_array_get(x, i));\n"
    buf = buf + "        ss += v * v;\n"
    buf = buf + "    }\n"
    buf = buf + "    double mean = ss / (double)n;\n"
    buf = buf + "    double eps = __hx_to_double(epsv);\n"
    buf = buf + "    double inv = 1.0 / _hx_sqrt(mean + eps);\n"
    buf = buf + "    int gamma_is_arr = HX_IS_ARRAY(gamma);\n"
    buf = buf + "    double gamma_scalar = gamma_is_arr ? 1.0 : __hx_to_double(gamma);\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        double v = __hx_to_double(hexa_array_get(x, i));\n"
    buf = buf + "        double g = gamma_is_arr\n"
    buf = buf + "            ? __hx_to_double(hexa_array_get(gamma, i < (int64_t)HX_ARR_LEN(gamma) ? i : 0))\n"
    buf = buf + "            : gamma_scalar;\n"
    buf = buf + "        out = hexa_array_push(out, hexa_float(g * v * inv));\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_rms_norm_scalar(HexaVal x, HexaVal gamma, HexaVal eps);\n"
    buf = buf + "extern HexaVal rt_rms_norm_array(HexaVal x, HexaVal gamma, HexaVal eps);\n"
    buf = buf + "HexaVal hexa_rms_norm(HexaVal x, HexaVal gamma, HexaVal epsv) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(x)) return hexa_array_new();\n"
    buf = buf + "    HexaVal eps = hexa_float(__hx_to_double(epsv));\n"
    buf = buf + "    if (HX_IS_ARRAY(gamma)) return rt_rms_norm_array(x, gamma, eps);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    return rt_rms_norm_scalar(x, hexa_float(__hx_to_double(gamma)), eps);\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// layer_norm(x, gamma, eps): (x - mean) / sqrt(var + eps), gamma-scaled.\n"
    buf = buf + "// L723 NN-primitive — mirror of rms_norm with mean subtraction (full LayerNorm).\n"
    buf = buf + "HexaVal hexa_layer_norm(HexaVal x, HexaVal gamma, HexaVal epsv) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(x)) return out;\n"
    buf = buf + "    int64_t n = (int64_t)HX_ARR_LEN(x);\n"
    buf = buf + "    if (n == 0) return out;\n"
    buf = buf + "    double sum = 0.0;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) sum += __hx_to_double(hexa_array_get(x, i));\n"
    buf = buf + "    double mean = sum / (double)n;\n"
    buf = buf + "    double ss = 0.0;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        double d = __hx_to_double(hexa_array_get(x, i)) - mean;\n"
    buf = buf + "        ss += d * d;\n"
    buf = buf + "    }\n"
    buf = buf + "    double var = ss / (double)n;\n"
    buf = buf + "    double eps = __hx_to_double(epsv);\n"
    buf = buf + "    double inv = 1.0 / _hx_sqrt(var + eps);\n"
    buf = buf + "    int gamma_is_arr = HX_IS_ARRAY(gamma);\n"
    buf = buf + "    double gamma_scalar = gamma_is_arr ? 1.0 : __hx_to_double(gamma);\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        double d = __hx_to_double(hexa_array_get(x, i)) - mean;\n"
    buf = buf + "        double g = gamma_is_arr\n"
    buf = buf + "            ? __hx_to_double(hexa_array_get(gamma, i < (int64_t)HX_ARR_LEN(gamma) ? i : 0))\n"
    buf = buf + "            : gamma_scalar;\n"
    buf = buf + "        out = hexa_array_push(out, hexa_float(g * d * inv));\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// rope_pair(x0, x1, theta): rotate one (even, odd) pair by angle theta.\n"
    buf = buf + "// L723 NN-primitive — canonical scalar form of RoPE positional rotation.\n"
    buf = buf + "// Returns [x0*cos(theta) - x1*sin(theta), x0*sin(theta) + x1*cos(theta)].\n"
    buf = buf + "HexaVal hexa_rope_pair(HexaVal x0v, HexaVal x1v, HexaVal thetav) {\n"
    buf = buf + "    double x0 = __hx_to_double(x0v);\n"
    buf = buf + "    double x1 = __hx_to_double(x1v);\n"
    buf = buf + "    double th = __hx_to_double(thetav);\n"
    buf = buf + "    double c = _hx_cos(th);\n"
    buf = buf + "    double s = _hx_sin(th);\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    out = hexa_array_push(out, hexa_float(x0 * c - x1 * s));\n"
    buf = buf + "    out = hexa_array_push(out, hexa_float(x0 * s + x1 * c));\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// softmax(a): stable softmax — subtract max, exp, normalize by sum.\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// Step-3 cycle 15 port.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_softmax(HexaVal a) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(a)) return out;\n"
    buf = buf + "    int64_t n = (int64_t)HX_ARR_LEN(a);\n"
    buf = buf + "    if (n == 0) return out;\n"
    buf = buf + "    double m = __hx_to_double(hexa_array_get(a, 0));\n"
    buf = buf + "    for (int64_t i = 1; i < n; i++) {\n"
    buf = buf + "        double v = __hx_to_double(hexa_array_get(a, i));\n"
    buf = buf + "        if (v > m) m = v;\n"
    buf = buf + "    }\n"
    buf = buf + "    double sum = 0.0;\n"
    buf = buf + "    double* tmp = (double*)malloc(sizeof(double) * (size_t)n);\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        double v = __hx_to_double(hexa_array_get(a, i));\n"
    buf = buf + "        tmp[i] = hxlcl_exp(v - m);\n"
    buf = buf + "        sum += tmp[i];\n"
    buf = buf + "    }\n"
    buf = buf + "    double inv = sum > 0.0 ? 1.0 / sum : 0.0;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) out = hexa_array_push(out, hexa_float(tmp[i] * inv));\n"
    buf = buf + "    free(tmp);\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_softmax(HexaVal a);\n"
    buf = buf + "HexaVal hexa_softmax(HexaVal a) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(a)) return hexa_array_new();\n"
    buf = buf + "    return rt_softmax(a);\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// matmul(A, B, M, N, K): row-major C[M*N] = A[M*K] @ B[K*N], naive O(M*N*K).\n"
    buf = buf + "// Positional arg order is cblas-style (M, N, K) — output rows, output cols,\n"
    buf = buf + "// contraction dim — verified empirically (B3, commit 9fb47758): the call\n"
    buf = buf + "// `matmul([1..6],[1..6], 2, 2, 3)` yields the 2×2 product `[22,28,49,64]`\n"
    buf = buf + "// (A treated as 2×3, B as 3×2). Internal locals `m/k/n` below are kept for\n"
    buf = buf + "// historical reasons; the load-bearing convention is the (M, N, K) caller\n"
    buf = buf + "// order documented here. See stdlib/linalg/ffi.hexa for the caller-side\n"
    buf = buf + "// mirror of this contract.\n"
    buf = buf + "// Step-3 cycle 19 port.\n"
    buf = buf + "#ifndef HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "HexaVal hexa_matmul(HexaVal a, HexaVal b, HexaVal mv, HexaVal kv, HexaVal nv) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(a) || !HX_IS_ARRAY(b)) return out;\n"
    buf = buf + "    int64_t m = (int64_t)__hx_to_double(mv);\n"
    buf = buf + "    int64_t k = (int64_t)__hx_to_double(kv);\n"
    buf = buf + "    int64_t n = (int64_t)__hx_to_double(nv);\n"
    buf = buf + "    if (m < 0 || k < 0 || n < 0) return out;\n"
    buf = buf + "    int64_t alen = (int64_t)HX_ARR_LEN(a), blen = (int64_t)HX_ARR_LEN(b);\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    for (int64_t i = 0; i < m; i++) {\n"
    buf = buf + "        for (int64_t j = 0; j < n; j++) {\n"
    buf = buf + "            double s = 0.0;\n"
    buf = buf + "            for (int64_t p = 0; p < k; p++) {\n"
    buf = buf + "                int64_t ai = i * k + p;\n"
    buf = buf + "                int64_t bi = p * n + j;\n"
    buf = buf + "                if (ai >= alen || bi >= blen) continue;\n"
    buf = buf + "                s += __hx_to_double(hexa_array_get(a, ai)) *\n"
    buf = buf + "                     __hx_to_double(hexa_array_get(b, bi));\n"
    buf = buf + "            }\n"
    buf = buf + "            out = hexa_array_push(out, hexa_float(s));\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "#else\n"
    buf = buf + "extern HexaVal rt_matmul(HexaVal a, HexaVal b, HexaVal m, HexaVal k, HexaVal n);\n"
    buf = buf + "HexaVal hexa_matmul(HexaVal a, HexaVal b, HexaVal mv, HexaVal kv, HexaVal nv) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(a) || !HX_IS_ARRAY(b)) return hexa_array_new();\n"
    buf = buf + "    int64_t m = (int64_t)__hx_to_double(mv);\n"
    buf = buf + "    int64_t k = (int64_t)__hx_to_double(kv);\n"
    buf = buf + "    int64_t n = (int64_t)__hx_to_double(nv);\n"
    buf = buf + "    return rt_matmul(a, b, hexa_int(m), hexa_int(k), hexa_int(n));\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// Base64 (RFC 4648)\n"
    buf = buf + "static const char _b64_enc[] =\n"
    buf = buf + "    \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_base64_encode(HexaVal s) {\n"
    buf = buf + "    if (!HX_IS_STR(s) || !HX_STR(s)) return hexa_str(\"\");\n"
    buf = buf + "    const unsigned char* in = (const unsigned char*)HX_STR(s);\n"
    buf = buf + "    size_t n = HX_STRLEN(s);\n"
    buf = buf + "    size_t olen = 4 * ((n + 2) / 3);\n"
    buf = buf + "    char* out = (char*)malloc(olen + 1);\n"
    buf = buf + "    size_t i = 0, j = 0;\n"
    buf = buf + "    while (i + 3 <= n) {\n"
    buf = buf + "        uint32_t t = (in[i] << 16) | (in[i+1] << 8) | in[i+2];\n"
    buf = buf + "        out[j++] = _b64_enc[(t >> 18) & 0x3F];\n"
    buf = buf + "        out[j++] = _b64_enc[(t >> 12) & 0x3F];\n"
    buf = buf + "        out[j++] = _b64_enc[(t >> 6) & 0x3F];\n"
    buf = buf + "        out[j++] = _b64_enc[t & 0x3F];\n"
    buf = buf + "        i += 3;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (i < n) {\n"
    buf = buf + "        uint32_t t = in[i] << 16;\n"
    buf = buf + "        int rem = (int)(n - i);\n"
    buf = buf + "        if (rem == 2) t |= in[i+1] << 8;\n"
    buf = buf + "        out[j++] = _b64_enc[(t >> 18) & 0x3F];\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "        out[j++] = _b64_enc[(t >> 12) & 0x3F];\n"
    buf = buf + "        out[j++] = (rem == 2) ? _b64_enc[(t >> 6) & 0x3F] : '=';\n"
    buf = buf + "        out[j++] = '=';\n"
    buf = buf + "    }\n"
    buf = buf + "    out[j] = 0;\n"
    buf = buf + "    return hexa_str_own(out);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_base64_decode(HexaVal s) {\n"
    buf = buf + "    if (!HX_IS_STR(s) || !HX_STR(s)) return hexa_str(\"\");\n"
    buf = buf + "    static int dec[256];\n"
    buf = buf + "    static int dec_init = 0;\n"
    buf = buf + "    if (!dec_init) {\n"
    buf = buf + "        for (int i = 0; i < 256; i++) dec[i] = -1;\n"
    buf = buf + "        for (int i = 0; i < 64; i++) dec[(unsigned char)_b64_enc[i]] = i;\n"
    buf = buf + "        dec_init = 1;\n"
    buf = buf + "    }\n"
    buf = buf + "    const unsigned char* in = (const unsigned char*)HX_STR(s);\n"
    buf = buf + "    size_t n = HX_STRLEN(s);\n"
    buf = buf + "    char* out = (char*)malloc(n + 1);\n"
    buf = buf + "    size_t j = 0;\n"
    buf = buf + "    int bits = 0, vbits = 0;\n"
    buf = buf + "    for (size_t i = 0; i < n; i++) {\n"
    buf = buf + "        if (in[i] == '=') break;\n"
    buf = buf + "        int v = dec[in[i]];\n"
    buf = buf + "        if (v < 0) continue;\n"
    buf = buf + "        bits = (bits << 6) | v;\n"
    buf = buf + "        vbits += 6;\n"
    buf = buf + "        if (vbits >= 8) {\n"
    buf = buf + "            vbits -= 8;\n"
    buf = buf + "            out[j++] = (char)((bits >> vbits) & 0xFF);\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    out[j] = 0;\n"
    buf = buf + "    return hexa_str_own(out);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ── bt 73: bare-ident HexaVal globals for transpiled builtin dispatch ──\n"
    buf = buf + "// Self-host codegen (self/native/hexa_cc.c gen2_expr Call fallback, ~line 5642+)\n"
    buf = buf + "// emits `hexa_call0(timestamp)`, `hexa_call1(base64_encode, s)`, … where the\n"
    buf = buf + "// callee is a BARE C identifier. For the linker to resolve these, each name\n"
    buf = buf + "// must exist as a `HexaVal` variable holding a TAG_FN that wraps the real\n"
    buf = buf + "// implementation. bt 71 supplied the hexa_*-prefixed C functions; this block\n"
    buf = buf + "// wires them to the bare names the transpiler expects.\n"
    buf = buf + "//\n"
    buf = buf + "// hexa_call0/hexa_call1 (defined above in this file) already branch on\n"
    buf = buf + "// TAG_FN and cast fn_ptr to `HexaVal (*)(…)`, so HexaVal-returning wrappers\n"
    buf = buf + "// with matching arity work directly.\n"
    buf = buf + "//\n"
    buf = buf + "// Wrapper for `timestamp` — hexa_timestamp is declared above without params;\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// expose under the void→HexaVal signature hexa_call0 expects.\n"
    buf = buf + "static HexaVal _bt73_timestamp_w(void) { return hexa_timestamp(); }\n"
    buf = buf + "static HexaVal _bt73_base64_encode_w(HexaVal s) { return hexa_base64_encode(s); }\n"
    buf = buf + "static HexaVal _bt73_base64_decode_w(HexaVal s) { return hexa_base64_decode(s); }\n"
    buf = buf + "// RFC 6455 WebSocket handshake (2026-05-23): bare-ident bootstrap bridge\n"
    buf = buf + "// for `sha1` / `sha1_bytes`. The codegen.hexa sha1 arm emits hexa_sha1(...)\n"
    buf = buf + "// directly AFTER a hexat regen; until then the baked transpiler emits\n"
    buf = buf + "// hexa_call1(sha1, ...) (generic bare-ident fallback), so these TAG_FN\n"
    buf = buf + "// globals let the linker resolve the symbol meanwhile — exactly the\n"
    buf = buf + "// pattern base64_encode uses. hexa_sha1 / hexa_sha1_bytes live in\n"
    buf = buf + "// native/exec_argv_sha256.c, #include'd near the bottom of this file —\n"
    buf = buf + "// forward-declare here so the wrappers type-check (runtime.c is compiled\n"
    buf = buf + "// without runtime.h preceding it).\n"
    buf = buf + "HexaVal hexa_sha1(HexaVal s_val);\n"
    buf = buf + "HexaVal hexa_sha1_bytes(HexaVal s_val);\n"
    buf = buf + "static HexaVal _bt73_sha1_w(HexaVal s) { return hexa_sha1(s); }\n"
    buf = buf + "static HexaVal _bt73_sha1_bytes_w(HexaVal s) { return hexa_sha1_bytes(s); }\n"
    buf = buf + "// interp bootstrap gap: hexat (already-baked transpiler) doesn't know\n"
    buf = buf + "// about setenv / exec_capture, so the interpreter dispatch in hexa_full.hexa\n"
    buf = buf + "// resolves bare `setenv(...)` through hexa_call2 / `exec_capture(...)` via\n"
    buf = buf + "// hexa_call1. Shim these as TAG_FN globals so the linker finds them.\n"
    buf = buf + "static HexaVal _w_setenv(HexaVal n, HexaVal v) { return hexa_setenv(n, v); }\n"
    buf = buf + "static HexaVal _w_exec_capture(HexaVal c) { return hexa_exec_capture(c); }\n"
    buf = buf + "// PROBE r8 3-tuple bridge: codegen.hexa emits hexa_exec_with_status3(...)\n"
    buf = buf + "// AFTER a hexat regen; until then the baked transpiler resolves bare\n"
    buf = buf + "// `exec_with_status3(...)` through hexa_call1, so this TAG_FN global lets\n"
    buf = buf + "// the linker resolve the symbol meanwhile (same pattern as sha1 / exec_capture).\n"
    buf = buf + "HexaVal hexa_exec_with_status3(HexaVal cmd);\n"
    buf = buf + "static HexaVal _w_exec_with_status3(HexaVal c) { return hexa_exec_with_status3(c); }\n"
    buf = buf + "static HexaVal _w_push(HexaVal a, HexaVal v) { return hexa_array_push(a, v); }\n"
    buf = buf + "\n"
    buf = buf + "HexaVal timestamp;\n"
    buf = buf + "HexaVal base64_encode;\n"
    buf = buf + "HexaVal base64_decode;\n"
    buf = buf + "HexaVal sha1;\n"
    buf = buf + "HexaVal sha1_bytes;\n"
    buf = buf + "// Names intentionally prefixed — plain `setenv` would clobber the libc\n"
