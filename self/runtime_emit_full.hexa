    buf = buf + "    return (int)_hxlcl_lx_sc4(61, (long)pid, (long)status, (long)options, 0L);\n"
    buf = buf + "#elif defined(__aarch64__)\n"
    buf = buf + "    return (int)_hxlcl_lx_sc4(260, (long)pid, (long)status, (long)options, 0L);\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "/* variadic to handle both 2-arg and 3-arg open() callers (matches arm64). */\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_open_sys(const char *path, int flags, ...) {\n"
    buf = buf + "    int mode = 0;\n"
    buf = buf + "    va_list ap;\n"
    buf = buf + "    va_start(ap, flags);\n"
    buf = buf + "    mode = va_arg(ap, int);\n"
    buf = buf + "    va_end(ap);\n"
    buf = buf + "#if defined(__x86_64__)\n"
    buf = buf + "    return (int)_hxlcl_lx_sc3(2, (long)path, (long)flags, (long)mode);\n"
    buf = buf + "#elif defined(__aarch64__)\n"
    buf = buf + "    return (int)_hxlcl_lx_sc4(56, (long)AT_FDCWD, (long)path, (long)flags, (long)mode);\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_fstat(int fd, void *buf) { return fstat(fd, (struct stat *)buf); }\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_stat(const char *path, void *buf) { return stat(path, (struct stat *)buf); }\n"
    buf = buf + "static void __attribute__((noinline, noreturn)) hxlcl_exit(int code) {\n"
    buf = buf + "    _exit(code);\n"
    buf = buf + "}\n"
    buf = buf + "static void *__attribute__((noinline)) hxlcl_mmap(void *addr, unsigned long len, int prot, int flags, int fd, long off) { return mmap(addr, (size_t)len, prot, flags, fd, (off_t)off); }\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_clock_gettime(int clk, void *ts) {\n"
    buf = buf + "#if defined(__x86_64__)\n"
    buf = buf + "    return (int)_hxlcl_lx_sc2(228, (long)clk, (long)ts);\n"
    buf = buf + "#elif defined(__aarch64__)\n"
    buf = buf + "    return (int)_hxlcl_lx_sc2(113, (long)clk, (long)ts);\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_darwin_check_fd_set_overflow(int fd, const void *p, int n) {\n"
    buf = buf + "    (void)fd; (void)p; (void)n;\n"
    buf = buf + "    return 0;  // never overflowing\n"
    buf = buf + "}\n"
    buf = buf + "// linux-branch parity for primitives the arm64-darwin block added (cycle 82\n"
    buf = buf + "// raw-trap mkdir; cycle 86 naked-asm setjmp/longjmp) but never mirrored here.\n"
    buf = buf + "// runtime_core.c calls hxlcl_mkdir + hxlcl_longjmp unconditionally and the\n"
    buf = buf + "// transpiled driver calls hxlcl_setjmp, so without these the Linux build fails\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// to compile/link. Route through libc / compiler builtins.\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_mkdir(const char *path, int mode) {\n"
    buf = buf + "#if defined(__x86_64__)\n"
    buf = buf + "    return (int)_hxlcl_lx_sc2(83, (long)path, (long)mode);\n"
    buf = buf + "#elif defined(__aarch64__)\n"
    buf = buf + "    return (int)_hxlcl_lx_sc3(34, (long)AT_FDCWD, (long)path, (long)mode);\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "// The linux codegen emits libc `jmp_buf __jb; setjmp(__jb)` for try blocks and\n"
    buf = buf + "// pushes &__jb onto __hexa_try_stack; hexa_throw then calls hxlcl_longjmp(&__jb,\n"
    buf = buf + "// val). So hxlcl_longjmp MUST be a libc longjmp on that very jmp_buf — an earlier\n"
    buf = buf + "// __builtin_longjmp attempt segfaulted because it expects a __builtin_setjmp\n"
    buf = buf + "// buffer (incompatible layout). hxlcl_setjmp mirrors as a libc-setjmp macro\n"
    buf = buf + "// (call-site expansion, not a wrapper fn) for any non-codegen caller; the linux\n"
    buf = buf + "// codegen path itself uses libc setjmp directly and does not reference it.\n"
    buf = buf + "#include <setjmp.h>\n"
    buf = buf + "#if defined(__x86_64__)\n"
    buf = buf + "// RFC061 §M8 re-baseline (ING#29 ∅−8): native musl-layout x86_64 setjmp/\n"
    buf = buf + "// longjmp pair. Real GLOBAL symbols (no longer a libc-setjmp macro + a\n"
    buf = buf + "// static glibc longjmp) so the linux-x86_64 codegen try-block SAVE\n"
    buf = buf + "// (`call hxlcl_setjmp`, compiler/codegen/x86_64_linux.hexa) and the\n"
    buf = buf + "// hexa_throw RESTORE (`call hxlcl_longjmp`) BOTH use the SAME 64-B musl\n"
    buf = buf + "// jmp_buf ([0]=rbx [8]=rbp [16]=r12 [24]=r13 [32]=r14 [40]=r15 [48]=rsp\n"
    buf = buf + "// [56]=rip), with NO glibc PTR_MANGLE. .text is byte-id to musl\n"
    buf = buf + "// src/setjmp/x86_64/{setjmp,longjmp}.S (objdump-verified, #4218). Pairs\n"
    buf = buf + "// with the darwin-arm64 native pair above; dissolves the last glibc\n"
    buf = buf + "// setjmp/longjmp dependency on linux-x86_64 (the M3 mixed-ABI SEGV wall).\n"
    buf = buf + "__asm__(\n"
    buf = buf + "\".text\\n\"\n"
    buf = buf + "\".globl hxlcl_setjmp\\n\"\n"
    buf = buf + "\".type hxlcl_setjmp,@function\\n\"\n"
    buf = buf + "\"hxlcl_setjmp:\\n\"\n"
    buf = buf + "\"  movq %rbx, (%rdi)\\n\"\n"
    buf = buf + "\"  movq %rbp, 8(%rdi)\\n\"\n"
    buf = buf + "\"  movq %r12, 16(%rdi)\\n\"\n"
    buf = buf + "\"  movq %r13, 24(%rdi)\\n\"\n"
    buf = buf + "\"  movq %r14, 32(%rdi)\\n\"\n"
    buf = buf + "\"  movq %r15, 40(%rdi)\\n\"\n"
    buf = buf + "\"  leaq 8(%rsp), %rdx\\n\"\n"
    buf = buf + "\"  movq %rdx, 48(%rdi)\\n\"\n"
    buf = buf + "\"  movq (%rsp), %rdx\\n\"\n"
    buf = buf + "\"  movq %rdx, 56(%rdi)\\n\"\n"
    buf = buf + "\"  xorl %eax, %eax\\n\"\n"
    buf = buf + "\"  ret\\n\"\n"
    buf = buf + "\".globl hxlcl_longjmp\\n\"\n"
    buf = buf + "\".type hxlcl_longjmp,@function\\n\"\n"
    buf = buf + "\"hxlcl_longjmp:\\n\"\n"
    buf = buf + "\"  movl %esi, %eax\\n\"\n"
    buf = buf + "\"  testl %eax, %eax\\n\"\n"
    buf = buf + "\"  jnz 1f\\n\"\n"
    buf = buf + "\"  incl %eax\\n\"\n"
    buf = buf + "\"1:\\n\"\n"
    buf = buf + "\"  movq (%rdi), %rbx\\n\"\n"
    buf = buf + "\"  movq 8(%rdi), %rbp\\n\"\n"
    buf = buf + "\"  movq 16(%rdi), %r12\\n\"\n"
    buf = buf + "\"  movq 24(%rdi), %r13\\n\"\n"
    buf = buf + "\"  movq 32(%rdi), %r14\\n\"\n"
    buf = buf + "\"  movq 40(%rdi), %r15\\n\"\n"
    buf = buf + "\"  movq 48(%rdi), %rsp\\n\"\n"
    buf = buf + "\"  movq 56(%rdi), %rdx\\n\"\n"
    buf = buf + "\"  jmp *%rdx\\n\"\n"
    buf = buf + ");\n"
    buf = buf + "int  hxlcl_setjmp(void *buf) __attribute__((returns_twice));\n"
    buf = buf + "void hxlcl_longjmp(void *buf, int val) __attribute__((noreturn));\n"
    buf = buf + "#else\n"
    buf = buf + "// arm64-linux (and any other non-x86_64 linux arch): keep the libc-setjmp\n"
    buf = buf + "// macro + glibc longjmp wrapper unchanged — byteeq-neutral on those targets.\n"
    buf = buf + "#define hxlcl_setjmp(buf) setjmp(*(jmp_buf *)(buf))\n"
    buf = buf + "static void __attribute__((noinline, noreturn)) hxlcl_longjmp(void *buf, int val) {\n"
    buf = buf + "    longjmp(*(jmp_buf *)buf, val ? val : 1);\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    buf = buf + "// getuid + the OOB-trace backtrace stubs (arm64-darwin defines these via the\n"
    buf = buf + "// raw-trap / hexa-native-stub path; mirror on Linux). backtrace is a no-op\n"
    buf = buf + "// stub on both platforms (a self-host binary has no frame walker); getuid\n"
    buf = buf + "// routes through libc.\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_getuid(void) {\n"
    buf = buf + "    return (int)getuid();  // <unistd.h> included above\n"
    buf = buf + "}\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_backtrace(void **buf, int sz) {\n"
    buf = buf + "    (void)buf; (void)sz;\n"
    buf = buf + "    return 0;  // 0 frames captured — hexa-native stub, no real unwinder\n"
    buf = buf + "}\n"
    buf = buf + "static void __attribute__((noinline)) hxlcl_backtrace_symbols_fd(void *const *buf, int sz, int fd) {\n"
    buf = buf + "    (void)buf; (void)sz;\n"
    buf = buf + "    static const char msg[] = \"(backtrace unavailable — hexa-native stub)\\n\";\n"
    buf = buf + "    (void)hxlcl_write(fd, msg, sizeof(msg) - 1);  // raw-svc write\n"
    buf = buf + "}\n"
    buf = buf + "#endif  /* darwin-arm64 raw-trap / linux libc */\n"
    buf = buf + "// zero-c #29: pure-C integer→decimal formatters (no libc). Replace snprintf\n"
    buf = buf + "// \"%lld\"/\"%d\"/\"%zu\" int-format call sites with deterministic digit extraction\n"
    buf = buf + "// (byteeq-safe: integer arithmetic only · INT64_MIN-safe via the -(v+1)+1 trick).\n"
    buf = buf + "static int _hx_u64_dec(char *out, unsigned long long u) {\n"
    buf = buf + "    char t[24]; int ti = 0;\n"
    buf = buf + "    do { t[ti++] = (char)('0' + (int)(u % 10ull)); u /= 10ull; } while (u);\n"
    buf = buf + "    int n = 0;\n"
    buf = buf + "    while (ti) out[n++] = t[--ti];\n"
    buf = buf + "    out[n] = 0;\n"
    buf = buf + "    return n;\n"
    buf = buf + "}\n"
    buf = buf + "static int _hx_i64_dec(char *out, long long v) {\n"
    buf = buf + "    if (v < 0) { out[0] = '-'; return 1 + _hx_u64_dec(out + 1, (unsigned long long)(-(v + 1)) + 1ull); }\n"
    buf = buf + "    return _hx_u64_dec(out, (unsigned long long)v);\n"
    buf = buf + "}\n"
    buf = buf + "// zero-c #29: hardware sqrt (no libc sqrt@GLIBC, no Newton). The HW instruction\n"
    buf = buf + "// (x86_64 sqrtsd · aarch64 fsqrt) is correctly-rounded IEEE — byte-identical to\n"
    buf = buf + "// libc sqrt for finite x>=0, deterministic across targets (byteeq-safe), and is\n"
    buf = buf + "// what libc sqrt itself executes (zero perf cost vs the call). Replaces direct\n"
    buf = buf + "// libc sqrt() in optim/norm kernels (Adam denom · RMSNorm · LayerNorm · gelu).\n"
    buf = buf + "double _hx_sqrt(double x) {  // external linkage: in-TU calls still inline at -O2; cross-TU (runtime_core.c value-ops) link to the symbol\n"
    buf = buf + "#if defined(__x86_64__)\n"
    buf = buf + "    double r; __asm__(\"sqrtsd %1, %0\" : \"=x\"(r) : \"x\"(x)); return r;\n"
    buf = buf + "#elif defined(__aarch64__)\n"
    buf = buf + "    double r; __asm__(\"fsqrt %d0, %d1\" : \"=w\"(r) : \"w\"(x)); return r;\n"
    buf = buf + "#else\n"
    buf = buf + "    return __builtin_sqrt(x);\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "// zero-c #29: accurate cos/sin — reference-match musl src/math/__cos.c /__sin.c\n"
