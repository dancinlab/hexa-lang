    buf = buf + "    if (timeout >= 0) { _ts.tv_sec = timeout / 1000; _ts.tv_nsec = (long)(timeout % 1000) * 1000000L; _tsp = &_ts; }\n"
    buf = buf + "    return (int)_hxlcl_lx_sc5(73, (long)fds, (long)nfds, (long)_tsp, 0L, 0L);\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "static int __attribute__((noinline)) hxlcl_waitpid(int pid, int *status, int options) {\n"
