    buf = buf + "    return arr;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// FIX-A 2nd batch (2026-04-19): swiglu_vec(gate, up) = silu(gate) * up elementwise.\n"
    buf = buf + "// silu(x) = x / (1 + exp(-x)). Shape: min(|gate|, |up|). For anima eval_alm.hexa\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "// + training hot paths (nn_core etc.) — scalar fallback, fast-path is FFN fused kernel.\n"
    buf = buf + "HexaVal hexa_swiglu_vec(HexaVal gate, HexaVal up) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(gate) || !HX_IS_ARRAY(up)) return out;\n"
    buf = buf + "    int64_t ng = (int64_t)HX_ARR_LEN(gate), nu = (int64_t)HX_ARR_LEN(up);\n"
    buf = buf + "    int64_t k = ng < nu ? ng : nu;\n"
    buf = buf + "    for (int64_t i = 0; i < k; i++) {\n"
    buf = buf + "        double g = __hx_to_double(hexa_array_get(gate, i));\n"
    buf = buf + "        double u = __hx_to_double(hexa_array_get(up, i));\n"
    buf = buf + "        double silu = g / (1.0 + hxlcl_exp(-g));\n"
