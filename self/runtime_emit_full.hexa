    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "#else\n"
    buf = buf + "static long __attribute__((noinline)) hxlcl_send(int s, const void *b, unsigned long n, int f) {\n"
