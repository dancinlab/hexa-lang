    buf = buf + "HexaVal farr_attn_dt_bwd_gpu(HexaVal q_v, HexaVal k_v, HexaVal v_v,\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "                             HexaVal p_v, HexaVal dctx_v, HexaVal dq_v,\n"
