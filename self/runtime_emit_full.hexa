    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// tensor_add(a, b): elementwise a[i] + b[i], length = min(|a|, |b|).\n"
    buf = buf + "HexaVal hexa_tensor_add(HexaVal a, HexaVal b) {\n"
