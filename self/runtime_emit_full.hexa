    buf = buf + "    farr_silu_gate_gpu              = hexa_fn_new((void*)hexa_farr_silu_gate_gpu,              3);\n"
    buf = buf + "    // BC-ANIMA M2 (2026-05-28): 4-arg in-place row-softmax (V=151643\n"
    buf = buf + "    // anima trainer hot path — preallocated `out` removes per-step\n"
    buf = buf + "    // hexa_farr_zeros from a 29M-double softmax over the vocab).\n"
    buf = buf + "    farr_softmax_rows               = hexa_fn_new((void*)hexa_farr_softmax_rows,               4);\n"
    buf = buf + "    // mk2-closure port (rfc043-flame-camp c2689508 + c42ac263, 2026-05-19):\n"
    buf = buf + "    // 3-arg C5 batch builtins use HexaVal carrier + hexa_fn_new (codegen\n"
    buf = buf + "    // emits hexa_call3, dispatched via the carrier — same pattern as\n"
