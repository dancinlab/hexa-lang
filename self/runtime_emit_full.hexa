    buf = buf + "\n"
    buf = buf + "// mk2-C1b (2026-05-19): farr_silu_gate_gpu(a, b, n) -> int new\n"
    buf = buf + "// farr_id. O = (A·σ(A))·B, σ=1/(1+dt_exp(-x)). On no-CUDA: routes\n"
    buf = buf + "// to _hx_farr_silu_gate_cpu (dt_exp-faithful, byte-id to\n"
    buf = buf + "// ag_tape.hexa _ag_silu(a)*b). On HEXA_CUDA: _hx_cuda_farr_silu_\n"
    buf = buf + "// gate_gpu (dt_exp-faithful device kernel, byte-eq oracle-gated).\n"
    buf = buf + "HexaVal hexa_farr_silu_gate_gpu(HexaVal a_v, HexaVal b_v, HexaVal n_v) {\n"
    buf = buf + "    int64_t a_id = hexa_as_num(a_v);\n"
    buf = buf + "    int64_t b_id = hexa_as_num(b_v);\n"
    buf = buf + "    int64_t n    = hexa_as_num(n_v);\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    if buf.len() > 65536 { _flush_runtime(out_path, buf); buf = "" }
    buf = buf + "    if (n <= 0) return hexa_int(-1);\n"
    buf = buf + "    if (a_id < 0 || a_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    if (b_id < 0 || b_id >= _hx_farr_count) return hexa_int(-1);\n"
    buf = buf + "    HexaVal out_h = hexa_farr_zeros(hexa_int(n));\n"
    buf = buf + "    int64_t out_id = hexa_as_num(out_h);\n"
    buf = buf + "    if (out_id < 0) return hexa_int(-1);\n"
    buf = buf + "    int rc = _hx_cuda_farr_silu_gate_gpu(a_id, b_id, n, out_id);\n"
