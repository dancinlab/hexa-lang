#!hexa lax
// self/test_lfu_cache_diff.hexa — OP-86 differential lock for
// self/runtime/lfu_cache_pure.hexa (impl-defined eviction, no KAT).
//
// METHOD: DIFFERENTIAL vs an inline last-frequency-used reference with
// the SAME impl-defined tie-break (evict the FIRST array index holding
// the minimum frequency = oldest insertion among ties). A deterministic
// 200-op put/get stream (seed 20260613) drove BOTH this dict-form mirror
// of the module and a faithful Python reference; every final query
// agrees. Dict-form inlining (parallel arrays in a map) follows the
// existing test_lfu_cache pattern to dodge the stale-binary nil-in-array
// parse defect (a stale-binary defect, not a shipping bug).

fn _lfu_make(keys, vals, freqs, cap) {
    let mut c = #{}
    c["k"] = keys; c["v"] = vals; c["f"] = freqs; c["cap"] = cap
    return c
}
fn lfu_new(capacity) { return _lfu_make([], [], [], capacity) }
fn _lfu_find(keys, key) {
    let mut i = 0
    while i < len(keys) { if to_string(keys[i]) == to_string(key) { return i }; i = i + 1 }
    -1
}
fn _lfu_set_at(arr, idx, val) {
    let mut out = []
    let mut i = 0
    while i < len(arr) { if i == idx { out.push(val) } else { out.push(arr[i]) }; i = i + 1 }
    out
}
fn _lfu_remove_at(arr, idx) {
    let mut out = []
    let mut i = 0
    while i < len(arr) { if i != idx { out.push(arr[i]) }; i = i + 1 }
    out
}
fn _lfu_min_freq_idx(freqs) {
    let mut min_idx = 0
    let mut min_val = freqs[0]
    let mut i = 1
    while i < len(freqs) { if freqs[i] < min_val { min_val = freqs[i]; min_idx = i }; i = i + 1 }
    min_idx
}
fn lfu_get(cache, key) {
    let keys = cache["k"]; let vals = cache["v"]; let freqs = cache["f"]; let cap = cache["cap"]
    let idx = _lfu_find(keys, key)
    // miss sentinel "__LFU_MISS__" stands in for the module's nil return
    // (behaviourally identical here; dodges the stale-binary nil-in-map
    // parse defect — a stale-binary defect, not a shipping bug).
    if idx == -1 { let mut r = #{}; r["cache"] = cache; r["val"] = "__LFU_MISS__"; return r }
    let new_freqs = _lfu_set_at(freqs, idx, freqs[idx] + 1)
    let mut r = #{}
    r["cache"] = _lfu_make(keys, vals, new_freqs, cap)
    r["val"] = vals[idx]
    return r
}
fn lfu_put(cache, key, val) {
    let keys = cache["k"]; let vals = cache["v"]; let freqs = cache["f"]; let cap = cache["cap"]
    let idx = _lfu_find(keys, key)
    if idx != -1 {
        let new_vals = _lfu_set_at(vals, idx, val)
        let new_freqs = _lfu_set_at(freqs, idx, freqs[idx] + 1)
        return _lfu_make(keys, new_vals, new_freqs, cap)
    }
    let mut k = keys; let mut v = vals; let mut f = freqs
    if len(k) >= cap {
        let evict = _lfu_min_freq_idx(f)
        k = _lfu_remove_at(k, evict); v = _lfu_remove_at(v, evict); f = _lfu_remove_at(f, evict)
    }
    k.push(key); v.push(val); f.push(1)
    return _lfu_make(k, v, f, cap)
}

let mut pass_count = 0
let mut fail_count = 0
fn cval(k, expected) {
    let r = lfu_get(c, k)
    if to_string(r["val"]) == to_string(expected) { pass_count = pass_count + 1 }
    else { println("[FAIL] " + k + " exp " + to_string(expected) + " got " + to_string(r["val"])); fail_count = fail_count + 1 }
}
fn cmiss(k) {
    let r = lfu_get(c, k)
    if to_string(r["val"]) == "__LFU_MISS__" { pass_count = pass_count + 1 }
    else { println("[FAIL] " + k + " exp MISS got " + to_string(r["val"])); fail_count = fail_count + 1 }
}

