// c7_recursion_arrays.hexa — miscompile class: recursion + array index/assign.
// In-place quicksort over a global mutable array: array load (arr[i]), array
// store (arr[i] = v), index arithmetic, and self-recursive calls. This is the
// n5sym index/slice codegen primitive under recursion — a wrong index lowering
// or a clobbered callee-saved across the recursive call would corrupt the sort
// AND historically surfaced as a spurious udf at the load site.
// Added by the MISCOMPILE-ZERO broad sweep (82-program clean sweep, 2026-06-02).

let mut arr = [5, 2, 8, 1, 9, 3, 7, 4, 6, 0]
let N = 10

fn swap(i, j) {
    let t = arr[i]
    arr[i] = arr[j]
    arr[j] = t
}

fn partition(lo, hi) {
    let pivot = arr[hi]
    let mut i = lo - 1
    let mut j = lo
    while j < hi {
        if arr[j] <= pivot {
            i = i + 1
            let _s = swap(i, j)
        }
        j = j + 1
    }
    let _s = swap(i + 1, hi)
    return i + 1
}

fn qs(lo, hi) {
    if lo < hi {
        let p = partition(lo, hi)
        let _a = qs(lo, p - 1)
        let _b = qs(p + 1, hi)
    }
    return 0
}

let _r = qs(0, N - 1)
println("first:", arr[0])
println("last:", arr[N - 1])
