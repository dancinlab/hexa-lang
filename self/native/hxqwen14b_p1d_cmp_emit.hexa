#!hexa strict
// hxqwen14b_p1d_cmp_emit.hexa
//   B9.C (.c-text · #1850 pattern) — hxqwen14b_p1d_cmp.c source emitter.
//
// hxqwen14b p1/d cmp bench (selfhost final6, ING #29)
//
// Emits hxqwen14b_p1d_cmp.c VERBATIM. The hexa build regenerates the .c from
// this emitter before compiling, so the emitter becomes the SSOT and the
// .c becomes a build artifact. Byte-identity (gate-1 source-SHA, proven by
// hxqwen14b_p1d_cmp_byte_diff.hexa) ⇒ identical .o/.so ⇒ PERF UNCHANGED.
//
// GENERATED by tool/gen_c_text_emitter.hexa — do not hand-edit; re-run the
// generator against the hand-written .c if it ever changes.
//
// Invocation:  hexa-run hxqwen14b_p1d_cmp_emit.hexa <output-path>
// Default output path (if argv missing): "hxqwen14b_p1d_cmp.c" in cwd.

let MODULE_NAME = "hxqwen14b_p1d_cmp_emit"

fn _flush_hxqwen14b_p1d_cmp(out_path: str, buf: str) {
    let _ = exec("cat >> \"" + out_path + "\" <<'GEN_hxqwen14b_p1d_cmp_EOF'\n" + buf + "GEN_hxqwen14b_p1d_cmp_EOF")
}

fn emit_hxqwen14b_p1d_cmp_to(out_path: str) {
    // Verbatim content of hand-written self/native/hxqwen14b_p1d_cmp.c, streamed in
    // size-bounded chunks (see generator note on the per-command exec limit).
    let _ = exec("printf '' > \"" + out_path + "\"")
    let mut buf = ""
    buf = buf + "// hxqwen14b_p1d_cmp.c — compare two p1d_driver dumps (oracle vs own GEMM).\n"
    buf = buf + "// Reports per-output (y, dA, dB, dx) max|Δ| and max rel error, then PASS/FAIL\n"
    buf = buf + "// against an fp32 tolerance (default 1e-4 rel, override TOL env).\n"
    buf = buf + "//\n"
    buf = buf + "//   cc -O2 hxqwen14b_p1d_cmp.c -lm -o p1d_cmp\n"
    buf = buf + "//   ./p1d_cmp oracle.bin own.bin\n"
    buf = buf + "\n"
    buf = buf + "#include <stdio.h>\n"
    buf = buf + "#include <stdlib.h>\n"
    buf = buf + "#include <stdint.h>\n"
    buf = buf + "#include <math.h>\n"
    buf = buf + "\n"
    buf = buf + "static float* slurp(const char* path, int64_t hdr[4], int64_t* total) {\n"
    buf = buf + "    FILE* f = fopen(path,\"rb\");\n"
    buf = buf + "    if (!f){ fprintf(stderr,\"open %s fail\\n\",path); exit(2); }\n"
    buf = buf + "    if (fread(hdr,sizeof(int64_t),4,f)!=4){ fprintf(stderr,\"hdr read fail %s\\n\",path); exit(2);}\n"
    buf = buf + "    int64_t n = hdr[0]+hdr[1]+hdr[2]+hdr[3];\n"
    buf = buf + "    float* p = (float*)malloc(n*sizeof(float));\n"
    buf = buf + "    if (fread(p,sizeof(float),n,f)!=(size_t)n){ fprintf(stderr,\"data read fail %s\\n\",path); exit(2);}\n"
    buf = buf + "    fclose(f); *total=n; return p;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "static void cmp_block(const char* name, const float* a, const float* b, int64_t n,\n"
    buf = buf + "                      double* gmaxabs, int* fail, double tol) {\n"
    buf = buf + "    double maxabs=0.0, maxrel=0.0;\n"
    buf = buf + "    for (int64_t i=0;i<n;i++){\n"
    buf = buf + "        double d = fabs((double)a[i]-(double)b[i]);\n"
    buf = buf + "        double denom = fabs((double)a[i]); if (denom<1e-6) denom=1e-6;\n"
    buf = buf + "        double rel = d/denom;\n"
    buf = buf + "        if (d>maxabs) maxabs=d;\n"
    buf = buf + "        if (rel>maxrel) maxrel=rel;\n"
    buf = buf + "    }\n"
    buf = buf + "    int ok = (maxrel <= tol) || (maxabs <= tol);\n"
    buf = buf + "    if (!ok) *fail=1;\n"
    buf = buf + "    if (maxabs>*gmaxabs) *gmaxabs=maxabs;\n"
    buf = buf + "    printf(\"  %-4s n=%-7lld max|Δ|=%.3e  max_rel=%.3e  %s\\n\",\n"
    buf = buf + "           name,(long long)n,maxabs,maxrel, ok?\"PASS\":\"FAIL\");\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "int main(int argc, char** argv){\n"
    buf = buf + "    if (argc<3){ fprintf(stderr,\"usage: %s oracle.bin own.bin\\n\",argv[0]); return 1; }\n"
    buf = buf + "    double tol = getenv(\"TOL\")? atof(getenv(\"TOL\")) : 1e-4;\n"
    buf = buf + "    int64_t h1[4],h2[4],n1,n2;\n"
    buf = buf + "    float* o = slurp(argv[1],h1,&n1);\n"
    buf = buf + "    float* w = slurp(argv[2],h2,&n2);\n"
    buf = buf + "    for (int i=0;i<4;i++) if (h1[i]!=h2[i]){ fprintf(stderr,\"shape mismatch dim %d\\n\",i); return 2; }\n"
    buf = buf + "    double gmax=0.0; int fail=0;\n"
    buf = buf + "    printf(\"== Phase 1d LoRA correctness: oracle(%s) vs own(%s), tol(rel|abs)=%.1e ==\\n\",\n"
    buf = buf + "           argv[1],argv[2],tol);\n"
    buf = buf + "    int64_t off=0;\n"
    if buf.len() > 65536 { _flush_hxqwen14b_p1d_cmp(out_path, buf); buf = "" }
    buf = buf + "    cmp_block(\"y\",  o+off, w+off, h1[0], &gmax,&fail,tol); off+=h1[0];\n"
    buf = buf + "    cmp_block(\"dA\", o+off, w+off, h1[1], &gmax,&fail,tol); off+=h1[1];\n"
    buf = buf + "    cmp_block(\"dB\", o+off, w+off, h1[2], &gmax,&fail,tol); off+=h1[2];\n"
    buf = buf + "    cmp_block(\"dx\", o+off, w+off, h1[3], &gmax,&fail,tol);\n"
    buf = buf + "    printf(\"global max|Δ| = %.3e   VERDICT: %s\\n\", gmax, fail?\"FAIL\":\"PASS\");\n"
    buf = buf + "    return fail?1:0;\n"
    buf = buf + "}\n"
    if buf.len() > 0 { _flush_hxqwen14b_p1d_cmp(out_path, buf) }
}

fn main() {
    let argv = real_args()
    let out_path = if argv.len() >= 1 { argv[0] } else { "hxqwen14b_p1d_cmp.c" }
    emit_hxqwen14b_p1d_cmp_to(out_path)
    let exists_check = exec("[ -f \"" + out_path + "\" ] && echo y || echo n").trim()
    if exists_check != "y" {
        println("[hxqwen14b_p1d_cmp_emit] FATAL: failed to write " + out_path)
        exit(1)
    }
    println("[hxqwen14b_p1d_cmp_emit] wrote " + out_path)
    exit(0)
}
