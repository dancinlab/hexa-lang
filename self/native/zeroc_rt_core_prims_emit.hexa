#!hexa strict
// zeroc_rt_core_prims_emit.hexa
//   B9.C (.c-text · #1850 pattern) — zeroc_rt_core_prims.c source emitter.
//
// ZERO-C leg-B rt_* CORE prims (ING #35) — emitter-generated verbatim C
//
// Emits zeroc_rt_core_prims.c VERBATIM. The hexa build regenerates the .c from
// this emitter before compiling, so the emitter becomes the SSOT and the
// .c becomes a build artifact. Byte-identity (gate-1 source-SHA, proven by
// zeroc_rt_core_prims_byte_diff.hexa) ⇒ identical .o/.so ⇒ PERF UNCHANGED.
//
// GENERATED by tool/gen_c_text_emitter.hexa — do not hand-edit; re-run the
// generator against the hand-written .c if it ever changes.
//
// Invocation:  hexa-run zeroc_rt_core_prims_emit.hexa <output-path>
// Default output path (if argv missing): "zeroc_rt_core_prims.c" in cwd.

let MODULE_NAME = "zeroc_rt_core_prims_emit"

fn _flush_zeroc_rt_core_prims(out_path: str, buf: str) {
    let _ = exec("cat >> \"" + out_path + "\" <<'GEN_zeroc_rt_core_prims_EOF'\n" + buf + "GEN_zeroc_rt_core_prims_EOF")
}

fn emit_zeroc_rt_core_prims_to(out_path: str) {
    // Verbatim content of hand-written self/native/zeroc_rt_core_prims.c, streamed in
    // size-bounded chunks (see generator note on the per-command exec limit).
    let _ = exec("printf '' > \"" + out_path + "\"")
    let mut buf = ""
    buf = buf + "// self/native/zeroc_rt_core_prims.c — ZERO-C leg-B (ING #35, r11).\n"
    buf = buf + "//\n"
    buf = buf + "// The drop-ON build removes runtime_core.c + runtime_hi_gen.c from the\n"
    buf = buf + "// compile, so the standalone EXECUTABLE link of the drop-ON runtime loses\n"
    buf = buf + "// the CORE-tier rt_* primitive bodies that the seed cluster `hexa_*`\n"
    buf = buf + "// wrappers delegate to (rt_format/rt_print live in the hexa stdlib runtime;\n"
    buf = buf + "// the math ones come from rtcore math seeds). The cluster seed objects\n"
    buf = buf + "// (rtcore_arith-coerce-format.c, rtcore_math2.c) only define the `hexa_*`\n"
    buf = buf + "// wrappers and EXTERN the rt_* leaves — so a full executable link is left\n"
    buf = buf + "// with the rt_* CORE prims undefined.\n"
    buf = buf + "//\n"
    buf = buf + "// This seed re-supplies the SELF-CONTAINED numeric/coercion rt_* leaves as a\n"
    buf = buf + "// SEPARATE relocatable object (the string-format + IO + transcendental rt_*\n"
    buf = buf + "// come from the transpiled stdlib runtime modules ctype/io/math). Faithful to\n"
    buf = buf + "// the stdlib/runtime/numeric.hexa SSOT (transcribed, HexaVal ABI). It is\n"
    buf = buf + "// MEASURE/EXEC-ONLY: the DEFAULT build never compiles this file (no caller\n"
    buf = buf + "// passes -DHEXA_ZEROC_RT_CORE_PRIMS), so the default path is byte-IDENTICAL.\n"
    buf = buf + "//\n"
    buf = buf + "// Included by a 1-line TU with runtime.h in scope (HexaVal / HX_* / hexa_*).\n"
    buf = buf + "// rt_log10 (sci-format) and __hx_to_double are external T symbols in the link.\n"
    buf = buf + "\n"
    buf = buf + "extern HexaVal rt_log10(HexaVal x);\n"
    buf = buf + "\n"
    buf = buf + "// ── numeric: abs / floor / ceil / u_floor / round (numeric.hexa) ──────────\n"
    buf = buf + "HexaVal rt_abs_int(HexaVal v)   { long long x = HX_INT(v);   return hexa_int(x < 0 ? -x : x); }\n"
    buf = buf + "HexaVal rt_abs_float(HexaVal v) { double x = HX_FLOAT(v);    return hexa_float(x < 0.0 ? -x : x); }\n"
    buf = buf + "\n"
    buf = buf + "HexaVal rt_floor(HexaVal v) {\n"
    buf = buf + "    double d = HX_FLOAT(v); long long i = (long long)d;\n"
    buf = buf + "    if (d >= 0.0) return hexa_int(i);\n"
    buf = buf + "    if ((double)i == d) return hexa_int(i);\n"
    buf = buf + "    return hexa_int(i - 1);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal rt_ceil(HexaVal v) {\n"
    buf = buf + "    double d = HX_FLOAT(v); long long i = (long long)d;\n"
    buf = buf + "    if (d <= 0.0) return hexa_int(i);\n"
    buf = buf + "    if ((double)i == d) return hexa_int(i);\n"
    buf = buf + "    return hexa_int(i + 1);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal rt_u_floor(HexaVal va, HexaVal vb) {\n"
    buf = buf + "    long long a = HX_INT(va), b = HX_INT(vb);\n"
    buf = buf + "    if (b == 0) return hexa_int(0);\n"
    buf = buf + "    long long q = a / b, r = a - q * b;\n"
    buf = buf + "    if (r != 0 && ((a < 0) != (b < 0))) return hexa_int(q - 1);\n"
    buf = buf + "    return hexa_int(q);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal rt_round(HexaVal v) {\n"
    buf = buf + "    double d = HX_FLOAT(v);\n"
    buf = buf + "    if (d >= 0.0) return hexa_int((long long)(d + 0.5));\n"
    buf = buf + "    return hexa_int((long long)(d - 0.5));\n"
    if buf.len() > 65536 { _flush_zeroc_rt_core_prims(out_path, buf); buf = "" }
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ── numeric: fma / pow_int / to_float (numeric.hexa cycle 21/6/12) ─────────\n"
    buf = buf + "HexaVal rt_fma_int(HexaVal a, HexaVal b, HexaVal c)   { return hexa_int(HX_INT(a) * HX_INT(b) + HX_INT(c)); }\n"
    buf = buf + "HexaVal rt_fma_float(HexaVal a, HexaVal b, HexaVal c) { return hexa_float(HX_FLOAT(a) * HX_FLOAT(b) + HX_FLOAT(c)); }\n"
    buf = buf + "HexaVal rt_pow_int(HexaVal vb, HexaVal ve) {\n"
    buf = buf + "    long long e = HX_INT(ve); if (e < 0) return hexa_int(0);\n"
    buf = buf + "    long long r = 1, base = HX_INT(vb);\n"
    buf = buf + "    while (e > 0) { if (e & 1) r = r * base; base = base * base; e >>= 1; }\n"
    buf = buf + "    return hexa_int(r);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal rt_to_float(HexaVal v) { return hexa_float(__hx_to_double(v)); }\n"
    buf = buf + "\n"
    buf = buf + "// ── numeric: to_int / len / null_coal (numeric.hexa) ──────────────────────\n"
    buf = buf + "HexaVal rt_to_int(HexaVal v) {\n"
    buf = buf + "    if (HX_IS_INT(v)) return v;\n"
    buf = buf + "    if (HX_IS_STR(v)) return hexa_str_parse_int(v);\n"
    buf = buf + "    return hexa_int((long long)__hx_to_double(v));   // __raw_d2i bridge\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal rt_len(HexaVal v) { return hexa_byte_len(v); }\n"
    buf = buf + "HexaVal rt_null_coal(HexaVal a, HexaVal b) {\n"
    buf = buf + "    if (a.tag == TAG_VOID) return b;\n"
    buf = buf + "    if (HX_IS_STR(a)) {\n"
    buf = buf + "        const char* s = HX_STR(a);\n"
    buf = buf + "        if (!s || s[0] == 0) return b;\n"
    buf = buf + "    }\n"
    buf = buf + "    return a;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ── concat-many (numeric.hexa cycle …) — fold + with hexa_add over array ──\n"
    buf = buf + "HexaVal rt_concat_many_arr(HexaVal parts) {\n"
    buf = buf + "    long long n = (long long)HX_INT(hexa_byte_len(parts));\n"
    buf = buf + "    if (n <= 0) return hexa_str(\"\");\n"
    buf = buf + "    HexaVal acc = hexa_index_get(parts, hexa_int(0));\n"
    buf = buf + "    for (long long i = 1; i < n; i++)\n"
    buf = buf + "        acc = hexa_add_slow(acc, hexa_index_get(parts, hexa_int(i)));\n"
    buf = buf + "    return acc;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ── float→string format (numeric.hexa cycle 60/61) — libc snprintf delegate.\n"
    buf = buf + "// The hexa-source builds the string digit-by-digit via bytes_to_str_raw; for\n"
    buf = buf + "// the standalone exec link we delegate to snprintf (same %.*f / %.*e shape).\n"
    buf = buf + "HexaVal rt_format_float_f(HexaVal v, HexaVal prec) {\n"
    buf = buf + "    char buf[64]; int p = (int)HX_INT(prec); if (p < 0) p = 0; if (p > 18) p = 18;\n"
    buf = buf + "    snprintf(buf, sizeof buf, \"%.*f\", p, HX_FLOAT(v));\n"
    buf = buf + "    return hexa_str(buf);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal rt_format_float_sci(HexaVal v, HexaVal prec) {\n"
    buf = buf + "    char buf[64]; int p = (int)HX_INT(prec); if (p < 0) p = 0; if (p > 18) p = 18;\n"
    buf = buf + "    snprintf(buf, sizeof buf, \"%.*e\", p, HX_FLOAT(v));\n"
    if buf.len() > 65536 { _flush_zeroc_rt_core_prims(out_path, buf); buf = "" }
    buf = buf + "    return hexa_str(buf);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// _hexa_init_fn_shims — drop-link-fill. In the DEFAULT (non-drop) build,\n"
    buf = buf + "// runtime_core.c is concatenated INTO runtime.c so this static initializer\n"
    buf = buf + "// (runtime.c:13437) and its call site (runtime_core.c:8520) share one TU and\n"
    buf = buf + "// bind directly. The whole-file DROP separates them into two objects: the body\n"
    buf = buf + "// stays in the dropped-runtime object (static, invisible) while the call site\n"
    buf = buf + "// moves to the arena-globals seed TU → an undefined cross-TU reloc that the\n"
    buf = buf + "// concatenated build never had. The first-class TAG_FN handles it wires (join/\n"
    buf = buf + "// char_code/chr/farr_*) are only consulted when hexa user-code uses those\n"
    buf = buf + "// builtins as VALUES; the substrate/exec path does not. We supply an external\n"
    buf = buf + "// no-op so the drop-ON binary LINKS; the real wiring is the non-drop runtime.\n"
    buf = buf + "extern int _hexa_init_fn_shims_was_dropped;   /* marker only, unused */\n"
    buf = buf + "void _hexa_init_fn_shims(void) { /* drop-link-fill: see header */ }\n"
    if buf.len() > 0 { _flush_zeroc_rt_core_prims(out_path, buf) }
}

fn main() {
    let argv = real_args()
    let out_path = if argv.len() >= 1 { argv[0] } else { "zeroc_rt_core_prims.c" }
    emit_zeroc_rt_core_prims_to(out_path)
    let exists_check = exec("[ -f \"" + out_path + "\" ] && echo y || echo n").trim()
    if exists_check != "y" {
        println("[zeroc_rt_core_prims_emit] FATAL: failed to write " + out_path)
        exit(1)
    }
    println("[zeroc_rt_core_prims_emit] wrote " + out_path)
    exit(0)
}
