#!hexa strict
// timegm_native_emit.hexa
//   B9.C (.c-text · #1850 pattern) — timegm_native.c source emitter.
//
// RFC061 #29 timegm calendar leaf · self/native runtime.c-included .c-text · emitter-SSOT graduation
//
// Emits timegm_native.c VERBATIM. The hexa build regenerates the .c from
// this emitter before compiling, so the emitter becomes the SSOT and the
// .c becomes a build artifact. Byte-identity (gate-1 source-SHA, proven by
// timegm_native_byte_diff.hexa) ⇒ identical .o/.so ⇒ PERF UNCHANGED.
//
// GENERATED by tool/gen_c_text_emitter.hexa — do not hand-edit; re-run the
// generator against the hand-written .c if it ever changes.
//
// Invocation:  hexa-run timegm_native_emit.hexa <output-path>
// Default output path (if argv missing): "timegm_native.c" in cwd.

let MODULE_NAME = "timegm_native_emit"

fn _flush_timegm_native(out_path: str, buf: str) {
    let _ = exec("cat >> \"" + out_path + "\" <<'GEN_timegm_native_EOF'\n" + buf + "GEN_timegm_native_EOF")
}

fn emit_timegm_native_to(out_path: str) {
    // Verbatim content of hand-written self/native/timegm_native.c, streamed in
    // size-bounded chunks (see generator note on the per-command exec limit).
    let _ = exec("printf '' > \"" + out_path + "\"")
    let mut buf = ""
    buf = buf + "// self/native/timegm_native.c — ING #29 libc-free re-architecture ladder, R1.\n"
    buf = buf + "//\n"
    buf = buf + "// α (native-compute) pure-leaf: replaces the runtime substrate's sole RAW libc\n"
    buf = buf + "// `timegm()` reference with a hexa-native integer calendar computation. No\n"
    buf = buf + "// syscall, no ABI surface — pure tm{year,mon,mday,hour,min,sec} → time_t (UTC).\n"
    buf = buf + "//\n"
    buf = buf + "// ── Why a delegate (NOT a frozen-blob edit) ──────────────────────────────────\n"
    buf = buf + "// The shipping runtime substrate calls timegm RAW at exactly one site:\n"
    buf = buf + "//   self/runtime.c:12312 (frozen blob 151c52c8) —\n"
    buf = buf + "//     `int64_t epoch = (int64_t)timegm(&g);`   (hexa_utc_iso_parse)\n"
    buf = buf + "// The companion `gmtime_r` (the INVERSE, epoch→civil) was already ported to a\n"
    buf = buf + "// hexa-native body INSIDE the frozen blob before it froze (runtime.c:2645\n"
    buf = buf + "// `hxlcl_gmtime_r`, civil-from-days, \"no libc\"), routed via an in-blob\n"
    buf = buf + "// `#define gmtime_r hxlcl_gmtime_r`. `timegm` never received that treatment and\n"
    buf = buf + "// the blob is now IMMUTABLE (release-integrity hardline — faithful byte-identity\n"
    buf = buf + "// gate vs 151c52c8). So timegm cannot be redirected from inside the blob.\n"
    buf = buf + "//\n"
    buf = buf + "// Instead we follow the #3798 fmod→rt_fmod / zeroc_hxlcl_delegate.c pattern:\n"
    buf = buf + "// supply a STRONG EXTERNAL definition of `timegm` in a SEPARATE seed object that\n"
    buf = buf + "// the DEFAULT build never compiles (byte-identical OFF). When opt-in\n"
    buf = buf + "// (-DHEXA_RT_TIMEGM_NATIVE) the seed .o is linked ahead of libc, so the frozen\n"
    buf = buf + "// blob's raw `timegm(&g)` reference resolves to THIS definition and the libc\n"
    buf = buf + "// `timegm` symbol is dropped from the final link — one symbol off the -lc\n"
    buf = buf + "// ladder, with zero edits to the immutable frozen blob.\n"
    buf = buf + "//\n"
    buf = buf + "// ── Reference-match (white-box port) ─────────────────────────────────────────\n"
    buf = buf + "// Ported 1:1 from musl-libc (integer calendar arithmetic, bit-exact UTC):\n"
    buf = buf + "//   musl src/time/__tm_to_secs.c    — tm → seconds (month overflow normalised)\n"
    buf = buf + "//   musl src/time/__year_to_secs.c  — year → seconds since 1970 + leap accounting\n"
    buf = buf + "//   musl src/time/__month_to_secs.c — month → cumulative seconds (+leap-day)\n"
    buf = buf + "//   musl src/time/timegm.c          — public wrapper (returns __tm_to_secs)\n"
    buf = buf + "// Cross-checks the repo's own native calendar (stdlib/time/civil.hexa\n"
    buf = buf + "// days_from_civil, Howard Hinnant) and the in-blob hxlcl_gmtime_r inverse.\n"
    buf = buf + "//\n"
    buf = buf + "// The pure compute (hxlcl_timegm_secs) is ALWAYS defined so the standalone test\n"
    buf = buf + "// harness (test/native_build/timegm_native_test.c) can diff it against libc\n"
    buf = buf + "// timegm without pulling in the symbol override; the override `timegm` is gated.\n"
    buf = buf + "\n"
    buf = buf + "#include <time.h>\n"
    buf = buf + "#include <stdint.h>\n"
    buf = buf + "\n"
    buf = buf + "// musl src/time/__month_to_secs.c — cumulative seconds at the start of `month`\n"
    buf = buf + "// (0-11) within the year, +1 day past February in a leap year.\n"
    buf = buf + "static int hxlcl_month_to_secs(int month, int is_leap) {\n"
    buf = buf + "    static const int secs_through_month[] = {\n"
    buf = buf + "        0, 31*86400, 59*86400, 90*86400,\n"
    buf = buf + "        120*86400, 151*86400, 181*86400, 212*86400,\n"
    buf = buf + "        243*86400, 273*86400, 304*86400, 334*86400\n"
    buf = buf + "    };\n"
    buf = buf + "    int t = secs_through_month[month];\n"
    if buf.len() > 65536 { _flush_timegm_native(out_path, buf); buf = "" }
    buf = buf + "    if (is_leap && month >= 2) t += 86400;\n"
    buf = buf + "    return t;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// musl src/time/__year_to_secs.c — seconds from 1970-01-01 to `year`-01-01\n"
    buf = buf + "// (year is the absolute proleptic-Gregorian year, e.g. 2000), and sets *is_leap.\n"
    buf = buf + "static int64_t hxlcl_year_to_secs(int64_t year, int *is_leap) {\n"
    buf = buf + "    if (year - 2ULL <= 136) {\n"
    buf = buf + "        int y = (int)year;\n"
    buf = buf + "        int leaps = (y - 68) >> 2;\n"
    buf = buf + "        if (!((y - 68) & 3)) {\n"
    buf = buf + "            leaps--;\n"
    buf = buf + "            if (is_leap) *is_leap = 1;\n"
    buf = buf + "        } else if (is_leap) {\n"
    buf = buf + "            *is_leap = 0;\n"
    buf = buf + "        }\n"
    buf = buf + "        return 31536000LL * (y - 70) + 86400LL * leaps;\n"
    buf = buf + "    }\n"
    buf = buf + "\n"
    buf = buf + "    int cycles, centuries, leaps, rem;\n"
    buf = buf + "    int dummy;\n"
    buf = buf + "    if (!is_leap) is_leap = &dummy;\n"
    buf = buf + "    cycles = (int)((year - 100) / 400);\n"
    buf = buf + "    rem = (int)((year - 100) % 400);\n"
    buf = buf + "    if (rem < 0) { cycles--; rem += 400; }\n"
    buf = buf + "    if (!rem) {\n"
    buf = buf + "        *is_leap = 1;\n"
    buf = buf + "        centuries = 0;\n"
    buf = buf + "        leaps = 0;\n"
    buf = buf + "    } else {\n"
    buf = buf + "        if (rem >= 200) {\n"
    buf = buf + "            if (rem >= 300) { centuries = 3; rem -= 300; }\n"
    buf = buf + "            else            { centuries = 2; rem -= 200; }\n"
    buf = buf + "        } else {\n"
    buf = buf + "            if (rem >= 100) { centuries = 1; rem -= 100; }\n"
    buf = buf + "            else            { centuries = 0; }\n"
    buf = buf + "        }\n"
    buf = buf + "        if (!rem) {\n"
    buf = buf + "            *is_leap = 0;\n"
    buf = buf + "            leaps = 0;\n"
    buf = buf + "        } else {\n"
    buf = buf + "            leaps = rem / 4;\n"
    buf = buf + "            rem %= 4;\n"
    buf = buf + "            *is_leap = !rem;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "\n"
    buf = buf + "    leaps += 97 * cycles + 24 * centuries - *is_leap;\n"
    buf = buf + "\n"
    buf = buf + "    return (year - 100) * 31536000LL + leaps * 86400LL + 946684800LL + 86400LL;\n"
    if buf.len() > 65536 { _flush_timegm_native(out_path, buf); buf = "" }
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// musl src/time/__tm_to_secs.c — broken-down UTC tm → Unix seconds.\n"
    buf = buf + "// `tm_year` is years-since-1900, `tm_mon` is 0-11 (over/underflow normalised),\n"
    buf = buf + "// `tm_mday` is 1-based. Result is bit-exact with glibc/musl timegm for UTC.\n"
    buf = buf + "int64_t hxlcl_timegm_secs(const struct tm *tm) {\n"
    buf = buf + "    int is_leap;\n"
    buf = buf + "    int64_t year = tm->tm_year;\n"
    buf = buf + "    int month = tm->tm_mon;\n"
    buf = buf + "    if (month >= 12 || month < 0) {\n"
    buf = buf + "        int adj = month / 12;\n"
    buf = buf + "        month %= 12;\n"
    buf = buf + "        if (month < 0) { adj--; month += 12; }\n"
    buf = buf + "        year += adj;\n"
    buf = buf + "    }\n"
    buf = buf + "    int64_t t = hxlcl_year_to_secs(year, &is_leap);\n"
    buf = buf + "    t += hxlcl_month_to_secs(month, is_leap);\n"
    buf = buf + "    t += 86400LL * (tm->tm_mday - 1);\n"
    buf = buf + "    t += 3600LL * tm->tm_hour;\n"
    buf = buf + "    t += 60LL * tm->tm_min;\n"
    buf = buf + "    t += tm->tm_sec;\n"
    buf = buf + "    return t;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "#ifdef HEXA_RT_TIMEGM_NATIVE\n"
    buf = buf + "// musl src/time/timegm.c — public wrapper. Strong external definition: when this\n"
    buf = buf + "// seed object is linked (opt-in), it satisfies the frozen blob's raw `timegm`\n"
    buf = buf + "// reference ahead of libc, dropping the libc timegm symbol from the final link.\n"
    buf = buf + "// (Field-normalisation writeback to *tm — glibc behaviour — is omitted: the sole\n"
    buf = buf + "//  shipping caller hexa_utc_iso_parse uses only the return value and discards tm;\n"
    buf = buf + "//  the returned epoch is bit-exact. R2 may add __secs_to_tm writeback for full\n"
    buf = buf + "//  drop-in parity if a writeback-dependent caller appears.)\n"
    buf = buf + "time_t timegm(struct tm *tm) {\n"
    buf = buf + "    return (time_t)hxlcl_timegm_secs(tm);\n"
    buf = buf + "}\n"
    buf = buf + "#endif\n"
    if buf.len() > 0 { _flush_timegm_native(out_path, buf) }
}

fn main() {
    let argv = real_args()
    let out_path = if argv.len() >= 1 { argv[0] } else { "timegm_native.c" }
    emit_timegm_native_to(out_path)
    let exists_check = exec("[ -f \"" + out_path + "\" ] && echo y || echo n").trim()
    if exists_check != "y" {
        println("[timegm_native_emit] FATAL: failed to write " + out_path)
        exit(1)
    }
    println("[timegm_native_emit] wrote " + out_path)
    exit(0)
}
