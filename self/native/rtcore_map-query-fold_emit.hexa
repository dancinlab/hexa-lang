#!hexa strict
// rtcore_map_query_fold_emit.hexa
//   B9.C (.c-text · #1850 pattern) — rtcore_map_query_fold.c source emitter.
//
// zero-c leg-B map-query-fold seed — 8 unguarded map query HexaVal symbols (ING #29)
//
// Emits rtcore_map_query_fold.c VERBATIM. The hexa build regenerates the .c from
// this emitter before compiling, so the emitter becomes the SSOT and the
// .c becomes a build artifact. Byte-identity (gate-1 source-SHA, proven by
// rtcore_map_query_fold_byte_diff.hexa) ⇒ identical .o/.so ⇒ PERF UNCHANGED.
//
// GENERATED by tool/gen_c_text_emitter.hexa — do not hand-edit; re-run the
// generator against the hand-written .c if it ever changes.
//
// Invocation:  hexa-run rtcore_map_query_fold_emit.hexa <output-path>
// Default output path (if argv missing): "rtcore_map_query_fold.c" in cwd.

let MODULE_NAME = "rtcore_map_query_fold_emit"

fn _flush_rtcore_map_query_fold(out_path: str, buf: str) {
    let _ = exec("cat >> \"" + out_path + "\" <<'GEN_rtcore_map_query_fold_EOF'\n" + buf + "GEN_rtcore_map_query_fold_EOF")
}

fn emit_rtcore_map_query_fold_to(out_path: str) {
    // Verbatim content of hand-written self/native/rtcore_map_query_fold.c, streamed in
    // size-bounded chunks (see generator note on the per-command exec limit).
    let _ = exec("printf '' > \"" + out_path + "\"")
    let mut buf = ""
    buf = buf + "// self/native/rtcore_map-query-fold.c — zero-c leg-B MAP-QUERY-FOLD SEED (link de-risk).\n"
    buf = buf + "//\n"
    buf = buf + "// Supplies 8 map query runtime_core.c symbols that the build externs away under\n"
    buf = buf + "// HEXA_RT_CORE_MAP_QUERY_FOLD_NATIVE (the narrow map-query guard, NOT the broad\n"
    buf = buf + "// whole-runtime HEXA_RT_SELFEMIT). Compiled to a SEPARATE .o\n"
    buf = buf + "// (build/rtcore_map_query_fold_native.o) and linked when\n"
    buf = buf + "// HEXA_ZEROC_RT_CORE_MAP_QUERY_FOLD=1, so the build LINKS these bodies from a\n"
    buf = buf + "// standalone object instead of compiling them inline in runtime_core.c.\n"
    buf = buf + "//\n"
    buf = buf + "// PURPOSE = extend the r4 leaf-cluster / r5 arith de-risk\n"
    buf = buf + "// (self/native/rtcore_leaf.c · self/native/rtcore_arith.c) to the SEED-PORTABLE\n"
    buf = buf + "// map query class — runtime_core.c symbols whose every immediate callee is\n"
    buf = buf + "// external-linkage or a macro (the seed-portability rule) AND whose runtime_core.c\n"
    buf = buf + "// body is UNGUARDED (single definition, compiled identically in the aprime build\n"
    buf = buf + "// AND the stage-5 standalone smoke link). It does NOT drop the .c file\n"
    buf = buf + "// (runtime_core.c drop is all-or-nothing — 250 symbols; this links 8 more).\n"
    buf = buf + "// Default build (flag unset) is byte-IDENTICAL: these bodies are not compiled and\n"
    buf = buf + "// the inline runtime_core.c bodies are used verbatim.\n"
    buf = buf + "//\n"
    buf = buf + "// SCOPE — only the UNGUARDED single-body fns of the map-query-fold cluster are\n"
    buf = buf + "// linked here. The 11 cluster fns whose runtime_core.c definition is wrapped in\n"
    buf = buf + "// the shipping `#ifdef HEXA_HAS_HEXA_RT_STDLIB / #else / #endif` dual-arm guard\n"
    buf = buf + "// (hexa_map_get / keys / values / entries / contains_key / map_values /\n"
    buf = buf + "// filter_keys / count / any / all) are DROPPED this round: the stage-5 smoke\n"
    buf = buf + "// links runtime.c WITHOUT HEXA_HAS_HEXA_RT_STDLIB, so it compiles their `#else`\n"
    buf = buf + "// C-arm body — which would COLLIDE (duplicate symbol) with a seed that also\n"
    buf = buf + "// defines them. Safely externing those needs a guard inside BOTH arms (a more\n"
    buf = buf + "// invasive shipping-region edit), deferred to a dedicated round. __map_ptr_eq is\n"
    buf = buf + "// ALSO dropped — runtime.h provides it as a `static inline` (runtime.h:190-195),\n"
    buf = buf + "// so it has no external T export and a separate .o cannot carry it.\n"
    buf = buf + "//\n"
    buf = buf + "// SEED-PORTABILITY (the rule): a fn is seed-portable ONLY if EVERY immediate\n"
    buf = buf + "// callee is external-linkage or a macro. The 8 below are clean:\n"
    buf = buf + "//   __map_has_cstr_v   → HX_MAP_TBL(macro) HX_STR(macro) hmap_find(ext)\n"
    buf = buf + "//                        hexa_fnv1a_str(ext) hexa_bool(ext)\n"
    buf = buf + "//   __map_get_cstr_v   → ditto + hexa_void(ext), t->vals[] (struct field read)\n"
    buf = buf + "//   __map_order_key_at → HX_MAP_TBL HX_INT(macro) hexa_void/hexa_str(ext)\n"
    buf = buf + "//   __map_order_val_at → HX_MAP_TBL HX_INT hexa_void(ext), t->order_vals[]\n"
    buf = buf + "//   __map_set_cstr_v   → HX_STR hexa_map_set_impl(ext)\n"
    buf = buf + "//   __map_remove_cstr_v→ HX_STR hexa_map_remove_impl(ext)\n"
    buf = buf + "//   hexa_map_get_v     → hexa_map_get(ext) hexa_to_cstring(ext)\n"
    buf = buf + "//   hexa_map_to_array  → hexa_map_entries(ext)\n"
    buf = buf + "//\n"
    buf = buf + "// The callees (hexa_bool/void/str/int/map_get/map_entries/map_set_impl/\n"
    buf = buf + "// map_remove_impl, the hmap_find/hexa_fnv1a_str de-staticized helpers) resolve\n"
    buf = buf + "// from the rest of the link (runtime_core.c / runtime.h), exactly as the r4 leaf\n"
    buf = buf + "// seed's hexa_float_to_bits calls hexa_int across the .o boundary.\n"
    buf = buf + "//\n"
    buf = buf + "// This file is #include'd by a 1-line TU at seed-regen time with self/runtime.h\n"
    buf = buf + "// already in scope (HexaVal / HexaMapTable / HX_INT / HX_STR / HX_MAP_TBL + the\n"
    if buf.len() > 65536 { _flush_rtcore_map_query_fold(out_path, buf); buf = "" }
    buf = buf + "// extern protos for hexa_bool/void/str/int/map_get/map_entries/map_set_impl/\n"
    buf = buf + "// map_remove_impl/to_cstring). The two de-staticized helpers hmap_find /\n"
    buf = buf + "// hexa_fnv1a_str that runtime.h does NOT carry are re-declared below — byte-\n"
    buf = buf + "// identical to the runtime_core.c SSOT (no semantic change) — so the seed TU\n"
    buf = buf + "// compiles from runtime.h alone.\n"
    buf = buf + "\n"
    buf = buf + "// ── extern protos runtime.h does NOT carry (de-staticized / runtime_core.c) ──\n"
    buf = buf + "extern int hmap_find(HexaMapTable* t, const char* key, uint32_t h);\n"
    buf = buf + "extern uint32_t hexa_fnv1a_str(const char* s);\n"
    buf = buf + "\n"
    buf = buf + "HexaVal __map_has_cstr_v(HexaVal m, HexaVal key) {\n"
    buf = buf + "    HexaMapTable* t = HX_MAP_TBL(m);\n"
    buf = buf + "    if (!t) return hexa_bool(0);\n"
    buf = buf + "    const char* k = HX_STR(key);\n"
    buf = buf + "    if (!k) return hexa_bool(0);\n"
    buf = buf + "    return hexa_bool(hmap_find(t, k, hexa_fnv1a_str(k)) >= 0);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal __map_get_cstr_v(HexaVal m, HexaVal key) {\n"
    buf = buf + "    HexaMapTable* t = HX_MAP_TBL(m);\n"
    buf = buf + "    if (!t) return hexa_void();\n"
    buf = buf + "    const char* k = HX_STR(key);\n"
    buf = buf + "    if (!k) return hexa_void();\n"
    buf = buf + "    int si = hmap_find(t, k, hexa_fnv1a_str(k));\n"
    buf = buf + "    if (si < 0) return hexa_void();\n"
    buf = buf + "    return t->vals[si];\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal __map_order_key_at(HexaVal m, HexaVal i) {\n"
    buf = buf + "    HexaMapTable* t = HX_MAP_TBL(m);\n"
    buf = buf + "    if (!t) return hexa_void();\n"
    buf = buf + "    int idx = (int)HX_INT(i);\n"
    buf = buf + "    if (idx < 0 || idx >= t->len) return hexa_void();\n"
    buf = buf + "    return hexa_str(t->order_keys[idx]);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal __map_order_val_at(HexaVal m, HexaVal i) {\n"
    buf = buf + "    HexaMapTable* t = HX_MAP_TBL(m);\n"
    buf = buf + "    if (!t) return hexa_void();\n"
    buf = buf + "    int idx = (int)HX_INT(i);\n"
    buf = buf + "    if (idx < 0 || idx >= t->len) return hexa_void();\n"
    buf = buf + "    return t->order_vals[idx];\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal __map_set_cstr_v(HexaVal m, HexaVal key, HexaVal val) {\n"
    buf = buf + "    const char* k = HX_STR(key);\n"
    buf = buf + "    if (!k) return m;\n"
    buf = buf + "    return hexa_map_set_impl(m, k, val);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_rtcore_map_query_fold(out_path, buf); buf = "" }
    buf = buf + "HexaVal __map_remove_cstr_v(HexaVal m, HexaVal key) {\n"
    buf = buf + "    const char* k = HX_STR(key);\n"
    buf = buf + "    if (!k) return m;\n"
    buf = buf + "    return hexa_map_remove_impl(m, k);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_map_get_v(HexaVal m, HexaVal key) { return hexa_map_get(m, hexa_to_cstring(key)); }\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_map_to_array(HexaVal m) {\n"
    buf = buf + "    return hexa_map_entries(m);\n"
    buf = buf + "}\n"
    if buf.len() > 0 { _flush_rtcore_map_query_fold(out_path, buf) }
}

fn main() {
    let argv = real_args()
    let out_path = if argv.len() >= 1 { argv[0] } else { "rtcore_map_query_fold.c" }
    emit_rtcore_map_query_fold_to(out_path)
    let exists_check = exec("[ -f \"" + out_path + "\" ] && echo y || echo n").trim()
    if exists_check != "y" {
        println("[rtcore_map_query_fold_emit] FATAL: failed to write " + out_path)
        exit(1)
    }
    println("[rtcore_map_query_fold_emit] wrote " + out_path)
    exit(0)
}
