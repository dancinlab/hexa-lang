#!hexa strict
// rtcore_array_typed_leaf_emit.hexa
//   B9.C (.c-text · #1850 pattern) — rtcore_array_typed_leaf.c source emitter.
//
// zero-c leg-B ARRAY-TYPED-LEAF seed text-emitter SSOT
//
// Emits rtcore_array_typed_leaf.c VERBATIM. The hexa build regenerates the .c from
// this emitter before compiling, so the emitter becomes the SSOT and the
// .c becomes a build artifact. Byte-identity (gate-1 source-SHA, proven by
// rtcore_array_typed_leaf_byte_diff.hexa) ⇒ identical .o/.so ⇒ PERF UNCHANGED.
//
// GENERATED by tool/gen_c_text_emitter.hexa — do not hand-edit; re-run the
// generator against the hand-written .c if it ever changes.
//
// Invocation:  hexa-run rtcore_array_typed_leaf_emit.hexa <output-path>
// Default output path (if argv missing): "rtcore_array_typed_leaf.c" in cwd.

let MODULE_NAME = "rtcore_array_typed_leaf_emit"

fn _flush_rtcore_array_typed_leaf(out_path: str, buf: str) {
    let _ = exec("cat >> \"" + out_path + "\" <<'GEN_rtcore_array_typed_leaf_EOF'\n" + buf + "GEN_rtcore_array_typed_leaf_EOF")
}

fn emit_rtcore_array_typed_leaf_to(out_path: str) {
    // Verbatim content of hand-written self/native/rtcore_array_typed_leaf.c, streamed in
    // size-bounded chunks (see generator note on the per-command exec limit).
    let _ = exec("printf '' > \"" + out_path + "\"")
    let mut buf = ""
    buf = buf + "// self/native/rtcore_array-typed-leaf.c — zero-c leg-B ARRAY-TYPED-LEAF SEED (link de-risk).\n"
    buf = buf + "//\n"
    buf = buf + "// Supplies 10 LEAF typed-array ctors/accessors + zeros-leaf builders that\n"
    buf = buf + "// runtime_core.c externs away under HEXA_RT_CORE_ARRAY_TYPED_LEAF_NATIVE (the\n"
    buf = buf + "// narrow array-typed-leaf-only guard, NOT the broad whole-runtime\n"
    buf = buf + "// HEXA_RT_SELFEMIT). Compiled to a SEPARATE .o\n"
    buf = buf + "// (build/rtcore_array_typed_leaf_native.o) and linked when\n"
    buf = buf + "// HEXA_ZEROC_RT_CORE_ARRAY_TYPED_LEAF=1, so the build LINKS these bodies from a\n"
    buf = buf + "// standalone object instead of compiling them inline in runtime_core.c.\n"
    buf = buf + "//\n"
    buf = buf + "// PURPOSE = extend the r4 leaf-cluster (rtcore_leaf.c), r5 clean-6 arith\n"
    buf = buf + "// (rtcore_arith.c) and r7 clean-4 transcendental (rtcore_math.c) to the next\n"
    buf = buf + "// seed-portable cluster: the LEAF typed-array constructors/accessors over raw\n"
    buf = buf + "// libc malloc/calloc/realloc + external HexaVal box helpers. It does NOT drop the\n"
    buf = buf + "// .c file (runtime_core.c drop is all-or-nothing — 250 symbols; this links 10\n"
    buf = buf + "// more). Default build (flag unset) is byte-IDENTICAL: these bodies are not\n"
    buf = buf + "// compiled and the inline #else bodies in runtime_core.c are used verbatim.\n"
    buf = buf + "//\n"
    buf = buf + "// CLUSTER (10 fns, all emitted UNCONDITIONALLY inline — no #else arm in the\n"
    buf = buf + "// shipping HEXA_HAS_HEXA_RT_STDLIB build, so the frozen-static WALL question of\n"
    buf = buf + "// r6/r7 does not arise; these are plain strong defs whose every callee is\n"
    buf = buf + "// external-linkage or a macro):\n"
    buf = buf + "//   hexa_arr_i64_new / _push / _len / _box   — native int64_t[] ctor/accessor\n"
    buf = buf + "//   hexa_arr_f64_new / _push / _len / _box   — native double[]  ctor/accessor\n"
    buf = buf + "//   hexa_arr_zeros_leaf / _zeros_leaf_int    — zero-filled HexaVal[] builders\n"
    buf = buf + "//\n"
    buf = buf + "// SEED-PORTABILITY (the r5 rule): a fn is seed-portable ONLY if EVERY callee is\n"
    buf = buf + "// external-linkage or a macro. The 10 below are clean:\n"
    buf = buf + "//   - libc:   malloc / calloc / realloc / free / fprintf / exit / stderr\n"
    buf = buf + "//             (all in <stdio.h>/<stdlib.h>, pulled in via runtime.h).\n"
    buf = buf + "//   - hexa:   hexa_int / hexa_float / hexa_throw / hexa_str / __hx_to_double\n"
    buf = buf + "//             (PUBLIC non-static defs in runtime_core.c — external T symbols in\n"
    buf = buf + "//              the linked binary, exactly like the r5/r7 seeds' callees).\n"
    buf = buf + "//   - macros: HX_SET_ARR_PTR / HX_SET_ARR_ITEMS / HX_SET_ARR_LEN / HX_SET_ARR_CAP\n"
    buf = buf + "//             / HX_IS_INT / HX_INT  (preprocessor — no link symbol).\n"
    buf = buf + "//   - types:  HexaVal / HexaArr / HexaArrI64 / HexaArrF64 + TAG_* enum.\n"
    buf = buf + "//   None of these callees is a frozen-STATIC body, so the cluster needs no\n"
    buf = buf + "//   external-delegate route (unlike r6 hxlcl_fmod / r7 hxlcl_sin) — it is\n"
    buf = buf + "//   directly seed-portable.\n"
    buf = buf + "//\n"
    buf = buf + "// DROPPED (not in this seed — already ported via a different lane, NOT a wall):\n"
    buf = buf + "//   hexa_arena_mark / hexa_arena_rewind / hexa_arena_reset — in the shipping\n"
    buf = buf + "//   build these are EMITTED UNDER `#ifdef HEXA_RT_ALLOC_NATIVE` as `extern`\n"
    buf = buf + "//   (runtime_core.c links them from the native alloc syscall seed,\n"
    buf = buf + "//   alloc_syscall_*.s, default-ON). Their inline C bodies exist ONLY in the\n"
    buf = buf + "//   `#else  // !HEXA_RT_ALLOC_NATIVE` arm. So in the default build there is NO\n"
    buf = buf + "//   inline body to extern out via this r7-style C-seed mechanism, and adding\n"
    buf = buf + "//   them to a C seed would MULTI-DEF against the assembly alloc seed already\n"
    buf = buf + "//   supplying them. They are already native (alloc lane), not seed-portable here.\n"
    buf = buf + "//\n"
    if buf.len() > 65536 { _flush_rtcore_array_typed_leaf(out_path, buf); buf = "" }
    buf = buf + "// BIT-IDENTITY: each seed body below is the VERBATIM body emitted inline by\n"
    buf = buf + "// runtime_core_emit.hexa (same C text, same callees resolved from the rest of the\n"
    buf = buf + "// link), so the ON arm computes the same bits as the OFF inline body. The OFF arm\n"
    buf = buf + "// is preserved verbatim (runtime_core_emit.hexa #else) so the default build is\n"
    buf = buf + "// byte-identical.\n"
    buf = buf + "//\n"
    buf = buf + "// This file is #include'd by a 1-line TU at seed-regen time with the runtime\n"
    buf = buf + "// headers already in scope (HexaVal / HexaArr / TAG_* / HX_INT / HX_IS_INT +\n"
    buf = buf + "// extern protos for hexa_int / hexa_float / hexa_str / hexa_throw /\n"
    buf = buf + "// __hx_to_double, all in runtime.h). Two struct types (HexaArrI64 / HexaArrF64)\n"
    buf = buf + "// and the four HX_SET_ARR_* writer macros are defined in runtime_core.c but NOT\n"
    buf = buf + "// in runtime.h, so re-declare them here (guarded — identical to the runtime_core.c\n"
    buf = buf + "// definition, layout-match invariant with HexaArr).\n"
    buf = buf + "\n"
    buf = buf + "// HexaArrI64 / HexaArrF64 — native unboxed typed-array descriptors (layout-match\n"
    buf = buf + "// HexaArr: ptr, int64_t len, int64_t cap). Not in runtime.h; define here. The TU\n"
    buf = buf + "// includes runtime.h (HexaVal/HexaArr) but never runtime_core.c, so these do not\n"
    buf = buf + "// collide. Sentinel-guarded so a future runtime.h that adds them stays safe.\n"
    buf = buf + "#ifndef HEXA_RTCORE_ARR_TYPED_DEFINED\n"
    buf = buf + "#define HEXA_RTCORE_ARR_TYPED_DEFINED\n"
    buf = buf + "typedef struct HexaArrI64 {\n"
    buf = buf + "    int64_t* data;\n"
    buf = buf + "    int64_t len;\n"
    buf = buf + "    int64_t cap;\n"
    buf = buf + "} HexaArrI64;\n"
    buf = buf + "typedef struct HexaArrF64 {\n"
    buf = buf + "    double* data;\n"
    buf = buf + "    int64_t len;\n"
    buf = buf + "    int64_t cap;\n"
    buf = buf + "} HexaArrF64;\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// HX_SET_ARR_* writer macros — defined in runtime_core.c, NOT runtime.h. Guarded\n"
    buf = buf + "// (#ifndef) so they are a no-op if runtime.h ever supplies them.\n"
    buf = buf + "#ifndef HX_SET_ARR_PTR\n"
    buf = buf + "#define HX_SET_ARR_PTR(v, p)   ((v).arr_ptr = (p))\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifndef HX_SET_ARR_ITEMS\n"
    buf = buf + "#define HX_SET_ARR_ITEMS(v, p) ((v).arr_ptr->items = (p))\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifndef HX_SET_ARR_LEN\n"
    buf = buf + "#define HX_SET_ARR_LEN(v, n)   ((v).arr_ptr->len = (n))\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifndef HX_SET_ARR_CAP\n"
    buf = buf + "#define HX_SET_ARR_CAP(v, n)   ((v).arr_ptr->cap = (n))\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// ── zero-c array-typed-leaf — native-i64 array storage helpers ──────────────\n"
    buf = buf + "HexaVal hexa_arr_i64_new(int cap) {\n"
    buf = buf + "    HexaArrI64* a = (HexaArrI64*)malloc(sizeof(HexaArrI64));\n"
    if buf.len() > 65536 { _flush_rtcore_array_typed_leaf(out_path, buf); buf = "" }
    buf = buf + "    if (!a) { fprintf(stderr, \"OOM in arr_i64_new\\n\"); exit(1); }\n"
    buf = buf + "    if (cap < 1) cap = 1;\n"
    buf = buf + "    a->data = (int64_t*)malloc(sizeof(int64_t) * (size_t)cap);\n"
    buf = buf + "    if (!a->data) { fprintf(stderr, \"OOM in arr_i64_new data\\n\"); exit(1); }\n"
    buf = buf + "    a->len = 0; a->cap = cap;\n"
    buf = buf + "    HexaVal v = {.tag=TAG_ARRAY};\n"
    buf = buf + "    HX_SET_ARR_PTR(v, (HexaArr*)a);\n"
    buf = buf + "    return v;\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_arr_i64_push(HexaVal v, int64_t x) {\n"
    buf = buf + "    HexaArrI64* a = (HexaArrI64*)v.arr_ptr;\n"
    buf = buf + "    if (a->len >= a->cap) {\n"
    buf = buf + "        a->cap *= 2;\n"
    buf = buf + "        a->data = (int64_t*)realloc(a->data, sizeof(int64_t) * (size_t)a->cap);\n"
    buf = buf + "        if (!a->data) { fprintf(stderr, \"OOM in arr_i64_push\\n\"); exit(1); }\n"
    buf = buf + "    }\n"
    buf = buf + "    a->data[a->len++] = x;\n"
    buf = buf + "    return v;\n"
    buf = buf + "}\n"
    buf = buf + "int hexa_arr_i64_len(HexaVal v) { return ((HexaArrI64*)v.arr_ptr)->len; }\n"
    buf = buf + "HexaVal hexa_arr_i64_box(HexaVal v, int64_t i) {\n"
    buf = buf + "    HexaArrI64* a = (HexaArrI64*)v.arr_ptr;\n"
    buf = buf + "    if (i < 0 || i >= a->len) { hexa_throw(hexa_str(\"index out of bounds\")); }\n"
    buf = buf + "    return hexa_int(a->data[i]);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ── zero-c array-typed-leaf — native-f64 array storage helpers ──────────────\n"
    buf = buf + "HexaVal hexa_arr_f64_new(int cap) {\n"
    buf = buf + "    HexaArrF64* a = (HexaArrF64*)malloc(sizeof(HexaArrF64));\n"
    buf = buf + "    if (!a) { fprintf(stderr, \"OOM in arr_f64_new\\n\"); exit(1); }\n"
    buf = buf + "    if (cap < 1) cap = 1;\n"
    buf = buf + "    a->data = (double*)malloc(sizeof(double) * (size_t)cap);\n"
    buf = buf + "    if (!a->data) { fprintf(stderr, \"OOM in arr_f64_new data\\n\"); exit(1); }\n"
    buf = buf + "    a->len = 0; a->cap = cap;\n"
    buf = buf + "    HexaVal v = {.tag=TAG_ARRAY};\n"
    buf = buf + "    HX_SET_ARR_PTR(v, (HexaArr*)a);\n"
    buf = buf + "    return v;\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_arr_f64_push(HexaVal v, double x) {\n"
    buf = buf + "    HexaArrF64* a = (HexaArrF64*)v.arr_ptr;\n"
    buf = buf + "    if (a->len >= a->cap) {\n"
    buf = buf + "        a->cap *= 2;\n"
    buf = buf + "        a->data = (double*)realloc(a->data, sizeof(double) * (size_t)a->cap);\n"
    buf = buf + "        if (!a->data) { fprintf(stderr, \"OOM in arr_f64_push\\n\"); exit(1); }\n"
    buf = buf + "    }\n"
    buf = buf + "    a->data[a->len++] = x;\n"
    buf = buf + "    return v;\n"
    buf = buf + "}\n"
    buf = buf + "int hexa_arr_f64_len(HexaVal v) { return ((HexaArrF64*)v.arr_ptr)->len; }\n"
    buf = buf + "HexaVal hexa_arr_f64_box(HexaVal v, int64_t i) {\n"
    if buf.len() > 65536 { _flush_rtcore_array_typed_leaf(out_path, buf); buf = "" }
    buf = buf + "    HexaArrF64* a = (HexaArrF64*)v.arr_ptr;\n"
    buf = buf + "    if (i < 0 || i >= a->len) { hexa_throw(hexa_str(\"index out of bounds\")); }\n"
    buf = buf + "    return hexa_float(a->data[i]);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ── zero-c array-typed-leaf — zero-filled HexaVal[] leaf builders ───────────\n"
    buf = buf + "HexaVal hexa_arr_zeros_leaf(HexaVal nv) {\n"
    buf = buf + "    HexaVal out = {.tag=TAG_ARRAY};\n"
    buf = buf + "    HX_SET_ARR_PTR(out, (HexaArr*)calloc(1, sizeof(HexaArr)));\n"
    buf = buf + "    int64_t n = HX_IS_INT(nv) ? HX_INT(nv) : (int64_t)__hx_to_double(nv);\n"
    buf = buf + "    if (n <= 0) return out;\n"
    buf = buf + "    HexaVal* items = (HexaVal*)malloc(sizeof(HexaVal) * (size_t)n);\n"
    buf = buf + "    if (!items) { fprintf(stderr, \"OOM in hexa_arr_zeros_leaf n=%lld\\n\", (long long)n); exit(1); }\n"
    buf = buf + "    HexaVal zero = {.tag=TAG_FLOAT, .f=0.0};\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) items[i] = zero;\n"
    buf = buf + "    HX_SET_ARR_ITEMS(out, items);\n"
    buf = buf + "    HX_SET_ARR_LEN(out, (int)n);\n"
    buf = buf + "    HX_SET_ARR_CAP(out, (int)n);\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_arr_zeros_leaf_int(HexaVal nv) {\n"
    buf = buf + "    HexaVal out = {.tag=TAG_ARRAY};\n"
    buf = buf + "    HX_SET_ARR_PTR(out, (HexaArr*)calloc(1, sizeof(HexaArr)));\n"
    buf = buf + "    int64_t n = HX_IS_INT(nv) ? HX_INT(nv) : (int64_t)__hx_to_double(nv);\n"
    buf = buf + "    if (n <= 0) return out;\n"
    buf = buf + "    HexaVal* items = (HexaVal*)malloc(sizeof(HexaVal) * (size_t)n);\n"
    buf = buf + "    if (!items) { fprintf(stderr, \"OOM in hexa_arr_zeros_leaf_int n=%lld\\n\", (long long)n); exit(1); }\n"
    buf = buf + "    HexaVal zero = {.tag=TAG_INT, .i=0};\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) items[i] = zero;\n"
    buf = buf + "    HX_SET_ARR_ITEMS(out, items);\n"
    buf = buf + "    HX_SET_ARR_LEN(out, (int)n);\n"
    buf = buf + "    HX_SET_ARR_CAP(out, (int)n);\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    if buf.len() > 0 { _flush_rtcore_array_typed_leaf(out_path, buf) }
}

fn main() {
    let argv = real_args()
    let out_path = if argv.len() >= 1 { argv[0] } else { "rtcore_array_typed_leaf.c" }
    emit_rtcore_array_typed_leaf_to(out_path)
    let exists_check = exec("[ -f \"" + out_path + "\" ] && echo y || echo n").trim()
    if exists_check != "y" {
        println("[rtcore_array_typed_leaf_emit] FATAL: failed to write " + out_path)
        exit(1)
    }
    println("[rtcore_array_typed_leaf_emit] wrote " + out_path)
    exit(0)
}
