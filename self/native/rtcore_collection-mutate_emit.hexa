#!hexa strict
// rtcore_collection-mutate_emit.hexa
//   B9.C (.c-text · #1850 pattern) — rtcore_collection-mutate.c source emitter.
//
// zero-c leg-B r7 collection-mutate native seed (13 map/array mutate+query symbols)
//
// Emits rtcore_collection-mutate.c VERBATIM. The hexa build regenerates the .c from
// this emitter before compiling, so the emitter becomes the SSOT and the
// .c becomes a build artifact. Byte-identity (gate-1 source-SHA, proven by
// rtcore_collection-mutate_byte_diff.hexa) ⇒ identical .o/.so ⇒ PERF UNCHANGED.
//
// GENERATED by tool/gen_c_text_emitter.hexa — do not hand-edit; re-run the
// generator against the hand-written .c if it ever changes.
//
// Invocation:  hexa-run rtcore_collection-mutate_emit.hexa <output-path>
// Default output path (if argv missing): "rtcore_collection-mutate.c" in cwd.

let MODULE_NAME = "rtcore_collection-mutate_emit"

fn _flush_rtcore_collection-mutate(out_path: str, buf: str) {
    let _ = exec("cat >> \"" + out_path + "\" <<'GEN_rtcore_collection_mutate_EOF'\n" + buf + "GEN_rtcore_collection_mutate_EOF")
}

fn emit_rtcore_collection-mutate_to(out_path: str) {
    // Verbatim content of hand-written self/native/rtcore_collection-mutate.c, streamed in
    // size-bounded chunks (see generator note on the per-command exec limit).
    let _ = exec("printf '' > \"" + out_path + "\"")
    let mut buf = ""
    buf = buf + "// self/native/rtcore_collection-mutate.c — zero-c leg-B r7 COLLECTION-MUTATE SEED (link de-risk).\n"
    buf = buf + "//\n"
    buf = buf + "// Supplies 13 map/array mutate+query symbols that runtime_core.c externs away\n"
    buf = buf + "// under HEXA_RT_CORE_COLLECTION_MUTATE_NATIVE (the narrow collection-mutate\n"
    buf = buf + "// guard, NOT the broad whole-runtime HEXA_RT_SELFEMIT). Compiled to a SEPARATE\n"
    buf = buf + "// .o (build/rtcore_collection-mutate_native.o) and linked when\n"
    buf = buf + "// HEXA_ZEROC_RT_CORE_COLLECTION_MUTATE=1, so the build LINKS these bodies from a\n"
    buf = buf + "// standalone object instead of compiling them inline in runtime_core.c.\n"
    buf = buf + "//\n"
    buf = buf + "// PURPOSE = extend the r4 leaf-cluster (rtcore_leaf.c) + r5 arith (rtcore_arith.c)\n"
    buf = buf + "// link de-risk to the SEED-PORTABLE map/array mutate class — the next batch of\n"
    buf = buf + "// runtime_core.c symbols whose every immediate callee is external-linkage, a\n"
    buf = buf + "// macro, or a seed-supplied rt_* (the seed-portability rule). It does NOT drop\n"
    buf = buf + "// the .c file (runtime_core.c drop is all-or-nothing — 250 symbols; this links\n"
    buf = buf + "// 13 more). Default build (flag unset) is byte-IDENTICAL: these bodies are not\n"
    buf = buf + "// compiled and the inline runtime_core.c bodies are used verbatim.\n"
    buf = buf + "//\n"
    buf = buf + "// SEED-PORTABILITY (the r5/r7 rule): a fn is seed-portable ONLY if EVERY callee\n"
    buf = buf + "// is external-linkage, a macro, or a seed-supplied rt_* (array_core .s seed,\n"
    buf = buf + "// linked in BOTH the aprime and smoke link paths). The seed replicates the\n"
    buf = buf + "// SMOKE-SAFE arm (the body that compiles with NEITHER HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "// nor the hexa-stdlib rt_* present) so the standalone .o links cleanly in the\n"
    buf = buf + "// stage-5 smoke (no-stdlib) link too — except array_truncate, whose smoke-safe\n"
    buf = buf + "// rt_array_truncate_native IS in the array_core seed, so the seed keeps that\n"
    buf = buf + "// delegation byte-faithful to the aprime active path.\n"
    buf = buf + "//\n"
    buf = buf + "// The 13 below are clean (immediate callees + their linkage):\n"
    buf = buf + "//   hexa_map_from_array  → hexa_map_new/hexa_str_as_ptr/hexa_to_string/hexa_map_set\n"
    buf = buf + "//                          (ext T), HX_IS_ARRAY/HX_ARR_LEN/HX_ARR_ITEMS (macro)\n"
    buf = buf + "//   hexa_map_invert      → hexa_map_new/hexa_str_as_ptr/hexa_to_string/hexa_map_set/\n"
    buf = buf + "//                          hexa_str (ext T), HX_MAP_TBL (macro)\n"
    buf = buf + "//   hexa_map_merge       → hexa_map_set (ext T), HX_MAP_TBL (macro)\n"
    buf = buf + "//   hexa_map_remove      → hexa_map_remove_impl (ext T)\n"
    buf = buf + "//   hexa_map_remove_impl → hmap_find/hexa_fnv1a_str (ext T, de-staticized),\n"
    buf = buf + "//                          free (libc), HX_MAP_TBL/HX_SET_MAP_LEN (macro)\n"
    buf = buf + "//   hexa_map_set         → hexa_map_set_impl (ext T)\n"
    buf = buf + "//   hexa_map_set_v       → hexa_map_set/hexa_to_cstring (ext T)\n"
    buf = buf + "//   hexa_array_contains  → hexa_truthy/hexa_eq (ext T), HX_IS_ARRAY/HX_ARR_LEN/\n"
    buf = buf + "//                          HX_ARR_ITEMS (macro)  [non-stdlib arm — no rt_*]\n"
    buf = buf + "//   hexa_array_last      → snprintf (libc), hexa_throw/hexa_str (ext T),\n"
    buf = buf + "//                          HX_IS_ARRAY/HX_ARR_LEN/HX_ARR_ITEMS/HX_TAG (macro)\n"
    buf = buf + "//   hexa_array_pop       → rt_array_pop_native (array_core seed), snprintf (libc),\n"
    buf = buf + "//                          hexa_throw/hexa_str (ext T)\n"
    buf = buf + "//   hexa_array_set       → rt_array_set_native (array_core seed), snprintf (libc),\n"
    buf = buf + "//                          hexa_throw/hexa_str (ext T), __hexa_arena_slot_dirty\n"
    buf = buf + "//                          (ext int — runtime_core.c global)\n"
    buf = buf + "//   hexa_array_shift     → rt_array_shift_native (array_core seed), snprintf,\n"
    buf = buf + "//                          hexa_throw/hexa_str (ext T)\n"
    buf = buf + "//   hexa_array_truncate  → rt_array_truncate_native (array_core seed),\n"
    buf = buf + "//                          HX_IS_ARRAY (macro)\n"
    if buf.len() > 65536 { _flush_rtcore_collection-mutate(out_path, buf); buf = "" }
    buf = buf + "//\n"
    buf = buf + "// EXPLICITLY EXCLUDED (NOT clean — static or seed-absent rt_* callee):\n"
    buf = buf + "//   hexa_array_sort → qsort comparator hexa_sort_cmp is `static int\n"
    buf = buf + "//                     hexa_sort_cmp(...)` (runtime_core.c:5981) — a separate .o\n"
    buf = buf + "//                     cannot resolve it; the float fast-path also calls\n"
    buf = buf + "//                     rt_array_sort_float, which NO seed exports (hexa-stdlib\n"
    buf = buf + "//                     only, absent in the smoke no-stdlib link). Stays inline-C.\n"
    buf = buf + "//\n"
    buf = buf + "// The bodies are the EXACT same C as the runtime_core.c smoke-safe arms (SSOT\n"
    buf = buf + "// self/runtime_core_emit.hexa) — byte-faithful by construction. The callees\n"
    buf = buf + "// (hexa_map_new/hexa_map_set/hexa_map_set_impl/hexa_map_remove_impl/hexa_str/\n"
    buf = buf + "// hexa_str_as_ptr/hexa_to_string/hexa_to_cstring/hexa_eq/hexa_truthy/hexa_throw/\n"
    buf = buf + "// hmap_find/hexa_fnv1a_str + the rt_array_*_native seed symbols + the\n"
    buf = buf + "// __hexa_arena_slot_dirty global) resolve from the rest of the link\n"
    buf = buf + "// (runtime_core.c / runtime.h / array_core .s seed), exactly as the r4 leaf seed\n"
    buf = buf + "// resolves hexa_int and the r5 arith seed resolves __hx_to_double across the .o\n"
    buf = buf + "// boundary.\n"
    buf = buf + "//\n"
    buf = buf + "// This file is #include'd by a 1-line TU at seed-regen time with the runtime\n"
    buf = buf + "// headers already in scope (HexaVal / HexaArr / HexaMapTable / HexaMapSlot +\n"
    buf = buf + "// HX_* macros + the extern protos). Five macros that runtime_core.c defines but\n"
    buf = buf + "// runtime.h does NOT (HX_ARR_LEN / HX_ARR_ITEMS / HX_SET_MAP_LEN / HX_SET_ARR_LEN\n"
    buf = buf + "// / HX_IS_VOID) are re-declared below with #ifndef guards, byte-identical to the\n"
    buf = buf + "// SSOT (self/runtime_core_emit.hexa), so the seed TU compiles from runtime.h\n"
    buf = buf + "// alone — same value, no semantic change.\n"
    buf = buf + "\n"
    buf = buf + "#ifndef HX_ARR_LEN\n"
    buf = buf + "#define HX_ARR_LEN(v)   ((v).arr_ptr->len)\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifndef HX_ARR_ITEMS\n"
    buf = buf + "#define HX_ARR_ITEMS(v) ((v).arr_ptr->items)\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifndef HX_SET_MAP_LEN\n"
    buf = buf + "#define HX_SET_MAP_LEN(v, n)   ((v).map_ptr->len = (n))\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifndef HX_SET_ARR_LEN\n"
    buf = buf + "#define HX_SET_ARR_LEN(v, n)   ((v).arr_ptr->len = (n))\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifndef HX_IS_VOID\n"
    buf = buf + "#define HX_IS_VOID(v)   ((v).tag == TAG_VOID)\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// extern protos for the cross-.o callees (resolved from runtime_core.c / the\n"
    buf = buf + "// array_core .s seed). runtime.h already declares hexa_map_new/hexa_map_set/\n"
    buf = buf + "// hexa_str/hexa_to_string/hexa_str_as_ptr/hexa_eq/hexa_truthy/hexa_throw, but\n"
    buf = buf + "// re-declaring is harmless (identical protos) and keeps the seed self-contained.\n"
    buf = buf + "extern HexaVal hexa_int(int64_t n);\n"
    buf = buf + "extern HexaVal hexa_void(void);\n"
    buf = buf + "extern HexaVal hexa_map_new(void);\n"
    buf = buf + "extern HexaVal hexa_map_set(HexaVal m, const char* key, HexaVal val);\n"
    if buf.len() > 65536 { _flush_rtcore_collection-mutate(out_path, buf); buf = "" }
    buf = buf + "extern HexaVal hexa_map_set_impl(HexaVal m, const char* key, HexaVal val);\n"
    buf = buf + "extern HexaVal hexa_map_remove_impl(HexaVal m, const char* key);\n"
    buf = buf + "extern HexaVal hexa_str(const char* s);\n"
    buf = buf + "extern HexaVal hexa_to_string(HexaVal v);\n"
    buf = buf + "extern const char* hexa_str_as_ptr(HexaVal v);\n"
    buf = buf + "extern const char* hexa_to_cstring(HexaVal v);\n"
    buf = buf + "extern HexaVal hexa_eq(HexaVal a, HexaVal b);\n"
    buf = buf + "extern int     hexa_truthy(HexaVal v);\n"
    buf = buf + "extern void    hexa_throw(HexaVal err);\n"
    buf = buf + "extern int     hmap_find(HexaMapTable* t, const char* key, uint32_t h);\n"
    buf = buf + "extern uint32_t hexa_fnv1a_str(const char* s);\n"
    buf = buf + "extern int     __hexa_arena_slot_dirty;\n"
    buf = buf + "#ifndef HEXA_ARR_HEAPIFY_WATER_OFF\n"
    buf = buf + "extern int hexa_arr_water_on(void);\n"
    buf = buf + "extern int __hexa_val_mark_top;\n"
    buf = buf + "extern HexaVal hexa_val_heapify(HexaVal v);\n"
    buf = buf + "#endif\n"
    buf = buf + "extern HexaVal rt_array_pop_native(HexaVal arr);\n"
    buf = buf + "extern HexaVal rt_array_shift_native(HexaVal arr);\n"
    buf = buf + "extern HexaVal rt_array_set_native(HexaVal arr, HexaVal idx, HexaVal v);\n"
    buf = buf + "extern HexaVal rt_array_truncate_native(HexaVal arr, HexaVal new_len_v);\n"
    buf = buf + "\n"
    buf = buf + "// ── map mutate ───────────────────────────────────────────\n"
    buf = buf + "HexaVal hexa_map_merge(HexaVal a, HexaVal b) {\n"
    buf = buf + "    if (!HX_MAP_TBL(a)) return a;\n"
    buf = buf + "    if (!HX_MAP_TBL(b)) return a;\n"
    buf = buf + "    HexaVal out = a;\n"
    buf = buf + "    HexaMapTable* tb = HX_MAP_TBL(b);\n"
    buf = buf + "    for (int i = 0; i < tb->len; i++) {\n"
    buf = buf + "        out = hexa_map_set(out, tb->order_keys[i], tb->order_vals[i]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_map_invert(HexaVal m) {\n"
    buf = buf + "    HexaVal out = hexa_map_new();\n"
    buf = buf + "    if (!HX_MAP_TBL(m)) return out;\n"
    buf = buf + "    HexaMapTable* t = HX_MAP_TBL(m);\n"
    buf = buf + "    for (int i = 0; i < t->len; i++) {\n"
    buf = buf + "        const char* new_key = hexa_str_as_ptr(hexa_to_string(t->order_vals[i]));\n"
    buf = buf + "        if (!new_key) continue;\n"
    buf = buf + "        out = hexa_map_set(out, new_key, hexa_str(t->order_keys[i]));\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_map_from_array(HexaVal self_map, HexaVal arr) {\n"
    buf = buf + "    (void)self_map;\n"
    buf = buf + "    HexaVal out = hexa_map_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int n = HX_ARR_LEN(arr);\n"
    buf = buf + "    for (int i = 0; i < n; i++) {\n"
    buf = buf + "        HexaVal pair = HX_ARR_ITEMS(arr)[i];\n"
    buf = buf + "        if (!HX_IS_ARRAY(pair) || HX_ARR_LEN(pair) < 2) continue;\n"
    buf = buf + "        HexaVal k = HX_ARR_ITEMS(pair)[0];\n"
    if buf.len() > 65536 { _flush_rtcore_collection-mutate(out_path, buf); buf = "" }
    buf = buf + "        HexaVal v = HX_ARR_ITEMS(pair)[1];\n"
    buf = buf + "        const char* k_str = hexa_str_as_ptr(hexa_to_string(k));\n"
    buf = buf + "        if (!k_str) continue;\n"
    buf = buf + "        out = hexa_map_set(out, k_str, v);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_map_remove_impl(HexaVal m, const char* key) {\n"
    buf = buf + "    if (!HX_MAP_TBL(m)) return m;\n"
    buf = buf + "    HexaMapTable* t = HX_MAP_TBL(m);\n"
    buf = buf + "    uint32_t h = hexa_fnv1a_str(key);\n"
    buf = buf + "    int si = hmap_find(t, key, h);\n"
    buf = buf + "    if (si < 0) return m;\n"
    buf = buf + "\n"
    buf = buf + "    // ROI-24: O(1) locate in order array via cached order_idx, then shift\n"
    buf = buf + "    int oi = t->slots[si].order_idx;\n"
    buf = buf + "    for (int j = oi; j < t->len - 1; j++) {\n"
    buf = buf + "        t->order_keys[j] = t->order_keys[j+1];\n"
    buf = buf + "        t->order_vals[j] = t->order_vals[j+1];\n"
    buf = buf + "    }\n"
    buf = buf + "    // Fix order_idx for all hash-table slots whose order position shifted\n"
    buf = buf + "    for (int j = 0; j < t->ht_cap; j++) {\n"
    buf = buf + "        if (t->slots[j].key && t->slots[j].order_idx > oi) {\n"
    buf = buf + "            t->slots[j].order_idx--;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "\n"
    buf = buf + "    // Remove from hash table: mark slot empty and re-insert displaced entries\n"
    buf = buf + "    free(t->slots[si].key);\n"
    buf = buf + "    t->slots[si].key = NULL;\n"
    buf = buf + "    t->slots[si].hash = 0;\n"
    buf = buf + "    // Robin Hood deletion: re-probe subsequent slots\n"
    buf = buf + "    uint32_t mask = (uint32_t)(t->ht_cap - 1);\n"
    buf = buf + "    uint32_t ci = ((uint32_t)si + 1) & mask;\n"
    buf = buf + "    while (t->slots[ci].key) {\n"
    buf = buf + "        // Remove and re-insert this entry\n"
    buf = buf + "        HexaMapSlot saved_slot = t->slots[ci];\n"
    buf = buf + "        HexaVal saved_val = t->vals[ci];\n"
    buf = buf + "        t->slots[ci].key = NULL;\n"
    buf = buf + "        t->slots[ci].hash = 0;\n"
    buf = buf + "        uint32_t ri = saved_slot.hash & mask;\n"
    buf = buf + "        while (t->slots[ri].key) ri = (ri + 1) & mask;\n"
    buf = buf + "        t->slots[ri] = saved_slot;  // ROI-24: order_idx carried in struct copy\n"
    buf = buf + "        t->vals[ri] = saved_val;\n"
    buf = buf + "        ci = (ci + 1) & mask;\n"
    buf = buf + "    }\n"
    buf = buf + "\n"
    buf = buf + "    t->len--;\n"
    buf = buf + "    HX_SET_MAP_LEN(m, t->len);\n"
    if buf.len() > 65536 { _flush_rtcore_collection-mutate(out_path, buf); buf = "" }
    buf = buf + "    return m;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_map_remove(HexaVal m, const char* key) {\n"
    buf = buf + "    return hexa_map_remove_impl(m, key);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_map_set(HexaVal m, const char* key, HexaVal val) {\n"
    buf = buf + "    return hexa_map_set_impl(m, key, val);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_map_set_v(HexaVal m, HexaVal key, HexaVal val) { return hexa_map_set(m, hexa_to_cstring(key), val); }\n"
    buf = buf + "\n"
    buf = buf + "// ── array mutate / query ─────────────────────────────────\n"
    buf = buf + "int hexa_array_contains(HexaVal arr, HexaVal item) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return 0;\n"
    buf = buf + "    for (int i = 0; i < HX_ARR_LEN(arr); i++) {\n"
    buf = buf + "        if (hexa_truthy(hexa_eq(HX_ARR_ITEMS(arr)[i], item))) return 1;\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_array_last(HexaVal arr) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) {\n"
    buf = buf + "        char _buf[128];\n"
    buf = buf + "        snprintf(_buf, sizeof(_buf), \"array.last(): container is not an array (tag=%d)\", (int)HX_TAG(arr));\n"
    buf = buf + "        hexa_throw(hexa_str(_buf));\n"
    buf = buf + "        return hexa_void();\n"
    buf = buf + "    }\n"
    buf = buf + "    int n = HX_ARR_LEN(arr);\n"
    buf = buf + "    if (n == 0) {\n"
    buf = buf + "        hexa_throw(hexa_str(\"array.last(): empty array\"));\n"
    buf = buf + "        return hexa_void();\n"
    buf = buf + "    }\n"
    buf = buf + "    return HX_ARR_ITEMS(arr)[n - 1];\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_array_set(HexaVal arr, int64_t idx, HexaVal val) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) {\n"
    buf = buf + "        char _buf[128];\n"
    buf = buf + "        // Strings hit this branch when the user writes `s[i] = v`. Emit a\n"
    buf = buf + "        // string-specific diagnostic instead of the generic \"container is\n"
    buf = buf + "        // not an array (tag=3)\" — hexa strings are immutable.\n"
    buf = buf + "        if (HX_IS_STR(arr)) {\n"
    buf = buf + "            snprintf(_buf, sizeof(_buf), \"s[%lld] = …: strings are immutable\", (long long)idx);\n"
    buf = buf + "        } else {\n"
    buf = buf + "            snprintf(_buf, sizeof(_buf), \"array_set[%lld]: container is not an array (tag=%d)\", (long long)idx, (int)HX_TAG(arr));\n"
    buf = buf + "        }\n"
    buf = buf + "        hexa_throw(hexa_str(_buf));\n"
    buf = buf + "        return arr;\n"
    if buf.len() > 65536 { _flush_rtcore_collection-mutate(out_path, buf); buf = "" }
    buf = buf + "    }\n"
    buf = buf + "    int64_t _orig_idx_s = idx;\n"
    buf = buf + "    // PROBE r15-D12: negative array index = OOB (Go/Rust canonical), not wrap.\n"
    buf = buf + "    // Mirror of the get path above — `xs[-1] = v` panics.\n"
    buf = buf + "    if (idx < 0 || idx >= HX_ARR_LEN(arr)) {\n"
    buf = buf + "        char _buf[128];\n"
    buf = buf + "        snprintf(_buf, sizeof(_buf), \"index %lld out of bounds (len %lld)\", (long long)_orig_idx_s, (long long)HX_ARR_LEN(arr));\n"
    buf = buf + "        hexa_throw(hexa_str(_buf));\n"
    buf = buf + "        return arr;\n"
    buf = buf + "    }\n"
    buf = buf + "    // In-place mutate (no copy — caller reassigns)\n"
    buf = buf + "#ifndef HEXA_ARR_HEAPIFY_WATER_OFF\n"
    buf = buf + "    if (hexa_arr_water_on() && HX_ARR_CAP(arr) >= 0 && __hexa_val_mark_top > 0) val = hexa_val_heapify(val);\n"
    buf = buf + "#endif\n"
    buf = buf + "    rt_array_set_native(arr, hexa_int(idx), val);\n"
    buf = buf + "    // ω-interp-2: SETTER for the per-frame \"dirty\" flag. Any direct write to\n"
    buf = buf + "    // a host-array element is the canonical \"slot may now contain arena Vals\"\n"
    buf = buf + "    // event — covers `array_store[idx] = items.push(item)` from\n"
    buf = buf + "    // array_push_inplace, plus map_store / struct_store assignments. Marking\n"
    buf = buf + "    // here is a single-store fast path with no branch on arr identity (the\n"
    buf = buf + "    // checker in hexa_val_heapify scopes the work to the actual store walked).\n"
    buf = buf + "    __hexa_arena_slot_dirty = 1;\n"
    buf = buf + "    return arr;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_array_pop(HexaVal arr) {\n"
    buf = buf + "#ifndef HEXA_ARR_HEAPIFY_WATER_OFF\n"
    buf = buf + "    if (HX_IS_ARRAY(arr)) HX_ARR_PTR(arr)->heap_water = 0;  // heapify-water: shrink conservative reset\n"
    buf = buf + "#endif\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) {\n"
    buf = buf + "        char _buf[128];\n"
    buf = buf + "        snprintf(_buf, sizeof(_buf), \"array.pop(): container is not an array (tag=%d)\", (int)HX_TAG(arr));\n"
    buf = buf + "        hexa_throw(hexa_str(_buf));\n"
    buf = buf + "        return hexa_void();\n"
    buf = buf + "    }\n"
    buf = buf + "    if (HX_ARR_LEN(arr) == 0) {\n"
    buf = buf + "        hexa_throw(hexa_str(\"array.pop(): empty array\"));\n"
    buf = buf + "        return hexa_void();\n"
    buf = buf + "    }\n"
    buf = buf + "    return rt_array_pop_native(arr);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_array_shift(HexaVal arr) {\n"
    buf = buf + "#ifndef HEXA_ARR_HEAPIFY_WATER_OFF\n"
    buf = buf + "    if (HX_IS_ARRAY(arr)) HX_ARR_PTR(arr)->heap_water = 0;  // heapify-water: shrink conservative reset\n"
    buf = buf + "#endif\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) {\n"
    buf = buf + "        char _buf[128];\n"
    buf = buf + "        snprintf(_buf, sizeof(_buf), \"array.shift(): container is not an array (tag=%d)\", (int)HX_TAG(arr));\n"
    buf = buf + "        hexa_throw(hexa_str(_buf));\n"
    buf = buf + "        return hexa_void();\n"
    buf = buf + "    }\n"
    buf = buf + "    if (HX_ARR_LEN(arr) == 0) {\n"
    buf = buf + "        hexa_throw(hexa_str(\"array.shift(): empty array\"));\n"
    buf = buf + "        return hexa_void();\n"
    buf = buf + "    }\n"
    buf = buf + "    return rt_array_shift_native(arr);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    if buf.len() > 65536 { _flush_rtcore_collection-mutate(out_path, buf); buf = "" }
    buf = buf + "HexaVal hexa_array_truncate(HexaVal arr, HexaVal new_len_v) {\n"
    buf = buf + "#ifndef HEXA_ARR_HEAPIFY_WATER_OFF\n"
    buf = buf + "    if (HX_IS_ARRAY(arr)) HX_ARR_PTR(arr)->heap_water = 0;  // heapify-water: shrink conservative reset\n"
    buf = buf + "#endif\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return arr;\n"
    buf = buf + "    return rt_array_truncate_native(arr, new_len_v);\n"
    buf = buf + "}"
    if buf.len() > 0 { _flush_rtcore_collection-mutate(out_path, buf) }
}

fn main() {
    let argv = real_args()
    let out_path = if argv.len() >= 1 { argv[0] } else { "rtcore_collection-mutate.c" }
    emit_rtcore_collection-mutate_to(out_path)
    let exists_check = exec("[ -f \"" + out_path + "\" ] && echo y || echo n").trim()
    if exists_check != "y" {
        println("[rtcore_collection-mutate_emit] FATAL: failed to write " + out_path)
        exit(1)
    }
    println("[rtcore_collection-mutate_emit] wrote " + out_path)
    exit(0)
}
