#!hexa strict
// rtcore_runtime-misc_emit.hexa
//   B9.C (.c-text · #1850 pattern) — rtcore_runtime-misc.c source emitter.
//
// zero-c leg-B runtime-misc native seed
//
// Emits rtcore_runtime-misc.c VERBATIM. The hexa build regenerates the .c from
// this emitter before compiling, so the emitter becomes the SSOT and the
// .c becomes a build artifact. Byte-identity (gate-1 source-SHA, proven by
// rtcore_runtime-misc_byte_diff.hexa) ⇒ identical .o/.so ⇒ PERF UNCHANGED.
//
// GENERATED by tool/gen_c_text_emitter.hexa — do not hand-edit; re-run the
// generator against the hand-written .c if it ever changes.
//
// Invocation:  hexa-run rtcore_runtime-misc_emit.hexa <output-path>
// Default output path (if argv missing): "rtcore_runtime-misc.c" in cwd.

let MODULE_NAME = "rtcore_runtime-misc_emit"

fn _flush_rtcore_runtime-misc(out_path: str, buf: str) {
    let _ = exec("cat >> \"" + out_path + "\" <<'GEN_rtcore_runtime_misc_EOF'\n" + buf + "GEN_rtcore_runtime_misc_EOF")
}

fn emit_rtcore_runtime-misc_to(out_path: str) {
    // Verbatim content of hand-written self/native/rtcore_runtime-misc.c, streamed in
    // size-bounded chunks (see generator note on the per-command exec limit).
    let _ = exec("printf '' > \"" + out_path + "\"")
    let mut buf = ""
    buf = buf + "// self/native/rtcore_runtime-misc.c — zero-c leg-B r8 RUNTIME-MISC SEED (link de-risk).\n"
    buf = buf + "//\n"
    buf = buf + "// Supplies 11 seed-portable runtime_core.c symbols from the \"runtime-misc\"\n"
    buf = buf + "// cluster (try-stack tail + index/iter dispatch + fnv1a hash + valstruct/free\n"
    buf = buf + "// + mkdir + value-ptr eq) that runtime_core.c externs away under\n"
    buf = buf + "// HEXA_RT_CORE_RUNTIME_MISC_NATIVE (the narrow runtime-misc guard, NOT the\n"
    buf = buf + "// broad whole-runtime HEXA_RT_SELFEMIT). Compiled to a SEPARATE .o\n"
    buf = buf + "// (build/rtcore_runtime-misc_native.o) and linked when\n"
    buf = buf + "// HEXA_ZEROC_RT_CORE_RUNTIME_MISC=1, so the build LINKS these bodies from a\n"
    buf = buf + "// standalone object instead of compiling them inline in runtime_core.c.\n"
    buf = buf + "//\n"
    buf = buf + "// PURPOSE = extend the r4 leaf-cluster (rtcore_leaf.c, 10 HexaVal ctors) and\n"
    buf = buf + "// r5 arith-cluster (rtcore_arith.c, 6 __raw_* wrappers) de-risk to the misc\n"
    buf = buf + "// direct-external class — runtime_core.c symbols whose every callee is\n"
    buf = buf + "// external-linkage or a macro (the seed-portability rule). It does NOT drop\n"
    buf = buf + "// the .c file (runtime_core.c drop is all-or-nothing — 250 symbols; this links\n"
    buf = buf + "// 11 more). Default build (flag unset) is byte-IDENTICAL: these bodies are not\n"
    buf = buf + "// compiled and the inline #else bodies in runtime_core.c are used verbatim.\n"
    buf = buf + "//\n"
    buf = buf + "// SEED-PORTABILITY (the r5 rule): a fn is seed-portable ONLY if EVERY callee\n"
    buf = buf + "// AND every referenced global is external-linkage or a macro. The 11 below are\n"
    buf = buf + "// clean — their callees are public extern T symbols (hexa_array_new/push/get/\n"
    buf = buf + "// set, hexa_map_get/set, hexa_str, hexa_str_char_at, hexa_to_cstring, hexa_int/\n"
    buf = buf + "// bool/void/float, hexa_is_type, hexa_fnv1a_str, hmap_find, __hx_to_double) or\n"
    buf = buf + "// libc (free / mkdir / fprintf / exit), and the only globals they touch are the\n"
    buf = buf + "// PUBLIC extern `__hexa_try_top` (runtime.h:726, de-staticized) and macros.\n"
    buf = buf + "//   __vs_ptr_eq        → hexa_bool(ext), HX_VS(macro)\n"
    buf = buf + "//   hexa_fnv1a_str     → pure arithmetic (no callee)\n"
    buf = buf + "//   hexa_index_get     → hexa_map_get/array_get/str_char_at/to_cstring/int(ext)\n"
    buf = buf + "//   hexa_index_set     → hexa_map_set/array_set/to_cstring(ext), __hx_to_double\n"
    buf = buf + "//   hexa_iter_get      → hexa_str/array_get(ext), fprintf/exit(libc)\n"
    buf = buf + "//   hexa_await_unwrap  → hexa_is_type/fnv1a_str(ext), hmap_find(ext)\n"
    buf = buf + "//   hexa_valstruct_int → hexa_int(ext), HX_VSF/HX_IS_VALSTRUCT/HX_VS(macro)\n"
    buf = buf + "//   hexa_val_free_tree → hexa_void(ext), free(libc), recursion(self)\n"
    buf = buf + "//   hexa_mkdir         → hexa_bool(ext), HX_STR(macro), mkdir(libc)\n"
    buf = buf + "//   __hexa_try_pop     → __hexa_try_top(ext int, runtime.h:726)\n"
    buf = buf + "//   __hexa_try_cleanup → __hexa_try_top(ext int, runtime.h:726)\n"
    buf = buf + "// EXPLICITLY EXCLUDED (NOT clean — reference a FILE-LOCAL static global a\n"
    buf = buf + "// separate .o cannot resolve):\n"
    buf = buf + "//   __hexa_try_push    → static jmp_buf* __hexa_try_stack[] (runtime_core.c)\n"
    buf = buf + "//   __hexa_last_error  → static HexaVal __hexa_error_val   (runtime_core.c)\n"
    buf = buf + "//   hexa_args          → static int _hexa_argc / char** _hexa_argv\n"
    buf = buf + "//   hexa_real_args     → static _hexa_argc / _hexa_argv\n"
    buf = buf + "//   hexa_script_path   → static _hexa_argc / _hexa_argv\n"
    buf = buf + "// These 5 stay inline-C; a standalone .o could not resolve the file-local\n"
    buf = buf + "// statics (same exclusion class as rtcore_arith's __raw_fmod → static hxlcl_fmod).\n"
    buf = buf + "//\n"
    buf = buf + "// The bodies are the EXACT same C as the runtime_core.c #else arms (SSOT\n"
    buf = buf + "// self/runtime_core_emit.hexa) — byte-faithful by construction. The callees\n"
    buf = buf + "// and macros resolve from the rest of the link (runtime_core.c / runtime.h),\n"
    if buf.len() > 65536 { _flush_rtcore_runtime-misc(out_path, buf); buf = "" }
    buf = buf + "// exactly as the r4 leaf seed's hexa_float_to_bits calls hexa_int across the\n"
    buf = buf + "// .o boundary.\n"
    buf = buf + "//\n"
    buf = buf + "// This file is #include'd by a 1-line TU at seed-regen time with the runtime\n"
    buf = buf + "// headers already in scope (HexaVal / HexaTag / HexaMap / HexaMapTable /\n"
    buf = buf + "// HexaArr from runtime.h). The macros + the full HexaValStruct body that\n"
    buf = buf + "// runtime_core.c defines but runtime.h does NOT (HX_ARR_LEN/ITEMS/CAP /\n"
    buf = buf + "// HX_MAP_LEN / HX_VSF / HX_IS_VALSTRUCT / HX_PTR_OK / struct HexaValStruct) are\n"
    buf = buf + "// re-declared below under #ifndef guards, byte-identical to the SSOT\n"
    buf = buf + "// (self/runtime_core_emit.hexa lines 1259-1312 / 1240-1261 / 4701), so the seed\n"
    buf = buf + "// TU compiles from runtime.h alone — same value, no semantic change.\n"
    buf = buf + "\n"
    buf = buf + "#include <sys/stat.h>   // mkdir\n"
    buf = buf + "#include <stdlib.h>     // free / exit\n"
    buf = buf + "#include <stdio.h>      // fprintf / stderr\n"
    buf = buf + "#include <stdint.h>\n"
    buf = buf + "\n"
    buf = buf + "// ── macros runtime_core.c defines but runtime.h does not (byte-identical SSOT)\n"
    buf = buf + "#ifndef HX_ARR_LEN\n"
    buf = buf + "#define HX_ARR_LEN(v)   ((v).arr_ptr->len)\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifndef HX_ARR_ITEMS\n"
    buf = buf + "#define HX_ARR_ITEMS(v) ((v).arr_ptr->items)\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifndef HX_ARR_CAP\n"
    buf = buf + "#define HX_ARR_CAP(v)   ((v).arr_ptr->cap)\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifndef HX_MAP_LEN\n"
    buf = buf + "#define HX_MAP_LEN(v)   ((v).map_ptr->len)\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifndef HX_IS_VALSTRUCT\n"
    buf = buf + "#define HX_IS_VALSTRUCT(v) ((v).tag == TAG_VALSTRUCT)\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifndef HX_VSF\n"
    buf = buf + "#define HX_VSF(v, field)       (HX_VS(v)->field)\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifndef HX_PTR_OK\n"
    buf = buf + "#define HX_PTR_OK(p) ((uintptr_t)(p) >= 0x1000)\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// ── full HexaValStruct body (runtime.h only forward-declares it) — byte-faithful\n"
    buf = buf + "//    to self/runtime_core_emit.hexa lines 1240-1261. Completes the incomplete\n"
    buf = buf + "//    `typedef struct HexaValStruct HexaValStruct;` from runtime.h.\n"
    buf = buf + "#ifndef HEXA_VALSTRUCT_BODY_DEFINED\n"
    buf = buf + "#define HEXA_VALSTRUCT_BODY_DEFINED\n"
    buf = buf + "struct HexaValStruct {\n"
    buf = buf + "    int64_t tag_i;\n"
    buf = buf + "    int64_t int_val;\n"
    buf = buf + "    double  float_val;\n"
    buf = buf + "    int     bool_val;\n"
    if buf.len() > 65536 { _flush_rtcore_runtime-misc(out_path, buf); buf = "" }
    buf = buf + "    int     from_arena;\n"
    buf = buf + "    HexaVal str_val;\n"
    buf = buf + "    HexaVal char_val;\n"
    buf = buf + "    HexaVal array_val;\n"
    buf = buf + "    HexaVal fn_name;\n"
    buf = buf + "    HexaVal fn_params;\n"
    buf = buf + "    HexaVal fn_body;\n"
    buf = buf + "    HexaVal struct_name;\n"
    buf = buf + "    HexaVal struct_fields;\n"
    buf = buf + "};\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// ── extern protos for the public callees (T symbols resolved from the link)\n"
    buf = buf + "extern HexaVal hexa_int(int64_t n);\n"
    buf = buf + "extern HexaVal hexa_bool(int b);\n"
    buf = buf + "extern HexaVal hexa_void(void);\n"
    buf = buf + "extern HexaVal hexa_str(const char* s);\n"
    buf = buf + "extern int hexa_intern_owns(const char* p);  // axis-3 L1-A: shared intern-owns probe (runtime_core.c)\n"
    buf = buf + "extern HexaVal hexa_map_get(HexaVal m, const char* k);\n"
    buf = buf + "extern HexaVal hexa_map_set(HexaVal m, const char* k, HexaVal v);\n"
    buf = buf + "extern HexaVal hexa_array_new(void);\n"
    buf = buf + "extern HexaVal hexa_array_get(HexaVal a, int64_t i);\n"
    buf = buf + "extern HexaVal hexa_array_set(HexaVal a, int64_t i, HexaVal v);\n"
    buf = buf + "extern HexaVal hexa_str_char_at(HexaVal s, HexaVal i);\n"
    buf = buf + "extern const char* hexa_to_cstring(HexaVal v);\n"
    buf = buf + "extern int hexa_is_type(HexaVal v, const char* type_name);\n"
    buf = buf + "extern int hmap_find(HexaMapTable* t, const char* k, uint32_t h);\n"
    buf = buf + "extern double __hx_to_double(HexaVal v);\n"
    buf = buf + "extern int __hexa_try_top;   // runtime.h:726 — de-staticized public global\n"
    buf = buf + "\n"
    buf = buf + "// ── ported bodies (byte-identical to runtime_core.c #else arms) ───────────────\n"
    buf = buf + "\n"
    buf = buf + "// fnv1a_str: pure arithmetic, no callee.\n"
    buf = buf + "uint32_t hexa_fnv1a_str(const char* s) {\n"
    buf = buf + "    uint32_t h = 2166136261u;\n"
    buf = buf + "    for (; *s; s++) {\n"
    buf = buf + "        h ^= (uint8_t)*s;\n"
    buf = buf + "        h *= 16777619u;\n"
    buf = buf + "    }\n"
    buf = buf + "    return h;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// __vs_ptr_eq: hexa_bool(ext) + HX_VS(macro).\n"
    buf = buf + "HexaVal __vs_ptr_eq(HexaVal a, HexaVal b) {\n"
    buf = buf + "    return hexa_bool((HX_VS(a)) == (HX_VS(b)));\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// hexa_index_get: polymorphic index read (map / str / array).\n"
    buf = buf + "HexaVal hexa_index_get(HexaVal container, HexaVal key) {\n"
    buf = buf + "    if (HX_IS_MAP(container) && HX_IS_STR(key)) {\n"
    buf = buf + "        return hexa_map_get(container, HX_STR(key));\n"
    if buf.len() > 65536 { _flush_rtcore_runtime-misc(out_path, buf); buf = "" }
    buf = buf + "    }\n"
    buf = buf + "    if (HX_IS_MAP(container)) {\n"
    buf = buf + "        return hexa_map_get(container, hexa_to_cstring(key));\n"
    buf = buf + "    }\n"
    buf = buf + "    int64_t idx;\n"
    buf = buf + "    if (HX_IS_VALSTRUCT(key) && HX_VS(key)) {\n"
    buf = buf + "        idx = (HX_VSF(key, tag_i) == TAG_INT)\n"
    buf = buf + "            ? HX_VSF(key, int_val)\n"
    buf = buf + "            : (int64_t)__hx_to_double(key);\n"
    buf = buf + "    } else {\n"
    buf = buf + "        idx = HX_INT(key);\n"
    buf = buf + "    }\n"
    buf = buf + "    if (HX_IS_STR(container)) {\n"
    buf = buf + "        return hexa_str_char_at(container, hexa_int(idx));\n"
    buf = buf + "    }\n"
    buf = buf + "    // L2 uniform-soundness: a type-erased escaping packed array reaching the\n"
    buf = buf + "    // index reader — discriminate on the tag (hexa_arr_poly_get) instead of\n"
    buf = buf + "    // hexa_array_get, which aborts \"not an array\" on a packed tag.\n"
    buf = buf + "    if (HX_TAG(container) == TAG_ARRAY_I64 || HX_TAG(container) == TAG_ARRAY_F64 || HX_TAG(container) == TAG_ARRAY_F32) {\n"
    buf = buf + "        return hexa_arr_poly_get(container, idx);\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_array_get(container, idx);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// hexa_iter_get: for-in dispatch (array element / map key-as-string).\n"
    buf = buf + "HexaVal hexa_iter_get(HexaVal v, int64_t idx) {\n"
    buf = buf + "    if (HX_IS_MAP(v)) {\n"
    buf = buf + "        if (!HX_MAP_TBL(v) || idx < 0 || idx >= HX_MAP_LEN(v)) {\n"
    buf = buf + "            fprintf(stderr, \"map iter index %lld out of bounds (len %d)\\n\", (long long)idx, HX_MAP_LEN(v));\n"
    buf = buf + "            exit(1);\n"
    buf = buf + "        }\n"
    buf = buf + "        return hexa_str(HX_MAP_TBL(v)->order_keys[idx]);\n"
    buf = buf + "    }\n"
    buf = buf + "    // L2 uniform-soundness: for-in over a type-erased escaping packed array.\n"
    buf = buf + "    if (HX_TAG(v) == TAG_ARRAY_I64 || HX_TAG(v) == TAG_ARRAY_F64 || HX_TAG(v) == TAG_ARRAY_F32) {\n"
    buf = buf + "        return hexa_arr_poly_get(v, idx);\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_array_get(v, idx);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// hexa_index_set: polymorphic index write (map / array).\n"
    buf = buf + "HexaVal hexa_index_set(HexaVal container, HexaVal key, HexaVal val) {\n"
    buf = buf + "    if (HX_IS_MAP(container) && HX_IS_STR(key)) {\n"
    buf = buf + "        return hexa_map_set(container, HX_STR(key), val);\n"
    buf = buf + "    }\n"
    buf = buf + "    if (HX_IS_MAP(container)) {\n"
    buf = buf + "        return hexa_map_set(container, hexa_to_cstring(key), val);\n"
    buf = buf + "    }\n"
    buf = buf + "    int64_t idx;\n"
    buf = buf + "    if (HX_IS_VALSTRUCT(key) && HX_VS(key)) {\n"
    buf = buf + "        idx = (HX_VSF(key, tag_i) == TAG_INT)\n"
    buf = buf + "            ? HX_VSF(key, int_val)\n"
    buf = buf + "            : (int64_t)__hx_to_double(key);\n"
    buf = buf + "    } else {\n"
    buf = buf + "        idx = HX_INT(key);\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_array_set(container, idx, val);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// hexa_await_unwrap: RFC-022 await helper (Future-struct unwrap / identity).\n"
    if buf.len() > 65536 { _flush_rtcore_runtime-misc(out_path, buf); buf = "" }
    buf = buf + "HexaVal hexa_await_unwrap(HexaVal v) {\n"
    buf = buf + "    if (hexa_is_type(v, \"Future\")) {\n"
    buf = buf + "        if (HX_IS_MAP(v) && HX_MAP_TBL(v)) {\n"
    buf = buf + "            uint32_t h = hexa_fnv1a_str(\"value\");\n"
    buf = buf + "            int si = hmap_find(HX_MAP_TBL(v), \"value\", h);\n"
    buf = buf + "            if (si >= 0) {\n"
    buf = buf + "                HexaVal inner = HX_MAP_TBL(v)->vals[si];\n"
    buf = buf + "                if (inner.tag != TAG_VOID) {\n"
    buf = buf + "                    return inner;\n"
    buf = buf + "                }\n"
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return v;  // identity for non-Future or already-resolved values\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// hexa_valstruct_int: int field read from a TAG_VALSTRUCT wrapper.\n"
    buf = buf + "HexaVal hexa_valstruct_int(HexaVal v) {\n"
    buf = buf + "    if (!HX_IS_VALSTRUCT(v) || !HX_VS(v)) return hexa_int(0);\n"
    buf = buf + "    return hexa_int(HX_VSF(v, int_val));\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// hexa_val_free_tree: recursive free of a malloc'd HexaVal tree.\n"
    buf = buf + "HexaVal hexa_val_free_tree(HexaVal v) {\n"
    buf = buf + "    switch (HX_TAG(v)) {\n"
    buf = buf + "        case TAG_VALSTRUCT: {\n"
    buf = buf + "            HexaValStruct* vs = HX_VS(v);\n"
    buf = buf + "            if (!HX_PTR_OK(vs)) return hexa_void();\n"
    buf = buf + "            if (vs->from_arena) return hexa_void();\n"
    buf = buf + "            hexa_val_free_tree(vs->str_val);\n"
    buf = buf + "            hexa_val_free_tree(vs->char_val);\n"
    buf = buf + "            hexa_val_free_tree(vs->array_val);\n"
    buf = buf + "            hexa_val_free_tree(vs->fn_name);\n"
    buf = buf + "            hexa_val_free_tree(vs->fn_params);\n"
    buf = buf + "            hexa_val_free_tree(vs->fn_body);\n"
    buf = buf + "            hexa_val_free_tree(vs->struct_name);\n"
    buf = buf + "            hexa_val_free_tree(vs->struct_fields);\n"
    buf = buf + "            free(vs);\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "        case TAG_ARRAY: {\n"
    buf = buf + "            if (!HX_PTR_OK(v.arr_ptr)) return hexa_void();\n"
    buf = buf + "            int cap = HX_ARR_CAP(v);\n"
    buf = buf + "            if (cap < 0) return hexa_void();  // arena-backed\n"
    buf = buf + "            int len = HX_ARR_LEN(v);\n"
    buf = buf + "            HexaVal* items = HX_ARR_ITEMS(v);\n"
    buf = buf + "            if (items) {\n"
    buf = buf + "                for (int i = 0; i < len; i++) {\n"
    buf = buf + "                    hexa_val_free_tree(items[i]);\n"
    buf = buf + "                }\n"
    if buf.len() > 65536 { _flush_rtcore_runtime-misc(out_path, buf); buf = "" }
    buf = buf + "                free(items);\n"
    buf = buf + "            }\n"
    buf = buf + "            free(v.arr_ptr);\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "        case TAG_MAP: {\n"
    buf = buf + "            HexaMap* mp = v.map_ptr;\n"
    buf = buf + "            if (!HX_PTR_OK(mp)) return hexa_void();\n"
    buf = buf + "            HexaMapTable* t = mp->tbl;\n"
    buf = buf + "            if (t && !t->from_arena) {\n"
    buf = buf + "                if (t->slots) {\n"
    buf = buf + "                    for (int i = 0; i < t->ht_cap; i++) {\n"
    buf = buf + "                        if (t->slots[i].key && !hexa_intern_owns(t->slots[i].key)) free(t->slots[i].key);\n"
    buf = buf + "                    }\n"
    buf = buf + "                    free(t->slots);\n"
    buf = buf + "                }\n"
    buf = buf + "                if (t->order_vals) {\n"
    buf = buf + "                    for (int i = 0; i < t->len; i++) {\n"
    buf = buf + "                        hexa_val_free_tree(t->order_vals[i]);\n"
    buf = buf + "                    }\n"
    buf = buf + "                    free(t->order_vals);\n"
    buf = buf + "                }\n"
    buf = buf + "                if (t->vals)       free(t->vals);\n"
    buf = buf + "                if (t->order_keys) free(t->order_keys);\n"
    buf = buf + "                free(t);\n"
    buf = buf + "            }\n"
    buf = buf + "            free(mp);\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "        default: break;\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// hexa_mkdir: hexa_bool(ext) + HX_STR(macro) + mkdir(libc).\n"
    buf = buf + "HexaVal hexa_mkdir(HexaVal path) { return hexa_bool(mkdir(HX_STR(path), 0755) == 0); }\n"
    buf = buf + "\n"
    buf = buf + "// __hexa_try_pop / __hexa_try_cleanup: touch only the PUBLIC extern __hexa_try_top.\n"
    buf = buf + "void __hexa_try_pop(void) { if (__hexa_try_top > 0) __hexa_try_top--; }\n"
    buf = buf + "void __hexa_try_cleanup(int* saved) { if (__hexa_try_top > *saved) __hexa_try_top = *saved; }"
    if buf.len() > 0 { _flush_rtcore_runtime-misc(out_path, buf) }
}

fn main() {
    let argv = real_args()
    let out_path = if argv.len() >= 1 { argv[0] } else { "rtcore_runtime-misc.c" }
    emit_rtcore_runtime-misc_to(out_path)
    let exists_check = exec("[ -f \"" + out_path + "\" ] && echo y || echo n").trim()
    if exists_check != "y" {
        println("[rtcore_runtime-misc_emit] FATAL: failed to write " + out_path)
        exit(1)
    }
    println("[rtcore_runtime-misc_emit] wrote " + out_path)
    exit(0)
}
