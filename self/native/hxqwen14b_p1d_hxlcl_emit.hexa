    buf = buf + "#include <stddef.h>\n"
    buf = buf + "\n"
    buf = buf + "int hxlcl_open_sys(const char* path, int flags) { return open(path, flags); }\n"
    buf = buf + "int hxlcl_close(int fd) { return close(fd); }\n"
    buf = buf + "long hxlcl_read(int fd, void* buf, size_t n) { return (long)read(fd, buf, n); }\n"
    buf = buf + "int hxlcl_fstat(int fd, struct stat* st) { return fstat(fd, st); }\n"
    buf = buf + "int hxlcl_stat(const char* path, struct stat* st) { return stat(path, st); }\n"
    buf = buf + "void* hxlcl_mmap(void* addr, size_t len, int prot, int flags, int fd, off_t off) {\n"
    buf = buf + "    return mmap(addr, len, prot, flags, fd, off);\n"
