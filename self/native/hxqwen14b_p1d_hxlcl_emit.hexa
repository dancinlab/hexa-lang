    buf = buf + "// standalone Phase 1d correctness driver. In the normal build these live in\n"
    buf = buf + "// the hexa runtime (self/runtime_core.c); the driver doesn't link the runtime,\n"
    buf = buf + "// so we provide the same unhooked POSIX wrappers here. Only the load/\n"
    buf = buf + "// safetensors path uses them; the LoRA fwd/bwd path under test does not.\n"
    buf = buf + "\n"
    buf = buf + "#include <unistd.h>\n"
