let MODULE_NAME = "hxqwen14b_p1d_hxlcl_emit"

fn _flush_hxqwen14b_p1d_hxlcl(out_path: str, buf: str) {
    let _ = exec("cat >> \"" + out_path + "\" <<'GEN_hxqwen14b_p1d_hxlcl_EOF'\n" + buf + "GEN_hxqwen14b_p1d_hxlcl_EOF")
