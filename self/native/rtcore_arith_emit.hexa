#!hexa strict
// rtcore_arith_emit.hexa
//   B9.C (.c-text · #1850 pattern) — rtcore_arith.c source emitter.
//
// zero-c leg-B rtcore arith native seed (ING #29)
//
// Emits rtcore_arith.c VERBATIM. The hexa build regenerates the .c from
// this emitter before compiling, so the emitter becomes the SSOT and the
// .c becomes a build artifact. Byte-identity (gate-1 source-SHA, proven by
// rtcore_arith_byte_diff.hexa) ⇒ identical .o/.so ⇒ PERF UNCHANGED.
//
// GENERATED by tool/gen_c_text_emitter.hexa — do not hand-edit; re-run the
// generator against the hand-written .c if it ever changes.
//
// Invocation:  hexa-run rtcore_arith_emit.hexa <output-path>
// Default output path (if argv missing): "rtcore_arith.c" in cwd.

let MODULE_NAME = "rtcore_arith_emit"

fn _flush_rtcore_arith(out_path: str, buf: str) {
    let _ = exec("cat >> \"" + out_path + "\" <<'GEN_rtcore_arith_EOF'\n" + buf + "GEN_rtcore_arith_EOF")
}

fn emit_rtcore_arith_to(out_path: str) {
    // Verbatim content of hand-written self/native/rtcore_arith.c, streamed in
    // size-bounded chunks (see generator note on the per-command exec limit).
    let _ = exec("printf '' > \"" + out_path + "\"")
    let mut buf = ""
    buf = buf + "// self/native/rtcore_arith.c — zero-c leg-B r5 CLEAN-6 ARITH SEED (link de-risk).\n"
    buf = buf + "//\n"
    buf = buf + "// Supplies 6 pure-arithmetic __raw_* / __map_raw_* HexaVal wrappers that\n"
    buf = buf + "// runtime_core.c externs away under HEXA_RT_CORE_ARITH_NATIVE (the narrow\n"
    buf = buf + "// arith-only guard, NOT the broad whole-runtime HEXA_RT_SELFEMIT). Compiled to\n"
    buf = buf + "// a SEPARATE .o (build/rtcore_arith_native.o) and linked when\n"
    buf = buf + "// HEXA_ZEROC_RT_CORE_ARITH=1, so the build LINKS these bodies from a standalone\n"
    buf = buf + "// object instead of compiling them inline in runtime_core.c.\n"
    buf = buf + "//\n"
    buf = buf + "// PURPOSE = extend the r4 leaf-cluster de-risk (self/native/rtcore_leaf.c, the\n"
    buf = buf + "// 10 HexaVal value-ctors) to the SEED-PORTABLE __raw_* arithmetic class — the\n"
    buf = buf + "// next batch of runtime_core.c symbols whose every callee is external-linkage\n"
    buf = buf + "// or a macro (the seed-portability rule). It does NOT drop the .c file\n"
    buf = buf + "// (runtime_core.c drop is all-or-nothing — 250 symbols; this links 6 more).\n"
    buf = buf + "// Default build (flag unset) is byte-IDENTICAL: these bodies are not compiled\n"
    buf = buf + "// and the inline #else bodies in runtime_core.c are used verbatim.\n"
    buf = buf + "//\n"
    buf = buf + "// SEED-PORTABILITY (the r5 rule): a fn is seed-portable ONLY if EVERY callee is\n"
    buf = buf + "// external-linkage or a macro. The 6 below are clean:\n"
    buf = buf + "//   __raw_idiv    → hexa_int(ext), HX_INT(macro), `/`\n"
    buf = buf + "//   __raw_imod    → hexa_int(ext), HX_INT(macro), `%`\n"
    buf = buf + "//   __raw_d2i     → hexa_int(ext), __hx_to_double(ext), (int64_t) cast\n"
    buf = buf + "//   __raw_code_is → hexa_bool(ext), HX_INT(macro), `==`\n"
    buf = buf + "//   __raw_add_f   → hexa_int/hexa_float(ext), __hx_to_double(ext),\n"
    buf = buf + "//                   HX_IS_BOOL/HX_BOOL(macro)\n"
    buf = buf + "//   __map_raw_len → hexa_int(ext), HX_MAP_LEN(macro)\n"
    buf = buf + "//\n"
    buf = buf + "// zero-c r6 adds ONE more (clean-7):\n"
    buf = buf + "//   __raw_fmod    → rt_fmod(EXTERNAL), hexa_float/HX_FLOAT(ext/macro). The inline\n"
    buf = buf + "//                   #else body calls the frozen-STATIC hxlcl_fmod, which r5 flagged\n"
    buf = buf + "//                   as a blocker. r6 unblocks it WITHOUT touching the immutable\n"
    buf = buf + "//                   frozen blob: hxlcl_fmod is a 1-line delegate to the EXTERNAL\n"
    buf = buf + "//                   rt_fmod (frozen runtime.c:2299, no `static`), so the seed body\n"
    buf = buf + "//                   routes through rt_fmod directly — bit-identical, seed-portable.\n"
    buf = buf + "//\n"
    buf = buf + "// STILL EXCLUDED (measured WALL — frozen-immutable static callee, r6 honest 🧱):\n"
    buf = buf + "//   __raw_cmp3  → calls the frozen-STATIC hxlcl_fmod's sibling hxlcl_strcmp\n"
    buf = buf + "//                 (frozen runtime.c:324 `static int hxlcl_strcmp`) — TWICE in its\n"
    buf = buf + "//                 callee tree (directly in the str branch + transitively via the\n"
    buf = buf + "//                 static _hexa_enum_pair_idx). Unlike hxlcl_fmod, hxlcl_strcmp has\n"
    buf = buf + "//                 NO external delegate (no rt_strcmp exists), and the frozen blob\n"
    buf = buf + "//                 (the .c-graduation parent) is intentionally immutable, so the\n"
    buf = buf + "//                 static cannot be promoted via the editable emitter SSOT. Routing\n"
    buf = buf + "//                 around it would mean duplicating the strcmp byte-loop in the seed\n"
    buf = buf + "//                 + promoting 3 emitter statics that feed broader enum/cmp order\n"
    buf = buf + "//                 semantics — out of the low-risk link-de-risk scope. Stays inline.\n"
    buf = buf + "// (historical EXCLUDED note, r5 — superseded for __raw_fmod by the r6 entry above):\n"
    buf = buf + "//   __raw_fmod  → static hxlcl_fmod  (runtime.c:2357 `static double hxlcl_fmod`)\n"
    buf = buf + "//   __raw_cmp3  → static _hexa_enum_pair_idx / hxlcl_strcmp / _hx_int_slot_ordered\n"
    buf = buf + "// These two stay inline-C; a separate .o could not resolve the static callees.\n"
    if buf.len() > 65536 { _flush_rtcore_arith(out_path, buf); buf = "" }
    buf = buf + "//\n"
    buf = buf + "// The bodies are the EXACT same C as the runtime_core.c #else arms (SSOT\n"
    buf = buf + "// self/runtime_core_emit.hexa lines 3013/7715/8706/9223/9224/9435) —\n"
    buf = buf + "// byte-faithful by construction. The callees (hexa_int/hexa_float/hexa_bool/\n"
    buf = buf + "// __hx_to_double) and the macros (HX_INT/HX_FLOAT/HX_IS_BOOL/HX_BOOL/HX_MAP_LEN)\n"
    buf = buf + "// resolve from the rest of the link (runtime_core.c / runtime.h), exactly as the\n"
    buf = buf + "// r4 leaf seed's hexa_float_to_bits calls hexa_int across the .o boundary.\n"
    buf = buf + "//\n"
    buf = buf + "// This file is #include'd by a 1-line TU at seed-regen time with the runtime\n"
    buf = buf + "// headers already in scope (HexaVal / HexaTag / HX_INT / HX_FLOAT / HX_BOOL +\n"
    buf = buf + "// the extern protos for hexa_int/float/bool + __hx_to_double). Two macros that\n"
    buf = buf + "// runtime_core.c defines but runtime.h does NOT (HX_IS_BOOL / HX_MAP_LEN) are\n"
    buf = buf + "// re-declared below with #ifndef guards, byte-identical to the SSOT\n"
    buf = buf + "// (self/runtime_core_emit.hexa lines 1305 / 1262), so the seed TU compiles from\n"
    buf = buf + "// runtime.h alone — same value, no semantic change.\n"
    buf = buf + "\n"
    buf = buf + "#ifndef HX_IS_BOOL\n"
    buf = buf + "#define HX_IS_BOOL(v)   ((v).tag == TAG_BOOL)\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifndef HX_MAP_LEN\n"
    buf = buf + "#define HX_MAP_LEN(v)   ((v).map_ptr->len)\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// zero-c r6 — rt_fmod is the EXTERNAL (non-static) float-modulo core in the\n"
    buf = buf + "// frozen runtime.c (151c52c8…:2299 `HexaVal rt_fmod(...)`, no `static`). It is\n"
    buf = buf + "// the SAME body the inline __raw_fmod reaches via `hxlcl_fmod` — that static\n"
    buf = buf + "// helper (frozen runtime.c:2357) is literally\n"
    buf = buf + "// `HX_FLOAT(rt_fmod(hexa_float(x), hexa_float(y)))`. Routing the SEED body\n"
    buf = buf + "// through rt_fmod directly (extern) instead of hxlcl_fmod (static, unresolvable\n"
    buf = buf + "// across the .o boundary) is what makes __raw_fmod seed-portable in r6 — the\n"
    buf = buf + "// frozen static hxlcl_fmod is NOT promotable (the frozen blob is the immutable\n"
    buf = buf + "// .c-graduation parent), but its external delegate rt_fmod already is. runtime.h\n"
    buf = buf + "// does not declare rt_fmod, so re-declare the extern here (same prototype).\n"
    buf = buf + "extern HexaVal rt_fmod(HexaVal x, HexaVal y);\n"
    buf = buf + "\n"
    buf = buf + "HexaVal __raw_idiv(HexaVal a, HexaVal b) { return hexa_int(HX_INT(a) / HX_INT(b)); }\n"
    buf = buf + "HexaVal __raw_imod(HexaVal a, HexaVal b) { return hexa_int(HX_INT(a) % HX_INT(b)); }\n"
    buf = buf + "HexaVal __raw_d2i(HexaVal v) { return hexa_int((int64_t)__hx_to_double(v)); }\n"
    buf = buf + "HexaVal __raw_code_is(HexaVal v, HexaVal k) { return hexa_bool(HX_INT(v) == HX_INT(k)); }\n"
    buf = buf + "HexaVal __raw_add_f(HexaVal a, HexaVal b) {\n"
    buf = buf + "    if (HX_IS_BOOL(a)) a = hexa_int(HX_BOOL(a) ? 1 : 0);\n"
    buf = buf + "    if (HX_IS_BOOL(b)) b = hexa_int(HX_BOOL(b) ? 1 : 0);\n"
    buf = buf + "    return hexa_float(__hx_to_double(a) + __hx_to_double(b));\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal __map_raw_len(HexaVal m) { return hexa_int(HX_MAP_LEN(m)); }\n"
    buf = buf + "\n"
    buf = buf + "// zero-c r6 — __raw_fmod, made seed-portable by routing through EXTERNAL rt_fmod\n"
    buf = buf + "// instead of the frozen-static hxlcl_fmod. Semantically bit-identical to the\n"
    buf = buf + "// inline #else body `hexa_float(hxlcl_fmod(HX_FLOAT(a), HX_FLOAT(b)))`: expand\n"
    buf = buf + "// hxlcl_fmod = HX_FLOAT(rt_fmod(hexa_float(x), hexa_float(y))) and the outer\n"
    if buf.len() > 65536 { _flush_rtcore_arith(out_path, buf); buf = "" }
    buf = buf + "// hexa_float(HX_FLOAT(...)) re-box is identity on a float result. Both the OFF\n"
    buf = buf + "// inline arm and this seed arm therefore compute the same bits; the OFF arm is\n"
    buf = buf + "// preserved verbatim (see runtime_core_emit.hexa #else) so the default build is\n"
    buf = buf + "// byte-identical.\n"
    buf = buf + "HexaVal __raw_fmod(HexaVal a, HexaVal b) {\n"
    buf = buf + "    return hexa_float(HX_FLOAT(rt_fmod(hexa_float(HX_FLOAT(a)), hexa_float(HX_FLOAT(b)))));\n"
    buf = buf + "}\n"
    if buf.len() > 0 { _flush_rtcore_arith(out_path, buf) }
}

fn main() {
    let argv = real_args()
    let out_path = if argv.len() >= 1 { argv[0] } else { "rtcore_arith.c" }
    emit_rtcore_arith_to(out_path)
    let exists_check = exec("[ -f \"" + out_path + "\" ] && echo y || echo n").trim()
    if exists_check != "y" {
        println("[rtcore_arith_emit] FATAL: failed to write " + out_path)
        exit(1)
    }
    println("[rtcore_arith_emit] wrote " + out_path)
    exit(0)
}
