let MODULE_NAME = "rtcore_fs_read_write_emit"

fn _flush_rtcore_fs_read_write(out_path: str, buf: str) {
    let _ = exec("cat >> \"" + out_path + "\" <<'GEN_rtcore_fs_read_write_EOF'\n" + buf + "GEN_rtcore_fs_read_write_EOF")
}

