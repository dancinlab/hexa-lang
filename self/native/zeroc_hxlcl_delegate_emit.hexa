#!hexa strict
// zeroc_hxlcl_delegate_emit.hexa
//   B9.C (.c-text · #1850 pattern) — zeroc_hxlcl_delegate.c source emitter.
//
// zero-c recursive: hxlcl delegate .c emitter (ING #29 final6)
//
// Emits zeroc_hxlcl_delegate.c VERBATIM. The hexa build regenerates the .c from
// this emitter before compiling, so the emitter becomes the SSOT and the
// .c becomes a build artifact. Byte-identity (gate-1 source-SHA, proven by
// zeroc_hxlcl_delegate_byte_diff.hexa) ⇒ identical .o/.so ⇒ PERF UNCHANGED.
//
// GENERATED by tool/gen_c_text_emitter.hexa — do not hand-edit; re-run the
// generator against the hand-written .c if it ever changes.
//
// Invocation:  hexa-run zeroc_hxlcl_delegate_emit.hexa <output-path>
// Default output path (if argv missing): "zeroc_hxlcl_delegate.c" in cwd.

let MODULE_NAME = "zeroc_hxlcl_delegate_emit"

fn _flush_zeroc_hxlcl_delegate(out_path: str, buf: str) {
    let _ = exec("cat >> \"" + out_path + "\" <<'GEN_zeroc_hxlcl_delegate_EOF'\n" + buf + "GEN_zeroc_hxlcl_delegate_EOF")
}

fn emit_zeroc_hxlcl_delegate_to(out_path: str) {
    // Verbatim content of hand-written self/native/zeroc_hxlcl_delegate.c, streamed in
    // size-bounded chunks (see generator note on the per-command exec limit).
    let _ = exec("printf '' > \"" + out_path + "\"")
    let mut buf = ""
    buf = buf + "// self/native/zeroc_hxlcl_delegate.c — ZERO-C leg-B (ING #35, r11).\n"
    buf = buf + "//\n"
    buf = buf + "// The 16 hxlcl_* libc/libm wrappers that runtime_core.c calls\n"
    buf = buf + "// (hxlcl_cos/sin/exp/log/fmod + hxlcl_time/atof/atoll/popen/pclose/atexit/\n"
    buf = buf + "// signal/execvp/getrusage/gmtime_r/strftime) are `static` in the FROZEN\n"
    buf = buf + "// runtime.c blob (151c52c8…) and their DEFINITIONS sit AFTER the\n"
    buf = buf + "// runtime_core.c include boundary — so the drop-ON arena-globals seed TU\n"
    buf = buf + "// (which compiles runtime_core.c through the runtime.c PRELUDE = head only)\n"
    buf = buf + "// sees the `static` forward-decls but NOT the bodies → 16 undefined at the\n"
    buf = buf + "// standalone executable link.\n"
    buf = buf + "//\n"
    buf = buf + "// CLASSIFICATION (grep of the frozen blob): NONE of the 16 are truly-frozen\n"
    buf = buf + "// like hxlcl_strcmp (which has no external rt_* delegate line). Each is the\n"
    buf = buf + "// #3798 fmod→rt_fmod pattern: the math 5 are 1-line delegates to EXTERNAL\n"
    buf = buf + "// rt_* cores (frozen runtime.c:2407-2411 `static double hxlcl_cos(double x){\n"
    buf = buf + "// return HX_FLOAT(rt_cos(hexa_float(x))); }` etc. — rt_cos/sin/exp/log/fmod\n"
    buf = buf + "// are NON-static `HexaVal rt_*` at :2349-2401); the libc 11 are thin libc\n"
    buf = buf + "// shims (frozen :2497-3011). We re-supply all 16 as EXTERNAL (non-static)\n"
    buf = buf + "// definitions in a SEPARATE seed object — routing the math 5 through the same\n"
    buf = buf + "// external rt_* the frozen statics use (byte-faithful) and the libc 11 to real\n"
    buf = buf + "// libc. This does NOT touch the immutable frozen blob (delegate = non-frozen\n"
    buf = buf + "// path), and the DEFAULT build never compiles this file (byte-identical OFF).\n"
    buf = buf + "//\n"
    buf = buf + "// Included by a 1-line TU with runtime.h in scope (HexaVal / HX_FLOAT).\n"
    buf = buf + "//\n"
    buf = buf + "// LSP false-positive guard (r26): standalone editor-clang analysis of this file\n"
    buf = buf + "// lacks the HexaVal ABI (the drop-path TU prepends `#include \"runtime.h\"`, the\n"
    buf = buf + "// editor does not), producing a recurring 'unknown type HexaVal' diagnostic\n"
    buf = buf + "// (r23/r25, 3×). runtime.h carries its own `HEXA_RUNTIME_H` include guard, so\n"
    buf = buf + "// pulling it in only when ABSENT resolves HexaVal for standalone analysis while\n"
    buf = buf + "// staying a NO-OP under the drop path (the guard is already defined there → the\n"
    buf = buf + "// include is skipped, no double-definition). This file is drop-path-only — NEVER\n"
    buf = buf + "// in the shipping/default build — so this is byteeq-NEUTRAL.\n"
    buf = buf + "#ifndef HEXA_RUNTIME_H\n"
    buf = buf + "#include \"runtime.h\"\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "#include <stdlib.h>\n"
    buf = buf + "#include <time.h>\n"
    buf = buf + "#include <math.h>\n"
    buf = buf + "#include <signal.h>\n"
    buf = buf + "#include <unistd.h>\n"
    buf = buf + "#include <sys/resource.h>\n"
    buf = buf + "#include <stdio.h>\n"
    buf = buf + "\n"
    buf = buf + "// ── math 5: delegate to the EXTERNAL rt_* cores (frozen-static pattern) ────\n"
    buf = buf + "extern HexaVal rt_cos(HexaVal x);\n"
    buf = buf + "extern HexaVal rt_sin(HexaVal x);\n"
    buf = buf + "extern HexaVal rt_exp(HexaVal x);\n"
    buf = buf + "extern HexaVal rt_log(HexaVal x);\n"
    if buf.len() > 65536 { _flush_zeroc_hxlcl_delegate(out_path, buf); buf = "" }
    buf = buf + "extern HexaVal rt_fmod(HexaVal x, HexaVal y);\n"
    buf = buf + "double hxlcl_cos(double x)  { return HX_FLOAT(rt_cos(hexa_float(x))); }\n"
    buf = buf + "double hxlcl_sin(double x)  { return HX_FLOAT(rt_sin(hexa_float(x))); }\n"
    buf = buf + "double hxlcl_exp(double x)  { return HX_FLOAT(rt_exp(hexa_float(x))); }\n"
    buf = buf + "double hxlcl_log(double x)  { return HX_FLOAT(rt_log(hexa_float(x))); }\n"
    buf = buf + "double hxlcl_fmod(double x, double y) { return HX_FLOAT(rt_fmod(hexa_float(x), hexa_float(y))); }\n"
    buf = buf + "\n"
    buf = buf + "// ── libc 11: thin real-libc delegates (post-init path) ────────────────────\n"
    buf = buf + "long long hxlcl_atoll(const char *s) { return s ? strtoll(s, 0, 10) : 0; }\n"
    buf = buf + "double    hxlcl_atof(const char *s)  { return s ? strtod(s, 0) : 0.0; }\n"
    buf = buf + "int       hxlcl_time(int *t)         { time_t now = time(0); if (t) *t = (int)now; return (int)now; }\n"
    buf = buf + "int       hxlcl_atexit(void (*fn)(void)) { return atexit(fn); }\n"
    buf = buf + "void     *hxlcl_signal(int signum, void *handler) { return (void*)signal(signum, (void(*)(int))handler); }\n"
    buf = buf + "int       hxlcl_getrusage(int who, void *usage) { return getrusage(who, (struct rusage*)usage); }\n"
    buf = buf + "void     *hxlcl_gmtime_r(const void *tp, void *out) { return gmtime_r((const time_t*)tp, (struct tm*)out); }\n"
    buf = buf + "size_t    hxlcl_strftime(char *s, size_t max, const char *fmt, const void *tm) { return strftime(s, max, fmt, (const struct tm*)tm); }\n"
    buf = buf + "int       hxlcl_execvp(const char *file, char *const argv[]) { return execvp(file, argv); }\n"
    buf = buf + "void     *hxlcl_popen(const char *cmd, const char *mode) { return (void*)popen(cmd, mode); }\n"
    buf = buf + "int       hxlcl_pclose(void *stream) { return pclose((FILE*)stream); }\n"
    buf = buf + "\n"
    buf = buf + "// hxlcl_write — frozen-static raw write delegate (runtime.c:1997 `(long)write`).\n"
    buf = buf + "long hxlcl_write(int fd, const void *buf, unsigned long n) {\n"
    buf = buf + "    return (long)write(fd, buf, (size_t)n);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ── r23: 7 runtime.c-private mem/str statics (seedprov 0 → 1) ──────────────\n"
    buf = buf + "// These are `static __attribute__((noinline))` in the frozen runtime.c HEAD\n"
    buf = buf + "// (pre-`#include \"runtime_core.c\"` prologue, NOT post-boundary like the math 5),\n"
    buf = buf + "// so the arena-globals/drop seed TU sees the file-static forward-decls but the\n"
    buf = buf + "// linker has no exported symbol for them — UNSUPPLIED (seedprov=0). r21 MEASURED\n"
    buf = buf + "// they WALL 8 HI-tier bodies (hexa_is_error/list_dir/utc_iso_format/utc_iso_parse/\n"
    buf = buf + "// from_char_code/http_get + rt_append_file/rt_read_lines). We re-supply each as\n"
    buf = buf + "// an EXTERNAL (non-static) definition here, BYTE-FAITHFUL to the frozen body:\n"
    buf = buf + "//   * memcpy/memset/strlen/strncmp — verbatim scalar loops (output-identical to\n"
    buf = buf + "//     the frozen volatile-char loops; the `volatile` qualifier only blocks the\n"
    buf = buf + "//     compiler from folding to a libc memcpy/strlen, an OPTIMIZATION concern of\n"
    buf = buf + "//     the freestanding default build, NOT an output-bytes concern of this seed).\n"
    buf = buf + "//   * strtoll — VERBATIM reimplementation: the frozen hxlcl_strtoll is a custom\n"
    buf = buf + "//     parser (no LLONG_MAX overflow saturation, whitespace set = space/tab/nl\n"
    buf = buf + "//     only) that DEVIATES from libc strtoll, so we port the body, NOT route to\n"
    buf = buf + "//     libc (byte-faithful → reproduce exactly).\n"
    buf = buf + "//   * getenv — frozen hxlcl_getenv walks `environ` directly and its header comment\n"
    buf = buf + "//     states it \"matches libc getenv semantics (case-sensitive, first match, NULL\n"
    buf = buf + "//     on miss)\"; libc getenv gives output-identical results, so we delegate to it\n"
    buf = buf + "//     (avoids dragging the runtime.c-private `environ` capture into this TU).\n"
    buf = buf + "//   * strdup — frozen hxlcl_strdup is malloc(n+1)+byte-copy+NUL; libc strdup is\n"
    buf = buf + "//     the identical contract → output-identical bytes, delegate to libc.\n"
    buf = buf + "// This does NOT touch the immutable frozen blob; the DEFAULT build never compiles\n"
    buf = buf + "// this file (byte-identical OFF).\n"
    buf = buf + "#include <string.h>\n"
    if buf.len() > 65536 { _flush_zeroc_hxlcl_delegate(out_path, buf); buf = "" }
    buf = buf + "\n"
    buf = buf + "void *hxlcl_memcpy(void *dst, const void *src, size_t n) {\n"
    buf = buf + "    unsigned char *d = (unsigned char *)dst;\n"
    buf = buf + "    const unsigned char *s = (const unsigned char *)src;\n"
    buf = buf + "    for (size_t i = 0; i < n; i++) d[i] = s[i];\n"
    buf = buf + "    return dst;\n"
    buf = buf + "}\n"
    buf = buf + "void *hxlcl_memset(void *s, int c, size_t n) {\n"
    buf = buf + "    unsigned char *p = (unsigned char *)s;\n"
    buf = buf + "    unsigned char v = (unsigned char)c;\n"
    buf = buf + "    for (size_t i = 0; i < n; i++) p[i] = v;\n"
    buf = buf + "    return s;\n"
    buf = buf + "}\n"
    buf = buf + "size_t hxlcl_strlen(const char *s) {\n"
    buf = buf + "    if (!s) return 0;\n"
    buf = buf + "    size_t n = 0;\n"
    buf = buf + "    while (((const volatile char *)s)[n]) n++;\n"
    buf = buf + "    return n;\n"
    buf = buf + "}\n"
    buf = buf + "int hxlcl_strncmp(const char *a, const char *b, size_t n) {\n"
    buf = buf + "    for (size_t i = 0; i < n; i++) {\n"
    buf = buf + "        unsigned char ca = (unsigned char)a[i];\n"
    buf = buf + "        unsigned char cb = (unsigned char)b[i];\n"
    buf = buf + "        if (ca != cb) return (int)ca - (int)cb;\n"
    buf = buf + "        if (ca == 0) return 0;\n"
    buf = buf + "    }\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "long long hxlcl_strtoll(const char *nptr, char **endptr, int base) {\n"
    buf = buf + "    if (!nptr) { if (endptr) *endptr = (char *)nptr; return 0; }\n"
    buf = buf + "    const char *s = nptr;\n"
    buf = buf + "    while (*s == ' ' || *s == '\\t' || *s == '\\n') s++;\n"
    buf = buf + "    int sign = 1;\n"
    buf = buf + "    if (*s == '-') { sign = -1; s++; }\n"
    buf = buf + "    else if (*s == '+') s++;\n"
    buf = buf + "    if (base == 0) {\n"
    buf = buf + "        if (s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) { base = 16; s += 2; }\n"
    buf = buf + "        else if (s[0] == '0') { base = 8; s++; }\n"
    buf = buf + "        else base = 10;\n"
    buf = buf + "    } else if (base == 16 && s[0] == '0' && (s[1] == 'x' || s[1] == 'X')) {\n"
    buf = buf + "        s += 2;\n"
    buf = buf + "    }\n"
    buf = buf + "    unsigned long long n = 0;\n"
    buf = buf + "    for (;;) {\n"
    buf = buf + "        char c = *s;\n"
    buf = buf + "        int d;\n"
    buf = buf + "        if (c >= '0' && c <= '9') d = c - '0';\n"
    buf = buf + "        else if (c >= 'a' && c <= 'z') d = c - 'a' + 10;\n"
    buf = buf + "        else if (c >= 'A' && c <= 'Z') d = c - 'A' + 10;\n"
    buf = buf + "        else break;\n"
    if buf.len() > 65536 { _flush_zeroc_hxlcl_delegate(out_path, buf); buf = "" }
    buf = buf + "        if (d >= base) break;\n"
    buf = buf + "        n = n * (unsigned long long)base + (unsigned long long)d;\n"
    buf = buf + "        s++;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (endptr) *endptr = (char *)s;\n"
    buf = buf + "    return (long long)((sign < 0) ? -(long long)n : (long long)n);\n"
    buf = buf + "}\n"
    buf = buf + "char *hxlcl_getenv(const char *name) { return getenv(name); }\n"
    buf = buf + "char *hxlcl_strdup(const char *s)    { return s ? strdup(s) : (char *)0; }\n"
    buf = buf + "\n"
    buf = buf + "// ── r25: 3 runtime.c-private syscall statics (seedprov 0 → 1) ──────────────\n"
    buf = buf + "// hxlcl_clock_gettime / hxlcl_read / hxlcl_nanosleep are `static\n"
    buf = buf + "// __attribute__((noinline))` in the FROZEN runtime.c (the `#elif\n"
    buf = buf + "// defined(__linux__)` libc-fallback branch at runtime.c:1996/2025 + the unified\n"
    buf = buf + "// nanosleep at runtime.c:2574). The arena-globals/drop seed TU sees the\n"
    buf = buf + "// file-static forward-decls but the linker has no exported symbol for them —\n"
    buf = buf + "// UNSUPPLIED (seedprov=0). r24 MEASURED they WALL the time/sleep/input family\n"
    buf = buf + "// (hexa_clock/timestamp/time_ms/now_monotonic_s + hexa_sleep/_s/_ms/_ns +\n"
    buf = buf + "// hexa_input/read_stdin + read_stdin_n_c). We re-supply each as an EXTERNAL\n"
    buf = buf + "// (non-static) definition here, BYTE-FAITHFUL to the frozen Linux-branch body:\n"
    buf = buf + "//   * hxlcl_read / hxlcl_clock_gettime — verbatim 1-line libc shims (the frozen\n"
    buf = buf + "//     `#elif defined(__linux__)` bodies are exactly `(long)read(...)` and\n"
    buf = buf + "//     `clock_gettime((clockid_t)clk, (struct timespec*)ts)`).\n"
    buf = buf + "//   * hxlcl_nanosleep — VERBATIM port of the frozen unified body (runtime.c:2574):\n"
    buf = buf + "//     a clock_gettime-anchored EINTR-resume loop whose Linux arm (HXLCL_SYS_SELECT\n"
    buf = buf + "//     undefined off-Apple) sleeps the remaining interval via libc nanosleep(2),\n"
    buf = buf + "//     recomputing `left` from CLOCK_MONOTONIC so the full duration always elapses.\n"
    buf = buf + "//     Routes its inner clock reads through THIS file's hxlcl_clock_gettime (same\n"
    buf = buf + "//     contract as the frozen body's call to the runtime.c-private static).\n"
    buf = buf + "// pipe/dup2/waitpid are NOT supplied here: the exec_* family they would unlock is\n"
    buf = buf + "// independently walled by runtime.c-private file-static state (the _hexa_stream_\n"
    buf = buf + "// slots pool + the _hxa_* argv/sha256 static helpers in native/exec_argv_sha256.c),\n"
    buf = buf + "// so supplying them would add dead seedprov with no body unlocked (measured r25).\n"
    buf = buf + "// This does NOT touch the immutable frozen blob; the DEFAULT build never compiles\n"
    buf = buf + "// this file (byte-identical OFF).\n"
    buf = buf + "#include <errno.h>\n"
    buf = buf + "\n"
    buf = buf + "long hxlcl_read(int fd, void *buf, unsigned long n) { return (long)read(fd, buf, (size_t)n); }\n"
    buf = buf + "int  hxlcl_clock_gettime(int clk, void *ts) { return clock_gettime((clockid_t)clk, (struct timespec *)ts); }\n"
    buf = buf + "int  hxlcl_nanosleep(const void *req_, void *rem_) {\n"
    buf = buf + "    const struct timespec *req = (const struct timespec *)req_;\n"
    buf = buf + "    long long total_ns = (long long)req->tv_sec * 1000000000LL + (long long)req->tv_nsec;\n"
    buf = buf + "    if (rem_) { ((struct timespec *)rem_)->tv_sec = 0; ((struct timespec *)rem_)->tv_nsec = 0; }\n"
    buf = buf + "    if (total_ns <= 0) return 0;\n"
    buf = buf + "    struct timespec start; hxlcl_clock_gettime(CLOCK_MONOTONIC, &start);\n"
    buf = buf + "    for (;;) {\n"
    buf = buf + "        struct timespec now; hxlcl_clock_gettime(CLOCK_MONOTONIC, &now);\n"
    buf = buf + "        long long elapsed = ((long long)now.tv_sec - start.tv_sec) * 1000000000LL\n"
    buf = buf + "                          + ((long long)now.tv_nsec - start.tv_nsec);\n"
    buf = buf + "        long long left = total_ns - elapsed;\n"
    if buf.len() > 65536 { _flush_zeroc_hxlcl_delegate(out_path, buf); buf = "" }
    buf = buf + "        if (left <= 0) return 0;\n"
    buf = buf + "        struct timespec ts;\n"
    buf = buf + "        ts.tv_sec  = (long)(left / 1000000000LL);\n"
    buf = buf + "        ts.tv_nsec = (long)(left % 1000000000LL);\n"
    buf = buf + "        int r = nanosleep(&ts, NULL);\n"
    buf = buf + "        if (r == 0) return 0;          // full sleep done\n"
    buf = buf + "        if (errno == EINTR) continue;   // signal: recompute remaining, retry\n"
    buf = buf + "        return -1;                      // genuine error\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    if buf.len() > 0 { _flush_zeroc_hxlcl_delegate(out_path, buf) }
}

fn main() {
    let argv = real_args()
    let out_path = if argv.len() >= 1 { argv[0] } else { "zeroc_hxlcl_delegate.c" }
    emit_zeroc_hxlcl_delegate_to(out_path)
    let exists_check = exec("[ -f \"" + out_path + "\" ] && echo y || echo n").trim()
    if exists_check != "y" {
        println("[zeroc_hxlcl_delegate_emit] FATAL: failed to write " + out_path)
        exit(1)
    }
    println("[zeroc_hxlcl_delegate_emit] wrote " + out_path)
    exit(0)
}
