#!hexa strict
// rtcore_leaf_emit.hexa
//   B9.C (.c-text · #1850 pattern) — rtcore_leaf.c source emitter.
//
// zero-c leg-B r4 LEAF-CLUSTER seed (10 HexaVal ctor/reinterpret syms)
//
// Emits rtcore_leaf.c VERBATIM. The hexa build regenerates the .c from
// this emitter before compiling, so the emitter becomes the SSOT and the
// .c becomes a build artifact. Byte-identity (gate-1 source-SHA, proven by
// rtcore_leaf_byte_diff.hexa) ⇒ identical .o/.so ⇒ PERF UNCHANGED.
//
// GENERATED by tool/gen_c_text_emitter.hexa — do not hand-edit; re-run the
// generator against the hand-written .c if it ever changes.
//
// Invocation:  hexa-run rtcore_leaf_emit.hexa <output-path>
// Default output path (if argv missing): "rtcore_leaf.c" in cwd.

let MODULE_NAME = "rtcore_leaf_emit"

fn _flush_rtcore_leaf(out_path: str, buf: str) {
    let _ = exec("cat >> \"" + out_path + "\" <<'GEN_rtcore_leaf_EOF'\n" + buf + "GEN_rtcore_leaf_EOF")
}

fn emit_rtcore_leaf_to(out_path: str) {
    // Verbatim content of hand-written self/native/rtcore_leaf.c, streamed in
    // size-bounded chunks (see generator note on the per-command exec limit).
    let _ = exec("printf '' > \"" + out_path + "\"")
    let mut buf = ""
    buf = buf + "// self/native/rtcore_leaf.c — zero-c leg-B r4 LEAF-CLUSTER SEED (link de-risk).\n"
    buf = buf + "//\n"
    buf = buf + "// Supplies the 10 HexaVal value-ctor/reinterpret symbols that runtime_core.c\n"
    buf = buf + "// externs away under HEXA_RT_CORE_LEAF_NATIVE (the narrow ctor-only guard, NOT\n"
    buf = buf + "// the broad whole-runtime HEXA_RT_SELFEMIT). Compiled to a SEPARATE .o\n"
    buf = buf + "// (build/rtcore_leaf_native.o) and linked when HEXA_ZEROC_RT_CORE_LEAF=1, so\n"
    buf = buf + "// the build LINKS these bodies from a standalone object instead of compiling\n"
    buf = buf + "// them inline in runtime_core.c.\n"
    buf = buf + "//\n"
    buf = buf + "// PURPOSE = de-risk the standalone-link path (separate .o + extern + symbol\n"
    buf = buf + "// resolution across the HexaVal 16-byte struct-return ABI) that the full r5\n"
    buf = buf + "// runtime_core.c redesign needs. It does NOT drop the .c file (runtime_core.c\n"
    buf = buf + "// drop is all-or-nothing — 250 symbols; this ports 10). Default build\n"
    buf = buf + "// (flag unset) is byte-IDENTICAL: these bodies are not compiled and the\n"
    buf = buf + "// inline #else aggregate-literals in runtime_core.c are used verbatim.\n"
    buf = buf + "//\n"
    buf = buf + "// The bodies are the EXACT same C aggregate-literals as the runtime_core.c\n"
    buf = buf + "// #else arms (SSOT self/runtime_core_emit.hexa lines ~1540/1640/1654/1662/1667/\n"
    buf = buf + "// 1682/1700) — byte-faithful by construction. A future r5 step can swap this\n"
    buf = buf + "// C SSOT for hand-emitted native .s seeds (self/codegen/runtime_arm64.hexa\n"
    buf = buf + "// already has the arm64 machine code: rt_hexa_void/int/bool/float/enum_str).\n"
    buf = buf + "//\n"
    buf = buf + "// This file is #include'd by a 1-line TU at seed-regen time with the runtime\n"
    buf = buf + "// headers already in scope (HexaVal / HexaTag / HexaEnumDesc / HX_INT/HX_FLOAT).\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_int(int64_t n)   { return (HexaVal){.tag=TAG_INT,   .i=n}; }\n"
    buf = buf + "HexaVal hexa_float(double f)  { return (HexaVal){.tag=TAG_FLOAT, .f=f}; }\n"
    buf = buf + "HexaVal hexa_bool(int b)      { return (HexaVal){.tag=TAG_BOOL,  .b=b}; }\n"
    buf = buf + "HexaVal hexa_void(void)       { return (HexaVal){.tag=TAG_VOID}; }\n"
    buf = buf + "HexaVal hexa_float_to_bits(HexaVal x) { union { double d; int64_t i; } u; u.d = HX_FLOAT(x); return hexa_int(u.i); }\n"
    buf = buf + "HexaVal hexa_bits_to_float(HexaVal x) { union { int64_t i; double d; } u; u.i = HX_INT(x);   return hexa_float(u.d); }\n"
    buf = buf + "HexaVal float_to_bits(HexaVal x) { return hexa_float_to_bits(x); }\n"
    buf = buf + "HexaVal bits_to_float(HexaVal x) { return hexa_bits_to_float(x); }\n"
    buf = buf + "HexaVal hexa_enum_str(const char* display)        { return (HexaVal){.tag=TAG_ENUM, .s=(char*)display}; }\n"
    buf = buf + "HexaVal hexa_enum_str_v(const struct HexaEnumDesc* desc) { return (HexaVal){.tag=TAG_ENUM, .s=(char*)desc}; }\n"
    if buf.len() > 0 { _flush_rtcore_leaf(out_path, buf) }
}

fn main() {
    let argv = real_args()
    let out_path = if argv.len() >= 1 { argv[0] } else { "rtcore_leaf.c" }
    emit_rtcore_leaf_to(out_path)
    let exists_check = exec("[ -f \"" + out_path + "\" ] && echo y || echo n").trim()
    if exists_check != "y" {
        println("[rtcore_leaf_emit] FATAL: failed to write " + out_path)
        exit(1)
    }
    println("[rtcore_leaf_emit] wrote " + out_path)
    exit(0)
}
