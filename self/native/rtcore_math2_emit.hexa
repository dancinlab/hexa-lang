#!hexa strict
// rtcore_math2_emit.hexa
//   B9.C (.c-text · #1850 pattern) — rtcore_math2.c source emitter.
//
// zero-c leg-B r8 else-math seed (12 #else-armed math HexaVal wrappers)
//
// Emits rtcore_math2.c VERBATIM. The hexa build regenerates the .c from
// this emitter before compiling, so the emitter becomes the SSOT and the
// .c becomes a build artifact. Byte-identity (gate-1 source-SHA, proven by
// rtcore_math2_byte_diff.hexa) ⇒ identical .o/.so ⇒ PERF UNCHANGED.
//
// GENERATED by tool/gen_c_text_emitter.hexa — do not hand-edit; re-run the
// generator against the hand-written .c if it ever changes.
//
// Invocation:  hexa-run rtcore_math2_emit.hexa <output-path>
// Default output path (if argv missing): "rtcore_math2.c" in cwd.

let MODULE_NAME = "rtcore_math2_emit"

fn _flush_rtcore_math2(out_path: str, buf: str) {
    let _ = exec("cat >> \"" + out_path + "\" <<'GEN_rtcore_math2_EOF'\n" + buf + "GEN_rtcore_math2_EOF")
}

fn emit_rtcore_math2_to(out_path: str) {
    // Verbatim content of hand-written self/native/rtcore_math2.c, streamed in
    // size-bounded chunks (see generator note on the per-command exec limit).
    let _ = exec("printf '' > \"" + out_path + "\"")
    let mut buf = ""
    buf = buf + "// self/native/rtcore_math2.c — zero-c leg-B r8 ELSE-MATH SEED (link de-risk).\n"
    buf = buf + "//\n"
    buf = buf + "// Supplies 12 #else-armed math HexaVal wrappers as a SEPARATE object so that\n"
    buf = buf + "// build_aprime can LINK these bodies from a standalone .o instead of compiling\n"
    buf = buf + "// them inline in runtime_core.c:\n"
    buf = buf + "//   hexa_sqrt · hexa_pow · hexa_floor · hexa_ceil · hexa_u_floor · hexa_abs ·\n"
    buf = buf + "//   hexa_tan · hexa_log10 · hexa_round · hexa_tanh · hexa_log2 · hexa_to_float\n"
    buf = buf + "//\n"
    buf = buf + "// runtime_core.c externs these away under the narrow HEXA_RT_CORE_MATH2_NATIVE\n"
    buf = buf + "// guard (NOT the broad whole-runtime HEXA_RT_SELFEMIT). Compiled to a SEPARATE\n"
    buf = buf + "// .o (build/rtcore_math2_native.o) and linked when HEXA_ZEROC_RT_CORE_MATH2=1,\n"
    buf = buf + "// so the build LINKS these bodies from a standalone object.\n"
    buf = buf + "//\n"
    buf = buf + "// PURPOSE = the r7 census's class-(a) cluster, picked up exactly as r7 deferred\n"
    buf = buf + "// it (\"STILL EXCLUDED FROM r7 … the class-(a) #else-armed math fns\n"
    buf = buf + "// hexa_sqrt/pow/floor/… — seed-portable but inside a #if/#else, a wider surface\").\n"
    buf = buf + "// This round seeds that wider surface: each of the 12 lives inside a\n"
    buf = buf + "// `#ifndef HEXA_HAS_HEXA_RT_STDLIB / #else / #endif` pair, and in the SHIPPING\n"
    buf = buf + "// build (HEXA_HAS_HEXA_RT_STDLIB defined) the #else arm already delegates to an\n"
    buf = buf + "// EXTERNAL rt_* core. So the seed body is that exact delegate, and the 3rd #if\n"
    buf = buf + "// level (added in runtime_core_emit.hexa) externs the hexa_* definition out of\n"
    buf = buf + "// the shipping arm without touching the #ifndef standalone arm.\n"
    buf = buf + "//\n"
    buf = buf + "// It does NOT drop the .c file (runtime_core.c drop is all-or-nothing). Default\n"
    buf = buf + "// build (flag unset) is byte-IDENTICAL: these bodies are not compiled and the\n"
    buf = buf + "// inline #else delegate bodies in runtime_core.c are used verbatim (proven by\n"
    buf = buf + "// preprocessor diff — the inner #else preserves them exactly).\n"
    buf = buf + "//\n"
    buf = buf + "// SEED-PORTABILITY (the r5 rule): a fn is seed-portable ONLY if EVERY callee is\n"
    buf = buf + "// external-linkage or a macro. All 12 are clean:\n"
    buf = buf + "//   rt_sqrt/rt_pow_int/rt_pow_float/rt_floor/rt_ceil/rt_u_floor/rt_abs_int/\n"
    buf = buf + "//   rt_abs_float/rt_tan/rt_log10/rt_round/rt_tanh/rt_log2/rt_to_float — EXTERNAL\n"
    buf = buf + "//     T cores (pub fn in stdlib/runtime/{math,numeric}.hexa, linked into the\n"
    buf = buf + "//     binary), exactly like r5/r6/r7's rt_* callees.\n"
    buf = buf + "//   hexa_float / hexa_int / __hx_to_double — PUBLIC defs in runtime_core.c\n"
    buf = buf + "//     (external T symbols in the linked binary).\n"
    buf = buf + "//   HX_IS_INT / HX_INT / HX_FLOAT — macros (runtime.h:152/156/157).\n"
    buf = buf + "// No frozen-STATIC callee anywhere in this cluster (unlike r7's hxlcl_*), so no\n"
    buf = buf + "// external-delegate re-route is needed — the #else arm is already the clean\n"
    buf = buf + "// delegate. The seed body is copied VERBATIM from the runtime_core.c #else arm.\n"
    buf = buf + "//\n"
    buf = buf + "// BIT-IDENTITY: the seed bodies below are textually identical to the\n"
    buf = buf + "// runtime_core.c inline #else bodies (same C, same callees resolved from the rest\n"
    buf = buf + "// of the link), so ON and OFF compute the same bits. The OFF arm is preserved\n"
    buf = buf + "// verbatim (runtime_core_emit.hexa inner #else) so the default build is\n"
    buf = buf + "// byte-identical (cpp-proven).\n"
    buf = buf + "//\n"
    buf = buf + "// This file is #include'd by a 1-line TU at seed-regen time with the runtime\n"
    buf = buf + "// headers already in scope (HexaVal / HX_* macros + extern protos for\n"
    buf = buf + "// hexa_float / hexa_int / __hx_to_double). HX_IS_INT/HX_INT/HX_FLOAT are declared\n"
    if buf.len() > 65536 { _flush_rtcore_math2(out_path, buf); buf = "" }
    buf = buf + "// by runtime.h; the rt_* cores are NOT declared in runtime.h, so re-declare the\n"
    buf = buf + "// externs here (same prototype as the frozen runtime.c #else arm).\n"
    buf = buf + "\n"
    buf = buf + "extern HexaVal rt_sqrt(HexaVal v);\n"
    buf = buf + "extern HexaVal rt_pow_int(HexaVal b, HexaVal e);\n"
    buf = buf + "extern HexaVal rt_pow_float(HexaVal b, HexaVal e);\n"
    buf = buf + "extern HexaVal rt_floor(HexaVal v);\n"
    buf = buf + "extern HexaVal rt_ceil(HexaVal v);\n"
    buf = buf + "extern HexaVal rt_u_floor(HexaVal a, HexaVal b);\n"
    buf = buf + "extern HexaVal rt_abs_int(HexaVal v);\n"
    buf = buf + "extern HexaVal rt_abs_float(HexaVal v);\n"
    buf = buf + "extern HexaVal rt_tan(HexaVal x);\n"
    buf = buf + "extern HexaVal rt_log10(HexaVal x);\n"
    buf = buf + "extern HexaVal rt_round(HexaVal v);\n"
    buf = buf + "extern HexaVal rt_tanh(HexaVal x);\n"
    buf = buf + "extern HexaVal rt_log2(HexaVal x);\n"
    buf = buf + "extern HexaVal rt_to_float(HexaVal v);\n"
    buf = buf + "\n"
    buf = buf + "// zero-c r8 — the 12 #else-armed math wrappers, bodies copied VERBATIM from the\n"
    buf = buf + "// runtime_core.c shipping (#else) arm. Each callee is external-linkage or a macro.\n"
    buf = buf + "HexaVal hexa_sqrt(HexaVal v) {\n"
    buf = buf + "    return rt_sqrt(hexa_float(__hx_to_double(v)));\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_pow(HexaVal base, HexaVal exp) {\n"
    buf = buf + "    if (HX_IS_INT(base) && HX_IS_INT(exp) && HX_INT(exp) >= 0) {\n"
    buf = buf + "        return rt_pow_int(base, exp);\n"
    buf = buf + "    }\n"
    buf = buf + "    return rt_pow_float(hexa_float(__hx_to_double(base)),\n"
    buf = buf + "                        hexa_float(__hx_to_double(exp)));\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_floor(HexaVal v) {\n"
    buf = buf + "    return rt_floor(hexa_float(__hx_to_double(v)));\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_ceil(HexaVal v) {\n"
    buf = buf + "    return rt_ceil(hexa_float(__hx_to_double(v)));\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_u_floor(HexaVal a, HexaVal b) {\n"
    buf = buf + "    int64_t ai = HX_IS_INT(a) ? HX_INT(a) : (int64_t)__hx_to_double(a);\n"
    buf = buf + "    int64_t bi = HX_IS_INT(b) ? HX_INT(b) : (int64_t)__hx_to_double(b);\n"
    buf = buf + "    return rt_u_floor(hexa_int(ai), hexa_int(bi));\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_abs(HexaVal v) {\n"
    buf = buf + "    if (HX_IS_INT(v)) return rt_abs_int(v);\n"
    buf = buf + "    return rt_abs_float(v);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_tan(HexaVal v)   { return rt_tan(hexa_float(__hx_to_double(v))); }\n"
    buf = buf + "HexaVal hexa_log10(HexaVal v) { return rt_log10(hexa_float(__hx_to_double(v))); }\n"
    buf = buf + "HexaVal hexa_round(HexaVal v) { return rt_round(hexa_float(__hx_to_double(v))); }\n"
    buf = buf + "HexaVal hexa_tanh(HexaVal v)  { return rt_tanh(hexa_float(__hx_to_double(v))); }\n"
    buf = buf + "HexaVal hexa_log2(HexaVal v)  { return rt_log2(hexa_float(__hx_to_double(v))); }\n"
    if buf.len() > 65536 { _flush_rtcore_math2(out_path, buf); buf = "" }
    buf = buf + "HexaVal hexa_to_float(HexaVal v) {\n"
    buf = buf + "    return rt_to_float(hexa_float(__hx_to_double(v)));\n"
    buf = buf + "}\n"
    if buf.len() > 0 { _flush_rtcore_math2(out_path, buf) }
}

fn main() {
    let argv = real_args()
    let out_path = if argv.len() >= 1 { argv[0] } else { "rtcore_math2.c" }
    emit_rtcore_math2_to(out_path)
    let exists_check = exec("[ -f \"" + out_path + "\" ] && echo y || echo n").trim()
    if exists_check != "y" {
        println("[rtcore_math2_emit] FATAL: failed to write " + out_path)
        exit(1)
    }
    println("[rtcore_math2_emit] wrote " + out_path)
    exit(0)
}
