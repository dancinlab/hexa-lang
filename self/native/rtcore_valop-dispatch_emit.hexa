#!hexa strict
// rtcore_valop-dispatch_emit.hexa
//   B9.C (.c-text · #1850 pattern) — rtcore_valop-dispatch.c source emitter.
//
// zero-c leg-B r9 valop-dispatch seed (9 scalar arith/compare dispatchers)
//
// Emits rtcore_valop-dispatch.c VERBATIM. The hexa build regenerates the .c
// from this emitter before compiling, so the emitter becomes the SSOT and the
// .c becomes a build artifact. Byte-identity (gate-1 source-SHA, proven by
// rtcore_valop-dispatch_byte_diff.hexa) ⇒ identical .o/.so ⇒ PERF UNCHANGED.
//
// GENERATED by tool/gen_c_text_emitter.hexa — do not hand-edit; re-run the
// generator against the hand-written .c if it ever changes.
//
// Invocation:  hexa-run rtcore_valop-dispatch_emit.hexa <output-path>
// Default output path (if argv missing): "rtcore_valop-dispatch.c" in cwd.

let MODULE_NAME = "rtcore_valop-dispatch_emit"

fn _flush_rtcore_valop_dispatch(out_path: str, buf: str) {
    let _ = exec("cat >> \"" + out_path + "\" <<'GEN_rtcore_valop_dispatch_EOF'\n" + buf + "GEN_rtcore_valop_dispatch_EOF")
}

fn emit_rtcore_valop_dispatch_to(out_path: str) {
    // Verbatim content of hand-written self/native/rtcore_valop-dispatch.c,
    // streamed in size-bounded chunks (see generator note on the per-command
    // exec limit).
    let _ = exec("printf '' > \"" + out_path + "\"")
    let mut buf = ""
    buf = buf + "// self/native/rtcore_valop-dispatch.c — zero-c leg-B r9 VALOP-DISPATCH SEED (link de-risk).\n"
    buf = buf + "//\n"
    buf = buf + "// Supplies 9 scalar arithmetic / ordered-compare DISPATCHER HexaVal wrappers as a\n"
    buf = buf + "// SEPARATE object so that build_aprime can LINK these bodies from a standalone .o\n"
    buf = buf + "// instead of compiling them inline in runtime_core.c:\n"
    buf = buf + "//   hexa_add_slow · hexa_sub · hexa_mul · hexa_div · hexa_mod ·\n"
    buf = buf + "//   hexa_cmp_lt · hexa_cmp_gt · hexa_cmp_le · hexa_cmp_ge\n"
    buf = buf + "//\n"
    buf = buf + "// runtime_core.c externs these away under the narrow HEXA_RT_CORE_VALOP_DISPATCH_NATIVE\n"
    buf = buf + "// guard (NOT the broad whole-runtime HEXA_RT_SELFEMIT). Compiled to a SEPARATE\n"
    buf = buf + "// .o (build/rtcore_valop-dispatch_native.o) and linked when\n"
    buf = buf + "// HEXA_ZEROC_RT_CORE_VALOP_DISPATCH=1, so the build LINKS these bodies from a\n"
    buf = buf + "// standalone object.\n"
    buf = buf + "//\n"
    buf = buf + "// PURPOSE = the M5 valop-dispatch cluster — the thin C dispatchers that sit ABOVE\n"
    buf = buf + "// the already-seeded valop_core_*.s scalar leaves (rt_add/sub/mul/div/mod_native,\n"
    buf = buf + "// rt_cmp_*_native — #3704/#3729/#3731/#3733, default-ON) and the hexa-source\n"
    buf = buf + "// fallbacks (rt_add_slow/rt_sub/rt_mul/rt_div/rt_mod/rt_cmp_* in\n"
    buf = buf + "// stdlib/runtime/numeric.hexa). Each dispatcher just picks the native fast path\n"
    buf = buf + "// for scalar operands and delegates the rest — so EVERY callee is external-linkage\n"
    buf = buf + "// or a macro (the r5 seed-portability rule), with NO frozen-static callee.\n"
    buf = buf + "//\n"
    buf = buf + "// It does NOT drop the .c file (runtime_core.c drop is all-or-nothing). Default\n"
    buf = buf + "// build (flag unset) is byte-IDENTICAL: these bodies are not compiled and the\n"
    buf = buf + "// inline shipping-arm bodies in runtime_core.c are used verbatim (cpp-proven — the\n"
    buf = buf + "// new outer #else preserves the whole HEXA_HAS_HEXA_RT_STDLIB block exactly).\n"
    buf = buf + "//\n"
    buf = buf + "// SEED-PORTABILITY (the r5 rule): a fn is seed-portable ONLY if EVERY callee is\n"
    buf = buf + "// external-linkage or a macro. All 9 are clean:\n"
    buf = buf + "//   rt_add_native/rt_add_slow · rt_sub/rt_sub_native · rt_mul/rt_mul_native ·\n"
    buf = buf + "//   rt_div/rt_div_native · rt_mod/rt_mod_native · rt_cmp_{lt,gt,le,ge} ·\n"
    buf = buf + "//   rt_cmp_{lt,gt,le,ge}_native — EXTERNAL T cores (valop_core_*.s seeds + hexa-\n"
    buf = buf + "//     source numeric.hexa, linked into the binary).\n"
    buf = buf + "//   hexa_int — PUBLIC def in runtime_core.c (external T symbol in the link).\n"
    buf = buf + "//   HX_IS_INT/HX_IS_FLOAT/HX_INT/HX_IS_BOOL/HX_BOOL — macros.\n"
    buf = buf + "//   _HX_COERCE_BOOL/_HX_CMP_NATIVE_ELIGIBLE — function-like macros (re-declared\n"
    buf = buf + "//     below, byte-identical to the runtime_core.c SSOT).\n"
    buf = buf + "// No frozen-STATIC callee anywhere (unlike r6's hxlcl_strcmp / __raw_cmp3), so no\n"
    buf = buf + "// external-delegate re-route is needed.\n"
    buf = buf + "//\n"
    buf = buf + "// BIT-IDENTITY: the 9 seed bodies below are textually identical to the\n"
    buf = buf + "// runtime_core.c shipping-arm bodies (HEXA_HAS_HEXA_RT_STDLIB + HEXA_RT_VALOP_NATIVE\n"
    buf = buf + "// both defined — the release build), same C, same callees resolved from the rest of\n"
    buf = buf + "// the link, so ON and OFF compute the same bits. The OFF arm is preserved verbatim\n"
    buf = buf + "// (runtime_core_emit.hexa outer #else) so the default build is byte-identical.\n"
    buf = buf + "//\n"
    buf = buf + "// This file is #include'd by a 1-line TU at seed-regen time with the runtime\n"
    buf = buf + "// headers already in scope (HexaVal / HX_* scalar macros + extern proto for\n"
    buf = buf + "// hexa_int). HX_INT/HX_BOOL/HX_IS_INT/HX_IS_FLOAT are declared by runtime.h; the\n"
    buf = buf + "// rt_* cores + HX_IS_BOOL + the two function-like macros are NOT, so re-declare\n"
    buf = buf + "// them here (same prototype / same expansion as the frozen runtime_core.c SSOT).\n"
    if buf.len() > 65536 { _flush_rtcore_valop_dispatch(out_path, buf); buf = "" }
    buf = buf + "\n"
    buf = buf + "extern HexaVal hexa_int(int64_t v);\n"
    buf = buf + "extern HexaVal rt_add_slow(HexaVal a, HexaVal b);\n"
    buf = buf + "extern HexaVal rt_add_native(HexaVal a, HexaVal b);\n"
    buf = buf + "extern HexaVal rt_sub(HexaVal a, HexaVal b);\n"
    buf = buf + "extern HexaVal rt_sub_native(HexaVal a, HexaVal b);\n"
    buf = buf + "extern HexaVal rt_mul(HexaVal a, HexaVal b);\n"
    buf = buf + "extern HexaVal rt_mul_native(HexaVal a, HexaVal b);\n"
    buf = buf + "extern HexaVal rt_div(HexaVal a, HexaVal b);\n"
    buf = buf + "extern HexaVal rt_div_native(HexaVal a, HexaVal b);\n"
    buf = buf + "extern HexaVal rt_mod(HexaVal a, HexaVal b);\n"
    buf = buf + "extern HexaVal rt_mod_native(HexaVal a, HexaVal b);\n"
    buf = buf + "extern HexaVal rt_cmp_lt(HexaVal a, HexaVal b);\n"
    buf = buf + "extern HexaVal rt_cmp_gt(HexaVal a, HexaVal b);\n"
    buf = buf + "extern HexaVal rt_cmp_le(HexaVal a, HexaVal b);\n"
    buf = buf + "extern HexaVal rt_cmp_ge(HexaVal a, HexaVal b);\n"
    buf = buf + "extern HexaVal rt_cmp_lt_native(HexaVal a, HexaVal b);\n"
    buf = buf + "extern HexaVal rt_cmp_gt_native(HexaVal a, HexaVal b);\n"
    buf = buf + "extern HexaVal rt_cmp_le_native(HexaVal a, HexaVal b);\n"
    buf = buf + "extern HexaVal rt_cmp_ge_native(HexaVal a, HexaVal b);\n"
    buf = buf + "\n"
    buf = buf + "#ifndef HX_IS_BOOL\n"
    buf = buf + "#define HX_IS_BOOL(v)   ((v).tag == TAG_BOOL)\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifndef _HX_COERCE_BOOL\n"
    buf = buf + "#define _HX_COERCE_BOOL(_a, _b) do { \\\n"
    buf = buf + "    if (HX_IS_BOOL(_a)) _a = hexa_int(HX_BOOL(_a) ? 1 : 0); \\\n"
    buf = buf + "    if (HX_IS_BOOL(_b)) _b = hexa_int(HX_BOOL(_b) ? 1 : 0); \\\n"
    buf = buf + "} while (0)\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifndef _HX_CMP_NATIVE_ELIGIBLE\n"
    buf = buf + "#define _HX_CMP_NATIVE_ELIGIBLE(a, b) \\\n"
    buf = buf + "    ((HX_IS_INT(a) || HX_IS_FLOAT(a)) && (HX_IS_INT(b) || HX_IS_FLOAT(b)))\n"
    buf = buf + "#endif\n"
    buf = buf + "\n"
    buf = buf + "// zero-c r9 — the 9 valop dispatchers, bodies copied VERBATIM from the\n"
    buf = buf + "// runtime_core.c shipping arm (HEXA_HAS_HEXA_RT_STDLIB + HEXA_RT_VALOP_NATIVE).\n"
    buf = buf + "HexaVal hexa_add_slow(HexaVal a, HexaVal b) {\n"
    buf = buf + "    if (HX_IS_BOOL(a)) a = hexa_int(HX_BOOL(a) ? 1 : 0);\n"
    buf = buf + "    if (HX_IS_BOOL(b)) b = hexa_int(HX_BOOL(b) ? 1 : 0);\n"
    buf = buf + "    int _na = HX_IS_INT(a) || HX_IS_FLOAT(a);\n"
    buf = buf + "    int _nb = HX_IS_INT(b) || HX_IS_FLOAT(b);\n"
    buf = buf + "    if (_na && _nb) return rt_add_native(a, b);\n"
    buf = buf + "    return rt_add_slow(a, b);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_sub(HexaVal a, HexaVal b) {\n"
    buf = buf + "    _HX_COERCE_BOOL(a, b);\n"
    buf = buf + "    int _na = HX_IS_INT(a) || HX_IS_FLOAT(a);\n"
    buf = buf + "    int _nb = HX_IS_INT(b) || HX_IS_FLOAT(b);\n"
    buf = buf + "    if (_na && _nb) return rt_sub_native(a, b);\n"
    buf = buf + "    return rt_sub(a, b);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_mul(HexaVal a, HexaVal b) {\n"
    buf = buf + "    _HX_COERCE_BOOL(a, b);\n"
    buf = buf + "    int _na = HX_IS_INT(a) || HX_IS_FLOAT(a);\n"
    buf = buf + "    int _nb = HX_IS_INT(b) || HX_IS_FLOAT(b);\n"
    buf = buf + "    if (_na && _nb) return rt_mul_native(a, b);\n"
    buf = buf + "    return rt_mul(a, b);\n"
    buf = buf + "}\n"
    if buf.len() > 65536 { _flush_rtcore_valop_dispatch(out_path, buf); buf = "" }
    buf = buf + "HexaVal hexa_div(HexaVal a, HexaVal b) {\n"
    buf = buf + "    _HX_COERCE_BOOL(a, b);\n"
    buf = buf + "    if (HX_IS_INT(a) && HX_IS_INT(b) && HX_INT(b) != 0) return rt_div_native(a, b);\n"
    buf = buf + "    return rt_div(a, b);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_mod(HexaVal a, HexaVal b) {\n"
    buf = buf + "    _HX_COERCE_BOOL(a, b);\n"
    buf = buf + "    if (HX_IS_INT(a) && HX_IS_INT(b) && HX_INT(b) != 0) return rt_mod_native(a, b);\n"
    buf = buf + "    return rt_mod(a, b);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_cmp_lt(HexaVal a, HexaVal b) {\n"
    buf = buf + "    if (_HX_CMP_NATIVE_ELIGIBLE(a, b)) return rt_cmp_lt_native(a, b);\n"
    buf = buf + "    return rt_cmp_lt(a, b);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_cmp_gt(HexaVal a, HexaVal b) {\n"
    buf = buf + "    if (_HX_CMP_NATIVE_ELIGIBLE(a, b)) return rt_cmp_gt_native(a, b);\n"
    buf = buf + "    return rt_cmp_gt(a, b);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_cmp_le(HexaVal a, HexaVal b) {\n"
    buf = buf + "    if (_HX_CMP_NATIVE_ELIGIBLE(a, b)) return rt_cmp_le_native(a, b);\n"
    buf = buf + "    return rt_cmp_le(a, b);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_cmp_ge(HexaVal a, HexaVal b) {\n"
    buf = buf + "    if (_HX_CMP_NATIVE_ELIGIBLE(a, b)) return rt_cmp_ge_native(a, b);\n"
    buf = buf + "    return rt_cmp_ge(a, b);\n"
    buf = buf + "}\n"
    if buf.len() > 0 { _flush_rtcore_valop_dispatch(out_path, buf) }
}

fn main() {
    let argv = real_args()
    let out_path = if argv.len() >= 1 { argv[0] } else { "rtcore_valop-dispatch.c" }
    emit_rtcore_valop_dispatch_to(out_path)
    let exists_check = exec("[ -f \"" + out_path + "\" ] && echo y || echo n").trim()
    if exists_check != "y" {
        println("[rtcore_valop-dispatch_emit] FATAL: failed to write " + out_path)
        exit(1)
    }
    println("[rtcore_valop-dispatch_emit] wrote " + out_path)
    exit(0)
}
