#!hexa strict
// rtcore_math_emit.hexa
//   B9.C (.c-text · #1850 pattern) — rtcore_math.c source emitter.
//
// zero-c leg-B r7 clean-4 transcendental seed (sin/cos/exp/log)
//
// Emits rtcore_math.c VERBATIM. The hexa build regenerates the .c from
// this emitter before compiling, so the emitter becomes the SSOT and the
// .c becomes a build artifact. Byte-identity (gate-1 source-SHA, proven by
// rtcore_math_byte_diff.hexa) ⇒ identical .o/.so ⇒ PERF UNCHANGED.
//
// GENERATED by tool/gen_c_text_emitter.hexa — do not hand-edit; re-run the
// generator against the hand-written .c if it ever changes.
//
// Invocation:  hexa-run rtcore_math_emit.hexa <output-path>
// Default output path (if argv missing): "rtcore_math.c" in cwd.

let MODULE_NAME = "rtcore_math_emit"

fn _flush_rtcore_math(out_path: str, buf: str) {
    let _ = exec("cat >> \"" + out_path + "\" <<'GEN_rtcore_math_EOF'\n" + buf + "GEN_rtcore_math_EOF")
}

fn emit_rtcore_math_to(out_path: str) {
    // Verbatim content of hand-written self/native/rtcore_math.c, streamed in
    // size-bounded chunks (see generator note on the per-command exec limit).
    let _ = exec("printf '' > \"" + out_path + "\"")
    let mut buf = ""
    buf = buf + "// self/native/rtcore_math.c — zero-c leg-B r7 CLEAN-4 TRANSCENDENTAL SEED (link de-risk).\n"
    buf = buf + "//\n"
    buf = buf + "// Supplies 4 pure-transcendental HexaVal wrappers (hexa_sin / hexa_cos /\n"
    buf = buf + "// hexa_exp / hexa_log) that runtime_core.c externs away under\n"
    buf = buf + "// HEXA_RT_CORE_MATH_NATIVE (the narrow math-only guard, NOT the broad\n"
    buf = buf + "// whole-runtime HEXA_RT_SELFEMIT). Compiled to a SEPARATE .o\n"
    buf = buf + "// (build/rtcore_math_native.o) and linked when HEXA_ZEROC_RT_CORE_MATH=1, so the\n"
    buf = buf + "// build LINKS these bodies from a standalone object instead of compiling them\n"
    buf = buf + "// inline in runtime_core.c.\n"
    buf = buf + "//\n"
    buf = buf + "// PURPOSE = extend the r4 leaf-cluster (rtcore_leaf.c, 10 HexaVal ctors), r5\n"
    buf = buf + "// clean-6 arith (rtcore_arith.c), and r6 clean-7 +__raw_fmod de-risk to the next\n"
    buf = buf + "// seed-portable cluster: the transcendental float ops. It does NOT drop the .c\n"
    buf = buf + "// file (runtime_core.c drop is all-or-nothing — 250 symbols; this links 4 more).\n"
    buf = buf + "// Default build (flag unset) is byte-IDENTICAL: these bodies are not compiled and\n"
    buf = buf + "// the inline #else bodies in runtime_core.c are used verbatim.\n"
    buf = buf + "//\n"
    buf = buf + "// CENSUS (r7): the math cluster in runtime_core.c splits into TWO seed-portability\n"
    buf = buf + "// classes under the shipping HEXA_HAS_HEXA_RT_STDLIB build:\n"
    buf = buf + "//   (a) hexa_sqrt/pow/floor/ceil/u_floor/abs/tan/log10/round/tanh/log2/to_float —\n"
    buf = buf + "//       their #else arm already delegates to EXTERNAL rt_* (e.g. rt_sqrt, rt_pow_*,\n"
    buf = buf + "//       rt_floor); already seed-portable BUT they live inside a #ifndef/#else pair,\n"
    buf = buf + "//       so seeding them means a 3rd #if level — deferred to r8 (larger surface).\n"
    buf = buf + "//   (b) hexa_sin/cos/exp/log — emitted UNCONDITIONALLY (no #else arm) as\n"
    buf = buf + "//       `hexa_float(hxlcl_*(__hx_to_double(v)))`, where hxlcl_sin/cos/exp/log are\n"
    buf = buf + "//       FROZEN-STATIC helpers (151c52c8…:2358-2361 `static double hxlcl_*`). At\n"
    buf = buf + "//       first glance the static callee is an r6-style WALL — but exactly like r6's\n"
    buf = buf + "//       hxlcl_fmod, each hxlcl_* is a 1-line delegate to an EXTERNAL rt_* core:\n"
    buf = buf + "//         static double hxlcl_sin(double x) { return HX_FLOAT(rt_sin(hexa_float(x))); }\n"
    buf = buf + "//         (151c52c8…:2358 rt_exp / :2322 rt_log / :2333 rt_cos / :2345 rt_sin —\n"
    buf = buf + "//          all `HexaVal rt_*(...)`, NO `static`). So routing the SEED body through\n"
    buf = buf + "//       rt_sin/cos/exp/log directly (extern) instead of the frozen-static hxlcl_*\n"
    buf = buf + "//       makes hexa_sin/cos/exp/log seed-portable WITHOUT touching the immutable\n"
    buf = buf + "//       frozen blob. This is the r6 external-delegate route applied to class (b).\n"
    buf = buf + "//   These 4 are the r7 cluster.\n"
    buf = buf + "//\n"
    buf = buf + "// SEED-PORTABILITY (the r5 rule): a fn is seed-portable ONLY if EVERY callee is\n"
    buf = buf + "// external-linkage or a macro. The 4 below are clean via the delegate route:\n"
    buf = buf + "//   hexa_sin → rt_sin(EXTERNAL), hexa_float/__hx_to_double(ext), HX_FLOAT(macro)\n"
    buf = buf + "//   hexa_cos → rt_cos(EXTERNAL), hexa_float/__hx_to_double(ext), HX_FLOAT(macro)\n"
    buf = buf + "//   hexa_exp → rt_exp(EXTERNAL), hexa_float/__hx_to_double(ext), HX_FLOAT(macro)\n"
    buf = buf + "//   hexa_log → rt_log(EXTERNAL), hexa_float/__hx_to_double(ext), HX_FLOAT(macro)\n"
    buf = buf + "// (hexa_float / __hx_to_double are PUBLIC defs in runtime_core.c — external T\n"
    buf = buf + "//  symbols in the linked binary, exactly like the r5/r6 arith seed's callees.)\n"
    buf = buf + "//\n"
    buf = buf + "// STILL EXCLUDED FROM r7 (deferred, not walled): the class-(a) #else-armed math\n"
    buf = buf + "// fns (hexa_sqrt/pow/floor/…) — seed-portable but inside a #if/#else, a wider\n"
    buf = buf + "// surface than this focused 4-fn de-risk. hexa_tan/log10/round/tanh/log2 likewise\n"
    buf = buf + "// have an #else arm; only sin/cos/exp/log are #else-LESS, so they are the cluster\n"
    buf = buf + "// where the frozen-static delegate route is the ONLY way to link them out.\n"
    if buf.len() > 65536 { _flush_rtcore_math(out_path, buf); buf = "" }
    buf = buf + "//\n"
    buf = buf + "// BIT-IDENTITY: the OFF inline body `hexa_float(hxlcl_sin(__hx_to_double(v)))`\n"
    buf = buf + "// expands (hxlcl_sin = HX_FLOAT(rt_sin(hexa_float(x)))) to\n"
    buf = buf + "// `hexa_float(HX_FLOAT(rt_sin(hexa_float(__hx_to_double(v)))))` — exactly the seed\n"
    buf = buf + "// body below. The outer hexa_float(HX_FLOAT(...)) re-box is identity on a float\n"
    buf = buf + "// result, so both arms compute the same bits; the OFF arm is preserved verbatim\n"
    buf = buf + "// (runtime_core_emit.hexa #else) so the default build is byte-identical.\n"
    buf = buf + "//\n"
    buf = buf + "// This file is #include'd by a 1-line TU at seed-regen time with the runtime\n"
    buf = buf + "// headers already in scope (HexaVal / HX_FLOAT + extern protos for\n"
    buf = buf + "// hexa_float / __hx_to_double). HX_FLOAT is declared by runtime.h; no extra\n"
    buf = buf + "// re-declares are needed for this cluster (unlike the arith seed's HX_IS_BOOL /\n"
    buf = buf + "// HX_MAP_LEN). rt_sin/cos/exp/log are not declared in runtime.h, so re-declare\n"
    buf = buf + "// the externs here (same prototype as the frozen runtime.c).\n"
    buf = buf + "\n"
    buf = buf + "extern HexaVal rt_sin(HexaVal x);\n"
    buf = buf + "extern HexaVal rt_cos(HexaVal x);\n"
    buf = buf + "extern HexaVal rt_exp(HexaVal x);\n"
    buf = buf + "extern HexaVal rt_log(HexaVal x);\n"
    buf = buf + "\n"
    buf = buf + "// zero-c r7 — hexa_sin/cos/exp/log, made seed-portable by routing through the\n"
    buf = buf + "// EXTERNAL rt_* cores instead of the frozen-static hxlcl_* delegates. Each is the\n"
    buf = buf + "// expanded form of the inline #else body and computes bit-identical results.\n"
    buf = buf + "HexaVal hexa_sin(HexaVal v) { return hexa_float(HX_FLOAT(rt_sin(hexa_float(__hx_to_double(v))))); }\n"
    buf = buf + "HexaVal hexa_cos(HexaVal v) { return hexa_float(HX_FLOAT(rt_cos(hexa_float(__hx_to_double(v))))); }\n"
    buf = buf + "HexaVal hexa_exp(HexaVal v) { return hexa_float(HX_FLOAT(rt_exp(hexa_float(__hx_to_double(v))))); }\n"
    buf = buf + "HexaVal hexa_log(HexaVal v) { return hexa_float(HX_FLOAT(rt_log(hexa_float(__hx_to_double(v))))); }\n"
    if buf.len() > 0 { _flush_rtcore_math(out_path, buf) }
}

fn main() {
    let argv = real_args()
    let out_path = if argv.len() >= 1 { argv[0] } else { "rtcore_math.c" }
    emit_rtcore_math_to(out_path)
    let exists_check = exec("[ -f \"" + out_path + "\" ] && echo y || echo n").trim()
    if exists_check != "y" {
        println("[rtcore_math_emit] FATAL: failed to write " + out_path)
        exit(1)
    }
    println("[rtcore_math_emit] wrote " + out_path)
    exit(0)
}
