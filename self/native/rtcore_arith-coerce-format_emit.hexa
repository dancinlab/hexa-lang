#!hexa strict
// rtcore_arith_coerce_format_emit.hexa
//   B9.C (.c-text · #1850 pattern) — rtcore_arith_coerce_format.c source emitter.
//
// zero-c leg-B rtcore arith-coerce-format seed (ING #29)
//
// Emits rtcore_arith_coerce_format.c VERBATIM. The hexa build regenerates the .c from
// this emitter before compiling, so the emitter becomes the SSOT and the
// .c becomes a build artifact. Byte-identity (gate-1 source-SHA, proven by
// rtcore_arith_coerce_format_byte_diff.hexa) ⇒ identical .o/.so ⇒ PERF UNCHANGED.
//
// GENERATED by tool/gen_c_text_emitter.hexa — do not hand-edit; re-run the
// generator against the hand-written .c if it ever changes.
//
// Invocation:  hexa-run rtcore_arith_coerce_format_emit.hexa <output-path>
// Default output path (if argv missing): "rtcore_arith_coerce_format.c" in cwd.

let MODULE_NAME = "rtcore_arith_coerce_format_emit"

fn _flush_rtcore_arith_coerce_format(out_path: str, buf: str) {
    let _ = exec("cat >> \"" + out_path + "\" <<'GEN_rtcore_arith_coerce_format_EOF'\n" + buf + "GEN_rtcore_arith_coerce_format_EOF")
}

fn emit_rtcore_arith_coerce_format_to(out_path: str) {
    // Verbatim content of hand-written self/native/rtcore_arith_coerce_format.c, streamed in
    // size-bounded chunks (see generator note on the per-command exec limit).
    let _ = exec("printf '' > \"" + out_path + "\"")
    let mut buf = ""
    buf = buf + "// self/native/rtcore_arith-coerce-format.c — zero-c leg-B ARITH-COERCE-FORMAT\n"
    buf = buf + "// SEED (link de-risk). Mirrors the r4 leaf / r5 arith cluster pattern\n"
    buf = buf + "// (self/native/rtcore_leaf.c, self/native/rtcore_arith.c).\n"
    buf = buf + "//\n"
    buf = buf + "// Supplies 10 numeric/coercion/format HexaVal wrappers that runtime_core.c\n"
    buf = buf + "// externs away under HEXA_RT_CORE_ARITH_COERCE_FORMAT_NATIVE (the narrow\n"
    buf = buf + "// cluster-only guard, NOT the broad whole-runtime HEXA_RT_SELFEMIT). Compiled\n"
    buf = buf + "// to a SEPARATE .o (build/rtcore_arith-coerce-format_native.o) and linked when\n"
    buf = buf + "// HEXA_ZEROC_RT_CORE_ARITH_COERCE_FORMAT=1, so the build LINKS these bodies\n"
    buf = buf + "// from a standalone object instead of compiling them inline in runtime_core.c.\n"
    buf = buf + "// Default build (flag unset) is byte-IDENTICAL: these bodies are not compiled\n"
    buf = buf + "// and the inline #else bodies in runtime_core.c are used verbatim.\n"
    buf = buf + "//\n"
    buf = buf + "// SEED-PORTABILITY (the r5 rule): a fn is seed-portable ONLY if EVERY callee is\n"
    buf = buf + "// external-linkage or a macro. A static internal-linkage callee a separate .o\n"
    buf = buf + "// cannot resolve = BLOCK. The 10 below are the SHIPPED-PATH bodies (the build\n"
    buf = buf + "// always defines HEXA_HAS_HEXA_RT_STDLIB), each of which delegates to an\n"
    buf = buf + "// external rt_* / public hexa_* helper or a macro — verified seed-portable:\n"
    buf = buf + "//   hexa_concat_many      → hexa_array_new/hexa_array_push/rt_concat_many_arr (ext) + hexa_str (ext)\n"
    buf = buf + "//   hexa_fma              → rt_fma_int/rt_fma_float/hexa_float/__hx_to_double (ext) + HX_IS_INT (macro)\n"
    buf = buf + "//   hexa_len              → rt_len (ext) + HX_INT (macro)        [int64_t ret]\n"
    buf = buf + "//   hexa_null_coal        → rt_null_coal (ext)\n"
    buf = buf + "//   hexa_to_int           → rt_to_int (ext)\n"
    buf = buf + "//   hexa_format           → hexa_to_string/rt_format (ext) + HX_IS_STR (macro)\n"
    buf = buf + "//   hexa_format_float     → rt_format_float_f/hexa_float/__hx_to_double (ext)\n"
    buf = buf + "//   hexa_format_float_sci → rt_format_float_sci/hexa_float/__hx_to_double (ext)\n"
    buf = buf + "//   hexa_print            → rt_print (ext)\n"
    buf = buf + "//   hexa_str_char_at      → rt_str_char_at/hexa_str (ext) + HX_IS_STR (macro)\n"
    buf = buf + "//\n"
    buf = buf + "// EXPLICITLY EXCLUDED (NOT clean / out of scope — recorded so the census is\n"
    buf = buf + "// honest, no filler):\n"
    buf = buf + "//   hexa_add_slow / hexa_sub / hexa_mul / hexa_div / hexa_truthy — each carries\n"
    buf = buf + "//     an INNER `#ifdef HEXA_RT_VALOP_NATIVE` arm and is owned by the VALOP\n"
    buf = buf + "//     native lane (rt_add_native/rt_sub_native/rt_mul_native/rt_div_native/\n"
    buf = buf + "//     rt_truthy_native, self/native/valop_core_*.s). Porting them via THIS\n"
    buf = buf + "//     cluster would shadow the valop fast path when both seeds are co-enabled\n"
    buf = buf + "//     (a cross-lane flag interaction). Left to the valop lane = no regression.\n"
    buf = buf + "//   hexa_str_byte_at / hexa_str_char_code_at — use HX_STRLEN, which expands to\n"
    buf = buf + "//     `hexa_strlen_v_inline(...)`, a `static inline` callee (runtime_core.c:780)\n"
    buf = buf + "//     that a separate .o cannot resolve from runtime.h alone = BLOCK (the r5\n"
    buf = buf + "//     static-callee rule).\n"
    buf = buf + "//\n"
    buf = buf + "// The bodies are the EXACT same C as the runtime_core.c HEXA_HAS_HEXA_RT_STDLIB\n"
    buf = buf + "// arms (SSOT self/runtime_core_emit.hexa) — byte-faithful by construction. The\n"
    buf = buf + "// callees (hexa_array_new/hexa_array_push/hexa_str/hexa_to_string/hexa_float/\n"
    buf = buf + "// __hx_to_double + the rt_* delegates) resolve from the rest of the link\n"
    buf = buf + "// (runtime_core.c / the hexa-source stdlib), exactly as the r5 arith seed's\n"
    buf = buf + "// __raw_add_f calls hexa_int across the .o boundary.\n"
    buf = buf + "//\n"
    buf = buf + "// This file is #include'd by a 1-line TU at seed-regen time with the runtime\n"
    if buf.len() > 65536 { _flush_rtcore_arith_coerce_format(out_path, buf); buf = "" }
    buf = buf + "// headers already in scope (HexaVal / HexaTag / HX_INT / HX_IS_STR / HX_IS_INT\n"
    buf = buf + "// + the public protos for hexa_int/float/str/void/array_new/array_push/\n"
    buf = buf + "// to_string + __hx_to_double). The rt_* delegates are external T symbols in the\n"
    buf = buf + "// linked binary; they are forward-declared below exactly as the runtime_core.c\n"
    buf = buf + "// arms declare them, so the seed TU compiles from runtime.h alone.\n"
    buf = buf + "\n"
    buf = buf + "// rt_* delegates — external-linkage in the hexa-source stdlib, declared here\n"
    buf = buf + "// verbatim from the runtime_core.c HEXA_HAS_HEXA_RT_STDLIB arms.\n"
    buf = buf + "extern HexaVal rt_concat_many_arr(HexaVal parts);\n"
    buf = buf + "extern HexaVal rt_fma_int(HexaVal a, HexaVal b, HexaVal c);\n"
    buf = buf + "extern HexaVal rt_fma_float(HexaVal a, HexaVal b, HexaVal c);\n"
    buf = buf + "extern HexaVal rt_len(HexaVal v);\n"
    buf = buf + "extern HexaVal rt_null_coal(HexaVal a, HexaVal b);\n"
    buf = buf + "extern HexaVal rt_to_int(HexaVal v);\n"
    buf = buf + "extern HexaVal rt_format(HexaVal fmt, HexaVal sarg);\n"
    buf = buf + "extern HexaVal rt_format_float_f(HexaVal v, HexaVal prec);\n"
    buf = buf + "extern HexaVal rt_format_float_sci(HexaVal v, HexaVal prec);\n"
    buf = buf + "extern HexaVal rt_print(HexaVal v);\n"
    buf = buf + "extern HexaVal rt_str_char_at(HexaVal s, HexaVal idx);\n"
    buf = buf + "\n"
    buf = buf + "// hexa_concat_many — TAG_ARRAY bridge → rt_concat_many_arr (runtime_core.c arm).\n"
    buf = buf + "HexaVal hexa_concat_many(int n, HexaVal* parts) {\n"
    buf = buf + "    if (n <= 0) return hexa_str(\"\");\n"
    buf = buf + "    HexaVal arr = hexa_array_new();\n"
    buf = buf + "    for (int i = 0; i < n; i++) {\n"
    buf = buf + "        arr = hexa_array_push(arr, parts[i]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return rt_concat_many_arr(arr);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// hexa_fma — fused multiply-add via rt_fma_int / rt_fma_float.\n"
    buf = buf + "HexaVal hexa_fma(HexaVal a, HexaVal b, HexaVal c) {\n"
    buf = buf + "    if (HX_IS_INT(a) && HX_IS_INT(b) && HX_IS_INT(c))\n"
    buf = buf + "        return rt_fma_int(a, b, c);\n"
    buf = buf + "    return rt_fma_float(hexa_float(__hx_to_double(a)),\n"
    buf = buf + "                        hexa_float(__hx_to_double(b)),\n"
    buf = buf + "                        hexa_float(__hx_to_double(c)));\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// hexa_len — int64_t return; delegates to rt_len, unwraps via HX_INT.\n"
    buf = buf + "int64_t hexa_len(HexaVal v) {\n"
    buf = buf + "    // L2 uniform-soundness: an escaping packed array (TAG_ARRAY_I64/F64/F32)\n"
    buf = buf + "    // that flowed through a type-erasing boundary (struct field / fn return)\n"
    buf = buf + "    // reaches this reader with its static type lost — discriminate on the\n"
    buf = buf + "    // runtime tag as hexa_arr_poly_len does, else rt_len (hexa_byte_len) does\n"
    buf = buf + "    // not recognize the packed tag and len collapses to 0.\n"
    buf = buf + "    if (HX_TAG(v) == TAG_ARRAY_I64) return ((HexaArrI64*)v.arr_ptr)->len;\n"
    buf = buf + "    if (HX_TAG(v) == TAG_ARRAY_F64) return ((HexaArrF64*)v.arr_ptr)->len;\n"
    buf = buf + "    if (HX_TAG(v) == TAG_ARRAY_F32) return ((HexaArrF32*)v.arr_ptr)->len;\n"
    buf = buf + "    return HX_INT(rt_len(v));\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// hexa_null_coal — `??` predicate delegate.\n"
    buf = buf + "HexaVal hexa_null_coal(HexaVal a, HexaVal b) {\n"
    buf = buf + "    return rt_null_coal(a, b);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// hexa_to_int — scalar→int coercion delegate.\n"
    if buf.len() > 65536 { _flush_rtcore_arith_coerce_format(out_path, buf); buf = "" }
    buf = buf + "HexaVal hexa_to_int(HexaVal v) { return rt_to_int(v); }\n"
    buf = buf + "\n"
    buf = buf + "// hexa_format — single-arg `{}` format; polymorphic arg coerced C-side.\n"
    buf = buf + "HexaVal hexa_format(HexaVal fmt, HexaVal arg) {\n"
    buf = buf + "    if (!HX_IS_STR(fmt)) return fmt;\n"
    buf = buf + "    HexaVal sarg = hexa_to_string(arg);\n"
    buf = buf + "    return rt_format(fmt, sarg);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// hexa_format_float — `%.*f` delegate.\n"
    buf = buf + "HexaVal hexa_format_float(HexaVal f, HexaVal prec) {\n"
    buf = buf + "    return rt_format_float_f(hexa_float(__hx_to_double(f)), prec);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// hexa_format_float_sci — `%.*e` delegate.\n"
    buf = buf + "HexaVal hexa_format_float_sci(HexaVal f, HexaVal prec) {\n"
    buf = buf + "    return rt_format_float_sci(hexa_float(__hx_to_double(f)), prec);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// hexa_print — print delegate.\n"
    buf = buf + "HexaVal hexa_print(HexaVal v) {\n"
    buf = buf + "    return rt_print(v);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// hexa_str_char_at — byte-indexed char access delegate.\n"
    buf = buf + "HexaVal hexa_str_char_at(HexaVal s, HexaVal idx) {\n"
    buf = buf + "    if (!HX_IS_STR(s)) return hexa_str(\"\");\n"
    buf = buf + "    return rt_str_char_at(s, idx);\n"
    buf = buf + "}\n"
    if buf.len() > 0 { _flush_rtcore_arith_coerce_format(out_path, buf) }
}

fn main() {
    let argv = real_args()
    let out_path = if argv.len() >= 1 { argv[0] } else { "rtcore_arith_coerce_format.c" }
    emit_rtcore_arith_coerce_format_to(out_path)
    let exists_check = exec("[ -f \"" + out_path + "\" ] && echo y || echo n").trim()
    if exists_check != "y" {
        println("[rtcore_arith_coerce_format_emit] FATAL: failed to write " + out_path)
        exit(1)
    }
    println("[rtcore_arith_coerce_format_emit] wrote " + out_path)
    exit(0)
}
