// self/rt/syscall.hexa — P7-7a: syscall intrinsic wrappers
//
// Declares per-target syscall numbers and portable sys_* wrappers over
// the `syscall(num, args...)` builtin. The builtin is lowered by
// self/codegen/syscall.hexa into architecture-specific instruction
// sequences (ARM64 svc / x86_64 syscall).
//
// Spec: docs/plans/syscall_intrinsic_spec.md
//
// Usage from rt/ modules:
//
//     use self::rt::syscall
//
//     fn write_line(s: string) -> int {
//         let addr = __hx_str_ptr(s)
//         return sys_write(1, addr, len(s))
//     }
//
// Per-target constants are const fns so codegen DCE drops the dead
// branch at --target time. `target_is_linux()` / `target_is_darwin()`
// resolve at codegen (compile-time known).

// ═══════════════════════════════════════════════════════════════════
// Target selection (compile-time, resolved by codegen --target flag)
// ═══════════════════════════════════════════════════════════════════

@pure fn target_is_linux() -> bool { return __hx_target_os() == 0 }
@pure fn target_is_darwin() -> bool { return __hx_target_os() == 1 }

// __hx_target_os() is a shipping-backend leaf intrinsic (RT-NATIVE M5-syscall-a,
// 2026-06-18): x86_64_linux → 0, arm64_darwin → 1. It replaces the old P7-7
// `__TARGET_OS__` codegen-injected ident which only self/codegen knew.
//   0 = linux,  1 = darwin,  2 = (reserved for freebsd)

// __hx_target_arch() is the companion CPU-arch leaf intrinsic (RT-NATIVE
// measure-8, 2026-06-19): x86_64 → 0, arm64 → 1. Linux syscall NUMBERS are
// arch-specific (x86_64 mmap=9 vs aarch64 mmap=222), so the Linux branch must
// also discriminate arch — baking the x86_64 numbers on arm64-linux mis-routed
// mmap → bad arena base → SIGSEGV (#3597 native-arm64-arena wall).
//   0 = x86_64,  1 = arm64
@pure fn target_is_arm64() -> bool { return __hx_target_arch() == 1 }

// ═══════════════════════════════════════════════════════════════════
// syscall shim — route the P7-7 `syscall(num, args…)` builtin (not lowered by
// the shipping compiler/codegen) to the M1 leaf `__hx_syscall6` (num + EXACTLY
// 6 args; 0-fill the unused tail) / `__hx_syscall0` (num only). RT-NATIVE
// M5-syscall-b, 2026-06-18.
// ═══════════════════════════════════════════════════════════════════

@inline fn _sc0(n: int) -> int { return __hx_syscall0(n) }
@inline fn _sc1(n: int, a: int) -> int { return __hx_syscall6(n, a, 0, 0, 0, 0, 0) }
@inline fn _sc2(n: int, a: int, b: int) -> int { return __hx_syscall6(n, a, b, 0, 0, 0, 0) }
@inline fn _sc3(n: int, a: int, b: int, c: int) -> int { return __hx_syscall6(n, a, b, c, 0, 0, 0) }
@inline fn _sc4(n: int, a: int, b: int, c: int, d: int) -> int { return __hx_syscall6(n, a, b, c, d, 0, 0) }
@inline fn _sc6(n: int, a: int, b: int, c: int, d: int, e: int, f: int) -> int { return __hx_syscall6(n, a, b, c, d, e, f) }

// ═══════════════════════════════════════════════════════════════════
// Linux syscall numbers (x86_64 + arm64 unified — Linux unified ABI)
// ═══════════════════════════════════════════════════════════════════

@pure fn SYS_LINUX_READ()         -> int { return 0 }
@pure fn SYS_LINUX_WRITE()        -> int { return 1 }
@pure fn SYS_LINUX_OPEN()         -> int { return 2 }
@pure fn SYS_LINUX_CLOSE()        -> int { return 3 }
@pure fn SYS_LINUX_STAT()         -> int { return 4 }
@pure fn SYS_LINUX_FSTAT()        -> int { return 5 }
@pure fn SYS_LINUX_LSEEK()        -> int { return 8 }
@pure fn SYS_LINUX_MMAP()         -> int { return 9 }
@pure fn SYS_LINUX_MUNMAP()       -> int { return 11 }
@pure fn SYS_LINUX_BRK()          -> int { return 12 }
@pure fn SYS_LINUX_IOCTL()        -> int { return 16 }
@pure fn SYS_LINUX_PIPE()         -> int { return 22 }
@pure fn SYS_LINUX_NANOSLEEP()    -> int { return 35 }
@pure fn SYS_LINUX_FORK()         -> int { return 57 }
@pure fn SYS_LINUX_EXECVE()       -> int { return 59 }
@pure fn SYS_LINUX_WAIT4()        -> int { return 61 }
@pure fn SYS_LINUX_DUP2()         -> int { return 33 }
@pure fn SYS_LINUX_GETDENTS64()   -> int { return 217 }
@pure fn SYS_LINUX_CLOCK_GETTIME()-> int { return 228 }
@pure fn SYS_LINUX_EXIT_GROUP()   -> int { return 231 }
@pure fn SYS_LINUX_UNLINKAT()     -> int { return 263 }
@pure fn SYS_LINUX_MKDIRAT()      -> int { return 258 }
@pure fn SYS_LINUX_GETRANDOM()    -> int { return 318 }

// ═══════════════════════════════════════════════════════════════════
// Linux aarch64 (arm64) syscall numbers — DISTINCT from x86_64 above.
// The aarch64 ABI uses the asm-generic unified table (mmap=222, munmap=215,
// exit_group=94, …), NOT the x86_64 legacy numbers. Only the arena-critical
// calls are listed here (the native arm64 arena seed flattens sys_mmap +
// sys_exit; sys_munmap backs reset/rewind). Extend as more arm64-linux sys_*
// graduate to native. (#3597 root-cause: x86_64 numbers on arm64 → bad mmap.)
// ═══════════════════════════════════════════════════════════════════

@pure fn SYS_LINUX_ARM64_MMAP()       -> int { return 222 }
@pure fn SYS_LINUX_ARM64_MUNMAP()     -> int { return 215 }
@pure fn SYS_LINUX_ARM64_EXIT_GROUP() -> int { return 94 }

// ═══════════════════════════════════════════════════════════════════
// Darwin syscall numbers (BSD layer, OR 0x2000000 baked in)
// ═══════════════════════════════════════════════════════════════════

@pure fn SYS_DARWIN_EXIT()        -> int { return 33554433 }  // 0x2000001
@pure fn SYS_DARWIN_FORK()        -> int { return 33554434 }  // 0x2000002
@pure fn SYS_DARWIN_READ()        -> int { return 33554435 }  // 0x2000003
@pure fn SYS_DARWIN_WRITE()       -> int { return 33554436 }  // 0x2000004
@pure fn SYS_DARWIN_OPEN()        -> int { return 33554437 }  // 0x2000005
@pure fn SYS_DARWIN_CLOSE()       -> int { return 33554438 }  // 0x2000006
@pure fn SYS_DARWIN_WAIT4()       -> int { return 33554439 }  // 0x2000007
@pure fn SYS_DARWIN_UNLINK()      -> int { return 33554442 }  // 0x200000a
@pure fn SYS_DARWIN_LSEEK()       -> int { return 33554631 }  // 0x20000c7 (arm64)
@pure fn SYS_DARWIN_EXECVE()      -> int { return 33554491 }  // 0x200003b
@pure fn SYS_DARWIN_MUNMAP()      -> int { return 33554505 }  // 0x2000049
@pure fn SYS_DARWIN_MMAP()        -> int { return 33554629 }  // 0x20000c5
@pure fn SYS_DARWIN_FSTAT64()     -> int { return 33554621 }  // 0x20000bd
@pure fn SYS_DARWIN_GETDIRENTRIES()-> int { return 33554772 } // 0x2000154
@pure fn SYS_DARWIN_GETDIRENTRIES64()->int { return 33554776 } // 0x2000158 (arm64 new-style)
@pure fn SYS_DARWIN_MKDIR()       -> int { return 33554568 }  // 0x2000088
@pure fn SYS_DARWIN_NANOSLEEP()   -> int { return 33554629 }  // (placeholder — revise)
@pure fn SYS_DARWIN_CLOCK_GETTIME()->int  { return 33558008 }  // 0x2000E78

// ═══════════════════════════════════════════════════════════════════
// Portable wrappers — callers use these, not raw syscall()
// ═══════════════════════════════════════════════════════════════════

fn sys_read(fd: int, buf: int, len: int) -> int {
    if target_is_linux() { return _sc3(SYS_LINUX_READ(), fd, buf, len) }
    return _sc3(SYS_DARWIN_READ(), fd, buf, len)
}

fn sys_write(fd: int, buf: int, len: int) -> int {
    if target_is_linux() { return _sc3(SYS_LINUX_WRITE(), fd, buf, len) }
    return _sc3(SYS_DARWIN_WRITE(), fd, buf, len)
}

fn sys_open(path_cstr: int, flags: int, mode: int) -> int {
    if target_is_linux() { return _sc3(SYS_LINUX_OPEN(), path_cstr, flags, mode) }
    return _sc3(SYS_DARWIN_OPEN(), path_cstr, flags, mode)
}

fn sys_close(fd: int) -> int {
    if target_is_linux() { return _sc1(SYS_LINUX_CLOSE(), fd) }
    return _sc1(SYS_DARWIN_CLOSE(), fd)
}

fn sys_lseek(fd: int, off: int, whence: int) -> int {
    if target_is_linux() { return _sc3(SYS_LINUX_LSEEK(), fd, off, whence) }
    return _sc3(SYS_DARWIN_LSEEK(), fd, off, whence)
}

fn sys_unlink(path_cstr: int) -> int {
    if target_is_linux() {
        // Linux uses unlinkat(AT_FDCWD=-100, path, 0)
        return _sc3(SYS_LINUX_UNLINKAT(), -100, path_cstr, 0)
    }
    return _sc1(SYS_DARWIN_UNLINK(), path_cstr)
}

fn sys_mkdir(path_cstr: int, mode: int) -> int {
    if target_is_linux() {
        // Linux: mkdirat(AT_FDCWD=-100, path, mode) — raw mkdir(2)=83 was dropped.
        return _sc3(SYS_LINUX_MKDIRAT(), -100, path_cstr, mode)
    }
    return _sc2(SYS_DARWIN_MKDIR(), path_cstr, mode)
}

fn sys_mmap(addr: int, size: int, prot: int, flags: int, fd: int, off: int) -> int {
    if target_is_linux() {
        if target_is_arm64() { return _sc6(SYS_LINUX_ARM64_MMAP(), addr, size, prot, flags, fd, off) }
        return _sc6(SYS_LINUX_MMAP(), addr, size, prot, flags, fd, off)
    }
    return _sc6(SYS_DARWIN_MMAP(), addr, size, prot, flags, fd, off)
}

fn sys_munmap(addr: int, size: int) -> int {
    if target_is_linux() {
        if target_is_arm64() { return _sc2(SYS_LINUX_ARM64_MUNMAP(), addr, size) }
        return _sc2(SYS_LINUX_MUNMAP(), addr, size)
    }
    return _sc2(SYS_DARWIN_MUNMAP(), addr, size)
}

fn sys_exit(code: int) -> int {
    if target_is_linux() {
        if target_is_arm64() { return _sc1(SYS_LINUX_ARM64_EXIT_GROUP(), code) }
        return _sc1(SYS_LINUX_EXIT_GROUP(), code)
    }
    return _sc1(SYS_DARWIN_EXIT(), code)
}

fn sys_getrandom(buf: int, len: int, flags: int) -> int {
    if target_is_linux() { return _sc3(SYS_LINUX_GETRANDOM(), buf, len, flags) }
    // Darwin has no getrandom; fall back to /dev/urandom via open+read
    let fd = sys_open(__hx_str_ptr("/dev/urandom"), 0, 0)
    if fd < 0 { return fd }
    let n = sys_read(fd, buf, len)
    sys_close(fd)
    return n
}

fn sys_clock_gettime(clk: int, ts_ptr: int) -> int {
    if target_is_linux() { return _sc2(SYS_LINUX_CLOCK_GETTIME(), clk, ts_ptr) }
    return _sc2(SYS_DARWIN_CLOCK_GETTIME(), clk, ts_ptr)
}

// ═══════════════════════════════════════════════════════════════════
// Process control — fork / execve / wait4 / pipe / dup2 / nanosleep
// ═══════════════════════════════════════════════════════════════════
//
// Used by self/rt/proc.hexa (hexa_exec / hexa_exec_with_status / hexa_sleep).
// Signatures match the Linux unified ABI; Darwin uses the same layout.

fn sys_fork() -> int {
    if target_is_linux() { return _sc0(SYS_LINUX_FORK()) }
    return _sc0(SYS_DARWIN_FORK())
}

// argv_ptr / envp_ptr are int addresses of NULL-terminated cstring arrays.
fn sys_execve(path_cstr: int, argv_ptr: int, envp_ptr: int) -> int {
    if target_is_linux() { return _sc3(SYS_LINUX_EXECVE(), path_cstr, argv_ptr, envp_ptr) }
    return _sc3(SYS_DARWIN_EXECVE(), path_cstr, argv_ptr, envp_ptr)
}

// wait4(pid, &status, options, &rusage). rusage_ptr = 0 to skip.
fn sys_wait4(pid: int, status_ptr: int, options: int, rusage_ptr: int) -> int {
    if target_is_linux() { return _sc4(SYS_LINUX_WAIT4(), pid, status_ptr, options, rusage_ptr) }
    return _sc4(SYS_DARWIN_WAIT4(), pid, status_ptr, options, rusage_ptr)
}

// pipe(fds[2]) — fds_ptr is int addr of a 2-int array (8 bytes each on 64-bit,
// or 4 bytes if codegen emits 32-bit ints; interp convention is 64-bit slots).
// Linux pipe() returns read-end in rax and writes read/write fds to fds_ptr[0..1]
// (actually writes both slots; return value is 0 on success, -errno on error).
fn sys_pipe(fds_ptr: int) -> int {
    if target_is_linux() { return _sc1(SYS_LINUX_PIPE(), fds_ptr) }
    // Darwin has no plain pipe() via BSD syscall — kernel returns r0/r1 in
    // two return regs. Current codegen exposes only the first return value,
    // so Darwin path is incomplete; pipe-based exec is Linux-only for now.
    return -1
}

fn sys_dup2(oldfd: int, newfd: int) -> int {
    if target_is_linux() { return _sc2(SYS_LINUX_DUP2(), oldfd, newfd) }
    // Darwin dup2 syscall number not yet catalogued — see proc.hexa blocker.
    return -1
}

fn sys_nanosleep(req_ptr: int, rem_ptr: int) -> int {
    if target_is_linux() { return _sc2(SYS_LINUX_NANOSLEEP(), req_ptr, rem_ptr) }
    return _sc2(SYS_DARWIN_NANOSLEEP(), req_ptr, rem_ptr)
}

// ═══════════════════════════════════════════════════════════════════
// Open flags (POSIX shared; Linux + Darwin identical for subset below)
// ═══════════════════════════════════════════════════════════════════

@pure fn O_RDONLY()  -> int { return 0 }
@pure fn O_WRONLY()  -> int { return 1 }
@pure fn O_RDWR()    -> int { return 2 }
// Note: O_CREAT / O_APPEND / O_TRUNC values diverge between Linux and
// Darwin. Use per-target variants.
@pure fn O_CREAT_LINUX()  -> int { return 64 }    // 0x40
@pure fn O_APPEND_LINUX() -> int { return 1024 }  // 0x400
@pure fn O_TRUNC_LINUX()  -> int { return 512 }   // 0x200
@pure fn O_CREAT_DARWIN() -> int { return 512 }   // 0x200
@pure fn O_APPEND_DARWIN()-> int { return 8 }     // 0x008
@pure fn O_TRUNC_DARWIN() -> int { return 1024 }  // 0x400

fn flag_o_creat() -> int {
    if target_is_linux() { return O_CREAT_LINUX() }
    return O_CREAT_DARWIN()
}
fn flag_o_append() -> int {
    if target_is_linux() { return O_APPEND_LINUX() }
    return O_APPEND_DARWIN()
}
fn flag_o_trunc() -> int {
    if target_is_linux() { return O_TRUNC_LINUX() }
    return O_TRUNC_DARWIN()
}

// ═══════════════════════════════════════════════════════════════════
// mmap prot/flags (POSIX shared subset)
// ═══════════════════════════════════════════════════════════════════

@pure fn PROT_READ()  -> int { return 1 }
@pure fn PROT_WRITE() -> int { return 2 }
@pure fn PROT_EXEC()  -> int { return 4 }
@pure fn MAP_PRIVATE()-> int { return 2 }
@pure fn MAP_ANON_LINUX()  -> int { return 32 }    // 0x20
@pure fn MAP_ANON_DARWIN() -> int { return 4096 }  // 0x1000
fn flag_map_anon() -> int {
    if target_is_linux() { return MAP_ANON_LINUX() }
    return MAP_ANON_DARWIN()
}

// ═══════════════════════════════════════════════════════════════════
// CLOCK_* constants
// ═══════════════════════════════════════════════════════════════════

@pure fn CLOCK_REALTIME()  -> int { return 0 }
@pure fn CLOCK_MONOTONIC_LINUX()  -> int { return 1 }
@pure fn CLOCK_MONOTONIC_DARWIN() -> int { return 6 }
fn clock_monotonic() -> int {
    if target_is_linux() { return CLOCK_MONOTONIC_LINUX() }
    return CLOCK_MONOTONIC_DARWIN()
}

// ═══════════════════════════════════════════════════════════════════
// Socket family — socket / bind / listen / accept / connect /
//                 send / recv / setsockopt  (zero-c r36, ING #29)
// ═══════════════════════════════════════════════════════════════════
//
// These are the leg-B (whole-runtime-in-.hexa) portable wrappers for the
// BSD socket calls that net.c/std::net needs, mirroring the fork/execve/
// wait4 process-control template above exactly (same _scN dispatch, same
// per-target NR routing). They let the self-contained `self/rt/*.hexa`
// runtime issue socket syscalls directly instead of calling through the
// host libc `socket()/bind()/…`, the same way `self/rt/proc.hexa` already
// does fork/exec via sys_fork()/sys_execve().
//
// NUMBER SOURCES:
//   Linux x86_64  : socket=41 connect=42 accept=43 bind=49 listen=50
//                   sendto=44 recvfrom=45 setsockopt=54   (arch/x86/…/syscall_64.tbl)
//   Linux aarch64 : socket=198 bind=200 connect=203 accept=202 listen=201
//                   sendto=206 recvfrom=207 setsockopt=208 (asm-generic unified)
//   Darwin (arm64): BSD numbers OR'd with the 0x2000000 unix-class flag,
//                   matching self/runtime.c's HXLCL_SYS_* table —
//                   socket 97 connect 98 accept 30 bind 104 listen 106
//                   setsockopt 105 recvfrom 29 sendto 133.
//
// send/recv are implemented over sendto/recvfrom with NULL sockaddr (= the
// connected-socket send/recv), exactly as runtime.c's hxlcl_send/hxlcl_recv
// route to SENDTO/RECVFROM with a 0 addr — Darwin has no plain send/recv
// BSD syscall, so this is the only portable form.
//
// ⚠ DARWIN-ARM64 ERRNO WALL (measured, not assumed): on Darwin the kernel
// signals a syscall error by SETTING PSTATE.C (carry), leaving the POSITIVE
// errno in x0 — it does NOT return -errno the way Linux does. The
// `__hx_syscall6` intrinsic these wrappers route through returns ONLY the
// raw x0 value; it cannot read the carry flag, and its C-transpile lowering
// (self/codegen.hexa __hx_syscall6, even under HEXA_RT_SYSCALL_NATIVE) falls
// back to libc `syscall()` on every non-x86_64 arch. The generic codegen
// path (self/codegen/syscall.hexa emit_darwin_errno_fix / csneg x0,x0,x0,CC)
// that WOULD normalize carry→ -errno is NOT wired into the __hx_syscall6
// lowering. So on Darwin arm64 a failing socket call returns a small
// POSITIVE value indistinguishable from a valid fd/byte-count. These
// wrappers are therefore correct on LINUX (both arches) only; on Darwin the
// shipping path keeps using self/runtime.c's `_hxlcl_syscall*_cf` (which
// reads the carry flag via inline asm). Unblocking Darwin here needs a
// carry-flag-aware intrinsic (e.g. __hx_syscall6_cf) — a codegen change,
// out of scope for this additive-wrapper round. Mirrors the pre-existing
// Darwin gaps in sys_pipe()/sys_dup2() above.

@pure fn SYS_LINUX_X86_SOCKET()     -> int { return 41 }
@pure fn SYS_LINUX_X86_CONNECT()    -> int { return 42 }
@pure fn SYS_LINUX_X86_ACCEPT()     -> int { return 43 }
@pure fn SYS_LINUX_X86_SENDTO()     -> int { return 44 }
@pure fn SYS_LINUX_X86_RECVFROM()   -> int { return 45 }
@pure fn SYS_LINUX_X86_BIND()       -> int { return 49 }
@pure fn SYS_LINUX_X86_LISTEN()     -> int { return 50 }
@pure fn SYS_LINUX_X86_SETSOCKOPT() -> int { return 54 }

@pure fn SYS_LINUX_ARM64_SOCKET()     -> int { return 198 }
@pure fn SYS_LINUX_ARM64_BIND()       -> int { return 200 }
@pure fn SYS_LINUX_ARM64_LISTEN()     -> int { return 201 }
@pure fn SYS_LINUX_ARM64_ACCEPT()     -> int { return 202 }
@pure fn SYS_LINUX_ARM64_CONNECT()    -> int { return 203 }
@pure fn SYS_LINUX_ARM64_SENDTO()     -> int { return 206 }
@pure fn SYS_LINUX_ARM64_RECVFROM()   -> int { return 207 }
@pure fn SYS_LINUX_ARM64_SETSOCKOPT() -> int { return 208 }

@pure fn SYS_DARWIN_SOCKET()     -> int { return 33554529 }  // 0x2000061 (97)
@pure fn SYS_DARWIN_CONNECT()    -> int { return 33554530 }  // 0x2000062 (98)
@pure fn SYS_DARWIN_ACCEPT()     -> int { return 33554462 }  // 0x200001e (30)
@pure fn SYS_DARWIN_BIND()       -> int { return 33554536 }  // 0x2000068 (104)
@pure fn SYS_DARWIN_LISTEN()     -> int { return 33554538 }  // 0x200006a (106)
@pure fn SYS_DARWIN_SETSOCKOPT() -> int { return 33554537 }  // 0x2000069 (105)
@pure fn SYS_DARWIN_RECVFROM()   -> int { return 33554461 }  // 0x200001d (29)
@pure fn SYS_DARWIN_SENDTO()     -> int { return 33554565 }  // 0x2000085 (133)

// socket(domain, type, protocol) -> fd / -errno
fn sys_socket(domain: int, kind: int, proto: int) -> int {
    if target_is_linux() {
        if target_is_arm64() { return _sc3(SYS_LINUX_ARM64_SOCKET(), domain, kind, proto) }
        return _sc3(SYS_LINUX_X86_SOCKET(), domain, kind, proto)
    }
    return _sc3(SYS_DARWIN_SOCKET(), domain, kind, proto)
}

// bind(fd, sockaddr_ptr, addrlen) -> 0 / -errno
fn sys_bind(fd: int, addr_ptr: int, addrlen: int) -> int {
    if target_is_linux() {
        if target_is_arm64() { return _sc3(SYS_LINUX_ARM64_BIND(), fd, addr_ptr, addrlen) }
        return _sc3(SYS_LINUX_X86_BIND(), fd, addr_ptr, addrlen)
    }
    return _sc3(SYS_DARWIN_BIND(), fd, addr_ptr, addrlen)
}

// listen(fd, backlog) -> 0 / -errno
fn sys_listen(fd: int, backlog: int) -> int {
    if target_is_linux() {
        if target_is_arm64() { return _sc2(SYS_LINUX_ARM64_LISTEN(), fd, backlog) }
        return _sc2(SYS_LINUX_X86_LISTEN(), fd, backlog)
    }
    return _sc2(SYS_DARWIN_LISTEN(), fd, backlog)
}

// accept(fd, sockaddr_ptr, addrlen_ptr) -> new fd / -errno.
// addr_ptr / addrlen_ptr may be 0 (= don't return the peer address).
fn sys_accept(fd: int, addr_ptr: int, addrlen_ptr: int) -> int {
    if target_is_linux() {
        if target_is_arm64() { return _sc3(SYS_LINUX_ARM64_ACCEPT(), fd, addr_ptr, addrlen_ptr) }
        return _sc3(SYS_LINUX_X86_ACCEPT(), fd, addr_ptr, addrlen_ptr)
    }
    return _sc3(SYS_DARWIN_ACCEPT(), fd, addr_ptr, addrlen_ptr)
}

// connect(fd, sockaddr_ptr, addrlen) -> 0 / -errno
fn sys_connect(fd: int, addr_ptr: int, addrlen: int) -> int {
    if target_is_linux() {
        if target_is_arm64() { return _sc3(SYS_LINUX_ARM64_CONNECT(), fd, addr_ptr, addrlen) }
        return _sc3(SYS_LINUX_X86_CONNECT(), fd, addr_ptr, addrlen)
    }
    return _sc3(SYS_DARWIN_CONNECT(), fd, addr_ptr, addrlen)
}

// send(fd, buf, len, flags) -> bytes sent / -errno.
// Routed through sendto(fd, buf, len, flags, NULL, 0) = send on a connected
// socket (Darwin has no plain send syscall; matches runtime.c hxlcl_send).
fn sys_send(fd: int, buf: int, len: int, flags: int) -> int {
    if target_is_linux() {
        if target_is_arm64() { return _sc6(SYS_LINUX_ARM64_SENDTO(), fd, buf, len, flags, 0, 0) }
        return _sc6(SYS_LINUX_X86_SENDTO(), fd, buf, len, flags, 0, 0)
    }
    return _sc6(SYS_DARWIN_SENDTO(), fd, buf, len, flags, 0, 0)
}

// recv(fd, buf, len, flags) -> bytes received / 0 (peer closed) / -errno.
// Routed through recvfrom(fd, buf, len, flags, NULL, NULL) (matches
// runtime.c hxlcl_recv).
fn sys_recv(fd: int, buf: int, len: int, flags: int) -> int {
    if target_is_linux() {
        if target_is_arm64() { return _sc6(SYS_LINUX_ARM64_RECVFROM(), fd, buf, len, flags, 0, 0) }
        return _sc6(SYS_LINUX_X86_RECVFROM(), fd, buf, len, flags, 0, 0)
    }
    return _sc6(SYS_DARWIN_RECVFROM(), fd, buf, len, flags, 0, 0)
}

// setsockopt(fd, level, optname, optval_ptr, optlen) -> 0 / -errno.
// 5-arg call padded to syscall6 (6th unused = 0), matching runtime.c.
fn sys_setsockopt(fd: int, level: int, optname: int, optval_ptr: int, optlen: int) -> int {
    if target_is_linux() {
        if target_is_arm64() { return _sc6(SYS_LINUX_ARM64_SETSOCKOPT(), fd, level, optname, optval_ptr, optlen, 0) }
        return _sc6(SYS_LINUX_X86_SETSOCKOPT(), fd, level, optname, optval_ptr, optlen, 0)
    }
    return _sc6(SYS_DARWIN_SETSOCKOPT(), fd, level, optname, optval_ptr, optlen, 0)
}

// ── Socket-family constants (POSIX shared subset) ──────────────────
@pure fn AF_INET()      -> int { return 2 }
@pure fn SOCK_STREAM()  -> int { return 1 }
@pure fn SOCK_DGRAM()   -> int { return 2 }
// SOL_SOCKET diverges: Linux=1, Darwin=0xffff.
@pure fn SOL_SOCKET_LINUX()  -> int { return 1 }
@pure fn SOL_SOCKET_DARWIN() -> int { return 65535 }
fn sol_socket() -> int {
    if target_is_linux() { return SOL_SOCKET_LINUX() }
    return SOL_SOCKET_DARWIN()
}
// SO_REUSEADDR diverges: Linux=2, Darwin=0x0004.
@pure fn SO_REUSEADDR_LINUX()  -> int { return 2 }
@pure fn SO_REUSEADDR_DARWIN() -> int { return 4 }
fn so_reuseaddr() -> int {
    if target_is_linux() { return SO_REUSEADDR_LINUX() }
    return SO_REUSEADDR_DARWIN()
}
