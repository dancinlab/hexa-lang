// self/rt/alloc.hexa — P7-7b: hexa allocator over syscall(mmap/munmap)
//
// Replaces runtime.c malloc/free/realloc. Mirrors the existing arena
// semantics from runtime.c:
//
//   hexa_arena_on() / hexa_arena_rewind(mark) / hexa_arena_reset()
//   hexa_ptr_alloc(size) / hexa_ptr_free(ptr, size)
//
// DE-CIRCULARIZED (2026-06-18, M5-alloc-b2 over F-M5-ALLOC-B1-MULTIPOOL-RAN):
// the pool list is held in RAW MEMORY — a fixed mmap'd table addressed by
// __hx_ptr_load64/store64 — NOT a hexa `[ArenaPool]` array + `.push()`. The old
// P7-7 draft's array representation made arena-alloc recurse into
// array-push-grow into arena-alloc (F-M5-ALLOC-CIRCULAR-DEP); the raw-mem table
// breaks that cycle. The multi-pool grow/mark/rewind/reset body below was proven
// end-to-end on real x86_64 (native-emit + RUN exit 0, non-circular nm witness)
// as scripts/scratch/rt_native/multipool_arena_poc.hexa.
//
// Memory intrinsics are now the SHIPPING __hx_ptr_load64/store64 (+8 byte),
// not the P7-7-era __mem_* names (those only had self/codegen/memop.hexa
// lowering; the shipping compiler/codegen knows only __hx_ptr_*).
//
// Design
// ------
//
//   1. Arena (bump pointer, scope-rewindable). Primary allocator. The pool
//      TABLE lives at __arena_tbl (one mmap'd region): a header word holds the
//      live pool count, and pool i's {base,size,used} header is at
//      __arena_tbl + 24 + i*24. Pool data pages are separate mmap regions.
//
//   2. Page allocator (one mmap per large alloc) for objects >= POOL/2.
//
// Arena resets/rewinds are O(pools). State is global (the runtime.c surface
// hexa_ptr_alloc(size) takes no arena handle); the single table-base int lives
// in the module global __arena_tbl, set by rt_init().
//
// Thread safety: single-threaded (matches runtime.c).

use self::rt::syscall

// ═══════════════════════════════════════════════════════════════════
// Constants
// ═══════════════════════════════════════════════════════════════════

@pure fn POOL_PAGE_SIZE() -> int { return 1048576 }  // 1 MB per pool page
@pure fn ARENA_MAX_POOLS() -> int { return 256 }      // up to 256 MB/arena

// ═══════════════════════════════════════════════════════════════════
// Global arena state — a raw mmap'd pool table (NO hexa array)
// ═══════════════════════════════════════════════════════════════════
//
// Table layout (each slot 24 bytes = 3 words):
//   __arena_tbl + 0          : live pool count (np)
//   __arena_tbl + 24 + i*24  : pool i {base @+0, size @+8, used @+16}

let mut __arena_tbl = 0

// ── ROUTE B (in progress): arena address-envelope ─────────────────────
// C arena keeps `__hx_arena_lo/hi` (runtime_core_emit.hexa:3969-3970) so
// hexa_val_heapify does an O(1) pointer-range reject — WITHOUT it the
// self-compile re-heapifies already-heapified strings O(n²) → 10-16GB RSS
// (OOM). Every mmap'd region (pool page + large page) must extend the
// envelope. This is the byteeq/RSS-critical half of Route B
// (F-M5-R3-MAPSET-ORCHESTRATION); the C-ABI half (HexaArenaMark struct /
// void* hexa_arena_alloc) is the other. Held here as module-globals; the
// seed-relink step wires these to the C `__hx_arena_lo/hi` the heapify
// reads (extern), or heapify itself is ported alongside.
//   lo = 0 sentinel ⇒ uninitialised (first map sets it); hi = 0 ⇒ empty.
let mut __arena_env_lo = 0
let mut __arena_env_hi = 0

// Extend the arena envelope to cover [base, base+size). Plain-int (matches
// this file's address arithmetic; addresses are positive int64 mmap returns).
fn __env_extend(base: int, size: int) {
    if __arena_env_lo == 0 {
        __arena_env_lo = base
    } else {
        if base < __arena_env_lo { __arena_env_lo = base }
    }
    let top = base + size
    if top > __arena_env_hi { __arena_env_hi = top }
}

// Envelope accessors — the seed-relink wires heapify's O(1) reject to these
// (a pointer p is arena-resident iff __arena_env_lo <= p < __arena_env_hi).
fn hexa_arena_env_lo() -> int { return __arena_env_lo }
fn hexa_arena_env_hi() -> int { return __arena_env_hi }

@pure fn align_up(n: int, align: int) -> int {
    return ((n + align - 1) / align) * align
}

// Raw table accessors — single __hx_ptr_* op each, no allocation, no recursion.
fn __a_np() -> int { return __hx_ptr_load64(__arena_tbl, 0) }
fn __a_set_np(n: int) { __hx_ptr_store64(__arena_tbl, 0, n) }
fn __p_base(i: int) -> int { return __hx_ptr_load64(__arena_tbl, 24 + i * 24) }
fn __p_size(i: int) -> int { return __hx_ptr_load64(__arena_tbl, 24 + i * 24 + 8) }
fn __p_used(i: int) -> int { return __hx_ptr_load64(__arena_tbl, 24 + i * 24 + 16) }
fn __p_set_base(i: int, v: int) { __hx_ptr_store64(__arena_tbl, 24 + i * 24, v) }
fn __p_set_size(i: int, v: int) { __hx_ptr_store64(__arena_tbl, 24 + i * 24 + 8, v) }
fn __p_set_used(i: int, v: int) { __hx_ptr_store64(__arena_tbl, 24 + i * 24 + 16, v) }

// Map a new pool page + record it in the raw table (replaces .push(pool)).
fn __arena_grow() {
    let n = __a_np()
    let flags = MAP_PRIVATE() + flag_map_anon()
    let prot = PROT_READ() + PROT_WRITE()
    let base = sys_mmap(0, POOL_PAGE_SIZE(), prot, flags, -1, 0)
    if base < 0 {
        sys_exit(137)  // arena overflow → abort (SIGKILL-equivalent)
        return
    }
    __p_set_base(n, base)
    __p_set_size(n, POOL_PAGE_SIZE())
    __p_set_used(n, 0)
    __a_set_np(n + 1)
    __env_extend(base, POOL_PAGE_SIZE())   // Route B: cover this pool page
}

// ═══════════════════════════════════════════════════════════════════
// Page allocator — one mmap per alloc, one munmap per free
// ═══════════════════════════════════════════════════════════════════

fn page_alloc(size: int) -> int {
    let aligned = align_up(size, 4096)
    let flags = MAP_PRIVATE() + flag_map_anon()
    let prot = PROT_READ() + PROT_WRITE()
    let addr = sys_mmap(0, aligned, prot, flags, -1, 0)
    if addr < 0 {
        sys_exit(137)
        return 0
    }
    __env_extend(addr, aligned)   // Route B: cover this large page
    return addr
}

fn page_free(addr: int, size: int) -> int {
    let aligned = align_up(size, 4096)
    return sys_munmap(addr, aligned)
}

// ═══════════════════════════════════════════════════════════════════
// Global allocator surface — runtime.c compat shims
// ═══════════════════════════════════════════════════════════════════
//
// runtime.c exposes:
//   hexa_arena_on / hexa_arena_mark / hexa_arena_rewind / hexa_arena_reset
//   hexa_ptr_alloc(size) / hexa_ptr_free(ptr, size)
//
// A mark is encoded as a single int: pool_idx * (POOL_PAGE_SIZE+1) + used
// (used < POOL_PAGE_SIZE, so the division recovers both halves). -1 = empty.

fn rt_init() {
    // mmap the fixed pool table, then eagerly map the first pool so the first
    // alloc is O(1).
    let flags = MAP_PRIVATE() + flag_map_anon()
    let prot = PROT_READ() + PROT_WRITE()
    __arena_tbl = sys_mmap(0, (ARENA_MAX_POOLS() + 1) * 24, prot, flags, -1, 0)
    if __arena_tbl < 0 {
        sys_exit(137)
        return
    }
    __hx_ptr_store64(__arena_tbl, 0, 0)  // np = 0
    __arena_grow()
}

fn hexa_arena_on() -> int {
    return 1
}

fn hexa_arena_mark() -> int {
    if __a_np() == 0 { return -1 }
    let cur = __a_np() - 1
    return cur * (POOL_PAGE_SIZE() + 1) + __p_used(cur)
}

fn hexa_arena_rewind(mark: int) {
    if mark < 0 {
        hexa_arena_reset()
        return
    }
    let pidx = mark / (POOL_PAGE_SIZE() + 1)
    let used = mark - pidx * (POOL_PAGE_SIZE() + 1)
    // Unmap any pools created after the marked pool.
    let mut i = __a_np() - 1
    while i > pidx {
        sys_munmap(__p_base(i), __p_size(i))
        i = i - 1
    }
    __a_set_np(pidx + 1)
    __p_set_used(pidx, used)
}

fn hexa_arena_reset() {
    let mut i = 0
    while i < __a_np() {
        sys_munmap(__p_base(i), __p_size(i))
        i = i + 1
    }
    __a_set_np(0)
}

fn hexa_ptr_alloc(size: int) -> int {
    let aligned = align_up(size, 8)
    // Large allocs bypass the arena (go straight to mmap).
    if aligned > POOL_PAGE_SIZE() / 2 {
        return page_alloc(aligned)
    }
    if __a_np() == 0 { __arena_grow() }
    let cur = __a_np() - 1
    if __p_used(cur) + aligned > __p_size(cur) {
        __arena_grow()
    }
    let c = __a_np() - 1
    let addr = __p_base(c) + __p_used(c)
    __p_set_used(c, __p_used(c) + aligned)
    return addr
}

fn hexa_ptr_free(ptr: int, size: int) -> int {
    // Arena allocs are freed en masse via arena_reset. Individual free is only
    // honored for page allocs (>= POOL/2). Small allocs: no-op.
    if size >= POOL_PAGE_SIZE() / 2 {
        return page_free(ptr, size)
    }
    return 0
}

// ═══════════════════════════════════════════════════════════════════
// Memory intrinsics — typed load/store at raw addresses
// ═══════════════════════════════════════════════════════════════════
//
// Thin over the shipping __hx_ptr_* leaf intrinsics (single instruction each,
// no libc memcpy). Offset is pre-added by the intrinsic's second arg.

@inline fn hexa_ptr_write_byte(ptr: int, offset: int, val: int) -> int {
    __hx_ptr_store8(ptr, offset, val)
    return val
}

@inline fn hexa_ptr_read_byte(ptr: int, offset: int) -> int {
    return __hx_ptr_load8(ptr, offset)
}

@inline fn hexa_ptr_write_64(ptr: int, offset: int, val: int) -> int {
    __hx_ptr_store64(ptr, offset, val)
    return val
}

@inline fn hexa_ptr_read_64(ptr: int, offset: int) -> int {
    return __hx_ptr_load64(ptr, offset)
}
