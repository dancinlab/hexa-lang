// self/rt/alloc.hexa — P7-7b → Route B: hexa LINKED-BLOCK arena over mmap.
//
// Replaces runtime.c's C arena (runtime_core_emit.hexa:3937-4085) — C-ABI
// equivalent so the C arena `#else` can drop:
//   · same HexaArenaBlock {next,cap,used,data[]} layout (raw memory)
//   · the 16-byte HexaArenaMark {block,used} struct == HexaVal {tag,payload}
//     layout, so a hexa fn returning __hx_make_val(block,used) is byte-identical
//     to the C struct return (ABI-compatible at the rax:rdx / SysV boundary).
//   · carries the address-envelope (#3524) for hexa_val_heapify's O(1) range-
//     reject (without it self-compile RSS → 10-16GB OOM).
//
// DATA STRUCTURE (Route B, F-M5-ROUTEB-LINKEDBLOCK): a HexaArenaBlock chain in
// raw memory, NOT the b2 pool table (whose int mark is ABI-incompatible with the
// C HexaArenaMark {block*,used}). Each block:
//   block + 0  : next (HexaArenaBlock*, 0 = last)
//   block + 8  : cap  (size_t, data capacity)
//   block + 16 : used (size_t, bump offset into data)
//   block + 24 : data[cap]
// __arena_head = first block (never unmapped); __arena_cur = current bump block.
// rewind/reset set used=0 and KEEP blocks for reuse (never unmap) — matches C.
//
// Memory intrinsics are the shipping __hx_ptr_load64/store64 (+offset); syscalls
// the M5 leaf surface (sys_mmap over __hx_syscall6). Thread safety: single-
// threaded (matches runtime.c).

use self::rt::syscall

@pure fn HEXA_ARENA_BLOCK_SIZE() -> int { return 1048576 }   // 1 MB default block
@pure fn BLOCK_HDR() -> int { return 24 }                     // next + cap + used

let mut __arena_head = 0
let mut __arena_cur = 0

// ── Route B address-envelope (carry-forward #3524) ────────────────────
// Every block's data range extends [__arena_env_lo, __arena_env_hi); the C
// heapify's O(1) pointer-range reject reads the matching C __hx_arena_lo/hi
// (wired at the seed-relink step). lo=0 ⇒ uninitialised; hi=0 ⇒ empty.
let mut __arena_env_lo = 0
let mut __arena_env_hi = 0

fn __env_extend(base: int, size: int) {
    if __arena_env_lo == 0 {
        __arena_env_lo = base
    } else {
        if base < __arena_env_lo { __arena_env_lo = base }
    }
    let top = base + size
    if top > __arena_env_hi { __arena_env_hi = top }
}

fn hexa_arena_env_lo() -> int { return __arena_env_lo }
fn hexa_arena_env_hi() -> int { return __arena_env_hi }

@pure fn align_up(n: int, align: int) -> int {
    return ((n + align - 1) / align) * align
}

// ── HexaArenaBlock raw-mem accessors (single __hx_ptr_* op each) ───────
fn __blk_next(b: int) -> int { return __hx_ptr_load64(b, 0) }
fn __blk_cap(b: int) -> int { return __hx_ptr_load64(b, 8) }
fn __blk_used(b: int) -> int { return __hx_ptr_load64(b, 16) }
fn __blk_set_next(b: int, v: int) { __hx_ptr_store64(b, 0, v) }
fn __blk_set_cap(b: int, v: int) { __hx_ptr_store64(b, 8, v) }
fn __blk_set_used(b: int, v: int) { __hx_ptr_store64(b, 16, v) }

// Map a new block with >= min_cap data bytes. Returns block base (0 = OOM).
fn hexa_arena_new_block(min_cap: int) -> int {
    let mut cap = HEXA_ARENA_BLOCK_SIZE()
    if min_cap > cap { cap = min_cap }
    let total = BLOCK_HDR() + cap
    let flags = MAP_PRIVATE() + flag_map_anon()
    let prot = PROT_READ() + PROT_WRITE()
    let base = sys_mmap(0, total, prot, flags, -1, 0)
    if base < 0 {
        sys_exit(137)
        return 0
    }
    __blk_set_next(base, 0)
    __blk_set_cap(base, cap)
    __blk_set_used(base, 0)
    __env_extend(base + BLOCK_HDR(), cap)   // data range → envelope
    return base
}

fn rt_init() {
    __arena_head = hexa_arena_new_block(HEXA_ARENA_BLOCK_SIZE())
    __arena_cur = __arena_head
}

fn hexa_arena_on() -> int {
    return 1
}

// Allocate n bytes (8-aligned) from the arena. Returns data ptr (0 = OOM).
// Large requests (> block size) get their own big block (matches the C arena —
// no separate page allocator). Bump on cur; on overflow, walk forward to reuse a
// rewound-empty tail block, else append a fresh one.
fn hexa_arena_alloc(n: int) -> int {
    let aligned = align_up(n, 8)
    let mut sz = aligned
    if sz == 0 { sz = 8 }
    if __arena_head == 0 {
        __arena_head = hexa_arena_new_block(sz)
        __arena_cur = __arena_head
        if __arena_head == 0 { return 0 }
    }
    let mut b = __arena_cur
    if __blk_used(b) + sz > __blk_cap(b) {
        let mut nb = __blk_next(b)
        while nb != 0 {
            if __blk_cap(nb) >= sz { break }
            nb = __blk_next(nb)
        }
        if nb == 0 {
            nb = hexa_arena_new_block(sz)
            if nb == 0 { return 0 }
            let mut tail = __arena_cur
            while __blk_next(tail) != 0 { tail = __blk_next(tail) }
            __blk_set_next(tail, nb)
        }
        __blk_set_used(nb, 0)
        __arena_cur = nb
        b = nb
    }
    let p = b + BLOCK_HDR() + __blk_used(b)
    __blk_set_used(b, __blk_used(b) + sz)
    return p
}

// HexaArenaMark = {block @0, used @8} == HexaVal {tag @0, payload @8}: returning
// __hx_make_val(block, used) is byte-identical to the C struct return.
fn hexa_arena_mark() -> HexaVal {
    if __arena_cur == 0 { return __hx_make_val(0, 0) }
    return __hx_make_val(__arena_cur, __blk_used(__arena_cur))
}

// rewind(m): m.block (word0) up to m.used (word1); later blocks emptied (kept).
fn hexa_arena_rewind(m: HexaVal) {
    let block = __hx_tag(m)             // HexaArenaMark.block
    let used = __hx_payload_add(m, 0)   // HexaArenaMark.used
    if block == 0 {
        if __arena_head != 0 {
            __blk_set_used(__arena_head, 0)
            __arena_cur = __arena_head
        }
        return
    }
    __blk_set_used(block, used)
    let mut b = __blk_next(block)
    while b != 0 {
        __blk_set_used(b, 0)
        b = __blk_next(b)
    }
    __arena_cur = block
}

fn hexa_arena_reset() {
    if __arena_head == 0 { return }
    let mut b = __arena_head
    while b != 0 {
        __blk_set_used(b, 0)
        b = __blk_next(b)
    }
    __arena_cur = __arena_head
}

// ── runtime.c-compat shims ────────────────────────────────────────────
// All allocation routes through the arena (no individual free — freed en masse
// via reset/rewind, matching the C arena's lifetime model).
fn hexa_ptr_alloc(size: int) -> int {
    return hexa_arena_alloc(size)
}

fn hexa_ptr_free(ptr: int, size: int) -> int {
    return 0
}

// ── Memory intrinsics — typed load/store at raw addresses ─────────────
@inline fn hexa_ptr_write_byte(ptr: int, offset: int, val: int) -> int {
    __hx_ptr_store8(ptr, offset, val)
    return val
}

@inline fn hexa_ptr_read_byte(ptr: int, offset: int) -> int {
    return __hx_ptr_load8(ptr, offset)
}

@inline fn hexa_ptr_write_64(ptr: int, offset: int, val: int) -> int {
    __hx_ptr_store64(ptr, offset, val)
    return val
}

@inline fn hexa_ptr_read_64(ptr: int, offset: int) -> int {
    return __hx_ptr_load64(ptr, offset)
}
