// tree_render_pure: a simple tree 0 -> {1,2}, 1 -> {3} renders 4 lines.
let edges = [[0,1],[0,2],[1,3]]
let tlines = split_lines(tree_render_pure(edges, 0))
if len(tlines) == 4 { pass_count = pass_count + 1 } else { println("[FAIL-TREE] " + to_string(len(tlines))); fail_count = fail_count + 1 }
// last child uses the closing connector; first uses branching connector.

println("__HEXA_RUNTIME_PRINT_FMT__ " + to_string(pass_count) + "/" + to_string(pass_count + fail_count))
if fail_count > 0 { println("PF-FAIL"); exit(1) }
println("PF-ALL-PASS")
