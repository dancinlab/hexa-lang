// =====================================================================
//  test_operator_overload_dispatch.hexa — RFC operator-overload (opt-in)
//
//  Surface: declare an ordinary impl method named `__add` (NO new keyword,
//  NO new @attr). Under HEXA_OP_OVERLOAD=1 the C-transpile codegen lowers
//  `a + b` to `Vec2____add(a, b)` when `a` is a runtime instance of a
//  struct type whose impl declares `__add`; every non-struct operand falls
//  through to the unchanged `hexa_add` runtime path. Default OFF → emit is
//  byte-identical (the dispatch helper is never consulted).
//
//  Reference: Rust std::ops::Add::add (library/core/src/ops/arith.rs),
//             Swift `static func + (lhs:Self, rhs:Self) -> Self`.
//
//  End-to-end build verification (transpile → clang → run) is a build-host
//  job (aiden / summer) or PR CI — mini is git/gh only. Build + run:
//
//      HEXA_OP_OVERLOAD=1 hexa build self/test_operator_overload_dispatch.hexa
//      ./a.out
//
//  Expected stdout (flag ON):
//      4
//      6
//      30
//
//  The explicit-method form `a.__add(b)` below is an ordinary method call —
//  it dispatches identically with the flag ON or OFF and is interpreter-
//  runnable, so it doubles as a parser/AST sanity anchor for the surface.
// =====================================================================

struct Vec2 {
    x: int,
    y: int,
}

impl Vec2 {
    // Operator-overload method. `__add` is a plain identifier — accepted by
    // the frozen parser exactly like any other method name (cf. the many
    // `_`-prefixed identifiers throughout self/). Receiver = LHS operand,
    // second param = RHS, mirroring Rust's add(self, rhs).
    fn __add(self, other) {
        return Vec2 { x: self.x + other.x, y: self.y + other.y }
    }
}

fn main() {
    let a = Vec2 { x: 1, y: 2 }
    let b = Vec2 { x: 3, y: 4 }

    // Operator form — under HEXA_OP_OVERLOAD=1 lowers to Vec2____add(a, b).
    let c = a + b
    println(c.x)        // 4
    println(c.y)        // 6

    // Non-struct `+` is byte-for-byte unchanged (still the hexa_add path).
    let n = 1 + 2 + 27
    println(n)          // 30
}

// NOTE: `fn main()` is auto-invoked by hexa-strict — no explicit `main()`
// call (a trailing call would double-run under the interp path).
