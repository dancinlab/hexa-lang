// ═══════════════════════════════════════════════════════════
//  hexaw.hexa — .hexaw weight format (Phase 0 loader/saver)
//
//  Two on-disk formats:
//    HEXAW1  — legacy plaintext (float-as-decimal, whitespace-
//              delimited). Still written by hexaw_save() for
//              backward compatibility with smoke tests that rely
//              on a purely text-based dump.
//    HEXAW2  — binary f32 (little-endian). Raw IEEE-754 bytes,
//              ~3.5× smaller than HEXAW1 on Qwen2.5-14B (56GB
//              vs 118GB) so the converted file actually fits on
//              H100 NVMe. Written by hexaw_save_binary() and
//              streaming callers via self/tools/safetensors_to_hexaw.
//
//  HEXAW2 on-disk layout (newline-terminated header lines, raw
//  f32 payload; payload is *not* newline-terminated to stay
//  exactly count*4 bytes regardless of byte values):
//
//      "HEXAW2\n"
//      "<n_tensors>\n"
//      Per tensor:
//          "<name>\n"
//          "<ndim>\n"
//          "<d0>\n<d1>\n...\n<d(ndim-1)>\n"
//          "<count>\n"
//          <count * 4 raw LE f32 bytes>   (no trailing newline)
//
//  Public API:
//      hexaw_save(path, names, shapes, datas)          — HEXAW1 plaintext
//      hexaw_save_binary(path, names, shapes, datas)   — HEXAW2, buffered
//      hexaw_load(path) -> HexawRecord                 — autodetects magic
//      hexaw_tensor(hxw, name) -> flat float array     (@memoize cache)
//      hexaw_from_arrays(names, shapes, datas)         convenience
//
//  AI-NATIVE attrs:
//      @lazy       parse on first access (mmap-like)
//      @memoize    weight_dict cache — repeated tensor fetch O(1)
//      @pure       math helpers
// ═══════════════════════════════════════════════════════════

use "self/stdlib/law_io"

// ── tiny int-to-string / float-to-string helpers ─────────
@pure
fn hexaw_i2s(n) { return to_string(n) }

@pure
fn hexaw_f2s(x) { return to_string(x) }

// ── split one whitespace-delimited "word stream" into tokens ─
fn hexaw_tokenize(src) {
    // normalize newlines to spaces then split on spaces, drop empties
    let mut s = ""
    let chars = src.chars()
    let n = len(chars)
    let mut i = 0
    while i < n {
        let c = to_string(chars[i])
        if c == "\n" || c == "\t" || c == "\r" {
            s = s + " "
        } else {
            s = s + c
        }
        i = i + 1
    }
    let raw = s.split(" ")
    let mut toks = []
    let m = len(raw)
    let mut k = 0
    while k < m {
        if len(raw[k]) > 0 {
            toks = toks + [raw[k]]
        }
        k = k + 1
    }
    return toks
}

// ── product of a shape list ──────────────────────────────
@pure
fn hexaw_numel(shape) {
    let mut p = 1
    let n = len(shape)
    let mut i = 0
    while i < n { p = p * shape[i]; i = i + 1 }
    return p
}

// ── SAVE (HEXAW1, plaintext) ─────────────────────────────
//  names:  [string]            tensor names
//  shapes: [[int]]             per-tensor shape list
//  datas:  [[float]]           per-tensor flat data
fn hexaw_save(path, names, shapes, datas) {
    let n = len(names)
    let mut out = "HEXAW1\n" + hexaw_i2s(n) + "\n"
    let mut i = 0
    while i < n {
        let name = names[i]
        let shape = shapes[i]
        let data = datas[i]
        let ndim = len(shape)
        let count = len(data)
        let mut header = name + " " + hexaw_i2s(ndim)
        let mut d = 0
        while d < ndim {
            header = header + " " + hexaw_i2s(shape[d])
            d = d + 1
        }
        header = header + " " + hexaw_i2s(count) + "\n"
        out = out + header

        let mut row = ""
        let mut j = 0
        while j < count {
            if j > 0 { row = row + " " }
            row = row + hexaw_f2s(data[j])
            j = j + 1
        }
        out = out + row + "\n"
        i = i + 1
    }
    safe_write_file(path, out)
    return true
}

// ── IEEE-754 f32 → 4 little-endian bytes ─────────────────
// Hand-rolled bit-level encoder: hexa has no bitcast intrinsic
// and runs the converter in interpreter mode during the test
// (so we cannot fall back to a C shim). Works for finite values,
// ±0, subnormals and Inf/NaN round-trip bit-exactly.
@pure
fn hexaw_f32_to_bytes(x) {
    // Sign
    let mut sign = 0
    let mut v = x
    if v < 0.0 { sign = 1; v = 0.0 - v }
    // NaN — emit a canonical quiet NaN (0x7fc00000)
    if x != x {
        return [0, 0, 192, 127]
    }
    // Zero
    if v == 0.0 {
        if sign == 1 { return [0, 0, 0, 128] }
        return [0, 0, 0, 0]
    }
    // Infinity detection: compare against a very large finite upper bound.
    // Fails for IEEE finite numbers above ~3.4e38 (out of f32 range anyway).
    if v > 3.4028235e38 {
        if sign == 1 { return [0, 0, 128, 255] }
        return [0, 0, 128, 127]
    }
    // Decompose into 2^e * m, 1.0 ≤ m < 2.0
    let mut e = 0
    let mut m = v
    while m >= 2.0 { m = m / 2.0; e = e + 1 }
    while m < 1.0 { m = m * 2.0; e = e - 1 }
    let biased = e + 127
    // Subnormal if biased ≤ 0: IEEE stores significand without the
    // implicit 1 and with exponent field 0.
    let mut exp_bits = 0
    let mut mant_bits = 0
    if biased <= 0 {
        // Shift mantissa right by (1 - biased) positions relative to
        // the normalized form, then truncate to 23 bits.
        let shift = 1 - biased
        let mut sub = m
        let mut s = 0
        while s < shift { sub = sub / 2.0; s = s + 1 }
        // sub is in [0, 1). Multiply by 2^23 to get the 23-bit mantissa.
        let scaled = sub * 8388608.0
        mant_bits = to_int(scaled)
        exp_bits = 0
    } else if biased >= 255 {
        // Already handled above, but keep a defensive branch.
        exp_bits = 255
        mant_bits = 0
    } else {
        // Normal: drop the implicit leading 1, encode 23 fractional bits.
        let frac = m - 1.0
        let scaled = frac * 8388608.0
        mant_bits = to_int(scaled)
        exp_bits = biased
    }
    // Pack into 32-bit word: sign(1) | exp(8) | mant(23)
    let b0 = mant_bits % 256
    let b1 = (mant_bits / 256) % 256
    let lo_exp = exp_bits % 2          // low bit of exponent goes into bit 7 of b2
    let hi_exp = exp_bits / 2          // upper 7 bits into b3
    let b2 = ((mant_bits / 65536) % 128) + lo_exp * 128
    let b3 = (sign * 128) + hi_exp
    return [b0, b1, b2, b3]
}

// ── 4 little-endian bytes → IEEE-754 f32 ────────────────
@pure
fn hexaw_bytes_to_f32(b0, b1, b2, b3) {
    let sign = b3 / 128
    let exp_bits = ((b3 % 128) * 2) + (b2 / 128)
    let mant_bits = (b2 % 128) * 65536 + b1 * 256 + b0
    // Special cases
    if exp_bits == 0 && mant_bits == 0 {
        if sign == 1 { return 0.0 - 0.0 }
        return 0.0
    }
    if exp_bits == 255 {
        // NaN or Inf — emit sentinel floats. NaN collapses to Inf in the
        // hexa runtime, which is acceptable for our weight payload.
        if sign == 1 { return 0.0 - 3.4028235e38 }
        return 3.4028235e38
    }
    let mut mant = 0.0
    if exp_bits == 0 {
        // Subnormal
        mant = to_float(mant_bits) / 8388608.0
    } else {
        // Normal: implicit leading 1
        mant = 1.0 + to_float(mant_bits) / 8388608.0
    }
    let mut e = exp_bits - 127
    let mut val = mant
    if exp_bits == 0 { e = -126 }
    if e >= 0 {
        let mut i = 0
        while i < e { val = val * 2.0; i = i + 1 }
    } else {
        let mut i = 0
        while i < (0 - e) { val = val / 2.0; i = i + 1 }
    }
    if sign == 1 { val = 0.0 - val }
    return val
}

// ── SAVE (HEXAW2, binary f32 little-endian) ──────────────
// Buffered single-shot write — safe for small tensors in the
// interpreter smoke test. The production converter uses
// write_bytes_append directly and streams per chunk so it can
// handle the full 56GB 14B dump without buffering in RAM.
fn hexaw_save_binary(path, names, shapes, datas) {
    let n = len(names)
    let mut buf = []
    // header: "HEXAW2\n" (7 bytes) + <n_tensors>\n
    let hdr_str = "HEXAW2\n" + hexaw_i2s(n) + "\n"
    let mut hi = 0
    while hi < len(hdr_str) {
        buf = buf + [char_code(hdr_str, hi)]
        hi = hi + 1
    }
    let mut i = 0
    while i < n {
        let name = names[i]
        let shape = shapes[i]
        let data = datas[i]
        let ndim = len(shape)
        let count = len(data)
        // Per-tensor header: name\nndim\nd0..d(ndim-1)\ncount\n
        let mut hstr = name + "\n" + hexaw_i2s(ndim) + "\n"
        let mut d = 0
        while d < ndim {
            hstr = hstr + hexaw_i2s(shape[d]) + "\n"
            d = d + 1
        }
        hstr = hstr + hexaw_i2s(count) + "\n"
        let mut hi2 = 0
        while hi2 < len(hstr) {
            buf = buf + [char_code(hstr, hi2)]
            hi2 = hi2 + 1
        }
        // Payload: count × f32 LE
        let mut j = 0
        while j < count {
            let bs = hexaw_f32_to_bytes(data[j])
            buf = buf + bs
            j = j + 1
        }
        i = i + 1
    }
    write_bytes(path, buf)
    return true
}

// ── HexaW record struct ─────────────────────────────────
//  boxing-unbox r2: `datas[i]` is now a **farr32 handle** (native FP32
//  float[] handle, 4 B/elem) — NOT a boxed [float] array. The boxed
//  per-element f32 (176 B/elem → 44× blowup, jetsam on real weights)
//  is gone: HEXAW2 tensors are streamed straight off disk into a farr32
//  via read_f32_array_at (RSS≈raw f32 size, 1×). `counts[i]` carries the
//  element count (farr32 has no boxed len()), so consumers index via
//  farr32_get(hexaw_tensor(...), i) and size via hexaw_count(...).
struct HexawRecord {
    path: string,
    names: array,
    shapes: array,
    datas: array,
    counts: array
}

// ── LOAD ─────────────────────────────────────────────────
//  Autodetects magic: HEXAW1 (plaintext) or HEXAW2 (binary f32).
//  Returns HexawRecord with names/shapes/datas arrays.
//
//  NOTE: the original @lazy attr was removed because the lazy-thunk
//  cache in self/hexa_full.hexa is keyed by function name only and
//  would return the same HexawRecord for every path. For big single-
//  shot loads callers can cache the record themselves.
fn hexaw_load(path) {
    // Peek just the 7-byte magic via read_bytes_at — NO whole-file slurp.
    // boxing-unbox r2: the prior read_file_bytes(path) boxed EVERY byte of
    // the file (~16 B/byte AOT) before we even knew the format; for a 56GB
    // HEXAW2 dump that is instant jetsam. We now read the 7-byte magic only,
    // then the HEXAW2 path streams each tensor's f32 payload directly off
    // disk into a farr32 (1× RSS) via read_f32_array_at.
    let magic = read_bytes_at(path, 0, 7)
    let nb = len(magic)
    if nb < 7 {
        println("[hexaw] ERROR: empty/short file " + path)
        return HexawRecord { path: path, names: [], shapes: [], datas: [], counts: [] }
    }
    // Magic byte 0-5 = "HEXAW", byte 6 = '1' or '2'
    if magic[0] == 72 && magic[1] == 69 && magic[2] == 88 && magic[3] == 65 && magic[4] == 87 && magic[5] == 50 {
        return hexaw_load_binary(path)
    }
    // Legacy text path — reuse existing tokenizer (HEXAW1 = KB smoke files)
    let src = read_file(path)
    return hexaw_load_text(path, src)
}

// HEXAW1 text parser (extracted from the original hexaw_load).
fn hexaw_load_text(path, src) {
    let toks = hexaw_tokenize(src)
    let ntok = len(toks)
    if ntok < 2 {
        println("[hexaw] ERROR: empty/short file " + path)
        return HexawRecord { path: path, names: [], shapes: [], datas: [], counts: [] }
    }
    if toks[0] != "HEXAW1" {
        println("[hexaw] ERROR: bad magic " + toks[0])
        return HexawRecord { path: path, names: [], shapes: [], datas: [], counts: [] }
    }
    let n = to_int(toks[1])
    let mut names = []
    let mut shapes = []
    let mut datas = []
    let mut counts = []
    let mut p = 2
    let mut t = 0
    while t < n {
        if p >= ntok {
            println("[hexaw] ERROR: truncated header")
            return HexawRecord { path: path, names: names, shapes: shapes, datas: datas, counts: counts }
        }
        let name = toks[p]; p = p + 1
        let ndim = to_int(toks[p]); p = p + 1
        let mut shape = []
        let mut d = 0
        while d < ndim {
            shape = shape + [to_int(toks[p])]
            p = p + 1
            d = d + 1
        }
        let count = to_int(toks[p]); p = p + 1
        // r2: text values parse into a farr32 handle (4 B/elem), not a boxed
        // [float]. HEXAW1 is KB smoke-test only, so the per-element set loop
        // here is fine — it keeps hexaw_tensor's return type uniform (farr32).
        let data = farr32_zeros(count)
        let mut j = 0
        while j < count {
            farr32_set(data, j, to_float(toks[p]))
            p = p + 1
            j = j + 1
        }
        names = names + [name]
        shapes = shapes + [shape]
        datas = datas + [data]
        counts = counts + [count]
        t = t + 1
    }
    return HexawRecord { path: path, names: names, shapes: shapes, datas: datas, counts: counts }
}

// ── HEXAW2 header-field reader (boxing-unbox r2) ─────────
//  Reads ASCII bytes from `path` starting at absolute byte `off` up to
//  (but not including) the next 0x0A newline, returning [field_string,
//  next_off] where next_off is the byte just PAST the newline. Headers
//  are tiny (a name line + a few decimal-int lines per tensor), so a
//  bounded HDR_WIN read per field is O(header) transient — never the
//  payload. `want_str` controls UTF-8 decode (name) vs leave-as-bytes.
// (plain byte I/O parse — no formula, so no @cite/@verify/@grace needed at S8)
fn _hexaw_read_field(path, off, want_str) {
    let HDR_WIN = 4096
    let mut field_bytes = []
    let mut o = off
    let mut found_nl = false
    while !found_nl {
        let win = read_bytes_at(path, o, HDR_WIN)
        let wlen = len(win)
        if wlen == 0 {
            // EOF before newline — return what we have.
            break
        }
        let mut k = 0
        while k < wlen {
            if win[k] == 10 {
                o = o + k + 1
                found_nl = true
                break
            }
            field_bytes.push(win[k] & 0xFF)
            k = k + 1
        }
        if !found_nl {
            o = o + wlen
            if wlen < HDR_WIN { break }   // short read = EOF
        }
    }
    if want_str {
        // UTF-8 decode ONCE (tensor names may be non-ASCII; OP-127 class).
        return [bytes_to_str_raw(field_bytes), o]
    }
    // ASCII digit field — string form for to_int (provably <0x80).
    let mut s = ""
    let mut i = 0
    let m = len(field_bytes)
    while i < m {
        s = s + to_string(from_char_code(field_bytes[i]))
        i = i + 1
    }
    return [s, o]
}

// HEXAW2 binary parser — STREAMING (boxing-unbox r2).
//  Walks newline-delimited header fields directly off `path` (bounded
//  header reads), and for each tensor loads its count×f32 LE payload
//  DIRECTLY into a farr32 handle via read_f32_array_at(path, payload_off,
//  count). No whole-file slurp, no boxed-byte intermediate, no boxed
//  [float] — RSS per tensor ≈ raw f32 size (1×). datas[i] is a farr32
//  handle; counts[i] is the element count.
fn hexaw_load_binary(path) {
    // Skip "HEXAW2\n" (7 bytes), then read n_tensors.
    let nres = _hexaw_read_field(path, 7, false)
    let n = to_int(nres[0])
    let mut pos = nres[1]
    let mut names = []
    let mut shapes = []
    let mut datas = []
    let mut counts = []
    let mut t = 0
    while t < n {
        // name line (UTF-8 decode)
        let nmres = _hexaw_read_field(path, pos, true)
        let name = nmres[0]
        pos = nmres[1]
        // ndim
        let ndres = _hexaw_read_field(path, pos, false)
        let ndim = to_int(ndres[0])
        pos = ndres[1]
        // dims
        let mut shape = []
        let mut d = 0
        while d < ndim {
            let dres = _hexaw_read_field(path, pos, false)
            shape = shape + [to_int(dres[0])]
            pos = dres[1]
            d = d + 1
        }
        // count
        let cres = _hexaw_read_field(path, pos, false)
        let count = to_int(cres[0])
        pos = cres[1]
        // payload begins at byte `pos`. Stream count f32s LE straight into
        // a farr32 (4 B/elem, RSS≈raw) — NO boxed bytes, NO per-element box.
        let data = read_f32_array_at(path, pos, count)
        pos = pos + count * 4
        names = names + [name]
        shapes = shapes + [shape]
        datas = datas + [data]
        counts = counts + [count]
        t = t + 1
    }
    return HexawRecord { path: path, names: names, shapes: shapes, datas: datas, counts: counts }
}

// ── @memoize weight_dict cache — lookup flat data by name ─
@memoize
fn hexaw_tensor(hxw, name) {
    let names = hxw.names
    let n = len(names)
    let mut i = 0
    while i < n {
        if names[i] == name {
            // r2: datas[i] is a farr32 handle (4 B/elem), not a boxed [float].
            // Index with farr32_get(handle, j); size with hexaw_count(hxw, name).
            return hxw.datas[i]
        }
        i = i + 1
    }
    // Miss → empty farr32 handle (uniform type; hexaw_count returns 0).
    return farr32_zeros(0)
}

// ── element count for a tensor (r2: farr32 has no boxed len()) ─
//  Returns the number of f32 elements in `name`'s data, or 0 if absent.
fn hexaw_count(hxw, name) {
    let names = hxw.names
    let n = len(names)
    let mut i = 0
    while i < n {
        if names[i] == name { return hxw.counts[i] }
        i = i + 1
    }
    return 0
}

// ── shape lookup ─────────────────────────────────────────
fn hexaw_shape(hxw, name) {
    let names = hxw.names
    let n = len(names)
    let mut i = 0
    while i < n {
        if names[i] == name { return hxw.shapes[i] }
        i = i + 1
    }
    return []
}

// ── JSON-style weight dict → hexaw tuple (convenience) ──
//  Accepts parallel arrays (names, shapes, datas). r2: `datas` here may
//  be boxed [float] arrays (in-memory construction path); we convert
//  each into a farr32 handle so hexaw_tensor's return type stays uniform
//  and the consumers' farr32_get index path works unchanged.
fn hexaw_from_arrays(names, shapes, datas) {
    let n = len(datas)
    let mut fdatas = []
    let mut counts = []
    let mut i = 0
    while i < n {
        let d = datas[i]
        let c = len(d)
        let h = farr32_zeros(c)
        let mut j = 0
        while j < c {
            farr32_set(h, j, d[j])
            j = j + 1
        }
        fdatas = fdatas + [h]
        counts = counts + [c]
        i = i + 1
    }
    return HexawRecord { path: "", names: names, shapes: shapes, datas: fdatas, counts: counts }
}
