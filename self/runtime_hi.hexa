// self/runtime_hi.hexa — M1-lite probe + M1 full file-layer SSOT
// (hxa-20260423-003)
//
// ── M1-lite (str domain — 완료) ──
// 첫 5개 hi-layer 함수를 `.hexa` 로 재구현한 증명 파일.
// docs/runtime_audit_20260423.md §3 — pad_left/pad_right/repeat/center/lines.
// rt_str_* 는 tool/extract_runtime_hi.sh 로 runtime_hi_gen.c 에 static 으로
// emit 되어 runtime.c 에 #include 됨. codegen 은 rt_str_* 직접 디스패치.
//
// ── M1 full · file domain (Step 3 land — hxa-20260423-003) ──
// runtime.c 의 hexa_read_file/hexa_write_file/hexa_file_exists/hexa_read_file_bytes/
// hexa_read_bytes_at/hexa_write_bytes{,_v,_append,_append_v}/hexa_file_size/
// hexa_read_lines/hexa_delete_file/hexa_append_file (12개) 이 rt_file_* +
// rt_read_lines + rt_delete_file + rt_append_file 로 hand-port + hexa_* 가
// shim 으로 재작성됨 (M1-lite Step 3 equivalent).
// Step 4 (.hexa SSOT extract) 는 file I/O 가 libc-level (fopen/fread/fwrite/
// access/unlink) 이라 `.hexa` primitive 로 합성 불가 — 해당 도메인 에서
// hand-port C 가 영구 SSOT 이며, 본 파일은 이 사실을 기록 하는 목적.
// Step 5 (codegen flip to rt_file_*) 는 다음 세션 (위험 무-관 / 단순 rename).

// ── split (runtime.c L3194 대응 — O(n*m) substring scan, arena-only) ──
fn rt_str_split(s: string, delim: string) -> [string] {
    let mut out = []
    if len(delim) == 0 {
        out.push(s)
        return out
    }
    let dlen = len(delim)
    let mut start = 0
    let mut i = 0
    while i <= len(s) - dlen {
        if s.substring(i, i + dlen) == delim {
            out.push(s.substring(start, i))
            start = i + dlen
            i = start
        } else {
            i = i + 1
        }
    }
    out.push(s.substring(start, len(s)))
    return out
}

// ── lines (runtime.c L3363) — "\n" delimiter wrapper ────────────────
fn rt_str_lines(s: string) -> [string] {
    return rt_str_split(s, "\n")
}

// ── pad_left / pad_right (runtime.c L3588, L3611) ───────────────────
// Multi-char pad iteration: ceil((width-slen)/plen) repeats of the pad.
// Returns s unchanged if already >= width, or pad is empty.
fn rt_str_pad_left(s: string, width: int, pad: string) -> string {
    let slen = len(s)
    let plen = len(pad)
    if slen >= width { return s }
    if plen == 0 { return s }
    let pad_total = width - slen
    let mut iters = pad_total / plen
    if iters * plen < pad_total { iters = iters + 1 }
    let mut parts = []
    let mut i = 0
    while i < iters {
        parts.push(pad)
        i = i + 1
    }
    parts.push(s)
    return parts.join("")
}

fn rt_str_pad_right(s: string, width: int, pad: string) -> string {
    let slen = len(s)
    let plen = len(pad)
    if slen >= width { return s }
    if plen == 0 { return s }
    let pad_total = width - slen
    let mut iters = pad_total / plen
    if iters * plen < pad_total { iters = iters + 1 }
    let mut parts = []
    parts.push(s)
    let mut i = 0
    while i < iters {
        parts.push(pad)
        i = i + 1
    }
    return parts.join("")
}

// ── repeat (runtime.c L3561) — count<=0 → "" ──────────────────────
fn rt_str_repeat(s: string, count: int) -> string {
    if count <= 0 { return "" }
    let mut parts = []
    let mut i = 0
    while i < count {
        parts.push(s)
        i = i + 1
    }
    return parts.join("")
}

// ── center (runtime.c L3622) — pad both sides, odd remainder → right ─
fn rt_str_center(s: string, width: int, pad: string) -> string {
    let slen = len(s)
    let plen = len(pad)
    if slen >= width { return s }
    if plen == 0 { return s }
    let total_pad = width - slen
    let left_pad = total_pad / 2
    let right_pad = total_pad - left_pad
    let mut li = left_pad / plen
    if li * plen < left_pad { li = li + 1 }
    let mut ri = right_pad / plen
    if ri * plen < right_pad { ri = ri + 1 }
    let mut parts = []
    let mut i = 0
    while i < li {
        parts.push(pad)
        i = i + 1
    }
    parts.push(s)
    let mut j = 0
    while j < ri {
        parts.push(pad)
        j = j + 1
    }
    return parts.join("")
}

// ── to_upper / to_lower (runtime.c L8428/L8435 대응) ────────────────
// ASCII-only case fold. Per-byte scan via byte_at (raw 0-255). A byte in the
// fold range is remapped through a 26-char lookup table (substring slice);
// all other bytes pass through unchanged as a 1-byte substring. Only
// byte_at + substring + join — the same leaf builtins the seed group uses
// (both present in runtime_core.c), so no new C dependency (no bytes_to_str_raw).
fn rt_str_to_upper(s: string) -> string {
    let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    let n = len(s)
    let mut parts = []
    let mut i = 0
    while i < n {
        let b = s.byte_at(i)
        if b >= 97 && b <= 122 {
            parts.push(upper.substring(b - 97, b - 97 + 1))
        } else {
            parts.push(s.substring(i, i + 1))
        }
        i = i + 1
    }
    return parts.join("")
}

fn rt_str_to_lower(s: string) -> string {
    let lower = "abcdefghijklmnopqrstuvwxyz"
    let n = len(s)
    let mut parts = []
    let mut i = 0
    while i < n {
        let b = s.byte_at(i)
        if b >= 65 && b <= 90 {
            parts.push(lower.substring(b - 65, b - 65 + 1))
        } else {
            parts.push(s.substring(i, i + 1))
        }
        i = i + 1
    }
    return parts.join("")
}

// ── trim (runtime.c L8365) — strip leading/trailing ws (space/\t/\n/\r) ──
// byte_at whitespace scan + a single substring slice (no allocation churn).
fn rt_str_trim(s: string) -> string {
    let n = len(s)
    let mut start = 0
    while start < n {
        let b = s.byte_at(start)
        if b == 32 || b == 9 || b == 10 || b == 13 {
            start = start + 1
        } else {
            break
        }
    }
    let mut end_pos = n
    while end_pos > start {
        let b = s.byte_at(end_pos - 1)
        if b == 32 || b == 9 || b == 10 || b == 13 {
            end_pos = end_pos - 1
        } else {
            break
        }
    }
    return s.substring(start, end_pos)
}

// ── trim_start / trim_end — one-sided whitespace strip (siblings of trim) ──
// Same byte_at whitespace scan + single substring slice; only leaf builtins
// (byte_at + substring), so valid in both the stdlib and no-stdlib TUs.
fn rt_str_trim_start(s: string) -> string {
    let n = len(s)
    let mut start = 0
    while start < n {
        let b = s.byte_at(start)
        if b == 32 || b == 9 || b == 10 || b == 13 {
            start = start + 1
        } else {
            break
        }
    }
    return s.substring(start, n)
}

fn rt_str_trim_end(s: string) -> string {
    let n = len(s)
    let mut end_pos = n
    while end_pos > 0 {
        let b = s.byte_at(end_pos - 1)
        if b == 32 || b == 9 || b == 10 || b == 13 {
            end_pos = end_pos - 1
        } else {
            break
        }
    }
    return s.substring(0, end_pos)
}

// ── string-search predicates (cycle-56/57 — prefix/suffix/contains) ─────────
// Bool-returning byte-compare predicates. The C int-return wrappers
// rt_str_starts_with/rt_str_ends_with (and hexa_str_contains) bridge through
// these via `hexa_truthy(rt_str_*_b(...)) ? 1 : 0`; the `_b` suffix avoids a
// name collision with those C int symbols codegen wraps. Only byte_at + len —
// the same leaf builtins the seed group uses (both present in runtime_core.c),
// so no new C dependency. rt_str_contains_b inlines its substring scan rather
// than calling rt_str_index_of so the group stays fully self-contained (the
// seed carries no index_of body).
fn rt_str_starts_with_b(s: string, prefix: string) -> bool {
    let plen = len(prefix)
    let slen = len(s)
    if plen > slen { return false }
    let mut i = 0
    while i < plen {
        if s.byte_at(i) != prefix.byte_at(i) { return false }
        i = i + 1
    }
    return true
}

fn rt_str_ends_with_b(s: string, suffix: string) -> bool {
    let sfxlen = len(suffix)
    let slen = len(s)
    if sfxlen > slen { return false }
    let offset = slen - sfxlen
    let mut i = 0
    while i < sfxlen {
        if s.byte_at(offset + i) != suffix.byte_at(i) { return false }
        i = i + 1
    }
    return true
}

fn rt_str_contains_b(s: string, sub: string) -> bool {
    let hlen = len(s)
    let nlen = len(sub)
    if nlen == 0 { return true }
    if nlen > hlen { return false }
    let mut i = 0
    while i + nlen <= hlen {
        let mut k = 0
        let mut matched = true
        while k < nlen {
            if s.byte_at(i + k) != sub.byte_at(k) {
                matched = false
                k = nlen
            } else {
                k = k + 1
            }
        }
        if matched { return true }
        i = i + 1
    }
    return false
}

// ── from_int (itoa) — WRITE-SIDE construct prim ─────────────────────
// First construct-half (write-side) member of the rt_str_* native family:
// signed-int → decimal string. The transform/predicate members above READ a
// string and produce a derived one; this CONSTRUCTS a fresh string from a
// scalar — the IO/FMT write-side leaf (the C body in runtime_core.c uses
// `snprintf(buf, …, "%lld", n)`; this hand-builds the same decimal text with
// only the leaf builtins the seed group already uses — substring + join +
// integer arithmetic — so it adds NO new C dependency to the .s seed). The
// digit table is sliced by `d` (0..9) for each remainder; the parts list is
// reversed by prepend-via-front-build so the most-significant digit lands
// first. INT64_MIN is handled by accumulating into i64 with a sign flag taken
// BEFORE the loop (negate per-digit on the still-negative value to dodge the
// −(INT64_MIN) overflow), mirroring the standard libc itoa contract.
fn rt_str_from_int(n: int) -> string {
    if n == 0 { return "0" }
    let digits = "0123456789"
    let neg = n < 0
    // Collect digits least-significant-first, working on the magnitude. To avoid
    // the −(INT64_MIN) overflow we keep n negative throughout and take −(n%10).
    let mut rev = []
    let mut x = n
    if neg {
        while x != 0 {
            let mut d = -(x % 10)        // 0..9 (x negative → remainder ≤ 0)
            if d < 0 { d = -d }          // defensive: |remainder|
            rev.push(digits.substring(d, d + 1))
            x = x / 10
        }
    } else {
        while x != 0 {
            let d = x % 10
            rev.push(digits.substring(d, d + 1))
            x = x / 10
        }
    }
    // rev is least-significant-first; emit most-significant-first.
    let mut parts = []
    if neg { parts.push("-") }
    let m = len(rev)
    let mut i = m - 1
    while i >= 0 {
        parts.push(rev[i])
        i = i - 1
    }
    return parts.join("")
}

// ── M1-lite smoke probe (main은 exit 0, functions 존재 증명) ────────
// 실제 대사(cutover) 는 다음 세션. 이 파일 자체는 interp 컴파일 검증용.
// 호출부 없이도 hexat 가 각 함수를 HexaVal-반환형으로 emit 하는지 확인.
fn runtime_hi_selftest() -> int {
    let a = rt_str_pad_left("7", 3, "0")       // "007"
    let b = rt_str_pad_right("7", 3, "0")      // "700"
    let c = rt_str_repeat("ab", 3)             // "ababab"
    let d = rt_str_center("hi", 6, "-")        // "--hi--"
    let e = rt_str_lines("a\nb\nc")            // ["a","b","c"]
    let f = rt_str_to_upper("Hello, World!")   // "HELLO, WORLD!"
    let g = rt_str_to_lower("Hello, World!")   // "hello, world!"
    let h = rt_str_trim("  hi \t\n")           // "hi"
    let p = rt_str_trim_start("  hi \t\n")     // "hi \t\n"
    let q = rt_str_trim_end("  hi \t\n")       // "  hi"
    let sw = rt_str_starts_with_b("hello", "he")   // true
    let sw2 = rt_str_starts_with_b("hello", "lo")  // false
    let ew = rt_str_ends_with_b("hello", "lo")     // true
    let ew2 = rt_str_ends_with_b("hi", "hello")    // false
    let ct = rt_str_contains_b("hello", "ell")     // true
    let ct2 = rt_str_contains_b("hello", "xyz")    // false
    let ct3 = rt_str_contains_b("hello", "")       // true (empty needle)
    let fi0 = rt_str_from_int(0)                    // "0"
    let fi1 = rt_str_from_int(42)                   // "42"
    let fi2 = rt_str_from_int(-7)                   // "-7"
    let fi3 = rt_str_from_int(1000000)              // "1000000"
    let fi4 = rt_str_from_int(-1234567890)          // "-1234567890"
    if a == "007" && b == "700" && c == "ababab" && d == "--hi--" && len(e) == 3
        && f == "HELLO, WORLD!" && g == "hello, world!" && h == "hi"
        && p == "hi \t\n" && q == "  hi"
        && sw && !sw2 && ew && !ew2 && ct && !ct2 && ct3
        && fi0 == "0" && fi1 == "42" && fi2 == "-7"
        && fi3 == "1000000" && fi4 == "-1234567890" {
        return 0
    }
    return 1
}

fn main() {
    let rc = runtime_hi_selftest()
    if rc == 0 {
        println("runtime_hi: selftest OK")
    } else {
        println("runtime_hi: selftest FAIL")
        exit(1)
    }
}
