#!hexa lax
// self/test_char_code_pure.hexa — OP-86 behaviour-table + invariant lock
// for self/runtime/char_code_pure.hexa.
//
// METHOD: DOCSTRING-vs-BEHAVIOUR (the documented table in the module
// header, lines 25-31, mirrors runtime.c:4297 hexa_char_code) plus an
// INTERNAL DIFFERENTIAL — char_code_pure(s,i) must equal the i-th
// element of string_bytes_range_pure(s,i,i+1), and the full-range scan
// must clip out-of-range indices like hexa_str_slice. No external KAT
// needed: the C runtime body IS the contract, transcribed into asserts.
//
// Inlined (codegen_c2 import/use not wired for test files).

@pure
pub fn char_code_pure(s, idx) {
    if type_of(s) != "string" { return 0 }
    if type_of(idx) != "int" { return 0 }
    let n = len(s)
    if idx < 0 { return 0 }
    if idx >= n { return 0 }
    ord(s.substring(idx, idx + 1))
}
@pure
pub fn byte_at_pure(s, idx) {
    char_code_pure(s, idx)
}
@pure
pub fn string_bytes_range_pure(s, start_idx, end_idx) {
    if type_of(s) != "string" { return [] }
    let n = len(s)
    let mut a = start_idx
    let mut b = end_idx
    if a < 0 { a = 0 }
    if b > n { b = n }
    if a >= b { return [] }
    let mut out = []
    let mut i = a
    while i < b {
        out.push(ord(s.substring(i, i + 1)))
        i = i + 1
    }
    out
}

let mut pass_count = 0
let mut fail_count = 0
fn ck(actual, expected, msg) {
    if to_string(actual) == to_string(expected) { pass_count = pass_count + 1 }
    else { println("[FAIL] " + msg + " exp " + to_string(expected) + " got " + to_string(actual)); fail_count = fail_count + 1 }
}

// Documented behaviour table (runtime.c:4297).
ck(char_code_pure("abc", 0), 97, "abc[0]")
ck(char_code_pure("abc", 2), 99, "abc[2]")
ck(char_code_pure("abc", 3), 0, "abc[3] oob")
ck(char_code_pure("abc", 0 - 1), 0, "abc[-1]")
ck(char_code_pure("", 0), 0, "empty[0]")
ck(char_code_pure(123, 0), 0, "non-string")
ck(char_code_pure("abc", "x"), 0, "non-int idx")
ck(byte_at_pure("abc", 1), 98, "byte_at alias")

// INTERNAL DIFFERENTIAL: per-char codes == single-element ranges.
let s = "Hello, World!"
let mut i = 0
while i < len(s) {
    let single = string_bytes_range_pure(s, i, i + 1)
    ck(char_code_pure(s, i), single[0], "range-vs-charcode i=" + to_string(i))
    i = i + 1
}

// Range clipping semantics (match hexa_str_slice).
ck(len(string_bytes_range_pure(s, 0, len(s))), len(s), "full range length")
ck(string_bytes_range_pure(s, 0 - 5, 3), string_bytes_range_pure(s, 0, 3), "neg start clips to 0")
ck(string_bytes_range_pure(s, 10, 999), string_bytes_range_pure(s, 10, len(s)), "end clips to n")
ck(string_bytes_range_pure(s, 5, 5), [], "empty range a==b")
ck(string_bytes_range_pure(s, 8, 3), [], "reversed range a>b")

println("__HEXA_RUNTIME_CHAR_CODE__ " + to_string(pass_count) + "/" + to_string(pass_count + fail_count))
if fail_count > 0 { println("CC-FAIL"); exit(1) }
println("CC-ALL-PASS")
