    buf = buf + "    return hexa_bool((HX_IS_STR(a) && HX_STR(a) && hxlcl_isalpha((unsigned char)HX_STR(a)[0]))\n"
    buf = buf + "                  || (HX_TAG(a) == TAG_CHAR && hxlcl_isalpha((unsigned char)HX_INT(a))));\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_is_alphanumeric (frozen runtime.c — VERBATIM bare-wrapper, exported)\n"
