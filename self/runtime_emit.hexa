    buf = buf + "    const unsigned char* in = (const unsigned char*)HX_STR(s);\n"
    buf = buf + "    size_t n = HX_STRLEN(s);\n"
    buf = buf + "    char* out = (char*)malloc(n + 1);\n"
    buf = buf + "    size_t j = 0;\n"
