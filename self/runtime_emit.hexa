    buf = buf + "}\n"
    buf = buf + "// hexa_read_stdin (frozen runtime.c L12129 — hxlcl_read delegate, slurp fd 0)\n"
    buf = buf + "HexaVal hexa_read_stdin(void) {\n"
    buf = buf + "    size_t cap = 4096, len = 0;\n"
