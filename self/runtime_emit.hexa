#!hexa strict
// runtime_emit.hexa
//   RFC 061 ∅ campaign — the FIRST batch of the .hexa SSOT emitter for
//   self/runtime.c PROPER's 558 HI-tier bodies (ING #35, zero-c r13).
//
// WHY THIS EXISTS
// ───────────────
// r12 (tool/zeroc_drop_runtime_measure.sh) MEASURED that `ls self/*.c → 0`
// is blocked NOT by a circular bootstrap floor (TRULY_CIRCULAR=0) but by the
// fact that self/runtime.c PROPER (the frozen blob 151c52c8 amalgam) has NO
// .hexa SSOT emitter — only the CORE tier (runtime_core.c) does, via
// runtime_core_emit.hexa. The 558 HI-tier bodies have no supplier once
// runtime.c is dropped from the compile, so the drop residual is 558.
//
// THIS FILE authors the FIRST tractable batch of those 558 — the 12
// self-contained LEAF rt_* prims (no fs/syscall/runtime dependency, pure
// arithmetic / constant / Taylor bodies). Each is ported VERBATIM from its
// definition in the frozen runtime.c blob (the reference C source), in the
// same `buf = buf + "<C-line>"` un-escapable form runtime_core_emit.hexa
// uses — so tool/regen_runtime_hi_seed_c.sh (the awk un-escaper, identical to
// regen_runtime_core_c.sh's) reproduces the .c VERBATIM and a 1-line TU
// compiles it into a seed .o (build/runtime_hi_seed.o).
//
// SCOPE / SAFETY (self-host ≠ release ABSOLUTE TOP)
// ─────────────────────────────────────────────────
//   * This emitter + its emitted seed are EXPERIMENTAL. They are compiled and
//     linked ONLY under the experimental HEXA_ZEROC_DROP_RUNTIME drop path
//     (the r13 measure harness). The DEFAULT / shipping build NEVER compiles
//     this seed — frozen runtime.c stays the SSOT on the default path and is
//     byte-IDENTICAL. The seed bodies define the SAME symbols the frozen
//     runtime.c defines, so they MUST NOT be linked together on the default
//     build (they are mutually exclusive: seed supplies the body iff runtime.c
//     is dropped).
//   * frozen blob 151c52c8 is NOT touched — this is a NEW, separate file.
//
// PORTED BODIES — batch 1 (leaf rt_* cluster, 12 of the 19 rt_*):
//   rt_isalnum rt_isalpha            (integer range classify)
//   rt_net_fail rt_net_zero rt_posix_ok   (constant returns)
//   rt_pthread_noop rt_pthread_create_policy  (constant returns)
//   rt_fmod rt_exp rt_log rt_cos rt_sin   (self-contained Taylor / libm-free)
// The remaining 7 rt_* (rt_append_file rt_delete_file rt_read_lines
// rt_fs_append_atomic rt_fs_stat rt_fs_rotate_if_over rt_fs_mkdir_p) need
// syscall/libc fs wrappers → deferred to a later batch (honest residual).
//
// PORTED BODIES — batch 2 (libm-leaf hexa_math_* cluster, ING #35 r14):
//   hexa_math_tanh tan asin acos atan atan2 pow lgamma tgamma erf erfc
//   j0 j1 isnan isinf isfinite   (16 self-contained one-line libm wrappers)
// These delegate to native libm; the libm symbol stays an UNDEFINED ref in
// the object-only seed .o and is resolved by -lm at the FINAL link. So they
// are emittable LEAVES — libm is a link-time dep, not an in-body wall. This
// RE-TESTS and FALSIFIES the "libm is irreducible" assumption for the wrapper
// surface (the irreducible part is the libm *implementation*, not the hexa
// wrapper, which this emitter now supplies from .hexa SSOT).
// EXCLUDED from batch 2: hexa_math_sin cos log exp fmod — they route through
// the STATIC hxlcl_sin/cos/log/exp/fmod helpers internal to runtime.c (not
// self-contained in this seed TU); deferred until those statics are emitted.
//
// PORTED BODIES — batch 3 (HexaVal-tail accessor leaves, ING #35 r16):
//   hexa_clamp hexa_is_empty hexa_byte_len hexa_from_cstring
//   hexa_struct_free hexa_str_parse_float   (6 self-contained accessors)
// Pure HexaVal struct-deref / tag-macro / int-encoded-pointer accessors. Each
// is ported from the ACTIVE branch of frozen runtime.c — the drop-measure TU
// does NOT define HEXA_HAS_HEXA_RT_STDLIB, so the #ifndef fallback branch is
// the live one (clamp/str_parse_float); is_empty/byte_len/from_cstring/
// struct_free are unguarded. All referenced helpers (__hx_to_double, hexa_int/
// float/bool/str/void, HX_* macros, libc strtod/free) are supplied OUTSIDE the
// residual (verified), so these are emittable leaves with no in-body wall.
// EXCLUDED (HexaVal-tail but deep-coupled, honest residual): hexa_str_parse_int
// (#else branch active → hxlcl_strtoll + hexa_throw + snprintf), hexa_array_
// enumerate / hexa_str_bytes (#ifndef branch uses hexa_array_new/push = alloc
// WALL-2), hexa_is_error / hexa_is_alpha (hxlcl_strncmp/isalpha statics),
// hexa_chr_byte (hexa_strbuf_alloc), hexa_callback_slot_id (static __hexa_cb_
// slots pool). Total emitter bodies now 28 → 34.
//
// Invocation:  hexa-run runtime_emit.hexa <output-path>
// Default output path (if argv missing): "runtime_hi_seed.c" in cwd.

let MODULE_NAME = "runtime_emit"

fn _flush_runtime_hi(out_path: str, buf: str) {
    let _ = exec("cat >> \"" + out_path + "\" <<'GEN_runtime_hi_EOF'\n" + buf + "GEN_runtime_hi_EOF")
}

fn emit_runtime_hi_seed_to(out_path: str) {
    let _ = exec("printf '' > \"" + out_path + "\"")
    let mut buf = ""
    buf = buf + "// ═══════════════════════════════════════════════════════════\n"
    buf = buf + "//  runtime_hi_seed.c — GENERATED from self/runtime_emit.hexa (SSOT).\n"
    buf = buf + "//  RFC 061 ∅ campaign zero-c r13 — first batch of the runtime.c\n"
    buf = buf + "//  PROPER HI-tier emitter (12 self-contained leaf rt_* prims).\n"
    buf = buf + "//\n"
    buf = buf + "//  Do NOT hand-edit. Re-run the emitter (tool/regen_runtime_hi_seed_c.sh)\n"
    buf = buf + "//  if it ever changes. Bodies are VERBATIM ports of the frozen\n"
    buf = buf + "//  runtime.c (blob 151c52c8) definitions — byte-faithful reference.\n"
    buf = buf + "//\n"
    buf = buf + "//  This seed is compiled ONLY under the experimental drop path. The\n"
    buf = buf + "//  default / shipping build NEVER compiles it (frozen runtime.c stays\n"
    buf = buf + "//  the SSOT, byte-identical). The symbols here are the SAME ones the\n"
    buf = buf + "//  frozen runtime.c defines — they supply those bodies iff runtime.c\n"
    buf = buf + "//  is dropped from the compile.\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════\n"
    buf = buf + "\n"
    buf = buf + "// ── ctype classify (frozen runtime.c L2240) ──────────────────\n"
    buf = buf + "HexaVal rt_isalnum(HexaVal c) {\n"
    buf = buf + "    int64_t v = HX_INT(c);\n"
    buf = buf + "    int b = ((v >= 48 && v <= 57) ||\n"
    buf = buf + "             (v >= 65 && v <= 90) ||\n"
    buf = buf + "             (v >= 97 && v <= 122)) ? 1 : 0;\n"
    buf = buf + "    return hexa_bool(b);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal rt_isalpha(HexaVal c) {\n"
    buf = buf + "    int64_t v = HX_INT(c);\n"
    buf = buf + "    int b = ((v >= 65 && v <= 90) ||\n"
    buf = buf + "             (v >= 97 && v <= 122)) ? 1 : 0;\n"
    buf = buf + "    return hexa_bool(b);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ── net delegation constants (frozen runtime.c L2484) ────────\n"
    buf = buf + "HexaVal rt_net_fail(void) { return hexa_int(-1); }\n"
    buf = buf + "HexaVal rt_net_zero(void) { return hexa_int(0); }\n"
    buf = buf + "HexaVal rt_posix_ok(void) { return hexa_int(0); }\n"
    buf = buf + "\n"
    buf = buf + "// ── pthread noop policy (frozen runtime.c L2422) ─────────────\n"
    buf = buf + "HexaVal rt_pthread_noop(void) { return hexa_int(0); }\n"
    buf = buf + "HexaVal rt_pthread_create_policy(void) { return hexa_int(1); }\n"
    buf = buf + "\n"
    buf = buf + "// ── math helpers (frozen runtime.c L2345) ────────────────────\n"
    buf = buf + "HexaVal rt_fmod(HexaVal x, HexaVal y) {\n"
    buf = buf + "    double dx = HX_FLOAT(x), dy = HX_FLOAT(y);\n"
    buf = buf + "    if (dy == 0.0) return hexa_float(0.0);\n"
    buf = buf + "    double q = dx / dy;\n"
    buf = buf + "    long long iq = (long long)q;\n"
    buf = buf + "    return hexa_float(dx - (double)iq * dy);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal rt_exp(HexaVal x) {\n"
    buf = buf + "    double dx = HX_FLOAT(x);\n"
    buf = buf + "    const double LN2 = 0.6931471805599453;\n"
    buf = buf + "    double n_d = dx / LN2;\n"
    buf = buf + "    long long n = (long long)(n_d + (n_d >= 0.0 ? 0.5 : -0.5));\n"
    buf = buf + "    double r = dx - (double)n * LN2;\n"
    buf = buf + "    double r2 = r*r, r3 = r2*r, r4 = r2*r2;\n"
    buf = buf + "    double sum = 1.0 + r + r2*0.5 + r3*(1.0/6.0) + r4*(1.0/24.0)\n"
    buf = buf + "                 + r4*r*(1.0/120.0) + r4*r2*(1.0/720.0) + r4*r3*(1.0/5040.0);\n"
    buf = buf + "    double pow2 = 1.0;\n"
    buf = buf + "    if (n > 1023) n = 1023;\n"
    buf = buf + "    if (n < -1022) n = -1022;\n"
    buf = buf + "    if (n >= 0) for (long long i = 0; i < n; i++) pow2 *= 2.0;\n"
    buf = buf + "    else for (long long i = 0; i < -n; i++) pow2 *= 0.5;\n"
    buf = buf + "    return hexa_float(sum * pow2);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal rt_log(HexaVal x) {\n"
    buf = buf + "    double dx = HX_FLOAT(x);\n"
    buf = buf + "    if (dx <= 0.0) return hexa_float(-1e308);\n"
    buf = buf + "    int e = 0;\n"
    buf = buf + "    while (dx >= 2.0) { dx *= 0.5; e++; }\n"
    buf = buf + "    while (dx < 1.0) { dx *= 2.0; e--; }\n"
    buf = buf + "    double u = (dx - 1.0) / (dx + 1.0);\n"
    buf = buf + "    double u2 = u*u, u3 = u2*u, u5 = u3*u2, u7 = u5*u2;\n"
    buf = buf + "    double sum = 2.0 * (u + u3/3.0 + u5/5.0 + u7/7.0 + u7*u2/9.0);\n"
    buf = buf + "    return hexa_float(sum + (double)e * 0.6931471805599453);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal rt_cos(HexaVal x) {\n"
    buf = buf + "    double dx = HX_FLOAT(x);\n"
    buf = buf + "    const double TWO_PI = 6.283185307179586;\n"
    buf = buf + "    const double PI = 3.141592653589793;\n"
    buf = buf + "    if (dx < 0.0) dx = -dx;\n"
    buf = buf + "    while (dx >= TWO_PI) dx -= TWO_PI;\n"
    buf = buf + "    if (dx > PI) dx = TWO_PI - dx;\n"
    buf = buf + "    double x2 = dx*dx, x4 = x2*x2, x6 = x4*x2, x8 = x4*x4;\n"
    buf = buf + "    double sum = 1.0 - x2/2.0 + x4/24.0 - x6/720.0 + x8/40320.0\n"
    buf = buf + "                 - x8*x2/3628800.0 + x8*x4/479001600.0 - x8*x6/87178291200.0;\n"
    buf = buf + "    return hexa_float(sum);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal rt_sin(HexaVal x) {\n"
    buf = buf + "    const double PI_HALF = 1.5707963267948966;\n"
    buf = buf + "    HexaVal shifted = hexa_float(HX_FLOAT(x) - PI_HALF);\n"
    buf = buf + "    return rt_cos(shifted);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ── hexa_math_* libm-leaf wrappers (frozen runtime.c L5813-5908) ──\n"
    buf = buf + "// VERBATIM ports of the #ifndef HEXA_HAS_HEXA_RT_STDLIB (libm-direct)\n"
    buf = buf + "// branch — self-contained one-line wrappers that delegate to native\n"
    buf = buf + "// libm (tanh/asin/erf/j0/…). The libm symbol stays an UNDEFINED ref in\n"
    buf = buf + "// this seed .o (object-only) and is resolved by -lm at the final link —\n"
    buf = buf + "// proving the 'libm is irreducible' assumption FALSE for these leaves:\n"
    buf = buf + "// the body itself is hexa-emittable C, libm is just a link-time dep.\n"
    buf = buf + "// (sin/cos/log/exp/fmod EXCLUDED — they route through static hxlcl_*\n"
    buf = buf + "//  helpers internal to runtime.c, not self-contained in this TU.)\n"
    buf = buf + "HexaVal hexa_math_tanh(HexaVal x) { return hexa_float(tanh(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_tan(HexaVal x)  { return hexa_float(tan(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_asin(HexaVal x) { return hexa_float(asin(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_acos(HexaVal x) { return hexa_float(acos(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_atan(HexaVal x) { return hexa_float(atan(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_atan2(HexaVal y, HexaVal x) { return hexa_float(atan2(HX_FLOAT(y), HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_pow(HexaVal b, HexaVal e) { return hexa_float(pow(HX_FLOAT(b), HX_FLOAT(e))); }\n"
    buf = buf + "HexaVal hexa_math_lgamma(HexaVal x)   { return hexa_float(lgamma(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_tgamma(HexaVal x)   { return hexa_float(tgamma(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_erf(HexaVal x)      { return hexa_float(erf(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_erfc(HexaVal x)     { return hexa_float(erfc(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_j0(HexaVal x)       { return hexa_float(j0(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_j1(HexaVal x)       { return hexa_float(j1(HX_FLOAT(x))); }\n"
    buf = buf + "HexaVal hexa_math_isnan(HexaVal x)    { return hexa_bool(isnan(HX_FLOAT(x)) ? 1 : 0); }\n"
    buf = buf + "HexaVal hexa_math_isinf(HexaVal x)    { return hexa_bool(isinf(HX_FLOAT(x)) ? 1 : 0); }\n"
    buf = buf + "HexaVal hexa_math_isfinite(HexaVal x) { return hexa_bool(isfinite(HX_FLOAT(x)) ? 1 : 0); }\n"
    buf = buf + "\n"
    buf = buf + "// ── HexaVal-tail accessor leaves (frozen runtime.c PROPER) — ING #35 r16 ──\n"
    buf = buf + "// Self-contained struct-deref / tag-macro accessor bodies ported VERBATIM\n"
    buf = buf + "// from the ACTIVE branch of the frozen runtime.c (the #ifndef\n"
    buf = buf + "// HEXA_HAS_HEXA_RT_STDLIB fallback branch is the one the drop-measure TU\n"
    buf = buf + "// compiles — it does NOT define HEXA_HAS_HEXA_RT_STDLIB). Every helper they\n"
    buf = buf + "// reference (__hx_to_double, hexa_int/float/bool/str/void, HX_* macros,\n"
    buf = buf + "// libc strtod/free) is supplied OUTSIDE the residual, so these are true\n"
    buf = buf + "// emittable leaves — no alloc / hxlcl_* static / syscall / TAG_FN dispatch.\n"
    buf = buf + "// clamp(x,lo,hi): scalar clamp, float result (frozen runtime.c #ifndef br).\n"
    buf = buf + "HexaVal hexa_clamp(HexaVal xv, HexaVal lov, HexaVal hiv) {\n"
    buf = buf + "    double x = __hx_to_double(xv);\n"
    buf = buf + "    double lo = __hx_to_double(lov);\n"
    buf = buf + "    double hi = __hx_to_double(hiv);\n"
    buf = buf + "    if (x < lo) return hexa_float(lo);\n"
    buf = buf + "    if (x > hi) return hexa_float(hi);\n"
    buf = buf + "    return hexa_float(x);\n"
    buf = buf + "}\n"
    buf = buf + "// is_empty(v): array/str emptiness; everything else → empty.\n"
    buf = buf + "HexaVal hexa_is_empty(HexaVal v) {\n"
    buf = buf + "    if (HX_IS_ARRAY(v)) return hexa_bool(HX_ARR_LEN(v) == 0);\n"
    buf = buf + "    if (HX_IS_STR(v)) {\n"
    buf = buf + "        const char* s = HX_STR(v);\n"
    buf = buf + "        return hexa_bool(!s || s[0] == '\\0');\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_bool(1);\n"
    buf = buf + "}\n"
    buf = buf + "// byte_len(v): str byte length / array len / map len; else 0.\n"
    buf = buf + "HexaVal hexa_byte_len(HexaVal v) {\n"
    buf = buf + "    if (HX_IS_STR(v))   return hexa_int(HX_STR(v) ? (int64_t)HX_STRLEN(v) : 0);\n"
    buf = buf + "    if (HX_IS_ARRAY(v)) return hexa_int((int64_t)HX_ARR_LEN(v));\n"
    buf = buf + "    if (HX_IS_MAP(v)) {\n"
    buf = buf + "        HexaMapTable* t = HX_MAP_TBL(v);\n"
    buf = buf + "        return hexa_int(t ? (int64_t)t->len : 0);\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int(0);\n"
    buf = buf + "}\n"
    buf = buf + "// from_cstring(ptr): wrap a raw C-string pointer (int-encoded) as TAG_STR.\n"
    buf = buf + "HexaVal hexa_from_cstring(HexaVal ptr) {\n"
    buf = buf + "    uint64_t p = HX_IS_INT(ptr) ? HX_INT_U(ptr) : 0;\n"
    buf = buf + "    if (p == 0) return hexa_str(\"\");\n"
    buf = buf + "    return hexa_str((const char*)(uintptr_t)p);\n"
    buf = buf + "}\n"
    buf = buf + "// struct_free(ptr): free a raw heap pointer (int-encoded); void result.\n"
    buf = buf + "HexaVal hexa_struct_free(HexaVal ptr) {\n"
    buf = buf + "    uint64_t p = HX_IS_INT(ptr) ? HX_INT_U(ptr) : 0;\n"
    buf = buf + "    if (p != 0) free((void*)(uintptr_t)p);\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "// str_parse_float(s): strtod parse (libc link-time dep, #ifndef branch).\n"
    buf = buf + "HexaVal hexa_str_parse_float(HexaVal s) {\n"
    buf = buf + "    if (!HX_IS_STR(s)) return hexa_float(0.0);\n"
    buf = buf + "    return hexa_float(strtod(HX_STR(s), NULL));\n"
    buf = buf + "}\n"
    if buf.len() > 0 { _flush_runtime_hi(out_path, buf) }
}

fn main() {
    let argv = real_args()
    let out_path = if argv.len() >= 1 { argv[0] } else { "runtime_hi_seed.c" }
    emit_runtime_hi_seed_to(out_path)
    let exists_check = exec("[ -f \"" + out_path + "\" ] && echo y || echo n").trim()
    if exists_check != "y" {
        println("[runtime_emit] FATAL: failed to write " + out_path)
        exit(1)
    }
    println("[runtime_emit] wrote " + out_path)
    exit(0)
}
