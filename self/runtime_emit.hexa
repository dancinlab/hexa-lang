    buf = buf + "// hexa_term_getppid (frozen runtime.c — VERBATIM bare-wrapper, exported)\n"
    buf = buf + "HexaVal hexa_term_getppid(void) { return hexa_int((int64_t)term_getppid()); }\n"
    buf = buf + "// hexa_term_install_sigint (frozen runtime.c — VERBATIM bare-wrapper, exported)\n"
    buf = buf + "HexaVal hexa_term_install_sigint(void) { return hexa_int((int64_t)term_install_sigint()); }\n"
    buf = buf + "// hexa_term_install_sigwinch (frozen runtime.c — VERBATIM bare-wrapper, exported)\n"
    buf = buf + "HexaVal hexa_term_install_sigwinch(void) { return hexa_int((int64_t)term_install_sigwinch()); }\n"
    buf = buf + "// hexa_term_isatty_stdin (frozen runtime.c — VERBATIM bare-wrapper, exported)\n"
    buf = buf + "HexaVal hexa_term_isatty_stdin(void) { return hexa_int((int64_t)term_isatty_stdin()); }\n"
    buf = buf + "// hexa_term_isatty_stdout (frozen runtime.c — VERBATIM bare-wrapper, exported)\n"
    buf = buf + "HexaVal hexa_term_isatty_stdout(void) { return hexa_int((int64_t)term_isatty_stdout()); }\n"
    buf = buf + "// hexa_term_raw_enter (frozen runtime.c — VERBATIM bare-wrapper, exported)\n"
    buf = buf + "HexaVal hexa_term_raw_enter(void) { return hexa_int((int64_t)term_raw_enter()); }\n"
    buf = buf + "// hexa_term_raw_restore (frozen runtime.c — VERBATIM bare-wrapper, exported)\n"
    buf = buf + "HexaVal hexa_term_raw_restore(void) { return hexa_int((int64_t)term_raw_restore()); }\n"
    buf = buf + "// hexa_term_read_byte (frozen runtime.c — VERBATIM bare-wrapper, exported)\n"
    buf = buf + "HexaVal hexa_term_read_byte(void) { return hexa_int((int64_t)term_read_byte()); }\n"
    buf = buf + "// hexa_term_sigint_pending (frozen runtime.c — VERBATIM bare-wrapper, exported)\n"
    buf = buf + "HexaVal hexa_term_sigint_pending(void) { return hexa_int((int64_t)term_sigint_pending()); }\n"
    buf = buf + "// hexa_term_sigwinch_pending (frozen runtime.c — VERBATIM bare-wrapper, exported)\n"
    buf = buf + "HexaVal hexa_term_sigwinch_pending(void) { return hexa_int((int64_t)term_sigwinch_pending()); }\n"
    buf = buf + "\n"
    buf = buf + "// batch 13 (ING #29 r30) CARRIER-EMIT real-impl harvest: FP32 farr32 + int64 farr_int (15 bodies)\n"
    buf = buf + "#ifndef FARR_HOST\n"
    buf = buf + "typedef enum { FARR_HOST=0, FARR_DEVICE=1, FARR_MIRRORED=2 } FarrLoc_r30;\n"
    buf = buf + "#define FARR_HOST 0\n"
    buf = buf + "#endif\n"
    buf = buf + "typedef struct { float* buf; int64_t len; void* d_buf; int loc; int pinned; int dirty_host; int dirty_dev; } HexaFarr32Entry;\n"
    buf = buf + "typedef struct { int64_t* buf; int64_t len; } HexaIarrEntry;\n"
    buf = buf + "#ifndef HXFARR_CALLOC\n"
    buf = buf + "#define HXFARR_CALLOC(nm,sz) calloc((nm),(sz))\n"
    buf = buf + "#define HXFARR_FREE(p)       free((p))\n"
    buf = buf + "#endif\n"
    buf = buf + "static HexaFarr32Entry* _hx_farr32_table     = NULL;\n"
    buf = buf + "static int64_t          _hx_farr32_count     = 0;\n"
    buf = buf + "static int64_t          _hx_farr32_capacity    = 0;\n"
    buf = buf + "static int64_t*         _hx_farr32_freelist    = NULL;\n"
    buf = buf + "static int64_t          _hx_farr32_freelist_n  = 0;\n"
    buf = buf + "static int64_t          _hx_farr32_freelist_cap= 0;\n"
    buf = buf + "static HexaIarrEntry*   _hx_iarr_table        = NULL;\n"
    buf = buf + "static int64_t          _hx_iarr_count        = 0;\n"
    buf = buf + "static int64_t          _hx_iarr_capacity     = 0;\n"
    buf = buf + "static int64_t*         _hx_iarr_freelist     = NULL;\n"
    buf = buf + "static int64_t          _hx_iarr_freelist_n   = 0;\n"
    buf = buf + "static int64_t          _hx_iarr_freelist_cap = 0;\n"
    buf = buf + "extern void *hxlcl_memcpy(void *dst, const void *src, size_t n);\n"
    buf = buf + "extern HexaVal hexa_farr32_zeros(HexaVal n_v);\n"
    buf = buf + "extern HexaVal hexa_farr_int_zeros(HexaVal n_v);\n"
    buf = buf + "HexaVal hexa_farr32_zeros(HexaVal n_v) {\n"
    buf = buf + "    int64_t n = hexa_as_num(n_v);\n"
    buf = buf + "    if (n < 0) n = 0;\n"
    buf = buf + "    float* buf = NULL;\n"
    buf = buf + "    if (n > 0) {\n"
    buf = buf + "        buf = (float*)HXFARR_CALLOC((size_t)n, sizeof(float));\n"
    buf = buf + "        if (!buf) {\n"
    buf = buf + "            fprintf(stderr, \"[farr32] OOM allocating %lld floats\\n\",\n"
    buf = buf + "                    (long long)n);\n"
    buf = buf + "            exit(77);\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    int64_t id;\n"
    buf = buf + "    if (_hx_farr32_freelist_n > 0) {\n"
    buf = buf + "        id = _hx_farr32_freelist[--_hx_farr32_freelist_n];\n"
    buf = buf + "    } else {\n"
    buf = buf + "        if (_hx_farr32_count >= _hx_farr32_capacity) {\n"
    buf = buf + "            int64_t new_cap = _hx_farr32_capacity < 16 ? 16\n"
    buf = buf + "                              : _hx_farr32_capacity * 2;\n"
    buf = buf + "            HexaFarr32Entry* nt = (HexaFarr32Entry*)realloc(\n"
    buf = buf + "                _hx_farr32_table,\n"
    buf = buf + "                (size_t)new_cap * sizeof(HexaFarr32Entry));\n"
    buf = buf + "            if (!nt) {\n"
    buf = buf + "                fprintf(stderr, \"[farr32] OOM growing handle table\\n\");\n"
    buf = buf + "                if (buf) free(buf);\n"
    buf = buf + "                exit(77);\n"
    buf = buf + "            }\n"
    buf = buf + "            _hx_farr32_table = nt;\n"
    buf = buf + "            _hx_farr32_capacity = new_cap;\n"
    buf = buf + "        }\n"
    buf = buf + "        id = _hx_farr32_count++;\n"
    buf = buf + "    }\n"
    buf = buf + "    _hx_farr32_table[id].buf        = buf;\n"
    buf = buf + "    _hx_farr32_table[id].len        = n;\n"
    buf = buf + "    _hx_farr32_table[id].d_buf      = NULL;\n"
    buf = buf + "    _hx_farr32_table[id].loc        = FARR_HOST;\n"
    buf = buf + "    _hx_farr32_table[id].pinned     = 0;\n"
    buf = buf + "    _hx_farr32_table[id].dirty_host = 0;\n"
    buf = buf + "    _hx_farr32_table[id].dirty_dev  = 0;\n"
    buf = buf + "    return hexa_int(id);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_farr32_get(HexaVal h_v, HexaVal i_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    int64_t i  = hexa_as_num(i_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_farr32_count) return hexa_float(0.0);\n"
    buf = buf + "    HexaFarr32Entry* e = &_hx_farr32_table[id];\n"
    buf = buf + "    if (!e->buf || i < 0 || i >= e->len) return hexa_float(0.0);\n"
    buf = buf + "    /* Up-cast on read: hexa surface speaks FP64 doubles; the FP32 is\n"
    buf = buf + "     * a storage-format detail (the lossy step happened on set/fill). */\n"
    buf = buf + "    return hexa_float((double)e->buf[i]);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_farr32_set(HexaVal h_v, HexaVal i_v, HexaVal x_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    int64_t i  = hexa_as_num(i_v);\n"
    buf = buf + "    double  x  = __hx_to_double(x_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_farr32_count) return h_v;\n"
    buf = buf + "    HexaFarr32Entry* e = &_hx_farr32_table[id];\n"
    buf = buf + "    if (!e->buf || i < 0 || i >= e->len) return h_v;\n"
    buf = buf + "    /* Down-cast on write. This is the one-time narrowing step; from\n"
    buf = buf + "     * here on the value lives as FP32 in the buffer. */\n"
    buf = buf + "    e->buf[i] = (float)x;\n"
    buf = buf + "    return h_v;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_farr32_len(HexaVal h_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_farr32_count) return hexa_int(0);\n"
    buf = buf + "    return hexa_int(_hx_farr32_table[id].len);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_farr32_free(HexaVal h_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_farr32_count) return hexa_void();\n"
    buf = buf + "    HexaFarr32Entry* e = &_hx_farr32_table[id];\n"
    buf = buf + "    if (e->buf) { HXFARR_FREE(e->buf); e->buf = NULL; e->len = 0; }\n"
    buf = buf + "    e->d_buf      = NULL;\n"
    buf = buf + "    e->loc        = FARR_HOST;\n"
    buf = buf + "    e->pinned     = 0;\n"
    buf = buf + "    e->dirty_host = 0;\n"
    buf = buf + "    e->dirty_dev  = 0;\n"
    buf = buf + "    if (_hx_farr32_freelist_n >= _hx_farr32_freelist_cap) {\n"
    buf = buf + "        int64_t new_cap = _hx_farr32_freelist_cap < 16 ? 16\n"
    buf = buf + "                          : _hx_farr32_freelist_cap * 2;\n"
    buf = buf + "        int64_t* nf = (int64_t*)realloc(_hx_farr32_freelist,\n"
    buf = buf + "                       (size_t)new_cap * sizeof(int64_t));\n"
    buf = buf + "        if (nf) {\n"
    buf = buf + "            _hx_farr32_freelist = nf;\n"
    buf = buf + "            _hx_farr32_freelist_cap = new_cap;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_hx_farr32_freelist_n < _hx_farr32_freelist_cap) {\n"
    buf = buf + "        _hx_farr32_freelist[_hx_farr32_freelist_n++] = id;\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// hexa_farr32_matmul — native FP32 SGEMM. Same row-major contract +\n"
    buf = buf + "// ikj fallback shape as hexa_farr_matmul, but with float storage.\n"
    buf = buf + "//\n"
    buf = buf + "// HEXA_METAL dispatch (gap #1 closed): when both __APPLE__ and\n"
    buf = buf + "// HEXA_METAL are defined AND HEXA_METAL=1 env is set AND the shape is\n"
    buf = buf + "// large (M*K > 8192 || K*N > 8192) route to _hx_metal_farr32_matmul_gpu\n"
    buf = buf + "// — the native FP32 MPS shim (no down-cast / up-cast at the boundary).\n"
    buf = buf + "// On any GPU error → fall through to the CPU ikj SGEMM (safe).\n"
    buf = buf + "//\n"
    buf = buf + "// HEXA_CUDA: CPU SGEMM only for now (no float32 cuBLAS shim wired —\n"
    buf = buf + "// the d768 Mac path is the step-3 priority; a CUDA FP32 shim is a\n"
    buf = buf + "// separate cycle if a CUDA Mac box ever shows up, which it won't).\n"
    buf = buf + "HexaVal hexa_farr32_matmul(HexaVal a_v, HexaVal ar_v, HexaVal ac_v,\n"
    buf = buf + "                           HexaVal b_v, HexaVal bc_v) {\n"
    buf = buf + "    int64_t a_id = hexa_as_num(a_v);\n"
    buf = buf + "    int64_t M    = hexa_as_num(ar_v);\n"
    buf = buf + "    int64_t K    = hexa_as_num(ac_v);\n"
    buf = buf + "    int64_t b_id = hexa_as_num(b_v);\n"
    buf = buf + "    int64_t N    = hexa_as_num(bc_v);\n"
    buf = buf + "    if (a_id < 0 || a_id >= _hx_farr32_count) return hexa_int(-1);\n"
    buf = buf + "    if (b_id < 0 || b_id >= _hx_farr32_count) return hexa_int(-1);\n"
    buf = buf + "    if (M <= 0 || K <= 0 || N <= 0)           return hexa_int(-1);\n"
    buf = buf + "    HexaFarr32Entry* ae = &_hx_farr32_table[a_id];\n"
    buf = buf + "    HexaFarr32Entry* be = &_hx_farr32_table[b_id];\n"
    buf = buf + "    if (!ae->buf || !be->buf)                 return hexa_int(-1);\n"
    buf = buf + "    if (ae->len < M * K)                      return hexa_int(-1);\n"
    buf = buf + "    if (be->len < K * N)                      return hexa_int(-1);\n"
    buf = buf + "    HexaVal c_handle = hexa_farr32_zeros(hexa_int(M * N));\n"
    buf = buf + "    int64_t c_id = HX_INT(c_handle);\n"
    buf = buf + "    if (c_id < 0 || c_id >= _hx_farr32_count) return hexa_int(-1);\n"
    buf = buf + "    /* Re-fetch — farr32_zeros may have realloc'd the table. */\n"
    buf = buf + "    ae = &_hx_farr32_table[a_id];\n"
    buf = buf + "    be = &_hx_farr32_table[b_id];\n"
    buf = buf + "    HexaFarr32Entry* ce = &_hx_farr32_table[c_id];\n"
    buf = buf + "    if (!ae->buf || !be->buf)         return hexa_int(-1);\n"
    buf = buf + "    if (!ce->buf || ce->len < M * N)  return hexa_int(-1);\n"
    buf = buf + "    const float* A = ae->buf;\n"
    buf = buf + "    const float* B = be->buf;\n"
    buf = buf + "    float* C       = ce->buf;\n"
    buf = buf + "#if defined(__APPLE__) && defined(HEXA_METAL)\n"
    buf = buf + "    /* METAL_INTEGRATION.md step 3 of 5 (2026-05-21): native FP32 path.\n"
    buf = buf + "     * Unlike the FP64 hexa_farr_matmul's HEXA_METAL dispatch above,\n"
    buf = buf + "     * this one passes float* operands DIRECTLY to MPS — no down-cast,\n"
    buf = buf + "     * no up-cast, no precision loss. ~29 mantissa bits regained per\n"
    buf = buf + "     * element vs the N15+N18 FP64 path. The runtime_metal.m side\n"
    buf = buf + "     * (_hx_metal_farr32_matmul_gpu) bridges _hx_farr32_table directly. */\n"
    buf = buf + "    if (hxlcl_getenv(\"HEXA_METAL\") &&\n"
    buf = buf + "        hxlcl_strcmp(hxlcl_getenv(\"HEXA_METAL\"), \"1\") == 0 &&\n"
    buf = buf + "        ((M * K) > 8192 || (K * N) > 8192)) {\n"
    buf = buf + "        extern int _hx_metal_farr32_matmul_gpu(int64_t a_id, int64_t M,\n"
    buf = buf + "                                               int64_t K, int64_t b_id,\n"
    buf = buf + "                                               int64_t N, int64_t c_id);\n"
    buf = buf + "        int mrc = _hx_metal_farr32_matmul_gpu(a_id, M, K, b_id, N, c_id);\n"
    buf = buf + "        if (mrc == 0) return c_handle;\n"
    buf = buf + "        /* mrc != 0: Metal path failed — fall through to CPU ikj. */\n"
    buf = buf + "    }\n"
    buf = buf + "#endif\n"
    buf = buf + "    // ikj loop — single-precision FMAC; same cache shape as FP64 path.\n"
    buf = buf + "    for (int64_t i = 0; i < M; i++) {\n"
    buf = buf + "        const float* Ai = A + i * K;\n"
    buf = buf + "        float*       Ci = C + i * N;\n"
    buf = buf + "        for (int64_t k = 0; k < K; k++) {\n"
    buf = buf + "            float a_ik = Ai[k];\n"
    buf = buf + "            const float* Bk = B + k * N;\n"
    buf = buf + "            int64_t j = 0;\n"
    buf = buf + "            for (; j + 4 <= N; j += 4) {\n"
    buf = buf + "                Ci[j]   += a_ik * Bk[j];\n"
    buf = buf + "                Ci[j+1] += a_ik * Bk[j+1];\n"
    buf = buf + "                Ci[j+2] += a_ik * Bk[j+2];\n"
    buf = buf + "                Ci[j+3] += a_ik * Bk[j+3];\n"
    buf = buf + "            }\n"
    buf = buf + "            for (; j < N; j++) {\n"
    buf = buf + "                Ci[j] += a_ik * Bk[j];\n"
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return c_handle;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════\n"
    buf = buf + "// METAL_INTEGRATION.md step 4 of 5 (2026-05-21): native FP32 SGEMM\n"
    buf = buf + "// with B transposed on the right (matmul-NT_b).\n"
    buf = buf + "//\n"
    buf = buf + "//   C[M, N] = A[M, K] · B[N, K]^T   (B as passed is N×K row-major;\n"
    buf = buf + "//                                     conceptually B_orig is K×N\n"
    buf = buf + "//                                     row-major and B = B_orig viewed\n"
    buf = buf + "//                                     transposed — but the memory we\n"
    buf = buf + "//                                     receive is N×K contiguous)\n"
    buf = buf + "//   C[i, j] = sum_{k=0..K-1} A[i, k] * B[j, k]\n"
    buf = buf + "//\n"
    buf = buf + "// Why this is the bwd-input matmul shape for ag_linear:\n"
    buf = buf + "//   forward:  Y[M, N] = X[M, K] · W[K, N]       (W is K×N row-major)\n"
    buf = buf + "//   bwd-X:    dX[M, K] = dY[M, N] · W^T[N, K]  (W treated transposed)\n"
    buf = buf + "//   In flame's ag_linear bwd (stdlib/flame/ag_tape.hexa:630), W is\n"
    buf = buf + "//   stored as N×K row-major (i.e. already \"transposed\" relative to\n"
    buf = buf + "//   the forward), so the bwd-X matmul takes A=dY(M, N), B=W(N, K) and\n"
    buf = buf + "//   computes C[i,k] = sum_j A[i,j] * B[k,j] — that is matmul-NT_b\n"
    buf = buf + "//   with the (N,K) operand on the right + transposeRight semantics.\n"
    buf = buf + "//\n"
    buf = buf + "// HEXA_METAL dispatch:\n"
    buf = buf + "//   Large shape (M*K > 8192 || K*N > 8192 — same gate as the no-T\n"
    buf = buf + "//   variant) and HEXA_METAL=1 env routes to _hx_metal_farr32_matmul_\n"
    buf = buf + "//   NT_b_gpu which calls MPSMatrixMultiplication with transposeLeft:NO,\n"
    buf = buf + "//   transposeRight:YES. The MPS API computes A · B^T natively (no host-\n"
    buf = buf + "//   side transpose copy); B is described as N×K row-major and MPS does\n"
    buf = buf + "//   the transpose internally via its tile scheduler.\n"
    buf = buf + "//\n"
    buf = buf + "//   See Apple docs: MPSMatrixMultiplication.init(device:transposeLeft:\n"
    buf = buf + "//   transposeRight:resultRows:resultColumns:interiorColumns:alpha:beta:)\n"
    buf = buf + "//   When transposeRight=YES, the right matrix's logical dimensions are\n"
    buf = buf + "//   (interiorColumns × resultColumns) — here K (interior) × N (result)\n"
    buf = buf + "//   — but its physical (descriptor) layout is N rows × K columns row-\n"
    buf = buf + "//   major, which matches our B layout exactly.\n"
    buf = buf + "//\n"
    buf = buf + "// CPU fallback: ikj triple loop over A[i,k] * B[j,k]. Same cache shape\n"
    buf = buf + "// as the no-T variant but the B-stride access pattern is row-major (B\n"
    buf = buf + "// row j is K contiguous floats), which is the same FMA-friendly shape.\n"
    buf = buf + "HexaVal hexa_farr32_matmul_NT_b(HexaVal a_v, HexaVal ar_v, HexaVal ac_v,\n"
    buf = buf + "                                HexaVal b_v, HexaVal br_v) {\n"
    buf = buf + "    int64_t a_id = hexa_as_num(a_v);\n"
    buf = buf + "    int64_t M    = hexa_as_num(ar_v);\n"
    buf = buf + "    int64_t K    = hexa_as_num(ac_v);\n"
    buf = buf + "    int64_t b_id = hexa_as_num(b_v);\n"
    buf = buf + "    int64_t N    = hexa_as_num(br_v);\n"
    buf = buf + "    if (a_id < 0 || a_id >= _hx_farr32_count) return hexa_int(-1);\n"
    buf = buf + "    if (b_id < 0 || b_id >= _hx_farr32_count) return hexa_int(-1);\n"
    buf = buf + "    if (M <= 0 || K <= 0 || N <= 0)           return hexa_int(-1);\n"
    buf = buf + "    HexaFarr32Entry* ae = &_hx_farr32_table[a_id];\n"
    buf = buf + "    HexaFarr32Entry* be = &_hx_farr32_table[b_id];\n"
    buf = buf + "    if (!ae->buf || !be->buf)                 return hexa_int(-1);\n"
    buf = buf + "    if (ae->len < M * K)                      return hexa_int(-1);\n"
    buf = buf + "    if (be->len < N * K)                      return hexa_int(-1);\n"
    buf = buf + "    HexaVal c_handle = hexa_farr32_zeros(hexa_int(M * N));\n"
    buf = buf + "    int64_t c_id = HX_INT(c_handle);\n"
    buf = buf + "    if (c_id < 0 || c_id >= _hx_farr32_count) return hexa_int(-1);\n"
    buf = buf + "    /* Re-fetch — farr32_zeros may have realloc'd the table. */\n"
    buf = buf + "    ae = &_hx_farr32_table[a_id];\n"
    buf = buf + "    be = &_hx_farr32_table[b_id];\n"
    buf = buf + "    HexaFarr32Entry* ce = &_hx_farr32_table[c_id];\n"
    buf = buf + "    if (!ae->buf || !be->buf)         return hexa_int(-1);\n"
    buf = buf + "    if (!ce->buf || ce->len < M * N)  return hexa_int(-1);\n"
    buf = buf + "    const float* A = ae->buf;\n"
    buf = buf + "    const float* B = be->buf;\n"
    buf = buf + "    float* C       = ce->buf;\n"
    buf = buf + "#if defined(__APPLE__) && defined(HEXA_METAL)\n"
    buf = buf + "    /* METAL_INTEGRATION.md step 4 of 5: MPS native transpose-right\n"
    buf = buf + "     * dispatch. Apple MPS computes A · B^T without a host-side transpose\n"
    buf = buf + "     * copy — the descriptor describes B as N×K row-major and the\n"
    buf = buf + "     * transposeRight:YES flag tells the kernel to interpret it as a\n"
    buf = buf + "     * K×N view (i.e. swap the row/col axes on the GPU tile scheduler).\n"
    buf = buf + "     * This is the bwd-input matmul shape for ag_linear and unblocks\n"
    buf = buf + "     * matmul_bwd_auto on Mac. */\n"
    buf = buf + "    if (hxlcl_getenv(\"HEXA_METAL\") &&\n"
    buf = buf + "        hxlcl_strcmp(hxlcl_getenv(\"HEXA_METAL\"), \"1\") == 0 &&\n"
    buf = buf + "        ((M * K) > 8192 || (K * N) > 8192)) {\n"
    buf = buf + "        extern int _hx_metal_farr32_matmul_NT_b_gpu(int64_t a_id,\n"
    buf = buf + "                                                    int64_t M, int64_t K,\n"
    buf = buf + "                                                    int64_t b_id, int64_t N,\n"
    buf = buf + "                                                    int64_t c_id);\n"
    buf = buf + "        int mrc = _hx_metal_farr32_matmul_NT_b_gpu(a_id, M, K, b_id, N, c_id);\n"
    buf = buf + "        if (mrc == 0) return c_handle;\n"
    buf = buf + "        /* mrc != 0: Metal path failed — fall through to CPU ikj. */\n"
    buf = buf + "    }\n"
    buf = buf + "#endif\n"
    buf = buf + "    /* CPU SGEMM with B transposed on the right.\n"
    buf = buf + "     * Inner loop: C[i,j] += A[i,k] * B[j,k].\n"
    buf = buf + "     * B[j,k] is the k-th element of row j of B (N×K row-major). For\n"
    buf = buf + "     * each (i,j) pair, we stream A row i and B row j in lock-step —\n"
    buf = buf + "     * j-major outer with k-inner gives B contiguous-row access.\n"
    buf = buf + "     *\n"
    buf = buf + "     * Block by j to keep B row resident in L1; for typical M=K=N=64..\n"
    buf = buf + "     * 1024 sizes this gives the same cache utilization as the no-T\n"
    buf = buf + "     * ikj path. (For ag_linear-class shapes the GPU path is taken\n"
    buf = buf + "     * before this loop runs, so polish here is bonus.) */\n"
    buf = buf + "    for (int64_t i = 0; i < M; i++) {\n"
    buf = buf + "        const float* Ai = A + i * K;\n"
    buf = buf + "        float*       Ci = C + i * N;\n"
    buf = buf + "        for (int64_t j = 0; j < N; j++) {\n"
    buf = buf + "            const float* Bj = B + j * K;\n"
    buf = buf + "            float acc = 0.0f;\n"
    buf = buf + "            int64_t k = 0;\n"
    buf = buf + "            for (; k + 4 <= K; k += 4) {\n"
    buf = buf + "                acc += Ai[k]   * Bj[k];\n"
    buf = buf + "                acc += Ai[k+1] * Bj[k+1];\n"
    buf = buf + "                acc += Ai[k+2] * Bj[k+2];\n"
    buf = buf + "                acc += Ai[k+3] * Bj[k+3];\n"
    buf = buf + "            }\n"
    buf = buf + "            for (; k < K; k++) {\n"
    buf = buf + "                acc += Ai[k] * Bj[k];\n"
    buf = buf + "            }\n"
    buf = buf + "            Ci[j] = acc;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return c_handle;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════\n"
    buf = buf + "// METAL_INTEGRATION.md step 5 of 5 (2026-05-21): native FP32 SGEMM\n"
    buf = buf + "// with A transposed on the left (matmul-NT_a).\n"
    buf = buf + "//\n"
    buf = buf + "//   C[M, N] = A[K, M]^T · B[K, N]   (A as passed is K×M row-major;\n"
    buf = buf + "//                                    conceptually A_logical is M×K\n"
    buf = buf + "//                                    row-major and A^T = A_passed\n"
    buf = buf + "//                                    viewed transposed; equivalently\n"
    buf = buf + "//                                    the memory we receive is K×M\n"
    buf = buf + "//                                    contiguous with element [k, i] at\n"
    buf = buf + "//                                    a[k * M + i])\n"
    buf = buf + "//   C[i, j] = sum_{k=0..K-1} A[k, i] * B[k, j]\n"
    buf = buf + "//\n"
    buf = buf + "// Why this is the bwd-weight matmul shape for ag_linear:\n"
    buf = buf + "//   forward:  Y[M_batch, N_out] = X[M_batch, K_in] · W[K_in, N_out]\n"
    buf = buf + "//   bwd-W:    dW[K_in, N_out] = X^T[K_in, M_batch] · dY[M_batch, N_out]\n"
    buf = buf + "//   In matmul-NT_a form (A^T · B): A=X (M_batch × K_in row-major), B=dY\n"
    buf = buf + "//   (M_batch × N_out row-major). Mapping to the spec's NT_a naming:\n"
    buf = buf + "//     - spec's K (contracting/inner) = M_batch\n"
    buf = buf + "//     - spec's M (result rows)       = K_in   (= A's column count)\n"
    buf = buf + "//     - spec's N (result cols)       = N_out  (= B's column count)\n"
    buf = buf + "//   The caller passes A's true shape (K=M_batch rows, M=K_in cols) and\n"
    buf = buf + "//   B's true shape (K=M_batch rows, N=N_out cols). Both K dimensions\n"
    buf = buf + "//   must agree — they are the contracting axis.\n"
    buf = buf + "//\n"
    buf = buf + "// HEXA_METAL dispatch:\n"
    buf = buf + "//   Large shape (K*M > 8192 || K*N > 8192 — symmetric to NT_b's gate)\n"
    buf = buf + "//   and HEXA_METAL=1 env routes to _hx_metal_farr32_matmul_NT_a_gpu\n"
    buf = buf + "//   which calls MPSMatrixMultiplication with transposeLeft:YES,\n"
    buf = buf + "//   transposeRight:NO. The MPS API computes A^T · B natively (no host-\n"
    buf = buf + "//   side transpose copy); A is described as K×M row-major and the\n"
    buf = buf + "//   transposeLeft:YES flag tells the kernel to interpret it as an\n"
    buf = buf + "//   M×K view (descriptor swap on the GPU tile scheduler).\n"
    buf = buf + "//\n"
    buf = buf + "//   See Apple docs: MPSMatrixMultiplication.init(device:transposeLeft:\n"
    buf = buf + "//   transposeRight:resultRows:resultColumns:interiorColumns:alpha:beta:)\n"
    buf = buf + "//   When transposeLeft=YES, the left matrix's logical dimensions are\n"
    buf = buf + "//   (interiorColumns × resultRows) — here K (interior) × M (result rows)\n"
    buf = buf + "//   — but its physical (descriptor) layout is K rows × M columns row-\n"
    buf = buf + "//   major, which matches A's storage exactly.\n"
    buf = buf + "//\n"
    buf = buf + "// CPU fallback: ikj triple loop over A[k,i] * B[k,j]. Outer-loop k\n"
    buf = buf + "// streams A row k (M floats) and B row k (N floats) — both contiguous —\n"
    buf = buf + "// then the (i,j) inner pair updates C[i,j]. This is the same kj/ij\n"
    buf = buf + "// reduction pattern as a transposed-A SGEMM (mirrors numpy.einsum\n"
    buf = buf + "// 'mk,mn->kn'). For typical ag_linear shapes (M=batch, K=K_in≤4096,\n"
    buf = buf + "// N=N_out≤4096) the GPU path is taken before the CPU loop runs.\n"
    buf = buf + "HexaVal hexa_farr32_matmul_NT_a(HexaVal a_v, HexaVal ar_v, HexaVal ac_v,\n"
    buf = buf + "                                HexaVal b_v, HexaVal bc_v) {\n"
    buf = buf + "    int64_t a_id = hexa_as_num(a_v);\n"
    buf = buf + "    int64_t K    = hexa_as_num(ar_v);  /* spec: K = A's row count = contracting dim */\n"
    buf = buf + "    int64_t M    = hexa_as_num(ac_v);  /* spec: M = A's col count = result rows */\n"
    buf = buf + "    int64_t b_id = hexa_as_num(b_v);\n"
    buf = buf + "    int64_t N    = hexa_as_num(bc_v);  /* spec: N = B's col count = result cols */\n"
    buf = buf + "    if (a_id < 0 || a_id >= _hx_farr32_count) return hexa_int(-1);\n"
    buf = buf + "    if (b_id < 0 || b_id >= _hx_farr32_count) return hexa_int(-1);\n"
    buf = buf + "    if (M <= 0 || K <= 0 || N <= 0)           return hexa_int(-1);\n"
    buf = buf + "    HexaFarr32Entry* ae = &_hx_farr32_table[a_id];\n"
    buf = buf + "    HexaFarr32Entry* be = &_hx_farr32_table[b_id];\n"
    buf = buf + "    if (!ae->buf || !be->buf)                 return hexa_int(-1);\n"
    buf = buf + "    if (ae->len < K * M)                      return hexa_int(-1);\n"
    buf = buf + "    if (be->len < K * N)                      return hexa_int(-1);\n"
    buf = buf + "    HexaVal c_handle = hexa_farr32_zeros(hexa_int(M * N));\n"
    buf = buf + "    int64_t c_id = HX_INT(c_handle);\n"
    buf = buf + "    if (c_id < 0 || c_id >= _hx_farr32_count) return hexa_int(-1);\n"
    buf = buf + "    /* Re-fetch — farr32_zeros may have realloc'd the table. */\n"
    buf = buf + "    ae = &_hx_farr32_table[a_id];\n"
    buf = buf + "    be = &_hx_farr32_table[b_id];\n"
    buf = buf + "    HexaFarr32Entry* ce = &_hx_farr32_table[c_id];\n"
    buf = buf + "    if (!ae->buf || !be->buf)         return hexa_int(-1);\n"
    buf = buf + "    if (!ce->buf || ce->len < M * N)  return hexa_int(-1);\n"
    buf = buf + "    const float* A = ae->buf;\n"
    buf = buf + "    const float* B = be->buf;\n"
    buf = buf + "    float* C       = ce->buf;\n"
    buf = buf + "#if defined(__APPLE__) && defined(HEXA_METAL)\n"
    buf = buf + "    /* METAL_INTEGRATION.md step 5 of 5: MPS native transpose-left\n"
    buf = buf + "     * dispatch. Apple MPS computes A^T · B without a host-side transpose\n"
    buf = buf + "     * copy — the descriptor describes A as K×M row-major and the\n"
    buf = buf + "     * transposeLeft:YES flag tells the kernel to interpret it as an\n"
    buf = buf + "     * M×K view (i.e. swap the row/col axes on the GPU tile scheduler).\n"
    buf = buf + "     * This is the bwd-weight matmul shape for ag_linear and unblocks\n"
    buf = buf + "     * the dW = X^T · dY accumulator on Mac. Together with NT_b's\n"
    buf = buf + "     * dX = dY · W^T this closes the full transposed-matmul family. */\n"
    buf = buf + "    if (hxlcl_getenv(\"HEXA_METAL\") &&\n"
    buf = buf + "        hxlcl_strcmp(hxlcl_getenv(\"HEXA_METAL\"), \"1\") == 0 &&\n"
    buf = buf + "        ((K * M) > 8192 || (K * N) > 8192)) {\n"
    buf = buf + "        extern int _hx_metal_farr32_matmul_NT_a_gpu(int64_t a_id,\n"
    buf = buf + "                                                    int64_t M, int64_t K,\n"
    buf = buf + "                                                    int64_t b_id, int64_t K2,\n"
    buf = buf + "                                                    int64_t N, int64_t c_id);\n"
    buf = buf + "        int mrc = _hx_metal_farr32_matmul_NT_a_gpu(a_id, M, K, b_id, K, N, c_id);\n"
    buf = buf + "        if (mrc == 0) return c_handle;\n"
    buf = buf + "        /* mrc != 0: Metal path failed — fall through to CPU ikj. */\n"
    buf = buf + "    }\n"
    buf = buf + "#endif\n"
    buf = buf + "    /* CPU SGEMM with A transposed on the left.\n"
    buf = buf + "     * Inner formula: C[i,j] = sum_k A[k,i] * B[k,j].\n"
    buf = buf + "     * Outer loop over k streams A row k (M contiguous floats from a[k*M..])\n"
    buf = buf + "     * and B row k (N contiguous floats from b[k*N..]); the inner (i,j)\n"
    buf = buf + "     * loop accumulates into C. This kij ordering matches the bwd-weight\n"
    buf = buf + "     * shape used by ag_linear and gives B contiguous-row access. */\n"
    buf = buf + "    for (int64_t k = 0; k < K; k++) {\n"
    buf = buf + "        const float* Ak = A + k * M;  /* A's k-th row, length M (= original a[k,*]) */\n"
    buf = buf + "        const float* Bk = B + k * N;  /* B's k-th row, length N */\n"
    buf = buf + "        for (int64_t i = 0; i < M; i++) {\n"
    buf = buf + "            float aki = Ak[i];        /* = original A[k, i] */\n"
    buf = buf + "            float*  Ci = C + i * N;\n"
    buf = buf + "            int64_t j = 0;\n"
    buf = buf + "            for (; j + 4 <= N; j += 4) {\n"
    buf = buf + "                Ci[j]   += aki * Bk[j];\n"
    buf = buf + "                Ci[j+1] += aki * Bk[j+1];\n"
    buf = buf + "                Ci[j+2] += aki * Bk[j+2];\n"
    buf = buf + "                Ci[j+3] += aki * Bk[j+3];\n"
    buf = buf + "            }\n"
    buf = buf + "            for (; j < N; j++) {\n"
    buf = buf + "                Ci[j] += aki * Bk[j];\n"
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return c_handle;\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_farr_int_zeros(HexaVal n_v) {\n"
    buf = buf + "    int64_t n = hexa_as_num(n_v);\n"
    buf = buf + "    if (n < 0) n = 0;\n"
    buf = buf + "    int64_t* buf = NULL;\n"
    buf = buf + "    if (n > 0) {\n"
    buf = buf + "        buf = (int64_t*)HXFARR_CALLOC((size_t)n, sizeof(int64_t));\n"
    buf = buf + "        if (!buf) {\n"
    buf = buf + "            fprintf(stderr, \"[farr_int] OOM allocating %lld int64s\\n\", (long long)n);\n"
    buf = buf + "            exit(77);\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    int64_t id;\n"
    buf = buf + "    if (_hx_iarr_freelist_n > 0) {\n"
    buf = buf + "        id = _hx_iarr_freelist[--_hx_iarr_freelist_n];\n"
    buf = buf + "    } else {\n"
    buf = buf + "        if (_hx_iarr_count >= _hx_iarr_capacity) {\n"
    buf = buf + "            int64_t new_cap = _hx_iarr_capacity < 16 ? 16 : _hx_iarr_capacity * 2;\n"
    buf = buf + "            HexaIarrEntry* nt = (HexaIarrEntry*)realloc(_hx_iarr_table,\n"
    buf = buf + "                                  (size_t)new_cap * sizeof(HexaIarrEntry));\n"
    buf = buf + "            if (!nt) {\n"
    buf = buf + "                fprintf(stderr, \"[farr_int] OOM growing handle table\\n\");\n"
    buf = buf + "                if (buf) free(buf);\n"
    buf = buf + "                exit(77);\n"
    buf = buf + "            }\n"
    buf = buf + "            _hx_iarr_table = nt;\n"
    buf = buf + "            _hx_iarr_capacity = new_cap;\n"
    buf = buf + "        }\n"
    buf = buf + "        id = _hx_iarr_count++;\n"
    buf = buf + "    }\n"
    buf = buf + "    _hx_iarr_table[id].buf = buf;\n"
    buf = buf + "    _hx_iarr_table[id].len = n;\n"
    buf = buf + "    return hexa_int(id);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_farr_int_get(HexaVal h_v, HexaVal i_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    int64_t i  = hexa_as_num(i_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_iarr_count) return hexa_int(0);\n"
    buf = buf + "    HexaIarrEntry* e = &_hx_iarr_table[id];\n"
    buf = buf + "    if (!e->buf || i < 0 || i >= e->len) return hexa_int(0);\n"
    buf = buf + "    return hexa_int(e->buf[i]);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_farr_int_set(HexaVal h_v, HexaVal i_v, HexaVal x_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    int64_t i  = hexa_as_num(i_v);\n"
    buf = buf + "    int64_t x  = hexa_as_num(x_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_iarr_count) return h_v;\n"
    buf = buf + "    HexaIarrEntry* e = &_hx_iarr_table[id];\n"
    buf = buf + "    if (!e->buf || i < 0 || i >= e->len) return h_v;\n"
    buf = buf + "    e->buf[i] = x;\n"
    buf = buf + "    return h_v;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_farr_int_len(HexaVal h_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_iarr_count) return hexa_int(0);\n"
    buf = buf + "    return hexa_int(_hx_iarr_table[id].len);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// One-time migration helper: bulk-copy a hexa [int] (boxed HexaVal array)\n"
    buf = buf + "// into a farr_int handle. Used by cache builders to translate vendored\n"
    buf = buf + "// literal-returning fns (e.g. uccsd_lih_ham_flip_mask() -> [int]) into a\n"
    buf = buf + "// packed int64_t buffer exactly once. After this call the [int] is no\n"
    buf = buf + "// longer referenced and the arena reclaims it on next rewind.\n"
    buf = buf + "HexaVal hexa_farr_int_copy(HexaVal src_v) {\n"
    buf = buf + "    int64_t sid = hexa_as_num(src_v);\n"
    buf = buf + "    if (sid < 0 || sid >= _hx_iarr_count) return hexa_int(-1);\n"
    buf = buf + "    HexaIarrEntry* se = &_hx_iarr_table[sid];\n"
    buf = buf + "    if (!se->buf) return hexa_int(-1);\n"
    buf = buf + "    HexaVal dst_v = hexa_farr_int_zeros(hexa_int(se->len));\n"
    buf = buf + "    int64_t did = hexa_as_num(dst_v);\n"
    buf = buf + "    if (did < 0) return hexa_int(-1);\n"
    buf = buf + "    HexaIarrEntry* de = &_hx_iarr_table[did];\n"
    buf = buf + "    if (de->buf && se->len > 0) {\n"
    buf = buf + "        hxlcl_memcpy(de->buf, se->buf, (size_t)se->len * sizeof(int64_t));\n"
    buf = buf + "    }\n"
    buf = buf + "    return dst_v;\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_farr_int_sum(HexaVal h_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_iarr_count) return hexa_int(0);\n"
    buf = buf + "    HexaIarrEntry* e = &_hx_iarr_table[id];\n"
    buf = buf + "    if (!e->buf) return hexa_int(0);\n"
    buf = buf + "    int64_t s = 0;\n"
    buf = buf + "    for (int64_t k = 0; k < e->len; k++) s += e->buf[k];\n"
    buf = buf + "    return hexa_int(s);\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "HexaVal hexa_farr_int_free(HexaVal h_v) {\n"
    buf = buf + "    int64_t id = hexa_as_num(h_v);\n"
    buf = buf + "    if (id < 0 || id >= _hx_iarr_count) return hexa_void();\n"
    buf = buf + "    HexaIarrEntry* e = &_hx_iarr_table[id];\n"
    buf = buf + "    if (e->buf) { HXFARR_FREE(e->buf); e->buf = NULL; e->len = 0; }\n"
    buf = buf + "    if (_hx_iarr_freelist_n >= _hx_iarr_freelist_cap) {\n"
    buf = buf + "        int64_t new_cap = _hx_iarr_freelist_cap < 16 ? 16 : _hx_iarr_freelist_cap * 2;\n"
    buf = buf + "        int64_t* nf = (int64_t*)realloc(_hx_iarr_freelist,\n"
    buf = buf + "                       (size_t)new_cap * sizeof(int64_t));\n"
    buf = buf + "        if (nf) {\n"
    buf = buf + "            _hx_iarr_freelist = nf;\n"
    buf = buf + "            _hx_iarr_freelist_cap = new_cap;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    if (_hx_iarr_freelist_n < _hx_iarr_freelist_cap) {\n"
    buf = buf + "        _hx_iarr_freelist[_hx_iarr_freelist_n++] = id;\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// batch 14 (ING #29 r31) CARRIER-EMIT real-impl harvest: term_ffi.c TUI-PRIM\n"
    buf = buf + "// L1 subsystem (21 lowercase term_* bodies). VERBATIM ports of the frozen\n"
    buf = buf + "// runtime.c #include \"native/term_ffi.c\" amalgam (blob 151c52c8, untouched).\n"
    buf = buf + "// ISOLATED-state cluster: the file-static _term_saved/_sigwinch_flag/\n"
    buf = buf + "// _sigint_flag carriers are co-emitted FRESH seed-local (the frozen copy is\n"
    buf = buf + "// in the DROPPED TU → no collision). The 7 hxlcl_* helper callees that the\n"
    buf = buf + "// term bodies need are also emitted fresh seed-local as static helpers, in\n"
    buf = buf + "// the frozen runtime.c LIBC/stub branch (close/poll/ioctl/waitpid -> libc,\n"
    buf = buf + "// isatty/sigaction/tcgetattr/tcsetattr/forkpty -> rt_posix_ok/rt_net_fail\n"
    buf = buf + "// stubs already seeded). hxlcl_read/hxlcl_write/hxlcl_execvp stay link-deps\n"
    buf = buf + "// (seedprov, r25/r29). cfmakeraw/getppid/memcpy/memset = libc link-deps.\n"
    buf = buf + "#include <poll.h>\n"
    buf = buf + "#include <signal.h>\n"
    buf = buf + "#include <sys/ioctl.h>\n"
    buf = buf + "#include <termios.h>\n"
    buf = buf + "#include <unistd.h>\n"
    buf = buf + "#if defined(__APPLE__)\n"
    buf = buf + "#  include <util.h>\n"
    buf = buf + "#elif defined(__linux__)\n"
    buf = buf + "#  include <pty.h>\n"
    buf = buf + "#endif\n"
    buf = buf + "#include <sys/wait.h>\n"
    buf = buf + "extern long hxlcl_read(int fd, void *buf, unsigned long n);\n"
    buf = buf + "extern long hxlcl_write(int fd, const void *buf, unsigned long n);\n"
    buf = buf + "extern int hxlcl_execvp(const char *file, char *const argv[]);\n"
    buf = buf + "// ── hxlcl_* term helper callees (frozen runtime.c LIBC/stub branch) ──\n"
    buf = buf + "static int hxlcl_close_r31(int fd) { return close(fd); }\n"
    buf = buf + "static int hxlcl_ioctl_r31(int fd, unsigned long req, void *arg) { return ioctl(fd, req, arg); }\n"
    buf = buf + "static int hxlcl_poll_r31(void *fds, unsigned int nfds, int timeout) { return poll((struct pollfd *)fds, (nfds_t)nfds, timeout); }\n"
    buf = buf + "static int hxlcl_waitpid_r31(int pid, int *status, int options) { return (int)waitpid((pid_t)pid, status, options); }\n"
    buf = buf + "static int hxlcl_isatty_r31(int fd) { (void)fd; return (int)HX_INT(rt_posix_ok()); }\n"
    buf = buf + "static int hxlcl_sigaction_r31(int signum, const void *act, void *oldact) { (void)signum; (void)act; (void)oldact; return (int)HX_INT(rt_posix_ok()); }\n"
    buf = buf + "static int hxlcl_tcgetattr_r31(int fd, void *termios) {\n"
    buf = buf + "    (void)fd;\n"
    buf = buf + "    if (termios) { unsigned char *p = (unsigned char *)termios; for (size_t i = 0; i < 72; i++) p[i] = 0; }\n"
    buf = buf + "    return (int)HX_INT(rt_net_fail());\n"
    buf = buf + "}\n"
    buf = buf + "static int hxlcl_tcsetattr_r31(int fd, int optional_actions, const void *termios) { (void)fd; (void)optional_actions; (void)termios; return (int)HX_INT(rt_posix_ok()); }\n"
    buf = buf + "static int hxlcl_forkpty_r31(int *amaster, char *name, void *termp, void *winp) { (void)amaster; (void)name; (void)termp; (void)winp; return (int)HX_INT(rt_net_fail()); }\n"
    buf = buf + "// ── module state (fresh seed-local carriers) ──\n"
    buf = buf + "static struct termios _term_saved_r31;\n"
    buf = buf + "static int _term_saved_valid_r31 = 0;\n"
    buf = buf + "static volatile sig_atomic_t _sigwinch_flag_r31 = 0;\n"
    buf = buf + "static volatile sig_atomic_t _sigint_flag_r31 = 0;\n"
    buf = buf + "static void _on_sigwinch_r31(int sig) { (void)sig; _sigwinch_flag_r31 = 1; }\n"
    buf = buf + "static void _on_sigint_r31(int sig) { (void)sig; _sigint_flag_r31 = 1; }\n"
    buf = buf + "// ── raw mode lifecycle ──\n"
    buf = buf + "int term_raw_enter(void) {\n"
    buf = buf + "    if (_term_saved_valid_r31) { return 0; }\n"
    buf = buf + "    if (hxlcl_tcgetattr_r31(STDIN_FILENO, &_term_saved_r31) != 0) { return -1; }\n"
    buf = buf + "    struct termios raw;\n"
    buf = buf + "    memcpy(&raw, &_term_saved_r31, sizeof(raw));\n"
    buf = buf + "    cfmakeraw(&raw);\n"
    buf = buf + "    raw.c_lflag |= ISIG;\n"
    buf = buf + "    raw.c_cc[VMIN] = 1;\n"
    buf = buf + "    raw.c_cc[VTIME] = 0;\n"
    buf = buf + "    if (hxlcl_tcsetattr_r31(STDIN_FILENO, TCSANOW, &raw) != 0) { return -1; }\n"
    buf = buf + "    _term_saved_valid_r31 = 1;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "int term_raw_restore(void) {\n"
    buf = buf + "    if (!_term_saved_valid_r31) { return 0; }\n"
    buf = buf + "    int rc = hxlcl_tcsetattr_r31(STDIN_FILENO, TCSANOW, &_term_saved_r31);\n"
    buf = buf + "    _term_saved_valid_r31 = 0;\n"
    buf = buf + "    return (rc == 0) ? 0 : -1;\n"
    buf = buf + "}\n"
    buf = buf + "// ── window size ──\n"
    buf = buf + "int term_get_winsize(int *rows, int *cols) {\n"
    buf = buf + "    if (rows == NULL || cols == NULL) { errno = EINVAL; return -1; }\n"
    buf = buf + "    struct winsize ws;\n"
    buf = buf + "    if (hxlcl_ioctl_r31(STDOUT_FILENO, TIOCGWINSZ, &ws) != 0) { return -1; }\n"
    buf = buf + "    *rows = (int)ws.ws_row;\n"
    buf = buf + "    *cols = (int)ws.ws_col;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "// ── I/O (non-blocking) ──\n"
    buf = buf + "int term_poll_stdin(int timeout_ms) {\n"
    buf = buf + "    struct pollfd pfd;\n"
    buf = buf + "    pfd.fd = STDIN_FILENO;\n"
    buf = buf + "    pfd.events = POLLIN;\n"
    buf = buf + "    pfd.revents = 0;\n"
    buf = buf + "    int rc;\n"
    buf = buf + "    do { rc = hxlcl_poll_r31(&pfd, 1, timeout_ms); } while (rc < 0 && errno == EINTR);\n"
    buf = buf + "    if (rc < 0) return -1;\n"
    buf = buf + "    if (rc == 0) return 0;\n"
    buf = buf + "    if (pfd.revents & POLLIN) return 1;\n"
    buf = buf + "    if (pfd.revents & (POLLHUP | POLLERR | POLLNVAL)) return -2;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "int term_getppid(void) { return (int)getppid(); }\n"
    buf = buf + "int term_read_byte(void) {\n"
    buf = buf + "    unsigned char b;\n"
    buf = buf + "    ssize_t n;\n"
    buf = buf + "    do { n = hxlcl_read(STDIN_FILENO, &b, 1); } while (n < 0 && errno == EINTR);\n"
    buf = buf + "    if (n != 1) return -1;\n"
    buf = buf + "    return (int)b;\n"
    buf = buf + "}\n"
    buf = buf + "int term_read_bytes(unsigned char *buf, int max_n) {\n"
    buf = buf + "    if (buf == NULL || max_n <= 0) { errno = EINVAL; return -1; }\n"
    buf = buf + "    ssize_t n;\n"
    buf = buf + "    do { n = hxlcl_read(STDIN_FILENO, buf, (size_t)max_n); } while (n < 0 && errno == EINTR);\n"
    buf = buf + "    if (n < 0) return -1;\n"
    buf = buf + "    return (int)n;\n"
    buf = buf + "}\n"
    buf = buf + "int term_write(const char *buf, int n) {\n"
    buf = buf + "    if (buf == NULL || n < 0) { errno = EINVAL; return -1; }\n"
    buf = buf + "    int total = 0;\n"
    buf = buf + "    while (total < n) {\n"
    buf = buf + "        ssize_t w = hxlcl_write(STDOUT_FILENO, buf + total, (size_t)(n - total));\n"
    buf = buf + "        if (w < 0) { if (errno == EINTR) continue; return -1; }\n"
    buf = buf + "        total += (int)w;\n"
    buf = buf + "    }\n"
    buf = buf + "    return total;\n"
    buf = buf + "}\n"
    buf = buf + "// ── signals ──\n"
    buf = buf + "int term_install_sigwinch(void) {\n"
    buf = buf + "    struct sigaction sa;\n"
    buf = buf + "    memset(&sa, 0, sizeof(sa));\n"
    buf = buf + "    sa.sa_handler = _on_sigwinch_r31;\n"
    buf = buf + "    sa.sa_flags = SA_RESTART;\n"
    buf = buf + "    sigemptyset(&sa.sa_mask);\n"
    buf = buf + "    return (hxlcl_sigaction_r31(SIGWINCH, &sa, NULL) == 0) ? 0 : -1;\n"
    buf = buf + "}\n"
    buf = buf + "int term_sigwinch_pending(void) {\n"
    buf = buf + "    int v = _sigwinch_flag_r31;\n"
    buf = buf + "    _sigwinch_flag_r31 = 0;\n"
    buf = buf + "    return v;\n"
    buf = buf + "}\n"
    buf = buf + "int term_install_sigint(void) {\n"
    buf = buf + "    struct sigaction sa;\n"
    buf = buf + "    memset(&sa, 0, sizeof(sa));\n"
    buf = buf + "    sa.sa_handler = _on_sigint_r31;\n"
    buf = buf + "    sa.sa_flags = 0;\n"
    buf = buf + "    sigemptyset(&sa.sa_mask);\n"
    buf = buf + "    if (hxlcl_sigaction_r31(SIGINT, &sa, NULL) != 0) return -1;\n"
    buf = buf + "    if (hxlcl_sigaction_r31(SIGTERM, &sa, NULL) != 0) return -1;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "int term_sigint_pending(void) {\n"
    buf = buf + "    int v = _sigint_flag_r31;\n"
    buf = buf + "    _sigint_flag_r31 = 0;\n"
    buf = buf + "    return v;\n"
    buf = buf + "}\n"
    buf = buf + "// ── introspection ──\n"
    buf = buf + "int term_isatty_stdin(void) { return hxlcl_isatty_r31(STDIN_FILENO) ? 1 : 0; }\n"
    buf = buf + "int term_isatty_stdout(void) { return hxlcl_isatty_r31(STDOUT_FILENO) ? 1 : 0; }\n"
    buf = buf + "// ── PTY harness primitives ──\n"
    buf = buf + "int term_pty_spawn(const char *const argv[], int rows, int cols, int *out_pid) {\n"
    buf = buf + "#if defined(__APPLE__) || defined(__linux__)\n"
    buf = buf + "    if (out_pid) *out_pid = -1;\n"
    buf = buf + "    if (!argv || !argv[0]) return -1;\n"
    buf = buf + "    struct winsize ws = {0};\n"
    buf = buf + "    ws.ws_row = (unsigned short)(rows > 0 ? rows : 24);\n"
    buf = buf + "    ws.ws_col = (unsigned short)(cols > 0 ? cols : 80);\n"
    buf = buf + "    int mfd = -1;\n"
    buf = buf + "    fflush(NULL);\n"
    buf = buf + "    pid_t pid = hxlcl_forkpty_r31(&mfd, NULL, NULL, &ws);\n"
    buf = buf + "    if (pid < 0) return -1;\n"
    buf = buf + "    if (pid == 0) {\n"
    buf = buf + "        hxlcl_execvp(argv[0], (char *const *)argv);\n"
    buf = buf + "        _exit(127);\n"
    buf = buf + "    }\n"
    buf = buf + "    if (out_pid) *out_pid = (int)pid;\n"
    buf = buf + "    return mfd;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)argv; (void)rows; (void)cols; (void)out_pid;\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "int term_fd_read(int fd, unsigned char *buf, int max_bytes) {\n"
    buf = buf + "    if (fd < 0 || !buf || max_bytes <= 0) return -1;\n"
    buf = buf + "    ssize_t n = hxlcl_read(fd, buf, (size_t)max_bytes);\n"
    buf = buf + "    if (n < 0) return -1;\n"
    buf = buf + "    return (int)n;\n"
    buf = buf + "}\n"
    buf = buf + "int term_fd_write(int fd, const unsigned char *buf, int n) {\n"
    buf = buf + "    if (fd < 0 || !buf || n < 0) return -1;\n"
    buf = buf + "    ssize_t w = hxlcl_write(fd, buf, (size_t)n);\n"
    buf = buf + "    if (w < 0) return -1;\n"
    buf = buf + "    return (int)w;\n"
    buf = buf + "}\n"
    buf = buf + "int term_fd_close(int fd) { return hxlcl_close_r31(fd); }\n"
    buf = buf + "int term_fd_poll(int fd, int timeout_ms) {\n"
    buf = buf + "    if (fd < 0) return -1;\n"
    buf = buf + "    struct pollfd pfd = { .fd = fd, .events = POLLIN, .revents = 0 };\n"
    buf = buf + "    int rc = hxlcl_poll_r31(&pfd, 1, timeout_ms);\n"
    buf = buf + "    if (rc < 0) return -1;\n"
    buf = buf + "    if (rc == 0) return 0;\n"
    buf = buf + "    if (pfd.revents & (POLLIN | POLLHUP)) return 1;\n"
    buf = buf + "    return 0;\n"
    buf = buf + "}\n"
    buf = buf + "int term_pty_reap(int pid, int *out_status) {\n"
    buf = buf + "#if defined(__APPLE__) || defined(__linux__)\n"
    buf = buf + "    int st = 0;\n"
    buf = buf + "    pid_t r = hxlcl_waitpid_r31((pid_t)pid, &st, WNOHANG);\n"
    buf = buf + "    if (r < 0) return -1;\n"
    buf = buf + "    if (r == 0) return 0;\n"
    buf = buf + "    if (out_status) *out_status = st;\n"
    buf = buf + "    return 1;\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)pid; (void)out_status;\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "int term_pty_spawn_sh(const char *cmd, int rows, int cols, int *out_pid) {\n"
    buf = buf + "#if defined(__APPLE__) || defined(__linux__)\n"
    buf = buf + "    if (!cmd) return -1;\n"
    buf = buf + "    const char *argv[] = {\"/bin/sh\", \"-c\", cmd, NULL};\n"
    buf = buf + "    return term_pty_spawn(argv, rows, cols, out_pid);\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)cmd; (void)rows; (void)cols; (void)out_pid;\n"
    buf = buf + "    return -1;\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ── batch (ING #29 r32) — ptr load/store + IEEE bytes->f32 pure leaves ──\n"
    buf = buf + "//  CENSUS-FIRST carrier-reachable cluster (r31 flagged ptr/tensor/safetensors).\n"
    buf = buf + "//  7 bodies ported VERBATIM from self/native/tensor_kernels.c. ALL callees are\n"
    buf = buf + "//  supplied OUTSIDE the residual: HX_IS_INT / HX_INT / HX_INT_U / HX_TAG /\n"
    buf = buf + "//  HX_IS_ARRAY / HX_ARR_LEN / HX_ARR_ITEMS / HX_IS_FLOAT / HX_FLOAT /\n"
    buf = buf + "//  TAG_VALSTRUCT (prologue macros) + __hx_to_double / hexa_void / hexa_float /\n"
    buf = buf + "//  hexa_int / hexa_valstruct_int (supplied inline/extern) + memcpy (libc).\n"
    buf = buf + "//  ZERO new file-static carrier needed — these are PURE leaves (stack buf[],\n"
    buf = buf + "//  no malloc / no hexa_array_new / no syscall / no hxlcl_* static / no TAG_FN\n"
    buf = buf + "//  dispatch). EXCLUDED from this cluster (alloc wall): hexa_f32_to_bytes_le /\n"
    buf = buf + "//  hexa_f64_to_bytes_le / hexa_bytes_to_f64_le_v — they malloc + hexa_array_new\n"
    buf = buf + "//  (calloc/realloc WALL-2, no malloc seed) → separate lane, NOT carrier-reachable.\n"
    buf = buf + "// fwd proto (hexa_valstruct_int declared in runtime_core.c, NOT runtime.h => seed TU needs it)\n"
    buf = buf + "extern HexaVal hexa_valstruct_int(HexaVal v);\n"
    buf = buf + "HexaVal hexa_ptr_write_f32(HexaVal ptr, HexaVal offset, HexaVal val) {\n"
    buf = buf + "    int64_t p = HX_IS_INT(ptr) ? HX_INT_U(ptr) : 0;\n"
    buf = buf + "    int64_t off = HX_IS_INT(offset) ? HX_INT_U(offset) : 0;\n"
    buf = buf + "    if (p == 0) return hexa_void();\n"
    buf = buf + "    float f = (float)__hx_to_double(val);\n"
    buf = buf + "    memcpy((uint8_t*)(uintptr_t)p + off, &f, sizeof(float));\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_ptr_write_i32(HexaVal ptr, HexaVal offset, HexaVal val) {\n"
    buf = buf + "    int64_t p = HX_IS_INT(ptr) ? HX_INT_U(ptr) : 0;\n"
    buf = buf + "    int64_t off = HX_IS_INT(offset) ? HX_INT_U(offset) : 0;\n"
    buf = buf + "    if (p == 0) return hexa_void();\n"
    buf = buf + "    int32_t v = (int32_t)HX_INT(val);\n"
    buf = buf + "    memcpy((uint8_t*)(uintptr_t)p + off, &v, sizeof(int32_t));\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_ptr_read_f64(HexaVal ptr, HexaVal offset) {\n"
    buf = buf + "    int64_t p = HX_IS_INT(ptr) ? HX_INT_U(ptr) : 0;\n"
    buf = buf + "    int64_t off = HX_IS_INT(offset) ? HX_INT_U(offset) : 0;\n"
    buf = buf + "    if (p == 0) return hexa_float(0.0);\n"
    buf = buf + "    double d;\n"
    buf = buf + "    memcpy(&d, (uint8_t*)(uintptr_t)p + off, sizeof(double));\n"
    buf = buf + "    return hexa_float(d);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_ptr_read_f32(HexaVal ptr, HexaVal offset) {\n"
    buf = buf + "    int64_t p = HX_IS_INT(ptr) ? HX_INT_U(ptr) : 0;\n"
    buf = buf + "    int64_t off = HX_IS_INT(offset) ? HX_INT_U(offset) : 0;\n"
    buf = buf + "    if (p == 0) return hexa_float(0.0);\n"
    buf = buf + "    float f;\n"
    buf = buf + "    memcpy(&f, (uint8_t*)(uintptr_t)p + off, sizeof(float));\n"
    buf = buf + "    return hexa_float((double)f);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_ptr_read_i32(HexaVal ptr, HexaVal offset) {\n"
    buf = buf + "    int64_t p = HX_IS_INT(ptr) ? HX_INT_U(ptr) : 0;\n"
    buf = buf + "    int64_t off = HX_IS_INT(offset) ? HX_INT_U(offset) : 0;\n"
    buf = buf + "    if (p == 0) return hexa_int(0);\n"
    buf = buf + "    int32_t v;\n"
    buf = buf + "    memcpy(&v, (uint8_t*)(uintptr_t)p + off, sizeof(int32_t));\n"
    buf = buf + "    return hexa_int((int64_t)v);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_bytes_to_f32_le(HexaVal arr, HexaVal offset) {\n"
    buf = buf + "    int64_t off = HX_IS_INT(offset) ? HX_INT(offset) : 0;\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_float(0.0);\n"
    buf = buf + "    int len = HX_ARR_LEN(arr);\n"
    buf = buf + "    if (off < 0 || off + 4 > len) return hexa_float(0.0);\n"
    buf = buf + "    HexaVal* items = HX_ARR_ITEMS(arr);\n"
    buf = buf + "    uint8_t buf[4];\n"
    buf = buf + "    for (int i = 0; i < 4; i++) {\n"
    buf = buf + "        HexaVal el = items[off + i];\n"
    buf = buf + "        int64_t v = 0;\n"
    buf = buf + "        if (HX_IS_INT(el)) v = HX_INT(el);\n"
    buf = buf + "        else if (HX_IS_FLOAT(el)) v = (int64_t)HX_FLOAT(el);\n"
    buf = buf + "        buf[i] = (uint8_t)(v & 0xFF);\n"
    buf = buf + "    }\n"
    buf = buf + "    float f;\n"
    buf = buf + "    memcpy(&f, buf, 4);\n"
    buf = buf + "    return hexa_float((double)f);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_bytes_to_f32_le_v(HexaVal arr, HexaVal offset) {\n"
    buf = buf + "    int64_t off = HX_IS_INT(offset) ? HX_INT(offset) : 0;\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_float(0.0);\n"
    buf = buf + "    int len = HX_ARR_LEN(arr);\n"
    buf = buf + "    if (off < 0 || off + 4 > len) return hexa_float(0.0);\n"
    buf = buf + "    HexaVal* items = HX_ARR_ITEMS(arr);\n"
    buf = buf + "    uint8_t buf[4];\n"
    buf = buf + "    for (int i = 0; i < 4; i++) {\n"
    buf = buf + "        HexaVal el = items[off + i];\n"
    buf = buf + "        int64_t v = 0;\n"
    buf = buf + "        if (HX_IS_INT(el)) v = HX_INT(el);\n"
    buf = buf + "        else if (HX_IS_FLOAT(el)) v = (int64_t)HX_FLOAT(el);\n"
    buf = buf + "        else if (HX_TAG(el) == TAG_VALSTRUCT) {\n"
    buf = buf + "            HexaVal iv = hexa_valstruct_int(el);\n"
    buf = buf + "            if (HX_IS_INT(iv)) v = HX_INT(iv);\n"
    buf = buf + "            else if (HX_IS_FLOAT(iv)) v = (int64_t)HX_FLOAT(iv);\n"
    buf = buf + "        }\n"
    buf = buf + "        buf[i] = (uint8_t)(v & 0xFF);\n"
    buf = buf + "    }\n"
    buf = buf + "    float f;\n"
    buf = buf + "    memcpy(&f, buf, 4);\n"
    buf = buf + "    return hexa_float((double)f);\n"
    buf = buf + "}\n"

    // ── batch (ING #29 r33) — term FD/IO wrappers + thin rt_str delegates ──
    //  CENSUS-FIRST carrier-reachable cluster. The remaining-pool census (r33)
    //  classified the 289 residual into 3 buckets; this batch harvests the
    //  CARRIER-REACHABLE-NOW subset whose every callee is supplied OUTSIDE the
    //  residual. Two clean sub-clusters:
    //   (A) term FD/IO wrappers (8) — VERBATIM from frozen runtime.c. Their only
    //       callees are the term_* C FFI prims (term_get_winsize / term_poll_stdin
    //       / term_write / term_fd_read / term_fd_write / term_fd_close /
    //       term_fd_poll), which are DEFINED by native/term_ffi.c and SUPPLIED by
    //       the term native seed (nm prov=Y, NOT in the residual), + __hx_to_double
    //       (prologue static-inline) + hxlcl_strlen / hxlcl_memcpy (zeroc hxlcl
    //       delegate seed, prov=Y) + HX_IS_STR / HX_STR / hexa_int / hexa_str
    //       (prologue macros / inline). NO malloc / hexa_array_new / hxlcl_syscall
    //       / _hx_farr_table / file-static carrier — PURE wrappers over provided
    //       externs (stack buf[] only). The term_* externs resolve at the FINAL
    //       link, exactly like the r32 ptr/bytes leaves resolved memcpy from libc.
    //   (B) thin rt_str delegates (2) — under HEXA_HAS_HEXA_RT_STDLIB (the seed-TU
    //       compile flag) hexa_str_slice / hexa_str_parse_int take their #else
    //       branch = a 2-line HX_IS_STR guard + tail-call to rt_str_slice /
    //       rt_str_parse_int (ctype.hexa native seed, prov=Y). The #ifndef branch
    //       (strndup / hxlcl_strtoll path) is NOT compiled here, so no alloc wall.
    //  fwd protos: the term_* prims have NO extern decl in runtime.c (it sees them
    //  via the #include "native/term_ffi.c"); the seed TU does not include that
    //  fragment, so it needs explicit extern protos here. rt_str_* likewise.
    buf = buf + "// ── batch (ING #29 r33) — term FD/IO wrappers + thin rt_str delegates ──\n"
    buf = buf + "//  carrier-reachable-now: every callee supplied OUTSIDE the 289 residual\n"
    buf = buf + "//  (term_* native seed · hxlcl delegate seed · rt_str ctype seed · prologue).\n"
    buf = buf + "// fwd protos for term_* C-FFI prims (defined in native/term_ffi.c, supplied\n"
    buf = buf + "// by the term native seed; the seed TU does not #include that fragment) +\n"
    buf = buf + "// rt_str_* (ctype.hexa native seed).\n"
    buf = buf + "extern int term_get_winsize(int *rows, int *cols);\n"
    buf = buf + "extern int term_poll_stdin(int timeout_ms);\n"
    buf = buf + "extern int term_write(const char *buf, int n);\n"
    buf = buf + "extern int term_fd_read(int fd, unsigned char *buf, int max_bytes);\n"
    buf = buf + "extern int term_fd_write(int fd, const unsigned char *buf, int n);\n"
    buf = buf + "extern int term_fd_close(int fd);\n"
    buf = buf + "extern int term_fd_poll(int fd, int timeout_ms);\n"
    buf = buf + "extern HexaVal rt_str_slice(HexaVal s, HexaVal start, HexaVal end);\n"
    buf = buf + "extern HexaVal rt_str_parse_int(HexaVal s);\n"
    buf = buf + "HexaVal hexa_term_winsize_rows(void) {\n"
    buf = buf + "    int r = -1, c = -1;\n"
    buf = buf + "    if (term_get_winsize(&r, &c) != 0) return hexa_int(-1);\n"
    buf = buf + "    return hexa_int((int64_t)r);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_term_winsize_cols(void) {\n"
    buf = buf + "    int r = -1, c = -1;\n"
    buf = buf + "    if (term_get_winsize(&r, &c) != 0) return hexa_int(-1);\n"
    buf = buf + "    return hexa_int((int64_t)c);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_term_poll_stdin(HexaVal ms) {\n"
    buf = buf + "    int t = (int)__hx_to_double(ms);\n"
    buf = buf + "    return hexa_int((int64_t)term_poll_stdin(t));\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_term_write_str(HexaVal s) {\n"
    buf = buf + "    if (!HX_IS_STR(s) || HX_STR(s) == NULL) {\n"
    buf = buf + "        return hexa_int(-1);\n"
    buf = buf + "    }\n"
    buf = buf + "    const char *buf = HX_STR(s);\n"
    buf = buf + "    int n = (int)hxlcl_strlen(buf);\n"
    buf = buf + "    return hexa_int((int64_t)term_write(buf, n));\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_term_fd_read(HexaVal fd, HexaVal max_bytes) {\n"
    buf = buf + "    int f = (int)__hx_to_double(fd);\n"
    buf = buf + "    int m = (int)__hx_to_double(max_bytes);\n"
    buf = buf + "    if (m <= 0 || m > 65536) m = 4096;\n"
    buf = buf + "    unsigned char buf[65536];\n"
    buf = buf + "    if (m > 65536) m = 65536;\n"
    buf = buf + "    int n = term_fd_read(f, buf, m);\n"
    buf = buf + "    if (n <= 0) return hexa_str(\"\");\n"
    buf = buf + "    char tmp[65537];\n"
    buf = buf + "    hxlcl_memcpy(tmp, buf, (size_t)n);\n"
    buf = buf + "    tmp[n] = '\\0';\n"
    buf = buf + "    return hexa_str(tmp);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_term_fd_write(HexaVal fd, HexaVal data) {\n"
    buf = buf + "    int f = (int)__hx_to_double(fd);\n"
    buf = buf + "    if (!HX_IS_STR(data) || HX_STR(data) == NULL) return hexa_int(-1);\n"
    buf = buf + "    const char *s = HX_STR(data);\n"
    buf = buf + "    int n = (int)hxlcl_strlen(s);\n"
    buf = buf + "    int w = term_fd_write(f, (const unsigned char *)s, n);\n"
    buf = buf + "    return hexa_int((int64_t)w);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_term_fd_close(HexaVal fd) {\n"
    buf = buf + "    int f = (int)__hx_to_double(fd);\n"
    buf = buf + "    return hexa_int((int64_t)term_fd_close(f));\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_term_fd_poll(HexaVal fd, HexaVal timeout_ms) {\n"
    buf = buf + "    int f = (int)__hx_to_double(fd);\n"
    buf = buf + "    int t = (int)__hx_to_double(timeout_ms);\n"
    buf = buf + "    return hexa_int((int64_t)term_fd_poll(f, t));\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_str_slice(HexaVal s, HexaVal start, HexaVal end) {\n"
    buf = buf + "    if (!HX_IS_STR(s)) return hexa_str(\"\");\n"
    buf = buf + "    return rt_str_slice(s, start, end);\n"
    buf = buf + "}\n"
    buf = buf + "HexaVal hexa_str_parse_int(HexaVal s) {\n"
    buf = buf + "    if (!HX_IS_STR(s)) return hexa_int(0);\n"
    buf = buf + "    return rt_str_parse_int(s);\n"
    buf = buf + "}\n"

    if buf.len() > 0 { _flush_runtime_hi(out_path, buf) }
}

fn main() {
    let argv = real_args()
    let out_path = if argv.len() >= 1 { argv[0] } else { "runtime_hi_seed.c" }
    emit_runtime_hi_seed_to(out_path)
    let exists_check = exec("[ -f \"" + out_path + "\" ] && echo y || echo n").trim()
    if exists_check != "y" {
        println("[runtime_emit] FATAL: failed to write " + out_path)
        exit(1)
    }
    println("[runtime_emit] wrote " + out_path)
    exit(0)
}
