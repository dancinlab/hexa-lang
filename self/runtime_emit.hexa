    buf = buf + "// hexa_timestamp (frozen runtime.c L12023 — pinned_epoch + clock_gettime)\n"
    buf = buf + "HexaVal hexa_timestamp(void) {\n"
    buf = buf + "    int64_t pin = hexa_pinned_epoch();\n"
