    buf = buf + "extern HexaVal hexa_str_own(char* s);\n"
    buf = buf + "// hexa_argmax\n"
    buf = buf + "HexaVal hexa_argmax(HexaVal a) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(a)) return hexa_int(-1);\n"
    buf = buf + "    int64_t n = (int64_t)HX_ARR_LEN(a);\n"
