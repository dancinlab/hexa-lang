    buf = buf + "//  so the seed-local tick stays in its disabled-default no-op state). NO body\n"
    buf = buf + "//  here SHARES mutable state with code that remains in the frozen runtime.\n"
    buf = buf + "//  base64 carrier: _b64_enc is a static const lookup table (pure constant) and\n"
