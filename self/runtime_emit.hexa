    buf = buf + "}\n"
    buf = buf + "// hexa_chr_byte (frozen runtime.c L6054 — strbuf string-builder family)\n"
    buf = buf + "HexaVal hexa_chr_byte(HexaVal n) {\n"
    buf = buf + "    int64_t code = HX_IS_INT(n) ? HX_INT(n) : (int64_t)HX_FLOAT(n);\n"
    buf = buf + "    char* s = hexa_strbuf_alloc_r27(1);\n"
