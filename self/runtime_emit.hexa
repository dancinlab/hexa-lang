    buf = buf + "// hexa_sleep_ns (frozen runtime.c L12238 — hxlcl_nanosleep delegate, EINTR-resume)\n"
    buf = buf + "HexaVal hexa_sleep_ns(HexaVal ns) {\n"
    buf = buf + "    int64_t n = HX_IS_INT(ns) ? HX_INT(ns)\n"
    buf = buf + "              : HX_IS_FLOAT(ns) ? (int64_t)HX_FLOAT(ns)\n"
    buf = buf + "              : (int64_t)hexa_as_num(ns);\n"
    buf = buf + "    if (n <= 0) return hexa_void();\n"
    buf = buf + "    struct timespec req;\n"
    buf = buf + "    req.tv_sec  = (time_t)(n / 1000000000LL);\n"
    buf = buf + "    req.tv_nsec = (long)(n % 1000000000LL);\n"
    buf = buf + "    struct timespec rem;\n"
    buf = buf + "    while (hxlcl_nanosleep(&req, &rem) != 0 && errno == EINTR) req = rem;\n"
    buf = buf + "    return hexa_void();\n"
