    buf = buf + "    hxlcl_clock_gettime(CLOCK_REALTIME, &ts);\n"
    buf = buf + "    return hexa_int((int64_t)ts.tv_sec);\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_time_ms (frozen runtime.c L12035 — pinned_epoch + clock_gettime)\n"
    buf = buf + "HexaVal hexa_time_ms(void) {\n"
    buf = buf + "    int64_t pin = hexa_pinned_epoch();\n"
    buf = buf + "    if (pin >= 0) return hexa_int(pin * 1000);\n"
    buf = buf + "    struct timespec ts;\n"
