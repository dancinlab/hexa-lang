    buf = buf + "\n"
    buf = buf + "// ── batch 6 (str/coerce/poly leaves, ING #35 r19) ────────────\n"
    buf = buf + "// UNLOCKED by the r18 alloc-WALL-2 verdict (PORTABLE-LINK-DEP). 10 more\n"
