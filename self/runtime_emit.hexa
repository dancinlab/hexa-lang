    buf = buf + "    char* buf = (char*)malloc(cap);\n"
    buf = buf + "    if (!buf) return hexa_str(\"\");\n"
    buf = buf + "    for (;;) {\n"
    buf = buf + "        unsigned char b;\n"
    buf = buf + "        long n = hxlcl_read(0, &b, 1);\n"
    buf = buf + "        if (n < 0) { if (errno == EINTR) continue; break; }\n"
    buf = buf + "        if (n == 0) break;\n"
    buf = buf + "        if (b == '\\n') break;\n"
    buf = buf + "        if (len + 1 >= cap) {\n"
    buf = buf + "            cap *= 2;\n"
    buf = buf + "            char* nb = (char*)realloc(buf, cap);\n"
    buf = buf + "            if (!nb) { free(buf); return hexa_str(\"\"); }\n"
    buf = buf + "            buf = nb;\n"
    buf = buf + "        }\n"
    buf = buf + "        buf[len++] = (char)b;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (len > 0 && buf[len-1] == '\\r') len--;\n"
    buf = buf + "    buf[len] = 0;\n"
