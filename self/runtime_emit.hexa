    buf = buf + "    for (int64_t r = 0; r < rows; r++) {\n"
    buf = buf + "        double acc = 0.0;\n"
    buf = buf + "        for (int64_t c = 0; c < cols; c++) {\n"
    buf = buf + "            HexaVal wv = hexa_index_get(w, hexa_int(r * cols + c));\n"
    buf = buf + "            HexaVal xv = hexa_index_get(x, hexa_int(c));\n"
    buf = buf + "            acc += HX_FLOAT(wv) * HX_FLOAT(xv);\n"
    buf = buf + "        }\n"
    buf = buf + "        out = hexa_array_push(out, hexa_float(acc));\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_tempdir (frozen runtime.c)\n"
    buf = buf + "HexaVal hexa_tempdir(void) {\n"
    buf = buf + "    char tmpl[] = \"/tmp/hexa_dir_XXXXXX\";\n"
