    buf = buf + "// hexa_base64_decode (frozen runtime.c L13110 — VERBATIM, fn-local static dec)\n"
    buf = buf + "HexaVal hexa_base64_decode(HexaVal s) {\n"
    buf = buf + "    if (!HX_IS_STR(s) || !HX_STR(s)) return hexa_str(\"\");\n"
    buf = buf + "    static int dec[256];\n"
