    buf = buf + "//  runtime.c stays the SSOT (byte-identical OFF). net DROP_RESIDUAL: -4.\n"
    buf = buf + "extern void* malloc(unsigned long);\n"
    buf = buf + "// ── carrier: strbuf header + magic + static-inline allocator (frozen) ─\n"
    buf = buf + "#ifndef HEXA_STR_MAGIC\n"
    buf = buf + "#define HEXA_STR_MAGIC ((uint64_t)0xC0DECAFE0F58A7E1ULL)\n"
    buf = buf + "#endif\n"
    buf = buf + "typedef struct {\n"
    buf = buf + "    uint64_t magic;\n"
    buf = buf + "    size_t   len;\n"
    buf = buf + "    char     data[];   // C99 flexible array — actual bytes follow\n"
    buf = buf + "} HexaStrHdr_r27;\n"
    buf = buf + "// _hx_mem_tick diagnostic counter (frozen runtime_core.c L272 — file-static,\n"
    buf = buf + "// disabled by default per the 2026-05-16 opt-in cap model; seed-local copy).\n"
    buf = buf + "static volatile uint64_t _hx_r27_mem_tick_ctr = 0;\n"
    buf = buf + "static int               _hx_r27_mem_cap_disabled = 1;  // NO cap by default\n"
    buf = buf + "static inline void _hx_r27_mem_tick(void) {\n"
    buf = buf + "    if (_hx_r27_mem_cap_disabled) return;\n"
    buf = buf + "    if ((++_hx_r27_mem_tick_ctr & 0x0FFFu) != 0) return;\n"
    buf = buf + "    // opt-in RSS cap lives in the dropped runtime_core.c; no-op under drop.\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_strbuf_alloc (frozen runtime_core.c L689 — static inline, seed-local).\n"
    buf = buf + "static inline char* hexa_strbuf_alloc_r27(size_t len) {\n"
