    buf = buf + "// hexa_str_slice=hxlcl_strndup, hexa_str_parse_int=hxlcl_strtoll). The clean\n"
    buf = buf + "// non-strbuf leaves above are emittable; total emitter bodies 88 -> 98.\n"
    buf = buf + "// hexa_str_substr (frozen runtime.c — active #ifndef branch)\n"
    buf = buf + "HexaVal hexa_str_substr(HexaVal s, HexaVal start_v, HexaVal len_v) {\n"
    buf = buf + "    if (!HX_IS_STR(s)) return hexa_str(\"\");\n"
    buf = buf + "    int64_t slen = (int64_t)HX_STRLEN(s);\n"
    buf = buf + "    int64_t start = HX_IS_INT(start_v) ? HX_INT(start_v) : (int64_t)__hx_to_double(start_v);\n"
    buf = buf + "    if (start < 0) start = 0;\n"
    buf = buf + "    if (start > slen) start = slen;\n"
    buf = buf + "    int64_t count;\n"
    buf = buf + "    if (HX_TAG(len_v) == TAG_VOID) {\n"
    buf = buf + "        count = slen - start;\n"
    buf = buf + "    } else {\n"
    buf = buf + "        count = HX_IS_INT(len_v) ? HX_INT(len_v) : (int64_t)__hx_to_double(len_v);\n"
    buf = buf + "    }\n"
