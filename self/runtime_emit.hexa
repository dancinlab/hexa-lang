    buf = buf + "    return rt_array_alloc(hexa_int(n));\n"
    buf = buf + "}\n"
    buf = buf + "// ── batch 12 (ING #35 r27) — CARRIER-EMIT harvest: strbuf + base64 ──\n"
    buf = buf + "//  RFC061 r27 applies the r26 carrier-emit mechanism (proven: a file-static\n"
    buf = buf + "//  DATA carrier emitted FRESH co-located in the seed TU collides with nothing\n"
    buf = buf + "//  — the frozen runtime_core.c / runtime.c copy is in the DROPPED/uncompiled\n"
    buf = buf + "//  TU and a file-static exports no link symbol) to the TWO carriers the r19\n"
    buf = buf + "//  census mislabeled 'GENUINE file-static wall': the strbuf string-builder\n"
    buf = buf + "//  carrier (HexaStrHdr + HEXA_STR_MAGIC + static-inline hexa_strbuf_alloc +\n"
