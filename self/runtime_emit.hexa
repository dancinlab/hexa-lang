    buf = buf + "\n"
    buf = buf + "// -- array-family transform leaves (frozen runtime.c PROPER) -- ING #35 r18 --\n"
    buf = buf + "// Batch 5: 47 hexa_array_* / range / poly bodies, the #else (HEXA_HAS_HEXA_\n"
