    buf = buf + "}\n"
    buf = buf + "// hexa_sleep_ms (frozen runtime.c L12223 — hxlcl_nanosleep delegate, EINTR-resume)\n"
    buf = buf + "HexaVal hexa_sleep_ms(HexaVal ms) {\n"
    buf = buf + "    int64_t m = HX_IS_INT(ms) ? HX_INT(ms)\n"
    buf = buf + "              : HX_IS_FLOAT(ms) ? (int64_t)HX_FLOAT(ms)\n"
