    buf = buf + "    return hexa_bool((HX_IS_STR(a) && HX_STR(a) && hxlcl_isalnum((unsigned char)HX_STR(a)[0]))\n"
    buf = buf + "                  || (HX_TAG(a) == TAG_CHAR && hxlcl_isalnum((unsigned char)HX_INT(a))));\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_json_decode (frozen runtime.c — VERBATIM bare-wrapper, exported)\n"
    buf = buf + "HexaVal hexa_json_decode(HexaVal s) { return hexa_json_parse(s); }\n"
    buf = buf + "// hexa_json_encode (frozen runtime.c — VERBATIM bare-wrapper, exported)\n"
