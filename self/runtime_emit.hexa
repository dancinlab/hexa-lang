    buf = buf + "    for (;;) {\n"
    buf = buf + "        if (cap - len < 4097) {\n"
    buf = buf + "            cap *= 2;\n"
    buf = buf + "            char* nb = (char*)realloc(buf, cap);\n"
    buf = buf + "            if (!nb) { free(buf); return hexa_str(\"\"); }\n"
    buf = buf + "            buf = nb;\n"
    buf = buf + "        }\n"
    buf = buf + "        long n = hxlcl_read(0, buf + len, 4096);\n"
    buf = buf + "        if (n < 0) { if (errno == EINTR) continue; break; }\n"
