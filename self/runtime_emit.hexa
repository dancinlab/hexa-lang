    buf = buf + "}\n"
    buf = buf + "// hexa_matvec (frozen runtime.c — #ifndef HEXA_HAS_HEXA_RT_STDLIB active branch)\n"
    buf = buf + "HexaVal hexa_matvec(HexaVal w, HexaVal x, HexaVal rows_v, HexaVal cols_v) {\n"
    buf = buf + "    int64_t rows = HX_IS_INT(rows_v) ? HX_INT(rows_v) : 0;\n"
    buf = buf + "    int64_t cols = HX_IS_INT(cols_v) ? HX_INT(cols_v) : 0;\n"
