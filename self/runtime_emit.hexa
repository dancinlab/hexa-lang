    buf = buf + "    return farr_matmul_gpu_impl(a, ar, ac, b, bc);\n"
    buf = buf + "}\n"
    buf = buf + "// farr_packed_gemv_offset (frozen runtime.c — VERBATIM bare-wrapper, exported)\n"
    buf = buf + "HexaVal farr_packed_gemv_offset(HexaVal p, HexaVal off, HexaVal rows,\n"
