    buf = buf + "    int64_t ms = (int64_t)ts.tv_sec * 1000\n"
    buf = buf + "               + (int64_t)(ts.tv_nsec / 1000000);\n"
    buf = buf + "    return hexa_int(ms);\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_now_monotonic_s (frozen runtime.c L12254 — pinned_epoch + clock_gettime)\n"
    buf = buf + "HexaVal hexa_now_monotonic_s(void) {\n"
    buf = buf + "    int64_t pin = hexa_pinned_epoch();\n"
    buf = buf + "    if (pin >= 0) return hexa_float((double)pin);\n"
    buf = buf + "    struct timespec ts;\n"
    buf = buf + "    hxlcl_clock_gettime(CLOCK_MONOTONIC, &ts);\n"
    buf = buf + "    return hexa_float((double)ts.tv_sec + (double)ts.tv_nsec / 1e9);\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_sleep (frozen runtime.c L5810 — hxlcl_nanosleep delegate)\n"
    buf = buf + "HexaVal hexa_sleep(HexaVal sec) {\n"
    buf = buf + "    double s = HX_IS_FLOAT(sec) ? HX_FLOAT(sec)\n"
    buf = buf + "             : HX_IS_INT(sec)   ? (double)HX_INT(sec)\n"
    buf = buf + "             : 0.0;\n"
    buf = buf + "    if (s <= 0.0) return hexa_void();\n"
    buf = buf + "    struct timespec ts;\n"
    buf = buf + "    ts.tv_sec  = (time_t)s;\n"
    buf = buf + "    ts.tv_nsec = (long)((s - (double)ts.tv_sec) * 1e9);\n"
    buf = buf + "    hxlcl_nanosleep(&ts, NULL);\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_sleep_s (frozen runtime.c L12205 — hxlcl_nanosleep delegate)\n"
    buf = buf + "HexaVal hexa_sleep_s(HexaVal n) {\n"
    buf = buf + "    double s = 0.0;\n"
    buf = buf + "    if (HX_IS_INT(n))        s = (double)HX_INT(n);\n"
    buf = buf + "    else if (HX_IS_FLOAT(n)) s = HX_FLOAT(n);\n"
    buf = buf + "    else                     s = (double)hexa_as_num(n);\n"
    buf = buf + "    if (s < 0) s = 0;\n"
    buf = buf + "    struct timespec ts;\n"
    buf = buf + "    ts.tv_sec  = (time_t)s;\n"
    buf = buf + "    ts.tv_nsec = (long)((s - (double)ts.tv_sec) * 1e9);\n"
    buf = buf + "    hxlcl_nanosleep(&ts, NULL);\n"
