    buf = buf + "// ── carrier: _b64_enc base64 alphabet (frozen runtime.c L13078) ─────\n"
    buf = buf + "static const char _b64_enc_r27[] =\n"
    buf = buf + "    \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/\";\n"
    buf = buf + "// hexa_base64_encode (frozen runtime.c L13081 — VERBATIM)\n"
    buf = buf + "HexaVal hexa_base64_encode(HexaVal s) {\n"
    buf = buf + "    if (!HX_IS_STR(s) || !HX_STR(s)) return hexa_str(\"\");\n"
    buf = buf + "    const unsigned char* in = (const unsigned char*)HX_STR(s);\n"
    buf = buf + "    size_t n = HX_STRLEN(s);\n"
    buf = buf + "    size_t olen = 4 * ((n + 2) / 3);\n"
    buf = buf + "    char* out = (char*)malloc(olen + 1);\n"
    buf = buf + "    size_t i = 0, j = 0;\n"
    buf = buf + "    while (i + 3 <= n) {\n"
    buf = buf + "        uint32_t t = (in[i] << 16) | (in[i+1] << 8) | in[i+2];\n"
    buf = buf + "        out[j++] = _b64_enc_r27[(t >> 18) & 0x3F];\n"
    buf = buf + "        out[j++] = _b64_enc_r27[(t >> 12) & 0x3F];\n"
    buf = buf + "        out[j++] = _b64_enc_r27[(t >> 6) & 0x3F];\n"
    buf = buf + "        out[j++] = _b64_enc_r27[t & 0x3F];\n"
    buf = buf + "        i += 3;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (i < n) {\n"
    buf = buf + "        uint32_t t = in[i] << 16;\n"
    buf = buf + "        int rem = (int)(n - i);\n"
    buf = buf + "        if (rem == 2) t |= in[i+1] << 8;\n"
    buf = buf + "        out[j++] = _b64_enc_r27[(t >> 18) & 0x3F];\n"
    buf = buf + "        out[j++] = _b64_enc_r27[(t >> 12) & 0x3F];\n"
    buf = buf + "        out[j++] = (rem == 2) ? _b64_enc_r27[(t >> 6) & 0x3F] : '=';\n"
    buf = buf + "        out[j++] = '=';\n"
    buf = buf + "    }\n"
    buf = buf + "    out[j] = 0;\n"
