    buf = buf + "// hexa_array_free\n"
    buf = buf + "HexaVal hexa_array_free(HexaVal arr) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_void();\n"
    buf = buf + "    HexaArr* p = arr.arr_ptr;\n"
    buf = buf + "    if (!p) return hexa_void();\n"
    buf = buf + "    // Only free heap-backed buffers (cap>0). Arena-backed (cap<0) belong\n"
    buf = buf + "    // to the arena slab and must not be passed to free().\n"
    buf = buf + "    if (p->items && p->cap > 0) {\n"
    buf = buf + "        free(p->items);\n"
    buf = buf + "    }\n"
    buf = buf + "    p->items = NULL;\n"
    buf = buf + "    p->len = 0;\n"
    buf = buf + "    p->cap = 0;\n"
    buf = buf + "    free(p);\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_array_frequencies\n"
    buf = buf + "HexaVal hexa_array_frequencies(HexaVal arr) {\n"
    buf = buf + "    HexaVal out = hexa_map_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    for (int i = 0; i < HX_ARR_LEN(arr); i++) {\n"
    buf = buf + "        const char* k = hexa_str_as_ptr(hexa_to_string(HX_ARR_ITEMS(arr)[i]));\n"
    buf = buf + "        if (!k) continue;\n"
    buf = buf + "        int64_t cur = 0;\n"
    buf = buf + "        if (hexa_map_contains_key(out, k)) {\n"
    buf = buf + "            HexaVal v = hexa_map_get(out, k);\n"
    buf = buf + "            cur = HX_IS_INT(v) ? HX_INT(v) : (int64_t)__hx_to_double(v);\n"
    buf = buf + "        }\n"
    buf = buf + "        out = hexa_map_set(out, k, hexa_int(cur + 1));\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_array_group_by\n"
    buf = buf + "HexaVal hexa_array_group_by(HexaVal arr, HexaVal fn) {\n"
    buf = buf + "    HexaVal out = hexa_map_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    for (int i = 0; i < HX_ARR_LEN(arr); i++) {\n"
    buf = buf + "        HexaVal item = HX_ARR_ITEMS(arr)[i];\n"
    buf = buf + "        HexaVal key = hexa_call1(fn, item);\n"
    buf = buf + "        const char* k_str = hexa_str_as_ptr(hexa_to_string(key));\n"
    buf = buf + "        if (!k_str) continue;\n"
    buf = buf + "        HexaVal bucket;\n"
    buf = buf + "        if (hexa_map_contains_key(out, k_str)) {\n"
    buf = buf + "            bucket = hexa_map_get(out, k_str);\n"
    buf = buf + "        } else {\n"
    buf = buf + "            bucket = hexa_array_new();\n"
    buf = buf + "        }\n"
    buf = buf + "        bucket = hexa_array_push(bucket, item);\n"
    buf = buf + "        out = hexa_map_set(out, k_str, bucket);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_array_index_of\n"
    buf = buf + "HexaVal hexa_array_index_of(HexaVal arr, HexaVal item) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_int(-1);\n"
    buf = buf + "    for (int i = 0; i < HX_ARR_LEN(arr); i++) {\n"
    buf = buf + "        if (hexa_truthy(hexa_eq(HX_ARR_ITEMS(arr)[i], item))) return hexa_int(i);\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int(-1);\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_array_interleave\n"
    buf = buf + "HexaVal hexa_array_interleave(HexaVal a, HexaVal b) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(a)) {\n"
    buf = buf + "        return HX_IS_ARRAY(b) ? b : out;\n"
    buf = buf + "    }\n"
    buf = buf + "    if (!HX_IS_ARRAY(b)) return a;\n"
    buf = buf + "    int64_t na = HX_ARR_LEN(a), nb = HX_ARR_LEN(b);\n"
    buf = buf + "    int64_t m = na > nb ? na : nb;\n"
    buf = buf + "    for (int64_t i = 0; i < m; i++) {\n"
    buf = buf + "        if (i < na) out = hexa_array_push(out, HX_ARR_ITEMS(a)[i]);\n"
    buf = buf + "        if (i < nb) out = hexa_array_push(out, HX_ARR_ITEMS(b)[i]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_array_map\n"
    buf = buf + "HexaVal hexa_array_map(HexaVal arr, HexaVal fn) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_array_new();\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    for (int i = 0; i < HX_ARR_LEN(arr); i++) {\n"
    buf = buf + "        out = hexa_array_push(out, hexa_call1(fn, HX_ARR_ITEMS(arr)[i]));\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_array_max\n"
    buf = buf + "HexaVal hexa_array_max(HexaVal arr) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_void();\n"
    buf = buf + "    int64_t n = HX_ARR_LEN(arr);\n"
    buf = buf + "    if (n == 0) return hexa_void();\n"
    buf = buf + "    HexaVal best = HX_ARR_ITEMS(arr)[0];\n"
    buf = buf + "    for (int64_t i = 1; i < n; i++) {\n"
    buf = buf + "        HexaVal it = HX_ARR_ITEMS(arr)[i];\n"
    buf = buf + "        if (hexa_truthy(hexa_cmp_gt(it, best))) best = it;\n"
    buf = buf + "    }\n"
    buf = buf + "    return best;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_array_max_by\n"
    buf = buf + "HexaVal hexa_array_max_by(HexaVal arr, HexaVal fn) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr) || HX_ARR_LEN(arr) == 0) return hexa_void();\n"
    buf = buf + "    int64_t len = HX_ARR_LEN(arr);\n"
    buf = buf + "    HexaVal best = HX_ARR_ITEMS(arr)[0];\n"
    buf = buf + "    HexaVal best_key = hexa_call1(fn, best);\n"
    buf = buf + "    for (int64_t i = 1; i < len; i++) {\n"
    buf = buf + "        HexaVal it = HX_ARR_ITEMS(arr)[i];\n"
    buf = buf + "        HexaVal k = hexa_call1(fn, it);\n"
    buf = buf + "        if (hexa_truthy(hexa_cmp_gt(k, best_key))) { best = it; best_key = k; }\n"
    buf = buf + "    }\n"
    buf = buf + "    return best;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_array_mean\n"
    buf = buf + "HexaVal hexa_array_mean(HexaVal arr) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_float(0.0);\n"
    buf = buf + "    int64_t n = HX_ARR_LEN(arr);\n"
    buf = buf + "    if (n == 0) return hexa_float(0.0);\n"
    buf = buf + "    double total = 0.0;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        total += __hx_to_double(HX_ARR_ITEMS(arr)[i]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_float(total / (double)n);\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_array_min\n"
    buf = buf + "HexaVal hexa_array_min(HexaVal arr) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_void();\n"
    buf = buf + "    int64_t n = HX_ARR_LEN(arr);\n"
    buf = buf + "    if (n == 0) return hexa_void();\n"
    buf = buf + "    HexaVal best = HX_ARR_ITEMS(arr)[0];\n"
    buf = buf + "    for (int64_t i = 1; i < n; i++) {\n"
    buf = buf + "        HexaVal it = HX_ARR_ITEMS(arr)[i];\n"
    buf = buf + "        if (hexa_truthy(hexa_cmp_lt(it, best))) best = it;\n"
    buf = buf + "    }\n"
    buf = buf + "    return best;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_array_min_by\n"
    buf = buf + "HexaVal hexa_array_min_by(HexaVal arr, HexaVal fn) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr) || HX_ARR_LEN(arr) == 0) return hexa_void();\n"
    buf = buf + "    int64_t len = HX_ARR_LEN(arr);\n"
    buf = buf + "    HexaVal best = HX_ARR_ITEMS(arr)[0];\n"
    buf = buf + "    HexaVal best_key = hexa_call1(fn, best);\n"
    buf = buf + "    for (int64_t i = 1; i < len; i++) {\n"
    buf = buf + "        HexaVal it = HX_ARR_ITEMS(arr)[i];\n"
    buf = buf + "        HexaVal k = hexa_call1(fn, it);\n"
    buf = buf + "        if (hexa_truthy(hexa_cmp_lt(k, best_key))) { best = it; best_key = k; }\n"
    buf = buf + "    }\n"
    buf = buf + "    return best;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_array_partition\n"
    buf = buf + "HexaVal hexa_array_partition(HexaVal arr, HexaVal fn) {\n"
    buf = buf + "    HexaVal matching = hexa_array_new();\n"
    buf = buf + "    HexaVal rest = hexa_array_new();\n"
    buf = buf + "    if (HX_IS_ARRAY(arr)) {\n"
    buf = buf + "        for (int64_t i = 0; i < HX_ARR_LEN(arr); i++) {\n"
    buf = buf + "            HexaVal it = HX_ARR_ITEMS(arr)[i];\n"
    buf = buf + "            if (hexa_truthy(hexa_call1(fn, it))) {\n"
    buf = buf + "                matching = hexa_array_push(matching, it);\n"
    buf = buf + "            } else {\n"
    buf = buf + "                rest = hexa_array_push(rest, it);\n"
    buf = buf + "            }\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    out = hexa_array_push(out, matching);\n"
    buf = buf + "    out = hexa_array_push(out, rest);\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_array_position\n"
    buf = buf + "HexaVal hexa_array_position(HexaVal arr, HexaVal fn) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_int(-1);\n"
    buf = buf + "    int64_t len = HX_ARR_LEN(arr);\n"
    buf = buf + "    for (int64_t i = 0; i < len; i++) {\n"
    buf = buf + "        if (hexa_truthy(hexa_call1(fn, HX_ARR_ITEMS(arr)[i]))) return hexa_int(i);\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int(-1);\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_array_product\n"
    buf = buf + "HexaVal hexa_array_product(HexaVal arr) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_int(1);\n"
    buf = buf + "    int64_t n = HX_ARR_LEN(arr);\n"
    buf = buf + "    int has_float = 0;\n"
    buf = buf + "    int64_t int_total = 1;\n"
    buf = buf + "    double float_total = 1.0;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        HexaVal e = HX_ARR_ITEMS(arr)[i];\n"
    buf = buf + "        if (HX_IS_FLOAT(e)) { has_float = 1; float_total *= HX_FLOAT(e); }\n"
    buf = buf + "        else { int_total *= HX_INT(e); }\n"
    buf = buf + "    }\n"
    buf = buf + "    if (has_float) return hexa_float((double)int_total * float_total);\n"
    buf = buf + "    return hexa_int(int_total);\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_array_reduce\n"
    buf = buf + "HexaVal hexa_array_reduce(HexaVal arr, HexaVal fn) {\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr) || HX_ARR_LEN(arr) == 0) {\n"
    buf = buf + "        hexa_throw(hexa_str(\"reduce of empty array (no initial value)\"));\n"
    buf = buf + "        return hexa_void();\n"
    buf = buf + "    }\n"
    buf = buf + "    int64_t len = HX_ARR_LEN(arr);\n"
    buf = buf + "    HexaVal acc = HX_ARR_ITEMS(arr)[0];\n"
    buf = buf + "    for (int64_t i = 1; i < len; i++) acc = hexa_call2(fn, acc, HX_ARR_ITEMS(arr)[i]);\n"
    buf = buf + "    return acc;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_array_rotate\n"
    buf = buf + "HexaVal hexa_array_rotate(HexaVal arr, HexaVal kv) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int64_t n = HX_ARR_LEN(arr);\n"
    buf = buf + "    if (n == 0) return out;\n"
    buf = buf + "    int64_t k = HX_IS_INT(kv) ? HX_INT(kv) : (int64_t)__hx_to_double(kv);\n"
    buf = buf + "    k = k % n;\n"
    buf = buf + "    if (k < 0) k += n;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        out = hexa_array_push(out, HX_ARR_ITEMS(arr)[(i + k) % n]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_array_sample\n"
    buf = buf + "HexaVal hexa_array_sample(HexaVal arr, HexaVal nv) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int64_t n_items = HX_ARR_LEN(arr);\n"
    buf = buf + "    int64_t n = HX_IS_INT(nv) ? HX_INT(nv) : (int64_t)__hx_to_double(nv);\n"
    buf = buf + "    if (n_items == 0 || n <= 0) return out;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        int64_t idx = (int64_t)(rand() / (double)RAND_MAX * (double)n_items);\n"
    buf = buf + "        if (idx >= n_items) idx = n_items - 1;\n"
    buf = buf + "        out = hexa_array_push(out, HX_ARR_ITEMS(arr)[idx]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_array_scan\n"
    buf = buf + "HexaVal hexa_array_scan(HexaVal arr, HexaVal init, HexaVal fn) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    out = hexa_array_push(out, init);\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    HexaVal acc = init;\n"
    buf = buf + "    for (int64_t i = 0; i < HX_ARR_LEN(arr); i++) {\n"
    buf = buf + "        acc = hexa_call2(fn, acc, HX_ARR_ITEMS(arr)[i]);\n"
    buf = buf + "        out = hexa_array_push(out, acc);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_array_skip_while\n"
    buf = buf + "HexaVal hexa_array_skip_while(HexaVal arr, HexaVal fn) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int64_t len = HX_ARR_LEN(arr);\n"
    buf = buf + "    int64_t i = 0;\n"
    buf = buf + "    while (i < len && hexa_truthy(hexa_call1(fn, HX_ARR_ITEMS(arr)[i]))) i++;\n"
    buf = buf + "    for (; i < len; i++) out = hexa_array_push(out, HX_ARR_ITEMS(arr)[i]);\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_array_slice\n"
    buf = buf + "HexaVal hexa_array_slice(HexaVal arr, HexaVal start, HexaVal end) {\n"
    buf = buf + "    // 2026-05-19 parity-gate t45b — polymorphic slice + 1-arg form.\n"
    buf = buf + "    // (1) HX_IS_VOID(end) ⇒ 1-arg `.slice(start)` form — default end to\n"
    buf = buf + "    // len(obj). (2) HX_IS_STR(obj) ⇒ string slice via byte-indexed\n"
    buf = buf + "    // substring (mirrors interp's `.slice` on strings). Array path\n"
    buf = buf + "    // unchanged for the common case.\n"
    buf = buf + "    if (HX_IS_STR(arr)) {\n"
    buf = buf + "        int n = (int)HX_STRLEN(arr);\n"
    buf = buf + "        int a = (int)HX_INT(start);\n"
    buf = buf + "        int b = HX_IS_VOID(end) ? n : (int)HX_INT(end);\n"
    buf = buf + "        if (a < 0) a += n;\n"
    buf = buf + "        if (b < 0) b += n;\n"
    buf = buf + "        if (a < 0) a = 0;\n"
    buf = buf + "        if (b > n) b = n;\n"
    buf = buf + "        if (a > b) return hexa_str(\"\");\n"
    buf = buf + "        int len = b - a;\n"
    buf = buf + "        char* buf = (char*)malloc(len + 1);\n"
    buf = buf + "        if (!buf) return hexa_str(\"\");\n"
    buf = buf + "        int j = 0;\n"
    buf = buf + "        while (j < len) { buf[j] = HX_STR(arr)[a + j]; j++; }\n"
    buf = buf + "        buf[len] = 0;\n"
    buf = buf + "        return hexa_str_own(buf);\n"
    buf = buf + "    }\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return hexa_array_new();\n"
    buf = buf + "    int n = HX_ARR_LEN(arr);\n"
    buf = buf + "    int a = (int)HX_INT(start);\n"
    buf = buf + "    int b = HX_IS_VOID(end) ? n : (int)HX_INT(end);\n"
    buf = buf + "    // PROBE r14-D — Python-canonical negative wrap before clamp.\n"
    buf = buf + "    // arr[-2..] ≡ arr[len-2..]; arr[..-1] ≡ arr[..len-1]. After wrap, still\n"
    buf = buf + "    // out-of-range bounds clamp to [0, n] (Python slice semantics, distinct\n"
    buf = buf + "    // from indexing which throws).\n"
    buf = buf + "    if (a < 0) a += n;\n"
    buf = buf + "    if (b < 0) b += n;\n"
    buf = buf + "    if (a < 0) a = 0;\n"
    buf = buf + "    if (b > n) b = n;\n"
    buf = buf + "    if (a > b) a = b;\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    for (int i = a; i < b; i++) out = hexa_array_push(out, HX_ARR_ITEMS(arr)[i]);\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_array_step_by\n"
    buf = buf + "HexaVal hexa_array_step_by(HexaVal arr, HexaVal nv) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int64_t n = HX_IS_INT(nv) ? HX_INT(nv) : (int64_t)__hx_to_double(nv);\n"
    buf = buf + "    if (n <= 0) return out;\n"
    buf = buf + "    int64_t len = HX_ARR_LEN(arr);\n"
    buf = buf + "    for (int64_t i = 0; i < len; i += n) out = hexa_array_push(out, HX_ARR_ITEMS(arr)[i]);\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_array_swap\n"
    buf = buf + "HexaVal hexa_array_swap(HexaVal arr, HexaVal iv, HexaVal jv) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int64_t n = HX_ARR_LEN(arr);\n"
    buf = buf + "    int64_t i = HX_IS_INT(iv) ? HX_INT(iv) : (int64_t)__hx_to_double(iv);\n"
    buf = buf + "    int64_t j = HX_IS_INT(jv) ? HX_INT(jv) : (int64_t)__hx_to_double(jv);\n"
    buf = buf + "    if (i < 0 || j < 0 || i >= n || j >= n) {\n"
    buf = buf + "        for (int64_t k = 0; k < n; k++) out = hexa_array_push(out, HX_ARR_ITEMS(arr)[k]);\n"
    buf = buf + "        return out;\n"
    buf = buf + "    }\n"
    buf = buf + "    for (int64_t k = 0; k < n; k++) {\n"
    buf = buf + "        if (k == i) out = hexa_array_push(out, HX_ARR_ITEMS(arr)[j]);\n"
    buf = buf + "        else if (k == j) out = hexa_array_push(out, HX_ARR_ITEMS(arr)[i]);\n"
    buf = buf + "        else out = hexa_array_push(out, HX_ARR_ITEMS(arr)[k]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_array_take\n"
    buf = buf + "HexaVal hexa_array_take(HexaVal arr, HexaVal nv) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(arr)) return out;\n"
    buf = buf + "    int64_t n = HX_IS_INT(nv) ? HX_INT(nv) : (int64_t)__hx_to_double(nv);\n"
    buf = buf + "    int64_t len = HX_ARR_LEN(arr);\n"
    buf = buf + "    int64_t k = n < len ? n : len;\n"
    buf = buf + "    if (k < 0) k = 0;\n"
    buf = buf + "    for (int64_t i = 0; i < k; i++) {\n"
    buf = buf + "        out = hexa_array_push(out, HX_ARR_ITEMS(arr)[i]);\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_array_take_while\n"
