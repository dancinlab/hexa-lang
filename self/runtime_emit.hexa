    buf = buf + "// hexa_from_char_code (frozen runtime.c — hxlcl_strdup delegate)\n"
    buf = buf + "HexaVal hexa_from_char_code(HexaVal n) {\n"
    buf = buf + "    int64_t code = HX_IS_INT(n) ? HX_INT(n) : (int64_t)HX_FLOAT(n);\n"
    buf = buf + "    if (code < 0) code = 0;\n"
    buf = buf + "    if (code < 0x80) {\n"
    buf = buf + "        char* s = (char*)malloc(2); s[0] = (char)code; s[1] = 0;\n"
    buf = buf + "        return hexa_str_own(s);\n"
    buf = buf + "    }\n"
    buf = buf + "    char buf[5] = {0};\n"
    buf = buf + "    if (code < 0x800) {\n"
    buf = buf + "        buf[0] = (char)(0xC0 | (code >> 6));\n"
    buf = buf + "        buf[1] = (char)(0x80 | (code & 0x3F));\n"
    buf = buf + "    } else if (code < 0x10000) {\n"
    buf = buf + "        buf[0] = (char)(0xE0 | (code >> 12));\n"
    buf = buf + "        buf[1] = (char)(0x80 | ((code >> 6) & 0x3F));\n"
    buf = buf + "        buf[2] = (char)(0x80 | (code & 0x3F));\n"
    buf = buf + "    } else {\n"
    buf = buf + "        buf[0] = (char)(0xF0 | (code >> 18));\n"
    buf = buf + "        buf[1] = (char)(0x80 | ((code >> 12) & 0x3F));\n"
    buf = buf + "        buf[2] = (char)(0x80 | ((code >> 6) & 0x3F));\n"
    buf = buf + "        buf[3] = (char)(0x80 | (code & 0x3F));\n"
    buf = buf + "    }\n"
    buf = buf + "    char* out = hxlcl_strdup(buf);\n"
    buf = buf + "    return hexa_str_own(out);\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_list_dir (frozen runtime.c — opendir/readdir libc link-dep)\n"
    buf = buf + "HexaVal hexa_list_dir(HexaVal path) {\n"
    buf = buf + "    if (!HX_IS_STR(path) || !HX_STR(path) || !HX_STR(path)[0]) return hexa_array_new();\n"
    buf = buf + "    const char* p = HX_STR(path);\n"
    buf = buf + "    DIR* d = opendir(p);\n"
    buf = buf + "    if (!d) return hexa_array_new();\n"
    buf = buf + "    HexaVal arr = hexa_array_new();\n"
    buf = buf + "    struct dirent* ent;\n"
    buf = buf + "    while ((ent = readdir(d)) != NULL) {\n"
    buf = buf + "        if (ent->d_name[0] == '.') continue;\n"
    buf = buf + "        arr = hexa_array_push(arr, hexa_str(ent->d_name));\n"
    buf = buf + "    }\n"
    buf = buf + "    closedir(d);\n"
    buf = buf + "    return arr;\n"
    buf = buf + "}\n"
    buf = buf + "// rt_append_file (frozen runtime.c — hxlcl_strlen delegate + libc fopen)\n"
    buf = buf + "HexaVal rt_append_file(HexaVal path, HexaVal content) {\n"
    buf = buf + "    if (!HX_IS_STR(path) || !HX_STR(path)) return hexa_void();\n"
    buf = buf + "    const char* data = (HX_IS_STR(content) && HX_STR(content)) ? HX_STR(content) : \"\";\n"
    buf = buf + "    FILE* f = fopen(HX_STR(path), \"ab\");\n"
    buf = buf + "    if (!f) return hexa_void();\n"
    buf = buf + "    fwrite(data, 1, hxlcl_strlen(data), f);\n"
    buf = buf + "    fclose(f);\n"
    buf = buf + "    return hexa_void();\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_utc_iso_format (frozen runtime.c — hxlcl_strftime delegate + gmtime_r)\n"
    buf = buf + "HexaVal hexa_utc_iso_format(HexaVal epoch_v) {\n"
    buf = buf + "    int64_t e = HX_IS_INT(epoch_v) ? HX_INT(epoch_v) : (int64_t)HX_FLOAT(epoch_v);\n"
    buf = buf + "    time_t t = (time_t)e;\n"
    buf = buf + "    struct tm g;\n"
    buf = buf + "    gmtime_r(&t, &g);\n"
    buf = buf + "    char buf[32];\n"
    buf = buf + "    hxlcl_strftime(buf, sizeof(buf), \"%Y-%m-%dT%H:%M:%SZ\", &g);\n"
    buf = buf + "    return hexa_str(buf);\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_utc_iso_parse (frozen runtime.c — hxlcl_memset/strlen delegate + sscanf)\n"
    buf = buf + "HexaVal hexa_utc_iso_parse(HexaVal s_v) {\n"
    buf = buf + "    if (!HX_IS_STR(s_v)) return hexa_int(0);\n"
    buf = buf + "    const char* s = HX_STR(s_v);\n"
    buf = buf + "    if (!s) return hexa_int(0);\n"
    buf = buf + "    int Y=0, M=0, D=0, h=0, m=0, sec=0;\n"
    buf = buf + "    int n = sscanf(s, \"%d-%d-%dT%d:%d:%d\", &Y, &M, &D, &h, &m, &sec);\n"
    buf = buf + "    if (n < 6) return hexa_int(0);\n"
    buf = buf + "    struct tm g;\n"
    buf = buf + "    hxlcl_memset(&g, 0, sizeof(g));\n"
    buf = buf + "    g.tm_year = Y - 1900;\n"
    buf = buf + "    g.tm_mon  = M - 1;\n"
    buf = buf + "    g.tm_mday = D;\n"
    buf = buf + "    g.tm_hour = h;\n"
    buf = buf + "    g.tm_min  = m;\n"
    buf = buf + "    g.tm_sec  = sec;\n"
    buf = buf + "    int64_t epoch = (int64_t)timegm(&g);\n"
    buf = buf + "    size_t L = hxlcl_strlen(s);\n"
    buf = buf + "    if (L >= 5) {\n"
    buf = buf + "        for (ssize_t i = (ssize_t)L - 1; i > 0; i--) {\n"
    buf = buf + "            char c = s[i];\n"
    buf = buf + "            if (c == '+' || c == '-') {\n"
    buf = buf + "                int sign = (c == '+') ? 1 : -1;\n"
    buf = buf + "                int oh = 0, om = 0;\n"
    buf = buf + "                const char* off = s + i + 1;\n"
    buf = buf + "                if (sscanf(off, \"%d:%d\", &oh, &om) == 2 ||\n"
    buf = buf + "                    sscanf(off, \"%2d%2d\", &oh, &om) == 2) {\n"
    buf = buf + "                    epoch -= sign * (oh * 3600 + om * 60);\n"
    buf = buf + "                }\n"
    buf = buf + "                break;\n"
    buf = buf + "            }\n"
    buf = buf + "            if (c == 'Z' || c == 'z') break;\n"
    buf = buf + "            if (c >= '0' && c <= '9') continue;\n"
    buf = buf + "            if (c == ':' || c == '.') continue;\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return hexa_int(epoch);\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_http_get (frozen runtime.c — hxlcl_memcpy/popen/pclose delegate)\n"
    buf = buf + "HexaVal hexa_http_get(HexaVal url) {\n"
    buf = buf + "    if (!HX_IS_STR(url) || !HX_STR(url)) return hexa_str(\"\");\n"
    buf = buf + "    const char* u = HX_STR(url);\n"
    buf = buf + "    for (const char* p = u; *p; p++) {\n"
    buf = buf + "        char c = *p;\n"
    buf = buf + "        if (c == '`' || c == '$' || c == ';' || c == '|' || c == '&'\n"
    buf = buf + "            || c == '<' || c == '>' || c == '\\n' || c == '\\r'\n"
    buf = buf + "            || c == '\\'' || c == '\"' || c == '\\\\') {\n"
    buf = buf + "            return hexa_str(\"\");\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    char cmd[4096];\n"
    buf = buf + "    int k = snprintf(cmd, sizeof(cmd), \"curl -fsSL --max-time 30 '%s' 2>/dev/null\", u);\n"
    buf = buf + "    if (k < 0 || (size_t)k >= sizeof(cmd)) return hexa_str(\"\");\n"
    buf = buf + "    fflush(NULL);\n"
    buf = buf + "    FILE* fp = hxlcl_popen(cmd, \"r\");\n"
    buf = buf + "    if (!fp) return hexa_str(\"\");\n"
    buf = buf + "    size_t cap = 4096, len = 0;\n"
    buf = buf + "    char* buf = (char*)malloc(cap);\n"
    buf = buf + "    if (!buf) { hxlcl_pclose(fp); return hexa_str(\"\"); }\n"
    buf = buf + "    size_t r;\n"
    buf = buf + "    char chunk[2048];\n"
    buf = buf + "    while ((r = fread(chunk, 1, sizeof(chunk), fp)) > 0) {\n"
    buf = buf + "        if (len + r + 1 >= cap) {\n"
    buf = buf + "            while (len + r + 1 >= cap) cap *= 2;\n"
    buf = buf + "            char* nb = (char*)realloc(buf, cap);\n"
    buf = buf + "            if (!nb) { free(buf); hxlcl_pclose(fp); return hexa_str(\"\"); }\n"
    buf = buf + "            buf = nb;\n"
    buf = buf + "        }\n"
    buf = buf + "        hxlcl_memcpy(buf + len, chunk, r);\n"
    buf = buf + "        len += r;\n"
    buf = buf + "    }\n"
    buf = buf + "    buf[len] = 0;\n"
    buf = buf + "    hxlcl_pclose(fp);\n"
    buf = buf + "    return hexa_str_own(buf);\n"
    buf = buf + "}\n"
    buf = buf + "// ── batch 9 (ING #35 r24) — ml/math array leaves (census-clean tail) ─\n"
    buf = buf + "//  r24 CENSUS measured the 309-body hexa_* tail and found it is now\n"
    buf = buf + "//  nearly DEPLETED of clean supplied-link-dep leaves (the r18..r23 batches\n"
    buf = buf + "//  harvested the array/str/math/delegate families). The remaining clean\n"
    buf = buf + "//  attackable subset is just these 4 bodies — every callee is supplied-\n"
    buf = buf + "//  OUTSIDE-residual (hexa_array_new/get/push + hexa_float/int + __hx_to_\n"
    buf = buf + "//  double + HX_* macros) or a SUPPLIED delegate (hxlcl_exp/fmod, in\n"
    buf = buf + "//  zeroc_hxlcl_delegate.o seedprov=1) or a libc link-dep (malloc/free).\n"
    buf = buf + "//  VERBATIM ports of the ACTIVE branch in frozen runtime.c (blob 151c52c8).\n"
    buf = buf + "//  The rest of the tail routes through genuine WALLS (measured r24):\n"
    buf = buf + "//    farr_gpu (_hx_farr*_cpu/_hx_farr_table 80) · #ifdef-amalgam crypto/\n"
    buf = buf + "//    net/SIMD (98, conditional-compile branches) · syscall statics\n"
    buf = buf + "//    (hxlcl_clock_gettime/read/write/pipe/dup2/waitpid/nanosleep) ·\n"
    buf = buf + "//    strbuf static-inline · file-static pools (__hexa_cb_slots/_b64_enc/\n"
    buf = buf + "//    _hx_stats_*/g_ffi_overflow) · json/regex/quantum statics ·\n"
    buf = buf + "//    HEXA_FORGE_HOST_WEAK forge dispatch weak-stubs (ABI risk — defer) ·\n"
    buf = buf + "//    unsupplied externs (hxlcl_strndup/rt_str_parse_int). net residual: -4.\n"
    buf = buf + "extern double hxlcl_fmod(double x, double y);  // supplied by zeroc_hxlcl_delegate.o\n"
    buf = buf + "// hexa_silu (frozen runtime.c — hxlcl_exp delegate + supplied array prims)\n"
    buf = buf + "HexaVal hexa_silu(HexaVal a) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(a)) return out;\n"
    buf = buf + "    int64_t n = (int64_t)HX_ARR_LEN(a);\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        double x = __hx_to_double(hexa_array_get(a, i));\n"
    buf = buf + "        out = hexa_array_push(out, hexa_float(x / (1.0 + hxlcl_exp(-x))));\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_softmax (frozen runtime.c — hxlcl_exp delegate + libc malloc/free)\n"
    buf = buf + "HexaVal hexa_softmax(HexaVal a) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(a)) return out;\n"
    buf = buf + "    int64_t n = (int64_t)HX_ARR_LEN(a);\n"
    buf = buf + "    if (n == 0) return out;\n"
    buf = buf + "    double m = __hx_to_double(hexa_array_get(a, 0));\n"
    buf = buf + "    for (int64_t i = 1; i < n; i++) {\n"
    buf = buf + "        double v = __hx_to_double(hexa_array_get(a, i));\n"
    buf = buf + "        if (v > m) m = v;\n"
    buf = buf + "    }\n"
    buf = buf + "    double sum = 0.0;\n"
    buf = buf + "    double* tmp = (double*)malloc(sizeof(double) * (size_t)n);\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        double v = __hx_to_double(hexa_array_get(a, i));\n"
    buf = buf + "        tmp[i] = hxlcl_exp(v - m);\n"
    buf = buf + "        sum += tmp[i];\n"
    buf = buf + "    }\n"
    buf = buf + "    double inv = sum > 0.0 ? 1.0 / sum : 0.0;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) out = hexa_array_push(out, hexa_float(tmp[i] * inv));\n"
    buf = buf + "    free(tmp);\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_math_fmod (frozen runtime.c — hxlcl_fmod delegate, supplied)\n"
    buf = buf + "HexaVal hexa_math_fmod(HexaVal a, HexaVal b) { return hexa_float(hxlcl_fmod(HX_FLOAT(a), HX_FLOAT(b))); }\n"
    buf = buf + "// hexa_farr_set_out_disposition (frozen runtime.c — #else CPU branch active\n"
    buf = buf + "//  on the drop TU; the #ifdef HEXA_CUDA arm references the extern\n"
    buf = buf + "//  _hx_cuda_set_out_disposition only on a CUDA build — kept VERBATIM)\n"
    buf = buf + "HexaVal hexa_farr_set_out_disposition(HexaVal d_v) {\n"
    buf = buf + "#ifdef HEXA_CUDA\n"
    buf = buf + "    extern int _hx_cuda_set_out_disposition(int d);\n"
    buf = buf + "    return hexa_int(_hx_cuda_set_out_disposition((int)hexa_as_num(d_v)));\n"
    buf = buf + "#else\n"
    buf = buf + "    (void)d_v;\n"
    buf = buf + "    return hexa_int(0);\n"
    buf = buf + "#endif\n"
    buf = buf + "}\n"
    if buf.len() > 0 { _flush_runtime_hi(out_path, buf) }
}

fn main() {
    let argv = real_args()
    let out_path = if argv.len() >= 1 { argv[0] } else { "runtime_hi_seed.c" }
    emit_runtime_hi_seed_to(out_path)
    let exists_check = exec("[ -f \"" + out_path + "\" ] && echo y || echo n").trim()
    if exists_check != "y" {
        println("[runtime_emit] FATAL: failed to write " + out_path)
        exit(1)
    }
    println("[runtime_emit] wrote " + out_path)
    exit(0)
}
