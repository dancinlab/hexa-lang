    buf = buf + "    return rt_array_zeros_float(hexa_int(n));\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_array_alloc (frozen runtime.c L5073 — HEXA_HAS_HEXA_RT_STDLIB branch)\n"
