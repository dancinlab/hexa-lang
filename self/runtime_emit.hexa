    buf = buf + "#include <time.h>   // gmtime_r/timegm/struct tm (utc_iso_format/parse)\n"
    buf = buf + "// the 7 r23 mem/str statics — supplied by zeroc_hxlcl_delegate.o (seedprov=1)\n"
