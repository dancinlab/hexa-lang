    buf = buf + "// hexa_gelu\n"
    buf = buf + "HexaVal hexa_gelu(HexaVal a) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(a)) return out;\n"
    buf = buf + "    int64_t n = (int64_t)HX_ARR_LEN(a);\n"
    buf = buf + "    const double k = 0.7978845608028654; // sqrt(2/pi)\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        double x = __hx_to_double(hexa_array_get(a, i));\n"
    buf = buf + "        double inner = k * (x + 0.044715 * x * x * x);\n"
    buf = buf + "        out = hexa_array_push(out, hexa_float(0.5 * x * (1.0 + tanh(inner))));\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_rms_norm\n"
    buf = buf + "HexaVal hexa_rms_norm(HexaVal x, HexaVal gamma, HexaVal epsv) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(x)) return out;\n"
    buf = buf + "    int64_t n = (int64_t)HX_ARR_LEN(x);\n"
    buf = buf + "    if (n == 0) return out;\n"
    buf = buf + "    double ss = 0.0;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        double v = __hx_to_double(hexa_array_get(x, i));\n"
    buf = buf + "        ss += v * v;\n"
    buf = buf + "    }\n"
    buf = buf + "    double mean = ss / (double)n;\n"
    buf = buf + "    double eps = __hx_to_double(epsv);\n"
    buf = buf + "    double inv = 1.0 / sqrt(mean + eps);\n"
    buf = buf + "    int gamma_is_arr = HX_IS_ARRAY(gamma);\n"
    buf = buf + "    double gamma_scalar = gamma_is_arr ? 1.0 : __hx_to_double(gamma);\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        double v = __hx_to_double(hexa_array_get(x, i));\n"
    buf = buf + "        double g = gamma_is_arr\n"
    buf = buf + "            ? __hx_to_double(hexa_array_get(gamma, i < (int64_t)HX_ARR_LEN(gamma) ? i : 0))\n"
    buf = buf + "            : gamma_scalar;\n"
    buf = buf + "        out = hexa_array_push(out, hexa_float(g * v * inv));\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_layer_norm\n"
    buf = buf + "HexaVal hexa_layer_norm(HexaVal x, HexaVal gamma, HexaVal epsv) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(x)) return out;\n"
    buf = buf + "    int64_t n = (int64_t)HX_ARR_LEN(x);\n"
    buf = buf + "    if (n == 0) return out;\n"
    buf = buf + "    double sum = 0.0;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) sum += __hx_to_double(hexa_array_get(x, i));\n"
    buf = buf + "    double mean = sum / (double)n;\n"
    buf = buf + "    double ss = 0.0;\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        double d = __hx_to_double(hexa_array_get(x, i)) - mean;\n"
    buf = buf + "        ss += d * d;\n"
    buf = buf + "    }\n"
    buf = buf + "    double var = ss / (double)n;\n"
    buf = buf + "    double eps = __hx_to_double(epsv);\n"
    buf = buf + "    double inv = 1.0 / sqrt(var + eps);\n"
    buf = buf + "    int gamma_is_arr = HX_IS_ARRAY(gamma);\n"
    buf = buf + "    double gamma_scalar = gamma_is_arr ? 1.0 : __hx_to_double(gamma);\n"
    buf = buf + "    for (int64_t i = 0; i < n; i++) {\n"
    buf = buf + "        double d = __hx_to_double(hexa_array_get(x, i)) - mean;\n"
    buf = buf + "        double g = gamma_is_arr\n"
    buf = buf + "            ? __hx_to_double(hexa_array_get(gamma, i < (int64_t)HX_ARR_LEN(gamma) ? i : 0))\n"
    buf = buf + "            : gamma_scalar;\n"
    buf = buf + "        out = hexa_array_push(out, hexa_float(g * d * inv));\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_rope_pair\n"
    buf = buf + "HexaVal hexa_rope_pair(HexaVal x0v, HexaVal x1v, HexaVal thetav) {\n"
    buf = buf + "    double x0 = __hx_to_double(x0v);\n"
    buf = buf + "    double x1 = __hx_to_double(x1v);\n"
    buf = buf + "    double th = __hx_to_double(thetav);\n"
    buf = buf + "    double c = cos(th);\n"
    buf = buf + "    double s = sin(th);\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    out = hexa_array_push(out, hexa_float(x0 * c - x1 * s));\n"
    buf = buf + "    out = hexa_array_push(out, hexa_float(x0 * s + x1 * c));\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_matmul\n"
    buf = buf + "HexaVal hexa_matmul(HexaVal a, HexaVal b, HexaVal mv, HexaVal kv, HexaVal nv) {\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    if (!HX_IS_ARRAY(a) || !HX_IS_ARRAY(b)) return out;\n"
    buf = buf + "    int64_t m = (int64_t)__hx_to_double(mv);\n"
    buf = buf + "    int64_t k = (int64_t)__hx_to_double(kv);\n"
    buf = buf + "    int64_t n = (int64_t)__hx_to_double(nv);\n"
    buf = buf + "    if (m < 0 || k < 0 || n < 0) return out;\n"
    buf = buf + "    int64_t alen = (int64_t)HX_ARR_LEN(a), blen = (int64_t)HX_ARR_LEN(b);\n"
    buf = buf + "    for (int64_t i = 0; i < m; i++) {\n"
    buf = buf + "        for (int64_t j = 0; j < n; j++) {\n"
    buf = buf + "            double s = 0.0;\n"
    buf = buf + "            for (int64_t p = 0; p < k; p++) {\n"
    buf = buf + "                int64_t ai = i * k + p;\n"
    buf = buf + "                int64_t bi = p * n + j;\n"
    buf = buf + "                if (ai >= alen || bi >= blen) continue;\n"
    buf = buf + "                s += __hx_to_double(hexa_array_get(a, ai)) *\n"
    buf = buf + "                     __hx_to_double(hexa_array_get(b, bi));\n"
    buf = buf + "            }\n"
    buf = buf + "            out = hexa_array_push(out, hexa_float(s));\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    return out;\n"
    buf = buf + "}\n"
    buf = buf + "// ═══════════════════════════════════════════════════════════\n"
    buf = buf + "//  batch 7 (ING #35 r21) — syscall/libc fs + ffi-dlsym + ml leaves.\n"
    buf = buf + "//  9 bodies whose EVERY callee is supplied-outside-residual (libc\n"
    buf = buf + "//  getcwd/unlink/close/mkdtemp/mkstemp/opendir/glob/dlsym = link-dep,\n"
