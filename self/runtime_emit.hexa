    buf = buf + "// rt_read_lines (frozen runtime.c — hxlcl_memcpy delegate + supplied prims)\n"
    buf = buf + "HexaVal rt_read_lines(HexaVal path) {\n"
    buf = buf + "    HexaVal content = rt_read_file(path);\n"
    buf = buf + "    if (!HX_IS_STR(content)) return hexa_array_new();\n"
    buf = buf + "    HexaVal out = hexa_array_new();\n"
    buf = buf + "    const char* p = HX_STR(content);\n"
    buf = buf + "    const char* start = p;\n"
    buf = buf + "    while (*p) {\n"
    buf = buf + "        if (*p == '\\n') {\n"
    buf = buf + "            size_t len = (size_t)(p - start);\n"
    buf = buf + "            char* line = (char*)malloc(len + 1);\n"
    buf = buf + "            hxlcl_memcpy(line, start, len);\n"
    buf = buf + "            line[len] = 0;\n"
    buf = buf + "            out = hexa_array_push(out, hexa_str_own(line));\n"
    buf = buf + "            start = p + 1;\n"
