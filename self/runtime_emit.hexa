    buf = buf + "// ── batch 13 (ING #35 r28) — CARRIER-EMIT harvest: FFI extern-call cluster ──\n"
    buf = buf + "//  RFC061 r28 applies the proven carrier-emit mechanism to the FFI extern-call\n"
    buf = buf + "//  subsystem. The walled bodies hexa_extern_call / hexa_extern_call_typed /\n"
    buf = buf + "//  hexa_host_ffi_call_6 are pure C-ABI marshallers: they read HexaVal lanes via\n"
    buf = buf + "//  the supplied constructors (hexa_int/float/bool/str/void/valstruct_new_v) and\n"
    buf = buf + "//  call through a fn-ptr cast — NO dependency on any frozen runtime subsystem.\n"
    buf = buf + "//  Their file-static helpers (hexa_ffi_marshal_arg, hexa_call_extern_raw,\n"
    buf = buf + "//  hexa_host_ffi_unwrap) and the g_ffi_overflow[14] overflow carrier export NO\n"
    buf = buf + "//  link symbol (file-static), so a FRESH co-located copy collides with nothing —\n"
    buf = buf + "//  the frozen runtime.c copy lives in the DROPPED/uncompiled TU. Same precedent\n"
    buf = buf + "//  as r26 _hx_stats / r27 strbuf+base64. g_ffi_overflow is a private scratch\n"
    buf = buf + "//  buffer driven entirely by THIS TU's call_6 (sentinel store, then real\n"
    buf = buf + "//  dispatch) — it shares NO mutable state with code in the frozen runtime. All\n"
    buf = buf + "//  bodies compile VERBATIM from frozen blob 151c52c8 (runtime.c PROPER). The\n"
    buf = buf + "//  DEFAULT/shipping build never compiles this seed → frozen runtime.c stays SSOT.\n"
    buf = buf + "//  valstruct-ABI prologue: runtime.h forward-declares HexaValStruct opaque +\n"
    buf = buf + "//  supplies HX_VS but NOT HX_VSF/HX_IS_VALSTRUCT/HX_IS_BOOL nor the inner struct\n"
    buf = buf + "//  body (those live in the dropped runtime_core.c). hexa_host_ffi_unwrap derefs\n"
    buf = buf + "//  .vs->tag_i, so we complete the opaque struct + macros here, #ifndef-guarded so\n"
    buf = buf + "//  the default build (which gets them from runtime_core.c) sees no redefinition.\n"
    buf = buf + "extern void* dlsym(void*, const char*);\n"
    buf = buf + "extern char* dlerror(void);\n"
    buf = buf + "// ── valstruct ABI completion (frozen runtime_core.c L1309 — byte-faithful) ──\n"
    buf = buf + "#ifndef HEXA_R28_VALSTRUCT_ABI\n"
    buf = buf + "#define HEXA_R28_VALSTRUCT_ABI\n"
    buf = buf + "typedef struct HexaValStruct {\n"
    buf = buf + "    int64_t tag_i;          // Hexa-level Val.tag (TAG_INT / TAG_FLOAT / ...)\n"
    buf = buf + "    int64_t int_val;\n"
    buf = buf + "    double  float_val;\n"
    buf = buf + "    int     bool_val;\n"
    buf = buf + "    // rt 32-L: 1 = allocated from the bump arena, 0 = malloc heap. Arena\n"
    buf = buf + "    // VALSTRUCTs MUST be heapified before they outlive the current scope.\n"
    buf = buf + "    // Sits in the alignment padding between bool_val (4B) and the first\n"
    buf = buf + "    // HexaVal (24B aligned to 8) — zero size cost in practice.\n"
    buf = buf + "    int     from_arena;\n"
    buf = buf + "    // Polymorphic slots — store the original HexaVal verbatim. For TAG_STR\n"
    buf = buf + "    // payloads this is just s/tag; for arrays/maps the .arr / .map / .vs\n"
    buf = buf + "    // member survives intact. Empty/missing fields use TAG_VOID.\n"
    buf = buf + "    HexaVal str_val;\n"
    buf = buf + "    HexaVal char_val;\n"
    buf = buf + "    HexaVal array_val;     // crucial for AST body propagation\n"
    buf = buf + "    HexaVal fn_name;\n"
    buf = buf + "    HexaVal fn_params;     // TAG_ARRAY (closure param list)\n"
    buf = buf + "    HexaVal fn_body;       // TAG_MAP / TAG_ARRAY (AST body)\n"
    buf = buf + "    HexaVal struct_name;\n"
    buf = buf + "    HexaVal struct_fields; // TAG_MAP (struct field map)\n"
    buf = buf + "} HexaValStruct;\n"
    buf = buf + "#ifndef HX_VSF\n"
    buf = buf + "#define HX_VSF(v, field)   (HX_VS(v)->field)\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifndef HX_IS_VALSTRUCT\n"
    buf = buf + "#define HX_IS_VALSTRUCT(v) ((v).tag == TAG_VALSTRUCT)\n"
    buf = buf + "#endif\n"
    buf = buf + "#ifndef HX_IS_BOOL\n"
    buf = buf + "#define HX_IS_BOOL(v)      ((v).tag == TAG_BOOL)\n"
    buf = buf + "#endif\n"
    buf = buf + "#endif  // HEXA_R28_VALSTRUCT_ABI\n"
    buf = buf + "// hexa_ffi_marshal_arg + hexa_call_extern_raw (frozen runtime.c L3204 — file-static)\n"
    buf = buf + "// Marshal a HexaVal to a raw i64 for C ABI passing.\n"
    buf = buf + "static int64_t hexa_ffi_marshal_arg(HexaVal v) {\n"
    buf = buf + "    switch (HX_TAG(v)) {\n"
    buf = buf + "        case TAG_INT:   return HX_INT(v);\n"
    buf = buf + "        case TAG_FLOAT: { union { double d; int64_t i; } u; u.d = HX_FLOAT(v); return u.i; }\n"
    buf = buf + "        case TAG_BOOL:  return (int64_t)HX_BOOL(v);\n"
    buf = buf + "        case TAG_STR:   return (int64_t)(uintptr_t)HX_STR(v);\n"
    buf = buf + "        case TAG_VOID:  return 0;\n"
    buf = buf + "        default:        return 0;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// Raw extern call dispatch — supports 0 to 14 arguments.\n"
    buf = buf + "// Extended 2026-04-16 from 12 to 14 to support cblas_sgemm (14 args).\n"
    buf = buf + "// Uses transmute (cast) to call through a function pointer with the right arity.\n"
    buf = buf + "static int64_t hexa_call_extern_raw(void* fn_ptr, int64_t* args, int nargs) {\n"
    buf = buf + "    typedef int64_t (*Fn0)(void);\n"
    buf = buf + "    typedef int64_t (*Fn1)(int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn2)(int64_t,int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn3)(int64_t,int64_t,int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn4)(int64_t,int64_t,int64_t,int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn5)(int64_t,int64_t,int64_t,int64_t,int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn6)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn7)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn8)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn9)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn10)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn11)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn12)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn13)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t);\n"
    buf = buf + "    typedef int64_t (*Fn14)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t);\n"
    buf = buf + "\n"
    buf = buf + "    switch (nargs) {\n"
    buf = buf + "        case 0:  return ((Fn0)fn_ptr)();\n"
    buf = buf + "        case 1:  return ((Fn1)fn_ptr)(args[0]);\n"
    buf = buf + "        case 2:  return ((Fn2)fn_ptr)(args[0],args[1]);\n"
    buf = buf + "        case 3:  return ((Fn3)fn_ptr)(args[0],args[1],args[2]);\n"
    buf = buf + "        case 4:  return ((Fn4)fn_ptr)(args[0],args[1],args[2],args[3]);\n"
    buf = buf + "        case 5:  return ((Fn5)fn_ptr)(args[0],args[1],args[2],args[3],args[4]);\n"
    buf = buf + "        case 6:  return ((Fn6)fn_ptr)(args[0],args[1],args[2],args[3],args[4],args[5]);\n"
    buf = buf + "        case 7:  return ((Fn7)fn_ptr)(args[0],args[1],args[2],args[3],args[4],args[5],args[6]);\n"
    buf = buf + "        case 8:  return ((Fn8)fn_ptr)(args[0],args[1],args[2],args[3],args[4],args[5],args[6],args[7]);\n"
    buf = buf + "        case 9:  return ((Fn9)fn_ptr)(args[0],args[1],args[2],args[3],args[4],args[5],args[6],args[7],args[8]);\n"
    buf = buf + "        case 10: return ((Fn10)fn_ptr)(args[0],args[1],args[2],args[3],args[4],args[5],args[6],args[7],args[8],args[9]);\n"
    buf = buf + "        case 11: return ((Fn11)fn_ptr)(args[0],args[1],args[2],args[3],args[4],args[5],args[6],args[7],args[8],args[9],args[10]);\n"
    buf = buf + "        case 12: return ((Fn12)fn_ptr)(args[0],args[1],args[2],args[3],args[4],args[5],args[6],args[7],args[8],args[9],args[10],args[11]);\n"
    buf = buf + "        case 13: return ((Fn13)fn_ptr)(args[0],args[1],args[2],args[3],args[4],args[5],args[6],args[7],args[8],args[9],args[10],args[11],args[12]);\n"
    buf = buf + "        case 14: return ((Fn14)fn_ptr)(args[0],args[1],args[2],args[3],args[4],args[5],args[6],args[7],args[8],args[9],args[10],args[11],args[12],args[13]);\n"
    buf = buf + "        default:\n"
    buf = buf + "            fprintf(stderr, \"[hexa-ffi] extern call with %d args not supported (max 14)\\n\", nargs);\n"
    buf = buf + "            return 0;\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// High-level extern call: resolve, marshal, call, unmarshal.\n"
    buf = buf + "// hexa_extern_call (frozen runtime.c L3260 — VERBATIM, exported)\n"
    buf = buf + "HexaVal hexa_extern_call(void* fn_ptr, HexaVal* hargs, int nargs, int ret_kind) {\n"
    buf = buf + "    int64_t cargs[14];  // extended for cblas_sgemm (14 args)\n"
    buf = buf + "    for (int i = 0; i < nargs && i < 14; i++) {\n"
    buf = buf + "        cargs[i] = hexa_ffi_marshal_arg(hargs[i]);\n"
    buf = buf + "    }\n"
    buf = buf + "    int64_t ret = hexa_call_extern_raw(fn_ptr, cargs, nargs);\n"
    buf = buf + "    switch (ret_kind) {\n"
    buf = buf + "        case 0:  return hexa_void();\n"
    buf = buf + "        case 1:  return hexa_int(ret);\n"
    buf = buf + "        case 2:  { union { int64_t i; double d; } u; u.i = ret; return hexa_float(u.d); }\n"
    buf = buf + "        case 3:  return hexa_bool(ret != 0);\n"
    buf = buf + "        case 4:  return hexa_int(ret); // pointer as int\n"
    buf = buf + "        default: return hexa_int(ret);\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "\n"
    buf = buf + "// ── G3: Typed extern call with float support ─────────────\n"
    buf = buf + "// float_mask is a bitmask: bit i set means arg i is a double (SIMD register).\n"
    buf = buf + "// This generates correct ARM64 calling convention for mixed int/float args.\n"
    buf = buf + "// Supports up to 14 args (covers vDSP_mmul 9-arg, cblas_sgemm 14-arg).\n"
    buf = buf + "// hexa_extern_call_typed (frozen runtime.c L3281 — VERBATIM, exported)\n"
    buf = buf + "HexaVal hexa_extern_call_typed(void* fn_ptr, HexaVal* hargs, int nargs, int ret_kind, int float_mask) {\n"
    buf = buf + "    // Extract values: doubles from .f, integers from .i\n"
    buf = buf + "    double  fv[14]; // float values\n"
    buf = buf + "    int64_t iv[14]; // int values\n"
    buf = buf + "    for (int i = 0; i < nargs && i < 14; i++) {\n"
    buf = buf + "        if (float_mask & (1 << i)) {\n"
    buf = buf + "            fv[i] = HX_IS_FLOAT(hargs[i]) ? HX_FLOAT(hargs[i]) : (double)HX_INT(hargs[i]);\n"
    buf = buf + "        } else {\n"
    buf = buf + "            iv[i] = hexa_ffi_marshal_arg(hargs[i]);\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    // Dispatch by nargs and float_mask pattern\n"
    buf = buf + "    // Common patterns: all-int (mask=0), trailing floats, all-float\n"
    buf = buf + "    // For arbitrary patterns, we use a switch on nargs with typed casts.\n"
    buf = buf + "    // The C compiler handles register allocation from the typed call.\n"
    buf = buf + "\n"
    buf = buf + "    // Helper macros for arg extraction\n"
    buf = buf + "    #define A(i) ((float_mask & (1<<(i))) ? 0 : iv[i])\n"
    buf = buf + "    #define F(i) ((float_mask & (1<<(i))) ? fv[i] : 0.0)\n"
    buf = buf + "    #define IS_F(i) (float_mask & (1<<(i)))\n"
    buf = buf + "\n"
    buf = buf + "    int64_t reti = 0;\n"
    buf = buf + "    double  retf = 0.0;\n"
    buf = buf + "    int ret_is_float = (ret_kind == 2);\n"
    buf = buf + "\n"
    buf = buf + "    // For each arity, generate all-int call if mask==0, else use typed dispatch\n"
    buf = buf + "    switch (nargs) {\n"
    buf = buf + "        case 0: {\n"
    buf = buf + "            if (ret_is_float) { retf = ((double(*)(void))fn_ptr)(); }\n"
    buf = buf + "            else { reti = ((int64_t(*)(void))fn_ptr)(); }\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "        case 1: {\n"
    buf = buf + "            if (IS_F(0)) {\n"
    buf = buf + "                if (ret_is_float) retf = ((double(*)(double))fn_ptr)(fv[0]);\n"
    buf = buf + "                else reti = ((int64_t(*)(double))fn_ptr)(fv[0]);\n"
    buf = buf + "            } else {\n"
    buf = buf + "                if (ret_is_float) retf = ((double(*)(int64_t))fn_ptr)(iv[0]);\n"
    buf = buf + "                else reti = ((int64_t(*)(int64_t))fn_ptr)(iv[0]);\n"
    buf = buf + "            }\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "        case 2: {\n"
    buf = buf + "            // 4 combinations for 2 args\n"
    buf = buf + "            int p = (IS_F(0)?2:0) | (IS_F(1)?1:0);\n"
    buf = buf + "            switch (p) {\n"
    buf = buf + "                case 0: // ii\n"
    buf = buf + "                    if (ret_is_float) retf = ((double(*)(int64_t,int64_t))fn_ptr)(iv[0],iv[1]);\n"
    buf = buf + "                    else reti = ((int64_t(*)(int64_t,int64_t))fn_ptr)(iv[0],iv[1]);\n"
    buf = buf + "                    break;\n"
    buf = buf + "                case 1: // if\n"
    buf = buf + "                    if (ret_is_float) retf = ((double(*)(int64_t,double))fn_ptr)(iv[0],fv[1]);\n"
    buf = buf + "                    else reti = ((int64_t(*)(int64_t,double))fn_ptr)(iv[0],fv[1]);\n"
    buf = buf + "                    break;\n"
    buf = buf + "                case 2: // fi\n"
    buf = buf + "                    if (ret_is_float) retf = ((double(*)(double,int64_t))fn_ptr)(fv[0],iv[1]);\n"
    buf = buf + "                    else reti = ((int64_t(*)(double,int64_t))fn_ptr)(fv[0],iv[1]);\n"
    buf = buf + "                    break;\n"
    buf = buf + "                case 3: // ff\n"
    buf = buf + "                    if (ret_is_float) retf = ((double(*)(double,double))fn_ptr)(fv[0],fv[1]);\n"
    buf = buf + "                    else reti = ((int64_t(*)(double,double))fn_ptr)(fv[0],fv[1]);\n"
    buf = buf + "                    break;\n"
    buf = buf + "            }\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "        case 3: {\n"
    buf = buf + "            // 3 args — dispatch 2^3 = 8 patterns for int/float lane mapping.\n"
    buf = buf + "            int p = (IS_F(0)?4:0) | (IS_F(1)?2:0) | (IS_F(2)?1:0);\n"
    buf = buf + "            switch (p) {\n"
    buf = buf + "                case 0: if (ret_is_float) retf = ((double(*)(int64_t,int64_t,int64_t))fn_ptr)(iv[0],iv[1],iv[2]); else reti = ((int64_t(*)(int64_t,int64_t,int64_t))fn_ptr)(iv[0],iv[1],iv[2]); break;\n"
    buf = buf + "                case 1: if (ret_is_float) retf = ((double(*)(int64_t,int64_t,double))fn_ptr)(iv[0],iv[1],fv[2]); else reti = ((int64_t(*)(int64_t,int64_t,double))fn_ptr)(iv[0],iv[1],fv[2]); break;\n"
    buf = buf + "                case 2: if (ret_is_float) retf = ((double(*)(int64_t,double,int64_t))fn_ptr)(iv[0],fv[1],iv[2]); else reti = ((int64_t(*)(int64_t,double,int64_t))fn_ptr)(iv[0],fv[1],iv[2]); break;\n"
    buf = buf + "                case 3: if (ret_is_float) retf = ((double(*)(int64_t,double,double))fn_ptr)(iv[0],fv[1],fv[2]); else reti = ((int64_t(*)(int64_t,double,double))fn_ptr)(iv[0],fv[1],fv[2]); break;\n"
    buf = buf + "                case 4: if (ret_is_float) retf = ((double(*)(double,int64_t,int64_t))fn_ptr)(fv[0],iv[1],iv[2]); else reti = ((int64_t(*)(double,int64_t,int64_t))fn_ptr)(fv[0],iv[1],iv[2]); break;\n"
    buf = buf + "                case 5: if (ret_is_float) retf = ((double(*)(double,int64_t,double))fn_ptr)(fv[0],iv[1],fv[2]); else reti = ((int64_t(*)(double,int64_t,double))fn_ptr)(fv[0],iv[1],fv[2]); break;\n"
    buf = buf + "                case 6: if (ret_is_float) retf = ((double(*)(double,double,int64_t))fn_ptr)(fv[0],fv[1],iv[2]); else reti = ((int64_t(*)(double,double,int64_t))fn_ptr)(fv[0],fv[1],iv[2]); break;\n"
    buf = buf + "                case 7: if (ret_is_float) retf = ((double(*)(double,double,double))fn_ptr)(fv[0],fv[1],fv[2]); else reti = ((int64_t(*)(double,double,double))fn_ptr)(fv[0],fv[1],fv[2]); break;\n"
    buf = buf + "            }\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "        case 4: {\n"
    buf = buf + "            // 4 args — only handle common trailing-float patterns explicitly.\n"
    buf = buf + "            int p = (IS_F(0)?8:0) | (IS_F(1)?4:0) | (IS_F(2)?2:0) | (IS_F(3)?1:0);\n"
    buf = buf + "            if (p == 0) {\n"
    buf = buf + "                if (ret_is_float) retf = ((double(*)(int64_t,int64_t,int64_t,int64_t))fn_ptr)(iv[0],iv[1],iv[2],iv[3]);\n"
    buf = buf + "                else reti = ((int64_t(*)(int64_t,int64_t,int64_t,int64_t))fn_ptr)(iv[0],iv[1],iv[2],iv[3]);\n"
    buf = buf + "            } else if (p == 1) { // iiif\n"
    buf = buf + "                if (ret_is_float) retf = ((double(*)(int64_t,int64_t,int64_t,double))fn_ptr)(iv[0],iv[1],iv[2],fv[3]);\n"
    buf = buf + "                else reti = ((int64_t(*)(int64_t,int64_t,int64_t,double))fn_ptr)(iv[0],iv[1],iv[2],fv[3]);\n"
    buf = buf + "            } else {\n"
    buf = buf + "                fprintf(stderr, \"[hexa-ffi] unsupported 4-arg float pattern p=%d\\n\", p);\n"
    buf = buf + "                reti = 0;\n"
    buf = buf + "            }\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "        case 5: {\n"
    buf = buf + "            // 5 args — hxlayer_rmsnorm_silu(N:int, out:*, x:*, g:*, eps:f32)\n"
    buf = buf + "            // is the driving case: (int,int,int,int,float) = p==1.\n"
    buf = buf + "            int p = (IS_F(0)?16:0) | (IS_F(1)?8:0) | (IS_F(2)?4:0) | (IS_F(3)?2:0) | (IS_F(4)?1:0);\n"
    buf = buf + "            if (p == 0) {\n"
    buf = buf + "                if (ret_is_float) retf = ((double(*)(int64_t,int64_t,int64_t,int64_t,int64_t))fn_ptr)(iv[0],iv[1],iv[2],iv[3],iv[4]);\n"
    buf = buf + "                else reti = ((int64_t(*)(int64_t,int64_t,int64_t,int64_t,int64_t))fn_ptr)(iv[0],iv[1],iv[2],iv[3],iv[4]);\n"
    buf = buf + "            } else if (p == 1) { // iiiif\n"
    buf = buf + "                if (ret_is_float) retf = ((double(*)(int64_t,int64_t,int64_t,int64_t,double))fn_ptr)(iv[0],iv[1],iv[2],iv[3],fv[4]);\n"
    buf = buf + "                else reti = ((int64_t(*)(int64_t,int64_t,int64_t,int64_t,double))fn_ptr)(iv[0],iv[1],iv[2],iv[3],fv[4]);\n"
    buf = buf + "            } else {\n"
    buf = buf + "                fprintf(stderr, \"[hexa-ffi] unsupported 5-arg float pattern p=%d\\n\", p);\n"
    buf = buf + "                reti = 0;\n"
    buf = buf + "            }\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "        case 6: {\n"
    buf = buf + "            // 6 args — cblas_saxpy(N, alpha, x, incx, y, incy)\n"
    buf = buf + "            if (float_mask == 0) {\n"
    buf = buf + "                reti = ((int64_t(*)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t))fn_ptr)(iv[0],iv[1],iv[2],iv[3],iv[4],iv[5]);\n"
    buf = buf + "            } else if (float_mask == 0x02) { // i f i i i i — cblas_saxpy(N,alpha,x,incx,y,incy)\n"
    buf = buf + "                ((void(*)(int64_t,double,int64_t,int64_t,int64_t,int64_t))fn_ptr)(iv[0],fv[1],iv[2],iv[3],iv[4],iv[5]);\n"
    buf = buf + "                reti = 0;\n"
    buf = buf + "            } else {\n"
    buf = buf + "                reti = hexa_call_extern_raw(fn_ptr, iv, nargs);\n"
    buf = buf + "            }\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "        case 7: {\n"
    buf = buf + "            // 7 args — vDSP_vadd/vmul(A,sA,B,sB,C,sC,N)\n"
    buf = buf + "            if (float_mask == 0) {\n"
    buf = buf + "                ((void(*)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t))fn_ptr)(iv[0],iv[1],iv[2],iv[3],iv[4],iv[5],iv[6]);\n"
    buf = buf + "                reti = 0;\n"
    buf = buf + "            } else {\n"
    buf = buf + "                reti = hexa_call_extern_raw(fn_ptr, iv, nargs);\n"
    buf = buf + "            }\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "        case 8: {\n"
    buf = buf + "            // 8 args\n"
    buf = buf + "            if (float_mask == 0) {\n"
    buf = buf + "                reti = ((int64_t(*)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t))fn_ptr)(iv[0],iv[1],iv[2],iv[3],iv[4],iv[5],iv[6],iv[7]);\n"
    buf = buf + "            } else {\n"
    buf = buf + "                reti = hexa_call_extern_raw(fn_ptr, iv, nargs);\n"
    buf = buf + "            }\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "        case 9: {\n"
    buf = buf + "            // 9 args — vDSP_mmul(A,sA,B,sB,C,sC,M,N,K)\n"
    buf = buf + "            if (float_mask == 0) {\n"
    buf = buf + "                ((void(*)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int64_t))fn_ptr)(iv[0],iv[1],iv[2],iv[3],iv[4],iv[5],iv[6],iv[7],iv[8]);\n"
    buf = buf + "                reti = 0;\n"
    buf = buf + "            } else {\n"
    buf = buf + "                reti = hexa_call_extern_raw(fn_ptr, iv, nargs);\n"
    buf = buf + "            }\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "        default: {\n"
    buf = buf + "            // 10-14 args: fall back to raw int dispatch (handles up to 14).\n"
    buf = buf + "            reti = hexa_call_extern_raw(fn_ptr, iv, nargs);\n"
    buf = buf + "            break;\n"
    buf = buf + "        }\n"
    buf = buf + "    }\n"
    buf = buf + "    #undef A\n"
    buf = buf + "    #undef F\n"
    buf = buf + "    #undef IS_F\n"
    buf = buf + "\n"
    buf = buf + "    switch (ret_kind) {\n"
    buf = buf + "        case 0:  return hexa_void();\n"
    buf = buf + "        case 1:  return hexa_int(reti);\n"
    buf = buf + "        case 2:  return hexa_float(retf);\n"
    buf = buf + "        case 3:  return hexa_bool(reti != 0);\n"
    buf = buf + "        case 4:  return hexa_int(reti);\n"
    buf = buf + "        default: return hexa_int(reti);\n"
    buf = buf + "    }\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_host_ffi_unwrap (frozen runtime.c L3506 — file-static, seed-local)\n"
    buf = buf + "static HexaVal hexa_host_ffi_unwrap(HexaVal v) {\n"
    buf = buf + "    if (!HX_IS_VALSTRUCT(v) || !HX_VS(v)) return v;\n"
    buf = buf + "    int64_t t = HX_VSF(v, tag_i);\n"
    buf = buf + "    // Hexa-level tag values: 0=INT, 1=FLOAT, 2=BOOL, 3=STR, 8=VOID, 13=POINTER\n"
    buf = buf + "    // See self/interpreter.hexa let TAG_* constants.\n"
    buf = buf + "    if (t == 0)  return hexa_int(HX_VSF(v, int_val));\n"
    buf = buf + "    if (t == 1)  return hexa_float(HX_VSF(v, float_val));\n"
    buf = buf + "    if (t == 2)  return hexa_bool(HX_VSF(v, bool_val));\n"
    buf = buf + "    if (t == 3)  return HX_VSF(v, str_val);       // already TAG_STR\n"
    buf = buf + "    if (t == 13) return hexa_int(HX_VSF(v, int_val));  // pointer → int ABI lane\n"
    buf = buf + "    return hexa_int(HX_VSF(v, int_val));\n"
    buf = buf + "}\n"
    buf = buf + "// ── carrier: g_ffi_overflow[14] >6-arg scratch buffer (frozen runtime.c L3556) ─\n"
    buf = buf + "static HexaVal g_ffi_overflow[14];\n"
    buf = buf + "// hexa_host_ffi_call_6 (frozen runtime.c L3568 — VERBATIM, exported)\n"
    buf = buf + "HexaVal hexa_host_ffi_call_6(\n"
    buf = buf + "    HexaVal fn_ptr, HexaVal nargs_v, HexaVal float_mask, HexaVal ret_kind,\n"
    buf = buf + "    HexaVal a0, HexaVal a1, HexaVal a2, HexaVal a3, HexaVal a4, HexaVal a5\n"
    buf = buf + ") {\n"
    buf = buf + "    HexaVal fp_v = hexa_host_ffi_unwrap(fn_ptr);\n"
    buf = buf + "    int64_t fp_raw = HX_IS_INT(fp_v) ? HX_INT(fp_v) : 0;\n"
    buf = buf + "\n"
    buf = buf + "    // Magic sentinel: store overflow args\n"
    buf = buf + "    if (fp_raw == -1) {\n"
    buf = buf + "        g_ffi_overflow[0] = hexa_host_ffi_unwrap(a0);\n"
    buf = buf + "        g_ffi_overflow[1] = hexa_host_ffi_unwrap(a1);\n"
    buf = buf + "        g_ffi_overflow[2] = hexa_host_ffi_unwrap(a2);\n"
    buf = buf + "        g_ffi_overflow[3] = hexa_host_ffi_unwrap(a3);\n"
    buf = buf + "        g_ffi_overflow[4] = hexa_host_ffi_unwrap(a4);\n"
    buf = buf + "        g_ffi_overflow[5] = hexa_host_ffi_unwrap(a5);\n"
    buf = buf + "        return hexa_int(0);\n"
    buf = buf + "    }\n"
    buf = buf + "    if (fp_raw == -2) {\n"
    buf = buf + "        g_ffi_overflow[6] = hexa_host_ffi_unwrap(a0);\n"
    buf = buf + "        g_ffi_overflow[7] = hexa_host_ffi_unwrap(a1);\n"
    buf = buf + "        return hexa_int(0);\n"
    buf = buf + "    }\n"
    buf = buf + "\n"
    buf = buf + "    void* fp = (fp_raw != 0) ? (void*)(uintptr_t)fp_raw : NULL;\n"
    buf = buf + "    if (!fp) return hexa_int(0);\n"
    buf = buf + "    HexaVal na_v = hexa_host_ffi_unwrap(nargs_v);\n"
    buf = buf + "    HexaVal rk_v = hexa_host_ffi_unwrap(ret_kind);\n"
    buf = buf + "    HexaVal fm_v = hexa_host_ffi_unwrap(float_mask);\n"
    buf = buf + "    int nargs = HX_IS_INT(na_v) ? (int)HX_INT(na_v) : 0;\n"
    buf = buf + "    int rk    = HX_IS_INT(rk_v) ? (int)HX_INT(rk_v) : 1;\n"
    buf = buf + "    int mask  = HX_IS_INT(fm_v) ? (int)HX_INT(fm_v) : 0;\n"
    buf = buf + "    if (nargs < 0) nargs = 0;\n"
    buf = buf + "    if (nargs > 14) nargs = 14;\n"
    buf = buf + "\n"
    buf = buf + "    // Build hargs: first 6 from direct params, 6+ from overflow buffer\n"
    buf = buf + "    HexaVal hargs[14];\n"
    buf = buf + "    hargs[0] = hexa_host_ffi_unwrap(a0);\n"
    buf = buf + "    hargs[1] = hexa_host_ffi_unwrap(a1);\n"
    buf = buf + "    hargs[2] = hexa_host_ffi_unwrap(a2);\n"
    buf = buf + "    hargs[3] = hexa_host_ffi_unwrap(a3);\n"
    buf = buf + "    hargs[4] = hexa_host_ffi_unwrap(a4);\n"
    buf = buf + "    hargs[5] = hexa_host_ffi_unwrap(a5);\n"
    buf = buf + "    for (int i = 6; i < nargs; i++) {\n"
    buf = buf + "        hargs[i] = g_ffi_overflow[i - 6];\n"
    buf = buf + "    }\n"
    buf = buf + "\n"
    buf = buf + "    HexaVal native_ret;\n"
    buf = buf + "    if (mask) {\n"
    buf = buf + "        native_ret = hexa_extern_call_typed(fp, hargs, nargs, rk, mask);\n"
    buf = buf + "    } else {\n"
    buf = buf + "        native_ret = hexa_extern_call(fp, hargs, nargs, rk);\n"
    buf = buf + "    }\n"
    buf = buf + "    // Wrap the native HexaVal (tag=TAG_INT / TAG_FLOAT / TAG_VOID / TAG_BOOL)\n"
    buf = buf + "    // into a hexa-level Val so the self-host interpreter can .tag/.int_val\n"
    buf = buf + "    // through it. Without this the interpreter reads garbage from the\n"
    buf = buf + "    // HexaVal-as-map fallback in hexa_map_get.\n"
    buf = buf + "    int64_t iv = 0;\n"
    buf = buf + "    double  fv = 0.0;\n"
    buf = buf + "    int bv = 0;\n"
    buf = buf + "    if (HX_IS_INT(native_ret))   iv = HX_INT(native_ret);\n"
    buf = buf + "    if (HX_IS_FLOAT(native_ret)) fv = HX_FLOAT(native_ret);\n"
    buf = buf + "    if (HX_IS_BOOL(native_ret))  bv = HX_BOOL(native_ret);\n"
    buf = buf + "    // Hexa-level tag constants: INT=0, FLOAT=1, BOOL=2, VOID=8.\n"
    buf = buf + "    int hexa_tag = 0;\n"
    buf = buf + "    if (rk == 2) hexa_tag = 1;\n"
    buf = buf + "    if (rk == 3) hexa_tag = 2;\n"
    buf = buf + "    if (rk == 0) hexa_tag = 8;\n"
    buf = buf + "    HexaVal empty_str = hexa_str(\"\");\n"
    buf = buf + "    return hexa_valstruct_new_v(\n"
    buf = buf + "        hexa_int(hexa_tag), hexa_int(iv), hexa_float(fv), hexa_bool(bv),\n"
    buf = buf + "        empty_str, empty_str, empty_str,\n"
    buf = buf + "        empty_str, empty_str, empty_str,\n"
    buf = buf + "        empty_str, empty_str);\n"
    buf = buf + "}\n"
    buf = buf + "// ════════════════════════════════════════════════════════════════\n"
    buf = buf + "// zero-c r29 (ING #29) — CARRIER-EMIT bare-wrapper bulk harvest (52 bodies)\n"
    buf = buf + "// 52 HI-tier dispatch/FFI/term/ad/farr/forge bare-wrappers ported VERBATIM\n"
    buf = buf + "// from the frozen runtime.c (151c52c8) #else live branch. Each body is a\n"
