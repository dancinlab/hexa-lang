    buf = buf + "\n"
    buf = buf + "// -- r20 math-leaf lane (frozen runtime.c PROPER) -- ING #35 r20 (summer) --\n"
    buf = buf + "// Batch 6: array-elementwise math / tensor leaves ported VERBATIM from frozen\n"
