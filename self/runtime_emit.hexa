    buf = buf + "//  epoch seed-local static duplication. The two bodies compile the SHIPPING\n"
    buf = buf + "//  branch (HEXA_HAS_HEXA_RT_STDLIB defined → rt_array_alloc/zeros_float\n"
    buf = buf + "//  delegate, the byte-faithful production path); rt_array_* are stdlib bodies\n"
    buf = buf + "//  (stdlib/runtime/numeric.hexa) supplied-outside-residual at the final link.\n"
    buf = buf + "//  The carrier is byte-faithful to runtime_core.c: _hx_stats_on lazily probes\n"
    buf = buf + "//  HEXA_ALLOC_STATS (opt-in diagnostic) and registers an atexit dump; the dump\n"
    buf = buf + "//  here prints only the array_new counter THIS seed maintains (the diagnostic\n"
    buf = buf + "//  is drop-path-only stderr — never a byteeq surface; the DEFAULT/shipping\n"
    buf = buf + "//  build never compiles this seed → byte-identical OFF). net DROP_RESIDUAL: -2.\n"
    buf = buf + "extern char* hxlcl_getenv(const char* name);\n"
    buf = buf + "extern int   hxlcl_atexit(void (*fn)(void));\n"
    buf = buf + "extern HexaVal rt_array_alloc(HexaVal n);\n"
    buf = buf + "extern HexaVal rt_array_zeros_float(HexaVal n);\n"
    buf = buf + "// ── carrier: _hx_stats counter + guard (frozen runtime_core.c statics) ─\n"
    buf = buf + "static int64_t _hx_r26_stats_array_new = 0;\n"
    buf = buf + "static int     _hx_r26_stats_enabled   = -1;   // lazy env probe (frozen: -1)\n"
    buf = buf + "static void _hx_r26_stats_dump(void) {\n"
    buf = buf + "    fprintf(stderr, \"[HEXA_ALLOC_STATS] array_new=%lld\\n\",\n"
    buf = buf + "            (long long)_hx_r26_stats_array_new);\n"
    buf = buf + "}\n"
    buf = buf + "static int _hx_stats_on(void) {\n"
    buf = buf + "    if (_hx_r26_stats_enabled < 0) {\n"
    buf = buf + "        const char* e = hxlcl_getenv(\"HEXA_ALLOC_STATS\");\n"
    buf = buf + "        _hx_r26_stats_enabled = (e && e[0] && e[0] != '0') ? 1 : 0;\n"
    buf = buf + "        if (_hx_r26_stats_enabled) hxlcl_atexit(_hx_r26_stats_dump);\n"
    buf = buf + "    }\n"
    buf = buf + "    return _hx_r26_stats_enabled;\n"
    buf = buf + "}\n"
    buf = buf + "// hexa_array_zeros_float (frozen runtime.c L5041 — HEXA_HAS_HEXA_RT_STDLIB branch)\n"
    buf = buf + "HexaVal hexa_array_zeros_float(HexaVal nv) {\n"
