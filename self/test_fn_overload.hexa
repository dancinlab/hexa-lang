// test_fn_overload — arity-based function overloading (opt-in slice).
//
// REQUIRES the self-host transpile/native build with HEXA_FN_OVERLOAD=1.
// Under the DEFAULT build (flag unset) the second `add` is the historical
// first-wins drop, so this file is GATED to the overload-enabled lane and is
// NOT part of the default byteeq corpus (the flag changes no DEFAULT bytes —
// see state/rfc_function_overloading.md "byteeq-safe by construction").
//
// Build: HEXA_FN_OVERLOAD=1 hexa build self/test_fn_overload.hexa && ./a.out
// Expected stdout:
//   add2=7
//   add3=12
//   greet=hi:ada
//   PASS

fn add(a, b) {
    return a + b
}

fn add(a, b, c) {
    return a + b + c
}

fn greet(name) {
    return "hi:" + name
}

fn main() {
    let r2 = add(3, 4)        // -> add_hxov2
    let r3 = add(3, 4, 5)     // -> add_hxov3
    println("add2=" + str(r2))
    println("add3=" + str(r3))
    println("greet=" + greet("ada"))   // single decl -> bare `greet`
    if r2 == 7 && r3 == 12 {
        println("PASS")
    } else {
        println("FAIL")
    }
}
