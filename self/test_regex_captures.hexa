// self/test_regex_captures.hexa -- capture-span extraction + variable-width
// lookbehind self-test (lane ④). @ci_gate
//
// Exercises the new capture surface on stdlib/regex/thompson.hexa:
//   regex_compile_captures / regex_captures / regex_cap_count /
//   regex_cap_span / regex_cap_text
// and the BOUNDED variable-width lookbehind extension in
// stdlib/regex/backtrack.hexa (PCRE2/.NET/Python-`regex` semantics: a fixed OR
// bounded-variable inner is allowed; only an unbounded inner * + {n,} still
// fails the compile).
// Every expected value is hand-computed in the comment beside the case.
// Run locally:  hexa run self/test_regex_captures.hexa   (from repo root)
//
// DEV NOTE: `hexa run` caches a .o keyed on sha(ENTRY source) only -- edits to
// the imported stdlib/regex/*.hexa are NOT seen for an UNCHANGED entry source.
// Touch this file (or clear the precompile dir) to force a rebuild while
// iterating. CI builds fresh.

use "stdlib/regex/thompson"

let mut pass_count = 0
let mut total_count = 0
let mut first_fail = ""

fn ok(name: string, cond: bool) {
    total_count = total_count + 1
    if cond {
        pass_count = pass_count + 1
    } else {
        if first_fail == "" { first_fail = name }
        println("FAIL " + name)
    }
}

fn eq(name: string, got: string, want: string) {
    total_count = total_count + 1
    if got == want {
        pass_count = pass_count + 1
    } else {
        if first_fail == "" { first_fail = name }
        println("FAIL " + name + " got=[" + got + "] want=[" + want + "]")
    }
}

// Render an ovector as "s0,e0|s1,e1|..." with unset groups as "-,-".
fn caps_str(caps: [int]) -> string {
    if len(caps) == 0 { return "" }
    let mut out = ""
    let n = regex_cap_count(caps)
    let mut i = 0
    while i < n {
        if i > 0 { out = out + "|" }
        let sp = regex_cap_span(caps, i)
        if len(sp) == 0 { out = out + "-,-" }
        else { out = out + to_string(sp[0]) + "," + to_string(sp[1]) }
        i = i + 1
    }
    return out
}

// Compile (capturing engine) then render the ovector for the leftmost match.
fn cap(pat: string, s: string) -> string {
    let re = regex_compile_captures(pat)
    return caps_str(regex_captures(re, s))
}

// Compile then search to "start,end" / "" (auto-dispatch engine).
fn srch(pat: string, s: string) -> string {
    let re = regex_compile(pat)
    let sp = regex_search(re, s)
    if len(sp) == 0 { return "" }
    return to_string(sp[0]) + "," + to_string(sp[1])
}

fn main() {
    // ── capture-span extraction (capturing backtrack engine) ────────────────
    // (\d+)-(\d+) on "12-345": g0="12-345"@0..6, g1="12"@0..2, g2="345"@3..6
    eq("cap two groups", cap("(\\d+)-(\\d+)", "12-345"), "0,6|0,2|3,6")

    // nested groups ((a)(b)) on "ab": g0@0..2, g1@0..2, g2="a"@0..1, g3="b"@1..2
    eq("cap nested", cap("((a)(b))", "ab"), "0,2|0,2|0,1|1,2")

    // optional unset group (a)(b)?(c) on "ac": g2 'b' unset -> "-,-"
    // g0="ac"@0..2, g1="a"@0..1, g2=unset, g3="c"@1..2
    eq("cap unset opt", cap("(a)(b)?(c)", "ac"), "0,2|0,1|-,-|1,2")

    // group text extraction
    let re_t = regex_compile_captures("(\\w+)@(\\w+)")
    let ct = regex_captures(re_t, "alice@host")
    eq("cap_text g0", regex_cap_text(ct, "alice@host", 0), "alice@host")
    eq("cap_text g1", regex_cap_text(ct, "alice@host", 1), "alice")
    eq("cap_text g2", regex_cap_text(ct, "alice@host", 2), "host")
    eq("cap_text oob", regex_cap_text(ct, "alice@host", 5), "")     // out of range -> ""
    ok("cap_count 3",   regex_cap_count(ct) == 3)                   // g0 + 2 groups

    // backreference + capture spans: (\w+)\s\1 on "go go stop"
    // g0="go go"@0..5, g1="go"@0..2
    eq("cap backref", cap("(\\w+)\\s\\1", "go go stop"), "0,5|0,2")

    // no match -> empty ovector
    eq("cap no match", cap("(\\d+)x", "abc"), "")

    // group 0 from the LINEAR Thompson engine (no sub-groups): [0-9]+ on "ab12"
    let re_th = regex_compile("[0-9]+")
    let cth = regex_captures(re_th, "ab12")
    eq("cap thompson g0", caps_str(cth), "2,4")
    ok("cap thompson count1", regex_cap_count(cth) == 1)           // group 0 only

    // ── variable-width (BOUNDED) lookbehind — the new extension ─────────────
    // (?<=ab?)c : inner ab? min-width 1, max-width 2 (bounded) -> valid.
    ok("vlb compiles",  regex_valid(regex_compile("(?<=ab?)c")))    // was rejected pre-lane
    eq("vlb len2",      srch("(?<=ab?)c", "abc"), "2,3")           // 'c'@2 behind "ab"
    eq("vlb len1",      srch("(?<=ab?)c", "ac"),  "1,2")           // 'c'@1 behind "a"
    eq("vlb miss",      srch("(?<=ab?)c", "xc"),  "")              // 'x' not a/ab behind

    // alternation of DIFFERENT widths: (?<=foo|ba)x  min 2, max 3 (bounded)
    ok("alt vlb compiles", regex_valid(regex_compile("(?<=foo|ba)x")))
    eq("alt vlb w3",    srch("(?<=foo|ba)x", "foox"), "3,4")       // behind "foo"
    eq("alt vlb w2",    srch("(?<=foo|ba)x", "bax"),  "2,3")       // behind "ba"

    // counted bounded {1,3}: (?<=a{1,3})b  valid; matches with 1..3 a's behind
    ok("count vlb compiles", regex_valid(regex_compile("(?<=a{1,3})b")))
    eq("count vlb 3a",  srch("(?<=a{1,3})b", "aaab"), "3,4")
    eq("count vlb 1a",  srch("(?<=a{1,3})b", "ab"),   "1,2")

    // negative variable-width lookbehind: (?<!ab?)c
    eq("neg vlb pass",  srch("(?<!ab?)c", "xc"), "1,2")           // 'x' behind -> assert ok
    eq("neg vlb block", srch("(?<!ab?)c", "ac"), "")             // 'a' behind -> blocked

    // UNBOUNDED inner still REJECTED (regression — variable != unbounded)
    ok("unbounded + reject", regex_valid(regex_compile("(?<=a+)b")) == false)
    ok("unbounded * reject", regex_valid(regex_compile("(?<=a*)b")) == false)
    ok("unbounded {n,} rej", regex_valid(regex_compile("(?<=a{2,})b")) == false)

    // fixed-width lookbehind unchanged (regression)
    eq("fixed lb",      srch("(?<=@)\\w+", "hi @user"), "4,8")

    println("PASS " + to_string(pass_count) + "/" + to_string(total_count))
    if first_fail != "" {
        println("first fail: " + first_fail)
        exit(1)
    }
}
