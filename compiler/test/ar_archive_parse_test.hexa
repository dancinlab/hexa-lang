// compiler/test/ar_archive_parse_test.hexa
//
// RFC 063 § P3 round-3 Stage 2 — hermetic GNU-ar parse test for
// parse_ar_archive. NO clang / ar / pool: hand-builds a tiny in-memory GNU
// ar byte array ([Int]) = 8-byte magic + FOUR members —
//   "/"          armap symbol index   (must be SKIPPED)
//   "//"         long-name string tbl (kept for /N resolve, not a member)
//   "short.o/"   a short name         (trailing '/' stripped)
//   "/0"         a long-name ref      (resolved via the // table @ off 0)
// then parses it and asserts member (name, size, data_off).
//
// Run:  hexa run compiler/test/ar_archive_parse_test.hexa
//       (pure in-memory — no out dir / disk I/O; imports mirror the Stage-1
//        roundtrip test because elf_x86_64.hexa has no imports of its own and
//        references LModule/LOperand from lir.hexa.)

import "../ir/lir.hexa"
import "../emit/macho_arm64.hexa"
import "../emit/elf_x86_64.hexa"      // parse_ar_archive / ArMember (under test)

let mut _fails = 0
fn _check(cond: bool, msg: string) {
    if cond { println("  ok   " + msg) }
    else    { println("  FAIL " + msg); _fails = _fails + 1 }
}

// ── little ar-byte builders (build the fixture + stamp its sizes) ──
fn _p_ascii(arr: [Int], s: string) {
    let mut i = 0
    while i < len(s) { arr.push(char_code(s, i) & 0xff); i = i + 1 }
}
fn _p_field(arr: [Int], s: string, width: Int) {
    _p_ascii(arr, s)
    let mut i = len(s)
    while i < width { arr.push(0x20); i = i + 1 }        // ASCII-space pad
}
fn _p_member(arr: [Int], name: string, data: string) {
    _p_field(arr, name, 16)                              // name[0:16]
    _p_field(arr, "0", 12)                               // mtime[16:28]
    _p_field(arr, "0", 6)                                // uid[28:34]
    _p_field(arr, "0", 6)                                // gid[34:40]
    _p_field(arr, "644", 8)                              // mode[40:48]
    _p_field(arr, to_string(len(data)), 10)              // size[48:58]
    arr.push(0x60); arr.push(0x0a)                       // magic "`\n" [58:60]
    _p_ascii(arr, data)                                  // member data
    if (len(data) & 1) == 1 { arr.push(0x0a) }           // even-length '\n' pad
}

fn main() {
    let ar: [Int] = []
    _p_ascii(ar, "!<arch>\n")                            // 8-byte GNU ar magic

    _p_member(ar, "/", "IDX!")                           // armap — SKIP (4 bytes)
    _p_member(ar, "//", "this_is_a_long_name.o/\n")      // long-name table @ off 0
    _p_member(ar, "short.o/", "WXYZ")                    // short name (4 bytes)
    _p_member(ar, "/0", "hi")                            // long ref → // table off 0

    let ms = parse_ar_archive(ar)

    println("parse_ar_archive:")
    _check(len(ms) == 2, "member count 2 (armap + //-table excluded) got " + to_string(len(ms)))
    if len(ms) == 2 {
        _check(ms[0].name == "short.o", "sym[0] short name stripped '" + ms[0].name + "'")
        _check(ms[0].size == 4,         "sym[0] size 4 got " + to_string(ms[0].size))
        _check((ar[ms[0].data_off] & 0xff) == char_code("W", 0), "sym[0] data_off points at 'W'")
        _check(ms[1].name == "this_is_a_long_name.o", "sym[1] long name resolved '" + ms[1].name + "'")
        _check(ms[1].size == 2,         "sym[1] size 2 got " + to_string(ms[1].size))
        _check((ar[ms[1].data_off] & 0xff) == char_code("h", 0), "sym[1] data_off points at 'h'")
    }

    if _fails == 0 { println("AR-PARSE: ALL PASS") }
    else           { println("AR-PARSE: " + to_string(_fails) + " FAILURE(S)") }
}