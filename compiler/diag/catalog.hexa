        severity: Severity::Error,
        stage: "S3",
        template: "argument {pos} of `{name}`: expected `{expected}`, got `{actual}`",
        explain: "A call argument's static type does not match the corresponding parameter type. Fix the argument expression or change the call target.",
        fix_it_kind: FixItKind::None
    },
    DiagSpec {
        code: "HX3004",
        title: "return type mismatch",
        severity: Severity::Error,
        stage: "S3",
        template: "return type mismatch: function `{name}` returns `{expected}`, got `{actual}`",
        explain: "A `return` expression yields a value whose static type does not match the enclosing function's declared return type.",
        fix_it_kind: FixItKind::None
    },
    DiagSpec {
        code: "HX3010",
        title: "duplicate pub symbol across files",
        // Warning, not Error: the bind/typecheck pre-pass already
        // resolves the collision with a first-wins skip (so the
        // second-file copy is silently dropped from the typed env);
        // hard-erroring on top of that blocks codegen even when the
