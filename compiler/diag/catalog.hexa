        title: "undefined name",
        severity: Severity::Error,
        stage: "S2",
        template: "undefined name `{name}`",
        explain: "The identifier was used in an expression but no binding for it exists in any visible scope (function parameters, let bindings, top-level items, match arm patterns). Common causes: typo, missing import, name out of scope.",
        fix_it_kind: FixItKind::Replace
