// (ap) R5-r1 — wrong-enum match pattern REJECT (Rust E0308). Module:
//   enum Color { Red, Green }
//   enum Dir   { North, South }
//   fn f(c: Color) { match c { Dir::North -> 1, Color::Red -> 2, _ -> 0 } }
//   fn g(p: Point) { match p { Color::Red -> 1, _ -> 0 } }   — struct scrut control
// The `Dir::North` arm on a `Color` scrutinee → 1 HX3030 Error; `Color::Red`
// (same enum) + `_` clean; the struct-scrutinee `g` control fires 0 (Point is
// not a registered enum → under-reject). Param scrutinees carry `named:Enum`
// directly, pinning the recovery path (not the block-local `{}name` slot).
fn _build_case_hx3030_wrong_enum() -> Module {
    let f = "case_hx3030.hexa"
    // enum Color { Red, Green }
    let mut cvars = []
    cvars.push(_variant_unit("Red", f, 1, 13))
    cvars.push(_variant_unit("Green", f, 1, 18))
