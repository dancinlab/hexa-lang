    let diags_v = _run_case("(v) static-types r9d — struct-literal unknown field name (F4 warn/strict severity) (HEXA_STATIC_TYPES)", _build_case_static_types_r9d())
    let nv3014 = _count_code(diags_v, "HX3016")
    let nv3011 = _count_code(diags_v, "HX3011")
    let nv_warn = _count_code_sev(diags_v, "HX3016", "warning")
    let nv_err = _count_code_sev(diags_v, "HX3016", "error")
    if nv3014 != 1 || nv3011 != 0 || nv_err != 1 {
