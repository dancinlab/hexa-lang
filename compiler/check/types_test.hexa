    let diags_y = _run_case("(y) static-types F4 — HX3011 warn-first severity two-step (HEXA_STATIC_TYPES[/_STRICT])", _build_case_static_types())
    let ny = _count_code(diags_y, "HX3011")
    let ny_warn = _count_code_sev(diags_y, "HX3011", "warning")
    let ny_err = _count_code_sev(diags_y, "HX3011", "error")
    if ny != 1 || ny_err != 1 {
        println("  FAIL: case (y) expected 1 HX3011 as ERROR (REJECT, flagless real-source), got " + to_string(ny) + " HX3011 (" + to_string(ny_err) + " error/" + to_string(ny_warn) + " warn) (total=" + to_string(len(diags_y)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3011 as ERROR (flagless: real-source case_static.hexa → REJECT)")
    }

    // (z) Exhaustiveness severity gating — env-adaptive contract. Renumbered
    // HX3011→HX3018 on merge: static-types "mismatched types" owns HX3011 on
    // main, so the fatal non-exhaustive diag moved to the next free HX3018.
    //   both unset            → 0 HX3006 + 0 HX3018 (default byte-identity)
    //   HEXA_EXHAUSTIVE=1      → 1 HX3006 (warn), 0 HX3018
    //   HEXA_EXHAUSTIVE_FATAL=1 → 1 HX3018 (fatal error), 0 HX3006
    let fatal_on = env("HEXA_EXHAUSTIVE_FATAL") == "1"
    let warn_on = env("HEXA_EXHAUSTIVE") == "1"
    let diags_z = _run_case("(z) exhaustiveness severity gate (Color missing Blue)", _build_case_h())
    let z3006 = _count_code(diags_z, "HX3006")
    let z3018 = _count_code(diags_z, "HX3018")
    if fatal_on {
        if z3018 != 1 || z3006 != 0 {
            println("  FAIL: case (z) HEXA_EXHAUSTIVE_FATAL=1 expected 1 HX3018 + 0 HX3006, got " + to_string(z3018) + " HX3018 / " + to_string(z3006) + " HX3006")
            ok = false
        } else {
            println("  ok: 1 HX3018 (fatal) emitted under HEXA_EXHAUSTIVE_FATAL=1")
        }
    } else if warn_on {
        if z3006 != 1 || z3018 != 0 {
            println("  FAIL: case (z) HEXA_EXHAUSTIVE=1 expected 1 HX3006 + 0 HX3018, got " + to_string(z3006) + " HX3006 / " + to_string(z3018) + " HX3018")
            ok = false
        } else {
            println("  ok: 1 HX3006 (warn) emitted under HEXA_EXHAUSTIVE=1")
        }
    } else {
        if z3006 != 0 || z3018 != 0 {
            println("  FAIL: case (z) default build expected 0 HX3006 + 0 HX3018 (byte-identity), got " + to_string(z3006) + " HX3006 / " + to_string(z3018) + " HX3018")
            ok = false
        } else {
            println("  ok: 0 exhaustiveness diags on default build (byte-identity preserved)")
        }
    }

    // (aa) FLIP-2 fixture carve-out — contains-arm (compiler/test/…). Same
    // real-source-shaped HX3011 (`let x: i32 = "s"`) as case (y) but on a byte-eq
    // fixture path: STRICT-default keeps it WARNING (carve-out, non-fatal) while
    // explicit HEXA_STATIC_TYPES_STRICT=1 escalates to ERROR everywhere. This is
    // the release-integrity proof that the 147 fixture census hits stay warn-band
    // (build never breaks) under the FLIP-2 default.
    let diags_aa = _run_case("(aa) static-types FLIP-2 — fixture carve-out (compiler/test/ contains-arm)", _build_case_static_types_fixture())
    let naa = _count_code(diags_aa, "HX3011")
    let naa_warn = _count_code_sev(diags_aa, "HX3011", "warning")
    let naa_err = _count_code_sev(diags_aa, "HX3011", "error")
    if naa != 1 || naa_warn != 1 {
        println("  FAIL: case (aa) expected 1 HX3011 as WARNING (fixture carve-out, flagless), got " + to_string(naa) + " HX3011 (" + to_string(naa_err) + " error/" + to_string(naa_warn) + " warn) (total=" + to_string(len(diags_aa)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3011 as WARNING (flagless fixture carve-out: compiler/test/ path stays warn-band)")
    }

    // (ab) FLIP-2 fixture carve-out — suffix-arm (*_test.hexa). Same contract via
    // the other predicate arm (a `_test.hexa`-suffixed path, cwd-independent).
    let diags_ab = _run_case("(ab) static-types FLIP-2 — fixture carve-out (*_test.hexa suffix-arm)", _build_case_static_types_fixture_suffix())
    let nab = _count_code(diags_ab, "HX3011")
    let nab_warn = _count_code_sev(diags_ab, "HX3011", "warning")
    let nab_err = _count_code_sev(diags_ab, "HX3011", "error")
    if nab != 1 || nab_warn != 1 {
        println("  FAIL: case (ab) expected 1 HX3011 as WARNING (fixture carve-out, flagless), got " + to_string(nab) + " HX3011 (" + to_string(nab_err) + " error/" + to_string(nab_warn) + " warn) (total=" + to_string(len(diags_ab)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3011 as WARNING (flagless fixture carve-out: *_test.hexa suffix stays warn-band)")
    }

    // (ac) static-types segment(b) — HX3024 unary-minus non-numeric REJECT
    // (Rust E0600). Real source `fn u(s: string) { let x = -s ... }` → the
    // `-s` operand infers to string → 1 HX3024 in the ERROR band (REJECT via
    // _types_strict_for); the `-5` numeric and `!s` truthiness controls prove
    // no over-fire, and 0 HX3001 proves no binop cross-fire. Flagless: fires
    // unconditionally (always-on since FLIP-3).
    let diags_ac = _run_case("(ac) static-types segment(b) — unary `-s` non-numeric REJECT (HX3024)", _build_case_unop_neg())
    let nac = _count_code(diags_ac, "HX3024")
    let nac_err = _count_code_sev(diags_ac, "HX3024", "error")
    let nac_3001 = _count_code(diags_ac, "HX3001")
    if nac != 1 || nac_err != 1 || nac_3001 != 0 {
        println("  FAIL: case (ac) expected 1 HX3024 as ERROR (REJECT) + 0 HX3001 (flagless real-source; -5/!s clean), got " + to_string(nac) + " HX3024 (" + to_string(nac_err) + " error) / " + to_string(nac_3001) + " HX3001 (total=" + to_string(len(diags_ac)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3024 as ERROR (`-s` string REJECT; `-5` numeric + `!s` truthiness stay clean; no HX3001 cross-fire)")
    }

    // (ad) HX3024 fixture carve-out — identical AST on a byte-eq TEST-FIXTURE
    // path (compiler/test/…) → _types_strict_for() false → the HX3024 lands in
    // the WARNING band (the shipping/byte-eq path never breaks). Expect 1
    // HX3024 as WARNING.
    let diags_ad = _run_case("(ad) static-types segment(b) — HX3024 fixture carve-out (compiler/test/ contains-arm)", _build_case_unop_neg_fixture())
    let nad = _count_code(diags_ad, "HX3024")
    let nad_warn = _count_code_sev(diags_ad, "HX3024", "warning")
    if nad != 1 || nad_warn != 1 {
        println("  FAIL: case (ad) expected 1 HX3024 as WARNING (fixture carve-out, flagless), got " + to_string(nad) + " HX3024 (" + to_string(nad_warn) + " warn) (total=" + to_string(len(diags_ad)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3024 as WARNING (flagless fixture carve-out: compiler/test/ path stays warn-band)")
    }

    // (ae) segment(b) HX3003 coercion-faithfulness — call-arg _types_equal→
    // _types_assignable (Rust E0308 demand_coerce). take32(0) int-lit→i32 +
    // dynp(1) HexaVal wildcard now COERCE (0 HX3003); take32("s") + takef(1)
    // int-lit→f32 still REJECT. Expect 2 HX3003, 0 HX3002. Regression-lock.
    let diags_ae = _run_case("(ae) static-types segment(b) — call-arg coercion (int-lit→i32/HexaVal accept · str/f32 reject) (HX3003)", _build_case_coerce_arg())
    let nae = _count_code(diags_ae, "HX3003")
    let nae2 = _count_code(diags_ae, "HX3002")
    if nae != 2 || nae2 != 0 {
        println("  FAIL: case (ae) expected 2 HX3003 (take32(\"s\") + takef(1)) + 0 HX3002, got " + to_string(nae) + " HX3003 / " + to_string(nae2) + " HX3002 (total=" + to_string(len(diags_ae)) + ")")
        ok = false
    } else {
        println("  ok: 2 HX3003 (str→i32 + int-lit→f32 reject; take32(0)/dynp(1) coerce clean) — E0308 demand_coerce faithfulness")
    }

    // (af) segment(b) HX3005 coercion-faithfulness — match arm-body join
    // _types_equal→_types_assignable (like the if/else join). `match a { 1 -> a,
    // 2 -> "s", _ -> 3 }`: string arm REJECTs (stays), int-lit arm `3` coerces to
    // i32. Expect 1 HX3005 (pre-fix 2) + Error-severity (unbanded) + 0 HX3011.
    let diags_af = _run_case("(af) static-types segment(b) — match arm-body join coercion (int-lit→i32 coerce · string reject) (HX3005)", _build_case_hx3005_join_coerce())
    let naf = _count_code(diags_af, "HX3005")
    let naf_err = _count_code_sev(diags_af, "HX3005", "error")
    let naf_3011 = _count_code(diags_af, "HX3011")
    if naf != 1 || naf_err != 1 || naf_3011 != 0 {
        println("  FAIL: case (af) expected 1 HX3005 as ERROR (string arm; int-lit arm coerces) + 0 HX3011, got " + to_string(naf) + " HX3005 (" + to_string(naf_err) + " error) / " + to_string(naf_3011) + " HX3011 (total=" + to_string(len(diags_af)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3005 as ERROR (string arm reject; int-lit `3` coerces to i32) — match join E0308 demand_coerce faithfulness")
    }

    // (ag) segment(b) HX3005 match-join unit-permissive guard — arm body inferring
    // `unit` (unannotated-return call) suppressed, mirroring the if/else join.
    let diags_ag = _run_case("(ag) static-types segment(b) — match-join unit-permissive guard (unit arm suppressed) (HX3005)", _build_case_hx3005_join_unit())
    let nag = _count_code(diags_ag, "HX3005")
    if nag != 0 {
        println("  FAIL: case (ag) expected 0 HX3005 (unit arm suppressed by guard), got " + to_string(nag) + " (total=" + to_string(len(diags_ag)) + ")")
        ok = false
    } else {
        println("  ok: 0 HX3005 (unit-inferring arm `v()` suppressed by unit-permissive guard) — if/else-join parity")
    }

    // (ah) segment(b) Rung B — actual-`unit` permissive guard (return/assign/module-let).
    // return v() + g = v() + module-let W = v() suppressed; bare `return` still fires (E0069).
    let diags_ah = _run_case("(ah) static-types segment(b) — actual-unit permissive guard (return/assign/module-let · bare-return preserved) (HX3004/HX3001)", _build_case_actual_unit_guard())
    let nah_3004 = _count_code(diags_ah, "HX3004")
    let nah_3001 = _count_code(diags_ah, "HX3001")
    if nah_3004 != 1 || nah_3001 != 0 {
        println("  FAIL: case (ah) expected 1 HX3004 (bare return only; return v() suppressed) + 0 HX3001 (assign/module-let v() suppressed), got " + to_string(nah_3004) + " HX3004 / " + to_string(nah_3001) + " HX3001 (total=" + to_string(len(diags_ah)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3004 (bare `return` fires E0069; `return v()` suppressed) + 0 HX3001 (assign/module-let unit suppressed) — actual-unit guard parity")
    }

    // (ai) segment(b) HX3025 index-on-scalar REJECT (Rust E0608) — `n[0]` on a
    // scalar → Error; array/unknown base → silent (conservative under-reject).
    let diags_ai = _run_case("(ai) static-types segment(b) — index-on-scalar REJECT (n[0] scalar / xs[0] array clean / unk[0] silent) (HX3025)", _build_case_hx3025_index_scalar())
    let nai = _count_code(diags_ai, "HX3025")
    let nai_err = _count_code_sev(diags_ai, "HX3025", "error")
    if nai != 1 || nai_err != 1 {
        println("  FAIL: case (ai) expected 1 HX3025 as ERROR (n[0] scalar; xs[0] array + unk[0] unknown clean), got " + to_string(nai) + " HX3025 (" + to_string(nai_err) + " error) (total=" + to_string(len(diags_ai)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3025 as ERROR (scalar `n[0]` reject; array `xs[0]` + unknown `unk[0]` silent) — E0608 index-on-scalar")
    }

    // (aj) HX3025 fixture carve-out — identical AST on a *_test.hexa path → WARNING.
    let diags_aj = _run_case("(aj) static-types segment(b) — HX3025 fixture carve-out (*_test.hexa scalar index)", _build_case_hx3025_fixture())
    let naj = _count_code(diags_aj, "HX3025")
    let naj_warn = _count_code_sev(diags_aj, "HX3025", "warning")
    if naj != 1 || naj_warn != 1 {
        println("  FAIL: case (aj) expected 1 HX3025 as WARNING (fixture carve-out), got " + to_string(naj) + " HX3025 (" + to_string(naj_warn) + " warn) (total=" + to_string(len(diags_aj)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3025 as WARNING (flagless fixture carve-out: *_test.hexa path stays warn-band)")
    }

    println("")
    println("══════════════════════════════════════════════")
    if ok {
        println("PASS: all type-check cases match contract.")
    } else {
        println("FAIL: type-check contract not satisfied.")
    }
    println("══════════════════════════════════════════════")
    if !ok { exit(1) }
}
