// static-types r9a — Index/Field READ inference. Index READs need BOTH flags
// (element types only exist under the r7-prep structured lowering); Field
// READs need HEXA_STATIC_TYPES alone (the r5 side registry carries the
// declared field type). Two REJECT shapes + two matching controls:
//   struct Point { x: i32, y: i32 }
//   fn f(xs: [i64], p: Point) {
//       let n: string = xs[0]   // Index READ: i64 elem vs string → HX3011 (both flags)
//       let m: i64    = xs[1]   // matching control                → clean
//       let q: string = p.x     // Field READ: i32 vs string → HX3011 (HEXA_STATIC_TYPES)
//       let r: i32    = p.y     // matching control            → clean
//   }
// The rung adds NO new diagnostic site — the recovered element/field type
// feeds the EXISTING r2 let check (typed-let RHS soundness gates). Contract
// is three-way self-adapting: both flags ON → 2 HX3011; HEXA_STATIC_TYPES
// alone → 1 (only the Field rung fires; the Index base stays a string
// sentinel); default build → 0 (byteeq-neutral proof).
fn _build_case_static_types_r9a() -> Module {
    let f = "case_static_r9a.hexa"
    // struct Point { x: i32, y: i32 }
    let mut sfields = []
    sfields.push(_param("x", "i32", f, 1, 15))
    sfields.push(_param("y", "i32", f, 1, 23))
    let item_pt = _struct_item("Point", sfields, f, 1)
    // fn f(xs: [i64], p: Point) { … }
    let mut kids = []
    // let n: string = xs[0]   — Index READ element mismatch
    kids.push(_let_expr("n|string", _index_expr(_ident_expr("xs", f, 3, 21), _int_expr("0", f, 3, 24), f, 3, 23), f, 3, 5))
    // let m: i64 = xs[1]      — Index READ matching control
    kids.push(_let_expr("m|i64", _index_expr(_ident_expr("xs", f, 4, 18), _int_expr("1", f, 4, 21), f, 4, 20), f, 4, 5))
    // let q: string = p.x     — Field READ mismatch
    kids.push(_let_expr("q|string", _field_expr(_ident_expr("p", f, 5, 21), "x", f, 5, 23), f, 5, 5))
    // let r: i32 = p.y        — Field READ matching control
    kids.push(_let_expr("r|i32", _field_expr(_ident_expr("p", f, 6, 18), "y", f, 6, 20), f, 6, 5))
    let body = _block(kids, f, 2, 1)
    let mut fparams = []
    fparams.push(_array_param("xs", "i64", f, 2, 6))
    fparams.push(_param("p", "Point", f, 2, 17))
    let item_f = _fn_item("f", fparams, _empty_type_ref(), body, f, 2)
    let mut items = []
    items.push(item_pt)
    items.push(item_f)
    return Module { file: f, items: items, imports: [] }
}

// static-types r9b — fn-return array-element REJECT + element-literal
// coercion no-FP (HEXA_STATIC_TYPES=1 + HEXA_STATIC_TYPES_ARRAY_LOWER=1).
// One REJECT shape + one coercion control:
//   fn f() -> [i64] { return [1.5] }   // [f64] literal vs [i64] ret → HX3004 (×1)
//   fn g() -> [f32] { return [0.0] }   // element float-lit coerces  → clean (the
//                                       // r9b _types_assignable arm; without it
