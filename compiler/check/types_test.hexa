// ── (ba/bb/bc) static-types builtin-method-call RESULT inference ─────────────
// The last total inference hole: builtin-method-call results (`s.len()`,
// `xs.map(f)`, …) were 100% type-opaque (inferred unknown). The
// `_types_builtin_method_ret` table — mirrored EXACTLY from
// `self/codegen.hexa::gen2_method_builtin` — now types the receiver-INDEPENDENT
// MONOMORPHIC subset (len→i64, contains→bool, trim→string, …), so the KNOWN
// scalar flows into the already-shipped HX3011 typed-let rung; polymorphic /
// container / element-returning selectors (map/filter/fold/get/pop/find/…) stay
// unknown → no false diagnostics. FLIP-3 flagless (real=Error / *_test fixture=
// Warning via _types_strict_for); the assertions below are count-based and
// band-agnostic, matching the (h)/(i)/(j) HX3011 rungs.

// (ba) hz_method_ret_typed — `fn u(s: string) { let n: bool = s.len() }`:
// len()→i64 provably ≠ bool → exactly 1 HX3011 (E0308 typed-let mismatch).
fn _build_case_method_ret_typed() -> Module {
    let f = "case_method_ret_typed.hexa"
    let recv = _ident_expr("s", f, 2, 18)
    let call = _call_expr(_field_expr(recv, "len", f, 2, 20), [], f, 2, 20)
    let body = _block([_let_expr("n|bool", call, f, 2, 5)], f, 2, 1)
    let item_u = _fn_item("u", [_param("s", "string", f, 1, 6)], _empty_type_ref(), body, f, 1)
    let mut items = []
    items.push(item_u)
    return Module { file: f, items: items, imports: [] }
}

// (bb) fp_method_ret_ok — `fn u(s: string) { let n: i64 = s.len() }`:
// len()→i64 matches the i64 annotation → 0 HX3011 (false-positive guard: a
// correctly-typed builtin-method result must never over-reject).
