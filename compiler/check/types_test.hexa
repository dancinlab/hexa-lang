    let item_f = _fn_item("f", [], _named_type_ref("i64"), _block([ret_call], f, 2, 1), f, 2)
    // fn h() -> i64 { return }   — bare return (no children) → HX3004 (E0069, fires)
    let bare_ret = Expr { kind: ExprKind::Return, span: _span(f, 3, 15, 6), text: "", annotations: [], children: [], atlas_ref: _empty_atlas_ref() }
    let item_h = _fn_item("h", [], _named_type_ref("i64"), _block([bare_ret], f, 3, 1), f, 3)
    // fn a() { let g: i64 = 0  g = v() }   — assign unit → suppressed (0 HX3001)
    let let_g = Expr { kind: ExprKind::Let, span: _span(f, 4, 5, 3), text: "g|i64", annotations: [], children: [_int_expr("0", f, 4, 18)], atlas_ref: _empty_atlas_ref() }
    let asg = _assign_expr(_ident_expr("g", f, 5, 5), _call_expr(_ident_expr("v", f, 5, 9), [], f, 5, 9), f, 5, 7)
    let item_a = _fn_item("a", [], _empty_type_ref(), _block([let_g, asg], f, 4, 1), f, 4)
    // module let W: i64 = v()   — module-let unit → suppressed (0 HX3001)
    let item_w = Item { kind: ItemKind::Let, name: "W", span: _span(f, 6, 1, 1), annotations: [], params: [], return_type: _named_type_ref("i64"), body: _call_expr(_ident_expr("v", f, 6, 12), [], f, 6, 12), is_pub: false }
    let mut items = []
    items.push(item_v)
    items.push(item_f)
    items.push(item_h)
