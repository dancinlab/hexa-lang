    arms.push(_call_expr(_ident_expr("v", f, 4, 14), [], f, 4, 14))
    arms.push(_wildcard_expr(f, 5, 9))
    arms.push(_int_expr("3", f, 5, 14))
    let m = _match_expr(_ident_expr("c", f, 3, 11), arms, f, 3, 5)
    let mut fkids = []
    fkids.push(m)
    let mut fparams = []
    fparams.push(_param("c", "i64", f, 3, 6))
    let item_f = _fn_item("f", fparams, _empty_type_ref(), _block(fkids, f, 3, 1), f, 3)
    let mut items = []
    items.push(item_v)
    items.push(item_f)
    return Module { file: f, items: items, imports: [] }
}

// (ai) segment(b) HX3025 index-on-scalar REJECT (Rust E0608). `n[0]` on a KNOWN
// scalar (n: i64) → 1 HX3025 Error; `xs[0]` on `xs: [i64]` (array) → 0; `unk[0]`
// on an unknown ident → 0 (conservative under-reject). Expect 1 HX3025 (error).
fn _build_case_hx3025_index_scalar() -> Module {
    let f = "case_hx3025.hexa"
