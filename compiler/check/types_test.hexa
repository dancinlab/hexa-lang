    let item_g = _fn_item("g", pg, _named_type_ref("i64"), _block([gy, gr], f, 4, 1), f, 4)
    // fn h() { let z = unk[0] }   — unknown base → silent (under-reject)
    let hz = _let_expr("z", _index_expr(_ident_expr("unk", f, 8, 13), _int_expr("0", f, 8, 17), f, 8, 16), f, 8, 5)
    let item_h = _fn_item("h", [], _empty_type_ref(), _block([hz], f, 8, 1), f, 8)
    let mut items = []
    items.push(item_f)
    items.push(item_g)
    items.push(item_h)
    return Module { file: f, items: items, imports: [] }
}

