    // 1 -> a      first_t = i32 (typed param ident)
    arms.push(_int_expr("1", f, 3, 9))
    arms.push(_ident_expr("a", f, 3, 14))
    // 2 -> "s"    string body vs i32 → HX3005 (positive, must stay)
    arms.push(_int_expr("2", f, 4, 9))
    arms.push(_string_expr("s", f, 4, 14))
    // _ -> 3      int-lit body vs i32 → coerce clean (pre-fix: HX3005)
    arms.push(_wildcard_expr(f, 5, 9))
    arms.push(_int_expr("3", f, 5, 14))
    let m = _match_expr(_ident_expr("a", f, 2, 11), arms, f, 2, 5)
    let mut kids = []
    kids.push(m)
    let body = _block(kids, f, 2, 1)
    let mut fparams = []
    fparams.push(_param("a", "i32", f, 1, 6))
    let item_f = _fn_item("f", fparams, _empty_type_ref(), body, f, 1)
    let mut items = []
    items.push(item_f)
    return Module { file: f, items: items, imports: [] }
}

// (ag) segment(b) HX3005 match-join unit-permissive guard — an arm body that
// infers `unit` (unannotated-return call) must not error, mirroring the if/else
// join. `match c { 1 -> v(), _ -> 3 }` where `fn v()` has no return annotation
// → first_t=unit → guard suppresses. Expect 0 HX3005 (pre-guard: 1).
fn _build_case_hx3005_join_unit() -> Module {
    let f = "case_hx3005_unit.hexa"
