// (at) HEXA-OWN L2 rung B — use-after-move at field/index BASE or binop OPERAND
// (HEXA_OWN_LINT). @own `x` moved by `let a = x`, then read as x.f / x[0] / x + 1
// warns HX3012 ×3; live `y.g` (y never moved) stays clean.
fn _build_case_own_lint_rungB() -> Module {
    let f = "case_own_lint_rungB.hexa"
    let mut kids = []
    kids.push(_own_let_expr("x", _int_expr("5", f, 2, 18), f, 2, 5))
    kids.push(_let_expr("a", _ident_expr("x", f, 3, 13), f, 3, 5))
    kids.push(_field_expr(_ident_expr("x", f, 4, 5), "f", f, 4, 5))
    kids.push(_index_expr(_ident_expr("x", f, 5, 5), _int_expr("0", f, 5, 7), f, 5, 5))
    kids.push(_bin_expr("+", _ident_expr("x", f, 6, 5), _int_expr("1", f, 6, 9), f, 6, 5))
    kids.push(_own_let_expr("y", _int_expr("7", f, 7, 18), f, 7, 5))
    kids.push(_field_expr(_ident_expr("y", f, 8, 5), "g", f, 8, 5))
    let body = _block(kids, f, 2, 1)
    let item_main = _fn_item("main", [], _empty_type_ref(), body, f, 1)
    let mut items = []
    items.push(item_main)
    return Module { file: f, items: items, imports: [] }
}

