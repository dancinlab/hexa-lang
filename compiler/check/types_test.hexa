// (bu) ★ Lane-B builtin-method bool/f64 inference — `fn u(m: string, xs: [f64])`
// with has_key/contains_key → bool and mean → f64 (name-based, receiver-
// independent per _types_builtin_method_ret): the bool sinks + the f64 sink
// match (0), while a bool→i64 sink and an f64→string sink provably mismatch
// (2 HX3011). Locks the new bool/f64 method-ret arms. Self-contained module
// (types-test-hexa-1: no union with the main reset).
fn _build_case_builtin_bool_f64_infer() -> Module {
    let f = "case_bu.hexa"
    let hk_ok  = _call_expr(_field_expr(_ident_expr("m", f, 2, 20), "has_key", f, 2, 22), [_string_expr("k", f, 2, 30)], f, 2, 22)
    let ck_ok  = _call_expr(_field_expr(_ident_expr("m", f, 3, 20), "contains_key", f, 3, 22), [_string_expr("k", f, 3, 35)], f, 3, 22)
    let mn_ok  = _call_expr(_field_expr(_ident_expr("xs", f, 4, 18), "mean", f, 4, 21), [], f, 4, 21)
    let hk_bad = _call_expr(_field_expr(_ident_expr("m", f, 5, 20), "has_key", f, 5, 22), [_string_expr("k", f, 5, 30)], f, 5, 22)
    let mn_bad = _call_expr(_field_expr(_ident_expr("xs", f, 6, 22), "mean", f, 6, 25), [], f, 6, 25)
    let mut kids = []
    kids.push(_let_expr("ok1|bool", hk_ok, f, 2, 5))
    kids.push(_let_expr("ok2|bool", ck_ok, f, 3, 5))
    kids.push(_let_expr("ok3|f64", mn_ok, f, 4, 5))
    kids.push(_let_expr("bad1|i64", hk_bad, f, 5, 5))
    kids.push(_let_expr("bad2|string", mn_bad, f, 6, 5))
    let body = _block(kids, f, 2, 1)
    let mut params = []
    params.push(_param("m", "string", f, 1, 6))
    params.push(_array_param("xs", "f64", f, 1, 15))
    let item_u = _fn_item("u", params, _empty_type_ref(), body, f, 1)
    let mut items = []
    items.push(item_u)
    return Module { file: f, items: items, imports: [] }
}

fn _run_case(label: string, m: Module) -> array {
    println("")
    println("── " + label + " ──")
    println("  module: " + m.file + " (items=" + to_string(len(m.items)) + ")")
    let diags = type_check(m)
    println("  diagnostics: " + to_string(len(diags)))
    let mut i = 0
    while i < len(diags) {
        _print_diag(i, diags[i])
        i = i + 1
    }
    return diags
}

fn _has_code(diags: array, code: string) -> bool {
    let mut i = 0
    while i < len(diags) {
        let d = diags[i]
        if d.code == code { return true }
        i = i + 1
    }
    return false
}

fn _count_code(diags: array, code: string) -> i64 {
    let mut i = 0
    let mut n = 0
    while i < len(diags) {
        let d = diags[i]
        if d.code == code { n = n + 1 }
        i = i + 1
    }
    return n
}

// Count diagnostics matching BOTH a code and a severity band ("error" /
// "warning" / "note", via _sev_str). Used by the static-types F4 warn-first
// two-step tests: the same HX3011/HX3016 diagnostic must land in the Warning
// band under plain HEXA_STATIC_TYPES=1 and the Error band (REJECT) under
// HEXA_STATIC_TYPES_STRICT=1 — a count alone cannot tell them apart.
fn _count_code_sev(diags: array, code: string, sev: string) -> i64 {
    let mut i = 0
    let mut n = 0
    while i < len(diags) {
        let d = diags[i]
        if d.code == code && _sev_str(d.severity) == sev { n = n + 1 }
        i = i + 1
    }
    return n
}

fn main() {
    println("══════════════════════════════════════════════")
    println("  HEXA Compiler — Type/Domain Smoke Test (B3/S3+S4)")
    println("══════════════════════════════════════════════")

    let mut ok = true

    // (a) PASS
    let diags_a = _run_case("(a) PASS — add(1,2) signature matches", _build_case_a())
    if len(diags_a) != 0 {
        println("  FAIL: case (a) expected 0 diagnostics, got " + to_string(len(diags_a)))
        ok = false
    } else {
        println("  ok: 0 diagnostics")
    }

    // (b) HX3002
    let diags_b = _run_case("(b) FAIL HX3002 — add(1) wrong arity", _build_case_b())
    let nb = _count_code(diags_b, "HX3002")
    if nb != 1 {
        println("  FAIL: case (b) expected 1 HX3002, got " + to_string(nb) + " (total=" + to_string(len(diags_b)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3002 emitted")
    }

    // (c) HX3003
    let diags_c = _run_case("(c) FAIL HX3003 — add(1,\"hi\") arg type", _build_case_c())
    let nc = _count_code(diags_c, "HX3003")
    if nc != 1 {
        println("  FAIL: case (c) expected 1 HX3003, got " + to_string(nc) + " (total=" + to_string(len(diags_c)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3003 emitted")
    }

    // (d) HX3001
    let diags_d = _run_case("(d) FAIL HX3001 — 1 + true binop mismatch", _build_case_d())
    if !_has_code(diags_d, "HX3001") {
        println("  FAIL: case (d) expected at least one HX3001, got total=" + to_string(len(diags_d)))
        ok = false
    } else {
        println("  ok: HX3001 emitted")
    }

    // (e) HX3004
    let diags_e = _run_case("(e) FAIL HX3004 — fn pick()->Int returns string", _build_case_e())
    if !_has_code(diags_e, "HX3004") {
        println("  FAIL: case (e) expected at least one HX3004, got total=" + to_string(len(diags_e)))
        ok = false
    } else {
        println("  ok: HX3004 emitted")
    }

    // RFC-074 Phase 2.1 — (f) PASS: Event::Click(42, "hi") on enum E{Click(int, string)}
    let diags_f = _run_case("(f) PASS — Event::Click(42,\"hi\") element-type match", _build_case_f())
    let nf_2005 = _count_code(diags_f, "HX2005")
    let nf_2004 = _count_code(diags_f, "HX2004")
    if nf_2005 != 0 || nf_2004 != 0 {
        println("  FAIL: case (f) expected 0 HX2004 + 0 HX2005, got " + to_string(nf_2004) + " HX2004 / " + to_string(nf_2005) + " HX2005 (total=" + to_string(len(diags_f)) + ")")
        ok = false
    } else {
        println("  ok: 0 HX2004 / 0 HX2005 (element types match)")
    }

    // RFC-074 Phase 2.1 — (g) FAIL HX2005 ×2: Event::Click("hi", 42) — args swapped
    let diags_g = _run_case("(g) FAIL HX2005 ×2 — Event::Click(\"hi\",42) element-type swap", _build_case_g())
    let ng = _count_code(diags_g, "HX2005")
    if ng != 2 {
        println("  FAIL: case (g) expected 2 HX2005, got " + to_string(ng) + " (total=" + to_string(len(diags_g)) + ")")
        ok = false
    } else {
        println("  ok: 2 HX2005 emitted (per-slot positional)")
    }

    // (h) Wall A r1 — opt-in static-type let-mismatch (HEXA_STATIC_TYPES).
    // Self-adapting: under the flag a `let x:i32="s"` mismatch must REJECT
    // with HX3011; on the default build it must be ABSENT (byteeq-neutral
    // proof — zero new diagnostics when the flag is unset). The matching
    // `let y:i32=5` binding never trips HX3011 in either mode.
    let diags_h = _run_case("(h) static-types — let x:i32=\"s\" mismatch (HEXA_STATIC_TYPES)", _build_case_static_types())
    let nh = _count_code(diags_h, "HX3011")
    if nh != 1 {
        println("  FAIL: case (h) expected 1 HX3011 (flagless), got " + to_string(nh) + " (total=" + to_string(len(diags_h)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3011 emitted (REJECT; matching `let y:i32=5` stays clean)")
    }

    // (i) Wall A r2 — non-literal known-type RHS (ident / call). Under the
    // flag, `let b_ident:string = p` (p:i32 param) AND `let b_call:string =
    // g()` (g()->i32) each REJECT with HX3011 (2 total), while the matching
    // `let ok:i32 = g()` stays clean. On the default build → 0 (byteeq-
    // neutral). Same self-adapting contract as case (h), extended to the
    // ident/call rung.
    let diags_i = _run_case("(i) static-types r2 — ident/call known-type RHS mismatch (HEXA_STATIC_TYPES)", _build_case_static_types_r2())
    let ni = _count_code(diags_i, "HX3011")
    if ni != 2 {
        println("  FAIL: case (i) expected 2 HX3011 (ident+call, flagless), got " + to_string(ni) + " (total=" + to_string(len(diags_i)) + ")")
        ok = false
    } else {
        println("  ok: 2 HX3011 emitted (ident p:i32 + call g()->i32 vs string; matching i32=g() stays clean)")
    }

    // (j) Wall A r3 — decl/init split. Under the flag, a decl-only `let x:i32`
    // followed by `x = "s"` AND a `let y:string` followed by `y = 5` each
    // REJECT with HX3011 (2 total), while the matching `let z:i32; z = 7`
    // stays clean (int-literal coercion). On the default build → 0 (byteeq-
    // neutral). Same self-adapting contract as (h)/(i), extended to the
    // split-init assignment rung.
    let diags_j = _run_case("(j) static-types r3 — decl/init-split assign mismatch (HEXA_STATIC_TYPES)", _build_case_static_types_r3())
    let nj = _count_code(diags_j, "HX3011")
    if nj != 2 {
        println("  FAIL: case (j) expected 2 HX3011 (x=\"s\" + y=5, flagless), got " + to_string(nj) + " (total=" + to_string(len(diags_j)) + ")")
        ok = false
    } else {
        println("  ok: 2 HX3011 emitted (x:i32=\"s\" + y:string=5; matching z:i32=7 stays clean)")
    }

    // (k) Wall A r4 — array element-fit assign. Under the flag, a decl-only
    // `let a:[i32;4]` followed by `a[0] = "s"` AND a `let b:[string]` followed
    // by `b[1] = 9` each REJECT with HX3011 (2 total), while the matching
    // `let c:[i32;4]; c[2] = 7` stays clean (int-literal coercion). On the
    // default build → 0 (byteeq-neutral). Extends (j)'s decl/init-split
    // contract from the plain-ident assign to the array index place.
    let diags_k = _run_case("(k) static-types r4 — array element-fit assign mismatch (HEXA_STATIC_TYPES)", _build_case_static_types_r4())
    let nk = _count_code(diags_k, "HX3011")
    if nk != 2 {
        println("  FAIL: case (k) expected 2 HX3011 (a[0]=\"s\" + b[1]=9, flagless), got " + to_string(nk) + " (total=" + to_string(len(diags_k)) + ")")
        ok = false
    } else {
        println("  ok: 2 HX3011 emitted (a:[i32]=\"s\" + b:[string]=9; matching c:[i32][2]=7 stays clean)")
    }

    // (l) Wall A r5 — struct field-type assign. Under the flag, with
    // `struct Point { x: i32, y: i32 }`, a param receiver `p.x = "s"` AND a
    // block-local receiver `s.x = "z"` each REJECT with HX3011 (2 total), while
    // the matching `p.y = 7` stays clean (int-literal coercion). On the default
    // build → 0 (byteeq-neutral). Extends (k)'s element-fit contract from the
    // array place to the struct field place.
    let diags_l = _run_case("(l) static-types r5 — struct field-type assign mismatch (HEXA_STATIC_TYPES)", _build_case_static_types_r5())
    let nl = _count_code(diags_l, "HX3011")
    if nl != 2 {
        println("  FAIL: case (l) expected 2 HX3011 (p.x=\"s\" + s.x=\"z\", flagless), got " + to_string(nl) + " (total=" + to_string(len(diags_l)) + ")")
        ok = false
    } else {
        println("  ok: 2 HX3011 emitted (p.x:i32=\"s\" param + s.x:i32=\"z\" block-local; matching p.y:i32=7 stays clean)")
    }

    // (m) Wall A r6 — struct-literal field-init mismatch. Under the flag, with
    // `struct Point { x: i32, y: i32 }`, a construction `Point { x: "s", y: 7 }`
    // REJECTs the `x: "s"` (string ≠ i32) while `y: 7` coerces, and a second
    // `Point { x: true }` REJECTs `x: true` (bool ≠ i32) → 2 HX3011 total. On
    // the default build → 0 (byteeq-neutral). Extends (l)'s field-place-assign
    // contract to the struct-literal construction place — the LAST scope-
    // wireable rung (r7+ = generic/trait static-dispatch = measured ceiling).
    let diags_m = _run_case("(m) static-types r6 — struct-literal field-init mismatch (HEXA_STATIC_TYPES)", _build_case_static_types_r6())
    let nm = _count_code(diags_m, "HX3011")
    if nm != 2 {
        println("  FAIL: case (m) expected 2 HX3011 (x:\"s\" + x:true, flagless), got " + to_string(nm) + " (total=" + to_string(len(diags_m)) + ")")
        ok = false
    } else {
        println("  ok: 2 HX3011 emitted (Point{x:\"s\"} string + Point{x:true} bool; matching y:7 stays clean)")
    }

    // (n) HEXA-OWN L2 r1 — @own use-after-move lint (HEXA_OWN_LINT). Under
    // the flag, `@own let x = 5; let a = x; let b = x` warns HX3012 exactly
    // ONCE (at `let b = x`): the first use is the move (clean), the second is
    // the use-after-move. The two independent `@own` bindings p/q, each moved
    // once, must NOT cross-fire. On the default build → 0 (byteeq-neutral).
    // Same self-adapting contract as (h)-(m), on the NEW own-lint flag.
    let diags_n = _run_case("(n) own-lint r1 — @own use-after-move (HEXA_OWN_LINT)", _build_case_own_lint())
    let nn = _count_code(diags_n, "HX3012")
    if env("HEXA_OWN_LINT") == "1" {
        if nn != 1 {
            println("  FAIL: case (n) HEXA_OWN_LINT=1 expected 1 HX3012 (let b = x), got " + to_string(nn) + " (total=" + to_string(len(diags_n)) + ")")
            ok = false
        } else {
            println("  ok: 1 HX3012 emitted (move `let a = x` clean; use-after-move `let b = x` warns; p/q don't cross-fire)")
        }
    } else {
        if nn != 0 {
            println("  FAIL: case (n) default build expected 0 HX3012 (byteeq-neutral), got " + to_string(nn) + " (total=" + to_string(len(diags_n)) + ")")
            ok = false
        } else {
            println("  ok: 0 HX3012 (default-OFF → byteeq-neutral)")
        }
    }

    // (o) static-types r7-prep — structured array lowering
    // (HEXA_STATIC_TYPES_ARRAY_LOWER). The contract is IDENTICAL in both
    // modes — exactly 1 HX3003 (the `g(ys)` [f64]-vs-[i32] mismatch) and a
    // clean matching `g(zs)`. Flag-OFF that proves the string-sentinel path
    // is untouched (byteeq-neutral); flag-ON it proves the structured
    // lowering PRESERVES the element type (a kind-only "array" collapse
    // would yield 0 HX3003 and FAIL here). r4's element-fit contract, case
    // (k) above, must hold unchanged under this flag too — it lowers via the
    // kind:"named" annotation-text path, which this branch never touches.
    let diags_o = _run_case("(o) static-types r7-prep — array element preserved across lowering (HEXA_STATIC_TYPES_ARRAY_LOWER)", _build_case_static_types_r7prep())
    let no = _count_code(diags_o, "HX3003")
    if no != 1 {
        println("  FAIL: case (o) expected 1 HX3003 (g(ys) [f64]≠[i32]; matching g(zs) clean, flagless), got " + to_string(no) + " (total=" + to_string(len(diags_o)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3003 emitted (structured lowering — [f64] ≠ [i32] element recursion; matching g(zs) stays clean)")
    }

    // (q) static-types r8 — array-literal call-arg element mismatch + r8b
    // param-base index-assign. Letter (p) is reserved by the own-l2-r2 return
    // rung (parallel PR). After the F0 flag-fold HEXA_STATIC_TYPES=1 alone
    // supplies the array-lowering, so under the single flag: exactly
    // 1 HX3003 (`g([1.5])` — structural ArrayLit inference [f64] vs the
    // lowered [i64] param, rejected by the EXISTING call-arg check) and
    // exactly 1 HX3011 (`ws[0] = "s"` — r8b re-infers the param base to
    // recover the i64 element); the matching `g([1, 2])` and coercing
    // `vs[1] = 7` stay clean. Default build: 0 of each (ArrayLit args carry no
    // flag-OFF sentinel → byteeq-neutral proof). (ARRAY_LOWER alone — STATIC
    // off — also 0: ArrayLit inference and r8b gate on _types_static_on.)
    let diags_q = _run_case("(q) static-types r8 — array-literal call-arg element mismatch (HEXA_STATIC_TYPES)", _build_case_static_types_r8())
    let nq3003 = _count_code(diags_q, "HX3003")
    let nq3011 = _count_code(diags_q, "HX3011")
    if nq3003 != 1 || nq3011 != 1 {
        println("  FAIL: case (q) expected 1 HX3003 (g([1.5])) + 1 HX3011 (ws[0]=\"s\", flagless), got " + to_string(nq3003) + " HX3003 / " + to_string(nq3011) + " HX3011 (total=" + to_string(len(diags_q)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3003 + 1 HX3011 emitted (matching g([1,2]) and coercing vs[1]=7 stay clean)")
    }

    // (s) static-types r9a — Index/Field READ inference feeding the EXISTING
    // r2 let check (letters o/p/q/r taken; p reserved by own-l2-r2). After the
    // F0 flag-fold HEXA_STATIC_TYPES=1 IMPLIES array-lower, so the Index rung
    // no longer needs a separate HEXA_STATIC_TYPES_ARRAY_LOWER=1: under the
    // single flag → 2 HX3011 (`let n: string = xs[0]` Index-READ elem i64 +
    // `let q: string = p.x` Field-READ i32); default build → 0 (byteeq-neutral
    // proof). The matching `let m: i64 = xs[1]` and `let r: i32 = p.y` stay
    // clean in every mode. (HEXA_STATIC_TYPES_ARRAY_LOWER alone — STATIC off —
    // stays 0: the inference arms gate on _types_static_on.)
    let diags_s = _run_case("(s) static-types r9a — Index/Field READ inference into typed let (HEXA_STATIC_TYPES)", _build_case_static_types_r9a())
    let ns = _count_code(diags_s, "HX3011")
    if ns != 2 {
        println("  FAIL: case (s) expected 2 HX3011 (n:string=xs[0] Index + q:string=p.x Field, flagless), got " + to_string(ns) + " (total=" + to_string(len(diags_s)) + ")")
        ok = false
    } else {
        println("  ok: 2 HX3011 emitted (Index READ i64-elem + Field READ i32 vs string; matching m/r stay clean)")
    }

    // (t) static-types r9b — fn-return array-element REJECT + element-literal
    // coercion no-FP. After the F0 flag-fold HEXA_STATIC_TYPES=1 alone lowers
    // the return type structurally: exactly 1 HX3004 (`fn f() -> [i64] {
    // return [1.5] }` — structural [f64] vs the lowered [i64] return, at the
    // EXISTING default-ON HX3004 site) while `fn g() -> [f32] { return [0.0]
    // }` passes via the per-element literal-coercion arm of _types_assignable.
    // Default build: 0 (ArrayLit infers the unknown sentinel and/or the
    // annotation stays a string sentinel → tolerated — byteeq-neutral proof).
    // (ARRAY_LOWER alone — STATIC off — also 0: ArrayLit inference gates on
    // _types_static_on.)
    let diags_t = _run_case("(t) static-types r9b — return [1.5] vs [i64] REJECT + [0.0] vs [f32] coercion no-FP (HEXA_STATIC_TYPES)", _build_case_static_types_r9b())
    let nt = _count_code(diags_t, "HX3004")
    if nt != 1 {
        println("  FAIL: case (t) expected 1 HX3004 (f: [1.5] vs [i64] REJECT; g: [0.0] vs [f32] coerces, flagless), got " + to_string(nt) + " (total=" + to_string(len(diags_t)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3004 emitted (return-position element REJECT; [0.0]→[f32] element coercion stays clean — no FP)")
    }

    // (p) HEXA-OWN L2 r2 — @own use-after-move at RETURN position
    // (HEXA_OWN_LINT). Under the flag, `@own let x = 5; consume(x);
    // return x` warns HX3012 exactly ONCE (at `return x`): the call-arg is
    // the move, the return is the use-after-move. g's first-use `return r`
    // is a clean move (registers only). On the default build → 0
    // (byteeq-neutral). Same self-adapting contract as (n).
    let diags_o = _run_case("(p) own-lint r2 — @own moved then returned (HEXA_OWN_LINT)", _build_case_own_lint_r2())
    let oo = _count_code(diags_o, "HX3012")
    if env("HEXA_OWN_LINT") == "1" {
        if oo != 1 {
            println("  FAIL: case (p) HEXA_OWN_LINT=1 expected 1 HX3012 (return x), got " + to_string(oo) + " (total=" + to_string(len(diags_o)) + ")")
            ok = false
        } else {
            println("  ok: 1 HX3012 emitted (call-arg move clean; `return x` after move warns; g's first-use return clean)")
        }
    } else {
        if oo != 0 {
            println("  FAIL: case (p) default build expected 0 HX3012 (byteeq-neutral), got " + to_string(oo) + " (total=" + to_string(len(diags_o)) + ")")
            ok = false
        } else {
            println("  ok: 0 HX3012 (default-OFF → byteeq-neutral)")
        }
    }

    // (q) HEXA-OWN L2 r2b — @own PARAM position + Copy-exemption
    // (HEXA_OWN_LINT). Under the flag, h's `@own xs: string` param moved as
    // a call-arg then read again warns HX3012 exactly ONCE; k's
    // `@own n: i64` param is Copy-class (per the #4088 predicate) → exempt
    // from move tracking → moved-then-used stays silent. On the default
    // build → 0 (byteeq-neutral). Same self-adapting contract as (n)/(p).
    let diags_q = _run_case("(q) own-lint r2b — @own param moved then used; Copy-exempt i64 (HEXA_OWN_LINT)", _build_case_own_lint_r2b())
    let qq = _count_code(diags_q, "HX3012")
    if env("HEXA_OWN_LINT") == "1" {
        if qq != 1 {
            println("  FAIL: case (q) HEXA_OWN_LINT=1 expected 1 HX3012 (h: let b = xs), got " + to_string(qq) + " (total=" + to_string(len(diags_q)) + ")")
            ok = false
        } else {
            println("  ok: 1 HX3012 emitted (@own string param tracked; @own i64 param Copy-exempt silent)")
        }
    } else {
        if qq != 0 {
            println("  FAIL: case (q) default build expected 0 HX3012 (byteeq-neutral), got " + to_string(qq) + " (total=" + to_string(len(diags_q)) + ")")
            ok = false
        } else {
            println("  ok: 0 HX3012 (default-OFF → byteeq-neutral)")
        }
    }

    // (r) HEXA-OWN L2.5 r1 — arena-escape lint (HEXA_ARENA_ESCAPE_LINT).
    // Under the flag, `let a = [1,2]; g_sink = a` (g_sink = module-level
    // let) warns HX3013 exactly ONCE. The clean controls never fire: a
    // local-to-local `let keep = b`, a store through a fn-local SHADOW of
    // the global name, and a global store of a NON-composite binding
    // (`g_sink = s`). bad() runs last, so the ×1 also proves the per-fn
    // registry reset. On the default build → 0 (byteeq-neutral). Same
    // self-adapting contract as (h)-(p), on the NEW arena-escape flag.
    let diags_r = _run_case("(r) arena-escape L2.5 r1 — composite local stored into module global (HEXA_ARENA_ESCAPE_LINT)", _build_case_arena_escape())
    let nr = _count_code(diags_r, "HX3013")
    if env("HEXA_ARENA_ESCAPE_LINT") == "1" {
        if nr != 1 {
            println("  FAIL: case (r) HEXA_ARENA_ESCAPE_LINT=1 expected 1 HX3013 (g_sink = a), got " + to_string(nr) + " (total=" + to_string(len(diags_r)) + ")")
            ok = false
        } else {
            println("  ok: 1 HX3013 emitted (escape `g_sink = a` warns; local move / shadowed store / scalar store stay clean)")
        }
    } else {
        if nr != 0 {
            println("  FAIL: case (r) default build expected 0 HX3013 (byteeq-neutral), got " + to_string(nr) + " (total=" + to_string(len(diags_r)) + ")")
            ok = false
        } else {
            println("  ok: 0 HX3013 (default-OFF → byteeq-neutral)")
        }
    }

    // (u) static-types r9c — match literal-pattern vs scrutinee REJECT.
    // Flag-ON (HEXA_STATIC_TYPES=1, no ARRAY_LOWER dependency): exactly 1
    // HX3011 — the `"x"` string-literal pattern against the i64 scrutinee
    // (the NEW _check_match arm); the matching `7` int-literal control and
