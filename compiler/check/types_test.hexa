// HEXA Native Compiler — Phase B3 / S3+S4: type & domain smoke test
//
// @version 0.1.0
// @capabilities [pure]
//
// Hand-builds five small Modules and exercises the type pass:
//
//   (a) PASS — fn add(x:Int,y:Int)->Int { return x+y } fn main(){ add(1,2) }
//       expect 0 diagnostics
//
//   (b) FAIL HX3002 — fn add(x:Int,y:Int)->Int{...} fn main(){ add(1) }
//       expect 1 HX3002 (wrong arity)
//
//   (c) FAIL HX3003 — fn add(x:Int,y:Int)->Int{...} fn main(){ add(1,"hi") }
//       expect 1 HX3003 (arg #2 type mismatch)
//
//   (d) FAIL HX3001 — fn main(){ let _ = 1 + true }
//       expect 1 HX3001 (binop operand mismatch)
//
//   (e) FAIL HX3004 — fn pick()->Int { return "no" }
//       expect 1 HX3004 (return type mismatch)
//
// Run:
//   hexa run compiler/check/types_test.hexa

import "../parse/ast.hexa"
import "../diag/catalog.hexa"
import "../lex/tokens.hexa"
import "../ir/hir.hexa"
import "./types.hexa"

// ── AST construction helpers ─────────────────────────────────

fn _span(file: string, line: i64, col: i64, length: i64) -> Span {
    return Span { file: file, line: line, col: col, len: length }
}

fn _empty_span() -> Span {
    return _span("", 0, 0, 0)
}

fn _empty_atlas_ref() -> AtlasRef {
    return AtlasRef { kind: "", id: "", span: _empty_span() }
}

fn _empty_type_ref() -> TypeRef {
    return TypeRef { kind: "", name: "", args: [], span: _empty_span() }
}

fn _named_type_ref(name: string) -> TypeRef {
    return TypeRef { kind: "named", name: name, args: [], span: _empty_span() }
}

fn _ident_expr(name: string, file: string, line: i64, col: i64) -> Expr {
    return Expr {
        kind: ExprKind::Ident,
        span: _span(file, line, col, len(name)),
        text: name,
        annotations: [],
        children: [],
        atlas_ref: _empty_atlas_ref()
    }
}

fn _int_expr(text: string, file: string, line: i64, col: i64) -> Expr {
    return Expr {
        kind: ExprKind::LiteralInt,
        span: _span(file, line, col, len(text)),
        text: text,
        annotations: [],
        children: [],
        atlas_ref: _empty_atlas_ref()
    }
}

fn _string_expr(text: string, file: string, line: i64, col: i64) -> Expr {
    return Expr {
        kind: ExprKind::LiteralString,
        span: _span(file, line, col, len(text)),
        text: text,
        annotations: [],
        children: [],
        atlas_ref: _empty_atlas_ref()
    }
}

fn _bool_expr(text: string, file: string, line: i64, col: i64) -> Expr {
    return Expr {
        kind: ExprKind::LiteralBool,
        span: _span(file, line, col, len(text)),
        text: text,
        annotations: [],
        children: [],
        atlas_ref: _empty_atlas_ref()
    }
}

fn _bin_expr(op: string, lhs: Expr, rhs: Expr, file: string, line: i64, col: i64) -> Expr {
    let mut kids = []
    kids.push(lhs)
    kids.push(rhs)
    return Expr {
        kind: ExprKind::BinOp,
        span: _span(file, line, col, len(op)),
        text: op,
        annotations: [],
        children: kids,
        atlas_ref: _empty_atlas_ref()
    }
}

fn _call_expr(callee: Expr, args: [Expr], file: string, line: i64, col: i64) -> Expr {
    let mut kids = []
    kids.push(callee)
    let mut i = 0
    while i < len(args) {
        kids.push(args[i])
        i = i + 1
    }
    return Expr {
        kind: ExprKind::Call,
        span: _span(file, line, col, 1),
        text: "",
        annotations: [],
        children: kids,
        atlas_ref: _empty_atlas_ref()
    }
}

fn _return_expr(value: Expr, file: string, line: i64, col: i64) -> Expr {
    let mut kids = []
    kids.push(value)
    return Expr {
        kind: ExprKind::Return,
        span: _span(file, line, col, 6),
        text: "",
        annotations: [],
        children: kids,
        atlas_ref: _empty_atlas_ref()
    }
}

fn _let_expr(name: string, rhs: Expr, file: string, line: i64, col: i64) -> Expr {
    let mut kids = []
    kids.push(rhs)
    return Expr {
        kind: ExprKind::Let,
        span: _span(file, line, col, 3),
        text: name,
        annotations: [],
        children: kids,
        atlas_ref: _empty_atlas_ref()
    }
}

fn _block(children: [Expr], file: string, line: i64, col: i64) -> Expr {
    return Expr {
        kind: ExprKind::Block,
        span: _span(file, line, col, 1),
        text: "",
        annotations: [],
        children: children,
        atlas_ref: _empty_atlas_ref()
    }
}

fn _fn_item(name: string, params: [Param], ret: TypeRef, body: Expr, file: string, line: i64) -> Item {
    return Item {
        kind: ItemKind::Fn,
        name: name,
        span: _span(file, line, 1, len(name)),
        annotations: [],
        params: params,
        return_type: ret,
        body: body,
        is_pub: false
    }
}

// ── Lifetime-check helpers (HEXA_LIFETIME_CHECK opt-in pass) ──
// Build a fn item carrying a synthetic `__lt` annotation (the carriers the
// opt-in parser capture would attach) plus reference-typed params/return
// (`Ref:'<lt>:<pointee>` tags the opt-in parse_type Amp arm threads through
// TypeRef.name). These exercise the production `_lt_*` checker functions.
fn _lt_ann(atoms: [string], file: string, line: i64) -> Annotation {
    let mut args: [Expr] = []
    let mut i = 0
    while i < len(atoms) {
        args.push(_string_expr(atoms[i], file, line, 1))
        i = i + 1
    }
    return Annotation { name: "__lt", args: args, span: _span(file, line, 1, 3) }
}

fn _ref_param(name: string, ref_tag: string, file: string, line: i64, col: i64) -> Param {
    let t = _named_type_ref(ref_tag)
    return Param { name: name, typ: t, typs: [t], span: _span(file, line, col, len(name)) }
}

fn _fn_item_lt(name: string, anns: [Annotation], params: [Param], ret: TypeRef, file: string, line: i64) -> Item {
    return Item {
        kind: ItemKind::Fn,
        name: name,
        span: _span(file, line, 1, len(name)),
        annotations: anns,
        params: params,
        return_type: ret,
        body: _block([], file, line, 1),
        is_pub: false
    }
}

fn _param(name: string, typ_name: string, file: string, line: i64, col: i64) -> Param {
    let t = _named_type_ref(typ_name)
    return Param {
        name: name,
        typ: t,
        typs: [t],  // RFC-074 Phase 2 — arity-1 default
        span: _span(file, line, col, len(name))
    }
}

// RFC-074 Phase 2.1 — multi-field variant Param: explicit typs[] vector.
// `typ` mirrors typs[0] as the legacy degraded projection per RFC-074 §3.1.2.
fn _variant_multi(name: string, typ_names: [string], file: string, line: i64, col: i64) -> Param {
    let mut ts: [TypeRef] = []
    let mut i = 0
    while i < len(typ_names) {
        ts.push(_named_type_ref(typ_names[i]))
        i = i + 1
    }
    let first = if len(ts) > 0 { ts[0] } else { _empty_type_ref() }
    return Param {
        name: name,
        typ: first,
        typs: ts,
        span: _span(file, line, col, len(name))
    }
}

// RFC-074 Phase 2.1 — bare-variant ctor helper (arity 0 → typs is empty).
fn _variant_unit(name: string, file: string, line: i64, col: i64) -> Param {
    return Param {
        name: name,
        typ: _empty_type_ref(),
        typs: [],
        span: _span(file, line, col, len(name))
    }
}

// RFC-074 Phase 2.1 — Enum item declaration (variants live in params[]).
fn _enum_item(name: string, variants: [Param], file: string, line: i64) -> Item {
    return Item {
        kind: ItemKind::Enum,
        name: name,
        span: _span(file, line, 1, len(name)),
        annotations: [],
        params: variants,
        return_type: _empty_type_ref(),
        body: _block([], file, line, 1),
        is_pub: false
    }
}

// RFC-074 Phase 2.1 — EnumPath expression: text="Enum::Variant",
// children[] = payload args. Mirrors parser output shape so type_check
// reaches the same code path it does for real source.
fn _enum_path(enum_name: string, variant_name: string, args: [Expr], file: string, line: i64, col: i64) -> Expr {
    let text = enum_name + "::" + variant_name
    return Expr {
        kind: ExprKind::EnumPath,
        span: _span(file, line, col, len(text)),
        text: text,
        annotations: [],
        children: args,
        atlas_ref: _empty_atlas_ref()
    }
}

// ── Pretty-print ─────────────────────────────────────────────

fn _sev_str(s: Severity) -> string {
    return match s {
        Severity::Error -> "error",
        Severity::Warning -> "warning",
        Severity::Note -> "note"
    }
}

fn _print_diag(idx: i64, d: Diagnostic) {
    let sp = d.span
    let loc = sp.file + ":" + to_string(sp.line) + ":" + to_string(sp.col)
    println("    [" + to_string(idx) + "] " + d.code + " (" + _sev_str(d.severity) + " " + d.stage + ") @ " + loc)
    println("          msg:     " + d.message)
}

// ── Cases ────────────────────────────────────────────────────

// (a) PASS: fn add(x:Int,y:Int)->Int { return x+y } fn main(){ add(1,2) }
fn _build_case_a() -> Module {
    let f = "case_a.hexa"

    let mut params_add = []
    params_add.push(_param("x", "Int", f, 1, 8))
    params_add.push(_param("y", "Int", f, 1, 16))
    let x_ref = _ident_expr("x", f, 1, 35)
    let y_ref = _ident_expr("y", f, 1, 39)
    let body_expr = _bin_expr("+", x_ref, y_ref, f, 1, 37)
    let ret = _return_expr(body_expr, f, 1, 28)
    let mut block_kids = []
    block_kids.push(ret)
    let body = _block(block_kids, f, 1, 26)
    let item_add = _fn_item("add", params_add, _named_type_ref("Int"), body, f, 1)

    let add_callee = _ident_expr("add", f, 2, 14)
    let lit1 = _int_expr("1", f, 2, 18)
    let lit2 = _int_expr("2", f, 2, 21)
    let mut args = []
    args.push(lit1)
    args.push(lit2)
    let call = _call_expr(add_callee, args, f, 2, 17)
    let mut main_kids = []
    main_kids.push(call)
    let main_body = _block(main_kids, f, 2, 12)
    let item_main = _fn_item("main", [], _empty_type_ref(), main_body, f, 2)

    let mut items = []
    items.push(item_add)
    items.push(item_main)
    return Module { file: f, items: items, imports: [] }
}

// (b) FAIL HX3002: add(1) — wrong arity
fn _build_case_b() -> Module {
    let f = "case_b.hexa"

    let mut params_add = []
    params_add.push(_param("x", "Int", f, 1, 8))
    params_add.push(_param("y", "Int", f, 1, 16))
    let x_ref = _ident_expr("x", f, 1, 35)
    let y_ref = _ident_expr("y", f, 1, 39)
    let body_expr = _bin_expr("+", x_ref, y_ref, f, 1, 37)
    let ret = _return_expr(body_expr, f, 1, 28)
    let mut block_kids = []
    block_kids.push(ret)
    let body = _block(block_kids, f, 1, 26)
    let item_add = _fn_item("add", params_add, _named_type_ref("Int"), body, f, 1)

    let add_callee = _ident_expr("add", f, 2, 14)
    let lit1 = _int_expr("1", f, 2, 18)
    let mut args = []
    args.push(lit1)
    let call = _call_expr(add_callee, args, f, 2, 17)
    let mut main_kids = []
    main_kids.push(call)
    let main_body = _block(main_kids, f, 2, 12)
    let item_main = _fn_item("main", [], _empty_type_ref(), main_body, f, 2)

    let mut items = []
    items.push(item_add)
    items.push(item_main)
    return Module { file: f, items: items, imports: [] }
}

// (c) FAIL HX3003: add(1, "hi") — second arg type mismatch
fn _build_case_c() -> Module {
    let f = "case_c.hexa"

    let mut params_add = []
    params_add.push(_param("x", "Int", f, 1, 8))
    params_add.push(_param("y", "Int", f, 1, 16))
    let x_ref = _ident_expr("x", f, 1, 35)
    let y_ref = _ident_expr("y", f, 1, 39)
    let body_expr = _bin_expr("+", x_ref, y_ref, f, 1, 37)
    let ret = _return_expr(body_expr, f, 1, 28)
    let mut block_kids = []
    block_kids.push(ret)
    let body = _block(block_kids, f, 1, 26)
    let item_add = _fn_item("add", params_add, _named_type_ref("Int"), body, f, 1)

    let add_callee = _ident_expr("add", f, 2, 14)
    let lit1 = _int_expr("1", f, 2, 18)
    let lit_str = _string_expr("hi", f, 2, 21)
    let mut args = []
    args.push(lit1)
    args.push(lit_str)
    let call = _call_expr(add_callee, args, f, 2, 17)
    let mut main_kids = []
    main_kids.push(call)
    let main_body = _block(main_kids, f, 2, 12)
    let item_main = _fn_item("main", [], _empty_type_ref(), main_body, f, 2)

    let mut items = []
    items.push(item_add)
    items.push(item_main)
    return Module { file: f, items: items, imports: [] }
}

// (d) FAIL HX3001: 1 + true — binop operand mismatch
fn _build_case_d() -> Module {
    let f = "case_d.hexa"

    let lit1 = _int_expr("1", f, 1, 14)
    let lit_t = _bool_expr("true", f, 1, 18)
    let bin = _bin_expr("+", lit1, lit_t, f, 1, 16)
    let let_e = _let_expr("z", bin, f, 1, 5)
    let mut block_kids = []
    block_kids.push(let_e)
    let main_body = _block(block_kids, f, 1, 12)
    let item_main = _fn_item("main", [], _empty_type_ref(), main_body, f, 1)

    let mut items = []
    items.push(item_main)
    return Module { file: f, items: items, imports: [] }
}

// (e) FAIL HX3004: fn pick() -> Int { return "no" }
fn _build_case_e() -> Module {
    let f = "case_e.hexa"

    let lit_str = _string_expr("no", f, 1, 27)
    let ret = _return_expr(lit_str, f, 1, 20)
    let mut block_kids = []
    block_kids.push(ret)
    let body = _block(block_kids, f, 1, 18)
    let item_pick = _fn_item("pick", [], _named_type_ref("Int"), body, f, 1)

    let mut items = []
    items.push(item_pick)
    return Module { file: f, items: items, imports: [] }
}

// RFC-074 Phase 2.1 — (f) PASS: enum Event { Click(int, string) }
// fn main() { Event::Click(42, "hi") }   — element types match declared slots.
fn _build_case_f() -> Module {
    let f = "case_f.hexa"

    let mut variants = []
    variants.push(_variant_multi("Click", ["int", "string"], f, 1, 14))
    let item_enum = _enum_item("Event", variants, f, 1)

    let arg0 = _int_expr("42", f, 2, 22)
    let arg1 = _string_expr("hi", f, 2, 26)
    let mut args = []
    args.push(arg0)
    args.push(arg1)
    let ctor = _enum_path("Event", "Click", args, f, 2, 12)

    let mut main_kids = []
    main_kids.push(ctor)
    let main_body = _block(main_kids, f, 2, 10)
    let item_main = _fn_item("main", [], _empty_type_ref(), main_body, f, 2)

    let mut items = []
    items.push(item_enum)
    items.push(item_main)
    return Module { file: f, items: items, imports: [] }
}

// RFC-074 Phase 2.1 — (g) FAIL HX2005: enum Event { Click(int, string) }
// fn main() { Event::Click("hi", 42) } — args swapped, expect 2 HX2005.
fn _build_case_g() -> Module {
    let f = "case_g.hexa"

    let mut variants = []
    variants.push(_variant_multi("Click", ["int", "string"], f, 1, 14))
    let item_enum = _enum_item("Event", variants, f, 1)

    // Swapped: string first, int second — both slots must trip HX2005.
    let arg0 = _string_expr("hi", f, 2, 22)
    let arg1 = _int_expr("42", f, 2, 28)
    let mut args = []
    args.push(arg0)
    args.push(arg1)
    let ctor = _enum_path("Event", "Click", args, f, 2, 12)

    let mut main_kids = []
    main_kids.push(ctor)
    let main_body = _block(main_kids, f, 2, 10)
    let item_main = _fn_item("main", [], _empty_type_ref(), main_body, f, 2)

    let mut items = []
    items.push(item_enum)
    items.push(item_main)
    return Module { file: f, items: items, imports: [] }
}

// ── Driver ───────────────────────────────────────────────────

// ── Lifetime cases ───────────────────────────────────────────
// (h) byteeq sentinel: a fn with a `__lt` annotation + `&'a`/`&'b` ref types,
//     run through the FULL type_check with HEXA_LIFETIME_CHECK unset → the
//     lifetime pass must be a no-op (0 HX3011 / 0 HX3012). This is the
//     default-build byte-identity guard.
fn _build_case_lt_off() -> Module {
    let f = "case_lt_off.hexa"
    let ann = _lt_ann(["L:a"], f, 1)
    let mut params = []
    params.push(_ref_param("x", "Ref:'a:T", f, 1, 10))
    let ret = _named_type_ref("Ref:'b:U")
    let item = _fn_item_lt("f", [ann], params, ret, f, 1)
    let mut items = []
    items.push(item)
    return Module { file: f, items: items, imports: [] }
}

// (i) ON-logic: `fn f<'a>(x: &'a T) -> &'b U` — 'b is returned but not a
//     parameter lifetime AND not declared → fires HX3011 (arena-escape) and
//     HX3012 (undeclared 'b). Calls `_lt_check_item` directly to exercise the
//     ON path without process-env mutation.
fn _build_item_lt_bad() -> Item {
    let f = "case_lt_bad.hexa"
    let ann = _lt_ann(["L:a"], f, 1)
    let mut params = []
    params.push(_ref_param("x", "Ref:'a:T", f, 1, 10))
    let ret = _named_type_ref("Ref:'b:U")
    return _fn_item_lt("f", [ann], params, ret, f, 1)
}

// (j) ON-logic clean: `fn g<'a>(x: &'a T) -> &'a U` — return lifetime is a
//     parameter lifetime and declared → 0 HX3011 / 0 HX3012.
fn _build_item_lt_ok() -> Item {
    let f = "case_lt_ok.hexa"
    let ann = _lt_ann(["L:a"], f, 1)
    let mut params = []
    params.push(_ref_param("x", "Ref:'a:T", f, 1, 10))
    let ret = _named_type_ref("Ref:'a:U")
    return _fn_item_lt("g", [ann], params, ret, f, 1)
}

// (k) ON-logic outlives: `fn k<'a, 'b: 'c>(…)` — outlives bound names 'c which
//     is never declared → fires HX3012.
fn _build_item_lt_outlives() -> Item {
    let f = "case_lt_outlives.hexa"
    let ann = _lt_ann(["L:a", "L:b", "O:b:c"], f, 1)
    let ret = _empty_type_ref()
    return _fn_item_lt("k", [ann], [], ret, f, 1)
}

fn _run_case(label: string, m: Module) -> array {
    println("")
    println("── " + label + " ──")
    println("  module: " + m.file + " (items=" + to_string(len(m.items)) + ")")
    let diags = type_check(m)
    println("  diagnostics: " + to_string(len(diags)))
    let mut i = 0
    while i < len(diags) {
        _print_diag(i, diags[i])
        i = i + 1
    }
    return diags
}

fn _has_code(diags: array, code: string) -> bool {
    let mut i = 0
    while i < len(diags) {
        let d = diags[i]
        if d.code == code { return true }
        i = i + 1
    }
    return false
}

fn _count_code(diags: array, code: string) -> i64 {
    let mut i = 0
    let mut n = 0
    while i < len(diags) {
        let d = diags[i]
        if d.code == code { n = n + 1 }
        i = i + 1
    }
    return n
}

fn main() {
    println("══════════════════════════════════════════════")
    println("  HEXA Compiler — Type/Domain Smoke Test (B3/S3+S4)")
    println("══════════════════════════════════════════════")

    let mut ok = true

    // (a) PASS
    let diags_a = _run_case("(a) PASS — add(1,2) signature matches", _build_case_a())
    if len(diags_a) != 0 {
        println("  FAIL: case (a) expected 0 diagnostics, got " + to_string(len(diags_a)))
        ok = false
    } else {
        println("  ok: 0 diagnostics")
    }

    // (b) HX3002
    let diags_b = _run_case("(b) FAIL HX3002 — add(1) wrong arity", _build_case_b())
    let nb = _count_code(diags_b, "HX3002")
    if nb != 1 {
        println("  FAIL: case (b) expected 1 HX3002, got " + to_string(nb) + " (total=" + to_string(len(diags_b)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3002 emitted")
    }

    // (c) HX3003
    let diags_c = _run_case("(c) FAIL HX3003 — add(1,\"hi\") arg type", _build_case_c())
    let nc = _count_code(diags_c, "HX3003")
    if nc != 1 {
        println("  FAIL: case (c) expected 1 HX3003, got " + to_string(nc) + " (total=" + to_string(len(diags_c)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3003 emitted")
    }

    // (d) HX3001
    let diags_d = _run_case("(d) FAIL HX3001 — 1 + true binop mismatch", _build_case_d())
    if !_has_code(diags_d, "HX3001") {
        println("  FAIL: case (d) expected at least one HX3001, got total=" + to_string(len(diags_d)))
        ok = false
    } else {
        println("  ok: HX3001 emitted")
    }

    // (e) HX3004
    let diags_e = _run_case("(e) FAIL HX3004 — fn pick()->Int returns string", _build_case_e())
    if !_has_code(diags_e, "HX3004") {
        println("  FAIL: case (e) expected at least one HX3004, got total=" + to_string(len(diags_e)))
        ok = false
    } else {
        println("  ok: HX3004 emitted")
    }

    // RFC-074 Phase 2.1 — (f) PASS: Event::Click(42, "hi") on enum E{Click(int, string)}
    let diags_f = _run_case("(f) PASS — Event::Click(42,\"hi\") element-type match", _build_case_f())
    let nf_2005 = _count_code(diags_f, "HX2005")
    let nf_2004 = _count_code(diags_f, "HX2004")
    if nf_2005 != 0 || nf_2004 != 0 {
        println("  FAIL: case (f) expected 0 HX2004 + 0 HX2005, got " + to_string(nf_2004) + " HX2004 / " + to_string(nf_2005) + " HX2005 (total=" + to_string(len(diags_f)) + ")")
        ok = false
    } else {
        println("  ok: 0 HX2004 / 0 HX2005 (element types match)")
    }

    // RFC-074 Phase 2.1 — (g) FAIL HX2005 ×2: Event::Click("hi", 42) — args swapped
    let diags_g = _run_case("(g) FAIL HX2005 ×2 — Event::Click(\"hi\",42) element-type swap", _build_case_g())
    let ng = _count_code(diags_g, "HX2005")
    if ng != 2 {
        println("  FAIL: case (g) expected 2 HX2005, got " + to_string(ng) + " (total=" + to_string(len(diags_g)) + ")")
        ok = false
    } else {
        println("  ok: 2 HX2005 emitted (per-slot positional)")
    }

    // ── Lifetime pass (opt-in HEXA_LIFETIME_CHECK) ───────────────
    // (h) byteeq sentinel: env-OFF → 0 HX3011 / 0 HX3012 through full type_check.
    let diags_h = _run_case("(h) byteeq sentinel — env-OFF lifetime pass is a no-op", _build_case_lt_off())
    let nh = _count_code(diags_h, "HX3011") + _count_code(diags_h, "HX3012")
    if nh != 0 {
        println("  FAIL: case (h) expected 0 HX3011/HX3012 with env unset, got " + to_string(nh))
        ok = false
    } else {
        println("  ok: 0 HX3011/HX3012 (default build byte-identical)")
    }

    // (i) ON-logic: fn f<'a>(x:&'a T)->&'b U fires HX3011 + HX3012.
    let mut out_i = []
    _lt_check_item(_build_item_lt_bad(), out_i)
    let ni_11 = _count_code(out_i, "HX3011")
    let ni_12 = _count_code(out_i, "HX3012")
    println("")
    println("── (i) ON-logic — fn f<'a>(x:&'a T)->&'b U ──")
    println("  diagnostics: " + to_string(len(out_i)) + " (HX3011=" + to_string(ni_11) + " HX3012=" + to_string(ni_12) + ")")
    if ni_11 != 1 || ni_12 != 1 {
        println("  FAIL: case (i) expected 1 HX3011 + 1 HX3012")
        ok = false
    } else {
        println("  ok: HX3011 (arena-escape) + HX3012 (undeclared 'b) emitted")
    }

    // (j) ON-logic clean: fn g<'a>(x:&'a T)->&'a U → 0 lifetime diagnostics.
    let mut out_j = []
    _lt_check_item(_build_item_lt_ok(), out_j)
    let nj = _count_code(out_j, "HX3011") + _count_code(out_j, "HX3012")
    println("")
    println("── (j) ON-logic clean — fn g<'a>(x:&'a T)->&'a U ──")
    println("  diagnostics: " + to_string(len(out_j)))
    if nj != 0 {
        println("  FAIL: case (j) expected 0 lifetime diagnostics, got " + to_string(nj))
        ok = false
    } else {
        println("  ok: 0 HX3011/HX3012 (return lifetime bound to a parameter)")
    }

    // (k) ON-logic outlives: fn k<'a,'b:'c>(…) → HX3012 (undeclared 'c).
    let mut out_k = []
    _lt_check_item(_build_item_lt_outlives(), out_k)
    let nk = _count_code(out_k, "HX3012")
    println("")
    println("── (k) ON-logic outlives — fn k<'a,'b:'c> ──")
    println("  diagnostics: " + to_string(len(out_k)) + " (HX3012=" + to_string(nk) + ")")
    if nk != 1 {
        println("  FAIL: case (k) expected 1 HX3012 (undeclared 'c), got " + to_string(nk))
        ok = false
    } else {
        println("  ok: HX3012 emitted for undeclared outlives lifetime 'c")
    }

    println("")
    println("══════════════════════════════════════════════")
    if ok {
        println("PASS: all type-check cases match contract.")
    } else {
        println("FAIL: type-check contract not satisfied.")
    }
    println("══════════════════════════════════════════════")
    if !ok { exit(1) }
}
