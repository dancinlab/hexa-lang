    let diags_u = _run_case("(u) static-types r9c — match \"x\" pattern vs i64 scrutinee REJECT (HEXA_STATIC_TYPES)", _build_case_static_types_r9c())
    let nu = _count_code(diags_u, "HX3011")
    if nu != 1 {
