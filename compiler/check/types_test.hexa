}

// (bc) fp_container_unknown — `fn u(xs: [i64], f: i64) { let x: i64 = xs.map(f) }`:
// `map` is EXCLUDED (polymorphic/container — result element type depends on the
// receiver + callback), so the call stays type-opaque and the typed-let never
// fires → 0 HX3011. This is the guard that the excluded-set stays unknown (a
// mis-typed container/element method would produce WRONG diagnostics here).
fn _build_case_container_method_unknown() -> Module {
    let f = "case_container_method_unknown.hexa"
    let recv = _ident_expr("xs", f, 2, 17)
    let arg = _ident_expr("f", f, 2, 24)
    let call = _call_expr(_field_expr(recv, "map", f, 2, 20), [arg], f, 2, 20)
    let body = _block([_let_expr("x|i64", call, f, 2, 5)], f, 2, 1)
    let mut params = []
    params.push(_array_param("xs", "i64", f, 1, 6))
    params.push(_param("f", "i64", f, 1, 15))
    let item_u = _fn_item("u", params, _empty_type_ref(), body, f, 1)
