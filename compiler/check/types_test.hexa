    dvars.push(_variant_unit("North", f, 2, 11))
    dvars.push(_variant_unit("South", f, 2, 18))
    let item_dir = _enum_item("Dir", dvars, f, 2)
    let lc = _let_expr("c|Color", _enum_path("Color", "Red", [], f, 4, 20), f, 4, 5)
    let ld = _let_expr("d|Dir", _enum_path("Dir", "North", [], f, 5, 18), f, 5, 5)
    let lc2 = _let_expr("c2|Color", _enum_path("Color", "Green", [], f, 6, 21), f, 6, 5)
    let ea = _let_expr("a", _bin_expr("==", _ident_expr("c", f, 7, 13), _ident_expr("d", f, 7, 18), f, 7, 15), f, 7, 5)
    let eb = _let_expr("b", _bin_expr("==", _ident_expr("c", f, 8, 13), _ident_expr("c2", f, 8, 18), f, 8, 15), f, 8, 5)
    let mut fparams = []
    let item_f = _fn_item("f", fparams, _empty_type_ref(), _block([lc, ld, lc2, ea, eb], f, 3, 1), f, 3)
    let mut items = []
    items.push(item_color)
    items.push(item_dir)
    items.push(item_f)
    return Module { file: f, items: items, imports: [] }
}

