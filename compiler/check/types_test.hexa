// Wall A r5 — struct field-type assign. A `struct Point { x: i32, y: i32 }`
// records its field names + types into the side registry. A receiver of struct
// type — a fn PARAM `p: Point` (carries `named:Point` via bind_params) OR a
// block-local `let s: Point` (recorded under `{}s`) — lets a later
// `recv.field = <expr>` recover `field`'s declared type and REJECT a scalar
// mismatch with HX3011 (Rust E0308 check_field place-coercion). Three REJECT
// shapes + one matching control:
//   struct Point { x: i32, y: i32 }
//   fn f(p: Point) {
//       let s: Point          // block-local → record {}s : named:Point
//       p.x = "s"             // REJECT: string ≠ i32 (param receiver)   → HX3011
//       s.x = "z"             // REJECT: string ≠ i32 (block-local recv)  → HX3011
//       p.y = 7               // matches (int-lit coercion)               → clean
//   }
// Under the flag exactly 2 HX3011; the matching `p.y = 7` and the default
// build (flag-off) emit zero — the byteeq-neutral proof. Extends r4's element-
// fit contract from the array place to the struct field place.
fn _build_case_static_types_r5() -> Module {
    let f = "case_static_r5.hexa"
    // struct Point { x: i32, y: i32 }
    let mut sfields = []
    sfields.push(_param("x", "i32", f, 1, 15))
    sfields.push(_param("y", "i32", f, 1, 23))
    let item_pt = _struct_item("Point", sfields, f, 1)
