    let fx = _let_expr("x", _index_expr(_ident_expr("n", f, 2, 13), _int_expr("0", f, 2, 15), f, 2, 14), f, 2, 5)
    let fr = _return_expr(_int_expr("0", f, 3, 12), f, 3, 5)
