    // let _p = Point { x: "s", y: 7 }
    let mut inits_p = []
    inits_p.push(_field_init("x", _string_expr("s", f, 3, 25), f, 3, 22))
    inits_p.push(_field_init("y", _int_expr("7", f, 3, 33), f, 3, 30))
    kids.push(_struct_lit_expr("Point", inits_p, f, 3, 14))
    // let _q = Point { x: true }
    let mut inits_q = []
    inits_q.push(_field_init("x", _bool_expr("true", f, 4, 25), f, 4, 22))
    kids.push(_struct_lit_expr("Point", inits_q, f, 4, 14))
    let body = _block(kids, f, 2, 1)
    let item_f = _fn_item("f", [], _empty_type_ref(), body, f, 2)
    let mut items = []
    items.push(item_pt)
    items.push(item_f)
    return Module { file: f, items: items, imports: [] }
}

// static-types r7-prep — structured array lowering
// (HEXA_STATIC_TYPES_ARRAY_LOWER=1). One module whose HX3003 contract is
// IDENTICAL in both modes — the discriminating proof that the opt-in
// lowering PRESERVES the element type (a naive kind-only "array" collapse
// would drop the mismatch below to 0 flag-ON):
//   fn g(xs: [i32]) {}
//   fn h(ys: [f64]) { g(ys) }     // [f64] arg vs [i32] param → HX3003 (×1)
//   fn k(zs: [i32]) { g(zs) }     // [i32] arg vs [i32] param → clean
// Flag-OFF the mismatch REJECTs via the string sentinels
// (`generic:Array:f64` ≠ `generic:Array:i32`); flag-ON via the structured
// element recursion (`[f64]` ≠ `[i32]` in _types_equal). Both modes: exactly
// 1 HX3003 — flag-OFF byte-neutrality AND flag-ON element preservation in
// one self-adapting contract.
fn _build_case_static_types_r7prep() -> Module {
    let f = "case_static_r7prep.hexa"
    // fn g(xs: [i32]) {}
    let g_body = _block([], f, 1, 17)
    let item_g = _fn_item("g", [_array_param("xs", "i32", f, 1, 6)], _empty_type_ref(), g_body, f, 1)
    // fn h(ys: [f64]) { g(ys) }   — element mismatch
    let mut bad_args = []
    bad_args.push(_ident_expr("ys", f, 2, 21))
    let bad_call = _call_expr(_ident_expr("g", f, 2, 19), bad_args, f, 2, 19)
    let mut h_kids = []
    h_kids.push(bad_call)
    let h_body = _block(h_kids, f, 2, 17)
    let item_h = _fn_item("h", [_array_param("ys", "f64", f, 2, 6)], _empty_type_ref(), h_body, f, 2)
    // fn k(zs: [i32]) { g(zs) }   — element match (clean in both modes)
    let mut good_args = []
    good_args.push(_ident_expr("zs", f, 3, 21))
    let good_call = _call_expr(_ident_expr("g", f, 3, 19), good_args, f, 3, 19)
    let mut k_kids = []
    k_kids.push(good_call)
    let k_body = _block(k_kids, f, 3, 17)
    let item_k = _fn_item("k", [_array_param("zs", "i32", f, 3, 6)], _empty_type_ref(), k_body, f, 3)
    let mut items = []
    items.push(item_g)
    items.push(item_h)
    items.push(item_k)
    return Module { file: f, items: items, imports: [] }
}

// static-types r8 — array-literal call-arg element REJECT + r8b param-base
// index-assign fallback (HEXA_STATIC_TYPES=1 + HEXA_STATIC_TYPES_ARRAY_LOWER=1).
// One module, four fns — two REJECT shapes + two matching controls:
//   fn g(xs: [i64]) {}
//   fn h() { g([1.5]) }            // ArrayLit [f64] arg vs [i64] param → HX3003 (×1)
//   fn k() { g([1, 2]) }           // ArrayLit [i64] arg vs [i64] param → clean
//   fn f(ws: [i64]) { ws[0] = "s" }  // r8b: param array base, string ≠ i64 → HX3011 (×1)
//   fn p(vs: [i64]) { vs[1] = 7 }    // r8b: int-literal coerces           → clean
// BOTH flags on: exactly 1 HX3003 (the structural ArrayLit inference feeds
// the EXISTING default-ON call-arg check) + exactly 1 HX3011 (the r8b
// re-infer of the param base recovers args[0]). Default build / either flag
// alone: 0 of each — the ArrayLit still infers the unknown sentinel and the
// r4 fallback stays gated (byteeq-neutral proof). Unlike case (o)'s
// mode-IDENTICAL contract, this one is mode-DIFFERENT: literal args carry no
// flag-OFF string sentinel, so only the structural path can reject them.
fn _build_case_static_types_r8() -> Module {
    let f = "case_static_r8.hexa"
    // fn g(xs: [i64]) {}
    let g_body = _block([], f, 1, 17)
