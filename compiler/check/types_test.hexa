    let cbe = _count_code(diags_be, "HX3044")
    if cbe != 0 {
        println("  FAIL: case (be) expected 0 HX3044 (127 fits i8), got " + to_string(cbe) + " (total=" + to_string(len(diags_be)) + ")")
        ok = false
    } else {
        println("  ok: 0 HX3044 (127 == i8::MAX fits — boundary, no over-reject)")
    }

    // (bf) ★ HX3044 i64 boundary fit — fp_i64_max: `let x: i64 = 9223372036854775807`
    // → 0 HX3044 (overflow-guarded accumulation reaches i64::MAX exactly).
    let diags_bf = _run_case("(bf) static-types — int-lit range-fit: let x:i64 = 9223372036854775807 → == i64::MAX → 0 HX3044", _build_case_i64_max())
    let cbf = _count_code(diags_bf, "HX3044")
    if cbf != 0 {
        println("  FAIL: case (bf) expected 0 HX3044 (i64::MAX fits i64), got " + to_string(cbf) + " (total=" + to_string(len(diags_bf)) + ")")
        ok = false
    } else {
        println("  ok: 0 HX3044 (i64::MAX fits — no accumulator wrap on the boundary)")
    }

    // (bg) ★ HX3044 int-literal range-fit — hz_i32_over: `let x: i32 = 2147483648`
    // (one past i32::MAX) → 1 HX3044 in the ERROR band (STRICT re-band, real source).
    let diags_bg = _run_case("(bg) static-types — int-lit range-fit: let x:i32 = 2147483648 → i32::MAX+1 → 1 HX3044 (Error, real source)", _build_case_i32_over())
    let cbg_e = _count_code_sev(diags_bg, "HX3044", "error")
    let cbg_w = _count_code_sev(diags_bg, "HX3044", "warning")
    if cbg_e != 1 || cbg_w != 0 {
        println("  FAIL: case (bg) expected 1 HX3044 error / 0 warning, got err=" + to_string(cbg_e) + " warn=" + to_string(cbg_w) + " (total=" + to_string(len(diags_bg)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3044 emitted as Error (i32 = 2147483648 overflows i32::MAX)")
    }

    // (bh) ★ HX3044 i32 boundary fit — fp_i32_max: `let x: i32 = 2147483647`
    // → 0 HX3044.
    let diags_bh = _run_case("(bh) static-types — int-lit range-fit: let x:i32 = 2147483647 → == i32::MAX → 0 HX3044 (no false fire)", _build_case_i32_max())
    let cbh = _count_code(diags_bh, "HX3044")
    if cbh != 0 {
        println("  FAIL: case (bh) expected 0 HX3044 (2147483647 fits i32), got " + to_string(cbh) + " (total=" + to_string(len(diags_bh)) + ")")
        ok = false
    } else {
        println("  ok: 0 HX3044 (2147483647 == i32::MAX fits — boundary, no over-reject)")
    }

    // (bi) ★ HX3044 negated-literal FIT — `let x: i8 = -128` → 0 HX3044 AND
    // 0 HX3011: the `_types_assignable` negated-int-lit coercion arm makes `-128`
    // coerce cleanly (no spurious mismatched-types false-positive). Total = 0.
    let diags_bi = _run_case("(bi) static-types — negated-lit fit: let x:i8 = -128 → abs(MIN)=128 fits → 0 HX3044, 0 HX3011", _build_case_i8_neg_fit())
    let cbi = _count_code(diags_bi, "HX3044")
    let cbi_11 = _count_code(diags_bi, "HX3011")
    if cbi != 0 || cbi_11 != 0 {
        println("  FAIL: case (bi) expected 0 HX3044 + 0 HX3011 (-128 fits i8), got HX3044=" + to_string(cbi) + " HX3011=" + to_string(cbi_11) + " (total=" + to_string(len(diags_bi)) + ")")
        ok = false
    } else {
        println("  ok: 0 HX3044 + 0 HX3011 (-128 == i8::MIN fits + coerces cleanly — no false mismatch)")
    }

    // (bj) ★ HX3044 negated-literal OVERFLOW — `let x: i8 = -129` → 1 HX3044
    // (Error) AND 0 HX3011 (the negated literal coerces, only the value overflows).
    let diags_bj = _run_case("(bj) static-types — negated-lit overflow: let x:i8 = -129 → 129 > abs(MIN)=128 → 1 HX3044 (Error), 0 HX3011", _build_case_i8_neg_over())
    let cbj_e = _count_code_sev(diags_bj, "HX3044", "error")
    let cbj_w = _count_code_sev(diags_bj, "HX3044", "warning")
    let cbj_11 = _count_code(diags_bj, "HX3011")
    if cbj_e != 1 || cbj_w != 0 || cbj_11 != 0 {
        println("  FAIL: case (bj) expected 1 HX3044 error / 0 warning / 0 HX3011, got err=" + to_string(cbj_e) + " warn=" + to_string(cbj_w) + " HX3011=" + to_string(cbj_11) + " (total=" + to_string(len(diags_bj)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3044 Error + 0 HX3011 (-129 overflows i8::MIN — value gate only, clean coercion)")
    }

    // (bk) ★ HX3044 fan-out site A (return) — `fn f() -> i8 { return 300 }` → 1 HX3044.
    let diags_bk = _run_case("(bk) static-types — fan-out return: fn f() -> i8 { return 300 } → 300 > 127 → 1 HX3044 (Error)", _build_case_i8_ret_over())
    let cbk_e = _count_code_sev(diags_bk, "HX3044", "error")
    if cbk_e != 1 {
        println("  FAIL: case (bk) expected 1 HX3044 error at return site, got err=" + to_string(cbk_e) + " (total=" + to_string(len(diags_bk)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3044 Error at return-place coercion (fan-out site A)")
    }

    // (bl) ★ HX3044 fan-out site B (assign) — `let x: i8 ; x = 300` → 1 HX3044.
    let diags_bl = _run_case("(bl) static-types — fan-out assign: let x:i8 ; x = 300 → 300 > 127 → 1 HX3044 (Error)", _build_case_i8_assign_over())
    let cbl_e = _count_code_sev(diags_bl, "HX3044", "error")
    if cbl_e != 1 {
        println("  FAIL: case (bl) expected 1 HX3044 error at assign site, got err=" + to_string(cbl_e) + " (total=" + to_string(len(diags_bl)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3044 Error at assignment-place coercion (fan-out site B)")
    }

    // (bm) ★ HX3044 fan-out site C (field-init) — `struct S { b: i8 }` ; `S { b: 300 }` → 1 HX3044.
    let diags_bm = _run_case("(bm) static-types — fan-out field-init: struct S{b:i8} ; S{b:300} → 300 > 127 → 1 HX3044 (Error)", _build_case_i8_field_over())
    let cbm_e = _count_code_sev(diags_bm, "HX3044", "error")
    if cbm_e != 1 {
        println("  FAIL: case (bm) expected 1 HX3044 error at field-init site, got err=" + to_string(cbm_e) + " (total=" + to_string(len(diags_bm)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3044 Error at struct field-init coercion (fan-out site C)")
    }

    // (bn) ★ HX3044 fan-out site D (call-arg) — `fn g(p: i8) {}` ; `g(300)` → 1 HX3044.
    let diags_bn = _run_case("(bn) static-types — fan-out call-arg: fn g(p:i8) ; g(300) → 300 > 127 → 1 HX3044 (Error)", _build_case_i8_arg_over())
    let cbn_e = _count_code_sev(diags_bn, "HX3044", "error")
    if cbn_e != 1 {
        println("  FAIL: case (bn) expected 1 HX3044 error at call-arg site, got err=" + to_string(cbn_e) + " (total=" + to_string(len(diags_bn)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3044 Error at call-argument coercion (fan-out site D)")
    }

    // (bo) ★ HX3044 fan-out site E (index-place assign) — `let a:[i8] ; a[0] = 300` → 1 HX3044.
    let diags_bo = _run_case("(bo) static-types — fan-out index-assign: let a:[i8] ; a[0] = 300 → 300 > 127 → 1 HX3044 (Error)", _build_case_i8_index_assign_over())
    let cbo_e = _count_code_sev(diags_bo, "HX3044", "error")
    let cbo_11 = _count_code(diags_bo, "HX3011")
    if cbo_e != 1 || cbo_11 != 0 {
        println("  FAIL: case (bo) expected 1 HX3044 error / 0 HX3011 at index-place, got err=" + to_string(cbo_e) + " HX3011=" + to_string(cbo_11) + " (total=" + to_string(len(diags_bo)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3044 Error at index-place coercion (fan-out site E)")
    }

    // (bp) ★ HX3044 fan-out site E boundary FIT — `a[0] = 127` → 0 HX3044.
    let diags_bp = _run_case("(bp) static-types — fan-out index-assign fit: let a:[i8] ; a[0] = 127 → == i8::MAX → 0 HX3044", _build_case_i8_index_assign_fit())
    let cbp = _count_code(diags_bp, "HX3044")
    if cbp != 0 {
        println("  FAIL: case (bp) expected 0 HX3044 (127 fits i8 at index-place), got " + to_string(cbp) + " (total=" + to_string(len(diags_bp)) + ")")
        ok = false
    } else {
        println("  ok: 0 HX3044 (127 == i8::MAX fits at index-place — no over-reject)")
    }

    // (bq) ★ HX3044 fan-out site F (field-place assign) — `struct S{b:i8} ; s.b = 300` → 1 HX3044.
    let diags_bq = _run_case("(bq) static-types — fan-out field-assign: struct S{b:i8} ; s.b = 300 → 300 > 127 → 1 HX3044 (Error)", _build_case_i8_field_assign_over())
    let cbq_e = _count_code_sev(diags_bq, "HX3044", "error")
    let cbq_11 = _count_code(diags_bq, "HX3011")
    if cbq_e != 1 || cbq_11 != 0 {
        println("  FAIL: case (bq) expected 1 HX3044 error / 0 HX3011 at field-place, got err=" + to_string(cbq_e) + " HX3011=" + to_string(cbq_11) + " (total=" + to_string(len(diags_bq)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3044 Error at field-place coercion (fan-out site F)")
    }

    // (br) ★ HX3044 fan-out site F boundary FIT — `s.b = 127` → 0 HX3044.
    let diags_br = _run_case("(br) static-types — fan-out field-assign fit: s.b = 127 → == i8::MAX → 0 HX3044", _build_case_i8_field_assign_fit())
    let cbr = _count_code(diags_br, "HX3044")
    if cbr != 0 {
        println("  FAIL: case (br) expected 0 HX3044 (127 fits i8 at field-place), got " + to_string(cbr) + " (total=" + to_string(len(diags_br)) + ")")
        ok = false
    } else {
        println("  ok: 0 HX3044 (127 == i8::MAX fits at field-place — no over-reject)")
    }

    // (bs) ★ Lane-B parse_int inference — i64 sink ok + string sink mismatch → 1 HX3011.
    let diags_bs = _run_case("(bs) static-types — parse_int infer: n:i64 = x.parse_int() (ok) + s:string = x.parse_int() (mismatch) → 1 HX3011", _build_case_parse_int_infer())
    let cbs = _count_code(diags_bs, "HX3011")
    if cbs != 1 {
        println("  FAIL: case (bs) expected 1 HX3011 (parse_int→i64: string sink mismatch, i64 sink ok), got " + to_string(cbs) + " (total=" + to_string(len(diags_bs)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3011 (parse_int typed i64 — string sink rejected, i64 sink clean)")
    }

    // (bt) ★ Lane-B parse_float inference — f64 sink ok + i64 sink mismatch → 1 HX3011.
    let diags_bt = _run_case("(bt) static-types — parse_float infer: g:f64 = x.parse_float() (ok) + k:i64 = x.parse_float() (mismatch) → 1 HX3011", _build_case_parse_float_infer())
    let cbt = _count_code(diags_bt, "HX3011")
    if cbt != 1 {
        println("  FAIL: case (bt) expected 1 HX3011 (parse_float→f64: i64 sink mismatch, f64 sink ok), got " + to_string(cbt) + " (total=" + to_string(len(diags_bt)) + ")")
        ok = false
    } else {
        println("  ok: 1 HX3011 (parse_float typed f64 — i64 sink rejected, f64 sink clean)")
    }

    // (bu) ★ Lane-B builtin bool/f64 inference — has_key/contains_key→bool +
    // mean→f64 (2 ok sinks) + bool→i64 + f64→string mismatch → 2 HX3011.
    let diags_bu = _run_case("(bu) static-types — builtin bool/f64 infer: has_key/contains_key→bool + mean→f64 (ok sinks) + bool→i64 + f64→string mismatch → 2 HX3011", _build_case_builtin_bool_f64_infer())
    let cbu = _count_code(diags_bu, "HX3011")
    if cbu != 2 {
        println("  FAIL: case (bu) expected 2 HX3011 (has_key→bool≠i64, mean→f64≠string; bool/f64 ok sinks clean), got " + to_string(cbu) + " (total=" + to_string(len(diags_bu)) + ")")
        ok = false
    } else {
        println("  ok: 2 HX3011 (has_key/contains_key→bool + mean→f64 inference locked; ok sinks clean)")
    }

    println("")
    println("══════════════════════════════════════════════")
    if ok {
        println("PASS: all type-check cases match contract.")
    } else {
        println("FAIL: type-check contract not satisfied.")
    }
    println("══════════════════════════════════════════════")
    if !ok { exit(1) }
}
