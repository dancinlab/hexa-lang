//       let ok:     i32    = g()                 // matches → stays clean
//   }
// Under the flag exactly 2 HX3011 (one ident-RHS + one call-RHS); the
// matching `i32 = g()` and the default build (flag-off) emit zero — the
// byteeq-neutral proof. Skips for unknown idents/unmodeled calls are
// covered by the soundness gates and need no positive case here.
fn _build_case_static_types_r2() -> Module {
    let f = "case_static_r2.hexa"
    // fn g() -> i32 { return 0 }
    let mut g_kids = []
    g_kids.push(_return_expr(_int_expr("0", f, 1, 20), f, 1, 13))
    let g_body = _block(g_kids, f, 1, 11)
    let item_g = _fn_item("g", [], _named_type_ref("i32"), g_body, f, 1)
    // fn h(p: i32) { let b_ident: string = p }   — ident-RHS mismatch
    let mut h_kids = []
    h_kids.push(_let_expr("b_ident|string", _ident_expr("p", f, 2, 30), f, 2, 5))
    let h_body = _block(h_kids, f, 2, 1)
    let item_h = _fn_item("h", [_param("p", "i32", f, 2, 6)], _empty_type_ref(), h_body, f, 2)
    // fn main() { let b_call: string = g();  let ok: i32 = g() }
    let bad_call  = _call_expr(_ident_expr("g", f, 3, 25), [], f, 3, 25)
    let good_call = _call_expr(_ident_expr("g", f, 4, 20), [], f, 4, 20)
    let mut m_kids = []
    m_kids.push(_let_expr("b_call|string", bad_call, f, 3, 5))
    m_kids.push(_let_expr("ok|i32", good_call, f, 4, 5))
    let m_body = _block(m_kids, f, 3, 1)
    let item_main = _fn_item("main", [], _empty_type_ref(), m_body, f, 3)
    let mut items = []
    items.push(item_g)
    items.push(item_h)
    items.push(item_main)
    return Module { file: f, items: items, imports: [] }
}

// Wall A r3 — decl/init split: a `let x: T` with NO initializer, then a
// LATER `x = <expr>` assignment whose inferred scalar RHS provably disagrees
// with the recorded declaration T (Rust E0308 check_expr_assign). Two REJECT
// shapes + one matching control, all in one fn body so the block-scoped env
// carries the declared types forward:
//   fn main() {
//       let x: i32                  // decl-only → record x : i32
//       x = "s"                     // REJECT: string ≠ i32   → HX3011
//       let y: string               // decl-only → record y : string
//       y = 5                       // REJECT: i64 ≠ string    → HX3011
//       let z: i32                  // decl-only → record z : i32
//       z = 7                       // matches (int-lit coercion) → clean
//   }
// Under the flag exactly 2 HX3011; the matching `z = 7` and the default
// build (flag-off) emit zero — the byteeq-neutral proof. Mirrors r1/r2's
// self-adapting contract, extended to the assignment rung.
fn _build_case_static_types_r3() -> Module {
    let f = "case_static_r3.hexa"
    let mut kids = []
    // let x: i32   ;   x = "s"   → mismatch
    kids.push(_let_decl_expr("x|i32", f, 2, 5))
    kids.push(_assign_expr(_ident_expr("x", f, 3, 5), _string_expr("s", f, 3, 9), f, 3, 7))
    // let y: string ;  y = 5     → mismatch
    kids.push(_let_decl_expr("y|string", f, 4, 5))
    kids.push(_assign_expr(_ident_expr("y", f, 5, 5), _int_expr("5", f, 5, 9), f, 5, 7))
    // let z: i32   ;   z = 7     → matches (clean in both modes)
    kids.push(_let_decl_expr("z|i32", f, 6, 5))
    kids.push(_assign_expr(_ident_expr("z", f, 7, 5), _int_expr("7", f, 7, 9), f, 7, 7))
    let body = _block(kids, f, 2, 1)
    let item_main = _fn_item("main", [], _empty_type_ref(), body, f, 1)
    let mut items = []
    items.push(item_main)
    return Module { file: f, items: items, imports: [] }
}

// Wall A r4 — array element-fit assign. A `let a: [i32; N]` (decl-only, the
// parser encodes the annotation as `Array:i32:4`) records its KNOWN-scalar
// element type into the block-scoped env (key `[]a`); a later `a[i] = <expr>`
// whose inferred scalar RHS provably disagrees with the element type REJECTs
// with HX3011 (Rust E0308 check_expr_index place-coercion). Two REJECT shapes
// + one matching control, all in one fn body so the block env carries the
// recorded element type forward:
//   fn main() {
//       let a: [i32; 4]            // decl-only → record []a : i32
//       a[0] = "s"                 // REJECT: string ≠ i32 element → HX3011
//       let b: [string]           // unsized → record []b : string
//       b[1] = 9                   // REJECT: i64 ≠ string element  → HX3011
//       let c: [i32; 4]           // decl-only → record []c : i32
//       c[2] = 7                   // matches (int-lit coercion)    → clean
//   }
// Under the flag exactly 2 HX3011; the matching `c[2] = 7` and the default
// build (flag-off) emit zero — the byteeq-neutral proof. Extends r3's
// self-adapting contract from the plain-ident assign to the index place.
fn _build_case_static_types_r4() -> Module {
    let f = "case_static_r4.hexa"
    let mut kids = []
    // let a: [i32; 4]   ;   a[0] = "s"   → element mismatch
    kids.push(_let_decl_expr("a|Array:i32:4", f, 2, 5))
    kids.push(_assign_expr(_index_expr(_ident_expr("a", f, 3, 5), _int_expr("0", f, 3, 7), f, 3, 6), _string_expr("s", f, 3, 12), f, 3, 10))
    // let b: [string]   ;   b[1] = 9     → element mismatch (unsized)
    kids.push(_let_decl_expr("b|Array:string", f, 4, 5))
    kids.push(_assign_expr(_index_expr(_ident_expr("b", f, 5, 5), _int_expr("1", f, 5, 7), f, 5, 6), _int_expr("9", f, 5, 12), f, 5, 10))
    // let c: [i32; 4]   ;   c[2] = 7     → matches (clean in both modes)
    kids.push(_let_decl_expr("c|Array:i32:4", f, 6, 5))
    kids.push(_assign_expr(_index_expr(_ident_expr("c", f, 7, 5), _int_expr("2", f, 7, 7), f, 7, 6), _int_expr("7", f, 7, 12), f, 7, 10))
    let body = _block(kids, f, 2, 1)
    let item_main = _fn_item("main", [], _empty_type_ref(), body, f, 1)
    let mut items = []
    items.push(item_main)
    return Module { file: f, items: items, imports: [] }
}

// Wall A r5 — struct field-type assign. A `struct Point { x: i32, y: i32 }`
// records its field names + types into the side registry. A receiver of struct
// type — a fn PARAM `p: Point` (carries `named:Point` via bind_params) OR a
// block-local `let s: Point` (recorded under `{}s`) — lets a later
// `recv.field = <expr>` recover `field`'s declared type and REJECT a scalar
// mismatch with HX3011 (Rust E0308 check_field place-coercion). Three REJECT
// shapes + one matching control:
//   struct Point { x: i32, y: i32 }
//   fn f(p: Point) {
//       let s: Point          // block-local → record {}s : named:Point
//       p.x = "s"             // REJECT: string ≠ i32 (param receiver)   → HX3011
//       s.x = "z"             // REJECT: string ≠ i32 (block-local recv)  → HX3011
//       p.y = 7               // matches (int-lit coercion)               → clean
//   }
// Under the flag exactly 2 HX3011; the matching `p.y = 7` and the default
// build (flag-off) emit zero — the byteeq-neutral proof. Extends r4's element-
// fit contract from the array place to the struct field place.
fn _build_case_static_types_r5() -> Module {
    let f = "case_static_r5.hexa"
    // struct Point { x: i32, y: i32 }
    let mut sfields = []
    sfields.push(_param("x", "i32", f, 1, 15))
    sfields.push(_param("y", "i32", f, 1, 23))
    let item_pt = _struct_item("Point", sfields, f, 1)
    // fn f(p: Point) { … }
    let mut kids = []
    kids.push(_let_decl_expr("s|Point", f, 3, 5))
    // p.x = "s"   → string ≠ i32 (param receiver)
    kids.push(_assign_expr(_field_expr(_ident_expr("p", f, 4, 5), "x", f, 4, 7), _string_expr("s", f, 4, 11), f, 4, 9))
    // s.x = "z"   → string ≠ i32 (block-local receiver)
    kids.push(_assign_expr(_field_expr(_ident_expr("s", f, 5, 5), "x", f, 5, 7), _string_expr("z", f, 5, 11), f, 5, 9))
    // p.y = 7     → matches (int-lit coercion)
