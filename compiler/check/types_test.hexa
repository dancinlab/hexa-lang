// Both-flags-ON: exactly 1 HX3004 — the return annotation lowers structured
// (r7-prep), `[1.5]` infers array[f64] (r8), and the EXISTING default-ON
// HX3004 site rejects via `_types_assignable`; `[0.0]` vs [f32] passes the
// NEW per-element literal-coercion arm. Default build / either flag alone:
// 0 (the ArrayLit infers the unknown sentinel and/or the annotation stays a
// string sentinel → tolerated — byteeq-neutral proof). A count of 2 here
// catches the coercion-FP regression (g() rejecting) exactly.
fn _build_case_static_types_r9b() -> Module {
    let f = "case_static_r9b.hexa"
    // fn f() -> [i64] { return [1.5] }   — element REJECT
    let mut bad_elems = []
    bad_elems.push(_float_expr("1.5", f, 1, 27))
    let mut f_kids = []
    f_kids.push(_return_expr(_array_lit_expr(bad_elems, f, 1, 26), f, 1, 19))
    let f_body = _block(f_kids, f, 1, 17)
    let item_f = _fn_item("f", [], _generic_array_type_ref("i64"), f_body, f, 1)
    // fn g() -> [f32] { return [0.0] }   — element literal coercion (no-FP)
    let mut ok_elems = []
    ok_elems.push(_float_expr("0.0", f, 2, 27))
    let mut g_kids = []
    g_kids.push(_return_expr(_array_lit_expr(ok_elems, f, 2, 26), f, 2, 19))
    let g_body = _block(g_kids, f, 2, 17)
    let item_g = _fn_item("g", [], _generic_array_type_ref("f32"), g_body, f, 2)
    let mut items = []
    items.push(item_f)
    items.push(item_g)
    return Module { file: f, items: items, imports: [] }
}

// static-types r9c — match literal-pattern vs scrutinee REJECT
// (HEXA_STATIC_TYPES=1; no ARRAY_LOWER dependency — scalar rung).
//   fn f(n: i64) {
//       match n {
//           "x" -> 1,   // string literal pattern vs i64 scrutinee → HX3011 (×1)
//           7   -> 2,   // matching int-literal control            → clean
//           _   -> 3    // wildcard = conservative skip class      → clean
//       }
//   }
// All arm bodies are i64 so the default-ON HX3005 body-consistency site
// stays silent in every mode — the case isolates the NEW pattern check.
// Flag-ON → exactly 1 HX3011 (the "x" pattern); default build → 0
// (byteeq-neutral proof — the discard-only pattern walk is unchanged).
fn _build_case_static_types_r9c() -> Module {
    let f = "case_static_r9c.hexa"
    let mut arms = []
    // "x" -> 1   — literal-pattern mismatch → HX3011
    arms.push(_string_expr("x", f, 3, 9))
    arms.push(_int_expr("1", f, 3, 16))
    // 7 -> 2     — matching int-literal control → clean
    arms.push(_int_expr("7", f, 4, 9))
    arms.push(_int_expr("2", f, 4, 16))
    // _ -> 3     — wildcard skip class → clean
    arms.push(_wildcard_expr(f, 5, 9))
    arms.push(_int_expr("3", f, 5, 16))
    let m = _match_expr(_ident_expr("n", f, 2, 11), arms, f, 2, 5)
    let mut kids = []
    kids.push(m)
    let body = _block(kids, f, 2, 1)
    let mut fparams = []
    fparams.push(_param("n", "i64", f, 1, 6))
    let item_f = _fn_item("f", fparams, _empty_type_ref(), body, f, 1)
    let mut items = []
    items.push(item_f)
    return Module { file: f, items: items, imports: [] }
}

// (af) segment(b) HX3005 coercion-faithfulness — match arm-body join now uses
// _types_assignable (like the if/else join). first arm body `a` fixes first_t=i32
// (typed param ident, not a literal → conservative first-arm-literal boundary
// N/A). arm `"s"` (string vs i32) still REJECTs (positive, stays); arm `3`
// (int-lit vs i32) now COERCEs. Expect exactly 1 HX3005 (pre-fix: 2) + it stays
// Error (unbanded) + 0 HX3011 (int-lit patterns `1`/`2` coerce vs i32 scrutinee).
fn _build_case_hx3005_join_coerce() -> Module {
    let f = "case_hx3005_join.hexa"
