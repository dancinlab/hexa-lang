    pf.push(_param("n", "i64", f, 1, 6))
    let item_f = _fn_item("f", pf, _named_type_ref("i64"), _block([fx, fr], f, 1, 1), f, 1)
    // fn g(xs: [i64]) -> i64 { let y = xs[0]  return 0 }   — array index → clean
    let gy = _let_expr("y", _index_expr(_ident_expr("xs", f, 5, 13), _int_expr("0", f, 5, 16), f, 5, 15), f, 5, 5)
    let gr = _return_expr(_int_expr("0", f, 6, 12), f, 6, 5)
    let mut pg = []
