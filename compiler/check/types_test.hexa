// Wall A r2 — non-literal known-type RHS (ident / call) under the same
// opt-in flag. Two REJECT shapes whose inferred scalar type provably
// disagrees with the annotation (Rust E0308):
//   fn g() -> i32 { return 0 }
//   fn h(p: i32) { let b_ident: string = p }    // ident p : i32 ≠ string
//   fn main() {
