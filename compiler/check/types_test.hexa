    let mut bad_args = []
    bad_args.push(_array_lit_expr(bad_elems, f, 2, 12))
    let bad_call = _call_expr(_ident_expr("g", f, 2, 10), bad_args, f, 2, 10)
    let mut h_kids = []
    h_kids.push(bad_call)
    let h_body = _block(h_kids, f, 2, 8)
    let item_h = _fn_item("h", [], _empty_type_ref(), h_body, f, 2)
    // fn k() { g([1, 2]) }   — element match (clean in both modes)
    let mut good_elems = []
    good_elems.push(_int_expr("1", f, 3, 13))
    good_elems.push(_int_expr("2", f, 3, 16))
    let mut good_args = []
    good_args.push(_array_lit_expr(good_elems, f, 3, 12))
    let good_call = _call_expr(_ident_expr("g", f, 3, 10), good_args, f, 3, 10)
    let mut k_kids = []
    k_kids.push(good_call)
    let k_body = _block(k_kids, f, 3, 8)
    let item_k = _fn_item("k", [], _empty_type_ref(), k_body, f, 3)
    // fn f(ws: [i64]) { ws[0] = "s" }   — r8b param-base element mismatch
    let mut f_kids = []
    f_kids.push(_assign_expr(_index_expr(_ident_expr("ws", f, 4, 19), _int_expr("0", f, 4, 22), f, 4, 21), _string_expr("s", f, 4, 27), f, 4, 25))
    let f_body = _block(f_kids, f, 4, 17)
    let item_f = _fn_item("f", [_array_param("ws", "i64", f, 4, 6)], _empty_type_ref(), f_body, f, 4)
    // fn p(vs: [i64]) { vs[1] = 7 }     — r8b matching control (int-lit coercion)
    let mut p_kids = []
    p_kids.push(_assign_expr(_index_expr(_ident_expr("vs", f, 5, 19), _int_expr("1", f, 5, 22), f, 5, 21), _int_expr("7", f, 5, 27), f, 5, 25))
    let p_body = _block(p_kids, f, 5, 17)
    let item_p = _fn_item("p", [_array_param("vs", "i64", f, 5, 6)], _empty_type_ref(), p_body, f, 5)
    let mut items = []
    items.push(item_g)
    items.push(item_h)
    items.push(item_k)
    items.push(item_f)
    items.push(item_p)
