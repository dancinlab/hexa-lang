    let diags_w = _run_case("(w) static-types r11 — struct-literal missing required field (F4 warn/strict severity) (HEXA_STATIC_TYPES)", _build_case_static_types_r11())
    let nw3017 = _count_code(diags_w, "HX3017")
    let nw3016 = _count_code(diags_w, "HX3016")
