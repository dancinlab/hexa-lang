    ok_elems.push(_float_expr("0.0", f, 2, 27))
    let mut g_kids = []
    g_kids.push(_return_expr(_array_lit_expr(ok_elems, f, 2, 26), f, 2, 19))
    let g_body = _block(g_kids, f, 2, 17)
    let item_g = _fn_item("g", [], _generic_array_type_ref("f32"), g_body, f, 2)
    let mut items = []
    items.push(item_f)
    items.push(item_g)
    return Module { file: f, items: items, imports: [] }
