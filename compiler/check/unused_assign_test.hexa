// HEXA Native Compiler — unused-assignment (rustc unused_assignments / HX3051) smoke test
//
// @version 0.1.0
// @capabilities [pure]
//
// Probe matrix for the opt-in identifier-binding unused-ASSIGNMENT check
// (HEXA_UNUSED_ASSIGN=1 / `_unused_assign_on`, compiler/check/bind.hexa). A
// function-local `let mut` WRITTEN via a pure `=` reassignment but never READ
// anywhere = rustc `unused_assignments` narrow rung ("value assigned to `x` is
// never read", warn-by-default). Each source probe runs the REAL pipeline
// (lex → parse → bind) across the ambient-flag modes:
//   * OFF (no flag)                   → 0 diagnostics of ANY code (byteeq-neutral
//                                       diag-level proof; .text byte-identity is
//                                       the pool/CI gate's job)
//   * ON  (HEXA_UNUSED_ASSIGN=1)      → expected HX3051 count per probe, Warning
//   * (HEXA_UNUSED_LET=1 too)         → also drives HX3050 so the NON-OVERLAP of
//                                       the two lints can be asserted in one run
//
//   hz_write_only      `fn f(){ let mut x=1  x=2 }`               → HX3051 ×1, HX3050 0
//   fp_written_read    `fn g(){ let mut x=1  x=2  print(x) }`     → 0 / 0
//   fp_compound        `fn c(){ let mut x=1  x+=1 }`  (`+=` is a read of x) → 0 / 0
//   fp_never_ref       `fn n(){ let x=1 }`  (never referenced)    → HX3051 0, HX3050 ×1
//   fp_underscore      `fn u(){ let mut _x=1  _x=2 }` (escape hatch) → 0 / 0
//
// The hz_write_only / fp_written_read PAIR is the core discriminator: identical
// shape, the only difference is the later `print(x)`. fp_compound proves the
// parser's `=` vs `+=` `.text` tag (a read-modify-write keeps the LHS a READ ⇒
// FP-safe). fp_never_ref proves the HX3050/HX3051 NON-OVERLAP guard (a
// never-referenced local stays HX3050; only a written-never-read local fires
// HX3051 — the two never double-fire). fp_underscore proves the rustc
// `_`-prefix escape hatch. FP=0 by resolver-completeness for locals (no external
// linkage ⇒ the read-set is complete), minus the write-as-use conflation.
//
// Run:
//   hexa run compiler/check/unused_assign_test.hexa                              (OFF sweep)
//   HEXA_UNUSED_ASSIGN=1 HEXA_UNUSED_LET=1 hexa run compiler/check/unused_assign_test.hexa

import "../lex/lexer.hexa"
import "../parse/parser.hexa"
import "../parse/ast.hexa"
import "../lex/tokens.hexa"
import "../diag/catalog.hexa"
import "../ir/hir.hexa"
import "./bind.hexa"

// ── pipeline driver ──────────────────────────────────────────

fn _compile_probe(name: string, src: string) -> array {
    let file = name + ".hexa"
    let toks = lex(src, file)
    let m = parse(toks, file)
    return bind(m)
}

fn _count_code(diags: array, code: string) -> i64 {
    let mut i = 0
    let mut n = 0
    while i < len(diags) {
        let d = diags[i]
        if d.code == code { n = n + 1 }
        i = i + 1
    }
    return n
}

fn _count_warn_band(diags: array) -> i64 {
    let mut i = 0
    let mut n = 0
    while i < len(diags) {
        let d = diags[i]
        if d.severity == Severity::Warning { n = n + 1 }
        i = i + 1
    }
    return n
}

fn _print_diags(diags: array) {
    let mut i = 0
    while i < len(diags) {
        let d = diags[i]
        let sp = d.span
        println("      [" + to_string(i) + "] " + d.code + " @ "
                + sp.file + ":" + to_string(sp.line) + ":" + to_string(sp.col)
                + " — " + d.message)
        i = i + 1
    }
}

// Expectations branch on the AMBIENT flags (missing_return_test convention —
// `setenv` does not feed `env()` in the stage0 runtime, so flags must be set on
// the PROCESS). HX3051 is gated on HEXA_UNUSED_ASSIGN; HX3050 on HEXA_UNUSED_LET.
// A probe declares BOTH ON-mode counts; each is applied only when its flag is
// present. ON-mode also asserts zero stray codes and Warning-band == 3050+3051.
fn _run_probe(label: string, src: string, want3050_on: i64, want3051_on: i64) -> bool {
    let assign_on = env("HEXA_UNUSED_ASSIGN") == "1"
    let let_on = env("HEXA_UNUSED_LET") == "1"
    let mut want3050 = 0
    let mut want3051 = 0
    if let_on { want3050 = want3050_on }
    if assign_on { want3051 = want3051_on }
    let mut ok = true
    println("")
    println("── " + label + " (expect HX3050 ×" + to_string(want3050)
            + ", HX3051 ×" + to_string(want3051) + ") ──")
    let d = _compile_probe(label, src)
    let n50 = _count_code(d, "HX3050")
    let n51 = _count_code(d, "HX3051")
    let other = len(d) - n50 - n51
    _print_diags(d)
    if n50 != want3050 {
        println("  FAIL: HX3050 = " + to_string(n50) + ", want " + to_string(want3050))
        ok = false
    }
    if n51 != want3051 {
        println("  FAIL: HX3051 = " + to_string(n51) + ", want " + to_string(want3051))
        ok = false
    }
    if other != 0 {
        println("  FAIL: stray non-HX3050/HX3051 diagnostics = " + to_string(other))
        ok = false
    }
    // Every emitted HX3050/HX3051 is Warning-band; the probes emit no other code.
    let wb = _count_warn_band(d)
    if wb != want3050 + want3051 {
        println("  FAIL: warn-band = " + to_string(wb) + ", want " + to_string(want3050 + want3051))
        ok = false
    }
    if ok { println("  ok: HX3050 ×" + to_string(want3050) + ", HX3051 ×" + to_string(want3051)) }
    return ok
}

// ── source probes ────────────────────────────────────────────

fn _src_hz_write_only() -> string {
    let mut s = "fn f() {\n"
    s = s + "    let mut x = 1\n"
    s = s + "    x = 2\n"
    s = s + "}\n"
    return s
}

fn _src_fp_written_read() -> string {
    let mut s = "fn g() {\n"
    s = s + "    let mut x = 1\n"
    s = s + "    x = 2\n"
    s = s + "    print(x)\n"
    s = s + "}\n"
    return s
}

fn _src_fp_compound() -> string {
    let mut s = "fn c() {\n"
    s = s + "    let mut x = 1\n"
    s = s + "    x += 1\n"
    s = s + "}\n"
    return s
}

fn _src_fp_never_ref() -> string {
    let mut s = "fn n() {\n"
    s = s + "    let x = 1\n"
    s = s + "}\n"
    return s
}

fn _src_fp_underscore() -> string {
    let mut s = "fn u() {\n"
    s = s + "    let mut _x = 1\n"
    s = s + "    _x = 2\n"
    s = s + "}\n"
    return s
}

// ── driver ───────────────────────────────────────────────────

fn main() {
    println("══════════════════════════════════════════════")
    println("  unused-assignment (unused_assignments / HX3051) — S2 binding")
    let mut mode = "OFF (byteeq-neutral sweep)"
    let assign_on = env("HEXA_UNUSED_ASSIGN") == "1"
    let let_on = env("HEXA_UNUSED_LET") == "1"
    if assign_on && let_on { mode = "ON (HEXA_UNUSED_ASSIGN=1 + HEXA_UNUSED_LET=1)" }
    else if assign_on { mode = "ON (HEXA_UNUSED_ASSIGN=1)" }
    else if let_on { mode = "HEXA_UNUSED_LET=1 only" }
    println("  mode: " + mode)
    println("══════════════════════════════════════════════")

    let mut ok = true
    if !_run_probe("hz_write_only", _src_hz_write_only(), 0, 1) { ok = false }
    if !_run_probe("fp_written_read", _src_fp_written_read(), 0, 0) { ok = false }
    if !_run_probe("fp_compound", _src_fp_compound(), 0, 0) { ok = false }
    if !_run_probe("fp_never_ref", _src_fp_never_ref(), 1, 0) { ok = false }
    if !_run_probe("fp_underscore", _src_fp_underscore(), 0, 0) { ok = false }

    println("")
    if ok {
        println("ALL PASS — HX3051 hz fires ×1 on write-only, FP controls 0, HX3050 non-overlap holds, OFF-sweep empty")
    } else {
        println("FAILURES — see above")
        exit(1)
    }
}
