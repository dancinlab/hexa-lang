        ExprKind::LiteralString -> false,
        ExprKind::LiteralBool -> false,
        ExprKind::LiteralChar -> false,
        ExprKind::Ident -> false,
        ExprKind::AtlasRef -> false,
        ExprKind::Call -> false,
        ExprKind::BinOp -> false,
        ExprKind::UnOp -> false,
        ExprKind::Block -> false,
        ExprKind::If -> false,
        ExprKind::While -> false,
        ExprKind::For -> false,
        ExprKind::Match -> false,
        ExprKind::Return -> false,
        ExprKind::Break -> false,
        ExprKind::Continue -> false,
        ExprKind::Let -> false,
        ExprKind::Assign -> false,
        ExprKind::Field -> false,
        ExprKind::Index -> false,
        ExprKind::ArrayLit -> false,
        ExprKind::StructLit -> false,
        ExprKind::EnumPath -> false,
        ExprKind::Try -> false,
        ExprKind::Throw -> false,
        ExprKind::Closure -> false
    }
}

// ── Diagnostic emit ──────────────────────────────────────────

fn _emit_hx2001(name: string, span: Span, suggest: string, out: array) {
    let mut b = diag_new("HX2001")
    b = diag_span(b, span)
    b = diag_arg(b, "name", name)
    if len(suggest) > 0 { b = diag_suggest(b, suggest) }
    out.push(diag_emit(b))
}

// RFC-074 Phase 2 — HX2004 emitter: enum variant payload arity mismatch.
fn _emit_hx2004(enum_name: string, variant_name: string, expected: i64, actual: i64, span: Span, out: array) {
    let mut b = diag_new("HX2004")
    b = diag_span(b, span)
    b = diag_arg(b, "enum_name", enum_name)
    b = diag_arg(b, "variant_name", variant_name)
    b = diag_arg(b, "expected", to_string(expected))
    b = diag_arg(b, "actual", to_string(actual))
    let mut plural = "components"
    if expected == 1 { plural = "component" }
    b = diag_arg(b, "plural", plural)
    out.push(diag_emit(b))
}

// #2663 — HX2006 emitter: assignment to an immutable (`let`, no `mut`) binding.
// Turns the silent codegen drop (→ runtime infinite loop) into a VISIBLE
// diagnostic. The fix-it (catalog) is to add `mut` to the declaration.
//
// Default severity is Warning (catalog) so the ~1033 pre-existing in-tree
// non-`mut` writes do not brick the self-host build before stdlib migration.
// `HEXA_STRICT_LET=1` escalates it to a hard Error — same opt-in gate the
// legacy self/type_checker.hexa already honours — so strict builds / CI can
// enforce immutability. The escalation rebuilds the emitted Diagnostic with an
// Error severity (the catalog spec drives the default via diag_emit).
fn _emit_hx2006(name: string, span: Span, out: array) {
    let mut b = diag_new("HX2006")
    b = diag_span(b, span)
    b = diag_arg(b, "name", name)
    let d = diag_emit(b)
    if env("HEXA_STRICT_LET") == "1" {
        out.push(Diagnostic {
            code: d.code,
            severity: Severity::Error,
            stage: d.stage,
            span: d.span,
            message: d.message,
            note: d.note,
            suggest: d.suggest,
            fixit: d.fixit,
            related: d.related
        })
        return
    }
    out.push(d)
}

// HX3050 — unused local `let` (Rust `unused_variables`). Warning band,
// opt-in (`_unused_let_on` / HEXA_UNUSED_LET). Mirrors _emit_hx2001's plain
// warning-emit: no fix-it, single `name` arg. Emitted from the bind() end-of-
// pass sweep for every accumulated candidate whose index went un-referenced.
fn _emit_hx3050(name: string, span: Span, out: array) {
    let mut b = diag_new("HX3050")
    b = diag_span(b, span)
    b = diag_arg(b, "name", name)
    out.push(diag_emit(b))
}

// ── `let` text decoder ──────────────────────────────────────
// parse_let_expr stashes the binding name in `text`, prefixed with
// "mut:" if it was declared mutable. Strip the prefix for binding.

// RFC 085 Step B (2026-05-27): also strips the optional `|<type-name>`
// suffix added by parse_let_expr for `let sm: T` syntax. Mirror of
// ast_to_hir._hir_let_name — same logic so bind / hir layers see the
// same effective let-name string.
fn _bind_let_name(t: string) -> string {
    let chars = t.chars()
    let n = len(chars)
    let mut start = 0
    if n >= 4 && chars[0] == 'm' && chars[1] == 'u' && chars[2] == 't' && chars[3] == ':' {
        start = 4
    }
    let mut out = ""
    let mut i = start
    while i < n {
        if chars[i] == '|' { break }
        out = out + to_string(chars[i])
        i = i + 1
    }
    return out
}

// True when the let-text carries the `mut:` prefix (declared `let mut`).
// Mirror of _bind_let_name's prefix detection so the two stay in lockstep.
fn _bind_let_is_mut(t: string) -> bool {
    let chars = t.chars()
    let n = len(chars)
    if n >= 4 && chars[0] == 'm' && chars[1] == 'u' && chars[2] == 't' && chars[3] == ':' {
        return true
    }
    return false
}

// EnumPath text encodes "Enum::Variant"; we only need the "Enum" prefix to
// look up — the variant is intra-enum and not a free identifier.
fn _enum_head(t: string) -> string {
    let chars = t.chars()
    let n = len(chars)
    let mut i = 0
    let mut out = ""
    while i < n - 1 {
        if chars[i] == ':' && chars[i + 1] == ':' {
            return out
        }
        out = out + to_string(chars[i])
        i = i + 1
    }
    if i < n {
        out = out + to_string(chars[i])
    }
    return out
}

// RFC-074 Phase 2 — extract the variant tail from "Enum::Variant" text.
// Returns "" if no "::" separator is found.
fn _enum_variant_tail(t: string) -> string {
    let chars = t.chars()
    let n = len(chars)
    let mut i = 0
    while i < n - 1 {
        if chars[i] == ':' && chars[i + 1] == ':' {
            let mut out = ""
            let mut j = i + 2
            while j < n {
                out = out + to_string(chars[j])
                j = j + 1
            }
            return out
        }
        i = i + 1
    }
    return ""
}

// ── Walker (collect-don't-stop) ──────────────────────────────
//
// Returns an updated BindScope (since stage0 has no by-reference structs we
// thread state through return values). `out` is an `array` — Diagnostic
// pushes mutate the underlying buffer the caller passed in.

fn _bind_walk_expr(e: Expr, in_sc: BindScope, mod_file: string, out: array) -> BindScope {
    let mut sc = in_sc

    if _bind_is_ident_kind(e.kind) {
        if len(e.text) > 0 && e.text != "_" {
            let hit = _bind_lookup(sc, e.text)
            if hit.index < 0 {
                let suggest = _suggest_name(sc, e.text, 2)
                _emit_hx2001(e.text, e.span, suggest, out)
            }
            // HX3050 — mark the resolved binding USED. This is the SINGLE
            // value-reference choke (assign-LHS, call-callee, field-receiver
            // all descend here), so the used-set is resolver-complete ⇒ FP=0.
            if _unused_let_on && hit.index >= 0 { _unused_used_ids.push(hit.index) }
        }
        return sc
    }

    if _is_wildcard_kind(e.kind) {
        return sc
    }

    if _is_field_kind(e.kind) {
        // Field access: child[0] is the receiver; field name is `text` and
        // is NOT a free identifier — skip it.
        if len(e.children) > 0 {
            sc = _bind_walk_expr(e.children[0], sc, mod_file, out)
        }
        return sc
    }

    if _is_struct_lit_kind(e.kind) {
        // Resolve the struct type name (text) at top level …
        if len(e.text) > 0 {
            let hit = _bind_lookup(sc, e.text)
            if hit.index < 0 {
                let suggest = _suggest_name(sc, e.text, 2)
                _emit_hx2001(e.text, e.span, suggest, out)
            }
        }
        // … and the field VALUES. The field-name child wraps the value as
        // its only sub-child (parse_struct_lit_after_name). Field names are
        // NOT free identifiers, so we descend into child.children only.
        let mut i = 0
        while i < len(e.children) {
            let f = e.children[i]
            let mut j = 0
            while j < len(f.children) {
                sc = _bind_walk_expr(f.children[j], sc, mod_file, out)
                j = j + 1
            }
            i = i + 1
        }
        return sc
    }

    if _is_enum_path_kind(e.kind) {
        let head = _enum_head(e.text)
        if len(head) > 0 {
            let hit = _bind_lookup(sc, head)
            if hit.index < 0 {
                let suggest = _suggest_name(sc, head, 2)
                _emit_hx2001(head, e.span, suggest, out)
            }
            // RFC-074 Phase 2 — payload arity check (construction site).
            // Compare the actual children count against the declared `typs`
            // arity from the enum registry. Skip when the enum/variant is
            // unknown (registry returns -1) — those are caught by HX2001 on
            // the head above, no need to double-emit.
            let tail = _enum_variant_tail(e.text)
            if len(tail) > 0 {
                let expected = _bind_lookup_variant_arity(head, tail)
                if expected >= 0 {
                    let actual = len(e.children)
                    if expected != actual {
                        _emit_hx2004(head, tail, expected, actual, e.span, out)
                    }
                }
            }
        }
        // Payload children (when used as an expression, not pattern).
        let mut i = 0
        while i < len(e.children) {
            sc = _bind_walk_expr(e.children[i], sc, mod_file, out)
            i = i + 1
        }
        return sc
    }

    if _is_let_kind(e.kind) {
        // Walk RHS first (let x = RHS) — RHS cannot reference `x`.
        let mut i = 0
        while i < len(e.children) {
            sc = _bind_walk_expr(e.children[i], sc, mod_file, out)
            i = i + 1
        }
        let nm = _bind_let_name(e.text)
        if len(nm) > 0 {
            sc = _define_mut(sc, nm, mod_file, _bind_let_is_mut(e.text))
            // HX3050 — accumulate this function-local `let` as an unused-var
            // candidate. This is the ONLY let-expr define site; params /
            // for-iter / catch / match-binder / closure-param bind elsewhere
            // and are excluded. The just-minted dense index == sc.next_index-1
            // (post-_define_mut increment). `_`-prefix = rustc escape hatch.
            if _unused_let_on {
                let nmc = nm.chars()
                if len(nmc) > 0 && nmc[0] != '_' {
                    _unused_cand_ids.push(sc.next_index - 1)
                    _unused_cand_names.push(nm)
                    _unused_cand_spans.push(e.span)
                }
            }
        }
        return sc
    }

    if _bind_is_block_kind(e.kind) {
        sc = _push_scope(sc)
        let mut i = 0
        while i < len(e.children) {
            sc = _bind_walk_expr(e.children[i], sc, mod_file, out)
            i = i + 1
        }
        sc = _pop_scope(sc)
        return sc
    }

    if _is_for_kind(e.kind) {
        // children[0] = iter, children[1] = body. Iter binding is on `text`.
        if len(e.children) >= 1 {
            sc = _bind_walk_expr(e.children[0], sc, mod_file, out)
        }
        sc = _push_scope(sc)
        if len(e.text) > 0 {
            sc = _define(sc, e.text, mod_file)
        }
        if len(e.children) >= 2 {
            sc = _bind_walk_expr(e.children[1], sc, mod_file, out)
        }
        sc = _pop_scope(sc)
        return sc
    }

    if _bind_is_try_kind(e.kind) {
        // children[0] = try_body_block, children[1] = catch_body_block.
        // catch_var binding (e.text, may be "_") is visible ONLY inside
        // catch_body — mirror self/hexa_full.hexa::try_catch scoping.
        if len(e.children) >= 1 {
            sc = _push_scope(sc)
            sc = _bind_walk_expr(e.children[0], sc, mod_file, out)
            sc = _pop_scope(sc)
        }
        if len(e.children) >= 2 {
            sc = _push_scope(sc)
            if len(e.text) > 0 && e.text != "_" {
                sc = _define(sc, e.text, mod_file)
            }
            sc = _bind_walk_expr(e.children[1], sc, mod_file, out)
            sc = _pop_scope(sc)
        }
        return sc
    }

    if _bind_is_closure_kind(e.kind) {
        // RFC C1 — closure-expression `fn(p0, p1, ...) { body }`.
        // children = [param_0 .. param_{n-1}, body_block]; the body block is
        // the LAST child. Closure params open a NEW scope; the params are
        // visible only inside the body. Free variables referenced in the
        // body that are NOT params resolve up the enclosing scope chain
        // (normal _bind_lookup) — so a body ident like `captured` binds to
        // the outer definition and does NOT error. C2 will walk the body to
        // collect that capture set; C1 only guarantees binding succeeds.
        sc = _push_scope(sc)
        let n_children = len(e.children)
        // every child except the last is a param Ident node (text = name,
        // possibly `mut:`-prefixed). Define each into the closure scope.
        let mut pi = 0
        while pi < n_children - 1 {
            let pnode = e.children[pi]
            let pname = _bind_let_name(pnode.text)
            if len(pname) > 0 && pname != "_" {
                sc = _define_mut(sc, pname, mod_file, _bind_let_is_mut(pnode.text))
            }
            pi = pi + 1
        }
        // walk the body block (last child) with params + outer scope visible.
        if n_children >= 1 {
            sc = _bind_walk_expr(e.children[n_children - 1], sc, mod_file, out)
        }
        sc = _pop_scope(sc)
        return sc
    }

    if _bind_is_match_kind(e.kind) {
        // children layout: [scrutinee, pat0, body0, pat1, body1, ...]
        if len(e.children) >= 1 {
            sc = _bind_walk_expr(e.children[0], sc, mod_file, out)
        }
        let mut i = 1
        while i + 1 < len(e.children) {
            let pat = e.children[i]
            let body = e.children[i + 1]
            sc = _push_scope(sc)
            // RFC pattern guards — a guarded arm wraps its pattern as a
            // "match_guard" carrier (children [inner_pattern, guard]). Bind
            // the inner pattern's payload binders FIRST, then walk the guard
            // in the same arm scope so `Some(n) if n > 0` resolves `n`
            // (no spurious HX2001). The guard sees binders; the body sees
            // both. Unguarded arms take the legacy path unchanged.
            if ast_is_match_guard(pat) {
                sc = _bind_pattern(pat.children[0], sc, mod_file, out)
                sc = _bind_walk_expr(pat.children[1], sc, mod_file, out)
            } else {
                sc = _bind_pattern(pat, sc, mod_file, out)
            }
            sc = _bind_walk_expr(body, sc, mod_file, out)
            sc = _pop_scope(sc)
            i = i + 2
        }
        return sc
    }

    // `x as T`: children[1] is the target TYPE (an Ident carrying the type
    // name; STEP1 parses the cast as a BinOp text="as"). The type is NOT a
    // value reference — name-resolving it raised a spurious HX2001
    // `undefined name i64` on `len(..) as i64`. Walk only the casted value.
    let _is_as_cast = match e.kind {
        ExprKind::BinOp -> e.text == "as",
        _ -> false
    }
    if _is_as_cast {
        if len(e.children) > 0 {
            sc = _bind_walk_expr(e.children[0], sc, mod_file, out)
        }
        return sc
    }

    // Assignment (`x = rhs`, `x += rhs`, …): #2663 — a write to a non-`mut`
    // `let` binding was silently dropped by codegen (no diagnostic, runtime
    // hang). Enforce immutability HERE, at S2, so the write is a clean compile
    // error instead. We only flag the simple case the codegen miscompiles: the
    // LHS is a bare FUNCTION-LOCAL Ident whose innermost binding resolves to an
    // immutable `let` (_bind_is_mut == 0). Field/index LHS (`p.f = …`,
    // `a[i] = …`), module-level globals (== 2, lowered to a global slot — not
    // miscompiled, and the parser's per-global init-assign synthesis lives
    // there too) and unknown targets (== -1) are all left to other passes.
    if _bind_is_assign_kind(e.kind) {
        // Walk both sides first so name-resolution (HX2001) still runs.
        let mut k = 0
        while k < len(e.children) {
            sc = _bind_walk_expr(e.children[k], sc, mod_file, out)
            k = k + 1
        }
        if len(e.children) >= 1 {
            let lhs = e.children[0]
            if _bind_is_ident_kind(lhs.kind) && len(lhs.text) > 0 && lhs.text != "_" {
                if _bind_is_mut(sc, lhs.text) == 0 {
                    _emit_hx2006(lhs.text, lhs.span, out)
                }
            }
        }
        return sc
    }

    // Generic recurse (Call, BinOp, UnOp, If, While, Return, Index,
    // literals — all delegate to children).
    let mut i = 0
    while i < len(e.children) {
        sc = _bind_walk_expr(e.children[i], sc, mod_file, out)
        i = i + 1
    }
    return sc
}

// Bind pattern variables (binders + EnumPath payload binders). Pattern shape
// from parse_match_pattern:
//   - Wildcard          : binds nothing
//   - LiteralInt/Bool/… : binds nothing (constant compare)
//   - Ident             : a fresh binder for the whole scrutinee
//   - EnumPath          : Variant or Variant(arg) — child Idents are binders
//   - StructLit         : struct-destructure `Name { f, g: b }` — each field
//                         child carries a binder ident (parse_struct_pattern)
fn _bind_pattern(p: Expr, in_sc: BindScope, mod_file: string, out: array) -> BindScope {
    let mut sc = in_sc

    if _is_wildcard_kind(p.kind) { return sc }

    if _bind_is_ident_kind(p.kind) {
        if len(p.text) > 0 && p.text != "_" {
            sc = _define(sc, p.text, mod_file)
        }
        return sc
    }

    if _is_enum_path_kind(p.kind) {
        // We DON'T resolve the enum head here — pattern context permits
        // unresolved nominal types in stage0 (S3 will type-check them).
        // Instead bind every Ident-like payload child as a fresh binder.
        //
        // RFC-074 Phase 2 — match-arm arity check. The pattern's
        // children[] count must equal the variant's declared payload arity.
        let pat_head = _enum_head(p.text)
        let pat_tail = _enum_variant_tail(p.text)
        if len(pat_head) > 0 && len(pat_tail) > 0 {
            let pat_expected = _bind_lookup_variant_arity(pat_head, pat_tail)
            if pat_expected >= 0 {
                let pat_actual = len(p.children)
                if pat_expected != pat_actual {
                    _emit_hx2004(pat_head, pat_tail, pat_expected, pat_actual, p.span, out)
                }
            }
        }
        let mut i = 0
        while i < len(p.children) {
            let c = p.children[i]
            if _bind_is_ident_kind(c.kind) {
                if len(c.text) > 0 && c.text != "_" {
                    sc = _define(sc, c.text, mod_file)
                }
            } else {
                // Nested patterns aren't produced by parse_match_pattern
                // today, but be defensive — recurse so we don't drop binders.
                sc = _bind_pattern(c, sc, mod_file, out)
            }
            i = i + 1
        }
        return sc
    }

    if _is_struct_lit_kind(p.kind) {
        // Struct-destructure pattern `Name { f, g: b }` (parse_struct_pattern
        // emits a StructLit-shaped node). We DON'T resolve the struct head here
        // — pattern context permits unresolved nominal types in stage0 (same
        // policy as the EnumPath pattern arm above; S3 type-checks the head).
        // Instead DEFINE each field binder: the inner ident of each field child
        // is an INTRODUCTION, not a reference, so we must not _bind_walk it
        // (that path would raise a spurious HX2001 on the binder name).
        let mut i = 0
        while i < len(p.children) {
            let f = p.children[i]
            let mut bind_name = f.text
            if len(f.children) > 0 && _bind_is_ident_kind(f.children[0].kind) {
                bind_name = f.children[0].text
            }
            if len(bind_name) > 0 && bind_name != "_" {
                sc = _define(sc, bind_name, mod_file)
            }
            i = i + 1
        }
        return sc
    }

    // Literal / arbitrary expr pattern — no binders, but still walk so that
    // any `Ident` references inside (rare) get checked against scope.
    sc = _bind_walk_expr(p, sc, mod_file, out)
    return sc
}

// ── ItemKind probes ──────────────────────────────────────────

fn _is_fn_kind(k: ItemKind) -> bool {
    return match k {
        ItemKind::Fn -> true,
        ItemKind::Let -> false,
        ItemKind::Struct -> false,
        ItemKind::Enum -> false,
        ItemKind::Import -> false
    }
}

fn _is_let_item_kind(k: ItemKind) -> bool {
    return match k {
        ItemKind::Let -> true,
        ItemKind::Fn -> false,
        ItemKind::Struct -> false,
        ItemKind::Enum -> false,
        ItemKind::Import -> false
    }
}

fn _is_import_kind(k: ItemKind) -> bool {
    return match k {
        ItemKind::Import -> true,
        ItemKind::Fn -> false,
        ItemKind::Let -> false,
        ItemKind::Struct -> false,
        ItemKind::Enum -> false
    }
}

// RFC-074 Phase 2 — used to gate registry population in _bind_register_enum_item.
fn _is_enum_kind(k: ItemKind) -> bool {
    return match k {
        ItemKind::Enum -> true,
        ItemKind::Fn -> false,
        ItemKind::Let -> false,
        ItemKind::Struct -> false,
        ItemKind::Import -> false
    }
}

// ── Public entry ─────────────────────────────────────────────

// Built-in identifiers that are always in scope (host runtime intrinsics).
// Stage1 punch list — without this list every builtin call surfaces as
// HX2001 (unknown callee) and every stage-2 self-compile attempt floods
// thousands of false-positive diagnostics. Names are kept as a flat array
// so the prelude registration is O(N) once per module bind. Method-style
// builtins (.push, .trim, .substring) are NOT in this list — they are
// resolved as field accesses, not free identifiers.
fn _bind_builtin_names() -> [string] {
    // Full host-runtime builtin set — faithfully mirrored from the
    // proven legacy registry self/codegen_c2.hexa::_is_builtin_name
    // (156 names) unioned with the prior new-binder set. The prior list
    // had only 45 entries → ~138 host builtins (net_*/term_*/pty_*/
    // regex_*/tensor_*/crypto/json_*/…) that compiler/+self/ call were
    // unresolved → the `<callee>` 594 HX2001 flood in stage-2 self-
    // compile. ("true"/"false" carried from legacy are harmless as
    // scope names — the parser emits KwTrue/KwFalse, never Ident.)
    return [
        // Free-call host builtins missing from the legacy-mirrored set —
        // used as `join(a,b)` / `has_key(m,k)` / `append_file(p,s)` /
        // `char_code_at(s,i)` in compiler/+self/ (legacy codegen_c2
        // _is_builtin_name free-call forms; runtime hexa_str_char_code_at
        // / hexa_map_contains_key / rt_append_file). Last HX2001 residual.
        "append_file", "char_code_at", "has_key", "join",
        // Step 5 codegen-inline builtins (4th re-land after e8c2dc1c wipe).
        "__arr_raw_len", "__arr_set_cap", "__fd_write_bytes", "__map_raw_len", "__str_raw_len",
        // RT-NATIVE UNLOCK-2 (2026-06-16): native tag-read intrinsic — `__hx_tag(v)`
        // reads the HexaVal tag inline (arm64_darwin.hexa STMT_CALL special-case;
        // C-transpile self/codegen.hexa → hexa_int(HX_TAG(v))). Lets .hexa port
        // hexa_type_of/eq/truthy natively (Z2c dispatch core) instead of `bl _hexa_type_of`.
        "__hx_tag", "__hx_payload_eq", "__hx_payload_nz",
        "__hx_payload_lt", "__hx_payload_gt", "__hx_payload_le", "__hx_payload_ge",
        "__hx_payload_eq", "__hx_payload_ne",
        // UNSIGNED magnitude compares (libm-leaf fdlibm fmod): __hx_payload_ult/ule
        // = unsigned < / <= (x86_64 setb/setbe · arm64 lo/ls). ADD-only.
        "__hx_payload_ult", "__hx_payload_ule",
        "__hx_payload_add", "__hx_payload_sub", "__hx_payload_mul",
        "__hx_payload_div", "__hx_payload_mod",
        "__hx_payload_and", "__hx_payload_xor", "__hx_payload_or",
        // LOGICAL bit-shifts on the raw payload word (libm-leaf fdlibm fmod port):
        // __hx_payload_shl = v<<n, __hx_payload_shr = v>>n ZERO-FILL (logical, NOT
        // the BinOp `>>` arithmetic sar). x86_64 shl/shr · arm64 lslv/lsrv. ADD-only
        // (compiler never calls them); parses as an ordinary identifier-call (frozen
        // 151c52c8-safe, like the existing __hx_payload_* family).
        "__hx_payload_shl", "__hx_payload_shr",
        "__hx_payload_fadd", "__hx_payload_fsub", "__hx_payload_fmul", "__hx_payload_fdiv",
        "__hx_payload_flt", "__hx_payload_fgt", "__hx_payload_fle", "__hx_payload_fge",
        // FLOAT→INT truncate (libm-leaf musl sin argument reduction `(int32_t)fn`):
        // __hx_payload_f2i reinterprets the payload word as a double and truncates
        // toward zero into a signed integer (x86_64 cvttsd2si · arm64 fcvtzs). The
        // dual __hx_payload_i2f converts a signed-int payload to a double (x86_64
        // cvtsi2sd · arm64 scvtf) — distinct from __hx_to_double which is a tagged
        // int-or-float coercion; i2f takes a RAW int payload. ADD-only, frozen
        // 151c52c8-safe identifier-calls (compiler never emits them).
        "__hx_payload_f2i", "__hx_payload_i2f",
        "__hx_str_byte", "__hx_to_double", "__hx_arr_len", "__hx_syscall0", "__hx_syscall6", "__hx_ptr_store64", "__hx_ptr_load64", "__hx_ptr_store32", "__hx_ptr_load32", "__hx_ptr_store8", "__hx_ptr_load8",
        // RFC inline-asm rung 1 (2026-06-27): `__hx_asm_nop()` — the first
        // named-opcode inline-assembly intrinsic. 0-arg leaf that emits a literal
        // `nop` (x86 0x90 / arm64 0xd503201f) inline and returns int HexaVal 0, so
        // it composes as an ordinary expression. Extends the `__hx_syscall0` raw-
        // instruction-emit path (state/rfc_inline_asm.md). ADD-only: the compiler
        // never calls it -> DEFAULT emit byte-identical, gen3==gen4 preserved.
        "__hx_asm_nop",
        // RFC inline-asm rung 2 (2026-06-27): `__hx_asm("<op>")` — the generalized
        // named-opcode passthrough. ONE intrinsic accepts a STRING-LITERAL opcode
        // and lowers it through a fixed whitelist {nop, pause, fence} to the per-
        // target instruction (x86: nop/pause/mfence · arm64: nop/yield/dmb ish),
        // returning int HexaVal 0 so it composes as an ordinary expression. The
        // literal-template rule mirrors Rust `asm!`/GCC `__asm__`/Zig `asm` (the
        // instruction text is a compile-time literal, never a runtime value).
        // 1 string arg, opt-in HEXA_INLINE_ASM (default-OFF). ADD-only + env-gated:
        // the compiler never calls it -> DEFAULT emit byte-identical, gen3==gen4
        // preserved. Generalizes `__hx_asm_nop` (which stays for back-compat).
        "__hx_asm",
        // RFC061 Route C 2nd-return-register (2026-06-27): `__hx_syscall6_out2(
        // num, a0..a5, outptr)` issues ONE syscall and writes BOTH return
        // registers + the carry/error flag into a caller-supplied scratch:
        // outptr[0]=x0/rax (1st return), outptr[8]=x1/rdx (2nd return),
        // outptr[16]=1 if the BSD carry-flag (darwin error) was set else 0. The
        // single-result __hx_syscall6 exposes only x0, so it cannot serve the
        // darwin 2nd-return-register syscalls pipe(2)/fork(2) (fds in x0/x1;
        // child disambiguated by x1==1). The caller reads the slots back with the
        // already-whitelisted __hx_ptr_load64. arm64 + x86_64 STMT_CALL
        // special-case (mirror of __hx_syscall6 + dual-store). ADD-only leaf:
        // the compiler never calls it.
        "__hx_syscall6_out2",
        // RFC061 Route C Wall 2-b — extern-data named-data reloc (2026-06-27):
        // `__hx_environ_ptr()` is a 0-arg intrinsic that loads the ADDRESS of the
        // libc `extern char **environ` global THROUGH THE GOT (x86_64 `mov rax,
        // [rip+environ@GOTPCREL]` → R_X86_64_(REX_)GOTPCREL; arm64 `adrp/ldr
        // …@GOTPAGE/@GOTPAGEOFF` → ARM64_RELOC_GOT_LOAD_*), boxed as a TAG_INT
        // payload. It returns `&environ` (char***), so ONE __hx_ptr_load64 yields
        // the char** array base — letting hxlcl_getenv walk the environment with a
        // pure byte-compare instead of the libc-`environ`-global shim body. This is
        // the FIRST named-data (vs named-text/call) GOT reloc a Route C body needs;
        // it is frozen-SAFE (parses as an ordinary identifier-call, like the 24
        // syscall intrinsics + __hx_syscall6_out2) and DCE-never-drops the STMT_CALL.
        // arm64 + x86_64 STMT_CALL special-case. ADD-only: the compiler never calls it.
        "__hx_environ_ptr",
        // RFC061 Route C Wall 3-b — std-stream extern-data reloc (2026-06-27):
        // `__hx_stderr_ptr()` / `__hx_stdout_ptr()` are 0-arg intrinsics that load
        // the ADDRESS of the libc standard-stream FILE* globals (`extern FILE *stderr`
        // / `*stdout`) THROUGH THE GOT — the named-data sibling of __hx_environ_ptr,
        // keyed to the per-target libc symbols (x86_64-linux glibc `stderr`/`stdout`
        // direct; darwin `__stderrp`/`__stdoutp`, the `#define stderr __stderrp`
        // macro target). Each returns `&stderr` (FILE**), so ONE __hx_ptr_load64
        // yields the `stderr` FILE* value itself — letting hxlcl_fputs/hxlcl_fputc
        // replicate the frozen body's `if (fp == (void*)stderr) fd = 2;` standard-
        // stream detection (self/runtime_emit_full.hexa:1014-1024) with a pure
        // pointer-load + compare, instead of the libc-`stderr`-global shim body.
        // These are the FIRST per-TARGET-NAMED named-data GOT relocs (the symbol
        // STRING differs by platform, unlike `environ`); frozen-SAFE (parse as
        // ordinary identifier-calls, like the 24 syscall intrinsics + __hx_environ_ptr)
        // and DCE-never-drops the STMT_CALL. arm64 + x86_64 STMT_CALL special-case.
        // ADD-only: the compiler never calls them.
        "__hx_stderr_ptr", "__hx_stdout_ptr",
        // RFC061 Route C Wall 3-c (2026-06-27): `__hx_static_slot(slot_id, size_bytes)`
        // — DEFINE a self-static, zero-initialized file-local data buffer of size_bytes
        // and return its address (boxed TAG_INT). The named-data sibling of
        // __hx_environ_ptr / __hx_stderr_ptr, but DEFINES a local symbol (`slot_<id>`)
        // instead of referencing an extern — the address materializes via a LOCAL pc-rel
        // ref (`lea [rip+slot_<id>]` x86 / `adrp+add @PAGE/@PAGEOFF` arm64), and the
        // backend records the slot so emit/asm emits a `.zero size_bytes` data symbol.
        // Both args MUST be compile-time const_int literals (deterministic name + fixed
        // size). This gives Route C bodies file-local STATIC MUTABLE state (the popen
        // fd→pid table) — the last frozen-floor static-array dep — with NO new parser
        // keyword/@attr (frozen 151c52c8 immutable; an ordinary identifier-call). arm64 +
        // x86_64 STMT_CALL special-case. ADD-only: the compiler never calls it.
        "__hx_static_slot",
        // RFC061 §M8 named-rodata-table (literal-∅ feature C, 2026-06-29):
        // `__hx_rodata_tab_ptr(table_id)` — the PRE-INITIALIZED-rodata sibling of
        // __hx_static_slot. DEFINES a named `.rodata` constant table (`rotab_<id>`,
        // contents from the x86_64 backend's `_x86_rodata_table_spec`, LE doubles)
        // and RETURNS its address (boxed TAG_INT) via a LOCAL pc-rel `lea
        // [rip+rotab_<id>]`. table_id MUST be a compile-time const_int (deterministic
        // symbol name). This is the table-driven libm mechanism the musl exp/log
        // ports need (__exp_data.tab[256] / __log_data.tab[128]); callers read cells
        // via __hx_ptr_load64. NO new keyword/@attr (ordinary identifier-call, frozen
        // 151c52c8 safe). x86_64 STMT_CALL special-case. ADD-only: the compiler never
        // calls it → byte-eq NEUTRAL (no byteeq-path body references it).
        "__hx_rodata_tab_ptr",
        // ING #29 literal-∅ (2026-06-30): `__hx_fn_addr(name)` — emit the RAW UNBOXED
        // address of a top-level `fn name` (the .text entry-point symbol) as a TAG_INT
        // HexaVal, WITHOUT the TAG_FN boxing that `fn_ref` performs. This is the
        // reference-match of C `&fn` / GCC `&&label` / rustc fn-ptr / zig `@intFromPtr(fn)`
        // — every major compiler emits a function address as a raw pointer. It is the
        // PREREQUISITE BUILDING BLOCK for the SA_RESTORER (signal) + setjmp/longjmp
        // (naked-asm) walls, both of which need a raw fn ptr stored into a struct field
        // (sigaction.sa_restorer / the trampoline slot) that the kernel jumps to directly
        // — a TAG_FN HexaVal box is rejected there. hir_to_mir lowers the bare-ident arg
        // `__hx_fn_addr(worker)` to op="__hx_fn_addr" args=[name_str] (the SAME lowering
        // shape as fn_ref / carrier_call, which also extract a bare fn-ident name). The
        // codegen STMT_CALL special-case emits ONLY the pc-relative address materialisation
        // (x86_64 `lea rax,[rip+name]` · arm64 `adrp x1,name@PAGE` + `add x1,x1,name@PAGEOFF`)
        // and skips the `hexa_fn_new_native` boxing call — the result is the raw .text
        // pointer in the payload (tag=TAG_INT=0). NO new keyword/@attr (ordinary
        // identifier-call, frozen 151c52c8 safe). ADD-only: the compiler itself never
        // calls it → byte-eq NEUTRAL (no byteeq-path body references it).
        "__hx_fn_addr",
        // RFC061 §M8 varargs-ABI (literal-∅ feature B, RUNG1, 2026-06-29): the SysV
        // AMD64 va_list intrinsics that let a self-emitted variadic `hxlcl_*` body
        // (e.g. the frozen-floor hxlcl_printf/hxlcl_fprintf, which forward a C va_list
        // to hxlcl_vfprintf_fd — self/runtime_emit_full.hexa:1000-1013) walk its
        // unnamed integer arguments WITHOUT the frozen runtime.c va_list. Named like the
        // GCC/clang built-ins (reference-match: GCC `__builtin_va_start`/`va_arg`/`va_end`
        // /`va_copy`). Lowered by the x86_64_linux backend STMT_CALL special-case
