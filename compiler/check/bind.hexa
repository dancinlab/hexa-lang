        // per-target syscall number natively. ADD-only: the compiler never calls it.
        "__hx_target_os",
        // RT-NATIVE measure-8 (2026-06-19): `__hx_target_arch()` — 0-arg compile-time
        // CPU-arch const (0=x86_64, 1=arm64), emitted as a const-int HexaVal by the
