// HEXA Native Compiler — Phase B2 / S2: bind / scope resolve
//
// @version 0.1.0
// @capabilities [pure]
//
// Walks a parsed Module and resolves every identifier reference to a unique
// DefId. Per RFC-017 §3.1 S2 is fatal — undefined names abort compilation.
// Per RFC-019 §6 we collect every miss (no early-stop) and surface them as
// HX2001 diagnostics with did-you-mean suggestions (Levenshtein ≤ 2 over
// every identifier currently in visible scope, mirroring resolve.hexa S1).
//
// Scope shape (flat, stage0-friendly):
//   BindFrame { defs: [string], def_ids: [DefId] }   — parallel arrays
//   BindScope { frames: [BindFrame], next_index }    — explicit stack
//
// NOTE: `scope` is a stage0 reserved keyword (gate/HEXA_RESERVED.md §1a),
// so neither types nor parameter names use the bare word — types are
// `BindScope` / `BindFrame` and parameters are spelled `sc`.
//
// Pre-pass: every Module.items[*] takes a top-level DefId in frames[0] so
// fn / struct / enum / let can reference each other freely (forward refs).
// Then we walk each item's body in a fresh function scope (params first).
//
// Notes:
//   - This is COMPILER-side binding. Independent of self/type_checker.hexa's
//     enum_all_variant_payload_types (RFC-020 in self/ tree).
//   - DefId.module = Module.file (per the compiler entry contract).
//   - 100% enum match — no string compares against ItemKind/ExprKind tags.

import "../parse/ast.hexa"
import "../diag/catalog.hexa"
import "../diag/builder.hexa"
import "../ir/hir.hexa"
import "../lex/tokens.hexa"
import "./resolve.hexa"

// ── Scope structures ─────────────────────────────────────────

pub struct BindFrame {
    defs: [string],
    def_ids: [DefId],
    // Parallel to `defs`: was the binding declared `mut`? Function params,
    // `for` iterators, match/catch binders and immutable `let` are false;
    // `let mut` is true. Drives the HX2006 immutable-assignment check
    // (#2663 — a write to a non-`mut` `let` was silently dropped by codegen).
    is_mut: [bool]
}

pub struct BindScope {
    frames: [BindFrame],
    next_index: i64
}

// ── RFC-074 Phase 2 — enum variant payload arity registry ───
// Module-local lookup table built once per `bind()` call (reset on entry).
// We do NOT thread the arity table through the walker — module-level state
// matches the self/type_checker.hexa convention (enum_all_variant_payload_*).
//
// Layout (flat parallel arrays, indexed by variant ordinal across the module):
//   _bind_enum_names[i]            : enum decl name (e.g. "Event")
//   _bind_enum_variant_offsets[i]  : start index into _bind_enum_variant_*[]
//   _bind_enum_variant_counts[i]   : number of variants in enum i
//   _bind_enum_variant_names[j]    : variant name (e.g. "Click")
//   _bind_enum_variant_arities[j]  : payload arity (= len(Param.typs)) — 0 unit / 1 single / N multi
//
// Arity is recovered from Param.typs.len; the parser populates this per
// RFC-074 §3.1 (compiler/parse/parser.hexa parse_enum_item).
let mut _bind_enum_names: [string] = []
let mut _bind_enum_variant_offsets: [i64] = []
let mut _bind_enum_variant_counts: [i64] = []
let mut _bind_enum_variant_names: [string] = []
let mut _bind_enum_variant_arities: [i64] = []

fn _bind_enum_registry_reset() {
    _bind_enum_names = []
    _bind_enum_variant_offsets = []
    _bind_enum_variant_counts = []
    _bind_enum_variant_names = []
    _bind_enum_variant_arities = []
}

// ── HX3050 unused-local-`let` (opt-in) — module-level accumulate lane ─
// Rust's `unused_variables` lint. Opt-in HEXA_UNUSED_LET=1 (`_unused_let_on`),
// default OFF ⇒ byteeq-NEUTRAL (nothing pushed, nothing emitted, diag stream +
// .text byte-identical). Marking happens at the SAME name-resolution choke as
// HX2001 (the `_bind_walk_expr` Ident arm), so the used-set is exactly
// resolver-complete — FP=0 by construction. CANDIDATES = FUNCTION-LOCAL `let`
// defines (the sole `_define_mut` let-expr site); a candidate whose minted
// dense DefId.index never appears in `_unused_used_ids` was never referenced.
// A write via assign-LHS descends to the Ident arm ⇒ counts as a use
// (conservative); closure captures resolve up-chain ⇒ marked used; `_`-prefixed
// names are the rustc escape hatch and are excluded at the accumulate site.
// Module-level state (no by-value threading) mirrors the enum-registry + `_bck`
// convention — the BindFrame struct and _pop_scope signature are untouched.
let mut _unused_let_on = false
let mut _unused_cand_ids: [i64] = []
let mut _unused_cand_names: [string] = []
let mut _unused_cand_spans: [Span] = []
let mut _unused_used_ids: [i64] = []

fn _unused_let_reset() {
    _unused_let_on = env("HEXA_UNUSED_LET") == "1"
    _unused_cand_ids = []
    _unused_cand_names = []
    _unused_cand_spans = []
    _unused_used_ids = []
}

fn _bind_register_enum_item(it: Item) {
    if !_is_enum_kind(it.kind) { return }
    _bind_enum_names.push(it.name)
    _bind_enum_variant_offsets.push(len(_bind_enum_variant_names))
    _bind_enum_variant_counts.push(len(it.params))
    let mut vi = 0
    while vi < len(it.params) {
        let v = it.params[vi]
        _bind_enum_variant_names.push(v.name)
        _bind_enum_variant_arities.push(len(v.typs))
        vi = vi + 1
    }
}

// Returns the declared arity (≥ 0) for enum_name::variant_name, or -1 if
// the enum or variant is not known. The -1 sentinel is the "skip" signal —
// the caller treats it as "no arity claim" and emits no diagnostic, since
// unknown enum heads are handled separately (HX2001 in _bind_walk_expr).
fn _bind_lookup_variant_arity(enum_name: string, variant_name: string) -> i64 {
    let mut ei = 0
    while ei < len(_bind_enum_names) {
        if _bind_enum_names[ei] == enum_name {
            let off = _bind_enum_variant_offsets[ei]
            let cnt = _bind_enum_variant_counts[ei]
            let mut vi = 0
            while vi < cnt {
                if _bind_enum_variant_names[off + vi] == variant_name {
                    return _bind_enum_variant_arities[off + vi]
                }
                vi = vi + 1
            }
            return -1
        }
        ei = ei + 1
    }
    return -1
}

// ── Helpers ──────────────────────────────────────────────────

fn _bind_empty_fixit() -> FixIt {
    return FixIt {
        kind: FixItKind::None,
        span: Span { file: "", line: 0, col: 0, len: 0 },
        new_text: ""
    }
}

fn _bind_miss_def_id() -> DefId {
    return DefId { module: "", index: -1 }
}

// ── Scope helpers ────────────────────────────────────────────

fn _new_scopes() -> BindScope {
    return BindScope { frames: [], next_index: 0 }
}

fn _push_scope(sc: BindScope) -> BindScope {
    let frame = BindFrame { defs: [], def_ids: [], is_mut: [] }
    let mut frames = sc.frames
    frames.push(frame)
    return BindScope { frames: frames, next_index: sc.next_index }
}

fn _pop_scope(sc: BindScope) -> BindScope {
    let mut frames = sc.frames
    let n = len(frames)
    if n == 0 { return sc }
    // pop last frame — stage0 array has no `pop` so build a smaller copy.
    let mut next_frames = []
    let mut i = 0
    while i < n - 1 {
        next_frames.push(frames[i])
        i = i + 1
    }
    return BindScope { frames: next_frames, next_index: sc.next_index }
}

// Define `name` in the topmost frame and return the freshly allocated DefId.
// The caller is responsible for module attribution — DefId.module is filled
// by the bind() entry point; here we only mint the dense index.
//
// `is_mut` records whether the binding may be reassigned. Most binders are
// immutable (params, `for` iterators, match/catch binders, `let`); only
// `let mut` passes true. _define_mut is the explicit-mutability entry; the
// legacy `_define` is preserved as the immutable default so existing call
// sites stay byte-identical.
fn _define_mut(sc: BindScope, name: string, mod_file: string, is_mut: bool) -> BindScope {
    let n = len(sc.frames)
    if n == 0 { return sc }
    let mut frames = sc.frames
    let top = frames[n - 1]
    let mut new_defs = top.defs
    let mut new_ids = top.def_ids
    let mut new_mut = top.is_mut
    new_defs.push(name)
    new_ids.push(DefId { module: mod_file, index: sc.next_index })
    new_mut.push(is_mut)
    frames[n - 1] = BindFrame { defs: new_defs, def_ids: new_ids, is_mut: new_mut }
    return BindScope { frames: frames, next_index: sc.next_index + 1 }
}

fn _define(sc: BindScope, name: string, mod_file: string) -> BindScope {
    return _define_mut(sc, name, mod_file, false)
}

// Look up `name` walking the frame stack from innermost to outermost. Returns
// a DefId with index=-1 on miss so callers can branch without exceptions.
fn _bind_lookup(sc: BindScope, name: string) -> DefId {
    let n = len(sc.frames)
    let mut i = n - 1
    while i >= 0 {
        let fr = sc.frames[i]
        let m = len(fr.defs)
        let mut j = 0
        while j < m {
            if fr.defs[j] == name {
                return fr.def_ids[j]
            }
            j = j + 1
        }
        i = i - 1
    }
    return _bind_miss_def_id()
}

// Mutability probe for the innermost binding of `name`. Walks frames inner→
// outer (same order as _bind_lookup) and returns the mutability of the FIRST
// match — shadowing semantics: an inner `let x` shadows an outer `let mut x`.
//   1  = found, declared `mut` (assignment is legal)
//   0  = found, declared immutable IN A FUNCTION-LOCAL frame — this is the only
//        case the 0.1.0-dispatch codegen silently miscompiles (a `let` counter
//        written inside a loop), so it is the only HX2006 error.
//   2  = found, declared immutable IN THE MODULE/BUILTIN frame (outermost,
//        index 0). A top-level `let X = …` global is lowered to a global slot,
//        NOT a stack slot, so the silent-drop bug does NOT apply. The parser
//        ALSO synthesises one `X = E` init-assign per top-level `let` into the
//        merged `main` body (parser.hexa ~L2129) — flagging those would reject
//        every global initialiser in the tree. So a write whose target lives in
//        frame 0 is NOT an HX2006 error (the global-init synthesis + global
//        reassign-from-fn are both legitimate / not miscompiled).
//  -1  = not found in any frame (import, or genuinely unknown — HX2001 handles
//        those; the mutability check stays silent)
fn _bind_is_mut(sc: BindScope, name: string) -> i64 {
    let n = len(sc.frames)
    let mut i = n - 1
    while i >= 0 {
        let fr = sc.frames[i]
        let m = len(fr.defs)
        let mut j = 0
        while j < m {
            if fr.defs[j] == name {
                if fr.is_mut[j] { return 1 }
                // Outermost frame (index 0) holds builtins + module-level
                // top-level items. An immutable match there is a global, not a
                // stack-resident local — not the miscompiled case.
                if i == 0 { return 2 }
                return 0
            }
            j = j + 1
        }
        i = i - 1
    }
    return -1
}

// Collect every visible identifier across all frames — used for did-you-mean.
fn _all_visible(sc: BindScope) -> [string] {
    let mut out = []
    let mut i = 0
    while i < len(sc.frames) {
        let fr = sc.frames[i]
        let mut j = 0
        while j < len(fr.defs) {
            out.push(fr.defs[j])
            j = j + 1
        }
        i = i + 1
    }
    return out
}

// Closest-name suggestion within Levenshtein cutoff. Mirrors resolve.hexa
// _suggest_for but over plain string list rather than AtlasIndex.
fn _suggest_name(sc: BindScope, name: string, cutoff: i64) -> string {
    let cands = _all_visible(sc)
    let mut best = ""
    let mut best_d = cutoff + 1
    let mut i = 0
    while i < len(cands) {
        let cand = cands[i]
        if cand != name {
            let d = levenshtein(name, cand)
            if d < best_d {
                best_d = d
                best = cand
            }
        }
        i = i + 1
    }
    if best_d <= cutoff { return best }
    return ""
}

