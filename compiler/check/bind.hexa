        // + get hexa-ported, set/remove remain CORE-final).
        "__map_has_cstr_v", "__map_get_cstr_v",
        "__map_order_key_at", "__map_order_val_at",
        // RUNTIME.md step-3 cycle 108 — map set/remove aliasing port
        // (잔여 #5 full surface closure 6/6). Hexa-source wrappers
        // rt_map_set + rt_map_remove in stdlib/runtime/numeric.hexa.
        "__map_set_cstr_v", "__map_remove_cstr_v",
        // RFC 071 P5++ — GPU matmul builtins. Source-level entry points
        // that the HIR→MIR lowering pattern-synthesises into the
        // STMT_LOAD + STMT_LOAD + STMT_BINOP("matmul"/_NT_a/_NT_b) +
        // STMT_STORE MIR shape recognised by the NVPTX / ROCm / Metal
        // matmul codegen lanes. See compiler/lower/hir_to_mir.hexa
        // `gpu_matmul` call-branch synthesis and compiler/codegen/
        // nvptx_target.hexa `_nvptx_mfunc_is_matmul_shape` (N86) /
        // rocm_target.hexa `_rocm_mfunc_is_matmul_shape` /
        // metal_target.hexa `_metal_mfunc_is_matmul_shape`.
        "gpu_matmul", "gpu_matmul_NT_a", "gpu_matmul_NT_b",
        // FLEET A3 (#4154 follow-on) — thread/channel runtime fn-global carriers.
        // These are NOT source-level `fn` decls: native/thread.c declares them as
        // bare `HexaVal thread_spawn;` … carrier globals and registers them at
        // runtime via `_hexa_init_thread_fn_shims` (thread_emit.hexa:383-398), the
        // exact mirror of the `float_to_bits`/`bits_to_float` runtime-intrinsic
        // pattern (see self/nanbox.hexa:223-230). #4154 fwd-declared them in
        // runtime.h so the C-transpile / `hexa run` paths resolve `thread_spawn(f,
        // arg)` → `hexa_call2(thread_spawn, …)` (codegen.hexa:8251 hexa_callN
        // fallback) through the extern HexaVal carrier. The raw `aprime --emit`
        // native path stalled BEFORE codegen: bind's S1 name-resolution saw the
        // bare callee as unknown → HX2001 (cf. cf6fc2af8 which dropped the thread
        // fn-globals from the escape-relax test for exactly this reason). Adding
        // the names here ONLY registers them in the module scope (a name-resolution
        // exemption); codegen is unaffected (they are absent from `_is_builtin_name`
        // and `_is_known_fn_global`, so they still route through hexa_callN to the
        // carrier). Byteeq-neutral: a name-only scope `_define` changes no emitted
        // bytes for any program that does not reference these names, and any program
        // that does reference them currently fails to compile (no prior byte output).
        "thread_spawn", "thread_join",
        "thread_channel_new", "thread_channel_send",
        "thread_channel_recv", "thread_channel_close",
        // …and the rest of the `_hexa_init_thread_fn_shims` carrier family that
        // multithreaded `.hexa` references alongside spawn/join (the game thread
        // microbench uses atomic_cell_*; now_ms is the spawn-family timer; sleep_ms
        // is already registered above as a plain builtin). All 8 below are the same
        // TAG_FN carrier globals (thread_emit.hexa:383-398) and resolve identically.
        "now_ms",
        "atomic_cell_new", "atomic_cell_load", "atomic_cell_store",
        "atomic_cell_add", "atomic_cell_sub", "atomic_cell_cas"
    ]
}

pub fn bind(module: Module) -> array {
    let mut out = []
    let mod_file = module.file

    // RFC-074 Phase 2 — reset the per-module enum variant arity registry
    // before the pre-pass populates it. `bind()` is called once per module;
    // the registry's lifetime is exactly this call.
    _bind_enum_registry_reset()
    // HX3050 — reset the opt-in unused-local-`let` accumulate lane and read the
    // HEXA_UNUSED_LET flag once per module (default OFF ⇒ byteeq-neutral).
    _unused_let_reset()

    // ── Pre-pass: register host-runtime builtins so identifier lookups
    // don't surface as HX2001. Anchored to mod_file so the same scope
    // shape is exercised regardless of import topology.
    let mut sc = _push_scope(_new_scopes())
    let bnames = _bind_builtin_names()
    let mut bi = 0
    while bi < len(bnames) {
        sc = _define(sc, bnames[bi], mod_file)
        bi = bi + 1
    }
    // ── Pre-pass: top-level item names into the module-level scope.
    let mut i = 0
    while i < len(module.items) {
        let it = module.items[i]
        // RFC-074 Phase 2 — populate the enum variant arity registry while
        // we walk top-level items. Done in the SAME pass to keep ordering
        // simple — Enum items have no body to walk anyway.
        _bind_register_enum_item(it)
        if !_is_import_kind(it.kind) {
            // Top-level `let mut X` carries it.name = "mut:X" (parser
            // parse_let_item). Without stripping, the module scope held
            // "mut:X" while every reference looks up "X" → HX2001 on
            // every mutable module global (p_*/_g_* parser+overlay state,
            // ~80 in stage-2 self-compile). _bind_let_name is a no-op on
            // unprefixed Fn/Struct/Enum names, so this is safe for all
            // item kinds — mirrors the let-EXPR branch (_bind_let_name).
            let it_nm = _bind_let_name(it.name)
            if len(it_nm) > 0 {
                sc = _define(sc, it_nm, mod_file)
            }
        }
        i = i + 1
    }

    // ── Main walk
    let mut k = 0
    while k < len(module.items) {
        let it = module.items[k]
        // Stage1 punch list C11 — items tagged @phase("parse_only")
        // (e.g. the ~10K AtlasNode literals in
        // compiler/atlas/embedded.gen.hexa) skip the bind body walk.
        // Their NAMES are already in the module scope from the pre-pass
        // above, so downstream lookups still resolve.
        if item_is_parse_only(it) {
            k = k + 1
            continue
        }
        if _is_fn_kind(it.kind) {
            // Function body lives in its own scope with params first.
            sc = _push_scope(sc)
            let mut p = 0
            while p < len(it.params) {
                let par = it.params[p]
                // Param names may carry the `mut:` prefix (parse_fn_item).
                // Strip it for the binding name and record the mutability so
                // an assignment to a non-`mut` param is flagged the same way
                // a non-`mut` `let` is (#2663). Stripping also fixes the latent
                // case where a `mut`-prefixed param name failed to resolve
                // against a clean Ident reference.
                let pnm = _bind_let_name(par.name)
                if len(pnm) > 0 {
                    sc = _define_mut(sc, pnm, mod_file, _bind_let_is_mut(par.name))
                }
                p = p + 1
            }
            sc = _bind_walk_expr(it.body, sc, mod_file, out)
            sc = _pop_scope(sc)
        } else if _is_let_item_kind(it.kind) {
            // Top-level let: walk RHS in module scope. The name is already
            // visible from the pre-pass; that matches "let foo = foo" being
            // legal-but-silly across forward refs (the resolver doesn't try
            // to enforce initialization order at S2).
            sc = _bind_walk_expr(it.body, sc, mod_file, out)
        } else {
            // Struct / Enum / Import — body is the empty placeholder Expr
            // (parse path). Nothing to walk.
        }
        k = k + 1
    }

    // ── HX3050 — end-of-pass unused-local-`let` sweep (opt-in). A candidate
    // whose minted dense DefId.index never appears in the used-set was never
    // referenced ⇒ Rust `unused_variables`. Linear absent-scan; the opt-in flag
    // gates the whole loop so the default build does zero extra work.
    if _unused_let_on {
        let mut ci = 0
        while ci < len(_unused_cand_ids) {
            let cid = _unused_cand_ids[ci]
            let mut used = false
            let mut ui = 0
            while ui < len(_unused_used_ids) {
                if _unused_used_ids[ui] == cid {
                    used = true
                    break
                }
                ui = ui + 1
            }
            if !used {
                _emit_hx3050(_unused_cand_names[ci], _unused_cand_spans[ci], out)
            }
            ci = ci + 1
        }
    }

    return out
}
