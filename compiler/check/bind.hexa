        // drops, default-OFF byte-eq NEUTRAL. arm64 + FP class = the honest next rung.
        // Frozen-SAFE: parse as ordinary identifier-calls (no new keyword/@attr).
        // ADD-only: the compiler itself never calls them.
        "__builtin_va_start", "__builtin_va_arg", "__builtin_va_end", "__builtin_va_copy",
        // RFC061 §M8 varargs-ABI SSE-class (literal-∅ feature B, r1, 2026-06-30):
        // `__builtin_va_arg_fp(ap)` fetches the next SSE-class (double/float) vararg per
