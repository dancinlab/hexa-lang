    s = s + "    y = 2\n"
    s = s + "    return y\n"
    s = s + "}\n"
    return s
}

// CONTROL — a deferred-init `let z: i64` : the FIRST `z = 1` is the init
// (silent), and there is no second assignment → 0.
fn _src_fp_deferred_init() -> string {
    let mut s = "fn fdi() -> i64 {\n"
    s = s + "    let z: i64\n"
    s = s + "    z = 1\n"
    s = s + "    return z\n"
    s = s + "}\n"
    return s
}

// CONTROL — a shadowing rebind `let s = …; let s = …` is a FRESH binding
// (fresh local id → fresh row), not a reassignment → 0.
fn _src_fp_shadow_rebind() -> string {
    let mut s = "fn fsr() -> i64 {\n"
    s = s + "    let s = 1\n"
    s = s + "    let s = 2\n"
    s = s + "    return s\n"
    s = s + "}\n"
    return s
}

// HX3045 probe runner — mirrors `_run_pm_probe`, keyed on the immutable-reassign
