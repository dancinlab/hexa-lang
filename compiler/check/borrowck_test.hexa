// ── HEXA-OWN L5 — HX3014 (Rule 2) USE-AFTER-MOVE at the 3 NON-CALL move
// sites (Rust E0382). The DUAL of the HX3040/_run_nc_move round: HX3040
// (E0505) flags a move-out of an @own param `a` WHILE a live loan exists
// at `let b = a` / `b = a` / `return a`; this round records that same
// non-call move into the move registry so any LATER use of `a` fires the
// existing Rule 2 (use-after-move) — no new catalog code (HX3014 reused),
// no new fixpoint (the M4 NLL reach-matrix re-evaluates verbatim). Source-
// string probes (the @own-param parser carrier is landed — same as the
// HX3040 _src_hz_nc_move_* probes). Opt-in HEXA_BORROWCK (default-OFF ⇒
// every want collapses to 0 = the OFF-gate leg). ──

// HAZARD — let-site move of the @own param `a`, then a later use `a[0]`.
fn _src_hz_e0382_let() -> string {
    let mut s = "fn h382l(@own a: [i64]) {\n"
    s = s + "    let b = a\n"
    s = s + "    let n = a[0]\n"
    s = s + "}\n"
    return s
}

// HAZARD — assign-RHS move of the @own param `a`, then a later use `a[0]`.
fn _src_hz_e0382_assign() -> string {
    let mut s = "fn h382a(@own a: [i64]) {\n"
    s = s + "    let mut b = [0]\n"
    s = s + "    b = a\n"
    s = s + "    let n = a[0]\n"
    s = s + "}\n"
    return s
}

// CONTROL — `let r = &a` is a BORROW, not a bare-ident move, so nothing is
// recorded; a shared borrow permits the later read `a[0]` → 0.
fn _src_fp_e0382_borrow() -> string {
    let mut s = "fn f382b(@own a: [i64]) {\n"
    s = s + "    let r = &a\n"
    s = s + "    let n = a[0]\n"
    s = s + "}\n"
    return s
}

// CONTROL — the moved binding `a` is REASSIGNED (`a = [9]`) before the use,
// which re-points `a` to a fresh group (newest-entry-wins), clearing the
// recorded move → the later `a[0]` sees no reaching move → 0.
fn _src_fp_e0382_reassign() -> string {
    let mut s = "fn f382r(@own a: [i64]) {\n"
    s = s + "    let b = a\n"
    s = s + "    a = [9]\n"
    s = s + "    let n = a[0]\n"
    s = s + "}\n"
    return s
}

// CONTROL — `return a` records the move but the return's OWN value read was
// recorded BEFORE the move (same block, use-before-move) and nothing runs
// after the return, so there is no use-AFTER-move → 0 (no spurious self-fire).
fn _src_fp_e0382_return_only() -> string {
    let mut s = "fn f382ret(@own a: [i64]) -> [i64] {\n"
    s = s + "    return a\n"
    s = s + "}\n"
    return s
}

