    return s
}

// HAZARD — return a reference to a STRUCT-literal temporary.
fn _src_hz_ret_temp_struct() -> string {
    let mut s = "struct P { x: i64 }\n"
    s = s + "fn rts() -> &P {\n"
    s = s + "    return &P { x: 1 }\n"
    s = s + "}\n"
    return s
}

// HAZARD — return a reference to a BINOP temporary.
fn _src_hz_ret_temp_binop() -> string {
    let mut s = "fn rtb(x: i64) -> &i64 {\n"
    s = s + "    return &(x + 1)\n"
    s = s + "}\n"
    return s
}

// CONTROL — return a reference to a module GLOBAL: its storage outlives the
// call and derives no local base, so neither HX3041 nor HX3019 fires → 0.
fn _src_fp_ret_temp_global() -> string {
    let mut s = "let g = 0\n"
    s = s + "fn rtg() -> &i64 {\n"
    s = s + "    return &g\n"
    s = s + "}\n"
    return s
}

// HX3041 probe runner — keys on the return-ref-to-temporary code.
fn _run_ret_temp_probe(label: string, src: string, want_on: i64) -> bool {
    let strict = env("HEXA_BORROWCK_STRICT") == "1"
    let flag_on = env("HEXA_BORROWCK") == "1" || strict
    let mut want = 0
    if flag_on { want = want_on }
    let mut ok = true
    println("")
    println("── " + label + " (expect HX3041 ×" + to_string(want) + ") ──")
    let d = _compile_probe(label, src)
    let n = _count_code(d, "HX3041")
    let other = len(d) - n
    _print_diags(d)
    if n != want {
        println("  FAIL: HX3041 = " + to_string(n) + ", want " + to_string(want))
        ok = false
    }
    if other != 0 {
        println("  FAIL: stray non-HX3041 diagnostics = " + to_string(other))
        ok = false
    }
    if strict {
        let eb = _count_error_band(d)
        if eb != want {
            println("  FAIL: STRICT error-band = " + to_string(eb) + ", want " + to_string(want))
            ok = false
        }
    }
    if ok { println("  ok: ×" + to_string(want)) }
    return ok
}

// ── HEXA-OWN round11 — HX3049 temporary-dropped-while-borrowed (Rust E0716).
// The assign-arm re-borrow of a CALL temporary `r = &make()` where `r` is a ref
// binding declared in an enclosing scope → HX3049. The LET-init `let r = &make()`
// (Rust temporary-lifetime-extension), a binop/struct temp (const-promotable), and
// an assign whose LHS is not a known ref binding stay SILENT. It is the assign-site
// sibling of HX3041 (`return &<temp>`). ──

// HAZARD — assign-arm re-borrow of a CALL-result temporary into a longer-lived
// ref binding `r`. The temporary is dropped at statement end → HX3049 ×1.
fn _src_hz_asn_temp_call() -> string {
    let mut s = "fn make() -> i64 {\n"
    s = s + "    return 5\n"
    s = s + "}\n"
    s = s + "fn atc() {\n"
    s = s + "    let x = 1\n"
    s = s + "    let mut r = &x\n"
    s = s + "    r = &make()\n"
    s = s + "    println(r)\n"
    s = s + "}\n"
    return s
}

// HAZARD — the `&mut` re-borrow of a call temporary (mutability-blind) → HX3049 ×1.
fn _src_hz_asn_temp_call_mut() -> string {
    let mut s = "fn make() -> i64 {\n"
    s = s + "    return 5\n"
    s = s + "}\n"
    s = s + "fn atcm() {\n"
    s = s + "    let mut x = 1\n"
    s = s + "    let mut r = &mut x\n"
    s = s + "    r = &mut make()\n"
    s = s + "    println(r)\n"
    s = s + "}\n"
    return s
}

// CONTROL — the LET-init form `let r = &make()`: Rust's temporary-lifetime-
// extension makes this VALID, and it lowers through the let-lane (never the assign
// hook), so no temp re-borrow is recorded → 0.
fn _src_fp_letinit_temp() -> string {
    let mut s = "fn make() -> i64 {\n"
    s = s + "    return 5\n"
    s = s + "}\n"
    s = s + "fn flt() {\n"
    s = s + "    let r = &make()\n"
    s = s + "    println(r)\n"
    s = s + "}\n"
    return s
}

// CONTROL — a BINOP temporary `r = &(x + 1)`: const-promotable in the reference
// model (rvalue static promotion → 'static), so it is EXCLUDED (call-only) → 0.
fn _src_fp_asn_temp_binop() -> string {
    let mut s = "fn atb() {\n"
    s = s + "    let x = 1\n"
    s = s + "    let mut r = &x\n"
    s = s + "    r = &(x + 1)\n"
    s = s + "    println(r)\n"
    s = s + "}\n"
    return s
}

// CONTROL — a STRUCT-literal temporary `r = &P { x: 2 }`: const-promotable, so
// EXCLUDED (call-only) → 0.
fn _src_fp_asn_temp_struct() -> string {
    let mut s = "struct P { x: i64 }\n"
    s = s + "fn ats() {\n"
    s = s + "    let p = P { x: 1 }\n"
    s = s + "    let mut r = &p\n"
    s = s + "    r = &P { x: 2 }\n"
    s = s + "    println(r)\n"
    s = s + "}\n"
    return s
}

// CONTROL — the RHS is a `&make()` temp re-borrow but the LHS `n` was never a
// ref binding (`_bck_find_ref` miss), so the known-ref gate keeps it SILENT → 0.
fn _src_fp_asn_temp_unknown_ref() -> string {
    let mut s = "fn make() -> i64 {\n"
    s = s + "    return 5\n"
    s = s + "}\n"
    s = s + "fn atur() {\n"
    s = s + "    let mut n = 0\n"
    s = s + "    n = &make()\n"
    s = s + "    println(n)\n"
    s = s + "}\n"
    return s
}

// HX3049 probe runner — keys on the temporary-dropped-while-borrowed code and
// asserts every OTHER code is 0 (probe hygiene). STRICT re-bands HX3049 to Error,
// so the error-band count must equal the HX3049 count. OFF → want 0 (byteeq-neutral).
