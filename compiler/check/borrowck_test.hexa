// HEXA Native Compiler — HEXA-OWN L3 M3+M4 loan-pass smoke test (HX3014)
//
// @version 0.2.0
// @capabilities [pure]
//
// Probe matrix for the MIR loan pass (HEXA_BORROWCK=1, intra-block M3
// spec state/hexa-own/l3_m3_spec.md §4 + cross-block NLL liveness M4).
// Every source probe runs the REAL pipeline — lex → parse → ast_to_hir
// lower → lower_hir — across three ambient-flag modes:
//   * OFF (no flag)            → 0 diagnostics of ANY code (byteeq-
//                                neutral stream proof at the diag level;
//                                asm byte-identity is the pool/CI gate's job)
//   * ON (HEXA_BORROWCK=1)      → expected HX3014 count per probe, Warning band
//   * STRICT (HEXA_BORROWCK_STRICT=1) → HEXA-OWN L4 Lane-B B0: STRICT
//                                implies ON, SAME HX3014 count per probe
//                                (precision survives escalation), but every
//                                emitted HX3014 is Error-band (build-refusing).
//                                fp_arr_alias_read / fp_callarg stay 0 under
//                                STRICT → 0 Error-band (FP-probe verdict holds).
//
//   hz_write_alias        `let b = a; b[0]=99; println(a[0])`   → ×1 (Rule 1)
//   hz_write_alias_field  struct alias, `d.depth=…` then `c.depth` → ×1
//   hz_push_alias         `let b = a; b.push(2); len(a)`        → ×1
//   fp_arr_alias_read     `let b = a; println(a[0]+b[1])`       → 0 (M0 FP #2)
//   fp_callarg            `foo(a)` then `a[0]`, param not @own  → 0 (M0 FP #1)
//   fp_copy_int           scalar copy chain                     → 0 (Copy skip)
//   fp_write_same_name    `a[0]=1; println(a[0])`, no alias     → 0 (XOR ≥2 names)
//   fp_repoint            `b = [9]` detaches b before the write → 0 (edge-kill)
//   xb_write_in_branch    write inside `if`, read after join    → ×1 (M4: was the
//                         documented M3 ceiling — cross-block now caught)
//   xb_loop_carried       write via alias inside `while`, read of the
//                         other name earlier in the SAME body block → ×1
//                         (M4: body reaches itself via the back-edge)
//   fp_benign_join        write to a NON-aliased array in a branch +
//                         read-only alias pair across the join    → 0
//                         (M4 control: reach without group match = silent)
//   tp_own_param_move     hand-built HIR `@own` param + `g(a); a[0]` → ×1 (Rule 2)
//
// The hz_write_alias / fp_arr_alias_read PAIR is the M0-motivated
// discriminator: identical alias shape, the only difference is the
// write — M0 measured the pre-M3 lint as unable to tell them apart.
// The xb_write_in_branch / fp_benign_join PAIR is the M4 analogue:
// both cross a join; only the one whose reaching write hits the SAME
// alias group through a different name warns.
//
// tp_own_param_move is hand-built HIR (mir_test.hexa convention)
// because the inline `@own` param parser carrier (#4470/#4485 stack)
// is not on main yet — the HItem annotation shape used here
// (Annotation{name:"own", args:[pname]} + sibling param_names) is
// byte-for-byte what that stack's ast_to_hir hands to lower_hir, so
// Rule 2's mechanism is proven now; the source-level probe goes green
// when the stack lands.
//
// Run:
//   hexa run compiler/check/borrowck_test.hexa

import "../lex/lexer.hexa"
import "../parse/parser.hexa"
import "../parse/ast.hexa"
import "../ir/hir.hexa"
import "../ir/mir.hexa"
import "../lex/tokens.hexa"
import "../diag/catalog.hexa"
import "../atlas/static_index.hexa"
import "../lower/ast_to_hir.hexa"
import "../lower/hir_to_mir.hexa"

// ── pipeline driver ──────────────────────────────────────────

fn _compile_probe(name: string, src: string) -> array {
    let file = name + ".hexa"
    let toks = lex(src, file)
    let m = parse(toks, file)
    let hm = lower(m, empty_atlas_index())
    let mm = lower_hir(hm)
    if len(mm.funcs) == 0 {
        println("  WARN: probe " + name + " lowered 0 fns")
    }
    return hir_to_mir_diags()
}

fn _count_code(diags: array, code: string) -> i64 {
    let mut i = 0
    let mut n = 0
    while i < len(diags) {
        let d = diags[i]
        if d.code == code { n = n + 1 }
        i = i + 1
    }
    return n
}

// HEXA-OWN L4 Lane-B B0 — count Error-band diagnostics. Under
// HEXA_BORROWCK_STRICT=1 every emitted HX3014 is re-banded to
// Severity::Error (build-refusing); the STRICT legs assert this equals
// the HX3014 count (escalation is severity-only — precision unchanged).
fn _count_error_band(diags: array) -> i64 {
    let mut i = 0
    let mut n = 0
    while i < len(diags) {
        let d = diags[i]
        if d.severity == Severity::Error { n = n + 1 }
        i = i + 1
    }
    return n
}

fn _print_diags(diags: array) {
    let mut i = 0
    while i < len(diags) {
        let d = diags[i]
        let sp = d.span
        println("      [" + to_string(i) + "] " + d.code + " @ "
                + sp.file + ":" + to_string(sp.line) + ":" + to_string(sp.col)
                + " — " + d.message)
        i = i + 1
    }
}

// Expectations branch on the AMBIENT flag (types_test convention —
// `setenv` does not feed `env()` in the stage0 runtime, so the flag
// must be set on the PROCESS: run this test twice, once plain =
// flag-OFF sweep, once under HEXA_BORROWCK=1).
// ON-mode: expect `want` HX3014 and zero other codes (probe hygiene —
// a stray HX1101 would mean the probe is not exercising the pass).
// OFF-mode: expect a fully empty diag stream (byte-neutral proof at
// the diagnostic level).
fn _run_probe(label: string, src: string, want_on: i64) -> bool {
    // STRICT implies ON (mirror of lower_hir's `_bck_on = _bck_on ||
    // _bck_strict`): a bare HEXA_BORROWCK_STRICT=1 run enables the same
    // detection, so flag_on must account for both env flags.
    let strict = env("HEXA_BORROWCK_STRICT") == "1"
    let flag_on = env("HEXA_BORROWCK") == "1" || strict
    let mut want = 0
    if flag_on { want = want_on }
    let mut ok = true
    println("")
    println("── " + label + " (expect HX3014 ×" + to_string(want) + ") ──")
    let d = _compile_probe(label, src)
    let n = _count_code(d, "HX3014")
    let other = len(d) - n
    _print_diags(d)
    if n != want {
        println("  FAIL: HX3014 = " + to_string(n) + ", want " + to_string(want))
        ok = false
    }
    if other != 0 {
        println("  FAIL: stray non-HX3014 diagnostics = " + to_string(other))
        ok = false
    }
    // STRICT band: every emitted HX3014 must be Error-band (build-refusing),
    // and precision must survive escalation — a want=0 probe (fp_arr_alias_
    // read / fp_callarg) has zero HX3014 and therefore zero Error-band.
    if strict {
        let eb = _count_error_band(d)
        if eb != want {
            println("  FAIL: STRICT error-band = " + to_string(eb) + ", want " + to_string(want))
            ok = false
        }
    }
    if ok { println("  ok: ×" + to_string(want)) }
    return ok
}

// ── source probes ────────────────────────────────────────────

fn _src_hz_write_alias() -> string {
    let mut s = "fn hz() {\n"
    s = s + "    let a = [1, 2]\n"
    s = s + "    let b = a\n"
    s = s + "    b[0] = 99\n"
    s = s + "    println(a[0])\n"
    s = s + "}\n"
    return s
}

fn _src_hz_write_alias_field() -> string {
    let mut s = "struct Ctx { depth: i64 }\n"
    s = s + "fn hzf() {\n"
    s = s + "    let c = Ctx { depth: 1 }\n"
    s = s + "    let d = c\n"
    s = s + "    d.depth = 5\n"
    s = s + "    println(c.depth)\n"
    s = s + "}\n"
    return s
}

fn _src_hz_push_alias() -> string {
    let mut s = "fn hzp() {\n"
    s = s + "    let a = [1]\n"
    s = s + "    let b = a\n"
    s = s + "    b.push(2)\n"
    s = s + "    println(len(a))\n"
    s = s + "}\n"
    return s
}

fn _src_fp_arr_alias_read() -> string {
    let mut s = "fn fpr() {\n"
    s = s + "    let a = [1, 2]\n"
    s = s + "    let b = a\n"
    s = s + "    println(a[0] + b[1])\n"
    s = s + "}\n"
    return s
}

fn _src_fp_callarg() -> string {
    let mut s = "fn foo(xs: [i64]) -> i64 { return len(xs) }\n"
    s = s + "fn fpc() {\n"
    s = s + "    let a = [1, 2]\n"
    s = s + "    let n = foo(a)\n"
    s = s + "    println(a[0])\n"
    s = s + "    println(n)\n"
    s = s + "}\n"
    return s
}

fn _src_fp_copy_int() -> string {
    let mut s = "fn fpi() {\n"
    s = s + "    let x = 5\n"
    s = s + "    let mut y = x\n"
    s = s + "    y = 7\n"
    s = s + "    println(x + y)\n"
    s = s + "}\n"
    return s
}

fn _src_fp_write_same_name() -> string {
    let mut s = "fn fps() {\n"
    s = s + "    let a = [1, 2]\n"
    s = s + "    a[0] = 1\n"
    s = s + "    println(a[0])\n"
    s = s + "}\n"
    return s
}

fn _src_fp_repoint() -> string {
    // `b = [9]` re-points b to a fresh group BEFORE the write, so the
    // write through b no longer aliases a → reads of a stay silent.
    let mut s = "fn fpp() {\n"
    s = s + "    let a = [1, 2]\n"
    s = s + "    let mut b = a\n"
    s = s + "    b = [9]\n"
    s = s + "    b[0] = 3\n"
    s = s + "    println(a[0])\n"
    s = s + "}\n"
    return s
}

fn _src_xb_write_in_branch() -> string {
    // M4's discriminating probe (was the documented M3 intra-block
    // ceiling, pinned at 0): the write lives in the `if`'s then-block,
    // the read in the join block — the then-block REACHES the join
    // through the CFG edge, so the cross-block fixed-point now warns.
    let mut s = "fn xbb(c: bool) {\n"
    s = s + "    let a = [1]\n"
    s = s + "    let b = a\n"
    s = s + "    if c { b[0] = 1 }\n"
    s = s + "    println(a[0])\n"
    s = s + "}\n"
    return s
}

fn _src_xb_loop_carried() -> string {
    // M4 loop-carried alias: the read of `a` textually PRECEDES the
    // write through `b` in the same while-body block, so the
    // order-aware intra-block rule stays silent — but the body block
    // reaches itself through the loop back-edge (body → header →
    // body), so iteration N's read observes iteration N-1's write.
    let mut s = "fn xbl() {\n"
    s = s + "    let a = [1, 2]\n"
    s = s + "    let b = a\n"
    s = s + "    let mut i = 0\n"
    s = s + "    while i < 2 {\n"
    s = s + "        println(a[0])\n"
    s = s + "        b[0] = 7\n"
    s = s + "        i = i + 1\n"
    s = s + "    }\n"
    s = s + "}\n"
    return s
}

fn _src_fp_benign_join() -> string {
    // M4 no-FP control: a real write event (through `z`) reaches the
    // join, and a read-only alias pair (`a`/`b`) crosses the same join
    // — but the reaching write's group never matches the alias pair's
    // group, so the cross-block pass must stay silent.
    let mut s = "fn fpj(c: bool) {\n"
    s = s + "    let a = [1, 2]\n"
    s = s + "    let b = a\n"
    s = s + "    let z = [5]\n"
    s = s + "    if c {\n"
    s = s + "        z[0] = 9\n"
    s = s + "        println(b[0])\n"
    s = s + "    }\n"
    s = s + "    println(a[0])\n"
    s = s + "}\n"
    return s
}

// ── HEXA-OWN L5-E1 — return-borrow-escape (HX3019, Rust E0515) ────
//
// The loan pass (HEXA_BORROWCK=1) flags a `return` whose value is a
// reference into a value OWNED by the current function — directly
// (`return &x`) or one hop through a ref binding (`let r = &x; return r`).
// ON → 1 HX3019 per hazard probe; OFF → empty stream (byteeq-neutral).
// Controls stay at 0: a value return, an unreturned borrow, a borrow of a
// module global (its storage outlives the call), and a killed ref binding.

fn _src_hz_ret_ref_direct() -> string {
    // Direct `return &x` over a function-local → HX3019.
    let mut s = "fn rrd() -> &i64 {\n"
    s = s + "    let x = 5\n"
    s = s + "    return &x\n"
    s = s + "}\n"
    return s
}

fn _src_hz_ret_refmut_direct() -> string {
    // Direct `return &mut x` over a function-local → HX3019.
    let mut s = "fn rrm() -> &mut i64 {\n"
    s = s + "    let mut x = 5\n"
    s = s + "    return &mut x\n"
    s = s + "}\n"
    return s
}

fn _src_hz_ret_ref_onehop() -> string {
    // 1-hop: `let r = &x` registers the loan; `return r` flags it.
    let mut s = "fn rro() -> &i64 {\n"
    s = s + "    let x = 5\n"
    s = s + "    let r = &x\n"
    s = s + "    return r\n"
    s = s + "}\n"
    return s
}

fn _src_hz_ret_ref_param() -> string {
    // A by-value parameter is owned by the callee, so `return &x` over it
    // is E0515 too (non-global ident) → HX3019.
    let mut s = "fn rrp(x: i64) -> &i64 {\n"
    s = s + "    return &x\n"
    s = s + "}\n"
    return s
}

fn _src_fp_ret_value() -> string {
    // Returning the value by move/copy — not a borrow → silent.
    let mut s = "fn frv() -> i64 {\n"
    s = s + "    let x = 5\n"
    s = s + "    return x\n"
    s = s + "}\n"
    return s
}

fn _src_fp_ref_no_escape() -> string {
    // A borrow that never leaves the function → silent (no return of `r`).
    let mut s = "fn frn() -> i64 {\n"
    s = s + "    let x = 5\n"
    s = s + "    let r = &x\n"
    s = s + "    return x\n"
    s = s + "}\n"
    return s
}

fn _src_fp_ret_global_ref() -> string {
    // Borrow of a module-level global — its storage outlives the call, so
    // the conservative check excludes it (is_global exclusion) → silent.
    let mut s = "let g = 0\n"
    s = s + "fn frg() -> &i64 {\n"
    s = s + "    return &g\n"
    s = s + "}\n"
    return s
}

fn _src_fp_ref_killed() -> string {
    // The ref binding is reassigned to a non-borrow RHS before the return,
    // killing the loan (newest-per-name wins) → silent.
    let mut s = "fn frk() -> i64 {\n"
    s = s + "    let x = 5\n"
    s = s + "    let mut r = &x\n"
    s = s + "    r = 7\n"
    s = s + "    return r\n"
    s = s + "}\n"
    return s
}

// HX3019 probe runner — mirrors `_run_probe` but keys on HX3019 (the
// return-borrow code) and asserts every OTHER code is 0 (probe hygiene).
// STRICT re-bands HX3019 to Error, so the error-band count must equal the
// HX3019 count (escalation is severity-only). OFF → want 0 (empty stream).
fn _run_ret_probe(label: string, src: string, want_on: i64) -> bool {
    let strict = env("HEXA_BORROWCK_STRICT") == "1"
    let flag_on = env("HEXA_BORROWCK") == "1" || strict
    let mut want = 0
    if flag_on { want = want_on }
    let mut ok = true
    println("")
    println("── " + label + " (expect HX3019 ×" + to_string(want) + ") ──")
    let d = _compile_probe(label, src)
    let n = _count_code(d, "HX3019")
    let other = len(d) - n
    _print_diags(d)
    if n != want {
        println("  FAIL: HX3019 = " + to_string(n) + ", want " + to_string(want))
        ok = false
    }
    if other != 0 {
        println("  FAIL: stray non-HX3019 diagnostics = " + to_string(other))
        ok = false
    }
    if strict {
        let eb = _count_error_band(d)
        if eb != want {
            println("  FAIL: STRICT error-band = " + to_string(eb) + ", want " + to_string(want))
            ok = false
        }
    }
    if ok { println("  ok: ×" + to_string(want)) }
    return ok
}

// ── HEXA-OWN E2+E3 — borrow-conflict rule (HX3021/HX3028, E0502/E0499) ──
//
// The E2 loan registry (name → origin, mutability bit, live via
// kill-on-reassign) is wired to E3's first conflict check: a NEW borrow
// `&x` / `&mut x` over a function-local that already has a LIVE loan of the
// same origin conflicts when the existing loan is `&mut` (any second borrow
// illegal) OR the new borrow is `&mut` (mutable demands exclusivity). Two
// shared borrows never conflict. E3.9 faithfulness split (Rust): the BOTH-
// mutable case (`&mut` while `&mut`) is E0499 → HX3028; the shared-vs-mut
// case (`&` while `&mut`) stays E0502 → HX3021. ON → 1 diagnostic per
// hazard; OFF → empty stream (byteeq-neutral). Controls (both-shared,
// sequential-after-kill, different-origin) stay at 0.

fn _src_hz_shared_while_mut() -> string {
    // `&x` while `&mut x` is live → E0502 (shared-while-mut).
    let mut s = "fn hsm() {\n"
    s = s + "    let mut x = 5\n"
    s = s + "    let m = &mut x\n"
    s = s + "    let s = &x\n"
    s = s + "    println(1)\n"
    s = s + "}\n"
    return s
}

fn _src_hz_mut_while_mut() -> string {
    // A second `&mut x` while the first `&mut x` is live → E0499 (double-mut),
    // the faithfulness split — HX3028, NOT the shared-vs-mut HX3021/E0502.
    let mut s = "fn hmm() {\n"
    s = s + "    let mut x = 5\n"
    s = s + "    let a = &mut x\n"
    s = s + "    let b = &mut x\n"
    s = s + "    println(1)\n"
    s = s + "}\n"
    return s
}

fn _src_fp_two_shared() -> string {
    // `&x` then `&x` — two shared borrows never conflict → silent.
    let mut s = "fn fts() {\n"
    s = s + "    let mut x = 5\n"
    s = s + "    let a = &x\n"
    s = s + "    let b = &x\n"
    s = s + "    println(1)\n"
    s = s + "}\n"
    return s
}

fn _src_fp_sequential() -> string {
    // The first `&mut x` loan is killed by `a = 0` before the second
    // borrow — no live loan overlaps, so the reborrow is fine → silent.
    let mut s = "fn fseq() {\n"
    s = s + "    let mut x = 5\n"
    s = s + "    let mut a = &mut x\n"
    s = s + "    a = 0\n"
    s = s + "    let b = &mut x\n"
    s = s + "    println(1)\n"
    s = s + "}\n"
    return s
}

fn _src_fp_diff_origin() -> string {
    // Borrows of DIFFERENT origins never alias → silent.
    let mut s = "fn fdo() {\n"
    s = s + "    let mut x = 5\n"
    s = s + "    let mut y = 5\n"
    s = s + "    let a = &mut x\n"
    s = s + "    let b = &mut y\n"
    s = s + "    println(1)\n"
    s = s + "}\n"
    return s
}

// ── HEXA-OWN R6-A — call-arg borrow-conflict (HX3021/HX3028, E0502/E0499) ──
//
// E2+E3 extended to CALL ARGUMENTS: a bare `&x` / `&mut x` passed as a call
// arg is registered + conflict-scanned exactly like a let-RHS borrow (the
// let-RHS site never saw call-arg borrows, so these hazards were SILENT). Two
// `&mut x` in one arg list → E0499 double-mut → HX3028; a `&mut x` arg while a
// prior `&x` loan is live → shared-vs-mut → HX3021; two `&x` args never
// conflict. ON → 1 diagnostic per hazard; OFF → empty stream (byteeq-neutral).

fn _src_hz_callarg_double_mut() -> string {
    // `f(&mut x, &mut x)` — both args borrow x mutably in one call → E0499.
    let mut s = "fn cadm_f(a: i64, b: i64) { println(a) }\n"
    s = s + "fn cadm() {\n"
    s = s + "    let mut x = 5\n"
    s = s + "    cadm_f(&mut x, &mut x)\n"
    s = s + "    println(1)\n"
    s = s + "}\n"
    return s
}

fn _src_fp_callarg_two_shared() -> string {
    // `f(&x, &x)` — two shared call-arg borrows never conflict → silent.
    let mut s = "fn cats_f(a: i64, b: i64) { println(a) }\n"
    s = s + "fn cats() {\n"
    s = s + "    let mut x = 5\n"
    s = s + "    cats_f(&x, &x)\n"
    s = s + "    println(1)\n"
    s = s + "}\n"
    return s
}

fn _src_hz_callarg_mut_while_shared() -> string {
    // `let r = &x; f(&mut x)` — a `&mut x` call-arg while a prior shared loan
    // of x is live → E0502 (shared-while-mut), the HX3021 split (NOT HX3028,
    // since the existing loan is `&`, not `&mut`).
    let mut s = "fn camws_f(a: i64) { println(a) }\n"
    s = s + "fn camws() {\n"
    s = s + "    let mut x = 5\n"
    s = s + "    let r = &x\n"
    s = s + "    camws_f(&mut x)\n"
    s = s + "    println(1)\n"
    s = s + "}\n"
    return s
}

// ── HEXA-OWN E4 — write-through-while-borrowed (HX3023, Rust E0506) ──
//
// The E2 loan registry (reused from E2+E3) feeds a SECOND conflict rule at
// the ASSIGN arm: `x = RHS` over a non-global ident `x` scans for ANY live
// loan whose origin == `x` (regardless of mutability — a write invalidates
// both `&` and `&mut` loans) and fires HX3023. The scan runs PRE-KILL so the
// registry still reflects every live loan of `x` as origin. ON → 1 HX3023
// per hazard; OFF → empty stream (byteeq-neutral). Controls (no-borrow-then-
// assign, different-origin) stay at 0.

fn _src_hz_write_through() -> string {
    // `let r = &x; x = 5` — r is live when x is written → E0506 (shared loan).
    let mut s = "fn hwt() {\n"
    s = s + "    let mut x = 5\n"
    s = s + "    let r = &x\n"
    s = s + "    x = 5\n"
    s = s + "    println(1)\n"
    s = s + "}\n"
    return s
}

fn _src_hz_write_through_mut() -> string {
    // `let m = &mut x; x = 5` — a write invalidates a live `&mut` loan too
    // (the scan keys on origin, not mutability) → E0506.
    let mut s = "fn hwtm() {\n"
    s = s + "    let mut x = 5\n"
    s = s + "    let m = &mut x\n"
    s = s + "    x = 9\n"
    s = s + "    println(1)\n"
    s = s + "}\n"
    return s
}

fn _src_fp_write_no_borrow() -> string {
    // `x = 9` with no prior borrow of x → no live loan to conflict → silent.
    let mut s = "fn fwnb() {\n"
    s = s + "    let mut x = 5\n"
    s = s + "    x = 9\n"
    s = s + "    println(x)\n"
    s = s + "}\n"
    return s
}

fn _src_fp_write_diff_origin() -> string {
    // `let r = &y; x = 5` — the live loan's origin is y, not x → silent.
    let mut s = "fn fwdo() {\n"
    s = s + "    let mut x = 5\n"
    s = s + "    let mut y = 7\n"
    s = s + "    let r = &y\n"
    s = s + "    x = 5\n"
    s = s + "    println(1)\n"
    s = s + "}\n"
    return s
}

fn _src_fp_use_then_write() -> string {
    // `let r = &x; <use r>; x = 5` — DOCUMENTED flow-insensitive false-
    // positive: under no NLL last-use yet r is STILL live at the assign, so
    // HX3023 fires ×1 (Rust NLL would end r's loan at last use → silent).
    // Conservative loud-over-quiet, the SAME policy as E2/E3. A future NLL
    // last-use improvement would UPDATE this probe's expectation to 0.
    let mut s = "fn fuutw() {\n"
    s = s + "    let mut x = 5\n"
    s = s + "    let r = &x\n"
    s = s + "    println(r)\n"
    s = s + "    x = 5\n"
    s = s + "    println(1)\n"
    s = s + "}\n"
    return s
}

// ── HEXA-OWN L5-E5 — use-while-mutably-borrowed (HX3027, Rust E0503) ──
//
// The E2 loan registry feeds a THIRD conflict rule at the ident READ funnel
// (`_bck_check_use`): a use (read of value) of `x` while a live `&mut x` loan
// exists fires HX3027. UNLIKE E4 write-through (both loan kinds), E0503 keys on
// the mutability bit — a use while only a shared `&x` loan is live is SILENT.
// A borrow RHS (`&mut x` re-borrow) is exempt (that is E3/HX3021's to report).
// ON → 1 HX3027 per hazard; OFF → empty stream (byteeq-neutral).

fn _src_hz_use_while_mut() -> string {
    // `let m = &mut x; let y = x + 1` — x is READ while a live `&mut` loan of
    // it exists → E0503. The read is inside a binop (value-use), not a borrow.
    let mut s = "fn huwm() {\n"
    s = s + "    let mut x = 5\n"
    s = s + "    let m = &mut x\n"
    s = s + "    let y = x + 1\n"
    s = s + "    println(1)\n"
    s = s + "}\n"
    return s
}

fn _src_fp_use_shared() -> string {
    // `let r = &x; let y = x` — the live loan is SHARED (`&`), which permits
    // concurrent reads → E0503 does NOT fire (mutability-bit keyed) → silent.
    let mut s = "fn fus() {\n"
    s = s + "    let mut x = 5\n"
    s = s + "    let r = &x\n"
    s = s + "    let y = x\n"
    s = s + "    println(1)\n"
    s = s + "}\n"
    return s
}

fn _src_fp_use_after_kill() -> string {
    // `let mut m = &mut x; m = 0; let y = x` — the `&mut` loan is killed by the
    // non-borrow reassign before x is read → no live mutable loan → silent.
    let mut s = "fn fuak() {\n"
    s = s + "    let mut x = 5\n"
    s = s + "    let mut m = &mut x\n"
    s = s + "    m = 0\n"
    s = s + "    let y = x\n"
    s = s + "    println(1)\n"
    s = s + "}\n"
    return s
}

fn _src_fp_use_loan_name() -> string {
    // `let m = &mut x; let y = m` — reading the loan BINDING `m` (not its
    // origin) never matches `_bck_ref_find_mut_loan(name="m")` (no loan has
    // origin "m") → silent. This is the intended use of a mutable borrow.
    let mut s = "fn fuln() {\n"
    s = s + "    let mut x = 5\n"
    s = s + "    let m = &mut x\n"
    s = s + "    let y = m\n"
    s = s + "    println(1)\n"
    s = s + "}\n"
    return s
}

// §5.2 ⓐ double-fire probe: a re-borrow `let n = &mut x` while a live `&mut x`
// loan exists reads x to take its ADDRESS. WITHOUT the `_bck_in_borrow_rhs`
// suppression this would fire BOTH the borrow-conflict AND HX3027 (E5 use).
// With suppression, E3 owns it alone: HX3027 = 0. Because BOTH loans are
// `&mut`, the E3.9 split routes the conflict to HX3028 (E0499 double-mut), NOT
// HX3021 — so this asserts HX3028 = 1, HX3021 = 0, HX3027 = 0 (the standard
// hygiene runner cannot — the conflict code is a legit non-HX3027 stray).
fn _src_fp_reborrow_suppress() -> string {
    let mut s = "fn frs() {\n"
    s = s + "    let mut x = 5\n"
    s = s + "    let m = &mut x\n"
    s = s + "    let n = &mut x\n"
    s = s + "    println(1)\n"
    s = s + "}\n"
    return s
}

fn _run_reborrow_suppress_probe() -> bool {
    let strict = env("HEXA_BORROWCK_STRICT") == "1"
    let flag_on = env("HEXA_BORROWCK") == "1" || strict
    let mut want_use = 0
    let mut want_dmut = 0
    if flag_on { want_dmut = 1 }
    let mut ok = true
    println("")
    println("── fp_reborrow_suppress (expect HX3027 ×" + to_string(want_use)
        + " suppressed, HX3028 ×" + to_string(want_dmut) + " owns it, HX3021 ×0) ──")
    let d = _compile_probe("fp_reborrow_suppress", _src_fp_reborrow_suppress())
    let nu = _count_code(d, "HX3027")
    let nd = _count_code(d, "HX3028")
    let nc = _count_code(d, "HX3021")
    let other = len(d) - nu - nd - nc
    _print_diags(d)
    if nu != want_use {
        println("  FAIL: HX3027 = " + to_string(nu) + ", want " + to_string(want_use) + " (E5 must be suppressed inside a borrow RHS)")
        ok = false
    }
    if nd != want_dmut {
        println("  FAIL: HX3028 = " + to_string(nd) + ", want " + to_string(want_dmut) + " (E0499 double-mut owns the re-borrow)")
        ok = false
    }
    if nc != 0 {
        println("  FAIL: HX3021 = " + to_string(nc) + ", want 0 (mut-mut MIGRATED off E0502)")
        ok = false
    }
    if other != 0 {
        println("  FAIL: stray non-HX3027/HX3028/HX3021 diagnostics = " + to_string(other))
        ok = false
    }
    if ok { println("  ok: HX3027 ×" + to_string(want_use) + " (suppressed) · HX3028 ×" + to_string(want_dmut) + " · HX3021 ×0") }
    return ok
}

// §5.4 rider — compound-assign dual-fire pin: `let m = &mut x; x = x + 1` while
// a live `&mut x` loan exists is BOTH a write-through of x (E0506/HX3023, the
// assign span) AND a value-use of x in the RHS `x + 1` (E0503/HX3027, the RHS
// read span). The two fire at DISTINCT (line,col) spans so the shared same-site
// dedup array keeps both. Rust is likewise dual (E0503 on the use + E0506 on
// the assign), so 1+1 is the faithful expectation, pinned here as a control
// (no HX3028 — there is no second borrow). OFF → empty stream.
fn _src_hz_compound_assign() -> string {
    let mut s = "fn hca() {\n"
    s = s + "    let mut x = 5\n"
    s = s + "    let m = &mut x\n"
    s = s + "    x = x + 1\n"
    s = s + "    println(1)\n"
    s = s + "}\n"
    return s
}

fn _run_compound_assign_probe() -> bool {
    let strict = env("HEXA_BORROWCK_STRICT") == "1"
    let flag_on = env("HEXA_BORROWCK") == "1" || strict
    let mut want = 0
    if flag_on { want = 1 }
    let mut ok = true
    println("")
    println("── hz_compound_assign (expect HX3023 ×" + to_string(want)
        + " + HX3027 ×" + to_string(want) + " dual-fire) ──")
    let d = _compile_probe("hz_compound_assign", _src_hz_compound_assign())
    let nw = _count_code(d, "HX3023")
    let nu = _count_code(d, "HX3027")
    let other = len(d) - nw - nu
    _print_diags(d)
    if nw != want {
        println("  FAIL: HX3023 = " + to_string(nw) + ", want " + to_string(want) + " (write-through of x)")
        ok = false
    }
    if nu != want {
        println("  FAIL: HX3027 = " + to_string(nu) + ", want " + to_string(want) + " (use of x in RHS)")
        ok = false
    }
    if other != 0 {
        println("  FAIL: stray non-HX3023/HX3027 diagnostics = " + to_string(other))
        ok = false
    }
    if strict {
        let eb = _count_error_band(d)
        if eb != (want + want) {
            println("  FAIL: STRICT error-band = " + to_string(eb) + ", want " + to_string(want + want))
            ok = false
        }
    }
    if ok { println("  ok: HX3023 ×" + to_string(want) + " · HX3027 ×" + to_string(want) + " (faithful dual-fire)") }
    return ok
}

// HX3027 probe runner — mirrors `_run_write_through_probe`, keyed on the use-
// while-mut code and asserting every OTHER code is 0 (probe hygiene). STRICT
// re-bands HX3027 to Error, so the error-band count must equal the HX3027
// count. OFF → want 0 (empty stream).
fn _run_use_while_mut_probe(label: string, src: string, want_on: i64) -> bool {
    let strict = env("HEXA_BORROWCK_STRICT") == "1"
