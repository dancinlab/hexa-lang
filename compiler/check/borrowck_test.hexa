// ── driver ───────────────────────────────────────────────────

fn main() {
    let census_mode = env("HEXA_BORROWCK_CENSUS") == "1"
    println("══════════════════════════════════════════════")
    println("  HEXA-OWN L3 M3+M4 — loan pass + NLL liveness (HX3014)")
    let mut mode = "OFF (byteeq-neutral sweep)"
    if env("HEXA_BORROWCK") == "1" { mode = "ON (HEXA_BORROWCK=1)" }
    if env("HEXA_BORROWCK_STRICT") == "1" { mode = "STRICT (HEXA_BORROWCK_STRICT=1 — HX3014 fatal)" }
    if census_mode { mode = "CENSUS (HEXA_BORROWCK_CENSUS=1 — L4 A2 would-move)" }
    println("  flag mode: " + mode)
    println("══════════════════════════════════════════════")

    // In CENSUS mode the M3+M4 pass runs (census implies `_bck_on`), so the
    // HX3014 hazard probes — whose expectations key on HEXA_BORROWCK — would
    // spuriously fire. Run ONLY the census assertion in that mode.
    if census_mode {
        let cok = _run_census()
        println("")
        if cok {
            println("CENSUS PASS — N would-move sites counted (move-by-default worklist)")
        } else {
            println("CENSUS FAILURES — see above")
            exit(1)
        }
    } else {
        let mut ok = true

        if !_run_probe("hz_write_alias", _src_hz_write_alias(), 1) { ok = false }
        if !_run_probe("hz_write_alias_field", _src_hz_write_alias_field(), 1) { ok = false }
        if !_run_probe("hz_push_alias", _src_hz_push_alias(), 1) { ok = false }
        if !_run_probe("fp_arr_alias_read", _src_fp_arr_alias_read(), 0) { ok = false }
        if !_run_probe("fp_callarg", _src_fp_callarg(), 0) { ok = false }
        if !_run_probe("fp_copy_int", _src_fp_copy_int(), 0) { ok = false }
        if !_run_probe("fp_write_same_name", _src_fp_write_same_name(), 0) { ok = false }
        if !_run_probe("fp_repoint", _src_fp_repoint(), 0) { ok = false }
        if !_run_probe("xb_write_in_branch", _src_xb_write_in_branch(), 1) { ok = false }
        if !_run_probe("xb_loop_carried", _src_xb_loop_carried(), 1) { ok = false }
        if !_run_probe("fp_benign_join", _src_fp_benign_join(), 0) { ok = false }
        // HEXA-OWN L5-E1 — return-borrow-escape (HX3019). Hazards → ×1 ON,
        // controls → 0. OFF sweep asserts a fully empty stream for all.
        if !_run_ret_probe("hz_ret_ref_direct", _src_hz_ret_ref_direct(), 1) { ok = false }
        if !_run_ret_probe("hz_ret_refmut_direct", _src_hz_ret_refmut_direct(), 1) { ok = false }
        if !_run_ret_probe("hz_ret_ref_onehop", _src_hz_ret_ref_onehop(), 1) { ok = false }
        if !_run_ret_probe("hz_ret_ref_param", _src_hz_ret_ref_param(), 1) { ok = false }
        if !_run_ret_probe("fp_ret_value", _src_fp_ret_value(), 0) { ok = false }
        if !_run_ret_probe("fp_ref_no_escape", _src_fp_ref_no_escape(), 0) { ok = false }
        if !_run_ret_probe("fp_ret_global_ref", _src_fp_ret_global_ref(), 0) { ok = false }
        if !_run_ret_probe("fp_ref_killed", _src_fp_ref_killed(), 0) { ok = false }
        // HEXA-OWN E2+E3 — borrow-conflict (HX3021, Rust E0502) + E3.9 E0499
        // split (HX3028). Hazards → ×1 ON, controls → 0. shared-while-mut stays
        // HX3021; mut-while-mut MIGRATED to HX3028 (asserts HX3021=0). OFF sweep
        // asserts a fully empty stream for all.
        if !_run_conflict_probe("hz_shared_while_mut", _src_hz_shared_while_mut(), 1) { ok = false }
        if !_run_double_mut_probe("hz_mut_while_mut", _src_hz_mut_while_mut(), 1) { ok = false }
        if !_run_conflict_probe("fp_two_shared", _src_fp_two_shared(), 0) { ok = false }
        if !_run_conflict_probe("fp_sequential", _src_fp_sequential(), 0) { ok = false }
        if !_run_conflict_probe("fp_diff_origin", _src_fp_diff_origin(), 0) { ok = false }
        // HEXA-OWN R6-A — call-arg borrow-conflict. `f(&mut x, &mut x)` → E0499
        // (HX3028 ×1); `f(&mut x)` while `&x` live → E0502 (HX3021 ×1); `f(&x,
        // &x)` never conflicts (×0). OFF → empty stream; STRICT → Error-band.
        if !_run_double_mut_probe("hz_callarg_double_mut", _src_hz_callarg_double_mut(), 1) { ok = false }
        if !_run_conflict_probe("hz_callarg_mut_while_shared", _src_hz_callarg_mut_while_shared(), 1) { ok = false }
        if !_run_conflict_probe("fp_callarg_two_shared", _src_fp_callarg_two_shared(), 0) { ok = false }
        // HEXA-OWN E4 — write-through-while-borrowed (HX3023, Rust E0506).
        // Hazards → ×1 ON, controls → 0. fp_use_then_write is the documented
        // flow-insensitive false-positive (×1 under ON, no NLL last-use yet).
        // OFF sweep asserts a fully empty stream for all.
        if !_run_write_through_probe("hz_write_through", _src_hz_write_through(), 1) { ok = false }
        if !_run_write_through_probe("hz_write_through_mut", _src_hz_write_through_mut(), 1) { ok = false }
        if !_run_write_through_probe("fp_write_no_borrow", _src_fp_write_no_borrow(), 0) { ok = false }
        if !_run_write_through_probe("fp_write_diff_origin", _src_fp_write_diff_origin(), 0) { ok = false }
        if !_run_write_through_probe("fp_use_then_write", _src_fp_use_then_write(), 1) { ok = false }
        // HEXA-OWN L5-E5 — use-while-mutably-borrowed (HX3027, Rust E0503).
        // Hazard → ×1 ON; controls (shared loan, killed loan, loan-name read)
        // → 0. fp_reborrow_suppress proves the borrow-RHS suppression: E5 stays
        // silent while E3 (HX3021) owns the re-borrow. OFF sweep → empty stream.
        if !_run_use_while_mut_probe("hz_use_while_mut", _src_hz_use_while_mut(), 1) { ok = false }
        if !_run_use_while_mut_probe("fp_use_shared", _src_fp_use_shared(), 0) { ok = false }
        if !_run_use_while_mut_probe("fp_use_after_kill", _src_fp_use_after_kill(), 0) { ok = false }
        if !_run_use_while_mut_probe("fp_use_loan_name", _src_fp_use_loan_name(), 0) { ok = false }
        if !_run_reborrow_suppress_probe() { ok = false }

        // HEXA-OWN L5-E7 — assign-behind-shared-ref (HX3031, Rust E0594)
        if !_run_assign_behind_ref_probe("hz_assign_behind_ref", _src_hz_assign_behind_ref(), 1) { ok = false }
        if !_run_assign_behind_ref_probe("hz_index_behind_ref", _src_hz_index_behind_ref(), 1) { ok = false }
        if !_run_assign_behind_ref_probe("fp_assign_behind_mut", _src_fp_assign_behind_mut(), 0) { ok = false }
        if !_run_assign_behind_ref_probe("fp_assign_no_borrow", _src_fp_assign_no_borrow(), 0) { ok = false }
        // §5.4 rider — compound-assign dual-fire (HX3023 + HX3027, faithful).
        if !_run_compound_assign_probe() { ok = false }
        if !_run_tp_own() { ok = false }
        // HEXA-OWN L5-E6 — move-out-while-borrowed (HX3029, Rust E0505). Hand-
        // built HIR (@own inline-carrier #4470 not landed). ① shared loan live at
        // an @own move → HX3029 ×1. ② `&mut` loan → HX3027 ×1, HX3029 ×0 (the arg
        // READ's E0503 preempts at the move span, shared dedup collapses HX3029 —
        // "shared-loan primary"). ③ no loan → 0. OFF → empty stream.
        if !_run_mvb("hz_move_while_shared_borrow", true, false, 1, 0) { ok = false }
        if !_run_mvb("fp_move_while_mut_borrow_dedup", true, true, 0, 1) { ok = false }
        if !_run_mvb("fp_move_no_borrow", false, false, 0, 0) { ok = false }
        // HEXA-OWN L5-E8 — mutating-method-behind-shared-ref (HX3032, Rust
        // E0596). Hazard `r.push(…)` through a live `&` borrow → ×1 ON; a
        // `&mut` receiver, a call on the owner, and a non-mutating selector
        // all → 0. OFF → empty stream; STRICT → Error-band.
        if !_run_mut_method_probe("hz_mut_method_behind_ref", _src_hz_mut_method_behind_ref(), 1) { ok = false }
        if !_run_mut_method_probe("fp_mut_method_mutref", _src_fp_mut_method_mutref(), 0) { ok = false }
        if !_run_mut_method_probe("fp_mut_method_owner", _src_fp_mut_method_owner(), 0) { ok = false }
        if !_run_mut_method_probe("fp_nonmut_method_ref", _src_fp_nonmut_method_ref(), 0) { ok = false }
        // HEXA-OWN L5-E9 — move-out-of-borrowed-content (HX3034, Rust E0507).
        // Hand-built HIR: an @own call arg `r.f` where `r` is a live `&`/`&mut`
        // ref binding → HX3034 ×1 (mutability-blind — BOTH loan kinds fire).
        // Report-only (no move recorded) → HX3034 stands ALONE, HX3027 ×0 (no
        // preemption). A plain-copy base (`let r = a`) and an owner-direct base
        // (`g(a.f)`) do NOT fire. OFF → empty stream; STRICT → Error-band.
        if !_run_mob("hz_move_out_shared_borrow", "shared", "r", 1) { ok = false }
        if !_run_mob("hz_move_out_mut_borrow", "mut", "r", 1) { ok = false }
        if !_run_mob("fp_move_out_plain_copy", "plain", "r", 0) { ok = false }
        if !_run_mob("fp_move_out_owner_base", "none", "a", 0) { ok = false }
        // HEXA-OWN round8-1 — use-of-possibly-uninitialized (HX3035, Rust
        // E0381). Hazards (read before init · use-then-init · loop first-iter)
        // → ×1 ON; controls (init-then-use · both-branches init · return branch
        // · partial field init · normal init) → 0. OFF → empty stream (byteeq-
        // neutral); STRICT → Error-band.
        if !_run_uninit_probe("hz_use_before_init", _src_hz_use_before_init(), 1) { ok = false }
        if !_run_uninit_probe("hz_use_then_init", _src_hz_use_then_init(), 1) { ok = false }
        if !_run_uninit_probe("hz_loop_first_iter", _src_hz_loop_first_iter(), 1) { ok = false }
        if !_run_uninit_probe("fp_init_then_use", _src_fp_init_then_use(), 0) { ok = false }
        if !_run_uninit_probe("fp_init_both_branches", _src_fp_init_both_branches(), 0) { ok = false }
        if !_run_uninit_probe("fp_return_branch", _src_fp_return_branch(), 0) { ok = false }
        if !_run_uninit_probe("fp_field_partial", _src_fp_field_partial(), 0) { ok = false }
        if !_run_uninit_probe("fp_normal_let", _src_fp_normal_let(), 0) { ok = false }
        // HEXA-OWN round8-2 — borrowed-value-does-not-live-long-enough (HX3036,
        // Rust E0597). Hazard (assign-arm re-borrow across a dying scope, used
        // after) → ×1 ON; controls (same-scope let-arm loan · repoint-to-live-
        // before-use) → 0. OFF → empty stream (byteeq-neutral); STRICT → Error-band.
        if !_run_outlives_probe("hz_dangle_asn_reborrow", _src_hz_dangle_asn_reborrow(), 1) { ok = false }
        if !_run_outlives_probe("fp_same_scope", _src_fp_same_scope(), 0) { ok = false }
        if !_run_outlives_probe("fp_reassign_before_use", _src_fp_reassign_before_use(), 0) { ok = false }
        // HEXA-OWN round8-3 — closure capture-move (HX3037, Rust E0507
        // "captured variable in an FnMut closure"). Hazards (a captured var
        // moved into an @own param inside a closure · same via a nested inner
        // closure) → ×1 ON; controls (param not @own · arg is the closure's
        // own param · body-let shadow of the capture · @own move in the
        // enclosing fn outside the closure) → 0. OFF → empty stream (byteeq-
        // neutral); STRICT → Error-band.
        if !_run_capture_move_probe("hz_clo_capture_move", _src_hz_clo_capture_move(), 1) { ok = false }
        if !_run_capture_move_probe("hz_clo_nested_capture_move", _src_hz_clo_nested_capture_move(), 1) { ok = false }
        if !_run_capture_move_probe("fp_clo_param_not_own", _src_fp_clo_param_not_own(), 0) { ok = false }
        if !_run_capture_move_probe("fp_clo_own_arg_is_param", _src_fp_clo_own_arg_is_param(), 0) { ok = false }
        if !_run_capture_move_probe("fp_clo_shadow_let", _src_fp_clo_shadow_let(), 0) { ok = false }
        if !_run_capture_move_probe("fp_clo_enclosing_direct", _src_fp_clo_enclosing_direct(), 0) { ok = false }
        // HEXA-OWN round9 — HX3038 move-out-of-array-by-indexing (E0508) + HX3039
        // move-out-of-borrowed-content via INDEX (E0507). `sink(a[i])` on an
        // owned-local array → HX3038 ×1; `sink(r[i])` on a live `&a` loan → HX3039
        // ×1; a non-@own arg and a global base → 0. OFF → empty; STRICT → Error-band.
        if !_run_moveout_array_probe("hz_moveout_array", _src_hz_moveout_array(), 1) { ok = false }
        if !_run_moveout_array_probe("fp_moveout_array_noown", _src_fp_moveout_array_noown(), 0) { ok = false }
        if !_run_moveout_index_probe("hz_moveout_index_borrow", _src_hz_moveout_index_borrow(), 1) { ok = false }
        if !_run_moveout_index_probe("fp_moveout_index_global", _src_fp_moveout_index_global(), 0) { ok = false }
        // HEXA-OWN round9 — HX3040 move-out-while-borrowed at the NON-call move
        // sites (E0505). `let b = a` / `b = a` / `return a` of an @own binding
        // while a live `&a` loan exists → HX3040 ×1; a killed loan → 0. OFF →
        // empty stream (byteeq-neutral); STRICT → Error-band.
        if !_run_nc_move_probe("hz_nc_move_let", _src_hz_nc_move_let(), 1) { ok = false }
        if !_run_nc_move_probe("hz_nc_move_assign", _src_hz_nc_move_assign(), 1) { ok = false }
        if !_run_nc_move_probe("hz_nc_move_return", _src_hz_nc_move_return(), 1) { ok = false }
        if !_run_nc_move_probe("fp_nc_move_killed", _src_fp_nc_move_killed(), 0) { ok = false }
        // HEXA-OWN L5 — HX3014 use-after-move (E0382) at the 3 NON-CALL move
        // sites — the DUAL of the HX3040 nc_move round above. `let b=a` /
        // `b=a` then a later use `a[0]` → HX3014 ×1; borrow (`&a`) / reassign
        // (`a=[9]`) / return-only controls → 0. OFF → 0 (byteeq-neutral);
        // STRICT → Error-band.
        if !_run_e0382_probe("hz_e0382_let", _src_hz_e0382_let(), 1) { ok = false }
        if !_run_e0382_probe("hz_e0382_assign", _src_hz_e0382_assign(), 1) { ok = false }
        if !_run_e0382_probe("fp_e0382_borrow", _src_fp_e0382_borrow(), 0) { ok = false }
        if !_run_e0382_probe("fp_e0382_reassign", _src_fp_e0382_reassign(), 0) { ok = false }
        if !_run_e0382_probe("fp_e0382_return_only", _src_fp_e0382_return_only(), 0) { ok = false }
        // HEXA-OWN round9 — HX3041 return-reference-to-temporary (E0515).
        // `return &<call/struct-literal/binop>` → HX3041 ×1; `return &<global>`
        // → 0. OFF → empty stream (byteeq-neutral); STRICT → Error-band.
        if !_run_ret_temp_probe("hz_ret_temp_call", _src_hz_ret_temp_call(), 1) { ok = false }
        if !_run_ret_temp_probe("hz_ret_temp_struct", _src_hz_ret_temp_struct(), 1) { ok = false }
        if !_run_ret_temp_probe("hz_ret_temp_binop", _src_hz_ret_temp_binop(), 1) { ok = false }
        if !_run_ret_temp_probe("fp_ret_temp_global", _src_fp_ret_temp_global(), 0) { ok = false }
        // HEXA-OWN round11 — HX3049 temporary-dropped-while-borrowed (E0716). An
        // assign-arm re-borrow of a CALL temporary `r = &make()` / `r = &mut make()`
        // into a longer-lived ref binding → HX3049 ×1; the LET-init `let r = &make()`
        // (temporary-lifetime-extension), a binop/struct temp (const-promotable), and
        // an assign whose LHS is not a known ref binding → 0. OFF → empty stream
        // (byteeq-neutral); STRICT → Error-band.
        if !_run_temp_dangle_probe("hz_asn_temp_call", _src_hz_asn_temp_call(), 1) { ok = false }
        if !_run_temp_dangle_probe("hz_asn_temp_call_mut", _src_hz_asn_temp_call_mut(), 1) { ok = false }
        if !_run_temp_dangle_probe("fp_letinit_temp", _src_fp_letinit_temp(), 0) { ok = false }
        if !_run_temp_dangle_probe("fp_asn_temp_binop", _src_fp_asn_temp_binop(), 0) { ok = false }
        if !_run_temp_dangle_probe("fp_asn_temp_struct", _src_fp_asn_temp_struct(), 0) { ok = false }
        if !_run_temp_dangle_probe("fp_asn_temp_unknown_ref", _src_fp_asn_temp_unknown_ref(), 0) { ok = false }
        // HEXA-OWN round10 — HX3042 use-of-partially-moved-value (E0382). A
        // field-projection move of `s.a` into an @own param, then a re-read of
        // the field / a whole-base use / a second move / an alias / a branch-join
        // / a loop-carried use → HX3042 ×1; the move site alone, a disjoint field,
        // a field reinit, a non-@own arg, and a module global → 0. OFF → empty
        // stream (byteeq-neutral); STRICT → Error-band.
        if !_run_pm_probe("hz_pm_use_field", _src_hz_pm_use_field(), 1) { ok = false }
        if !_run_pm_probe("hz_pm_use_whole", _src_hz_pm_use_whole(), 1) { ok = false }
        if !_run_pm_probe("hz_pm_double_move", _src_hz_pm_double_move(), 1) { ok = false }
        if !_run_pm_probe("hz_pm_alias", _src_hz_pm_alias(), 1) { ok = false }
        if !_run_pm_probe("xb_pm_branch_join", _src_xb_pm_branch_join(), 1) { ok = false }
        // ×2: on the repeat iteration BOTH the body's read AND the re-move of the
        // already-moved `s.a` are E0382 (rustc-faithful loop re-move; see source).
        if !_run_pm_probe("xb_pm_loop_carried", _src_xb_pm_loop_carried(), 2) { ok = false }
        if !_run_pm_probe("fp_pm_move_site_only", _src_fp_pm_move_site_only(), 0) { ok = false }
        if !_run_pm_probe("fp_pm_disjoint", _src_fp_pm_disjoint(), 0) { ok = false }
        if !_run_pm_probe("fp_pm_reinit", _src_fp_pm_reinit(), 0) { ok = false }
        if !_run_pm_probe("fp_pm_noown", _src_fp_pm_noown(), 0) { ok = false }
        if !_run_pm_probe("fp_pm_global", _src_fp_pm_global(), 0) { ok = false }
        // HEXA-OWN HX3045 — cannot assign twice to immutable variable (E0384). A
        // `let x = 1; x = 2` reassign of an immutable binding → HX3045 ×1; a
        // `let mut` reassign, a deferred-init first assign, and a shadow rebind
        // → 0. OFF → empty stream (byteeq-neutral); STRICT → Error-band.
        if !_run_e0384_probe("hz_immut_reassign", _src_hz_immut_reassign(), 1) { ok = false }
        if !_run_e0384_probe("fp_mut_reassign", _src_fp_mut_reassign(), 0) { ok = false }
        if !_run_e0384_probe("fp_deferred_init", _src_fp_deferred_init(), 0) { ok = false }
        if !_run_e0384_probe("fp_shadow_rebind", _src_fp_shadow_rebind(), 0) { ok = false }
        // census lane must be silent whenever HEXA_BORROWCK_CENSUS is unset
        // (byteeq-neutral proof at the census-count level).
        if !_run_census() { ok = false }

        println("")
        if ok {
            println("ALL PASS — M3 discriminator + M4 cross-block liveness hold")
        } else {
            println("FAILURES — see above")
            exit(1)
        }
    }
}
