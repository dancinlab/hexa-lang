    println("")
    println("── " + label + " (expect HX3027 ×" + to_string(want) + ") ──")
    let d = _compile_probe(label, src)
    let n = _count_code(d, "HX3027")
    let other = len(d) - n
    _print_diags(d)
    if n != want {
        println("  FAIL: HX3027 = " + to_string(n) + ", want " + to_string(want))
        ok = false
    }
    if other != 0 {
        println("  FAIL: stray non-HX3027 diagnostics = " + to_string(other))
        ok = false
    }
    if strict {
        let eb = _count_error_band(d)
        if eb != want {
            println("  FAIL: STRICT error-band = " + to_string(eb) + ", want " + to_string(want))
            ok = false
        }
    }
    if ok { println("  ok: ×" + to_string(want)) }
    return ok
}

