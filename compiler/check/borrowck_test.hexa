// ── HEXA-OWN L5-E7 — assign-behind-shared-ref (HX3031, Rust E0594) ──
// `let r = &s; r.f = v` / `r[i] = v` where r is a LIVE shared (`&`) loan →
// HX3031 (a `&` borrow grants no write-through). A `&mut` loan permits it
// (silent). ON → 1 HX3031 per hazard; OFF → empty stream (byteeq-neutral).
fn _run_assign_behind_ref_probe(label: string, src: string, want_on: i64) -> bool {
    let strict = env("HEXA_BORROWCK_STRICT") == "1"
    let flag_on = env("HEXA_BORROWCK") == "1" || strict
    let mut want = 0
    if flag_on { want = want_on }
    let mut ok = true
    println("")
    println("── " + label + " (expect HX3031 ×" + to_string(want) + ") ──")
    let d = _compile_probe(label, src)
    let n = _count_code(d, "HX3031")
    let other = len(d) - n
    _print_diags(d)
    if n != want {
        println("  FAIL: HX3031 = " + to_string(n) + ", want " + to_string(want))
        ok = false
    }
    if other != 0 {
        println("  FAIL: stray non-HX3031 diagnostics = " + to_string(other))
        ok = false
    }
    if strict {
        let eb = _count_error_band(d)
        if eb != want {
            println("  FAIL: STRICT error-band = " + to_string(eb) + ", want " + to_string(want))
            ok = false
        }
    }
    if ok { println("  ok: ×" + to_string(want)) }
    return ok
}

fn _src_hz_assign_behind_ref() -> string {
    // `let r = &c; r.depth = 5` — r is a shared loan → write-through is E0594.
    let mut s = "struct Ctx { depth: i64 }\n"
    s = s + "fn habr() {\n"
    s = s + "    let c = Ctx { depth: 1 }\n"
    s = s + "    let r = &c\n"
    s = s + "    r.depth = 5\n"
    s = s + "    println(c.depth)\n"
    s = s + "}\n"
    return s
}

fn _src_hz_index_behind_ref() -> string {
    // `let r = &a; r[0] = 9` — shared loan, index-write → E0594.
    let mut s = "fn hibr() {\n"
    s = s + "    let a = [1, 2]\n"
    s = s + "    let r = &a\n"
    s = s + "    r[0] = 9\n"
    s = s + "    println(a[0])\n"
    s = s + "}\n"
    return s
}

fn _src_fp_assign_behind_mut() -> string {
    // `let m = &mut c; m.depth = 5` — a `&mut` loan permits write-through → no
    // HX3031. (Read through `m`, not `c` — reading `c` while the `&mut` loan is
    // live is a separate, legitimate HX3027 use-while-mut, unrelated to E0594.)
    let mut s = "struct Ctx2 { depth: i64 }\n"
    s = s + "fn fpabm() {\n"
    s = s + "    let mut c = Ctx2 { depth: 1 }\n"
    s = s + "    let m = &mut c\n"
    s = s + "    m.depth = 5\n"
    s = s + "    println(m.depth)\n"
    s = s + "}\n"
    return s
}

fn _src_fp_assign_no_borrow() -> string {
    // no ref binding — plain field write on the owner → silent.
    let mut s = "struct Ctx3 { depth: i64 }\n"
    s = s + "fn fpanb() {\n"
    s = s + "    let mut c = Ctx3 { depth: 1 }\n"
    s = s + "    c.depth = 5\n"
    s = s + "    println(c.depth)\n"
    s = s + "}\n"
    return s
}

// ── tp_own_param_move: hand-built HIR (Rule 2 mechanism proof) ──

fn _tsp(line: i64) -> Span {
    return Span { file: "tp_own.hexa", line: line, col: 1, len: 1 }
}

fn _t_kind(k: string) -> Type {
    return Type {
        kind: k, def: DefId { module: "", index: -1 },
        args: [], ret: [], domain: "", unit: ""
    }
}

fn _t_arr_i64() -> Type {
    let mut a: [Type] = []
    a.push(_t_kind("i64"))
    return Type {
        kind: "array", def: DefId { module: "", index: -1 },
        args: a, ret: [], domain: "", unit: ""
    }
}

fn _hx(kind: string, text: string, kids: [HExpr], line: i64) -> HExpr {
    return HExpr {
        kind: kind, span: _tsp(line), typ: _t_kind("?"), text: text,
        children: kids,
        atlas: AtlasBinding { ref_kind: "", id: "", atlas_index: -1, atlas_hash: "" },
        def: DefId { module: "", index: -1 },
        annotations: []
    }
}

fn _hx_int(v: string, line: i64) -> HExpr {
    let mut e = _hx("literal_int", v, [], line)
    return HExpr {
        kind: e.kind, span: e.span, typ: _t_kind("i64"), text: e.text,
        children: e.children, atlas: e.atlas, def: e.def, annotations: e.annotations
    }
}

fn _ast_ident_arg(name: string) -> Expr {
    return Expr {
        kind: ExprKind::Ident, span: _tsp(1), text: name,
        annotations: [], children: [],
        atlas_ref: AtlasRef { kind: "", id: "", span: _tsp(1) }
    }
}

fn _ann1(name: string, argname: string) -> Annotation {
    let mut args: [Expr] = []
    args.push(_ast_ident_arg(argname))
    return Annotation { name: name, args: args, span: _tsp(1) }
}

fn _hitem_fn(name: string, anns: [Annotation], sigp: [Type], body: HExpr) -> HItem {
    return HItem {
        kind: "ITEM_FN", def: DefId { module: "", index: -1 },
        name: name, span: _tsp(1), annotations: anns,
        sig_params: sigp, sig_return: _t_kind("unit"), body: body,
        is_pub: false, discoverable: false, proof_hash: "", verifier_version: ""
    }
}

// module:
//   fn g(@own p: [i64]) {}            (annotations: own(p) + param_names(p))
//   fn tp_caller() {
//       let a = [1]
//       g(a)                          → MOVE (own-param index 0)
//       let n = a[0]                  → use after move → HX3014 ×1
//   }
fn _build_tp_own_module() -> HModule {
    // fn g — empty body, @own aggregate param p.
    let mut g_anns: [Annotation] = []
    g_anns.push(_ann1("own", "p"))
    g_anns.push(_ann1("param_names", "p"))
    let mut g_sigp: [Type] = []
    g_sigp.push(_t_arr_i64())
    let g_body = _hx("block", "", [], 1)
    let item_g = _hitem_fn("g", g_anns, g_sigp, g_body)

    // fn tp_caller
    let mut arr_kids: [HExpr] = []
    arr_kids.push(_hx_int("1", 2))
    let mut let_a_kids: [HExpr] = []
    let_a_kids.push(_hx("array_lit", "", arr_kids, 2))
    let let_a = _hx("let", "a", let_a_kids, 2)

    let mut call_kids: [HExpr] = []
    call_kids.push(_hx("ident", "g", [], 3))
    call_kids.push(_hx("ident", "a", [], 3))
    let call_g = _hx("call", "", call_kids, 3)

    let mut idx_kids: [HExpr] = []
    idx_kids.push(_hx("ident", "a", [], 4))
    idx_kids.push(_hx_int("0", 4))
    let mut let_n_kids: [HExpr] = []
    let_n_kids.push(_hx("index", "", idx_kids, 4))
    let let_n = _hx("let", "n", let_n_kids, 4)

    let mut body_kids: [HExpr] = []
    body_kids.push(let_a)
    body_kids.push(call_g)
    body_kids.push(let_n)
    let body = _hx("block", "", body_kids, 2)
    let mut caller_anns: [Annotation] = []
    let item_c = _hitem_fn("tp_caller", caller_anns, [], body)

    let mut items: [HItem] = []
    items.push(item_g)
    items.push(item_c)
    return HModule { file: "tp_own.hexa", items: items }
}

fn _run_tp_own() -> bool {
    let strict = env("HEXA_BORROWCK_STRICT") == "1"
    let flag_on = env("HEXA_BORROWCK") == "1" || strict
    let mut want = 0
    if flag_on { want = 1 }
    let mut ok = true
    println("")
    println("── tp_own_param_move (hand-built HIR, expect HX3014 ×" + to_string(want) + " Rule 2) ──")
    let mm = lower_hir(_build_tp_own_module())
    let d = hir_to_mir_diags()
    let n = _count_code(d, "HX3014")
    _print_diags(d)
    if n != want {
        println("  FAIL: HX3014 = " + to_string(n) + ", want " + to_string(want))
        ok = false
    }
    if len(d) - n != 0 {
        println("  FAIL: stray non-HX3014 diagnostics")
        ok = false
    }
    if strict {
        let eb = _count_error_band(d)
        if eb != want {
            println("  FAIL: STRICT error-band = " + to_string(eb) + ", want " + to_string(want))
            ok = false
        }
    }
    if len(mm.funcs) != 2 {
        println("  FAIL: expected 2 lowered fns, got " + to_string(len(mm.funcs)))
        ok = false
    }
    if ok { println("  ok: ×" + to_string(want)) }
    return ok
}

// ── HEXA-OWN L5-E6 — move-out-while-borrowed (HX3029, Rust E0505) ──────
//
// #4470 (@own inline-carrier) has NOT landed, so a bare-ident @own move cannot
// be expressed in source — these probes hand-build the HIR (same technique as
// tp_own_param_move), inserting a `let r = &x` / `let r = &mut x` loan before an
// @own call-arg move of the same origin:
//
//   fn g(@own p: [i64]) {}
//   fn mvb_caller() {
//       let a = [1]
//       let r = &a        (or &mut a, or omitted)   line 3
//       g(a)              → MOVE (own-param index 0) line 4
//   }
//
// ① shared loan (`&a`) live at the move  → HX3029 ×1 (move-while-borrowed)
// ② `&mut a` loan live at the move       → HX3027 ×1, HX3029 ×0 — the arg
//    ident's READ fires E0503 first at the move span, and the shared same-site
//    dedup collapses HX3029 into it ("shared-loan primary" contract).
// ③ no loan at all                       → HX3029 ×0, HX3027 ×0
// OFF sweep → fully empty stream; STRICT re-bands the fired code to Error.
fn _build_mvb_module(with_loan: bool, mut_loan: bool) -> HModule {
    // fn g — empty body, @own aggregate param p.
    let mut g_anns: [Annotation] = []
    g_anns.push(_ann1("own", "p"))
    g_anns.push(_ann1("param_names", "p"))
    let mut g_sigp: [Type] = []
    g_sigp.push(_t_arr_i64())
    let g_body = _hx("block", "", [], 1)
    let item_g = _hitem_fn("g", g_anns, g_sigp, g_body)

    // fn mvb_caller — let a = [1]  ( [let r = &a / &mut a]  )  g(a)
    let mut arr_kids: [HExpr] = []
    arr_kids.push(_hx_int("1", 2))
    let mut let_a_kids: [HExpr] = []
    let_a_kids.push(_hx("array_lit", "", arr_kids, 2))
    let let_a = _hx("let", "a", let_a_kids, 2)

    let mut body_kids: [HExpr] = []
    body_kids.push(let_a)

    if with_loan {
        let mut ref_inner: [HExpr] = []
        ref_inner.push(_hx("ident", "a", [], 3))
        let mut btext = "&"
        if mut_loan { btext = "&mut" }
        let mut ref_kids: [HExpr] = []
        ref_kids.push(_hx("unop", btext, ref_inner, 3))
        let let_r = _hx("let", "r", ref_kids, 3)
        body_kids.push(let_r)
    }

    let mut call_kids: [HExpr] = []
    call_kids.push(_hx("ident", "g", [], 4))
    call_kids.push(_hx("ident", "a", [], 4))
    let call_g = _hx("call", "", call_kids, 4)
    body_kids.push(call_g)

    let body = _hx("block", "", body_kids, 2)
    let mut caller_anns: [Annotation] = []
    let item_c = _hitem_fn("mvb_caller", caller_anns, [], body)

    let mut items: [HItem] = []
    items.push(item_g)
    items.push(item_c)
    return HModule { file: "mvb.hexa", items: items }
}

fn _run_mvb(label: string, with_loan: bool, mut_loan: bool,
            want29_on: i64, want27_on: i64) -> bool {
    let strict = env("HEXA_BORROWCK_STRICT") == "1"
    let flag_on = env("HEXA_BORROWCK") == "1" || strict
    let mut want29 = 0
    let mut want27 = 0
    if flag_on { want29 = want29_on  want27 = want27_on }
    let mut ok = true
    println("")
    println("── " + label + " (hand-built HIR, expect HX3029 ×" + to_string(want29)
        + " · HX3027 ×" + to_string(want27) + ") ──")
    let mm = lower_hir(_build_mvb_module(with_loan, mut_loan))
    let d = hir_to_mir_diags()
    let n29 = _count_code(d, "HX3029")
    let n27 = _count_code(d, "HX3027")
    let other = len(d) - n29 - n27
    _print_diags(d)
    if n29 != want29 {
        println("  FAIL: HX3029 = " + to_string(n29) + ", want " + to_string(want29))
        ok = false
    }
    if n27 != want27 {
        println("  FAIL: HX3027 = " + to_string(n27) + ", want " + to_string(want27)
            + " (dedup: &mut loan → E0503 preempts, HX3029 collapses)")
        ok = false
    }
    if other != 0 {
        println("  FAIL: stray non-HX3029/HX3027 diagnostics = " + to_string(other))
        ok = false
    }
    if strict {
        let eb = _count_error_band(d)
        if eb != want29 + want27 {
            println("  FAIL: STRICT error-band = " + to_string(eb) + ", want "
                + to_string(want29 + want27))
            ok = false
        }
    }
    if len(mm.funcs) != 2 {
        println("  FAIL: expected 2 lowered fns, got " + to_string(len(mm.funcs)))
        ok = false
    }
    if ok { println("  ok: HX3029 ×" + to_string(want29) + " · HX3027 ×" + to_string(want27)) }
    return ok
}

// ── L5-E9 — move-out-of-borrowed-content (HX3034, Rust E0507) ──
//
// Hand-built HIR mirroring _build_mvb_module, but the @own call arg is a FIELD
// access `<ref_base>.f` instead of a bare ident:
//
//   fn g(@own p: [i64]) {}
//   fn mob_caller() {
//       let a = [1]
//       [ let r = &a / &mut a / a ]   line 3   (binding ∈ shared/mut/plain/none)
//       g(<ref_base>.f)              line 4   MOVE-OUT of a field
//   }
//
// binding: "shared" → `let r = &a` · "mut" → `let r = &mut a` · "plain" →
//          `let r = a` (non-ref handle-copy — NOT a loan) · "none" → no `r`.
// ref_base: the base ident of the field arg (`r` for the loan cases, `a` for the
//           owner-direct case).
//
// ① `&a` loan live, base=r  → HX3034 ×1 (shared).
// ② `&mut a` loan live, base=r → HX3034 ×1 (mutability-blind: `&mut` grants
//    mutation, not move-out) — HX3027 ×0 (E0507 is report-only, no move recorded,
//    so no E0503 preemption; the arg READ is of the ref binding `r`, not origin).
// ③ `let r = a` plain copy, base=r → 0 (`r` is not a ref binding — find_ref = -1).
// ④ owner-direct `g(a.f)`, base=a → 0 (`a` is the owner, not a ref binding).
// OFF sweep → fully empty stream; STRICT re-bands the fired code to Error.
fn _build_mob_module(binding: string, ref_base: string) -> HModule {
    // fn g — empty body, @own aggregate param p.
    let mut g_anns: [Annotation] = []
    g_anns.push(_ann1("own", "p"))
    g_anns.push(_ann1("param_names", "p"))
    let mut g_sigp: [Type] = []
    g_sigp.push(_t_arr_i64())
    let g_body = _hx("block", "", [], 1)
    let item_g = _hitem_fn("g", g_anns, g_sigp, g_body)

    // fn mob_caller — let a = [1]  ( [let r = &a / &mut a / a] )  g(<ref_base>.f)
    let mut arr_kids: [HExpr] = []
    arr_kids.push(_hx_int("1", 2))
    let mut let_a_kids: [HExpr] = []
    let_a_kids.push(_hx("array_lit", "", arr_kids, 2))
    let let_a = _hx("let", "a", let_a_kids, 2)

    let mut body_kids: [HExpr] = []
    body_kids.push(let_a)

    if binding == "shared" || binding == "mut" {
        let mut ref_inner: [HExpr] = []
        ref_inner.push(_hx("ident", "a", [], 3))
        let mut btext = "&"
        if binding == "mut" { btext = "&mut" }
        let mut ref_kids: [HExpr] = []
        ref_kids.push(_hx("unop", btext, ref_inner, 3))
        let let_r = _hx("let", "r", ref_kids, 3)
        body_kids.push(let_r)
    }
    if binding == "plain" {
        // `let r = a` — a non-ref aggregate handle-copy (census-only, never a
        // loan row), so find_ref("r") stays -1 and HX3034 must NOT fire.
        let mut copy_kids: [HExpr] = []
        copy_kids.push(_hx("ident", "a", [], 3))
        let let_r = _hx("let", "r", copy_kids, 3)
        body_kids.push(let_r)
    }

    // g(<ref_base>.f) — field access (kind="field", text="f", child[0]=base) as
    // the @own call arg.
    let mut fld_kids: [HExpr] = []
    fld_kids.push(_hx("ident", ref_base, [], 4))
    let fld = _hx("field", "f", fld_kids, 4)
    let mut call_kids: [HExpr] = []
    call_kids.push(_hx("ident", "g", [], 4))
    call_kids.push(fld)
    let call_g = _hx("call", "", call_kids, 4)
    body_kids.push(call_g)

    let body = _hx("block", "", body_kids, 2)
    let mut caller_anns: [Annotation] = []
    let item_c = _hitem_fn("mob_caller", caller_anns, [], body)

    let mut items: [HItem] = []
    items.push(item_g)
    items.push(item_c)
    return HModule { file: "mob.hexa", items: items }
}

fn _run_mob(label: string, binding: string, ref_base: string,
            want34_on: i64) -> bool {
    let strict = env("HEXA_BORROWCK_STRICT") == "1"
    let flag_on = env("HEXA_BORROWCK") == "1" || strict
    let mut want34 = 0
    if flag_on { want34 = want34_on }
    let mut ok = true
    println("")
    println("── " + label + " (hand-built HIR, expect HX3034 ×" + to_string(want34)
        + " · HX3027 ×0) ──")
    let mm = lower_hir(_build_mob_module(binding, ref_base))
    let d = hir_to_mir_diags()
    let n34 = _count_code(d, "HX3034")
    let n27 = _count_code(d, "HX3027")
    let other = len(d) - n34 - n27
    _print_diags(d)
    if n34 != want34 {
        println("  FAIL: HX3034 = " + to_string(n34) + ", want " + to_string(want34))
        ok = false
    }
    if n27 != 0 {
        println("  FAIL: HX3027 = " + to_string(n27)
            + ", want 0 (E0507 is report-only — no move recorded, no E0503 preemption)")
        ok = false
    }
    if other != 0 {
        println("  FAIL: stray non-HX3034/HX3027 diagnostics = " + to_string(other))
        ok = false
    }
    if strict {
        let eb = _count_error_band(d)
        if eb != want34 {
            println("  FAIL: STRICT error-band = " + to_string(eb) + ", want "
                + to_string(want34))
            ok = false
        }
    }
    if len(mm.funcs) != 2 {
        println("  FAIL: expected 2 lowered fns, got " + to_string(len(mm.funcs)))
        ok = false
    }
    if ok { println("  ok: HX3034 ×" + to_string(want34) + " · HX3027 ×0") }
    return ok
}

// ── L4 A2 — WOULD-MOVE CENSUS (HEXA_BORROWCK_CENSUS=1) ────────
//
// Census is a SEPARATE observe-only lane (no HX3014, no _lr_diag): under
// HEXA_BORROWCK_CENSUS=1 the loan pass runs (census implies `_bck_on`) and
// pushes one `[borrowck-census]` marker per recorded `let b = a` aggregate
// handle-copy — the exact move-by-default (A3) migration worklist. The
// markers also stream to stderr for the pool grep; here we count them via
// the in-process `bck_census_lines()` accessor.
//
// The probe below has THREE handle-copy edges over one tracked root:
//   let a = [1, 2]   root (tracked at the composite-literal birth)
//   let b = a        copy #1  (b joins group(a))
//   let c = b        copy #2  (b is tracked via #1)
//   let d = a        copy #3
// → 3 census markers ON, 0 OFF (byteeq-neutral: the lane is untouched
//   unless HEXA_BORROWCK_CENSUS=1).

fn _src_census_copies() -> string {
    let mut s = "fn cen() {\n"
    s = s + "    let a = [1, 2]\n"
    s = s + "    let b = a\n"
    s = s + "    let c = b\n"
    s = s + "    let d = a\n"
    s = s + "    println(a[0] + b[0] + c[0] + d[0])\n"
    s = s + "}\n"
    return s
}

fn _run_census() -> bool {
    let census_on = env("HEXA_BORROWCK_CENSUS") == "1"
    let mut want = 0
    if census_on { want = 3 }
    let mut ok = true
    println("")
    println("── census_copies (expect [borrowck-census] ×" + to_string(want) + ") ──")
    let toks = lex(_src_census_copies(), "census.hexa")
    let m = parse(toks, "census.hexa")
    let hm = lower(m, empty_atlas_index())
    let mm = lower_hir(hm)
    if len(mm.funcs) == 0 { println("  WARN: census probe lowered 0 fns") }
    let lines = bck_census_lines()
    let mut i = 0
    while i < len(lines) {
        println("      " + lines[i])
        i = i + 1
    }
    let n = len(lines)
    if n != want {
        println("  FAIL: census markers = " + to_string(n) + ", want " + to_string(want))
        ok = false
    }
    if ok { println("  ok: ×" + to_string(want)) }
    return ok
}

// ── HEXA-OWN L5-E8 — mutating-method-behind-shared-ref (HX3032, E0596) ─
//
// A receiver-mutating method (`push`/`pop`/`truncate`/`set`) dispatched
// THROUGH a binding that is itself a live shared (`&`) borrow. A `&mut`
// receiver is legal (that is what mutating methods require), a call on the
// OWNER directly is legal, and a non-mutating selector (`len`) never reaches
// the scan.
//   * hz `let r = &arr; r.push(1)`     → HX3032 ×1 (mutate through `&`)
//   * fp `let r = &mut arr; r.push(1)` → 0 (mutable borrow is legal)
//   * fp `arr.push(1)` (owner)         → 0 (no ref binding)
//   * fp `let r = &arr; r.len()`       → 0 (non-mutating selector)
// ON → ×1 per hazard; OFF → empty stream (byteeq-neutral). STRICT re-bands
// every emitted HX3032 to the Error band.

fn _src_hz_mut_method_behind_ref() -> string {
    let mut s = "fn hz8() {\n"
    s = s + "    let arr = [1]\n"
    s = s + "    let r = &arr\n"
    s = s + "    r.push(1)\n"
    s = s + "}\n"
    return s
}

fn _src_fp_mut_method_mutref() -> string {
    let mut s = "fn fp8m() {\n"
    s = s + "    let mut arr = [1]\n"
    s = s + "    let r = &mut arr\n"
    s = s + "    r.push(1)\n"
    s = s + "}\n"
    return s
}

fn _src_fp_mut_method_owner() -> string {
    let mut s = "fn fp8o() {\n"
    s = s + "    let mut arr = [1]\n"
    s = s + "    arr.push(1)\n"
    s = s + "}\n"
    return s
}

fn _src_fp_nonmut_method_ref() -> string {
    let mut s = "fn fp8n() {\n"
    s = s + "    let arr = [1]\n"
    s = s + "    let r = &arr\n"
    s = s + "    let n = r.len()\n"
    s = s + "    println(n)\n"
    s = s + "}\n"
    return s
}

// Mirrors `_run_probe` but keys on HX3032 (the E8 rung code). Zero stray
// codes required (probe hygiene); STRICT asserts every HX3032 is Error-band.
fn _run_mut_method_probe(label: string, src: string, want_on: i64) -> bool {
    let strict = env("HEXA_BORROWCK_STRICT") == "1"
    let flag_on = env("HEXA_BORROWCK") == "1" || strict
    let mut want = 0
    if flag_on { want = want_on }
    let mut ok = true
    println("")
    println("── " + label + " (expect HX3032 ×" + to_string(want) + ") ──")
    let d = _compile_probe(label, src)
    let n = _count_code(d, "HX3032")
    let other = len(d) - n
    _print_diags(d)
    if n != want {
        println("  FAIL: HX3032 = " + to_string(n) + ", want " + to_string(want))
        ok = false
    }
    if other != 0 {
        println("  FAIL: stray non-HX3032 diagnostics = " + to_string(other))
        ok = false
    }
    if strict {
        let eb = _count_error_band(d)
        if eb != want {
            println("  FAIL: STRICT error-band = " + to_string(eb) + ", want " + to_string(want))
            ok = false
        }
    }
    if ok { println("  ok: ×" + to_string(want)) }
    return ok
}

// ── HEXA-OWN round8-1 — HX3035 use-of-possibly-uninitialized (Rust E0381) ──
// Self-contained balanced source probes (NEVER line-unioned). Each returns a
// full program string; the runner keys on HX3035 and asserts probe hygiene
// (zero stray codes). OFF → all 0 (byteeq-neutral proof); STRICT → Error-band.

// HAZARD — read of an uninit `let` before any assignment fires.
fn _src_hz_use_before_init() -> string {
    let mut s = "fn hzu() {\n"
    s = s + "    let x: i64\n"
    s = s + "    let y = x + 1\n"
    s = s + "    println(y)\n"
    s = s + "}\n"
    return s
}

// HAZARD — use precedes the init WITHIN the same block (order-precise).
fn _src_hz_use_then_init() -> string {
    let mut s = "fn hzt() {\n"
    s = s + "    let mut x: i64\n"
    s = s + "    let y = x\n"
    s = s + "    x = 1\n"
    s = s + "    println(y + x)\n"
    s = s + "}\n"
    return s
}

// HAZARD — a loop body reads x on its FIRST iteration before the in-body
// assignment (the back-edge kills, but the entry pred keeps IN=1).
fn _src_hz_loop_first_iter() -> string {
    let mut s = "fn hzl(c: bool) {\n"
    s = s + "    let mut x: i64\n"
    s = s + "    while c {\n"
    s = s + "        let y = x\n"
    s = s + "        x = 1\n"
    s = s + "        println(y)\n"
    s = s + "    }\n"
    s = s + "}\n"
    return s
}

// CONTROL — init precedes use in the same block → clean.
fn _src_fp_init_then_use() -> string {
    let mut s = "fn fpit() {\n"
    s = s + "    let mut x: i64\n"
    s = s + "    x = 1\n"
    s = s + "    let y = x\n"
    s = s + "    println(y)\n"
    s = s + "}\n"
    return s
}

// CONTROL — BOTH if/else branches init → OR-join is 0 (must-init AND dual).
fn _src_fp_init_both_branches() -> string {
    let mut s = "fn fpib(c: bool) {\n"
    s = s + "    let mut x: i64\n"
    s = s + "    if c {\n"
    s = s + "        x = 1\n"
    s = s + "    } else {\n"
    s = s + "        x = 2\n"
    s = s + "    }\n"
    s = s + "    let y = x\n"
    s = s + "    println(y)\n"
    s = s + "}\n"
    return s
}

// CONTROL — a return-terminated branch has NO join edge, so the merge's only
// pred is the else branch that inits x → clean.
fn _src_fp_return_branch() -> string {
    let mut s = "fn fprb(c: bool) -> i64 {\n"
    s = s + "    let mut x: i64\n"
    s = s + "    if c {\n"
    s = s + "        return 0\n"
    s = s + "    } else {\n"
    s = s + "        x = 1\n"
    s = s + "    }\n"
    s = s + "    return x\n"
    s = s + "}\n"
    return s
}

// CONTROL — a partial place-write `s.f = 1` marks the whole place initialized
// (partial-init tolerance) → a later read of the field is silent.
fn _src_fp_field_partial() -> string {
    let mut s = "struct P { f: i64 }\n"
    s = s + "fn fpfp() {\n"
    s = s + "    let s: P\n"
    s = s + "    s.f = 1\n"
    s = s + "    let y = s.f\n"
    s = s + "    println(y)\n"
    s = s + "}\n"
    return s
}

// CONTROL — an ordinary initialized `let` is never tracked.
fn _src_fp_normal_let() -> string {
    let mut s = "fn fpnl() {\n"
    s = s + "    let x = 1\n"
    s = s + "    let y = x\n"
    s = s + "    println(y)\n"
    s = s + "}\n"
    return s
}

// HX3035 probe runner — mirrors `_run_use_while_mut_probe`, keyed on the
// uninit-use code and asserting every OTHER code is 0 (probe hygiene). STRICT
// re-bands HX3035 to Error, so the error-band count must equal the HX3035
// count. OFF → want 0 (empty stream).
fn _run_uninit_probe(label: string, src: string, want_on: i64) -> bool {
    let strict = env("HEXA_BORROWCK_STRICT") == "1"
    let flag_on = env("HEXA_BORROWCK") == "1" || strict
    let mut want = 0
    if flag_on { want = want_on }
    let mut ok = true
    println("")
    println("── " + label + " (expect HX3035 ×" + to_string(want) + ") ──")
    let d = _compile_probe(label, src)
    let n = _count_code(d, "HX3035")
    let other = len(d) - n
    _print_diags(d)
    if n != want {
        println("  FAIL: HX3035 = " + to_string(n) + ", want " + to_string(want))
        ok = false
    }
    if other != 0 {
        println("  FAIL: stray non-HX3035 diagnostics = " + to_string(other))
        ok = false
    }
    if strict {
        let eb = _count_error_band(d)
        if eb != want {
            println("  FAIL: STRICT error-band = " + to_string(eb) + ", want " + to_string(want))
            ok = false
        }
    }
    if ok { println("  ok: ×" + to_string(want)) }
    return ok
}

// ── HEXA-OWN round8-2 — HX3036 borrowed-value-does-not-live-long-enough
// (Rust E0597) source probes. The ONLY firing form is the assign-arm
// re-borrow across a scope: `let mut r = &y; { let x = 5; r = &x } use r`
// (r outlives x's scope). let-arm loans are structurally safe. ──

// HAZARD — an assign-arm re-borrow of a value whose scope dies while the
// binding lives, then used after the scope. bare `{ }` does not split MIR
// blocks, so the dangle (scope-exit) precedes the use by program-order seq.
fn _src_hz_dangle_asn_reborrow() -> string {
    let mut s = "fn hzd() {\n"
    s = s + "    let y = 10\n"
    s = s + "    let mut r = &y\n"
    s = s + "    {\n"
    s = s + "        let x = 5\n"
    s = s + "        r = &x\n"
    s = s + "    }\n"
    s = s + "    println(r)\n"
    s = s + "}\n"
    return s
}

// CONTROL — a same-scope let-arm loan: r's scope ⊆ x's scope, so the borrow
// can never outlive the value (no asn-lane row is ever recorded).
fn _src_fp_same_scope() -> string {
    let mut s = "fn fpss() {\n"
    s = s + "    let x = 5\n"
    s = s + "    let r = &x\n"
    s = s + "    println(r)\n"
    s = s + "}\n"
    return s
}

// CONTROL — the reassign-then-use FP killer: after the scope dies, r is
// repointed to a live outer value BEFORE the use, so the use snapshots the
// non-dangling row (row != dangle row → silent).
fn _src_fp_reassign_before_use() -> string {
    let mut s = "fn fprb2() {\n"
    s = s + "    let y = 1\n"
    s = s + "    let w = 2\n"
    s = s + "    let mut r = &y\n"
    s = s + "    {\n"
    s = s + "        let x = 5\n"
    s = s + "        r = &x\n"
    s = s + "    }\n"
    s = s + "    r = &w\n"
    s = s + "    println(r)\n"
    s = s + "}\n"
    return s
}

// HX3036 probe runner — mirrors `_run_uninit_probe`, keyed on the ref-outlives
// code and asserting every OTHER code is 0 (probe hygiene). STRICT re-bands
// HX3036 to Error, so the error-band count must equal the HX3036 count. OFF →
// want 0 (empty stream). Note: the hz probe's `let mut r = &y` makes a let-lane
// loan of y, but y never reappears as an origin, so E3/E4/E0503 stay silent.
fn _run_outlives_probe(label: string, src: string, want_on: i64) -> bool {
    let strict = env("HEXA_BORROWCK_STRICT") == "1"
    let flag_on = env("HEXA_BORROWCK") == "1" || strict
    let mut want = 0
    if flag_on { want = want_on }
    let mut ok = true
    println("")
    println("── " + label + " (expect HX3036 ×" + to_string(want) + ") ──")
    let d = _compile_probe(label, src)
    let n = _count_code(d, "HX3036")
    let other = len(d) - n
    _print_diags(d)
    if n != want {
        println("  FAIL: HX3036 = " + to_string(n) + ", want " + to_string(want))
        ok = false
    }
    if other != 0 {
        println("  FAIL: stray non-HX3036 diagnostics = " + to_string(other))
        ok = false
    }
    if strict {
        let eb = _count_error_band(d)
        if eb != want {
            println("  FAIL: STRICT error-band = " + to_string(eb) + ", want " + to_string(want))
            ok = false
        }
    }
    if ok { println("  ok: ×" + to_string(want)) }
    return ok
}

// ── HEXA-OWN round8-3 — HX3037 closure capture-move (Rust E0507
// "cannot move out of `X`, a captured variable in an `FnMut` closure").
// The ONLY firing form is a bare-ident @own call-arg inside a closure body
// that is a CAPTURE of the enclosing scope. Source-level probes are viable:
// the inline `@own p: T` parser carrier is live on main (parser.hexa
// p_param_own_anns → ast_to_hir param_names → hir_to_mir @own pre-pass), so
// no hand-built HIR is needed (unlike the older tp_own_param_move). ──

// HAZARD — a captured `xs` moved into `sink`'s @own param inside the closure
// body. The closure may be called more than once (f(1); f(2)), and the env
// slot aliases xs's heap object, so the move is UAF-unsafe → HX3037 ×1.
fn _src_hz_clo_capture_move() -> string {
    let mut s = "fn sink(@own v: [i64]) {\n"
    s = s + "    println(len(v))\n"
    s = s + "}\n"
    s = s + "fn hzcm() {\n"
    s = s + "    let xs = [1, 2, 3]\n"
    s = s + "    let f = fn(n: i64) {\n"
    s = s + "        sink(xs)\n"
    s = s + "    }\n"
    s = s + "    f(1)\n"
    s = s + "    f(2)\n"
    s = s + "}\n"
    return s
}

// HAZARD — a nested closure inside an outer closure moves the ENCLOSING-fn
// capture `xs` into sink's @own param. Proves the read-only walk descends
// into inner closures for outer-fn captures → HX3037 ×1 (only the outer
// closure's scan runs; the inner closure lowers with `_bck_active` false).
fn _src_hz_clo_nested_capture_move() -> string {
    let mut s = "fn sink(@own v: [i64]) {\n"
    s = s + "    println(len(v))\n"
    s = s + "}\n"
    s = s + "fn hznest() {\n"
    s = s + "    let xs = [1, 2, 3]\n"
    s = s + "    let outer = fn(a: i64) {\n"
    s = s + "        let inner = fn(b: i64) {\n"
    s = s + "            sink(xs)\n"
    s = s + "        }\n"
    s = s + "        inner(a)\n"
    s = s + "    }\n"
    s = s + "    outer(1)\n"
    s = s + "}\n"
    return s
}

// CONTROL — same capture-and-pass shape, but sink's param is NOT @own, so
// the arg is a READ (no move source) → 0.
fn _src_fp_clo_param_not_own() -> string {
    let mut s = "fn sink(v: [i64]) {\n"
    s = s + "    println(len(v))\n"
    s = s + "}\n"
    s = s + "fn fpno() {\n"
    s = s + "    let xs = [1, 2, 3]\n"
    s = s + "    let f = fn(n: i64) {\n"
    s = s + "        sink(xs)\n"
    s = s + "    }\n"
    s = s + "    f(1)\n"
    s = s + "}\n"
    return s
}

// CONTROL — the moved arg is the closure's OWN param `v`, not a capture, so
// it is not in the free set → 0 (moving a closure-local into @own is fine).
fn _src_fp_clo_own_arg_is_param() -> string {
    let mut s = "fn sink(@own v: [i64]) {\n"
    s = s + "    println(len(v))\n"
    s = s + "}\n"
    s = s + "fn fpparam() {\n"
