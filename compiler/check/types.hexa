// HEXA Native Compiler — Phase B3 / S3+S4: type & domain check
//
// @version 0.1.0
// @capabilities [pure]
//
// Walks a parsed Module and:
//   S3: infers expression types, validates assignments / calls / binops /
//       returns / match arms. Multi-error per RFC-019 §6 — every site is
//       reported.
//   S4: light domain check — emits HX4001 (Warning) when integer / integer
//       division narrows the ℝ domain. Real / Natural / Complex propagation
//       is stubbed at the literal layer (LiteralInt → "integer", LiteralFloat
//       → "real") so units (S5) and prover (S7) can refine later.
//
// Per RFC-017 §3.1 S3 is fatal — type mismatches abort compilation. HX4001
// is Warning only (domain hint), so it doesn't gate codegen on its own.
//
// Stage0 caveats:
//   - HIR.Type is the typed shape (compiler/ir/hir.hexa). We synthesise it
//     here without lowering the AST — that lives in a future Phase B4.
//   - Field access / struct literal validation is a v1 stub (records the
//     receiver type but doesn't look up declared field types yet).
//   - If compiler/check/bind.hexa is absent at this code-base SHA, the
//     `_resolve_ident_to_type` fallback covers the sole identifier case
//     used by the test (function call lookup) by scanning module items.

import "../parse/ast.hexa"
import "../diag/catalog.hexa"
import "../diag/builder.hexa"
import "../ir/hir.hexa"
import "../lex/tokens.hexa"

// ── TypeEnv ──────────────────────────────────────────────────
// Flat module-level binding table. Each item (fn / struct / enum / let)
// maps a DefId-shaped key to a Type, where the Type kind encodes the role:
//   fn      → Type{kind="fn", args=[param types], ret=[return type]}
//   struct  → Type{kind="struct", def, args=[field types]}
//   enum    → Type{kind="enum",   def}
//   let     → declared type (or Type{kind=""} when unannotated)

pub struct TypeBinding {
    def: DefId,
    name: string,        // mirror of name for did-you-mean / lookup convenience
    typ: Type,
    is_pub: bool,        // Stage1 punch list Gap 2 — pub items live in the
                         //   global namespace; non-pub items are file-private.
    module_file: string  // owning module file path (for private visibility)
}

// Stage1 punch list A3 — hash-keyed name index.
//
// `buckets` is a parallel array of length `_TYPES_NUM_BUCKETS`; each bucket
// holds the indices into `entries` for bindings whose `name` hashes to that
// bucket. Lookup keyed on `name` becomes O(entries / NUM_BUCKETS) average
// instead of O(entries), which on the spliced super-module collapses ~9 M
// string compares per type-check into ~140 K. First-occurrence ordering
// inside each bucket is preserved (push-order), which the lookup logic
// (pub-first / private-in-caller-file / private-other-module) relies on
// for first-wins HX3010 / HX2002 attribution.
//
// Stage 0 hexa lacks a real hashmap, so we ship the index inline: 64
// buckets, sum-of-char-codes hash. The constant lives as a fn (stage 0
// `let` hoisting under splice is fragile per stage1 punch list C1).
fn _types_num_buckets() -> i64 { return 64 }

fn _types_hash_name(name: string) -> i64 {
    // FNV-1a-ish but simplified — sum of char codes mod NUM_BUCKETS.
    // Quality matters less than uniformity for the typical compiler
    // identifier set; collisions just lengthen a bucket.
    let mut h = 0
    let n = len(name)
    let mut i = 0
    while i < n {
        let c = name.char_code_at(i)
        h = h * 31 + c
        // Wrap to keep stage0 i64 arithmetic in range.
        h = h % 1073741824
        i = i + 1
    }
    if h < 0 { h = -h }
    return h % _types_num_buckets()
}

fn _types_empty_buckets() -> [[i64]] {
    let mut bs: [[i64]] = []
    let n = _types_num_buckets()
    let mut i = 0
    while i < n {
        let empty: [i64] = []
        bs.push(empty)
        i = i + 1
    }
    return bs
}

pub struct TypeEnv {
    entries: [TypeBinding],
    // Hash index: buckets[h] → list of indices into `entries` whose
    // binding.name hashes to `h`. Always length _types_num_buckets()
    // post-construction; treat as opaque outside the lookup helpers.
    buckets: [[i64]]
}

fn _types_empty_env() -> TypeEnv {
    return TypeEnv { entries: [], buckets: _types_empty_buckets() }
}

// Rebuild the bucket index from the current `entries`. Used as a safety
// net when test harnesses or legacy callers construct a TypeEnv directly
// with `TypeEnv { entries: [...] }` and never primed the buckets — the
// first lookup detects the empty-buckets-but-non-empty-entries shape and
// rebuilds. Constant in env-size, called at most once per such env.
fn _types_rebuild_buckets(env: TypeEnv) -> TypeEnv {
    let mut bs = _types_empty_buckets()
    let mut i = 0
    while i < len(env.entries) {
        let h = _types_hash_name(env.entries[i].name)
        bs[h] = bs[h].push(i)
        i = i + 1
    }
    return TypeEnv { entries: env.entries, buckets: bs }
}

// Returns the bucket of entry-indices for a given name. When the env was
// hand-built without buckets (legacy / test path), transparently rebuilds
// once on first access via the caller.
fn _types_bucket_for(env: TypeEnv, name: string) -> [i64] {
    if len(env.buckets) == 0 {
        // Caller should rebuild via _types_rebuild_buckets for stable
        // subsequent calls; here we degrade to a synthetic full-scan
        // bucket so behavior remains correct even if rebuild is skipped.
        let mut all: [i64] = []
        let mut i = 0
        while i < len(env.entries) {
            all.push(i)
            i = i + 1
        }
        return all
    }
    let h = _types_hash_name(name)
    return env.buckets[h]
}

// ── Helpers ──────────────────────────────────────────────────

fn _types_empty_fixit() -> FixIt {
    return FixIt {
        kind: FixItKind::None,
        span: Span { file: "", line: 0, col: 0, len: 0 },
        new_text: ""
    }
}

fn _types_miss_def_id() -> DefId {
    return DefId { module: "", index: -1 }
}

fn _types_empty_type() -> Type {
    return Type {
        kind: "",
        def: _types_miss_def_id(),
        args: [],
        ret: [],
        domain: "",
        unit: ""
    }
}

fn _prim(kind: string, domain: string) -> Type {
    return Type {
        kind: kind,
        def: _types_miss_def_id(),
        args: [],
        ret: [],
        domain: domain,
        unit: ""
    }
}

fn _types_t_i8()     -> Type { return _prim("i8",     "integer") }
fn _types_t_i16()    -> Type { return _prim("i16",    "integer") }
fn _types_t_i32()    -> Type { return _prim("i32",    "integer") }
fn _types_t_i64()    -> Type { return _prim("i64",    "integer") }
// RFC 068 P2 — Mixed-precision MIR layer. Adds f16/bf16 primitives so
// source-level `let t: f16 = a + b` parses and the HIR carries an f16
// Type through to the binop case in `compiler/lower/hir_to_mir.hexa`,
// which then sets the dst Local's precision tag. Codegen-side bank
// routing landed in PR #148 (RFC 068 P1); body-instruction emit is
// deferred to P3. See `docs/rfc/rfc_drafts_2026_05_20/rfc_068_mixed_precision_mir_layer.md` §3 P2.
fn _types_t_f16()    -> Type { return _prim("f16",    "real") }
fn _types_t_bf16()   -> Type { return _prim("bf16",   "real") }
fn _types_t_f32()    -> Type { return _prim("f32",    "real") }
fn _types_t_f64()    -> Type { return _prim("f64",    "real") }
fn _types_t_bool()   -> Type { return _prim("bool",   "") }
fn _types_t_string() -> Type { return _prim("string", "") }
fn _types_t_char()   -> Type { return _prim("char",   "") }
fn _types_t_unit()   -> Type { return _prim("unit",   "") }

// Render a Type for diagnostic messages. Stage0 has no Display impl, so we
// hand-roll a minimal pretty-printer that resolves the most common cases.
fn _type_display(t: Type) -> string {
    if len(t.kind) == 0 { return "<unknown>" }
    if t.kind == "fn" {
        let mut s = "fn("
        let mut i = 0
        while i < len(t.args) {
            if i > 0 { s = s + ", " }
            s = s + _type_display(t.args[i])
            i = i + 1
        }
        s = s + ")"
        if len(t.ret) > 0 {
            s = s + " -> " + _type_display(t.ret[0])
        }
        return s
    }
    if t.kind == "struct" || t.kind == "enum" {
        if len(t.def.module) > 0 || t.def.index >= 0 {
            // We don't record the bare name on Type, so fall back to kind.
            return t.kind
        }
        return t.kind
    }
    // static-types r7-prep — structured array display. kind:"array" is only
    // producible under HEXA_STATIC_TYPES_ARRAY_LOWER=1 (see _types_equal),
    // so this branch is dead on the default build. Rendering the element
    // (`[i64]`) keeps the HX2005 registry's compare-on-display contract
    // discriminating flag-ON: `_types_typeref_display` and the inferred-Type
    // side both route through here, so `[i64]` vs `[f64]` payload slots stay
    // distinct strings (a bare "array" would collapse them).
    if t.kind == "array" {
        if len(t.args) >= 1 { return "[" + _type_display(t.args[0]) + "]" }
        return t.kind
    }
    return t.kind
}

