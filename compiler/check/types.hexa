        ExprKind::Closure -> false
    }
}

fn _types_is_assign(k: ExprKind) -> bool {
    return match k {
        ExprKind::Assign -> true,
        ExprKind::LiteralInt -> false,
        ExprKind::LiteralFloat -> false,
        ExprKind::LiteralString -> false,
        ExprKind::LiteralBool -> false,
        ExprKind::LiteralChar -> false,
        ExprKind::Ident -> false,
        ExprKind::AtlasRef -> false,
        ExprKind::Call -> false,
        ExprKind::BinOp -> false,
        ExprKind::UnOp -> false,
        ExprKind::Block -> false,
        ExprKind::If -> false,
        ExprKind::While -> false,
        ExprKind::For -> false,
        ExprKind::Match -> false,
        ExprKind::Return -> false,
        ExprKind::Break -> false,
        ExprKind::Continue -> false,
        ExprKind::Let -> false,
        ExprKind::Field -> false,
        ExprKind::Index -> false,
        ExprKind::ArrayLit -> false,
        ExprKind::StructLit -> false,
        ExprKind::EnumPath -> false,
        ExprKind::Wildcard -> false,
        ExprKind::Try -> false,
        ExprKind::Throw -> false,
        ExprKind::Closure -> false
    }
}

fn _is_match_expr(k: ExprKind) -> bool {
    return match k {
        ExprKind::Match -> true,
        ExprKind::LiteralInt -> false,
        ExprKind::LiteralFloat -> false,
        ExprKind::LiteralString -> false,
        ExprKind::LiteralBool -> false,
        ExprKind::LiteralChar -> false,
        ExprKind::Ident -> false,
        ExprKind::AtlasRef -> false,
        ExprKind::Call -> false,
        ExprKind::BinOp -> false,
        ExprKind::UnOp -> false,
        ExprKind::Block -> false,
        ExprKind::If -> false,
        ExprKind::While -> false,
        ExprKind::For -> false,
        ExprKind::Return -> false,
        ExprKind::Break -> false,
        ExprKind::Continue -> false,
        ExprKind::Let -> false,
        ExprKind::Assign -> false,
        ExprKind::Field -> false,
        ExprKind::Index -> false,
        ExprKind::ArrayLit -> false,
        ExprKind::StructLit -> false,
        ExprKind::EnumPath -> false,
        ExprKind::Wildcard -> false,
        ExprKind::Try -> false,
        ExprKind::Throw -> false,
        ExprKind::Closure -> false
    }
}

// RFC C1 — closure-expression probe.
fn _types_is_closure(k: ExprKind) -> bool {
    return match k {
        ExprKind::Closure -> true,
        ExprKind::LiteralInt -> false,
        ExprKind::LiteralFloat -> false,
        ExprKind::LiteralString -> false,
        ExprKind::LiteralBool -> false,
        ExprKind::LiteralChar -> false,
        ExprKind::Ident -> false,
        ExprKind::AtlasRef -> false,
        ExprKind::Call -> false,
        ExprKind::BinOp -> false,
        ExprKind::UnOp -> false,
        ExprKind::Block -> false,
        ExprKind::If -> false,
        ExprKind::While -> false,
        ExprKind::For -> false,
        ExprKind::Match -> false,
        ExprKind::Return -> false,
        ExprKind::Break -> false,
        ExprKind::Continue -> false,
        ExprKind::Let -> false,
        ExprKind::Assign -> false,
        ExprKind::Field -> false,
        ExprKind::Index -> false,
        ExprKind::ArrayLit -> false,
        ExprKind::StructLit -> false,
        ExprKind::EnumPath -> false,
        ExprKind::Wildcard -> false,
        ExprKind::Try -> false,
        ExprKind::Throw -> false
    }
}

// ── ItemKind probes ──────────────────────────────────────────

fn _types_is_fn_item(k: ItemKind) -> bool {
    return match k {
        ItemKind::Fn -> true,
        ItemKind::Let -> false,
        ItemKind::Struct -> false,
        ItemKind::Enum -> false,
        ItemKind::Import -> false
    }
}

fn _types_is_struct_item(k: ItemKind) -> bool {
    return match k {
        ItemKind::Struct -> true,
        ItemKind::Fn -> false,
        ItemKind::Let -> false,
        ItemKind::Enum -> false,
        ItemKind::Import -> false
    }
}

fn _types_is_enum_item(k: ItemKind) -> bool {
    return match k {
        ItemKind::Enum -> true,
        ItemKind::Fn -> false,
        ItemKind::Let -> false,
        ItemKind::Struct -> false,
        ItemKind::Import -> false
    }
}

fn _types_is_let_item(k: ItemKind) -> bool {
    return match k {
        ItemKind::Let -> true,
        ItemKind::Fn -> false,
        ItemKind::Struct -> false,
        ItemKind::Enum -> false,
        ItemKind::Import -> false
    }
}

// ── TypeRef → Type lowering (small) ─────────────────────────
// AST TypeRef is untyped; map common primitive names + user-defined
// nominal types onto a Type. Unrecognised names become a "named"
// Type carrying just the name through `kind` so the diagnostic
// pretty-printer can still show something.

fn _types_lower_type_ref(tr: TypeRef) -> Type {
    if len(tr.kind) == 0 { return _types_empty_type() }
    if tr.kind == "named" {
        // Type-alias substitution (`type Celsius = f64`): resolve the spelling
        // to its underlying named type BEFORE the primitive table so `Celsius`
        // is interchangeable with `f64` for every typecheck site. No-op (same
        // string) when `tr.name` is not a registered alias → byte-identical
        // for alias-free programs.
        let n = _types_resolve_alias_name(tr.name)
        // Gap 3 (stage1 punch list): kind="named" with empty `name` is a stale
        // TypeRef shape — degrade to the unknown sentinel so the let-RHS /
        // return checker tolerates instead of falsely mapping to `unit`.
        // Without this, an unannotated let RHS spuriously raised HX3001
        // "expected unit, got <rhs>".
        if len(n) == 0 { return _types_empty_type() }
        if n == "i8"  { return _types_t_i8() }
        if n == "i16" { return _types_t_i16() }
        if n == "i32" { return _types_t_i32() }
        if n == "i64" || n == "Int" || n == "int" { return _types_t_i64() }
        // RFC 068 P2 — f16/bf16 named types. `let t: f16 = ...` parses.
        if n == "f16" { return _types_t_f16() }
        if n == "bf16" { return _types_t_bf16() }
        if n == "f32" { return _types_t_f32() }
        if n == "f64" || n == "Float" || n == "float" || n == "Real" { return _types_t_f64() }
        if n == "bool" || n == "Bool" { return _types_t_bool() }
        if n == "string" || n == "String" || n == "str" { return _types_t_string() }
        if n == "char" || n == "Char" { return _types_t_char() }
        if n == "unit" || n == "Unit" || n == "()" || n == "void" || n == "Void" { return _types_t_unit() }
        // u8/u16/u32/u64 — deferred: stage0 backend has no unsigned
        // representation. Fall through to the `named:<n>` sentinel so
        // downstream layers see the user's spelling without a silent
        // i64 alias (which would mis-typecheck signed/unsigned mixes).
        return Type {
            kind: "named:" + n,
            def: _types_miss_def_id(),
            args: [],
            ret: [],
            domain: "",
            unit: ""
        }
    }
    // static-types r7-prep — OPT-IN structured array lowering
    // (HEXA_STATIC_TYPES_ARRAY_LOWER=1). Mirrors the HIR-side element-type-
    // preserving branch (compiler/lower/ast_to_hir.hexa:_hir_lower_type_ref,
    // runtime-gap r2-pre): the parser encodes `[T]`/`[T; N]` as
    //   TypeRef{kind:"generic", name:"Array" | "Array:<N>" | "Array:<elem>:<N>",
    //           args:[<element TypeRef>]}
    // and the degrade fallback below collapses that to the string sentinel
    // Type{kind:"generic:Array…", args:[]} — DROPPING the element Type. This
    // branch lowers it to kind:"array" and RECURSES on the element TypeRef so
    // args[0] is a real structured Type. WHY opt-in and not unconditional:
    // `_types_equal` is textual on `kind`, so the flag-OFF sentinel spelling
    // carries the size suffix (`generic:Array:i32:4` ≠ `generic:Array:i32:8`)
    // — an unconditional "array" kind would silently ERASE that distinction
    // (size-erased structural typing, the HIR-side contract) and flip
    // existing HX3003/HX3004/HX2005 verdicts + diagnostic display strings.
    // Flag first (short-circuit) → the default build takes the identical
    // sentinel path, byte-neutral (same idiom as the r1-r6 env gates). The
    // r4 element-fit path is untouched in BOTH modes: it lowers the
    // annotation as kind:"named" (`_types_let_type_text` string) and parses
    // the element out of the raw text via `_types_array_elem_kind`, so this
    // kind:"generic"-gated branch never fires there.
    if _types_array_lower_on && tr.kind == "generic" && _types_is_array_name(tr.name) && len(tr.args) >= 1 {
        let mut elem_args: [Type] = []
        elem_args.push(_types_lower_type_ref(tr.args[0]))
        return Type {
            kind: "array",
            def: _types_miss_def_id(),
            args: elem_args,
            ret: [],
            domain: "",
            unit: ""
        }
    }
    // generic / fn / tuple / atlas_kind — degrade gracefully
    return Type {
        kind: tr.kind + ":" + tr.name,
        def: _types_miss_def_id(),
        args: [],
        ret: [],
        domain: "",
        unit: ""
    }
}

// True when a generic TypeRef `name` denotes an array — bare "Array" or the
// sized/typed encodings "Array:<N>" / "Array:<elem>:<N>" (parser RFC 085).
// Module-local mirror of ast_to_hir.hexa:_hir_is_array_name (no cross-module
// import; same precedent as `_types_let_type_text`).
fn _types_is_array_name(n: string) -> bool {
    if n == "Array" { return true }
    let pfx = "Array:"
    if len(n) > len(pfx) {
        if n.substring(0, len(pfx)) == pfx { return true }
    }
    return false
}

// ── RFC-074 Phase 2.1 — enum variant payload element-type registry ──
//
// Module-local lookup table built during `_collect_item_types` and consumed
// by `_infer_expr` at the `EnumPath` site. Parallel-array shape (mirrors the
// bind.hexa Phase 2 arity registry layout, one level deeper so we can carry
// the per-slot `TypeRef` *display* strings rather than just the count):
//
//   _types_enum_names[i]                       : enum decl name (e.g. "Event")
//   _types_enum_variant_offsets[i]             : start index into _types_enum_variant_*[]
//   _types_enum_variant_counts[i]              : number of variants in enum i
//   _types_enum_variant_names[j]               : variant name (e.g. "Click")
//   _types_enum_variant_payload_offsets[j]     : start index into _types_enum_variant_payload_typrefs[]
//   _types_enum_variant_payload_arities[j]     : payload arity (= len(Param.typs))
//   _types_enum_variant_payload_typrefs[k]     : flat list of per-slot TypeRef display strings
//
// `enum_all_variant_payload_types: [[string]]` semantically — variant j owns
// the slice `[payload_offsets[j] .. payload_offsets[j] + payload_arities[j])`.
// Single-field (arity 1) is the degenerate slice of length 1; arity 0 (unit)
// is an empty slice; arity N≥2 is RFC-074's new territory.
//
// Why string display rather than Type? Stage0 cannot store rich structured
// values in module-globals (no `[Type]` literal initialiser without churn);
// the display string is also exactly the value we want to thread into the
// HX2005 diagnostic template's `{expected}` arg, so the equality check
// reduces to `display_at_slot == _type_display(_infer_expr(child))`. This
// is the same compare-on-display contract `_emit_hx3001` already uses.
let mut _types_enum_names: [string] = []
let mut _types_enum_variant_offsets: [i64] = []
let mut _types_enum_variant_counts: [i64] = []
let mut _types_enum_variant_names: [string] = []
let mut _types_enum_variant_payload_offsets: [i64] = []
let mut _types_enum_variant_payload_arities: [i64] = []
let mut _types_enum_variant_payload_typrefs: [string] = []

fn _types_enum_registry_reset() {
    _types_enum_names = []
    _types_enum_variant_offsets = []
    _types_enum_variant_counts = []
    _types_enum_variant_names = []
    _types_enum_variant_payload_offsets = []
    _types_enum_variant_payload_arities = []
    _types_enum_variant_payload_typrefs = []
}

// ── Type-alias substitution table (`type Name = Underlying`) ──────
//
// Parallel arrays mapping an alias name to the *spelling* of its underlying
// named type (e.g. "Celsius" → "f64"). Populated up front by
// `_types_register_aliases` from the `__type_alias` carrier items so a later
// `_types_lower_type_ref("Celsius")` resolves to the underlying primitive
// Type everywhere a TypeRef is lowered (let/param/return annotations, struct
// fields, `as`-casts). Lifetime == one `type_check()` call. Empty for any
// program that declares no aliases → `_types_lower_type_ref` falls through
// byte-identically (the registry lookup iterates 0 times).
let mut _types_alias_names: [string] = []
let mut _types_alias_underlying: [string] = []

fn _types_alias_registry_reset() {
    _types_alias_names = []
    _types_alias_underlying = []
}

// Scan all module items and register each `type Name = Underlying` carrier.
// Only `kind == "named"` underlyings are recorded (the common scalar/nominal
// case — `type MyInt = i64`, `type Handle = Widget`); generic/fn/tuple
// underlyings are left unregistered and fall through to the existing sentinel
// lowering. A self/forward chain is bounded at resolve time, not here.
fn _types_register_aliases(module: Module) {
    let mut i = 0
    while i < len(module.items) {
        let it = module.items[i]
        if item_is_type_alias(it) {
            let u = it.return_type
            if u.kind == "named" && len(u.name) > 0 {
                _types_alias_names.push(it.name)
                _types_alias_underlying.push(u.name)
            }
        }
        i = i + 1
    }
}

// Resolve an alias name to its underlying spelling, following chains
// (`type A = i64; type B = A`) with a bounded hop count to defuse any cycle
// (`type A = A`). Returns the input name unchanged when it is not a
// registered alias.
fn _types_resolve_alias_name(name: string) -> string {
    let mut cur = name
    let mut hops = 0
    while hops < 16 {
        let mut found = false
        let mut j = 0
        while j < len(_types_alias_names) {
            if _types_alias_names[j] == cur {
                cur = _types_alias_underlying[j]
                found = true
                break
            }
            j = j + 1
        }
        if !found { return cur }
        hops = hops + 1
    }
    return cur
}

// Render a TypeRef into the same display string `_type_display` would
// produce for the matching Type lowering. Keeps the registry's per-slot
// "expected" string byte-eq with the inferred-Type display so the HX2005
// equality check is purely string-on-string.
fn _types_typeref_display(tr: TypeRef) -> string {
    if len(tr.kind) == 0 { return "<unknown>" }
    if tr.kind == "named" {
        return _type_display(_types_lower_type_ref(tr))
    }
    // generic / fn / tuple / atlas_kind — fall through to the lowering's
    // sentinel shape so the displayed string matches what an inferred Type
    // with the same kind/name would render.
    return _type_display(_types_lower_type_ref(tr))
}

// Populate the registry for one enum Item. No-op for non-enum items.
// Called from `_collect_item_types` per-item; the registry's lifetime is
// the enclosing `type_check()` call (reset on entry per @D g_inbox_…
// surgical scope — one registry per module pass).
fn _types_register_enum_item_payloads(it: Item) {
    if !_types_is_enum_item(it.kind) { return }
    _types_enum_names.push(it.name)
    _types_enum_variant_offsets.push(len(_types_enum_variant_names))
    _types_enum_variant_counts.push(len(it.params))
    let mut vi = 0
    while vi < len(it.params) {
        let v = it.params[vi]
        _types_enum_variant_names.push(v.name)
        _types_enum_variant_payload_offsets.push(len(_types_enum_variant_payload_typrefs))
        let arity = len(v.typs)
        _types_enum_variant_payload_arities.push(arity)
        let mut si = 0
        while si < arity {
            _types_enum_variant_payload_typrefs.push(_types_typeref_display(v.typs[si]))
            si = si + 1
        }
        vi = vi + 1
    }
}

// Result of a variant lookup. `found=false` is the "skip" signal — the
// caller does NOT emit HX2005 for unknown enums (HX2001 already covers
// the head; HX2004 already covers arity). `payload_types` is the per-slot
// declared-type display strings, length == arity.
pub struct VariantPayloadLookup {
    found: bool,
    payload_types: [string]
}

fn _types_miss_variant_lookup() -> VariantPayloadLookup {
    return VariantPayloadLookup { found: false, payload_types: [] }
}

fn _types_lookup_variant_payload_types(enum_name: string, variant_name: string) -> VariantPayloadLookup {
    let mut ei = 0
    while ei < len(_types_enum_names) {
        if _types_enum_names[ei] == enum_name {
            let off = _types_enum_variant_offsets[ei]
            let cnt = _types_enum_variant_counts[ei]
            let mut vi = 0
            while vi < cnt {
                if _types_enum_variant_names[off + vi] == variant_name {
                    let poff = _types_enum_variant_payload_offsets[off + vi]
                    let parity = _types_enum_variant_payload_arities[off + vi]
                    let mut slots: [string] = []
                    let mut si = 0
                    while si < parity {
                        slots.push(_types_enum_variant_payload_typrefs[poff + si])
                        si = si + 1
                    }
                    return VariantPayloadLookup { found: true, payload_types: slots }
                }
                vi = vi + 1
            }
            return _types_miss_variant_lookup()
        }
        ei = ei + 1
    }
    return _types_miss_variant_lookup()
}

// Wall A r5 — struct field-type registry (parallel-array side index).
//
// The env's struct binding (`Type{kind="struct", args=[field types]}`) keeps
// the field types in declaration ORDER but DROPS the field NAMES — and the
// Module (the only carrier of `struct.params[i].name`) is NOT in `_infer_expr`
// scope (CheckCtx holds only fn_name/fn_return/module). So a `s.field = expr`
// field-assign cannot recover the declared field type from the env alone.
// Mirror the enum payload registry exactly: at `_collect_item_types` time
// (where the struct Item IS in scope) record, per struct, its field NAMES and
// the NAMED-type SPELLING of each field, into module-global parallel arrays a
// later `_infer_expr` site can query by (struct_name, field_name) without a
// second pass over module.items. Lifetime == one `type_check()` call (reset on
// entry, alongside the enum registry). Populated UNCONDITIONALLY (byte-neutral
// — pure data, no diagnostic) but READ only under the opt-in flag, so the
// default build is byte-identical (byteeq / gen3≡gen4 preserved). Only the
// `kind == "named"` spelling is stored (the common scalar/nominal field case —
// `x: i32`, `inner: Widget`); non-named fields store "" → the r5 fit check
// conservatively skips them (r6+ scope).
// ── static-types §F3 pre-flip env-hoist (wall_a_endgame.md §B.3 F3) ──
//
// Every static-types gate used to read `env("HEXA_STATIC_TYPES")` (and
// `…_ARRAY_LOWER`) inline — a per-NODE string compare on hot `_infer_expr`
// paths once the ladder grew past a handful of sites. Hoist both reads to
// once-per-`type_check()` cached bools (process env cannot change mid-pass,
// so this is semantics-preserving), refreshed at the top of `type_check`
// alongside the registry resets. The gate idiom is unchanged: the cached
// bool stays the FIRST `&&` operand at every site (short-circuit), and the
// default build (both false) takes the byte-identical fallthrough paths —
// diagnostic stream unchanged (byteeq-neutral). This is the census-named
// prerequisite for the flip-gate perf measurement (stage-1 wall ON vs OFF,
// condition #5 "post env-hoist").
let mut _types_static_on: bool = false
let mut _types_array_lower_on: bool = false
// static-types F4 warn-first two-step (wall_a_endgame.md §B.3 F4): the opt-in
// static-types REJECTs (HX3011 let/assign/match-mismatch, HX3016 struct-field
// existence) ship as a WARNING band under the plain HEXA_STATIC_TYPES=1 flag —
// a default-ON flip with fatal errors would break the shipping path on any
// latent true-positive. HEXA_STATIC_TYPES_STRICT=1 re-escalates them to the
// build-refusing Error (REJECT), keeping the fatal path reachable so no
// coverage is lost. Consulted ONLY at the HX3011/HX3016 emit sites, which are
// themselves reached only under _types_static_on — so STRICT without STATIC is
// an inert no-op (no diagnostic fires to re-severity).
let mut _types_strict: bool = false

fn _types_static_flags_hoist() {
    _types_static_on = env("HEXA_STATIC_TYPES") == "1"
    _types_strict = env("HEXA_STATIC_TYPES_STRICT") == "1"
    // static-types F0 flag-fold (wall_a_endgame.md §B.3 F0): HEXA_STATIC_TYPES
    // IMPLIES array-lower. A default-ON flip of a two-flag AND is incoherent,
    // so the r7-prep/r8/r9 array-lowering rungs fold under the single
    // HEXA_STATIC_TYPES flag. HEXA_STATIC_TYPES_ARRAY_LOWER stays a still-
    // working ALIAS for one deprecation cycle (additive fold, not a rename /
    // delete). Byteeq-neutral on the DEFAULT path: both flags unset →
    // _types_static_on=false → the disjunction is still false → the array-lower
    // gates (963/2777/3080/3131) keep the byte-identical fallthrough.
    _types_array_lower_on = _types_static_on || (env("HEXA_STATIC_TYPES_ARRAY_LOWER") == "1")
}

let mut _types_struct_names: [string] = []
let mut _types_struct_field_offsets: [i64] = []
let mut _types_struct_field_counts: [i64] = []
let mut _types_struct_field_names: [string] = []
let mut _types_struct_field_typenames: [string] = []

fn _types_struct_registry_reset() {
    _types_struct_names = []
    _types_struct_field_offsets = []
    _types_struct_field_counts = []
    _types_struct_field_names = []
    _types_struct_field_typenames = []
}

// Populate the registry for one struct Item. No-op for non-struct items.
// Called from `_collect_item_types` per-item AFTER the cross-file collision
// `continue` (so only the first, surviving struct of a duplicated name is
// recorded) — same structural slot as `_types_register_enum_item_payloads`.
fn _types_register_struct_item_fields(it: Item) {
    if !_types_is_struct_item(it.kind) { return }
    _types_struct_names.push(it.name)
    _types_struct_field_offsets.push(len(_types_struct_field_names))
    _types_struct_field_counts.push(len(it.params))
    let mut fi = 0
    while fi < len(it.params) {
        let p = it.params[fi]
        _types_struct_field_names.push(p.name)
        let mut spell = ""
        if p.typ.kind == "named" { spell = p.typ.name }
        _types_struct_field_typenames.push(spell)
        fi = fi + 1
    }
}

// Result of a struct field lookup. `found=false` is the "skip" signal (the
// receiver is not a known struct, or has no such field → the r5 fit check
// stays silent — field-existence / HX2005-style diagnostics are r6+ scope).
// `field_typename` is the declared field type's NAMED spelling, "" when the
// field's type was non-named (r6+).
pub struct StructFieldLookup {
    found: bool,
    field_typename: string
}

fn _types_lookup_struct_field_typename(struct_name: string, field_name: string) -> StructFieldLookup {
    let mut si = 0
    while si < len(_types_struct_names) {
        if _types_struct_names[si] == struct_name {
            let off = _types_struct_field_offsets[si]
            let cnt = _types_struct_field_counts[si]
            let mut fi = 0
            while fi < cnt {
                if _types_struct_field_names[off + fi] == field_name {
                    return StructFieldLookup { found: true, field_typename: _types_struct_field_typenames[off + fi] }
                }
                fi = fi + 1
            }
            return StructFieldLookup { found: false, field_typename: "" }
        }
        si = si + 1
    }
    return StructFieldLookup { found: false, field_typename: "" }
}

// static-types r9d — is `struct_name` a struct this module pass REGISTERED?
// Disambiguates the two `found=false` shapes of the lookup above: struct
// unknown to the registry (cross-module/unresolved receiver → the r9d
// existence check stays SILENT, conservative unknown-fallback) vs struct
// known but the field name missing (→ HX3016 REJECT). Read only under the
// opt-in flag — the registry itself is populated unconditionally (r5
// contract), so the default build stays byte-identical.
fn _types_struct_registry_has(struct_name: string) -> bool {
    let mut si = 0
    while si < len(_types_struct_names) {
        if _types_struct_names[si] == struct_name { return true }
        si = si + 1
    }
    return false
}

// static-types r11 — does the struct literal `e` PROVIDE an init for `fname`?
// Each provided field-init is an Ident child whose `text` is the field NAME
// (parser.hexa parse_struct_lit_after_name). Used by the HX3017 missing-
// required-field check to compute (declared − provided). Read only under the
// opt-in flag (called from the flag-gated struct-lit arm) → default build
// byte-identical.
fn _types_struct_lit_provides(e: Expr, fname: string) -> bool {
    let mut fi = 0
    while fi < len(e.children) {
        let finit = e.children[fi]
        if _types_is_ident(finit.kind) && finit.text == fname { return true }
        fi = fi + 1
    }
    return false
}

// static-types r11 — emit one HX3017 (Rust E0063 "missing field") per DECLARED
// field of KNOWN struct `sname` that the literal `e` omits. The deliberate
// PAIR of the r9d HX3016 existence reject: r9d catches a PRESENT field the
// struct doesn't declare; this catches a DECLARED field the literal doesn't
// provide. Caller gates on `_types_struct_registry_has(sname)` so an unknown
// struct stays SILENT (conservative unknown-fallback, same as HX3016). The
// diagnostic anchors on the struct-literal span (no node exists for an absent
// field). WARNING band, not REJECT (SSOT F4 warn-first). Flag-gated caller →
// default build byte-identical (byteeq-neutral).
fn _types_emit_missing_required(sname: string, e: Expr, out: array) {
    let mut si = 0
    while si < len(_types_struct_names) {
        if _types_struct_names[si] == sname {
            let off = _types_struct_field_offsets[si]
            let cnt = _types_struct_field_counts[si]
            let mut fi = 0
            while fi < cnt {
                let dfn = _types_struct_field_names[off + fi]
                if len(dfn) > 0 && !_types_struct_lit_provides(e, dfn) {
                    _emit_hx3017(sname, dfn, e.span, out)
                }
                fi = fi + 1
            }
            return
        }
        si = si + 1
    }
}

// ── HEXA-OWN L2 r1 — @own use-after-move lint registry ───────
//
// Opt-in (`HEXA_OWN_LINT=1`), warning-band, per-FN side registry for
// block-local `@own let` bindings and — r2b — `@own` fn PARAMS
// (single-owner discipline, Rust move semantics as a LINT — no
// codegen/MIR change, no drop insertion). Copy-class scalars are exempt
// (see _own_lint_name_is_copy below).
// Parallel-array shape mirrors the r5 struct field registry above, with
// TWO deliberate deviations, both recipe-mandated:
//   * population is FLAG-GATED (r5 populates unconditionally; own-lint
//     must be structurally zero-cost when OFF — every push below happens
//     only under `env("HEXA_OWN_LINT") == "1"` at the call sites);
//   * lifetime is ONE FN body, not one module pass (reset at the top of
//     `type_check`'s per-fn loop) — move state must never leak across fns
//     (fn A moving `x` must not poison an unrelated `@own let x` in fn B).
// Own-state is NEVER encoded via benv key redefinition — `_types_env_lookup`
// is first-hit-wins, so a redefined key silently reads the stale entry.
// The registry is PUSH-ONLY (proven registry discipline, no element
// mutation): a move pushes a state-1 entry that shadows the live state-0
// one; `_own_lint_find` scans from the END so the newest entry wins —
// which also gives a re-declared (shadowing) `@own let x` fresh state.
let mut _own_lint_names: [string] = []
let mut _own_lint_states: [i64] = []     // 0 = live, 1 = moved
let mut _own_lint_def_lines: [i64] = []  // declaration line (diag arg)
let mut _own_lint_move_lines: [i64] = [] // first-move site line (0 while live)
let mut _own_lint_move_cols: [i64] = []  // first-move site col  (0 while live)

fn _own_lint_reset() {
    _own_lint_names = []
    _own_lint_states = []
    _own_lint_def_lines = []
    _own_lint_move_lines = []
    _own_lint_move_cols = []
}

// Newest-entry-wins scan (from the END): the state-1 move entry pushed on
// top of a live one — or a fresh shadowing re-declaration — is found first.
fn _own_lint_find(name: string) -> i64 {
    let mut i = len(_own_lint_names) - 1
    while i >= 0 {
        if _own_lint_names[i] == name { return i }
        i = i - 1
    }
    return 0 - 1
}

fn _own_lint_register(name: string, sp: Span) {
    _own_lint_names.push(name)
    _own_lint_states.push(0)
    _own_lint_def_lines.push(sp.line)
    _own_lint_move_lines.push(0)
    _own_lint_move_cols.push(0)
}

// One move/use touch of a candidate node. Move sites (bare-ident only):
// let-RHS, assignment-RHS, call argument (r1), return value (r2). First
// touch of a live binding
// marks it moved (pushes the state-1 shadow entry); a later touch of a
// moved binding emits the HX3012 use-after-move WARNING. A re-visit of the
// SAME node (opt-in passes like the r2/r5 scratch re-infer walk an expr
// twice) is recognised by the recorded move-site span and stays silent —
// one source-level use is never double-counted as a second move.
fn _own_lint_touch(use_node: Expr, out: array) {
    if !_types_is_ident(use_node.kind) { return }
    if len(use_node.text) == 0 { return }
    let idx = _own_lint_find(use_node.text)
    if idx < 0 { return }
    if _own_lint_states[idx] == 0 {
        _own_lint_names.push(use_node.text)
        _own_lint_states.push(1)
        _own_lint_def_lines.push(_own_lint_def_lines[idx])
        _own_lint_move_lines.push(use_node.span.line)
        _own_lint_move_cols.push(use_node.span.col)
        return
    }
    if _own_lint_move_lines[idx] == use_node.span.line && _own_lint_move_cols[idx] == use_node.span.col {
        return
    }
    _emit_hx3012(use_node.text, _own_lint_def_lines[idx], _own_lint_move_lines[idx], use_node.span, out)
}

// ── HEXA-OWN L2 r2b — Copy-class exemption ──
// Adapted (not cherry-picked) from the preserved PR #4088 `feat/borrow-checker`
// branch's `_type_is_copy` predicate + `_borrow_name_is_copy` table: a binding
// whose declared type is a Copy-class SCALAR (integers signed/unsigned, floats,
// bool, char, unit) is duplicated on assignment / by-value passing, so
// use-after-move can never apply — it is EXEMPT from move tracking. The
// exemption is applied as a REGISTER-SKIP (the binding never enters the
// registry) because every registration site already sits under an
// `env("HEXA_OWN_LINT") == "1"` gate — flag-OFF stays byte-identical with no
// extra guard. Aggregates (string, named structs, arrays, tuples, generics,
// fn types) keep move semantics. Type aliases resolve first so
// `type Celsius = f64` is Copy (same as #4088).
fn _own_lint_name_is_copy(name: string) -> bool {
    if len(name) == 0 { return false }
    let n = _types_resolve_alias_name(name)
    if len(n) == 0 { return false }
    if n == "i8" || n == "i16" || n == "i32" || n == "i64" || n == "Int" || n == "int" { return true }
    if n == "u8" || n == "u16" || n == "u32" || n == "u64" { return true }
    if n == "f16" || n == "bf16" || n == "f32" || n == "f64" || n == "Float" || n == "float" || n == "Real" { return true }
    if n == "bool" || n == "Bool" { return true }
    if n == "char" || n == "Char" { return true }
    if n == "unit" || n == "Unit" || n == "()" || n == "void" || n == "Void" { return true }
    return false
}

// TypeRef flavor for PARAM position (params carry a full TypeRef, unlike
// lets whose annotation is the `|<name>` text suffix). Every non-`named`
// shape (array / tuple / generic / fn) is move-semantic; an empty TypeRef
// (no annotation) is unknown → NOT Copy → conservatively move-tracked.
fn _own_lint_typeref_is_copy(tr: TypeRef) -> bool {
    if len(tr.kind) == 0 { return false }
    if tr.kind != "named" { return false }
    return _own_lint_name_is_copy(tr.name)
}

// Does this (let) Expr carry a bare `@own` annotation? The parser already
// collects arbitrary `@name` annotations ahead of a body-level let
// (parser.hexa parse_stmt → Expr.annotations) — no parser change needed.
fn _own_lint_has_own_ann(e: Expr) -> bool {
    let mut i = 0
    while i < len(e.annotations) {
        if e.annotations[i].name == "own" { return true }
        i = i + 1
    }
    return false
}

// ── HEXA-OWN L2.5 r1 — arena-escape lint registry (HX3013) ───────
//
// Opt-in (`HEXA_ARENA_ESCAPE_LINT=1`), warning-band. Targets the escape
// hole the fn-arena runtime EXPLICITLY does not cover (self/runtime_core.c
// :3432 "env escape unheapified"): `__hexa_fn_arena_return` heapifies only
// the RETURN value, and `hexa_array_push` heapifies push-into-outer-array —
// but a fn-local arena-allocated composite STORED INTO A MODULE GLOBAL is
// never heapified, so the global dangles after the fn's `scope_pop`. Rule B
// (native aprime frontend, check-side only — zero codegen/runtime change):
// warn when a fn-local `let` whose RHS is a composite literal (array /
// struct literal → arena-allocated on the default arena path) is later
// assigned to a module-level `let` global via a bare-ident RHS.
//
// Discipline mirrors the L2 own-lint registry above (recipe-mandated):
//   * population is FLAG-GATED at every call site — the default build
//     pushes nothing (structurally zero-cost, byteeq-neutral);
//   * per-FN lifetime for the local arrays (reset next to _own_lint_reset
//     in type_check's per-fn loop); per-MODULE lifetime for the globals
//     list (reset+populated up front in type_check);
//   * SEPARATE parallel arrays — never share _own_lint_* state (L2/L2.5
//     must not cross-contaminate), never encode state via benv redefines
//     (_types_env_lookup is first-hit-wins);
//   * emission-only at the check site (no state mutation on emit): a
//     scratch re-infer pass discards its sink, so no span-dedup is needed.
let mut _arena_esc_names: [string] = []     // fn-local composite-lit `let`s
let mut _arena_esc_def_lines: [i64] = []    // their decl lines (diag arg)
let mut _arena_esc_locals: [string] = []    // ALL fn-local let names (shadow guard)
let mut _arena_esc_globals: [string] = []   // module-level let item names

fn _arena_esc_reset() {
    _arena_esc_names = []
    _arena_esc_def_lines = []
    _arena_esc_locals = []
}

fn _arena_esc_globals_reset() {
    _arena_esc_globals = []
}

// Newest-entry-wins scan (from the END), mirroring _own_lint_find.
fn _arena_esc_find(name: string) -> i64 {
    let mut i = len(_arena_esc_names) - 1
    while i >= 0 {
        if _arena_esc_names[i] == name { return i }
        i = i - 1
    }
    return 0 - 1
}

fn _arena_esc_name_in(list: [string], name: string) -> bool {
    let mut i = 0
    while i < len(list) {
        if list[i] == name { return true }
        i = i + 1
    }
    return false
}

// Composite-literal predicate: an ArrayLit / StructLit RHS is allocated in
// the enclosing fn's arena on the default path (hexa_val_arena_on). Full
// exhaustive ExprKind match — the established predicate idiom of this file
// (`_types_is_let` et al.). Known limitation (warning-band lint, commented
// not guarded): a later same-named NON-composite `let` re-declaration does
// not tombstone an earlier composite entry (newest-wins scan hits the
// composite one) — acceptable false-positive surface for r1.
fn _arena_esc_is_composite(k: ExprKind) -> bool {
    return match k {
        ExprKind::ArrayLit -> true,
        ExprKind::StructLit -> true,
        ExprKind::LiteralInt -> false,
        ExprKind::LiteralFloat -> false,
        ExprKind::LiteralString -> false,
        ExprKind::LiteralBool -> false,
        ExprKind::LiteralChar -> false,
        ExprKind::Ident -> false,
        ExprKind::AtlasRef -> false,
        ExprKind::Call -> false,
        ExprKind::BinOp -> false,
        ExprKind::UnOp -> false,
        ExprKind::Block -> false,
        ExprKind::If -> false,
        ExprKind::While -> false,
        ExprKind::For -> false,
        ExprKind::Match -> false,
        ExprKind::Return -> false,
        ExprKind::Break -> false,
        ExprKind::Continue -> false,
        ExprKind::Let -> false,
        ExprKind::Assign -> false,
        ExprKind::Field -> false,
        ExprKind::Index -> false,
        ExprKind::EnumPath -> false,
        ExprKind::Wildcard -> false,
        ExprKind::Try -> false,
        ExprKind::Throw -> false,
        ExprKind::Closure -> false
    }
}

// Registration for one block-statement `let` (called from the Block arm,
// flag-gated at the call site): every let name enters the shadow-guard
// list; a composite-literal RHS additionally enters the escape-candidate
// registry with its decl line.
fn _arena_esc_register_let(och: Expr) {
    let nm = _types_let_name(och.text)
    if len(nm) == 0 { return }
    _arena_esc_locals.push(nm)
    if len(och.children) > 0 && _arena_esc_is_composite(och.children[0].kind) {
        _arena_esc_names.push(nm)
        _arena_esc_def_lines.push(och.span.line)
    }
}

// Wall A r5 — strip the `named:` prefix a struct-typed receiver's inferred /
// recorded Type carries (`_types_lower_type_ref` lowers any non-primitive
// named annotation `Point` to kind `named:Point`). Returns the bare struct
// name, or "" when `k` is not a `named:` kind. `.chars()`-based mirror of
// `_types_array_elem_kind` — no new builtin, frozen-seed-safe.
fn _types_struct_name_of(k: string) -> string {
    let pfx = "named:"
    let chars = k.chars()
    let n = len(chars)
    let pch = pfx.chars()
    let plen = len(pch)
    if n <= plen { return "" }
    let mut pi = 0
    while pi < plen {
        if chars[pi] != pch[pi] { return "" }
        pi = pi + 1
    }
    let mut out = ""
    let mut i = plen
    while i < n {
        out = out + to_string(chars[i])
        i = i + 1
    }
    return out
}

// EnumPath text encodes "Enum::Variant" — mirror of bind.hexa's
// `_enum_head` / `_enum_variant_tail` (kept module-local here to avoid
// cross-module dependency between check/types.hexa and check/bind.hexa).
fn _types_enum_path_head(t: string) -> string {
    let chars = t.chars()
    let n = len(chars)
    let mut i = 0
    while i < n - 1 {
        if chars[i] == ':' && chars[i + 1] == ':' {
            let mut out = ""
            let mut j = 0
            while j < i {
                out = out + to_string(chars[j])
                j = j + 1
            }
            return out
        }
        i = i + 1
    }
    return ""
}

fn _types_enum_path_tail(t: string) -> string {
    let chars = t.chars()
    let n = len(chars)
    let mut i = 0
    while i < n - 1 {
        if chars[i] == ':' && chars[i + 1] == ':' {
            let mut out = ""
            let mut j = i + 2
            while j < n {
                out = out + to_string(chars[j])
                j = j + 1
            }
            return out
        }
        i = i + 1
    }
    return ""
}

// ExprKind classifier — mirrors bind.hexa's `_is_enum_path_kind` shape.
// Stage0 enum-Eq lacks derive, so we hand-roll the exhaustive arm.
fn _types_is_enum_path_kind(k: ExprKind) -> bool {
    return match k {
        ExprKind::EnumPath -> true,
        ExprKind::LiteralInt -> false,
        ExprKind::LiteralFloat -> false,
        ExprKind::LiteralString -> false,
        ExprKind::LiteralBool -> false,
        ExprKind::LiteralChar -> false,
        ExprKind::Ident -> false,
        ExprKind::AtlasRef -> false,
        ExprKind::Call -> false,
        ExprKind::BinOp -> false,
        ExprKind::UnOp -> false,
        ExprKind::Block -> false,
        ExprKind::If -> false,
        ExprKind::While -> false,
        ExprKind::For -> false,
        ExprKind::Match -> false,
        ExprKind::Return -> false,
        ExprKind::Break -> false,
        ExprKind::Continue -> false,
        ExprKind::Let -> false,
        ExprKind::Assign -> false,
        ExprKind::Field -> false,
        ExprKind::Index -> false,
        ExprKind::ArrayLit -> false,
        ExprKind::StructLit -> false,
        ExprKind::Wildcard -> false,
        ExprKind::Try -> false,
        ExprKind::Throw -> false,
        ExprKind::Closure -> false
    }
}

// ── TypeEnv ops ──────────────────────────────────────────────

// Define a binding with explicit visibility + owning-module attribution.
// Stage1 punch list Gap 2 — pub items live in the global namespace; non-pub
// items are file-private and visible only when the caller's module.file
// matches `module_file`. Local bindings (fn params, lets) are recorded as
// pub=false / module_file=current to keep them invisible across files.
fn _types_env_define_attr(env: TypeEnv, name: string, def: DefId, t: Type,
    is_pub: bool, module_file: string) -> TypeEnv {
    // A3 — keep the hash index in lockstep with `entries`. If the env was
    // hand-built without a primed bucket array (legacy test path), seed
    // it once on first define so subsequent operations stay O(1) avg.
    //
    // Stage1 punch list — bucket-aliasing fix: hexa_struct_pack_map
    // shallow-clones array fields (entries, buckets) per ROI #148 to
    // break sibling-struct aliasing, BUT the inner [i64] bucket arrays
    // remain shared across all derived envs. If we mutated env.buckets[h]
    // in place, every env sharing that inner would see the new index —
    // and a derived env with a SMALLER entries snapshot would then OOB
    // when looking up names hashing to h. Fix: build a fresh outer
    // buckets and a fresh inner for the affected slot, leaving
    // env.buckets untouched so old envs remain self-consistent.
    let mut buckets: [[i64]] = []
    if len(env.buckets) == 0 {
        // Hand-built env without buckets — seed fresh from entries.
        buckets = _types_empty_buckets()
        let mut k = 0
        while k < len(env.entries) {
            let hk = _types_hash_name(env.entries[k].name)
            buckets[hk] = buckets[hk].push(k)  // safe: buckets is fresh
            k = k + 1
        }
    } else {
        // Clone outer (shallow per slot — inner [i64] are read-only here).
        let mut bi = 0
        while bi < len(env.buckets) {
            buckets.push(env.buckets[bi])
            bi = bi + 1
        }
    }
    let mut entries = env.entries
    let new_idx = len(entries)
    entries.push(TypeBinding {
        def: def,
        name: name,
        typ: t,
        is_pub: is_pub,
        module_file: module_file
    })
    let h = _types_hash_name(name)
    // Build a FRESH inner for slot h — don't mutate env.buckets[h] inner.
    let mut new_inner: [i64] = []
    let mut bj = 0
    while bj < len(buckets[h]) {
        new_inner.push(buckets[h][bj])
        bj = bj + 1
    }
    new_inner.push(new_idx)
    buckets[h] = new_inner  // safe: buckets is our fresh outer
    return TypeEnv { entries: entries, buckets: buckets }
}

// Backwards-compatible shim. Pre-Gap-2 callers expected a single-namespace
// define with no visibility/attribution — we record those as pub=false /
// module_file="" so cross-file lookups never see them. The pre-pass uses
// `_types_env_define_attr` directly with the real values.
fn _types_env_define(env: TypeEnv, name: string, def: DefId, t: Type) -> TypeEnv {
    return _types_env_define_attr(env, name, def, t, false, "")
}

// Status of a name lookup. Stage1 Gap 2:
//   found=true                          → typ is the visible binding
//   found=false, private_other_module=true
//                                       → name exists privately in another
//                                         module — caller emits HX2002
//   found=false, private_other_module=false
//                                       → name simply does not exist
pub struct LookupResult {
    found: bool,
    typ: Type,
    private_other_module: bool,
    other_module_file: string
}

fn _types_lookup_def(env: TypeEnv, name: string, caller_file: string) -> LookupResult {
    // A3 — restrict scans to the hash bucket for `name`. Each pass walks
    // only entries that share the same hash, not the entire env.
    let bucket = _types_bucket_for(env, name)
    // Pass 1: pub global hit takes priority (pubs are global names).
    let mut i = 0
    while i < len(bucket) {
        let b = env.entries[bucket[i]]
        if b.name == name && b.is_pub {
            return LookupResult {
                found: true,
                typ: b.typ,
                private_other_module: false,
                other_module_file: ""
            }
        }
        i = i + 1
    }
    // Pass 2: private hit in caller's own module.
    let mut j = 0
    while j < len(bucket) {
        let b = env.entries[bucket[j]]
        if b.name == name && !b.is_pub && b.module_file == caller_file {
            return LookupResult {
                found: true,
                typ: b.typ,
                private_other_module: false,
                other_module_file: ""
            }
        }
        j = j + 1
    }
    // Pass 3: name exists privately in a foreign ORIGIN file. Under the
    // Option-A flat splice (self/module_loader + tool/flatten_imports),
    // all imported files are inlined into ONE compilation unit — the
    // per-source-file privacy boundary is dissolved (a namespaced
    // WorldModule is the deferred follow-up, see parser.hexa header).
    // So a non-pub binding from another origin file IS legitimately in
    // scope here; RESOLVE it (return its type) instead of raising the
    // HX2002 cross-module-privacy false-positive (993 in stage-2 self-
    // compile). Genuinely-undefined names still fall through to the
    // not-found return below → HX2001 (no real-error masking; this only
    // relaxes the case where the name provably EXISTS as a binding).
    let mut k = 0
    while k < len(bucket) {
        let b = env.entries[bucket[k]]
        if b.name == name && !b.is_pub {
            return LookupResult {
                found: true,
                typ: b.typ,
                private_other_module: false,
                other_module_file: ""
            }
        }
        k = k + 1
    }
    return LookupResult {
        found: false,
        typ: _types_empty_type(),
        private_other_module: false,
        other_module_file: ""
    }
}

// Legacy lookup. Caller-file is taken from the env's first private binding
// when present (test harnesses build flat envs with no module attribution).
// Production code paths now use `_types_lookup_def` directly with the real
// CheckCtx.module attribution.
fn _types_env_lookup(env: TypeEnv, name: string) -> Type {
    // A3 — bucket-restricted scan; semantics unchanged (first hit wins).
    let bucket = _types_bucket_for(env, name)
    let mut i = 0
    while i < len(bucket) {
        let b = env.entries[bucket[i]]
        if b.name == name { return b.typ }
        i = i + 1
    }
    return _types_empty_type()
}

// Standalone fallback used by the test when bind has not run — scan a
// Module's items for a top-level definition with the given name and
// synthesise its Type. Mirrors the pre-pass that `type_check` performs
// on a real module, just inlined for callers that hand-build envs.
pub fn _resolve_ident_to_type(env: TypeEnv, name: string) -> Type {
    return _types_env_lookup(env, name)
}

// ── Diagnostic emit helpers ──────────────────────────────────

fn _emit_hx3001(expected: Type, actual: Type, sp: Span, out: array) {
    let mut b = diag_new("HX3001")
    b = diag_span(b, sp)
    b = diag_arg(b, "expected", _type_display(expected))
    b = diag_arg(b, "actual", _type_display(actual))
    out.push(diag_emit(b))
}

// HX3011 — opt-in static-type let-mismatch (HEXA_STATIC_TYPES=1).
// Rust E0308-faithful "mismatched types": a `let x: T = <literal>` whose
// scalar-literal RHS provably disagrees with the declared scalar T. F4
// warn-first two-step (wall_a_endgame.md §B.3 F4): WARNING band under the
// plain flag (renders, never aborts) so a default-ON flip cannot break the
// shipping path on a latent true-positive; HEXA_STATIC_TYPES_STRICT=1
// re-escalates to Error → main.hexa `_has_errors` aborts before codegen
// (REJECT). Only emitted under HEXA_STATIC_TYPES, so the default diagnostic
// stream is byte-identical in BOTH bands (byteeq-neutral).
fn _emit_hx3011(expected: Type, actual: Type, sp: Span, out: array) {
    let mut b = diag_new("HX3011")
    b = diag_span(b, sp)
    b = diag_arg(b, "expected", _type_display(expected))
    b = diag_arg(b, "actual", _type_display(actual))
    if _types_strict {
        out.push(diag_emit(b))
    } else {
        out.push(diag_emit_sev(b, Severity::Warning))
    }
}

// HX3012 — opt-in @own use-after-move lint (HEXA_OWN_LINT=1).
// Rust E0382-shaped "use of moved value", surfaced as a WARNING (renders,
// never aborts — the HX3006 warning-band contract, main.hexa `_has_errors`
// counts Severity::Error only). Only emitted under the flag, so the default
// diagnostic stream is byte-identical (byteeq-neutral).
fn _emit_hx3012(name: string, def_line: i64, moved_line: i64, sp: Span, out: array) {
    let mut b = diag_new("HX3012")
    b = diag_span(b, sp)
    b = diag_arg(b, "name", name)
    b = diag_arg(b, "def_line", to_string(def_line))
    b = diag_arg(b, "moved_line", to_string(moved_line))
    out.push(diag_emit(b))
}

// HX3013 — opt-in arena-escape lint (HEXA_ARENA_ESCAPE_LINT=1), HEXA-OWN
// L2.5 r1 Rule B. Same warning-band contract as HX3012 (renders, never
// aborts); only emitted under the flag, so the default diagnostic stream
// is byte-identical (byteeq-neutral). Emission-only — no registry state
// change here, so a scratch-sink re-infer discards cleanly (no dedup
// needed, unlike _own_lint_touch's move-state push).
fn _emit_hx3013(name: string, global: string, def_line: i64, sp: Span, out: array) {
    let mut b = diag_new("HX3013")
    b = diag_span(b, sp)
    b = diag_arg(b, "name", name)
    b = diag_arg(b, "global", global)
    b = diag_arg(b, "def_line", to_string(def_line))
    out.push(diag_emit(b))
}

// HX3016 — opt-in struct-literal field-EXISTENCE reject (HEXA_STATIC_TYPES=1),
// static-types r9d. Rust E0560-faithful "struct has no field named": a
// field-init whose name misses the r5 registry for a struct the registry
// KNOWS. F4 warn-first two-step (wall_a_endgame.md §B.3 F4), the SAME band
// policy as HX3011: WARNING under the plain flag, HEXA_STATIC_TYPES_STRICT=1
// re-escalates to Error (REJECT) — the strict abort contract of HX3011. Only
// emitted under HEXA_STATIC_TYPES, so the default diagnostic stream is
// byte-identical in BOTH bands (byteeq-neutral).
fn _emit_hx3014(sname: string, fname: string, sp: Span, out: array) {
    let mut b = diag_new("HX3016")
    b = diag_span(b, sp)
    b = diag_arg(b, "name", sname)
    b = diag_arg(b, "field", fname)
    if _types_strict {
        out.push(diag_emit(b))
    } else {
        out.push(diag_emit_sev(b, Severity::Warning))
    }
}

// HX3017 — opt-in struct-literal MISSING-required-field warning
// (HEXA_STATIC_TYPES=1), static-types r11. Rust E0063-faithful "missing
// field in initializer": a field the struct DECLARES but the literal did NOT
// provide, for a struct the r5/r9d registry KNOWS. Warning severity
// (catalog.hexa) → NON-fatal band (SSOT F4 warn-first), the deliberate PAIR
// of the r9d HX3016 existence REJECT (which fires on a PRESENT unknown
// field). Only emitted under the flag → default diagnostic stream
// byte-identical (byteeq-neutral).
fn _emit_hx3017(sname: string, fname: string, sp: Span, out: array) {
    let mut b = diag_new("HX3017")
    b = diag_span(b, sp)
    b = diag_arg(b, "name", sname)
    b = diag_arg(b, "field", fname)
    out.push(diag_emit(b))
}

fn _emit_hx3002(name: string, expected: i64, actual: i64, sp: Span, out: array) {
    let mut b = diag_new("HX3002")
    b = diag_span(b, sp)
    b = diag_arg(b, "name", name)
    b = diag_arg(b, "expected", to_string(expected))
    b = diag_arg(b, "actual", to_string(actual))
    out.push(diag_emit(b))
}

fn _emit_hx3003(name: string, pos: i64, expected: Type, actual: Type, sp: Span, out: array) {
    let mut b = diag_new("HX3003")
    b = diag_span(b, sp)
    b = diag_arg(b, "pos", to_string(pos))
    b = diag_arg(b, "name", name)
    b = diag_arg(b, "expected", _type_display(expected))
    b = diag_arg(b, "actual", _type_display(actual))
    out.push(diag_emit(b))
}

fn _emit_hx3004(name: string, expected: Type, actual: Type, sp: Span, out: array) {
    let mut b = diag_new("HX3004")
    b = diag_span(b, sp)
    b = diag_arg(b, "name", name)
    b = diag_arg(b, "expected", _type_display(expected))
    b = diag_arg(b, "actual", _type_display(actual))
    out.push(diag_emit(b))
}

fn _emit_hx3005(pos: i64, expected: Type, actual: Type, sp: Span, out: array) {
    let mut b = diag_new("HX3005")
    b = diag_span(b, sp)
    b = diag_arg(b, "expected", _type_display(expected))
    b = diag_arg(b, "actual", _type_display(actual))
    b = diag_arg(b, "pos", to_string(pos))
    out.push(diag_emit(b))
}

fn _emit_hx4001(sp: Span, out: array) {
    let mut b = diag_new("HX4001")
    b = diag_span(b, sp)
    out.push(diag_emit(b))
}

// RFC-074 Phase 2.1 — HX2005 emitter: enum variant payload element-type
// mismatch (per-slot positional). Fired AFTER HX2004 has accepted arity,
// once per failing slot — multi-slot construction with two bad slots emits
// two HX2005 (RFC-019 §6 collect-don't-stop convention).
fn _emit_hx2005(enum_name: string, variant_name: string, pos: i64, expected: string, actual: string, sp: Span, out: array) {
    let mut b = diag_new("HX2005")
    b = diag_span(b, sp)
    b = diag_arg(b, "enum_name", enum_name)
    b = diag_arg(b, "variant_name", variant_name)
    b = diag_arg(b, "pos", to_string(pos))
    b = diag_arg(b, "expected", expected)
    b = diag_arg(b, "actual", actual)
    out.push(diag_emit(b))
}

// Stage1 punch list C4 — unknown callee in a call expression. Mirrors
// bind.hexa's HX2001 shape (no suggest field — bind owns did-you-mean).
// Only fired when the call's callee is NOT a plain Ident, since bind
// already covers the Ident-miss case and would otherwise double-fire.
fn _emit_hx2001_callee(name: string, sp: Span, out: array) {
    let mut b = diag_new("HX2001")
    b = diag_span(b, sp)
    b = diag_arg(b, "name", name)
    out.push(diag_emit(b))
}

// Stage1 Gap 2 — duplicate pub symbol across files.
fn _emit_hx3010(name: string, first_file: string, second_file: string, sp: Span, out: array) {
    let mut b = diag_new("HX3010")
    b = diag_span(b, sp)
    b = diag_arg(b, "name", name)
    b = diag_arg(b, "first_file", first_file)
    b = diag_arg(b, "second_file", second_file)
    out.push(diag_emit(b))
}

// Stage1 Gap 2 — private symbol referenced from a foreign module.
fn _emit_hx2002(name: string, defining_file: string, caller_file: string, sp: Span, out: array) {
    let mut b = diag_new("HX2002")
    b = diag_span(b, sp)
    b = diag_arg(b, "name", name)
    b = diag_arg(b, "defining_file", defining_file)
    b = diag_arg(b, "caller_file", caller_file)
    out.push(diag_emit(b))
}

// ── Type equivalence (nominal, structural for primitives) ────

fn _types_equal(a: Type, b: Type) -> bool {
    // Either side unknown → tolerate (don't double-report).
    if len(a.kind) == 0 || len(b.kind) == 0 { return true }
    // static-types r7-prep — structured array equality. kind:"array" is only
    // ever produced by the opt-in HEXA_STATIC_TYPES_ARRAY_LOWER branch of
    // `_types_lower_type_ref` (grep-verified: no other check-side constructor
    // emits it), so this branch is DEAD CODE on the default build — flag-OFF
    // comparisons keep the textual kind compare below, byte-neutral. Flag-ON
    // it recurses on the element Type so `[i32]` vs `[f64]` stays UNEQUAL
    // (the kind-only compare would collapse every array to "array" and
    // silently pass mismatched-element calls that REJECT today). Missing
    // element (defensive; the producer always pushes args[0]) → tolerate,
    // mirroring the unknown contract above.
    if a.kind == "array" && b.kind == "array" {
        if len(a.args) == 0 || len(b.args) == 0 { return true }
        return _types_equal(a.args[0], b.args[0])
    }
    return a.kind == b.kind
}

fn _types_is_numeric(t: Type) -> bool {
    if len(t.kind) == 0 { return false }
    if t.kind == "i8"  { return true }
    if t.kind == "i16" { return true }
    if t.kind == "i32" { return true }
    if t.kind == "i64" { return true }
    // RFC 068 P2 — f16/bf16 are numeric (real domain).
    if t.kind == "f16"  { return true }
    if t.kind == "bf16" { return true }
    if t.kind == "f32" { return true }
    if t.kind == "f64" { return true }
    return false
}

fn _is_integer_kind(t: Type) -> bool {
    if t.kind == "i8"  { return true }
    if t.kind == "i16" { return true }
    if t.kind == "i32" { return true }
    if t.kind == "i64" { return true }
    return false
}

fn _is_float_kind(t: Type) -> bool {
    // RFC 068 P2 — f16/bf16 are float kinds (allow float-literal coercion).
    if t.kind == "f16"  { return true }
    if t.kind == "bf16" { return true }
    if t.kind == "f32" { return true }
    if t.kind == "f64" { return true }
    return false
}

// Literal-coercion-aware compatibility check.
//
// `_types_equal` is structural on `kind`, which is too strict for the
// universal-int-literal ergonomics every mainstream language ships:
// `let x: i32 = 0` should type-check even though `0` is inferred as i64.
// This helper layers a narrow exception on top:
//
//   - if either side is unknown → tolerate (preserves _types_equal policy)
//   - if both kinds are equal → ok
//   - if `actual` came from an integer literal AND both kinds are integer
//     kinds (any of i8/i16/i32/i64) → ok
//   - if `actual` came from a float literal AND both kinds are float
//     kinds (f32/f64) → ok
//
// Range-fit checking (does the literal value fit in i8?) is deferred to
// a later pass; v0 trusts the programmer the way Rust's untyped-int
// literal inference does. Out-of-range fits surface as codegen overflow.
// HexaVal is the dynamic tagged any-value: at runtime every value is a HexaVal
// and the runtime dispatches on its tag (the same rationale the existing
// unit/unknown tolerances already cite). `named:HexaVal` and the explicit
// `named:any` are both dynamic wildcards — compatible with any target type on
// either side. Treating them as wildcards mirrors the legacy self/ compiler and
// clears the N5-pre HX3001/HX3004 false-positives.
fn _is_hexaval(t: Type) -> bool { return t.kind == "named:HexaVal" || t.kind == "named:any" }

fn _types_assignable(expected: Type, actual: Type, src: Expr) -> bool {
    if _types_equal(expected, actual) { return true }
    if _is_hexaval(expected) || _is_hexaval(actual) { return true }
    // static-types r9b — ELEMENT-level literal coercion for array-literal
    // sources. The literal-coercion arms below key on `src.kind` being a
    // scalar literal; an ArrayLit src is NEITHER, so an expected `[f32]`
    // against an inferred `array[f64]` from `[0.0]` would FALSE-fire (HX3004
    // on `fn g() -> [f32] { return [0.0] }`, HX3011 on `let xs: [f32] =
    // [0.0]`, HX3003 on `g([0])` vs `[i32]`) — the sole false-positive
    // source the r8 structural-ArrayLit inference introduces, and a
    // flip-blocker (§B F0). Recurse per ELEMENT instead, with each element
    // EXPR as the coercion src (Rust E0308: rustc_hir_typeck
    // coerce/demand_coerce applies the literal-inference rule per array
    // element, so `[0.0]` fits `[f32]` while a non-literal f64 ident element
    // still REJECTs). Both sides' element type is args[0] — the r8 producer
    // only builds uniform-scalar ArrayLit types and the r7-prep lowering
    // always pushes args[0], and `_types_equal` above already tolerated any
    // missing-args side, so both args are non-empty here. NO env gate needed
    // — kind:"array" is ONLY ever produced by the opt-in ARRAY_LOWER /
    // r8-inference branches (the `_types_equal` r7-prep precedent: this arm
    // is DEAD CODE on the default build, byte-neutral).
    if expected.kind == "array" && actual.kind == "array" && _types_is_array_lit(src.kind) {
        let mut si = 0
        while si < len(src.children) {
            if !_types_assignable(expected.args[0], actual.args[0], src.children[si]) {
                return false
            }
            si = si + 1
        }
        return true
    }
    if _types_is_lit_int(src.kind) && _is_integer_kind(expected) && _is_integer_kind(actual) {
        return true
    }
    if _types_is_lit_float(src.kind) && _is_float_kind(expected) && _is_float_kind(actual) {
        return true
    }
    return false
}

// ── Context for the walker ───────────────────────────────────
// Threaded through recursive checks: the enclosing fn name + return Type
// (for HX3004) and the module name (currently informational).

pub struct CheckCtx {
    fn_name: string,
    fn_return: Type,
    module: string
}

fn _types_new_ctx(module: string) -> CheckCtx {
    return CheckCtx { fn_name: "", fn_return: _types_empty_type(), module: module }
}

fn _ctx_with_fn(ctx: CheckCtx, name: string, ret: Type) -> CheckCtx {
    return CheckCtx { fn_name: name, fn_return: ret, module: ctx.module }
}

// ── Opt-in static-type let-check helpers (HEXA_STATIC_TYPES) ──
// Module-local mirror of ast_to_hir.hexa:_hir_let_type_text — the local-let
// Expr.text encodes `<name>|<typename>` (or `mut:<name>|<typename>`); the
// annotation is the substring after `|`, or "" for a bare `let x = …`. Kept
// self-contained in types.hexa (no cross-module import; bind.hexa:_hir_let_name
// mirror precedent). Frozen-seed-safe — reuses the existing parse encoding,
// no new keyword.
fn _types_let_type_text(t: string) -> string {
    let chars = t.chars()
    let n = len(chars)
    let mut i = 0
    while i < n {
        if chars[i] == '|' {
            let mut out = ""
            let mut j = i + 1
            while j < n {
                out = out + to_string(chars[j])
                j = j + 1
            }
            return out
        }
        i = i + 1
    }
    return ""
}

// Wall A r3 — module-local mirror of bind.hexa:_bind_let_name. The local-let
// Expr.text encodes `<name>|<typename>` (or `mut:<name>|<typename>`); strip
// the optional `mut:` prefix and the `|<type>` suffix to recover the bare
// binding NAME. Needed so a `let x: T` decl can record its declared type into
// the block-scoped env under the variable's name, for a later split-init
// `x = <expr>` assign to look up. Self-contained (no cross-module import,
// same precedent as _types_let_type_text); frozen-seed-safe (no new keyword).
fn _types_let_name(t: string) -> string {
    let chars = t.chars()
    let n = len(chars)
    let mut start = 0
    if n >= 4 && chars[0] == 'm' && chars[1] == 'u' && chars[2] == 't' && chars[3] == ':' {
        start = 4
    }
    let mut out = ""
    let mut i = start
    while i < n {
        if chars[i] == '|' { return out }
        out = out + to_string(chars[i])
        i = i + 1
    }
    return out
}

// r1 soundness gate: only KNOWN scalar primitives are sound comparison
// targets for a scalar-literal RHS. `_types_lower_type_ref` maps user/unknown
// names to a `named:<n>` sentinel (and struct/enum/generic to `<kind>:<name>`)
// — those are r5+ scope and must NOT be flagged here. Mirrors the primitive
// set that `_types_lower_type_ref` recognises (i8…i64 · f16…f64 · bool ·
// string · char); `unit` is intentionally excluded.
fn _types_kind_is_scalar(k: string) -> bool {
    let t = _prim(k, "")
    if _is_integer_kind(t) { return true }
    if _is_float_kind(t)   { return true }
    if k == "bool"   { return true }
    if k == "string" { return true }
    if k == "char"   { return true }
    return false
}

// Wall A r4 — Index-expr probe (stage0 has no derived Eq). Mirrors the
// per-ExprKind match shape of `_types_is_assign`; only `ExprKind::Index`
// (a postfix `a[i]` subscript, parser.hexa:753) is true. Used so the assign
// arm can distinguish an `a[i] = …` element-place LHS from a plain ident LHS.
fn _types_is_index(k: ExprKind) -> bool {
    return match k {
        ExprKind::Index -> true,
        ExprKind::Assign -> false,
        ExprKind::LiteralInt -> false,
        ExprKind::LiteralFloat -> false,
        ExprKind::LiteralString -> false,
        ExprKind::LiteralBool -> false,
        ExprKind::LiteralChar -> false,
        ExprKind::Ident -> false,
        ExprKind::AtlasRef -> false,
        ExprKind::Call -> false,
        ExprKind::BinOp -> false,
        ExprKind::UnOp -> false,
        ExprKind::Block -> false,
        ExprKind::If -> false,
        ExprKind::While -> false,
        ExprKind::For -> false,
        ExprKind::Match -> false,
        ExprKind::Return -> false,
        ExprKind::Break -> false,
        ExprKind::Continue -> false,
        ExprKind::Let -> false,
        ExprKind::Field -> false,
        ExprKind::ArrayLit -> false,
        ExprKind::StructLit -> false,
        ExprKind::EnumPath -> false,
        ExprKind::Wildcard -> false,
        ExprKind::Try -> false,
        ExprKind::Throw -> false,
        ExprKind::Closure -> false
    }
}

// Wall A r5 — Field-expr probe (stage0 has no derived Eq). Mirrors the
// per-ExprKind match shape of `_types_is_index`; only `ExprKind::Field`
// (a postfix `a.field` access, parser.hexa:715 — `text`=field name,
// `children[0]`=receiver) is true. Used so the assign arm can distinguish a
// `s.field = …` field-place LHS from a plain ident / index LHS.
fn _types_is_field(k: ExprKind) -> bool {
    return match k {
        ExprKind::Field -> true,
        ExprKind::Index -> false,
        ExprKind::Assign -> false,
        ExprKind::LiteralInt -> false,
        ExprKind::LiteralFloat -> false,
        ExprKind::LiteralString -> false,
        ExprKind::LiteralBool -> false,
        ExprKind::LiteralChar -> false,
        ExprKind::Ident -> false,
        ExprKind::AtlasRef -> false,
        ExprKind::Call -> false,
        ExprKind::BinOp -> false,
        ExprKind::UnOp -> false,
        ExprKind::Block -> false,
        ExprKind::If -> false,
        ExprKind::While -> false,
        ExprKind::For -> false,
        ExprKind::Match -> false,
        ExprKind::Return -> false,
        ExprKind::Break -> false,
        ExprKind::Continue -> false,
        ExprKind::Let -> false,
        ExprKind::ArrayLit -> false,
        ExprKind::StructLit -> false,
        ExprKind::EnumPath -> false,
        ExprKind::Wildcard -> false,
        ExprKind::Try -> false,
        ExprKind::Throw -> false,
        ExprKind::Closure -> false
    }
}

// static-types r8 — ArrayLit-expr probe (stage0 has no derived Eq). Mirrors
// the per-ExprKind match shape of `_types_is_index`/`_types_is_field`; only
// `ExprKind::ArrayLit` (`[e0, e1, …]` — children = elements, ast.hexa:93) is
// true. Used by the opt-in structural array-literal inference arm so every
// other STUB-bound kind keeps the byte-identical fallthrough.
fn _types_is_array_lit(k: ExprKind) -> bool {
    return match k {
        ExprKind::ArrayLit -> true,
        ExprKind::Field -> false,
        ExprKind::Index -> false,
        ExprKind::Assign -> false,
        ExprKind::LiteralInt -> false,
        ExprKind::LiteralFloat -> false,
        ExprKind::LiteralString -> false,
        ExprKind::LiteralBool -> false,
        ExprKind::LiteralChar -> false,
        ExprKind::Ident -> false,
        ExprKind::AtlasRef -> false,
        ExprKind::Call -> false,
        ExprKind::BinOp -> false,
        ExprKind::UnOp -> false,
        ExprKind::Block -> false,
        ExprKind::If -> false,
        ExprKind::While -> false,
        ExprKind::For -> false,
        ExprKind::Match -> false,
        ExprKind::Return -> false,
        ExprKind::Break -> false,
        ExprKind::Continue -> false,
        ExprKind::Let -> false,
        ExprKind::StructLit -> false,
        ExprKind::EnumPath -> false,
        ExprKind::Wildcard -> false,
        ExprKind::Try -> false,
        ExprKind::Throw -> false,
        ExprKind::Closure -> false
    }
}

// Wall A r4 — parse the element-type spelling out of a sized/unsized array
// annotation. The parser (parser.hexa:parse_type, RFC 085) encodes `[T; N]`
// as the type-name `Array:<elem>:<N>` and bare `[T]` as `Array:<elem>`;
// mirror hir_to_mir.hexa:_arru_array_type_id_from_text's split — `elem` is
// the substring after the `Array:` prefix up to the next `:` (sized) or the
// end (unsized). Returns "" for a non-array annotation (the backward-compat
// `Array:<N>` count-only form yields a non-scalar digit string the caller
// rejects), so callers conservatively skip. Self-contained (no cross-module
// import; same module-local-mirror precedent as `_types_let_type_text`),
// `.chars()`-based (no new builtin), frozen-seed-safe.
fn _types_array_elem_kind(tt: string) -> string {
    let pfx = "Array:"
    let chars = tt.chars()
    let n = len(chars)
    let pch = pfx.chars()
    let plen = len(pch)
    if n <= plen { return "" }
    let mut pi = 0
    while pi < plen {
        if chars[pi] != pch[pi] { return "" }
        pi = pi + 1
    }
    let mut elem = ""
    let mut i = plen
    while i < n {
        if chars[i] == ':' { return elem }
        elem = elem + to_string(chars[i])
        i = i + 1
    }
    return elem
}

// ── Expression type inference + checks ───────────────────────
// Returns the inferred Type of `e`. Diagnostics for sub-expressions push
// into `out` along the way (multi-error policy).

fn _infer_expr(e: Expr, env: TypeEnv, ctx: CheckCtx, out: array) -> Type {
    if _types_is_lit_int(e.kind)    { return _types_t_i64() }
    if _types_is_lit_float(e.kind)  { return _types_t_f64() }
    if _types_is_lit_string(e.kind) { return _types_t_string() }
    if _is_lit_bool(e.kind)   { return _types_t_bool() }
    if _is_lit_char(e.kind)   { return _types_t_char() }

    if _types_is_ident(e.kind) {
        // Stage1 Gap 2 — caller-module-aware lookup. Pub items are global;
        // privates are only visible inside their owning module. A foreign
        // private surface as HX2002 (private name not accessible).
        let r = _types_lookup_def(env, e.text, ctx.module)
        if r.found { return r.typ }
        if r.private_other_module {
            _emit_hx2002(e.text, r.other_module_file, ctx.module, e.span, out)
        }
        // Fall back to legacy single-namespace scan for hand-built test envs
        // that pre-date the visibility split (resolve_test / bind_test build
        // their TypeEnv directly without module attribution).
        return _types_env_lookup(env, e.text)
    }

    if _is_atlas(e.kind) {
        // Atlas refs inhabit a kind-specific opaque type; S5/S8 will refine.
        let k = e.atlas_ref.kind
        if len(k) == 0 { return _types_empty_type() }
        return Type {
            kind: "atlas_" + k,
            def: _types_miss_def_id(),
            args: [],
            ret: [],
            domain: "",
            unit: ""
        }
    }

    if _types_is_unop(e.kind) {
        if len(e.children) == 0 { return _types_empty_type() }
        let inner = _infer_expr(e.children[0], env, ctx, out)
        // Unary `-` keeps the operand's numeric type; otherwise pass through.
        if e.text == "-" && _types_is_numeric(inner) {
            return inner
        }
        return inner
    }

    if _types_is_binop(e.kind) {
        return _types_check_binop(e, env, ctx, out)
    }

    if _types_is_call(e.kind) {
        return _types_check_call(e, env, ctx, out)
    }

    if _types_is_block(e.kind) {
        let mut last = _types_t_unit()
        // Wall A r3 — block-scoped env that, under the opt-in flag, threads
        // forward the declared scalar type of each annotated `let x: T` (with
        // OR without an initializer) so a LATER `x = <expr>` assign in the
        // same block can look it up (decl/init split). `benv` starts as `env`
        // and is only ever re-bound inside the flag guard, so the default
        // build passes the identical `env` to every child — diagnostic stream
        // byte-identical → byteeq (gen3≡gen4) preserved. Same env-gate idiom
        // as the r1/r2 let-case slices.
        let mut benv = env
        let mut i = 0
        while i < len(e.children) {
            last = _infer_expr(e.children[i], benv, ctx, out)
            if _types_static_on {
                let ch = e.children[i]
                if _types_is_let(ch.kind) {
                    let nm = _types_let_name(ch.text)
                    let tt = _types_let_type_text(ch.text)
                    if len(nm) > 0 && len(tt) > 0 {
                        let tr = TypeRef { kind: "named", name: tt, args: [], span: ch.span }
                        let declared = _types_lower_type_ref(tr)
                        // Only record KNOWN scalar primitives (i8…f64 · bool ·
                        // string · char). named:/struct/enum annotations are
                        // r5+ scope — leaving them unrecorded keeps a later
                        // `x = …` assign on those types conservatively silent.
                        if _types_kind_is_scalar(declared.kind) {
                            benv = _types_env_define(benv, nm, _types_miss_def_id(), declared)
                        } else {
                            // Wall A r4 — array element-fit tracking. A
                            // `let a: [i32; N]` (or `[i32]`) is encoded by the
                            // parser as the type-name `Array:<elem>[:<N>]`
                            // (parser.hexa:parse_type). Record its KNOWN-scalar
                            // element type under a COLLISION-FREE key, `[]<name>`
                            // — an identifier can never start with `[`, so this
                            // never shadows a real ident lookup of `a` (the
                            // whole-array binding stays unrecorded, exactly as
                            // before) — so a LATER `a[i] = <expr>` index-assign
                            // (Assign arm) can recover the element type for the
                            // fit check. Only KNOWN scalar elements are kept;
                            // unknown / nested-array / struct / count-only
                            // (`Array:<N>`) elements stay r5+ → conservatively
                            // silent. Mirrors the r3 scalar-decl recording.
                            let elem = _types_array_elem_kind(tt)
                            if len(elem) > 0 && _types_kind_is_scalar(elem) {
                                benv = _types_env_define(benv, "[]" + nm, _types_miss_def_id(), _prim(elem, ""))
                            }
                            // Wall A r5 — block-local struct-var tracking. A
                            // `let s: Point` lowers to kind `named:Point`
                            // (parser.hexa annotation → _types_lower_type_ref).
                            // Record it under a COLLISION-FREE key, `{}<name>`
                            // — an identifier can never start with `{`, so this
                            // never shadows a plain ident lookup of `s` (the
                            // whole-struct binding stays unrecorded, exactly as
                            // before, mirroring r4's `[]name` discipline) — so a
                            // LATER `s.field = <expr>` field-assign (Assign arm)
                            // can recover the receiver's struct name. Params and
                            // module-level struct `let`s already carry their
                            // `named:` type in the env (bound by
                            // `_types_bind_params` / `_collect_item_types`), so
                            // the assign arm resolves those by re-inferring the
                            // receiver — this block branch only adds coverage for
                            // block-local decls. Whether it names a REAL struct
                            // is gated downstream by the field registry lookup.
                            if len(_types_struct_name_of(declared.kind)) > 0 {
                                benv = _types_env_define(benv, "{}" + nm, _types_miss_def_id(), declared)
                            }
                        }
                    }
                }
            }
            // HEXA-OWN L2 r1 — register a block-local `@own let` binding into
            // the per-fn own-lint side registry (name + live state + decl
            // line). Registration happens AFTER the child was inferred, so an
            // RHS mentioning an OUTER same-named owned binding still touches
            // the outer entry first (shadowing then takes over via the
            // newest-entry-wins scan). Entirely flag-gated — the default
            // build pushes nothing (structurally zero-cost, unlike the r5
            // registry's unconditional population). NOT threaded through
            // benv: `_types_env_lookup` is first-hit-wins, so encoding move
            // state as an env redefinition would silently read stale.
            if env("HEXA_OWN_LINT") == "1" {
                let och = e.children[i]
                if _types_is_let(och.kind) && _own_lint_has_own_ann(och) {
                    let onm = _types_let_name(och.text)
                    // r2b Copy-exemption (adapted from #4088): an `@own let`
                    // with an explicit Copy-class scalar annotation
                    // (`@own let n: i64 = …`) is never move-tracked —
                    // register-skip. A bare (unannotated) let has no type
                    // evidence and stays conservatively tracked.
                    if len(onm) > 0 && !_own_lint_name_is_copy(_types_let_type_text(och.text)) {
                        _own_lint_register(onm, och.span)
                    }
                }
            }
            // HEXA-OWN L2.5 r1 — track fn-local `let` bindings for the
            // arena-escape lint: every name enters the shadow guard (an
            // assignment to a same-named LOCAL must not warn), a composite-
            // literal RHS (array/struct literal → fn-arena-allocated on the
            // default path) additionally enters the escape-candidate
            // registry. Same placement as the @own registration above
            // (AFTER child inference → correct decl-before-use ordering);
            // flag first (short-circuit) → default build byteeq-neutral.
            if env("HEXA_ARENA_ESCAPE_LINT") == "1" {
                let ach = e.children[i]
                if _types_is_let(ach.kind) {
                    _arena_esc_register_let(ach)
                }
            }
            i = i + 1
        }
        return last
    }

    if _types_is_if(e.kind) {
        // children: [cond, then, (else)]
        if len(e.children) >= 1 {
            let cond_t = _infer_expr(e.children[0], env, ctx, out)
            // Only a KNOWN, non-unit type that isn't bool is a genuine
            // condition mismatch (`if 5 {`). An unresolved call infers
            // unit (call-checker returns _types_t_unit() when the callee
            // fn type isn't modeled — flat-splice / forward-ref), and an
            // untracked local infers empty; neither can be asserted ≠ bool.
            // Tolerate both, mirroring _types_equal's unknown contract and
            // the binop unknown-operand guard — no g3 weakening (real
            // kind≠bool mismatches still report).
            if len(cond_t.kind) > 0 && cond_t.kind != "unit" && !_is_hexaval(cond_t) && !_types_equal(cond_t, _types_t_bool()) {
                _emit_hx3001(_types_t_bool(), cond_t, e.children[0].span, out)
            }
        }
        let mut then_t = _types_t_unit()
        let mut else_t = _types_t_unit()
        if len(e.children) >= 2 {
            then_t = _infer_expr(e.children[1], env, ctx, out)
        }
        if len(e.children) >= 3 {
            else_t = _infer_expr(e.children[2], env, ctx, out)
            // _types_assignable (not bare _types_equal) for parity with
            // the return-type site (1257): keeps unknown + same-kind
            // tolerance AND adds int/float literal coercion so
            // `if c { 0i32 } else { 0 }` stops false-flagging HX3001.
            // Genuine kind≠kind non-literal mismatches still report —
            // no type-soundness weakening (g3).
            if !_types_assignable(then_t, else_t, e.children[2]) {
                // Permissive on unit: an if-expression whose arm
                // typecheck resolves an unannotated-return call to
                // `unit` should not error. Genuine non-unit
                // mismatches (`if c { 1 } else { "x" }`) still fire.
                let ku = "unit"
                if then_t.kind != ku && else_t.kind != ku {
                    _emit_hx3001(then_t, else_t, e.span, out)
                }
            }
        }
        return then_t
    }

    if _types_is_while(e.kind) {
        if len(e.children) >= 1 {
            let cond_t = _infer_expr(e.children[0], env, ctx, out)
            // Only a KNOWN, non-unit type that isn't bool is a genuine
            // condition mismatch (`if 5 {`). An unresolved call infers
            // unit (call-checker returns _types_t_unit() when the callee
            // fn type isn't modeled — flat-splice / forward-ref), and an
            // untracked local infers empty; neither can be asserted ≠ bool.
            // Tolerate both, mirroring _types_equal's unknown contract and
            // the binop unknown-operand guard — no g3 weakening (real
            // kind≠bool mismatches still report).
            if len(cond_t.kind) > 0 && cond_t.kind != "unit" && !_is_hexaval(cond_t) && !_types_equal(cond_t, _types_t_bool()) {
                _emit_hx3001(_types_t_bool(), cond_t, e.children[0].span, out)
            }
        }
        if len(e.children) >= 2 {
            // body's type discarded — while is always unit.
            let _b = _infer_expr(e.children[1], env, ctx, out)
        }
        return _types_t_unit()
    }

    if _types_is_return(e.kind) {
        // Stage1 punch list B2 — capture fn_name and fn_return into local
        // bindings BEFORE the recursive _infer_expr call. Under stage0 the
        // `out: array` is shared-mutable across the per-fn ctx frames; if
        // any sub-walk smuggles a write back into the apparently-copied
        // CheckCtx (heap aliasing in stage0's value semantics), reading
        // ctx.fn_name later could attribute this fn's HX3004 to a stale
        // frame name. Pinning the strings here makes the attribution
        // independent of shared-mutable state observed by deeper walks.
        let frame_name = ctx.fn_name
        let frame_ret = ctx.fn_return
        let mut val_t = _types_t_unit()
        let mut val_src = e
        if len(e.children) > 0 {
            val_t = _infer_expr(e.children[0], env, ctx, out)
            val_src = e.children[0]
            // HEXA-OWN L2 r2 — a bare-ident RETURN value moves the owned
            // value out of the fn (`return x` where `x` is a registered
            // `@own` binding): a return AFTER a prior move warns HX3012
            // (returning a moved-out binding), and the return itself
            // registers the move so any later use warns too. Touch AFTER
            // the child inference, same idiom as the assign-RHS site; the
            // pinned-frame HX3004 reads above/below are not reordered.
            // Flag first (short-circuit) → the default build is
            // byteeq-neutral.
            if env("HEXA_OWN_LINT") == "1" && _types_is_ident(e.children[0].kind) {
                _own_lint_touch(e.children[0], out)
            }
        }
        // Validate against enclosing fn return type. _types_assignable
        // permits the standard integer-literal coercion (e.g. `return 0`
        // for an `-> i32` fn) so the M0 baseline type-checks.
        //
        // frame_ret.kind == "unit" means the fn has no concrete declared
        // return (annotation absent → defaulted to unit, or explicit
        // void/unit). hexa (legacy-proven) allows return-type-less fns
        // that return a value — the type is inferred, not a mismatch.
        // Strict-checking those false-fired HX3004 on every
        // `fn fs_exists(path) { … return r == "1" }`-class helper.
        // Tolerate unit/void/unannotated (mirrors _types_equal's unknown
        // contract); concretely-typed returns (`-> bool` / `-> i64` …)
        // still strict-check, so real mismatches report (no g3 weakening).
        if len(frame_ret.kind) > 0 && frame_ret.kind != "unit" {
            if !_types_assignable(frame_ret, val_t, val_src) {
                _emit_hx3004(frame_name, frame_ret, val_t, e.span, out)
            }
        }
        return _types_t_unit()
    }

    if _types_is_let(e.kind) {
        // Walk RHS so any inner type errors surface.
        let mut i = 0
        while i < len(e.children) {
            let _t = _infer_expr(e.children[i], env, ctx, out)
            i = i + 1
        }
        // Wall A r1 — opt-in SOUND static type slice (HEXA_STATIC_TYPES=1).
        // Bring the Rust E0308 'mismatched types' rule that already guards
        // top-level let-ITEMS (see the per-let-item RHS check in type_check)
        // to LOCAL (in-fn-body) lets. The ENTIRE branch is env-gated, so the
        // default build skips it → diagnostic stream byte-identical → byteeq
        // (gen3≡gen4) preserved. Same structural slot + env-gate idiom as the
        // already-shipped `_exh_check_module`/`_cg_check_module` opt-in passes.
        if _types_static_on {
            // text encodes `<name>|<typename>`; require an annotation + RHS.
            let tt = _types_let_type_text(e.text)
            if len(tt) > 0 && len(e.children) > 0 {
                let rhs = e.children[0]
                // r1 arm — scalar-literal RHS (int/float/string/bool/char).
                // r2 (the `else if` below) extends to ident/call RHS; range/
                // array/struct-literal RHS remain a later rung. A literal
                // re-infer is side-effect-free (a literal pushes no
                // diagnostics), so no double-report.
                if _types_is_lit_int(rhs.kind) || _types_is_lit_float(rhs.kind) || _types_is_lit_string(rhs.kind) || _is_lit_bool(rhs.kind) || _is_lit_char(rhs.kind) {
                    let tr = TypeRef { kind: "named", name: tt, args: [], span: e.span }
                    let declared = _types_lower_type_ref(tr)
                    // Only KNOWN scalar primitives are sound comparison
                    // targets — skip `named:`/struct/enum annotations (r5+).
                    if _types_kind_is_scalar(declared.kind) {
                        let rhs_t = _infer_expr(rhs, env, ctx, out)
                        if !_types_assignable(declared, rhs_t, rhs) {
                            _emit_hx3011(declared, rhs_t, e.span, out)
                        }
                    }
                } else if _types_is_ident(rhs.kind) || _types_is_call(rhs.kind) || _types_is_index(rhs.kind) || _types_is_field(rhs.kind) {
                    // Wall A r2 — non-literal known-type RHS (ident / call).
                    // static-types r9a widens the accepted RHS kinds with
                    // Index/Field READs: their inference arms (see the
                    // pre-STUB arms in `_infer_expr`) recover the array
                    // element / declared field type, so the SAME scratch
                    // re-infer + soundness gates below reject
                    // `let s: string = xs[0]` / `let n: i64 = p.name`. On
                    // the default build those arms are env-gated off and the
                    // re-infer returns the unknown sentinel → gate ② skips
                    // (byteeq-neutral; this whole branch is already inside
                    // the HEXA_STATIC_TYPES gate).
                    // Rust E0308 'mismatched types' fires on a typed `let`
                    // whose RHS is an inferred-scalar ident/call that provably
                    // disagrees with the annotation — e.g.
                    //   `let a: i32 = 5; let b: string = a;`   // a   : i32
                    //   `fn g() -> i32 {…} let b: string = g();` // g() : i32
                    // (rustc_hir_typeck/src/expr.rs `check_expr_kind` →
                    //  `demand_coerce` → `FnCtxt::report_mismatched_types`,
                    //  the SAME E0308 path the literal arm already mirrors).
                    let tr = TypeRef { kind: "named", name: tt, args: [], span: e.span }
                    let declared = _types_lower_type_ref(tr)
                    // r2 soundness gate ① — declared side must be a KNOWN
                    // scalar primitive (named:/struct/enum stay r5+).
                    if _types_kind_is_scalar(declared.kind) {
                        // The children-walk above already inferred `rhs` once
                        // (any inner errors surfaced into `out`). Re-infer into
                        // a SCRATCH sink so this check appends NOTHING extra —
                        // no double-report of a call's inner HX2001/HX3003.
                        let mut scratch: array = []
                        let rhs_t = _infer_expr(rhs, env, ctx, scratch)
                        // r2 soundness gate ② — only flag when the INFERRED
                        // RHS is itself a KNOWN scalar primitive. The
                        // inferencer's fallbacks for un-resolved idents (empty
                        // kind), un-annotated fn returns / un-modeled callees
                        // (`unit`), HexaVal dynamics, and aggregate types are
                        // all NON-scalar here → conservatively skipped (r5+),
                        // so no false REJECT on anything unknown.
                        if _types_kind_is_scalar(rhs_t.kind) {
                            if !_types_assignable(declared, rhs_t, rhs) {
                                _emit_hx3011(declared, rhs_t, e.span, out)
                            }
                        }
                    }
                }
            }
        }
        // HEXA-OWN L2 r1 — a bare-ident RHS of a `let` MOVES the owned value
        // (`let y = x` where `x` is a registered `@own` binding): first such
        // use marks it moved, a second one warns HX3012 (use-after-move).
        // Flag first (short-circuit) → the default build is byteeq-neutral.
        if env("HEXA_OWN_LINT") == "1" && len(e.children) > 0 && _types_is_ident(e.children[0].kind) {
            _own_lint_touch(e.children[0], out)
        }
        return _types_t_unit()
    }

    if _types_is_assign(e.kind) {
        if len(e.children) >= 2 {
            let lhs_t = _infer_expr(e.children[0], env, ctx, out)
            let rhs_t = _infer_expr(e.children[1], env, ctx, out)
            // Wall A r3 — opt-in decl/init-split REJECT (HEXA_STATIC_TYPES=1).
            // A `let x: T` (no initializer) recorded its declared scalar T into
            // the block-scoped env (see the Block case); a later `x = <expr>`
            // whose inferred scalar RHS provably disagrees with T REJECTs with
            // HX3011 — the Rust E0308 'mismatched types' path for assignment:
            // rustc_hir_typeck/src/expr.rs `check_expr_assign` →
            // `demand_coerce_diag` → `FnCtxt::report_mismatched_types` (the
            // SAME E0308 emitter the r1/r2 let-arms mirror). Soundness gates,
            // identical to r1/r2: fire only when BOTH the declared LHS and the
            // inferred RHS are KNOWN scalar primitives; unknown idents (empty
            // kind), unit, HexaVal, and aggregates are conservatively skipped
            // (r5+). The whole arm is env-gated → the default build is byte-
            // identical (byteeq-neutral). When it fires it SUPPRESSES the
            // generic HX3001 below (`r3_rejected`) so one mistake = one error.
            let mut r3_rejected = false
            if _types_static_on {
                if _types_is_ident(e.children[0].kind) && _types_kind_is_scalar(lhs_t.kind) && _types_kind_is_scalar(rhs_t.kind) {
                    if !_types_assignable(lhs_t, rhs_t, e.children[1]) {
                        _emit_hx3011(lhs_t, rhs_t, e.span, out)
                        r3_rejected = true
                    }
                } else if _types_is_index(e.children[0].kind) && len(e.children[0].children) > 0 {
                    // Wall A r4 — array element-fit assign REJECT. The LHS is an
                    // `a[i]` subscript (Index: children[0]=base, children[1]=
                    // index, parser.hexa:753). When the base is a plain ident
                    // whose declared array element type was recorded by the
                    // Block case (key `[]<name>`), and BOTH that element type
                    // and the inferred RHS are KNOWN scalars that provably
                    // disagree, REJECT with HX3011 — the Rust E0308 index-place
                    // coercion path: rustc_hir_typeck/src/expr.rs
                    // `check_expr_index` (place expr) → assignment
                    // `demand_coerce` → `FnCtxt::report_mismatched_types` (the
                    // SAME E0308 emitter the r1/r2/r3 arms mirror). Note `lhs_t`
                    // from `_infer_expr` on an Index is the Field/Index STUB-v1
                    // unknown (`_types_empty_type()`), so the element type comes
                    // from the recorded `[]<name>` env entry — NOT lhs_t.
                    // int/float-literal RHS still coerces (`_types_assignable`
                    // sees `e.children[1]`), matching the r1/r3 ergonomics; an
                    // unrecorded base (unknown/aggregate element) stays r5+
                    // silent. Suppresses the generic HX3001 (`r3_rejected`).
                    let base = e.children[0].children[0]
                    if _types_is_ident(base.kind) && len(base.text) > 0 {
                        let elem_t = _types_env_lookup(env, "[]" + base.text)
                        if _types_kind_is_scalar(elem_t.kind) && _types_kind_is_scalar(rhs_t.kind) {
                            if !_types_assignable(elem_t, rhs_t, e.children[1]) {
                                _emit_hx3011(elem_t, rhs_t, e.span, out)
                                r3_rejected = true
                            }
                        } else if _types_array_lower_on && !_types_kind_is_scalar(elem_t.kind) {
                            // static-types r8b — param / module-let array base
                            // fallback. The `[]<name>` record above only exists
                            // for BLOCK-LOCAL annotated lets (Block-arm r4
                            // recording); an array-typed fn PARAM (`fn f(xs:
                            // [i64]) { xs[0] = "s" }`) or module-level let has
                            // no record, so r4 stayed silent there. Under the
                            // ARRAY_LOWER flag the param DOES carry a
                            // structured Type{kind:"array", args:[elem]} in the
                            // env (`_types_bind_params` → the r7-prep
                            // `_types_lower_type_ref` branch) — recover it by
                            // re-inferring the base ident into a SCRATCH sink
                            // (no double-report; the r5 receiver idiom) and
                            // fit-check `args[0]` against the RHS: the SAME
                            // Rust E0308 index-place coercion path as the
                            // recorded r4 case above. kind:"array" is only
                            // ever produced flag-ON (see _types_equal note),
                            // and the flag check is the FIRST `&&` operand, so
                            // the default build never enters — byteeq-neutral.
                            // int/float-literal RHS still coerces; a missing/
                            // non-scalar element (nested arrays) stays silent.
                            // The recorded block-local path above is UNTOUCHED
                            // in both modes (it lowers via the kind:"named"
                            // annotation-text route, never kind:"array").
                            let mut bscratch: array = []
                            let base_t = _infer_expr(base, env, ctx, bscratch)
                            if base_t.kind == "array" && len(base_t.args) > 0 {
                                if _types_kind_is_scalar(base_t.args[0].kind) && _types_kind_is_scalar(rhs_t.kind) {
                                    if !_types_assignable(base_t.args[0], rhs_t, e.children[1]) {
                                        _emit_hx3011(base_t.args[0], rhs_t, e.span, out)
                                        r3_rejected = true
                                    }
                                }
                            }
                        }
                    }
                } else if _types_is_field(e.children[0].kind) && len(e.children[0].children) > 0 {
                    // Wall A r5 — struct field-type assign REJECT. The LHS is a
                    // `s.field` access (Field: text=field name, children[0]=
                    // receiver, parser.hexa:715). When the receiver is a plain
                    // ident of a KNOWN struct type, the registered declared type
                    // of `field` (side registry, since the env's struct Type
                    // drops field names) and the inferred RHS are BOTH known
                    // scalars that provably disagree, REJECT with HX3011 — the
                    // Rust E0308 field-place coercion path:
                    // rustc_hir_typeck/src/expr.rs `check_field` /
                    // `check_expr_assign` → `demand_coerce` →
                    // `FnCtxt::report_mismatched_types` (the SAME E0308 emitter
                    // the r1/r2/r3/r4 arms mirror). `lhs_t` from `_infer_expr`
                    // on a Field is the STUB-v1 unknown, so the field type comes
                    // from the registry — NOT lhs_t. The receiver's struct name
                    // is recovered two ways: a block-local `let s: Point` is in
                    // the `{}name` env slot; a param / module-let struct var
                    // carries its `named:Point` type directly, recovered by
                    // re-inferring the receiver into a SCRATCH sink (no double-
                    // report). int/float-literal RHS still coerces; an unknown
                    // receiver, non-struct field, or non-scalar field stays r6+
                    // silent. Suppresses the generic HX3001 (`r3_rejected`).
                    let fnode = e.children[0]
                    let recv = fnode.children[0]
                    if _types_is_ident(recv.kind) && len(recv.text) > 0 && len(fnode.text) > 0 {
                        let mut sname = ""
                        let blk = _types_env_lookup(env, "{}" + recv.text)
                        sname = _types_struct_name_of(blk.kind)
                        if len(sname) == 0 {
                            let mut rscratch: array = []
                            let recv_t = _infer_expr(recv, env, ctx, rscratch)
                            sname = _types_struct_name_of(recv_t.kind)
                        }
                        if len(sname) > 0 {
                            let lk = _types_lookup_struct_field_typename(sname, fnode.text)
                            if lk.found && len(lk.field_typename) > 0 {
                                let ftr = TypeRef { kind: "named", name: lk.field_typename, args: [], span: fnode.span }
                                let field_t = _types_lower_type_ref(ftr)
                                if _types_kind_is_scalar(field_t.kind) && _types_kind_is_scalar(rhs_t.kind) {
                                    if !_types_assignable(field_t, rhs_t, e.children[1]) {
                                        _emit_hx3011(field_t, rhs_t, e.span, out)
                                        r3_rejected = true
                                    }
                                }
                            }
                        }
                    }
                }
            }
            // _types_assignable (not bare _types_equal) — parity with
            // the return-type site: `x: i32 = 0` (rhs lit i64) and
            // unknown-side cases stop false-flagging HX3001; genuine
            // kind≠kind non-literal mismatches still report (g3 intact).
            if !r3_rejected && !_types_assignable(lhs_t, rhs_t, e.children[1]) {
                _emit_hx3001(lhs_t, rhs_t, e.span, out)
            }
            // HEXA-OWN L2 r1 — a bare-ident RHS of an assignment MOVES the
            // owned value (`y = x` where `x` is a registered `@own` binding):
            // second use after the move warns HX3012. Flag first
            // (short-circuit) → the default build is byteeq-neutral.
            if env("HEXA_OWN_LINT") == "1" && _types_is_ident(e.children[1].kind) {
                _own_lint_touch(e.children[1], out)
            }
            // HEXA-OWN L2.5 r1 Rule B — arena-escape into a module global
            // (HX3013). `g = x` where `g` is a module-level `let` item (and
            // NOT shadowed by a fn-local let) and `x` is a fn-local binding
            // whose RHS was a composite literal: the composite lives in the
            // fn's arena, `__hexa_fn_arena_return` heapifies only the RETURN
            // value (self/runtime_core.c:4605), so after scope_pop the
            // global holds reclaimed arena memory — the runtime-admitted
            // unheapified escape (runtime_core.c:3432). Warning-band, flag
            // first (short-circuit) → default build byteeq-neutral.
            if env("HEXA_ARENA_ESCAPE_LINT") == "1" && _types_is_ident(e.children[0].kind) && _types_is_ident(e.children[1].kind) {
                let gnm = e.children[0].text
                if _arena_esc_name_in(_arena_esc_globals, gnm) && !_arena_esc_name_in(_arena_esc_locals, gnm) {
                    let ai = _arena_esc_find(e.children[1].text)
                    if ai >= 0 {
                        _emit_hx3013(e.children[1].text, gnm, _arena_esc_def_lines[ai], e.span, out)
                    }
                }
            }
        }
        return _types_t_unit()
    }

    if _is_match_expr(e.kind) {
        return _check_match(e, env, ctx, out)
    }

    if _types_is_closure(e.kind) {
        // RFC C1 — closure-expression. children = [param_0..param_{n-1},
        // body_block]; e.text = decimal param count. The param children are
        // Ident nodes carrying NAMES, not free-variable references — they
        // must NOT be _infer_expr'd (that would HX2002/lookup-fail on the
        // param name). Bind (compiler/check/bind.hexa) is the pass that
        // scopes param names into the body; here we only walk the body to
        // surface inner type errors, then hand back a `fn` type so callers
        // (e.g. `f(21)` where `let f = fn(x){...}`) see a function value.
        //
        // C1 type representation: a bare `fn`-kinded Type with empty
        // args/ret. The tier-1 type system has no per-param / return-type
        // closure inference yet — that is C2 scope. `fn` with empty
        // args/ret is the narrowest representation that (a) reuses the
        // existing `t.kind == "fn"` callee check at _types_check_call, so a
        // closure call is not mis-flagged as "calling a non-fn", and (b)
        // carries no false param/return type claims.
        // body block is the LAST child (children[param_count]); no need to
        // parse e.text — use len-1 directly.
        if len(e.children) > 0 {
            let _bt = _infer_expr(e.children[len(e.children) - 1], env, ctx, out)
        }
        return Type {
            kind: "fn",
            def: _types_miss_def_id(),
            args: [],
            ret: [],
            domain: "",
            unit: ""
        }
    }

    // RFC-074 Phase 2.1 — EnumPath construction site per-slot element-type
    // check. Probe the per-module registry built by `_collect_item_types`;
    // on a hit, compare the inferred type of each `children[i]` to the
    // declared display string for slot i. Skip silently when:
    //   - HX2004 (bind-side arity) would already have fired (arity mismatch
    //     leaves the slot indices ambiguous; we don't speculate types onto
    //     missing or extra slots);
    //   - the enum / variant is unknown to this module's registry (HX2001
    //     covers the head miss; we don't double-emit).
    // We still walk every child for inner-error surfacing, matching the
    // legacy STUB-v1 traversal contract.
    if _types_is_enum_path_kind(e.kind) {
        let head = _types_enum_path_head(e.text)
        let tail = _types_enum_path_tail(e.text)
        let mut do_slot_check = false
        let mut slots: [string] = []
        if len(head) > 0 && len(tail) > 0 {
            let lk = _types_lookup_variant_payload_types(head, tail)
            if lk.found && len(lk.payload_types) == len(e.children) {
                do_slot_check = true
                slots = lk.payload_types
            }
        }
        let mut ei = 0
        while ei < len(e.children) {
            let ct = _infer_expr(e.children[ei], env, ctx, out)
            if do_slot_check {
                let expected = slots[ei]
                let actual = _type_display(ct)
                // Tolerate unknowns on either side — registry holds
                // `<unknown>` for malformed TypeRefs and `_type_display`
                // returns the same for empty inferred types. Mirrors
                // `_types_equal`'s tolerate-on-unknown contract so a
                // STUB-v1 receiver doesn't false-fire HX2005.
                if expected != "<unknown>" && actual != "<unknown>"
                    && expected != actual {
                    _emit_hx2005(head, tail, ei, expected, actual,
                        e.children[ei].span, out)
                }
            }
            ei = ei + 1
        }
        return _types_empty_type()
    }

    // Wall A r6 — opt-in struct-literal field-init REJECT (HEXA_STATIC_TYPES=1).
    // The LAST scope-wireable rung of the static-type ladder. A struct literal
    // `Point{ x: <expr>, y: <expr> }` parses (parser.hexa:1184
    // parse_struct_lit_after_name) as a StructLit whose `text` is the struct
    // NAME and whose `children` are per-field-init Ident nodes — each with
    // `text`=field NAME and `children[0]`=the field VALUE expr. Reuse the r5
    // (struct,field)→declared-typename side registry (the env's struct Type
    // keeps field types but DROPS field names, so the registry is the only
    // carrier): for each field-init whose declared field type AND inferred
    // value type are BOTH known scalars that provably disagree, REJECT with
    // HX3011 — the SAME Rust E0308 "mismatched types" path the r1/r2/r3/r4/r5
    // arms mirror (rustc_hir_typeck check_expr_struct_fields → demand_coerce →
    // report_mismatched_types). int/float-literal values still coerce (via
    // `_types_assignable`'s literal-coercion arm, `src`=the value expr); an
    // unknown struct, unknown field, or non-scalar field type stays silent
    // (field-existence / nominal-field diagnostics are separate, not r6 scope).
    //
    // ENTIRELY flag-gated (env check is the FIRST `&&` operand, short-circuit)
    // so the default build falls through to the byte-identical STUB below —
    // byteeq / gen3≡gen4 preserved. The flag-ON path infers each value expr
    // (which the legacy STUB's per-Ident walk did NOT reach, since the Ident
    // arm returns before recursing into children[0]) so inner value errors are
    // ALSO surfaced under the flag.
    if _types_static_on && _cg_is_struct_lit(e.kind) {
        let sname = e.text
        let mut fi = 0
        while fi < len(e.children) {
            let finit = e.children[fi]
            if _types_is_ident(finit.kind) && len(finit.text) > 0 && len(finit.children) > 0 {
                let val = finit.children[0]
                let val_t = _infer_expr(val, env, ctx, out)
                if len(sname) > 0 {
                    let lk = _types_lookup_struct_field_typename(sname, finit.text)
                    if lk.found && len(lk.field_typename) > 0 {
                        let ftr = TypeRef { kind: "named", name: lk.field_typename, args: [], span: finit.span }
                        let field_t = _types_lower_type_ref(ftr)
                        if _types_kind_is_scalar(field_t.kind) && _types_kind_is_scalar(val_t.kind) {
                            if !_types_assignable(field_t, val_t, val) {
                                _emit_hx3011(field_t, val_t, val.span, out)
                            }
                        }
                    } else {
                        // static-types r9d — field-EXISTENCE reject (the piece
                        // r6 deliberately scoped out above). `found=false` is
                        // ambiguous: struct unknown to the r5 registry (cross-
                        // module receiver → stay SILENT, unknown-fallback) vs
                        // struct KNOWN but no such field → HX3016 (Rust E0560
                        // "struct has no field named", rustc_hir_typeck
                        // check_expr_struct_fields → report_unknown_field). A
                        // found field with a non-named type spelling
                        // (field_typename == "") EXISTS — no diagnostic, the
                        // r6 fit check just skips it (unchanged). Missing-
                        // REQUIRED-fields (E0063) is a separate warning-band
                        // follow-on, not r9d scope. Same flag gate as the
                        // whole arm → default build byte-identical.
                        if !lk.found && _types_struct_registry_has(sname) {
                            _emit_hx3014(sname, finit.text, finit.span, out)
                        }
                    }
                }
            } else {
                let _t = _infer_expr(finit, env, ctx, out)
            }
            fi = fi + 1
        }
        // static-types r11 — MISSING-required-field WARNING (Rust E0063,
        // HX3017), the PAIR of the r9d HX3016 existence reject above. The
        // provided-field loop caught PRESENT fields the struct doesn't declare;
        // this catches DECLARED fields the literal omits. Only for a struct
        // KNOWN to the r5/r9d registry (unknown struct → SILENT, the same
        // conservative unknown-fallback as HX3016). WARNING band, not REJECT
        // (SSOT F4 warn-first) — the build still compiles. Same flag gate as
        // the whole arm → default build byte-identical (byteeq-neutral).
        if len(sname) > 0 && _types_struct_registry_has(sname) {
            _types_emit_missing_required(sname, e, out)
        }
        return _types_empty_type()
    }

    // static-types r8 — OPT-IN structural array-literal inference
    // (HEXA_STATIC_TYPES=1 AND HEXA_STATIC_TYPES_ARRAY_LOWER=1). An ArrayLit
    // has NO inference arm today: it falls to the STUB below and returns the
    // unknown sentinel, which `_types_equal` tolerates — so a literal array
    // ARGUMENT `g([1.5])` against `fn g(xs: [i64])` passed SILENTLY in both
    // modes, even though the ident-arg equivalent already REJECTs via the
    // default-ON HX3003 call-arg check (r7-prep #4457 proved that for
    // `g(ys)`). Infer the literal structurally instead: walk EVERY element
    // (preserving the STUB's inner-error surfacing — each child is inferred
    // exactly once into `out`, same as the fallthrough), and when all
    // elements infer to the SAME known scalar kind, return the structured
    // Type{kind:"array", args:[elem]} — the same shape the r7-prep lowering
    // gives the callee's declared param, so the EXISTING HX3003 site
    // (`_types_equal`'s array element recursion) does the reject with ZERO
    // changes there (Rust E0308: rustc_hir_typeck check_argument_types →
    // demand_coerce → report_mismatched_types, the coercion path the r1-r6
    // arms mirror). Empty `[]` (no element evidence), mixed, nested, or
    // non-scalar elements degrade to the unknown sentinel — conservative,
    // mirrors the r2 soundness gates; kind:"array" with NO args would render
    // as bare `array` in diagnostics. Both env checks are the FIRST `&&`
    // operands (short-circuit) → the default build takes the byte-identical
    // STUB path below (byteeq / gen3≡gen4 preserved, r1-r6 gate idiom).
    if _types_static_on && _types_array_lower_on && _types_is_array_lit(e.kind) {
        let mut elem_t = _types_empty_type()
        let mut uniform = true
        let mut ai = 0
        while ai < len(e.children) {
            let ct = _infer_expr(e.children[ai], env, ctx, out)
            if !_types_kind_is_scalar(ct.kind) {
                uniform = false
            } else if len(elem_t.kind) == 0 {
                elem_t = ct
            } else if ct.kind != elem_t.kind {
                uniform = false
            }
            ai = ai + 1
        }
        if uniform && len(elem_t.kind) > 0 {
            let mut elem_args: [Type] = []
            elem_args.push(elem_t)
            return Type {
                kind: "array",
                def: _types_miss_def_id(),
                args: elem_args,
                ret: [],
                domain: "",
                unit: ""
            }
        }
        return _types_empty_type()
    }

    // static-types r9a — OPT-IN Index READ inference (HEXA_STATIC_TYPES=1
    // AND HEXA_STATIC_TYPES_ARRAY_LOWER=1; element types only exist under
    // the r7-prep structured lowering). An Index READ (`xs[0]`,
    // children[0]=base, children[1]=index, parser.hexa:753) has NO inference
    // arm: it falls to the STUB below and returns the unknown sentinel, so
    // `let s: string = xs[0]` with `xs: [i64]` passed SILENTLY in both
    // modes. Infer the BASE instead: under ARRAY_LOWER a param / ArrayLit /
    // lowered-let base carries the structured Type{kind:"array",
    // args:[elem]}, so the element type is args[0] — returned as this
    // READ's type. NO new diagnostic site — the recovered element feeds the
    // EXISTING r1/r2 let checks, the r3 assign check, and the default-ON
    // HX3003/HX3004/HX3005 sites (Rust E0308: rustc_hir_typeck
    // check_expr_index resolves the element ty as the expression type; the
    // coercion sites the r1-r8 arms mirror do the reject). Every child is
    // inferred exactly once into `out` — STUB walk parity, inner errors
    // still surface, nothing double-reports. A non-array base (flag-OFF
    // string sentinel shape, unknown ident, nested unknown) or a missing
    // element degrades to the unknown sentinel — conservative, mirrors the
    // r2 soundness gates. Both env checks are the FIRST `&&` operands
    // (short-circuit) → the default build takes the byte-identical STUB
    // path below (byteeq / gen3≡gen4 preserved, r1-r8 gate idiom).
    if _types_static_on && _types_array_lower_on && _types_is_index(e.kind) {
        let mut base_t = _types_empty_type()
        let mut xi = 0
        while xi < len(e.children) {
            let ct = _infer_expr(e.children[xi], env, ctx, out)
            if xi == 0 { base_t = ct }
            xi = xi + 1
        }
        if base_t.kind == "array" && len(base_t.args) > 0 {
            return base_t.args[0]
        }
        return _types_empty_type()
    }

    // static-types r9a — OPT-IN Field READ inference (HEXA_STATIC_TYPES=1;
    // no ARRAY_LOWER needed — the field type comes from the r5 side
    // registry, not the structured array lowering). A Field READ (`p.x`,
    // text=field name, children[0]=receiver, parser.hexa:715) also falls to
    // the STUB and returns unknown, so `let n: i64 = p.name` with
    // `name: string` passed SILENTLY. Recover the declared field type via
    // the r5 (struct,field)→typename registry (the SAME registry the r5
    // assign arm and the r6 struct-lit arm already consume), with the r5
    // two-way receiver recovery: block-local `let s: Point` from the
    // `{}<name>` env slot, else the receiver's own `named:<Struct>` type
    // (params / module-lets). NO new diagnostic site — the field type feeds
    // the same downstream checks as the Index arm above (Rust E0308:
    // rustc_hir_typeck check_field resolves the field ty as the expression
    // type). Every child is inferred exactly once into `out` (STUB walk
    // parity). Conservative fallbacks keep it silent: a non-Ident receiver
    // (nested `s.inner.x` — the documented r7+ type-erasure ceiling), an
    // unknown struct/field, and a non-named or non-scalar field type (the
    // registry stores "" for non-named; `named:<Struct>` fields fail the
    // scalar gate) all return the unknown sentinel. A field name colliding
    // with the codegen method-builtin set (`_is_builtin_method` — `s.len`,
    // `s.count`, …) is ALSO skipped: `recv.<m>(…)` is dispatched on the
    // receiver by codegen, so returning a field type for that callee would
    // false-fire HX2003 "not callable" on a legal builtin-method call (a
    // flag-ON false-positive class — flip-blocking, §B F0). Flag check is
    // the FIRST `&&` operand (short-circuit) → the default build takes the
    // byte-identical STUB path below.
    if _types_static_on && _types_is_field(e.kind) && len(e.children) > 0 {
        let mut recv_t = _types_empty_type()
        let mut wi = 0
        while wi < len(e.children) {
            let ct = _infer_expr(e.children[wi], env, ctx, out)
            if wi == 0 { recv_t = ct }
            wi = wi + 1
        }
        let recv = e.children[0]
        if _types_is_ident(recv.kind) && len(recv.text) > 0 && len(e.text) > 0 && !_is_builtin_method(e.text) {
            let mut sname = ""
            let blk = _types_env_lookup(env, "{}" + recv.text)
            sname = _types_struct_name_of(blk.kind)
            if len(sname) == 0 {
                sname = _types_struct_name_of(recv_t.kind)
            }
            if len(sname) > 0 {
                let lk = _types_lookup_struct_field_typename(sname, e.text)
                if lk.found && len(lk.field_typename) > 0 {
                    let ftr = TypeRef { kind: "named", name: lk.field_typename, args: [], span: e.span }
                    let field_t = _types_lower_type_ref(ftr)
                    if _types_kind_is_scalar(field_t.kind) {
                        return field_t
                    }
                }
            }
        }
        return _types_empty_type()
    }

    // Field / Index / StructLit / Wildcard — STUB v1.
    // Walk children for inner errors; return unknown so outer sites that
    // gate on equality tolerate (per _types_equal).
    let mut i = 0
    while i < len(e.children) {
        let _t = _infer_expr(e.children[i], env, ctx, out)
        i = i + 1
    }
    return _types_empty_type()
}

// ── BinOp checker ────────────────────────────────────────────

fn _is_arith_op(op: string) -> bool {
    if op == "+" { return true }
    if op == "-" { return true }
    if op == "*" { return true }
    if op == "/" { return true }
    if op == "%" { return true }
    return false
}

fn _types_is_compare_op(op: string) -> bool {
    if op == "==" { return true }
    if op == "!=" { return true }
    if op == "<"  { return true }
    if op == "<=" { return true }
    if op == ">"  { return true }
    if op == ">=" { return true }
    return false
}

fn _types_check_binop(e: Expr, env: TypeEnv, ctx: CheckCtx, out: array) -> Type {
    if len(e.children) < 2 { return _types_empty_type() }
    let op = e.text

    // as-cast `x as T`: the expression's type IS the named target type. The
    // right child is an Ident carrying the type name (STEP1 parses it that way).
    // Resolve it BEFORE inferring the operands — the type Ident isn't a value,
    // so _infer_expr on it is meaningless. Without this the BinOp fell through
    // to the `return lt` tail = the casted value's type, mis-typing
    // `(v + 0.5) as int` as f64 and false-firing HX3004 (e.g. rt_round).
    if op == "as" {
        return _types_lower_type_ref(TypeRef { kind: "named", name: e.children[1].text, args: [], span: e.children[1].span })
    }

    let lt = _infer_expr(e.children[0], env, ctx, out)
    let rt = _infer_expr(e.children[1], env, ctx, out)

    // Unknown operand type — local-var typing is a v1 stub, so an Ident
    // operand frequently infers an empty Type. _types_equal already
    // encodes "either side unknown → tolerate"; the arith branch's
    // _types_is_numeric gate does NOT (empty kind → not numeric →
    // unconditional mismatch emit). Apply the same tolerance here, before
    // the numeric gate, so `pos = pos + 1`-class lines don't false-fire
    // HX3001 (this was the dominant stage-2 self-compile residual, ~1452).
    if len(lt.kind) == 0 || len(rt.kind) == 0 {
        // A comparison yields bool regardless of operand types — returning
        // an operand type here mis-types `if c == '0'` (untyped param c
        // infers empty) as char/i64/string, which then false-fires
        // HX3001 `expected bool, got <X>` at the enclosing if/while
        // condition (the bool/i64=405 + bool/string=304 + bool/char=132
        // residual). Arith keeps the known operand's numeric type.
        if _types_is_compare_op(op) { return _types_t_bool() }
        if len(lt.kind) > 0 { return lt }
        return rt
    }

    if _is_arith_op(op) {
        // String concatenation: `+` with a string operand yields a string
        // (the legacy runtime hexa_add stringifies the other side). Without
        // this, `dir + "/" + rel` and `"x=" + to_string(n)` fall through
        // the numeric gate to the non-numeric mismatch emit and false-fire
        // HX3001 `expected string, got string` (the 205 residual).
        if op == "+" && (lt.kind == "string" || rt.kind == "string") {
            return _types_t_string()
        }
        // Both sides numeric. Mixed int/float is a LEGAL implicit widening
        // — tier-2 (self/runtime.c hexa_add/sub/mul) dispatches the mixed
        // case to `hexa_float(__hx_to_double(a) OP __hx_to_double(b))`,
        // i.e. int operand is widened to f64 and the result is f64. Match
        // that policy EXACTLY here: int OP int → int, float OP float →
        // float, mixed int/float → float (no HX3001). Only genuine
        // non-coercible numeric mismatches still raise HX3001.
        if _types_is_numeric(lt) && _types_is_numeric(rt) {
            let mixed_int_float =
                (_is_integer_kind(lt) && _is_float_kind(rt)) ||
                (_is_float_kind(lt) && _is_integer_kind(rt))
            if !_types_equal(lt, rt) && !mixed_int_float {
                _emit_hx3001(lt, rt, e.span, out)
            }
            // S4: integer / integer narrows the ℝ domain → HX4001 (Warning).
            if op == "/" && _is_integer_kind(lt) && _is_integer_kind(rt) {
                _emit_hx4001(e.span, out)
            }
            // Mixed int/float yields f64 (int operand widened, per tier-2's
            // __hx_to_double path) so the inferred type propagates correctly
            // into the enclosing let/return/arg context.
            if mixed_int_float { return _types_t_f64() }
            return lt
        }
        // Mismatch (one or both non-numeric) — treat as type-mismatch with
        // the LHS as the reference shape; emit once. Permissive on unit:
        // when an unannotated `fn f(x) { … return X }` resolves to `unit`,
        // arith between two such calls (`abs(a*b) / gcd(a,b)`) hits this
        // branch with (unit, unit); the runtime hexa_div dispatches on
        // HexaVal tag regardless, so the HX3001 was tighter than runtime
        // correctness needs.
        let ku = "unit"
        if lt.kind != ku && rt.kind != ku {
            _emit_hx3001(lt, rt, e.span, out)
        }
        return lt
    }

    if _types_is_compare_op(op) {
        if !_types_equal(lt, rt) {
            // Permissive: when one side is `unit` (the placeholder for
            // a fn return-type the inferencer couldn't pin — typically
            // an unannotated `fn f(x) { if … { return X }; return Y }`
            // whose RHS resolves before its return paths), allow the
            // compare. The codegen runs the runtime hexa_eq/lt/le/…
            // which handles HexaVal-tag dispatch regardless, so the
            // HX3001 was strictly stricter than the runtime needs and
            // blocked `is_leap(year) == 1` style guards across the
            // corpus.
            let ku = "unit"
            if lt.kind != ku && rt.kind != ku {
                _emit_hx3001(lt, rt, e.span, out)
            }
        }
        return _types_t_bool()
    }

    // Unknown operator — fall back to LHS type.
    return lt
}

// Builtin method-style names dispatched on the receiver, not free
// identifiers. Faithfully mirrored from the proven legacy receiver
// dispatch self/codegen_c2.hexa::gen2_method_builtin (31 names). When the
// call's callee is `Field{text:<m>}` with <m> in this set, the method is
// resolved by codegen against the receiver — types must NOT treat the
// selector as an unresolved free name (that was the stage-2 self-compile
// `.push(...)`-class HX2001 flood, ~870 of 1307).
fn _is_builtin_method(name: string) -> bool {
    // R5 CGFAIL triage — full method-builtin set mirrored from the proven
    // legacy receiver dispatch self/codegen_c2.hexa::gen2_method_builtin
    // (90 names). The prior list had only 31; the missing ~59 (notably
    // `find`/`count`/`map`/`filter`/`fold`/`lines`/`slice`/… ) surfaced
    // as HX2001 callee-misses when used in `recv.<m>(…)` form — the
    // repo_taxonomy_audit `ln.find("]")` CGFAIL class.
    return match name {
        "push" -> true, "append" -> true, "len" -> true, "chars" -> true,
        "contains" -> true, "join" -> true, "to_upper" -> true, "to_lower" -> true,
        "split" -> true, "trim" -> true, "replace" -> true, "repeat" -> true,
        "starts_with" -> true, "ends_with" -> true, "substring" -> true,
        "index_of" -> true, "rfind" -> true, "last_index_of" -> true,
        "char_code_at" -> true,
        "keys" -> true, "values" -> true, "contains_key" -> true,
        "has_key" -> true, "has" -> true, "remove" -> true, "get" -> true,
        "set" -> true, "pop" -> true, "shift" -> true, "reverse" -> true,
        "sort" -> true, "sort_by" -> true,
        "all" -> true, "any" -> true, "byte_at" -> true, "bytes" -> true,
        "center" -> true, "char_at" -> true, "chunk" -> true, "count" -> true,
        "drop" -> true, "entries" -> true, "enumerate" -> true, "fill" -> true,
        "filter" -> true, "filter_keys" -> true, "find" -> true,
        "flat_map" -> true, "flatten" -> true, "fold" -> true,
        "for_each" -> true, "frequencies" -> true, "from_array" -> true,
        "group_by" -> true, "interleave" -> true, "invert" -> true,
        "is_empty" -> true, "lines" -> true, "map" -> true,
        "map_values" -> true, "max" -> true, "mean" -> true, "merge" -> true,
        "min" -> true, "pad_end" -> true, "pad_left" -> true,
        "pad_right" -> true, "pad_start" -> true, "parse_float" -> true,
        "parse_int" -> true, "partition" -> true, "product" -> true,
        "push_nostat" -> true, "rotate" -> true, "sample" -> true,
        "scan" -> true, "slice" -> true, "slice_fast" -> true,
        "substr" -> true, "sum" -> true, "swap" -> true, "take" -> true,
        "to_array" -> true, "to_bool" -> true, "to_float" -> true,
        "to_int" -> true, "to_string" -> true, "trim_end" -> true,
        "trim_start" -> true, "truncate" -> true, "unique" -> true,
        "window" -> true, "zip" -> true,
        _ -> false,
    }
}

// ── Call checker ─────────────────────────────────────────────

fn _types_check_call(e: Expr, env: TypeEnv, ctx: CheckCtx, out: array) -> Type {
    if len(e.children) == 0 { return _types_empty_type() }
    let callee = e.children[0]
    let callee_t = _infer_expr(callee, env, ctx, out)
    let arg_count = len(e.children) - 1

    // Best-effort callee name for diagnostics.
    let mut name = "<callee>"
    if _types_is_ident(callee.kind) && len(callee.text) > 0 { name = callee.text }
    else if callee.kind == ExprKind::Field && len(callee.text) > 0 { name = callee.text }

    // Walk args first so inner errors surface even when callee resolution fails.
    let mut arg_types: [Type] = []
    let mut i = 0
    while i < arg_count {
        let at = _infer_expr(e.children[1 + i], env, ctx, out)
        arg_types.push(at)
        // HEXA-OWN L2 r1 — a bare-ident call ARGUMENT moves the owned value
        // (`f(x)` where `x` is a registered `@own` binding): second use after
        // the move warns HX3012. A scratch-sink re-infer of the same call
        // (the r2 let-arm) re-touches the SAME node — the registry's
        // move-site span dedupe keeps that silent. Flag first
        // (short-circuit) → the default build is byteeq-neutral.
        if env("HEXA_OWN_LINT") == "1" && _types_is_ident(e.children[1 + i].kind) {
            _own_lint_touch(e.children[1 + i], out)
        }
        i = i + 1
    }

    // Callee must be a fn type. A `named:HexaVal` callee is the dynamic
    // any-value (a fn stored in a HexaVal) — the runtime call path dispatches
    // on its tag, so it is callable and must not raise HX2003.
    if callee_t.kind != "fn" && !_is_hexaval(callee_t) {
        if len(callee_t.kind) > 0 {
            // Stage1 punch list C20 — surface HX2003 (not callable) when
            // a non-fn value with a known type appears in callee position
            // (e.g. `let mut x = 0; x()`). The inferred callee type is
            // non-empty here, so this never piles onto an unresolved-name
            // diagnostic — that branch falls to C4 below.
            let mut b = diag_new("HX2003")
            b = diag_span(b, e.span)
            b = diag_arg(b, "name", name)
            b = diag_arg(b, "actual", _type_display(callee_t))
            out.push(diag_emit(b))
        } else if !_types_is_ident(callee.kind) {
            // Stage1 punch list C4 — previously a silent miss for non-Ident
            // unresolved callees. bind.hexa already emits HX2001 for plain-
            // Ident misses (with did-you-mean), so we gate on non-Ident here
            // to avoid double-firing on the same name. Field / Index /
            // Call-result / other non-Ident callees that don't resolve to
            // fn types land here as the unique HX2001 source.
            //
            // Exception: `recv.<m>(...)` where <m> is a builtin method
            // (gen2_method_builtin set) — dispatched by codegen on the
            // receiver, so the selector is NOT an unresolved free name.
            if !(callee.kind == ExprKind::Field && _is_builtin_method(callee.text)) {
                _emit_hx2001_callee(name, callee.span, out)
            }
        }
        // Callee not resolved as fn — skip arity/argument checks; return value
        // type unknown.
        return _types_empty_type()
    }

    // Dynamic HexaVal callee (a fn stored in a HexaVal): its arity and arg
    // types are unknown at compile time — the runtime dispatches on the tag.
    // Skip the HX3002/HX3003 arity/arg-type checks; the result is itself a
    // dynamic value. (Without this, making HexaVal callable above would just
    // convert the HX2003 into a spurious HX3002 arg-count mismatch.)
    if _is_hexaval(callee_t) { return _types_empty_type() }

    let expected_count = len(callee_t.args)
    if arg_count != expected_count {
        _emit_hx3002(name, expected_count, arg_count, e.span, out)
    } else {
        let mut k = 0
        while k < arg_count {
            let want = callee_t.args[k]
            let got = arg_types[k]
            if !_types_equal(want, got) {
                // Permissive on `unit`-typed actuals: the inferencer
                // resolves an unannotated `fn f(x) { if … { return X }
                // ; return Y }` to `unit` even when every path
                // returns a value, so calls like `_bell(is_leap(yr))`
                // got blocked. The codegen passes the HexaVal pair
                // regardless of static type, so this strictness was
                // tighter than runtime correctness needs.
                let ku = "unit"
                if got.kind != ku {
                    _emit_hx3003(name, k + 1, want, got, e.children[1 + k].span, out)
                }
            }
            k = k + 1
        }
    }

    if len(callee_t.ret) > 0 { return callee_t.ret[0] }
    return _types_t_unit()
}

// ── Match checker ────────────────────────────────────────────

fn _check_match(e: Expr, env: TypeEnv, ctx: CheckCtx, out: array) -> Type {
    // children: [scrut, pat0, body0, pat1, body1, ...]
    if len(e.children) == 0 { return _types_empty_type() }
    let scrut_t = _infer_expr(e.children[0], env, ctx, out)
    let mut first_t = _types_empty_type()
    let mut have_first = false
    let mut arm_idx = 0
    let mut i = 1
    while i + 1 < len(e.children) {
        // Pattern children may include ident binders (S2 handles binding) —
        // walk them so any type-bearing pattern still gets inspected, but
        // discard the inferred pattern type (no equality check at v1; the
        // opt-in r9c literal-pattern arm below is the sole exception).
        //
        // RFC pattern guards — a guarded arm's pattern is a "match_guard"
        // carrier (If-kind, children [inner_pattern, guard]). Infer the inner
        // pattern + guard separately rather than letting the generic If
        // handler mis-type the 2-child carrier. The guard type is best-effort
        // at v1 (not forced to bool); binder vars are not in this env, so
        // unknown idents infer empty (no spurious diagnostic).
        let pat_i = e.children[i]
        if ast_is_match_guard(pat_i) {
            let _ip = _infer_expr(pat_i.children[0], env, ctx, out)
            let _gd = _infer_expr(pat_i.children[1], env, ctx, out)
        } else {
            let pt = _infer_expr(pat_i, env, ctx, out)
            // static-types r9c — opt-in literal-pattern vs scrutinee REJECT
            // (HEXA_STATIC_TYPES=1). Rust E0308 "mismatched types" as fired
            // from `check_pat` (rustc_hir_typeck/src/pat.rs check_pat_lit →
            // demand_suptype → report_mismatched_types): a scalar LITERAL
            // pattern (`match n { "x" -> … }` on an i64 scrutinee) can never
            // match and is a silent-mismatch bug class. Conservative by
            // construction: only fires when the pattern is a scalar literal
            // kind (int/float/string/bool/char — ident binders, `_`
            // Wildcard, EnumPath, and match_guard carriers all fall outside
            // the probes / stay on the discard path above) AND both the
            // scrutinee's inferred type and the pattern's are KNOWN scalar
            // primitives (unknown sentinel / aggregate / named: → skip, the
            // r2 soundness-gate idiom). `_types_assignable` (src = the
            // pattern expr) keeps int/float-literal coercion — `match x_i32
            // { 1 -> … }` stays clean. ENTIRELY flag-gated (env check is the
            // FIRST `&&` operand, short-circuit) so the default build keeps
            // the discard-only walk → diagnostic stream byte-identical →
            // byteeq (gen3≡gen4) preserved.
            if _types_static_on && (_types_is_lit_int(pat_i.kind) || _types_is_lit_float(pat_i.kind) || _types_is_lit_string(pat_i.kind) || _is_lit_bool(pat_i.kind) || _is_lit_char(pat_i.kind)) {
                if _types_kind_is_scalar(scrut_t.kind) && _types_kind_is_scalar(pt.kind) {
                    if !_types_assignable(scrut_t, pt, pat_i) {
                        _emit_hx3011(scrut_t, pt, pat_i.span, out)
                    }
                }
            }
        }
        let bt = _infer_expr(e.children[i + 1], env, ctx, out)
        if !have_first {
            first_t = bt
            have_first = true
        } else {
            if !_types_equal(first_t, bt) {
                _emit_hx3005(arm_idx, first_t, bt, e.children[i + 1].span, out)
            }
        }
        arm_idx = arm_idx + 1
        i = i + 2
    }
    return first_t
}

// ── Exhaustiveness check (Maranget 2007, single-column enum case) ─────
//
// Cite: Luc Maranget, "Warnings for pattern matching", JFP 17(3), 2007 —
// the `U(P, q)` usefulness predicate. We implement the practical special
// case the language needs today: a one-column matrix whose head
// constructors are enum variants. For a `match` over an enum we collect the
// set Σ of head constructors covered by the UNGUARDED arms; the wildcard
// row `_` is useful (⇒ the match is non-exhaustive) exactly when Σ is a
// proper subset of the enum's full variant signature AND no arm is an
// irrefutable catch-all (`_` or a bare ident binding). Guarded arms
// (`Variant if cond`) never contribute to Σ — the guard may fail at runtime,
// so the variant is not provably covered (same rule as Rust).
//
// Default-OFF behind `HEXA_EXHAUSTIVE=1`: this introduces a brand-new
// diagnostic, so it ships opt-in to guarantee zero change to the default
// build's diagnostic stream (release integrity). It is a warning (HX3006),
// never fatal, and never affects emitted bytes — promotable to default once
// the in-tree corpus is measured clean.

struct ExhEnumReg {
    names: [string],
    joined: [string]
}

fn _exh_build_registry(module: Module) -> ExhEnumReg {
    let mut names: [string] = []
    let mut joined: [string] = []
    let mut i = 0
    while i < len(module.items) {
        let it = module.items[i]
        if _types_is_enum_item(it.kind) {
            names.push(it.name)
            let mut s = ""
            let mut j = 0
            while j < len(it.params) {
                if j > 0 { s = s + "|" }
                s = s + it.params[j].name
                j = j + 1
            }
            joined.push(s)
        }
        i = i + 1
    }
    return ExhEnumReg { names: names, joined: joined }
}

fn _exh_reg_lookup(reg: ExhEnumReg, name: string) -> string {
    let mut i = 0
    while i < len(reg.names) {
        if reg.names[i] == name { return reg.joined[i] }
        i = i + 1
    }
    return ""
}

fn _exh_is_wildcard(k: ExprKind) -> bool {
    return match k {
        ExprKind::Wildcard -> true,
        _ -> false
    }
}

fn _exh_split(s: string) -> [string] {
    let chars = s.chars()
    let n = len(chars)
    let mut out: [string] = []
    let mut cur = ""
    let mut i = 0
    while i < n {
        if chars[i] == '|' {
            out.push(cur)
            cur = ""
        } else {
            cur = cur + to_string(chars[i])
        }
        i = i + 1
    }
    if len(cur) > 0 { out.push(cur) }
    return out
}

fn _exh_contains(arr: [string], s: string) -> bool {
    let mut i = 0
    while i < len(arr) {
        if arr[i] == s { return true }
        i = i + 1
    }
    return false
}

// Local "Enum::Variant" splitters (private siblings of bind.hexa's
// _enum_head / _enum_variant_tail; kept file-local because non-pub fns are
// file-scoped under the module-flatten model).
fn _exh_path_head(t: string) -> string {
    let chars = t.chars()
    let n = len(chars)
    let mut i = 0
    let mut out = ""
    while i < n - 1 {
        if chars[i] == ':' && chars[i + 1] == ':' {
            return out
        }
        out = out + to_string(chars[i])
        i = i + 1
    }
    if i < n {
        out = out + to_string(chars[i])
    }
    return out
}

fn _exh_path_tail(t: string) -> string {
    let chars = t.chars()
    let n = len(chars)
    let mut i = 0
    while i < n - 1 {
        if chars[i] == ':' && chars[i + 1] == ':' {
            let mut out = ""
            let mut j = i + 2
            while j < n {
                out = out + to_string(chars[j])
                j = j + 1
            }
            return out
        }
        i = i + 1
    }
    return ""
}

fn _exh_analyze_match(e: Expr, reg: ExhEnumReg, out: array) {
    // children: [scrut, pat0, body0, pat1, body1, ...]
    let mut has_catchall = false
    let mut saw_enum = false
    let mut enum_head = ""
    let mut covered: [string] = []
    let mut i = 1
    while i + 1 < len(e.children) {
        let mut p = e.children[i]
        let mut guarded = false
        if ast_is_match_guard(p) {
            guarded = true
            p = p.children[0]
        }
        if _exh_is_wildcard(p.kind) {
            if !guarded { has_catchall = true }
        } else if _types_is_ident(p.kind) {
            // a bare ident binding (not `_`) is an irrefutable catch-all
            if !guarded && p.text != "_" { has_catchall = true }
        } else if _types_is_enum_path_kind(p.kind) {
            saw_enum = true
            let h = _exh_path_head(p.text)
            let tl = _exh_path_tail(p.text)
            if len(enum_head) == 0 { enum_head = h }
            if !guarded && len(tl) > 0 { covered.push(tl) }
        }
        i = i + 2
    }
    if has_catchall { return }
    if !saw_enum { return }
    if len(enum_head) == 0 { return }
    let joined = _exh_reg_lookup(reg, enum_head)
    if len(joined) == 0 { return }
    let decl = _exh_split(joined)
    let mut missing = ""
    let mut n_missing = 0
    let mut j = 0
    while j < len(decl) {
        if !_exh_contains(covered, decl[j]) {
            if n_missing > 0 { missing = missing + ", " }
            missing = missing + enum_head + "::" + decl[j]
            n_missing = n_missing + 1
        }
        j = j + 1
    }
    if n_missing > 0 {
        let mut b = diag_new("HX3006")
        b = diag_span(b, e.span)
        b = diag_arg(b, "enum", enum_head)
        b = diag_arg(b, "missing", missing)
        out.push(diag_emit(b))
    }
}

fn _exh_walk(e: Expr, reg: ExhEnumReg, out: array) {
    if _is_match_expr(e.kind) {
        _exh_analyze_match(e, reg, out)
    }
    let mut i = 0
    while i < len(e.children) {
        _exh_walk(e.children[i], reg, out)
        i = i + 1
    }
}

fn _exh_check_module(module: Module, out: array) {
    if env("HEXA_EXHAUSTIVE") != "1" { return }
    let reg = _exh_build_registry(module)
    let mut i = 0
    while i < len(module.items) {
        let it = module.items[i]
        if item_is_parse_only(it) {
            i = i + 1
            continue
        }
        if _types_is_fn_item(it.kind) || _types_is_let_item(it.kind) {
            _exh_walk(it.body, reg, out)
        }
        i = i + 1
    }
}

// ── Const generics + where-clause / trait-bound ENFORCEMENT ──
//
// Opt-in (`HEXA_CONST_GENERICS=1`), check-only, byteeq-neutral pass — the
// production port of the standalone reference typechecker
// `self/test_generics_typecheck.hexa` (lane ① const-generics, T35–T46).
// It mirrors the proven `_exh_*` exhaustiveness shape exactly:
//   * env-gated at the top of `_cg_check_module` → no-op on the default build
//     (the `out` diagnostic stream is byte-identical when the flag is unset);
//   * it only appends diagnostics, never touches MIR/codegen, so even ON it
//     cannot change emitted bytes;
//   * it decodes a synthetic `__cg` annotation (no new AST field, no new
//     keyword) that the opt-in parser capture attaches at the declaration site
//     (param kinds/bounds + desugared where-clauses) and the instantiation
//     site (StructLit type/const arguments).
//
// reference (faithful-match cites):
//   • Rust RFC 2000 (min_const_generics) — a `const N` parameter is
//     instantiated with a *value*, a type parameter with a *type*; the slots
//     are not interchangeable (`Buf<int>` / `Box<5>` both rejected).
//   • The Rust Reference §"Where clauses" — `<T, U> where T: Ord` desugars to
//     `<T: Ord, U>`; the bound is proven at every instantiation.
//   • rustc trait selection — f64 implements PartialOrd but NOT Ord (the NaN
//     total-order hole), reproduced in `_cg_type_implements`.
//
// Polarity / release integrity: a violated bound is a non-fatal WARNING
// (HX3008) by default; the opt-in `HEXA_STRICT_BOUNDS=1` promotes the same
// site to a fatal Error (HX3009). The const-slot mismatch is HX3007.

struct CgGenericReg {
    names: [string],
    counts: [i64],
    offsets: [i64],
    all_param_names: [string],
    all_param_bounds: [string]
}

// Generic char splitter (sibling of `_exh_split`, which is hard-wired to '|').
fn _cg_split_ch(s: string, ch: char) -> [string] {
    let chars = s.chars()
    let n = len(chars)
    let mut out: [string] = []
    let mut cur = ""
    let mut i = 0
    while i < n {
        if chars[i] == ch {
            out.push(cur)
            cur = ""
        } else {
            cur = cur + to_string(chars[i])
        }
        i = i + 1
    }
    if len(cur) > 0 { out.push(cur) }
    return out
}

// rustc-faithful builtin trait-impl table. The int family is totally ordered
// (Ord/Eq), the float family is only PartialOrd/PartialEq (NaN hole). String
// is Ord/Eq/Clone/Display but not Num/Copy.
fn _cg_int_family(t: string) -> bool {
    return t == "int" || t == "i8" || t == "i16" || t == "i32" || t == "i64"
        || t == "isize" || t == "u8" || t == "u16" || t == "u32" || t == "u64"
        || t == "usize"
}

fn _cg_float_family(t: string) -> bool {
    return t == "float" || t == "f32" || t == "f64"
}

fn _cg_is_enforceable_type(t: string) -> bool {
    // Only enforce a bound against a *known primitive* concrete type. A
    // user-declared struct/enum could carry a trait impl we have not parsed
    // (no impl-block registry yet), so we stay silent there rather than emit a
    // false violation — conservative polarity (warn only when provably unmet).
    return _cg_int_family(t) || _cg_float_family(t) || t == "string"
        || t == "str" || t == "bool" || t == "char"
}

fn _cg_type_implements(t: string, tr: string) -> bool {
    if _cg_int_family(t) {
        return tr == "Ord" || tr == "Eq" || tr == "PartialOrd" || tr == "PartialEq"
            || tr == "Num" || tr == "Clone" || tr == "Copy" || tr == "Display"
    }
    if _cg_float_family(t) {
        return tr == "PartialOrd" || tr == "PartialEq" || tr == "Num"
            || tr == "Clone" || tr == "Copy" || tr == "Display"
    }
    if t == "string" || t == "str" {
        return tr == "Ord" || tr == "Eq" || tr == "PartialOrd" || tr == "PartialEq"
            || tr == "Clone" || tr == "Display"
    }
    if t == "bool" {
        return tr == "Ord" || tr == "Eq" || tr == "PartialOrd" || tr == "PartialEq"
            || tr == "Clone" || tr == "Copy"
    }
    if t == "char" {
        return tr == "Ord" || tr == "Eq" || tr == "PartialOrd" || tr == "PartialEq"
            || tr == "Clone" || tr == "Copy" || tr == "Display"
    }
    return false
}

fn _cg_has_cg_ann(anns: [Annotation]) -> bool {
    let mut i = 0
    while i < len(anns) {
        if anns[i].name == "__cg" { return true }
        i = i + 1
    }
    return false
}

fn _cg_get_cg_args(anns: [Annotation]) -> [Expr] {
    let mut i = 0
    while i < len(anns) {
        if anns[i].name == "__cg" { return anns[i].args }
        i = i + 1
    }
    let mut empty: [Expr] = []
    return empty
}

fn _cg_is_struct_lit(k: ExprKind) -> bool {
    return match k {
        ExprKind::StructLit -> true,
        ExprKind::LiteralInt -> false,
        ExprKind::LiteralFloat -> false,
        ExprKind::LiteralString -> false,
        ExprKind::LiteralBool -> false,
        ExprKind::LiteralChar -> false,
        ExprKind::Ident -> false,
        ExprKind::AtlasRef -> false,
        ExprKind::Call -> false,
        ExprKind::BinOp -> false,
        ExprKind::UnOp -> false,
        ExprKind::Block -> false,
        ExprKind::If -> false,
        ExprKind::While -> false,
        ExprKind::For -> false,
        ExprKind::Match -> false,
        ExprKind::Return -> false,
        ExprKind::Break -> false,
        ExprKind::Continue -> false,
        ExprKind::Let -> false,
        ExprKind::Assign -> false,
        ExprKind::Field -> false,
        ExprKind::Index -> false,
        ExprKind::ArrayLit -> false,
        ExprKind::EnumPath -> false,
        ExprKind::Wildcard -> false,
        ExprKind::Try -> false,
        ExprKind::Throw -> false,
        ExprKind::Closure -> false
    }
}

// Build the generic-param registry from every Item carrying a `__cg`
// annotation. The annotation args are LiteralString carriers encoded as
// "P:<name>:<bound>" (declaration param; bound "" / "const" / "Ord+Num") and
// "W:<param>:<trait>" (where-clause atom). Where-clauses are desugared inline
// onto the matching param's bound (rustc `<T,U> where T: Ord` ≡ `<T: Ord, U>`,
// multi-clause accumulation joined with '+').
fn _cg_build_registry(module: Module) -> CgGenericReg {
    let mut names: [string] = []
    let mut counts: [i64] = []
    let mut offsets: [i64] = []
    let mut all_names: [string] = []
    let mut all_bounds: [string] = []
    let mut i = 0
    while i < len(module.items) {
        let it = module.items[i]
        if _cg_has_cg_ann(it.annotations) {
            let args = _cg_get_cg_args(it.annotations)
            let mut pnames: [string] = []
            let mut pbounds: [string] = []
            let mut wparams: [string] = []
            let mut wtraits: [string] = []
            let mut j = 0
            while j < len(args) {
                let parts = _cg_split_ch(args[j].text, ':')
                if len(parts) >= 2 {
                    let tag = parts[0]
                    if tag == "P" {
                        pnames.push(parts[1])
                        if len(parts) >= 3 { pbounds.push(parts[2]) } else { pbounds.push("") }
                    } else if tag == "W" {
                        wparams.push(parts[1])
                        if len(parts) >= 3 { wtraits.push(parts[2]) } else { wtraits.push("") }
                    }
                }
                j = j + 1
            }
            let count = len(pnames)
            if count > 0 {
                names.push(it.name)
                counts.push(count)
                offsets.push(len(all_names))
                let mut k = 0
                while k < count {
                    all_names.push(pnames[k])
                    let mut b = pbounds[k]
                    // where-clause desugar: accumulate matching W traits.
                    let mut m = 0
                    while m < len(wparams) {
                        if wparams[m] == pnames[k] {
                            let wt = wtraits[m]
                            if len(wt) > 0 && b != "const" {
                                if len(b) == 0 {
                                    b = wt
                                } else {
                                    b = b + "+" + wt
                                }
                            }
                        }
                        m = m + 1
                    }
                    all_bounds.push(b)
                    k = k + 1
                }
            }
        }
        i = i + 1
    }
    return CgGenericReg {
        names: names,
        counts: counts,
        offsets: offsets,
        all_param_names: all_names,
        all_param_bounds: all_bounds
    }
}

fn _cg_reg_count(reg: CgGenericReg, name: string) -> i64 {
    let mut i = 0
    while i < len(reg.names) {
        if reg.names[i] == name { return reg.counts[i] }
        i = i + 1
    }
    return 0
}

fn _cg_reg_bounds(reg: CgGenericReg, name: string) -> [string] {
    let mut out: [string] = []
    let mut i = 0
    while i < len(reg.names) {
        if reg.names[i] == name {
            let off = reg.offsets[i]
            let cnt = reg.counts[i]
            let mut j = 0
            while j < cnt {
                out.push(reg.all_param_bounds[off + j])
                j = j + 1
            }
            return out
        }
        i = i + 1
    }
    return out
}

// Validate one StructLit instantiation site against the registered generic
// params. The instantiation `__cg` annotation encodes each argument as
// "T:<typename>" (a type) or "C:<value>" (a const value).
fn _cg_check_struct_lit(e: Expr, reg: CgGenericReg, out: array) {
    if !_cg_has_cg_ann(e.annotations) { return }
    let name = e.text
    let cnt = _cg_reg_count(reg, name)
    if cnt == 0 { return }
    let bounds = _cg_reg_bounds(reg, name)
    let args = _cg_get_cg_args(e.annotations)
    let mut akinds: [string] = []
    let mut atexts: [string] = []
    let mut j = 0
    while j < len(args) {
        let parts = _cg_split_ch(args[j].text, ':')
        if len(parts) >= 1 {
            let tag = parts[0]
            if tag == "T" || tag == "C" {
                akinds.push(tag)
                if len(parts) >= 2 { atexts.push(parts[1]) } else { atexts.push("") }
            }
        }
        j = j + 1
    }
    let strict = env("HEXA_STRICT_BOUNDS") == "1"
    let nactual = len(akinds)
    let mut i = 0
    while i < nactual {
        if i >= len(bounds) {
            i = i + 1
            continue
        }
        let bound = bounds[i]
        let kind = akinds[i]
        let argtext = atexts[i]
        if bound == "const" {
            if kind != "C" {
                // const generic param wants a *value*, not a type (RFC 2000).
                let mut b = diag_new("HX3007")
                b = diag_span(b, e.span)
                b = diag_arg(b, "owner", name)
                b = diag_arg(b, "detail", "const parameter #" + to_string(i) + " expects a value, but type `" + argtext + "` was given")
                out.push(diag_emit(b))
            }
        } else if kind == "C" {
            // type param must NOT be given a const value.
            let mut b = diag_new("HX3007")
            b = diag_span(b, e.span)
            b = diag_arg(b, "owner", name)
            b = diag_arg(b, "detail", "type parameter #" + to_string(i) + " expects a type, but const value `" + argtext + "` was given")
            out.push(diag_emit(b))
        } else if len(bound) > 0 {
            // prove each trait of the bound against the concrete instantiation.
            if _cg_is_enforceable_type(argtext) {
                let traits = _cg_split_ch(bound, '+')
                let mut t = 0
                while t < len(traits) {
                    let tr = traits[t]
                    if len(tr) > 0 && !_cg_type_implements(argtext, tr) {
                        let mut code = "HX3008"
                        if strict { code = "HX3009" }
                        let mut d = diag_new(code)
                        d = diag_span(d, e.span)
                        d = diag_arg(d, "trait", tr)
                        d = diag_arg(d, "type", argtext)
                        d = diag_arg(d, "owner", name)
                        out.push(diag_emit(d))
                    }
                    t = t + 1
                }
            }
        }
        i = i + 1
    }
}

fn _cg_walk(e: Expr, reg: CgGenericReg, out: array) {
    if _cg_is_struct_lit(e.kind) {
        _cg_check_struct_lit(e, reg, out)
    }
    let mut i = 0
    while i < len(e.children) {
        _cg_walk(e.children[i], reg, out)
        i = i + 1
    }
}

fn _cg_check_module(module: Module, out: array) {
    if env("HEXA_CONST_GENERICS") != "1" { return }
    let reg = _cg_build_registry(module)
    let mut i = 0
    while i < len(module.items) {
        let it = module.items[i]
        if item_is_parse_only(it) {
            i = i + 1
            continue
        }
        if _types_is_fn_item(it.kind) || _types_is_let_item(it.kind) {
            _cg_walk(it.body, reg, out)
        }
        i = i + 1
    }
}

// ── Higher-kinded types — kind-arity consistency (opt-in HEXA_HKT) ──
//
// Opt-in (`HEXA_HKT=1`), check-only, byteeq-neutral pass — structurally
// identical to the `_cg_*` const-generics and `_exh_*` exhaustiveness passes:
//   * env-gated at the top of `_hkt_check_module` → no-op on the default build
//     (the `out` diagnostic stream is byte-identical when the flag is unset);
//   * it only appends diagnostics, never touches MIR/lower/codegen, so even ON
//     it cannot change a single emitted object byte;
//   * it reuses the SAME `__cg` declaration-param carriers (`P:<name>:<bound>`)
//     that the opt-in parser capture attaches — the two parser gates are widened
//     to also fire under HEXA_HKT (one-token OR), so no new AST field / keyword
//     (frozen-seed safe).
//
// WHAT IT CHECKS — the kind-ARITY-consistency fragment of a full kind system.
// hexa's dynamic {tag,payload} runtime erases every generic to one monomorphic
// MIR (the parser generic-erase loop), so there is ZERO runtime realization of
// higher-kinded polymorphism — even a complete front-end lowers to identical
// erased bytes. What IS tractable purely in the checker is kind-arity
// unification across a single signature: a declared type parameter used as
// `F<A>` is a unary type constructor (kind `*->*`); the same `F` may not also
// appear applied to a different number of arguments, nor bare in a proper-type
// slot (kind `*`). This is the faithful core of Haskell kind inference.
//
// reference (faithful-match cites):
//   • Haskell 2010 Report §4.1.1 — kinds are `*` (proper types) and `k1->k2`
//     (type constructors); in an application `f a`, `f :: k->*` and `a :: k`; a
//     kind mismatch is reported as "Expected kind X, but has kind Y".
//   • Scala — `trait Functor[F[_]]` declares `F` at ctor-kind `*->*`
//     (type-constructor polymorphism, Moors et al., "Generics of a Higher
//     Kind", OOPSLA'08); an application must respect that declared arity.
//   • Rust RFC 1598 (generic associated types) — Rust deliberately DECLINES
//     full `F: *->*` type parameters and offers GATs as an HKT *substitute*;
//     this anchors the design ceiling we report honestly. Full HKT (Functor /
//     Monad typeclass polymorphism, instance resolution, type-level ctor
//     application/`fmap` dispatch) is NOT implementable here: (a) there is no
//     trait/typeclass/instance registry (the checker stays silent on user
//     types), (b) `class`/`instance`/kind-annotation syntax would violate the
//     frozen seed, (c) the dynamic {tag,payload} runtime erases all generics to
//     one monomorphic MIR → zero runtime realization.
//
// Polarity / release integrity: a kind-arity mismatch is a non-fatal WARNING
// (HX3011) — a new diag ships opt-in and non-fatal, never breaking a build.

// Recover the declared type-parameter names from an Item's `__cg` "P:" carriers.
fn _hkt_collect_params(it: Item) -> [string] {
    let mut out: [string] = []
    if !_cg_has_cg_ann(it.annotations) { return out }
    let args = _cg_get_cg_args(it.annotations)
    let mut j = 0
    while j < len(args) {
        let parts = _cg_split_ch(args[j].text, ':')
        if len(parts) >= 2 {
            if parts[0] == "P" { out.push(parts[1]) }
        }
        j = j + 1
    }
    return out
}

fn _hkt_is_decl(name: string, decls: [string]) -> bool {
    let mut i = 0
    while i < len(decls) {
        if decls[i] == name { return true }
        i = i + 1
    }
    return false
}

// Walk a TypeRef, recording for every node whose `name` is a declared param the
// application arity at that use site: a `kind:"generic"` `F<A,…>` records arity
// = len(args) (used as a type constructor), any other use records arity 0 (used
// as a proper type). Observations accumulate into parallel `obs_names` /
// `obs_arity`. Recurses into `args` so nested applications (`F<G<A>>`) are seen.
fn _hkt_walk_typeref(tr: TypeRef, decls: [string], obs_names: array, obs_arity: array) {
    if _hkt_is_decl(tr.name, decls) {
        let mut arity = 0
        if tr.kind == "generic" { arity = len(tr.args) }
        obs_names.push(tr.name)
        obs_arity.push(arity)
    }
    let mut i = 0
    while i < len(tr.args) {
        _hkt_walk_typeref(tr.args[i], decls, obs_names, obs_arity)
        i = i + 1
    }
}

// Kind-arity unification for a single Item signature. For fn items the signature
// TypeRefs are every param type + the return type; for struct items they are the
// field types (`it.params[].typ`). A declared param observed with ≥2 distinct
// arities is a kind mismatch (e.g. `F<A>` vs `F<A,B>`, or higher-kinded `F` used
// bare in a proper-type slot) → emit HX3015 (renumbered from HX3011, which it
// double-booked with the static-types "mismatched types" Error — F0 pre-flip
// hygiene; opt-in pass, so the default diagnostic stream is unchanged).
fn _hkt_check_item(it: Item, out: array) {
    let decls = _hkt_collect_params(it)
    if len(decls) == 0 { return }
    let mut obs_names = []
    let mut obs_arity = []
    let mut p = 0
    while p < len(it.params) {
        _hkt_walk_typeref(it.params[p].typ, decls, obs_names, obs_arity)
        p = p + 1
    }
    _hkt_walk_typeref(it.return_type, decls, obs_names, obs_arity)
    let mut d = 0
    while d < len(decls) {
        let pname = decls[d]
        let mut min_ar = -1
        let mut max_ar = -1
        let mut o = 0
        while o < len(obs_names) {
            if obs_names[o] == pname {
                let a = obs_arity[o]
                if min_ar == -1 || a < min_ar { min_ar = a }
                if max_ar == -1 || a > max_ar { max_ar = a }
            }
            o = o + 1
        }
        if min_ar != -1 && min_ar != max_ar {
            let mut b = diag_new("HX3015")
            b = diag_span(b, it.span)
            b = diag_arg(b, "param", pname)
            b = diag_arg(b, "owner", it.name)
            b = diag_arg(b, "first_arity", to_string(min_ar))
            b = diag_arg(b, "second_arity", to_string(max_ar))
            out.push(diag_emit(b))
        }
        d = d + 1
    }
}

fn _hkt_check_module(module: Module, out: array) {
    if env("HEXA_HKT") != "1" { return }
    let mut i = 0
    while i < len(module.items) {
        let it = module.items[i]
        if item_is_parse_only(it) {
            i = i + 1
            continue
        }
        if _types_is_fn_item(it.kind) || _types_is_struct_item(it.kind) {
            _hkt_check_item(it, out)
        }
        i = i + 1
    }
}

// ── Pre-pass: collect Item types into TypeEnv ────────────────

fn _types_signature_type(it: Item) -> Type {
    let mut params: [Type] = []
    let mut i = 0
    while i < len(it.params) {
        params.push(_types_lower_type_ref(it.params[i].typ))
        i = i + 1
    }
    let mut ret: [Type] = []
    let r = _types_lower_type_ref(it.return_type)
    if len(r.kind) > 0 {
        ret.push(r)
    } else {
        ret.push(_types_t_unit())
    }
    return Type {
        kind: "fn",
        def: _types_miss_def_id(),
        args: params,
        ret: ret,
        domain: "",
        unit: ""
    }
}

fn _types_struct_type(it: Item, def: DefId) -> Type {
    let mut fields: [Type] = []
    let mut i = 0
    while i < len(it.params) {
        fields.push(_types_lower_type_ref(it.params[i].typ))
        i = i + 1
    }
    return Type {
        kind: "struct",
        def: def,
        args: fields,
        ret: [],
        domain: "",
        unit: ""
    }
}

fn _types_enum_type(def: DefId) -> Type {
    return Type {
        kind: "enum",
        def: def,
        args: [],
        ret: [],
        domain: "",
        unit: ""
    }
}

// Look up an existing binding by (name, owning_file) — used by the pre-pass
// for idempotent re-registration detection (Item appears twice in
// module.items because the same fn was spliced from another file).
fn _types_find_binding(env: TypeEnv, name: string, owning_file: string) -> bool {
    // A3 — bucket-restricted scan.
    let bucket = _types_bucket_for(env, name)
    let mut i = 0
    while i < len(bucket) {
        let b = env.entries[bucket[i]]
        if b.name == name && b.module_file == owning_file {
            return true
        }
        i = i + 1
    }
    return false
}

// Find the file that owns the existing pub binding for `name`, or "" when
// no pub binding is present. Used by HX3010 emission to identify the prior
// owner during a duplicate-pub-symbol-across-files report. First-occurrence
// ordering is preserved by walking the bucket in insertion order.
fn _types_pub_owner_file(env: TypeEnv, name: string) -> string {
    // A3 — bucket-restricted scan.
    let bucket = _types_bucket_for(env, name)
    let mut i = 0
    while i < len(bucket) {
        let b = env.entries[bucket[i]]
        if b.name == name && b.is_pub {
            return b.module_file
        }
        i = i + 1
    }
    return ""
}

// Stage1 Gap 2 — pre-pass that respects pub visibility AND dedupes across
// files. Walks module.items (which after Gap 1 may carry items spliced
// from imported files) and:
//   - Skips an Item whose (name, owning_file) is already in env (idempotent
//     re-registration; the same fn arrived twice via the splice path — no
//     diagnostic, this is by design).
//   - For pub items, treats `name` as a global key. A second pub binding
//     for the same name from a DIFFERENT file emits HX3010 (Error, S3) and
//     skips the duplicate so downstream lookups see only the first.
//   - For non-pub items, treats `<file>::<name>` as the key — multiple
//     files may each declare a private `helper` without conflict.
//
// The `out` array collects HX3010 diagnostics; non-collision cases push
// nothing so existing single-file callers see an empty diag list.
fn _collect_item_types(module: Module, out: array) -> TypeEnv {
    // A3 — start with a primed (bucketed) env so every define + lookup
    // hits the hash index. _types_empty_env() pre-allocates the bucket
    // slots; _types_env_define_attr keeps them in sync.
    let mut env = _types_empty_env()
    let mut idx = 0
    let mut i = 0
    while i < len(module.items) {
        let it = module.items[i]
        // Each item carries an owning file via item.span.file (parser sets
        // span.file on every constructed AST node). Fall back to the top-
        // level module.file when span.file is empty (hand-built tests).
        let mut owning = it.span.file
        if len(owning) == 0 { owning = module.file }
        let def = DefId { module: owning, index: idx }

        // Type-alias carriers bind no value — already registered in the alias
        // substitution table by `_types_register_aliases`. Skip here so they
        // never enter the value env. Like the `!is_def` skip below, `idx` (the
        // per-definition counter) does NOT advance for a non-binding item.
        if item_is_type_alias(it) {
            i = i + 1
            continue
        }

        // Skip non-definition items up front.
        let is_def = _types_is_fn_item(it.kind)
            || _types_is_struct_item(it.kind)
            || _types_is_enum_item(it.kind)
            || _types_is_let_item(it.kind)
        if !is_def {
            i = i + 1
            continue
        }

        // Idempotent re-registration: same item from same file already in
        // env — silently skip (the parser's import splice may surface the
        // same fn twice when a file is reachable from multiple paths).
        if _types_find_binding(env, it.name, owning) {
            i = i + 1
            continue
        }

        // Pub-vs-pub collision across files → HX3010, skip the second.
        if it.is_pub {
            let prior_owner = _types_pub_owner_file(env, it.name)
            if len(prior_owner) > 0 && prior_owner != owning {
                _emit_hx3010(it.name, prior_owner, owning, it.span, out)
                i = i + 1
                continue
            }
        }

        if _types_is_fn_item(it.kind) {
            env = _types_env_define_attr(env, it.name, def,
                _types_signature_type(it), it.is_pub, owning)
        } else if _types_is_struct_item(it.kind) {
            env = _types_env_define_attr(env, it.name, def,
                _types_struct_type(it, def), it.is_pub, owning)
            // Wall A r5 — record this struct's field NAMES + named-type
            // spellings into the side registry (the env's struct Type keeps
            // field types but drops names) so a later `s.field = …` assign can
            // recover the declared field type. Mirrors the enum branch's
            // `_types_register_enum_item_payloads` call below.
            _types_register_struct_item_fields(it)
        } else if _types_is_enum_item(it.kind) {
            env = _types_env_define_attr(env, it.name, def,
                _types_enum_type(def), it.is_pub, owning)
            // RFC-074 Phase 2.1 — populate the per-slot payload type
            // registry alongside the env binding so `_infer_expr`'s
            // EnumPath site can resolve declared slot types without a
            // second pass over module.items.
            _types_register_enum_item_payloads(it)
        } else {
            // _types_is_let_item
            env = _types_env_define_attr(env, it.name, def,
                _types_lower_type_ref(it.return_type), it.is_pub, owning)
        }
        idx = idx + 1
        i = i + 1
    }
    return env
}

// ── Per-fn local env (params bind on top of module env) ──────

fn _types_bind_params(env: TypeEnv, it: Item, caller_file: string) -> TypeEnv {
    let mut e = env
    // Resolve the file that "owns" these params — falls back to caller_file
    // when the item has no span attribution (hand-built tests).
    let mut owning = it.span.file
    if len(owning) == 0 { owning = caller_file }
    let mut i = 0
    while i < len(it.params) {
        let p = it.params[i]
        let pt = _types_lower_type_ref(p.typ)
        // Params are file-private (visible only within the enclosing fn /
        // module). Record them with is_pub=false and the resolved owning
        // file so `_types_lookup_def` can match them under the caller's
        // module attribution.
        e = _types_env_define_attr(e, p.name, _types_miss_def_id(), pt,
            false, owning)
        i = i + 1
    }
    return e
}

// ── Public entry ─────────────────────────────────────────────

pub fn type_check(module: Module) -> array {
    let mut out = []
    // static-types §F3 env-hoist — refresh the cached flag bools ONCE per
    // pass, FIRST thing (before any registry/lowering work reads them).
    _types_static_flags_hoist()
    // RFC-074 Phase 2.1 — reset the per-module enum variant payload type
    // registry before `_collect_item_types` re-populates it on this run.
    // `type_check()` is called once per module pass; registry lifetime ==
    // this call (parallel to bind.hexa's arity registry reset shape).
    _types_enum_registry_reset()
    // Wall A r5 — reset the per-module struct field-type registry alongside
    // the enum one (same lifetime = this `type_check()` call). Populated by
    // `_collect_item_types`; read only under HEXA_STATIC_TYPES at the field-
    // assign site → byte-neutral for the default build.
    _types_struct_registry_reset()
    // Type-alias substitution table — registered up front (before any TypeRef
    // is lowered) so `type Name = T` carriers resolve `Name` → `T` everywhere,
    // including forward references (`struct S { x: Name }` declared above the
    // alias). Empty for alias-free programs → fully byte-neutral.
    _types_alias_registry_reset()
    _types_register_aliases(module)
    // Pre-pass collects item types and emits HX3010 for duplicate pub
    // symbols across files (Stage1 punch list Gap 2).
    let env = _collect_item_types(module, out)
    let ctx0 = _types_new_ctx(module.file)

    // Stage1 punch list A4 — side-index of fn / let item positions.
    // The legacy loop re-walked every Item in module.items linearly and
    // ran a per-kind match on every iteration. For spliced super-modules
    // with ~3 K items, the per-item `_types_is_fn_item` / `_types_is_let_item`
    // dispatch (each a 5-arm ExprKind tag match under stage0) dominates
    // when the body of work per item is small (Struct / Enum / Import
    // items have no body to walk at all). Build the indices once up
    // front so the body loops skip directly to the items that need work.
    //
    // Stage1 punch list C11 — items tagged @phase("parse_only") (e.g.
    // the ~10K AtlasNode literals in compiler/atlas/embedded.gen.hexa)
    // are filtered out of the indices here, so neither the fn-body nor
    // let-RHS pass walks them. _collect_item_types above already
    // registered the name + declared type, so static_atlas() and other
    // lookups still resolve cleanly.
    let n_items = len(module.items)
    let mut fn_idx: [i64] = []
    let mut let_idx: [i64] = []
    let mut pass1 = 0
    while pass1 < n_items {
        let item_p1 = module.items[pass1]
        if item_is_parse_only(item_p1) {
            pass1 = pass1 + 1
            continue
        }
        let k = item_p1.kind
        if _types_is_fn_item(k) {
            fn_idx.push(pass1)
        } else if _types_is_let_item(k) {
            let_idx.push(pass1)
        }
        // Struct / Enum / Import: skipped entirely — no body to walk.
        pass1 = pass1 + 1
    }

    // HEXA-OWN L2.5 r1 — populate the per-MODULE arena-escape globals list
    // (module-level `let` item names) from the let-index built above, BEFORE
    // the fn-body walk consumes it at the assign site. Flag first (short-
    // circuit) → the default build resets/pushes nothing (byteeq-neutral).
    if env("HEXA_ARENA_ESCAPE_LINT") == "1" {
        _arena_esc_globals_reset()
        let mut gi = 0
        while gi < len(let_idx) {
            _arena_esc_globals.push(module.items[let_idx[gi]].name)
            gi = gi + 1
        }
    }

    // Per-fn body check (the hot path).
    let mut fi = 0
    while fi < len(fn_idx) {
        let it = module.items[fn_idx[fi]]
        // The fn's enclosing file becomes the caller's module for
        // visibility checks. Fall back to module.file when the item
        // span has no attribution (hand-built tests).
        let mut fn_file = it.span.file
        if len(fn_file) == 0 { fn_file = module.file }
        let local = _types_bind_params(env, it, fn_file)
        let r = _types_lower_type_ref(it.return_type)
        let mut ret = r
        if len(ret.kind) == 0 { ret = _types_t_unit() }
        // Per-fn ctx uses the fn's owning file so `_types_lookup_def`
        // applies the right caller-module to private visibility.
        let ctx_for_fn = _types_new_ctx(fn_file)
        let ctx = _ctx_with_fn(ctx_for_fn, it.name, ret)
        // HEXA-OWN L2 r1 — the @own use-after-move registry is PER-FN: reset
        // before every body walk so move state never leaks across fns (fn A
        // moving `x` must not poison an unrelated `@own let x` in fn B).
        // Flag-gated like every own-lint site → structurally zero-cost on
        // the default build (byteeq-neutral; the registry stays empty).
        if env("HEXA_OWN_LINT") == "1" {
            _own_lint_reset()
            // HEXA-OWN L2 r2b — PARAM position: an `@own` param is treated
            // AFFINELY by the fn body — registration here (fn entry, after
            // the reset, before the body walk) is all it takes: the existing
            // move sites (let-RHS · assign-RHS · call-arg · return) then
            // mark it moved and a later use warns HX3012. The parser carries
            // inline `@own p: T` as a fn-level Annotation
            // { name: "own", args: [LiteralString "p"] } (parse_param →
            // p_param_own_anns → Item.annotations); a hand-written fn-level
            // `@own("p")` lands in the identical shape, so both spellings
            // are honored. Copy-class params (scalars, per the #4088
            // predicate) are exempt — never registered. Non-matching names
            // are silently ignored (warning-band lint, not a checker).
            let mut oai = 0
            while oai < len(it.annotations) {
                let oa = it.annotations[oai]
                if oa.name == "own" && len(oa.args) > 0 && _types_is_lit_string(oa.args[0].kind) {
                    let opn = oa.args[0].text
                    let mut opi = 0
                    while opi < len(it.params) {
                        let op = it.params[opi]
                        if op.name == opn && !_own_lint_typeref_is_copy(op.typ) {
                            _own_lint_register(op.name, op.span)
                        }
                        opi = opi + 1
                    }
                }
                oai = oai + 1
            }
        }
        // HEXA-OWN L2.5 r1 — the arena-escape registry (composite-lit lets +
        // fn-local shadow guard) is likewise PER-FN: reset before every body
        // walk so fn A's locals never leak into fn B. Its own flag, its own
        // arrays — L2 (HX3012) and L2.5 (HX3013) state never cross-
        // contaminates. Flag first → default build byteeq-neutral.
        if env("HEXA_ARENA_ESCAPE_LINT") == "1" {
            _arena_esc_reset()
        }
        // Walk body — inner Returns validate against ctx.fn_return.
        let body_t = _infer_expr(it.body, local, ctx, out)
        // Trailing block expression must also satisfy the return type
        // (when fn was annotated and body produced a value).
        // Use the block's last child as the literal-coercion source so
        // `fn f() -> i32 { 0 }` type-checks via _types_assignable.
        let mut tail_src = it.body
        if len(it.body.children) > 0 {
            tail_src = it.body.children[len(it.body.children) - 1]
        }
        if len(r.kind) > 0 && !_types_assignable(r, body_t, tail_src) {
            // Only report if body actually produced something (non-unknown);
            // unannotated/early-return-only fns still pass cleanly.
            if len(body_t.kind) > 0 && body_t.kind != "unit" {
                _emit_hx3004(it.name, r, body_t, it.body.span, out)
            }
        }
        fi = fi + 1
    }

    // Per-let-item RHS check.
    let mut li = 0
    while li < len(let_idx) {
        let it = module.items[let_idx[li]]
        // RHS type vs declared type. _types_assignable lets
        // `let x: i32 = 0` type-check (literal-int coercion).
        let declared = _types_lower_type_ref(it.return_type)
        let rhs_t = _infer_expr(it.body, env, ctx0, out)
        if len(declared.kind) > 0 && len(rhs_t.kind) > 0 {
            if !_types_assignable(declared, rhs_t, it.body) {
                _emit_hx3001(declared, rhs_t, it.body.span, out)
            }
        }
        li = li + 1
    }

    // RFC exhaustiveness — non-exhaustive enum-match warnings (HX3006).
    // Opt-in (HEXA_EXHAUSTIVE=1); no-op on the default build.
    _exh_check_module(module, out)

    // Const generics + where-clause / trait-bound enforcement (HX3007/8/9).
    // Opt-in (HEXA_CONST_GENERICS=1); no-op on the default build. Identical
    // structural slot to the exhaustiveness pass above.
    _cg_check_module(module, out)

    // Higher-kinded types — kind-arity consistency (HX3011). Opt-in
    // (HEXA_HKT=1); no-op on the default build. Same structural slot; reuses the
    // shared `__cg` declaration-param carriers as its kind-arity data source.
    _hkt_check_module(module, out)

    return out
}
