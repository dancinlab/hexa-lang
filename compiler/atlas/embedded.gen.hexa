    AtlasNode { kind: "C", id: "clay-cascade-s3-tick3-AG-mechanism-formal-refinement", raw: "@C clay-cascade-s3-tick3-AG-mechanism-formal-refinement :: meta [4]\n  <- clay-cascade-s3-tick3-AG-src-conditional-directed-indeg-CONFIRMED-witness\n  => \"for topology with nbr(i, a) and src=32:\"\n  => \"1. R(src) = nodes BFS-reachable from src under DIRECTED edges u -> nbr(u, a)\"\n  => \"2. indeg_R(j) = #{(i, a) : i in R, nbr(i, a) = j} for j in R\"\n  => \"   (NOT out-degree — out-deg is always D=3 by construction, carries no hub-collapse signal)\"\n  => \"3. dvar_R = Var_{j in R} [indeg_R(j)]\"\n  => \"addresses both AF blind spots: src-position (R restriction) + edge-direction (directed in-deg)\"", source_file: "atlas.n6", source_line: 25370, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s3-tick3-AG-src-conditional-directed-indeg-CONFIRMED-witness"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s3-tick3-AG-classification-rule", raw: "@C clay-cascade-s3-tick3-AG-classification-rule :: meta [4]\n  <- clay-cascade-s3-tick3-AG-mechanism-formal-refinement\n  => \"★ TWO-BAND classification rule (refined):\"\n  => \"  |R| <= 10  -> FAST  (BFS-reachable component too small to escape hub orbit)\"\n  => \"  |R| >= 60  -> FULL  (near-full reach, expander-like)\"\n  => \"  10 < |R| < 60 mid-band: dvar_R >= 3 -> FAST else BOUNDED\"\n  => \"primary classifier: |R| (component size); dvar_R disambiguates mid-band only\"\n  => \"this is more conservative than AE original (which used dvar alone)\"", source_file: "atlas.n6", source_line: 25379, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s3-tick3-AG-mechanism-formal-refinement"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s3-tick3-AG-AF-cohort-recovery", raw: "@C clay-cascade-s3-tick3-AG-AF-cohort-recovery :: meta [4!]\n  <- clay-cascade-s3-tick3-AG-classification-rule\n  => \"★ AF 7-mixer cohort 7/7 = 100% match (vs AF tick-2 5/7 = 71.4%):\"\n  => \"format: mixer | |R| | dvar_R | V(8) | predicted | measured | OK?\"\n  => \"M1: |R|=13 dvar_R=2.31 V(8)=13 BOUNDED BOUNDED YES\"\n  => \"M2: |R|=13 dvar_R=2.31 V(8)=13 BOUNDED BOUNDED YES (was MISS in AF)\"\n  => \"M3: |R|=7  dvar_R=1.71 V(8)=7  FAST    FAST    YES\"\n  => \"M4: |R|=40 dvar_R=2.10 V(8)=40 BOUNDED BOUNDED YES (was MISS in AF)\"\n  => \"M5: |R|=10 dvar_R=1.20 V(8)=10 FAST    FAST    YES\"\n  => \"C1: |R|=64 dvar_R=0.00 V(8)=64 FULL    FULL    YES\"\n  => \"C2: |R|=64 dvar_R=0.00 V(8)=64 FULL    FULL    YES\"", source_file: "atlas.n6", source_line: 25388, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s3-tick3-AG-classification-rule"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
