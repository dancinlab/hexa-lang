    AtlasNode { kind: "C", id: "axis-j-row-example-3-supersession-graph-query", raw: "@C axis-j-row-example-3-supersession-graph-query :: meta [4!]\n  <- axis-j-primitive-definition\n  => \"row example #3 — axis-I × axis-J COMPOSITION: query supersession ancestry\"\n  => \"  PROPOSED (composes axis-I <-* with axis-J superseded_by field):\"\n  => \"    @C anima-cxp-r34-supersession-ancestry :: meta [4]\"\n  => \"      <-* superseded_by                      # axis-I transitive closure over axis-J body-field\"\n  => \"      => \\\\\\\\\"all rows transitively superseded by R34 — answers 'why was R34 deprecated?' from atlas.n6 alone\\\\\\\\\"\"\n  => \"  expansion at lint-time: <-* superseded_by walks the back-pointer graph from R34, collecting {R38, R36 (if cross-link), ...}\"\n  => \"  this row CANNOT EXIST without BOTH axes — concrete demonstration of axis-I/J co-design payoff\"\n  => \"  raw 91 C3 honest: this example is SPECULATIVE — no <-* lint-implementation exists yet (axis-I § final-state PROPOSAL-NOT-ACTUATED), so this row's evaluation is a DSL design illustration only\"", source_file: "atlas.n6", source_line: 23873, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["axis-j-primitive-definition"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "axis-j-orthogonality-analysis", raw: "@C axis-j-orthogonality-analysis :: meta [4!]\n  <- axis-j-primitive-definition\n  -> axis-j-vs-D-meta-tag\n  -> axis-j-vs-E-arrow-poly\n  -> axis-j-vs-F-K-ceiling\n  -> axis-j-vs-G-body-field\n  -> axis-j-vs-H-id-convention\n  -> axis-j-vs-I-graph-query\n  => \"VERDICT: COMPOSES with all 6 prior axes. ZERO interference (unlike axis-I which had mild K-ceiling pressure on F). Axis-J was DELIBERATELY designed to live in axes D/E/G namespaces, leaving F arrow-budget untouched.\"", source_file: "atlas.n6", source_line: 23884, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["axis-j-primitive-definition"], derives: ["axis-j-vs-D-meta-tag", "axis-j-vs-E-arrow-poly", "axis-j-vs-F-K-ceiling", "axis-j-vs-G-body-field", "axis-j-vs-H-id-convention", "axis-j-vs-I-graph-query"], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "axis-j-vs-D-meta-tag", raw: "@C axis-j-vs-D-meta-tag :: meta [4]\n  <- axis-j-orthogonality-analysis\n  => \"axis-D (@-type prefix). axis-J adds NO new @-types. Existing @? for hypothesis-status, @F for formula, @R for relation all accept the new meta-tag suffix unchanged. SYNERGY: axis-D meta-tag-layering reading is enriched — [DEPRECATED YYYY-MM-DD] joins the existing [d.r], [N*], [N!], [N?] family as a fifth tag-shape.\"", source_file: "atlas.n6", source_line: 23894, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["axis-j-orthogonality-analysis"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "axis-j-vs-E-arrow-poly", raw: "@C axis-j-vs-E-arrow-poly :: meta [4]\n  <- axis-j-orthogonality-analysis\n  => \"axis-E (arrow polymorphism). axis-J adds ONE arrow ONLY INSIDE GRADE BRACKETS — [9?→DEPRECATED] — which is grade-internal, not row-level. axis-E row-level arrow set {<-, ->, =>, ==, ~>, |>, !!, -|} unchanged. ZERO LL(1) leading-char addition. SYNERGY: the grade-internal → is formally distinct from row-level → (different lexer state), so axis-E parser separation is reinforced.\"", source_file: "atlas.n6", source_line: 23898, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["axis-j-orthogonality-analysis"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "axis-j-vs-F-K-ceiling", raw: "@C axis-j-vs-F-K-ceiling :: meta [4!]\n  <- axis-j-orthogonality-analysis\n  => \"axis-F (arrow K-ceiling). PRIOR CONCERN (axis-I synthesis line 30516): 'next-axis-J would HIT axis-F K-ceiling and force arrow-grammar redesign.' MEASURED RESULT: axis-J pick (g) AVOIDS this. axis-F K_arrow stays at K=10 post-axis-I (8 row-level + 2 axis-I suffix-on-existing). Axis-J adds ZERO row-level arrows. K-ceiling pressure: 0%. SYNERGY: axis-J is the EXISTENCE PROOF that 'next axis must hit K-ceiling' was a pessimistic prediction — the meta-tag/body-field namespaces have headroom even when the arrow namespace is saturated.\"\n  => \"honest disclosure: this is true ONLY because (g) was chosen over alternatives (a/d/e/f) which WOULD have added arrow-family tokens. Picking the right axis-J is precisely what avoided K-ceiling pressure.\"", source_file: "atlas.n6", source_line: 23902, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["axis-j-orthogonality-analysis"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "axis-j-vs-G-body-field", raw: "@C axis-j-vs-G-body-field :: meta [4!]\n  <- axis-j-orthogonality-analysis\n  => \"axis-G (body-field schema). axis-J adds 2 body-fields: superseded_by, supersession_reason. axis-F K_core audit ranks superseded_by as RANK-1 highest-value addition (line 28968: 'closes a MEASURED gap; zero ambiguity; adoption cost LOW ~8.5 min'). axis-G K_core: 13 → 15 after axis-J — well within axis-G estimated 20-30 ceiling. SYNERGY: axis-J is the FIRST CONSUMER of the rank-1 axis-F recommendation — completes a planning loop opened in the synthesis shard.\"", source_file: "atlas.n6", source_line: 23907, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["axis-j-orthogonality-analysis"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "axis-j-vs-H-id-convention", raw: "@C axis-j-vs-H-id-convention :: meta [4]\n  <- axis-j-orthogonality-analysis\n  => \"axis-H (id-convention). superseded_by accepts a SLUG; axis-H slug-stability is the prerequisite. SYNERGY: axis-J motivates axis-H stability — if a slug renames, all superseded_by pointers must update (lint check). axis-H § slug-rename-cost just got a concrete consumer.\"\n  => \"INTERFERENCE check: axis-H allows id renames over time (e.g. id-convention-evolution); axis-J creates LONG-LIVED back-pointers that must survive renames. MITIGATION: axis-H must add a 'rename-shadow' alias mechanism OR axis-J body-field must accept multi-slug history. DEFER to next cycle — flag noted, not blocking for axis-J registration.\"", source_file: "atlas.n6", source_line: 23911, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["axis-j-orthogonality-analysis"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "axis-j-vs-I-graph-query", raw: "@C axis-j-vs-I-graph-query :: meta [4!]\n  <- axis-j-orthogonality-analysis\n  => \"axis-I (graph-query primitives). STRONG MUTUAL COMPLETION. axis-I gives <-* / ->* / <~> over arrow DAG. axis-J gives superseded_by body-field. composition: <-* superseded_by reconstructs supersession ancestry (row example #3). NEITHER axis is fully useful without the other for this query: axis-I alone has no supersession edges to walk; axis-J alone has back-pointers but no closure operator. PROOF that axes I and J were correctly sequenced.\"\n  => \"axis-I final-state was PROPOSAL-NOT-ACTUATED (line 30547). axis-J inherits that status — both wait on a real lint-tool implementation. THIS shard is design, not actuation.\"", source_file: "atlas.n6", source_line: 23916, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["axis-j-orthogonality-analysis"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "axis-j-raw-117-5-check-results", raw: "@C axis-j-raw-117-5-check-results :: meta [4!]\n  <- axis-j-primitive-definition\n  -> axis-j-5-check-1-genus-slug\n  -> axis-j-5-check-2-frameworks-cite\n  -> axis-j-5-check-3-realization-channels\n  -> axis-j-5-check-4-counter-example\n  -> axis-j-5-check-5-novelty-falsifier\n  => \"VERDICT: 5/5 PASS. axis-J registration gate cleared at registration time.\"", source_file: "atlas.n6", source_line: 23921, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["axis-j-primitive-definition"], derives: ["axis-j-5-check-1-genus-slug", "axis-j-5-check-2-frameworks-cite", "axis-j-5-check-3-realization-channels", "axis-j-5-check-4-counter-example", "axis-j-5-check-5-novelty-falsifier"], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "axis-j-5-check-1-genus-slug", raw: "@C axis-j-5-check-1-genus-slug :: meta [4]\n  <- axis-j-raw-117-5-check-results\n  status = PASS\n  genus = \"intrinsic-supersession-DSL\"\n  slug = \"atlas-self-arch-supersession-evolution\"\n  citation = \"follows axis-H id-convention: domain-axis-tag pattern; 'evolution' suffix matches axis-I (graph-query-evolution) sibling shard\"", source_file: "atlas.n6", source_line: 23930, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["axis-j-raw-117-5-check-results"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "axis-j-5-check-2-frameworks-cite", raw: "@C axis-j-5-check-2-frameworks-cite :: meta [4]\n  <- axis-j-raw-117-5-check-results\n  status = PASS\n  framework_1 = \"Lamport (1978) Time/Clocks/Ordering — happens-before primitive applied to row-supersession ordering. CITED-AND-MOVED-ON: atlas.n6's superseded_by is a static back-pointer, NOT a vector clock; we do not import distributed-system semantics.\"\n  framework_2 = \"W3C OWL2 owl:deprecated property + Semantic Versioning DEPRECATED annotation. CITED-AND-MOVED-ON: both use a single boolean flag; atlas.n6's [DEPRECATED YYYY-MM-DD] / [RETIRED YYYY-MM-DD] / [RETIRED_INCONCLUSIVE] / [SUPERSEDED] quartet is FINER than either, with date stamping not present in OWL2.\"\n  framework_3 = \"RFC 8174 BCP 14 'OBSOLETES' header (RFC supersession registry). CITED-AND-MOVED-ON: RFC OBSOLETES is also a forward-pointer between document IDs — atlas.n6's superseded_by has the same shape but operates on @-row slugs, not document numbers. PRECEDENT, not import.\"\n  citation_count = 3 (exceeds the 2+ requirement)", source_file: "atlas.n6", source_line: 23937, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["axis-j-raw-117-5-check-results"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "axis-j-5-check-3-realization-channels", raw: "@C axis-j-5-check-3-realization-channels :: meta [4]\n  <- axis-j-raw-117-5-check-results\n  status = PASS\n  channel_1 = \"META-TAG channel — [DEPRECATED YYYY-MM-DD] inline tag (already attested 4 rows, formalised by axis-J)\"\n  channel_2 = \"BODY-FIELD channel — superseded_by = <slug> (axis-G family, NEW from axis-J)\"\n  channel_3 = \"GRADE-SUFFIX channel — [9?→DEPRECATED] / [10*RETIRED_INCONCLUSIVE] (already attested 2 rows, formalised by axis-J as the grade-internal arrow position)\"\n  channel_count = 3 (meets the 3+ requirement exactly; could add channel_4 = commit-message back-link cited from supersession_reason field)", source_file: "atlas.n6", source_line: 23945, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["axis-j-raw-117-5-check-results"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "axis-j-5-check-4-counter-example", raw: "@C axis-j-5-check-4-counter-example :: meta [4]\n  <- axis-j-raw-117-5-check-results\n  status = PASS\n  counter_example = \"ANIMA-CXP-R38-R34-T1-RETIRED-INCONCLUSIVE (line 22060). This row uses [10*RETIRED_INCONCLUSIVE] in grade and supersedes R34 — but R38 is itself the RESULT of testing R34, not a REPLACEMENT for R34's claim. axis-J superseded_by would WRONGLY suggest 'R34 was replaced by R38' if applied naively. CORRECT semantics: R34's superseded_by points to R38 only in the 'this is the verdict on R34' sense, NOT 'R38 is the new claim.' RESOLUTION: supersession_reason field carries the disambiguation (\\\\\\\\\"verdict-on, not replacement-for\\\\\\\\\").\"\n  counter_example_lesson = \"axis-J supersession is NOT a single-relation; it requires the supersession_reason field to disambiguate {replacement, verdict, refinement, retraction}. Rejecting this nuance would make axis-J too coarse. PASS by demonstrating the disambiguation is built-in via supersession_reason.\"", source_file: "atlas.n6", source_line: 23953, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["axis-j-raw-117-5-check-results"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "axis-j-5-check-5-novelty-falsifier", raw: "@C axis-j-5-check-5-novelty-falsifier :: meta [4]\n  <- axis-j-raw-117-5-check-results\n  status = PASS\n  novelty_claim = \"axis-J's superseded_by body-field is novel within atlas.n6 (zero current uses, 0 collisions per axis-F audit line 28533-28538 style mea... [truncated, full=1135bytes]", source_file: "atlas.n6", source_line: 23959, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["axis-j-raw-117-5-check-results"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
