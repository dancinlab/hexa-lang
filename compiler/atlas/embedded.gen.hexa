    AtlasNode { kind: "C", id: "clay-cascade-s8-AN-22-new-mixer-cohort", raw: "@C clay-cascade-s8-AN-22-new-mixer-cohort :: meta [4]\n  <- clay-cascade-s8-tick1-AN-K3-DENIED-AT-SCALE-witness\n  => \"22 NEW D=3 mixers systematic gcd(A, 64) sampling (disjoint from cascade-s3 AF/AH cohorts):\"\n  => \"format: nbr(i, axis) = (i*A + axis*B + C) mod 64; gcd-class N: count\"\n  => \"gcd=1 (n=4): N01(3,17,5) N02(5,9,13) N03(7,29,3) N04(11,13,21)\"\n  => \"gcd=2 (n=4): N05(2,15,7) N06(6,21,11) N07(10,7,17) N08(14,25,9)\"\n  => \"gcd=4 (n=4): N09(4,11,19) N10(28,13,5) N11(36,17,23) N12(44,5,29)\"\n  => \"gcd=8 (n=4): N13(8,21,11) N14(24,5,3) N15(40,19,13) N16(56,23,7)\"\n  => \"gcd=16 (n=3): N17(16,11,25) N18(48,5,13) N19(16,29,19)\"\n  => \"gcd=32 (n=3): N20(32,7,17) N21(32,19,9) N22(32,25,5)\"\n  => \"(combined with cascade-s2/s3 18-cohort = total n=40)\"", source_file: "atlas.n6", source_line: 26169, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s8-tick1-AN-K3-DENIED-AT-SCALE-witness"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s8-AN-cohort-statistics", raw: "@C clay-cascade-s8-AN-cohort-statistics :: meta [4]\n  <- clay-cascade-s8-AN-22-new-mixer-cohort\n  => \"★ n=40 combined cohort statistics:\"\n  => \"axis-13 (phi/pi): mean=85.1, sd=813.1, range=[-2239, 2889] (calabi6 + 22-cohort outliers)\"\n  => \"axis-14 (Renyi-2 IC=16): mean=0.513, sd=0.229, range=[0.0002, 0.6931]\"\n  => \"axis-16 (V(8) src=32): mean=41.05, sd=24.58, range=[7, 64]\"\n  => \"marginal correlations strengthened with larger cohort:\"\n  => \"  a14×a13: Pearson=-0.534, Spearman=-0.597 (vs n=18: -0.536/-0.483)\"\n  => \"  a14×a16: Pearson=-0.198, Spearman=-0.222\"\n  => \"  a13×a16: Pearson=+0.215, Spearman=-0.002\"", source_file: "atlas.n6", source_line: 26181, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s8-AN-22-new-mixer-cohort"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s8-AN-OLS-refit-n40", raw: "@C clay-cascade-s8-AN-OLS-refit-n40 :: meta [4]\n  <- clay-cascade-s8-AN-cohort-statistics\n  => \"OLS refit at n=40: a14_R2 = β·a13 + α + ε\"\n  => \"  β = -1.506e-4 (vs n=18: -1.63e-4 — similar magnitude)\"\n  => \"  α = +0.5256 (vs n=18: +0.4055)\"\n  => \"  sd(perp) = 0.194\"\n  => \"Gate B point estimates LOOKED promising:\"\n  => \"  |Pearson(perp, a16)| = 0.099 PASS at threshold 0.30\"\n  => \"  |Spearman(perp, a16)| = 0.033 PASS\"\n  => \"Gate A: |P|=0.000 (exact OLS), |S|=0.113 PASS\"\n  => \"Gate C: discrimination = 0.378 PASS\"", source_file: "atlas.n6", source_line: 26192, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s8-AN-cohort-statistics"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s8-AN-bootstrap-n40-FAIL", raw: "@C clay-cascade-s8-AN-bootstrap-n40-FAIL :: meta [4!]\n  <- clay-cascade-s8-AN-OLS-refit-n40\n  => \"★ BOOTSTRAP n=40 (B=1000, seed=8) DEFINITIVE FAIL:\"\n  => \"  |Pearson(perp, a16)| 95% CI: [0.007, 0.419] — UPPER 0.419 EXCEEDS 0.30 threshold\"\n  => \"  |Spearman(perp, a16)| 95% CI: [0.008, 0.396] — UPPER 0.396 EXCEEDS 0.30 threshold\"\n  => \"  median values: Pearson=0.139, Spearman=0.120\"\n  => \"  empirical SE: |P|=0.111, |S|=0.104\"\n  => \"★ KEY: at n=40, SE narrowed from n=18 ~0.24 to ~0.11 (predicted ~0.16, achieved better due to wider a16 cohort spread)\"\n  => \"★ 39% of bootstrap mass above 0.30 threshold — CLEAN FAIL SIGNAL at narrowed SE\"\n  => \"  not noise-floor artifact: genuine resampling distribution places non-trivial probability mass above 0.30\"", source_file: "atlas.n6", source_line: 26204, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s8-AN-OLS-refit-n40"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s8-AN-K2-STRONG-provably-FINAL", raw: "@C clay-cascade-s8-AN-K2-STRONG-provably-FINAL :: meta [4!]\n  <- clay-cascade-s8-AN-bootstrap-n40-FAIL\n  => \"★ CASCADE-S8 CLOSED: K=2 STRONG provably FINAL\"\n  => \"K=3 promotion DENIED AT SCALE — fails strict bootstrap criterion at narrower SE\"\n  => \"axis-14_perp residual coupling to axis-16 V(8) SURVIVES larger cohort\"\n  => \"  → coupling is INTRINSIC, not statistical artifact\"\n  => \"  → no estimator design can break it without violating Gate B\"\n  => \"K=2 STRONG (axis-13 + axis-16) is operationally final order\"\n  => \"Reorient subsequent cascades toward K=2 internal structure (mechanism + cross-cascade applications)\"\n  => \"raw 71 18th finding: cohort-expansion definitive negative\"\n  => \"  AL→AM cycle (provisional promote → robustness revert) extended to AL→AM→AN (scale-verify revert)\"", source_file: "atlas.n6", source_line: 26215, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s8-AN-bootstrap-n40-FAIL"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s8-AN-five-cascade-K3-investigation-closure", raw: "@C clay-cascade-s8-AN-five-cascade-K3-investigation-closure :: meta [4!]\n  <- clay-cascade-s8-AN-K2-STRONG-provably-FINAL\n  => \"★ 5-CASCADE K=3 INVESTIGATION CONVERGES on K=2 STRONG FINAL:\"\n  => \"  cascade-s2 R (tick-4): K=3 DENIED via raw a14 (boundary IC, structural coupling)\"\n  => \"  cascade-s5 AK (tick-2): K=3 DENIED-ROBUST via raw a14 (non-boundary IC, coupling persists)\"\n  => \"  cascade-s6 AL (tick-1): K=3 PROMOTED via OLS residual a14_perp (thin margin n=18)\"\n  => \"  cascade-s7 AM (tick-1): K=3 REVERTED via 4-method robustness (1/4 PASS at n=18)\"\n  => \"  cascade-s8 AN (tick-1, this): K=3 DENIED AT SCALE via n=40 bootstrap (39% mass>0.30)\"\n  => \"5 cascades + 7 distinct sub-agents (R, AK, AL, AM, AN + AJ + AB R-extended) all converge on K=2 STRONG\"\n  => \"this IS the cascade discipline complete answer to K=3 question for this substrate\"\n  => \"future K=3 attempt would require: (1) fundamentally different observable, (2) larger cohort n>=100, OR (3) different substrate (D!=3, sigma!=64)\"", source_file: "atlas.n6", source_line: 26227, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s8-AN-K2-STRONG-provably-FINAL"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s8-AN-cascade-position-final", raw: "@C clay-cascade-s8-AN-cascade-position-final :: meta [4]\n  <- clay-cascade-s8-tick1-AN-K3-DENIED-AT-SCALE-witness\n  => \"cascade map this session (8 cascades, 34 sub-agents, 18 raw 71 findings):\"\n  => \"  s2 axis-13 universality (24 agents) closed: continuum 1D+3D+phi^4\"\n  => \"  s3 axis-16 mechanism (4 agents) closed: src-cond directed in-deg + |R|\"\n  => \"  s4 joint signature (1 agent) closed-NEGATIVE: non-synergistic\"\n  => \"  s5 axis-14 K=3 IC retest (2 agents) closed-DENIED-ROBUST\"\n  => \"  s6 axis-14_perp K=3 (1 agent) PROMOTED-thin → s7 review\"\n  => \"  s7 K=3 robustness (1 agent) REVERTED at n=18\"\n  => \"  s8 K=3 cohort-expansion (1 agent, this AN) DENIED AT SCALE n=40\"\n  => \"K=2 STRONG (axis-13 + axis-16) operationally + provably FINAL\"", source_file: "atlas.n6", source_line: 26239, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s8-tick1-AN-K3-DENIED-AT-SCALE-witness"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s8-AN-18-cumulative-findings", raw: "@C clay-cascade-s8-AN-18-cumulative-findings :: meta [4]\n  <- clay-cascade-s8-AN-K2-STRONG-provably-FINAL\n  => \"18 cumulative raw 71 findings session-wide:\"\n  => \"  s2 (11): hypothesis narrowings + axis-15 retract + cartoon 9-cell reject + ...\"\n  => \"  s3 (1): AF→AG src-cond directed in-deg refinement\"\n  => \"  s4 (1): joint signature NEGATIVE non-synergistic\"\n  => \"  s2 (1): X axis-17 SymDef RETIRED\"\n  => \"  s5 (2): AJ K=3 reopen + AK K=3 denied-robust IC level\"\n  => \"  s6 (1): AL K=3 PROMOTE thin margin\"\n  => \"  s7 (1): AM K=3 DOWNGRADE/REVERT\"\n  => \"  s8 (1) THIS: AN K=3 DENIED AT SCALE n=40\"\n  => \"= 18 findings: 12 narrow + 1 negative + 1 retire + 2 special + 1 promote + 2 revert\"\n  => \"AL→AM→AN is unique 3-step cycle: provisional promote → robustness revert → scale-verify revert\"", source_file: "atlas.n6", source_line: 26251, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s8-AN-K2-STRONG-provably-FINAL"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
