    AtlasNode { kind: "C", id: "clay-iter-38-multi-observable-dim-correlation-MULTI-FINGERPRINT", raw: "@C clay-iter-38-multi-observable-dim-correlation-MULTI-FINGERPRINT :: meta [4!]\n  <- iter-36-phi-pi-r-0.99\n  <- iter-37-multi-tick-narrowing\n  -> iter-38-5-observable-test-at-ticks-64\n  => \"5 observables × 3 dimensions × 20 topologies = 100 data points\"\n  => \"3 of 5 observables show monotone dimension correlation:\"\n  => \"  phi/pi: r=+0.99 (INCREASING with D) — iter-36 reconfirmed\"\n  => \"  max/avg: r=-0.77 (DECREASING with D)\"\n  => \"  correl: r=-0.71 (DECREASING with D)\"\n  => \"2 of 5 observables non-monotone:\"\n  => \"  T/V: r=-0.46 (cartoon outlier)\"\n  => \"  pair: r=+0.66 (curved/bridge effects)\"", source_file: "atlas.n6", source_line: 21447, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["iter-36-phi-pi-r-0.99", "iter-37-multi-tick-narrowing"], derives: ["iter-38-5-observable-test-at-ticks-64"], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
