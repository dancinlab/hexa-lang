    AtlasNode { kind: "C", id: "clay-cascade-s5-AJ-3-IC-sweep-table", raw: "@C clay-cascade-s5-AJ-3-IC-sweep-table :: meta [4]\n  <- clay-cascade-s5-tick1-AJ-axis-14-K3-REOPENED-witness\n  => \"format: topology | i=16 (p/Sh/R2) | i=32 (p/Sh/R2 control) | i=48 (p/Sh/R2)\"\n  => \"flat:       0.9999/4/0.0002    | 0.4317/981/0.675   | 0.0003/0/0.0006\"\n  => \"t3:         0.7955/652/0.394   | 0.3026/843/0.548   | 0.2046/650/0.394\"\n  => \"s3:         0.5679/982/0.675   | 0.3926/953/0.648   | 0.2066/654/0.397\"\n  => \"blackhole:  0.8050/628/0.377   | 0.3286/882/0.582   | 0.1677/556/0.327\"\n  => \"wormhole:   0.9999/4/0.0002    | 0.3796/941/0.637   | 0.0000/0/0.0000\"\n  => \"ads-cft:    0.6489/912/0.608   | 0.4670/996/0.689   | 0.3541/915/0.611\"\n  => \"calabi6:    0.9998/4/0.0004    | 0.3780/940/0.635   | 0.0003/0/0.0006\"\n  => \"cartoon:    0.8581/487/0.279   | 0.3944/955/0.650   | 0.1119/395/0.222\"\n  => \"brane:      0.7839/680/0.414   | 0.2511/752/0.472   | 0.2158/675/0.413\"\n  => \"de-sitter:  0.9476/201/0.105   | 0.5024/1000/0.693  | 0.0710/264/0.141\"", source_file: "atlas.n6", source_line: 25638, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s5-tick1-AJ-axis-14-K3-REOPENED-witness"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s5-AJ-discrimination-restored", raw: "@C clay-cascade-s5-AJ-discrimination-restored :: meta [4!]\n  <- clay-cascade-s5-AJ-3-IC-sweep-table\n  => \"★ DISCRIMINATION (stddev/mean) per IC center:\"\n  => \"  i=16 non-boundary: p disc=0.171, Shannon disc=0.786, Renyi-2 disc=0.837\"\n  => \"  i=32 boundary control: p disc=0.186, Shannon disc=0.080, Renyi-2 disc=0.106\"\n  => \"  i=48 non-boundary: p disc=0.838, Shannon disc=0.766, Renyi-2 disc=0.803\"\n  => \"Shannon range: i=32 [752, 1000] (saturated near 1000); i=16 [4, 982]; i=48 [0, 915]\"\n  => \"saturation-band [0.40, 0.60] count: i=32 3/10; i=16 1/10; i=48 0/10\"\n  => \"non-boundary IC mass shifts AWAY from p=0.5: mean i=16 0.841 / i=48 0.133 vs i=32 0.383\"", source_file: "atlas.n6", source_line: 25652, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s5-AJ-3-IC-sweep-table"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s5-AJ-IC-cut-alignment-saturation", raw: "@C clay-cascade-s5-AJ-IC-cut-alignment-saturation :: meta [4!]\n  <- clay-cascade-s5-AJ-discrimination-restored\n  => \"★ MECHANISM IDENTIFIED: IC-cut alignment saturation\"\n  => \"wavepacket center coincident with bipartite cut location (i=32 = cut location)\"\n  => \"  Gaussian symmetry forces p->0.5 regardless of topology\"\n  => \"  neighbor-graph dynamics cannot break IC-imposed symmetry within 64 ticks\"\n  => \"moving center OFF the cut (i=16 -> mass left of cut -> p->1; i=48 -> mass right -> p->0)\"\n  => \"  creates asymmetric initial bipartite weight\"\n  => \"  topology-dependent transport rates across the cut become observable in late-time p\"\n  => \"  discrimination ∝ |center - cut| heuristic\"\n  => \"prediction: any cut location ≠ wavepacket center recovers discrimination\"", source_file: "atlas.n6", source_line: 25662, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s5-AJ-discrimination-restored"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
