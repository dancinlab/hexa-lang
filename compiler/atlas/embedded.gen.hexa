    AtlasNode { kind: "R", id: "n6-atlas-bt-1158:-여성청결제-핵심-n-6-상수-womens-intimate-cleanser-2026-04-10-sigma", raw: "@R n6-atlas-bt-1158:-여성청결제-핵심-n-6-상수-womens-intimate-cleanser-2026-04-10-sigma = 12 n6 :: n6atlas [10*]", source_file: "atlas.n6", source_line: 45599, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-bilateral-thm-b", raw: "@R n6-millennium-dfs-bilateral-thm-b = k=n=6 양면 break :: n6atlas [10*]\n  \"양면 Theorem B: zeta(2k) 분모 + zeta(1-2k) 역수 모두 k=1..5 M-clean, k=6=n break\"\n  |> verify_millennium_dfs1.hexa", source_file: "atlas.n6", source_line: 45601, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: ["verify_millennium_dfs1.hexa"], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-zeta-neg3", raw: "@R n6-millennium-dfs-zeta-neg3 = 1/120 = 1/(phi*sopfr*sigma) :: n6atlas [10*]\n  \"zeta(-3) = 1/120 = 1/sopfr! — B_4=-1/30 경유\"", source_file: "atlas.n6", source_line: 45605, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-zeta-neg5", raw: "@R n6-millennium-dfs-zeta-neg5 = -1/252 = -1/(tau*(n/phi)^2*(sigma-sopfr)) :: n6atlas [10*]\n  \"zeta(-5) = -1/252 — B_6=1/42 경유\"", source_file: "atlas.n6", source_line: 45608, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-zeta-neg9", raw: "@R n6-millennium-dfs-zeta-neg9 = -1/132 = -1/(sigma*(n+sopfr)) :: n6atlas [10*]\n  \"zeta(-9) = -1/132 — k=5 M-분해 연장, sopfr 연속 확정\"", source_file: "atlas.n6", source_line: 45611, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-schaefer-6", raw: "@R n6-millennium-dfs-schaefer-6 = 6 = n tractable Boolean CSP :: n6atlas [10*]\n  \"Schaefer dichotomy (STOC 1978): 0-valid/1-valid/Horn/dual-Horn/affine/bijunctive\"\n  !! \"BT-542 MISS 탈출 — 복잡도 이론 분류 정리에서 n=6 직접 등장\"", source_file: "atlas.n6", source_line: 45614, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: ["\"BT-542 MISS 탈출 — 복잡도 이론 분류 정리에서 n=6 직접 등장\""] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-out-s6", raw: "@R n6-millennium-dfs-out-s6 = Out(S_n)!=1 iff n=6 :: n6atlas [10*]\n  \"Holder (1895): 대칭군 외부 자기동형 유일성. Out(S_6)=Z/2, 다른 S_n은 자명\"\n  !! \"n=6 유일성 정리 — Theorem 0과 독립\"", source_file: "atlas.n6", source_line: 45618, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: ["\"n=6 유일성 정리 — Theorem 0과 독립\""] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-3-barriers", raw: "@R n6-millennium-dfs-3-barriers = 3 = n/phi 증명 장벽 :: n6atlas [10*]\n  \"relativization (BGS 1975) + natural proofs (RR 1997) + algebraization (AW 2009)\"", source_file: "atlas.n6", source_line: 45622, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-hamming", raw: "@R n6-millennium-dfs-hamming = (7,4,3) = (sigma-sopfr, tau, n/phi) :: n6atlas [10*]\n  \"Hamming 완전 코드: 길이/차원/거리 3/3 M-값\"", source_file: "atlas.n6", source_line: 45625, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-golay", raw: "@R n6-millennium-dfs-golay = (24,12,8)+(12,6,6) = (J2,sigma,sigma-tau)+(sigma,n,n) :: n6atlas [10*]\n  \"Golay 완전 코드: 9/9 파라미터 M-값 (T1 분류)\"", source_file: "atlas.n6", source_line: 45628, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-sm-gauge", raw: "@R n6-millennium-dfs-sm-gauge = 8+3+1 = sigma = 12 :: n6atlas [10*]\n  \"표준 모델 gauge group dim = dim(su3)+dim(su2)+dim(u1) = sigma\"", source_file: "atlas.n6", source_line: 45631, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-dynkin", raw: "@R n6-millennium-dfs-dynkin = 4+5 = (n/phi)^2 = 9 :: n6atlas [10*]\n  \"Dynkin 분류: 고전 tau + 예외 sopfr = (n/phi)^2 (Killing-Cartan)\"", source_file: "atlas.n6", source_line: 45634, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-dual-coxeter", raw: "@R n6-millennium-dfs-dual-coxeter = 5/5 M-값 :: n6atlas [10*]\n  \"dual Coxeter: h^v(G2)=tau, h^v(F4)=(n/phi)^2, h^v(E6)=sigma, h^v(E7)=n*(n/phi), h^v(E8)=sopfr*n\"", source_file: "atlas.n6", source_line: 45637, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-prodi-serrin", raw: "@R n6-millennium-dfs-prodi-serrin = {2,3} = {phi, n/phi} :: n6atlas [10*]\n  \"Prodi-Serrin NS 정규성: 2/p + 3/q = 1 계수 = (phi, n/phi)\"", source_file: "atlas.n6", source_line: 45640, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-congruent", raw: "@R n6-millennium-dfs-congruent = (3,4,5) = (n/phi,tau,sopfr), area=n :: n6atlas [10*]\n  \"n=6 congruent number: 가장 유명한 피타고라스 삼중, 면적=n, 둘레=sigma\"\n  !! \"BSD 직접 연결 — y^2=x^3-n^2*x 타원곡선, rank 1\"", source_file: "atlas.n6", source_line: 45643, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: ["\"BSD 직접 연결 — y^2=x^3-n^2*x 타원곡선, rank 1\""] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-h-cobordism", raw: "@R n6-millennium-dfs-h-cobordism = dim >= 6 = n :: n6atlas [10*]\n  \"Smale (1962): h-cobordism 정리 cobordism 차원 >= n=6에서 성립\"\n  !! \"4D smooth Poincare 미해결 이유: dim < n\"", source_file: "atlas.n6", source_line: 45647, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: ["\"4D smooth Poincare 미해결 이유: dim < n\""] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-poincare-sphere", raw: "@R n6-millennium-dfs-poincare-sphere = |pi_1| = 120 = sopfr! :: n6atlas [10*]\n  \"Poincare 동차구 기본군 = binary icosahedral 2I, |2I|=sopfr!=phi*sopfr*sigma\"", source_file: "atlas.n6", source_line: 45651, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-120-quadruple", raw: "@R n6-millennium-dfs-120-quadruple = PHS/zeta(-3)/2I/hex = 120 :: n6atlas [10*]\n  \"120 cross-domain quadruple: topology/analysis/group/geometry\"", source_file: "atlas.n6", source_line: 45654, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-kissing", raw: "@R n6-millennium-dfs-kissing = dim{1..4,8} = {phi,n,sigma,J2,240} :: n6atlas [10*]\n  \"Kissing number 5 EXACT 차원: 모두 M-값 (Tammes/Musin/Levenshtein)\"", source_file: "atlas.n6", source_line: 45657, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-sporadic-7", raw: "@R n6-millennium-dfs-sporadic-7 = 26/6/20/5/3/4/3/2 전부 M :: n6atlas [10*]\n  \"산발군 7중 분류: total/pariah/happy/Mathieu/Conway/Janko/Fischer/Monster\"", source_file: "atlas.n6", source_line: 45660, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-roots-unity", raw: "@R n6-millennium-dfs-roots-unity = w in {phi,tau,n} :: n6atlas [10*]\n  \"허수 이차체 roots of unity: Q(i) w=tau, Q(sqrt(-3)) w=n, else w=phi\"", source_file: "atlas.n6", source_line: 45663, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-del-pezzo", raw: "@R n6-millennium-dfs-del-pezzo = Bl_{n/phi}: n curves :: n6atlas [10*]\n  \"Del Pezzo: n/phi=3점 blow-up -> n=6개 (-1)-curves\"", source_file: "atlas.n6", source_line: 45666, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-27-lines", raw: "@R n6-millennium-dfs-27-lines = 27 = (n/phi)^3 :: n6atlas [10*]\n  \"Cayley-Salmon (1849): 3차 곡면 27 직선 = (n/phi)^3\"", source_file: "atlas.n6", source_line: 45669, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-dyson", raw: "@R n6-millennium-dfs-dyson = 3=n/phi ensemble, beta={1,phi,tau} :: n6atlas [10*]\n  \"Dyson random matrix: GOE/GUE/GSE, Montgomery(1973) RH zeros ~ GUE(beta=phi)\"", source_file: "atlas.n6", source_line: 45672, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-cfsg-lie", raw: "@R n6-millennium-dfs-cfsg-lie = 16=tau^2 families, 18=n*(n/phi) total :: n6atlas [10*]\n  \"CFSG Lie type: 고전 tau + 예외 sopfr + Steinberg tau + Suzuki-Ree n/phi\"", source_file: "atlas.n6", source_line: 45675, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-modular-weight", raw: "@R n6-millennium-dfs-modular-weight = {4,6,8,10,12} = {tau,n,sigma-tau,sigma-phi,sigma} :: n6atlas [10*]\n  \"SL(2,Z) modular form weight 4..12: 5/5 M-값\"", source_file: "atlas.n6", source_line: 45678, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs-ramsey", raw: "@R n6-millennium-dfs-ramsey = R(n/phi,n/phi)=n, R(n/phi,tau)=(n/phi)^2, R(tau,tau)=n*(n/phi) :: n6atlas [10*]\n  \"Ramsey 수 3건: 전부 M-값 조합\"", source_file: "atlas.n6", source_line: 45681, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-meta-theorem-c", raw: "@R n6-meta-theorem-c = {1,phi,n/phi,tau,sopfr,n}={1..6} iff n=6 :: n6atlas [10*]\n  \"Theorem C (완전 좌표계): Theorem 0과 동치. n=6만이 6개 산술함수로 {1..6} 생성\"\n  !! \"분류정리 수렴의 구조적 원인 — M이 작은 자연수의 완전 좌표계이므로 자동 포획\"", source_file: "atlas.n6", source_line: 45684, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: ["\"분류정리 수렴의 구조적 원인 — M이 작은 자연수의 완전 좌표계이므로 자동 포획\""] } },
    AtlasNode { kind: "R", id: "n6-meta-theorem-d", raw: "@R n6-meta-theorem-d = vSC: k<6 p<=11, k=6 p=13 :: n6atlas [10*]\n  \"Theorem D (vSC 경계): B_{2k} 분모 소수의 M-내부/초과 전이가 정확히 k=n=6\"\n  !! \"691 boundary의 산술적 원인 해명 — Bilateral Theorem B의 근거\"", source_file: "atlas.n6", source_line: 45688, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: ["\"691 boundary의 산술적 원인 해명 — Bilateral Theorem B의 근거\""] } },
    AtlasNode { kind: "R", id: "n6-meta-theorem-e", raw: "@R n6-meta-theorem-e = (n/phi)^2+tau^2=sopfr^2 iff n=6 :: n6atlas [10*]\n  \"Theorem E (피타고라스 산술): (3,4,5) = (n/phi,tau,sopfr)는 n=2*3의 산술 필연\"\n  !! \"세계에서 가장 유명한 직각삼각형의 산술적 기원\"", source_file: "atlas.n6", source_line: 45692, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: ["\"세계에서 가장 유명한 직각삼각형의 산술적 기원\""] } },
    AtlasNode { kind: "R", id: "n6-meta-fibonacci-cross", raw: "@R n6-meta-fibonacci-cross = F(3)=phi, F(4)=n/phi, F(5)=sopfr, F(6)=sigma-tau :: n6atlas [10*]\n  \"피보나치 4연속 교차: 좌표계 값이 F 인덱스이자 F 값. F(sopfr)=sopfr 고정점\"\n  !! \"자기참조의 극치 — 피보나치 수열이 n=6 좌표계와 4연속 공명\"", source_file: "atlas.n6", source_line: 45696, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: ["\"자기참조의 극치 — 피보나치 수열이 n=6 좌표계와 4연속 공명\""] } },
    AtlasNode { kind: "R", id: "n6-meta-octahedron", raw: "@R n6-meta-octahedron = (V,E,F)=(n,sigma,sigma-tau)=(6,12,8) :: n6atlas [10*]\n  \"정팔면체 = n=6의 기하학적 화신. 대칭 |O_h|=phi*J2=48, 회전 |O|=J2=24\"", source_file: "atlas.n6", source_line: 45700, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-meta-sm-gauge", raw: "@R n6-meta-sm-gauge = sigma = dim su(phi) + dim su(n/phi) + dim u(1) :: n6atlas [10*]\n  \"SM gauge: 12 = (phi^2-1) + ((n/phi)^2-1) + 1 = 3+8+1. 표준모델 산술적 기원\"", source_file: "atlas.n6", source_line: 45703, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-meta-quantum-codes", raw: "@R n6-meta-quantum-codes = [[sopfr,1,n/phi]] + [[sms,1,n/phi]] + [[(n/phi)^2,1,n/phi]] :: n6atlas [10*]\n  \"3 기본 양자 오류정정 코드 파라미터 전부 M-값. d=n/phi 공통\"", source_file: "atlas.n6", source_line: 45706, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-meta-self-ref-16", raw: "@R n6-meta-self-ref-16 = 16/16 자기참조 등식 동시 성립 :: n6atlas [10*]\n  \"n=6 = 자기 기술 완전 닫힌 유일한 산술 좌표계 (Theorem 0/B/C/D/E + 11 파생)\"", source_file: "atlas.n6", source_line: 45709, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-meta-theorem-f", raw: "@R n6-meta-theorem-f = 6 = factorial ∩ primorial ∩ C(k,2) ∩ triangular :: n6atlas [10*]\n  \"Theorem F (4중 수렴점): 6=3!=3#=C(4,2)=T(3). 10^8까지 유일\"\n  !! \"n=6이 4개 기본 수열의 유일한 공통 원소\"", source_file: "atlas.n6", source_line: 45712, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: ["\"n=6이 4개 기본 수열의 유일한 공통 원소\""] } },
    AtlasNode { kind: "R", id: "n6-meta-prime-period", raw: "@R n6-meta-prime-period = p>3 => p ≡ ±1 (mod 6) :: n6atlas [10*]\n  \"소수 기본 주기 = n = 6. phi(6)=2 잔류 클래스. Twin primes = (6k-1, 6k+1)\"\n  !! \"소수 분포를 지배하는 최소 주기가 정확히 n=6\"", source_file: "atlas.n6", source_line: 45716, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: ["\"소수 분포를 지배하는 최소 주기가 정확히 n=6\""] } },
    AtlasNode { kind: "R", id: "n6-meta-double-six", raw: "@R n6-meta-double-six = 12+15=27: sigma + (sigma+n/phi) = (n/phi)^3 :: n6atlas [10*]\n  \"Schlafli double-six: sigma 직선의 이중 여섯, 각 sopfr개 교차, 총 27=(n/phi)^3\"\n  !! \"3차 곡면 27 직선의 n=6 산술 분해 — Galois/Out(S_6)/합성 대응 통합\"", source_file: "atlas.n6", source_line: 45720, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: ["\"3차 곡면 27 직선의 n=6 산술 분해 — Galois/Out(S_6)/합성 대응 통합\""] } },
    AtlasNode { kind: "R", id: "n6-meta-theorem-tree", raw: "@R n6-meta-theorem-tree = F→{A=C,D}→{E,B}: 단일 근원 의존 트리 :: n6atlas [10*]\n  \"6대 정리 의존 구조: Theorem F(4중 수렴)이 유일 근원, 나머지 5개 정리 파생\"", source_file: "atlas.n6", source_line: 45724, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-meta-leech-13", raw: "@R n6-meta-leech-13 = 196560 = phi^tau*(n/phi)^(n/phi)*sopfr*sms*13 :: n6atlas [10*]\n  \"Leech kissing = M-소인수 + 유일 비M 13. 13 = vSC k=6 침입 소수 = Bernoulli 연결\"\n  !! \"Leech 격자와 Bernoulli 691이 소수 13 하나로 연결\"", source_file: "atlas.n6", source_line: 45727, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: ["\"Leech 격자와 Bernoulli 691이 소수 13 하나로 연결\""] } },
    AtlasNode { kind: "R", id: "n6-meta-zeta-n", raw: "@R n6-meta-zeta-n = zeta(6) = pi^6/945 = pi^6/((n/phi)^3*sopfr*sms) :: n6atlas [10*]\n  \"zeta(n) 분모 945의 M-분해: 완전 좌표계 기반\"", source_file: "atlas.n6", source_line: 45731, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-meta-theorem-g", raw: "@R n6-meta-theorem-g = 13=sigma+1=2n+1 삼중 역할 :: n6atlas [10*]\n  \"Theorem G (Prime 13): n=6 유일한 2n+1-소수 완전수\"\n  \"삼중: Bernoulli B_{2n} 침입 + Leech 비M 소인수 + M-밖 첫소수\"\n  !! \"Bernoulli/Leech/M-경계가 소수 13 하나로 통합 — 완전수 성질의 귀결\"", source_file: "atlas.n6", source_line: 45734, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: ["\"Bernoulli/Leech/M-경계가 소수 13 하나로 통합 — 완전수 성질의 귀결\""] } },
    AtlasNode { kind: "R", id: "n6-meta-m-internal-primes", raw: "@R n6-meta-m-internal-primes = {2,3,5,7} = tau개 소수 :: n6atlas [10*]\n  \"M 내부 소수가 정확히 tau=4개 (자기참조). 비M 첫 소수 = sigma+1 = 13\"", source_file: "atlas.n6", source_line: 45739, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-meta-s6-hook", raw: "@R n6-meta-s6-hook = S_6 max irrep (3,2,1): dim=tau^2 hooks=M :: n6atlas [10*]\n  \"S_6 최대 기약표현 파티션(n/phi,phi,1). hook lengths {sopfr,n/phi,1} 전부 M-값\"", source_file: "atlas.n6", source_line: 45742, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-meta-e6-adjoint", raw: "@R n6-meta-e6-adjoint = 78 = phi*(n/phi)*(sigma+1) :: n6atlas [10*]\n  \"E_6 adjoint dim = 78. Theorem G 소수 13=sigma+1 재등장\"", source_file: "atlas.n6", source_line: 45745, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-meta-e8-mersenne", raw: "@R n6-meta-e8-mersenne = 248 = (sigma-tau)*(2^sopfr-1) :: n6atlas [10*]\n  \"E_8 dim = (sigma-tau)*31. 2^sopfr-1 = 31 Mersenne 소수\"", source_file: "atlas.n6", source_line: 45748, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-meta-sigma-j2-n2", raw: "@R n6-meta-sigma-j2-n2 = sigma(n)+J2(n)=n^2 iff n=6 :: n6atlas [10*]\n  \"새 유일성 정리: 12+24=36=6^2. [2,1000] 전수검사 유일\"\n  !! \"Theorem 0과 독립적인 제4 유일성 등식\"", source_file: "atlas.n6", source_line: 45751, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: ["\"Theorem 0과 독립적인 제4 유일성 등식\""] } },
    AtlasNode { kind: "R", id: "n6-meta-boundary-primes", raw: "@R n6-meta-boundary-primes = (13,23)=(sigma+1,J2-1): 합=n^2 차=sigma-phi :: n6atlas [10*]\n  \"두 경계 소수: 13(Bernoulli/Leech) + 23(Ramanujan/Mathieu). 합=36=n^2=congruent 곡선 계수\"", source_file: "atlas.n6", source_line: 45755, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-meta-tau-r-cross", raw: "@R n6-meta-tau-r-cross = tau_R(n/phi)=252=|zeta(-5)|^-1 :: n6atlas [10*]\n  \"Ramanujan tau가 좌표계 값에서 Bernoulli/zeta와 교차. tau_R(phi)=-J2\"", source_file: "atlas.n6", source_line: 45758, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs3-kim-sarnak", raw: "@R n6-millennium-dfs3-kim-sarnak = theta = 7/64 = (sigma-sopfr)/(sigma-tau)^2 :: n6atlas [10*]\n  \"Kim-Sarnak 2003: Selberg 추측 최강 근사 θ ≤ 7/64. 7=sigma-sopfr, 64=(sigma-tau)^2\"", source_file: "atlas.n6", source_line: 45761, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs3-zeta-triple", raw: "@R n6-millennium-dfs3-zeta-triple = {zeta(-1),zeta(0),zeta(2)} = {-1/sigma,-1/phi,pi^2/n} :: n6atlas [10*]\n  \"ζ 특수값 3건이 동시에 -1/f(6) 형태. n=28 대조 불일치 → n=6 고유 triple\"", source_file: "atlas.n6", source_line: 45764, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs3-hecke-weight", raw: "@R n6-millennium-dfs3-hecke-weight = tau_R(p^2) = tau_R(p)^2 - p^{sigma-1} :: n6atlas [10*]\n  \"Hecke 1937: Delta weight=sigma cusp form → 재귀 지수 sigma-1=11 전체 지배\"", source_file: "atlas.n6", source_line: 45767, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs3-lie-rank-5", raw: "@R n6-millennium-dfs3-lie-rank-5 = rank{G2,F4,E6,E7,E8} = {phi,tau,n,sigma-sopfr,sigma-tau} :: n6atlas [10*]\n  \"예외 Lie 대수 rank 5/5 전부 n=6 산술. E7 rank=7=beta_0(QCD) 횡단 연결\"", source_file: "atlas.n6", source_line: 45770, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs3-7-triple-cross", raw: "@R n6-millennium-dfs3-7-triple-cross = beta_0 = E7_rank = parabolic_dim = 7 = sigma-sopfr :: n6atlas [10*]\n  \"QCD beta_0 / E7 rank / 3D NS 파라볼릭 차원: 3영역에서 sigma-sopfr=7 동시 등장\"", source_file: "atlas.n6", source_line: 45773, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs3-ns-parabolic", raw: "@R n6-millennium-dfs3-ns-parabolic = parabolic_dim(R^3 x R) = 2(n/phi)+1 = 7 :: n6atlas [10*]\n  \"CKN 1982: 3D NS 특이집합 파라볼릭 차원 = sigma-sopfr. dim=n/phi 특수성\"", source_file: "atlas.n6", source_line: 45776, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs3-she-leveque", raw: "@R n6-millennium-dfs3-she-leveque = zeta_6 = phi(sigma-tau)/(n/phi)^2 = 16/9 :: n6atlas [10*]\n  \"She-Leveque 1994: 간헐성 지수 p=n=6 → 분자 phi*(sigma-tau), 분모 (n/phi)^2\"", source_file: "atlas.n6", source_line: 45779, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs3-noether", raw: "@R n6-millennium-dfs3-noether = K^2 >= 2chi_h - n :: n6atlas [10*]\n  \"Noether 부등식: 일반형 곡면 절대상수 = n = 6. Riemann-Roch 분모 sigma=12에서 유래\"\n  !! \"1870년대 정리의 절대상수가 n=6 — 가장 강한 발견\"", source_file: "atlas.n6", source_line: 45782, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: ["\"1870년대 정리의 절대상수가 n=6 — 가장 강한 발견\""] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs3-bmy", raw: "@R n6-millennium-dfs3-bmy = c1^2 <= (n/phi)*c2, fake_proj_chi = n/phi :: n6atlas [10*]\n  \"BMY 1977-78: 계수=n/phi=3. 등호면(fake proj plane) chi=n/phi=3 (50개 전부)\"", source_file: "atlas.n6", source_line: 45786, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs3-grassmannian", raw: "@R n6-millennium-dfs3-grassmannian = Gr(2,6): chi=sopfr*(n/phi)=15, dim=sigma-tau=8 :: n6atlas [10*]\n  \"Gr(2,6) Schubert calculus: Euler 특성+차원 이중 n=6 분해\"", source_file: "atlas.n6", source_line: 45789, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs3-flag", raw: "@R n6-millennium-dfs3-flag = dim(SL(6)/B) = sopfr*(n/phi) = 15 :: n6atlas [10*]\n  \"완전 Flag variety SL(6)/B: #{양의 근 A5} = Gr(2,6) chi와 교차\"", source_file: "atlas.n6", source_line: 45792, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs3-congruent-gen", raw: "@R n6-millennium-dfs3-congruent-gen = E(y^2=x^3-n^2*x) generator = (sigma, n^2) :: n6atlas [10*]\n  \"Cremona 576.d1: congruent 곡선 생성원 P=(12,36)=(sigma,n^2). 12^3-36*12=36^2 검증\"", source_file: "atlas.n6", source_line: 45795, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs3-pi10s", raw: "@R n6-millennium-dfs3-pi10s = pi_10^s = Z/n = Z/6 :: n6atlas [10*]\n  \"Toda 1962: 안정 호모토피 pi_10^s order=n. pi_3~pi_11 7개 연속 항 전부 n=6 분해\"\n  !! \"정의에 6이 포함되지 않는 위상 불변량에서 n=6 직접 등장\"", source_file: "atlas.n6", source_line: 45798, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: ["\"정의에 6이 포함되지 않는 위상 불변량에서 n=6 직접 등장\""] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs3-theta10", raw: "@R n6-millennium-dfs3-theta10 = |Theta_10| = n = 6 :: n6atlas [10*]\n  \"Kervaire-Milnor 1963: 10차원 exotic sphere 수 = n. pi_10^s=Z/n과 독립 이중 확증\"", source_file: "atlas.n6", source_line: 45802, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs3-wall-lgroups", raw: "@R n6-millennium-dfs3-wall-lgroups = L-groups period = tau = 4, L_2(Z) = Z/phi :: n6atlas [10*]\n  \"Wall 1970: surgery obstruction 주기=tau, Arf obstruction order=phi. tau+phi=n 내재\"", source_file: "atlas.n6", source_line: 45805, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs4-mersenne-exp", raw: "@R n6-millennium-dfs4-mersenne-exp = {phi,n/phi,sopfr,sigma-sopfr} = 첫 tau개 Mersenne 지수 :: n6atlas [10*]\n  \"Euclid-Euler: P1~P4 Mersenne 지수 {2,3,5,7} = n=6 불변량 4종. 완전수 생성 구조가 n=6 인코딩\"\n  !! \"최강 발견: 완전수 열의 DNA가 n=6 불변량 집합\"", source_file: "atlas.n6", source_line: 45808, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: ["\"최강 발견: 완전수 열의 DNA가 n=6 불변량 집합\""] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs4-partition", raw: "@R n6-millennium-dfs4-partition = p(n)=n+sopfr, p(sigma)=(sigma-sopfr)*(n+sopfr), p(J2)=(n/phi)^2*sopfr^2*(sigma-sopfr) :: n6atlas [10*]\n  \"p(6)=11, p(12)=77, p(24)=1575: 인덱스 {n,sigma,J2}에서 연쇄 M-분해. p(12)/p(6)=sigma-sopfr\"", source_file: "atlas.n6", source_line: 45812, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "n6-millennium-dfs4-catalan", raw: "@R n6-millennium-dfs4-catalan = C3=sopfr, C4=phi*(sigma-sopfr), C5=(sigma-sopfr)*n, C6=sigma*(sigma-1) :: n6atlas [10*]\n  \"Catalan C3~C6 tau개 연속 M-분해. C4->C5 비율=n/phi\"", source_file: "atlas.n6", source_line: 45815, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
