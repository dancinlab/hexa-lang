    AtlasNode { kind: "C", id: "atlas_ingest_a1_summary_0", raw: "@C atlas_ingest_a1_summary_0 = atlas.append.hexa-sim-bridges.n6 단일 shard 출력. 기존 forge-triple/chip-p5-2 패턴 따라가기. main context 가 통합. :: omega_cycle_atlas-ingest [7]\n  => summary of axis a1\n  |> atlas-ingest (auto-ingested ω-cycle)", source_file: "atlas.n6", source_line: 3800, grade: GradeInfo { value: 7, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: ["summary of axis a1"], equivalents: [], converges: [], verified_by: ["atlas-ingest (auto-ingested ω-cycle)"], breakthroughs: [] } },
