    AtlasNode { kind: "C", id: "sim-3-axis-information-structure-INPUTS", raw: "@C sim-3-axis-information-structure-INPUTS :: meta [4!]\n  <- iter-50-FINAL-15-TOPO-axis-13-baseline\n  <- iter-63-FULL-D3-axis-14-r-0.39-rho-0.51\n  <- iter-69-AXIS-15-N-14-STABILIZED\n  <- iter-70-AXIS-15-FINAL-N-18\n  -> sim-3-way-info-table-2026-04-28\n  → \"Inputs (existing data, no new probes):\"\n  → \"  axis-13: v2 anchor classical phi/pi (iter-50, 15 D=3 topologies)\"\n  → \"  axis-14: 4p(1-p) entanglement entropy (iter-63, 18 D=3 topologies)\"\n  → \"  axis-15: Lorentz energy-drift retarded propagation (iter-70, 18 D=3)\"\n  → \"Intersection (all 3 axes available): n = 15 D=3 topologies\"\n  → \"  ads-cft, altered, big-crunch, blackhole, brane, bubble, ca3d,\"\n  → \"  de-sitter, inflation, minkowski, nested, s3, t3, vacuum-decay, wormhole\"\n  → \"Excluded:\"\n  → \"  flat (D=2 in axis-13 — convention)\"\n  → \"  cartoon (no axis-13 baseline value, iter-38 outlier excluded)\"\n  → \"  calabi6 (D=6, no axis-13 D=3 baseline)\"", source_file: "atlas.n6", source_line: 22611, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["iter-50-FINAL-15-TOPO-axis-13-baseline", "iter-63-FULL-D3-axis-14-r-0.39-rho-0.51", "iter-69-AXIS-15-N-14-STABILIZED", "iter-70-AXIS-15-FINAL-N-18"], derives: ["sim-3-way-info-table-2026-04-28"], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "sim-3-axis-DATA-TABLE", raw: "@C sim-3-axis-DATA-TABLE :: meta [4!]\n  → \"★★★ FULL 3-WAY DATA TABLE (n=15):\"\n  → \"  topology        axis-13  axis-14    axis-15\"\n  → \"  -----------------------------------------------\"\n  → \"  ads-cft             180      995    1488520\"\n  → \"  altered             463      966    1712829\"\n  → \"  big-crunch          604      861    2000227\"\n  → \"  blackhole           146      877    2142158\"\n  → \"  brane               145      743    1907852\"\n  → \"  bubble              434      887    2312561\"\n  → \"  ca3d                 79      851    2087413\"\n  → \"  de-sitter           229      999    2021183\"\n  → \"  inflation           169      866    1837360\"\n  → \"  minkowski           478      972    2165663\"\n  → \"  nested              196      830    1751637\"\n  → \"  s3                  303      952    1905527\"\n  → \"  t3                  141      838    1928254\"\n  → \"  vacuum-decay        203      825    2049823\"\n  → \"  wormhole            268      939    1953281\"", source_file: "atlas.n6", source_line: 22629, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "sim-3-axis-PEARSON-R-MATRIX", raw: "@C sim-3-axis-PEARSON-R-MATRIX :: meta [4!]\n  → \"★★★★ Pearson r matrix (3x3, n=15, restricted intersection):\"\n  → \"                  axis-13    axis-14    axis-15\"\n  → \"      axis-13     +1.0000    +0.3434    +0.2046\"\n  → \"      axis-14     +0.3434    +1.0000    -0.1837\"\n  → \"      axis-15     +0.2046    -0.1837    +1.0000\"\n  → \"\"\n  → \"  All off-diagonals |r| ≤ 0.35 — weak-to-moderate\"\n  → \"  Compared to broader-sample numbers from the cascade:\"\n  → \"    axis-13 × axis-14: cascade r=+0.39 (n=16) vs here +0.34 (n=15)\"\n  → \"    axis-13 × axis-15: cascade r=+0.27 (n=5)  vs here +0.20 (n=15) ⭐ tighter sample\"\n  → \"    axis-14 × axis-15: cascade r=-0.24 (n=18) vs here -0.18 (n=15)\"\n  → \"  All three pairwise r values weakened slightly under common n=15 restriction\"\n  → \"  → 3-axis intersection produces consistent weak-correlation signature\"", source_file: "atlas.n6", source_line: 22649, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "sim-3-axis-SPEARMAN-RHO-MATRIX", raw: "@C sim-3-axis-SPEARMAN-RHO-MATRIX :: meta [4!]\n  → \"★★★★ Spearman ρ matrix (3x3, n=15):\"\n  → \"                  axis-13    axis-14    axis-15\"\n  → \"      axis-13     +1.0000    +0.4857    +0.1179\"\n  → \"      axis-14     +0.4857    +1.0000    -0.0321\"\n  → \"      axis-15     +0.1179    -0.0321    +1.0000\"\n  → \"\"\n  → \"  Rank correlations:\"\n  → \"    13×14: ρ=+0.49  (rank-stronger than Pearson +0.34 — outlier-driven)\"\n  → \"    13×15: ρ=+0.12  (rank-near-zero, weaker than Pearson +0.20)\"\n  → \"    14×15: ρ=-0.03  (rank-orthogonal, even weaker than Pearson -0.18)\"\n  → \"  → axis-13/14 jointly carry monotone information; axis-15 is rank-orthogonal\"", source_file: "atlas.n6", source_line: 22664, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "sim-3-axis-DETERMINANT-INDEPENDENCE", raw: "@C sim-3-axis-DETERMINANT-INDEPENDENCE :: meta [4!]\n  → \"★★★★★ Determinant of correlation matrix (information independence proxy):\"\n  → \"  det(R_pearson)  = 0.780671\"\n  → \"  det(R_spearman) = 0.745478\"\n  → \"\"\n  → \"Interpretation scale:\"\n  → \"  det = 1.0 → fully independent (orthogonal axes)\"\n  → \"  det = 0.0 → fully collinear (one axis redundant)\"\n  → \"\"\n  → \"  ★ det = 0.78 means axes preserve 78% of independent-axis volume\"\n  → \"  ★ Equivalent: only 22% of variance volume is shared across axes\"\n  → \"  ★ 3 axes carry NEAR-INDEPENDENT information for topology discrimination\"", source_file: "atlas.n6", source_line: 22677, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
