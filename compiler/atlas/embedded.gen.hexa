    AtlasNode { kind: "C", id: "atlas_ingest_arg_fix_a5_summary_21", raw: "@C atlas_ingest_arg_fix_a5_summary_21 = tool/omega_cycle_atlas_ingest.sh wraps the real hexa invocation; sets HEXA_RUNNER=remote and forwards $@ verbatim. callers can use shim if direct .hexa invocation flaky. ~20 LoC bash, no hexa change. :: omega_cycle_atlas-ingest-arg-fix [7]\n  => summary of axis a5\n  |> atlas-ingest-arg-fix (auto-ingested ω-cycle)", source_file: "atlas.n6", source_line: 3672, grade: GradeInfo { value: 7, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: ["summary of axis a5"], equivalents: [], converges: [], verified_by: ["atlas-ingest-arg-fix (auto-ingested ω-cycle)"], breakthroughs: [] } },
