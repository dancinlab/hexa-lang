    AtlasNode { kind: "R", id: "FPP-09-external-dose", raw: "@R FPP-09-external-dose = external_dose = mu = 1 μSv/yr :: n6atlas [10*]\n  \"FPP §1/§8.4: SC 실드 외부 누출 = μ(6)=1 μSv/yr. 대중 한계 ICRP 1000 μSv/yr 대비 1/1000\"\n  <- domains/energy/fusion-powerplant/fusion-powerplant.md §1", source_file: "atlas.n6", source_line: 48608, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/energy/fusion-powerplant/fusion-powerplant.md §1"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
