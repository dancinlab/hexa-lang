    AtlasNode { kind: "C", id: "clay-cascade-s2-tick2-axis-13-saturation-fit-best", raw: "@C clay-cascade-s2-tick2-axis-13-saturation-fit-best :: meta [4!]\n  <- clay-cascade-s2-tick2-fit-comparison-table\n  -> clay-cascade-s2-tick2-replacement-hypothesis-tau-L-squared\n  => \"★ axis-13 obeys SATURATION y = y∞ + A·exp(−N/τ) with R²=0.997 (chain1d) / 0.966 (t3)\"\n  => \"y∞ ≈ 3-4 (decay-to-floor), τ ≈ 100-128 (lattice-equilibration scale)\"\n  => \"power-law alternative: α_E ≈ −0.484 (chain1d) / −0.571 (t3) — R² 0.93-0.96, viable but inferior to saturation\"\n  => \"Stage-5 α=+0.55 prediction at N=1024: y(1024)=56.7 (chain1d). OBSERVED: y∞=3.33 — ratio 0.059, OPPOSITE direction\"\n  => \"raw 71 retire: Stage-5 α=+0.55 is wrong sign (+ vs −) + wrong functional form (power vs saturation) — fully retired\"", source_file: "atlas.n6", source_line: 23795, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-tick2-fit-comparison-table"], derives: ["clay-cascade-s2-tick2-replacement-hypothesis-tau-L-squared"], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
