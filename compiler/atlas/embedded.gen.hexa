    AtlasNode { kind: "C", id: "clay-cascade-s2-tick3-axis-17-symmetry-deficit-best-candidate", raw: "@C clay-cascade-s2-tick3-axis-17-symmetry-deficit-best-candidate :: meta [4]\n  <- clay-cascade-s2-tick3-axis-17-DEFERRED-witness\n  => \"Symmetry-Deficit (SD) = ||C - C^T||_F / ||C||_F  bounded [0,1]; 0=symmetric isotropic, 1=fully asymmetric\"\n  => \"Diagonal-Dominance (DD) = Σ diag / Σ off-diag; 1=balanced, ∞=strict-diagonal, 0=off-dominant\"\n  => \"5 topologies measured (flat/t3/s3/blackhole/wormhole) using sub-agent F's 3×3 cross-feed matrices\"\n  => \"SD values: flat=0.54, t3=0.05, s3=1.16, blackhole=0.00 (strict-diag), wormhole=1.06\"\n  => \"DD values: flat=0.50, t3=0.48, s3=0.53, blackhole=∞ (no off-diag), wormhole=0.50\"", source_file: "atlas.n6", source_line: 24164, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-tick3-axis-17-DEFERRED-witness"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s2-tick3-axis-17-orthogonality-vs-existing", raw: "@C clay-cascade-s2-tick3-axis-17-orthogonality-vs-existing :: meta [4]\n  <- clay-cascade-s2-tick3-axis-17-symmetry-deficit-best-candidate\n  => \"SD vs axis-13 + axis-16 (Pearson n=5):\"\n  => \"  r(SD, a13) = +0.161  r(SD, a16) = -0.160 — both PASS |r|<0.3 threshold\"\n  => \"  Spearman ρ(SD, a13) = +0.600 — FAILS rank-orthogonality (rank-coupled)\"\n  => \"DD vs axis-13 + axis-16 (Pearson n=5, blackhole inf clipped):\"\n  => \"  r(DD, a13) = -0.342  r(DD, a16) = +0.327 — both marginally exceed 0.3\"\n  => \"verdict: SD better candidate (lower Pearson, finite-valued, raw-91-cleaner) but rank-coupled\"", source_file: "atlas.n6", source_line: 24172, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-tick3-axis-17-symmetry-deficit-best-candidate"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
