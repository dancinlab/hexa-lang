    AtlasNode { kind: "R", id: "SOC-BENCH-rvq-stages", raw: "@R SOC-BENCH-rvq-stages = 8 :: n6atlas [10*]\n  \"RVQ 양자화 단계 = σ-τ = 12-4 = 8\"", source_file: "atlas.n6", source_line: 47530, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
