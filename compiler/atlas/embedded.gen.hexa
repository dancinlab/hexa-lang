    AtlasNode { kind: "X", id: "L9-cmb-temp-n6-analysis", raw: "@X L9-cmb-temp-n6-analysis = phi + M3/(sigma-phi) (= 2.7, 실측 2.7255±0.0006) :: cosmological [5?]\n  \"CMB 온도 2.7255 K — φ+M₃/(σ-φ)=φ+7/10=2.7, err=0.94%. 측정 오차범위 밖→[5?]\"", source_file: "atlas.n6", source_line: 58038, grade: GradeInfo { value: 5, verified: false, breakthrough: false, hypothesis: true }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "X", id: "L9-hubble-constant-km", raw: "@X L9-hubble-constant-km = sigma*sopfr + M3 + mu/phi (= 67.5, 실측 67.36±0.54) :: cosmological [8?]\n  \"허블 상수 H₀ = σ·sopfr+M₃+μ/φ = 60+7+0.5 = 67.5 km/s/Mpc — Planck 2018 1σ 이내 (0.3σ)\"", source_file: "atlas.n6", source_line: 58041, grade: GradeInfo { value: 8, verified: false, breakthrough: false, hypothesis: true }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "X", id: "L9-dark-energy-fraction", raw: "@X L9-dark-energy-fraction = (tau*phi + M3/(sigma*n)) / (sigma - mu/n) (= 0.68427, 실측 0.6847±0.0073) :: cosmological [8?]\n  \"암흑 에너지 Ω_Λ = (τφ+M₃/(σn))/(σ-μ/n) = 0.6843 — Planck 2018 1σ 이내. DE+DM+b=0.9999\"", source_file: "atlas.n6", source_line: 58044, grade: GradeInfo { value: 8, verified: false, breakthrough: false, hypothesis: true }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "X", id: "L9-dark-matter-fraction", raw: "@X L9-dark-matter-fraction = tau/(sigma + sopfr - phi) (= 4/15 = 0.2667, 실측 0.266~0.268) :: cosmological [5?]\n  \"암흑 물질 Ω_DM = τ/(σ+sopfr-φ) = 4/15 — Planck Ω_m-Ω_b=0.266 매칭 (err 0.25%)\"", source_file: "atlas.n6", source_line: 58047, grade: GradeInfo { value: 5, verified: false, breakthrough: false, hypothesis: true }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "X", id: "L9-baryon-fraction", raw: "@X L9-baryon-fraction = M3/(sigma^2 - mu) (= 7/143 = 0.04895, 실측 0.0493±0.0006) :: cosmological [8?]\n  \"바리온 Ω_b = M₃/(σ²-μ) = 7/143 — Planck 2018 오차범위 이내 (err 0.10%)\"", source_file: "atlas.n6", source_line: 58050, grade: GradeInfo { value: 8, verified: false, breakthrough: false, hypothesis: true }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
