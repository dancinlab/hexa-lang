    AtlasNode { kind: "R", id: "clay-iter-54-iter-52-hypothesis-REJECTED", raw: "@R clay-iter-54-iter-52-hypothesis-REJECTED :: meta [4]\n  => \"iter-52 hypothesis: 'wormhole entropy may shift downward with norm conservation'\"\n  => \"iter-54 measurement: entropy=939 (same as iter-51 ticks=32 = 939)\"\n  => \"  vs iter-52 ticks=64 no-projection = 941 (was inflated by amplitude growth)\"\n  => \"  vs iter-54 ticks=64 with-projection = 939\"\n  => \"Hypothesis REJECTED: entropy proxy was robust to norm drift\"\n  => \"  Bipartite half_cut_split_per_mille=377 (same as iter-51's 377)\"\n  => \"  4p(1-p) = 4×377×623/1000 = 939 — formula deterministic given split\"\n  => \"  Norm projection rescales BOTH bipartitions equally → split unchanged\"\n  => \"  → entropy proxy is invariant under norm rescaling (mathematically certain)\"", source_file: "atlas.n6", source_line: 54052, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
