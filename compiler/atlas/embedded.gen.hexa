    AtlasNode { kind: "C", id: "clay-cascade-s2-tick10-AB-data-table", raw: "@C clay-cascade-s2-tick10-AB-data-table :: meta [4]\n  <- clay-cascade-s2-tick10-AB-t3-L8-mode-doubling-FALSIFIED-witness\n  => \"t3 L=8 (N=512, 8x8x8 cube periodic) KDK Verlet dt=0.05, single seed=42, T_max varies per m^2:\"\n  => \"format: m^2 | tau_half_obs | tau_half_pred=pi/(3*sqrt(m^2)) | obs/pred | max E-drift\"\n  => \"0.05 | 6.65 | 4.68 | 1.420 | 6.3e-4\"\n  => \"0.10 | 4.30 | 3.31 | 1.298 | 5.5e-4\"\n  => \"0.20 | 2.85 | 2.34 | 1.217 | 4.2e-4\"\n  => \"0.50 | 1.70 | 1.48 | 1.148 | 6.0e-4\"\n  => \"energy drift uniform <= 6.3e-4 (better than L=4 budget 1.2e-3) — integrator clean\"", source_file: "atlas.n6", source_line: 24900, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-tick10-AB-t3-L8-mode-doubling-FALSIFIED-witness"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s2-tick10-AB-ratio-crosses-unity", raw: "@C clay-cascade-s2-tick10-AB-ratio-crosses-unity :: meta [4!]\n  <- clay-cascade-s2-tick10-AB-data-table\n  => \"★ KEY FINDING: ratio CROSSED unity from L=4 to L=8, did NOT approach 1.0\"\n  => \"L=4 (V tick-6): ratio = 0.52 +/- 0.02 (uniform, under-prediction by x0.5)\"\n  => \"L=8 (this run): ratio = 1.27 (m^2-dependent 1.15-1.42, OVER-prediction)\"\n  => \"L=4 -> L=8 transition: ratio went 0.52 -> 1.27, NOT 0.52 -> 1.0\"\n  => \"if V's pure mode-doubling hypothesis correct, L=8 ratio should be ~1.0\"\n  => \"instead crossed unity AND became m^2-dependent — pure mode-doubling REJECTED as sole explanation\"\n  => \"slope L=4 -0.4938 -> L=8 -0.5915 (worse than continuum -0.50) confirms non-universal contamination\"", source_file: "atlas.n6", source_line: 24910, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-tick10-AB-data-table"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s2-tick10-AB-k0-estimator-contamination", raw: "@C clay-cascade-s2-tick10-AB-k0-estimator-contamination :: meta [4!]\n  <- clay-cascade-s2-tick10-AB-ratio-crosses-unity\n  => \"★ DIAGNOSIS: k=0 spatial-mean estimator <phi> is contaminated by low-k lattice modes\"\n  => \"L=8 has more low-k modes than L=4 (modes per axis: L=4 has 4, L=8 has 8)\"\n  => \"small-k lattice modes contribute disproportionately at low m^2 (where mass term is weakest)\"\n  => \"ratio m^2-dependence (1.42 at m^2=0.05 -> 1.15 at m^2=0.50) confirms low-k contamination\"\n  => \"discrete-lattice dispersion: omega^2_lat = m^2 + Sum(2-2cos k); at k=0 only m^2 survives\"\n  => \"BUT spatial-mean estimator mixes neighboring discrete-k modes whose contribution scales as 1/L^3 with mass-dependent prefactor\"\n  => \"not a finite-size artifact in the simple sense — estimator bias intrinsic to spatial-mean approximation\"", source_file: "atlas.n6", source_line: 24920, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-tick10-AB-ratio-crosses-unity"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s2-tick10-AB-cascade-implication", raw: "@C clay-cascade-s2-tick10-AB-cascade-implication :: meta [4]\n  <- clay-cascade-s2-tick10-AB-k0-estimator-contamination\n  => \"implication for cascade-s2 universality claim:\"\n  => \"  chain1d KDK k=0 universal: STRONG (sub-agent AA 90 runs 3-axis robust, k=0 trivially L-independent in 1D)\"\n  => \"  t3 KDK k=0 universal: PARTIALLY WEAKENED — L=4 -0.494 may be coincidence; L=8 -0.59 suggests real estimator-bias\"\n  => \"  cross-topology universality (Z's claim chain1d -0.4999 ≈ t3 -0.4938) → re-evaluate\"\n  => \"    - Z's chain1d -0.50 stays robust (3-axis confirmed by AA)\"\n  => \"    - V's t3 -0.494 may have been mass-dependent on L=4 mode counting\"\n  => \"  cascade-s2 final closure honest amendment: 1D universality CONFIRMED; 3D universality requires deeper test\"", source_file: "atlas.n6", source_line: 24930, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-tick10-AB-k0-estimator-contamination"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s2-tick10-AB-followup-needed", raw: "@C clay-cascade-s2-tick10-AB-followup-needed :: meta [4]\n  <- clay-cascade-s2-tick10-AB-cascade-implication\n  => \"follow-up to confirm 3D continuum universality:\"\n  => \"  (i) Fourier-projected exact k=0 mode (not spatial-mean approximation) — removes low-k contamination\"\n  => \"  (ii) L=16 t3 (N=4096) extrapolation — distinguishes 1/L vs 1/L^2 scaling\"\n  => \"  (iii) L -> infinity scaling check via 4+ L grid (L=4, 6, 8, 10, 12)\"\n  => \"  (iv) compare integrator: KDK vs higher-order (Forest-Ruth, Yoshida) at L=8\"\n  => \"until then: t3 -0.59 at L=8 is the empirical truth; -0.50 universality 3D is provisional\"", source_file: "atlas.n6", source_line: 24940, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-tick10-AB-cascade-implication"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s2-tick10-AB-C3-limits", raw: "@C clay-cascade-s2-tick10-AB-C3-limits :: meta [4]\n  <- clay-cascade-s2-tick10-AB-t3-L8-mode-doubling-FALSIFIED-witness\n  => \"n=2 lattice sizes only (L=4 + L=8) — cannot distinguish 1/L vs 1/L^2 scaling without L=16\"\n  => \"k=0 mode estimator = spatial mean is exact only at infinite resolution\"\n  => \"single seed=42, single dt=0.05; no ensemble averaging, no dt extrapolation\"\n  => \"4 m^2 points -> 2 dof for slope fit; high R^2 not strong evidence given few points\"\n  => \"continuum prediction tau_half = pi/(3m) assumes pure cosine; lattice introduces beating from small-k modes\"\n  => \"Hexa port deferred; results are Python-mirror only (/tmp/cascade_s2/symplectic_t3_L8.py)\"\n  => \"energy drift <= 6.3e-4 confirms integrator clean — physics issue not numerics\"\n  => \"raw 71 narrowing not full retraction: V's L=4 measurement still empirically -0.4938; interpretation as 'mode-doubling artifact' falsified\"\n  => \"own#11 strict; chflags uchg honored\"", source_file: "atlas.n6", source_line: 24949, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-tick10-AB-t3-L8-mode-doubling-FALSIFIED-witness"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
