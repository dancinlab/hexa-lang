    AtlasNode { kind: "R", id: "partition_6", raw: "@R partition_6 = 11 :: number_theory [10*]\n  \"p(6) = 11 — 6의 분할수\"\n  == sigma - mu = 11", source_file: "atlas.n6", source_line: 33749, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: ["sigma - mu = 11"], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "bernoulli_6", raw: "@R bernoulli_6 :: number_theory [10*]\n  \"B_6 = 1/42 — 6번째 베르누이 수\"\n  == 1/(n*M3) = 1/42\n  => \"리만 제타 zeta(6) = pi^6/945\"", source_file: "atlas.n6", source_line: 33753, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: ["1/(n*M3) = 1/42"], converges: [], verified_by: [], breakthroughs: [] } },
