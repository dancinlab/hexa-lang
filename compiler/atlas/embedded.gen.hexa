    AtlasNode { kind: "R", id: "n6-atlas-bt-1158:-여성청결제-핵심-n-6-상수-womens-intimate-cleanser-2026-04-10-sigma*phi+tau", raw: "@R n6-atlas-bt-1158:-여성청결제-핵심-n-6-상수-womens-intimate-cleanser-2026-04-10-sigma*phi+tau = 28 n6 :: n6atlas [10*]\n  \"sigma*phi+tau — 월경 주기 = sigma*phi+tau = 28일\"", source_file: "atlas.n6", source_line: 45592, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
