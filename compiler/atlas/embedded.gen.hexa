    AtlasNode { kind: "C", id: "clay-iter-42-Pearson-r-empirical", raw: "@C clay-iter-42-Pearson-r-empirical = 0.9792 :: meta [4!]\n  => \"4-scenario Pearson r evolution:\"\n  => \"  iter-36 single-seed=6:        r=0.9901 [-26, 299, 2889]\"\n  => \"  iter-41 D=3-only corrected:   r=0.9800 [-26, 113, 2889]\"\n  => \"  iter-41 hypothetical:         r=0.9865 [-13, 113, 1445]\"\n  => \"  iter-42 EMPIRICAL ensemble:   r=0.9792 [-28, 113, 3209] ⭐\"\n  => \"All 4 r > 0.97 — MONOTONE CORRELATION ROBUST across all corrections\"\n  => \"iter-36 finding 'higher dim → slower transition' EMPIRICALLY VALIDATED\"", source_file: "atlas.n6", source_line: 21521, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
