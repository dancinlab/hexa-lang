    AtlasNode { kind: "C", id: "clay-cascade-s2-tick2-replacement-hypothesis-tau-L-squared", raw: "@C clay-cascade-s2-tick2-replacement-hypothesis-tau-L-squared :: meta [4]\n  <- clay-cascade-s2-tick2-axis-13-saturation-fit-best\n  => \"★ replacement hypothesis: τ ≈ O(L²) is LATTICE-EQUILIBRATION scale, NOT critical exponent\"\n  => \"chain1d τ=100, L=√N=√1024≈32 → L²=1024, τ/L²≈0.10\"\n  => \"t3 τ=128, N=1000 L≈10 → L²=100, τ/L²≈1.28\"\n  => \"lattice-equilibration: time/N for diffusion process to spread across system L²/D where D=diffusion const\"\n  => \"axis-13 captures NOT critical phenomenon BUT diffusion-equilibration scale — different physics class\"\n  => \"follow-up: measure τ vs L explicitly to confirm L² scaling (Phase-3 candidate)\"", source_file: "atlas.n6", source_line: 23812, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-tick2-axis-13-saturation-fit-best"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
