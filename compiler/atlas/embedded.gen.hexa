    AtlasNode { kind: "C", id: "clay-iter-61-DE-SITTER-NEW-MAX-999", raw: "@C clay-iter-61-DE-SITTER-NEW-MAX-999 :: meta [4!]\n  => \"★★★★★ de-sitter entropy=999 — NEW MAXIMUM (1 unit from absolute max=1000)\"\n  => \"  ticks=64 seed=6 norm projection enabled\"\n  => \"  drift=33 (0.08%)\"\n  => \"  half_cut=505 (PERFECT bipartition balance, off by only 0.5%)\"\n  => \"  hash=-2237153367\"\n  => \"Why de-sitter near-max:\"\n  → \"  _qneighbor_de_sitter: t3 + per-cell amp=(i/8 + 1) shift\"\n  → \"  Distance-graded perturbation creates PERFECT bipartite distribution\"\n  → \"  Closest-to-max means amplitude split essentially 50/50 across i=32 cut\"\n  → \"Cumulative ranking:\"\n  → \"  1. de-sitter:    999  (NEW)\"\n  → \"  2. ads-cft:      995\"\n  → \"  3. flat:         980\"", source_file: "atlas.n6", source_line: 22114, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-iter-61-BRANE-NEW-LOW-743", raw: "@C clay-iter-61-BRANE-NEW-LOW-743 :: meta [4!]\n  => \"★★★ brane entropy=743 — NEW LOWEST (was vacuum-decay 825)\"\n  => \"  drift=26 (0.07%) half_cut=247 (very imbalanced bipartition)\"\n  → \"Why brane low:\"\n  → \"  _qneighbor_brane has axis>=3 fallback — but our 3D loop only uses axis 0..2\"\n  → \"  AND every 8th cell (i % 8 == 3) gets stochastic shift\"\n  → \"  Stochastic perturbation creates concentration in one bipartition\"\n  → \"  → 247 half_cut means 24.7% in left, 75.3% in right (highly imbalanced)\"\n  → \"Range: 743 (brane) to 999 (de-sitter) = 256 = 26% spread\"", source_file: "atlas.n6", source_line: 22129, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
