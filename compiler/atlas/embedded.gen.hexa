    AtlasNode { kind: "C", id: "clay-cascade-s6-AL-cascade-position", raw: "@C clay-cascade-s6-AL-cascade-position :: meta [4]\n  <- clay-cascade-s6-tick1-AL-axis-14-K3-PROMOTED-witness\n  => \"cascade-s6 short-cycle by design (1-2 sub-agents) — single hypothesis test\"\n  => \"cascade map this session:\"\n  => \"  s2 axis-13 universality (24 sub-agents) closed\"\n  => \"  s3 axis-16 mechanism (4 sub-agents) closed\"\n  => \"  s4 joint signature NEGATIVE (1 sub-agent) closed\"\n  => \"  s5 axis-14 K=3 IC retest DENIED-ROBUST (2 sub-agents) closed\"\n  => \"  s6 axis-14_perp K=3 PROMOTED (1 sub-agent, thin margin) — cascade-s7 robustness gate pending\"\n  => \"  s7 candidate: bootstrap + LOO + IC=48 robustness on a14_perp K=3 promotion\"\n  => \"if cascade-s7 confirms: K=2 STRONG → K=3 STRONG verify-grid (axis-13 + axis-14_perp + axis-16)\"\n  => \"if cascade-s7 fails: K=3 promotion downgrade or revert\"", source_file: "atlas.n6", source_line: 25985, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s6-tick1-AL-axis-14-K3-PROMOTED-witness"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
