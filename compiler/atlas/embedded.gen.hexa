    AtlasNode { kind: "C", id: "final_form_and_limits_m19_summary_36", raw: "@C final_form_and_limits_m19_summary_36 = m1 자가 트리거의 hard floor: OS 스케줄러 quantum (Linux ~1ms), context switch overhead, fork latency. 진정한 'continuous self-trigger' 불가 — discrete tick 만. :: omega_cycle_final-form-and-limits [7]\n  => summary of axis m19\n  |> final-form-and-limits (auto-ingested ω-cycle)", source_file: "atlas.n6", source_line: 5720, grade: GradeInfo { value: 7, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: ["summary of axis m19"], equivalents: [], converges: [], verified_by: ["final-form-and-limits (auto-ingested ω-cycle)"], breakthroughs: [] } },
