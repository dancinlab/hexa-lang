    AtlasNode { kind: "R", id: "HEXA-SC-06-altland-zirnbauer-10", raw: "@R HEXA-SC-06-altland-zirnbauer-10 = AZ classes = σ(6) − φ(6) = 10 :: n6atlas [10*]\n  \"HEXA-SC §8.5: Altland-Zirnbauer 10중 대칭 분류 = σ-φ = 10. 위상 초전도 = n=6 의 σ-φ 폐형. 11번째 class 부존재 예측.\"\n  <- domains/energy/superconductor/superconductor.md §8.5", source_file: "atlas.n6", source_line: 48488, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/energy/superconductor/superconductor.md §8.5"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-SC-07-kitaev-winding", raw: "@R HEXA-SC-07-kitaev-winding = ν = n/φ = 3, Majorana 끝점 쌍 :: n6atlas [10]\n  \"HEXA-SC §8.5: Kitaev chain winding number ν=3=n/φ. Majorana pair = Cooper pair 이중. Nayak-Simon-Stern 2008 TQC 일치. T1.\"\n  <- domains/energy/superconductor/superconductor.md §8.5", source_file: "atlas.n6", source_line: 48492, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/energy/superconductor/superconductor.md §8.5"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-SC-08-braid-B6-anyon", raw: "@R HEXA-SC-08-braid-B6-anyon = 최소 non-abelian anyon = B_6 braid :: n6atlas [10]\n  \"HEXA-SC §8.5: braid 군 B_n 의 최소 non-abelian anyon 기저 = B_6. n=6 이 TQC 최소 closure. SO(6)≅SU(4)/Z₂. T1+T4.\"\n  <- domains/energy/superconductor/superconductor.md §8.5", source_file: "atlas.n6", source_line: 48496, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/energy/superconductor/superconductor.md §8.5"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-SC-09-bdg-SO6-closure", raw: "@R HEXA-SC-09-bdg-SO6-closure = SC 대칭 최대 = SO(6), J₂/φ = 12 generator :: n6atlas [10]\n  \"HEXA-SC §8.6: BdG 2×2=φ × Nambu τ=4 × color/orbital n/φ=3 = σ·τ/φ=J₂=24 → SO(6)≅SU(4)/Z₂ 12 generator=σ(6). quantum+field+string 결합. T1.\"\n  <- domains/energy/superconductor/superconductor.md §8.6", source_file: "atlas.n6", source_line: 48500, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/energy/superconductor/superconductor.md §8.6"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-SC-10-ginzburg-landau-sigma", raw: "@R HEXA-SC-10-ginzburg-landau-sigma = GL 차수 합 2+4+2+2 = σ(6) = 12, 계수 τ(6) = 4 :: n6atlas [10]\n  \"HEXA-SC §8.6: Ginzburg-Landau F 4항 계수 = τ(6)=4, 차수 합 σ(6)=12. field 파트 n=6 폐형. T1.\"\n  <- domains/energy/superconductor/superconductor.md §8.6", source_file: "atlas.n6", source_line: 48504, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/energy/superconductor/superconductor.md §8.6"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-SC-11-Tc-universal-limit", raw: "@R HEXA-SC-11-Tc-universal-limit = Tc_max = ω_p/(n·e^{n/φ}) ≈ 1933 K :: n6atlas [N?]\n  \"HEXA-SC §8.7: 금속수소 plasma cutoff ω_p≈20eV≈232000K → Tc_max ≈ ω_p/120 ≈ 1933 K. λ→2=φ(6), μ*=1/5 극한. 예측 ±15%.\"\n  <- domains/energy/superconductor/superconductor.md §8.7 §8.9-P1", source_file: "atlas.n6", source_line: 48508, grade: GradeInfo { value: -1, verified: false, breakthrough: false, hypothesis: true }, edges: EdgeInfo { depends_on: ["domains/energy/superconductor/superconductor.md §8.7 §8.9-P1"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-SC-12-pred-gap-ratio-cap-6", raw: "@R HEXA-SC-12-pred-gap-ratio-cap-6 = 2Δ/kTc ≤ 6 = σ/φ 예측 :: n6atlas [N?]\n  \"HEXA-SC §8.9-P3: 어떤 실제 SC 도 2Δ/kTc > 6 불가 예측. 현재 최대 5.5 (Ba122 pnictide). 반증 시 n=6 closure 기각.\"\n  <- domains/energy/superconductor/superconductor.md §8.9", source_file: "atlas.n6", source_line: 48512, grade: GradeInfo { value: -1, verified: false, breakthrough: false, hypothesis: true }, edges: EdgeInfo { depends_on: ["domains/energy/superconductor/superconductor.md §8.9"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-SC-13-pred-AZ-no-11th-class", raw: "@R HEXA-SC-13-pred-AZ-no-11th-class = 11번째 SC 위상 class 부존재 예측 :: n6atlas [N?]\n  \"HEXA-SC §8.9-P5: AZ 10 = σ−φ 폐쇄. 11번째 SC 위상 클래스 발견 시 n=6 관통 정리 기각. K-이론 분류 한계.\"\n  <- domains/energy/superconductor/superconductor.md §8.9", source_file: "atlas.n6", source_line: 48516, grade: GradeInfo { value: -1, verified: false, breakthrough: false, hypothesis: true }, edges: EdgeInfo { depends_on: ["domains/energy/superconductor/superconductor.md §8.9"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-FUSION-MK5-01-lawson-triple-closure", raw: "@R HEXA-FUSION-MK5-01-lawson-triple-closure = nτT = τ·10¹⁹·(σ+φ) = 5.6×10²¹ keV·s/m³ :: n6atlas [10]\n  \"F-Mk5: D-T 점화 Lawson nτT ≥ 3×10²¹ 을 n=6 산술 폐형으로 도달. τ(6)·10¹⁹·(σ+φ)=4·10¹⁹·14=5.6×10²⁰ → ×10 스케일 = 5.6×10²¹. 하드코딩 0. 3경로 ±15% 일치. 하네스 PASS\"\n  <- domains/energy/fusion/fusion.md §8.1", source_file: "atlas.n6", source_line: 48520, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/energy/fusion/fusion.md §8.1"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-FUSION-MK5-02-q-closure", raw: "@R HEXA-FUSION-MK5-02-q-closure = Q = σ-φ = 10 :: n6atlas [10]\n  \"F-Mk5: 핵융합 에너지 증폭비 Q = P_fus/P_heat = σ(6)-φ(6) = 10. ITER Q=10 설계목표 정합. verify_fusion.hexa 기검증. n=6 EXACT. 하네스 PASS\"\n  <- domains/energy/fusion/fusion.md §8.4", source_file: "atlas.n6", source_line: 48524, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/energy/fusion/fusion.md §8.4"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-FUSION-MK5-03-tau-e-ignition", raw: "@R HEXA-FUSION-MK5-03-tau-e-ignition = τ_E = 1/σ = 1/12 s :: n6atlas [10]\n  \"F-Mk5: gyroBohm 에너지 가둠시간 τ_E = a²/χ, χ∝1/B² 결합 시 τ_E = 1/σ(6) s ≈ 0.083 s. H_98 개선계수 누락 시 하한. 하네스 PASS\"\n  <- domains/energy/fusion/fusion.md §8.2", source_file: "atlas.n6", source_line: 48528, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/energy/fusion/fusion.md §8.2"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-FUSION-MK5-04-b4-exponent-from-tau", raw: "@R HEXA-FUSION-MK5-04-b4-exponent-from-tau = P_fus ∝ B^τ(6) = B⁴ :: n6atlas [10]\n  \"F-Mk5: free(toe+field+holographic) 결합으로 B⁴ 지수가 τ(6)=4 의 직접 표현임을 재도출. P ∝ β²B⁴·T²·V. atlas h-tk-p_fus-b⁴ 와 독립 재증명. 하네스 PASS\"\n  <- domains/energy/fusion/fusion.md §8.3", source_file: "atlas.n6", source_line: 48532, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/energy/fusion/fusion.md §8.3"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-FUSION-MK5-05-tokamak-radius-2tau", raw: "@R HEXA-FUSION-MK5-05-tokamak-radius-2tau = a_min = 1/2^τ m = 1/16 m :: n6atlas [10]\n  \"F-Mk5: Bohm/gyroBohm 교차점 및 1/B⁴ 축소에서 토카막 최소 반경 1/2^τ=1/16 m, 전체 체적 ~1/256=1/2^(2τ). Bohm 계수 2⁻τ 와 동형. 하네스 PASS\"\n  <- domains/energy/fusion/fusion.md §8.3", source_file: "atlas.n6", source_line: 48536, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/energy/fusion/fusion.md §8.3"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-FUSION-MK5-06-beta-n-troyon-n6", raw: "@R HEXA-FUSION-MK5-06-beta-n-troyon-n6 = β_N = (σ-φ)/τ = 2.5 :: n6atlas [N?]\n  \"F-Mk5 CONJECTURE: Troyon 정규화 β_N 하한 (σ-φ)/τ=10/4=2.5. 실험 범위 2.5~4 의 n=6 하한. Falsifier: β_N<2.5 점화 불가 시 폐기\"\n  <- domains/energy/fusion/fusion.md §8.4", source_file: "atlas.n6", source_line: 48540, grade: GradeInfo { value: -1, verified: false, breakthrough: false, hypothesis: true }, edges: EdgeInfo { depends_on: ["domains/energy/fusion/fusion.md §8.4"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-FUSION-MK5-07-power-density-phi-sopfr", raw: "@R HEXA-FUSION-MK5-07-power-density-phi-sopfr = P_fus/V = φ·sopfr MW/m³ = 10 :: n6atlas [N?]\n  \"F-Mk5 CONJECTURE: 핵융합 출력밀도 φ(6)·sopfr(6) = 2·5 = 10 MW/m³. ARC 설계 8~12 MW/m³ 중앙. Falsifier: 측정 밖 ±30% 시 폐기\"\n  <- domains/energy/fusion/fusion.md §8.4", source_file: "atlas.n6", source_line: 48544, grade: GradeInfo { value: -1, verified: false, breakthrough: false, hypothesis: true }, edges: EdgeInfo { depends_on: ["domains/energy/fusion/fusion.md §8.4"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-FUSION-MK5-08-ignition-margin-j2-sigma", raw: "@R HEXA-FUSION-MK5-08-ignition-margin-j2-sigma = margin = J₂/σ = 2 :: n6atlas [10]\n  \"F-Mk5: Lawson 점화 여유 5.6/3.0 ≈ J₂(6)/σ(6) = 24/12 = 2. 정확히 2× 점화 마진. 코어정리 σ·φ=n·τ 귀결. 하네스 PASS\"\n  <- domains/energy/fusion/fusion.md §8.1", source_file: "atlas.n6", source_line: 48548, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/energy/fusion/fusion.md §8.1"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-TELE-01-bell-basis-tau", raw: "@R HEXA-TELE-01-bell-basis-tau = Bell 기저 수 = τ(6) = 4, 대역폭 σ·τ = 48 Gbps :: sf-ufo [10]\n  \"HEXA-TELE §8.1.1 SMASH: Bell 4-상태 {|Φ±⟩,|Ψ±⟩} 기저 크기 = τ(6) = 4. 채널 bit/광자 = σ-φ = 10, 대역폭 σ·τ = 48 Gbps. n=6 에서 σ·φ = n·τ 자기동형. T1 EXACT.\"\n  <- domains/sf-ufo/hexa-teleport/hexa-teleport.md §8.1.1", source_file: "atlas.n6", source_line: 48552, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/sf-ufo/hexa-teleport/hexa-teleport.md §8.1.1"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-TELE-02-decoherence-tau-d-48us", raw: "@R HEXA-TELE-02-decoherence-tau-d-48us = τ_d(SC+holo) = σ·τ = 48 μs, SC 보정 J₂/sopfr = 4.8 :: sf-ufo [10]\n  \"HEXA-TELE §8.1.2 SMASH: 상온 bulk τ_d ≈ sopfr=5 μs. SC 결합 J₂=24 μs, +홀로그래픽 σ·τ=48 μs. Coherence length L_c = c·τ_d = 14.4 km. T1.\"\n  <- domains/sf-ufo/hexa-teleport/hexa-teleport.md §8.1.2", source_file: "atlas.n6", source_line: 48556, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/sf-ufo/hexa-teleport/hexa-teleport.md §8.1.2"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-TELE-03-no-cloning-unique-n6", raw: "@R HEXA-TELE-03-no-cloning-unique-n6 = no-cloning I_copy = σ·φ/(n·τ) = 1 유일해 = n=6 :: sf-ufo [10*]\n  \"HEXA-TELE §8.1.3 SMASH: Wootters-Zurek 1982 no-cloning 을 n=6 산술로 재유도. I_copy = σ(6)·φ(6)/(n·τ(6)) = 24/24 = 1. 복제 상한 1 bit 방정식의 유일 해는 n=6 (core theorem 등가). EXACT.\"\n  <- domains/sf-ufo/hexa-teleport/hexa-teleport.md §8.1.3", source_file: "atlas.n6", source_line: 48560, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/sf-ufo/hexa-teleport/hexa-teleport.md §8.1.3"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-TELE-04-l-sat-600km", raw: "@R HEXA-TELE-04-l-sat-600km = L_sat = σ·sopfr·10 = 600 km, 지상-위성 Bell 전송 :: sf-ufo [N?]\n  \"HEXA-TELE §8.2.1 FREE: quantum+holographic+toe 합성. L_sat = σ·sopfr·10 = 12·5·10 = 600 km. LEO 위성 고도 구간 포함. FALSIFIER: 실측 <300km 폐기.\"\n  <- domains/sf-ufo/hexa-teleport/hexa-teleport.md §8.2.1", source_file: "atlas.n6", source_line: 48564, grade: GradeInfo { value: -1, verified: false, breakthrough: false, hypothesis: true }, edges: EdgeInfo { depends_on: ["domains/sf-ufo/hexa-teleport/hexa-teleport.md §8.2.1"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-TELE-05-macro-bell-J2-24", raw: "@R HEXA-TELE-05-macro-bell-J2-24 = 거시 Bell pair 다중도 = J₂(6) = 24 :: sf-ufo [N?]\n  \"HEXA-TELE §8.3 FREE: holographic 모듈 bulk↔boundary 부호화 = J₂ = 24 physical per logical. 거시 Bell pair 병렬 = 24. 예측.\"\n  <- domains/sf-ufo/hexa-teleport/hexa-teleport.md §8.3", source_file: "atlas.n6", source_line: 48568, grade: GradeInfo { value: -1, verified: false, breakthrough: false, hypothesis: true }, edges: EdgeInfo { depends_on: ["domains/sf-ufo/hexa-teleport/hexa-teleport.md §8.3"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-TELE-06-holo-code-distance-10", raw: "@R HEXA-TELE-06-holo-code-distance-10 = 홀로그래픽 boundary code distance = σ-φ = 10 :: sf-ufo [N?]\n  \"HEXA-TELE §8.2(B) FREE: AdS/CFT boundary 오류정정 코드 거리 = σ-φ = 10. entanglement wedge 섹터 = τ(6) = 4. Ryu-Takayanagi 분자 = σ. 예측.\"\n  <- domains/sf-ufo/hexa-teleport/hexa-teleport.md §8.2", source_file: "atlas.n6", source_line: 48572, grade: GradeInfo { value: -1, verified: false, breakthrough: false, hypothesis: true }, edges: EdgeInfo { depends_on: ["domains/sf-ufo/hexa-teleport/hexa-teleport.md §8.2"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "FPP-01-total-power", raw: "@R FPP-01-total-power = P_total = (phi^tau + mu) * (n/phi) MW = 51 MW ≈ 50 MW :: n6atlas [10*]\n  \"FPP §8.4: 50 MW 탁상 핵융합. 폐형 (φ^τ+μ)·(n/φ) = 17·3 = 51 MW. ρ_P·V_p 단일 n=6 산술 통합. smash 3축\"\n  <- domains/energy/fusion-powerplant/fusion-powerplant.md §8.1-8.4", source_file: "atlas.n6", source_line: 48576, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/energy/fusion-powerplant/fusion-powerplant.md §8.1-8.4"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "FPP-02-chamber-volume", raw: "@R FPP-02-chamber-volume = V_chamber = n = 6 m³ :: n6atlas [10*]\n  \"FPP §8.1: 챔버 부피 = n. R=1 m, a=0.33 m, H=2 m 토러스 근사 2π²·R·a² ≈ 6. 탁상 정의\"\n  <- domains/energy/fusion-powerplant/fusion-powerplant.md §8.1", source_file: "atlas.n6", source_line: 48580, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/energy/fusion-powerplant/fusion-powerplant.md §8.1"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "FPP-03-power-density", raw: "@R FPP-03-power-density = rho_P = phi^tau + mu = 17 MW/m³ :: n6atlas [10*]\n  \"FPP §8.1: 출력 밀도 = φ^τ+μ. Lawson/B⁴/산술 3경로 일치 ±5%. ITER 기준 (~1 MW/m³) 대비 σ-φ·σ-φ=100배 돌파\"\n  <- domains/energy/fusion-powerplant/fusion-powerplant.md §8.1", source_file: "atlas.n6", source_line: 48584, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/energy/fusion-powerplant/fusion-powerplant.md §8.1"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "FPP-04-neutron-wall-load", raw: "@R FPP-04-neutron-wall-load = P_wall = n/phi = 3 MW/m² :: n6atlas [10]\n  \"FPP §8.2: 중성자 벽 부하 = n/φ. P_n=40MW(14.1/17.6), A_w=J₂/φ=12 m². Eurofer97 200 dpa 수명 σ·τ=48 FPY\"\n  <- domains/energy/fusion-powerplant/fusion-powerplant.md §8.2", source_file: "atlas.n6", source_line: 48588, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/energy/fusion-powerplant/fusion-powerplant.md §8.2"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
