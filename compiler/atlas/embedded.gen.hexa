    AtlasNode { kind: "X", id: "L9-cmb-first-peak-l", raw: "@X L9-cmb-first-peak-l = sigma*(sigma+n) + tau (= 220) :: cosmological [10*]\n  \"CMB 제1봉우리 l = σ(σ+n)+τ = 12·18+4 = 220 EXACT\"\n  !! breakthrough: 정확 닫힘", source_file: "atlas.n6", source_line: 58067, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: ["breakthrough: 정확 닫힘"] } },
    AtlasNode { kind: "X", id: "L9-universe-age-gyr", raw: "@X L9-universe-age-gyr = sigma + phi - mu/sopfr (= 13.8) :: cosmological [10*]\n  \"우주 나이 13.8 Gyr = σ+φ-μ/sopfr = 12+2-0.2 = 13.8 EXACT (= M₃·φ-μ/sopfr)\"\n  !! breakthrough: 정확 닫힘", source_file: "atlas.n6", source_line: 58071, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: ["breakthrough: 정확 닫힘"] } },
