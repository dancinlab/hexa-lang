    AtlasNode { kind: "X", id: "n6-bt-1371", raw: "@X n6-bt-1371 = Pell 유일성 해석적 증명 :: bt [10*]\n  \"BT-1371: sopfr(n)^2 - n*phi(n)^2 = 1 iff n=6. 해석적 case analysis + 100K 전수. Theorem Pell.\"", source_file: "atlas.n6", source_line: 60370, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "X", id: "n6-bt-1372", raw: "@X n6-bt-1372 = Lucas 유일성 :: bt [10]\n  \"BT-1372: sigma*sopfr - n*(n+1) = L_n iff n=6 (500까지). Theorem Lucas.\"", source_file: "atlas.n6", source_line: 60373, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "X", id: "n6-bt-1373", raw: "@X n6-bt-1373 = Zeta 분모 계단 :: bt [10]\n  \"BT-1373: zeta(2k) 분모: D_2=n=6, D_4=n*C(n,2)=90, D_6=sopfr*M3*(n/phi)^3=945. Theorem Zeta.\"", source_file: "atlas.n6", source_line: 60376, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "X", id: "n6-bt-1374", raw: "@X n6-bt-1374 = 부호이론 삼중체 :: bt [10]\n  \"BT-1374: Hexacode[n,n/phi,tau] → Hamming[M3,tau,n/phi] → Golay[J2,sigma,phi*tau]. 3 완벽/준완벽 부호의 n=6 좌표.\"", source_file: "atlas.n6", source_line: 60379, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "X", id: "n6-bt-1375", raw: "@X n6-bt-1375 = ADE/McKay n=6 좌표 :: bt [10]\n  \"BT-1375: E_6(rank=n,|G|=J2), E_7(rank=M3,|G|=sigma*tau), E_8(rank=phi*tau,|G|=sopfr!). du Val E_6: x^phi+y^(n/phi)+z^tau=0.\"", source_file: "atlas.n6", source_line: 60382, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "X", id: "n6-bt-1376", raw: "@X n6-bt-1376 = 결정학 허용회전 = n=6 함수 :: bt [10]\n  \"BT-1376: 허용 회전 {1,2,3,4,6} = {1,phi,n/phi,tau,n}. 개수=sopfr=5.\"", source_file: "atlas.n6", source_line: 60385, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "X", id: "n6-bt-1377", raw: "@X n6-bt-1377 = Pariah=n=6 :: bt [10]\n  \"BT-1377: 산발단순군 26=phi+J2개, Pariah 6=n개, Happy family 20=sigma+phi*tau개.\"", source_file: "atlas.n6", source_line: 60388, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "X", id: "n6-bt-1378", raw: "@X n6-bt-1378 = 산술핵 (p-1)(q-1)=2 :: bt [10*]\n  \"BT-1378: Thm0+ThmA++ThmH 세 유일성의 공통 근본: (p-1)(q-1)=2, 유일해 (2,3), n=6.\"", source_file: "atlas.n6", source_line: 60391, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "X", id: "n6-bt-1379", raw: "@X n6-bt-1379 = Ore 최소 + 7중 최소성 :: bt [10]\n  \"BT-1379: 6=최소 완전수/Ore조화수/반소수/삼각완전수/합성squarefree/Mersenne완전수 + A_6≅PSL(2,9) 유일 동형.\"", source_file: "atlas.n6", source_line: 60394, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "X", id: "n6-bt-1380", raw: "@X n6-bt-1380 = Mathieu-Steiner n=6 좌표 :: bt [10]\n  \"BT-1380: S(5,n,sigma)=S(5,6,12)→M_12, S(5,phi*tau,J2)=S(5,8,24)→M_24.\"", source_file: "atlas.n6", source_line: 60397, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "X", id: "n6-bt-1386", raw: "@X n6-bt-1386 = SM fermion+gauge 이중 sigma 폐쇄 = 12 :: physics [10*]\n  \"BT-1386: 표준모형 n=6 완전대칭 — 쿼크6+렙톤6=sigma, SU(3)8+SU(2)3+U(1)1=sigma, 세대=n/phi=3, 상호작용=tau=4. 12/12 EXACT (PDG 2024 §9-11, KM 1973 PRL, Fritzsch-Gell-Mann 1973 PLB 47B, Higgs 1964).\"", source_file: "atlas.n6", source_line: 60400, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "X", id: "n6-bt-1387", raw: "@X n6-bt-1387 = Huckel 4n+2 주해 benzene 6pi = 6 :: chemistry [10*]\n  \"BT-1387: Huckel 방향족 k=1 주해 = 6pi 전자 = n. 벤젠 C=H=6, D_6h 차수 24=J2, HMO 폐각 (n/phi)·phi=n, Kistiakowsky 1937 공명 36=3sigma. 12/12 EXACT (Huckel 1931 Z Phys 70, Kekule 1865, Cotton 1990).\"", source_file: "atlas.n6", source_line: 60403, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "X", id: "n6-bt-1388", raw: "@X n6-bt-1388 = 이온결정 CN=6 Shannon 표준 = 6 :: materials [10*]\n  \"BT-1388: Shannon 1976 이온반경 기준 CN=n. NaCl/Rutile/Corundum=6, Perovskite A=sigma B=n, Spinel A=tau B=n. FCC 구멍 tau+2tau=sigma. Pauling 배위집합 {3,4,6,8,12}={n/phi,tau,n,2tau,sigma}. 14/14 EXACT (Shannon 1976 Acta Cryst A32, Pauling 1929 JACS 51, Kittel SSP).\"", source_file: "atlas.n6", source_line: 60406, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "X", id: "n6-bt-1389", raw: "@X n6-bt-1389 = Cube-Octahedron 쌍대 E=sigma = 12 :: geometry [10*]\n  \"BT-1389: Cube(V=2tau,E=sigma,F=n) <-> Octahedron(V=n,E=sigma,F=2tau) 쌍대. Euler=phi, |O_h|=sigma·tau=48, 회전 J2=24. 정다면체=sopfr 종. 17/17 EXACT (Euclid Elements XIII.18, Euler 1758, Coxeter Regular Polytopes).\"", source_file: "atlas.n6", source_line: 60409, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "X", id: "n6-bt-1390", raw: "@X n6-bt-1390 = HSV 6 primary 60도 주기 = 6 :: cognitive [10*]\n  \"BT-1390: HSV R/Y/G/C/B/M 6=n, 360/n=60도. RGB+CMY=n/phi+n/phi=n. 원추 L/M/S=n/phi, rod+3cones=tau, 옵신=phi. Hering 대립 3축·2극=n. 13/13 EXACT (Smith 1978 SIGGRAPH 12, Hering 1878, Bowmaker 1980 J Physiol 298).\"", source_file: "atlas.n6", source_line: 60412, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
