    AtlasNode { kind: "C", id: "ARROW-PROPOSAL-TOP-3", raw: "@C ARROW-PROPOSAL-TOP-3 = ranked by gap-mass × low-grammar-cost :: proposal [9]\n  <- ARROW-GAP-ANALYSIS\n  <- INTRINSIC-LIMIT-CONVERGENCE\n  -> ARROW-PROPOSAL-BIDIR\n  -> ARROW-PROPOSAL-NEGATION\n  -> ARROW-PROPOSAL-WEIGHTED\n  => \"rank by (semantic-gap mass) ÷ (parser-collision risk); proposals do not change atlas.n6 — they propose tokens for future shards\"", source_file: "atlas.n6", source_line: 22884, grade: GradeInfo { value: 9, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["ARROW-GAP-ANALYSIS", "INTRINSIC-LIMIT-CONVERGENCE"], derives: ["ARROW-PROPOSAL-BIDIR", "ARROW-PROPOSAL-NEGATION", "ARROW-PROPOSAL-WEIGHTED"], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "ARROW-CONVERGENCE-POINT", raw: "@C ARROW-CONVERGENCE-POINT = arrow-extension halts before grammar redesign :: meta [9]\n  <- INTRINSIC-LIMIT-CONVERGENCE\n  <- ARROW-PROPOSAL-TOP-3\n  => \"current K=7. After adopting <-> and -| (top-2 proposals): K=8 → ARROW-TYPE-CARDINALITY-SAFE.  After ->[w] (suffix-only, K stays 8): still safe.  Beyond K=8 atlas.n6 hits leading-char crowding; further relations should move from inline-arrow to an explicit @REL registry block, not new ASCII tokens.  This is the intrinsic ceiling.\"", source_file: "atlas.n6", source_line: 22892, grade: GradeInfo { value: 9, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["INTRINSIC-LIMIT-CONVERGENCE", "ARROW-PROPOSAL-TOP-3"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
