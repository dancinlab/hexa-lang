    AtlasNode { kind: "C", id: "axis-i-row-example-1-foundation-closure", raw: "@C axis-i-row-example-1-foundation-closure :: meta [4!]\n  <- axis-i-primitive-definition\n  => \"row example #1 — replace prose-baked closure with primitive\"\n  => \"  CURRENT (line 28, prose-baked):\"\n  => \"    @P n = 6 :: foundation [11*]\"\n  => \"      => \\\\\\\\\"meta-closure: 15 grade-10 derivations (sigma,phi,tau,sopfr,J2,mu,M3,sigma_n,perfect_number,sigma_decomp,J2_decomp,faction_phi,granville_smooth,...)\\\\\\\\\"\"\n  => \"  PROPOSED (axis-I primitive):\"\n  => \"    @P n = 6 :: foundation [11*]\"\n  => \"      ->* {15 @ [10*]}                 # transitive derives, filter [10*] grade, count 15\"\n  => \"      ->* sigma,phi,tau,sopfr,J2,mu,M3 # explicit one-hop fanout (existing capability)\"\n  => \"  semantics: ->* expands at lint-time to the BFS-reachable set from this node along -> arrows, intersected with the [10*] meta-tag predicate\"\n  => \"  raw 24 invariance: foundation [11*] entry text BELOW the meta-closure prose stays bit-identical; ONLY the prose => row is replaced\"", source_file: "atlas.n6", source_line: 23507, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["axis-i-primitive-definition"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "axis-i-row-example-2-falsification-trace", raw: "@C axis-i-row-example-2-falsification-trace :: meta [4!]\n  <- axis-i-primitive-definition\n  => \"row example #2 — falsification chain reconstruction\"\n  => \"  PROPOSED:\"\n  => \"    @R clay-iter-50-DEFINITIVE-iter-36-REPRODUCTION :: meta [10]\"\n  => \"      <-* foundation                 # transitive depends-on filtered to :: foundation domain\"\n  => \"      <-* clay-master-cumulative-status @ [10*]   # multi-hop ancestry under [10*] grade only\"\n  => \"  semantics: <-* unfolds the TRANSITIVE depends-on chain back to the named ancestor; lint emits the actual hop-list as a comment for audit\"\n  => \"  use case: clay-iter cascade has 338 entries; today every refinement re-states <- to immediate parent; <-* lets a refinement at depth 12 declare an ancestor at depth 0 without 12 explicit <- rows\"\n  => \"  raw 91 C3: <-* expansion is LINT-TIME, not runtime — concrete hop-list is materialized in audit comment so honesty is preserved\"", source_file: "atlas.n6", source_line: 23520, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["axis-i-primitive-definition"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
