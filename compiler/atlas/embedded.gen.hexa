    AtlasNode { kind: "C", id: "axis-l-orthogonality-vs-D-through-K", raw: "@C axis-l-orthogonality-vs-D-through-K :: meta [4!]\n  <- atlas-self-arch-axis-l-axiom-cite-amendment-witness\n  introduced_at = 2026-04-28\n  origin_shard = atlas-self-arch-axis-l-axiom-cite-amendment-2026-04-28\n  -> axis-l-vs-D-intrinsic-type\n  -> axis-l-vs-E-meta-tag\n  -> axis-l-vs-F-arrow-K-ceiling\n  -> axis-l-vs-G-body-field\n  -> axis-l-vs-H-id-convention\n  -> axis-l-vs-I-graph-query\n  -> axis-l-vs-J-supersession\n  -> axis-l-vs-K-temporal-provenance\n  => \"PER-AXIS verdict: 4 ORTHOGONAL, 4 SYNERGISTIC, 0 INTERFERENCE — axis-L is composition-clean across the prior axis stack\"", source_file: "atlas.n6", source_line: 26754, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["atlas-self-arch-axis-l-axiom-cite-amendment-witness"], derives: ["axis-l-vs-D-intrinsic-type", "axis-l-vs-E-meta-tag", "axis-l-vs-F-arrow-K-ceiling", "axis-l-vs-G-body-field", "axis-l-vs-H-id-convention", "axis-l-vs-I-graph-query", "axis-l-vs-J-supersession", "axis-l-vs-K-temporal-provenance"], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "axis-l-vs-D-intrinsic-type", raw: "@C axis-l-vs-D-intrinsic-type :: meta [4]\n  <- axis-l-orthogonality-vs-D-through-K\n  introduced_at = 2026-04-28\n  origin_shard = atlas-self-arch-axis-l-axiom-cite-amendment-2026-04-28\n  verdict = ORTHOGONAL\n  rationale = \"axis-D adds @-type letters. axis-L1/L2 add body-fields (cites_raw, amends, amendment_pass, amended_at) and meta-tag suffixes ([10*RAW-Nxx], [10*AMENDED], [10*NARROWED], [10*HONESTY-CORRECTED]). Different namespace; no parser conflict. cites_raw + amends apply uniformly across @P/@C/@F/@R/@S/@X/@?/@L/@D/@E/@M/@T.\"\n  caveat = \"axis-D ceiling estimate 12-15; current count ~13. axis-L does NOT push @-type cardinality. SAFE.\"", source_file: "atlas.n6", source_line: 26768, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["axis-l-orthogonality-vs-D-through-K"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "axis-l-vs-E-meta-tag", raw: "@C axis-l-vs-E-meta-tag :: meta [4]\n  <- axis-l-orthogonality-vs-D-through-K\n  introduced_at = 2026-04-28\n  origin_shard = atlas-self-arch-axis-l-axiom-cite-amendment-2026-04-28\n  verdict = SYNERGISTIC\n  rationale = \"axis-E hosts the meta-tag family. axis-L1 adds [N*RAW-Nxx] (1-of-45 raw-axiom binding) and axis-L2 adds [N*AMENDED] / [N*NARROWED] / [N*HONESTY-CORRECTED] amendment-kind tags. All compose as suffix at the same grade-position as axis-J's [N*DEPRECATED] / [N*RETIRED] and axis-K's [N*GOLDED]. NO collision because axis-L meta-tags use new keyword tokens (RAW-N{int}, AMENDED, NARROWED, HONESTY-CORRECTED).\"\n  composition_form = \"[N(\\\\\\\\\\\\\\\\*\\\\\\\\\\\\\\\\*?)(DRAFT|ACTIVE|GOLDED|DEPRECATED|RETIRED|RETIRED_INCONCLUSIVE|AMENDED|NARROWED|HONESTY-CORRECTED|RAW-N[0-9]+)?]\"\n  axis_e_ceiling_pressure = \"MILD — axis-L adds 4 new keyword forms (RAW-N{int} is a parameterised family, not 45 distinct keywords). Total meta-tag keyword count grows ~9 → ~13. Still well within axis-E observed ceiling of 39+ patterns.\"", source_file: "atlas.n6", source_line: 26776, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["axis-l-orthogonality-vs-D-through-K"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
