    AtlasNode { kind: "R", id: "HEXA-CHIPSC-B1-fJ-288uV", raw: "@R HEXA-CHIPSC-B1-fJ-288uV = f_J(V=σ·J₂ μV) = K_J·σ·J₂·10⁻³ = 139.28 GHz :: n6atlas [10*]\n  \"HEXA-CHIPSC §X.1 SMASH-A: AC Josephson f_J=2eV/h. K_J=483.5979 GHz/mV SI 고정상수. V=σ·J₂=288 μV 격자 → f_J=139.28 GHz. 저압 격자 V=n μV → f_J≈σ/τ GHz=3 GHz (§4 L1 Clock 재사용). 차원 [V·e/h]=[Hz] PASS. atlas 9682/10365 Φ₀=h/2e 쌍대. T1 EXACT\"\n  <- domains/compute/chip-sc/chip-sc.md §X.1", source_file: "atlas.n6", source_line: 49480, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/compute/chip-sc/chip-sc.md §X.1"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
