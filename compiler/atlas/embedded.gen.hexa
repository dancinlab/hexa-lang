    AtlasNode { kind: "C", id: "clay-cascade-s2-tick4-symplectic-KDK-formal", raw: "@C clay-cascade-s2-tick4-symplectic-KDK-formal :: meta [4]\n  <- clay-cascade-s2-tick4-symplectic-t3-stabilized-witness\n  => \"Kick-Drift-Kick velocity Verlet for H = (1/2)pi^2 + (1/2)Sigma_ij(phi_i-phi_j)^2 + (1/2)m^2 phi^2:\"\n  => \"pi_{n+1/2} = pi_n + (dt/2)*F(phi_n)         <- kick\"\n  => \"phi_{n+1} = phi_n + dt * pi_{n+1/2}         <- drift\"\n  => \"pi_{n+1} = pi_{n+1/2} + (dt/2)*F(phi_{n+1}) <- kick\"\n  => \"F(phi)_i = Sigma_{j in N(i)} phi_j - 6*phi_i - m^2*phi_i (t3, 6 neighbors)\"\n  => \"preserves symplectic 2-form dphi^dpi exactly (composition of 2 shears) + time-reversal symmetric\"", source_file: "atlas.n6", source_line: 24380, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-tick4-symplectic-t3-stabilized-witness"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
