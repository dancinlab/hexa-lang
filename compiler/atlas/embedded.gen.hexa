    AtlasNode { kind: "C", id: "axis-j-grounded-claims", raw: "@C axis-j-grounded-claims :: meta [4]\n  <- axis-j-raw-91-C3-honest-disclosures\n  G1 = \"[DEPRECATED YYYY-MM-DD] / [RETIRED YYYY-MM-DD] meta-tags ALREADY EXIST on 4 @-rows in atlas.n6 (R34 line 21894, R36 line 21911, R38 line 22060, clay-iter-55-RETIRED line 25213). GROUNDED — direct grep evidence.\"\n  G2 = \"Zero superseded_by body-field instances exist today. GROUNDED — direct grep evidence (axis-F audit line 28933 honest_caveat).\"\n  G3 = \"axis-F K_core audit (line 28968) ranked superseded_by as RANK-1 highest-value field with adoption cost ~8.5 min. GROUNDED — recorded in atlas.n6 itself.\"\n  G4 = \"axis-J adds zero row-level arrow tokens, so axis-F K-ceiling stays at K=10. GROUNDED — by construction (axis-J defines no row-level arrows).\"\n  G5 = \"Commit aad6e61d back-link 'R34 DEPRECATED + R36 RETIRED — cross-repo sync from anima/.roadmap #202' exists in git log. GROUNDED — verifiable from current git state.\"", source_file: "atlas.n6", source_line: 23971, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["axis-j-raw-91-C3-honest-disclosures"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
