    AtlasNode { kind: "C", id: "clay-cascade-s2-tick11-AC-fourier-interpretation", raw: "@C clay-cascade-s2-tick11-AC-fourier-interpretation :: meta [4]\n  <- clay-cascade-s2-tick11-AC-pure-k0-IC-3D-CONFIRMED-witness\n  => \"Fourier interpretation: spatial mean <phi> = N^-1 * Sigma_x phi(x) = F_phi[0,0,0]/N = exact k=0 mode by construction\"\n  => \"issue is NOT the observable; issue is the INITIAL CONDITION\"\n  => \"linear (mass + lattice-Laplacian) Hamiltonian: k-modes decouple with omega(k)^2 = m^2 + 4*Sigma_mu sin^2(k_mu/2)\"\n  => \"Gaussian bump IC populates ALL k!=0 modes; they oscillate at omega(k) > m\"\n  => \"even projecting onto k=0 at readout, tau_half estimator picks up beat patterns from full spectrum\"\n  => \"PURE k=0 IC (phi(x,0)=c0, pi(x,0)=c1, both constant) excites only k=0 mode\"\n  => \"linearity preserves this -> tau_half on <phi> equals continuum pi/(3m) exactly\"", source_file: "atlas.n6", source_line: 24972, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-tick11-AC-pure-k0-IC-3D-CONFIRMED-witness"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
