    AtlasNode { kind: "C", id: "clay-iter-58-DEFINITIVE-TOPOLOGY-RANKING", raw: "@C clay-iter-58-DEFINITIVE-TOPOLOGY-RANKING :: meta [4!]\n  => \"★★★★★★ DEFINITIVE axis-14 topology ranking (ticks=64 seed=6):\"\n  => \"  1. flat:      980 (highest)\"\n  => \"  2. s3:        952\"\n  => \"  3. wormhole:  939\"\n  => \"  4. blackhole: 877\"\n  => \"  5. t3:        838 (lowest)\"\n  => \"\"\n  => \"Mean (n=5): 917.2\"\n  => \"Median: 939 (wormhole)\"\n  => \"Range: 838 (t3) to 980 (flat) = 142 = 15.5% spread\"\n  => \"Stdev: ~57 per-mille\"", source_file: "atlas.n6", source_line: 21996, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
