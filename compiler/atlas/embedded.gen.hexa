    AtlasNode { kind: "C", id: "clay-cascade-s3-tick1-AE-graph-properties-formal", raw: "@C clay-cascade-s3-tick1-AE-graph-properties-formal :: meta [4]\n  <- clay-cascade-s3-tick1-AE-axis-16-graph-mechanism-witness\n  => \"for each topology T, build undirected adjacency A_T 64x64 (symmetrize neighbor function, drop self-loops)\"\n  => \"deg_mean / deg_max / deg_var: moments of degree sequence deg(i) = Sigma_j A[i,j]\"\n  => \"diameter: max_{u,v in LCC} d_BFS(u,v) on largest connected component\"\n  => \"mixing-time: smallest k such that |{i : d_BFS(SOURCE=32, i) <= k}| >= N/2 = 32\"\n  => \"spectral-gap: lambda_2 of normalized Laplacian L = I - D^(-1/2) A D^(-1/2) on LCC\"\n  => \"expansion: |E(S, S^c)| / |S| for half-cut S = {0..31} (one-cut proxy NOT min-Cheeger)\"", source_file: "atlas.n6", source_line: 25215, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s3-tick1-AE-axis-16-graph-mechanism-witness"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s3-tick1-AE-correlation-table", raw: "@C clay-cascade-s3-tick1-AE-correlation-table :: meta [4]\n  <- clay-cascade-s3-tick1-AE-graph-properties-formal\n  => \"format: graph-property -> Pearson(V8) | Spearman(V8) | Pearson(class) | Spearman(class)\"\n  => \"deg_mean   +0.562 / +0.389 / +0.401 / +0.309\"\n  => \"deg_max    -0.381 / -0.053 / -0.474 / -0.108\"\n  => \"deg_var    -0.521 / -0.216 / -0.564 / -0.162\"\n  => \"diameter   -0.433 / -0.024 / -0.208 / -0.096\"\n  => \"mix        -0.468 / -0.032 / -0.234 / -0.253\"\n  => \"gap        +0.445 / +0.082 / +0.359 / +0.170\"\n  => \"exp        +0.073 / +0.040 / -0.061 / +0.009\"", source_file: "atlas.n6", source_line: 25224, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s3-tick1-AE-graph-properties-formal"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s3-tick1-AE-degree-variance-best-predictor", raw: "@C clay-cascade-s3-tick1-AE-degree-variance-best-predictor :: meta [4!]\n  <- clay-cascade-s3-tick1-AE-correlation-table\n  => \"★ class-discrimination ratio (between-class / within-class variance):\"\n  => \"  deg_var:   1.942  ← BEST class separator\"\n  => \"  deg_max:   1.651\"\n  => \"  mix:       0.473\"\n  => \"  deg_mean:  0.372\"\n  => \"  gap:       0.347\"\n  => \"  diameter:  0.276\"\n  => \"  exp:       0.107\"\n  => \"Best predictor = degree-variance with sharp class-conditional means: cls1=30.33, cls2=1.51, cls3=0.62\"\n  => \"Pearson(V8)=-0.521 confirms negative correlation: HIGHER degree-variance -> LOWER V(8)\"", source_file: "atlas.n6", source_line: 25235, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s3-tick1-AE-correlation-table"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s3-tick1-AE-hub-collapse-mechanism", raw: "@C clay-cascade-s3-tick1-AE-hub-collapse-mechanism :: meta [4!]\n  <- clay-cascade-s3-tick1-AE-degree-variance-best-predictor\n  => \"★ COUNTERINTUITIVE MECHANISM — hub-collapse\"\n  => \"FAST-DEGENERATE class (V(8)<=10): high degree variance, super-hub presence\"\n  => \"  altered: deg_max=34 (super-hub from i*31+a*17 mod 64 chaotic mixer), deg_var=59.9, V(8)=9\"\n  => \"  big-crunch: deg_max=6, deg_var=0.75, V(8)=8 (radial sink mechanism)\"\n  => \"PARADOX: super-hub topologies have SMALLER V(8), not larger\"\n  => \"explanation: BFS cone expands to hub then RE-ENTERS already-visited cells (cone folds back)\"\n  => \"  super-hub absorbs frontier cells into already-visited set faster than new cell discovery\"\n  => \"  altered's degree-34 hub causes most of frontier expansion to be 'wasted' on revisits\"\n  => \"  V(8) saturates at 9 because effectively only 9 cells are reachable through the hub-collapsed graph\"", source_file: "atlas.n6", source_line: 25248, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s3-tick1-AE-degree-variance-best-predictor"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s3-tick1-AE-class-mechanism-table", raw: "@C clay-cascade-s3-tick1-AE-class-mechanism-table :: meta [4]\n  <- clay-cascade-s3-tick1-AE-hub-collapse-mechanism\n  => \"★ 3-class mechanism per (degree-variance, diameter) joint regime:\"\n  => \"FAST-DEGENERATE: deg_var ~30, super-hub (deg_max>=6 with var>>2), V(8)<=10\"\n  => \"  cone-collapse via revisit; n=2 examples (altered, big-crunch)\"\n  => \"BOUNDED-CONE: deg_var <= 4.25, near-regular low-degree, V(8) in [17, 59]\"\n  => \"  ball-volume limit; flat (deg=2) is limit case V(8)=17 from BFS k=8 ball on 1D ring\"\n  => \"  ads-cft (2 components, deg=5 regular) = 32 = LCC size\"\n  => \"  s3 (deg=5.5, var=4.25) = 49 = boundary case\"\n  => \"FULL-FILL: deg_var <= 1.7, near-regular concentration + small diameter (<=8), V(8) >= 63\"\n  => \"  expander-like growth, gap >= 0.07 (mostly >= 0.22)\"\n  => \"  12 topologies — 67% of cohort is FULL-FILL\"", source_file: "atlas.n6", source_line: 25260, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s3-tick1-AE-hub-collapse-mechanism"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
