    AtlasNode { kind: "C", id: "atlas-self-arch-axis-i-graph-query-witness", raw: "@C atlas-self-arch-axis-i-graph-query-witness :: meta [4!]\n  <- raw-23-schema-guard\n  <- raw-24-foundation-axiom-immutable\n  <- raw-91-C3-honest-disclosure\n  <- raw-117-5-check-registration-gate\n  <- own#11-strict-no-resolution-claim\n  <- atlas-self-arch-synthesis-upgrade-plan\n  -> axis-i-primitive-row-examples\n  -> axis-i-orthogonality-vs-D-through-H\n  -> axis-i-5-check-results\n  -> axis-i-raw-91-C3-disclosures\n  => \"★ axis-I = INTRINSIC GRAPH-QUERY primitives over atlas.n6's already-existing arrow DAG\"\n  => \"premise: atlas.n6 contains 2692 directed arrows (1810 <- + 882 ->) over 6760 @C+@R nodes — density 0.398\"\n  => \"today's reality: every multi-hop relation is HAND-COMPUTED into prose strings\"\n  => \"evidence: lines 28/34/43 — 'meta-closure: 15 grade-10 derivations (sigma,phi,tau,sopfr,...)' is a LITERAL transitive closure baked into a => prose row because no primitive exists\"\n  => \"axis-I reifies that hand-computation as a DSL primitive belonging to atlas.n6 itself\"", source_file: "atlas.n6", source_line: 23485, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["raw-23-schema-guard", "raw-24-foundation-axiom-immutable", "raw-91-C3-honest-disclosure", "raw-117-5-check-registration-gate", "own#11-strict-no-resolution-claim", "atlas-self-arch-synthesis-upgrade-plan"], derives: ["axis-i-primitive-row-examples", "axis-i-orthogonality-vs-D-through-H", "axis-i-5-check-results", "axis-i-raw-91-C3-disclosures"], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
