    AtlasNode { kind: "R", id: "HEXA-CLOAK-03-n-ref-negative", raw: "@R HEXA-CLOAK-03-n-ref-negative = n_ref = -σ/τ = -3.03 ≈ -π, 음 굴절률 :: sf-ufo [10]\n  \"HEXA-CLOAK §8.1: n_ref = -√(ε_r·μ_r) = -√(55/6) ≈ -3.03 = -σ/τ (π 근사 우연). 빛 역-꺾임 cloaking. T1+T4.\"\n  <- domains/sf-ufo/hexa-cloak/hexa-cloak.md §8.1", source_file: "atlas.n6", source_line: 48283, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/sf-ufo/hexa-cloak/hexa-cloak.md §8.1"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-CLOAK-04-metric-trace", raw: "@R HEXA-CLOAK-04-metric-trace = tr(g_ij) = σ/τ = 3, Pendry 계량 대각합 :: sf-ufo [10]\n  \"HEXA-CLOAK §8.2: Pendry 구면 cloak g_ij = diag(r'²/r², 1, 1). trace = σ/τ = 3 (3차원). det(g)=1 체적보존. T1.\"\n  <- domains/sf-ufo/hexa-cloak/hexa-cloak.md §8.2", source_file: "atlas.n6", source_line: 48287, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/sf-ufo/hexa-cloak/hexa-cloak.md §8.2"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-CLOAK-05-meissner-chi", raw: "@R HEXA-CLOAK-05-meissner-chi = χ = -μ(6) = -1, 완전 반자성 :: sf-ufo [10*]\n  \"HEXA-CLOAK §8.2: Meissner 자화율 χ = -1 = -μ(6). Möbius μ(6)=1 (제곱자유) ⇒ χ = -1 EXACT. 초전도 B_in=0. T1 EXACT.\"\n  <- domains/sf-ufo/hexa-cloak/hexa-cloak.md §8.2", source_file: "atlas.n6", source_line: 48291, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/sf-ufo/hexa-cloak/hexa-cloak.md §8.2"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-CLOAK-06-polarization-dof", raw: "@R HEXA-CLOAK-06-polarization-dof = 편광 DOF = phi(6) = 2 :: sf-ufo [10]\n  \"HEXA-CLOAK §8.2: 전자기파 편광 자유도 = 2 = φ(6). 공간 3 + 편광 2 = 5, 시간 1 포함 6 = n. n=6 관통. T1.\"\n  <- domains/sf-ufo/hexa-cloak/hexa-cloak.md §8.2", source_file: "atlas.n6", source_line: 48295, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/sf-ufo/hexa-cloak/hexa-cloak.md §8.2"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
