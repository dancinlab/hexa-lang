pub let ATLAS_R_NODES: [AtlasNode] = [
    AtlasNode { kind: "R", id: "perfect_number", raw: "@R perfect_number :: foundation [10*]\n  \"sigma(n) = 2n — 6은 완전수\"\n  <- n, sigma\n  == sigma(6) = 12 = 2*6", source_file: "atlas.n6", source_line: 33704, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["n", "sigma"], derives: [], applications: [], equivalents: ["sigma(6) = 12 = 2*6"], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "sigma_decomp", raw: "@R sigma_decomp :: foundation [10*]\n  \"sigma = phi * n\"\n  <- sigma, phi, n\n  == 12 = 2 * 6", source_file: "atlas.n6", source_line: 33709, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["sigma", "phi", "n"], derives: [], applications: [], equivalents: ["12 = 2 * 6"], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "J2_decomp", raw: "@R J2_decomp :: foundation [10*]\n  \"J2 = tau * n\"\n  <- J2, tau, n\n  == 24 = 4 * 6", source_file: "atlas.n6", source_line: 33714, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["J2", "tau", "n"], derives: [], applications: [], equivalents: ["24 = 4 * 6"], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "sopfr_phi_tau", raw: "@R sopfr_phi_tau :: foundation [10*]\n  \"sopfr = phi + tau - mu\"\n  <- sopfr, phi, tau, mu\n  == 5 = 2 + 4 - 1", source_file: "atlas.n6", source_line: 33719, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["sopfr", "phi", "tau", "mu"], derives: [], applications: [], equivalents: ["5 = 2 + 4 - 1"], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "euler_char_6", raw: "@R euler_char_6 = 2 :: topology [10*]\n  \"6면체(정육면체) 오일러 특성수 = V-E+F = 8-12+6 = 2\"\n  == 8 - 12 + 6 = 2\n  => \"다면체 공식 — 12개 변은 sigma와 일치\"", source_file: "atlas.n6", source_line: 33724, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: ["8 - 12 + 6 = 2"], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "simplex_6", raw: "@R simplex_6 :: topology [10*]\n  \"6-simplex: 꼭짓점 7, 변 21, 면 35\"\n  == C(7,2) = 21 = sigma + n + M3 - tau\n  => \"6차원 단체의 조합론적 구조\"", source_file: "atlas.n6", source_line: 33729, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: ["C(7,2) = 21 = sigma + n + M3 - tau"], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "electron_shells", raw: "@R electron_shells :: physics [9*]\n  \"탄소 전자배치 1s2 2s2 2p2 — 외각전자 tau=4\"\n  <- n, tau\n  == 2 + 4 = 6\n  => \"sp3 혼성 — tau개의 결합\"", source_file: "atlas.n6", source_line: 33734, grade: GradeInfo { value: 9, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["n", "tau"], derives: [], applications: [], equivalents: ["2 + 4 = 6"], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "granville_smooth", raw: "@R granville_smooth :: number_theory [10*]\n  \"6 = 2·3 — 가장 작은 squarefree 합성수, mu(6)=1\"\n  <- n, mu\n  => \"뫼비우스 함수 양수 — 소인수 짝수개\"", source_file: "atlas.n6", source_line: 33740, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["n", "mu"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
