    AtlasNode { kind: "C", id: "clay-cascade-s5-AK-coupling-sign-flip-IC-conditional", raw: "@C clay-cascade-s5-AK-coupling-sign-flip-IC-conditional :: meta [4!]\n  <- clay-cascade-s5-AK-correlation-matrix-i16\n  => \"★ STRIKING FINDING: a14×a13 SIGN FLIP between IC=32 and IC=16\"\n  => \"format: pair | i=32 P | i=32 S | i=16 P | i=16 S | dP | dS\"\n  => \"a14 x a13: +0.282 / +0.519 | -0.536 / -0.483 | dP=-0.818, dS=-1.002\"\n  => \"a14 x a16: -0.370 / -0.209 | -0.115 / -0.239 | dP=+0.255, dS=-0.030\"\n  => \"a14×a13 magnitude GREW at non-boundary (from 0.282/0.519 to 0.536/0.483)\"\n  => \"  AND sign reversed (positive → negative correlation)\"\n  => \"a14×a16 weakened slightly at non-boundary (Pearson FAIL→PASS)\"\n  => \"interpretation: IC=32 forces p→0.5 saturating BOTH discrimination AND coupling magnitude artifically low\"\n  => \"  IC=16 reveals true a14↔a13 coupling structure — anti-correlation under non-boundary\"\n  => \"qualitatively IC-conditional (sign flip!) but quantitatively still |r|>0.3 in BOTH ICs\"", source_file: "atlas.n6", source_line: 25745, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s5-AK-correlation-matrix-i16"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s5-AK-K3-DENIED-ROBUST", raw: "@C clay-cascade-s5-AK-K3-DENIED-ROBUST :: meta [4!]\n  <- clay-cascade-s5-AK-coupling-sign-flip-IC-conditional\n  -> clay-cascade-s5-AK-K2-STRONG-FINAL-confirmed\n  => \"★ K=3 PROMOTION VERDICT: DENIED-ROBUST\"\n  => \"  a14×a13: |Pearson|=0.536 FAIL, |Spearman|=0.483 FAIL\"\n  => \"  a14×a16: |Pearson|=0.115 PASS, |Spearman|=0.239 PASS\"\n  => \"  trapped-excluded n=15: a14×a13 |Spearman|=0.307 still FAIL; a14×a16 PASS both\"\n  => \"axis-14 cannot be promoted to K=3 — coupling with axis-13 PERSISTS across IC at deeper level\"\n  => \"structural mechanism: phi-pi (axis-13) ↔ bipartite-flow (axis-14) SHARE lattice information\"\n  => \"  same topology property manifests as both phi-pi correlator AND bipartite half-cut weight\"\n  => \"  IC=32 boundary IC saturates both estimators; IC=16 reveals anti-correlation; magnitude consistent\"\n  => \"cascade-s2 R denial (b) CONFIRMED ROBUST to IC choice\"", source_file: "atlas.n6", source_line: 25758, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s5-AK-coupling-sign-flip-IC-conditional"], derives: ["clay-cascade-s5-AK-K2-STRONG-FINAL-confirmed"], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s5-AK-cascade-s5-closure", raw: "@C clay-cascade-s5-AK-cascade-s5-closure :: meta [4!]\n  <- clay-cascade-s5-AK-K3-DENIED-ROBUST\n  => \"★ CASCADE-S5 CLOSURE at 2 sub-agents (AJ + AK)\"\n  => \"cascade-s5 progression:\"\n  => \"  AJ tick-1: discrimination IC-conditional (resolved denial a)\"\n  => \"  AK tick-2: structural coupling robust (confirmed denial b at deeper level)\"\n  => \"promotion blocked by partial IC-dependence:\"\n  => \"  discrimination (denial a) is IC-fragile — restored 10x at non-boundary\"\n  => \"  coupling (denial b) is qualitatively IC-conditional (sign flip) but quantitatively still fails\"\n  => \"no further ticks profitable on axis-14 alone\"\n  => \"  next would require new DESIGN of estimator that decouples from a13\"\n  => \"  e.g., bipartite-flow conditioned on axis-13-orthogonal projection\"", source_file: "atlas.n6", source_line: 25771, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s5-AK-K3-DENIED-ROBUST"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
