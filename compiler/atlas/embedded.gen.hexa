    AtlasNode { kind: "R", id: "HEXA-SC-03-lambda-eph-ceiling", raw: "@R HEXA-SC-03-lambda-eph-ceiling = λ_max = σ/J₂ = 1/2·τ = 2 = φ(6) :: n6atlas [10]\n  \"HEXA-SC §8.3: e-phonon 결합 상한 λ=2=φ(6). 3 영역 {1/φ, μ, σ/J₂}. LaH₁₀ λ≈2.5 경계 재검증 대상. T1.\"\n  <- domains/energy/superconductor/superconductor.md §8.3", source_file: "atlas.n6", source_line: 48476, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/energy/superconductor/superconductor.md §8.3"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-SC-04-morel-anderson-mu-ceiling", raw: "@R HEXA-SC-04-morel-anderson-mu-ceiling = μ* ≤ 1/sopfr(6) = 0.2 :: n6atlas [10]\n  \"HEXA-SC §8.3: Morel-Anderson μ* 상한 = 1/sopfr(6) = 1/5 = 0.2. ln(E_F/ω_D) 차수 sopfr. 관측 μ*∈[0.10,0.17] 확증. T1+T4.\"\n  <- domains/energy/superconductor/superconductor.md §8.3", source_file: "atlas.n6", source_line: 48480, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/energy/superconductor/superconductor.md §8.3"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
