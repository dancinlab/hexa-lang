    AtlasNode { kind: "C", id: "kick_bench_smoke_2_line_haiku_poetic_devices_axis_phonological_density_rationale_15", raw: "@C kick_bench_smoke_2_line_haiku_poetic_devices_axis_phonological_density_rationale_15 = If 2-line form must carry the same sonic weight as 3-line, devices must densify per line. Alliteration on the kireji-cut consonants and internal assonance across the cut are the cheapest densifiers. :: omega_cycle_kick-bench-smoke-2-line-haiku-poetic-devices [7]\n  => rationale of axis axis_phonological_density\n  |> kick-bench-smoke-2-line-haiku-poetic-devices (auto-ingested ω-cycle)", source_file: "atlas.n6", source_line: 7684, grade: GradeInfo { value: 7, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: ["rationale of axis axis_phonological_density"], equivalents: [], converges: [], verified_by: ["kick-bench-smoke-2-line-haiku-poetic-devices (auto-ingested ω-cycle)"], breakthroughs: [] } },
