    AtlasNode { kind: "E", id: "rtsc_h3s_dft_lambda_q_ladder", raw: "@E rtsc_h3s_dft_lambda_q_ladder\n  \"h3s_dft_lambda_q_convergence_ladder = cubic Im-3m H3S (a=2.984A, 4-atom BCC, USPP PBE) DFT el-ph q-convergence (pool:ubu-1 conda QE7.5, electron_phonon=simple, 24x24x24 k): 2x2x2_q -> lambda=0.85 Tc=74K; 4x4x4_q (8 irreducible) -> lambda=1.21-1.37 Tc=109-140K (mu*=0.10); measured Tc=203K (Drozdov 2015), lit lambda~2.0 (Errea 2016); ladder ambient-ML 0.48 -> 0.85 -> 1.3 -> measured 2.0 monotonic; remaining=6x6x6 q + anharmonic SSCHA; RTSC.md §9.12\"", source_file: "atlas.append.witness-1779428796000-rtsc_h3s_dft_lambda_q_ladder.n6", source_line: 7, grade: GradeInfo { value: -1, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "E", id: "rtsc-exp-h3s-tc-203k", raw: "@E rtsc-exp-h3s-tc-203k\n  \"H3S (cubic Im-3m, ~155 GPa) measured superconducting Tc = 203 K — first confirmed near-room-temperature conventional (BCS/Eliashberg) superconductor. Experimental anchor for allen_dynes_tc / mcmillan_tc / allen_dynes_full strong-coupling Tc prediction cross-check. tier=SUPPORTED-BY-CITATION (measured, no hexa recompute). cite: Drozdov, Eremets, Troyan, Ksenofontov, Shylin 2015 Nature 525:73 (doi:10.1038/nature14964)\"", source_file: "rtsc-measured-anchor-2026-05-25", source_line: 0, grade: GradeInfo { value: -1, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "E", id: "rtsc-exp-lah10-tc-250k", raw: "@E rtsc-exp-lah10-tc-250k\n  \"LaH10 (cubic Fm-3m, ~170 GPa) measured superconducting Tc ~ 250 K (zero resistance, isotope effect, upper critical field Hc2(0) ~ 136 T). Experimental anchor for hydride strong-coupling Allen-Dynes Tc cross-check. tier=SUPPORTED-BY-CITATION (measured, no hexa recompute). cite: Drozdov, Kong, Minkov, Besedin et al. 2019 Nature 569:528 (doi:10.1038/s41586-019-1201-8)\"", source_file: "rtsc-measured-anchor-2026-05-25", source_line: 0, grade: GradeInfo { value: -1, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "E", id: "rtsc-exp-cah6-tc-215k", raw: "@E rtsc-exp-cah6-tc-215k\n  \"CaH6 (clathrate sodalite-like Im-3m, 172 GPa) measured superconducting Tc = 215 K (Hc2 ~ 203 T via WHH model); first high-Tc clathrate hydride outside the rare-earth/actinide family, synthesized ~a decade after the 2012 prediction. Experimental anchor for clathrate-hydride Allen-Dynes Tc cross-check. tier=SUPPORTED-BY-CITATION (measured, no hexa recompute). cite: 'Superconductivity above 200 K discovered in superhydrides of calcium' 2022 Nature Communications 13:2863 (doi:10.1038/s41467-022-30454-w)\"", source_file: "rtsc-measured-anchor-2026-05-25", source_line: 0, grade: GradeInfo { value: -1, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
