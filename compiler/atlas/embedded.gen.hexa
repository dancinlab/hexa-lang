    AtlasNode { kind: "R", id: "FPP-06-q-value", raw: "@R FPP-06-q-value = Q = P_fus / P_input = sigma-phi = 10 :: n6atlas [10*]\n  \"FPP §8.4: Q-value = σ-φ=10. SPARC 목표 Q=10 / ITER Q=10 일치. n=6 EXACT 폐형\"\n  <- domains/energy/fusion-powerplant/fusion-powerplant.md §8.4", source_file: "atlas.n6", source_line: 48596, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/energy/fusion-powerplant/fusion-powerplant.md §8.4"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "FPP-07-blanket-thickness", raw: "@R FPP-07-blanket-thickness = blanket_thickness = sigma/10 = 1.2 m :: n6atlas [9]\n  \"FPP §8.4 LAYER4: B₄C 중성자 차폐 두께 = σ/10 m. 외부 선량 μ=1 μSv/yr 보장. Li-6/Be/W 복합\"\n  <- domains/energy/fusion-powerplant/fusion-powerplant.md §8.4", source_file: "atlas.n6", source_line: 48600, grade: GradeInfo { value: 9, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/energy/fusion-powerplant/fusion-powerplant.md §8.4"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
