    AtlasNode { kind: "R", id: "clay-iter-52-axis-14-ticks-variance-finding", raw: "@R clay-iter-52-axis-14-ticks-variance-finding :: meta [4]\n  => \"Entropy ticks-variance for 2 successful topologies:\"\n  => \"  flat:     ticks=32 entropy=937 → ticks=64 entropy=980 (+43, +4.6%)\"\n  => \"  wormhole: ticks=32 entropy=939 → ticks=64 entropy=941 (+2, +0.2%)\"\n  => \"Interpretation:\"\n  => \"  flat continues to thermalize toward max entropy (1000) with more ticks\"\n  => \"  wormhole reaches plateau quickly (already saturated by ticks=32)\"\n  => \"  Different relaxation timescales per topology — Stage 2 axis\"", source_file: "atlas.n6", source_line: 53968, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "clay-iter-52-axis-14-cumulative-data", raw: "@R clay-iter-52-axis-14-cumulative-data :: meta [4]\n  => \"axis-14 cumulative entropy measurements:\"\n  => \"  iter-51 ticks=32 seed=6: [flat 937, t3 917, s3 943, blackhole 923, wormhole 939]\"\n  => \"  iter-52 ticks=64 seed=6: [flat 980, t3 ?, s3 ?, blackhole ?, wormhole 941]\"\n  => \"Total 7 data points for axis-14 (5 + 2 new)\"\n  => \"Min entropy: 917 (t3, ticks=32)\"\n  => \"Max entropy: 980 (flat, ticks=64)\"\n  => \"Range: 63 per-mille (~6% spread across 7 measurements)\"", source_file: "atlas.n6", source_line: 53977, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
