    AtlasNode { kind: "C", id: "atlas_ingest_arg_fix_a1_summary_13", raw: "@C atlas_ingest_arg_fix_a1_summary_13 = detect remote vs local runner via env probe (HEXA_RUNNER, HEXA_FORCE_LOCAL) + argv[0] basename check (`hexa` → remote, `*.hexa` → local). branch ai initial value (2 vs 1 vs 0) accordingly. :: omega_cycle_atlas-ingest-arg-fix [10*PROBE_RUN]\n  => summary of axis a1\n  |> atlas-ingest-arg-fix (auto-ingested ω-cycle)", source_file: "atlas.n6", source_line: 3640, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: ["summary of axis a1"], equivalents: [], converges: [], verified_by: ["atlas-ingest-arg-fix (auto-ingested ω-cycle)"], breakthroughs: [] } },
