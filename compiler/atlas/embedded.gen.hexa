    AtlasNode { kind: "C", id: "clay-cascade-s2-tick1-stage6-cross-feed-witness", raw: "@C clay-cascade-s2-tick1-stage6-cross-feed-witness :: meta [4!]\n  <- raw-91-C3-honest-disclosure\n  <- raw-71-falsifier-retire-rule\n  <- own#11-strict-no-resolution-claim\n  <- clay-cascade-iter-24-iter-25-chi2-1-retracted-claim\n  -> clay-cascade-s2-tick1-stage6-topology-dependent-orthogonality\n  -> clay-cascade-s2-tick1-iter-24-25-chi2-anchor-clamp-explanation\n  => \"★ FALSIFIES uniform-orthogonality hypothesis — cross-feed orthogonality is TOPOLOGY-DEPENDENT\"\n  => \"5 topologies (flat/t3/s3/blackhole/wormhole) × 3×3 perturbation-response matrices, delta=1000 FSCALE, ticks=12\"\n  => \"iter-24/25 chi²=1 retraction REPRODUCED + EXPLAINED as anchor-clamp metric artifact (n_s_proxy clamps [9580,9599])\"", source_file: "atlas.n6", source_line: 23428, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["raw-91-C3-honest-disclosure", "raw-71-falsifier-retire-rule", "own#11-strict-no-resolution-claim", "clay-cascade-iter-24-iter-25-chi2-1-retracted-claim"], derives: ["clay-cascade-s2-tick1-stage6-topology-dependent-orthogonality", "clay-cascade-s2-tick1-iter-24-25-chi2-anchor-clamp-explanation"], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s2-tick1-stage6-mechanism", raw: "@C clay-cascade-s2-tick1-stage6-mechanism :: meta [4]\n  <- clay-cascade-s2-tick1-stage6-cross-feed-witness\n  => \"Stage 6 propagation chain: Stage1(quantum |ψ|²) → Stage2(Lorentz density) → Stage3(φ⁴) → Stage4(anchor)\"\n  => \"perturbation: inject +1000 (1.0 in PROP_FSCALE units) into axis-X neighbor of lattice center cell at start of Stage 3\"\n  => \"response: Σ|φ_pert[i] − φ_base[i]| over 1st + 2nd neighbors along axis-Y from perturbation cell, after 12 ticks\"\n  => \"control: pert_delta=0 → total diff=0 (no harness leakage verified)\"", source_file: "atlas.n6", source_line: 23439, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-tick1-stage6-cross-feed-witness"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s2-tick1-stage6-response-matrices", raw: "@C clay-cascade-s2-tick1-stage6-response-matrices :: meta [4]\n  <- clay-cascade-s2-tick1-stage6-mechanism\n  => \"format: rows=source-axis X, cols=response-axis Y; units=Σ|Δφ| × FSCALE/delta\"\n  => \"flat:      X=0:[827,371,371]  X=1:[835,371,371]  X=2:[835,371,371] — DEGENERATE 1D-ring\"\n  => \"t3:        X=0:[51,55,54]     X=1:[51,51,56]     X=2:[54,52,53]    — ISOTROPIC ~50-56 uniform\"\n  => \"s3:        X=0:[52,56,764]    X=1:[59,59,758]    X=2:[0,0,751]      — COLUMN-2 DOMINANT (~14× off-diag)\"\n  => \"blackhole: X=0:[53,0,0]       X=1:[0,53,0]       X=2:[0,0,51]       — STRICT DIAGONAL (off-diag=0)\"\n  => \"wormhole:  X=0:[57,58,756]    X=1:[59,56,763]    X=2:[57,56,762]    — COLUMN-2 DOMINANT (throat-axis)\"", source_file: "atlas.n6", source_line: 23446, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-tick1-stage6-mechanism"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s2-tick1-stage6-topology-dependent-orthogonality", raw: "@C clay-cascade-s2-tick1-stage6-topology-dependent-orthogonality :: meta [4!]\n  <- clay-cascade-s2-tick1-stage6-response-matrices\n  => \"★ KEY FINDING — axes are NOT uniformly orthogonal under cross-feed; orthogonality is TOPOLOGY-DEPENDENT\"\n  => \"blackhole: STRICTLY diagonal — horizon clamping at cell 21 isolates each axis (cleanest axis-orthogonality)\"\n  => \"t3:        ISOTROPIC — axes effectively interchangeable (no preferred axis)\"\n  => \"s3:        column-2 dominant — 4×4×4-with-hyperlink wrap concentrates response into z-axis\"\n  => \"wormhole:  column-2 dominant — throat-axis nearly source-independent (~760 regardless of X)\"\n  => \"flat:      DEGENERATE 1D-ring — only differentiates axis-0 from {1,2}; not informative\"\n  => \"cross-link: blackhole's strict-diagonal pairs with axis-16 V(8)=63 full-fill (isotropic propagation through interior)\"", source_file: "atlas.n6", source_line: 23455, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-tick1-stage6-response-matrices"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
