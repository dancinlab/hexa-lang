    AtlasNode { kind: "C", id: "clay-cascade-s2-axis-16-measurement-table", raw: "@C clay-cascade-s2-axis-16-measurement-table :: meta [4]\n  <- clay-cascade-s2-axis-16-formal-definition\n  => \"8 topologies measured; ALL src=32 sigma2=64 single-seed structural\"\n  => \"flat:        V(1)=3  V(2)=5  V(4)=9  V(8)=17  → 1D-ring V grows ~2k+1\"\n  => \"t3:          V(1)=4  V(2)=10 V(4)=32 V(8)=63  → full 3-torus near-saturating\"\n  => \"s3:          V(1)=4  V(2)=12 V(4)=33 V(8)=49  → closed 3-sphere sub-saturating\"\n  => \"blackhole:   V(1)=4  V(2)=10 V(4)=32 V(8)=63  → radial sink near-full\"\n  => \"wormhole:    V(1)=5  V(2)=14 V(4)=48 V(8)=64  → SATURATED via 4-axis handle\"\n  => \"minkowski:   V(1)=4  V(2)=11 V(4)=40 V(8)=64  → SATURATED axis-0 +11 tilt\"\n  => \"calabi6:     V(1)=7  V(2)=22 V(4)=57 V(8)=64  → SATURATED fastest 6-cube high-degree\"\n  => \"cartoon:     V(1)=4  V(2)=10 V(4)=10 V(8)=10  → CAUSALLY DISCONNECTED (closed orbit n=10)\"", source_file: "atlas.n6", source_line: 23005, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-axis-16-formal-definition"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
