    AtlasNode { kind: "R", id: "clay-iter-33-phi-pi-transition-table", raw: "@R clay-iter-33-phi-pi-transition-table :: meta [4]\n  => \"flat:      pos until ticks=96 (87)  → neg from ticks=104 (-49)\"\n  => \"t3:        pos until ticks=72 (71)  → neg from ticks=104 (-2)\"\n  => \"wormhole:  pos until ticks=80 (100) → neg from ticks=104 (-3)\"\n  => \"s3:        ALL ticks 72-120 positive (no transition observed)\"\n  => \"blackhole: ALL ticks 72-120 positive (no transition observed)\"\n  => \"transition window: ticks 96-104 (between 8-tick steps)\"", source_file: "atlas.n6", source_line: 53262, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
