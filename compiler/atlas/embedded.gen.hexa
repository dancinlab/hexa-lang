    AtlasNode { kind: "P", id: "N6HIST-A-CORE-IDENTITY", raw: "@P N6HIST-A-CORE-IDENTITY = sigma(n)*phi(n) = n*tau(n)  iff  n=6  (n>=2) :: foundation [11*REPO_INVARIANT]\n  => \"Theorem 0 / THM-1 / Theorem B unifier — verified n in [2, 10000] = {6} unique\"\n  => \"3 independent verification-draft paths: algebra A (R_local prime case), analysis B (Euler form phi/tau=1/2 fixed point), combinatorics C ((p²-1)(q²-1)=4pq ⟺ (p,q)=(2,3))\"\n  => \"Lean4 formal coverage ~99%: ω(n)=2 region complete (8 sub-cases sorry-free); cases 1+2a+2b+3+4a+4b(i)+4b(ii)+4c verified\"\n  -> N6HIST-A-RIDENTITY, N6HIST-MILL7-CLOSURE\n  |> papers/n=6-convergence-80-domains-2026-04-19.md §2.1\n  |> papers/M10star-21-unified-theorem-2026-04-15.md §3 (UT-21 reduction)\n  |> reports/breakthroughs/millennium-n6-attractor-2026-04-11.md §0\n  |> atlas.n6 line 17853 (P2-A1 promotion); MILL-V4-M3-* Lean4 series", source_file: "atlas.n6", source_line: 1534, grade: GradeInfo { value: 11, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: ["N6HIST-A-RIDENTITY", "N6HIST-MILL7-CLOSURE"], applications: [], equivalents: [], converges: [], verified_by: ["papers/n=6-convergence-80-domains-2026-04-19.md §2.1", "papers/M10star-21-unified-theorem-2026-04-15.md §3 (UT-21 reduction)", "reports/breakthroughs/millennium-n6-attractor-2026-04-11.md §0", "atlas.n6 line 17853 (P2-A1 promotion); MILL-V4-M3-* Lean4 series"], breakthroughs: [] } },
    AtlasNode { kind: "P", id: "N6HIST-A-RIDENTITY", raw: "@P N6HIST-A-RIDENTITY = R(n) := sigma(n)*phi(n)/(n*tau(n)); R(6)=1 unique zero of (R-1) on n>=2 :: foundation [11*]\n  <- N6HIST-A-CORE-IDENTITY\n  => \"R_local(2,1)=3/4, R_local(3,1)=4/3; (3/4)*(4/3)=1; n=6=2*3 uniqueness\"\n  |> papers/n=6-convergence-80-domains-2026-04-19.md §2.3", source_file: "atlas.n6", source_line: 1544, grade: GradeInfo { value: 11, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["N6HIST-A-CORE-IDENTITY"], derives: [], applications: [], equivalents: [], converges: [], verified_by: ["papers/n=6-convergence-80-domains-2026-04-19.md §2.3"], breakthroughs: [] } },
