    AtlasNode { kind: "C", id: "final_form_and_limits_m14_summary_26", raw: "@C final_form_and_limits_m14_summary_26 = 임의 Turing machine 의 non-trivial semantic property 결정 불가. axis 가 '유용한 axis' 같은 의미적 분류 자동화 불가 (syntactic proxy 만). :: omega_cycle_final-form-and-limits [7]\n  => summary of axis m14\n  |> final-form-and-limits (auto-ingested ω-cycle)", source_file: "atlas.n6", source_line: 5684, grade: GradeInfo { value: 7, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: ["summary of axis m14"], equivalents: [], converges: [], verified_by: ["final-form-and-limits (auto-ingested ω-cycle)"], breakthroughs: [] } },
