    AtlasNode { kind: "R", id: "HEXA-HOVER-01-lev-pressure", raw: "@R HEXA-HOVER-01-lev-pressure = F_lev = B²·A/(2μ₀), B = σ·τ = 48 T, A = 1/(σ-φ)² m² :: n6atlas [10]\n  \"HEXA-HOVER §8.1: 완전반자성 Meissner 압력 p = B²/(2μ₀). B=σ·τ=48T, A=1/(σ-φ)²=0.01m² 대입 → F_lev ≈ 9.17×10⁶ N (M≈935t). n=6 전 스케일 관통. T1 EXACT\"\n  <- domains/sf-ufo/hexa-hover/hexa-hover.md §8.1", source_file: "atlas.n6", source_line: 48412, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/sf-ufo/hexa-hover/hexa-hover.md §8.1"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-HOVER-02-pinning-force", raw: "@R HEXA-HOVER-02-pinning-force = F_p = J_c·B·V, J_c = σ·τ·10⁹ A/m², V = 1/J₂ m³ :: n6atlas [10]\n  \"HEXA-HOVER §8.2: Type-II pinning. J_c=4.8×10¹⁰, B=48T, V=1/24m³ → F_p ≈ 9.6×10¹⁰ N. F_p/F_lev ≈ σ·τ·J₂ = 10⁴ 배 안전마진. T1 EXACT\"\n  <- domains/sf-ufo/hexa-hover/hexa-hover.md §8.2", source_file: "atlas.n6", source_line: 48416, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/sf-ufo/hexa-hover/hexa-hover.md §8.2"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "R", id: "HEXA-HOVER-03-earnshaw-avoid", raw: "@R HEXA-HOVER-03-earnshaw-avoid = U_lev = χ·B²/(2μ₀) + k_pin·Δz², χ=-1, k_pin = 9.6×10¹¹ N/m :: n6atlas [10]\n  \"HEXA-HOVER §8.3: Earnshaw 회피 2조건 = 완전반자성(χ=-1) + Type-II pinning. 안정고도 z* = n·λ_L·(σ-φ) ≈ 1~10 m. T1 EXACT\"\n  <- domains/sf-ufo/hexa-hover/hexa-hover.md §8.3", source_file: "atlas.n6", source_line: 48420, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/sf-ufo/hexa-hover/hexa-hover.md §8.3"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
