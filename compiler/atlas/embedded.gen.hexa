    AtlasNode { kind: "C", id: "clay-iter-43-iter-42-result-scope-bounded", raw: "@C clay-iter-43-iter-42-result-scope-bounded :: meta [4!]\n  => \"iter-42 r=0.9792 finding scope:\"\n  => \"  D=2 grand mean -28: FULL 24 measurements (3 topologies × 8 seeds, fits v2)\"\n  => \"  D=3 mean 113: 4-TOPO SUBSET (32 measurements, t3/s3/blackhole/wormhole)\"\n  => \"  D=6 calabi6 mean 3209: SINGLE TOPOLOGY (8 seeds, fits v2)\"\n  => \"Scope limit honestly disclosed:\"\n  => \"  D=3 coverage 4/16 = 25% topology coverage of D=3 21-topology mix\"\n  => \"  D=2 coverage 3/3 = 100%\"\n  => \"  D=6 coverage 1/1 (calabi6 only available D=6 topology in v2)\"\n  => \"Pearson r=0.9792 holds for tested topology subsets\"", source_file: "atlas.n6", source_line: 21541, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-iter-43-loop-saturation-witness", raw: "@C clay-iter-43-loop-saturation-witness :: meta [4!]\n  => \"Loop ω-cycle convergence indicators (raw 37/38/39):\"\n  => \"  Empirical validation: COMPLETE for tested subset (r=0.9792)\"\n  => \"  Topology coverage: 5/16 D=3 (audit complete)\"\n  => \"  Cumulative axes: 13\"\n  => \"  Sim modules: 10\"\n  => \"  Stages: 5/5 + Stage 6 + Stage 7 + 19-iter cascade\"\n  => \"  Sub-agents: 39 (raw 100 fallback 39/39)\"\n  => \"  Topologies: 21\"\n  => \"  Commits: 45+\"\n  => \"  raw 91 C3 enforced: 15×\"\n  => \"  own#11 violation: 0 (43 iters)\"\n  => \"Convergence partial — full D=3 ensemble requires v2 anchor extension work\"", source_file: "atlas.n6", source_line: 21552, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-iter-44-iter-43-FALSE-BLOCKER-RETRACTED", raw: "@C clay-iter-44-iter-43-FALSE-BLOCKER-RETRACTED :: meta [4!]\n  <- iter-43-scope-limit-disclosure-claiming-5-of-16-coverage\n  -> iter-44-direct-source-audit-empirical_anchor_v2.hexa-lines-46-68-+-255-278\n  => \"iter-43 conclusion 'v2 dispatch supports only 5/16 D=3 topologies' is FALSE\"\n  => \"Direct source audit:\"\n  => \"  E2T_* constants line 25-45: 21 topology IDs declared\"\n  => \"  _e2topo_id() line 48-69: 21 string-to-id mappings (hyphenated names)\"\n  => \"  _e2neighbor_*() line 72-251: 21 neighbor functions implemented\"\n  => \"  dispatch line 255-278: 21 topology branches\"\n  => \"iter-43 misread of error message 'valid: flat | t3 | s3 | blackhole | wormhole'\"\n  => \"  → that string is hardcoded help text, not actual dispatch list\"", source_file: "atlas.n6", source_line: 21566, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["iter-43-scope-limit-disclosure-claiming-5-of-16-coverage"], derives: ["iter-44-direct-source-audit-empirical_anchor_v2.hexa-lines-46-68-+-255-278"], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-iter-44-arg-shift-root-cause", raw: "@C clay-iter-44-arg-shift-root-cause :: meta [4!]\n  => \"Why hetzner run shifts args differently than local hexa --selftest:\"\n  => \"  hexa-resolver routes to hetzner via ssh\"\n  => \"  remote shell adds wrapper args before user args\"\n  => \"  args[0..1] = wrapper, args[2] = script path, args[3..] = user args\"\n  => \"  empirical_anchor_v2 hardcodes args[2]=ticks, args[3]=topo, args[4]=seed\"\n  => \"  → on hetzner: args[2]=script-path (non-int → ticks default 50)\"\n  => \"  → topology shifts to args[3], seed shifts to args[4]\"\n  => \"  → tied user args = 2 instead of 3\"", source_file: "atlas.n6", source_line: 21578, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-iter-45-CLI-PARSER-PATCHED-position-independent", raw: "@C clay-iter-45-CLI-PARSER-PATCHED-position-independent :: meta [4!]\n  <- iter-44-discovery-hetzner-arg-index-shift-pushes-script-path-to-args-2\n  -> iter-45-position-independent-arg-scan-by-topology-name\n  => \"Patch: empirical_anchor_v2.hexa main parser (line 485-525)\"\n  => \"Algorithm:\"\n  => \"  1. Scan _e2args for first arg whose _e2topo_id() returns ≥ 0\"\n  => \"  2. That is the topology arg at idx i\"\n  => \"  3. Read ticks from args[i-1] (with int parse fallback)\"\n  => \"  4. Read seed from args[i+1] (with int parse fallback)\"\n  => \"  5. Fallback to legacy hardcoded args[2/3/4] if no topology found\"\n  => \"Effect: CLI grammar 'hexa run ...hexa <ticks> <topology> <seed>' now works\"\n  => \"        on BOTH local hexa --selftest AND hetzner remote run\"", source_file: "atlas.n6", source_line: 21588, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["iter-44-discovery-hetzner-arg-index-shift-pushes-script-path-to-args-2"], derives: ["iter-45-position-independent-arg-scan-by-topology-name"], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-iter-45-unblocked-full-ensemble-now-feasible", raw: "@C clay-iter-45-unblocked-full-ensemble-now-feasible :: meta [4!]\n  => \"iter-43/44 blocker: CLI on hetzner couldn't pass user-specified ticks\"\n  => \"iter-45: blocker RESOLVED via position-independent name-scan parser\"\n  => \"Now possible:\"\n  => \"  Full 16-topo D=3 ensemble (16 × 8 seeds × ticks=64 = 128 invocations)\"\n  => \"  Per-call ~60s × 128 = 7680s (128min) — still > 5min loop budget\"\n  => \"  But NOW each iter-46+ can advance batch by ~5 invocations\"\n  => \"  Estimated 26-iter chain to complete full 16-topo D=3 ensemble\"\n  => \"Alternative: raw 79 DAG-scheduler parallel batch (16 hetzner workers)\"", source_file: "atlas.n6", source_line: 21601, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-iter-46-CLI-PATCH-VERIFIED-4-NEW-TOPOLOGIES", raw: "@C clay-iter-46-CLI-PATCH-VERIFIED-4-NEW-TOPOLOGIES :: meta [4!]\n  <- iter-45-position-independent-parser-patch\n  -> iter-46-parallel-cross-topology-validation\n  => \"4 previously-untested D=3 topologies measured (parallel dispatch):\"\n  => \"  ca3d        ticks=64 seed=6 → correl=34  T/V=15069 phi/pi=79\"\n  => \"  nested      ticks=64 seed=6 → correl=44  T/V=15823 phi/pi=196\"\n  => \"  big-crunch  ticks=64 seed=6 → correl=24  T/V=18402 phi/pi=604\"\n  => \"  ads-cft     ticks=64 seed=6 → correl=115 T/V=11848 phi/pi=180\"\n  => \"Patched CLI works for ALL 4 — no parser regressions\"\n  => \"phi/pi spans 79 → 604 (7.6× range) — wide cross-topology spread\"", source_file: "atlas.n6", source_line: 21611, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["iter-45-position-independent-parser-patch"], derives: ["iter-46-parallel-cross-topology-validation"], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-iter-46-pair-amp-sign-bifurcation", raw: "@C clay-iter-46-pair-amp-sign-bifurcation :: meta [4!]\n  => \"Pair-amplitude sign analysis:\"\n  => \"  POSITIVE: ads-cft +1245, nested +238, vacuum-decay +1 to +41\"\n  => \"  NEGATIVE: ca3d -190, big-crunch -149\"\n  => \"  Single-seed=6 produces sign bifurcation across topology classes\"\n  => \"  ads-cft 1245 = 5× larger magnitude than next highest\"\n  => \"  Suggests ads-cft has distinctive holographic-like correlation\"", source_file: "atlas.n6", source_line: 21622, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-iter-47-7-topo-batch-1-of-7-COMPLETED", raw: "@C clay-iter-47-7-topo-batch-1-of-7-COMPLETED :: meta [4!]\n  <- iter-46-4-topo-cross-validation-7.6x-spread\n  -> iter-47-7-remaining-D-3-topology-batch\n  => \"Dispatched 7 parallel probes (altered, cartoon, brane, inflation,\"\n  => \"  de-sitter, minkowski, bubble) ticks=64 seed=6\"\n  => \"Outcomes:\"\n  => \"  bubble:    SUCCESS — correl=44 T/V=13623 phi/pi=434 max/avg=3932\"\n  => \"  altered:   incomplete (start banner only)\"\n  => \"  cartoon:   incomplete (start banner only)\"\n  => \"  brane:     incomplete (start banner only)\"\n  => \"  inflation: incomplete (start banner only)\"\n  => \"  de-sitter: incomplete (start banner only)\"\n  => \"  minkowski: incomplete (start banner only)\"\n  => \"1/7 success rate — likely cause: 90s timeout OR hetzner 7-concurrent saturation\"", source_file: "atlas.n6", source_line: 21630, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["iter-46-4-topo-cross-validation-7.6x-spread"], derives: ["iter-47-7-remaining-D-3-topology-batch"], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
