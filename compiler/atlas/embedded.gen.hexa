    AtlasNode { kind: "F", id: "N6HIST-BT541-THM-B", raw: "@F N6HIST-BT541-THM-B = min{k: numer(B_{2k}) has prime >= 7} = 6  (Bilateral Theorem B; Bernoulli numerator k=6 sharp boundary) :: number-theory [10*PASS_LITERATURE]\n  => \"Direct computation B_2..B_{12}; B_{12} = -691/2730 introduces irregular prime 691 = first prime > sigma(6) absent from M-set\"\n  => \"Two-sided breakdown: positive ζ(2k) denominators d_+(1..5) decompose in M-set; negative ζ(1-2k) numerators trivial in {1, sopfr}; both break exactly at k=n=6\"\n  => \"Clean-range size = sopfr(6) = 5 on both sides; identical to h(K) class-number sequence break at h=n=6 (51 = 3·17, 17 ∉ M)\"\n  => \"Mechanically forces stable-homotopy 240/504/8128/etc atlas matches via Adams J / Borel-Lichtenbaum / Kervaire-Milnor\"\n  -> N6HIST-A-CORE-IDENTITY\n  |> reports/breakthroughs/millennium-n6-attractor-2026-04-11.md §3.1, §3.5\n  |> theory/proofs/bernoulli-boundary-2026-04-11.md\n  |> reports/breakthroughs/millennium-7-closure-2026-04-11.md §BT-541", source_file: "atlas.n6", source_line: 33647, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: ["N6HIST-A-CORE-IDENTITY"], applications: [], equivalents: [], converges: [], verified_by: ["reports/breakthroughs/millennium-n6-attractor-2026-04-11.md §3.1, §3.5", "theory/proofs/bernoulli-boundary-2026-04-11.md", "reports/breakthroughs/millennium-7-closure-2026-04-11.md §BT-541"], breakthroughs: [] } },
