    AtlasNode { kind: "C", id: "clay-cascade-s2-axis-16-causality-lightcone-witness", raw: "@C clay-cascade-s2-axis-16-causality-lightcone-witness :: meta [4!]\n  <- raw-91-C3-honest-disclosure\n  <- raw-114-bisimulation-behavioral-equivalence\n  <- own#11-strict-no-resolution-claim\n  <- clay-cascade-iter-46-to-70-prior-axis-13-14-15-stack\n  -> clay-cascade-s2-cartoon-causal-sector-closure\n  -> clay-cascade-s2-saturation-speed-signature\n  => \"axis-16 = V_T(s, k) past-lightcone volume by BFS through retarded-neighbor relation; structural observable orthogonal-a-priori to intensive axes 13/14/15\"\n  => \"8 of 18 D=3 topologies measured at sigma2=64 src=32: V(1) range 3-7, V(8) range 10-64\"\n  => \"structural envelope (raw 114): BFS reachability bounds WHICH cells can be influenced; magnitude requires axes 13/14/15\"", source_file: "atlas.n6", source_line: 22988, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["raw-91-C3-honest-disclosure", "raw-114-bisimulation-behavioral-equivalence", "own#11-strict-no-resolution-claim", "clay-cascade-iter-46-to-70-prior-axis-13-14-15-stack"], derives: ["clay-cascade-s2-cartoon-causal-sector-closure", "clay-cascade-s2-saturation-speed-signature"], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
