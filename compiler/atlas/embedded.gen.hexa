    AtlasNode { kind: "F", id: "P_S_projector", raw: "@F P_S_projector = \"V^T · V\" :: anima.cpgd.algebra [11*]\n  <- template_count\n  => \"orthogonal projector onto template subspace S; V rows = 16 eigenvecs\"\n  => \"idempotent (P_S · P_S = P_S), symmetric (P_S^T = P_S)\"\n  => \"init: W_0 = P_S · W_random ⇒ W_0 ∈ S\"\n  => \"update: W_{k+1} = W_k − lr · (grad · P_S) ⇒ W_k ∈ S ∀k\"\n  |> edu/lora/cpgd_wrapper.hexa L281-L325 build_projector + verify_idempotent", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 118, grade: GradeInfo { value: 11, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["template_count"], derives: [], applications: [], equivalents: [], converges: [], verified_by: ["edu/lora/cpgd_wrapper.hexa L281-L325 build_projector + verify_idempotent"], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "W_init_closed_form", raw: "@F W_init_closed_form = \"W_0 = V (each row v_i)\" :: anima.cpgd.init [11*]\n  <- P_S_projector\n  => \"specifically chosen so AN11(b) cos = 1 exactly at step 0\"\n  => \"P_S · V = V because v_i ∈ S\"\n  |> cpgd_wrapper.hexa L477-L493", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 126, grade: GradeInfo { value: 11, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["P_S_projector"], derives: [], applications: [], equivalents: [], converges: [], verified_by: ["cpgd_wrapper.hexa L477-L493"], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "cpgd_drift_bound", raw: "@F cpgd_drift_bound = \"cos(W_k[i,:], v_i) ≥ 1 − O(ε_lr · k)\" :: anima.cpgd.theorem [11*]\n  <- cpgd_lr_default, probe_steps_cpgd\n  => \"ε_lr = lr · ‖grad·P_S‖_row ≤ lr · ‖grad‖\"\n  => \"for lr=0.001, 100 step, FP64: max_drift << 0.5 (1600/1600 above 0.5)\"\n  |> docs/proof_cpgd.md (Lagrangian derivation)", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 132, grade: GradeInfo { value: 11, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["cpgd_lr_default", "probe_steps_cpgd"], derives: [], applications: [], equivalents: [], converges: [], verified_by: ["docs/proof_cpgd.md (Lagrangian derivation)"], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "l_cell_mk_viii", raw: "@F l_cell_mk_viii = \"L_cell = T_tension − V_structure(comp,diss) − V_sync(entrain)\" :: anima.lagrangian.mk8 [10*]\n  <- n_axis_cell\n  => \"Mk.VIII unified action S = Σ_k L_cell(k); fixpoint = stationary δS=0\"\n  => \"T_tension = (ΔW)²/2 (kinetic from weight-rate-of-change)\"", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 138, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["n_axis_cell"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "l_ix_mk_ix", raw: "@F l_ix_mk_ix = \"L_IX = T_tension − V_structure − V_sync_eff − V_RG_eff + λ · I_irr\" :: anima.lagrangian.mk9 [11!]\n  <- l_cell_mk_viii\n  => \"raw#30 IRREVERSIBILITY_EMBEDDED_LAGRANGIAN; arrow-of-time term\"\n  => \"I_irr = |ΔW| / (|ΔW| + jitter); arrow-cusp clamp\"\n  => \"back-compat: HEXA_USE_KURAMOTO_SYNC=0 ∧ HEXA_USE_RG_POTENTIAL=0 ∧ λ=0 ⇒ L_IX ≡ L_cell byte-exact\"", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 143, grade: GradeInfo { value: 11, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["l_cell_mk_viii"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
