    AtlasNode { kind: "C", id: "clay-iter-55-T3-SEED-VARIANCE-DISCOVERY", raw: "@C clay-iter-55-T3-SEED-VARIANCE-DISCOVERY :: meta [4!]\n  => \"★★★ KEY DISCOVERY: t3 entropy shows significant seed-variance\"\n  => \"  flat seed=6 ticks=32: entropy=937\"\n  => \"  flat seed=13 ticks=64: entropy=980 (+43, ticks-effect)\"\n  => \"  flat seed=6 ticks=64: entropy=980 (iter-52 — same as seed=13!)\"\n  => \"  → flat is SEED-STABLE (980 ± 0)\"\n  => \"\"\n  => \"  t3 seed=6 ticks=32: entropy=917\"\n  => \"  t3 seed=13 ticks=64: entropy=838 (-79, -8.6%)\"\n  → t3 has HIGH seed-variance (917 → 838 across seeds)\"\n  => \"\"\n  => \"  blackhole seed=6 ticks=32: entropy=923\"\n  => \"  blackhole seed=13 ticks=64: entropy=877 (-46, -5.0%)\"\n  => \"  → blackhole intermediate seed-variance\"\n  => \"\"\n  => \"Seed-variance ranking: t3 (9%) > blackhole (5%) > flat (~0%)\"", source_file: "atlas.n6", source_line: 21932, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-iter-56-RETRACTION-seed-CLI-NOT-wired", raw: "@C clay-iter-56-RETRACTION-seed-CLI-NOT-wired :: meta [4!]\n  <- iter-55-claimed-9-percent-t3-seed-variance\n  -> iter-56-direct-source-audit\n  => \"iter-55 'seed-variance discovery' RETRACTED — major raw 91 C3 finding\"\n  => \"Root cause:\"\n  => \"  qs_init(6) was HARDCODED in main mode (line 438 pre-fix)\"\n  => \"  CLI parser at iter-54 read seed value but never passed to qs_init\"\n  => \"  All iter-55 'seed=13' probes ACTUALLY ran with seed=6\"\n  => \"Evidence:\"\n  => \"  iter-55 wormhole 'seed=13' hash=-7143937677 (IDENTICAL to seed=6 -7143937677)\"\n  => \"  iter-55 results were actually TICKS-variance (32 vs 64 ticks)\"", source_file: "atlas.n6", source_line: 21949, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["iter-55-claimed-9-percent-t3-seed-variance"], derives: ["iter-56-direct-source-audit"], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
