    AtlasNode { kind: "R", id: "HEXA-CLOAK-08-field-attenuation", raw: "@R HEXA-CLOAK-08-field-attenuation = E_s 감쇠 σ·τ = 48 dB/m :: sf-ufo [N?]\n  \"HEXA-CLOAK §9.1 예측: κ = σ/(φ·c), 감쇠 σ·τ = 48 dB/m. FALSIFIER: < 47.5 dB/m 측정 시 폐기. 이론값.\"\n  <- domains/sf-ufo/hexa-cloak/hexa-cloak.md §9.1", source_file: "atlas.n6", source_line: 48303, grade: GradeInfo { value: -1, verified: false, breakthrough: false, hypothesis: true }, edges: EdgeInfo { depends_on: ["domains/sf-ufo/hexa-cloak/hexa-cloak.md §9.1"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
