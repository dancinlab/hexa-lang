    AtlasNode { kind: "C", id: "clay-cascade-s2-ensemble-run-config", raw: "@C clay-cascade-s2-ensemble-run-config :: meta [4]\n  <- clay-cascade-s2-stage5-alpha055-falsification-witness\n  => \"runner: /tmp/cascade_s2/ensemble_param.hexa (parametric sigma2 adapted from universe_ensemble.hexa)\"\n  => \"topologies: chain1d (1D ring), torus2d (sqrt(N)×sqrt(N)), complete (all-to-all proxy) — generic, not canonical t3\"\n  => \"seeds: 3 per cell (6, 13, 17); ticks: 32 primary + 64 stationarity check on torus2d\"\n  => \"sigma2 values: 64 baseline → 512 (chain, complete) / 484=22² (torus perfect-square)\"\n  => \"wall-clock: ~8s total — well under 20-min budget\"", source_file: "atlas.n6", source_line: 23059, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-stage5-alpha055-falsification-witness"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s2-scaling-table", raw: "@C clay-cascade-s2-scaling-table :: meta [4]\n  <- clay-cascade-s2-ensemble-run-config\n  => \"α = log(ratio) / log(N_512 / N_64); per-axis stddev across 3 seeds in parens\"\n  => \"chain1d  64→512: α_E=-0.024  α_C=-0.667  α_S=+0.016  drift_pct=-15.3%\"\n  => \"torus2d  64→484: α_E=+0.007  α_C=-0.685  α_S=+0.098  drift_pct=+1.3%\"\n  => \"complete 64→512: α_E=-0.010  α_C=-0.723  α_S=+0.056  drift_pct=-0.8%\"\n  => \"torus2d  ticks=64: α_E=+0.072 α_C=-0.764 α_S=+0.014  drift_pct=+15.6% — ticks-window changes α_E sign\"\n  => \"stddev/mean: E ~3-15% / correl ~25% / entropy ~1-7% / drift ~5-25%\"", source_file: "atlas.n6", source_line: 23067, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-ensemble-run-config"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s2-energy-intensive-not-sub-extensive", raw: "@C clay-cascade-s2-energy-intensive-not-sub-extensive :: meta [4!]\n  <- clay-cascade-s2-scaling-table\n  => \"★ α_E ∈ [-0.024, +0.072] ≈ 0 across all 3 topologies — energy INTENSIVE not sub-extensive\"\n  => \"Stage-5 α=0.55 prediction OVER-PREDICTS E_512 by ~3× (obs/pred ≈ 0.31)\"\n  => \"axis-13 correlator scales N^(-0.70 ± 0.03) — finite-range correlation diluted on growing lattice as expected\"\n  => \"axis-14 Shannon-proxy near-saturated (~0.9-1.0) at both scales — proxy ceiling reached\"\n  => \"axis-15 drift cells-INDEPENDENT at fixed ticks; integrator-drift dominated by ticks-count not cells-count\"", source_file: "atlas.n6", source_line: 23076, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-scaling-table"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
