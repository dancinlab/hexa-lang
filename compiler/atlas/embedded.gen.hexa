    AtlasNode { kind: "C", id: "atlas-self-arch-axis-j-final-state", raw: "@C atlas-self-arch-axis-j-final-state = PROPOSAL-NOT-ACTUATED :: meta [4!]\n  <- atlas-self-arch-axis-j-supersession-witness\n  <- axis-j-orthogonality-analysis\n  <- axis-j-raw-117-5-check-results\n  <- axis-j-raw-91-C3-honest-disclosures\n  -> next-axis-K-candidates-deferred\n  => \"axis-J defined; 5-check 5/5 PASS; raw 91 C3 disclosures complete; orthogonality vs D-I clean (zero interference, strong synergy with G/I)\"\n  => \"next-step: axis-K discovery. Strongest remaining candidates from axis-J probe: (c) intrinsic time-axis (date metadata becomes queryable, complements axis-J's YYYY-MM-DD strings); (b) intrinsic grammar-version (atlas.n6 self-versioning, complements axis-J supersession at the SCHEMA level)\"\n  => \"DO NOT auto-absorb. shard awaits human review per scope contract.\"\n  => \"shard appended at: /Users/ghost/core/n6-architecture/atlas/atlas.append.atlas-self-arch-axis-j-supersession-2026-04-28.n6\"", source_file: "atlas.n6", source_line: 23987, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["atlas-self-arch-axis-j-supersession-witness", "axis-j-orthogonality-analysis", "axis-j-raw-117-5-check-results", "axis-j-raw-91-C3-honest-disclosures"], derives: ["next-axis-K-candidates-deferred"], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s2-tick3-axis-14-renyi-2-witness", raw: "@C clay-cascade-s2-tick3-axis-14-renyi-2-witness :: meta [4!]\n  <- raw-91-C3-honest-disclosure\n  <- raw-71-falsifier-retire-rule\n  <- own#11-strict-no-resolution-claim\n  <- clay-cascade-s2-tick2-axis-14-noise-floor-suspect\n  -> clay-cascade-s2-tick3-axis-14-saturating-proxy-explanation\n  => \"★ axis-14 PARTIAL RECOVERY — REPLACE-ESTIMATOR with Renyi-2 H_2=-log(p^2+q^2), NOT full RETRACT\"\n  => \"diagnosis: 4p(1-p) Shannon-proxy SATURATES near p~0.5 (8/10 topologies within 5% of 1000 ceiling)\"\n  => \"underlying p-signal disc=0.186 (REAL); Renyi-2 disc=0.106 above 0.10 threshold; Shannon disc=0.080 (saturated)\"", source_file: "atlas.n6", source_line: 23998, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["raw-91-C3-honest-disclosure", "raw-71-falsifier-retire-rule", "own#11-strict-no-resolution-claim", "clay-cascade-s2-tick2-axis-14-noise-floor-suspect"], derives: ["clay-cascade-s2-tick3-axis-14-saturating-proxy-explanation"], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s2-tick3-axis-14-saturating-proxy-explanation", raw: "@C clay-cascade-s2-tick3-axis-14-saturating-proxy-explanation :: meta [4]\n  <- clay-cascade-s2-tick3-axis-14-renyi-2-witness\n  => \"wavepacket centered at boundary i=32 → all topologies see similar bipartition mass p~0.4-0.5\"\n  => \"4p(1-p) is parabolic with peak at p=0.5 → near-peak inputs all map to ~1000 (collapsed)\"\n  => \"PSCALE 1000→10000 NO-HELP (disc 0.0798→0.0797): NOT resolution-limited, the proxy itself saturates\"\n  => \"Renyi-2 H_2=-log(p^2+q^2) is non-saturating monotone in |p-0.5| → preserves signal in compression-blind regime\"\n  => \"Tsallis-0.5 super-additive (worse, disc=0.035); Tsallis-2 = 1-p^2-q^2 = (1/2)·4p(1-p) algebraic re-scale (identical disc)\"", source_file: "atlas.n6", source_line: 24008, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-tick3-axis-14-renyi-2-witness"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s2-tick3-axis-14-discrimination-table", raw: "@C clay-cascade-s2-tick3-axis-14-discrimination-table :: meta [4]\n  <- clay-cascade-s2-tick3-axis-14-renyi-2-witness\n  => \"format: estimator → discrimination = stddev/mean across 10 D=3 topologies\"\n  => \"raw p_mille:           disc = 0.186 (strong-signal — underlying real signal)\"\n  => \"Renyi-2:               disc = 0.106 (REAL-SIGNAL — above 0.10 threshold)\"\n  => \"Shannon @ PSCALE=1000: disc = 0.0798 (marginal/saturated)\"\n  => \"Shannon @ PSCALE=10000:disc = 0.0797 (marginal — confirms NOT resolution issue)\"\n  => \"Tsallis-2:             disc = 0.0797 (marginal — algebraic re-scale of Shannon)\"\n  => \"Tsallis-0.5:           disc = 0.0353 (noise-floor-ish — over-compresses near p=0.5)\"", source_file: "atlas.n6", source_line: 24016, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-tick3-axis-14-renyi-2-witness"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s2-tick3-axis-14-renyi-2-recommendation", raw: "@C clay-cascade-s2-tick3-axis-14-renyi-2-recommendation :: meta [4!]\n  <- clay-cascade-s2-tick3-axis-14-discrimination-table\n  -> clay-cascade-s2-tick3-K3-verify-grid-restoration\n  => \"★ ATLAS RECOMMENDATION — adopt Renyi-2 estimator going forward; Shannon 4p(1-p) is replace-target\"\n  => \"K=2 STRONG (axis-13 + axis-16) restores to K=3 PROVISIONAL with axis-14[Renyi-2]\"\n  => \"previous axis-14 numerics (iter-46 to iter-70 with Shannon proxy) re-interpret as 'compressed signature, full signal in raw-p'\"\n  => \"follow-up: hexa fixed-point integer log approximation for Renyi-2 (current is Python float)\"\n  => \"follow-up: re-measure full 18 D=3 cohort with Renyi-2 to update phase-portrait + correlation matrix\"", source_file: "atlas.n6", source_line: 24026, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-tick3-axis-14-discrimination-table"], derives: ["clay-cascade-s2-tick3-K3-verify-grid-restoration"], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s2-tick3-axis-14-C3-limits", raw: "@C clay-cascade-s2-tick3-axis-14-C3-limits :: meta [4]\n  <- clay-cascade-s2-tick3-axis-14-renyi-2-witness\n  => \"n=5 disc=0.106 barely above 0.10 threshold — seed-jitter could straddle\"\n  => \"Renyi-2 here in float (Python /tmp/cascade_s2/axis14_alt.py); native-hexa needs integer log approximation\"\n  => \"Tsallis-0.5 needs fractional power p^0.5 — hexa-incompatible without Newton iter integer sqrt\"\n  => \"wavepacket boundary-init i=32 only; non-boundary (i=16, 48) might shift p and reverse saturation verdict\"\n  => \"saturation may be combined integer-Laplacian + half-cut quantization artifact — not deconvolved\"\n  => \"own#11 strict: Bekenstein exempt (sigma2=64 toy, no physical entropy claim)\"", source_file: "atlas.n6", source_line: 24035, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-tick3-axis-14-renyi-2-witness"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s2-tick3-tau-L2-REFUTED-witness", raw: "@C clay-cascade-s2-tick3-tau-L2-REFUTED-witness :: meta [4!]\n  <- raw-91-C3-honest-disclosure\n  <- raw-71-falsifier-retire-rule\n  <- own#11-strict-no-resolution-claim\n  <- clay-cascade-s2-tick2-replacement-hypothesis-tau-L-squared\n  -> clay-cascade-s2-tick3-mass-oscillation-revised-mechanism\n  => \"★ tau ~ O(L^2) REFUTED — chain1d log-log slope = -0.102 (R^2=0.58), NOT slope=2\"\n  => \"tau is L-INDEPENDENT — set by mass term not lattice diffusion\"\n  => \"revised mechanism: tau_fit ~23.6 ticks ≈ mass-oscillation period 2pi/sqrt(m^2/PSCALE) = 19.9 ticks\"", source_file: "atlas.n6", source_line: 24044, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["raw-91-C3-honest-disclosure", "raw-71-falsifier-retire-rule", "own#11-strict-no-resolution-claim", "clay-cascade-s2-tick2-replacement-hypothesis-tau-L-squared"], derives: ["clay-cascade-s2-tick3-mass-oscillation-revised-mechanism"], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s2-tick3-tau-L-table", raw: "@C clay-cascade-s2-tick3-tau-L-table :: meta [4]\n  <- clay-cascade-s2-tick3-tau-L2-REFUTED-witness\n  => \"format: L → tau_1/e ticks | tau_fit ticks | R^2 (descent-only saturation fit)\"\n  => \"L=4:  47.8 | 30.3 | 0.977\"\n  => \"L=6:  46.6 | 22.5 | 0.939\"\n  => \"L=8:  43.7 | 21.8 | 0.960\"\n  => \"L=10: 41.5 | 24.5 | 0.994\"\n  => \"L=12: 40.2 | 19.5 | 0.979\"\n  => \"L=16: 43.8 | 22.9 | 0.990\"\n  => \"tau_1/e mean = 43.9 ± 2.9 ticks (CV=6.6%); tau_fit mean = 23.6 ± 3.6 (CV=15%) — robust L-independence\"", source_file: "atlas.n6", source_line: 24054, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-tick3-tau-L2-REFUTED-witness"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s2-tick3-mass-oscillation-revised-mechanism", raw: "@C clay-cascade-s2-tick3-mass-oscillation-revised-mechanism :: meta [4!]\n  <- clay-cascade-s2-tick3-tau-L-table\n  => \"★ revised mechanism: HARMONIC OSCILLATION period set by mass term, NOT lattice diffusion\"\n  => \"omega = sqrt(m^2/PSCALE) = sqrt(0.1) = 0.316; period 2pi/omega = 19.9 ticks\"\n  => \"observed tau_fit = 23.6 ticks within 18% of mass period — close match\"\n  => \"descent bottom T_min ~ 64-96 ticks (~3-4 mass periods), L-independent\"\n  => \"regime: small-lattice mass-dominated (xi_lattice << xi_mass at all tested L)\"\n  => \"implication: tick-2 saturation R^2=0.997 was per-L oscillation envelope, NOT L-dependent equilibration\"", source_file: "atlas.n6", source_line: 24065, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-tick3-tau-L-table"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s2-tick3-t3-integrator-unstable", raw: "@C clay-cascade-s2-tick3-t3-integrator-unstable :: meta [4]\n  <- clay-cascade-s2-tick3-tau-L2-REFUTED-witness\n  => \"t3 cubes N∈{27,64,125,216,512} INTEGRATOR-UNSTABLE on Verlet/force-20 step\"\n  => \"L=4 t3: correlator 9 → 19 → 30 → 54 → 339 → -7281 → -2.5e7 → -2.7e10 over T={16..256}\"\n  => \"energy drift grows ~10^4× per 64-tick block — cannot test 3D regime without symplectic stepper or smaller dt\"\n  => \"current data only excludes L^2-scaling in small-lattice mass-dominated regime; large-L crossover untestable\"", source_file: "atlas.n6", source_line: 24074, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-tick3-tau-L2-REFUTED-witness"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s2-tick3-tau-L2-followup", raw: "@C clay-cascade-s2-tick3-tau-L2-followup :: meta [4]\n  <- clay-cascade-s2-tick3-mass-oscillation-revised-mechanism\n  => \"follow-up test: vary m^2 explicitly, predict tau ∝ 1/sqrt(m^2) (mass-oscillation hypothesis)\"\n  => \"follow-up: implement symplectic integrator for t3 to test 3D regime + larger L\"\n  => \"follow-up: enlarge chain1d L range [16, 64, 256] to detect potential xi_mass < L crossover where diffusion class might emerge\"\n  => \"atlas integrity strengthened by REFUTATION → revised hypothesis registered, not silently retained\"", source_file: "atlas.n6", source_line: 24081, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s2-tick3-mass-oscillation-revised-mechanism"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
