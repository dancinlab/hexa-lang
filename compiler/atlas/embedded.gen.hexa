    AtlasNode { kind: "C", id: "provenance_bit_overhead", raw: "@C provenance_bit_overhead = phi/sigma_n = 1/36 :: architecture [10*]\n  <- phi, sigma_n\n  => \"텐서당 provenance bit 오버헤드 = phi/sigma_n = 2/72 = 1/36 ≈ 2.78%\"\n  => \"AI-native 아키텍처 honesty-triad 실리콘 구현 비용; phi=euler_totient(6)=2, sigma_n=sigma*n=72\"\n  ~> phi = 2, sigma_n = 72: phi/sigma_n = 2/72 = 1/36 = 0.02778\n  |> reports/sessions/omega-cycle-ai-native-arch-beyond-gpu-2026-04-26.md §4", source_file: "atlas.n6", source_line: 22602, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["phi", "sigma_n"], derives: [], applications: [], equivalents: [], converges: ["phi = 2, sigma_n = 72: phi/sigma_n = 2/72 = 1/36 = 0.02778"], verified_by: ["reports/sessions/omega-cycle-ai-native-arch-beyond-gpu-2026-04-26.md §4"], breakthroughs: [] } },
