    AtlasNode { kind: "C", id: "sim-3-axis-PARTIAL-CORRELATIONS", raw: "@C sim-3-axis-PARTIAL-CORRELATIONS :: meta [4!]\n  → \"★★★★ Partial correlations (control for 3rd axis):\"\n  → \"  r(13; 14 | 15) = +0.3959   (raw r(13;14) = +0.3434, ↑ stronger after control)\"\n  → \"  r(13; 15 | 14) = +0.2900   (raw r(13;15) = +0.2046, ↑ stronger after control)\"\n  → \"  r(14; 15 | 13) = -0.2762   (raw r(14;15) = -0.1837, |↑| stronger after control)\"\n  → \"\"\n  → \"★ ALL three partial r exceed the corresponding raw r in magnitude\"\n  → \"  → suppression effect: each axis partially MASKS the others' co-variance\"\n  → \"  → Adding the 3rd axis as control REVEALS hidden coupling structure\"\n  → \"\"\n  → \"Most-informative 2-axis combo (highest partial-mutual-info given controlled axis):\"\n  → \"  axis-13 × axis-14 controlled by axis-15: I_partial = 0.0858 nats = 0.1238 bits\"\n  → \"  → axis-13 + axis-14 are the strongest 2-axis topology discriminator\"\n  → \"  → axis-15 acts as orthogonal perturbation that sharpens 13×14 alignment\"", source_file: "atlas.n6", source_line: 22697, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "sim-3-axis-INFORMATION-VERDICT", raw: "@C sim-3-axis-INFORMATION-VERDICT :: meta [4!]\n  → \"★★★★★★ INFORMATION-THEORETIC VERDICT (Gaussian approx, n=15):\"\n  → \"\"\n  → \"1. det(R)=0.78 → 3 axes carry NEAR-INDEPENDENT topology information\"\n  → \"2. Total correlation T = 0.18 bits → joint redundancy is small\"\n  → \"3. Interaction info II = -0.03 bits → mild SYNERGY (not redundancy)\"\n  → \"4. Effective rank = 2.66 of 3 → genuine 3-D fingerprint, not a 2-D plane\"\n  → \"5. All partial r exceed raw r → axes mutually MASK coupling\"\n  → \"6. Best 2-axis discriminator: (13, 14) for rank, (14, 15) for linear orthogonality\"\n  → \"\"\n  → \"★ 3-axis fingerprint is INFORMATION-EFFICIENT for topology discrimination\"\n  → \"  axis-13 + axis-14 + axis-15 ≈ 3 quasi-orthogonal probes\"\n  → \"  Adding any one axis to the other two produces measurable independent gain\"", source_file: "atlas.n6", source_line: 22712, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
