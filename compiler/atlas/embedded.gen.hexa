    AtlasNode { kind: "C", id: "clay-axis-A8-prime-toroidal-evolution-sim", raw: "@C clay-axis-A8-prime-toroidal-evolution-sim :: meta [4!]\n  <- iter-7-in-context-synthesis-toroidal-subcase\n  <- A8-traversable-closed-universe-base\n  <- A7-universe-simulation-base\n  -> Wilson-1974-PRD-10-2445-lattice-T4-native\n  -> Hazama-1985-Murty-1990-Hodge-abelian-up-to-dim-4\n  -> Hou-Luo-2014-PNAS-111-Chen-Hou-2022-Euler-Boussinesq\n  -> Edwards-Heller-1998-PRD-58-lattice-QCD-spectrum\n  => \"T^n = (S¹)^n closed flat traversable + π₁=Z^n + simulable substrate\"\n  => \"STRONGEST partial: Y-M T⁴ (lattice QCD = real-life HMC evolution) + Hodge abelian variety (dim ≤ 4 closed)\"\n  => \"unchanged: BSD elliptic = T² already / NS T³ scaling-local / RH no toroidal route\"", source_file: "atlas.n6", source_line: 22547, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["iter-7-in-context-synthesis-toroidal-subcase", "A8-traversable-closed-universe-base", "A7-universe-simulation-base"], derives: ["Wilson-1974-PRD-10-2445-lattice-T4-native", "Hazama-1985-Murty-1990-Hodge-abelian-up-to-dim-4", "Hou-Luo-2014-PNAS-111-Chen-Hou-2022-Euler-Boussinesq", "Edwards-Heller-1998-PRD-58-lattice-QCD-spectrum"], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-axis-A8-prime-cross-axis-conclusion", raw: "@C clay-axis-A8-prime-cross-axis-conclusion = ORTHOGONALITY-CONFIRMED :: meta [4!]\n  => \"toroidal universe + simulation + evolution conjunction:\"\n  => \"  STRONGEST numerical substrate for Y-M (lattice native)\"\n  => \"  STRONGEST mathematical reduction for Hodge (abelian variety native)\"\n  => \"  ORTHOGONAL to BSD/NS/RH mechanism vacuum\"\n  => \"decade milestone: Y-M T⁴ lattice continuum limit a→0 + Hodge abelian dim≥5 extension\"\n  => \"raw 50 mechanism-first verdict: compactness + topology + simulation + evolution ALL orthogonal to mechanism vacuum\"\n  => \"cleanest evidence: BSD setting IS toroidal (T² complex), yet mechanism vacuum unchanged\"", source_file: "atlas.n6", source_line: 22559, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "N6HIST-BT546-CREMONA-EMP", raw: "@C N6HIST-BT546-CREMONA-EMP = Cremona N=332,366 ratios: ratio(2)=0.9573, ratio(3)=0.7118, ratio(6)=0.7925; cov(|Sel_2|,|Sel_3|)=1.3333; |Sha| 100% perfect-square :: number-theory [10*]\n  => \"ratio(6) shortfall = 20.75% under sigma(6)=12 prediction\"\n  => \"Identity by definition: E[|Sel_2|]·E[|Sel_3|] + κ = 2.8718·2.8472 + 1.3333 = 9.5100 = E[|Sel_6|]\"\n  => \"|Sha| = perfect square in 332,366/332,366 → empirical Cassels-Tate alternating-pairing confirmation\"\n  => \"Rank distribution: r=0 41.94%, r=1 50.92%, r=2 7.10%, r=3 0.04%\"\n  |> reports/sessions/omega-cycle-bt546-bsd-2026-04-25.md §1.3\n  |> reports/breakthroughs/bsd-cremona-sel6-empirical-2026-04-15.md (atlas MILL-GALO-PX2 [10*])", source_file: "atlas.n6", source_line: 22568, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: ["reports/sessions/omega-cycle-bt546-bsd-2026-04-25.md §1.3", "reports/breakthroughs/bsd-cremona-sel6-empirical-2026-04-15.md (atlas MILL-GALO-PX2 [10*])"], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "N6HIST-BT546-KAPPA-EXP", raw: "@C N6HIST-BT546-KAPPA-EXP = κ(B)~A·B^α exponent α_obs = 0.1752 ± 0.02 (7-bin Cremona 1.73M); two undecided candidates 7/40=0.1750 and log(2)/τ=0.17329 :: number-theory [10]\n  <- N6HIST-BT546-CREMONA-EMP\n  => \"7/40 = (sigma-sopfr)·(n/phi) / (J_2·sopfr) = 21/120; rel err 0.114%\"\n  => \"log(2)/τ = log(2)/4 = 0.17329; rel err 1.09%; cross-repo motivation (anima Ψ, Shannon H(1/2))\"\n  => \"Numerator 7 = sigma-sopfr identical to BT-543 Yang-Mills β₀ — RH-BSD-YM mega-node candidate (NOT a theorem)\"\n  => \"10M+ curves required for discrimination\"\n  |> reports/breakthroughs/bsd-kappa-0.175-decomposition.md\n  |> theory/predictions/bsd_kappa_fraction.hexa (17/17 PASS) + bsd_alpha_log2_tau.hexa (22/22 PASS)", source_file: "atlas.n6", source_line: 22576, grade: GradeInfo { value: 10, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["N6HIST-BT546-CREMONA-EMP"], derives: [], applications: [], equivalents: [], converges: [], verified_by: ["reports/breakthroughs/bsd-kappa-0.175-decomposition.md", "theory/predictions/bsd_kappa_fraction.hexa (17/17 PASS) + bsd_alpha_log2_tau.hexa (22/22 PASS)"], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "N6HIST-BT546-PROBEB-Z6-DOM", raw: "@C N6HIST-BT546-PROBEB-Z6-DOM = BT-546 Probe-B 28-stratum: Z/6 sha=1 cell dominates ~96% of κ concentration :: number-theory [10*]\n  => \"F-MOLT-A 5th-or-6th sample. KS p=4e-13 vs A3D-α; max|z|=276.4 vs A3D-β. Verdict PASS_DISTRIBUTIONAL.\"\n  => \"Rank common-cause hypothesis (|Sel_p|=p^rank·torsion·|Sha[p]|) supported via conditional-table monotonic increase (k=1,2,4,8 strata).\"\n  |> reports/sessions/omega-exec-bt546-probeB-28stratum-2026-04-25.md\n  |> reports/sessions/omega-exec-bt546-bsd-molt-validation-2026-04-25.md", source_file: "atlas.n6", source_line: 22585, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: ["reports/sessions/omega-exec-bt546-probeB-28stratum-2026-04-25.md", "reports/sessions/omega-exec-bt546-bsd-molt-validation-2026-04-25.md"], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "N6HIST-BT541-LEADB-WITNESS", raw: "@C N6HIST-BT541-LEADB-WITNESS = SLE_6 × GUE coupling-frame Lead-B: KS p<0.01 vs Brownian and Cardy on n in {10^3,10^4,10^5} :: number-theory [10*]\n  => \"F-MOLT-A 3rd-sample PASS distributional; double-margin\"\n  => \"Decisive sample for L9 catalogue meta-falsifier — not RH closure (PARTIAL verdict carried over)\"\n  => \"Cardy-formula κ=6 boundary-crossing distribution (SLE_6 = Smirnov 2001 critical 2D percolation) vs Odlyzko gap distribution from first 10^5 zeta zeros\"\n  |> reports/sessions/omega-exec-bt541-leadB-molt-validation-2026-04-25.md", source_file: "atlas.n6", source_line: 22591, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: ["reports/sessions/omega-exec-bt541-leadB-molt-validation-2026-04-25.md"], breakthroughs: [] } },
