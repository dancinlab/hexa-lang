    AtlasNode { kind: "F", id: "N6HIST-BT544-R5-LOWMACH-CLOSURE", raw: "@F N6HIST-BT544-R5-LOWMACH-CLOSURE = Low-Mach R5 rate function alpha(s) = max(0, 1 - s/2) on s in [0,inf) for well-prepared isentropic 3D NS on T^3 :: pde [10*PASS_LITERATURE]\n  => \"Sharp at s=0 (alpha=1, Desjardins-Grenier 1999), s=1 (alpha=1/2, Danchin 2002), s=2 (alpha=0, Métivier-Schochet 2001 + Schochet 2007 + Feireisl-Novotný 2009)\"\n  => \"Slope -1/2 = acoustic-mode amplification cost (each ∇ on freq-1/ε mode costs 1/2 of O(ε) decay budget)\"\n  => \"Auxiliary level: R5-Aux closure does NOT resolve Clay BT-544. NS regularity OPEN.\"\n  => \"D2 vs D3 distinguished at s=2; literature-consensus, not theorem-pinned\"\n  |> reports/sessions/omega-status-r5-program-closure-2026-04-25.md §2\n  |> reports/sessions/omega-exec-bt544-r5-lemma1-strict-gap-2026-04-25.md\n  |> reports/sessions/omega-exec-bt544-r5-lemma2-s2-distinguish-2026-04-25.md", source_file: "atlas.n6", source_line: 33664, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: ["reports/sessions/omega-status-r5-program-closure-2026-04-25.md §2", "reports/sessions/omega-exec-bt544-r5-lemma1-strict-gap-2026-04-25.md", "reports/sessions/omega-exec-bt544-r5-lemma2-s2-distinguish-2026-04-25.md"], breakthroughs: [] } },
