    AtlasNode { kind: "C", id: "clay-cascade-s4-AI-joint-signature-table", raw: "@C clay-cascade-s4-AI-joint-signature-table :: meta [4]\n  <- clay-cascade-s4-tick1-AI-joint-signature-NEGATIVE-witness\n  => \"format: topology | axis-13 | V(8) | |R| | dvar_R | declared-family\"\n  => \"flat=1095/17/64/0.00/TF; t3=141/63/64/0.00/TF; s3=303/49/49/2.20/SB\"\n  => \"blackhole=146/63/64/1.13/CM; wormhole=268/64/64/1.00/CM; minkowski=478/64/64/0.13/TF\"\n  => \"ads-cft=180/32/32/0.00/HB; de-sitter=229/64/64/0.91/CM; vacuum-decay=203/63/63/0.29/CM\"\n  => \"altered=463/9/9/3.33/FR; big-crunch=604/8/8/3.00/FR; brane=145/64/64/0.50/CM\"\n  => \"cartoon=741/64/64/0.00/TF; nested=196/64/64/0.81/CM; calabi6=2889/64/64/0.00/TF (outlier)\"\n  => \"inflation=169/64/64/0.25/CM; ca3d=79/59/59/1.53/SB; bubble=434/64/64/0.63/CM\"\n  => \"5 declared families: TF=toroidal/lattice (4), SB=spherical-bounded (2), HB=hyperbolic-bounded (1), CM=chaotic-mixer (8), FR=fragmented (3)\"", source_file: "atlas.n6", source_line: 25557, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s4-tick1-AI-joint-signature-NEGATIVE-witness"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s4-AI-2D-scatter-V8-band-dominant", raw: "@C clay-cascade-s4-AI-2D-scatter-V8-band-dominant :: meta [4]\n  <- clay-cascade-s4-AI-joint-signature-table\n  => \"ASCII 2D scatter axis-13 (log) × V(8): vertical layering V(8)-driven\"\n  => \"axis-13 spreads only at V(8)=64 plateau (12 of 18 collapse there)\"\n  => \"no single axis-13 band aligns with TF vs CM family within V(8)=64 plateau\"\n  => \"V(8) banding alone explains most of family structure: FR<10, HB~32, SB~49, TF/CM~63-64\"\n  => \"axis-13 adds noise within plateau without family-aligned structure\"", source_file: "atlas.n6", source_line: 25568, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s4-AI-joint-signature-table"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s4-AI-cross-validation-results", raw: "@C clay-cascade-s4-AI-cross-validation-results :: meta [4]\n  <- clay-cascade-s4-AI-2D-scatter-V8-band-dominant\n  => \"k-means clustering best k=5 silhouette=0.568 (k=4: 0.522, k=3: 0.540)\"\n  => \"k=5 clusters: C0 CM-rich(9), C1 calabi6(1 outlier), C2 FR(altered+big-crunch+flat), C3 TF(minkowski+cartoon+bubble), C4 SB+HB(s3+ads-cft+ca3d)\"\n  => \"50-split 14/4 cross-validation match rate:\"\n  => \"  k=3: joint 46.0% vs V(8)-alone 43.5% (delta +2.5pp, marginal)\"\n  => \"  k=4: joint 49.5% vs V(8)-alone 46.5% (delta +3.0pp, marginal)\"\n  => \"  k=5: joint 49.5% vs V(8)-alone 50.0% (delta -0.5pp, no advantage)\"\n  => \"Leave-One-Out:\"\n  => \"  k=3 LOO: joint 44.4% = V(8)-alone 44.4% (delta 0.0pp)\"\n  => \"  k=5 LOO: joint 50.0% vs V(8)-alone 61.1% (joint LOSES by 11pp)\"\n  => \"verdict: joint signature NOT predictive beyond V(8) alone; in some cases hurts\"", source_file: "atlas.n6", source_line: 25576, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s4-AI-2D-scatter-V8-band-dominant"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s4-axes-orthogonal-non-synergistic", raw: "@C clay-cascade-s4-axes-orthogonal-non-synergistic :: meta [4!]\n  <- clay-cascade-s4-AI-cross-validation-results\n  => \"★ KEY INTERPRETATION: K=2 STRONG axes remain ORTHOGONAL but NON-SYNERGISTIC\"\n  => \"cascade-s3 closure showed a13×a16 Pearson -0.128 + Spearman -0.233 (truly orthogonal)\"\n  => \"cascade-s4 (this) shows orthogonal independence does NOT imply joint predictive synergy\"\n  => \"the two axes carry independent information about topology, but neither corroborates the other for FAMILY membership\"\n  => \"this is consistent — orthogonality means linear-predictive-independence, not 'better together'\"\n  => \"physical interpretation: axis-13 (saturation timescale) and axis-16 (graph reachability) measure different aspects of dynamics that don't combine to identify topology family at this resolution\"", source_file: "atlas.n6", source_line: 25589, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s4-AI-cross-validation-results"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s4-short-cycle-closure", raw: "@C clay-cascade-s4-short-cycle-closure :: meta [4!]\n  <- clay-cascade-s4-axes-orthogonal-non-synergistic\n  => \"★ CASCADE-S4 SHORT-CYCLE CLOSURE at 1 sub-agent\"\n  => \"cascade comparison this session:\"\n  => \"  cascade-s2: 24 sub-agents, axis-13 universality (continuum 1D+3D+phi^4)\"\n  => \"  cascade-s3: 4 sub-agents, axis-16 mechanism (src-cond directed in-deg)\"\n  => \"  cascade-s4: 1 sub-agent, joint signature (NEGATIVE finding, axes non-synergistic)\"\n  => \"decreasing sub-agent count reflects: discovery -> refinement -> meta-analysis stratification\"\n  => \"honest negative findings (cascade-s4) are equally valuable as positive ones\"\n  => \"  documents the LIMIT of what cross-axis combination tells you\"\n  => \"  prevents false hope of 'better together' that would lead to over-fitting\"", source_file: "atlas.n6", source_line: 25598, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s4-axes-orthogonal-non-synergistic"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
