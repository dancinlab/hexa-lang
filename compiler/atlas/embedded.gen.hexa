    AtlasNode { kind: "C", id: "clay-cascade-s3-tick2-AF-mixer-design", raw: "@C clay-cascade-s3-tick2-AF-mixer-design :: meta [4]\n  <- clay-cascade-s3-tick2-AF-deg-var-mechanism-NARROWED-witness\n  => \"adversarial mixer family: nbr(i, axis) = (i*A + axis*B + C) mod 64; src=32, 3 axes\"\n  => \"M1: A=8  B=17 C=5  | gcd(8,64)=8   | 8 cosets\"\n  => \"M2: A=16 B=7  C=11 | gcd(16,64)=16 | 4 cosets\"\n  => \"M3: A=32 B=13 C=3  | gcd(32,64)=32 | 2 cosets\"\n  => \"M4: A=4  B=23 C=7  | gcd(4,64)=4   | 16 cosets\"\n  => \"M5: A=48 B=19 C=9  | gcd(48,64)=16 | 4 cosets (cartoon-bug analog)\"\n  => \"C1: A=47 B=23 C=13 | gcd(47,64)=1  | 64 cosets (proper cartoon, FULL control)\"\n  => \"C2: A=45 B=23 C=13 | gcd(45,64)=1  | 64 cosets (low-deg-var FULL control)\"", source_file: "atlas.n6", source_line: 25300, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s3-tick2-AF-deg-var-mechanism-NARROWED-witness"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
