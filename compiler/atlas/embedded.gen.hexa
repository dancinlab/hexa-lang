    AtlasNode { kind: "R", id: "clay-iter-53-stage-2-classification", raw: "@R clay-iter-53-stage-2-classification :: meta [4]\n  => \"raw 91 C3 honest: this is Stage 2 PREP, not Stage 2 itself\"\n  => \"  Post-step projection ≠ exact unitarity\"\n  => \"  True exact unitarity requires implicit/Crank-Nicolson scheme:\"\n  => \"    (I + i·H·dt/2) ψ_{t+1} = (I - i·H·dt/2) ψ_t\"\n  => \"  Solving the linear system requires LU decomposition or iterative solver\"\n  => \"  Stage 2 follow-up: implement implicit-explicit (IMEX) leapfrog or\"\n  => \"    Strang-splitting kinetic-potential propagator\"\n  => \"Current scheme: Euler explicit + post-step normalization\"\n  => \"  Norm conserved exactly to per-step accuracy O((dt)²)\"\n  => \"  Acceptable for axis-14 entropy proxy (8% deviation tolerable)\"", source_file: "atlas.n6", source_line: 54004, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
