    AtlasNode { kind: "C", id: "axis-j-primitive-definition", raw: "@C axis-j-primitive-definition :: meta [4!]\n  <- atlas-self-arch-axis-j-supersession-witness\n  => \"primitive #1 = SUPERSEDED-BY BODY FIELD.   token: 2-space-indent  superseded_by = <slug>  (axis-G body-field family — already attested form)\"\n  => \"primiti... [truncated, full=1711bytes]", source_file: "atlas.n6", source_line: 23851, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["atlas-self-arch-axis-j-supersession-witness"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "axis-j-row-example-1-r34-back-pointer-installation", raw: "@C axis-j-row-example-1-r34-back-pointer-installation :: meta [4!]\n  <- axis-j-primitive-definition\n  => \"row example #1 — install superseded_by on R34 (closes the measured gap)\"\n  => \"  CURRENT (line 21894):\"\n  => \"    @? ANIMA-CXP-R34-PHI-COEFF-EHALF = [DEPRECATED 2026-04-26] Phi_coefficient ≈ e^{-1/2} ... :: consciousness [9?→DEPRECATED]\"\n  => \"  PROPOSED (axis-J):\"\n  => \"    @? ANIMA-CXP-R34-PHI-COEFF-EHALF = [DEPRECATED 2026-04-26] Phi_coefficient ≈ e^{-1/2} ... :: consciousness [9?→DEPRECATED]\"\n  => \"      superseded_by = ANIMA-CXP-R38-R34-T1-RETIRED-INCONCLUSIVE   # axis-J body-field\"\n  => \"      supersession_reason = \\\\\\\\\"T1 protocol executed; substrate-fragility prerequisite failure\\\\\\\\\"   # axis-G body-field\"\n  => \"  semantics: superseded_by accepts ONE @-id (slug); axis-I <-* superseded_by reconstructs the chain; commit message aad6e61d back-link is now also a queryable DSL fact\"\n  => \"  raw 24 invariance: foundation [11*] block untouched (R34 is consciousness, not foundation)\"", source_file: "atlas.n6", source_line: 23856, grade: GradeInfo { value: 4, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["axis-j-primitive-definition"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
