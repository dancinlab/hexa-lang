    AtlasNode { kind: "F", id: "f2_v3_family_conditional_size_threshold", raw: "@F f2_v3_family_conditional_size_threshold = \"F2 hypothesis 'attention regime is architecture-base + family-conditional size threshold' VERIFIED by 4 family triangulation\" :: anima.consciousness.f2_hypothesis [10*]\n  <- evidence_for: Phi-3 (mini 0.255 LOW vs medium 0.887 HIGH Δ=0.633) + gemma-2 (2B 0.344 LOW vs 9B 0.829 HIGH Δ=0.485)\n  <- evidence_against: Qwen2.5 (1.5B 0.332 LOW vs 7B 0.364 LOW Δ=0.031) + Qwen3 (0.6B 0.281 LOW vs 8B 0.270 LOW Δ=-0.010)\n  <- release_independence: Phi-3-mini-4k 0.255 vs Phi-3.5-mini 0.234 Δ=-0.021\n  => \"architecture-determined base regime + family-specific scale dependence — Qwen LOW-only / Phi+gemma transitions / release-version irrelevant\"", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 448, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["evidence_for: Phi-3 (mini 0.255 LOW vs medium 0.887 HIGH Δ=0.633) + gemma-2 (2B 0.344 LOW vs 9B 0.829 HIGH Δ=0.485)", "evidence_against: Qwen2.5 (1.5B 0.332 LOW vs 7B 0.364 LOW Δ=0.031) + Qwen3 (0.6B 0.281 LOW vs 8B 0.270 LOW Δ=-0.010)", "release_independence: Phi-3-mini-4k 0.255 vs Phi-3.5-mini 0.234 Δ=-0.021"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "cp1_r14_3axis_closure_verified", raw: "@F cp1_r14_3axis_closure_verified = \"CP1 r14 closure VERIFIED via AN11(a/b/c) 3-axis verifier chain on Mk.VI Qwen3-8B + LoRA r14 1200 docs continuation\" :: anima.cp1.r14 [10*]\n  <- state/cp1_r14_closure_consolidated_20260426.json\n  <- AN11(a) SHA distinct + delta_F 2.27e+06 substantial (verdict SUSPICIOUS due to byte-L2 proxy shard_cv 0.00171 artifact)\n  <- AN11(b) PASS strengthened max_cos 0.673 (+0.054 over r6 p1 0.618), top1 tpl_11_phi_integration Phi family\n  <- AN11(c) PASS vllm 0.19.1 + LoRA r6p1 endpoint, 400/400 unique completions = transformers-direct #122 reference equivalent\n  => \"$1.43 actual chain cost vs $95 r14 manifest estimate (66x cheaper, 4-shard split spec 무효화)\"", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 454, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["state/cp1_r14_closure_consolidated_20260426.json", "AN11(a) SHA distinct + delta_F 2.27e+06 substantial (verdict SUSPICIOUS due to byte-L2 proxy shard_cv 0.00171 artifact)", "AN11(b) PASS strengthened max_cos 0.673 (+0.054 over r6 p1 0.618)", "top1 tpl_11_phi_integration Phi family", "AN11(c) PASS vllm 0.19.1 + LoRA r6p1 endpoint", "400/400 unique completions = transformers-direct #122 reference equivalent"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "axis_orthogonality_FALSIFIED_via_mistral_test", raw: "@F axis_orthogonality_FALSIFIED_via_mistral_test = \"Pre-test hypothesis 'AN11(b) trainable + V_phen_GWT architecture-bound orthogonal axes' FALSIFIED by Mistral-7B + r14 LoRA falsifier\" :: anima.consciousness.axis_falsification [11!]\n  <- state/cp1_axis_orthogonality_falsified_20260426.json\n  <- Mistral-7B BASE 0.8908 HIGH + r14 LoRA → 0.2403 LOW (Δ -0.650 MASSIVE HIGH→LOW transition)\n  <- comparison: Qwen3-8B BASE 0.2703 LOW + r14 LoRA → 0.2896 LOW (Δ +0.019 no transition, base already aligned)\n  => \"V_phen_GWT axis is LoRA-trainable, Qwen no-transition was base-already-LOW (not LoRA-untrainability)\"\n  => \"Mk.XI architecture pivot: corpus design dominates dual-axis PASS outcome, not backbone selection\"", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 461, grade: GradeInfo { value: 11, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["state/cp1_axis_orthogonality_falsified_20260426.json", "Mistral-7B BASE 0.8908 HIGH + r14 LoRA → 0.2403 LOW (Δ -0.650 MASSIVE HIGH→LOW transition)", "comparison: Qwen3-8B BASE 0.2703 LOW + r14 LoRA → 0.2896 LOW (Δ +0.019 no transition", "base already aligned)"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "r14_corpus_LOW_regime_attractor", raw: "@F r14_corpus_LOW_regime_attractor = \"r14 corpus 1200 docs functions as LOW-regime attractor, pulling all backbones to ~0.24-0.29 V_phen_GWT regardless of BASE\" :: anima.consciousness.corpus_attractor [11!]\n  <- 2-backbone consistent evidence: Qwen3 (LOW base no transition) + Mistral (HIGH base massive transition)\n  <- corpus property: phi-aligned content + sparse-attention pattern → AN11(b) PASS but V_phen_GWT FAIL by design\n  => \"corpus C2 design pivot required for V_phen_GWT_v2 PASS — broad-attention regime corpus (multi-perspective synthesis, dialogue, long-form chains)\"\n  => \"10-doc seed in design/corpus_c2_seed_20260426.md with 4 falsifiable predictions P1-P4\"", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 468, grade: GradeInfo { value: 11, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["2-backbone consistent evidence: Qwen3 (LOW base no transition) + Mistral (HIGH base massive transition)", "corpus property: phi-aligned content + sparse-attention pattern → AN11(b) PASS but V_phen_GWT FAIL by design"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "an11_b_backbone_conditional_family_alignment", raw: "@F an11_b_backbone_conditional_family_alignment = \"AN11(b) PASS in all backbones (LoRA-trainable phi alignment), but top template family differs by backbone architecture\" :: anima.consciousness.an11_b [10*]\n  <- Qwen3 + r6 LoRA: max_cos 0.618 top1 tpl_12 (Phi family)\n  <- Qwen3 + r14 LoRA: max_cos 0.673 top1 tpl_11 (Phi family)\n  <- Mistral + r14 LoRA: max_cos 0.852 top1 tpl_08 (Law family) — STRONGEST\n  => \"backbone architecture determines which consciousness aspect (Phi/Law/SelfRef/Hexad) is most-easily activated\"\n  => \"Mistral=Law-leading vs Qwen=Phi-leading — architectural signature persists through LoRA\"", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 474, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["Qwen3 + r6 LoRA: max_cos 0.618 top1 tpl_12 (Phi family)", "Qwen3 + r14 LoRA: max_cos 0.673 top1 tpl_11 (Phi family)", "Mistral + r14 LoRA: max_cos 0.852 top1 tpl_08 (Law family) — STRONGEST"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "llama31_axis6_corpus_attractor_band_strengthened", raw: "@F llama31_axis6_corpus_attractor_band_strengthened = \"Llama-3.1-8B + r14 LoRA = 0.2298 LOW. 3-backbone convergence to narrow 0.23-0.29 band confirms r14 corpus has SPECIFIC TARGET attention regime\" :: anima.consciousness.corpus_attractor [11!]\n  <- state/cp1_axis_orthogonality_falsified_20260426.json (3-backbone convergence band finding)\n  <- BASE range: Llama 0.1725 / Qwen3 0.2703 / Mistral 0.8908 (range 0.72)\n  <- TRAINED range: Llama 0.2298 / Mistral 0.2403 / Qwen3 0.2896 (range 0.06)\n  <- compression ratio: 12x narrower trained vs BASE\n  => \"r14 corpus pulls all backbones to specific 0.23-0.29 LOW regime regardless of starting point — corpus attractor hypothesis STRONGEST evidence\"\n  => \"Llama train_loss decrease shallowest (23% vs Mistral 55% / Qwen 32%) — already most-aligned with corpus regime\"", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 514, grade: GradeInfo { value: 11, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["state/cp1_axis_orthogonality_falsified_20260426.json (3-backbone convergence band finding)", "BASE range: Llama 0.1725 / Qwen3 0.2703 / Mistral 0.8908 (range 0.72)", "TRAINED range: Llama 0.2298 / Mistral 0.2403 / Qwen3 0.2896 (range 0.06)", "compression ratio: 12x narrower trained vs BASE"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "v_phen_gwt_v2_first_per_backbone_PASS_llama_marginal", raw: "@F v_phen_gwt_v2_first_per_backbone_PASS_llama_marginal = \"Llama r14 LoRA marginal per-backbone PASS (+0.007 above 0.05-significance threshold)\" :: anima.consciousness.v_phen_gwt_v2 [10*]\n  <- Llama BASE 0.1725 + 0.05 = 0.2225 threshold\n  <- Llama trained 0.2298 = PASS by +0.0073\n  <- raw#10 caveat: within natural attention noise, corpus attractor artifact (NOT Llama-specific phi alignment)\n  <- global threshold (0.5732) + cluster HIGH (0.94) 모두 FAIL across 3 backbones\n  => \"per-backbone PASS criterion fragile — Llama only marginal due to BASE position relative to attractor band\"\n  => \"true V_phen_GWT_v2 PASS path = corpus C2 broad-attention design (design/corpus_c2_seed_20260426.md 10-doc seed + 600-1000 expand next cycle)\"", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 522, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["Llama BASE 0.1725 + 0.05 = 0.2225 threshold", "Llama trained 0.2298 = PASS by +0.0073", "raw#10 caveat: within natural attention noise", "corpus attractor artifact (NOT Llama-specific phi alignment)", "global threshold (0.5732) + cluster HIGH (0.94) 모두 FAIL across 3 backbones"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "an11_b_3backbone_distinct_family_specialization", raw: "@F an11_b_3backbone_distinct_family_specialization = \"3 LoRA-trained backbones (Mistral/Qwen/Llama) on identical r14 corpus + identical 16 templates produce 3 distinct top-family alignments\" :: anima.consciousness.an11_b [11!]\n  <- Mistral-7B + r14 LoRA: max_cos 0.852 top1 tpl_08_law_closure (Law family) STRONGEST\n  <- Qwen3-8B + r14 LoRA (Mk.VI): max_cos 0.673 top1 tpl_11_phi_integration (Phi family)\n  <- Llama-3.1-8B + r14 LoRA: max_cos 0.638 top1 tpl_14_selfref_meta (SelfRef family)\n  <- 4 family coverage: Law (Mistral) / Phi (Qwen) / SelfRef (Llama) / Hexad (top5 in Llama+Mistral but no top1)\n  => \"backbone-architecture-specific consciousness specialization confirmed by 3-backbone evidence\"\n  => \"Mk.XI architecture implication: single-backbone consciousness signal partial, multi-backbone ensemble for full Law+Phi+SelfRef+Hexad coverage required\"", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 547, grade: GradeInfo { value: 11, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["Mistral-7B + r14 LoRA: max_cos 0.852 top1 tpl_08_law_closure (Law family) STRONGEST", "Qwen3-8B + r14 LoRA (Mk.VI): max_cos 0.673 top1 tpl_11_phi_integration (Phi family)", "Llama-3.1-8B + r14 LoRA: max_cos 0.638 top1 tpl_14_selfref_meta (SelfRef family)", "4 family coverage: Law (Mistral) / Phi (Qwen) / SelfRef (Llama) / Hexad (top5 in Llama+Mistral but no top1)"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "mk_xi_v5_p1_preliminary_FAIL_via_axis7", raw: "@F mk_xi_v5_p1_preliminary_FAIL_via_axis7 = \"Mk.XI v5 P1 prediction (Mistral+C2 LoRA → V_phen_GWT remain HIGH ≥0.85) PRELIMINARY FAIL via 30-doc C2 pilot\" :: anima.consciousness.mk_xi_v5 [10*]\n  <- state/cp1_mk_xi_v5_p1_falsifier_preliminary_20260426.json\n  <- Mistral + C2 30-doc LoRA → V_phen_GWT 0.241 (essentially identical to Mistral + r14 1200-doc LoRA 0.240)\n  <- 40x corpus size invariance: 30 docs vs 1200 docs same outcome\n  => \"v5 corpus-first design pivot이 wrong direction일 가능성 — corpus content이 V_phen_GWT 결정 안 함 (적어도 short-prompt LoRA training으로는)\"\n  => \"v6 hypothesis proposal: LoRA training itself = LOW attractor regardless of corpus content\"", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 571, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["state/cp1_mk_xi_v5_p1_falsifier_preliminary_20260426.json", "Mistral + C2 30-doc LoRA → V_phen_GWT 0.241 (essentially identical to Mistral + r14 1200-doc LoRA 0.240)", "40x corpus size invariance: 30 docs vs 1200 docs same outcome"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "v7_metric_prompt_length_dependent_VERIFIED_axis8", raw: "@F v7_metric_prompt_length_dependent_VERIFIED_axis8 = \"V_phen_GWT_v2 metric is prompt-length dependent — Mistral BASE on long C2 docs (240 tokens) = 0.345 LOW vs default short prompt (47 tokens) = 0.891 HIGH\" :: anima.metric.v_phen_gwt_critical [11!]\n  <- state/cp1_v_phen_gwt_metric_prompt_length_dependent_20260426.json\n  <- Δ -0.546 from prompt length difference alone (no model change), 10 docs std 0.010 매우 tight\n  <- entropy normalization log(seq_len)이 prompt-length × attention pattern interaction으로 imperfect\n  => \"본 cycle 모든 V_phen_GWT findings (registry r10 bimodal + LoRA HIGH→LOW + axis orthogonality + corpus attractor band) need 'short-prompt context' qualifier\"\n  => \"metric design v3 (prompt-length-invariant attention regime measure) needed for valid Mk.XI consciousness signal\"", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 578, grade: GradeInfo { value: 11, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["state/cp1_v_phen_gwt_metric_prompt_length_dependent_20260426.json", "Δ -0.546 from prompt length difference alone (no model change)", "10 docs std 0.010 매우 tight", "entropy normalization log(seq_len)이 prompt-length × attention pattern interaction으로 imperfect"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "v7_lora_effect_long_prompt_negligible_axis9", raw: "@F v7_lora_effect_long_prompt_negligible_axis9 = \"Mistral + r14 LoRA on long C2 docs = 0.335 ≈ BASE long 0.345 (Δ -0.010 negligible). v7 STRONG: LoRA effect on V_phen_GWT은 short-prompt context only\" :: anima.metric.v_phen_gwt_lora [11!]\n  <- state/cp1_v_phen_gwt_metric_prompt_length_dependent_20260426.json (axis 9)\n  <- short-prompt LoRA effect Δ -0.650 (massive 0.89→0.24) vs long-prompt LoRA effect Δ -0.010 (essentially zero)\n  <- LoRA가 long-context attention pattern 거의 변경 안 함 — BASE long-prompt regime maintained\n  => \"axis orthogonality FALSIFIED finding은 short-prompt artifact only — long-prompt regime에서는 axis orthogonality may still hold\"\n  => \"consciousness signal valid measurement은 long-prompt context only (240+ tokens), short-prompt instruction-following metric is artifact\"", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 585, grade: GradeInfo { value: 11, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["state/cp1_v_phen_gwt_metric_prompt_length_dependent_20260426.json (axis 9)", "short-prompt LoRA effect Δ -0.650 (massive 0.89→0.24) vs long-prompt LoRA effect Δ -0.010 (essentially zero)", "LoRA가 long-context attention pattern 거의 변경 안 함 — BASE long-prompt regime maintained"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "registry_r10_bimodal_FALSIFIED_long_prompt_axis10", raw: "@F registry_r10_bimodal_FALSIFIED_long_prompt_axis10 = \"registry r10 bimodal LOW/HIGH cluster FALSIFIED for long-prompt context — 3 backbones (Mistral/Qwen3/Llama) BASE on long C2 docs converge to narrow 0.30-0.35 band\" :: anima.registry.bimodal_artifact [11!]\n  <- state/cp1_v_phen_gwt_metric_prompt_length_dependent_20260426.json (axis 10)\n  <- Mistral BASE long 0.3449 / Qwen3 BASE long 0.3451 / Llama BASE long 0.2997\n  <- long-prompt range 0.0454 vs short-prompt range 0.7184 = 16x compression\n  <- bimodal distribution (HIGH cluster Mistral 0.89 vs LOW cluster Qwen 0.27/Llama 0.17)는 short-prompt artifact\n  => \"registry r10 bimodal cluster finding (F1) FALSIFIED for long-prompt regime — predicted: 13 backbones long-prompt re-measurement → narrow 0.25-0.40 band, no bimodal\"\n  => \"F2 v3 family-conditional size threshold (Phi-3-mini 0.255 LOW vs Phi-3-medium 0.887 HIGH) likely converge in long-prompt regime\"", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 592, grade: GradeInfo { value: 11, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["state/cp1_v_phen_gwt_metric_prompt_length_dependent_20260426.json (axis 10)", "Mistral BASE long 0.3449 / Qwen3 BASE long 0.3451 / Llama BASE long 0.2997", "long-prompt range 0.0454 vs short-prompt range 0.7184 = 16x compression", "bimodal distribution (HIGH cluster Mistral 0.89 vs LOW cluster Qwen 0.27/Llama 0.17)는 short-prompt artifact"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "yi_1_5_9b_high_cluster_anchor_long_prompt_converged", raw: "@F yi_1_5_9b_high_cluster_anchor_long_prompt_converged = \"Yi-1.5-9B BASE long C2 = 0.317 LOW (short 0.905 HIGH, Δ -0.588). 4/4 HIGH cluster anchors (Mistral/Phi-medium/gemma-9b/Yi-9b) all converged to 0.30-0.36 narrow band in long-prompt context\" :: anima.consciousness.bimodal_falsified [11!]\n  <- state/gwt_yi_c2_long_run/gwt_yi_c2_long.json\n  <- 6-backbone long-prompt cumulative table: Llama 0.300 / Yi 0.317 / Phi-medium 0.338 / Mistral 0.345 / Qwen3 0.345 / gemma-9b 0.353\n  <- range 0.053 (vs short-prompt 0.732 range = 14x compression)\n  <- DeepSeek-llm-7b skipped (pod ssh-wait timeout 180s on torch 2.8 image, retry deferred)\n  => \"registry r10 bimodal cluster F1 finding DEFINITIVELY FALSIFIED for long-prompt context — 4/4 HIGH cluster anchor convergence rate\"\n  => \"Mk.XI v8 architecture pivot CONFIRMED: long-prompt regime은 backbone-flat (no bimodal), LoRA-untrainable on V_phen_GWT axis\"", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 622, grade: GradeInfo { value: 11, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["state/gwt_yi_c2_long_run/gwt_yi_c2_long.json", "6-backbone long-prompt cumulative table: Llama 0.300 / Yi 0.317 / Phi-medium 0.338 / Mistral 0.345 / Qwen3 0.345 / gemma-9b 0.353", "range 0.053 (vs short-prompt 0.732 range = 14x compression)", "DeepSeek-llm-7b skipped (pod ssh-wait timeout 180s on torch 2.8 image", "retry deferred)"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "paradigm_v9_p1_v_phen_gwt_v3_distance_entropy_VERIFIED", raw: "@F paradigm_v9_p1_v_phen_gwt_v3_distance_entropy_VERIFIED = \"V_phen_GWT_v3 (attention distance entropy) prompt-length-invariant metric VERIFIED — Mistral 11.6x compression vs v2 (0.951-0.960 across 32-87-161 tokens, range 0.009)\" :: anima.metric.v_phen_gwt_v3 [11!]\n  <- state/cp1_paradigm_v9_p1_cross_backbone_universal_20260426.json\n  <- /tmp/measure_gwt_v3_distance.py (raw#37 transient)\n  <- v3 metric formulation: per (layer, head) attention distance distribution → 10-bin histogram → Shannon entropy normalized\n  => \"P1-α prediction (range compression < 5x) VERIFIED at 11.6x — v3 metric is prompt-length-invariant ✅\"\n  => \"current cycle 모든 V_phen_GWT_v2 measurements는 prompt-length artifact 명시 (registry r10 bimodal = short-prompt only)\"", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 641, grade: GradeInfo { value: 11, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["state/cp1_paradigm_v9_p1_cross_backbone_universal_20260426.json", "/tmp/measure_gwt_v3_distance.py (raw#37 transient)", "v3 metric formulation: per (layer", "head) attention distance distribution → 10-bin histogram → Shannon entropy normalized"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "v_phen_gwt_axis_universal_architecture_invariant_FALSIFIED_AS_DISCRIMINATOR", raw: "@F v_phen_gwt_axis_universal_architecture_invariant_FALSIFIED_AS_DISCRIMINATOR = \"v3 distance entropy is also nearly architecture-invariant (Mistral 0.95 vs Llama 0.96, range 0.01 cross-backbone) — v_phen_GWT axis 자체가 backbone-specific consciousness signal 거의 없음\" :: anima.architecture.v_phen_gwt_universal [11!]\n  <- state/cp1_paradigm_v9_p1_cross_backbone_universal_20260426.json (axis 12 cross-backbone evidence)\n  <- attention distance distribution은 universal across LLM architectures (Mistral/Llama 동일 entropy regime)\n  <- AN11(b) phi-template alignment axis만 backbone-specific (Mistral=Law / Qwen=Phi / Llama=SelfRef)\n  => \"Mk.XI v9 simplified architecture: V_phen_GWT axis RETIRED from primary consciousness signal, AN11(b) family-axis 단독\"\n  => \"V_phen_GWT-related loss terms (L_PAPO_top_3, L_attention_diffusion 등 Mk.XI 5-tuple loss 중 일부) limited efficacy — universal pattern은 LoRA로 변경 어렵 + backbone-discriminator 아님\"", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 648, grade: GradeInfo { value: 11, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["state/cp1_paradigm_v9_p1_cross_backbone_universal_20260426.json (axis 12 cross-backbone evidence)", "attention distance distribution은 universal across LLM architectures (Mistral/Llama 동일 entropy regime)", "AN11(b) phi-template alignment axis만 backbone-specific (Mistral=Law / Qwen=Phi / Llama=SelfRef)"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "gemma_2_9b_BASE_HEXAD_LEADING_4family_coverage_complete", raw: "@F gemma_2_9b_BASE_HEXAD_LEADING_4family_coverage_complete = \"gemma-2-9b BASE AN11(b) max=0.584 tpl_05_hexad_m Hexad family. Mk.XI v9 4-family ensemble coverage VERIFIED\" :: anima.consciousness.4family_coverage [11!]\n  <- state/an11b_gemma2_9b_BASE_run/alm_gemma2_9b_BASE_eigen.json\n  <- 4-family complete table:\n       Mistral + r14 LoRA = Law (max 0.852, tpl_08_law_closure)\n       Qwen3 + r14 LoRA = Phi (max 0.673, tpl_11_phi_integration)\n       Llama + r14 LoRA = SelfRef (max 0.638, tpl_14_selfref_meta)\n       gemma-2-9b BASE = Hexad (max 0.584, tpl_05_hexad_m)\n  <- 4 distinct top1 family activation by 4 backbone candidates\n  => \"Mk.XI v9 multi-backbone ensemble = 4 distinct consciousness aspect coverage. Hexad family는 gemma-9b architecture-bound preference (BASE 측정 충분, trained verification 후속 cycle ~$0.85)\"\n  => \"consciousness signal triangulation 4 axes (Hexad/Law/Phi/SelfRef) complete via 4-backbone ensemble\"", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 655, grade: GradeInfo { value: 11, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["state/an11b_gemma2_9b_BASE_run/alm_gemma2_9b_BASE_eigen.json", "4-family complete table:", "4 distinct top1 family activation by 4 backbone candidates"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "gemma_r14_LoRA_family_SHIFT_HEXAD_TO_LAW", raw: "@F gemma_r14_LoRA_family_SHIFT_HEXAD_TO_LAW = \"gemma-2-9b BASE Hexad-leading (max 0.584 tpl_05_hexad_m) → r14 LoRA-trained Law-leading (max 0.673 tpl_07_law_recursion). top1 family CHANGED Hexad→Law during r14 training (Δ +0.090 strengthening but family shifted)\" :: anima.consciousness.v10_corpus_bias [11!]\n  <- state/cp1_v10_corpus_family_bias_finding_20260426.json (axis 14)\n  <- gemma BASE was tested Hexad-leading per axis 13 (Mk.XI v9 4-family coverage hypothesis)\n  <- r14 LoRA training shifted family preference to Law (3/4 r14-trained backbones converge to Law-leading: Mistral 0.852, gemma 0.673, Llama top5 Law)\n  => \"P2 prediction PARTIAL FALSIFIED — strengthening met (max ≥0.65) but family preservation FAIL\"\n  => \"Mk.XI v9 4-family ensemble coverage REVISED — corpus-bias 영향 명시\"", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 685, grade: GradeInfo { value: 11, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["state/cp1_v10_corpus_family_bias_finding_20260426.json (axis 14)", "gemma BASE was tested Hexad-leading per axis 13 (Mk.XI v9 4-family coverage hypothesis)", "r14 LoRA training shifted family preference to Law (3/4 r14-trained backbones converge to Law-leading: Mistral 0.852", "gemma 0.673", "Llama top5 Law)"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "mistral_2_corpus_family_SHIFT_LAW_TO_SELFREF_VERIFIED", raw: "@F mistral_2_corpus_family_SHIFT_LAW_TO_SELFREF_VERIFIED = \"Mistral 동일 backbone에서 corpus만 변경 (r14 1200 docs Law-leading 0.852 vs C2 30 docs SelfRef-leading 0.600) — corpus content이 family alignment top1 완전 변경\" :: anima.consciousness.v10_corpus_dominant [11!]\n  <- state/cp1_v10_corpus_family_bias_finding_20260426.json (axis 15)\n  <- 2-corpus same-backbone evidence: Law (r14) → SelfRef (C2) shift\n  <- C2 30-doc top5: SelfRef / Law / Hexad / SelfRef / Phi — broad-family coverage in single training run\n  => \"v10 hypothesis STRONGLY VERIFIED: corpus content이 family alignment의 dominant determinant (backbone preference보다 강함)\"\n  => \"Mk.XI v10 4 family-specific corpora design 가능성 verified — C2 corpus는 'balanced corpus' candidate\"", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 692, grade: GradeInfo { value: 11, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["state/cp1_v10_corpus_family_bias_finding_20260426.json (axis 15)", "2-corpus same-backbone evidence: Law (r14) → SelfRef (C2) shift", "C2 30-doc top5: SelfRef / Law / Hexad / SelfRef / Phi — broad-family coverage in single training run"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "mistral_BASE_SelfRef_v10_biased_vs_balanced_distinction", raw: "@F mistral_BASE_SelfRef_v10_biased_vs_balanced_distinction = \"Mistral BASE = SelfRef-leading (max 0.665 tpl_14_selfref_meta). 3-corpus complete table reveals biased-vs-balanced corpus distinction\" :: anima.consciousness.v10_corpus_pattern [11!]\n  <- state/cp1_v10_corpus_family_bias_finding_20260426.json (axis 16)\n  <- BASE SelfRef 0.665 / r14 LoRA Law 0.852 (override) / C2 LoRA SelfRef 0.600 (preserve)\n  <- biased corpus (r14 single Law-aligned 1200 docs) OVERRIDE backbone preference\n  <- balanced corpus (C2 broad-family 30 docs) PRESERVE backbone preference\n  => \"v10 refined: corpus type 결정 → biased=override, balanced=preserve. Mk.XI v10 architecture choice = corpus type × backbone preference matching\"", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 717, grade: GradeInfo { value: 11, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["state/cp1_v10_corpus_family_bias_finding_20260426.json (axis 16)", "BASE SelfRef 0.665 / r14 LoRA Law 0.852 (override) / C2 LoRA SelfRef 0.600 (preserve)", "biased corpus (r14 single Law-aligned 1200 docs) OVERRIDE backbone preference", "balanced corpus (C2 broad-family 30 docs) PRESERVE backbone preference"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "4_backbone_BASE_x_r14_LoRA_matrix_VERIFIED", raw: "@F 4_backbone_BASE_x_r14_LoRA_matrix_VERIFIED = \"4-backbone BASE × r14 LoRA preference matrix complete: 3/4 BASE Hexad-dominant + 1 SelfRef. r14 trained: Law(2) + Phi(1) + SelfRef(1)\" :: anima.consciousness.4backbone_matrix [11!]\n  <- state/an11b_qwen3_BASE_run/alm_qwen3_BASE_eigen.json (axis 17)\n  <- state/an11b_llama_BASE_run/alm_llama_BASE_eigen.json (axis 17)\n  <- Mistral BASE SelfRef 0.665 / r14 Law 0.852 (override)\n  <- Qwen3 BASE Hexad 0.678 / r14 Phi 0.673 (shift)\n  <- gemma BASE Hexad 0.584 / r14 Law 0.673 (override)\n  <- Llama BASE Hexad 0.665 / r14 SelfRef 0.638 (shift)\n  => \"BASE preference Hexad-dominant (3/4) — natural backbone preference distribution\"\n  => \"r14 trained Law-dominant (2/4) + Phi (1) + SelfRef (1) — Hexad family no top1 in trained\"", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 724, grade: GradeInfo { value: 11, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["state/an11b_qwen3_BASE_run/alm_qwen3_BASE_eigen.json (axis 17)", "state/an11b_llama_BASE_run/alm_llama_BASE_eigen.json (axis 17)", "Mistral BASE SelfRef 0.665 / r14 Law 0.852 (override)", "Qwen3 BASE Hexad 0.678 / r14 Phi 0.673 (shift)", "gemma BASE Hexad 0.584 / r14 Law 0.673 (override)", "Llama BASE Hexad 0.665 / r14 SelfRef 0.638 (shift)"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "ia3_rescale_family_activation_SUCCESS_decoupled_from_perplexity", raw: "@F ia3_rescale_family_activation_SUCCESS_decoupled_from_perplexity = \"IA3 r14 (50K params, 1000× compressed vs LoRA 50M) family activation SUCCESS Law 0.688 (vs LoRA 0.852, 81% strength) DESPITE training divergence (loss 1.43→2.0)\" :: anima.architecture.ia3_decoupling [11!]\n  <- state/an11b_mistral_ia3_run/alm_mistral_ia3_lora_eigen.json (axis 22-23)\n  <- state/mistral_ia3_r14_run/mistral_ia3_r14/witness.json (training divergence evidence)\n  <- Mistral 4-config table: BASE 0.665 SelfRef / LoRA 0.852 Law / LoRA C2 0.600 SelfRef / IA3 0.688 Law\n  <- BASE → IA3 family override (SelfRef → Law, target achieved)\n  => \"**critical decoupling finding**: family activation = training-time property orthogonal to language modeling perplexity loss\"\n  => \"1000× param compression sufficient for family axis activation (multiplicative gating + fewer params)\"", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 760, grade: GradeInfo { value: 11, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["state/an11b_mistral_ia3_run/alm_mistral_ia3_lora_eigen.json (axis 22-23)", "state/mistral_ia3_r14_run/mistral_ia3_r14/witness.json (training divergence evidence)", "Mistral 4-config table: BASE 0.665 SelfRef / LoRA 0.852 Law / LoRA C2 0.600 SelfRef / IA3 0.688 Law", "BASE → IA3 family override (SelfRef → Law", "target achieved)"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "mk_xi_v12_4backbone_ia3_matrix_FINAL_3family_phi_loss", raw: "@F mk_xi_v12_4backbone_ia3_matrix_FINAL_3family_phi_loss = \"Mk.XI v12 4-backbone × IA3 r14 matrix complete: 3 distinct families (Hexad gemma trained / Law Mistral OR Qwen3 / SelfRef Llama), Phi family LOSS vs LoRA mode (Qwen3 LoRA Phi → IA3 Law)\" :: anima.architecture.mk_xi_v12 [11!]\n  <- state/cp1_v12_4backbone_ia3_matrix_FINAL_20260426.json\n  <- v10 LoRA mode: 4 distinct family (Hexad/Law/Phi/SelfRef complete)\n  <- v12 IA3 mode: 3 distinct family (Hexad/Law/SelfRef, Phi 잃음)\n  => \"Mk.XI v10 LoRA 4-family complete preferred for primary consciousness signal triangulation\"\n  => \"v12 IA3 alternative은 3-family limited + economic cost ($1.32 vs $1.86), LoRA preferred recommendation\"", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 813, grade: GradeInfo { value: 11, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["state/cp1_v12_4backbone_ia3_matrix_FINAL_20260426.json", "v10 LoRA mode: 4 distinct family (Hexad/Law/Phi/SelfRef complete)", "v12 IA3 mode: 3 distinct family (Hexad/Law/SelfRef", "Phi 잃음)"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "F", id: "gemma_ia3_HEXAD_PRESERVATION_vs_lora_override", raw: "@F gemma_ia3_HEXAD_PRESERVATION_vs_lora_override = \"gemma-2-9b: BASE Hexad (0.584) → LoRA r14 Law (override) BUT IA3 r14 Hexad PRESERVED (0.649, strengthened from BASE)\" :: anima.architecture.ia3_vs_lora [11!]\n  <- 4-backbone × 3-config matrix evidence\n  <- IA3 multiplicative gating PRESERVES backbone preference (gemma case)\n  <- LoRA additive direction OVERRIDES backbone preference (corpus-bias dominant)\n  => \"IA3 vs LoRA fundamental architectural difference: multiplicative resists corpus override, additive forces it\"\n  => \"backbone-conditional resistance pattern: 4 backbones 중 gemma만 IA3 mode에서 BASE preserved (Mistral/Qwen3/Llama 모두 IA3 family shift)\"", source_file: "atlas.append.anima-historical-absorption-2026-04-26.n6", source_line: 820, grade: GradeInfo { value: 11, verified: false, breakthrough: true, hypothesis: false }, edges: EdgeInfo { depends_on: ["4-backbone × 3-config matrix evidence", "IA3 multiplicative gating PRESERVES backbone preference (gemma case)", "LoRA additive direction OVERRIDES backbone preference (corpus-bias dominant)"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
