    AtlasNode { kind: "R", id: "MULT-04-select-time", raw: "@R MULT-04-select-time = t_select = tau = 4 ms :: n6atlas [10*]\n  \"HEXA-MULT §2 분기 선택 실행 시간 = τ = 4 ms EXACT. 관측자 wave function 이주 지연. T1 EXACT\"\n  <- domains/physics/multiverse-nav/multiverse-nav.md §2", source_file: "atlas.n6", source_line: 51292, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["domains/physics/multiverse-nav/multiverse-nav.md §2"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
