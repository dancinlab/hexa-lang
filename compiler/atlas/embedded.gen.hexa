    AtlasNode { kind: "F", id: "N6HIST-BT546-LEMMA1-CRT", raw: "@F N6HIST-BT546-LEMMA1-CRT = gcd(m,n)=1 -> |Sel_{mn}(E)| = |Sel_m(E)| * |Sel_n(E)| for every E/Q :: number-theory [10*PASS_LITERATURE]\n  => \"Unconditional. Proof: E[mn] = E[m] (+) E[n] (Bezout) ⇒ H¹(G_Q,E[mn]) = H¹(G_Q,E[m]) × H¹(G_Q,E[n]); Kummer-image local compatibility for gcd=1.\"\n  => \"Corollary at n=6: |Sel_6(E)| = |Sel_2(E)| * |Sel_3(E)|, every elliptic curve, model-free.\"\n  => \"Genuine session contribution (BT-546). NOT BSD itself — BSD remains 0/1 untouched.\"\n  -> N6HIST-BT546-A3-CONDITIONAL, N6HIST-BT546-CREMONA-EMP\n  |> reports/breakthroughs/millennium-7-closure-2026-04-11.md §BT-546\n  |> reports/sessions/omega-cycle-bt546-bsd-2026-04-25.md §1.1\n  |> atlas.n6 line 17890 (MILL-PX-A8) — already at [10], REPO_INVARIANT confirmation", source_file: "atlas.n6", source_line: 33631, grade: GradeInfo { value: 10, verified: true, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: [], derives: ["N6HIST-BT546-A3-CONDITIONAL", "N6HIST-BT546-CREMONA-EMP"], applications: [], equivalents: [], converges: [], verified_by: ["reports/breakthroughs/millennium-7-closure-2026-04-11.md §BT-546", "reports/sessions/omega-cycle-bt546-bsd-2026-04-25.md §1.1", "atlas.n6 line 17890 (MILL-PX-A8) — already at [10], REPO_INVARIANT confirmation"], breakthroughs: [] } },
