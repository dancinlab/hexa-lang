    AtlasNode { kind: "C", id: "clay-cascade-s5-AJ-cascade-s5-position", raw: "@C clay-cascade-s5-AJ-cascade-s5-position :: meta [4]\n  <- clay-cascade-s5-tick1-AJ-axis-14-K3-REOPENED-witness\n  => \"cascade-s5 OPENING — axis-14 honest re-resolution\"\n  => \"cascade map this session:\"\n  => \"  s2 axis-13 universality (24 sub-agents, continuum 1D+3D+phi^4)\"\n  => \"  s3 axis-16 mechanism (4 sub-agents, src-cond directed in-deg confirmed)\"\n  => \"  s4 joint signature (1 sub-agent, NEGATIVE non-synergistic)\"\n  => \"  s5 axis-14 IC-conditional denial (this AJ tick-1, K=3 reopened)\"\n  => \"next cascade-s5 candidate (tick-2): structural coupling retest under non-boundary IC\"\n  => \"  if a14 decouples from a13/a16 under non-boundary IC -> axis-14 K=3 promotion confirmed\"\n  => \"  if structural coupling persists -> K=3 denial robust at deeper level\"", source_file: "atlas.n6", source_line: 25688, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s5-tick1-AJ-axis-14-K3-REOPENED-witness"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
    AtlasNode { kind: "C", id: "clay-cascade-s5-AJ-trapped-wavepackets", raw: "@C clay-cascade-s5-AJ-trapped-wavepackets :: meta [4]\n  <- clay-cascade-s5-AJ-3-IC-sweep-table\n  => \"★ honest C3: 4/10 topologies hit p extrema {0, 1} at non-boundary IC:\"\n  => \"  flat / wormhole / calabi6 at i=16 (p=0.9999/0.9999/0.9998) and i=48 (p=0.0003/0.0000/0.0003)\"\n  => \"  these are IC-trapped wavepackets that don't propagate across cut\"\n  => \"  Shannon=0 / Renyi-2≈0 represents NO information transport, NOT discrimination signal proper\"\n  => \"  excluding trapped: i=16 disc drops to ~0.4-0.5 (still well above 0.10 threshold)\"\n  => \"  this is HONEST refinement: discrimination is partly real signal, partly trapped-mass artifact\"\n  => \"for proper K=3 promotion: need topologies that DO transport at non-boundary IC AND show structural decoupling\"", source_file: "atlas.n6", source_line: 25700, grade: GradeInfo { value: 4, verified: false, breakthrough: false, hypothesis: false }, edges: EdgeInfo { depends_on: ["clay-cascade-s5-AJ-3-IC-sweep-table"], derives: [], applications: [], equivalents: [], converges: [], verified_by: [], breakthroughs: [] } },
