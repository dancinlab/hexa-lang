// HEXA Native Compiler — atlas exact-int identity verifier (binary-absorbed)
//
// Lives in compiler/atlas/ (the verification domain, next to embedded.gen.hexa)
// — it CHECKS/folds @F identities. `drill`/`kick` (the candidate generator in
// compiler/drill/) DELEGATES to this verifier; it is not drill's own code.
//
// @version 0.1.0
// @capabilities [pure]
//
// The REAL exact-integer discover→verify→absorb core, absorbed natively into
// the compiler binary (NOT a python script in state/, NOT a flag-gated path).
// This is what `hexa drill`/`kick` verifies WITH by default: a candidate
// arithmetic-function identity A·B = C·D (or, post-upgrade, A·B·C = D·E·F) over
// the basis is confirmed only if exact-integer evaluation over n∈[2,N] yields a
// bounded-unique solution set (singleton, n≥4 — degenerate n=2,3 excluded), or
// (universal frame) holds for every n in [2,N]. This replaces the seed-hash
// heuristic (and the original NEXUS ouroboros verify_score, which was
// n6-proximity numerology that scored every candidate ≥0.3).
//
// Basis — exact-int, reference-matched to the verified ATLAS harvest: idx 0–11
// = the 12-fn core (ATLAS/state/novel-dfs/blue_harvest_12fn.py:12-21, cite
// Hardy&Wright §16.7 / Conway&Sloane); idx 12–17 = the extended vocab
// (vocab_universal_hunt.py:34-66 · see upgrade block below). Per-n trial-
// division factorization (no float path), byte-deterministic across targets.
//
// Honesty (c2): a confirmed identity is BOUNDED-UNIQUE (🟩, exact over [2,N]) —
// the forall-n statement stays UNPROVEN until a proof lands.
//
// ── frontier polarity (2026-06-27 upgrade) ────────────────────────────
// The MEASURED-EXHAUSTED verdict (ATLAS/README.md DFS r1–r4 · Ralph 369–374:
// ≈190 @F folded, novel-fold = 0) is scoped EXACTLY to the **12-fn 2-term
// `A·B=C·D`** vein — that vein is closed at the structural level and this
// engine reproduces that terminal honestly (it never fabricates new laws).
// It is NOT a claim about the whole arithmetic-identity space. This file now
// carries the UPGRADED verifier that explores the un-swept dimensions the
// 12-fn/2-term box could not express:
//   ① extended vocab — 6 new exact-int functions appended at idx 12–17
//      (μ Möbius · λ Liouville · μ² squarefree-indicator · J₃ Jordan k=3 ·
//      2^ω unitary-divisor-count · core=n/rad), signs handled EXACTLY.
//      Reference-matched to ATLAS/state/novel-dfs/vocab_universal_hunt.py:34-66.
//   ② higher arity — 3-term `A·B·C = D·E·F` bounded-unique verify
//      (verify_identity3), reference-matched to grid_expand_sweep.py.
//   ③ universal-in-[2,N] frame — is_universal2 / is_universal3 (forall-n in
//      range), the genuinely productive frame for the sign/indicator vocab
//      (vocab_universal_hunt.py). bounded-unique ⟺ forall is NOT claimed (c2).
//   ④ FUNCTION-COMPOSITION frame (σ∘σ vein · 2026-06-27) — af_compose /
//      comp_holds / comp_count / verify_composition: NESTED composition
//      f(g(n))=af(af(n,g),f), the algebra the PRODUCT frame structurally cannot
//      express (σ(σ(n))=2n has no product restatement). Sanity-gated by
//      rediscovering classical superperfect {2,4,16,64,4096} (Suryanarayana
//      1969 / OEIS A019279) + Mersenne σ∘σ=σ+n {3,7,31,127,8191}. MEASURED novel
//      PROMOTABLE = 0 (DRY) — ATLAS/state/novel-dfs/composition_hunt.py: the vein
//      yields ONLY the classical Mersenne-linked family; bounded-unique
//      singletons are single-point accidents, |sol|≥3 sets are thin restricted-
//      domain coincidences (forall UNPROVEN · c2). Same terminal as the product
//      frame, reached honestly across a genuinely different algebra.
// idx 0–11 are byte-for-byte the prior basis (G1–G3 sanity gates unchanged).

// ── integer power (exact) ──
pub fn ipow(base, e) -> int {
    let r = 1
    let i = 0
    while i < e {
        r = r * base
        i = i + 1
    }
    r
}

// ── smallest prime factor of m (trial division) ──
pub fn spf(m) -> int {
    if m % 2 == 0 { return 2 }
    let p = 3
    while p * p <= m {
        if m % p == 0 { return p }
        p = p + 2
    }
    m
}

// ── extended 18-fn basis, each via exact factorization of n ──
// key ids (idx 0–11 UNCHANGED · 12–17 NEW, 2026-06-27 upgrade):
//   0=sigma 1=sigma2 2=sigma3 3=phi 4=tau 5=n 6=sopfr 7=rad 8=J2 9=psi 10=Om 11=om
//   12=mu(μ Möbius, ±1/0) 13=lam(λ Liouville =(-1)^Ω, ±1) 14=mu2(μ² squarefree
//   indicator, 0/1) 15=J3(Jordan totient k=3) 16=tw_om(2^ω, #unitary divisors)
//   17=core(n/rad, powerful-core complement)
// Signs are exact (μ, λ take negative values); products may be negative — no abs.
// Reference: ATLAS/state/novel-dfs/vocab_universal_hunt.py:34-66 (af generator).
pub fn af(n, which) -> int {
    if n == 1 {
        if which == 6 { return 0 }   // sopfr(1)=0
        if which == 10 { return 0 }  // Omega(1)=0
        if which == 11 { return 0 }  // omega(1)=0
        // μ(1)=1 · λ(1)=1 · μ²(1)=1 · J3(1)=1 · 2^ω(1)=1 · core(1)=1
        return 1                     // every other fn at 1 = 1
    }
    let m = n
    let sig = 1
    let sig2 = 1
    let sig3 = 1
    let tau = 1
    let phi = 1
    let psi = 1
    let j2 = 1
    let j3 = 1
    let sopfr = 0
    let rad = 1
    let om_big = 0
    let om_small = 0
    let squarefree = 1   // μ² indicator: 1 until an exponent ≥2 is seen
    while m > 1 {
        let p = spf(m)
        let e = 0
        while m % p == 0 {
            m = m / p
            e = e + 1
        }
        sig = sig * ((ipow(p, e + 1) - 1) / (p - 1))
        sig2 = sig2 * ((ipow(p, 2 * (e + 1)) - 1) / (ipow(p, 2) - 1))
        sig3 = sig3 * ((ipow(p, 3 * (e + 1)) - 1) / (ipow(p, 3) - 1))
        tau = tau * (e + 1)
        phi = phi * (ipow(p, e - 1) * (p - 1))
        psi = psi * (ipow(p, e - 1) * (p + 1))
        j2 = j2 * (ipow(p, 2 * e) - ipow(p, 2 * (e - 1)))
        j3 = j3 * (ipow(p, 3 * e) - ipow(p, 3 * (e - 1)))
        sopfr = sopfr + p * e
        rad = rad * p
        om_big = om_big + e
        om_small = om_small + 1
        if e >= 2 { squarefree = 0 }
    }
    if which == 0 { return sig }
    if which == 1 { return sig2 }
    if which == 2 { return sig3 }
    if which == 3 { return phi }
    if which == 4 { return tau }
    if which == 5 { return n }
    if which == 6 { return sopfr }
    if which == 7 { return rad }
    if which == 8 { return j2 }
    if which == 9 { return psi }
    if which == 10 { return om_big }
    if which == 11 { return om_small }
    // ── 12–17: extended vocab (signs exact) ──
    if which == 14 { return squarefree }                 // μ²: 0/1 squarefree indicator
    if which == 12 {                                     // μ Möbius: 0 if non-squarefree
        if squarefree == 0 { return 0 }                 //   else (-1)^ω
        if om_small % 2 == 0 { return 1 }
        return 0 - 1
    }
    if which == 13 {                                     // λ Liouville = (-1)^Ω
        if om_big % 2 == 0 { return 1 }
        return 0 - 1
    }
    if which == 15 { return j3 }                          // J3 Jordan totient k=3
    if which == 16 { return ipow(2, om_small) }           // 2^ω = #unitary divisors
    return n / rad                                        // 17=core = n/rad
}

// ── exact-int identity verify: first solution n of af(a)·af(b)==af(c)·af(d)
//    over [2,N], plus a count cap. bounded-unique ⟺ exactly one solution ≥4. ──
// Returns: first solution n (0 if none) when solution count==1 and n>=4,
//          -1 if non-unique (count>1 or universal), -2 if no solution.
pub fn verify_identity(a, b, c, d, N) -> int {
    let first = 0
    let count = 0
    let n = 2
    while n <= N {
        if af(n, a) * af(n, b) == af(n, c) * af(n, d) {
            count = count + 1
            if count == 1 { first = n }
            if count > 1 { return -1 }
        }
        n = n + 1
    }
    if count == 0 { return -2 }
    if first >= 4 { return first }
    return -1
}

// ── arity-3 exact-int identity verify: first solution n of
//    af(a)·af(b)·af(c) == af(d)·af(e)·af(f) over [2,N], plus a count cap.
//    bounded-unique ⟺ exactly one solution ≥4 (degenerate n=2,3 excluded).
//    Reference: ATLAS/state/novel-dfs/grid_expand_sweep.py (3-factor frame).
//    Returns: first solution n (0-guarded: ≥4) when count==1, -1 if non-unique
//    (count>1 or universal-in-range — see is_universal3), -2 if no solution. ──
pub fn verify_identity3(a, b, c, d, e, f, N) -> int {
    let first = 0
    let count = 0
    let n = 2
    while n <= N {
        if af(n, a) * af(n, b) * af(n, c) == af(n, d) * af(n, e) * af(n, f) {
            count = count + 1
            if count == 1 { first = n }
            if count > 1 { return -1 }
        }
        n = n + 1
    }
    if count == 0 { return -2 }
    if first >= 4 { return first }
    return -1
}

// ── universal-in-[2,N] frame (the genuinely productive frame for the
//    sign/indicator vocab μ,λ,μ²): is the 2-term product identity
//    af(a)·af(b) == af(c)·af(d) true for EVERY n in [2,N]? This is EVIDENCE
//    of a forall-n multiplicative relation, NOT a proof (bounded ⟺ forall is
//    UNPROVEN · c2). Returns 1 if universal-in-[2,N], else 0 (first failing n
//    refutes). Reference: vocab_universal_hunt.py::universal. ──
pub fn is_universal2(a, b, c, d, N) -> int {
    let n = 2
    while n <= N {
        if af(n, a) * af(n, b) != af(n, c) * af(n, d) { return 0 }
        n = n + 1
    }
    return 1
}

// ── universal-in-[2,N] for the 3-term frame A·B·C == D·E·F (forall-n in
//    range evidence; bounded ⟺ forall UNPROVEN · c2). 1 if universal, else 0. ──
pub fn is_universal3(a, b, c, d, e, f, N) -> int {
    let n = 2
    while n <= N {
        if af(n, a) * af(n, b) * af(n, c) != af(n, d) * af(n, e) * af(n, f) { return 0 }
        n = n + 1
    }
    return 1
}

// ════════════════════════════════════════════════════════════════════════
// ADDITIVE / COMBINATORIAL frame (ORTHOGONAL pivot · 2026-06-27 · Ralph 377)
// ────────────────────────────────────────────────────────────────────────
// The 18-fn vocab above is MULTIPLICATIVE (built on the factorization n=∏p^e):
// Ralph 369–375 measured it exhausted (independent-novel = 0, all classical/
// reducible to the Mersenne/superperfect core). This block leaves that algebra
// entirely for the NON-multiplicative GENERATING-FUNCTION / RECURRENCE sequences,
// which cannot be expressed through the factorization of n:
//   p(n) partition (A000041 · Euler ∏1/(1−q^k))   C(n) Catalan (A000108)
//   B(n) Bell (A000110)   F(n) Fibonacci (A000045)   L(n) Lucas (A000032)
//   figurate: tri n(n+1)/2 · pent n(3n−1)/2 · sq n²
// Reference engine (re-runnable, exact bignum, OEIS-cited):
//   ATLAS/state/novel-dfs/additive_partition_hunt.py
// The NEW identity FORM here is the arithmetic-progression CONGRUENCE
//   a(α·n+β) ≡ 0 (mod m)   ∀n with α·n+β ≤ N
// (Ramanujan's p(5n+4)≡0 mod5 is the canonical instance — it has NO multiplicative
// analogue, proving this domain is orthogonal). verify_congruence auto-tests a
// progression; the selftest rediscovers Ramanujan's three 1919 congruences as a
// sanity gate. Honesty (c2): a confirmed congruence is BOUNDED to [0,N] — the
// ∀n statement stays UNPROVEN until a proof lands.

// ── exact small-n sequence values (i64-range; overflow guards documented) ──
// p(n) via Euler pentagonal recurrence (exact). i64-safe up to n≈350.
pub fn partition_p(n) -> int {
    let p = []
    p.push(1)                      // p[0] = 1
    let j = 1
    while j <= n {
        let total = 0
        let k = 1
        // g1=k(3k−1)/2 < g2=k(3k+1)/2, so g1>j ⟹ g2>j: loop while g1≤j, guard g2.
        while k * (3 * k - 1) / 2 <= j {
            let g1 = k * (3 * k - 1) / 2
            let g2 = k * (3 * k + 1) / 2
            let sign = 1
            if k % 2 == 0 { sign = 0 - 1 }
            total = total + sign * p[j - g1]
            if g2 <= j { total = total + sign * p[j - g2] }
            k = k + 1
        }
        p.push(total)
        j = j + 1
    }
    p[n]
}

// Catalan C(n)=C(n−1)·2·(2n−1)/(n+1), exact. i64-safe up to n≈35.
pub fn catalan(n) -> int {
    let c = 1
    let i = 1
    while i <= n {
        c = c * 2 * (2 * i - 1) / (i + 1)
        i = i + 1
    }
    c
}

// Bell B(n) via the Bell triangle (exact). i64-safe up to n≈25.
pub fn bell(n) -> int {
    if n == 0 { return 1 }
    let row = []
    row.push(1)
    let r = 1
    while r <= n {
        let nxt = []
        nxt.push(row[len(row) - 1])
        let i = 0
        while i < len(row) {
            nxt.push(nxt[len(nxt) - 1] + row[i])
            i = i + 1
        }
        row = nxt
        r = r + 1
    }
    row[0]
}

// Fibonacci F(0)=0,F(1)=1 (exact). i64-safe up to n≈91.
pub fn fib(n) -> int {
    if n == 0 { return 0 }
    let a = 0
    let b = 1
    let i = 1
    while i < n {
        let t = a + b
        a = b
        b = t
        i = i + 1
    }
    b
}

// Lucas L(0)=2,L(1)=1 (exact). i64-safe up to n≈90.
pub fn lucas(n) -> int {
    if n == 0 { return 2 }
    let a = 2
    let b = 1
    let i = 1
    while i < n {
        let t = a + b
        a = b
        b = t
        i = i + 1
    }
    b
}

// ── figurate numbers (exact) ──
pub fn tri(n) -> int { n * (n + 1) / 2 }
pub fn pent(n) -> int { n * (3 * n - 1) / 2 }
pub fn sq(n) -> int { n * n }

// ── mod-m sequence tables (NO overflow — recurrence run entirely mod m, so the
//    congruence sweep reaches large N exactly without i64 limits) ──
// partition p(n) mod m via the pentagonal recurrence (linear ⇒ mod-closed).
fn _partition_mod_table(N, m) -> array {
    let p = []
    p.push(1 % m)
    let j = 1
    while j <= N {
        let total = 0
        let k = 1
        while k * (3 * k - 1) / 2 <= j {
            let g1 = k * (3 * k - 1) / 2
            let g2 = k * (3 * k + 1) / 2
            let sign = 1
            if k % 2 == 0 { sign = 0 - 1 }
            total = total + sign * p[j - g1]
            if g2 <= j { total = total + sign * p[j - g2] }
            k = k + 1
        }
        total = total % m
        if total < 0 { total = total + m }
        p.push(total)
        j = j + 1
    }
    p
}

// linear two-term recurrence x[n]=x[n−1]+x[n−2] mod m (fib: f0=0,f1=1 · lucas: 2,1).
fn _lin_mod_table(N, m, f0, f1) -> array {
    let x = []
    let a = f0 % m
    if a < 0 { a = a + m }
    let b = f1 % m
    if b < 0 { b = b + m }
    x.push(a)
    if N >= 1 { x.push(b) }
    let j = 2
    while j <= N {
        let t = (x[j - 1] + x[j - 2]) % m
        x.push(t)
        j = j + 1
    }
    x
}

// Bell B(n) mod m via the Bell triangle (additions only ⇒ mod-closed).
fn _bell_mod_table(N, m) -> array {
    let out = []
    out.push(1 % m)
    let row = []
    row.push(1 % m)
    let r = 1
    while r <= N {
        let nxt = []
        nxt.push(row[len(row) - 1])
        let i = 0
        while i < len(row) {
            nxt.push((nxt[len(nxt) - 1] + row[i]) % m)
            i = i + 1
        }
        row = nxt
        out.push(row[0])
        r = r + 1
    }
    out
}

// ── CONGRUENCE verify: does seq(α·n+β) ≡ 0 (mod m) hold for ALL n with
//    α·n+β ≤ N? which: 0=partition 2=bell 3=fib 4=lucas (mod-closed recurrences).
//    Returns 1 if it holds with ≥12 sampled terms (bounded congruence, c2 UNPROVEN
//    ∀n), 0 if a counterexample is found, -2 if too few terms, -3 if unsupported.
//    Reference: additive_partition_hunt.py::class_holds. ──
pub fn verify_congruence(which, a, b, m, N) -> int {
    let tbl = []
    if which == 0 { tbl = _partition_mod_table(N, m) }
    else {
        if which == 2 { tbl = _bell_mod_table(N, m) }
        else {
            if which == 3 { tbl = _lin_mod_table(N, m, 0, 1) }
            else {
                if which == 4 { tbl = _lin_mod_table(N, m, 2, 1) }
                else { return 0 - 3 }
            }
        }
    }
    let count = 0
    let k = 0
    while a * k + b <= N {
        if tbl[a * k + b] != 0 { return 0 }
        count = count + 1
        k = k + 1
    }
    if count < 12 { return 0 - 2 }
    return 1
}

// ── function COMPOSITION frame (σ∘σ vein · exact-int · 2026-06-27) ─────
// The un-swept vein the first-order PRODUCT frame (A·B=C·D, measured-exhausted
// in ATLAS/README.md DFS r1–r4 and re-confirmed for the extended 18-fn vocab in
// #4060) structurally CANNOT express: NESTED composition f(g(n)) = af(af(n,g),f),
// NOT the value-product af(n,f)·af(n,g). Composition is a different algebra —
// the superperfect law σ(σ(n))=2n has NO product-frame restatement.
//   Reference-match (classical = open answer-key): superperfect (Suryanarayana
//   1969 / OEIS A019279) — even n with σ(σ(n))=2n ⟺ n=2^(p−1), 2^p−1 Mersenne
//   prime → {2,4,16,64,4096,…}; and σ(σ(n))=σ(n)+n ⟺ σ(n) prime (Mersenne
//   characterization) → {3,7,31,127,8191,…}.
//   Reference engine: ATLAS/state/novel-dfs/composition_hunt.py (18×18 ordered
//   composition table × comparison frames A/B/C/D, exact-int, deterministic).
//
// Feasibility guard (overflow · matches composition_hunt.py MAXARG): the inner
// image af(n,g) must lie in [1, 2000000]; high-growth σ₂,σ₃,J₂,J₃ compose past
// a tractable i64 range and are skipped honestly.
pub fn af_compose_feasible(n, g) -> int {
    let inner = af(n, g)
    if inner < 1 { return 0 }
    if inner > 2000000 { return 0 }
    return 1
}

// f(g(n)) = af(af(n,g), f). Caller MUST gate on af_compose_feasible(n,g) first
// (an infeasible inner image yields a meaningless/overflowing result).
pub fn af_compose(f, g, n) -> int {
    return af(af(n, g), f)
}

// Does the composition relation hold at a SPECIFIC n? `mode` selects the
// comparison form (reference-match composition_hunt.py frames A/B/C):
//   mode 0: af_compose(f,g,n) == p·n          (k·n form · superperfect f=g=σ p=2)
//   mode 1: af_compose(f,g,n) == af(n,p) + n  (h+n form · Mersenne f=g=σ p=σ idx0)
//   mode 2: af_compose(f,g,n) == af(n,p)      (single-fn form · σ∘φ=n p=n idx5)
// Returns 1 if the relation holds (and is feasible) at n, else 0.
pub fn comp_holds(f, g, mode, p, n) -> int {
    if af_compose_feasible(n, g) == 0 { return 0 }
    let lhs = af_compose(f, g, n)
    let rhs = 0
    if mode == 0 { rhs = p * n }
    if mode == 1 { rhs = af(n, p) + n }
    if mode == 2 { rhs = af(n, p) }
    if lhs == rhs { return 1 }
    return 0
}

// Count solutions n∈[2,N] of the composition relation. Sparse classical
// families (superperfect {2,4,16,64,4096}, Mersenne {3,7,31,127,8191}) have
// count>1 — they are SETS, NOT bounded-unique singletons.
pub fn comp_count(f, g, mode, p, N) -> int {
    let count = 0
    let n = 2
    while n <= N {
        if comp_holds(f, g, mode, p, n) == 1 { count = count + 1 }
        n = n + 1
    }
    return count
}

// Bounded-UNIQUE composition verify (same contract as verify_identity): first
// solution n over [2,N] when the solution set is a SINGLETON with n≥4 (degenerate
// n=2,3 excluded); -1 if non-unique (count>1 — a sparse FAMILY or universal),
// -2 if none. HONESTY (c2): bounded-unique ⟺ forall-n is UNPROVEN. Sparse
// classical families (superperfect) return -1 here (they are SETS) — use
// comp_count for those. Reference: composition_hunt.py STRUCTURED screen.
pub fn verify_composition(f, g, mode, p, N) -> int {
    let first = 0
    let count = 0
    let n = 2
    while n <= N {
        if comp_holds(f, g, mode, p, n) == 1 {
            count = count + 1
            if count == 1 { first = n }
            if count > 1 { return -1 }
        }
        n = n + 1
    }
    if count == 0 { return -2 }
    if first >= 4 { return first }
    return -1
}

// ════════════════════════════════════════════════════════════════════════
// FP fingerprint kernel (OUROBOROS-novel M2 · consolidated from grammar.hexa
// M1). Makes "a primitive the previous cycle could not express" (NEXUS README)
// a DECIDABLE predicate = size-<=k BOUNDED inexpressibility over n in [2,N]:
// a candidate is inside the well at size k iff some enumerated term of size
// <=k has the SAME value-signature (fingerprint). c2: k and N are named, this
// is NOT absolute inexpressibility. Frozen rolling-hash constants (seed
// 1469598103 · base 1000003 · P=2^61-1) — reducing mod P each step keeps the
// BigInt accumulator bounded and makes the whole table byte-deterministic.
// grammar.hexa (BLOWUP frame) is a thin wrapper over these.
// ════════════════════════════════════════════════════════════════════════

fn _ie_P() -> int { return 2305843009213693951 }
fn _ie_B() -> int { return 1000003 }

// non-negative residue of v mod P (af can be negative for mu/lambda).
fn _ie_res(v) -> int {
    let p = _ie_P()
    let r = v % p
    if r < 0 { return r + p }
    return r
}

// value of a size-1 (b<0 -> af(n,a)) or size-2 (af(n,a)*af(n,b)) identity term.
pub fn ie_term_value(a, b, n) -> int {
    let va = af(n, a)
    if b < 0 { return va }
    return va * af(n, b)
}

// fingerprint = rolling hash of the term value vector over n in [2,N].
pub fn ie_term_fingerprint(a, b, N) -> int {
    let p = _ie_P()
    let base = _ie_B()
    let h = 1469598103
    let n = 2
    while n <= N {
        let v = _ie_res(ie_term_value(a, b, n))
        h = ((h * base) + v) % p
        n = n + 1
    }
    return h
}

// fingerprint of a size-3 product af(n,a)*af(n,b)*af(n,c) (same hash).
pub fn ie_term3_fingerprint(a, b, c, N) -> int {
    let p = _ie_P()
    let base = _ie_B()
    let h = 1469598103
    let n = 2
    while n <= N {
        let v = _ie_res(af(n, a) * af(n, b) * af(n, c))
        h = ((h * base) + v) % p
        n = n + 1
    }
    return h
}

// FP_2 table over the 18-fn basis: size-1 (a=0..17) then size-2 (a<=b), in that
// deterministic order. Count = 18 + 18*19/2 = 189.
pub fn ie_fp_table_build(N) -> array {
    let table = []
    let a = 0
    while a < 18 {
        table.push(ie_term_fingerprint(a, 0 - 1, N))
        a = a + 1
    }
    a = 0
    while a < 18 {
        let b = a
        while b < 18 {
            table.push(ie_term_fingerprint(a, b, N))
            b = b + 1
        }
        a = a + 1
    }
    return table
}

// closed-form count the enumerator MUST produce.
pub fn ie_fp_table_count() -> int { return 18 + (18 * 19) / 2 }

// membership: is fingerprint fp in the size-<=2 table? (inside the well at k<=2)
pub fn ie_fp_contains(table, fp) -> bool {
    let m = len(table)
    let i = 0
    while i < m {
        if table[i] == fp { return true }
        i = i + 1
    }
    return false
}

// convenience: is fp inside the well at size <=2 over [2,N]?
pub fn ie_expressible_at(fp, N) -> bool {
    return ie_fp_contains(ie_fp_table_build(N), fp)
}

// ── Erdős–Straus ledger target (bounded-witness · 🟩) ─────────────────────
// 4/n = 1/x + 1/y + 1/z — does a positive-integer solution exist at a single n?
// exact-int only (no float): bounded x-scan + exact divisor test of the residual
// 2-term unit fraction. x range = ceil((n+1)/4)..floor(3n/4) (standard ES bound:
// the largest unit fraction 1/x satisfies 4/(3n) < 1/x <= 4/n). For each x the
// residual num/P = (4x-n)/(n*x) must split as 1/y+1/z, i.e. (num*y-P)(num*z-P)=P^2
// with P=n*x — scan divisors d|P^2 (d<=P), y=(d+P)/num and z=(P^2/d+P)/num must be
// positive integers. i64-SAFE while P^2 ~ 0.56*n^4 < 9.2e18, i.e. n <= ~6.1e4.
// Returns 1 if a witness exists at n, else 0.  @capabilities [pure]
pub fn es_witness_at(n) -> int {
    let xlo = (n + 4) / 4            // == ceil((n+1)/4) for n>=2 (integer)
    let xhi = (3 * n) / 4
    let x = xlo
    while x <= xhi {
        let num = 4 * x - n          // residual numerator: (4x-n)/(n*x)
        if num > 0 {
            let P = n * x
            let PP = P * P
            let d = 1
            while d * d <= PP {
                if PP % d == 0 {
                    if (d + P) % num == 0 {
                        let e = PP / d           // paired divisor
                        if (e + P) % num == 0 {
                            return 1             // witness (x,y,z) exists
                        }
                    }
                }
                d = d + 1
            }
        }
        x = x + 1
    }
    return 0
}

// Erdős–Straus BOUNDED verify over [2,N]. Only primes are scanned — a composite
// n = p*(n/p) inherits a witness from its prime factor p (4/n = 4/(p*(n/p)) scale),
// so the full-range statement is preserved by scanning primes only (spf(n)==n).
// Returns 1 if EVERY n in [2,N] has a witness, else the first counterexample
// encoded as -n. c2-honest: the forall-n>=2 conjecture stays 🟥 UNPROVEN; this is
// only the finite [2,N] bounded-witness atom. i64-safe to N ~ 6.1e4 (see above).
pub fn verify_erdos_straus(N) -> int {
    let n = 2
    while n <= N {
        if spf(n) == n {                 // spf(n)==n <=> n prime  (identity_engine.hexa spf)
            if es_witness_at(n) == 0 { return 0 - n }  // -n encodes first counterexample
        }
        n = n + 1
    }
    return 1
}

// companion diagnostic: first n in [2,N] with NO witness (0 if all pass).
pub fn es_first_counterexample(N) -> int {
    let v = verify_erdos_straus(N)
    if v == 1 { return 0 }
    return 0 - v                          // decode the -n signal
}
