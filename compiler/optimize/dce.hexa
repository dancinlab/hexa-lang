// HEXA Native Compiler — Optimizer / Dead Code Elimination (Phase Opt-1)
//
// @version 0.1.0
// @capabilities [pure]
//
// Per-MFunc simple liveness:
//   * Build the set of Local ids that are READ by any stmt across the
//     whole function (global "used" set — sufficient for SSA where each
//     local is assigned once; safe over-approximation otherwise).
//   * For STMT_ASSIGN / STMT_BINOP / STMT_UNOP / STMT_LOAD whose dst is
//     never read, drop the stmt.
//
// Conservative — we never drop:
//   * STMT_CALL          (potential side effects)
//   * STMT_BR / STMT_BR_COND
//   * STMT_RETURN
//   * STMT_STORE         (memory side effect)
//   * STMT_ARENA_NEW / STMT_ARENA_DROP
//
// Pure: returns a fresh MModule.
//
// RFC-018 §9 (1차 optimization scope): dead code elimination.

import "../ir/mir.hexa"

// ── Live-set (insertion-order list of i64) ───────────────────

fn _dce_contains(xs: [i64], v: i64) -> bool {
    let mut i = 0
    while i < len(xs) {
        if xs[i] == v { return true }
        i = i + 1
    }
    return false
}

fn _dce_add(xs: [i64], v: i64) -> [i64] {
    // #3712 — push without the O(len) dedup scan: `uses` is consumed only as a
    // SET (membership), and _dce_func converts it to an id-indexed boolean
    // array, so duplicate entries are harmless. Dropping the per-add
    // _dce_contains scan turns use-collection from O(uses²) to O(uses) on deep
    // functions (the 7000-stmt runtime_cuda_emit). Byte-eq NEUTRAL — the
    // resulting membership set is identical.
    let mut out = xs
    out.push(v)
    return out
}

// #3712 — largest local id referenced (dst or operand), to size the boolean
// used-set. Bounded single pass.
fn _dce_max_id(f: MFunc) -> i64 {
    let mut m = -1
    let mut bi = 0
    while bi < len(f.blocks) {
        let b = f.blocks[bi]
        let mut si = 0
        while si < len(b.stmts) {
            let s = b.stmts[si]
            if s.dst.id > m { m = s.dst.id }
            let mut ai = 0
            while ai < len(s.args) {
                if s.args[ai].kind == "local" && s.args[ai].local_id > m {
                    m = s.args[ai].local_id
                }
                ai = ai + 1
            }
            si = si + 1
        }
        bi = bi + 1
    }
    return m
}

fn _dce_collect_uses_op(uses: [i64], o: Operand) -> [i64] {
    if o.kind == "local" {
        return _dce_add(uses, o.local_id)
    }
    return uses
}

fn _dce_collect_uses_stmt(uses: [i64], s: Stmt) -> [i64] {
    let mut out = uses
    let mut i = 0
    while i < len(s.args) {
        out = _dce_collect_uses_op(out, s.args[i])
        i = i + 1
    }
    return out
}

fn _dce_collect_uses(f: MFunc) -> [i64] {
    let mut uses: [i64] = []
    let mut bi = 0
    while bi < len(f.blocks) {
        let b = f.blocks[bi]
        let mut si = 0
        while si < len(b.stmts) {
            uses = _dce_collect_uses_stmt(uses, b.stmts[si])
            si = si + 1
        }
        bi = bi + 1
    }
    return uses
}

// ── Stmt classification ──────────────────────────────────────

fn _dce_must_keep(s: Stmt) -> bool {
    if s.kind == STMT_CALL { return true }
    // RFC closure C2 — an indirect call (closure dispatch via hexa_callN)
    // is potentially side-effecting just like a direct STMT_CALL; never
    // dead-strip it even when its result local is unused.
    if s.kind == STMT_CALL_INDIRECT { return true }
    if s.kind == STMT_RETURN { return true }
    if s.kind == STMT_BR { return true }
    if s.kind == STMT_BR_COND { return true }
    if s.kind == STMT_STORE { return true }
    if s.kind == STMT_ARENA_NEW { return true }
    if s.kind == STMT_ARENA_DROP { return true }
    return false
}

fn _dce_has_dst(s: Stmt) -> bool {
    if s.kind == STMT_ASSIGN { return true }
    if s.kind == STMT_BINOP { return true }
    if s.kind == STMT_UNOP { return true }
    if s.kind == STMT_LOAD { return true }
    return false
}

// ── Per-block, per-func ──────────────────────────────────────

fn _dce_filter_block(b: Block, used: [bool]) -> Block {
    let mut out: [Stmt] = []
    let mut i = 0
    while i < len(b.stmts) {
        let s = b.stmts[i]
        let mut keep = true
        if !_dce_must_keep(s) {
            if _dce_has_dst(s) {
                // #3712 — O(1) id-indexed membership (was _dce_contains O(uses)
                // scan per stmt → O(stmts·uses)). Identical decision.
                let did = s.dst.id
                let is_used = did >= 0 && did < len(used) && used[did]
                if did >= 0 && !is_used {
                    keep = false
                }
            }
        }
        if keep { out.push(s) }
        i = i + 1
    }
    return Block { id: b.id, stmts: out, preds: b.preds, succs: b.succs }
}

fn _dce_func(f: MFunc) -> MFunc {
    let uses = _dce_collect_uses(f)
    // #3712 — fold the use-list into an id-indexed boolean set ONCE, so the
    // per-stmt membership test in _dce_filter_block is O(1) (kills the
    // O(stmts·uses) contains-scan). Byte-eq NEUTRAL — same membership.
    let maxid = _dce_max_id(f)
    let mut used: [bool] = []
    let mut zi = 0
    while zi <= maxid { used.push(false); zi = zi + 1 }
    let mut ui = 0
    while ui < len(uses) {
        let uid = uses[ui]
        if uid >= 0 && uid <= maxid { used[uid] = true }
        ui = ui + 1
    }
    let mut blocks: [Block] = []
    let mut i = 0
    while i < len(f.blocks) {
        blocks.push(_dce_filter_block(f.blocks[i], used))
        i = i + 1
    }
    return MFunc {
        name: f.name,
        params: f.params,
        return_local: f.return_local,
        locals: f.locals,
        blocks: blocks,
        entry_block: f.entry_block,
        arena_root: f.arena_root,
        def_line: f.def_line,
        gpu_kind: GPU_KIND_CPU,
        is_naked: false
    }
}

// ── Public ───────────────────────────────────────────────────

pub fn dce(module: MModule) -> MModule {
    let mut funcs: [MFunc] = []
    let mut i = 0
    while i < len(module.funcs) {
        funcs.push(_dce_func(module.funcs[i]))
        i = i + 1
    }
    return MModule { file: module.file, funcs: funcs, globals: module.globals }
}
