// HEXA Native Compiler — generic-STRUCT monomorphization pass unit test
//
// @version 0.1.0
// @capabilities [pure]
//
// Lane ① companion to compiler/optimize/monomorphize_test.hexa (the
// function lane). Exercises the struct-template path added to
// compiler/optimize/monomorphize.hexa on a hand-built MModule.
//
// Models the minimal end-to-end slice from
// state/rfc_generic_struct_monomorphization.md:
//
//   @specialize struct Box<T> { v: T }              // template → name "Box$$gs"
//   fn caller() { Box(5); Box("hi") }               // 2 construction CALLs:
//                                                    //   Box<Int>(5) → STMT_CALL op="Box", arg const_int
//                                                    //   Box<Str>("hi") → STMT_CALL op="Box", arg const_str
//
// After monomorphize():
//   * two specialized struct instances exist: Box$int, Box$str
//   * caller's two construction STMT_CALLs are retargeted "Box" → Box$int / Box$str
//   * the template is RENAMED to its base name `Box` (erased constructor
//     fallback for `dyn`/unresolved construction); "$$gs" never leaks
//   * a non-generic control module is byte-shape preserved (no $$gs mark)
//   * a MIXED module (function `$$g` + struct `$$gs` template) specializes
//     BOTH in one pass — proving the two marker spaces coexist (the hexa
//     unified-pass beyond-parity lever vs rustc's separate collector arms).
//
// Run:
//   hexa run compiler/optimize/monomorphize_struct_test.hexa

import "../ir/mir.hexa"
import "./monomorphize.hexa"

// ── MIR construction helpers (mirror monomorphize_test.hexa) ─────

fn _local(id: i64, name: string) -> Local {
    return Local { id: id, arena_id: 1, type_id: 1, name_hint: name, precision: "", space: "" }
}

fn _miss_local() -> Local {
    return Local { id: -1, arena_id: 0, type_id: 0, name_hint: "", precision: "", space: "" }
}

fn _op_local(local_id: i64) -> Operand {
    return Operand { kind: "local", local_id: local_id, int_val: 0, float_val: 0.0, str_val: "", global_id: -1 }
}

fn _op_int(v: i64) -> Operand {
    return Operand { kind: "const_int", local_id: -1, int_val: v, float_val: 0.0, str_val: "", global_id: -1 }
}

fn _op_str(v: string) -> Operand {
    return Operand { kind: "const_str", local_id: -1, int_val: 0, float_val: 0.0, str_val: v, global_id: -1 }
}

fn _stmt_return(src: Operand) -> Stmt {
    let mut xs: [Operand] = []
    xs.push(src)
    return Stmt { kind: STMT_RETURN, dst: _miss_local(), op: "", args: xs, target_block: -1, target_block_else: -1 }
}

fn _stmt_call(dst: Local, callee: string, args: [Operand]) -> Stmt {
    return Stmt { kind: STMT_CALL, dst: dst, op: callee, args: args, target_block: -1, target_block_else: -1 }
}

fn _block(id: i64, stmts: [Stmt]) -> Block {
    return Block { id: id, stmts: stmts, preds: [], succs: [] }
}

fn _mfunc(name: string, params: [Local], locals: [Local], blocks: [Block]) -> MFunc {
    return MFunc {
        name: name, params: params, return_local: _miss_local(),
        locals: locals, blocks: blocks, entry_block: 0, arena_root: 1,
        def_line: 0, gpu_kind: GPU_KIND_CPU
    }
}

// ── Inspection helpers ───────────────────────────────────────

fn _find_func(m: MModule, name: string) -> i64 {
    let mut i = 0
    while i < len(m.funcs) {
        if m.funcs[i].name == name { return i }
        i = i + 1
    }
    return -1
}

fn _call_op_at(mf: MFunc, idx: i64) -> string {
    let mut n = 0
    let mut bi = 0
    while bi < len(mf.blocks) {
        let b = mf.blocks[bi]
        let mut si = 0
        while si < len(b.stmts) {
            if b.stmts[si].kind == STMT_CALL {
                if n == idx { return b.stmts[si].op }
                n = n + 1
            }
            si = si + 1
        }
        bi = bi + 1
    }
    return "<none>"
}

// ── Build the generic-struct-template fixture ────────────────

fn _build_struct_module() -> MModule {
    // struct constructor template: fn Box$$gs(v) { return v }
    // (the pass is body-agnostic — it clones the template verbatim; the
    //  body here stands in for the synthesised one-field constructor a
    //  generic struct would lower to under the R2 wiring described in the
    //  RFC. What matters for the pass is the "$$gs" name + the per-call-site
    //  argument type.)
    let p0 = _local(0, "v")
    let mut tpl_params: [Local] = []
    tpl_params.push(p0)
    let mut tpl_stmts: [Stmt] = []
    tpl_stmts.push(_stmt_return(_op_local(p0.id)))
    let mut tpl_blocks: [Block] = []
    tpl_blocks.push(_block(0, tpl_stmts))
    let tpl = _mfunc("Box" + MONO_STRUCT_TEMPLATE_MARK, tpl_params, tpl_params, tpl_blocks)

    // caller: Box(5); Box("hi")   — construction-as-call form
    let r0 = _local(1, "r0")
    let r1 = _local(2, "r1")
    let mut a_int: [Operand] = []
    a_int.push(_op_int(5))
    let mut a_str: [Operand] = []
    a_str.push(_op_str("hi"))
    let mut c_stmts: [Stmt] = []
    c_stmts.push(_stmt_call(r0, "Box", a_int))
    c_stmts.push(_stmt_call(r1, "Box", a_str))
    c_stmts.push(_stmt_return(_op_local(r0.id)))
    let mut c_blocks: [Block] = []
    c_blocks.push(_block(0, c_stmts))
    let mut c_locals: [Local] = []
    c_locals.push(r0)
    c_locals.push(r1)
    let caller = _mfunc("caller", [], c_locals, c_blocks)

    let mut funcs: [MFunc] = []
    funcs.push(tpl)
    funcs.push(caller)
    return MModule { file: "mono_struct_test.hexa", funcs: funcs, globals: [] }
}

fn _build_control_module() -> MModule {
    // non-generic: fn plain() { return 0 } — no $$gs mark anywhere
    let mut stmts: [Stmt] = []
    stmts.push(_stmt_return(_op_int(0)))
    let mut blocks: [Block] = []
    blocks.push(_block(0, stmts))
    let plain = _mfunc("plain", [], [], blocks)
    let mut funcs: [MFunc] = []
    funcs.push(plain)
    return MModule { file: "ctrl.hexa", funcs: funcs, globals: [] }
}

fn _build_mixed_module() -> MModule {
    // function template id$$g(x){return x}  +  struct template Box$$gs(v){return v}
    // caller: id(7); Box("z")
    let fp = _local(0, "x")
    let mut f_params: [Local] = []
    f_params.push(fp)
    let mut f_stmts: [Stmt] = []
    f_stmts.push(_stmt_return(_op_local(fp.id)))
    let mut f_blocks: [Block] = []
    f_blocks.push(_block(0, f_stmts))
    let id_tpl = _mfunc("id" + MONO_TEMPLATE_MARK, f_params, f_params, f_blocks)

    let sp = _local(0, "v")
    let mut s_params: [Local] = []
    s_params.push(sp)
    let mut s_stmts: [Stmt] = []
    s_stmts.push(_stmt_return(_op_local(sp.id)))
    let mut s_blocks: [Block] = []
    s_blocks.push(_block(0, s_stmts))
    let box_tpl = _mfunc("Box" + MONO_STRUCT_TEMPLATE_MARK, s_params, s_params, s_blocks)

    let r0 = _local(1, "r0")
    let r1 = _local(2, "r1")
    let mut a_int: [Operand] = []
    a_int.push(_op_int(7))
    let mut a_str: [Operand] = []
    a_str.push(_op_str("z"))
    let mut c_stmts: [Stmt] = []
    c_stmts.push(_stmt_call(r0, "id", a_int))
    c_stmts.push(_stmt_call(r1, "Box", a_str))
    c_stmts.push(_stmt_return(_op_local(r0.id)))
    let mut c_blocks: [Block] = []
    c_blocks.push(_block(0, c_stmts))
    let mut c_locals: [Local] = []
    c_locals.push(r0)
    c_locals.push(r1)
    let caller = _mfunc("caller", [], c_locals, c_blocks)

    let mut funcs: [MFunc] = []
    funcs.push(id_tpl)
    funcs.push(box_tpl)
    funcs.push(caller)
    return MModule { file: "mixed.hexa", funcs: funcs, globals: [] }
}

fn _build_nested_module() -> MModule {
    // Lane ② — NESTED generic struct: Box(Pair(5,6)).
    //
    //   @specialize struct Pair<A,B> { a: A, b: B }   // template "Pair$$gs"
    //   @specialize struct Box<T>    { v: T }         // template "Box$$gs"
    //   fn caller() { Box(Pair(5,6)) }
    //
    // lowers to two STMT_CALLs in SSA order:
    //   r0 = Pair(5, 6)     // const_int arg[0] → Pair$int
    //   r1 = Box(r0)        // local arg[0] → producer map → tag "Pair$int"
    //                       //              → Box$Pair$int
    // Body-agnostic, like the other fixtures (the pass clones templates
    // verbatim + mangles names; struct LAYOUT specialization is the R2a/R2b
    // wall documented in the RFC).
    let pa = _local(0, "a")
    let pb = _local(1, "b")
    let mut pair_params: [Local] = []
    pair_params.push(pa)
    pair_params.push(pb)
    let mut pair_stmts: [Stmt] = []
    pair_stmts.push(_stmt_return(_op_local(pa.id)))
    let mut pair_blocks: [Block] = []
    pair_blocks.push(_block(0, pair_stmts))
    let pair_tpl = _mfunc("Pair" + MONO_STRUCT_TEMPLATE_MARK, pair_params, pair_params, pair_blocks)

    let bv = _local(0, "v")
    let mut box_params: [Local] = []
    box_params.push(bv)
    let mut box_stmts: [Stmt] = []
    box_stmts.push(_stmt_return(_op_local(bv.id)))
    let mut box_blocks: [Block] = []
    box_blocks.push(_block(0, box_stmts))
    let box_tpl = _mfunc("Box" + MONO_STRUCT_TEMPLATE_MARK, box_params, box_params, box_blocks)

    // caller: r0 = Pair(5,6); r1 = Box(r0); return r0
    let r0 = _local(1, "r0")
    let r1 = _local(2, "r1")
    let mut a_pair: [Operand] = []
    a_pair.push(_op_int(5))
    a_pair.push(_op_int(6))
    let mut a_box: [Operand] = []
    a_box.push(_op_local(r0.id))
    let mut c_stmts: [Stmt] = []
    c_stmts.push(_stmt_call(r0, "Pair", a_pair))   // inner construction first (SSA order)
    c_stmts.push(_stmt_call(r1, "Box", a_box))     // outer references r0
    c_stmts.push(_stmt_return(_op_local(r0.id)))
    let mut c_blocks: [Block] = []
    c_blocks.push(_block(0, c_stmts))
    let mut c_locals: [Local] = []
    c_locals.push(r0)
    c_locals.push(r1)
    let caller = _mfunc("caller", [], c_locals, c_blocks)

    let mut funcs: [MFunc] = []
    funcs.push(pair_tpl)
    funcs.push(box_tpl)
    funcs.push(caller)
    return MModule { file: "nested.hexa", funcs: funcs, globals: [] }
}

// ── Driver ───────────────────────────────────────────────────

let mut _pass = 0
let mut _fail = 0

fn _check(label: string, cond: bool) {
    if cond {
        _pass = _pass + 1
        println("  PASS  " + label)
    } else {
        _fail = _fail + 1
        println("  FAIL  " + label)
    }
}

fn main() {
    println("=== monomorphize struct-lane pass test ===")

    // (1) generic-struct module → instances emitted + construction rewritten
    let sm = _build_struct_module()
    let out = monomorphize(sm)

    _check("Box$int struct instance emitted", _find_func(out, "Box$int") >= 0)
    _check("Box$str struct instance emitted", _find_func(out, "Box$str") >= 0)
    _check("erased constructor fallback Box retained", _find_func(out, "Box") >= 0)
    _check("no $$gs symbol leaks to output", _find_func(out, "Box" + MONO_STRUCT_TEMPLATE_MARK) < 0)

    let ci = _find_func(out, "caller")
    _check("caller present", ci >= 0)
    if ci >= 0 {
        let caller = out.funcs[ci]
        _check("construction 0 retargeted to Box$int", _call_op_at(caller, 0) == "Box$int")
        _check("construction 1 retargeted to Box$str", _call_op_at(caller, 1) == "Box$str")
    }

    // (2) control module (no $$gs) → byte-shape preserved
    let cm = _build_control_module()
    let cout = monomorphize(cm)
    _check("control func count unchanged", len(cout.funcs) == len(cm.funcs))
    _check("control func name unchanged", _find_func(cout, "plain") >= 0)

    // (3) mixed fn + struct templates specialize together in one pass
    let mm = _build_mixed_module()
    let mout = monomorphize(mm)
    _check("mixed: fn instance id$int emitted", _find_func(mout, "id$int") >= 0)
    _check("mixed: struct instance Box$str emitted", _find_func(mout, "Box$str") >= 0)
    _check("mixed: fn fallback id retained", _find_func(mout, "id") >= 0)
    _check("mixed: struct fallback Box retained", _find_func(mout, "Box") >= 0)
    let mci = _find_func(mout, "caller")
    if mci >= 0 {
        let mcaller = mout.funcs[mci]
        _check("mixed: fn call retargeted id$int", _call_op_at(mcaller, 0) == "id$int")
        _check("mixed: struct call retargeted Box$str", _call_op_at(mcaller, 1) == "Box$str")
    }

    // (4) NESTED module with the lane-② sub-gate UNSET → byteeq-neutral
    //     layering: the inner Pair construction still specializes (its arg is
    //     a const), but the OUTER Box(local) call stays on the erased path
    //     (`Box`, NOT `Box$Pair$int`) exactly as the #4058 single-level pass
    //     behaved — proving lane ② is inert by default.
    setenv("HEXA_MONO_GENERIC_STRUCT", "0")
    let nm0 = _build_nested_module()
    let nout0 = monomorphize(nm0)
    _check("nested OFF: inner Pair$int still emitted", _find_func(nout0, "Pair$int") >= 0)
    _check("nested OFF: NO Box$Pair$int (erased outer)", _find_func(nout0, "Box$Pair$int") < 0)
    let nci0 = _find_func(nout0, "caller")
    if nci0 >= 0 {
        let nc0 = nout0.funcs[nci0]
        _check("nested OFF: inner call → Pair$int", _call_op_at(nc0, 0) == "Pair$int")
        _check("nested OFF: outer call stays erased Box", _call_op_at(nc0, 1) == "Box")
    }

    // (5) NESTED module with the lane-② sub-gate SET → the outer construction
    //     is retargeted Box → Box$Pair$int via the producer map, and both the
    //     inner and the nested instance are emitted. No $$gs leak.
    setenv("HEXA_MONO_GENERIC_STRUCT", "1")
    let nm = _build_nested_module()
    let nout = monomorphize(nm)
    _check("nested ON: Pair$int instance emitted", _find_func(nout, "Pair$int") >= 0)
    _check("nested ON: Box$Pair$int instance emitted", _find_func(nout, "Box$Pair$int") >= 0)
    _check("nested ON: Pair fallback retained", _find_func(nout, "Pair") >= 0)
    _check("nested ON: Box fallback retained", _find_func(nout, "Box") >= 0)
    _check("nested ON: no Pair$$gs leak", _find_func(nout, "Pair" + MONO_STRUCT_TEMPLATE_MARK) < 0)
    _check("nested ON: no Box$$gs leak", _find_func(nout, "Box" + MONO_STRUCT_TEMPLATE_MARK) < 0)
    let nci = _find_func(nout, "caller")
    if nci >= 0 {
        let nc = nout.funcs[nci]
        _check("nested ON: inner call → Pair$int", _call_op_at(nc, 0) == "Pair$int")
        _check("nested ON: outer call → Box$Pair$int", _call_op_at(nc, 1) == "Box$Pair$int")
    }
    // restore default so the flag never leaks past this test process
    setenv("HEXA_MONO_GENERIC_STRUCT", "0")

    println("--- " + to_string(_pass) + " passed, " + to_string(_fail) + " failed ---")
    if _fail > 0 { exit(1) }
}
