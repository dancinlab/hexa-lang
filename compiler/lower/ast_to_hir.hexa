// ── Inline scope walker ──────────────────────────────────────
// Self-contained DefId resolution table — flat name→DefId pairs with
// frame boundaries tracked by `frame_starts`. We build it as we walk.

pub struct LowerBinding {
    name: string,
    def: DefId,
    typ: Type
}

pub struct LowerScope {
    bindings: [LowerBinding],
    frame_starts: [i64],   // index into bindings[] where each frame begins
    next_index: i64,
    mod_file: string
}

fn _new_scope(mod_file: string) -> LowerScope {
    return LowerScope {
        bindings: [],
        frame_starts: [],
        next_index: 0,
        mod_file: mod_file
    }
}

fn _push_frame(sc: LowerScope) -> LowerScope {
    let mut starts = sc.frame_starts
    starts.push(len(sc.bindings))
    return LowerScope {
        bindings: sc.bindings,
        frame_starts: starts,
        next_index: sc.next_index,
        mod_file: sc.mod_file
    }
}

fn _pop_frame(sc: LowerScope) -> LowerScope {
    let n = len(sc.frame_starts)
    if n == 0 { return sc }
    let start = sc.frame_starts[n - 1]
    let mut new_bindings = []
    let mut i = 0
    while i < start {
        new_bindings.push(sc.bindings[i])
        i = i + 1
    }
    let mut new_starts = []
    let mut j = 0
    while j < n - 1 {
        new_starts.push(sc.frame_starts[j])
        j = j + 1
    }
    return LowerScope {
        bindings: new_bindings,
        frame_starts: new_starts,
        next_index: sc.next_index,
        mod_file: sc.mod_file
    }
}

fn _define_in_scope(sc: LowerScope, name: string, typ: Type) -> LowerScope {
    let def = DefId { module: sc.mod_file, index: sc.next_index }
    let mut bindings = sc.bindings
    bindings.push(LowerBinding { name: name, def: def, typ: typ })
    return LowerScope {
        bindings: bindings,
        frame_starts: sc.frame_starts,
        next_index: sc.next_index + 1,
        mod_file: sc.mod_file
    }
}

fn _define_with_def(sc: LowerScope, name: string, def: DefId, typ: Type) -> LowerScope {
    // For pre-pass module items where DefId is already minted.
    let mut bindings = sc.bindings
    bindings.push(LowerBinding { name: name, def: def, typ: typ })
    let mut next_idx = sc.next_index
    if def.index >= next_idx { next_idx = def.index + 1 }
    return LowerScope {
        bindings: bindings,
        frame_starts: sc.frame_starts,
        next_index: next_idx,
        mod_file: sc.mod_file
    }
}

// PERF (self-emit lower_ast_to_hir O(idents*M) kill — census measured this
// phase at 430s on a 67920-line self-compile, ENCODE-MISS=0). The module frame
// (all top-level fn/struct/enum/let, ~2.5-5k defs) sits at the BASE of the
// value-threaded LowerScope.bindings, so `_lookup_in_scope` backward-scanned
// all M module entries for every non-local identifier -> O(idents*M). A once-
// primed 64-bucket FNV index over the module frame turns the module portion
// into an O(bucket) probe, IDENTICAL to the #4773 `_mir_lookup_global` /
// `_x86_strtab` (x86_64_linux.hexa:1448) idiom. Buckets hold bindings in
// ASCENDING module-index order (pre-pass insertion order), so a BACKWARD bucket
// walk returns the highest-index match == the full backward scan's first module
// hit -> byte-eq NEUTRAL. Heap-resident module globals (reset + re-primed per
// lower() call; a nested arena helper would dangle on frame rewind).
let mut _lr_ast_gnames: [[string]] = []
let mut _lr_ast_gbinds: [[LowerBinding]] = []
let mut _lr_ast_gbound: i64 = -1

// FNV-1a 32-bit fold -> 64 buckets — clone of _x86_strtab_hash (`% 4294967296`
// keeps the i64 multiply overflow-free). Index-only, so byte-eq NEUTRAL.
fn _lr_ast_gname_hash(s: string) -> i64 {
    let mut h: i64 = 2166136261
    let mut i = 0
    let n = len(s)
    while i < n {
        h = (h ^ s.char_code_at(i)) * 16777619
        h = h % 4294967296
        i = i + 1
    }
    let mut b = h % 64
    if b < 0 { b = b + 64 }
    return b
}

// Prime the module-frame bucket index ONCE, right after the pre-pass publishes
// the module scope. `sc.bindings` at this point is exactly the module frame.
fn _lr_ast_prime_globals(sc: LowerScope) {
    _lr_ast_gbound = len(sc.bindings)
    let mut gn: [[string]] = []
    let mut gb: [[LowerBinding]] = []
    let mut e = 0
    while e < 64 {
        let en: [string] = []
        let eb: [LowerBinding] = []
        gn.push(en)
        gb.push(eb)
        e = e + 1
    }
    let mut i = 0
    while i < _lr_ast_gbound {
        let bd = sc.bindings[i]
        let h = _lr_ast_gname_hash(bd.name)
        gn[h] = gn[h].push(bd.name)
        gb[h] = gb[h].push(bd)
        i = i + 1
    }
    _lr_ast_gnames = gn
    _lr_ast_gbinds = gb
}

fn _lookup_in_scope(sc: LowerScope, name: string) -> LowerBinding {
    let n = len(sc.bindings)
    // Primed fast path: scan only the LOCAL suffix (indices _lr_ast_gbound..n)
    // backward, then probe the 64-bucket module index. Equivalent to the full
    // backward scan (locals shadow globals; the bucket's backward walk yields
    // the highest module index for the name). byte-eq NEUTRAL.
    if _lr_ast_gbound >= 0 && n >= _lr_ast_gbound && len(_lr_ast_gnames) == 64 {
        let mut i = n - 1
        while i >= _lr_ast_gbound {
            let b = sc.bindings[i]
            if b.name == name {
                return b
            }
            i = i - 1
        }
        let h = _lr_ast_gname_hash(name)
        let bnames = _lr_ast_gnames[h]
        let bbinds = _lr_ast_gbinds[h]
        let mut j = len(bnames) - 1
        while j >= 0 {
            if bnames[j] == name {
                return bbinds[j]
            }
            j = j - 1
        }
        return LowerBinding {
            name: "",
            def: _hir_miss_def_id(),
            typ: _hir_empty_type()
        }
    }
    // Fallback: full backward scan (index not primed — e.g. during the pre-pass).
    let mut i = n - 1
    while i >= 0 {
        let b = sc.bindings[i]
        if b.name == name {
            return b
        }
        i = i - 1
    }
    return LowerBinding {
        name: "",
        def: _hir_miss_def_id(),
        typ: _hir_empty_type()
    }
}

// HX1100 closure-capture warning emitter (Stage1 Gap 14.1 follow-up).
// Inactive today because compiler/parse/parser.hexa does not yet emit
// a fn-literal / closure ExprKind. Wired here so the catalog entry has
// a canonical call site once closure-conversion lands. `site` is the
// enclosing function name; `name` is the captured outer variable.
pub fn emit_hx1100_closure_capture(sp: Span, site: string, name: string) {
    let mut b = diag_new("HX1100")
    b = diag_span(b, sp)
    b = diag_arg(b, "site", site)
    b = diag_arg(b, "name", name)
    l_diags.push(diag_emit(b))
}

// Split an "Enum::Variant" path into its halves. Returns ["Enum","Variant"].
// On miss returns [text, ""] so the caller can detect malformed paths.
fn _split_enum_path(text: string) -> [string] {
    let cs = text.chars()
    let n = len(cs)
    let mut i = 0
    while i + 1 < n {
        if cs[i] == ':' && cs[i + 1] == ':' {
            let mut left = ""
            let mut j = 0
            while j < i {
                left = left + to_string(cs[j])
                j = j + 1
            }
            let mut right = ""
            j = i + 2
            while j < n {
                right = right + to_string(cs[j])
                j = j + 1
            }
            return [left, right]
        }
        i = i + 1
    }
    return [text, ""]
}

fn _enum_named_type(enum_name: string) -> Type {
    if len(enum_name) == 0 { return _hir_empty_type() }
    return Type {
        kind: "enum:" + enum_name,
        def: _hir_miss_def_id(),
        args: [],
        ret: [],
        domain: "",
        unit: ""
    }
}

fn _struct_named_type(struct_name: string) -> Type {
    if len(struct_name) == 0 { return _hir_empty_type() }
    return Type {
        kind: "struct:" + struct_name,
        def: _hir_miss_def_id(),
        args: [],
        ret: [],
        domain: "",
        unit: ""
    }
}

// `let` text decoder (mirrors bind.hexa _let_name) — strips "mut:" prefix.
//
// RFC 085 Step B (2026-05-27): also strips the optional `|<type-name>`
// suffix added by parse_let_expr for `let sm: T` syntax. The type text
// (e.g. "Array:256" for `[f64; 256]`) is accessible via the sibling
// `_hir_let_type_text` helper. Bare let without `: T` keeps the legacy
// shape, so this remains backward-compatible with all existing callers.
fn _hir_let_name(t: string) -> string {
    let chars = t.chars()
    let n = len(chars)
    let mut start = 0
    if n >= 4 && chars[0] == 'm' && chars[1] == 'u' && chars[2] == 't' && chars[3] == ':' {
        start = 4
    }
    let mut out = ""
    let mut i = start
    while i < n {
        if chars[i] == '|' { break }
        out = out + to_string(chars[i])
        i = i + 1
    }
    return out
}

// RFC 085 Step B — let type-annotation text extractor. Returns the
// substring after `|` in the let-expr text (the TypeRef name like
// "Array:256" for `let sm: [f64; 256]`), or "" when no `|` separator
// is present (bare `let x = ...`). Consumed by `hir_to_mir.hexa`'s
// @shared lowering to thread the count through to MIR Local.name_hint.
fn _hir_let_type_text(t: string) -> string {
    let chars = t.chars()
    let n = len(chars)
    let mut i = 0
    while i < n {
        if chars[i] == '|' {
            let mut out = ""
            let mut j = i + 1
            while j < n {
                out = out + to_string(chars[j])
                j = j + 1
            }
            return out
        }
        i = i + 1
    }
    return ""
}

// ── Atlas binding resolver ───────────────────────────────────

fn _resolve_atlas(aref: AtlasRef, atlas: AtlasIndex) -> AtlasBinding {
    if len(aref.kind) == 0 {
        return _empty_atlas_binding()
    }
    let arr = _array_for_kind_a2h(atlas, aref.kind)
    let mut idx = -1
    let mut i = 0
    while i < len(arr) {
        let n = arr[i]
        if n.id == aref.id {
            idx = i
            break
        }
        i = i + 1
    }
    return AtlasBinding {
        ref_kind: aref.kind,
        id: aref.id,
        atlas_index: idx,
        atlas_hash: atlas.hash
    }
}

fn _array_for_kind_a2h(atlas: AtlasIndex, kind: string) -> array {
    if kind == "P" { return atlas.p_nodes }
    if kind == "C" { return atlas.c_nodes }
    if kind == "L" { return atlas.l_nodes }
    if kind == "E" { return atlas.e_nodes }
    return []
}

fn _atlas_kind_type(rk: string) -> Type {
    if len(rk) == 0 { return _hir_empty_type() }
    return Type {
        kind: "atlas_" + rk,
        def: _hir_miss_def_id(),
        args: [],
        ret: [],
        domain: "",
        unit: ""
    }
}

// ── Numeric promotion helper for binops (same-kind passthrough) ──

fn _hir_is_numeric(t: Type) -> bool {
    if t.kind == "i8"  { return true }
    if t.kind == "i16" { return true }
    if t.kind == "i32" { return true }
    if t.kind == "i64" { return true }
    if t.kind == "f32" { return true }
    if t.kind == "f64" { return true }
    return false
}

fn _hir_is_compare_op(op: string) -> bool {
    if op == "==" { return true }
    if op == "!=" { return true }
    if op == "<"  { return true }
    if op == "<=" { return true }
    if op == ">"  { return true }
    if op == ">=" { return true }
    return false
}

// ── Expr lowering core ───────────────────────────────────────
//
// Returns (HExpr, updated scope). Stage0 has no by-ref structs, so we
// thread scope through. Pure tree shape — every AST Expr → one HExpr.

pub struct LowerResult {
    expr: HExpr,
    sc: LowerScope
}

fn _mk_hexpr(kind: string, sp: Span, typ: Type, text: string,
             children: [HExpr], atlas: AtlasBinding, def: DefId) -> HExpr {
    return HExpr {
        kind: kind,
        span: sp,
        typ: typ,
        text: text,
        children: children,
        atlas: atlas,
        def: def,
        annotations: []
    }
}

// PR-C piece 3 — Let-position variant that preserves AST annotations
// (e.g. `@shared`) on the HExpr. Other call sites continue to use the
// `_mk_hexpr` default-empty form, so the ripple is contained to the
// single `_is_let_expr_kind` lowering arm.
fn _mk_hexpr_anns(kind: string, sp: Span, typ: Type, text: string,
                  children: [HExpr], atlas: AtlasBinding, def: DefId,
                  anns: [Annotation]) -> HExpr {
    return HExpr {
        kind: kind,
        span: sp,
        typ: typ,
        text: text,
        children: children,
        atlas: atlas,
        def: def,
        annotations: anns
    }
}

// ── C19: for-loop AST desugar helpers ────────────────────────
// Build synthetic AST Expr nodes; existing `_lower_expr` cases then
// handle scope plumbing, def-ids, and type fall-throughs uniformly.

fn _empty_atlas_ref(sp: Span) -> AtlasRef {
    return AtlasRef { kind: "", id: "", span: sp }
}

fn _mk_ast_ident(name: string, sp: Span) -> Expr {
    return Expr {
        kind: ExprKind::Ident,
        span: sp,
        text: name,
        annotations: [],
        children: [],
        atlas_ref: _empty_atlas_ref(sp)
    }
}

fn _mk_ast_lit_int(text: string, sp: Span) -> Expr {
    return Expr {
        kind: ExprKind::LiteralInt,
        span: sp,
        text: text,
        annotations: [],
        children: [],
        atlas_ref: _empty_atlas_ref(sp)
    }
}

fn _mk_ast_let(name: string, is_mut: bool, rhs: Expr, sp: Span) -> Expr {
    let mut t = name
    if is_mut { t = "mut:" + name }
    let mut kids: [Expr] = []
    kids.push(rhs)
    return Expr {
        kind: ExprKind::Let,
        span: sp,
        text: t,
        annotations: [],
        children: kids,
        atlas_ref: _empty_atlas_ref(sp)
    }
}

fn _mk_ast_binop(op: string, l: Expr, r: Expr, sp: Span) -> Expr {
    let mut kids: [Expr] = []
    kids.push(l)
    kids.push(r)
    return Expr {
        kind: ExprKind::BinOp,
        span: sp,
        text: op,
        annotations: [],
        children: kids,
        atlas_ref: _empty_atlas_ref(sp)
    }
}

fn _mk_ast_assign(op: string, l: Expr, r: Expr, sp: Span) -> Expr {
    let mut kids: [Expr] = []
    kids.push(l)
    kids.push(r)
    return Expr {
        kind: ExprKind::Assign,
        span: sp,
        text: op,
        annotations: [],
        children: kids,
        atlas_ref: _empty_atlas_ref(sp)
    }
}

fn _mk_ast_call1(callee_name: string, arg: Expr, sp: Span) -> Expr {
    let mut kids: [Expr] = []
    kids.push(_mk_ast_ident(callee_name, sp))
    kids.push(arg)
    return Expr {
        kind: ExprKind::Call,
        span: sp,
        text: "",
        annotations: [],
        children: kids,
        atlas_ref: _empty_atlas_ref(sp)
    }
}

fn _mk_ast_index(base: Expr, idx: Expr, sp: Span) -> Expr {
    let mut kids: [Expr] = []
    kids.push(base)
    kids.push(idx)
    return Expr {
        kind: ExprKind::Index,
        span: sp,
        text: "",
        annotations: [],
        children: kids,
        atlas_ref: _empty_atlas_ref(sp)
    }
}

fn _mk_ast_block(stmts: [Expr], sp: Span) -> Expr {
    return Expr {
        kind: ExprKind::Block,
        span: sp,
        text: "",
        annotations: [],
        children: stmts,
        atlas_ref: _empty_atlas_ref(sp)
    }
}

fn _mk_ast_while(cond: Expr, body: Expr, sp: Span) -> Expr {
    let mut kids: [Expr] = []
    kids.push(cond)
    kids.push(body)
    return Expr {
        kind: ExprKind::While,
        span: sp,
        text: "",
        annotations: [],
        children: kids,
        atlas_ref: _empty_atlas_ref(sp)
    }
}

fn _pick_for_iter(kids: [Expr], fallback: Expr) -> Expr {
    let n = len(kids)
    if n == 0 {
        return fallback
    }
    return kids[0]
}

fn _pick_for_body(kids: [Expr], fallback: Expr) -> Expr {
    let n = len(kids)
    if n < 2 {
        return fallback
    }
    return kids[1]
}

// C19: build the inner block of the desugared for-loop.
// Splices body-as-block children inline to avoid an extra scope frame;
// otherwise wraps the body expr as a single stmt.
fn _build_for_body(bind_var: Expr, body_e: Expr, inc: Expr) -> [Expr] {
    let mut inner: [Expr] = []
    inner.push(bind_var)
    let body_k = body_e.kind
    let is_blk = _hir_is_block_kind(body_k)
    if is_blk == false {
        inner.push(body_e)
        inner.push(inc)
        return inner
    }
    let mut j = 0
    while j < len(body_e.children) {
        inner.push(body_e.children[j])
        j = j + 1
    }
    inner.push(inc)
    return inner
}

// C19: desugar `for x in iter { body }` to an index-based while loop:
//
//   block {
//       let __for_it_<n>  = <iter>
//       let mut __for_idx_<n> = 0
//       while __for_idx_<n> < len(__for_it_<n>) {
//           let <x> = __for_it_<n>[__for_idx_<n>]
//           <body...>
//           __for_idx_<n> = __for_idx_<n> + 1
//       }
//   }
//
// Stage0 has no iterator protocol — arbitrary-iter exprs (range objects,
// custom generators) compile to MIR that type-checks wrong downstream.
// Accepted for the common range-or-array case.
// TODO(C19-followup): wire to a real `next()` protocol when it lands.
fn _desugar_for(e: Expr) -> Expr {
    let sp = e.span
    let loop_var = e.text
    let iter_e = _pick_for_iter(e.children, _mk_ast_ident(loop_var, sp))
    let body_e = _pick_for_body(e.children, _mk_ast_block([], sp))
    // r13 — range iter `for i in lo..hi` → counter while-loop (ABI-safe; no
    // hexa_range_array int-arg). `let mut i=lo; while i </<= hi { body; i=i+1 }`.
    if _hir_is_binop_kind(iter_e.kind) && (iter_e.text == "range" || iter_e.text == "range_inclusive") && len(iter_e.children) >= 2 {
        let _rlo = iter_e.children[0]
        let _rhi = iter_e.children[1]
        let mut _rcmp = "<"
        if iter_e.text == "range_inclusive" { _rcmp = "<=" }
        let _rlet = _mk_ast_let(loop_var, true, _rlo, sp)
        let _rcond = _mk_ast_binop(_rcmp, _mk_ast_ident(loop_var, sp), _rhi, sp)
        let _rinc = _mk_ast_assign("=", _mk_ast_ident(loop_var, sp),
            _mk_ast_binop("+", _mk_ast_ident(loop_var, sp), _mk_ast_lit_int("1", sp), sp), sp)
        let mut _rwbody: [Expr] = []
        _rwbody.push(body_e)
        _rwbody.push(_rinc)
        let _rwhile = _mk_ast_while(_rcond, _mk_ast_block(_rwbody, sp), sp)
        let mut _router: [Expr] = []
        _router.push(_rlet)
        _router.push(_rwhile)
        return _mk_ast_block(_router, sp)
    }
    let uid = _next_for_uid()
    let it_name  = "__for_it_"  + to_string(uid)
    let idx_name = "__for_idx_" + to_string(uid)
    let let_it = _mk_ast_let(it_name, false, iter_e, sp)
    let let_idx = _mk_ast_let(idx_name, true, _mk_ast_lit_int("0", sp), sp)
    let cond = _mk_ast_binop("<",
        _mk_ast_ident(idx_name, sp),
        _mk_ast_call1("len", _mk_ast_ident(it_name, sp), sp), sp)
    let bind_var = _mk_ast_let(loop_var, false,
        _mk_ast_index(_mk_ast_ident(it_name, sp),
            _mk_ast_ident(idx_name, sp), sp), sp)
    let inc = _mk_ast_assign("=", _mk_ast_ident(idx_name, sp),
        _mk_ast_binop("+", _mk_ast_ident(idx_name, sp),
            _mk_ast_lit_int("1", sp), sp), sp)
    let inner = _build_for_body(bind_var, body_e, inc)
    let while_e = _mk_ast_while(cond, _mk_ast_block(inner, sp), sp)
    let mut outer: [Expr] = []
    outer.push(let_it)
    outer.push(let_idx)
    outer.push(while_e)
    return _mk_ast_block(outer, sp)
}

// #3709 — detect a left-spine binop chain deep enough that the recursive
// _lower_expr would risk overflowing gen3's own native stack. Bounded walk
// (stops at the threshold). Below the threshold the recursive arm runs
// UNCHANGED so the byte-eq baseline for hand-written code is untouched; only
// pathological generated chains (e.g. the 7000-`+` runtime_cuda_emit.hexa
// string build) take the iterative flatten — where recursion would crash.
fn _hir_lower_binop_spine_deep(e: Expr) -> bool {
    let mut depth = 0
    let mut cur = e
    while _hir_is_binop_kind(cur.kind) && len(cur.children) > 0 {
        depth = depth + 1
        if depth > 1000 { return true }
        cur = cur.children[0]
    }
    return false
}

// Struct-destructure pattern → HIR. The parser (parse_struct_pattern) emits a
// StructLit-shaped AST node for a `Name { f, g: b }` arm pattern; here we
// re-tag it as the HIR "struct_pattern" whose children are "field_lit" nodes
// (text = field name, child = the binder ident). Each binder is defined into
// `sc` so the arm body / guard resolve it. hir_to_mir's match arm consumes the
// struct_pattern: an irrefutable shape-true branch + per-field `scrut.<field>`
// extract into each binder. Shared by the unguarded and guarded arm paths.
fn _lower_struct_pattern(pat: Expr, sc: LowerScope) -> LowerResult {
    let mut new_sc = sc
    let mut sp_kids: [HExpr] = []
    let mut fi = 0
    while fi < len(pat.children) {
        let fch = pat.children[fi]
        let mut bind_name = fch.text
        if len(fch.children) > 0 && _hir_is_ident_kind(fch.children[0].kind) {
            bind_name = fch.children[0].text
        }
        if len(bind_name) > 0 && bind_name != "_" {
            new_sc = _define_in_scope(new_sc, bind_name, _hir_empty_type())
        }
        let mut ik: [HExpr] = []
        let ih = _mk_hexpr("ident", fch.span, _hir_empty_type(), bind_name,
                           ik, _empty_atlas_binding(), _hir_miss_def_id())
        let mut fkw: [HExpr] = []
        fkw.push(ih)
        let fh = _mk_hexpr("field_lit", fch.span, _hir_empty_type(), fch.text,
                           fkw, _empty_atlas_binding(), _hir_miss_def_id())
        sp_kids.push(fh)
        fi = fi + 1
    }
    let sph = _mk_hexpr("struct_pattern", pat.span, _hir_empty_type(), pat.text,
                        sp_kids, _empty_atlas_binding(), _hir_miss_def_id())
    return LowerResult { expr: sph, sc: new_sc }
}

// Lower a match-arm INNER pattern (the pattern under a guard, or any arm
// pattern): a StructLit dispatches to the struct_pattern re-tag, everything
// else takes the legacy generic `_lower_expr` (byte-identical for non-struct
// patterns). Keeps the guarded + unguarded paths in lockstep.
fn _lower_pattern_inner(inner: Expr, atlas: AtlasIndex, sc: LowerScope) -> LowerResult {
    if _hir_is_struct_lit_kind(inner.kind) {
        return _lower_struct_pattern(inner, sc)
    }
    return _lower_expr(inner, atlas, sc)
}

fn _lower_expr(e: Expr, atlas: AtlasIndex, sc: LowerScope) -> LowerResult {
    let k = e.kind
    let kind_tag = _expr_kind_tag(k)

    // ── literals ────────────────────────────────────────────
    if _hir_is_lit_int_kind(k) {
        let h = _mk_hexpr(kind_tag, e.span, _hir_t_i64(), e.text,
                          [], _empty_atlas_binding(), _hir_miss_def_id())
        return LowerResult { expr: h, sc: sc }
    }
    if _is_lit_float_kind(k) {
        let h = _mk_hexpr(kind_tag, e.span, _hir_t_f64(), e.text,
                          [], _empty_atlas_binding(), _hir_miss_def_id())
        return LowerResult { expr: h, sc: sc }
    }
    if _is_lit_string_kind(k) {
        let h = _mk_hexpr(kind_tag, e.span, _hir_t_string(), e.text,
                          [], _empty_atlas_binding(), _hir_miss_def_id())
        return LowerResult { expr: h, sc: sc }
    }
    if _is_lit_bool_kind(k) {
        let h = _mk_hexpr(kind_tag, e.span, _hir_t_bool(), e.text,
                          [], _empty_atlas_binding(), _hir_miss_def_id())
        return LowerResult { expr: h, sc: sc }
    }
    if _is_lit_char_kind(k) {
        let h = _mk_hexpr(kind_tag, e.span, _hir_t_char(), e.text,
                          [], _empty_atlas_binding(), _hir_miss_def_id())
        return LowerResult { expr: h, sc: sc }
    }

    // ── ident: resolve DefId via inline scope ───────────────
    if _hir_is_ident_kind(k) {
        let b = _lookup_in_scope(sc, e.text)
        let def = b.def
        let mut t = b.typ
        if len(t.kind) == 0 { t = _hir_empty_type() }
        let h = _mk_hexpr(kind_tag, e.span, t, e.text,
                          [], _empty_atlas_binding(), def)
        return LowerResult { expr: h, sc: sc }
    }

    // ── atlas ref: resolve binding ──────────────────────────
    if _is_atlas_kind(k) {
        let ab = _resolve_atlas(e.atlas_ref, atlas)
        let t = _atlas_kind_type(e.atlas_ref.kind)
        let h = _mk_hexpr(kind_tag, e.span, t, e.text,
                          [], ab, _hir_miss_def_id())
        return LowerResult { expr: h, sc: sc }
    }

    // ── binop: deep left-spine FLATTEN (#3709) ──────────────────────────
    //
    // The parser's precedence-climbing (parse_additive/_multiplicative/…)
    // builds same-operator runs as a LEFT-LEANING tree: `a + b + c + …`
    // parses to `((a+b)+c)…`, so child[0] is itself a binop down the whole
    // chain. A naive `_lower_expr(child[0])` recursion is then as deep as the
    // chain. A single 7004-line emitter function (self/cuda/runtime_cuda_
    // emit.hexa — one `let s = "…" + "…" + …` of ~7000 `+`) drove _lower_expr
    // ~7000 frames deep and SIGSEGV'd gen3's own stack while compiling it
    // (the -cuda release runtime_cuda.c emit failure, EXIT=139 gdb-confirmed).
    //
    // ONLY pathological deep spines take this iterative path; everything
    // below the threshold falls through to the proven recursive binop arm
    // below UNCHANGED, so the byte-eq baseline for all hand-written code is
    // untouched (recursion crashes on the deep spine — there is no prior
    // baseline to violate there). We descend the child[0] spine with an
    // explicit worklist and rebuild the HExpr bottom-up — IDENTICAL tree
    // shape + left-to-right scope threading as the recursion, O(1) stack.
    if _hir_is_binop_kind(k) && _hir_lower_binop_spine_deep(e) {
        // spine[0] OUTERMOST (== e); each next is its child[0] while that
        // child is also a binop. The deepest node's child[0] is the BASE.
        //
        // PERF (deep-spine O(n²) kill, r3): we DO NOT `spine.push(cur)` the
        // whole node — `cur.children[0]` is the O(N)-deep left subtree, so
        // pushing the node into `[Expr]` deep-`hexa_val_heapify`'d the entire
        // remaining spine each iteration → O(N²) just to COLLECT the spine
        // (measured: depth-2000 = 98s; >36% wall in hexa_val_heapify under
        // spine.push). The unwind only ever reads each node's RIGHT operands
        // (`children[1..]`, shallow leaves) + `kind`/`span`/`text`, and the
        // BASE leaf (`children[0]` of the deepest node). We therefore collect
        // a SHALLOW per-node carrier (right children only — child[0] dropped)
        // so each push is O(right-arity)≈O(1); the carrier is field-identical
        // to the original node for every field the unwind reads, and the
        // deepest left leaf is captured once at loop exit → byte-eq NEUTRAL,
        // collapses the spine collection from O(N²) to O(N).
        let mut spine: [Expr] = []
        let mut cur = e
        let mut base_leaf = cur
        while true {
            let mut rkids: [Expr] = []
            let mut rci = 1
            while rci < len(cur.children) {
                rkids.push(cur.children[rci])
                rci = rci + 1
            }
            // Shallow carrier: same kind/span/text/annotations/atlas_ref, but
            // children = RIGHT operands only (child[0] — the deep left — is
            // intentionally dropped; the unwind never reads spine[si].child[0]).
            spine.push(Expr {
                kind: cur.kind,
                span: cur.span,
                text: cur.text,
                annotations: cur.annotations,
                children: rkids,
                atlas_ref: cur.atlas_ref
            })
            if len(cur.children) > 0 && _hir_is_binop_kind(cur.children[0].kind) {
                cur = cur.children[0]
            } else {
                // deepest node reached — its child[0] is the BASE leaf.
                if len(cur.children) > 0 { base_leaf = cur.children[0] }
                break
            }
        }
        // Lower the base (deepest child[0]) first — matches the recursion,
        // which fully lowers the leftmost leaf before any enclosing binop.
        let mut new_sc = sc
        let base_r = _lower_expr(base_leaf, atlas, new_sc)
        let mut acc = base_r.expr
        new_sc = base_r.sc
        // Unwind from the deepest spine node outward. For each node, child[0]
        // is the accumulated left HExpr (`acc`); lower the remaining children
        // (now stored as `node.children[0..]`, shallow — the right operands)
        // in order, threading scope.
        let mut si = len(spine) - 1
        while si >= 0 {
            let node = spine[si]
            let mut kids: [HExpr] = []
            kids.push(acc)
            let mut ci = 0
            while ci < len(node.children) {
                let r = _lower_expr(node.children[ci], atlas, new_sc)
                kids.push(r.expr)
                new_sc = r.sc
                ci = ci + 1
            }
            let mut t = _hir_empty_type()
            if _hir_is_compare_op(node.text) {
                t = _hir_t_bool()
            } else if len(kids) >= 2 {
                let lt = kids[0].typ
                let rt = kids[1].typ
                if _hir_is_numeric(lt) && _hir_is_numeric(rt) && lt.kind == rt.kind {
                    t = lt
                } else if len(lt.kind) > 0 && lt.kind != "?" {
                    t = lt
                } else {
                    t = rt
                }
            } else if len(kids) == 1 {
                t = kids[0].typ
            }
            // PERF (deep-spine O(n²) kill): build the wrapper node with an
            // INLINE struct literal, NOT `_mk_hexpr(...)`. A function call
            // returns through `__hexa_fn_arena_return`, which deep-heapifies the
            // return value — and the return value's `children` embeds `acc`, the
            // O(N)-deep accumulated tree, so calling `_mk_hexpr` per spine node
            // heapified the WHOLE growing tree each iteration → O(N²) (measured
            // on aiden: depth-4000 = 371s, 8.4× over depth-2000 = 44s; >80% in
            // hexa_val_heapify under the deep-flatten path). The inline literal
            // is evaluated in place (no fn-arena return boundary), so the tree
            // is heapified only ONCE at the final `return LowerResult` —
            // collapsing the spine build from O(N²) to O(N). Field-for-field
            // identical to `_mk_hexpr` (annotations: [] default) → byte-eq
            // NEUTRAL.
            acc = HExpr {
                kind: _expr_kind_tag(node.kind),
                span: node.span,
                typ: t,
                text: node.text,
                children: kids,
                atlas: _empty_atlas_binding(),
                def: _hir_miss_def_id(),
                annotations: []
            }
            si = si - 1
        }
        return LowerResult { expr: acc, sc: new_sc }
    }

    // ── binop: type from operand types (numeric promotion same-kind) ──
    if _hir_is_binop_kind(k) {
        let mut new_sc = sc
        let mut kids: [HExpr] = []
        let mut i = 0
        while i < len(e.children) {
            let r = _lower_expr(e.children[i], atlas, new_sc)
            kids.push(r.expr)
            new_sc = r.sc
            i = i + 1
        }
        let mut t = _hir_empty_type()
        if _hir_is_compare_op(e.text) {
            t = _hir_t_bool()
        } else if len(kids) >= 2 {
            let lt = kids[0].typ
            let rt = kids[1].typ
            if _hir_is_numeric(lt) && _hir_is_numeric(rt) && lt.kind == rt.kind {
                t = lt
            } else if len(lt.kind) > 0 && lt.kind != "?" {
                t = lt
            } else {
                t = rt
            }
        } else if len(kids) == 1 {
            t = kids[0].typ
        }
        let h = _mk_hexpr(kind_tag, e.span, t, e.text,
                          kids, _empty_atlas_binding(), _hir_miss_def_id())
        return LowerResult { expr: h, sc: new_sc }
    }

    // ── unop: type from operand ─────────────────────────────
    if _hir_is_unop_kind(k) {
        let mut new_sc = sc
        let mut kids: [HExpr] = []
        let mut i = 0
        while i < len(e.children) {
            let r = _lower_expr(e.children[i], atlas, new_sc)
            kids.push(r.expr)
            new_sc = r.sc
            i = i + 1
        }
        let mut t = _hir_empty_type()
        if len(kids) > 0 { t = kids[0].typ }
        // RFC r15-D2 — postfix `?` try-propagation operator. The parser
        // (parse_postfix, gated HEXA_TRY_OP) carries `expr?` as an
        // ExprKind::UnOp with text "?" so NO new ExprKind variant is needed
        // (avoids editing the exhaustive `_hir_is_*`/`_expr_kind_tag` tables).
        // Re-tag it here to a DISTINCT HExpr.kind string "tryop" (HExpr.kind is
        // a free string) so hir_to_mir targets the success-tag discriminant +
        // Err/None early-return lowering, leaving ordinary unary `-`/`!` (which
        // keep kind_tag "unop") untouched. Default-OFF: the parser only ever
        // builds a "?" UnOp when HEXA_TRY_OP is set, so this re-tag is dead on
        // every byteeq build (gen3≡gen4 fixpoint untouched).
        let mut khk = kind_tag
        if e.text == "?" && env("HEXA_TRY_OP") == "1" { khk = "tryop" }
        let h = _mk_hexpr(khk, e.span, t, e.text,
                          kids, _empty_atlas_binding(), _hir_miss_def_id())
        return LowerResult { expr: h, sc: new_sc }
    }

    // ── call: type from callee fn ret ───────────────────────
    if _is_call_kind(k) {
        let mut new_sc = sc
        let mut kids: [HExpr] = []
        let mut i = 0
        while i < len(e.children) {
            let r = _lower_expr(e.children[i], atlas, new_sc)
            kids.push(r.expr)
            new_sc = r.sc
            i = i + 1
        }
        let mut t = _hir_empty_type()
        let mut callee_def = _hir_miss_def_id()
        if len(kids) > 0 {
            let callee = kids[0]
            callee_def = callee.def
            let ct = callee.typ
            if ct.kind == "fn" && len(ct.ret) > 0 {
                t = ct.ret[0]
            }
        }
        // L4 unboxing round-1 — HEXA_UNBOX_HIR_CALLTYPE (gated · default-OFF).
        // When the fn-return stamp above left the result UNKNOWN ("?") and the
        // callee is a builtin-METHOD (Field callee), stamp the monomorphic
        // primitive result from the mirrored checker table so the codegen unbox
        // gate can fire on the call-result operand. OFF path is byte-identical:
        // this branch is unreachable unless the env flag is "1".
        if t.kind == "?" && _hir_calltype_stamp_enabled() && len(kids) > 0 {
            let bm_callee = kids[0]
            if bm_callee.kind == "field" {
                let bm_ret = _hir_builtin_method_ret_prim(bm_callee.text)
                if bm_ret.kind != "?" { t = bm_ret }
            }
        }
        let h = _mk_hexpr(kind_tag, e.span, t, e.text,
                          kids, _empty_atlas_binding(), callee_def)
        return LowerResult { expr: h, sc: new_sc }
    }

    // ── defer carrier (HEXA-OWN M1) — MUST precede the generic block
    // case: the carrier is ExprKind::Block + text "__defer__" + children
    // [body_block] (ast.hexa::ast_is_defer). Lowers to HExpr kind "defer"
    // (string tag — no HIR enum change) with the lowered body block as its
    // single child. The child IS a Block, so recursing through
    // `_lower_expr` runs the generic block case below, which pushes/pops
    // the LowerScope frame — identical scope threading to a plain block.
    // hir_to_mir consumes the "defer" kind (flag registration + fn-exit
    // LIFO drain); no other pass sees it.
    if ast_is_defer(e) && len(e.children) == 1 {
        let r = _lower_expr(e.children[0], atlas, sc)
        let mut dkids: [HExpr] = []
        dkids.push(r.expr)
        let h = _mk_hexpr("defer", e.span, _hir_t_unit(), "",
                          dkids, _empty_atlas_binding(), _hir_miss_def_id())
        return LowerResult { expr: h, sc: r.sc }
    }

    // ── block: type = last child's type, opens a scope frame ──
    if _hir_is_block_kind(k) {
        let mut new_sc = _push_frame(sc)
        let mut kids: [HExpr] = []
        let mut i = 0
        while i < len(e.children) {
            let r = _lower_expr(e.children[i], atlas, new_sc)
            kids.push(r.expr)
            new_sc = r.sc
            i = i + 1
        }
        let mut t = _hir_t_unit()
        if len(kids) > 0 {
            t = kids[len(kids) - 1].typ
        }
        new_sc = _pop_frame(new_sc)
        let h = _mk_hexpr(kind_tag, e.span, t, e.text,
                          kids, _empty_atlas_binding(), _hir_miss_def_id())
        return LowerResult { expr: h, sc: new_sc }
    }

    // ── if: type = then-branch type ─────────────────────────
    if _is_if_kind(k) {
        let mut new_sc = sc
        let mut kids: [HExpr] = []
        let mut i = 0
        while i < len(e.children) {
            let r = _lower_expr(e.children[i], atlas, new_sc)
            kids.push(r.expr)
            new_sc = r.sc
            i = i + 1
        }
        let mut t = _hir_t_unit()
        if len(kids) >= 2 { t = kids[1].typ }
        let h = _mk_hexpr(kind_tag, e.span, t, e.text,
                          kids, _empty_atlas_binding(), _hir_miss_def_id())
        return LowerResult { expr: h, sc: new_sc }
    }

    // ── while: always unit ─────────────────────────────────
    if _is_while_kind(k) {
        let mut new_sc = sc
        let mut kids: [HExpr] = []
        let mut i = 0
        while i < len(e.children) {
            let r = _lower_expr(e.children[i], atlas, new_sc)
            kids.push(r.expr)
            new_sc = r.sc
            i = i + 1
        }
        let h = _mk_hexpr(kind_tag, e.span, _hir_t_unit(), e.text,
                          kids, _empty_atlas_binding(), _hir_miss_def_id())
        return LowerResult { expr: h, sc: new_sc }
    }

    // ── return: unit (control-flow), child carries return value ──
    if _hir_is_return_kind(k) {
        let mut new_sc = sc
        let mut kids: [HExpr] = []
        let mut i = 0
        while i < len(e.children) {
            let r = _lower_expr(e.children[i], atlas, new_sc)
            kids.push(r.expr)
            new_sc = r.sc
            i = i + 1
        }
        let h = _mk_hexpr(kind_tag, e.span, _hir_t_unit(), e.text,
                          kids, _empty_atlas_binding(), _hir_miss_def_id())
        return LowerResult { expr: h, sc: new_sc }
    }

    // ── let: lower RHS first, then bind. Type = unit (statement-shaped). ──
    // PR-C piece 3 — `_mk_hexpr_anns` threads AST `Expr.annotations` (e.g.
    // `@shared`) onto the HIR Let so `hir_to_mir.hexa` can stamp the
    // resulting `Local.space` and ultimately the NVPTX `.shared` directive.
    if _is_let_expr_kind(k) {
        let mut new_sc = sc
        let mut kids: [HExpr] = []
        let mut i = 0
        while i < len(e.children) {
            let r = _lower_expr(e.children[i], atlas, new_sc)
            kids.push(r.expr)
            new_sc = r.sc
            i = i + 1
        }
        let nm = _hir_let_name(e.text)
        if len(nm) > 0 {
            let mut rhs_t = _hir_empty_type()
            if len(kids) > 0 { rhs_t = kids[0].typ }
            new_sc = _define_in_scope(new_sc, nm, rhs_t)
        }
        let h = _mk_hexpr_anns(kind_tag, e.span, _hir_t_unit(), e.text,
                               kids, _empty_atlas_binding(), _hir_miss_def_id(),
                               e.annotations)
        return LowerResult { expr: h, sc: new_sc }
    }

    // ── match: type = first arm body type ───────────────────
    if _hir_is_match_kind(k) {
        let mut new_sc = sc
        let mut kids: [HExpr] = []
        // children: [scrut, pat0, body0, pat1, body1, ...]
        // Lower scrutinee first, then each pat/body in a fresh frame so any
        // pattern-bound idents live only within the arm body.
        if len(e.children) >= 1 {
            let r = _lower_expr(e.children[0], atlas, new_sc)
            kids.push(r.expr)
            new_sc = r.sc
        }
        let mut idx = 1
        let mut first_body_t = _hir_empty_type()
        let mut have_first = false
        while idx + 1 < len(e.children) {
            let pat = e.children[idx]
            let body = e.children[idx + 1]
            // arm scope
            let mut arm_sc = _push_frame(new_sc)
            // RFC pattern guards — a guarded arm wraps its pattern as a
            // "match_guard" carrier (children [inner_pattern, guard]). Lower
            // the inner pattern + guard in the arm scope and re-emit them as a
            // HIR "match_guard" HExpr (children [inner, guard]); hir_to_mir's
            // match loop unwraps it and inserts the guard branch. Unguarded
            // arms take the legacy path unchanged (byte-identical HIR).
            if ast_is_match_guard(pat) {
                let inner = pat.children[0]
                let guard = pat.children[1]
                if _hir_is_ident_kind(inner.kind) && len(inner.text) > 0 && inner.text != "_" {
                    arm_sc = _define_in_scope(arm_sc, inner.text, _hir_empty_type())
                }
                // A guarded struct-destructure pattern (`Point { x, y } if …`)
                // re-tags its StructLit inner as the HIR struct_pattern and
                // defines its binders BEFORE the guard is lowered, so the guard
                // can read the field binders (mirrors the enum-payload guard).
                // `_lower_pattern_inner` dispatches struct-lit → struct_pattern,
                // everything else → the legacy generic lowering (byte-identical
                // for non-struct inner patterns).
                let ipr = _lower_pattern_inner(inner, atlas, arm_sc)
                arm_sc = ipr.sc
                let gpr = _lower_expr(guard, atlas, arm_sc)
                arm_sc = gpr.sc
                let mut gkids: [HExpr] = []
                gkids.push(ipr.expr)
                gkids.push(gpr.expr)
                let gh = _mk_hexpr("match_guard", pat.span, ipr.expr.typ, "match_guard",
                                   gkids, _empty_atlas_binding(), _hir_miss_def_id())
                let br = _lower_expr(body, atlas, arm_sc)
                kids.push(gh)
                kids.push(br.expr)
                arm_sc = br.sc
                new_sc = _pop_frame(arm_sc)
                if !have_first {
                    first_body_t = br.expr.typ
                    have_first = true
                }
                idx = idx + 2
                continue
            }
            // Struct-destructure pattern `Name { f, g: b }` — the parser emits
            // a StructLit-shaped node in arm position (parse_struct_pattern). A
            // StructLit can only appear here as a pattern, so re-tag it as the
            // HIR "struct_pattern" (consumed by hir_to_mir's match arm: a
            // shape-true STMT_BR + per-field `scrut.<field>` extract into each
            // binder). Each field child is `Ident(field, [Ident(binder)])`; we
            // lift it to a HIR `field_lit` (text=field, child = HIR ident
            // binder) and define the binder in the arm scope so the body
            // resolves it. Unguarded non-struct arms take the legacy path.
            if _hir_is_struct_lit_kind(pat.kind) {
                let spr = _lower_struct_pattern(pat, arm_sc)
                arm_sc = spr.sc
                let br = _lower_expr(body, atlas, arm_sc)
                kids.push(spr.expr)
                kids.push(br.expr)
                arm_sc = br.sc
                new_sc = _pop_frame(arm_sc)
                if !have_first {
                    first_body_t = br.expr.typ
                    have_first = true
                }
                idx = idx + 2
                continue
            }
            // bind ident-pattern names so body lookups can see them
            if _hir_is_ident_kind(pat.kind) && len(pat.text) > 0 && pat.text != "_" {
                arm_sc = _define_in_scope(arm_sc, pat.text, _hir_empty_type())
            }
            let pr = _lower_expr(pat, atlas, arm_sc)
            arm_sc = pr.sc
            let br = _lower_expr(body, atlas, arm_sc)
            kids.push(pr.expr)
            kids.push(br.expr)
            arm_sc = br.sc
            new_sc = _pop_frame(arm_sc)
            if !have_first {
                first_body_t = br.expr.typ
                have_first = true
            }
            idx = idx + 2
        }
        let mut t = _hir_t_unit()
        if have_first { t = first_body_t }
        let h = _mk_hexpr(kind_tag, e.span, t, e.text,
                          kids, _empty_atlas_binding(), _hir_miss_def_id())
        return LowerResult { expr: h, sc: new_sc }
    }

    // ── Stage1 Gap 14 idiom handlers (struct_lit / enum_path /
    // field / index / for / assign / wildcard). Each branch lowers
    // children explicitly so downstream hir_to_mir can emit the
    // matching STMT_ASSIGN / STMT_BR_COND patterns. ────────────
    if _hir_is_struct_lit_kind(k) {
        let mut new_sc = sc
        let mut kids: [HExpr] = []
        let mut i = 0
        while i < len(e.children) {
            let f = e.children[i]
            if _hir_is_ident_kind(f.kind) && len(f.children) > 0 {
                let vr = _lower_expr(f.children[0], atlas, new_sc)
                new_sc = vr.sc
                let mut field_kids: [HExpr] = []
                field_kids.push(vr.expr)
                let fh = _mk_hexpr("field_lit", f.span, vr.expr.typ, f.text,
                                   field_kids, _empty_atlas_binding(),
                                   _hir_miss_def_id())
                kids.push(fh)
            } else {
                let vr = _lower_expr(f, atlas, new_sc)
                new_sc = vr.sc
                kids.push(vr.expr)
            }
            i = i + 1
        }
        let t = _struct_named_type(e.text)
        let h = _mk_hexpr(kind_tag, e.span, t, e.text,
                          kids, _empty_atlas_binding(), _hir_miss_def_id())
        return LowerResult { expr: h, sc: new_sc }
    }
    if _hir_is_enum_path_kind(k) {
        // RFC-074 Phase 3 (compiler/ tree) — multi-arg payload lift to HIR.
        //
        // Every child of an EnumPath AST node is a positional payload arg
        // (single-field arity 1 was already covered by this loop — the
        // generic `while i < len(e.children)` recurses every child, so
        // arity N >= 2 lifts to HIR with zero structural delta on this
        // side. The HIR shape `HExpr{kind=enum_path, children:[HExpr]}`
        // is the `HirEnumCtor{tag, args:[HirValue]}` RFC-074 §3 calls
        // for, projected onto the existing string-kind HExpr container
        // (Phase 3 lands without a sum-typed HIR node — RFC §3.1.3
        // "stage0 hexa has no sum types" carve-out). The match-arm
        // destructure side is fixed in hir_to_mir.hexa enum_path arm.
        let mut new_sc = sc
        let mut kids: [HExpr] = []
        let mut i = 0
        while i < len(e.children) {
            let r = _lower_expr(e.children[i], atlas, new_sc)
            kids.push(r.expr)
            new_sc = r.sc
            i = i + 1
        }
        let parts = _split_enum_path(e.text)
        let t = _enum_named_type(parts[0])
        let h = _mk_hexpr(kind_tag, e.span, t, e.text,
                          kids, _empty_atlas_binding(), _hir_miss_def_id())
        return LowerResult { expr: h, sc: new_sc }
    }
    if _hir_is_field_kind(k) {
        let mut new_sc = sc
        let mut kids: [HExpr] = []
        if len(e.children) > 0 {
            let r = _lower_expr(e.children[0], atlas, new_sc)
            kids.push(r.expr)
            new_sc = r.sc
        }
        let h = _mk_hexpr(kind_tag, e.span, _hir_empty_type(), e.text,
                          kids, _empty_atlas_binding(), _hir_miss_def_id())
        return LowerResult { expr: h, sc: new_sc }
    }
    if _hir_is_index_kind(k) {
        let mut new_sc = sc
        let mut kids: [HExpr] = []
        let mut i = 0
        while i < len(e.children) {
            let r = _lower_expr(e.children[i], atlas, new_sc)
            kids.push(r.expr)
            new_sc = r.sc
            i = i + 1
        }
        let mut t = _hir_empty_type()
        if len(kids) > 0 { t = kids[0].typ }
        let h = _mk_hexpr(kind_tag, e.span, t, e.text,
                          kids, _empty_atlas_binding(), _hir_miss_def_id())
        return LowerResult { expr: h, sc: new_sc }
    }
    if _hir_is_for_kind(k) {
        // C19 (stage1 punch list v2): desugar `for x in iter { body }` into
        // an explicit index-based while loop BEFORE hir_to_mir ever sees a
        // "for" node. hir_to_mir lacks a `for` handler and would otherwise
        // fall through to generic-recurse, producing MIR with no loop CFG.
        //
        // Stage0 has no iterator protocol, so we lower to the common
        // index-into-array form:
        //
        //   block {
        //       let __for_it_<n>  = <iter>
        //       let mut __for_idx_<n> = 0
        //       while __for_idx_<n> < len(__for_it_<n>) {
        //           let <x> = __for_it_<n>[__for_idx_<n>]
        //           <body>
        //           __for_idx_<n> = __for_idx_<n> + 1
        //       }
        //   }
        //
        // TODO(C19-followup): once an iterator protocol lands
        // (`iter.next() -> Option<T>` or similar), desugar arbitrary-expr
        // iteration to that shape instead. Today any non-indexable iterable
        // (e.g. a custom generator) compiles to MIR that will type-check
        // wrong downstream — accepted for stage0.
        let desugared = _desugar_for(e)
        return _lower_expr(desugared, atlas, sc)
    }
    if _hir_is_assign_kind(k) {
        let mut new_sc = sc
        let mut kids: [HExpr] = []
        let mut i = 0
        while i < len(e.children) {
            let r = _lower_expr(e.children[i], atlas, new_sc)
            kids.push(r.expr)
            new_sc = r.sc
            i = i + 1
        }
        let mut t = _hir_t_unit()
        if len(kids) >= 2 { t = kids[1].typ }
        let h = _mk_hexpr(kind_tag, e.span, t, e.text,
                          kids, _empty_atlas_binding(), _hir_miss_def_id())
        return LowerResult { expr: h, sc: new_sc }
    }
    if _hir_is_wildcard_kind(k) {
        let h = _mk_hexpr(kind_tag, e.span, _hir_empty_type(), e.text,
                          [], _empty_atlas_binding(), _hir_miss_def_id())
        return LowerResult { expr: h, sc: sc }
    }

    // ── closure-expression — RFC C1 ─────────────────────────
    // AST children = [param_0 .. param_{n-1}, body_block]; e.text = decimal
    // param count. Lower the body in a frame that has the param names
    // defined, so body-local ident references resolve to params (and outer
    // names resolve up the enclosing frames — the C2 capture set). The
    // param Ident nodes themselves are NOT scope-resolved — they carry
    // names only. The resulting HExpr keeps tag "closure"; hir_to_mir
    // rejects it with HX1104 (codegen deferred to RFC C2/C3) — it never
    // reaches arm64 lowering. We preserve the param + body children so the
    // C2 closure-conversion pass has the full structured node.
    if _hir_is_closure_kind(k) {
        let nc = len(e.children)
        let mut clo_kids: [HExpr] = []
        // params — preserve as ident HExprs (name + span), no resolution.
        let mut pi = 0
        while pi < nc - 1 {
            let pn = e.children[pi]
            let ph = _mk_hexpr("ident", pn.span, _hir_empty_type(), pn.text,
                               [], _empty_atlas_binding(), _hir_miss_def_id())
            clo_kids.push(ph)
            pi = pi + 1
        }
        // body — lowered in a child frame with param names defined.
        let mut body_sc = _push_frame(sc)
        let mut pj = 0
        while pj < nc - 1 {
            body_sc = _define_in_scope(body_sc, e.children[pj].text,
                                       _hir_empty_type())
            pj = pj + 1
        }
        if nc >= 1 {
            let br = _lower_expr(e.children[nc - 1], atlas, body_sc)
            clo_kids.push(br.expr)
        }
        // closure value type: bare `fn` (no per-param/return modeling — C2
        // scope), mirroring the type-checker's C1 closure representation.
        let clo_t = Type {
            kind: "fn",
            def: _hir_miss_def_id(),
            args: [],
            ret: [],
            domain: "",
            unit: ""
        }
        let h = _mk_hexpr("closure", e.span, clo_t, e.text,
                          clo_kids, _empty_atlas_binding(), _hir_miss_def_id())
        return LowerResult { expr: h, sc: sc }
    }

    // ── Default — generic recurse for any kind not handled above. ──
    // Generic recurse — every child lowered in order.
    let mut new_sc = sc
    let mut kids: [HExpr] = []
    let mut i = 0
    while i < len(e.children) {
        let r = _lower_expr(e.children[i], atlas, new_sc)
        kids.push(r.expr)
        new_sc = r.sc
        i = i + 1
    }
    let h = _mk_hexpr(kind_tag, e.span, _hir_empty_type(), e.text,
                      kids, _empty_atlas_binding(), _hir_miss_def_id())
    return LowerResult { expr: h, sc: new_sc }
}

// ── Module-level pre-pass: mint DefIds for items, build top env ─

fn _hir_signature_type(it: Item) -> Type {
    let mut params: [Type] = []
    let mut i = 0
    while i < len(it.params) {
        params.push(_hir_lower_type_ref(it.params[i].typ))
        i = i + 1
    }
    let mut ret: [Type] = []
    let r = _hir_lower_type_ref(it.return_type)
    ret.push(r)
    return Type {
        kind: "fn",
        def: _hir_miss_def_id(),
        args: params,
        ret: ret,
        domain: "",
        unit: ""
    }
}

fn _hir_struct_type(it: Item, def: DefId) -> Type {
    let mut fields: [Type] = []
    let mut i = 0
    while i < len(it.params) {
        fields.push(_hir_lower_type_ref(it.params[i].typ))
        i = i + 1
    }
    return Type {
        kind: "struct",
        def: def,
        args: fields,
        ret: [],
        domain: "",
        unit: ""
    }
}

fn _hir_enum_type(def: DefId) -> Type {
    return Type {
        kind: "enum",
        def: def,
        args: [],
        ret: [],
        domain: "",
        unit: ""
    }
}

// Return a HItem placeholder body (empty Block-like HExpr) used for items
// that have no AST body (struct/enum/import).
fn _empty_hbody(sp: Span) -> HExpr {
    return HExpr {
        kind: "block",
        span: sp,
        typ: _hir_t_unit(),
        text: "",
        children: [],
        atlas: _empty_atlas_binding(),
        def: _hir_miss_def_id(),
        annotations: []
    }
}

// ── Item lowering ────────────────────────────────────────────

fn _lower_item(it: Item, def: DefId, atlas: AtlasIndex,
               module_scope: LowerScope) -> HItem {
    let kind_tag = _item_kind_tag(it.kind)

    if _hir_is_fn_item(it.kind) {
        // Build a function-local scope: module env + params.
        let mut fn_sc = _push_frame(module_scope)
        let mut sig_params: [Type] = []
        // Synthesize a `param_names` annotation from the real parameter
        // identifiers. hir_to_mir::_lower_fn binds param locals to their
        // names ONLY via this annotation; without it body identifiers
        // resolve to nothing and fall through to const-0 (every fn
        // param read as 0 — broke all parameterized fns/recursion).
        let mut pn_args: [Expr] = []
        let mut p = 0
        while p < len(it.params) {
            let par = it.params[p]
            let pt = _hir_lower_type_ref(par.typ)
            sig_params.push(pt)
            if len(par.name) > 0 {
                fn_sc = _define_in_scope(fn_sc, par.name, pt)
            }
            pn_args.push(Expr {
                kind: ExprKind::Ident,
                span: par.span,
                text: par.name,
                annotations: [],
                children: [],
                atlas_ref: AtlasRef { kind: "", id: "", span: par.span }
            })
            p = p + 1
        }
        let mut fn_anns: [Annotation] = []
        let mut ai = 0
        while ai < len(it.annotations) {
            fn_anns.push(it.annotations[ai])
            ai = ai + 1
        }
        fn_anns.push(Annotation {
            name: "param_names",
            args: pn_args,
            span: it.span
        })
        let sig_ret = _hir_lower_type_ref(it.return_type)
        let r = _lower_expr(it.body, atlas, fn_sc)
        return HItem {
            kind: kind_tag,
            def: def,
            name: it.name,
            span: it.span,
            annotations: fn_anns,
            sig_params: sig_params,
            sig_return: sig_ret,
            body: r.expr,
            is_pub: it.is_pub,
            discoverable: false,
            proof_hash: "",
            verifier_version: ""
        }
    }

    if _hir_is_let_item(it.kind) {
        let declared = _hir_lower_type_ref(it.return_type)
        let r = _lower_expr(it.body, atlas, module_scope)
        let mut sig_ret = declared
        if len(declared.kind) == 0 || declared.kind == "?" || declared.kind == "unit" {
            // Prefer RHS type if declared was empty/unknown.
            if len(r.expr.typ.kind) > 0 && r.expr.typ.kind != "?" {
                sig_ret = r.expr.typ
            }
        }
        return HItem {
            kind: kind_tag,
            def: def,
            name: it.name,
            span: it.span,
            annotations: it.annotations,
            sig_params: [],
            sig_return: sig_ret,
            body: r.expr,
            is_pub: it.is_pub,
            discoverable: false,
            proof_hash: "",
            verifier_version: ""
        }
    }

    if _hir_is_struct_item(it.kind) {
        let mut fields: [Type] = []
        let mut i = 0
        while i < len(it.params) {
            fields.push(_hir_lower_type_ref(it.params[i].typ))
            i = i + 1
        }
        return HItem {
            kind: kind_tag,
            def: def,
            name: it.name,
            span: it.span,
            annotations: it.annotations,
            sig_params: fields,
            sig_return: _hir_struct_type(it, def),
            body: _empty_hbody(it.span),
            is_pub: it.is_pub,
            discoverable: false,
            proof_hash: "",
            verifier_version: ""
        }
    }

    if _hir_is_enum_item(it.kind) {
        return HItem {
            kind: kind_tag,
            def: def,
            name: it.name,
            span: it.span,
            annotations: it.annotations,
            sig_params: [],
            sig_return: _hir_enum_type(def),
            body: _empty_hbody(it.span),
            is_pub: it.is_pub,
            discoverable: false,
            proof_hash: "",
            verifier_version: ""
        }
    }

    // Import — minimal HItem; no body.
    return HItem {
        kind: kind_tag,
        def: def,
        name: it.name,
        span: it.span,
        annotations: it.annotations,
        sig_params: [],
        sig_return: _hir_t_unit(),
        body: _empty_hbody(it.span),
        is_pub: it.is_pub,
        discoverable: false,
        proof_hash: "",
        verifier_version: ""
    }
}

// ── Public entry ─────────────────────────────────────────────

pub fn lower(module: Module, atlas: AtlasIndex) -> HModule {
    // Reset the per-invocation diag buffer so successive lower() calls in
    // the same process do not leak HX1100 emissions across compilations.
    l_diags = []
    // C19: reset for-desugar uid counter so output is determinate.
    _for_uid = 0
    // PERF: reset the module-frame bucket index — lower() runs once per module
    // and successive calls in one process must not read a stale index.
    _lr_ast_gbound = -1
    _lr_ast_gnames = []
    _lr_ast_gbinds = []

    // Pre-pass: mint DefIds + collect module-level type bindings so that
    // intra-module references (calls, struct-of-fields, etc.) can resolve.
    let mut module_sc = _new_scope(module.file)
    module_sc = _push_frame(module_sc)

    let mut item_defs: [DefId] = []
    let mut idx: i64 = 0
    let mut i = 0
    while i < len(module.items) {
        let it = module.items[i]
        let def = DefId { module: module.file, index: idx }
        item_defs.push(def)
        if item_is_type_alias(it) {
            // Type-alias carrier (ItemKind::Let + `__type_alias`) is a pure
            // parse/resolve substitution — it binds no runtime value, so it is
            // NOT defined in module scope (and is dropped from lowering in the
            // pass below). `def`/`idx` still advance to keep item_defs[]
            // index-aligned with module.items for the lowering pass.
        } else if _is_import_item(it.kind) {
            // Imports are not bound as defs in scope.
        } else if _hir_is_fn_item(it.kind) {
            module_sc = _define_with_def(module_sc, it.name, def, _hir_signature_type(it))
        } else if _hir_is_struct_item(it.kind) {
            module_sc = _define_with_def(module_sc, it.name, def, _hir_struct_type(it, def))
        } else if _hir_is_enum_item(it.kind) {
            module_sc = _define_with_def(module_sc, it.name, def, _hir_enum_type(def))
        } else if _hir_is_let_item(it.kind) {
            module_sc = _define_with_def(module_sc, it.name, def, _hir_lower_type_ref(it.return_type))
        }
        idx = idx + 1
        i = i + 1
    }

    // PERF: prime the module-frame 64-bucket index now that the pre-pass has
    // published every module def — the main pass's per-ident _lookup_in_scope
    // probes it instead of the O(M) backward scan.
    _lr_ast_prime_globals(module_sc)

    // Main pass: lower each item using the populated module scope.
    let mut hitems: [HItem] = []
    let mut k = 0
    while k < len(module.items) {
        let it = module.items[k]
        // Type-alias carriers emit nothing (resolved away in the types pass).
        if item_is_type_alias(it) {
            k = k + 1
            continue
        }
        let def = item_defs[k]
        let h = _lower_item(it, def, atlas, module_sc)
        hitems.push(h)
        k = k + 1
    }

    return HModule {
        file: module.file,
        items: hitems
    }
}
