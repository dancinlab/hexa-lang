// HEXA Native Compiler — drill identity-discovery engine (binary-absorbed)
//
// @version 0.1.0
// @capabilities [pure]
//
// The REAL exact-integer discover→verify→absorb core, absorbed natively into
// the compiler binary (NOT a python script in state/, NOT a flag-gated path).
// This is what `hexa drill`/`kick` verifies WITH by default: a candidate
// arithmetic-function identity A·B = C·D over the 12-fn basis is confirmed
// only if exact-integer evaluation over n∈[2,N] yields a bounded-unique
// solution set (singleton, n≥4 — degenerate n=2,3 excluded). This replaces
// the seed-hash heuristic (and the original NEXUS ouroboros verify_score,
// which was n6-proximity numerology that scored every candidate ≥0.3).
//
// 12-fn basis — exact-int, reference-matched to the verified ATLAS harvest
// (ATLAS/state/novel-dfs/blue_harvest_12fn.py:12-21, itself cite Hardy&Wright
// §16.7 / Conway&Sloane). Per-n trial-division factorization (no float path),
// so results are byte-deterministic across targets.
//
// Honesty (c2): a confirmed identity is BOUNDED-UNIQUE (🟩, exact over [2,N]) —
// the forall-n statement stays UNPROVEN until a proof lands. The standard-
// vocabulary relation space is MEASURED-EXHAUSTED (ATLAS/README.md DFS r1–r4:
// 1557 @F already folded, novel-fold = 0, gates 21/21) — this engine
// reproduces that terminal honestly; it does NOT fabricate new laws.

// ── integer power (exact) ──
fn ipow(base, e) -> int {
    let r = 1
    let i = 0
    while i < e {
        r = r * base
        i = i + 1
    }
    r
}

// ── smallest prime factor of m (trial division) ──
fn spf(m) -> int {
    if m % 2 == 0 { return 2 }
    let p = 3
    while p * p <= m {
        if m % p == 0 { return p }
        p = p + 2
    }
    m
}

// ── 12-fn basis, each via exact factorization of n ──
// key ids: 0=sigma 1=sigma2 2=sigma3 3=phi 4=tau 5=n 6=sopfr 7=rad 8=J2 9=psi 10=Om 11=om
fn af(n, which) -> int {
    if n == 1 {
        if which == 6 { return 0 }   // sopfr(1)=0
        if which == 10 { return 0 }  // Omega(1)=0
        if which == 11 { return 0 }  // omega(1)=0
        return 1                     // sigma/sig2/sig3/phi/tau/n/rad/J2/psi at 1 = 1
    }
    let m = n
    let sig = 1
    let sig2 = 1
    let sig3 = 1
    let tau = 1
    let phi = 1
    let psi = 1
    let j2 = 1
    let sopfr = 0
    let rad = 1
    let om_big = 0
    let om_small = 0
    while m > 1 {
        let p = spf(m)
        let e = 0
        while m % p == 0 {
            m = m / p
            e = e + 1
        }
        sig = sig * ((ipow(p, e + 1) - 1) / (p - 1))
        sig2 = sig2 * ((ipow(p, 2 * (e + 1)) - 1) / (ipow(p, 2) - 1))
        sig3 = sig3 * ((ipow(p, 3 * (e + 1)) - 1) / (ipow(p, 3) - 1))
        tau = tau * (e + 1)
        phi = phi * (ipow(p, e - 1) * (p - 1))
        psi = psi * (ipow(p, e - 1) * (p + 1))
        j2 = j2 * (ipow(p, 2 * e) - ipow(p, 2 * (e - 1)))
        sopfr = sopfr + p * e
        rad = rad * p
        om_big = om_big + e
        om_small = om_small + 1
    }
    if which == 0 { return sig }
    if which == 1 { return sig2 }
    if which == 2 { return sig3 }
    if which == 3 { return phi }
    if which == 4 { return tau }
    if which == 5 { return n }
    if which == 6 { return sopfr }
    if which == 7 { return rad }
    if which == 8 { return j2 }
    if which == 9 { return psi }
    if which == 10 { return om_big }
    return om_small
}

// ── exact-int identity verify: first solution n of af(a)·af(b)==af(c)·af(d)
//    over [2,N], plus a count cap. bounded-unique ⟺ exactly one solution ≥4. ──
// Returns: first solution n (0 if none) when solution count==1 and n>=4,
//          -1 if non-unique (count>1 or universal), -2 if no solution.
fn verify_identity(a, b, c, d, N) -> int {
    let first = 0
    let count = 0
    let n = 2
    while n <= N {
        if af(n, a) * af(n, b) == af(n, c) * af(n, d) {
            count = count + 1
            if count == 1 { first = n }
            if count > 1 { return -1 }
        }
        n = n + 1
    }
    if count == 0 { return -2 }
    if first >= 4 { return first }
    return -1
}

// ── selftest: prove the absorbed engine is a REAL verifier (not rubber-stamp).
//    G-gates rediscover known ATLAS @F identities (bounded-unique @ n=4);
//    C-controls must be rejected (universal / no-solution). ──
fn gate(label, got, want) -> int {
    if got == want {
        println("  [PASS] " + label + "  -> n=" + to_string(got))
        return 0
    }
    println("  [FAIL] " + label + "  -> got " + to_string(got) + " want " + to_string(want))
    return 1
}

fn main() {
    let N = 20000
    println("=== identity_engine SELFTEST (native exact-int, N=" + to_string(N) + ") ===")
    let fails = 0
    println("SANITY GATES (ATLAS @F rediscovery, bounded-unique @ n=4):")
    // G1 phi*J2 = n*psi   (3,8 = 5,9)
    fails = fails + gate("G1 phi*J2 = n*psi", verify_identity(3, 8, 5, 9, N), 4)
    // G2 phi*J2 = sopfr*psi  (3,8 = 6,9)
    fails = fails + gate("G2 phi*J2 = sopfr*psi", verify_identity(3, 8, 6, 9, N), 4)
    // G3 sigma*psi = sig2*phi  (0,9 = 1,3)  [verified-id-sigma-psi-eq-sig2-phi-n4]
    fails = fails + gate("G3 sigma*psi = sig2*phi", verify_identity(0, 9, 1, 3, N), 4)
    println("NEGATIVE CONTROLS (must be rejected = -1 universal / -2 none):")
    // C1 n*n = n*n  universal -> -1
    fails = fails + gate("C1 n*n = n*n (universal)", verify_identity(5, 5, 5, 5, N), -1)
    // C2 phi*phi = sigma*sigma  no solution expected -> -2 (or -1)
    let c2 = verify_identity(3, 3, 0, 0, N)
    if c2 < 0 {
        println("  [PASS] C2 phi*phi = sigma*sigma (rejected)  -> " + to_string(c2))
    } else {
        println("  [FAIL] C2 phi*phi = sigma*sigma should reject  -> n=" + to_string(c2))
        fails = fails + 1
    }
    println("")
    if fails == 0 {
        println("RESULT: PASS - native exact-int identity verifier absorbed into binary")
        exit(0)
    }
    println("RESULT: FAIL (" + to_string(fails) + ")")
    exit(1)
}
