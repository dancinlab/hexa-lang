// HEXA Native Compiler — Phase 3 drill spine: A9 main central engine
//
// @version 0.1.0
// @capabilities [fs_read, fs_write, env_read, stderr, stdout]
//
// Absorbs cmd_drill from ~/core/nexus/cli/run.hexa (lines 3087-3959,
// ~870 LOC + helpers). The drill is nexus's central discovery engine —
// a round loop where each round runs the six-stage chain
//
//   smash → free → absolute → meta-closure → hyperarithmetic → resonance
//
// and accumulates absorptions until saturation (round yield = 0) or
// max-rounds. Mk.X (engine="mk10") adds stage 6 transcendental_closure
// via a sidecar (compiler/drill/mkx.hexa) ported from nexus's
// shared/engine/mkx_engine.hexa. AN11 governance scanner side is NOT
// ported per doctrine v2 룰 3; the AN11 soft internal gate (math) is.
//
// Doctrine v2 룰 5 write policy:
//   • Each round's discoveries are flushed via overlay_append_lines to
//     <hx_data_dir>/atlas.overlay.n6 (the single runtime overlay file).
//   • Atlas lookups in subsequent rounds see the prior overlay through
//     atlas_lookup_merged / atlas_list_merged.
//   • Checkpoint state (round counter / seed pool / total) goes to a
//     separate file <hx_data_dir>/drill_checkpoint.json — small, JSON,
//     NOT mixed with the discovery stream.
//   • hx_data_dir defaults to $HOME/.hx/data and is overridable via
//     HX_DATA_DIR (multi-tenant isolation; see compiler/atlas/overlay
//     ::hx_data_dir).
//
// Public surface:
//   pub struct DrillResult { rounds, total, saturated, ... }
//   pub fn drill_run(seed, opts) -> DrillResult
//
// Catalog/diagnostic strings: ENGLISH ONLY.

use "compiler/drill/round"
use "compiler/drill/checkpoint"
use "compiler/drill/anti_hub"
use "compiler/drill/emerge"
use "compiler/smash/candidate"
use "compiler/honesty/check"
use "compiler/atlas/identity_engine"

pub struct DrillOpts {
    max_rounds: i64,
    depth_smash: i64,
    depth_free: i64,
    depth_res: i64,
    engine: string,            // "mk9" (default) | "mk10"
    resume_on: bool,           // true → load checkpoint on start (renamed: 'resume' is a hexa keyword)
    fresh: bool,               // --fresh / --no-resume
    speculate: i64,            // N-way speculative branches (1 = none)
    problem: string,           // "" or one of riemann|bsd|hodge|...
    quiet: bool,               // suppress per-round println (smoke uses true)
    // ── Pluggable verifier hook (resolves archive/patches/
    //    phanes-pluggable-verifier-oracle-for-drill-loop.md) ────────
    // Opt-in: when `verifier_cmd` is empty, behavior is byte-identical
    // to pre-hook drill (back-compat). When set, the command is invoked
    // once per round AFTER `_honesty_gate` and BEFORE checkpoint flush,
    // with a single-line JSON payload on stdin describing the round:
    //   {"round":N,"total":T,"smash":..,"free":..,"abs":..,"meta":..,
    //    "hyper":..,"res":..,"tc":..,"sigma":"...","seed":"...",
    //    "candidates":[{"id":..,"conf":..,"axiom":..,"src":..,"expr":..},..]}
    // "candidates" carries the round's discovery array (capped by
    // `verifier_cand_cap`) so the verifier can screen individual proposals
    // — e.g. a materials verifier feeds each `expr` to a QFORGE λ screen.
    // The command MUST print a single stdout line of the form
    //   verdict=pass|fail|continue [rationale=<inline-text>]
    // Any other output (or non-zero exit) is mapped to verdict=error.
    // `verifier_timeout_s` bounds the shell call (best-effort via the
    // `timeout` utility prefix when > 0; 0 = no bound). The verifier is
    // EXTERNAL / TENANT code — phanes is expected to sandbox it itself.
    verifier_cmd: string,             // "" = no verifier (default — back-compat)
    verifier_timeout_s: i64,          // 0 = unbounded
    verifier_authoritative: bool,     // true → pass/fail halts loop · false → advisory only
    // ── Surface-on-skip (resolves "candidates silently pooled, never
    //    emitted" — materials/non-math discovery): when NO verifier is
    //    installed (verifier_cmd == ""), the per-round verdict is "skip"
    //    and the chain's discoveries are flushed to the overlay but never
    //    shown to the user. `surface_top` > 0 emits the top-N ranked
    //    discovery candidates of each such round to stdout as ⚪ proposals
    //    (to-validate hypotheses — NEVER a verified verdict). 0 = off
    //    (legacy byte-identical behavior). Ranking REUSES the existing
    //    per-candidate `conf` signal (compiler/smash/candidate.hexa); no
    //    new scorer is introduced. Honesty (g6/g63): a surfaced row is a
    //    PROPOSAL, not a grading — it carries no pass/fail/formal tier.
    surface_top: i64,                 // 0 = off · N>0 = emit top-N ⚪ proposals on skip (default 8)
    // ── Verifier candidate-array feed (resolves the drill.hexa:142
    //    contract: "verifier should consult the discovery candidate
    //    array"). When a verifier IS installed, the round's discovery
    //    candidates are serialized under the payload's "candidates" key,
    //    capped at `verifier_cand_cap` per round to bound the single-line
    //    payload (a round can produce hundreds; the verifier consults the
    //    overlay file for the full set). 0 = omit (back-compat — the
    //    verifier receives "candidates":[]). Intended use: materials →
    //    QFORGE λ in-silico screen reads `expr` per candidate.
    verifier_cand_cap: i64            // 0 = omit array · N>0 = feed up to N candidates (default 64)
}

pub fn drill_default_opts() -> DrillOpts {
    return DrillOpts {
        max_rounds: 10,
        depth_smash: 3,
        depth_free: 3,
        depth_res: 1,
        engine: "mk9",
        resume_on: true,
        fresh: false,
        speculate: 1,
        problem: "",
        quiet: false,
        verifier_cmd: "",
        verifier_timeout_s: 0,
        verifier_authoritative: false,
        surface_top: 8,
        verifier_cand_cap: 64
    }
}

// Per-round verdict from the pluggable verifier. Recorded in the audit
// trail (stderr DRILL_VERIFIER line + a synthesized __BT_AI2__ sentinel
// alongside the existing BT-AI2 round line).
//   verdict ∈ {"pass", "fail", "continue", "skip", "error"}
//     - "pass"     — objective met (authoritative → halt with saturated=true)
//     - "fail"     — objective unmet & verifier wants to abort
//                    (authoritative → halt with saturated=false, verifier_stopped=true)
//     - "continue" — verifier still inconclusive, keep going
//     - "skip"     — no verifier installed (verifier_cmd == "")
//     - "error"    — verifier crashed / timed out / malformed output
//                    (NEVER halts — fail-open; loop continues per upstream policy)
pub struct VerifierVerdict {
    verdict: string,
    rationale: string,
    round: i64
}

pub struct DrillResult {
    rounds: i64,
    total: i64,
    saturated: bool,
    engine: string,
    overlay_lines: i64,
    yields_per_round: array,    // [smash_n, free_n, abs_n, meta_n, hyper_n, res_n] per round
    verifier_stopped: bool,     // true iff pluggable verifier halted the loop (pass or fail authoritative)
    verifier_verdict: string    // last verifier verdict ("" if no verifier installed)
}

// Validate the seed string. Mirrors cmd_drill's D2 guard: empty/too-short
// /placeholder seeds are rejected to fail-fast.
fn _validate_seed(seed: string) -> string {
    let t = seed.trim()
    if len(t) == 0 { return "empty" }
    if len(t) < 10 { return "too_short" }
    let lower = t.to_lower()
    if lower == "test" || lower == "hello" || lower == "abc"
       || lower == "foo" || lower == "bar" { return "placeholder" }
    return ""
}

// Resolve the engine id. Honors --engine flag, then HEXA_DRILL_ENGINE,
// then defaults to mk9.
fn _resolve_engine(flag: string) -> string {
    if flag == "mk10" || flag == "mk9" { return flag }
    let from_env = env("HEXA_DRILL_ENGINE")
    if from_env == "mk10" || from_env == "mk9" { return from_env }
    return "mk9"
}

// Minimal JSON-string escape — backslash, double-quote, and the control
// chars that would break a single-line JSON payload. Discovery exprs are
// free-form (s-expression-ish) so they CAN contain quotes; without this
// the candidate array would emit malformed JSON and the verifier's parse
// would fail. ASCII-oriented (the payload is single-line by construction).
fn _json_escape(s: string) -> string {
    let mut out = ""
    let mut i = 0
    while i < len(s) {
        let c = s.substring(i, i + 1)
        if c == "\\" { out = out + "\\\\" }
        else if c == "\"" { out = out + "\\\"" }
        else if c == "\n" { out = out + "\\n" }
        else if c == "\r" { out = out + "\\r" }
        else if c == "\t" { out = out + "\\t" }
        else { out = out + c }
        i = i + 1
    }
    return out
}

// Serialize up to `cap` discovery candidates as a JSON array. Each element
// is {id, conf, axiom, src, expr} — the per-candidate fields a verifier
// needs to screen the round's proposals (e.g. a materials verifier feeding
// `expr` into a QFORGE λ in-silico screen). `cap <= 0` → "[]" (the verifier
// opted out of the array; it may still consult the overlay file). The cap
// bounds the single-line payload size (a round can produce hundreds of
// candidates); the verifier consults the overlay file for the full set.
fn _candidates_json(cands: array, cap: i64) -> string {
    if cap <= 0 { return "[]" }
    let n = len(cands)
    let mut out = "["
    let mut i = 0
    let mut emitted = 0
    while i < n && emitted < cap {
        let c = cands[i]
        if len(c.id) > 0 {
            if emitted > 0 { out = out + "," }
            out = out + "{\"id\":\"" + _json_escape(c.id) + "\""
            out = out + ",\"conf\":" + to_string(c.conf)
            out = out + ",\"axiom\":" + (if c.axiom { "true" } else { "false" })
            out = out + ",\"src\":\"" + _json_escape(c.src) + "\""
            out = out + ",\"expr\":\"" + _json_escape(c.expr) + "\"}"
            emitted = emitted + 1
        }
        i = i + 1
    }
    out = out + "]"
    return out
}

// Build the single-line JSON payload handed to the pluggable verifier on
// stdin. Carries the round counter, total + per-stage yields, resonance
// sigma, seed echo — AND (per the drill.hexa:142 contract resolution) the
// round's discovery candidate array under "candidates", capped by
// `cand_cap`. A verifier that screens individual proposals (materials →
// QFORGE λ) reads "candidates"; a verifier that only watches aggregate
// round shape ignores it. `cand_cap <= 0` emits "candidates":[] (the
// pre-PR back-compat payload shape, plus an empty array key).
fn _verifier_payload(round: i64, seed: string, y: RoundYields, sigma: string,
                     cands: array, cand_cap: i64) -> string {
    let mut s = "{"
    s = s + "\"round\":" + to_string(round)
    s = s + ",\"total\":" + to_string(y.total)
    s = s + ",\"smash\":" + to_string(y.smash_n)
    s = s + ",\"free\":" + to_string(y.free_n)
    s = s + ",\"abs\":" + to_string(y.abs_n)
    s = s + ",\"meta\":" + to_string(y.meta_n)
    s = s + ",\"hyper\":" + to_string(y.hyper_n)
    s = s + ",\"res\":" + to_string(y.res_n)
    s = s + ",\"tc\":" + to_string(y.tc_n)
    s = s + ",\"sigma\":\"" + sigma + "\""
    s = s + ",\"seed\":\"" + _json_escape(seed) + "\""
    s = s + ",\"candidates\":" + _candidates_json(cands, cand_cap)
    s = s + "}"
    return s
}

// Parse a single-token "verdict=<x>" out of the verifier's stdout. We
// scan whitespace-separated tokens (mirrors __BT_AI2__ grammar) — first
// match wins, otherwise return "error" (malformed verifier output is
// the verifier's bug, not the drill's; fail-open per upstream policy).
fn _verifier_parse_verdict(raw: string) -> string {
    let t = raw.trim()
    if len(t) == 0 { return "error" }
    let toks = t.split(" ")
    let mut i = 0
    while i < len(toks) {
        let tk = to_string(toks[i]).trim()
        if len(tk) >= 8 && tk.substring(0, 8) == "verdict=" {
            let v = tk.substring(8, len(tk))
            if v == "pass" || v == "fail" || v == "continue" { return v }
            return "error"
        }
        i = i + 1
    }
    return "error"
}

// Optional "rationale=<text>" extraction — whitespace-terminated value
// per the documented grammar (multi-word rationale should be quoted by
// the verifier; we surface only the single-token form to keep parsing
// trivial and deterministic).
fn _verifier_parse_rationale(raw: string) -> string {
    let toks = raw.split(" ")
    let mut i = 0
    while i < len(toks) {
        let tk = to_string(toks[i]).trim()
        if len(tk) >= 10 && tk.substring(0, 10) == "rationale=" {
            return tk.substring(10, len(tk))
        }
        i = i + 1
    }
    return ""
}

// ── Native default verifier: exact-int identity_sweep ─────────────────
//
// When NO external verifier is installed (`verifier_cmd == ""`) the loop
// USED to short-circuit to verdict="skip" — the candidates were surfaced
// but never actually checked, contradicting the documented "default
// verification is ON" contract. The canonical (native, in-binary,
// exact-integer) verifier lives in `compiler/atlas/identity_engine.hexa`
// (`verify_identity`, the 12-fn A·B=C·D bounded-unique checker). This
// sweep wires it into the default path: every round's discovery candidates
// are scanned, any whose `expr` is in the 12-fn product-identity syntax is
// confirmed/refuted by exact-int evaluation over n∈[2,N], and the round
// gets a REAL verdict + counts (n_identity / n_verified / n_noise) — never
// "skip". The external python oracle stays opt-in via `--verifier <cmd>`
// (native-canonical polarity); the only opt-OUT is the explicit
// `HEXA_DRILL_NO_VERIFY=1` constraint.
//
// HONESTY (c2): the current generators (smash P2–P9) emit FLOAT-arithmetic
// permutation exprs (`evolve(v=… <- base×…)`, `a · b = …`), NOT the 12-fn
// `<fn>·<fn> = <fn>·<fn>` integer-identity syntax this engine consumes. So
// for the standard math vocabulary the honest result is n_identity=0 /
// n_verified=0 / n_noise=N → verdict "continue". That 0-verified report is
// the CORRECT, non-fabricating signal (a generator that produces identity-
// syntax candidates is the [B] generator-campaign scope); [A]'s job is only
// that the verifier RUNS and emits a real verdict instead of skipping.

// Map an 18-fn basis name to its `af()` index, or -1 if not a basis fn.
// Index ids match identity_engine.hexa::af (0=sigma … 11=omega · 12–17 = the
// 2026-06-27 extended vocab: mu μ · lam λ · mu2 μ² · J3 · tw_om 2^ω · core).
fn _fn_index(name: string) -> i64 {
    let s = name.trim()
    if s == "sigma"  { return 0 }
    if s == "sigma2" { return 1 }
    if s == "sigma3" { return 2 }
    if s == "phi"    { return 3 }
    if s == "tau"    { return 4 }
    if s == "n"      { return 5 }
    if s == "sopfr"  { return 6 }
    if s == "rad"    { return 7 }
    if s == "J2"     { return 8 }
    if s == "psi"    { return 9 }
    if s == "Omega"  { return 10 }
    if s == "omega"  { return 11 }
    // ── extended vocab (idx 12–17 · 2026-06-27 upgrade) ──
    if s == "mu"     { return 12 }
    if s == "lam"    { return 13 }
    if s == "mu2"    { return 14 }
    if s == "J3"     { return 15 }
    if s == "tw_om"  { return 16 }
    if s == "core"   { return 17 }
    return -1
}

// Parse a candidate `expr` as an 18-fn product identity `A*B = C*D` (also
// accepting the unicode `·` product / spaces). Returns the four basis
// indices via an out-array [a,b,c,d] when the whole expr is exactly four
// recognised basis fns (idx 0–17 incl. the 2026-06-27 extended vocab) joined
// by two products and one `=`, else []. Deterministic, structure-driven (no
// float parse). NOTE: arity-3 `A*B*C=D*E*F` candidates use a separate verify
// path (identity_engine.hexa::verify_identity3) and are not parsed here yet —
// this 2-term sweep stays the drill default screen.
fn _parse_identity(expr: string) -> [i64] {
    let mut e = expr
    e = e.replace("·", "*")
    e = e.replace(" ", "")
    let sides = e.split("=")
    let empty: [i64] = []
    if len(sides) != 2 { return empty }
    let lhs = to_string(sides[0]).split("*")
    let rhs = to_string(sides[1]).split("*")
    if len(lhs) != 2 || len(rhs) != 2 { return empty }
    let a = _fn_index(to_string(lhs[0]))
    let b = _fn_index(to_string(lhs[1]))
    let c = _fn_index(to_string(rhs[0]))
    let d = _fn_index(to_string(rhs[1]))
    if a < 0 || b < 0 || c < 0 || d < 0 { return empty }
    let mut out: [i64] = []
    out.push(a); out.push(b); out.push(c); out.push(d)
    return out
}

// Map an 18-fn `af()` index back to its basis name (inverse of _fn_index).
// Used to render a verified candidate's canonical identity expr for the
// cross-round absorb pool + the known/novel cross-check. "" if out of range.
fn _fn_name(idx: i64) -> string {
    if idx == 0  { return "sigma" }
    if idx == 1  { return "sigma2" }
    if idx == 2  { return "sigma3" }
    if idx == 3  { return "phi" }
    if idx == 4  { return "tau" }
    if idx == 5  { return "n" }
    if idx == 6  { return "sopfr" }
    if idx == 7  { return "rad" }
    if idx == 8  { return "J2" }
    if idx == 9  { return "psi" }
    if idx == 10 { return "Omega" }
    if idx == 11 { return "omega" }
    // ── extended vocab (idx 12–17 · 2026-06-27 upgrade) ──
    if idx == 12 { return "mu" }
    if idx == 13 { return "lam" }
    if idx == 14 { return "mu2" }
    if idx == 15 { return "J3" }
    if idx == 16 { return "tw_om" }
    if idx == 17 { return "core" }
    return ""
}

// Canonical product-identity string for four basis indices: "A*B = C*D".
// Side/factor order is normalized (each side's two factors sorted by index,
// then the two sides sorted) so commutative restatements collapse to one
// canonical key — this is what the absorb pool dedups on and what the
// known/novel cross-check compares.
fn _canon_identity(a: i64, b: i64, c: i64, d: i64) -> string {
    // sort factors within each side
    let mut l0 = a
    let mut l1 = b
    if l1 < l0 { let t = l0; l0 = l1; l1 = t }
    let mut r0 = c
    let mut r1 = d
    if r1 < r0 { let t = r0; r0 = r1; r1 = t }
    // order the two sides (lhs <= rhs by (first,second))
    let lhs_first = l0 < r0 || (l0 == r0 && l1 <= r1)
    let mut s = ""
    if lhs_first {
        s = _fn_name(l0) + "*" + _fn_name(l1) + " = " + _fn_name(r0) + "*" + _fn_name(r1)
    } else {
        s = _fn_name(r0) + "*" + _fn_name(r1) + " = " + _fn_name(l0) + "*" + _fn_name(l1)
    }
    return s
}

// Known-identity cross-check (honesty c2: the 12-fn 2-term `A·B=C·D` vein is
// MEASURED-EXHAUSTED — every bounded-unique product identity over THAT box is
// already an ATLAS @F node; the 2026-06-27 upgrade added extended vocab idx
// 12–17 + arity-3, and the extended-vocab universal sweep measured exactly 2
// clean generators, BOTH classical/definitional — see vocab_universal_hunt.py
// CLEAN_GENERATORS=2). The documented known set is the identity_engine selftest
// sanity-gate family (G1–G3 + their commutative twins) PLUS the classical
// extended-vocab universal generators (J₂=φ·ψ Jordan · core·rad=n definitional),
// all collapsed by _canon_identity. A verified candidate matching one of these
// is labelled `known`; anything else is `novel` (surfaced honestly, NEVER
// auto-folded — fold stays the `hexa verify` g5 / PR path). Compare on canon key.
fn _is_known_identity(canon: string) -> bool {
    // G1 phi*J2 = n*psi   (3,8 = 5,9)
    if canon == _canon_identity(3, 8, 5, 9) { return true }
    // G2 phi*J2 = sopfr*psi  (3,8 = 6,9)
    if canon == _canon_identity(3, 8, 6, 9) { return true }
    // G3 sigma*psi = sig2*phi  (0,9 = 1,3)
    if canon == _canon_identity(0, 9, 1, 3) { return true }
    // NOTE (2026-06-27 upgrade): the extended-vocab universal generators
    // (J₂=φ·ψ Jordan · core·rad=n definitional) are 1-vs-2 / definitional shapes,
    // NOT 2-term bounded-unique singletons, so they never reach this 2-term
    // known-set (a candidate in `<fn>·<fn>=<fn>·<fn>` syntax cannot encode them).
    // The universal-frame screen lives in identity_engine.hexa::is_universal2/3,
    // and that sweep measured novel=0 (every clean generator classical). Hence
    // this 2-term known set stays G1–G3 — any extended-vocab 2-term bounded-
    // unique a generator DOES emit is reported `novel` honestly (then hand-
    // triaged · fold stays hexa verify g5 / PR · never engine-written).
    return false
}

// One round's exact-int identity sweep, the cross-round-absorb form. In
// addition to the VerifierVerdict counts it COLLECTS the canonical exprs of
// every candidate that verified bounded-unique (n≥4) so the drill loop can
// feed them forward into the next round's smash axiom pool (the ouroboros
// "well-widening" mechanism — verified primitives expand the search space).
// `verified_exprs` is the out-array of canonical identity strings (deduped);
// `n_known` / `n_novel` split them against the documented known set.
pub struct AbsorbSweep {
    verdict: VerifierVerdict,
    verified_exprs: array,   // canonical "A*B = C*D" strings, deduped
    n_known: i64,
    n_novel: i64
}

fn _native_identity_sweep_absorb(round: i64, cands: array) -> AbsorbSweep {
    let N = 20000
    let n = len(cands)
    let mut n_identity = 0
    let mut n_verified = 0
    let mut n_noise = 0
    let mut n_known = 0
    let mut n_novel = 0
    let mut verified_exprs: array = []
    let mut i = 0
    while i < n {
        let c = cands[i]
        if len(c.id) > 0 {
            let idx = _parse_identity(c.expr)
            if len(idx) == 4 {
                n_identity = n_identity + 1
                let r = verify_identity(idx[0], idx[1], idx[2], idx[3], N)
                if r >= 4 {
                    n_verified = n_verified + 1
                    let canon = _canon_identity(idx[0], idx[1], idx[2], idx[3])
                    // dedup the verified-expr collection by canonical key
                    let mut dup = false
                    let mut k = 0
                    while k < len(verified_exprs) {
                        if to_string(verified_exprs[k]) == canon { dup = true; break }
                        k = k + 1
                    }
                    if !dup {
                        verified_exprs.push(canon)
                        if _is_known_identity(canon) { n_known = n_known + 1 }
                        else { n_novel = n_novel + 1 }
                    }
                }
            } else {
                n_noise = n_noise + 1
            }
        }
        i = i + 1
    }
    let mut verdict = "continue"
    if n_verified > 0 { verdict = "pass" }
    let rationale = "identity_sweep:identity=" + to_string(n_identity)
        + ",verified=" + to_string(n_verified)
        + ",noise=" + to_string(n_noise)
        + ",known=" + to_string(n_known)
        + ",novel=" + to_string(n_novel)
    let vv = VerifierVerdict { verdict: verdict, rationale: rationale, round: round }
    return AbsorbSweep {
        verdict: vv,
        verified_exprs: verified_exprs,
        n_known: n_known,
        n_novel: n_novel
    }
}

// Native exact-int identity sweep over one round's discovery candidates.
// Counts: n_identity (candidates in 12-fn identity syntax), n_verified
// (bounded-unique singleton n≥4 → a real confirmed identity), n_noise
// (candidates NOT in identity syntax — the honest classification for the
// float-permutation generators). Returns a VerifierVerdict whose verdict is
//   "pass"     — at least one candidate verified bounded-unique (n≥4), AND
//   "continue" — otherwise (nothing verified this round; keep exploring).
// The rationale string carries the machine-readable counts so the audit
// emit (`DRILL_VERIFIER` stderr line) shows the real numbers, never "skip".
// Thin wrapper over the absorb form (verdict-only callers ignore the
// verified-expr collection).
fn _native_identity_sweep(round: i64, cands: array) -> VerifierVerdict {
    return _native_identity_sweep_absorb(round, cands).verdict
}

// Invoke the verifier for one round.
//
// No external verifier installed (`verifier_cmd == ""`) → run the NATIVE
// default verifier (`_native_identity_sweep`, exact-int in-binary) so the
// round gets a real verdict ("pass"/"continue" + counts), honoring the
// "default verification is ON" contract. The native sweep is the canonical
// path; the only opt-OUT is the explicit `HEXA_DRILL_NO_VERIFY=1`
// constraint, which restores the legacy "skip" (pure surfacing, no
// verification). The pluggable external oracle stays opt-in via
// `--verifier <cmd>` (native-canonical polarity — external = constraint).
//
// External verifier installed → dispatch via the host shell with the round
// payload piped in on stdin; the verifier's first stdout line is the
// verdict line. Verifier crash / timeout / malformed output → "error"
// (NEVER halts — fail-open).
fn _verifier_run(opts: DrillOpts, round: i64, seed: string,
                  y: RoundYields, sigma: string, cands: array) -> VerifierVerdict {
    if len(opts.verifier_cmd) == 0 {
        // Opt-OUT constraint: HEXA_DRILL_NO_VERIFY=1 restores legacy skip.
        if env("HEXA_DRILL_NO_VERIFY") == "1" {
            return VerifierVerdict { verdict: "skip", rationale: "", round: round }
        }
        // Native-canonical default: exact-int identity sweep.
        return _native_identity_sweep(round, cands)
    }
    let payload = _verifier_payload(round, seed, y, sigma, cands, opts.verifier_cand_cap)
    // Wrap the verifier command with `timeout <N>s` when bounded — best
    // effort, requires the `timeout` utility on PATH (coreutils on
    // Linux, `gtimeout` on macOS Homebrew). When unavailable the call
    // still works without a wall-clock bound.
    let mut cmd = opts.verifier_cmd
    if opts.verifier_timeout_s > 0 {
        cmd = "timeout " + to_string(opts.verifier_timeout_s) + "s " + opts.verifier_cmd
    }
    // Pipe the payload on stdin via a here-doc style echo. We rely on
    // the runtime `exec_with_status` builtin (see self/env.hexa
    // BUILTINS) which returns the command's exit status; stdout is
    // delivered through stderr-tracking `exec` for capture. For
    // simplicity we route both through a single `sh -c` invocation
    // that captures stdout to a tempfile-backed env probe.
    let line = "printf %s " + _verifier_shquote(payload) + " | " + cmd
    let out = exec(line)
    let v = _verifier_parse_verdict(out)
    let r = _verifier_parse_rationale(out)
    return VerifierVerdict { verdict: v, rationale: r, round: round }
}

// ── Cross-round absorb (ouroboros well-widening) ──────────────────────
//
// The defining NEXUS-blowup mechanism (atlas/README.md ouroboros): a round's
// VERIFIED primitives are fed forward as additional axiom seeds into the NEXT
// round's blowup, widening the well so the next tick can surface what the
// prior could not. This is the cross-cycle loop that the engine measured-OPEN
// at 2026-06-27 (single-tick blowup was genuine; the absorb feed-forward was
// not live — rounds were independent → zero accumulation across cycles).
//
// `_verifier_run_absorb` is the absorb-aware verifier dispatch. It returns the
// full `AbsorbSweep` (verdict + the canonical exprs that verified bounded-
// unique this round + known/novel split). It runs ONLY on the native path
// (`verifier_cmd == ""` and not the HEXA_DRILL_NO_VERIFY opt-OUT): the absorb
// loop feeds forward exact-int VERIFIED primitives, which only the native
// `verify_identity` sweep produces. The external-oracle and opt-OUT-skip paths
// return an EMPTY absorb (no verified exprs to feed forward — the external
// oracle owns its own screen, and skip does no verification at all), so the
// loop degrades to the legacy seed-derived pool only.
//
// SAFE invariants (task guardrails):
//   ⓐ only VERIFIED (exact-int true, bounded-unique n≥4) exprs are absorbed —
//      noise is never fed forward (zero fabrication).
//   ⓑ in-memory ONLY — the absorbed pool lives in the drill_run call frame;
//      the embedded atlas is NEVER written (fold stays `hexa verify` g5 / PR).
//   ⓒ known/novel cross-check labels each verified expr against the documented
//      known set (honest novel reporting; 0 is reported as 0).
fn _verifier_run_absorb(opts: DrillOpts, round: i64, seed: string,
                         y: RoundYields, sigma: string, cands: array) -> AbsorbSweep {
    let empty: array = []
    if len(opts.verifier_cmd) == 0 && env("HEXA_DRILL_NO_VERIFY") != "1" {
        // Native-canonical default — the only path that produces verified
        // exprs to feed forward.
        return _native_identity_sweep_absorb(round, cands)
    }
    // External oracle OR opt-OUT skip — reuse the verdict-only dispatch and
    // wrap it in an empty absorb (nothing feeds forward).
    let vv = _verifier_run(opts, round, seed, y, sigma, cands)
    return AbsorbSweep { verdict: vv, verified_exprs: empty, n_known: 0, n_novel: 0 }
}

// Merge this round's verified exprs into the cumulative absorbed pool,
// deduping by canonical key. Returns the grown pool (returned, not mutated in
// place — same struct_pack shallow-clone aliasing caveat as the round loop's
// cum_seen_ids). `net_absorbed` is the count NEW this round.
pub struct AbsorbMerge {
    pool: array,
    net_absorbed: i64
}

fn _absorb_merge(pool: array, verified_exprs: array) -> AbsorbMerge {
    let mut out = pool
    let mut net = 0
    let mut i = 0
    while i < len(verified_exprs) {
        let e = to_string(verified_exprs[i])
        let mut dup = false
        let mut k = 0
        while k < len(out) {
            if to_string(out[k]) == e { dup = true; break }
            k = k + 1
        }
        if !dup { out.push(e); net = net + 1 }
        i = i + 1
    }
    return AbsorbMerge { pool: out, net_absorbed: net }
}

// Emit the cross-round absorb audit row (stderr DRILL_ABSORB). `verified` =
// verified exprs THIS round, `net` = newly absorbed into the cumulative pool,
// `cum` = cumulative pool size carried into the NEXT round, known/novel split.
fn _absorb_audit_emit(round: i64, verified: i64, net: i64, cum: i64,
                      known: i64, novel: i64) -> void {
    let mut msg = "DRILL_ABSORB {"
    msg = msg + "\"round\":" + to_string(round)
    msg = msg + ",\"verified\":" + to_string(verified)
    msg = msg + ",\"net_absorbed\":" + to_string(net)
    msg = msg + ",\"cum_pool\":" + to_string(cum)
    msg = msg + ",\"known\":" + to_string(known)
    msg = msg + ",\"novel\":" + to_string(novel)
    msg = msg + "}"
    eprintln(msg)
}

// ── Surface-on-skip: emit top-N ⚪ proposals ──────────────────────────
//
// When no verifier is installed (verdict == "skip"), the round's
// discovery candidates are flushed to the overlay but never shown to the
// user — a materials/non-math seed produces hundreds of ideas that stay
// invisible. `_surface_proposals` ranks the round's discoveries by the
// EXISTING per-candidate confidence signal (`conf`, see
// compiler/smash/candidate.hexa — heuristic confidence in [0,1]) and
// prints the top-N to stdout, each tagged `⚪ proposal`. This is PURE
// SURFACING:
//   • the tier is ALWAYS ⚪ proposal (to-validate) — NEVER pass / fail /
//     SUPPORTED / GATE / formal. A surfaced row is a hypothesis, not a
//     verdict (g6/g63 honesty — no fabricated grading).
//   • ranking REUSES `conf`; no new scorer is invented.
// Returns the count of proposals actually emitted (≤ top_n, ≤ #cands).

// Exploration tier of a discovery candidate (1 = search product, 0 =
// trivial seed-echo / pool axiom). The pre-fix surfacing ranked purely by
// `conf`, and `phases.hexa::p2_evolve` mints the literal-seed axiom
// (`smash:P2:seed`) and the per-token signature axioms (`smash:P2:seedtok`)
// at the MAXIMUM confidence (`mk_axiom` → conf=1.0). Every search PRODUCT
// (the P2 evolve mutants, plus the P3–P9 derived corollaries) carries a
// SMALLER spread-based conf, so the top-N was monopolised by the seed echo
// and the per-token pool — the very candidates that just restate the input.
// That hid the free-search mutants (the actual exploration output) and was
// the surfacing-side mask for the n=6 hardwire bug fixed in #4008. We split
// the rank into two tiers so a search product ALWAYS outranks a trivial seed
// echo regardless of conf; within a tier the existing conf/axiom/index order
// is preserved (fully deterministic).
//   tier 0 — `smash:P2:seed` (whole-seed echo) and `smash:P2:seedtok`
//            (per-token signature axioms): pure restatements of the seed.
//   tier 1 — everything else: P2 evolve mutants + P3–P9 derived corollaries
//            (the resonance/closure/transfer/dual/… search products).
fn _explore_tier(c) -> i64 {
    let s = c.src
    if len(s) >= 13 && s.substring(0, 13) == "smash:P2:seed" { return 0 }
    return 1
}

// Selection-rank the discovery candidates and emit the first `top_n`. The
// primary key is the EXPLORATION TIER (search products over trivial seed
// echoes — see `_explore_tier`); within a tier we rank by descending `conf`
// (per-candidate heuristic confidence, compiler/smash/candidate.hexa) and
// break ties axiom>derived, then by earlier insertion index. We use a
// bounded selection pass (O(top_n · N)) rather than a full sort — top_n is
// small (default 8) and N can be large (a round can produce hundreds of
// candidates), so repeatedly extracting the current best is cheaper than
// sorting the whole array and keeps the emission order deterministic.
fn _surface_proposals(round: i64, cands: array, top_n: i64, quiet: bool) -> i64 {
    if top_n <= 0 { return 0 }
    let n = len(cands)
    if n == 0 { return 0 }
    // `picked[i] == true` once candidate i has been emitted.
    let mut picked: array = []
    let mut p = 0
    while p < n { picked.push(false); p = p + 1 }

    let mut emitted: i64 = 0
    if !quiet {
        println("  ⚪ proposals (round " + to_string(round)
            + ", top " + to_string(top_n) + " of " + to_string(n)
            + " — search-product-first · ranked by conf · to-validate, NOT verified):")
    }
    while emitted < top_n {
        // Find the best not-yet-picked candidate. Key: tier desc (search
        // product > seed echo), then conf desc, then axiom>derived, then
        // earlier insertion index (deterministic).
        let mut best: i64 = -1
        let mut best_tier: i64 = -1
        let mut best_conf: f64 = -1.0
        let mut best_axiom = false
        let mut i = 0
        while i < n {
            if !picked[i] {
                let c = cands[i]
                let t = _explore_tier(c)
                let better_tier = t > best_tier
                let same_tier = t == best_tier
                let better_conf = same_tier && c.conf > best_conf
                let tie_axiom = same_tier && c.conf == best_conf && c.axiom && !best_axiom
                if best < 0 || better_tier || better_conf || tie_axiom {
                    best = i
                    best_tier = t
                    best_conf = c.conf
                    best_axiom = c.axiom
                }
            }
            i = i + 1
        }
        if best < 0 { break }   // nothing left to pick
        picked[best] = true
        let c = cands[best]
        // ⚪ proposal line — tier label is literally "proposal" (to-validate).
        // Format: rank · id · conf · src · expr (truncated for one line).
        let mut expr_short = c.expr
        if len(expr_short) > 72 { expr_short = expr_short.substring(0, 72) + "…" }
        let line = "    ⚪ proposal #" + to_string(emitted + 1)
            + " [conf=" + to_string(c.conf) + "]"
            + " " + c.id
            + " (" + c.src + "): " + expr_short
        println(line)
        emitted = emitted + 1
    }
    return emitted
}

// Minimal POSIX shell single-quote escape — wraps `s` in single quotes
// and escapes any embedded single quote as '\''. Sufficient for the
// JSON payload (which is ASCII-safe by construction in _verifier_payload).
fn _verifier_shquote(s: string) -> string {
    let mut out = "'"
    let mut i = 0
    while i < len(s) {
        let c = s.substring(i, i + 1)
        if c == "'" {
            out = out + "'\\''"
        } else {
            out = out + c
        }
        i = i + 1
    }
    out = out + "'"
    return out
}

// Emit a verifier verdict as an audit-trail row — stderr DRILL_VERIFIER
// line PLUS a synthesized __BT_AI2__ sentinel into the audit text so a
// downstream `bt_ai2_audit` call observes the verifier verdict alongside
// the BT-AI2 round line. The BT-AI2 mapping treats verdict="pass" as
// claim=PASS (loss==expected, no F-AI2-A) and verdict="fail" as
// claim=FAIL (loss==expected, no F-AI2-B); "continue" / "skip" / "error"
// skip the sentinel emit (no claim to audit).
fn _verifier_audit_emit(v: VerifierVerdict) -> void {
    let mut msg = "DRILL_VERIFIER {"
    msg = msg + "\"round\":" + to_string(v.round)
    msg = msg + ",\"verdict\":\"" + v.verdict + "\""
    if len(v.rationale) > 0 {
        msg = msg + ",\"rationale\":\"" + v.rationale + "\""
    }
    msg = msg + "}"
    eprintln(msg)
    if v.verdict == "pass" || v.verdict == "fail" {
        let claim = if v.verdict == "pass" { "PASS" } else { "FAIL" }
        let mut sentinel = "__BT_AI2__ label=verifier_round_" + to_string(v.round)
        sentinel = sentinel + " claim=" + claim
        sentinel = sentinel + " loss=1.0 expected=1.0"
        eprintln(sentinel)
    }
}

// Honesty gate — run BT-AI2 audit over the per-round yields encoded as
// __BT_AI2__ sentinel lines. The audit is advisory: a non-zero
// f_a/f_b count triggers stderr warning but does NOT halt drill (the
// upstream pattern; saturation is the hard stop).
fn _honesty_gate(round: i64, y: RoundYields) -> void {
    // We synthesize the audit line from the round's resonance stage
    // (the noisiest one). loss/expected here are heuristic — the gate
    // surface is what we want to exercise in this absorbed form.
    let claim = if y.res_n > 0 { "PASS" } else { "FAIL" }
    let mut line = "__BT_AI2__ label=round_" + to_string(round)
    line = line + " claim=" + claim
    line = line + " loss=" + to_string(y.res_n)
    line = line + " expected=" + to_string(y.res_n)
    let verdict = bt_ai2_audit(line)
    // NOTE: the audit struct exposes the falsifier counts as `f_ai2_a` /
    // `f_ai2_b` (compiler/honesty/check.hexa::Bt2Verdict). A stale
    // `verdict.f_a` / `verdict.f_b` read here is a latent field-name
    // mismatch (both names landed together in #634) — harmless on the
    // older runtime that returned a default for a missing map key, but a
    // hard `map key 'f_a' not found` abort on the current runtime, which
    // tripped the round-1 honesty gate before any multi-round loop body
    // could run. We read the real fields; the external JSON keys stay
    // `f_a`/`f_b` (documented audit-trail surface).
    if verdict.f_ai2_a > 0 || verdict.f_ai2_b > 0 {
        eprintln("DRILL_HONESTY {\"round\":" + to_string(round)
            + ",\"f_a\":" + to_string(verdict.f_ai2_a)
            + ",\"f_b\":" + to_string(verdict.f_ai2_b) + "}")
    }
}

// Run a single seed under drill. Honors resume from checkpoint.
pub fn drill_run(seed: string, opts: DrillOpts) -> DrillResult {
    let err = _validate_seed(seed)
    if len(err) > 0 {
        eprintln("drill: --seed rejected (" + err + ") — provide a substantive problem statement (>=10 chars, not placeholder)")
        return DrillResult {
            rounds: 0,
            total: 0,
            saturated: false,
            engine: opts.engine,
            overlay_lines: 0,
            yields_per_round: [],
            verifier_stopped: false,
            verifier_verdict: ""
        }
    }

    // Anti-hub telemetry probe at drill entry.
    anti_hub_probe_emit()

    let engine = _resolve_engine(opts.engine)
    let mkx_on = engine == "mk10"

    if !opts.quiet {
        println("drill — seed='" + seed + "' max_rounds=" + to_string(opts.max_rounds) + " engine=" + engine)
        if mkx_on {
            println("  Mk.X 7-stage (smash → free → absolute → meta → hyper → resonance → transcendental_closure)")
        } else {
            println("  Mk.IX 6-stage chain (smash → free → absolute → meta → hyper → resonance)")
        }
    }

    // Resume support.
    //
    // `round` is the cumulative round counter (1-indexed, includes any
    // rounds restored from a checkpoint). `rounds_this_call` is the
    // per-invocation budget — bounded by `opts.max_rounds` regardless of
    // whether we resumed mid-stream. This decouples the user-visible
    // `--rounds N` flag from the historical round counter so that:
    //
    //   • a fresh `hexa drill --rounds 10` always runs 10 rounds, and
    //   • a resumed call (cp.round == 5) with `--rounds 10` runs 10 MORE
    //     rounds (ending at cumulative round 15), not just 5.
    //
    // Pre-fix: the loop guard `while round < opts.max_rounds` mis-treated
    // `max_rounds` as a cumulative cap, so a resume from round 5 with
    // `--rounds 10` only executed rounds 6-10 (5 rounds, not 10) — and
    // resuming from cp.round >= max_rounds executed 0 rounds.
    let mut round: i64 = 0
    let mut total: i64 = 0
    let mut yields_log: array = []
    let mut overlay_lines: i64 = 0
    let mut saturated = false
    let mut verifier_stopped = false
    let mut verifier_last_verdict: string = ""
    let mut resumed_from: i64 = 0   // cumulative round at resume entry (0 = fresh)

    if opts.fresh {
        checkpoint_clear()
    } else if opts.resume_on {
        let cp = checkpoint_load(seed)
        if cp.found {
            round = cp.round
            total = cp.total
            resumed_from = cp.round
            if !opts.quiet {
                println("  [resume] seed_hash=" + cp.seed_hash + " round=" + to_string(round) + " total=" + to_string(total))
            }
        }
    }

    // Cumulative seed pool. Round 1 receives an empty pool; subsequent
    // rounds receive the axiom-exprs harvested from the prior round's
    // discoveries (Doctrine v2 룰 5 — drill discoveries seed the next
    // round, not just the overlay). The pool is bounded inside
    // round_run_with_pool by K_POOL.
    let mut seed_pool: array = []

    // ── Cross-round absorb pool (ouroboros well-widening) ──────────────
    // The cumulative set of canonical exprs that VERIFIED bounded-unique in
    // any prior round (exact-int identity_engine verdict). Each round's
    // verified primitives are merged here and fed FORWARD as additional
    // axiom seeds into the NEXT round's smash blowup — the defining NEXUS
    // ouroboros loop. In-memory ONLY (never written to the embedded atlas;
    // fold stays `hexa verify` g5 / PR). Empty until a round verifies
    // something — for the standard 12-fn vocab this stays [] (measured-
    // exhausted; the honest novel=0 report), but the MECHANISM is now live:
    // any round that verifies an identity widens round N+1's well.
    let mut absorbed_pool: array = []

    // ── [B] Open-well Emerge vocab (ouroboros well-widening, README:75) ──
    // The cumulative integer "open well" the Emerge step grows each round by
    // COMBINING absorbed primitives into new structure the prior cycle could
    // not express (archive-nexus/README.md:83/115 — "open well … every Absorb
    // step widens the wall"). Seeded round 1 from V_0 {2,3} + the round's
    // discovery candidate value signatures; each subsequent round it widens
    // further (emerge_step). The frozen-LLM contrast (vocab fixed at the seed
    // set) is reported alongside per round so the open-vs-frozen claim is
    // MEASURED, not asserted. In-memory ONLY (never written to the embedded
    // atlas; fold stays `hexa verify` g5 / PR). The decisive falsifiable spec
    // (E4 — V_0={2,3}, 300 cycles, growth >= 50) is the `emerge` selftest
    // (compiler/drill/emerge_test.hexa); this production wiring runs a bounded
    // per-round step so the well grows across the drill loop.
    let mut emerge_well: array = []

    // C5 novelty-fixpoint state. The cumulative distinct-id set spans the
    // whole invocation; _flush_discoveries_cum dedups against it and reports
    // `net_novel` (ids new THIS round). A round adding zero net-novel
    // discoveries means the discovery space is exhausted → saturate. This
    // is the real saturation signal: the gross `total == 0` test never fires
    // (the resonance proxy + deterministic primary-seed smash always yield
    // > 0), so without it `--rounds N` always burns all N rounds re-emitting
    // the same set (measured pre-fix: 6 rounds → 6072 overlay lines but only
    // 1111 distinct ids — net-novel was 0 from round 3 on).
    let mut cum_seen_ids: array = []

    let mut rounds_this_call: i64 = 0
    while rounds_this_call < opts.max_rounds {
        round = round + 1
        rounds_this_call = rounds_this_call + 1
        let rr = round_run_with_pool(seed, round, opts.depth_smash, opts.depth_free,
                                      opts.depth_res, mkx_on, seed_pool, cum_seen_ids)
        cum_seen_ids = rr.cum_seen_ids
        if !opts.quiet {
            println(round_yields_line(round, rr.yields, rr.sigma_best))
            println("  overlay+ " + to_string(rr.overlay_lines_emitted) + " lines"
                + " (pool=" + to_string(len(seed_pool)) + ")")
        }
        overlay_lines = overlay_lines + rr.overlay_lines_emitted
        total = total + rr.yields.total
        yields_log.push([rr.yields.smash_n, rr.yields.free_n, rr.yields.abs_n,
                          rr.yields.meta_n, rr.yields.hyper_n, rr.yields.res_n])

        // Refresh seed pool for the next round — axiom-exprs from this
        // round's union discovery set. extract_axiom_exprs already dedupes
        // by expr; K_POOL caps consumption inside round_run_with_pool.
        seed_pool = extract_axiom_exprs(rr.discoveries)

        // honesty gate (advisory)
        _honesty_gate(round, rr.yields)

        // ── pluggable verifier hook (resolves phanes-pluggable-verifier-
        //    oracle-for-drill-loop.md) ───────────────────────────────
        // No-op when opts.verifier_cmd == "" — back-compat preserved.
        // When installed, the verifier sees the round's yields + total
        // + sigma + seed; its verdict can authoritatively halt the loop.
        // verdict=pass → loop halts with saturated=true (objective met).
        // verdict=fail → loop halts with saturated=false and
        //                verifier_stopped=true (objective unmet, abort).
        // verdict=continue / skip / error → advisory only; loop proceeds.
        // The verdict is always logged (DRILL_VERIFIER stderr line) and,
        // for pass/fail, emitted as a __BT_AI2__ sentinel so a subsequent
        // bt_ai2_audit observes it alongside the existing BT-AI2 row.
        let sweep = _verifier_run_absorb(opts, round, seed, rr.yields, rr.sigma_best, rr.discoveries)
        let vv = sweep.verdict
        _verifier_audit_emit(vv)
        verifier_last_verdict = vv.verdict

        // ── cross-round absorb feed-forward (ouroboros well-widening) ──
        // Merge THIS round's exact-int VERIFIED primitives into the
        // cumulative absorbed pool, then feed that pool FORWARD into the
        // next round's smash axiom seeds (in addition to the seed-derived
        // pool refreshed just above). Round N+1's blowup therefore explores
        // the space *widened* by round N's verified discoveries — the loop
        // is now closed. SAFE: only verified (exact-int true) exprs are
        // absorbed (zero fabrication); in-memory only (no atlas write).
        let am = _absorb_merge(absorbed_pool, sweep.verified_exprs)
        absorbed_pool = am.pool
        _absorb_audit_emit(round, len(sweep.verified_exprs), am.net_absorbed,
                           len(absorbed_pool), sweep.n_known, sweep.n_novel)
        // Append the cumulative verified-primitive pool to the next round's
        // seeds. extract_axiom_exprs already populated `seed_pool` with this
        // round's axiom exprs; we add the absorbed verified exprs on top
        // (dedup not required — the round's K_POOL bound + smash dedup absorb
        // repeats harmlessly, and the two streams are disjoint by construction:
        // seed_pool = float-permutation axioms, absorbed_pool = canonical
        // identity exprs).
        let mut ap = 0
        while ap < len(absorbed_pool) {
            seed_pool.push(to_string(absorbed_pool[ap]))
            ap = ap + 1
        }

        // ── [B] Emerge step (open-well well-widening · README:75) ─────
        // After Absorb feeds verified primitives forward, the Emerge step
        // COMBINES the round's absorbed primitives into NEW structure the
        // prior cycle had no primitive for (archive-nexus/README.md:75/83/
        // 115). We grow the cumulative integer open well from this round's
        // discovery candidate value signatures and emit a DRILL_EMERGE audit
        // row contrasting the open well (grows) with the frozen-LLM vocab
        // (fixed at the seed set {2,3} → size 2 — never grows). SAFE: in-
        // memory only (no atlas write); deterministic (byte-eq preserved).
        let es = emerge_step(emerge_well, round, rr.discoveries)
        emerge_well = es.vocab
        emerge_audit_emit(round, es.net_walls, es.vocab_size, 2)

        // ── surface proposals (no external oracle) ───────────────────
        // No EXTERNAL verifier installed (verifier_cmd == "" → native sweep
        // or opt-OUT skip) → the round's discoveries would otherwise vanish
        // into the overlay unseen. Emit the top-N ranked candidates as ⚪
        // proposals (to-validate hypotheses, NOT verdicts; the native sweep
        // verdict is a separate DRILL_VERIFIER line). Off when surface_top
        // == 0 (legacy). When an external oracle screens (verifier_cmd set)
        // it owns the candidate stream, so surfacing stays suppressed.
        if len(opts.verifier_cmd) == 0 && opts.surface_top > 0 {
            _surface_proposals(round, rr.discoveries, opts.surface_top, opts.quiet)
        }

        if opts.verifier_authoritative {
            if vv.verdict == "pass" {
                verifier_stopped = true
                saturated = true
                if !opts.quiet {
                    println("  VERIFIER_PASS at round " + to_string(round) + " — objective met")
                }
                checkpoint_save(seed, round, total, yields_log, engine)
                break
            }
            if vv.verdict == "fail" {
                verifier_stopped = true
                if !opts.quiet {
                    println("  VERIFIER_FAIL at round " + to_string(round) + " — objective rejected by verifier")
                }
                checkpoint_save(seed, round, total, yields_log, engine)
                break
            }
        }

        // checkpoint flush per round
        checkpoint_save(seed, round, total, yields_log, engine)

        // saturation (gross): a round with zero total signals exhaustion.
        if rr.yields.total == 0 {
            saturated = true
            if !opts.quiet {
                println("  SATURATED at round " + to_string(round) + " — total absorptions=" + to_string(total))
            }
            break
        }

        // saturation (C5 net-novel fixpoint): a round that contributed zero
        // NEW distinct discoveries vs the cumulative union of all prior
        // rounds. Round 1 always has net_novel > 0 (everything is new), so
        // this only trips at round >= 2 when the discovery space is exhausted
        // — the loop is at a fixpoint and further rounds only re-emit dups.
        if round >= 2 && rr.net_novel == 0 {
            saturated = true
            if !opts.quiet {
                println("  SATURATED (net-novel fixpoint) at round " + to_string(round)
                    + " — distinct discoveries=" + to_string(len(cum_seen_ids)))
            }
            break
        }
    }

    // Clean-up checkpoint on normal exit (saturated OR max-rounds)
    checkpoint_clear()

    if !opts.quiet {
        if !saturated {
            if resumed_from > 0 {
                println("  max rounds reached (" + to_string(opts.max_rounds)
                    + " this call · cumulative round " + to_string(round)
                    + " from resume at " + to_string(resumed_from) + ") — total=" + to_string(total))
            } else {
                println("  max rounds reached (" + to_string(opts.max_rounds) + ") — total=" + to_string(total))
            }
        }
    }

    return DrillResult {
        rounds: round,
        total: total,
        saturated: saturated,
        engine: engine,
        overlay_lines: overlay_lines,
        yields_per_round: yields_log,
        verifier_stopped: verifier_stopped,
        verifier_verdict: verifier_last_verdict
    }
}

// ── CLI entry ─────────────────────────────────────────────────────
// `hexa drill --seed "<expr>" [--rounds N] [--engine mk9|mk10]
//             [--depth-smash N] [--depth-free N] [--speculate N]
//             [--quiet] [--fresh] [--problem id]`
//
// Runs the central discovery engine and prints a JSON summary of the
// resulting DrillResult. Heavy lifting stays in drill_run; this is a
// thin entry-point shim so `hexa drill ...` from the CLI dispatch
// resolves to an actual round loop.

use "compiler/_cli_args/parse"

// Serialize one DrillResult to the canonical single-line JSON summary.
fn _drill_json(seed: string, r: DrillResult) -> string {
    let mut out = "{"
    out = out + "\"seed\":\"" + seed + "\""
    out = out + ",\"rounds\":" + to_string(r.rounds)
    out = out + ",\"total\":" + to_string(r.total)
    out = out + ",\"saturated\":" + (if r.saturated { "true" } else { "false" })
    out = out + ",\"engine\":\"" + r.engine + "\""
    out = out + ",\"overlay_lines\":" + to_string(r.overlay_lines)
    out = out + ",\"verifier_stopped\":" + (if r.verifier_stopped { "true" } else { "false" })
    out = out + ",\"verifier_verdict\":\"" + r.verifier_verdict + "\""
    out = out + "}"
    return out
}

// Parse a comma-separated seed list — inline twin of
// batch.hexa::parse_seeds_csv (inlined here to avoid a drill<->batch
// circular `use`, since batch.hexa already `use`s this module). Trims
// each entry, drops empties.
fn _drill_parse_seeds_csv(csv: string) -> array {
    let raw = csv.split(",")
    let mut out: array = []
    let mut i = 0
    while i < len(raw) {
        let t = to_string(raw[i]).trim()
        if len(t) > 0 { out.push(t) }
        i = i + 1
    }
    return out
}

// Read a newline-delimited seeds file; blank lines and `#` comments are
// ignored (mirrors batch.hexa::read_seeds_file).
fn _drill_read_seeds_file(path: string) -> array {
    let mut out: array = []
    if !file_exists(path) {
        eprintln("drill: --seeds-file not found: " + path)
        return out
    }
    let raw = read_file(path)
    if len(raw) == 0 { return out }
    let lines = raw.split("\n")
    let mut i = 0
    while i < len(lines) {
        let t = to_string(lines[i]).trim()
        if len(t) == 0 { i = i + 1; continue }
        if t.substring(0, 1) == "#" { i = i + 1; continue }
        out.push(t)
        i = i + 1
    }
    return out
}

fn main() {
    let args = cli_args()
    let mut opts = drill_default_opts()
    opts.max_rounds  = cli_parse_int(cli_find_flag(args, "--rounds", ""), opts.max_rounds)
    opts.depth_smash = cli_parse_int(cli_find_flag(args, "--depth-smash", ""), opts.depth_smash)
    opts.depth_free  = cli_parse_int(cli_find_flag(args, "--depth-free", ""), opts.depth_free)
    opts.depth_res   = cli_parse_int(cli_find_flag(args, "--depth-res", ""), opts.depth_res)
    opts.speculate   = cli_parse_int(cli_find_flag(args, "--speculate", ""), opts.speculate)
    let eng_flag = cli_find_flag(args, "--engine", "")
    if len(eng_flag) > 0 { opts.engine = eng_flag }
    let prob_flag = cli_find_flag(args, "--problem", "")
    if len(prob_flag) > 0 { opts.problem = prob_flag }
    if cli_has_flag(args, "--fresh") || cli_has_flag(args, "--no-resume") {
        opts.fresh = true
        opts.resume_on = false
    }
    if cli_has_flag(args, "--quiet") { opts.quiet = true }

    // Surface-on-skip control. `--top N` sets how many ⚪ proposals to emit
    // per skip round (default 8); `--top 0` restores the legacy silent
    // behavior (candidates flushed to overlay only, nothing on stdout).
    opts.surface_top = cli_parse_int(cli_find_flag(args, "--top", ""), opts.surface_top)

    // Pluggable verifier hook (phanes scope B). When absent, drill behaves
    // identically to the pre-hook surface. `--verifier <cmd>` (alias
    // `--verifier-cmd`) is a shell string (treated as a single command for
    // sh -c) that receives the round payload — including the discovery
    // candidate array under "candidates" (drill.hexa:142 contract) — on
    // stdin. `--verifier-timeout` is best-effort via the `timeout` utility
    // prefix. `--verifier-strict` promotes pass/fail verdicts to
    // authoritative loop control. `--verifier-cand-cap N` bounds the
    // candidate array fed per round (default 64; 0 = omit).
    let vcmd = cli_find_flag(args, "--verifier", cli_find_flag(args, "--verifier-cmd", ""))
    if len(vcmd) > 0 { opts.verifier_cmd = vcmd }
    opts.verifier_timeout_s = cli_parse_int(cli_find_flag(args, "--verifier-timeout", ""), opts.verifier_timeout_s)
    opts.verifier_cand_cap = cli_parse_int(cli_find_flag(args, "--verifier-cand-cap", ""), opts.verifier_cand_cap)
    if cli_has_flag(args, "--verifier-strict") { opts.verifier_authoritative = true }

    // ── Batch mode (`--seeds csv` / `--seeds-file PATH`) ───────────────
    // The CLI help (self/main.hexa) advertises `hexa drill --seeds
    // "s1,s2,s3"` (batch dispatch), but this entry point previously only
    // read `--seed` — the batch loop lived solely in batch.hexa and was
    // never reachable from `hexa drill`. Wire it: dispatch each seed
    // through drill_run (same engine, same opts) and emit one JSON
    // summary line per seed + a final `{"batch":true,...}` aggregate.
    // `--seeds-file` wins over `--seeds` when both are given.
    let seeds_file = cli_find_flag(args, "--seeds-file", "")
    let seeds_csv  = cli_find_flag(args, "--seeds", "")
    if len(seeds_file) > 0 || len(seeds_csv) > 0 {
        let mut seeds: array = []
        if len(seeds_file) > 0 { seeds = _drill_read_seeds_file(seeds_file) }
        else { seeds = _drill_parse_seeds_csv(seeds_csv) }
        let n = len(seeds)
        if n == 0 {
            println("usage: hexa drill --seeds \"s1,s2,s3\" | --seeds-file PATH   (no seeds parsed)")
            return
        }
        let mut grand: i64 = 0
        let mut bi = 0
        while bi < n {
            let s = to_string(seeds[bi])
            let br = drill_run(s, opts)
            println(_drill_json(s, br))
            grand = grand + br.total
            bi = bi + 1
        }
        println("{\"batch\":true,\"seed_count\":" + to_string(n) + ",\"grand_total\":" + to_string(grand) + "}")
        return
    }

    // ── Single-seed mode ───────────────────────────────────────────────
    let seed = cli_find_flag(args, "--seed", cli_positional(args, 0, ""))
    if len(seed) == 0 {
        println("usage: hexa drill --seed \"<expr>\" [--rounds N] [--engine mk9|mk10] [--top N]")
        return
    }
    let r = drill_run(seed, opts)
    println(_drill_json(seed, r))
}
