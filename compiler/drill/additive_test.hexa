// HEXA Native Compiler — additive/combinatorial frame selftest (self-contained kernel)
//
// @version 0.1.0
// @capabilities [stdout]
//
// The ORTHOGONAL pivot (Ralph 377): the discovery engine left the MULTIPLICATIVE
// arithmetic-function vocab (σ,φ,τ,μ,… · measured-exhausted Ralph 369–375) for the
// NON-multiplicative GENERATING-FUNCTION / RECURRENCE sequences (partition p(n),
// Catalan, Bell, Fibonacci, Lucas). The new identity FORM is the arithmetic-
// progression CONGRUENCE  p(α·n+β) ≡ 0 (mod m)  — Ramanujan's p(5n+4)≡0 (mod 5)
// being the canonical instance that has NO multiplicative analogue.
//
// This test is a SELF-CONTAINED kernel (it re-implements the exact-int Euler
// pentagonal recurrence inline — same source as compiler/atlas/identity_engine.hexa
// partition_p / verify_congruence). Self-containment sidesteps the C-transpile
// fallback flattener trap that renders cross-module imported-function calls as
// `hexa_callN(fname,...)` value-refs with no emitted C symbol (the documented reason
// absorb_test.hexa drives the CLI as a subprocess). Here the kernel is local, so the
// test compiles and runs in-binary directly.
//
// Asserts:
//   G-gate (Ramanujan): p(5n+4) ≡ 0 (mod 5) for all sampled n in [0,N]  (the deep
//       1919 congruence the engine must rediscover — proof the recurrence is right).
//   E-gate (Euler recurrence): p(10) = 42, p(6) = 11, p(100) = 190569292  (exact
//       pentagonal-number recurrence values).
//   NEG controls: p(5n+3)≢0 mod5 and p(5n+4)≢0 mod7  (must be REJECTED — proves the
//       congruence search discriminates, not a rubber-stamp).
//   Honesty (c2): a confirmed congruence is BOUNDED to [0,N]; the ∀n statement stays
//       UNPROVEN until a proof lands.
//
// Run:
//   hexa run compiler/drill/additive_test.hexa

// ── exact partition p(n) via Euler pentagonal recurrence (i64-safe to n≈350) ──
fn _partition_p(n: i64) -> i64 {
    let p = []
    p.push(1)
    let mut j = 1
    while j <= n {
        let mut total = 0
        let mut k = 1
        while k * (3 * k - 1) / 2 <= j {
            let g1 = k * (3 * k - 1) / 2
            let g2 = k * (3 * k + 1) / 2
            let mut sign = 1
            if k % 2 == 0 { sign = 0 - 1 }
            total = total + sign * p[j - g1]
            if g2 <= j { total = total + sign * p[j - g2] }
            k = k + 1
        }
        p.push(total)
        j = j + 1
    }
    return p[n]
}

// ── p(n) mod m table (recurrence run mod m — no overflow, large N exact) ──
fn _partition_mod(N: i64, m: i64) -> array {
    let p = []
    p.push(1 % m)
    let mut j = 1
    while j <= N {
        let mut total = 0
        let mut k = 1
        while k * (3 * k - 1) / 2 <= j {
            let g1 = k * (3 * k - 1) / 2
            let g2 = k * (3 * k + 1) / 2
            let mut sign = 1
            if k % 2 == 0 { sign = 0 - 1 }
            total = total + sign * p[j - g1]
            if g2 <= j { total = total + sign * p[j - g2] }
            k = k + 1
        }
        total = total % m
        if total < 0 { total = total + m }
        p.push(total)
        j = j + 1
    }
    return p
}

// ── congruence verify: p(a·n+b) ≡ 0 (mod m) ∀n with a·n+b ≤ N?  1 holds (≥12
//    terms), 0 a counterexample exists, -2 too few terms. ──
fn _verify_cong(a: i64, b: i64, m: i64, N: i64) -> i64 {
    let tbl = _partition_mod(N, m)
    let mut count = 0
    let mut k = 0
    while a * k + b <= N {
        if tbl[a * k + b] != 0 { return 0 }
        count = count + 1
        k = k + 1
    }
    if count < 12 { return 0 - 2 }
    return 1
}

fn _check(label: string, got: i64, want: i64, fails: array) {
    if got == want { println("  PASS  " + label + "  -> " + to_string(got)) }
    else { println("  FAIL  " + label + "  -> got " + to_string(got) + " want " + to_string(want)); fails.push(label) }
}

fn main() {
    println("additive/combinatorial frame selftest (orthogonal pivot · Ramanujan congruence)")
    let fails = []
    let N = 4000

    println("")
    println("E-gates: Euler pentagonal recurrence exact values")
    _check("E1 p(10)=42",        _partition_p(10), 42, fails)
    _check("E2 p(6)=11 (≠p2·p3=6)", _partition_p(6), 11, fails)
    _check("E3 p(100)=190569292", _partition_p(100), 190569292, fails)

    println("")
    println("G-gates: rediscover Ramanujan 1919 congruences (bounded [0,N] · ∀n UNPROVEN c2)")
    _check("G1 p(5n+4)≡0 mod5",   _verify_cong(5, 4, 5, N), 1, fails)
    _check("G2 p(7n+5)≡0 mod7",   _verify_cong(7, 5, 7, N), 1, fails)
    _check("G3 p(11n+6)≡0 mod11", _verify_cong(11, 6, 11, N), 1, fails)

    println("")
    println("NEG controls: must be REJECTED (=0) — search discriminates")
    _check("C1 p(5n+3)≢0 mod5 (wrong residue)", _verify_cong(5, 3, 5, N), 0, fails)
    _check("C2 p(5n+4)≢0 mod7 (wrong modulus)", _verify_cong(5, 4, 7, N), 0, fails)

    println("")
    if len(fails) == 0 {
        println("RESULT: PASS — additive congruence engine rediscovers Ramanujan; honest bounded (c2)")
        exit(0)
    } else {
        println("RESULT: FAIL — " + to_string(len(fails)) + " check(s) failed")
        let mut i = 0
        while i < len(fails) {
            println("  - " + to_string(fails[i]))
            i = i + 1
        }
        exit(1)
    }
}

// is_main guard (mirrors absorb_test.hexa / verifier_hook_test.hexa)
let _av = argv()
fn _is_main() -> bool {
    if len(_av) < 2 { return false }
    let s = to_string(_av[1])
    if s.ends_with("/additive_test.hexa") { return true }
    if s == "additive_test.hexa" { return true }
    return false
}
if _is_main() { main() }
