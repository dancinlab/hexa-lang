// compiler/emit/elf_x86_64.hexa
//
// RFC 063 § P2 — ELF x86_64 relocatable object emitter.
//
// Mirror of `compiler/emit/macho_arm64.hexa` (P0) for the Linux
// platform. Emits ELF64 little-endian `.o` files for x86_64 from a
// flat byte-text + symbol/reloc model.
//
// STATUS: P2 cycle 1 — header + minimum section headers serialize.
// x86_64 instruction encoding follows. No code-signing on Linux →
// P2 achieves RFC 063 § P3's "zero external fork" goal more cleanly.

// ELF64 constants — `ELF_` prefix to avoid macro collision with any
// `<elf.h>` headers a future runtime.c might pull in.

let ELF_EI_MAG0           = 0x7f
let ELF_EI_MAG1           = 0x45    // 'E'
let ELF_EI_MAG2           = 0x4c    // 'L'
let ELF_EI_MAG3           = 0x46    // 'F'
let ELF_ELFCLASS64        = 2
let ELF_ELFDATA2LSB       = 1       // little-endian
let ELF_EV_CURRENT        = 1
let ELF_ELFOSABI_NONE     = 0       // System V

let ELF_ET_REL            = 1       // relocatable object
let ELF_ET_EXEC           = 2
let ELF_ET_DYN            = 3

let ELF_EM_X86_64         = 0x3e
let ELF_EM_AARCH64        = 0xb7

let ELF_SHT_NULL          = 0
let ELF_SHT_PROGBITS      = 1
let ELF_SHT_SYMTAB        = 2
let ELF_SHT_STRTAB        = 3
let ELF_SHT_RELA          = 4
let ELF_SHT_NOBITS        = 8

let ELF_SHF_WRITE         = 0x1
let ELF_SHF_ALLOC         = 0x2
let ELF_SHF_EXECINSTR     = 0x4

let ELF_STB_LOCAL         = 0
let ELF_STB_GLOBAL        = 1
let ELF_STT_NOTYPE        = 0
let ELF_STT_FUNC          = 2

let ELF_R_X86_64_NONE     = 0
let ELF_R_X86_64_64       = 1
let ELF_R_X86_64_PC32     = 2
let ELF_R_X86_64_PLT32    = 4

struct ElfX86Obj {
    text:    [u8],
    relocs:  [ElfRel],
    symbols: [ElfSym],
    strtab:  [u8],
    // ── Data-section payloads (cycle 32 — mirror of elf_arm64) ──
    // `.rodata` = string/const literal pool (`.LCstrN` locals).
    // `.data`   = module-global HexaVal slots (16-B zero, `g<id>` locals).
    // `.bss`    = SHT_NOBITS byte count (no file bytes). `nlocal` = count
    // of STB_LOCAL symbols (the rodata/data defs) so the serializer can
    // stamp `.symtab` `sh_info` = nlocal+1 (ELF requires LOCAL < GLOBAL).
    rodata:   [u8],
    data:     [u8],
    bss_size: i64,
    nlocal:   i64,
}

struct ElfRel {
    offset:  i64,
    sym_idx: i64,
    kind:    i64,
    addend:  i64,
    site_seg: i64,   // reloc SITE pool: 1=text, 3=rodata, 4=data (own-emit writers=text=1)
}

struct ElfSym {
    name_offset: i64,
    section:     i64,
    value:       i64,
    size:        i64,
    bind:        i64,
    type_:       i64,
}

fn _ew_u16(out: [Int], v: Int) {
    out.push(v & 0xff); out.push((v >> 8) & 0xff)
}
fn _ew_u32(out: [Int], v: Int) {
    out.push(v & 0xff); out.push((v >> 8) & 0xff)
    out.push((v >> 16) & 0xff); out.push((v >> 24) & 0xff)
}
fn _ew_u64(out: [Int], v: Int) {
    out.push(v & 0xff); out.push((v >> 8) & 0xff)
    out.push((v >> 16) & 0xff); out.push((v >> 24) & 0xff)
    out.push((v >> 32) & 0xff); out.push((v >> 40) & 0xff)
    out.push((v >> 48) & 0xff); out.push((v >> 56) & 0xff)
}
fn _ew_zero(out: [Int], n: Int) {
    let mut i = 0
    while i < n { out.push(0); i = i + 1 }
}
fn _ew_str(out: [Int], s: string) -> Int {
    let off = len(out)
    let n = len(s)
    let mut i = 0
    while i < n { out.push(char_code(s, i) & 0xff); i = i + 1 }
    out.push(0)
    return off
}

// ─────────────────────────────────────────────────────────────────
// x86_64 instruction encoding — P2 cycle 2
// ─────────────────────────────────────────────────────────────────
//
// `encode_x86_64_insn(op, ops) -> [Int]` returns a *variable-length*
// byte array (unlike arm64's fixed 4-byte word).  x86_64 encoding
// breakdown:
//
//   [legacy prefix] [REX] [opcode 1-3B] [ModR/M] [SIB] [disp 0/8/32] [imm 0/8/16/32/64]
//
// Cycle 2 ships the minimum subset for a Linux `exit(N)` syscall:
//
//   MOV EAX, #N      B8 imm32          5 B  (32-bit MOV zero-extends to RAX)
//   MOV EDI, #N      BF imm32          5 B  (same for RDI)
//   MOV ESI, #N      BE imm32          5 B  (RSI arg)
//   MOV EDX, #N      BA imm32          5 B  (RDX arg)
//   SYSCALL          0F 05             2 B  (kernel trap)
//   RET              C3                1 B
//
// 32-bit register names parse to indices 0-7 (eax=0, ecx=1, edx=2,
// ebx=3, esp=4, ebp=5, esi=6, edi=7). The opcode for `MOV r32, imm32`
// is `B8 + reg_idx`.

fn _ex86_reg32(s: string) -> Int {
    if s == "eax" || s == "EAX" { return 0 }
    if s == "ecx" || s == "ECX" { return 1 }
    if s == "edx" || s == "EDX" { return 2 }
    if s == "ebx" || s == "EBX" { return 3 }
    if s == "esp" || s == "ESP" { return 4 }
    if s == "ebp" || s == "EBP" { return 5 }
    if s == "esi" || s == "ESI" { return 6 }
    if s == "edi" || s == "EDI" { return 7 }
    return -1
}

// ③-R2f: extended 32-bit reg names (r8d..r15d = the low dword of r8..r15).
// `_ex86_reg32` only knows the legacy eax..edi (0..7); the `dword ptr [..]`
// mem-operand family (arr_len/ptr_load32/va_start) targets r10d/r11d, whose
// r-prefixed name the width-dispatcher routes to MOV64 but whose true width
// is 32-bit (the `dword ptr` size prefix). This resolver is used ONLY by the
// R2f size-ptr mem arms below, so the legacy reg32 callers are unperturbed.
fn _ex86_reg32e(s: string) -> Int {
    let r = _ex86_reg32(s)
    if r >= 0 { return r }
    if s == "r8d"  || s == "R8D"  { return 8 }
    if s == "r9d"  || s == "R9D"  { return 9 }
    if s == "r10d" || s == "R10D" { return 10 }
    if s == "r11d" || s == "R11D" { return 11 }
    if s == "r12d" || s == "R12D" { return 12 }
    if s == "r13d" || s == "R13D" { return 13 }
    if s == "r14d" || s == "R14D" { return 14 }
    if s == "r15d" || s == "R15D" { return 15 }
    return -1
}

// x86_64 r64 register name → index 0..15.
//   rax=0 · rcx=1 · rdx=2 · rbx=3 · rsp=4 · rbp=5 · rsi=6 · rdi=7 ·
//   r8..r15=8..15 (require REX.B prefix bit).
// Returns -1 on no match.
fn _ex86_reg64(s: string) -> Int {
    if s == "rax" || s == "RAX" { return 0 }
    if s == "rcx" || s == "RCX" { return 1 }
    if s == "rdx" || s == "RDX" { return 2 }
    if s == "rbx" || s == "RBX" { return 3 }
    if s == "rsp" || s == "RSP" { return 4 }
    if s == "rbp" || s == "RBP" { return 5 }
    if s == "rsi" || s == "RSI" { return 6 }
    if s == "rdi" || s == "RDI" { return 7 }
    if s == "r8"  || s == "R8"  { return 8 }
    if s == "r9"  || s == "R9"  { return 9 }
    if s == "r10" || s == "R10" { return 10 }
    if s == "r11" || s == "R11" { return 11 }
    if s == "r12" || s == "R12" { return 12 }
    if s == "r13" || s == "R13" { return 13 }
    if s == "r14" || s == "R14" { return 14 }
    if s == "r15" || s == "R15" { return 15 }
    return -1
}

// x86_64 r8 (low-byte) register name → index 0..15.
//   al=0 · cl=1 · dl=2 · bl=3 · spl=4 · bpl=5 · sil=6 · dil=7 ·
//   r8b..r15b=8..15 (require REX.B prefix bit).
// Note: ah/ch/dh/bh (high-byte aliases) cannot coexist with REX
// prefix; SETcc/MOVZX usage here only targets low-byte names.
// Returns -1 on no match.
fn _ex86_reg8(s: string) -> Int {
    if s == "al"  || s == "AL"  { return 0 }
    if s == "cl"  || s == "CL"  { return 1 }
    if s == "dl"  || s == "DL"  { return 2 }
    if s == "bl"  || s == "BL"  { return 3 }
    if s == "spl" || s == "SPL" { return 4 }
    if s == "bpl" || s == "BPL" { return 5 }
    if s == "sil" || s == "SIL" { return 6 }
    if s == "dil" || s == "DIL" { return 7 }
    if s == "r8b"  || s == "R8B"  { return 8 }
    if s == "r9b"  || s == "R9B"  { return 9 }
    if s == "r10b" || s == "R10B" { return 10 }
    if s == "r11b" || s == "R11B" { return 11 }
    if s == "r12b" || s == "R12B" { return 12 }
    if s == "r13b" || s == "R13B" { return 13 }
    if s == "r14b" || s == "R14B" { return 14 }
    if s == "r15b" || s == "R15B" { return 15 }
    return -1
}

// x86_64 xmm (SSE) register name → index 0..15.
//   xmm0..xmm7=0..7 · xmm8..xmm15=8..15 (require REX.R / REX.B prefix bit).
// The ③-R2b scalar-double family (movsd/addsd/…/cvt*/comisd) selects xmm
// operands via this table; a GP-register token returns -1 here so the
// mixed-operand ops (movq / cvtsi2sd / cvttsd2si) can disambiguate which
// side is the SSE register vs the GP register. Returns -1 on no match.
fn _ex86_xmm(s: string) -> Int {
    if s == "xmm0"  || s == "XMM0"  { return 0 }
    if s == "xmm1"  || s == "XMM1"  { return 1 }
    if s == "xmm2"  || s == "XMM2"  { return 2 }
    if s == "xmm3"  || s == "XMM3"  { return 3 }
    if s == "xmm4"  || s == "XMM4"  { return 4 }
    if s == "xmm5"  || s == "XMM5"  { return 5 }
    if s == "xmm6"  || s == "XMM6"  { return 6 }
    if s == "xmm7"  || s == "XMM7"  { return 7 }
    if s == "xmm8"  || s == "XMM8"  { return 8 }
    if s == "xmm9"  || s == "XMM9"  { return 9 }
    if s == "xmm10" || s == "XMM10" { return 10 }
    if s == "xmm11" || s == "XMM11" { return 11 }
    if s == "xmm12" || s == "XMM12" { return 12 }
    if s == "xmm13" || s == "XMM13" { return 13 }
    if s == "xmm14" || s == "XMM14" { return 14 }
    if s == "xmm15" || s == "XMM15" { return 15 }
    return -1
}

// REX prefix builder.  REX = 0100 W R X B (4-bit fixed + 4 flag bits).
//   W = 64-bit operand size (1 for r64 ops)
//   R = extends ModR/M.reg (1 if reg >= 8)
//   X = extends SIB.index (unused here)
//   B = extends ModR/M.rm or opcode-reg (1 if reg >= 8)
// Returns the prefix byte (always emitted for r64; 0x48 is REX.W only).
fn _ex86_rex(w: Int, r: Int, x: Int, b: Int) -> Int {
    return 0x40 | ((w & 1) << 3) | ((r & 1) << 2) | ((x & 1) << 1) | (b & 1)
}

fn _ex86_imm(s: string) -> Int {
    let n = len(s)
    if n < 2 { return 0 }
    if s.substring(0, 1) != "#" { return s.to_int() }
    return s.substring(1, n).to_int()
}

// ─── Cycle 30 — mem-operand parser + ModR/M+SIB+disp helper ──────
//
// String form (per `_lir_operand_str_x86`): `[base]`, `[base + N]`,
// `[base - N]`. The walker keeps things narrow — no scale-index nor
// RIP-relative forms (those land in later cycles when the codegen
// needs them).
//
// Returns `[base_r64_idx, disp_i64]`, or `[-1, 0]` on unparseable.
// Caller treats `[-1, ...]` as "no mem operand"; subsequent encoder
// rules fall through to non-mem forms.

fn _ex86_trim(s: string) -> string {
    let n = len(s)
    let mut a = 0
    while a < n && s.substring(a, a + 1) == " " { a = a + 1 }
    let mut b = n
    while b > a && s.substring(b - 1, b) == " " { b = b - 1 }
    return s.substring(a, b)
}

fn _ex86_parse_mem(s: string) -> [Int] {
    let n = len(s)
    if n < 3 { return [-1, 0] }
    if s.substring(0, 1) != "[" { return [-1, 0] }
    if s.substring(n - 1, n) != "]" { return [-1, 0] }
    let inner = s.substring(1, n - 1)
    // Scan for the separator (' + ' or ' - '). Single-char `+`/`-`
    // without leading space wouldn't be ambiguous either, but the LIR
    // formatter always emits the spaced form so we anchor on it.
    let il = len(inner)
    let mut sep = -1
    let mut sign = 1
    let mut k = 0
    while k + 2 < il {
        let trip = inner.substring(k, k + 3)
        if trip == " + " { sep = k; sign = 1;  break }
        if trip == " - " { sep = k; sign = -1; break }
        k = k + 1
    }
    if sep < 0 {
        // Pure `[reg]` form — disp 0.
        let base_idx = _ex86_reg64(_ex86_trim(inner))
        return [base_idx, 0]
    }
    let base_name = _ex86_trim(inner.substring(0, sep))
    let off_str   = _ex86_trim(inner.substring(sep + 3, il))
    let base_idx  = _ex86_reg64(base_name)
    let disp      = sign * off_str.to_int()
    return [base_idx, disp]
}

// ③-R2f: parse a SIZE-prefixed memory-operand LABEL string as emitted by the
// codegen for va_arg / ptr_load* / ptr_store* / arr_len / str_byte — the form
// `<size> ptr [base ± disp]` where size ∈ {byte,word,dword,qword}. Unlike the
// `kind:"mem"` operand (which stringifies to a bare `[base ± disp]`), these
// arrive as `kind:"label"` carrying the whole `dword ptr [r10 + 8]` string, so
// `_ex86_parse_mem` (which requires a leading `[`) rejects them → ENCODE-MISS.
// This strips the `<size> ptr ` prefix, then reuses `_ex86_parse_mem` for the
// `[base ± disp]` tail. Returns `[size_code, base_r64_idx, disp]` with
// size_code ∈ {1=byte, 2=word, 4=dword, 8=qword}; `[-1, 0, 0]` if not a
// size-ptr label (caller then falls through to the non-ptr arms).
fn _ex86_parse_ptr_mem(s: string) -> [Int] {
    let n = len(s)
    let mut sz = -1
    let mut rest = ""
    if n > 9 && s.substring(0, 9) == "byte ptr " {
        sz = 1; rest = s.substring(9, n)
    } else if n > 9 && s.substring(0, 9) == "word ptr " {
        sz = 2; rest = s.substring(9, n)
    } else if n > 10 && s.substring(0, 10) == "dword ptr " {
        sz = 4; rest = s.substring(10, n)
    } else if n > 10 && s.substring(0, 10) == "qword ptr " {
        sz = 8; rest = s.substring(10, n)
    } else {
        return [-1, 0, 0]
    }
    let mem = _ex86_parse_mem(rest)
    if mem[0] < 0 { return [-1, 0, 0] }
    return [sz, mem[0], mem[1]]
}

// Emit ModR/M (+ SIB if base==RSP/R12) (+ disp8/disp32) for a memory
// operand referencing `[base + disp]`, with the ModR/M.reg field set
// to `reg_field` (0..7 — the caller's register or opcode-extension).
// Caller is responsible for any REX byte (REX.B if base >= 8, REX.R
// if reg_field source register >= 8). reg_field passed in here is
// the 3 low bits; high bit goes to REX.R via the caller.
//
// disp encoding rules (Intel SDM Vol 2, "Effective Addresses"):
//   - mod=00 + r/m=base_lo3  : `[base]` with no disp,
//     EXCEPT if base_lo3 == 5 (RBP/R13) which would mean RIP-relative
//     (in long mode), so for `[RBP]` we must use mod=01 disp8=0.
//   - mod=01 + disp8 : `[base + disp8]` for -128..127.
//   - mod=10 + disp32: `[base + disp32]` for larger displacements.
//   - SIB byte required when r/m field == 4 (RSP/R12 in lo3 bits)
//     because RSP encoded as r/m means "use SIB". SIB = (scale=0
//     << 6) | (index=4=NO_INDEX << 3) | (base=RSP)
//     = 0x24 for [rsp + ...].

fn _ex86_modrm_mem(reg_field: Int, base_idx: Int, disp: Int) -> [Int] {
    let base_lo3 = base_idx & 0x7
    let r_lo3    = reg_field & 0x7
    // Pick mod by disp range — but force mod=01 disp8=0 for RBP/R13 lo3=5.
    let mut modbits = 0
    let mut emit_disp_n = 0     // 0 / 1 / 4
    if disp == 0 && base_lo3 != 5 {
        modbits = 0
        emit_disp_n = 0
    } else {
        if disp >= -128 && disp <= 127 {
            modbits = 1
            emit_disp_n = 1
        } else {
            modbits = 2
            emit_disp_n = 4
        }
    }
    let modrm = (modbits << 6) | (r_lo3 << 3) | base_lo3
    let bytes: [Int] = []
    bytes.push(modrm)
    // SIB byte required when r/m lo3 == 4 (RSP/R12).
    if base_lo3 == 4 {
        bytes.push(0x24)        // scale=0, index=4 (NO_INDEX), base=RSP/R12
    }
    if emit_disp_n == 1 {
        bytes.push(disp & 0xff)
    } else {
        if emit_disp_n == 4 {
            bytes.push( disp        & 0xff)
            bytes.push((disp >> 8)  & 0xff)
            bytes.push((disp >> 16) & 0xff)
            bytes.push((disp >> 24) & 0xff)
        }
    }
    return bytes
}

// Emit `MOV r32, imm32`. Encoding: `B8+r` opcode, then imm32 LE.
fn _ex86_mov_r32_imm32(reg_idx: Int, imm: Int) -> [Int] {
    let out: [Int] = []
    out.push(0xb8 | (reg_idx & 0x7))
    out.push(imm & 0xff)
    out.push((imm >> 8) & 0xff)
    out.push((imm >> 16) & 0xff)
    out.push((imm >> 24) & 0xff)
    return out
}

pub fn encode_x86_64_insn(op: string, ops: [string]) -> [Int] {
    if op == "MOV" && len(ops) == 2 && ops[1].substring(0, 1) == "#" {
        let rd = _ex86_reg32(ops[0])
        let imm = _ex86_imm(ops[1])
        if rd >= 0 { return _ex86_mov_r32_imm32(rd, imm) }
    }
    if op == "SYSCALL" { return [0x0f, 0x05] }
    if op == "RET"     { return [0xc3] }
    // CALL — register-indirect (`call r64`) or rel32 direct.
    if op == "CALL" && len(ops) == 1 {
        // ③-R2e: register-indirect call — FF /2 (opcode-ext reg=2). The
        // codegen's closure / fn-ptr dispatch emits `call r11` (a "reg"
        // operand); without this arm it fell through to the E8 rel32
        // placeholder below with disp=0 → a call to the NEXT instruction, a
        // silent miscompile. REX.B for r8..r15.  e.g. call r11 → 41 ff d3
        let ri = _ex86_reg64(ops[0])
        if ri >= 0 {
            if ri < 8 { return [0xff, 0xc0 | (2 << 3) | (ri & 0x7)] }
            return [0x41, 0xff, 0xc0 | (2 << 3) | (ri & 0x7)]
        }
        // CALL rel32 — 5 bytes: E8 + 4-byte signed PC-relative offset.
        return [0xe8, 0x00, 0x00, 0x00, 0x00]
    }

    // ── x86_64 arithmetic — P2 walker prep ──
    //
    // 81 /0 id: ADD r/m32, imm32 — 6 bytes (with mod=11 reg-direct).
    //   Layout: 81 c0+r imm32   (e.g. ADD EAX, imm32 → 81 c0 imm32)
    // 81 /5 id: SUB r/m32, imm32 — same shape, opcode-ext 5: 81 e8+r
    // 81 /7 id: CMP r/m32, imm32 — opcode-ext 7: 81 f8+r
    // The /N field selects via ModR/M.reg; we use mod=11 (reg-direct)
    // so ModR/M = 0b11_<ext>_<rm> = 0xc0 | (ext<<3) | r.
    if op == "ADD" && len(ops) == 2 && ops[1].substring(0, 1) == "#" {
        let rd = _ex86_reg32(ops[0])
        let imm = _ex86_imm(ops[1])
        if rd >= 0 {
            let modrm = 0xc0 | (0 << 3) | rd     // /0
            return [0x81, modrm,
                    imm & 0xff, (imm >> 8) & 0xff,
                    (imm >> 16) & 0xff, (imm >> 24) & 0xff]
        }
    }
    if op == "SUB" && len(ops) == 2 && ops[1].substring(0, 1) == "#" {
        let rd = _ex86_reg32(ops[0])
        let imm = _ex86_imm(ops[1])
        if rd >= 0 {
            let modrm = 0xc0 | (5 << 3) | rd     // /5 = ModR/M reg=5
            return [0x81, modrm,
                    imm & 0xff, (imm >> 8) & 0xff,
                    (imm >> 16) & 0xff, (imm >> 24) & 0xff]
        }
    }
    if op == "CMP" && len(ops) == 2 && ops[1].substring(0, 1) == "#" {
        let rd = _ex86_reg32(ops[0])
        let imm = _ex86_imm(ops[1])
        if rd >= 0 {
            let modrm = 0xc0 | (7 << 3) | rd     // /7
            return [0x81, modrm,
                    imm & 0xff, (imm >> 8) & 0xff,
                    (imm >> 16) & 0xff, (imm >> 24) & 0xff]
        }
    }
    // ADD/SUB/CMP r32, r32 — reg-reg form (2 bytes opcode + ModR/M).
    //   01 /r:  ADD r/m32, r32   (e.g. ADD EAX, EBX → 01 d8)
    //   29 /r:  SUB r/m32, r32
    //   39 /r:  CMP r/m32, r32
    // ModR/M = 0b11_<src>_<dst> for reg-reg with dst as destination.
    if op == "ADD" && len(ops) == 2 {
        let rd = _ex86_reg32(ops[0])
        let rs = _ex86_reg32(ops[1])
        if rd >= 0 && rs >= 0 {
            return [0x01, 0xc0 | (rs << 3) | rd]
        }
    }
    if op == "SUB" && len(ops) == 2 {
        let rd = _ex86_reg32(ops[0])
        let rs = _ex86_reg32(ops[1])
        if rd >= 0 && rs >= 0 {
            return [0x29, 0xc0 | (rs << 3) | rd]
        }
    }
    if op == "CMP" && len(ops) == 2 {
        let rd = _ex86_reg32(ops[0])
        let rs = _ex86_reg32(ops[1])
        if rd >= 0 && rs >= 0 {
            return [0x39, 0xc0 | (rs << 3) | rd]
        }
    }
    // ③-R2e: 64-bit CMP. The codegen dominantly emits `cmp r10, r11`,
    // `cmp rax, r11`, `cmp r10, #0`, `cmp rax, #1` (setcc / br_cond
    // predicate) — 64-bit operands the r32 arms above reject (reg32 has no
    // rax/r10 name → ENCODE-MISS). The uppercase map now width-dispatches
    // `cmp` → CMP64 when an operand is a 64-bit reg. Mirrors SUB64's 29/81-5
    // idiom, opcode 39 /r (reg-reg) and 81 /7 id (reg-imm).
    // CMP64 r64, #imm32 — REX.W + 81 /7 id (7 B). e.g. cmp r10, 0 → 49 81 fa 00 00 00 00
    if op == "CMP64" && len(ops) == 2 && ops[1].substring(0, 1) == "#" {
        let rd = _ex86_reg64(ops[0])
        let imm = _ex86_imm(ops[1])
        if rd >= 0 {
            let rex = _ex86_rex(1, 0, 0, if rd >= 8 { 1 } else { 0 })
            let modrm = 0xc0 | (7 << 3) | (rd & 0x7)
            return [rex, 0x81, modrm,
                    imm & 0xff, (imm >> 8) & 0xff,
                    (imm >> 16) & 0xff, (imm >> 24) & 0xff]
        }
    }
    // CMP64 r64, r64 — REX.W + 39 /r (3 B). ModR/M.reg = SRC(rhs), rm =
    // DEST(lhs) — mirrors SUB64 reg-reg exactly.  e.g. cmp r10, r11 → 4d 39 da
    if op == "CMP64" && len(ops) == 2 {
        let rd = _ex86_reg64(ops[0])
        let rs = _ex86_reg64(ops[1])
        if rd >= 0 && rs >= 0 {
            let rex = _ex86_rex(1, if rs >= 8 { 1 } else { 0 }, 0,
                                    if rd >= 8 { 1 } else { 0 })
            return [rex, 0x39, 0xc0 | ((rs & 0x7) << 3) | (rd & 0x7)]
        }
    }
    // ③-R2e: XOR r32, r32 — 31 /r (2 B, no REX). The codegen's div / neg
    // prep emits the `xor eax, eax` / `xor edx, edx` zeroing idiom (32-bit),
    // which the uppercase map routes to bare `XOR` (is64=false); without this
    // arm it fell through to ENCODE-MISS.  e.g. xor eax, eax → 31 c0
    if op == "XOR" && len(ops) == 2 {
        let rd = _ex86_reg32(ops[0])
        let rs = _ex86_reg32(ops[1])
        if rd >= 0 && rs >= 0 {
            return [0x31, 0xc0 | (rs << 3) | rd]
        }
    }
    // MOV r32, r32 — 89 /r ModR/M (dst as r/m, src as reg).
    //   e.g. MOV EDI, EAX → 89 c7  (src=eax=0, dst=edi=7 → 0xc0|(0<<3)|7 = 0xc7)
    if op == "MOV" && len(ops) == 2 {
        let rd = _ex86_reg32(ops[0])
        let rs = _ex86_reg32(ops[1])
        if rd >= 0 && rs >= 0 {
            return [0x89, 0xc0 | (rs << 3) | rd]
        }
    }
    // PUSH r32 — 50+r (1 byte, x86_64 implicit pushes 64-bit value).
    if op == "PUSH" && len(ops) == 1 {
        let rd = _ex86_reg32(ops[0])
        if rd >= 0 { return [0x50 | rd] }
    }
    // POP r32 — 58+r.
    if op == "POP" && len(ops) == 1 {
        let rd = _ex86_reg32(ops[0])
        if rd >= 0 { return [0x58 | rd] }
    }
    // JMP rel8 — EB cb (2 bytes). Caller computes imm8 PC-rel.
    // imm8 = target - (jmp_end_addr).  Stored at offset 1.
    // Cycle 25 emits placeholder 0; linker / caller patches.
    if op == "JMP_REL8" && len(ops) == 1 {
        return [0xeb, 0x00]
    }
    // JMP rel32 — E9 cd (5 bytes).
    if op == "JMP_REL32" && len(ops) == 1 {
        return [0xe9, 0x00, 0x00, 0x00, 0x00]
    }
    // Conditional jumps rel8 — 7c+cc (2 bytes).
    //   JE rel8  74 cb
    //   JNE      75
    //   JL       7C
    //   JGE      7D
    //   JLE      7E
    //   JG       7F
    if op == "JE_REL8"  && len(ops) == 1 { return [0x74, 0x00] }
    if op == "JNE_REL8" && len(ops) == 1 { return [0x75, 0x00] }
    if op == "JL_REL8"  && len(ops) == 1 { return [0x7c, 0x00] }
    if op == "JGE_REL8" && len(ops) == 1 { return [0x7d, 0x00] }
    if op == "JLE_REL8" && len(ops) == 1 { return [0x7e, 0x00] }
    if op == "JG_REL8"  && len(ops) == 1 { return [0x7f, 0x00] }
    // R2d (axis-③): unsigned conditional jumps (ja/jae/jb/jbe) — same REL8 shape.
    //   JA(>u) 77 · JAE(>=u) 73 · JB(<u) 72 · JBE(<=u) 76
    if op == "JA_REL8"  && len(ops) == 1 { return [0x77, 0x00] }
    if op == "JAE_REL8" && len(ops) == 1 { return [0x73, 0x00] }
    if op == "JB_REL8"  && len(ops) == 1 { return [0x72, 0x00] }
    if op == "JBE_REL8" && len(ops) == 1 { return [0x76, 0x00] }

    // ── x86_64 r64 ops (REX.W) ──────────────────────────────────
    //
    // MOV r64, #imm32 (sign-extend to 64) — REX.W + C7 /0 id (7 B).
    //   e.g. MOV RAX, #60 → 48 c7 c0 3c 00 00 00
    // ③-R2b movabs fold: C7 /0 id sign-extends a 32-bit immediate, so a
    // value OUTSIDE the signed-imm32 range [-2^31, 2^31-1] would be
    // silently truncated/mis-encoded (the gap R2a flagged — e.g. a 64-bit
    // pointer/float-payload constant). For those, emit `movabs r64, imm64`
    // = REX.W + B8+rd io (10 B). Byte-NEUTRAL for every value that fits
    // signed-imm32 (keeps the canonical C7 /0 form the golden tests pin);
    // only large constants — previously wrong bytes — take the new path.
    if op == "MOV64" && len(ops) == 2 && ops[1].substring(0, 1) == "#" {
        let rd = _ex86_reg64(ops[0])
        let imm = _ex86_imm(ops[1])
        if rd >= 0 {
            let rex = _ex86_rex(1, 0, 0, if rd >= 8 { 1 } else { 0 })
            if imm > 2147483647 || imm < -2147483648 {
                // movabs r64, imm64 — REX.W + (B8+rd) + imm64 LE.
                return [rex, 0xb8 | (rd & 0x7),
                        imm & 0xff, (imm >> 8) & 0xff,
                        (imm >> 16) & 0xff, (imm >> 24) & 0xff,
                        (imm >> 32) & 0xff, (imm >> 40) & 0xff,
                        (imm >> 48) & 0xff, (imm >> 56) & 0xff]
            }
            let modrm = 0xc0 | (0 << 3) | (rd & 0x7)
            return [rex, 0xc7, modrm,
                    imm & 0xff, (imm >> 8) & 0xff,
                    (imm >> 16) & 0xff, (imm >> 24) & 0xff]
        }
    }
    // MOV r64, r64 — REX.W + 89 /r ModR/M (3 B).
    //   e.g. MOV RDI, RAX → 48 89 c7
    if op == "MOV64" && len(ops) == 2 {
        let rd = _ex86_reg64(ops[0])
        let rs = _ex86_reg64(ops[1])
        if rd >= 0 && rs >= 0 {
            let rex = _ex86_rex(1, if rs >= 8 { 1 } else { 0 }, 0,
                                    if rd >= 8 { 1 } else { 0 })
            return [rex, 0x89, 0xc0 | ((rs & 0x7) << 3) | (rd & 0x7)]
        }
    }
    // ADD r64, #imm32 — REX.W + 81 /0 id (7 B).
    if op == "ADD64" && len(ops) == 2 && ops[1].substring(0, 1) == "#" {
        let rd = _ex86_reg64(ops[0])
        let imm = _ex86_imm(ops[1])
        if rd >= 0 {
            let rex = _ex86_rex(1, 0, 0, if rd >= 8 { 1 } else { 0 })
            let modrm = 0xc0 | (0 << 3) | (rd & 0x7)
            return [rex, 0x81, modrm,
                    imm & 0xff, (imm >> 8) & 0xff,
                    (imm >> 16) & 0xff, (imm >> 24) & 0xff]
        }
    }
    // SUB r64, #imm32 — REX.W + 81 /5 id (7 B).
    if op == "SUB64" && len(ops) == 2 && ops[1].substring(0, 1) == "#" {
        let rd = _ex86_reg64(ops[0])
        let imm = _ex86_imm(ops[1])
        if rd >= 0 {
            let rex = _ex86_rex(1, 0, 0, if rd >= 8 { 1 } else { 0 })
            let modrm = 0xc0 | (5 << 3) | (rd & 0x7)
            return [rex, 0x81, modrm,
                    imm & 0xff, (imm >> 8) & 0xff,
                    (imm >> 16) & 0xff, (imm >> 24) & 0xff]
        }
    }
    // ADD r64, r64 — REX.W + 01 /r (3 B).
    if op == "ADD64" && len(ops) == 2 {
        let rd = _ex86_reg64(ops[0])
        let rs = _ex86_reg64(ops[1])
        if rd >= 0 && rs >= 0 {
            let rex = _ex86_rex(1, if rs >= 8 { 1 } else { 0 }, 0,
                                    if rd >= 8 { 1 } else { 0 })
            return [rex, 0x01, 0xc0 | ((rs & 0x7) << 3) | (rd & 0x7)]
        }
    }
    // SUB r64, r64 — REX.W + 29 /r (3 B).
    if op == "SUB64" && len(ops) == 2 {
        let rd = _ex86_reg64(ops[0])
        let rs = _ex86_reg64(ops[1])
        if rd >= 0 && rs >= 0 {
            let rex = _ex86_rex(1, if rs >= 8 { 1 } else { 0 }, 0,
                                    if rd >= 8 { 1 } else { 0 })
            return [rex, 0x29, 0xc0 | ((rs & 0x7) << 3) | (rd & 0x7)]
        }
    }
    // ── Cycle 27 additions — division / sign-extend / NOP / TEST ──
    //
    // NOP — 0x90 (1 B). Single-byte no-op for padding / alignment.
    if op == "NOP" { return [0x90] }
    // PAUSE — F3 90 (2 B). Spin-loop hint (RFC inline-asm rung 2 `__hx_asm("pause")`).
    // Additive/dead by default (no existing emit uses `pause`) → byteeq-safe.
    if op == "PAUSE" { return [0xf3, 0x90] }
    // MFENCE — 0F AE F0 (3 B). Full memory barrier (RFC inline-asm rung 2
    // `__hx_asm("fence")`). Additive/dead by default → byteeq-safe.
    if op == "MFENCE" { return [0x0f, 0xae, 0xf0] }
    // CQO — 48 99 (REX.W + 99). Sign-extend RAX into RDX:RAX (idiv
    // setup for signed-division).
    if op == "CQO" { return [0x48, 0x99] }
    // TEST64 r64, r64 — REX.W + 85 /r (3 B). Sets ZF/SF based on
    // logical AND (no destination write).
    if op == "TEST64" && len(ops) == 2 {
        let rd = _ex86_reg64(ops[0])
        let rs = _ex86_reg64(ops[1])
        if rd >= 0 && rs >= 0 {
            let rex = _ex86_rex(1, if rs >= 8 { 1 } else { 0 }, 0,
                                    if rd >= 8 { 1 } else { 0 })
            return [rex, 0x85, 0xc0 | ((rs & 0x7) << 3) | (rd & 0x7)]
        }
    }
    // IDIV r64 — REX.W + F7 /7 (3 B). Signed division of RDX:RAX by
    // r64, quotient → RAX, remainder → RDX. Caller must CQO first.
    if op == "IDIV64" && len(ops) == 1 {
        let rd = _ex86_reg64(ops[0])
        if rd >= 0 {
            let rex = _ex86_rex(1, 0, 0, if rd >= 8 { 1 } else { 0 })
            return [rex, 0xf7, 0xc0 | (7 << 3) | (rd & 0x7)]
        }
    }
    // ── Cycle 30 additions — mem operands + r64 PUSH/POP / LEA ──
    //
    // Convention: a memory operand is the string `[base + disp]` (or
    // `[base - disp]`); a register operand starts with `r`/`R`/`e`/`E`.
    // We always check the mem path first when the candidate token
    // begins with `[`.

    // MOV64 r64, [base + disp] — REX.W + 8B /r
    if op == "MOV64" && len(ops) == 2 && ops[1].substring(0, 1) == "[" {
        let rd = _ex86_reg64(ops[0])
        let mem = _ex86_parse_mem(ops[1])
        if rd >= 0 && mem[0] >= 0 {
            let base = mem[0]; let disp = mem[1]
            let rex = _ex86_rex(1, if rd   >= 8 { 1 } else { 0 }, 0,
                                    if base >= 8 { 1 } else { 0 })
            let mr = _ex86_modrm_mem(rd, base, disp)
            let out: [Int] = []
            out.push(rex); out.push(0x8b)
            let mut i = 0
            while i < len(mr) { out.push(mr[i]); i = i + 1 }
            return out
        }
    }
    // MOV64 [base + disp], r64 — REX.W + 89 /r
    if op == "MOV64" && len(ops) == 2 && ops[0].substring(0, 1) == "[" {
        let mem = _ex86_parse_mem(ops[0])
        let rs = _ex86_reg64(ops[1])
        if rs >= 0 && mem[0] >= 0 {
            let base = mem[0]; let disp = mem[1]
            let rex = _ex86_rex(1, if rs   >= 8 { 1 } else { 0 }, 0,
                                    if base >= 8 { 1 } else { 0 })
            let mr = _ex86_modrm_mem(rs, base, disp)
            let out: [Int] = []
            out.push(rex); out.push(0x89)
            let mut i = 0
            while i < len(mr) { out.push(mr[i]); i = i + 1 }
            return out
        }
    }
    // MOV r32, [base + disp] — 8B /r (no REX.W)
    if op == "MOV" && len(ops) == 2 && ops[1].substring(0, 1) == "[" {
        let rd = _ex86_reg32(ops[0])
        let mem = _ex86_parse_mem(ops[1])
        if rd >= 0 && mem[0] >= 0 {
            let base = mem[0]; let disp = mem[1]
            // REX needed only if base >= 8 (REX.B). Skip REX for low regs.
            let out: [Int] = []
            if base >= 8 {
                out.push(_ex86_rex(0, 0, 0, 1))
            }
            out.push(0x8b)
            let mr = _ex86_modrm_mem(rd, base, disp)
            let mut i = 0
            while i < len(mr) { out.push(mr[i]); i = i + 1 }
            return out
        }
    }
    // MOV [base + disp], r32 — 89 /r (no REX.W)
    if op == "MOV" && len(ops) == 2 && ops[0].substring(0, 1) == "[" {
        let mem = _ex86_parse_mem(ops[0])
        let rs = _ex86_reg32(ops[1])
        if rs >= 0 && mem[0] >= 0 {
            let base = mem[0]; let disp = mem[1]
            let out: [Int] = []
            if base >= 8 {
                out.push(_ex86_rex(0, 0, 0, 1))
            }
            out.push(0x89)
            let mr = _ex86_modrm_mem(rs, base, disp)
            let mut i = 0
            while i < len(mr) { out.push(mr[i]); i = i + 1 }
            return out
        }
    }
    // LEA64 r64, [base + disp] — REX.W + 8D /r
    if op == "LEA64" && len(ops) == 2 && ops[1].substring(0, 1) == "[" {
        let rd = _ex86_reg64(ops[0])
        let mem = _ex86_parse_mem(ops[1])
        if rd >= 0 && mem[0] >= 0 {
            let base = mem[0]; let disp = mem[1]
            let rex = _ex86_rex(1, if rd   >= 8 { 1 } else { 0 }, 0,
                                    if base >= 8 { 1 } else { 0 })
            let mr = _ex86_modrm_mem(rd, base, disp)
            let out: [Int] = []
            out.push(rex); out.push(0x8d)
            let mut i = 0
            while i < len(mr) { out.push(mr[i]); i = i + 1 }
            return out
        }
    }
    // PUSH64 r64 — 50+rd ; REX.B (41) for r8..r15. Same opcode byte as
    // PUSH r32 in 32-bit mode; in long mode default-64 operand size,
    // so this also covers `push rax` etc. distinct from cycle 25's
    // 32-bit `push eax` rule via the r64 reg-name match.
    if op == "PUSH64" && len(ops) == 1 {
        let rd = _ex86_reg64(ops[0])
        if rd >= 0 {
            if rd < 8 { return [0x50 + rd] }
            return [0x41, 0x50 + (rd & 0x7)]
        }
    }
    // POP64 r64 — 58+rd ; REX.B (41) for r8..r15.
    if op == "POP64" && len(ops) == 1 {
        let rd = _ex86_reg64(ops[0])
        if rd >= 0 {
            if rd < 8 { return [0x58 + rd] }
            return [0x41, 0x58 + (rd & 0x7)]
        }
    }
    // MOV64 r64, r64 — REX.W + 89 /r (reg-reg form, no mem). This was
    // already in cycle 26 but earlier in the function; keep that path
    // authoritative and skip a second definition here.

    // ── Cycle 28 additions — zero-extend / set-byte-on-condition ──
    //
    // MOVZX r32, r8 — 0F B6 /r (low-byte zero-extend to 32-bit).
    // 1-byte source register encoding: AL=0, CL=1, DL=2, BL=3,
    // SPL=4 (REX), BPL=5 (REX), SIL=6 (REX), DIL=7 (REX). For r8-r15
    // low-byte SPL/BPL/SIL/DIL we need REX (any REX byte forces new
    // encoding). Common case here is AL/CL/DL/BL → no REX needed.
    if op == "MOVZX" && len(ops) == 2 {
        let rd = _ex86_reg32(ops[0])
        let rs = _ex86_reg8(ops[1])
        if rd >= 0 && rs >= 0 {
            // No REX for AL/CL/DL/BL → 0F B6 /r (3 B).
            if rs <= 3 && rd <= 7 {
                return [0x0f, 0xb6, 0xc0 | ((rd & 0x7) << 3) | (rs & 0x7)]
            }
            // REX path for high-byte regs (SPL..DIL or r8b..r15b).
            let rex = _ex86_rex(0, if rd >= 8 { 1 } else { 0 }, 0,
                                    if rs >= 8 { 1 } else { 0 })
            return [rex, 0x0f, 0xb6,
                    0xc0 | ((rd & 0x7) << 3) | (rs & 0x7)]
        }
    }
    // ③-R2e: MOVZX r64, r8 — REX.W + 0F B6 /r (4 B). The codegen zero-extends
    // a setcc byte into a 64-bit POOL reg (rbx/r12../r10) via `movzx <r64>, al`
    // (the dst is always a 64-bit name — _x86_dst_reg / the callee-saved pool),
    // which the reg32 arm above rejects (reg32 has no r64 name → ENCODE-MISS).
    // A 32-bit movzx already zeroes bits 63:32, so REX.W is byte-distinct but
    // semantically identical (GNU as `movzbq`). reg = DEST(r64), rm = SRC(r8).
    //   e.g. movzx r12, al → 4c 0f b6 e0
    if op == "MOVZX" && len(ops) == 2 {
        let rd = _ex86_reg64(ops[0])
        let rs = _ex86_reg8(ops[1])
        if rd >= 0 && rs >= 0 {
            let rex = _ex86_rex(1, if rd >= 8 { 1 } else { 0 }, 0,
                                    if rs >= 8 { 1 } else { 0 })
            return [rex, 0x0f, 0xb6,
                    0xc0 | ((rd & 0x7) << 3) | (rs & 0x7)]
        }
    }
    // ── ③-R2f additions — SIZE-prefixed memory-operand LABEL family ──────────
    // The codegen (x86_64_linux.hexa) emits va_arg / ptr_load* / ptr_store* /
    // arr_len / str_byte through `_x86_op_label("<size> ptr [base ± disp]")`
    // (and `_x86_va_memsz`), i.e. a `kind:"label"` operand carrying the whole
    // mem string. The existing `[base ± disp]` mem arms only match a leading
    // `[`, so these size-prefixed strings hit the loud ENCODE-MISS. Parse them
    // via `_ex86_parse_ptr_mem` and emit the reference-matched ModR/M+SIB+disp
    // mem form. Reg width comes from the SIZE PREFIX (not MOV vs MOV64), so a
    // single check covers both dispatch outcomes (r10d→MOV64, eax→MOV).
    // Reference: Intel SDM Vol 2 — MOVZX (0F B6/B7 /r), MOV (8B/89, 88 /r).
    //
    // MOVZX r64, byte/word ptr [base ± disp] — REX.W 0F B6 (byte) / B7 (word)
    // /r. Codegen dst is always r64 (r10) → zero-extend to 64 bits.
    //   e.g. movzx r10, byte ptr [r10]  → 4d 0f b6 12
    if op == "MOVZX" && len(ops) == 2 {
        let pm = _ex86_parse_ptr_mem(ops[1])
        if pm[0] == 1 || pm[0] == 2 {
            let rd = _ex86_reg64(ops[0])
            if rd >= 0 {
                let base = pm[1]; let disp = pm[2]
                let rex = _ex86_rex(1, if rd >= 8 { 1 } else { 0 }, 0,
                                        if base >= 8 { 1 } else { 0 })
                let opcode = if pm[0] == 1 { 0xb6 } else { 0xb7 }
                let mr = _ex86_modrm_mem(rd, base, disp)
                let out: [Int] = []
                out.push(rex); out.push(0x0f); out.push(opcode)
                let mut i = 0
                while i < len(mr) { out.push(mr[i]); i = i + 1 }
                return out
            }
        }
    }
    // MOV — LOAD form: dst reg, src `<size> ptr [base ± disp]` (mem = ops[1]).
    //   dword: 8B /r (no REX.W) — dst r32 (eax / r10d).  e.g.
    //     mov eax,  dword ptr [r10]     → 41 8b 02
    //     mov r10d, dword ptr [r10 + 8] → 45 8b 52 08
    //   qword: REX.W 8B /r — dst r64 (r10). e.g. mov r10, qword ptr [r10] → 4d 8b 12
    if (op == "MOV" || op == "MOV64") && len(ops) == 2 {
        let pm = _ex86_parse_ptr_mem(ops[1])
        if pm[0] == 4 || pm[0] == 8 {
            let base = pm[1]; let disp = pm[2]
            if pm[0] == 4 {
                let rd = _ex86_reg32e(ops[0])
                if rd >= 0 {
                    let out: [Int] = []
                    if rd >= 8 || base >= 8 {
                        out.push(_ex86_rex(0, if rd >= 8 { 1 } else { 0 }, 0,
                                              if base >= 8 { 1 } else { 0 }))
                    }
                    out.push(0x8b)
                    let mr = _ex86_modrm_mem(rd, base, disp)
                    let mut i = 0
                    while i < len(mr) { out.push(mr[i]); i = i + 1 }
                    return out
                }
            } else {
                let rd = _ex86_reg64(ops[0])
                if rd >= 0 {
                    let rex = _ex86_rex(1, if rd >= 8 { 1 } else { 0 }, 0,
                                            if base >= 8 { 1 } else { 0 })
                    let mr = _ex86_modrm_mem(rd, base, disp)
                    let out: [Int] = []
                    out.push(rex); out.push(0x8b)
                    let mut i = 0
                    while i < len(mr) { out.push(mr[i]); i = i + 1 }
                    return out
                }
            }
        }
    }
    // MOV — STORE form: dst `<size> ptr [base ± disp]`, src reg (mem = ops[0]).
    //   byte:  88 /r        — src r8  (sil).  e.g. mov byte ptr [r10], sil → 41 88 32
    //   dword: 89 /r        — src r32 (esi / eax / r11d). e.g.
    //     mov dword ptr [r10], esi        → 41 89 32
    //     mov dword ptr [rbp + 0], r11d   → 44 89 5d 00
    //   qword: REX.W 89 /r  — src r64 (rsi / r11 / r8). e.g. mov qword ptr [r10], r11 → 4d 89 1a
    if (op == "MOV" || op == "MOV64") && len(ops) == 2 {
        let pm = _ex86_parse_ptr_mem(ops[0])
        if pm[0] == 1 || pm[0] == 4 || pm[0] == 8 {
            let base = pm[1]; let disp = pm[2]
            if pm[0] == 1 {
                let rs = _ex86_reg8(ops[1])
                if rs >= 0 {
                    let out: [Int] = []
                    // spl/bpl/sil/dil (rs 4..7) or r8b..r15b force a REX byte.
                    if rs >= 4 || base >= 8 {
                        out.push(_ex86_rex(0, if rs >= 8 { 1 } else { 0 }, 0,
                                              if base >= 8 { 1 } else { 0 }))
                    }
                    out.push(0x88)
                    let mr = _ex86_modrm_mem(rs, base, disp)
                    let mut i = 0
                    while i < len(mr) { out.push(mr[i]); i = i + 1 }
                    return out
                }
            } else if pm[0] == 4 {
                let rs = _ex86_reg32e(ops[1])
                if rs >= 0 {
                    let out: [Int] = []
                    if rs >= 8 || base >= 8 {
                        out.push(_ex86_rex(0, if rs >= 8 { 1 } else { 0 }, 0,
                                              if base >= 8 { 1 } else { 0 }))
                    }
                    out.push(0x89)
                    let mr = _ex86_modrm_mem(rs, base, disp)
                    let mut i = 0
                    while i < len(mr) { out.push(mr[i]); i = i + 1 }
                    return out
                }
            } else {
                let rs = _ex86_reg64(ops[1])
                if rs >= 0 {
                    let rex = _ex86_rex(1, if rs >= 8 { 1 } else { 0 }, 0,
                                            if base >= 8 { 1 } else { 0 })
                    let mr = _ex86_modrm_mem(rs, base, disp)
                    let out: [Int] = []
                    out.push(rex); out.push(0x89)
                    let mut i = 0
                    while i < len(mr) { out.push(mr[i]); i = i + 1 }
                    return out
                }
            }
        }
    }
    // SETcc r8 — 0F 9x /r (set 1 byte on condition).
    //   SETE   0F 94    (==, ZF=1)
    //   SETNE  0F 95    (!=, ZF=0)
    //   SETL   0F 9C    (signed <, SF≠OF)
    //   SETGE  0F 9D    (signed >=, SF=OF)
    //   SETLE  0F 9E    (signed <=, ZF=1 or SF≠OF)
    //   SETG   0F 9F    (signed >, ZF=0 and SF=OF)
    // Operand is r8 (AL/CL/DL/BL by default; SPL..DIL via REX).
    // R2d (axis-③) adds the unsigned/float setcc: SETA 0F 97 · SETAE 0F 93 ·
    // SETB 0F 92 · SETBE 0F 96 (same ModR/M + REX shape as the signed six).
    if (op == "SETE" || op == "SETNE" ||
        op == "SETL" || op == "SETGE" ||
        op == "SETLE" || op == "SETG" ||
        op == "SETA" || op == "SETAE" ||
        op == "SETB" || op == "SETBE") && len(ops) == 1 {
        let rd = _ex86_reg8(ops[0])
        if rd >= 0 {
            let mut opcode = 0
            if op == "SETE"  { opcode = 0x94 }
            if op == "SETNE" { opcode = 0x95 }
            if op == "SETL"  { opcode = 0x9c }
            if op == "SETGE" { opcode = 0x9d }
            if op == "SETLE" { opcode = 0x9e }
            if op == "SETG"  { opcode = 0x9f }
            if op == "SETA"  { opcode = 0x97 }
            if op == "SETAE" { opcode = 0x93 }
            if op == "SETB"  { opcode = 0x92 }
            if op == "SETBE" { opcode = 0x96 }
            if rd <= 3 {
                return [0x0f, opcode, 0xc0 | (rd & 0x7)]
            }
            // REX path for SPL..DIL (rd=4..7 force REX) or r8..r15.
            let rex = _ex86_rex(0, 0, 0, if rd >= 8 { 1 } else { 0 })
            return [rex, 0x0f, opcode, 0xc0 | (rd & 0x7)]
        }
    }

    // ── ③-R2a additions — integer-ALU completion (own-emit path) ──────
    // Reference-matched x86-64 opcode/ModR/M/REX against Intel SDM Vol 2,
    // mirroring the ADD64/SUB64 reg-reg + 81-imm idiom above. 64-bit
    // (REX.W) forms only — the codegen (x86_64_linux.hexa) emits these ops
    // solely through r64 operands (r10/r11/rax/rdx…), so any non-64 variant
    // correctly falls through to the loud ENCODE-MISS below. Byte-neutral
    // for the shipping compiler (built via the C-transpile path, not this
    // walker); only `--emit=exec`/own-emit exercises these bytes.

    // IMUL r64, r64 — REX.W + 0F AF /r (4 B). NOTE: 0F AF is a
    // reg-is-DESTINATION two-byte opcode, so ModR/M.reg = DEST, rm = SRC
    // (unlike ADD's 01 /r where reg = SRC).  e.g. imul r10, r11 → 4d 0f af d3
    if op == "IMUL64" && len(ops) == 2 && ops[1].substring(0, 1) != "#" {
        let rd = _ex86_reg64(ops[0])
        let rs = _ex86_reg64(ops[1])
        if rd >= 0 && rs >= 0 {
            let rex = _ex86_rex(1, if rd >= 8 { 1 } else { 0 }, 0,
                                    if rs >= 8 { 1 } else { 0 })
            return [rex, 0x0f, 0xaf, 0xc0 | ((rd & 0x7) << 3) | (rs & 0x7)]
        }
    }
    // R2d: conditional move CMOVcc r64, r64 — REX.W 0F 4x /r (reg = DEST,
    // rm = SRC), same reg-is-dest form as IMUL64 (0F AF). CMOVE 44 · CMOVNE 45.
    if (op == "CMOVE64" || op == "CMOVNE64") && len(ops) == 2 {
        let rd = _ex86_reg64(ops[0])
        let rs = _ex86_reg64(ops[1])
        if rd >= 0 && rs >= 0 {
            let mut cc = 0x44
            if op == "CMOVNE64" { cc = 0x45 }
            let rex = _ex86_rex(1, if rd >= 8 { 1 } else { 0 }, 0,
                                    if rs >= 8 { 1 } else { 0 })
            return [rex, 0x0f, cc, 0xc0 | ((rd & 0x7) << 3) | (rs & 0x7)]
        }
    }
    // IMUL r64, r64, imm32 — REX.W + 69 /r id (7 B). reg = DEST, rm = SRC,
    // then imm32 LE.  e.g. imul rax, rax, 16 → 48 69 c0 10 00 00 00
    if op == "IMUL64" && len(ops) == 3 && ops[2].substring(0, 1) == "#" {
        let rd = _ex86_reg64(ops[0])
        let rs = _ex86_reg64(ops[1])
        let imm = _ex86_imm(ops[2])
        if rd >= 0 && rs >= 0 {
            let rex = _ex86_rex(1, if rd >= 8 { 1 } else { 0 }, 0,
                                    if rs >= 8 { 1 } else { 0 })
            let modrm = 0xc0 | ((rd & 0x7) << 3) | (rs & 0x7)
            return [rex, 0x69, modrm,
                    imm & 0xff, (imm >> 8) & 0xff,
                    (imm >> 16) & 0xff, (imm >> 24) & 0xff]
        }
    }
    // IMUL r/m64 (1-op) — REX.W + F7 /5 (3 B). RDX:RAX = RAX * r/m64
    // (full 128-bit signed product, hi → RDX). Used by the magicdiv path.
    //   e.g. imul r11 → 49 f7 eb
    if op == "IMUL64" && len(ops) == 1 {
        let rd = _ex86_reg64(ops[0])
        if rd >= 0 {
            let rex = _ex86_rex(1, 0, 0, if rd >= 8 { 1 } else { 0 })
            return [rex, 0xf7, 0xc0 | (5 << 3) | (rd & 0x7)]
        }
    }
    // AND/OR/XOR r64, r64 — REX.W + {21,09,31} /r (3 B). Mirrors ADD's
    // 01 /r reg-reg exactly: ModR/M.reg = SRC, rm = DEST.
    //   e.g. xor rax, rax → 48 31 c0 (zeroing idiom) · and r10,r11 → 4d 21 da
    if (op == "AND64" || op == "OR64" || op == "XOR64") && len(ops) == 2
       && ops[1].substring(0, 1) != "#" {
        let rd = _ex86_reg64(ops[0])
        let rs = _ex86_reg64(ops[1])
        if rd >= 0 && rs >= 0 {
            let mut opc = 0x21
            if op == "OR64"  { opc = 0x09 }
            if op == "XOR64" { opc = 0x31 }
            let rex = _ex86_rex(1, if rs >= 8 { 1 } else { 0 }, 0,
                                    if rd >= 8 { 1 } else { 0 })
            return [rex, opc, 0xc0 | ((rs & 0x7) << 3) | (rd & 0x7)]
        }
    }
    // AND/OR/XOR r64, imm32 — REX.W + 81 /N id (7 B). /N: AND=4 OR=1 XOR=6.
    // Mirrors ADD/SUB/CMP r64, #imm32 (81 /0,/5,/7).
    if (op == "AND64" || op == "OR64" || op == "XOR64") && len(ops) == 2
       && ops[1].substring(0, 1) == "#" {
        let rd = _ex86_reg64(ops[0])
        let imm = _ex86_imm(ops[1])
        if rd >= 0 {
            let mut ext = 4
            if op == "OR64"  { ext = 1 }
            if op == "XOR64" { ext = 6 }
            let rex = _ex86_rex(1, 0, 0, if rd >= 8 { 1 } else { 0 })
            let modrm = 0xc0 | (ext << 3) | (rd & 0x7)
            return [rex, 0x81, modrm,
                    imm & 0xff, (imm >> 8) & 0xff,
                    (imm >> 16) & 0xff, (imm >> 24) & 0xff]
        }
    }
    // SHL/SHR/SAR r64, imm8 — REX.W + C1 /N ib (4 B). /N: SHL=4 SHR=5 SAR=7.
    //   e.g. shr rax, 63 → 48 c1 e8 3f · sar rdx, s → 48 c1 fa <s>
    if (op == "SHL64" || op == "SHR64" || op == "SAR64") && len(ops) == 2
       && ops[1].substring(0, 1) == "#" {
        let rd = _ex86_reg64(ops[0])
        let imm = _ex86_imm(ops[1])
        if rd >= 0 {
            let mut ext = 4
            if op == "SHR64" { ext = 5 }
            if op == "SAR64" { ext = 7 }
            let rex = _ex86_rex(1, 0, 0, if rd >= 8 { 1 } else { 0 })
            return [rex, 0xc1, 0xc0 | (ext << 3) | (rd & 0x7), imm & 0xff]
        }
    }
    // SHL/SHR/SAR r64, cl — REX.W + D3 /N (3 B). Variable count in CL.
    //   e.g. shl r10, cl → 49 d3 e2
    if (op == "SHL64" || op == "SHR64" || op == "SAR64") && len(ops) == 2
       && (ops[1] == "cl" || ops[1] == "CL") {
        let rd = _ex86_reg64(ops[0])
        if rd >= 0 {
            let mut ext = 4
            if op == "SHR64" { ext = 5 }
            if op == "SAR64" { ext = 7 }
            let rex = _ex86_rex(1, 0, 0, if rd >= 8 { 1 } else { 0 })
            return [rex, 0xd3, 0xc0 | (ext << 3) | (rd & 0x7)]
        }
    }
    // NEG/NOT r64 — REX.W + F7 /{3,2} (3 B). Unary two's-/ones-complement.
    // (Additive: no codegen emitter today; completes ALU parity with `as`.)
    //   e.g. neg rax → 48 f7 d8 · not rax → 48 f7 d0
    if (op == "NEG64" || op == "NOT64") && len(ops) == 1 {
        let rd = _ex86_reg64(ops[0])
        if rd >= 0 {
            let ext = if op == "NEG64" { 3 } else { 2 }
            let rex = _ex86_rex(1, 0, 0, if rd >= 8 { 1 } else { 0 })
            return [rex, 0xf7, 0xc0 | (ext << 3) | (rd & 0x7)]
        }
    }
    // MOVSXD r64, r32 — REX.W + 63 /r (3 B). Sign-extend 32→64.
    // reg = DEST(r64), rm = SRC(r32). (Additive: no codegen emitter today.)
    //   e.g. movsxd rax, ecx → 48 63 c1
    if op == "MOVSXD64" && len(ops) == 2 {
        let rd = _ex86_reg64(ops[0])
        let rs = _ex86_reg32(ops[1])
        if rd >= 0 && rs >= 0 {
            let rex = _ex86_rex(1, if rd >= 8 { 1 } else { 0 }, 0,
                                    if rs >= 8 { 1 } else { 0 })
            return [rex, 0x63, 0xc0 | ((rd & 0x7) << 3) | (rs & 0x7)]
        }
    }

    // ── ③-R2b additions — SSE scalar-double float family (own-emit) ──────
    // Reference-matched against Intel SDM Vol 2 (SSE2 scalar double). The
    // codegen (x86_64_linux.hexa `__hx_payload_f*`/`__hx_to_double`/f2i/i2f)
    // emits these with xmm0/xmm1 + r10/r11 reg-reg operands only — mem forms
    // fall through to the loud ENCODE-MISS below. Encoding order is
    // [mandatory prefix F2/66] [REX] [0F] [opcode] [ModR/M] (the mandatory
    // prefix precedes REX per SDM §2.2.1). Byte-neutral for the shipping
    // compiler (built via C-transpile, not this walker); only own-emit
    // exercises these bytes.

    // MOVQ — GP↔xmm 64-bit bit copy (the fp-payload ingress/egress the
    // codegen uses via `movq xmm, r64` / `movq r64, xmm`). Two forms keyed
    // by which operand is the xmm register:
    //   movq xmm, r/m64 : 66 REX.W 0F 6E /r  (reg=xmm dest, rm=GP src)
    //   movq r/m64, xmm : 66 REX.W 0F 7E /r  (reg=xmm src,  rm=GP dest)
    //   e.g. movq xmm0, r10 → 66 49 0f 6e c2 · movq r10, xmm0 → 66 49 0f 7e c2
    if op == "MOVQ" && len(ops) == 2 {
        let xd = _ex86_xmm(ops[0])
        let xs = _ex86_xmm(ops[1])
        if xd >= 0 && xs < 0 {
            // GP→xmm : dest is xmm (ops[0]), src is GP (ops[1]).
            let gp = _ex86_reg64(ops[1])
            if gp >= 0 {
                let rex = _ex86_rex(1, if xd >= 8 { 1 } else { 0 }, 0,
                                        if gp >= 8 { 1 } else { 0 })
                return [0x66, rex, 0x0f, 0x6e,
                        0xc0 | ((xd & 0x7) << 3) | (gp & 0x7)]
            }
        }
        if xd < 0 && xs >= 0 {
            // xmm→GP : dest is GP (ops[0]), src is xmm (ops[1]).
            let gp = _ex86_reg64(ops[0])
            if gp >= 0 {
                let rex = _ex86_rex(1, if xs >= 8 { 1 } else { 0 }, 0,
                                        if gp >= 8 { 1 } else { 0 })
                return [0x66, rex, 0x0f, 0x7e,
                        0xc0 | ((xs & 0x7) << 3) | (gp & 0x7)]
            }
        }
    }
    // MOVSD xmm1, xmm2 — F2 0F 10 /r (scalar-double reg-reg move). reg=dest,
    // rm=src. (Additive: no codegen emitter today — scalar spills would use
    // it; mem forms 10/11 land when the codegen needs a stack home.)
    //   e.g. movsd xmm0, xmm1 → f2 0f 10 c1
    if op == "MOVSD" && len(ops) == 2 {
        let xd = _ex86_xmm(ops[0])
        let xs = _ex86_xmm(ops[1])
        if xd >= 0 && xs >= 0 {
            let out: [Int] = []
            out.push(0xf2)
            if xd >= 8 || xs >= 8 {
                out.push(_ex86_rex(0, if xd >= 8 { 1 } else { 0 }, 0,
                                      if xs >= 8 { 1 } else { 0 }))
            }
            out.push(0x0f); out.push(0x10)
            out.push(0xc0 | ((xd & 0x7) << 3) | (xs & 0x7))
            return out
        }
    }
    // ADDSD/SUBSD/MULSD/DIVSD xmm1, xmm2 — F2 0F {58,5C,59,5E} /r (3-4 B).
    // reg=dest xmm (ops[0]), rm=src xmm (ops[1]). No REX.W (operand size is
    // implied by the F2 + 0F opcode). REX only for xmm8..15.
    //   e.g. addsd xmm0, xmm1 → f2 0f 58 c1 · divsd xmm0, xmm1 → f2 0f 5e c1
    if (op == "ADDSD" || op == "SUBSD" || op == "MULSD" || op == "DIVSD")
       && len(ops) == 2 {
        let xd = _ex86_xmm(ops[0])
        let xs = _ex86_xmm(ops[1])
        if xd >= 0 && xs >= 0 {
            let mut opc = 0x58              // ADDSD
            if op == "SUBSD" { opc = 0x5c }
            if op == "MULSD" { opc = 0x59 }
            if op == "DIVSD" { opc = 0x5e }
            let out: [Int] = []
            out.push(0xf2)
            if xd >= 8 || xs >= 8 {
                out.push(_ex86_rex(0, if xd >= 8 { 1 } else { 0 }, 0,
                                      if xs >= 8 { 1 } else { 0 }))
            }
            out.push(0x0f); out.push(opc)
            out.push(0xc0 | ((xd & 0x7) << 3) | (xs & 0x7))
            return out
        }
    }
    // COMISD / UCOMISD xmm1, xmm2 — 66 0F {2F,2E} /r. Ordered/unordered
    // scalar-double compare → EFLAGS (the NaN-correct `comisd`+`seta` idiom
    // the codegen emits for float </<=/>/>=). 66 prefix (NOT F2). reg=ops[0],
    // rm=ops[1].  e.g. comisd xmm0, xmm1 → 66 0f 2f c1
    if (op == "COMISD" || op == "UCOMISD") && len(ops) == 2 {
        let xd = _ex86_xmm(ops[0])
        let xs = _ex86_xmm(ops[1])
        if xd >= 0 && xs >= 0 {
            let opc = if op == "COMISD" { 0x2f } else { 0x2e }
            let out: [Int] = []
            out.push(0x66)
            if xd >= 8 || xs >= 8 {
                out.push(_ex86_rex(0, if xd >= 8 { 1 } else { 0 }, 0,
                                      if xs >= 8 { 1 } else { 0 }))
            }
            out.push(0x0f); out.push(opc)
            out.push(0xc0 | ((xd & 0x7) << 3) | (xs & 0x7))
            return out
        }
    }
    // CVTSI2SD xmm, r/m64 — F2 REX.W 0F 2A /r (signed int64 → double).
    // reg=dest xmm (ops[0]), rm=src GP (ops[1]). REX.W=1 for the 64-bit
    // integer source.  e.g. cvtsi2sd xmm0, r10 → f2 49 0f 2a c2
    if op == "CVTSI2SD" && len(ops) == 2 {
        let xd = _ex86_xmm(ops[0])
        let gp = _ex86_reg64(ops[1])
        if xd >= 0 && gp >= 0 {
            let rex = _ex86_rex(1, if xd >= 8 { 1 } else { 0 }, 0,
                                    if gp >= 8 { 1 } else { 0 })
            return [0xf2, rex, 0x0f, 0x2a,
                    0xc0 | ((xd & 0x7) << 3) | (gp & 0x7)]
        }
    }
    // CVTTSD2SI r64, xmm/m64 — F2 REX.W 0F 2C /r (double → signed int64,
    // truncating toward zero). reg=dest GP (ops[0]), rm=src xmm (ops[1]).
    // REX.W=1 for the 64-bit integer destination.
    //   e.g. cvttsd2si r10, xmm0 → f2 4c 0f 2c d0
    if op == "CVTTSD2SI" && len(ops) == 2 {
        let gp = _ex86_reg64(ops[0])
        let xs = _ex86_xmm(ops[1])
        if gp >= 0 && xs >= 0 {
            let rex = _ex86_rex(1, if gp >= 8 { 1 } else { 0 }, 0,
                                    if xs >= 8 { 1 } else { 0 })
            return [0xf2, rex, 0x0f, 0x2c,
                    0xc0 | ((gp & 0x7) << 3) | (xs & 0x7)]
        }
    }

    // ── Loud fall-through — was a silent `return []` (corrupt text). ──
    // Mirror macho_arm64.hexa's ENCODE-MISS: an op the encoder can't
    // encode is now a VISIBLE error on the own-emit path, not a
    // zero-length silent drop that ships corrupt machine code.
    eprintln("ENCODE-MISS (x86_64): " + op + " nargs=" + to_string(len(ops)))
    return []
}

// ─────────────────────────────────────────────────────────────────
// link_elf_x86_64 — P2 cycle 4: ELF multi-obj static-link
// ─────────────────────────────────────────────────────────────────
//
// Mirror of P1's `link_macho_arm64` but for ELF. Take N ElfX86Obj +
// concat their texts, resolve inter-obj CALL relocations, wrap in
// ET_EXEC PT_LOAD shell.
//
// Reloc handling (cycle 4 minimal):
//   - R_X86_64_PLT32 (kind=4) / R_X86_64_PC32 (kind=2): patch the
//     CALL instruction's imm32 field with the PC-relative offset to
//     the target symbol. Per x86_64 convention, the offset is
//     measured from the END of the CALL (so patch_addr+4-byte for
//     the imm32 field; target = sym_addr; delta = sym_addr -
//     (patch_addr + 4) + addend).
pub fn link_elf_x86_64(objs: [ElfX86Obj], out_path: string, entry: string) -> Int {
    // Concatenate text + record per-obj base + global symbol map.
    let mut text_bytes: [Int] = []
    let mut entry_off = 0
    let mut entry_found = false
    let mut def_names:   [string] = []
    let mut def_offsets: [Int]    = []
    let mut obj_bases:   [Int]    = []
    let mut obj_strtab_local: [string] = []     // running per-obj sym-name resolution

    let mut oi = 0
    while oi < len(objs) {
        let obj = objs[oi]
        let base = len(text_bytes)
        obj_bases.push(base)
        // Resolve each symbol's name from the obj's local strtab.
        let mut di = 0
        while di < len(obj.symbols) {
            let s = obj.symbols[di]
            // Read name from strtab starting at s.name_offset (NUL-term).
            let mut name = ""
            let mut k = 0
            while true {
                let b = obj.strtab[s.name_offset + k] & 0xff
                if b == 0 { break }
                name = name + from_char_code(b)
                k = k + 1
            }
            // Defined (section != 0) → global map.
            if s.section != 0 {
                def_names.push(name)
                def_offsets.push(base + s.value)
                if !entry_found && name == entry {
                    entry_off = base + s.value
                    entry_found = true
                }
            }
            di = di + 1
        }
        // Append text.
        let mut ti = 0
        while ti < len(obj.text) {
            text_bytes.push(obj.text[ti] & 0xff)
            ti = ti + 1
        }
        oi = oi + 1
    }
    if !entry_found {
        eprintln("hexa_ld(elf): entry '" + entry + "' not defined in any obj")
        return 3
    }

    // Resolve relocations.
    let mut ro = 0
    while ro < len(objs) {
        let obj = objs[ro]
        let base = obj_bases[ro]
        let mut ri = 0
        while ri < len(obj.relocs) {
            let r = obj.relocs[ri]
            // Look up target sym name via the obj's symtab + strtab.
            let sym = obj.symbols[r.sym_idx]
            let mut name = ""
            let mut k = 0
            while true {
                let b = obj.strtab[sym.name_offset + k] & 0xff
                if b == 0 { break }
                name = name + from_char_code(b)
                k = k + 1
            }
            // Find target in global defined map.
            let mut found_idx = -1
            let mut sk = 0
            while sk < len(def_names) {
                if def_names[sk] == name { found_idx = sk; break }
                sk = sk + 1
            }
            if found_idx >= 0 {
                let tgt_off = def_offsets[found_idx]
                // ELF reloc formula: imm32 = S + A - P
                //   S = target symbol's address (here a text offset
                //       since we omit the vaddr base — both target
                //       and patch live in the same segment).
                //   A = addend (e.g. -4 for x86_64 CALL).
                //   P = patch site address (the imm32 field).
                // For CALL E8 imm32, A=-4 reproduces the canonical
                // imm32 = target - call_start - 5 (call_start =
                // patch_off - 1, so imm32 = target - patch_off - 4).
                let patch_off = base + r.offset
                let delta = tgt_off + r.addend - patch_off
                text_bytes[patch_off + 0] = delta & 0xff
                text_bytes[patch_off + 1] = (delta >> 8) & 0xff
                text_bytes[patch_off + 2] = (delta >> 16) & 0xff
                text_bytes[patch_off + 3] = (delta >> 24) & 0xff
            }
            ri = ri + 1
        }
        ro = ro + 1
    }

    // The exec's entry symbol must be at offset 0 of __text for our
    // minimal PT_LOAD layout (e_entry = vaddr_base + code_off where
    // code_off is the file position of the FIRST byte of text). If
    // entry symbol isn't at offset 0, shift the entry's text to the
    // front. For cycle 4 we require entry@offset 0 (caller's
    // responsibility) — entry_off != 0 returns rc=4.
    if entry_off != 0 {
        eprintln("hexa_ld(elf): entry symbol must be at text offset 0 (got " +
                 to_string(entry_off) + ")")
        return 4
    }

    let bytes = serialize_elf_exec_x86_64(text_bytes)
    write_bytes(out_path, bytes)
    return 0
}

// ────────────────────────────────────────────────
// link_elf_x86_64_ownstart — axis-② own-start ELF static-exec link
// ────────────────────────────────────────────────
//
// Round-1 (exit-code-only) own-start wrapper over link_elf_x86_64's
// body. Prepends a 14-byte `_start` stub at text offset 0 so the ET_EXEC
// needs NO crt1.o / -lc / -dynamic-linker: the kernel enters at _start,
// which calls `main`, forwards main's return (EAX) into EDI and issues
// the exit syscall directly.
//
// _start (14 bytes = 5+2+5+2):
//   E8 00 00 00 00   call  main          ; rel32 patched below (offs 1..4)
//   89 D7            mov   edi, edx       ; exit code = main()'s HexaVal PAYLOAD
//   B8 3C 00 00 00   mov   eax, 60        ; __NR_exit
//   0F 05            syscall
//
// PAIR-MODEL note: every user .hexa fn returns a 16-byte HexaVal in the SysV
// integer pair rax=tag, rdx=payload (x86_64_linux.hexa _STMT_RETURN) — a user
// fn never returns a bare int in rax. So the exit code is the PAYLOAD (rdx),
// not the tag (rax): `mov edi, edx`. `return 42` -> rdx=42 -> exit(42); a
// value-less return is _x86_emit_zero_ret_pair's xor edx,edx -> exit(0). This
// own-start path adopts the C-canon "main's return IS the exit code"; the
// shipping C-transpile path still discards main's return (crt returns 0).
//
// Every obj symbol.value and reloc.offset is shifted by len(stub)=14
// because the text concat begins with `base = len(text_bytes) = 14` (the
// stub occupies [0,14)). PC-relative reloc deltas (S+A−P) are invariant
// under the shared +14 shift, so the reloc loop is byte-identical to
// link_elf_x86_64. Only the intra-stub `call main` rel32 is resolved
// here: rel32 = (main final offset) − (next-insn addr = 5); for main at
// obj-local value 0 that is 14 − 5 = 9.
//
// Round-2 (data-segment): extends the round-1 text-only path with a SECOND
// RW PT_LOAD carrying .rodata ++ .data (+ .bss reserved in p_memsz), so a
// program with string/const-literal data refs (e.g. print("hello") -> lea
// rip->.LCstr0, an R_X86_64_PC32) links into a running static ET_EXEC.
// Byte-identical to round-1 when NO obj carries data (single PT_LOAD via the
// untouched serialize_elf_exec_x86_64; text->text deltas are vaddr-base
// invariant). Data present -> serialize_elf_exec_x86_64_2seg (two PT_LOADs).
pub fn link_elf_x86_64_ownstart(objs: [ElfX86Obj], out_path: string, main_name: string) -> Int {
    // 14-byte own-start stub at text offset 0.
    let mut text_bytes: [Int] = []
    text_bytes.push(0xE8); text_bytes.push(0x00); text_bytes.push(0x00)
    text_bytes.push(0x00); text_bytes.push(0x00)          // call rel32 (patched)
    text_bytes.push(0x89); text_bytes.push(0xD7)          // mov edi, edx (HexaVal payload)
    text_bytes.push(0xB8); text_bytes.push(0x3C); text_bytes.push(0x00)
    text_bytes.push(0x00); text_bytes.push(0x00)          // mov eax, 60 (__NR_exit)
    text_bytes.push(0x0F); text_bytes.push(0x05)          // syscall
    // len(text_bytes) is now 14 — the +14 shift applied to every obj below.

    // Concatenated data blob (.rodata ++ .data per obj) for the RW segment.
    let mut data_bytes: [Int] = []
    let mut total_bss  = 0

    let mut main_off = -1
    // Defined-symbol map. def_seg = 0 for a .text def, 1 for a data-blob def;
    // def_off is the byte offset INSIDE that segment's blob (text offset for
    // text, data-blob offset for data). Converted to a vaddr AFTER the layout
    // constants (code_off / data_file_off) are known below.
    let mut def_names:   [string] = []
    let mut def_seg:     [Int]    = []
    let mut def_off:     [Int]    = []

    let mut obj_bases:       [Int] = []   // .text base per obj
    let mut obj_rodata_base: [Int] = []   // .rodata start in data_bytes per obj
    let mut obj_data_base:   [Int] = []   // .data   start in data_bytes per obj

    let mut oi = 0
    while oi < len(objs) {
        let obj = objs[oi]
        let base = len(text_bytes)        // >= 14 — the own-start shift
        obj_bases.push(base)

        // Append this obj's data blob: .rodata then .data (bss reserved later).
        let ro_base = len(data_bytes)
        obj_rodata_base.push(ro_base)
        let mut rri = 0
        while rri < len(obj.rodata) { data_bytes.push(obj.rodata[rri] & 0xff); rri = rri + 1 }
        let da_base = len(data_bytes)
        obj_data_base.push(da_base)
        let mut ddi = 0
        while ddi < len(obj.data) { data_bytes.push(obj.data[ddi] & 0xff); ddi = ddi + 1 }
        total_bss = total_bss + obj.bss_size

        let mut di = 0
        while di < len(obj.symbols) {
            let s = obj.symbols[di]
            let mut name = ""
            let mut k = 0
            while true {
                let b = obj.strtab[s.name_offset + k] & 0xff
                if b == 0 { break }
                name = name + from_char_code(b)
                k = k + 1
            }
            if s.section == 1 {
                // .text def -> segment 0, text offset.
                def_names.push(name)
                def_seg.push(0)
                def_off.push(base + s.value)
                if main_off < 0 && name == main_name {
                    main_off = base + s.value
                }
            } else if s.section == 5 {
                // .bss/COMMON def (round-3b) — no file bytes; lives in the data
                // segment's zero-fill region AFTER the concatenated .data blob
                // (p_memsz > p_filesz). def_seg==2 defers the (not-yet-final)
                // len(data_bytes) base to the resolve pass; def_off = this obj's
                // bss base (total_bss was advanced by obj.bss_size at the concat
                // loop top -> subtract it back) + the sym's obj-local bss value.
                def_names.push(name)
                def_seg.push(2)
                def_off.push((total_bss - obj.bss_size) + s.value)
            } else if s.section != 0 {
                // Data def. section==4 (data_sec when .rodata present) -> .data
                // pool; otherwise (section==3) -> .rodata pool. When the obj has
                // no .rodata its .data syms carry section==3 and ro_base==da_base,
                // so the .rodata branch still lands at the right blob offset.
                def_names.push(name)
                def_seg.push(1)
                if s.section >= 4 {
                    def_off.push(da_base + s.value)
                } else {
                    def_off.push(ro_base + s.value)
                }
            }
            di = di + 1
        }
        let mut ti = 0
        while ti < len(obj.text) {
            text_bytes.push(obj.text[ti] & 0xff)
            ti = ti + 1
        }
        oi = oi + 1
    }
    if main_off < 0 {
        eprintln("hexa_ld(elf,ownstart): entry '" + main_name + "' not defined in any obj")
        return 3
    }

    // Patch the `call main` rel32 (stub bytes 1..4). Next-insn addr = 5.
    let call_rel = main_off - 5
    text_bytes[1] = call_rel & 0xff
    text_bytes[2] = (call_rel >> 8) & 0xff
    text_bytes[3] = (call_rel >> 16) & 0xff
    text_bytes[4] = (call_rel >> 24) & 0xff

    // Layout constants — MUST match serialize_elf_exec_x86_64{,_2seg}.
    // No data blob -> single PT_LOAD (phnum=1, code_off=120): byte-identical
    // to round-1. Data present -> two PT_LOADs (phnum=2, code_off=176: R-X
    // text + RW rodata/data at a page-aligned vaddr above text).
    let vaddr_base = 0x400000
    let has_data   = (len(data_bytes) > 0) || (total_bss > 0)
    let phnum      = if has_data { 2 } else { 1 }
    let code_off   = 64 + 56 * phnum
    let text_end_file = code_off + len(text_bytes)
    // Page-align the data segment's file offset (=> p_vaddr === p_offset mod
    // 0x1000 holds and the R-X/RW pages never overlap). Same idiom as the
    // serializer's rodata_pad round-up.
    let data_file_off   = text_end_file + ((0x1000 - (text_end_file & 0xfff)) & 0xfff)
    let data_vaddr_base = vaddr_base + data_file_off

    // Resolve relocs in TRUE vaddr space. text->text reduces to the round-1
    // text-offset delta (vaddr_base+code_off cancels) => no-data path is
    // byte-identical; text->data uses the data segment's distinct vaddr.
    let mut ro = 0
    while ro < len(objs) {
        let obj = objs[ro]
        let base = obj_bases[ro]
        let mut ri = 0
        while ri < len(obj.relocs) {
            let r = obj.relocs[ri]
            let sym = obj.symbols[r.sym_idx]
            let mut name = ""
            let mut k = 0
            while true {
                let b = obj.strtab[sym.name_offset + k] & 0xff
                if b == 0 { break }
                name = name + from_char_code(b)
                k = k + 1
            }
            let mut found_idx = -1
            let mut sk = 0
            while sk < len(def_names) {
                if def_names[sk] == name { found_idx = sk; break }
                sk = sk + 1
            }
            if found_idx >= 0 {
                // Target symbol's virtual address (text seg / data seg / bss).
                let mut s_vaddr = 0
                if def_seg[found_idx] == 0 {
                    s_vaddr = vaddr_base + code_off + def_off[found_idx]
                } else if def_seg[found_idx] == 2 {
                    // .bss target — data-seg zero-fill region, after all .data.
                    s_vaddr = data_vaddr_base + len(data_bytes) + def_off[found_idx]
                } else {
                    s_vaddr = data_vaddr_base + def_off[found_idx]
                }
                // Site segment (round-3b): 3=rodata / 4=data land in the DATA blob
                // at the data-seg vaddr; anything else (1=text, or 0) patches .text.
                if r.site_seg == 3 || r.site_seg == 4 {
                    let blob_off = if r.site_seg == 4 { obj_data_base[ro] + r.offset } else { obj_rodata_base[ro] + r.offset }
                    let p_vaddr  = data_vaddr_base + blob_off
                    if r.kind == 1 {
                        let av = s_vaddr + r.addend
                        data_bytes[blob_off + 0] = av & 0xff
                        data_bytes[blob_off + 1] = (av >> 8) & 0xff
                        data_bytes[blob_off + 2] = (av >> 16) & 0xff
                        data_bytes[blob_off + 3] = (av >> 24) & 0xff
                        data_bytes[blob_off + 4] = (av >> 32) & 0xff
                        data_bytes[blob_off + 5] = (av >> 40) & 0xff
                        data_bytes[blob_off + 6] = (av >> 48) & 0xff
                        data_bytes[blob_off + 7] = (av >> 56) & 0xff
                    } else {
                        let delta = s_vaddr + r.addend - p_vaddr
                        data_bytes[blob_off + 0] = delta & 0xff
                        data_bytes[blob_off + 1] = (delta >> 8) & 0xff
                        data_bytes[blob_off + 2] = (delta >> 16) & 0xff
                        data_bytes[blob_off + 3] = (delta >> 24) & 0xff
                    }
                } else {
                    // Text-resident site (CALL imm32 / lea disp32) — round-1/2 path.
                    let patch_off = base + r.offset
                    let p_vaddr = vaddr_base + code_off + patch_off
                    if r.kind == 1 {
                        let av = s_vaddr + r.addend
                        text_bytes[patch_off + 0] = av & 0xff
                        text_bytes[patch_off + 1] = (av >> 8) & 0xff
                        text_bytes[patch_off + 2] = (av >> 16) & 0xff
                        text_bytes[patch_off + 3] = (av >> 24) & 0xff
                        text_bytes[patch_off + 4] = (av >> 32) & 0xff
                        text_bytes[patch_off + 5] = (av >> 40) & 0xff
                        text_bytes[patch_off + 6] = (av >> 48) & 0xff
                        text_bytes[patch_off + 7] = (av >> 56) & 0xff
                    } else {
                        let delta = s_vaddr + r.addend - p_vaddr
                        text_bytes[patch_off + 0] = delta & 0xff
                        text_bytes[patch_off + 1] = (delta >> 8) & 0xff
                        text_bytes[patch_off + 2] = (delta >> 16) & 0xff
                        text_bytes[patch_off + 3] = (delta >> 24) & 0xff
                    }
                }
            }
            ri = ri + 1
        }
        ro = ro + 1
    }

    // Serialize. No data -> single-PT_LOAD round-1 serializer (byte-identical);
    // data present -> two-segment serializer (R-X text + RW rodata/data).
    if has_data {
        write_bytes(out_path, serialize_elf_exec_x86_64_2seg(text_bytes, data_bytes, total_bss))
    } else {
        write_bytes(out_path, serialize_elf_exec_x86_64(text_bytes))
    }
    return 0
}

// ── RFC 063 § P3 round-3 Stage 4 — own-linker + runtime.a integration ──
//
// link_elf_x86_64_ownstart_ar — link the program ElfX86Obj[] PLUS exactly
// the runtime.a members that satisfy the program's unresolved refs
// (archive_extract_fixpoint), into a static ET_EXEC with ZERO binutils.
// Reads runtime.a (read_file_bytes) -> parse_ar_archive -> pull to fixpoint
// -> append pulled objs to the program objs -> CALL THROUGH to
// link_elf_x86_64_ownstart on the combined list. When nothing is pulled
// (extracted == []) the combined list is content-identical to program_objs
// and the bytes are byte-identical to the plain round-1/2 path. A
// missing/BSD/empty runtime.a -> members == [] -> extracted == [] -> same
// byte-identical plain link (never errors here). The sanctioned libc floor
// (malloc/free/write/memcpy/mmap/__errno…) stays UND after extraction — the
// known axis-③ libc floor (a separate flip), not resolved here. The
// data-segment reloc patch + bss def-collection (design components B/C) are a
// round-3b follow-on (unexercised by the text-CALL round-3 end-to-end).
pub fn link_elf_x86_64_ownstart_ar(program_objs: [ElfX86Obj], out_path: string, main_name: string, runtime_a_path: string) -> Int {
    let buf       = read_file_bytes(runtime_a_path)
    let members   = parse_ar_archive(buf)
    let extracted = archive_extract_fixpoint(program_objs, buf, members)

    let mut combined: [ElfX86Obj] = []
    let mut i = 0
    while i < len(program_objs) { combined.push(program_objs[i]); i = i + 1 }
    let mut j = 0
    while j < len(extracted) { combined.push(extracted[j]); j = j + 1 }

    return link_elf_x86_64_ownstart(combined, out_path, main_name)
}

// serialize_elf_x86_64 — P2 cycle 1: empty-object byte stream.
// Layout: header → .text → .symtab → .strtab → .shstrtab → section
// header table (5 entries: NULL, .text, .symtab, .strtab, .shstrtab).
pub fn serialize_elf_x86_64(obj: ElfX86Obj) -> [Int] {
    let out: [Int] = []
    let text_size = len(obj.text)
    let nrelocs = len(obj.relocs)
    // ── Data sections (cycle 32 — mirror of serialize_elf_arm64) ──
    let rodata_size = len(obj.rodata)
    let data_size   = len(obj.data)
    let bss_size    = obj.bss_size
    let has_rodata = rodata_size > 0
    let has_data   = data_size > 0
    let has_bss    = bss_size > 0

    // ── ELF symtab convention ──
    // Index 0 is reserved as STN_UNDEF (all zeros). Real symbols start
    // at index 1. Pre-cycle-31 the serializer skipped this, but
    // attaching .rela.text means real linkers (ld) will consume the
    // table, so we conform now. Reloc.sym_idx values must therefore be
    // incremented by 1 when written into Elf64_Rela.r_info.
    let nsyms_real = len(obj.symbols)
    let nsyms      = nsyms_real + 1                  // +1 for STN_UNDEF
    let symtab_size = 24 * nsyms
    let strsize = len(obj.strtab)

    let shstrtab: [Int] = []
    shstrtab.push(0)
    let off_text     = _ew_str(shstrtab, ".text")
    // `.rela.text` shares the `.text` byte prefix in shstrtab, but
    // emitting them separately is simpler than computing an overlap
    // offset (extra 11 bytes is negligible).
    let off_rela_text = if nrelocs > 0 { _ew_str(shstrtab, ".rela.text") } else { 0 }
    let off_rodata   = if has_rodata { _ew_str(shstrtab, ".rodata") } else { 0 }
    let off_data     = if has_data   { _ew_str(shstrtab, ".data") } else { 0 }
    let off_bss      = if has_bss    { _ew_str(shstrtab, ".bss") } else { 0 }
    let off_symtab   = _ew_str(shstrtab, ".symtab")
    let off_strtab   = _ew_str(shstrtab, ".strtab")
    let off_shstrtab = _ew_str(shstrtab, ".shstrtab")
    let shstrsize = len(shstrtab)

    let elf_header_size = 64
    let shdr_size = 64

    // Section index assignment (order: NULL, .text, [.rela.text],
    // [.rodata], [.data], [.bss], .symtab, .strtab, .shstrtab). Indices
    // shift as optional sections appear — identical scheme to elf_arm64,
    // so pack_lir_x86_64's pre-computed section indices stay in sync.
    let mut next = if nrelocs > 0 { 3 } else { 2 }
    let rodata_sec = if has_rodata { next } else { 0 }
    if has_rodata { next = next + 1 }
    let data_sec = if has_data { next } else { 0 }
    if has_data { next = next + 1 }
    let bss_sec = if has_bss { next } else { 0 }
    if has_bss { next = next + 1 }
    let symtab_sec = next
    let strtab_sec = next + 1
    let shstrndx   = next + 2
    let nshdrs     = next + 3

    let text_off     = elf_header_size
    let text_pad     = (8 - (text_size & 7)) & 7    // 8-align for rela
    let rela_size    = 24 * nrelocs
    let rela_off     = text_off + text_size + text_pad
    // .rodata follows .rela.text, 8-aligned (string literal pool).
    let rodata_off   = rela_off + rela_size
    let rodata_pad   = if has_rodata { (8 - (rodata_size & 7)) & 7 } else { 0 }
    // .data follows .rodata, 8-aligned (16-byte HexaVal slots already 8-mult).
    let data_off     = rodata_off + rodata_size + rodata_pad
    let data_pad     = if has_data { (8 - (data_size & 7)) & 7 } else { 0 }
    // .bss is SHT_NOBITS — occupies NO file bytes (next section starts here).
    let symtab_off   = data_off + data_size + data_pad
    let strtab_off   = symtab_off + symtab_size
    let shstrtab_off = strtab_off + strsize
    // Section header table aligned to 8.
    let pre_shdr     = shstrtab_off + shstrsize
    let shdr_pad     = (8 - (pre_shdr & 7)) & 7
    let shdr_off     = pre_shdr + shdr_pad

    // ── ELF64 header ──
    out.push(ELF_EI_MAG0); out.push(ELF_EI_MAG1)
    out.push(ELF_EI_MAG2); out.push(ELF_EI_MAG3)
    out.push(ELF_ELFCLASS64)
    out.push(ELF_ELFDATA2LSB)
    out.push(ELF_EV_CURRENT)
    out.push(ELF_ELFOSABI_NONE)
    _ew_zero(out, 8)                       // EI_ABIVERSION + 7 pad
    _ew_u16(out, ELF_ET_REL)
    _ew_u16(out, ELF_EM_X86_64)
    _ew_u32(out, ELF_EV_CURRENT)
    _ew_u64(out, 0)                         // e_entry
    _ew_u64(out, 0)                         // e_phoff
    _ew_u64(out, shdr_off)                  // e_shoff
    _ew_u32(out, 0)                         // e_flags
    _ew_u16(out, elf_header_size)           // e_ehsize
    _ew_u16(out, 0)                         // e_phentsize
    _ew_u16(out, 0)                         // e_phnum
    _ew_u16(out, shdr_size)                 // e_shentsize
    _ew_u16(out, nshdrs)                    // e_shnum
    _ew_u16(out, shstrndx)                  // e_shstrndx

    // ── .text ──
    let mut ti = 0
    while ti < text_size { out.push(obj.text[ti] & 0xff); ti = ti + 1 }
    _ew_zero(out, text_pad)

    // ── .rela.text (cycle 31-a) ──
    let mut ri = 0
    while ri < nrelocs {
        let r = obj.relocs[ri]
        // Elf64_Rela = r_offset(u64) r_info(u64) r_addend(i64). The
        // sym_idx in r_info is shifted into the high 32 bits; reloc
        // kind goes in the low 32. We add +1 because cycle-30 stored
        // raw indices but ELF symtab index 0 is STN_UNDEF.
        _ew_u64(out, r.offset)
        let sym_index_1based = r.sym_idx + 1
        _ew_u64(out, (sym_index_1based << 32) | (r.kind & 0xffffffff))
        _ew_u64(out, r.addend)
        ri = ri + 1
    }

    // ── .rodata (string/const literal pool) ──
    if has_rodata {
        let mut di = 0
        while di < rodata_size { out.push(obj.rodata[di] & 0xff); di = di + 1 }
        _ew_zero(out, rodata_pad)
    }

    // ── .data (module-global HexaVal slots, zero-initialized) ──
    if has_data {
        let mut gi = 0
        while gi < data_size { out.push(obj.data[gi] & 0xff); gi = gi + 1 }
        _ew_zero(out, data_pad)
    }
    // .bss has NO file bytes (SHT_NOBITS).

    // ── .symtab ──
    // Index 0: STN_UNDEF (all zeros, 24 B).
    _ew_zero(out, 24)
    let mut si = 0
    while si < nsyms_real {
        let s = obj.symbols[si]
        _ew_u32(out, s.name_offset)
        let st_info = ((s.bind & 0xf) << 4) | (s.type_ & 0xf)
        out.push(st_info & 0xff)
        out.push(0)                          // st_other
        _ew_u16(out, s.section)
        _ew_u64(out, s.value)
        _ew_u64(out, s.size)
        si = si + 1
    }

    // ── .strtab ──
    let mut ki = 0
    while ki < strsize { out.push(obj.strtab[ki] & 0xff); ki = ki + 1 }

    // ── .shstrtab ──
    let mut hi = 0
    while hi < shstrsize { out.push(shstrtab[hi] & 0xff); hi = hi + 1 }
    _ew_zero(out, shdr_pad)

    // ── Section header table ──
    // [0] SHT_NULL.
    _ew_zero(out, 64)
    // [1] .text.
    _ew_u32(out, off_text)
    _ew_u32(out, ELF_SHT_PROGBITS)
    _ew_u64(out, ELF_SHF_ALLOC | ELF_SHF_EXECINSTR)
    _ew_u64(out, 0)
    _ew_u64(out, text_off)
    _ew_u64(out, text_size)
    _ew_u32(out, 0); _ew_u32(out, 0)
    _ew_u64(out, 4); _ew_u64(out, 0)
    // [2] .rela.text (only when relocs exist).
    if nrelocs > 0 {
        _ew_u32(out, off_rela_text)
        _ew_u32(out, ELF_SHT_RELA)
        _ew_u64(out, 0); _ew_u64(out, 0)
        _ew_u64(out, rela_off)
        _ew_u64(out, rela_size)
        _ew_u32(out, symtab_sec)             // sh_link → .symtab
        _ew_u32(out, 1)                       // sh_info → .text section idx
        _ew_u64(out, 8); _ew_u64(out, 24)
    }
    // [rodata_sec] .rodata (ALLOC, read-only string/const pool).
    if has_rodata {
        _ew_u32(out, off_rodata)
        _ew_u32(out, ELF_SHT_PROGBITS)
        _ew_u64(out, ELF_SHF_ALLOC)
        _ew_u64(out, 0)
        _ew_u64(out, rodata_off)
        _ew_u64(out, rodata_size)
        _ew_u32(out, 0); _ew_u32(out, 0)
        _ew_u64(out, 8); _ew_u64(out, 0)
    }
    // [data_sec] .data (ALLOC|WRITE, module-global slots).
    if has_data {
        _ew_u32(out, off_data)
        _ew_u32(out, ELF_SHT_PROGBITS)
        _ew_u64(out, ELF_SHF_ALLOC | ELF_SHF_WRITE)
        _ew_u64(out, 0)
        _ew_u64(out, data_off)
        _ew_u64(out, data_size)
        _ew_u32(out, 0); _ew_u32(out, 0)
        _ew_u64(out, 8); _ew_u64(out, 0)
    }
    // [bss_sec] .bss (ALLOC|WRITE, SHT_NOBITS — sh_size but no file bytes).
    if has_bss {
        _ew_u32(out, off_bss)
        _ew_u32(out, ELF_SHT_NOBITS)
        _ew_u64(out, ELF_SHF_ALLOC | ELF_SHF_WRITE)
        _ew_u64(out, 0)
        _ew_u64(out, symtab_off)              // sh_offset (conventional: = next sec)
        _ew_u64(out, bss_size)
        _ew_u32(out, 0); _ew_u32(out, 0)
        _ew_u64(out, 8); _ew_u64(out, 0)
    }
    // [symtab_sec] .symtab.
    _ew_u32(out, off_symtab)
    _ew_u32(out, ELF_SHT_SYMTAB)
    _ew_u64(out, 0); _ew_u64(out, 0)
    _ew_u64(out, symtab_off)
    _ew_u64(out, symtab_size)
    _ew_u32(out, strtab_sec)                  // sh_link → .strtab
    // sh_info = one past last STB_LOCAL symbol. Index 0 is STN_UNDEF
    // (LOCAL) + `obj.nlocal` `.LCstrN`/`g<id>` LOCAL defs → first
    // non-local index = nlocal + 1. (Was hardcoded 1 when no data
    // sections existed; nlocal=0 reproduces the old value.)
    _ew_u32(out, obj.nlocal + 1)
    _ew_u64(out, 8); _ew_u64(out, 24)
    // [strtab_sec] .strtab.
    _ew_u32(out, off_strtab)
    _ew_u32(out, ELF_SHT_STRTAB)
    _ew_u64(out, 0); _ew_u64(out, 0)
    _ew_u64(out, strtab_off)
    _ew_u64(out, strsize)
    _ew_u32(out, 0); _ew_u32(out, 0)
    _ew_u64(out, 1); _ew_u64(out, 0)
    // [shstrndx] .shstrtab.
    _ew_u32(out, off_shstrtab)
    _ew_u32(out, ELF_SHT_STRTAB)
    _ew_u64(out, 0); _ew_u64(out, 0)
    _ew_u64(out, shstrtab_off)
    _ew_u64(out, shstrsize)
    _ew_u32(out, 0); _ew_u32(out, 0)
    _ew_u64(out, 1); _ew_u64(out, 0)

    return out
}

// ─────────────────────────────────────────────────────────────────
// serialize_elf_exec_x86_64 — P2 cycle 3: minimum ELF executable
// ─────────────────────────────────────────────────────────────────
//
// Static ELF exec for Linux x86_64. No dynamic linker, no symbol
// table — just header + one PT_LOAD segment containing entry code.
// Kernel maps segment at e_entry and starts execution there.
//
// Layout (132 bytes for a 12-byte exit syscall):
//   ELF64 header  64 B   e_type=ET_EXEC e_entry=vaddr+120
//   PT_LOAD phdr  56 B   p_offset=0 p_vaddr=0x400000 PF_R|PF_X
//   code bytes     N B
pub fn serialize_elf_exec_x86_64(text: [Int]) -> [Int] {
    let out: [Int] = []
    let text_size = len(text)

    let elf_header_size = 64
    let phdr_size = 56
    let phnum = 1
    let code_off = elf_header_size + phdr_size * phnum     // 120
    let vaddr_base = 0x400000
    let entry_vaddr = vaddr_base + code_off
    let file_size = code_off + text_size

    out.push(ELF_EI_MAG0); out.push(ELF_EI_MAG1)
    out.push(ELF_EI_MAG2); out.push(ELF_EI_MAG3)
    out.push(ELF_ELFCLASS64)
    out.push(ELF_ELFDATA2LSB)
    out.push(ELF_EV_CURRENT)
    out.push(ELF_ELFOSABI_NONE)
    _ew_zero(out, 8)
    _ew_u16(out, ELF_ET_EXEC)
    _ew_u16(out, ELF_EM_X86_64)
    _ew_u32(out, ELF_EV_CURRENT)
    _ew_u64(out, entry_vaddr)
    _ew_u64(out, elf_header_size)           // e_phoff
    _ew_u64(out, 0)                         // e_shoff
    _ew_u32(out, 0)                         // e_flags
    _ew_u16(out, elf_header_size)
    _ew_u16(out, phdr_size)
    _ew_u16(out, phnum)
    _ew_u16(out, 0)                         // e_shentsize
    _ew_u16(out, 0)                         // e_shnum
    _ew_u16(out, 0)                         // e_shstrndx

    // PT_LOAD
    _ew_u32(out, 1)                         // p_type = PT_LOAD
    _ew_u32(out, 5)                         // p_flags = PF_R | PF_X
    _ew_u64(out, 0)                         // p_offset
    _ew_u64(out, vaddr_base)                // p_vaddr
    _ew_u64(out, vaddr_base)                // p_paddr
    _ew_u64(out, file_size)                 // p_filesz
    _ew_u64(out, file_size)                 // p_memsz
    _ew_u64(out, 0x1000)                    // p_align

    let mut i = 0
    while i < text_size { out.push(text[i] & 0xff); i = i + 1 }

    return out
}

// ─────────────────────────────────────────────────────────────────

// serialize_elf_exec_x86_64_2seg — round-2 two-segment static exec.
// ─────────────────────────────────────────────────────────────
// Static ELF ET_EXEC for Linux x86_64 with TWO PT_LOAD segments:
//   seg0 (R-X): ELF header + 2 phdrs + .text          at vaddr 0x400000
//   seg1 (RW):  .rodata ++ .data (+ .bss in p_memsz)   at a page-aligned
//               vaddr above the text segment.
// The whole file stays a uniform vaddr = 0x400000 + file_off map, split at a
// page boundary between the R-X and RW segments, so each segment satisfies
// p_vaddr === p_offset (mod 0x1000) and their pages never overlap. No dynamic
// linker, no symtab. .bss is zero-filled by the kernel (p_memsz > p_filesz).
//
// Layout (data program):
//   ELF64 header  64 B   e_type=ET_EXEC e_entry=0x400000+176
//   PT_LOAD[0]    56 B   R-X  p_offset=0            p_vaddr=0x400000
//   PT_LOAD[1]    56 B   RW   p_offset=data_file_off p_vaddr=0x400000+data_file_off
//   .text          N B   at file offset 176 (=64+56*2)
//   (zero pad to the next page)
//   .rodata/.data  D B   at file offset data_file_off
pub fn serialize_elf_exec_x86_64_2seg(text: [Int], data: [Int], bss_size: Int) -> [Int] {
    let out: [Int] = []
    let text_size = len(text)
    let data_size = len(data)

    let elf_header_size = 64
    let phdr_size = 56
    let phnum = 2
    let code_off = elf_header_size + phdr_size * phnum     // 176
    let vaddr_base = 0x400000
    let entry_vaddr = vaddr_base + code_off
    let text_end_file = code_off + text_size
    // Page-align the data segment's file offset (=> vaddr congruence holds).
    let data_file_off = text_end_file + ((0x1000 - (text_end_file & 0xfff)) & 0xfff)
    let data_vaddr = vaddr_base + data_file_off
    let text_filesz = code_off + text_size                 // seg0 file+mem size
    let data_memsz  = data_size + bss_size                 // seg1 mem (incl .bss)

    // ── ELF header ──
    out.push(ELF_EI_MAG0); out.push(ELF_EI_MAG1)
    out.push(ELF_EI_MAG2); out.push(ELF_EI_MAG3)
    out.push(ELF_ELFCLASS64)
    out.push(ELF_ELFDATA2LSB)
    out.push(ELF_EV_CURRENT)
    out.push(ELF_ELFOSABI_NONE)
    _ew_zero(out, 8)
    _ew_u16(out, ELF_ET_EXEC)
    _ew_u16(out, ELF_EM_X86_64)
    _ew_u32(out, ELF_EV_CURRENT)
    _ew_u64(out, entry_vaddr)
    _ew_u64(out, elf_header_size)           // e_phoff
    _ew_u64(out, 0)                         // e_shoff
    _ew_u32(out, 0)                         // e_flags
    _ew_u16(out, elf_header_size)
    _ew_u16(out, phdr_size)
    _ew_u16(out, phnum)
    _ew_u16(out, 0)                         // e_shentsize
    _ew_u16(out, 0)                         // e_shnum
    _ew_u16(out, 0)                         // e_shstrndx

    // ── PT_LOAD[0] — R-X text ──
    _ew_u32(out, 1)                         // p_type = PT_LOAD
    _ew_u32(out, 5)                         // p_flags = PF_R | PF_X
    _ew_u64(out, 0)                         // p_offset
    _ew_u64(out, vaddr_base)                // p_vaddr
    _ew_u64(out, vaddr_base)                // p_paddr
    _ew_u64(out, text_filesz)               // p_filesz
    _ew_u64(out, text_filesz)               // p_memsz
    _ew_u64(out, 0x1000)                    // p_align

    // ── PT_LOAD[1] — RW rodata/data (+ .bss in memsz) ──
    _ew_u32(out, 1)                         // p_type = PT_LOAD
    _ew_u32(out, 6)                         // p_flags = PF_R | PF_W
    _ew_u64(out, data_file_off)             // p_offset
    _ew_u64(out, data_vaddr)                // p_vaddr
    _ew_u64(out, data_vaddr)                // p_paddr
    _ew_u64(out, data_size)                 // p_filesz
    _ew_u64(out, data_memsz)                // p_memsz  (includes .bss)
    _ew_u64(out, 0x1000)                    // p_align

    // ── .text at file offset code_off (176) ──
    let mut i = 0
    while i < text_size { out.push(text[i] & 0xff); i = i + 1 }

    // ── zero pad from text end up to the page-aligned data file offset ──
    _ew_zero(out, data_file_off - text_end_file)

    // ── .rodata/.data at file offset data_file_off ──
    let mut d = 0
    while d < data_size { out.push(data[d] & 0xff); d = d + 1 }

    return out
}

// ─────────────────────────────────────────────────────────────────
// RFC 063 § P3 round-3 Stage 1 — on-disk ELF64 REL (.o) reader.
//
// parse_elf_x86_obj inverts serialize_elf_x86_64 AND normalizes a real
// clang-compiled runtime_core.o into the linker's SECTION-SLOT model
// {1=.text, 3=.rodata, >=4=.data, 5=.bss, 0=SHN_UNDEF} so
// link_elf_x86_64_ownstart's name-keyed def/reloc resolve loop
// (elf_x86_64.hexa:948-1065) can consume it directly.
//
// Local _er_* byte helpers are private COPIES of the hexa_ld.hexa
// idioms (_read_u8/16/32/64le/_read_cstr) — hexa_ld is a *different*
// module (compiler/link), so round-3 stays self-contained in this file.
// ─────────────────────────────────────────────────────────────────

fn _er_u8(buf, off: Int) -> Int {
    if off < 0 { return 0 }
    if off > len(buf) - 1 { return 0 }
    return buf[off] & 0xff
}
fn _er_u16le(buf, off: Int) -> Int {
    return _er_u8(buf, off) + _er_u8(buf, off + 1) * 256
}
fn _er_u32le(buf, off: Int) -> Int {
    let mut u = 0
    let mut i = 3
    while i > -1 { u = u * 256 + _er_u8(buf, off + i); i = i - 1 }
    return u
}
fn _er_u64le(buf, off: Int) -> Int {
    let mut u = 0
    let mut i = 7
    while i > -1 { u = u * 256 + _er_u8(buf, off + i); i = i - 1 }
    return u
}
// Signed Sxword read (r_addend). Sign-extend off the top byte so the
// value round-trips as a small negative (e.g. -4) under BOTH the i64-wrap
// and BigInt int models — 2^64 is computed at runtime (4294967296^2) to
// dodge a literal-overflow at parse time.
fn _er_s64le(buf, off: Int) -> Int {
    let raw = _er_u64le(buf, off)
    let hi  = _er_u8(buf, off + 7)
    if (hi & 0x80) != 0 {
        let two32 = 4294967296
        return raw - two32 * two32
    }
    return raw
}
fn _er_cstr(buf, off: Int) -> string {
    let mut s = ""
    let mut i = 0
    while i < 256 {
        let c = _er_u8(buf, off + i)
        if c == 0 { return s }
        s = s + from_char_code(c)
        i = i + 1
    }
    return s
}

// parse_elf_x86_obj(buf, base, limit, member_idx) -> ElfX86Obj
//
// `base`  = byte offset of this member's ELF header inside `buf` (0 for a
//           standalone .o; the ar member data offset for an archive read).
// `limit` = member byte length (advisory bound; reads are also clamped to
//           len(buf)).
// `member_idx` = archive-member discriminator, folded into synthetic
//           STT_SECTION names so they stay globally unique across members
//           (blocker #1). Pass 0 for a standalone parse.
pub fn parse_elf_x86_obj(buf, base: Int, limit: Int, member_idx: Int) -> ElfX86Obj {
    let mut obj = ElfX86Obj {
        text: [], relocs: [], symbols: [], strtab: [],
        rodata: [], data: [], bss_size: 0, nlocal: 0,
    }
    obj.strtab.push(0)                       // ELF strtab idx 0 = ""

    // ── Guards: ELF magic + ET_REL + EM_X86_64 ──
    if _er_u8(buf, base + 0) != 0x7f { return obj }
    if _er_u8(buf, base + 1) != 0x45 { return obj }   // 'E'
    if _er_u8(buf, base + 2) != 0x4c { return obj }   // 'L'
    if _er_u8(buf, base + 3) != 0x46 { return obj }   // 'F'
    if _er_u8(buf, base + 4) != 2    { return obj }   // ELFCLASS64
    if _er_u8(buf, base + 5) != 1    { return obj }   // ELFDATA2LSB
    if _er_u16le(buf, base + 0x10) != ELF_ET_REL   { return obj }
    if _er_u16le(buf, base + 0x12) != ELF_EM_X86_64 { return obj }

    let e_shoff     = _er_u64le(buf, base + 0x28)
    let e_shentsize = _er_u16le(buf, base + 0x3A)
    let e_shnum     = _er_u16le(buf, base + 0x3C)
    let e_shstrndx  = _er_u16le(buf, base + 0x3E)
    if e_shentsize < 64 { return obj }
    if e_shnum < 1 { return obj }
    if e_shstrndx > e_shnum - 1 { return obj }

    let shstr_hdr = base + e_shoff + e_shstrndx * e_shentsize
    let shstr_off = base + _er_u64le(buf, shstr_hdr + 0x18)

    // ── Pass A: section headers → per-index slot + concat-pool base,
    //    copying section bytes into obj.text / rodata / data pools and
    //    accumulating bss. Slot picked by (type,flags), so .text/.text.*,
    //    .rodata/.rodata.*, .data/.data.* pool symmetrically — no
    //    else->0 drop (blocker #2). Pooling REBASES st_value/r_offset. ──
    let sec_slot: [Int] = []      // 0 none, 1 text, 3 rodata, 4 data, 5 bss
    let sec_base: [Int] = []      // this section's start within its pool
    let sec_off:  [Int] = []      // absolute file offset in buf
    let sec_size: [Int] = []
    let sec_type: [Int] = []
    let sec_link: [Int] = []
    let sec_info: [Int] = []
    let sec_ent:  [Int] = []

    let mut i = 0
    while i < e_shnum {
        let sh    = base + e_shoff + i * e_shentsize
        let stype = _er_u32le(buf, sh + 0x04)
        let flags = _er_u64le(buf, sh + 0x08)
        let soff  = _er_u64le(buf, sh + 0x18)
        let ssize = _er_u64le(buf, sh + 0x20)
        let slink = _er_u32le(buf, sh + 0x28)
        let sinfo = _er_u32le(buf, sh + 0x2C)
        let sent  = _er_u64le(buf, sh + 0x38)

        let mut slot  = 0
        let mut pbase = 0
        if stype == ELF_SHT_PROGBITS && (flags & ELF_SHF_ALLOC) != 0 {
            if (flags & ELF_SHF_EXECINSTR) != 0 {
                slot = 1
                pbase = len(obj.text)
                let mut k = 0
                while k < ssize { obj.text.push(_er_u8(buf, base + soff + k)); k = k + 1 }
            } else if (flags & ELF_SHF_WRITE) != 0 {
                slot = 4
                pbase = len(obj.data)
                let mut k = 0
                while k < ssize { obj.data.push(_er_u8(buf, base + soff + k)); k = k + 1 }
            } else {
                slot = 3
                pbase = len(obj.rodata)
                let mut k = 0
                while k < ssize { obj.rodata.push(_er_u8(buf, base + soff + k)); k = k + 1 }
            }
        } else if stype == ELF_SHT_NOBITS && (flags & ELF_SHF_ALLOC) != 0 {
            slot = 5
            pbase = obj.bss_size
            obj.bss_size = obj.bss_size + ssize
        }
        sec_slot.push(slot)
        sec_base.push(pbase)
        sec_off.push(base + soff)
        sec_size.push(ssize)
        sec_type.push(stype)
        sec_link.push(slink)
        sec_info.push(sinfo)
        sec_ent.push(sent)
        i = i + 1
    }

    // ── Locate .symtab (+ its .strtab via sh_link). ──
    let mut symtab_idx = -1
    let mut j = 0
    while j < e_shnum {
        if sec_type[j] == ELF_SHT_SYMTAB { symtab_idx = j; break }
        j = j + 1
    }
    if symtab_idx < 0 { return obj }
    let sym_off  = sec_off[symtab_idx]
    let sym_size = sec_size[symtab_idx]
    let mut sym_es = sec_ent[symtab_idx]
    if sym_es < 1 { sym_es = 24 }
    let str_sec = sec_link[symtab_idx]
    if str_sec < 0 { return obj }
    if str_sec > e_shnum - 1 { return obj }
    let str_off = sec_off[str_sec]

    // ── Pass B: symbols (skip file idx 0 = STN_UNDEF). obj.symbols is
    //    1:1 with file symtab entries 1..N, so a reloc's r_info sym index
    //    S maps to obj.symbols[S-1]. STT_SECTION syms (name='', value=0)
    //    get a UNIQUE synthesized name registered as a DEF at their
    //    section's pool base — the name-keyed resolve loop then works
    //    (blocker #1). COMMON allocates aligned bss (blocker #3). ──
    let count = sym_size / sym_es
    let mut si = 1
    while si < count {
        let s = sym_off + si * sym_es
        let st_name  = _er_u32le(buf, s + 0x00)
        let st_info  = _er_u8(buf, s + 0x04)
        let st_shndx = _er_u16le(buf, s + 0x06)
        let st_value = _er_u64le(buf, s + 0x08)
        let st_size  = _er_u64le(buf, s + 0x10)
        let bind  = (st_info >> 4) & 0xf
        let type_ = st_info & 0xf

        let mut nsec = 0
        let mut nval = 0
        if st_shndx == 0 {
            nsec = 0; nval = 0                         // SHN_UNDEF
        } else if st_shndx == 0xfff1 {
            nsec = 0; nval = 0                         // SHN_ABS -> non-def
        } else if st_shndx == 0xfff2 {
            // SHN_COMMON: st_value = alignment, st_size = byte size.
            let mut al = st_value
            if al < 1 { al = 1 }
            let cur = obj.bss_size
            let rem = cur - (cur / al) * al
            let aligned = if rem == 0 { cur } else { cur + (al - rem) }
            nsec = 5
            nval = aligned
            obj.bss_size = aligned + st_size
        } else if st_shndx < e_shnum {
            nsec = sec_slot[st_shndx]
            nval = st_value + sec_base[st_shndx]      // rebase into pool
        } else {
            nsec = 0; nval = 0
        }

        let mut nm_off = 0
        if type_ == 3 {                               // STT_SECTION
            let sname = "$sec_" + to_string(member_idx) + "_" + to_string(st_shndx)
            nm_off = _ew_str(obj.strtab, sname)
        } else {
            nm_off = _ew_str(obj.strtab, _er_cstr(buf, str_off + st_name))
        }

        obj.symbols.push(ElfSym {
            name_offset: nm_off,
            section:     nsec,
            value:       nval,
            size:        st_size,
            bind:        bind,
            type_:       type_,
        })
        if bind == ELF_STB_LOCAL { obj.nlocal = obj.nlocal + 1 }
        si = si + 1
    }

    // ── Pass C: SHT_RELA sections. sh_info = target section index; the
    //    reloc's r_offset is rebased into that section's pool so the patch
    //    site is pool-relative (blocker #2). sym index → obj.symbols via
    //    -1. Addend is sign-extended. ──
    let mut ci = 0
    while ci < e_shnum {
        if sec_type[ci] == ELF_SHT_RELA {
            let roff = sec_off[ci]
            let rsz  = sec_size[ci]
            let mut res = sec_ent[ci]
            if res < 24 { res = 24 }
            let tgt = sec_info[ci]
            let mut tgt_base = 0
            if tgt < e_shnum { tgt_base = sec_base[tgt] }
            let rcount = rsz / res
            let mut ri = 0
            while ri < rcount {
                let r     = roff + ri * res
                let r_off = _er_u64le(buf, r + 0x00)
                let rinfo = _er_u64le(buf, r + 0x08)
                let radd  = _er_s64le(buf, r + 0x10)
                let div   = 0x100000000
                let sym_file = rinfo / div
                let rtype    = rinfo - (rinfo / div) * div
                if sym_file > 0 {                     // skip relocs vs STN_UNDEF
                    obj.relocs.push(ElfRel {
                        offset:  r_off + tgt_base,
                        sym_idx: sym_file - 1,
                        kind:    rtype,
                        addend:  radd,
                        site_seg: (if tgt < e_shnum { sec_slot[tgt] } else { 1 }),
                    })
                }
                ri = ri + 1
            }
        }
        ci = ci + 1
    }

    return obj
}

// ── RFC 063 § P3 round-3 Stage 2 — GNU ar member record ──
// One entry per LINKABLE member (the "/" armap and "//" long-name string
// table are NOT members — they are consumed internally). `data_off` =
// absolute byte offset in `buf` where this member's data begins (past its
// 60-byte header); Stage 3 feeds (data_off, size) to
// parse_elf_x86_obj(buf, data_off, size, member_idx). Fields are i64 to
// match the ElfRel/ElfSym/ElfX86Obj struct idiom in this file (Int compiles
// equally — _er_*/_ar_* helpers return Int and assign cleanly, exactly as
// ElfX86Obj.bss_size does).
struct ArMember {
    name:     string,
    data_off: i64,
    size:     i64,
}

// ── ar ASCII-field helpers (reuse this file's private _er_u8 byte reader) ──

// Read `n` raw bytes at `off` as an ASCII string (for the space-padded fields).
fn _ar_read_ascii(buf, off: Int, n: Int) -> string {
    let mut s = ""
    let mut i = 0
    while i < n { s = s + from_char_code(_er_u8(buf, off + i)); i = i + 1 }
    return s
}

// Parse a left-justified decimal ASCII field (size[48:58] · the /N offset).
// Skips leading spaces, then reads digits until the first non-digit (the
// trailing space padding), so "1234      " -> 1234 and "0   " -> 0.
fn _ar_atoi_dec(buf, off: Int, n: Int) -> Int {
    let mut v = 0
    let mut i = 0
    while i < n {
        if _er_u8(buf, off + i) != 0x20 { break }   // skip leading spaces
        i = i + 1
    }
    while i < n {
        let c = _er_u8(buf, off + i)
        if c < 48 || c > 57 { break }               // stop on space / non-digit
        v = v * 10 + (c - 48)
        i = i + 1
    }
    return v
}

// Strip trailing ASCII spaces from a 16-byte name field.
fn _ar_rstrip(s: string) -> string {
    let mut n = len(s)
    while n > 0 {
        if char_code(s, n - 1) != 0x20 { break }    // 0x20 = ' '
        n = n - 1
    }
    return s.substring(0, n)
}

// Resolve a long name from the "//" string table: read from tab_off+n up to
// the GNU terminator ('/' then '\n'; tolerate a bare '\n' or NUL too).
// tab_off < 0 (no // table seen) yields "" — a defensive no-op.
fn _ar_longname(buf, tab_off: Int, tab_size: Int, n: Int) -> string {
    if tab_off < 0 { return "" }
    let mut s = ""
    let mut i = n
    while i < tab_size {
        let c = _er_u8(buf, tab_off + i)
        if c == 0x2f { break }   // '/' GNU terminator
        if c == 0x0a { break }   // '\n'
        if c == 0    { break }
        s = s + from_char_code(c)
        i = i + 1
    }
    return s
}

// parse_ar_archive(buf) -> [ArMember]
//
// Parse a GNU ar archive (e.g. ~/.hx/bin/build/runtime.a) into the linkable
// member records Stage 3 will hand to parse_elf_x86_obj. The GNU "//"
// long-name string table always precedes any "/N" reference (GNU writer
// guarantee), so a single forward pass captures it before it is consulted.
// Reads are clamped by _er_u8 (returns 0 past len(buf)); adv >= 60 each
// iteration so a malformed size can never spin the loop.
pub fn parse_ar_archive(buf) -> [ArMember] {
    let members: [ArMember] = []

    // ── 8-byte magic "!<arch>\n" ──
    let magic: [Int] = [0x21, 0x3c, 0x61, 0x72, 0x63, 0x68, 0x3e, 0x0a]
    let mut m = 0
    while m < 8 {
        if _er_u8(buf, m) != magic[m] { return members }
        m = m + 1
    }

    // BSD-ar guard: the local darwin runtime.a is BSD (first member '#1/NN',
    // '__.SYMDEF' armap) — this parser is GNU-only (the Linux-pool runtime.a).
    // Fail loudly (empty list) on a BSD archive rather than emit bogus members.
    let _first = _ar_rstrip(_ar_read_ascii(buf, 8, 16))
    if len(_first) >= 3 && char_code(_first, 0) == 0x23
       && char_code(_first, 1) == 0x31 && char_code(_first, 2) == 0x2f { return members }
    if _first == "__.SYMDEF" || _first == "__.SYMDEF SORTED" { return members }

    let total = len(buf)
    let mut ln_off  = -1     // "//" table data offset (abs), -1 until seen
    let mut ln_size = 0
    let mut off = 8          // past magic

    while off + 60 <= total {
        let name_tok = _ar_rstrip(_ar_read_ascii(buf, off, 16))
        let size     = _ar_atoi_dec(buf, off + 48, 10)   // size[48:58]
        let data_off = off + 60

        if name_tok == "/" {
            // ARMAP symbol index — SKIP (Stage 3 scans symtabs linearly).
        } else if name_tok == "//" {
            // Long-name string table — keep its bytes for /N resolution.
            ln_off  = data_off
            ln_size = size
        } else if len(name_tok) >= 2 && char_code(name_tok, 0) == 0x2f
                  && char_code(name_tok, 1) >= 48 && char_code(name_tok, 1) <= 57 {
            // Long name "/N" — N = decimal offset into the "//" table data.
            let noff = _ar_atoi_dec(buf, off + 1, 15)
            members.push(ArMember {
                name: _ar_longname(buf, ln_off, ln_size, noff),
                data_off: data_off, size: size,
            })
        } else {
            // Short name "name/" — strip the terminating '/'.
            let mut nm = name_tok
            let ln = len(nm)
            if ln > 0 && char_code(nm, ln - 1) == 0x2f { nm = nm.substring(0, ln - 1) }
            members.push(ArMember { name: nm, data_off: data_off, size: size })
        }

        // Advance past header + data, padded to even length with '\n'.
        let mut adv = 60 + size
        if (size & 1) == 1 { adv = adv + 1 }
        off = off + adv
    }

    return members
}

// ── RFC 063 § P3 round-3 Stage 3 — own-linker archive extraction ──
//
// archive_extract_fixpoint(program_objs, buf, members) -> [ElfX86Obj]
//
// Classic `ld` archive-member pull. Given the PROGRAM's already-parsed
// ElfX86Obj[] (Stage-1 parses of the own .o files) plus the archive `buf`
// and its [ArMember] records (Stage-2 parse_ar_archive), pull exactly the
// runtime.a members needed to satisfy the program's unresolved references,
// transitively, to a fixpoint. Returns the pulled ElfX86Obj[] in
// dependency (pull) order, to be appended to program_objs by Stage 4.
//
// Symbol model (from parse_elf_x86_obj / ElfSym):
//   section == 0            → UNDEFINED reference (SHN_UNDEF).
//   section != 0 && GLOBAL  → a linkable DEFINITION.
//   STT_SECTION synth syms  → bind LOCAL, so excluded from DEF matching.
//
// Two monotonically-growing name sets drive the fixpoint:
//   def_names — every GLOBAL name defined so far (program + pulled members).
//               Membership here is the "satisfied" marker.
//   und_names — every reference name ever seen (program + pulled UNDs).
// A name is still-NEEDED  ==  in und_names AND NOT in def_names. Because
// def_names only grows, once a name is defined it can never re-trigger a
// pull; und_names only grows, so no element is ever removed — the sets are
// append-only, which makes termination obvious.
//
// A member is PULLED iff it has a GLOBAL DEF whose name is still-NEEDED.
// On pull: its GLOBAL defs fold into def_names (satisfying those needs) and
// its UNDs fold into und_names (creating new needs). Each member is pulled
// AT MOST ONCE (the `pulled` flag). Members are parsed once up front — the
// armap ("/") is intentionally dropped by parse_ar_archive, so symbol
// discovery is a linear symtab scan per member.
//
// Sanctioned-floor boundary: names that stay NEEDED after the fixpoint
// (malloc/free/write/memcpy/mmap/__errno_location …) are simply LEFT
// unresolved — runtime.a does not self-satisfy the axis-③ libc floor, so no
// member pulls for them and this function NEVER errors on a residual UND.
// Resolving/erroring on the floor is Stage-4's concern, not this pass's.

// Read a NUL-terminated symbol name out of an ElfX86Obj strtab ([u8]),
// bounded by the strtab length (defensive against a malformed name_offset).
fn _aef_symname(obj: ElfX86Obj, off: Int) -> string {
    let mut s = ""
    let n = len(obj.strtab)
    let mut k = 0
    while off + k < n {
        let b = obj.strtab[off + k] & 0xff
        if b == 0 { break }
        s = s + from_char_code(b)
        k = k + 1
    }
    return s
}

// Linear membership test for an append-only [string] name set.
fn _aef_has(xs: [string], name: string) -> bool {
    let mut i = 0
    let n = len(xs)
    while i < n {
        if xs[i] == name { return true }
        i = i + 1
    }
    return false
}

pub fn archive_extract_fixpoint(program_objs: [ElfX86Obj], buf, members: [ArMember]) -> [ElfX86Obj] {
    let extracted: [ElfX86Obj] = []

    // ── Parse every member once (symbol discovery needs the symtab). ──
    let parsed: [ElfX86Obj] = []
    let mut pulled: [bool] = []
    let mut m = 0
    while m < len(members) {
        let mem = members[m]
        parsed.push(parse_elf_x86_obj(buf, mem.data_off, mem.size, m))
        pulled.push(false)
        m = m + 1
    }

    // ── Seed def_names / und_names from the program objs. ──
    let def_names: [string] = []
    let und_names: [string] = []
    // Pass 1: program GLOBAL definitions.
    let mut pi = 0
    while pi < len(program_objs) {
        let po = program_objs[pi]
        let mut sj = 0
        while sj < len(po.symbols) {
            let s = po.symbols[sj]
            if s.section != 0 && s.bind == ELF_STB_GLOBAL {
                let nm = _aef_symname(po, s.name_offset)
                if len(nm) > 0 && !_aef_has(def_names, nm) { def_names.push(nm) }
            }
            sj = sj + 1
        }
        pi = pi + 1
    }
    // Pass 2: program undefined references.
    pi = 0
    while pi < len(program_objs) {
        let po = program_objs[pi]
        let mut sj = 0
        while sj < len(po.symbols) {
            let s = po.symbols[sj]
            if s.section == 0 {
                let nm = _aef_symname(po, s.name_offset)
                if len(nm) > 0 && !_aef_has(und_names, nm) { und_names.push(nm) }
            }
            sj = sj + 1
        }
        pi = pi + 1
    }

    // ── Fixpoint: repeat full passes until one pulls nothing. ──
    let mut changed = true
    while changed {
        changed = false
        let mut mi = 0
        while mi < len(members) {
            if !pulled[mi] {
                let obj = parsed[mi]

                // Wants pulling iff it has a GLOBAL DEF for a still-NEEDED
                // name (in und_names AND not yet in def_names).
                let mut wants = false
                let mut k = 0
                while k < len(obj.symbols) {
                    let s = obj.symbols[k]
                    if s.section != 0 && s.bind == ELF_STB_GLOBAL {
                        let nm = _aef_symname(obj, s.name_offset)
                        if _aef_has(und_names, nm) && !_aef_has(def_names, nm) {
                            wants = true
                            break
                        }
                    }
                    k = k + 1
                }

                if wants {
                    pulled[mi] = true
                    changed = true

                    // Fold this member's GLOBAL defs into def_names.
                    let mut d = 0
                    while d < len(obj.symbols) {
                        let s = obj.symbols[d]
                        if s.section != 0 && s.bind == ELF_STB_GLOBAL {
                            let nm = _aef_symname(obj, s.name_offset)
                            if len(nm) > 0 && !_aef_has(def_names, nm) { def_names.push(nm) }
                        }
                        d = d + 1
                    }
                    // Fold this member's new UNDs into und_names.
                    let mut u = 0
                    while u < len(obj.symbols) {
                        let s = obj.symbols[u]
                        if s.section == 0 {
                            let nm = _aef_symname(obj, s.name_offset)
                            if len(nm) > 0 && !_aef_has(und_names, nm) { und_names.push(nm) }
                        }
                        u = u + 1
                    }

                    extracted.push(obj)
                }
            }
            mi = mi + 1
        }
    }

    return extracted
}


// LIR walker — `LModule` → byte stream (RFC 063 § P2, cycle 29)
// ─────────────────────────────────────────────────────────────────
//
// `pack_lir_x86_64(lm)` mirrors `compiler/emit/macho_arm64.hexa::
// pack_lir` for the Linux x86_64 platform. It walks `LModule.funcs`,
// dispatches each `LInstr` through `encode_x86_64_insn`, and patches
// intra-fn branch deltas.
//
// Cycle 29 subset:
//
//   - register / imm / label operands (mem is cycle-30 work — needs
//     `[base + off]` ModR/M+SIB+disp encoding).
//   - intra-fn JMP_REL8 / JE_REL8 family / JMP_REL32 patching by
//     name → offset map. JMP_REL32 (5 B) is the default — REL8
//     auto-promotion is cycle-30 work.
//   - the `label` pseudo-op (`op == "label"`, name in `comment` or
//     `args[0].label`) records the current `text` offset.
//   - CALL with a label arg → emits `e8 00 00 00 00` placeholder and
//     bubbles to the caller's `pending_*` lists for cycle-30 reloc.
//   - width dispatch — `mov rax, ...` → MOV64 (REX.W form), `mov eax,
//     ...` → MOV. Detection by leading char of first reg operand.
//
// Out of scope (cycle 30+):
//
//   - mem operands with offsets (`[rbp - 8]`).
//   - cross-fn / extern `CALL` → `R_X86_64_PLT32` reloc record.
//   - JMP REL8 ↔ REL32 promotion / shrink based on resolved delta.
//   - `.rodata` / `.data` sections (currently `.text`-only).
//
// Walker is silent on unsupported ops: encoder returns `[]` and zero
// bytes are appended (so the byte stream stays length-correct for
// later inspection via `objdump -d`).

// ── Cycle 32 — RIP-relative data-address materialization ─────────
//
// A string/global reference reaches the walker as a `label` operand
// (`.LCstrN` / `g<id>`), the SOURCE of a `mov reg, <label>` produced by
// `_x86_64_op_for_operand`. On x86_64 the address of such a symbol is
// loaded RIP-relatively via `lea reg, [rip + disp32]`:
//
//   REX.W  8D  ModR/M(mod=00 reg=rd rm=101=RIP)  disp32
//
// rm=101 with mod=00 is the special "RIP-relative" encoding (long mode).
// The disp32 is a placeholder 0; pass-2 attaches an R_X86_64_PC32 reloc
// at the disp32 offset with addend -4 (the linker computes S + A - P =
// symbol - (next_insn_pc), exactly the RIP-relative displacement).
// Mirrors elf_arm64's ADRP/ADD `@PAGE`/`@PAGEOFF` data-ref pair — the
// x86_64 RIP-relative form needs ONE reloc instead of arm64's two.
fn _ex86_lea_rip_rel(reg_idx: Int) -> [Int] {
    let rex = _ex86_rex(1, if reg_idx >= 8 { 1 } else { 0 }, 0, 0)
    let modrm = (0 << 6) | ((reg_idx & 0x7) << 3) | 0x5   // mod=00 rm=101 (RIP)
    return [rex, 0x8d, modrm, 0x00, 0x00, 0x00, 0x00]
}

// A data symbol is a string literal (`.LCstr…`) or a module-global
// slot (`g<id>`). These are the only `label` operands that denote a
// data ADDRESS to be materialized RIP-relatively (vs branch/call
// targets, which are code labels handled by the jmp/call paths). The
// `g` test requires a trailing digit so a fn named e.g. `getline`
// (which would never appear as a bare-label data operand here, but be
// safe) is not misclassified.
fn _ex86_is_data_label(s: string) -> bool {
    let n = len(s)
    if n >= 5 && s.substring(0, 5) == ".LCst" { return true }
    if n >= 2 && s.substring(0, 1) == "g" {
        let c = char_code(s, 1)
        if c >= 48 && c <= 57 { return true }   // '0'..'9'
    }
    return false
}

// Normalize a data-address operand to its plain reloc label, accepting both
// the bare `.LCstrN` / `g<id>` form (the original _x86_op_resolve convention)
// AND the `[rip+<label>]`-wrapped form the HexaVal arg-boxing path emits
// (codegen _x86_hv_box_arg, for a runtime-builtin string/global PAYLOAD).
// Both denote the same RIP-relative `lea reg, [rip+0]` + R_X86_64_PC32 the
// native packer materialises — without this the wrapped form missed the
// data-reloc matcher and the lea was dropped, so a `print("hi")` call left
// its payload register unset (the RUNG-2 string-print garbage bug). A
// `@GOTPCREL`/`@PLT`-suffixed inner is a DIFFERENT reloc, not a PC32 data
// label → return "" (leave to the default path). Returns "" when not a data
// label.
fn _ex86_data_label_of(s: string) -> string {
    let n = len(s)
    let mut inner = s
    if n >= 7 && s.substring(0, 5) == "[rip+" && s.substring(n - 1, n) == "]" {
        inner = s.substring(5, n - 1)
    }
    let mut j = 0
    while j < len(inner) {
        if inner.substring(j, j + 1) == "@" { return "" }
        j = j + 1
    }
    if _ex86_is_data_label(inner) { return inner }
    return ""
}

fn _lir_op_uppercase_x86(op: string, ops: [LOperand]) -> string {
    // 0/1-arg ops with no width variant.
    if op == "ret"     { return "RET" }
    if op == "syscall" { return "SYSCALL" }
    if op == "nop"     { return "NOP" }
    if op == "pause"   { return "PAUSE" }   // RFC inline-asm rung 2 (__hx_asm)
    if op == "mfence"  { return "MFENCE" }  // RFC inline-asm rung 2 (__hx_asm)
    if op == "cqo"     { return "CQO" }
    // `push` / `pop` are intentionally NOT here — they're width-
    // dispatched below by reg operand so `push rbp` → PUSH64 (cycle 30)
    // and `push eax` → PUSH (cycle 25).
    if op == "call"    { return "CALL" }
    if op == "jmp"     { return "JMP_REL32" }
    // Conditional branches (lower-case LIR → encoder's REL8 forms).
    if op == "je"  || op == "jz"  { return "JE_REL8" }
    if op == "jne" || op == "jnz" { return "JNE_REL8" }
    if op == "jl"  { return "JL_REL8" }
    if op == "jge" { return "JGE_REL8" }
    if op == "jle" { return "JLE_REL8" }
    if op == "jg"  { return "JG_REL8" }
    // R2d: unsigned conditional branches.
    if op == "ja"  { return "JA_REL8" }
    if op == "jae" { return "JAE_REL8" }
    if op == "jb"  { return "JB_REL8" }
    if op == "jbe" { return "JBE_REL8" }
    // setcc — kept lowercase in LIR, uppercased here.
    if op == "sete"  { return "SETE" }
    if op == "setne" { return "SETNE" }
    if op == "setl"  { return "SETL" }
    if op == "setge" { return "SETGE" }
    if op == "setle" { return "SETLE" }
    if op == "setg"  { return "SETG" }
    // R2d: unsigned/float setcc + conditional move.
    if op == "seta"  { return "SETA" }
    if op == "setae" { return "SETAE" }
    if op == "setb"  { return "SETB" }
    if op == "setbe" { return "SETBE" }
    if op == "cmove"  { return "CMOVE64" }
    if op == "cmovne" { return "CMOVNE64" }
    if op == "movzx" { return "MOVZX" }
    if op == "idiv"  { return "IDIV64" }    // 64-bit-only in encoder
    if op == "test"  { return "TEST64" }    // 64-bit-only in encoder

    // Width-dispatched ops — detect 64-bit operand by reg name prefix
    // OR by mem operand (memory accesses through 64-bit base regs are
    // 64-bit by convention even if the source/dest is r32; cycle 30
    // routes `mov rax, [rbp - 8]` and `mov [rbp - 8], rax` to MOV64).
    let mut is64 = false
    let mut k = 0
    while k < len(ops) {
        if ops[k].kind == "reg" {
            let rn = ops[k].reg.name
            if len(rn) > 0 {
                let c = rn.substring(0, 1)
                if c == "r" || c == "R" { is64 = true }
            }
        }
        if ops[k].kind == "mem" { is64 = true }
        k = k + 1
    }
    if op == "mov" { if is64 { return "MOV64" }; return "MOV" }
    if op == "add" { if is64 { return "ADD64" }; return "ADD" }
    if op == "sub" { if is64 { return "SUB64" }; return "SUB" }
    // ③-R2e: width-dispatch cmp — 64-bit reg operand → CMP64 (REX.W 39/81-7);
    // 32-bit (eax/edx, the va_arg gp/fp_offset checks) stays CMP (r32).
    if op == "cmp" { if is64 { return "CMP64" }; return "CMP" }
    // ③-R2a integer-ALU family — codegen emits these solely with r64
    // operands, so the is64 branch is always taken; the r32 fall-through
    // returns the bare name → a loud ENCODE-MISS (honest, never emitted).
    if op == "imul"  { if is64 { return "IMUL64" };  return "IMUL" }
    if op == "and"   { if is64 { return "AND64" };   return "AND" }
    if op == "or"    { if is64 { return "OR64" };    return "OR" }
    if op == "xor"   { if is64 { return "XOR64" };   return "XOR" }
    if op == "shl"   { if is64 { return "SHL64" };   return "SHL" }
    if op == "shr"   { if is64 { return "SHR64" };   return "SHR" }
    if op == "sar"   { if is64 { return "SAR64" };   return "SAR" }
    if op == "neg"   { if is64 { return "NEG64" };   return "NEG" }
    if op == "not"   { if is64 { return "NOT64" };   return "NOT" }
    if op == "movsx" || op == "movsxd" { return "MOVSXD64" }
    // Cycle 30 mem / r64 push family.
    if op == "lea"  { return "LEA64" }
    if op == "push" { if is64 { return "PUSH64" }; return "PUSH" }
    if op == "pop"  { if is64 { return "POP64" };  return "POP" }
    // ③-R2b SSE scalar-double family. These are width-fixed (the F2/66 0F
    // opcode implies operand size), so no is64 dispatch — map straight to
    // the uppercase encoder op-string. `movq` is the GP↔xmm bit copy the
    // float payload path leans on; the rest are the arith/compare/convert
    // ops the codegen emits with xmm operands.
    if op == "movq"      { return "MOVQ" }
    if op == "movsd"     { return "MOVSD" }
    if op == "addsd"     { return "ADDSD" }
    if op == "subsd"     { return "SUBSD" }
    if op == "mulsd"     { return "MULSD" }
    if op == "divsd"     { return "DIVSD" }
    if op == "comisd"    { return "COMISD" }
    if op == "ucomisd"   { return "UCOMISD" }
    if op == "cvtsi2sd"  { return "CVTSI2SD" }
    if op == "cvttsd2si" { return "CVTTSD2SI" }
    return op
}

fn _lir_operand_str_x86(op: LOperand) -> string {
    if op.kind == "reg"   { return op.reg.name }
    if op.kind == "imm"   { return "#" + to_string(op.imm) }
    if op.kind == "label" { return op.label }
    if op.kind == "mem" {
        // Cycle 30: explicit sign form so `_ex86_parse_mem` doesn't
        // see ambiguous tokens like " + -8" (which would otherwise
        // try to consume both ` + ` and `-`).
        let off = op.mem_offset
        if off == 0  { return "[" + op.mem_base.name + "]" }
        if off > 0   { return "[" + op.mem_base.name + " + " + to_string(off) + "]" }
        return "[" + op.mem_base.name + " - " + to_string(0 - off) + "]"
    }
    return "<?" + op.kind + "?>"
}

fn _lookup_label_x86(names: [string], offsets: [Int], target: string) -> Int {
    let n = len(names)
    let mut i = 0
    while i < n {
        if names[i] == target { return offsets[i] }
        i = i + 1
    }
    return -1
}

fn _pack_fn_x86(out_text: [Int],
                pending_offsets: [Int], pending_names: [string],
                data_offsets: [Int], data_names: [string],
                f: LFunc) {
    let label_names:     [string] = []
    let label_offsets:   [Int]    = []
    let unresolved_brs:  [Int]    = []
    let unresolved_to:   [string] = []
    // Kind tag: 0 = REL8 (2-B insn, imm8 at off+1)
    //           1 = REL32 jmp/call (5-B insn, imm32 at off+1)
    let unresolved_kind: [Int]    = []

    let n = len(f.instrs)
    let mut i = 0
    while i < n {
        let ins = f.instrs[i]
        if ins.op == "label" {
            let mut name = ins.comment
            if len(name) == 0 && len(ins.args) > 0 { name = ins.args[0].label }
            label_names.push(name)
            label_offsets.push(len(out_text))
            i = i + 1
            continue
        }

        // CALL with a label arg — emit placeholder, bubble to pending.
        if ins.op == "call" && len(ins.args) == 1 && ins.args[0].kind == "label" {
            let cur_off = len(out_text)
            out_text.push(0xe8)
            out_text.push(0); out_text.push(0); out_text.push(0); out_text.push(0)
            unresolved_brs.push(cur_off)
            unresolved_to.push(ins.args[0].label)
            unresolved_kind.push(1)
            i = i + 1
            continue
        }
        // Conditional branches to labels — REL8 placeholder (2 B).
        let is_cc = (ins.op == "je"  || ins.op == "jz"  ||
                     ins.op == "jne" || ins.op == "jnz" ||
                     ins.op == "jl"  || ins.op == "jge" ||
                     ins.op == "jle" || ins.op == "jg"  ||
                     ins.op == "ja"  || ins.op == "jae" ||
                     ins.op == "jb"  || ins.op == "jbe")
        if is_cc && len(ins.args) == 1 && ins.args[0].kind == "label" {
            let cur_off = len(out_text)
            let up = _lir_op_uppercase_x86(ins.op, ins.args)
            let bs = encode_x86_64_insn(up, ["x"])
            let mut bi = 0
            while bi < len(bs) { out_text.push(bs[bi]); bi = bi + 1 }
            unresolved_brs.push(cur_off)
            unresolved_to.push(ins.args[0].label)
            unresolved_kind.push(0)
            i = i + 1
            continue
        }
        // Unconditional JMP to label — REL32 form (5 B).
        if ins.op == "jmp" && len(ins.args) == 1 && ins.args[0].kind == "label" {
            let cur_off = len(out_text)
            let bs = encode_x86_64_insn("JMP_REL32", ["x"])
            let mut bi = 0
            while bi < len(bs) { out_text.push(bs[bi]); bi = bi + 1 }
            unresolved_brs.push(cur_off)
            unresolved_to.push(ins.args[0].label)
            unresolved_kind.push(1)
            i = i + 1
            continue
        }

        // Data-address materialization — `mov <reg>, <.LCstrN | g<id>>`.
        // The source is a data symbol whose ADDRESS is wanted; encode as
        // RIP-relative `lea reg, [rip+0]` + bubble an R_X86_64_PC32 reloc
        // at the disp32 field (off+3). Mirrors elf_arm64's ADRP/ADD page
        // capture. Both `mov` (any-width LIR op) and an explicit `lea`
        // route here when the second operand is a data label.
        if (ins.op == "mov" || ins.op == "lea") && len(ins.args) == 2
           && ins.args[0].kind == "reg" && ins.args[1].kind == "label" {
            let dl = _ex86_data_label_of(ins.args[1].label)
            if len(dl) > 0 {
                let rd = _ex86_reg64(ins.args[0].reg.name)
                if rd >= 0 {
                    let cur_off = len(out_text)
                    let bs = _ex86_lea_rip_rel(rd)
                    let mut bi = 0
                    while bi < len(bs) { out_text.push(bs[bi]); bi = bi + 1 }
                    // disp32 sits at the last 4 bytes of the 7-byte insn.
                    data_offsets.push(cur_off + 3)
                    data_names.push(dl)
                    i = i + 1
                    continue
                }
            }
        }

        // Default — format operands, dispatch encoder.
        let ops: [string] = []
        let na = len(ins.args)
        let mut k = 0
        while k < na {
            ops.push(_lir_operand_str_x86(ins.args[k]))
            k = k + 1
        }
        let up = _lir_op_uppercase_x86(ins.op, ins.args)
        let bs = encode_x86_64_insn(up, ops)
        let mut bi = 0
        while bi < len(bs) { out_text.push(bs[bi]); bi = bi + 1 }
        i = i + 1
    }

    // Resolve intra-fn branches. REL8: imm8 at off+1, delta = toff-(off+2).
    // REL32: imm32 at off+1, delta = toff-(off+5).
    let nb = len(unresolved_brs)
    let mut bi = 0
    while bi < nb {
        let off    = unresolved_brs[bi]
        let kind   = unresolved_kind[bi]
        let target = unresolved_to[bi]
        let toff   = _lookup_label_x86(label_names, label_offsets, target)
        if toff < 0 {
            // Extern / cross-fn — bubble to pending; cycle 30 builds reloc.
            pending_offsets.push(off)
            pending_names.push(target)
            bi = bi + 1
            continue
        }
        if kind == 0 {
            let delta = toff - (off + 2)
            out_text[off + 1] = delta & 0xff
        } else {
            let delta = toff - (off + 5)
            out_text[off + 1] =  delta        & 0xff
            out_text[off + 2] = (delta >> 8)  & 0xff
            out_text[off + 3] = (delta >> 16) & 0xff
            out_text[off + 4] = (delta >> 24) & 0xff
        }
        bi = bi + 1
    }
}

// Public entry — walk all LFuncs in `lm`, produce an `ElfX86Obj`
// with `text` + `symbols` + `strtab` populated. Cycle 29 leaves
// `relocs` empty; cycle 30 attaches `R_X86_64_PLT32` records for
// cross-fn / extern CALL/JMP targets that bubble up unresolved.
pub fn pack_lir_x86_64(lm: LModule) -> ElfX86Obj {
    let obj = ElfX86Obj {
        text:     [],
        relocs:   [],
        symbols:  [],
        strtab:   [],
        rodata:   [],
        data:     [],
        bss_size: 0,
        nlocal:   0,
    }
    // ELF strtab convention: index 0 is the empty string (NUL terminator).
    obj.strtab.push(0)

    // Resolve the `.rodata` / `.data` section indices the same way the
    // serializer does (order NULL,.text,[.rela.text],[.rodata],[.data],…).
    // A module carrying rodata/data refs always emits PC32 relocs, so the
    // `.rela.text` section (index 2) is present → first data section is 3.
    let has_rodata = len(lm.rodata) > 0
    let rodata_sec = 3
    let data_sec   = if has_rodata { 4 } else { 3 }

    // Pass 0 — build `.rodata` literal pool + one LOCAL symbol per
    // `.LCstrN` (defined at its pool offset). Mirrors elf_arm64 / macho
    // `__cstring`. `sec.bytes` is hex-encoded NUL-terminated payload.
    let mut r = 0
    let nr = len(lm.rodata)
    while r < nr {
        let sec = lm.rodata[r]
        let pool_off = len(obj.rodata)
        _append_hex_bytes(obj.rodata, sec.bytes)
        let strx = _ew_str(obj.strtab, sec.name)      // `.LCstrN` (verbatim)
        obj.symbols.push(ElfSym {
            name_offset: strx,
            section:     rodata_sec,
            value:       pool_off,
            size:        0,
            bind:        0,    // STB_LOCAL
            type_:       0,    // STT_NOTYPE
        })
        obj.nlocal = obj.nlocal + 1
        r = r + 1
    }

    // Pass 0b — build `.data` module-global pool: one 16-byte zero
    // HexaVal slot per `lm.globals` entry (symbol name `g<id>`), each a
    // LOCAL def. Mirrors elf_arm64 / macho `__data`.
    let mut g = 0
    let ng = len(lm.globals)
    while g < ng {
        let pool_off = len(obj.data)
        let mut z = 0
        while z < 16 { obj.data.push(0); z = z + 1 }
        let strx = _ew_str(obj.strtab, lm.globals[g])
        obj.symbols.push(ElfSym {
            name_offset: strx,
            section:     data_sec,
            value:       pool_off,
            size:        16,
            bind:        0,    // STB_LOCAL
            type_:       0,    // STT_NOTYPE (object data)
        })
        obj.nlocal = obj.nlocal + 1
        g = g + 1
    }

    let pending_offsets: [Int]    = []
    let pending_names:   [string] = []
    let data_offsets:    [Int]    = []
    let data_names:      [string] = []

    let nf = len(lm.funcs)
    let mut i = 0
    while i < nf {
        let f = lm.funcs[i]
        let fn_start = len(obj.text)
        let strx = _ew_str(obj.strtab, f.name)
        _pack_fn_x86(obj.text, pending_offsets, pending_names,
                     data_offsets, data_names, f)
        // ElfSym pushed after packing so `size` is final (hexa rvalue
        // restriction prevents `obj.symbols[k].size = ...` patching).
        obj.symbols.push(ElfSym {
            name_offset: strx,
            section:     1,    // .text (1-based ELF section index)
            value:       fn_start,
            size:        len(obj.text) - fn_start,
            bind:        1,    // STB_GLOBAL
            type_:       2,    // STT_FUNC
        })
        i = i + 1
    }
    // ── Cycle 30: bubbled CALL targets → reloc records ──────────
    //
    // Each entry in pending_* is the .text offset of a 5-byte
    // CALL placeholder (`E8 00 00 00 00`) whose target name wasn't
    // resolvable inside the LFunc it came from. For each:
    //
    //   1. Look up the target in `obj.symbols` (defined-fn match).
    //      If found AND section != 0, pre-patch imm32 with the PC-rel
    //      delta (linker re-validates against the reloc).
    //   2. If not found, append an undef extern symbol entry
    //      (section=0=SHN_UNDEF, bind=STB_GLOBAL, type=NOTYPE).
    //   3. Emit one `R_X86_64_PLT32` reloc against that symbol with
    //      addend=-4 (CALL imm32 reads `target - (next_insn_pc)`
    //      and the linker formula `S + A - P` gives that when
    //      S=symbol_value, A=-4, P=imm32_offset).
    // #3712 — name→symtab-index memo cache shared by the CALL + data reloc
    // passes. Deep functions (the 7000-`+` runtime_cuda_emit emits thousands
    // of `call hexa_add` placeholders) drove _find_elf_sym_by_name — an
    // O(symbols) linear scan — once PER pending reloc → O(relocs·symbols), the
    // dominant emit cost once the #3709 deep-spine fix let the file reach emit.
    // A name resolves DETERMINISTICALLY (a defined sym is stable; an undef
    // pushed once is found at the same index forever after), so memoizing the
    // first resolution per distinct name is byte-IDENTICAL. Distinct callee
    // names are few (~tens), so the cache scan is ~O(distinct) ≪ O(symbols).
    let mut _symc_names: [string] = []
    let mut _symc_idx:   [Int]    = []
    let np = len(pending_offsets)
    let mut pi = 0
    while pi < np {
        let call_off = pending_offsets[pi]
        let name     = pending_names[pi]
        // Cached resolution first; fall back to the symtab scan on a miss.
        let mut idx = _symc_lookup(_symc_names, _symc_idx, name)
        let was_cached = idx >= 0
        if idx < 0 {
            idx = _find_elf_sym_by_name(obj.symbols, obj.strtab, name)
        }
        if idx < 0 {
            // Push an undef extern entry. Index 0 of ELF symtab is
            // reserved (STN_UNDEF); the serializer prepends it, so
            // we just append our undef here and the serializer's
            // count is `1 + len(obj.symbols)` for the .symtab section.
            let strx = _ew_str(obj.strtab, name)
            obj.symbols.push(ElfSym {
                name_offset: strx,
                section:     0,    // SHN_UNDEF
                value:       0,
                size:        0,
                bind:        1,    // STB_GLOBAL
                type_:       0,    // STT_NOTYPE
            })
            idx = len(obj.symbols) - 1
        }
        // Memoize on a MISS only (so the cache holds one entry per distinct
        // name — pushing on hits too would re-grow it to O(N)).
        if !was_cached {
            _symc_names.push(name)
            _symc_idx.push(idx)
        }
        // The reloc's `r_offset` points at the imm32 field of the
        // CALL placeholder, i.e. call_off + 1.
        let r_off = call_off + 1
        obj.relocs.push(ElfRel {
            offset:  r_off,
            sym_idx: idx,
            kind:    ELF_R_X86_64_PLT32,
            addend:  -4,
            site_seg: 1,
        })
        // Intra-module pre-patch — when the target is defined here
        // (section != 0), compute the delta the linker would write
        // and put it in the imm32 so the .o is runnable even without
        // `ld -r`. Mirrors macho_arm64 pack_lir's BL pre-patch.
        let sym = obj.symbols[idx]
        if sym.section != 0 {
            let delta = sym.value - (call_off + 5)
            obj.text[call_off + 1] =  delta        & 0xff
            obj.text[call_off + 2] = (delta >> 8)  & 0xff
            obj.text[call_off + 3] = (delta >> 16) & 0xff
            obj.text[call_off + 4] = (delta >> 24) & 0xff
        }
        pi = pi + 1
    }

    // ── Pass 3: data-address refs → R_X86_64_PC32 reloc records ──
    //
    // Each entry in data_* is the disp32 offset of a RIP-relative
    // `lea reg, [rip+0]` placeholder whose source is a `.LCstrN` /
    // `g<id>` data symbol. The symbol is already defined (Pass 0/0b
    // built the LOCAL defs). Emit one R_X86_64_PC32 with addend -4:
    // the linker computes `S + A - P` = symbol_addr - (disp32_off + 4)
    // = symbol_addr - next_insn_pc, exactly the RIP-relative
    // displacement. Mirrors elf_arm64's Pass 3 ADR_PREL_PG_HI21 /
    // ADD_ABS_LO12_NC, collapsed to the single x86_64 PC32 reloc.
    let nd = len(data_offsets)
    let mut dpi = 0
    while dpi < nd {
        let disp_off = data_offsets[dpi]
        let name     = data_names[dpi]
        // Same #3712 memo cache as the CALL pass (shared across both passes).
        let mut idx = _symc_lookup(_symc_names, _symc_idx, name)
        let was_cached = idx >= 0
        if idx < 0 {
            idx = _find_elf_sym_by_name(obj.symbols, obj.strtab, name)
        }
        if idx < 0 {
            // Unknown data target (no `.LCstrN`/`g<id>` def) → undef
            // extern. Keeps the .o well-formed; the linker resolves it.
            let strx = _ew_str(obj.strtab, name)
            obj.symbols.push(ElfSym {
                name_offset: strx,
                section:     0,    // SHN_UNDEF
                value:       0,
                size:        0,
                bind:        1,    // STB_GLOBAL
                type_:       0,    // STT_NOTYPE
            })
            idx = len(obj.symbols) - 1
        }
        if !was_cached {
            _symc_names.push(name)
            _symc_idx.push(idx)
        }
        obj.relocs.push(ElfRel {
            offset:  disp_off,
            sym_idx: idx,
            kind:    ELF_R_X86_64_PC32,
            addend:  -4,
            site_seg: 1,
        })
        dpi = dpi + 1
    }
    return obj
}

// Walk `obj.symbols`, compare each name (read out of strtab via
// `name_offset`) to `name`. Returns -1 if no match.
// #3712 — distinct-name resolution cache (parallel arrays, one entry per
// distinct callee/data name). Returns the memoized symtab index or -1 on miss.
// O(distinct) per probe; distinct names are few even when relocs number in the
// thousands, so this collapses the per-reloc _find_elf_sym_by_name O(symbols)
// scan to ~O(1) amortized. Byte-eq NEUTRAL: returns the same index the scan
// would (memoized from its first result).
fn _symc_lookup(names: [string], idxs: [Int], name: string) -> Int {
    let n = len(names)
    let mut i = 0
    while i < n {
        if names[i] == name { return idxs[i] }
        i = i + 1
    }
    return -1
}

fn _find_elf_sym_by_name(symbols: [ElfSym], strtab: [Int], name: string) -> Int {
    let nl = len(name)
    let ns = len(symbols)
    let mut i = 0
    while i < ns {
        let off = symbols[i].name_offset
        let mut k = 0
        let mut ok = true
        while k < nl {
            if (strtab[off + k] & 0xff) != char_code(name, k) { ok = false; break }
            k = k + 1
        }
        // Require terminating NUL at the right slot — guards against
        // "compute" matching the prefix of "compute_helper".
        if ok && (strtab[off + nl] & 0xff) == 0 { return i }
        i = i + 1
    }
    return -1
}
