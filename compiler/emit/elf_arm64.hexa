// compiler/emit/elf_arm64.hexa
//
// SELFHOST-NEXT — in-tree ELF AArch64 relocatable-object serializer.
//
// Continuation of PR #2537 (linux-arm64 cross-EMIT). #2537 produced
// correct ELF AArch64 *assembly* that the host `aarch64-linux-gnu-as`
// cross-assembled into a `.o`. This module removes that host-`as`
// dependency: it serializes the ELF AArch64 `.o` bytes NATIVELY,
// directly from the post-codegen `LModule`.
//
// Design — keyed off `compiler/emit/elf_x86_64.hexa`'s ELF model
// (the cleanest in-tree ELF reference: STN_UNDEF index 0, `.rela.text`,
// `.symtab`/`.strtab`/`.shstrtab`, Elf64_Rela), but:
//   * e_machine            = ELF_EM_AARCH64 (0xb7)        (was 0x3e)
//   * text bytes           = 4-byte LE words from
//                            `encode_arm64_insn` (reused from
//                            `compiler/emit/macho_arm64.hexa`) — NOT the
//                            variable-length x86 encoder.
//   * relocations          = R_AARCH64_* (CALL26 / ADR_PREL_PG_HI21 /
//                            ADD_ABS_LO12_NC / ABS64) instead of
//                            R_X86_64_*.
//   * symbol names         = bare ELF identifiers (no Mach-O `_`
//                            prefix) — the linux-arm64 ABI uses the
//                            source name verbatim.
//
// SCOPE (smallest increment to a NATIVE linux-arm64 `.o`):
//   * exit(42): `main` returning 42 → ELF AArch64 `.o`, readelf -h/-r
//     clean, links + runs rc 42 under qemu.
//   * Intra-fn branches (B/BL/CBZ/CBNZ/B.cond) resolved at pack time
//     (PC-relative imm26/imm19), mirroring macho `_pack_fn`.
//   * Cross-fn / extern BL → R_AARCH64_CALL26 reloc record against an
//     (undef or defined) symbol, with intra-module pre-patch.
// LANDED (this increment — verified on summer + qemu-aarch64):
//   * ADRP/ADD page reloc pairs for `.rodata`/`.data` symbol references
//     (R_AARCH64_ADR_PREL_PG_HI21 + ADD_ABS_LO12_NC). The walker captures
//     `@PAGE`/`@PAGEOFF` operands → Pass-3 reloc records vs the local
//     `.LCstrN`/`g<id>` symbol; GOT-suffixed forms fold to the same pair.
//   * `.rodata` (string/const literal pool) + `.data` (16-byte HexaVal
//     module-global slots) + `.bss` (SHT_NOBITS) section emission. The
//     text-only exit(42) path stays byte-identical (all gated on presence).
//   * LOCAL-before-GLOBAL `.symtab` ordering (`.LCstrN`/`g<id>` locals
//     precede fn globals; sh_info = nlocal+1) per the ELF ABI.
// Out of scope this increment (precise gap recorded in the domain log):
//   * R_AARCH64_ABS64 — constant + generic Elf64_Rela path present, but no
//     codegen operand lowers to a 64-bit absolute data pointer yet (the
//     backend uses the PIE-friendly ADRP/ADD page form for all refs).

// ─────────────────────────────────────────────────────────────────
// AArch64 ELF reloc-type constants (binutils `elf/aarch64.h`)
// ─────────────────────────────────────────────────────────────────
//
// `ELF_R_AARCH64_*` prefix to avoid collision with the `ELF_R_X86_64_*`
// constants in elf_x86_64.hexa (whole-program compile shares scope).

let ELF_R_AARCH64_NONE             = 0
let ELF_R_AARCH64_ABS64            = 257   // S + A (64-bit absolute)
let ELF_R_AARCH64_ABS32            = 258
let ELF_R_AARCH64_ADR_PREL_PG_HI21 = 275   // ADRP: Page(S+A) - Page(P)
let ELF_R_AARCH64_ADD_ABS_LO12_NC  = 277   // ADD:  (S+A) & 0xfff
let ELF_R_AARCH64_CALL26           = 283   // BL:   (S+A-P) >> 2, imm26
let ELF_R_AARCH64_JUMP26           = 282   // B:    (S+A-P) >> 2, imm26
// axis-③ arm64 own-link rung-2 (S1) — reloc types the cross-gcc runtime.arm64.a emits
// beyond the rung-1 set. Numbers reference-matched to the AArch64 ELF psABI +
// compiler/link/hexa_ld.hexa:692-697. (LDST family = scaled-imm12 loads/stores;
// GOT pair = static-GOT synth targets, S5.) Applied by _apply_arm64_reloc (S4).
let ELF_R_AARCH64_PREL32            = 261   // S + A - P (word32)
let ELF_R_AARCH64_LDST8_ABS_LO12_NC  = 278   // scale 0
let ELF_R_AARCH64_LDST16_ABS_LO12_NC = 284   // scale 1
let ELF_R_AARCH64_LDST32_ABS_LO12_NC = 285   // scale 2
let ELF_R_AARCH64_LDST64_ABS_LO12_NC = 286   // scale 3
let ELF_R_AARCH64_LDST128_ABS_LO12_NC = 299  // scale 4
let ELF_R_AARCH64_ADR_GOT_PAGE     = 311   // ADRP: Page(G+A) - Page(P)  (G = GOT slot vaddr)
let ELF_R_AARCH64_LD64_GOT_LO12_NC = 312   // LDR:  (G+A) & 0xfff >> 3
// axis-③ arm64 own-link rung-3 (S1) — dynamic-link (Road A) reloc types. Only these
// two are needed for the GLOB_DAT-only eager-binding design (reference-matched to
// elf_x86_64.hexa, which emits R_X86_64_GLOB_DAT(6) + COPY(5) only — no JUMP_SLOT,
// no lazy PLT). GLOB_DAT fills a shared GOT slot from ld.so at load; COPY (data
// import) is NOT ported in the rung-3 minimal cut (all 6 floor syms are STT_FUNC —
// the census fails closed with rc=3 if any dyn sym is STT_OBJECT).
let ELF_R_AARCH64_COPY             = 1024  // ld.so memcpy of a data import (COPY lane — not ported)
let ELF_R_AARCH64_GLOB_DAT         = 1025  // ld.so writes S into the GOT slot at r_offset

// _elf_arm64_kind_is_got — mirrors elf_x86_64.hexa _elf_kind_is_got. GOT-relocs
// route through the static-GOT synth (S5) rather than a direct S+A patch.
fn _elf_arm64_kind_is_got(k: Int) -> Int {
    if k == ELF_R_AARCH64_ADR_GOT_PAGE { return 1 }
    if k == ELF_R_AARCH64_LD64_GOT_LO12_NC { return 1 }
    return 0
}

// ─────────────────────────────────────────────────────────────────
// Object model — reuses `ElfRel` / `ElfSym` from elf_x86_64.hexa
// (identical Elf64_Rela / Elf64_Sym shapes; only the `kind` values
// and `e_machine` differ between x86_64 and AArch64).
// ─────────────────────────────────────────────────────────────────

struct ElfArm64Obj {
    text:    [u8],
    relocs:  [ElfRel],
    symbols: [ElfSym],
    strtab:  [u8],
    // `.rodata` — concatenated string/const literal pool, one entry per
    // `lm.rodata` LSection (mirrors macho `__cstring`). Each `.LCstrN`
    // gets a LOCAL N_SECT-equivalent symbol at its pool offset; the
    // ADRP/ADD `@PAGE`/`@PAGEOFF` reloc pair resolves against it.
    rodata:  [u8],
    // `.data` — module-global pool: one 16-byte zero HexaVal slot per
    // `lm.globals` entry (symbol name `g<id>`). Mirrors macho `__data`.
    data:    [u8],
    // `.bss` byte count — zero-init storage (SHT_NOBITS, no file bytes).
    // Currently 0 unless an LSection in `lm.bss` requests it.
    bss_size: i64,
    // Count of LOCAL symbols (the leading `.LCstrN`/`g<id>` defs). ELF
    // requires LOCAL symbols precede GLOBAL in `.symtab`; this is the
    // `.symtab` `sh_info` (index of the first non-local symbol = nlocal+1
    // counting STN_UNDEF at index 0).
    nlocal:  i64,
}

// Map an arm64 `@…` page-relative operand suffix to its ELF AArch64
// reloc kind, returning [kind, base_len]. Mirrors macho's
// `_label_reloc_kind` but yields R_AARCH64_* constants. kind == -1 means
// no recognized suffix. GOT forms fall back to the non-GOT page/lo12
// pair (the linux-arm64 native obj path is static/non-PIE for now; a
// real GOT slot is a later increment — recorded in the domain log).
//   `sym@PAGE`       -> ADR_PREL_PG_HI21
//   `sym@PAGEOFF`    -> ADD_ABS_LO12_NC
//   `sym@GOTPAGE`    -> ADR_PREL_PG_HI21  (no GOT yet)
//   `sym@GOTPAGEOFF` -> ADD_ABS_LO12_NC   (no GOT yet)
fn _elf_arm64_reloc_kind(s: string) -> [Int] {
    if _ends_with(s, "@GOTPAGEOFF") { return [ELF_R_AARCH64_ADD_ABS_LO12_NC,  len(s) - 11] }
    if _ends_with(s, "@GOTPAGE")    { return [ELF_R_AARCH64_ADR_PREL_PG_HI21, len(s) - 8] }
    if _ends_with(s, "@PAGEOFF")    { return [ELF_R_AARCH64_ADD_ABS_LO12_NC,  len(s) - 8] }
    if _ends_with(s, "@PAGE")       { return [ELF_R_AARCH64_ADR_PREL_PG_HI21, len(s) - 5] }
    return [-1, len(s)]
}

// ─────────────────────────────────────────────────────────────────
// serialize_elf_arm64 — ELF AArch64 relocatable `.o` byte stream.
// ─────────────────────────────────────────────────────────────────
//
// Byte-for-byte the same section layout as `serialize_elf_x86_64`
// (header → .text → .rela.text → .symtab → .strtab → .shstrtab →
// section header table). The ONLY wire deltas vs the x86_64 serializer:
//   * e_machine = ELF_EM_AARCH64
//   * the `.text` section is a sequence of 4-byte instruction words
//     (the caller's `obj.text` is already byte-packed LE by pack_lir).
//   * the reloc `kind` values written into r_info are R_AARCH64_*.
// Everything structural (the `_ew_*` writers, STN_UNDEF index-0 sym,
// Elf64_Rela r_info = (sym_idx_1based << 32) | kind, sh_link/sh_info)
// is shared, so this stays a faithful sibling of the proven x86 path.
pub fn serialize_elf_arm64(obj: ElfArm64Obj) -> [Int] {
    let out: [Int] = []
    let text_size = len(obj.text)
    let nrelocs = len(obj.relocs)
    let rodata_size = len(obj.rodata)
    let data_size   = len(obj.data)
    let bss_size    = obj.bss_size
    let has_rodata = rodata_size > 0
    let has_data   = data_size > 0
    let has_bss    = bss_size > 0

    // ELF symtab: index 0 is STN_UNDEF (all zeros); real syms at 1+.
    // reloc.sym_idx is incremented by 1 when written into r_info.
    let nsyms_real = len(obj.symbols)
    let symtab_size = 24 * (nsyms_real + 1)
    let strsize = len(obj.strtab)

    let shstrtab: [Int] = []
    shstrtab.push(0)
    let off_text     = _ew_str(shstrtab, ".text")
    let off_rela_text = if nrelocs > 0 { _ew_str(shstrtab, ".rela.text") } else { 0 }
    let off_rodata   = if has_rodata { _ew_str(shstrtab, ".rodata") } else { 0 }
    let off_data     = if has_data   { _ew_str(shstrtab, ".data") } else { 0 }
    let off_bss      = if has_bss    { _ew_str(shstrtab, ".bss") } else { 0 }
    let off_symtab   = _ew_str(shstrtab, ".symtab")
    let off_strtab   = _ew_str(shstrtab, ".strtab")
    let off_shstrtab = _ew_str(shstrtab, ".shstrtab")
    let shstrsize = len(shstrtab)

    let elf_header_size = 64
    let shdr_size = 64

    // Section index assignment (order: NULL, .text, [.rela.text],
    // [.rodata], [.data], [.bss], .symtab, .strtab, .shstrtab). Indices
    // shift as optional sections appear; relocs/symbols carry resolved
    // section indices already (computed in pack_lir to match this order).
    let rela_sec = if nrelocs > 0 { 2 } else { 0 }
    let mut next = if nrelocs > 0 { 3 } else { 2 }
    let rodata_sec = if has_rodata { next } else { 0 }
    if has_rodata { next = next + 1 }
    let data_sec = if has_data { next } else { 0 }
    if has_data { next = next + 1 }
    let bss_sec = if has_bss { next } else { 0 }
    if has_bss { next = next + 1 }
    let symtab_sec = next
    let strtab_sec = next + 1
    let shstrndx   = next + 2
    let nshdrs     = next + 3

    let text_off     = elf_header_size
    // arm64 instructions are 4-byte; the stream is already a multiple of
    // 4. Pad to 8 anyway so `.rela.text` starts on an 8-byte boundary
    // (Elf64_Rela is 8-aligned), matching the x86 serializer.
    let text_pad     = (8 - (text_size & 7)) & 7
    let rela_size    = 24 * nrelocs
    let rela_off     = text_off + text_size + text_pad
    // .rodata follows .rela.text, 8-aligned (string literal pool).
    let rodata_off   = rela_off + rela_size
    let rodata_pad   = if has_rodata { (8 - (rodata_size & 7)) & 7 } else { 0 }
    // .data follows .rodata, 8-aligned (16-byte HexaVal slots already 8-mult).
    let data_off     = rodata_off + rodata_size + rodata_pad
    let data_pad     = if has_data { (8 - (data_size & 7)) & 7 } else { 0 }
    // .bss is SHT_NOBITS — occupies NO file bytes (next section starts here).
    let symtab_off   = data_off + data_size + data_pad
    let strtab_off   = symtab_off + symtab_size
    let shstrtab_off = strtab_off + strsize
    let pre_shdr     = shstrtab_off + shstrsize
    let shdr_pad     = (8 - (pre_shdr & 7)) & 7
    let shdr_off     = pre_shdr + shdr_pad

    // ── ELF64 header ──
    out.push(ELF_EI_MAG0); out.push(ELF_EI_MAG1)
    out.push(ELF_EI_MAG2); out.push(ELF_EI_MAG3)
    out.push(ELF_ELFCLASS64)
    out.push(ELF_ELFDATA2LSB)
    out.push(ELF_EV_CURRENT)
    out.push(ELF_ELFOSABI_NONE)
    _ew_zero(out, 8)                       // EI_ABIVERSION + 7 pad
    _ew_u16(out, ELF_ET_REL)
    _ew_u16(out, ELF_EM_AARCH64)           // ← the AArch64 delta
    _ew_u32(out, ELF_EV_CURRENT)
    _ew_u64(out, 0)                         // e_entry
    _ew_u64(out, 0)                         // e_phoff
    _ew_u64(out, shdr_off)                  // e_shoff
    _ew_u32(out, 0)                         // e_flags
    _ew_u16(out, elf_header_size)           // e_ehsize
    _ew_u16(out, 0)                         // e_phentsize
    _ew_u16(out, 0)                         // e_phnum
    _ew_u16(out, shdr_size)                 // e_shentsize
    _ew_u16(out, nshdrs)                    // e_shnum
    _ew_u16(out, shstrndx)                  // e_shstrndx

    // ── .text (4-byte LE instruction words, pre-packed by pack_lir) ──
    let mut ti = 0
    while ti < text_size { out.push(obj.text[ti] & 0xff); ti = ti + 1 }
    _ew_zero(out, text_pad)

    // ── .rela.text ──
    // Elf64_Rela = r_offset(u64) r_info(u64) r_addend(i64). sym index in
    // r_info is the high 32 bits; reloc kind the low 32. +1 because ELF
    // symtab index 0 is STN_UNDEF.
    let mut ri = 0
    while ri < nrelocs {
        let r = obj.relocs[ri]
        _ew_u64(out, r.offset)
        let sym_index_1based = r.sym_idx + 1
        _ew_u64(out, (sym_index_1based << 32) | (r.kind & 0xffffffff))
        _ew_u64(out, r.addend)
        ri = ri + 1
    }

    // ── .rodata (string/const literal pool) ──
    if has_rodata {
        let mut di = 0
        while di < rodata_size { out.push(obj.rodata[di] & 0xff); di = di + 1 }
        _ew_zero(out, rodata_pad)
    }

    // ── .data (module-global HexaVal slots, zero-initialized) ──
    if has_data {
        let mut gi = 0
        while gi < data_size { out.push(obj.data[gi] & 0xff); gi = gi + 1 }
        _ew_zero(out, data_pad)
    }
    // .bss has NO file bytes (SHT_NOBITS).

    // ── .symtab ──
    // Index 0: STN_UNDEF (all zeros, 24 B).
    _ew_zero(out, 24)
    let mut si = 0
    while si < nsyms_real {
        let s = obj.symbols[si]
        _ew_u32(out, s.name_offset)
        let st_info = ((s.bind & 0xf) << 4) | (s.type_ & 0xf)
        out.push(st_info & 0xff)
        out.push(0)                          // st_other
        _ew_u16(out, s.section)
        _ew_u64(out, s.value)
        _ew_u64(out, s.size)
        si = si + 1
    }

    // ── .strtab ──
    let mut ki = 0
    while ki < strsize { out.push(obj.strtab[ki] & 0xff); ki = ki + 1 }

    // ── .shstrtab ──
    let mut hi = 0
    while hi < shstrsize { out.push(shstrtab[hi] & 0xff); hi = hi + 1 }
    _ew_zero(out, shdr_pad)

    // ── Section header table ──
    // [0] SHT_NULL.
    _ew_zero(out, 64)
    // [1] .text.
    _ew_u32(out, off_text)
    _ew_u32(out, ELF_SHT_PROGBITS)
    _ew_u64(out, ELF_SHF_ALLOC | ELF_SHF_EXECINSTR)
    _ew_u64(out, 0)
    _ew_u64(out, text_off)
    _ew_u64(out, text_size)
    _ew_u32(out, 0); _ew_u32(out, 0)
    // arm64 .text alignment = 4 (one instruction word).
    _ew_u64(out, 4); _ew_u64(out, 0)
    // [2] .rela.text (only when relocs exist).
    if nrelocs > 0 {
        _ew_u32(out, off_rela_text)
        _ew_u32(out, ELF_SHT_RELA)
        _ew_u64(out, 0); _ew_u64(out, 0)
        _ew_u64(out, rela_off)
        _ew_u64(out, rela_size)
        _ew_u32(out, symtab_sec)             // sh_link → .symtab
        _ew_u32(out, 1)                       // sh_info → .text section idx
        _ew_u64(out, 8); _ew_u64(out, 24)
    }
    // [rodata_sec] .rodata (ALLOC, read-only string/const pool).
    if has_rodata {
        _ew_u32(out, off_rodata)
        _ew_u32(out, ELF_SHT_PROGBITS)
        _ew_u64(out, ELF_SHF_ALLOC)
        _ew_u64(out, 0)
        _ew_u64(out, rodata_off)
        _ew_u64(out, rodata_size)
        _ew_u32(out, 0); _ew_u32(out, 0)
        _ew_u64(out, 8); _ew_u64(out, 0)
    }
    // [data_sec] .data (ALLOC|WRITE, module-global slots).
    if has_data {
        _ew_u32(out, off_data)
        _ew_u32(out, ELF_SHT_PROGBITS)
        _ew_u64(out, ELF_SHF_ALLOC | ELF_SHF_WRITE)
        _ew_u64(out, 0)
        _ew_u64(out, data_off)
        _ew_u64(out, data_size)
        _ew_u32(out, 0); _ew_u32(out, 0)
        _ew_u64(out, 8); _ew_u64(out, 0)
    }
    // [bss_sec] .bss (ALLOC|WRITE, SHT_NOBITS — sh_size but no file bytes).
    if has_bss {
        _ew_u32(out, off_bss)
        _ew_u32(out, ELF_SHT_NOBITS)
        _ew_u64(out, ELF_SHF_ALLOC | ELF_SHF_WRITE)
        _ew_u64(out, 0)
        _ew_u64(out, symtab_off)              // sh_offset (conventional: = next sec)
        _ew_u64(out, bss_size)
        _ew_u32(out, 0); _ew_u32(out, 0)
        _ew_u64(out, 8); _ew_u64(out, 0)
    }
    // [symtab_sec] .symtab.
    _ew_u32(out, off_symtab)
    _ew_u32(out, ELF_SHT_SYMTAB)
    _ew_u64(out, 0); _ew_u64(out, 0)
    _ew_u64(out, symtab_off)
    _ew_u64(out, symtab_size)
    _ew_u32(out, strtab_sec)                  // sh_link → .strtab
    _ew_u32(out, obj.nlocal + 1)              // sh_info = 1 past last LOCAL
    _ew_u64(out, 8); _ew_u64(out, 24)
    // [strtab_sec] .strtab.
    _ew_u32(out, off_strtab)
    _ew_u32(out, ELF_SHT_STRTAB)
    _ew_u64(out, 0); _ew_u64(out, 0)
    _ew_u64(out, strtab_off)
    _ew_u64(out, strsize)
    _ew_u32(out, 0); _ew_u32(out, 0)
    _ew_u64(out, 1); _ew_u64(out, 0)
    // [shstrndx] .shstrtab.
    _ew_u32(out, off_shstrtab)
    _ew_u32(out, ELF_SHT_STRTAB)
    _ew_u64(out, 0); _ew_u64(out, 0)
    _ew_u64(out, shstrtab_off)
    _ew_u64(out, shstrsize)
    _ew_u32(out, 0); _ew_u32(out, 0)
    _ew_u64(out, 1); _ew_u64(out, 0)

    return out
}

// ─────────────────────────────────────────────────────────────────
// LIR walker — `LModule` → ElfArm64Obj  (mirrors macho_arm64 pack_lir)
// ─────────────────────────────────────────────────────────────────
//
// `pack_lir_arm64_elf(lm)` walks `lm.funcs`, encodes each `LInstr` via
// the SHARED `encode_arm64_insn` (4-byte word), patches intra-fn
// branches, and emits R_AARCH64_CALL26 relocs for unresolved BL
// targets. Symbol names are BARE (ELF) — no Mach-O `_` mangling.
//
// Reuses these helpers already defined in macho_arm64.hexa:
//   encode_arm64_insn / _lir_op_uppercase / _lir_operand_str /
//   _push_word_le / _patch_word_le
// and from elf_x86_64.hexa: _ew_str (strtab byte writer).

fn _pack_fn_arm64_elf(out_text: [Int],
                      pending_offsets: [Int], pending_names: [string],
                      page_offsets: [Int], page_names: [string],
                      page_kinds: [Int],
                      f: LFunc) {
    let label_names:    [string] = []
    let label_offsets:  [Int]    = []
    let unresolved_brs: [Int]    = []
    let unresolved_to:  [string] = []

    let n = len(f.instrs)
    let mut i = 0
    while i < n {
        let ins = f.instrs[i]
        if ins.op == "label" {
            let mut name = ins.comment
            if len(name) == 0 && len(ins.args) > 0 { name = ins.args[0].label }
            label_names.push(name)
            label_offsets.push(len(out_text))
            i = i + 1
            continue
        }

        // Format operands; capture at most one page-relative `@…` operand
        // per instruction (ADRP `@PAGE` / ADD `@PAGEOFF` / GOT variants).
        // The captured operand is sanitized to a zero-immediate base form
        // so the encoder emits the bare word; Pass-4 attaches the matching
        // ADR_PREL_PG_HI21 / ADD_ABS_LO12_NC reloc. Mirrors macho_arm64.
        let mut ops: [string] = []
        let na = len(ins.args)
        let mut page_kind = -1
        let mut page_name = ""
        let mut k = 0
        while k < na {
            let arg = ins.args[k]
            let raw = _lir_operand_str(arg)
            let rk = _elf_arm64_reloc_kind(raw)
            if rk[0] >= 0 && (arg.kind == "label" || arg.kind == "mem") {
                page_kind = rk[0]
                page_name = _label_base_name(arg, rk[1])
                if arg.kind == "mem" {
                    ops.push("[" + arg.mem_base.name + ", #0]")
                } else {
                    ops.push("#0")
                }
            } else {
                ops.push(raw)
            }
            k = k + 1
        }

        let up = _lir_op_uppercase(ins.op)
        let word = encode_arm64_insn(up, ops)
        let cur_off = len(out_text)

        // Symbol-relative page operand → base word + Pass-4 page reloc.
        if page_kind >= 0 {
            _push_word_le(out_text, word)
            page_offsets.push(cur_off)
            page_names.push(page_name)
            page_kinds.push(page_kind)
            i = i + 1
            continue
        }

        // B / BL with a label arg.
        if (up == "B" || up == "BL") && na == 1 && ins.args[0].kind == "label" {
            _push_word_le(out_text, word)
            unresolved_brs.push(cur_off)
            unresolved_to.push(ins.args[0].label)
            i = i + 1
            continue
        }
        // CBZ / CBNZ Xt, label — label is args[1].
        if (up == "CBZ" || up == "CBNZ") && na == 2 && ins.args[1].kind == "label" {
            _push_word_le(out_text, word)
            unresolved_brs.push(cur_off)
            unresolved_to.push(ins.args[1].label)
            i = i + 1
            continue
        }
        // B.cond label.
        if len(up) > 2 && up.substring(0, 2) == "B." && na == 1 && ins.args[0].kind == "label" {
            _push_word_le(out_text, word)
            unresolved_brs.push(cur_off)
            unresolved_to.push(ins.args[0].label)
            i = i + 1
            continue
        }

        _push_word_le(out_text, word)
        i = i + 1
    }

    // Resolve intra-fn branches; bubble cross-fn / extern targets.
    // imm26 (B/BL) = bits [25:0] of word = delta/4. imm19 (CBZ/CBNZ/
    // B.cond) = bits [23:5] = delta/4.
    let nb = len(unresolved_brs)
    let mut bi = 0
    while bi < nb {
        let off    = unresolved_brs[bi]
        let target = unresolved_to[bi]
        let toff   = _elf_lookup_label(label_names, label_offsets, target)
        if toff < 0 {
            pending_offsets.push(off)
            pending_names.push(target)
            bi = bi + 1
            continue
        }
        let delta = (toff - off) / 4
        let w0 = out_text[off + 0]
        let w1 = out_text[off + 1]
        let w2 = out_text[off + 2]
        let w3 = out_text[off + 3]
        let cur = w0 | (w1 << 8) | (w2 << 16) | (w3 << 24)
        let top = (cur >> 26) & 0x3f
        if top == 0x05 || top == 0x25 {
            // B / BL → imm26.
            let patched = (cur & 0xfc000000) | (delta & 0x03ffffff)
            _patch_word_le(out_text, off, patched)
        } else {
            // CBZ / CBNZ / B.cond → imm19 at bits [23:5].
            let imm19 = delta & 0x7ffff
            let patched = (cur & 0xff00001f) | (imm19 << 5)
            _patch_word_le(out_text, off, patched)
        }
        bi = bi + 1
    }
}

fn _elf_lookup_label(names: [string], offsets: [Int], target: string) -> Int {
    let n = len(names)
    let mut i = 0
    while i < n {
        if names[i] == target { return offsets[i] }
        i = i + 1
    }
    return -1
}

// Public entry — LModule → ElfArm64Obj (text + symbols + strtab +
// relocs). Symbol names are bare ELF identifiers.
//
// Symbol ORDER (ELF requires LOCAL before GLOBAL in `.symtab`):
//   [0..nlocal)  — `.LCstrN` rodata literals + `g<id>` data globals
//                  (STB_LOCAL, defined N_SECT-equivalent).
//   [nlocal..]   — fn defs (STB_GLOBAL STT_FUNC) + undef externs.
// `obj.nlocal` is stored so `serialize_elf_arm64` can stamp the .symtab
// `sh_info` (= first-non-local index = nlocal+1, counting STN_UNDEF).
pub fn pack_lir_arm64_elf(lm: LModule) -> ElfArm64Obj {
    let mut obj = ElfArm64Obj {
        text:     [],
        relocs:   [],
        symbols:  [],
        strtab:   [],
        rodata:   [],
        data:     [],
        bss_size: 0,
        nlocal:   0,
    }
    // ELF strtab convention: index 0 is the empty string (NUL).
    obj.strtab.push(0)

    // Resolve the `.rodata` / `.data` section indices the same way the
    // serializer does (order NULL,.text,[.rela.text],[.rodata],[.data],…).
    // A module carrying rodata/data refs always emits page relocs, so the
    // `.rela.text` section (index 2) is present → first data section is 3.
    let has_rodata = len(lm.rodata) > 0
    let has_data   = len(lm.globals) > 0
    let rodata_sec = 3
    let data_sec   = if has_rodata { 4 } else { 3 }

    // Pass 0 — build `.rodata` literal pool + one LOCAL symbol per
    // `.LCstrN` (defined at its pool offset). Mirrors macho `__cstring`.
    let mut r = 0
    let nr = len(lm.rodata)
    while r < nr {
        let sec = lm.rodata[r]
        let pool_off = len(obj.rodata)
        _append_hex_bytes(obj.rodata, sec.bytes)
        let strx = _ew_str(obj.strtab, sec.name)      // `.LCstrN` (verbatim)
        obj.symbols.push(ElfSym {
            name_offset: strx,
            section:     rodata_sec,
            value:       pool_off,
            size:        0,
            bind:        0,    // STB_LOCAL
            type_:       0,    // STT_NOTYPE
        })
        obj.nlocal = obj.nlocal + 1
        r = r + 1
    }

    // Pass 0b — build `.data` module-global pool: one 16-byte zero
    // HexaVal slot per `lm.globals` entry (symbol name `g<id>`), each a
    // LOCAL def. Mirrors macho `__data`.
    let mut g = 0
    let ng = len(lm.globals)
    while g < ng {
        let pool_off = len(obj.data)
        let mut z = 0
        while z < 16 { obj.data.push(0); z = z + 1 }
        let strx = _ew_str(obj.strtab, lm.globals[g])
        obj.symbols.push(ElfSym {
            name_offset: strx,
            section:     data_sec,
            value:       pool_off,
            size:        16,
            bind:        0,    // STB_LOCAL
            type_:       0,    // STT_NOTYPE (object data)
        })
        obj.nlocal = obj.nlocal + 1
        g = g + 1
    }

    let pending_offsets: [Int]    = []
    let pending_names:   [string] = []
    let page_offsets:    [Int]    = []
    let page_names:      [string] = []
    let page_kinds:      [Int]    = []

    // Pass 1 — walk funcs into text + collect one defined fn symbol each.
    let nf = len(lm.funcs)
    let mut i = 0
    while i < nf {
        let f = lm.funcs[i]
        let fn_start = len(obj.text)
        let strx = _ew_str(obj.strtab, f.name)        // BARE name (ELF)
        _pack_fn_arm64_elf(obj.text, pending_offsets, pending_names,
                           page_offsets, page_names, page_kinds, f)
        obj.symbols.push(ElfSym {
            name_offset: strx,
            section:     1,    // .text (1-based ELF section index)
            value:       fn_start,
            size:        len(obj.text) - fn_start,
            bind:        1,    // STB_GLOBAL
            type_:       2,    // STT_FUNC
        })
        i = i + 1
    }

    // Pass 2 — bubbled BL targets → R_AARCH64_CALL26 reloc records.
    // For each pending BL placeholder:
    //   1. Match the target against a defined fn symbol; if found AND
    //      defined (section != 0), pre-patch imm26 with the PC-rel delta
    //      so the .o is runnable even without `ld -r`.
    //   2. Otherwise append an undef extern symbol (section=SHN_UNDEF).
    //   3. Emit a CALL26 reloc at the BL word offset, addend 0
    //      (AArch64 CALL26 is `(S + A - P) >> 2`; A=0 reproduces the
    //      canonical `bl` displacement).
    // #3712 — name→symtab-index memo cache shared by the BL (CALL26) + page
    // (ADRP/ADD) reloc passes, EXACTLY mirroring elf_x86_64.hexa:1594-1700.
    // Deep functions emit thousands of bubbled placeholders; the raw
    // _find_elf_sym_by_name is an O(symbols) linear scan run once PER pending
    // reloc → O(relocs·symbols). A name resolves DETERMINISTICALLY (a defined
    // sym is stable; an undef pushed once is found at the same index forever
    // after), so memoizing the first resolution per distinct name is
    // byte-IDENTICAL. Memoize on a MISS only — pushing on hits too would
    // re-grow the cache to O(N); -1 is never stored (the push-undef fallback
    // always resolves to a real index first). Distinct names are few (~tens),
    // so the cache scan is ~O(distinct) ≪ O(symbols).
    let mut _symc_names: [string] = []
    let mut _symc_idx:   [Int]    = []
    let np = len(pending_offsets)
    let mut pi = 0
    while pi < np {
        let bl_off = pending_offsets[pi]
        let name   = pending_names[pi]
        // Cached resolution first; fall back to the symtab scan on a miss.
        let mut idx = _symc_lookup(_symc_names, _symc_idx, name)
        let was_cached = idx >= 0
        if idx < 0 {
            idx = _find_elf_sym_by_name(obj.symbols, obj.strtab, name)
        }
        if idx < 0 {
            let strx = _ew_str(obj.strtab, name)
            obj.symbols.push(ElfSym {
                name_offset: strx,
                section:     0,    // SHN_UNDEF
                value:       0,
                size:        0,
                bind:        1,    // STB_GLOBAL
                type_:       0,    // STT_NOTYPE
            })
            idx = len(obj.symbols) - 1
        }
        // Memoize on a MISS only (one entry per distinct name).
        if !was_cached {
            _symc_names.push(name)
            _symc_idx.push(idx)
        }
        obj.relocs.push(ElfRel {
            offset:  bl_off,
            sym_idx: idx,
            kind:    ELF_R_AARCH64_CALL26,
            addend:  0,
            site_seg: 1,
        })
        // Intra-module pre-patch when the target is defined here.
        let sym = obj.symbols[idx]
        if sym.section != 0 {
            let delta = (sym.value - bl_off) / 4
            let w0 = obj.text[bl_off + 0]
            let w1 = obj.text[bl_off + 1]
            let w2 = obj.text[bl_off + 2]
            let w3 = obj.text[bl_off + 3]
            let cur = w0 | (w1 << 8) | (w2 << 16) | (w3 << 24)
            let patched = (cur & 0xfc000000) | (delta & 0x03ffffff)
            _patch_word_le(obj.text, bl_off, patched)
        }
        pi = pi + 1
    }

    // Pass 3 — ADRP/ADD page-relative refs → ADR_PREL_PG_HI21 /
    // ADD_ABS_LO12_NC reloc records. Each resolves against a defined
    // symbol (the `.LCstrN` literals + `g<id>` globals built in Pass 0).
    // The encoder already emitted the bare base word (imm=0); the linker
    // fills the page / page-offset bits. Addend 0 (S+A with A=0): the
    // symbol value is the pool offset, and the symbol's section gives the
    // final address — exactly the `(S+A)` the reloc resolves.
    let npg = len(page_offsets)
    let mut gi2 = 0
    while gi2 < npg {
        let pg_off = page_offsets[gi2]
        let name   = page_names[gi2]
        let kind   = page_kinds[gi2]
        // Same #3712 memo cache as the BL pass (shared across both passes).
        let mut idx = _symc_lookup(_symc_names, _symc_idx, name)
        let was_cached = idx >= 0
        if idx < 0 {
            idx = _find_elf_sym_by_name(obj.symbols, obj.strtab, name)
        }
        if idx < 0 {
            // Unknown page target (no `.LCstrN`/`g<id>` def) → undef
            // extern. Keeps the .o well-formed; the linker resolves it.
            let strx = _ew_str(obj.strtab, name)
            obj.symbols.push(ElfSym {
                name_offset: strx,
                section:     0,    // SHN_UNDEF
                value:       0,
                size:        0,
                bind:        1,    // STB_GLOBAL
                type_:       0,    // STT_NOTYPE
            })
            idx = len(obj.symbols) - 1
        }
        if !was_cached {
            _symc_names.push(name)
            _symc_idx.push(idx)
        }
        obj.relocs.push(ElfRel {
            offset:  pg_off,
            sym_idx: idx,
            kind:    kind,
            addend:  0,
            site_seg: 1,
        })
        gi2 = gi2 + 1
    }
    return obj
}

// ─────────────────────────────────────────────────────────────────
// axis-③ arm64 own-link — serialize_elf_exec_arm64 (static ET_EXEC)
// ─────────────────────────────────────────────────────────────
// AArch64 sibling of serialize_elf_exec_x86_64 (elf_x86_64.hexa). Emits a
// STATIC AArch64 ELF ET_EXEC: ELF64 header + a single R+X PT_LOAD carrying the
// linked .text at vaddr 0x400000, NO program interpreter / dynamic section /
// section headers — the kernel enters at e_entry directly. Two deltas vs the
// x86 twin: e_machine = ELF_EM_AARCH64 (0xb7, not 0x3e), and p_align = 0x10000
// (64KB — the max-safe aarch64 page size; 0x1000 can be unloadable on 64KB-page
// kernels). Design + verify: state/hexa-own/axis3_arm64_ownlink_campaign.md.
pub fn serialize_elf_exec_arm64(text: [Int]) -> [Int] {
    let out: [Int] = []
    let text_size = len(text)

    let elf_header_size = 64
    let phdr_size = 56
    let phnum = 1
    let code_off = elf_header_size + phdr_size * phnum     // 120
    let vaddr_base = 0x400000
    let entry_vaddr = vaddr_base + code_off
    let file_size = code_off + text_size

    out.push(ELF_EI_MAG0); out.push(ELF_EI_MAG1)
    out.push(ELF_EI_MAG2); out.push(ELF_EI_MAG3)
    out.push(ELF_ELFCLASS64)
    out.push(ELF_ELFDATA2LSB)
    out.push(ELF_EV_CURRENT)
    out.push(ELF_ELFOSABI_NONE)
    _ew_zero(out, 8)
    _ew_u16(out, ELF_ET_EXEC)
    _ew_u16(out, ELF_EM_AARCH64)            // ← the AArch64 delta (was ELF_EM_X86_64)
    _ew_u32(out, ELF_EV_CURRENT)
    _ew_u64(out, entry_vaddr)
    _ew_u64(out, elf_header_size)           // e_phoff
    _ew_u64(out, 0)                         // e_shoff
    _ew_u32(out, 0)                         // e_flags
    _ew_u16(out, elf_header_size)
    _ew_u16(out, phdr_size)
    _ew_u16(out, phnum)
    _ew_u16(out, 0)                         // e_shentsize
    _ew_u16(out, 0)                         // e_shnum
    _ew_u16(out, 0)                         // e_shstrndx

    // PT_LOAD (R+X)
    _ew_u32(out, 1)                         // p_type = PT_LOAD
    _ew_u32(out, 5)                         // p_flags = PF_R | PF_X
    _ew_u64(out, 0)                         // p_offset
    _ew_u64(out, vaddr_base)                // p_vaddr
    _ew_u64(out, vaddr_base)                // p_paddr
    _ew_u64(out, file_size)                 // p_filesz
    _ew_u64(out, file_size)                 // p_memsz
    _ew_u64(out, 0x10000)                   // p_align (64KB-page-safe · x86 uses 0x1000)

    let mut i = 0
    while i < text_size { out.push(text[i] & 0xff); i = i + 1 }

    return out
}

// ─────────────────────────────────────────────────────────────────
// axis-③ arm64 own-link — link_elf_arm64_ownstart (RUNG-1, exit-code-only)
// ─────────────────────────────────────────────────────────────
// AArch64 sibling of link_elf_x86_64_ownstart (elf_x86_64.hexa). Prepends a
// 24-byte own `_start` stub so the ET_EXEC needs NO crt1.o / -lc / dynamic
// linker: the kernel enters at _start, which unpacks argc/argv from the stack,
// calls `main`, forwards main's HexaVal PAYLOAD (x1 of the AAPCS64 x0=tag/x1=
// payload return pair) into x0 and issues `exit(payload)` directly.
//
// _start (24 bytes · aiden aarch64-linux-gnu-as verified):
//   f94003e0  ldr  x0, [sp]      ; argc (aarch64 entry: argc at [sp], NOT x0)
//   910023e1  add  x1, sp, #8    ; argv
//   94000000  bl   main          ; CALL26 patched here (imm26 = (main-here)>>2)
//   aa0103e0  mov  x0, x1        ; exit code = main's HexaVal payload (x1)
//   d2800ba8  movz x8, #93       ; __NR_exit (aarch64 = 93, NOT x86 60)
//   d4000001  svc  #0            ; trap (x8=NR, svc #0)
//
// RUNG-1 SCOPE: single trivial program object, NO runtime.a, NO data segment,
// NO cross-object/extern relocation application (that is rung-2). The .o's
// intra-fn imm26/imm19 are already pre-resolved at pack time (pack_lir_arm64_elf),
// so a truly trivial `fn main()->Int{return 42}` carries ZERO obj relocs; the
// ONLY reloc this rung applies is the stub's own `bl main` CALL26. If any obj
// carries relocs (cross-fn/extern → needs the rung-2 applicator + likely a
// runtime.a member), refuse LOUDLY rather than emit a silently-miscompiled exec.
// Design + rungs 2-7: state/hexa-own/axis3_arm64_ownlink_campaign.md.
pub fn link_elf_arm64_ownstart(objs: [ElfArm64Obj], out_path: string, main_name: string, runtime_defs: [string]) -> Int {
    // 24-byte _start stub (bl main's imm26 patched below; bl at byte offset 8).
    let mut text: [Int] = []
    text.push(0xe0); text.push(0x03); text.push(0x40); text.push(0xf9)   // ldr x0,[sp]
    text.push(0xe1); text.push(0x23); text.push(0x00); text.push(0x91)   // add x1,sp,#8
    text.push(0x00); text.push(0x00); text.push(0x00); text.push(0x94)   // bl main (CALL26)
    text.push(0xe0); text.push(0x03); text.push(0x01); text.push(0xaa)   // mov x0,x1
    text.push(0xa8); text.push(0x0b); text.push(0x80); text.push(0xd2)   // movz x8,#93
    text.push(0x01); text.push(0x00); text.push(0x00); text.push(0xd4)   // svc #0
    let bl_off = 8                     // stub's `bl main` byte offset

    // Concatenate each obj's .text after the stub; locate `main`; refuse on any
    // obj reloc (rung-2 applies those). No runtime.a / data for rung-1.
    let mut main_off = -1
    let mut oi = 0
    while oi < len(objs) {
        let obj = objs[oi]
        if len(obj.relocs) > 0 {
            eprintln("hexa_ld(arm64,ownstart): rung-1 supports only reloc-free trivial programs; obj carries " + to_string(len(obj.relocs)) + " unresolved reloc(s) (cross-fn/extern/data need the rung-2 applicator + runtime.a) — refusing (no silent miscompile)")
            return 3
        }
        let base = len(text)
        let mut si = 0
        while si < len(obj.symbols) {
            let s = obj.symbols[si]
            if s.section != 0 {
                let mut nm = ""
                let mut k = 0
                while true {
                    let b = obj.strtab[s.name_offset + k] & 0xff
                    if b == 0 { break }
                    nm = nm + from_char_code(b)
                    k = k + 1
                }
                if nm == main_name { main_off = base + s.value }
            }
            si = si + 1
        }
        let mut ti = 0
        while ti < len(obj.text) { text.push(obj.text[ti] & 0xff); ti = ti + 1 }
        oi = oi + 1
    }
    if main_off < 0 {
        eprintln("hexa_ld(arm64,ownstart): entry symbol '" + main_name + "' not found (no defined .text symbol)")
        return 3
    }

    // Patch the stub's `bl main` CALL26: imm26 = (S - P) >> 2 into bits[25:0];
    // opcode 100101b (0x94000000) in bits[31:26]. Range ±128MB (fine intra-image).
    let delta = main_off - bl_off
    let imm26 = (delta >> 2) & 0x3ffffff
    let bl_word = 0x94000000 | imm26
    text[bl_off + 0] = bl_word & 0xff
    text[bl_off + 1] = (bl_word >> 8) & 0xff
    text[bl_off + 2] = (bl_word >> 16) & 0xff
    text[bl_off + 3] = (bl_word >> 24) & 0xff

    write_bytes(out_path, serialize_elf_exec_arm64(text))
    return 0
}

// ─────────────────────────────────────────────────────────────────
// axis-③ arm64 own-link rung-2 (S3) — parse_elf_arm64_obj
// ─────────────────────────────────────────────────────────────
// AArch64 twin of parse_elf_x86_obj (elf_x86_64.hexa:3826): an ELF64 ET_REL
// AArch64 .o (or ar member at [base,base+limit)) → ElfArm64Obj (text/rodata/
// data pools + rebased symbols + rebased relocs). Deltas vs the x86 twin:
// (1) e_machine guard 0x3e→0xb7 (ELF_EM_AARCH64); (2) ElfArm64Obj has 8 fields
// (no init_array / no *_align) so the SHT_INIT_ARRAY slot-6 arm + the
// obj.*_align field updates are dropped — the pool-internal salign PADDING is
// KEPT so a .rodata.cst16 SIMD constant stays 16-aligned (Q6). Reuses this
// program's shared _er_*/_ew_str helpers + ELF_SHT_*/ELF_SHF_*/ELF_STB_LOCAL.
pub fn parse_elf_arm64_obj(buf, base: Int, limit: Int, member_idx: Int) -> ElfArm64Obj {
    let mut obj = ElfArm64Obj {
        text: [], relocs: [], symbols: [], strtab: [],
        rodata: [], data: [], bss_size: 0, nlocal: 0,
    }
    obj.strtab.push(0)                       // ELF strtab idx 0 = ""

    // ── Guards: ELF magic + ET_REL + EM_AARCH64 ──
    if _er_u8(buf, base + 0) != 0x7f { return obj }
    if _er_u8(buf, base + 1) != 0x45 { return obj }   // 'E'
    if _er_u8(buf, base + 2) != 0x4c { return obj }   // 'L'
    if _er_u8(buf, base + 3) != 0x46 { return obj }   // 'F'
    if _er_u8(buf, base + 4) != 2    { return obj }   // ELFCLASS64
    if _er_u8(buf, base + 5) != 1    { return obj }   // ELFDATA2LSB
    if _er_u16le(buf, base + 0x10) != ELF_ET_REL     { return obj }
    let _em = _er_u16le(buf, base + 0x12)
    if _em != ELF_EM_AARCH64 {   // ← the AArch64 delta
        // Name a wrong-arch member instead of a silent parse-empty (which strands
        // its defs → downstream undef). A contaminated cross runtime.a with an
        // EM_X86_64(0x3e) member is the class this catches. Opt-in own-link only.
        eprintln("hexa_ld(arm64): archive member " + to_string(member_idx) + " e_machine=" + to_string(_em) + " != EM_AARCH64(0xb7) — skipped (wrong-arch runtime.a?)")
        return obj
    }

    let e_shoff     = _er_u64le(buf, base + 0x28)
    let e_shentsize = _er_u16le(buf, base + 0x3A)
    let e_shnum     = _er_u16le(buf, base + 0x3C)
    let e_shstrndx  = _er_u16le(buf, base + 0x3E)
    if e_shentsize < 64 { return obj }
    if e_shnum < 1 { return obj }
    if e_shstrndx > e_shnum - 1 { return obj }

    // ── Pass A: section headers → per-index slot + concat-pool base. ──
    let sec_slot: [Int] = []      // 0 none, 1 text, 3 rodata, 4 data, 5 bss
    let sec_base: [Int] = []
    let sec_off:  [Int] = []
    let sec_size: [Int] = []
    let sec_type: [Int] = []
    let sec_link: [Int] = []
    let sec_info: [Int] = []
    let sec_ent:  [Int] = []

    let mut i = 0
    while i < e_shnum {
        let sh    = base + e_shoff + i * e_shentsize
        let stype = _er_u32le(buf, sh + 0x04)
        let flags = _er_u64le(buf, sh + 0x08)
        let soff  = _er_u64le(buf, sh + 0x18)
        let ssize = _er_u64le(buf, sh + 0x20)
        let slink = _er_u32le(buf, sh + 0x28)
        let sinfo = _er_u32le(buf, sh + 0x2C)
        let sent  = _er_u64le(buf, sh + 0x38)
        let salign0 = _er_u64le(buf, sh + 0x30)
        let salign  = if salign0 < 1 { 1 } else if salign0 > 4096 { 4096 } else { salign0 }

        let mut slot  = 0
        let mut pbase = 0
        if stype == ELF_SHT_PROGBITS && (flags & ELF_SHF_ALLOC) != 0 {
            if (flags & ELF_SHF_EXECINSTR) != 0 {
                slot = 1
                pbase = len(obj.text)
                let mut k = 0
                while k < ssize { obj.text.push(_er_u8(buf, base + soff + k)); k = k + 1 }
            } else if (flags & ELF_SHF_WRITE) != 0 {
                slot = 4
                while (len(obj.data) % salign) != 0 { obj.data.push(0) }
                pbase = len(obj.data)
                let mut k = 0
                while k < ssize { obj.data.push(_er_u8(buf, base + soff + k)); k = k + 1 }
            } else {
                slot = 3
                while (len(obj.rodata) % salign) != 0 { obj.rodata.push(0) }
                pbase = len(obj.rodata)
                let mut k = 0
                while k < ssize { obj.rodata.push(_er_u8(buf, base + soff + k)); k = k + 1 }
            }
        } else if stype == ELF_SHT_NOBITS && (flags & ELF_SHF_ALLOC) != 0 {
            slot = 5
            obj.bss_size = obj.bss_size + ((salign - (obj.bss_size % salign)) % salign)
            pbase = obj.bss_size
            obj.bss_size = obj.bss_size + ssize
        }
        // NOTE: no SHT_INIT_ARRAY slot-6 arm (ElfArm64Obj has no init_array) — an
        // exit-42 program has no ctors; a pulled member's .init_array is dropped
        // here (Q6 census: assert none needed before a ctor-bearing program).
        sec_slot.push(slot)
        sec_base.push(pbase)
        sec_off.push(base + soff)
        sec_size.push(ssize)
        sec_type.push(stype)
        sec_link.push(slink)
        sec_info.push(sinfo)
        sec_ent.push(sent)
        i = i + 1
    }

    // ── Locate .symtab (+ its .strtab via sh_link). ──
    let mut symtab_idx = -1
    let mut j = 0
    while j < e_shnum {
        if sec_type[j] == ELF_SHT_SYMTAB { symtab_idx = j; break }
        j = j + 1
    }
    if symtab_idx < 0 { return obj }
    let sym_off  = sec_off[symtab_idx]
    let sym_size = sec_size[symtab_idx]
    let mut sym_es = sec_ent[symtab_idx]
    if sym_es < 1 { sym_es = 24 }
    let str_sec = sec_link[symtab_idx]
    if str_sec < 0 { return obj }
    if str_sec > e_shnum - 1 { return obj }
    let str_off = sec_off[str_sec]

    // ── Pass B: symbols (skip file idx 0). obj.symbols[S-1] ← r_info sym S. ──
    let count = sym_size / sym_es
    let mut si = 1
    while si < count {
        let s = sym_off + si * sym_es
        let st_name  = _er_u32le(buf, s + 0x00)
        let st_info  = _er_u8(buf, s + 0x04)
        let st_shndx = _er_u16le(buf, s + 0x06)
        let st_value = _er_u64le(buf, s + 0x08)
        let st_size  = _er_u64le(buf, s + 0x10)
        let bind  = (st_info >> 4) & 0xf
        let type_ = st_info & 0xf

        let mut nsec = 0
        let mut nval = 0
        if st_shndx == 0 {
            nsec = 0; nval = 0                         // SHN_UNDEF
        } else if st_shndx == 0xfff1 {
            nsec = 0; nval = 0                         // SHN_ABS
        } else if st_shndx == 0xfff2 {
            let mut al = st_value                      // SHN_COMMON
            if al < 1 { al = 1 }
            let cur = obj.bss_size
            let rem = cur - (cur / al) * al
            let aligned = if rem == 0 { cur } else { cur + (al - rem) }
            nsec = 5
            nval = aligned
            obj.bss_size = aligned + st_size
        } else if st_shndx < e_shnum {
            nsec = sec_slot[st_shndx]
            nval = st_value + sec_base[st_shndx]       // rebase into pool
        } else {
            nsec = 0; nval = 0
        }

        let mut nm_off = 0
        if type_ == 3 {                               // STT_SECTION → unique synth name
            let sname = "$sec_" + to_string(member_idx) + "_" + to_string(st_shndx)
            nm_off = _ew_str(obj.strtab, sname)
        } else {
            nm_off = _ew_str(obj.strtab, _er_cstr(buf, str_off + st_name))
        }

        obj.symbols.push(ElfSym {
            name_offset: nm_off,
            section:     nsec,
            value:       nval,
            size:        st_size,
            bind:        bind,
            type_:       type_,
        })
        if bind == ELF_STB_LOCAL { obj.nlocal = obj.nlocal + 1 }
        si = si + 1
    }

    // ── Pass C: SHT_RELA sections. r_offset rebased into target pool; sym→ -1. ──
    let mut ci = 0
    while ci < e_shnum {
        if sec_type[ci] == ELF_SHT_RELA {
            let roff = sec_off[ci]
            let rsz  = sec_size[ci]
            let mut res = sec_ent[ci]
            if res < 24 { res = 24 }
            let tgt = sec_info[ci]
            let mut tgt_base = 0
            if tgt < e_shnum { tgt_base = sec_base[tgt] }
            let mut site_ok = true
            if tgt < e_shnum { if sec_slot[tgt] == 0 { site_ok = false } }
            let rcount = rsz / res
            let mut ri = 0
            while ri < rcount {
                let r     = roff + ri * res
                let r_off = _er_u64le(buf, r + 0x00)
                let rinfo = _er_u64le(buf, r + 0x08)
                let radd  = _er_s64le(buf, r + 0x10)
                let div   = 0x100000000
                let sym_file = rinfo / div
                let rtype    = rinfo - (rinfo / div) * div
                if sym_file > 0 && site_ok {
                    obj.relocs.push(ElfRel {
                        offset:  r_off + tgt_base,
                        sym_idx: sym_file - 1,
                        kind:    rtype,
                        addend:  radd,
                        site_seg: (if tgt < e_shnum { sec_slot[tgt] } else { 1 }),
                    })
                }
                ri = ri + 1
            }
        }
        ci = ci + 1
    }

    return obj
}

// ── axis-③ arm64 own-link rung-2 (S3) — archive extraction ──────────
// _aef_symname_arm64 = ElfArm64Obj twin of _aef_symname (elf_x86_64.hexa:4243);
// _aef_has (string-list membership) is target-agnostic → REUSED verbatim.
fn _aef_symname_arm64(obj: ElfArm64Obj, off: Int) -> string {
    let mut s = ""
    let n = len(obj.strtab)
    let mut k = 0
    while off + k < n {
        let b = obj.strtab[off + k] & 0xff
        if b == 0 { break }
        s = s + from_char_code(b)
        k = k + 1
    }
    return s
}

// archive_extract_fixpoint_arm64 — AArch64 twin of archive_extract_fixpoint
// (elf_x86_64.hexa:4297). Iteratively pulls ONLY the runtime.arm64.a members
// that satisfy still-undefined program symbols (+ the #4871 STB_LOCAL hxlcl_
// floor-pull, which keys on symbol names only → carries verbatim). Deltas:
// ElfX86Obj→ElfArm64Obj, parse_elf_x86_obj→parse_elf_arm64_obj, _aef_symname→
// _aef_symname_arm64. Reached solely via the arm64 own-link (opt-in) → runtime.a
// visibility on the shipping path is untouched (byteeq-neutral).
pub fn archive_extract_fixpoint_arm64(program_objs: [ElfArm64Obj], buf, members: [ArMember]) -> [ElfArm64Obj] {
    let extracted: [ElfArm64Obj] = []

    let parsed: [ElfArm64Obj] = []
    let mut pulled: [bool] = []
    let mut m = 0
    while m < len(members) {
        let mem = members[m]
        parsed.push(parse_elf_arm64_obj(buf, mem.data_off, mem.size, m))
        pulled.push(false)
        m = m + 1
    }

    let def_names: [string] = []
    let und_names: [string] = []
    let mut pi = 0
    while pi < len(program_objs) {
        let po = program_objs[pi]
        let mut sj = 0
        while sj < len(po.symbols) {
            let s = po.symbols[sj]
            if s.section != 0 && (s.bind == ELF_STB_GLOBAL || s.bind == ELF_STB_WEAK) {
                let nm = _aef_symname_arm64(po, s.name_offset)
                if len(nm) > 0 && !_aef_has(def_names, nm) { def_names.push(nm) }
            }
            sj = sj + 1
        }
        pi = pi + 1
    }
    pi = 0
    while pi < len(program_objs) {
        let po = program_objs[pi]
        let mut sj = 0
        while sj < len(po.symbols) {
            let s = po.symbols[sj]
            if s.section == 0 {
                let nm = _aef_symname_arm64(po, s.name_offset)
                if len(nm) > 0 && !_aef_has(und_names, nm) { und_names.push(nm) }
            }
            sj = sj + 1
        }
        pi = pi + 1
    }

    let mut changed = true
    while changed {
        changed = false
        let mut mi = 0
        while mi < len(members) {
            if !pulled[mi] {
                let obj = parsed[mi]
                let mut wants = false
                let mut k = 0
                while k < len(obj.symbols) {
                    let s = obj.symbols[k]
                    if s.section != 0 && (s.bind == ELF_STB_GLOBAL || s.bind == ELF_STB_WEAK) {
                        let nm = _aef_symname_arm64(obj, s.name_offset)
                        if _aef_has(und_names, nm) && !_aef_has(def_names, nm) {
                            wants = true
                            break
                        }
                    }
                    k = k + 1
                }
                // #4871 STB_LOCAL hxlcl_ floor-pull (carries verbatim).
                if !wants {
                    let mut ui = 0
                    while ui < len(und_names) && !wants {
                        let bx = und_names[ui]
                        if !_aef_has(def_names, bx) {
                            let owx = "hxlcl_" + bx
                            let mut kk = 0
                            while kk < len(obj.symbols) {
                                let s2 = obj.symbols[kk]
                                if s2.section != 0 && _aef_symname_arm64(obj, s2.name_offset) == owx {
                                    wants = true
                                    break
                                }
                                kk = kk + 1
                            }
                        }
                        ui = ui + 1
                    }
                }
                if wants {
                    pulled[mi] = true
                    changed = true
                    let mut d = 0
                    while d < len(obj.symbols) {
                        let s = obj.symbols[d]
                        if s.section != 0 && (s.bind == ELF_STB_GLOBAL || s.bind == ELF_STB_WEAK) {
                            let nm = _aef_symname_arm64(obj, s.name_offset)
                            if len(nm) > 0 && !_aef_has(def_names, nm) { def_names.push(nm) }
                        }
                        d = d + 1
                    }
                    let mut fd = 0
                    while fd < len(und_names) {
                        let bx = und_names[fd]
                        if !_aef_has(def_names, bx) {
                            let owx = "hxlcl_" + bx
                            let mut fk = 0
                            while fk < len(obj.symbols) {
                                let sf = obj.symbols[fk]
                                if sf.section != 0 && _aef_symname_arm64(obj, sf.name_offset) == owx {
                                    def_names.push(bx)
                                    break
                                }
                                fk = fk + 1
                            }
                        }
                        fd = fd + 1
                    }
                    let mut u = 0
                    while u < len(obj.symbols) {
                        let s = obj.symbols[u]
                        if s.section == 0 {
                            let nm = _aef_symname_arm64(obj, s.name_offset)
                            if len(nm) > 0 && !_aef_has(und_names, nm) { und_names.push(nm) }
                        }
                        u = u + 1
                    }
                    extracted.push(obj)
                }
            }
            mi = mi + 1
        }
    }

    return extracted
}

// ─────────────────────────────────────────────────────────────────
// axis-③ arm64 own-link rung-2 (S4) — reloc applicator (final vaddr)
// ─────────────────────────────────────────────────────────────
// Patch the 12 R_AARCH64 types the cross-gcc runtime.arm64.a emits, into a
// segment buffer at final vaddr. Bit-masks are VERBATIM from the proven Mach-O
// arm64 patcher (tool/hexa_ld.hexa:1601-1636/1730-1746) + the CALL26 stub
// (elf_arm64.hexa CALL26 patch). Q4 GUARD: hexa `>>` sign-behavior is unproven,
// so page/branch deltas use integer DIVIDE (/0x1000, /4) — both operands are
// aligned so the quotient is exact + correctly signed for negative (below-PC)
// deltas; the imm masks then extract the low bits in two's complement.
fn _aa_page(x: Int) -> Int { return x & (0 - 0x1000) }        // clears low 12 bits (~0xfff)
fn _aa_u32(buf: [Int], o: Int) -> Int {
    return (buf[o] & 0xff) | ((buf[o+1] & 0xff) << 8) | ((buf[o+2] & 0xff) << 16) | ((buf[o+3] & 0xff) << 24)
}
fn _aa_put32(buf: [Int], o: Int, w: Int) {
    buf[o+0] = w & 0xff; buf[o+1] = (w >> 8) & 0xff; buf[o+2] = (w >> 16) & 0xff; buf[o+3] = (w >> 24) & 0xff
}
fn _aa_put64(buf: [Int], o: Int, v: Int) {
    let mut i = 0
    while i < 8 { buf[o+i] = (v >> (8*i)) & 0xff; i = i + 1 }
}
fn _aa_ldst_scale(kind: Int) -> Int {
    if kind == ELF_R_AARCH64_LDST8_ABS_LO12_NC  { return 0 }
    if kind == ELF_R_AARCH64_LDST16_ABS_LO12_NC { return 1 }
    if kind == ELF_R_AARCH64_LDST32_ABS_LO12_NC { return 2 }
    if kind == ELF_R_AARCH64_LDST64_ABS_LO12_NC { return 3 }
    return 4                                                   // LDST128
}

// Patch ONE reloc into segment buffer `buf` at byte `off`. P = site vaddr,
// S = symbol vaddr, A = addend, G = symbol's GOT-slot vaddr (S5). Returns
// 0 ok · 1 unhandled(refuse) · 2 range/align overflow(refuse) — never silently
// truncates (a gap surfaces as rc, not a miscompile).
fn _apply_arm64_reloc(buf: [Int], off: Int, kind: Int, S: Int, A: Int, P: Int, G: Int) -> Int {
    if kind == ELF_R_AARCH64_ABS64  { _aa_put64(buf, off, S + A); return 0 }
    if kind == ELF_R_AARCH64_PREL32 {
        let v = S + A - P
        if v < (0 - 0x80000000) || v >= 0x100000000 { return 2 }
        _aa_put32(buf, off, v & 0xffffffff); return 0
    }
    let cur = _aa_u32(buf, off)
    if kind == ELF_R_AARCH64_ADR_PREL_PG_HI21 || kind == ELF_R_AARCH64_ADR_GOT_PAGE {
        let base = if kind == ELF_R_AARCH64_ADR_GOT_PAGE { G } else { S }
        let d   = _aa_page(base + A) - _aa_page(P)
        let imm = d / 0x1000                                  // DIVIDE (Q4-safe)
        if imm < (0 - 0x100000) || imm > 0xfffff { return 2 }
        let immlo = imm & 0x3
        let immhi = (imm / 4) & 0x7ffff                       // (imm>>2) via DIVIDE
        _aa_put32(buf, off, (cur & 0x9f00001f) | (immlo << 29) | (immhi << 5)); return 0
    }
    if kind == ELF_R_AARCH64_ADD_ABS_LO12_NC {
        let imm12 = (S + A) & 0xfff
        _aa_put32(buf, off, (cur & 0xffc003ff) | ((imm12 & 0xfff) << 10)); return 0
    }
    if kind == ELF_R_AARCH64_LD64_GOT_LO12_NC {
        let imm12 = ((G + A) & 0xfff) / 8                     // 8-byte load, scale 3
        _aa_put32(buf, off, (cur & 0xffc003ff) | ((imm12 & 0xfff) << 10)); return 0
    }
    if kind == ELF_R_AARCH64_LDST8_ABS_LO12_NC || kind == ELF_R_AARCH64_LDST16_ABS_LO12_NC
       || kind == ELF_R_AARCH64_LDST32_ABS_LO12_NC || kind == ELF_R_AARCH64_LDST64_ABS_LO12_NC
       || kind == ELF_R_AARCH64_LDST128_ABS_LO12_NC {
        let scale = _aa_ldst_scale(kind)
        let raw   = (S + A) & 0xfff
        if (raw & ((1 << scale) - 1)) != 0 { return 2 }       // misaligned → refuse (no truncation)
        let imm12 = raw / (1 << scale)                        // raw >> scale via DIVIDE
        _aa_put32(buf, off, (cur & 0xffc003ff) | ((imm12 & 0xfff) << 10)); return 0
    }
    if kind == ELF_R_AARCH64_CALL26 || kind == ELF_R_AARCH64_JUMP26 {
        let bd = S + A - P                                    // byte delta
        if bd < (0 - 0x8000000) || bd >= 0x8000000 { return 2 }   // ±128MB
        if (bd & 0x3) != 0 { return 2 }                       // 4-byte aligned
        let imm26 = (bd / 4) & 0x3ffffff                      // (bd>>2) via DIVIDE
        _aa_put32(buf, off, (cur & 0xfc000000) | imm26); return 0
    }
    return 1                                                  // unhandled type → refuse
}

// ─────────────────────────────────────────────────────────────────
// axis-③ arm64 own-link rung-2 (S6a) — serialize_elf_exec_arm64_2seg
// ─────────────────────────────────────────────────────────────
// AArch64 twin of serialize_elf_exec_x86_64_2seg (elf_x86_64.hexa:3579): a static
// AArch64 ET_EXEC with TWO PT_LOADs — seg0 (R+X) ELF header+2 phdrs+.text @
// 0x400000, seg1 (R+W) .rodata++.data(++GOT) (+ .bss in p_memsz) at a page-aligned
// vaddr above text. Deltas vs the x86 twin: e_machine 0x3e→0xb7, and p_align +
// the data file-offset alignment use 0x10000 (64KB-page-safe) so p_vaddr≡p_offset
// mod p_align holds on 64KB-page aarch64 kernels.
pub fn serialize_elf_exec_arm64_2seg(text: [Int], data: [Int], bss_size: Int) -> [Int] {
    let out: [Int] = []
    let text_size = len(text)
    let data_size = len(data)

    let elf_header_size = 64
    let phdr_size = 56
    let phnum = 2
    let code_off = elf_header_size + phdr_size * phnum     // 176
    let vaddr_base = 0x400000
    let entry_vaddr = vaddr_base + code_off
    let text_end_file = code_off + text_size
    // Page-align (0x10000) the data segment file offset → vaddr congruence holds.
    let data_file_off = text_end_file + ((0x10000 - (text_end_file & 0xffff)) & 0xffff)
    let data_vaddr = vaddr_base + data_file_off
    let text_filesz = code_off + text_size
    let data_memsz  = data_size + bss_size

    out.push(ELF_EI_MAG0); out.push(ELF_EI_MAG1)
    out.push(ELF_EI_MAG2); out.push(ELF_EI_MAG3)
    out.push(ELF_ELFCLASS64)
    out.push(ELF_ELFDATA2LSB)
    out.push(ELF_EV_CURRENT)
    out.push(ELF_ELFOSABI_NONE)
    _ew_zero(out, 8)
    _ew_u16(out, ELF_ET_EXEC)
    _ew_u16(out, ELF_EM_AARCH64)            // ← AArch64 delta
    _ew_u32(out, ELF_EV_CURRENT)
    _ew_u64(out, entry_vaddr)
    _ew_u64(out, elf_header_size)           // e_phoff
    _ew_u64(out, 0)                         // e_shoff
    _ew_u32(out, 0)                         // e_flags
    _ew_u16(out, elf_header_size)
    _ew_u16(out, phdr_size)
    _ew_u16(out, phnum)
    _ew_u16(out, 0)                         // e_shentsize
    _ew_u16(out, 0)                         // e_shnum
    _ew_u16(out, 0)                         // e_shstrndx

    // PT_LOAD[0] — R+X text
    _ew_u32(out, 1)
    _ew_u32(out, 5)                         // PF_R | PF_X
    _ew_u64(out, 0)
    _ew_u64(out, vaddr_base)
    _ew_u64(out, vaddr_base)
    _ew_u64(out, text_filesz)
    _ew_u64(out, text_filesz)
    _ew_u64(out, 0x10000)                   // p_align (64KB)

    // PT_LOAD[1] — R+W rodata/data(/GOT) (+ .bss in memsz)
    _ew_u32(out, 1)
    _ew_u32(out, 6)                         // PF_R | PF_W
    _ew_u64(out, data_file_off)
    _ew_u64(out, data_vaddr)
    _ew_u64(out, data_vaddr)
    _ew_u64(out, data_size)
    _ew_u64(out, data_memsz)
    _ew_u64(out, 0x10000)

    let mut i = 0
    while i < text_size { out.push(text[i] & 0xff); i = i + 1 }
    _ew_zero(out, data_file_off - text_end_file)
    let mut d = 0
    while d < data_size { out.push(data[d] & 0xff); d = d + 1 }

    return out
}

// ─────────────────────────────────────────────────────────────────
// axis-③ arm64 own-link rung-3 (S6) — serialize_elf_exec_arm64_dyn
// ─────────────────────────────────────────────────────────────
// AArch64 twin of serialize_elf_exec_x86_64_dyn (elf_x86_64.hexa:3662): a
// dynamically-linked ET_EXEC with FOUR phdrs (PT_INTERP · PT_LOAD R-X · PT_LOAD
// RW · PT_DYNAMIC). The RW segment carries .rodata/.data/GOT + the appended
// dynstr/dynsym/DT_HASH/.rela.dyn/_DYNAMIC/interp blobs. ld.so maps /lib/ld-
// linux-aarch64.so.1, eager-binds the GLOB_DAT GOT slots against libc.so.6, and
// jumps to e_entry (crt1's _start). Deltas vs the x86 dyn twin: e_machine=AArch64
// + the 0x10000 (64KB-page) data alignment kept from the 2seg twin. entry_off =
// crt1 `_start`'s text offset; interp_off/dyn_off are blob offsets INTO `data`.
pub fn serialize_elf_exec_arm64_dyn(text: [Int], data: [Int], bss_size: Int, interp_off: Int, interp_len: Int, dyn_off: Int, dyn_sz: Int, entry_off: Int) -> [Int] {
    let out: [Int] = []
    let text_size = len(text)
    let data_size = len(data)

    let elf_header_size = 64
    let phdr_size = 56
    let phnum = 4
    let code_off = elf_header_size + phdr_size * phnum     // 288
    let vaddr_base = 0x400000
    let entry_vaddr = vaddr_base + code_off + entry_off
    let text_end_file = code_off + text_size
    let data_file_off = text_end_file + ((0x10000 - (text_end_file & 0xffff)) & 0xffff)
    let data_vaddr = vaddr_base + data_file_off
    let text_filesz = code_off + text_size
    let data_memsz  = data_size + bss_size

    out.push(ELF_EI_MAG0); out.push(ELF_EI_MAG1)
    out.push(ELF_EI_MAG2); out.push(ELF_EI_MAG3)
    out.push(ELF_ELFCLASS64)
    out.push(ELF_ELFDATA2LSB)
    out.push(ELF_EV_CURRENT)
    out.push(ELF_ELFOSABI_NONE)
    _ew_zero(out, 8)
    _ew_u16(out, ELF_ET_EXEC)
    _ew_u16(out, ELF_EM_AARCH64)            // ← AArch64 delta
    _ew_u32(out, ELF_EV_CURRENT)
    _ew_u64(out, entry_vaddr)
    _ew_u64(out, elf_header_size)           // e_phoff
    _ew_u64(out, 0)                         // e_shoff
    _ew_u32(out, 0)                         // e_flags
    _ew_u16(out, elf_header_size)
    _ew_u16(out, phdr_size)
    _ew_u16(out, phnum)
    _ew_u16(out, 0)                         // e_shentsize
    _ew_u16(out, 0)                         // e_shnum
    _ew_u16(out, 0)                         // e_shstrndx

    // PT_INTERP — kernel maps ld.so and jumps to it first
    _ew_u32(out, 3)                         // PT_INTERP
    _ew_u32(out, 4)                         // PF_R
    _ew_u64(out, data_file_off + interp_off)
    _ew_u64(out, data_vaddr + interp_off)
    _ew_u64(out, data_vaddr + interp_off)
    _ew_u64(out, interp_len)
    _ew_u64(out, interp_len)
    _ew_u64(out, 1)                         // p_align

    // PT_LOAD[0] — R-X text
    _ew_u32(out, 1)
    _ew_u32(out, 5)                         // PF_R | PF_X
    _ew_u64(out, 0)
    _ew_u64(out, vaddr_base)
    _ew_u64(out, vaddr_base)
    _ew_u64(out, text_filesz)
    _ew_u64(out, text_filesz)
    _ew_u64(out, 0x10000)                   // p_align (64KB)

    // PT_LOAD[1] — R+W rodata/data/GOT/dyn (+ .bss in memsz)
    _ew_u32(out, 1)
    _ew_u32(out, 6)                         // PF_R | PF_W
    _ew_u64(out, data_file_off)
    _ew_u64(out, data_vaddr)
    _ew_u64(out, data_vaddr)
    _ew_u64(out, data_size)
    _ew_u64(out, data_memsz)
    _ew_u64(out, 0x10000)

    // PT_DYNAMIC — ld.so reads the DT_* array
    _ew_u32(out, 2)                         // PT_DYNAMIC
    _ew_u32(out, 6)                         // PF_R | PF_W
    _ew_u64(out, data_file_off + dyn_off)
    _ew_u64(out, data_vaddr + dyn_off)
    _ew_u64(out, data_vaddr + dyn_off)
    _ew_u64(out, dyn_sz)
    _ew_u64(out, dyn_sz)
    _ew_u64(out, 8)                         // p_align

    let mut i = 0
    while i < text_size { out.push(text[i] & 0xff); i = i + 1 }
    _ew_zero(out, data_file_off - text_end_file)
    let mut d = 0
    while d < data_size { out.push(data[d] & 0xff); d = d + 1 }

    return out
}

// ─────────────────────────────────────────────────────────────────
// axis-③ arm64 own-link rung-2 (S5+S6b) — link_elf_arm64_ownstart_ar
// ─────────────────────────────────────────────────────────────
// The full AArch64 archive-aware own-link driver (twin of link_elf_x86_64_
// ownstart_ar + the core of link_elf_x86_64_ownstart, elf_x86_64.hexa:1849/3208):
// read runtime.arm64.a → extract the members that satisfy the program's UNDs →
// concat text/rodata/data + build a name→vaddr def-map → synthesize a static GOT
// (S5, for the 926 ADR_GOT_PAGE/LD64_GOT_LO12 relocs) → apply ALL relocs at final
// vaddr via _apply_arm64_reloc (S4) → serialize a 2-seg static ET_EXEC (S6a).
// Round-1 scope: pure own-start static (no crt1). Fail-loud (rc 3) on any undef
// or unhandled reloc — a gap surfaces, never a silent miscompile (S8 qemu verify).

// name → final vaddr via the def-map. seg 0=text, 1=data-blob, 2=bss. Returns
// -1 if undefined (caller refuses). bss lives above the data blob (incl GOT).
fn _aa_vaddr_of(name: string, dn: [string], ds: [Int], doff: [Int],
                text_vaddr: Int, data_vaddr: Int, bss_vaddr_base: Int) -> Int {
    let mut i = 0
    while i < len(dn) {
        if dn[i] == name {
            let seg = ds[i]
            if seg == 0 { return text_vaddr + doff[i] }
            if seg == 2 { return bss_vaddr_base + doff[i] }
            return data_vaddr + doff[i]                   // seg 1
        }
        i = i + 1
    }
    return -1
}

// ── axis-③ arm64 own-link rung-3 (S1) — Road A dynamic-link readers ─────────
// 1:1 arm64 twins of the x86 crt1 / libc.so.6 / residual-UND-census helpers
// (elf_x86_64.hexa:1644-1738, :1765-1829). Reuse the shared LibcDynsym struct +
// _libc_sym_type/_size + _ldx_hash + _elf_has_prefix + _aef_has + _er_* (defined
// in elf_x86_64.hexa, whole-program scope); only the ET_REL/ET_DYN parse + the
// e_machine guard + the multiarch paths + the GOT-kind predicate are arch-specific.

// Read the target sysroot's aarch64 crt1.o (glibc process-entry object) into the
// linker's ElfArm64Obj model. member_idx 777001 = unique sentinel so crt1's
// synthesized STT_SECTION names never collide with a runtime.a member. On aiden
// the cross crt1.o lives under /usr/aarch64-linux-gnu/lib; Debian multiarch uses
// /usr/lib/aarch64-linux-gnu. Missing/unreadable → empty obj; caller hard-errors.
fn _ld_read_crt1_arm64() -> ElfArm64Obj {
    let sysroot = env_var("HEXA_LD_SYSROOT")
    let mut crt_path = "/usr/lib/aarch64-linux-gnu/crt1.o"
    if len(sysroot) > 0 { crt_path = sysroot + "/crt1.o" }
    let mut cbuf = read_file_bytes(crt_path)
    if len(cbuf) == 0 { cbuf = read_file_bytes("/usr/lib/aarch64-linux-gnu/crt1.o") }
    if len(cbuf) == 0 { cbuf = read_file_bytes("/usr/aarch64-linux-gnu/lib/crt1.o") }
    return parse_elf_arm64_obj(cbuf, 0, len(cbuf), 777001)
}

// Read the target's shared aarch64 libc.so.6 and return its DEFINED .dynsym
// entries as a name -> (st_type, st_size) map (ok=1 on success). Mirror of
// _ld_read_libc_dynsym with the EM_AARCH64 guard + aarch64 multiarch paths. Used
// to fail-closed if any residual dyn UND is STT_OBJECT (the COPY lane is not
// ported in the rung-3 minimal cut — all 6 floor syms are STT_FUNC).
fn _ld_read_libc_dynsym_arm64() -> LibcDynsym {
    let mut out = LibcDynsym { names: [], types: [], sizes: [], ok: 0 }
    let sysroot = env_var("HEXA_LD_SYSROOT")
    let first_path = if len(sysroot) > 0 { sysroot + "/libc.so.6" } else { "/lib/aarch64-linux-gnu/libc.so.6" }
    let mut buf = read_file_bytes(first_path)
    if len(buf) == 0 { buf = read_file_bytes("/lib/aarch64-linux-gnu/libc.so.6") }
    if len(buf) == 0 { buf = read_file_bytes("/usr/lib/aarch64-linux-gnu/libc.so.6") }
    if len(buf) == 0 { buf = read_file_bytes("/usr/aarch64-linux-gnu/lib/libc.so.6") }
    if len(buf) == 0 { return out }

    if _er_u8(buf, 0) != 0x7f { return out }
    if _er_u8(buf, 1) != 0x45 { return out }
    if _er_u8(buf, 2) != 0x4c { return out }
    if _er_u8(buf, 3) != 0x46 { return out }
    if _er_u8(buf, 4) != 2    { return out }
    if _er_u8(buf, 5) != 1    { return out }
    if _er_u16le(buf, 0x10) != ELF_ET_DYN     { return out }
    if _er_u16le(buf, 0x12) != ELF_EM_AARCH64 { return out }

    let e_shoff     = _er_u64le(buf, 0x28)
    let e_shentsize = _er_u16le(buf, 0x3A)
    let e_shnum     = _er_u16le(buf, 0x3C)
    if e_shentsize < 64 { return out }
    if e_shnum < 1 { return out }

    let mut dynsym_hdr = -1
    let mut si = 0
    while si < e_shnum {
        let sh = e_shoff + si * e_shentsize
        if _er_u32le(buf, sh + 0x04) == ELF_SHT_DYNSYM { dynsym_hdr = sh; break }
        si = si + 1
    }
    if dynsym_hdr < 0 { return out }
    let dsym_off = _er_u64le(buf, dynsym_hdr + 0x18)
    let dsym_sz  = _er_u64le(buf, dynsym_hdr + 0x20)
    let dsym_lnk = _er_u32le(buf, dynsym_hdr + 0x28)
    let mut dsym_es = _er_u64le(buf, dynsym_hdr + 0x38)
    if dsym_es < 1 { dsym_es = 24 }
    if dsym_lnk > e_shnum - 1 { return out }
    let dstr_hdr = e_shoff + dsym_lnk * e_shentsize
    let dstr_off = _er_u64le(buf, dstr_hdr + 0x18)

    let count = dsym_sz / dsym_es
    let mut k = 1
    while k < count {
        let s = dsym_off + k * dsym_es
        let st_name  = _er_u32le(buf, s + 0x00)
        let st_info  = _er_u8(buf, s + 0x04)
        let st_shndx = _er_u16le(buf, s + 0x06)
        let st_size  = _er_u64le(buf, s + 0x10)
        if st_shndx != 0 {
            let nm = _er_cstr(buf, dstr_off + st_name)
            if len(nm) > 0 {
                out.names.push(nm)
                out.types.push(st_info & 0xf)
                out.sizes.push(st_size)
            }
        }
        k = k + 1
    }
    out.ok = 1
    return out
}

// All GLOBAL/WEAK def names across every archive member — the tripwire's
// runtime_defs (twin of _aef_all_member_defs). Uses parse_elf_arm64_obj +
// _aef_symname_arm64.
fn _aef_all_member_defs_arm64(buf, members: [ArMember]) -> [string] {
    let defs: [string] = []
    let mut m = 0
    while m < len(members) {
        let mem = members[m]
        let obj = parse_elf_arm64_obj(buf, mem.data_off, mem.size, m)
        let mut sj = 0
        while sj < len(obj.symbols) {
            let s = obj.symbols[sj]
            if s.section != 0 && (s.bind == ELF_STB_GLOBAL || s.bind == ELF_STB_WEAK) {
                let nm = _aef_symname_arm64(obj, s.name_offset)
                if len(nm) > 0 && !_aef_has(defs, nm) { defs.push(nm) }
            }
            sj = sj + 1
        }
        m = m + 1
    }
    return defs
}

// Return the GENUINE residual libc UND names over the combined obj list — every
// symbol-referencing reloc target (CALL26/JUMP26/ADR/ADD/LDST/PREL32 + GOT — i.e.
// everything EXCEPT the data-absolute ABS64/ABS32, which stay hard-error like
// x86's kind-1 rule) that (a) no obj defines, (b) has no `hxlcl_<name>` own-body
// to alias to, (c) is not a linker-synthetic/hexa-own-prefixed name. This is the
// set that becomes n_dyn>0 → predicts the crt1 dynamic-link handoff. Mirror of
// _census_resid_und; O(relocs·bucket) via the 1024-bucket _ldx_hash def-index.
fn _census_resid_und_arm64(objs: [ElfArm64Obj]) -> [string] {
    let mut dfx: [[string]] = []
    let mut db = 0
    while db < 1024 { dfx.push([]); db = db + 1 }
    let mut oi = 0
    while oi < len(objs) {
        let o = objs[oi]
        let mut si = 0
        while si < len(o.symbols) {
            let s = o.symbols[si]
            if s.section != 0 {
                let nm = _aef_symname_arm64(o, s.name_offset)
                if len(nm) > 0 {
                    let hb = _ldx_hash(nm)
                    dfx[hb] = dfx[hb].push(nm)
                }
            }
            si = si + 1
        }
        oi = oi + 1
    }
    let mut resid: [string] = []
    let mut ro = 0
    while ro < len(objs) {
        let o = objs[ro]
        let mut rj = 0
        while rj < len(o.relocs) {
            let r = o.relocs[rj]
            let is_symref = r.kind != ELF_R_AARCH64_ABS64 && r.kind != ELF_R_AARCH64_ABS32
                            && r.kind != ELF_R_AARCH64_NONE
            if is_symref {
                let s = o.symbols[r.sym_idx]
                let nm = _aef_symname_arm64(o, s.name_offset)
                if len(nm) > 0 {
                    let mut is_def = false
                    let hb = _ldx_hash(nm)
                    let bn = dfx[hb]
                    let mut bi = 0
                    while bi < len(bn) { if bn[bi] == nm { is_def = true; break } bi = bi + 1 }
                    let mut is_alias = false
                    if !is_def {
                        let own_nm = "hxlcl_" + nm
                        let ohb = _ldx_hash(own_nm)
                        let obn = dfx[ohb]
                        let mut obi = 0
                        while obi < len(obn) { if obn[obi] == own_nm { is_alias = true; break } obi = obi + 1 }
                    }
                    let synth = nm == "__errno_location" || nm == "__init_array_start"
                                || nm == "__init_array_end"
                    let own_pre = _elf_has_prefix(nm, "hexa_") || _elf_has_prefix(nm, "rt_")
                                  || _elf_has_prefix(nm, "_hx_") || _elf_has_prefix(nm, "__hexa")
                                  || _elf_has_prefix(nm, "hxlcl_") || _elf_has_prefix(nm, "forge_")
                                  || _elf_has_prefix(nm, "farr_")
                    if !is_def && !is_alias && !synth && !own_pre {
                        if !_aef_has(resid, nm) { resid.push(nm) }
                    }
                }
            }
            rj = rj + 1
        }
        ro = ro + 1
    }
    return resid
}

pub fn link_elf_arm64_ownstart_ar(program_objs: [ElfArm64Obj], out_path: string, main_name: string, runtime_a_path: string) -> Int {
    let buf       = read_file_bytes(runtime_a_path)
    let members   = parse_ar_archive(buf)
    let extracted = archive_extract_fixpoint_arm64(program_objs, buf, members)

    // program + extracted (pre-crt1)
    let objs0: [ElfArm64Obj] = []
    let mut ci = 0
    while ci < len(program_objs) { objs0.push(program_objs[ci]); ci = ci + 1 }
    let mut cj = 0
    while cj < len(extracted) { objs0.push(extracted[cj]); cj = cj + 1 }

    // ── S2: crt_handoff gate (Road A dynamic-link). Residual libc UND census over
    //    the pre-crt1 objs: >0 → the pure-static path can't resolve them (no libc),
    //    so hand the process entry to crt1.o + dynamic-link the floor via
    //    libc.so.6 (GLOB_DAT-only), mirroring link_elf_x86_64_ownstart. ==0 → the
    //    rung-2 static path (hand stub, 2seg, no crt1) is byte-identical. ──
    let resid_pre = _census_resid_und_arm64(objs0)
    let crt_handoff = len(resid_pre) > 0

    let objs: [ElfArm64Obj] = []
    if crt_handoff {
        let crt1 = _ld_read_crt1_arm64()
        if len(crt1.symbols) == 0 {
            eprintln("hexa_ld(arm64,ownstart_ar): residual libc UND ('" + resid_pre[0] + "' …) needs crt1.o — set HEXA_LD_SYSROOT=<dir with aarch64 crt1.o> or install /usr/lib/aarch64-linux-gnu/crt1.o")
            return 3
        }
        objs.push(crt1)
    }
    let mut co = 0
    while co < len(objs0) { objs.push(objs0[co]); co = co + 1 }

    // runtime.a def universe (near-miss tripwire) + libc.so.6 .dynsym (type-route)
    let runtime_defs = _aef_all_member_defs_arm64(buf, members)
    let mut libc_dyn = LibcDynsym { names: [], types: [], sizes: [], ok: 0 }
    if crt_handoff {
        libc_dyn = _ld_read_libc_dynsym_arm64()
        if libc_dyn.ok == 0 {
            eprintln("hexa_ld(arm64,ownstart_ar): dynamic-link path needs aarch64 libc.so.6 .dynsym — set HEXA_LD_SYSROOT=<dir with libc.so.6>")
            return 3
        }
    }

    // ── text: 24-byte hand _start stub ONLY on the static path. On crt_handoff
    //    crt1's `_start` (objs[0], text offset 0) is the entry — no hand stub. ──
    let text: [Int] = []
    let mut bl_off = -1
    if !crt_handoff {
        text.push(0xe0); text.push(0x03); text.push(0x40); text.push(0xf9)   // ldr x0,[sp]
        text.push(0xe1); text.push(0x23); text.push(0x00); text.push(0x91)   // add x1,sp,#8
        text.push(0x00); text.push(0x00); text.push(0x00); text.push(0x94)   // bl main
        text.push(0xe0); text.push(0x03); text.push(0x01); text.push(0xaa)   // mov x0,x1  (exit code = HexaVal payload)
        text.push(0xa8); text.push(0x0b); text.push(0x80); text.push(0xd2)   // movz x8,#93
        text.push(0x01); text.push(0x00); text.push(0x00); text.push(0xd4)   // svc #0
        bl_off = 8
    } else {
        // ── C-ABI `main` trampoline (crt_handoff path) ── hexa fns return a 16-byte
        // HexaVal pair (x0=tag, x1=payload; TAG_INT=0), so crt1's __libc_start_main,
        // reading x0 as the C-ABI `int main()` return, would exit(tag)=exit(0). This
        // 24B trampoline (at text offset 0, before crt1) is what the `main` DEF is
        // redirected to: it calls the real hexa main, moves the PAYLOAD into x0, and
        // returns the C-ABI int — so __libc_start_main exit()s with the real value.
        // +8B nop pad keeps crt1's prepended text base 16-aligned (rung-3 align lesson).
        text.push(0xfd); text.push(0x7b); text.push(0xbf); text.push(0xa9)   // stp x29,x30,[sp,#-16]!
        text.push(0xfd); text.push(0x03); text.push(0x00); text.push(0x91)   // mov x29,sp
        text.push(0x00); text.push(0x00); text.push(0x00); text.push(0x94)   // bl <hexa main> (offset 8)
        text.push(0xe0); text.push(0x03); text.push(0x01); text.push(0xaa)   // mov x0,x1  (C-ABI ret = payload)
        text.push(0xfd); text.push(0x7b); text.push(0xc1); text.push(0xa8)   // ldp x29,x30,[sp],#16
        text.push(0xc0); text.push(0x03); text.push(0x5f); text.push(0xd6)   // ret
        text.push(0x1f); text.push(0x20); text.push(0x03); text.push(0xd5)   // nop
        text.push(0x1f); text.push(0x20); text.push(0x03); text.push(0xd5)   // nop
        bl_off = 8
    }

    let data_bytes: [Int] = []
    let mut total_bss = 0
    let def_names: [string] = []
    let def_seg:   [Int]    = []
    let def_off:   [Int]    = []
    let obj_text_base: [Int] = []
    let obj_ro_base:   [Int] = []
    let obj_da_base:   [Int] = []
    let obj_bss_base:  [Int] = []
    let mut main_off = -1

    // ── concat pass: text/rodata/data blobs + name→(seg,off) def-map ──
    let mut oi = 0
    while oi < len(objs) {
        let obj = objs[oi]
        let tbase = len(text)
        obj_text_base.push(tbase)
        // 16-align each obj's rodata/data section base. data_vaddr is 0x10000-
        // aligned, so a 16-aligned blob offset ⇒ 16-aligned section vaddr — the
        // max AArch64 LDST alignment (LDST128 scale 4). Without this, prepending
        // crt1 (rung-3 dyn path) shifts a later obj's section by crt1's byte size;
        // if that's not 8-aligned an `ldr x,[sec,:lo12:]` (LDST64_ABS_LO12_NC)
        // against `$sec_N_4` fails the scale-3 alignment check (_apply rc=2). The
        // static path never prepended, so the latent gap only surfaced under dyn.
        while (len(data_bytes) & 15) != 0 { data_bytes.push(0) }
        let ro_base = len(data_bytes)
        let mut r = 0
        while r < len(obj.rodata) { data_bytes.push(obj.rodata[r] & 0xff); r = r + 1 }
        while (len(data_bytes) & 15) != 0 { data_bytes.push(0) }
        let da_base = len(data_bytes)
        let mut dd = 0
        while dd < len(obj.data) { data_bytes.push(obj.data[dd] & 0xff); dd = dd + 1 }
        obj_ro_base.push(ro_base)
        obj_da_base.push(da_base)
        let bss_base = total_bss
        obj_bss_base.push(bss_base)
        total_bss = total_bss + obj.bss_size
        let mut si = 0
        while si < len(obj.symbols) {
            let s = obj.symbols[si]
            if s.section != 0 {
                let name = _aef_symname_arm64(obj, s.name_offset)
                if s.section == 1 {
                    if crt_handoff && name == main_name {
                        // crt1 binds `main` → the C-ABI trampoline @ text offset 0
                        // (emitted above); main_off stays the REAL hexa body for the
                        // trampoline's bl patch.
                        def_names.push(name); def_seg.push(0); def_off.push(0)
                        if main_off < 0 { main_off = tbase + s.value }
                    } else {
                        def_names.push(name); def_seg.push(0); def_off.push(tbase + s.value)
                        if main_off < 0 && name == main_name { main_off = tbase + s.value }
                    }
                } else if s.section == 5 {
                    def_names.push(name); def_seg.push(2); def_off.push(bss_base + s.value)
                } else {
                    def_names.push(name); def_seg.push(1)
                    if s.section >= 4 { def_off.push(da_base + s.value) } else { def_off.push(ro_base + s.value) }
                }
            }
            si = si + 1
        }
        let mut t = 0
        while t < len(obj.text) { text.push(obj.text[t] & 0xff); t = t + 1 }
        oi = oi + 1
    }
    if main_off < 0 {
        eprintln("hexa_ld(arm64,ownstart_ar): entry '" + main_name + "' not defined")
        return 3
    }

    // ── linker-synthetic __init_array_start/__init_array_end (zero-trip; the dyn
    //    path emits NO DT_INIT_ARRAY — crt1/_dl_init owns ctors, x86 measured rc
    //    0→2 if materialized on the dyn path). MUST precede GOT + census. ──
    let _iar_off = len(data_bytes)
    def_names.push("__init_array_start"); def_seg.push(1); def_off.push(_iar_off)
    def_names.push("__init_array_end");   def_seg.push(1); def_off.push(_iar_off)

    // ── S3: DYN-UND census + (A0) hxlcl_ FLOOR-NAME alias + near-miss tripwire.
    //    One pass over every reloc: an UND symref target (all kinds except the
    //    data-absolute ABS64/ABS32) that (a) has an `hxlcl_<name>` own-body →
    //    register a link-time alias at the same seg/off (bare name resolves to the
    //    own body — e.g. longjmp→hxlcl_longjmp, keeping the native setjmp/longjmp
    //    jmp_buf pair consistent); (b) else is a genuine residual libc UND →
    //    dyn_names (veneer + GLOB_DAT). Tripwire refuses a codegen↔runtime
    //    mismatch; STT_OBJECT refuses (COPY lane not ported on arm64). ──
    let dyn_names: [string] = []
    let mut cxi = 0
    while cxi < len(objs) {
        let cxo = objs[cxi]
        let mut cxr = 0
        while cxr < len(cxo.relocs) {
            let dr = cxo.relocs[cxr]
            let is_symref = dr.kind != ELF_R_AARCH64_ABS64 && dr.kind != ELF_R_AARCH64_ABS32 && dr.kind != ELF_R_AARCH64_NONE
            if is_symref {
                let dnm = _aef_symname_arm64(cxo, cxo.symbols[dr.sym_idx].name_offset)
                if len(dnm) > 0 {
                    let mut ddef = false
                    let mut ddi = 0
                    while ddi < len(def_names) { if def_names[ddi] == dnm { ddef = true; break } ddi = ddi + 1 }
                    if !ddef {
                        let own_nm = "hxlcl_" + dnm
                        let mut oix = -1
                        let mut oj = 0
                        while oj < len(def_names) { if def_names[oj] == own_nm { oix = oj; break } oj = oj + 1 }
                        if oix >= 0 {
                            def_names.push(dnm); def_seg.push(def_seg[oix]); def_off.push(def_off[oix])
                            ddef = true
                        }
                    }
                    if !ddef {
                        let synth = dnm == "__errno_location" || dnm == "__init_array_start" || dnm == "__init_array_end"
                        let own_pre = _elf_has_prefix(dnm, "hexa_") || _elf_has_prefix(dnm, "rt_")
                                      || _elf_has_prefix(dnm, "_hx_") || _elf_has_prefix(dnm, "__hexa")
                                      || _elf_has_prefix(dnm, "hxlcl_") || _elf_has_prefix(dnm, "forge_")
                                      || _elf_has_prefix(dnm, "farr_")
                        if !synth && !own_pre {
                            let mut already = false
                            let mut dnj = 0
                            while dnj < len(dyn_names) { if dyn_names[dnj] == dnm { already = true; break } dnj = dnj + 1 }
                            if !already {
                                if len(runtime_defs) > 0 {
                                    let mut _hit = ""
                                    let mut _rdi = 0
                                    while _rdi < len(runtime_defs) {
                                        let _rd = runtime_defs[_rdi]
                                        if _rd == "hexa_array_" + dnm || _rd == "hexa_str_" + dnm || _rd == "hexa_map_" + dnm || _rd == "rt_str_" + dnm { _hit = _rd; break }
                                        _rdi = _rdi + 1
                                    }
                                    if len(_hit) > 0 {
                                        eprintln("hexa_ld(arm64,ownstart_ar): codegen-runtime sym mismatch: UND '" + dnm + "' — runtime.a defines '" + _hit + "' (missing _builtin_runtime_sym entry)")
                                        return 3
                                    }
                                }
                                if _libc_sym_type(libc_dyn, dnm) == ELF_STT_OBJECT {
                                    eprintln("hexa_ld(arm64,ownstart_ar): dyn UND '" + dnm + "' is STT_OBJECT (data import) — COPY lane not ported on arm64 rung-3")
                                    return 3
                                }
                                dyn_names.push(dnm)
                            }
                        }
                    }
                }
            }
            cxr = cxr + 1
        }
        cxi = cxi + 1
    }
    let n_dyn = len(dyn_names)
    if len(env_var("HEXA_LD_DUMP_DYN")) > 0 {
        eprintln("hexa_ld(arm64,ownstart_ar): n_dyn=" + to_string(n_dyn))
        let mut _di = 0
        while _di < n_dyn { eprintln("  DYN-UND: " + dyn_names[_di]); _di = _di + 1 }
    }

    // ── S4a: veneers — one 12-byte AArch64 stub per dyn sym at the text tail
    //    (adrp x16,slot@page ; ldr x16,[x16,#:lo12:slot] ; br x16). x16=IP0 is the
    //    AAPCS64 intra-call scratch, safe to clobber at any call boundary.
    //    Registered as a GLOBAL text def so `bl <sym>` resolves onto it via
    //    _aa_vaddr_of; the adrp/ldr GOT-slot fields are patched in S5. ──
    while (len(text) & 3) != 0 { text.push(0) }
    let veneer_off: [Int] = []
    let mut vni = 0
    while vni < n_dyn {
        let voff = len(text)
        veneer_off.push(voff)
        text.push(0x10); text.push(0x00); text.push(0x00); text.push(0x90)   // adrp x16, 0
        text.push(0x10); text.push(0x02); text.push(0x40); text.push(0xf9)   // ldr  x16, [x16, #0]
        text.push(0x00); text.push(0x02); text.push(0x1f); text.push(0xd6)   // br   x16
        def_names.push(dyn_names[vni]); def_seg.push(0); def_off.push(voff)
        vni = vni + 1
    }

    // ── layout constants (code_off = 288 on the dyn path [4 phdrs], 176 static) ──
    let code_off = if n_dyn > 0 { 288 } else { 176 }
    let vaddr_base = 0x400000
    let text_vaddr = vaddr_base + code_off
    let text_end = code_off + len(text)
    let data_file_off = text_end + ((0x10000 - (text_end & 0xffff)) & 0xffff)
    let data_vaddr = vaddr_base + data_file_off

    // ── S5: GOT synth. distinct GOT-referenced obj sym names + (S4b) the dyn
    //    names (one shared 8-byte slot each; defined → static-filled, dyn → 0 and
    //    ld.so writes it via GLOB_DAT). ──
    let got_names: [string] = []
    let mut goi = 0
    while goi < len(objs) {
        let obj = objs[goi]
        let mut ri = 0
        while ri < len(obj.relocs) {
            let rl = obj.relocs[ri]
            if _elf_arm64_kind_is_got(rl.kind) == 1 {
                let nm = _aef_symname_arm64(obj, obj.symbols[rl.sym_idx].name_offset)
                if !_aef_has(got_names, nm) { got_names.push(nm) }
            }
            ri = ri + 1
        }
        goi = goi + 1
    }
    let mut dgi = 0
    while dgi < n_dyn {
        if !_aef_has(got_names, dyn_names[dgi]) { got_names.push(dyn_names[dgi]) }
        dgi = dgi + 1
    }
    while (len(data_bytes) & 7) != 0 { data_bytes.push(0) }
    let got_off = len(data_bytes)
    let mut gg = 0
    while gg < len(got_names) { let mut z = 0; while z < 8 { data_bytes.push(0); z = z + 1 }; gg = gg + 1 }

    // ── S4c: dyn data structures (dynstr/dynsym/DT_HASH/.rela.dyn/_DYNAMIC/interp)
    //    appended to the data blob — GLOB_DAT-only (COPY lane not ported). Skipped
    //    entirely when n_dyn==0 → 2seg static output is byte-identical. ──
    let mut interp_off = 0
    let mut interp_len = 0
    let mut dyn_off = 0
    let mut dyn_sz = 0
    if n_dyn > 0 {
        let dynstr_blob_off = len(data_bytes)
        data_bytes.push(0)
        let dynstr_name_off: [Int] = []
        let mut ds = 0
        while ds < n_dyn {
            dynstr_name_off.push(len(data_bytes) - dynstr_blob_off)
            let nm = dyn_names[ds]
            let mut cc = 0
            while cc < len(nm) { data_bytes.push(char_code(nm, cc) & 0xff); cc = cc + 1 }
            data_bytes.push(0)
            ds = ds + 1
        }
        let needed_off = len(data_bytes) - dynstr_blob_off
        let libc = "libc.so.6"
        let mut li = 0
        while li < len(libc) { data_bytes.push(char_code(libc, li) & 0xff); li = li + 1 }
        data_bytes.push(0)
        let dynstr_size = len(data_bytes) - dynstr_blob_off
        let dynstr_vaddr = data_vaddr + dynstr_blob_off

        while (len(data_bytes) & 7) != 0 { data_bytes.push(0) }
        let dynsym_blob_off = len(data_bytes)
        let dynsym_vaddr = data_vaddr + dynsym_blob_off
        let mut z0 = 0
        while z0 < 24 { data_bytes.push(0); z0 = z0 + 1 }
        let mut sy = 0
        while sy < n_dyn {
            _ew_u32(data_bytes, dynstr_name_off[sy])   // st_name
            data_bytes.push(0x10); data_bytes.push(0)  // st_info=GLOBAL|NOTYPE, st_other
            _ew_u16(data_bytes, 0)                      // st_shndx = SHN_UNDEF
            _ew_u64(data_bytes, 0)                      // st_value
            _ew_u64(data_bytes, 0)                      // st_size
            sy = sy + 1
        }
        let n_dynsym = n_dyn + 1

        while (len(data_bytes) & 7) != 0 { data_bytes.push(0) }
        let hash_blob_off = len(data_bytes)
        let hash_vaddr = data_vaddr + hash_blob_off
        _ew_u32(data_bytes, 1)                          // nbucket
        _ew_u32(data_bytes, n_dynsym)                   // nchain
        if n_dynsym > 1 { _ew_u32(data_bytes, 1) } else { _ew_u32(data_bytes, 0) }
        let mut ch = 0
        while ch < n_dynsym {
            if ch == n_dynsym - 1 { _ew_u32(data_bytes, 0) } else { _ew_u32(data_bytes, ch + 1) }
            ch = ch + 1
        }

        while (len(data_bytes) & 7) != 0 { data_bytes.push(0) }
        let rela_blob_off = len(data_bytes)
        let rela_vaddr = data_vaddr + rela_blob_off
        let mut rr = 0
        while rr < n_dyn {
            let mut rgs = -1
            let mut rgx = 0
            while rgx < len(got_names) { if got_names[rgx] == dyn_names[rr] { rgs = rgx; break } rgx = rgx + 1 }
            let slot_vaddr = data_vaddr + got_off + rgs * 8
            _ew_u64(data_bytes, slot_vaddr)                                    // r_offset
            _ew_u64(data_bytes, (rr + 1) * 4294967296 + ELF_R_AARCH64_GLOB_DAT) // r_info=(idx<<32)|GLOB_DAT
            _ew_u64(data_bytes, 0)                                             // r_addend
            rr = rr + 1
        }
        let rela_size = n_dyn * 24

        while (len(data_bytes) & 7) != 0 { data_bytes.push(0) }
        dyn_off = len(data_bytes)
        _ew_u64(data_bytes, 1);  _ew_u64(data_bytes, needed_off)     // DT_NEEDED = "libc.so.6"
        _ew_u64(data_bytes, 4);  _ew_u64(data_bytes, hash_vaddr)     // DT_HASH
        _ew_u64(data_bytes, 5);  _ew_u64(data_bytes, dynstr_vaddr)   // DT_STRTAB
        _ew_u64(data_bytes, 6);  _ew_u64(data_bytes, dynsym_vaddr)   // DT_SYMTAB
        _ew_u64(data_bytes, 10); _ew_u64(data_bytes, dynstr_size)    // DT_STRSZ
        _ew_u64(data_bytes, 11); _ew_u64(data_bytes, 24)             // DT_SYMENT
        _ew_u64(data_bytes, 7);  _ew_u64(data_bytes, rela_vaddr)     // DT_RELA
        _ew_u64(data_bytes, 8);  _ew_u64(data_bytes, rela_size)      // DT_RELASZ
        _ew_u64(data_bytes, 9);  _ew_u64(data_bytes, 24)             // DT_RELAENT
        _ew_u64(data_bytes, 0);  _ew_u64(data_bytes, 0)              // DT_NULL
        dyn_sz = len(data_bytes) - dyn_off

        interp_off = len(data_bytes)
        let interp = "/lib/ld-linux-aarch64.so.1"
        let mut ip = 0
        while ip < len(interp) { data_bytes.push(char_code(interp, ip) & 0xff); ip = ip + 1 }
        data_bytes.push(0)
        interp_len = len(interp) + 1
    }

    // 16-align the data blob tail so bss_vaddr_base is 16-aligned — a `.bss`
    // section symbol ($sec_N_<bss-shndx>, seg 2) resolves to bss_vaddr_base +
    // value, and an `ldr x,[sec,:lo12:]` (LDST64_ABS_LO12_NC) against it needs an
    // 8-aligned target. On the dyn path the appended dynstr/dynsym/rela/_DYNAMIC/
    // interp blobs (interp "/lib/ld-linux-aarch64.so.1" = 27B, odd) leave
    // len(data_bytes) unaligned → an odd bss_vaddr_base → _apply rc=2. The static
    // path ended at the 8-padded GOT so this never surfaced. 16 covers LDST128.
    while (len(data_bytes) & 15) != 0 { data_bytes.push(0) }
    let bss_vaddr_base = data_vaddr + len(data_bytes)     // bss above data (incl GOT + dyn blobs)

    // ── GOT fill: defined syms → final vaddr; dyn syms → leave 0 (ld.so GLOB_DAT) ──
    let mut fi = 0
    while fi < len(got_names) {
        let mut is_dyn = false
        let mut dchk = 0
        while dchk < n_dyn { if dyn_names[dchk] == got_names[fi] { is_dyn = true; break } dchk = dchk + 1 }
        if !is_dyn {
            let sv = _aa_vaddr_of(got_names[fi], def_names, def_seg, def_off, text_vaddr, data_vaddr, bss_vaddr_base)
            if sv == -1 { eprintln("hexa_ld(arm64,ownstart_ar): GOT sym '" + got_names[fi] + "' undefined"); return 3 }
            let mut b = 0
            while b < 8 { data_bytes[got_off + fi*8 + b] = (sv >> (8*b)) & 0xff; b = b + 1 }
        }
        fi = fi + 1
    }

    // ── patch the stub's `bl main` (CALL26) — static path only ──
    if bl_off >= 0 {
        let _bp = _apply_arm64_reloc(text, bl_off, ELF_R_AARCH64_CALL26, text_vaddr + main_off, 0, text_vaddr + bl_off, 0)
        if _bp != 0 { eprintln("hexa_ld(arm64,ownstart_ar): stub bl main patch rc=" + to_string(_bp)); return 3 }
    }

    // ── S5: veneer fill — point each veneer's adrp/ldr at its shared GOT slot ──
    let mut vfi = 0
    while vfi < n_dyn {
        let voff = veneer_off[vfi]
        let mut gslot = -1
        let mut gx = 0
        while gx < len(got_names) { if got_names[gx] == dyn_names[vfi] { gslot = got_off + gx*8; break } gx = gx + 1 }
        let gvaddr = data_vaddr + gslot
        let vp = text_vaddr + voff
        let r1 = _apply_arm64_reloc(text, voff + 0, ELF_R_AARCH64_ADR_GOT_PAGE, 0, 0, vp, gvaddr)
        let r2 = _apply_arm64_reloc(text, voff + 4, ELF_R_AARCH64_LD64_GOT_LO12_NC, 0, 0, vp + 4, gvaddr)
        if r1 != 0 || r2 != 0 { eprintln("hexa_ld(arm64,ownstart_ar): veneer '" + dyn_names[vfi] + "' fill rc=" + to_string(r1) + "/" + to_string(r2)); return 3 }
        vfi = vfi + 1
    }

    // ── S4 apply: every obj reloc at final vaddr (site_seg picks buffer + P) ──
    let mut aoi = 0
    while aoi < len(objs) {
        let obj = objs[aoi]
        let mut ri = 0
        while ri < len(obj.relocs) {
            let rl = obj.relocs[ri]
            let sname = _aef_symname_arm64(obj, obj.symbols[rl.sym_idx].name_offset)
            let mut S = _aa_vaddr_of(sname, def_names, def_seg, def_off, text_vaddr, data_vaddr, bss_vaddr_base)
            let is_got = _elf_arm64_kind_is_got(rl.kind) == 1
            if S == -1 {
                // a GOT-kind ref to a dyn sym is OK (slot filled by ld.so; only G consumed)
                let mut is_dyn = false
                let mut dq = 0
                while dq < n_dyn { if dyn_names[dq] == sname { is_dyn = true; break } dq = dq + 1 }
                if is_got && is_dyn { S = 0 }
                else {
                    eprintln("hexa_ld(arm64,ownstart_ar): undefined symbol '" + sname + "' (reloc kind " + to_string(rl.kind) + ")")
                    return 3
                }
            }
            let mut G = 0
            if is_got {
                let mut gi = 0
                while gi < len(got_names) { if got_names[gi] == sname { G = data_vaddr + got_off + gi*8 }; gi = gi + 1 }
            }
            let seg = rl.site_seg
            let mut rc = 0
            if seg == 1 {
                let P = text_vaddr + obj_text_base[aoi] + rl.offset
                rc = _apply_arm64_reloc(text, obj_text_base[aoi] + rl.offset, rl.kind, S, rl.addend, P, G)
            } else if seg == 4 {
                let P = data_vaddr + obj_da_base[aoi] + rl.offset
                rc = _apply_arm64_reloc(data_bytes, obj_da_base[aoi] + rl.offset, rl.kind, S, rl.addend, P, G)
            } else {
                let P = data_vaddr + obj_ro_base[aoi] + rl.offset
                rc = _apply_arm64_reloc(data_bytes, obj_ro_base[aoi] + rl.offset, rl.kind, S, rl.addend, P, G)
            }
            if rc != 0 {
                eprintln("hexa_ld(arm64,ownstart_ar): reloc '" + sname + "' kind " + to_string(rl.kind) + " rc=" + to_string(rc)
                         + " [DIAG obj=" + to_string(aoi) + " site_seg=" + to_string(seg) + " off=" + to_string(rl.offset)
                         + " S=" + to_string(S) + " A=" + to_string(rl.addend) + " SplusA_lo12=" + to_string((S + rl.addend) & 0xfff) + "]")
                return 3
            }
            ri = ri + 1
        }
        aoi = aoi + 1
    }

    // ── entry: static = hand stub at text 0; dyn = crt1 `_start` text offset ──
    let mut entry_off = 0
    if crt_handoff {
        let mut sfound = -1
        let mut ei = 0
        while ei < len(def_names) { if def_names[ei] == "_start" && def_seg[ei] == 0 { sfound = def_off[ei]; break } ei = ei + 1 }
        if sfound < 0 { eprintln("hexa_ld(arm64,ownstart_ar): crt1 handoff but no _start text def"); return 3 }
        entry_off = sfound
    }

    if n_dyn > 0 {
        write_bytes(out_path, serialize_elf_exec_arm64_dyn(text, data_bytes, total_bss, interp_off, interp_len, dyn_off, dyn_sz, entry_off))
    } else {
        write_bytes(out_path, serialize_elf_exec_arm64_2seg(text, data_bytes, total_bss))
    }
    return 0
}

// axis-② E4 — arm64 sibling of elf_x86_64.hexa::demote_nonkeep_to_local.
// ElfSym/ElfRel/nlocal/sh_info are the shared x86 shapes (see header
// comment), so the partition/remap core (_demote_partition) is reused
// verbatim; only the ElfArm64Obj reconstruction differs (no
// init_array/align fields). Empty keeplist = strict pass-through.
pub fn demote_nonkeep_to_local_arm64(obj: ElfArm64Obj, keeplist: [string]) -> ElfArm64Obj {
    if len(keeplist) == 0 { return obj }
    let d = _demote_partition(obj.symbols, obj.relocs, obj.strtab, keeplist)
    return ElfArm64Obj {
        text:     obj.text,
        relocs:   d.relocs,
        symbols:  d.symbols,
        strtab:   obj.strtab,
        rodata:   obj.rodata,
        data:     obj.data,
        bss_size: obj.bss_size,
        nlocal:   d.nlocal,
    }
}

// axis-② A1 frozen-seed isolation — arm64-elf twin of isolate_lmodule_x86_64
// (elf_x86_64.hexa). Same LModule reachability filter; only the trial-pack harvest
// differs: _pack_fn_arm64_elf's collector channels are pending_names ∪ page_names
// (adrp/add page-relocs), the complete arm64 symbolic-reference set. _iso_is_carrier
// + _kg_in_list are reused cross-file from elf_x86_64.hexa (the _ew_str precedent).
// Mach-O/darwin = a later rung; the resolver tri-state `auto` keeps the frozen-seed
// fallback per-target, so incremental target rollout is safe.
pub fn isolate_lmodule_arm64_elf(lm: LModule, keeplist: [string]) -> LModule {
    if len(keeplist) == 0 { return lm }
    let nf = len(lm.funcs)
    let mut queue: [string] = []
    let mut kept: [string] = []
    let mut ki = 0
    while ki < len(keeplist) {
        let root = keeplist[ki]
        let mut found = false
        let mut fi = 0
        while fi < nf {
            if lm.funcs[fi].name == root { found = true }
            fi = fi + 1
        }
        if !found {
            eprintln("hexa-compiler: --isolate FATAL: keeplist root '" + root + "' not defined in module")
            exit(2)
        }
        if !_kg_in_list(kept, root) {
            kept.push(root)
            queue.push(root)
        }
        ki = ki + 1
    }
    let mut qi = 0
    while qi < len(queue) {
        let fname = queue[qi]
        qi = qi + 1
        let mut fj = 0
        while fj < nf {
            if lm.funcs[fj].name == fname {
                let f = lm.funcs[fj]
                let s_text: [Int] = []
                let p_off: [Int] = []
                let p_names: [string] = []
                let pg_off: [Int] = []
                let pg_names: [string] = []
                let pg_kinds: [Int] = []
                _pack_fn_arm64_elf(s_text, p_off, p_names, pg_off, pg_names, pg_kinds, f)
                let mut chans: [string] = []
                let mut a = 0
                while a < len(p_names) { chans.push(p_names[a]); a = a + 1 }
                a = 0
                while a < len(pg_names) { chans.push(pg_names[a]); a = a + 1 }
                let mut ci = 0
                while ci < len(chans) {
                    let refn = chans[ci]
                    ci = ci + 1
                    if !_kg_in_list(kept, refn) {
                        let mut is_def = false
                        let mut dk = 0
                        while dk < nf {
                            if lm.funcs[dk].name == refn { is_def = true }
                            dk = dk + 1
                        }
                        if is_def && !(_iso_is_carrier(refn) && !_kg_in_list(keeplist, refn)) {
                            kept.push(refn)
                            queue.push(refn)
                        }
                    }
                }
            }
            fj = fj + 1
        }
    }
    let mut new_funcs: [LFunc] = []
    let mut ri = 0
    while ri < nf {
        if _kg_in_list(kept, lm.funcs[ri].name) {
            new_funcs.push(lm.funcs[ri])
        }
        ri = ri + 1
    }
    return LModule {
        file:   lm.file,
        target: lm.target,
        funcs:  new_funcs,
        rodata: lm.rodata,
        bss:    lm.bss,
        globals: lm.globals,
        floats: lm.floats,
    }
}
