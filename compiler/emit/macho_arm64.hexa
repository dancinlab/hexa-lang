// compiler/emit/macho_arm64.hexa
//
// S7-P0 SCAFFOLD — Mach-O arm64 object emitter (LIR -> .o bytes).
//
// RFC 063 § P0. Replaces the `.s` text -> `as` round-trip currently
// in `compiler/main.hexa:806`. Emits Mach-O 64-bit arm64 relocatable
// objects (`MH_OBJECT`, cputype `CPU_TYPE_ARM64`, cpusubtype
// `CPU_SUBTYPE_ARM64_ALL`) directly from `LModule`.
//
// STATUS: IMPLEMENTED (P0 in progress). Encoding table
// (`encode_arm64_insn`), Mach-O serializer (`serialize`), and LIR
// walker (`pack_lir`) are live and imported by `compiler/main.hexa`
// (the `--emit=obj` + `--backend=native` + `arm64-apple-darwin` path
// at main.hexa:882 writes the `.o` via `pack_lir` + `serialize`).
//
// F-P0-OBJEQ status (verified 2026-05-26, arm64 macOS 26.5, Apple
// clang 21.0.0 — measured on `mini`, all numbers verbatim):
//   - `__text` BYTE-EQ vs `clang -c`: HOLDS for {trivial, fib, while}
//     (17 / 74 / 44 instr words IDENTICAL); HEAD `__text` is also
//     byte-identical to the pre-symtab baseline (#1257) — this work
//     did NOT perturb `__text`.
//   - Symbol table now BYTE-EQ in LAYOUT: `nm -ap` (symbols, n_type,
//     n_sect, n_value, ORDER) is IDENTICAL to clang, and DYSYMTAB
//     (ilocalsym 0 / nlocalsym 6 / iextdefsym 6 / nextdefsym 1 /
//     iundefsym 7 / nundefsym 2) is IDENTICAL. Sections (__text,
//     __HEXA,__cap, __HEXA,__abi) + load commands (LC_SEGMENT_64,
//     LC_BUILD_VERSION, LC_SYMTAB, LC_DYSYMTAB) IDENTICAL.
//   - Whole-`.o` byte-eq vs the CWD-independent clang object
//     (`.s` with `.file`/`.loc` stripped): byte-diff == 0 for
//     {trivial, fib, while, if} (ours 800 / 1248 / 1096 / 1064 B ==
//     clang). The strtab interning residual below is now CLOSED.
//
// CLOSED (2026-05-26): STRTAB-INTERNING ORDER. clang's strtab is
//   built by MCStringTableBuilder's suffix-merge interning, which we
//   now reproduce in `_build_merged_strtab`: unique names sorted by
//   REVERSED bytes DESCENDING, a string that is a suffix of its
//   predecessor tail-merges (reuses the predecessor's trailing bytes +
//   NUL), and the table is padded so the file ends on an 8-byte
//   boundary. Every `n_strx` (name_offset) + the `strsize` field now
//   match clang byte-for-byte (verified against Apple clang 21.0.0).
//
// RESIDUAL to FULL byte-eq vs the *default* clang object (out of
// scope — non-portable):
//   (2) DWARF `__debug_line` / `__debug_line_str`. The default
//       `clang -c` object carries these (from `.file`/`.loc`) and
//       `__debug_line_str` EMBEDS the absolute build CWD — so the
//       default clang `.o` is not host/CWD-portable (two CWDs ->
//       two shas). We deliberately do NOT emit `__debug_*`; the
//       byte-eq target is the CWD-independent (`.file`/`.loc`-
//       stripped) clang object, which has no DWARF and which we
//       match section-for-section.
//   - Also out of scope here (separate increment): string/global
//     refs that lower to `adrp sym@PAGE` + `add sym@PAGEOFF` + a
//     `__cstring` section with PAGE21/PAGEOFF12 relocations.
//
// Falsifier (from RFC 063 § P0): `F-P0-OBJEQ` — byte-eq vs
// `clang -c -arch arm64 T.s -o T.ref.o` on {trivial, fib, while, if,
// compiler_self}, after stripping non-deterministic fields
// (timestamps, `LC_BUILD_VERSION` paths, `LC_UUID`, load-command
// order).
//
// Design references:
// - Mach-O spec: <https://github.com/apple-oss-distributions/cctools>
//   (`include/mach-o/loader.h`, `reloc.h`, `arm64/reloc.h`)
// - arm64 ISA: ARM ARM (DDI 0487), the LIR subset emitted by
//   `compiler/codegen/arm64_darwin.hexa`.
// - Existing `.s` emitter: `compiler/emit/asm.hexa` (~459 lines) —
//   line-level structure to mirror; the encoding decisions are
//   identical, only the output format differs (.s text vs Mach-O
//   bytes).

// ─────────────────────────────────────────────────────────────────
// Mach-O 64-bit constants (subset needed for arm64 `.o`)
// ─────────────────────────────────────────────────────────────────
//
// All public constant names are prefixed `MACHO_` / `MACHO_LC_` / `MACHO_S_`
// / `MACHO_ARM64_RELOC_`. The bare-name forms (`MH_OBJECT`, `LC_SEGMENT_64`,
// `CPU_TYPE_ARM64`, etc.) collide with the same-name `#define` macros in
// `<mach-o/loader.h>` / `<mach/machine.h>` that the C runtime
// transitively includes — preprocessor expansion would mangle our
// `HexaVal CPU_TYPE_ARM64 = ...` decl into invalid C. The MACHO_ prefix
// is unique to hexa-side constants.

// Mach-O file magic (little-endian 64-bit).
let MACHO_MH_MAGIC_64 = 0xfeedfacf

// File types we emit.
let MACHO_MH_OBJECT  = 1   // .o relocatable
let MACHO_MH_EXECUTE = 2   // executable (P1 uses this, not P0)

// CPU types.
let MACHO_CPU_TYPE_ARM64 = 0x0100000c  // 0x01000000 | 12 (arm64)
let MACHO_CPU_SUBTYPE_ARM64_ALL = 0

// Load commands we emit.
let MACHO_LC_SEGMENT_64    = 0x19
let MACHO_LC_SYMTAB        = 0x02
let MACHO_LC_DYSYMTAB      = 0x0b
let MACHO_LC_BUILD_VERSION = 0x32

// Section flags.
let MACHO_S_REGULAR               = 0x00000000
let MACHO_S_ATTR_PURE_INSTRUCTIONS = 0x80000000

// arm64 relocation types (`mach-o/arm64/reloc.h`).
let MACHO_ARM64_RELOC_UNSIGNED          = 0
let MACHO_ARM64_RELOC_BRANCH26          = 2
let MACHO_ARM64_RELOC_PAGE21            = 3
let MACHO_ARM64_RELOC_PAGEOFF12         = 4
let MACHO_ARM64_RELOC_GOT_LOAD_PAGE21   = 5
let MACHO_ARM64_RELOC_GOT_LOAD_PAGEOFF12 = 6

// nlist `n_type` bits (`<mach-o/nlist.h>`).
let MACHO_N_UNDF = 0x00   // undefined (extern reference)
let MACHO_N_SECT = 0x0e   // defined in a section
let MACHO_N_EXT  = 0x01   // external (globally visible)
let MACHO_N_PEXT = 0x10   // private extern (`.private_extern` / `.hidden`)

// LC_BUILD_VERSION platform id (`<mach-o/loader.h>`).
let MACHO_PLATFORM_MACOS = 1
// minos packed as XXXX.YY.ZZ in 0xXXXXYYZZ. clang on macOS 26 stamps
// minos 26.0.0 -> 0x001a0000. (26 == 0x1a.) The native emitter mirrors
// the host clang's stamp so `--backend=native` objects carry the same
// LC_BUILD_VERSION clang's `-c` does (verified by `otool -l`).
let MACHO_BUILD_MINOS_26 = 0x001a0000


// ─────────────────────────────────────────────────────────────────
// Builder state — the in-progress Mach-O object as buffers
// ─────────────────────────────────────────────────────────────────

struct MachoArm64Obj {
    // __TEXT,__text section bytes (concatenated instruction words +
    // any literal pools).
    text:     [u8],
    // Per-instruction relocation records (deferred fix-ups for
    // ADRP/ADD symbol pairs, BL branches > 128 MB, etc.).
    relocs:   [Arm64Reloc],
    // Symbol table — function labels, extern references.
    symbols:  [MachoSymbol],
    // String table — null-terminated UTF-8, indexed by symbols.
    strtab:   [u8],
    // DWARF __debug_line bytes (optional; populated from the `.loc`
    // directives the LIR carries; see compiler/emit/asm.hexa for the
    // line-table builder this scaffold reuses).
    dwarf_line: [u8],
    // `__TEXT,__cstring` literal-pool bytes — the concatenated NUL-
    // terminated payloads of every `.LCstrN` rodata section. Each
    // string's start offset within this buffer is the N_SECT value of
    // its `.LCstr*` local symbol; the ADRP/ADD `@PAGE`/`@PAGEOFF` reloc
    // pair resolves against those symbols. Empty when the module has no
    // string literals (keeps the 3-section layout byte-stable).
    cstring:  [u8],
    // `__TEXT,__const` float-literal pool (PR-C2): the concatenated
    // 8-byte IEEE-754 doubles of every `.LCfltN` (8-aligned). Each
    // float's start offset is the N_SECT value of its `.LCflt*` local;
    // the ADRP/ADD `@PAGE`/`@PAGEOFF` reloc pair resolves against them.
    // Empty when the module has no float literals.
    cflt:     [u8],
    // `__DATA,__data` module-global slots (PR-C1): one 16-byte
    // zero-initialized HexaVal slot per `lm.globals` entry (8-aligned),
    // symbol name `g<id>`. The `g<id>@PAGE`/`@PAGEOFF` load/store reloc
    // pair resolves against these N_SECT defs. Empty when the module
    // has no module-level mutable globals.
    gdata:    [u8],
}

struct Arm64Reloc {
    offset:  i64,    // offset in __text where the patch applies
    sym_idx: i64,    // index into symbols[]
    kind:    i64,    // ARM64_RELOC_*
    pcrel:   i64,    // 0 or 1
    length:  i64,    // log2(byte size); 2 = 4 bytes (one arm64 insn)
}

struct MachoSymbol {
    name_offset: i64,   // index into strtab[]
    section:     i64,   // 0 = undefined extern, 1 = __text, 2 = __cap, 3 = __abi
    value:       i64,   // address (within its section for defined syms)
    kind:        i64,   // N_SECT (defined) / N_UNDF (extern) / ...
    is_external: i64,   // N_EXT flag
    is_pext:     i64,   // N_PEXT (.private_extern / .hidden) — non-entry fns
}

// The 12-byte `__HEXA,__abi` ABI stamp (RFC 070 §G7-D.B2): a 4-byte LE
// runtime_version (1) + 8-byte LE nanbox_layout_hash (0). Mirrors
// `compiler/emit/asm.hexa::_abi_stamp_hex` — same bytes the `.s` path
// emits via `.byte`, here packed directly. Held as a fixed constant so
// the `__abi` section content is byte-stable across the `.s` and native
// emit paths (`asm.hexa` HEXA_RUNTIME_VERSION=1, HEXA_NANBOX_LAYOUT_HASH=0).
fn _hexa_abi_stamp_bytes() -> [Int] {
    return [0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]
}

// Entry symbols keep default (public) visibility; everything else is
// `.private_extern` (N_PEXT). Mirrors `asm.hexa::_is_entry_symbol`.
fn _is_entry_symbol_name(name: string) -> bool {
    if name == "main"   { return true }
    if name == "_start" { return true }
    return false
}

// ─────────────────────────────────────────────────────────────────
// Public entry — LIR -> Mach-O arm64 .o
// ─────────────────────────────────────────────────────────────────

// pub fn emit_macho_arm64(lm: LModule, out_path: string) -> i64
//
// Returns 0 on success, non-zero on encoding / IO failure.
//
// RFC 063 § P0 IMPLEMENTATION CHECKLIST (in dispatch order):
//   1. arm64 encoding table — LIR opcode + operands -> 32-bit word.
//      ~150-200 rules covering the LIR subset
//      `compiler/codegen/arm64_darwin.hexa` currently emits.
//   2. Symbol pass — collect all function labels and extern refs
//      from `lm.funcs`, populate `symbols[]` + `strtab[]`.
//   3. Code pass — walk LInstr stream, encode each to 4 bytes, emit
//      relocation records for ADRP / ADD / LDR symbol pairs and
//      BL branches.
//   4. DWARF pass — reuse asm.hexa's `.loc` line-table builder, emit
//      `__debug_line` section bytes.
//   5. Mach-O serialization — header + LC_SEGMENT_64(__TEXT) +
//      LC_SYMTAB + LC_DYSYMTAB + LC_BUILD_VERSION, sections, then
//      the data buffers; relocations into `__text` section's reloff.
//   6. Write to `out_path`.
fn emit_macho_arm64(_lm: i64, _out_path: string) {
    // RFC 063 § P0 — implementation pending.
    // The signature uses placeholder types until LModule is wired
    // (the import will resolve to `compiler/ir/lir.hexa::LModule`
    // when this file is integrated).
    println("emit_macho_arm64: SCAFFOLD — not yet implemented (RFC 063 P0)")
}

// ─────────────────────────────────────────────────────────────────
// Encoding table — populated in P0 implementation cycles
// ─────────────────────────────────────────────────────────────────

// Register name -> index. arm64 has 31 general-purpose 64-bit regs
// (X0..X30) plus XZR (zero register, encoded as 31) and SP (stack
// pointer, also encoded as 31 in some contexts).
fn xreg_idx(s: string) -> i64 {
    if s == "XZR" || s == "xzr" { return 31 }
    if s == "SP"  || s == "sp"  { return 31 }
    // Strip leading "X"/"x", parse remaining as integer (0..30).
    let n = len(s)
    if n < 2 { return -1 }
    let head = s.substring(0, 1)
    if head != "X" && head != "x" { return -1 }
    let rest = s.substring(1, n)
    let v = rest.to_int()
    if v < 0 || v > 30 { return -1 }
    return v
}

// Parse a scalar FP register name "d0".."d31" (double-precision Vn) to
// its index 0..31. Returns -1 for anything that is not a `d`-register, so
// the FP encoding cases can fall through cleanly on a GPR operand.
fn dreg_idx(s: string) -> i64 {
    let n = len(s)
    if n < 2 { return -1 }
    let head = s.substring(0, 1)
    if head != "D" && head != "d" { return -1 }
    let rest = s.substring(1, n)
    let v = rest.to_int()
    if v < 0 || v > 31 { return -1 }
    return v
}

// Parse "#42" or "#0x2a" (immediate operand) to i64.
fn imm_val(s: string) -> i64 {
    let n = len(s)
    if n < 2 { return 0 }
    if s.substring(0, 1) != "#" { return s.to_int() }
    return s.substring(1, n).to_int()
}

// Parse a MOVZ/MOVK immediate operand that may carry an optional shift:
// "#imm" or "#imm, lsl #N" (N ∈ {0,16,32,48}, emitted by arm64_darwin.hexa's
// >16-bit constant materializer). Returns [imm16, hw] where hw = N/16 (the
// ARM64 MOVZ/MOVK shift field, bits 22:21). Unshifted → hw 0. Without this the
// `, lsl #N` suffix reached imm_val→to_int ("trailing garbage") AND the shift
// was dropped from the encoding (wrong halfword for >16-bit constants).
fn _movw_imm_hw(operand: string) -> [i64] {
    let n = len(operand)
    let mut ci = 0 - 1
    let mut i = 0
    while i < n {
        if operand.substring(i, i + 1) == "," { ci = i; i = n } else { i = i + 1 }
    }
    if ci < 0 {
        let mut r0: [i64] = []
        r0.push(imm_val(operand) & 0xffff)
        r0.push(0)
        return r0
    }
    let imm = imm_val(operand.substring(0, ci)) & 0xffff
    let mut hi = 0 - 1
    let mut j = ci
    while j < n {
        if operand.substring(j, j + 1) == "#" { hi = j; j = n } else { j = j + 1 }
    }
    let mut hw = 0
    if hi >= 0 { hw = operand.substring(hi + 1, n).to_int() / 16 }
    let mut r: [i64] = []
    r.push(imm)
    r.push(hw)
    return r
}

// fn encode_arm64_insn(op: string, ops: [string]) -> i64
//
// Returns the 32-bit arm64 instruction word for `op` + `ops`.
// Each rule below mirrors a fixed arm64 encoding from ARM ARM
// (DDI 0487). All forms are 64-bit (sf=1) — the LIR subset emitted
// by `compiler/codegen/arm64_darwin.hexa` is uniformly 64-bit.
//
// On unknown op, returns 0 (caller should treat 0 = NOP-like as an
// encoding-failure marker, since real NOP is encoded as 0xd503201f).
//
// RFC 063 § P0 step 1 — first 16 rules landed (the LIR subset that
// `compiler/emit/asm.hexa` emits today as `.s` text). Symbol-
// relative forms (ADRP + ADD/LDR pair) are emitted as bare bits;
// the relocation record carries the symbol identity, the linker
// patches the bits.
// Encode a 64-bit logical immediate into the ARM ARM N:immr:imms field
// (13 bits: N at bit 22 once OR'd by caller, immr 6 bits, imms 6 bits).
// Returns -1 if `val` is not a legal bitmask immediate (caller must then
// materialize the constant some other way). Algorithm per the DDI 0487
// "DecodeBitMasks" inverse: find the smallest power-of-two element size
// `esize` whose value repeats across 64 bits, require the element to be a
// single contiguous run of `ones` set bits (rotated by `rot`), then encode
// N = (esize==64), imms carries (ones-1) packed under a NOT-mask selecting
// the element size, immr = rot.
//
// Returns the combined `(N<<12) | (immr<<6) | imms` (13-bit) value, or -1.
fn _logical_imm64(val: i64) -> i64 {
    // 0 and all-ones are NOT encodable as a logical immediate.
    if val == 0 { return -1 }
    if val == -1 { return -1 }
    // Try each element size 2,4,8,16,32,64.
    let mut size = 2
    while size <= 64 {
        // Check `val` is `size`-periodic: every `size`-bit chunk equal.
        let mut periodic = true
        let mask = if size == 64 { -1 } else { (1 << size) - 1 }
        let elem = val & mask
        let mut sh = size
        while sh < 64 {
            if ((val >> sh) & mask) != elem { periodic = false; sh = 64 } else { sh = sh + size }
        }
        if periodic {
            // elem must be a rotated run of 1s within `size` bits. Count
            // the ones; reject 0 / all-ones (not encodable at this size).
            let mut ones = 0
            let mut b = 0
            while b < size {
                if ((elem >> b) & 1) == 1 { ones = ones + 1 }
                b = b + 1
            }
            if ones != 0 && ones != size {
                // Find rotation: the canonical (un-rotated) pattern is
                // `ones` low set bits = (1<<ones)-1. Determine `rot` such
                // that ROR(canonical, rot) == elem over `size` bits.
                let canon = (1 << ones) - 1
                let mut rot = 0
                let mut found_rot = 0
                let mut found = false
                while rot < size {
                    // ROR canon right by `rot` within `size` bits. rot==0
                    // is identity (avoids the `<< size` shift-width UB the
                    // generic branch would hit at size==64).
                    let mut rored = canon & mask
                    if rot != 0 {
                        let lo = (canon >> rot) & mask
                        let hi = (canon << (size - rot)) & mask
                        rored = (lo | hi) & mask
                    }
                    // Save the rotation BEFORE the loop-break: `rot = size`
                    // is only the sentinel that ends the search; reading
                    // `rot` afterward yields `size` (immr = size & 0x3f =
                    // 0 or 32), silently dropping the rotation for any
                    // non-zero-rotated bitmask. found_rot preserves it.
                    if rored == elem { found = true; found_rot = rot; rot = size } else { rot = rot + 1 }
                }
                if found {
                    // immr = rot. imms = ((-(size) << 1) & 0x3f) | (ones-1)
                    // encodes element size in the high bits (NOT-mask) per
                    // the ARM ARM: imms = (NOT(size-1) ... ) — concretely
                    // imms bits set so that the leading-ones run identifies
                    // `size`, low bits = ones-1.
                    let n_bit = if size == 64 { 1 } else { 0 }
                    // imms: high bits = ~(size_log2 mask). Build per spec:
                    // for size s, the field is (128 - 2*s) low 6 bits with
                    // (ones-1) OR'd in (only valid because runs are <size).
                    let imms = ((0 - (size << 1)) & 0x3f) | ((ones - 1) & 0x3f)
                    let immr = found_rot & 0x3f
                    return (n_bit << 12) | (immr << 6) | (imms & 0x3f)
                }
            }
        }
        size = size * 2
    }
    return -1
}

fn encode_arm64_insn(op: string, ops: [string]) -> i64 {
    // ── Move ──
    // MOVZ Xd, #imm16  (zero-extend; canonical 16-bit immediate move).
    // The shifted variant `MOVZ Xd, #imm16, lsl #N` (N ∈ {0,16,32,48})
    // sets bits 22:21 = N/16; LIR may emit it as the 4th operand "lsl"
    // + 5th operand "#N" but cycle 7 ships the unshifted form only.
    // MOVK Xd, #imm16 (keep — OR the immediate, preserves others).
    if (op == "MOVZ" || op == "MOVK") && len(ops) == 2 && ops[1].substring(0, 1) == "#" {
        let rd = xreg_idx(ops[0])
        // Operand is "#imm" OR the shifted form "#imm, lsl #N" (N∈{0,16,32,48}).
        // _movw_imm_hw splits off the shift → hw (bits 22:21). The >16-bit
        // constant materializer (arm64_darwin.hexa) relies on these MOVK shifts.
        let parsed = _movw_imm_hw(ops[1])
        let imm = parsed[0]
        let hw = parsed[1]
        let mut base = 0xd2800000      // MOVZ
        if op == "MOVK" { base = 0xf2800000 }   // MOVK
        return base | (hw << 21) | (imm << 5) | rd
    }
    // MOV Xd, #imm16  (legacy alias — `MOV Xd, #imm` is a MOVZ alias
    // when the immediate fits 16 bits with no shift).
    if op == "MOV" && len(ops) == 2 && ops[1].substring(0, 1) == "#" {
        let rd = xreg_idx(ops[0])
        let imm = imm_val(ops[1]) & 0xffff
        return 0xd2800000 | (imm << 5) | rd
    }
    // MOV Xd, Xn. Two sub-cases per ARM ARM (C6.2.187):
    //   - `MOV Xd, SP` or `MOV SP, Xn` → alias for `ADD Xd, Xn, #0`
    //     (because the ORR alias treats Rm=31 as XZR, not SP).
    //   - Otherwise → alias for `ORR Xd, XZR, Xn`.
    // Detect SP either via the source string or via the destination —
    // when either side is "sp"/"SP", route through the ADD form.
    if op == "MOV" && len(ops) == 2 {
        let rd = xreg_idx(ops[0])
        let rn = xreg_idx(ops[1])
        let dst_is_sp = ops[0] == "sp" || ops[0] == "SP"
        let src_is_sp = ops[1] == "sp" || ops[1] == "SP"
        if dst_is_sp || src_is_sp {
            // ADD Xd, Xn, #0  (Rn=31 here means SP, not XZR)
            return 0x91000000 | (rn << 5) | rd
        }
        return 0xaa0003e0 | (rn << 16) | rd
    }

    // ── Arithmetic, register form ──
    // ADD Xd, Xn, Xm
    if op == "ADD" && len(ops) == 3 && ops[2].substring(0, 1) != "#" {
        let rd = xreg_idx(ops[0])
        let rn = xreg_idx(ops[1])
        let rm = xreg_idx(ops[2])
        // SHIFTED-register form (0x8b000000) encodes reg 31 as XZR, so it
        // CANNOT name SP. When Rd or Rn is SP, emit the EXTENDED-register
        // form (0x8b206000, option=UXTX=011 at bits 15:13, imm3=0) where
        // reg 31 = SP. (Rm=31 stays XZR in both forms — correct for the
        // `add x15, sp, x15` frame-base materializer in arm64_darwin.hexa.)
        let add_dst_sp = ops[0] == "sp" || ops[0] == "SP"
        let add_src_sp = ops[1] == "sp" || ops[1] == "SP"
        if add_dst_sp || add_src_sp {
            return 0x8b206000 | (rm << 16) | (rn << 5) | rd
        }
        return 0x8b000000 | (rm << 16) | (rn << 5) | rd
    }
    // ADD Xd, Xn, #imm12
    if op == "ADD" && len(ops) == 3 {
        let rd = xreg_idx(ops[0])
        let rn = xreg_idx(ops[1])
        let imm = imm_val(ops[2]) & 0xfff
        return 0x91000000 | (imm << 10) | (rn << 5) | rd
    }
    // SUB Xd, Xn, Xm
    if op == "SUB" && len(ops) == 3 && ops[2].substring(0, 1) != "#" {
        let rd = xreg_idx(ops[0])
        let rn = xreg_idx(ops[1])
        let rm = xreg_idx(ops[2])
        // Same SP-vs-XZR rule as ADD: SUB extended-register (0xcb206000,
        // UXTX, imm3=0) when Rd or Rn is SP, else shifted-register.
        let sub_dst_sp = ops[0] == "sp" || ops[0] == "SP"
        let sub_src_sp = ops[1] == "sp" || ops[1] == "SP"
        if sub_dst_sp || sub_src_sp {
            return 0xcb206000 | (rm << 16) | (rn << 5) | rd
        }
        return 0xcb000000 | (rm << 16) | (rn << 5) | rd
    }
    // SUB Xd, Xn, #imm12
    if op == "SUB" && len(ops) == 3 {
        let rd = xreg_idx(ops[0])
        let rn = xreg_idx(ops[1])
        let imm = imm_val(ops[2]) & 0xfff
        return 0xd1000000 | (imm << 10) | (rn << 5) | rd
    }
    // MUL Xd, Xn, Xm  (alias for MADD Xd, Xn, Xm, XZR)
    if op == "MUL" && len(ops) == 3 {
        let rd = xreg_idx(ops[0])
        let rn = xreg_idx(ops[1])
        let rm = xreg_idx(ops[2])
        return 0x9b007c00 | (rm << 16) | (rn << 5) | rd
    }

    // ── Scalar double-precision FP (RT-NATIVE UNLOCK-4) ──
    // Encodings verified byte-identical against clang `otool -tvVj`:
    //   fmov d0,x1=9e670020 · fmov x1,d0=9e660001 · fadd d0,d0,d1=1e612800
    //   fsub=1e613800 · fmul=1e610800 · fdiv=1e611800 · fcmp d0,d1=1e612000.
    // FMOV Dd, Xn  (GPR→FP bit-copy, 64-bit) — ops[0]=d-reg, ops[1]=x-reg.
    if op == "FMOV" && len(ops) == 2 {
        let d0 = dreg_idx(ops[0])
        let d1 = dreg_idx(ops[1])
        if d0 >= 0 && d1 < 0 {
            let xn = xreg_idx(ops[1])
            return 0x9e670000 | (xn << 5) | d0
        }
        // FMOV Xd, Dn  (FP→GPR bit-copy, 64-bit) — ops[0]=x-reg, ops[1]=d-reg.
        if d0 < 0 && d1 >= 0 {
            let xd = xreg_idx(ops[0])
            return 0x9e660000 | (d1 << 5) | xd
        }
    }
    // FADD/FSUB/FMUL/FDIV Dd, Dn, Dm
    if (op == "FADD" || op == "FSUB" || op == "FMUL" || op == "FDIV")
        && len(ops) == 3 {
        let rd = dreg_idx(ops[0])
        let rn = dreg_idx(ops[1])
        let rm = dreg_idx(ops[2])
        let mut base = 0x1e602800   // FADD
        if op == "FSUB" { base = 0x1e603800 }
        if op == "FMUL" { base = 0x1e600800 }
        if op == "FDIV" { base = 0x1e601800 }
        return base | (rm << 16) | (rn << 5) | rd
    }
    // FCMP Dn, Dm  (sets NZCV; opcode2 = 00000)
    if op == "FCMP" && len(ops) == 2 {
        let rn = dreg_idx(ops[0])
        let rm = dreg_idx(ops[1])
        if rn >= 0 && rm >= 0 {
            return 0x1e602000 | (rm << 16) | (rn << 5)
        }
    }
    // SCVTF Dd, Xn  (signed int64 → double; RT-NATIVE UNLOCK-6).
    // Verified vs clang: scvtf d0,x1 = 9e620020. base 9e620000 | (Xn<<5) | Dd.
    if op == "SCVTF" && len(ops) == 2 {
        let rd = dreg_idx(ops[0])
        let rn = xreg_idx(ops[1])
        if rd >= 0 && rn >= 0 {
            return 0x9e620000 | (rn << 5) | rd
        }
    }

    // FCVTZS Xd, Dn  (double → signed int64, round-toward-zero; `int(f)` lowering).
    // ARM ARM C7.2 FCVTZS scalar-integer double→X: sf=1 ftype=01 rmode=11 opcode=000
    // → base 0x9e780000 | (Dn<<5) | Xd. The structural mirror of SCVTF above (the
    // codegen emits `fcvtzs x1, d0` at arm64_darwin.hexa:4003 for __hx_payload_f2i);
    // without this arm any arm64 own-emit `int(float)` hit the unknown-op ENCODE-MISS.
    if op == "FCVTZS" && len(ops) == 2 {
        let rd = xreg_idx(ops[0])
        let rn = dreg_idx(ops[1])
        if rd >= 0 && rn >= 0 {
            return 0x9e780000 | (rn << 5) | rd
        }
    }

    // ── Compare (SUBS XZR, ...) ──
    // CMP Xn, Xm
    if op == "CMP" && len(ops) == 2 && ops[1].substring(0, 1) != "#" {
        let rn = xreg_idx(ops[0])
        let rm = xreg_idx(ops[1])
        return 0xeb00001f | (rm << 16) | (rn << 5)
    }
    // CMP Xn, #imm12
    if op == "CMP" && len(ops) == 2 {
        let rn = xreg_idx(ops[0])
        let imm = imm_val(ops[1]) & 0xfff
        return 0xf100001f | (imm << 10) | (rn << 5)
    }

    // ── Memory (LDR/STR with `[Xn]` or `[Xn, #imm12]` mem operand) ──
    // The mem operand is parsed by `_parse_mem_op` into [base_idx,
    // offset]. The 64-bit form uses a SCALED imm12: encoded value =
    // offset / 8 (so the range is 0..32760 in 8-byte steps).
    //
    // LDR Xt, [Xn{, #imm}]
    // LDR Wt, [Xn{, #imm}]  (32-bit load, zero-extends; RT-NATIVE UNLOCK-7).
    // Needed for 32-bit struct fields (e.g. HexaArr `int len`/`int cap`).
    // 32-bit form scales the imm12 by 4 (not 8). Verified vs clang:
    // ldr w1,[x1,#8]=b9400821 · w0,[x3]=b9400060 · w5,[x6,#12]=b9400cc5.
    if op == "LDR" && len(ops) == 2 && (ops[0].substring(0, 1) == "w"
        || ops[0].substring(0, 1) == "W") {
        let nm = ops[0]
        let nn = len(nm)
        let mut rt = -1
        let rv = nm.substring(1, nn).to_int()
        if rv >= 0 && rv <= 30 { rt = rv }
        if nm == "wzr" || nm == "WZR" { rt = 31 }
        let mp = _parse_mem_op(ops[1])
        if rt >= 0 && mp[0] < 0 {
            let rn = xreg_idx(ops[1])
            return 0xb9400000 | (rn << 5) | rt
        }
        if rt >= 0 {
            let rn = mp[0]
            let imm = (mp[1] >> 2) & 0xfff    // scaled imm12, 32-bit form (/4)
            return 0xb9400000 | (imm << 10) | (rn << 5) | rt
        }
    }
    if op == "LDR" && len(ops) == 2 {
        let rt = xreg_idx(ops[0])
        let mp = _parse_mem_op(ops[1])
        if mp[0] < 0 {
            // Treat as `[Xn]` bare (no `[`) — fall back to the original
            // path so legacy 2-string callers (no parens) still work.
            let rn = xreg_idx(ops[1])
            return 0xf9400000 | (rn << 5) | rt
        }
        let rn = mp[0]
        let imm = (mp[1] >> 3) & 0xfff       // scaled imm12, 64-bit form
        return 0xf9400000 | (imm << 10) | (rn << 5) | rt
    }
    // STR Xt, [Xn{, #imm}]
    // STR Wt, [Xn{, #imm}]  (32-bit store; RT-NATIVE UNLOCK-11). Needed to
    // write 32-bit struct fields (HexaArr/HexaMap `int len`/`int cap`) into an
    // arena slab. 32-bit form scales imm12 by 4. Verified vs clang:
    // str w3,[x1]=b9000023 · w3,[x1,#8]=b9000823 · w5,[x6,#12]=b9000cc5.
    if op == "STR" && len(ops) == 2 && (ops[0].substring(0, 1) == "w"
        || ops[0].substring(0, 1) == "W") {
        let nm = ops[0]
        let nn = len(nm)
        let mut rt = -1
        let rv = nm.substring(1, nn).to_int()
        if rv >= 0 && rv <= 30 { rt = rv }
        if nm == "wzr" || nm == "WZR" { rt = 31 }
        let mp = _parse_mem_op(ops[1])
        if rt >= 0 && mp[0] < 0 {
            let rn = xreg_idx(ops[1])
            return 0xb9000000 | (rn << 5) | rt
        }
        if rt >= 0 {
            let rn = mp[0]
            let imm = (mp[1] >> 2) & 0xfff    // scaled imm12, 32-bit form (/4)
            return 0xb9000000 | (imm << 10) | (rn << 5) | rt
        }
    }
    if op == "STR" && len(ops) == 2 {
        let rt = xreg_idx(ops[0])
        let mp = _parse_mem_op(ops[1])
        if mp[0] < 0 {
            let rn = xreg_idx(ops[1])
            return 0xf9000000 | (rn << 5) | rt
        }
        let rn = mp[0]
        let imm = (mp[1] >> 3) & 0xfff
        return 0xf9000000 | (imm << 10) | (rn << 5) | rt
    }
    // LDRB Wt, [Xn{, #imm}]  (RT-NATIVE UNLOCK-5: byte load for string
    // leaves).  The byte form uses an UNSCALED imm12 (0..4095 bytes), and
    // the destination is a W-register (same 5-bit number as Xt). Encoding
    // verified vs clang: ldrb w0,[x1]=39400020 · [x1,#1]=39400420 ·
    // w2,[x3,#15]=39403c62.  base 0x39400000 | (imm<<10) | (Rn<<5) | Rt.
    if op == "LDRB" && len(ops) == 2 {
        // Accept "wN"/"xN" for the destination (same register field).
        let dn = ops[0]
        let ndn = len(dn)
        let mut rt = -1
        if ndn >= 2 && (dn.substring(0, 1) == "w" || dn.substring(0, 1) == "W") {
            let rv = dn.substring(1, ndn).to_int()
            if rv >= 0 && rv <= 30 { rt = rv }
            if dn == "wzr" || dn == "WZR" { rt = 31 }
        } else {
            rt = xreg_idx(dn)
        }
        let mp = _parse_mem_op(ops[1])
        if rt >= 0 && mp[0] < 0 {
            let rn = xreg_idx(ops[1])
            return 0x39400000 | (rn << 5) | rt
        }
        if rt >= 0 {
            let rn = mp[0]
            let imm = mp[1] & 0xfff       // UNSCALED imm12 (byte form)
            return 0x39400000 | (imm << 10) | (rn << 5) | rt
        }
    }
    // STRB Wt, [Xn{, #imm}]  (RT-NATIVE M4 PTR8: byte store for the raw-mem
    // byte-write leaf __hx_ptr_store8).  Same shape as LDRB but the store
    // base opcode 0x39000000 (vs load 0x39400000).  Verified vs GNU as:
    // strb w5,[x1]=39000025 · strb w0,[x1,#1]=39000420.
    if op == "STRB" && len(ops) == 2 {
        let dn = ops[0]
        let ndn = len(dn)
        let mut rt = -1
        if ndn >= 2 && (dn.substring(0, 1) == "w" || dn.substring(0, 1) == "W") {
            let rv = dn.substring(1, ndn).to_int()
            if rv >= 0 && rv <= 30 { rt = rv }
            if dn == "wzr" || dn == "WZR" { rt = 31 }
        } else {
            rt = xreg_idx(dn)
        }
        let mp = _parse_mem_op(ops[1])
        if rt >= 0 && mp[0] < 0 {
            let rn = xreg_idx(ops[1])
            return 0x39000000 | (rn << 5) | rt
        }
        if rt >= 0 {
            let rn = mp[0]
            let imm = mp[1] & 0xfff       // UNSCALED imm12 (byte form)
            return 0x39000000 | (imm << 10) | (rn << 5) | rt
        }
    }
    // ── Stack-pair (STP/LDP) — 3 mem modes (offset / pre-index /
    //    post-index) for 64-bit GPRs. Per ARM ARM C6.2.273-:
    //
    //    STP offset:     0xa9000000   `stp Xt, Xt2, [Xn, #imm]`
    //    STP pre-index:  0xa9800000   `stp Xt, Xt2, [Xn, #imm]!`
    //    STP post-index: 0xa8800000   `stp Xt, Xt2, [Xn], #imm`
    //    LDP offset:     0xa9400000
    //    LDP pre-index:  0xa9c00000
    //    LDP post-index: 0xa8c00000
    //
    // Signed imm7 in 8-byte steps (range -512..504). mode comes from
    // `_parse_mem_op` (0=offset, 1=pre, 2=post).
    if op == "STP" && len(ops) == 3 {
        let rt  = xreg_idx(ops[0])
        let rt2 = xreg_idx(ops[1])
        let mp  = _parse_mem_op(ops[2])
        if mp[0] < 0 { eprintln("ENCODE-MISS: " + op + " mem-parse-fail mem=" + ops[2]); return 0 }
        let rn   = mp[0]
        let imm  = (mp[1] >> 3) & 0x7f
        let mode = mp[2]
        let mut base = 0xa9000000           // offset
        if mode == 1 { base = 0xa9800000 }   // pre-index
        if mode == 2 { base = 0xa8800000 }   // post-index
        return base | (imm << 15) | (rt2 << 10) | (rn << 5) | rt
    }
    if op == "LDP" && len(ops) == 3 {
        let rt  = xreg_idx(ops[0])
        let rt2 = xreg_idx(ops[1])
        let mp  = _parse_mem_op(ops[2])
        if mp[0] < 0 { eprintln("ENCODE-MISS: " + op + " mem-parse-fail mem=" + ops[2]); return 0 }
        let rn   = mp[0]
        let imm  = (mp[1] >> 3) & 0x7f
        let mode = mp[2]
        let mut base = 0xa9400000           // offset
        if mode == 1 { base = 0xa9c00000 }   // pre-index
        if mode == 2 { base = 0xa8c00000 }   // post-index
        return base | (imm << 15) | (rt2 << 10) | (rn << 5) | rt
    }

    // ── Branches (bit-pattern only; imm26 / imm19 filled by reloc) ──
    // B label  — imm26 patched by ARM64_RELOC_BRANCH26 reloc
    if op == "B" && len(ops) == 1 { return 0x14000000 }
    // BL label
    if op == "BL" && len(ops) == 1 { return 0x94000000 }
    // RET (= RET X30)
    if op == "RET" && len(ops) == 0 { return 0xd65f03c0 }
    // NOP — hint #0 (RFC inline-asm rung 1 `__hx_asm_nop`). 0-operand; shared by
    // the arm64-linux ELF backend (encode_arm64_insn is reused). Additive/dead by
    // default (no existing arm64 emit uses `nop`) → byteeq-safe.
    if op == "NOP" && len(ops) == 0 { return 0xd503201f }
    // YIELD — hint #1 (RFC inline-asm rung 2 `__hx_asm("pause")`; the AArch64
    // spin-loop hint, the arm64 analogue of x86 PAUSE). 0-operand; shared by the
    // arm64-linux ELF backend. Additive/dead by default → byteeq-safe.
    if op == "YIELD" && len(ops) == 0 { return 0xd503203f }
    // DMB ish — data memory barrier, inner-shareable (RFC inline-asm rung 2
    // `__hx_asm("fence")`; CRm=0b1011=11). Encodes `dmb ish` regardless of the
    // (whitelisted `#11`) operand text. Additive/dead by default → byteeq-safe.
    if op == "DMB" { return 0xd5033bbf }
    // SVC #imm16 — supervisor call (Linux AArch64 syscall trap). The
    // imm16 is bits [20:5]; Linux uses `svc #0`. SELFHOST-NEXT freestanding
    // `_start` exit(N) sequence: `mov x8,#93 ; mov x0,#N ; svc #0`.
    if op == "SVC" {
        let imm = if len(ops) == 1 { imm_val(ops[0]) & 0xffff } else { 0 }
        return 0xd4000001 | (imm << 5)
    }

    // ── Conditional branch (B.cond label) ──
    // op is "B.EQ" / "B.NE" / "B.LT" / "B.GE" / "B.GT" / "B.LE" etc.
    if len(op) > 2 && op.substring(0, 2) == "B." && len(ops) == 1 {
        let cc = op.substring(2, len(op))
        let mut c = -1
        if cc == "EQ" { c = 0  } else if cc == "NE" { c = 1  }
        else if cc == "CS" { c = 2  } else if cc == "CC" { c = 3  }
        else if cc == "MI" { c = 4  } else if cc == "PL" { c = 5  }
        else if cc == "VS" { c = 6  } else if cc == "VC" { c = 7  }
        else if cc == "HI" { c = 8  } else if cc == "LS" { c = 9  }
        else if cc == "GE" { c = 10 } else if cc == "LT" { c = 11 }
        else if cc == "GT" { c = 12 } else if cc == "LE" { c = 13 }
        else if cc == "AL" { c = 14 }
        if c >= 0 { return 0x54000000 | c }
    }

    // ── CSET Xd, <cond>  (RT-NATIVE UNLOCK-4) ──
    // CSET is an alias for `CSINC Xd, XZR, XZR, invert(cond)`. The
    // condition operand arrives lowercase ("eq"/"lt"/"mi"/…). The
    // self-host obj path previously had NO CSET case → it fell through to
    // 0 (the udf #0 hole), so the comparison/bool intrinsics only worked
    // via the clang-asm route. Encoding verified byte-identical against
    // clang `otool`: cset x0,eq=9a9f17e0 · lt=9a9fa7e0 · mi=9a9f57e0 ·
    // ls=9a9f87e0. base 0x9a9f07e0 (Rm=Rn=XZR) | (cond^1)<<12 | Rd.
    if op == "CSET" && len(ops) == 2 {
        let rd = xreg_idx(ops[0])
        let cc = ops[1]
        let mut c = -1
        if cc == "eq" { c = 0  } else if cc == "ne" { c = 1  }
        else if cc == "cs" { c = 2  } else if cc == "cc" { c = 3  }
        else if cc == "mi" { c = 4  } else if cc == "pl" { c = 5  }
        else if cc == "vs" { c = 6  } else if cc == "vc" { c = 7  }
        else if cc == "hi" { c = 8  } else if cc == "ls" { c = 9  }
        else if cc == "ge" { c = 10 } else if cc == "lt" { c = 11 }
        else if cc == "gt" { c = 12 } else if cc == "le" { c = 13 }
        if c >= 0 && rd >= 0 {
            // invert(cond) = flip the low bit (EQ↔NE, LT↔GE, MI↔PL, …).
            let mut cinv = c + 1
            if c % 2 == 1 { cinv = c - 1 }
            return 0x9a9f07e0 | (cinv << 12) | rd
        }
    }

    // ── CSEL Xd, Xn, Xm, <cond>  (RT-NATIVE UNLOCK-6) ──
    // Branchless select: Xd = cond ? Xn : Xm.  Condition is used DIRECTLY
    // (NOT inverted, unlike CSET).  Verified vs clang: csel x1,x1,x2,eq =
    // 9a820021 · x5,x6,x7,ne = 9a8710c5.  base 0x9a800000 | (Rm<<16) |
    // (cond<<12) | (Rn<<5) | Rd.
    if op == "CSEL" && len(ops) == 4 {
        let rd = xreg_idx(ops[0])
        let rn = xreg_idx(ops[1])
        let rm = xreg_idx(ops[2])
        let cc = ops[3]
        let mut c = -1
        if cc == "eq" { c = 0  } else if cc == "ne" { c = 1  }
        else if cc == "cs" { c = 2  } else if cc == "cc" { c = 3  }
        else if cc == "mi" { c = 4  } else if cc == "pl" { c = 5  }
        else if cc == "vs" { c = 6  } else if cc == "vc" { c = 7  }
        else if cc == "hi" { c = 8  } else if cc == "ls" { c = 9  }
        else if cc == "ge" { c = 10 } else if cc == "lt" { c = 11 }
        else if cc == "gt" { c = 12 } else if cc == "le" { c = 13 }
        if c >= 0 && rd >= 0 && rn >= 0 && rm >= 0 {
            return 0x9a800000 | (rm << 16) | (c << 12) | (rn << 5) | rd
        }
    }

    // ── Bitfield / extension aliases (UBFM-family) ──
    // UBFM Xd, Xn, #immr, #imms   (64-bit, sf=1, opc=10, N=1)
    //   0xd3400000 | (immr<<16) | (imms<<10) | (rn<<5) | rd
    // UXTW Xd, Wn  is an alias for UBFM Xd, Xn, #0, #31  (zero-extend
    // the low 32 bits, clear the upper). codegen uses it to widen
    // 32-bit values to the 64-bit ABI slot.
    if op == "UXTW" && len(ops) == 2 {
        let rd = xreg_idx(ops[0])
        // Wn shares the same register-number encoding as Xn (low 5 bits).
        // Accept both "wN" and "xN" form.
        let nm = ops[1]
        let mut rn = -1
        let nn = len(nm)
        if nn >= 2 && (nm.substring(0, 1) == "w" || nm.substring(0, 1) == "W") {
            let rest = nm.substring(1, nn).to_int()
            if rest >= 0 && rest <= 30 { rn = rest }
            if nm == "wzr" || nm == "WZR" { rn = 31 }
        } else {
            rn = xreg_idx(nm)
        }
        if rd >= 0 && rn >= 0 {
            return 0xd3400000 | (0 << 16) | (31 << 10) | (rn << 5) | rd
        }
    }
    // UXTB Xd, Wn  →  UBFM Xd, Xn, #0, #7
    if op == "UXTB" && len(ops) == 2 {
        let rd = xreg_idx(ops[0])
        let nm = ops[1]
        let nn = len(nm)
        let mut rn = -1
        if nn >= 2 && (nm.substring(0, 1) == "w" || nm.substring(0, 1) == "W") {
            let rest = nm.substring(1, nn).to_int()
            if rest >= 0 && rest <= 30 { rn = rest }
        } else { rn = xreg_idx(nm) }
        if rd >= 0 && rn >= 0 {
            return 0xd3400000 | (0 << 16) | (7 << 10) | (rn << 5) | rd
        }
    }
    // UXTH Xd, Wn  →  UBFM Xd, Xn, #0, #15
    if op == "UXTH" && len(ops) == 2 {
        let rd = xreg_idx(ops[0])
        let nm = ops[1]
        let nn = len(nm)
        let mut rn = -1
        if nn >= 2 && (nm.substring(0, 1) == "w" || nm.substring(0, 1) == "W") {
            let rest = nm.substring(1, nn).to_int()
            if rest >= 0 && rest <= 30 { rn = rest }
        } else { rn = xreg_idx(nm) }
        if rd >= 0 && rn >= 0 {
            return 0xd3400000 | (0 << 16) | (15 << 10) | (rn << 5) | rd
        }
    }
    // SXTW Xd, Wn  →  SBFM Xd, Xn, #0, #31   (opc=00 base 0x93400000)
    if op == "SXTW" && len(ops) == 2 {
        let rd = xreg_idx(ops[0])
        let nm = ops[1]
        let nn = len(nm)
        let mut rn = -1
        if nn >= 2 && (nm.substring(0, 1) == "w" || nm.substring(0, 1) == "W") {
            let rest = nm.substring(1, nn).to_int()
            if rest >= 0 && rest <= 30 { rn = rest }
        } else { rn = xreg_idx(nm) }
        if rd >= 0 && rn >= 0 {
            return 0x93400000 | (0 << 16) | (31 << 10) | (rn << 5) | rd
        }
    }

    // ── Compare and branch (zero / non-zero) ──
    // CBZ Xt, label  — imm19 patched by reloc
    if op == "CBZ" && len(ops) == 2 {
        let rt = xreg_idx(ops[0])
        return 0xb4000000 | rt
    }
    // CBNZ Xt, label
    if op == "CBNZ" && len(ops) == 2 {
        let rt = xreg_idx(ops[0])
        return 0xb5000000 | rt
    }

    // ── PC-relative page address (ADRP Xd, sym@PAGE) ──
    // imm field (immhi:immlo) is patched by an ARM64_RELOC_PAGE21 reloc
    // that the walker emits for the `@PAGE` label operand; the encoder
    // returns the bare base word. Base: 1 immlo 10000 immhi(19) Rd =
    // 0x90000000 | Rd. (ADR, no `p`, would be 0x10000000 — codegen uses
    // ADRP exclusively for symbol page loads.)
    if op == "ADRP" && len(ops) == 2 {
        let rd = xreg_idx(ops[0])
        if rd >= 0 { return 0x90000000 | rd }
    }

    // ── Logical, register form (shifted-register, shift=0) ──
    // AND Xd, Xn, Xm   0x8a000000
    if op == "AND" && len(ops) == 3 && ops[2].substring(0, 1) != "#" {
        let rd = xreg_idx(ops[0])
        let rn = xreg_idx(ops[1])
        let rm = xreg_idx(ops[2])
        return 0x8a000000 | (rm << 16) | (rn << 5) | rd
    }
    // ORR Xd, Xn, Xm   0xaa000000
    if op == "ORR" && len(ops) == 3 && ops[2].substring(0, 1) != "#" {
        let rd = xreg_idx(ops[0])
        let rn = xreg_idx(ops[1])
        let rm = xreg_idx(ops[2])
        return 0xaa000000 | (rm << 16) | (rn << 5) | rd
    }
    // EOR Xd, Xn, Xm   0xca000000
    if op == "EOR" && len(ops) == 3 && ops[2].substring(0, 1) != "#" {
        let rd = xreg_idx(ops[0])
        let rn = xreg_idx(ops[1])
        let rm = xreg_idx(ops[2])
        return 0xca000000 | (rm << 16) | (rn << 5) | rd
    }
    // ORN Xd, Xn, Xm   0xaa200000 (ORR with bit-21 N=1)
    if op == "ORN" && len(ops) == 3 && ops[2].substring(0, 1) != "#" {
        let rd = xreg_idx(ops[0])
        let rn = xreg_idx(ops[1])
        let rm = xreg_idx(ops[2])
        return 0xaa200000 | (rm << 16) | (rn << 5) | rd
    }

    // ── Logical, immediate form (bitmask) ──
    // AND Xd, Xn, #imm  0x92000000 ; ORR 0xb2000000 ; EOR 0xd2000000.
    // The N:immr:imms field comes from _logical_imm64; -1 = not a legal
    // bitmask immediate (codegen should have materialized it instead).
    if (op == "AND" || op == "ORR" || op == "EOR") && len(ops) == 3 && ops[2].substring(0, 1) == "#" {
        let rd = xreg_idx(ops[0])
        let rn = xreg_idx(ops[1])
        let li = _logical_imm64(imm_val(ops[2]))
        if li >= 0 {
            let mut base = 0x92000000          // AND
            if op == "ORR" { base = 0xb2000000 }
            if op == "EOR" { base = 0xd2000000 }
            let n_immr_imms = li & 0x1fff
            return base | (n_immr_imms << 10) | (rn << 5) | rd
        }
    }

    // ── MVN Xd, Xm  (alias for ORN Xd, XZR, Xm; Rn=31) ──
    if op == "MVN" && len(ops) == 2 {
        let rd = xreg_idx(ops[0])
        let rm = xreg_idx(ops[1])
        if rd >= 0 && rm >= 0 { return 0xaa2003e0 | (rm << 16) | rd }
    }

    // ── Variable shift (register amount): LSLV/LSRV/ASRV ──
    // codegen emits `lsl Xd,Xn,Xm` (3 reg ops) → the variable-shift form.
    // LSLV 0x9ac02000 | LSRV 0x9ac02400 | ASRV 0x9ac02800 (Rm<<16,Rn<<5,Rd).
    if (op == "LSL" || op == "LSLV") && len(ops) == 3 && ops[2].substring(0, 1) != "#" {
        let rd = xreg_idx(ops[0])
        let rn = xreg_idx(ops[1])
        let rm = xreg_idx(ops[2])
        return 0x9ac02000 | (rm << 16) | (rn << 5) | rd
    }
    if (op == "LSR" || op == "LSRV") && len(ops) == 3 && ops[2].substring(0, 1) != "#" {
        let rd = xreg_idx(ops[0])
        let rn = xreg_idx(ops[1])
        let rm = xreg_idx(ops[2])
        return 0x9ac02400 | (rm << 16) | (rn << 5) | rd
    }
    if (op == "ASR" || op == "ASRV") && len(ops) == 3 && ops[2].substring(0, 1) != "#" {
        let rd = xreg_idx(ops[0])
        let rn = xreg_idx(ops[1])
        let rm = xreg_idx(ops[2])
        return 0x9ac02800 | (rm << 16) | (rn << 5) | rd
    }
    // ── Immediate shift: LSL/LSR/ASR Xd, Xn, #sh (UBFM/SBFM aliases) ──
    // LSL #sh = UBFM Xd,Xn,#(-sh%64),#(63-sh) ; LSR #sh = UBFM Xd,Xn,#sh,#63 ;
    // ASR #sh = SBFM Xd,Xn,#sh,#63.
    if op == "LSL" && len(ops) == 3 && ops[2].substring(0, 1) == "#" {
        let rd = xreg_idx(ops[0])
        let rn = xreg_idx(ops[1])
        let sh = imm_val(ops[2]) & 0x3f
        let immr = (0 - sh) & 0x3f
        let imms = (63 - sh) & 0x3f
        return 0xd3400000 | (immr << 16) | (imms << 10) | (rn << 5) | rd
    }
    if op == "LSR" && len(ops) == 3 && ops[2].substring(0, 1) == "#" {
        let rd = xreg_idx(ops[0])
        let rn = xreg_idx(ops[1])
        let sh = imm_val(ops[2]) & 0x3f
        return 0xd3400000 | (sh << 16) | (63 << 10) | (rn << 5) | rd
    }
    if op == "ASR" && len(ops) == 3 && ops[2].substring(0, 1) == "#" {
        let rd = xreg_idx(ops[0])
        let rn = xreg_idx(ops[1])
        let sh = imm_val(ops[2]) & 0x3f
        return 0x93400000 | (sh << 16) | (63 << 10) | (rn << 5) | rd
    }

    // ── Indirect branch (register): BLR Xn / BR Xn ──
    // BLR (call) 0xd63f0000 | (Rn<<5) ; BR (tail/jump) 0xd61f0000.
    if op == "BLR" && len(ops) == 1 {
        let rn = xreg_idx(ops[0])
        if rn >= 0 { return 0xd63f0000 | (rn << 5) }
    }
    if op == "BR" && len(ops) == 1 {
        let rn = xreg_idx(ops[0])
        if rn >= 0 { return 0xd61f0000 | (rn << 5) }
    }

    // ── Division: SDIV / UDIV Xd, Xn, Xm ──
    // SDIV 0x9ac00c00 | UDIV 0x9ac00800 (Rm<<16, Rn<<5, Rd).
    if op == "SDIV" && len(ops) == 3 {
        let rd = xreg_idx(ops[0])
        let rn = xreg_idx(ops[1])
        let rm = xreg_idx(ops[2])
        return 0x9ac00c00 | (rm << 16) | (rn << 5) | rd
    }
    if op == "UDIV" && len(ops) == 3 {
        let rd = xreg_idx(ops[0])
        let rn = xreg_idx(ops[1])
        let rm = xreg_idx(ops[2])
        return 0x9ac00800 | (rm << 16) | (rn << 5) | rd
    }

    // Unknown op — caller checks for 0 as failure marker.
    let mut _miss = "ENCODE-MISS: unknown-op op=" + op + " ops=[ "
    let mut _mi = 0
    while _mi < len(ops) {
        _miss = _miss + ops[_mi] + " "
        _mi = _mi + 1
    }
    _miss = _miss + "]"
    eprintln(_miss)
    return 0
}

// ─────────────────────────────────────────────────────────────────
// Mach-O byte-level serializer — RFC 063 § P0, cycle 1
// ─────────────────────────────────────────────────────────────────
//
// `serialize(obj)` lays out the in-memory `MachoArm64Obj` into a flat
// `[Int]` byte stream suitable for `write_bytes(path, ...)`. Layout:
//
//   [ mach_header_64                                  ]   32 B
//   [ LC_SEGMENT_64 __TEXT (+ section_64 __text)      ]  152 B
//   [ LC_SYMTAB                                       ]   24 B
//   [ LC_DYSYMTAB                                     ]   80 B
//   [ __text bytes                                    ]   N B   (4-aligned)
//   [ relocation entries (Arm64Reloc records)         ]   8·R B
//   [ symbol table (nlist_64 records)                 ]  16·S B
//   [ string table                                    ]   T B
//
// For an empty object (cycle 1 falsifier) the trailing sections are
// 0 bytes and the file ends at offset 288 (header + 4 LCs).
//
// All fields are little-endian per Mach-O on darwin-arm64.

// Append little-endian u16 to `out`. Used for `nlist_64.n_desc` and
// other 2-byte Mach-O fields.
fn _u16_le(out: [Int], v: Int) {
    out.push(v & 0xff)
    out.push((v >> 8) & 0xff)
}

// Append little-endian u32 to `out` (low byte first). Caller passes
// already-masked value; we mask defensively (& 0xff per byte) so an
// `i64` with the upper 32 bits non-zero does not corrupt the stream.
fn _u32_le(out: [Int], v: Int) {
    out.push(v & 0xff)
    out.push((v >> 8) & 0xff)
    out.push((v >> 16) & 0xff)
    out.push((v >> 24) & 0xff)
}

// Append little-endian u64 to `out`. `v` is `Int` (i64 in hexa-lang);
// negative values are written as their two's-complement bit pattern.
fn _u64_le(out: [Int], v: Int) {
    out.push(v & 0xff)
    out.push((v >> 8) & 0xff)
    out.push((v >> 16) & 0xff)
    out.push((v >> 24) & 0xff)
    out.push((v >> 32) & 0xff)
    out.push((v >> 40) & 0xff)
    out.push((v >> 48) & 0xff)
    out.push((v >> 56) & 0xff)
}

// Append `n` zero bytes (used for fixed-size name fields, alignment
// padding, and the trailing reserved word in `mach_header_64`).
fn _zero_n(out: [Int], n: Int) {
    let mut i = 0
    while i < n {
        out.push(0)
        i = i + 1
    }
}

// Append the ASCII bytes of `s`, then zero-pad to total length `n`.
// Mach-O `segname` / `sectname` fields are exactly 16 bytes — names
// shorter than 16 are zero-filled, names longer than 16 are truncated
// (the Mach-O spec mandates 16-byte field, and the system tools rely
// on it).
fn _str_fixed(out: [Int], s: String, n: Int) {
    let slen = len(s)
    let mut i = 0
    while i < n {
        if i < slen {
            out.push(char_code(s, i) & 0xff)
        } else {
            out.push(0)
        }
        i = i + 1
    }
}

// Emit `mach_header_64` (32 bytes). Per `<mach-o/loader.h>`:
//
//     struct mach_header_64 {
//         uint32_t magic;        // MH_MAGIC_64 (0xfeedfacf)
//         uint32_t cputype;      // CPU_TYPE_ARM64 (0x0100000c)
//         uint32_t cpusubtype;   // CPU_SUBTYPE_ARM64_ALL (0)
//         uint32_t filetype;     // MH_OBJECT (1)
//         uint32_t ncmds;        // load-command count
//         uint32_t sizeofcmds;   // total LC bytes
//         uint32_t flags;        // MH_SUBSECTIONS_VIA_SYMBOLS (0x2000)
//         uint32_t reserved;     // 64-bit reserved word, always 0
//     };
fn _emit_mach_header(out: [Int], ncmds: Int, sizeofcmds: Int, flags: Int) {
    _u32_le(out, MACHO_MH_MAGIC_64)
    _u32_le(out, MACHO_CPU_TYPE_ARM64)
    _u32_le(out, MACHO_CPU_SUBTYPE_ARM64_ALL)
    _u32_le(out, MACHO_MH_OBJECT)
    _u32_le(out, ncmds)
    _u32_le(out, sizeofcmds)
    _u32_le(out, flags)
    _u32_le(out, 0)        // reserved
}

// Emit `LC_SEGMENT_64` load command without its section table.
// Per `<mach-o/loader.h>`:
//
//     struct segment_command_64 {
//         uint32_t cmd;          // LC_SEGMENT_64 (0x19)
//         uint32_t cmdsize;      // 72 + 80*nsects
//         char     segname[16];  // "" for MH_OBJECT (single unnamed seg)
//         uint64_t vmaddr;       // 0 (relocatable)
//         uint64_t vmsize;       // sum of section sizes
//         uint64_t fileoff;      // header_size + sizeofcmds
//         uint64_t filesize;     // same as vmsize for relocatable
//         int32_t  maxprot;      // VM_PROT_READ|WRITE|EXECUTE = 7
//         int32_t  initprot;     // same
//         uint32_t nsects;       // count of section_64 records that follow
//         uint32_t flags;        // 0
//     };
//
// Caller follows up with one `_emit_section_64` per section.
fn _emit_seg64_cmd(out: [Int],
                   segname: String,
                   vmaddr: Int, vmsize: Int,
                   fileoff: Int, filesize: Int,
                   nsects: Int) {
    let cmdsize = 72 + 80 * nsects
    _u32_le(out, MACHO_LC_SEGMENT_64)
    _u32_le(out, cmdsize)
    _str_fixed(out, segname, 16)
    _u64_le(out, vmaddr)
    _u64_le(out, vmsize)
    _u64_le(out, fileoff)
    _u64_le(out, filesize)
    _u32_le(out, 7)            // maxprot
    _u32_le(out, 7)            // initprot
    _u32_le(out, nsects)
    _u32_le(out, 0)            // flags
}

// Emit one `section_64` (80 bytes). Per `<mach-o/loader.h>`:
//
//     struct section_64 {
//         char     sectname[16];
//         char     segname[16];
//         uint64_t addr;
//         uint64_t size;
//         uint32_t offset;
//         uint32_t align;        // log2(byte alignment); 2 == 4-byte
//         uint32_t reloff;
//         uint32_t nreloc;
//         uint32_t flags;
//         uint32_t reserved1;
//         uint32_t reserved2;
//         uint32_t reserved3;
//     };
fn _emit_section_64(out: [Int],
                    sectname: String, segname: String,
                    addr: Int, size: Int,
                    offset: Int, align: Int,
                    reloff: Int, nreloc: Int,
                    flags: Int) {
    _str_fixed(out, sectname, 16)
    _str_fixed(out, segname, 16)
    _u64_le(out, addr)
    _u64_le(out, size)
    _u32_le(out, offset)
    _u32_le(out, align)
    _u32_le(out, reloff)
    _u32_le(out, nreloc)
    _u32_le(out, flags)
    _u32_le(out, 0)            // reserved1
    _u32_le(out, 0)            // reserved2
    _u32_le(out, 0)            // reserved3
}

// Emit `LC_BUILD_VERSION` (24 bytes, ntools=0). Per `<mach-o/loader.h>`:
//
//     struct build_version_command {
//         uint32_t cmd;        // LC_BUILD_VERSION (0x32)
//         uint32_t cmdsize;    // 24 + 8*ntools (== 24 here, ntools=0)
//         uint32_t platform;   // PLATFORM_MACOS (1)
//         uint32_t minos;      // X.Y.Z packed nibble-wise: 0xXXXXYYZZ
//         uint32_t sdk;        // 0 (n/a — clang emits 0 for `-c` w/o -isysroot)
//         uint32_t ntools;     // 0
//     };
//
// clang -c on darwin-arm64 always emits this LC; matching it is required
// for full-object parity (it sits between LC_SEGMENT_64 and LC_SYMTAB).
fn _emit_build_version_cmd(out: [Int], platform: Int, minos: Int) {
    _u32_le(out, MACHO_LC_BUILD_VERSION)
    _u32_le(out, 24)
    _u32_le(out, platform)
    _u32_le(out, minos)
    _u32_le(out, 0)            // sdk — n/a
    _u32_le(out, 0)            // ntools
}

// Emit `LC_SYMTAB` (24 bytes). Per `<mach-o/loader.h>`:
//
//     struct symtab_command {
//         uint32_t cmd;          // LC_SYMTAB (0x02)
//         uint32_t cmdsize;      // 24
//         uint32_t symoff;       // file offset of nlist_64[]
//         uint32_t nsyms;
//         uint32_t stroff;       // file offset of string table
//         uint32_t strsize;
//     };
fn _emit_symtab_cmd(out: [Int],
                    symoff: Int, nsyms: Int,
                    stroff: Int, strsize: Int) {
    _u32_le(out, MACHO_LC_SYMTAB)
    _u32_le(out, 24)
    _u32_le(out, symoff)
    _u32_le(out, nsyms)
    _u32_le(out, stroff)
    _u32_le(out, strsize)
}

// Emit `LC_DYSYMTAB` (80 bytes). Per `<mach-o/loader.h>`:
//
//     struct dysymtab_command {
//         uint32_t cmd;          // LC_DYSYMTAB (0x0b)
//         uint32_t cmdsize;      // 80
//         uint32_t ilocalsym;
//         uint32_t nlocalsym;
//         uint32_t iextdefsym;
//         uint32_t nextdefsym;
//         uint32_t iundefsym;
//         uint32_t nundefsym;
//         uint32_t tocoff;       uint32_t ntoc;
//         uint32_t modtaboff;    uint32_t nmodtab;
//         uint32_t extrefsymoff; uint32_t nextrefsyms;
//         uint32_t indirectsymoff; uint32_t nindirectsyms;
//         uint32_t extreloff;    uint32_t nextrel;
//         uint32_t locreloff;    uint32_t nlocrel;
//     };
//
// Symtab partition contract (clang -c parity): the nlist array is laid
// out as [ nlocalsym locals | nextdefsym defined-externs | nundefsym
// undefs ], in that order. DYSYMTAB records the index+count of each run.
// (was: only nextdefsym; pre-symtab-layout the table had no locals/undefs.)
fn _emit_dysymtab_cmd(out: [Int],
                      nlocalsym: Int,
                      iextdefsym: Int, nextdefsym: Int,
                      iundefsym: Int, nundefsym: Int) {
    _u32_le(out, MACHO_LC_DYSYMTAB)
    _u32_le(out, 80)
    _u32_le(out, 0)            // ilocalsym (locals start at index 0)
    _u32_le(out, nlocalsym)    // nlocalsym
    _u32_le(out, iextdefsym)   // iextdefsym (== nlocalsym)
    _u32_le(out, nextdefsym)   // nextdefsym
    _u32_le(out, iundefsym)    // iundefsym (== nlocalsym + nextdefsym)
    _u32_le(out, nundefsym)    // nundefsym
    // Remaining 12 u32 fields all zero — no TOC, modtab, indirect refs,
    // or external/local relocation tables in MH_OBJECT.
    let mut i = 0
    while i < 12 {
        _u32_le(out, 0)
        i = i + 1
    }
}

// Emit one `nlist_64` symbol record (16 bytes). Per `<mach-o/nlist.h>`:
//
//     struct nlist_64 {
//         uint32_t n_strx;   // index into the string table
//         uint8_t  n_type;   // N_TYPE bits (N_SECT=0x0e, N_UNDF=0x00)
//                            // OR'd with N_EXT (0x01) for external.
//         uint8_t  n_sect;   // 1-based section index; 0 = NO_SECT.
//         uint16_t n_desc;   // misc flags / library ordinal — 0 here.
//         uint64_t n_value;  // section-relative offset for defined syms.
//     };
fn _emit_nlist64(out: [Int], strx: Int, n_type: Int, n_sect: Int, n_value: Int) {
    _u32_le(out, strx)            // n_strx — 4 bytes
    out.push(n_type & 0xff)       // n_type — 1 byte
    out.push(n_sect & 0xff)       // n_sect — 1 byte
    _u16_le(out, 0)               // n_desc — 2 bytes (REFERENCE_FLAG_*, 0 here)
    _u64_le(out, n_value)         // n_value — 8 bytes
}

// Emit one `relocation_info` record (8 bytes). Per `<mach-o/reloc.h>`:
//
//     struct relocation_info {
//         int32_t  r_address;        // section-relative byte offset of patch
//         uint32_t r_symbolnum:24,    // symbol index (extern=1) / section# (extern=0)
//                  r_pcrel:1,         // 1 if displacement is pc-relative
//                  r_length:2,        // log2(byte size); 2 = 4 bytes
//                  r_extern:1,        // 1 = symbolnum is sym idx; 0 = section
//                  r_type:4;          // ARM64_RELOC_*
//     };
//
// The bitfield is little-endian-packed within its u32 (same as the
// struct's natural memory order on darwin-arm64).
fn _emit_reloc_info(out: [Int], r_address: Int, r_symbolnum: Int,
                    r_pcrel: Int, r_length: Int, r_extern: Int, r_type: Int) {
    _u32_le(out, r_address)
    let bits = (r_symbolnum & 0xffffff)
             | ((r_pcrel & 1) << 24)
             | ((r_length & 3) << 25)
             | ((r_extern & 1) << 27)
             | ((r_type & 0xf) << 28)
    _u32_le(out, bits)
}

// ─────────────────────────────────────────────────────────────────
// `serialize(obj)` — top-level entry, RFC 063 § P0 cycle 1
// ─────────────────────────────────────────────────────────────────
//
// Returns the flat byte stream as `[Int]` (each value in 0..=255).
// Cycle 1 scope: header + 4 load commands. Section data, symbol
// records, and relocations follow `obj`'s buffers verbatim — the
// scaffold already exposes them as `text` / `relocs` / `symbols` /
// `strtab`. With those buffers empty (e.g. an empty input program)
// `serialize` produces a 288-byte well-formed Mach-O `.o` whose
// `mach_header_64` and `LC_SEGMENT_64`/`__text` shape matches what
// `clang -c -arch arm64` produces for an empty `.s`.
//
// Layout offsets (assuming nsects=1, ncmds=3 ⇒ sizeofcmds = 256):
//   data_off  = 32 + 256 = 288     (start of __text bytes)
//   reloff    = data_off + size_4aligned(text)
//   symoff    = reloff   + 8 * nreloc
//   stroff    = symoff   + 16 * nsyms
//   total     = stroff   + strsize
fn serialize(obj: MachoArm64Obj) -> [Int] {
    let out: [Int] = []
    let text_len = len(obj.text)
    let nreloc   = len(obj.relocs)
    let nsyms    = len(obj.symbols)
    let strsize_nat = len(obj.strtab)   // natural (unpadded) merged size

    // __text is 4-byte aligned (arm64 instructions are 4 bytes each).
    let mut text_pad = 0
    let trem = text_len & 3
    if trem != 0 { text_pad = 4 - trem }
    let text_size_aligned = text_len + text_pad

    // ── Empty-input corner case (1-section, 3-LC, 288 B) ─────────
    // An `.o` with zero code bytes carries no `__HEXA` metadata
    // sections and no symbols (clang's empty-`.s` output). Keep the
    // legacy compact layout so `emit_empty` / `run_F_P0_OBJEQ_HEADER`
    // stay byte-stable.
    if text_len == 0 {
        let e_sizeofcmds = 152 + 24 + 80   // seg(1 sect) + symtab + dysymtab
        let e_data_off = 32 + e_sizeofcmds // 288
        _emit_mach_header(out, 3, e_sizeofcmds, 0)
        _emit_seg64_cmd(out, "", 0, 0, e_data_off, 0, 1)
        _emit_section_64(out, "__text", "__TEXT", 0, 0, e_data_off, 0, 0, 0, 0x80000000)
        _emit_symtab_cmd(out, e_data_off, 0, e_data_off, 0)
        _emit_dysymtab_cmd(out, 0, 0, 0, 0, 0)
        return out
    }

    // ── Full layout (clang -c parity): 3 sections + LC_BUILD_VERSION ─
    //
    // Sections, in clang's emission order:
    //   1 __text   (__TEXT) — code; align 2^2; flags PURE|SOME_INSTRUCTIONS
    //   2 __cap    (__HEXA) — capability manifest; size 0; align 2^0
    //   3 __abi    (__HEXA) — 12-byte ABI stamp; align 2^0
    // The two `__HEXA` sections are 1-byte-aligned and follow __text in
    // file order (cap is empty so cap.offset == abi.offset). Both share
    // the post-__text addr (vmaddr is contiguous: cap.addr == abi.addr ==
    // text_size_aligned, cap.size == 0).  Mirrors `asm.hexa`'s
    // `_emit_meta_section` output assembled by clang.
    let abi = _hexa_abi_stamp_bytes()
    let abi_len = len(abi)

    // ── `__TEXT,__cstring` literal pool (RFC 063 §P0 data-addressing) ──
    // When the module carries string literals, `pack_lir` fills
    // `obj.cstring` with the concatenated NUL-terminated payloads and
    // defines one `.LCstr*` N_SECT local per string (section index 2,
    // value = byte offset into this pool). The section is inserted in
    // clang's order: `__text` (1) · `__cstring` (2) · `__cap` (3) ·
    // `__abi` (4). When the pool is EMPTY we keep the legacy 3-section
    // layout so the existing byte-eq corpus stays stable.
    let cstr_len  = len(obj.cstring)
    let cflt_len  = len(obj.cflt)
    let gdata_len = len(obj.gdata)
    let has_cstr  = cstr_len > 0
    let has_cflt  = cflt_len > 0
    let has_gdata = gdata_len > 0
    // Base 3 sections (__text · __cap · __abi); +1 per present data pool
    // (__cstring / __const / __data), in clang segment+section order:
    //   1 __text · [__cstring] · [__const] · [__data] · __cap · __abi
    let mut nsects = 3
    if has_cstr  { nsects = nsects + 1 }
    if has_cflt  { nsects = nsects + 1 }
    if has_gdata { nsects = nsects + 1 }

    // Contiguous vmaddr/file layout. `__cstring` is align-1 (follows
    // __text's 4-aligned end directly); `__const` / `__data` are align-8,
    // so a present one may carry inter-section padding. An ABSENT section
    // is a pure no-op (no addr advance, no pad) → prior layout byte-stable.
    let cstr_addr = text_size_aligned
    let mut cursor = text_size_aligned
    if has_cstr { cursor = cstr_addr + cstr_len }
    let mut const_addr = 0
    let mut const_pad  = 0
    if has_cflt {
        let crem = cursor & 7
        if crem != 0 { const_pad = 8 - crem }
        const_addr = cursor + const_pad
        cursor = const_addr + cflt_len
    }
    let mut data_addr = 0
    let mut data_pad  = 0
    if has_gdata {
        let drem2 = cursor & 7
        if drem2 != 0 { data_pad = 8 - drem2 }
        data_addr = cursor + data_pad
        cursor = data_addr + gdata_len
    }
    // `__cap` / `__abi` vmaddr follows the last data section.
    let meta_addr = cursor
    let sizeofcmds = (72 + 80 * nsects) + 24 + 24 + 80  // seg + buildver + symtab + dysymtab
    let data_off = 32 + sizeofcmds
    let cstr_off  = data_off + text_size_aligned    // __cstring file offset
    // File offsets parallel the vmaddr layout (a `.o` packs sections
    // contiguously); reuse the same per-section pads.
    let const_off = data_off + const_addr
    let data_doff = data_off + data_addr
    let meta_off  = data_off + meta_addr            // == __cap.offset == __abi.offset
    // clang aligns the relocation table to an 8-byte file boundary: it
    // pads the section data after __abi up to the next multiple of 8.
    // (Verified: clang reloff is 536/712/616 for the corpus — all %8==0.)
    let data_end = meta_off + abi_len
    let mut reloc_pad = 0
    let drem = data_end & 7
    if drem != 0 { reloc_pad = 8 - drem }
    let reloff   = data_end + reloc_pad
    let symoff   = reloff + 8 * nreloc
    let stroff   = symoff + 16 * nsyms

    // LLVM/MCStringTableBuilder pads the string table so the file ends
    // on an 8-byte boundary (`(stroff + strsize) % 8 == 0`). Verified
    // against clang: trivial 103->104, fib 207->208, while 195->200.
    let mut str_pad = 0
    let srem = (stroff + strsize_nat) & 7
    if srem != 0 { str_pad = 8 - srem }
    let strsize = strsize_nat + str_pad

    // Partition the symbol table into [locals | extdefs | undefs] runs and
    // count each (clang's nlist is laid out + DYSYMTAB-indexed this way).
    let mut nlocal = 0
    let mut nextdef = 0
    let mut nundef = 0
    let mut sx = 0
    while sx < nsyms {
        let s = obj.symbols[sx]
        if s.is_external == 0 {
            nlocal = nlocal + 1
        } else if s.section == 0 {
            nundef = nundef + 1
        } else {
            nextdef = nextdef + 1
        }
        sx = sx + 1
    }

    // flags = 0: aprime_cc's `.s` does NOT emit `.subsections_via_symbols`
    // (the `asm.hexa` emitter omits that directive), so `clang -c` on it
    // leaves MH_SUBSECTIONS_VIA_SYMBOLS (0x2000) UNSET. Verified by
    // `xxd -s24 -l4` on the clang reference: flags == 0x00000000.
    _emit_mach_header(out, 4, sizeofcmds, 0)

    let vmsize = meta_addr + abi_len
    _emit_seg64_cmd(out, "", 0, vmsize, data_off, vmsize, nsects)

    // __text — code section.
    _emit_section_64(out, "__text", "__TEXT",
                     0, text_size_aligned,
                     data_off, 2,
                     reloff, nreloc,
                     0x80000400)
    // __cstring — C-string literal pool (flags S_CSTRING_LITERALS = 0x2,
    // align 2^0). Only when the module produced string literals.
    if has_cstr {
        _emit_section_64(out, "__cstring", "__TEXT",
                         cstr_addr, cstr_len,
                         cstr_off, 0,
                         0, 0,
                         0x00000002)
    }
    // __const — float-literal pool (PR-C2). S_REGULAR (0x0), align 2^3
    // (8-byte `.double`s). Read-only `__TEXT` data, no reloc.
    if has_cflt {
        _emit_section_64(out, "__const", "__TEXT",
                         const_addr, cflt_len,
                         const_off, 3,
                         0, 0,
                         0x00000000)
    }
    // __data — module-global HexaVal slots (PR-C1). S_REGULAR (0x0),
    // align 2^3 (16-byte slots are 8-aligned). Writable `__DATA`, no reloc.
    if has_gdata {
        _emit_section_64(out, "__data", "__DATA",
                         data_addr, gdata_len,
                         data_doff, 3,
                         0, 0,
                         0x00000000)
    }
    // __cap — empty capability manifest header (size 0, align 1, no reloc).
    _emit_section_64(out, "__cap", "__HEXA",
                     meta_addr, 0,
                     meta_off, 0,
                     0, 0,
                     0x00000000)
    // __abi — 12-byte ABI stamp (align 1, no reloc).
    _emit_section_64(out, "__abi", "__HEXA",
                     meta_addr, abi_len,
                     meta_off, 0,
                     0, 0,
                     0x00000000)

    _emit_build_version_cmd(out, MACHO_PLATFORM_MACOS, MACHO_BUILD_MINOS_26)
    _emit_symtab_cmd(out, symoff, nsyms, stroff, strsize)
    _emit_dysymtab_cmd(out, nlocal, nlocal, nextdef, nlocal + nextdef, nundef)

    // __text bytes + 4-byte alignment pad
    let mut i = 0
    while i < text_len { out.push(obj.text[i] & 0xff); i = i + 1 }
    _zero_n(out, text_pad)

    // __cstring bytes (concatenated NUL-terminated string payloads).
    if has_cstr {
        let mut ci = 0
        while ci < cstr_len { out.push(obj.cstring[ci] & 0xff); ci = ci + 1 }
    }
    // __const bytes (8-aligned float-literal `.double` pool, PR-C2).
    if has_cflt {
        _zero_n(out, const_pad)
        let mut cfi = 0
        while cfi < cflt_len { out.push(obj.cflt[cfi] & 0xff); cfi = cfi + 1 }
    }
    // __data bytes (8-aligned zero-initialized global slots, PR-C1).
    if has_gdata {
        _zero_n(out, data_pad)
        let mut gdi = 0
        while gdi < gdata_len { out.push(obj.gdata[gdi] & 0xff); gdi = gdi + 1 }
    }

    // __cap is empty (no bytes). __abi: the 12-byte stamp.
    let mut ai = 0
    while ai < abi_len { out.push(abi[ai] & 0xff); ai = ai + 1 }
    // 8-byte alignment pad so the relocation table starts on an 8-byte
    // boundary (matches clang's reloff alignment).
    _zero_n(out, reloc_pad)

    // Relocations: emit one `relocation_info` per Arm64Reloc. r_extern is
    // 1 — all our relocs are symbol-based BRANCH26 to undefined externs.
    let mut ri = 0
    while ri < nreloc {
        let rl = obj.relocs[ri]
        // PERF (N5 byte-eq): inline _emit_reloc_info + _u32_le so the reloc bytes
        // grow `out` in serialize's OWN arena (one heapify at serialize return)
        // instead of a per-reloc callee arena-return that heapifies the whole
        // growing buffer — that was O(nreloc^2) and made full-compiler obj-emit
        // take >1h. Byte-identical to _emit_reloc_info(out,…,r_extern=1,…).
        out.push(rl.offset & 0xff)
        out.push((rl.offset >> 8) & 0xff)
        out.push((rl.offset >> 16) & 0xff)
        out.push((rl.offset >> 24) & 0xff)
        let bits = (rl.sym_idx & 0xffffff) | ((rl.pcrel & 1) << 24) | ((rl.length & 3) << 25) | (1 << 27) | ((rl.kind & 0xf) << 28)
        out.push(bits & 0xff)
        out.push((bits >> 8) & 0xff)
        out.push((bits >> 16) & 0xff)
        out.push((bits >> 24) & 0xff)
        ri = ri + 1
    }

    // Symbol records (nlist_64), in [locals | extdefs | undefs] order.
    // n_type = kind | N_EXT (if external) | N_PEXT (if .private_extern).
    let mut si = 0
    while si < nsyms {
        let s = obj.symbols[si]
        let mut n_type = s.kind
        if s.is_external != 0 { n_type = n_type | MACHO_N_EXT }
        if s.is_pext != 0     { n_type = n_type | MACHO_N_PEXT }
        // PERF (N5 byte-eq): inline _emit_nlist64 + _u32/16/64_le — same O(n^2)
        // per-symbol arena-return heapify fix as the reloc loop above. nlist_64
        // is 16 bytes: n_strx(4) n_type(1) n_sect(1) n_desc(2=0) n_value(8).
        out.push(s.name_offset & 0xff)
        out.push((s.name_offset >> 8) & 0xff)
        out.push((s.name_offset >> 16) & 0xff)
        out.push((s.name_offset >> 24) & 0xff)
        out.push(n_type & 0xff)
        out.push(s.section & 0xff)
        out.push(0)
        out.push(0)
        out.push(s.value & 0xff)
        out.push((s.value >> 8) & 0xff)
        out.push((s.value >> 16) & 0xff)
        out.push((s.value >> 24) & 0xff)
        out.push((s.value >> 32) & 0xff)
        out.push((s.value >> 40) & 0xff)
        out.push((s.value >> 48) & 0xff)
        out.push((s.value >> 56) & 0xff)
        si = si + 1
    }

    // String table bytes (verbatim) + 8-byte file-end alignment pad.
    let mut ki = 0
    while ki < strsize_nat { out.push(obj.strtab[ki] & 0xff); ki = ki + 1 }
    _zero_n(out, str_pad)

    return out
}

// ─────────────────────────────────────────────────────────────────
// LIR walker — `LModule` → byte stream  (RFC 063 § P0, cycle 2)
// ─────────────────────────────────────────────────────────────────
//
// `pack_lir(lm)` is the second half of P0: it walks `LModule.funcs`,
// turns each `LInstr` into one 4-byte little-endian arm64 instruction
// word, and records branch / call relocations against a pending
// symbol table.
//
// Cycle 2 subset (this commit):
//
//   - register operands: `LOperand.kind == "reg"` → `reg.name`
//     (lowercase from arm64_darwin LIR; `xreg_idx` handles both cases).
//   - immediate operands: `LOperand.kind == "imm"` → `#N`.
//   - label operands on intra-function branches (`b` / `b.cond` /
//     `cbz` / `cbnz` to a `label` pseudo-op in the same `LFunc`) —
//     resolved by a name→offset map, the imm bits patched in place,
//     no relocation record emitted.
//   - the `label` pseudo-op (`op == "label"`, name in `comment` or
//     `args[0].label`) records the current `text` offset in the
//     name→offset map and emits zero bytes.
//
// Out of scope (next cycles):
//
//   - mem operands with offsets (`[sp, #16]`, pre/post-index frame
//     ops) — need additional encoding rules in `encode_arm64_insn`
//     (cycle 3).
//   - extern-symbol branches / calls (`BL _main`, `ADRP _sym@PAGE`)
//     and the corresponding `Arm64Reloc` records (cycle 4).
//   - `LInstr` ops outside the 16 encoding rules currently in
//     `encode_arm64_insn` (cycle 3 fills out the table).
//
// Walker is silent on unsupported ops: it emits a sentinel 0x00000000
// word so the byte stream stays length-correct and `otool -d` shows
// the gap. A diagnostic counter (`pack_unhandled_ops`) is reserved
// for the next cycle when the wiring decides whether to hard-error
// on an unhandled op or fall back to `.s` + `as`.

fn _lir_op_uppercase(op: string) -> string {
    // arm64_darwin LIR uses lowercase mnemonics; encode_arm64_insn's
    // table is keyed on the canonical uppercase ARM ARM spelling.
    // Hand-mapped table — small, stable, faster + clearer than calling
    // a generic to_upper() pass.
    if op == "mov"   { return "MOV"  }
    if op == "movz"  { return "MOVZ" }
    if op == "movk"  { return "MOVK" }
    if op == "add"   { return "ADD"  }
    if op == "sub"   { return "SUB"  }
    if op == "mul"   { return "MUL"  }
    if op == "cmp"   { return "CMP"  }
    if op == "ldr"   { return "LDR"  }
    if op == "str"   { return "STR"  }
    if op == "ldp"   { return "LDP"  }
    if op == "stp"   { return "STP"  }
    if op == "b"     { return "B"    }
    if op == "bl"    { return "BL"   }
    if op == "ret"   { return "RET"  }
    if op == "svc"   { return "SVC"  }
    if op == "nop"   { return "NOP"  }
    if op == "yield" { return "YIELD" }  // RFC inline-asm rung 2 (__hx_asm pause)
    if op == "dmb"   { return "DMB"  }   // RFC inline-asm rung 2 (__hx_asm fence)
    if op == "cbz"   { return "CBZ"  }
    if op == "cbnz"  { return "CBNZ" }
    if op == "uxtw"  { return "UXTW" }
    if op == "uxtb"  { return "UXTB" }
    if op == "uxth"  { return "UXTH" }
    if op == "sxtw"  { return "SXTW" }
    if op == "sxtb"  { return "SXTB" }
    if op == "sxth"  { return "SXTH" }
    if op == "ubfm"  { return "UBFM" }
    if op == "sbfm"  { return "SBFM" }
    if op == "lsl"   { return "LSL"  }
    if op == "lsr"   { return "LSR"  }
    if op == "asr"   { return "ASR"  }
    if op == "cset"  { return "CSET" }
    if op == "csel"  { return "CSEL" }
    // RT-NATIVE UNLOCK-4: scalar FP mnemonics — without these the obj-emit
    // path passed them through lowercase → encode returned 0 (udf hole),
    // so FP intrinsics only worked via the clang-asm route.
    if op == "fmov"  { return "FMOV" }
    if op == "fadd"  { return "FADD" }
    if op == "fsub"  { return "FSUB" }
    if op == "fmul"  { return "FMUL" }
    if op == "fdiv"  { return "FDIV" }
    if op == "fcmp"  { return "FCMP" }
    if op == "scvtf" { return "SCVTF" }
    if op == "fcvtzs" { return "FCVTZS" }
    if op == "ldrb"  { return "LDRB" }
    if op == "strb"  { return "STRB" }
    // RFC 063 P0 fill (self-host udf-hole closure): the native obj-emit
    // path also lowers these in main's prologue + arithmetic; without a
    // table entry they fell through `_lir_op_uppercase` as lowercase →
    // encode_arm64_insn returned 0 (the `udf #0` self-emit hole).
    if op == "adrp"  { return "ADRP" }
    if op == "eor"   { return "EOR"  }
    if op == "mvn"   { return "MVN"  }
    if op == "and"   { return "AND"  }
    if op == "orr"   { return "ORR"  }
    if op == "orn"   { return "ORN"  }
    if op == "lslv"  { return "LSLV" }
    if op == "lsrv"  { return "LSRV" }
    if op == "asrv"  { return "ASRV" }
    if op == "sdiv"  { return "SDIV" }
    if op == "udiv"  { return "UDIV" }
    if op == "blr"   { return "BLR"  }
    if op == "br"    { return "BR"   }
    // Conditional branch: `b.eq` -> `B.EQ`. The encoder reads the
    // condition from the suffix; uppercasing the whole token preserves
    // the dot.
    if len(op) > 2 && op.substring(0, 2) == "b." {
        let cc = op.substring(2, len(op))
        let mut up = ""
        let mut i = 0
        while i < len(cc) {
            let c = char_code(cc, i)
            if c >= 97 && c <= 122 { up = up + from_char_code(c - 32) } else { up = up + cc.substring(i, i + 1) }
            i = i + 1
        }
        return "B." + up
    }
    // Unknown — pass through; the encoder returns 0 and the walker
    // emits the sentinel word for follow-up triage.
    return op
}

// Classify a label operand's PC-relative addressing suffix into a
// Mach-O reloc kind, returning [kind, base_len] where base_len is the
// length of the symbol name with the `@…` suffix stripped. kind == -1
// means no recognized suffix (a plain intra-fn label / runtime name).
//   `sym@PAGE`        -> PAGE21      (3)
//   `sym@PAGEOFF`     -> PAGEOFF12   (4)
//   `sym@GOTPAGE`     -> GOT_LOAD_PAGE21    (handled in PR-C; classify now)
//   `sym@GOTPAGEOFF`  -> GOT_LOAD_PAGEOFF12 (PR-C)
fn _label_reloc_kind(s: string) -> [Int] {
    // Order matters: test the GOT (longer) suffixes before the bare ones.
    if _ends_with(s, "@GOTPAGEOFF") { return [MACHO_ARM64_RELOC_GOT_LOAD_PAGEOFF12, len(s) - 11] }
    if _ends_with(s, "@GOTPAGE")    { return [MACHO_ARM64_RELOC_GOT_LOAD_PAGE21,    len(s) - 8] }
    if _ends_with(s, "@PAGEOFF")    { return [MACHO_ARM64_RELOC_PAGEOFF12, len(s) - 8] }
    if _ends_with(s, "@PAGE")       { return [MACHO_ARM64_RELOC_PAGE21,     len(s) - 5] }
    return [-1, len(s)]
}

// Extract the bare symbol name (the `@…` suffix stripped to `base_len`)
// from a page-relative operand. For a `label` operand the suffix lives
// on `op.label`; for a `mem` operand (GOT load) it lives on `op.label`
// too (`[Xn, sym@GOTPAGEOFF]`'s label field is `sym@GOTPAGEOFF`).
fn _label_base_name(op: LOperand, base_len: Int) -> string {
    return op.label.substring(0, base_len)
}

fn _lir_operand_str(op: LOperand) -> string {
    if op.kind == "reg"   { return op.reg.name }
    if op.kind == "imm"   { return "#" + to_string(op.imm) }
    if op.kind == "label" { return op.label }
    if op.kind == "mem" {
        // Format mirrors `compiler/emit/asm.hexa::_fmt_mem` for darwin
        // arm64: `[base, #offset]`. The encoder splits this back out
        // via `_parse_mem_op` when it sees a leading "[".
        return "[" + op.mem_base.name + ", #" + to_string(op.mem_offset) + "]"
    }
    return "<?" + op.kind + "?>"
}

// Parse a mem-operand string back to `[base_reg_idx, offset, mode]`.
// Recognized forms (arm64 LIR convention, matching `_fmt_label`'s
// carve-out for `[…]` literals):
//
//   `[Xn]`            -> mode 0 (offset, off=0)
//   `[Xn, #imm]`      -> mode 0 (offset)
//   `[Xn, #imm]!`     -> mode 1 (pre-index, writeback after)
//   `[Xn], #imm`      -> mode 2 (post-index, writeback before)
//
// Returns `[-1, 0, 0]` if the shape is not recognized.
fn _parse_mem_op(s: string) -> [Int] {
    let n = len(s)
    if n < 3 || s.substring(0, 1) != "[" { return [-1, 0, 0] }

    // Detect post-index: `[Xn], #imm` — closing `]` followed by `, #imm`.
    let mut close = -1
    let mut p = 0
    while p < n {
        if s.substring(p, p + 1) == "]" { close = p; break }
        p = p + 1
    }
    if close < 0 { return [-1, 0, 0] }
    let inner = s.substring(1, close)

    // Tail after `]`: either empty, `!` (pre-index), or `, #imm`
    // (post-index). Anything else is unrecognized.
    let tail = s.substring(close + 1, n)
    let tail_n = len(tail)

    // Split inner on the first ", " to get base and inline-offset (if
    // any). For the post-index form, `inner` is just `Xn` (no comma).
    let inn = len(inner)
    let mut comma = -1
    let mut i = 0
    while i < inn {
        if inner.substring(i, i + 1) == "," { comma = i; break }
        i = i + 1
    }
    let mut base = inner
    let mut inline_imm: Int = 0
    let mut has_inline_imm = false
    if comma >= 0 {
        base = inner.substring(0, comma)
        let rest = inner.substring(comma + 1, inn)
        let nr = len(rest)
        let mut j = 0
        while j < nr && rest.substring(j, j + 1) == " " { j = j + 1 }
        if j < nr && rest.substring(j, j + 1) == "#" { j = j + 1 }
        if j < nr {
            inline_imm = rest.substring(j, nr).to_int()
            has_inline_imm = true
        }
    }
    let rn = xreg_idx(base)
    if rn < 0 { return [-1, 0, 0] }

    if tail_n == 0 {
        return [rn, inline_imm, 0]   // offset-form
    }
    if tail == "!" {
        return [rn, inline_imm, 1]   // pre-index, writeback
    }
    // Post-index: tail looks like `, #imm` (or `, #-imm`).
    if tail.substring(0, 1) == "," {
        let post = tail.substring(1, tail_n)
        let pn = len(post)
        let mut j = 0
        while j < pn && post.substring(j, j + 1) == " " { j = j + 1 }
        if j < pn && post.substring(j, j + 1) == "#" { j = j + 1 }
        if j >= pn { return [-1, 0, 0] }
        let imm = post.substring(j, pn).to_int()
        return [rn, imm, 2]
    }
    return [-1, 0, 0]
}

// State carried while walking one LFunc. label_names / label_offsets
// are parallel arrays (no map-of-string in scope here); intra-fn
// branch resolution does a linear scan on this short list.
struct PackFnState {
    text:          [Int],
    label_names:   [string],
    label_offsets: [Int],
    unresolved_brs: [Int],         // text offsets of branches needing fixup
    unresolved_to:  [string],      // target label name per branch
}

fn _lookup_label(state: PackFnState, name: string) -> Int {
    let n = len(state.label_names)
    let mut i = 0
    while i < n {
        if state.label_names[i] == name { return state.label_offsets[i] }
        i = i + 1
    }
    return -1
}

// True if `name` already appears in `xs`. Linear scan — `xs` is the
// short per-module block-label reference-order list.
fn _str_in(xs: [string], name: string) -> bool {
    let n = len(xs)
    let mut i = 0
    while i < n {
        if xs[i] == name { return true }
        i = i + 1
    }
    return false
}

// Look up a label's __text offset in the parallel name/offset arrays.
// Returns -1 if absent.
fn _blabel_offset_of(names: [string], offsets: [Int], name: string) -> Int {
    let n = len(names)
    let mut i = 0
    while i < n {
        if names[i] == name { return offsets[i] }
        i = i + 1
    }
    return -1
}

// Append a 4-byte little-endian instruction word to the running text
// buffer. Used by every encoded instruction path in `_pack_fn`.
fn _push_word_le(out: [Int], word: Int) {
    out.push(word & 0xff)
    out.push((word >> 8) & 0xff)
    out.push((word >> 16) & 0xff)
    out.push((word >> 24) & 0xff)
}

// Patch a 32-bit word in the text buffer at byte offset `off`. Reads
// the existing word (4 LE bytes), ORs the imm bits in, writes back.
// Used after the full function is walked to resolve intra-fn branches
// once every label offset is known.
fn _patch_word_le(out: [Int], off: Int, word: Int) {
    out[off + 0] = word & 0xff
    out[off + 1] = (word >> 8) & 0xff
    out[off + 2] = (word >> 16) & 0xff
    out[off + 3] = (word >> 24) & 0xff
}

// Append the ASCII bytes of `s` plus a trailing NUL to `out`. Returns
// the byte offset of the first byte appended — used to seed
// `MachoSymbol.name_offset` for the just-written name.
fn _push_cstr(out: [Int], s: string) -> Int {
    let off = len(out)
    let n = len(s)
    let mut i = 0
    while i < n {
        out.push(char_code(s, i) & 0xff)
        i = i + 1
    }
    out.push(0)
    return off
}

// ── MCStringTableBuilder suffix-merge string interning ──────────────
//
// clang/LLVM builds the Mach-O string table via `MCStringTableBuilder`
// (StringTableBuilder.cpp::finalizeStringTable). Names are NOT laid out
// in symbol order; instead:
//
//   1. A leading NUL occupies index 0 (the empty string).
//   2. The unique names are sorted by their bytes read RIGHT-TO-LEFT
//      (reversed-string lexicographic), DESCENDING. This groups every
//      string that shares a common suffix adjacently, longest-tail
//      first.
//   3. SUFFIX MERGE: when a string is a suffix of its immediate
//      predecessor in that order, it does NOT get its own bytes — its
//      offset is the predecessor's offset shifted by the length
//      difference (it reuses the predecessor's trailing bytes, NUL and
//      all). Otherwise it appends `<name>\0` and takes the new offset.
//
// `_macho_string_offset_of(names, name)` returns the merged offset of
// `name`; `_build_merged_strtab(out, names)` fills `out` with the
// merged byte buffer (NATURAL size — the trailing 8-byte file-end pad
// is applied later in `serialize`, which is the only place that knows
// `stroff`). Verified byte-for-byte against Apple clang 21.0.0 on the
// {trivial, fib, while} F-P0-OBJEQ corpus (every n_strx + the natural
// strsize match exactly).
//
// Reversed-string comparison: returns true if reverse(a) > reverse(b),
// i.e. `a` sorts BEFORE `b` in the descending-reversed order.
fn _rev_str_gt(a: string, b: string) -> bool {
    let la = len(a)
    let lb = len(b)
    let mut ia = la - 1
    let mut ib = lb - 1
    while ia >= 0 && ib >= 0 {
        let ca = char_code(a, ia) & 0xff
        let cb = char_code(b, ib) & 0xff
        if ca != cb { return ca > cb }
        ia = ia - 1
        ib = ib - 1
    }
    // One is a suffix of the other (shared all overlapping bytes).
    // The LONGER string sorts first (descending) so its suffix can
    // tail-merge into it.
    return la > lb
}

// Merge two already-sorted runs `a` and `b` (each descending by
// `_rev_str_gt`) into a fresh array, preserving that order. Stable: on a
// tie (neither strictly before the other) the `a` element is taken first
// — but the inputs here are DISTINCT (deduped upstream) so `_rev_str_gt`
// is a strict total order and the merge result is unambiguous.
fn _merge_rev_desc(a: [string], b: [string]) -> [string] {
    let la = len(a)
    let lb = len(b)
    let out: [string] = []
    let mut i = 0
    let mut j = 0
    while i < la && j < lb {
        // Take `a[i]` unless `b[j]` strictly sorts before it.
        if _rev_str_gt(b[j], a[i]) {
            out.push(b[j])
            j = j + 1
        } else {
            out.push(a[i])
            i = i + 1
        }
    }
    while i < la { out.push(a[i]); i = i + 1 }
    while j < lb { out.push(b[j]); j = j + 1 }
    return out
}

// O(n log n) merge sort of `xs` by `_rev_str_gt` (descending reversed
// string). Replaces the prior O(n²) insertion sort — for the ~3600-symbol
// self-compiler flat the quadratic sort (with the quadratic dedup) made
// the native obj-emit take ~60min / ~8.85GB RSS. Produces a BYTE-IDENTICAL
// result to the insertion sort: the inputs are distinct and `_rev_str_gt`
// is a strict total order, so both yield the unique descending sequence.
fn _msort_rev_desc(xs: [string]) -> [string] {
    let n = len(xs)
    if n <= 1 { return xs }
    let mid = n / 2
    let left: [string] = []
    let right: [string] = []
    let mut i = 0
    while i < mid { left.push(xs[i]); i = i + 1 }
    while i < n { right.push(xs[i]); i = i + 1 }
    let ls = _msort_rev_desc(left)
    let rs = _msort_rev_desc(right)
    return _merge_rev_desc(ls, rs)
}

// True iff `suf` is a (proper-or-equal) suffix of `s`.
fn _ends_with(s: string, suf: string) -> bool {
    let ls = len(s)
    let lf = len(suf)
    if lf > ls { return false }
    let mut k = 0
    while k < lf {
        if (char_code(s, ls - lf + k) & 0xff) != (char_code(suf, k) & 0xff) {
            return false
        }
        k = k + 1
    }
    return true
}

// Build the suffix-merged string table for `names` into `out` (starting
// with the index-0 NUL) and return a parallel `[Int]` of each input
// `names[i]`'s merged offset, in the SAME order as `names`.
fn _build_merged_strtab(out: [Int], names: [string]) -> [Int] {
    // Unique names, first-seen order preserved (only used to drive the
    // sort; the returned offsets map back to the original `names`). O(n)
    // dedup via a hash-set membership map — was O(n²) `_str_in` per name.
    let uniq: [string] = []
    let mut seen = {}
    let mut i = 0
    while i < len(names) {
        if !has_key(seen, names[i]) {
            seen[names[i]] = true
            uniq.push(names[i])
        }
        i = i + 1
    }
    // O(n log n) merge sort (was O(n²) insertion sort). Distinct inputs +
    // strict total order ⇒ byte-identical result to the insertion sort.
    let sorted = _msort_rev_desc(uniq)

    // Index-0 NUL (empty string).
    out.push(0)

    // Assign a merged offset to each unique name, tail-merging suffixes.
    // `off_of` (name -> merged offset) lets the final original-order map
    // be O(1)/name instead of an O(n²) `_index_of_str` linear scan.
    let mut off_of = {}
    let mut u = 0
    let mut prev_name = ""
    let mut prev_off = 0
    while u < len(sorted) {
        let s = sorted[u]
        if u > 0 && _ends_with(prev_name, s) {
            // `s` is a suffix of its predecessor: reuse the tail.
            let so = prev_off + (len(prev_name) - len(s))
            off_of[s] = so
            prev_off = so
        } else {
            let so = len(out)
            off_of[s] = so
            prev_off = so
            let mut c = 0
            while c < len(s) { out.push(char_code(s, c) & 0xff); c = c + 1 }
            out.push(0)
        }
        prev_name = s
        u = u + 1
    }

    // Map each input name (in original order) to its unique offset.
    let result: [Int] = []
    i = 0
    while i < len(names) {
        result.push(off_of[names[i]])
        i = i + 1
    }
    return result
}

// Index of `name` in `xs` (-1 if absent).
fn _index_of_str(xs: [string], name: string) -> Int {
    let mut i = 0
    while i < len(xs) {
        if xs[i] == name { return i }
        i = i + 1
    }
    return -1
}

// Darwin Mach-O symbol-name convention: every C/hexa symbol carries
// a leading `_` in the object file. Mirrors `compiler/emit/asm.hexa
// ::_fmt_label` for `_is_darwin(target)`.
fn _darwin_mangle(name: string) -> string {
    return "_" + name
}

// Darwin label mangle, matching `asm.hexa::_fmt_label`: prepend `_`
// UNCONDITIONALLY (injective — `_L…` → `__L…`) except for directive-
// like / addressing / reg-list / immediate literals. Block labels from
// arm64_darwin are `_L<hash>_<fn>_bb<n>`; the assembled symbol is the
// `_`-prefixed form. (The native path uses raw names for intra-fn
// branch resolution and the mangled form only for the symbol record.)
fn _darwin_mangle_label(label: string) -> string {
    if len(label) == 0 { return label }
    let first = label.substring(0, 1)
    if first == "." { return label }
    if first == "[" { return label }
    if first == "{" { return label }
    if first == "#" { return label }
    return "_" + label
}

// Walk one LFunc, append its instructions to `out_text`, record any
// label offsets, and resolve all intra-function branches.
//
// Out-params (cycle 4):
//   pending_offsets[] / pending_names[] — parallel arrays for branch
//   targets the intra-fn label table does not resolve. pack_lir's
//   post-walk pass turns each pair into an Arm64Reloc record (by
//   looking up `name` in obj.symbols).
// Out-params (symtab layout):
//   blabel_names[] / blabel_offsets[] — every intra-fn `label` op's
//     mangled name + __text byte offset, in DEFINITION order. pack_lir
//     turns these into local N_SECT symbols.
//   blabel_reforder[] — the SAME label names, but in FIRST-BRANCH-
//     REFERENCE order (the order each label is first used as a branch
//     target). clang/LLVM-MC orders block-label local symbols this way;
//     pack_lir uses it (with the entry label first) to match clang's
//     local-symbol ordering so `r_symbolnum` lines up. The entry block
//     (first-defined) is prepended by pack_lir.
fn _pack_fn(out_text: [Int],
            pending_offsets: [Int], pending_names: [string],
            pending_page_offsets: [Int], pending_page_names: [string],
            pending_page_kinds: [Int],
            blabel_names: [string], blabel_offsets: [Int],
            blabel_reforder: [string],
            f: LFunc) {
    let st = PackFnState {
        text:           out_text,
        label_names:    [],
        label_offsets:  [],
        unresolved_brs: [],
        unresolved_to:  [],
    }
    let n = len(f.instrs)
    let base = len(out_text)
    let mut i = 0
    while i < n {
        let ins = f.instrs[i]
        if ins.op == "label" {
            let mut name = ins.comment
            if len(name) == 0 && len(ins.args) > 0 { name = ins.args[0].label }
            st.label_names.push(name)
            st.label_offsets.push(len(out_text))
            // Export the label (mangled) + its __text offset for the
            // symbol-table pass. arm64_darwin label names already carry
            // the darwin `_` / `__L…` form, so emit verbatim.
            blabel_names.push(name)
            blabel_offsets.push(len(out_text))
            i = i + 1
            continue
        }

        // Format operands to the [string] form encode_arm64_insn expects.
        // PC-relative page operands (`sym@PAGE` / `sym@PAGEOFF` / GOT
        // variants) are sanitized to a zero-immediate base form here: the
        // encoder emits the bare instruction word (imm=0) and Pass-4
        // attaches the matching PAGE21 / PAGEOFF12 relocation, which the
        // linker patches with the resolved page / page-offset. Without
        // this, `add Xd,Xn,sym@PAGEOFF` fell through to the register-form
        // ADD path (xreg_idx of a `.LCstr@PAGEOFF` string = -1) → a
        // garbage word, and `adrp Xd,sym@PAGE` carried no reloc → page 0.
        let mut ops: [string] = []
        let na = len(ins.args)
        // Per-operand page-reloc capture (at most one symbol-relative
        // operand per instruction in the LIR the codegen emits).
        let mut page_kind = -1
        let mut page_name = ""
        let mut k = 0
        while k < na {
            let arg = ins.args[k]
            let raw = _lir_operand_str(arg)
            // A label operand OR a mem operand may carry the `@…` suffix
            // (mem form `[Xn, sym@GOTPAGEOFF]` is emitted by GOT loads).
            let rk = _label_reloc_kind(raw)
            if rk[0] >= 0 && (arg.kind == "label" || arg.kind == "mem") {
                page_kind = rk[0]
                page_name = _label_base_name(arg, rk[1])
                // Sanitize the operand to a zero-immediate base form so
                // the encoder produces the bare word.
                if arg.kind == "mem" {
                    // `[Xn, sym@GOTPAGEOFF]` -> `[Xn, #0]` (ldr base).
                    ops.push("[" + arg.mem_base.name + ", #0]")
                } else {
                    // ADRP ignores ops[1]; ADD/LDR-imm read it as `#0`.
                    ops.push("#0")
                }
            } else {
                ops.push(raw)
            }
            k = k + 1
        }

        let up = _lir_op_uppercase(ins.op)
        let word = encode_arm64_insn(up, ops)
        let cur_off = len(out_text)

        // Symbol-relative page operand: emit the base word + record the
        // (offset, base symbol, reloc kind) for Pass-4.
        if page_kind >= 0 {
            _push_word_le(out_text, word)
            pending_page_offsets.push(cur_off)
            pending_page_names.push(page_name)
            pending_page_kinds.push(page_kind)
            i = i + 1
            continue
        }

        // Branch targets: encoder emits the bare base bit-pattern;
        // intra-fn imm26 / imm19 / B.cond imm19 are patched below.
        // Track which instructions need patching by op shape.
        if (up == "B" || up == "BL") && na == 1 && ins.args[0].kind == "label" {
            _push_word_le(out_text, word)
            st.unresolved_brs.push(cur_off)
            st.unresolved_to.push(ins.args[0].label)
            i = i + 1
            continue
        }
        if up == "CBZ" || up == "CBNZ" {
            // CBZ Xt, label — label is args[1]
            if na == 2 && ins.args[1].kind == "label" {
                _push_word_le(out_text, word)
                st.unresolved_brs.push(cur_off)
                st.unresolved_to.push(ins.args[1].label)
                i = i + 1
                continue
            }
        }
        if len(up) > 2 && up.substring(0, 2) == "B." && na == 1 && ins.args[0].kind == "label" {
            _push_word_le(out_text, word)
            st.unresolved_brs.push(cur_off)
            st.unresolved_to.push(ins.args[0].label)
            i = i + 1
            continue
        }

        _push_word_le(out_text, word)
        i = i + 1
    }

    // Resolve intra-fn branches. imm26 (B/BL) is bits [25:0] of word,
    // multiplied by 4; imm19 (CBZ/CBNZ/B.cond) is bits [23:5] * 4.
    // Unresolved targets (cross-fn / extern) get pushed to pending_*
    // out-params; pack_lir's post-walk turns them into reloc records.
    let nb = len(st.unresolved_brs)
    let mut bi = 0
    while bi < nb {
        let off    = st.unresolved_brs[bi]
        let target = st.unresolved_to[bi]
        let toff   = _lookup_label(st, target)
        if toff < 0 {
            // Extern target — leave bare bit-pattern (imm26/imm19 = 0)
            // in place; the linker patches it via the relocation record
            // pack_lir emits from these pending lists.
            pending_offsets.push(off)
            pending_names.push(target)
            bi = bi + 1
            continue
        }
        // Intra-fn label resolved here → this is its first branch
        // reference if not already recorded. Collect in reference order
        // (deduped) so pack_lir can order the local block-label symbols
        // the way clang/LLVM-MC does.
        if !_str_in(blabel_reforder, target) {
            blabel_reforder.push(target)
        }
        let delta = (toff - off) / 4    // PC-rel instruction-count
        // Reconstruct the existing word bits.
        let w0 = out_text[off + 0]
        let w1 = out_text[off + 1]
        let w2 = out_text[off + 2]
        let w3 = out_text[off + 3]
        let cur = w0 | (w1 << 8) | (w2 << 16) | (w3 << 24)
        // Distinguish B/BL (high 6 bits = 0b000101 or 0b100101) from
        // CBZ/CBNZ/B.cond (imm19). The encoder gave the upper bits;
        // we OR the imm into the right field.
        let top = (cur >> 26) & 0x3f
        if top == 0x05 || top == 0x25 {
            // B / BL → imm26 = delta & 0x03ffffff
            let patched = (cur & 0xfc000000) | (delta & 0x03ffffff)
            _patch_word_le(out_text, off, patched)
        } else {
            // CBZ / CBNZ / B.cond → imm19 at bits [23:5]
            let imm19 = delta & 0x7ffff
            let patched = (cur & 0xff00001f) | (imm19 << 5)
            _patch_word_le(out_text, off, patched)
        }
        bi = bi + 1
    }
}

// Find the index of a symbol in `symbols[]` whose name-string (read
// out of `strtab` via `name_offset`) matches `mangled`. Returns -1 if
// no match — caller treats that as a missing-symbol bug.
fn _find_sym_by_name(symbols: [MachoSymbol], strtab: [Int], mangled: string) -> Int {
    let ns = len(symbols)
    let ml = len(mangled)
    let mut i = 0
    while i < ns {
        let off = symbols[i].name_offset
        let mut k = 0
        let mut ok = true
        while k < ml {
            if (strtab[off + k] & 0xff) != char_code(mangled, k) { ok = false; break }
            k = k + 1
        }
        // Match also requires the terminating NUL at the right spot —
        // guards against "_foo" matching the prefix of "_foobar".
        if ok && (strtab[off + ml] & 0xff) == 0 { return i }
        i = i + 1
    }
    return -1
}

// Decode one lowercase/upper hex nibble char-code to 0..15 (-1 if not
// a hex digit). `LSection.bytes` is the codegen's hex-encoded payload
// (see `_str_to_hex_bytes` in arm64_darwin.hexa).
fn _hex_nibble_val(c: Int) -> Int {
    if c >= 48 && c <= 57 { return c - 48 }       // '0'..'9'
    if c >= 97 && c <= 102 { return c - 97 + 10 } // 'a'..'f'
    if c >= 65 && c <= 70  { return c - 65 + 10 } // 'A'..'F'
    return -1
}

// Decode a hex-encoded byte string (`"68656c6c6f00"`) into `out` as
// raw bytes (0..255), appending. Odd trailing nibble is dropped
// defensively. Mirrors `asm.hexa::_emit_section_bytes`'s pairing.
fn _append_hex_bytes(out: [Int], hex: string) {
    let n = len(hex)
    let nbytes = n / 2
    let mut i = 0
    while i < nbytes {
        let hi = _hex_nibble_val(char_code(hex, i * 2))
        let lo = _hex_nibble_val(char_code(hex, i * 2 + 1))
        if hi >= 0 && lo >= 0 {
            out.push((hi << 4) | lo)
        }
        i = i + 1
    }
}

// CstrPool — the `__cstring` literal-pool bytes plus a parallel
// label→offset map for the `.LCstr*` symbol definitions. `labels[i]`
// is the rodata section name (`.LCstrN`); `offsets[i]` is its start
// byte within `bytes`.
struct CstrPool {
    bytes:   [Int],
    labels:  [string],
    offsets: [Int],
}

// Build the `__cstring` pool from `lm.rodata`. Each rodata `LSection`
// is one interned string literal: `sec.name` is the `.LCstrN` label,
// `sec.bytes` is its hex-encoded NUL-terminated payload. The pool
// concatenates every payload in rodata (= codegen intern) order, so a
// `.LCstrN@PAGE`/`@PAGEOFF` ref resolves against the symbol at that
// pool offset.
// Round `v` up to the next multiple of 8 (section alignment for the
// `__const` / `__data` pools).
fn _align_up8(v: Int) -> Int {
    let r = v & 7
    if r == 0 { return v }
    return v + (8 - r)
}

// True iff this rodata LSection is a §M8 named-rodata-table (`rotab_<id>` /
// `_rotab_<id>`), NOT a `.LCstr*` cstring. These carry binary LE-double payloads
// (musl exp __exp_data.tab etc.) with interior NUL bytes, so they MUST go into
// `__TEXT,__const` (S_REGULAR, 8-aligned — the float-pool section) and NOT into
// `__cstring` (S_CSTRING_LITERALS, which NUL-splits/dedups). Matches the
// `__hx_rodata_tab_ptr` codegen which names the LSection `_rotab_<id>` (darwin) /
// `rotab_<id>` (ELF). Off the byteeq path (no rotab sections) this is never true.
fn _is_rotab_section(name: string) -> bool {
    let cs = name.chars()
    let n = len(cs)
    // accept "rotab_" (ELF/bare) or "_rotab_" (darwin _fmt_label-spelled)
    let mut base = name
    if n >= 1 && cs[0] == "_" { base = name.substring(1, n) }
    let bc = base.chars()
    if len(bc) < 6 { return false }
    let mut k = 0
    let pfx = "rotab_".chars()
    while k < 6 {
        if bc[k] != pfx[k] { return false }
        k = k + 1
    }
    return true
}

fn _build_cstr_pool(lm: LModule) -> CstrPool {
    let pool = CstrPool { bytes: [], labels: [], offsets: [] }
    let n = len(lm.rodata)
    let mut i = 0
    while i < n {
        let sec = lm.rodata[i]
        // §M8: rotab_<id> tables are __const (binary doubles), handled by
        // _build_flt_pool — skip here so __cstring stays cstring-only.
        if !_is_rotab_section(sec.name) {
            pool.labels.push(sec.name)
            pool.offsets.push(len(pool.bytes))
            _append_hex_bytes(pool.bytes, sec.bytes)
        }
        i = i + 1
    }
    return pool
}

// Append the little-endian 8 bytes of an i64 to `out`.
fn _append_u64_le_bytes(out: [Int], v: Int) {
    let mut k = 0
    while k < 8 {
        out.push((v >> (8 * k)) & 0xff)
        k = k + 1
    }
}

// Build the `__TEXT,__const` float-literal pool (PR-C2) from `lm.floats`.
// Each `LFloat` carries a `.LCfltN` label and the decimal source `text`
// (e.g. "16.0"). clang lays each as a 8-byte `.double` (8-aligned). We
// recover the IEEE-754 bits via the runtime `float_to_bits(to_float(text))`
// (the same 4-surface builtin the compiler itself uses at op-fold time,
// arm64_darwin.hexa) and serialize them little-endian. `offsets[i]` is the
// pool offset of `.LCfltN` (= N_SECT value once the section vmaddr is added).
fn _build_flt_pool(lm: LModule) -> CstrPool {
    let pool = CstrPool { bytes: [], labels: [], offsets: [] }
    let n = len(lm.floats)
    let mut i = 0
    while i < n {
        let f = lm.floats[i]
        pool.labels.push(f.label)
        pool.offsets.push(len(pool.bytes))
        let bits = float_to_bits(to_float(f.text))
        _append_u64_le_bytes(pool.bytes, bits)
        i = i + 1
    }
    // §M8 feature C — named-rodata-tables (`rotab_<id>`) share the `__TEXT,__const`
    // 8-aligned section with the float pool (both S_REGULAR binary-double blobs). Each
    // table is ONE label at its pool offset with the full LE-double payload (already
    // hex-encoded by the codegen `_arm64_u64hex_list_to_le_payload`). Float entries are
    // 8 bytes each + table payloads are whole 8-byte-multiple, so `len(pool.bytes)`
    // stays 8-aligned (no inter-entry padding needed). Off the byteeq path lm.rodata
    // has no rotab sections → this loop adds nothing → __const byte-stable.
    let rn = len(lm.rodata)
    let mut ri = 0
    while ri < rn {
        let sec = lm.rodata[ri]
        if _is_rotab_section(sec.name) {
            pool.labels.push(sec.name)
            pool.offsets.push(len(pool.bytes))
            _append_hex_bytes(pool.bytes, sec.bytes)
        }
        ri = ri + 1
    }
    return pool
}

// Build the `__DATA,__data` module-global pool (PR-C1) from `lm.globals`.
// Each entry is a 16-byte zero-initialized HexaVal slot (8-aligned),
// symbol name = the raw `g<id>` string (matches the `.s` path's
// `g<id>: .quad 0 / .quad 0`). `offsets[i]` is the slot's pool offset
// (= N_SECT value once the __data section vmaddr is added).
fn _build_gdata_pool(lm: LModule) -> CstrPool {
    let pool = CstrPool { bytes: [], labels: [], offsets: [] }
    let n = len(lm.globals)
    let mut i = 0
    while i < n {
        pool.labels.push(lm.globals[i])
        pool.offsets.push(len(pool.bytes))
        // 16-byte zero HexaVal slot.
        let mut z = 0
        while z < 16 { pool.bytes.push(0); z = z + 1 }
        i = i + 1
    }
    return pool
}

// Public entry — walk all LFuncs in `lm`, produce a `MachoArm64Obj`
// with `text` + `symbols` + `strtab` + `relocs` populated.
//
// Symbol table contract (cycle 3):
//   - First byte of `strtab` is NUL (Mach-O index-0 convention).
//   - Each `LFunc` produces one `MachoSymbol` with:
//       name_offset = strtab offset of `_<fn.name>\0` (darwin mangle)
//       section     = 1 (1-based index for __text)
//       value       = byte offset of fn start within __text
//       kind        = 0x0e (N_SECT — defined in a section)
//       is_external = 1 (N_EXT — externally visible)
//   - LC_DYSYMTAB.nextdefsym counts these; `serialize` derives it.
//
// Relocation contract (cycle 4):
//   - Each unresolved branch / call target (intra-fn label miss) in
//     any `LFunc` becomes one `Arm64Reloc` with:
//       offset   = __text byte offset of the patched instruction
//       sym_idx  = index into `symbols[]` of the target symbol
//                  (post-walk lookup by mangled name)
//       kind     = ARM64_RELOC_BRANCH26 (= 2) for B/BL targets
//       pcrel    = 1
//       length   = 2 (log2 of 4-byte instruction)
//   - `serialize()` hardcodes `r_extern=1` (we only emit symbol-based
//     relocs in cycle 4; section-based relocations enter in cycle 5).
//   - Intra-module callees (the target is one of `symbols[]`) and
//     external undefined symbols both share this path; symbol-table
//     layout decides which is which (cycle 4 ships defined-only; the
//     N_UNDF undef record path lands when a real frontend supplies an
//     undefined target).
// ─────────────────────────────────────────────────────────────────
// axis-② --isolate on Mach-O (darwin twin of elf_x86_64.hexa's
// _demote_partition / demote_nonkeep_to_local + isolate_lmodule_x86_64).
// The darwin branch previously ran NEITHER pass, so --keep-global --isolate
// left every imported-prelude fn N_PEXT-global → Case-B S5 ld -r multidef.
// N_PEXT does NOT prevent multidef (duplicate detection precedes ld64's
// output localization); the fix CLEARS N_EXT → pure N_SECT file-local.
// (Fable design: state/hexa-own/macho_isolate_demotion_fix_spec.md.)

// [u8]-strtab name reader (macho strtab is [u8]; _symh_name_at is [Int]-typed).
fn _macho_symh_name_at(strtab: [u8], off: Int) -> string {
    let mut s = ""
    let mut i = 0
    while (strtab[off + i] & 0xff) != 0 {
        s = s + from_char_code(strtab[off + i] & 0xff)
        i = i + 1
    }
    return s
}

// Demote non-keeplist DEFINED symbols to file-local (N_EXT clear) on Mach-O.
// Mirrors _demote_partition: locals-before-globals reorder is MANDATORY —
// serialize()'s LC_DYSYMTAB run layout hardcodes [locals|extdefs|undefs].
pub fn demote_nonkeep_to_local_macho(obj: MachoArm64Obj, keeplist: [string]) -> MachoArm64Obj {
    if len(keeplist) == 0 { return obj }
    // keeplist arrives unmangled (hexa_map_keys); macho symbols are `_`-prefixed.
    let mut mkeep: [string] = []
    let mut mi = 0
    while mi < len(keeplist) { mkeep.push(_darwin_mangle(keeplist[mi])); mi = mi + 1 }
    let syms = obj.symbols
    let ns = len(syms)
    // Pass A — classify: local iff already-local (is_external==0) OR a defined
    // (section!=0) external whose name is not kept. Undefs (section==0) + kept stay global.
    let mut want_local: [Int] = []
    let mut nloc = 0
    let mut ci = 0
    while ci < ns {
        let s = syms[ci]
        let mut loc = 0
        if s.is_external == 0 { loc = 1 }
        if s.is_external == 1 && s.section != 0 {
            if !_kg_in_list(mkeep, _macho_symh_name_at(obj.strtab, s.name_offset)) { loc = 1 }
        }
        want_local.push(loc)
        nloc = nloc + loc
        ci = ci + 1
    }
    // Pass B — old→new permutation: locals [0,nloc) then globals [nloc,ns), original order.
    let mut old2new: [Int] = []
    let mut li = 0
    let mut gi = 0
    let mut pi = 0
    while pi < ns {
        if want_local[pi] == 1 { old2new.push(li); li = li + 1 }
        else { old2new.push(nloc + gi); gi = gi + 1 }
        pi = pi + 1
    }
    // Pass C — rebuild: local partition first (is_external:0, is_pext:0 → pure
    // N_SECT 0x0e), then global partition verbatim.
    let mut new_syms: [MachoSymbol] = []
    let mut si = 0
    while si < ns {
        if want_local[si] == 1 {
            let s = syms[si]
            new_syms.push(MachoSymbol {
                name_offset: s.name_offset,
                section:     s.section,
                value:       s.value,
                kind:        s.kind,
                is_external: 0,
                is_pext:     0,
            })
        }
        si = si + 1
    }
    let mut gsi = 0
    while gsi < ns {
        if want_local[gsi] == 0 {
            let s = syms[gsi]
            // Global partition = the keeplist (defined) + undefs. Force is_pext:0:
            // pack_lir marks every non-entry defined fn N_PEXT (.private_extern), but
            // the kept dispatchers are the seed's PUBLIC export contract — under ld -r a
            // private-extern is localized in the output, so runtime_core.c's call sites
            // (in other objects) could not resolve hexa_map_*. ELF keeps the keeplist
            // STB_GLOBAL (public); this is the darwin equivalent. Undefs are is_pext:0 anyway.
            new_syms.push(MachoSymbol {
                name_offset: s.name_offset,
                section:     s.section,
                value:       s.value,
                kind:        s.kind,
                is_external: s.is_external,
                is_pext:     0,
            })
        }
        gsi = gsi + 1
    }
    // Pass D — remap every reloc's sym_idx through the permutation.
    let mut new_relocs: [Arm64Reloc] = []
    let nrel = len(obj.relocs)
    let mut ri = 0
    while ri < nrel {
        let r = obj.relocs[ri]
        new_relocs.push(Arm64Reloc {
            offset:  r.offset,
            sym_idx: old2new[r.sym_idx],
            kind:    r.kind,
            pcrel:   r.pcrel,
            length:  r.length,
        })
        ri = ri + 1
    }
    return MachoArm64Obj {
        text:       obj.text,
        relocs:     new_relocs,
        symbols:    new_syms,
        strtab:     obj.strtab,
        dwarf_line: obj.dwarf_line,
        cstring:    obj.cstring,
        cflt:       obj.cflt,
        gdata:      obj.gdata,
    }
}

// LModule reachability prune (darwin twin of isolate_lmodule_arm64_elf) —
// keeplist-reachable closure with a carrier-boundary cut. Uses the macho
// _pack_fn (10-array harvest) to enumerate each kept fn's referenced names.
pub fn isolate_lmodule_macho(lm: LModule, keeplist: [string]) -> LModule {
    if len(keeplist) == 0 { return lm }
    let nf = len(lm.funcs)
    let mut queue: [string] = []
    let mut kept: [string] = []
    let mut ki = 0
    while ki < len(keeplist) {
        let root = keeplist[ki]
        let mut found = false
        let mut fi = 0
        while fi < nf {
            if lm.funcs[fi].name == root { found = true }
            fi = fi + 1
        }
        if !found {
            eprintln("hexa-compiler: --isolate FATAL: keeplist root '" + root + "' not defined in module")
            exit(2)
        }
        if !_kg_in_list(kept, root) {
            kept.push(root)
            queue.push(root)
        }
        ki = ki + 1
    }
    let mut qi = 0
    while qi < len(queue) {
        let fname = queue[qi]
        qi = qi + 1
        let mut fj = 0
        while fj < nf {
            if lm.funcs[fj].name == fname {
                let f = lm.funcs[fj]
                let s_text: [Int] = []
                let p_off: [Int] = []
                let p_names: [string] = []
                let pg_off: [Int] = []
                let pg_names: [string] = []
                let pg_kinds: [Int] = []
                let bl_names: [string] = []
                let bl_off: [Int] = []
                let bl_reforder: [string] = []
                _pack_fn(s_text, p_off, p_names, pg_off, pg_names, pg_kinds, bl_names, bl_off, bl_reforder, f)
                let mut chans: [string] = []
                let mut a = 0
                while a < len(p_names) { chans.push(p_names[a]); a = a + 1 }
                a = 0
                while a < len(pg_names) { chans.push(pg_names[a]); a = a + 1 }
                let mut ci = 0
                while ci < len(chans) {
                    let refn = chans[ci]
                    ci = ci + 1
                    if !_kg_in_list(kept, refn) {
                        let mut is_def = false
                        let mut dk = 0
                        while dk < nf {
                            if lm.funcs[dk].name == refn { is_def = true }
                            dk = dk + 1
                        }
                        if is_def && !(_iso_is_carrier(refn) && !_kg_in_list(keeplist, refn)) {
                            kept.push(refn)
                            queue.push(refn)
                        }
                    }
                }
            }
            fj = fj + 1
        }
    }
    let mut new_funcs: [LFunc] = []
    let mut ri = 0
    while ri < nf {
        if _kg_in_list(kept, lm.funcs[ri].name) {
            new_funcs.push(lm.funcs[ri])
        }
        ri = ri + 1
    }
    return LModule {
        file:    lm.file,
        target:  lm.target,
        funcs:   new_funcs,
        rodata:  lm.rodata,
        bss:     lm.bss,
        globals: lm.globals,
        floats:  lm.floats,
    }
}

pub fn pack_lir(lm: LModule) -> MachoArm64Obj {
    let obj = MachoArm64Obj {
        text:       [],
        relocs:     [],
        symbols:    [],
        strtab:     [],
        dwarf_line: [],
        cstring:    [],
        cflt:       [],
        gdata:      [],
    }

    // ── Pass 0: build the data pools. ──
    //   __cstring  ← rodata `.LCstr*`  (PR-A)
    //   __const    ← lm.floats `.LCflt*` 8-byte doubles (PR-C2)
    //   __data     ← lm.globals `g<id>` 16-byte HexaVal slots (PR-C1)
    // Each pool's labels become local N_SECT symbols at their pool
    // offset; the `@PAGE`/`@PAGEOFF` reloc pair resolves against them.
    // Empty pools keep the prior layout byte-stable (the section + its
    // symbols are simply not emitted).
    let cpool = _build_cstr_pool(lm)
    let has_cstr = len(cpool.bytes) > 0
    let mut ci = 0
    while ci < len(cpool.bytes) { obj.cstring.push(cpool.bytes[ci]); ci = ci + 1 }

    let fpool = _build_flt_pool(lm)
    let has_cflt = len(fpool.bytes) > 0
    let mut fi0 = 0
    while fi0 < len(fpool.bytes) { obj.cflt.push(fpool.bytes[fi0]); fi0 = fi0 + 1 }

    let gpool = _build_gdata_pool(lm)
    let has_gdata = len(gpool.bytes) > 0
    let mut gi0 = 0
    while gi0 < len(gpool.bytes) { obj.gdata.push(gpool.bytes[gi0]); gi0 = gi0 + 1 }

    // Section indices in clang emission order:
    //   1 __text · [__cstring] · [__const] · [__data] · __cap · __abi
    // Each optional data section, when present, shifts every later
    // section's 1-based index up by one. `__text` is always 1.
    let mut sect_cstr  = 0
    let mut sect_const = 0
    let mut sect_data  = 0
    let mut next_sect  = 2
    if has_cstr  { sect_cstr  = next_sect; next_sect = next_sect + 1 }
    if has_cflt  { sect_const = next_sect; next_sect = next_sect + 1 }
    if has_gdata { sect_data  = next_sect; next_sect = next_sect + 1 }
    let sect_cap = next_sect
    let sect_abi = next_sect + 1

    // ── Pass 1: walk every LFunc → text bytes + collect symbol inputs ──
    //
    // We defer ALL symbol-table construction until the walk is done so
    // the table can be laid out in clang/LLVM-MC's order (locals, then
    // defined-externs, then undefs) — required for `r_symbolnum` parity.
    let pending_offsets: [Int]    = []   // __text offset of each extern BL
    let pending_names:   [string] = []   // target name per extern BL
    // Page-relative refs (ADRP/ADD/LDR `@PAGE`/`@PAGEOFF`/GOT) — parallel
    // to the BRANCH26 pending arrays but carrying a per-site reloc KIND.
    let pending_page_offsets: [Int]    = []
    let pending_page_names:   [string] = []
    let pending_page_kinds:   [Int]    = []
    let blabel_names:    [string] = []   // every block label (def order)
    let blabel_offsets:  [Int]    = []   // its __text offset
    let blabel_reforder: [string] = []   // labels in first-branch-ref order
    let fn_names:        [string] = []   // mangled fn symbol names
    let fn_values:       [Int]    = []   // fn start offset in __text
    let fn_is_entry:     [Int]    = []   // 1 if main/_start (no N_PEXT)

    let nf = len(lm.funcs)
    let mut i = 0
    while i < nf {
        let f = lm.funcs[i]
        fn_names.push(_darwin_mangle(f.name))
        fn_values.push(len(obj.text))
        if _is_entry_symbol_name(f.name) { fn_is_entry.push(1) } else { fn_is_entry.push(0) }
        _pack_fn(obj.text, pending_offsets, pending_names,
                 pending_page_offsets, pending_page_names, pending_page_kinds,
                 blabel_names, blabel_offsets, blabel_reforder, f)
        i = i + 1
    }
    // #3712 — `fn_names` membership map, precomputed ONCE here so the Pass-2
    // and Pass-4 `_str_in(fn_names, …)` linear scans (O(fn) per pending call →
    // O(calls·fn)) become O(1) `has_key`. Byte-NEUTRAL: `has_key` returns the
    // same bool `_str_in` did. Uses the same `{}`+`has_key` primitive as
    // `_build_merged_strtab`'s `seen` set. `fn_names` is fully populated above
    // and never mutated after, so one precompute serves both passes.
    let mut fn_names_set = {}
    let mut fnsi = 0
    while fnsi < len(fn_names) {
        fn_names_set[fn_names[fnsi]] = true
        fnsi = fnsi + 1
    }

    let text_len = len(obj.text)
    let mut text_pad = 0
    let trem = text_len & 3
    if trem != 0 { text_pad = 4 - trem }
    // Contiguous section vmaddr layout (must match `serialize`'s
    // _data_section_layout EXACTLY so every N_SECT symbol value lines up):
    //   __text   @ 0 .. text_size_aligned (4-align)
    //   __cstring@ cstr_base, align 1
    //   __const  @ const_base, align 8 (.LCflt doubles)
    //   __data   @ data_base, align 8 (g<id> HexaVal slots)
    //   __cap/__abi @ meta_addr
    // Walk the running vmaddr, only advancing (and 8-aligning) for
    // sections that are actually present, so an absent section is a
    // pure no-op (keeps the prior layout byte-stable).
    let cstr_base = text_len + text_pad
    let mut cursor = cstr_base
    if has_cstr { cursor = cstr_base + len(cpool.bytes) }
    let mut const_base = 0
    if has_cflt { const_base = _align_up8(cursor); cursor = const_base + len(fpool.bytes) }
    let mut data_base = 0
    if has_gdata { data_base = _align_up8(cursor); cursor = data_base + len(gpool.bytes) }
    let meta_addr = cursor

    // ── Pass 2: partition extern BL targets into intra-module-defined
    // (pre-patch, no reloc) vs undefined (sorted, get a reloc). ──
    //
    // Defined intra-module callees: BL imm26 resolved at emit time, NO
    // reloc (matches clang). Undefined externs (libc/runtime _hexa_*):
    // imm26 stays 0, a BRANCH26 reloc carries the symbol — and clang
    // emits the undef symbols ALPHABETICALLY, so we sort them and the
    // reloc `r_symbolnum` references that sorted slot.
    let undef_names: [string] = []
    let mut pi = 0
    let np = len(pending_offsets)
    while pi < np {
        let raw = pending_names[pi]
        let mut name = raw
        // Every call target is a hexa/C IDENTIFIER that needs the Mach-O ABI
        // `_` prefix. An intra-module fn is DEFINED as `_darwin_mangle(name)`,
        // so resolve to that mangled form (handles `_`-prefixed compiler fns
        // like `_arm64_emit_imm_to_reg` → `__arm64_…`, #2316). EVERY other
        // (external/runtime) target ALSO needs the ABI `_`, including the
        // `_`-prefixed runtime C identifiers: `__raw_idiv` is compiled by the C
        // runtime to the Mach-O symbol `___raw_idiv` (3 underscores), so the
        // ref must be `_darwin_mangle("__raw_idiv")` too. The old guard skipped
        // `_`-prefixed externals → off-by-one underscore (`__raw_idiv` ref vs
        // `___raw_idiv` def) → every `__raw_*`/`__map_*` runtime ref UNDEFINED
        // at link (the N5-sym wall). Always ABI-prefix.
        let cand = _darwin_mangle(raw)
        if has_key(fn_names_set, cand) {
            name = cand
        } else if len(raw) > 0 {
            name = _darwin_mangle(raw)
        }
        // Defined intra-module target? (one of this module's fns)
        if has_key(fn_names_set, name) {
            pi = pi + 1
            continue
        }
        if !_str_in(undef_names, name) { undef_names.push(name) }
        pi = pi + 1
    }
    _sort_strings(undef_names)   // alphabetical — matches clang's undef order

    // ── Pass 3: build the symbol table in clang's order ──
    //
    //   LOCALS (n_type N_SECT, no N_EXT):
    //     ltmp0                 (__text, value 0)        — section-start temp
    //     <block labels>        (__text)  in first-ref order, entry-first
    //     ltmp1                 (__cap,  value meta_addr)
    //     _hexa_cap_manifest    (__cap,  value meta_addr)
    //     ltmp2                 (__abi,  value meta_addr)
    //     _hexa_abi_stamp       (__abi,  value meta_addr)
    //   EXTDEFS (N_SECT|N_EXT [|N_PEXT for non-entry]):
    //     each fn, in address order
    //   UNDEFS (N_UNDF|N_EXT), alphabetical:
    //     each runtime/libc target
    //
    // strtab is NOT built name-by-name in symbol order any more: we
    // collect every symbol's name into `sym_names` (parallel to
    // `obj.symbols`) with a placeholder `name_offset`, then after the
    // table is complete run `_build_merged_strtab` — clang/LLVM's
    // MCStringTableBuilder suffix-merge interning — to lay out the
    // bytes and assign each `n_strx` to its merged offset. This makes
    // the strtab byte-order + every `n_strx` + the natural `strsize`
    // byte-identical to clang (the symbol IDENTITIES, ORDER, n_type/
    // n_sect/n_value, and `r_symbolnum` indices already matched).
    let sym_names: [string] = []

    // ltmp0 (__text section-start temp).
    _push_local_sym(obj, sym_names, "ltmp0", 1, 0)

    // Block labels: entry (first-defined) first, then first-ref order.
    let ordered_labels: [string] = []
    if len(blabel_names) > 0 {
        ordered_labels.push(blabel_names[0])   // entry block (bb0)
    }
    let mut li = 0
    while li < len(blabel_reforder) {
        let nm = blabel_reforder[li]
        if !_str_in(ordered_labels, nm) { ordered_labels.push(nm) }
        li = li + 1
    }
    // Any defined-but-never-branched labels: append in definition order
    // (defensive — keeps every label represented).
    li = 0
    while li < len(blabel_names) {
        let nm = blabel_names[li]
        if !_str_in(ordered_labels, nm) { ordered_labels.push(nm) }
        li = li + 1
    }
    li = 0
    while li < len(ordered_labels) {
        let nm  = ordered_labels[li]
        let voff = _blabel_offset_of(blabel_names, blabel_offsets, nm)
        // The block-label SYMBOL name carries the darwin mangle the `.s`
        // path applies via `_fmt_label` (prepend `_`): LIR stores
        // `_L<hash>_<fn>_bb<n>`, the symbol is `__L<hash>…`. The raw
        // form (`nm`) is kept only for offset/reference lookup above.
        _push_local_sym(obj, sym_names, _darwin_mangle_label(nm), 1, voff)
        li = li + 1
    }

    // `__cstring` literal-pool symbols — one local N_SECT per `.LCstr*`
    // (section 2). The ADRP/ADD `@PAGE`/`@PAGEOFF` reloc pair (PR-B)
    // resolves against these. A Mach-O N_SECT symbol's `n_value` is the
    // section-relative VIRTUAL ADDRESS, not a bare in-section offset:
    // `__text` syms work with a plain offset only because __text.vmaddr
    // is 0, but `__cstring` sits at vmaddr `cstr_base` (= 4-aligned end
    // of __text), so each label's value = cstr_base + pool_offset.
    // (Without this ld64 rejects: ".LCstr0 ... address isn't in its
    // designated section".) The label name carries the `.LCstr` form
    // verbatim (no `_` mangle — section-local L symbol). `cstr_base` /
    // `const_base` / `data_base` were computed in the layout block above.
    if has_cstr {
        let mut pli = 0
        while pli < len(cpool.labels) {
            _push_local_sym(obj, sym_names, cpool.labels[pli], sect_cstr, cstr_base + cpool.offsets[pli])
            pli = pli + 1
        }
    }
    // `__TEXT,__const` float-pool symbols — one local N_SECT per `.LCflt*`
    // (PR-C2). Value = const_base (section vmaddr) + pool offset.
    if has_cflt {
        let mut fli = 0
        while fli < len(fpool.labels) {
            _push_local_sym(obj, sym_names, fpool.labels[fli], sect_const, const_base + fpool.offsets[fli])
            fli = fli + 1
        }
    }
    // `__DATA,__data` module-global symbols — one local N_SECT per
    // `g<id>` (PR-C1). Value = data_base (section vmaddr) + slot offset.
    if has_gdata {
        let mut dli = 0
        while dli < len(gpool.labels) {
            _push_local_sym(obj, sym_names, gpool.labels[dli], sect_data, data_base + gpool.offsets[dli])
            dli = dli + 1
        }
    }

    // __HEXA section local symbols (cap then abi; ltmpN temp precedes
    // the named label in each, matching clang's per-section temp).
    // Section indices shift down one when `__cstring` is present.
    _push_local_sym(obj, sym_names, "ltmp1",              sect_cap, meta_addr)
    _push_local_sym(obj, sym_names, "_hexa_cap_manifest", sect_cap, meta_addr)
    _push_local_sym(obj, sym_names, "ltmp2",              sect_abi, meta_addr)
    _push_local_sym(obj, sym_names, "_hexa_abi_stamp",    sect_abi, meta_addr)

    // Defined externs (functions) — address order, N_PEXT for non-entry.
    let mut fi = 0
    while fi < len(fn_names) {
        let mut pext = 1
        if fn_is_entry[fi] != 0 { pext = 0 }
        sym_names.push(fn_names[fi])
        obj.symbols.push(MachoSymbol {
            name_offset: -1,
            section:     1,
            value:       fn_values[fi],
            kind:        MACHO_N_SECT,
            is_external: 1,
            is_pext:     pext,
        })
        fi = fi + 1
    }

    // Undefined externs — alphabetical (sorted above).
    let mut ui = 0
    while ui < len(undef_names) {
        sym_names.push(undef_names[ui])
        obj.symbols.push(MachoSymbol {
            name_offset: -1,
            section:     0,
            value:       0,
            kind:        MACHO_N_UNDF,
            is_external: 1,
            is_pext:     0,
        })
        ui = ui + 1
    }

    // ── Pass 3b: MCStringTableBuilder suffix-merge interning ──
    //
    // All symbol records are placed; lay out the merged string table
    // and back-patch every `name_offset` to its merged offset (clang
    // byte-order). `obj.strtab` is left at its NATURAL size — the
    // trailing 8-byte file-end pad is applied in `serialize`, the only
    // place that knows `stroff`.
    let merged_offs = _build_merged_strtab(obj.strtab, sym_names)
    let mut mi = 0
    while mi < len(obj.symbols) {
        let s = obj.symbols[mi]
        obj.symbols[mi] = MachoSymbol {
            name_offset: merged_offs[mi],
            section:     s.section,
            value:       s.value,
            kind:        s.kind,
            is_external: s.is_external,
            is_pext:     s.is_pext,
        }
        mi = mi + 1
    }

    // ── Pass 4: resolve branches + page refs; emit relocs ──
    // A single reloc table carries BRANCH26 (calls) and PAGE21 /
    // PAGEOFF12 / GOT_LOAD (data addressing) records. Collected with a
    // parallel kind list, then flushed in DESCENDING address order
    // (clang's __text relocation table is emitted high-address-first).
    let reloc_offs:  [Int] = []
    let reloc_idxs:  [Int] = []
    let reloc_kinds: [Int] = []
    // Page targets that resolved to no symbol (PR-C scope: globals /
    // float pool). Reported (not silently dropped) after the walk.
    let pack_page_unresolved: [string] = []
    // #3712 — name→symtab-index memo cache shared by the BL (BRANCH26) + page
    // (PAGE21/PAGEOFF12/GOT) reloc walks, mirroring elf_x86_64/elf_arm64. The
    // raw `_find_sym_by_name` is an O(symbols) scan run once PER pending site →
    // O(sites·symbols). A name resolves DETERMINISTICALLY here (the symbol
    // table is FROZEN by Pass 3 — no push-on-miss in this pass), so memoizing
    // the first resolution per distinct name is byte-IDENTICAL: the same index
    // `_find_sym_by_name` would return. Memoize on a MISS only; -1 is never
    // cached (the BL pass always finds a defined/undef sym; the page pass's -1
    // is the loud-fail path, rare, left to re-scan). The two passes key on
    // disjoint name spaces (mangled `_…` idents vs `.LCstr*`/`_g*` labels), so
    // one shared cache is collision-free.
    let mut _symc_names: [string] = []
    let mut _symc_idx:   [Int]    = []
    pi = 0
    while pi < np {
        let off = pending_offsets[pi]
        let raw = pending_names[pi]
        let mut name = raw
        // Every call target is a hexa/C IDENTIFIER that needs the Mach-O ABI
        // `_` prefix. An intra-module fn is DEFINED as `_darwin_mangle(name)`,
        // so resolve to that mangled form (handles `_`-prefixed compiler fns
        // like `_arm64_emit_imm_to_reg` → `__arm64_…`, #2316). EVERY other
        // (external/runtime) target ALSO needs the ABI `_`, including the
        // `_`-prefixed runtime C identifiers: `__raw_idiv` is compiled by the C
        // runtime to the Mach-O symbol `___raw_idiv` (3 underscores), so the
        // ref must be `_darwin_mangle("__raw_idiv")` too. The old guard skipped
        // `_`-prefixed externals → off-by-one underscore (`__raw_idiv` ref vs
        // `___raw_idiv` def) → every `__raw_*`/`__map_*` runtime ref UNDEFINED
        // at link (the N5-sym wall). Always ABI-prefix.
        let cand = _darwin_mangle(raw)
        if has_key(fn_names_set, cand) {
            name = cand
        } else if len(raw) > 0 {
            name = _darwin_mangle(raw)
        }
        // Cached resolution first; fall back to the symtab scan on a miss,
        // then memoize on a MISS only (one entry per distinct name).
        let mut idx = _symc_lookup(_symc_names, _symc_idx, name)
        let was_cached = idx >= 0
        if idx < 0 {
            idx = _find_sym_by_name(obj.symbols, obj.strtab, name)
            if idx >= 0 {
                _symc_names.push(name)
                _symc_idx.push(idx)
            }
        }
        let sym = obj.symbols[idx]
        if sym.section != 0 {
            // Intra-module defined callee: pre-patch imm26, no reloc.
            let delta = (sym.value - off) / 4
            let w0 = obj.text[off + 0]
            let w1 = obj.text[off + 1]
            let w2 = obj.text[off + 2]
            let w3 = obj.text[off + 3]
            let cur = w0 | (w1 << 8) | (w2 << 16) | (w3 << 24)
            let patched = (cur & 0xfc000000) | (delta & 0x03ffffff)
            _patch_word_le(obj.text, off, patched)
        } else {
            reloc_offs.push(off)
            reloc_idxs.push(idx)
            reloc_kinds.push(MACHO_ARM64_RELOC_BRANCH26)
        }
        pi = pi + 1
    }

    // Page-relative refs (ADRP/ADD/LDR @PAGE/@PAGEOFF/GOT). Each resolves
    // against a SYMBOL in obj.symbols: the `.LCstr*` literals are defined
    // N_SECT locals (added in Pass 3); `_g*` data globals are defined
    // N_SECT (PR-C) or undefined externs. Symbol-based reloc (r_extern=1)
    // works for both — the linker computes the page/page-offset of the
    // target symbol's final address. The PAGE21 vs PAGEOFF12 vs GOT kind
    // is carried per-site from `_pack_fn`.
    let mut ppi = 0
    let npp = len(pending_page_offsets)
    while ppi < npp {
        let poff  = pending_page_offsets[ppi]
        let praw  = pending_page_names[ppi]
        let pkind = pending_page_kinds[ppi]
        // `.LCstr*` / `.LCflt*` local labels are stored verbatim in
        // symbols[]; `g<id>` data globals are defined as `_g<id>`. Try the
        // raw name first, then the ABI-mangled form.
        // Same #3712 memo cache as the BL pass, keyed on `praw` (the resolution
        // — raw-then-mangled — is deterministic per `praw`). Memoize on a MISS
        // only; the unresolved (-1) loud-fail path is never cached.
        let mut pidx = _symc_lookup(_symc_names, _symc_idx, praw)
        if pidx < 0 {
            pidx = _find_sym_by_name(obj.symbols, obj.strtab, praw)
            if pidx < 0 {
                pidx = _find_sym_by_name(obj.symbols, obj.strtab, _darwin_mangle(praw))
            }
            if pidx >= 0 {
                _symc_names.push(praw)
                _symc_idx.push(pidx)
            }
        }
        if pidx < 0 {
            // Unknown page target (not a `.LCstr*` literal, a block
            // label, or a known global). PR-B's measured scope is
            // cstring-only; `g<id>` data globals + `.LCflt*` float pool
            // are PR-C. Skipping the reloc would silently mis-address, so
            // FAIL LOUDLY: leave the site UNRELOCATED but record the gap
            // via the pack diagnostic counter rather than fabricate a
            // binding. (A missing reloc shows as a 0-page ref in otool —
            // observable, not a hidden miscompile claim.)
            pack_page_unresolved.push(praw)
            ppi = ppi + 1
            continue
        }
        reloc_offs.push(poff)
        reloc_idxs.push(pidx)
        reloc_kinds.push(pkind)
        ppi = ppi + 1
    }

    // Flush all relocs in DESCENDING address order. Insertion-order the
    // (offset, idx, kind) triples high-address-first.
    let nr = len(reloc_offs)
    let mut order: [Int] = []
    let mut oi = 0
    while oi < nr { order.push(oi); oi = oi + 1 }
    // Selection-sort `order` by reloc_offs DESCENDING (nr is small).
    let mut a = 0
    while a < nr {
        let mut best = a
        let mut b = a + 1
        while b < nr {
            if reloc_offs[order[b]] > reloc_offs[order[best]] { best = b }
            b = b + 1
        }
        let tmp = order[a]
        order[a] = order[best]
        order[best] = tmp
        a = a + 1
    }
    let mut ri = 0
    while ri < nr {
        let e = order[ri]
        let k = reloc_kinds[e]
        // PAGEOFF12 / GOT_LOAD_PAGEOFF12 encode the LOW 12 bits of the
        // target's absolute address — they are NOT pc-relative (pcrel=0).
        // BRANCH26 / PAGE21 / GOT_LOAD_PAGE21 are pc-relative (pcrel=1).
        let mut pc = 1
        if k == MACHO_ARM64_RELOC_PAGEOFF12 || k == MACHO_ARM64_RELOC_GOT_LOAD_PAGEOFF12 { pc = 0 }
        obj.relocs.push(Arm64Reloc {
            offset:  reloc_offs[e],
            sym_idx: reloc_idxs[e],
            kind:    k,
            pcrel:   pc,
            length:  2,
        })
        ri = ri + 1
    }
    // Honest diagnostic: page refs that found no defining symbol (a
    // PR-C global / float-pool gap, NOT a silent miscompile). Surfaced
    // so the caller / verdict sees the real residual.
    if len(pack_page_unresolved) > 0 {
        eprintln("pack_lir: " + to_string(len(pack_page_unresolved)) + " page ref(s) unresolved (PR-C: globals/floats) e.g. " + pack_page_unresolved[0])
    }
    return obj
}

// Push one local (N_SECT, non-external) symbol. The name is appended
// to `sym_names` (parallel to `obj.symbols`); `name_offset` is a
// placeholder (-1) back-patched after `_build_merged_strtab`. Used for
// ltmp* temps, block labels, and the `__HEXA` section symbols.
fn _push_local_sym(obj: MachoArm64Obj, sym_names: [string], name: string, section: Int, value: Int) {
    sym_names.push(name)
    obj.symbols.push(MachoSymbol {
        name_offset: -1,
        section:     section,
        value:       value,
        kind:        MACHO_N_SECT,
        is_external: 0,
        is_pext:     0,
    })
}

// In-place ASCII ascending sort (insertion sort — the undef list is
// short: one entry per distinct runtime/libc call). Matches clang's
// alphabetical undef-symbol ordering.
fn _sort_strings(xs: [string]) {
    let n = len(xs)
    let mut i = 1
    while i < n {
        let key = xs[i]
        let mut j = i - 1
        while j >= 0 && xs[j] > key {
            xs[j + 1] = xs[j]
            j = j - 1
        }
        xs[j + 1] = key
        i = i + 1
    }
}

// ─────────────────────────────────────────────────────────────────
// Notes for the P0 implementation sub-agent
// ─────────────────────────────────────────────────────────────────
//
// 1. `compiler/codegen/arm64_darwin.hexa` already chose registers
//    (linear-scan regalloc) and instruction mnemonics. Do NOT
//    re-decide; just encode what is there.
//
// 2. `compiler/emit/asm.hexa` emits the same instructions as `.s`
//    text. Mirror its structure (per-function loop, per-stmt switch)
//    and replace each `out = out + "<asm string>\n"` with a call to
//    `encode_arm64_insn(op, operands)` + append-bytes to `text`.
//
// 3. F-P0-OBJEQ falsifier corpus is in RFC 063 § P0; build it under
//    `compiler/test/macho_p0_corpus/` when implementing.
//
// 4. After F-P0-OBJEQ passes, wire into `compiler/main.hexa` next to
//    the existing `--emit=asm` arm: add `--emit=obj` that calls
//    `emit_macho_arm64` instead of `emit_asm` + `as`.
//
// 5. The `as` fork at `compiler/main.hexa:806` remains the fallback
//    until F-P0-OBJEQ corpus stabilizes; flip after.
