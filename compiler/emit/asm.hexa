// HEXA Native Compiler — emit pass: LIR → asm text  [Phase B-ish]
//
// @version 0.1.0
// @capabilities [pure]
//
// Serializes a post-codegen LModule into native assembly text (.s file
// content) suitable for the system assembler (`as`). RFC-018 §3 / §10.
//
// Pure-text output. No external assembler invocation — that's the linker
// pass. Output is deterministic: identical LModule yields identical bytes
// (so file hashing / cache keys remain stable).
//
// Targets dispatched on `module.target`:
//   arm64-apple-darwin → Mach-O / Apple ARM64 syntax
//                        labels prefixed with '_', ';' comments,
//                        __TEXT,__text + __TEXT,__const sections
//   x86_64-linux-gnu   → ELF / GAS Intel syntax (`.intel_syntax noprefix`)
//                        bare labels, '#' comments, .text + .rodata sections
//
// Public API:
//   pub fn emit_asm(module: LModule) -> string
//
// Constraints (per task brief):
//   - LIR struct shape must not change (no new fields)
//   - parser/lexer/IR shapes untouched
//   - emit only — link is a separate pass

import "../ir/lir.hexa"

// ── Target enum (string-tagged for stage0) ───────────────────

pub let TARGET_DARWIN_ARM64 = "arm64-apple-darwin"
pub let TARGET_LINUX_X86_64 = "x86_64-linux-gnu"
pub let TARGET_LINUX_ARM64  = "arm64-linux-gnu"
pub let TARGET_THUMBV7EM_HF  = "thumbv7em-none-eabihf"

// ── Operand formatting ──────────────────────────────────────

fn _is_darwin(target: string) -> bool {
    return target == TARGET_DARWIN_ARM64
}

fn _is_thumb(target: string) -> bool {
    return target == TARGET_THUMBV7EM_HF
}

// SELFHOST-NEXT linux-arm64: the AArch64 *instruction* syntax (immediate
// `#N`, memory `[base, #off]`, register-list `{…}`) is shared between the
// Mach-O (arm64-apple-darwin) and ELF (arm64-linux-gnu) targets — the only
// platform deltas are the `_` label prefix, the section directives, and the
// reloc/visibility spelling, all of which still key off `_is_darwin`. This
// helper gates the AArch64 *assembly-syntax* branches so the ELF arm64 path
// renders `#42` / `[sp, #0]` instead of falling through to x86 Intel syntax.
fn _is_elf_arm64(target: string) -> bool {
    return target == TARGET_LINUX_ARM64
}

fn _is_arm64(target: string) -> bool {
    return _is_darwin(target) || _is_elf_arm64(target)
}

fn _label_prefix(target: string) -> string {
    if _is_darwin(target) { return "_" }
    return ""
}

fn _comment_marker(target: string) -> string {
    if _is_darwin(target) { return " ; " }
    if _is_thumb(target) { return " @ " }   // ARM/Thumb assembler line comment
    // ELF AArch64 (GNU as): `#` is the immediate prefix, NOT a comment
    // char — a trailing `# …` is parsed as instruction operands and
    // errors. AArch64 GNU as uses `//` for line comments.
    if _is_elf_arm64(target) { return " // " }
    return " # "   // x86_64 GAS line comment
}

// Apple ARM64 uses bare `x0`, `w0`, `sp`, etc.
// GAS Intel for x86_64 uses bare `rax`, `eax`, etc. (no `%` with intel_syntax noprefix)
fn _fmt_reg(target: string, reg: PReg) -> string {
    return reg.name
}

fn _fmt_imm(target: string, imm: i64) -> string {
    if _is_arm64(target) {
        // AArch64 immediates: `#42` (Apple Mach-O + ELF GNU as alike)
        return "#" + to_string(imm)
    }
    if _is_thumb(target) {
        // ARM Thumb-2 immediates: `#42` (same syntax as ARM64 / GAS .arm)
        return "#" + to_string(imm)
    }
    // Intel x86 immediates: bare integer. RT-NATIVE #3430 root: `to_string`
    // drops the sign for a negative i64, so a negative const_int (e.g. an
    // MStmt `target_block: -7001`) rendered as an EMPTY operand (`mov rax,`),
    // the whole-compiler unknown-token error class. Emit the sign explicitly —
    // `mov rax, -7001` is valid x86. (0 - imm is safe for the small negative
    // block-ids / sentinels in question.)
    if imm < 0 { return "-" + to_string(0 - imm) }
    return to_string(imm)
}

fn _fmt_mem(target: string, op: LOperand) -> string {
    // RFC 070 G7-A.native impl emit (2026-05-20): label-as-offset
    // memory operand (e.g. `[Xn, sym@GOTPAGEOFF]` for arm64 GOT load
    // in `--shared` mode). Honored on every target so the same
    // helper covers both arm64-darwin (`@GOTPAGEOFF`) and a future
    // x86_64 RIP-relative emission. Carve-out is benign for the
    // baseline path — every existing `_arm64_op_mem` / `_x86_op_mem`
    // call passes `label=""`, so the integer-offset branch below
    // continues to render identically.
    if len(op.label) > 0 {
        // The label-as-offset symbol (e.g. `environ@GOTPAGEOFF` /
        // `g<id>@GOTPAGEOFF`) is a SYMBOL reference and must carry the SAME
        // per-target mangling its sibling `adrp …@GOTPAGE` (a `kind="label"`
        // operand) already gets via _fmt_label — otherwise on darwin the adrp
        // references `_environ` while the ldr references the un-mangled
        // `environ`, a symbol mismatch that fails to assemble/link. Routing the
        // inner symbol through _fmt_label fixes both this Route C named-data GOT
        // load and the latent (previously asm-text-unexercised) `--shared`
        // module-global GOT path. _fmt_label's `[`/`{`/`#`/`.` carve-outs leave
        // any non-symbol literal untouched; byteeq-neutral (the baseline
        // shared==0 corpus never sets `op.label`, so this branch is dead there).
        return "[" + op.mem_base.name + ", " + _fmt_label(target, op.label) + "]"
    }
    if _is_arm64(target) {
        // AArch64 memory: `[base, #offset]` — always emit the explicit
        // `#offset`, even at offset 0, so the C7 spill stores for arg 9
        // land as `[sp, #0]` (matches tests/m0/many_args_test.hexa).
        // Identical syntax for Mach-O (darwin) and ELF (linux-gnu).
        return "[" + op.mem_base.name + ", #" + to_string(op.mem_offset) + "]"
    }
    if _is_thumb(target) {
        // ARM Thumb-2 memory: `[base, #offset]` — same shape as ARM64.
        return "[" + op.mem_base.name + ", #" + to_string(op.mem_offset) + "]"
    }
    // Intel x86 memory: `[base + offset]`
    if op.mem_offset == 0 {
        return "[" + op.mem_base.name + "]"
    }
    if op.mem_offset > 0 {
        return "[" + op.mem_base.name + " + " + to_string(op.mem_offset) + "]"
    }
    // negative offset → `[base - N]`
    return "[" + op.mem_base.name + " - " + to_string(0 - op.mem_offset) + "]"
}

fn _fmt_label(target: string, label: string) -> string {
    // Single injective hexa→Mach-O mangling, applied identically at
    // every definition (_globl_directive / _func_label / block-label
    // pseudo) and every reference (bl/b/cbz/adrp targets). The darwin
    // "_" is prepended UNCONDITIONALLY (no leading-"_" skip): hexa
    // treats `foo` and `_foo` as distinct identifiers, so the prefix
    // must be injective — `foo`→`_foo`, `_foo`→`__foo`. The old
    // skip-if-leading-"_" collapsed `_foo` def(`__foo`) vs ref(`_foo`)
    // → 583 undefined at stage-2 link. Carve-outs (verbatim): rodata
    // /directive-like `.LCstr…@PAGE`, addressing `[sp],#16`, reg-list
    // `{…}`, immediates `#…`. Runtime C names (hexa_*) carry no leading
    // "_" → `_hexa_*`, matching clang's Mach-O symbol for runtime.c.
    let cs = label.chars()
    if len(cs) == 0 { return label }
    let first = cs[0]
    if first == "." { return label }   // directive-like / .LCstr@PAGE
    if first == "[" { return label }   // raw addressing-mode literal
    if first == "{" { return label }   // ARM register list literal
    if first == "#" { return label }   // immediate literal (incl. `#h, lsl #N`)
    if _is_darwin(target) { return "_" + label }
    return label
}

// Some opcodes carry a non-symbol identifier as one of their operands,
// e.g. arm64 `cset Xd, <cond>` where `<cond>` is `eq`/`ne`/`lt`/.../`ge`.
// These must render bare — never platform-prefixed — even though they
// are typed in LIR as `kind="label"`. Centralise the list here so both
// emit-side and codegen-side stay in sync.
fn _is_cc_carrying_op(op: string) -> bool {
    if op == "cset"    { return true }
    if op == "csel"    { return true }
    if op == "csinc"   { return true }
    if op == "csinv"   { return true }
    if op == "csneg"   { return true }
    return false
}

fn _fmt_operand(target: string, op: LOperand) -> string {
    if op.kind == "reg" {
        let r = _fmt_reg(target, op.reg)
        // DIAG (RT-NATIVE #3429): a blank reg name renders an empty operand
        // (`mov rdx,`/`cmp r12,`) — the x86_64 whole-compiler unknown-token
        // error class. Surface it so the origin is inspectable instead of a
        // silent blank. (A correct emit never produces a blank reg name.)
        if len(r) == 0 { return "<EMPTY_REG_op>" }
        return r
    }
    if op.kind == "imm"   { return _fmt_imm(target, op.imm) }
    if op.kind == "mem"   { return _fmt_mem(target, op) }
    if op.kind == "label" {
        let l = _fmt_label(target, op.label)
        if len(l) == 0 { return "<EMPTY_LABEL_op>" }
        return l
    }
    // Unknown kind — emit a placeholder so output is still inspectable.
    return "<?" + op.kind + "?>"
}

fn _fmt_operand_for_op(target: string, parent_op: string, idx: i64, op: LOperand) -> string {
    if op.kind == "label" && _is_cc_carrying_op(parent_op) && idx > 0 {
        return op.label
    }
    return _fmt_operand(target, op)
}

fn _fmt_args(target: string, args: [LOperand]) -> string {
    let mut out = ""
    let mut i = 0
    while i < len(args) {
        if i > 0 { out = out + ", " }
        out = out + _fmt_operand(target, args[i])
        i = i + 1
    }
    return out
}

fn _fmt_args_for_op(target: string, parent_op: string, args: [LOperand]) -> string {
    let mut out = ""
    let mut i = 0
    while i < len(args) {
        if i > 0 { out = out + ", " }
        out = out + _fmt_operand_for_op(target, parent_op, i, args[i])
        i = i + 1
    }
    return out
}

// ── Instruction line ────────────────────────────────────────

fn _fmt_instr(target: string, instr: LInstr) -> string {
    // Pseudo-op "label": codegen marks block boundaries with op="label" and
    // the label name in instr.comment (no real arg). Render as a bare
    // assembler label `Lname:` on its own line — no mnemonic, no comment
    // marker — so `as` does not see "label" as an instruction.
    if instr.op == "label" {
        let mut name = instr.comment
        if len(name) == 0 && len(instr.args) > 0 {
            name = instr.args[0].label
        }
        // Route through the same mangler as every reference so a block
        // label's definition and its b/cbz targets stay byte-identical
        // (def==ref invariant — required now that _fmt_label always
        // prefixes; previously def was raw and ref skipped leading "_").
        return _fmt_label(target, name) + ":"
    }
    let mut line = "    " + instr.op
    if len(instr.args) > 0 {
        line = line + " " + _fmt_args_for_op(target, instr.op, instr.args)
    }
    if len(instr.comment) > 0 {
        line = line + _comment_marker(target) + instr.comment
    }
    return line
}

// ── Section directives ──────────────────────────────────────

fn _text_section_directive(target: string) -> string {
    if _is_darwin(target) {
        return ".section __TEXT,__text,regular,pure_instructions"
    }
    if _is_thumb(target) {
        // ELF text section — same as Linux ELF; the `.thumb_func`
        // marker lives at the function-label site, not the section
        // header.
        return ".section .text"
    }
    return ".text"
}

fn _rodata_section_directive(target: string) -> string {
    if _is_darwin(target) {
        return ".section __TEXT,__const"
    }
    return ".section .rodata"
}

// RFC061 Route C Wall 3-c helpers — decode the `slot_<id>__sz<N>` self-static
// label encoding (codegen_x86_64_linux / codegen_arm64_darwin push these onto
// LModule.globals). `_hxss_sz_pos` returns the char index of the LAST `__sz`
// marker (or -1 if absent — an ordinary `g<id>` global). `_hxss_sym` rebuilds the
// symbol head (chars [0, pos)); `_hxss_size` parses the decimal tail (chars after
// pos+4). All char-walk (no .substr — keeps the emitter stage0-portable & avoids
// any method-availability surprise). Byte-eq NEUTRAL: only fires for `slot_…__sz…`
// labels, never present on the byteeq path.
fn _hxss_sz_pos(s: string) -> i64 {
    let cs = s.chars()
    let n = len(cs)
    let mut found = -1
    let mut i = 0
    while i + 3 < n {
        if cs[i] == "_" && cs[i + 1] == "_" && cs[i + 2] == "s" && cs[i + 3] == "z" {
            found = i
        }
        i = i + 1
    }
    return found
}

fn _hxss_sym(s: string, pos: i64) -> string {
    let cs = s.chars()
    let mut out = ""
    let mut i = 0
    while i < pos {
        out = out + cs[i]
        i = i + 1
    }
    return out
}

fn _hxss_size(s: string, pos: i64) -> i64 {
    let cs = s.chars()
    let n = len(cs)
    let mut v = 0
    let mut i = pos + 4                            // skip the `__sz` marker
    while i < n {
        let c = cs[i]
        if c == "0" { v = v * 10 + 0 }
        else { if c == "1" { v = v * 10 + 1 }
        else { if c == "2" { v = v * 10 + 2 }
        else { if c == "3" { v = v * 10 + 3 }
        else { if c == "4" { v = v * 10 + 4 }
        else { if c == "5" { v = v * 10 + 5 }
        else { if c == "6" { v = v * 10 + 6 }
        else { if c == "7" { v = v * 10 + 7 }
        else { if c == "8" { v = v * 10 + 8 }
        else { if c == "9" { v = v * 10 + 9 }
        }}}}}}}}}
        i = i + 1
    }
    return v
}

fn _bss_section_directive(target: string) -> string {
    if _is_darwin(target) {
        return ".section __DATA,__bss"
    }
    return ".bss"
}

// Writable initialized data — used for module-level mutable globals.
// __DATA,__bss is zerofill-only (no `.byte`/`.quad` allowed), so the
// globals live in a real __DATA,__data section with explicit zero
// quads; the runtime initializer (synthetic-main `g<id> = E`) writes
// the real value before any reader runs.
fn _data_section_directive(target: string) -> string {
    if _is_darwin(target) {
        return ".section __DATA,__data"
    }
    return ".section .data"
}

// NOTE (stage-3 blocker, characterized — NOT yet fixed here): def-side
// uses unconditional _label_prefix ("_" always) → injective (`foo`→
// `_foo`, `_foo`→`__foo`) but call sites use _fmt_label (skips a
// leading "_") → `_foo` ref = `_foo` ≠ def `__foo` ⇒ 583 undefined at
// stage-2 link. Routing defs through _fmt_label instead makes def==ref
// BUT collapses the distinct hexa identifiers `foo` and `_foo` to the
// same Darwin symbol ⇒ "already defined" (assemble fails — strictly
// worse). The real fix is a single injective hexa→Mach-O mangling
// applied identically at def + every ref (runtime/block/rodata labels
// excepted) — a dedicated codegen unit, not a tick-tail patch. Kept
// unconditional so the .s still assembles (the milestone) and the
// 583-undef precisely localises the same root cause.
fn _globl_directive(target: string, sym: string) -> string {
    return ".globl " + _fmt_label(target, sym)
}

fn _func_label(target: string, name: string) -> string {
    return _fmt_label(target, name) + ":"
}

// ── RFC 070 G7-A.visibility scaffold ────────────────────────
//
// Per-symbol visibility scoping — Mach-O `.private_extern <sym>` and
// ELF `.hidden <sym>`. Entry symbols (main / _start) keep default
// (publicly exported) visibility; every other emitted function carries
// the platform-specific hidden marker so downstream linkers can drop
// the symbol from the dynamic symbol table when producing PIE/shared
// artifacts.
//
// This is the codegen-side scaffold for RFC 070 §4 G7-A.visibility.
// emit_body for D1 (arm64) + D2 (x86_64) lives on sister branches
// (`d2-x86_64-emit-body`, harvest 8fdb29e2 / 9ea52f4b) and has not
// merged into this branch yet — the scaffold below is the
// branch-agnostic surface that those PRs converge on.
//
// Heuristic for entry detection: hexa lowers `fn main(...)` to the
// LFunc with `name == "main"`. POSIX/ELF entries also use `_start`.
// Everything else is internal-by-default. The heuristic is conservative
// (false-positive favours visibility, never silent hide) — a future
// cycle can attach an explicit `entry: bool` to LFunc once the IR
// shape is allowed to evolve (currently locked by the emit-only
// constraint at top of file).
fn _is_entry_symbol(name: string) -> bool {
    if name == "main"   { return true }
    if name == "_start" { return true }
    return false
}

// Returns the platform-specific hidden-visibility directive line
// (including trailing "\n"), or "" when the symbol is an entry or
// the target has no concept of visibility scoping (e.g. bare-metal
// Thumb-2). The caller must emit this AFTER `.globl` and BEFORE the
// function label — both Mach-O `as` and GNU `as` accept that order.
fn _visibility_directive(target: string, sym: string) -> string {
    if _is_entry_symbol(sym) { return "" }
    if _is_thumb(target)     { return "" }   // bare-metal: no dynamic table
    let mangled = _fmt_label(target, sym)
    if _is_darwin(target) {
        return ".private_extern " + mangled + "\n"
    }
    // ELF (x86_64-linux-gnu and any future ELF target)
    return ".hidden " + mangled + "\n"
}

// ── RFC 070 G7-D.codegen scaffold (capability + ABI sections) ─
//
// Emit two metadata sections per module:
//   __HEXA,__cap  (Mach-O)  /  .hexa.cap   (ELF)  — capability manifest
//   __HEXA,__abi  (Mach-O)  /  .hexa.abi   (ELF)  — 12-byte ABI stamp
//
// ABI stamp layout (RFC 070 §G7-D.B2, harvest c54b76f3):
//   offset 0  u32  runtime_version          (little-endian)
//   offset 4  u64  nanbox_layout_hash       (little-endian, FNV-1a)
//
// The capability payload depends on the `@plugin(capabilities=[...])`
// AST (parser harvest 9401be63) and the HXC v2 manifest encoder
// (stdlib/dynlink_caps.hexa, harvest 5f37a884). Both pre-merge on this
// branch as of 2026-05-20 — the codegen surface emits the section
// HEADERS unconditionally with an empty (zero-length) payload, so the
// `__HEXA,__cap` / `.hexa.cap` section is always present and
// downstream tooling (`hexa-ld` capability gate) sees an explicit
// no-capabilities decision instead of a silently-missing section.
//
// E3 audit cross-ref (10e87cd1) — D3 capability-bypass risk: a
// malformed manifest whose first cell is not `'H'` USED to silently
// parse-empty in dynlink_caps._parse_manifest, granting the loader a
// degenerate `caps=[]` decision indistinguishable from the
// honest-empty case. The follow-on cycle in the dynlink_caps SSOT
// (when the file merges to this branch) must flip that path to a
// `GateResult{kind:"parse_error"}` explicit reject. Recorded as
// punted in this cycle's commit — emitting the section header here
// makes the missing-vs-empty distinction observable from the linker
// side without depending on the not-yet-merged SSOT.

// CURRENT RUNTIME — bump on every wire-shape change.
let HEXA_RUNTIME_VERSION: i64 = 1

// NaN-boxing layout hash — placeholder constant. A future cycle will
// derive this from compiler/runtime/nanbox.hexa via FNV-1a over the
// 16-byte HexaVal struct shape (tag lo, payload hi). Holding a fixed
// constant here keeps the 12-byte stamp size invariant and lets
// downstream tooling exercise the parser before the hash function
// lands.
let HEXA_NANBOX_LAYOUT_HASH: i64 = 0  // populated in G7-D.B2 follow-on

// Hex string for one byte in the little-endian encoded ABI stamp.
fn _abi_byte_hex(byte: i64) -> string {
    let hi = (byte / 16) & 15
    let lo = byte & 15
    let mut s = ""
    if hi < 10 { s = s + to_string(hi) } else {
        if hi == 10 { s = s + "a" }
        if hi == 11 { s = s + "b" }
        if hi == 12 { s = s + "c" }
        if hi == 13 { s = s + "d" }
        if hi == 14 { s = s + "e" }
        if hi == 15 { s = s + "f" }
    }
    if lo < 10 { s = s + to_string(lo) } else {
        if lo == 10 { s = s + "a" }
        if lo == 11 { s = s + "b" }
        if lo == 12 { s = s + "c" }
        if lo == 13 { s = s + "d" }
        if lo == 14 { s = s + "e" }
        if lo == 15 { s = s + "f" }
    }
    return s
}

// Little-endian byte sequence for an i64, low n bytes only.
// n=4 → u32 runtime_version; n=8 → u64 nanbox_layout_hash.
fn _abi_le_bytes(value: i64, n: i64) -> string {
    let mut out = ""
    let mut i = 0
    let mut v = value
    while i < n {
        out = out + _abi_byte_hex(v & 255)
        v = v / 256
        i = i + 1
    }
    return out
}

// 12-byte ABI stamp = 4-byte runtime_version + 8-byte nanbox_layout_hash.
fn _abi_stamp_hex() -> string {
    return _abi_le_bytes(HEXA_RUNTIME_VERSION, 4) +
           _abi_le_bytes(HEXA_NANBOX_LAYOUT_HASH, 8)
}

fn _cap_section_directive(target: string) -> string {
    if _is_darwin(target) {
        return ".section __HEXA,__cap"
    }
    if _is_thumb(target) {
        return ""   // bare-metal: no capability gate
    }
    return ".section .hexa.cap,\"\",@progbits"
}

fn _abi_section_directive(target: string) -> string {
    if _is_darwin(target) {
        return ".section __HEXA,__abi"
    }
    if _is_thumb(target) {
        return ""   // bare-metal: no dynamic ABI surface
    }
    return ".section .hexa.abi,\"\",@progbits"
}

// Emit a complete section (header + label + hex bytes). Empty payload
// emits only the header — the section's mere presence is the signal.
fn _emit_meta_section(directive: string, label: string, payload_hex: string) -> string {
    if len(directive) == 0 { return "" }
    let mut out = directive + "\n"
    if len(label) > 0 {
        out = out + label + ":\n"
    }
    if len(payload_hex) > 0 {
        out = out + _emit_section_bytes(payload_hex)
    }
    return out
}

// ── Section payload (rodata / bss) ──────────────────────────
//
// LSection.bytes is hex-encoded payload (per LIR docstring). For
// stable, assembler-portable output we emit one `.byte 0xNN, 0xNN, ...`
// line per 16 bytes. Empty bytes string → just emit the label + align.

fn _hex_pair_to_byte(hex: [string], i: i64) -> string {
    // returns "0xHH" for the i-th byte (i is byte index, hex is char array)
    let hi = hex[i * 2]
    let lo = hex[i * 2 + 1]
    return "0x" + hi + lo
}

fn _emit_section_bytes(bytes_hex: string) -> string {
    let cs = bytes_hex.chars()
    let total_chars = len(cs)
    // Drop trailing odd char if any (defensive)
    let usable = total_chars - (total_chars % 2)
    let nbytes = usable / 2
    if nbytes == 0 { return "" }
    // PERF #4454-class: parts+join instead of `out = out + frag` per byte —
    // the '+' re-copied the whole accumulator each iteration, O(L²) per
    // section payload. join("") is a single length-summed alloc; output
    // text identical (same fragments in the same order).
    let mut parts: [string] = []
    let mut i = 0
    while i < nbytes {
        if i % 16 == 0 {
            if i > 0 { parts.push("\n") }
            parts.push("    .byte ")
        } else {
            parts.push(", ")
        }
        parts.push(_hex_pair_to_byte(cs, i))
        i = i + 1
    }
    parts.push("\n")
    return parts.join("")
}

fn _emit_section(target: string, sec: LSection, header: string) -> string {
    let mut out = ""
    out = out + header + "\n"
    if sec.align > 0 {
        out = out + "    .p2align " + to_string(sec.align) + "\n"
    }
    // Section "name" doubles as a local label inside the section.
    let sym = sec.name
    if len(sym) > 0 {
        out = out + sym + ":\n"
    }
    out = out + _emit_section_bytes(sec.bytes)
    return out
}

// ── Function emission ───────────────────────────────────────

fn _emit_func(target: string, f: LFunc) -> string {
    let mut out = ""
    out = out + _globl_directive(target, f.name) + "\n"
    // RFC 070 G7-A.visibility — hidden marker for non-entry symbols.
    // `.private_extern` (Mach-O) / `.hidden` (ELF). Entry (main /
    // _start) keeps default-public visibility. Empty string when the
    // target has no visibility concept (Thumb-2 bare-metal).
    out = out + _visibility_directive(target, f.name)
    if _is_arm64(target) {
        // AArch64 (Apple Mach-O + ELF GNU): .p2align 2 (4-byte) — every
        // arm64 instruction is 4 bytes wide.
        out = out + "    .p2align 2\n"
    } else if _is_thumb(target) {
        // Thumb-2 (Cortex-M4): 2-byte instruction alignment + the
        // `.thumb_func` marker so the assembler sets the LSB on the
        // symbol for branch-with-exchange compatibility.
        out = out + "    .p2align 1\n"
        out = out + "    .thumb_func\n"
    } else {
        // x86_64 ELF: 16-byte function alignment is the System V default
        out = out + "    .p2align 4\n"
    }
    out = out + _func_label(target, f.name) + "\n"
    // #13 DWARF — function-level `.loc` directive. Pairs with the
    // `.file 1 "<source>"` header directive. Emitted right after the
    // function label so a debugger maps the symbol to its definition
    // line. `.loc` is a GNU-as / Apple-as DWARF directive; both targets
    // (darwin arm64 + linux x86_64) accept it. def_line == 0 means the
    // source line is unknown (synthesised fn / test fixture) — skip.
    if f.def_line > 0 {
        out = out + "    .loc 1 " + to_string(f.def_line) + " 0\n"
    }
    // Self-host perf — the per-instruction `out = out + …` left-fold
    // re-copied the whole accumulator on every instruction: O(I²) bytes
    // on a function with I instructions. A large function (e.g. the
    // compiler's own 1209-line _lower_hexpr) emits thousands of
    // instructions, so this fold dominated stage-1 self-compile time.
    // Collect fragments in an array, join once — O(I), byte-identical
    // to the left-fold. Mirrors the F4 `parts`/`join` idiom already
    // used by emit_asm at module scope. [@cite alg/string/rope-join]
    let mut iparts: [string] = [out]
    let mut i = 0
    while i < len(f.instrs) {
        iparts.push(_fmt_instr(target, f.instrs[i]) + "\n")
        i = i + 1
    }
    return iparts.join("")
}

// ── Public API ──────────────────────────────────────────────

pub fn emit_asm(module: LModule) -> string {
    let target = module.target

    // F4 (PLAN-stage3-footprint.md) — fragments accumulate in an array,
    // joined once. `out = out + frag` re-copied the whole accumulator per
    // function: O(N·T) transient bytes on an N-function compile. `parts`
    // + `join("")` is O(T) and byte-identical to the left-fold of `+`.
    let mut parts: [string] = []

    // ---- Header (deterministic, no timestamps) ----
    parts.push(_comment_marker(target).trim() + " hexa-lang emit pass — target=" + target + "\n")
    parts.push(_comment_marker(target).trim() + " source: " + module.file + "\n")

    // Per-target file head directives.
    if _is_thumb(target) {
        // Cortex-M4F (armv7e-m / Thumb-2 / VFPv4-SP). The `.thumb`
        // directive switches the assembler into Thumb mode for the
        // remainder of the file; without it the default is ARM mode
        // and every Thumb-only mnemonic (cbz, it, ...) would error.
        parts.push(".syntax unified\n")
        parts.push(".cpu cortex-m4\n")
        parts.push(".fpu vfpv4-sp-d16\n")
        parts.push(".thumb\n")
    } else if _is_elf_arm64(target) {
        // ELF AArch64 (GNU as): AT&T/Intel syntax selectors are x86-only.
        // GNU `as` for aarch64 takes the native ARM mnemonic syntax with
        // no `.syntax`/`.intel_syntax` directive — emit nothing here.
    } else if !_is_darwin(target) {
        // x86_64 GAS: select Intel syntax once at the top (RFC-018 §3 note).
        parts.push(".intel_syntax noprefix\n")
    }

    // #13 DWARF — `.file 1 "<source>"` so the assembler's debug_line
    // table names the source; pairs with the per-fn `.loc` in
    // _emit_func. Thumb/bare-metal target skipped (no host debugger).
    if !_is_thumb(target) {
        parts.push(".file 1 \"" + module.file + "\"\n")
    }

    // ---- .text ----
    parts.push(_text_section_directive(target) + "\n")

    let mut fi = 0
    while fi < len(module.funcs) {
        let f = module.funcs[fi]
        // Skip funcs that don't match module.target (defensive — LIR
        // is target-specific, but a mixed module would still be valid
        // under the struct shape).
        if f.target == target {
            parts.push(_emit_func(target, f))
        }
        fi = fi + 1
    }

    // ---- .rodata ----
    if len(module.rodata) > 0 {
        let header_ro = _rodata_section_directive(target)
        let mut ri = 0
        while ri < len(module.rodata) {
            parts.push(_emit_section(target, module.rodata[ri], header_ro))
            ri = ri + 1
        }
    }

    // ---- .bss ----
    if len(module.bss) > 0 {
        let header_bss = _bss_section_directive(target)
        let mut bi = 0
        while bi < len(module.bss) {
            parts.push(_emit_section(target, module.bss[bi], header_bss))
            bi = bi + 1
        }
    }

    // ---- .data (module-level mutable globals + Route C self-static slots) ----
    if len(module.globals) > 0 {
        parts.push(_data_section_directive(target) + "\n")
        let mut gi = 0
        while gi < len(module.globals) {
            let nm = module.globals[gi]
            // RFC061 Route C Wall 3-c: a `slot_<id>__sz<N>` entry is a self-static
            // BSS slot DEFINED by codegen's __hx_static_slot special-case (NOT a
            // module global). Emit a zero-filled buffer of N bytes named `slot_<id>`
            // via `.zero N` (the system assembler — under Route C's asm-text path —
            // materializes it as a real .data symbol the `lea [rip+slot_<id>]`
            // pc-rel ref resolves to). Regular `g<id>` globals keep the fixed
            // 16-byte two-quad slot, so this branch is byte-eq NEUTRAL for them.
            let szpos = _hxss_sz_pos(nm)
            if szpos >= 0 {
                let sym = _hxss_sym(nm, szpos)
                let nbytes = _hxss_size(nm, szpos)
                parts.push("    .p2align 3\n" + sym + ":\n    .zero " + to_string(nbytes) + "\n")
            } else {
                parts.push("    .p2align 3\n" + nm + ":\n    .quad 0\n    .quad 0\n")
            }
            gi = gi + 1
        }
    }

    // ---- float constant pool (rodata, `.double` directives) ----
    // const_float Operand kind previously had no `_hv_load` branch and
    // fell through to `hv void` (TAG_VOID/0), so e.g. `sqrt(16.0)`
    // received TAG_VOID and returned 0. Each unique float literal is
    // interned at strtab-collect time and gets a `.LCfltN: .double <text>`
    // entry here; the use site loads TAG_FLOAT into lo and ldr's the
    // 8-byte IEEE-754 value into hi from `<label>`.
    if len(module.floats) > 0 {
        parts.push(_rodata_section_directive(target) + "\n")
        let mut fi2 = 0
        while fi2 < len(module.floats) {
            let f = module.floats[fi2]
            parts.push("    .p2align 3\n" + f.label + ":\n    .double " + f.text + "\n")
            fi2 = fi2 + 1
        }
    }

    // ---- RFC 070 G7-D.codegen — capability manifest + ABI stamp ----
    //
    // `__HEXA,__cap` / `.hexa.cap` carries the per-module capability
    // manifest (HXC v2 payload). Currently empty: the AST has
    // `@plugin(capabilities=[...])` (parser harvest 9401be63) but the
    // `_pending_annotations` → HXC manifest encoder (dynlink_caps.hexa
    // harvest 5f37a884) has not merged into this branch. The empty
    // section is the no-capabilities signal the loader gate distinguishes
    // from missing-section — see capability-bypass note in the
    // _emit_meta_section commentary above.
    //
    // `__HEXA,__abi` / `.hexa.abi` is the 12-byte ABI stamp
    // (u32 runtime_version + u64 nanbox_layout_hash, little-endian) —
    // RFC 070 §G7-D.B2 (harvest c54b76f3). The loader rejects a
    // module whose stamp doesn't match the host runtime's expected
    // pair.
    let cap_dir = _cap_section_directive(target)
    if len(cap_dir) > 0 {
        parts.push(_emit_meta_section(cap_dir, "_hexa_cap_manifest", ""))
    }
    let abi_dir = _abi_section_directive(target)
    if len(abi_dir) > 0 {
        parts.push(_emit_meta_section(abi_dir, "_hexa_abi_stamp", _abi_stamp_hex()))
    }

    // .note.GNU-stack — mark a NON-executable stack on Linux ELF targets so a
    // modern GNU ld stops promoting "missing .note.GNU-stack section implies
    // executable stack" to a hard link error (the leg-B native-serve FALLBACK,
    // measured 15/29 corpus programs on summer). #4761 fixed the own-emit object
    // writer half; this covers the asm-text path the self/native/*.s bootstrap
    // seeds are regenerated from. Zero-length, non-alloc PROGBITS. AArch64 GAS
    // uses `%progbits` (`@` starts a comment on ARM); x86_64 uses `@progbits`.
    // Darwin (Mach-O) and thumb (bare-metal Cortex-M) have no such section —
    // strict no-op for both, so it cannot regress the shipping darwin/embedded path.
    if _is_elf_arm64(target) {
        parts.push(".section .note.GNU-stack,\"\",%progbits\n")
    } else if !_is_darwin(target) && !_is_thumb(target) {
        parts.push(".section .note.GNU-stack,\"\",@progbits\n")
    }

    return parts.join("")
}
