// HEXA Native Compiler — Parser smoke test (Phase A1)
//
// Lex + parse a couple inline snippets and dump a one-line summary so we can
// eyeball that recursive descent produced sane Module/Item/Expr trees. No
// asserts beyond the count check so the test fails loudly on shape drift.

import "../lex/tokens.hexa"
import "../lex/lexer.hexa"
import "./ast.hexa"
import "./parser.hexa"

fn item_kind_str(k: ItemKind) -> string {
    return match k {
        ItemKind::Fn -> "Fn",
        ItemKind::Let -> "Let",
        ItemKind::Struct -> "Struct",
        ItemKind::Enum -> "Enum",
        ItemKind::Import -> "Import"
    }
}

fn token_kind_str(k: TokenKind) -> string {
    return match k {
        TokenKind::Ident -> "Ident",
        TokenKind::Number -> "Number",
        TokenKind::String -> "String",
        TokenKind::PNode -> "P",
        TokenKind::CNode -> "C",
        TokenKind::LNode -> "L",
        TokenKind::ENode -> "E",
        TokenKind::KwFn -> "fn",
        TokenKind::KwLet -> "let",
        TokenKind::KwStruct -> "struct",
        TokenKind::KwImport -> "import",
        TokenKind::KwPub -> "pub",
        TokenKind::At -> "@",
        TokenKind::Eof -> "EOF",
        _ -> "_"
    }
}

fn dump_module(label: string, src: string) {
    println("── " + label + " ──")
    let toks = lex(src, "<inline>")
    println("  tokens=" + to_string(len(toks)))
    let m = parse(toks, "<inline>")
    println("  items=" + to_string(len(m.items)) + " imports=" + to_string(len(m.imports)))
    let mut i = 0
    while i < len(m.items) {
        let it = m.items[i]
        let mut ann_count = len(it.annotations)
        let mut suffix = ""
        if it.is_pub { suffix = " (pub)" }
        if ann_count > 0 { suffix = suffix + " ann=" + to_string(ann_count) }
        println("    [" + to_string(i) + "] " + item_kind_str(it.kind) + " " + it.name + suffix)
        i = i + 1
    }
    let diags = parse_diags()
    if len(diags) > 0 {
        println("  parse_diags=" + to_string(len(diags)))
        let mut d = 0
        while d < len(diags) {
            let dg = diags[d]
            println("    <" + dg.code + "> " + dg.message)
            d = d + 1
        }
    }
}

fn case_basic_fn() {
    let src = "fn add(a: i64, b: i64) -> i64 { return a + b }\nfn main() -> i64 { return add(1, 2) }"
    dump_module("case 1: fn / call / arithmetic", src)
}

fn case_atlas_and_annotation() {
    let src = "@law(P[force-balance])\npub fn equilibrium(x: f64) -> f64 { return x * P[gravity-const] }"
    dump_module("case 2: @law + atlas refs", src)
}

fn case_struct_let_import() {
    let src = "import \"std/io\"\npub struct Vec3 { x: f64, y: f64, z: f64 }\nlet origin: Vec3 = zero()\nfn norm(v: Vec3) -> f64 { let s = v.x * v.x; return s }"
    dump_module("case 3: import / struct / let / field", src)
}

// A1.5 follow-ups — exercise the extensions added by parser.hexa:
//   enum decl + match expression / struct literal / for-loop / assignment.

fn case_enum_and_match() {
    let src = "enum Color { Red, Green(i64), Blue }\nfn describe(c: Color) -> i64 { return match c { Color::Red -> 1, Color::Green(n) -> n, _ -> 0 } }"
    dump_module("case 4: enum + match", src)
}

// RFC-074 Phase 2 fixture — multi-field positional enum payload (arity ≥ 2)
// parses cleanly. Each variant Param row has `typs[]` matching the declared
// arity (0 / 1 / 2 / 3 in this fixture). Construction + match destructure
// both round-trip through the parser; bind/type-check arity verification
// fires HX2004 on mismatch (see bind.hexa _bind_lookup_variant_arity).
fn case_enum_multi_field() {
    let src = "enum Event { Unit, Click(i64, i64), Triple(i64, i64, i64), Tag(string) }\nfn handle(e: Event) -> i64 { return match e { Event::Unit -> 0, Event::Click(x, y) -> x + y, Event::Triple(a, b, c) -> a + b + c, Event::Tag(s) -> 1 } }"
    dump_module("case 4b: RFC-074 multi-field enum payload (arity 0/1/2/3)", src)
}

fn case_struct_literal() {
    let src = "struct Pt { x: i64, y: i64 }\nfn make() -> Pt { return Pt { x: 1, y: 2 } }"
    dump_module("case 5: struct literal", src)
}

fn case_for_loop() {
    let src = "fn sum(xs: [i64]) -> i64 { let mut s = 0; for x in xs { s = s + x }; return s }"
    dump_module("case 6: for-loop", src)
}

fn case_assignment() {
    let src = "fn step() -> i64 { let mut n = 1; n = n + 1; n += 2; return n }"
    dump_module("case 7: assignment + compound assign", src)
}

// Stage1 punch list Gap 6 — error-recovery cases. Each malformed source
// should emit the brace diag AND let the parser resynchronize so the
// next top-level item still parses (visible as a non-zero items count).

fn case_missing_open_brace() {
    // Missing `{` for fn body — HX0011 fires; without resync the parser
    // would try to parse `return 0 }` as the body and absorb the rest.
    // After resync we expect 1× HX0011 and items >= 1.
    let src = "fn main() return 0 }\nfn after() -> i64 { return 1 }"
    dump_module("case h: missing { (HX0011 + resync)", src)
}

fn case_missing_close_brace() {
    // Missing `}` for fn body — HX0012 fires; resync at next `fn` keyword
    // so `next()` parses as its own item rather than being eaten as part
    // of `main`'s body. Expect 1× HX0012 and items == 2.
    let src = "fn main() { return 0   fn next() {}"
    dump_module("case i: missing } (HX0012 + resync)", src)
}

// Type-alias declarations (`type Name = Underlying`, Rust/Go). `type` is an
// Ident leader (no keyword token), parsed into an ItemKind::Let carrier tagged
// `__type_alias` + `@phase("parse_only")`. We expect: items count includes the
// alias carriers, each alias is flagged by `item_is_type_alias`, and the
// underlying type lands in `return_type`. The alias is then used in a fn
// signature + arithmetic — type resolution makes `Celsius`/`MyInt` behave as
// their underlying primitive so no spurious HX3001 in the later check passes.
// Bare-return same-line rule (state/hexa-own/step0_verdict.md): a value-less
// `return` followed on the NEXT line by an ident-led statement must NOT
// swallow that statement as its value — gen2's Newline rule, matched here
// via span.line. Positive controls: a value that STARTS on the keyword's
// line may continue across lines (multi-line binop / open call paren).
fn case_bare_return_nextline() {
    let src = "fn a() {\n    return\n    defer { g() }\n}\nfn b() {\n    return\n    g()\n}\nfn c() {\n    return\n    let x = 1\n}"
    dump_module("case j: bare return + next-line stmt (0-child Return, sibling parses)", src)
}

fn case_valued_return_multiline() {
    let src = "fn a() -> i64 {\n    return 1 +\n        2\n}\nfn b() -> i64 {\n    return g(\n        3)\n}"
    dump_module("case k: valued return spanning lines (value starts same-line)", src)
}

// Throw-parity rule (gen2 self/parser.hexa:4380-4383): parse_throw_stmt calls
// parse_expr UNCONDITIONALLY, so a throw value is REQUIRED — and gen2's lexer
// emits Newline tokens, so a value that does not START on the keyword's line
// is "unexpected token Newline" (gen2 parse_primary unknown-token arm), the
// same error class as a bare `throw` before `}`/`;`/EOF. Native mirrors both
// via span.line + HX0015, emitted WITHOUT consuming the offending token so
// the enclosing block stays in sync and the next-line statement parses as a
// SIBLING (not as the throw's value — the pre-fix guard silently accepted a
// 0-child Throw AND would have swallowed a next-line value, both divergent).

fn case_bare_throw_diag() {
    // Bare throw before `}` — expect 1× HX0015, brace intact (no HX0012
    // cascade), and the following top-level item still parses (items == 2).
    let src = "fn a() {\n    throw\n}\nfn after() -> i64 { return 1 }"
    dump_module("case l: bare throw before } (HX0015, no brace desync)", src)
}

fn case_throw_nextline_value() {
    // Next-line value — gen2 rejects this ("unexpected token Newline");
    // native mirrors with HX0015 and `g()` parses as the sibling statement,
    // NOT as the throw value. Expect exactly 1× HX0015, items == 1.
    let src = "fn a() {\n    throw\n    g()\n}"
    dump_module("case m: throw + next-line value (HX0015, sibling parses)", src)
}

fn case_valued_throw_multiline() {
    // Positive controls: the value STARTS on the keyword's line and may
    // continue across lines (open call paren — gen2 suppresses Newline
    // inside parens, native only checks the FIRST post-throw token).
    // Expect parse_diags == 0. Twin snippet lives in the gen2 corpus
    // (self/test_parser_full.hexa) proving both frontends accept it.
    let src = "fn a() {\n    throw \"boom\"\n}\nfn b() {\n    throw make_err(\n        3)\n}"
    dump_module("case n: valued throw (same-line start, multi-line ok)", src)
}

// Defer same-line dispatch (R1 census hazard (b) — mirrors the bare-return
// span.line rule): `defer` is a contextual Ident (M1 Q4 whitelist — bindings
// named `defer` are legal in the NATIVE frontend; gen2 reserves it as a
// keyword, self/lexer.hexa:114, so this shape is native-only and gen2 has no
// twin snippet). A bare expr-stmt `defer` (use of a binding named defer) at
// end-of-line followed by a next-line expression-start token must parse as
// TWO sibling statements — pre-fix the dispatch checked only
// _defer_body_start(peek_at(1).kind) and swallowed the next line as the
// defer body. gen2 reference: parse_defer_stmt (self/parser.hexa:4749)
// parses the body immediately after the keyword, and gen2's lexer emits
// Newline tokens — a cross-line body is "unexpected token Newline", so
// cross-line defer dispatch is structurally impossible there.

fn count_defer_carriers(body: Expr) -> i64 {
    let mut defers = 0
    let mut i = 0
    while i < len(body.children) {
        if ast_is_defer(body.children[i]) { defers = defers + 1 }
        i = i + 1
    }
    return defers
}

fn case_defer_ident_nextline() {
    let src = "fn a() {\n    let defer = 1\n    defer\n    g()\n}"
    println("── case o: bare ident defer + next-line call (2 siblings, no swallow) ──")
    let toks = lex(src, "<inline>")
    let m = parse(toks, "<inline>")
    let body = m.items[0].body
    println("  body_stmts=" + to_string(len(body.children)) + " (expect 3)"
            + " defer_carriers=" + to_string(count_defer_carriers(body)) + " (expect 0)")
    println("  parse_diags=" + to_string(len(parse_diags())) + " (expect 0)")
}

fn case_defer_sameline_control() {
    // Positive control: bodies STARTING on the keyword's line still
    // dispatch as defer stmts (expr form + block form).
    let src = "fn a() {\n    defer close(f)\n    defer { g() }\n}"
    println("── case p: same-line defer bodies (2 defer carriers) ──")
    let toks = lex(src, "<inline>")
    let m = parse(toks, "<inline>")
    let body = m.items[0].body
    println("  body_stmts=" + to_string(len(body.children)) + " (expect 2)"
            + " defer_carriers=" + to_string(count_defer_carriers(body)) + " (expect 2)")
    println("  parse_diags=" + to_string(len(parse_diags())) + " (expect 0)")
}

fn case_type_alias() {
    let src = "type MyInt = i64\npub type Celsius = f64\ntype Box<T> = i64\ntype Temp = Celsius\nfn warm(t: Celsius) -> Celsius { return t * 1.8 + 32.0 }\nfn idx(n: MyInt) -> MyInt { return n + 1 }"
    println("── case j: type alias (decl + generic + chain + use) ──")
    let toks = lex(src, "<inline>")
    let m = parse(toks, "<inline>")
    println("  items=" + to_string(len(m.items)))
    let mut i = 0
    let mut alias_count = 0
    while i < len(m.items) {
        let it = m.items[i]
        if item_is_type_alias(it) {
            alias_count = alias_count + 1
            // return_type carries the underlying spelling (named).
            println("    alias " + it.name + " = " + it.return_type.name
                    + " (parse_only=" + to_string(item_is_parse_only(it)) + ")")
        }
        i = i + 1
    }
    println("  alias_count=" + to_string(alias_count) + " (expect 4)")
    let diags = parse_diags()
    println("  parse_diags=" + to_string(len(diags)) + " (expect 0)")
}

println("══════════════════════════════════════════════")
println("  HEXA Compiler — Parser Smoke Test (A1)")
println("══════════════════════════════════════════════")
case_basic_fn()
case_atlas_and_annotation()
case_struct_let_import()
case_enum_and_match()
case_enum_multi_field()
case_struct_literal()
case_for_loop()
case_assignment()
case_missing_open_brace()
case_missing_close_brace()
case_bare_return_nextline()
case_valued_return_multiline()
case_bare_throw_diag()
case_throw_nextline_value()
case_valued_throw_multiline()
case_defer_ident_nextline()
case_defer_sameline_control()
case_type_alias()
println("══════════════════════════════════════════════")
println("  done.")
