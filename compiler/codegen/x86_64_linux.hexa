    }
    if s.kind == _STMT_CALL {
        let arg_n = len(s.args)
        // ── RT-NATIVE-ZEROC M1: x86_64 `__hx_*` leaf-intrinsic parity ──────
        // Bring the x86_64 backend to parity with arm64_darwin.hexa for the 25
        // whitelisted `__hx_*` leaf intrinsics (check/bind.hexa _bind_builtin_
        // names). Each is INLINED — no runtime call — operating on the raw
        // HexaVal payload (the x86_64 raw-int single-register model; tag carried
        // in the tag-slot). Every encoding here was verified against GNU `as` +
        // `objdump` ground-truth (scripts/scratch/rt_native/x86_leaf_gate.sh).
        // These read the second eightbyte (payload) of a value; the tag for the
        // FLOAT/INT result is written by _x86_hv_store_leaf. Foundation for the
        // M4 native runtime-core port on x86_64. Mirrors arm64 UNLOCK-2..11.

        // UNLOCK-2: `__hx_tag(v)` → int HexaVal {TAG_INT, v.tag}. The tag is the
        // value's carried tag-slot value (not the payload); read it into the dst
        // and box as TAG_INT.
        if s.op == "__hx_tag" && len(s.args) >= 1 {
            let dst_name = _x86_dst_reg(rm, s.dst.id)
            _x86_tag_resolve(s.args[0], rm, dst_name)  // dst = v.tag
            if s.dst.id >= 0 {
                _x86_store_tag_imm(rm, s.dst.id, 0)    // result TAG_INT
                _x86_emit_dst_writeback(rm, s.dst.id, s.dst.arena_id)
            }
            return
        }
        // RT-NATIVE M4 ARRAY-R2: `__hx_make_val(tag, payload)` → a {tag, payload}
        // 16-byte HexaVal from two raw int64 words, the symmetric WRITE-half of
        // `__hx_tag`. The SysV PAIR ABI here keeps tag in the value's tag-slot and
        // payload in its home reg (mirrors arm64 lo=x0=tag / hi=x1=payload). Both
        // args are int-boxed HexaVals → the WANTED word is each arg's PAYLOAD. The
        // payload word is loaded into r10 FIRST and the tag word into r11 (the same
        // first→r10 / second→r11 disjoint ordering the payload-arith leaves use, so
        // the 2nd `_x86_hv_payload` cannot clobber the 1st), then stored as
        // {tag=r11, payload=r10}. r10 is the dst home / spill reg, so the payload
        // lands correctly under `_x86_emit_dst_writeback`. No `call` (non-circular).
        if s.op == "__hx_make_val" && len(s.args) >= 2 {
            _x86_hv_payload(s.args[1], st, rm, "r10", opts)  // payload word → r10
            _x86_hv_payload(s.args[0], st, rm, "r11", opts)  // tag word     → r11
            if s.dst.id >= 0 {
                _x86_hv_store_leaf_tagreg(rm, s.dst.id, s.dst.arena_id, "r10", "r11")
            }
            return
        }
        // UNLOCK-2b: payload equality / non-zero → bool, INLINE (cmp + setcc +
        // movzx). r10 = a.payload, r11 = b.payload; al = predicate; movzx into
        // dst; tag = TAG_BOOL(2). NaN-irrelevant (raw i64 compare).
        if s.op == "__hx_payload_eq" && len(s.args) >= 2 {
            _x86_hv_payload(s.args[0], st, rm, "r10", opts)
            _x86_hv_payload(s.args[1], st, rm, "r11", opts)
            _x86_buf.push(_x86_instr2("cmp", _x86_op_reg("r10"), _x86_op_reg("r11"),
                             "__hx_payload_eq: cmp payloads"))
            _x86_buf.push(_x86_instr1("sete", _x86_op_reg("al"), "__hx_payload_eq: al = (a==b)"))
            let dn = _x86_dst_reg(rm, s.dst.id)
            _x86_buf.push(_x86_instr2("movzx", _x86_op_reg(dn), _x86_op_reg("al"),
                             "__hx_payload_eq: zero-extend bool"))
            if s.dst.id >= 0 {
                _x86_store_tag_imm(rm, s.dst.id, 2)
                _x86_emit_dst_writeback(rm, s.dst.id, s.dst.arena_id)
            }
            return
        }
        if s.op == "__hx_payload_nz" && len(s.args) >= 1 {
            _x86_hv_payload(s.args[0], st, rm, "r10", opts)
            _x86_buf.push(_x86_instr2("cmp", _x86_op_reg("r10"), _x86_op_imm(0),
                             "__hx_payload_nz: cmp payload, 0"))
            _x86_buf.push(_x86_instr1("setne", _x86_op_reg("al"), "__hx_payload_nz: al = (pl != 0)"))
            let dn = _x86_dst_reg(rm, s.dst.id)
            _x86_buf.push(_x86_instr2("movzx", _x86_op_reg(dn), _x86_op_reg("al"),
                             "__hx_payload_nz: zero-extend bool"))
            if s.dst.id >= 0 {
                _x86_store_tag_imm(rm, s.dst.id, 2)
                _x86_emit_dst_writeback(rm, s.dst.id, s.dst.arena_id)
            }
            return
        }
        // UNLOCK-2b ext: signed-i64 relational payload compares → bool.
        // setl/setg/setle/setge (signed cond codes, matching arm64 lt/gt/le/ge).
        if (s.op == "__hx_payload_lt" || s.op == "__hx_payload_gt"
            || s.op == "__hx_payload_le" || s.op == "__hx_payload_ge"
            || s.op == "__hx_payload_eq" || s.op == "__hx_payload_ne") && len(s.args) >= 2 {
            let mut _scc = "setl"
            if s.op == "__hx_payload_gt" { _scc = "setg" }
            if s.op == "__hx_payload_le" { _scc = "setle" }
            if s.op == "__hx_payload_ge" { _scc = "setge" }
            if s.op == "__hx_payload_eq" { _scc = "sete" }
            if s.op == "__hx_payload_ne" { _scc = "setne" }
            // Load b→r11 before a→r10 (nested-intrinsic clobber fix — see the
            // arithmetic block); cmp r10,r11 reg assignment is unchanged.
            _x86_hv_payload(s.args[1], st, rm, "r11", opts)
            _x86_hv_payload(s.args[0], st, rm, "r10", opts)
            _x86_buf.push(_x86_instr2("cmp", _x86_op_reg("r10"), _x86_op_reg("r11"),
                             s.op + ": cmp payloads"))
            _x86_buf.push(_x86_instr1(_scc, _x86_op_reg("al"), s.op + ": al = predicate"))
            let dn = _x86_dst_reg(rm, s.dst.id)
            _x86_buf.push(_x86_instr2("movzx", _x86_op_reg(dn), _x86_op_reg("al"),
                             s.op + ": zero-extend bool"))
            if s.dst.id >= 0 {
                _x86_store_tag_imm(rm, s.dst.id, 2)
                _x86_emit_dst_writeback(rm, s.dst.id, s.dst.arena_id)
            }
            return
        }
        // UNLOCK-2c: signed-i64 payload arithmetic → int HexaVal {TAG_INT, …}.
        // add/sub/imul into r10 (a.pl), then box as TAG_INT.
        if (s.op == "__hx_payload_add" || s.op == "__hx_payload_sub"
            || s.op == "__hx_payload_mul" || s.op == "__hx_payload_and"
            || s.op == "__hx_payload_xor") && len(s.args) >= 2 {
            let mut _aop = "add"
            if s.op == "__hx_payload_sub" { _aop = "sub" }
            if s.op == "__hx_payload_mul" { _aop = "imul" }
            if s.op == "__hx_payload_and" { _aop = "and" }
            if s.op == "__hx_payload_xor" { _aop = "xor" }
            // Load b→r11 BEFORE a→r10: a spilled operand resolves through r10
            // (_x86_op_resolve line ~574), so loading b LAST would clobber a's
            // value already in r10. Loading b first (r10 free) then a→r10 avoids
            // the nested-intrinsic clobber (NESTING finding, map_core.hexa). Reg
            // assignment (a=r10, b=r11) is unchanged, so non-commutative sub/imul
            // stay correct.
            _x86_hv_payload(s.args[1], st, rm, "r11", opts)
            _x86_hv_payload(s.args[0], st, rm, "r10", opts)
            _x86_buf.push(_x86_instr2(_aop, _x86_op_reg("r10"), _x86_op_reg("r11"),
                             s.op + ": r10 = a.pl " + _aop + " b.pl"))
            if s.dst.id >= 0 { _x86_hv_store_leaf(rm, s.dst.id, s.dst.arena_id, "r10", 0) }
            return
        }
        // int-div-leaf: signed-i64 quotient (__hx_payload_div) / remainder
        // (__hx_payload_mod) → int HexaVal {TAG_INT, …}. x86_64 idiv has a fixed
        // RDX:RAX dividend + dual quo(RAX)/rem(RDX) output, so it does NOT fit the
        // 2-op `op r10,r11` shape above — separate block (the add/sub/mul family
        // stays byte-eq untouched). Load b→r11, a→r10 (same order as the arith
        // block: b first to avoid the spill-through-r10 nested-intrinsic clobber),
        // then `mov rax,r10; cqo; idiv r11` (cqo sign-extends RAX→RDX:RAX for
        // signed 64-bit divide). Quotient→RAX, remainder→RDX; copy the wanted one
        // into r10 and store. r10/r11 survive cqo/idiv (only RAX/RDX are clobbered).
        // Divide-by-zero is the C wrapper's job (zero-throw = runtime re-entry, out
        // of the leaf); the leaf assumes b != 0, exactly like C int64 `/`/`%`
        // (idiv is round-toward-zero, matching C). INT64_MIN/-1 overflows (#DE) —
        // same UB as C, the wrapper need not guard it (matches C body).
        if (s.op == "__hx_payload_div" || s.op == "__hx_payload_mod")
            && len(s.args) >= 2 {
            _x86_hv_payload(s.args[1], st, rm, "r11", opts)
            _x86_hv_payload(s.args[0], st, rm, "r10", opts)
            _x86_buf.push(_x86_instr2("mov", _x86_op_reg("rax"), _x86_op_reg("r10"),
                             s.op + ": rax = a.pl (dividend)"))
            _x86_buf.push(_x86_instr0("cqo", s.op + ": sign-extend rax → rdx:rax"))
            _x86_buf.push(_x86_instr1("idiv", _x86_op_reg("r11"),
                             s.op + ": rax=quo rdx=rem (a.pl / b.pl)"))
            if s.op == "__hx_payload_div" {
                _x86_buf.push(_x86_instr2("mov", _x86_op_reg("r10"), _x86_op_reg("rax"),
                                 s.op + ": r10 = quotient"))
            } else {
                _x86_buf.push(_x86_instr2("mov", _x86_op_reg("r10"), _x86_op_reg("rdx"),
                                 s.op + ": r10 = remainder"))
