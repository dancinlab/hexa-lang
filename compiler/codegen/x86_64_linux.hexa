// HEXA Native Compiler — Codegen / x86_64-linux-gnu (Phase A1)
//
// @version 0.1.0
// @capabilities [pure]
// @allow-relop-banned-file  — codegen path uses `>=`/`<=` for arity
//   guards and signed-id checks; C6 regalloc inherits the same need.
//
// Lowers MIR (SSA CFG) -> LIR (target-specific instructions) for the
// x86_64-linux-gnu target.
//
//   pub fn codegen_x86_64_linux(module: MModule) -> LModule
//
// ABI: System V AMD64
//   - Integer args:    rdi, rsi, rdx, rcx, r8, r9 (overflow on stack)
//   - Integer return:  rax
//   - Frame pointer:   rbp (callee-saved)
//   - Stack alignment: 16 bytes at function boundary (post-call)
//
// Per MFunc layout:
//   prologue:
//       push rbp
//       mov  rbp, rsp
//   <block instrs>
//   epilogue:
//       pop  rbp
//       ret
//
// v1 register policy (naive):
//   Local id N -> physical register from a fixed table:
//     0->rax, 1->rbx, 2->rcx, 3->rdx, 4->r8, 5->r9, 6->r10, 7->r11,
//     8->r12, 9->r13, 10->r14, 11->r15, then wrap.
//   Two-operand x86 form: emit `mov dst, lhs ; <op> dst, rhs`.
//
// ── RFC 070 G7-A.native scaffold (2026-05-20, comment-only marker) ──
//
// G7-A.flag-wire (C path · landed `66b055c4`) wires `hexa build --shared`
// through to `clang -fPIC -shared`. The native backend below currently
// REFUSES `HEXA_BACKEND=native` + `--shared` at `self/main.hexa::cmd_build`
// L1973-1978 — this scaffold block documents the delta we owe the
// native side before the gate can drop.
//
// Current x86_64-linux addressing baseline (NOT PIC):
//   - Cross-fn symbol references emit absolute 64-bit immediates
//     (`_x86_op_imm` produces literal offsets). No `[rip+disp32]` mode
//     emitted today, except where cycle 30 (`e83dfd99`) added
//     `R_X86_64_PLT32` for call sites (mem operands for jumps).
//   - An `.so` produced from this path would carry non-relocatable
//     `R_X86_64_64` fixups in `.text`, which `ld.so` REFUSES for
//     `ET_DYN` (System V gABI §4.1, dynamic linker contract).
//
// G7-A.native impl delta (the next sub-cycle):
//   1. Honor `bopts[4]=="1"` (the `shared` flag wired in G7-A.flag-wire)
//      inside `codegen_x86_64_linux` entry — branch addressing-mode
//      selection on it. Plumb `shared: i64` through the codegen
//      module-level options struct. **CodegenOptions struct lifted to
//      `compiler/ir/lir.hexa` 2026-05-20 (interface-only commit)** —
//      see `pub struct CodegenOptions { shared: i64, target_triple: string }`
//      + `codegen_options_default()` seed helper. This sub-cycle threads
//      it as an optional 2nd arg to `codegen_x86_64_linux` (signature
//      change synchronized with `compiler/main.hexa:801` + 2 callers in
//      `compiler/codegen/codegen_test.hexa`).
//   2. Cross-fn symbol references in shared mode:
//        - Extern fn/data: `lea rax, [rip+sym@GOTPCREL]` then
//          `mov rax, [rax]` for data, or `call qword [rax]` for fn.
//          Reloc kind = `R_X86_64_GOTPCREL` (extends cycle 30's
//          PLT32 from call-site half to addressing half).
//        - Local/PIE-style: `lea rax, [rip+sym]` with `R_X86_64_PC32`
//          reloc (already used for branch targets internally; promote
//          to data/fn-addr take-address sites too).
//      **Reloc kind string constants lifted to `compiler/ir/lir.hexa`
//      as `pub let RELOC_X86_64_GOTPCREL` + `RELOC_X86_64_PC32` +
//      `RELOC_X86_64_PLT32` (cycle 30's existing) 2026-05-20** — tag
//      RIP-relative LInstrs via `LInstr.comment` so the asm-text
//      emitter can dispatch on the suffix.
//   3. Hidden-visibility default: emit `.hidden <sym>` directive for
//      every defined fn EXCEPT `<plugin_id>_dispatch`, which alone
//      gets `.globl`. ELF dynsym then carries exactly 1 global entry.
//
// Falsifier hooks for G7-A.native impl (real-limit anchored per `@D g3`):
//   - F-A1: `<plugin_id>_dispatch` symbol address is page-aligned (real-limit
//     = x86_64 Linux 4 KiB page granularity) AFTER `dlopen` at a
//     non-default base — verifies PC-relative emission, not luck.
//   - F-A2: `nm <plugin>.so | awk '$2 == "T" || $2 == "D"'` lists
//     exactly 1 symbol matching `<plugin_id>_dispatch`. All others are
//     local (`t`/`d`). Anchor = ELF symbol-table format (System V gABI §4).
//
// Scope marker: THIS commit is scaffold-only (zero behavior change). The
// `codegen_x86_64_linux` body is untouched. See RFC 070 §4.4 for the
// honest scope and `compiler/PLAN.md` for the cycle entry.

import "../ir/mir.hexa"
import "../ir/lir.hexa"

// ── Local mirror of mir.hexa STMT_* constants ────────────────
// See note in compiler/lower/hir_to_mir.hexa: stage0's interpreter does
// not propagate transitive `pub let` bindings, so STMT_* arrive here as
// the void value. Redeclaring locally keeps codegen dispatch working.
let _STMT_ASSIGN   = "assign"
let _STMT_BINOP    = "binop"
let _STMT_UNOP     = "unop"
let _STMT_CALL     = "call"
let _STMT_RETURN   = "return"
let _STMT_BR       = "br"
let _STMT_BR_COND  = "br_cond"

// ── PReg / LOperand helpers ──────────────────────────────────

fn _x86_preg_gpr(name: string) -> PReg {
    return PReg { name: name, kind: "gpr", frag_role: "", frag_dtype: "", frag_layout: "" }
}

fn _x86_empty_preg() -> PReg {
    return PReg { name: "", kind: "", frag_role: "", frag_dtype: "", frag_layout: "" }
}

fn _x86_op_reg(name: string) -> LOperand {
    return LOperand {
        kind: "reg",
        reg: _x86_preg_gpr(name),
        imm: 0,
        mem_base: _x86_empty_preg(),
        mem_offset: 0,
        label: ""
    }
}

fn _x86_op_imm(value: i64) -> LOperand {
    return LOperand {
        kind: "imm",
        reg: _x86_empty_preg(),
        imm: value,
        mem_base: _x86_empty_preg(),
        mem_offset: 0,
        label: ""
    }
}

fn _x86_op_label(name: string) -> LOperand {
    return LOperand {
        kind: "label",
        reg: _x86_empty_preg(),
        imm: 0,
        mem_base: _x86_empty_preg(),
        mem_offset: 0,
        label: name
    }
}

// B5 follow-up — `_op_mem` was defined only in arm64_darwin.hexa but
// called from x86_64 SSA-spill paths via splice. After the B5 backend-
// prefix rename, x86_64's call sites became `_x86_op_mem` with no
// matching definition. Add the mirror here.
fn _x86_op_mem(base: string, offset: i64) -> LOperand {
    return LOperand {
        kind: "mem",
        reg: _x86_empty_preg(),
        imm: 0,
        mem_base: _x86_preg_gpr(base),
        mem_offset: offset,
        label: ""
    }
}

fn _x86_instr0(op: string, comment: string) -> LInstr {
    return LInstr { op: op, args: [], comment: comment }
}

fn _x86_instr1(op: string, a: LOperand, comment: string) -> LInstr {
    let mut xs = []
    xs.push(a)
    return LInstr { op: op, args: xs, comment: comment }
}

fn _x86_instr2(op: string, a: LOperand, b: LOperand, comment: string) -> LInstr {
    let mut xs = []
    xs.push(a)
    xs.push(b)
    return LInstr { op: op, args: xs, comment: comment }
}

// ── Register assignment (naive) ──────────────────────────────

fn _x86_64_reg_for_local(local_id: i64) -> string {
    // 12-slot rotation across general-purpose 64-bit registers.
    let slots = [
        "rax", "rbx", "rcx", "rdx",
        "r8",  "r9",  "r10", "r11",
        "r12", "r13", "r14", "r15"
    ]
    let mut idx = local_id
    if idx < 0 { idx = 0 }
    let m = idx - (idx / 12) * 12
    return slots[m]
}

fn _x86_64_arg_reg(idx: i64) -> string {
    // System V integer arg sequence
    if idx == 0 { return "rdi" }
    if idx == 1 { return "rsi" }
    if idx == 2 { return "rdx" }
    if idx == 3 { return "rcx" }
    if idx == 4 { return "r8"  }
    if idx == 5 { return "r9"  }
    return "rdi" // overflow on stack — v1 stub
}

// ── C6 — Linear-scan register allocator (x86_64) ─────────────
// RT-NATIVE leg B PAIR-MODEL — the x86_64 backend carries a value's PAYLOAD
// in a register/spill slot (the original raw-int model), but ALSO carries the
// value's HexaVal TAG in a dedicated per-value frame tag-slot so the tag
// survives through params/locals/call-results into a tag-dispatching runtime
// helper (e.g. hexa_len → `if HX_IS_STR(v)`). Mirrors the arm64 16-byte pair
// model (which force-spills every value to a {tag,payload} 16B slot) but stays
// surgical: the existing single-register payload model is untouched; the tag
// slot is a PARALLEL 8-byte slot in an extended frame region. `tag_base` is the
// byte offset (from the spill region top) where the per-value tag-slot array
// begins; value `id` (interval index `idx`) gets its tag at `[rbp, -8 -
// (tag_base + idx*8)]`.
pub struct X86RegMap {
    ids: [i64],
    regs: [string],
    slots: [i64],
    tag_base: i64,
    // #3712 — id → index-into-`ids` direct array (sized maxid+1, -1 = absent).
    // The per-operand reg/spill/tag lookups (_x86_reg_lookup / _x86_is_spilled
    // / _x86_spill_offset / _x86_tag_off) probe this in O(1) instead of an
    // O(len(ids)) `_x86_index_of` scan — collapsing per-function codegen from
    // O(stmts·locals) to O(stmts) (the #3709 deep-spine fix exposed this
    // O(n²) on the 7000-binop runtime_cuda_emit). Built once from the final
    // `ids` order, so every lookup returns the identical slot — byte-eq NEUTRAL.
    id2idx: [i64]
}

pub struct X86AllocResult {
    map: X86RegMap,
    frame_size: i64
}

pub struct X86Intervals {
    ids: [i64],
    starts: [i64],
    ends: [i64]
}

// PAIR-MODEL — callee-saved register block. rbx/r12-r15 (the allocation pool)
// are CALLEE-SAVED under System V: a function that uses them MUST preserve them
// for its caller (incl. the C harness / any C caller). The prologue pushes all
// five + one 8-byte alignment pad (6 * 8 = 48 bytes, a 16-byte multiple so the
// call-site rsp alignment is preserved); the epilogue pops them. Spill/tag
// frame slots are addressed BELOW this block (offset by _X86_CALLEE_SAVE_BYTES)
// so they never alias a saved register.
let _X86_CALLEE_SAVE_BYTES = 48

// Negative rbp-relative byte offset for a frame slot at logical offset `off`
// (0-based). Shifted below the callee-saved block. Returns the signed offset
// for _x86_op_mem.
fn _x86_frame_off(off: i64) -> i64 {
    return -8 - _X86_CALLEE_SAVE_BYTES - off
}

fn _x86_pool_init() -> [string] {
    // PAIR-MODEL — only CALLEE-SAVED registers are eligible for a value that
    // may be live across a call. rax was previously in this pool, but rax is
    // CALLER-SAVED (volatile): a value parked in rax is destroyed by the next
    // `call` (every runtime builtin / user-fn call clobbers rax:rdx as the
    // return pair + rcx/rdi/rsi/r8-r11 as arg/scratch). A param `s` assigned to
    // rax and then read after `hexa_len(s)` reloaded garbage — the crash root.
    // Restrict the pool to rbx/r12-r15 (callee-saved); anything beyond 5 live
    // values spills to the frame (safe across calls). rax stays free as the
    // return/scratch register the call emit already assumes.
    let mut p: [string] = []
    p.push("rbx")
    p.push("r12")
    p.push("r13")
    p.push("r14")
    p.push("r15")
    return p
}

fn _x86_index_of(ids: [i64], id: i64) -> i64 {
    let mut i = 0
    while i < len(ids) {
        if ids[i] == id { return i }
        i = i + 1
    }
    return -1
}

// #3712 — O(1) id→slot membership for the live-range build. Local ids are
// dense non-negative ints (hir_to_mir `next_local` counter), so a direct-
// indexed `id2slot[id]` array (sized maxid+1, -1 = absent) replaces the
// O(len(ids)) `_x86_index_of` linear probe that made this O(locals²) — the
// gen3 obj-emit wall the #3709 deep-spine fix exposed on the 7000-binop
// runtime_cuda_emit (crash → O(n²) hang). Byte-eq NEUTRAL: `ids` keeps the
// exact first-occurrence order (push sites unchanged) and every interval is
// overwritten to [0,pos] below regardless — only the probe gets faster.
fn _x86_max_local_id(mf: MFunc) -> i64 {
    let mut m = -1
    let mut li = 0
    while li < len(mf.locals) {
        if mf.locals[li].id > m { m = mf.locals[li].id }
        li = li + 1
    }
    let mut pi = 0
    while pi < len(mf.params) {
        if mf.params[pi].id > m { m = mf.params[pi].id }
        pi = pi + 1
    }
    let mut bi = 0
    while bi < len(mf.blocks) {
        let blk = mf.blocks[bi]
        let mut si = 0
        while si < len(blk.stmts) {
            let s = blk.stmts[si]
            if s.dst.id > m { m = s.dst.id }
            let mut ai = 0
            while ai < len(s.args) {
                if s.args[ai].kind == "local" && s.args[ai].local_id > m {
                    m = s.args[ai].local_id
                }
                ai = ai + 1
            }
            si = si + 1
        }
        bi = bi + 1
    }
    return m
}

fn _x86_compute_live_ranges(mf: MFunc) -> X86Intervals {
    let mut ids: [i64] = []
    let mut starts: [i64] = []
    let mut ends: [i64] = []

    let maxid = _x86_max_local_id(mf)
    let mut id2slot: [i64] = []
    let mut zi = 0
    while zi <= maxid { id2slot.push(-1); zi = zi + 1 }

    let mut li = 0
    while li < len(mf.locals) {
        let id = mf.locals[li].id
        if id >= 0 && id2slot[id] < 0 {
            id2slot[id] = len(ids)
            ids.push(id)
            starts.push(-1)
            ends.push(-1)
        }
        li = li + 1
    }

    let mut pi = 0
    while pi < len(mf.params) {
        let pid = mf.params[pi].id
        let idx = if pid >= 0 && pid <= maxid { id2slot[pid] } else { -1 }
        if idx >= 0 {
            if starts[idx] < 0 { starts[idx] = 0 }
            if ends[idx] < 0   { ends[idx] = 0 }
        }
        pi = pi + 1
    }

    let mut pos = 0
    let mut bi = 0
    while bi < len(mf.blocks) {
        let blk = mf.blocks[bi]
        let mut si = 0
        while si < len(blk.stmts) {
            let s = blk.stmts[si]
            let did = s.dst.id
            if did >= 0 {
                let mut idx = id2slot[did]
                if idx < 0 {
                    idx = len(ids)
                    id2slot[did] = idx
                    ids.push(did)
                    starts.push(pos)
                    ends.push(pos)
                } else {
                    if starts[idx] < 0 || pos < starts[idx] { starts[idx] = pos }
                    if pos > ends[idx] { ends[idx] = pos }
                }
            }
            let mut ai = 0
            while ai < len(s.args) {
                let o = s.args[ai]
                if o.kind == "local" {
                    let lid = o.local_id
                    if lid >= 0 {
                        let mut idx2 = id2slot[lid]
                        if idx2 < 0 {
                            idx2 = len(ids)
                            id2slot[lid] = idx2
                            ids.push(lid)
                            starts.push(pos)
                            ends.push(pos)
                        } else {
                            if starts[idx2] < 0 || pos < starts[idx2] {
                                starts[idx2] = pos
                            }
                            if pos > ends[idx2] { ends[idx2] = pos }
                        }
                    }
                }
                ai = ai + 1
            }
            pos = pos + 1
            si = si + 1
        }
        bi = bi + 1
    }
    // PAIR-MODEL — CONSERVATIVE WHOLE-FUNCTION LIVENESS. The textual linear-scan
    // live ranges above are WRONG across loop back-edges: a value last *read* in
    // a loop-header block (e.g. the loop bound `n` in `cmp i, n`) is positioned
    // BEFORE a value *defined* in the loop body (e.g. `b = s.byte_at(i)`), so
    // the scanner thinks `n` is dead and lets `b` reuse its register — but the
    // back-edge re-enters the header needing `n`, which `b` has clobbered (the
    // confirmed `byte_at index out of bounds` miscompile: the loop bound was
    // overwritten by the per-iteration byte). A proper fix needs loop-aware
    // liveness; here we mirror the arm64 backend's force-resident model by
    // extending EVERY interval to span the whole function [0, pos]. No two
    // values ever share a physical register, so loop-carried values survive.
    // The first 5 values stay pinned in the callee-saved pool (rbx/r12-r15,
    // never expired → never reused); the rest spill to the frame (safe across
    // calls). Slower but correct; a real allocator is a post-correctness opt.
    let mut ei = 0
    while ei < len(ids) {
        if starts[ei] < 0 { starts[ei] = 0 }
        starts[ei] = 0
        ends[ei] = pos
        ei = ei + 1
    }
    return X86Intervals { ids: ids, starts: starts, ends: ends }
}

fn _x86_64_assign_regs(mf: MFunc) -> X86AllocResult {
    let iv = _x86_compute_live_ranges(mf)
    let n = len(iv.ids)
    let mut order: [i64] = []
    let mut k = 0
    while k < n {
        if iv.starts[k] >= 0 { order.push(k) }
        k = k + 1
    }
    let mut a = 1
    while a < len(order) {
        let key = order[a]
        let key_start = iv.starts[key]
        let mut b = a - 1
        while b >= 0 && iv.starts[order[b]] > key_start {
            order[b + 1] = order[b]
            b = b - 1
        }
        order[b + 1] = key
        a = a + 1
    }

    let mut map_ids: [i64] = []
    let mut map_regs: [string] = []
    let mut map_slots: [i64] = []
    let mut j = 0
    while j < n {
        map_ids.push(iv.ids[j])
        map_regs.push("")
        map_slots.push(-1)
        j = j + 1
    }

    // PAIR-MODEL — params are NOT pre-colored to a SysV arg register. In the
    // raw-int model a param's payload lived in its arg reg, so pre-coloring it
    // there avoided an ingress mov. Now each param arrives as a {tag,payload}
    // PAIR (param p → _x86_hv_pair_lo/hi(p)); the prologue moves the PAYLOAD
    // out of the high arg reg into the param's assigned home (pool reg or
    // payload spill) and stashes the TAG into the param's tag-slot. So a param
    // is allocated like any ordinary value — no arg-reg pre-color. The
    // `is_param` victim-protection below still keeps params live for the whole
    // fn (they are stored once at ingress and reloaded from their home).
    let mut p = 0
    while p < len(mf.params) {
        if false {
            let pid = mf.params[p].id
            let idx = _x86_index_of(iv.ids, pid)
            if idx >= 0 {
                map_regs[idx] = _x86_64_arg_reg(p)
            }
        }
        p = p + 1
    }

    let mut pool = _x86_pool_init()
    let mut active_idx: [i64] = []
    let mut next_slot: i64 = 0

    // #3712 — precompute is_param[slot] (O(1)) so the per-active param test in
    // the expiry sweep + victim search isn't an O(params) inner scan per active
    // per step. Indexed by position in `iv.ids` (same as map_*/active_idx).
    // Byte-eq NEUTRAL: identical boolean as the `mf.params` scan, just cached.
    let mut is_param_slot: [bool] = []
    let mut isp_i = 0
    while isp_i < len(iv.ids) { is_param_slot.push(false); isp_i = isp_i + 1 }
    let mut isp_p = 0
    while isp_p < len(mf.params) {
        // O(params·ids) ONE-TIME (not per-step); params are few. The per-active
        // hot-path test below reads the cached is_param_slot[] in O(1).
        let pidx = _x86_index_of(iv.ids, mf.params[isp_p].id)
        if pidx >= 0 { is_param_slot[pidx] = true }
        isp_p = isp_p + 1
    }

    // #3712 — O(1)-per-step active-list maintenance.
    //
    // The "conservative whole-function liveness" pass ABOVE unconditionally
    // overwrites EVERY interval to `starts[i]=0, ends[i]=pos` (the loop that
    // ends at `ends[ei] = pos`). Under that invariant the array-of-active
    // bookkeeping the original linear-scan did per step is provably a no-op
    // beyond an append:
    //   • expiry `ends[ai] < cur_start` == `pos < 0` → FALSE → nothing ever
    //     expires (active never shrinks, pool never refilled mid-scan);
    //   • ordered insert `ends[active] > cur_end` == `pos > pos` → FALSE →
    //     `cur` is always appended at the END (never spliced mid-list);
    //   • victim `ends[victim] > ends[cur]` == `pos > pos` → FALSE → the
    //     register-steal branch is never taken; an out-of-pool value always
    //     takes the plain-spill else.
    // So the per-step O(active) array REBUILDS (keep/na/na2 allocations) that
    // made reg-assign O(N²) are pure overhead here. We collapse them to an
    // O(1) append + the SAME pool-pop / spill decisions, giving identical
    // map_regs / map_slots / next_slot for every value (byte-eq NEUTRAL) at
    // O(N) total. This is what makes the 7000-local runtime_cuda_emit compile
    // in practical time after the #3709 deep-spine fix removed the crash.
    // Coupled to the equal-interval invariant the pass above guarantees: if
    // that liveness model is ever changed to non-uniform intervals, the
    // self-host byteeq gate (gen3≡gen4 + faithful, exercised on the WHOLE
    // compiler) breaks immediately — so this cannot silently miscompile.
    let mut s = 0
    while s < len(order) {
        let cur = order[s]

        if len(map_regs[cur]) > 0 {
            // pre-colored (param pre-color path) — already has a reg; track it.
            active_idx.push(cur)
            s = s + 1
            continue
        }

        if len(pool) > 0 {
            let r = pool[0]
            let mut np: [string] = []
            let mut tt = 1
            while tt < len(pool) {
                np.push(pool[tt])
                tt = tt + 1
            }
            pool = np
            map_regs[cur] = r
            map_slots[cur] = -1
            active_idx.push(cur)
        } else {
            // pool exhausted: under whole-fn liveness no resident value has a
            // later end than `cur` (all ends equal), so the steal branch is
            // dead → plain spill, exactly as the original's else.
            map_regs[cur] = ""
            map_slots[cur] = next_slot
            next_slot = next_slot + 8
        }
        s = s + 1
    }

    // RT-NATIVE leg B PAIR-MODEL — reserve a parallel per-value tag-slot
    // region ABOVE the payload-spill region. Every value (one per `map_ids`
    // entry) gets an 8-byte tag slot so the HexaVal tag is carried alongside
    // the payload register/spill. tag_base = top of the payload-spill region.
    let tag_base = next_slot
    let mut frame = next_slot + n * 8
    let rem = frame - (frame / 16) * 16
    if rem != 0 { frame = frame + (16 - rem) }

    // #3712 — build the O(1) id→index array from the final `map_ids` order.
    let mut rm_maxid: i64 = -1
    let mut mj = 0
    while mj < len(map_ids) {
        if map_ids[mj] > rm_maxid { rm_maxid = map_ids[mj] }
        mj = mj + 1
    }
    let mut rm_id2idx: [i64] = []
    let mut zj = 0
    while zj <= rm_maxid { rm_id2idx.push(-1); zj = zj + 1 }
    let mut mk = 0
    while mk < len(map_ids) {
        if map_ids[mk] >= 0 { rm_id2idx[map_ids[mk]] = mk }
        mk = mk + 1
    }

    let map = X86RegMap { ids: map_ids, regs: map_regs, slots: map_slots, tag_base: tag_base, id2idx: rm_id2idx }
    return X86AllocResult { map: map, frame_size: frame }
}

// #3712 — O(1) RegMap probe: id → index-into-`ids` (-1 = absent/out-of-range).
// Replaces the O(len(ids)) `_x86_index_of(rm.ids, id)` linear scan at the
// per-operand codegen lookups. Returns the identical slot the scan would
// (built from the same `ids` order) → byte-eq NEUTRAL.
fn _x86_rm_idx(rm: X86RegMap, id: i64) -> i64 {
    if id < 0 || id >= len(rm.id2idx) { return -1 }
    return rm.id2idx[id]
}

fn _x86_reg_lookup(rm: X86RegMap, id: i64) -> string {
    let idx = _x86_rm_idx(rm, id)
    if idx < 0 { return _x86_64_reg_for_local(id) }
    if rm.slots[idx] >= 0 { return "r10" }
    if len(rm.regs[idx]) == 0 { return _x86_64_reg_for_local(id) }
    return rm.regs[idx]
}

fn _x86_is_spilled(rm: X86RegMap, id: i64) -> bool {
    let idx = _x86_rm_idx(rm, id)
    if idx < 0 { return false }
    return rm.slots[idx] >= 0
}

fn _x86_spill_offset(rm: X86RegMap, id: i64) -> i64 {
    let idx = _x86_rm_idx(rm, id)
    if idx < 0 { return 0 }
    return rm.slots[idx]
}

// RT-NATIVE leg B PAIR-MODEL — per-value tag-slot frame byte-offset for value
// `id`. Returns -1 if `id` is not tracked (no tag slot reserved). The slot is
// the 8 bytes at [rbp, -8 - off]. Mirrors arm64's tag eightbyte (the `lo`
// register of its 16B pair), here kept in a parallel frame region so the rest
// of the raw-int payload model is untouched.
fn _x86_tag_off(rm: X86RegMap, id: i64) -> i64 {
    let idx = _x86_rm_idx(rm, id)
    if idx < 0 { return -1 }
    return rm.tag_base + idx * 8
}

// ── Per-function instruction accumulator (module scope) ──────────
//
// PERF (gen3 deep-fn O(n²) kill — mirrors hir_to_mir #18 `_lr_locals`):
// the LIR instruction buffer was previously threaded BY VALUE through
// `_x86_64_lower_func` → `_emit_x86_64_stmt` and the ~14 emit helpers
// (`fn f(buf: [LInstr], …) -> [LInstr]`). Every helper returned the whole
// growing array, so `__hexa_fn_arena_return` deep-`hexa_val_heapify`'d the
// ENTIRE O(N) buffer once PER statement → O(N²) compile on a deep function
// (measured on aiden: the 7000-binop runtime_cuda_emit / depth-1500 synthetic
// spent >80% of wall time in hexa_val_heapify under codegen_x86_64_linux →
// _emit_x86_64_stmt; #3712 had already removed the regalloc O(locals²), this
// is the next site the deep-spine fix exposed).
//
// FIX: the buffer moves to this module-scope accumulator; the helpers mutate
// it in place via `_x86_buf.push(...)` and no longer take/return it. The
// emitted instruction sequence (contents + order) is IDENTICAL — only the
// per-statement whole-array heapify is removed — so codegen output is byte-eq
// NEUTRAL. `_x86_64_lower_func` resets it to a fresh buffer per function and
// hands it to `LFunc.instrs`; the `funcs.push(LFunc)` in `codegen_x86_64_linux`
// heapifies that buffer ONCE (the per-fn final promotion), so the next
// function's reset never dangles (same handle-vs-buffer discipline as
// `_lr_ctx_clear`). Collapses per-function codegen from O(stmts²) to O(stmts).
pub let mut _x86_buf: [LInstr] = []

// Fresh, independent instruction buffer for a new function-lowering scope.
// A bare `[]` literal evaluated under a live fn-arena is arena-backed and
// would be freed on the callee arena rewind (dangling module global); the
// returned LFunc carries this buffer and is heapified at `funcs.push`, which
// promotes it to the heap before the next `_x86_64_lower_func` reset — so the
// arena buffer is safely abandoned (mirrors `_lr_ctx_fresh`).
fn _x86_fresh_instr_buf() -> [LInstr] {
    let b: [LInstr] = []
    return b
}

// Emit a tag store from a REGISTER source: `mov [rbp, -8-tagoff], reg`. The
// register source gives the store an unambiguous operand size (8 bytes) under
// GAS Intel syntax. No-op for untracked ids.
fn _x86_store_tag_reg(rm: X86RegMap, id: i64, src_reg: string) {
    let off = _x86_tag_off(rm, id)
    if off < 0 { return }
    _x86_buf.push(_x86_instr2("mov", _x86_op_mem("rbp", _x86_frame_off(off)), _x86_op_reg(src_reg),
                     "store tag L" + to_string(id)))
    return
}

// Emit a tag store from an IMMEDIATE constant tag. A direct `mov mem, imm` is
// ambiguous in GAS Intel syntax (no operand width) — so materialize the tag
// into the r11 scratch first, then store from the register. r11 is free at
// every call site (the binop/call-result tag stores run AFTER the result has
// been captured into dst, so the r10/r11 operand scratches are dead).
fn _x86_store_tag_imm(rm: X86RegMap, id: i64, tag: i64) {
    let off = _x86_tag_off(rm, id)
    if off < 0 { return }
    _x86_buf.push(_x86_instr2("mov", _x86_op_reg("r11"), _x86_op_imm(tag),
                     "materialize tag imm " + to_string(tag)))
    _x86_buf.push(_x86_instr2("mov", _x86_op_mem("rbp", _x86_frame_off(off)), _x86_op_reg("r11"),
                     "store tag L" + to_string(id)))
    return
}

// Load value `id`'s carried tag from its tag-slot into `scratch` (TAG_INT=0 if
// untracked). The reg-source counterpart of _x86_tag_resolve for a bare id.
fn _x86_tag_resolve_local(rm: X86RegMap, id: i64, scratch: string) {
    let off = _x86_tag_off(rm, id)
    if off < 0 {
        _x86_buf.push(_x86_instr2("mov", _x86_op_reg(scratch), _x86_op_imm(0),
                         "tag L" + to_string(id) + " untracked = TAG_INT"))
        return
    }
    _x86_buf.push(_x86_instr2("mov", _x86_op_reg(scratch),
                     _x86_op_mem("rbp", _x86_frame_off(off)),
                     "tag L" + to_string(id) + " from tag-slot"))
    return
}

// Materialize the HexaVal TAG of operand `o` into `scratch` and return the
// LOperand to read it. const_str→3 const_float→1 const_int→0; a `local` loads
// its carried tag from the value's tag-slot (the WHOLE point of the pair model
// — a string stored in a local keeps TAG_STR=3 instead of the operand-kind
// default 0). A tracked global also loads from its tag-slot; otherwise 0.
fn _x86_tag_resolve(o: Operand, rm: X86RegMap, scratch: string) {
    if o.kind == "const_str"   {
        _x86_buf.push(_x86_instr2("mov", _x86_op_reg(scratch), _x86_op_imm(3),
                         "tag const_str = TAG_STR"))
        return
    }
    if o.kind == "const_float" {
        _x86_buf.push(_x86_instr2("mov", _x86_op_reg(scratch), _x86_op_imm(1),
                         "tag const_float = TAG_FLOAT"))
        return
    }
    if o.kind == "local" {
        let off = _x86_tag_off(rm, o.local_id)
        if off >= 0 {
            _x86_buf.push(_x86_instr2("mov", _x86_op_reg(scratch),
                             _x86_op_mem("rbp", _x86_frame_off(off)),
                             "tag L" + to_string(o.local_id) + " from tag-slot"))
            return
        }
    }
    if o.kind == "global" {
        // RT-NATIVE M5 routeb-r4 (measure-7): a module-global's tag is the SSOT in
        // its OWN `.data` slot word1 (`[rip+g<id>+8]`), written by the global-store
        // path in _x86_emit_dst_writeback (mirroring arm64's `ldp lo,hi,[g<id>]`
        // which reads tag+payload from the slot together). The per-FUNCTION frame
        // tag-slot is NOT cross-function-visible, so a reader in a different
        // function from the writer must read the slot word1, not its own frame
        // tag-slot (which a foreign writer never populated → stale TAG_INT=0). This
        // is the read mirror of the +8 tag persist on the write side.
        _x86_buf.push(_x86_instr2("mov", _x86_op_reg(scratch),
                         _x86_op_label("[rip+g" + to_string(o.global_id) + "+8]"),
                         "tag g" + to_string(o.global_id) + " from global slot+8"))
        return
    }
    // RT-NATIVE Z2c — a `const_bool` literal (`true`/`false`) carries TAG_BOOL=2,
    // NOT the operand-kind default 0. x86_64 parity with arm64_darwin.hexa
    // (_arm64_tag_resolve const_bool case). Without this the literal lowered to
    // TAG_INT and `_x86_op_resolve`'s missing const_bool case dropped the payload
    // to imm 0, so `return true`/`return false` both returned (tag=0,payload=0)
    // — every bool-returning native-seed fn (rt_str_starts_with_b/ends_with_b/
    // contains_b) silently returned false.
    if o.kind == "const_bool" {
        _x86_buf.push(_x86_instr2("mov", _x86_op_reg(scratch), _x86_op_imm(2),
                         "tag const_bool = TAG_BOOL"))
        return
    }
    // const_int / untracked → TAG_INT = 0
    _x86_buf.push(_x86_instr2("mov", _x86_op_reg(scratch), _x86_op_imm(0),
                     "tag default = TAG_INT"))
    return
}

// String literal → rodata label map. See arm64_darwin.hexa for the
// equivalent shape; both targets emit ".LCstr<N>" labels in lock-
// step so a fixed source MIR yields the same per-target label index.
pub struct X86StrTab {
    keys: [string],
    labels: [string]
}

fn _x86_strtab_lookup(st: X86StrTab, s: string) -> string {
    let mut i = 0
    while i < len(st.keys) {
        if st.keys[i] == s { return st.labels[i] }
        i = i + 1
    }
    return ""
}

fn _x86_64_op_for_operand_st(o: Operand, st: X86StrTab) -> LOperand {
    if o.kind == "local" {
        return _x86_op_reg(_x86_64_reg_for_local(o.local_id))
    }
    if o.kind == "const_int" {
        return _x86_op_imm(o.int_val)
    }
    // RT-NATIVE Z2c — const_bool payload = int_val (0/1), like const_int.
    if o.kind == "const_bool" {
        return _x86_op_imm(o.int_val)
    }
    // RT-NATIVE-ZEROC M1 — const_float payload = IEEE-754 bits (see _x86_op_resolve).
    if o.kind == "const_float" {
        return _x86_op_imm(float_to_bits(o.float_val))
    }
    if o.kind == "global" {
        return _x86_op_label("g" + to_string(o.global_id))
    }
    if o.kind == "const_str" {
        let lbl = _x86_strtab_lookup(st, o.str_val)
        if len(lbl) > 0 { return _x86_op_label(lbl) }
        return _x86_op_label(o.str_val)
    }
    return _x86_op_imm(0)
}

fn _x86_64_op_for_operand(o: Operand) -> LOperand {
    let st = X86StrTab { keys: [], labels: [] }
    return _x86_64_op_for_operand_st(o, st)
}

// ── Block label helper ───────────────────────────────────────

// Stage1 C8 — modhash = first 4 hex of sha256(module.file).
// Mirrors _arm64_modhash; both targets share the same scheme so the
// per-source disambiguator is stable across an arm64/x86_64 split
// build. Format: .L<modhash>_<fn>_bb<n> (e.g. .Le3a7_main_bb0).
fn _x86_64_modhash(file: string) -> string {
    let h = sha256(file)
    if len(h) > 3 { return h.substring(0, 4) }
    return h
}

fn _x86_64_block_label(modhash: string, fname: string, block_id: i64) -> string {
    return ".L" + modhash + "_" + fname + "_bb" + to_string(block_id)
}

// ── Binop classification (mirror of arm64 helper set) ─────────

fn _x86_is_arith_add(op: string) -> bool { return op == "add" || op == "+" }
fn _x86_is_arith_sub(op: string) -> bool { return op == "sub" || op == "-" }
fn _x86_is_arith_mul(op: string) -> bool { return op == "mul" || op == "*" }
fn _x86_is_arith_div(op: string) -> bool { return op == "div" || op == "/" }
fn _x86_is_bit_and(op: string) -> bool   { return op == "and" || op == "&" }
fn _x86_is_bit_or(op: string) -> bool    { return op == "or"  || op == "|" }
fn _x86_is_bit_xor(op: string) -> bool   { return op == "xor" || op == "^" }
fn _x86_is_shift_l(op: string) -> bool   { return op == "shl" || op == "<<" }
fn _x86_is_shift_r(op: string) -> bool   { return op == "shr" || op == ">>" }
fn _x86_is_concat(op: string) -> bool    { return op == "concat" }

// Tag-aware arithmetic binop → runtime helper symbol. Mirrors arm64's
// _hv_binop_sym for the ARITHMETIC subset only (+ - * / %): these are the
// ops whose result tag depends on operand tags (INT vs FLOAT), so they MUST
// route through the tag-dispatching runtime helper rather than a raw integer
// ALU op. Bitwise (& | ^), comparisons (handled via setcc), and concat are
// intentionally excluded — they keep their existing fast paths.
// `hexa_add` is a runtime.h MACRO; the linkable symbol is `hexa_add_slow`.
fn _x86_hv_arith_sym(op: string) -> string {
    if op == "+" || op == "add" { return "hexa_add_slow" }
    if op == "-" || op == "sub" { return "hexa_sub" }
    if op == "*" || op == "mul" { return "hexa_mul" }
    if op == "/" || op == "div" || op == "sdiv" { return "hexa_div" }
    if op == "%" || op == "mod" || op == "rem"  { return "hexa_mod" }
    return ""
}

// Tag-aware ORDERED-comparison binop → runtime helper symbol. Mirrors arm64's
// _hv_binop_sym comparison subset (< <= > >= ==): like arithmetic, the SEMANTICS
// of these ops depend on the operand TAGS (a FLOAT compare is an IEEE-754
// ordered compare; an INT compare is a two's-complement compare), so they MUST
// route through the tag-dispatching runtime helper rather than a raw integer
// `cmp` on the payloads. The prior x86_64 path emitted a raw `cmp reg, <imm>` +
// setcc — for a FLOAT operand whose payload is the 64-bit IEEE-754 bit pattern
// that (a) GNU `as` REJECTS the imm64 form ("operand type mismatch for cmp")
// and (b) even when both sides are registers it compares the raw bits as signed
// ints, giving wrong results for negatives / NaN. `!=` has no runtime symbol
// (handled separately via hexa_eq + hexa_truthy + xor, mirroring arm64).
// Each helper returns a HexaVal-bool {TAG_BOOL, 0|1} in rax:rdx.
fn _x86_hv_cmp_sym(op: string) -> string {
    if op == "==" || op == "eq"  || op == "cmp_eq" { return "hexa_eq" }
    if op == "<"  || op == "lt"  || op == "cmp_lt" { return "hexa_cmp_lt" }
    if op == ">"  || op == "gt"  || op == "cmp_gt" { return "hexa_cmp_gt" }
    if op == "<=" || op == "le"  || op == "cmp_le" { return "hexa_cmp_le" }
    if op == ">=" || op == "ge"  || op == "cmp_ge" { return "hexa_cmp_ge" }
    return ""
}

fn _x86_is_cmp_ne(op: string) -> bool {
    return op == "!=" || op == "ne" || op == "cmp_ne"
}

// SETcc suffix for source comparison op. Returns "" if not a
// comparison.
fn _x86_setcc_suffix(op: string) -> string {
    if op == "cmp_eq" || op == "==" { return "e" }
    if op == "cmp_ne" || op == "!=" { return "ne" }
    if op == "cmp_lt" || op == "<"  { return "l" }
    if op == "cmp_le" || op == "<=" { return "le" }
    if op == "cmp_gt" || op == ">"  { return "g" }
    if op == "cmp_ge" || op == ">=" { return "ge" }
    return ""
}

fn _x86_64_arg_reg_seq(idx: i64) -> string {
    if idx == 0 { return "rdi" }
    if idx == 1 { return "rsi" }
    if idx == 2 { return "rdx" }
    if idx == 3 { return "rcx" }
    if idx == 4 { return "r8"  }
    if idx == 5 { return "r9"  }
    return "rdi" // overflow → stack (TODO)
}

// ── SELFHOST-NEXT x86_64: HexaVal 16-byte SysV register-pair ABI ─────
//
// Runtime builtins (hexa_exit / hexa_print_val / hexa_len / …) take and
// return their arguments as the 16-byte `HexaVal` struct, NOT as raw
// machine integers:
//   typedef struct { HexaTag tag; union { int64_t i; char* s; … }; } HexaVal;
// (self/runtime_core.c:1108). `tag` occupies the first eightbyte (offset 0)
// and the union payload the second (offset 8, 8-byte aligned). Tag values:
//   TAG_INT=0  TAG_FLOAT=1  TAG_BOOL=2  TAG_STR=3  TAG_VOID=4.
//
// Under the System V AMD64 ABI a 16-byte INTEGER-class aggregate is passed
// BY VALUE in a register PAIR — the first eightbyte (tag) in the lower arg
// register, the second eightbyte (payload) in the next:
//   arg0 → rdi:rsi   arg1 → rdx:rcx   arg2 → r8:r9   (then 16B stack slots).
// An INTEGER-class 16-byte return comes back in rax:rdx (tag:payload).
//
// The x86_64 backend otherwise models every value as a RAW machine integer
// in ONE register (arithmetic/branch/user-call all flow raw ints), so the
// boxing/unboxing lives ONLY at the runtime-builtin call boundary. This
// mirrors the arm64 `_hv_load` / `_builtin_ret_box` semantics (x0:x1 pair)
// in the x86_64 SysV pair (rdi:rsi, …; rax:rdx return).

// First / second eightbyte register for HexaVal arg `idx` (0,1,2 → reg pair).
// Pairs consume the SysV integer-arg sequence two registers at a time.
fn _x86_hv_pair_lo(idx: i64) -> string { return _x86_64_arg_reg_seq(idx * 2) }
fn _x86_hv_pair_hi(idx: i64) -> string { return _x86_64_arg_reg_seq(idx * 2 + 1) }

// Tag eightbyte value for an operand kind. The x86_64 raw-int model carries
// ints / pointers / bools in the payload register only; the tag is derived
// here from the MIR operand kind (booleans lower to const_int in this IR,
// so a bare const_int is treated as TAG_INT — matching the arm64 const_int
// default and the runtime hexa_int boxing).
fn _x86_hv_tag_for(o: Operand) -> i64 {
    if o.kind == "const_str"   { return 3 }   // TAG_STR
    if o.kind == "const_float" { return 1 }   // TAG_FLOAT
    return 0                                   // TAG_INT (local / const_int / global)
}

// Box one runtime-call argument as a HexaVal {tag, payload} into the
// register pair (lo = tag, hi = payload), then write the constant tag into
// `lo`. `lo` is set AFTER `hi` so a payload that resolves through a scratch
// register cannot clobber the tag.
//
// The payload eightbyte must hold the VALUE for an int/bool, or the ADDRESS
// for a string/global aggregate. The asm-text renderer (compiler/emit/asm.hexa)
// prints a `mov reg, <label>` operand verbatim, which GNU `as` assembles as an
// absolute immediate (`R_X86_64_32S`) — for a `.rodata` string label that both
// rejects under PIE and (worse) loads a truncated/garbage value, not the
// pointer. So a const_str / global payload is materialised with an explicit
// RIP-relative `lea reg, [rip+label]` (address-of), the canonical x86_64
// way to take a data address position-independently. Int payloads keep the
// existing single-register resolve (a register, immediate, or spill reload).
// r10 ROOT B — emit a const char* map KEY (the ADDRESS of the .LCstr) into
// `reg`. The bug it fixes: `_x86_op_resolve` returns a bare label and `mov
// reg, .LCstr` assembles as a MEMORY LOAD of the string bytes (movabs of the
// content), not the address — so hexa_map_get/set got a garbage key pointer
// (map_get → empty result, map_set → SEGV in hexa_map_set_impl). lea gives the
// real RIP-relative address. const_str operands only; a non-const_str key
// (rare) falls back to the resolve+mov path (load its payload).
fn _x86_emit_cstr_key(o: Operand, st: X86StrTab, rm: X86RegMap, reg: string, opts: CodegenOptions) {
    if o.kind == "const_str" {
        let mut lbl = _x86_strtab_lookup(st, o.str_val)
        if len(lbl) == 0 { lbl = o.str_val }
        _x86_buf.push(_x86_instr2("lea", _x86_op_reg(reg),
                         _x86_op_label("[rip+" + lbl + "]"),
                         "map key (const char*): &" + lbl))
        return
    }
    _x86_op_rm(o, st, rm, reg, opts)
    let k = _x86_op_resolve(o, st, rm, reg, opts)
    _x86_buf.push(_x86_instr2("mov", _x86_op_reg(reg), k, "map key (payload)"))
}
fn _x86_hv_box_arg(o: Operand, st: X86StrTab, rm: X86RegMap,
                   lo: string, hi: string, opts: CodegenOptions) {
    if o.kind == "const_str" {
        // A bare string literal: payload = &.LCstr (RIP-relative), tag = 3.
        let mut lbl = _x86_strtab_lookup(st, o.str_val)
        if len(lbl) == 0 { lbl = o.str_val }
        _x86_buf.push(_x86_instr2("lea", _x86_op_reg(hi),
                         _x86_op_label("[rip+" + lbl + "]"),
                         "hv arg payload: &str " + lbl))
        _x86_buf.push(_x86_instr2("mov", _x86_op_reg(lo),
                         _x86_op_imm(3),
                         "hv arg tag = TAG_STR"))
        return
    }
    // RT-NATIVE leg B PAIR-MODEL — the tag is the value's ACTUAL carried tag,
    // NOT the operand-kind default. A `local` holding a string keeps TAG_STR
    // (recovered from its tag-slot via _x86_tag_resolve) so a tag-dispatching
    // runtime helper sees the right tag.
    //
    // ORDER MATTERS: materialize the PAYLOAD into `hi` FIRST, then the tag into
    // `lo`. If the operand's payload home register IS `lo` (e.g. a local whose
    // assigned reg coincides with the tag eightbyte register, or the rax:rdx
    // return pair), loading the tag into `lo` first would clobber the payload
    // before it is read. The tag load reads only a memory slot / immediate, so
    // it can never disturb `hi` — making payload-first the safe sequence.
    _x86_op_rm(o, st, rm, hi, opts)
    let payload = _x86_op_resolve(o, st, rm, hi, opts)
    _x86_buf.push(_x86_instr2("mov", _x86_op_reg(hi), payload, "hv arg payload"))
    _x86_tag_resolve(o, rm, lo)
    return
}

// RT-NATIVE-ZEROC M1 — load just the PAYLOAD eightbyte of operand `o` into
// register `reg` (the x86_64 raw-int payload model carries the value in one
// register; the tag is recovered separately via the tag-slot). This is the
// x86_64 counterpart of arm64's `_hv_load` hi-register half: the `__hx_*` leaf
// intrinsics operate on the raw 8-byte payload (int / IEEE-754 bits / pointer)
// only, so they never need the tag in a register. Const_str payload = the
// string ADDRESS (RIP-relative lea, never an absolute immediate — see
// _x86_hv_box_arg); int/bool/global payloads resolve through the normal
// _x86_op_rm + _x86_op_resolve path, then a guaranteed `mov reg, payload` lands
// the value in `reg` regardless of where it resolved (reg / imm / spill).
fn _x86_hv_payload(o: Operand, st: X86StrTab, rm: X86RegMap,
                   reg: string, opts: CodegenOptions) {
    if o.kind == "const_str" {
        let mut lbl = _x86_strtab_lookup(st, o.str_val)
        if len(lbl) == 0 { lbl = o.str_val }
        _x86_buf.push(_x86_instr2("lea", _x86_op_reg(reg),
                         _x86_op_label("[rip+" + lbl + "]"),
                         "hv payload: &str " + lbl))
        return
    }
    _x86_op_rm(o, st, rm, reg, opts)
    let payload = _x86_op_resolve(o, st, rm, reg, opts)
    _x86_buf.push(_x86_instr2("mov", _x86_op_reg(reg), payload, "hv payload"))
    return
}

// RT-NATIVE-ZEROC M1 — write a leaf intrinsic's {tag, payload} result into the
// destination value `id`: the payload (raw register `pay_reg`) into the dst's
// home reg, the constant `tag` into its tag-slot, then the spill writeback. The
// x86_64 counterpart of arm64's `_hv_store_dst(buf, rm, dst, x0_tag, x1_pay)`.
fn _x86_hv_store_leaf(rm: X86RegMap, id: i64, arena_id: i64,
                      pay_reg: string, tag: i64) {
    let dst_name = _x86_dst_reg(rm, id)
    if dst_name != pay_reg {
        _x86_buf.push(_x86_instr2("mov", _x86_op_reg(dst_name), _x86_op_reg(pay_reg),
                         "leaf: payload → dst L" + to_string(id)))
    }
    _x86_store_tag_imm(rm, id, tag)
    _x86_emit_dst_writeback(rm, id, arena_id)
    return
}

// RT-NATIVE M4 ARRAY-R2 — like `_x86_hv_store_leaf` but the tag comes from a
// REGISTER (not a compile-time constant): for `__hx_make_val(tag, payload)` the
// tag is a runtime word, not a fixed TAG_*. `pay_reg` holds the payload, `tag_reg`
// the tag. Writes payload→dst home, tag→dst tag-slot, then the spill writeback.
// `tag_reg` must be disjoint from `pay_reg` and from the dst home reg.
fn _x86_hv_store_leaf_tagreg(rm: X86RegMap, id: i64, arena_id: i64,
                             pay_reg: string, tag_reg: string) {
    let dst_name = _x86_dst_reg(rm, id)
    if dst_name != pay_reg {
        _x86_buf.push(_x86_instr2("mov", _x86_op_reg(dst_name), _x86_op_reg(pay_reg),
                         "leaf: payload → dst L" + to_string(id)))
    }
    _x86_store_tag_reg(rm, id, tag_reg)
    _x86_emit_dst_writeback(rm, id, arena_id)
    return
}

// ── Statement lowering (C6 — RegMap-aware) ───────────────────

fn _x86_load_spill(rm: X86RegMap, id: i64, scratch: string) {
    let off = _x86_spill_offset(rm, id)
    _x86_buf.push(_x86_instr2("mov", _x86_op_reg(scratch),
                     _x86_op_mem("rbp", _x86_frame_off(off)),
                     "reload L" + to_string(id) + " from spill slot"))
    return
}

fn _x86_store_spill(rm: X86RegMap, id: i64, src_reg: string) {
    let off = _x86_spill_offset(rm, id)
    _x86_buf.push(_x86_instr2("mov", _x86_op_mem("rbp", _x86_frame_off(off)),
                     _x86_op_reg(src_reg),
                     "spill L" + to_string(id) + " to slot"))
    return
}

// r15 — zero the SysV return pair (rax:rdx = tag:payload) for a fall-through
// (implicit) return. Without this, control falling off the end of a fn (a
// top-level program's synthetic main, or a value-less tail) leaves whatever
// the last op wrote in rax — e.g. a hexa_cmp_lt loop guard leaves TAG_BOOL=2
// in rax, so a fizzbuzz `for i in 1..25 {}` program exits 2 instead of 0. The
// C-transpile path ends such a main with an explicit `return 0`; mirror that.
fn _x86_emit_zero_ret_pair() {
    _x86_buf.push(_x86_instr2("xor", _x86_op_reg("eax"), _x86_op_reg("eax"),
                     "fall-through return: tag = 0"))
    _x86_buf.push(_x86_instr2("xor", _x86_op_reg("edx"), _x86_op_reg("edx"),
                     "fall-through return: payload = 0"))
    return
}

// PAIR-MODEL — emit the function-exit tail: free the spill frame, pop the
// callee-save align pad, restore rbx/r12-r15 (reverse push order) and rbp, ret.
// Shared by the RETURN statement and the safety epilogue so both honor the
// callee-saved ABI contract. The return-value pair (rax:rdx) is already set by
// the caller before this runs; none of these instructions touch rax/rdx.
fn _x86_emit_epilogue(spill_frame: i64) {
    if spill_frame > 0 {
        _x86_buf.push(_x86_instr2("add", _x86_op_reg("rsp"),
                         _x86_op_imm(spill_frame), "epilogue: free spill frame"))
    }
    _x86_buf.push(_x86_instr2("add", _x86_op_reg("rsp"), _x86_op_imm(8),
                     "epilogue: drop callee-save align pad"))
    _x86_buf.push(_x86_instr1("pop", _x86_op_reg("r15"), "epilogue: restore r15"))
    _x86_buf.push(_x86_instr1("pop", _x86_op_reg("r14"), "epilogue: restore r14"))
    _x86_buf.push(_x86_instr1("pop", _x86_op_reg("r13"), "epilogue: restore r13"))
    _x86_buf.push(_x86_instr1("pop", _x86_op_reg("r12"), "epilogue: restore r12"))
    _x86_buf.push(_x86_instr1("pop", _x86_op_reg("rbx"), "epilogue: restore rbx"))
    _x86_buf.push(_x86_instr1("pop", _x86_op_reg("rbp"), "epilogue: restore rbp"))
    _x86_buf.push(_x86_instr0("ret", "return"))
    return
}

fn _x86_op_rm(o: Operand, st: X86StrTab, rm: X86RegMap,
              scratch: string, opts: CodegenOptions) {
    if o.kind == "local" {
        if _x86_is_spilled(rm, o.local_id) {
            _x86_load_spill(rm, o.local_id, scratch)
        }
    }
    // RFC 070 G7-A.native impl emit (2026-05-20, D2 — x86_64 parity
    // with arm64 D1 commit 8fdb29e2). In `--shared` mode globals are
    // extern-resolved through the GOT so `.so` text stays PIC and the
    // dynamic linker accepts the load. The baseline path (`opts.shared
    // == 0`) leaves x86_64 emit byte-identical: `_x86_op_resolve` keeps
    // returning the bare `g<id>` label, and the linker fixes that as an
    // absolute / PC32 reloc as today. PIC path materializes the GOT
    // entry into `scratch` via a single `mov scratch, [rip+sym@GOTPCREL]`
    // — one instruction rather than the arm64 adrp+ldr pair because
    // x86_64 RIP-relative addressing already carries a 32-bit displacement.
    // The reloc-kind tag goes in `LInstr.comment` suffix `[reloc=…]` so
    // the asm-text emitter (future cycle) can dispatch on it without
    // re-deriving the kind. Authority:
    //   - System V AMD64 ABI §B.2 (relocation types): R_X86_64_GOTPCREL
    //     (uses 32-bit RIP-relative offset to entry in the GOT).
    //   - The Linux kernel `ld.so` rejects text segments containing
    //     R_X86_64_64 absolute relocs on a position-independent object;
    //     R_X86_64_GOTPCREL is the canonical replacement.
    if o.kind == "global" {
        let gl = "g" + to_string(o.global_id)
        if opts.shared == 1 {
            _x86_buf.push(_x86_instr2("mov", _x86_op_reg(scratch),
                             _x86_op_label("[rip+" + gl + "@GOTPCREL]"),
                             "addr GOT load: " + gl + " [reloc=" + RELOC_X86_64_GOTPCREL + "]"))
        } else {
            // RT-NATIVE x86_64 global-operand fix (#3422 root cause): a bare
            // `g<id>` label as a cmp/test/mov operand is rejected by GNU as
            // ("ambiguous operand size") — it has no register width. Load the
            // global's VALUE into `scratch` via RIP-relative addressing so the
            // consumer gets a sized register operand (mirrors arm64's adrp+ldr
            // value load). `_x86_op_resolve` returns `scratch` accordingly.
            _x86_buf.push(_x86_instr2("mov", _x86_op_reg(scratch),
                             _x86_op_label("[rip+" + gl + "]"),
                             "load global value: " + gl))
        }
    }
    return
}

fn _x86_op_resolve(o: Operand, st: X86StrTab, rm: X86RegMap,
                   scratch: string, opts: CodegenOptions) -> LOperand {
    if o.kind == "local" {
        if _x86_is_spilled(rm, o.local_id) {
            return _x86_op_reg(scratch)
        }
        return _x86_op_reg(_x86_reg_lookup(rm, o.local_id))
    }
    if o.kind == "const_int" { return _x86_op_imm(o.int_val) }
    // RT-NATIVE Z2c — a `const_bool` payload is its int_val (0/1), same as a
    // const_int immediate (the tag separates them via _x86_tag_resolve). Mirror
    // arm64_darwin's const_bool resolve. Was falling through to `imm 0`, dropping
    // `return true` to 0.
    if o.kind == "const_bool" { return _x86_op_imm(o.int_val) }
    // RT-NATIVE-ZEROC M1 — a `const_float` PAYLOAD is the IEEE-754 bit pattern
    // of the double, materialized as a 64-bit immediate (`mov reg, <bits>`,
    // which GNU as encodes as `movabs`). The x86_64 backend previously had NO
    // const_float payload path (the #3462 pair model carried int/str/bool only),
    // so a float literal resolved to the `imm 0` fallback — every float
    // arithmetic/compare leaf (__hx_payload_fadd/flt/…) operating on a LITERAL
    // computed against 0.0. `float_to_bits` (compile-time runtime builtin, also
    // used by macho_arm64.hexa float-pool emit) gives the exact 64-bit pattern,
    // sidestepping a stage0 double→bits bitcast and matching arm64's `.LCfltN:
    // .double` pool value. Operands flowing through params/locals already carry
    // real bits (boxed at the call site); this closes the LITERAL gap.
    if o.kind == "const_float" { return _x86_op_imm(float_to_bits(o.float_val)) }
    if o.kind == "global"    {
        // RFC 070 G7-A.native impl emit (2026-05-20, D2): in `--shared`
        // mode the GOT entry was loaded into `scratch` by `_x86_op_rm`,
        // so resolve must return that register — emitting the bare label
        // here would defeat the PIC indirection and re-introduce the
        // text-section absolute reloc the GOT path exists to avoid. The
        // baseline path returns the label as before for byte-eq emit.
        // Both shared (GOT addr in scratch) and baseline (value in scratch via
        // the #3422 RIP-relative load) now resolve to `scratch` — a bare
        // `g<id>` label operand is rejected by GNU as ("ambiguous size").
        return _x86_op_reg(scratch)
    }
    if o.kind == "const_str" {
        let lbl = _x86_strtab_lookup(st, o.str_val)
        if len(lbl) > 0 { return _x86_op_label(lbl) }
        return _x86_op_label(o.str_val)
    }
    return _x86_op_imm(0)
}

fn _x86_emit_dst_writeback(rm: X86RegMap, id: i64, arena_id: i64) {
    // RT-NATIVE M5-gslot-val: module-global dst. The lower marks a write to a
    // module-global with the sentinel arena_id == -999 (id = global_id); the
    // backend must store the payload to the `.data` slot `[rip+g<id>]` (the slot
    // emit_asm emits), mirroring the READ side (_x86_op_resolve global, which
    // loads `[rip+g<id>]`). Without this the write fell through to a stack spill
    // slot (lost on return) → the global stayed `.data`-zero → near-null deref.
    if arena_id == -999 {
        let home = _x86_dst_reg(rm, id)
        _x86_buf.push(_x86_instr2("mov", _x86_op_label("[rip+g" + to_string(id) + "]"),
                         _x86_op_reg(home), "global write: g" + to_string(id)))
        // RT-NATIVE M5 routeb-r4 (measure-7): PERSIST THE TAG too. The payload
        // store above mirrored arm64's `stp lo,hi` only half-way — arm64 writes
        // BOTH 16B words of the `g<id>: .quad 0 .quad 0` slot (word0=payload,
        // word1=tag), x86_64 wrote word0 only, leaving `[rip+g<id>+8]` permanently
        // zero. A module-global's tag must live in its OWN `.data` slot (the
        // cross-FUNCTION SSOT, like arm64) — a frame tag-slot is per-function, so a
        // DIFFERENT function reading the global never saw the writer's tag (every
        // cross-fn global read came back TAG_INT=0). Symptom: arena `__env_extend`
        // updated the arena-table global's payload but its tag stayed 0 → tag3→tag0
        // miscompile → SIGSEGV once the C-ABI bridge routed execution into the
        // native arena. FIX: read the tag the caller just stored into this dst's
        // frame tag-slot and persist it to `[rip+g<id>+8]` (the slot word1). If the
        // dst carries no frame tag-slot, default TAG_INT=0 (the prior implicit
        // value — byte-eq for any global that was never tag-tracked).
        let toff = _x86_tag_off(rm, id)
        if toff >= 0 {
            _x86_buf.push(_x86_instr2("mov", _x86_op_reg("r11"),
                             _x86_op_mem("rbp", _x86_frame_off(toff)),
                             "global tag: reload g" + to_string(id) + " tag-slot"))
        } else {
            _x86_buf.push(_x86_instr2("mov", _x86_op_reg("r11"), _x86_op_imm(0),
                             "global tag: untracked g" + to_string(id) + " = TAG_INT"))
        }
        _x86_buf.push(_x86_instr2("mov",
                         _x86_op_label("[rip+g" + to_string(id) + "+8]"),
                         _x86_op_reg("r11"),
                         "global tag write: g" + to_string(id) + "+8"))
        return
    }
    if _x86_is_spilled(rm, id) {
        _x86_store_spill(rm, id, "r10")
    }
    return
}

fn _x86_dst_reg(rm: X86RegMap, id: i64) -> string {
    if _x86_is_spilled(rm, id) { return "r10" }
    return _x86_reg_lookup(rm, id)
}

// r14 — count STMT_TRY_SETJMP in a fn; each gets a 256-byte jmp_buf slot
// (glibc jmp_buf is 200 B; 256 = 16-aligned headroom) reserved at the BOTTOM
// of the frame ([rsp + slot*256]). Mirrors
// arm64_darwin.hexa::_arm64_count_try_setjmp.
fn _x86_count_try_setjmp(mf: MFunc) -> i64 {
    let mut n = 0
    let mut bi = 0
    while bi < len(mf.blocks) {
        let blk = mf.blocks[bi]
        let mut si = 0
        while si < len(blk.stmts) {
            if blk.stmts[si].kind == "try_setjmp" { n = n + 1 }
            si = si + 1
        }
        bi = bi + 1
    }
    return n
}
fn _emit_x86_64_stmt(modhash: string, fname: string, s: Stmt,
                    st: X86StrTab, rm: X86RegMap, spill_frame: i64,
                    try_buf_bytes: i64, try_slot_idx: i64,
                    opts: CodegenOptions) {
    if s.kind == _STMT_ASSIGN {
        // array_lit constructor: dst = hexa_array_new(); then
        // hexa_array_push(dst, e_i) per element (push returns the array →
        // recapture into dst each step). Element count is grammar-capped
        // at 1024 (parser HX0013 truncates over-cap to 0 children) so this
        // emit is O(n) bounded — no compile-time O(n²). Runtime-call shape
        // mirrors the proven concat idiom in _STMT_BINOP below (the single
        // source of truth for emitting a runtime call in this pass).
        // NOTE: cross-call dst-preservation hardening + full rebuild
        // verification are the rebuild-gated follow (Track-A monolithic-TU
        // clang wall — see COMPILE-ONLY @N loop_closure_consolidation);
        // logic parity with the existing concat/idiv emits.
        if s.op == "array_lit" {
            let dst = _x86_op_reg(_x86_dst_reg(rm, s.dst.id))
            // hexa_array_new returns a HexaVal {tag=TAG_ARRAY, payload=ptr} in
            // rax:rdx. PAIR-MODEL: payload = rdx (the array ptr), tag = rax.
            _x86_buf.push(_x86_instr1("call", _x86_op_label("hexa_array_new"),
                             "array_lit: new array"))
            _x86_buf.push(_x86_instr2("mov", dst, _x86_op_reg("rdx"),
                             "array_lit: capture new array payload"))
            _x86_store_tag_reg(rm, s.dst.id, "rax")
            let mut i = 0
            while i < len(s.args) {
                // hexa_array_push(HexaVal arr, HexaVal item) — both args are
                // 16B HexaVal pairs: arr → rdi:rsi, item → rdx:rcx.
                _x86_hv_box_arg(s.args[i], st, rm, "rdx", "rcx", opts)
                // arr = {tag, dst-payload}: box dst's carried tag into rdi.
                _x86_tag_resolve_local(rm, s.dst.id, "rdi")
                _x86_buf.push(_x86_instr2("mov", _x86_op_reg("rsi"), dst,
                                 "array_lit: arr payload"))
                _x86_buf.push(_x86_instr1("call", _x86_op_label("hexa_array_push"),
                                 "array_lit: push elem " + to_string(i)))
                _x86_buf.push(_x86_instr2("mov", dst, _x86_op_reg("rdx"),
                                 "array_lit: recapture array payload"))
                _x86_store_tag_reg(rm, s.dst.id, "rax")
                i = i + 1
            }
            _x86_emit_dst_writeback(rm, s.dst.id, s.dst.arena_id)
            return
        }
        // struct_lit constructor (map-backed). MIR args =
        //   [type_str, k0_str, v0, k1_str, v1, ...] (2a790d85).
        // dst = hexa_map_new(); per field hexa_map_set(dst, key, val).
        // key resolves to a .rodata label = const char* (exactly the
        // hexa_map_set key ABI — no HexaVal wrap); val is a HexaVal.
        // type_str (args[0]) is carried for a later typed-struct tag;
        // map-backed v1 ignores it. Bounded by source field count.
        // Runtime-call shape parity with array_lit/concat; rebuild-
        // verification deferred (Track-A clang wall).
        if s.op == "struct_lit" && len(s.args) >= 1 {
            let dst = _x86_op_reg(_x86_dst_reg(rm, s.dst.id))
            _x86_buf.push(_x86_instr1("call", _x86_op_label("hexa_map_new"),
                             "struct_lit: new map"))
            _x86_buf.push(_x86_instr2("mov", dst, _x86_op_reg("rdx"),
                             "struct_lit: capture new map payload"))
            _x86_store_tag_reg(rm, s.dst.id, "rax")
            let mut i = 1
            while i + 1 < len(s.args) {
                // val (HexaVal) → rcx(tag):r8(payload)
                _x86_hv_box_arg(s.args[i + 1], st, rm, "rcx", "r8", opts)
                // key (const char*) → rdx — lea the ADDRESS, not the content
                _x86_emit_cstr_key(s.args[i], st, rm, "rdx", opts)
                // map (HexaVal m) → rdi(tag):rsi(payload) — set LAST.
                _x86_buf.push(_x86_instr2("mov", _x86_op_reg("rsi"), dst,
                                 "struct_lit: map payload"))
                _x86_tag_resolve_local(rm, s.dst.id, "rdi")
                _x86_buf.push(_x86_instr1("call", _x86_op_label("hexa_map_set"),
                                 "struct_lit: set field"))
                _x86_buf.push(_x86_instr2("mov", dst, _x86_op_reg("rdx"),
                                 "struct_lit: recapture map payload"))
                _x86_store_tag_reg(rm, s.dst.id, "rax")
                i = i + 2
            }
            _x86_emit_dst_writeback(rm, s.dst.id, s.dst.arena_id)
            return
        }
        // RFC 074 Phase 4 — multi-cell enum payload constructor.
        // Producer = compiler/lower/hir_to_mir.hexa enum_path arm (>=2 args).
        // Mirror of arm64 enum_ctor — same hexa_map_new + per-cell
        // hexa_map_set walk as struct_lit; the op-string split marks the
        // multi-cell payload semantic so a future cycle can swap to a
        // contiguous N-cell layout without disturbing struct_lit.
        if s.op == "enum_ctor" && len(s.args) >= 1 {
            let dst = _x86_op_reg(_x86_dst_reg(rm, s.dst.id))
            _x86_buf.push(_x86_instr1("call", _x86_op_label("hexa_map_new"),
                             "enum_ctor: new map (multi-cell payload)"))
            _x86_buf.push(_x86_instr2("mov", dst, _x86_op_reg("rdx"),
                             "enum_ctor: capture new map payload"))
            _x86_store_tag_reg(rm, s.dst.id, "rax")
            let mut i = 1
            while i + 1 < len(s.args) {
                _x86_op_rm(s.args[i], st, rm, "r10", opts)
                let key = _x86_op_resolve(s.args[i], st, rm, "r10", opts)
                _x86_op_rm(s.args[i + 1], st, rm, "r11", opts)
                let val = _x86_op_resolve(s.args[i + 1], st, rm, "r11", opts)
                _x86_buf.push(_x86_instr2("mov", _x86_op_reg("rsi"), key,
                                 "enum_ctor: cell key"))
                _x86_buf.push(_x86_instr2("mov", _x86_op_reg("rdx"), val,
                                 "enum_ctor: cell val"))
                _x86_buf.push(_x86_instr2("mov", _x86_op_reg("rdi"), dst,
                                 "enum_ctor: map arg"))
                _x86_buf.push(_x86_instr1("call", _x86_op_label("hexa_map_set"),
                                 "enum_ctor: set cell"))
                _x86_buf.push(_x86_instr2("mov", dst, _x86_op_reg("rdx"),
                                 "enum_ctor: recapture map payload"))
                _x86_store_tag_reg(rm, s.dst.id, "rax")
                i = i + 2
            }
            _x86_emit_dst_writeback(rm, s.dst.id, s.dst.arena_id)
            return
        }
        // field access (map-backed, symmetric to struct_lit/enum_path):
        //   args = [base, "<name>"_str] → dst = hexa_map_get(base, key).
        // key const_str → .rodata label = const char* (map_get ABI).
        // Parity with the shipped array_lit/struct_lit emits; rebuild-
        // verification deferred (Track-A clang wall).
        if s.op == "field" && len(s.args) >= 2 {
            // hexa_map_get(HexaVal m, const char* key) → m is a 16B pair
            // (rdi:rsi), key is a raw char* (rdx). Box the map receiver so its
            // carried tag (TAG_MAP) reaches the runtime tag-dispatch.
            let dst = _x86_op_reg(_x86_dst_reg(rm, s.dst.id))
            _x86_hv_box_arg(s.args[0], st, rm, "rdi", "rsi", opts)
            // field map_get key (const char*) → rdx — lea the ADDRESS (r10 ROOT B)
            _x86_emit_cstr_key(s.args[1], st, rm, "rdx", opts)
            _x86_buf.push(_x86_instr1("call", _x86_op_label("hexa_map_get"),
                             "field: hexa_map_get"))
            _x86_buf.push(_x86_instr2("mov", dst, _x86_op_reg("rdx"),
                             "field: capture result payload"))
            _x86_store_tag_reg(rm, s.dst.id, "rax")
            _x86_emit_dst_writeback(rm, s.dst.id, s.dst.arena_id)
            return
        }
        // array/map subscript: base[idx]. hir_to_mir lowers `a[i]` to
        // STMT_ASSIGN op="index" args=[base, idx]. Without this dedicated
        // branch the default-assign fall-through below would just copy the
        // BASE container payload into dst (and carry the container's TAG_ARRAY
        // tag) — every `a[i]` returned the whole array pointer, so a numeric
        // binop on it added two array pointers and the loaded element carried
        // tag=TAG_ARRAY instead of TAG_INT/TAG_FLOAT (the confirmed
        // fn-param array-index corruption; arm64_darwin.hexa already had this
        // branch — x86_64 was missing it). @root-cause-ok: route through
        // hexa_index_get(container, key) exactly as the arm64 path does — the
        // runtime dispatches arrays via hexa_array_get, unwraps VALSTRUCT, and
        // returns the element as a properly-tagged HexaVal {tag,payload} pair.
        //
        // SysV AMD64: both args are 16B INTEGER-class HexaVal pairs passed by
        // value — arg0 (container) → rdi:rsi, arg1 (key) → rdx:rcx. Box the
        // container's CARRIED tag (recovered from its tag-slot, not the
        // operand-kind default) so a param array reaches the runtime as
        // TAG_ARRAY. The 16B return comes back tag:payload in rax:rdx.
        // r17 — closure-expression site. hir_to_mir lowers a closure to
        // STMT_ASSIGN op="closure_new" with args = [env_array, lambda_name_str,
        // arity_int] and emits the lifted __hexa_lambda_N MFunc separately.
        // Runtime ABI: hexa_closure_new(void* fn_ptr, int arity, HexaVal env)
        // — fn_ptr → rdi, arity (C int) → esi, env HexaVal pair → rdx:rcx;
        // returns the TAG_CLOSURE HexaVal in rax:rdx. fn_ptr = address of the
        // lifted lambda symbol via RIP-relative lea. Mirrors arm64_darwin.hexa.
        if s.op == "closure_new" && len(s.args) >= 3 {
            let dst = _x86_op_reg(_x86_dst_reg(rm, s.dst.id))
            let lam_sym = s.args[1].str_val
            let arity = s.args[2].int_val
            // rdi = &__hexa_lambda_N (RIP-relative address-of).
            _x86_buf.push(_x86_instr2("lea", _x86_op_reg("rdi"),
                             _x86_op_label("[rip+" + lam_sym + "]"),
                             "closure_new: lambda fn-ptr"))
            // esi = arity (C int).
            _x86_buf.push(_x86_instr2("mov", _x86_op_reg("esi"),
                             _x86_op_imm(arity), "closure_new: arity"))
            // rdx:rcx = env array HexaVal.
            _x86_hv_box_arg(s.args[0], st, rm, "rdx", "rcx", opts)
            _x86_buf.push(_x86_instr1("call", _x86_op_label("hexa_closure_new"),
                             "closure_new: build TAG_CLOSURE"))
            _x86_buf.push(_x86_instr2("mov", dst, _x86_op_reg("rdx"),
                             "closure_new: capture closure payload"))
            _x86_store_tag_reg(rm, s.dst.id, "rax")
            _x86_emit_dst_writeback(rm, s.dst.id, s.dst.arena_id)
            return
        }
        if s.op == "index" && len(s.args) >= 2 {
            let dst = _x86_op_reg(_x86_dst_reg(rm, s.dst.id))
            _x86_hv_box_arg(s.args[0], st, rm, "rdi", "rsi", opts)  // container
            _x86_hv_box_arg(s.args[1], st, rm, "rdx", "rcx", opts)  // key
            _x86_buf.push(_x86_instr1("call", _x86_op_label("hexa_index_get"),
                             "index: hexa_index_get"))
            _x86_buf.push(_x86_instr2("mov", dst, _x86_op_reg("rdx"),
                             "index: capture element payload"))
            _x86_store_tag_reg(rm, s.dst.id, "rax")
            _x86_emit_dst_writeback(rm, s.dst.id, s.dst.arena_id)
            return
        }
        // index-set: `arr[i] = v` / `map[k] = v`. hir_to_mir lowers an
        // index-lhs assignment to STMT_ASSIGN op="index_set" with
        // args = [container, key, value]; there is no dst local. Mirror the
        // arm64 path: three HexaVal pairs → container rdi:rsi, key rdx:rcx,
        // value r8:r9 (SysV INTEGER-class eightbyte sequence). hexa_index_set
        // RETURNS the (possibly relocated) container HexaVal — it is NOT a
        // pure side effect — so store the result (rax:rdx) back into the
        // container lvalue when it is a storable local/global.
        if s.op == "index_set" && len(s.args) >= 3 {
            _x86_hv_box_arg(s.args[0], st, rm, "rdi", "rsi", opts)  // container
            _x86_hv_box_arg(s.args[1], st, rm, "rdx", "rcx", opts)  // key
            _x86_hv_box_arg(s.args[2], st, rm, "r8", "r9", opts)    // value
            _x86_buf.push(_x86_instr1("call", _x86_op_label("hexa_index_set"),
                             "index_set: hexa_index_set"))
            let cont = s.args[0]
            if cont.kind == "local" {
                _x86_buf.push(_x86_instr2("mov", _x86_op_reg(_x86_dst_reg(rm, cont.local_id)),
                                 _x86_op_reg("rdx"),
                                 "index_set: store-back container payload"))
                _x86_store_tag_reg(rm, cont.local_id, "rax")
                _x86_emit_dst_writeback(rm, cont.local_id, 0)
            }
            return
        }
        if len(s.args) >= 1 {
            let mut src_scratch = "r10"
            if _x86_is_spilled(rm, s.dst.id) { src_scratch = "r11" }
            _x86_op_rm(s.args[0], st, rm, src_scratch, opts)
            let src = _x86_op_resolve(s.args[0], st, rm, src_scratch, opts)
            let dst = _x86_op_reg(_x86_dst_reg(rm, s.dst.id))
            _x86_buf.push(_x86_instr2("mov", dst, src, "assign L" + to_string(s.dst.id)))
            // PAIR-MODEL — carry the source value's tag to the dst so an
            // assigned string/array keeps its HexaVal tag (e.g. `let x = s`).
            // RT-NATIVE measure-9 (tag-corruption root-cause): the tag-slot
            // store MUST precede the writeback. For a module-global dst
            // (arena_id == -999) _x86_emit_dst_writeback PERSISTS the frame
            // tag-slot to the global's `.data` slot word1 (`[rip+g<id>+8]`);
            // when the writeback ran FIRST (the prior order) it read a STALE /
            // uninitialized frame tag-slot and wrote garbage (observed tag
            // 0x100000 = 1<<20) into the global's persisted tag — a later
            // cross-function read of `[rip+g<id>+8]` then fed that garbage to
            // the comparison helper ("cannot compare tag 0 with tag 1048576").
            // The local-only paths (array_lit/struct_lit/index_set) already
            // store the tag BEFORE the writeback; this aligns the plain-assign
            // path with them (and with arm64's atomic stp lo,hi global store).
            // Reorder ONLY — byte-eq-inert for any dst whose tag-slot was
            // already correct (non-global, or global whose slot happened to
            // hold the right tag). x86_64-ONLY; arm64 fixpoint untouched.
            _x86_tag_resolve(s.args[0], rm, "r11")
            _x86_store_tag_reg(rm, s.dst.id, "r11")
            _x86_emit_dst_writeback(rm, s.dst.id, s.dst.arena_id)
        }
        return
    }
    if s.kind == _STMT_BINOP {
        if len(s.args) >= 2 {
            let a_scratch = "r10"
            let b_scratch = "r11"
            _x86_op_rm(s.args[0], st, rm, a_scratch, opts)
            _x86_op_rm(s.args[1], st, rm, b_scratch, opts)
            let a = _x86_op_resolve(s.args[0], st, rm, a_scratch, opts)
            let b = _x86_op_resolve(s.args[1], st, rm, b_scratch, opts)
            let dst_name = _x86_dst_reg(rm, s.dst.id)
            let dst = _x86_op_reg(dst_name)

            if _x86_is_concat(s.op) {
                // hexa_str_concat(HexaVal a, HexaVal b) → HexaVal in rax:rdx.
                // PAIR-MODEL: box both args (a→rdi:rsi, b→rdx:rcx) so each
                // carries its TAG_STR; capture payload from rdx, tag from rax.
                _x86_hv_box_arg(s.args[0], st, rm, "rdi", "rsi", opts)
                _x86_hv_box_arg(s.args[1], st, rm, "rdx", "rcx", opts)
                _x86_buf.push(_x86_instr1("call", _x86_op_label("hexa_str_concat"),
                                 "call runtime: hexa_str_concat"))
                if dst.reg.name != "rdx" {
                    _x86_buf.push(_x86_instr2("mov", dst, _x86_op_reg("rdx"), "capture concat result payload"))
                }
                _x86_store_tag_reg(rm, s.dst.id, "rax")
                _x86_emit_dst_writeback(rm, s.dst.id, s.dst.arena_id)
                return
            }

            // Tag-aware arithmetic (+ - * / %): route through the runtime's
            // tag-dispatching helper EXACTLY as arm64_darwin.hexa does
            // (_hv_binop_sym). @root-cause-ok: the prior x86_64 path emitted a
            // raw integer `add`/`sub`/`imul` on the payloads and hardcoded the
            // result tag to TAG_INT (0). For FLOAT operands (e.g. a param-array
            // float element via the index_get path above) that silently
            // produced an INT-tagged HexaVal carrying the IEEE-754 BITS — so
            // `str()` rendered the bit pattern as an integer instead of the
            // float (the confirmed "raw-int model HexaVal tag 소실"). The
            // runtime helper inspects both operands' tags, performs int- or
            // float arithmetic accordingly, and returns a correctly-tagged
            // {tag,payload} pair (rax:rdx). Box both args as full HexaVal pairs
            // (a→rdi:rsi, b→rdx:rcx) so their carried tags reach the helper.
            // NB: integer-only programs keep bit-identical results (the helper
            // takes the int path); this only repairs the float/mixed case the
            // raw-int model dropped.
            let _ar_sym = _x86_hv_arith_sym(s.op)
            if len(_ar_sym) > 0 {
                _x86_hv_box_arg(s.args[0], st, rm, "rdi", "rsi", opts)
                _x86_hv_box_arg(s.args[1], st, rm, "rdx", "rcx", opts)
                _x86_buf.push(_x86_instr1("call", _x86_op_label(_ar_sym),
                                 "binop " + s.op + ": tag-dispatch " + _ar_sym))
                if dst.reg.name != "rdx" {
                    _x86_buf.push(_x86_instr2("mov", dst, _x86_op_reg("rdx"),
                                     "binop " + s.op + ": capture result payload"))
                }
                _x86_store_tag_reg(rm, s.dst.id, "rax")
                _x86_emit_dst_writeback(rm, s.dst.id, s.dst.arena_id)
                return
            }

            // Tag-aware ORDERED comparisons (< <= > >= ==): route through the
            // runtime's tag-dispatching helper EXACTLY as arm64_darwin.hexa does
            // (_hv_binop_sym). @root-cause-ok: the prior x86_64 path emitted a
            // raw `cmp <reg>, <b>` + setcc on the PAYLOADS and hardcoded the
            // result tag to TAG_BOOL. For a FLOAT operand whose payload is the
            // 64-bit IEEE-754 BIT PATTERN that produced `cmp reg, <imm64>` which
            // GNU `as` rejects outright ("operand type mismatch for cmp"), and
            // even reg/reg it compared the float bits as signed integers (wrong
            // for negatives / NaN). Same root-cause CLASS as the arithmetic
            // tag-dispatch fix (#3483). The runtime helper inspects both
            // operands' tags, performs an int- or IEEE-754-ordered compare
            // accordingly, and returns a correctly-tagged HexaVal-bool
            // {TAG_BOOL, 0|1} (rax:rdx). Box both args as full HexaVal pairs
            // (a→rdi:rsi, b→rdx:rcx) so their carried tags reach the helper.
            // NB: integer-only programs keep identical results (the helper takes
            // the int path → same 0/1 bool); this repairs the float/mixed case
            // the raw-int+imm64 model dropped. This block returns before the
            // raw-setcc path below, which is now dead for these ops.
            let _cmp_sym = _x86_hv_cmp_sym(s.op)
            if len(_cmp_sym) > 0 {
                _x86_hv_box_arg(s.args[0], st, rm, "rdi", "rsi", opts)
                _x86_hv_box_arg(s.args[1], st, rm, "rdx", "rcx", opts)
                _x86_buf.push(_x86_instr1("call", _x86_op_label(_cmp_sym),
                                 "binop " + s.op + ": tag-dispatch " + _cmp_sym))
                if dst.reg.name != "rdx" {
                    _x86_buf.push(_x86_instr2("mov", dst, _x86_op_reg("rdx"),
                                     "binop " + s.op + ": capture bool payload"))
                }
                _x86_store_tag_reg(rm, s.dst.id, "rax")
                _x86_emit_dst_writeback(rm, s.dst.id, s.dst.arena_id)
                return
            }

            // Tag-aware `!=`: no runtime hexa_cmp_ne symbol exists, so mirror
            // arm64_darwin.hexa — compute hexa_eq, take hexa_truthy of it, flip
            // the low bit, and box as TAG_BOOL. @root-cause-ok: same class as
            // above (the prior raw `cmp+setne` on float bits was both `as`-
            // rejected for imm64 and semantically wrong). hexa_eq returns a
            // HexaVal-bool in rax:rdx; hexa_truthy takes a HexaVal (rdi:rsi) and
            // returns a C int (raw, in rax/eax).
            if _x86_is_cmp_ne(s.op) {
                _x86_hv_box_arg(s.args[0], st, rm, "rdi", "rsi", opts)
                _x86_hv_box_arg(s.args[1], st, rm, "rdx", "rcx", opts)
                _x86_buf.push(_x86_instr1("call", _x86_op_label("hexa_eq"),
                                 "binop !=: tag-dispatch hexa_eq"))
                // Move the HexaVal-bool result (rax:rdx) into hexa_truthy's arg
                // pair (rdi:rsi) — order rdi←rax then rsi←rdx is clobber-safe.
                _x86_buf.push(_x86_instr2("mov", _x86_op_reg("rdi"), _x86_op_reg("rax"),
                                 "binop !=: eq.tag → truthy arg lo"))
                _x86_buf.push(_x86_instr2("mov", _x86_op_reg("rsi"), _x86_op_reg("rdx"),
                                 "binop !=: eq.payload → truthy arg hi"))
                _x86_buf.push(_x86_instr1("call", _x86_op_label("hexa_truthy"),
                                 "binop !=: truthy(eq) → rax"))
                _x86_buf.push(_x86_instr2("xor", _x86_op_reg("rax"), _x86_op_imm(1),
                                 "binop !=: !truthy"))
                if dst.reg.name != "rax" {
                    _x86_buf.push(_x86_instr2("mov", dst, _x86_op_reg("rax"),
                                     "binop !=: capture bool payload"))
                }
                _x86_store_tag_imm(rm, s.dst.id, 2) // TAG_BOOL
                _x86_emit_dst_writeback(rm, s.dst.id, s.dst.arena_id)
                return
            }

            let suf = _x86_setcc_suffix(s.op)
            if len(suf) > 0 {
                // x86 `cmp` first operand must be reg/mem, not imm. When the
                // LHS lowered to an immediate (const_int operand) we'd emit
                // `cmp 0, 0` which GNU as rejects ("operand type mismatch").
                // Materialize the LHS into a_scratch first. Mirrors the
                // arm64_darwin.hexa fix (fb09d4bf).
                let mut a_real = a
                if s.args[0].kind == "const_int" {
                    _x86_buf.push(_x86_instr2("mov", _x86_op_reg(a_scratch), a,
                                     "materialize cmp lhs to reg"))
                    a_real = _x86_op_reg(a_scratch)
                }
                _x86_buf.push(_x86_instr2("cmp", a_real, b, "binop " + s.op))
                _x86_buf.push(_x86_instr1("set" + suf, _x86_op_reg("al"),
                                 "binop " + s.op + " → al"))
                _x86_buf.push(_x86_instr2("movzx", dst, _x86_op_reg("al"),
                                 "zero-extend al into dst"))
                _x86_store_tag_imm(rm, s.dst.id, 2) // TAG_BOOL
                _x86_emit_dst_writeback(rm, s.dst.id, s.dst.arena_id)
                return
            }

            if _x86_is_arith_div(s.op) {
                // x86 idiv is single-operand: dividend in rdx:rax, divisor
                // reg/mem (NOT imm), quotient → rax. The generic 2-operand
                // `idiv dst, b` emit below is invalid on x86 (GNU as rejects
                // "operand type mismatch"). Emit the proper sequence.
                _x86_buf.push(_x86_instr2("mov", _x86_op_reg("rax"), a, "idiv dividend → rax"))
                _x86_buf.push(_x86_instr0("cqo", "sign-extend rax into rdx:rax"))
                // idiv forbids an immediate/label divisor — it must be reg/mem.
                // ALWAYS materialize into b_scratch: const_int lowers to an imm,
                // and any unhandled operand kind falls through `_x86_op_resolve`
                // to the `imm 0` fallback (which produced the invalid `idiv 0`
                // seen in whole-compiler emit). One unconditional mov covers
                // every case, keeping b_scratch as a sized register divisor.
                _x86_buf.push(_x86_instr2("mov", _x86_op_reg(b_scratch), b,
                                 "materialize idiv divisor to reg"))
                let divisor = _x86_op_reg(b_scratch)
                _x86_buf.push(_x86_instr1("idiv", divisor, "binop /"))
                _x86_buf.push(_x86_instr2("mov", dst, _x86_op_reg("rax"),
                                 "idiv quotient → dst"))
                _x86_store_tag_imm(rm, s.dst.id, 0) // TAG_INT
                _x86_emit_dst_writeback(rm, s.dst.id, s.dst.arena_id)
                return
            }
            // r8 ROOT B — shift `<<`/`>>`. No native case existed → fell to
            // the default mnemonic "add" (a<<8 emitted as add dst,8). x86 shift
            // count must be in CL; >> is arithmetic (sar) for signed i64
            // (matches arm64 asr). Emit mov dst,a / mov rcx,count / shl|sar dst,cl.
            if _x86_is_shift_l(s.op) || _x86_is_shift_r(s.op) {
                // x86 shift count must be in CL. Collision-safe order: load the
                // count into rcx FIRST (b lives in b_scratch=r11), then load lhs
                // into r10 (a_scratch), shift r10 by cl, write dst LAST. dst may
                // be rcx (allocatable) but rcx is already consumed by the shift;
                // dst may be r10 (then the final mov is a harmless self-move).
                _x86_buf.push(_x86_instr2("mov", _x86_op_reg("rcx"), b, "shift count → rcx (cl)"))
                _x86_buf.push(_x86_instr2("mov", _x86_op_reg("r10"), a, "shift lhs → r10"))
                let mut _sm = "shl"
                if _x86_is_shift_r(s.op) { _sm = "sar" }
                _x86_buf.push(_x86_instr2(_sm, _x86_op_reg("r10"), _x86_op_reg("cl"),
                                 "binop " + s.op + " (count in cl)"))
                _x86_buf.push(_x86_instr2("mov", dst, _x86_op_reg("r10"), "shift result → dst"))
                _x86_store_tag_imm(rm, s.dst.id, 0) // TAG_INT
                _x86_emit_dst_writeback(rm, s.dst.id, s.dst.arena_id)
                return
            }
            _x86_buf.push(_x86_instr2("mov", dst, a, "binop lhs into dst"))
            let mut mnemonic = "add"
            if _x86_is_arith_add(s.op) { mnemonic = "add" }
            if _x86_is_arith_sub(s.op) { mnemonic = "sub" }
            if _x86_is_arith_mul(s.op) { mnemonic = "imul" }
            if _x86_is_bit_and(s.op)   { mnemonic = "and" }
            if _x86_is_bit_or(s.op)    { mnemonic = "or"  }
            if _x86_is_bit_xor(s.op)   { mnemonic = "xor" }
            // x86-64 ALU ops take a sign-extended imm32; an operand outside
            // [-2^31, 2^31) (e.g. a 0xFC000000 bitmask) is rejected by GNU as
            // ("invalid operand"). Materialize a wide const into a register so
            // the op uses a 64-bit reg divisor/source.
            let mut b_real = b
            if s.args[1].kind == "const_int" {
                let bv = s.args[1].int_val
                if bv > 2147483647 || bv < -2147483648 {
                    _x86_buf.push(_x86_instr2("mov", _x86_op_reg(b_scratch), b,
                                     "materialize wide imm to reg (x86 ALU imm is imm32)"))
                    b_real = _x86_op_reg(b_scratch)
                }
            }
            _x86_buf.push(_x86_instr2(mnemonic, dst, b_real, "binop " + s.op))
            _x86_store_tag_imm(rm, s.dst.id, 0) // TAG_INT (arith/bitwise)
            _x86_emit_dst_writeback(rm, s.dst.id, s.dst.arena_id)
        }
        return
    }
    if s.kind == _STMT_CALL {
        let arg_n = len(s.args)
        // ── RT-NATIVE-ZEROC M1: x86_64 `__hx_*` leaf-intrinsic parity ──────
        // Bring the x86_64 backend to parity with arm64_darwin.hexa for the 25
        // whitelisted `__hx_*` leaf intrinsics (check/bind.hexa _bind_builtin_
        // names). Each is INLINED — no runtime call — operating on the raw
        // HexaVal payload (the x86_64 raw-int single-register model; tag carried
        // in the tag-slot). Every encoding here was verified against GNU `as` +
        // `objdump` ground-truth (scripts/scratch/rt_native/x86_leaf_gate.sh).
        // These read the second eightbyte (payload) of a value; the tag for the
        // FLOAT/INT result is written by _x86_hv_store_leaf. Foundation for the
        // M4 native runtime-core port on x86_64. Mirrors arm64 UNLOCK-2..11.

        // UNLOCK-2: `__hx_tag(v)` → int HexaVal {TAG_INT, v.tag}. The tag is the
        // value's carried tag-slot value (not the payload); read it into the dst
        // and box as TAG_INT.
        if s.op == "__hx_tag" && len(s.args) >= 1 {
            let dst_name = _x86_dst_reg(rm, s.dst.id)
            _x86_tag_resolve(s.args[0], rm, dst_name)  // dst = v.tag
            if s.dst.id >= 0 {
                _x86_store_tag_imm(rm, s.dst.id, 0)    // result TAG_INT
                _x86_emit_dst_writeback(rm, s.dst.id, s.dst.arena_id)
            }
            return
        }
        // RT-NATIVE M4 ARRAY-R2: `__hx_make_val(tag, payload)` → a {tag, payload}
        // 16-byte HexaVal from two raw int64 words, the symmetric WRITE-half of
        // `__hx_tag`. The SysV PAIR ABI here keeps tag in the value's tag-slot and
        // payload in its home reg (mirrors arm64 lo=x0=tag / hi=x1=payload). Both
        // args are int-boxed HexaVals → the WANTED word is each arg's PAYLOAD. The
        // payload word is loaded into r10 FIRST and the tag word into r11 (the same
        // first→r10 / second→r11 disjoint ordering the payload-arith leaves use, so
        // the 2nd `_x86_hv_payload` cannot clobber the 1st), then stored as
        // {tag=r11, payload=r10}. r10 is the dst home / spill reg, so the payload
        // lands correctly under `_x86_emit_dst_writeback`. No `call` (non-circular).
        if s.op == "__hx_make_val" && len(s.args) >= 2 {
            _x86_hv_payload(s.args[1], st, rm, "r10", opts)  // payload word → r10
            _x86_hv_payload(s.args[0], st, rm, "r11", opts)  // tag word     → r11
            if s.dst.id >= 0 {
                _x86_hv_store_leaf_tagreg(rm, s.dst.id, s.dst.arena_id, "r10", "r11")
            }
            return
        }
        // UNLOCK-2b: payload equality / non-zero → bool, INLINE (cmp + setcc +
        // movzx). r10 = a.payload, r11 = b.payload; al = predicate; movzx into
        // dst; tag = TAG_BOOL(2). NaN-irrelevant (raw i64 compare).
        if s.op == "__hx_payload_eq" && len(s.args) >= 2 {
            _x86_hv_payload(s.args[0], st, rm, "r10", opts)
            _x86_hv_payload(s.args[1], st, rm, "r11", opts)
