        // slots [rsp+0], [rsp+16], …; result unboxes rdx(payload)+rax(tag).
        let mut overflow_n = 0
        if arg_n > 3 { overflow_n = arg_n - 3 }
        if overflow_n > 0 {
            _x86_buf.push(_x86_instr2("sub", _x86_op_reg("rsp"),
                _x86_op_imm(overflow_n * 16),
                "hv: reserve " + to_string(overflow_n) + " 16B stack arg slots"))
        }
        // Spill args ≥3 right-to-left into the reserved slots.
        let mut k = arg_n - 1
        while k >= 3 {
            _x86_hv_box_arg(s.args[k], st, rm, "r10", "r11", opts)
            let off = (k - 3) * 16
            _x86_buf.push(_x86_instr2("mov", _x86_op_mem("rsp", off),
                _x86_op_reg("r10"), "hv stack arg " + to_string(k) + " tag"))
            _x86_buf.push(_x86_instr2("mov", _x86_op_mem("rsp", off + 8),
                _x86_op_reg("r11"), "hv stack arg " + to_string(k) + " payload"))
            k = k - 1
        }
        // Box args 0..2 into their SysV register pairs.
        let mut i = 0
        while i < arg_n {
            if i < 3 {
                let lo = _x86_hv_pair_lo(i)
                let hi = _x86_hv_pair_hi(i)
                _x86_hv_box_arg(s.args[i], st, rm, lo, hi, opts)
            }
            i = i + 1
        }
        _x86_buf.push(_x86_instr1("call", _x86_op_label(target), "call " + target))
        if overflow_n > 0 {
            _x86_buf.push(_x86_instr2("add", _x86_op_reg("rsp"),
                _x86_op_imm(overflow_n * 16),
                "hv: pop " + to_string(overflow_n) + " stack arg slots"))
        }
        if s.dst.id >= 0 {
            let dst_name = _x86_dst_reg(rm, s.dst.id)
            let dst = _x86_op_reg(dst_name)
            _x86_store_tag_reg(rm, s.dst.id, "rax")
            if dst.reg.name != "rdx" {
                _x86_buf.push(_x86_instr2("mov", dst, _x86_op_reg("rdx"),
                    "hv: unbox user-call result payload"))
            }
            _x86_emit_dst_writeback(rm, s.dst.id, s.dst.arena_id)
        }
        return
    }
    if s.kind == "call_indirect" && len(s.args) >= 1 {
        // r17 — indirect call through a closure VALUE (TAG_CLOSURE). Mirrors
        // arm64_darwin.hexa STMT_CALL_INDIRECT. HexaClo layout (runtime.h:77):
        //   struct HexaClo { void* fn_ptr; int arity; HexaVal* env_box; }
        //   → fn_ptr @0, env_box @16. The callee payload (args[0] hi) is the
        // HexaClo*. Dispatch ABI is env-first: the lifted __hexa_lambda_N takes
        // (env, a1..aN), so env → pair0 (rdi:rsi) and call args → pair1
        // (rdx:rcx), pair2 (r8:r9), pair3+ → 16B stack slots. fn_ptr + env_box
        // are pushed to the stack so the arg boxing (which clobbers the SysV
        // arg regs + r10/r11) cannot lose them.
        let arg_n = len(s.args)
        // 1. callee → r10:r11 ; r11 = HexaClo* payload.
        _x86_hv_box_arg(s.args[0], st, rm, "r10", "r11", opts)
        // 2. fn_ptr = [clo+0] → rax ; env_box = [clo+16] → rcx. Push both
        //    (keep 16B alignment with one 16B push pair).
        _x86_buf.push(_x86_instr2("mov", _x86_op_reg("rax"),
                         _x86_op_mem("r11", 0), "call_indirect: fn_ptr = clo->fn_ptr"))
        _x86_buf.push(_x86_instr2("mov", _x86_op_reg("rcx"),
                         _x86_op_mem("r11", 16), "call_indirect: env_box = clo->env_box"))
        _x86_buf.push(_x86_instr1("push", _x86_op_reg("rax"),
                         "call_indirect: save fn_ptr"))
        _x86_buf.push(_x86_instr1("push", _x86_op_reg("rcx"),
                         "call_indirect: save env_box"))
        // 3. call args a1.. → pairs 1,2,3.. (env occupies pair0). args ≥ pair3
        //    spill to 16B stack slots above the two saved 8B words.
        let mut overflow_n = 0
        if arg_n - 1 > 2 { overflow_n = (arg_n - 1) - 2 }
        if overflow_n > 0 {
            _x86_buf.push(_x86_instr2("sub", _x86_op_reg("rsp"),
                _x86_op_imm(overflow_n * 16),
                "call_indirect: reserve " + to_string(overflow_n) + " 16B stack args"))
        }
        let mut k = arg_n - 1
        while k >= 1 {
            // outgoing pair index for call-arg k is k (env is pair 0).
            if k <= 2 {
                let lo = _x86_hv_pair_lo(k)
                let hi = _x86_hv_pair_hi(k)
                _x86_hv_box_arg(s.args[k], st, rm, lo, hi, opts)
            } else {
                _x86_hv_box_arg(s.args[k], st, rm, "r10", "r11", opts)
                let off = (k - 3) * 16
                _x86_buf.push(_x86_instr2("mov", _x86_op_mem("rsp", off),
                    _x86_op_reg("r10"), "call_indirect: stack arg " + to_string(k) + " tag"))
                _x86_buf.push(_x86_instr2("mov", _x86_op_mem("rsp", off + 8),
                    _x86_op_reg("r11"), "call_indirect: stack arg " + to_string(k) + " payload"))
            }
            k = k - 1
        }
        // 4. env HexaVal = *env_box → rdi:rsi (pair0). env_box was pushed at
        //    [rsp + overflow_n*16] (below the reserved stack-arg region).
        _x86_buf.push(_x86_instr2("mov", _x86_op_reg("r11"),
                         _x86_op_mem("rsp", overflow_n * 16),
                         "call_indirect: reload env_box"))
        _x86_buf.push(_x86_instr2("mov", _x86_op_reg("rdi"),
                         _x86_op_mem("r11", 0), "call_indirect: env tag = *env_box[0]"))
        _x86_buf.push(_x86_instr2("mov", _x86_op_reg("rsi"),
                         _x86_op_mem("r11", 8), "call_indirect: env payload = *env_box[8]"))
        // 5. reload fn_ptr (pushed below env_box) → r11, indirect call.
        _x86_buf.push(_x86_instr2("mov", _x86_op_reg("r11"),
                         _x86_op_mem("rsp", overflow_n * 16 + 8),
                         "call_indirect: reload fn_ptr"))
        _x86_buf.push(_x86_instr1("call", _x86_op_reg("r11"),
                         "call_indirect: call closure fn_ptr"))
        // 6. tear down: pop the reserved stack args + the two saved words.
        if overflow_n > 0 {
            _x86_buf.push(_x86_instr2("add", _x86_op_reg("rsp"),
                _x86_op_imm(overflow_n * 16),
                "call_indirect: pop stack args"))
        }
        _x86_buf.push(_x86_instr2("add", _x86_op_reg("rsp"), _x86_op_imm(16),
                         "call_indirect: pop saved env_box + fn_ptr"))
        // 7. result HexaVal rax:rdx → dst slot.
        if s.dst.id >= 0 {
            let dst_name = _x86_dst_reg(rm, s.dst.id)
            let dst = _x86_op_reg(dst_name)
            _x86_store_tag_reg(rm, s.dst.id, "rax")
            if dst.reg.name != "rdx" {
                _x86_buf.push(_x86_instr2("mov", dst, _x86_op_reg("rdx"),
                    "call_indirect: unbox result payload"))
            }
            _x86_emit_dst_writeback(rm, s.dst.id, s.dst.arena_id)
        }
        return
    }
    if s.kind == _STMT_RETURN {
        if len(s.args) < 1 {
            // r15/r25 — bare `return` carries no value: main → tag 0 (exit
            // code), every other fn → TAG_VOID so type_of(rv()) == "void".
            _x86_emit_zero_ret_pair(fname == "main")
        }
        if len(s.args) >= 1 {
            if (_is_cabi(fname) && _cabi_sse_ret(fname))
                || (_x86_va_active && _x86_va_ret_is_fp(fname)) {
                // Route C / variadic fp-ABI return — an SSE-class (`double`) fn returns
                // its value in xmm0 (PSABI §3.2.3), NOT rax. The payload eightbyte
                // holds the IEEE-754 bits; load it into a GP scratch (r10) then movq
                // into xmm0. Must run BEFORE frame teardown (reads spill slots). A
                // variadic double-returning leaf (hxlcl_va_fp_smoke) takes this path so
                // a C caller reads the result in xmm0, not the leftover-in-rax word.
                _x86_hv_payload(s.args[0], st, rm, "r10", opts)
                _x86_buf.push(_x86_instr2("movq", _x86_op_reg("xmm0"),
                                 _x86_op_reg("r10"), "cabi fp return: gp→xmm0"))
            } else if _is_cabi(fname) || _x86_va_active {
                // A variadic fn (RUNG1, _x86_va_active) returns C-ABI single-register
                // too (its named/return contract is raw C-ABI, like a Route C leaf).
                // Folded in so the C caller reads the value in rax, not the PAIR tag.
                // Route C C-ABI return — a raw C-ABI fn returns its value in a
                // SINGLE register (rax). Load just the payload eightbyte (the
                // raw int/pointer); the HexaVal tag is dropped (the C caller
                // reads only rax). Must run BEFORE frame teardown (reads spill
                // slots off rbp).
                _x86_hv_payload(s.args[0], st, rm, "rax", opts)
            } else {
                // PAIR-MODEL — a user .hexa fn returns a 16-byte HexaVal in the
                // SysV INTEGER-class return pair rax:rdx (tag:payload). Box the
                // return operand with lo=rax (tag), hi=rdx (payload) so a returned
                // string/array carries its real tag back to the caller (and to a
                // C caller reading {long tag; long u}). Must run BEFORE the frame
                // teardown since it reads tag/spill slots off rbp.
                _x86_hv_box_arg(s.args[0], st, rm, "rax", "rdx", opts)
            }
        }
        // ING #29 literal-∅: @naked fn — NO compiler-generated epilogue (the body
        // is raw asm; e.g. a signal trampoline ends in `syscall` which never
        // returns). reference-match: GCC __attribute__((naked)).
        if !_x86_is_naked {
            _x86_emit_epilogue(spill_frame)
        }
        return
    }
    if s.kind == _STMT_BR {
        let lab = _x86_64_block_label(modhash, fname, s.target_block)
        _x86_buf.push(_x86_instr1("jmp", _x86_op_label(lab), "branch"))
        return
    }
    if s.kind == _STMT_BR_COND {
        if len(s.args) > 0 {
            _x86_op_rm(s.args[0], st, rm, "r10", opts)
            let cond = _x86_op_resolve(s.args[0], st, rm, "r10", opts)
            // x86 `test` first operand must be reg/mem, not imm. A const_int
            // condition — OR any non-local/global operand that fell through
            // `_x86_op_resolve` to the `imm 0` fallback (which produced the
            // invalid `test 0, 0` in whole-compiler emit) — must be
            // materialized into r10. local/global already resolve to reg/mem.
            let mut cond_real = cond
            if s.args[0].kind != "local" && s.args[0].kind != "global" {
                _x86_buf.push(_x86_instr2("mov", _x86_op_reg("r10"), cond,
                                 "materialize test cond to reg"))
                cond_real = _x86_op_reg("r10")
            }
            _x86_buf.push(_x86_instr2("test", cond_real, cond_real, "br_cond test"))
            let else_lab = _x86_64_block_label(modhash, fname, s.target_block_else)
            _x86_buf.push(_x86_instr1("jz", _x86_op_label(else_lab), "jump-if-zero -> else"))
        }
        let then_lab = _x86_64_block_label(modhash, fname, s.target_block)
        _x86_buf.push(_x86_instr1("jmp", _x86_op_label(then_lab), "jump -> then"))
        return
    }
    if s.kind == "load" {
        if len(s.args) >= 1 {
            _x86_op_rm(s.args[0], st, rm, "r11", opts)
            let base_op = _x86_op_resolve(s.args[0], st, rm, "r11", opts)
            let dst = _x86_op_reg(_x86_dst_reg(rm, s.dst.id))
            _x86_buf.push(_x86_instr2("mov", dst, base_op, "load"))
            _x86_emit_dst_writeback(rm, s.dst.id, s.dst.arena_id)
            // PAIR-MODEL — carry the loaded value's tag into the dst tag-slot.
            _x86_tag_resolve(s.args[0], rm, "r11")
            _x86_store_tag_reg(rm, s.dst.id, "r11")
        }
        return
    }
    if s.kind == "store" {
        if len(s.args) >= 2 {
            _x86_op_rm(s.args[0], st, rm, "r10", opts)
            _x86_op_rm(s.args[1], st, rm, "r11", opts)
            let base_op = _x86_op_resolve(s.args[0], st, rm, "r10", opts)
            let src = _x86_op_resolve(s.args[1], st, rm, "r11", opts)
            _x86_buf.push(_x86_instr2("mov", base_op, src, "store"))
        }
        return
    }
    if s.kind == "try_setjmp" {
        // jmp_buf slot at [rsp + slot*256] (bottom of frame). lea &jbuf →
        // rdi, call native musl hxlcl_setjmp; on nonzero return (longjmp-
        // resumed) jump to catch (target_block_else); on first call (0) push
        // jbuf onto the runtime try-stack then jump into the try body.
        // RFC061 §M8 re-baseline (ING#29 ∅−8): the linux-x86_64 try-block SAVE
        // now calls the hexa-native musl-layout `hxlcl_setjmp` (64-B jmp_buf:
        // [0]=rbx [8]=rbp [16]=r12 [24]=r13 [32]=r14 [40]=r15 [48]=rsp [56]=rip,
        // no glibc PTR_MANGLE), byte-id to musl src/setjmp/x86_64/setjmp.S. It
        // is PAIRED with the native musl `hxlcl_longjmp` RESTORE baked into the
        // re-baselined frozen runtime (self/runtime.c, x86_64 branch). Both
        // halves are musl-layout-consistent — replaces the prior glibc `call
        // setjmp` + glibc-longjmp pair (gen3≡gen4 reconverged 3-target). The
        // 256-B slot is kept (musl writes 64 B; the extra is unused headroom).
        let _off = try_slot_idx * 256
        _x86_buf.push(_x86_instr2("lea", _x86_op_reg("rdi"),
                         _x86_op_mem("rsp", _off),
                         "try_setjmp: &jbuf[" + to_string(try_slot_idx) + "]"))
        _x86_buf.push(_x86_instr1("call", _x86_op_label("hxlcl_setjmp"),
                         "try_setjmp: call native musl hxlcl_setjmp (64-B jmp_buf)"))
        _x86_buf.push(_x86_instr2("test", _x86_op_reg("eax"), _x86_op_reg("eax"),
                         "try_setjmp: setjmp rc"))
        let _catch_lab = _x86_64_block_label(modhash, fname, s.target_block_else)
        _x86_buf.push(_x86_instr1("jnz", _x86_op_label(_catch_lab),
                         "try_setjmp: rc!=0 -> catch"))
        _x86_buf.push(_x86_instr2("lea", _x86_op_reg("rdi"),
                         _x86_op_mem("rsp", _off),
                         "try_setjmp: &jbuf for push"))
        _x86_buf.push(_x86_instr1("call", _x86_op_label("__hexa_try_push"),
                         "try_setjmp: register jbuf"))
        let _try_lab = _x86_64_block_label(modhash, fname, s.target_block)
        _x86_buf.push(_x86_instr1("jmp", _x86_op_label(_try_lab),
                         "try_setjmp: enter try body"))
        return
    }
    if s.kind == "try_pop" {
        _x86_buf.push(_x86_instr1("call", _x86_op_label("__hexa_try_pop"),
                         "try_pop: drop jbuf from try-stack"))
        return
    }
    if s.kind == "try_last_err" {
        // catch entry — __hexa_last_error() → HexaVal in rax:rdx → dst.
        _x86_buf.push(_x86_instr1("call", _x86_op_label("__hexa_last_error"),
                         "try_last_err: HexaVal __hexa_last_error()"))
        if s.dst.id >= 0 {
            let _d = _x86_op_reg(_x86_dst_reg(rm, s.dst.id))
            _x86_store_tag_reg(rm, s.dst.id, "rax")
            _x86_buf.push(_x86_instr2("mov", _d, _x86_op_reg("rdx"),
                             "try_last_err: capture err payload"))
            _x86_emit_dst_writeback(rm, s.dst.id, s.dst.arena_id)
        }
        return
    }
    if s.kind == "throw" {
        // box err HexaVal → rdi:rsi; hexa_throw longjmps to the top try
        // frame (or exits). Never returns; the lowerer terminated the block.
        if len(s.args) >= 1 {
            _x86_hv_box_arg(s.args[0], st, rm, "rdi", "rsi", opts)
        }
        _x86_buf.push(_x86_instr1("call", _x86_op_label("hexa_throw"),
                         "throw: hexa_throw(err)"))
        return
    }
    _x86_buf.push(_x86_instr0("nop", "unhandled stmt kind " + s.kind))
    return
}

// ── Function lowering ────────────────────────────────────────

fn _x86_64_lower_func(mf: MFunc, st: X86StrTab, modhash: string,
                      opts: CodegenOptions) -> LFunc {
    _x86_buf = _x86_fresh_instr_buf()

    // C6 — run linear-scan regalloc up front.
    let alloc = _x86_64_assign_regs(mf)
    let rm = alloc.map
    // r14 — fold jmp_buf (256 B / try; glibc jmp_buf=200 B) into the frame;
    // bottom-of-frame at [rsp + slot*256], below the rbp-relative spill slots.
    let _try_cnt = _x86_count_try_setjmp(mf)
    let _try_buf_bytes = _try_cnt * 256
    // RFC061 §M8 varargs-ABI (r1) — reserve the SysV va_list frame for a variadic
    // fn: a 176-byte reg_save_area (48 GP + 128 XMM, PSABI §3.5.7 fig 3.34) + 24-byte
    // va_list struct = 200, rounded to 208 (16B mult, alignment-preserving). Reference-
    // match: GCC 13.3.0 spills `%rsi..%r9` at -168..-136(%rbp) and `%xmm0..%xmm7` via
    // movaps at -128..-16(%rbp) → reg_save_area = 176 bytes, with XMM_i @ rsa+48+16*i.
    // Wedged BETWEEN the regalloc spill slots (rbp-relative, logical [0, frame_size)) and
    // the try jmp_bufs (rsp-relative, bottom), so it aliases neither. _x86_va_active/
    // _x86_va_rsa_base/_x86_va_list_base carry the layout to the va builtins. NON-variadic
    // (default) → va_block 0 → byte-eq NEUTRAL.
    _x86_va_active = _x86_is_variadic(mf.name)
    // ING #29 literal-∅ (2026-06-30): `@naked` — propagate MFunc.is_naked to the
    // per-fn global so the prologue/epilogue guards + the return-statement path
    // read it. Reset every fn (same discipline as _x86_va_active above).
    _x86_is_naked = mf.is_naked
    let mut _va_block = 0
    if _x86_va_active { _va_block = 208 }
    let spill_frame = alloc.frame_size + _va_block + _try_buf_bytes
    if _x86_va_active {
        // reg_save_area[0] (lowest addr) just above the try bufs; GP reg i @ +8*i,
        // XMM reg i @ +48+16*i (PSABI §3.5.7). va_list struct sits at rsa+176.
        _x86_va_rsa_base = 0 - (_X86_CALLEE_SAVE_BYTES + alloc.frame_size + _va_block)
        _x86_va_list_base = _x86_va_rsa_base + 176
    } else {
        _x86_va_rsa_base = 0
        _x86_va_list_base = 0
    }

    // Prologue
    // ING #29 literal-∅ (2026-06-30): @naked SKIPS the entire prologue+epilogue
    // (reference-match: GCC __attribute__((naked)) / rustc #[naked] — the body
    // is raw asm with no compiler-generated frame setup/teardown). The naked
    // body must terminate itself (a signal trampoline ends in `syscall` which
    // never returns; a setjmp restorer emits its own `ret`). DEFAULT false on
    // every existing fn → the guard is a no-op → byte-eq NEUTRAL.
    if !_x86_is_naked {
    _x86_buf.push(_x86_instr1("push", _x86_op_reg("rbp"), "prologue: save rbp"))
    _x86_buf.push(_x86_instr2("mov", _x86_op_reg("rbp"), _x86_op_reg("rsp"), "prologue: set rbp"))
    // PAIR-MODEL — preserve the callee-saved allocation pool (rbx/r12-r15) for
    // the caller (ABI contract; the C harness and any C caller require it). The
    // 5 pushes + 8-byte pad = 48 bytes (_X86_CALLEE_SAVE_BYTES, a 16-byte
    // multiple) keep the call-site rsp alignment. These live at [rbp-8..-40]
    // and the spill/tag frame is shifted below via _x86_frame_off.
    _x86_buf.push(_x86_instr1("push", _x86_op_reg("rbx"), "prologue: save rbx"))
    _x86_buf.push(_x86_instr1("push", _x86_op_reg("r12"), "prologue: save r12"))
    _x86_buf.push(_x86_instr1("push", _x86_op_reg("r13"), "prologue: save r13"))
    _x86_buf.push(_x86_instr1("push", _x86_op_reg("r14"), "prologue: save r14"))
    _x86_buf.push(_x86_instr1("push", _x86_op_reg("r15"), "prologue: save r15"))
    _x86_buf.push(_x86_instr2("sub", _x86_op_reg("rsp"), _x86_op_imm(8),
                        "prologue: callee-save align pad"))

    if spill_frame > 0 {
        _x86_buf.push(_x86_instr2("sub", _x86_op_reg("rsp"),
                            _x86_op_imm(spill_frame),
                            "prologue: alloc spill frame"))
    }

    // RFC061 §M8 varargs-ABI (r1) — spill the 6 GP arg registers into the
    // reg_save_area BEFORE any param ingress clobbers them (PSABI §3.5.7; matches GCC
    // 13.3.0's `movq %rsi,-168(%rbp) … %r9,-136(%rbp)` reg-save block). GP reg i
    // (rdi,rsi,rdx,rcx,r8,r9) → reg_save_area[i] = [rbp + _x86_va_rsa_base + 8*i].
    // Named params are skipped at va_start via gp_offset; storing all 6 (incl. the
    // named rdi) is PSABI-faithful and harmless.
    if _x86_va_active {
        let mut _vgi = 0
        while _vgi < 6 {
            _x86_buf.push(_x86_instr2("mov",
                _x86_op_mem("rbp", _x86_va_rsa_base + _vgi * 8),
                _x86_op_reg(_x86_64_arg_reg_seq(_vgi)),
                "va prologue: spill GP arg reg → reg_save_area[" + to_string(_vgi) + "]"))
            _vgi = _vgi + 1
        }
        // r1 SSE-class — spill the 8 XMM arg registers into the FP half of the reg_save_
        // area (PSABI §3.5.7; GCC 13.3.0 spills `movaps %xmm0,-128(%rbp) … %xmm7,-16(%rbp)`
        // i.e. XMM_i @ reg_save_area + 48 + 16*i, immediately after the 48-byte GP block).
        // A `double` vararg occupies only the LOW eightbyte of its 16-byte slot, which the
        // FP va_arg reads back with `movsd (addr)` — so spilling the low 8 bytes via
        // `movq [mem], xmmN` (the same xmm↔gp/mem mnemonic the fp-ABI Route C ingress
        // already emits) is value-faithful for the double/float class (no movaps needed:
        // the high eightbyte is never consumed by a 1-eightbyte SSE va_arg). The xmm regs
        // carry the unnamed FP varargs; named FP params (none under the r1 whitelist) would
        // be skipped at va_start via fp_offset just like the GP half.
        let mut _vfi = 0
        while _vfi < 8 {
            _x86_buf.push(_x86_instr2("movq",
                _x86_op_mem("rbp", _x86_va_rsa_base + 48 + _vfi * 16),
                _x86_op_reg(_x86_64_sse_arg_reg_seq(_vfi)),
                "va prologue: spill XMM arg reg → reg_save_area FP[" + to_string(_vfi) + "]"))
            _vfi = _vfi + 1
        }
    }
    } // end `if !_x86_is_naked` (prologue) — ING #29 @naked skips frame setup

    // PAIR-MODEL ingress — each HexaVal param arrives as a 16-byte SysV
    // register PAIR: param0 → rdi:rsi, param1 → rdx:rcx, param2 → r8:r9
    // (tag = lo, payload = hi). Only THREE pairs fit in the six integer-arg
    // registers; params ≥3 arrive in caller 16B stack slots above the saved
    // rbp + return address at [rbp + 16 + (p-3)*16] (tag at +0, payload at +8).
    //
    // The PAYLOAD goes into the param's home (assigned reg or payload spill
    // slot) exactly as the prior raw-int model did — but read from the HIGH
    // (payload) register `_x86_hv_pair_hi(p)`, NOT the single `_x86_64_arg_reg(p)`
    // (the confirmed ingress bug: param0 payload is in rsi, not rdi=tag). The
    // TAG goes into the param's parallel tag-slot so it survives into any
    // downstream tag-dispatching runtime call.
    let mut p = 0
    // A variadic fn (RUNG1) is C-ABI for its NAMED params too — they arrive in single
    // arg registers (rdi,rsi,…), exactly like a Route C leaf — so fold _x86_va_active
    // into the C-ABI ingress branch. (_x86_va_active is false on the default path.)
    let _x86_cabi = _is_cabi(mf.name) || _x86_va_active
    // Route C fp-ABI — SysV §3.2.3 keeps SEPARATE INTEGER and SSE arg counters.
    // `_x86_cabi_gp` counts INTEGER-class params consumed so far (rdi/rsi/…);
    // `_x86_cabi_sse` counts SSE-class params (xmm0/xmm1/…). For the integer-only
    // whitelist (incl. variadic named params) the SSE counter never advances ⇒
    // gp == p ⇒ byte-identical to the prior `_x86_64_arg_reg_seq(p)` form.
    let mut _x86_cabi_gp = 0
    let mut _x86_cabi_sse = 0
    while p < len(mf.params) {
        let pid = mf.params[p].id
        if _x86_cabi && _cabi_sse_arg(mf.name, p) {
            // Route C fp-ABI ingress — param p is SSE-class: it arrives RAW in the
            // next SSE register xmm0..xmm7 (NOT a GP reg, NOT a pair). The body's
            // float intrinsics (__hx_payload_fmul/fadd) operate on the IEEE-754
            // BITS held in a GP reg (movq GP↔xmm internally), so move the incoming
            // xmm bits into the param's GP home and stamp TAG_FLOAT(1).
            let sse_reg = _x86_64_sse_arg_reg_seq(_x86_cabi_sse)
            _x86_cabi_sse = _x86_cabi_sse + 1
            _x86_store_tag_imm(rm, pid, 1)   // TAG_FLOAT
            if _x86_is_spilled(rm, pid) {
                // movq the xmm bits into r11 (disjoint scratch), then spill.
                _x86_buf.push(_x86_instr2("movq", _x86_op_reg("r11"),
                                    _x86_op_reg(sse_reg), "cabi fp ingress: xmm→gp"))
                _x86_store_spill(rm, pid, "r11")
            } else {
                let dst_name = _x86_reg_lookup(rm, pid)
                _x86_buf.push(_x86_instr2("movq", _x86_op_reg(dst_name),
                                    _x86_op_reg(sse_reg), "cabi fp ingress param payload (xmm→gp)"))
            }
        } else if _x86_cabi && _x86_cabi_gp < 6 {
            // Route C C-ABI ingress — param p arrives RAW in ONE SysV INTEGER
            // arg register (rdi,rsi,rdx,rcx,r8,r9), not a {tag,payload} pair.
            // Store TAG_INT(0) into the tag-slot (imm via r11 — disjoint from
            // every arg reg) and the raw word as the payload home, mirroring the
            // pair path's payload handling. (libc-floor leaves have ≤6 params, so
            // the >6 stack case never arises under the whitelist.)
            let pay_reg = _x86_64_arg_reg_seq(_x86_cabi_gp)
            _x86_cabi_gp = _x86_cabi_gp + 1
            _x86_store_tag_imm(rm, pid, 0)
            if _x86_is_spilled(rm, pid) {
                _x86_store_spill(rm, pid, pay_reg)
            } else {
                let dst_name = _x86_reg_lookup(rm, pid)
                if dst_name != pay_reg {
                    _x86_buf.push(_x86_instr2("mov", _x86_op_reg(dst_name),
                                        _x86_op_reg(pay_reg), "cabi ingress param payload"))
                }
            }
        } else if p < 3 {
            let tag_reg = _x86_hv_pair_lo(p)     // tag eightbyte
            let pay_reg = _x86_hv_pair_hi(p)     // payload eightbyte
            // Stash the tag first (it reads a fresh arg reg; storing it into a
            // tag-slot can't disturb the payload reg).
            _x86_store_tag_reg(rm, pid, tag_reg)
            if _x86_is_spilled(rm, pid) {
                _x86_store_spill(rm, pid, pay_reg)
            } else {
                let dst_name = _x86_reg_lookup(rm, pid)
                if dst_name != pay_reg {
                    _x86_buf.push(_x86_instr2("mov", _x86_op_reg(dst_name),
                                        _x86_op_reg(pay_reg), "ingress param payload"))
                }
            }
        } else {
            // Stack param: tag at [rbp,16+(p-3)*16], payload at +8.
            let inoff = 16 + (p - 3) * 16
            _x86_buf.push(_x86_instr2("mov", _x86_op_reg("r10"),
                             _x86_op_mem("rbp", inoff),
                             "ingress stack param " + to_string(p) + " tag"))
            _x86_store_tag_reg(rm, pid, "r10")
            _x86_buf.push(_x86_instr2("mov", _x86_op_reg("r10"),
                             _x86_op_mem("rbp", inoff + 8),
                             "ingress stack param " + to_string(p) + " payload"))
            if _x86_is_spilled(rm, pid) {
                _x86_store_spill(rm, pid, "r10")
            } else {
                let dst_name = _x86_reg_lookup(rm, pid)
                _x86_buf.push(_x86_instr2("mov", _x86_op_reg(dst_name),
                                    _x86_op_reg("r10"), "ingress stack param payload"))
            }
        }
        p = p + 1
    }

    let mut _x86_try_idx_acc = 0
    let mut bi = 0
    while bi < len(mf.blocks) {
        let blk = mf.blocks[bi]
        _x86_buf.push(_x86_instr0("label", _x86_64_block_label(modhash, mf.name, blk.id)))
        let mut si = 0
        while si < len(blk.stmts) {
            // r14 — monotonic jmp_buf slot per try_setjmp (POP reuses its slot)
            let _cur_try = _x86_try_idx_acc
            if blk.stmts[si].kind == "try_setjmp" { _x86_try_idx_acc = _x86_try_idx_acc + 1 }
            _emit_x86_64_stmt(modhash, mf.name,
                                       blk.stmts[si], st, rm, spill_frame,
                                       _try_buf_bytes, _cur_try, opts)
            si = si + 1
        }
        bi = bi + 1
    }

    // Safety epilogue
    if len(_x86_buf) > 0 {
        let last = _x86_buf[len(_x86_buf) - 1]
        if last.op == "ret" {
            return LFunc {
                name: mf.name,
                target: "x86_64-linux-gnu",
                instrs: _x86_buf,
                frame_size: spill_frame,
                callee_saved: [],
                def_line: mf.def_line
            }
        }
    }
    // r15/r25 — fall-through (no explicit return reached): main → tag 0 (so a
    // top-level program exits 0, not stale rax), every other fn → TAG_VOID so
    // a void-returning fn's result reads type_of == "void".
    // ING #29 literal-∅: @naked fn — NO fall-through epilogue either (the body
    // is raw asm that must terminate itself; a stray zero-ret-pair + ret would
    // corrupt the trampoline). DEFAULT false → unchanged on every existing fn.
    if !_x86_is_naked {
        _x86_emit_zero_ret_pair(mf.name == "main")
        _x86_emit_epilogue(spill_frame)
    }

    return LFunc {
        name: mf.name,
        target: "x86_64-linux-gnu",
        instrs: _x86_buf,
        frame_size: spill_frame,
        callee_saved: [],
        def_line: mf.def_line
    }
}

// ── String table collection ─────────────────────────────────
//
// Mirror of arm64_darwin.hexa _build_arm_strtab. Both targets keep
// independent string tables so the per-target codegen does not need
// cross-target imports, but they use the same label scheme
// (".LCstr<N>") so a shared MIR yields stable labels.

fn _x86_collect_strs_from_stmt(st: X86StrTab, s: Stmt) -> X86StrTab {
    let mut out = st
    let mut i = 0
    while i < len(s.args) {
        let o = s.args[i]
        if o.kind == "const_str" {
            if len(_x86_strtab_lookup(out, o.str_val)) == 0 {
                let mut keys = out.keys
                let mut labs = out.labels
                let n = len(keys)
                keys.push(o.str_val)
                labs.push(".LCstr" + to_string(n))
                out = X86StrTab { keys: keys, labels: labs }
            }
        }
        i = i + 1
    }
    return out
}

fn _build_x86_strtab(module: MModule) -> X86StrTab {
    let mut st = X86StrTab { keys: [], labels: [] }
    let mut fi = 0
    while fi < len(module.funcs) {
        let f = module.funcs[fi]
        let mut bi = 0
        while bi < len(f.blocks) {
            let blk = f.blocks[bi]
            let mut si = 0
            while si < len(blk.stmts) {
                st = _x86_collect_strs_from_stmt(st, blk.stmts[si])
                si = si + 1
            }
            bi = bi + 1
        }
        fi = fi + 1
    }
    return st
}

fn _x86_hex_nibble(n: i64) -> string {
    if n == 0  { return "0" }
    if n == 1  { return "1" }
    if n == 2  { return "2" }
    if n == 3  { return "3" }
    if n == 4  { return "4" }
    if n == 5  { return "5" }
    if n == 6  { return "6" }
    if n == 7  { return "7" }
    if n == 8  { return "8" }
    if n == 9  { return "9" }
    if n == 10 { return "a" }
    if n == 11 { return "b" }
    if n == 12 { return "c" }
    if n == 13 { return "d" }
    if n == 14 { return "e" }
    return "f"
}

fn _x86_byte_to_hex(b: i64) -> string {
    let hi = b / 16
    let lo = b - hi * 16
    return _x86_hex_nibble(hi) + _x86_hex_nibble(lo)
}

// ── RFC061 §M8 named-rodata-table (literal-∅ feature C — exp/log table data) ──
// Convert a 16-hex-digit BIG-ENDIAN uint64 token (the form musl's exp_data.c /
// log_data.c ships, e.g. "3ff0000000000000") into a 16-hex-digit LITTLE-ENDIAN
// byte string ("000000000000f03f") suitable for the LSection `.byte` payload —
// i.e. the exact 8 bytes a `.quad 0x3ff0000000000000` would assemble to on a
// little-endian x86_64 target. Pure char-pair reversal (no integer parse — the
// frozen-built compiler has no 64-bit hex-string→i64 path; byte-reversal of the
// hex text is value-faithful and stage0-portable). Tokens shorter than 16 hex
// digits are LEFT-zero-padded first (a uint64 with leading-zero nibbles).
fn _x86_u64hex_to_le_hex(tok: string) -> string {
    let cs = tok.chars()
    let n = len(cs)
    // left-pad to 16 hex digits
    let mut padded = ""
    let mut p = n
    while p < 16 {
        padded = padded + "0"
        p = p + 1
    }
    let mut k = 0
    while k < n {
        padded = padded + cs[k]
        k = k + 1
    }
    // reverse byte-pairs: bytes are at [0,1][2,3]…[14,15]; LE order is
    // [14,15][12,13]…[0,1].
    let pc = padded.chars()
    let mut out = ""
    let mut bi = 7
    while bi >= 0 {
        out = out + pc[bi * 2] + pc[bi * 2 + 1]
        bi = bi - 1
    }
    return out
}

// Encode a whitespace-separated list of BIG-ENDIAN uint64 hex tokens into the
// concatenated LITTLE-ENDIAN byte-hex payload for one rodata table. Each token
// becomes 8 LE bytes (16 hex chars). Whitespace / commas separate tokens.
fn _x86_u64hex_list_to_le_payload(spec: string) -> string {
    let cs = spec.chars()
    let n = len(cs)
    let mut out = ""
    let mut tok = ""
    let mut i = 0
    while i < n {
        let c = cs[i]
        if c == " " || c == "\n" || c == "\t" || c == "," || c == "\r" {
            if len(tok) > 0 {
                out = out + _x86_u64hex_to_le_hex(tok)
                tok = ""
            }
        } else {
            tok = tok + c
        }
        i = i + 1
    }
    if len(tok) > 0 {
        out = out + _x86_u64hex_to_le_hex(tok)
    }
    return out
}

fn _x86_ascii_code(ch: string) -> i64 {
    if ch == " " { return 32 }
    if ch == "!" { return 33 }
    if ch == "\"" { return 34 }
    if ch == "#" { return 35 }
    if ch == "$" { return 36 }
    if ch == "%" { return 37 }
    if ch == "&" { return 38 }
    if ch == "'" { return 39 }
    if ch == "(" { return 40 }
    if ch == ")" { return 41 }
    if ch == "*" { return 42 }
    if ch == "+" { return 43 }
    if ch == "," { return 44 }
    if ch == "-" { return 45 }
    if ch == "." { return 46 }
    if ch == "/" { return 47 }
    if ch == "0" { return 48 }
    if ch == "1" { return 49 }
    if ch == "2" { return 50 }
    if ch == "3" { return 51 }
    if ch == "4" { return 52 }
    if ch == "5" { return 53 }
    if ch == "6" { return 54 }
    if ch == "7" { return 55 }
    if ch == "8" { return 56 }
    if ch == "9" { return 57 }
    if ch == ":" { return 58 }
    if ch == ";" { return 59 }
    if ch == "<" { return 60 }
    if ch == "=" { return 61 }
    if ch == ">" { return 62 }
    if ch == "?" { return 63 }
    if ch == "@" { return 64 }
    if ch == "A" { return 65 }
    if ch == "B" { return 66 }
    if ch == "C" { return 67 }
    if ch == "D" { return 68 }
    if ch == "E" { return 69 }
    if ch == "F" { return 70 }
    if ch == "G" { return 71 }
    if ch == "H" { return 72 }
    if ch == "I" { return 73 }
    if ch == "J" { return 74 }
    if ch == "K" { return 75 }
    if ch == "L" { return 76 }
    if ch == "M" { return 77 }
    if ch == "N" { return 78 }
    if ch == "O" { return 79 }
    if ch == "P" { return 80 }
    if ch == "Q" { return 81 }
    if ch == "R" { return 82 }
    if ch == "S" { return 83 }
    if ch == "T" { return 84 }
    if ch == "U" { return 85 }
    if ch == "V" { return 86 }
    if ch == "W" { return 87 }
    if ch == "X" { return 88 }
    if ch == "Y" { return 89 }
    if ch == "Z" { return 90 }
    if ch == "[" { return 91 }
    if ch == "\\" { return 92 }
    if ch == "]" { return 93 }
    if ch == "^" { return 94 }
    if ch == "_" { return 95 }
    if ch == "`" { return 96 }
    if ch == "a" { return 97 }
    if ch == "b" { return 98 }
    if ch == "c" { return 99 }
    if ch == "d" { return 100 }
    if ch == "e" { return 101 }
    if ch == "f" { return 102 }
    if ch == "g" { return 103 }
    if ch == "h" { return 104 }
    if ch == "i" { return 105 }
    if ch == "j" { return 106 }
    if ch == "k" { return 107 }
    if ch == "l" { return 108 }
    if ch == "m" { return 109 }
    if ch == "n" { return 110 }
    if ch == "o" { return 111 }
    if ch == "p" { return 112 }
    if ch == "q" { return 113 }
    if ch == "r" { return 114 }
    if ch == "s" { return 115 }
    if ch == "t" { return 116 }
    if ch == "u" { return 117 }
    if ch == "v" { return 118 }
    if ch == "w" { return 119 }
    if ch == "x" { return 120 }
    if ch == "y" { return 121 }
    if ch == "z" { return 122 }
    if ch == "{" { return 123 }
    if ch == "|" { return 124 }
    if ch == "}" { return 125 }
    if ch == "~" { return 126 }
    if ch == "\n" { return 10 }
    if ch == "\t" { return 9 }
    return 63
}

fn _x86_str_to_hex_bytes(s: string) -> string {
    // r22 — UTF-8-preserving rodata bytes (direct port of arm64_darwin.hexa
    // _str_to_hex_bytes Cycle-39 fix). The prior s.chars() + _x86_ascii_code
    // path mapped every non-ASCII byte (>= 0x80 = a UTF-8 continuation byte)
    // to ? (63) via the ASCII-only lookup's `return 63` fallthrough — so a
    // string literal with a multibyte char emitted 0x3f instead of the real
    // bytes (the dominant r20/r21 silent-differ once the global-param-clobber
    // was fixed). s.bytes() returns per-byte i64 entries (raw 0..255),
    // preserving every UTF-8 byte verbatim.
    let bs = s.bytes()
    let mut out = ""
    let mut i = 0
    while i < len(bs) {
        out = out + _x86_byte_to_hex(bs[i])
        i = i + 1
    }
    out = out + "00"
    return out
}

fn _x86_strtab_to_rodata(st: X86StrTab) -> [LSection] {
    let mut out: [LSection] = []
    let mut i = 0
    while i < len(st.keys) {
        out.push(LSection {
            name: st.labels[i],
            bytes: _x86_str_to_hex_bytes(st.keys[i]),
            align: 0
        })
        i = i + 1
    }
    return out
}

// ── Module entry point ───────────────────────────────────────

// RFC 070 G7-A.native impl — Shape B sub-cycle 2026-05-20:
// entry signature now carries `opts: CodegenOptions` (lifted to
// compiler/ir/lir.hexa by the B1 iface commit). All callers updated to
// pass `codegen_options_default()` in this cycle — they all behave
// exactly as before (opts.shared == 0, opts.target_triple == ""), so
// the emit body is byte-identical to the pre-iface output. The actual
// `if opts.shared` GOT-load + `.hidden` emit-body branches are the
// NEXT sub-cycle (G7-A.native impl emit). This commit is the signature
// lift only — measurable falsifier: corpus byte-eq with the default
// `opts` argument (any diff would mean an accidental capture of
// `opts.shared` somewhere in the body).
pub fn codegen_x86_64_linux(module: MModule, opts: CodegenOptions) -> LModule {
    let st = _build_x86_strtab(module)
    // Stage1 C8 — modhash from MModule.file disambiguates spliced
    // modules so block labels never collide across re-imported libs.
    let modhash = _x86_64_modhash(module.file)
    // Wall 3-c: reset the __hx_static_slot accumulator for THIS module before
    // lowering (it is module-scope mutable, so a prior module's slots must not
    // leak). On the byteeq path no body calls __hx_static_slot → stays [].
    _x86_static_slots = []
    // §M8 feature C: reset the named-rodata-table accumulator for THIS module too
    // (module-scope mutable; prior-module tables must not leak). Stays [] on the
    // byteeq path → rodata unchanged → byte-eq NEUTRAL.
    _x86_rodata_tabs = []
    let mut funcs = []
    let mut i = 0
    while i < len(module.funcs) {
        funcs.push(_x86_64_lower_func(module.funcs[i], st, modhash, opts))
        i = i + 1
    }
    // RT-NATIVE M5-gslot (2026-06-18): register module-global slot labels so
    // emit_asm emits a `.data` slot (`g<id>: .quad 0 .quad 0`) for each. The
    // codegen already REFERENCES module-globals as `g<id>` (_x86_op_resolve),
    // but this list was left `[]` — so a standalone single-module emit produced
    // `g<id>` references with no defining slot → link "undefined reference to g0"
    // (the gap that blocked the alloc+syscall b2 gate). arm64_darwin already does
    // this (gnames); x86_64 is ELF, so the labels are bare `g<id>` (no `_`).
    let mut gnames: [string] = []
    let mut gi = 0
    while gi < len(module.globals) {
        gnames.push("g" + to_string(module.globals[gi].id))
        gi = gi + 1
    }
    // Wall 3-c: append the self-static-slot labels (`slot_<id>__sz<N>`) so emit/asm
    // defines a `.zero N`-sized `.data` symbol for each. Empty on the byteeq path.
    let mut si = 0
    while si < len(_x86_static_slots) {
        gnames.push(_x86_static_slots[si])
        si = si + 1
    }
    // §M8 feature C: build the rodata list = string-table sections PLUS one
    // `.rodata` LSection per referenced named table (`rotab_<id>`), aligned 8
    // (.p2align 3) with the LE-double payload. Empty `_x86_rodata_tabs` on the
    // byteeq path → identical to the bare `_x86_strtab_to_rodata(st)` → byte-eq
    // NEUTRAL.
    let mut rodata_secs = _x86_strtab_to_rodata(st)
    let mut ti = 0
    while ti < len(_x86_rodata_tabs) {
        let tid = _x86_rodata_tabs[ti]
        let payload = _x86_u64hex_list_to_le_payload(_x86_rodata_table_spec(tid))
        rodata_secs.push(LSection {
            name: "rotab_" + to_string(tid),
            bytes: payload,
            align: 3
        })
        ti = ti + 1
    }
    return LModule {
        file: module.file,
        target: "x86_64-linux-gnu",
        funcs: funcs,
        rodata: rodata_secs,
        bss: [],
        globals: gnames,
        floats: []
    }
}
