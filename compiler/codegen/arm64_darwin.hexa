        // remainder (__hx_payload_mod → sdiv + msub: rem = a - (a/b)*b). Result
        // int HexaVal {TAG_INT, …}, INLINE. Separate block from add/sub/mul so
        // that 3-op family stays untouched (byte-eq). Divide-by-zero is the C
        // wrapper's job (zero-throw = runtime re-entry); the leaf assumes b != 0,
        // exactly like the C `/`/`%` it mirrors. The aarch64 sdiv is round-toward-
        // zero (truncating), matching C int64 `/`. x4 = free scratch (a→x0:x1,
        // b→x2:x3 from the loads).
        if (s.op == "__hx_payload_div" || s.op == "__hx_payload_mod")
            && len(s.args) >= 2 {
            buf = _hv_load(buf, s.args[0], st, rm, "x0", "x1")  // a → x1=payload
            buf = _hv_load(buf, s.args[1], st, rm, "x2", "x3")  // b → x3=payload
            if s.op == "__hx_payload_div" {
                buf.push(_arm64_instr3("sdiv", _arm64_op_reg("x1"),
                                 _arm64_op_reg("x1"), _arm64_op_reg("x3"),
                                 s.op + ": x1 = a.pl / b.pl (trunc)"))
            } else {
