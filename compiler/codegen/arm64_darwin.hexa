            || s.op == "__hx_payload_le" || s.op == "__hx_payload_ge"
            || s.op == "__hx_payload_eq" || s.op == "__hx_payload_ne"
            || s.op == "__hx_payload_ult" || s.op == "__hx_payload_ule") && len(s.args) >= 2 {
            let mut _pcond = "lt"
            if s.op == "__hx_payload_gt" { _pcond = "gt" }
            if s.op == "__hx_payload_le" { _pcond = "le" }
            if s.op == "__hx_payload_ge" { _pcond = "ge" }
            if s.op == "__hx_payload_eq" { _pcond = "eq" }
            if s.op == "__hx_payload_ne" { _pcond = "ne" }
            if s.op == "__hx_payload_ult" { _pcond = "lo" }  // unsigned <  (C clear)
            if s.op == "__hx_payload_ule" { _pcond = "ls" }  // unsigned <= (C clear|Z set)
            buf = _hv_load(buf, s.args[0], st, rm, "x0", "x1")  // a → x1=payload
            buf = _hv_load(buf, s.args[1], st, rm, "x2", "x3")  // b → x3=payload
            buf.push(_arm64_instr2("cmp", _arm64_op_reg("x1"),
                             _arm64_op_reg("x3"), s.op + ": cmp payloads"))
            buf.push(_arm64_instr2("cset", _arm64_op_reg("x0"),
                             _arm64_op_label(_pcond), s.op + ": x0 = (a.pl " + _pcond + " b.pl)"))
            buf = _emit_bool_box(buf, s.op + ": box bool")
            if s.dst.id >= 0 { buf = _hv_store_dst(buf, rm, s.dst, "x0", "x1") }
            return buf
        }
        // RT-NATIVE UNLOCK-2c: signed-i64 payload arithmetic (__hx_payload_add/
        // sub/mul) → result int HexaVal {TAG_INT, a.pl OP b.pl}, INLINE (add/sub/
        // mul, no `bl _hexa_add`). Unblocks the native dispatch core's int-int
        // arithmetic leaves (hexa_add_slow/sub/mul fast path).
        if (s.op == "__hx_payload_add" || s.op == "__hx_payload_sub"
            || s.op == "__hx_payload_mul" || s.op == "__hx_payload_and"
            || s.op == "__hx_payload_xor" || s.op == "__hx_payload_or") && len(s.args) >= 2 {
            let mut _aop = "add"
            if s.op == "__hx_payload_sub" { _aop = "sub" }
            if s.op == "__hx_payload_mul" { _aop = "mul" }
            if s.op == "__hx_payload_and" { _aop = "and" }
            if s.op == "__hx_payload_xor" { _aop = "eor" }
            if s.op == "__hx_payload_or"  { _aop = "orr" }
