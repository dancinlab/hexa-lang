                buf.push(_arm64_instr2("mov", _arm64_op_reg("x8"),
                                 _arm64_op_reg("x15"), "__hx_syscall6_out2: x8 = syscall num"))
                buf.push(_arm64_instr1("svc", _arm64_op_label("#0"),
                                 "__hx_syscall6_out2: Linux syscall trap"))
