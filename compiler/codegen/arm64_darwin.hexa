            if ncall == 1 { dispatch = "hexa_call1_native" }
            if ncall == 2 { dispatch = "hexa_call2_native" }
            if ncall == 3 { dispatch = "hexa_call3_native" }
            if ncall == 4 { dispatch = "hexa_call4_native" }
            buf.push(_arm64_instr1("bl", _arm64_op_label(dispatch),
