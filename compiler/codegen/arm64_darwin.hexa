        // libc `extern char **environ` global, loaded through the GOT and boxed as a
        // TAG_INT payload. The arm64 named-data GOT load is the same `adrp …@GOTPAGE`
        // + `ldr …@GOTPAGEOFF` pair the `--shared` global path emits (asm-text
        // identical on Mach-O ARM64_RELOC_GOT_LOAD_* and ELF R_AARCH64_*_GOT_*), here
        // keyed to the named libc symbol `environ` (→ `_environ` on darwin via the
        // unconditional `_` mangle in emit/asm _fmt_label). x1 = &environ (char***),
        // x0 = TAG_INT; one __hx_ptr_load64 in the caller yields the char** array
        // base. No args; just load + box (mirror of __hx_syscall6's tail box).
        if s.op == "__hx_environ_ptr" {
            buf.push(_arm64_instr2("adrp", _arm64_op_reg("x1"),
                             _arm64_op_label("environ@GOTPAGE"),
                             "__hx_environ_ptr: &environ GOT page [reloc=" + RELOC_AARCH64_ADR_GOT_PAGE + "]"))
            buf.push(_arm64_instr2("ldr", _arm64_op_reg("x1"),
                             _arm64_op_mem_label("x1", "environ@GOTPAGEOFF"),
                             "__hx_environ_ptr: x1 = &environ [reloc=" + RELOC_AARCH64_LD64_GOT_LO12_NC + "]"))
            buf.push(_arm64_instr2("movz", _arm64_op_reg("x0"),
                             _arm64_op_label("#0"), "__hx_environ_ptr: TAG_INT"))
            if s.dst.id >= 0 { buf = _hv_store_dst(buf, rm, s.dst, "x0", "x1") }
            return buf
