            // old `bl hexa_truthy` was the lone reason the valop-core native
            // seed SIGSEGV'd in the arm64 self-host value-op hot path (6× bl
            // per func vs x86_64's 0); removing the call closes that gap.
            buf = _hv_load(buf, s.args[0], st, rm, "x0", "x1")
            let else_lab = _arm64_block_label(modhash, fname, s.target_block_else)
            buf.push(_arm64_instr2("cbz", _arm64_op_reg("x1"),
                             _arm64_op_label(else_lab), "br_cond: !payload -> else"))
        }
        let then_lab = _arm64_block_label(modhash, fname, s.target_block)
        buf.push(_arm64_instr1("b", _arm64_op_label(then_lab), "branch -> then"))
        return buf
    }
    if s.kind == _STMT_UNOP {
        // Unary minus / boolean negation — previously unhandled (asm
        // emitted `nop ; unhandled stmt kind unop`), so `let x = -1`
        // left x's slot uninitialized and `if x<=0` mis-branched.
        // hexa runtime has no `hexa_neg` shim → lower `-x` as
        // `0 - x` through hexa_sub; `!x` / `not x` mirror the `!=`
        // pattern: truthy → eor 1 → box bool.
        if len(s.args) >= 1 {
            if s.op == "-" || s.op == "neg" {
                buf.push(_arm64_instr2("movz", _arm64_op_reg("x0"),
                                 _arm64_op_label("#0"), "unop -: a.tag=TAG_INT"))
                buf.push(_arm64_instr2("movz", _arm64_op_reg("x1"),
                                 _arm64_op_label("#0"), "unop -: a.val=0"))
                buf = _hv_load(buf, s.args[0], st, rm, "x2", "x3")
                buf.push(_arm64_instr1("bl", _arm64_op_label("hexa_sub"),
                                 "unop -: 0 - x"))
                buf = _hv_store_dst(buf, rm, s.dst, "x0", "x1")
                return buf
            }
            if s.op == "!" || s.op == "not" {
                buf = _hv_load(buf, s.args[0], st, rm, "x0", "x1")
                buf.push(_arm64_instr1("bl", _arm64_op_label("hexa_truthy"),
                                 "unop !: truthy → w0"))
                buf.push(_arm64_instr3("eor", _arm64_op_reg("x0"),
                                 _arm64_op_reg("x0"), _arm64_op_label("#1"),
                                 "unop !: !truthy"))
                buf = _emit_bool_box(buf, "unop !: box bool")
                buf = _hv_store_dst(buf, rm, s.dst, "x0", "x1")
                return buf
            }
            // Unknown unop — pass value through (closer to no-op than
            // an uninitialized slot, and surfaces visibly in output).
            buf = _hv_load(buf, s.args[0], st, rm, "x0", "x1")
            buf = _hv_store_dst(buf, rm, s.dst, "x0", "x1")
        }
        return buf
    }
    if s.kind == "load" {
        if len(s.args) >= 1 {
            buf = _arm64_op_rm(buf, s.args[0], st, rm, "x10", opts)
            let base_op = _arm64_op_resolve(s.args[0], st, rm, "x10")
            let mut off = 0
            if len(s.args) >= 2 && s.args[1].kind == "const_int" {
                off = s.args[1].int_val
            }
            let dst = _arm64_op_reg(_arm64_dst_reg(rm, s.dst.id))
            buf.push(_arm64_instr2("ldr", dst, _arm64_op_mem(base_op.reg.name, off),
                             "load"))
            buf = _arm64_emit_dst_writeback(buf, rm, s.dst.id)
        }
        return buf
    }
    if s.kind == "store" {
        if len(s.args) >= 2 {
            buf = _arm64_op_rm(buf, s.args[0], st, rm, "x10", opts)
            buf = _arm64_op_rm(buf, s.args[1], st, rm, "x11", opts)
            let base_op = _arm64_op_resolve(s.args[0], st, rm, "x10")
            let src = _arm64_op_resolve(s.args[1], st, rm, "x11")
            let mut off = 0
            if len(s.args) >= 3 && s.args[2].kind == "const_int" {
                off = s.args[2].int_val
            }
            buf.push(_arm64_instr2("str", src, _arm64_op_mem(base_op.reg.name, off),
                             "store"))
        }
        return buf
    }
    buf.push(_arm64_instr0("nop", "unhandled stmt kind " + s.kind))
    return buf
}

// ── Function lowering ────────────────────────────────────────

// SELFHOST-NEXT linux-arm64: `cg_target` selects the AArch64 *platform*
// (Mach-O "arm64-apple-darwin" vs ELF "arm64-linux-gnu"). The instruction
// lowering below is target-shared — `cg_target` only flows into the LFunc/
// LModule `target` field so the downstream emit pass picks ELF sections +
// bare labels (see compiler/emit/asm.hexa _is_elf_arm64). Default callers
// pass "arm64-apple-darwin" → byte-identical Mach-O output.
fn _arm64_lower_func(mf: MFunc, st: ArmStrTab, modhash: string, cg_target: string) -> LFunc {
    // Cycle 56 recovery: opts not threaded through _arm64_lower_func
    // signature (would require touching codegen_arm64_darwin caller
    // + every other call). Use codegen_options_default() locally —
    // matches the RFC 070 G7-A.native intent (all callers pass the
    // zero-seed default until the actual GOT-load body lands).
    //
    // RT-NATIVE measure-8: the OS/arch-specific syscall ABI emit in
    // _emit_arm64_stmt (__hx_target_os/__hx_syscall0/6) keys off
    // opts.target_triple, but the local default leaves it "". Stamp it from
    // cg_target (the ELF-vs-Mach-O selector already threaded here) so the
    // arm64-linux-gnu seed gets the Linux trap (svc #0 / x8 / os=0) instead
    // of the XNU default (#3597 root-cause). Non-arm64-linux callers pass
    // cg_target == "" (or darwin), so target_triple stays "" → darwin emit
    // is byte-identical.
    let opts = CodegenOptions { shared: 0, target_triple: cg_target }
    let mut instrs = []

    // #26 self-host fixpoint — forced-copy the MFunc identity fields up
    // front, before the block-emit loop. `mf.name` / `mf.def_line` are
    // read repeatedly (block-def label, every per-stmt `_emit_arm64_stmt`
    // call, the final LFunc literal). Each `_emit_arm64_stmt` returns a
    // TAG_ARRAY routed through `__hexa_fn_arena_return` → the fn-arena
    // rewinds; an arena-resident `mf` map's string storage is then
    // invalidated, so a *later* `mf.name` read returns TAG_VOID and
    // `mf.blocks` / `mf.def_line` become map-misses. Self-compiled ap2
    // showed exactly this: first block label correct (`__L…_main_bb0`)
    // but `.globl void` + "map key 'name'/'blocks'/'def_line' not found".
    // Snapshotting once (string via the F6 forced-copy substring idiom,
    // see _arm64_strtab_lookup P0b / _collect_strs P0a / _lower_fn P0c-2)
    // gives every downstream read an arena-independent handle. ap1 (heap,
    // single-read paths) is byte-identical; only the repeated cross-
    // arena-boundary reads in this fn change source.
    let fn_name = mf.name.substring(0, len(mf.name))
    let fn_def_line = mf.def_line

    // C6 — run linear-scan regalloc up front so the prologue can size
    // the spill frame and the body can resolve operands through the
    // assigned RegMap.
    let alloc = _arm64_assign_regs(mf)
    let spill_frame = alloc.frame_size

    // C7 — pre-allocate the maximum outgoing-call overflow region in
    // bytes (16-aligned). Reused by every call site in this fn so we
    // don't sub/add sp mid-frame. SSA spill offsets are shifted above
    // this region via rm.call_overflow_bytes (see _arm_spill_offset).
    //
    // #27 self-host fixpoint — STRIDE FIX. `max_overflow` is a count of
    // overflow ARGS (n - 4, see _arm64_max_call_overflow). Each overflow
    // arg is a 16-byte HexaVal occupying a full register PAIR, and the
    // C7 call-site emit writes arg i at `[sp, #(i-4)*16]` (16-byte
    // stride, see "C7: stack arg" below). The reserved region must
    // therefore be `max_overflow * 16` bytes. The previous `* 8` sized
    // it for an 8-byte scalar stride — exactly HALF — so the SSA/param
    // spill region was shifted up by only half the overflow span. A
    // saved ingress param (e.g. `module` at [sp,#16] in
    // _collect_item_types) then aliased the outgoing "stack arg 5" slot
    // (`(5-4)*16 = 16`): the call's 6th arg overwrote the caller's own
    // first parameter HexaVal (tag flipped MAP→STR), surfacing as
    // `map key 'items'/'children'/... not found` + a 1032-wide spurious
    // HX2001 cascade when the self-hosted compiler (ap2) compiled the
    // full compiler. ap1 (hexat C path) computes frames correctly so
    // the bug was masked until the asm codegen self-hosted. Same value-
    // across-call-boundary class as #25/#26, distinct site (frame sizer,
    // not arena runtime). 16-aligned already (max_overflow*16 is a
    // multiple of 16); the round kept for defensive clarity.
    let max_overflow = _arm64_max_call_overflow(mf)
    let mut call_overflow_bytes = 0
    if max_overflow > 0 {
        call_overflow_bytes = ((max_overflow * 16 + 15) / 16) * 16
    }
    let rm = RegMap {
        ids: alloc.map.ids,
        regs: alloc.map.regs,
        slots: alloc.map.slots,
        call_overflow_bytes: call_overflow_bytes,
        // #3712 (arm64 port) — forward the O(1) id→index array built in
        // _arm64_assign_regs so the per-operand emit lookups probe it.
        id2idx: alloc.map.id2idx,
        // FLEET arm64 element-pack — forward the esc lattice built in
        // _arm64_assign_regs (both `[]` when HEXA_PACK_ESCAPING is OFF → emit
        // boundaries never consult them → byte-identical to origin).
        local_type: alloc.map.local_type,
        local_packed_esc_ok: alloc.map.local_packed_esc_ok
    }
    // RFC061 §M8 varargs-ABI (r2) — reserve the AAPCS64 va register-save block for a
    // variadic fn (LINUX: 224 = 64 GP + 128 FP save + 32 va_list; DARWIN: 0, stack-
    // passed). Wedged BETWEEN the regalloc spill slots (sp+[call_overflow, +spill_frame))
    // and the try jmp_bufs — the SAME wedge x86_64 uses. `_va_block` is threaded through
    // the same `_arm64_va_block_bytes(fname, is_linux)` SSOT the va builtins use, so the
    // prologue spill, the va_start/va_arg layout, and the try-slot base agree. NON-
    // variadic (default, HEXA_VA_INTRINSICS unset) → 0 → byte-eq NEUTRAL.
    let _va_is_linux_pro = opts.target_triple == "arm64-linux-gnu"
    let _va_block = _arm64_va_block_bytes(fn_name, _va_is_linux_pro)
    let _va_base_pro = call_overflow_bytes + spill_frame
    // Module-level flag consulted by the _STMT_RETURN path (variadic SIMD return → d0).
    // Set for EVERY fn (true only for a whitelisted variadic under HEXA_VA_INTRINSICS=1);
    // default false → byte-eq NEUTRAL.
    _arm64_va_active = _arm64_is_variadic(fn_name)
    // ING #29 literal-∅ (2026-06-30): @naked — propagate MFunc.is_naked to the
    // per-fn global so the prologue/epilogue guards read it. Reset every fn.
    _arm64_is_naked = mf.is_naked
    // Cycle h20 — reserve jmp_buf region above the spill area (now above the va block).
    // Each try gets one 192-byte slot (16-aligned by construction).
    let try_count = _arm64_count_try_setjmp(mf)
    let try_buf_bytes = try_count * _ARM64_JMP_BUF_BYTES
    let total_frame = spill_frame + call_overflow_bytes + _va_block + try_buf_bytes

    // Prologue
    // ING #29 literal-∅ (2026-06-30): @naked SKIPS prologue+epilogue (the body
    // is raw asm; reference-match GCC __attribute__((naked)) / rustc #[naked]).
    // arm64 scope: rt_sigreturn measurement is x86_64-only (arm64 kernel
    // supplies the signal trampoline), so this guard keeps arm64 codegen
    // correct for a @naked fn but is not exercised by the rt_sigreturn probe.
    // DEFAULT false on every existing fn → byte-eq NEUTRAL.
    if !_arm64_is_naked {
    instrs.push(_arm64_instr3(
        "stp",
        _arm64_op_reg("x29"),
        _arm64_op_reg("x30"),
        _arm64_op_label("[sp, #-16]!"),
        "prologue: save fp/lr"
    ))
    instrs.push(_arm64_instr2("mov", _arm64_op_reg("x29"), _arm64_op_reg("sp"), "prologue: set fp"))

    // Entry argv wiring. `_main` is the C-ABI process entry (Darwin
    // `_start` → `main(argc, argv, envp)`): x0=argc, x1=argv on entry.
    // The hexa `fn main()` takes no params, so x0/x1 are otherwise
    // unused — but `args()` / `hexa_args()` need them stashed. hexat's
    // C path emits `int main(argc,argv){ hexa_set_args(argc,argv); … }`;
    // the direct-asm path must do the same or every aprime_cc-built
    // program sees an empty argv (self-host blocker — the 2nd-gen
    // compiler reported "missing SOURCE.hexa" for every invocation).
    // Insert `bl _hexa_set_args` here, before the frame `sub` and any
    // body code clobbers x0/x1. stp/mov above do not touch x0/x1; bl's
    // x30 clobber is safe (lr already saved, dead until epilogue).
    if fn_name == "main" {
        instrs.push(_arm64_instr1("bl", _arm64_op_label("hexa_set_args"),
                         "entry: wire argc/argv -> hexa_set_args"))
    }

    // Spill-frame allocation (after fp/lr save). Covers both the SSA
    // spill region (top), the va register-save block (middle, variadic only), and
    // the outgoing-call overflow region (bottom).
    if total_frame > 0 {
        instrs = _hv_sp_adj(instrs, "sub", total_frame, "x15")
    }

    // RFC061 §M8 varargs-ABI (r2) — LINUX/AAPCS64 register save. A variadic fn must
    // spill the 8 GP arg regs (x0..x7) into the 64-byte GP save area and the 8 FP arg
    // regs (q0..q7, low eightbyte) into the 128-byte FP save area BEFORE param ingress
    // below clobbers x0..x7. Layout (sp-relative, after the `sub`): GP_i @ va_base+8*i,
    // FP_i @ va_base+64+16*i, where va_base = call_overflow_bytes + spill_frame (the
    // wedge just above the SSA spill). Reference-match: AAPCS64 §B.4 register save areas
    // — GP 64 bytes + FP 128 bytes, va_arg reads them back via __gr_top/__vr_top. DARWIN
    // skips this entirely (_va_block == 0: varargs are stack-passed). NON-variadic →
    // _va_block 0 → this loop never runs → byte-eq NEUTRAL. (A stacked `double` vararg
    // is read back with an 8-byte load, so spilling the low eightbyte of qN via `str dN`
    // is value-faithful for the double/float class — the high eightbyte is never read.)
    if _va_block > 0 {
        let mut _vg = 0
        while _vg < 8 {
            let _go = _va_base_pro + 8 * _vg
            instrs = _hv_at(instrs, _go, "x15")
            instrs.push(_arm64_instr2("str", _arm64_op_reg("x" + to_string(_vg)),
                             _hv_memb(_go, "x15"),
                             "va prologue: spill GP arg reg x" + to_string(_vg)))
            _vg = _vg + 1
        }
        let mut _vf = 0
        while _vf < 8 {
            let _fo = _va_base_pro + 64 + 16 * _vf
            instrs = _hv_at(instrs, _fo, "x15")
            instrs.push(_arm64_instr2("str", _arm64_op_reg("d" + to_string(_vf)),
                             _hv_memb(_fo, "x15"),
                             "va prologue: spill FP arg reg d" + to_string(_vf)))
            _vf = _vf + 1
        }
    }
    } // end `if !_arm64_is_naked` (prologue) — ING #29 @naked skips frame setup

    // Path A (A′): each 16B HexaVal param arrives in a register PAIR
    // (param0→x0:x1, param1→x2:x3, param2→x4:x5, param3→x6:x7); params
    // ≥4 arrive in caller 16B stack slots above the saved fp/lr at
    // [x29, #16 + (p-4)*16]. Store each into the param's 16B frame slot
    // (all params are force-spilled). x29 set to old sp before the
    // frame `sub`, so [x29,#16+…] reaches the caller's outgoing area.
    let mut p = 0
    // arm64 fp-ABI (AAPCS64 v0-v7) is the NEXT rung — exclude fp symbols so a
    // double leaf is NOT mis-lowered into GP x0/x1 here (it falls through to the
    // PAIR-MODEL path). x86_64 (PSABI §3.2.3 xmm) lands first.
    //
    // RFC061 §M8 r2 — a VARIADIC fn is ALSO C-ABI for its NAMED params (they arrive
    // RAW in one AAPCS64 GP register, NOT a {tag,payload} pair): mirrors x86_64's
    // `_x86_cabi = _is_cabi(name) || _x86_va_active`. Without this fold the named `n`
    // of `hxlcl_va_smoke(long n, ...)` was mis-ingested as a HexaVal PAIR {x0,x1},
    // stealing the first vararg out of x1 → loop bound garbage. The r2 whitelist has
    // only integer-class named params, so the GP single-reg ingress is exact. Gated by
    // _arm64_va_active (default-OFF) ⇒ byte-eq NEUTRAL.
    let _arm_cabi = (_is_cabi(fn_name) && !_cabi_is_fp(fn_name)) || _arm64_va_active
    while p < len(mf.params) {
        let pid = mf.params[p].id
        let poff = _arm_spill_offset(rm, pid)
        if _arm_cabi && p < 8 {
            // Route C C-ABI ingress — param p arrives RAW in ONE AAPCS64 arg
            // register (x0..x7), not an x_2p:x_2p+1 {tag,payload} pair. Store
            // {TAG_INT(0), raw word} into the param's 16B frame slot (x9 = 0 tag
            // scratch; x9 is not an arg reg, so the incoming x0..x7 are intact).
            // libc-floor leaves have ≤8 params → no caller-stack case.
            let preg = _arm64_arg_reg(p)
            instrs.push(_arm64_instr2("movz", _arm64_op_reg("x9"),
                             _arm64_op_label("#0"), "cabi ingress tag = TAG_INT"))
            instrs = _hv_at(instrs, poff, "x15")
            instrs.push(_arm64_instr3("stp", _arm64_op_reg("x9"),
                             _arm64_op_reg(preg), _hv_memb(poff, "x15"),
                             "cabi ingress param " + to_string(p)))
        } else if p < 4 {
            let lo = "x" + to_string(p * 2)
            let hi = "x" + to_string(p * 2 + 1)
            instrs = _hv_at(instrs, poff, "x15")
            instrs.push(_arm64_instr3("stp", _arm64_op_reg(lo),
                             _arm64_op_reg(hi), _hv_memb(poff, "x15"),
                             "ingress param " + to_string(p)))
        } else {
            let inoff = 16 + (p - 4) * 16
            instrs.push(_arm64_instr3("ldp", _arm64_op_reg("x9"),
                             _arm64_op_reg("x10"),
                             _arm64_op_label("[x29, #" + to_string(inoff) + "]"),
                             "ingress stack param " + to_string(p)))
            instrs = _hv_at(instrs, poff, "x15")
            instrs.push(_arm64_instr3("stp", _arm64_op_reg("x9"),
                             _arm64_op_reg("x10"), _hv_memb(poff, "x15"),
                             "store stack param " + to_string(p)))
        }
        p = p + 1
    }

    // #26 — snapshot the block list once. `mf.blocks` is otherwise
    // re-read every loop trip across the `_emit_arm64_stmt` arena-return
    // boundary (same hazard as fn_name/fn_def_line above): an arena-
    // resident `mf` map invalidated by the rewind makes `mf.blocks` a
    // map-miss (len 0) after the first statement, truncating the body.
    let mf_blocks = mf.blocks
    let mut _try_idx = 0
    let mut bi = 0
    while bi < len(mf_blocks) {
        let blk = mf_blocks[bi]
        instrs.push(_arm64_instr0("label", _arm64_block_label(modhash, fn_name, blk.id)))
        let mut si = 0
        while si < len(blk.stmts) {
            // #18 codegen-perf — per-statement delta accumulation. The
            // prior `instrs = _emit_arm64_stmt(instrs,…)` re-returned the
            // whole growing `instrs` array every statement; the runtime's
            // fn-arena return path (__hexa_fn_arena_return → hexa_val_
            // heapify) deep-walks every element of a returned TAG_ARRAY,
            // so threading the accumulator cost Σ O(len instrs) = O(N²)
            // on a large single function. Pass a FRESH `[]` so each call
            // returns only that statement's instructions (~5 elems →
            // O(1) heapify), then append the delta into `instrs`. `instrs`
            // itself is heapified just once, when _arm64_lower_func
            // returns its LFunc — O(total). Byte-identical: same instrs in
            // the same order, only the accumulation cadence changed.
            // Cycle h20: assign monotonic slot indices to STMT_TRY_SETJMP
            // / STMT_TRY_POP pairs so each try has its own jmp_buf slot.
            // STMT_TRY_POP uses the SETJMP's slot, so we don't bump on POP.
            let cur_try_idx = _try_idx
            if blk.stmts[si].kind == "try_setjmp" { _try_idx = _try_idx + 1 }
            let delta = _emit_arm64_stmt([], modhash, fn_name,
                                         blk.stmts[si], st, rm, spill_frame,
                                         try_buf_bytes, cur_try_idx, opts)
            let mut _di = 0
            while _di < len(delta) {
                instrs.push(delta[_di])
                _di = _di + 1
            }
            si = si + 1
        }
        bi = bi + 1
    }

    // Safety epilogue (in case last block lacks _STMT_RETURN)
    let last_is_ret = false
    if len(instrs) > 0 {
        let last = instrs[len(instrs) - 1]
        if last.op == "ret" {
            return LFunc {
                name: fn_name,
                target: cg_target,
                instrs: instrs,
                frame_size: 16 + total_frame,
                callee_saved: [],
                def_line: fn_def_line
            }
        }
    }
    // #40 — fall-through epilogue also hands back a real TAG_VOID HexaVal
    // (x0:x1), matching the value-less STMT_RETURN path above; a function
    // reaching here without an explicit return yields void.
    // ING #29 literal-∅: @naked fn — NO fall-through epilogue (the body is raw
    // asm that must terminate itself). DEFAULT false → unchanged on every fn.
    if !_arm64_is_naked {
    instrs.push(_arm64_instr2("movz", _arm64_op_reg("x0"),
                        _arm64_op_label("#4"), "ret void: TAG_VOID"))
    instrs.push(_arm64_instr2("movz", _arm64_op_reg("x1"),
                        _arm64_op_label("#0"), "ret void: payload 0"))
    if total_frame > 0 {
        instrs = _hv_sp_adj(instrs, "add", total_frame, "x15")
    }
    instrs.push(_arm64_instr3("ldp", _arm64_op_reg("x29"), _arm64_op_reg("x30"),
                        _arm64_op_label("[sp], #16"), "epilogue: restore fp/lr"))
    instrs.push(_arm64_instr0("ret", "return"))
    }

    return LFunc {
        name: fn_name,
        target: cg_target,
        instrs: instrs,
        frame_size: 16 + total_frame,
        callee_saved: [],
        def_line: fn_def_line
    }
}

// ── String table collection (for rodata emission) ────────────
//
// Walk every Stmt in every Block in every Func looking for
// `const_str` operands and record them in an ArmStrTab. Each unique
// literal gets label ".LCstr<N>" (N = insertion order). Both targets
// share this label scheme so rodata labels remain stable per source
// independently of the chosen target.

fn _collect_strs_from_stmt(st: ArmStrTab, s: Stmt) -> ArmStrTab {
    let mut out = st
    let mut i = 0
    while i < len(s.args) {
        let o = s.args[i]
        if o.kind == "const_str" {
            if len(_arm64_strtab_lookup(out, o.str_val)) == 0 {
                let mut keys = out.keys
                let mut labs = out.labels
                // PERF #4454-class: prime the 64-bucket hash index lazily
                // (covers strtabs constructed before the index existed —
                // rebuild is a one-time O(existing) fold).
                let mut ik = out.idx_keys
                let mut il = out.idx_labels
                if len(ik) != 64 {
                    ik = _arm64_strtab_empty_buckets()
                    il = _arm64_strtab_empty_buckets()
                    let mut ri = 0
                    while ri < len(keys) {
                        let rb = _arm64_strtab_hash(keys[ri])
                        ik[rb] = ik[rb].push(keys[ri])
                        il[rb] = il[rb].push(labs[ri])
                        ri = ri + 1
                    }
                }
                let n = len(keys)
                // F6 P0a — forced copy: o.str_val is the MFunc operand's
                // string handle; st outlives every streaming iteration, so
                // it must own its keys independently of any MFunc.
                // PLAN-stage3-footprint-F6.md.
                let key = o.str_val.substring(0, len(o.str_val))
                let lab = ".LCstr" + to_string(n)
                keys.push(key)
                labs.push(lab)
                // Index the same handles — bucket entries share the strtab's
                // lifetime, and .LCstrN numbering is untouched (emission
                // still walks `keys`/`labels` in first-occurrence order).
                let b = _arm64_strtab_hash(key)
                ik[b] = ik[b].push(key)
                il[b] = il[b].push(lab)
                out = ArmStrTab {
                    keys: keys, labels: labs,
                    fkeys: out.fkeys, flabels: out.flabels,
                    ftexts: out.ftexts,
                    idx_keys: ik, idx_labels: il
                }
            }
        }
        if o.kind == "const_float" {
            out = _arm64_float_intern(out, o.float_val, o.str_val)
        }
        i = i + 1
    }
    return out
}

// F1 (streaming footprint) — per-MFunc string-literal interning. The
// streaming codegen path (compiler/codegen/stream.hexa, PLAN-stage3-
// footprint.md F2) calls this once per function as it is lowered, so
// the ArmStrTab grows incrementally and the whole MModule never has to
// be materialised. Label assignment is insertion-ordered, so the table
// is byte-deterministic regardless of call cadence — incremental and
// whole-module interning produce bit-identical rodata.
fn _arm_strtab_collect_fn(st: ArmStrTab, f: MFunc) -> ArmStrTab {
    let mut acc = st
    let mut bi = 0
    while bi < len(f.blocks) {
        let blk = f.blocks[bi]
        let mut si = 0
        while si < len(blk.stmts) {
            acc = _collect_strs_from_stmt(acc, blk.stmts[si])
            si = si + 1
        }
        bi = bi + 1
    }
    return acc
}

// Whole-module strtab — the non-streaming path. Now a thin fold over
// _arm_strtab_collect_fn so both paths share one collector (no drift).
fn _build_arm_strtab(module: MModule) -> ArmStrTab {
    let mut st = ArmStrTab { keys: [], labels: [], fkeys: [], flabels: [], ftexts: [], idx_keys: [], idx_labels: [] }
    let mut fi = 0
    while fi < len(module.funcs) {
        st = _arm_strtab_collect_fn(st, module.funcs[fi])
        fi = fi + 1
    }
    return st
}

// Convert a string into a hex-encoded byte sequence (per-LSection
// payload format defined by lir.hexa). Appends a NUL terminator so
// the rodata entry is C-string compatible.
fn _hex_nibble(n: i64) -> string {
    if n == 0  { return "0" }
    if n == 1  { return "1" }
    if n == 2  { return "2" }
    if n == 3  { return "3" }
    if n == 4  { return "4" }
    if n == 5  { return "5" }
    if n == 6  { return "6" }
    if n == 7  { return "7" }
    if n == 8  { return "8" }
    if n == 9  { return "9" }
    if n == 10 { return "a" }
    if n == 11 { return "b" }
    if n == 12 { return "c" }
    if n == 13 { return "d" }
    if n == 14 { return "e" }
    return "f"
}

fn _byte_to_hex(b: i64) -> string {
    let hi = b / 16
    let lo = b - hi * 16
    return _hex_nibble(hi) + _hex_nibble(lo)
}

// Manual ASCII codepoint lookup. Stage0 hexa has no `ord`/codepoint
// primitive surfaced to user code, so we hard-code the printable
// range that real-world tests touch.
fn _ascii_code(ch: string) -> i64 {
    if ch == " " { return 32 }
    if ch == "!" { return 33 }
    if ch == "\"" { return 34 }
    if ch == "#" { return 35 }
    if ch == "$" { return 36 }
    if ch == "%" { return 37 }
    if ch == "&" { return 38 }
    if ch == "'" { return 39 }
    if ch == "(" { return 40 }
    if ch == ")" { return 41 }
    if ch == "*" { return 42 }
    if ch == "+" { return 43 }
    if ch == "," { return 44 }
    if ch == "-" { return 45 }
    if ch == "." { return 46 }
    if ch == "/" { return 47 }
    if ch == "0" { return 48 }
    if ch == "1" { return 49 }
    if ch == "2" { return 50 }
    if ch == "3" { return 51 }
    if ch == "4" { return 52 }
    if ch == "5" { return 53 }
    if ch == "6" { return 54 }
    if ch == "7" { return 55 }
    if ch == "8" { return 56 }
    if ch == "9" { return 57 }
    if ch == ":" { return 58 }
    if ch == ";" { return 59 }
    if ch == "<" { return 60 }
    if ch == "=" { return 61 }
    if ch == ">" { return 62 }
    if ch == "?" { return 63 }
    if ch == "@" { return 64 }
    if ch == "A" { return 65 }
    if ch == "B" { return 66 }
    if ch == "C" { return 67 }
    if ch == "D" { return 68 }
    if ch == "E" { return 69 }
    if ch == "F" { return 70 }
    if ch == "G" { return 71 }
    if ch == "H" { return 72 }
    if ch == "I" { return 73 }
    if ch == "J" { return 74 }
    if ch == "K" { return 75 }
    if ch == "L" { return 76 }
    if ch == "M" { return 77 }
    if ch == "N" { return 78 }
    if ch == "O" { return 79 }
    if ch == "P" { return 80 }
    if ch == "Q" { return 81 }
    if ch == "R" { return 82 }
    if ch == "S" { return 83 }
    if ch == "T" { return 84 }
    if ch == "U" { return 85 }
    if ch == "V" { return 86 }
    if ch == "W" { return 87 }
    if ch == "X" { return 88 }
    if ch == "Y" { return 89 }
    if ch == "Z" { return 90 }
    if ch == "[" { return 91 }
    if ch == "\\" { return 92 }
    if ch == "]" { return 93 }
    if ch == "^" { return 94 }
    if ch == "_" { return 95 }
    if ch == "`" { return 96 }
    if ch == "a" { return 97 }
    if ch == "b" { return 98 }
    if ch == "c" { return 99 }
    if ch == "d" { return 100 }
    if ch == "e" { return 101 }
    if ch == "f" { return 102 }
    if ch == "g" { return 103 }
    if ch == "h" { return 104 }
    if ch == "i" { return 105 }
    if ch == "j" { return 106 }
    if ch == "k" { return 107 }
    if ch == "l" { return 108 }
    if ch == "m" { return 109 }
    if ch == "n" { return 110 }
    if ch == "o" { return 111 }
    if ch == "p" { return 112 }
    if ch == "q" { return 113 }
    if ch == "r" { return 114 }
    if ch == "s" { return 115 }
    if ch == "t" { return 116 }
    if ch == "u" { return 117 }
    if ch == "v" { return 118 }
    if ch == "w" { return 119 }
    if ch == "x" { return 120 }
    if ch == "y" { return 121 }
    if ch == "z" { return 122 }
    if ch == "{" { return 123 }
    if ch == "|" { return 124 }
    if ch == "}" { return 125 }
    if ch == "~" { return 126 }
    if ch == "\n" { return 10 }
    if ch == "\t" { return 9 }
    return 63 // '?' for unknown (non-ASCII / control)
}

// Byte-true value of a single-byte string element (as produced by
// `s.chars()` in the hexa runtime, where each entry is one source
// byte regardless of UTF-8 codepoint boundaries). `_ascii_code` only
// covers ASCII printable + a few escapes and returns 63 ('?') for
// anything else, which mangled every non-ASCII rodata byte and made
// `"├── " == "└── "` true (both became `???????? `). Use
// `char_code_at` — the runtime builtin maps to hexa_str_char_code_at
// which returns the underlying byte value 0..255 for high-bit bytes.
fn _byte_code(ch: string) -> i64 {
    if len(ch) == 0 { return 0 }
    return char_code(ch)
}

fn _str_to_hex_bytes(s: string) -> string {
    // Cycle 39: `s.chars()` returns UTF-8 CODEPOINTS (since 2026-05-19
    // parity-gate t45b). _byte_code(cs[i]) only returns the FIRST BYTE
    // of each multi-byte codepoint, dropping continuation bytes. That
    // truncated em-dashes / box-drawing chars / arrows in string
    // literals → gen1.s (aprime via hexat→C→clang) preserved them
    // via clang's static rodata, but gen2.s (hexac via aprime emit-asm
    // → asm path) lost them through this pool. Use `s.bytes()` which
    // returns per-byte i64 entries (raw 0..255), preserving UTF-8.
    let bs = s.bytes()
    // PERF #4454-class: parts+join instead of `out = out + hex` per byte —
    // the '+' re-copied the whole accumulator each iteration, O(L²) per
    // literal. join("") is a single length-summed alloc; output identical.
    let mut parts: [string] = []
    let mut i = 0
    while i < len(bs) {
        parts.push(_byte_to_hex(bs[i]))
        i = i + 1
    }
    parts.push("00") // NUL terminator
    return parts.join("")
}

fn _strtab_to_rodata(st: ArmStrTab) -> [LSection] {
    let mut out: [LSection] = []
    let mut i = 0
    while i < len(st.keys) {
        out.push(LSection {
            name: st.labels[i],
            bytes: _str_to_hex_bytes(st.keys[i]),
            align: 0
        })
        i = i + 1
    }
    return out
}

// ── Module entry point ───────────────────────────────────────

// RFC 070 G7-A.native impl — Shape B sub-cycle 2026-05-20:
// entry signature now carries `opts: CodegenOptions` (lifted to
// compiler/ir/lir.hexa by the B1 iface commit). All callers updated to
// pass `codegen_options_default()` in this cycle — they all behave
// exactly as before (opts.shared == 0, opts.target_triple == ""), so
// the emit body is byte-identical to the pre-iface output. The actual
// `if opts.shared` GOT-load + `.private_extern` emit-body branches are
// the NEXT sub-cycle (G7-A.native impl emit). This commit is the
// signature lift only — measurable falsifier: corpus byte-eq with the
// default `opts` argument (any diff would mean an accidental capture
// of `opts.shared` somewhere in the body).
pub fn codegen_arm64_darwin(module: MModule, opts: CodegenOptions) -> LModule {
    // SELFHOST-NEXT linux-arm64: same arm64 instruction codegen serves both
    // the Mach-O (darwin) and ELF (linux-gnu) AArch64 platforms. The only
    // delta is the `target` string stamped on the LFunc/LModule, which the
    // emit pass keys on for ELF sections + bare (no `_`) symbol labels.
    // `opts.target_triple == "arm64-linux-gnu"` selects ELF; any other value
    // (incl. the default empty string) keeps the historical Mach-O output
    // byte-identical.
    let mut cg_target = "arm64-apple-darwin"
    if opts.target_triple == "arm64-linux-gnu" {
        cg_target = "arm64-linux-gnu"
    }
    let elf = cg_target == "arm64-linux-gnu"
    let st = _build_arm_strtab(module)
    // Wall 3-c: reset the __hx_static_slot accumulator for THIS module (module-scope
    // mutable; a prior module's slots must not leak). Empty on the byteeq path.
    _arm64_static_slots = []
    // §M8 feature C: reset the named-rodata-table accumulator for THIS module too
    // (module-scope mutable; prior-module tables must not leak). Stays [] on the
    // byteeq path → rodata unchanged → byte-eq NEUTRAL.
    _arm64_rodata_tabs = []
    let mut funcs = []
    let mut i = 0
    while i < len(module.funcs) {
        // Stage1 C8 — recompute modhash inline at every call site so
        // stage0's transitive-let binding gap (see _STMT_* mirror at
        // top of this file) cannot hand the lowering pass a void.
        funcs.push(_arm64_lower_func(module.funcs[i], st, _arm64_modhash(module.file), cg_target))
        i = i + 1
    }
    // Emit a writable 16-byte slot per module-level mutable global
    // (symbol `g<id>`). Runtime init via the parser's synthetic-main
    // `g<id> = E` assign — see hir_to_mir global resolution.
    // Mach-O user symbols carry a leading `_` prefix; the codegen's
    // `g<id>` references resolve to `_g<id>` (matching `_hexa_…`
    // builtins). Emit the data label with the same prefix so the link
    // resolves to one symbol — without this the linker reports
    // `_g0 undefined` even though `g0:` exists in `__DATA,__data`.
    let mut gnames: [string] = []
    let mut gi = 0
    while gi < len(module.globals) {
        // Mach-O user symbols carry the leading `_`; ELF symbols are bare.
        // The emit-side _fmt_label adds the `_` for darwin only, so the
        // data label must match the reference spelling on each platform.
        if elf {
            gnames.push("g" + to_string(module.globals[gi].id))
        } else {
            gnames.push("_g" + to_string(module.globals[gi].id))
        }
        gi = gi + 1
    }
    // Wall 3-c: append the self-static-slot labels (already platform-prefixed:
    // `_slot_<id>__sz<N>` on darwin, `slot_<id>__sz<N>` on ELF) so emit/asm defines
    // a `.zero N`-sized data symbol for each. Empty on the byteeq path.
    let mut si = 0
    while si < len(_arm64_static_slots) {
        gnames.push(_arm64_static_slots[si])
        si = si + 1
    }
    // Float-pool entries from the strtab → LFloat list. `.LC*` is a
    // local label (no `_` prefix needed) per the existing strtab
    // convention; the use-site references it as-is. Prefer the
    // captured source text (full literal precision) over a
    // `to_string(f64)` round-trip which truncates to ~6 digits in
    // stage0 — see the comment on ArmStrTab.ftexts above.
    let mut flts: [LFloat] = []
    let mut fp = 0
    while fp < len(st.fkeys) {
        let mut ftext = st.ftexts[fp]
        if len(ftext) == 0 { ftext = to_string(st.fkeys[fp]) }
        flts.push(LFloat {
            label: st.flabels[fp],
            text: ftext
        })
        fp = fp + 1
    }
    // §M8 feature C: build the rodata list = string-table sections PLUS one
    // `.rodata` LSection per referenced named table (`rotab_<id>`), aligned 8
    // (.p2align 3) with the LE-double payload. The DEFINED section symbol must match
    // the adrp REFERENCE after _fmt_label: `_rotab_<id>` on darwin (Mach-O user-symbol
    // `_` prefix), bare `rotab_<id>` on ELF — the same platform spelling discipline as
    // the static-slot deflabel. Empty `_arm64_rodata_tabs` on the byteeq path →
    // identical to the bare `_strtab_to_rodata(st)` → byte-eq NEUTRAL.
    let mut rodata_secs = _strtab_to_rodata(st)
    let mut rti = 0
    while rti < len(_arm64_rodata_tabs) {
        let rtid = _arm64_rodata_tabs[rti]
        let mut rtname = "_rotab_" + to_string(rtid)   // darwin: _fmt_label-spelled
        if elf { rtname = "rotab_" + to_string(rtid) }  // ELF: bare
        let rtpayload = _arm64_u64hex_list_to_le_payload(_arm64_rodata_table_spec(rtid))
        rodata_secs.push(LSection {
            name: rtname,
            bytes: rtpayload,
            align: 3
        })
        rti = rti + 1
    }
    return LModule {
        file: module.file,
        target: cg_target,
        funcs: funcs,
        rodata: rodata_secs,
        bss: [],
        globals: gnames,
        floats: flts
    }
}
