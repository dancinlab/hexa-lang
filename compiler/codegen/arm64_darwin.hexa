// HEXA Native Compiler — Codegen / arm64-apple-darwin (Phase A1)
//
// @version 0.1.0
// @capabilities [pure]
// @allow-relop-banned-file  — codegen path uses `>=`/`<=` for arity
//   guards and signed-id checks; C6 regalloc inherits the same need.
//
// Lowers MIR (SSA CFG) -> LIR (target-specific instructions) for the
// arm64-apple-darwin target.
//
//   pub fn codegen_arm64_darwin(module: MModule) -> LModule
//
// ABI: AAPCS64
//   - Integer args: x0..x7 (overflow on stack — v1 ignored, tiny tests only)
//   - Integer return: x0
//   - Frame pointer: x29 (fp), Link register: x30 (lr)
//   - Stack pointer: 16-byte aligned at function boundaries
//
// Per MFunc layout:
//   prologue:
//       stp x29, x30, [sp, #-16]!
//       mov x29, sp
//   <block instrs>
//   epilogue:
//       ldp x29, x30, [sp], #16
//       ret
//
// v1 register policy:
//   Naive — Local id N -> register x(N % 31).  No spilling, no liveness.
//   Tier-0 tier verification only; tiny test cases fit in <31 locals.
//
// Constraints (from RFC-018 §4):
//   - struct >16B by reference (not handled v1)
//   - hidden first arg for >16B return (not handled v1)
//
// ── RFC 070 G7-A.native scaffold (2026-05-20, comment-only marker) ──
//
// G7-A.flag-wire (C path · landed `66b055c4`) wires `hexa build --shared`
// through to `clang -fPIC -shared`. The native backend below currently
// REFUSES `HEXA_BACKEND=native` + `--shared` at `self/main.hexa::cmd_build`
// L1973-1978 — this scaffold block documents the delta we owe the
// native side before the gate can drop.
//
// Current arm64-darwin addressing baseline (PIE-equivalent, NOT PIC-`.dylib`):
//   - Local symbol/cstring loads: `adrp Xn, sym@PAGE` + `add Xn, Xn, sym@PAGEOFF`
//     (see L1042, L1057, L1067, L1099, L1117, L1377, L1441). PC-relative
//     within ±4 GiB. Mach-O MH_PIE for the executable-shape output.
//   - Extern fn references: today resolved at static-link time via the
//     plt-less path; no GOT indirection emitted.
//
// G7-A.native impl delta (the next sub-cycle):
//   1. Honor `bopts[4]=="1"` (the `shared` flag wired in G7-A.flag-wire)
//      inside `codegen_arm64_darwin` entry — branch addressing-mode
//      selection on it. Plumb `shared: i64` through the codegen
//      module-level options struct. **CodegenOptions struct lifted to
//      `compiler/ir/lir.hexa` 2026-05-20 (interface-only commit)** —
//      see `pub struct CodegenOptions { shared: i64, target_triple: string }`
//      + `codegen_options_default()` seed helper. This sub-cycle threads
//      it as an optional 2nd arg to `codegen_arm64_darwin` (signature
//      change synchronized with `compiler/main.hexa:799` + 2 callers in
//      `compiler/codegen/codegen_test.hexa`).
//   2. Extern fn refs in shared mode go through the GOT:
//        adrp Xn, sym@GOTPAGE
//        ldr  Xn, [Xn, sym@GOTPAGEOFF]
//      Reloc kinds = `ARM64_RELOC_GOT_LOAD_PAGE21` + `ARM64_RELOC_GOT_LOAD_PAGEOFF12`.
//      **Reloc kind string constants lifted to `compiler/ir/lir.hexa`
//      as `pub let RELOC_AARCH64_ADR_GOT_PAGE` + `RELOC_AARCH64_LD64_GOT_LO12_NC`
//      2026-05-20** — tag GOT-load LInstrs via `LInstr.comment` so the
//      asm-text emitter can dispatch on the suffix.
//      Local fn refs stay on `@PAGE/@PAGEOFF` (no change).
//   3. Hidden-visibility default: emit `.private_extern <sym>` directive
//      for every defined fn EXCEPT `<plugin_id>_dispatch`, which alone
//      gets `.globl`. Mach-O export trie then carries exactly 1 entry.
//
// Falsifier hooks for G7-A.native impl (real-limit anchored per `@D g3`):
//   - F-A1: `<plugin_id>_dispatch` symbol address is page-aligned (real-limit
//     = arm64 Darwin 16 KiB page granularity) AFTER `dlopen` at a
//     non-default base — verifies PC-relative emission, not luck.
//   - F-A2: `nm <plugin>.dylib | awk '$2 == "T" || $2 == "D"'` lists
//     exactly 1 symbol matching `<plugin_id>_dispatch`. All others are
//     local (`t`/`d`). Anchor = Mach-O export trie format (`<mach-o/loader.h>`).
//
// Scope marker: THIS commit is scaffold-only (zero behavior change). The
// `codegen_arm64_darwin` body is untouched. See RFC 070 §4.4 for the
// honest scope and `compiler/PLAN.md` for the cycle entry.

import "../ir/mir.hexa"
import "../ir/lir.hexa"

// ── Local mirror of mir.hexa STMT_* constants ────────────────
// See note in compiler/lower/hir_to_mir.hexa: stage0's interpreter does
// not propagate transitive `pub let` bindings, so STMT_* arrive here as
// the void value. Redeclaring locally keeps codegen dispatch working.
let _STMT_ASSIGN   = "assign"
let _STMT_BINOP    = "binop"
let _STMT_UNOP     = "unop"
let _STMT_CALL     = "call"
// RFC closure C3 — local mirror of mir.hexa STMT_CALL_INDIRECT.
let _STMT_CALL_INDIRECT = "call_indirect"
let _STMT_RETURN   = "return"
let _STMT_BR       = "br"
let _STMT_BR_COND  = "br_cond"

// RFC061 Route C Wall 3-c — __hx_static_slot self-defined BSS accumulator (arm64
// sibling of x86_64's _x86_static_slots). Each distinct `slot_id` literal addressed
// by a whitelisted Route C `__hx_static_slot(slot_id, size_bytes)` records its
// encoded label here ONCE; `codegen_arm64_darwin` appends them to LModule.globals so
// emit/asm defines a `.zero N` data symbol. ONLY appended-to inside the
// __hx_static_slot STMT_CALL special-case → empty on the byteeq path → byte-eq
// NEUTRAL. (Darwin user-symbols carry the `_` prefix; the label is encoded WITH the
// platform prefix already applied so it matches the codegen `adrp _slot_<id>@PAGE`
// reference after _fmt_label.)
pub let mut _arm64_static_slots: [string] = []

// RFC061 §M8 varargs-ABI (r2) — set true by _arm64_lower_func iff the fn being lowered
// is variadic under HEXA_VA_INTRINSICS=1 (mirrors x86_64's _x86_va_active). Consulted
// by the _STMT_RETURN path to route a SIMD-class variadic return into d0. Default false
// (HEXA_VA_INTRINSICS unset → never set) → the va return branch is dead → byte-eq NEUTRAL.
pub let mut _arm64_va_active: bool = false
// ING #29 literal-∅ (2026-06-30): `@naked` fn attribute — set per-fn by
// `_arm64_lower_func` from MFunc.is_naked. When true the prologue (stp x29,x30
// / mov x29,sp / spill alloc) and BOTH epilogue emit sites are SKIPPED, leaving
// the fn body as raw asm (the body must terminate itself). reference-match:
// GCC __attribute__((naked)) / rustc #[naked] / zig callconv(.Naked). DEFAULT
// false on every existing fn → byte-eq NEUTRAL. NOTE: rt_sigreturn trampoline
// measurement is x86_64-only (arm64 kernel supplies the signal trampoline), so
// this guard keeps arm64 codegen correct for a `@naked` fn but is not exercised
// by the rt_sigreturn probe (x86_64 scope).
pub let mut _arm64_is_naked: bool = false

// True iff `s` begins with `pfx` (char-walk; no .substr — keeps stage0-portable).
fn _arm64_str_starts_with(s: string, pfx: string) -> bool {
    let cs = s.chars()
    let cp = pfx.chars()
    let np = len(cp)
    if len(cs) < np { return false }
    let mut i = 0
    while i < np {
        if cs[i] != cp[i] { return false }
        i = i + 1
    }
    return true
}

fn _arm64_record_static_slot(label_no_sz: string, size_bytes: i64) {
    let enc = label_no_sz + "__sz"
    let mut i = 0
    while i < len(_arm64_static_slots) {
        if _arm64_str_starts_with(_arm64_static_slots[i], enc) { return }
        i = i + 1
    }
    _arm64_static_slots.push(enc + to_string(size_bytes))
}

// RFC061 §M8 named-rodata-table (literal-∅ feature C) — arm64 sibling of x86_64's
// _x86_rodata_tabs. PRE-INITIALIZED `.rodata` constant tables (the data-leaf wall
// named at hxlcl_fmod/sin/cos: modern musl exp/log are TABLE-driven —
// __exp_data.tab[256] / __log_data.tab[128]). Each distinct `table_id` literal a
// whitelisted Route C body addresses via `__hx_rodata_tab_ptr(table_id)` records its
// id here ONCE (deduped); `codegen_arm64_darwin` decodes each into an LSection
// appended to LModule.rodata so emit defines a `.p2align 3` `rotab_<id>` symbol whose
// bytes are the table's LITTLE-ENDIAN doubles (AArch64 is LE, same payload as x86_64).
// ONLY appended-to inside the `__hx_rodata_tab_ptr` STMT_CALL special-case → empty on
// the byteeq path → rodata unchanged → byte-eq NEUTRAL (same property as
// _arm64_static_slots; hxlcl_core.hexa is never imported by self/).
pub let mut _arm64_rodata_tabs: [i64] = []

fn _arm64_record_rodata_tab(table_id: i64) {
    let mut i = 0
    while i < len(_arm64_rodata_tabs) {
        if _arm64_rodata_tabs[i] == table_id { return }   // idempotent (deduped)
        i = i + 1
    }
    _arm64_rodata_tabs.push(table_id)
}

// Table CONTENTS registry — keyed by table_id. Returns a whitespace/comma-separated
// list of BIG-ENDIAN uint64 hex tokens (the verbatim form musl's exp_data.c ships;
// `_arm64_u64hex_list_to_le_payload` converts each to 8 LE bytes). Content is
// IDENTICAL to x86_64's _x86_rodata_table_spec (same musl bit patterns; both targets
// little-endian). An unknown id returns "" (empty table).
//   id 0 = PROBE: tab[0]=1.0, tab[1]=2.0 — the STEP-0 mechanism witness.
//   id 1 = musl exp __exp_data.tab[256] (src/math/exp_data.c, EXP_TABLE_BITS=7 N=128).
fn _arm64_rodata_table_spec(table_id: i64) -> string {
    if table_id == 0 {
        return "3ff0000000000000 4000000000000000"
    }
    // id 1 = musl exp __exp_data.tab[256] (src/math/exp_data.c, EXP_TABLE_BITS=7
    // N=128 → 256 uint64 entries, interleaved {tail_off, sbits_base} pairs).
    // BIG-ENDIAN uint64 hex VERBATIM from musl (raw bit patterns; no float_to_bits).
    // `_arm64_u64hex_list_to_le_payload` converts each to 8 LE bytes for the
    // rotab_1 `.byte` payload. Authoritative: git.musl-libc.org exp_data.c.
    if table_id == 1 {
            return "0 3ff0000000000000 3c9b3b4f1a88bf6e 3feff63da9fb3335 bc7160139cd8dc5d 3fefec9a3e778061 bc905e7a108766d1 3fefe315e86e7f85 "
