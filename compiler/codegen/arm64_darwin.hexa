            // for the scale round; gated empty-whitelist-off so byteeq-neutral.)
            let cn = len(s.args)
            let mut ci = 0
            while ci < cn {
                if ci < 8 {
                    buf = _hv_load(buf, s.args[ci], st, rm, "x9", _arm64_arg_reg(ci))
                }
                ci = ci + 1
            }
            let ctarget = _builtin_runtime_sym(s.op, len(s.args))
            buf.push(_arm64_instr1("bl", _arm64_op_label(ctarget), "cabi call " + ctarget))
            if s.dst.id >= 0 {
                buf.push(_arm64_instr2("movz", _arm64_op_reg("x9"),
                                 _arm64_op_label("#0"), "cabi ret tag = TAG_INT"))
                buf = _hv_store_dst(buf, rm, s.dst, "x9", "x0")
            }
