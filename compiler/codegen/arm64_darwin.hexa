                    buf.push(_arm64_instr2("adrp", _arm64_op_reg("x15"),
                                     _arm64_op_label(egl + "@PAGE"),
                                     "index_set: poly container global page (store-back)"))
                    buf.push(_arm64_instr3("add", _arm64_op_reg("x15"),
                                     _arm64_op_reg("x15"),
                                     _arm64_op_label(egl + "@PAGEOFF"),
                                     "index_set: poly container global off (store-back)"))
                    buf.push(_arm64_instr3("stp", _arm64_op_reg("x0"),
                                     _arm64_op_reg("x1"),
                                     _arm64_op_label("[x15]"),
                                     "index_set: poly store-back into global " + egl))
