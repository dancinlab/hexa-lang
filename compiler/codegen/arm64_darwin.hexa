            let mut os_imm = "#1"
            let mut os_why = "__hx_target_os: 1 = darwin"
            if opts.target_triple == "arm64-linux-gnu" {
                os_imm = "#0"
                os_why = "__hx_target_os: 0 = linux"
            }
            buf.push(_arm64_instr2("movz", _arm64_op_reg("x1"),
                             _arm64_op_label(os_imm), os_why))
            buf.push(_arm64_instr2("movz", _arm64_op_reg("x0"),
                             _arm64_op_label("#0"), "__hx_target_os: TAG_INT"))
            if s.dst.id >= 0 { buf = _hv_store_dst(buf, rm, s.dst, "x0", "x1") }
            return buf
