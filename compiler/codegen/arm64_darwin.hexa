                buf.push(_arm64_instr2("mov", _arm64_op_reg("x15"),
                                 _arm64_op_reg("x8"), "__hx_syscall6_out2: stage syscall num"))
            } else {
                buf.push(_arm64_instr2("mov", _arm64_op_reg("x16"),
                                 _arm64_op_reg("x8"), "__hx_syscall6_out2: x16 = syscall num"))
            }
            let mut mi = 0
            while mi <= 5 {
                buf.push(_arm64_instr2("mov", _arm64_op_reg("x" + to_string(mi)),
                                 _arm64_op_reg(tmps[mi]), "__hx_syscall6_out2: arg -> x" + to_string(mi)))
