        let mut i = 0
        while i < arg_n {
            if i < 4 {
                let lo = "x" + to_string(i * 2)
                let hi = "x" + to_string(i * 2 + 1)
                buf = _hv_load(buf, s.args[i], st, rm, lo, hi)
            } else {
                buf = _hv_load(buf, s.args[i], st, rm, "x9", "x10")
                let off = (i - 4) * 16
                buf = _hv_at(buf, off, "x15")
                buf.push(_arm64_instr3("stp", _arm64_op_reg("x9"),
                                 _arm64_op_reg("x10"), _hv_memb(off, "x15"),
                                 "C7: stack arg " + to_string(i)))
            }
            i = i + 1
        }
        let mut target = _builtin_runtime_sym(s.op, len(s.args))
        // FLEET arm64 element-pack (HEXA_PACK_ESCAPING) — escaping-poly push/len.
        // The generic builtin emit already lands the args in the SAME registers the
        // poly readers want (push: v → x0:x1, item → x2:x3 ≡ hexa_arr_poly_push;
        // len: v → x0:x1 ≡ hexa_arr_poly_len, returning int64 in x0 — IDENTICAL
        // ABI + ret-box to hexa_len), so ONLY the call target changes. The runtime
        // discriminates on HX_TAG==TAG_ARRAY_I64 (stride-8 raw) else delegates to
        // the boxed hexa_array_push / hexa_len. Mirror of x86_64's poly push/len.
        if s.op == "push" && len(s.args) >= 2 && _arm_operand_pack_esc(s.args[0], rm) {
            target = "hexa_arr_poly_push"
        }
