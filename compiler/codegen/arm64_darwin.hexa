                             _arm64_op_label(carrier + "@PAGE"),
                             "carrier_call: " + carrier + " page"))
            buf.push(_arm64_instr3("add", _arm64_op_reg("x9"),
                             _arm64_op_reg("x9"),
                             _arm64_op_label(carrier + "@PAGEOFF"),
                             "carrier_call: " + carrier + " off"))
