                                 _arm64_op_reg("x8"), "__hx_syscall6: stage syscall num"))
            } else {
                buf.push(_arm64_instr2("mov", _arm64_op_reg("x16"),
                                 _arm64_op_reg("x8"), "__hx_syscall6: x16 = syscall num"))
            }
