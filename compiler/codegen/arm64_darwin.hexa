        // shr/shl payload-shift-leaf; ADD-only (the compiler never calls these),
        // so arm64 emit is byte-unchanged when the intrinsics are unused.
        if (s.op == "__hx_payload_shl" || s.op == "__hx_payload_shr")
            && len(s.args) >= 2 {
            buf = _hv_load(buf, s.args[0], st, rm, "x0", "x1")  // v → x1=payload
            buf = _hv_load(buf, s.args[1], st, rm, "x2", "x3")  // n → x3=count
