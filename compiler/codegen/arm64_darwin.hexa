                             _arm64_op_label("__stderrp@GOTPAGE"),
                             "__hx_stderr_ptr: &__stderrp GOT page [reloc=" + RELOC_AARCH64_ADR_GOT_PAGE + "]"))
            buf.push(_arm64_instr2("ldr", _arm64_op_reg("x1"),
                             _arm64_op_mem_label("x1", "__stderrp@GOTPAGEOFF"),
                             "__hx_stderr_ptr: x1 = &__stderrp [reloc=" + RELOC_AARCH64_LD64_GOT_LO12_NC + "]"))
            buf.push(_arm64_instr2("movz", _arm64_op_reg("x0"),
                             _arm64_op_label("#0"), "__hx_stderr_ptr: TAG_INT"))
            if s.dst.id >= 0 { buf = _hv_store_dst(buf, rm, s.dst, "x0", "x1") }
            return buf
