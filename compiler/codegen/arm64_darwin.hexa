fn _arm64_u64hex_to_le_hex(tok: string) -> string {
    let cs = tok.chars()
    let n = len(cs)
    // left-pad to 16 hex digits
    let mut padded = ""
    let mut p = n
    while p < 16 {
        padded = padded + "0"
        p = p + 1
    }
    let mut k = 0
    while k < n {
        padded = padded + cs[k]
        k = k + 1
    }
    // reverse byte-pairs: bytes are at [0,1][2,3]…[14,15]; LE order is
    // [14,15][12,13]…[0,1].
    let pc = padded.chars()
    let mut out = ""
    let mut bi = 7
    while bi >= 0 {
        out = out + pc[bi * 2] + pc[bi * 2 + 1]
        bi = bi - 1
    }
    return out
}

// Encode a whitespace-separated list of BIG-ENDIAN uint64 hex tokens into the
// concatenated LITTLE-ENDIAN byte-hex payload for one rodata table. Each token
// becomes 8 LE bytes (16 hex chars). Whitespace / commas separate tokens.
fn _arm64_u64hex_list_to_le_payload(spec: string) -> string {
    let cs = spec.chars()
    let n = len(cs)
    let mut out = ""
    let mut tok = ""
    let mut i = 0
    while i < n {
        let c = cs[i]
        if c == " " || c == "\n" || c == "\t" || c == "," || c == "\r" {
            if len(tok) > 0 {
                out = out + _arm64_u64hex_to_le_hex(tok)
                tok = ""
            }
        } else {
            tok = tok + c
        }
        i = i + 1
    }
    if len(tok) > 0 {
        out = out + _arm64_u64hex_to_le_hex(tok)
    }
    return out
}


// ── PReg / LOperand helpers ──────────────────────────────────

fn _arm64_preg_gpr(name: string) -> PReg {
    return PReg { name: name, kind: "gpr", frag_role: "", frag_dtype: "", frag_layout: "" }
}

fn _arm64_empty_preg() -> PReg {
    return PReg { name: "", kind: "", frag_role: "", frag_dtype: "", frag_layout: "" }
}

fn _arm64_op_reg(name: string) -> LOperand {
    return LOperand {
        kind: "reg",
        reg: _arm64_preg_gpr(name),
        imm: 0,
        mem_base: _arm64_empty_preg(),
        mem_offset: 0,
        label: ""
    }
}

fn _arm64_op_imm(value: i64) -> LOperand {
    return LOperand {
        kind: "imm",
        reg: _arm64_empty_preg(),
        imm: value,
        mem_base: _arm64_empty_preg(),
        mem_offset: 0,
        label: ""
    }
}

fn _arm64_op_label(name: string) -> LOperand {
    return LOperand {
        kind: "label",
        reg: _arm64_empty_preg(),
        imm: 0,
        mem_base: _arm64_empty_preg(),
        mem_offset: 0,
        label: name
    }
}

fn _arm64_op_mem(base: string, offset: i64) -> LOperand {
    return LOperand {
        kind: "mem",
        reg: _arm64_empty_preg(),
        imm: 0,
        mem_base: _arm64_preg_gpr(base),
        mem_offset: offset,
        label: ""
    }
}

// RFC 070 G7-A.native impl emit (2026-05-20): label-as-offset memory
// operand for GOT loads on Mach-O / ELF arm64 — `[Xn, sym@GOTPAGEOFF]`.
// Uses the existing LOperand mem shape with the `label` field carrying
// the relocation-prefixed symbol; `_fmt_mem` (compiler/emit/asm.hexa)
// dispatches on `op.label != ""` and renders `[base, label]` for darwin
// / thumb. mem_offset=0 (unused — label substitutes for the integer
// offset). Sole caller today: the `if opts.shared` global branch in
// `_arm64_op_rm` below; locally-loaded shared-mode globals route GOT.
fn _arm64_op_mem_label(base: string, label: string) -> LOperand {
    return LOperand {
        kind: "mem",
        reg: _arm64_empty_preg(),
        imm: 0,
        mem_base: _arm64_preg_gpr(base),
        mem_offset: 0,
        label: label
    }
}

fn _arm64_instr0(op: string, comment: string) -> LInstr {
    return LInstr { op: op, args: [], comment: comment }
}

fn _arm64_instr1(op: string, a: LOperand, comment: string) -> LInstr {
    let mut xs = []
    xs.push(a)
    return LInstr { op: op, args: xs, comment: comment }
}

fn _arm64_instr2(op: string, a: LOperand, b: LOperand, comment: string) -> LInstr {
    let mut xs = []
    xs.push(a)
    xs.push(b)
    return LInstr { op: op, args: xs, comment: comment }
}

fn _arm64_instr3(op: string, a: LOperand, b: LOperand, c: LOperand, comment: string) -> LInstr {
    let mut xs = []
    xs.push(a)
    xs.push(b)
    xs.push(c)
    return LInstr { op: op, args: xs, comment: comment }
}

fn _arm64_instr4(op: string, a: LOperand, b: LOperand, c: LOperand, d: LOperand, comment: string) -> LInstr {
    let mut xs = []
    xs.push(a)
    xs.push(b)
    xs.push(c)
    xs.push(d)
    return LInstr { op: op, args: xs, comment: comment }
}

// ── Register assignment (naive fallback) ─────────────────────
//
// Used only when no RegMap is available. Production codegen runs
// through `_arm64_assign_regs` (linear scan, Poletto-Sarkar 1999)
// and `_arm_reg_lookup` below.

fn _arm64_reg_for_local(local_id: i64) -> string {
    let mut idx = local_id
    if idx < 0 { idx = 0 }
    let m = idx - (idx / 31) * 31
    return "x" + to_string(m)
}

// ── C6 — Linear-scan register allocator (arm64) ──────────────
pub struct RegMap {
    ids: [i64],
    regs: [string],
    slots: [i64],
    // C7 — per-fn outgoing-call overflow region (bytes, 16-aligned),
    // pre-allocated at prologue bottom. _arm_spill_offset shifts every
    // SSA spill access above this region so per-call stack-spill stores
    // can use [sp, #(i-8)*8] without disturbing SSA offsets.
    call_overflow_bytes: i64,
    // #3712 (arm64 port) — id → index-into-`ids` direct array (sized maxid+1,
    // -1 = absent). The per-operand reg/spill lookups (_arm_reg_lookup /
    // _arm_is_spilled / _arm_spill_offset) probe this in O(1) instead of an
    // O(len(ids)) `_arm_index_of` scan — collapsing per-function codegen from
    // O(stmts·locals) to O(stmts) (the x86_64 backend hit this as the gen3
    // obj-emit wall: O(n²) hang on the 7000-binop runtime_cuda_emit; the
    // _arm_index_of ids[id]==id fast path only covers the dense in-order
    // prefix, every other id fell back to the linear scan). Built once from
    // the final `ids` order, so every lookup returns the identical slot —
    // byte-eq NEUTRAL.
    id2idx: [i64],
    // FLEET arm64 element-pack (HEXA_PACK_ESCAPING) — mirror of x86_64's
    // X86RegMap.local_type + .local_packed_esc_ok. The arm64 backend never had a
    // per-local type lattice (it routes everything through the boxed runtime), so
    // escape-relax (the x86_64-only #4133 fix shipped #4140/#4143/#4151) was a
    // no-op here: an escaping typed-prim [i64] stayed boxed. These two slots add
    // the SAME esc-mint + poly-route lattice the x86_64 backend uses, gated on
    // `_arm_pack_escaping_enabled()` so they stay EMPTY `[]` when the flag is OFF
    // → never consulted → emit byte-identical to origin (arm64-linux + darwin-arm64
    // OFF-byteeq). Built ONLY in `_arm64_assign_regs`.
    //   local_type[id]          — id → MIR Local.type_id (101/102 = HexaArrI64
    //                             i64/i32 typed-prim array). 0 = absent/unclassified.
    //   local_packed_esc_ok[id] — id → 1 when this array_lit STORAGE T should
    //                             esc-mint (hexa_arr_i64_new_esc → TAG_ARRAY_I64).
    local_type: [i64],
    local_packed_esc_ok: [i64]
}

pub struct ArmAllocResult {
    map: RegMap,
    frame_size: i64
}

pub struct ArmIntervals {
    ids: [i64],
    starts: [i64],
    ends: [i64]
}

fn _arm_pool_init() -> [string] {
    let mut p: [string] = []
    p.push("x10")
    p.push("x11")
    p.push("x12")
    p.push("x13")
    p.push("x14")
    p.push("x15")
    p.push("x19")
    p.push("x20")
    p.push("x21")
    p.push("x22")
    p.push("x23")
    p.push("x24")
    p.push("x25")
    p.push("x26")
    p.push("x27")
    p.push("x28")
    return p
}

fn _arm_index_of(ids: [i64], id: i64) -> i64 {
    // O(1) fast path: SSA ids are dense (next_local-allocated) and the
    // id-arrays here (ids / iv.ids / rm.ids) are built in id order, so
    // ids[id] == id is the common case. ids is dedup-built (each id
    // appears once) so when ids[id]==id, `id` is THE unique index —
    // sound. Falls back to the linear scan otherwise.
    // #3712 (arm64 port) — the HOT users are gone: the live-range dedup
    // probes a direct id2slot array and the per-operand RegMap lookups
    // (_arm_reg_lookup/_arm_is_spilled/_arm_spill_offset) probe RegMap.id2idx,
    // both O(1) always (the fast path here only covered the dense in-order
    // prefix; out-of-order ids fell back to the O(len(ids)) scan). Remaining
    // callers are the one-time O(params·ids) param scans in _arm64_assign_regs.
    if id >= 0 && id < len(ids) {
        if ids[id] == id { return id }
    }
    let mut i = 0
    while i < len(ids) {
        if ids[i] == id { return i }
        i = i + 1
    }
    return -1
}

// ── FLEET arm64 element-pack (HEXA_PACK_ESCAPING) — gate + probes ─────────────
// Direct mirror of x86_64_linux.hexa's _pack_escaping_enabled / _x86_local_type /
// _x86_operand_pack_esc / _x86_local_esc_mint (#4143/#4151), prefixed `_arm_` so
// the two backends share NO top-level symbol (flatten-collision-safe, #3899). The
// SAME env flag HEXA_PACK_ESCAPING gates BOTH backends (shared opt-in). The runtime
// half (TAG_ARRAY_I64 discriminator + hexa_arr_poly_* readers, #4140, compiled
// -DHEXA_PACK_ESCAPING) is platform-agnostic C, so an esc-minted array is read
// soundly on arm64 by the SAME poly readers. Default-OFF (env unset) → every
// branch below returns false/empty → emit byte-identical to origin (OFF-byteeq).

// Max local id across locals/params/stmts (sizing the esc lattices). Mirror of
// _x86_max_local_id.
fn _arm_max_local_id(mf: MFunc) -> i64 {
    let mut m = -1
    let mut li = 0
    while li < len(mf.locals) {
        if mf.locals[li].id > m { m = mf.locals[li].id }
        li = li + 1
    }
    let mut pi = 0
    while pi < len(mf.params) {
        if mf.params[pi].id > m { m = mf.params[pi].id }
        pi = pi + 1
    }
    let mut bi = 0
    while bi < len(mf.blocks) {
        let blk = mf.blocks[bi]
        let mut si = 0
        while si < len(blk.stmts) {
            let s = blk.stmts[si]
            if s.dst.id > m { m = s.dst.id }
            let mut ai = 0
            while ai < len(s.args) {
                if s.args[ai].kind == "local" && s.args[ai].local_id > m {
                    m = s.args[ai].local_id
                }
                ai = ai + 1
            }
            si = si + 1
        }
        bi = bi + 1
    }
    return m
}

// escape-relax gate (HEXA_PACK_ESCAPING). Default-OFF (env unset) → every esc
// branch in _arm64_assign_regs + _emit_arm64_stmt is skipped → byte-identical.
fn _arm_pack_escaping_enabled() -> bool {
    return env("HEXA_PACK_ESCAPING") != "0"
}

// O(1) id → MIR type_id probe (0 = absent/unclassified). Empty `[]` when OFF.
fn _arm_local_type(rm: RegMap, id: i64) -> i64 {
    if id < 0 || id >= len(rm.local_type) { return 0 }
    return rm.local_type[id]
}

// Should op on operand `o` take the escaping-poly path? Gate ON + `o` is a
// PROVABLY typed-prim array container (MIR type_id 101..102 → HexaArrI64). i64/i32
// only for r1 (the runtime poly readers cover HexaArrI64). Globals are a separate
// id space → conservatively boxed. Mirror of _x86_operand_pack_esc.
fn _arm_operand_pack_esc(o: Operand, rm: RegMap) -> bool {
    if !_arm_pack_escaping_enabled() { return false }
    if o.kind != "local" { return false }
    let t = _arm_local_type(rm, o.local_id)
    return t == 101 || t == 102
}

// id → should this array_lit STORAGE esc-mint (TAG_ARRAY_I64)? O(1) probe of the
// lattice the regmap builder fills (empty/false when OFF). Mirror of
// _x86_local_esc_mint.
fn _arm_local_esc_mint(rm: RegMap, id: i64) -> bool {
    if !_arm_pack_escaping_enabled() { return false }
    if id < 0 || id >= len(rm.local_packed_esc_ok) { return false }
    return rm.local_packed_esc_ok[id] == 1
}

fn _arm_compute_live_ranges(mf: MFunc) -> ArmIntervals {
    let mut ids: [i64] = []
    let mut starts: [i64] = []
    let mut ends: [i64] = []

    // #3712 (arm64 port) — O(1) id→slot membership for the live-range build.
    // Local ids are dense non-negative ints (hir_to_mir `next_local` counter),
    // so a direct-indexed `id2slot[id]` array (sized maxid+1, -1 = absent)
    // replaces the `_arm_index_of` probe whose ids[id]==id fast path missed
    // any out-of-order id (falling back to the O(len(ids)) scan → O(locals²)).
    // Byte-eq NEUTRAL: `ids` keeps the exact first-occurrence order (push
    // sites unchanged) — only the probe gets faster.
    let maxid = _arm_max_local_id(mf)
    let mut id2slot: [i64] = []
    let mut zi = 0
    while zi <= maxid { id2slot.push(-1); zi = zi + 1 }

    let mut li = 0
    while li < len(mf.locals) {
        let id = mf.locals[li].id
        if id >= 0 && id2slot[id] < 0 {
            id2slot[id] = len(ids)
            ids.push(id)
            starts.push(-1)
            ends.push(-1)
        }
        li = li + 1
    }

    let mut pi = 0
    while pi < len(mf.params) {
        let pid = mf.params[pi].id
        let idx = if pid >= 0 && pid <= maxid { id2slot[pid] } else { -1 }
        if idx >= 0 {
            if starts[idx] < 0 { starts[idx] = 0 }
            if ends[idx] < 0   { ends[idx] = 0 }
        }
        pi = pi + 1
    }

    let mut pos = 0
    let mut bi = 0
    while bi < len(mf.blocks) {
        let blk = mf.blocks[bi]
        let mut si = 0
        while si < len(blk.stmts) {
            let s = blk.stmts[si]
            let did = s.dst.id
            if did >= 0 {
                let mut idx = id2slot[did]
                if idx < 0 {
                    idx = len(ids)
                    id2slot[did] = idx
                    ids.push(did)
                    starts.push(pos)
                    ends.push(pos)
                } else {
                    if starts[idx] < 0 || pos < starts[idx] { starts[idx] = pos }
                    if pos > ends[idx] { ends[idx] = pos }
                }
            }
            let mut ai = 0
            while ai < len(s.args) {
                let o = s.args[ai]
                if o.kind == "local" {
                    let lid = o.local_id
                    if lid >= 0 {
                        let mut idx2 = id2slot[lid]
                        if idx2 < 0 {
                            idx2 = len(ids)
                            id2slot[lid] = idx2
                            ids.push(lid)
                            starts.push(pos)
                            ends.push(pos)
                        } else {
                            if starts[idx2] < 0 || pos < starts[idx2] {
                                starts[idx2] = pos
                            }
                            if pos > ends[idx2] { ends[idx2] = pos }
                        }
                    }
                }
                ai = ai + 1
            }
            pos = pos + 1
            si = si + 1
        }
        bi = bi + 1
    }
    return ArmIntervals { ids: ids, starts: starts, ends: ends }
}

fn _arm64_assign_regs(mf: MFunc) -> ArmAllocResult {
    let iv = _arm_compute_live_ranges(mf)
    let n = len(iv.ids)
    let mut order: [i64] = []
    let mut k = 0
    while k < n {
        if iv.starts[k] >= 0 { order.push(k) }
        k = k + 1
    }
    // Self-host perf — sort `order` ascending by `iv.starts`. The prior
    // insertion sort was O(order²); on a large function (e.g. the 1209-
    // line _lower_hexpr in the compiler's own lower pass) order grows to
    // thousands of intervals, so O(N²) here is the dominant cost of a
    // multi-minute stage-1 self-compile. `iv.starts` values are `pos`
    // indices — dense, non-negative, bounded by the instruction count —
    // so a counting sort is O(N + maxStart) and STABLE (preserves the
    // first-seen order of equal-start intervals, identical to the strict-
    // `>` insertion sort it replaces). [@cite alg/sort/counting-sort]
    let mut max_start = 0
    let mut ms = 0
    while ms < len(order) {
        let sv = iv.starts[order[ms]]
        if sv > max_start { max_start = sv }
        ms = ms + 1
    }
    let mut cnt: [i64] = []
    let mut ci = 0
    while ci <= max_start {
        cnt.push(0)
        ci = ci + 1
    }
    let mut cp = 0
    while cp < len(order) {
        let sv2 = iv.starts[order[cp]]
        cnt[sv2] = cnt[sv2] + 1
        cp = cp + 1
    }
    // prefix sum → bucket start offsets
    let mut acc = 0
    let mut cp2 = 0
    while cp2 <= max_start {
        let c = cnt[cp2]
        cnt[cp2] = acc
        acc = acc + c
        cp2 = cp2 + 1
    }
    let mut sorted: [i64] = []
    let mut sp = 0
    while sp < len(order) {
        sorted.push(0)
        sp = sp + 1
    }
    let mut cp3 = 0
    while cp3 < len(order) {
        let elem = order[cp3]
        let sv3 = iv.starts[elem]
        sorted[cnt[sv3]] = elem
        cnt[sv3] = cnt[sv3] + 1
        cp3 = cp3 + 1
    }
    order = sorted

    let mut map_ids: [i64] = []
    let mut map_regs: [string] = []
    let mut map_slots: [i64] = []
    let mut j = 0
    while j < n {
        map_ids.push(iv.ids[j])
        map_regs.push("")
        map_slots.push(-1)
        j = j + 1
    }

    let mut p = 0
    while p < len(mf.params) {
        if p < 8 {
            let pid = mf.params[p].id
            let idx = _arm_index_of(iv.ids, pid)
            if idx >= 0 {
                map_regs[idx] = "x" + to_string(p)
            }
        }
        p = p + 1
    }

    let mut pool = _arm_pool_init()
    let mut active_idx: [i64] = []
    let mut next_slot: i64 = 0

    // Self-host perf — precompute `is_param[k]` (k = interval index)
    // once. The expire/spill loops below test "is this interval a
    // param" per active interval per `order` step; the inline
    // `while pp < len(mf.params)` scan made that O(order·active·P).
    // One O(N + params) pre-pass collapses it to an O(1) array read.
    // [@cite alg/regalloc/linear-scan]
    let mut is_param: [i64] = []
    let mut ip = 0
    while ip < n {
        is_param.push(0)
        ip = ip + 1
    }
    let mut ipp = 0
    while ipp < len(mf.params) {
        let pidx = _arm_index_of(iv.ids, mf.params[ipp].id)
        if pidx >= 0 { is_param[pidx] = 1 }
        ipp = ipp + 1
    }

    // try/catch fix (native setjmp correctness) — darwin hxlcl_longjmp restores
    // the callee-saved pool (x19-x28); a value homed there and written inside a
    // try body rolls back on the catch path (torn {tag,payload}). A try-
    // containing fn goes ALL-SPILL (memory survives longjmp); try-free fns keep
    // the pool → byte-identical. Mirrors x86_64_linux _sj_all_spill.
    let _sj_all_spill = _arm64_count_try_setjmp(mf) > 0
    let mut s = 0
    while s < len(order) {
        let cur = order[s]
        let cur_start = iv.starts[cur]

        let mut keep: [i64] = []
        let mut e = 0
        while e < len(active_idx) {
            let ai = active_idx[e]
            if iv.ends[ai] < cur_start {
                let was = map_regs[ai]
                if is_param[ai] == 0 && len(was) > 0 && map_slots[ai] < 0 {
                    pool.push(was)
                }
            } else {
                keep.push(ai)
            }
            e = e + 1
        }
        active_idx = keep

        if len(map_regs[cur]) > 0 {
            let cur_end = iv.ends[cur]
            let mut na: [i64] = []
            let mut placed = false
            let mut t = 0
            while t < len(active_idx) {
                if !placed && iv.ends[active_idx[t]] > cur_end {
                    na.push(cur)
                    placed = true
                }
                na.push(active_idx[t])
                t = t + 1
            }
            if !placed { na.push(cur) }
            active_idx = na
            s = s + 1
            continue
        }

        if len(pool) > 0 && !_sj_all_spill {
            let r = pool[0]
            let mut np: [string] = []
            let mut tt = 1
            while tt < len(pool) {
                np.push(pool[tt])
                tt = tt + 1
            }
            pool = np
            map_regs[cur] = r
            map_slots[cur] = -1
            let cur_end = iv.ends[cur]
            let mut na: [i64] = []
            let mut placed = false
            let mut t = 0
            while t < len(active_idx) {
                if !placed && iv.ends[active_idx[t]] > cur_end {
                    na.push(cur)
                    placed = true
                }
                na.push(active_idx[t])
                t = t + 1
            }
            if !placed { na.push(cur) }
            active_idx = na
        } else {
            let mut victim_pos = len(active_idx) - 1
            while victim_pos >= 0 {
                let v = active_idx[victim_pos]
                if is_param[v] == 0 { break }
                victim_pos = victim_pos - 1
            }

            if victim_pos >= 0 && iv.ends[active_idx[victim_pos]] > iv.ends[cur] && !_sj_all_spill {
                let v = active_idx[victim_pos]
                map_regs[cur] = map_regs[v]
                map_slots[cur] = -1
                map_regs[v] = ""
                map_slots[v] = next_slot
                // HexaVal is a 16-byte (tag+union) pair stored via
                // stp/ldp — a spill slot MUST be 16B. The victim-spill
                // path advanced next_slot by only 8, so every slot
                // allocated after a victim-spill overlapped the high
                // 8 bytes of its predecessor. With enough spills the
                // offsets wrapped and aliased low-frame slots: a 24-
                // element [Node] array literal stored element 7+ into
                // slots that collided with early temps, so NODES[7..]
                // read garbage (TAG_MAP with junk map_ptr) → SIGSEGV
                // in hexa_map_get. Matches the +16 used at the other
                // two slot-allocation sites (lines ~448, ~468).
                next_slot = next_slot + 16
                let mut na: [i64] = []
                let mut t = 0
                while t < len(active_idx) {
                    if t != victim_pos { na.push(active_idx[t]) }
                    t = t + 1
                }
                let cur_end = iv.ends[cur]
                let mut na2: [i64] = []
                let mut placed = false
                let mut tt = 0
                while tt < len(na) {
                    if !placed && iv.ends[na[tt]] > cur_end {
                        na2.push(cur)
                        placed = true
                    }
                    na2.push(na[tt])
                    tt = tt + 1
                }
                if !placed { na2.push(cur) }
                active_idx = na2
            } else {
                map_regs[cur] = ""
                map_slots[cur] = next_slot
                next_slot = next_slot + 16  // Path A S1: HexaVal is 16B (tag+union); spill slots are HexaVal-sized. Single-reg str/ldr into the low 8B is harmless until S2 pair-stores the high half.
            }
        }
        s = s + 1
    }

    let mut frame = next_slot
    let rem = frame - (frame / 16) * 16
    if rem != 0 { frame = frame + (16 - rem) }

    // Path A (A′): HexaVal is a 16-byte struct (x0:x1 AAPCS64 pair) —
    // a single register cannot hold one. Force EVERY value memory-
    // resident in a 16B slot (no register residency); the emitter
    // ldp/stp's the pair around each use. This mirrors the proven
    // codegen_c2 memory-resident value model and avoids a pair-aware
    // register allocator. Slower but ABI-correct (optimise post-stage-3).
    let mut fi = 0
    while fi < len(map_ids) {
        if map_slots[fi] < 0 {
            map_slots[fi] = next_slot
            next_slot = next_slot + 16
        }
        map_regs[fi] = ""
        fi = fi + 1
    }
    let mut frame2 = next_slot
    let rem2 = frame2 - (frame2 / 16) * 16
    if rem2 != 0 { frame2 = frame2 + (16 - rem2) }
    frame = frame2

    // #3712 (arm64 port) — build the O(1) id→index array from the final
    // `map_ids` order (mirror of x86_64's rm_id2idx builder). Every
    // per-operand lookup returns the identical slot the `_arm_index_of`
    // scan would (same first-occurrence order) — byte-eq NEUTRAL.
    let mut rm_maxid: i64 = -1
    let mut mj = 0
    while mj < len(map_ids) {
        if map_ids[mj] > rm_maxid { rm_maxid = map_ids[mj] }
        mj = mj + 1
    }
    let mut rm_id2idx: [i64] = []
    let mut zj = 0
    while zj <= rm_maxid { rm_id2idx.push(-1); zj = zj + 1 }
    let mut mk = 0
    while mk < len(map_ids) {
        if map_ids[mk] >= 0 { rm_id2idx[map_ids[mk]] = mk }
        mk = mk + 1
    }

    // ── FLEET arm64 element-pack (HEXA_PACK_ESCAPING) — type + esc-mint lattice ──
    // Mirror of x86_64_linux.hexa's rm_local_type + rm_packed_esc_ok builders
    // (#4143/#4151). The arm64 backend had NO per-local type tracking, so the
    // hir_to_mir element-kind stamp (type_id 101/102, already PLATFORM-AGNOSTIC —
    // gated on HEXA_PACK_ESCAPING since #4151) reached this backend unread. We now
    // read it into `rm_local_type` (id → MIR Local.type_id) and derive the esc-mint
    // storage lattice `rm_packed_esc_ok`. Built ONLY when `_arm_pack_escaping_enabled()`
    // → OFF leaves BOTH `[]` (never consulted by the emit boundaries) → byte-identical.
    let mut rm_local_type: [i64] = []
    let mut rm_packed_esc_ok: [i64] = []
    if _arm_pack_escaping_enabled() {
        let at_maxid = _arm_max_local_id(mf)
        let mut a0 = 0
        while a0 <= at_maxid { rm_local_type.push(0); rm_packed_esc_ok.push(0); a0 = a0 + 1 }
        // type-id from MIR locals + params (key: container 101/102 typed-prim).
        let mut ali = 0
        while ali < len(mf.locals) {
            let lid = mf.locals[ali].id
            if lid >= 0 && lid <= at_maxid { rm_local_type[lid] = mf.locals[ali].type_id }
            ali = ali + 1
        }
        let mut api = 0
        while api < len(mf.params) {
            let pid = mf.params[api].id
            if pid >= 0 && pid <= at_maxid { rm_local_type[pid] = mf.params[api].type_id }
            api = api + 1
        }
        // Pass 1: collect array_lit dst ids (storage T candidates); a DIRECT typed
        // literal storage (X==T, T already 101/102) esc-mints immediately.
        let mut a_is_alit: [i64] = []
        let mut az = 0
        while az <= at_maxid { a_is_alit.push(0); az = az + 1 }
        let mut ab = 0
        while ab < len(mf.blocks) {
            let ablk = mf.blocks[ab]
            let mut asx = 0
            while asx < len(ablk.stmts) {
                let ast = ablk.stmts[asx]
                if ast.kind == _STMT_ASSIGN && ast.op == "array_lit" {
                    let ad = ast.dst.id
                    if ad >= 0 && ad <= at_maxid {
                        a_is_alit[ad] = 1
                        let atd = rm_local_type[ad]
                        if atd == 101 || atd == 102 { rm_packed_esc_ok[ad] = 1 }
                    }
                }
                asx = asx + 1
            }
            ab = ab + 1
        }
        // Pass 2: a typed (101/102) `let X = T` where T is an array_lit storage
        // propagates the typed element-kind back to T → esc-mint T.
        let mut ab2 = 0
        while ab2 < len(mf.blocks) {
            let ablk2 = mf.blocks[ab2]
            let mut as2 = 0
            while as2 < len(ablk2.stmts) {
                let ast2 = ablk2.stmts[as2]
                if ast2.kind == _STMT_ASSIGN && ast2.op == "let" && len(ast2.args) >= 1 &&
                   ast2.args[0].kind == "local" {
                    let ax = ast2.dst.id
                    let asrc = ast2.args[0].local_id
                    let axt = if ax >= 0 && ax <= at_maxid { rm_local_type[ax] } else { 0 }
                    if (axt == 101 || axt == 102) && asrc >= 0 && asrc <= at_maxid &&
                       a_is_alit[asrc] == 1 {
                        rm_packed_esc_ok[asrc] = 1
                    }
                }
                as2 = as2 + 1
            }
            ab2 = ab2 + 1
        }
    }

    let map = RegMap {
        ids: map_ids,
        regs: map_regs,
        slots: map_slots,
        call_overflow_bytes: 0,   // filled in by _arm64_lower_func once max-overflow is known
        id2idx: rm_id2idx,
        local_type: rm_local_type,
        local_packed_esc_ok: rm_packed_esc_ok
    }
    return ArmAllocResult { map: map, frame_size: frame }
}

// #3712 (arm64 port) — O(1) RegMap probe: id → index-into-`ids` (-1 =
// absent/out-of-range). Replaces the `_arm_index_of(rm.ids, id)` probe
// (O(len(ids)) linear scan whenever the ids[id]==id fast path misses) at
// the per-operand codegen lookups. Returns the identical slot the scan
// would (built from the same `ids` order) → byte-eq NEUTRAL.
fn _arm_rm_idx(rm: RegMap, id: i64) -> i64 {
    if id < 0 || id >= len(rm.id2idx) { return -1 }
    return rm.id2idx[id]
}

fn _arm_reg_lookup(rm: RegMap, id: i64) -> string {
    let idx = _arm_rm_idx(rm, id)
    if idx < 0 { return _arm64_reg_for_local(id) }
    if rm.slots[idx] >= 0 { return "x9" }
    if len(rm.regs[idx]) == 0 { return _arm64_reg_for_local(id) }
    return rm.regs[idx]
}

fn _arm_is_spilled(rm: RegMap, id: i64) -> bool {
    let idx = _arm_rm_idx(rm, id)
    if idx < 0 { return false }
    return rm.slots[idx] >= 0
}

fn _arm_spill_offset(rm: RegMap, id: i64) -> i64 {
    let idx = _arm_rm_idx(rm, id)
    if idx < 0 { return rm.call_overflow_bytes }
    return rm.slots[idx] + rm.call_overflow_bytes
}

// String literal → rodata label map. `keys[i]` is a literal string
// (the const_str payload); `labels[i]` is the assigned ".LCstrN"
// label (without the platform underscore prefix). Built once per
// module before func lowering and threaded into every operand
// resolution. `pub` is required because stage0 cannot resolve struct
// field types across imports without it.
pub struct ArmStrTab {
    keys: [string],
    labels: [string],
    // Parallel float-literal pool (const_float Operand → `.LCfltN`).
    // `fkeys` is the parsed f64 (used for de-dup); `flabels` is the
    // emitted `.LCfltN` symbol; `ftexts` is the literal's source
    // text ("0.15415067982725836"). Emit goes through the assembler's
    // `.double <text>` so we sidestep the stage0 lack of a double→
    // bits bitcast AND preserve full literal precision (stage0
    // `to_string(f64)` truncates to ~6 digits — losing ~3e-7 against
    // 17-digit reference literals — so we can't round-trip the
    // parsed f64 back through `to_string`).
    fkeys: [f64],
    flabels: [string],
    ftexts: [string],
    // PERF #4454-class (2026-07-03): 64-bucket FNV-1a hash index over
    // `keys` — same mechanism as self/codegen.hexa's
    // _strlit_idx_keys/_strlit_idx_ids (65b7d871e). _arm64_strtab_lookup
    // used to LINEAR-SCAN `keys` once per const_str operand, O(distinct²)
    // across a module. The index is LOOKUP-ONLY acceleration:
    // `keys`/`labels` stay the emission SSOT in first-occurrence order
    // (.LCstrN numbering unchanged) — emitted asm is byte-identical.
    // idx_keys[b]: keys whose _arm64_strtab_hash() == b
    // idx_labels[b]: parallel ".LCstrN" label for each
    idx_keys: [[string]],
    idx_labels: [[string]]
}

// FNV-1a 32-bit fold over the literal, reduced to 64 buckets. The
// `% 4294967296` keeps h inside 32 bits so the i64 multiply never
// overflows (h < 2^32 ⇒ h * 16777619 < 2^57). Index-only — the hash
// never reaches emitted output.
fn _arm64_strtab_hash(s: string) -> i64 {
    let mut h: i64 = 2166136261
    let mut i = 0
    let n = len(s)
    while i < n {
        h = (h ^ s.char_code_at(i)) * 16777619
        h = h % 4294967296
        i = i + 1
    }
    let mut b = h % 64
    if b < 0 { b = b + 64 }
    return b
}

fn _arm64_strtab_empty_buckets() -> [[string]] {
    let mut bs: [[string]] = []
    let mut i = 0
    while i < 64 {
        let empty: [string] = []
        bs.push(empty)
        i = i + 1
    }
    return bs
}

fn _arm64_float_lookup(st: ArmStrTab, v: f64) -> string {
    let mut i = 0
    while i < len(st.fkeys) {
        if st.fkeys[i] == v {
            let lab = st.flabels[i]
            return lab.substring(0, len(lab))
        }
        i = i + 1
    }
    return ""
}

fn _arm64_float_intern(st: ArmStrTab, v: f64, text: string) -> ArmStrTab {
    let existing = _arm64_float_lookup(st, v)
    if len(existing) > 0 { return st }
    let mut fk = st.fkeys
    let mut fl = st.flabels
    let mut ft = st.ftexts
    let label = ".LCflt" + to_string(len(fk))
    fk.push(v)
    fl.push(label)
    // Empty text falls back to `to_string(v)` at LModule build time.
    ft.push(text.substring(0, len(text)))
    return ArmStrTab {
        keys: st.keys, labels: st.labels,
        fkeys: fk, flabels: fl, ftexts: ft,
        idx_keys: st.idx_keys, idx_labels: st.idx_labels
    }
}


fn _arm64_strtab_lookup(st: ArmStrTab, s: string) -> string {
    // PERF #4454-class: bucket lookup replaces the full-table linear scan
    // when the hash index is primed (see idx_keys on the struct). Same
    // hit/miss result as the scan — buckets partition `keys` exactly.
    if len(st.idx_keys) == 64 {
        let b = _arm64_strtab_hash(s)
        let bucket = st.idx_keys[b]
        let blabels = st.idx_labels[b]
        let mut bi = 0
        while bi < len(bucket) {
            if bucket[bi] == s {
                // F6 P0b — forced copy (see below).
                let lab = blabels[bi]
                return lab.substring(0, len(lab))
            }
            bi = bi + 1
        }
        return ""
    }
    // Un-indexed strtab (e.g. the empty _arm64_op_for_operand fallback) —
    // keep the legacy linear scan.
    let mut i = 0
    while i < len(st.keys) {
        if st.keys[i] == s {
            // F6 P0b — forced copy: the LFunc operand built from this
            // label must not share st.labels' handle, or freeing the
            // LFunc would dangle st (st outlives every streaming
            // iteration). PLAN-stage3-footprint-F6.md.
            let lab = st.labels[i]
            return lab.substring(0, len(lab))
        }
        i = i + 1
    }
    return ""
}

fn _arm64_op_for_operand_st(o: Operand, st: ArmStrTab) -> LOperand {
    if o.kind == "local" {
        return _arm64_op_reg(_arm64_reg_for_local(o.local_id))
    }
    if o.kind == "const_int" {
        return _arm64_op_imm(o.int_val)
    }
    if o.kind == "const_bool" {
        return _arm64_op_imm(o.int_val)
    }
    if o.kind == "global" {
        return _arm64_op_label("g" + to_string(o.global_id))
    }
    if o.kind == "const_str" {
        // lbl is already a fresh copy (F6 P0b in _arm64_strtab_lookup).
        let lbl = _arm64_strtab_lookup(st, o.str_val)
        if len(lbl) > 0 { return _arm64_op_label(lbl) }
        // F6 P0d — strtab-miss fallback (should be unreachable, every
        // const_str is interned first): copy so the LFunc does not share
        // the MFunc operand's string. PLAN-stage3-footprint-F6.md.
        return _arm64_op_label(o.str_val.substring(0, len(o.str_val)))
    }
    // fallback: treat as imm 0
    return _arm64_op_imm(0)
}

// Backwards-compatible operand resolver — used where no strtab is
// available (e.g. trivial tests without string literals). Strings
// flow through unchanged (label = literal string), which only
// matters for modules that never produce a const_str operand.
fn _arm64_op_for_operand(o: Operand) -> LOperand {
    let st = ArmStrTab { keys: [], labels: [], fkeys: [], flabels: [], ftexts: [], idx_keys: [], idx_labels: [] }
    return _arm64_op_for_operand_st(o, st)
}

// ── Block label helper ───────────────────────────────────────
//
// Apple ARM64 uses `L<name>` as the conventional local-label form
// for compiler-generated labels within a function. We emit them with
// a leading `_` prefix so the asm-text emit pass leaves them alone
// (its `_fmt_label` skips labels that already begin with '.' or
// '_'). Without this, branch operand references would be re-prefixed
// to `__Lname` while the definition stays bare `Lname:`, breaking
// the branch.
// Stage1 C8 — modhash = first 4 hex of sha256(module.file).
// Disambiguates spliced modules sharing the same fn name.
fn _arm64_modhash(file: string) -> string {
    let h = sha256(file)
    if len(h) > 3 { return h.substring(0, 4) }
    return h
}

fn _arm64_block_label(modhash: string, fname: string, block_id: i64) -> string {
    return "_L" + modhash + "_" + fname + "_bb" + to_string(block_id)
}

// ── Binop classification ─────────────────────────────────────
//
// Lower (compiler/lower/hir_to_mir.hexa) carries the source-level
// operator text in `Stmt.op` (e.g. "+", "-", "*", "==", "<"). The
// older codegen path also accepted normalized aliases ("add",
// "sub", ...). We accept both. String concat is recognised as a
// dedicated `concat` op (or `+` over string operands once typed-MIR
// lands — until then, lower must emit `concat` explicitly for
// string + string).

fn _is_arith_add(op: string) -> bool { return op == "add" || op == "+" }
fn _is_arith_sub(op: string) -> bool { return op == "sub" || op == "-" }
fn _is_arith_mul(op: string) -> bool { return op == "mul" || op == "*" }
fn _is_arith_div(op: string) -> bool { return op == "div" || op == "/" }
fn _is_bit_and(op: string) -> bool   { return op == "and" || op == "&" }
fn _is_bit_or(op: string) -> bool    { return op == "or"  || op == "|" }
fn _is_bit_xor(op: string) -> bool   { return op == "xor" || op == "^" }
fn _is_concat(op: string) -> bool    { return op == "concat" }

// arm64 cset condition mnemonic for a source comparison op.
// Returns "" if not a comparison.
fn _arm64_cmp_cond(op: string) -> string {
    if op == "cmp_eq" || op == "==" { return "eq" }
    if op == "cmp_ne" || op == "!=" { return "ne" }
    if op == "cmp_lt" || op == "<"  { return "lt" }
    if op == "cmp_le" || op == "<=" { return "le" }
    if op == "cmp_gt" || op == ">"  { return "gt" }
    if op == "cmp_ge" || op == ">=" { return "ge" }
    return ""
}

// AAPCS64 integer arg sequence.
fn _arm64_arg_reg(idx: i64) -> string {
    if idx == 0 { return "x0" }
    if idx == 1 { return "x1" }
    if idx == 2 { return "x2" }
    if idx == 3 { return "x3" }
    if idx == 4 { return "x4" }
    if idx == 5 { return "x5" }
    if idx == 6 { return "x6" }
    if idx == 7 { return "x7" }
    return "x0" // overflow handled at call site via stack-spill (C7)
}

// C7 — scan all _STMT_CALL stmts in `mf` and return the maximum number
// of overflow args (args 5+) across all calls. The per-fn outgoing-call
// overflow region is sized once from this maximum and reused at every
// call site, so we don't sub/add sp mid-frame (which would invalidate
// sp-relative SSA spill offsets). NOTE: HexaVal arg ABI uses a register
// PAIR per arg (16B), so only 4 HexaVal args fit in x0..x7 — args 5+
// overflow to the caller's stack region (this matches the call-site
// emit at "C7: stack arg N"). Previously this used the C-int `n > 8`
// boundary and so missed every 5-args-or-more fn, sizing
// call_overflow_bytes to 0 and causing the outgoing arg 5 store at
// [sp, #0] to clobber the caller's own L0 / first param ingress slot
// (silently corrupted nested-array params across recursion — the
// "edges len 5 → 3 → 4" diagnostic from `_pf_tree_build`).
fn _arm64_max_call_overflow(mf: MFunc) -> i64 {
    let mut max_overflow = 0
    let mut bi = 0
    while bi < len(mf.blocks) {
        let blk = mf.blocks[bi]
        let mut si = 0
        while si < len(blk.stmts) {
            let s = blk.stmts[si]
            if s.kind == _STMT_CALL {
                let n = len(s.args)
                if n > 4 {
                    let overflow = n - 4
                    if overflow > max_overflow { max_overflow = overflow }
                }
            }
            // RFC closure C3 — indirect call: args[0] is the callee, the
            // remaining args[1..] are call arguments. The runtime env-first
            // ABI puts the env in pair 0, so the outgoing pair count is
            // 1 (env) + (len(args) - 1) call args = len(args). Pairs 5+
            // overflow to the caller stack region, same as STMT_CALL.
            if s.kind == _STMT_CALL_INDIRECT {
                let n = len(s.args)
                if n > 4 {
                    let overflow = n - 4
                    if overflow > max_overflow { max_overflow = overflow }
                }
            }
            si = si + 1
        }
        bi = bi + 1
    }
    return max_overflow
}

// Cycle h20 — try/catch jmp_buf region sizing.
// Each STMT_TRY_SETJMP in the function gets its own 192-byte jmp_buf
// slot in the function frame (Darwin arm64 jmp_buf is 192 bytes — see
// /usr/include/setjmp.h: 14*8 bytes for _JBLEN ints + 192-byte align).
// The slots live ABOVE the SSA-spill region: jmp_buf[i] is at
//   [sp, #(call_overflow_bytes + spill_frame + i * 192)]
// after `sub sp, total_frame`. Codegen walks STMT_TRY_SETJMP statements
// in iteration order and assigns slot indices monotonically.
let _ARM64_JMP_BUF_BYTES = 192
fn _arm64_count_try_setjmp(mf: MFunc) -> i64 {
    let mut n = 0
    let mut bi = 0
    while bi < len(mf.blocks) {
        let blk = mf.blocks[bi]
        let mut si = 0
        while si < len(blk.stmts) {
            if blk.stmts[si].kind == "try_setjmp" { n = n + 1 }
            si = si + 1
        }
        bi = bi + 1
    }
    return n
}

// ── Statement lowering (C6 — RegMap-aware) ───────────────────

fn _arm64_load_spill(buf: [LInstr], rm: RegMap, id: i64, scratch: string) -> [LInstr] {
    let mut out = buf
    let off = _arm_spill_offset(rm, id)
    out.push(_arm64_instr2("ldr", _arm64_op_reg(scratch), _arm64_op_mem("sp", off),
                     "reload L" + to_string(id) + " from spill slot"))
    return out
}

fn _arm64_store_spill(buf: [LInstr], rm: RegMap, id: i64, src_reg: string) -> [LInstr] {
    let mut out = buf
    let off = _arm_spill_offset(rm, id)
    out.push(_arm64_instr2("str", _arm64_op_reg(src_reg), _arm64_op_mem("sp", off),
                     "spill L" + to_string(id) + " to slot"))
    return out
}

// Build a >12-bit constant into `reg` via movz + up to 3 movk. ARM64
// cmp immediates are ≤12-bit and mov/movz ≤16-bit; enum/struct __tag
// values are djb2 _path_hash ints far exceeding that — they emitted as
// `cmp xN,#<hash>` / `mov xN,#<hash>` (1945+314 of the 2332 residual
// stage-1-.s assembler errors). Halfwords via /%65536 (callers gate on
// value>4095, always positive). `#h, lsl #N` is one #-prefixed label so
// emit/asm _fmt_label renders it verbatim (no platform prefix).
fn _arm64_emit_imm_to_reg(buf: [LInstr], reg: string, value: i64) -> [LInstr] {
    let mut out = buf
    let h0 = value % 65536
    let h1 = (value / 65536) % 65536
    let h2 = (value / 65536 / 65536) % 65536
    let h3 = (value / 65536 / 65536 / 65536) % 65536
    out.push(_arm64_instr2("movz", _arm64_op_reg(reg),
                     _arm64_op_label("#" + to_string(h0)), "imm 0-15"))
    if h1 != 0 {
        out.push(_arm64_instr2("movk", _arm64_op_reg(reg),
                     _arm64_op_label("#" + to_string(h1) + ", lsl #16"), "imm 16-31"))
    }
    if h2 != 0 {
        out.push(_arm64_instr2("movk", _arm64_op_reg(reg),
                     _arm64_op_label("#" + to_string(h2) + ", lsl #32"), "imm 32-47"))
    }
    if h3 != 0 {
        out.push(_arm64_instr2("movk", _arm64_op_reg(reg),
                     _arm64_op_label("#" + to_string(h3) + ", lsl #48"), "imm 48-63"))
    }
    return out
}

fn _arm64_op_rm(buf: [LInstr], o: Operand, st: ArmStrTab, rm: RegMap,
                scratch: string, opts: CodegenOptions) -> [LInstr] {
    let mut out = buf
    if o.kind == "local" {
        if _arm_is_spilled(rm, o.local_id) {
            out = _arm64_load_spill(out, rm, o.local_id, scratch)
        }
    }
    // Large const_int (e.g. _path_hash __tag) → movz/movk into scratch;
    // _arm64_op_resolve returns reg(scratch). Small (≤4095) stay
    // immediate (valid in cmp/add/mov — unchanged, no regression).
    if o.kind == "const_int" {
        if o.int_val > 4095 {
            out = _arm64_emit_imm_to_reg(out, scratch, o.int_val)
        }
    }
    // const_str / global → PC-relative address materialization. ARM64
    // cannot use a label as a bare mov/cmp operand; the address must be
    // built with adrp(@PAGE) + add(@PAGEOFF) into a register. Without
    // this every string/global ref emitted `mov xN,.LCstrM` /
    // `cmp xN,.LCstrM` — 3368 of the 3578 stage-1-.s assembler errors.
    // _arm64_op_resolve returns reg(scratch) for these (address built
    // here). Labels render verbatim via emit/asm _fmt_label.
    if o.kind == "const_str" {
        let cl = _arm64_strtab_lookup(st, o.str_val)
        let mut nm = cl
        if len(nm) == 0 { nm = o.str_val }
        out.push(_arm64_instr2("adrp", _arm64_op_reg(scratch),
                         _arm64_op_label(nm + "@PAGE"), "addr page: " + nm))
        out.push(_arm64_instr3("add", _arm64_op_reg(scratch),
                         _arm64_op_reg(scratch),
                         _arm64_op_label(nm + "@PAGEOFF"), "addr off: " + nm))
    }
    if o.kind == "global" {
        let gl = "g" + to_string(o.global_id)
        // RFC 070 G7-A.native impl emit (2026-05-20): in `--shared`
        // mode globals are extern-resolved through the GOT so that
        // `.dylib` text stays PIC and ld.so does not refuse it. The
        // baseline `adrp+@PAGE/add+@PAGEOFF` (PIE) sequence is kept
        // for `opts.shared == 0` so executable corpus output stays
        // byte-identical. The reloc-kind tag goes in `LInstr.comment`
        // suffix `[reloc=…]` so the asm-text emitter (next sub-cycle)
        // can dispatch on it without re-deriving the kind. Authority:
        //   - Mach-O: <mach-o/arm64/reloc.h> (ARM64_RELOC_GOT_LOAD_PAGE21
        //     / ARM64_RELOC_GOT_LOAD_PAGEOFF12).
        //   - ELF:    System V gABI §4 (R_AARCH64_ADR_GOT_PAGE /
        //     R_AARCH64_LD64_GOT_LO12_NC). Asm-text identical on both
        //     toolchains: `adrp Xn, sym@GOTPAGE` + `ldr Xn, [Xn, sym@GOTPAGEOFF]`.
        if opts.shared == 1 {
            out.push(_arm64_instr2("adrp", _arm64_op_reg(scratch),
                             _arm64_op_label(gl + "@GOTPAGE"),
                             "addr GOT page: " + gl + " [reloc=" + RELOC_AARCH64_ADR_GOT_PAGE + "]"))
            out.push(_arm64_instr2("ldr", _arm64_op_reg(scratch),
                             _arm64_op_mem_label(scratch, gl + "@GOTPAGEOFF"),
                             "addr GOT off: " + gl + " [reloc=" + RELOC_AARCH64_LD64_GOT_LO12_NC + "]"))
        } else {
            out.push(_arm64_instr2("adrp", _arm64_op_reg(scratch),
                             _arm64_op_label(gl + "@PAGE"), "addr page: " + gl))
            out.push(_arm64_instr3("add", _arm64_op_reg(scratch),
                             _arm64_op_reg(scratch),
                             _arm64_op_label(gl + "@PAGEOFF"), "addr off: " + gl))
        }
    }
    return out
}

fn _arm64_op_resolve(o: Operand, st: ArmStrTab, rm: RegMap,
                     scratch: string) -> LOperand {
    if o.kind == "local" {
        if _arm_is_spilled(rm, o.local_id) {
            return _arm64_op_reg(scratch)
        }
        return _arm64_op_reg(_arm_reg_lookup(rm, o.local_id))
    }
    if o.kind == "const_int" {
        // >4095 was movz/movk-materialized into scratch by _arm64_op_rm
        // (ARM64 cmp imm ≤12-bit); small values stay immediate.
        if o.int_val > 4095 { return _arm64_op_reg(scratch) }
        return _arm64_op_imm(o.int_val)
    }
    if o.kind == "const_bool" {
        // payload 0/1 — always immediate-representable.
        return _arm64_op_imm(o.int_val)
    }
    // global / const_str: address already materialized into `scratch`
    // by _arm64_op_rm (adrp+add). Return the register, not the label —
    // emitting the bare label is invalid ARM64.
    if o.kind == "global"    { return _arm64_op_reg(scratch) }
    if o.kind == "const_str" { return _arm64_op_reg(scratch) }
    return _arm64_op_imm(0)
}

fn _arm64_emit_dst_writeback(buf: [LInstr], rm: RegMap, id: i64) -> [LInstr] {
    let mut out = buf
    if _arm_is_spilled(rm, id) {
        out = _arm64_store_spill(out, rm, id, "x9")
    }
    return out
}

fn _arm64_dst_reg(rm: RegMap, id: i64) -> string {
    if _arm_is_spilled(rm, id) { return "x9" }
    return _arm_reg_lookup(rm, id)
}

// ── Path A (A′) 16-byte HexaVal value helpers ────────────────
// HexaVal occupies a register PAIR (lo = slot+0 = tag+pad, hi =
// slot+8 = union payload). Every value is memory-resident in a 16B
// frame slot (force-spilled in _arm_assign_regs). _hv_load brings a
// value into the (lo,hi) GP pair; _hv_store writes a (lo,hi) pair
// back to a value's slot. TAG_INT=0 TAG_BOOL=2 TAG_STR=3 (runtime.h).
fn _hv_mem(off: i64) -> LOperand {
    return _arm64_op_label("[sp, #" + to_string(off) + "]")
}

// ARM64 ldp/stp (64-bit pair) take a signed scaled imm7 offset: range
// [-512, +504] in steps of 8. Frame slots beyond that need the address
// materialized into a base register (x15 — outside the value-scratch
// x9-x14 and arg x0-x7 sets). Emits into `base`; returns the [base]
// mem operand for offsets out of range, else [sp,#off].
fn _hv_at(buf: [LInstr], off: i64, base: string) -> [LInstr] {
    let mut out = buf
    if off >= 0 && off <= 504 { return out }
    if off <= 4095 {
        out.push(_arm64_instr3("add", _arm64_op_reg(base), _arm64_op_reg("sp"),
                         _arm64_op_label("#" + to_string(off)), "hv frame base"))
    } else {
        out = _arm64_emit_imm_to_reg(out, base, off)
        out.push(_arm64_instr3("add", _arm64_op_reg(base), _arm64_op_reg("sp"),
                         _arm64_op_reg(base), "hv frame base (big)"))
    }
    return out
}

fn _hv_memb(off: i64, base: string) -> LOperand {
    if off >= 0 && off <= 504 { return _arm64_op_label("[sp, #" + to_string(off) + "]") }
    return _arm64_op_label("[" + base + "]")
}

// sp += / -= amount. ARM64 add/sub immediate is ≤4095 (opt. <<12);
// 16B-slot frames exceed that → materialize the amount into `scr`
// (movz/movk) and use the register form. `scr` (x15) is free at
// prologue entry and at epilogue (return value lives in x0:x1).
fn _hv_sp_adj(buf: [LInstr], mnem: string, amount: i64, scr: string) -> [LInstr] {
    let mut out = buf
    if amount <= 4095 {
        out.push(_arm64_instr3(mnem, _arm64_op_reg("sp"), _arm64_op_reg("sp"),
                         _arm64_op_label("#" + to_string(amount)), "sp adj"))
        return out
    }
    out = _arm64_emit_imm_to_reg(out, scr, amount)
    out.push(_arm64_instr3(mnem, _arm64_op_reg("sp"), _arm64_op_reg("sp"),
                     _arm64_op_reg(scr), "sp adj (big frame)"))
    return out
}

fn _hv_load(buf: [LInstr], o: Operand, st: ArmStrTab, rm: RegMap,
            lo: string, hi: string) -> [LInstr] {
    let mut out = buf
    if o.kind == "local" {
        let off = _arm_spill_offset(rm, o.local_id)
        out = _hv_at(out, off, "x15")
        out.push(_arm64_instr3("ldp", _arm64_op_reg(lo), _arm64_op_reg(hi),
                         _hv_memb(off, "x15"), "hv load L" + to_string(o.local_id)))
        return out
    }
    if o.kind == "const_int" {
        out.push(_arm64_instr2("movz", _arm64_op_reg(lo),
                         _arm64_op_label("#0"), "hv const_int: TAG_INT"))
        if o.int_val >= 0 && o.int_val <= 65535 {
            out.push(_arm64_instr2("movz", _arm64_op_reg(hi),
                             _arm64_op_label("#" + to_string(o.int_val)), "hv const_int val"))
        } else if o.int_val > 65535 {
            out = _arm64_emit_imm_to_reg(out, hi, o.int_val)
        } else {
            // negative: build |n|-1 then mvn (two's complement)
            out = _arm64_emit_imm_to_reg(out, hi, (0 - o.int_val) - 1)
            out.push(_arm64_instr2("mvn", _arm64_op_reg(hi), _arm64_op_reg(hi),
                             "hv const_int: negate"))
        }
        return out
    }
    if o.kind == "const_void" {
        // `nil` literal — TAG_VOID=4, payload 0. Pairs with the
        // _const_void_op() constructor in compiler/lower/hir_to_mir.hexa.
        out.push(_arm64_instr2("movz", _arm64_op_reg(lo),
                         _arm64_op_label("#4"), "hv const_void: TAG_VOID"))
        out.push(_arm64_instr2("movz", _arm64_op_reg(hi),
                         _arm64_op_label("#0"), "hv const_void payload"))
        return out
    }
    if o.kind == "const_bool" {
        // `true`/`false` literal — TAG_BOOL=2, payload 0/1. literal_bool
        // used to lower to const_int (TAG_INT), so a literal bool never
        // compared equal under hexa_eq to the TAG_BOOL produced by
        // `==` / `!=` / a comparison (hexa_eq returns false on tag
        // mismatch). Mirrors codegen_c2.hexa `true` -> hexa_bool(1).
        out.push(_arm64_instr2("movz", _arm64_op_reg(lo),
                         _arm64_op_label("#2"), "hv const_bool: TAG_BOOL"))
        out.push(_arm64_instr2("movz", _arm64_op_reg(hi),
                         _arm64_op_label("#" + to_string(o.int_val)), "hv const_bool payload"))
        return out
    }
    if o.kind == "const_str" {
        let cl = _arm64_strtab_lookup(st, o.str_val)
        let mut nm = cl
        if len(nm) == 0 { nm = o.str_val }
        out.push(_arm64_instr2("movz", _arm64_op_reg(lo),
                         _arm64_op_label("#3"), "hv const_str: TAG_STR"))
        out.push(_arm64_instr2("adrp", _arm64_op_reg(hi),
                         _arm64_op_label(nm + "@PAGE"), "hv str ptr page"))
        out.push(_arm64_instr3("add", _arm64_op_reg(hi), _arm64_op_reg(hi),
                         _arm64_op_label(nm + "@PAGEOFF"), "hv str ptr off"))
        return out
    }
    if o.kind == "const_float" {
        // TAG_FLOAT = 1 (see self/runtime.h `enum { TAG_INT=0, TAG_FLOAT, … }`).
        // Pool: `.LCfltN: .double <text>` emitted in rodata; here we
        // load that 8-byte IEEE-754 value into `hi` and stash the tag
        // in `lo`. Uses x14 as scratch so we don't clash with the
        // x15 scratch used by spill/slot moves.
        let lab = _arm64_float_lookup(st, o.float_val)
        out.push(_arm64_instr2("movz", _arm64_op_reg(lo),
                         _arm64_op_label("#1"), "hv const_float: TAG_FLOAT"))
        out.push(_arm64_instr2("adrp", _arm64_op_reg("x14"),
                         _arm64_op_label(lab + "@PAGE"), "hv float pool page"))
        out.push(_arm64_instr3("add", _arm64_op_reg("x14"), _arm64_op_reg("x14"),
                         _arm64_op_label(lab + "@PAGEOFF"), "hv float pool off"))
        out.push(_arm64_instr2("ldr", _arm64_op_reg(hi),
                         _arm64_op_label("[x14]"), "hv load f64 bits " + lab))
        return out
    }
    if o.kind == "global" {
        let gl = "g" + to_string(o.global_id)
        out.push(_arm64_instr2("adrp", _arm64_op_reg(lo),
                         _arm64_op_label(gl + "@PAGE"), "hv global page"))
        out.push(_arm64_instr3("add", _arm64_op_reg(lo), _arm64_op_reg(lo),
                         _arm64_op_label(gl + "@PAGEOFF"), "hv global off"))
        out.push(_arm64_instr3("ldp", _arm64_op_reg(lo), _arm64_op_reg(hi),
                         _arm64_op_label("[" + lo + "]"), "hv load global " + gl))
        return out
    }
    // unknown → void (TAG_VOID=4, payload 0)
    out.push(_arm64_instr2("movz", _arm64_op_reg(lo), _arm64_op_label("#4"), "hv void"))
    out.push(_arm64_instr2("movz", _arm64_op_reg(hi), _arm64_op_label("#0"), "hv void"))
    return out
}

fn _hv_store(buf: [LInstr], rm: RegMap, id: i64, lo: string, hi: string) -> [LInstr] {
    let mut out = buf
    if id < 0 { return out }
    let off = _arm_spill_offset(rm, id)
    out = _hv_at(out, off, "x15")
    out.push(_arm64_instr3("stp", _arm64_op_reg(lo), _arm64_op_reg(hi),
                     _hv_memb(off, "x15"), "hv store L" + to_string(id)))
    return out
}

// Dispatch by dst: arena_id == -999 marks a module-level mutable
// global (hir_to_mir _lower_hexpr "assign" branch sentinel). Emits a
// PC-relative store into the `g<id>` data slot. Local-slot dsts fall
// through to the normal frame-spill path.
fn _hv_store_dst(buf: [LInstr], rm: RegMap, dst: Local, lo: string, hi: string) -> [LInstr] {
    if dst.arena_id == -999 {
        let mut out = buf
        let gl = "g" + to_string(dst.id)
        out.push(_arm64_instr2("adrp", _arm64_op_reg("x15"),
                         _arm64_op_label(gl + "@PAGE"), "hv global page (store)"))
        out.push(_arm64_instr3("add", _arm64_op_reg("x15"), _arm64_op_reg("x15"),
                         _arm64_op_label(gl + "@PAGEOFF"), "hv global off (store)"))
        out.push(_arm64_instr3("stp", _arm64_op_reg(lo), _arm64_op_reg(hi),
                         _arm64_op_label("[x15]"), "hv store global " + gl))
        return out
    }
    return _hv_store(buf, rm, dst.id, lo, hi)
}

// Load a const_str's raw char* (the .LCstr address) into `reg` — for
// the map ABI (hexa_map_set/get take `const char* key`, not HexaVal).
fn _hv_cstr(buf: [LInstr], o: Operand, st: ArmStrTab, reg: string) -> [LInstr] {
    let mut out = buf
    let cl = _arm64_strtab_lookup(st, o.str_val)
    let mut nm = cl
    if len(nm) == 0 { nm = o.str_val }
    out.push(_arm64_instr2("adrp", _arm64_op_reg(reg),
                     _arm64_op_label(nm + "@PAGE"), "cstr key page"))
    out.push(_arm64_instr3("add", _arm64_op_reg(reg), _arm64_op_reg(reg),
                     _arm64_op_label(nm + "@PAGEOFF"), "cstr key off"))
    return out
}

fn _hv_ldslot(buf: [LInstr], rm: RegMap, id: i64, lo: string, hi: string) -> [LInstr] {
    let mut out = buf
    let off = _arm_spill_offset(rm, id)
    out = _hv_at(out, off, "x15")
    out.push(_arm64_instr3("ldp", _arm64_op_reg(lo), _arm64_op_reg(hi),
                     _hv_memb(off, "x15"), "hv reload L" + to_string(id)))
    return out
}

// binop/compare → runtime symbol (codegen_c2-authoritative). "" =
// special-cased (!=, &&, ||, bitwise) by the BINOP emitter.
fn _hv_binop_sym(op: string) -> string {
    if op == "+"  || op == "add" { return "hexa_add_slow" }  // hexa_add is a runtime.h MACRO; the linkable fn is hexa_add_slow
    if op == "-"  || op == "sub" { return "hexa_sub" }
    if op == "*"  || op == "mul" { return "hexa_mul" }
    if op == "/"  || op == "div" || op == "sdiv" { return "hexa_div" }
    if op == "%"  || op == "mod" || op == "rem"  { return "hexa_mod" }
    if op == "==" || op == "eq"  || op == "cmp_eq" { return "hexa_eq" }
    if op == "<"  || op == "lt"  || op == "cmp_lt" { return "hexa_cmp_lt" }
    if op == ">"  || op == "gt"  || op == "cmp_gt" { return "hexa_cmp_gt" }
    if op == "<=" || op == "le"  || op == "cmp_le" { return "hexa_cmp_le" }
    if op == ">=" || op == "ge"  || op == "cmp_ge" { return "hexa_cmp_ge" }
    if op == "concat" { return "hexa_str_concat" }
    return ""
}

// Builtin call target → runtime ABI symbol. Only builtins whose
// runtime.c signature is verified `HexaVal X(HexaVal…)` (i.e. matches
// the new codegen's uniform-HexaVal register ABI, args x0-x7 / return
// x0) are mapped here — for those a pure symbol rename is ABI-correct
// (codegen_c2's hexa_int()/hexa_bool() wrappers are C-expression
// boxing artifacts, irrelevant at the register ABI). Builtins whose
// runtime fn returns int/void (len/contains/starts_with/has_key/
// println), needs cstring-arg conversion (has_key), or has no runtime
// symbol at all (is_alpha/is_alphanumeric — codegen_c2 inline-expands)
// are intentionally NOT mapped: they pass through unchanged (stay
// undefined → link still gated) rather than silently mis-run. That
// residual is the precisely-scoped final builtin-lowering sub-unit.
// Non-builtin (hexa user fn) names pass through → normal mangling.
pub fn _builtin_runtime_sym(name: string, nargs: i64) -> string {
    // HEXA-OWN L5 R1 — the `farr_*` flame/forge handle family (32 names). The
    // bind gate (`_bind_builtin_names`) was missing these, so S1 raised HX2001
    // and no farr program ever reached codegen; registering them there without
    // ALSO mapping them here would be strictly WORSE than the bug it fixed —
    // the mapping fallthrough emits the BARE name (`farr_zeros`), hexa_ld's
    // dyn-census misreads that as a libc-floor UND and routes it dynamic, so the
    // failure mode mutates from a loud compile-time HX2001 into a runtime
    // SIGBUS. The C-1 symcensus lint exists precisely to catch that skew and it
    // did (gate_union − mapped ⊇ these 32).
    //
    // Every symbol is mirrored 1:1 from the authoritative legacy registry
    // (self/codegen.hexa:9358+, `name == "farr_zeros"` → `hexa_farr_zeros(..)`)
    // — no name is invented. All 32 were then confirmed to EXIST as defined text
    // symbols in the real shipping runtime.a (`nm -g runtime.a` on aiden → `T
    // hexa_farr_*` for all 32, GPU-named ones included: they carry CPU host
    // fallbacks and are NOT CUDA-gated). Hence ZERO of them belong in
    // tool/symcensus_exempt.txt — an exemption would leave the SIGBUS in place
    // while painting the lint green.
    if name == "farr_zeros"        { return "hexa_farr_zeros" }
    if name == "farr_set"          { return "hexa_farr_set" }
    if name == "farr_get"          { return "hexa_farr_get" }
    if name == "farr_len"          { return "hexa_farr_len" }
    if name == "farr_free"         { return "hexa_farr_free" }
    if name == "farr_copy"         { return "hexa_farr_copy" }
    if name == "farr_matmul"       { return "hexa_farr_matmul" }
    if name == "farr_to_bf16"      { return "hexa_farr_to_bf16" }
    if name == "farr_from_bf16"    { return "hexa_farr_from_bf16" }
    if name == "farr_int_zeros"    { return "hexa_farr_int_zeros" }
    if name == "farr_int_set"      { return "hexa_farr_int_set" }
    if name == "farr_int_get"      { return "hexa_farr_int_get" }
    if name == "farr_int_len"      { return "hexa_farr_int_len" }
    if name == "farr_int_free"     { return "hexa_farr_int_free" }
    if name == "farr_int_copy"     { return "hexa_farr_int_copy" }
    if name == "farr_int_sum"      { return "hexa_farr_int_sum" }
    if name == "farr_int_fill_from_array" { return "hexa_farr_int_fill_from_array" }
    if name == "farr32_zeros"      { return "hexa_farr32_zeros" }
    if name == "farr32_set"        { return "hexa_farr32_set" }
    if name == "farr32_get"        { return "hexa_farr32_get" }
    if name == "farr32_free"       { return "hexa_farr32_free" }
    if name == "farr32_matmul"     { return "hexa_farr32_matmul" }
    if name == "farr_add_gaussian_noise" { return "hexa_farr_add_gaussian_noise" }
    if name == "farr_apply_cnot"   { return "hexa_farr_apply_cnot" }
    if name == "farr_apply_single" { return "hexa_farr_apply_single" }
    if name == "farr_apply_single_farr" { return "hexa_farr_apply_single_farr" }
    if name == "farr_ce_seed"      { return "hexa_farr_ce_seed" }
    if name == "farr_ce_seed_gpu"  { return "hexa_farr_ce_seed_gpu" }
    if name == "farr_packed_gemv_offset" { return "hexa_farr_packed_gemv_offset" }
    if name == "farr_pauli_expectation_batch" { return "hexa_farr_pauli_expectation_batch" }
    if name == "farr_rope_gpu"     { return "hexa_farr_rope_gpu" }
    if name == "farr_rope_bwd_gpu" { return "hexa_farr_rope_bwd_gpu" }
    if name == "append_file"   { return "rt_append_file" }
    if name == "args"          { return "hexa_args" }
    // `argv` — native-backend alias for the same runtime accessor (mirrors the
    // gen2 C-path argv->hexa_args alias at self/codegen.hexa; runtime exports
    // hexa_args, not argv). Latent today (cli_args() is outside the cc-self-bin
    // graph — no _cli_args import in self/main.hexa) but this resolves the W3
    // asymmetry so a future refactor links clean. axis-③ RUN closeout.
    // (W4 `is_digit` is DELIBERATELY not mapped: no runtime hexa_is_digit def
    // exists, so a map would be a wrong-symbol miscompile; the C-2 own-link
    // tripwire is the correct net for it — all reachable callers have fn defs.)
    if name == "argv"          { return "hexa_args" }
    if name == "char_code_at"  { return "hexa_str_char_code_at" }
    if name == "char_code"     { return "hexa_char_code" }
    if name == "lgamma"        { return "hexa_math_lgamma" }
    if name == "env"           { return "hexa_env_var" }
    if name == "env_var"       { return "hexa_env_var" }
    // `now()` — interp alias for `timestamp()` (UNIX-millis). R5 triage.
    if name == "now"           { return "hexa_timestamp" }
    // `.find(needle)` method — generic substring/element search.
    // hir_to_mir lowers `recv.find(x)` to STMT_CALL op="find"
    // args=[recv,x]; runtime hexa_find_poly (runtime.c:7007) dispatches
    // on the receiver shape. R5 CGFAIL triage (repo_taxonomy_audit).
    if name == "find"          { return "hexa_find_poly" }
    if name == "file_size"     { return "rt_file_size" }
    if name == "chars"         { return "hexa_str_chars" }
    if name == "eprintln"      { return "hexa_eprintln" }
    if name == "exit"          { return "hexa_exit" }
    if name == "exec"          { return "hexa_exec" }
    if name == "file_exists"   { return "rt_file_exists" }
    if name == "path_exists"   { return "rt_path_exists" }
    // NOTE: index_of is handled by a dedicated arg-count-aware
    // STMT_CALL branch (string method -> hexa_str_index_of /
    // hexa_str_index_of_from, int-boxed). The old
    // hexa_array_index_of map returned -1 for every string
    // receiver -- a wrong-value miscompile that silently
    // flipped atlas-verifier predicates.
    if name == "join"          { return "hexa_str_join" }
    if name == "push"          { return "hexa_array_push" }
    if name == "push_nostat"   { return "hexa_array_push_nostat" }
    if name == "pop"           { return "hexa_array_pop" }
    // ── axis-③ symcensus part-1 (CONVERGENCE codegen-runtime-sym-mapping-1):
    // 60 array/string/map methods were unmapped → the `return name` fallthrough
    // (below) emitted a BARE symbol, which hexa_ld's dyn-census misfiled as a
    // libc-floor UND → ld.so failure at the self-emit cc-self-bin run. Each
    // target is the AUTHORITATIVE runtime symbol self/codegen.hexa's gen2
    // method-dispatch already emits (nm-verified in build/runtime.a), so the
    // generic STMT_CALL HexaVal pair-ABI emit lowers them verbatim. ADDITIVE:
    // these names had NO linkable def before (bare UND), so every existing-GREEN
    // byteeq artifact is byte-unchanged. This block is shared by BOTH backends
    // (x86_64_linux.hexa calls the same fn). See state/hexa-own/
    // axis3-symcensus-drain-design.md Rung A.
    //
    // A-1 pure rename (HexaVal-in / HexaVal-out, no ret-box) — 49
    if name == "all"           { return "hexa_array_all" }
    if name == "any"           { return "hexa_array_any" }
    if name == "append"        { return "hexa_array_push" }      // append = push alias (gen2 :6029)
    if name == "center"        { return "rt_str_center" }
    if name == "char_at"       { return "hexa_str_char_at" }
    if name == "chunk"         { return "hexa_array_chunk" }
    if name == "drop"          { return "hexa_array_drop" }
    if name == "entries"       { return "hexa_map_entries" }
    if name == "enumerate"     { return "hexa_array_enumerate" }
    if name == "fill"          { return "hexa_array_fill" }
    if name == "filter"        { return "hexa_array_filter" }
    if name == "filter_keys"   { return "hexa_map_filter_keys" }
    if name == "flat_map"      { return "hexa_array_flat_map" }
    if name == "flatten"       { return "hexa_array_flatten" }
    if name == "fold"          { return "hexa_array_fold" }
    if name == "for_each"      { return "hexa_array_for_each" }
    if name == "frequencies"   { return "hexa_array_frequencies" }
    if name == "from_array"    { return "hexa_map_from_array" }
    if name == "group_by"      { return "hexa_array_group_by" }
    if name == "interleave"    { return "hexa_array_interleave" }
    if name == "invert"        { return "hexa_map_invert" }
    if name == "is_empty"      { return "hexa_is_empty" }
    if name == "lines"         { return "rt_str_lines" }
    if name == "map"           { return "hexa_array_map" }
    if name == "mean"          { return "hexa_array_mean" }
    if name == "merge"         { return "hexa_map_merge" }        // map-only (no hexa_array_merge def; gen2 emits map)
    if name == "pad_end"       { return "rt_str_pad_right" }
    if name == "pad_start"     { return "rt_str_pad_left" }
    if name == "parse_float"   { return "hexa_str_parse_float" }
    if name == "partition"     { return "hexa_array_partition" }
    if name == "product"       { return "hexa_array_product" }
    if name == "repeat"        { return "rt_str_repeat" }
    if name == "reverse"       { return "hexa_array_reverse" }
    if name == "rotate"        { return "hexa_array_rotate" }
    if name == "sample"        { return "hexa_array_sample" }
    if name == "scan"          { return "hexa_array_scan" }
    if name == "shift"         { return "hexa_array_shift" }
    if name == "sort"          { return "hexa_array_sort" }
    if name == "sort_by"       { return "hexa_array_sort_by" }
    if name == "sum"           { return "hexa_sum" }             // hexa_sum, not hexa_array_sum (gen2 :6346)
    if name == "swap"          { return "hexa_array_swap" }
    if name == "take"          { return "hexa_array_take" }
    if name == "to_array"      { return "hexa_map_to_array" }    // map-only (no hexa_array_to_array def)
    if name == "trim_end"      { return "rt_str_trim_end" }
    if name == "trim_start"    { return "rt_str_trim_start" }
    if name == "unique"        { return "hexa_array_unique" }
    if name == "values"        { return "hexa_map_values" }
    if name == "window"        { return "hexa_array_window" }
    if name == "zip"           { return "hexa_array_zip" }
    // A-4 arity-branch — the ONLY rename-regressing pair. hir_to_mir merges
    // method + free calls into one STMT_CALL keyed on op text (recv is prepended
    // to arg_ops[0] for methods), so `nargs` is the sole discriminator: a
    // receiver method `.min()`/`.max()` has 1 arg → array reduction; a free
    // scalar `min(a,b)`/`max(a,b)` has 2 args → math. A rename-only map would
    // resolve free min(a,b) to hexa_array_min → a SILENT wrong-value miscompile
    // (link would succeed). Callers pass len(s.args).
    if name == "min"           { if nargs == 2 { return "hexa_math_min" } return "hexa_array_min" }
    if name == "max"           { if nargs == 2 { return "hexa_math_max" } return "hexa_array_max" }
    // A-2 ret-box — hexa_str_last_index_of returns raw int64 (runtime.c:3831);
    // `_builtin_ret_box` adds "int" so the callee's w0/rax is boxed to a HexaVal
    // (gen2 wraps with hexa_int() :6119).
    if name == "rfind"         { return "hexa_str_last_index_of" }
    if name == "last_index_of" { return "hexa_str_last_index_of" }
    // A-3 cstring-avoiding HexaVal shim — the direct runtime fns
    // (hexa_map_contains_key / hexa_map_remove) take a raw `const char*` 2nd arg,
    // so they cannot be reached by the generic HexaVal pair-ABI emit. Route to
    // the HexaVal-pure leaves instead (runtime unchanged): hexa_has_key_v (the
    // existing has_key target) and __map_remove_cstr_v (HexaVal(HexaVal,HexaVal)).
    if name == "contains_key"  { return "hexa_has_key_v" }
    if name == "has"           { return "hexa_has_key_v" }
    if name == "remove"        { return "__map_remove_cstr_v" }
    // A-5 optional-arg void-sentinel TARGETS. The runtime fns take a fixed arity
    // with a HexaVal void sentinel for the omitted trailing arg; the missing arg
    // is synthesised as a const-void operand in hir_to_mir's method-lowering
    // (once, at MIR level — both backends inherit it), so here we only map the
    // name. gen2: slice/slice_fast :6444-6453 · count :6204-6212 · substr :6401-6406.
    if name == "slice"         { return "hexa_array_slice" }
    if name == "slice_fast"    { return "hexa_array_slice_fast" }
    if name == "count"         { return "hexa_count_poly" }
    if name == "substr"        { return "hexa_str_substr" }
    if name == "read_file"     { return "rt_read_file" }
    if name == "replace"       { return "hexa_str_replace" }
    if name == "split"         { return "hexa_str_split" }
    if name == "substring"     { return "hexa_str_substring" }
    if name == "to_int"        { return "hexa_to_int" }
    if name == "to_float"      { return "hexa_to_float" }
    if name == "to_bool"       { return "hexa_to_bool" }
    if name == "to_string"     { return "hexa_to_string" }
    // `chr(N)` byte-level alias — same as `from_char_code` but with
    // raw byte semantics (codegen ABI: name & N & 0xff). The runtime
    // exports both `hexa_chr_byte` (this) and `hexa_from_char_code`
    // (round-trip UTF-8 of codepoint N). For aprime_cc's native path
    // we keep `chr` consistent with the self/* convention. Cycle 33.
    if name == "chr"           { return "hexa_chr_byte" }
    if name == "from_char_code" { return "hexa_from_char_code" }
    if name == "write_bytes"   { return "rt_write_bytes" }
    if name == "bytes"         { return "hexa_str_bytes" }
    // Cycle 34/35: `.truncate(n)` was unmapped → fallthrough returned
    // "truncate" → link resolved to libc's truncate(const char *path,
    // off_t length) → SIGBUS when hexa_array_push later memmove'd into
    // the array whose metadata was clobbered by the bogus path-write.
    // The fix is a single map entry; runtime exports `hexa_array_truncate`
    // (self/runtime.c:`hexa_array_truncate`). Confirms cycle 34's root-
    // cause crash stack: _patch_loop_sentinels → array.truncate(0) →
    // libc-truncate-with-garbage-path → metadata corrupt → next .push
    // memmove SIGBUS.
    if name == "truncate"      { return "hexa_array_truncate" }
    // Interp aliases (bind.hexa accepts them as known names; without
    // a runtime symbol map the link fails on `_str`/`_int`/etc.).
    // `str(x)` is interp's shorthand for `to_string(x)` (see
    // self/hexa_full.hexa: call_builtin "str" -> val_str(val_to_string(args[0]))).
    if name == "str"           { return "hexa_to_string" }
    if name == "int"           { return "hexa_to_int" }
    if name == "float"         { return "hexa_to_float" }
    if name == "bool"          { return "hexa_to_bool" }
    if name == "ln"            { return "hexa_log" }
    // map/dict accessors — runtime returns HexaVal of array (keys,
    // values, entries) or HexaVal scalar (count). All HexaVal-shape
    // so no ret-box needed. `dict_keys` is interp's anima-speak alias
    // for `map_keys` (see hexa_full.hexa § FIX-A); both map to the
    // same runtime fn name family.
    if name == "dict_keys"     { return "hexa_dict_keys" }
    if name == "map_keys"      { return "hexa_map_keys" }
    if name == "map_values"    { return "hexa_map_values" }
    if name == "map_entries"   { return "hexa_map_entries" }
    // math / formatting — HexaVal-in / HexaVal-out, no ret-box needed.
    // Each verified to exist in self/runtime.c before mapping (the
    // unmapped-is-safer-than-mis-mapped policy in this file's header
    // comment still holds for ret-box/cstring shapes that aren't here).
    if name == "abs"           { return "hexa_abs" }
    if name == "argmax"        { return "hexa_argmax" }
    if name == "bin"           { return "hexa_bin" }
    if name == "ceil"          { return "hexa_ceil" }
    if name == "clamp"         { return "hexa_clamp" }
    if name == "cos"           { return "hexa_cos" }
    if name == "exp"           { return "hexa_exp" }
    if name == "floor"         { return "hexa_floor" }
    if name == "format"        { return "hexa_format" }
    if name == "hex"           { return "hexa_hex" }
    if name == "log"           { return "hexa_log" }
    if name == "log2"          { return "hexa_log2" }
    if name == "log10"         { return "hexa_log10" }
    if name == "pad_left"      { return "hexa_pad_left" }
    if name == "pad_right"     { return "hexa_pad_right" }
    if name == "pow"           { return "hexa_pow" }
    if name == "random"        { return "hexa_random" }
    if name == "round"         { return "hexa_round" }
    if name == "sin"           { return "hexa_sin" }
    if name == "sleep"         { return "hexa_sleep" }
    if name == "sqrt"          { return "hexa_sqrt" }
    if name == "tan"           { return "hexa_tan" }
    if name == "tanh"          { return "hexa_tanh" }
    if name == "timestamp"     { return "hexa_timestamp" }
    if name == "utc_iso_now"   { return "hexa_utc_iso_now" }
    if name == "trim"          { return "rt_str_trim" }
    if name == "parse_int"     { return "hexa_str_parse_int" }  // r18 — free/method int-parse
    if name == "to_upper"      { return "rt_str_to_upper" }     // r18 — was unmapped
    if name == "to_lower"      { return "rt_str_to_lower" }     // r18 — was unmapped
    if name == "type_of"       { return "hexa_type_of" }
    if name == "typeof"        { return "hexa_type_of" }  // keyword-form alias of type_of
    if name == "write_file"    { return "rt_write_file" }
    if name == "sha256"        { return "hexa_sha256" }
    if name == "sha256_file"   { return "hexa_sha256_file" }
    // N5-sym class-B: native obj-emit left these intrinsics unmapped →
    // fell through to the bare name → undefined at self-host link (the
    // native compiler object references `_list_dir` while the runtime
    // exports `_hexa_list_dir`). All 5 are HexaVal-in/HexaVal-out with no
    // cstring/ret-box shape, so the generic STMT_CALL emit lowers them
    // verbatim (arg pairs → x0:x1…, bl, x0:x1 → dst) — same as the math
    // block above. Each target is the AUTHORITATIVE one self/codegen.hexa's
    // C-string path emits (byte_len→hexa_byte_len · bytes_to_str_raw→
    // hexa_bytes_to_str_raw · list_dir→hexa_list_dir · mono_ns→hexa_mono_ns ·
    // keys-method→hexa_map_keys) and is VERIFIED present in self/runtime.c.
    // `keys` lowers as a method STMT_CALL with the receiver as first arg
    // (cf. `find` → hexa_find_poly).
    if name == "byte_len"      { return "hexa_byte_len" }
    if name == "bytes_to_str_raw" { return "hexa_bytes_to_str_raw" }
    // RUNTIME-PORT B1 (STRBUILDER-FEAS, 2026-06-03): length-carrying byte→string
    // builder builtin. Same NUL-clean C constructor as bytes_to_str_raw.
    if name == "str_from_bytes_n" { return "hexa_bytes_to_str_raw" }
    if name == "list_dir"      { return "hexa_list_dir" }
    if name == "mono_ns"       { return "hexa_mono_ns" }
    if name == "keys"          { return "hexa_map_keys" }
    // N5-sym class-B2: the string `byte_at` also fell through to a bare name.
    // Its target hexa_str_byte_at(HexaVal s, HexaVal idx) (runtime_core.c:5393,
    // cg_string_sym:66 single branch) takes both args as raw HexaVal, so the
    // generic STMT_CALL emit (raw HexaVal pairs) is calling-convention-correct.
    // VERIFIED present in the runtime; the obj already references it from
    // correctly-lowered sites, so this collapses the bare ref onto an
    // already-resolved symbol (0 new symbols, 0 miscompile risk).
    if name == "byte_at"       { return "hexa_str_byte_at" }
    // N5-sym pt7: get/set → HexaVal-keyed runtime wrappers (hexa_map_get_v/set_v
    // apply hexa_to_cstring INTERNALLY — byte-eq with the C-path lowering of
    // m.get(k)/m.set(k,v); NOT __map_*_cstr_v which is HX_STR string-only and
    // would diverge on non-string keys. get=2-arg, set=3-arg, arities match.
    if name == "get"           { return "hexa_map_get_v" }
    if name == "set"           { return "hexa_map_set_v" }
    // N5-sym pt5: float_to_bits/bits_to_float/sha256_hex — authoritative C-path
    // targets with (HexaVal …)->HexaVal signature, 0 miscompile risk (like byte_at).
    if name == "float_to_bits" { return "hexa_float_to_bits" }
    if name == "bits_to_float" { return "hexa_bits_to_float" }
    if name == "sha256_hex"    { return "hexa_sha256" }
    // N5-sym pt8: mkdir → hexa_mkdir runtime wrapper (byte-eq with the C-path inline
    // hexa_bool(mkdir(HX_STR(p),0755)==0); bare mkdir collides with libc mkdir).
    if name == "mkdir"         { return "hexa_mkdir" }
    // N5-sym arr_alloc (.hexa-only): the flat compiler calls __arr_alloc_items_zero
    // {,_int}, which s4_flatc_post.py injects as `static` into the aprime build only
    // (invisible to the SEEDS runtime.a the native object links). Editing s4 is .py-
    // banned, so map to NEW external leaf fns hexa_arr_zeros_leaf{,_int} (added to
    // runtime_core_emit.hexa — verbatim s4 bodies, in runtime.a). New names → no
    // conflict with the s4 static in the aprime TU; byte-eq identical bodies.
    if name == "__arr_alloc_items_zero"     { return "hexa_arr_zeros_leaf" }
    if name == "__arr_alloc_items_zero_int" { return "hexa_arr_zeros_leaf_int" }
    // Low-level memory / pointer builtins — name -> runtime symbol.
    // Authoritative mapping mirrored from self/codegen_c2.hexa §G5/B3.
    // All take/return HexaVal pairs so the generic STMT_CALL emit path
    // (arg pairs into x0:x1/x2:x3/x4:x5, bl, x0:x1 → dst) lowers them
    // verbatim — no special branch, no ret-box. `free_raw` is the
    // 1-arg alias of hexa_ptr_free (size arg ignored by the runtime).
    if name == "alloc_raw"     { return "hexa_ptr_alloc" }
    if name == "free_raw"      { return "hexa_ptr_free" }
    if name == "write_f32"     { return "hexa_ptr_write_f32" }
    if name == "write_i32"     { return "hexa_ptr_write_i32" }
    if name == "write_i64"     { return "hexa_ptr_write" }
    if name == "deref_f32"     { return "hexa_ptr_read_f32" }
    if name == "deref_i32"     { return "hexa_ptr_read_i32" }
    if name == "ptr_write_f32" { return "hexa_ptr_write_f32" }
    if name == "ptr_write_i32" { return "hexa_ptr_write_i32" }
    if name == "ptr_write"     { return "hexa_ptr_write" }      // untyped 64-bit — mirror tier-2 codegen_c2
    if name == "ptr_read"      { return "hexa_ptr_read" }       // untyped 64-bit — mirror tier-2 codegen_c2
    if name == "ptr_read_f32"  { return "hexa_ptr_read_f32" }
    if name == "ptr_read_f64"  { return "hexa_ptr_read_f64" }
    if name == "ptr_read_i32"  { return "hexa_ptr_read_i32" }
    if name == "println"       { return "hexa_println" }
    // Cycle 74 (#947 finding): bare `print` (no-newline) was unmapped ->
    // fell through `return name` -> emitted bare `print` symbol -> `_print`
    // link-fail in user programs calling `print(x)`. The C-emit path
    // (self/codegen.hexa::print -> hexa_print_val) already lowered correctly;
    // this arm64 direct-asm path lagged. Mirror `println` -> hexa_println:
    // `print` -> hexa_print_val (runtime.c:4436, decl runtime.h:321) -- single
    // HexaVal arg, void return, no ret-box (same shape as println).
    if name == "print"         { return "hexa_print_val" }
    if name == "len"           { return "hexa_len" }            // → int (box)
    if name == "contains"      { return "hexa_str_contains" }   // → int (box bool)
    if name == "starts_with"   { return "rt_str_starts_with" }  // → int (box bool)
    if name == "ends_with"     { return "rt_str_ends_with" }    // → int (box bool)
    if name == "is_alpha"          { return "hexa_is_alpha" }          // shim → HexaVal
    if name == "is_alphanumeric"   { return "hexa_is_alphanumeric" }   // shim → HexaVal
    // none-hexa_cc native-seed (PR #3865 follow-on): the 7 builtins that left
    // the flag-ON native-emit object with undefined refs (the C-transpile path
    // emits them inline in self/codegen.hexa; the native path lowered bare
    // names with no linkable def). Each maps to an existing runtime symbol:
    //   exec_with_status/exec_stream/exec_replace/eprint — HexaVal-in/-out (or
    //     void for eprint) C runtime fns, so the generic STMT_CALL emit lowers
    //     them verbatim (cf. self/codegen.hexa:6720/6736/7575/6672 → hexa_*).
    //   has_key/index_of/ord — wrapped by NEW HexaVal-shaped runtime leaves
    //     (hexa_has_key_v/hexa_index_of_v/hexa_ord_v in runtime_core_emit.hexa),
    //     byte-eq IDENTICAL to the C-path inline AND the arm64 special branches
    //     below (same prims: map_contains_key+cstring / str_index_of+int-box /
    //     char_code(s,0)). On arm64 the dedicated has_key/index_of/ord STMT_CALL
    //     branches (≈line 2399/2425/2444) run BEFORE this map, so these three
    //     entries are inert on arm64 (zero behaviour change) and only activate
    //     on the x86_64 path (which has no special branch).
    if name == "exec_with_status"  { return "hexa_exec_with_status" }
    if name == "exec_stream"       { return "hexa_exec_stream_v" }  // hexa_exec_stream is a C _Generic MACRO; _v leaf delegates to hexa_exec_stream_impl
    if name == "exec_replace"      { return "hexa_exec_replace" }
    if name == "eprint"            { return "hexa_eprint_val" }
    if name == "has_key"           { return "hexa_has_key_v" }
    if name == "index_of"          { return "hexa_index_of_v" }
    if name == "ord"               { return "hexa_ord_v" }
    // ── axis-③ symcensus part-2 (CONVERGENCE codegen-runtime-sym-mapping-1):
    // 137 non-array free-fn host builtins (the `read_file_bytes` class) were
    // registered in bind.hexa's `_bind_builtin_names` gate (the type/bind
    // surface) but UNMAPPED here → the `return name` fallthrough (below) emitted
    // a BARE symbol, which hexa_ld's dyn-census misfiled as a libc-floor UND →
    // ld.so failure / rc127 at the self-emit cc-self-bin run. bind.hexa
    // (:1613-1615) documents this second gate as intentionally generous, so this
    // class is DESIGNED to fail at link — the drain closes it. Each target is the
    // AUTHORITATIVE runtime symbol (nm-verified in build/runtime.a): file-I/O
    // takes rt_*, the rest hexa_<name>. All take/return HexaVal pairs, so the
    // generic STMT_CALL pair-ABI emit lowers them verbatim (no special branch,
    // no ret-box). ADDITIVE: every one of these names was a BARE UND (no linkable
    // def) on the native path before, so every existing-GREEN byteeq artifact is
    // byte-unchanged. Shared by BOTH backends (x86_64_linux.hexa calls this fn).
    // Census = _bind_builtin_names(395) − mapped(120) − _is_cabi(84) − special-op
    // (__hx_*/target_is_*/__builtin_va_*/__raw_*) = need-map 144; the 7 excluded:
    // {min,max,sum,is_empty} are array-reductions owned by part-1 (Rung A — min/max
    // are arity-hazardous and need its nargs-branch, a pure rename would silently
    // miscompile free `min(a,b)`→hexa_array_min); {thread_spawn,thread_join,now_ms}
    // are TAG_FN carrier globals (thread_emit.hexa) resolved via hexa_callN — routing
    // them through the pair-ABI here would be a non-additive behaviour change.
    // See state/hexa-own/axis3-symcensus-drain-design.md Rung B.
    // file I/O (rt_*)
    if name == "delete_file"               { return "rt_delete_file" }
    if name == "read_bytes_at"             { return "rt_read_bytes_at" }
    if name == "read_f32_at"               { return "rt_read_f32_at" }
    if name == "read_f32_array_at"         { return "rt_read_f32_array_at" }
    if name == "read_file_bytes"           { return "rt_read_file_bytes" }
    if name == "read_lines"                { return "rt_read_lines" }
    if name == "read_stdin"                { return "hexa_read_stdin" }
    if name == "str_trim_end"              { return "rt_str_trim_end" }
    if name == "str_trim_start"            { return "rt_str_trim_start" }
    if name == "write_bytes_append"        { return "rt_write_bytes_append" }
    if name == "write_bytes_append_v"      { return "rt_write_bytes_append_v" }
    if name == "write_bytes_v"             { return "rt_write_bytes_v" }
    // net_*
    if name == "net_accept"                { return "hexa_net_accept" }
    if name == "net_close"                 { return "hexa_net_close" }
    if name == "net_connect"               { return "hexa_net_connect" }
    if name == "net_listen"                { return "hexa_net_listen" }
    if name == "net_read"                  { return "hexa_net_read" }
    if name == "net_read_bytes"            { return "hexa_net_read_bytes" }
    if name == "net_read_n"                { return "hexa_net_read_n" }
    if name == "net_recv_fd"               { return "hexa_net_recv_fd" }
    if name == "net_select"                { return "hexa_net_select" }
    if name == "net_send_fd"               { return "hexa_net_send_fd" }
    if name == "net_set_nonblock"          { return "hexa_net_set_nonblock" }
    if name == "net_set_timeout"           { return "hexa_net_set_timeout" }
    if name == "net_write"                 { return "hexa_net_write" }
    if name == "net_write_bytes"           { return "hexa_net_write_bytes" }
    // proc_*
    if name == "proc_fork"                 { return "hexa_proc_fork" }
    if name == "proc_reap_zombies"         { return "hexa_proc_reap_zombies" }
    if name == "proc_setsid"               { return "hexa_proc_setsid" }
    if name == "proc_wait"                 { return "hexa_proc_wait" }
    if name == "proc_wait_flag_const"      { return "hexa_proc_wait_flag_const" }
    // pty_*
    if name == "pty_forkexec"              { return "hexa_pty_forkexec" }
    if name == "pty_get_winsize"           { return "hexa_pty_get_winsize" }
    if name == "pty_open"                  { return "hexa_pty_open" }
    if name == "pty_set_winsize"           { return "hexa_pty_set_winsize" }
    // regex_*
    if name == "regex_findall"             { return "hexa_regex_findall" }
    if name == "regex_match"               { return "hexa_regex_match" }
    if name == "regex_match_full"          { return "hexa_regex_match_full" }
    if name == "regex_replace"             { return "hexa_regex_replace" }
    if name == "regex_search"              { return "hexa_regex_search" }
    if name == "regex_split"               { return "hexa_regex_split" }
    // json_*
    if name == "json_decode"               { return "hexa_json_decode" }
    if name == "json_encode"               { return "hexa_json_encode" }
    if name == "json_parse"                { return "hexa_json_parse" }
    if name == "json_stringify"            { return "hexa_json_stringify" }
    // tensor_*
    if name == "tensor_add"                { return "hexa_tensor_add" }
    if name == "tensor_dot"                { return "hexa_tensor_dot" }
    if name == "tensor_mul_scalar"         { return "hexa_tensor_mul_scalar" }
    if name == "tensor_ones"               { return "hexa_tensor_ones" }
    if name == "tensor_slice"              { return "hexa_tensor_slice" }
    if name == "tensor_zeros"              { return "hexa_tensor_zeros" }
    // sleep_*
    if name == "sleep_ms"                  { return "hexa_sleep_ms" }
    if name == "sleep_ns"                  { return "hexa_sleep_ns" }
    if name == "sleep_s"                   { return "hexa_sleep_s" }
    // utc_*
    if name == "utc_compact_now"           { return "hexa_utc_compact_now" }
    if name == "utc_iso_format"            { return "hexa_utc_iso_format" }
    if name == "utc_iso_parse"             { return "hexa_utc_iso_parse" }
    // crypto
    if name == "aes256_ctr_xor"            { return "hexa_aes256_ctr_xor" }
    if name == "chacha20_poly1305_decrypt" { return "hexa_chacha20_poly1305_decrypt" }
    if name == "chacha20_poly1305_encrypt" { return "hexa_chacha20_poly1305_encrypt" }
    if name == "chacha20_xor"              { return "hexa_chacha20_xor" }
    if name == "ed25519_keypair"           { return "hexa_ed25519_keypair" }
    if name == "ed25519_sign"              { return "hexa_ed25519_sign" }
    if name == "ed25519_verify"            { return "hexa_ed25519_verify" }
    if name == "libsodium_available"       { return "hexa_libsodium_available" }
    if name == "poly1305_onetimeauth"      { return "hexa_poly1305_onetimeauth" }
    if name == "sha256_bytes"              { return "hexa_sha256_bytes" }
    if name == "sha512"                    { return "hexa_sha512" }
    if name == "x25519_keypair"            { return "hexa_x25519_keypair" }
    if name == "x25519_scalarmult"         { return "hexa_x25519_scalarmult" }
    // ml ops
    if name == "fma"                       { return "hexa_fma" }
    if name == "gelu"                      { return "hexa_gelu" }
    if name == "hadamard"                  { return "hexa_hadamard" }
    if name == "layer_norm"                { return "hexa_layer_norm" }
    if name == "matmul"                    { return "hexa_matmul" }
    if name == "matvec"                    { return "hexa_matvec" }
    if name == "one_hot"                   { return "hexa_one_hot" }
    if name == "phi_mi_pair"               { return "hexa_phi_mi_pair" }
    if name == "phi_spatial"               { return "hexa_phi_spatial" }
    if name == "rms_norm"                  { return "hexa_rms_norm" }
    if name == "rope_pair"                 { return "hexa_rope_pair" }
    if name == "silu"                      { return "hexa_silu" }
    if name == "softmax"                   { return "hexa_softmax" }
    if name == "swiglu_vec"                { return "hexa_swiglu_vec" }
    // array_* free-call forms
    if name == "array_alloc"               { return "hexa_array_alloc" }
    if name == "array_count"               { return "hexa_array_count" }
    if name == "array_drop"                { return "hexa_array_drop" }
    if name == "array_fill"                { return "hexa_array_fill" }
    if name == "array_index_of"            { return "hexa_array_index_of" }
    if name == "array_max"                 { return "hexa_array_max" }
    if name == "array_min"                 { return "hexa_array_min" }
    if name == "array_product"             { return "hexa_array_product" }
    if name == "array_reverse"             { return "hexa_array_reverse" }
    if name == "array_take"                { return "hexa_array_take" }
    // ptr_* / struct_*
    if name == "ptr_addr"                  { return "hexa_ptr_addr" }
    if name == "ptr_alloc"                 { return "hexa_ptr_alloc" }
    if name == "ptr_free"                  { return "hexa_ptr_free" }
    if name == "ptr_null"                  { return "hexa_ptr_null" }
    if name == "ptr_offset"                { return "hexa_ptr_offset" }
    if name == "struct_free"               { return "hexa_struct_free" }
    if name == "struct_pack"               { return "hexa_struct_pack" }
    if name == "struct_unpack"             { return "hexa_struct_unpack" }
    // term_* residual
    if name == "term_winsize_cols"         { return "hexa_term_winsize_cols" }
    if name == "term_winsize_rows"         { return "hexa_term_winsize_rows" }
    if name == "term_write_str"            { return "hexa_term_write_str" }
    // axis-① Set B-1 (map-only): these were bound (exempt-listed) but had no
    // native codegen map, so a native call bare-fell-through to the C-transpile
    // delegate. Symbols nm-verified `T hexa_term_*` in runtime.a (summer pool);
    // adding the map + dropping the exempt line lets leg-B native-emit them.
    if name == "term_fd_close"             { return "hexa_term_fd_close" }
    if name == "term_fd_poll"              { return "hexa_term_fd_poll" }
    if name == "term_fd_read"              { return "hexa_term_fd_read" }
    if name == "term_fd_write"             { return "hexa_term_fd_write" }
    if name == "term_getppid"              { return "hexa_term_getppid" }
    if name == "term_raw_enter"            { return "hexa_term_raw_enter" }
    if name == "term_raw_restore"          { return "hexa_term_raw_restore" }
    if name == "term_read_byte"            { return "hexa_term_read_byte" }
    // float<->bytes
    if name == "bytes_to_f32_le"           { return "hexa_bytes_to_f32_le" }
    if name == "bytes_to_f64_le"           { return "hexa_bytes_to_f64_le" }
    if name == "f32_to_bytes_le"           { return "hexa_f32_to_bytes_le" }
    if name == "f64_to_bytes_le"           { return "hexa_f64_to_bytes_le" }
    // namespace / mount
    if name == "mount"                     { return "hexa_mount" }
    if name == "namespace_clone_const"     { return "hexa_namespace_clone_const" }
    if name == "pivot_root"                { return "hexa_pivot_root" }
    if name == "setns"                     { return "hexa_setns" }
    if name == "umount"                    { return "hexa_umount" }
    if name == "unshare"                   { return "hexa_unshare" }
    // misc free-fns
    if name == "clock"                     { return "hexa_clock" }
    if name == "cstring"                   { return "hexa_cstring" }
    if name == "deref"                     { return "hexa_deref" }
    if name == "exec_argv"                 { return "hexa_exec_argv" }
    if name == "exec_capture"              { return "hexa_exec_capture" }
    if name == "exec_pipe_open"            { return "hexa_exec_pipe_open" }
    if name == "from_cstring"              { return "hexa_from_cstring" }
    if name == "ham_free"                  { return "hexa_ham_free" }
    if name == "http_get"                  { return "hexa_http_get" }
    if name == "input"                     { return "hexa_input" }
    if name == "is_error"                  { return "hexa_is_error" }
    if name == "isfinite"                  { return "hexa_math_isfinite" }
    if name == "isinf"                     { return "hexa_math_isinf" }
    if name == "isnan"                     { return "hexa_math_isnan" }
    // map_contains_key: hexa_map_contains_key takes a raw `const char*` 2nd arg
    // (NOT reachable by the HexaVal pair-ABI emit) — route to the HexaVal-pure
    // leaf hexa_has_key_v instead (same as Rung A's contains_key/has). A-3 shim.
    if name == "map_contains_key"          { return "hexa_has_key_v" }
    if name == "mod"                       { return "hexa_mod" }
    if name == "now_monotonic_s"           { return "hexa_now_monotonic_s" }
    if name == "real_args"                 { return "hexa_real_args" }
    if name == "script_path"               { return "hexa_script_path" }
    if name == "setenv"                    { return "hexa_setenv" }
    if name == "time_ms"                   { return "hexa_time_ms" }
    if name == "tty_isatty"                { return "hexa_tty_isatty" }
    if name == "tty_ttyname"               { return "hexa_tty_ttyname" }
    if name == "u_floor"                   { return "hexa_u_floor" }
    return name
}

// builtin runtime fn return-shape needing a post-call box into HexaVal:
// "int" → sxtw w0 + hexa_int ; "bool" → uxtw w0 + hexa_bool ; "" → none
// (already HexaVal). has_key is handled by its own STMT_CALL path.
pub fn _builtin_ret_box(name: string) -> string {
    if name == "len"         { return "int" }
    if name == "contains"    { return "bool" }
    if name == "starts_with" { return "bool" }
    if name == "ends_with"   { return "bool" }
    // axis-③ symcensus part-1 A-2 — hexa_str_last_index_of (rfind/last_index_of)
    // returns a raw int64 (-1 or index); box it into a TAG_INT HexaVal.
    if name == "rfind"          { return "int" }
    if name == "last_index_of"  { return "int" }
    return ""
}

// HEXA_BACKEND flip · chunk A step 1 — inline `hexa_int(n)` repr-pack.
//
// `hexa_int(int64_t n) = (HexaVal){.tag=TAG_INT, .i=n}` (runtime_core.c
// :1281). The C runtime returns it in the x0:x1 register PAIR (AAPCS64
// 16-byte struct: x0 = tag, x1 = payload). When the int value is already
// in x0 (a runtime C int from e.g. hexa_str_index_of / hexa_len), boxing
// is a no-alloc 2-instruction repr-pack — identical to the const_int
// operand lowering in `_hv_load` (movz lo #0 = TAG_INT; value in hi):
//
//     mov  x1, x0      ; payload → x1   (MUST precede the x0 clobber)
//     movz x0, #0      ; tag = TAG_INT  (0)
//
// This removes the `bl _hexa_int` from the emitted user `.s` and is the
// prerequisite to dropping the runtime.c link (the .hexa-only @goal).
//
// GATING (no-regression): the inline is OPT-IN behind the native-backend
// flag `HEXA_INLINE_INT_BOX=1`, wired ON only by `self/main.hexa`'s
// HEXA_BACKEND=native build path. When unset (the DEFAULT — every other
// consumer of `--emit=asm`, incl. the build_aprime.sh stage-5 fixpoint
// smoke), the legacy `bl hexa_int` is emitted byte-identically, so the
// self-host gen1≡gen2 fixpoint is not perturbed.
fn _arm64_inline_int_box_enabled() -> bool {
    return env("HEXA_INLINE_INT_BOX") == "1"
}

// Emit the int→HexaVal box. The C int payload is assumed in x0 (the
// callers below sxtw w0→x0 first). Either the inline repr-pack (gated)
// or the legacy `bl hexa_int`.
fn _emit_int_box(buf: [LInstr], why: string) -> [LInstr] {
    let mut out = buf
    if _arm64_inline_int_box_enabled() {
        // payload x0 → x1 BEFORE clobbering x0 with the tag.
        out.push(_arm64_instr2("mov", _arm64_op_reg("x1"),
                         _arm64_op_reg("x0"), why + ": inline box payload → x1"))
        out.push(_arm64_instr2("movz", _arm64_op_reg("x0"),
                         _arm64_op_label("#0"), why + ": inline box TAG_INT"))
        return out
    }
    out.push(_arm64_instr1("bl", _arm64_op_label("hexa_int"), why))
    return out
}

// HEXA_BACKEND flip · chunk A step 2 — inline `hexa_bool(b)` repr-pack.
//
// `hexa_bool(int b) = (HexaVal){.tag=TAG_BOOL, .b=b}` (runtime_core.c
// :1283). Returned in the x0:x1 register PAIR (x0 = tag, x1 = payload),
// exactly like hexa_int — TAG_BOOL=2 is the only difference. At every
// bool box site below the 0/1 result is already in x0 (after a uxtw /
// eor that leaves the truth value in x0), so boxing is a no-alloc
// 2-instruction repr-pack identical to the const_bool operand lowering
// in `_hv_load` (movz lo #2 = TAG_BOOL; payload in hi):
//
//     mov  x1, x0      ; payload → x1   (MUST precede the x0 clobber)
//     movz x0, #2      ; tag = TAG_BOOL (2)
//
// This removes the `bl _hexa_bool` from the emitted user `.s` — the
// step-2 sibling of step-1's hexa_int inline toward the .hexa-only @goal.
//
// GATING (no-regression): OPT-IN behind `HEXA_INLINE_BOOL_BOX=1`, wired
// ON only by `self/main.hexa`'s HEXA_BACKEND=native build path. When
// unset (the DEFAULT — build_aprime.sh stage-5 fixpoint smoke etc.) the
// legacy `bl hexa_bool` is emitted byte-identically, so the self-host
// gen1≡gen2 fixpoint is not perturbed.
fn _arm64_inline_bool_box_enabled() -> bool {
    return env("HEXA_INLINE_BOOL_BOX") == "1"
}

// Emit the bool→HexaVal box. The C int payload (0/1) is assumed in x0
// (the callers below uxtw / eor into x0 first). Either the inline
// repr-pack (gated) or the legacy `bl hexa_bool`.
fn _emit_bool_box(buf: [LInstr], why: string) -> [LInstr] {
    let mut out = buf
    if _arm64_inline_bool_box_enabled() {
        // payload x0 → x1 BEFORE clobbering x0 with the tag.
        out.push(_arm64_instr2("mov", _arm64_op_reg("x1"),
                         _arm64_op_reg("x0"), why + ": inline box payload → x1"))
        out.push(_arm64_instr2("movz", _arm64_op_reg("x0"),
                         _arm64_op_label("#2"), why + ": inline box TAG_BOOL"))
        return out
    }
    out.push(_arm64_instr1("bl", _arm64_op_label("hexa_bool"), why))
    return out
}

// HEXA_BACKEND flip · chunk A step 2 — float box status (RESIDUAL/NONE).
//
// `hexa_float(double f) = (HexaVal){.tag=TAG_FLOAT, .f=f}` (runtime_core.c
// :1282). UNLIKE hexa_int/hexa_bool there is NO `bl _hexa_float` box site
// in this backend to inline:
//   • float LITERALS are already inlined in `_hv_load` const_float (above):
//     movz lo #1 (TAG_FLOAT) + adrp/add/ldr the 8-byte IEEE-754 pool value
//     into hi — a full repr-pack, no constructor call.
//   • float-returning builtins (e.g. `float`/`to_float` → `hexa_to_float`)
//     return a complete HexaVal in x0:x1 directly; `_builtin_ret_box`
//     emits only "int"/"bool", never a "float" box.
// So the `_hexa_float` symbol seen in some `.s` originates inside
// runtime_core.c's own libm wrappers (rt_sin/rt_exp/…), NOT from a codegen
// box site — there is nothing to inline here. No `fmov x1, dN` site exists.

// HEXA_BACKEND flip · chunk A step 3 — str box status (RESIDUAL/NONE).
//
// AUDIT (2026-05-26): the symmetric question to int/bool/float — does this
// backend ever emit `bl _hexa_str` as a boxing-constructor call site? — has
// a clean negative answer. `hexa_str(const char* s)` is the C runtime str
// constructor (runtime.c:1346, returns `{.tag=TAG_STR=3, .s=s}` as a HexaVal
// x0:x1 pair), and it is NEVER called from this backend's emit. Two reasons:
//   • string LITERALS are already inlined in `_hv_load` const_str (above):
//     movz lo #3 (TAG_STR) + adrp/add the `.LCstrN` interned-pool address
//     into hi — a full repr-pack, no constructor call. No env-gate, default
//     ON (this was the authored shape from day 0). See the `if o.kind ==
//     "const_str"` branch at the head of `_hv_load`.
//   • str-returning builtins (`hexa_to_string`, `hexa_str_concat`,
//     `hexa_str_substring`, `hexa_str_split`, `hexa_str_chars`,
//     `hexa_str_replace`, `hexa_str_join`, `hexa_input`, `hexa_args`, …)
//     return a complete HexaVal in x0:x1 DIRECTLY; `_builtin_ret_box` emits
//     only "int"/"bool", never a "str" box. No `mov x1, x0 + movz x0, #3`
//     post-call repr-pack site exists.
// Verified by symbol-grep on the native-backend `--emit=asm` output of a
// string-heavy probe (let s = "..." + concat + to_string(int/bool/float) +
// println · exit(42)): 0 `bl _hexa_str` (constructor) instructions emitted;
// only `bl _hexa_println` / `bl _hexa_to_string` / `bl _hexa_add_slow`,
// none of which is a str-constructor box. The `_hexa_str` symbol seen in
// the LEGACY C-transpile path (codegen_c2's emitted `.c`) does NOT carry
// over to this backend's emit.
//
// DYNAMIC-alloc strings (heap-allocated runtime concatenation, intern-table
// growth) remain a runtime.c concern — those are NOT 2-instr inline-able
// at the codegen ABI surface and belong to a deeper chunk (intern table /
// arena port). They are not "boxing" sites in the int/bool sense.
//
// Conclusion: like float, there is nothing to inline for str at this site
// — no env-gate / helper / step-3 PR shape. The chunk-A repr-constructor
// inlining series (int #1258 + bool #1270 + float documented above + str
// documented here) is COMPLETE at the codegen-emit boundary.

// ── RFC061 §M8 varargs-ABI (literal-∅ feature B, r2 arm64/AAPCS64) ──────────
// The arm64 sibling of x86_64_linux.hexa's `_x86_is_variadic`. A whitelisted name
// is an arm64 variadic function whose prologue (on the AAPCS64/linux path) reserves
// a 192-byte register-save area (64 GP = x0..x7 + 128 FP = q0..q7) and a 32-byte
// __va_list struct, so the in-body `__builtin_va_start` / `__builtin_va_arg` (general
// class) / `__builtin_va_arg_fp` (SIMD class) intrinsics can walk the unnamed args.
// HARD-GATED: `env("HEXA_VA_INTRINSICS") != "1"` → false for EVERY fn → prologue va
// spill + va STMT_CALL branches dead → byte-eq NEUTRAL (mirrors `_x86_is_variadic`
// and `_is_cabi`/HEXA_CABI_HXLCL). The PoC symbols `hxlcl_va_smoke` (int) +
// `hxlcl_va_fp_smoke` (double) prove the leaves — the SAME whitelist the x86_64
// backend uses, so a single smoke source serves both targets.
//
// ⚠️ darwin arm64 va_list ≠ linux arm64 va_list. Apple ARM64 passes ALL variadic
// arguments on the STACK (named params still use x0..x7/v0..v7, but once the variadic
// portion starts every arg is stacked — Apple "Writing ARM64 Code for Apple
// Platforms"), so `va_list` is a SIMPLE `char*` and there is NO register-save area:
// va_start points at the first caller stack slot, va_arg loads 8 bytes and bumps the
// pointer (16B align for a 16B type). Linux uses the full AAPCS64 §B.4 `__va_list`
// {__stack,__gr_top,__vr_top,__gr_offs,__vr_offs} with the GP+FP save areas. The two
// paths are branched on `opts.target_triple == "arm64-linux-gnu"` inside each va
// builtin — exactly the existing __hx_target_os / __hx_syscall* split.
// Materialize `sp + off` (a frame address) into `reg`. ARM64 `add` immediate is
// ≤4095, so a larger off is built into the reg (movz/movk) then added. Used by the
// AAPCS64 va_start to compute the va_list base + the GP/FP save-area-end pointers.
fn _arm64_va_addr(buf: [LInstr], reg: string, off: i64) -> [LInstr] {
    let mut out = buf
    if off <= 4095 {
        out.push(_arm64_instr3("add", _arm64_op_reg(reg), _arm64_op_reg("sp"),
                         _arm64_op_label("#" + to_string(off)), "va: &sp+" + to_string(off)))
        return out
    }
    out = _arm64_emit_imm_to_reg(out, reg, off)
    out.push(_arm64_instr3("add", _arm64_op_reg(reg), _arm64_op_reg("sp"),
                     _arm64_op_reg(reg), "va: &sp+off (big)"))
    return out
}

fn _arm64_is_variadic(fname: string) -> bool {
    if env("HEXA_VA_INTRINSICS") != "1" { return false }
    if fname == "hxlcl_va_smoke" { return true }
    if fname == "hxlcl_va_fp_smoke" { return true }
    // RUNG2 forwarding PoC (outer variadic fn — see stdlib/runtime/hxlcl_va_fwd_smoke.hexa).
    if fname == "hxlcl_va_fwd_smoke" { return true }
    return false
}

// A variadic fn whose RETURN is SIMD-class (`double`/`float`) returns its value in
// d0/v0 (AAPCS64 §6.4 result return), NOT x0. Keyed on the variadic whitelist:
// only `hxlcl_va_fp_smoke` (the r2 SIMD PoC) has a double return; `hxlcl_va_smoke`
// is integer-return (x0). Gated by `_arm64_is_variadic` callers ⇒ default-OFF
// byte-eq NEUTRAL.
fn _arm64_va_ret_is_fp(fname: string) -> bool {
    if fname == "hxlcl_va_fp_smoke" { return true }
    return false
}

// va register-save block size (BYTES) reserved in the frame for a variadic fn,
// wedged BETWEEN the regalloc spill slots and the try jmp_bufs (so it aliases
// neither). LINUX/AAPCS64 = 192 (64-byte GP save x0..x7 + 128-byte FP save q0..q7)
// + 32-byte __va_list = 224 → 16B-rounded. DARWIN = 0 (stack-passed varargs, char*
// va_list lives in an ordinary spill slot bound by va_start). Non-variadic → 0 →
// byte-eq NEUTRAL. `is_linux` is the caller's `opts.target_triple == "arm64-linux-gnu"`.
fn _arm64_va_block_bytes(fname: string, is_linux: bool) -> i64 {
    if !_arm64_is_variadic(fname) { return 0 }
    if is_linux { return 224 }   // 64 GP + 128 FP + 32 va_list (16B mult)
    return 0                     // darwin: stack-passed, no reg save area
}

// Cycle h20: extra params try_buf_bytes (total fn jmp_buf region size)
// and try_slot_idx (this statement's slot index in 0..try_count).
// try_slot_idx is meaningful only for STMT_TRY_SETJMP / STMT_TRY_POP;
// other kinds ignore it.
fn _emit_arm64_stmt(out: [LInstr], modhash: string, fname: string, s: Stmt,
                    st: ArmStrTab, rm: RegMap, spill_frame: i64,
                    try_buf_bytes: i64, try_slot_idx: i64,
                    opts: CodegenOptions) -> [LInstr] {
    let mut buf = out
    if s.kind == _STMT_ASSIGN {
        // array_lit constructor (mirror of x86_64_linux.hexa 269bb61d;
        // AAPCS64: args x0/x1, call via bl, return x0). dst =
        // hexa_array_new(); per element hexa_array_push(dst, e_i) →
        // recapture x0. Grammar-capped ≤1024 by HX0013 → O(n) bounded.
        // Runtime-call shape mirrors the proven concat idiom below.
        // rebuild-verification DEFERRED (Track-A clang wall) — logic
        // parity with shipped concat emit.
        if s.op == "array_lit" {
            // FLEET arm64 element-pack (HEXA_PACK_ESCAPING) — escaping-packed mint:
            // build a RAW contiguous HexaArrI64 tagged TAG_ARRAY_I64 via
            // hexa_arr_i64_new_esc so a worker that receives this array as a param
            // of unknown packed-ness discriminates it at runtime via hexa_arr_poly_*.
            // AAPCS64: hexa_arr_i64_new_esc(int cap) → cap in w0, returns HexaVal
            // x0:x1; hexa_arr_i64_push(HexaVal v, int64_t x) → v in x0:x1, raw int x
            // in x2, returns the (possibly realloc'd) descriptor x0:x1. The element
            // is loaded as a HexaVal pair and its PAYLOAD (x_hi) is the raw int64 —
            // mirror of x86_64's _x86_hv_payload(arg → rdx). Takes priority over the
            // boxed hexa_array_new mint when ON (uniform representation).
            if _arm_local_esc_mint(rm, s.dst.id) {
                let mut ecap = len(s.args)
                if ecap < 1 { ecap = 1 }
                buf = _arm64_emit_imm_to_reg(buf, "x0", ecap)
                buf.push(_arm64_instr1("bl", _arm64_op_label("hexa_arr_i64_new_esc"),
                                 "arresc new: escaping packed int64 storage (TAG_ARRAY_I64)"))
                buf = _hv_store_dst(buf, rm, s.dst, "x0", "x1")
                let mut ei = 0
                while ei < len(s.args) {
                    // raw element payload → x9:x10 (x10 = payload), descriptor → x0:x1.
                    buf = _hv_load(buf, s.args[ei], st, rm, "x9", "x10")
                    buf = _hv_ldslot(buf, rm, s.dst.id, "x0", "x1")
                    buf.push(_arm64_instr2("mov", _arm64_op_reg("x2"),
                                     _arm64_op_reg("x10"), "arresc push: raw elem payload → x2"))
                    buf.push(_arm64_instr1("bl", _arm64_op_label("hexa_arr_i64_push"),
                                     "arresc push: raw elem " + to_string(ei)))
                    buf = _hv_store_dst(buf, rm, s.dst, "x0", "x1")
                    ei = ei + 1
                }
                return buf
            }
            buf.push(_arm64_instr1("bl", _arm64_op_label("hexa_array_new"),
                             "array_lit: new array"))
            buf = _hv_store_dst(buf, rm, s.dst, "x0", "x1")
            let mut i = 0
            while i < len(s.args) {
                buf = _hv_ldslot(buf, rm, s.dst.id, "x0", "x1")
                buf = _hv_load(buf, s.args[i], st, rm, "x2", "x3")
                buf.push(_arm64_instr1("bl", _arm64_op_label("hexa_array_push"),
                                 "array_lit: push elem " + to_string(i)))
                buf = _hv_store_dst(buf, rm, s.dst, "x0", "x1")
                i = i + 1
            }
            return buf
        }
        // struct_lit constructor (map-backed; mirror of x86_64 a351b1c9
        // in AAPCS64: x0=map, x1=key const char*, x2=val HexaVal, bl,
        // x0 return). MIR args = [type_str, k0_str, v0, ...] (2a790d85);
        // const_str key → .rodata label = const char* (map_set ABI).
        // type_str ignored in map-backed v1. Runtime-call parity with
        // array_lit/concat; rebuild-verification deferred (Track-A wall).
        if s.op == "struct_lit" && len(s.args) >= 1 {
            // map ABI: m=HexaVal(x0:x1), key=const char*(x2), val=
            // HexaVal(x3:x4). args=[type_str, k0,v0,k1,v1,…].
            buf.push(_arm64_instr1("bl", _arm64_op_label("hexa_map_new"),
                             "struct_lit: new map"))
            buf = _hv_store_dst(buf, rm, s.dst, "x0", "x1")
            let mut i = 1
            while i + 1 < len(s.args) {
                buf = _hv_ldslot(buf, rm, s.dst.id, "x0", "x1")
                buf = _hv_cstr(buf, s.args[i], st, "x2")
                buf = _hv_load(buf, s.args[i + 1], st, rm, "x3", "x4")
                buf.push(_arm64_instr1("bl", _arm64_op_label("hexa_map_set"),
                                 "struct_lit: set field"))
                buf = _hv_store_dst(buf, rm, s.dst, "x0", "x1")
                i = i + 2
            }
            return buf
        }
        // RFC 074 Phase 4 — multi-cell enum payload constructor.
        // Producer = compiler/lower/hir_to_mir.hexa enum_path arm (>=2 args).
        // Body is byte-equivalent to struct_lit (same key/val pair walk,
        // same hexa_map_new + hexa_map_set ABI) — the op-string split is
        // the semantic marker. A future cycle can swap the storage for a
        // contiguous N-cell layout by replacing the per-cell call loop
        // below WITHOUT touching struct_lit. First arg is the "enum_<path>"
        // type string; pairs [k1,v1] onward are __tag + __p0..__pN-1 slots.
        if s.op == "enum_ctor" && len(s.args) >= 1 {
            buf.push(_arm64_instr1("bl", _arm64_op_label("hexa_map_new"),
                             "enum_ctor: new map (multi-cell payload)"))
            buf = _hv_store_dst(buf, rm, s.dst, "x0", "x1")
            let mut i = 1
            while i + 1 < len(s.args) {
                buf = _hv_ldslot(buf, rm, s.dst.id, "x0", "x1")
                buf = _hv_cstr(buf, s.args[i], st, "x2")
                buf = _hv_load(buf, s.args[i + 1], st, rm, "x3", "x4")
                buf.push(_arm64_instr1("bl", _arm64_op_label("hexa_map_set"),
                                 "enum_ctor: set cell"))
                buf = _hv_store_dst(buf, rm, s.dst, "x0", "x1")
                i = i + 2
            }
            return buf
        }
        // field access (map-backed; mirror of x86_64 0fe030dd in
        // AAPCS64: x0=base, x1=key const char*, bl hexa_map_get, x0).
        // args = [base, "<name>"_str]; const_str key → .rodata label.
        // Parity with shipped array_lit/struct_lit; rebuild-verification
        // deferred (Track-A clang wall).
        if s.op == "field" && len(s.args) >= 2 {
            // map ABI: base=HexaVal(x0:x1), key=const char*(x2).
            buf = _hv_load(buf, s.args[0], st, rm, "x0", "x1")
            buf = _hv_cstr(buf, s.args[1], st, "x2")
            buf.push(_arm64_instr1("bl", _arm64_op_label("hexa_map_get"),
                             "field: hexa_map_get"))
            buf = _hv_store_dst(buf, rm, s.dst, "x0", "x1")
            return buf
        }
        // RFC closure C3 — closure-value construction. hir_to_mir lowers a
        // closure-expression site to STMT_ASSIGN op="closure_new" with
        //   args = [env_array, lambda_name_str, arity_int]
        // and emits the synthetic `__hexa_lambda_<N>` MFunc separately.
        // Runtime ABI: hexa_closure_new(void* fn_ptr, int arity,
        // HexaVal env_arr) — fn_ptr in x0, arity (C int) in w1, env HexaVal
        // pair in x2:x3, returns the TAG_CLOSURE HexaVal in x0:x1. The
        // fn pointer is the address of the lifted lambda symbol (adrp/add);
        // mirrors self/codegen_c2.hexa::gen2_lambda_expr's
        // `hexa_closure_new((void*)&__hexa_lambda_N, arity, env)`.
        // fn-ref-as-value: hir_to_mir lowers a bare top-level-fn ident used in
        // value position to STMT_ASSIGN op="fn_ref" with args = [name_str,
        // arity_int]. Runtime ABI: hexa_fn_new(void* fn_ptr, int arity) →
        // fn_ptr in x0, arity (C int) in w1; returns the TAG_FN HexaVal in
        // x0:x1. fn_ptr = address of the user fn symbol (adrp/add @PAGE/@PAGEOFF,
        // same symbol the direct `bl <target>` uses). TAG_FN (not TAG_CLOSURE)
        // so the runtime call dispatch does NOT prepend an env — a plain fn
        // `worker(start)` takes its arg directly. Mirrors the C-transpile
        // hexa_fn_new auto-wrap.
        if s.op == "fn_ref" && len(s.args) >= 2 {
            let fn_sym = s.args[0].str_val
            let fn_arity = s.args[1].int_val
            // x0 = &<fn_sym> (PC-relative; symbol mangled by _fmt_label)
            buf.push(_arm64_instr2("adrp", _arm64_op_reg("x0"),
                             _arm64_op_label(fn_sym + "@PAGE"),
                             "fn_ref: fn-ptr page"))
            buf.push(_arm64_instr3("add", _arm64_op_reg("x0"),
                             _arm64_op_reg("x0"),
                             _arm64_op_label(fn_sym + "@PAGEOFF"),
                             "fn_ref: fn-ptr off"))
            // w1 = arity (C int)
            buf.push(_arm64_instr2("movz", _arm64_op_reg("x1"),
                             _arm64_op_label("#" + to_string(fn_arity)),
                             "fn_ref: arity"))
            buf.push(_arm64_instr1("bl", _arm64_op_label("hexa_fn_new_native"),
                             "fn_ref: build TAG_FN"))
            buf = _hv_store_dst(buf, rm, s.dst, "x0", "x1")
            return buf
        }
        // ING #29 literal-∅ (2026-06-30): `__hx_fn_addr(name)` — the arm64 raw-unboxed-fn-ptr
        // sibling of `fn_ref`. hir_to_mir lowers `__hx_fn_addr(worker)` to STMT_ASSIGN
        // op="__hx_fn_addr" args=[name_str] (the SAME stmt kind as fn_ref). THIS special-
        // case emits ONLY the PC-relative address-of via `adrp x1, name@PAGE` + `add x1,
        // x1, name@PAGEOFF` (the EXACT relocation pair `fn_ref` uses above) and SKIPS the
        // `bl hexa_fn_new_native` boxing call. x1 = raw .text pointer, x0 = TAG_INT (0).
        // reference-match: C `&fn` / rustc fn-ptr / zig `@intFromPtr(fn)`. NOTE: this
        // handler lives in the _STMT_ASSIGN block (NOT _STMT_CALL) because hir_to_mir
        // emits it as STMT_ASSIGN — a prior copy in _STMT_CALL was unreachable (silent
        // mis-emit root cause). ADD-only / byte-eq NEUTRAL.
        if s.op == "__hx_fn_addr" && len(s.args) >= 1 {
            if s.args[0].kind == "const_str" {
                let fn_sym = s.args[0].str_val
                buf.push(_arm64_instr2("adrp", _arm64_op_reg("x1"),
                                 _arm64_op_label(fn_sym + "@PAGE"),
                                 "__hx_fn_addr: &" + fn_sym + " page (raw .text fn ptr)"))
                buf.push(_arm64_instr3("add", _arm64_op_reg("x1"),
                                 _arm64_op_reg("x1"),
                                 _arm64_op_label(fn_sym + "@PAGEOFF"),
                                 "__hx_fn_addr: x1 = &" + fn_sym + " (raw .text fn ptr)"))
                buf.push(_arm64_instr2("movz", _arm64_op_reg("x0"),
                                 _arm64_op_label("#0"), "__hx_fn_addr: TAG_INT"))
                if s.dst.id >= 0 { buf = _hv_store_dst(buf, rm, s.dst, "x0", "x1") }
                return buf
            }
        }
        // carrier call: invoke a runtime TAG_FN/TAG_CLOSURE carrier DATA global
        // (thread_spawn, …). hir_to_mir lowers `thread_spawn(worker, 1)` to
        // STMT_ASSIGN op="carrier_call" args=[carrier_name_str, a1, …]. ABI:
        // hexa_callN_native(HexaVal carrier, HexaVal a1, …) — carrier pair →
        // x0:x1, a1 → x2:x3, a2 → x4:x5 (AAPCS64 16B HexaVal-by-value pairs).
        // The carrier is loaded from its global: adrp/add → addr, ldp x0,x1,[addr]
        // (lo=tag@0, hi=payload@8). Box the call args FIRST (they use x15 scratch
        // + write x2:x3/x4:x5, never x0:x1), THEN load the carrier into x0:x1 so
        // it survives. Returns the HexaVal in x0:x1.
        if s.op == "carrier_call" && len(s.args) >= 1 {
            let carrier = s.args[0].str_val
