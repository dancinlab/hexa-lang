            buf = _hv_load(buf, s.args[0], st, rm, "x0", "x1")  // num → x1
            buf.push(_arm64_instr2("mov", _arm64_op_reg(num_reg),
                             _arm64_op_reg("x1"), "__hx_syscall0: " + num_reg + " = syscall num"))
            buf.push(_arm64_instr1("svc", _arm64_op_label(trap_imm),
