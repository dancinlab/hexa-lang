            if elf_abi {
                buf.push(_arm64_instr2("mov", _arm64_op_reg("x8"),
                                 _arm64_op_reg("x15"), "__hx_syscall6: x8 = syscall num"))
                buf.push(_arm64_instr1("svc", _arm64_op_label("#0"),
                                 "__hx_syscall6: Linux syscall trap"))
            } else {
                buf.push(_arm64_instr1("svc", _arm64_op_label("#0x80"),
                                 "__hx_syscall6: BSD syscall trap"))
            }
            buf.push(_arm64_instr2("mov", _arm64_op_reg("x1"),
                             _arm64_op_reg("x0"), "__hx_syscall6: payload = result"))
            buf.push(_arm64_instr2("movz", _arm64_op_reg("x0"),
                             _arm64_op_label("#0"), "__hx_syscall6: TAG_INT"))
