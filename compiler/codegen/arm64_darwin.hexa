    }
    // id 2 = musl log __log_data (src/math/log_data.c, LOG_TABLE_BITS=7 N=128).
    // Layout: tab[128]×{invc,logc}=256 doubles (byte 0..2047) THEN tab2[128]×
    // {chi,clo}=256 doubles (byte 2048..4095) = 512 doubles. BIG-ENDIAN uint64 hex
    // VERBATIM from musl (raw bit patterns; converted to LE bytes by
    // _arm64_u64hex_list_to_le_payload). hxlcl_log reads cells via byte offsets
    // i*16{+0,+8} (tab) / i*16{+2048,+2056} (tab2). Authoritative: git.musl-libc.org
    // log_data.c.
    if table_id == 2 {
            return "3ff734f0c3e0de9f bfd7cc7f79e69000 3ff713786a2ce91f bfd76feec20d0000 3ff6f26008fab5a0 bfd713e31351e000 3ff6d1a61f138c7d bfd6b85b38287800 "
