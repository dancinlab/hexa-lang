            if _amnem == "dmb" {
                buf.push(_arm64_instr1("dmb", _arm64_op_label("#11"),
                                 "__hx_asm fence: dmb ish (CRm=11)"))
            } else if _amnem != "" {
                buf.push(_arm64_instr0(_amnem, "__hx_asm: inline asm passthrough"))
            }
