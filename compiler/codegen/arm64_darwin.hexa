            if s.op == "__hx_payload_shr" { _sm = "lsrv" } // LOGICAL right (zero-fill)
            buf.push(_arm64_instr3(_sm, _arm64_op_reg("x1"), _arm64_op_reg("x1"),
                             _arm64_op_reg("x3"), s.op + ": x1 = v.pl " + _sm + " n"))
            buf.push(_arm64_instr2("movz", _arm64_op_reg("x0"),
                             _arm64_op_label("#0"), s.op + ": TAG_INT"))
