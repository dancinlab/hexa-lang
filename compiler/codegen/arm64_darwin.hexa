                // raw value goes in x0 (the C caller reads x0, not the {tag,payload}
                // pair). Load just the payload eightbyte into x0 (x9 = throwaway tag).
                // Without this the {TAG_INT, value} pair landed tag(0) in x0 → every
                // variadic-int call returned 0. default-OFF ⇒ byte-eq NEUTRAL.
                buf = _hv_load(buf, s.args[0], st, rm, "x9", "x0")
            } else if _is_cabi(fname) && !_cabi_is_fp(fname) {
                // Route C C-ABI return — a raw C-ABI fn returns a single value
                // in x0. Load just the payload eightbyte into x0 (x9 = throwaway
                // tag half); the HexaVal tag is dropped (C caller reads only x0).
                buf = _hv_load(buf, s.args[0], st, rm, "x9", "x0")
            } else {
                buf = _hv_load(buf, s.args[0], st, rm, "x0", "x1")  // AAPCS64 16B return = x0:x1
            }
