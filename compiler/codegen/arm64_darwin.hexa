        // mangle), differing per-target from glibc's bare `stderr`. x1 = &stderr
        // (FILE**), x0 = TAG_INT; one __hx_ptr_load64 in the caller yields the
        // `stderr` FILE* value to compare against `fp`. No args; load + box.
        if s.op == "__hx_stderr_ptr" {
