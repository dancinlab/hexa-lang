        if s.dst.id >= 0 {
            buf = _hv_store_dst(buf, rm, s.dst, "x0", "x1")
        }
        return buf
    }
    if s.kind == _STMT_RETURN {
        if len(s.args) >= 1 {
            if _arm64_va_active && _arm64_va_ret_is_fp(fname) {
                // RFC061 §M8 r2 — a variadic fn whose return is SIMD-class (`double`)
                // returns its value in d0/v0 (AAPCS64 §6.4), NOT x0. The payload eightbyte
                // holds the raw IEEE-754 bits; load into x1 then `fmov d0, x1` (the same
                // GP→SIMD move the __hx_payload_fadd path emits). A C caller reads the
                // result in d0. Must precede frame teardown (reads spill slots). default-
                // OFF (_arm64_va_active is gated by _arm64_is_variadic) ⇒ byte-eq NEUTRAL.
                buf = _hv_load(buf, s.args[0], st, rm, "x0", "x1")
                buf.push(_arm64_instr2("fmov", _arm64_op_reg("d0"), _arm64_op_reg("x1"),
                                 "va fp return: d0 = result bits"))
            } else if _arm64_va_active {
