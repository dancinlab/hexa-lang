            buf = _hv_load(buf, s.args[1], st, rm, "x2", "x3")  // b → x3=f bits
            buf.push(_arm64_instr2("fmov", _arm64_op_reg("d0"),
                             _arm64_op_reg("x1"), s.op + ": d0 = a.f"))
            buf.push(_arm64_instr2("fmov", _arm64_op_reg("d1"),
                             _arm64_op_reg("x3"), s.op + ": d1 = b.f"))
            buf.push(_arm64_instr3(_fop, _arm64_op_reg("d0"), _arm64_op_reg("d0"),
                             _arm64_op_reg("d1"), s.op + ": d0 = a.f " + _fop + " b.f"))
            buf.push(_arm64_instr2("fmov", _arm64_op_reg("x1"),
                             _arm64_op_reg("d0"), s.op + ": x1 = result bits"))
            buf.push(_arm64_instr2("movz", _arm64_op_reg("x0"),
                             _arm64_op_label("#1"), s.op + ": TAG_FLOAT"))
