                                 _arm64_op_reg("x1"),
                                 _arm64_op_label(rrefsym + "@PAGEOFF"),
                                 "__hx_rodata_tab_ptr: x1 = &" + rrefsym))
                buf.push(_arm64_instr2("movz", _arm64_op_reg("x0"),
                                 _arm64_op_label("#0"), "__hx_rodata_tab_ptr: TAG_INT"))
