            buf = _hv_load(buf, s.args[0], st, rm, "x0", "x1")  // tag word  → x1 = payload
            buf = _hv_load(buf, s.args[1], st, rm, "x2", "x3")  // pl word   → x3 = payload
            buf.push(_arm64_instr2("mov", _arm64_op_reg("x0"),
                             _arm64_op_reg("x1"), "__hx_make_val: lo = tag word"))
            buf.push(_arm64_instr2("mov", _arm64_op_reg("x1"),
                             _arm64_op_reg("x3"), "__hx_make_val: hi = payload word"))
            if s.dst.id >= 0 { buf = _hv_store_dst(buf, rm, s.dst, "x0", "x1") }
