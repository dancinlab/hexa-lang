                             _arm64_op_label("#0"), "__hx_asm: payload = 0"))
            buf.push(_arm64_instr2("movz", _arm64_op_reg("x0"),
                             _arm64_op_label("#0"), "__hx_asm: TAG_INT"))
            if s.dst.id >= 0 { buf = _hv_store_dst(buf, rm, s.dst, "x0", "x1") }
            return buf
        }
        // RT-NATIVE UNLOCK-9: `__hx_syscall6(num, a0..a5)` → int HexaVal of a
