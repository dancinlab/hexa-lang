        // This is the arm64 backend (darwin AND linux), so the value is always 1
        // (arm64), per self/rt/syscall.hexa's convention (0 ⇒ x86_64, 1 ⇒ arm64).
        // Lets the source pick the aarch64-Linux syscall numbers (mmap=222 etc.)
        // distinct from x86_64-Linux (mmap=9). 0-arg leaf, no `bl`.
        if s.op == "__hx_target_arch" {
            buf.push(_arm64_instr2("movz", _arm64_op_reg("x1"),
