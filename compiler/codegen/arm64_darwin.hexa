            buf = _hv_load(buf, s.args[0], st, rm, "x0", "x1")  // v → x1 = HexaArr*
            buf.push(_arm64_instr2("ldr", _arm64_op_reg("w1"),
                             _arm64_op_label("[x1, #8]"), "__hx_arr_len: w1 = arr->len (int32)"))
            buf.push(_arm64_instr2("movz", _arm64_op_reg("x0"),
                             _arm64_op_label("#0"), "__hx_arr_len: TAG_INT"))
            if s.dst.id >= 0 { buf = _hv_store_dst(buf, rm, s.dst, "x0", "x1") }
            return buf
