                             _arm64_op_reg("x0"), "__hx_syscall0: payload = result"))
            buf.push(_arm64_instr2("movz", _arm64_op_reg("x0"),
                             _arm64_op_label("#0"), "__hx_syscall0: TAG_INT"))
