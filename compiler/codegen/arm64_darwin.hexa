        if s.op == "__hx_stdout_ptr" {
            buf.push(_arm64_instr2("adrp", _arm64_op_reg("x1"),
                             _arm64_op_label("__stdoutp@GOTPAGE"),
                             "__hx_stdout_ptr: &__stdoutp GOT page [reloc=" + RELOC_AARCH64_ADR_GOT_PAGE + "]"))
            buf.push(_arm64_instr2("ldr", _arm64_op_reg("x1"),
                             _arm64_op_mem_label("x1", "__stdoutp@GOTPAGEOFF"),
                             "__hx_stdout_ptr: x1 = &__stdoutp [reloc=" + RELOC_AARCH64_LD64_GOT_LO12_NC + "]"))
            buf.push(_arm64_instr2("movz", _arm64_op_reg("x0"),
                             _arm64_op_label("#0"), "__hx_stdout_ptr: TAG_INT"))
