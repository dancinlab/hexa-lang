                let refsym = "slot_" + to_string(sid)          // _fmt_label adds `_` on darwin
                buf.push(_arm64_instr2("adrp", _arm64_op_reg("x1"),
                                 _arm64_op_label(refsym + "@PAGE"),
                                 "__hx_static_slot: &" + refsym + " page (self-static)"))
                buf.push(_arm64_instr3("add", _arm64_op_reg("x1"),
                                 _arm64_op_reg("x1"),
                                 _arm64_op_label(refsym + "@PAGEOFF"),
                                 "__hx_static_slot: x1 = &" + refsym))
                buf.push(_arm64_instr2("movz", _arm64_op_reg("x0"),
                                 _arm64_op_label("#0"), "__hx_static_slot: TAG_INT"))
