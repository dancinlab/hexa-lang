        // single prologue sub; see _arm64_lower_func). The va block (0 unless this is
        // a variadic fn under HEXA_VA_INTRINSICS=1) must be freed too so sp re-balances.
        // ING #29 literal-∅: @naked fn — NO return-statement epilogue (the body
        // is raw asm that terminates itself). DEFAULT false → unchanged on every fn.
        if !_arm64_is_naked {
        let _va_blk_epi = _arm64_va_block_bytes(fname, opts.target_triple == "arm64-linux-gnu")
        let epilogue_total = spill_frame + rm.call_overflow_bytes + _va_blk_epi + try_buf_bytes
        if epilogue_total > 0 {
            buf = _hv_sp_adj(buf, "add", epilogue_total, "x15")
        }
        buf.push(_arm64_instr3("ldp", _arm64_op_reg("x29"), _arm64_op_reg("x30"),
