use "tests/interp_qforge_bio/modA"
fn main() {
    let r = 1.7682
    let a = (2.0 * r) / 1.122462048309373
    let m = qfb_conv(r)
    // print scaled to expose low digits
    println(format_float(a * 1000000000000.0, 5))
    println(format_float(m * 1000000000000.0, 5))
    // also raw numerator
    let n_main = 2.0 * r
    println(format_float(n_main * 1000000000000.0, 5))
}
