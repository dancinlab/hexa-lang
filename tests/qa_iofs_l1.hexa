// QA LANE L1 — io/fs full-surface harness (anima weight-loading path).
// All test byte-arrays are built via .push() to AVOID the orthogonal
// int-literal-array native-storage codegen bug (scalar a[i] read of a
// literal int array segfaults; see qa_litarr_repro). This harness
// exercises the io/fs SURFACE in isolation.
// Each case prints PASS <name> or FAIL <name> got=.. want=..

fn report(name: string, ok: bool, got: string, want: string) {
    if ok {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + got + " want=" + want)
    }
}

fn mkarr(vals_lo: int, vals_hi: int, step: int) -> [int] {
    let mut a = []
    let mut v = vals_lo
    while v < vals_hi {
        a.push(v % 256)
        v = v + step
    }
    return a
}

fn arr_eq(a: [int], b: [int]) -> bool {
    if len(a) != len(b) { return false }
    let mut i = 0
    while i < len(a) {
        if a[i] != b[i] { return false }
        i = i + 1
    }
    return true
}

fn arr_str(a: [int]) -> string {
    let mut s = "["
    let mut i = 0
    while i < len(a) {
        if i > 0 { s = s + "," }
        s = s + to_string(a[i])
        i = i + 1
    }
    return s + "]"
}

fn main() {
    let dir = "/tmp/qa_iofs_l1"
    mkdir(dir)
    let base = dir + "/f"

    // ---- 1. write_file / read_file text round-trip ----
    let p1 = base + "_text.txt"
    write_file(p1, "hello world")
    let r1 = read_file(p1)
    report("text_roundtrip", r1 == "hello world", "len" + to_string(len(r1)), "hello world")

    // ---- 2. empty file ----
    let p2 = base + "_empty.txt"
    write_file(p2, "")
    let r2 = read_file(p2)
    report("empty_read_file", r2 == "", "len" + to_string(len(r2)), "empty")
    let r2b = read_file_bytes(p2)
    report("empty_read_bytes", len(r2b) == 0, to_string(len(r2b)), "0")
    report("empty_file_size", file_size(p2) == 0, to_string(file_size(p2)), "0")
    report("empty_exists", file_exists(p2), "false", "true")

    // ---- 3. missing-file error paths ----
    let pmiss = dir + "/does_not_exist_xyz"
    report("missing_exists", file_exists(pmiss) == false, "true", "false")
    report("missing_read_file", read_file(pmiss) == "", "nonempty", "empty")
    report("missing_read_bytes", len(read_file_bytes(pmiss)) == 0, to_string(len(read_file_bytes(pmiss))), "0")
    report("missing_file_size", file_size(pmiss) == 0, to_string(file_size(pmiss)), "0")

    // ---- 4. binary bytes incl 0x00 and 0xFF (pushed array) ----
    let pbin = base + "_bin.dat"
    let mut bin = []
    bin.push(0)
    bin.push(255)
    bin.push(1)
    bin.push(254)
    bin.push(128)
    bin.push(127)
    bin.push(0)
    bin.push(0)
    bin.push(255)
    write_bytes(pbin, bin)
    let rbin = read_file_bytes(pbin)
    report("binary_roundtrip", arr_eq(rbin, bin), arr_str(rbin), arr_str(bin))
    report("binary_size", file_size(pbin) == 9, to_string(file_size(pbin)), "9")

    // ---- 5. write_bytes all-zeros (pushed) ----
    let mut zb = []
    let mut zi = 0
    while zi < 8 {
        zb.push(0)
        zi = zi + 1
    }
    let pz = base + "_zeros.dat"
    write_bytes(pz, zb)
    let rz = read_file_bytes(pz)
    report("write_bytes_zeros", arr_eq(rz, zb), arr_str(rz), arr_str(zb))

    // ---- 6. write_bytes pushed nonzero ----
    let pushed = mkarr(0, 112, 7)
    let pp = base + "_pushed.dat"
    write_bytes(pp, pushed)
    let rp = read_file_bytes(pp)
    report("write_bytes_pushed", arr_eq(rp, pushed), arr_str(rp), arr_str(pushed))

    // ---- 7. ranged read_bytes_at: 64-byte known file (seq 0..63) ----
    let seq = mkarr(0, 64, 1)
    let pseq = base + "_seq.dat"
    write_bytes(pseq, seq)
    report("ranged_file_size", file_size(pseq) == 64, to_string(file_size(pseq)), "64")

    // 7a. offset 0
    let ra0 = read_bytes_at(pseq, 0, 8)
    report("ranged_offset0", arr_eq(ra0, mkarr(0, 8, 1)), arr_str(ra0), arr_str(mkarr(0, 8, 1)))
    // 7b. mid (offset 30, 10 bytes)
    let ram = read_bytes_at(pseq, 30, 10)
    report("ranged_mid", arr_eq(ram, mkarr(30, 40, 1)), arr_str(ram), arr_str(mkarr(30, 40, 1)))
    // 7c. EOF boundary (offset 60, ask 8 -> 4 left)
    let rae = read_bytes_at(pseq, 60, 8)
    report("ranged_eof_short", arr_eq(rae, mkarr(60, 64, 1)), arr_str(rae), arr_str(mkarr(60, 64, 1)))
    // 7d. exactly at EOF -> empty
    report("ranged_at_eof_empty", len(read_bytes_at(pseq, 64, 8)) == 0, to_string(len(read_bytes_at(pseq, 64, 8))), "0")
    // 7e. past EOF -> empty
    report("ranged_past_eof_empty", len(read_bytes_at(pseq, 1000, 8)) == 0, to_string(len(read_bytes_at(pseq, 1000, 8))), "0")
    // 7f. zero-length -> empty
    report("ranged_zero_len_empty", len(read_bytes_at(pseq, 0, 0)) == 0, to_string(len(read_bytes_at(pseq, 0, 0))), "0")
    // 7g. missing file -> empty
    report("ranged_missing_empty", len(read_bytes_at(pmiss, 0, 8)) == 0, to_string(len(read_bytes_at(pmiss, 0, 8))), "0")
    // 7h. negative offset -> empty
    report("ranged_neg_offset_empty", len(read_bytes_at(pseq, 0 - 5, 8)) == 0, to_string(len(read_bytes_at(pseq, 0 - 5, 8))), "0")

    // 7i. ranged preserves 0x00 / 0xFF
    let mut mark = []
    mark.push(0)
    mark.push(255)
    mark.push(0)
    mark.push(255)
    let pmark = base + "_mark.dat"
    write_bytes(pmark, mark)
    let rmk = read_bytes_at(pmark, 0, 4)
    report("ranged_binary_extremes", arr_eq(rmk, mark), arr_str(rmk), arr_str(mark))

    // ---- 8. large file > 1MB, ranged read in the middle ----
    let big = base + "_big.dat"
    delete_file(big)
    let chunk = mkarr(0, 1024, 1)
    let mut w = 0
    while w < 1200 {
        write_bytes_append(big, chunk)
        w = w + 1
    }
    let bigsz = file_size(big)
    report("large_file_size", bigsz == 1228800, to_string(bigsz), "1228800")
    // ranged read at offset 500000 -> (500000+k) % 256
    let rb = read_bytes_at(big, 500000, 4)
    let mut wb = []
    let mut m = 0
    while m < 4 {
        wb.push((500000 + m) % 256)
        m = m + 1
    }
    report("large_ranged_mid", arr_eq(rb, wb), arr_str(rb), arr_str(wb))

    // ---- 9. write_bytes_append semantics ----
    let pap = base + "_append.dat"
    delete_file(pap)
    let mut a1 = []
    a1.push(1)
    a1.push(2)
    a1.push(3)
    let mut a2 = []
    a2.push(4)
    a2.push(5)
    a2.push(6)
    write_bytes(pap, a1)
    write_bytes_append(pap, a2)
    let rap = read_file_bytes(pap)
    let wap = mkarr(1, 7, 1)
    report("write_bytes_append", arr_eq(rap, wap), arr_str(rap), arr_str(wap))

    // ---- 10. append_file (text) ----
    let ptap = base + "_tappend.txt"
    delete_file(ptap)
    write_file(ptap, "AA")
    append_file(ptap, "BB")
    let rtap = read_file(ptap)
    report("append_file_text", rtap == "AABB", rtap, "AABB")

    // ---- 11. mkdir / list_dir ----
    let sub = dir + "/sub_xyz"
    mkdir(sub)
    write_file(sub + "/a.txt", "a")
    write_file(sub + "/b.txt", "b")
    let entries = list_dir(sub)
    report("list_dir_count", len(entries) == 2, to_string(len(entries)), "2")
    let emptydir = dir + "/empty_xyz"
    mkdir(emptydir)
    report("list_dir_empty", len(list_dir(emptydir)) == 0, to_string(len(list_dir(emptydir))), "0")
    report("list_dir_missing", len(list_dir(dir + "/nope_xyz")) == 0, to_string(len(list_dir(dir + "/nope_xyz"))), "0")

    // ---- 12. delete_file then exists ----
    let pdel = base + "_del.txt"
    write_file(pdel, "x")
    report("pre_delete_exists", file_exists(pdel), "false", "true")
    delete_file(pdel)
    report("post_delete_gone", file_exists(pdel) == false, "true", "false")

    // ---- 13. overwrite truncates ----
    let pov = base + "_ov.txt"
    write_file(pov, "longer content here")
    write_file(pov, "x")
    let rov = read_file(pov)
    report("overwrite_truncates", rov == "x", rov, "x")

    println("DONE")
}
