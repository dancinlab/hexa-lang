#!/usr/bin/env bash
# .githooks/pre-commit — runtime/codegen silent-wipe guard (early warning)
# Background: see inbox/notes/2026-05-22-wipe-governance-proposal.md
# Opt-in via:  git config core.hooksPath .githooks
#
# NOTE: enforcement (block/allow based on the commit subject + WIPE-OK
# trailer) lives in the companion .githooks/commit-msg hook, because the
# pre-commit phase cannot reliably read the final commit message
# (.git/COMMIT_EDITMSG is stale here; git only hands the message file to
# the commit-msg hook). This pre-commit hook only prints an EARLY WARNING
# when a large guarded deletion is staged, so the author sees it before
# the commit-msg gate fires. It never blocks.
set -euo pipefail

# ── no-hardcode gate (BLOCKING) ──────────────────────────────────────
# Machine-absolute paths (/Users/<me>/…, /home/<me>/…) break every other
# contributor's host. Block the commit when a staged .hexa line ADDS one.
# Net-new only (scans added lines) → no baseline, never flags existing
# drift. Portable: derive the hexa binary from env/PATH; if it cannot be
# found, skip the gate rather than fail the commit (s3 — no foreign path,
# no hard dependency on a fixed install location).
__hexa_bin="${HEXA:-}"
[ -x "$__hexa_bin" ] || __hexa_bin="$HOME/.hx/bin/hexa"
[ -x "$__hexa_bin" ] || __hexa_bin="$(command -v hexa 2>/dev/null || true)"
if [ -n "$__hexa_bin" ] && [ -x "$__hexa_bin" ] && [ -f tool/no_hardcode_lint.hexa ]; then
  if ! "$__hexa_bin" run tool/no_hardcode_lint.hexa --staged; then
    echo "" >&2
    echo "✗ commit blocked — a staged .hexa line adds a machine-absolute/hardcoded path." >&2
    echo "  derive it from env (\$HOME / \$HEXA_LANG / pwd), or mark the line @const" >&2
    echo "  if the literal is genuinely portable/intentional." >&2
    exit 1
  fi
fi

# stdlib malformed-input guard-convention lint — ADVISORY (warn, never blocks).
# Flags newly-added `arr[0]` / `/ divisor` sites with no empty/zero guard in the
# same fn (the QA bug class, #3943..#3963; census state/guard_class_census.py).
# Heuristic → warn only, so it informs without gating on false positives.
if [ -n "$__hexa_bin" ] && [ -x "$__hexa_bin" ] && [ -f tool/stdlib_guard_lint.hexa ]; then
  "$__hexa_bin" run tool/stdlib_guard_lint.hexa --changed --mode=warn 2>/dev/null || true
fi

# Paths we guard (matched against `git diff --cached`)
GUARD_GLOBS=(
  'stdlib/runtime/'
  'self/runtime.c'
  'self/runtime_core.c'
  'self/runtime_arena.c'
  'self/codegen_c2.hexa'
  'compiler/check/bind.hexa'
  'self/rt/core.hexa'
)

# Sum staged deletions in guarded paths
dels=$(git diff --cached --numstat -- "${GUARD_GLOBS[@]}" 2>/dev/null \
  | awk '{ sum += $2 } END { print sum+0 }')

if [ "${dels:-0}" -lt 50 ]; then
  exit 0
fi

echo ""
echo "------------------------------------------------------------"
echo "NOTICE: pre-commit silent-wipe guard (early warning)"
echo "------------------------------------------------------------"
echo "This commit stages ${dels} deleted lines in runtime/codegen"
echo "guarded paths. The commit-msg hook will BLOCK it unless the"
echo "subject mentions runtime|stdlib|codegen|restore|... or the body"
echo "carries a 'WIPE-OK: <reason>' trailer."
echo ""
echo "Guarded files with staged deletions:"
git diff --cached --numstat -- "${GUARD_GLOBS[@]}" \
  | awk '$2 > 0 { printf "  -%-5d %s\n", $2, $3 }'
echo "------------------------------------------------------------"
# Informational only — do not block here.
exit 0
