// RT-NATIVE Z2c: hexa_eq (HexaVal equality) ported to native .hexa using the
// UNLOCK-2 @tag intrinsic (__hx_tag) — no `bl _hexa_eq` C call. Mirrors
// runtime_core.c hexa_eq's tag-dispatch. TAG enum: INT0 FLOAT1 BOOL2 STR3
// VOID4 ARRAY5 MAP6 FN7 CHAR8 CLOSURE9 VALSTRUCT10 ENUM11.
//
// Scalar scope (this port): int / float / bool / string / void / char, plus
// the cross-type int↔float numeric coercion that C does BEFORE the tag check.
// Container deep-eq (array/map/enum/struct/fn/closure) is out of scope here —
// those re-enter hexa_eq recursively in C and aren't expressible as pure
// scalar comparisons; this port covers the scalar surface the task names.
fn rt_eq_native(a, b) -> bool {
    let ta = __hx_tag(a)
    let tb = __hx_tag(b)
    // Cross-type numeric equality (int↔float) — matches C hexa_eq which
    // coerces BEFORE the tag-mismatch early-out. `a == b` on a mixed
    // int/float pair lowers to the same double-compare in native codegen.
    if ta == 0 && tb == 1 { return a == b }   // INT vs FLOAT
    if ta == 1 && tb == 0 { return a == b }   // FLOAT vs INT
    // Tags differ (and not the numeric cross-pair) → not equal.
    if ta != tb { return false }
    // Same tag: scalar value compare via the native == operator. For INT,
    // FLOAT, BOOL, STR (content), VOID, CHAR this is exactly C's per-case
    // rule. `==` on two strings is content compare (hexa_str_eq), matching
    // C's strcmp fallback.
    if ta == 0 { return a == b }              // int  : HX_INT == HX_INT
    if ta == 1 { return a == b }              // float: HX_FLOAT == HX_FLOAT
    if ta == 2 { return a == b }              // bool : HX_BOOL == HX_BOOL
    if ta == 3 { return a == b }              // str  : content compare
    if ta == 4 { return true }                // void : always equal
    if ta == 8 { return a == b }              // char : code-point compare
    // Containers / fn / closure / valstruct / enum — out of scope for this
    // scalar port; defer to the builtin by returning its result.
    return a == b
}

// Tiny helper so mixed-tag values reach the builtin `==` THROUGH a dynamic
// (untyped) call boundary. The native typechecker rejects a literal mixed
// comparison like `1 == true` / `1 == 1.0` at compile time (HX3001), so we
// route the same two HexaVals through `c_eq(a, b)` where the params are
// dynamic — this exercises the SAME runtime hexa_eq (`bl _hexa_eq`) the C
// builtin uses, and is the honest ground-truth oracle.
fn c_eq(a, b) -> bool {
    return a == b
}

fn main() {
    // Each pair: rt_eq_native(a,b) vs the builtin c_eq(a,b) (= C hexa_eq).
    // Must match.
    let mut match_count = 0
    let mut total = 0

    // (1,1) → true
    total = total + 1
    if rt_eq_native(1, 1) == c_eq(1, 1) { match_count = match_count + 1 }
    else { println("MISMATCH (1,1)") }

    // (1,2) → false
    total = total + 1
    if rt_eq_native(1, 2) == c_eq(1, 2) { match_count = match_count + 1 }
    else { println("MISMATCH (1,2)") }

    // (1,1.0) → cross int/float
    total = total + 1
    if rt_eq_native(1, 1.0) == c_eq(1, 1.0) { match_count = match_count + 1 }
    else { println("MISMATCH (1,1.0)") }

    // ("a","a") → true (content)
    total = total + 1
    if rt_eq_native("a", "a") == c_eq("a", "a") { match_count = match_count + 1 }
    else { println("MISMATCH (a,a)") }

    // ("a","b") → false
    total = total + 1
    if rt_eq_native("a", "b") == c_eq("a", "b") { match_count = match_count + 1 }
    else { println("MISMATCH (a,b)") }

    // (true,true) → true
    total = total + 1
    if rt_eq_native(true, true) == c_eq(true, true) { match_count = match_count + 1 }
    else { println("MISMATCH (true,true)") }

    // (1,true) → different tag (int vs bool) → false
    total = total + 1
    if rt_eq_native(1, true) == c_eq(1, true) { match_count = match_count + 1 }
    else { println("MISMATCH (1,true)") }

    // (1.5,1.5) → true
    total = total + 1
    if rt_eq_native(1.5, 1.5) == c_eq(1.5, 1.5) { match_count = match_count + 1 }
    else { println("MISMATCH (1.5,1.5)") }

    println("native-vs-C eq match: " + match_count.to_string() + "/" + total.to_string())
    exit(match_count)
}
