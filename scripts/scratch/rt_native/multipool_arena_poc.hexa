// RT-NATIVE M5-alloc-b1 PoC — multi-pool fixed-table bump arena over raw mmap.
//
// De-circularized blueprint for self/rt/alloc.hexa: the pool list lives in RAW
// MEMORY (a fixed mmap'd table addressed by __hx_ptr_load64/store64), NOT a hexa
// `[ArenaPool]` array + `.push()`. Removes the F-M5-ALLOC-CIRCULAR-DEP cycle
// (arena-alloc -> array-push-grow -> arena-alloc).
//
// GLOBAL-FREE form: ALL arena state (pool count + pool table) lives in the mmap'd
// table region itself, threaded by its base `tbl` (an int). This sidesteps the
// measured codegen gap where a module-global `let mut` int emits as an undefined
// `g0` symbol in standalone native-emit (read-half avoided this by having no
// global state — every accessor takes its container as an arg). The runtime.c
// glue can hold the single `tbl` int in a C global and call arena_alloc(tbl,n).
//
// Linux x86_64 ABI: mmap=9 (addr,len,prot,flags,fd,off), munmap=11.
//   prot = 3 (PROT_READ|PROT_WRITE), flags = 0x22 (MAP_PRIVATE|MAP_ANONYMOUS)
//
// Table layout: header row [np @0] then pool i header at tbl + 24 + i*24 ->
//   {base @+0, size @+8, used @+16}.

fn POOL() -> int { return 1048576 }   // 1 MB per pool page
fn MAXP() -> int { return 256 }       // up to 256 MB / arena

fn arena_init() -> int {
    let tbl = __hx_syscall6(9, 0, (MAXP() + 1) * 24, 3, 34, -1, 0)
    if tbl <= 0 { return tbl }
    __hx_ptr_store64(tbl, 0, 0)   // np = 0 in the header row
    return tbl
}

fn a_np(tbl: int) -> int { return __hx_ptr_load64(tbl, 0) }
fn a_set_np(tbl: int, n: int) { __hx_ptr_store64(tbl, 0, n) }

fn p_base(tbl: int, i: int) -> int { return __hx_ptr_load64(tbl, 24 + i * 24) }
fn p_size(tbl: int, i: int) -> int { return __hx_ptr_load64(tbl, 24 + i * 24 + 8) }
fn p_used(tbl: int, i: int) -> int { return __hx_ptr_load64(tbl, 24 + i * 24 + 16) }
fn p_set_base(tbl: int, i: int, v: int) { __hx_ptr_store64(tbl, 24 + i * 24, v) }
fn p_set_size(tbl: int, i: int, v: int) { __hx_ptr_store64(tbl, 24 + i * 24 + 8, v) }
fn p_set_used(tbl: int, i: int, v: int) { __hx_ptr_store64(tbl, 24 + i * 24 + 16, v) }

// Map a new pool page + record it in the table (replaces new_pools.push(pool)).
fn arena_grow(tbl: int) {
    let n = a_np(tbl)
    let base = __hx_syscall6(9, 0, POOL(), 3, 34, -1, 0)
    p_set_base(tbl, n, base)
    p_set_size(tbl, n, POOL())
    p_set_used(tbl, n, 0)
    a_set_np(tbl, n + 1)
}

fn align8(n: int) -> int { return ((n + 7) / 8) * 8 }

fn arena_alloc(tbl: int, size: int) -> int {
    let a = align8(size)
    if a_np(tbl) == 0 { arena_grow(tbl) }
    let cur = a_np(tbl) - 1
    if p_used(tbl, cur) + a > p_size(tbl, cur) { arena_grow(tbl) }
    let c = a_np(tbl) - 1
    let addr = p_base(tbl, c) + p_used(tbl, c)
    p_set_used(tbl, c, p_used(tbl, c) + a)
    return addr
}

// mark encodes {pool_idx, used} into one int: pool_idx*(POOL+1) + used.
fn arena_mark(tbl: int) -> int {
    if a_np(tbl) == 0 { return -1 }
    let cur = a_np(tbl) - 1
    return cur * (POOL() + 1) + p_used(tbl, cur)
}

fn arena_rewind(tbl: int, mark: int) {
    if mark < 0 {
        let mut i = 0
        while i < a_np(tbl) { __hx_syscall6(11, p_base(tbl, i), p_size(tbl, i), 0, 0, 0, 0)  i = i + 1 }
        a_set_np(tbl, 0)
        return
    }
    let pidx = mark / (POOL() + 1)
    let used = mark - pidx * (POOL() + 1)
    let mut i = a_np(tbl) - 1
    while i > pidx { __hx_syscall6(11, p_base(tbl, i), p_size(tbl, i), 0, 0, 0, 0)  i = i - 1 }
    a_set_np(tbl, pidx + 1)
    p_set_used(tbl, pidx, used)
}

fn arena_reset(tbl: int) {
    let mut i = 0
    while i < a_np(tbl) { __hx_syscall6(11, p_base(tbl, i), p_size(tbl, i), 0, 0, 0, 0)  i = i + 1 }
    a_set_np(tbl, 0)
}

fn main() {
    let tbl = arena_init()
    if tbl <= 0 { exit(2) }

    // Three 400KB allocs: pool0 holds 2 (800000 < 1MB), 3rd forces a grow -> pool1.
    let p0 = arena_alloc(tbl, 400000)
    __hx_ptr_store64(p0, 0, 111)
    let p1 = arena_alloc(tbl, 400000)
    __hx_ptr_store64(p1, 0, 222)
    let p2 = arena_alloc(tbl, 400000)
    __hx_ptr_store64(p2, 0, 333)

    if __hx_ptr_load64(p0, 0) + __hx_ptr_load64(p1, 0) + __hx_ptr_load64(p2, 0) != 666 { exit(3) }
    if a_np(tbl) != 2 { exit(4) }

    // mark -> alloc -> rewind: a fresh alloc must reuse the marked address.
    let m = arena_mark(tbl)
    let pt = arena_alloc(tbl, 1000)
    __hx_ptr_store64(pt, 0, 999)
    arena_rewind(tbl, m)
    let pt2 = arena_alloc(tbl, 1000)
    if pt2 != pt { exit(5) }

    arena_reset(tbl)
    if a_np(tbl) != 0 { exit(6) }

    exit(0)
}
