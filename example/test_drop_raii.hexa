// ═══════════════════════════════════════════════════════════
//  test_drop_raii.hexa — Drop trait / RAII first slice (opt-in)
//  SSOT: state/rfc_drop_raii.md
//
//  Demonstrates the Drop-trait surface (an `impl` method named
//  `drop(self)`) + the explicit `drop x` point. Uses ONLY existing
//  keywords (struct/impl/drop) — no new syntax (frozen-parser-safe).
//
//  DEFAULT build (HEXA_DROP_RAII unset): `drop x` is a no-op (arena
//  memory model), so this program runs and PASSES unchanged — the
//  cleanup log stays empty. The codegen emit is byte-identical to the
//  pre-slice compiler (the gated branch is unreachable).
//
//  OPT-IN build (HEXA_DROP_RAII=1): `drop res` lowers to a runtime
//  type-dispatched Resource__drop(res), so the cleanup log records the
//  released fd — deterministic resource release à la Rust Drop /
//  C++ RAII, orthogonal to the arena.
// ═══════════════════════════════════════════════════════════

let mut cleanup_log = []
let mut pass_count = 0
let mut fail_count = 0

fn check(name, actual, expected) {
    if to_string(actual) == to_string(expected) {
        println("[PASS] " + name)
        pass_count = pass_count + 1
    } else {
        println("[FAIL] " + name + " — expected: " + to_string(expected) + ", got: " + to_string(actual))
        fail_count = fail_count + 1
    }
}

// A resource-owning value: the arena frees the struct, but the fd
// inside it must be released explicitly (this is what Drop buys).
struct Resource { fd: i64 }

impl Resource {
    // The Drop convention: an impl method named `drop` taking self.
    fn drop(self) {
        cleanup_log.push("released:" + to_string(self.fd))
    }
}

println("═══════════════════════════════════════════════════════")
println("  HEXA Drop / RAII (opt-in slice) Tests")
println("═══════════════════════════════════════════════════════")

let r = Resource { fd: 7 }
check("resource fd readable before drop", r.fd, 7)

// Explicit Drop point. DEFAULT: no-op. HEXA_DROP_RAII=1: Resource__drop(r).
drop r

// In DEFAULT mode the cleanup_log is empty (drop = no-op). We assert the
// DEFAULT-mode invariant here so the test is green on the shipped compiler;
// the flag-ON behavior (cleanup_log == ["released:7"]) is verified on a
// build host per RFC §7.
check("default-mode: drop is a no-op (arena model)", len(cleanup_log), 0)

// The Drop method is still a normal callable method (parses + dispatches),
// independent of the `drop` keyword — exercise it directly to prove the
// impl surface is real.
let r2 = Resource { fd: 11 }
r2.drop()
check("explicit drop() method call runs", to_string(cleanup_log), to_string(["released:11"]))

println("═══════════════════════════════════════════════════════")
let total = pass_count + fail_count
println("  Results: " + to_string(pass_count) + " PASS / " + to_string(fail_count) + " FAIL / " + to_string(total) + " total")
if fail_count == 0 {
    println("  ALL DROP/RAII SLICE TESTS PASSED!")
} else {
    println("  SOME TESTS FAILED")
}
println("═══════════════════════════════════════════════════════")
