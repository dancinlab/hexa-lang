#!/usr/bin/env bash
# tool/build_bf16_own_smoke — r3-cublas-independence r2 BF16 own-GEMM production smoke.
# Uses the committed runtime_cuda.c + runtime_bf16.c (regenerated on mini; aiden
# hexa-run is unreliable), nvcc-builds the CUDA runtime, links tool/cuda_bf16_verify.c
# against the STABLE-install prebuilt runtime.a (cores + matching self/runtime.c),
# runs own (default) + cuBLAS (HEXA_BF16_OWN=0), compares own-vs-cuBLAS rel-RMS.
# Run on aiden (RTX 5070 sm_120) AFTER a `curl install.sh | sh` STABLE refresh so the
# prebuilt runtime.a cores match the generated self/runtime.c (avoid edge seed drift).
set -euo pipefail
REPO="$(cd "$(dirname "$0")/.." && pwd)"; cd "$REPO"
CUDA_HOME="${CUDA_HOME:-/usr/local/cuda}"
SM="${SM:-120}"
PREBUILT_RT="${PREBUILT_RT:-$HOME/.hx/bin/build/runtime.a}"
CINC="$CUDA_HOME/targets/x86_64-linux/include"
CLIB="$CUDA_HOME/targets/x86_64-linux/lib"
export PATH="$CUDA_HOME/bin:$PATH"
mkdir -p build/cuda; B=build/cuda
rm -f "$B"/*.o 2>/dev/null || true

echo "=== probe ==="; nvcc --version | grep -i release
[ -f "$PREBUILT_RT" ] || { echo "no prebuilt runtime.a at $PREBUILT_RT"; exit 1; }
# self/runtime.c is generated by the install matching the prebuilt runtime.a.
SELF_RT="${SELF_RT:-$HOME/.hx/bin/self/runtime.c}"
[ -f "$SELF_RT" ] || SELF_RT="self/runtime.c"
[ -f "$SELF_RT" ] || { echo "no generated runtime.c (run install first)"; exit 1; }
echo "[smoke] using runtime.c = $SELF_RT  +  prebuilt = $PREBUILT_RT"

echo "=== committed runtime_bf16.c own-kernel present? ==="
grep -q "_hx_k_gemm_bf16_owngemm" self/cuda/runtime_bf16.c || { echo "FATAL: own bf16 kernel missing from committed runtime_bf16.c"; exit 1; }

echo "=== extract RT-NATIVE cores from the matching prebuilt ==="
( cd "$B" && ar x "$PREBUILT_RT" )
CORES="$(ls "$B"/*_native.o 2>/dev/null | tr '\n' ' ')"
[ -n "$CORES" ] || { echo "no *_native.o cores"; exit 1; }
# host runtime.o lives in the same archive (excluded from the *_native.o glob).
( cd "$B" && ar x "$PREBUILT_RT" runtime.o )

echo "=== nvcc runtime_cuda.o (sm_$SM) + dlink ==="
nvcc -x cu -DHEXA_CUDA -rdc=true -gencode arch=compute_$SM,code=sm_$SM -O2 -w \
     -I "$CINC/cccl" -I "$CINC" -I self -I self/cuda -I . \
     -c self/cuda/runtime_cuda.c -o "$B/runtime_cuda.o"
nvcc -dlink -gencode arch=compute_$SM,code=sm_$SM "$B/runtime_cuda.o" \
     -o "$B/runtime_cuda_dlink.o" -lcudadevrt

echo "=== host runtime.o needs HEXA_CUDA -> recompile self/runtime.c (matching the prebuilt) ==="
# The archived runtime.o is the CPU build; the bf16/cuda device entry points are in
# runtime_cuda.o. We DO NOT recompile runtime.c (the prebuilt runtime.o + its cores are
# a matched set); the bf16 path is pure runtime_cuda.o, which the harness calls directly.

echo "=== link bf16 smoke harness ==="
gcc -O2 -w -c tool/cuda_bf16_verify.c -o "$B/bf16_harness.o"
g++ -O2 "$B/bf16_harness.o" "$B/runtime.o" "$B/runtime_cuda.o" \
    "$B/runtime_cuda_dlink.o" $CORES \
    -L"$CLIB" -lcudart -lcublas -lcuda -lcudadevrt -lm -lpthread -lssl -lcrypto -ldl \
    -o "$B/bf16_smoke"

echo "### OWN (default) ###"
LD_LIBRARY_PATH="$CLIB:${LD_LIBRARY_PATH:-}" "$B/bf16_smoke"
echo "### cuBLAS (HEXA_BF16_OWN=0) ###"
HEXA_BF16_OWN=0 LD_LIBRARY_PATH="$CLIB:${LD_LIBRARY_PATH:-}" "$B/bf16_smoke"

echo "=== own-vs-cuBLAS-BF16 rel-RMS (the campaign gate, <=1e-2) ==="
python3 - <<'PY'
import struct, math
for S in (512,1024,2048):
    try:
        a=open(f"/tmp/bf16_own_{S}.bin","rb").read(); b=open(f"/tmp/bf16_cub_{S}.bin","rb").read()
    except FileNotFoundError: continue
    n=len(a)//8
    av=struct.unpack(f"<{n}d",a); bv=struct.unpack(f"<{n}d",b)
    se=sum((x-y)**2 for x,y in zip(av,bv)); sr=sum(y*y for y in bv)
    rr=math.sqrt(se/n)/math.sqrt(sr/n) if sr>0 else 0.0
    print(f"  S={S}  own-vs-cuBLAS-BF16 rel-RMS = {rr:.3e}  (gate<=1e-2: {'PASS' if rr<=1e-2 else 'FAIL'})")
PY
echo "=== DONE ==="
