#!/usr/bin/env bash
# tool/build_bf16_own_smoke — r3-cublas-independence r2 BF16 own-GEMM production smoke.
# Regen runtime_cuda.c + runtime_bf16.c from the emitter SSOT, nvcc-build a CUDA
# runtime, link tool/cuda_bf16_verify.c, run own (default) + cuBLAS (HEXA_BF16_OWN=0),
# and compare own-vs-cuBLAS rel-RMS. Run on aiden (RTX 5070 sm_120).
set -euo pipefail
REPO="$(cd "$(dirname "$0")/.." && pwd)"; cd "$REPO"
CUDA_HOME="${CUDA_HOME:-/usr/local/cuda}"
SM="${SM:-120}"
PREBUILT_RT="${PREBUILT_RT:-$HOME/.hx/bin/build/runtime.a}"
HEXA="${HEXA:-$(command -v hexa || echo $HOME/.local/bin/hexa)}"
CINC="$CUDA_HOME/targets/x86_64-linux/include"
CLIB="$CUDA_HOME/targets/x86_64-linux/lib"
export PATH="$CUDA_HOME/bin:$PATH"
mkdir -p build/cuda; B=build/cuda

echo "=== probe ==="; nvcc --version | grep -i release
[ -f self/runtime.c ] || { echo "no self/runtime.c (run a hexa build/install first to generate it)"; exit 1; }

echo "=== use committed runtime_bf16.c + runtime_cuda.c (regenerated on mini; aiden hexa-run unreliable) ==="
grep -q "_hx_k_gemm_bf16_owngemm" self/cuda/runtime_bf16.c || { echo "FATAL: own bf16 kernel missing from committed runtime_bf16.c"; exit 1; }

echo "=== nvcc runtime_cuda.o (sm_$SM) + dlink ==="
nvcc -x cu -DHEXA_CUDA -rdc=true -gencode arch=compute_$SM,code=sm_$SM -O2 -w \
     -I "$CINC/cccl" -I "$CINC" -I self -I self/cuda -I . \
     -c self/cuda/runtime_cuda.c -o "$B/runtime_cuda.o"
nvcc -dlink -gencode arch=compute_$SM,code=sm_$SM "$B/runtime_cuda.o" \
     -o "$B/runtime_cuda_dlink.o" -lcudadevrt

echo "=== host runtime.o (-DHEXA_CUDA, C fallbacks for native seeds) ==="
# NOTE: deliberately NO -DHEXA_RT_*_NATIVE flags. The prebuilt runtime.a cores can
# be internally inconsistent across edge/stable installs (runtime.o references a
# seed no extracted core defines — e.g. rt_array_arena_alloc_items_native /
# rt_map_set_inplace_native). The GEMM-bf16 path does not depend on native
# array/map/intern/alloc seeds (C fallbacks are functionally identical), so we
# compile the host runtime.o with the portable C bodies and avoid the seed link
# whack-a-mole entirely. This is a SMOKE harness, not a byteeq build.
gcc -O2 -D_GNU_SOURCE -DHEXA_HAS_OPENSSL -DHEXA_CUDA -w \
    -I self -I . -I "$CINC" -c self/runtime.c -o "$B/runtime_cuda_host.o"

echo "=== link bf16 smoke harness ==="
gcc -O2 -w -c tool/cuda_bf16_verify.c -o "$B/bf16_harness.o"
g++ -O2 "$B/bf16_harness.o" "$B/runtime_cuda_host.o" "$B/runtime_cuda.o" \
    "$B/runtime_cuda_dlink.o" \
    -L"$CLIB" -lcudart -lcublas -lcuda -lcudadevrt -lm -lpthread -lssl -lcrypto -ldl \
    -o "$B/bf16_smoke"

echo "### OWN (default) ###"
LD_LIBRARY_PATH="$CLIB:${LD_LIBRARY_PATH:-}" "$B/bf16_smoke"
echo "### cuBLAS (HEXA_BF16_OWN=0) ###"
HEXA_BF16_OWN=0 LD_LIBRARY_PATH="$CLIB:${LD_LIBRARY_PATH:-}" "$B/bf16_smoke"

echo "=== own-vs-cuBLAS-BF16 rel-RMS (the campaign gate, <=1e-2) ==="
python3 - <<'PY'
import struct, math
for S in (512,1024,2048):
    try:
        a=open(f"/tmp/bf16_own_{S}.bin","rb").read(); b=open(f"/tmp/bf16_cub_{S}.bin","rb").read()
    except FileNotFoundError: continue
    n=len(a)//8
    av=struct.unpack(f"<{n}d",a); bv=struct.unpack(f"<{n}d",b)
    se=sum((x-y)**2 for x,y in zip(av,bv)); sr=sum(y*y for y in bv)
    rr=math.sqrt(se/n)/math.sqrt(sr/n) if sr>0 else 0.0
    print(f"  S={S}  own-vs-cuBLAS-BF16 rel-RMS = {rr:.3e}  (gate<=1e-2: {'PASS' if rr<=1e-2 else 'FAIL'})")
PY
echo "=== DONE ==="
