#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────
# tool/stage_precompile_package — Stage 3 (precompile) + Package, SHARED by
# release.yml + nobaseline-gate.yml. Single source of truth so the gate can
# NEVER drift from release (the 5th-failure root cause: release's inline
# Stage 3 was MISSING the HEXA_PREBUILT_RUNTIME export that the gate had).
#
# Env contract (caller sets):
#   TARGET                — darwin-arm64 | linux-x86_64 | linux-arm64 (required)
#   HEXA_PREBUILT_RUNTIME — path to build/runtime.a (defaults to $PWD/build/runtime.a)
#   HEXA_MAC_BUILD_OK     — set "1" by the darwin caller (step-env), flows in
#                           naturally; NOT baked here.
# ─────────────────────────────────────────────────────────────────────────
set -euo pipefail
: "${TARGET:?TARGET must be set (darwin-arm64|linux-x86_64|linux-arm64)}"

export HEXA_LANG="$PWD"
export HEXA_MODULE_LOADER="$PWD/build/hexa_module_loader"
export PATH="$PWD:$PATH"
# THE FIX — export the prebuilt runtime so the `hexa build` DRIVER (invoked by
# build_precompile per manifest entry) links runtime.a instead of compiling
# the (possibly-removed) self/runtime.c. No-op when seeds present (the driver
# still finds runtime.c; the prebuilt path is taken only when it exists).
export HEXA_PREBUILT_RUNTIME="${HEXA_PREBUILT_RUNTIME:-$PWD/build/runtime.a}"

echo "[stage_precompile_package] TARGET=$TARGET HEXA_PREBUILT_RUNTIME=$HEXA_PREBUILT_RUNTIME"

# ── Stage 3 — precompile shipped scripts ────────────────────────────────────
./hexa run tool/build_precompile.hexa
ls -la release/precompile/
test -d release/precompile
test "$(ls -1 release/precompile/ | wc -l)" -gt 0

# ── Package — assemble tarball (parity with release) ────────────────────────
stage="dist/hexa-${TARGET}"
mkdir -p "$stage/build" "$stage/release/precompile"
# axis-① marker-decouple PR-1: stamp a neutral hxroot sentinel so resolve_hxroot()
# (self/main.hexa) can identify the install root WITHOUT keying on self/native/hexa_cc.c
# — the very C-transpile file axis-① deletes. Additive/producer-only (no compiler change
# this PR); the resolver swap that consumes it is a follow-on. See state/hexa-own/
# axis1_hxroot_marker_decouple.md.
printf 'hexa-root v1\n' > "$stage/.hxroot"
cp hexa "$stage/hexa"
cp build/hexa_module_loader "$stage/build/hexa_module_loader"
# CUDA-R1 DUAL-RUNTIME (#3701 r2): the toolchain built + precompiled against the
# CPU build/runtime.a (libcuda-free, so hexa_v2 + the precompile binaries run on
# the GPU-less builder). The CONSUMER, however, must receive the cuBLAS-enabled
# archive so its `hexa build`/`run` links a real cuda GEMM body. When the cuda
# build produced build/runtime.cuda.a (HEXA_CUDA path), ship THAT as the tarball's
# build/runtime.a; else ship the CPU archive unchanged (every default target).
if [ -f build/runtime.cuda.a ]; then
    echo "[stage_precompile_package] CUDA-R1: shipping consumer cuda archive build/runtime.cuda.a as build/runtime.a (toolchain used the CPU runtime.a)"
    cp build/runtime.cuda.a "$stage/build/runtime.a"
    # SELF-CONTAINED (#cuda-self-contained): bundle the STATIC CUDA runtime next to
    # runtime.a so os_clang_ldflags links it statically → the consumer binary needs
    # ONLY the driver libcuda.so.1 at run time (no pip wheels / cuda-libs farm /
    # LD_LIBRARY_PATH). The toolkit (cudart-dev) present on the release builder ships
    # all four files. FATAL if any is missing — never ship a -cuda asset that would
    # silently fall back to dynamic cudart on the consumer.
    _cs_d="${CUDA_HOME:-/usr/local/cuda}"
    _cs_L="$_cs_d/targets/x86_64-linux/lib"
    [ -f "$_cs_L/libcudart_static.a" ] || _cs_L="$_cs_d/lib64"
    mkdir -p "$stage/build/cuda-static/stubs"
    for _f in libcudart_static.a libculibos.a libcudadevrt.a; do
        if [ ! -f "$_cs_L/$_f" ]; then
            echo "[stage_precompile_package] FATAL: -cuda asset needs $_cs_L/$_f (static CUDA runtime) — cudart-dev toolkit missing at package time" >&2
            exit 1
        fi
        cp "$_cs_L/$_f" "$stage/build/cuda-static/"
    done
    if [ ! -f "$_cs_L/stubs/libcuda.so" ]; then
        echo "[stage_precompile_package] FATAL: -cuda asset needs $_cs_L/stubs/libcuda.so (driver link stub)" >&2
        exit 1
    fi
    cp "$_cs_L/stubs/libcuda.so" "$stage/build/cuda-static/stubs/"
    echo "[stage_precompile_package] CUDA-R1: bundled self-contained cuda-static/ (libcudart_static+libculibos+libcudadevrt+stubs/libcuda.so) from $_cs_L"
else
    cp build/runtime.a "$stage/build/runtime.a"
fi
# Ship the self-hosted transpiler too — post-PR2 (seeds git-removed) the
# `hexa cc --regen` step has no self/native/hexa_cc.c to bootstrap build/hexat
# from, so stage_prebuild_hexat must pull a prebuilt build/hexat from THIS edge
# tarball. Mirrors the runtime.a "frozen dough" precedent (#2019). Guarded so
# older trees without a built hexat still package cleanly (additive no-op).
[ -f build/hexat ] && cp build/hexat "$stage/build/hexat" || true
# r27 (ING #79 consumer-live): ship the native compiler `aprime_cc` so the
# default-ON `hexa run` native cold path (r26) actually ENGAGES on a fresh
# consumer install. resolve_native_cc() probes <install>/build/aprime_cc; if
# it is absent the r26 gate silently no-ops back to clang (the flip would be
# inert on consumers). aprime_cc IS the build_aprime.sh output (the same
# native --emit=obj compiler used by the cold path). Build it here if the
# build stage did not (it needs build/hexat + build/runtime.a, both staged
# above) so the toolchain that produced ./hexa also yields a matching
# aprime_cc. Guarded: a build failure leaves aprime_cc absent → the install
# falls back to the clang path cleanly (no regression, just not-yet-native).
if [ ! -x build/aprime_cc ]; then
    echo "[stage_precompile_package] r27: building native compiler build/aprime_cc (ING #79 default-ON cold path)"
    bash tool/build_aprime.sh -o build/aprime_cc || echo "[stage_precompile_package] r27: aprime_cc build failed — install will clang-fallback (no regression)"
fi
[ -x build/aprime_cc ] && cp build/aprime_cc "$stage/build/aprime_cc" || true
cp -R release/precompile/. "$stage/release/precompile/"
tar -czf "hexa-${TARGET}.tar.gz" -C dist "hexa-${TARGET}"

n=$(tar -tzf "hexa-${TARGET}.tar.gz" | grep -cE "hexa-${TARGET}/release/precompile/[^/]+$" || true)
echo "[stage_precompile_package] tarball precompile entries: $n"
test "$n" -gt 0
echo "[stage_precompile_package] PASS — hexa-${TARGET}.tar.gz"
