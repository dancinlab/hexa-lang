#!/usr/bin/env bash
# tool/build_no_cublas_smoke — piece ④ HEADLINE: build a forge cuda runtime with
# ZERO cuBLAS. Compiles runtime_cuda.c (which #includes runtime_bf16.c at its tail)
# with -DHEXA_NO_CUBLAS so every cublas* call-site #ifdef's to an own-kernel, then
# LINKS WITHOUT -lcublas. The proof: the TU links with no undefined cublas* symbol
# and a forge smoke (GEMM + gemv + outer + epilogue) produces correct output.
#
# Run on aiden (RTX 5070 sm_120) after a `hexa run` works (matched prebuilt runtime.a).
set -euo pipefail
REPO="$(cd "$(dirname "$0")/.." && pwd)"; cd "$REPO"
CUDA_HOME="${CUDA_HOME:-/usr/local/cuda-13.0}"
[ -d "$CUDA_HOME" ] || CUDA_HOME=/usr/local/cuda
SM="${SM:-120}"
PREBUILT_RT="${PREBUILT_RT:-$HOME/.hx/bin/build/runtime.a}"
HEXA="${HEXA:-$(command -v hexa || echo $HOME/.local/bin/hexa)}"
CINC="$CUDA_HOME/targets/x86_64-linux/include"
CLIB="$CUDA_HOME/targets/x86_64-linux/lib"
export PATH="$CUDA_HOME/bin:$PATH"
mkdir -p build/cuda; B=build/cuda; rm -f "$B"/*.o 2>/dev/null || true

echo "=== probe ==="; nvcc --version | grep -i release
[ -f "$PREBUILT_RT" ] || { echo "no prebuilt runtime.a at $PREBUILT_RT"; exit 1; }

echo "=== extract RT-NATIVE cores ==="
( cd "$B" && ar x "$PREBUILT_RT" )
CORES="$(ls "$B"/*_native.o 2>/dev/null | tr '\n' ' ')"
[ -n "$CORES" ] || { echo "no *_native.o cores"; exit 1; }

echo "=== regen runtime_bf16.c + runtime_cuda.c from emitter SSOT ==="
"$HEXA" run self/cuda/runtime_bf16_emit.hexa self/cuda/runtime_bf16.c >/dev/null
"$HEXA" run self/cuda/runtime_cuda_emit.hexa self/cuda/runtime_cuda.c >/dev/null

echo "=== nvcc runtime_cuda.o with -DHEXA_NO_CUBLAS (sm_$SM) + dlink ==="
nvcc -x cu -DHEXA_CUDA -DHEXA_NO_CUBLAS -rdc=true \
     -gencode arch=compute_$SM,code=sm_$SM -O2 -w \
     -I "$CINC/cccl" -I "$CINC" -I self -I self/cuda -I . \
     -c self/cuda/runtime_cuda.c -o "$B/runtime_cuda.o"
nvcc -dlink -gencode arch=compute_$SM,code=sm_$SM "$B/runtime_cuda.o" \
     -o "$B/runtime_cuda_dlink.o" -lcudadevrt

echo "=== ASSERT: no cublas symbols referenced by the object ==="
if nm "$B/runtime_cuda.o" 2>/dev/null | grep -i ' U cublas' ; then
  echo "FATAL: runtime_cuda.o still references undefined cublas* symbols"; exit 1
else
  echo "OK: no undefined cublas* symbols in runtime_cuda.o"
fi

echo "=== host runtime.o (-DHEXA_CUDA + RT-NATIVE flags) ==="
RTFLAGS="-DHEXA_RT_ARRAY_NATIVE=1 -DHEXA_RT_MAP_NATIVE=1 -DHEXA_RT_INTERN_NATIVE=1 -DHEXA_RT_ALLOC_NATIVE=1"
gcc -O2 -D_GNU_SOURCE -DHEXA_HAS_OPENSSL -DHEXA_CUDA $RTFLAGS -w \
    -I self -I . -I "$CINC" -c self/runtime.c -o "$B/runtime_cuda_host.o"

echo "=== link forge smoke harness WITHOUT -lcublas (the headline) ==="
gcc -O2 -w -c tool/cuda_no_cublas_smoke.c -o "$B/nocublas_harness.o"
# NOTE: link line has NO -lcublas. If any cublas* symbol survived a guard, this
# fails with an undefined-reference link error — that is the proof gate.
g++ -O2 "$B/nocublas_harness.o" "$B/runtime_cuda_host.o" "$B/runtime_cuda.o" \
    "$B/runtime_cuda_dlink.o" $CORES \
    -L"$CLIB" -lcudart -lcuda -lcudadevrt -lm -lpthread -lssl -lcrypto -ldl \
    -o "$B/nocublas_smoke"
echo "LINK_OK: forge cuda runtime linked with ZERO -lcublas"

echo "=== run forge smoke (own GEMM + gemv + outer + epilogue, correctness) ==="
LD_LIBRARY_PATH="$CLIB:${LD_LIBRARY_PATH:-}" "$B/nocublas_smoke"
echo "=== DONE ==="
