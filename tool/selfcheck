#!/usr/bin/env bash
# tool/selfcheck — post-pull build-hygiene gate (handoff #11).
#
# ── Why this exists (pool-host-stale-generated-artifacts-after-pull) ─────────
# On a pool host the workflow is `git pull` into an EXISTING checkout (NOT a
# fresh `install.sh` clone). The bootstrap build artifacts
#   self/runtime.c · self/runtime_core.c · self/runtime_hi_gen.c
#   self/native/hexa_cc.c · self/runtime.o · build/hexat
# are all .gitignore'd — they are GENERATED from tracked source SSOTs
# (self/runtime_core_emit.hexa, self/runtime_hi_gen_emit.hexa, self/codegen.hexa,
# the frozen seed blob 151c52c8, …). A `git pull` updates the tracked SSOTs but
# leaves the OLD generated `.c`/`hexat` on disk. The build then `#include`s /
# links the STALE generated text against the NEW source → the failures observed
# in the field:
#   · handoff #50: stale self/runtime_hi_gen.c rt_str_to_upper/to_lower/trim
#     DUPLICATE the native definitions runtime_core.c grew → clang-18 strict
#     `redefinition` error (compile fails).
#   · handoff #50: stale runtime (pre-#3462 x86_64 backend) → FILE* tag loss →
#     fseeko(0x4) SIGSEGV at runtime.
#   · handoff #52: shipped build/hexat is built from the stale gitignored seed
#     self/native/hexa_cc.c → emits PRE-fix behavior.
#
# This script is the INVALIDATE/REFRESH gate that makes a `git pull` safe:
# it detects when a generated artifact is stale relative to its tracked SSOT
# inputs, then INVALIDATES the stale artifacts (removes them) and restores a
# COHERENT runtime, in strict preference order:
#   (1) PREFER a fresh prebuilt build/runtime.a — compiled objects, self-coherent
#       by construction, no source recompile needed → the stale .c are irrelevant.
#   (2) else regenerate runtime_core.c + runtime_hi_gen.c TOGETHER from their
#       emitter SSOTs (a hexa runner on PATH); restore self/runtime.c from the
#       frozen blob only if absent.
#   (3) else (no archive, no runner) leave the stale .c INVALIDATED + warn that a
#       full build on a build host is needed to regenerate a coherent runtime.
# It is NOT a shadow guard: it deletes/regenerates the divergent bytes. Pairing
# the frozen runtime_core.c with a regenerated runtime_hi_gen.c is exactly the
# handoff #50 `redefinition of rt_str_to_upper` failure, so the regen is a PAIR.
#
# IDEMPOTENT — a second run with no intervening pull finds nothing stale and is
# a no-op. SAFE — only touches .gitignore'd generated artifacts; never a tracked
# file. NON-FATAL on a fresh tree (nothing to invalidate).
#
# Usage:
#   bash tool/selfcheck                 # detect + invalidate + refresh, exit 0 on success
#   bash tool/selfcheck --check         # detect only; exit 1 if stale (no mutation)
#   HEXA_SELFCHECK_NO_REFRESH=1 …       # invalidate stale artifacts but skip the
#                                       # restore_frozen_seeds refresh (build will regen)
#
# Intended invocation point: after `git pull` on a pool host (a post-merge git
# hook, or the pool refresh step) — run it before the next `hexa build`.
set -uo pipefail

# ── repo root (works from any cwd, any worktree) ────────────────────────────
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "[selfcheck] not inside a git repo — abort" >&2
  exit 2
}
cd "$ROOT" || exit 2

CHECK_ONLY=0
case "${1:-}" in
  --check) CHECK_ONLY=1 ;;
  "") ;;
  *) echo "[selfcheck] unknown arg: $1 (use --check)" >&2; exit 2 ;;
esac

# A generated artifact and the tracked SSOT input(s) it is derived from. If the
# artifact is OLDER than ANY of its SSOT inputs (mtime), it predates the current
# source and is stale. `git pull` / `git merge` update the working-tree mtime of
# every file it changes, so a pull that touched an emitter makes its artifact
# stale by this test; an artifact untouched by the pull stays cached.
#
# Format: "<generated-artifact>=<ssot1>[:<ssot2>...]"
#   self/runtime_core.c      ← runtime_core_emit.hexa
#   self/runtime_hi_gen.c    ← runtime_hi_gen_emit.hexa
#   self/native/hexa_cc.c    ← codegen.hexa (regenerated by `hexa cc --regen`)
#   self/runtime.o           ← self/runtime.c (compiled object)
#   build/hexat              ← self/native/hexa_cc.c (the transpiler binary)
ARTIFACTS=(
  "self/runtime_core.c=self/runtime_core_emit.hexa"
  "self/runtime_hi_gen.c=self/runtime_hi_gen_emit.hexa"
  "self/native/hexa_cc.c=self/codegen.hexa"
  "self/runtime.o=self/runtime.c"
  "build/hexat=self/native/hexa_cc.c:self/codegen.hexa"
)

stale_list=()

is_stale() {
  # $1 = artifact, rest = ssot inputs. Stale iff artifact exists and is older
  # than any present ssot input. An ABSENT artifact is NOT stale (the build will
  # create it from SSOT) — nothing to invalidate.
  local art="$1"; shift
  [ -e "$art" ] || return 1
  local s
  for s in "$@"; do
    [ -e "$s" ] || continue
    if [ "$s" -nt "$art" ]; then
      return 0                          # an SSOT input is newer → stale
    fi
  done
  return 1
}

echo "[selfcheck] repo: $ROOT"
echo "[selfcheck] HEAD: $(git rev-parse --short HEAD 2>/dev/null) ($(git rev-parse --abbrev-ref HEAD 2>/dev/null))"

for spec in "${ARTIFACTS[@]}"; do
  art="${spec%%=*}"
  ssot_field="${spec#*=}"
  IFS=':' read -r -a ssots <<< "$ssot_field"
  if is_stale "$art" "${ssots[@]}"; then
    echo "[selfcheck] STALE: $art (older than ${ssot_field})"
    stale_list+=("$art")
  fi
done

if [ "${#stale_list[@]}" -eq 0 ]; then
  echo "[selfcheck] ✓ no stale generated artifacts (build hygiene OK)"
else
  echo "[selfcheck] ${#stale_list[@]} stale artifact(s) detected"
fi

# --check: report only, exit code signals staleness, no mutation.
if [ "$CHECK_ONLY" -eq 1 ]; then
  [ "${#stale_list[@]}" -eq 0 ] && exit 0 || exit 1
fi

# ── invalidate the stale generated artifacts ────────────────────────────────
# Removing the divergent bytes is the invalidation: the next `hexa build` /
# `hexa cc --regen` / restore_frozen_seeds regenerates them from the current
# SSOT, so the build links fresh-vs-fresh instead of fresh-source-vs-stale-text.
if [ "${#stale_list[@]}" -gt 0 ]; then
  echo "[selfcheck] invalidating stale artifacts…"
  for art in "${stale_list[@]}"; do
    # never touch a tracked file (paranoia: these are all .gitignore'd, but
    # check-ignore guards against an artifact ever becoming tracked).
    if git check-ignore -q "$art" 2>/dev/null; then
      rm -f "$art" && echo "[selfcheck]   rm $art"
    else
      echo "[selfcheck]   SKIP $art — tracked, refusing to delete" >&2
    fi
  done
fi

# ── refresh, with a strict preference order ─────────────────────────────────
# A clean post-pull build needs a COHERENT runtime. There are two coherent
# sources, in preference order:
#
#   (1) build/runtime.a  — a prebuilt static archive (compiled objects). It is
#       self-coherent by construction (no #include text-merge → no redefinition)
#       and does NOT depend on regenerating the source `.c` at all. When present
#       AND not itself stale (newer than every runtime SSOT), it is the robust
#       link input: the stale source `.c` we invalidated above are simply not
#       needed, so a pull can never break the build. This is the PRIMARY path.
#
#   (2) regenerate the source `.c` from their emitter SSOTs (needs a hexa runner).
#       runtime_core.c + runtime_hi_gen.c MUST come from the emitters TOGETHER
#       (the emitter retired the rt_str_to_upper/to_lower/trim C bodies that the
#       frozen blob still carries — pairing frozen-core with regenerated-hi_gen
#       is the handoff #50 `redefinition` clang-18 failure). self/runtime.c is
#       restored from the frozen blob ONLY if ABSENT (its amalgam is otherwise
#       left intact; the frozen runtime.c blob has drifted from the emitter on
#       some weak symbols — float_to_bits moved into runtime_core.c — so we do
#       NOT overwrite a present runtime.c with the older frozen one).
#
# If NEITHER a fresh runtime.a NOR a runner is available, we restore the frozen
# seed set as a last resort and WARN that a full build on a build host (aiden)
# is required to regenerate a coherent runtime — selfcheck has done all it can
# offline (invalidated the stale text so the build won't link it).

# Is build/runtime.a present and fresh (newer than every runtime SSOT)?
_rt_a_ok=0
if [ -f "build/runtime.a" ]; then
  _rt_a_ok=1
  for s in self/runtime_core_emit.hexa self/runtime_hi_gen_emit.hexa self/codegen.hexa; do
    [ -e "$s" ] || continue
    if [ "$s" -nt "build/runtime.a" ]; then _rt_a_ok=0; break; fi
  done
fi

if [ "$_rt_a_ok" -eq 1 ]; then
  echo "[selfcheck] ✓ build/runtime.a present + fresh ($(wc -c < build/runtime.a | tr -d ' ') bytes)"
  echo "[selfcheck]   → PREFER as link input; stale source .c are irrelevant (clean build ready)"
elif [ "${HEXA_SELFCHECK_NO_REFRESH:-0}" = "1" ]; then
  echo "[selfcheck] · HEXA_SELFCHECK_NO_REFRESH=1 — stale .c invalidated; build [0-pre] will regen"
else
  [ -f "build/runtime.a" ] && \
    echo "[selfcheck] · build/runtime.a is itself STALE (older than a runtime SSOT) — regen from source"

  # Detect a hexa runner for emitter regen.
  _runner=""
  if command -v hexa-run >/dev/null 2>&1; then
    _runner="hexa-run"
  elif command -v hexa >/dev/null 2>&1; then
    _runner="hexa run"
  fi

  # Restore self/runtime.c from the frozen blob ONLY if absent (the build needs
  # the file to exist; we never overwrite a present, possibly-newer runtime.c).
  if [ ! -f "self/runtime.c" ] && [ -f "tool/restore_frozen_seeds" ]; then
    echo "[selfcheck] self/runtime.c absent — restoring frozen seed (tool/restore_frozen_seeds)…"
    if bash tool/restore_frozen_seeds && [ -f "self/runtime.c" ]; then
      echo "[selfcheck] ✓ self/runtime.c restored ($(wc -l < self/runtime.c | tr -d ' ') lines)"
    else
      echo "[selfcheck] ✗ restore_frozen_seeds failed — rebuild on a host with network" >&2
      exit 1
    fi
  fi

  # Regenerate the coherent runtime_core.c + runtime_hi_gen.c PAIR from emitters.
  if [ -n "$_runner" ]; then
    _regen_ok=1
    for pair in \
      "self/runtime_core_emit.hexa=self/runtime_core.c" \
      "self/runtime_hi_gen_emit.hexa=self/runtime_hi_gen.c" ; do
      _emit="${pair%%=*}"; _dst="${pair#*=}"
      [ -f "$_emit" ] || continue
      _tmp="$(mktemp -t selfcheck_regen.XXXXXX)" || { _regen_ok=0; continue; }
      if $_runner "$_emit" "$_tmp" >/dev/null 2>&1 && [ -s "$_tmp" ]; then
        cp -f "$_tmp" "$_dst"
        echo "[selfcheck] ✓ regenerated $_dst from $_emit (coherence pair)"
      else
        echo "[selfcheck] ⚠ regen of $_dst from $_emit failed (runner error)" >&2
        _regen_ok=0
      fi
      rm -f "$_tmp"
    done
    [ "$_regen_ok" -eq 1 ] || \
      echo "[selfcheck] ⚠ regen incomplete — build [0-pre] will retry on the build host" >&2
  else
    echo "[selfcheck] ⚠ no build/runtime.a and no hexa-run on PATH:" >&2
    echo "[selfcheck]   stale runtime_core.c/hi_gen.c were INVALIDATED (build won't link them)," >&2
    echo "[selfcheck]   but a coherent runtime can only be regenerated by a full build —" >&2
    echo "[selfcheck]   run \`hexa build\` on a build host (aiden) to regenerate from SSOT." >&2
  fi
fi

echo "[selfcheck] done — build hygiene restored, clean build ready"
exit 0
