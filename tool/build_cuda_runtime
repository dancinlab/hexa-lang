#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────
# tool/build_cuda_runtime — build the CUDA-enabled hexa runtime objects and
# the cuda_gemm_verify harness, then run the PRIMARY anima #2386 verdict
# (cuda_available 0→1 + GPU-vs-CPU GEMM speedup + rel-RMS correctness).
#
# Proven on the pool host `aiden` (RTX 5070, sm_120, nvcc 13.0):
#   BUILD=CUDA   cuda_available()=1  cuda_device_count()=1
#   [d=1024] CUDA 347 GFLOP/s vs CPU 22 GFLOP/s  → ~15x   rel_rms 4.3e-16
#   [d=2048] CUDA 404 GFLOP/s vs CPU 18 GFLOP/s  → ~25x   rel_rms 5.1e-16
#
# The default release build is CPU-only (no cuBLAS dep) — this is the OPT-IN
# CUDA path (HEXA_CUDA). self-host ≠ release: additive, does not change the
# default build or the byteeq fixpoint (the GPU path is runtime opt-in).
#
# Env:
#   CUDA_HOME   CUDA toolkit root      (default: /usr/local/cuda-13.0)
#   SM          GPU arch               (default: 120 for RTX 50-series)
#   PREBUILT_RT prebuilt CPU runtime.a (default: $HOME/.hx/bin/build/runtime.a)
#
# Extension-less (not .sh) per the tool/stage_* / tool/release_build precedent
# (sidecar hook blocks .sh Write/Edit). Invoke as `bash tool/build_cuda_runtime`.
# ─────────────────────────────────────────────────────────────────────────
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
cd "$REPO"

CUDA_HOME="${CUDA_HOME:-/usr/local/cuda-13.0}"
SM="${SM:-120}"
PREBUILT_RT="${PREBUILT_RT:-$HOME/.hx/bin/build/runtime.a}"
HEXA="${HEXA:-$HOME/.local/bin/hexa}"
CINC="$CUDA_HOME/targets/x86_64-linux/include"
CLIB="$CUDA_HOME/targets/x86_64-linux/lib"
export PATH="$CUDA_HOME/bin:$PATH"

mkdir -p build/cuda
B=build/cuda

echo "=== probe ==="
command -v nvcc >/dev/null || { echo "no nvcc on PATH ($CUDA_HOME/bin)"; exit 1; }
nvcc --version | grep -i release
nvidia-smi --query-gpu=name,compute_cap --format=csv,noheader || true
[ -f "$PREBUILT_RT" ] || { echo "no prebuilt runtime.a at $PREBUILT_RT (run a normal hexa build first)"; exit 1; }

echo "=== extract RT-NATIVE cores from prebuilt runtime.a (CUDA-independent) ==="
( cd "$B" && ar x "$PREBUILT_RT" )
# @convergence state=completed id=BUILD-CUDA-CORES-STALE value="fs_core_native.o 누락"
#   threshold="새 runtime.c native seed 추가 시 core-list 동기화"
#   — Root-cause fix (#3668 FS-R1 staleness): do NOT hand-enumerate the RT-NATIVE
#   cores. `ar x` above already extracted EVERY member of runtime.a into $B/,
#   so collect the *_native.o set DYNAMICALLY (rt_hi · array · map · intern · fs ·
#   str · alloc — whatever stage_resolve_runtime_a ar'd in for this target). A
#   hardcoded list goes stale whenever a new native seed lands in runtime.c (FS-R1
#   #887b2493f added fs_write_all_native → fs_core_native.o, which the old 5-entry
#   list omitted → harness link `undefined reference to fs_write_all_native`). The
#   glob auto-tracks future seeds, so the list can never drift again. runtime.o is
#   excluded by the *_native.o pattern (it is linked separately below).
CORES="$(ls "$B"/*_native.o 2>/dev/null | tr '\n' ' ')"
[ -n "$CORES" ] || { echo "no RT-NATIVE *_native.o cores extracted from $PREBUILT_RT — stale/non-native runtime.a?"; exit 1; }
echo "[build_cuda_runtime] RT-NATIVE cores (dynamic from runtime.a): $CORES"

echo "=== regen runtime_cuda.c + runtime_bf16.c from emitter SSOT ==="
"$HEXA" run self/cuda/runtime_bf16_emit.hexa self/cuda/runtime_bf16.c >/dev/null
"$HEXA" run self/cuda/runtime_cuda_emit.hexa self/cuda/runtime_cuda.c >/dev/null
# emitter must emit _hx_dt_exp_dev exactly once (ing-cuda-build dup-def fix)
n=$(grep -c '_hx_dt_exp_dev(double x) {' self/cuda/runtime_cuda.c || true)
[ "$n" = "1" ] || { echo "runtime_cuda.c has $n _hx_dt_exp_dev defs (expected 1) — emitter dup-def regressed"; exit 1; }

echo "=== nvcc runtime_cuda.o (sm_$SM) + device-link ==="
nvcc -x cu -DHEXA_CUDA -rdc=true -gencode arch=compute_$SM,code=sm_$SM -O2 -w \
     -I "$CINC/cccl" -I "$CINC" -I self -I self/cuda -I . \
     -c self/cuda/runtime_cuda.c -o "$B/runtime_cuda.o"
nvcc -dlink -gencode arch=compute_$SM,code=sm_$SM "$B/runtime_cuda.o" \
     -o "$B/runtime_cuda_dlink.o" -lcudadevrt

echo "=== host runtime.o (-DHEXA_CUDA + the RT-NATIVE flag set) ==="
RTFLAGS="-DHEXA_RT_ARRAY_NATIVE=1 -DHEXA_RT_MAP_NATIVE=1 -DHEXA_RT_INTERN_NATIVE=1 -DHEXA_RT_ALLOC_NATIVE=1"
gcc -O2 -D_GNU_SOURCE -DHEXA_HAS_OPENSSL -DHEXA_CUDA $RTFLAGS -w \
    -I self -I . -I "$CINC" -c self/runtime.c -o "$B/runtime_cuda_host.o"

echo "=== PRIMARY verify harness — CPU vs CUDA ==="
# (A) CPU-only: archived CPU runtime.o + cores
( cd "$B" && ar x "$PREBUILT_RT" runtime.o )
gcc -O2 -D_GNU_SOURCE -DHEXA_HAS_OPENSSL -w -I self -I . \
    tool/cuda_gemm_verify.c "$B/runtime.o" $CORES \
    -lm -lpthread -lssl -lcrypto -o "$B/gemm_cpu"
# (B) CUDA: host runtime.o (HEXA_CUDA) + runtime_cuda.o + dlink + cuBLAS/cudart
gcc -O2 -D_GNU_SOURCE -DHEXA_HAS_OPENSSL -DHEXA_CUDA -w -I self -I . -I "$CINC" \
    -c tool/cuda_gemm_verify.c -o "$B/harness_cuda.o"
g++ -O2 "$B/harness_cuda.o" "$B/runtime_cuda_host.o" "$B/runtime_cuda.o" \
    "$B/runtime_cuda_dlink.o" $CORES \
    -L"$CLIB" -lcudart -lcublas -lcuda -lcudadevrt -lm -lpthread -lssl -lcrypto -ldl \
    -o "$B/gemm_cuda"

echo "### CPU-only build ###"
"$B/gemm_cpu"
echo "### CUDA build (sm_$SM) ###"
LD_LIBRARY_PATH="$CLIB:${LD_LIBRARY_PATH:-}" "$B/gemm_cuda"
echo "=== DONE — CUDA runtime objects in $B/, harness binaries gemm_cpu / gemm_cuda ==="
