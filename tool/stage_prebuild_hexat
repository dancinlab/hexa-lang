#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────
# tool/stage_prebuild_hexat — build build/hexat (the self-hosted transpiler)
# from self/native/hexa_cc.c + runtime.a WHILE the seeds are still present.
# SHARED by release.yml + nobaseline-gate.yml.
#
# ── Why this exists (THE nobaseline gate-fail root cause) ────────────────────
# `hexa cc --regen` (used by stage_regen_hexa_cc to recreate a removed
# hexa_cc.c) transpiles the 4 SSOT modules by driving a `build/hexat` binary.
# When build/hexat is absent it tries to BOOTSTRAP one via cmd_cc, which
# clang-compiles self/runtime.c → runtime.o then self/native/hexa_cc.c +
# runtime.o → build/hexat.
#
# In the nobaseline gate, ALL 23 seeds (including self/runtime.c AND
# self/native/hexa_cc.c) are removed BEFORE Stage 0a regen, so that bootstrap
# clang fails ("no such file: ./self/runtime.c") → build/hexat never appears →
# `hexa cc --regen` reports "hexat not found" → FATAL. (The edge `hexa` asset
# is the stale 0.1.0-dispatch release whose in-process 2-arg transpile only
# emits a stub, so it cannot self-serve as the transpiler either.)
#
# final3 succeeds at the SAME `hexa cc --regen` purely by accident of ordering:
# its section C runs the emitter while runtime.c + hexa_cc.c are still present,
# which bootstraps build/hexat; section A then reuses that binary after removal.
#
# This script makes that ordering EXPLICIT and shared: build build/hexat from
# the seeds up-front (Stage 0b time, seeds present), so the later removal +
# `hexa cc --regen` finds a ready transpiler and reuses it (no re-bootstrap).
#
# Verified (ubu-1, linux-x86_64): prebuild hexat → remove all 23 seeds →
# `hexa cc --regen` → 948326-byte hexa_cc.c.new, rc=0.
#
# Env contract (caller sets, same as Stage 0b):
#   CC                    — C compiler (clang|gcc)
#   LIBS                  — link libs ("" | "-lm -ldl")
#   CFLAGS_COMMON         — (optional) base CFLAGS
#   HEXA_PREBUILT_RUNTIME — prebuilt runtime.a (Stage 0b output)
#
# No-op-safe for release: release never removes seeds, so a prebuilt build/hexat
# is simply a ready transpiler (does not change any emitted bytes).
# ─────────────────────────────────────────────────────────────────────────
set -euo pipefail
: "${CC:?CC must be set}"
LIBS="${LIBS:-}"
CFLAGS="${CFLAGS_COMMON:--O2 -std=gnu11 -D_GNU_SOURCE -Wno-trigraphs}"
# -fbracket-depth is clang-only (deeply-nested generated C); gcc rejects it.
case "$CC" in *clang*) CFLAGS="$CFLAGS -fbracket-depth=4096";; esac

# ── OPT-IN: bootstrap-only -O1 (release-safe, default OFF) — see stage_build_hexa.
# build/hexat is an INTERMEDIATE bootstrap transpiler (drives `hexa cc --regen` /
# seed-converge), NOT a shipped binary, so compiling it at -O1 cuts the gcc -O2
# cost the compile-speed R6 round targets without touching the SHIPPED ./hexa or
# runtime.a (both stay -O2). The C this transpiler EMITS is a deterministic
# function of the .hexa source, independent of its own -O level → byteeq-safe.
CFLAGS_BOOTSTRAP="$CFLAGS"
if [ "${HEXA_BOOTSTRAP_O1:-0}" = "1" ]; then
    case " $CFLAGS " in
        *" -O2 "*|*"-O2 "*|*" -O2"*) CFLAGS_BOOTSTRAP="${CFLAGS//-O2/-O1}" ;;
        *" -O3 "*|*"-O3 "*|*" -O3"*) CFLAGS_BOOTSTRAP="${CFLAGS//-O3/-O1}" ;;
        *)                           CFLAGS_BOOTSTRAP="$CFLAGS -O1" ;;
    esac
    echo "[stage_prebuild_hexat] HEXA_BOOTSTRAP_O1=1 — build/hexat at -O1 [$CFLAGS_BOOTSTRAP]"
fi

ROOT="$PWD"
RA="${HEXA_PREBUILT_RUNTIME:-$ROOT/build/runtime.a}"
HEXAT="$ROOT/build/hexat"
CC_SRC="$ROOT/self/native/hexa_cc.c"
mkdir -p build

# Tracks whether the bootstrap build/hexat was cp'd from a prior edge tarball
# (BOOT_FROM_EDGE=1) vs built here from the frozen/present hexa_cc.c seed (0).
# An edge-prebuilt hexat is a PRIOR-generation transpiler that may PRE-DATE the
# current self/codegen.hexa (e.g. the RFC061 §M8 setjmp/longjmp re-baseline) —
# so the regen-to-fixpoint below reconciles EITHER acquisition path to the
# current source before this hexat is shipped/used.
BOOT_FROM_EDGE=0

# ── OPT-IN: ccache the INTERMEDIATE amalgam compile (release-safe, default OFF) ─
# HEXA_CCACHE=1 SPLITS the big `hexa_cc.c` compile (compile `-c` -> .o, then link)
# so the object compile is ccache-cacheable. The historical single-step
# `$CC ... hexa_cc.c runtime.a -o hexat` is a COMBINED compile+link, which ccache
# treats as UNCACHEABLE (0% cacheable, measured) — so the naive `CC="ccache gcc"`
# wrapper does nothing here; the split is what makes the cache hit. WHY byteeq-safe:
# `gcc -c x.c -o x.o` + `gcc x.o lib -o bin` produces the byte-identical binary as
# the combined command, and ccache's same-input=>same-.o guarantee keeps it so —
# the transpiler this produces is unchanged, so the C it EMITS is unchanged
# (emit-sha invariant, same argument as the R6 bootstrap-O1 round). ONLY the
# intermediate bootstrap transpiler (build/hexat) is split here; the SHIPPED
# ./hexa + runtime.a are left byte-for-byte on their original combined path. When
# UNSET, behaviour is byte-for-byte identical to the historical single step.
# Measured (summer linux-x86_64, HEXA_SEED_CONVERGE=1): the amalgam is compiled 4×
# (hexat + 2 converge rebuilds + hexa_v2) = ~98s = 36% of build wall; with the
# split, hexa_v2 reuses the converged seed's object (~25s saved cold) and a warm
# rebuild hits all 4 (~98s saved).
_r7_cc_compile_link() { # <incs> <cflags> <src.c> <out> [link inputs...]
    local incs="$1" cflags="$2" src="$3" out="$4"; shift 4
    if [ "${HEXA_CCACHE:-0}" = "1" ] && command -v ccache >/dev/null 2>&1; then
        local obj="${out}.r7cc.o"
        ccache $CC $cflags $incs -c "$src" -o "$obj"
        $CC $cflags "$obj" "$@" -o "$out" $LIBS
        rm -f "$obj"
    else
        $CC $cflags $incs "$src" "$@" -o "$out" $LIBS
    fi
}

if [ -x "$HEXAT" ]; then
  echo "[stage_prebuild_hexat] build/hexat already present — no-op"
  exit 0
fi

if [ ! -f "$CC_SRC" ]; then
  # hexa_cc.c removed at graduation (post-#2065: seeds git-removed at checkout).
  # Prefer a prebuilt build/hexat from the prior edge tarball (release.yml Package
  # bundles it — the runtime.a "frozen dough" precedent #2019, extended to the
  # transpiler). If the per-platform edge asset is MISSING (P7 edge-seed
  # chicken-egg — `edge` ships only hexa-linux-arm64.tar.gz), FALL BACK to
  # restoring the frozen bootstrap seeds (pinned 7906951c0^) and building hexat
  # from source, the SAME path the seeds-present branch below runs.
  echo "[stage_prebuild_hexat] self/native/hexa_cc.c absent — trying prebuilt build/hexat from prior edge"
  ASSET="${EDGE_ASSET:?EDGE_ASSET must be set when seeds are removed}"
  EDGE_DIR="/tmp/edge_hexat"
  rm -rf "$EDGE_DIR"; mkdir -p "$EDGE_DIR"
  if gh release download edge --repo "${GITHUB_REPOSITORY:-dancinlab/hexa-lang}" \
        --pattern "$ASSET" --dir "$EDGE_DIR" --clobber 2>/tmp/hexat_dl.err \
     && tar xzf "$EDGE_DIR/$ASSET" -C "$EDGE_DIR" 2>/dev/null; then
    PRIOR_HEXAT="$(find "$EDGE_DIR" -type f -path '*/build/hexat' | head -1)"
    if [ -n "$PRIOR_HEXAT" ]; then
      cp "$PRIOR_HEXAT" "$HEXAT"
      chmod +x "$HEXAT"
      test -x "$HEXAT"
      echo "[stage_prebuild_hexat] build/hexat from edge = $(wc -c < "$HEXAT") bytes (bootstrap; reconciled to current source by the regen below when HEXA_SEED_CONVERGE=1)"
      BOOT_FROM_EDGE=1
    else
      echo "[stage_prebuild_hexat] prior edge tarball ($ASSET) has NO build/hexat — frozen-seed fallback" >&2
    fi
  else
    echo "[stage_prebuild_hexat] edge download failed ($(head -1 /tmp/hexat_dl.err 2>/dev/null)) — frozen-seed fallback" >&2
  fi
  # P7 frozen-seed fallback: restore the bootstrap seeds (incl. hexa_cc.c) into
  # the working tree from 7906951c0^, then fall through to the source build.
  # stage_resolve_runtime_a (Stage 0b, runs first) usually restores these
  # already; this makes stage_prebuild_hexat self-sufficient regardless of order.
  # Skipped when an edge-prebuilt hexat was already obtained above.
  if [ "$BOOT_FROM_EDGE" = "0" ]; then
    echo "[stage_prebuild_hexat] restoring frozen seeds (7906951c0^) to build hexat from source"
    if ! bash tool/restore_frozen_seeds || [ ! -f "$CC_SRC" ]; then
      echo "[stage_prebuild_hexat] FATAL: frozen-seed restore did not produce $CC_SRC" >&2
      exit 1
    fi
  fi
fi

# Build the bootstrap build/hexat from the (frozen-restored or already-present)
# seed — UNLESS an edge-prebuilt hexat was already cp'd above.
if [ "$BOOT_FROM_EDGE" = "0" ]; then
  if [ ! -f "$RA" ]; then
    echo "[stage_prebuild_hexat] FATAL: runtime.a missing at $RA (run Stage 0b first)" >&2
    exit 1
  fi
  echo "[stage_prebuild_hexat] building build/hexat from hexa_cc.c + runtime.a"
  _r7_cc_compile_link "-I $ROOT -I $ROOT/self" "$CFLAGS_BOOTSTRAP" "$CC_SRC" "$HEXAT" "$RA"
  test -x "$HEXAT"
  echo "[stage_prebuild_hexat] build/hexat = $(wc -c < "$HEXAT") bytes"
fi

# ── N5 seed-convergence — promote self/codegen.hexa source fixes into the seed ─
# WHY (the forge OFF-CUDA 4-arg wall · b65ebe51 / OP-37 residual): the seed
# hexa_cc.c is regenerated from current self/codegen.hexa by the PRIOR generation
# of hexat (frozen 151c52c8 blob, or the prior `edge` tarball's build/hexat). A
# source fix to codegen's OWN lowering logic (e.g. the 4-arg forge_dispatch_*
# special-cases — db_colsum/residual_add/expert_pack2/… that the frozen seed
# lowers as the broken `hexa_call4(fn,…)` → a COMPILE error in clm_prod OFF-CUDA)
# takes TWO regen passes to bake in: pass A carries the fix as STRING data the old
# hexat copies through (seed grows but the OLD hexat still cannot APPLY it); pass B
# builds a hexat FROM that seed (now it CONTAINS the new lowering) and re-regens —
# the resulting seed is the FIXED one. A single edge roll only does pass A, so the
# seed sits one generation behind source forever. This converges it WITHIN one run.
#
# Mechanism: regen the seed with the freshly-built hexat; if it differs (pass-A
# source-carry), install it, rebuild hexat (→ applies the new lowering), and loop.
# Stops at the FIXPOINT (regen == current seed) — proven to converge in 2 passes
# (seed_A 2034131B → seed_B 2106692B == seed_C, summer linux-x86_64). IDEMPOTENT:
# a warm/already-converged tree regens to a byte-identical seed → 0 iterations, no
# byte change.
#
# ── SHIP-PATH DEFAULT (release_build sets HEXA_SEED_CONVERGE=1) ───────────────
# Keyed on HEXA_SEED_CONVERGE; the shared tool/release_build defaults it to 1 so
# EVERY ship build reconciles the bootstrap hexat (edge-prebuilt OR frozen-seed-
# built) to the CURRENT self/codegen.hexa before it is packaged — the GCC/rustc
# "downstream stages are rebuilt from current source, only the cold-start seed is
# frozen" discipline. This is what closes the RFC061 §M8 ∅−8 setjmp/longjmp
# re-baseline ship-gate: the frozen seed (pinned 7906951c0^, 2026-05-29) PRE-DATES
# the native-musl `hxlcl_setjmp` codegen, so a hexat built straight from it emits
# the glibc-setjmp SAVE which, paired with the native-musl `hxlcl_longjmp` RESTORE
# in the re-baselined runtime.a, SEGVs (rc=139) on `hexa build` try/catch. Regen
# rebakes the current codegen into the seed → the shipped hexat emits native musl
# SAVE → rc=0 (measured aiden linux-x86_64).
#
# DIRECT callers of this script (build_native_*, cross_build_*) do NOT set
# HEXA_SEED_CONVERGE → default OFF here → byte-for-byte unchanged. The faithful-
# nobaseline gate explicitly sets HEXA_SEED_CONVERGE=0 to KEEP reproducing its
# edge baseline byte-for-byte (the loop mutates $CC_SRC + rebuilds hexat mid-build;
# darwin-arm64 faithful regressed when this ran there) — convergence is a
# deterministic fixpoint, so release-converged ≡ faithful-unconverged for every
# downstream assertion (./hexa runs + the dt_exp/dt_erf fold oracles).
#
# GRACEFUL: if the regen transpile fails the loop KEEPS the bootstrap hexat (break,
# no hard-fail) so a converge hiccup never ships nothing — worst case = the prior
# bootstrap hexat (today's behaviour). Needs runtime.a to rebuild the hexat from a
# converged seed; skipped with a warning when absent.
if [ "${HEXA_SEED_CONVERGE:-0}" = "1" ] && [ ! -f "$RA" ]; then
  echo "[stage_prebuild_hexat] seed-converge requested but runtime.a absent ($RA) — skipping regen, keeping bootstrap hexat" >&2
fi
if [ "${HEXA_SEED_CONVERGE:-0}" = "1" ] && [ -f "$RA" ]; then
  # $CC_SRC may not exist yet on the edge-prebuilt path (only build/hexat was
  # cp'd) — the first regen pass below writes it. Ensure its dir exists so the
  # install `cp` cannot fail under `set -e`.
  mkdir -p "$(dirname "$CC_SRC")"
  CONV_TMP="$(mktemp -d)"; trap 'rm -rf "$CONV_TMP"' EXIT
  i=0; max=4
  while [ "$i" -lt "$max" ]; do
    NEW="$CONV_TMP/seed_$i.c"
    if ! OUT="$NEW" HEXA_V2="$HEXAT" HEXA_LANG="$ROOT" bash "$ROOT/tool/regen_cc_manual" \
           >"$CONV_TMP/regen_$i.log" 2>&1 || [ ! -s "$NEW" ]; then
      echo "[stage_prebuild_hexat] seed-converge: regen pass $i FAILED — keeping current seed" >&2
      tail -2 "$CONV_TMP/regen_$i.log" >&2 2>/dev/null || true
      break
    fi
    if cmp -s "$NEW" "$CC_SRC"; then
      echo "[stage_prebuild_hexat] seed-converge: FIXPOINT after $i pass(es) (seed byte-stable, $(wc -c < "$CC_SRC")B)"
      break
    fi
    cp "$NEW" "$CC_SRC"
    _r7_cc_compile_link "-I $ROOT -I $ROOT/self" "$CFLAGS_BOOTSTRAP" "$CC_SRC" "$HEXAT" "$RA"
    test -x "$HEXAT"
    i=$((i+1))
    echo "[stage_prebuild_hexat] seed-converge: pass $i — seed=$(wc -c < "$CC_SRC")B hexat=$(wc -c < "$HEXAT")B"
  done
  if [ "$i" -ge "$max" ]; then
    echo "[stage_prebuild_hexat] seed-converge: WARN hit max $max passes without fixpoint — using last seed" >&2
  fi
fi

# Explicit success exit: the script runs under the caller's `set -e`
# (tool/release_build), so its exit status MUST be 0 on the normal path. The
# prior trailing `[ "$i" -ge "$max" ] && echo …` was the LAST command, so on the
# common FIXPOINT path ($i < $max) the bare `[ … ]` test returned 1 and BECAME
# the script's exit code → release_build aborted with exit 1 (this is what made
# HEXA_SEED_CONVERGE=1 fail in the shared release path on every platform, not
# just darwin). Guard it as a proper `if` (above) + assert + exit 0 here so a
# converged build is unambiguously successful.
test -x "$HEXAT"
exit 0
