#!hexa strict
// tool/gen_c_text_emitter.hexa
//   B9.C — meta-generator: mechanically build a verbatim `.c-text` emitter
//   (`<base>_emit.hexa`) from a hand-written `.c` source, following the
//   #1850 / #1875 per-line string-concat pattern.
//
// WHY A META-GENERATOR
// --------------------
// The `.c-text` FOUNDATION pattern stores each `.c` as a hexa emitter that
// prints the C VERBATIM. Hand-authoring such an emitter for a multi-KB (or
// 250 KB) `.c` by typing each `"...\n" +` line is impractical AND unsafe —
// a single mis-escaped `\` or `"` silently corrupts the emitter, and an
// emitter that later ACTIVATES with corrupt bytes breaks the vendor build.
//
// This tool guarantees byte-identity BY CONSTRUCTION: it reads the `.c`,
// escapes each line exactly as a hexa string literal requires (`\` → `\\`,
// `"` → `\"`, then re-append `\n`), and writes the emitter. The companion
// `<base>_byte_diff.hexa` oracle then PROVES gate-1 source-SHA equality.
//
// USAGE
//   hexa-run tool/gen_c_text_emitter.hexa <src.c> <out_emit.hexa> <base> <ctx>
//     <src.c>        path to the hand-written .c (read verbatim)
//     <out_emit.hexa> path to write the generated emitter
//     <base>         logical base name (e.g. "hxblas_linux") — names the fn
//     <ctx>          one-line context string for the emitter header comment
//
// The emitter's write path uses a quoted heredoc (no shell expansion), so
// what emit_<base>_c() RETURNS is written byte-for-byte.

let MODULE_NAME = "gen_c_text_emitter"

// Escape one source line into a hexa string-literal body.
// Order matters: backslash first, then double-quote.
fn esc_line(line: str) -> str {
    let mut s = line
    s = s.replace("\\", "\\\\")
    s = s.replace("\"", "\\\"")
    return s
}

fn main() {
    let argv = real_args()
    if argv.len() < 4 {
        println("usage: gen_c_text_emitter <src.c> <out_emit.hexa> <base> <ctx>")
        exit(1)
    }
    let src_path = argv[0]
    let out_path = argv[1]
    let base     = argv[2]
    let ctx      = argv[3]

    // Read the .c verbatim. exec("cat ...") preserves bytes; we then split
    // on '\n'. ROOT-CAUSE: do NOT assume a trailing newline. We preserve the
    // source's EXACT final-newline state -- a .c whose last byte is '\n' keeps
    // its trailing newline; a .c whose last byte is NOT '\n' (e.g. ends in '}'
    // 0x7d) must regenerate WITHOUT a synthetic trailing newline, else the
    // reconstructed .c differs from source by exactly one trailing 0x0a byte.
    let raw = exec("cat \"" + src_path + "\"")
    if raw.len() == 0 {
        println("[gen] FATAL: empty/unreadable source: " + src_path)
        exit(1)
    }

    // Does the source end with a newline? This drives whether the LAST real
    // line gets a trailing "\n" re-appended during reconstruction.
    let ends_with_nl = raw.substring(raw.len() - 1, raw.len()) == "\n"

    // Split on newline.
    //   - source ENDS with '\n':  parts = N real lines + 1 empty tail (index n-1);
    //     each real line is re-emitted with a trailing "\n" and the empty tail is
    //     skipped -> trailing newline preserved.
    //   - source does NOT end with '\n': parts = N real lines, the last (index n-1)
    //     is non-empty; every line EXCEPT the last gets a trailing "\n", and the
    //     last is emitted WITHOUT one -> no synthetic trailing newline.
    let parts = raw.split("\n")
    let n = parts.len()

    // STREAMING WRITE (root-cause fix for the emitter-FILE write scaling).
    //
    // The hexa interp's arena is bump-only (free() is never called), so every
    // intermediate produced by `body = body + line` stays resident. Building the
    // whole multi-MB emitter body in memory therefore grows RSS super-linearly
    // (~28 GB measured for self/runtime.c, OOM-killing the host). FIX: never hold
    // the full body. We emit the emitter file in three phases, keeping the live
    // string bounded to <=~48 KB at all times, flushing each chunk to disk:
    //   (a) truncate out_path + append the HEADER (small, fixed),
    //   (b) stream the per-line BODY in <=48 KB chunks (the multi-MB part),
    //   (c) append the FOOTER (small, fixed).
    // Each flush is a quoted heredoc append (no shell expansion -> verbatim bytes),
    // the same proven write mechanism the generated emitter uses for its own body.

    let eof_tag = "GEN_" + base.replace("-", "_").replace(".", "_") + "_EOF"

    let header =
            "#!hexa strict\n"
          + "// " + base + "_emit.hexa\n"
          + "//   B9.C (.c-text · #1850 pattern) — " + base + ".c source emitter.\n"
          + "//\n"
          + "// " + ctx + "\n"
          + "//\n"
          + "// Emits " + base + ".c VERBATIM. The hexa build regenerates the .c from\n"
          + "// this emitter before compiling, so the emitter becomes the SSOT and the\n"
          + "// .c becomes a build artifact. Byte-identity (gate-1 source-SHA, proven by\n"
          + "// " + base + "_byte_diff.hexa) ⇒ identical .o/.so ⇒ PERF UNCHANGED.\n"
          + "//\n"
          + "// GENERATED by tool/gen_c_text_emitter.hexa — do not hand-edit; re-run the\n"
          + "// generator against the hand-written .c if it ever changes.\n"
          + "//\n"
          + "// Invocation:  hexa-run " + base + "_emit.hexa <output-path>\n"
          + "// Default output path (if argv missing): \"" + base + ".c\" in cwd.\n"
          + "\n"
          + "let MODULE_NAME = \"" + base + "_emit\"\n"
          + "\n"
          + "fn _flush_" + base + "(out_path: str, buf: str) {\n"
          + "    let _ = exec(\"cat >> \\\"\" + out_path + \"\\\" <<'" + eof_tag + "'\\n\" + buf + \"" + eof_tag + "\")\n"
          + "}\n"
          + "\n"
          + "fn emit_" + base + "_to(out_path: str) {\n"
          + "    // Verbatim content of hand-written self/native/" + base + ".c, streamed in\n"
          + "    // size-bounded chunks (see generator note on the per-command exec limit).\n"
          + "    let _ = exec(\"printf '' > \\\"\" + out_path + \"\\\"\")\n"
          + "    let mut buf = \"\"\n"

    let footer =
            "    if buf.len() > 0 { _flush_" + base + "(out_path, buf) }\n"
          + "}\n"
          + "\n"
          + "fn main() {\n"
          + "    let argv = real_args()\n"
          + "    let out_path = if argv.len() >= 1 { argv[0] } else { \"" + base + ".c\" }\n"
          + "    emit_" + base + "_to(out_path)\n"
          + "    let exists_check = exec(\"[ -f \\\"\" + out_path + \"\\\" ] && echo y || echo n\").trim()\n"
          + "    if exists_check != \"y\" {\n"
          + "        println(\"[" + base + "_emit] FATAL: failed to write \" + out_path)\n"
          + "        exit(1)\n"
          + "    }\n"
          + "    println(\"[" + base + "_emit] wrote \" + out_path)\n"
          + "    exit(0)\n"
          + "}\n"

    // The write heredoc tag for the EMITTER FILE itself (distinct from eof_tag,
    // which is the tag baked INTO the generated emitter for ITS runtime body).
    let wtag = "GEN_EMITTER_WRITE_EOF"

    // (a) truncate + write header (header is a few hundred bytes -> one safe exec).
    let _ = exec("printf '' > \"" + out_path + "\"")
    let _ = exec("cat >> \"" + out_path + "\" <<'" + wtag + "'\n" + header + wtag)

    // (b) STREAM the body. wbuf holds the emitter lines for the CURRENT chunk only;
    //     it is flushed and reset whenever it crosses ~48 KB, so the live string
    //     never approaches the multi-MB full-body size that OOMs the arena.
    let mut wbuf = ""
    let mut i = 0
    let mut emitted = 0
    while i < n {
        // Skip the synthetic empty tail produced by a trailing newline (only
        // present when the source ENDS with '\n').
        if i == n - 1 && parts[i].len() == 0 {
            i = i + 1
            continue
        }
        let esc = esc_line(parts[i])
        // Re-append "\n" to EVERY line except the final real line of a source
        // that did NOT end with a newline -- preserving the source's exact EOF
        // state (byte-identical round-trip for both 0x0a- and 0x7d-terminated .c).
        let is_last_real = i == n - 1
        if is_last_real && !ends_with_nl {
            wbuf = wbuf + "    buf = buf + \"" + esc + "\"\n"
        } else {
            wbuf = wbuf + "    buf = buf + \"" + esc + "\\n\"\n"
        }
        emitted = emitted + 1
        // Periodic size-bounded flush of the GENERATED emitter's runtime body
        // (this is the line the generated emitter executes at run time).
        if emitted % 50 == 0 {
            wbuf = wbuf + "    if buf.len() > 65536 { _flush_" + base + "(out_path, buf); buf = \"\" }\n"
        }
        // Bound the GENERATOR's own live string: flush this chunk to the emitter
        // file and reset, so the arena working set stays small.
        if wbuf.len() > 49152 {
            let _ = exec("cat >> \"" + out_path + "\" <<'" + wtag + "'\n" + wbuf + wtag)
            wbuf = ""
        }
        i = i + 1
    }
    if wbuf.len() > 0 {
        let _ = exec("cat >> \"" + out_path + "\" <<'" + wtag + "'\n" + wbuf + wtag)
    }

    // (c) append the footer (small -> one safe exec).
    let _ = exec("cat >> \"" + out_path + "\" <<'" + wtag + "'\n" + footer + wtag)

    let ok = exec("[ -f \"" + out_path + "\" ] && echo y || echo n").trim()
    if ok != "y" {
        println("[gen] FATAL: failed to write emitter: " + out_path)
        exit(1)
    }
    println("[gen] wrote emitter " + out_path + " (" + str(n) + " split-parts)")
    exit(0)
}
