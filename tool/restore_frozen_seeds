/* moe_router(logits, ex_out, probs, y, T, E, C) -> int rc. softmax gate
 * over E (max + _op18_moe_exp + normalize — the SAME hand-rolled exp the
 * verified OP-18 moe_block2 uses) then sequential gate-weighted combine
 * y[t,c] = Σ_e probs[t,e]·ex_out[e*T*C + t*C + c]. GENERAL E. byte-eq to
 * clm_prod nn_moe_router_fwd. */
HexaVal hexa_forge_dispatch_moe_router(HexaVal logits_v, HexaVal exo_v,
                                       HexaVal probs_v, HexaVal y_v,
                                       HexaVal t_v, HexaVal e_v, HexaVal c_v) {
    int64_t lg = hexa_as_num(logits_v), eo = hexa_as_num(exo_v);
    int64_t pr = hexa_as_num(probs_v), y = hexa_as_num(y_v);
    int64_t T = hexa_as_num(t_v), E = hexa_as_num(e_v), C = hexa_as_num(c_v);
    if (T <= 0 || E <= 0 || C <= 0)                         return hexa_int(-1);
    if (!_OP37_FA(lg, T * E) || !_OP37_FA(pr, T * E) ||
        !_OP37_FA(eo, E * T * C) || !_OP37_FA(y, T * C))    return hexa_int(-1);
    double* LG = _hx_farr_table[lg].buf;
    double* EO = _hx_farr_table[eo].buf;
    double* PR = _hx_farr_table[pr].buf;
    double* Y = _hx_farr_table[y].buf;
    for (int64_t t = 0; t < T; t++) {
        int64_t base = t * E;
        double mx = LG[base];
        for (int64_t e = 1; e < E; e++) { double v = LG[base + e]; if (v > mx) mx = v; }
        double s = 0.0;
        for (int64_t e = 0; e < E; e++) {
            double ev = _op18_moe_exp(LG[base + e] - mx);
            PR[base + e] = ev;
            s += ev;
        }
        for (int64_t e = 0; e < E; e++) PR[base + e] = PR[base + e] / s;
    }
    for (int64_t t = 0; t < T; t++)
        for (int64_t c = 0; c < C; c++) {
            double acc = 0.0;
            for (int64_t e = 0; e < E; e++)
                acc += PR[t * E + e] * EO[e * T * C + t * C + c];
            Y[t * C + c] = acc;
        }
    return hexa_int(0);
}
HexaVal forge_dispatch_moe_router(HexaVal logits_v, HexaVal exo_v,
                                  HexaVal probs_v, HexaVal y_v,
                                  HexaVal t_v, HexaVal e_v, HexaVal c_v) {
    return hexa_forge_dispatch_moe_router(logits_v, exo_v, probs_v, y_v, t_v, e_v, c_v);
}
