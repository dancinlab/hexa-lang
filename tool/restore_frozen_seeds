/* forge_dispatch_stdp_pair(W, tr_pre, tr_post, spike, out,
 *                          A_plus, A_minus, w_max) -> int rc (0 ok / -1 err)
 * W: N×N row-major farr · tr_pre/tr_post/spike: length-N farrs ·
 * out: caller-allocated N×N farr, filled in place. N = len(spike)
 * (exactly t_len(spike), the hexa-side wrapper's n). */
HexaVal hexa_forge_dispatch_stdp_pair(HexaVal W_v, HexaVal tr_pre_v,
                                      HexaVal tr_post_v, HexaVal spike_v,
                                      HexaVal out_v, HexaVal A_plus_v,
                                      HexaVal A_minus_v, HexaVal w_max_v) {
    int64_t W  = hexa_as_num(W_v);
    int64_t tp = hexa_as_num(tr_pre_v);
    int64_t ts = hexa_as_num(tr_post_v);
    int64_t sp = hexa_as_num(spike_v);
    int64_t ot = hexa_as_num(out_v);
    double  A_plus  = __hx_to_double(A_plus_v);
    double  A_minus = __hx_to_double(A_minus_v);
    double  w_max   = __hx_to_double(w_max_v);
    if (W < 0 || tp < 0 || ts < 0 || sp < 0 || ot < 0)      return hexa_int(-1);
    if (W  >= _hx_farr_count || tp >= _hx_farr_count ||
        ts >= _hx_farr_count || sp >= _hx_farr_count ||
        ot >= _hx_farr_count)                               return hexa_int(-1);
    int64_t n = _hx_farr_table[sp].len;
    if (n <= 0)                                             return hexa_int(-1);
    int64_t nn = n * n;
    if (_hx_farr_table[W].len  < nn || _hx_farr_table[ot].len < nn ||
        _hx_farr_table[tp].len < n  || _hx_farr_table[ts].len < n)
        return hexa_int(-1);
    double* WB = _hx_farr_table[W].buf;
    double* TP = _hx_farr_table[tp].buf;
    double* TS = _hx_farr_table[ts].buf;
    double* SP = _hx_farr_table[sp].buf;
    double* OT = _hx_farr_table[ot].buf;
    if (!WB || !TP || !TS || !SP || !OT)                    return hexa_int(-1);
    double neg_w_max = 0.0 - w_max;
    for (int64_t i = 0; i < n; i++) {
        double s_i      = SP[i];
        double trpost_i = TS[i];
        for (int64_t j = 0; j < n; j++) {
            int64_t idx  = i * n + j;
            double  w_ij = WB[idx];
            double  wd;
            if (i == j) {
                /* diagonal: dW = 0, weight passes through clip unchanged */
                wd = w_ij;
            } else {
                /* same left-assoc scalar order as flame_stdp_pair:
                 * ltp = (A_plus·s_i)·tr_pre[j] · ltd = (A_minus·trpost_i)·spike[j]
                 * wnew = w_ij + (ltp − ltd) — FP_CONTRACT OFF above keeps each
                 * op a separately-rounded IEEE-754 mul/sub/add (no fma/fms). */
                double ltp = A_plus * s_i * TP[j];
                double ltd = A_minus * trpost_i * SP[j];
                wd = w_ij + (ltp - ltd);
            }
            if (wd > w_max)     wd = w_max;
            if (wd < neg_w_max) wd = neg_w_max;
            OT[idx] = wd;
        }
    }
    return hexa_int(0);
}
