                                 HexaVal out_v, HexaVal A_plus_v,
                                 HexaVal A_minus_v, HexaVal w_max_v) {
    return hexa_forge_dispatch_stdp_pair(W_v, tr_pre_v, tr_post_v, spike_v,
                                         out_v, A_plus_v, A_minus_v, w_max_v);
}
