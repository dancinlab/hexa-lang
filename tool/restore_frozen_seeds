/* groupnorm(x, gamma, beta, y, mean, inv, xhat, T, C, G) -> int rc.
 * EXACTLY the OP-18 groupnorm_gelu body MINUS the final GELU (and the `a`
 * out buffer): two-pass mean/var (t-outer, c-inner), eps=1e-5, 40-iter
 * Newton _op18_gn_sqrt, affine y = gamma*xhat + beta → byte-eq to
 * clm_prod nn_groupnorm_fwd / the verified groupnorm_gelu Y output. */
HexaVal hexa_forge_dispatch_groupnorm(HexaVal x_v, HexaVal gamma_v, HexaVal beta_v,
                                      HexaVal y_v, HexaVal mean_v, HexaVal inv_v,
                                      HexaVal xhat_v, HexaVal t_v, HexaVal c_v,
                                      HexaVal g_v) {
    int64_t x = hexa_as_num(x_v), gm = hexa_as_num(gamma_v), bt = hexa_as_num(beta_v);
    int64_t y = hexa_as_num(y_v), mn = hexa_as_num(mean_v), iv = hexa_as_num(inv_v);
    int64_t xh = hexa_as_num(xhat_v);
    int64_t T = hexa_as_num(t_v), C = hexa_as_num(c_v), G = hexa_as_num(g_v);
    if (T <= 0 || C <= 0 || G <= 0 || (C % G) != 0)         return hexa_int(-1);
    int64_t cg = C / G, n = T * C;
    if (!_OP37_FA(x, n) || !_OP37_FA(y, n) || !_OP37_FA(xh, n) ||
        !_OP37_FA(gm, C) || !_OP37_FA(bt, C) ||
        !_OP37_FA(mn, G) || !_OP37_FA(iv, G))               return hexa_int(-1);
    double* X = _hx_farr_table[x].buf;
    double* GM = _hx_farr_table[gm].buf;
    double* BT = _hx_farr_table[bt].buf;
    double* Y = _hx_farr_table[y].buf;
    double* MN = _hx_farr_table[mn].buf;
    double* IV = _hx_farr_table[iv].buf;
    double* XH = _hx_farr_table[xh].buf;
    const double eps = 0.00001;
    double m = (double)(cg * T);
    for (int64_t g = 0; g < G; g++) {
        int64_t c0 = g * cg;
        double sum = 0.0;
        for (int64_t t = 0; t < T; t++)
            for (int64_t c = 0; c < cg; c++)
                sum += X[t * C + (c0 + c)];
        double mu = sum / m;
        double vs = 0.0;
        for (int64_t t = 0; t < T; t++)
            for (int64_t c = 0; c < cg; c++) {
                double d = X[t * C + (c0 + c)] - mu;
                vs += d * d;
            }
        double var = vs / m;
        double inv = 1.0 / _op18_gn_sqrt(var + eps);
        MN[g] = mu;
        IV[g] = inv;
        for (int64_t t = 0; t < T; t++)
            for (int64_t c = 0; c < cg; c++) {
                int64_t ch = c0 + c, idx = t * C + ch;
                double xhat = (X[idx] - mu) * inv;
                XH[idx] = xhat;
                Y[idx] = GM[ch] * xhat + BT[ch];
            }
    }
    return hexa_int(0);
}
HexaVal forge_dispatch_groupnorm(HexaVal x_v, HexaVal gamma_v, HexaVal beta_v,
                                 HexaVal y_v, HexaVal mean_v, HexaVal inv_v,
                                 HexaVal xhat_v, HexaVal t_v, HexaVal c_v,
                                 HexaVal g_v) {
    return hexa_forge_dispatch_groupnorm(x_v, gamma_v, beta_v, y_v, mean_v,
                                         inv_v, xhat_v, t_v, c_v, g_v);
}

