#!/usr/bin/env bash
# tool/restore_frozen_seeds — restore the bootstrap C seeds from the authoritative
# pre-graduation git blob, so a fresh `.c=0` checkout can self-build runtime.a +
# build/hexat WITHOUT pulling a per-platform edge tarball.
#
# ── Why this exists (P7 — edge-seed chicken-egg) ─────────────────────────────
# At graduation commit 7906951c0 ("tracked .c = 0", #2065) all bootstrap C seeds
# (self/runtime.c + its 19 #include fragments + self/native/hexa_cc.c) were
# git-removed. The release pipeline then resolves runtime.a + build/hexat ONLY
# from a prior `edge` tarball. But the `edge` release ships ONLY
# hexa-linux-arm64.tar.gz, so linux-x86_64 and darwin-arm64 have NO seed → the
# edge-pull stages exit 1 → `release` + `nobaseline-gate` go RED on those two
# platforms. (linux-arm64 self-heals: its job goes green and re-uploads.)
#
# self/runtime.c (14663 lines) has no SSOT emitter — only fragments — and the
# toolchain is read-only, so the only authoritative source for a coherent
# same-revision runtime is the frozen git blob at 7906951c0^ (= 151c52c82, the
# parent of the graduation commit). This script restores exactly that seed set
# into the working tree on demand. The files are NOT committed — they are an
# ephemeral build input, restored into the checkout, compiled, then discarded
# (CI checkouts are throwaway; locally the caller restores the tree afterward).
# This preserves the .hexa-only graduated state in git while keeping every
# platform self-sufficient for bootstrap.
#
# The seed set is IDENTICAL to nobaseline-gate.yml's $SEEDS (23 files) minus
# self/bootstrap_compiler.c (not a runtime.c #include; not needed for runtime.a
# or hexat). All paths verified to exist as blobs at the pinned ref.
#
# Usage:  bash tool/restore_frozen_seeds            # restore all seeds
#         FROZEN_SEED_REF=<sha> bash tool/restore_frozen_seeds   # override ref
# Prints the restored file count. Exits non-zero if any checkout fails.
set -euo pipefail

# Pinned to the parent of the graduation commit 7906951c0 (#2065) — given as the
# parent's FULL SHA (151c52c8…), NOT `7906951c0^`, because CI checks out with
# actions/checkout fetch-depth:1 (shallow) where neither the graduation commit
# nor its parent is present locally; a full SHA is fetchable on demand whereas a
# `<sha>^` revision cannot be resolved without the child object. This is the last
# revision where the bootstrap C seeds were tracked and mutually coherent.
FROZEN_SEED_REF="${FROZEN_SEED_REF:-151c52c82502e93d01735c58b43b017d102fee63}"

# The frozen seed set: self/runtime.c + the .c fragments it #includes (derived
# from `git show <ref>:self/runtime.c | grep '#include "'`) + the transpiler
# seed self/native/hexa_cc.c (needed by stage_prebuild_hexat to build hexat).
FROZEN_SEEDS=(
  self/runtime.c
  self/runtime_core.c
  self/runtime_hi_gen.c
  self/native/hexa_cc.c
  self/native/tensor_kernels.c
  self/native/net.c
  self/native/thread.c
  self/native/pty.c
  self/native/mount.c
  self/native/namespace.c
  self/native/wait.c
  self/native/crypto_sodium.c
  self/native/crypto_openssl.c
  self/native/exec_pipe.c
  self/native/proc_fork.c
  self/native/fp_init.c
  self/native/signal_flock.c
  self/native/exec_argv_sha256.c
  self/native/persistent_pipe.c
  self/native/term_ffi.c
  self/forge/forge_tier_v1.c
)

echo "[restore_frozen_seeds] restoring ${#FROZEN_SEEDS[@]} bootstrap seeds from $FROZEN_SEED_REF"

# On a shallow CI checkout (actions/checkout fetch-depth:1) the pinned commit is
# absent. Fetch just that commit on demand — GitHub allows fetching a reachable
# SHA directly. No-op when the object is already present (full clones).
if ! git cat-file -e "${FROZEN_SEED_REF}^{commit}" 2>/dev/null; then
  echo "[restore_frozen_seeds] $FROZEN_SEED_REF absent (shallow checkout) — fetching on demand"
  git fetch --depth=1 origin "$FROZEN_SEED_REF" 2>/dev/null \
    || git fetch origin "$FROZEN_SEED_REF" 2>/dev/null \
    || { echo "[restore_frozen_seeds] FATAL: cannot fetch $FROZEN_SEED_REF" >&2; exit 1; }
fi

n=0
for f in "${FROZEN_SEEDS[@]}"; do
  # Restore the blob content WITHOUT staging it (--) so the working tree gets the
  # file but git status still treats it as the graduated (removed) state once the
  # caller cleans up. `git checkout <ref> -- <file>` does stage it; we follow up
  # with `git reset` of the path-set so the index stays at HEAD (uncommitted).
  if git checkout "$FROZEN_SEED_REF" -- "$f" 2>/dev/null; then
    n=$((n+1))
  else
    echo "[restore_frozen_seeds] FATAL: cannot restore $f from $FROZEN_SEED_REF" >&2
    exit 1
  fi
done
# ── OP-17 (HEXA-0POD) — -Wmacro-redefined hygiene patch ──────────────────────
# The frozen self/runtime.c #defines 9 libc names (strcat/bzero/memcpy/memset/
# memmove/strncpy/strcpy/snprintf/sprintf) that Darwin clang's _FORTIFY_SOURCE
# secure headers (<secure/_string.h>/_strings.h/_stdio.h) ALREADY #define as
# __*_chk_func fortify macros → 9 [-Wmacro-redefined] warnings on every build.
# The SSOT is the immutable frozen blob (151c52c8…, the .c-graduation parent),
# so the fix lands here as a deterministic post-restore patch: insert `#undef`
# before the override block (same precedent as the seed's own `#undef isalnum`/
# `#undef exit`). BEHAVIOR-PRESERVING — the hxlcl_* macro is the effective
# expansion either way (it is the last #define); #undef only silences the warning.
# Idempotent: the marker guards against double-injection across re-restores.
rt="self/runtime.c"
if [ -f "$rt" ] && ! grep -q 'OP-17 (HEXA-0POD' "$rt"; then
  # Anchor on the unique override-block comment line; inject the #undef block
  # immediately before the first `#define strlen(` that follows it.
  awk '
    /^#define strlen\(s\)/ && !done {
      print "// OP-17 (HEXA-0POD) -Wmacro-redefined hygiene — #undef the 9 names the"
      print "// Darwin _FORTIFY_SOURCE secure headers already #define as __*_chk_func"
      print "// fortify macros, before our hxlcl_* override (behavior-preserving: our"
      print "// macro is the effective expansion either way; #undef only kills the warn)."
      print "#undef strcat"
      print "#undef bzero"
      print "#undef memcpy"
      print "#undef memset"
      print "#undef memmove"
      print "#undef strncpy"
      print "#undef strcpy"
      print "#undef snprintf"
      print "#undef sprintf"
      done=1
    }
    { print }
  ' "$rt" > "$rt.op17" && mv "$rt.op17" "$rt"
  echo "[restore_frozen_seeds] OP-17: injected 9 #undef (-Wmacro-redefined hygiene) into $rt"
fi

# ── OP-18 (HEXA-0POD) — L3 fused-dispatch host fallbacks ──────────────────────
# The frozen self/runtime.c (151c52c8…, .c-graduation parent) predates the L3
# kernel-fusion glue, so it has NO host body for the bare fused dispatchers
#   forge_dispatch_groupnorm_gelu (L3-a · OP-16)   forge_dispatch_gelu2 (L3-b)
#   forge_dispatch_moe_block2 (L3-d)
# that clm_prod.hexa / gn_lib.hexa emit (codegen always emits the symbol
# reference). On a CUDA build fusion_dispatch.c supplies them (#ifdef HEXA_CUDA);
# OFF-CUDA they were undefined → a `hexa run` that drives the fused paths failed
# to LINK (the 0-GPU blind spot OP-15 named). This appends the missing `#ifndef
# HEXA_CUDA` HOST twins so the WHOLE fused-dispatch family is 0-GPU testable,
# BYTE-EQ to the unfused reference each fused helper falls through to in
# clm_prod.hexa (PROVEN max|Δ|=0 by the clm_prod_*_hostdispatch_eq oracles +
# OP-8 #2993 for the moe-router order). FP_CONTRACT OFF (hexa codegen emits
# non-FMA-contracted sequential rounding; clang -O2 would otherwise contract the
# affine/GELU → ~1 ULP divergence). Guarded by #ifndef HEXA_CUDA so the GPU build
# is UNCHANGED (no duplicate symbol with fusion_dispatch.c). Appended at EOF where
# _hx_farr_table / hexa_as_num / erf / hexa_int are all in scope. Idempotent: the
# marker guards against double-injection across re-restores.
if [ -f "$rt" ] && ! grep -q 'OP-18 (HEXA-0POD' "$rt"; then
  cat >> "$rt" <<'OP18_EOF'

/* ═══════════════════════════════════════════════════════════════════
 * OP-18 (HEXA-0POD) — host fallbacks for the L3 fused dispatchers so the
 * WHOLE fused-dispatch family is 0-GPU `hexa run`-linkable + byte-eq.
 * `#ifndef HEXA_CUDA` only → GPU path (fusion_dispatch.c) UNCHANGED. */
#ifndef HEXA_CUDA
#pragma STDC FP_CONTRACT OFF
/* HEXA-0POD OP-19b — deterministic exp/erf, byte-identical to flame_math dt_exp/
 * dt_erf (A&S 7.1.26 + Taylor, BRANCHLESS, NO libm). The host GELU fallback must
 * match nn_lib's dt_erf GELU (which OP-19b swapped off libm erf) so the gelu2 /
 * groupnorm_gelu host-dispatch oracles stay byte-eq vs the unfused nn_gelu_fwd. */
static double _op19b_dt_exp(double x) {
    long long r = 0; double xr = x;
    while ((xr > 0.0 ? xr : 0.0 - xr) > 0.25) { xr = xr / 2.0; r = r + 1; }
    double term = 1.0, acc = 1.0;
    for (long long k = 1; k < 12; k++) { term = term * xr / (double)k; acc = acc + term; }
    for (long long s = 0; s < r; s++) acc = acc * acc;
    return acc;
}
static double _op19b_dt_erf(double x) {
    double sign = 1.0, z = x;
    if (z < 0.0) { sign = 0.0 - 1.0; z = 0.0 - z; }
    double t = 1.0 / (1.0 + 0.3275911 * z);
    const double a1 = 0.254829592, a2 = 0.0 - 0.284496736, a3 = 1.421413741,
                 a4 = 0.0 - 1.453152027, a5 = 1.061405429;
    double poly = ((((a5 * t + a4) * t + a3) * t + a2) * t + a1) * t;
    return sign * (1.0 - poly * _op19b_dt_exp(0.0 - z * z));
}
/* dt_erf-based GELU, byte-identical to nn_lib _nn_gelu (OP-19b; 1/√2 literal). */
static double _op18_gelu(double x) {
    const double inv_sqrt2 = 0.70710678118654752440;
    return x * (0.5 * (1.0 + _op19b_dt_erf(x * inv_sqrt2)));
}
/* Newton-Raphson sqrt — matches gn_lib _gn_sqrt / nn_lib _nn_sqrt (40 iters). */
static double _op18_gn_sqrt(double x) {
    if (x <= 0.0) return 0.0;
    double g = x;
    for (int i = 0; i < 40; i++) g = 0.5 * (g + x / g);
    return g;
}
/* hand-rolled e^x — byte-identical to moe_lib _moe_exp (scaled Taylor, range
 * reduction x = n·ln2 + r, |r|<=ln2/2, 14-term Taylor, 2^n by mul/div). */
static double _op18_moe_exp(double x) {
    const double ln2 = 0.6931471805599453;
    int n = 0;
    double r = x;
    while (r >  0.34657359) { r = r - ln2; n = n + 1; }
    while (r < -0.34657359) { r = r + ln2; n = n - 1; }
    double term = 1.0, sum = 1.0;
    for (int k = 1; k < 14; k++) { term = term * r / (double)k; sum = sum + term; }
    double p = sum;
    if (n >= 0) { for (int i = 0; i < n; i++) p = p * 2.0; }
    else        { for (int i = 0; i < -n; i++) p = p / 2.0; }
    return p;
}

/* L3-a (OP-16): groupnorm_gelu(x,gamma,beta,y,a,mean,inv,xhat,T,C,G). */
HexaVal forge_dispatch_groupnorm_gelu(HexaVal x_v, HexaVal gamma_v, HexaVal beta_v,
                                      HexaVal y_v, HexaVal a_v, HexaVal mean_v,
                                      HexaVal inv_v, HexaVal xhat_v,
                                      HexaVal t_v, HexaVal c_v, HexaVal g_v) {
    int64_t x  = hexa_as_num(x_v),  gm = hexa_as_num(gamma_v), bt = hexa_as_num(beta_v);
    int64_t y  = hexa_as_num(y_v),  a  = hexa_as_num(a_v),     mn = hexa_as_num(mean_v);
    int64_t iv = hexa_as_num(inv_v), xh = hexa_as_num(xhat_v);
    int64_t T  = hexa_as_num(t_v),  C  = hexa_as_num(c_v),     G  = hexa_as_num(g_v);
    if (T <= 0 || C <= 0 || G <= 0 || (C % G) != 0)         return hexa_int(-1);
    if (x < 0 || gm < 0 || bt < 0 || y < 0 || a < 0)        return hexa_int(-1);
    if (mn < 0 || iv < 0 || xh < 0)                         return hexa_int(-1);
    if (x  >= _hx_farr_count || gm >= _hx_farr_count || bt >= _hx_farr_count ||
        y  >= _hx_farr_count || a  >= _hx_farr_count || mn >= _hx_farr_count ||
        iv >= _hx_farr_count || xh >= _hx_farr_count)        return hexa_int(-1);
    int64_t cg = C / G;
    int64_t n  = T * C;
    if (_hx_farr_table[x].len  < n || _hx_farr_table[y].len  < n ||
        _hx_farr_table[a].len  < n || _hx_farr_table[xh].len < n ||
        _hx_farr_table[gm].len < C || _hx_farr_table[bt].len < C ||
        _hx_farr_table[mn].len < G || _hx_farr_table[iv].len < G)
        return hexa_int(-1);
    double* X  = _hx_farr_table[x].buf;
    double* GM = _hx_farr_table[gm].buf;
    double* BT = _hx_farr_table[bt].buf;
    double* Y  = _hx_farr_table[y].buf;
    double* A  = _hx_farr_table[a].buf;
    double* MN = _hx_farr_table[mn].buf;
    double* IV = _hx_farr_table[iv].buf;
    double* XH = _hx_farr_table[xh].buf;
    if (!X || !GM || !BT || !Y || !A || !MN || !IV || !XH)   return hexa_int(-1);
    const double eps = 0.00001;
    double m = (double)(cg * T);
    for (int64_t g = 0; g < G; g++) {
        int64_t c0 = g * cg;
        double sum = 0.0;
        for (int64_t t = 0; t < T; t++)
            for (int64_t c = 0; c < cg; c++)
                sum = sum + X[t * C + (c0 + c)];
        double mu = sum / m;
        double vs = 0.0;
        for (int64_t t = 0; t < T; t++)
            for (int64_t c = 0; c < cg; c++) {
                double d = X[t * C + (c0 + c)] - mu;
                vs = vs + d * d;
            }
        double var = vs / m;
        double inv = 1.0 / _op18_gn_sqrt(var + eps);
        MN[g] = mu;
        IV[g] = inv;
        for (int64_t t = 0; t < T; t++)
            for (int64_t c = 0; c < cg; c++) {
                int64_t ch  = c0 + c;
                int64_t idx = t * C + ch;
                double xhat = (X[idx] - mu) * inv;
                XH[idx] = xhat;
                double yv = GM[ch] * xhat + BT[ch];
                Y[idx] = yv;
                A[idx] = _op18_gelu(yv);
            }
    }
    return hexa_int(0);
}

/* L3-b: gelu2(g0,a0,g1,a1,n) — two erf-GELU passes. */
HexaVal forge_dispatch_gelu2(HexaVal g0_v, HexaVal a0_v, HexaVal g1_v,
                             HexaVal a1_v, HexaVal n_v) {
    int64_t g0 = hexa_as_num(g0_v), a0 = hexa_as_num(a0_v);
    int64_t g1 = hexa_as_num(g1_v), a1 = hexa_as_num(a1_v);
    int64_t n  = hexa_as_num(n_v);
    if (n <= 0 || g0 < 0 || a0 < 0 || g1 < 0 || a1 < 0)        return hexa_int(-1);
    if (g0 >= _hx_farr_count || a0 >= _hx_farr_count ||
        g1 >= _hx_farr_count || a1 >= _hx_farr_count)          return hexa_int(-1);
    if (_hx_farr_table[g0].len < n || _hx_farr_table[a0].len < n ||
        _hx_farr_table[g1].len < n || _hx_farr_table[a1].len < n)
        return hexa_int(-1);
    double* G0 = _hx_farr_table[g0].buf;
    double* A0 = _hx_farr_table[a0].buf;
    double* G1 = _hx_farr_table[g1].buf;
    double* A1 = _hx_farr_table[a1].buf;
    if (!G0 || !A0 || !G1 || !A1)                              return hexa_int(-1);
    for (int64_t i = 0; i < n; i++) A0[i] = _op18_gelu(G0[i]);
    for (int64_t i = 0; i < n; i++) A1[i] = _op18_gelu(G1[i]);
    return hexa_int(0);
}

/* L3-d: moe_block2(eo0,eo1,logits,ex0,ex1,ex_out,probs,y,T,E,C) —
 * gelu2 → expert_pack2 (E=2) → moe_router (OP-8 canonical order). */
HexaVal forge_dispatch_moe_block2(HexaVal eo0_v, HexaVal eo1_v, HexaVal logits_v,
                                  HexaVal ex0_v, HexaVal ex1_v, HexaVal ex_out_v,
                                  HexaVal probs_v, HexaVal y_v,
                                  HexaVal t_v, HexaVal e_v, HexaVal c_v) {
    int64_t eo0 = hexa_as_num(eo0_v), eo1 = hexa_as_num(eo1_v), lg = hexa_as_num(logits_v);
    int64_t ex0 = hexa_as_num(ex0_v), ex1 = hexa_as_num(ex1_v), exo = hexa_as_num(ex_out_v);
    int64_t pr  = hexa_as_num(probs_v), y = hexa_as_num(y_v);
    int64_t T   = hexa_as_num(t_v), E = hexa_as_num(e_v), C = hexa_as_num(c_v);
    if (T <= 0 || E <= 0 || C <= 0)                            return hexa_int(-1);
    if (eo0 < 0 || eo1 < 0 || lg < 0 || ex0 < 0 || ex1 < 0 ||
        exo < 0 || pr < 0 || y < 0)                            return hexa_int(-1);
    if (eo0 >= _hx_farr_count || eo1 >= _hx_farr_count || lg  >= _hx_farr_count ||
        ex0 >= _hx_farr_count || ex1 >= _hx_farr_count || exo >= _hx_farr_count ||
        pr  >= _hx_farr_count || y   >= _hx_farr_count)        return hexa_int(-1);
    if (E != 2)                                                return hexa_int(-1);
    int64_t n  = T * C;
    int64_t TC = T * C;
    if (_hx_farr_table[eo0].len < n  || _hx_farr_table[eo1].len < n  ||
        _hx_farr_table[ex0].len < n  || _hx_farr_table[ex1].len < n  ||
        _hx_farr_table[exo].len < E * TC ||
        _hx_farr_table[lg].len  < T * E  || _hx_farr_table[pr].len < T * E ||
        _hx_farr_table[y].len   < TC)
        return hexa_int(-1);
    double* EO0 = _hx_farr_table[eo0].buf;
    double* EO1 = _hx_farr_table[eo1].buf;
    double* LG  = _hx_farr_table[lg].buf;
    double* EX0 = _hx_farr_table[ex0].buf;
    double* EX1 = _hx_farr_table[ex1].buf;
    double* EXO = _hx_farr_table[exo].buf;
    double* PR  = _hx_farr_table[pr].buf;
    double* Y   = _hx_farr_table[y].buf;
    if (!EO0 || !EO1 || !LG || !EX0 || !EX1 || !EXO || !PR || !Y)
        return hexa_int(-1);
    for (int64_t i = 0; i < n; i++) EX0[i] = _op18_gelu(EO0[i]);
    for (int64_t i = 0; i < n; i++) EX1[i] = _op18_gelu(EO1[i]);
    for (int64_t j = 0; j < n; j++) { EXO[0 * n + j] = EX0[j]; EXO[1 * n + j] = EX1[j]; }
    for (int64_t t = 0; t < T; t++) {
        int64_t base = t * E;
        double mx = LG[base];
        for (int64_t e = 1; e < E; e++) { double v = LG[base + e]; if (v > mx) mx = v; }
        double s = 0.0;
        for (int64_t e = 0; e < E; e++) {
            double ev = _op18_moe_exp(LG[base + e] - mx);
            PR[base + e] = ev;
            s = s + ev;
        }
        for (int64_t e = 0; e < E; e++) PR[base + e] = PR[base + e] / s;
    }
    for (int64_t t = 0; t < T; t++)
        for (int64_t c = 0; c < C; c++) {
            double acc = 0.0;
            for (int64_t e = 0; e < E; e++)
                acc = acc + PR[t * E + e] * EXO[e * T * C + t * C + c];
            Y[t * C + c] = acc;
        }
    return hexa_int(0);
}
#pragma STDC FP_CONTRACT DEFAULT
#endif
OP18_EOF
  echo "[restore_frozen_seeds] OP-18: appended L3 fused-dispatch host fallbacks (gelu2 + moe_block2 + groupnorm_gelu) to $rt"
fi

# ── OP-19e (HEXA-0POD) — musl-safe env capture (POSIX `environ`, not the ──────
# constructor-args ABI) ──────────────────────────────────────────────────────
# The frozen self/runtime.c (151c52c8…) captures envp via the GCC/Darwin
# constructor signature  hxlcl_capture_environ(int argc, char**argv, char**envp).
# Receiving argc/argv/envp in a constructor is a glibc + Darwin/dyld extension
# (dyld passes (argc,argv,envp,apple) to __mod_init_func; glibc's __libc_csu_init
# forwards them) — it is NOT in the C/ELF standard. musl runs constructors with
# NO arguments, so on musl `envp` is whatever garbage is in the 3rd arg register
# → hxlcl_environ = garbage → the FIRST hxlcl_getenv (driven by the priority-default
# arena init _hexa_init_mem_cap, which runs AFTER this priority-101 ctor) walks a
# wild pointer → SIGSEGV before main(). (Surfaced by OP-19d's 4-environment run;
# that PR shipped a test-only runtime copy + flagged this durable follow-up.)
#
# Fix: read the POSIX global `extern char **environ` (defined by EVERY libc —
# glibc, musl, AND Darwin's crt1 for the main executable) instead of the ctor
# arg. The constructor still runs at priority 101 (before the arena init) and
# still snapshots into hxlcl_environ, so hxlcl_getenv is unchanged downstream.
# BEHAVIOR-PRESERVING on glibc/Darwin (same process environment captured — the
# ctor-arg envp and the libc `environ` global point at the same vector at start);
# FIXES musl (real pointer, not a garbage register). The `extern char **environ`
# decl is emitted BEFORE the `#define environ hxlcl_environ` line so it refers to
# the libc symbol, not our shadowed macro. Deterministic, idempotent (marker
# guard). Anchored on the unique "RUNTIME tail (cycle 85)" comment block.
if [ -f "$rt" ] && ! grep -q 'OP-19e (HEXA-0POD' "$rt"; then
  # State machine: on the `static char **hxlcl_environ = 0;` declaration, emit the
  # musl-safe replacement and SKIP every original line through the matching
  # `#define environ hxlcl_environ` (the 6-line frozen capture block).
  awk '
    /^static char \*\*hxlcl_environ = 0;$/ && !patched {
      print "// OP-19e (HEXA-0POD) — musl-safe env capture: read the POSIX `environ`"
