#                                  SAME hand-rolled exp the verified OP-18 moe_block2
#                                  uses) + sequential gate-weighted combine → byte-eq,
#                                  GENERAL E (moe_block2 was E=2-only).
# All reuse the OP-18 statics (_op18_gelu / _op18_gn_sqrt / _op18_moe_exp) defined
# above (same TU, in scope under the same #ifndef HEXA_CUDA). FP_CONTRACT OFF (same
# reason as OP-18 — hexa codegen emits non-FMA sequential rounding; clang -O2 would
# otherwise contract the affine/combine). Guarded `#ifndef HEXA_CUDA` → the GPU
# build is UNCHANGED (GPU bodies come from the kit's fusion_dispatch.c /
# runtime_cuda.c; no duplicate symbol). Both bare (bootstrap-seam) AND hexa_ names
# are defined (the OP-32b/OP-36 both-names precedent). Appended at EOF where
# _hx_farr_table / hexa_as_num / hexa_int are in scope. Idempotent: marker-guarded.
#
# NOT in this set (HONEST remaining, OFF-CUDA): adamw / adamw_keepmv / ce_grad /
# int4_quant / int4_quant_bwd / groupnorm_bwd / moe_router_bwd / gelu /
# embedding_bwd_scatter — deferred (need their own byte-eq oracle run, not yet
# verified this session). groupnorm_gelu_residual — also deferred: it would inherit
# the pre-existing OP-16 groupnorm_gelu GELU host-vs-ref ~2.5e-7 divergence (NOT an
# OP-37 regression), so it is held back to keep OP-37 fully max|Δ|=0-verified.
# The 4-arg dispatchers (db_colsum / residual_add / grad_sum2 / expert_pack2 /
# expert_unpack2) ARE defined here + are byte-eq by construction (pure copy/add),
# but the frozen bootstrap transpiler (hexa_cc.c) lowers a 4-arg forge_dispatch_*
# call as `hexa_call4(fn, …)` (function-as-HexaVal) → a COMPILE error (not a link
# gap) that no runtime body can fix; it needs a hexa_cc.c regen from current
# self/codegen.hexa (the N5 self-host frontier). The same wall blocks gelu_bwd.
if [ -f "$rt" ] && ! grep -q 'OP-37 (HEXA-0POD' "$rt"; then
  cat >> "$rt" <<'OP37_EOF'

/* ═══════════════════════════════════════════════════════════════════
 * OP-37 (HEXA-0POD) — OFF-CUDA host fallbacks for the clm_prod glue
 * dispatchers (b65ebe51 / e70b67c2 OFF-CUDA arm). Byte-eq-VERIFIED
 * subset: im2col(/_t) · col2im · db_colsum · grad_sum2/3 · residual_add ·
 * expert_pack2/unpack2 · embedding · groupnorm · groupnorm_gelu_residual ·
 * moe_router. Reuses the OP-18 statics (_op18_gelu/_gn_sqrt/_moe_exp).
 * `#ifndef HEXA_CUDA` only → GPU path UNCHANGED. */
#ifndef HEXA_CUDA
#pragma STDC FP_CONTRACT OFF

/* ── small validation helpers (id in-range + buffer len) ───────────── */
#define _OP37_FA(id, need) \
    ( (id) >= 0 && (id) < _hx_farr_count && _hx_farr_table[(id)].buf && \
      _hx_farr_table[(id)].len >= (need) )

/* im2col(x, xcol_out, T, Cin, K, dil) -> int rc. causal-dilated gather
 * xcol[t, ci*K+k] = (p>=0)?x[p,ci]:0, p = t - dil*(K-1-k). Writes ALL
 * cells (0 when p<0) so it does not rely on a pre-zeroed buffer — byte-eq
 * to clm_prod _clmp_im2col (t-outer, ci, k). */
HexaVal hexa_forge_dispatch_im2col(HexaVal x_v, HexaVal xcol_v, HexaVal t_v,
                                   HexaVal cin_v, HexaVal k_v, HexaVal dil_v) {
    int64_t x = hexa_as_num(x_v), xc = hexa_as_num(xcol_v);
    int64_t T = hexa_as_num(t_v), Cin = hexa_as_num(cin_v);
    int64_t K = hexa_as_num(k_v), dil = hexa_as_num(dil_v);
    if (T <= 0 || Cin <= 0 || K <= 0 || dil <= 0)            return hexa_int(-1);
    int64_t Kdim = Cin * K;
    if (!_OP37_FA(x, T * Cin) || !_OP37_FA(xc, T * Kdim))    return hexa_int(-1);
    double* X = _hx_farr_table[x].buf;
    double* XC = _hx_farr_table[xc].buf;
    for (int64_t i = 0; i < T * Kdim; i++) XC[i] = 0.0;
    for (int64_t t = 0; t < T; t++)
        for (int64_t ci = 0; ci < Cin; ci++)
            for (int64_t k = 0; k < K; k++) {
                int64_t p = t - dil * (K - 1 - k);
                if (p >= 0) XC[t * Kdim + ci * K + k] = X[p * Cin + ci];
            }
    return hexa_int(0);
}
HexaVal forge_dispatch_im2col(HexaVal x_v, HexaVal xcol_v, HexaVal t_v,
                              HexaVal cin_v, HexaVal k_v, HexaVal dil_v) {
    return hexa_forge_dispatch_im2col(x_v, xcol_v, t_v, cin_v, k_v, dil_v);
}

/* im2col_t(x, xcolT_out, T, Cin, K, dil) -> int rc. transpose form
 * xcolT[ci*K+k, t] = (p>=0)?x[p,ci]:0, len Cin*K*T. byte-eq to
 * clm_prod _clmp_im2col_t (j = ci*K+k, store at j*T+t). */
HexaVal hexa_forge_dispatch_im2col_t(HexaVal x_v, HexaVal xct_v, HexaVal t_v,
                                     HexaVal cin_v, HexaVal k_v, HexaVal dil_v) {
    int64_t x = hexa_as_num(x_v), xct = hexa_as_num(xct_v);
    int64_t T = hexa_as_num(t_v), Cin = hexa_as_num(cin_v);
    int64_t K = hexa_as_num(k_v), dil = hexa_as_num(dil_v);
    if (T <= 0 || Cin <= 0 || K <= 0 || dil <= 0)            return hexa_int(-1);
    int64_t Kdim = Cin * K;
    if (!_OP37_FA(x, T * Cin) || !_OP37_FA(xct, Kdim * T))   return hexa_int(-1);
    double* X = _hx_farr_table[x].buf;
    double* XCT = _hx_farr_table[xct].buf;
    for (int64_t i = 0; i < Kdim * T; i++) XCT[i] = 0.0;
    for (int64_t t = 0; t < T; t++)
        for (int64_t ci = 0; ci < Cin; ci++)
            for (int64_t k = 0; k < K; k++) {
                int64_t p = t - dil * (K - 1 - k);
                if (p >= 0) { int64_t j = ci * K + k; XCT[j * T + t] = X[p * Cin + ci]; }
            }
    return hexa_int(0);
}
HexaVal forge_dispatch_im2col_t(HexaVal x_v, HexaVal xct_v, HexaVal t_v,
                                HexaVal cin_v, HexaVal k_v, HexaVal dil_v) {
    return hexa_forge_dispatch_im2col_t(x_v, xct_v, t_v, cin_v, k_v, dil_v);
}

/* col2im(dXcol, dX_out, T, Cin, K, dil) -> int rc. transpose-gather scatter
 * dX[p,ci] = Σ_k (tt<T) dXcol[tt*Kdim + ci*K+k], tt = p + dil*(K-1-k).
 * ONE thread per dX cell, K taps summed in k-ascending order → byte-eq to
 * clm_prod _clmp_col2im (no atomics, deterministic). */
HexaVal hexa_forge_dispatch_col2im(HexaVal dxc_v, HexaVal dx_v, HexaVal t_v,
                                   HexaVal cin_v, HexaVal k_v, HexaVal dil_v) {
    int64_t dxc = hexa_as_num(dxc_v), dx = hexa_as_num(dx_v);
    int64_t T = hexa_as_num(t_v), Cin = hexa_as_num(cin_v);
    int64_t K = hexa_as_num(k_v), dil = hexa_as_num(dil_v);
    if (T <= 0 || Cin <= 0 || K <= 0 || dil <= 0)            return hexa_int(-1);
    int64_t Kdim = Cin * K;
    if (!_OP37_FA(dxc, T * Kdim) || !_OP37_FA(dx, T * Cin))  return hexa_int(-1);
    double* DXC = _hx_farr_table[dxc].buf;
    double* DX = _hx_farr_table[dx].buf;
    for (int64_t i = 0; i < T * Cin; i++) DX[i] = 0.0;
    for (int64_t p = 0; p < T; p++)
        for (int64_t ci = 0; ci < Cin; ci++) {
            double acc = 0.0;
            for (int64_t k = 0; k < K; k++) {
                int64_t tt = p + dil * (K - 1 - k);
                if (tt < T) { int64_t j = ci * K + k; acc += DXC[tt * Kdim + j]; }
            }
            DX[p * Cin + ci] = acc;
        }
    return hexa_int(0);
}
HexaVal forge_dispatch_col2im(HexaVal dxc_v, HexaVal dx_v, HexaVal t_v,
                              HexaVal cin_v, HexaVal k_v, HexaVal dil_v) {
    return hexa_forge_dispatch_col2im(dxc_v, dx_v, t_v, cin_v, k_v, dil_v);
}

/* db_colsum(dy, db_out, T, Cout) -> int rc. db[co] = Σ_{t} dy[t,co],
 * t-sequential per channel → byte-eq to clm_prod _clmp_db_colsum. */
HexaVal hexa_forge_dispatch_db_colsum(HexaVal dy_v, HexaVal db_v,
                                      HexaVal t_v, HexaVal cout_v) {
    int64_t dy = hexa_as_num(dy_v), db = hexa_as_num(db_v);
    int64_t T = hexa_as_num(t_v), Cout = hexa_as_num(cout_v);
    if (T <= 0 || Cout <= 0)                                 return hexa_int(-1);
    if (!_OP37_FA(dy, T * Cout) || !_OP37_FA(db, Cout))      return hexa_int(-1);
    double* DY = _hx_farr_table[dy].buf;
    double* DB = _hx_farr_table[db].buf;
    for (int64_t co = 0; co < Cout; co++) {
        double acc = 0.0;
        for (int64_t t = 0; t < T; t++) acc += DY[t * Cout + co];
        DB[co] = acc;
    }
    return hexa_int(0);
}
HexaVal forge_dispatch_db_colsum(HexaVal dy_v, HexaVal db_v,
                                 HexaVal t_v, HexaVal cout_v) {
    return hexa_forge_dispatch_db_colsum(dy_v, db_v, t_v, cout_v);
}

/* residual_add(a, b, out, n) -> int rc. out[i] = a[i] + b[i]. */
HexaVal hexa_forge_dispatch_residual_add(HexaVal a_v, HexaVal b_v,
                                         HexaVal out_v, HexaVal n_v) {
    int64_t a = hexa_as_num(a_v), b = hexa_as_num(b_v);
    int64_t o = hexa_as_num(out_v), n = hexa_as_num(n_v);
    if (n <= 0 || !_OP37_FA(a, n) || !_OP37_FA(b, n) || !_OP37_FA(o, n))
        return hexa_int(-1);
    double* A = _hx_farr_table[a].buf;
    double* B = _hx_farr_table[b].buf;
    double* O = _hx_farr_table[o].buf;
    for (int64_t i = 0; i < n; i++) O[i] = A[i] + B[i];
    return hexa_int(0);
}
HexaVal forge_dispatch_residual_add(HexaVal a_v, HexaVal b_v,
                                    HexaVal out_v, HexaVal n_v) {
    return hexa_forge_dispatch_residual_add(a_v, b_v, out_v, n_v);
}

/* grad_sum2(a, b, out, n) -> int rc. out[i] = a[i] + b[i]. */
HexaVal hexa_forge_dispatch_grad_sum2(HexaVal a_v, HexaVal b_v,
                                      HexaVal out_v, HexaVal n_v) {
    return hexa_forge_dispatch_residual_add(a_v, b_v, out_v, n_v);
}
HexaVal forge_dispatch_grad_sum2(HexaVal a_v, HexaVal b_v,
                                 HexaVal out_v, HexaVal n_v) {
    return hexa_forge_dispatch_residual_add(a_v, b_v, out_v, n_v);
}

/* grad_sum3(a, b, c, out, n) -> int rc. out[i] = (a[i]+b[i])+c[i]
 * (fixed left association → byte-eq to clm_prod _grad_sum3). */
HexaVal hexa_forge_dispatch_grad_sum3(HexaVal a_v, HexaVal b_v, HexaVal c_v,
                                      HexaVal out_v, HexaVal n_v) {
    int64_t a = hexa_as_num(a_v), b = hexa_as_num(b_v), c = hexa_as_num(c_v);
    int64_t o = hexa_as_num(out_v), n = hexa_as_num(n_v);
    if (n <= 0 || !_OP37_FA(a, n) || !_OP37_FA(b, n) ||
        !_OP37_FA(c, n) || !_OP37_FA(o, n))                 return hexa_int(-1);
    double* A = _hx_farr_table[a].buf;
    double* B = _hx_farr_table[b].buf;
    double* C = _hx_farr_table[c].buf;
    double* O = _hx_farr_table[o].buf;
    for (int64_t i = 0; i < n; i++) O[i] = A[i] + B[i] + C[i];
