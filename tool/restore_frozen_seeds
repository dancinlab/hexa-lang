}
HexaVal forge_dispatch_expert_unpack2(HexaVal dexo_v, HexaVal dex0_v,
                                      HexaVal dex1_v, HexaVal n_v) {
    return hexa_forge_dispatch_expert_unpack2(dexo_v, dex0_v, dex1_v, n_v);
}

/* embedding(ids, table, out, T, d) -> int rc. out[i*d+c]=table[tok*d+c],
 * tok = (int64_t)ids[i] (truncation == clm_prod nn_embedding_fwd to_int).
 * Pure gather → byte-eq. table len unknown here (tok-indexed) — validate
 * ids/out only + per-row tok bound against table.len. */
HexaVal hexa_forge_dispatch_embedding(HexaVal ids_v, HexaVal table_v,
                                      HexaVal out_v, HexaVal t_v, HexaVal d_v) {
    int64_t ids = hexa_as_num(ids_v), tab = hexa_as_num(table_v);
    int64_t out = hexa_as_num(out_v), T = hexa_as_num(t_v), d = hexa_as_num(d_v);
    if (T <= 0 || d <= 0 || !_OP37_FA(ids, T) || !_OP37_FA(out, T * d))
        return hexa_int(-1);
    if (tab < 0 || tab >= _hx_farr_count || !_hx_farr_table[tab].buf)
        return hexa_int(-1);
    double* IDS = _hx_farr_table[ids].buf;
    double* TAB = _hx_farr_table[tab].buf;
    int64_t tablen = _hx_farr_table[tab].len;
    double* O = _hx_farr_table[out].buf;
    for (int64_t i = 0; i < T; i++) {
        int64_t tok = (int64_t)IDS[i];
        if (tok < 0 || (tok + 1) * d > tablen)              return hexa_int(-1);
        for (int64_t c = 0; c < d; c++) O[i * d + c] = TAB[tok * d + c];
    }
    return hexa_int(0);
}
HexaVal forge_dispatch_embedding(HexaVal ids_v, HexaVal table_v,
                                 HexaVal out_v, HexaVal t_v, HexaVal d_v) {
    return hexa_forge_dispatch_embedding(ids_v, table_v, out_v, t_v, d_v);
}

/* groupnorm(x, gamma, beta, y, mean, inv, xhat, T, C, G) -> int rc.
 * EXACTLY the OP-18 groupnorm_gelu body MINUS the final GELU (and the `a`
 * out buffer): two-pass mean/var (t-outer, c-inner), eps=1e-5, 40-iter
 * Newton _op18_gn_sqrt, affine y = gamma*xhat + beta → byte-eq to
 * clm_prod nn_groupnorm_fwd / the verified groupnorm_gelu Y output. */
HexaVal hexa_forge_dispatch_groupnorm(HexaVal x_v, HexaVal gamma_v, HexaVal beta_v,
                                      HexaVal y_v, HexaVal mean_v, HexaVal inv_v,
                                      HexaVal xhat_v, HexaVal t_v, HexaVal c_v,
                                      HexaVal g_v) {
    int64_t x = hexa_as_num(x_v), gm = hexa_as_num(gamma_v), bt = hexa_as_num(beta_v);
    int64_t y = hexa_as_num(y_v), mn = hexa_as_num(mean_v), iv = hexa_as_num(inv_v);
    int64_t xh = hexa_as_num(xhat_v);
    int64_t T = hexa_as_num(t_v), C = hexa_as_num(c_v), G = hexa_as_num(g_v);
    if (T <= 0 || C <= 0 || G <= 0 || (C % G) != 0)         return hexa_int(-1);
    int64_t cg = C / G, n = T * C;
    if (!_OP37_FA(x, n) || !_OP37_FA(y, n) || !_OP37_FA(xh, n) ||
        !_OP37_FA(gm, C) || !_OP37_FA(bt, C) ||
        !_OP37_FA(mn, G) || !_OP37_FA(iv, G))               return hexa_int(-1);
    double* X = _hx_farr_table[x].buf;
    double* GM = _hx_farr_table[gm].buf;
    double* BT = _hx_farr_table[bt].buf;
    double* Y = _hx_farr_table[y].buf;
    double* MN = _hx_farr_table[mn].buf;
    double* IV = _hx_farr_table[iv].buf;
    double* XH = _hx_farr_table[xh].buf;
    const double eps = 0.00001;
    double m = (double)(cg * T);
    for (int64_t g = 0; g < G; g++) {
        int64_t c0 = g * cg;
        double sum = 0.0;
        for (int64_t t = 0; t < T; t++)
            for (int64_t c = 0; c < cg; c++)
                sum += X[t * C + (c0 + c)];
        double mu = sum / m;
        double vs = 0.0;
        for (int64_t t = 0; t < T; t++)
            for (int64_t c = 0; c < cg; c++) {
                double d = X[t * C + (c0 + c)] - mu;
                vs += d * d;
            }
        double var = vs / m;
        double inv = 1.0 / _op18_gn_sqrt(var + eps);
        MN[g] = mu;
        IV[g] = inv;
        for (int64_t t = 0; t < T; t++)
            for (int64_t c = 0; c < cg; c++) {
                int64_t ch = c0 + c, idx = t * C + ch;
                double xhat = (X[idx] - mu) * inv;
                XH[idx] = xhat;
                Y[idx] = GM[ch] * xhat + BT[ch];
            }
    }
    return hexa_int(0);
}
HexaVal forge_dispatch_groupnorm(HexaVal x_v, HexaVal gamma_v, HexaVal beta_v,
                                 HexaVal y_v, HexaVal mean_v, HexaVal inv_v,
                                 HexaVal xhat_v, HexaVal t_v, HexaVal c_v,
                                 HexaVal g_v) {
    return hexa_forge_dispatch_groupnorm(x_v, gamma_v, beta_v, y_v, mean_v,
                                         inv_v, xhat_v, t_v, c_v, g_v);
}

/* NOTE: groupnorm_gelu_residual is INTENTIONALLY NOT added here. Its GN +
 * residual parts are byte-eq (verified), but it would delegate the GELU to the
 * already-shipped OP-18 groupnorm_gelu body, which carries a pre-existing
 * ~2.5e-7 GELU host-vs-reference divergence (NOT introduced by OP-37 — the OP-16
 * groupnorm_gelu host fallback already exhibits it on main). To keep OP-37 a
 * coherent, fully max|Δ|=0-verified set, the *_residual host body is deferred
 * until that underlying GELU gap is resolved. */

/* moe_router(logits, ex_out, probs, y, T, E, C) -> int rc. softmax gate
 * over E (max + _op18_moe_exp + normalize — the SAME hand-rolled exp the
 * verified OP-18 moe_block2 uses) then sequential gate-weighted combine
 * y[t,c] = Σ_e probs[t,e]·ex_out[e*T*C + t*C + c]. GENERAL E. byte-eq to
 * clm_prod nn_moe_router_fwd. */
HexaVal hexa_forge_dispatch_moe_router(HexaVal logits_v, HexaVal exo_v,
                                       HexaVal probs_v, HexaVal y_v,
                                       HexaVal t_v, HexaVal e_v, HexaVal c_v) {
    int64_t lg = hexa_as_num(logits_v), eo = hexa_as_num(exo_v);
    int64_t pr = hexa_as_num(probs_v), y = hexa_as_num(y_v);
    int64_t T = hexa_as_num(t_v), E = hexa_as_num(e_v), C = hexa_as_num(c_v);
    if (T <= 0 || E <= 0 || C <= 0)                         return hexa_int(-1);
    if (!_OP37_FA(lg, T * E) || !_OP37_FA(pr, T * E) ||
        !_OP37_FA(eo, E * T * C) || !_OP37_FA(y, T * C))    return hexa_int(-1);
    double* LG = _hx_farr_table[lg].buf;
    double* EO = _hx_farr_table[eo].buf;
    double* PR = _hx_farr_table[pr].buf;
    double* Y = _hx_farr_table[y].buf;
    for (int64_t t = 0; t < T; t++) {
        int64_t base = t * E;
        double mx = LG[base];
        for (int64_t e = 1; e < E; e++) { double v = LG[base + e]; if (v > mx) mx = v; }
        double s = 0.0;
        for (int64_t e = 0; e < E; e++) {
            double ev = _op18_moe_exp(LG[base + e] - mx);
            PR[base + e] = ev;
            s += ev;
        }
        for (int64_t e = 0; e < E; e++) PR[base + e] = PR[base + e] / s;
    }
    for (int64_t t = 0; t < T; t++)
        for (int64_t c = 0; c < C; c++) {
            double acc = 0.0;
            for (int64_t e = 0; e < E; e++)
                acc += PR[t * E + e] * EO[e * T * C + t * C + c];
            Y[t * C + c] = acc;
        }
    return hexa_int(0);
}
