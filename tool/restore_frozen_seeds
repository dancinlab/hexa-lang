}
HexaVal forge_dispatch_grad_sum3(HexaVal a_v, HexaVal b_v, HexaVal c_v,
                                 HexaVal out_v, HexaVal n_v) {
    return hexa_forge_dispatch_grad_sum3(a_v, b_v, c_v, out_v, n_v);
}

/* expert_pack2(ex0, ex1, ex_out, n) -> int rc. ex_out[0*n+j]=ex0[j],
 * ex_out[1*n+j]=ex1[j] (E=2 pack) → byte-eq to clm_prod _expert_pack2. */
HexaVal hexa_forge_dispatch_expert_pack2(HexaVal ex0_v, HexaVal ex1_v,
                                         HexaVal exo_v, HexaVal n_v) {
    int64_t e0 = hexa_as_num(ex0_v), e1 = hexa_as_num(ex1_v);
    int64_t eo = hexa_as_num(exo_v), n = hexa_as_num(n_v);
    if (n <= 0 || !_OP37_FA(e0, n) || !_OP37_FA(e1, n) || !_OP37_FA(eo, 2 * n))
        return hexa_int(-1);
    double* E0 = _hx_farr_table[e0].buf;
    double* E1 = _hx_farr_table[e1].buf;
    double* EO = _hx_farr_table[eo].buf;
    for (int64_t j = 0; j < n; j++) { EO[0 * n + j] = E0[j]; EO[1 * n + j] = E1[j]; }
    return hexa_int(0);
}
HexaVal forge_dispatch_expert_pack2(HexaVal ex0_v, HexaVal ex1_v,
                                    HexaVal exo_v, HexaVal n_v) {
    return hexa_forge_dispatch_expert_pack2(ex0_v, ex1_v, exo_v, n_v);
}

/* expert_unpack2(dex_out, dex0, dex1, n) -> int rc. dex0[i]=dex_out[0*n+i],
 * dex1[i]=dex_out[1*n+i] → byte-eq to clm_prod _expert_unpack2. */
HexaVal hexa_forge_dispatch_expert_unpack2(HexaVal dexo_v, HexaVal dex0_v,
                                           HexaVal dex1_v, HexaVal n_v) {
    int64_t deo = hexa_as_num(dexo_v), d0 = hexa_as_num(dex0_v);
