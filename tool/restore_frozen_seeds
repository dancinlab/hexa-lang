#!/usr/bin/env bash
# tool/restore_frozen_seeds — restore the bootstrap C seeds from the authoritative
# pre-graduation git blob, so a fresh `.c=0` checkout can self-build runtime.a +
# build/hexat WITHOUT pulling a per-platform edge tarball.
#
# ── Why this exists (P7 — edge-seed chicken-egg) ─────────────────────────────
# At graduation commit 7906951c0 ("tracked .c = 0", #2065) all bootstrap C seeds
# (self/runtime.c + its 19 #include fragments + self/native/hexa_cc.c) were
# git-removed. The release pipeline then resolves runtime.a + build/hexat ONLY
# from a prior `edge` tarball. But the `edge` release ships ONLY
# hexa-linux-arm64.tar.gz, so linux-x86_64 and darwin-arm64 have NO seed → the
# edge-pull stages exit 1 → `release` + `nobaseline-gate` go RED on those two
# platforms. (linux-arm64 self-heals: its job goes green and re-uploads.)
#
# self/runtime.c (14663 lines) has no SSOT emitter — only fragments — and the
# toolchain is read-only, so the only authoritative source for a coherent
# same-revision runtime is the frozen git blob at 7906951c0^ (= 151c52c82, the
# parent of the graduation commit). This script restores exactly that seed set
# into the working tree on demand. The files are NOT committed — they are an
# ephemeral build input, restored into the checkout, compiled, then discarded
# (CI checkouts are throwaway; locally the caller restores the tree afterward).
# This preserves the .hexa-only graduated state in git while keeping every
# platform self-sufficient for bootstrap.
#
# The seed set is IDENTICAL to nobaseline-gate.yml's $SEEDS (23 files) minus
# self/bootstrap_compiler.c (not a runtime.c #include; not needed for runtime.a
# or hexat). All paths verified to exist as blobs at the pinned ref.
#
# Usage:  bash tool/restore_frozen_seeds            # restore all seeds
#         FROZEN_SEED_REF=<sha> bash tool/restore_frozen_seeds   # override ref
# Prints the restored file count. Exits non-zero if any checkout fails.
set -euo pipefail

# Pinned to the parent of the graduation commit 7906951c0 (#2065) — given as the
# parent's FULL SHA (151c52c8…), NOT `7906951c0^`, because CI checks out with
# actions/checkout fetch-depth:1 (shallow) where neither the graduation commit
# nor its parent is present locally; a full SHA is fetchable on demand whereas a
# `<sha>^` revision cannot be resolved without the child object. This is the last
# revision where the bootstrap C seeds were tracked and mutually coherent.
FROZEN_SEED_REF="${FROZEN_SEED_REF:-151c52c82502e93d01735c58b43b017d102fee63}"

# The frozen seed set: self/runtime.c + the .c fragments it #includes (derived
# from `git show <ref>:self/runtime.c | grep '#include "'`) + the transpiler
# seed self/native/hexa_cc.c (needed by stage_prebuild_hexat to build hexat).
# RT-NATIVE Z2a: runtime_hi_gen.c is NO LONGER restored from the frozen blob.
# The frozen 151c52c8 blob is a STALE 6-fn copy (split/lines/pad_left/pad_right/
# repeat/center); the SSOT has since grown the casefold/trim group (rt_str_to_upper/
# to_lower/trim → 9 fn) AND its C #ifndef bodies in runtime_core_emit.hexa are
# RETIRED — so the regenerated runtime_core.c expects the 9-fn gen.c as the sole
# provider. Restoring the 6-fn blob → "undefined reference to rt_str_to_upper/trim"
# on the seeds-removed (faithful-nobaseline) link. Previously stage_resolve_runtime_a
# tried to runtime-regen the 9-fn gen.c via a native hexat, but that regen is FLAKY
# on the seeds-removed CI host (the committed per-target hexat seed fails to exec
# there). The robust fix: SYNTHESIZE the 9-fn gen.c DETERMINISTICALLY from the
# committed emitter SSOT (self/runtime_hi_gen_emit.hexa) with a pure-awk un-escaper
# (NO hexat / NO runtime) in the post-restore block below — so the seeds-removed
# path needs no runtime regen. The frozen blob is kept only as a NO-OP-SAFE fallback
# if the emitter SSOT is absent. When the native path is active (HEXA_ZEROC_RT_HI=1)
# rt_str_* come from build/rt_hi_native.o and gen.c is never needed at all.
[ "${HEXA_ZEROC_RT_HI:-0}" = "1" ] && _RT_HI_NATIVE=1 || _RT_HI_NATIVE=0
FROZEN_SEEDS=(
  self/runtime.c
  self/runtime_core.c
  self/native/hexa_cc.c
  self/native/tensor_kernels.c
  self/native/net.c
  self/native/thread.c
  self/native/pty.c
  self/native/mount.c
  self/native/namespace.c
  self/native/wait.c
  self/native/crypto_sodium.c
  self/native/crypto_openssl.c
  self/native/exec_pipe.c
  self/native/proc_fork.c
  self/native/fp_init.c
  self/native/signal_flock.c
  self/native/exec_argv_sha256.c
  self/native/persistent_pipe.c
  self/native/term_ffi.c
  self/forge/forge_tier_v1.c
)

echo "[restore_frozen_seeds] restoring ${#FROZEN_SEEDS[@]} bootstrap seeds from $FROZEN_SEED_REF"

# On a shallow CI checkout (actions/checkout fetch-depth:1) the pinned commit is
# absent. Fetch just that commit on demand — GitHub allows fetching a reachable
# SHA directly. No-op when the object is already present (full clones).
if ! git cat-file -e "${FROZEN_SEED_REF}^{commit}" 2>/dev/null; then
  echo "[restore_frozen_seeds] $FROZEN_SEED_REF absent (shallow checkout) — fetching on demand"
  git fetch --depth=1 origin "$FROZEN_SEED_REF" 2>/dev/null \
    || git fetch origin "$FROZEN_SEED_REF" 2>/dev/null \
    || { echo "[restore_frozen_seeds] FATAL: cannot fetch $FROZEN_SEED_REF" >&2; exit 1; }
fi

n=0
for f in "${FROZEN_SEEDS[@]}"; do
  # Restore the blob content WITHOUT staging it (--) so the working tree gets the
  # file but git status still treats it as the graduated (removed) state once the
  # caller cleans up. `git checkout <ref> -- <file>` does stage it; we follow up
  # with `git reset` of the path-set so the index stays at HEAD (uncommitted).
  if git checkout "$FROZEN_SEED_REF" -- "$f" 2>/dev/null; then
    n=$((n+1))
  else
    echo "[restore_frozen_seeds] FATAL: cannot restore $f from $FROZEN_SEED_REF" >&2
    exit 1
  fi
done
# ── OP-17 (HEXA-0POD) — -Wmacro-redefined hygiene patch ──────────────────────
# The frozen self/runtime.c #defines 9 libc names (strcat/bzero/memcpy/memset/
# memmove/strncpy/strcpy/snprintf/sprintf) that Darwin clang's _FORTIFY_SOURCE
# secure headers (<secure/_string.h>/_strings.h/_stdio.h) ALREADY #define as
# __*_chk_func fortify macros → 9 [-Wmacro-redefined] warnings on every build.
# The SSOT is the immutable frozen blob (151c52c8…, the .c-graduation parent),
# so the fix lands here as a deterministic post-restore patch: insert `#undef`
# before the override block (same precedent as the seed's own `#undef isalnum`/
# `#undef exit`). BEHAVIOR-PRESERVING — the hxlcl_* macro is the effective
# expansion either way (it is the last #define); #undef only silences the warning.
# Idempotent: the marker guards against double-injection across re-restores.
rt="self/runtime.c"
if [ -f "$rt" ] && ! grep -q 'OP-17 (HEXA-0POD' "$rt"; then
  # Anchor on the unique override-block comment line; inject the #undef block
  # immediately before the first `#define strlen(` that follows it.
  awk '
    /^#define strlen\(s\)/ && !done {
      print "// OP-17 (HEXA-0POD) -Wmacro-redefined hygiene — #undef the 9 names the"
      print "// Darwin _FORTIFY_SOURCE secure headers already #define as __*_chk_func"
      print "// fortify macros, before our hxlcl_* override (behavior-preserving: our"
      print "// macro is the effective expansion either way; #undef only kills the warn)."
      print "#undef strcat"
      print "#undef bzero"
      print "#undef memcpy"
      print "#undef memset"
      print "#undef memmove"
      print "#undef strncpy"
      print "#undef strcpy"
      print "#undef snprintf"
      print "#undef sprintf"
      done=1
    }
    { print }
  ' "$rt" > "$rt.op17" && mv "$rt.op17" "$rt"
  echo "[restore_frozen_seeds] OP-17: injected 9 #undef (-Wmacro-redefined hygiene) into $rt"
fi

# ── RT-NATIVE leg B Z2a (trim-ends group) — scrub frozen runtime.c C bodies ───
# The casefold/trim group's C bodies were ABSENT from the frozen 151c52c8
# runtime.c, so no scrub was needed for them. The trim-ends siblings
# (rt_str_trim_start / rt_str_trim_end) ARE still present in the frozen blob as
# `#ifndef HEXA_HAS_HEXA_RT_STDLIB` C bodies (the seeds-removed runtime.a is
# compiled WITHOUT that macro, so those bodies WOULD compile). Now that the SSOT
# moved both fns into the HI-tier runtime_hi_gen.c (synthesized below) the gen.c
# provides them on every target → leaving the frozen C bodies in place would be a
# DUPLICATE symbol at the app link. Delete the two C definition bodies (signature
# line through the column-0 closing brace) from the restored runtime.c; the empty
# `#ifndef`/`#endif` shells left behind compile harmlessly. NO-OP-SAFE: if the
# bodies are already absent (e.g. a future frozen-ref drop), the awk leaves the
# file unchanged. Idempotent (re-running finds nothing to delete).
if [ -f "$rt" ] && grep -q 'HexaVal rt_str_trim_start(HexaVal s) {' "$rt"; then
  before=$(wc -l < "$rt")
  awk '
    /^HexaVal rt_str_trim_start\(HexaVal s\) \{$/ { skip=1 }
    /^HexaVal rt_str_trim_end\(HexaVal s\) \{$/   { skip=1 }
    {
      if (skip) {
        if ($0 == "}") { skip=0; next }
        next
      }
      print
    }
  ' "$rt" > "$rt.z2atrim" && mv "$rt.z2atrim" "$rt"
  after=$(wc -l < "$rt")
  echo "[restore_frozen_seeds] RT-NATIVE Z2a: scrubbed frozen rt_str_trim_start/end C bodies from $rt ($((before-after)) lines; gen.c now sole provider)"
fi

# ── RT-NATIVE leg B Z2a (casefold/trim group) — scrub the 3 frozen runtime_core.c
# C bodies so the synthesized runtime_hi_gen.c is their sole provider (closes the
# install.sh clang-18 redefinition class). ──────────────────────────────────────
# The frozen 151c52c8 self/runtime_core.c blob still ships the casefold/trim group
# (rt_str_trim @7445, rt_str_to_upper @7506, rt_str_to_lower @7513) as
# `#ifndef HEXA_HAS_HEXA_RT_STDLIB` C bodies. The HI-tier SSOT moved all three into
# runtime_hi_gen.c (synthesized below) and RETIRED their core.c bodies in the emitter
# (self/runtime_core_emit.hexa now emits ONLY the prototypes). runtime_core.c
# `#include "runtime_hi_gen.c"`, so the restored frozen core.c bodies + the 9-fn gen.c
# = two definitions of rt_str_to_upper/to_lower/trim in ONE TU → clang-18
# "error: redefinition of 'rt_str_to_upper'" (strict; older toolchains were lenient).
# The release pipeline never hit this: tool/stage_resolve_runtime_a regenerates core.c
# from the emitter SSOT — but install.sh calls THIS script directly (not the stage_*
# sequence), so the user-facing build kept the stale bodies and broke on every 24.04
# host. This is the EXACT trim-ends scrub above, extended to the casefold/trim trio:
# a TARGETED in-place delete of the three C bodies (signature line through the
# column-0 closing brace), leaving the frozen core.c otherwise byte-identical. A
# narrow scrub — NOT a full emitter-regen — is deliberate: the CURRENT emitter core.c
# delegates array/map accessors to rt_array_get_native / rt_map_get_native (RT-NATIVE
# read-half), which require the per-arch native .o seeds that the release stage_*
# assembles but install.sh does NOT — so regenerating the whole core.c here would
# trade the redefinition error for an `undefined reference` link error. The frozen
# core.c keeps its self-contained C array/map fallbacks (no seed needed) and its
# frozen f64<->bits coherence (no SSOT-migration reconcile needed). NO-OP-SAFE +
# idempotent: the grep guard skips when the bodies are already absent.
_RTC="self/runtime_core.c"
if [ -f "$_RTC" ] && grep -q '^HexaVal rt_str_to_upper(HexaVal s) {' "$_RTC"; then
  before=$(wc -l < "$_RTC")
  awk '
    /^HexaVal rt_str_to_upper\(HexaVal s\) \{$/ { skip=1 }
    /^HexaVal rt_str_to_lower\(HexaVal s\) \{$/ { skip=1 }
    /^HexaVal rt_str_trim\(HexaVal s\) \{$/     { skip=1 }
    {
      if (skip) {
        if ($0 == "}") { skip=0; next }
        next
      }
      print
    }
  ' "$_RTC" > "$_RTC.z2acase" && mv "$_RTC.z2acase" "$_RTC"
  after=$(wc -l < "$_RTC")
  echo "[restore_frozen_seeds] RT-NATIVE Z2a: scrubbed frozen rt_str_to_upper/to_lower/trim C bodies from $_RTC ($((before-after)) lines; gen.c now sole provider)"
fi

# ── ranged read_bytes_at SIGSEGV fix (#3352 propagation) ─────────────────────
# The frozen 151c52c8 runtime_core.c blob seeks in rt_read_bytes_at (its only
# offset-seeking reader; rt_read_f32_at is newer and absent from this blob)
# with the UNSHIMMED fseeko/_fseeki64 on the FILE* returned by fopen. Under the
# runtime's libc shim layer that fopen is `#define fopen hxlcl_fopen`, whose handle
# is NOT a real libc FILE* — so a real fseeko/_fseeki64 dereferences a bogus FILE
# (flockfile path) and SIGSEGVs on any ranged read (offset > 0). The SSOT emitter
# (self/runtime_core_emit.hexa, #3352 2026-06-15) already replaced that block with
# the SHIMMED `fseek(f, (long)off, SEEK_SET)` (`long` = 64-bit on LP64 over
# hxlcl_lseek(off_t), so >2 GB offsets are honored), but the fix never reached the
# COMPILED runtime: install.sh restores this frozen blob directly and never re-runs
# the emitter, so every install/build still shipped the crashing fseeko (anima
# H_1431 R3 — ranged read_bytes_at segfault forcing full-load). Same precedent as
# the OP-17 / Z2a scrubs above: a deterministic, hexat-free, in-place patch that
# rewrites the 5-line `#if _WIN32 / _fseeki64 / #else / fseeko / #endif` block to
# the single shimmed `fseek` call. The unique `fseeko((off_t)off` token gates
# idempotency (re-runs find nothing once patched).
if [ -f "$_RTC" ] && grep -q 'fseeko(f, (off_t)off, SEEK_SET)' "$_RTC"; then
  before=$(wc -l < "$_RTC")
  awk '
    # Drop the 5-line WIN32/fseeko seek block; emit the shimmed fseek in its place.
    /^    \/\/ Use 64-bit seek where available; on macOS\/Linux fseeko is standard\.$/ {
      print "    // SHIMMED fseek (#3352): fopen is `#define fopen hxlcl_fopen`, whose"
      print "    // handle is NOT a real libc FILE*, so the unshimmed fseeko/_fseeki64"
      print "    // dereference a bogus FILE and SIGSEGV on any ranged read (offset>0)."
      print "    // hxlcl_fseek takes `long` (64-bit on LP64) over hxlcl_lseek(off_t),"
      print "    // so >2 GB offsets are honored."
      print "    if (fseek(f, (long)off, SEEK_SET) != 0) { fclose(f); return hexa_array_new(); }"
      drop=5
      next
    }
    { if (drop > 0) { drop--; next } print }
  ' "$_RTC" > "$_RTC.rbfix" && mv "$_RTC.rbfix" "$_RTC"
  after=$(wc -l < "$_RTC")
  echo "[restore_frozen_seeds] read_bytes_at: replaced frozen fseeko ranged-seek with shimmed fseek (#3352) in $_RTC ($((before-after)) lines)"
fi

# ── RT-NATIVE leg B Z2a — SYNTHESIZE the 9-fn runtime_hi_gen.c seed ───────────
# The casefold/trim group (rt_str_to_upper/to_lower/trim) grew the HI-tier
# rt_str_* SSOT from 6→9 fn and RETIRED the matching C #ifndef bodies from
# runtime_core_emit.hexa. The frozen 151c52c8 runtime_hi_gen.c blob is a stale
# 6-fn copy, so on the seeds-removed path the regenerated runtime_core.c (no C
# bodies) + a 6-fn gen.c → "undefined reference to rt_str_to_upper/trim" at the
# app link. The deterministic, hexat-free fix: materialize the 9-fn gen.c by
# un-escaping the committed emitter SSOT (self/runtime_hi_gen_emit.hexa) — its
# `buf = buf + "..."` lines ARE the emitted .c text VERBATIM (proven byte-
# identical to the extract.sh hexat output). This needs NO runtime regen, so it
# is immune to the flaky _resolve_native_hexat seeds-removed regen path.
# NO-OP-SAFE: if the emitter SSOT is absent or the synthesis is malformed, fall
# back to restoring the frozen 6-fn blob (never weaker than the prior behavior).
# Skipped entirely when the native seed path is active (rt_str_* from
# build/rt_hi_native.o; gen.c never #included).
if [ "${_RT_HI_NATIVE:-0}" != "1" ]; then
  _RHG="self/runtime_hi_gen.c"
  _RHG_EMIT="self/runtime_hi_gen_emit.hexa"
  _rhg_done=0
  if [ -f "$_RHG_EMIT" ]; then
    _rhg_tmp="$(mktemp -t rhg_synth.XXXXXX)" || _rhg_tmp=""
    if [ -n "$_rhg_tmp" ]; then
      # Pure-awk un-escaper: extract the `    buf = buf + "<C-line>"` literals and
      # decode \n \t \" \\ to reproduce runtime_hi_gen.c exactly.
      awk '
        {
          line = $0
          pfx = "    buf = buf + \""
          if (substr(line, 1, length(pfx)) != pfx) next
          body = substr(line, length(pfx) + 1)
          if (substr(body, length(body), 1) != "\"") next
          body = substr(body, 1, length(body) - 1)
          out = ""; n = length(body); i = 1
          while (i <= n) {
            c = substr(body, i, 1)
            if (c == "\\" && i < n) {
              d = substr(body, i+1, 1)
              if (d == "n")  { out = out "\n"; i += 2; continue }
              if (d == "t")  { out = out "\t"; i += 2; continue }
              if (d == "\"") { out = out "\""; i += 2; continue }
              if (d == "\\") { out = out "\\"; i += 2; continue }
              out = out "\\"; i += 1; continue
            }
            out = out c; i += 1
          }
          printf "%s", out
        }
      ' "$_RHG_EMIT" > "$_rhg_tmp" 2>/dev/null || true
      # Validate: must carry all 14 fn (3 casefold/trim + 2 trim-ends + 3 search
      # predicates) + ctor.
      if [ -s "$_rhg_tmp" ] \
         && grep -q 'HexaVal rt_str_to_upper(HexaVal s) {' "$_rhg_tmp" \
         && grep -q 'HexaVal rt_str_to_lower(HexaVal s) {' "$_rhg_tmp" \
         && grep -q 'HexaVal rt_str_trim(HexaVal s) {' "$_rhg_tmp" \
         && grep -q 'HexaVal rt_str_trim_start(HexaVal s) {' "$_rhg_tmp" \
         && grep -q 'HexaVal rt_str_trim_end(HexaVal s) {' "$_rhg_tmp" \
         && grep -q 'HexaVal rt_str_starts_with_b(HexaVal s, HexaVal prefix) {' "$_rhg_tmp" \
         && grep -q 'HexaVal rt_str_ends_with_b(HexaVal s, HexaVal suffix) {' "$_rhg_tmp" \
         && grep -q 'HexaVal rt_str_contains_b(HexaVal s, HexaVal sub) {' "$_rhg_tmp" \
         && grep -q '__hexa_rt_strlit_init_ctor' "$_rhg_tmp"; then
        cp -f "$_rhg_tmp" "$_RHG"
        echo "[restore_frozen_seeds] RT-NATIVE Z2a: synthesized 14-fn $_RHG from $_RHG_EMIT ($(wc -l < "$_RHG") lines, hexat-free)"
        _rhg_done=1
      fi
      rm -f "$_rhg_tmp"
    fi
  fi
  if [ "$_rhg_done" != "1" ]; then
    # Fallback: restore the frozen 6-fn blob (prior behavior; stale but present).
    if git checkout "$FROZEN_SEED_REF" -- "$_RHG" 2>/dev/null; then
      git reset -q -- "$_RHG" 2>/dev/null || true
      echo "[restore_frozen_seeds] RT-NATIVE Z2a: emitter synth unavailable — restored FROZEN 6-fn $_RHG (fallback; runtime regen may be needed)" >&2
    else
      echo "[restore_frozen_seeds] RT-NATIVE Z2a: WARN cannot synth or restore $_RHG" >&2
    fi
  fi
fi

# ── UNSHADOW F1 (typed-array shim) — inject HexaArrI64/F64 into frozen core ────
# The frozen self/runtime_core.c (151c52c8…, .c-graduation parent) PREDATES the
# native typed-array storage shims (UNSHADOW [HEADLINE] F1 + its F64 mirror), so
# the restored seed has NEITHER the HexaArrI64/HexaArrF64 struct typedefs NOR the
# 8 helper bodies hexa_arr_{i64,f64}_{new,push,len,box}. But the codegen emits a
# `hexa_arr_f64_new(...)/hexa_arr_f64_push(...)` (resp. i64) construction for any
# statically-proven monomorphic float/int array LITERAL (self/codegen.hexa ~3045/
# 3077), and the tracked self/runtime.h already forward-declares all 8. So a .hexa
# carrying a float-array literal (e.g. `[1.0, 2.0, 3.0]`) LINKED against the
# seeds-removed release runtime.a died with `undefined reference to hexa_arr_f64_new`.
# The deterministic, hexat-free fix (same precedent as the Z2a gen.c synth above):
# splice the typedefs + the 8 helper bodies into the restored runtime_core.c,
# verbatim from the emitter SSOT (self/runtime_core_emit.hexa). The two structs go
# right after `} HexaArr;` (so HexaVal->arr_ptr can carry either descriptor) and
# the 8 helpers right after the `hexa_array_new()` body. Dependencies they use —
# HX_SET_ARR_PTR / hexa_throw / hexa_str / hexa_int / hexa_float / TAG_ARRAY — all
# already exist in the frozen blob. Idempotent: a marker guards re-injection.
_RTC="self/runtime_core.c"
if [ -f "$_RTC" ] && ! grep -q 'UNSHADOW F1 typed-array shim (restore-injected)' "$_RTC"; then
  awk '
    # 1) struct typedefs immediately after the HexaArr typedef close.
    /^} HexaArr;$/ {
      print
      print ""
      print "// UNSHADOW F1 typed-array shim (restore-injected): native contiguous"
      print "// int64_t[]/double[] storage descriptors. Layout-match HexaArr (ptr,len,cap)"
      print "// so a TAG_ARRAY HexaVal carries either via the SAME arr_ptr union slot."
      print "typedef struct HexaArrI64 {"
      print "    int64_t* data;"
      print "    int64_t len;"
      print "    int64_t cap;"
      print "} HexaArrI64;"
      print ""
      print "typedef struct HexaArrF64 {"
      print "    double* data;"
      print "    int64_t len;"
      print "    int64_t cap;"
      print "} HexaArrF64;"
      next
    }
    # 2) the 8 helper bodies immediately after the hexa_array_new() body close.
    #    Match the first column-0 "}" that follows the array_new signature line.
    /^HexaVal hexa_array_new\(\) \{$/ { in_an = 1 }
    {
      print
      if (in_an && $0 == "}") {
        in_an = 0
        print ""
        print "// UNSHADOW F1 typed-array shim (restore-injected): the 8 helper bodies the"
        print "// codegen emits for proven monomorphic-i64/f64 array literals (forward-decl"
        print "// in self/runtime.h). Verbatim from self/runtime_core_emit.hexa."
        print "HexaVal hexa_arr_i64_new(int cap) {"
        print "    HexaArrI64* a = (HexaArrI64*)malloc(sizeof(HexaArrI64));"
        print "    if (!a) { fprintf(stderr, \"OOM in arr_i64_new\\n\"); exit(1); }"
        print "    if (cap < 1) cap = 1;"
        print "    a->data = (int64_t*)malloc(sizeof(int64_t) * (size_t)cap);"
        print "    if (!a->data) { fprintf(stderr, \"OOM in arr_i64_new data\\n\"); exit(1); }"
        print "    a->len = 0; a->cap = cap;"
        print "    HexaVal v = {.tag=TAG_ARRAY};"
        print "    HX_SET_ARR_PTR(v, (HexaArr*)a);"
        print "    return v;"
        print "}"
        print "HexaVal hexa_arr_i64_push(HexaVal v, int64_t x) {"
        print "    HexaArrI64* a = (HexaArrI64*)v.arr_ptr;"
        print "    if (a->len >= a->cap) {"
        print "        a->cap *= 2;"
        print "        a->data = (int64_t*)realloc(a->data, sizeof(int64_t) * (size_t)a->cap);"
        print "        if (!a->data) { fprintf(stderr, \"OOM in arr_i64_push\\n\"); exit(1); }"
        print "    }"
        print "    a->data[a->len++] = x;"
        print "    return v;"
        print "}"
        print "int hexa_arr_i64_len(HexaVal v) { return ((HexaArrI64*)v.arr_ptr)->len; }"
