    double* D0 = _hx_farr_table[d0].buf;
    double* D1 = _hx_farr_table[d1].buf;
    for (int64_t i = 0; i < n; i++) { D0[i] = DEO[0 * n + i]; D1[i] = DEO[1 * n + i]; }
