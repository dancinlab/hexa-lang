        "Linux aarch64"|"Linux arm64") tgt="linux-arm64" ;;
    esac
    # ALL-TARGET adoption (sh-val-core r2): the scalar value-op seed is byte-eq
    # proven + self-host-byteeq GREEN on linux-x86_64 (gen3≡gen4, faithful +
    # selfhost-byteeq-real PASS). The arm64 seeds are byte-FAITHFUL in isolation
    # (standalone valop_core_gate.c → 32/32 0-fail under qemu-aarch64). The arm64
    # self-host previously SIGSEGV'd when hexa_v2 ran with the seed folded in: the
    # arm64 codegen lowered every `if <bool-HexaVal>` via `bl hexa_truthy` (x86_64
    # inlines it — the valop x86_64 seed has ZERO `call`s), so on the value-op hot
    # path the bl-heavy seed fns diverged/blew the stack inside hexa_v2 (#3704 —
    # MEASURED on qemu-aarch64). r2 (#3704-followup): arm64 br_cond now INLINES the
    # truthy test (`cbz x1, else` on the payload word, matching x86_64's
    # `test cond; jz`; arm64_darwin.hexa _STMT_BR_COND), so the `bl hexa_truthy`
    # hot-path calls are gone and arm64 self-host runs clean → all 3 targets adopt
    # the native scalar value-op path.
    case "$tgt" in
        linux-x86_64) seed="self/native/valop_core_x86_64.s" ;;
        darwin-arm64) seed="self/native/valop_core_arm64.s" ;;
        linux-arm64)  seed="self/native/valop_core_arm64-linux.s" ;;
        *)            seed="" ;;   # unknown → C scalar path
    esac
    [ -n "$seed" ] && [ -f "$seed" ] || return 0
    mkdir -p build
    # SAFETY: only adopt the native path if the seed exports ALL the fns the
    # runtime_core.c delegation expects — a stale/partial seed would yield an
    # `undefined reference` at the app link. Counted from `.globl` (toolchain-free).
    local ok=1 sym n
    for sym in rt_truthy_native rt_sub_native rt_mul_native rt_add_native \
               rt_cmp_lt_native rt_cmp_gt_native rt_cmp_le_native rt_cmp_ge_native \
               rt_div_native rt_mod_native; do
        n="$(grep -cE "^\.globl[[:space:]]+_?${sym}\$" "$seed" 2>/dev/null || echo 0)"
        [ "${n:-0}" -ge 1 ] || { ok=0; echo "[stage_resolve_runtime_a] RT-NATIVE VALOP: seed $seed exports only $n/1 $sym — falling back to C scalar path" >&2; }
    done
    [ "$ok" = "1" ] || return 0
    local s_tmp="build/valop_core_seed.s"
    grep -vE '^// ' "$seed" > "$s_tmp" 2>/dev/null || cp "$seed" "$s_tmp"
    if $CC -c "$s_tmp" -o build/valop_core_native.o 2>/dev/null; then
        export HEXA_RT_VALOP_NATIVE=1
        echo "[stage_resolve_runtime_a] RT-NATIVE VALOP: assembled build/valop_core_native.o from $seed (TARGET=$tgt, 10/10 rt_*_native syms incl cmp+div/mod) → native scalar value-op path"
    else
        echo "[stage_resolve_runtime_a] RT-NATIVE VALOP: WARN assemble of $seed failed — falling back to C scalar path" >&2
    fi
    rm -f "$s_tmp"
}

# ── RT-NATIVE leg B Route B — linked-block arena native seed → build/alloc_syscall_native.o ──
# The arena twin of resolve_native_array_core_seed: assemble the arch-matched
# frozen self/native/alloc_syscall_*.s seed (a full HexaArenaBlock-chain arena +
# syscall layer, C-ABI equivalent to runtime_core_emit.hexa's C arena) into
# build/alloc_syscall_native.o so the arena C `#else` (under HEXA_RT_ALLOC_NATIVE)
# is bypassed. DEFAULT-ON (measure-8, all 3 targets RUN-proven): x86_64 + darwin-arm64
# (measure-6/7) + linux-arm64 (r1 2026-06-19, full release_build on aarch64) confirmed
# the native arena replaces the C arena wholesale (mark 16-byte struct-return ABI +
# heapify↔envelope wiring all proven), so this is auto-on like array/map. The C arena
# body in runtime_core_emit.hexa's `#else` arm is RETAINED as the no-seed / revert
# safety net (byteeq-inert while native is active — it lives in !HEXA_RT_ALLOC_NATIVE
# and is never compiled on a seed target); set HEXA_RT_ALLOC_NATIVE=0 to revert all
# targets to that live C arena, or HEXA_RT_ALLOC_NATIVE_ARM64=0 for linux-arm64 only.
# Dropping that #else body (the genuine substrate byte reduction) is deferred until
# the linux-arm64 native arena has soaked on the edge channel (invariant: no #3597
# regression; the fallback stays a live net until soak, not just one full-build PASS).
resolve_native_alloc_syscall_seed() {
    [ "${HEXA_RT_ALLOC_NATIVE:-1}" = "0" ] && return 0   # default-ON; =0 to revert
    [ -f build/alloc_syscall_native.o ] && return 0
    local seed="" tgt="${TARGET:-}"
    # The static-musl edge build sets TARGET=linux-x86_64-musl. The frozen native
    # .s seeds are ELF-object/x86_64-ABI artifacts shared by glibc and musl (same
    # SysV ABI, same ELF format), so map the `-musl` variant onto its base target
    # here — otherwise the case below falls through to the no-seed `#else` path
    # and the dropped C arena/element bodies leave rt_*_native undefined at link.
    tgt="${tgt%-musl}"; tgt="${tgt%-cuda}"   # -cuda variant shares the linux-x86_64 ELF/SysV rt-seeds
    [ -z "$tgt" ] && case "$(uname -sm 2>/dev/null)" in
        "Darwin arm64") tgt="darwin-arm64" ;;
        "Linux x86_64") tgt="linux-x86_64" ;;
        "Linux aarch64"|"Linux arm64") tgt="linux-arm64" ;;
    esac
    # linux-arm64 native arm64 arena: RUN-PROVEN (measure-8 r1, 2026-06-19). The
    # v0.241.0/.1 arm64 SIGSEGV (#3597) root-caused to the arm64-linux arena seed
    # carrying the Darwin/XNU syscall ABI (svc #0x80 + x16 + target_os=darwin) and
    # x86_64 syscall NUMBERS — mmap mis-syscalled → bad arena base → stage-0 hexa_v2
    # SIGSEGV in hxlcl_memcpy <- hexa_struct_pack_map <- type_check. #3615 fixed the
    # arm64 codegen syscall ABI (svc #0 + x8 + target_os=0 + aarch64 numbers
    # mmap=222/munmap=215/exit_group=94) and regenerated the seed. measure-8 r1 then
    # ran the FULL tool/release_build on ubuntu-24.04-arm with the native arm64 arena
    # ON: Stage 0/1/2 + the exact #3597 site (`module_loader.hexa` transpile) PASSED
    # → `[release_build] PASS — ./hexa built (TARGET=linux-arm64)` (the narrow exit42
    # smoke of #3615 did not exercise that site; the full path now does). So
    # linux-arm64 joins x86_64 + darwin-arm64 in the uniform default-ON native-arena
    # regime (the array/map seed pattern). HEXA_RT_ALLOC_NATIVE_ARM64=0 reverts
    # linux-arm64 to the no-seed path; HEXA_RT_ALLOC_NATIVE=0 reverts all targets.
    if [ "$tgt" = "linux-arm64" ] && [ "${HEXA_RT_ALLOC_NATIVE_ARM64:-1}" = "0" ]; then
        echo "[stage_resolve_runtime_a] RT-NATIVE ALLOC-RB: linux-arm64 native arena seed disabled via HEXA_RT_ALLOC_NATIVE_ARM64=0 — no-seed path" >&2
        return 0
    fi
    case "$tgt" in
        darwin-arm64) seed="self/native/alloc_syscall_arm64.s" ;;
        linux-x86_64) seed="self/native/alloc_syscall_x86_64.s" ;;
        linux-arm64)  seed="self/native/alloc_syscall_arm64-linux.s" ;;
        *)            seed="" ;;
    esac
    [ -n "$seed" ] && [ -f "$seed" ] || return 0
    mkdir -p build
    local nsyms; nsyms="$(grep -cE '^[[:space:]]*\.globl' "$seed" 2>/dev/null || echo 0)"
    if [ "${nsyms:-0}" -lt 30 ]; then
        echo "[stage_resolve_runtime_a] RT-NATIVE ALLOC-RB: seed $seed exports only $nsyms — falling back to C arena" >&2
        return 0
    fi
    local s_tmp="build/alloc_syscall_seed.s"
    grep -vE '^// ' "$seed" > "$s_tmp" 2>/dev/null || cp "$seed" "$s_tmp"
    if $CC -c "$s_tmp" -o build/alloc_syscall_native.o 2>/dev/null; then
        echo "[stage_resolve_runtime_a] RT-NATIVE ALLOC-RB: assembled build/alloc_syscall_native.o from $seed (TARGET=$tgt, $nsyms syms) → native arena path"
    else
        echo "[stage_resolve_runtime_a] RT-NATIVE ALLOC-RB: WARN assemble of $seed failed — C arena" >&2
    fi
    rm -f "$s_tmp"
}

# ── CUDA-R1 (`-cuda` release variant · opt-IN HEXA_CUDA=1) — fold the CUDA
# runtime objects into runtime.a so a consumer `hexa build`/`run` program links
# cuBLAS-backed GEMM (anima #2386). This is the BUILD-time half of the opt-in
# CUDA path (the link-flag half is os_clang_ldflags' HEXA_CUDA branch). DEFAULT
# build NEVER sets HEXA_CUDA → this is a no-op there (self-host ≠ release: the
# CPU release tarball + the gen3≡gen4 byteeq fixpoint are untouched).
#
# Mirrors tool/build_cuda_runtime (the GPU-verified #3680 recipe) for the object
# build, but stops at producing the two relocatable objects + signalling the
# runtime.c compile flag — it does NOT run the GEMM verdict harness (that is the
# aiden GPU-verify authority; CI is GPU-less build-only).
#
#   runtime_cuda.o       nvcc -x cu -DHEXA_CUDA -rdc=true (relocatable device code)
#   runtime_cuda_dlink.o nvcc -dlink (device-link blob → resolved by -lcudadevrt)
#
# On success: build/runtime_cuda.o + build/runtime_cuda_dlink.o exist and
# HEXA_CUDA=1 stays set so build_runtime_a_from_source compiles runtime.c with
# -DHEXA_CUDA and ar's both objects in. NON-FATAL + NO-OP-SAFE: on a missing nvcc
# / missing emitter / compile failure it WARNS and unsets HEXA_CUDA so the build
# falls back to the CPU runtime.a (a `-cuda` job then ships a CPU asset — caught
# by the job's own post-build cuda_available probe, not a silent CPU ship).
resolve_cuda_runtime_seed() {
    [ "${HEXA_CUDA:-0}" = "1" ] || return 0   # opt-in only
    local SM="${SM:-120}"
    local CUDA_HOME_D="${CUDA_HOME:-/usr/local/cuda}"
    local CINC="$CUDA_HOME_D/targets/x86_64-linux/include"
    [ -d "$CINC" ] || CINC="$CUDA_HOME_D/include"
    export PATH="$CUDA_HOME_D/bin:$PATH"
    if ! command -v nvcc >/dev/null 2>&1; then
        echo "[stage_resolve_runtime_a] CUDA-R1: WARN no nvcc on PATH ($CUDA_HOME_D/bin) — unsetting HEXA_CUDA, CPU runtime.a" >&2
        unset HEXA_CUDA; return 0
    fi
    mkdir -p build
    # ── FROZEN-SEED FIRST (#3701 — stable -cuda asset never shipped) ──────────
    # runtime_cuda.c (+ runtime_bf16.c) are the DETERMINISTIC output of their
    # *_emit.hexa SSOTs (byte-eq re-emit verified) and are now CHECKED IN as
    # build seeds. The committed seed is the PRIMARY path: when it is present AND
    # has the canonical single _hx_dt_exp_dev def, use it as-is and SKIP the
    # runner emit. This is the root-cause fix for the chicken-egg / stale-prebuilt
    # trap: resolve_cuda_runtime_seed runs at Stage 0b — BEFORE build/hexat is
    # built (Stage 0a-pre) — so the only emit-runner is the prior STALE edge
    # binary, whose native-run fast-path can SIGSEGV before writing the 333KB file
    # → "runtime_cuda.c not emitted" → the -cuda nvcc fold is skipped → the whole
    # -cuda asset silently never ships (v0.245.x had NO hexa-*-cuda.tar.gz). A
    # committed seed removes the dependency on any runner at all. If the seed is
    # absent or regressed (e.g. someone edited the emitter without regenerating),
    # fall back to the runner-emit path below so a fresh emit still works locally.
    local _cuda_ndef
    _cuda_ndef="$(grep -c '_hx_dt_exp_dev(double x) {' self/cuda/runtime_cuda.c 2>/dev/null || true)"
    if [ -f self/cuda/runtime_cuda.c ] && [ "$_cuda_ndef" = "1" ]; then
        echo "[stage_resolve_runtime_a] CUDA-R1: using checked-in frozen seed self/cuda/runtime_cuda.c (no runner emit — stale-runner-immune, #3701)"
        # runtime_bf16.c rides along as a frozen seed too (committed); it has no
        # _hx_dt_exp_dev contract to assert, so presence is enough.
    else
        # Seed absent/regressed → emit from the *_emit.hexa SSOT via a hexa RUNNER.
        # The cuda emitter uses string-concat returns (NOT the `buf = buf + "…"`
        # line literals the runtime_core awk un-escaper handles) → a hexa RUNNER is
        # REQUIRED. At Stage 0b ./hexa / build/hexat do not exist, so resolve a
        # runner: PATH hexa(-run) for local dev, else the prior BASE edge
        # `hexa-linux-x86_64.tar.gz` binary (a CPU hexa runs the cuda emitter fine —
        # it just prints C text). The cuda edge asset is chicken-egg on the first
        # run, so we pull the base x86_64 edge, not EDGE_ASSET.
        echo "[stage_resolve_runtime_a] CUDA-R1: frozen seed absent/regressed (ndef='$_cuda_ndef') — emitting from *_emit.hexa SSOT via runner" >&2
        local RUNNER=""
        if command -v hexa-run >/dev/null 2>&1; then RUNNER="hexa-run"
        elif command -v hexa >/dev/null 2>&1; then RUNNER="hexa run"
        elif [ -x build/hexat ]; then RUNNER="build/hexat run"
        else
            local _edge_dir="/tmp/edge_cuda_runner"
            rm -rf "$_edge_dir"; mkdir -p "$_edge_dir"
            if gh release download edge --repo "${GITHUB_REPOSITORY:-dancinlab/hexa-lang}" \
                  --pattern "hexa-linux-x86_64.tar.gz" --dir "$_edge_dir" --clobber 2>/tmp/cuda_dl.err \
               && tar xzf "$_edge_dir/hexa-linux-x86_64.tar.gz" -C "$_edge_dir" 2>/dev/null; then
                local _edge_hexa
                _edge_hexa="$(find "$_edge_dir" -name hexa -type f 2>/dev/null | head -1)"
                if [ -n "$_edge_hexa" ]; then chmod +x "$_edge_hexa" 2>/dev/null || true; RUNNER="$_edge_hexa run"; fi
            fi
        fi
        if [ -z "$RUNNER" ]; then
            echo "[stage_resolve_runtime_a] CUDA-R1: WARN no hexa runner to emit runtime_cuda.c (and no frozen seed) — unsetting HEXA_CUDA, CPU runtime.a" >&2
            unset HEXA_CUDA; return 0
        fi
        HEXA_LANG="$ROOT" $RUNNER self/cuda/runtime_bf16_emit.hexa self/cuda/runtime_bf16.c >/dev/null 2>&1 || true
        HEXA_LANG="$ROOT" $RUNNER self/cuda/runtime_cuda_emit.hexa self/cuda/runtime_cuda.c >/dev/null 2>&1 || true
    fi
    if [ ! -f self/cuda/runtime_cuda.c ]; then
        echo "[stage_resolve_runtime_a] CUDA-R1: WARN runtime_cuda.c absent (no frozen seed + runner failed?) — unsetting HEXA_CUDA, CPU runtime.a" >&2
        unset HEXA_CUDA; return 0
    fi
    local ndef; ndef="$(grep -c '_hx_dt_exp_dev(double x) {' self/cuda/runtime_cuda.c || true)"
    if [ "$ndef" != "1" ]; then
        echo "[stage_resolve_runtime_a] CUDA-R1: WARN runtime_cuda.c has $ndef _hx_dt_exp_dev defs (expected 1) — emitter dup-def regressed; unsetting HEXA_CUDA" >&2
        unset HEXA_CUDA; return 0
    fi
    # nvcc relocatable device code + device-link (mirrors build_cuda_runtime).
    # ING-35 #3 — CUDA-13 nvcc compiles -x cu (CUDA C++) of runtime_cuda.c and, by
    # default, emits libstdc++ host symbols: __cxa_guard_{acquire,release,abort}
    # (function-local-static guards) + __gxx_personality_v0/_Unwind_Resume (EH).
    # The consumer `hexa` binary is C-LINKED (gcc/cc, no libstdc++), so those land
    # as `undefined reference to '__cxa_guard_acquire'` at the final link (anima ING
    # #35 cause-3). -Xcompiler -fno-threadsafe-statics drops the guard symbols
    # (single-threaded static init is fine for these constants) and -fno-exceptions
    # drops the EH personality — both are host-codegen-only, device code unchanged.
    if nvcc -x cu -DHEXA_CUDA -rdc=true -gencode arch=compute_$SM,code=sm_$SM -O2 -w \
            -Xcompiler -fno-threadsafe-statics -Xcompiler -fno-exceptions \
            -I "$CINC/cccl" -I "$CINC" -I self -I self/cuda -I . \
            -c self/cuda/runtime_cuda.c -o build/runtime_cuda.o \
       && nvcc -dlink -gencode arch=compute_$SM,code=sm_$SM build/runtime_cuda.o \
            -o build/runtime_cuda_dlink.o -lcudadevrt; then
        echo "[stage_resolve_runtime_a] CUDA-R1: built build/runtime_cuda.o + runtime_cuda_dlink.o (sm_$SM) → folding into runtime.a (-DHEXA_CUDA)"
    else
        echo "[stage_resolve_runtime_a] CUDA-R1: WARN nvcc compile/dlink failed — unsetting HEXA_CUDA, CPU runtime.a" >&2
        unset HEXA_CUDA; rm -f build/runtime_cuda.o build/runtime_cuda_dlink.o; return 0
    fi
}

build_runtime_a_from_source() {
    regen_runtime_core_from_emitter
    # RT-NATIVE Z2a (gated): supply rt_str_* from a NATIVE-compiled object
    # (build/rt_hi_native.o, assembled from the self/native/runtime_hi_*.s
    # frozen seed by resolve_native_rt_hi_seed) instead of the hexat-transpiled
    # runtime_hi_gen.c #include — so runtime_hi_gen.c is never needed. Default
    # path unchanged.
    local extra_obj=""
    if [ "${HEXA_ZEROC_RT_HI:-0}" = "1" ] && [ -f build/rt_hi_native.o ]; then
        sed -i.zbak 's|#include "runtime_hi_gen.c"|/* RT-NATIVE Z2a: rt_str_* from native build/rt_hi_native.o */|' self/runtime_core.c
        rm -f self/runtime_core.c.zbak
        extra_obj="build/rt_hi_native.o"
        echo "[stage_resolve_runtime_a] RT-NATIVE Z2a: runtime_hi_gen.c #include removed; ar'ing native rt_hi_native.o into runtime.a"
    fi
    # RT-NATIVE ARRAY-R4 (gated): when the array_core seed is active, define
    # HEXA_RT_ARRAY_NATIVE for the runtime.c compile (so hexa_array_get/set take
    # the native arm) and ar build/array_core_native.o into runtime.a so its
    # rt_array_*_native symbols resolve. The C #else element bodies stay in
    # runtime_core.c as the no-seed fallback (dead on seed targets).
    local rt_array_def=""
    if [ "${HEXA_RT_ARRAY_NATIVE:-0}" = "1" ] && [ -f build/array_core_native.o ]; then
        rt_array_def="-DHEXA_RT_ARRAY_NATIVE=1"
        extra_obj="$extra_obj build/array_core_native.o"
        echo "[stage_resolve_runtime_a] RT-NATIVE ARRAY-R4: HEXA_RT_ARRAY_NATIVE=1; ar'ing native array_core_native.o into runtime.a"
    fi
    local rt_map_def=""
    if [ "${HEXA_RT_MAP_NATIVE:-0}" = "1" ] && [ -f build/map_core_native.o ]; then
        rt_map_def="-DHEXA_RT_MAP_NATIVE=1"
        extra_obj="$extra_obj build/map_core_native.o"
        echo "[stage_resolve_runtime_a] RT-NATIVE MAP-R3: HEXA_RT_MAP_NATIVE=1; ar'ing native map_core_native.o into runtime.a"
    fi
    local rt_intern_def=""
    if [ "${HEXA_RT_INTERN_NATIVE:-0}" = "1" ] && [ -f build/intern_core_native.o ]; then
        rt_intern_def="-DHEXA_RT_INTERN_NATIVE=1"
        extra_obj="$extra_obj build/intern_core_native.o"
        echo "[stage_resolve_runtime_a] RT-NATIVE INTERN-R1: HEXA_RT_INTERN_NATIVE=1; ar'ing native intern_core_native.o into runtime.a"
    fi
    # RT-NATIVE FS-R1 (gated): when the fs_core seed is active, define
    # HEXA_RT_FS_NATIVE for the runtime.c compile (so rt_write_bytes /
    # rt_write_bytes_append take the native syscall arm) and ar
    # build/fs_core_native.o into runtime.a so its fs_*_all_native symbols
    # resolve. The C fopen/fwrite write bodies stay in runtime_core.c as the
    # no-seed `#else` fallback (#3583 — never drop the fallback; dead on seed targets).
    local rt_fs_def=""
    if [ "${HEXA_RT_FS_NATIVE:-0}" = "1" ] && [ -f build/fs_core_native.o ]; then
        rt_fs_def="-DHEXA_RT_FS_NATIVE=1"
        extra_obj="$extra_obj build/fs_core_native.o"
        echo "[stage_resolve_runtime_a] RT-NATIVE FS-R1: HEXA_RT_FS_NATIVE=1; ar'ing native fs_core_native.o into runtime.a"
    fi
    # RT-NATIVE STR (sh-construct-str + sh-str-scan lanes, gated): when the
    # str_core seed is active, define HEXA_RT_STR_EQ_NATIVE +
    # HEXA_RT_STR_STARTS_WITH_NATIVE + HEXA_RT_STR_ENDS_WITH_NATIVE for the
    # runtime.c compile (so hexa_str_eq's / rt_str_starts_with's / rt_str_ends_with's
    # distinct-pointer compares take the native arms) and ar build/str_core_native.o
    # (which carries ALL THREE rt_str_eq_native + rt_str_starts_with_native +
    # rt_str_ends_with_native) into runtime.a ONCE. The C strcmp/strncmp `#else`
    # bodies stay in runtime_core.c as the no-seed fallback.
    local rt_str_def="" rt_str_seeded=0
    if [ "${HEXA_RT_STR_EQ_NATIVE:-0}" = "1" ] && [ -f build/str_core_native.o ]; then
        rt_str_def="$rt_str_def -DHEXA_RT_STR_EQ_NATIVE=1"; rt_str_seeded=1
    fi
    if [ "${HEXA_RT_STR_STARTS_WITH_NATIVE:-0}" = "1" ] && [ -f build/str_core_native.o ]; then
        rt_str_def="$rt_str_def -DHEXA_RT_STR_STARTS_WITH_NATIVE=1"; rt_str_seeded=1
    fi
    if [ "${HEXA_RT_STR_ENDS_WITH_NATIVE:-0}" = "1" ] && [ -f build/str_core_native.o ]; then
        rt_str_def="$rt_str_def -DHEXA_RT_STR_ENDS_WITH_NATIVE=1"; rt_str_seeded=1
    fi
    if [ "$rt_str_seeded" = "1" ]; then
        extra_obj="$extra_obj build/str_core_native.o"
        echo "[stage_resolve_runtime_a] RT-NATIVE STR: defs [$rt_str_def]; ar'ing native str_core_native.o into runtime.a"
    fi
    # RT-NATIVE NUM (sh-num-native lane, gated): when the num_core seed is active,
    # define HEXA_RT_NUM_PARSE_INT_NATIVE for the runtime.c compile (so hexa_as_num's
    # string→int path takes the native arm) and ar build/num_core_native.o into
    # runtime.a so rt_parse_int_native resolves. The C strtoll `#else` stays in
    # runtime_core.c as the no-seed fallback.
    local rt_num_def=""
    if [ "${HEXA_RT_NUM_PARSE_INT_NATIVE:-0}" = "1" ] && [ -f build/num_core_native.o ]; then
        rt_num_def="-DHEXA_RT_NUM_PARSE_INT_NATIVE=1"
        extra_obj="$extra_obj build/num_core_native.o"
        echo "[stage_resolve_runtime_a] RT-NATIVE NUM: HEXA_RT_NUM_PARSE_INT_NATIVE=1; ar'ing native num_core_native.o into runtime.a"
    fi
    # RT-NATIVE VALOP (sh-val-core lane, gated): when the valop_core seed is active,
    # define HEXA_RT_VALOP_NATIVE for the runtime.c compile (so hexa_truthy/sub/mul/add
    # take the native scalar arm) and ar build/valop_core_native.o into runtime.a so
    # rt_truthy_native/rt_sub_native/rt_mul_native/rt_add_native resolve. The C scalar
    # bodies stay in runtime_core.c as the no-seed fallback.
    local rt_valop_def=""
    if [ "${HEXA_RT_VALOP_NATIVE:-0}" = "1" ] && [ -f build/valop_core_native.o ]; then
        rt_valop_def="-DHEXA_RT_VALOP_NATIVE=1"
        extra_obj="$extra_obj build/valop_core_native.o"
        echo "[stage_resolve_runtime_a] RT-NATIVE VALOP: HEXA_RT_VALOP_NATIVE=1; ar'ing native valop_core_native.o into runtime.a"
    fi
    # RT-NATIVE NUM-FLOAT (sh-num-float lane, gated): when the num_float_core seed
