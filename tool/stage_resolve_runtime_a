#!/usr/bin/env bash
# tool/stage_resolve_runtime_a — resolve build/runtime.a (the "frozen dough").
#
# Replaces the old Stage 0-pre "warm-regen seed .c" step, which was the REAL
# Phase-3 break (run 26604873545): it ran `hexa run <orchestrator>` which tried
# to BUILD build/hexat -> `clang self/runtime.c` -> with runtime.c removed,
# `no such file: ./self/runtime.c` -> regen failed -> its fallback
# `git checkout -- self/runtime*.c self/native/*.c` restored NOTHING (the files
# were committed-removed) -> Stage-0 cascade-failed on all 3 platforms.
#
# The robust strategy is the prebuilt "frozen dough" (rustc/gcc stage0 pattern),
# NOT seed regeneration:
#
#   SEEDS PRESENT (today, additive no-op): compile build/runtime.a from the
#     in-tree self/runtime.c (+ its #include seeds) with the SAME CFLAGS.
#
#   SEEDS REMOVED (today, post-graduation): self/runtime.c is gone. Try the
#     prior edge tarball's bundled build/runtime.a (release.yml Package ships
#     it) first. If that edge asset is MISSING for this platform (P7 edge-seed
#     chicken-egg — `edge` ships only hexa-linux-arm64.tar.gz, so x86_64/darwin
#     have no seed), FALL BACK to restoring the frozen bootstrap seeds from the
#     authoritative pre-graduation git blob (tool/restore_frozen_seeds, pinned
#     7906951c0^) and building runtime.a from source — the SAME compile the
#     seeds-present branch runs. The restored seeds are working-tree-only
#     (never committed); the .hexa-only graduated git state is preserved.
#
# On success it leaves build/runtime.a in place and prints the resolved path.
# Callers then export HEXA_PREBUILT_RUNTIME=build/runtime.a so stage_build_hexa
# links it. FALLBACK: when seeds ARE present we always rebuild from source, so
# the prebuilt and source paths are byte-equivalent and either is safe.
#
# Env: CC (clang|gcc) · LIBS · CFLAGS_COMMON · EDGE_ASSET (per-platform tarball
# name, only needed in the seeds-removed branch) · GH_TOKEN (gh download).
set -uo pipefail

CC="${CC:?CC must be set}"
CFLAGS="${CFLAGS_COMMON:--O2 -std=gnu11 -D_GNU_SOURCE -Wno-trigraphs}"
ROOT="$PWD"
RA="$ROOT/build/runtime.a"
mkdir -p build

# ── B9.C-10/F3 (CI parity with the LOCAL build) — regen self/runtime_core.c from
# its emitter SSOT (self/runtime_core_emit.hexa) BEFORE compiling runtime.a.
#
# THE BUG THIS CLOSES (exec pipe-EOF leak fix never reached binaries): the
# bootstrap seed restored here (frozen blob 151c52c82, pinned PRE-graduation) is
# a STALE self/runtime_core.c — it predates the merged exec()/exec_stream leak
# fix (#2350/#2351), whose ONLY source edit is self/runtime_core_emit.hexa. The
# amalgam self/runtime.c `#include`s runtime_core.c (line ~2149), so compiling
# the frozen .c bakes the OLD drain into runtime.a → into the release/edge
# binary. CI never ran the emitter; only the LOCAL build (build_hexa_cli.hexa
# `_regen_runtime_core`, Step 0-pre) did → only local binaries carried the fix.
#
# This mirrors that local Step 0-pre on the CI path: run the emitter with an
# available hexa runner and overwrite runtime_core.c with the freshly-emitted
# SSOT output BEFORE the compile below. The runner can be the prior edge `hexa`
# binary — the emitter is plain hexa source that prints C text, so a STALE
# runner still emits the CURRENT (fixed) runtime_core.c (verified: a fix-less
# edge binary regenerates a runtime_core.c carrying HEXA_EXEC_DRAIN_GRACE_MS).
#
# STRICTLY-OPTIONAL + NO-OP-SAFE, matching _regen_runtime_core's contract:
#   · emitter absent  → keep the in-tree .c (no change).
#   · no hexa runner  → keep the in-tree .c (no change).
#   · emitter fails   → keep the in-tree .c (warn, non-fatal).
# On a SHA-identical regen the runtime.c TU is byte-unchanged (PERF UNCHANGED).

# Deterministic, hexat-FREE un-escaper for a *_emit.hexa SSOT → its emitted .c.
# The emitter bodies are pure `    buf = buf + "<C-line>"` literals whose un-escaped
# (\n \t \" \\) content IS the .c text VERBATIM. Used as the PRIMARY regen path so
# the SSOT regen no longer depends on a working hexa runner / native hexat (both
# FLAKY: the local runner aborts with a dyld _real_args fault, and the seeds-removed
# CI host can't exec the committed hexat seed). Prints to stdout. Returns 3 if the
# emitter has no recognizable buf-literal lines (caller then falls back to a runner).
_unescape_emit_to_c() {
    awk '
      BEGIN { saw = 0 }
      {
        line = $0
        pfx = "    buf = buf + \""
        if (substr(line, 1, length(pfx)) != pfx) next
        body = substr(line, length(pfx) + 1)
        if (substr(body, length(body), 1) != "\"") next
        body = substr(body, 1, length(body) - 1)
        saw = 1
        out = ""; n = length(body); i = 1
        while (i <= n) {
          c = substr(body, i, 1)
          if (c == "\\" && i < n) {
            d = substr(body, i+1, 1)
            if (d == "n")  { out = out "\n"; i += 2; continue }
            if (d == "t")  { out = out "\t"; i += 2; continue }
            if (d == "\"") { out = out "\""; i += 2; continue }
            if (d == "\\") { out = out "\\"; i += 2; continue }
            out = out "\\"; i += 1; continue
          }
          out = out c; i += 1
        }
        printf "%s", out
      }
      END { if (!saw) exit 3 }
    ' "$1"
}

regen_runtime_core_from_emitter() {
    local emitter="self/runtime_core_emit.hexa"
    local dst="self/runtime_core.c"
    [ -f "$emitter" ] || { echo "[stage_resolve_runtime_a] runtime_core.c regen SKIP — emitter absent"; return 0; }

    # PRIMARY (deterministic, hexat-FREE): un-escape the committed emitter SSOT.
    # RT-NATIVE leg B Z2a: the casefold/trim C #ifndef bodies are RETIRED from
    # runtime_core_emit.hexa (the 9-fn gen.c is the sole rt_str_to_upper/to_lower/
    # trim provider), so this regen MUST run even when NO hexa runner is available —
    # else the FROZEN stale runtime_core.c (which still carries those 3 C bodies) +
    # the 9-fn gen.c → "redefinition of rt_str_*". The awk un-escape reproduces the
    # emitter's own .c output byte-for-byte and needs NO runner, so it is immune to
    # the FLAKY local-runner dyld fault / seeds-removed hexat-exec failure that left
    # 3 prior CI cycles oscillating between undefined↔duplicate.
    local atmp
    atmp="$(mktemp -t regen_runtime_core_awk.XXXXXX)" || atmp=""
    if [ -n "$atmp" ] && _unescape_emit_to_c "$emitter" > "$atmp" 2>/dev/null \
       && [ -s "$atmp" ] && grep -q 'HexaVal hexa_str_join' "$atmp"; then
        cp -f "$atmp" "$dst"
        rm -f "$atmp"
        echo "[stage_resolve_runtime_a] runtime_core.c SYNTHESIZED from emitter SSOT (awk un-escape, $(wc -l < "$dst") lines, hexat-free)"
        reconcile_runtime_c_ssot_dups
        return 0
    fi
    rm -f "$atmp"

    # FALLBACK: the interp .c-text emitter via an edge/external hexa runner.
    # Resolve a hexa runner that can `run` a .hexa file end-to-end.
    #   1. an external hexa-run / hexa on PATH (local dev parity), else
    #   2. the prior edge `hexa` binary (CI: same asset stage_regen_hexa_cc uses).
    local runner=""
    if command -v hexa-run >/dev/null 2>&1; then
        runner="hexa-run"
    elif command -v hexa >/dev/null 2>&1; then
        runner="hexa run"
    else
        local asset="${EDGE_ASSET:-}"
        if [ -n "$asset" ]; then
            local edge_dir="/tmp/edge_rc_runner"
            rm -rf "$edge_dir"; mkdir -p "$edge_dir"
            if gh release download edge --repo "${GITHUB_REPOSITORY:-dancinlab/hexa-lang}" \
                  --pattern "$asset" --dir "$edge_dir" --clobber 2>/tmp/rc_dl.err \
               && tar xzf "$edge_dir/$asset" -C "$edge_dir" 2>/dev/null; then
                local edge_hexa
                edge_hexa="$(find "$edge_dir" -name hexa -type f -perm -u+x 2>/dev/null | head -1)"
                [ -z "$edge_hexa" ] && edge_hexa="$(find "$edge_dir" -name hexa -type f 2>/dev/null | head -1)"
                if [ -n "$edge_hexa" ]; then chmod +x "$edge_hexa" 2>/dev/null || true; runner="$edge_hexa run"; fi
            fi
        fi
    fi
    if [ -z "$runner" ]; then
        echo "[stage_resolve_runtime_a] runtime_core.c regen SKIP — no hexa runner (in-tree .c used)"
        return 0
    fi

    local tmp
    tmp="$(mktemp -t regen_runtime_core_c.XXXXXX)" || { echo "[stage_resolve_runtime_a] mktemp failed — regen skipped" >&2; return 0; }
    # HEXA_LANG must point at this checkout so the emitter resolves its imports.
    if HEXA_LANG="$ROOT" $runner "$emitter" "$tmp" >/tmp/rc_emit.log 2>&1 && [ -s "$tmp" ]; then
        cp -f "$tmp" "$dst"
        echo "[stage_resolve_runtime_a] runtime_core.c REGENERATED from emitter SSOT ($(wc -l < "$dst") lines)"
        reconcile_runtime_c_ssot_dups
    else
        echo "[stage_resolve_runtime_a] warn: emitter failed ($(tail -1 /tmp/rc_emit.log 2>/dev/null)) — in-tree .c used" >&2
    fi
    rm -f "$tmp"
}

# SSOT-migration reconciliation: pairs the FROZEN runtime.c with the CURRENT
# emitter-regenerated runtime_core.c. The frozen runtime.c (151c52c82, pre-
# graduation) still carries weak C bodies for the four f64<->bits reinterpret
# primitives; those symbols were MIGRATED into the runtime_core.c SSOT emitter at
# #2185 (it now emits the canonical NON-weak bodies). Once we regen runtime_core.c
# from the current emitter, the frozen runtime.c's stale duplicates collide
# ("redefinition of 'hexa_float_to_bits'") because runtime.c `#include`s
# runtime_core.c into one TU. CI never hit this only because it copied the
# prebuilt edge runtime.a and never recompiled — the same seam that froze the
# exec-leak fix out of binaries. Drop the four migrated single-line weak defs so
# the emitter's SSOT bodies are the sole definitions (same union-pun impl →
# behavior-preserving). No-op when runtime.c is current (defs already absent).
reconcile_runtime_c_ssot_dups() {
    [ -f self/runtime.c ] || return 0
    grep -q '__attribute__((weak)) HexaVal hexa_float_to_bits(HexaVal x) {' self/runtime.c || return 0
    local before after
    before=$(wc -l < self/runtime.c)
    sed -E -i.ssotbak \
      '/__attribute__\(\(weak\)\) HexaVal (hexa_float_to_bits|hexa_bits_to_float|float_to_bits|bits_to_float)\(HexaVal x\) \{/d' \
      self/runtime.c
    rm -f self/runtime.c.ssotbak
    after=$(wc -l < self/runtime.c)
    echo "[stage_resolve_runtime_a] SSOT reconcile: dropped $((before-after)) migrated f64<->bits defs from runtime.c (emitter owns them)"
}

# Shared source-compile of runtime.a from the in-tree self/runtime.c (+ its
# #include seed .c). Used by BOTH the seeds-present branch and the frozen-seed
# fallback so there is exactly ONE compile recipe (no drift). The runtime_core.c
# emitter-regen runs FIRST so the compiled .a carries the SSOT (not the stale
# frozen fragment) — see regen_runtime_core_from_emitter above.
# ── RT-NATIVE leg B Z2a — arch-aware native rt_hi seed → build/rt_hi_native.o ──
# Assemble build/rt_hi_native.o from the frozen native .s seed matching the
# build TARGET, and AUTO-ENABLE the native rt_str_* path (HEXA_ZEROC_RT_HI=1) so
# runtime_hi_gen.c is never #included on that platform. Runs BEFORE
# restore_frozen_seeds (which reads HEXA_ZEROC_RT_HI to skip gen.c synthesis) and
# BEFORE build_runtime_a_from_source (which ar's the .o). The seed is a frozen
# bootstrap artifact (like self/runtime.c) so this needs no native compiler here.
#   arm64-darwin → self/native/runtime_hi_native.s  (Mach-O, _rt_str_* underscore)
#   x86_64-linux → self/native/runtime_hi_x86_64.s  (ELF, rt_str_* no underscore)
#   linux-arm64  → no seed yet → stays on the C (awk-synth gen.c) path.
# Idempotent · NO-OP-SAFE: if the seed is absent or assembly fails, leaves
# HEXA_ZEROC_RT_HI untouched so the legacy C path takes over. Override by
# pre-setting HEXA_ZEROC_RT_HI=0 to force the C path even when a seed exists.
resolve_native_rt_hi_seed() {
    [ "${HEXA_ZEROC_RT_HI:-x}" = "0" ] && return 0   # explicit opt-out
    [ -f build/rt_hi_native.o ] && { export HEXA_ZEROC_RT_HI=1; return 0; }
    local seed="" tgt="${TARGET:-}"
    [ -z "$tgt" ] && case "$(uname -sm 2>/dev/null)" in
        "Darwin arm64") tgt="darwin-arm64" ;;
        "Linux x86_64") tgt="linux-x86_64" ;;
        "Linux aarch64"|"Linux arm64") tgt="linux-arm64" ;;
    esac
    case "$tgt" in
        darwin-arm64) seed="self/native/runtime_hi_native.s" ;;
        linux-x86_64) seed="self/native/runtime_hi_x86_64.s" ;;
        *)            seed="" ;;   # linux-arm64 + unknown → C path
    esac
    [ -n "$seed" ] && [ -f "$seed" ] || return 0
    mkdir -p build
    # Strip the leading `// ` header comment block (asm comment syntax differs by
    # target: `;` Mach-O / `#` ELF — both reject `//`), then assemble with $CC.
    # The temp MUST end in `.s` so $CC treats it as assembly — a fixed build/
    # path guarantees that (mktemp's `XXXXXX.s` template is unportable: macOS
    # appends the random suffix AFTER the `.s`, breaking the extension).
    # SAFETY: only adopt the native path if the seed actually exports ALL 14
    # rt_str_* the SSOT runtime_core.c expects — a stale/partial seed (e.g.
    # pre-search-predicate, 11 fn) would otherwise yield `undefined reference` at
    # the app link. Counted from the seed's `.globl` directives (toolchain-free,
    # no nm dependency). On a shortfall, skip the native path → legacy C gen.c.
    local nsyms; nsyms="$(grep -cE '^\.globl[[:space:]]+_?rt_str_' "$seed" 2>/dev/null || echo 0)"
    if [ "${nsyms:-0}" -lt 14 ]; then
        echo "[stage_resolve_runtime_a] RT-NATIVE Z2a: seed $seed exports only $nsyms/14 rt_str_* — falling back to C gen.c path" >&2
        return 0
    fi
    local s_tmp="build/rt_hi_seed.s"
    grep -vE '^// ' "$seed" > "$s_tmp" 2>/dev/null || cp "$seed" "$s_tmp"
    if $CC -c "$s_tmp" -o build/rt_hi_native.o 2>/dev/null; then
        export HEXA_ZEROC_RT_HI=1
        echo "[stage_resolve_runtime_a] RT-NATIVE Z2a: assembled build/rt_hi_native.o from $seed (TARGET=$tgt, $nsyms rt_str_* syms) → native rt_str_* path"
    else
        echo "[stage_resolve_runtime_a] RT-NATIVE Z2a: WARN assemble of $seed failed — falling back to C gen.c path" >&2
    fi
    rm -f "$s_tmp"
}

# ── RT-NATIVE leg B M4 ARRAY-R4 — array-core READ-half native seed → build/array_core_native.o ──
# The array twin of resolve_native_rt_hi_seed: assemble build/array_core_native.o
# from the arch-matched frozen self/native/array_core_*.s seed, and AUTO-ENABLE
# the native array element path (HEXA_RT_ARRAY_NATIVE=1) so hexa_array_get/set
# delegate to rt_array_get_native/set_native (raw-mem + __hx_make_val, gen2-only
# intrinsics the hexat C-transpile bootstrap cannot lower — hence a frozen .s
# seed, exactly like rt_str). All 3 production targets now carry a seed
# (darwin-arm64 + linux-x86_64 + linux-arm64, r4). On an unknown target or an
# assemble failure, HEXA_RT_ARRAY_NATIVE stays unset and the C element body in
# runtime_core.c ships unchanged (the no-seed fallback). Override by pre-setting
# HEXA_RT_ARRAY_NATIVE=0 to force the C path even when a seed exists.
resolve_native_array_core_seed() {
    [ "${HEXA_RT_ARRAY_NATIVE:-x}" = "0" ] && return 0   # explicit opt-out
    [ -f build/array_core_native.o ] && { export HEXA_RT_ARRAY_NATIVE=1; return 0; }
    local seed="" tgt="${TARGET:-}"
    [ -z "$tgt" ] && case "$(uname -sm 2>/dev/null)" in
        "Darwin arm64") tgt="darwin-arm64" ;;
        "Linux x86_64") tgt="linux-x86_64" ;;
        "Linux aarch64"|"Linux arm64") tgt="linux-arm64" ;;
    esac
    case "$tgt" in
        darwin-arm64) seed="self/native/array_core_arm64.s" ;;
        linux-x86_64) seed="self/native/array_core_x86_64.s" ;;
        linux-arm64)  seed="self/native/array_core_arm64-linux.s" ;;
        *)            seed="" ;;   # unknown → C #else path
    esac
    [ -n "$seed" ] && [ -f "$seed" ] || return 0
    mkdir -p build
    # SAFETY: only adopt the native path if the seed exports ALL 5 element fns
    # the runtime_core.c delegation expects — a stale/partial seed would yield an
    # `undefined reference` at the app link. Counted from `.globl` (toolchain-free).
    local nsyms; nsyms="$(grep -cE '^\.globl[[:space:]]+_?rt_array_(get|set|len|pop|shift)_native' "$seed" 2>/dev/null || echo 0)"
    if [ "${nsyms:-0}" -lt 5 ]; then
        echo "[stage_resolve_runtime_a] RT-NATIVE ARRAY-R4: seed $seed exports only $nsyms/5 rt_array_*_native — falling back to C #else path" >&2
        return 0
    fi
    local s_tmp="build/array_core_seed.s"
    grep -vE '^// ' "$seed" > "$s_tmp" 2>/dev/null || cp "$seed" "$s_tmp"
    if $CC -c "$s_tmp" -o build/array_core_native.o 2>/dev/null; then
        export HEXA_RT_ARRAY_NATIVE=1
        echo "[stage_resolve_runtime_a] RT-NATIVE ARRAY-R4: assembled build/array_core_native.o from $seed (TARGET=$tgt, $nsyms rt_array_*_native syms) → native array element path"
    else
        echo "[stage_resolve_runtime_a] RT-NATIVE ARRAY-R4: WARN assemble of $seed failed — falling back to C #else path" >&2
    fi
    rm -f "$s_tmp"
}

resolve_native_map_core_seed() {
    [ "${HEXA_RT_MAP_NATIVE:-x}" = "0" ] && return 0   # explicit opt-out
    [ -f build/map_core_native.o ] && { export HEXA_RT_MAP_NATIVE=1; return 0; }
    local seed="" tgt="${TARGET:-}"
    [ -z "$tgt" ] && case "$(uname -sm 2>/dev/null)" in
        "Darwin arm64") tgt="darwin-arm64" ;;
        "Linux x86_64") tgt="linux-x86_64" ;;
        "Linux aarch64"|"Linux arm64") tgt="linux-arm64" ;;
    esac
    case "$tgt" in
        darwin-arm64) seed="self/native/map_core_arm64.s" ;;
        linux-x86_64) seed="self/native/map_core_x86_64.s" ;;
        linux-arm64)  seed="self/native/map_core_arm64-linux.s" ;;
        *)            seed="" ;;   # unknown → C #else path
    esac
    [ -n "$seed" ] && [ -f "$seed" ] || return 0
    mkdir -p build
    # SAFETY: only adopt the native path if the seed exports ALL 4 probe fns
    # the runtime_core.c delegation expects — a stale/partial seed would yield an
    # `undefined reference` at the app link. Counted from `.globl` (toolchain-free).
    local nsyms; nsyms="$(grep -cE '^\.globl[[:space:]]+_?rt_map_(get|fnv1a|strcmp0|contains)_native' "$seed" 2>/dev/null || echo 0)"
    if [ "${nsyms:-0}" -lt 5 ]; then
        echo "[stage_resolve_runtime_a] RT-NATIVE MAP-R3: seed $seed exports only $nsyms/5 rt_map_*_native — falling back to C #else path" >&2
        return 0
    fi
    local s_tmp="build/map_core_seed.s"
    grep -vE '^// ' "$seed" > "$s_tmp" 2>/dev/null || cp "$seed" "$s_tmp"
    if $CC -c "$s_tmp" -o build/map_core_native.o 2>/dev/null; then
        export HEXA_RT_MAP_NATIVE=1
        echo "[stage_resolve_runtime_a] RT-NATIVE MAP-R3: assembled build/map_core_native.o from $seed (TARGET=$tgt, $nsyms rt_map_*_native syms) → native map probe path"
    else
        echo "[stage_resolve_runtime_a] RT-NATIVE MAP-R3: WARN assemble of $seed failed — falling back to C #else path" >&2
    fi
    rm -f "$s_tmp"
}

build_runtime_a_from_source() {
    regen_runtime_core_from_emitter
    # RT-NATIVE Z2a (gated): supply rt_str_* from a NATIVE-compiled object
    # (build/rt_hi_native.o, assembled from the self/native/runtime_hi_*.s
    # frozen seed by resolve_native_rt_hi_seed) instead of the hexat-transpiled
    # runtime_hi_gen.c #include — so runtime_hi_gen.c is never needed. Default
    # path unchanged.
    local extra_obj=""
    if [ "${HEXA_ZEROC_RT_HI:-0}" = "1" ] && [ -f build/rt_hi_native.o ]; then
        sed -i.zbak 's|#include "runtime_hi_gen.c"|/* RT-NATIVE Z2a: rt_str_* from native build/rt_hi_native.o */|' self/runtime_core.c
        rm -f self/runtime_core.c.zbak
        extra_obj="build/rt_hi_native.o"
        echo "[stage_resolve_runtime_a] RT-NATIVE Z2a: runtime_hi_gen.c #include removed; ar'ing native rt_hi_native.o into runtime.a"
    fi
    # RT-NATIVE ARRAY-R4 (gated): when the array_core seed is active, define
    # HEXA_RT_ARRAY_NATIVE for the runtime.c compile (so hexa_array_get/set take
    # the native arm) and ar build/array_core_native.o into runtime.a so its
    # rt_array_*_native symbols resolve. The C #else element bodies stay in
    # runtime_core.c as the no-seed fallback (dead on seed targets).
    local rt_array_def=""
    if [ "${HEXA_RT_ARRAY_NATIVE:-0}" = "1" ] && [ -f build/array_core_native.o ]; then
        rt_array_def="-DHEXA_RT_ARRAY_NATIVE=1"
        extra_obj="$extra_obj build/array_core_native.o"
        echo "[stage_resolve_runtime_a] RT-NATIVE ARRAY-R4: HEXA_RT_ARRAY_NATIVE=1; ar'ing native array_core_native.o into runtime.a"
    fi
    local rt_map_def=""
    if [ "${HEXA_RT_MAP_NATIVE:-0}" = "1" ] && [ -f build/map_core_native.o ]; then
        rt_map_def="-DHEXA_RT_MAP_NATIVE=1"
        extra_obj="$extra_obj build/map_core_native.o"
        echo "[stage_resolve_runtime_a] RT-NATIVE MAP-R3: HEXA_RT_MAP_NATIVE=1; ar'ing native map_core_native.o into runtime.a"
    fi
    $CC $CFLAGS $rt_array_def $rt_map_def -I self -c self/runtime.c -o build/runtime.o
    ar rcs "$RA" build/runtime.o $extra_obj
    ls -la "$RA"
    echo "$RA"
}

# Assemble the arch-matched native rt_hi seed (sets HEXA_ZEROC_RT_HI=1 on the
# platforms that have one) BEFORE either branch — restore_frozen_seeds reads
# HEXA_ZEROC_RT_HI to decide whether to synthesize runtime_hi_gen.c at all.
resolve_native_rt_hi_seed
# RT-NATIVE ARRAY-R4: assemble the arch-matched native array_core seed (sets
# HEXA_RT_ARRAY_NATIVE=1 on all 3 production targets — darwin-arm64 + linux-x86_64
# + linux-arm64). Unknown targets keep the C element path.
resolve_native_array_core_seed
resolve_native_map_core_seed

if [ -f self/runtime.c ]; then
    echo "stage_resolve_runtime_a: seeds present — building runtime.a from source"
    build_runtime_a_from_source
    exit 0
fi

# ── Seeds removed (.c=0 checkout) — REBUILD from source, do NOT trust the edge .a.
#
# WHY NOT just `cp` the prior edge build/runtime.a (the old behavior)? Because the
# edge runtime.a is the "frozen dough": it was itself compiled from a STALE
# runtime_core.c and so it carries the OLD exec drain. Copying it forward
# perpetuates the leak in every release — exactly the bug this change closes. The
# prebuilt .a optimization froze a SOURCE fragment that the SSOT emitter has since
# moved past, with no recompile to pick the change up.
#
# Correct order of preference now:
#   1. Restore the frozen bootstrap seeds (self/runtime.c + fragments, pinned
#      7906951c0^) → regen runtime_core.c from its emitter SSOT → compile .a from
#      source. This is the SAME source recipe + emitter-regen as the seeds-present
#      branch, so the fix is baked in. Seeds are working-tree-only (never
#      committed) — the .hexa-only graduated git state is preserved.
#   2. ONLY IF frozen-seed restore is impossible (e.g. the pinned blob is
#      unreachable), fall back to the prior edge prebuilt runtime.a as a
#      last-resort bootstrap so the build can still proceed. This path keeps the
#      stale fragment, but it is now the exception, not the default.
ASSET="${EDGE_ASSET:?EDGE_ASSET must be set when seeds are removed}"
echo "stage_resolve_runtime_a: self/runtime.c ABSENT — restoring frozen seeds + regen runtime_core.c, then building from source"
if bash tool/restore_frozen_seeds && [ -f self/runtime.c ]; then
    build_runtime_a_from_source
    exit 0
fi

# Last-resort bootstrap: frozen-seed restore failed → pull the prior edge
# prebuilt runtime.a so the build can still complete (stale-fragment risk noted).
echo "stage_resolve_runtime_a: frozen-seed restore unavailable — falling back to prior edge prebuilt runtime.a" >&2
EDGE_DIR="/tmp/edge_ra"
mkdir -p "$EDGE_DIR"
if gh release download edge --repo "${GITHUB_REPOSITORY:-dancinlab/hexa-lang}" \
      --pattern "$ASSET" --dir "$EDGE_DIR" --clobber 2>/tmp/ra_dl.err \
   && tar xzf "$EDGE_DIR/$ASSET" -C "$EDGE_DIR" 2>/dev/null; then
    PRIOR_RA="$(find "$EDGE_DIR" -type f -name runtime.a | head -1)"
    if [ -n "$PRIOR_RA" ]; then
        cp "$PRIOR_RA" "$RA"
        ls -la "$RA"
        echo "$RA"
        exit 0
    fi
    echo "stage_resolve_runtime_a: prior edge tarball has no build/runtime.a" >&2
else
    echo "stage_resolve_runtime_a: edge download failed ($(head -1 /tmp/ra_dl.err 2>/dev/null))" >&2
fi

echo "stage_resolve_runtime_a: NO runtime.a available (no source, frozen-seed restore failed, no prior asset)" >&2
exit 1
