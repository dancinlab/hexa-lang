        $CC $CFLAGS -D_FORTIFY_SOURCE=0 $_zeroc_nobuiltin $rt_array_def $rt_array_arena_def $rt_map_def $rt_intern_def $rt_fs_def $rt_str_def $rt_num_def $rt_numf_def $rt_fmtf_def $rt_numf_exact_def $rt_strtod_tail_def $rt_regex_def $rt_valop_def $rt_alloc_def $rt_print_def $_zc_own_def -DHEXA_ZEROC_DROP_RTCORE_INCLUDE -DHEXA_ZEROC_DROP_RTCORE $_mo_rtcore_def $_rng_strcmp_def -I self -include self/runtime_core_sysheaders.h $_heap_def -c self/runtime_core.c -o build/runtime_core.o || { echo "[stage_resolve_runtime_a] RFC061 Case-B FATAL: runtime_core.o compile failed" >&2; return 1; }
        # (S4) hxlcl_shim.o — libc-delegate hxlcl_* sibling TU.
        # own-start #29 coherence: $_zc_own_def MUST flow here too — without it the
        # shim's hxlcl_atexit stays the glibc-atexit delegate (U atexit), and under
        # the -nostartfiles ship link that pulls libc_nonshared.a(atexit.oS) whose
        # __dso_handle (crtbegin) is absent → hexat/hexa link FATAL (measured aiden
        # release_build @ main a372449a: "hidden symbol __dso_handle isn't defined").
        # GATE-1 missed it because it ran the single-TU (non-MULTIOBJ) archive shape.
        echo "[stage_resolve_runtime_a] RFC061 Case-B [S4]: compile build/hxlcl_shim.o…"
        # zeroc #29 mem-leaf: $_zeroc_nobuiltin is MANDATORY here — the shim's default-native
        # hxlcl_memcpy/memset/memcmp bodies are C loops; without -fno-builtin-mem* clang's
        # loop-idiom pass rewrites them back into `call memcpy` (self-recursion). Mirrors the
        # S2/S3 runtime.o/runtime_core.o compiles (:3118/:3123) which already carry it.
        $CC -c -O2 $_mo_archflag -std=gnu11 -D_GNU_SOURCE $_zeroc_nobuiltin $_mo_shim_def $_zc_own_def self/runtime_core_hxlcl_shim.c -o build/hxlcl_shim.o || { echo "[stage_resolve_runtime_a] RFC061 Case-B FATAL: hxlcl_shim.o compile failed" >&2; return 1; }
        # (S5) MULTIDEF SAFETY GATE — `ld -r` partial relocatable merge of all
        #      members. `ld -r` leaves undefined externs unresolved (the program-
        #      supplied compiler-side symbols are EXPECTED to be absent here, same as
        #      the default ship archive) but reports DUPLICATE defs — the real ship-
        #      killer. multidef==0 is the gate; a shortfall → loud build FATAL (never
        #      a silent member-overlapping archive). The undef0 proof is the REAL
        #      consumer link (HEXA_PREBUILT_RUNTIME=runtime.a → stage_build_hexa →
        #      hexa build exit42/hello), captured in the validation step.
        echo "[stage_resolve_runtime_a] RFC061 Case-B [S5]: multidef safety gate (ld -r partial merge)…"
        local _mo_merge="build/_caseB_merge.o" _mo_multidef _mo_reg_t _mo_reg_u
        ld -r build/runtime.o build/runtime_core.o $_mo_hxlcl_members $extra_obj -o "$_mo_merge" 2>build/_caseB_ldr.err
        _mo_multidef=$(grep -ciE 'multiple definition|duplicate symbol' build/_caseB_ldr.err 2>/dev/null || echo 0)
        _mo_reg_t=$(nm build/runtime.o 2>/dev/null | grep -cE ' T _?_hexa_init_fn_shims$')
        _mo_reg_u=$(nm build/runtime_core.o 2>/dev/null | grep -cE ' U _?_hexa_init_fn_shims$')
        echo "[stage_resolve_runtime_a] RFC061 Case-B: ld -r multiple_definition=$_mo_multidef ; _hexa_init_fn_shims runtime.o=${_mo_reg_t}T runtime_core.o=${_mo_reg_u}U (§4a archive-internal)"
        if [ "${_mo_multidef:-1}" -ne 0 ]; then
            echo "[stage_resolve_runtime_a] RFC061 Case-B FATAL: multi-object archive has DUPLICATE symbol definitions (multidef=$_mo_multidef) — refusing to ship (would corrupt the consumer C link). See build/_caseB_ldr.err:" >&2
            grep -iE 'multiple definition|duplicate symbol' build/_caseB_ldr.err 2>/dev/null | sort -u | head -20 | sed 's/^/    /' >&2
            rm -f "$_mo_merge"; return 1
        fi
        # (S5.5) own-start nm-clean gate — MULTIOBJ-keyed (convergence OWN-START-GATE-VS-SHIP-ARCHIVE-
        # SHAPE-DRIFT #4399/#4408: the ship uses HEXA_RT_MULTIOBJ=1, so the gate MUST audit the ld -r
        # MULTIOBJ merge = the REAL ship shape, never a single-TU archive — GATE-1 missed the drift by
        # auditing single-TU). Under HEXA_ZEROC_OWN_START the own _start + own atexit (_hxlcl_atexit_
        # register #4409) + own environ (_hxlcl_environ ELF alias #4631) must FULLY resolve: 0 undefined
        # atexit/environ/__cxa_atexit AND a DEFINED __dso_handle (weak-hidden #4410). A hit = the flip
        # would link-die under -nostartfiles (the #4408 __dso_handle / #4489 no-_start class). Inert when
        # OWN_START unset ($_zc_own_def empty) → shim/archive byte-identical → byteeq-neutral.
        if [ -n "$_zc_own_def" ]; then
            _os_undef=$(nm -u "$_mo_merge" 2>/dev/null | awk '{print $NF}' | grep -xE '_?(atexit|environ|__cxa_atexit)' | tr '\n' ' ')
            _os_dso_u=$(nm "$_mo_merge" 2>/dev/null | grep -cE '^\s*U _?__dso_handle$')
            if [ -n "$_os_undef" ] || [ "${_os_dso_u:-0}" -ne 0 ]; then
                echo "[stage_resolve_runtime_a] RFC061 §M8 OWN-START nm-clean FATAL (MULTIOBJ ship shape): undefined own-start symbols in the ld -r merge =[${_os_undef}] __dso_handle_undef=${_os_dso_u} — the own-start flip would link-die under -nostartfiles. atexit/environ must be own (_hxlcl_atexit_register #4409 / _hxlcl_environ alias #4631); __dso_handle must be the weak-hidden def (#4410). Refusing to ship." >&2
                rm -f "$_mo_merge"; return 1
            fi
            echo "[stage_resolve_runtime_a] RFC061 §M8 OWN-START nm-clean GREEN: 0 undefined atexit/environ/__cxa_atexit + __dso_handle resolved in the MULTIOBJ ld -r merge (ship-shape drift sealed)"
        fi
        rm -f "$_mo_merge"
        # (S6) ar the multi-object archive into the SAME canonical build/runtime.a
        #      (NO new name → install.sh + main.hexa resolve_prebuilt_runtime +
        #      release.yml untouched; consumer `nm -g` drop-list already multi-obj aware).
        ar rcs "$RA" build/runtime.o build/runtime_core.o $_mo_hxlcl_members $extra_obj
        ls -la "$RA"
        # CUDA dual-archive parity (mirror the single-TU ING-35 #2 discipline).
        if [ "${HEXA_CUDA:-0}" = "1" ] && [ -f build/runtime_cuda.o ] && [ -f build/runtime_cuda_dlink.o ]; then
            local _mo_cuda_home="${CUDA_HOME:-/usr/local/cuda}"
            local _mo_cinc="$_mo_cuda_home/targets/x86_64-linux/include"
            [ -d "$_mo_cinc" ] || _mo_cinc="$_mo_cuda_home/include"
            echo "[stage_resolve_runtime_a] RFC061 Case-B CUDA: build SEPARATE build/runtime.cuda.a (include-drop multi-object + cuda objects)"
            $CC $CFLAGS -D_FORTIFY_SOURCE=0 $_zeroc_nobuiltin $rt_array_def $rt_array_arena_def $rt_map_def $rt_intern_def $rt_fs_def $rt_str_def $rt_num_def $rt_numf_def $rt_fmtf_def $rt_numf_exact_def $rt_strtod_tail_def $rt_regex_def $rt_valop_def $rt_alloc_def $rt_print_def $_zc_own_def -DHEXA_ZEROC_DROP_RTCORE_INCLUDE -DHEXA_ZEROC_DROP_RTCORE -DHEXA_CUDA -I "$_mo_cinc" -I self $_heap_def -c self/runtime.c -o build/runtime_cuda_host.o || { echo "[stage_resolve_runtime_a] RFC061 Case-B CUDA FATAL: runtime_cuda_host.o compile failed" >&2; return 1; }
            ar rcs build/runtime.cuda.a build/runtime_cuda_host.o build/runtime_core.o $_mo_hxlcl_members $extra_obj build/runtime_cuda.o build/runtime_cuda_dlink.o
            ls -la build/runtime.cuda.a
            local _mo_cseed _mo_cm
            for _mo_cseed in build/runtime_core.o $_mo_hxlcl_members $extra_obj; do
                _mo_cm="$(basename "$_mo_cseed")"
                if ! ar t build/runtime.cuda.a | grep -qx "$_mo_cm"; then
                    echo "[stage_resolve_runtime_a] RFC061 Case-B CUDA FATAL: build/runtime.cuda.a missing member '$_mo_cm' (ING-35 #2)" >&2
                    return 1
                fi
            done
            echo "[stage_resolve_runtime_a] RFC061 Case-B CUDA: runtime.cuda.a member parity OK"
        fi
        # zero-c #29 S1: FFI-dyn TU (dlopen/dlsym/host_ffi_*) compiled to .o but NOT ar'd
        # into canonical runtime.a — keeps runtime.a nm-UND dl*-free; program/driver links
        # pick up build/runtime_ffi_dyn.o. (state/zeroc-29-s1-ffi-floor-partition-spec)
        [ -f "$ROOT/self/runtime_ffi_dyn.c" ] && $CC $CFLAGS -D_FORTIFY_SOURCE=0 -I self -c "$ROOT/self/runtime_ffi_dyn.c" -o build/runtime_ffi_dyn.o
        echo "$RA"
        return 0
    fi
    $CC $CFLAGS -D_FORTIFY_SOURCE=0 $_zeroc_nobuiltin $rt_array_def $rt_array_arena_def $rt_map_def $rt_intern_def $rt_fs_def $rt_str_def $rt_num_def $rt_numf_def $rt_fmtf_def $rt_numf_exact_def $rt_strtod_tail_def $rt_regex_def $rt_valop_def $rt_alloc_def $rt_print_def $_zc_own_def -I self $_heap_def -c self/runtime.c -o build/runtime.o
    ar rcs "$RA" build/runtime.o $extra_obj
    ls -la "$RA"
    if [ "${HEXA_CUDA:-0}" = "1" ] && [ -f build/runtime_cuda.o ] && [ -f build/runtime_cuda_dlink.o ]; then
        local _cuda_home="${CUDA_HOME:-/usr/local/cuda}"
        local _cinc="$_cuda_home/targets/x86_64-linux/include"
        [ -d "$_cinc" ] || _cinc="$_cuda_home/include"
        echo "[stage_resolve_runtime_a] CUDA-R1: building SEPARATE consumer archive build/runtime.cuda.a (runtime.c -DHEXA_CUDA -I$_cinc + runtime_cuda.o + runtime_cuda_dlink.o); toolchain keeps the CPU build/runtime.a (libcuda-free, GPU-less-host-runnable)"
        $CC $CFLAGS -D_FORTIFY_SOURCE=0 $_zeroc_nobuiltin $rt_array_def $rt_array_arena_def $rt_map_def $rt_intern_def $rt_fs_def $rt_str_def $rt_num_def $rt_numf_def $rt_fmtf_def $rt_numf_exact_def $rt_strtod_tail_def $rt_regex_def $rt_valop_def $rt_alloc_def $rt_print_def $_zc_own_def -DHEXA_CUDA -I "$_cinc" -I self $_heap_def -c self/runtime.c -o build/runtime_cuda_host.o
        ar rcs build/runtime.cuda.a build/runtime_cuda_host.o $extra_obj build/runtime_cuda.o build/runtime_cuda_dlink.o
        ls -la build/runtime.cuda.a
        # ING-35 #2 — fail loudly if the CUDA archive dropped a native-core seed the
        # CPU archive carries (e.g. array_core_native.o). The cuda + cpu archives MUST
        # share the same $extra_obj set; a member missing from runtime.cuda.a (but
        # present in runtime.a) ships an archive whose rt_array_*_native (etc.) symbols
        # go `undefined reference` at the consumer's C link (the anima ING #35 cause-2
        # — a stale/hand-assembled archive without array_core_native.o). This asserts
        # the canonical ar above can't silently regress to a missing-seed archive.
        for _seed in $extra_obj; do
            _m="$(basename "$_seed")"
            if ! ar t build/runtime.cuda.a | grep -qx "$_m"; then
                echo "[stage_resolve_runtime_a] CUDA-R1 FATAL: build/runtime.cuda.a missing native-core member '$_m' that build/runtime.a carries — consumer C link would hit undefined references (ING-35 #2)" >&2
                return 1
            fi
        done
        echo "[stage_resolve_runtime_a] CUDA-R1: runtime.cuda.a native-core parity OK ($(echo $extra_obj | wc -w) seed members present)"
    fi
    # zero-c #29 S1: FFI-dyn TU compiled to .o (not ar'd) — see Case-B note above.
    [ -f "$ROOT/self/runtime_ffi_dyn.c" ] && $CC $CFLAGS -D_FORTIFY_SOURCE=0 -I self -c "$ROOT/self/runtime_ffi_dyn.c" -o build/runtime_ffi_dyn.o
    echo "$RA"
}

# ── INSTALLED-RUNTIME-SYNC (#3806/#3807/#3841/#3850 follow-up — stale-.a relink) ──
# After $RA ($ROOT/build/runtime.a) is freshly finalized, mirror it into the
# ACTIVE INSTALLED link target $HOME/.hx/bin/build/runtime.a IF that path is the
# one a consumer `hexa build`/`run` + the smoke harnesses actually link.
#
# THE BUG THIS CLOSES (user-diagnosed): forge_dispatch_groupnorm_gelu (and the
# rest of the L3 fused-dispatch family) is ALREADY root-fixed in the SSOT
# (restore_frozen_seeds: `#if 1` + HEXA_FORGE_HOST_WEAK, two CI gates), so a
# runtime.a built HERE carries the symbol. The `undefined reference` recurs ONLY
# from a STALE pre-#3806 $HOME/.hx/bin/build/runtime.a: a standalone source
# rebuild (dev / aiden pool) writes the fresh archive to $ROOT/build/runtime.a,
# but the installed `hexa` shim (install.sh:276 — exports HEXA_PREBUILT_RUNTIME=
# $HX_BIN/build/runtime.a) and the consumer smoke scripts (build_no_cublas_smoke
# / build_bf16_own_smoke / build_cuda_runtime — PREBUILT_RT default
# $HOME/.hx/bin/build/runtime.a) keep linking the OLD installed copy → undefined
# ref. install.sh's own install_src path already cp's $HX_SRC→$HX_BIN; this makes
# a DIRECT stage_resolve_runtime_a invocation self-consistent too.
#
# byteeq-NEUTRAL: the .a CONTENTS are unchanged (same canonical ar above); only
# WHICH copy a consumer links changes. Does NOT touch the release bootstrap —
# stage_build_hexa consumes HEXA_PREBUILT_RUNTIME=build/runtime.a (the $ROOT
# copy), never this installed mirror.
#
# GUARDS (so it never clobbers an unrelated install or a CUDA asset, and never
# fires inside the release/CI staging pipeline):
#   · only when the installed target ALREADY EXISTS (never CREATE a new install —
#     a real install is owned by install.sh / a release tarball), AND
#   · only when $RA is a DIFFERENT file from the target (skip self-copy when
#     $ROOT already IS $HX_BIN, e.g. a $HOME/.hx-rooted rebuild), AND
#   · skip when TARGET is set (release/cross builds set it; they stage via
#     stage_precompile_package, not this mirror) — unless explicitly forced, AND
#   · skip when the install is a CUDA asset ($HX_HOME/.cuda-runtime marker) — its
#     cuBLAS runtime.a must not be overwritten with a CPU rebuild (ING #82), AND
#   · HEXA_NO_INSTALL_RT_SYNC=1 hard opt-out · HEXA_FORCE_INSTALL_RT_SYNC=1 forces
#     past the TARGET guard for a deliberate cross-rebuild refresh.
sync_runtime_a_to_installed_link() {
    [ "${HEXA_NO_INSTALL_RT_SYNC:-0}" = "1" ] && return 0
    local hx_home="${HX_HOME:-$HOME/.hx}"
    local installed="$hx_home/bin/build/runtime.a"
    # only mirror into an EXISTING active install target (never create one)
    [ -f "$installed" ] || return 0
    # release/cross builds set TARGET and stage separately — skip unless forced
    if [ -n "${TARGET:-}" ] && [ "${HEXA_FORCE_INSTALL_RT_SYNC:-0}" != "1" ]; then
        echo "[stage_resolve_runtime_a] installed-runtime-sync SKIP — TARGET=$TARGET set (release/cross build; staged via stage_precompile_package). HEXA_FORCE_INSTALL_RT_SYNC=1 to override."
        return 0
    fi
    # never clobber a cuBLAS (CUDA-asset) installed runtime.a with a CPU rebuild
    if [ -f "$hx_home/.cuda-runtime" ]; then
        echo "[stage_resolve_runtime_a] installed-runtime-sync SKIP — cuda-asset install ($hx_home/.cuda-runtime); its cuBLAS runtime.a is preserved (ING #82)."
        return 0
    fi
    # resolve both to canonical absolute paths so a self-copy (ROOT==HX_BIN) is a no-op
    local ra_abs inst_abs
    ra_abs="$(cd "$(dirname "$RA")" 2>/dev/null && pwd)/$(basename "$RA")" || ra_abs="$RA"
    inst_abs="$(cd "$(dirname "$installed")" 2>/dev/null && pwd)/$(basename "$installed")" || inst_abs="$installed"
    if [ "$ra_abs" = "$inst_abs" ]; then
        echo "[stage_resolve_runtime_a] installed-runtime-sync NO-OP — \$RA IS the installed link target ($inst_abs)."
        return 0
    fi
    # FRESHNESS ASSERTION (convergence marker): a stale installed .a can no longer
    # silently relink — log the forge-dispatch symbol presence in BOTH the fresh
    # source archive and (pre-sync) the installed copy, then cp, so a regression is
    # visible in the build log instead of surfacing as a downstream undefined ref.
    local sym="forge_dispatch_groupnorm_gelu"
    local fresh_has stale_has
    fresh_has="$( (ar t "$RA" >/dev/null 2>&1 && (nm "$RA" 2>/dev/null | grep -c " T _\{0,1\}$sym\$")) || echo "?" )"
    stale_has="$( (nm "$installed" 2>/dev/null | grep -c " T _\{0,1\}$sym\$") || echo "?" )"
    cp -f "$RA" "$installed" 2>/dev/null \
        && echo "[stage_resolve_runtime_a] installed-runtime-sync: mirrored fresh $RA → $installed (forge_dispatch_groupnorm_gelu defs: fresh=$fresh_has, prev-installed=$stale_has) — consumer hexa build/run + smoke now link the fresh archive" \
        || echo "[stage_resolve_runtime_a] installed-runtime-sync WARN: cp $RA → $installed failed (permission?) — consumer may still link a stale installed runtime.a" >&2
}

