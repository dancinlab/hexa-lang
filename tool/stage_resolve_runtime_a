# platforms that have one) BEFORE either branch — restore_frozen_seeds reads
# HEXA_ZEROC_RT_HI to decide whether to synthesize runtime_hi_gen.c at all.
resolve_native_rt_hi_seed
# RT-NATIVE ARRAY-R4: assemble the arch-matched native array_core seed (sets
# HEXA_RT_ARRAY_NATIVE=1 on all 3 production targets — darwin-arm64 + linux-x86_64
# + linux-arm64). Unknown targets keep the C element path.
resolve_native_array_core_seed
resolve_native_map_core_seed
# RT-NATIVE INTERN-R1: assemble the arch-matched native intern_core seed (sets
# HEXA_RT_INTERN_NATIVE=1 on all 3 production targets). Unknown targets / missing
# seed keep the C intern lookup loop.
resolve_native_intern_core_seed
# RT-NATIVE FS-R1: assemble the arch-matched native fs_core WRITE-half seed (sets
# HEXA_RT_FS_NATIVE=1 on all 3 production targets). Unknown targets keep the C
# fopen/fwrite write path (the retained `#else` fallback).
resolve_native_fs_core_seed
# RT-NATIVE STR (sh-construct-str lane): assemble the arch-matched native str_core
# seed (sets HEXA_RT_STR_EQ_NATIVE=1 on all 3 production targets). Unknown targets
# keep the C strcmp path.
resolve_native_str_core_seed
