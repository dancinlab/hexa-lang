    # HEXA_RT_FS_NATIVE for the runtime.c compile (so rt_write_bytes /
    # rt_write_bytes_append take the native syscall arm) and ar
    # build/fs_core_native.o into runtime.a so its fs_*_all_native symbols
    # resolve. The C fopen/fwrite write bodies stay in runtime_core.c as the
    # no-seed `#else` fallback (#3583 — never drop the fallback; dead on seed targets).
    local rt_fs_def=""
    if [ "${HEXA_RT_FS_NATIVE:-0}" = "1" ] && [ -f build/fs_core_native.o ]; then
        rt_fs_def="-DHEXA_RT_FS_NATIVE=1"
        extra_obj="$extra_obj build/fs_core_native.o"
