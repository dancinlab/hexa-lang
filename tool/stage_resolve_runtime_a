        echo "[stage_resolve_runtime_a] RT-NATIVE FLOAT-EXACT: HEXA_RT_NUM_PARSE_FLOAT_EXACT=1; ar'ing native float_parse_exact_native.o into runtime.a"
    fi
    # STRTOD-TAIL (sh-float-hexinfnan lane, opt-IN default-OFF): when the tail seed is
    # active (HEXA_RT_STRTOD_TAIL_NATIVE=1 set by resolve_native_float_parse_hexinfnan_seed
