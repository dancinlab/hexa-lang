    # runtime_core.c as the no-seed fallback.
    local rt_num_def=""
    if [ "${HEXA_RT_NUM_PARSE_INT_NATIVE:-0}" = "1" ] && [ -f build/num_core_native.o ]; then
        rt_num_def="-DHEXA_RT_NUM_PARSE_INT_NATIVE=1"
        extra_obj="$extra_obj build/num_core_native.o"
        echo "[stage_resolve_runtime_a] RT-NATIVE NUM: HEXA_RT_NUM_PARSE_INT_NATIVE=1; ar'ing native num_core_native.o into runtime.a"
    fi
