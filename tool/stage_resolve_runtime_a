# ── CUDA-R1 (`-cuda` release variant · opt-IN HEXA_CUDA=1) — fold the CUDA
# runtime objects into runtime.a so a consumer `hexa build`/`run` program links
# cuBLAS-backed GEMM (anima #2386). This is the BUILD-time half of the opt-in
# CUDA path (the link-flag half is os_clang_ldflags' HEXA_CUDA branch). DEFAULT
# build NEVER sets HEXA_CUDA → this is a no-op there (self-host ≠ release: the
# CPU release tarball + the gen3≡gen4 byteeq fixpoint are untouched).
#
# Mirrors tool/build_cuda_runtime (the GPU-verified #3680 recipe) for the object
# build, but stops at producing the two relocatable objects + signalling the
# runtime.c compile flag — it does NOT run the GEMM verdict harness (that is the
# aiden GPU-verify authority; CI is GPU-less build-only).
#
#   runtime_cuda.o       nvcc -x cu -DHEXA_CUDA -rdc=true (relocatable device code)
#   runtime_cuda_dlink.o nvcc -dlink (device-link blob → resolved by -lcudadevrt)
#
# On success: build/runtime_cuda.o + build/runtime_cuda_dlink.o exist and
# HEXA_CUDA=1 stays set so build_runtime_a_from_source compiles runtime.c with
# -DHEXA_CUDA and ar's both objects in. NON-FATAL + NO-OP-SAFE: on a missing nvcc
# / missing emitter / compile failure it WARNS and unsets HEXA_CUDA so the build
# falls back to the CPU runtime.a (a `-cuda` job then ships a CPU asset — caught
# by the job's own post-build cuda_available probe, not a silent CPU ship).
resolve_cuda_runtime_seed() {
    [ "${HEXA_CUDA:-0}" = "1" ] || return 0   # opt-in only
    # ── DEVICE-ARCH AUTO-RESOLVE (2026-06-22 sm_120 enablement) ───────────────
    # Root cause #2 (forge-sm120-rtx5070): the bare /usr/local/cuda symlink may
    # point at an OLD toolkit (e.g. CUDA 12.0, max sm_90) that cannot emit SASS
    # for a newer device (RTX 5070 = Blackwell sm_120). The arch knob (SM) was
    # already correct; the wrong default CUDA_HOME silently produced a wrong-arch
    # (or fallback) build. Auto-derive BOTH from the live device when the caller
    # did NOT pin them — EXPLICIT env CUDA_HOME / SM are always authoritative.
    #   - SM: if unset, read nvidia-smi compute_cap (e.g. "12.0" -> "120").
    #   - CUDA_HOME: if unset, pick the NEWEST /usr/local/cuda-<ver> whose nvcc
    #     advertises sm_<SM> in `--list-gpu-arch`; else fall back to the symlink.
    # All steps are best-effort + non-fatal (missing nvidia-smi/globs just keep
    # the prior defaults), so non-CUDA / pinned builds are byte-unchanged.
    local SM="${SM:-}"
    if [ -z "$SM" ] && command -v nvidia-smi >/dev/null 2>&1; then
        local _cc
        _cc="$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null | head -1 | tr -d ' .')"
        if printf '%s' "$_cc" | grep -qE '^[0-9]+$'; then
            SM="$_cc"
            echo "[stage_resolve_runtime_a] CUDA-R0: auto-SM=$SM from nvidia-smi compute_cap" >&2
        fi
    fi
    SM="${SM:-120}"
    if [ -z "${CUDA_HOME:-}" ]; then
        # Prefer the newest versioned toolkit that can emit sm_$SM.
        local _best="" _cand _nvcc
        for _cand in $(ls -d /usr/local/cuda-* 2>/dev/null | sort -Vr); do
            _nvcc="$_cand/bin/nvcc"
            [ -x "$_nvcc" ] || continue
            if "$_nvcc" --list-gpu-arch 2>/dev/null | grep -qx "sm_$SM"; then
                _best="$_cand"; break
            fi
        done
        if [ -n "$_best" ]; then
            export CUDA_HOME="$_best"
            echo "[stage_resolve_runtime_a] CUDA-R0: auto-CUDA_HOME=$CUDA_HOME (newest toolkit emitting sm_$SM)" >&2
        fi
    fi
    local CUDA_HOME_D="${CUDA_HOME:-/usr/local/cuda}"
    local CINC="$CUDA_HOME_D/targets/x86_64-linux/include"
    [ -d "$CINC" ] || CINC="$CUDA_HOME_D/include"
    export PATH="$CUDA_HOME_D/bin:$PATH"
    if ! command -v nvcc >/dev/null 2>&1; then
        echo "[stage_resolve_runtime_a] CUDA-R1: WARN no nvcc on PATH ($CUDA_HOME_D/bin) — unsetting HEXA_CUDA, CPU runtime.a" >&2
        unset HEXA_CUDA; return 0
    fi
    mkdir -p build
    # ── MATERIALIZED-SEED FIRST (#3701 lineage — stable -cuda asset never shipped) ──
    # runtime_cuda.c (+ runtime_bf16.c) are the DETERMINISTIC output of their
    # *_emit.hexa SSOTs (byte-eq re-emit verified). Post-#4356 they are NO LONGER
    # tracked (self/*.c ∅ graduation) — but a locally materialized .c (gitignored,
    # e.g. from tool/build_cuda_runtime) is still the fastest path: when present AND
    # carrying the canonical single _hx_dt_exp_dev def, use it as-is and SKIP the
    # synthesis. Otherwise synthesize from the emitter SSOT below (awk un-escape,
    # hexat-free — resolve_cuda_runtime_seed runs at Stage 0b, BEFORE build/hexat
    # exists, so it must not depend on any hexa runner).
    local _cuda_ndef
    _cuda_ndef="$(grep -c '_hx_dt_exp_dev(double x) {' self/cuda/runtime_cuda.c 2>/dev/null || true)"
    if [ -f self/cuda/runtime_cuda.c ] && [ "$_cuda_ndef" = "1" ]; then
        echo "[stage_resolve_runtime_a] CUDA-R1: using checked-in frozen seed self/cuda/runtime_cuda.c (no runner emit — stale-runner-immune, #3701)"
        # runtime_bf16.c rides along as a frozen seed too (committed); it has no
        # _hx_dt_exp_dev contract to assert, so presence is enough.
    else
        # Seed absent → SYNTHESIZE from the *_emit.hexa SSOT. Post-#4356 the tracked
        # .c seeds are GRADUATED (self/*.c ∅ milestone): the emitters are now
        # gen_c_text_emitter output — pure `buf = buf + "…"` line literals — so the
        # same _unescape_emit_to_c awk used for runtime_core.c reproduces the emit
        # BYTE-IDENTICALLY with no hexa runner at all (verified: awk output sha256 ==
        # hexa-runner emit sha256 for both runtime_cuda.c and runtime_bf16.c). This
        # is the PRIMARY path — it is immune to the Stage-0b chicken-egg (no ./hexa /
        # build/hexat yet) that previously made this branch depend on downloading the
        # retired `edge` release asset (edge retired 2026-06-30 → download failed →
        # HEXA_CUDA silently unset → the -cuda asset shipped CPU-only and the job's
        # post-build guard failed every release since #4356).
        echo "[stage_resolve_runtime_a] CUDA-R1: no tracked seed (emitter-SSOT graduated #4356) — synthesizing via awk un-escape (hexat-free)" >&2
        local _cbt _cct
        _cbt="$(mktemp -t regen_bf16_awk.XXXXXX)" || _cbt=""
        _cct="$(mktemp -t regen_cuda_awk.XXXXXX)" || _cct=""
        if [ -n "$_cbt" ] && [ -n "$_cct" ] \
           && _unescape_emit_to_c self/cuda/runtime_bf16_emit.hexa > "$_cbt" 2>/dev/null && [ -s "$_cbt" ] \
           && _unescape_emit_to_c self/cuda/runtime_cuda_emit.hexa > "$_cct" 2>/dev/null && [ -s "$_cct" ] \
           && [ "$(grep -c '_hx_dt_exp_dev(double x) {' "$_cct" || true)" = "1" ]; then
            cp -f "$_cbt" self/cuda/runtime_bf16.c
            cp -f "$_cct" self/cuda/runtime_cuda.c
            echo "[stage_resolve_runtime_a] CUDA-R1: runtime_cuda.c + runtime_bf16.c SYNTHESIZED from emitter SSOT (awk un-escape, $(wc -l < self/cuda/runtime_cuda.c) + $(wc -l < self/cuda/runtime_bf16.c) lines)"
        else
            # awk synthesis failed (emitter shape changed?) → FALLBACK: a hexa RUNNER
            # (a CPU hexa runs the cuda emitter fine — it just prints C text). At
            # Stage 0b ./hexa / build/hexat may not exist; last resort downloads the
            # LATEST STABLE release binary (the old `edge` channel is retired).
            echo "[stage_resolve_runtime_a] CUDA-R1: awk synthesis failed — falling back to a hexa runner emit" >&2
            local RUNNER=""
            if command -v hexa-run >/dev/null 2>&1; then RUNNER="hexa-run"
            elif command -v hexa >/dev/null 2>&1; then RUNNER="hexa run"
            elif [ -x build/hexat ]; then RUNNER="build/hexat run"
            else
                local _rel_dir="/tmp/stable_cuda_runner"
                rm -rf "$_rel_dir"; mkdir -p "$_rel_dir"
                if gh release download --repo "${GITHUB_REPOSITORY:-dancinlab/hexa-lang}" \
                      --pattern "hexa-linux-x86_64.tar.gz" --dir "$_rel_dir" --clobber 2>/tmp/cuda_dl.err \
                   && tar xzf "$_rel_dir/hexa-linux-x86_64.tar.gz" -C "$_rel_dir" 2>/dev/null; then
                    local _rel_hexa
                    _rel_hexa="$(find "$_rel_dir" -name hexa -type f 2>/dev/null | head -1)"
                    if [ -n "$_rel_hexa" ]; then chmod +x "$_rel_hexa" 2>/dev/null || true; RUNNER="$_rel_hexa run"; fi
                fi
            fi
            if [ -z "$RUNNER" ]; then
                rm -f "$_cbt" "$_cct"
                echo "[stage_resolve_runtime_a] CUDA-R1: WARN no hexa runner to emit runtime_cuda.c (and awk synthesis failed) — unsetting HEXA_CUDA, CPU runtime.a" >&2
                unset HEXA_CUDA; return 0
            fi
            HEXA_LANG="$ROOT" $RUNNER self/cuda/runtime_bf16_emit.hexa self/cuda/runtime_bf16.c >/dev/null 2>&1 || true
            HEXA_LANG="$ROOT" $RUNNER self/cuda/runtime_cuda_emit.hexa self/cuda/runtime_cuda.c >/dev/null 2>&1 || true
        fi
        rm -f "$_cbt" "$_cct"
    fi
    if [ ! -f self/cuda/runtime_cuda.c ]; then
        echo "[stage_resolve_runtime_a] CUDA-R1: WARN runtime_cuda.c absent (no frozen seed + runner failed?) — unsetting HEXA_CUDA, CPU runtime.a" >&2
        unset HEXA_CUDA; return 0
    fi
    local ndef; ndef="$(grep -c '_hx_dt_exp_dev(double x) {' self/cuda/runtime_cuda.c || true)"
    if [ "$ndef" != "1" ]; then
        echo "[stage_resolve_runtime_a] CUDA-R1: WARN runtime_cuda.c has $ndef _hx_dt_exp_dev defs (expected 1) — emitter dup-def regressed; unsetting HEXA_CUDA" >&2
        unset HEXA_CUDA; return 0
    fi
    # nvcc relocatable device code + device-link (mirrors build_cuda_runtime).
    # ING-35 #3 — CUDA-13 nvcc compiles -x cu (CUDA C++) of runtime_cuda.c and, by
    # default, emits libstdc++ host symbols: __cxa_guard_{acquire,release,abort}
    # (function-local-static guards) + __gxx_personality_v0/_Unwind_Resume (EH).
    # The consumer `hexa` binary is C-LINKED (gcc/cc, no libstdc++), so those land
    # as `undefined reference to '__cxa_guard_acquire'` at the final link (anima ING
    # #35 cause-3). -Xcompiler -fno-threadsafe-statics drops the guard symbols
    # (single-threaded static init is fine for these constants) and -fno-exceptions
    # drops the EH personality — both are host-codegen-only, device code unchanged.
    #
    # GENCODE — SASS + PTX (the sm_80-SASS-only ship defect, 2026-07-02): with only
    # `code=sm_$SM` nvcc embeds SASS for that ONE arch and NO PTX, so on any newer
    # consumer GPU (e.g. RTX 5070 sm_120 vs the release's SM=80) EVERY kernel launch
    # fails cudaErrorNoKernelImageForDevice — silently, because launches are
    # unchecked — and device results come back as zero-filled garbage (measured:
    # bytegpt_devres_smoke argmax dev=0, max|Δ|=551 with the shipped v0.547.0 -cuda
    # asset; PASS max|Δ|=2.5e-06 after re-splicing the SAME source built with PTX).
    # `code=compute_$SM` additionally embeds the PTX so the driver JITs forward to
    # whatever arch the consumer actually has (one-time JIT, cached in
    # ~/.nv/ComputeCache). release.yml always believed this forward-JIT happened —
    # now it actually does.
    if nvcc -x cu -DHEXA_CUDA -rdc=true \
            -gencode arch=compute_$SM,code=sm_$SM \
            -gencode arch=compute_$SM,code=compute_$SM -O2 -w \
            -Xcompiler -fno-threadsafe-statics -Xcompiler -fno-exceptions \
            -I "$CINC/cccl" -I "$CINC" -I self -I self/cuda -I . \
            -c self/cuda/runtime_cuda.c -o build/runtime_cuda.o \
       && nvcc -dlink -gencode arch=compute_$SM,code=sm_$SM \
            -gencode arch=compute_$SM,code=compute_$SM build/runtime_cuda.o \
            -o build/runtime_cuda_dlink.o -lcudadevrt; then
        echo "[stage_resolve_runtime_a] CUDA-R1: built build/runtime_cuda.o + runtime_cuda_dlink.o (sm_$SM) → folding into runtime.a (-DHEXA_CUDA)"
    else
        echo "[stage_resolve_runtime_a] CUDA-R1: WARN nvcc compile/dlink failed — unsetting HEXA_CUDA, CPU runtime.a" >&2
        unset HEXA_CUDA; rm -f build/runtime_cuda.o build/runtime_cuda_dlink.o; return 0
    fi
}

build_runtime_a_from_source() {
    regen_runtime_core_from_emitter
    # Seed-contamination gate (convergence stage-resolve-runtime-a-3): a frozen RT-NATIVE
    # seed's assembled .o must carry NO undefined external beyond the sanctioned carriers
    # (hexa_*/hxlcl_*/__hx_* — served by runtime.o + the still-compiled shim inside runtime.a).
    # A whole-module dump that slipped past the `.globl`-count isolation drags syscall-leaf
    # siblings' `bl __errno_location` (glibc-only) → detonates the build/hexat link on a target
    # lacking it (darwin: ___errno_location). Echoes the offending symbols ('' = clean); the
    # caller turns a non-empty result into the tri-state's graceful FALLBACK-SHIM (auto) or a
    # FATAL (strict), instead of a misattributed ld error at the much-later hexat link.
    _rn_seed_und_gate() {
        command -v nm >/dev/null 2>&1 || return 0
        nm -u "$1" 2>/dev/null | awk '{print $NF}' | grep -vE '^_?(hexa_|hxlcl_|__hx_)' | tr '\n' ' '
    }
    # RT-NATIVE Z2a (gated): supply rt_str_* from a NATIVE-compiled object
    # (build/rt_hi_native.o, assembled from the self/native/runtime_hi_*.s
    # frozen seed by resolve_native_rt_hi_seed) instead of the hexat-transpiled
    # runtime_hi_gen.c #include — so runtime_hi_gen.c is never needed. Default
    # path unchanged.
    local extra_obj=""
    if [ "${HEXA_ZEROC_RT_HI:-0}" = "1" ] && [ -f build/rt_hi_native.o ]; then
        sed -i.zbak 's|#include "runtime_hi_gen.c"|/* RT-NATIVE Z2a: rt_str_* from native build/rt_hi_native.o */|' self/runtime_core.c
        rm -f self/runtime_core.c.zbak
        extra_obj="build/rt_hi_native.o"
        echo "[stage_resolve_runtime_a] RT-NATIVE Z2a: runtime_hi_gen.c #include removed; ar'ing native rt_hi_native.o into runtime.a"
    fi
    # RT-NATIVE ARRAY-R4 (gated): when the array_core seed is active, define
    # HEXA_RT_ARRAY_NATIVE for the runtime.c compile (so hexa_array_get/set take
    # the native arm) and ar build/array_core_native.o into runtime.a so its
    # rt_array_*_native symbols resolve. The C #else element bodies stay in
    # runtime_core.c as the no-seed fallback (dead on seed targets).
    local rt_array_def=""
    # zero-c #29 Track A floor-drop: suppress the compiler-synth bare mem libcalls
    # (memcpy/memset/memmove/memcmp) so they drop from the runtime.a nm-UND floor. MEASURED
    # (summer, self/runtime.c): clang-18 drops them with -fno-builtin-* alone, but gcc ALSO
    # needs -fno-tree-loop-distribute-patterns (its loop-distribution pass re-emits struct/loop
    # copies as memcpy even under -fno-builtin). clang REJECTS the gcc-only -ftree-* flag
    # ("unknown argument"), so it is added conditionally for gcc only. Prereq: the #4366 fast
    # glibc-dispatch hxlcl_memcpy/memset/memmove/memcmp bodies (explicit calls stay fast).
    local _zeroc_nobuiltin="-fno-builtin-memcpy -fno-builtin-memset -fno-builtin-memmove -fno-builtin-memcmp -fno-builtin-strcpy -fno-builtin-strncpy -fno-builtin-strcat -fno-builtin-strlen"
    case "$("${CC:-cc}" --version 2>/dev/null | head -1)" in
        *[Cc]lang*) : ;;                                  # clang: -fno-builtin-* suffices
        *) _zeroc_nobuiltin="$_zeroc_nobuiltin -fno-tree-loop-distribute-patterns" ;;  # gcc
    esac
    if [ "${HEXA_RT_ARRAY_NATIVE:-0}" = "1" ] && [ -f build/array_core_native.o ]; then
        rt_array_def="-DHEXA_RT_ARRAY_NATIVE=1"
        extra_obj="$extra_obj build/array_core_native.o"
        echo "[stage_resolve_runtime_a] RT-NATIVE ARRAY-R4: HEXA_RT_ARRAY_NATIVE=1; ar'ing native array_core_native.o into runtime.a"
    fi
    local rt_map_def=""
    if [ "${HEXA_RT_MAP_NATIVE:-0}" = "1" ] && [ -f build/map_core_native.o ]; then
        rt_map_def="-DHEXA_RT_MAP_NATIVE=1"
        extra_obj="$extra_obj build/map_core_native.o"
        echo "[stage_resolve_runtime_a] RT-NATIVE MAP-R3: HEXA_RT_MAP_NATIVE=1; ar'ing native map_core_native.o into runtime.a"
    fi
    local rt_intern_def=""
    if [ "${HEXA_RT_INTERN_NATIVE:-0}" = "1" ] && [ -f build/intern_core_native.o ]; then
        rt_intern_def="-DHEXA_RT_INTERN_NATIVE=1"
        extra_obj="$extra_obj build/intern_core_native.o"
        echo "[stage_resolve_runtime_a] RT-NATIVE INTERN-R1: HEXA_RT_INTERN_NATIVE=1; ar'ing native intern_core_native.o into runtime.a"
    fi
