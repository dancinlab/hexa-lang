// llm_settings.hexa — the LLM connection-settings store (CLI+COCKPIT · D38).
//
// Pure-hexa-native port of DemiurgeCore/Models/LLMProvider.swift +
// DemiurgeCore/Loaders/LLMConfig.swift `LLMSettings`. This is the SETTINGS
// LEAF for the `demiurge llm` surface — it owns the provider seed-manifest,
// the ~/.demiurge/llm.json read/write, and the (providers · active)
// resolution. The handler (handlers.hexa handler_llm) is thin on top of it.
//
// @D d3 — implementation lives in ONE canonical home; this leaf is reused by
//          handler_llm (no duplicated store logic in the handler).
// @D d4 — providers are MANIFEST DATA (ls_builtins), never code branches; the
//          handler/resolver never special-case a provider id. Adding /
//          renaming / removing a provider = editing ls_builtins (or the user's
//          llm.json) — no dispatcher edit.
//
// Byte-exactness: llm.json is written by Swift's JSONEncoder with
// [.prettyPrinted, .sortedKeys] and `.write(…, options: .atomic)` (NO trailing
// newline). The serializer below reproduces that layout 1:1 — 2-space indent,
// alphabetical top-level keys (cliOverrides · mode · models · selectedProvider),
// the empty-object quirk `{\n\n  }`, sorted dict keys, no trailing newline.
//
// Reuses the json_object leaf (d3) for parsing the on-disk config and
// read_file/write_file (POSIX) for IO — same idiom as project_store.hexa.

import "stdlib/alloc/json_object.hexa"
import "stdlib/keychain.hexa"

// ── provider descriptor (Swift LLMProvider) ─────────────────────────────────
struct LlmProvider {
    id:           string,   // "claude" — stable key (config · keychain account)
    display_name: string,   // "Claude"
    key_env:      string,   // "ANTHROPIC_API_KEY" — env read FIRST
    wire_format:  string,   // "anthropic" | "openai" | "gemini"
    cli_command:  string,   // joined cliCommand (display-only for expert list)
    default_model: string,
    api_base:     string,   // "https://api.anthropic.com" — Swift LLMProvider.apiBaseURL
    api_path:     string,   // "/v1/messages" ({model} substituted for gemini) — apiPath
}

// ── resolved config (Swift LLMConfig) ───────────────────────────────────────
// Carries the SELECTION only (provider · mode) + the per-id model overrides.
// cliOverrides is preserved verbatim on write (the CLI never sets it) so a
// cockpit-written override survives a CLI save — hence the parallel-array
// carrier for its arbitrary keys.
struct LlmConfig {
    selected_provider: string,
    mode:              string,           // "cli" | "api"
    model_keys:        [string],         // provider id → model override (parallel)
    model_vals:        [string],
    cli_ovr_keys:      [string],         // provider id → cliCommand override (preserved)
    cli_ovr_vals:      [[string]],
}

// ls_builtins() — the built-in provider seed manifest (Swift LLMProvider.builtins).
// Order is significant: builtins[0] (claude) is the default selection.
pub fn ls_builtins() -> [LlmProvider] {
    let mut ps: [LlmProvider] = []
    ps.push(LlmProvider {
        id: "claude", display_name: "Claude",
        key_env: "ANTHROPIC_API_KEY", wire_format: "anthropic",
        cli_command: "claude -p {prompt}",
        default_model: "claude-opus-4-7",
        api_base: "https://api.anthropic.com", api_path: "/v1/messages",
    })
    ps.push(LlmProvider {
        id: "codex", display_name: "Codex (OpenAI)",
        key_env: "OPENAI_API_KEY", wire_format: "openai",
        cli_command: "codex exec --skip-git-repo-check {prompt}",
        default_model: "gpt-5-codex",
        api_base: "https://api.openai.com", api_path: "/v1/chat/completions",
    })
    ps.push(LlmProvider {
        id: "gemini", display_name: "Gemini",
        key_env: "GEMINI_API_KEY", wire_format: "gemini",
        cli_command: "gemini --skip-trust -p {prompt}",
        default_model: "gemini-2.5-pro",
        api_base: "https://generativelanguage.googleapis.com",
        api_path: "/v1beta/models/{model}:generateContent",
    })
    return ps
}

// ls_mode_label(m) — Swift LLMMode.label.
pub fn ls_mode_label(m: string) -> string {
    if m == "cli" { return "CLI (설치된 명령)" }
    return "API (키 입력)"
}

// ls_shq(s) — single-quote a shell argument (local leaf · no back-import,
// mirrors br_shq / _shq).
fn ls_shq(s: string) -> string {
    let mut out = "'"
    let mut i = 0
    while i < len(s) {
        let c = s.substring(i, i + 1)
        if c == "'" { out = out + "'\\''" } else { out = out + c }
        i = i + 1
    }
    return out + "'"
}

// ls_config_dir() / ls_config_path() — Swift LLMSettings.configDir/URL
// (~/.demiurge/llm.json · homeDirectoryForCurrentUser).
pub fn ls_config_dir() -> string {
    return env("HOME") + "/.demiurge"
}
pub fn ls_config_path() -> string {
    return ls_config_dir() + "/llm.json"
}

// ls_default_config() — Swift LLMConfig() default: selected = builtins[0],
// mode = cli, empty overrides.
pub fn ls_default_config() -> LlmConfig {
    let bs = ls_builtins()
    return LlmConfig {
        selected_provider: bs[0].id, mode: "cli",
        model_keys: [], model_vals: [],
        cli_ovr_keys: [], cli_ovr_vals: [],
    }
}

// ls_load() — Swift LLMSettings.load(): decode ~/.demiurge/llm.json, or the
// sane default on miss / malformed (a default beats a crash). Reads the file
// via `cat` (no read_file builtin) and parses with the json_object leaf.
pub fn ls_load() -> LlmConfig {
    let raw = exec("cat " + ls_shq(ls_config_path()) + " 2>/dev/null").trim()
    if len(raw) == 0 { return ls_default_config() }
    let obj = json_parse_object(raw)
    if type_of(obj) != "map" { return ls_default_config() }
    // A genuine config carries at least selectedProvider + mode; absent →
    // treat as malformed and fall back (Swift's decode-failure default).
    if !json_object_has(obj, "selectedProvider") { return ls_default_config() }
    if !json_object_has(obj, "mode") { return ls_default_config() }
    let bs = ls_builtins()
    let sel = json_object_get_str(obj, "selectedProvider", bs[0].id)
    let md  = json_object_get_str(obj, "mode", "cli")
    let mut cfg = LlmConfig {
        selected_provider: sel, mode: md,
        model_keys: [], model_vals: [],
        cli_ovr_keys: [], cli_ovr_vals: [],
    }
    // models — provider id → model override (string values).
    let models = json_object_get(obj, "models")
    if type_of(models) == "map" {
        let mks = json_object_keys(models)
        let mut i = 0
        while i < len(mks) {
            let k = mks[i]
            cfg.model_keys.push(k)
            cfg.model_vals.push(to_string(models[k]))
            i = i + 1
        }
    }
    // cliOverrides — provider id → [string] (preserved verbatim on write).
    let ovr = json_object_get(obj, "cliOverrides")
    if type_of(ovr) == "map" {
        let oks = json_object_keys(ovr)
        let mut j = 0
        while j < len(oks) {
            let k = oks[j]
            let arr = ovr[k]
            let mut vs: [string] = []
            if type_of(arr) == "array" {
                let mut t = 0
                while t < len(arr) { vs.push(to_string(arr[t])) ; t = t + 1 }
            }
            cfg.cli_ovr_keys.push(k)
            cfg.cli_ovr_vals.push(vs)
            j = j + 1
        }
    }
    return cfg
}

// ls_model_for(cfg, id) — the resolved model override for a provider id, or ""
// if none (caller falls back to the builtin default_model).
fn ls_model_for(cfg: LlmConfig, id: string) -> string {
    let mut i = 0
    while i < len(cfg.model_keys) {
        if cfg.model_keys[i] == id { return cfg.model_vals[i] }
        i = i + 1
    }
    return ""
}

// ls_providers(cfg) — Swift LLMSettings.providers(): builtins with the user's
// per-id model override folded in (cliCommand override display is out of scope
// for the list view; the resolver keeps the override on disk). d4 — one
// assembled list, no id-branch.
pub fn ls_providers(cfg: LlmConfig) -> [LlmProvider] {
    let bs = ls_builtins()
    let mut out: [LlmProvider] = []
    let mut i = 0
    while i < len(bs) {
        let p = bs[i]
        let ovr = ls_model_for(cfg, p.id)
        let model = if len(ovr) > 0 { ovr } else { p.default_model }
        out.push(LlmProvider {
            id: p.id, display_name: p.display_name, key_env: p.key_env,
            wire_format: p.wire_format, cli_command: p.cli_command,
            default_model: model,
            api_base: p.api_base, api_path: p.api_path,
        })
        i = i + 1
    }
    return out
}

// ls_active(cfg) — Swift LLMSettings.active(): the selected provider, or the
// first builtin if the selection is stale.
pub fn ls_active(cfg: LlmConfig) -> LlmProvider {
    let ps = ls_providers(cfg)
    let mut i = 0
    while i < len(ps) {
        if ps[i].id == cfg.selected_provider { return ps[i] }
        i = i + 1
    }
    return ps[0]
}

// ls_find_provider(cfg, id) — return a 1-element list (found) or empty (none),
// mirroring Swift `providers.first { $0.id == id }` (hexa has no Optional here).
pub fn ls_find_provider(cfg: LlmConfig, id: string) -> [LlmProvider] {
    let ps = ls_providers(cfg)
    let mut out: [LlmProvider] = []
    let mut i = 0
    while i < len(ps) {
        if ps[i].id == id { out.push(ps[i]) ; return out }
        i = i + 1
    }
    return out
}

// ls_key_source(p) — Swift LLMKeyStore.keySource(for:). env var first
// (read-only, no value revealed), then the macOS keychain (account = id,
// service = lab.dancin.demiurge.llm), else "없음". The keychain probe uses
// `security find-generic-password` (read membership only — no value print).
pub fn ls_key_source(p: LlmProvider) -> string {
    let ev = env(p.key_env).trim()
    if len(ev) > 0 { return "env (" + p.key_env + ")" }
    // keychain membership probe — value never read (d3 stdlib/keychain).
    if keychain_has("lab.dancin.demiurge.llm", p.id) { return "키체인" }
    return "없음"
}

// ── byte-exact JSON serialization (Swift JSONEncoder pretty + sortedKeys) ────

// ls_json_escape(s) — same escape set as ps_json_escape (Foundation escapes
// the forward slash too).
fn ls_json_escape(s: string) -> string {
    let n = len(s)
    let mut out = ""
    let mut i = 0
    while i < n {
        let c = s.substring(i, i + 1)
        if c == "\\" { out = out + "\\\\" }
        else if c == "\"" { out = out + "\\\"" }
        else if c == "/" { out = out + "\\/" }
        else if c == "\n" { out = out + "\\n" }
        else if c == "\r" { out = out + "\\r" }
        else if c == "\t" { out = out + "\\t" }
        else { out = out + c }
        i = i + 1
    }
    return out
}

// ls_sort_str(xs) — ascii lexicographic sort (insertion; the key sets are tiny
// — at most the 3 builtin ids). Matches Swift's sortedKeys ordering.
fn ls_sort_str(xs: [string]) -> [string] {
    let mut out: [string] = []
    let mut i = 0
    while i < len(xs) { out.push(xs[i]) ; i = i + 1 }
    let mut a = 1
    while a < len(out) {
        let key = out[a]
        let mut b = a - 1
        while b >= 0 && out[b] > key {
            out[b + 1] = out[b]
            b = b - 1
        }
        out[b + 1] = key
        a = a + 1
    }
    return out
}

// ls_str_dict_json(keys, vals) — a {string:string} dict in Swift's pretty
// layout, keys sorted, indented so the closing `}` sits at 2 spaces. Empty →
// `{\n\n  }` (Swift's empty-object blank line). Each entry at 4-space indent.
fn ls_str_dict_json(ks: [string], vs: [string]) -> string {
    if len(ks) == 0 { return "{\n\n  }" }
    let sorted = ls_sort_str(ks)
    let mut out = "{\n"
    let mut i = 0
    while i < len(sorted) {
        let k = sorted[i]
        // find the value paired with this key
        let mut v = ""
        let mut j = 0
        while j < len(ks) {
            if ks[j] == k { v = vs[j] }
            j = j + 1
        }
        out = out + "    \"" + ls_json_escape(k) + "\" : \"" + ls_json_escape(v) + "\""
        if i < len(sorted) - 1 { out = out + "," }
        out = out + "\n"
        i = i + 1
    }
    return out + "  }"
}

// ls_str_array_inline(xs) — a [string] array nested one level deeper than the
// top-level (used inside cliOverrides values). Swift indents the elements at
// 8 spaces and the closing bracket at 4. Empty → `[\n\n    ]`.
fn ls_str_array_inline(xs: [string]) -> string {
    if len(xs) == 0 { return "[\n\n    ]" }
    let mut out = "[\n"
    let mut i = 0
    while i < len(xs) {
        out = out + "        \"" + ls_json_escape(xs[i]) + "\""
        if i < len(xs) - 1 { out = out + "," }
        out = out + "\n"
        i = i + 1
    }
    return out + "    ]"
}

// ls_cli_ovr_json(keys, vals) — the cliOverrides dict ({string:[string]}).
// Empty → `{\n\n  }`. Keys sorted; each value an inline string array.
fn ls_cli_ovr_json(ks: [string], vs: [[string]]) -> string {
    if len(ks) == 0 { return "{\n\n  }" }
    let sorted = ls_sort_str(ks)
    let mut out = "{\n"
    let mut i = 0
    while i < len(sorted) {
        let k = sorted[i]
        let mut arr: [string] = []
        let mut j = 0
        while j < len(ks) {
            if ks[j] == k { arr = vs[j] }
            j = j + 1
        }
        out = out + "    \"" + ls_json_escape(k) + "\" : " + ls_str_array_inline(arr)
        if i < len(sorted) - 1 { out = out + "," }
        out = out + "\n"
        i = i + 1
    }
    return out + "  }"
}

// ls_config_json(cfg) — the byte-exact llm.json text (NO trailing newline,
// matching the Swift encoder's Data). Top-level keys alphabetical:
// cliOverrides · mode · models · selectedProvider.
pub fn ls_config_json(cfg: LlmConfig) -> string {
    let mut out = "{\n"
    out = out + "  \"cliOverrides\" : " + ls_cli_ovr_json(cfg.cli_ovr_keys, cfg.cli_ovr_vals) + ",\n"
    out = out + "  \"mode\" : \"" + ls_json_escape(cfg.mode) + "\",\n"
    out = out + "  \"models\" : " + ls_str_dict_json(cfg.model_keys, cfg.model_vals) + ",\n"
    out = out + "  \"selectedProvider\" : \"" + ls_json_escape(cfg.selected_provider) + "\"\n"
    out = out + "}"
    return out
}

// ls_save(cfg) — Swift LLMSettings.save(): mkdir -p ~/.demiurge (0700) then
// write llm.json (0600). write_file is the POSIX builtin (same as project_store).
pub fn ls_save(cfg: LlmConfig) -> bool {
    exec("mkdir -p " + ls_shq(ls_config_dir()) + " && chmod 700 " + ls_shq(ls_config_dir()))
    let path = ls_config_path()
    write_file(path, ls_config_json(cfg))
    exec("chmod 600 " + ls_shq(path))
    return true
}

// ls_set_model(cfg, id, model) — set/replace a provider's model override
// in-place (parallel-array upsert). Returns the mutated config.
pub fn ls_set_model(cfg: LlmConfig, id: string, model: string) -> LlmConfig {
    let mut c = cfg
    let mut i = 0
    while i < len(c.model_keys) {
        if c.model_keys[i] == id { c.model_vals[i] = model ; return c }
        i = i + 1
    }
    c.model_keys.push(id)
    c.model_vals.push(model)
    return c
}

// ════════════════════════════════════════════════════════════════════════
// PR #17b — Keychain write/delete + live LLMBridge (test · ask).
//
// @L7 HONESTY: the Keychain SecItemAdd/Delete and the HTTPS / CLI dispatch
// are REAL side effects — these functions perform them functionally and are
// NOT faked. The deterministic pre-side-effect error paths (missing key,
// empty cliCommand, no API key) are what the parity gate byte-asserts; the
// live happy path is exercised manually, never in the gate.
//
// Keychain: the cockpit uses the Security framework SecItemAdd/Delete on
// service "lab.dancin.demiurge.llm", account = provider id. The macOS
// `security` CLI hits the SAME login keychain + item shape, so a key set by
// `demiurge llm key` is read back by the cockpit (and vice-versa). This is
// the documented d3 mechanism — one keychain item, two front-ends.
// ════════════════════════════════════════════════════════════════════════

// ls_keychain_service() — the shared keychain service name (Swift
// LLMKeyStore.service). Single source so set/delete/probe never drift.
pub fn ls_keychain_service() -> string {
    return "lab.dancin.demiurge.llm"
}

// ls_key_set(id, key) — Swift LLMKeyStore.setKey: trim, reject empty, then
// store (update-or-add) the generic-password item. Returns true on a
// confirmed write, false on empty input OR a keychain failure. Delegates to
// the canonical stdlib/keychain.hexa wrapper (d3 — no duplicated `security`
// shellout); keychain_set uses `-U` so it updates-or-adds in one call (same
// net effect as the Swift SecItemDelete+SecItemAdd).
pub fn ls_key_set(id: string, key: string) -> bool {
    let value = key.trim()
    if len(value) == 0 { return false }
    return keychain_set(ls_keychain_service(), id, value)
}

// ls_key_delete(id) — Swift LLMKeyStore.deleteKey: idempotent remove (a
// missing item is not an error — keychain_delete returns false on miss, which
// we ignore). The env var, if set, is untouched. d3 — stdlib keychain.
pub fn ls_key_delete(id: string) {
    keychain_delete(ls_keychain_service(), id)
}

// ls_resolved_key(p) — Swift LLMKeyStore.resolvedKey: env var FIRST (no
// keychain prompt), else the keychain value. Returns "" when neither is set
// (the API path then surfaces the honest "키 없음" error). d3 — stdlib keychain.
fn ls_resolved_key(p: LlmProvider) -> string {
    let ev = env(p.key_env).trim()
    if len(ev) > 0 { return ev }
    return keychain_get(ls_keychain_service(), p.id)
}

// ── LLMBridge reply (Swift LLMReply) ─────────────────────────────────────
struct LlmReply {
    text:   string,
    ok:     bool,
    detail: string,
}

// ls_guarded(prompt, context) — Swift LLMBridge.guarded read-only framing.
fn ls_guarded(prompt: string, context: string) -> string {
    return "[demiurge — answer concisely in Korean, plain language; do NOT "
        + "modify files, run builds, or invoke tools. Project context: "
        + context + "] " + prompt
}

// ls_split_ws(s) — split a cli_command string on single spaces into argv
// (the builtins use plain single-space joins, so this round-trips exactly).
fn ls_split_ws(s: string) -> [string] {
    let mut out: [string] = []
    let mut cur = ""
    let mut i = 0
    while i < len(s) {
        let c = s.substring(i, i + 1)
        if c == " " { if len(cur) > 0 { out.push(cur) ; cur = "" } }
        else { cur = cur + c }
        i = i + 1
    }
    if len(cur) > 0 { out.push(cur) }
    return out
}

// ls_run_cli(p, prompt) — Swift LLMBridge.runCLI: substitute {prompt}/{model}
// into the provider's cliCommand argv and spawn it (login-shell PATH so
// claude/codex/gemini resolve). The exit status + output are captured via a
// sentinel line. stdin is closed (</dev/null) so the providers don't block.
fn ls_run_cli(p: LlmProvider, prompt: string) -> LlmReply {
    let argv = ls_split_ws(p.cli_command)
    if len(argv) == 0 {
        return LlmReply { text: "", ok: false, detail: p.id + ": cliCommand 비어 있음" }
    }
    // Rebuild the command, substituting placeholders per-token then shq.
    let mut cmd = ""
    let mut i = 0
    while i < len(argv) {
        let mut tok = argv[i]
        tok = tok.replace("{prompt}", prompt)
        tok = tok.replace("{model}", p.default_model)
        if i > 0 { cmd = cmd + " " }
        cmd = cmd + ls_shq(tok)
        i = i + 1
    }
    // login-shell so rc files put claude/codex/gemini on PATH; capture rc.
    let full = "out=$(" + cmd + " </dev/null 2>&1); rc=$?; "
        + "printf '%s\\n__DEMI_RC__%d' \"$out\" \"$rc\""
    let raw = exec("/bin/sh -lc " + ls_shq(full))
    let marker = "\n__DEMI_RC__"
    let idx = raw.index_of(marker)
    let body = if idx >= 0 { raw.substring(0, idx).trim() } else { raw.trim() }
    let rcs = if idx >= 0 { raw.substring(idx + len(marker), len(raw)).trim() } else { "1" }
    if rcs != "0" {
        let snippet = if len(body) == 0 { "(no output)" } else { body }
        return LlmReply { text: body, ok: false,
            detail: p.id + " · cli · exit " + rcs + " — " + snippet }
    }
    if len(body) == 0 {
        return LlmReply { text: "", ok: false, detail: p.id + " · cli · 빈 출력" }
    }
    return LlmReply { text: body, ok: true, detail: p.id + " · cli" }
}

// ls_api_url(p) — Swift runAPI URL assembly: base + path with {model} filled.
fn ls_api_url(p: LlmProvider) -> string {
    let path = p.api_path.replace("{model}", p.default_model)
    return p.api_base + path
}

// ls_api_body(p, prompt) — the wire-format-specific JSON request body. The
// ONLY branch is on wire_format (a trait), never the provider id (d4).
fn ls_api_body(p: LlmProvider, prompt: string) -> string {
    let pe = ls_json_escape(prompt)
    if p.wire_format == "anthropic" {
        return "{\"model\":\"" + p.default_model + "\",\"max_tokens\":1024,"
            + "\"messages\":[{\"role\":\"user\",\"content\":\"" + pe + "\"}]}"
    }
    if p.wire_format == "openai" {
        return "{\"model\":\"" + p.default_model + "\","
            + "\"messages\":[{\"role\":\"user\",\"content\":\"" + pe + "\"}]}"
    }
    // gemini
    return "{\"contents\":[{\"parts\":[{\"text\":\"" + pe + "\"}]}]}"
}

// ls_run_api(p, prompt) — Swift LLMBridge.runAPI: resolve key (env/keychain),
// build the wire-format request, curl it, parse the reply text. Returns the
// honest "키 없음" / network / HTTP-status error otherwise.
fn ls_run_api(p: LlmProvider, prompt: string) -> LlmReply {
    let key = ls_resolved_key(p)
    if len(key) == 0 {
        return LlmReply { text: "", ok: false,
            detail: p.id + " · api · 키 없음 — 설정에서 키 입력 또는 " + p.key_env + " export" }
    }
    let mut url = ls_api_url(p)
    let body = ls_api_body(p, prompt)
    // Headers per wire format (the d4 trait branch).
    let mut hdrs = " -H 'content-type: application/json'"
    if p.wire_format == "anthropic" {
        hdrs = hdrs + " -H " + ls_shq("x-api-key: " + key)
            + " -H 'anthropic-version: 2023-06-01'"
    } else if p.wire_format == "openai" {
        hdrs = hdrs + " -H " + ls_shq("authorization: Bearer " + key)
    } else {
        url = url + "?key=" + key
    }
    // -s silent, -w the HTTP status on its own sentinel line.
    let cmd = "curl -sS --max-time 60 -X POST " + hdrs
        + " -d " + ls_shq(body) + " " + ls_shq(url)
        + " -w '\\n__DEMI_HTTP__%{http_code}'"
    let raw = exec(cmd + " 2>&1")
    let marker = "\n__DEMI_HTTP__"
    let idx = raw.index_of(marker)
    if idx < 0 {
        return LlmReply { text: "", ok: false,
            detail: p.id + " · api · 네트워크 오류 — " + raw.trim() }
    }
    let payload = raw.substring(0, idx)
    let status = raw.substring(idx + len(marker), len(raw)).trim()
    if status != "200" {
        let msg = if len(payload) > 200 { payload.substring(0, 200) } else { payload }
        if status == "000" || len(status) == 0 {
            return LlmReply { text: "", ok: false,
                detail: p.id + " · api · 네트워크 오류 — " + msg }
        }
        return LlmReply { text: "", ok: false,
            detail: p.id + " · api · HTTP " + status + " — " + msg }
    }
    let obj = json_parse_object(payload)
    if type_of(obj) != "map" {
        return LlmReply { text: "", ok: false, detail: p.id + " · api · 응답 파싱 실패" }
    }
    let mut text = ""
    if p.wire_format == "anthropic" {
        let content = json_object_get(obj, "content")
        if type_of(content) == "array" && len(content) > 0 {
            let first = content[0]
            if type_of(first) == "map" { text = json_object_get_str(first, "text", "") }
        }
    } else if p.wire_format == "openai" {
        let choices = json_object_get(obj, "choices")
        if type_of(choices) == "array" && len(choices) > 0 {
            let msg0 = json_object_get(choices[0], "message")
            if type_of(msg0) == "map" { text = json_object_get_str(msg0, "content", "") }
        }
    } else {
        let cands = json_object_get(obj, "candidates")
        if type_of(cands) == "array" && len(cands) > 0 {
            let cont = json_object_get(cands[0], "content")
            if type_of(cont) == "map" {
                let parts = json_object_get(cont, "parts")
                if type_of(parts) == "array" && len(parts) > 0 {
                    let p0 = parts[0]
                    if type_of(p0) == "map" { text = json_object_get_str(p0, "text", "") }
                }
            }
        }
    }
    text = text.trim()
    if len(text) == 0 {
        return LlmReply { text: "", ok: false, detail: p.id + " · api · 응답 파싱 실패" }
    }
    return LlmReply { text: text, ok: true, detail: p.id + " · api" }
}

// ls_bridge_test(cfg, p) — Swift LLMBridge.test: a fixed ping probe through
// the given provider + the config's current mode.
pub fn ls_bridge_test(cfg: LlmConfig, p: LlmProvider) -> LlmReply {
    let probe = "ping — reply with the single word: pong"
    if cfg.mode == "cli" { return ls_run_cli(p, probe) }
    return ls_run_api(p, probe)
}

// ls_bridge_ask(cfg, prompt, context) — Swift LLMBridge.ask: active provider
// + current mode, guarded framing.
pub fn ls_bridge_ask(cfg: LlmConfig, prompt: string, context: string) -> LlmReply {
    let p = ls_active(cfg)
    let text = ls_guarded(prompt, context)
    if cfg.mode == "cli" { return ls_run_cli(p, text) }
    return ls_run_api(p, text)
}
