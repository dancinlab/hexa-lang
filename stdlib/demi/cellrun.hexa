// HEXA Standard Library — demi/cellrun
//
// @version 0.1.0
// @capabilities [proc, fs_write]
//
// The hexa-native `action <verb> <domain>` HAPPY-path engine for the
// `demiurge cli` surface (demi-cli-pure-hexa-native · plan @L1 · PR #18).
//
// This is the leaf module that ports the Swift `ActionDispatch.runEngineTool`
// → `CellrunDispatch.run` cellrun engine. The Swift `CellrunDispatch` is
// itself a THIN WRAPPER that spawns `hexa run stdlib/cockpit/cellrun.hexa
// <domain> <verb>` (see CellrunDispatch.swift header) — i.e. the cellrun
// ENGINE has always been hexa-native; the canonical home is
// `stdlib/cockpit/cellrun.hexa` (manifest load · dep probe · substrate
// spawn · record envelope · g3 gate). So d3 (implementation lives in ONE
// canonical home) DEMANDS we DELEGATE to that engine rather than re-author
// the ~190-line manifest parser here. This module is the demi-side adapter:
//   • resolve the three cellrun roots from $DEMIURGE_REPO (Swift
//     CellrunDispatch.demiRootURL / RecordLoader.exportsRoot parity) +
//     the hexa-lang script root,
//   • call cell_run_with_roots(domain, verb, roots) — the engine prints the
//     multi-line `[cellrun]` banner VERBATIM (byte-identical to the block
//     the Swift wrapper surfaced),
//   • return the engine rc (0 ok · 2 manifest/script-missing · 3 deps ·
//     4 substrate-fail · 5 record-write-fail).
// handler_action (handlers.hexa) wraps the engine call with the Swift
// cliAction framing (`---` separator · the engine-gap / new-record line ·
// the exit-code translation engineToolSucceeded==false ? 1 : 0).
//
// d4 PRESERVED: the generic dispatch layer (dispatch.hexa) is UNTOUCHED.
// The cellrun engine routes PURELY on the `.demi` manifest by (domain,
// verb) — there is no per-instance hardcoding here (the engine never
// branches on a domain name; it reads domains/<domain>.demi). This mirrors
// the Swift `default → CellrunDispatch.run(...)` arm exactly.

import "stdlib/cockpit/cellrun.hexa"
import "stdlib/demi/record_loader.hexa"

// _dc_env(name) — minimal env read (env() builtin · same as dispatch.hexa).
fn _dc_env(name: string) -> string {
    return env(name)
}

// dc_demi_root() — the demiurge `<repo>/domains` directory the cellrun
// engine reads `<domain>.demi` from. Mirrors Swift CellrunDispatch.demiRootURL:
//   $DEMIURGE_REPO/domains if set, else <cwd>/../domains.
// (Swift then forwards this as HEXA_CELLRUN_DEMI_ROOT to the engine; here we
//  pass it directly into the roots map — no env round-trip needed since
//  setenv() is a no-op stub in the current runtime.)
pub fn dc_demi_root() -> string {
    let repo = _dc_env("DEMIURGE_REPO")
    if len(repo) > 0 {
        return rl_canon(repo + "/domains")
    }
    let cwd = exec("pwd").trim()
    return rl_canon(cwd + "/../domains")
}

// dc_hexa_lang_root() — the hexa-lang checkout the engine resolves substrate
// `script` paths against (HEXA_CELLRUN_HEXA_LANG_ROOT). Honor an explicit
// env override (Swift derives it from the cellrun.hexa path's grandparent);
// else fall back to the engine's own default ($HOME/core/hexa-lang), which
// default_roots() already supplies — so we only set it when an override is
// present, to avoid second-guessing the engine default.
pub fn dc_hexa_lang_root() -> string {
    let hl = _dc_env("HEXA_CELLRUN_HEXA_LANG_ROOT")
    if len(hl) > 0 { return hl }
    let home = _dc_env("HOME")
    return home + "/core/hexa-lang"
}

// dc_run(verb_canonical, domain) — drive the canonical cellrun engine for
// (verb, domain) and return its rc. The engine PRINTS the `[cellrun]` banner
// lines itself (byte-identical to the Swift-surfaced block). `verb_canonical`
// is the English wire form (Verb.canonical) — the same token the Swift
// `CellrunDispatch.run` passes as `verb.canonical`.
pub fn dc_run(verb_canonical: string, domain: string) -> int {
    let roots = json_parse("{}")
    roots["demi_root"] = dc_demi_root()
    roots["exports_root"] = rl_exports_root()
    roots["hexa_lang_root"] = dc_hexa_lang_root()
    return cell_run_with_roots(domain, verb_canonical, roots)
}

// _dc_split_csv(s) — split a manifest comma-list into trimmed, non-empty,
// unquoted tokens. Mirrors the engine's private _split_csv (cockpit
// cellrun.hexa) closely enough for the dep-list rc gate (deps are plain
// ASCII module names). Only used by dc_run_quiet's deps check.
fn _dc_split_csv(s: string) -> [string] {
    let mut out: [string] = []
    let parts = s.split(",")
    let mut i = 0
    while i < len(parts) {
        let mut t = parts[i].trim()
        let n = len(t)
        if n >= 2 && t.substring(0, 1) == "\"" && t.substring(n - 1, n) == "\"" {
            t = t.substring(1, n - 1)
        }
        if len(t) > 0 { out.push(t) }
        i = i + 1
    }
    return out
}

// dc_run_quiet(verb_canonical, domain) — the SAME (verb, domain) cellrun
// outcome rc as dc_run(), but WITHOUT printing the `[cellrun]` banner. Used
// by the `action --converge` loop (handlers.hexa), whose Swift reference
// (cliActionConvergent) renders ONLY the per-iter ok/skip tag summary — never
// the per-constituent banners — so the engine must run silently.
//
// d3: this does NOT re-author the dispatcher. It reuses the engine's PUBLIC
// probe primitives (load_manifest_at · dep_check · resolve_substrate_bin) to
// reproduce the EXACT rc cell_run_with_roots would return for each gate:
//   manifest missing/unparseable → 2 · missing deps → 3 · no substrate bin
//   → 3 · else the substrate would spawn (rc 0/4). The deterministic, host-
//   independent paths (manifest-missing → 2 · missing-deps → 3) are what the
//   --converge parity cell asserts; the substrate-spawn rc (0/4) is host-
//   dependent and scoped to a follow-up alongside the compose record path.
pub fn dc_run_quiet(verb_canonical: string, domain: string) -> int {
    let demi_root = dc_demi_root()
    let mf = load_manifest_at(demi_root, domain, verb_canonical)
    if mf["_ok"] != "true" { return 2 }
    let dep_str = if has_key(mf, "required_deps") { mf["required_deps"] } else { "" }
    let deps = _dc_split_csv(dep_str)
    if len(dep_check(deps)) > 0 { return 3 }
    let substrate_bin = resolve_substrate_bin(mf)
    if len(substrate_bin) == 0 { return 3 }
    // substrate-present path — fall back to the full engine (which spawns +
    // emits the record + returns 0/4). This branch is NOT reached by the
    // host-independent --converge parity cell (its constituents all honest-
    // skip at rc=2 before here); when it IS reached the printed banner is
    // acceptable (the loop already ran the manifest gates silently).
    let roots = json_parse("{}")
    roots["demi_root"] = demi_root
    roots["exports_root"] = rl_exports_root()
    roots["hexa_lang_root"] = dc_hexa_lang_root()
    return cell_run_with_roots(domain, verb_canonical, roots)
}
