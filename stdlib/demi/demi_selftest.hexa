    let g_c_xdisc = "compose xdisc — 교차 · 구성형 · 결합\n"
        + "  구성 도메인 (2):\n"
        + "    root → xdisc\n"
        + "  성격: physical · bio · engineering\n"
    fails = fails + _cell("compose/cross-discipline", entry, swift_bin, cmpenv,
                          "compose xdisc", g_c_xdisc, 0)

    // unknown domain — no INDEX.demi record → synthetic node (label==key, scale
    // system → 메타(통합)), empty closure → stack 0 "(none)", empty 성격, rc 0.
    let g_c_unknown = "compose zzznope — zzznope · 메타(통합)\n"
        + "  구성 도메인 (0):\n"
        + "    (none)\n"
        + "  성격: \n"
    fails = fails + _cell("compose/unknown", entry, swift_bin, cmpenv,
