    // root→mid→apex (Kahn + alpha tie-break); 성격 physical·engineering·propulsion.
    let g_c_meta = "compose apex — 꼭대기 · 메타(통합)\n"
        + "  구성 도메인 (3):\n"
        + "    root → mid → apex\n"
