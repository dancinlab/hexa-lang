// @ci_gate — demiurge-cli PARITY SMOKE (hexa-native ⇄ Swift reference)
//
// demi_selftest.hexa — per-verb parity gate for the pure hexa-native
// `demiurge cli` migration (demi-cli-pure-hexa-native · plan @L7). For each
// registered PARITY CELL it runs BOTH surfaces and asserts:
//   (1) stdout+stderr byte-identical, AND
//   (2) exit codes equal.
// This is the @ci_gate that plan @L2 requires ALL-GREEN before any Swift
// deletion. A cell whose hexa handler is not yet ported is NOT registered
// here (a stub-only verb has no parity claim — @L7 honesty: never assert a
// green parity for an unported handler).
//
// Run:  hexa run --no-sentinel stdlib/demi/demi_selftest.hexa
//   - DEMI_HEXA_ENTRY  (default "stdlib/demi/demi_cli.hexa")
//   - DEMI_SWIFT_BIN   the built Swift DemiurgeCLI. If unset/missing, the
//                      Swift side is SKIPPED and only the hexa side's exit
//                      code + a GOLDEN expected-output string is checked
//                      (so the gate still runs network-free in CI without a
//                      Swift toolchain — the GOLDEN strings were captured
//                      byte-for-byte from the Swift reference 2026-06-03).
// PASS line: "demi_parity_selftest PASS".
//
// FOUNDATION+PROOF cells (LIVE, byte-matched against Swift this PR):
//   - discover (no objective)        → usage line, exit 2
//   - discover <obj> (no phanes)     → not-found block, exit 2
//   - action <unknown verb>          → unknown-verb stderr, exit 2
// Remaining verbs register their cells as they are ported (stacked PRs).

use "stdlib/demi/dispatch.hexa"

fn _shq2(s: string) -> string {
    let mut out = "'"
    let mut i = 0
    while i < len(s) {
        let c = s.substring(i, i + 1)
        if c == "'" { out = out + "'\\''" } else { out = out + c }
        i = i + 1
    }
    return out + "'"
}

// Run the hexa CLI entry with `argv_str` (a pre-quoted argv tail) under a
// fixed env, capturing merged stdout+stderr and the exit code.
fn _run_hexa(entry: string, env_prefix: string, argv_str: string) -> [string] {
    let hexa = exec("command -v hexa 2>/dev/null || echo hexa").trim()
    let cmd = env_prefix + " " + _shq2(hexa) + " run " + _shq2(entry) + " " + argv_str + " 2>&1"
    let pair = exec_with_status(cmd)
    return [to_string(pair[0]), to_string(pair[1])]
}

// _make_phanes_stub(path) — write a deterministic phanes stub binary at
// `path` and chmod +x it. The stub echoes the exact argv it was spawned with
// and exits with a fixed non-zero code, so a parity cell can assert the LIVE
// `discover` forwarding (argv passed VERBATIM + child exit code propagated)
// against BOTH surfaces machine-independently — no real phanes needed. Swift
// spawns `phanes discover <args>`; hexa forwards `discover <post...>`; both
// land on this stub identically, so the echoed argv is the byte-golden.
fn _make_phanes_stub(path: string) {
    let body = "#!/bin/sh\necho \"[phanes-stub] argv: $*\"\nexit 7\n"
    exec("printf %s " + _shq2(body) + " > " + _shq2(path) + " && chmod +x " + _shq2(path))
}

// _make_verify_fixture(repo) — build a deterministic exports/ tree under `repo`
// (which becomes DEMIURGE_REPO) for the bare `verify <path|id>` parity cells
// (PR-verify-record). Two F1F2 records:
//   FIXTURE_OK     — all provenance fields present · clean rationale · GATE_OPEN
//                    → all 6 checks [OK], rc 0.
//   FIXTURE_REJECT — verdict claims "absorbed" but gate=GATE_OPEN
//                    → REJECTED stderr line + the consistency [FAIL], rc 1.
// `repo` MUST be a non-symlinked real path (Foundation .standardizedFileURL does
// NOT resolve symlinks; a /tmp → /private/tmp symlink makes exportsRoot and the
// arg disagree). The caller passes a $HOME-rooted path for this reason.
fn _make_verify_fixture(repo: string) {
    let rdir = repo + "/exports/chip/noc/f1f2/records"
    exec("rm -rf " + _shq2(repo) + " && mkdir -p " + _shq2(rdir))
    let ok = "{\n"
        + "  \"interface\": \"hexa-arch:chip:noc:F1F2-record\",\n"
        + "  \"schema_version\": \"1.0\",\n"
        + "  \"record_id\": \"FIXTURE_OK\",\n"
        + "  \"produced_at_utc\": \"2026-06-03T00:00:00Z\",\n"
        + "  \"topology\": { \"kind\": \"mesh_2d\", \"degree\": 4, \"node_count\": 64, \"routing\": \"min\" },\n"
        + "  \"traffic\": \"tornado\",\n"
        + "  \"verdict\": { \"f1\": \"INCONCLUSIVE\", \"f2\": \"INCONCLUSIVE\", \"rationale\": \"single-topology fixture record for the demi verify selftest cell\" },\n"
        + "  \"provenance\": {\n"
        + "    \"absorbed\": false, \"measurement_gate\": \"GATE_OPEN\",\n"
        + "    \"sim_engine\": \"fixture_engine\", \"sim_commit_hash\": \"deadbeef\",\n"
        + "    \"gate_failures\": [], \"consumer_target\": \"demi:selftest\",\n"
        + "    \"atlas_cite_block\": \"@cite fixture\", \"scope_caveats\": []\n"
        + "  }\n"
        + "}\n"
    let reject = "{\n"
        + "  \"interface\": \"hexa-arch:chip:noc:F1F2-record\",\n"
        + "  \"schema_version\": \"1.0\",\n"
        + "  \"record_id\": \"FIXTURE_REJECT\",\n"
        + "  \"produced_at_utc\": \"2026-06-03T00:00:00Z\",\n"
        + "  \"topology\": { \"kind\": \"mesh_2d\", \"degree\": 4, \"node_count\": 64, \"routing\": \"min\" },\n"
        + "  \"traffic\": \"tornado\",\n"
        + "  \"verdict\": { \"f1\": \"ABSORBED\", \"f2\": \"PASS\", \"rationale\": \"absorbed claim with an open gate\" },\n"
        + "  \"provenance\": {\n"
        + "    \"absorbed\": true, \"measurement_gate\": \"GATE_OPEN\",\n"
        + "    \"sim_engine\": \"fixture_engine\", \"sim_commit_hash\": \"deadbeef\",\n"
        + "    \"gate_failures\": [], \"consumer_target\": \"demi:selftest\",\n"
        + "    \"atlas_cite_block\": \"@cite fixture\", \"scope_caveats\": []\n"
        + "  }\n"
        + "}\n"
    exec("printf %s " + _shq2(ok) + " > " + _shq2(rdir + "/fixture_ok.json"))
    exec("printf %s " + _shq2(reject) + " > " + _shq2(rdir + "/fixture_reject.json"))
}

// _make_list_fixture(repo) — a deterministic project tree under `repo`
// (DEMIURGE_REPO) for the PR#6 list-* parity cells. Exercises EVERY ordering /
// dedup / pad / pointer branch of ArtifactRegistry:
//   2 F1F2 records (aaa,bbb) → load-index $R1/$R2 sorted by filename.
//   design.md with Decisions 3,1,10 + a dup 1 → numeric-sort 1,3,10 + dedup.
//   proposals/rfc_002_*, rfc_011_* (+ a non-rfc) → $RFC002/$RFC011, full stem.
//   domains/{chip,aaa-domain}.md + README (excluded) + matter/README pointer.
fn _make_list_fixture(repo: string) {
    let rdir = repo + "/exports/chip/noc/f1f2/records"
    exec("rm -rf " + _shq2(repo)
         + " && mkdir -p " + _shq2(rdir)
         + " " + _shq2(repo + "/proposals")
         + " " + _shq2(repo + "/domains/matter"))
    // minimal-but-decodable F1F2 records (only record_id is read for the title-
    // from-filename list view; the loader's decode guard needs record_id).
    let rec = "{\"interface\":\"i\",\"schema_version\":\"1.0\",\"record_id\":\"X\","
        + "\"produced_at_utc\":\"2026-01-01T00:00:00Z\",\"topology\":{\"kind\":\"k\","
        + "\"degree\":4,\"node_count\":64,\"routing\":\"min\"},\"traffic\":\"t\","
        + "\"verdict\":{\"f1\":\"a\",\"f2\":\"b\",\"rationale\":\"r\"},"
        + "\"provenance\":{\"absorbed\":false,\"measurement_gate\":\"GATE_OPEN\","
        + "\"sim_engine\":\"e\",\"sim_commit_hash\":\"abc\",\"gate_failures\":[],"
        + "\"consumer_target\":\"c\",\"atlas_cite_block\":\"a\",\"scope_caveats\":[]}}\n"
    exec("printf %s " + _shq2(rec) + " > " + _shq2(rdir + "/aaa.json"))
    exec("printf %s " + _shq2(rec) + " > " + _shq2(rdir + "/bbb.json"))
    // design.md — Decisions out of order + a duplicate number (dedup, first wins).
    let design = "# Design\n\n"
        + "### Decision 3 — third thing\nbody\n\n"
        + "### Decision 1 — first thing\nbody\n\n"
        + "### Decision 10 — tenth thing\nbody\n\n"
        + "### Decision 1 — dup first should be deduped\nbody\n"
    exec("printf %s " + _shq2(design) + " > " + _shq2(repo + "/design.md"))
    // proposals — two rfc_*.md (different number widths) + one non-rfc.
    exec("printf %s " + _shq2("rfc\n") + " > " + _shq2(repo + "/proposals/rfc_002_beta.md"))
    exec("printf %s " + _shq2("rfc\n") + " > " + _shq2(repo + "/proposals/rfc_011_alpha.md"))
    exec("printf %s " + _shq2("notes\n") + " > " + _shq2(repo + "/proposals/notes.md"))
    // domains — two .md + README (excluded) + the matter/README pointer (D17).
    exec("printf %s " + _shq2("d\n") + " > " + _shq2(repo + "/domains/chip.md"))
    exec("printf %s " + _shq2("d\n") + " > " + _shq2(repo + "/domains/aaa-domain.md"))
    exec("printf %s " + _shq2("readme\n") + " > " + _shq2(repo + "/domains/README.md"))
    exec("printf %s " + _shq2("m\n") + " > " + _shq2(repo + "/domains/matter/README.md"))
}

// _make_list_empty(repo) — an empty project tree: only the (empty) records dir
// exists, no design.md / proposals / top-level domains. Every kind → "(0):".
fn _make_list_empty(repo: string) {
    exec("rm -rf " + _shq2(repo)
         + " && mkdir -p " + _shq2(repo + "/exports/chip/noc/f1f2/records"))
}

// _make_show_fixture(repo) — a deterministic exports/ tree under `repo`
// (DEMIURGE_REPO) for the PR#7 `show <path>` parity cells. One fully-populated
// F1F2 record exercising EVERY render branch of the Swift `show`:
//   - non-empty topology (int degree/node_count) · verdict · all provenance
//     scalar fields · a sim_commit_hash > 12 chars (so the `.prefix(12)` trim
//     is asserted) · TWO gate_failures + TWO scope_caveats (the `  [i] <v>`
//     rows + the counts). $HOME-rooted (non-symlinked) so the canonical-path
//     error lines stay machine-independent (lexical-canon · see RecordLoader).
//   + a `bad.json` of non-JSON text for the decode-failure LIVE cell.
fn _make_show_fixture(repo: string) {
    let rdir = repo + "/exports/chip/noc/f1f2/records"
    exec("rm -rf " + _shq2(repo) + " && mkdir -p " + _shq2(rdir))
    let rec = "{\n"
        + "  \"interface\": \"hexa-arch:chip:noc:F1F2-record\",\n"
        + "  \"schema_version\": \"1.0\",\n"
        + "  \"record_id\": \"SHOW_OK\",\n"
        + "  \"produced_at_utc\": \"2026-06-03T00:00:00Z\",\n"
        + "  \"topology\": { \"kind\": \"mesh_2d\", \"degree\": 4, \"node_count\": 64, \"routing\": \"min\" },\n"
        + "  \"traffic\": \"tornado\",\n"
        + "  \"verdict\": { \"f1\": \"INCONCLUSIVE\", \"f2\": \"INCONCLUSIVE\", \"rationale\": \"single-topology fixture record for the demi show selftest cell\" },\n"
        + "  \"provenance\": {\n"
        + "    \"absorbed\": false, \"measurement_gate\": \"GATE_CLOSED_MEASURED\",\n"
        + "    \"sim_engine\": \"fixture_engine\", \"sim_commit_hash\": \"deadbeefcafe1234567890\",\n"
        + "    \"gate_failures\": [\"gf-alpha\", \"gf-beta\"], \"consumer_target\": \"demi:selftest\",\n"
        + "    \"atlas_cite_block\": \"@cite fixture\", \"scope_caveats\": [\"caveat-one\", \"caveat-two\"]\n"
        + "  }\n"
        + "}\n"
    exec("printf %s " + _shq2(rec) + " > " + _shq2(rdir + "/show_ok.json"))
    exec("printf %s " + _shq2("not json at all") + " > " + _shq2(rdir + "/bad.json"))
}

fn _run_swift(bin: string, env_prefix: string, argv_str: string) -> [string] {
    let cmd = env_prefix + " " + _shq2(bin) + " " + argv_str + " 2>&1"
    let pair = exec_with_status(cmd)
    return [to_string(pair[0]), to_string(pair[1])]
}

// _cell_live_only — a parity cell whose Swift output is NOT deterministically
// golden-able (e.g. a Foundation decode error whose tail is locale/machine-
// dependent). It asserts the hexa exit code unconditionally, and the BYTE
// equivalence ONLY when DEMI_SWIFT_BIN is present (the live Swift binary is the
// reference). Without the Swift bin it asserts the hexa rc + a `prefix` the
// output must START with (the deterministic head, e.g. "show: Decode failed (")
// — never a fabricated full golden (@L7).
fn _cell_live_only(name: string, entry: string, swift_bin: string,
                   env_prefix: string, argv_str: string,
                   prefix: string, want_rc: int) -> int {
    let hx = _run_hexa(entry, env_prefix, argv_str)
    let hx_out = hx[0]
    let hx_rc = _atoi2(hx[1])
    if hx_rc != want_rc {
        println("FAIL " + name + " — hexa rc=" + to_string(hx_rc) + " want " + to_string(want_rc))
        return 1
    }
    // The hexa output's deterministic HEAD must equal `prefix` (the demi-owned
    // portion: `show: Decode failed (<path>)`). The trailing Foundation
    // decode-error sentence is environment-OWNED (locale / OS version), NOT part
    // of demi's parity contract — verify_record's decode case omits a cell for
    // the same reason (@L7: never assert byte-equality of a string demi cannot
    // faithfully reproduce). So both arms assert demi's head + the exit code.
    let hx_head = if len(hx_out) >= len(prefix) { hx_out.substring(0, len(prefix)) } else { hx_out }
    if hx_head != prefix {
        println("FAIL " + name + " — hexa output does not start with the expected prefix")
        println("  --- prefix ---"); println(prefix)
        println("  --- hexa   ---"); println(hx_out)
        return 1
    }
    if len(swift_bin) > 0 {
        // Live cross-check: the Swift reference's head + exit code must agree
        // with hexa's (the demi-owned portion is byte-identical; the Foundation
        // tail beyond `prefix` is out of scope, asserted on neither side).
        let sw = _run_swift(swift_bin, env_prefix, argv_str)
        let sw_out = sw[0]
        let sw_rc = _atoi2(sw[1])
        let sw_head = if len(sw_out) >= len(prefix) { sw_out.substring(0, len(prefix)) } else { sw_out }
        if sw_head != prefix {
            println("FAIL " + name + " — Swift output does not start with the expected prefix")
            println("  --- prefix ---"); println(prefix)
            println("  --- swift  ---"); println(sw_out)
            return 1
        }
        if sw_rc != hx_rc {
            println("FAIL " + name + " — rc swift=" + to_string(sw_rc) + " hexa=" + to_string(hx_rc))
            return 1
        }
        println("PASS " + name + " (head ≡ Swift · rc=" + to_string(hx_rc) + " · Foundation tail env-owned)")
        return 0
    }
    println("PASS " + name + " (head ≡ golden · rc=" + to_string(hx_rc) + " · Foundation tail env-owned)")
    return 0
}

// One parity cell. `argv` is the demiurge-cli argv tail; `env_prefix` is a
// shell env assignment string applied to BOTH surfaces; `golden` is the
// byte-for-byte expected merged output (used when no Swift bin is present);
// `want_rc` is the expected exit code.
fn _cell(name: string, entry: string, swift_bin: string,
         env_prefix: string, argv_str: string,
         golden: string, want_rc: int) -> int {
    let hx = _run_hexa(entry, env_prefix, argv_str)
    let hx_out = hx[0]
    let hx_rc = _atoi2(hx[1])

    // (1) hexa exit code
    if hx_rc != want_rc {
        println("FAIL " + name + " — hexa rc=" + to_string(hx_rc) + " want " + to_string(want_rc))
        return 1
    }

    if len(swift_bin) > 0 {
        // Live cross-check against the Swift reference (the strongest gate).
        let sw = _run_swift(swift_bin, env_prefix, argv_str)
        let sw_out = sw[0]
        let sw_rc = _atoi2(sw[1])
        if sw_out != hx_out {
            println("FAIL " + name + " — output DIFFERS from Swift")
            println("  --- swift ---"); println(sw_out)
            println("  --- hexa  ---"); println(hx_out)
            return 1
        }
        if sw_rc != hx_rc {
            println("FAIL " + name + " — rc swift=" + to_string(sw_rc) + " hexa=" + to_string(hx_rc))
            return 1
        }
        println("PASS " + name + " (byte ≡ Swift · rc=" + to_string(hx_rc) + ")")
        return 0
    }

    // No Swift bin — fall back to the GOLDEN string captured from Swift.
    if hx_out != golden {
        println("FAIL " + name + " — output DIFFERS from golden")
        println("  --- golden ---"); println(golden)
        println("  --- hexa   ---"); println(hx_out)
        return 1
    }
    println("PASS " + name + " (byte ≡ golden · rc=" + to_string(hx_rc) + ")")
    return 0
}

// _cell_passthrough — a parity cell for a VERBATIM-FORWARD verb (PR-verify-
// passthrough). demi `verify --expr|--fence|rubric` forwards to the hexa
// verify KERNEL, which is the SAME binary Swift's verifyHexa forwards to. So
// the golden is computed LIVE from `hexa verify <args>` (the kernel SSOT) —
// no brittle hardcoded multi-line string, and the cell asserts demi's output
// is byte-identical + rc-identical to a direct kernel call. When DEMI_SWIFT_BIN
// is present the standard live cross-check still runs too (via the inner
// `verify_argv` that the Swift CLI maps through verifyHexa identically).
// `verify_argv` is the post-verb tail (e.g. "--fence '1+1==2'").
fn _cell_passthrough(name: string, entry: string, swift_bin: string,
                     verify_argv: string) -> int {
    let hexa = exec("command -v hexa 2>/dev/null || echo hexa").trim()
    // golden = a direct kernel call (what Swift verifyHexa forwards to).
    let kpair = exec_with_status(_shq2(hexa) + " verify " + verify_argv + " 2>&1")
    let golden = to_string(kpair[0])
    let want_rc = kpair[1]
    // demi side: `<hexa> run <entry> verify <verify_argv>`.
    return _cell(name, entry, swift_bin, "", "verify " + verify_argv,
                 golden, want_rc)
}

fn _atoi2(s: string) -> int {
    let t = s.trim()
    if len(t) == 0 { return 0 }
    let mut n = 0
    let mut i = 0
    while i < len(t) {
        let d = ord(t.substring(i, i + 1)) - 48
        if d < 0 { return -1 }
        if d > 9 { return -1 }
        n = n * 10 + d
        i = i + 1
    }
    return n
}

fn main() {
    let entry = if len(env("DEMI_HEXA_ENTRY")) > 0 { env("DEMI_HEXA_ENTRY") } else { "stdlib/demi/demi_cli.hexa" }
    let swift_bin_env = env("DEMI_SWIFT_BIN")
    // verify the swift bin is actually executable; else fall to golden mode.
    let mut swift_bin = ""
    if len(swift_bin_env) > 0 {
        let ok = exec("test -x " + _shq2(swift_bin_env) + " && echo yes || echo no").trim()
        if ok == "yes" { swift_bin = swift_bin_env }
    }
    if len(swift_bin) > 0 {
        println("demi_parity_selftest — LIVE Swift cross-check (" + swift_bin + ")")
    } else {
        println("demi_parity_selftest — GOLDEN mode (no DEMI_SWIFT_BIN; strings captured from Swift 2026-06-03)")
    }

    let mut fails = 0
    // Pin ONLY PHANES_BIN — overriding HOME would break the nested `hexa run`
    // (it needs the real HOME for its build cache). The HOME-dependent tail of
    // the `searched:` line is computed dynamically below from env("HOME") so
    // the golden stays correct on any machine.
    let nf_env = "PHANES_BIN=/demi-selftest-nonexistent"
    let home = env("HOME")

    // GOLDEN strings — the framing captured byte-for-byte from the Swift
    // DemiurgeCLI on 2026-06-03; the one machine-dependent token (the
    // $HOME/core/phanes path) is interpolated from the live HOME.
    let g_disc_usage = "discover: usage — discover <objective> [--verifier <path>] [--rounds N] [--json]\n"
    let g_disc_nf = "discover: phanes CLI not found.\n"
        + "  searched: /demi-selftest-nonexistent, /usr/local/bin/phanes, /opt/homebrew/bin/phanes, " + home + "/core/phanes/bin/phanes\n"
        + "  set PHANES_BIN env var to override.\n"
        + "  contract expected (phanes-side):\n"
        + "    phanes discover <objective> [--verifier <path>] [--rounds N] [--json]\n"
        + "  phanes owns the OUROBOROS loop; demiurge dispatches only (d3/d4).\n"
        + "  see ~/core/phanes/INBOX.log.md for the CLI surface request.\n"
    let g_act_unknown = "action: unknown verb 'zzz' — try one of specify/structure/design/analyze/synthesize/verify/handoff\n"

    // discover LIVE-forward golden (PR-discover-live): with PHANES_BIN pointing
    // at the stub, BOTH surfaces spawn `phanes discover <args>` → the stub
    // echoes the exact argv and exits 7. This asserts that demi forwards the
    // objective + flags VERBATIM and propagates the child's exit code — the
    // happy path the not-found cell cannot reach.
    let stub_phanes = "/tmp/.demi-selftest-phanes-stub"
    _make_phanes_stub(stub_phanes)
    let live_env = "PHANES_BIN=" + stub_phanes
    let g_disc_live = "[phanes-stub] argv: discover high-Tc hydride --rounds 3\n"

    // ── PROOF cells ──────────────────────────────────────────────────
    fails = fails + _cell("discover/usage", entry, swift_bin, nf_env, "discover",
                          g_disc_usage, 2)
    fails = fails + _cell("discover/phanes-not-found", entry, swift_bin, nf_env,
                          "discover " + _shq2("high-Tc hydride"), g_disc_nf, 2)
    // PR-discover-live — LIVE phanes forwarding (argv verbatim + rc propagated).
    fails = fails + _cell("discover/live-forward", entry, swift_bin, live_env,
                          "discover " + _shq2("high-Tc hydride") + " --rounds 3",
                          g_disc_live, 7)
    fails = fails + _cell("action/unknown-verb", entry, swift_bin, "",
                          "action zzz", g_act_unknown, 2)

    // PR-verify-passthrough — `verify --expr|--fence|rubric` → hexa verify
    // kernel, output forwarded VERBATIM (Swift verifyHexa · @D g5). Golden
    // is the live kernel call (the SSOT both surfaces forward to).
    fails = fails + _cell_passthrough("verify/fence", entry, swift_bin,
                                      "--fence " + _shq2("1+1==2"))
    fails = fails + _cell_passthrough("verify/expr", entry, swift_bin,
                                      "--expr add 2 4")
    fails = fails + _cell_passthrough("verify/rubric", entry, swift_bin,
                                      "rubric")

    // ── PR-verify-record cells — bare `verify <path|id>` local record check.
    // A $HOME-rooted (non-symlinked) fixture repo keeps the canonical-path
    // goldens machine-independent (see _make_verify_fixture). DEMIURGE_REPO is
    // applied to BOTH surfaces via env_prefix, so exportsRoot resolves to the
    // fixture on both the hexa and (when present) Swift sides.
    let vfix = home + "/.demi-selftest-verify-fixture"
    _make_verify_fixture(vfix)
    let vroot = vfix + "/exports/chip/noc/f1f2/records"
    let venv = "DEMIURGE_REPO=" + _shq2(vfix)

    // valid record BY PATH → 6 [OK] lines, rc 0.
    let g_v_ok = "[OK]   recordId\n"
        + "[OK]   provenance.simEngine non-empty\n"
        + "[OK]   provenance.simCommitHash non-empty\n"
        + "[OK]   provenance.consumerTarget non-empty\n"
        + "[OK]   provenance.atlasCiteBlock non-empty\n"
        + "[OK]   verdict claim vs gate consistent\n"
    fails = fails + _cell("verify/record-ok-path", entry, swift_bin, venv,
                          "verify " + _shq2(vroot + "/fixture_ok.json"),
                          g_v_ok, 0)
    // valid record BY ID → resolveRecord scans the records dir, same 6 [OK].
    fails = fails + _cell("verify/record-ok-id", entry, swift_bin, venv,
                          "verify FIXTURE_OK", g_v_ok, 0)

    // inconsistent record → REJECTED stderr line FIRST (merged-output order),
    // then 5 [OK] + the consistency [FAIL], rc 1.
    let g_v_reject = "verify: REJECTED — record inconsistent (rfc_011 §4.2 / @F f6)\n"
        + "[OK]   recordId\n"
        + "[OK]   provenance.simEngine non-empty\n"
        + "[OK]   provenance.simCommitHash non-empty\n"
        + "[OK]   provenance.consumerTarget non-empty\n"
        + "[OK]   provenance.atlasCiteBlock non-empty\n"
        + "[FAIL] verdict claim vs gate consistent — verdict asserts a measurement but gate = GATE_OPEN\n"
    fails = fails + _cell("verify/record-reject", entry, swift_bin, venv,
                          "verify FIXTURE_REJECT", g_v_reject, 1)

    // missing path UNDER exports → fileNotFound (canonical path), rc 1.
    let g_v_missing = "verify: Record file not found: " + vroot + "/MISSING.json\n"
    fails = fails + _cell("verify/record-missing", entry, swift_bin, venv,
                          "verify " + _shq2(vroot + "/MISSING.json"),
                          g_v_missing, 1)

    // path OUTSIDE exports (invariant a) → pathOutsideExports (canonical), rc 1.
    let g_v_outside = "verify: Refused (@D g_cockpit_isolation invariant a): path is outside ../exports/**: " + vfix + "/outside.json\n"
    fails = fails + _cell("verify/record-outside", entry, swift_bin, venv,
                          "verify " + _shq2(vfix + "/outside.json"),
                          g_v_outside, 1)

    // ── PR-atlas-refusal cells — owner-gated atlas WRITE refusal (Swift
    // atlasCmd · main.swift:688-711). Three cases:
    //   (1) READ subverb (no owner)        → forwards to `hexa atlas` verbatim.
    //   (2) WRITE subverb without owner     → REFUSED (stderr + exit 2, no fwd).
    //   (3) WRITE subverb WITH DEMIURGE_OWNER → forwards to `hexa atlas` verbatim.
    // The (1)/(3) passthrough goldens are computed LIVE from the same `hexa atlas`
    // kernel both surfaces forward to (no brittle hardcoded atlas output); the
    // (2) refusal golden is the byte-exact Swift refusal string. atlas READ verbs
    // need no DEMIURGE_REPO (they read the embedded atlas SSOT), so env is bare
    // except DEMIURGE_OWNER on case (3).
    let hexa_bin = exec("command -v hexa 2>/dev/null || echo hexa").trim()

    // (1) READ passthrough — `atlas lookup` (no args) → hexa atlas usage, rc 0.
    let r_read = exec_with_status(_shq2(hexa_bin) + " atlas lookup 2>&1")
    let g_atlas_read = to_string(r_read[0])
    fails = fails + _cell("atlas/read-passthrough", entry, swift_bin, "",
                          "atlas lookup", g_atlas_read, r_read[1])

    // (2) WRITE without owner → REFUSED (no forward). Byte-exact Swift stderr.
    let g_atlas_refuse = "atlas: 'register' = owner op (사장실 · M20). Set DEMIURGE_OWNER "
        + "to unlock. External read-only: lookup/stats/hash/dump.\n"
    fails = fails + _cell("atlas/write-refused-no-owner", entry, swift_bin, "",
                          "atlas register", g_atlas_refuse, 2)

    // (3) WRITE WITH owner → gate passes, forwards `hexa atlas register` (no
    // discovery-arm args) → hexa atlas register usage, rc 3. Golden = live
    // kernel call (the SSOT both surfaces forward to once unlocked).
    let r_owner = exec_with_status(_shq2(hexa_bin) + " atlas register 2>&1")
    let g_atlas_owner = to_string(r_owner[0])
    fails = fails + _cell("atlas/write-owner-passthrough", entry, swift_bin,
                          "DEMIURGE_OWNER=1", "atlas register",
                          g_atlas_owner, r_owner[1])

    // ── PR#6 list-* cells — `list-records|list-decisions|list-rfcs|
    // list-domains|list-all` rendered from the #5 RecordLoader/ArtifactRegistry
    // (rl_stubs). DEMIURGE_REPO is applied to BOTH surfaces via env_prefix so
    // exportsRoot+projectRoot resolve to the SAME fixture tree; the list output
    // carries no absolute paths, so the goldens are machine-independent. Each
    // verb has a POPULATED cell (sort/dedup/pad/pointer) + an EMPTY cell
    // (`<header> (0):`). Goldens captured byte-for-byte from the Swift
    // DemiurgeCLI reference (cockpit .build/debug · 2026-06-04).
    let lfix = home + "/.demi-selftest-list-fixture"
    _make_list_fixture(lfix)
    let lenv = "DEMIURGE_REPO=" + _shq2(lfix)
    let lempty = home + "/.demi-selftest-list-empty"
    _make_list_empty(lempty)
    let lenv0 = "DEMIURGE_REPO=" + _shq2(lempty)

    // list-records (populated) — $R1/$R2 sorted by filename, padded.
    let g_l_records = "Records (2):\n"
        + "  $R1  aaa\n"
        + "  $R2  bbb\n"
    fails = fails + _cell("list-records/populated", entry, swift_bin, lenv,
                          "list-records", g_l_records, 0)
    // list-decisions (populated) — numeric sort 1,3,10 · dup deduped · pad to $D10.
    let g_l_decisions = "Decisions (3):\n"
        + "  $D1   D1 — first thing\n"
        + "  $D3   D3 — third thing\n"
        + "  $D10  D10 — tenth thing\n"
    fails = fails + _cell("list-decisions/populated", entry, swift_bin, lenv,
                          "list-decisions", g_l_decisions, 0)
    // list-rfcs (populated) — key = 2nd `_`-field, title = full stem, pad equal.
    let g_l_rfcs = "RFCs (2):\n"
        + "  $RFC002  rfc_002_beta\n"
        + "  $RFC011  rfc_011_alpha\n"
    fails = fails + _cell("list-rfcs/populated", entry, swift_bin, lenv,
                          "list-rfcs", g_l_rfcs, 0)
    // list-domains (populated) — README excluded · matter pointer · sort by key.
    let g_l_domains = "Domains (3):\n"
        + "  $DOM:aaa-domain  aaa-domain\n"
        + "  $DOM:chip        chip\n"
        + "  $DOM:matter      matter (pointer — D17 hexa-lang absorbed)\n"
    fails = fails + _cell("list-domains/populated", entry, swift_bin, lenv,
                          "list-domains", g_l_domains, 0)
    // list-all (populated) — all four kinds in allCases order, blank-line after
    // each (so a trailing blank line ends the output).
    let g_l_all = g_l_records + "\n" + g_l_decisions + "\n"
        + g_l_rfcs + "\n" + g_l_domains + "\n"
    fails = fails + _cell("list-all/populated", entry, swift_bin, lenv,
                          "list-all", g_l_all, 0)

    // EMPTY cells — empty project tree → `<header> (0):` for each kind, rc 0.
    fails = fails + _cell("list-records/empty", entry, swift_bin, lenv0,
                          "list-records", "Records (0):\n", 0)
    fails = fails + _cell("list-decisions/empty", entry, swift_bin, lenv0,
                          "list-decisions", "Decisions (0):\n", 0)
    fails = fails + _cell("list-rfcs/empty", entry, swift_bin, lenv0,
                          "list-rfcs", "RFCs (0):\n", 0)
    fails = fails + _cell("list-domains/empty", entry, swift_bin, lenv0,
                          "list-domains", "Domains (0):\n", 0)
    let g_l_all_empty = "Records (0):\n\nDecisions (0):\n\nRFCs (0):\n\nDomains (0):\n\n"
    fails = fails + _cell("list-all/empty", entry, swift_bin, lenv0,
                          "list-all", g_l_all_empty, 0)

    // ── PR#7 show cells — `show <path>` record + provenance dump. Reads via
    // the #5 RecordLoader (load-by-path · invariant-(a) guard). DEMIURGE_REPO
    // is applied to BOTH surfaces so exportsRoot resolves to the SAME $HOME-
    // rooted fixture (canonical-path error lines machine-independent). Goldens
    // captured byte-for-byte from the Swift DemiurgeCLI reference 2026-06-04.
    let sfix = home + "/.demi-selftest-show-fixture"
    _make_show_fixture(sfix)
    let sroot = sfix + "/exports/chip/noc/f1f2/records"
    let senv = "DEMIURGE_REPO=" + _shq2(sfix)

    // valid record — every field in Swift order/spacing; sim_commit trimmed to
    // 12 chars; 2 gate_failures + 2 scope_caveats with their `  [i] <v>` rows.
    let g_s_ok = "record_id:                  SHOW_OK\n"
        + "interface:                  hexa-arch:chip:noc:F1F2-record\n"
        + "schema_version:             1.0\n"
        + "produced_at_utc:            2026-06-03T00:00:00Z\n"
        + "topology.kind:              mesh_2d\n"
        + "topology.degree:            4\n"
        + "topology.node_count:        64\n"
        + "topology.routing:           min\n"
        + "traffic:                    tornado\n"
        + "verdict.f1:                 INCONCLUSIVE\n"
        + "verdict.f2:                 INCONCLUSIVE\n"
        + "verdict.rationale:          single-topology fixture record for the demi show selftest cell\n"
        + "provenance.measurement_gate:GATE_CLOSED_MEASURED\n"
        + "provenance.absorbed:        false\n"
        + "provenance.sim_engine:      fixture_engine\n"
        + "provenance.sim_commit:      deadbeefcafe\n"
        + "provenance.consumer_target: demi:selftest\n"
        + "provenance.atlas_cite:      @cite fixture\n"
        + "provenance.gate_failures:   2\n"
        + "  [0] gf-alpha\n"
        + "  [1] gf-beta\n"
        + "provenance.scope_caveats:   2\n"
        + "  [0] caveat-one\n"
        + "  [1] caveat-two\n"
    fails = fails + _cell("show/record-ok", entry, swift_bin, senv,
                          "show " + _shq2(sroot + "/show_ok.json"), g_s_ok, 0)

    // path OUTSIDE exports (invariant a) → `show: Refused …` (canonical), rc 2.
    let g_s_outside = "show: Refused (@D g_cockpit_isolation invariant a): path is outside ../exports/**: " + sfix + "/outside.json\n"
    fails = fails + _cell("show/outside", entry, swift_bin, senv,
                          "show " + _shq2(sfix + "/outside.json"), g_s_outside, 2)

    // missing path UNDER exports → `show: Record file not found:` (canon), rc 2.
    let g_s_missing = "show: Record file not found: " + sroot + "/MISSING.json\n"
    fails = fails + _cell("show/missing", entry, swift_bin, senv,
                          "show " + _shq2(sroot + "/MISSING.json"), g_s_missing, 2)

    // unparseable file UNDER exports → `show: Decode failed (<path>): <tail>`,
    // rc 2. The Foundation decode-error tail is locale/machine-dependent so this
    // is a LIVE-only cell (byte-≡ Swift when DEMI_SWIFT_BIN present; else the
    // deterministic head prefix is asserted — never a fabricated full golden).
    let g_s_decode_head = "show: Decode failed (" + sroot + "/bad.json)"
    fails = fails + _cell_live_only("show/decode", entry, swift_bin, senv,
                          "show " + _shq2(sroot + "/bad.json"), g_s_decode_head, 2)

    // ── PR-record-loader self-check (@ci_gate · @L7 spirit) — NOT a verb-
    // parity cell (PR#5 adds NO new user-facing verb; the list-*/show/gate
    // verb parity lands in PR#6-#8). This is a FOCUSED unit-check of the
    // shared loader primitives (stdlib/demi/record_loader.hexa) that the later
    // verbs build on: enumerate-by-kind count+sort · load-by-id hit/miss ·
    // load-by-path under exports · invariant-(a) refusal for outside + `..`-
    // escape paths. It runs the loader in a CHILD `hexa run` with DEMIURGE_REPO
    // set in the child's env (the runtime's in-process setenv is a no-op, but a
    // child reads its own env at startup correctly) against the SAME $HOME-
    // rooted fixture — so the lexical-canon path guard is asserted machine-
    // independently. The probe self-asserts and emits one golden line per case
    // + an `ALL_PASS` sentinel; the parent checks the merged output + rc.
    fails = fails + _loader_selfcheck(vfix, vroot)

    if fails == 0 { println("demi_parity_selftest PASS") }
    else { println("demi_parity_selftest FAIL — " + to_string(fails) + " cell(s)") }
}

// _loader_selfcheck(vfix, vroot) — write a tiny probe entry that imports the
// record_loader and self-asserts each primitive, run it as a child with
// DEMIURGE_REPO=vfix, and assert the child's output + rc. Returns 0 on green.
fn _loader_selfcheck(vfix: string, vroot: string) -> int {
    let probe = "/tmp/.demi-selftest-loader-probe.hexa"
    let ok_path     = vroot + "/fixture_ok.json"
    let reject_path = vroot + "/fixture_reject.json"
    // The probe body. It exits 0 iff every assertion holds, printing one
    // RESULT line plus a final ALL_PASS / FAILED sentinel. Paths are baked in
    // (the parent already knows the fixture layout) so the probe needs no argv.
    let body = "import \"stdlib/demi/record_loader.hexa\"\n"
        + "fn _eq(got: string, want: string, tag: string) -> int {\n"
        + "  if got == want { println(\"ok \" + tag); return 0 }\n"
        + "  println(\"NO \" + tag + \" got=[\" + got + \"] want=[\" + want + \"]\"); return 1\n"
        + "}\n"
        + "fn main() {\n"
        + "  let mut f = 0\n"
        + "  let recs = rl_enumerate(\"f1f2\")\n"
        + "  f = f + _eq(to_string(len(recs)), \"2\", \"enumerate-count\")\n"
        + "  if len(recs) == 2 {\n"
        + "    f = f + _eq(recs[0], \"" + ok_path + "\", \"enumerate-sort0\")\n"
        + "    f = f + _eq(recs[1], \"" + reject_path + "\", \"enumerate-sort1\")\n"
        + "  } else { f = f + 2 }\n"
        + "  f = f + _eq(to_string(len(rl_enumerate(\"decision\"))), \"0\", \"enumerate-unimpl\")\n"
        + "  let byid = rl_load_by_id(\"FIXTURE_OK\")\n"
        + "  f = f + _eq(byid[0] + \"|\" + byid[1], \"ok|" + ok_path + "\", \"load-by-id\")\n"
        + "  f = f + _eq(rl_load_by_id(\"NO_SUCH_ID\")[0], \"notfound\", \"load-by-id-miss\")\n"
        + "  f = f + _eq(rl_load_by_path(\"" + ok_path + "\")[0], \"ok\", \"load-by-path\")\n"
        + "  let outside = rl_load_by_path(\"" + vfix + "/outside.json\")\n"
        + "  f = f + _eq(outside[0] + \"|\" + outside[1], \"outside|" + vfix + "/outside.json\", \"load-outside-refused\")\n"
        + "  f = f + _eq(rl_load_by_path(\"" + vroot + "/../../../../../escape.json\")[0], \"outside\", \"load-escape-refused\")\n"
        + "  if f == 0 { println(\"ALL_PASS\") } else { println(\"FAILED \" + to_string(f)); exit(1) }\n"
        + "}\n"
    exec("printf %s " + _shq2(body) + " > " + _shq2(probe))
    let hexa = exec("command -v hexa 2>/dev/null || echo hexa").trim()
    let cmd = "DEMIURGE_REPO=" + _shq2(vfix) + " " + _shq2(hexa)
        + " run --no-sentinel " + _shq2(probe) + " 2>&1"
    let pair = exec_with_status(cmd)
    let out = to_string(pair[0])
    let rc = _atoi2(pair[1])
    if rc == 0 && _ends_with_pass(out) {
        println("PASS loader/record-loader (enumerate · load-by-id · invariant-a guard)")
        return 0
    }
    println("FAIL loader/record-loader — rc=" + to_string(rc))
    println(out)
    return 1
}

// _ends_with_pass(out) — the probe's last meaningful line is ALL_PASS.
fn _ends_with_pass(out: string) -> bool {
    return rl_contains(out, "ALL_PASS")
}
