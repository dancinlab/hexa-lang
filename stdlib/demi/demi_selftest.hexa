    let shfix = home + "/.demi-selftest-shelf-fixture"
    _make_shelf_fixture(shfix)
    let shenv = "DEMIURGE_REPO=" + _shq2(shfix)

    // WITH a §6 shelf — 설계 (rawValue 2 → "3.") two groups, the 2nd `[multi]`;
    // 해석 (rawValue 3 → "4.", koreanLabel 해석⟲) one group. Verbs render in
    // rawValue order; options joined " / "; `[multi]` → " (multi)".
