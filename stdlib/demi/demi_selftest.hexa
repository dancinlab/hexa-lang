// @ci_gate — demiurge-cli PARITY SMOKE (hexa-native ⇄ Swift reference)
//
// demi_selftest.hexa — per-verb parity gate for the pure hexa-native
// `demiurge cli` migration (demi-cli-pure-hexa-native · plan @L7). For each
// registered PARITY CELL it runs BOTH surfaces and asserts:
//   (1) stdout+stderr byte-identical, AND
//   (2) exit codes equal.
// This is the @ci_gate that plan @L2 requires ALL-GREEN before any Swift
// deletion. A cell whose hexa handler is not yet ported is NOT registered
// here (a stub-only verb has no parity claim — @L7 honesty: never assert a
// green parity for an unported handler).
//
// Run:  hexa run --no-sentinel stdlib/demi/demi_selftest.hexa
//   - DEMI_HEXA_ENTRY  (default "stdlib/demi/demi_cli.hexa")
//   - DEMI_SWIFT_BIN   the built Swift DemiurgeCLI. If unset/missing, the
//                      Swift side is SKIPPED and only the hexa side's exit
//                      code + a GOLDEN expected-output string is checked
//                      (so the gate still runs network-free in CI without a
//                      Swift toolchain — the GOLDEN strings were captured
//                      byte-for-byte from the Swift reference 2026-06-03).
// PASS line: "demi_parity_selftest PASS".
//
// FOUNDATION+PROOF cells (LIVE, byte-matched against Swift this PR):
//   - discover (no objective)        → usage line, exit 2
//   - discover <obj> (no phanes)     → not-found block, exit 2
//   - action <unknown verb>          → unknown-verb stderr, exit 2
// Remaining verbs register their cells as they are ported (stacked PRs).

use "stdlib/demi/dispatch.hexa"

fn _shq2(s: string) -> string {
    let mut out = "'"
    let mut i = 0
    while i < len(s) {
        let c = s.substring(i, i + 1)
        if c == "'" { out = out + "'\\''" } else { out = out + c }
        i = i + 1
    }
    return out + "'"
}

// Run the hexa CLI entry with `argv_str` (a pre-quoted argv tail) under a
// fixed env, capturing merged stdout+stderr and the exit code.
fn _run_hexa(entry: string, env_prefix: string, argv_str: string) -> [string] {
    let hexa = exec("command -v hexa 2>/dev/null || echo hexa").trim()
    let cmd = env_prefix + " " + _shq2(hexa) + " run " + _shq2(entry) + " " + argv_str + " 2>&1"
    let pair = exec_with_status(cmd)
    return [to_string(pair[0]), to_string(pair[1])]
}

// _make_phanes_stub(path) — write a deterministic phanes stub binary at
// `path` and chmod +x it. The stub echoes the exact argv it was spawned with
// and exits with a fixed non-zero code, so a parity cell can assert the LIVE
// `discover` forwarding (argv passed VERBATIM + child exit code propagated)
// against BOTH surfaces machine-independently — no real phanes needed. Swift
// spawns `phanes discover <args>`; hexa forwards `discover <post...>`; both
// land on this stub identically, so the echoed argv is the byte-golden.
fn _make_phanes_stub(path: string) {
    let body = "#!/bin/sh\necho \"[phanes-stub] argv: $*\"\nexit 7\n"
    exec("printf %s " + _shq2(body) + " > " + _shq2(path) + " && chmod +x " + _shq2(path))
}

// _make_verify_fixture(repo) — build a deterministic exports/ tree under `repo`
// (which becomes DEMIURGE_REPO) for the bare `verify <path|id>` parity cells
// (PR-verify-record). Two F1F2 records:
//   FIXTURE_OK     — all provenance fields present · clean rationale · GATE_OPEN
//                    → all 6 checks [OK], rc 0.
//   FIXTURE_REJECT — verdict claims "absorbed" but gate=GATE_OPEN
//                    → REJECTED stderr line + the consistency [FAIL], rc 1.
// `repo` MUST be a non-symlinked real path (Foundation .standardizedFileURL does
// NOT resolve symlinks; a /tmp → /private/tmp symlink makes exportsRoot and the
// arg disagree). The caller passes a $HOME-rooted path for this reason.
fn _make_verify_fixture(repo: string) {
    let rdir = repo + "/exports/chip/noc/f1f2/records"
    exec("rm -rf " + _shq2(repo) + " && mkdir -p " + _shq2(rdir))
    let ok = "{\n"
        + "  \"interface\": \"hexa-arch:chip:noc:F1F2-record\",\n"
        + "  \"schema_version\": \"1.0\",\n"
        + "  \"record_id\": \"FIXTURE_OK\",\n"
        + "  \"produced_at_utc\": \"2026-06-03T00:00:00Z\",\n"
        + "  \"topology\": { \"kind\": \"mesh_2d\", \"degree\": 4, \"node_count\": 64, \"routing\": \"min\" },\n"
        + "  \"traffic\": \"tornado\",\n"
        + "  \"verdict\": { \"f1\": \"INCONCLUSIVE\", \"f2\": \"INCONCLUSIVE\", \"rationale\": \"single-topology fixture record for the demi verify selftest cell\" },\n"
        + "  \"provenance\": {\n"
        + "    \"absorbed\": false, \"measurement_gate\": \"GATE_OPEN\",\n"
        + "    \"sim_engine\": \"fixture_engine\", \"sim_commit_hash\": \"deadbeef\",\n"
        + "    \"gate_failures\": [], \"consumer_target\": \"demi:selftest\",\n"
        + "    \"atlas_cite_block\": \"@cite fixture\", \"scope_caveats\": []\n"
        + "  }\n"
        + "}\n"
    let reject = "{\n"
        + "  \"interface\": \"hexa-arch:chip:noc:F1F2-record\",\n"
        + "  \"schema_version\": \"1.0\",\n"
        + "  \"record_id\": \"FIXTURE_REJECT\",\n"
        + "  \"produced_at_utc\": \"2026-06-03T00:00:00Z\",\n"
        + "  \"topology\": { \"kind\": \"mesh_2d\", \"degree\": 4, \"node_count\": 64, \"routing\": \"min\" },\n"
        + "  \"traffic\": \"tornado\",\n"
        + "  \"verdict\": { \"f1\": \"ABSORBED\", \"f2\": \"PASS\", \"rationale\": \"absorbed claim with an open gate\" },\n"
        + "  \"provenance\": {\n"
        + "    \"absorbed\": true, \"measurement_gate\": \"GATE_OPEN\",\n"
        + "    \"sim_engine\": \"fixture_engine\", \"sim_commit_hash\": \"deadbeef\",\n"
        + "    \"gate_failures\": [], \"consumer_target\": \"demi:selftest\",\n"
        + "    \"atlas_cite_block\": \"@cite fixture\", \"scope_caveats\": []\n"
        + "  }\n"
        + "}\n"
    exec("printf %s " + _shq2(ok) + " > " + _shq2(rdir + "/fixture_ok.json"))
    exec("printf %s " + _shq2(reject) + " > " + _shq2(rdir + "/fixture_reject.json"))
}

// _make_cellrun_fixture(repo) — a deterministic repo with an EMPTY domains/
// dir for the PR#18 `action <verb> <domain>` cellrun parity cell. With an
// empty domains/, the requested `<domain>.demi` manifest is ALWAYS missing,
// so the cellrun engine returns rc=2 honest-skip BEFORE any dep-probe /
// substrate-resolution (those are host-dependent — python3.13 presence etc.).
// This is the byte-deterministic, host-independent cellrun parity path:
// `[cellrun] honest-skip — manifest missing: <repo>/domains/<domain>.demi`.
// `repo` MUST be a non-symlinked real path (same reason as the verify
// fixture — Swift CellrunDispatch.demiRootURL standardizes lexically, and
// rl_canon does too; a /tmp symlink would make the two disagree).
fn _make_cellrun_fixture(repo: string) {
    exec("rm -rf " + _shq2(repo) + " && mkdir -p " + _shq2(repo + "/domains"))
}

// _make_list_fixture(repo) — a deterministic project tree under `repo`
// (DEMIURGE_REPO) for the PR#6 list-* parity cells. Exercises EVERY ordering /
// dedup / pad / pointer branch of ArtifactRegistry:
//   2 F1F2 records (aaa,bbb) → load-index $R1/$R2 sorted by filename.
//   design.md with Decisions 3,1,10 + a dup 1 → numeric-sort 1,3,10 + dedup.
//   proposals/rfc_002_*, rfc_011_* (+ a non-rfc) → $RFC002/$RFC011, full stem.
//   domains/{chip,aaa-domain}.md + README (excluded) + matter/README pointer.
fn _make_list_fixture(repo: string) {
    let rdir = repo + "/exports/chip/noc/f1f2/records"
    exec("rm -rf " + _shq2(repo)
         + " && mkdir -p " + _shq2(rdir)
         + " " + _shq2(repo + "/proposals")
         + " " + _shq2(repo + "/domains/matter"))
    // minimal-but-decodable F1F2 records (only record_id is read for the title-
    // from-filename list view; the loader's decode guard needs record_id).
    let rec = "{\"interface\":\"i\",\"schema_version\":\"1.0\",\"record_id\":\"X\","
        + "\"produced_at_utc\":\"2026-01-01T00:00:00Z\",\"topology\":{\"kind\":\"k\","
        + "\"degree\":4,\"node_count\":64,\"routing\":\"min\"},\"traffic\":\"t\","
        + "\"verdict\":{\"f1\":\"a\",\"f2\":\"b\",\"rationale\":\"r\"},"
        + "\"provenance\":{\"absorbed\":false,\"measurement_gate\":\"GATE_OPEN\","
        + "\"sim_engine\":\"e\",\"sim_commit_hash\":\"abc\",\"gate_failures\":[],"
        + "\"consumer_target\":\"c\",\"atlas_cite_block\":\"a\",\"scope_caveats\":[]}}\n"
    exec("printf %s " + _shq2(rec) + " > " + _shq2(rdir + "/aaa.json"))
    exec("printf %s " + _shq2(rec) + " > " + _shq2(rdir + "/bbb.json"))
    // design.md — Decisions out of order + a duplicate number (dedup, first wins).
    let design = "# Design\n\n"
        + "### Decision 3 — third thing\nbody\n\n"
        + "### Decision 1 — first thing\nbody\n\n"
        + "### Decision 10 — tenth thing\nbody\n\n"
        + "### Decision 1 — dup first should be deduped\nbody\n"
    exec("printf %s " + _shq2(design) + " > " + _shq2(repo + "/design.md"))
    // proposals — two rfc_*.md (different number widths) + one non-rfc.
    exec("printf %s " + _shq2("rfc\n") + " > " + _shq2(repo + "/proposals/rfc_002_beta.md"))
    exec("printf %s " + _shq2("rfc\n") + " > " + _shq2(repo + "/proposals/rfc_011_alpha.md"))
    exec("printf %s " + _shq2("notes\n") + " > " + _shq2(repo + "/proposals/notes.md"))
    // domains — two .md + README (excluded) + the matter/README pointer (D17).
    exec("printf %s " + _shq2("d\n") + " > " + _shq2(repo + "/domains/chip.md"))
    exec("printf %s " + _shq2("d\n") + " > " + _shq2(repo + "/domains/aaa-domain.md"))
    exec("printf %s " + _shq2("readme\n") + " > " + _shq2(repo + "/domains/README.md"))
    exec("printf %s " + _shq2("m\n") + " > " + _shq2(repo + "/domains/matter/README.md"))
}

// _make_list_empty(repo) — an empty project tree: only the (empty) records dir
// exists, no design.md / proposals / top-level domains. Every kind → "(0):".
fn _make_list_empty(repo: string) {
    exec("rm -rf " + _shq2(repo)
         + " && mkdir -p " + _shq2(repo + "/exports/chip/noc/f1f2/records"))
}

// _make_show_fixture(repo) — a deterministic exports/ tree under `repo`
// (DEMIURGE_REPO) for the PR#7 `show <path>` parity cells. One fully-populated
// F1F2 record exercising EVERY render branch of the Swift `show`:
//   - non-empty topology (int degree/node_count) · verdict · all provenance
//     scalar fields · a sim_commit_hash > 12 chars (so the `.prefix(12)` trim
//     is asserted) · TWO gate_failures + TWO scope_caveats (the `  [i] <v>`
//     rows + the counts). $HOME-rooted (non-symlinked) so the canonical-path
//     error lines stay machine-independent (lexical-canon · see RecordLoader).
//   + a `bad.json` of non-JSON text for the decode-failure LIVE cell.
fn _make_show_fixture(repo: string) {
    let rdir = repo + "/exports/chip/noc/f1f2/records"
    exec("rm -rf " + _shq2(repo) + " && mkdir -p " + _shq2(rdir))
    let rec = "{\n"
        + "  \"interface\": \"hexa-arch:chip:noc:F1F2-record\",\n"
        + "  \"schema_version\": \"1.0\",\n"
        + "  \"record_id\": \"SHOW_OK\",\n"
        + "  \"produced_at_utc\": \"2026-06-03T00:00:00Z\",\n"
        + "  \"topology\": { \"kind\": \"mesh_2d\", \"degree\": 4, \"node_count\": 64, \"routing\": \"min\" },\n"
        + "  \"traffic\": \"tornado\",\n"
        + "  \"verdict\": { \"f1\": \"INCONCLUSIVE\", \"f2\": \"INCONCLUSIVE\", \"rationale\": \"single-topology fixture record for the demi show selftest cell\" },\n"
        + "  \"provenance\": {\n"
        + "    \"absorbed\": false, \"measurement_gate\": \"GATE_CLOSED_MEASURED\",\n"
        + "    \"sim_engine\": \"fixture_engine\", \"sim_commit_hash\": \"deadbeefcafe1234567890\",\n"
        + "    \"gate_failures\": [\"gf-alpha\", \"gf-beta\"], \"consumer_target\": \"demi:selftest\",\n"
        + "    \"atlas_cite_block\": \"@cite fixture\", \"scope_caveats\": [\"caveat-one\", \"caveat-two\"]\n"
        + "  }\n"
        + "}\n"
    exec("printf %s " + _shq2(rec) + " > " + _shq2(rdir + "/show_ok.json"))
    exec("printf %s " + _shq2("not json at all") + " > " + _shq2(rdir + "/bad.json"))
}

// _gate_rec(rid, gate, absorbed) — a fully-decodable F1F2 record JSON literal
// with the given record_id / measurement_gate / absorbed (every other required
// field present so rl_f1f2_decodes ⇔ Swift Codable .success).
fn _gate_rec(rid: string, gate: string, absorbed: string) -> string {
    return "{\"interface\":\"i\",\"schema_version\":\"1.0\",\"record_id\":" + _shq2_json(rid)
        + ",\"produced_at_utc\":\"2026-01-01T00:00:00Z\",\"topology\":{\"kind\":\"k\","
        + "\"degree\":4,\"node_count\":64,\"routing\":\"min\"},\"traffic\":\"t\","
        + "\"verdict\":{\"f1\":\"a\",\"f2\":\"b\",\"rationale\":\"r\"},"
        + "\"provenance\":{\"absorbed\":" + absorbed + ",\"measurement_gate\":\"" + gate + "\","
        + "\"sim_engine\":\"e\",\"sim_commit_hash\":\"abc\",\"gate_failures\":[],"
        + "\"consumer_target\":\"c\",\"atlas_cite_block\":\"a\",\"scope_caveats\":[]}}\n"
}

// _shq2_json(s) — JSON-quote a string value (the record ids here are plain
// ASCII, so a bare `"<s>"` is correct — no escaping needed).
fn _shq2_json(s: string) -> string { return "\"" + s + "\"" }

// _make_gate_fixture(repo) — a deterministic exports/ tree for the PR#8
// list-gates / gate-summary parity cells. Exercises EVERY aggregation branch:
//   · 4 records → GATE_OPEN (absorbed=false) · 2 → GATE_CLOSED_MEASURED
//     (absorbed=true)  → populated gates with multiple rows.
//   · 0 records → GATE_B_PINNED_MET · 0 → GATE_FAILED → the empty `(0):`
//     gate rows + the `0  (0.0%)` summary rows.
//   · ONE record (zz_skip.json) missing `traffic` → FAILS Codable decode → must
//     be SKIPPED by both verbs (the on-disk router_*_pnr_sky130hd analogue).
// Filenames are chosen so the filename-sort places the OPEN rows (o1..o4) before
// the CLOSED rows (c1,c2) and the skip last; the list-gates within-gate row order
// is that filename sort. Totals: total=6 · OPEN=4 (66.7%) · CLOSED=2 (33.3%) ·
// absorbed=true 2 / false 4 — so the %.1f rounding + the pad are both asserted.
fn _make_gate_fixture(repo: string) {
    let rdir = repo + "/exports/chip/noc/f1f2/records"
    exec("rm -rf " + _shq2(repo) + " && mkdir -p " + _shq2(rdir))
    exec("printf %s " + _shq2(_gate_rec("OPEN_1", "GATE_OPEN", "false")) + " > " + _shq2(rdir + "/o1.json"))
    exec("printf %s " + _shq2(_gate_rec("OPEN_2", "GATE_OPEN", "false")) + " > " + _shq2(rdir + "/o2.json"))
    exec("printf %s " + _shq2(_gate_rec("OPEN_3", "GATE_OPEN", "false")) + " > " + _shq2(rdir + "/o3.json"))
    exec("printf %s " + _shq2(_gate_rec("OPEN_4", "GATE_OPEN", "false")) + " > " + _shq2(rdir + "/o4.json"))
    exec("printf %s " + _shq2(_gate_rec("CLOSED_1", "GATE_CLOSED_MEASURED", "true")) + " > " + _shq2(rdir + "/p1_closed.json"))
    exec("printf %s " + _shq2(_gate_rec("CLOSED_2", "GATE_CLOSED_MEASURED", "true")) + " > " + _shq2(rdir + "/p2_closed.json"))
    // undecodable (missing `traffic`) → skipped by both verbs.
    let skip = "{\"interface\":\"i\",\"schema_version\":\"1.0\",\"record_id\":\"SKIP_ME\","
        + "\"produced_at_utc\":\"2026-01-01T00:00:00Z\",\"topology\":{\"kind\":\"k\","
        + "\"degree\":4,\"node_count\":64,\"routing\":\"min\"},"
        + "\"verdict\":{\"f1\":\"a\",\"f2\":\"b\",\"rationale\":\"r\"},"
        + "\"provenance\":{\"absorbed\":false,\"measurement_gate\":\"GATE_OPEN\","
        + "\"sim_engine\":\"e\",\"sim_commit_hash\":\"abc\",\"gate_failures\":[],"
        + "\"consumer_target\":\"c\",\"atlas_cite_block\":\"a\",\"scope_caveats\":[]}}\n"
    exec("printf %s " + _shq2(skip) + " > " + _shq2(rdir + "/zz_skip.json"))
}

// _make_gate_empty(repo) — empty records dir → both verbs render every gate at
// (0) and gate-summary `total records: 0` with all `0  (0.0%)` rows + 0 absorbed.
fn _make_gate_empty(repo: string) {
    exec("rm -rf " + _shq2(repo)
         + " && mkdir -p " + _shq2(repo + "/exports/chip/noc/f1f2/records"))
}

fn _run_swift(bin: string, env_prefix: string, argv_str: string) -> [string] {
    let cmd = env_prefix + " " + _shq2(bin) + " " + argv_str + " 2>&1"
    let pair = exec_with_status(cmd)
    return [to_string(pair[0]), to_string(pair[1])]
}

// _make_compose_fixture(repo) — a deterministic domains/INDEX.demi DAG for the
// PR#10 `compose <domain>` parity cells. BOTH surfaces read this same SSOT via
// DEMIURGE_REPO (Swift DomainLoader.indexPath's first-priority path is
// $DEMIURGE_REPO/domains/INDEX.demi; hexa dco_index_path resolves identically
// off rl_project_root). exports/ must exist so rl_project_root() (exportsRoot
// minus its last segment) lands on <repo>. `repo` MUST be a non-symlinked real
// path (same reason as the verify/cellrun fixtures — Foundation/rl_canon
// standardize lexically).
//
// The 4-domain DAG exercises every compose branch deterministically:
//   root  — scale=device · [physical] · prereq []            → 단일 (atomic)
//   mid   — scale=device · [engineering] · prereq [root]      → 구성형 (composite·2)
//   apex  — scale=system · [physical,propulsion] · [mid,root] → 메타(통합) (meta·3)
//   xdisc — scale=component · [bio,engineering] · [root]      → 구성형 · 결합
// A trailing `#` comment + an inline comment exercise comment-strip; quoted
// labels exercise unquote. Cluster union is first-seen across the topo stack.
fn _make_compose_fixture(repo: string) {
    let ddir = repo + "/domains"
    exec("rm -rf " + _shq2(repo) + " && mkdir -p " + _shq2(ddir)
        + " && mkdir -p " + _shq2(repo + "/exports"))
    let idx = "# fixture INDEX.demi — compose parity (PR#10)\n\n"
        + "[root]\n"
        + "label = \"뿌리\"\n"
        + "canvas_mode = \"cohort\"\n"
        + "prerequisites = []\n"
        + "facets.scale = \"device\"   # inline comment after value\n"
        + "facets.cluster = [\"physical\"]\n\n"
        + "[mid]\n"
        + "label = \"중간\"\n"
        + "prerequisites = [\"root\"]\n"
        + "facets.scale = \"device\"\n"
        + "facets.cluster = [\"engineering\"]\n\n"
        + "[apex]\n"
        + "label = \"꼭대기\"\n"
        + "prerequisites = [\"mid\", \"root\"]\n"
        + "facets.scale = \"system\"\n"
        + "facets.cluster = [\"physical\", \"propulsion\"]\n\n"
        + "[xdisc]\n"
        + "label = \"교차\"\n"
        + "prerequisites = [\"root\"]\n"
        + "facets.scale = \"component\"\n"
        + "facets.cluster = [\"bio\", \"engineering\"]\n"
    exec("printf %s " + _shq2(idx) + " > " + _shq2(ddir + "/INDEX.demi"))
}

// _make_shelf_fixture(repo) — a deterministic domains/ tree for the PR#11
// `list-shelf <domain>` parity cells. BOTH surfaces read it via DEMIURGE_REPO
// (Swift IngredientShelf.section6Lines opens $DEMIURGE_REPO/domains/<d>.md;
// hexa dc_section6_lines resolves identically off rl_project_root). exports/
// must exist so rl_project_root() (exportsRoot minus its last segment) lands on
// <repo>; `repo` must be a real (non-symlinked) path (lexical-standardize).
//
// Two domain maps exercise every render branch:
//   warp  — §6 with TWO verb lines (설계 + 해석) → multi verbs render in
//           rawValue order; a `[multi]` group → ` (multi)` tag; multi-option
//           join ` / `; a `;`-split second group on the design line. The §6
//           `해석` token prefix-matches koreanLabel `해석⟲`.
//   nomap — a domain map with NO `## ... Design options` section → empty shelf
//           → the "(no §6 …)" mapless line. (A truly-missing file is a SEPARATE
//           cell against `ghostdom`, which has no .md at all — same render.)
// The DEMIURGE_EXPERT-independent output carries no absolute paths (machine-
// independent golden). Captured byte-for-byte from the Swift reference 2026-06-04.
fn _make_shelf_fixture(repo: string) {
    let ddir = repo + "/domains"
    exec("rm -rf " + _shq2(repo) + " && mkdir -p " + _shq2(ddir)
        + " && mkdir -p " + _shq2(repo + "/exports"))
    let warp = "# WARP domain\n\n"
        + "## 1. Goal\n"
        + "warp stuff\n\n"
        + "## 6. Design options (workbench shelf)\n"
        + "> options below\n"
        + "- 설계: metric = Alcubierre / Natario ; shell [multi] = thin / thick / graded\n"
        + "- 해석: solver = analytic / numeric\n"
    let nomap = "# NOMAP domain\n\n"
        + "## 1. Goal\n"
        + "no section six here\n"
    exec("printf %s " + _shq2(warp) + " > " + _shq2(ddir + "/warp.md"))
    exec("printf %s " + _shq2(nomap) + " > " + _shq2(ddir + "/nomap.md"))
}

// ── PR#12 ProjectStore fixture (the fixed app-data store dir) ───────────────
//
// ProjectStore.projectsRoot is ~/Library/Application Support/lab.dancin.demiurge/
// projects — a FIXED path with no env override (clause e). The parity cell can
// therefore not redirect it; it BACKS UP the real store to a sibling, lays down
// a deterministic fixture, runs the cells, and RESTORES the backup (so the
// user's real workbench projects are untouched). _project_store_backup returns
// the backup-dir path (or "" if the store did not exist — restore then removes
// the fixture and leaves it absent, matching the original empty state).

fn _project_store_root() -> string {
    return env("HOME") + "/Library/Application Support/lab.dancin.demiurge/projects"
}

// _project_store_backup() — move any existing real store aside; return its
// backup path (or "" if the store dir did not exist).
fn _project_store_backup() -> string {
    let root = _project_store_root()
    let bak = root + ".selftest-realbak"
    let exists = exec("test -d " + _shq2(root) + " && echo yes || echo no").trim()
    // always clear a stale backup from a previous interrupted run.
    exec("rm -rf " + _shq2(bak))
    if exists == "yes" {
        exec("mv " + _shq2(root) + " " + _shq2(bak))
        return bak
    }
    return ""
}

// _project_store_restore(bak) — wipe the fixture store; if a backup exists,
// move it back; else leave the store absent (its original empty state).
fn _project_store_restore(bak: string) {
    let root = _project_store_root()
    exec("rm -rf " + _shq2(root))
    if len(bak) > 0 {
        exec("mv " + _shq2(bak) + " " + _shq2(root))
    }
}

// _project_store_empty() — an empty store (loadAll → []) → `projects (0):`.
fn _project_store_empty() {
    let root = _project_store_root()
    exec("rm -rf " + _shq2(root) + " && mkdir -p " + _shq2(root))
}

// _make_project_fixture() — TWO deterministic project manifests under the store,
// matching the Swift ProjectStore.save layout (<uuid>/manifest.json, .iso8601
// createdAt, sortedKeys). alpha = general domain (일반 공학 label) at 1/7;
// beta = a non-INDEX.demi custom key (synthetic label) at 4/7 with doneVerbs
// [0,1] (so the show render exercises every VerbState mark). createdAt orders
// alpha (2026-01) before beta (2026-03) so the loadAll createdAt-sort is asserted.
fn _make_project_fixture() {
    let root = _project_store_root()
    let da = root + "/AAAA1111-0000-0000-0000-000000000001"
    let db = root + "/BBBB2222-0000-0000-0000-000000000002"
    exec("rm -rf " + _shq2(root)
         + " && mkdir -p " + _shq2(da) + " " + _shq2(db))
    let ma = "{\n"
        + "  \"createdAt\" : \"2026-01-01T00:00:00Z\",\n"
        + "  \"currentVerb\" : 0,\n"
        + "  \"domain\" : \"general\",\n"
        + "  \"doneVerbs\" : [],\n"
        + "  \"id\" : \"AAAA1111-0000-0000-0000-000000000001\",\n"
        + "  \"name\" : \"alpha-proj\",\n"
        + "  \"target\" : \"a general engineering thing\",\n"
        + "  \"walk\" : []\n"
        + "}\n"
    let mb = "{\n"
        + "  \"createdAt\" : \"2026-03-15T08:30:45Z\",\n"
        + "  \"currentVerb\" : 3,\n"
        + "  \"domain\" : \"zzzcustomkey\",\n"
        + "  \"doneVerbs\" : [0, 1],\n"
        + "  \"id\" : \"BBBB2222-0000-0000-0000-000000000002\",\n"
        + "  \"name\" : \"beta-proj\",\n"
        + "  \"target\" : \"custom domain widget\",\n"
        + "  \"walk\" : []\n"
        + "}\n"
    exec("printf %s " + _shq2(ma) + " > " + _shq2(da + "/manifest.json"))
    exec("printf %s " + _shq2(mb) + " > " + _shq2(db + "/manifest.json"))
}

// ── PR#13 mutation fixtures + cells (project new | advance | retreat) ───────
//
// The mutation verbs WRITE the store, so a plain _cell (which runs hexa AND
// Swift on the SAME store) would let the second surface observe the first's
// mutation. The helpers below RE-SEED a single deterministic project before
// each surface's run, then compare BOTH the stdout/rc AND the resulting
// manifest BYTES — a true byte-≡ Swift mutation gate (D50). The fixed-uuid +
// fixed-createdAt seed makes the written manifest fully deterministic for the
// advance/retreat path; for `new` (fresh uuid + UTC now) those two fields are
// normalized before the byte-compare and the stdout is asserted verbatim (it
// carries no uuid/time — @L7: assert only what is faithfully reproducible).

// _seed_one_project(verb) — one project `step-proj` (id STEP… · domain general
// · walk [] · doneVerbs []) at currentVerb=`verb`. Matches ProjectStore.save
// byte layout so a step REWRITE round-trips every field.
fn _seed_one_project(verb: int) {
    let root = _project_store_root()
    let d = root + "/51130000-0000-0000-0000-000000000013"
    exec("rm -rf " + _shq2(root) + " && mkdir -p " + _shq2(d))
    exec("printf %s " + _shq2(_step_man_at(verb)) + " > " + _shq2(d + "/manifest.json"))
}

// _step_man_at(verb) — the seeded step-proj manifest at currentVerb=verb (the
// exact byte layout ps_save_project writes; doneVerbs/walk empty → `[\n\n  ]`).
fn _step_man_at(verb: int) -> string {
    return "{\n"
        + "  \"createdAt\" : \"2026-02-02T02:02:02Z\",\n"
        + "  \"currentVerb\" : " + to_string(verb) + ",\n"
        + "  \"domain\" : \"general\",\n"
        + "  \"doneVerbs\" : [\n\n  ],\n"
        + "  \"id\" : \"51130000-0000-0000-0000-000000000013\",\n"
        + "  \"name\" : \"step-proj\",\n"
        + "  \"target\" : \"a steppable thing\",\n"
        + "  \"walk\" : [\n\n  ]\n"
        + "}"
}

// _step_manifest() — read back the seeded project's manifest bytes (the single
// store dir). Empty string if absent.
fn _step_manifest() -> string {
    let path = _project_store_root() + "/51130000-0000-0000-0000-000000000013/manifest.json"
    let hit = exec("test -f " + _shq2(path) + " && echo yes || echo no").trim()
    if hit != "yes" { return "" }
    return read_file(path)
}

// ── PR #17a llm-store helpers (settings READ + config-SET parity) ───────────
// The llm store is ~/.demiurge/llm.json — a FIXED path (Swift LLMSettings uses
// homeDirectoryForCurrentUser, no env override), so BOTH surfaces read/write
// the SAME file. The cells BACK UP the user's real llm.json, lay down a
// deterministic fixture (or clear it), run, then RESTORE — leaving the user's
// config exactly as found (clean, per the PR contract).
fn _llm_store_path() -> string { return env("HOME") + "/.demiurge/llm.json" }

// _llm_store_backup() — move a real llm.json aside; "" if none present.
fn _llm_store_backup() -> string {
    let path = _llm_store_path()
    let bak = path + ".selftest-realbak"
    let exists = exec("test -f " + _shq2(path) + " && echo yes || echo no").trim()
    exec("rm -f " + _shq2(bak))
    if exists == "yes" {
        exec("mv " + _shq2(path) + " " + _shq2(bak))
        return bak
    }
    return ""
}
// _llm_store_restore(bak) — remove any fixture; restore the real config (or its
// original absence).
fn _llm_store_restore(bak: string) {
    let path = _llm_store_path()
    exec("rm -f " + _shq2(path))
    if len(bak) > 0 { exec("mv " + _shq2(bak) + " " + _shq2(path)) }
}
// _llm_store_clear() — no llm.json (the fresh-default state — load() → default).
fn _llm_store_clear() { exec("rm -f " + _shq2(_llm_store_path())) }
// _llm_store_seed(text) — write a fixed llm.json fixture (a known starting cfg
// for the use/mode/model write cells).
fn _llm_store_seed(text: string) {
    let dir = env("HOME") + "/.demiurge"
    exec("mkdir -p " + _shq2(dir))
    exec("printf %s " + _shq2(text) + " > " + _shq2(_llm_store_path()))
}
// _llm_store_read() — the on-disk llm.json bytes, or "" if absent.
fn _llm_store_read() -> string {
    let path = _llm_store_path()
    let hit = exec("test -f " + _shq2(path) + " && echo yes || echo no").trim()
    if hit != "yes" { return "" }
    return read_file(path)
}

// _cell_llm_write — a config-SET parity cell (use / mode / model). Clears the
// store, runs hexa, captures stdout+rc+the WRITTEN llm.json; clears + runs
// Swift; asserts stdout≡, rc≡, AND the written-file bytes≡. `want_file` is the
// byte-exact golden config (when no Swift bin). The store starts CLEARED so the
// write exercises the from-default path (the deterministic, host-independent
// case — no pre-existing keychain/override state to vary the file).
fn _cell_llm_write(name: string, entry: string, swift_bin: string,
                   argv_str: string, golden_out: string, want_rc: int,
                   want_file: string) -> int {
    _llm_store_clear()
    let hx = _run_hexa(entry, "", argv_str)
    let hx_out = hx[0]
    let hx_rc = _atoi2(hx[1])
    let hx_file = _llm_store_read()
    if hx_rc != want_rc {
        println("FAIL " + name + " — hexa rc=" + to_string(hx_rc) + " want " + to_string(want_rc))
        return 1
    }
    if len(swift_bin) > 0 {
        _llm_store_clear()
        let sw = _run_swift(swift_bin, "", argv_str)
        let sw_out = sw[0]
        let sw_rc = _atoi2(sw[1])
        let sw_file = _llm_store_read()
        if sw_out != hx_out {
            println("FAIL " + name + " — stdout DIFFERS from Swift")
            println("  --- swift ---"); println(sw_out)
            println("  --- hexa  ---"); println(hx_out)
            return 1
        }
        if sw_rc != hx_rc {
            println("FAIL " + name + " — rc swift=" + to_string(sw_rc) + " hexa=" + to_string(hx_rc))
            return 1
        }
        if sw_file != hx_file {
            println("FAIL " + name + " — llm.json DIFFERS from Swift")
            println("  --- swift ---"); println(sw_file)
            println("  --- hexa  ---"); println(hx_file)
            return 1
        }
        println("PASS " + name + " (stdout+llm.json ≡ Swift · rc=" + to_string(hx_rc) + ")")
        return 0
    }
    if hx_out != golden_out {
        println("FAIL " + name + " — stdout DIFFERS from golden")
        println("  --- golden ---"); println(golden_out)
        println("  --- hexa   ---"); println(hx_out)
        return 1
    }
    if hx_file != want_file {
        println("FAIL " + name + " — llm.json DIFFERS from golden")
        println("  --- golden ---"); println(want_file)
        println("  --- hexa   ---"); println(hx_file)
        return 1
    }
    println("PASS " + name + " (stdout+llm.json ≡ golden · rc=" + to_string(hx_rc) + ")")
    return 0
}

// _cell_step — an advance/retreat parity cell: re-seed `seed_verb`, run hexa,
// capture stdout+rc+manifest; re-seed, run Swift; assert stdout≡, rc≡, manifest
// bytes≡. `want_manifest` is the byte-exact expected manifest after the step
// (the golden when no Swift bin). A CLAMP cell passes the same verb as seed +
// expects the manifest UNCHANGED (the clamp path does not write).
fn _cell_step(name: string, entry: string, swift_bin: string,
              seed_verb: int, argv_str: string,
              golden_out: string, want_rc: int, want_manifest: string) -> int {
    // hexa surface.
    _seed_one_project(seed_verb)
    let hx = _run_hexa(entry, "", argv_str)
    let hx_out = hx[0]
    let hx_rc = _atoi2(hx[1])
    let hx_man = _step_manifest()
    if hx_rc != want_rc {
        println("FAIL " + name + " — hexa rc=" + to_string(hx_rc) + " want " + to_string(want_rc))
        return 1
    }
    if len(swift_bin) > 0 {
        _seed_one_project(seed_verb)
        let sw = _run_swift(swift_bin, "", argv_str)
        let sw_out = sw[0]
        let sw_rc = _atoi2(sw[1])
        let sw_man = _step_manifest()
        if sw_out != hx_out {
            println("FAIL " + name + " — stdout DIFFERS from Swift")
            println("  --- swift ---"); println(sw_out)
            println("  --- hexa  ---"); println(hx_out)
            return 1
        }
        if sw_rc != hx_rc {
            println("FAIL " + name + " — rc swift=" + to_string(sw_rc) + " hexa=" + to_string(hx_rc))
            return 1
        }
        if sw_man != hx_man {
            println("FAIL " + name + " — manifest DIFFERS from Swift")
            println("  --- swift ---"); println(sw_man)
            println("  --- hexa  ---"); println(hx_man)
            return 1
        }
        println("PASS " + name + " (stdout+manifest ≡ Swift · rc=" + to_string(hx_rc) + ")")
        return 0
    }
    if hx_out != golden_out {
        println("FAIL " + name + " — stdout DIFFERS from golden")
        println("  --- golden ---"); println(golden_out)
        println("  --- hexa   ---"); println(hx_out)
        return 1
    }
    if hx_man != want_manifest {
        println("FAIL " + name + " — manifest DIFFERS from golden")
        println("  --- golden ---"); println(want_manifest)
        println("  --- hexa   ---"); println(hx_man)
        return 1
    }
    println("PASS " + name + " (stdout+manifest ≡ golden · rc=" + to_string(hx_rc) + ")")
    return 0
}

// _norm_manifest(m) — replace the two non-deterministic manifest fields (id +
// createdAt) with placeholders so a `new`-written manifest is byte-comparable
// across surfaces (the uuid + UTC timestamp differ per run; everything else —
// the schema, currentVerb, domain, doneVerbs, name, target, walk — is exact).
fn _norm_manifest(m: string) -> string {
    let lines = m.split("\n")
    let mut out = ""
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i]
        let mut keep = ln
        if rl_starts_with(ln.trim(), "\"id\" :") { keep = "  \"id\" : \"<UUID>\"," }
        else if rl_starts_with(ln.trim(), "\"createdAt\" :") { keep = "  \"createdAt\" : \"<TS>\"," }
        if i > 0 { out = out + "\n" }
        out = out + keep
        i = i + 1
    }
    return out
}

// _new_manifest() — the single manifest written by a `project new` run (there
// is exactly one project dir under the fresh store). "" if none.
fn _new_manifest() -> string {
    let root = _project_store_root()
    let listing = exec("ls " + _shq2(root) + "/*/manifest.json 2>/dev/null").trim()
    if len(listing) == 0 { return "" }
    let files = listing.split("\n")
    return read_file(files[0].trim())
}

// _cell_new — a `project new` parity cell. The store is reset fresh, `env_prefix`
// (DEMIURGE_REPO=<fixture>) feeds the composer, then for the named surface the
// stdout (deterministic — no uuid/time in it) is asserted byte-≡ and the WRITTEN
// manifest is asserted byte-≡ after normalizing id+createdAt. The Swift arm
// re-resets + runs Swift and compares stdout + normalized-manifest. honest @L7:
// id/createdAt are NOT golden-asserted (run-dependent); the schema + all other
// fields ARE byte-exact.
fn _cell_new(name: string, entry: string, swift_bin: string,
             env_prefix: string, argv_str: string,
             golden_out: string, want_rc: int, want_manifest_norm: string) -> int {
    let root = _project_store_root()
    exec("rm -rf " + _shq2(root))
    let hx = _run_hexa(entry, env_prefix, argv_str)
    let hx_out = hx[0]
    let hx_rc = _atoi2(hx[1])
    let hx_man = _norm_manifest(_new_manifest())
    if hx_rc != want_rc {
        println("FAIL " + name + " — hexa rc=" + to_string(hx_rc) + " want " + to_string(want_rc))
        return 1
    }
    if hx_out != golden_out {
        println("FAIL " + name + " — stdout DIFFERS from golden")
        println("  --- golden ---"); println(golden_out)
        println("  --- hexa   ---"); println(hx_out)
        return 1
    }
    if hx_man != want_manifest_norm {
        println("FAIL " + name + " — manifest(norm) DIFFERS from golden")
        println("  --- golden ---"); println(want_manifest_norm)
        println("  --- hexa   ---"); println(hx_man)
        return 1
    }
    if len(swift_bin) > 0 {
        exec("rm -rf " + _shq2(root))
        let sw = _run_swift(swift_bin, env_prefix, argv_str)
        let sw_out = sw[0]
        let sw_rc = _atoi2(sw[1])
        let sw_man = _norm_manifest(_new_manifest())
        if sw_out != hx_out {
            println("FAIL " + name + " — stdout DIFFERS Swift vs hexa")
            println("  --- swift ---"); println(sw_out)
            println("  --- hexa  ---"); println(hx_out)
            return 1
        }
        if sw_rc != hx_rc {
            println("FAIL " + name + " — rc swift=" + to_string(sw_rc) + " hexa=" + to_string(hx_rc))
            return 1
        }
        if sw_man != hx_man {
            println("FAIL " + name + " — manifest(norm) DIFFERS Swift vs hexa")
            println("  --- swift ---"); println(sw_man)
            println("  --- hexa  ---"); println(hx_man)
            return 1
        }
        println("PASS " + name + " (stdout+manifest-schema ≡ Swift · uuid/time run-owned · rc=" + to_string(hx_rc) + ")")
        return 0
    }
    println("PASS " + name + " (stdout+manifest-schema ≡ golden · uuid/time run-owned · rc=" + to_string(hx_rc) + ")")
    return 0
}

// _cell_live_only — a parity cell whose Swift output is NOT deterministically
// golden-able (e.g. a Foundation decode error whose tail is locale/machine-
// dependent). It asserts the hexa exit code unconditionally, and the BYTE
// equivalence ONLY when DEMI_SWIFT_BIN is present (the live Swift binary is the
// reference). Without the Swift bin it asserts the hexa rc + a `prefix` the
// output must START with (the deterministic head, e.g. "show: Decode failed (")
// — never a fabricated full golden (@L7).
fn _cell_live_only(name: string, entry: string, swift_bin: string,
                   env_prefix: string, argv_str: string,
                   prefix: string, want_rc: int) -> int {
    let hx = _run_hexa(entry, env_prefix, argv_str)
    let hx_out = hx[0]
    let hx_rc = _atoi2(hx[1])
    if hx_rc != want_rc {
        println("FAIL " + name + " — hexa rc=" + to_string(hx_rc) + " want " + to_string(want_rc))
        return 1
    }
    // The hexa output's deterministic HEAD must equal `prefix` (the demi-owned
    // portion: `show: Decode failed (<path>)`). The trailing Foundation
    // decode-error sentence is environment-OWNED (locale / OS version), NOT part
    // of demi's parity contract — verify_record's decode case omits a cell for
    // the same reason (@L7: never assert byte-equality of a string demi cannot
    // faithfully reproduce). So both arms assert demi's head + the exit code.
    let hx_head = if len(hx_out) >= len(prefix) { hx_out.substring(0, len(prefix)) } else { hx_out }
    if hx_head != prefix {
        println("FAIL " + name + " — hexa output does not start with the expected prefix")
        println("  --- prefix ---"); println(prefix)
        println("  --- hexa   ---"); println(hx_out)
        return 1
    }
    if len(swift_bin) > 0 {
        // Live cross-check: the Swift reference's head + exit code must agree
        // with hexa's (the demi-owned portion is byte-identical; the Foundation
        // tail beyond `prefix` is out of scope, asserted on neither side).
        let sw = _run_swift(swift_bin, env_prefix, argv_str)
        let sw_out = sw[0]
        let sw_rc = _atoi2(sw[1])
        let sw_head = if len(sw_out) >= len(prefix) { sw_out.substring(0, len(prefix)) } else { sw_out }
        if sw_head != prefix {
            println("FAIL " + name + " — Swift output does not start with the expected prefix")
            println("  --- prefix ---"); println(prefix)
            println("  --- swift  ---"); println(sw_out)
            return 1
        }
        if sw_rc != hx_rc {
            println("FAIL " + name + " — rc swift=" + to_string(sw_rc) + " hexa=" + to_string(hx_rc))
            return 1
        }
        println("PASS " + name + " (head ≡ Swift · rc=" + to_string(hx_rc) + " · Foundation tail env-owned)")
        return 0
    }
    println("PASS " + name + " (head ≡ golden · rc=" + to_string(hx_rc) + " · Foundation tail env-owned)")
    return 0
}

// One parity cell. `argv` is the demiurge-cli argv tail; `env_prefix` is a
// shell env assignment string applied to BOTH surfaces; `golden` is the
// byte-for-byte expected merged output (used when no Swift bin is present);
// `want_rc` is the expected exit code.
fn _cell(name: string, entry: string, swift_bin: string,
         env_prefix: string, argv_str: string,
         golden: string, want_rc: int) -> int {
    let hx = _run_hexa(entry, env_prefix, argv_str)
    let hx_out = hx[0]
    let hx_rc = _atoi2(hx[1])

    // (1) hexa exit code
    if hx_rc != want_rc {
        println("FAIL " + name + " — hexa rc=" + to_string(hx_rc) + " want " + to_string(want_rc))
        return 1
    }

    if len(swift_bin) > 0 {
        // Live cross-check against the Swift reference (the strongest gate).
        let sw = _run_swift(swift_bin, env_prefix, argv_str)
        let sw_out = sw[0]
        let sw_rc = _atoi2(sw[1])
        if sw_out != hx_out {
            println("FAIL " + name + " — output DIFFERS from Swift")
            println("  --- swift ---"); println(sw_out)
            println("  --- hexa  ---"); println(hx_out)
            return 1
        }
        if sw_rc != hx_rc {
            println("FAIL " + name + " — rc swift=" + to_string(sw_rc) + " hexa=" + to_string(hx_rc))
            return 1
        }
        println("PASS " + name + " (byte ≡ Swift · rc=" + to_string(hx_rc) + ")")
        return 0
    }

    // No Swift bin — fall back to the GOLDEN string captured from Swift.
    if hx_out != golden {
        println("FAIL " + name + " — output DIFFERS from golden")
        println("  --- golden ---"); println(golden)
        println("  --- hexa   ---"); println(hx_out)
        return 1
    }
    println("PASS " + name + " (byte ≡ golden · rc=" + to_string(hx_rc) + ")")
    return 0
}

// _cell_passthrough — a parity cell for a VERBATIM-FORWARD verb (PR-verify-
// passthrough). demi `verify --expr|--fence|rubric` forwards to the hexa
// verify KERNEL, which is the SAME binary Swift's verifyHexa forwards to. So
// the golden is computed LIVE from `hexa verify <args>` (the kernel SSOT) —
// no brittle hardcoded multi-line string, and the cell asserts demi's output
// is byte-identical + rc-identical to a direct kernel call. When DEMI_SWIFT_BIN
// is present the standard live cross-check still runs too (via the inner
// `verify_argv` that the Swift CLI maps through verifyHexa identically).
// `verify_argv` is the post-verb tail (e.g. "--fence '1+1==2'").
fn _cell_passthrough(name: string, entry: string, swift_bin: string,
                     verify_argv: string) -> int {
    let hexa = exec("command -v hexa 2>/dev/null || echo hexa").trim()
    // golden = a direct kernel call (what Swift verifyHexa forwards to).
    let kpair = exec_with_status(_shq2(hexa) + " verify " + verify_argv + " 2>&1")
    let golden = to_string(kpair[0])
    let want_rc = kpair[1]
    // demi side: `<hexa> run <entry> verify <verify_argv>`.
    return _cell(name, entry, swift_bin, "", "verify " + verify_argv,
                 golden, want_rc)
}

fn _atoi2(s: string) -> int {
    let t = s.trim()
    if len(t) == 0 { return 0 }
    let mut n = 0
    let mut i = 0
    while i < len(t) {
        let d = ord(t.substring(i, i + 1)) - 48
        if d < 0 { return -1 }
        if d > 9 { return -1 }
        n = n * 10 + d
        i = i + 1
    }
    return n
}

fn main() {
    let entry = if len(env("DEMI_HEXA_ENTRY")) > 0 { env("DEMI_HEXA_ENTRY") } else { "stdlib/demi/demi_cli.hexa" }
    let swift_bin_env = env("DEMI_SWIFT_BIN")
    // verify the swift bin is actually executable; else fall to golden mode.
    let mut swift_bin = ""
    if len(swift_bin_env) > 0 {
        let ok = exec("test -x " + _shq2(swift_bin_env) + " && echo yes || echo no").trim()
        if ok == "yes" { swift_bin = swift_bin_env }
    }
    if len(swift_bin) > 0 {
        println("demi_parity_selftest — LIVE Swift cross-check (" + swift_bin + ")")
    } else {
        println("demi_parity_selftest — GOLDEN mode (no DEMI_SWIFT_BIN; strings captured from Swift 2026-06-03)")
    }

    let mut fails = 0
    // Pin ONLY PHANES_BIN — overriding HOME would break the nested `hexa run`
    // (it needs the real HOME for its build cache). The HOME-dependent tail of
    // the `searched:` line is computed dynamically below from env("HOME") so
    // the golden stays correct on any machine.
    let nf_env = "PHANES_BIN=/demi-selftest-nonexistent"
    let home = env("HOME")

    // GOLDEN strings — the framing captured byte-for-byte from the Swift
    // DemiurgeCLI on 2026-06-03; the one machine-dependent token (the
    // $HOME/core/phanes path) is interpolated from the live HOME.
    let g_disc_usage = "discover: usage — discover <objective> [--verifier <path>] [--rounds N] [--json]\n"
    let g_disc_nf = "discover: phanes CLI not found.\n"
        + "  searched: /demi-selftest-nonexistent, /usr/local/bin/phanes, /opt/homebrew/bin/phanes, " + home + "/core/phanes/bin/phanes\n"
        + "  set PHANES_BIN env var to override.\n"
        + "  contract expected (phanes-side):\n"
        + "    phanes discover <objective> [--verifier <path>] [--rounds N] [--json]\n"
        + "  phanes owns the OUROBOROS loop; demiurge dispatches only (d3/d4).\n"
        + "  see ~/core/phanes/INBOX.log.md for the CLI surface request.\n"
    let g_act_unknown = "action: unknown verb 'zzz' — try one of specify/structure/design/analyze/synthesize/verify/handoff\n"

    // discover LIVE-forward golden (PR-discover-live): with PHANES_BIN pointing
    // at the stub, BOTH surfaces spawn `phanes discover <args>` → the stub
    // echoes the exact argv and exits 7. This asserts that demi forwards the
    // objective + flags VERBATIM and propagates the child's exit code — the
    // happy path the not-found cell cannot reach.
    let stub_phanes = "/tmp/.demi-selftest-phanes-stub"
    _make_phanes_stub(stub_phanes)
    let live_env = "PHANES_BIN=" + stub_phanes
    let g_disc_live = "[phanes-stub] argv: discover high-Tc hydride --rounds 3\n"

    // ── PROOF cells ──────────────────────────────────────────────────
    fails = fails + _cell("discover/usage", entry, swift_bin, nf_env, "discover",
                          g_disc_usage, 2)
    fails = fails + _cell("discover/phanes-not-found", entry, swift_bin, nf_env,
                          "discover " + _shq2("high-Tc hydride"), g_disc_nf, 2)
    // PR-discover-live — LIVE phanes forwarding (argv verbatim + rc propagated).
    fails = fails + _cell("discover/live-forward", entry, swift_bin, live_env,
                          "discover " + _shq2("high-Tc hydride") + " --rounds 3",
                          g_disc_live, 7)
    fails = fails + _cell("action/unknown-verb", entry, swift_bin, "",
                          "action zzz", g_act_unknown, 2)

    // PR#18 cellrun engine — `action <verb> <domain>` HAPPY-path dispatch.
    // The DETERMINISTIC, host-independent parity cell is the MANIFEST-MISSING
    // path: with an empty fixture domains/ the engine returns rc=2 honest-skip
    // BEFORE any dep-probe / python_candidates resolution (those vary by host),
    // and handler_action wraps it with the Swift cliAction framing (header +
    // [cellrun] banner + blank line + "---" + engine-gap line + exit 1). The
    // blank line between the banner and "---" replicates the Swift subprocess-
    // capture artifact (omittingEmptySubsequences:false on the engine's
    // trailing newline). DEMIURGE_REPO is applied to BOTH surfaces so the
    // domains/ root resolves to the fixture on hexa AND Swift. The substrate-
    // present rc=0 HAPPY path (record emitted · "📸 new record" line) is NOT
    // byte-asserted here — it requires a live python/ngspice substrate that is
    // not host-deterministic; that path is honestly scoped to a follow-up.
    let crfix = home + "/.demi-selftest-cellrun-fixture"
    _make_cellrun_fixture(crfix)
    let crenv = "DEMIURGE_REPO=" + _shq2(crfix)
    let g_cellrun_missing = "action: 명세 (무엇을) · domain=nonesuchdomain — dispatching…\n"
        + "[cellrun] domain=nonesuchdomain verb=specify\n"
        + "[cellrun] honest-skip — manifest missing: " + crfix + "/domains/nonesuchdomain.demi\n"
        + "\n"
        + "---\n"
        + "⏳ engine tool gap — no new measured record (g3).\n"
    fails = fails + _cell("action/cellrun-manifest-missing", entry, swift_bin, crenv,
                          "action specify nonesuchdomain", g_cellrun_missing, 1)

    // PR#19 action --compose / --converge — dispatch a verb ACROSS a domain's
    // topo-ordered constituent stack (--compose) / convergently (--converge).
    // BOTH surfaces read the SAME PR#10 compose-fixture INDEX.demi DAG via
    // DEMIURGE_REPO (root → mid → apex · root → xdisc). The fixture has NO
    // per-domain `<id>.demi` manifests, so EVERY constituent's cellrun honest-
    // skips at rc=2 (manifest missing) — the deterministic, host-INDEPENDENT
    // fan-out (no dep-probe / substrate / python_candidates variance). The
    // multi-constituent banners (with the Swift omittingEmptySubsequences:false
    // trailing-blank capture artifact after each step), the aggregate "합성
    // 실행 — 새 측정 record 없음" line (--compose), and the per-iter ok/skip tag
    // summary + "✅ 수렴 … iter 2 … fixpoint" verdict (--converge) are all
    // byte-asserted. The substrate-PRESENT success path (📸 합성 records · ok
    // tags · rc=0 record emit) is NOT host-deterministic (needs a live
    // python/ngspice substrate) — honestly scoped to a follow-up (cf. #18).
    let s19fix = home + "/.demi-selftest-s19-compose-fixture"
    _make_compose_fixture(s19fix)
    let s19env = "DEMIURGE_REPO=" + _shq2(s19fix)
    // (1) --compose across a 3-constituent META stack (apex: scale=system).
    let g_compose_apex = "action 명세(무엇을) · domain=apex · COMPOSE meta (구성 3 · topo):\n"
        + "  root → mid → apex\n"
        + "── [root] ──\n"
        + "[cellrun] domain=root verb=specify\n"
        + "[cellrun] honest-skip — manifest missing: " + s19fix + "/domains/root.demi\n"
        + "\n"
        + "── [mid] ──\n"
        + "[cellrun] domain=mid verb=specify\n"
        + "[cellrun] honest-skip — manifest missing: " + s19fix + "/domains/mid.demi\n"
        + "\n"
        + "── [apex] ──\n"
        + "[cellrun] domain=apex verb=specify\n"
        + "[cellrun] honest-skip — manifest missing: " + s19fix + "/domains/apex.demi\n"
        + "\n"
        + "---\n"
        + "⏳ 합성 실행 — 새 측정 record 없음 (구성 3 단계 · g3).\n"
    fails = fails + _cell("action/compose-meta-stack", entry, swift_bin, s19env,
                          "action --compose specify apex", g_compose_apex, 0)
    // (2) --compose across a COMPOSITE stack (xdisc: scale=component, stack=2),
    // with the flag placed AFTER the verb/domain (position-independent parse).
    let g_compose_xdisc = "action 해석⟲(점검) · domain=xdisc · COMPOSE composite (구성 2 · topo):\n"
        + "  root → xdisc\n"
        + "── [root] ──\n"
        + "[cellrun] domain=root verb=analyze\n"
        + "[cellrun] honest-skip — manifest missing: " + s19fix + "/domains/root.demi\n"
        + "\n"
        + "── [xdisc] ──\n"
        + "[cellrun] domain=xdisc verb=analyze\n"
        + "[cellrun] honest-skip — manifest missing: " + s19fix + "/domains/xdisc.demi\n"
        + "\n"
        + "---\n"
        + "⏳ 합성 실행 — 새 측정 record 없음 (구성 2 단계 · g3).\n"
    fails = fails + _cell("action/compose-flag-after-args", entry, swift_bin, s19env,
                          "action analyze xdisc --compose", g_compose_xdisc, 0)
    // (3) --compose on an ATOMIC domain (root: no prereqs, stack==1).
    let g_compose_root = "action 구조(어떻게) · domain=root · COMPOSE atomic (구성 1 · topo):\n"
        + "  root\n"
        + "── [root] ──\n"
        + "[cellrun] domain=root verb=structure\n"
        + "[cellrun] honest-skip — manifest missing: " + s19fix + "/domains/root.demi\n"
        + "\n"
        + "---\n"
        + "⏳ 합성 실행 — 새 측정 record 없음 (구성 1 단계 · g3).\n"
    fails = fails + _cell("action/compose-atomic", entry, swift_bin, s19env,
                          "action --compose structure root", g_compose_root, 0)
    // (4) --converge across the 3-constituent stack — iter summary + fixpoint.
    let g_converge_apex = "action 명세(무엇을) · domain=apex · CONVERGE ⟲ (구성 3 · max 3 iter):\n"
        + "  iter 1 [0 rec]: root:skip · mid:skip · apex:skip\n"
        + "  iter 2 [0 rec]: root:skip · mid:skip · apex:skip\n"
        + "---\n"
        + "✅ 수렴 — iter 2에서 outcome 패턴 fixpoint 도달.\n"
    fails = fails + _cell("action/converge-meta-stack", entry, swift_bin, s19env,
                          "action --converge specify apex", g_converge_apex, 0)
    // (5) --converge on an ATOMIC domain (stack==1 · still converges iter 2).
    let g_converge_root = "action 구조(어떻게) · domain=root · CONVERGE ⟲ (구성 1 · max 3 iter):\n"
        + "  iter 1 [0 rec]: root:skip\n"
        + "  iter 2 [0 rec]: root:skip\n"
        + "---\n"
        + "✅ 수렴 — iter 2에서 outcome 패턴 fixpoint 도달.\n"
    fails = fails + _cell("action/converge-atomic", entry, swift_bin, s19env,
                          "action --converge structure root", g_converge_root, 0)
    // (6/7) flag-parse error paths — unknown verb + missing domain, for BOTH
    // flags (stderr line, exit 2 · merged via _run_*'s 2>&1). No DEMIURGE_REPO
    // needed (the error fires before any composer/engine resolution).
    let g_compose_unknown = "action --compose: unknown verb 'zzz'\n"
    fails = fails + _cell("action/compose-unknown-verb", entry, swift_bin, "",
                          "action --compose zzz apex", g_compose_unknown, 2)
    let g_compose_missing = "action --compose: missing <domain>\n"
    fails = fails + _cell("action/compose-missing-domain", entry, swift_bin, "",
                          "action --compose specify", g_compose_missing, 2)
    let g_converge_unknown = "action --converge: unknown verb 'zzz'\n"
    fails = fails + _cell("action/converge-unknown-verb", entry, swift_bin, "",
                          "action --converge zzz apex", g_converge_unknown, 2)
    let g_converge_missing = "action --converge: missing <domain>\n"
    fails = fails + _cell("action/converge-missing-domain", entry, swift_bin, "",
                          "action --converge specify", g_converge_missing, 2)

    // PR #20 (@L6 KEYSTONE) action synthesize rtsc --deck <deck> — the
    // QFORGE el-ph synthesize cell. The (synthesize, rtsc) special-cell
    // forwards to `hexa qforge run <deck>` VERBATIM (Swift cliSynthesizeRtsc ·
    // main.swift:312-319); any other (verb, domain) with --deck, or a missing
    // /flag-as-value --deck value, is an honest usage error (exit 2).
    //
    // @L6 / @D d6 HONESTY: the QFORGE migration gate is HELD (λ·Tc not yet
    // cross-val'd vs QE). The forward path asserts NO agreement and synthesizes
    // NO Tc — when a deck has no harvested DFPT el-ph dataset, qforge reports
    // the cell→|g|² front-end gap honestly (exit 1, no fabricated Tc) and the
    // CLI surfaces THAT unchanged. The forward GOLDEN is therefore computed
    // LIVE from the SAME `hexa qforge run` kernel both surfaces spawn (no
    // brittle hardcoded multi-line string · same pattern as _cell_passthrough),
    // so the cell proves demi's framing (the `action: 합성 (만들기) …` header +
    // verbatim child block + trailing "---") + rc are byte-identical to Swift
    // for a deterministic, host-independent deck path (a fixed /tmp/<x> path
    // that does not exist → the HELD-gate honest gap, identical on every host).
    // The LIVE-converged HAPPY path (a deck WITH a harvested DFPT dataset →
    // real λ·Tc) is NON-deterministic + heavy (it is the gated migration work
    // itself, currently HELD) — it is NOT run in this cell; it is honestly
    // scoped to a follow-up once the QFORGE↔QE cross-val gate OPENS.
    let hexa_bin0 = exec("command -v hexa 2>/dev/null || echo hexa").trim()
    let qf_deck = "/tmp/.demi-selftest-qforge-noexist-deck"
    let qfk = exec_with_status(_shq2(hexa_bin0) + " qforge run "
                               + _shq2(qf_deck) + " 2>&1")
    let qf_child = to_string(qfk[0])
    // demi/Swift framing around the verbatim child block: header line + the
    // child text (already \n-terminated by qforge) + a trailing "---" line.
    // The child rc (1 on the HELD gap) is propagated as the cell rc.
    let g_synth_fwd = "action: 합성 (만들기) · domain=rtsc · engine=qforge · deck="
        + qf_deck + " — qforge run…\n"
        + qf_child
        + "---\n"
    fails = fails + _cell("action/synthesize-rtsc-deck-forward", entry, swift_bin,
                          "", "action synthesize rtsc --deck " + _shq2(qf_deck),
                          g_synth_fwd, qfk[1])
    // --deck with NO value (last token) → byte-exact Swift takeValueFlag error.
    let g_deck_eoa = "error: flag --deck needs a value, got end-of-args\n"
    fails = fails + _cell("action/synthesize-deck-no-value", entry, swift_bin, "",
                          "action synthesize rtsc --deck", g_deck_eoa, 2)
    // --deck with a flag in the value slot → byte-exact Swift takeValueFlag error.
    let g_deck_flagval = "error: flag --deck needs a value, got '--foo'\n"
    fails = fails + _cell("action/synthesize-deck-flag-as-value", entry, swift_bin, "",
                          "action synthesize rtsc --deck --foo", g_deck_flagval, 2)
    // --deck on a NON-rtsc synthesize → honest usage error (only rtsc drives QFORGE).
    let g_deck_nonrtsc = "action --deck: only 'synthesize rtsc --deck <deck>' "
        + "drives QFORGE el-ph (@L2). got verb='synthesize' domain='chip'.\n"
    fails = fails + _cell("action/deck-nonrtsc-domain", entry, swift_bin, "",
                          "action synthesize chip --deck /tmp/d", g_deck_nonrtsc, 2)
    // --deck on a NON-synthesize verb → same honest usage error.
    let g_deck_nonsynth = "action --deck: only 'synthesize rtsc --deck <deck>' "
        + "drives QFORGE el-ph (@L2). got verb='verify' domain='rtsc'.\n"
    fails = fails + _cell("action/deck-nonsynth-verb", entry, swift_bin, "",
                          "action verify rtsc --deck /tmp/d", g_deck_nonsynth, 2)

    // PR-verify-passthrough — `verify --expr|--fence|rubric` → hexa verify
    // kernel, output forwarded VERBATIM (Swift verifyHexa · @D g5). Golden
    // is the live kernel call (the SSOT both surfaces forward to).
    fails = fails + _cell_passthrough("verify/fence", entry, swift_bin,
                                      "--fence " + _shq2("1+1==2"))
    fails = fails + _cell_passthrough("verify/expr", entry, swift_bin,
                                      "--expr add 2 4")
    fails = fails + _cell_passthrough("verify/rubric", entry, swift_bin,
                                      "rubric")

    // ── PR-verify-record cells — bare `verify <path|id>` local record check.
    // A $HOME-rooted (non-symlinked) fixture repo keeps the canonical-path
    // goldens machine-independent (see _make_verify_fixture). DEMIURGE_REPO is
    // applied to BOTH surfaces via env_prefix, so exportsRoot resolves to the
    // fixture on both the hexa and (when present) Swift sides.
    let vfix = home + "/.demi-selftest-verify-fixture"
    _make_verify_fixture(vfix)
    let vroot = vfix + "/exports/chip/noc/f1f2/records"
    let venv = "DEMIURGE_REPO=" + _shq2(vfix)

    // valid record BY PATH → 6 [OK] lines, rc 0.
    let g_v_ok = "[OK]   recordId\n"
        + "[OK]   provenance.simEngine non-empty\n"
        + "[OK]   provenance.simCommitHash non-empty\n"
        + "[OK]   provenance.consumerTarget non-empty\n"
        + "[OK]   provenance.atlasCiteBlock non-empty\n"
        + "[OK]   verdict claim vs gate consistent\n"
    fails = fails + _cell("verify/record-ok-path", entry, swift_bin, venv,
                          "verify " + _shq2(vroot + "/fixture_ok.json"),
                          g_v_ok, 0)
    // valid record BY ID → resolveRecord scans the records dir, same 6 [OK].
    fails = fails + _cell("verify/record-ok-id", entry, swift_bin, venv,
                          "verify FIXTURE_OK", g_v_ok, 0)

    // inconsistent record → REJECTED stderr line FIRST (merged-output order),
    // then 5 [OK] + the consistency [FAIL], rc 1.
    let g_v_reject = "verify: REJECTED — record inconsistent (rfc_011 §4.2 / @F f6)\n"
        + "[OK]   recordId\n"
        + "[OK]   provenance.simEngine non-empty\n"
        + "[OK]   provenance.simCommitHash non-empty\n"
        + "[OK]   provenance.consumerTarget non-empty\n"
        + "[OK]   provenance.atlasCiteBlock non-empty\n"
        + "[FAIL] verdict claim vs gate consistent — verdict asserts a measurement but gate = GATE_OPEN\n"
    fails = fails + _cell("verify/record-reject", entry, swift_bin, venv,
                          "verify FIXTURE_REJECT", g_v_reject, 1)

    // missing path UNDER exports → fileNotFound (canonical path), rc 1.
    let g_v_missing = "verify: Record file not found: " + vroot + "/MISSING.json\n"
    fails = fails + _cell("verify/record-missing", entry, swift_bin, venv,
                          "verify " + _shq2(vroot + "/MISSING.json"),
                          g_v_missing, 1)

    // path OUTSIDE exports (invariant a) → pathOutsideExports (canonical), rc 1.
    let g_v_outside = "verify: Refused (@D g_cockpit_isolation invariant a): path is outside ../exports/**: " + vfix + "/outside.json\n"
    fails = fails + _cell("verify/record-outside", entry, swift_bin, venv,
                          "verify " + _shq2(vfix + "/outside.json"),
                          g_v_outside, 1)

    // ── PR-atlas-refusal cells — owner-gated atlas WRITE refusal (Swift
    // atlasCmd · main.swift:688-711). Three cases:
    //   (1) READ subverb (no owner)        → forwards to `hexa atlas` verbatim.
    //   (2) WRITE subverb without owner     → REFUSED (stderr + exit 2, no fwd).
    //   (3) WRITE subverb WITH DEMIURGE_OWNER → forwards to `hexa atlas` verbatim.
    // The (1)/(3) passthrough goldens are computed LIVE from the same `hexa atlas`
    // kernel both surfaces forward to (no brittle hardcoded atlas output); the
    // (2) refusal golden is the byte-exact Swift refusal string. atlas READ verbs
    // need no DEMIURGE_REPO (they read the embedded atlas SSOT), so env is bare
    // except DEMIURGE_OWNER on case (3).
    let hexa_bin = exec("command -v hexa 2>/dev/null || echo hexa").trim()

    // (1) READ passthrough — `atlas lookup` (no args) → hexa atlas usage, rc 0.
    let r_read = exec_with_status(_shq2(hexa_bin) + " atlas lookup 2>&1")
    let g_atlas_read = to_string(r_read[0])
    fails = fails + _cell("atlas/read-passthrough", entry, swift_bin, "",
                          "atlas lookup", g_atlas_read, r_read[1])

    // (2) WRITE without owner → REFUSED (no forward). Byte-exact Swift stderr.
    let g_atlas_refuse = "atlas: 'register' = owner op (사장실 · M20). Set DEMIURGE_OWNER "
        + "to unlock. External read-only: lookup/stats/hash/dump.\n"
    fails = fails + _cell("atlas/write-refused-no-owner", entry, swift_bin, "",
                          "atlas register", g_atlas_refuse, 2)

    // (3) WRITE WITH owner → gate passes, forwards `hexa atlas register` (no
    // discovery-arm args) → hexa atlas register usage, rc 3. Golden = live
    // kernel call (the SSOT both surfaces forward to once unlocked).
    let r_owner = exec_with_status(_shq2(hexa_bin) + " atlas register 2>&1")
    let g_atlas_owner = to_string(r_owner[0])
    fails = fails + _cell("atlas/write-owner-passthrough", entry, swift_bin,
                          "DEMIURGE_OWNER=1", "atlas register",
                          g_atlas_owner, r_owner[1])

    // ── PR#6 list-* cells — `list-records|list-decisions|list-rfcs|
    // list-domains|list-all` rendered from the #5 RecordLoader/ArtifactRegistry
    // (rl_stubs). DEMIURGE_REPO is applied to BOTH surfaces via env_prefix so
    // exportsRoot+projectRoot resolve to the SAME fixture tree; the list output
    // carries no absolute paths, so the goldens are machine-independent. Each
    // verb has a POPULATED cell (sort/dedup/pad/pointer) + an EMPTY cell
    // (`<header> (0):`). Goldens captured byte-for-byte from the Swift
    // DemiurgeCLI reference (cockpit .build/debug · 2026-06-04).
    let lfix = home + "/.demi-selftest-list-fixture"
    _make_list_fixture(lfix)
    let lenv = "DEMIURGE_REPO=" + _shq2(lfix)
    let lempty = home + "/.demi-selftest-list-empty"
    _make_list_empty(lempty)
    let lenv0 = "DEMIURGE_REPO=" + _shq2(lempty)

    // list-records (populated) — $R1/$R2 sorted by filename, padded.
    let g_l_records = "Records (2):\n"
        + "  $R1  aaa\n"
        + "  $R2  bbb\n"
    fails = fails + _cell("list-records/populated", entry, swift_bin, lenv,
                          "list-records", g_l_records, 0)
    // list-decisions (populated) — numeric sort 1,3,10 · dup deduped · pad to $D10.
    let g_l_decisions = "Decisions (3):\n"
        + "  $D1   D1 — first thing\n"
        + "  $D3   D3 — third thing\n"
        + "  $D10  D10 — tenth thing\n"
    fails = fails + _cell("list-decisions/populated", entry, swift_bin, lenv,
                          "list-decisions", g_l_decisions, 0)
    // list-rfcs (populated) — key = 2nd `_`-field, title = full stem, pad equal.
    let g_l_rfcs = "RFCs (2):\n"
        + "  $RFC002  rfc_002_beta\n"
        + "  $RFC011  rfc_011_alpha\n"
    fails = fails + _cell("list-rfcs/populated", entry, swift_bin, lenv,
                          "list-rfcs", g_l_rfcs, 0)
    // list-domains (populated) — README excluded · matter pointer · sort by key.
    let g_l_domains = "Domains (3):\n"
        + "  $DOM:aaa-domain  aaa-domain\n"
        + "  $DOM:chip        chip\n"
        + "  $DOM:matter      matter (pointer — D17 hexa-lang absorbed)\n"
    fails = fails + _cell("list-domains/populated", entry, swift_bin, lenv,
                          "list-domains", g_l_domains, 0)
    // list-all (populated) — all four kinds in allCases order, blank-line after
    // each (so a trailing blank line ends the output).
    let g_l_all = g_l_records + "\n" + g_l_decisions + "\n"
        + g_l_rfcs + "\n" + g_l_domains + "\n"
    fails = fails + _cell("list-all/populated", entry, swift_bin, lenv,
                          "list-all", g_l_all, 0)

    // EMPTY cells — empty project tree → `<header> (0):` for each kind, rc 0.
    fails = fails + _cell("list-records/empty", entry, swift_bin, lenv0,
                          "list-records", "Records (0):\n", 0)
    fails = fails + _cell("list-decisions/empty", entry, swift_bin, lenv0,
                          "list-decisions", "Decisions (0):\n", 0)
    fails = fails + _cell("list-rfcs/empty", entry, swift_bin, lenv0,
                          "list-rfcs", "RFCs (0):\n", 0)
    fails = fails + _cell("list-domains/empty", entry, swift_bin, lenv0,
