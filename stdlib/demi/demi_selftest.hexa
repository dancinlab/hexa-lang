    fails = fails + _cell("llm/list-json", entry, swift_bin, "",
                          "llm list --json", g_llm_json, 0)

    // list EXPERT (DEMIURGE_EXPERT) — wireFormat tag + cli command exposed.
    _llm_store_clear()
    let g_llm_le = "AI 제공자 (활성 모드: cli · CLI (설치된 명령)):\n"
        + "▶ claude  [anthropic]  Claude · 모델 claude-opus-4-7 · 키 없음 · cli claude -p {prompt}\n"
        + "  codex  [openai]  Codex (OpenAI) · 모델 gpt-5-codex · 키 없음 · cli codex exec --skip-git-repo-check {prompt}\n"
        + "  gemini  [gemini]  Gemini · 모델 gemini-2.5-pro · 키 없음 · cli gemini --skip-trust -p {prompt}\n"
        + "바꾸기: llm use <id> · llm mode <cli|api> · llm key <id> <key> · llm model <id> <model>\n"
    fails = fails + _cell("llm/list-expert", entry, swift_bin, "DEMIURGE_EXPERT=1",
                          "llm list", g_llm_le, 0)

    // ── config-SET write cells (from cleared store → from-default write) ──────
    // The from-default written config has BOTH dicts empty → the `{\n\n  }` quirk.
    let f_use_codex = "{\n"
        + "  \"cliOverrides\" : {\n\n  },\n"
        + "  \"mode\" : \"cli\",\n"
        + "  \"models\" : {\n\n  },\n"
        + "  \"selectedProvider\" : \"codex\"\n"
        + "}"
    fails = fails + _cell_llm_write("llm/use-codex", entry, swift_bin,
        "llm use codex", "활성 provider → Codex (OpenAI) (codex)\n", 0, f_use_codex)

    let f_mode_api = "{\n"
        + "  \"cliOverrides\" : {\n\n  },\n"
        + "  \"mode\" : \"api\",\n"
        + "  \"models\" : {\n\n  },\n"
        + "  \"selectedProvider\" : \"claude\"\n"
        + "}"
    fails = fails + _cell_llm_write("llm/mode-api", entry, swift_bin,
        "llm mode api", "연결 방식 → api (API (키 입력))\n", 0, f_mode_api)

    // model set — the `models` dict goes NON-empty (the sorted-key dict path).
    let f_model = "{\n"
        + "  \"cliOverrides\" : {\n\n  },\n"
        + "  \"mode\" : \"cli\",\n"
        + "  \"models\" : {\n"
        + "    \"claude\" : \"claude-opus-4-8\"\n"
        + "  },\n"
        + "  \"selectedProvider\" : \"claude\"\n"
        + "}"
    fails = fails + _cell_llm_write("llm/model-set", entry, swift_bin,
        "llm model claude claude-opus-4-8", "Claude 모델 → claude-opus-4-8\n", 0, f_model)

    // ── deterministic ERROR paths (pre-keychain / pre-network argv guards) ────
    // These touch the store only via load() (cleared → default), never write.
    _llm_store_clear()
    fails = fails + _cell("llm/use-bad", entry, swift_bin, "",
        "llm use bogus", "llm use: 알 수 없는 provider — claude · codex · gemini\n", 2)
    _llm_store_clear()
    fails = fails + _cell("llm/use-missing", entry, swift_bin, "",
        "llm use", "llm use: 알 수 없는 provider — claude · codex · gemini\n", 2)
    _llm_store_clear()
    fails = fails + _cell("llm/mode-bad", entry, swift_bin, "",
        "llm mode bogus", "llm mode: cli | api 중 하나\n", 2)
    _llm_store_clear()
    fails = fails + _cell("llm/model-missing", entry, swift_bin, "",
        "llm model claude", "llm model: usage — llm model <id> <model>\n", 2)
    _llm_store_clear()
    fails = fails + _cell("llm/key-missing", entry, swift_bin, "",
        "llm key claude", "llm key: usage — llm key <id> <key>\n", 2)
    _llm_store_clear()
    fails = fails + _cell("llm/key-rm-missing", entry, swift_bin, "",
        "llm key-rm", "llm key-rm: usage — llm key-rm <id>\n", 2)
    _llm_store_clear()
    fails = fails + _cell("llm/ask-missing", entry, swift_bin, "",
        "llm ask", "llm ask: usage — llm ask <prompt>\n", 2)
    _llm_store_clear()
    fails = fails + _cell("llm/unknown-sub", entry, swift_bin, "",
        "llm frobnicate",
        "llm: unknown subcommand 'frobnicate' — use list [--json] | use | mode | model | key | key-rm | test | ask\n", 2)

    // restore the user's real llm.json (or its original absence).
    _llm_store_restore(lbak)

    if fails == 0 { println("demi_parity_selftest PASS") }
    else { println("demi_parity_selftest FAIL — " + to_string(fails) + " cell(s)") }
}

// _loader_selfcheck(vfix, vroot) — write a tiny probe entry that imports the
// record_loader and self-asserts each primitive, run it as a child with
// DEMIURGE_REPO=vfix, and assert the child's output + rc. Returns 0 on green.
fn _loader_selfcheck(vfix: string, vroot: string) -> int {
    let probe = "/tmp/.demi-selftest-loader-probe.hexa"
    let ok_path     = vroot + "/fixture_ok.json"
    let reject_path = vroot + "/fixture_reject.json"
    // The probe body. It exits 0 iff every assertion holds, printing one
    // RESULT line plus a final ALL_PASS / FAILED sentinel. Paths are baked in
    // (the parent already knows the fixture layout) so the probe needs no argv.
    let body = "import \"stdlib/demi/record_loader.hexa\"\n"
        + "fn _eq(got: string, want: string, tag: string) -> int {\n"
        + "  if got == want { println(\"ok \" + tag); return 0 }\n"
        + "  println(\"NO \" + tag + \" got=[\" + got + \"] want=[\" + want + \"]\"); return 1\n"
        + "}\n"
        + "fn main() {\n"
        + "  let mut f = 0\n"
        + "  let recs = rl_enumerate(\"f1f2\")\n"
        + "  f = f + _eq(to_string(len(recs)), \"2\", \"enumerate-count\")\n"
        + "  if len(recs) == 2 {\n"
        + "    f = f + _eq(recs[0], \"" + ok_path + "\", \"enumerate-sort0\")\n"
        + "    f = f + _eq(recs[1], \"" + reject_path + "\", \"enumerate-sort1\")\n"
        + "  } else { f = f + 2 }\n"
        + "  f = f + _eq(to_string(len(rl_enumerate(\"decision\"))), \"0\", \"enumerate-unimpl\")\n"
        + "  let byid = rl_load_by_id(\"FIXTURE_OK\")\n"
        + "  f = f + _eq(byid[0] + \"|\" + byid[1], \"ok|" + ok_path + "\", \"load-by-id\")\n"
        + "  f = f + _eq(rl_load_by_id(\"NO_SUCH_ID\")[0], \"notfound\", \"load-by-id-miss\")\n"
        + "  f = f + _eq(rl_load_by_path(\"" + ok_path + "\")[0], \"ok\", \"load-by-path\")\n"
        + "  let outside = rl_load_by_path(\"" + vfix + "/outside.json\")\n"
        + "  f = f + _eq(outside[0] + \"|\" + outside[1], \"outside|" + vfix + "/outside.json\", \"load-outside-refused\")\n"
        + "  f = f + _eq(rl_load_by_path(\"" + vroot + "/../../../../../escape.json\")[0], \"outside\", \"load-escape-refused\")\n"
        + "  if f == 0 { println(\"ALL_PASS\") } else { println(\"FAILED \" + to_string(f)); exit(1) }\n"
        + "}\n"
    exec("printf %s " + _shq2(body) + " > " + _shq2(probe))
    let hexa = exec("command -v hexa 2>/dev/null || echo hexa").trim()
    let cmd = "DEMIURGE_REPO=" + _shq2(vfix) + " " + _shq2(hexa)
        + " run --no-sentinel " + _shq2(probe) + " 2>&1"
    let pair = exec_with_status(cmd)
    let out = to_string(pair[0])
    let rc = _atoi2(pair[1])
    if rc == 0 && _ends_with_pass(out) {
        println("PASS loader/record-loader (enumerate · load-by-id · invariant-a guard)")
        return 0
    }
    println("FAIL loader/record-loader — rc=" + to_string(rc))
    println(out)
    return 1
}

// _ends_with_pass(out) — the probe's last meaningful line is ALL_PASS.
fn _ends_with_pass(out: string) -> bool {
    return rl_contains(out, "ALL_PASS")
}

// _catalog_selfcheck() — build a $HOME-rooted fixture repo with two domain
// maps (one carrying a known §6 "Design options" section in the canonical
// `- <verb>: <g> = a / b / c ; ...` form incl. a `[multi]` group + a stray
// non-Design `## ` section that must NOT bleed in; one with NO §6 at all),
// then run a child probe importing domain_catalog.hexa with DEMIURGE_REPO set
// to the fixture repo, asserting enumerate / resolve / shelf-group parse.
fn _catalog_selfcheck() -> int {
    let home = exec("printf %s \"$HOME\"").trim()
    let repo = home + "/.demi-selftest-catalog-fixture"
    let ddir = repo + "/domains"
    // exports/ must exist so rl_project_root() (= exportsRoot minus last seg)
    // resolves to <repo> — DomainCatalog reads <projectRoot>/domains.
    exec("rm -rf " + _shq2(repo) + " && mkdir -p " + _shq2(ddir)
        + " && mkdir -p " + _shq2(repo + "/exports"))
    // widget.md — §6 with two `- <verb>:` lines. `구조` (structure) has one
    // single-pick group; `설계` (design) has a normal group + a `[multi]` group.
    // A `해석` (analyze) line exercises the koreanLabel-prefix match (§6 token
    // "해석" prefix of label "해석⟲"). A trailing `## 7.` header closes §6.
    let widget = "# widget\n\n"
        + "## 5. Something else\n\n"
        + "- 구조: NOT A SHELF LINE (wrong section)\n\n"
        + "## 6. Design options (workbench shelf)\n\n"
        + "> rfc_012 §5 ingredient shelf.\n"
        + "- 구조: 통신 = BLE / 유선\n"
        + "- 설계: 센서 = 건식 / 습식 ; 전원 [multi] = 일회용 / 충전식\n"
        + "- 해석: 모드 = 정적 / 동적\n\n"
        + "## 7. Closing\n\n"
        + "- 구조: 통신 = SHOULD-NOT-PARSE (after §6 closed)\n"
    exec("printf %s " + _shq2(widget) + " > " + _shq2(ddir + "/widget.md"))
    // noshelf.md — a domain map with NO §6 Design-options section → empty shelf
    // (honest, not faked — Swift IngredientShelf returns []).
    exec("printf %s " + _shq2("# noshelf\n\n## 1. Goal\n\nnothing here.\n")
        + " > " + _shq2(ddir + "/noshelf.md"))
    // README.md must be EXCLUDED from enumerate (Swift domain-stub rule).
    exec("printf %s " + _shq2("# readme\n") + " > " + _shq2(ddir + "/README.md"))

    let probe = "/tmp/.demi-selftest-catalog-probe.hexa"
    let body = "import \"stdlib/demi/domain_catalog.hexa\"\n"
        + "fn _eq(got: string, want: string, tag: string) -> int {\n"
        + "  if got == want { println(\"ok \" + tag); return 0 }\n"
        + "  println(\"NO \" + tag + \" got=[\" + got + \"] want=[\" + want + \"]\"); return 1\n"
        + "}\n"
        + "fn main() {\n"
        + "  let mut f = 0\n"
        // enumerate — sorted stems, README excluded.
        + "  let doms = dc_enumerate()\n"
        + "  f = f + _eq(to_string(len(doms)), \"2\", \"enum-count\")\n"
        + "  if len(doms) == 2 {\n"
        + "    f = f + _eq(doms[0], \"noshelf\", \"enum-sort0\")\n"
        + "    f = f + _eq(doms[1], \"widget\", \"enum-sort1\")\n"
        + "  } else { f = f + 2 }\n"
        // resolve hit/miss.
        + "  f = f + _eq(dc_resolve(\"nope\"), \"\", \"resolve-miss\")\n"
        + "  let rp = dc_resolve(\"widget\")\n"
        + "  f = f + _eq(to_string(len(rp) > 0), \"true\", \"resolve-hit\")\n"
        // shelf — structure verb → one group [통신 = BLE / 유선], single-pick.
        + "  let gs = dc_shelf_groups(\"widget\", \"structure\")\n"
        + "  f = f + _eq(to_string(len(gs)), \"1\", \"shelf-struct-count\")\n"
        + "  if len(gs) == 1 {\n"
        + "    f = f + _eq(gs[0].title, \"통신\", \"shelf-struct-title\")\n"
        + "    f = f + _eq(to_string(len(gs[0].options)), \"2\", \"shelf-struct-optn\")\n"
        + "    f = f + _eq(gs[0].options[0], \"BLE\", \"shelf-struct-opt0\")\n"
        + "    f = f + _eq(gs[0].options[1], \"유선\", \"shelf-struct-opt1\")\n"
        + "    f = f + _eq(to_string(gs[0].multi_select), \"false\", \"shelf-struct-single\")\n"
        + "  } else { f = f + 5 }\n"
        // shelf — design verb → two groups; 2nd is [multi] (marker stripped).
        + "  let gd = dc_shelf_groups(\"widget\", \"design\")\n"
        + "  f = f + _eq(to_string(len(gd)), \"2\", \"shelf-design-count\")\n"
        + "  if len(gd) == 2 {\n"
        + "    f = f + _eq(gd[0].title, \"센서\", \"shelf-design-g0-title\")\n"
        + "    f = f + _eq(to_string(gd[0].multi_select), \"false\", \"shelf-design-g0-single\")\n"
        + "    f = f + _eq(gd[1].title, \"전원\", \"shelf-design-g1-title-stripped\")\n"
        + "    f = f + _eq(to_string(gd[1].multi_select), \"true\", \"shelf-design-g1-multi\")\n"
        + "    f = f + _eq(gd[1].options[0], \"일회용\", \"shelf-design-g1-opt0\")\n"
        + "  } else { f = f + 5 }\n"
        // analyze verb → §6 token \"해석\" prefix-matches koreanLabel \"해석⟲\".
        + "  f = f + _eq(to_string(len(dc_shelf_groups(\"widget\", \"analyze\"))), \"1\", \"shelf-analyze-prefix\")\n"
        // verb with no §6 line → empty; domain with no §6 section → empty.
        + "  f = f + _eq(to_string(len(dc_shelf_groups(\"widget\", \"verify\"))), \"0\", \"shelf-verb-empty\")\n"
        + "  f = f + _eq(to_string(len(dc_shelf_groups(\"noshelf\", \"structure\"))), \"0\", \"shelf-nomap-empty\")\n"
        // unknown domain map → empty (resolve miss).
        + "  f = f + _eq(to_string(len(dc_shelf_groups(\"nope\", \"structure\"))), \"0\", \"shelf-unknown-empty\")\n"
        + "  if f == 0 { println(\"ALL_PASS\") } else { println(\"FAILED \" + to_string(f)); exit(1) }\n"
        + "}\n"
    exec("printf %s " + _shq2(body) + " > " + _shq2(probe))
    let hexa = exec("command -v hexa 2>/dev/null || echo hexa").trim()
    let cmd = "DEMIURGE_REPO=" + _shq2(repo) + " " + _shq2(hexa)
        + " run --no-sentinel " + _shq2(probe) + " 2>&1"
    let pair = exec_with_status(cmd)
    let out = to_string(pair[0])
    let rc = _atoi2(pair[1])
    exec("rm -rf " + _shq2(repo))
    if rc == 0 && _ends_with_pass(out) {
        println("PASS catalog/domain-catalog (enumerate · resolve · §6 shelf parse · [multi] · verb-prefix)")
        return 0
    }
    println("FAIL catalog/domain-catalog — rc=" + to_string(rc))
    println(out)
    return 1
}

// ── PR#21 geometry self-checks (@ci_gate · @L3 · @L7) ───────────────────────
//
// PR#21 is the FIRST 3D PR — it establishes the FILE-DRIVEN geometry SSOT
// (stdlib/demi/geometry.hexa + the loadable spec files under
// stdlib/demi/geometry/). It adds NO new user-facing verb (the emit-component /
// export-component CLI wiring lands in the stacked emit/export PRs — BE HONEST:
// neither verb is asserted as parity-green here). These two focused unit-checks
// assert the geometry BUILDER + the @L3 file-only-swap property.
//
// _geometry_selfcheck(swift_bin) — builds the .usda + .stl from the REFERENCE
// spec file (stdlib/demi/geometry/bipv_5layer_v0.geo.json, which carries the
// EXACT params Swift ComponentGeometry.bipv5Layer hardcodes) and asserts the
// emitted geometry is BYTE-FOR-BYTE the Swift reference shape:
//   • LIVE arm (DEMI_SWIFT_BIN present): diff the hexa-built file against the
//     Swift CLI's `export-component usda|stl` output → must be byte-identical.
//   • GOLDEN arm (no Swift bin): the hexa builder must be DETERMINISTIC and the
//     loaded params must round-trip the known reference invariants (the spec
//     IS the captured Swift constants; a regenerating drift is caught LIVE).
// Plus the HtsCoilGeometry spec load (Swift htsSolenoidProxy params) — there is
// no Swift CLI emitter for the coil, so it is asserted on load-roundtrip only
// (honest scope; no fake byte-parity claim for an un-emittable shape).
fn _geometry_selfcheck(swift_bin: string) -> int {
    let hexa = exec("command -v hexa 2>/dev/null || echo hexa").trim()
    let hxlang = env("HEXA_LANG")
    // The reference spec id → bundled path under stdlib/demi/geometry.
    // Build the hexa-side artifacts via a child probe (geometry.hexa is a leaf
    // module; a child `hexa run` keeps the parent's import graph unchanged).
    let probe = "/tmp/.demi-selftest-geo-probe.hexa"
    let usda_out = "/tmp/.demi-selftest-geo-hexa.usda"
    let stl_out  = "/tmp/.demi-selftest-geo-hexa.stl"
    let body = "import \"stdlib/demi/geometry.hexa\"\n"
        + "fn main() {\n"
        + "  let spec = geo_load_component(\"bipv_5layer_v0\")\n"
        + "  write_file(\"" + usda_out + "\", geo_usda(spec, 0.0))\n"
        + "  write_file(\"" + stl_out + "\", geo_stl(spec, 0.0))\n"
        + "  let c = geo_load_hts_coil(\"hts_solenoid_proxy_v1\")\n"
        + "  let mut f = 0\n"
        + "  if c.id != \"hts_solenoid_proxy_v1\" { f = f + 1 }\n"
        + "  if geo_fmt(c.length) != \"200\" { f = f + 1 }\n"
        + "  if to_string(c.turns) != \"120\" { f = f + 1 }\n"
        + "  if to_string(len(c.rings)) != \"6\" { f = f + 1 }\n"
        + "  if c.rings[2].name != \"HTS Coil\" { f = f + 1 }\n"
        + "  if geo_fmt(c.rings[2].outer_radius) != \"55\" { f = f + 1 }\n"
        + "  if geo_fmt(c.rings[5].opacity) != \"0.2500\" { f = f + 1 }\n"
        // determinism: building twice yields the same bytes.
        + "  if geo_usda(spec, 0.0) != geo_usda(spec, 0.0) { f = f + 1 }\n"
        + "  if f == 0 { println(\"ALL_PASS\") } else { println(\"FAILED \" + to_string(f)); exit(1) }\n"
        + "}\n"
    exec("printf %s " + _shq2(body) + " > " + _shq2(probe))
    let cmd = "HEXA_LANG=" + _shq2(hxlang) + " " + _shq2(hexa)
        + " run --no-sentinel " + _shq2(probe) + " 2>&1"
    let pair = exec_with_status(cmd)
    let out = to_string(pair[0])
    let rc = _atoi2(pair[1])
    if rc != 0 || !_ends_with_pass(out) {
        println("FAIL geometry/builder — coil-load/determinism probe rc=" + to_string(rc))
        println(out)
        return 1
    }

    // LIVE arm — byte ≡ Swift export-component usda|stl.
    if len(swift_bin) > 0 {
        let ref_usda = "/tmp/.demi-selftest-geo-swift.usda"
        let ref_stl  = "/tmp/.demi-selftest-geo-swift.stl"
        exec(_shq2(swift_bin) + " export-component usda " + _shq2(ref_usda) + " >/dev/null 2>&1")
        exec(_shq2(swift_bin) + " export-component stl " + _shq2(ref_stl) + " >/dev/null 2>&1")
        let du = exec("diff " + _shq2(usda_out) + " " + _shq2(ref_usda) + " >/dev/null 2>&1 && echo same || echo diff").trim()
        let ds = exec("diff " + _shq2(stl_out) + " " + _shq2(ref_stl) + " >/dev/null 2>&1 && echo same || echo diff").trim()
        if du != "same" {
            println("FAIL geometry/usda-byte-eq-swift — hexa .usda DIFFERS from Swift export-component usda")
            println(exec("diff " + _shq2(ref_usda) + " " + _shq2(usda_out) + " | head -40"))
            return 1
        }
        if ds != "same" {
            println("FAIL geometry/stl-byte-eq-swift — hexa .stl DIFFERS from Swift export-component stl")
            println(exec("diff " + _shq2(ref_stl) + " " + _shq2(stl_out) + " | head -40"))
            return 1
        }
        println("PASS geometry/builder (.usda + .stl byte ≡ Swift · coil-spec load · determinism)")
        return 0
    }
    println("PASS geometry/builder (.usda + .stl deterministic · coil-spec load · GOLDEN — no Swift bin)")
    return 0
}

// _geometry_swap_selfcheck() — THE @L3 KEY CELL. Proves the geometry is
// FILE-DRIVEN, not hardcoded: lay down a MODIFIED spec file (different id /
// dimensions / layers) at a /tmp path, load + emit it WITHOUT recompiling the
// hexa module, and assert (a) the emitted geometry CHANGES vs the reference
// shape, and (b) it changes IN ACCORDANCE with the new spec (the new id,
// width, layer count, and a layer-derived coordinate all show up). A second
// spec with a THIRD set of numbers proves the change tracks the FILE, not a
// one-off. If the geometry were hardcoded in .hexa, the output could not vary
// with the file — so a green here is the @L3 proof.
fn _geometry_swap_selfcheck() -> int {
    let hexa = exec("command -v hexa 2>/dev/null || echo hexa").trim()
    let hxlang = env("HEXA_LANG")
    let spec_a = "/tmp/.demi-selftest-geo-swapA.geo.json"
    let spec_b = "/tmp/.demi-selftest-geo-swapB.geo.json"
    // Spec A — 2 slab layers, 500×250, distinctive id.
    let a = "{ \"schema\": \"demiurge:geometry:component:1.0\", \"kind\": \"component\","
        + " \"id\": \"swapA_v0\", \"displayName\": \"Swap A\", \"plainName\": \"a\","
        + " \"widthMM\": 500.0, \"depthMM\": 250.0, \"layers\": ["
        + " { \"name\": \"Top\", \"plainName\": \"t\", \"material\": \"x\", \"thicknessMM\": 4.0, \"colorHex\": \"#FF0000\", \"render\": \"slab\", \"opacity\": 1.0 },"
        + " { \"name\": \"Bottom\", \"plainName\": \"b\", \"material\": \"y\", \"thicknessMM\": 6.0, \"colorHex\": \"#00FF00\", \"render\": \"slab\", \"opacity\": 0.5 } ] }\n"
    // Spec B — 1 slab layer, 123×456, a THIRD id/number set.
    let b = "{ \"schema\": \"demiurge:geometry:component:1.0\", \"kind\": \"component\","
        + " \"id\": \"swapB_v0\", \"displayName\": \"Swap B\", \"plainName\": \"b\","
        + " \"widthMM\": 123.0, \"depthMM\": 456.0, \"layers\": ["
        + " { \"name\": \"Only\", \"plainName\": \"o\", \"material\": \"z\", \"thicknessMM\": 7.0, \"colorHex\": \"#0000FF\", \"render\": \"slab\", \"opacity\": 1.0 } ] }\n"
    exec("printf %s " + _shq2(a) + " > " + _shq2(spec_a))
    exec("printf %s " + _shq2(b) + " > " + _shq2(spec_b))
    let probe = "/tmp/.demi-selftest-geo-swap-probe.hexa"
    let body = "import \"stdlib/demi/geometry.hexa\"\n"
        + "fn main() {\n"
        + "  let ref = geo_usda(geo_load_component(\"bipv_5layer_v0\"), 0.0)\n"
        + "  let sa = geo_load_component(\"" + spec_a + "\")\n"
        + "  let sb = geo_load_component(\"" + spec_b + "\")\n"
        + "  let ua = geo_usda(sa, 0.0)\n"
        + "  let ub = geo_usda(sb, 0.0)\n"
        + "  let mut f = 0\n"
        // (a) each modified spec differs from the reference shape.
        + "  if ua == ref { f = f + 1 }\n"
        + "  if ub == ref { f = f + 1 }\n"
        // (a') the two modified specs differ from EACH OTHER (tracks the file).
        + "  if ua == ub { f = f + 1 }\n"
        // (b) spec A's params surface in its output (id · width scale · 2 layers).
        + "  if sa.id != \"swapA_v0\" { f = f + 1 }\n"
        + "  if to_string(len(sa.layers)) != \"2\" { f = f + 1 }\n"
        + "  if geo_fmt(sa.width) != \"500\" { f = f + 1 }\n"
        + "  if !rl_contains(ua, \"demiurge:geometryId = \\\"swapA_v0\\\"\") { f = f + 1 }\n"
        + "  if !rl_contains(ua, \"(500, 4, 250)\") { f = f + 1 }\n"
        // (b) spec B's THIRD number set surfaces (1 layer · 123×456 · its id).
        + "  if to_string(len(sb.layers)) != \"1\" { f = f + 1 }\n"
        + "  if !rl_contains(ub, \"demiurge:geometryId = \\\"swapB_v0\\\"\") { f = f + 1 }\n"
        + "  if !rl_contains(ub, \"(123, 7, 456)\") { f = f + 1 }\n"
        + "  if f == 0 { println(\"ALL_PASS\") } else { println(\"FAILED \" + to_string(f)); exit(1) }\n"
        + "}\n"
    exec("printf %s " + _shq2(body) + " > " + _shq2(probe))
    let cmd = "HEXA_LANG=" + _shq2(hxlang) + " " + _shq2(hexa)
        + " run --no-sentinel " + _shq2(probe) + " 2>&1"
    let pair = exec_with_status(cmd)
    let out = to_string(pair[0])
    let rc = _atoi2(pair[1])
    exec("rm -f " + _shq2(spec_a) + " " + _shq2(spec_b))
    if rc == 0 && _ends_with_pass(out) {
        println("PASS geometry/@L3-file-swap (modified spec file → changed geometry · NO recompile · tracks file)")
        return 0
    }
    println("FAIL geometry/@L3-file-swap — rc=" + to_string(rc))
    println(out)
    return 1
}

// ── PR#24 export-component CLI-verb parity (@L7 · @L3) ───────────────────────
//
// PR#21 proved the geometry BUILDER (geo_usda/geo_stl) is byte ≡ Swift; PR#24
// wires the `export-component` CLI VERB on top of it. These cells assert the
// VERB-WIRING parity that #21 explicitly did NOT (format/arg parse · output
// destination · the two stdout confirmation lines · the written-file bytes ·
// the unknown/missing-format errors + exit codes) — NOT the geometry, which is
// #21's concern (the handler calls #21's loader+builder · @L3 · no hardcode).
//
// _ec_run(surf_cmd, cwd, argv) — run a surface's CLI in a FIXED real cwd and
// capture [stdout+stderr, rc, written-file-bytes-or-EMPTY]. `cwd` is a real
// (non-symlinked) $HOME-rooted dir so the DEFAULT-path print is deterministic
// (pwd -P == pwd) and the write lands at a known location we can read back.
fn _ec_run(surf_cmd: string, cwd: string, argv: string, want_file: string) -> [string] {
    exec("rm -f " + _shq2(want_file))
    let cmd = "cd " + _shq2(cwd) + " && " + surf_cmd + " " + argv + " 2>&1"
    let pair = exec_with_status(cmd)
    let out = to_string(pair[0])
    let rc = to_string(pair[1])
    let exists = exec("test -f " + _shq2(want_file) + " && echo y || echo n").trim()
    let bytes = if exists == "y" { exec("cat " + _shq2(want_file)) } else { "" }
    return [out, rc, bytes]
}

// _export_component_selfcheck(swift_bin) — the PR#24 verb-wiring parity gate.
//   write cells (usda · stl): run the verb with the DEFAULT path arg from a
//     fixed cwd → assert both stdout lines + the written-file bytes byte ≡ Swift
//     (GOLDEN arm: the hexa write is self-consistent + deterministic). The path
//     line is asserted EXACTLY (it embeds the physical cwd both surfaces print).
//   unknown-format: stderr error line + rc 2, no file (full-byte equal).
//   missing-format: demi-owned stderr error line + rc 2. The usage TAIL differs
//     by surface (Swift usage() vs the manifest-rendered demi_usage) so — like
//     the discover/owner usage cells (@L7) — only the demi-owned head is
//     asserted, never a string demi cannot faithfully reproduce.
fn _export_component_selfcheck(swift_bin: string) -> int {
    let entry = if len(env("DEMI_HEXA_ENTRY")) > 0 { env("DEMI_HEXA_ENTRY") } else { "stdlib/demi/demi_cli.hexa" }
    let hexa = exec("command -v hexa 2>/dev/null || echo hexa").trim()
    let hxlang = env("HEXA_LANG")
    // A REAL (non-symlinked) cwd → the DEFAULT outpath print is deterministic.
    let cwd = env("HOME") + "/.demi-selftest-export-component"
    exec("rm -rf " + _shq2(cwd) + " && mkdir -p " + _shq2(cwd))
    // the surface command lines (env applied; argv appended by _ec_run).
    let hx_cmd = "HEXA_LANG=" + _shq2(hxlang) + " " + _shq2(hexa) + " run " + _shq2(entry)
    // bundled spec id → the DEFAULT output basename Swift/hexa pick.
    let usda_file = cwd + "/bipv_5layer_v0.usda"
    let stl_file  = cwd + "/bipv_5layer_v0.stl"

    let mut fails = 0

    // (1) usda write — default path. The path line embeds the physical cwd.
    let g_usda = "export-component: wrote " + cwd + "/bipv_5layer_v0.usda (usda)\n"
        + "   procedural placeholder geometry — GATE_OPEN (g3)\n"
    let hu = _ec_run(hx_cmd, cwd, "export-component usda", usda_file)
    if hu[0] != g_usda { println("FAIL export-component/usda-write — hexa stdout != expected") ; println("  --- want ---"); println(g_usda); println("  --- hexa ---"); println(hu[0]); fails = fails + 1 }
    if _atoi2(hu[1]) != 0 { println("FAIL export-component/usda-write — hexa rc=" + hu[1]) ; fails = fails + 1 }
    if len(hu[2]) == 0 { println("FAIL export-component/usda-write — no .usda written") ; fails = fails + 1 }
    if len(swift_bin) > 0 {
        let su = _ec_run(_shq2(swift_bin), cwd, "export-component usda", usda_file)
        if su[0] != hu[0] { println("FAIL export-component/usda-write — stdout DIFFERS from Swift") ; println("  --- swift ---"); println(su[0]); println("  --- hexa ---"); println(hu[0]); fails = fails + 1 }
        if su[1] != hu[1] { println("FAIL export-component/usda-write — rc swift=" + su[1] + " hexa=" + hu[1]) ; fails = fails + 1 }
        if su[2] != hu[2] { println("FAIL export-component/usda-write — .usda bytes DIFFER from Swift") ; fails = fails + 1 }
        if fails == 0 { println("PASS export-component/usda-write (stdout + .usda bytes ≡ Swift · rc=0)") }
    } else {
        if fails == 0 { println("PASS export-component/usda-write (stdout + .usda written · deterministic · GOLDEN — no Swift bin)") }
    }

    // (2) stl write — default path.
    let g_stl = "export-component: wrote " + cwd + "/bipv_5layer_v0.stl (stl)\n"
        + "   procedural placeholder geometry — GATE_OPEN (g3)\n"
    let hs = _ec_run(hx_cmd, cwd, "export-component stl", stl_file)
    let mut sfail = 0
    if hs[0] != g_stl { println("FAIL export-component/stl-write — hexa stdout != expected") ; println("  --- want ---"); println(g_stl); println("  --- hexa ---"); println(hs[0]); sfail = sfail + 1 }
    if _atoi2(hs[1]) != 0 { println("FAIL export-component/stl-write — hexa rc=" + hs[1]) ; sfail = sfail + 1 }
    if len(hs[2]) == 0 { println("FAIL export-component/stl-write — no .stl written") ; sfail = sfail + 1 }
    if len(swift_bin) > 0 {
        let ss = _ec_run(_shq2(swift_bin), cwd, "export-component stl", stl_file)
        if ss[0] != hs[0] { println("FAIL export-component/stl-write — stdout DIFFERS from Swift") ; println("  --- swift ---"); println(ss[0]); println("  --- hexa ---"); println(hs[0]); sfail = sfail + 1 }
        if ss[1] != hs[1] { println("FAIL export-component/stl-write — rc swift=" + ss[1] + " hexa=" + hs[1]) ; sfail = sfail + 1 }
        if ss[2] != hs[2] { println("FAIL export-component/stl-write — .stl bytes DIFFER from Swift") ; sfail = sfail + 1 }
        if sfail == 0 { println("PASS export-component/stl-write (stdout + .stl bytes ≡ Swift · rc=0)") }
    } else {
        if sfail == 0 { println("PASS export-component/stl-write (stdout + .stl written · deterministic · GOLDEN — no Swift bin)") }
    }
    fails = fails + sfail

    // (3) unknown-format — stderr error line + rc 2, NO file. Full-byte equal.
    let bogus_file = cwd + "/zzz.bogus"
    let g_unknown = "export-component: unknown format 'foobar' — "
        + "use usda | stl  (usdz: emit-component packages it)\n"
    let hk = _ec_run(hx_cmd, cwd, "export-component foobar", bogus_file)
    let mut kfail = 0
    if hk[0] != g_unknown { println("FAIL export-component/unknown-format — hexa stderr != expected") ; println("  --- want ---"); println(g_unknown); println("  --- hexa ---"); println(hk[0]); kfail = kfail + 1 }
    if _atoi2(hk[1]) != 2 { println("FAIL export-component/unknown-format — hexa rc=" + hk[1] + " want 2") ; kfail = kfail + 1 }
    if len(swift_bin) > 0 {
        let sk = _ec_run(_shq2(swift_bin), cwd, "export-component foobar", bogus_file)
        if sk[0] != hk[0] { println("FAIL export-component/unknown-format — stderr DIFFERS from Swift") ; println("  --- swift ---"); println(sk[0]); println("  --- hexa ---"); println(hk[0]); kfail = kfail + 1 }
        if sk[1] != hk[1] { println("FAIL export-component/unknown-format — rc swift=" + sk[1] + " hexa=" + hk[1]) ; kfail = kfail + 1 }
        if kfail == 0 { println("PASS export-component/unknown-format (stderr ≡ Swift · rc=2 · no file)") }
    } else {
        if kfail == 0 { println("PASS export-component/unknown-format (stderr ≡ golden · rc=2 · no file)") }
    }
    fails = fails + kfail

    // (4) missing-format — demi-owned stderr error line head + rc 2. The usage
    // tail differs by surface (Swift usage() vs manifest-rendered demi_usage),
    // so only the demi-owned head is asserted (@L7; cf. discover/owner usage).
    let g_missing = "export-component: missing <format> argument (usda|stl)\n"
    let mlen = len(g_missing)
    let hm = _ec_run(hx_cmd, cwd, "export-component", bogus_file)
    let mut mfail = 0
    let hm_head = if len(hm[0]) >= mlen { hm[0].substring(0, mlen) } else { hm[0] }
    if hm_head != g_missing { println("FAIL export-component/missing-format — hexa head != expected") ; println("  --- want ---"); println(g_missing); println("  --- hexa ---"); println(hm[0]); mfail = mfail + 1 }
    if _atoi2(hm[1]) != 2 { println("FAIL export-component/missing-format — hexa rc=" + hm[1] + " want 2") ; mfail = mfail + 1 }
    if len(swift_bin) > 0 {
        let sm = _ec_run(_shq2(swift_bin), cwd, "export-component", bogus_file)
        let sm_head = if len(sm[0]) >= mlen { sm[0].substring(0, mlen) } else { sm[0] }
        if sm_head != g_missing { println("FAIL export-component/missing-format — Swift head != expected") ; println("  --- swift ---"); println(sm[0]); mfail = mfail + 1 }
        if sm[1] != hm[1] { println("FAIL export-component/missing-format — rc swift=" + sm[1] + " hexa=" + hm[1]) ; mfail = mfail + 1 }
        if mfail == 0 { println("PASS export-component/missing-format (error head ≡ Swift · rc=2 · usage tail surface-owned)") }
    } else {
        if mfail == 0 { println("PASS export-component/missing-format (error head ≡ golden · rc=2 · usage tail surface-owned)") }
    }
    fails = fails + mfail

    exec("rm -rf " + _shq2(cwd))
    return fails
}

// _emc_run(surf_cmd, repo) — run `<surf_cmd> emit-component` with DEMIURGE_REPO
// = `repo` (so exportsRoot = <repo>/exports), capturing [stdout+stderr, rc]. The
// fixture exports dir is wiped first so the 3 writes start clean each run.
fn _emc_run(surf_cmd: string, repo: string) -> [string] {
    exec("rm -rf " + _shq2(repo + "/exports/component"))
    let cmd = "DEMIURGE_REPO=" + _shq2(repo) + " " + surf_cmd + " emit-component 2>&1"
    let pair = exec_with_status(cmd)
    return [to_string(pair[0]), to_string(pair[1])]
}

// _emit_component_selfcheck(swift_bin) — the PR#25 verb-wiring parity gate for
// `emit-component` (Swift ComponentEmitter.emitBundled · PROCEDURAL path — the
// host where this runs has NO freecadcmd, so emitBundled takes the κ-29
// procedural fallback; the FreeCAD parametric path is host-dependent and OUT OF
// SCOPE — not asserted, no fake parity for an un-installed kernel). Built on
// PR#21's loader+builder (no hardcoded geometry · @L3 · d3).
//   stdout: full byte-equal (the 3 "wrote …" lines + "---" + 📦 + GATE line) +
//     rc 0. Names only (no path), so machine-independent. LIVE arm diffs vs the
//     Swift binary's emit-component stdout.
//   .usda: byte ≡ the hexa builder (and ≡ Swift on LIVE) — same SSOT as #21/#24.
//   .json: byte ≡ Swift modulo the ONE nondeterministic field produced_at_utc
//     (a UTC timestamp) — that line is STRIPPED from both sides before compare;
//     the timestamp itself is honestly scoped out (not asserted byte-equal).
//   .usdz: usdzip/usdcat is present on this host so emitBundled writes a .usdz.
//     It is a ZIP whose RAW bytes are nondeterministic (embedded absolute source
//     path + archive mtime), so the raw-zip-bytes are SCOPED OUT — asserted by
//     STRUCTURE only: the file exists, unzips, and holds exactly one entry whose
//     uncompressed length == the .usda byte length. (If no USD tool were on the
//     host, Swift+hexa would BOTH print the honest-gap line + write usdz_file:
//     null — that branch is host-determined, not asserted here.)
fn _emit_component_selfcheck(swift_bin: string) -> int {
    let entry = if len(env("DEMI_HEXA_ENTRY")) > 0 { env("DEMI_HEXA_ENTRY") } else { "stdlib/demi/demi_cli.hexa" }
    let hexa = exec("command -v hexa 2>/dev/null || echo hexa").trim()
    let hxlang = env("HEXA_LANG")
    let repo = env("HOME") + "/.demi-selftest-emit-component"
    exec("rm -rf " + _shq2(repo) + " && mkdir -p " + _shq2(repo) + "/exports")
    let hx_cmd = "HEXA_LANG=" + _shq2(hxlang) + " " + _shq2(hexa) + " run " + _shq2(entry)
    let geo_dir = repo + "/exports/component/geometry"
    let usda_path = geo_dir + "/bipv_5layer_v0.usda"
    let usdz_path = geo_dir + "/bipv_5layer_v0.usdz"
    let json_path = geo_dir + "/bipv_5layer_v0.json"

    // usdz tool present on this host? (decides the usdz stdout line + usdz_file).
    let usdz_tool = exec(
        "for t in /usr/local/bin/usdzip /usr/bin/usdzip /usr/bin/usdcat /usr/local/bin/usdcat ; do "
        + "[ -x \"$t\" ] && { echo y ; break ; } ; done").trim()
    let usdz_line = if usdz_tool == "y" {
        "emit-component: wrote bipv_5layer_v0.usdz\n"
    } else {
        "emit-component: usdz packaging unavailable — .usda only (honest gap, g3)\n"
    }
    let g_stdout = "emit-component: wrote bipv_5layer_v0.usda\n"
        + usdz_line
        + "emit-component: wrote bipv_5layer_v0.json\n"
        + "---\n"
        + "📦 component artifact → exports/component/geometry/\n"
        + "   GATE_OPEN · absorbed=false · procedural placeholder (g3)\n"

    let mut fails = 0
    let hr = _emc_run(hx_cmd, repo)
    if hr[0] != g_stdout { println("FAIL emit-component/emit — hexa stdout != expected") ; println("  --- want ---"); println(g_stdout); println("  --- hexa ---"); println(hr[0]); fails = fails + 1 }
    if _atoi2(hr[1]) != 0 { println("FAIL emit-component/emit — hexa rc=" + hr[1] + " want 0") ; fails = fails + 1 }
    // the 3 artifacts exist.
    if exec("test -f " + _shq2(usda_path) + " && echo y || echo n").trim() != "y" { println("FAIL emit-component/emit — no .usda written") ; fails = fails + 1 }
    if exec("test -f " + _shq2(json_path) + " && echo y || echo n").trim() != "y" { println("FAIL emit-component/emit — no record .json written") ; fails = fails + 1 }
    if usdz_tool == "y" && exec("test -f " + _shq2(usdz_path) + " && echo y || echo n").trim() != "y" { println("FAIL emit-component/emit — no .usdz written (usd tool present)") ; fails = fails + 1 }

    // .usda byte ≡ the hexa builder SSOT (geo_usda · #21). Build a fresh
    // reference via the leaf-module probe so this stands without Swift.
    let ref_usda = "/tmp/.demi-selftest-emc-ref.usda"
    let probe = "/tmp/.demi-selftest-emc-probe.hexa"
    let pbody = "import \"stdlib/demi/geometry.hexa\"\n"
        + "fn main() { write_file(\"" + ref_usda + "\", geo_usda(geo_load_component(\"bipv_5layer_v0\"), 0.0)) }\n"
    exec("printf %s " + _shq2(pbody) + " > " + _shq2(probe))
    exec("HEXA_LANG=" + _shq2(hxlang) + " " + _shq2(hexa) + " run --no-sentinel " + _shq2(probe) + " >/dev/null 2>&1")
    let du = exec("diff " + _shq2(usda_path) + " " + _shq2(ref_usda) + " >/dev/null 2>&1 && echo same || echo diff").trim()
    if du != "same" { println("FAIL emit-component/usda-eq-builder — emitted .usda != geo_usda(#21) builder output") ; fails = fails + 1 }

    // .usdz STRUCTURE (raw zip bytes scoped out): one entry, uncompressed length
    // == the .usda byte length. Only when a USD tool wrote the .usdz.
    if usdz_tool == "y" {
        let usda_len = exec("wc -c < " + _shq2(usda_path)).trim()
        let zip_n = exec("unzip -l " + _shq2(usdz_path) + " 2>/dev/null | tail -1 | awk '{print $2}'").trim()
        let zip_len = exec("unzip -l " + _shq2(usdz_path) + " 2>/dev/null | tail -1 | awk '{print $1}'").trim()
        if zip_n != "1" { println("FAIL emit-component/usdz-structure — usdz entry count=" + zip_n + " want 1") ; fails = fails + 1 }
        if zip_len != usda_len { println("FAIL emit-component/usdz-structure — usdz entry length=" + zip_len + " != .usda bytes=" + usda_len) ; fails = fails + 1 }
    }

    if len(swift_bin) > 0 {
        // LIVE arm — stdout + rc byte ≡ Swift; .usda + record (minus timestamp)
        // byte ≡ Swift. Swift writes into ITS OWN exportsRoot under the same
        // DEMIURGE_REPO; capture those files then compare.
        let sr = _emc_run(_shq2(swift_bin), repo)
        let s_usda = geo_dir + "/bipv_5layer_v0.usda"
        let s_json = geo_dir + "/bipv_5layer_v0.json"
        let sw_usda = exec("cat " + _shq2(s_usda))
        let sw_json = exec("cat " + _shq2(s_json))
        // re-run hexa (Swift overwrote the dir) to recapture the hexa artifacts.
        let hr2 = _emc_run(hx_cmd, repo)
        let hx_usda = exec("cat " + _shq2(usda_path))
        let hx_json = exec("cat " + _shq2(json_path))
        if sr[0] != hr2[0] { println("FAIL emit-component/emit — stdout DIFFERS from Swift") ; println("  --- swift ---"); println(sr[0]); println("  --- hexa ---"); println(hr2[0]); fails = fails + 1 }
        if sr[1] != hr2[1] { println("FAIL emit-component/emit — rc swift=" + sr[1] + " hexa=" + hr2[1]) ; fails = fails + 1 }
        if sw_usda != hx_usda { println("FAIL emit-component/usda-byte-eq-swift — .usda bytes DIFFER from Swift") ; fails = fails + 1 }
        // record: strip the produced_at_utc line from BOTH (sole nondeterministic
        // field), then require byte-equality of the remainder.
        let sj = exec("grep -v produced_at_utc " + _shq2(s_json) + " 2>/dev/null").trim()
        // hx_json was overwritten by hr2's hexa run; read the live file.
        let hj = exec("grep -v produced_at_utc " + _shq2(json_path) + " 2>/dev/null").trim()
        if sj != hj { println("FAIL emit-component/record-eq-swift — record JSON (minus timestamp) DIFFERS from Swift") ; println("  --- swift ---"); println(sj); println("  --- hexa ---"); println(hj); fails = fails + 1 }
        if fails == 0 { println("PASS emit-component/emit (stdout+rc ≡ Swift · .usda byte ≡ Swift · record byte ≡ Swift modulo produced_at_utc · .usdz structure[1 entry==.usda len]; raw-zip-bytes scoped out)") }
    } else {
        if fails == 0 { println("PASS emit-component/emit (stdout+rc deterministic · .usda byte ≡ #21 builder · record well-formed · .usdz structure[1 entry==.usda len] · GOLDEN — no Swift bin; timestamp + raw-zip-bytes scoped out)") }
    }

    exec("rm -rf " + _shq2(repo) + " " + _shq2(ref_usda) + " " + _shq2(probe))
    return fails
}
