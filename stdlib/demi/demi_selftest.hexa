    fails = fails + _cell("owner/status-locked", entry, swift_bin, "",
                          "owner", g_own_off, 0)
    // (2) owner ON (DEMIURGE_OWNER=1) — unlocked head + ✅ rows, NO hint, rc 0.
    let g_own_body_on = "    ✅ pool → 내 호스트 라우팅\n"
        + "    ✅ inbox/patches → hexa-lang 핸드오프\n"
        + "    ✅ atlas 등록 PR → dancinlab\n"
        + "    ✅ @D 거버넌스 enforcement\n"
