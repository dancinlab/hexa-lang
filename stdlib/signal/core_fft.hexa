// HEXA Standard Library — signal/core_fft
//
// @version 0.1.0
// @capabilities [pure]
//
// Cooley-Tukey radix-2 FFT / IFFT over flat real+imag float lists.
// Promoted from anima HEXAD/VOICE/anima-voice/dsp_core.hexa
// (`dsp_fft` / `dsp_ifft` + the `bit_reverse` / `log2_int` helpers) per the
// STDLIB domain phase3 M1 (signal primitives).
//
//   X[k] = Σ_{m=0}^{N-1} x[m] · exp(-j·2π·k·m / N)        (forward, fft_native)
//   x[m] = (1/N) · Σ_{k=0}^{N-1} X[k] · exp(+j·2π·k·m / N)  (inverse, ifft_native)
//
// Algorithm:
//   1. Bit-reversal permutation of both real[] and imag[].
//   2. Iterative butterfly passes, stride = 2, 4, 8, ... N. For each
//      butterfly pair (a, b) with twiddle W = W_stride^k:
//        a' = a + W·b      b' = a - W·b      (complex multiply + add)
//      Twiddle: W_stride^k = cos(-2π·k/stride) + j·sin(-2π·k/stride).
//   IFFT(X) = conj(FFT(conj(X))) / N.
//
// Requires N a power of 2. Output is the flat interleaved layout
// [re0, im0, re1, im1, ...] (2·N floats), matching the anima baseline.
//
// NOTE on the trig path (libm):
//   The twiddle factors use the native libm `cos`/`sin` builtins (IEEE-correct
//   over the full range — libm performs its own argument reduction, so no
//   `_cf_fmod` range reduction is needed). This replaces the earlier in-house
//   Taylor `_cf_cos`/`_cf_sin` (+ `_cf_fmod`) port from dsp_core.hexa. User
//   decision (2026-05-25): signal/ stdlib trig = libm — IEEE-correct, consistent
//   across modules, drops the fragile Taylor+fmod dependency. The round-trip and
//   hand-DFT checks now hold to ~1e-9 instead of the old ~5e-3 Taylor drift.
//
// Surface:
//   pub fn fft_native(real: [float], imag: [float], n: int) -> [float]
//   pub fn ifft_native(real: [float], imag: [float], n: int) -> [float]
//       // both return the flat interleaved [re0, im0, re1, im1, ...] layout.
//       // n must be a power of 2; n <= 0 returns [].

let CF_PI = 3.14159265358979323846
let CF_TWO_PI = 6.28318530717958647692

// ── bit reversal: reverse the `bits` lowest bits of `x` (verbatim) ──────────

fn _cf_bit_reverse(x: int, bits: int) -> int {
    let mut result = 0
    let mut val = x
    let mut i = 0
    while i < bits {
        result = result * 2 + (val - (val / 2) * 2)  // result = result*2 + val%2
        val = val / 2
        i = i + 1
    }
    return result
}

// ── log2 for powers of 2 (verbatim log2_int) ────────────────────────────────

fn _cf_log2_int(n: int) -> int {
    let mut result = 0
    let mut v = n
    while v > 1 {
        v = v / 2
        result = result + 1
    }
    return result
}

// ── _cf_fft_inplace(re, im, n): in-place radix-2 forward butterfly on `farr` ──
//
//   SCRATCH LIFECYCLE (2026-06-14, handoff 16083ab3): the in-place butterfly
//   core operates on caller-owned flat `farr` buffers (re/im, length n). It does
//   the bit-reversal permutation IN PLACE then the iterative butterfly passes,
//   allocating NOTHING per call. Both the 1D public wrappers and the 3D axis
//   pass route their per-line transform through here, so the only allocation in
//   the whole transform is the caller's two `farr` scratch buffers — which the
//   caller `farr_free`s deterministically.
//
//   Why this matters: the earlier path built the working re/im (and the packed
//   output) as `[float]` push-arrays. On grow they heap-promote (runtime
//   arena→malloc), and a promoted buffer is ORPHANED on scope-pop (the val-arena
//   rewind never free()s it). Every transform LINE leaked O(n); fft3 runs
//   thousands of lines per call, so repeated large-grid fft3_real/ifft3
//   accumulated memory → OOM under load. The math is bit-identical: same
//   bit-reversal indexing, same twiddles, same butterfly write order.
fn _cf_fft_inplace(re: int, im: int, n: int) {
    let bits = _cf_log2_int(n)
    // bit-reversal permutation in place (swap i <-> rev once, for i < rev)
    let mut i = 0
    while i < n {
        let rev = _cf_bit_reverse(i, bits)
        if rev > i {
            let tr = farr_get(re, i)  let ti = farr_get(im, i)
            let _ = farr_set(re, i, farr_get(re, rev))
            let _ = farr_set(im, i, farr_get(im, rev))
            let _ = farr_set(re, rev, tr)
            let _ = farr_set(im, rev, ti)
        }
        i = i + 1
    }
    // iterative butterfly passes; stride doubles each stage: 2, 4, 8 ... n
    let mut stride = 2
    while stride <= n {
        let half = stride / 2
        let mut j = 0
        while j < n {
            let mut k = 0
            while k < half {
                // Twiddle factor: W_stride^k = exp(-j * 2*pi*k / stride)
                let tw_re = cos(0.0 - CF_TWO_PI * k / stride)
                let tw_im = sin(0.0 - CF_TWO_PI * k / stride)
                let a_idx = j + k
                let b_idx = j + k + half
                let b_re = farr_get(re, b_idx)
                let b_im = farr_get(im, b_idx)
                // Complex multiply: tw * b
                let tb_re = tw_re * b_re - tw_im * b_im
                let tb_im = tw_re * b_im + tw_im * b_re
                // Butterfly: a' = a + tw*b, b' = a - tw*b — TRUE in-place
                //   (4 scalar writes, O(1) per pair — radix-2 textbook).
                let a_re = farr_get(re, a_idx)
                let a_im = farr_get(im, a_idx)
                let _ = farr_set(re, a_idx, a_re + tb_re)
                let _ = farr_set(im, a_idx, a_im + tb_im)
                let _ = farr_set(re, b_idx, a_re - tb_re)
                let _ = farr_set(im, b_idx, a_im - tb_im)
                k = k + 1
            }
            j = j + stride
        }
        stride = stride * 2
    }
}

// ── fft_native(real, imag, n): in-place Cooley-Tukey radix-2 FFT ────────────
//
// Byte-equal port of dsp_core.hexa::dsp_fft. Returns flat
// [re0, im0, re1, im1, ...] (2·n floats). Requires n a power of 2.

pub fn fft_native(real: [float], imag: [float], n: int) -> [float] {
    if n <= 0 { return [] }
    // copy inputs into reclaimable `farr` scratch, transform in place, pack out
    let re = farr_zeros(n)
    let im = farr_zeros(n)
    let mut i = 0
    while i < n {
        let _ = farr_set(re, i, real[i])
        let _ = farr_set(im, i, imag[i])
        i = i + 1
    }
    _cf_fft_inplace(re, im, n)
    // Pack output as interleaved [re0, im0, re1, im1, ...]
    let mut out = []
    let mut p = 0
    while p < n {
        out = out.push(farr_get(re, p))
        out = out.push(farr_get(im, p))
        p = p + 1
    }
    let _ = farr_free(re)
    let _ = farr_free(im)
    return out
}

// ── ifft_native(real, imag, n): inverse FFT ─────────────────────────────────
//
// Byte-equal port of dsp_core.hexa::dsp_ifft.
// IFFT(X) = conj(FFT(conj(X))) / N — conjugate input, forward FFT, conjugate
// output, divide by N. Returns flat [re0, im0, re1, im1, ...].

pub fn ifft_native(real: [float], imag: [float], n: int) -> [float] {
    if n <= 0 { return [] }
    // IFFT(X) = conj(FFT(conj(X)))/N, realised on reclaimable `farr` scratch.
    let re = farr_zeros(n)
    let im = farr_zeros(n)
    let mut i = 0
    while i < n {
        let _ = farr_set(re, i, real[i])
        let _ = farr_set(im, i, 0.0 - imag[i])    // conjugate input
        i = i + 1
    }
    _cf_fft_inplace(re, im, n)
    // Conjugate output and divide by N, packing interleaved [re,im,...].
    let mut out = []
    let inv_n = 1.0 / n
    let mut j = 0
    while j < n {
        out = out.push(farr_get(re, j) * inv_n)
        out = out.push(0.0 - farr_get(im, j) * inv_n)
        j = j + 1
    }
    let _ = farr_free(re)
    let _ = farr_free(im)
    return out
}

// ════════════════════════════════════════════════════════════════════════════
//  3D FFT — separable row-column-depth (axis-wise 1D) decomposition
// ════════════════════════════════════════════════════════════════════════════
//
// The load-bearing primitive of plane-wave DFT (QFORGE L5 brick 1/5): the
// ψ(G) ↔ ψ(r) transform, charge density, and Hartree potential all reduce to a
// forward/inverse 3D FFT. By separability of the DFT kernel,
//
//     X[kx,ky,kz] = Σ_x Σ_y Σ_z  x[ix,iy,iz] · e^{-j2π(kx·ix/Nx + ky·iy/Ny + kz·iz/Nz)}
//
// factorizes into three successive 1D passes — first along z, then y, then x —
// each pass a batch of 1D FFTs over the lines of one axis. We therefore REUSE
// `fft_native` / `ifft_native` verbatim (no re-implementation of the radix-2
// butterfly, per d3/d19); fft3 only orchestrates strided gather → 1D pass →
// scatter.
//
// Layout (row-major, matching the natural C / QE-FFT convention):
//
//     idx(ix,iy,iz) = ((ix · Ny) + iy) · Nz + iz          (0 ≤ ix<Nx, …)
//
// so the z-axis is the contiguous (innermost) one. Both `re[]` and `im[]` are
// flat length-N (N = Nx·Ny·Nz) SPLIT arrays on input.
//
// Surface:
//     pub fn fft3 (re, im, nx, ny, nz) -> [float]   // forward
//     pub fn ifft3(re, im, nx, ny, nz) -> [float]   // inverse (÷N)
//
//   Both return the flat INTERLEAVED layout [re0,im0,re1,im1,…] (2·N floats),
//   matching the 1D `fft_native` output convention; index of (ix,iy,iz) is
//   2·idx(ix,iy,iz) (re) and +1 (im).
//
//   Each of Nx, Ny, Nz must independently be a power of 2 (radix-2 reuse). Any
//   non-positive / mismatched-size input returns [] (malformed-dims guard).
//
// Inverse identity:  IFFT3(X) = conj( FFT3( conj(X) ) ) / N — exactly the 1D
// trick lifted to 3D, so ifft3 reuses the same axis-wise machinery via the
// `inverse` flag and a final 1/N scale.

// ── _fft3_axis_pass_farr: transform every line along `axis` IN PLACE on the
//    `farr` working buffers wre/wim (length N). `inverse=1` ⇒ inverse passes
//    (conjugate in, conjugate out, 1/alen scale), `inverse=0` ⇒ forward.
//
//    The line scratch (lre/lim, length alen) is allocated ONCE here and reused
//    for every line of the pass, then freed — no per-line allocation, no leak.
//    Everything stays in `farr`; nothing escapes as a `[float]`.
fn _fft3_axis_pass_farr(wre: int, wim: int, nx: int, ny: int, nz: int, axis: int, inverse: int) {
    let ntot = nx * ny * nz
    // length of the transformed axis + stride between successive samples on it
    let mut alen = nz
    let mut astride = 1
    if axis == 0 { alen = nx  astride = ny * nz }
    if axis == 1 { alen = ny  astride = nz }
    if axis == 2 { alen = nz  astride = 1 }

    // one reusable line scratch for the whole pass
    let lre = farr_zeros(alen)
    let lim = farr_zeros(alen)
    let inv_a = 1.0 / alen

    // Enumerate every line: a line is fixed in the two non-`axis` coords. We
    // walk all N base indices and process a line only at its starting element
    // (the element whose `axis` coordinate is 0), then stride through it.
    let mut base = 0
    while base < ntot {
        // decode (ix,iy,iz) of `base`
        let iz = base - (base / nz) * nz
        let tmp = base / nz
        let iy = tmp - (tmp / ny) * ny
        let ix = tmp / ny
        // is this the start of a line along `axis`? (axis-coord == 0)
        let mut is_start = 0
        if axis == 0 { if ix == 0 { is_start = 1 } }
        if axis == 1 { if iy == 0 { is_start = 1 } }
        if axis == 2 { if iz == 0 { is_start = 1 } }
        if is_start == 1 {
            // gather the line into the reusable scratch (conjugate input on inverse)
            let mut t = 0
            while t < alen {
                let gidx = base + t * astride
                let _ = farr_set(lre, t, farr_get(wre, gidx))
                if inverse == 0 {
                    let _ = farr_set(lim, t, farr_get(wim, gidx))
                } else {
                    let _ = farr_set(lim, t, 0.0 - farr_get(wim, gidx))
                }
                t = t + 1
            }
            // 1D forward butterfly (same core as fft_native/ifft_native)
            _cf_fft_inplace(lre, lim, alen)
            // scatter back; on inverse, conjugate output and scale by 1/alen so
            // three passes accumulate exactly 1/(Nx·Ny·Nz). Bit-identical to the
            // prior fft_native/ifft_native-per-line path.
            let mut s = 0
            while s < alen {
                let gidx = base + s * astride
                if inverse == 0 {
                    let _ = farr_set(wre, gidx, farr_get(lre, s))
                    let _ = farr_set(wim, gidx, farr_get(lim, s))
                } else {
                    let _ = farr_set(wre, gidx, farr_get(lre, s) * inv_a)
                    let _ = farr_set(wim, gidx, (0.0 - farr_get(lim, s)) * inv_a)
                }
                s = s + 1
            }
        }
        base = base + 1
    }
    let _ = farr_free(lre)
    let _ = farr_free(lim)
}

// ── _is_pow2: true (1) iff n>0 and a power of two ────────────────────────────
fn _cf_is_pow2(n: int) -> int {
    if n <= 0 { return 0 }
    let mut v = n
    while v > 1 {
        if v - (v / 2) * 2 != 0 { return 0 }   // odd factor ⇒ not pow2
        v = v / 2
    }
    return 1
}

// ── _fft3_run: shared forward/inverse driver (inverse handles 1/N scaling) ───
fn _fft3_run(re: [float], im: [float], nx: int, ny: int, nz: int, inverse: int) -> [float] {
    // malformed-dims guard: each axis must be an independent power of 2, and
    // the input arrays must both be exactly Nx·Ny·Nz long.
    if _cf_is_pow2(nx) == 0 { return [] }
    if _cf_is_pow2(ny) == 0 { return [] }
    if _cf_is_pow2(nz) == 0 { return [] }
    let ntot = nx * ny * nz
    if len(re) != ntot { return [] }
    // im == [] is the real-input fast path (fft3_real): imaginary part is all
    // zeros, synthesized directly into the farr below — no `zim` array to leak.
    let im_zero = len(im) == 0
    if im_zero == false { if len(im) != ntot { return [] } }

    // `farr` working buffers — the ONLY whole-grid allocation, transformed in
    // place across all three passes and freed before return (handoff 16083ab3).
    let wre = farr_zeros(ntot)
    let wim = farr_zeros(ntot)   // farr_zeros already 0-fills, so the real path is a no-op
    let mut c = 0
    while c < ntot {
        let _ = farr_set(wre, c, re[c])
        if im_zero == false { let _ = farr_set(wim, c, im[c]) }
        c = c + 1
    }

    // pass order: z (axis 2) → y (axis 1) → x (axis 0). Order is immaterial
    // for a separable transform; innermost-first is cache-friendliest.
    let mut axis = 2
    while axis >= 0 {
        _fft3_axis_pass_farr(wre, wim, nx, ny, nz, axis, inverse)
        axis = axis - 1
    }

    // For the inverse, each 1D pass divides by its axis length, so the cumulative
    // scaling after three passes is 1/(Nx·Ny·Nz) = 1/N exactly — no extra global
    // scale is needed. (Forward applies no scale.)

    // pack output as INTERLEAVED [re0, im0, re1, im1, ...] (matches fft_native).
    let mut out = []
    let mut o = 0
    while o < ntot {
        out = out.push(farr_get(wre, o))
        out = out.push(farr_get(wim, o))
        o = o + 1
    }
    let _ = farr_free(wre)
    let _ = farr_free(wim)
    return out
}

// ── fft3_farr_inplace: in-place 3D FFT on caller-owned `farr` buffers ─────────
//   re/im are farr handles (int) the CALLER allocates (farr_zeros) and frees
//   (farr_free) — reused across many transforms (e.g. one per band in an SCF
//   density loop) so NO per-call [float] output array is built (which would
//   heap-promote + orphan in the val-arena → OOM on large grids). Transforms the
//   caller's buffers IN PLACE: on return re/im hold the (forward/inverse) result.
//   inverse=1 applies the 1/N scale (three 1/alen passes). The line scratch inside
//   each axis pass is the only allocation and it is freed there. Same pow2 guards.
pub fn fft3_farr_inplace(re: int, im: int, nx: int, ny: int, nz: int, inverse: int) {
    if _cf_is_pow2(nx) == 0 { return }
    if _cf_is_pow2(ny) == 0 { return }
    if _cf_is_pow2(nz) == 0 { return }
    let mut axis = 2
    while axis >= 0 {
        _fft3_axis_pass_farr(re, im, nx, ny, nz, axis, inverse)
        axis = axis - 1
    }
}

// ── fft3(re, im, nx, ny, nz): forward 3D FFT ─────────────────────────────────
//
//   X[kx,ky,kz] = Σ x[ix,iy,iz] · e^{-j2π(kx·ix/Nx + ky·iy/Ny + kz·iz/Nz)}
//
// Input: split flat re[]/im[] (length Nx·Ny·Nz, row-major idx=((ix·Ny)+iy)·Nz+iz).
// Output: interleaved [re0,im0,…] (2·N floats). Each axis must be a power of 2.
// Malformed dims (non-pow2 / size mismatch / non-positive) ⇒ [].
pub fn fft3(re: [float], im: [float], nx: int, ny: int, nz: int) -> [float] {
    return _fft3_run(re, im, nx, ny, nz, 0)
}

// ── ifft3(re, im, nx, ny, nz): inverse 3D FFT (÷ N) ──────────────────────────
//
//   x[ix,iy,iz] = (1/N) Σ X[kx,ky,kz] · e^{+j2π(…)}        N = Nx·Ny·Nz
//
// IFFT3(X) = conj(FFT3(conj(X)))/N, realized as three inverse 1D passes (each
// 1/Nx, 1/Ny, 1/Nz ⇒ cumulative 1/N). Same layout / guards as fft3.
pub fn ifft3(re: [float], im: [float], nx: int, ny: int, nz: int) -> [float] {
    return _fft3_run(re, im, nx, ny, nz, 1)
}

// ── fft3_real(data, nx, ny, nz): real-input convenience ──────────────────────
//
// Mirrors the 1D ergonomics: takes a real-only flat field (length N) and an
// all-zero imaginary part is synthesized internally. Returns the same
// interleaved complex spectrum as fft3. Malformed dims ⇒ [].
pub fn fft3_real(data: [float], nx: int, ny: int, nz: int) -> [float] {
    let ntot = nx * ny * nz
    if len(data) != ntot { return [] }
    // im == [] selects _fft3_run's real-input fast path: the all-zero imaginary
    // part is synthesized in the farr working buffer, so no `zim` array is built
    // (and leaked) per call (handoff 16083ab3).
    return _fft3_run(data, [], nx, ny, nz, 0)
}
