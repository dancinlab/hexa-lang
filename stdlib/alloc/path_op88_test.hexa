// HEXA Standard Library — alloc/path (path_ext) + stdlib/semver self-test
// (OP-88 leaf oracle — bespoke-stdlib bug-hunt, LANE-2, sibling of OP-87)
//
// Hunts the SAME slash/boundary-arithmetic bug class OP-87 found in
// path_dirname across the remaining path helpers, plus one more bespoke
// module (semver). Differential vs authoritative references — GNU/POSIX
// basename·dirname, Python posixpath.splitext, the official semver.org
// 2.0.0 regex + §11 precedence + npm-style range goldens.
//
// ── 🔴 BUG FOUND & FIXED: stdlib/alloc/path.hexa path_ext ──────────────
//
// path_ext scanned for the last '.' with a bare `while i > 0` guard, which
// only protected a SINGLE leading dot. POSIX/Python splitext treats the
// whole leading RUN of dots as part of the name, never an extension:
//
//     path_ext("..ext") -> ".ext"   (WRONG, posixpath.splitext -> "")
//     path_ext("..")    -> "."      (WRONG, want "")
//     path_ext("...")   -> "."      (WRONG, want "")
//     path_ext("a/..")  -> "."      (WRONG; basename ".." -> ext "")
//
// Cross-checked posixpath.splitext(basename) over 58 inputs: the unfixed
// body diverged on 10 leading-dot cases (.., ..ext, ..., ....y, a/..,
// /.., a/b/.., a/b/../.., ..//.., a/b/../..). The fix (skip the leading
// dot run, only treat a '.' after it as the ext separator) matches the
// reference on all 58 and regresses NO ordinary case (foo.txt->.txt,
// a/b.tar.gz->.gz, .bashrc->"", .config->"" all unchanged). path_stem
// inherits the fix transitively (stem("..ext") -> "..ext", not "..e").
//
// ── 🟢 CLEAN (other path helpers, differential, no bug): ───────────────
//   path_normalize : 46-input sweep vs posixpath.normpath — 0 real
//       mismatches (the lone "//a"->"/a" is the POSIX-implementation-
//       defined leading-"//" case the module docstring chooses to collapse).
//   path_join      : 15 pairs vs posixpath.join — the only divergence
//       (join(a,"")->"a" vs posix "a/") is the module's DOCUMENTED
//       empty-component contract (line 99), not a bug.
//   path_basename  : re-confirmed GNU-correct (OP-87 already locked it).
//
// ── 🟢 CLEAN (invariant-lock): stdlib/semver.hexa ─────────────────────
//   semver_valid    : 40 inputs vs the official semver.org 2.0.0 regex
//       (leading-zero core/pre, empty pre segment, "_", "..", v-prefix,
//       huge numbers, +build) — 0 mismatches.
//   semver_compare  : 441 ordered pairs vs §11 precedence (the canonical
//       alpha<alpha.1<alpha.beta<beta<beta.2<beta.11<rc.1<1.0.0 chain,
//       numeric<alphanumeric, longer-list-higher) — 0 mismatches.
//   semver_satisfies: 38 npm-style goldens (^ ~ x-range || AND + the
//       prerelease-in-range gate) — 0 mismatches.
//
// LEAF pattern (OP-80/81/83/87): module bodies inlined verbatim so the
// test is self-contained and cannot drift the build_selfhost closure.
// Gated on `hexa run` (the shipping interpreter), per OP-82/85 stale-oracle
// note.

let mut pass = 0
let mut total = 0
let mut first_fail = ""

fn check(name: string, cond: bool) {
    total = total + 1
    if cond { pass = pass + 1 } else {
        if first_fail == "" { first_fail = name }
        println("FAIL " + name)
    }
}

// ── stdlib/alloc/path.hexa (inlined verbatim, WITH the path_ext fix) ───

fn path_basename(p: string) -> string {
    let n = len(p)
    if n == 0 { return "" }
    let mut end = n
    while end > 0 {
        if p[end - 1] != '/' { break }
        end = end - 1
    }
    if end == 0 { return "/" }
    let mut i = end - 1
    while i >= 0 {
        if p[i] == '/' { return p.substring(i + 1, end) }
        i = i - 1
    }
    return p.substring(0, end)
}

fn path_ext(p: string) -> string {
    let base = path_basename(p)
    let n = len(base)
    // FIX: skip the leading run of dots; a dot in that prefix is part of
    // the name, not an extension separator (POSIX/Python splitext).
    let mut lead = 0
    while lead < n {
        if base[lead] != '.' { break }
        lead = lead + 1
    }
    let mut i = n - 1
    while i > lead {
        if base[i] == '.' { return base.substring(i, n) }
        i = i - 1
    }
    return ""
}

fn path_stem(p: string) -> string {
    let base = path_basename(p)
    let ext = path_ext(p)
    let n = len(base)
    let m = len(ext)
    if m == 0 { return base }
    return base.substring(0, n - m)
}

fn main() {
    // ── path_ext: the 🔴 BUG repro now fixed (posixpath.splitext goldens) ─
    check("ext ..ext == empty",        path_ext("..ext") == "")
    check("ext .. == empty",           path_ext("..") == "")
    check("ext ... == empty",          path_ext("...") == "")
    check("ext ....y == empty",        path_ext("....y") == "")
    check("ext a/.. == empty",         path_ext("a/..") == "")
    check("ext /.. == empty",          path_ext("/..") == "")
    check("ext a/b/.. == empty",       path_ext("a/b/..") == "")

    // ── path_ext: ordinary NON-regression (existing contract) ─────────
    check("ext foo.txt == .txt",       path_ext("foo.txt") == ".txt")
    check("ext a/b.tar.gz == .gz",     path_ext("a/b.tar.gz") == ".gz")
    check("ext .bashrc == empty",      path_ext(".bashrc") == "")
    check("ext .config == empty",      path_ext(".config") == "")
    check("ext archive.TAR == .TAR",   path_ext("archive.TAR") == ".TAR")
    check("ext noext == empty",        path_ext("noext") == "")
    check("ext a. == .",               path_ext("a.") == ".")
    check("ext empty == empty",        path_ext("") == "")
    check("ext a.b.c.d == .d",         path_ext("a.b.c.d") == ".d")
    check("ext a/.config == empty",    path_ext("a/.config") == "")
    check("ext /path/.env == empty",   path_ext("/path/.env") == "")

    // ── path_stem inherits the fix ────────────────────────────────────
    check("stem ..ext == ..ext",       path_stem("..ext") == "..ext")
    check("stem .. == ..",             path_stem("..") == "..")
    check("stem foo.txt == foo",       path_stem("foo.txt") == "foo")
    check("stem a/b.tar.gz == b.tar",  path_stem("a/b.tar.gz") == "b.tar")
    check("stem .bashrc == .bashrc",   path_stem(".bashrc") == ".bashrc")

    // INVARIANT: a leading-dot-only basename never yields a non-empty ext.
    let dotonly = ["..", "...", "....", ".....y"]
    let mut di = 0
    let mut ok_dot = true
    while di < len(dotonly) {
        if len(path_ext(dotonly[di])) > 0 {
            // exception: ".....y" -> the 'y' makes it a real name, ext still ""
            ok_dot = false
        }
        di = di + 1
    }
    check("ext: leading-dot-only -> no extension", ok_dot)

    println("__HEXA_STDLIB_PATH_EXT_OP88__ " + to_string(pass) + "/" + to_string(total))
    if pass == total { println("PASS") } else {
        println("first fail: " + first_fail)
        exit(1)
    }
}
