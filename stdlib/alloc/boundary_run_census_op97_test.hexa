// HEXA Standard Library — boundary-run-collapse census self-test
// (OP-97 leaf oracle — bespoke-stdlib bug-hunt, LANE-1, 0-pod)
//
// SYSTEMIC census of the boundary-run-collapse bug class that surfaced in
// OP-87 (path_dirname) + OP-88 (path_ext): a `while`/index scan over a
// string that advances by 1 over a delimiter/boundary char and FAILS to
// SKIP/COLLAPSE *consecutive runs* of that char, leaking or miscounting at
// runs (trailing/leading-separator strip, consecutive-separator collapse,
// whitespace-run skip in a tokenizer, leading/trailing zero-byte run).
//
// CENSUS RESULT (scoped greps, NO .git; LANE-1 NUMERIC/DATA/PARSER + path/
// string siblings; self/serve/* EXCLUDED = LANE-2): every run-handling site
// OUTSIDE the already-fixed OP-87/88 pair is CLEAN — each uses the correct
// run-collapse pattern (a run-skip inner loop, filter-empty-after-split, or
// accumulate-the-whole-run). NO new shipping bug found (g5 honest; the class
// is CLOSED in LANE-1 stdlib). This leaf LOCKS the representative CLEAN
// bodies, verbatim-inlined, against inputs carrying 0/1/2/3 consecutive
// boundary chars at start / mid / end.
//
// Bodies inlined verbatim (each PROVEN-CLEAN in the census):
//   stdlib_cli.hexa             _trim          (leading+trailing ws-run strip)
//   easy/cli.hexa               _word_count    (ws-run collapse state machine)
//   kernels/circuit/devsim.hexa _split_ws      (filter-empty-token tokenizer;
//                                same shape as verilog/_rv_tokens + anynet)
//   codec/base64.hexa           ws-skip count  (whitespace run skip in decode)
//   crypto/tls13...record_io    trailing 0-run (RFC 8446 §5.4 zero-pad strip)
//   crypto/x509_rsa.hexa        leading 0-run  (DER sign-byte strip)
//   alloc/path.hexa             path_normalize (split"/"+filter-empty collapse,
//                                OP-88-confirmed double-slash collapse)
//
// Gated on the SHIPPING `hexa run` interpreter (OP-87/88 lesson: the
// installed `hexa` resolves `use` to a STALE bundled copy → inline verbatim,
// self-contained, no `use`). NOT in the build_selfhost closure → fixpoint
// UNAFFECTED.

let mut pass = 0
let mut total = 0
let mut first_fail = ""

fn check(name: string, cond: bool) {
    total = total + 1
    if cond { pass = pass + 1 } else {
        if first_fail == "" { first_fail = name }
        println("FAIL " + name)
    }
}

// ── stdlib_cli.hexa _trim (verbatim) ──────────────────────────────────
fn cli_trim(s: string) -> string {
    let n = len(s)
    let mut a = 0
    while a < n {
        let c = s.substring(a, a + 1)
        if c != " " && c != "\t" && c != "\r" { break }
        a = a + 1
    }
    let mut b = n
    while b > a {
        let c = s.substring(b - 1, b)
        if c != " " && c != "\t" && c != "\r" { break }
        b = b - 1
    }
    return s.substring(a, b)
}

// ── easy/cli.hexa _word_count (verbatim) ──────────────────────────────
fn word_count(s: string) -> int {
    let slen = len(s)
    let mut n = 0
    let mut in_tok = false
    let mut i = 0
    while i < slen {
        let c = s.substring(i, i + 1)
        let ws = c == " " || c == "\n" || c == "\t" || c == "\r"
        if ws {
            in_tok = false
        } else {
            if !in_tok { n = n + 1 }
            in_tok = true
        }
        i = i + 1
    }
    return n
}

// ── kernels/circuit/devsim.hexa _split_ws (verbatim) ──────────────────
// Returns the number of non-empty tokens (proxy for the [str] result).
fn split_ws_count(s: string) -> int {
    let mut cnt = 0
    let mut cur = ""
    let mut i = 0
    let n = len(s)
    while i < n {
        let ch = s.substring(i, i + 1)
        let is_sp = ch == " " || ch == "\t" || ch == "\r"
        if is_sp {
            if cur != "" { cnt = cnt + 1 }
            cur = ""
        } else {
            cur = cur + ch
        }
        i = i + 1
    }
    if cur != "" { cnt = cnt + 1 }
    return cnt
}

// ── codec/base64.hexa whitespace-skip data-char count (verbatim shape) ─
fn b64_ws_count(s: string) -> int {
    let n = len(s)
    let mut idxs = 0
    let mut i = 0
    while i < n {
        let c = ord(s.substring(i, i + 1))
        if c == 9 || c == 10 || c == 13 || c == 32 {
            // whitespace — skip
        } else if c == 61 {
            // '=' pad — skip from data count
        } else {
            idxs = idxs + 1
        }
        i = i + 1
    }
    return idxs
}

// ── crypto/tls13 trailing zero-run strip (verbatim) → last non-zero idx ─
fn tls_trailing_nonzero(plain: [int]) -> int {
    let mut i = -1
    let mut end = len(plain) - 1
    while end >= 0 {
        if plain[end] != 0 {
            i = end
            end = -1
        } else {
            end = end - 1
        }
    }
    return i
}

// ── crypto/x509_rsa leading zero-run strip (verbatim) → remaining count ─
fn x509_leading_strip_count(bytes: [int]) -> int {
    let mut start = 0
    let mut count = len(bytes)
    while count > 0 && (bytes[start] & 0xFF) == 0 { start = start + 1; count = count - 1 }
    return count
}

// ── alloc/path.hexa path_normalize collapse (verbatim, no-"." subset) ──
// Splits on "/" and filters empty segments → consecutive slashes collapse.
fn path_collapse(p: string) -> string {
    if len(p) == 0 { return "." }
    let abs = len(p) > 0 && p[0] == '/'
    let segs = p.split("/")
    let mut out = []
    let mut i = 0
    while i < len(segs) {
        let s = segs[i]
        if len(s) > 0 { out.push(s) }
        i = i + 1
    }
    let body = out.join("/")
    if abs {
        let mut q = []
        q.push("/")
        q.push(body)
        return q.join("")
    }
    if len(body) == 0 { return "." }
    return body
}

fn main() {
    // ── _trim: 0/1/2/3 ws runs at start / mid / end must all strip ─────
    check("trim('') == ''",               cli_trim("") == "")
    check("trim('x') == 'x'",             cli_trim("x") == "x")
    check("trim('  x') == 'x'",           cli_trim("  x") == "x")          // 2 lead
    check("trim('x   ') == 'x'",          cli_trim("x   ") == "x")         // 3 trail
    check("trim('   x   ') == 'x'",       cli_trim("   x   ") == "x")
    check("trim('\\t\\t a b \\r\\r')",     cli_trim("\t\t a b \r\r") == "a b")
    check("trim('   ') == '' (all ws)",   cli_trim("   ") == "")

    // ── _word_count: ws runs collapse (no phantom empty words) ─────────
    check("wc('') == 0",                  word_count("") == 0)
    check("wc('a') == 1",                 word_count("a") == 1)
    check("wc('a b') == 2",               word_count("a b") == 2)
    check("wc('a  b') == 2 (run)",        word_count("a  b") == 2)
    check("wc('  a   b  ') == 2",         word_count("  a   b  ") == 2)
    check("wc('a\\t\\tb\\n\\nc') == 3",    word_count("a\t\tb\n\nc") == 3)
    check("wc('   ') == 0",               word_count("   ") == 0)

    // ── _split_ws: consecutive separators yield NO empty tokens ────────
    check("split_ws('a b') == 2",         split_ws_count("a b") == 2)
    check("split_ws('a  b') == 2 (run)",  split_ws_count("a  b") == 2)
    check("split_ws('  a   b  ') == 2",   split_ws_count("  a   b  ") == 2)
    check("split_ws('\\t a\\tb \\t')==2",  split_ws_count("\t a\tb \t") == 2)
    check("split_ws('') == 0",            split_ws_count("") == 0)
    check("split_ws('   ') == 0",         split_ws_count("   ") == 0)

    // ── base64 ws-skip: whitespace runs collapse; data-char count steady
    check("b64('QUJD') == 4",             b64_ws_count("QUJD") == 4)
    check("b64('Q U J D') == 4",          b64_ws_count("Q U J D") == 4)
    check("b64('Q  U\\nJ\\tD') == 4",      b64_ws_count("Q  U\nJ\tD") == 4)
    check("b64('\\n\\n\\n') == 0",         b64_ws_count("\n\n\n") == 0)
    check("b64('QUJD====') == 4 (pad)",   b64_ws_count("QUJD====") == 4)

    // ── tls13 trailing zero-run strip → last non-zero index ────────────
    check("tls trail 3-zero run",         tls_trailing_nonzero([1, 2, 21, 0, 0, 0]) == 2)
    check("tls trail no pad",             tls_trailing_nonzero([1, 2, 21]) == 2)
    check("tls trail all-zero == -1",     tls_trailing_nonzero([0, 0, 0]) == -1)
    check("tls trail single",             tls_trailing_nonzero([5]) == 0)

    // ── x509 leading zero-run strip → remaining byte count ─────────────
    check("x509 lead 2-zero run -> 2",    x509_leading_strip_count([0, 0, 1, 2]) == 2)
    check("x509 lead 1-zero -> 1",        x509_leading_strip_count([0, 5]) == 1)
    check("x509 lead no zero -> 1",       x509_leading_strip_count([7]) == 1)
    check("x509 lead all-zero -> 0",      x509_leading_strip_count([0, 0, 0]) == 0)

    // ── path_normalize: consecutive slashes COLLAPSE (OP-88 confirmed) ─
    check("collapse('a//b') == 'a/b'",        path_collapse("a//b") == "a/b")
    check("collapse('/foo//bar///baz')",      path_collapse("/foo//bar///baz") == "/foo/bar/baz")
    check("collapse('x///y') == 'x/y'",       path_collapse("x///y") == "x/y")
    check("collapse('/a//b//c')",             path_collapse("/a//b//c") == "/a/b/c")
    check("collapse('a/b/c') unchanged",      path_collapse("a/b/c") == "a/b/c")
    check("collapse('////') == '/'",          path_collapse("////") == "/")

    println("__HEXA_STDLIB_BOUNDARY_RUN_OP97__ " + to_string(pass) + "/" + to_string(total))
    if pass == total { println("PASS") } else {
        println("first fail: " + first_fail)
        exit(1)
    }
}
