// HEXA stdlib — BigInt: native arbitrary-precision signed integer (limb-array)
//
// @version 0.1.0
// @capabilities [stdout]
//
// SUBSTRATE FIX (measured 2026-06-28): hexa `int`/`i64` is 64-bit — NOT arbitrary
// precision (10^40 overflows to a 19-digit garbage value; 2^100 wraps to 0). The
// discovery engine's PCF-constant detection (and any large-int math: factorials,
// combinatorics, exact rationals, crypto) needs hundreds-of-digit integers. This module
// implements BigInt in pure hexa over the existing i64 + array primitives — no new
// builtin, byte-deterministic, no float path.
//
// REPRESENTATION: a BigInt is an array `b` with
//   b[0] = sign  (-1, 0, or 1 ; 0 only for the value zero)
//   b[1..] = magnitude limbs, base BASE=10000, LITTLE-ENDIAN (b[1] = least significant).
// Zero is [0] (sign 0, no limbs). The magnitude is normalized (no leading zero limbs).
//
// LIMB BASE 10000: limb*limb <= 9999^2 ~= 1e8, and schoolbook column sums over ~N limbs
// stay < ~4e9 << i64 max (9.2e18) — overflow-safe carry propagation.
//
// Ops: bi_from(i64) · bi_cmp · bi_add · bi_sub · bi_neg · bi_mul · bi_to_string · bi_ndigits ·
//      bi_abs · bi_divmod_small(small i64 divisor) · bi_div_small · bi_shift10_down ·
//      bi_divmod(full BigInt÷BigInt → [q,r], truncated-toward-zero) · bi_div · bi_mod · bi_gcd.

// ── BASE constant (returned by a fn since hexa has no const literal sharing here) ──
fn _BASE() -> int { 10000 }

// ── number of magnitude limbs ──
fn _nlimb(a) -> int { a.len() - 1 }

// ── strip leading-zero limbs and fix sign if the value is zero ──
fn _norm(a) -> array {
    let n = a.len()
    // find highest non-zero limb index
    let hi = n - 1
    while hi >= 1 {
        if a[hi] != 0 { break }
        hi = hi - 1
    }
    if hi == 0 {
        let z = []
        z.push(0)
        return z
    }
    let out = []
    out.push(a[0])
    let i = 1
    while i <= hi {
        out.push(a[i])
        i = i + 1
    }
    out
}

// ── construct BigInt from an i64 (|x| must fit i64; full range ok) ──
fn bi_from(x) -> array {
    let out = []
    if x == 0 {
        out.push(0)
        return out
    }
    let sign = 1
    let v = x
    if v < 0 {
        sign = 0 - 1
        v = 0 - v
    }
    out.push(sign)
    let base = _BASE()
    while v > 0 {
        out.push(v % base)
        v = v / base
    }
    out
}

// ── compare magnitudes only: -1 if |a|<|b|, 0 if equal, 1 if |a|>|b| ──
fn _cmp_mag(a, b) -> int {
    let na = _nlimb(a)
    let nb = _nlimb(b)
    if na < nb { return 0 - 1 }
    if na > nb { return 1 }
    let i = na
    while i >= 1 {
        if a[i] < b[i] { return 0 - 1 }
        if a[i] > b[i] { return 1 }
        i = i - 1
    }
    0
}

// ── signed compare: -1 / 0 / 1 ──
fn bi_cmp(a, b) -> int {
    let sa = a[0]
    let sb = b[0]
    if sa < sb { return 0 - 1 }
    if sa > sb { return 1 }
    // same sign
    if sa == 0 { return 0 }
    let m = _cmp_mag(a, b)
    if sa > 0 { return m }
    0 - m
}

// ── magnitude addition |a|+|b| -> normalized positive-magnitude limb array (sign set to 1) ──
fn _add_mag(a, b) -> array {
    let base = _BASE()
    let na = _nlimb(a)
    let nb = _nlimb(b)
    let n = na
    if nb > n { n = nb }
    let out = []
    out.push(1)
    let carry = 0
    let i = 1
    while i <= n {
        let da = 0
        if i <= na { da = a[i] }
        let db = 0
        if i <= nb { db = b[i] }
        let s = da + db + carry
        out.push(s % base)
        carry = s / base
        i = i + 1
    }
    if carry > 0 { out.push(carry) }
    _norm(out)
}

// ── magnitude subtraction |a|-|b|, REQUIRES |a| >= |b| -> sign 1 (or 0 if zero) ──
fn _sub_mag(a, b) -> array {
    let base = _BASE()
    let na = _nlimb(a)
    let nb = _nlimb(b)
    let out = []
    out.push(1)
    let br = 0
    let i = 1
    while i <= na {
        let da = a[i]
        let db = 0
        if i <= nb { db = b[i] }
        let s = da - db - br
        if s < 0 {
            s = s + base
            br = 1
        } else {
            br = 0
        }
        out.push(s)
        i = i + 1
    }
    _norm(out)
}

// ── signed negate ──
fn bi_neg(a) -> array {
    let out = []
    out.push(0 - a[0])
    let i = 1
    while i < a.len() {
        out.push(a[i])
        i = i + 1
    }
    out
}

// ── signed add ──
fn bi_add(a, b) -> array {
    let sa = a[0]
    let sb = b[0]
    if sa == 0 { return b }
    if sb == 0 { return a }
    if sa == sb {
        let m = _add_mag(a, b)
        m[0] = sa
        return _norm(m)
    }
    // opposite signs: subtract smaller magnitude from larger
    let c = _cmp_mag(a, b)
    if c == 0 {
        let z = []
        z.push(0)
        return z
    }
    if c > 0 {
        let m = _sub_mag(a, b)
        m[0] = sa
        return _norm(m)
    }
    let m2 = _sub_mag(b, a)
    m2[0] = sb
    _norm(m2)
}

// ── signed subtract a - b ──
fn bi_sub(a, b) -> array {
    bi_add(a, bi_neg(b))
}

// ── signed multiply (schoolbook) ──
fn bi_mul(a, b) -> array {
    let sa = a[0]
    let sb = b[0]
    if sa == 0 { return a }
    if sb == 0 { return b }
    let base = _BASE()
    let na = _nlimb(a)
    let nb = _nlimb(b)
    // result magnitude has up to na+nb limbs
    let res = []
    let k = 0
    while k < na + nb {
        res.push(0)
        k = k + 1
    }
    let i = 1
    while i <= na {
        let carry = 0
        let j = 1
        while j <= nb {
            let idx = i + j - 2          // 0-based position in res
            let cur = res[idx] + a[i] * b[j] + carry
            res[idx] = cur % base
            carry = cur / base
            j = j + 1
        }
        // propagate remaining carry
        let idx2 = i + nb - 1
        while carry > 0 {
            let cur2 = res[idx2] + carry
            res[idx2] = cur2 % base
            carry = cur2 / base
            idx2 = idx2 + 1
        }
        i = i + 1
    }
    // assemble: out[0]=sign, out[1..]=res limbs
    let out = []
    out.push(sa * sb)
    let m = 0
    while m < res.len() {
        out.push(res[m])
        m = m + 1
    }
    _norm(out)
}

// ── decimal string (sign + digits) ──
fn _pad4(x) {
    // 4-char zero-padded decimal of a limb in [0,9999] — no string.len() (range-based)
    let s = to_string(x)
    if x < 10 { return "000" + s }
    if x < 100 { return "00" + s }
    if x < 1000 { return "0" + s }
    s
}

fn bi_to_string(a) {
    if a[0] == 0 { return "0" }
    let na = _nlimb(a)
    let s = to_string(a[na])      // most significant limb, no pad
    let i = na - 1
    while i >= 1 {
        s = s + _pad4(a[i])
        i = i - 1
    }
    if a[0] < 0 { s = "-" + s }
    s
}

// ── number of decimal digits of |a| ──
fn bi_ndigits(a) -> int {
    if a[0] == 0 { return 1 }
    let na = _nlimb(a)
    let top = a[na]
    let topd = 0
    let v = top
    while v > 0 { v = v / 10; topd = topd + 1 }
    topd + 4 * (na - 1)
}

// ── small-divisor division: |a| / d where d is a positive i64 fitting d*BASE < i64 max.
//    Returns [quotient BigInt (sign = sign of a), remainder i64 (>=0)]. Schoolbook long
//    division over base-BASE limbs, most-significant first. For full BigInt/BigInt division
//    use a separate routine; this covers high-precision series (arctan, zeta) where every
//    divisor (x^2, 2k+1) is a small integer. ──
fn bi_divmod_small(a, d) -> array {
    if a[0] == 0 {
        let z = []
        z.push(0)
        let r0 = []
        r0.push(z)
        r0.push(0)
        return r0
    }
    let na = _nlimb(a)
    // big-endian quotient limbs
    let qbig = []
    let rem = 0
    let i = na
    while i >= 1 {
        let cur = rem * 10000 + a[i]
        qbig.push(cur / d)
        rem = cur % d
        i = i - 1
    }
    // assemble little-endian: out[0]=sign, then reverse qbig
    let out = []
    out.push(a[0])
    let j = qbig.len() - 1
    while j >= 0 {
        out.push(qbig[j])
        j = j - 1
    }
    let res = []
    res.push(_norm(out))
    res.push(rem)
    res
}

// quotient-only convenience (|a| / d, d positive i64) ──
fn bi_div_small(a, d) -> array {
    let qr = bi_divmod_small(a, d)
    qr[0]
}

// ── decimal right-shift: floor(|a| / 10^e) (sign preserved). Drops the lowest e decimal
//    digits. e = 4q + r over base-10000 limbs: drop q whole limbs (little-endian low end),
//    then divide the remainder by 10^r (small divisor). Exact floor. ──
fn bi_shift10_down(a, e) -> array {
    if a[0] == 0 { let z = []; z.push(0); return z }
    let q = e / 4
    let r = e % 4
    let na = _nlimb(a)
    if na <= q {
        // all magnitude limbs dropped → remainder may still leave <10^r; result 0 unless r
        // leaves a partial top limb. Conservative: if na <= q the value < 10^(4q) <= 10^e → 0.
        if na < q { let z = []; z.push(0); return z }
        // na == q: value < 10^(4q) ; dividing by 10^e=10^(4q+r) → 0
        let z = []; z.push(0); return z
    }
    // drop lowest q limbs
    let out = []
    out.push(a[0])
    let i = q + 1
    while i <= na { out.push(a[i]); i = i + 1 }
    let shifted = _norm(out)
    if r == 0 { return shifted }
    let dv = 1
    let t = 0
    while t < r { dv = dv * 10; t = t + 1 }
    bi_div_small(shifted, dv)
}

// ── magnitude-only helpers for full division (operate on |a|, sign forced to 1) ──
// |a| from a signed BigInt (sign-1 copy) ──
fn bi_abs(a) -> array {
    if a[0] == 0 { let z = []; z.push(0); return z }
    let out = []
    out.push(1)
    let i = 1
    while i < a.len() { out.push(a[i]); i = i + 1 }
    out
}

// magnitude × small i64 limb-multiplier m in [0,9999]; arg already sign-1; returns sign-1 magnitude ──
fn _mul_small_mag(a, m) -> array {
    if a[0] == 0 { let z = []; z.push(0); return z }
    if m == 0 { let z = []; z.push(0); return z }
    let base = _BASE()
    let na = _nlimb(a)
    let out = []
    out.push(1)
    let carry = 0
    let i = 1
    while i <= na {
        let cur = a[i] * m + carry
        out.push(cur % base)
        carry = cur / base
        i = i + 1
    }
    while carry > 0 {
        out.push(carry % base)
        carry = carry / base
    }
    _norm(out)
}

// ── full BigInt ÷ BigInt → [quotient, remainder]. Truncated toward zero:
//    |q| = floor(|a|/|b|), sign(q) = sign(a)*sign(b); sign(r) = sign(a), |r| < |b|.
//    Algorithm: schoolbook long division, most-significant limb first (base-10000).
//    For each incoming limb we append it to a running remainder BigInt `rem`, then find the
//    quotient digit d in [0,9999] with d*|b| <= rem < (d+1)*|b| by BINARY SEARCH over the limb
//    (every candidate tested with exact BigInt compare — no fragile 2-limb estimate). This is
//    the classic restoring long-division (cf. any reference long-division pseudocode, e.g.
//    Knuth TAOCP Vol.2 §4.3.1 Algorithm D, here with a per-digit bisection instead of the
//    q-hat estimate-and-correct step). O(n_limbs · log BASE · n_limbs) — fine for stdlib sizes.
//    b == 0 → SENTINEL: returns [ [0], a ] (quotient 0, remainder = a). Callers must guard. ──
fn bi_divmod(a, b) -> array {
    // b == 0 sentinel
    if b[0] == 0 {
        let z = []; z.push(0)
        let res0 = []
        res0.push(z)
        res0.push(a)
        return res0
    }
    let sa = a[0]
    let sb = b[0]
    // a == 0 → quotient 0, remainder 0
    if sa == 0 {
        let z = []; z.push(0)
        let z2 = []; z2.push(0)
        let r0 = []
        r0.push(z)
        r0.push(z2)
        return r0
    }
    let am = bi_abs(a)
    let bm = bi_abs(b)
    // |a| < |b| → quotient 0, remainder = a (sign sa)
    if _cmp_mag(am, bm) < 0 {
        let z = []; z.push(0)
        let r0 = []
        r0.push(z)
        r0.push(a)
        return r0
    }
    let na = _nlimb(am)
    // big-endian quotient limbs accumulated here
    let qbig = []
    // running remainder magnitude (sign-1), starts at 0
    let rem = []
    rem.push(0)
    let idx = na
    while idx >= 1 {
        // rem = rem * BASE + am[idx]   (shift one limb up, add new low limb)
        rem = _mul_small_mag(rem, _BASE())
        let addlimb = bi_from(am[idx])      // am[idx] in [0,9999] fits i64
        rem = bi_add(rem, addlimb)          // both non-negative → magnitude add, sign 1 (or 0)
        // binary search digit d in [0,9999]: largest d with d*|b| <= rem
        let lo = 0
        let hi = _BASE() - 1
        let d = 0
        while lo <= hi {
            let mid = (lo + hi) / 2
            let prod = _mul_small_mag(bm, mid)     // mid*|b|, sign-1
            let c = bi_cmp(prod, rem)              // both sign-1 (or 0) → magnitude compare
            if c <= 0 {
                d = mid
                lo = mid + 1
            } else {
                hi = mid - 1
            }
        }
        qbig.push(d)
        // rem = rem - d*|b|
        if d > 0 {
            let sub = _mul_small_mag(bm, d)
            rem = bi_sub(rem, sub)
        }
        idx = idx - 1
    }
    // assemble quotient little-endian: [sign, limbs...] reversing qbig
    let qout = []
    qout.push(sa * sb)
    let j = qbig.len() - 1
    while j >= 0 {
        qout.push(qbig[j])
        j = j - 1
    }
    let quot = _norm(qout)
    // remainder sign = sa (rem currently sign-1 or 0)
    let remout = []
    if rem[0] == 0 {
        remout.push(0)
    } else {
        remout.push(sa)
        let t = 1
        while t < rem.len() { remout.push(rem[t]); t = t + 1 }
    }
    let res = []
    res.push(quot)
    res.push(_norm(remout))
    res
}

// ── full remainder a mod b (sign of a, |r| < |b|) ──
fn bi_mod(a, b) -> array {
    let qr = bi_divmod(a, b)
    qr[1]
}

// ── full quotient a / b (truncated toward zero) ──
fn bi_div(a, b) -> array {
    let qr = bi_divmod(a, b)
    qr[0]
}

// ── Euclidean gcd(|a|,|b|) → non-negative BigInt (gcd(0,0)=0). Uses full BigInt remainder. ──
fn bi_gcd(a, b) -> array {
    let x = bi_abs(a)
    let y = bi_abs(b)
    while y[0] != 0 {
        let r = bi_mod(x, y)
        x = y
        // r magnitude (already sign-1 since x=|.| , y=|.| non-negative → rem sign follows x sign =1)
        y = bi_abs(r)
    }
    x
}

// ── selftest ──
fn _gate(label, got, want) -> int {
    if got == want {
        println("  [PASS] " + label)
        return 0
    }
    println("  [FAIL] " + label + "  got=" + got + " want=" + want)
    1
}

fn main() {
    println("=== bigint SELFTEST (native arbitrary-precision over i64+arrays) ===")
    let fails = 0

    // 2^100 = 1267650600228229401496703205376
    let two = bi_from(2)
    let p = bi_from(1)
    let i = 0
    while i < 100 {
        p = bi_mul(p, two)
        i = i + 1
    }
    fails = fails + _gate("2^100 = 1267650600228229401496703205376", bi_to_string(p), "1267650600228229401496703205376")

    // 10^40
    let ten = bi_from(10)
    let q = bi_from(1)
    let j = 0
    while j < 40 {
        q = bi_mul(q, ten)
        j = j + 1
    }
    fails = fails + _gate("10^40 = 1e40 (41 digits)", bi_to_string(q), "10000000000000000000000000000000000000000")
    fails = fails + _gate("10^40 ndigits = 41", to_string(bi_ndigits(q)), "41")

    // 25! = 15511210043330985984000000
    let f = bi_from(1)
    let k = 1
    while k <= 25 {
        f = bi_mul(f, bi_from(k))
        k = k + 1
    }
    fails = fails + _gate("25! = 15511210043330985984000000", bi_to_string(f), "15511210043330985984000000")

    // signed add/sub: (10^40) - (10^40 - 1) = 1 ; (-2^100) + 2^100 = 0
    let qm1 = bi_sub(q, bi_from(1))
    fails = fails + _gate("10^40 - (10^40 - 1) = 1", bi_to_string(bi_sub(q, qm1)), "1")
    fails = fails + _gate("(-2^100) + 2^100 = 0", bi_to_string(bi_add(bi_neg(p), p)), "0")

    // cmp: 2^100 vs 10^40 (10^40 ~ 1e40 > 2^100 ~ 1.27e30)
    fails = fails + _gate("cmp(2^100, 10^40) = -1", to_string(bi_cmp(p, q)), "-1")
    // negative cmp
    fails = fails + _gate("cmp(-2^100, 2^100) = -1", to_string(bi_cmp(bi_neg(p), p)), "-1")

    // divmod_small: 25! / 7 = 2215887149047283712000000 r 0 ; 10^40 / 7 = ... r 1
    let dm1 = bi_divmod_small(f, 7)
    fails = fails + _gate("25!/7 quotient", bi_to_string(dm1[0]), "2215887149047283712000000")
    fails = fails + _gate("25!/7 remainder = 0", to_string(dm1[1]), "0")
    let dm2 = bi_divmod_small(q, 7)
    fails = fails + _gate("10^40 / 7 remainder = 4", to_string(dm2[1]), "4")
    fails = fails + _gate("10^40 / 7 quotient", bi_to_string(dm2[0]), "1428571428571428571428571428571428571428")

    // ── full BigInt ÷ BigInt (bi_divmod) ──
    // 7^13 = 96889010407 (fits i64) but build it as BigInt via repeated multiply for a real divisor
    let seven = bi_from(7)
    let b713 = bi_from(1)
    let t = 0
    while t < 13 { b713 = bi_mul(b713, seven); t = t + 1 }
    fails = fails + _gate("7^13 = 96889010407", bi_to_string(b713), "96889010407")
    // 10^40 ÷ 7^13  (q has 41 digits worth: reference from python divmod)
    let dq = bi_divmod(q, b713)
    fails = fails + _gate("10^40 / 7^13 quotient", bi_to_string(dq[0]), "103210879727155556146643346322")
    fails = fails + _gate("10^40 / 7^13 remainder", bi_to_string(dq[1]), "90436826946")
    // verify q*divisor + r == dividend
    let recon = bi_add(bi_mul(dq[0], b713), dq[1])
    fails = fails + _gate("10^40 / 7^13 reconstruct (q*b+r=a)", bi_to_string(recon), bi_to_string(q))

    // 25! ÷ 13!  exact (remainder 0)
    let f13 = bi_from(1)
    let k13 = 1
    while k13 <= 13 { f13 = bi_mul(f13, bi_from(k13)); k13 = k13 + 1 }
    let dq2 = bi_divmod(f, f13)
    fails = fails + _gate("25! / 13! quotient", bi_to_string(dq2[0]), "2490952020480000")
    fails = fails + _gate("25! / 13! remainder = 0", bi_to_string(dq2[1]), "0")

    // signed: (-10^40) ÷ 7^13  → q sign negative (truncate toward zero), r sign negative
    let dqn = bi_divmod(bi_neg(q), b713)
    fails = fails + _gate("(-10^40) / 7^13 quotient", bi_to_string(dqn[0]), "-103210879727155556146643346322")
    fails = fails + _gate("(-10^40) / 7^13 remainder (sign of a)", bi_to_string(dqn[1]), "-90436826946")

    // |a| < |b| → quotient 0, remainder = a
    let small = bi_divmod(bi_from(5), bi_from(100))
    fails = fails + _gate("5 / 100 quotient = 0", bi_to_string(small[0]), "0")
    fails = fails + _gate("5 / 100 remainder = 5", bi_to_string(small[1]), "5")

    // b == 0 sentinel → quotient 0, remainder = a
    let zdiv = bi_divmod(bi_from(42), bi_from(0))
    fails = fails + _gate("42 / 0 sentinel quotient = 0", bi_to_string(zdiv[0]), "0")
    fails = fails + _gate("42 / 0 sentinel remainder = 42", bi_to_string(zdiv[1]), "42")

    // ── gcd ──
    // gcd(48!, 36!) = 36! (since 36! | 48!) — reference from python
    let f48 = bi_from(1)
    let k48 = 1
    while k48 <= 48 { f48 = bi_mul(f48, bi_from(k48)); k48 = k48 + 1 }
    let f36 = bi_from(1)
    let k36 = 1
    while k36 <= 36 { f36 = bi_mul(f36, bi_from(k36)); k36 = k36 + 1 }
    let g1 = bi_gcd(f48, f36)
    fails = fails + _gate("gcd(48!,36!) = 36!", bi_to_string(g1), "371993326789901217467999448150835200000000")
    // gcd(2^100*3, 2^50*3*5) = 2^50*3 = 3377699720527872
    let p2_100 = bi_from(1)
    let e1 = 0
    while e1 < 100 { p2_100 = bi_mul(p2_100, bi_from(2)); e1 = e1 + 1 }
    let aA = bi_mul(p2_100, bi_from(3))
    let p2_50 = bi_from(1)
    let e2 = 0
    while e2 < 50 { p2_50 = bi_mul(p2_50, bi_from(2)); e2 = e2 + 1 }
    let bB = bi_mul(bi_mul(p2_50, bi_from(3)), bi_from(5))
    let g2 = bi_gcd(aA, bB)
    fails = fails + _gate("gcd(2^100*3, 2^50*3*5) = 2^50*3", bi_to_string(g2), "3377699720527872")
    // gcd is non-negative even with negative inputs
    let g3 = bi_gcd(bi_neg(bi_from(48)), bi_from(36))
    fails = fails + _gate("gcd(-48,36) = 12", bi_to_string(g3), "12")
    // bi_mod convenience
    fails = fails + _gate("10^40 mod 7^13 = 90436826946", bi_to_string(bi_mod(q, b713)), "90436826946")

    println("")
    if fails == 0 {
        println("=== ALL GATES PASS — native BigInt validated (substrate unlocked) ===")
    } else {
        println("=== " + to_string(fails) + " GATE(S) FAILED ===")
    }
}
