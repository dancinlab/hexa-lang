// ═══════════════════════════════════════════════════════════════════════════
//  stdlib/test/test_emitted_code_validity_op100.hexa
//
//  EMITTED-FOREIGN-CODE validity lock (HEXA-0POD OP-100).
//
//  CONTEXT: a hexa module that BUILDS a foreign-language source STRING
//  (python3 / bash / awk / sql) and execs it can carry a LATENT syntax /
//  scope / quoting bug that makes the path DEAD-ON-ARRIVAL — the host
//  fallback "just fails" and the bug is never surfaced. OP-98 found exactly
//  one such bug (stdlib/websocket python3 helper: `nonlocal pre` at module
//  scope -> compile-time SyntaxError -> the whole websocat-less fallback was
//  100% dead). OP-100 swept the rest of the EMITTED-FOREIGN-CODE corpus
//  (infra/protocol lane: python_ffi, dojo trainers/glue, sqlite SQL builder,
//  self/main awk merge/dedup/rename, firmware C). EVERY emitter validated
//  CLEAN through its real interpreter (python3 ast.parse + run, bash -n,
//  awk -f, sqlite3) — NO new dead-on-arrival bug; the OP-98 bug was the only
//  one of its class.
//
//  This file LOCKS the structural invariants that keep the validated
//  emitters syntactically alive, so a future edit that reintroduces a
//  dead-on-arrival shape (e.g. drops a heredoc delimiter, breaks SQL
//  single-quote doubling, drops a python `def`/`global`) fails in-tree.
//  SELF-CONTAINED: each emitter's validity-critical fragment is INLINED
//  VERBATIM (no `use` — the installed `hexa` resolves `use` to a STALE
//  bundled copy, OP-87/88), mirroring the OP-98 lock.
//
//  Run:
//      hexa run stdlib/test/test_emitted_code_validity_op100.hexa
//
//  The emitted strings themselves were validated through their real
//  interpreters in the OP-100 verdict; this test is the in-tree regression
//  guard for the syntactic invariants.
// ═══════════════════════════════════════════════════════════════════════════

let mut pass_count = 0
let mut fail_count = 0

fn chk(tag, cond) {
    if cond {
        println("  PASS " + tag)
        pass_count = pass_count + 1
    } else {
        println("  FAIL " + tag)
        fail_count = fail_count + 1
    }
}

// ── INLINED VERBATIM from stdlib/python_ffi.hexa::py_get_doc (the helper) ──
//    A top-level python3 script (run via py_eval) — `def get_first` must be
//    defined and the synthetic module registered. python3 ast.parse OK +
//    get_first('os|getcwd') returns the real docstring (OP-100 verdict).
fn pyffi_helper_source() -> string {
    return "import sys, types\nif not hasattr(sys.modules.get('__hxa_pyhover'), 'get_first'):\n    m = types.ModuleType('__hxa_pyhover')\n    def get_first(arg):\n        try:\n            mod_name, fn_name = arg.split('|', 1)\n            mod = __import__(mod_name)\n            for piece in mod_name.split('.')[1:]: mod = getattr(mod, piece)\n            doc = getattr(getattr(mod, fn_name, None), '__doc__', None)\n            if not doc: return ''\n            return (doc.splitlines() + [''])[0]\n        except Exception:\n            return ''\n    m.get_first = get_first\n    sys.modules['__hxa_pyhover'] = m"
}

// ── INLINED VERBATIM from stdlib/sqlite.hexa::_sqlq (SQL literal quoting) ──
//    SQL-92 string literal: wrap in single quotes, DOUBLE every embedded
//    single quote. A regression to backslash-escaping (\') would make the
//    emitted INSERT/SELECT dead-on-arrival in sqlite3 (OP-100 verdict).
fn sqlq(s: string) -> string {
    return "'" + s.replace("'", "''") + "'"
}

// ── INLINED VERBATIM from self/main.hexa::merge_modules_awk (merge script) ──
//    awk program that renames each module's `int main(...)` to `_MOD_init`.
//    `awk -f <this>` must parse (OP-100 verdict). The `^}$` column-0 close
//    and the `/^int main\(/` rule are the load-bearing lines.
fn awk_merge_source() -> string {
    let mut s = ""
    s = s + "BEGIN { in_main=0 }\n"
    s = s + "/^#include/ { next }\n"
    s = s + "/^\\/\\/ Generated by/ { next }\n"
    s = s + "/^int main\\(/ { printf(\"int _%s_init(int argc, char** argv) {\\n\", MOD); in_main=1; next }\n"
    s = s + "in_main==1 && /^\\}$/ { print \"}\"; in_main=0; next }\n"
    s = s + "in_main==1 { print; next }\n"
    s = s + "{ print }\n"
    return s
}

fn main() -> void {
    println("── OP-100 emitted-foreign-code validity lock ──")

    // python3 helper (stdlib/python_ffi) — must define the getter + register
    let py = pyffi_helper_source()
    chk("pyffi_defines_get_first",  py.index_of("def get_first(arg):") >= 0)
    chk("pyffi_no_nonlocal",        py.index_of("nonlocal ") < 0)
    chk("pyffi_registers_module",   py.index_of("sys.modules['__hxa_pyhover'] = m") >= 0)
    chk("pyffi_balanced_try",       py.index_of("try:") >= 0 && py.index_of("except Exception:") >= 0)

    // sqlite SQL quoting (stdlib/sqlite) — SQL-92 single-quote DOUBLING
    chk("sqlq_plain",          sqlq("alice") == "'alice'")
    chk("sqlq_embedded_quote", sqlq("O'Brien") == "'O''Brien'")
    chk("sqlq_no_backslash",   sqlq("a'b").index_of("\\") < 0)

    // self/main awk merge — `awk -f` must parse; renames main → _MOD_init
    let aw = awk_merge_source()
    chk("awk_has_begin",     aw.index_of("BEGIN { in_main=0 }") >= 0)
    chk("awk_renames_main",  aw.index_of("/^int main\\(/") >= 0 && aw.index_of("_%s_init") >= 0)
    chk("awk_col0_close",    aw.index_of("/^\\}$/") >= 0)
    chk("awk_default_print", aw.index_of("{ print }") >= 0)

    let total = pass_count + fail_count
    println("")
    println("  pass=" + to_string(pass_count) + "  fail=" + to_string(fail_count))
    if fail_count == 0 {
        println("PASS: OP-100 emitted-code validity lock " + to_string(pass_count) + "/" + to_string(total))
        return
    }
    println("FAIL: OP-100 emitted-code validity lock " + to_string(pass_count) + "/" + to_string(total))
    exit(1)
}
