// HEXA Standard Library — deck/gen
//
// @version 0.1.0
// @capabilities [pure]
//
// GENERIC 6-DOMAIN DECK GENERATOR ("빵틀").
//
// Eliminates per-domain deck / input hand-authoring. One generic entry
// point — gen_deck(domain, spec) — dispatches by domain string to a
// per-domain string-emitter. Adding a domain = ONE dispatch branch +
// ONE emitter file (g4 generic dispatch · g20 parameterize · g61 SSOT).
//
// This is a STRING-EMITTER (deck text → DeckFile records), NOT a compiled
// binary. It runs via `hexa run`, so it does NOT need the AOT build —
// pure-hexa string assembly only (sidesteps verify_cli _bessel_j1
// duplicate-symbol bug, INBOX #2002).
//
// Surface (pure functions, no syscall):
//   pub fn gen_deck(domain: string, spec: DeckSpec) -> [DeckFile]
//   pub fn deck_spec_new() -> DeckSpec
//   pub fn spec_set(spec, key, value)           — scalar field
//   pub fn spec_set_list(spec, key, [values])   — list-valued field
//   pub fn spec_get(spec, key) -> string        — "" if absent
//   pub fn spec_get_or(spec, key, default) -> string
//   pub fn spec_get_list(spec, key) -> [string] — [] if absent
//   pub fn spec_has(spec, key) -> bool
//
// Design — numeric deck values that must reproduce EXACTLY (e.g. QE
// celldm = 8.5132, press = 100.0, degauss = 0.01) are carried as
// PRE-FORMATTED STRINGS in the spec. The spec author controls exact
// rendering; the emitter never round-trips a float through str() for a
// value that must byte-match a template (str(float) precision is not
// guaranteed — compiler/PLAN.md Tier-A.3). Only DERIVED integers
// (nat, ntyp, max_seconds) go through str(int), which is exact.

import "stdlib/deck/rtsc.hexa"
import "stdlib/deck/nuclear.hexa"
import "stdlib/deck/material.hexa"
import "stdlib/deck/chem.hexa"
import "stdlib/deck/chip.hexa"
import "stdlib/deck/bio.hexa"
import "stdlib/deck/types.hexa"

// ── data types ───────────────────────────────────────────────────────

// DeckFile / DeckSpec structs + their accessors (deck_spec_new · spec_set ·
// spec_set_list · spec_has · spec_get · spec_get_or · spec_get_list) now live
// in the leaf module stdlib/deck/types.hexa — imported above. Extracting them
// breaks the former gen.hexa <-> emitter import cycle that double-emitted the
// struct constructors and broke `hexa run gen.hexa` (the /deck emit entrypoint).

// ── generic dispatch (g4) ────────────────────────────────────────────

// gen_deck(domain, spec) — emit the full deck file-set for `domain`.
// Returns [] for an unknown domain (caller checks len). Adding a domain
// is ONE branch here + ONE emitter file (no name hardcoding past this
// dispatch — g20).
pub fn gen_deck(domain: string, spec: DeckSpec) -> [DeckFile] {
    if domain == "rtsc"     { return emit_rtsc(spec) }
    if domain == "nuclear"  { return emit_nuclear(spec) }
    if domain == "material" { return emit_material(spec) }
    if domain == "chem"     { return emit_chem(spec) }
    if domain == "chip"     { return emit_chip(spec) }
    if domain == "bio"      { return emit_bio(spec) }
    let none: [DeckFile] = []
    return none
}

// gen_domains() — the known deck domains (the dispatch keys of gen_deck).
// Single source for the `deck` CLI's domain coverage listing.
pub fn gen_domains() -> [string] {
    return ["rtsc", "nuclear", "material", "chem", "chip", "bio"]
}

// gen_prototypes(domain) — the known prototype names for `domain`, for the
// `deck prototypes <domain>` list subverb. Generic dispatch (g4): a domain
// with a prototype registry returns its list; one without returns []. Adding
// a prototype registry for a new domain = ONE branch here + its accessor (no
// per-formula hardcode past this dispatch). Today only `rtsc` parameterizes
// by crystal prototype.
pub fn gen_prototypes(domain: string) -> [string] {
    if domain == "rtsc" { return rtsc_prototypes() }
    let none: [string] = []
    return none
}

// ── disk preflight (improvement 4 — /deck estimate disk-headroom line) ──
//
// A DFT phonon (ph.x el-ph) run writes per-q `_ph0` scratch (5-18 GB / q-point
// on a 10-atom metallic; 2026-05-30 lesson). The /deck preflight estimate must
// surface a DISK-headroom line so a deck is not dispatched to a pod that fills
// its disk mid-run (the disk-full crash this bundle prevents). Required scratch
// ≈ q_points × scratch_gb_per_q; warn when a target pod's free disk < that.
//
// d4-generic — closed-form, no per-deck name hardcoding; pure (no syscall), so
// the CLI / skill feeds (q_points, scratch_gb_per_q, free_disk_gb) it scraped.

// deck_disk_required_gb — closed-form scratch headroom a ph.x el-ph deck needs.
// required ≈ q_points × scratch_gb_per_q (non-negative; clamps junk to 0).
pub fn deck_disk_required_gb(q_points: int, scratch_gb_per_q: int) -> int {
    if q_points <= 0 { return 0 }
    if scratch_gb_per_q <= 0 { return 0 }
    return q_points * scratch_gb_per_q
}

// deck_elph_scratch_gb_est — fine-mesh-aware per-q `_ph0` scratch estimate (GB).
// The legacy hand-passed 5-18 GB/q UNDERESTIMATES dense-fine-k el-ph: the 16^3
// fine k-mesh LaOs3Si2/LaRu3Si2 cells MEASURED >40 GB/q (the 40G vast disk-wall,
// 2026-06-17). Scale with the fine k-point count (per-axis nk, cubed) and atom
// count, floored at 40 (el-ph minimum disk; 40G was the ruled-out wall):
//   est ≈ (nk^3 · nat) / 600   ·  12^3/nat6 -> 17 (→40 floor)  ·  16^3/nat6 -> 40 (the measured wall)  ·  20^3/nat6 -> 80
// This is the realistic scratch_gb_per_q to feed deck_disk_fits / the runtime
// preflight, replacing the old 5-18 guess that let a 40G pod pass then davcio-die.
pub fn deck_elph_scratch_gb_est(nk_fine: int, nat: int) -> int {
    if nk_fine <= 0 || nat <= 0 { return 40 }
    let est = (nk_fine * nk_fine * nk_fine * nat) / 600
    if est < 40 { return 40 }
    return est
}

// deck_disk_fits — does a target pod's free disk cover the required scratch?
// free_disk_gb < required → false (the caller WARNs). required == 0 (unknown
// q / scratch) → true (nothing to gate on — never a false alarm).
pub fn deck_disk_fits(q_points: int, scratch_gb_per_q: int, free_disk_gb: int) -> bool {
    let required = deck_disk_required_gb(q_points, scratch_gb_per_q)
    if required <= 0 { return true }
    return free_disk_gb >= required
}

// deck_disk_preflight_line — the one-line disk-headroom string the /deck
// estimate appends after emit. Includes the required figure and, when a
// free_disk_gb is supplied (> 0) and is short, an explicit ⚠ WARN with the
// shortfall. free_disk_gb ≤ 0 → "unknown free disk" (informational only).
pub fn deck_disk_preflight_line(q_points: int, scratch_gb_per_q: int, free_disk_gb: int) -> string {
    let required = deck_disk_required_gb(q_points, scratch_gb_per_q)
    let mut s = "disk preflight: required ≈ " + str(q_points) + " q × " + str(scratch_gb_per_q)
        + " GB/q = " + str(required) + " GB scratch"
    if free_disk_gb <= 0 {
        return s + " (target free disk unknown — measure `df -BG <scratch>` before dispatch)"
    }
    s = s + " · target free disk = " + str(free_disk_gb) + " GB"
    if free_disk_gb < required {
        let short = required - free_disk_gb
        return s + " — ⚠ WARN: short " + str(short) + " GB; ph.x _ph0 scratch will disk-full mid-run (pick a bigger-disk pod or split q)"
    }
    return s + " — OK (fits)"
}

// deck_pod_qe_bootstrap — the canonical "install QE 7.x on a BARE pod" script
// (micromamba). Emit this instead of hand-writing a per-campaign setup script:
// it carries the hard-won guards from a demiurge RTSC session (트러블슈팅 재발금지 —
// every guard below cost a wasted compute cycle to learn):
//   G1 bzip2/curl/tar via apt BEFORE `tar -xj` — a bare vast/runpod pod often
//      ships WITHOUT bzip2, so micromamba's .tar.bz2 silently fails to extract
//      ("bzip2: Cannot exec") and pw.x is never installed.
//   G2 install with a retry + verify the binary actually runs (`--version`).
//   G3 idempotent env create — skip when pw.x already resolves in the qe env.
//   G4 FAIL-LOUD: print "QE SETUP DONE" ONLY when `which pw.x` succeeds in the
//      env, else "QE SETUP FAILED: <reason>" + exit 1. QE binaries have no
//      `-h`/`--version` that exits 0, so `which` is the correct liveness probe
//      (a `pw.x -h` probe false-FAILS a good install). A prior unconditional
//      "DONE" made a watcher fire sizing against a pod with no pw.x → a whole
//      session of silent empty scf.out.
// Self-detaches to ~/qe_setup.log when BG!=1 so a dispatcher can fire-and-poll.
pub fn deck_pod_qe_bootstrap() -> string {
    let mut s = "#!/usr/bin/env bash\n"
    s = s + "# QE 7.x env bootstrap (micromamba) — hexa deck canonical · fail-loud.\n"
    s = s + "if [ \"${BG:-}\" != \"1\" ]; then\n"
    s = s + "  BG=1 nohup bash \"$0\" > \"$HOME/qe_setup.log\" 2>&1 & echo \"qe-setup launched pid=$!\"; exit 0\n"
    s = s + "fi\n"
    s = s + "set -uo pipefail\n"
    s = s + "export MAMBA_ROOT_PREFIX=\"$HOME/micromamba\"\n"
    s = s + "MM=\"$HOME/bin/micromamba\"\n"
    s = s + "ensure_deps() {\n"
    s = s + "  command -v bzip2 >/dev/null 2>&1 && command -v curl >/dev/null 2>&1 && return 0\n"
    s = s + "  echo '[setup] installing bzip2/curl/tar (tar -xj dep)...'\n"
    s = s + "  (apt-get update -qq && apt-get install -y -qq bzip2 curl tar) >/dev/null 2>&1 || true\n"
    s = s + "}\n"
    s = s + "if [ ! -x \"$MM\" ]; then\n"
    s = s + "  ensure_deps; mkdir -p \"$HOME/bin\"\n"
    s = s + "  for try in 1 2; do\n"
    s = s + "    curl -Ls https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xj -C \"$HOME\" bin/micromamba 2>/dev/null\n"
    s = s + "    [ -x \"$MM\" ] && break\n"
    s = s + "  done\n"
    s = s + "fi\n"
    s = s + "if [ ! -x \"$MM\" ] || ! \"$MM\" --version >/dev/null 2>&1; then\n"
    s = s + "  echo '=== QE SETUP FAILED: micromamba not installed (bzip2/curl tar -xj from micro.mamba.pm) ==='; exit 1\n"
    s = s + "fi\n"
    s = s + "echo \"[setup] micromamba $(\"$MM\" --version 2>/dev/null) OK\"\n"
    s = s + "if \"$MM\" run -n qe which pw.x >/dev/null 2>&1; then\n"
    s = s + "  echo '[setup] qe env already has pw.x — skipping create'\n"
    s = s + "else\n"
    s = s + "  echo '[setup] creating qe env (qe + openmpi from conda-forge)...'\n"
    s = s + "  \"$MM\" create -y -n qe -c conda-forge qe openmpi 2>&1 | tail -5\n"
    s = s + "fi\n"
    s = s + "if \"$MM\" run -n qe which pw.x >/dev/null 2>&1; then\n"
    s = s + "  echo '=== QE SETUP DONE ==='\n"
    s = s + "else\n"
    s = s + "  echo '=== QE SETUP FAILED: pw.x not found in qe env ==='; exit 1\n"
    s = s + "fi\n"
    return s
}

// deck_pod_elph_runner — the canonical DISK-SAFE q-batched el-ph PRODUCTION
// runner. Emit this instead of hand-writing a per-campaign run script (a
// demiurge RTSC session hand-wrote it three times — d_deck_always). It carries
// every guard that cost a wasted compute cycle to learn (트러블슈팅 재발금지):
//   G1 DISK-SAFE q-batching: each irreducible q needs O(40GB) dvscf scratch, so
//      a single pod cannot hold all q at once. Run 2-q batches; after each, save
//      the small elph.inp_lambda.<q> + *.dyn* then DROP the large out/_ph0
//      scratch before the next batch (a prior all-q-at-once run disk-fulled).
//   G2 recover=.true. (set in ph.in) rides pod reboots; a batch resumes from its
//      _ph0 checkpoint. Per-batch _ph0 wipe is only AFTER that batch's JOB DONE.
//   G3 k-parallel: -npool $NPOOL (k-grid is embarrassingly parallel) + -np $NP,
//      both env-overridable; defaults 192/6 suit a many-core pod.
//   G4 SELF-GUARD at launch: kill any stale ph.x/ph_b (would corrupt _ph0), drop
//      stale scratch. The SCF (out/*.save) is PRESERVED — only _ph0 is cleared.
//   G5 FAIL-LOUD: a batch with no "JOB DONE" prints the tail + exits non-zero
//      (never silently continues past a broken q).
//   G6 q-range args START_Q END_Q for d_qforge_parallel multi-pod sharding.
// Self-locating (cd to its own dir) so it is portable across pods/cells; uses a
// prefix-agnostic *.dyn* glob. env-robust: micromamba else conda.
pub fn deck_pod_elph_runner() -> string {
    let mut s = "#!/usr/bin/env bash\n"
    s = s + "# el-ph PRODUCTION — disk-safe q-batched runner (hexa deck canonical).\n"
    s = s + "set -uo pipefail\n"
    s = s + "D=\"$(cd \"$(dirname \"$0\")\" && pwd)\"; cd \"$D\" || exit 2\n"
    s = s + "# G4 self-guard: drop stale ph.x + _ph0 (SCF out/*.save preserved).\n"
    s = s + "pkill -9 -f \"ph.x\" 2>/dev/null || true\n"
    s = s + "pkill -9 -f \"ph_b\" 2>/dev/null || true\n"
    s = s + "sleep 3\n"
    s = s + "rm -rf out/_ph0 2>/dev/null || true\n"
    s = s + "# env-robust: micromamba else conda.\n"
    s = s + "if [ -x \"$HOME/bin/micromamba\" ]; then RUN=\"$HOME/bin/micromamba run -n qe\"\n"
    s = s + "elif command -v conda >/dev/null 2>&1; then RUN=\"conda run -n qe\"\n"
    s = s + "else echo 'FATAL: no micromamba/conda — run setup_env.sh first'; exit 1; fi\n"
    s = s + "export OMP_NUM_THREADS=1\n"
    s = s + "NP=\"${NP:-192}\"; NPOOL=\"${NPOOL:-6}\"\n"
    s = s + "MPI=\"$RUN mpirun -np $NP --allow-run-as-root --bind-to none\"\n"
    s = s + "mkdir -p elph_out\n"
    s = s + "SQ=\"${1:-1}\"; LQ=\"${2:-99}\"\n"
    s = s + "echo \"=== ELPH PROD q$SQ..$LQ on $(hostname) NP=$NP npool=$NPOOL ===\"\n"
    s = s + "q=$SQ\n"
    s = s + "while [ \"$q\" -le \"$LQ\" ]; do\n"
    s = s + "  e=$((q+1)); [ \"$e\" -gt \"$LQ\" ] && e=$LQ\n"
    s = s + "  if [ -f \"elph_out/.done_${q}_${e}\" ]; then echo \"batch q$q-$e already done\"; q=$((e+1)); continue; fi\n"
    s = s + "  sed -e \"s/^  ! *start_q.*/  start_q = $q/\" -e \"s/^  ! *last_q.*/  last_q = $e/\" ph.in > \"ph_b${q}_${e}.in\"\n"
    s = s + "  echo \"=== BATCH q$q-$e START $(date +%H:%M) ===\"\n"
    s = s + "  $MPI ph.x -npool $NPOOL -in \"ph_b${q}_${e}.in\" > \"ph_b${q}_${e}.out\" 2>&1\n"
    s = s + "  if grep -qi \"JOB DONE\" \"ph_b${q}_${e}.out\"; then\n"
    s = s + "    cp ./*.dyn* elph_out/ 2>/dev/null || true\n"
    s = s + "    cp elph.inp_lambda.* elph_out/ 2>/dev/null || true\n"
    s = s + "    touch \"elph_out/.done_${q}_${e}\"\n"
    s = s + "    rm -rf out/_ph0 2>/dev/null || true\n"
    s = s + "    echo \"=== BATCH q$q-$e DONE $(date +%H:%M) ===\"\n"
    s = s + "  else\n"
    s = s + "    echo \"=== BATCH q$q-$e FAIL ===\"; tail -20 \"ph_b${q}_${e}.out\"; exit 1\n"
    s = s + "  fi\n"
    s = s + "  q=$((e+1))\n"
    s = s + "done\n"
    s = s + "echo \"=== ELPH PROD q$SQ..$LQ ALL DONE ===\"\n"
    return s
}

// deck_pod_short_launcher — robust DETACHED launcher for the el-ph runner. A
// SHORT remote command (`bash launch.sh`) survives a flaky vast/RunPod proxy
// where an inline `nohup ... &` one-liner gets truncated mid-stream (트러블슈팅
// 재발금지 — a demiurge session lost a launch to exactly that). Kills any stale
// runner/ph.x, then backgrounds run_prod.sh (same dir) with q-range args.
pub fn deck_pod_short_launcher() -> string {
    let mut s = "#!/usr/bin/env bash\n"
    s = s + "# short detached launcher for run_prod.sh (hexa deck canonical).\n"
    s = s + "pkill -9 -f run_prod.sh 2>/dev/null || true\n"
    s = s + "pkill -9 -f \"ph.x\"     2>/dev/null || true\n"
    s = s + "sleep 3\n"
    s = s + "D=\"$(cd \"$(dirname \"$0\")\" && pwd)\"; cd \"$D\" || exit 2\n"
    s = s + "rm -rf out/_ph0 2>/dev/null || true\n"
    s = s + "SQ=\"${1:-1}\"; LQ=\"${2:-99}\"\n"
    s = s + "nohup bash \"$D/run_prod.sh\" \"$SQ\" \"$LQ\" > \"$D/prod.log\" 2>&1 &\n"
    s = s + "echo \"LAUNCHED run_prod q$SQ..$LQ pid=$!\"\n"
    return s
}
