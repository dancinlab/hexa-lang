// @ci_gate — pure · network-free · deterministic (stdlib_selftest_aggregate --ci-gate)
//
// stdlib/deck/pod_elph_runner_test.hexa — deck_pod_elph_runner /
// deck_pod_short_launcher selftest: the canonical el-ph PRODUCTION runner +
// launcher carry every guard a demiurge RTSC session paid a wasted compute
// cycle to learn (트러블슈팅 재발금지 · d_deck_always — replaces hand-written
// run scripts):
//   G1 disk-safe 2-q batching + _ph0 cleanup between batches.
//   G3 k-parallel -npool.
//   G4 self-guard (kill stale ph.x at launch) + SCF-preserving _ph0 wipe.
//   G5 fail-loud on a batch with no JOB DONE.
//   G6 q-range args for multi-pod sharding.
//   launcher: SHORT detached (no inline `nohup &` truncation), q-range args.
//
// Run:  hexa run stdlib/deck/pod_elph_runner_test.hexa
// PASS: exits 0, prints "deck_pod_elph_runner_test PASS".
use "stdlib/deck/gen"

fn _has(case: str, s: str, sub: str) {
    if !s.contains(sub) {
        println("  FAIL: " + case + " — missing '" + sub + "'")
        exit(1)
    }
    println("  ok: " + case)
}

fn _hasnt(case: str, s: str, sub: str) {
    if s.contains(sub) {
        println("  FAIL: " + case + " — should NOT contain '" + sub + "'")
        exit(1)
    }
    println("  ok: " + case)
}

fn main() {
    println("# deck_pod_elph_runner_test — el-ph runner + launcher guards")
    let r = deck_pod_elph_runner()

    // G1 disk-safe batching + cleanup.
    _has("G1 q-batch loop", r, "ph_b${q}_${e}.in")
    _has("G1 _ph0 cleanup between batches", r, "rm -rf out/_ph0")
    _has("G1 save elph lambda", r, "elph.inp_lambda.")
    _has("G1 save dyn", r, "*.dyn*")
    // G3 k-parallel.
    _has("G3 npool", r, "-npool $NPOOL")
    // G4 self-guard.
    _has("G4 kill stale ph.x", r, "pkill -9 -f \"ph.x\"")
    // G5 fail-loud.
    _has("G5 JOB DONE check", r, "JOB DONE")
    _has("G5 batch FAIL exit", r, "BATCH q$q-$e FAIL")
    // G6 q-range sharding args.
    _has("G6 SQ arg", r, "SQ=\"${1:-1}\"")
    _has("G6 LQ arg", r, "LQ=\"${2:-99}\"")
    // self-locating + env-robust.
    _has("self-locating dir", r, "$(dirname \"$0\")")
    _has("env-robust micromamba|conda", r, "conda run -n qe")

    let l = deck_pod_short_launcher()
    _has("launcher kills stale runner", l, "pkill -9 -f run_prod.sh")
    _has("launcher nohup detached", l, "nohup bash")
    _has("launcher q-range args", l, "SQ=\"${1:-1}\"")
    // the launcher must NOT itself be the long inline form it replaces.
    _hasnt("launcher no stray marker", l, "__CLOUD")

    println("deck_pod_elph_runner_test PASS")
}
