// @ci_gate — pure · network-free · deterministic (stdlib_selftest_aggregate --ci-gate)
// stdlib/cloud/attribution_test.hexa — falsifier suite for the WHO/WHY gate on
// the passthrough verbs (`cloud api` · `cloud provider-cli`).
//
// attribution.hexa exports its classifier PUBLICLY and has NO `use` of its own
// (zero exec / creds / env), so this suite IMPORTS it directly instead of
// mirroring the logic (the provider_cli_test mirror-test pattern exists only
// because those helpers are `_`-prefixed private — a mirror that can silently
// drift). Everything asserted here is the real shipped function.
//
// Falsifiers (@L5/@L2):
//   F-ATTR-BOTH        — agent + purpose both stated → gate PASSES
//   F-ATTR-MISSING     — either one absent → gate REFUSES, and names WHICH
//   F-ATTR-BLANK       — whitespace-only is absent (not a stated value)
//   F-ATTR-PLACEHOLDER — a filler ("unspecified"/"n/a"/"-") is NOT an answer;
//                        this is the hole `_resolve_purpose`'s "unspecified"
//                        default would otherwise walk straight through
//   F-ATTR-SHORT-REAL  — a short BUT REAL tag ("qa", "r12") passes (the
//                        placeholder list must not over-reach)
//   F-ATTR-MSG         — the refusal names the missing field AND its fix flag
//   F-ATTR-STAMP       — a passing gate's echo carries agent/project/purpose,
//                        and a blank project degrades to @unattributed
//
// The env/flag RESOLUTION (--agent → HEXA_AGENT_TAG, --purpose/--desc/--owner)
// lives at the cloud_cli dispatch and is exercised by the live verb; here we
// falsify the PURE classifier that resolution feeds.
//
// Run:  hexa run stdlib/cloud/attribution_test.hexa
// PASS: exits 0, prints "attribution_test PASS".

use "stdlib/cloud/attribution"

fn _cki(name: str, got: int, want: int) {
    if got != want {
        println("  FAIL: " + name + " got " + to_string(got) + " want " + to_string(want))
        exit(1)
    }
}

fn _ck(name: str, got: str, want: str) {
    if got != want {
        println("  FAIL: " + name + " got '" + got + "' want '" + want + "'")
        exit(1)
    }
}

// _has_sub — does haystack contain needle? Explicit scan (PURE), used to assert
// message CONTENT without pinning exact prose.
fn _has_sub(hay: str, needle: str) -> int {
    let n = len(needle)
    if n == 0 { return 1 }
    if len(hay) < n { return 0 }
    let mut i = 0
    while i + n <= len(hay) {
        if hay.substring(i, i + n) == needle { return 1 }
        i = i + 1
    }
    return 0
}

// _lines_have — does ANY line contain needle? PURE.
fn _lines_have(lines: [str], needle: str) -> int {
    let mut i = 0
    while i < len(lines) {
        if _has_sub(lines[i], needle) == 1 { return 1 }
        i = i + 1
    }
    return 0
}

fn main() {
    // ── F-ATTR-BOTH — a fully attributed call passes ──────────────────
    _cki("both stated → pass",  attr_gate_ok("claude-3", "r12 offer survey"), 1)
    _cki("both stated → 0 missing", len(attr_missing("claude-3", "r12 offer survey")), 0)

    // ── F-ATTR-MISSING — either absent → refuse, naming which ─────────
    _cki("no agent → refuse",   attr_gate_ok("", "r12 offer survey"), 0)
    _cki("no purpose → refuse", attr_gate_ok("claude-3", ""), 0)
    _cki("neither → refuse",    attr_gate_ok("", ""), 0)
    _cki("missing agent → 1 field",  len(attr_missing("", "real purpose")), 1)
    _ck ("missing agent named",      attr_missing("", "real purpose")[0], "agent")
    _cki("missing purpose → 1 field", len(attr_missing("claude-3", "")), 1)
    _ck ("missing purpose named",     attr_missing("claude-3", "")[0], "purpose")
    _cki("both missing → 2 fields",   len(attr_missing("", "")), 2)

    // ── F-ATTR-BLANK — whitespace is not a stated value ───────────────
    _cki("spaces agent → refuse",  attr_gate_ok("   ", "real purpose"), 0)
    _cki("tab purpose → refuse",   attr_gate_ok("claude-3", "\t"), 0)

    // ── F-ATTR-PLACEHOLDER — filler is not an answer ──────────────────
    // "unspecified" is _resolve_purpose's DEFAULT — the exact token that would
    // otherwise satisfy a naive non-empty check and re-open the anonymity hole.
    _cki("purpose=unspecified → refuse", attr_gate_ok("claude-3", "unspecified"), 0)
    _cki("purpose=n/a → refuse",         attr_gate_ok("claude-3", "n/a"), 0)
    _cki("purpose=none → refuse",        attr_gate_ok("claude-3", "none"), 0)
    _cki("purpose=TBD (case-insens) → refuse", attr_gate_ok("claude-3", "TBD"), 0)
    _cki("purpose='-' → refuse",         attr_gate_ok("claude-3", "-"), 0)
    _cki("purpose=' unknown ' padded → refuse", attr_gate_ok("claude-3", " unknown "), 0)
    _cki("agent=unknown → refuse",       attr_gate_ok("unknown", "real purpose"), 0)

    // ── F-ATTR-SHORT-REAL — the placeholder list must not over-reach ───
    _cki("agent=qa → pass",     attr_gate_ok("qa", "quota check"), 1)
    _cki("purpose=r12 → pass",  attr_gate_ok("claude-3", "r12"), 1)
    // "nanotube" leads with "na"; "nonlinear" leads with "non" — a PREFIX match
    // would wrongly reject both. Only a WHOLE-value match is a placeholder.
    _cki("purpose=nanotube (not 'na') → pass",   attr_gate_ok("claude-3", "nanotube bench"), 1)
    _cki("purpose=nonlinear (not 'none') → pass", attr_gate_ok("claude-3", "nonlinear solve"), 1)

    // ── F-ATTR-MSG — the refusal names the missing field AND its fix ───
    let msg = attr_refuse_lines("api", "", "")
    _cki("msg says REFUSED",        _lines_have(msg, "REFUSED"), 1)
    _cki("msg names the verb",      _lines_have(msg, "api:"), 1)
    _cki("msg names both missing",  _lines_have(msg, "missing: agent, purpose"), 1)
    _cki("msg offers --agent",      _lines_have(msg, "--agent"), 1)
    _cki("msg offers HEXA_AGENT_TAG", _lines_have(msg, "HEXA_AGENT_TAG"), 1)
    _cki("msg offers --purpose",    _lines_have(msg, "--purpose"), 1)
    // a refusal for ONE missing field must not lecture about the other.
    let msg1 = attr_refuse_lines("provider-cli", "claude-3", "")
    _cki("single-miss names only purpose", _lines_have(msg1, "missing: purpose"), 1)
    _cki("single-miss omits the agent fix line", _lines_have(msg1, "WHO is calling"), 0)
    _cki("single-miss names provider-cli verb",  _lines_have(msg1, "provider-cli:"), 1)

    // ── F-ATTR-STAMP — a passing gate's echo carries WHO/WHERE/WHY ─────
    let st = attr_stamp_line("api", "claude-3", "@demiurge", "r12 offer survey")
    _cki("stamp has agent",   _has_sub(st, "agent=claude-3"), 1)
    _cki("stamp has project", _has_sub(st, "project=@demiurge"), 1)
    _cki("stamp has purpose", _has_sub(st, "purpose=r12 offer survey"), 1)
    _cki("stamp blank project → @unattributed",
         _has_sub(attr_stamp_line("api", "claude-3", "", "x-ray"), "project=@unattributed"), 1)

    println("attribution_test PASS")
}
