// stdlib/cloud/cloud_cli.hexa — standalone CLI for the cloud dispatch lib.
//
// Run directly:  hexa run stdlib/cloud/cloud_cli.hexa <subcommand> ...
//
// Cycle A ships this as a standalone CLI only; wiring a `hexa cloud`
// subcommand into self/main.hexa (which needs a compiled bin/hexa-cloud)
// is a later deploy-adjacent step — see design.md Decision 5.

use "stdlib/cloud/cloud_commands"
use "stdlib/cloud/cloud"
use "stdlib/cloud/pod_registry"
use "stdlib/cloud/preflight"
use "stdlib/cloud/watchdog"
use "stdlib/cloud/vast"
use "stdlib/cloud/runpod"
use "stdlib/cloud/dft_dispatch"
use "stdlib/cloud/fire_shards"
use "stdlib/cloud/pods_local"
use "stdlib/cloud/parallel_audit"
use "stdlib/cloud/providers_catalog"
use "stdlib/cloud/alive"
use "stdlib/http"
use "stdlib/cloud/api"
use "stdlib/cloud/provider_cli"
use "stdlib/sys"

// _cloud_help_render_roster — render the verb usage block by ITERATING the
// in-source SSOT cloud_commands() (grouped by `group`). No hand-typed verb
// list survives; a verb added to dispatch without a COMMANDS row is caught by
// stdlib/cloud/cloud_help_drift_test.hexa.
fn _cloud_help_render_roster() {
    let groups = ["lifecycle", "manage", "exec", "io", "plan", "meta"]
    let cmds = cloud_commands()
    let mut gi = 0
    while gi < len(groups) {
        let g = groups[gi]
        gi = gi + 1
        let mut i = 0
        while i < len(cmds) {
            let c = cmds[i]
            i = i + 1
            if c.group != g {
                continue
            }
            let mut head = "  cloud " + c.name
            if len(c.args) > 0 {
                head = head + " " + c.args
            }
            println(head)
            println("      " + c.summary)
        }
    }
}

fn _cloud_help() {
    println("hexa cloud — structured-argv remote dispatch (cycle A)")
    println("")
    println("usage:")
    _cloud_help_render_roster()
    println("")
    println("connection flags [conn] (before `--`):")
    println("  --port <n>      ssh to a non-22 port (RunPod / vast.ai)")
    println("  --insecure      accept a changing/unknown host key (ephemeral pods)")
    println("  --identity <p>  present a specific private key (-i p, IdentitiesOnly);")
    println("                  e.g. ~/.ssh/id_vast_anima for a vast-registered key")
    println("                  (#1155: default ~/.ssh/id_ed25519 is publickey-denied)")
    println("  --max-wall <s>  (run only) cap remote wall-clock at <s> seconds;")
    println("                  on expiry the remote command is killed and run")
    println("                  exits 124 (max-wall exceeded)")
    println("  --env <K=V>     (run/nohup) set a remote env var; repeatable.")
    println("                  K=V stays one argv token, so a value with spaces")
    println("                  survives remote word-splitting.")
    println("  --env-file <p>  (run/nohup) read K=V lines from <p> (blank and")
    println("                  #-comment lines skipped); each line acts as --env.")
    println("  --source <p>    (run/nohup/fire) dot-source remote file <p> BEFORE")
    println("                  the argv (repeatable, in order): wraps as")
    println("                  `bash -c '. <p> && exec <argv>'`. ssh runs a NON-")
    println("                  login shell so ~/.bashrc (conda init / module load)")
    println("                  is NOT sourced — without this, mpirun/toolchain are")
    println("                  off PATH and the job dies instantly (exit 127/243).")
    println("                  e.g. --source ~/miniforge3/etc/profile.d/conda.sh")
    println("                  (point at a script that also `conda activate <env>`).")
    println("  --early-life-check <s>  (nohup only) after the detached launch,")
    println("                  sleep <s> s then poll the remote pid once; exit 3 if")
    println("                  it already DIED (a launcher that execs and exits at")
    println("                  once) so the caller can tear the pod down instead of")
    println("                  burning a watchdog timeout on a job that never ran.")
    println("  --register [<jid>]  (nohup/fire) on a successful dispatch, write a")
    println("                  row to cwd's ./pods.json IN-PROCESS (no shell-out).")
    println("                  Bare form auto-generates jid = auto-<ts>-<host-short>;")
    println("                  explicit <jid> uses it as-is. Replaces the advisory")
    println("                  hint line — ghost-pod L2-auto. cwd = git toplevel")
    println("                  when in a repo, else literal pwd. A later `cloud")
    println("                  poll <host> <pid>` that returns DEAD auto-flips this")
    println("                  row's verdict PENDING→FAIL (conservative — bare poll")
    println("                  cannot see remote exit code; call `cloud dispatch")
    println("                  verdict <jid> PASS` to override).")
    println("  --grep <re>     (tail only) stream only lines matching the awk ERE")
    println("                  <re>; empty / absent = every line.")
    println("  --until <re>    (tail only) terminal behaviour. ABSENT = default")
    println("                  3-tier failure-first taxonomy → exit 0 DONE · 3")
    println("                  TIMEOUT-RESUMABLE · 4 CRASHED. An explicit ERE <re>")
    println("                  = legacy single block (print+quit exit 0 on first")
    println("                  match). Pass '' to follow forever (persistent Monitor).")
    println("  --resume        (copy-from) rsync --partial --append-verify; resume")
    println("                  an interrupted large-file pull (needs rsync >= 3.0).")
    println("  --recursive,-r  (copy-to) copy a directory tree (scp -r).")
    println("  --verify-sha    (copy-to/copy-from) after transfer, compare sha256 of")
    println("                  local vs remote; exit 103 mismatch / 104 if no sha tool.")
    println("  NB: for LARGE pod transfers use `copy-to` (scp, auto-retries a dropped")
    println("      stream up to 3×) — NOT raw `rsync` over a vast proxy, which drops")
    println("      mid-stream ('unexpected end of file'). copy-to + --verify-sha is the")
    println("      stable path; pair with `--recursive` for a tree. copy-to auto-creates")
    println("      the remote PARENT dir (mkdir -p; --no-mkparent opts out).")
    println("      Run MULTIPLE big transfers SEQUENTIALLY (not concurrent nohup) — a")
    println("      vast proxy races concurrent scp streams and silently drops one; or")
    println("      use `cloud bootstrap` which sequences them.")
    println("")
    println("`run` uses structured argv — every token POSIX-quoted before ssh, so")
    println("no remote shell parsing / glob / /* */ comment mis-parse can corrupt")
    println("the command. Use `run` for program dispatch.")
    println("`exec` joins post-`--` tokens with single spaces and sends the result")
    println("to the remote login shell AS-IS — pipes / globs / redirects / shell")
    println("variables all parse on the remote side. Use `exec` for ad-hoc")
    println("inspection (`cd /work && nvidia-smi | head -5`); caller owns quoting.")
    println("`host` is an ssh destination or ~/.ssh/config alias.")
    println("")
    println("provisioning flags (rent):")
    println("  --tier T        secure|community (alias --secure) — CANONICAL,")
    println("                  provider-agnostic tier select; the sanctioned")
    println("                  surface that replaces raw `runpodctl --secureCloud`.")
    println("                  secure = on-demand (host does NOT reclaim mid-run →")
    println("                  a build completes). runpod: → --cloud-type")
    println("                  SECURE/COMMUNITY (explicit --cloud-type wins). vast:")
    println("                  secure = the on-demand default; community unwired.")
    println("                  Absent = default behavior UNCHANGED.")
    println("  --cloud-type C  (runpod) SECURE|COMMUNITY|ALL low-level pin")
    println("                  (default ALL). Prefer the canonical --tier.")
    println("  --query Q       (vast) raw offer predicate; picks the first match.")
    println("                  NB: cpu_ram is in GB (2TB RAM = `cpu_ram>=2000`,")
    println("                  NOT the MB value `cloud api /bundles` reports).")
    println("  --include-unverified  (vast) also search unverified host-machines —")
    println("                  reaches cheap large-RAM / CPU-only boxes the default")
    println("                  verified=true filter hides. (= adds `verified=false`.)")
    println("  --offer ID      (vast) PIN a specific offer id — skips the query")
    println("                  search and binds THAT box; offers rotate, so a")
    println("                  --query that looked cheap can bind a different box.")
    println("                  Confirms the offer is still listed + captures its")
    println("                  dph BEFORE create.  e.g. cloud rent vast --offer 40455967")
    println("  --max-dph USD   (vast) rate ceiling — REFUSE any offer over USD/hr")
    println("                  before the billing create (works on --offer + --query).")
}

// _mh_json_str — JSON-encode a path-typed string for the __MONITOR_HANDLE__=
// one-liner emitted by `cloud nohup` (and later `cloud fire`). Escapes `"`
// and `\\`; other control chars are vanishingly unlikely in the only inputs
// (ssh host, remote logfile path). Mirrors the existing `__CLOUD_PID__=`
// marker shape — caller extracts with grep '^__MONITOR_HANDLE__='.
fn _mh_json_str(s: str) -> str {
    let mut out = "\""
    let mut i = 0
    while i < len(s) {
        let c = s.substring(i, i + 1)
        if c == "\"" {
            out = out + "\\\""
        } else if c == "\\" {
            out = out + "\\\\"
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out + "\""
}

// _cli_atoi — parse a non-negative decimal string; non-digits ignored.
fn _cli_atoi(s: str) -> int {
    let mut i = 0
    let mut v = 0
    let n = len(s)
    while i < n {
        let cc = char_code(s.substring(i, i + 1))
        if cc >= 48 && cc <= 57 {
            v = v * 10 + (cc - 48)
        }
        i = i + 1
    }
    return v
}

// _need_val — d4-generic value-flag validator. Given the flag KEY at av[i],
// return the value av[i+1] iff it exists AND does not itself look like a flag
// (`--*` / bare `--`). Otherwise emit a clear actionable error and exit(2),
// instead of silently swallowing the next flag as the value (the `--port
// --insecure` -> `Bad port '--insecure'` class of bug). Drives off the call
// site (every value-flag parser calls it) — no per-flag branch lives here.
fn _need_val(av: [str], i: int, key: str) -> str {
    if i + 1 >= len(av) {
        eprintln("[cloud] error: flag " + key + " needs a value, got end-of-args")
        exit(2)
    }
    let nxt = av[i + 1]
    if nxt == "--" || nxt.starts_with("--") {
        eprintln("[cloud] error: flag " + key + " needs a value, got '" + nxt + "'")
        exit(2)
    }
    return nxt
}
// _ttl_to_sec — parse a `--ttl` duration to seconds. Accepts a bare integer
// (seconds) or a `<N>s` / `<N>m` / `<N>h` suffix form. Empty / unparseable →
// -1 (UNSET, no TTL enforcement). M2 deadman uses this.
fn _ttl_to_sec(s: str) -> int {
    let n = len(s)
    if n == 0 {
        return -1
    }
    let last = s.substring(n - 1, n)
    let num = _cli_atoi(s)
    if num <= 0 {
        return -1
    }
    if last == "s" {
        return num
    }
    if last == "m" {
        return num * 60
    }
    if last == "h" {
        return num * 3600
    }
    return num
}

// _ssh_opts_cli — scan av[start..] (up to a "--" separator) for the
// connection flags --port <n> and --insecure, and build the ssh_opts list.
fn _ssh_opts_cli(av: [str], start: int) -> [str] {
    let mut opts = []
    let mut i = start
    while i < len(av) {
        let t = av[i]
        if t == "--" {
            i = len(av)
        } else if t == "--insecure" {
            opts.push("-o")
            opts.push("StrictHostKeyChecking=no")
            opts.push("-o")
            opts.push("UserKnownHostsFile=/dev/null")
            i = i + 1
        } else if t == "--identity" {
            // #1155: present a SPECIFIC private key (e.g. the vast-registered
            // ~/.ssh/id_vast_anima). Without this, hexa cloud's ssh offered
            // only the Mac default ~/.ssh/id_ed25519 — unregistered on vast →
            // `Permission denied (publickey)` on every direct-IP pod, forcing a
            // raw-ssh workaround OUTSIDE the sanctioned `hexa cloud` path.
            // IdentitiesOnly=yes stops ssh-agent keys from racing ahead of it.
            let idv = _need_val(av, i, "--identity")
            opts.push("-i")
            opts.push(idv)
            opts.push("-o")
            opts.push("IdentitiesOnly=yes")
            i = i + 2
        } else if t == "--port" {
            let pv = _need_val(av, i, "--port")
            opts.push("-p")
            opts.push(pv)
            i = i + 2
        } else if t == "--max-wall" {
            // run-verb wall cap (handled by _max_wall_cli) — skip flag+value
            // here so it never lands in ssh_opts.
            i = i + 2
        } else if t == "--early-life-check" {
            // nohup-verb early-death window (handled by _early_life_cli) —
            // skip flag+value here so it never lands in ssh_opts.
            i = i + 2
        } else if t == "--grep" || t == "--until" {
            // tail-verb filter / terminal regexes (handled by _flag_val) —
            // skip flag+value so a regex value never lands in ssh_opts.
            i = i + 2
        } else {
            i = i + 1
        }
    }
    return opts
}

// _max_wall_cli — scan av[start..] (up to a "--" separator) for the
// `--max-wall <sec>` run-verb flag and return the cap in seconds; 0 means
// no cap was given. Stops at "--" so a `--max-wall` token inside the remote
// argv is never consumed. Mirrors _ssh_opts_cli's pre-separator scan so the
// two coexist in the same [conn] region for the `run` verb.
fn _max_wall_cli(av: [str], start: int) -> int {
    let mut i = start
    while i < len(av) {
        let t = av[i]
        if t == "--" {
            return 0
        } else if t == "--max-wall" {
            return _cli_atoi(_need_val(av, i, "--max-wall"))
        }
        i = i + 1
    }
    return 0
}

// _early_life_cli — scan av[start..] (up to a "--" separator) for the
// _log_path_cli — scan av[start..] (up to a "--" separator) for `--log <path>`
// and return the path; "" means no --log was given (cloud_fire then
// auto-generates /tmp/cloud-<unix_ts>.log). Mirrors _early_life_cli's
// pre-separator scan.
fn _log_path_cli(av: [str], start: int) -> str {
    let mut i = start
    while i < len(av) {
        let t = av[i]
        if t == "--" { return "" }
        if t == "--log" {
            if i + 1 < len(av) { return av[i + 1] }
            return ""
        }
        i = i + 1
    }
    return ""
}

// `--early-life-check <sec>` nohup-verb flag and return the window in
// seconds; 0 means it was not given (check disabled). Stops at "--" so an
// `--early-life-check` token inside the remote argv is never consumed.
// Mirrors _max_wall_cli's pre-separator scan.
fn _early_life_cli(av: [str], start: int) -> int {
    let mut i = start
    while i < len(av) {
        let t = av[i]
        if t == "--" {
            return 0
        } else if t == "--early-life-check" {
            return _cli_atoi(_need_val(av, i, "--early-life-check"))
        }
        i = i + 1
    }
    return 0
}

// _register_cli — scan av[start..] (up to a "--" separator) for the
// `--register [<jid>]` flag. Three returns encoded as a single string:
//   ""                  — flag absent (no auto-register)
//   "__AUTO__"          — bare `--register` (caller auto-generates jid)
//   "<jid>"             — explicit `--register <jid>` (use this jid)
// A token right after --register that starts with "--" is treated as the
// NEXT flag, not the jid, so `--register --early-life-check 5` parses as
// bare register + early-life-check 5. Stops at "--" so `--register` inside
// the remote argv is never consumed.
fn _register_cli(av: [str], start: int) -> str {
    let mut i = start
    while i < len(av) {
        let t = av[i]
        if t == "--" {
            return ""
        } else if t == "--register" {
            if i + 1 < len(av) {
                let nxt = av[i + 1]
                if nxt == "--" || nxt.starts_with("--") {
                    return "__AUTO__"
                }
                return nxt
            }
            return "__AUTO__"
        }
        i = i + 1
    }
    return ""
}

// _host_short — collapse an ssh destination like "root@1.2.3.4" or
// "vast-anima.tail" into a short stable token suitable for an auto-jid
// suffix. Keeps [A-Za-z0-9-] only; collapses other chars to "-". Caps at
// 16 chars so the resulting jid stays a single readable token.
fn _host_short(host: str) -> str {
    let mut out = ""
    let mut i = 0
    let n = len(host)
    let mut start = 0
    // Skip past a leading "user@" — only the host part matters for the tag.
    let at_i = host.index_of("@")
    if at_i >= 0 { start = at_i + 1 }
    i = start
    let mut emitted = 0
    while i < n && emitted < 16 {
        let c = host.substring(i, i + 1)
        let cc = char_code(c)
        let is_alnum = (cc >= 48 && cc <= 57) || (cc >= 65 && cc <= 90) || (cc >= 97 && cc <= 122) || cc == 45
        if is_alnum {
            out = out + c
            emitted = emitted + 1
        } else if emitted > 0 && (len(out) == 0 || out.substring(len(out) - 1, len(out)) != "-") {
            out = out + "-"
            emitted = emitted + 1
        }
        i = i + 1
    }
    if len(out) == 0 { return "host" }
    return out
}

// _resolve_cwd — git-rooted repo dir when available, else literal `pwd`.
// Matches the advisory line's `"$(pwd)"` shape so a manual + auto-register
// land at the SAME pods.json (no split-ledger).
fn _resolve_cwd() -> str {
    let git_top = exec("git rev-parse --show-toplevel 2>/dev/null").trim()
    if len(git_top) > 0 { return git_top }
    return exec("pwd").trim()
}

// _basename — last path segment of `p` (no trailing-slash handling needed
// for git-toplevel output, which never trails). "" → "".
fn _basename(p: str) -> str {
    let n = len(p)
    if n == 0 {
        return ""
    }
    let mut last = -1
    let mut i = 0
    while i < n {
        if p.substring(i, i + 1) == "/" {
            last = i
        }
        i = i + 1
    }
    return p.substring(last + 1, n)
}

// _repo_root_basename — the CANONICAL git-repo name, worktree-safe. A git
// worktree's `--show-toplevel` returns the WORKTREE dir (e.g.
// `anima/.claude/worktrees/evaluate-py-option`), so sibling worktrees of ONE
// repo mis-resolve to different project basenames and the cross-project guard
// treats them as foreign. `--git-common-dir` (absolute) always points at the
// MAIN repo's `.git` (`<mainroot>/.git`), so its parent basename is the true
// repo identity (`anima`) from ANY worktree. "" when not a git repo.
fn _repo_root_basename() -> str {
    let common = exec("git rev-parse --path-format=absolute --git-common-dir 2>/dev/null").trim()
    if len(common) > 0 {
        let parent = exec("dirname \"" + common + "\" 2>/dev/null").trim()
        let base = _basename(parent)
        if len(base) > 0 {
            return base
        }
    }
    return ""
}

// _at_prefix — render a repo/folder name as an `@`-prefixed project tag
// (the rent-invocation cwd's project identity, e.g. cwd
// `/Users/mini/dancinlab/demiurge` → `@demiurge`). Idempotent: a name that
// already leads with `@` is returned unchanged; "" stays "".
fn _at_prefix(name: str) -> str {
    if len(name) == 0 {
        return ""
    }
    if name.substring(0, 1) == "@" {
        return name
    }
    return "@" + name
}

// _resolve_project — the owning PROJECT (= repo / folder / project name) of the
// rent-invocation cwd, used by rent/up/run/nohup/adopt to STAMP attribution and
// by down/destroy to derive the cwd project for the cross-project kill-guard.
// Resolution order: an explicit `--project <name>` flag wins; else the cwd
// git-repo basename (`git rev-parse --show-toplevel` → basename); else (NOT a
// git repo) the cwd folder basename (`pwd`). All forms are `@`-prefixed, so a
// rent from `/Users/mini/dancinlab/demiurge` tags the pod `@demiurge`. Only an
// empty cwd degrades to "@unattributed".
fn _resolve_project(av: [str], start: int) -> str {
    let flag = _flag_val(av, start, "--project", "")
    if len(flag) > 0 {
        return _at_prefix(flag)
    }
    let repo = _repo_root_basename()
    if len(repo) > 0 {
        return _at_prefix(repo)
    }
    let pwd = exec("pwd").trim()
    if len(pwd) > 0 {
        return _at_prefix(_basename(pwd))
    }
    return "@unattributed"
}

// _resolve_purpose — the free-form TASK DESCRIPTION for a rented pod. An
// explicit `--desc`/`--purpose <text>` flag wins (the new task-description
// surface); else fall back to the legacy `--owner` tag (which historically
// doubled as the purpose); else "unspecified". The (project, purpose) pair is
// the idempotent-rent dedup key + the down-guard surface, and is rendered by
// `cloud list`.
fn _resolve_purpose(av: [str], start: int) -> str {
    let desc = _flag_val(av, start, "--desc", "")
    if len(desc) > 0 {
        return desc
    }
    let purp = _flag_val(av, start, "--purpose", "")
    if len(purp) > 0 {
        return purp
    }
    let owner = _flag_val(av, start, "--owner", "")
    if len(owner) > 0 {
        return owner
    }
    return "unspecified"
}

// _slugify — lowercase + collapse any non-[a-z0-9] run to a single `-`, trim a
// trailing `-`. Builds the provider `--label` (vast) / `--name` (runpod) from a
// free-form project+purpose so a raw `vastai show instances` surfaces the
// attribution too (e.g. `@demiurge` + `r12 gold harvest` →
// `demiurge-r12-gold-harvest`).
fn _slugify(s: str) -> str {
    let mut out = ""
    let mut prev_dash = 1
    let n = len(s)
    let mut i = 0
    while i < n {
        let c = s.substring(i, i + 1)
        let lc = c.to_lower()
        let is_digit = c >= "0" && c <= "9"
        let is_alpha = lc >= "a" && lc <= "z"
        if is_digit || is_alpha {
            out = out + lc
            prev_dash = 0
        } else {
            if prev_dash == 0 {
                out = out + "-"
                prev_dash = 1
            }
        }
        i = i + 1
    }
    // trim a trailing dash (a leading one is impossible — prev_dash starts 1).
    let m = len(out)
    if m > 0 && out.substring(m - 1, m) == "-" {
        out = out.substring(0, m - 1)
    }
    return out
}

// _project_purpose_label — the provider-side `project-purpose` slug stamped on
// the underlying vast `--label` / runpod `--name` so a raw provider list shows
// the attribution (@L3). Slugifies both (the `@` is dropped by _slugify), joins
// with `-`. Either part blank → just the other; both blank → "hexa-cloud".
fn _project_purpose_label(project: str, purpose: str) -> str {
    let p = _slugify(project)
    let q = _slugify(purpose)
    if len(p) > 0 && len(q) > 0 {
        return p + "-" + q
    }
    if len(p) > 0 {
        return p
    }
    if len(q) > 0 {
        return q
    }
    return "hexa-cloud"
}

// _cwd_project — the cwd's owning project (git-repo basename, else
// "unattributed"). The down-guard compares this against the target pod's
// stored project to refuse a cross-project teardown. NO --project override
// here: the guard must compare the REAL cwd, not an asserted one (--force is
// the only bypass).
fn _cwd_project() -> str {
    // worktree-safe canonical repo identity, `@`-prefixed to match the STORED
    // owner format (`_resolve_project` always `@`-prefixes). The old code
    // returned a bare worktree basename, so (a) sibling worktrees of one repo
    // mis-matched, and (b) the `@`-asymmetry made even a same-repo teardown
    // fail. Both fixed here.
    let repo = _repo_root_basename()
    if len(repo) > 0 {
        return _at_prefix(repo)
    }
    return "unattributed"
}

// _auto_register — Fix A worker. Build a synthetic argv that mirrors the
// `cloud dispatch add` positional contract (`<jid> <pod-id> <dir>` + named
// flags) and call pods_local_add in-process. Returns the jid actually
// written. Matches the advisory line's slotting: pid as pod-id, host via
// --host. cwd = git-root else pwd. Emits the `registered jid=...` line.
fn _auto_register(reg_token: str, host: str, pid: int) -> str {
    let mut jid = reg_token
    if jid == "__AUTO__" {
        jid = "auto-" + str(timestamp()) + "-" + _host_short(host)
    }
    let cwd = _resolve_cwd()
    let pid_s = str(pid)
    let mut synth = []
    synth.push(jid)
    synth.push(pid_s)
    synth.push(cwd)
    synth.push("--host=" + host)
    synth.push("--stage=running")
    synth.push("--verdict=PENDING")
    synth.push("--pid=" + pid_s)
    let _ = pods_local_add(synth, 0)
    println("[cloud] 📋 registered jid=" + jid + " in " + cwd + "/ING.jsonl")
    return jid
}

// _rent_register_pods_json — Q2 worker. On a successful `cloud rent`, write a
// ./pods.json row IN-PROCESS so a freshly-rented pod can never become an
// untracked ghost (symmetry with nohup/fire `--register`). Reuses the SAME
// pods_local_add gateway as `cloud dispatch add` / `_auto_register` (d4 single
// dispatch — no duplicated writer). job-id = `rent-<ts>-<host-short>`; the
// PROVIDER pod-id is the pod-id; stage=rented, verdict=PENDING (no deck yet —
// that PENDING is exactly the leak signal the watchdog/operator looks for).
// cwd = git-root else pwd, so a manual + auto register land in one file.
fn _rent_register_pods_json(pod_id: str, host: str, provider: str, owner: str) -> str {
    let jid = "rent-" + str(timestamp()) + "-" + _host_short(host)
    let cwd = _resolve_cwd()
    let mut synth = []
    synth.push(jid)
    synth.push(pod_id)
    synth.push(cwd)
    if len(host) > 0 { synth.push("--host=" + host) }
    synth.push("--provider=" + provider)
    synth.push("--kind=rent")
    synth.push("--stage=rented")
    synth.push("--verdict=PENDING")
    let _ = pods_local_add(synth, 0)
    println("[cloud] 📋 registered jid=" + jid + " (pod " + pod_id + ") in " + cwd + "/ING.jsonl — `cloud dispatch verdict " + jid + " PASS` once a deck lands")
    return jid
}

// _emit_rent_result — OWNERSHIP-SPLIT boundary contract (pod-attribution split).
// hexa cloud is POD-OPS-ONLY and WRITE-FORBIDDEN to the attribution/label
// harness; it EMITS raw pod FACTS on a single machine-readable stdout line and
// stops fabricating a blank/owner attribution row in ./pods.json. The sidecar
// recorder (sidecar repo) consumes this line + caller context and OWNS the
// {project · candidate · lane · kind} attribution write (no-omission + fallback).
//
// Schema (the contract both repos compose on — fields space-separated, each
// `key=value`, value is the raw fact verbatim, NO derivation here):
//   rent-result pod=<id> host=<h> provider=<p> state=<s> [project=<p>] [deck=<prefix>]
// `project`/`deck` are emitted ONLY when hexa cloud already has them as a
// pod-op fact (project = the dedup/down-guard key; deck = the dft-run deck
// dir). hexa cloud NEVER invents a label/candidate — that is sidecar's job.
fn _emit_rent_result(pod_id: str, host: str, provider: str, state: str, project: str, deck: str) {
    let mut line = "rent-result pod=" + pod_id + " host=" + host + " provider=" + provider + " state=" + state
    if len(project) > 0 && project != "unattributed" {
        line = line + " project=" + project
    }
    if len(deck) > 0 {
        line = line + " deck=" + deck
    }
    println(line)
}

// _teardown_verdict_if_registered — Fix B worker. After `cloud poll` detects
// DEAD, scan ./ING.jsonl's `kind:"pod"` rows' folded jobs[] for a job whose
// `pid` matches the polled pid. On hit, rewrite verdict=FAIL (we do NOT have
// the remote exit code from a bare poll, so we default conservative — a
// launcher that wants PASS can call `cloud dispatch verdict <jid> PASS`
// itself). On miss, no-op. Returns 1 iff a verdict was written, else 0.
fn _teardown_verdict_if_registered(pid: int) -> int {
    let path = "./ING.jsonl"
    let r = exec_capture("test -e " + path + " && echo y")
    if r[0] != "y\n" { return 0 }
    let raw = read_file(path)
    if len(raw.trim()) == 0 { return 0 }
    let lines = raw.split("\n")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i].trim()
        if len(ln) > 0 {
            let row = json_parse(ln)
            if json_object_get_str(row, "kind", "") == "pod" && json_object_has(row, "jobs") {
                let jarr = json_object_get_array(row, "jobs")
                let mut k = 0
                while k < len(jarr) {
                    let j = jarr[k]
                    let jpid = json_object_get_int(j, "pid", 0)
                    let verdict = json_object_get_str(j, "verdict", "")
                    let jid = json_object_get_str(j, "job_id", "")
                    // Only re-verdict PENDING rows — never overwrite a
                    // caller-set PASS/FAIL/DOWN (s11: no clobber).
                    if jpid == pid && verdict == "PENDING" && len(jid) > 0 {
                        let _ = pods_local_verdict(jid, "FAIL")
                        println("[cloud] 📋 teardown verdict=FAIL jid=" + jid)
                        return 1
                    }
                    k = k + 1
                }
            }
        }
        i = i + 1
    }
    return 0
}

// _collect_after — argv elements after the first "--" at or past `start`;
// if there is no "--", every element from `start` onward.
fn _collect_after(av: [str], start: int) -> [str] {
    let mut sepi = -1
    let mut i = start
    while i < len(av) {
        if av[i] == "--" {
            sepi = i
            i = len(av)
        } else {
            i = i + 1
        }
    }
    let mut from = start
    if sepi >= 0 {
        from = sepi + 1
    }
    let mut out = []
    let mut k = from
    while k < len(av) {
        out.push(av[k])
        k = k + 1
    }
    return out
}

// _copy_is_value_flag — for the copy verbs' positional collector: a flag that
// CONSUMES the following token as its value (so that value is never mistaken
// for a positional src/dest). Bug-3 (@L7): `copy-from host remote local --port
// 11118` placed `--port` where the fixed-index parser read it AS the source →
// `root@host:--port` scp dest, exit 255. Listing the value-flags lets the
// collector skip BOTH the flag and its value.
fn _copy_is_value_flag(t: str) -> int {
    if t == "--port" { return 1 }
    if t == "--identity" { return 1 }
    return 0
}

// _copy_is_bool_flag — a flag that consumes ONLY itself (no value) for the
// copy verbs. Anything that is neither a value-flag, a bool-flag, nor `--` is
// a positional.
fn _copy_is_bool_flag(t: str) -> int {
    if t == "--insecure" { return 1 }
    if t == "--recursive" { return 1 }
    if t == "-r" { return 1 }
    if t == "--resume" { return 1 }
    if t == "--verify-sha" { return 1 }
    return 0
}

// _copy_positionals — collect the positional args of a copy verb from av[start..],
// SKIPPING flags (and a value-flag's value) wherever they appear, so a `--port
// N` placed before / between / after the src+dest is parsed as a flag and the
// two real positionals are recovered in order. Stops at a bare `--` (anything
// after it is positional verbatim — though copy verbs take no trailing argv).
// d4: one funnel, both copy verbs call it; no per-verb index arithmetic.
fn _copy_positionals(av: [str], start: int) -> [str] {
    let mut out = []
    let mut i = start
    while i < len(av) {
        let t = av[i]
        if t == "--" {
            i = i + 1
            while i < len(av) {
                out.push(av[i])
                i = i + 1
            }
            return out
        }
        if _copy_is_value_flag(t) == 1 {
            i = i + 2   // skip flag + its value
        } else if _copy_is_bool_flag(t) == 1 {
            i = i + 1   // skip flag only
        } else {
            out.push(t)
            i = i + 1
        }
    }
    return out
}

// _env_file_kvs — read a KEY=VALUE-per-line env file into a [str] of
// "KEY=VALUE" tokens. Blank lines and `#`-comment lines are skipped; a
// line is kept only if it carries a `=` past column 0. A missing file
// emits one warning and yields no tokens (the dispatch still proceeds).
fn _env_file_kvs(path: str) -> [str] {
    let mut out = []
    if !file_exists(path) {
        println("[cloud] warn: --env-file not found, ignoring: " + path)
        return out
    }
    let lines = read_file(path).split("\n")
    let mut i = 0
    while i < len(lines) {
        let line = lines[i].trim()
        if len(line) > 0 && line.substring(0, 1) != "#" && line.index_of("=") > 0 {
            out.push(line)
        }
        i = i + 1
    }
    return out
}

// _env_args_cli — scan av[start..] (up to a "--" separator) for repeatable
// `--env KEY=VALUE` flags and `--env-file <path>` flags, returning the
// collected "KEY=VALUE" tokens in order. Stops at "--" so an --env token
// inside the remote argv is never consumed. Each KEY=VALUE stays a SINGLE
// argv element end-to-end, so a value with spaces survives remote word-
// splitting — the anima dispatch bug (shell `env K=v` word-split) these
// flags close.
fn _env_args_cli(av: [str], start: int) -> [str] {
    let mut out = []
    let mut i = start
    while i < len(av) {
        let t = av[i]
        if t == "--" {
            return out
        } else if t == "--env" {
            out.push(_need_val(av, i, "--env"))
            i = i + 2
        } else if t == "--env-file" {
            let fkvs = _env_file_kvs(_need_val(av, i, "--env-file"))
            let mut k = 0
            while k < len(fkvs) {
                out.push(fkvs[k])
                k = k + 1
            }
            i = i + 2
        } else {
            i = i + 1
        }
    }
    return out
}

// _with_env — prepend `env KEY=VALUE ...` to a structured argv so the
// remote command runs under the requested environment. Returns argv
// unchanged when there are no env tokens (the bare command, no `env`
// wrapper). `env` is POSIX-standard and present on every Linux pod image.
fn _with_env(env_kvs: [str], argv: [str]) -> [str] {
    if len(env_kvs) == 0 {
        return argv
    }
    let mut out = []
    out.push("env")
    let mut i = 0
    while i < len(env_kvs) {
        out.push(env_kvs[i])
        i = i + 1
    }
    let mut j = 0
    while j < len(argv) {
        out.push(argv[j])
        j = j + 1
    }
    return out
}

// _shq_src — single-quote-wrap a token for safe embedding in the `bash -c`
// shell string built by _with_source (escapes any internal single quote).
fn _shq_src(s: str) -> str {
    let mut out = "'"
    let n = len(s)
    let mut i = 0
    while i < n {
        let c = s.substring(i, i + 1)
        if c == "'" {
            out = out + "'\\''"
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out + "'"
}

// _source_args_cli — scan av[start..] (up to "--") for repeatable
// `--source <remote-path>` flags, returning the paths in order (mirror of
// _env_args_cli). A command launched over ssh runs in a NON-interactive,
// NON-login shell, so ~/.bashrc (where `conda init` + module/PATH setup live)
// is NOT sourced — `mpirun`/`ph.x`/toolchain binaries fall off PATH and the
// command dies instantly ("mpirun: command not found", exit 243/127). Setting
// individual vars via --env cannot replay a `conda activate` (a shell function,
// not a var). `--source <file>` dot-sources <file> on the remote BEFORE the
// argv runs, so the caller activates a conda env / loads modules determinist-
// ically. Repeatable; sourced in order.
fn _source_args_cli(av: [str], start: int) -> [str] {
    let mut out = []
    let mut i = start
    while i < len(av) {
        let t = av[i]
        if t == "--" {
            return out
        } else if t == "--source" {
            out.push(_need_val(av, i, "--source"))
            i = i + 2
        } else {
            i = i + 1
        }
    }
    return out
}

// _with_source — wrap a structured argv so the remote runs
// `bash -c '. <f1> && . <f2> && exec <argv>'`. Returns argv unchanged when
// there are no --source files. `exec` keeps the tracked PID identical to the
// final process (so cloud_nohup's `$!` is the real job, not a transient bash).
// Composes AFTER _with_env — the env-prefixed argv (`env K=V <cmd>`) becomes
// the exec target, so --source and --env stack cleanly.
fn _with_source(src: [str], argv: [str]) -> [str] {
    if len(src) == 0 {
        return argv
    }
    let mut sh = ""
    let mut i = 0
    while i < len(src) {
        sh = sh + ". " + _shq_src(src[i]) + " && "
        i = i + 1
    }
    sh = sh + "exec"
    let mut j = 0
    while j < len(argv) {
        sh = sh + " " + _shq_src(argv[j])
        j = j + 1
    }
    let mut out = []
    out.push("bash")
    out.push("-c")
    out.push(sh)
    return out
}

// _checked_host — guard the positional <host> token. Every cloud verb takes
// `<host>` FIRST, then [conn]/flags, then `-- <argv>`. A real ssh destination
// (user@host · alias · IP) NEVER starts with `--`, so a `--`-leading token in
// the host slot means the caller misplaced a flag (or omitted <host>) — the
// CLI used to silently treat it AS the host, ssh to it, and exit 255, which
// reads like a phantom "gateway outage". Reject it loudly instead (INBOX
// 2026-05-28 cloud gap 2, P1). Returns `h` unchanged for any legal host.
fn _checked_host(h: str) -> str {
    if len(h) >= 2 && h.substring(0, 2) == "--" {
        eprintln("[cloud] '" + h + "' looks like a flag, not a host — every verb is positional `<host> [--port N] [--insecure] ... -- <argv>` (flags go AFTER <host>, args AFTER `--`). Misplaced flag, or omitted <host>?")
        exit(2)
    }
    return h
}

// _is_vast_numeric_id — PURE: 1 iff `h` is a bare vast.ai instance id (all
// ASCII digits, length >= 5). A real ssh destination carries an `@` (user@host)
// or a `.` (dotted IP / dns), or is a `~/.ssh/config` alias with letters; a bare
// numeric token is therefore a provider pod-id, not a host. vast ids are 7-8
// digits today — the >=5 floor keeps a stray `22` / `2222` from being mistaken
// for an id while staying robust to any future id width.
fn _is_vast_numeric_id(h: str) -> int {
    let n = len(h)
    if n < 5 {
        return 0
    }
    let mut i = 0
    while i < n {
        let c = h.substring(i, i + 1)
        if c < "0" || c > "9" {
            return 0
        }
        i = i + 1
    }
    return 1
}

// ResolvedHost — the host slot after numeric-id resolution. `resolved=1` means
// `host` was a bare vast id and is now an ssh destination (root@<endpoint>) with
// `port` set; `via` records which endpoint won ("proxy" | "direct"). resolved=0
// leaves `host` byte-for-byte unchanged (a real host, or an id with no live
// endpoint yet — the existing ~/.ssh/config / explicit-flag paths still apply).
struct ResolvedHost {
    host:     str,
    port:     str,
    resolved: int,
    via:      str
}

// _resolve_cloud_host — PROXY-FIRST numeric-id → ssh-destination resolver
// (handoff a6a268a9). When `<host>` is a bare vast id, `run`/`exec`/`nohup`/
// `fire`/`copy-to`/`copy-from` used to hand the digits straight to ssh, which
// resolved them via ~/.ssh/config (only if rent/adopt had injected a block) or
// fell through to the bare-IP:22 direct endpoint — a blocked/stale 2.65.x IP
// that silently TIMES OUT. This mirrors the #2098 adopt autoinject fix at the
// VERB layer so every transport verb reaches the live proxy without a config
// block: prefer the proxy endpoint (vast_ssh_endpoint → ssh*.vast.ai:<port>),
// fall back to the bare direct IP only when the proxy is not yet mapped, and
// leave a non-id host (or an unmapped id) untouched. Pure-ish: the only effect
// is the vastai read inside vast_*_endpoint.
// _pool_resolve — map a pool-roster name (e.g. "summer") to its ssh
// destination ("summer@192.168.50.60") via ~/.pool/pool.json (commons g9).
// Returns "" when the file is absent or the name is not in the roster — the
// caller then falls back to the legacy ssh-config alias passthrough, so
// existing ~/.ssh/config Host aliases keep working unchanged.
fn _pool_resolve(h: str) -> str {
    let path = env_var("HOME") + "/.pool/pool.json"
    let raw = read_file(path)
    if len(raw) == 0 { return "" }
    let root = json_parse(raw)
    let hosts = json_object_get_array(root, "hosts")
    let mut i = 0
    while i < len(hosts) {
        if json_object_get_str(hosts[i], "name", "") == h {
            return json_object_get_str(hosts[i], "ssh", "")
        }
        i = i + 1
    }
    return ""
}

// _registry_resolved_host — adapt a PodEndpoint (M5 registry hit) to a
// ResolvedHost. A stored ssh_host that already carries `user@` is honored
// verbatim; a bare host/IP is prefixed `root@` (pods are root — matches the
// vast/runpod resolution convention and dft_dispatch's `root@<ip>`). via is
// "registry" so the run/poll banner names the resolution source.
fn _registry_resolved_host(ep: PodEndpoint) -> ResolvedHost {
    let mut host = ep.host
    if host.contains("@") == false {
        host = "root@" + host
    }
    return ResolvedHost { host: host, port: ep.port, resolved: 1, via: "registry" }
}

// _resolve_via_provider — last-resort pod-id → ssh endpoint via the LIVE
// provider API (the same path `hexa cloud ssh-port` runs), used when the M5
// registry has no host/port for the id. This is the Bug-cloud-resolver fix:
// a pod registered while still RENTING has an EMPTY ssh_host in the registry,
// so pod_registry_resolve_endpoint returns resolved=0 and the old resolver fell
// through to handing the BARE pod-id to ssh → "Could not resolve hostname
// <pod-id>". `ssh-port` never had this defect because it queries the provider
// directly; here we reuse _provider_ssh_port_lookup so run/copy-to share that
// path. On a hit we SELF-HEAL the registry (pod_registry_add upsert: a non-empty
// ssh_host/ssh_port updates in place, "" project/purpose/status preserve the
// prior attribution) so the next call is a fast registry hit. resolved=0 (id
// unchanged) when the provider has not mapped port 22 yet — the caller then
// fails LOUD rather than ssh-ing the bare id.
// _strip_user_at — drop a leading `user@` from an ssh dest so the BARE host/IP
// is stored in the registry (the registry holds bare ssh_host; the read path
// _registry_resolved_host re-prefixes `root@`). No `@` → returned unchanged.
fn _strip_user_at(dest: str) -> str {
    let at = dest.index_of("@")
    if at < 0 {
        return dest
    }
    return dest.substring(at + 1, len(dest))
}

fn _resolve_via_provider(h: str) -> ResolvedHost {
    let provider = _provider_for_id(h)
    let rh = _provider_ssh_port_lookup(h, provider)
    if rh.resolved == 1 {
        // self-heal: write the resolved endpoint back so subsequent calls hit
        // the registry fast. ssh_host is stored WITHOUT the `root@` prefix to
        // match _registry_resolved_host's contract (it re-prefixes on read).
        let bare_host = _strip_user_at(rh.host)
        let _ = pod_registry_add(h, provider, "", "", bare_host, rh.port, "")
    }
    return rh
}

fn _resolve_cloud_host(h: str) -> ResolvedHost {
    if _is_vast_numeric_id(h) == 0 {
        // #handoff-aad9f4c0: a bare dotted endpoint (direct IP / DNS) with NO
        // explicit `user@` defaulted to the LOCAL login (e.g. `mini@1.2.3.4`)
        // → `Permission denied (publickey)` on a rented pod (which is root),
        // forcing a raw-ssh workaround OUTSIDE `hexa cloud`. Default it to
        // `root@` — pods are root, matching the resolved-id branches below +
        // dft_dispatch's `root@ + host_ip` convention. A bare alias (no dot,
        // e.g. a ~/.ssh/config Host with its own User) is LEFT untouched so the
        // config's User directive still applies; an explicit `user@` is honored.
        if h.contains(".") {
            if h.contains("@") {
                return ResolvedHost { host: h, port: "", resolved: 0, via: "" }
            }
            return ResolvedHost { host: "root@" + h, port: "", resolved: 0, via: "direct-root" }
        }
        // bare name (no dot, no @) — try the pool roster (~/.pool/pool.json)
        // name→ssh BEFORE the legacy ~/.ssh/config alias passthrough. A roster
        // hit (e.g. "summer" → "summer@192.168.50.60") makes `hexa cloud run
        // summer` resolve like `sidecar pool on summer` (commons g9); a miss
        // falls through to the unchanged ssh-config alias path below.
        let pool_ssh = _pool_resolve(h)
        if len(pool_ssh) > 0 {
            return ResolvedHost { host: pool_ssh, port: "", resolved: 0, via: "pool" }
        }
        // Bug-1 (@L5): a non-numeric provider pod-id (e.g. a runpod id like
        // `8g5r7jup4lw35e`) is neither a dotted endpoint nor a pool name — try
        // the M5 registry for a stored ssh_host+ssh_port before giving up. A
        // hit reaches the pod by its registry id with no hand-typed host/port.
        let reg = pod_registry_resolve_endpoint(h)
        if reg.resolved == 1 {
            return _registry_resolved_host(reg)
        }
        // Bug-cloud-resolver: registry MISS (id untracked OR registered while
        // still RENTING → empty ssh_host). Don't ssh the bare pod-id — fall
        // back to the LIVE provider API (the path `ssh-port` uses), self-healing
        // the registry on a hit. A still-RENTING pod returns resolved=0; the
        // caller then fails loud instead of `ssh <pod-id>`.
        return _resolve_via_provider(h)
    }
    let proxy = vast_ssh_endpoint(h)
    if proxy.ok == 1 {
        return ResolvedHost { host: "root@" + proxy.host, port: proxy.port, resolved: 1, via: "proxy" }
    }
    let direct = vast_direct_endpoint(h)
    if direct.ok == 1 {
        return ResolvedHost { host: "root@" + direct.host, port: direct.port, resolved: 1, via: "direct" }
    }
    // Bug-1 (@L5): a numeric vast id with NO live provider endpoint (vastai
    // CLI absent / offline / proxy+direct both unmapped) — fall back to the M5
    // registry's stored ssh_host+ssh_port. THIS is the edge-genall path: pod
    // 38961119 had ssh_host "ssh1.vast.ai" + ssh_port "11118" recorded, but the
    // endpoint lookups returned nothing locally, so poll hit :22 and reported a
    // false DEAD. The registry hit now carries the real :11118.
    let reg = pod_registry_resolve_endpoint(h)
    if reg.resolved == 1 {
        return _registry_resolved_host(reg)
    }
    // No live endpoint AND no registry mapping — leave the id as-is so the
    // legacy ~/.ssh/config block path (written by rent/adopt) still applies.
    return ResolvedHost { host: h, port: "", resolved: 0, via: "" }
}

// _guard_resolved_or_die — fail LOUD when a transport verb's pod-id resolved to
// NOTHING via either the registry OR the provider API (via="unresolved"),
// instead of letting ssh attempt the bare pod-id and emit the cryptic
// "Could not resolve hostname <pod-id>". Only the provider-fallback miss carries
// via="unresolved"; a real host (dotted IP, user@dest, pool name, or a numeric
// id falling through to ~/.ssh/config) keeps a different via and is LEFT to its
// existing path. `verb`/`id` name the surface in the diagnostic.
fn _guard_resolved_or_die(verb: str, id: str, rh: ResolvedHost) {
    if rh.resolved == 0 && rh.via == "unresolved" {
        println("[cloud] " + verb + ": could not resolve '" + id
            + "' via registry or provider API — pod may still be RENTING (ssh not yet mapped). "
            + "Check `hexa cloud ssh-port " + id + "` / `hexa cloud pods`.")
        exit(2)
    }
}

// DirectRetry — the result of a proxy→direct fallback decision. `retry=1`
// means the proxy dispatch hit a TRANSPORT OUTAGE (ssh exit 255: connection
// refused / timeout) and a live DIRECT endpoint is mapped, so the caller
// should re-dispatch ONCE against `host`/`ssh_opts` (the bare public-IP:port).
// `retry=0` leaves the original proxy result authoritative.
struct DirectRetry {
    retry:    int,
    host:     str,
    ssh_opts: [str]
}

// _proxy_fallback_direct — proxy→direct single-retry decision (Fix-cloud-1).
// PROXY-FIRST stays the default (ghost's network needs it — a stale direct IP
// silently times out there); this ONLY fires when the proxy dispatch returned a
// TRANSPORT OUTAGE (`exit_code == 255`, the _ssh_transport_outage code — ssh
// never reached the remote shell), NOT on a genuine remote command failure
// (any other exit code came from a command that actually ran). On mini's
// network the assumption is inverted — the proxy refuses at TCP while the
// direct endpoint connects — so when the proxy was the winning endpoint and it
// outaged, retry ONCE via vast_direct_endpoint(iid). `iid` is the original bare
// vast id; `base_opts` are the user ssh_opts BEFORE the resolved proxy port was
// injected, so the direct retry carries the DIRECT port (not the stale proxy
// one). retry=0 when the proxy did not win, the failure was not a transport
// outage, or no direct endpoint is mapped.
fn _proxy_fallback_direct(iid: str, rh: ResolvedHost, base_opts: [str], exit_code: int) -> DirectRetry {
    if rh.resolved == 0 || rh.via != "proxy" || exit_code != 255 {
        return DirectRetry { retry: 0, host: "", ssh_opts: [] }
    }
    let direct = vast_direct_endpoint(iid)
    if direct.ok == 0 {
        return DirectRetry { retry: 0, host: "", ssh_opts: [] }
    }
    let drh = ResolvedHost { host: "root@" + direct.host, port: direct.port, resolved: 1, via: "direct" }
    return DirectRetry { retry: 1, host: drh.host, ssh_opts: _apply_resolved_port(base_opts, drh) }
}

// _ssh_opts_has_port — 1 iff ssh_opts already carries an explicit `-p <n>`
// (the user passed `--port`). Used to decide whether a resolved proxy port
// should be injected — an explicit `--port` always wins.
fn _ssh_opts_has_port(opts: [str]) -> int {
    let mut i = 0
    while i < len(opts) {
        if opts[i] == "-p" {
            return 1
        }
        i = i + 1
    }
    return 0
}

// _apply_resolved_port — append the resolved endpoint's `-p <port>` to ssh_opts
// UNLESS the caller already set an explicit `--port` (which wins). Returns the
// (possibly extended) ssh_opts list. d4: one funnel, no per-verb branch.
fn _apply_resolved_port(opts: [str], rh: ResolvedHost) -> [str] {
    if rh.resolved == 0 || len(rh.port) == 0 {
        return opts
    }
    if _ssh_opts_has_port(opts) == 1 {
        return opts
    }
    let mut out = opts
    out.push("-p")
    out.push(rh.port)
    return out
}

// _flag_val — scan av[start..] for `<key> <value>` and return the value;
// `dflt` when the flag is ABSENT. When the key IS present but its value is
// missing or itself looks like a flag (`--*` / bare `--`), error+exit(2) via
// _need_val rather than silently swallowing the next flag (same value-flag
// guard as the positional consumers — driven by the call site, no per-flag
// branch).
fn _flag_val(av: [str], start: int, key: str, dflt: str) -> str {
    let mut i = start
    while i < len(av) {
        if av[i] == key {
            return _need_val(av, i, key)
        }
        i = i + 1
    }
    return dflt
}

// _has_flag — 1 iff `flag` appears anywhere in av[start..], else 0.
fn _has_flag(av: [str], start: int, flag: str) -> int {
    let mut i = start
    while i < len(av) {
        if av[i] == flag {
            return 1
        }
        i = i + 1
    }
    return 0
}

// _tier_to_cloud_type — map the CANONICAL `--tier secure|community|on-demand|
// interruptible` value (provider-agnostic words the operator thinks in) to a
// runpod cloud-type token (SECURE | COMMUNITY | ALL). This is the canonical
// surface that REPLACES reaching for the raw `runpodctl ... --secureCloud`
// flag (canonical-cli governance): secure/on-demand = a tier the provider does
// NOT reclaim mid-run (build completes), community/interruptible = the cheap
// pre-emptible pool. "" / unknown → "" (no tier asked — caller keeps its
// default). Pure; equality-only to match this file's style.
fn _tier_to_cloud_type(tier: str) -> str {
    let t = tier.trim().to_lower()
    if len(t) == 0 {
        return ""
    }
    if t == "secure" || t == "on-demand" || t == "ondemand" {
        return "SECURE"
    }
    if t == "community" || t == "interruptible" || t == "spot" {
        return "COMMUNITY"
    }
    if t == "all" || t == "any" {
        return "ALL"
    }
    return ""
}

// _resolve_tier — read the canonical tier surface from av[start..] and return
// the runpod cloud-type token it implies, or "" when the operator asked for no
// tier. Surface (opt-in, default-OFF → behavior UNCHANGED when absent):
//   --tier <secure|community|all>   canonical, provider-agnostic
//   --secure                        convenience alias for `--tier secure`
// An explicit low-level `--cloud-type` (runpod) still wins at the call site;
// this only synthesizes a cloud-type from the higher-level tier word. A typo
// in `--tier` returns "" with a warn — never a hard fail (availability first).
fn _resolve_tier(av: [str], start: int) -> str {
    if _has_flag(av, start, "--secure") == 1 {
        return "SECURE"
    }
    let raw = _flag_val(av, start, "--tier", "")
    if len(raw) == 0 {
        return ""
    }
    let ct = _tier_to_cloud_type(raw)
    if len(ct) == 0 {
        println("[cloud] rent: ⚠ --tier '" + raw + "' not recognized (expected secure|community|all, or on-demand|interruptible) — ignoring (tier unset)")
    }
    return ct
}

// _copy_from_run — pick the download path: rsync resume (R3) when
// `--resume` was given, else the plain scp+verify path. Branching here
// (not at the call site) keeps a single network op — resume never first
// scp's the whole file and then rsyncs it.
fn _copy_from_run(host: str, ssh_opts: [str], remote_path: str, local_path: str, want_resume: int) -> CloudResult {
    if want_resume == 1 {
        return cloud_copy_from_resume_opts(host, ssh_opts, remote_path, local_path)
    }
    return cloud_copy_from_opts(host, ssh_opts, remote_path, local_path)
}

// _copy_to_run — pick the upload path: `scp -r` directory tree (P5) when
// `--recursive`/`-r` was given, else single-file scp.
fn _copy_to_run(host: str, ssh_opts: [str], local_path: str, remote_path: str, want_recursive: int) -> CloudResult {
    if want_recursive == 1 {
        return cloud_copy_to_recursive_opts(host, ssh_opts, local_path, remote_path)
    }
    return cloud_copy_to_opts(host, ssh_opts, local_path, remote_path)
}

// _print_fail_tail — on a non-zero remote exit, re-surface the last `n`
// lines of captured output under a clear banner (P10) so the failure is
// visible at the bottom of a long log. No-op on success or empty output.
fn _print_fail_tail(out: str, exit_code: int, n: int) {
    if exit_code == 0 {
        return
    }
    if len(out) == 0 {
        return
    }
    let lines = out.split("\n")
    let total = len(lines)
    let mut from = total - n
    if from < 0 {
        from = 0
    }
    println("[cloud] ── exit " + str(exit_code) + " · last " + str(total - from) + " line(s) ──")
    let mut i = from
    while i < total {
        println(lines[i])
        i = i + 1
    }
}

// ── provisioning verbs (rent / down / list) ───────────────────────────
// These WIRE the lifecycle fns already implemented in stdlib/cloud/vast.hexa
// and stdlib/cloud/runpod.hexa into the `hexa cloud` surface (RFC 088/091).
// The CLI layer only parses argv + reads credentials (`secret get …`,
// ~/.ssh/*.pub) and records the result in the pod registry; the provider
// modules own the actual search / create / wait / destroy / list logic.

// _cloud_rent_selftest — DRY-RUN unit test of the IDEMPOTENT-RENT dedup
// logic (no provider call, no billing). Snapshots the operator's live M5
// file aside, drives pod_registry_add + pod_registry_find_by_purpose in
// process, asserts the dedup contract, then restores the live file. Returns
// 0 on PASS, 1 on the first failed assertion.
//
//   1. empty registry           → find returns "" (FIRST rent provisions)
//   2. after a RENTING add       → find returns that id (SUBSEQUENT reuses)
//   3. a different purpose        → find returns "" (no false dedup)
//   4. a READY pod               → still reused (live status)
//   5. a STOPPING pod            → NOT reused (on its way out)
//   6. blank project/purpose      → find returns "" (dedup disabled)
fn _cloud_rent_selftest() -> int {
    // Hermetic over the ING.jsonl SSOT: redirect the registry's scan root +
    // cwd-fallback to a fresh temp dir via the `./.hexa-cloud-ing-sandbox`
    // sentinel (pre-creating the project repo dirs this selftest attributes to)
    // so NO real sibling repo's ING.jsonl is touched.
    let sbx = exec("mktemp -d /tmp/hexa-rent-selftest.XXXXXX 2>/dev/null").trim()
    let _ = exec("mkdir -p " + sbx + "/anima " + sbx + "/demiurge " + sbx + "/_cwd 2>/dev/null")
    write_file("./.hexa-cloud-ing-sandbox", sbx + "\n")
    let mut ok = 1

    // 1. empty registry → no reuse.
    let f1 = pod_registry_find_by_purpose("anima", "d768-recover")
    if f1 != "" {
        println("FAIL 1 empty-registry: expected \"\" got '" + f1 + "'")
        ok = 0
    } else {
        println("PASS 1 empty-registry → first rent provisions (find=\"\")")
    }

    // 2. RENTING add → subsequent same-key rent reuses.
    let _ = pod_registry_add("38977997", "runpod", "anima", "d768-recover", "", "", "RENTING")
    let f2 = pod_registry_find_by_purpose("anima", "d768-recover")
    if f2 != "38977997" {
        println("FAIL 2 same-key-reuse: expected '38977997' got '" + f2 + "'")
        ok = 0
    } else {
        println("PASS 2 same-key rent reuses pod 38977997 (no new rent)")
    }

    // 3. different purpose → no false dedup (a genuinely new purpose rents).
    let f3 = pod_registry_find_by_purpose("anima", "forge-util-fix")
    if f3 != "" {
        println("FAIL 3 diff-purpose: expected \"\" got '" + f3 + "'")
        ok = 0
    } else {
        println("PASS 3 different purpose → no false reuse (find=\"\")")
    }

    // 4. READY pod is reused (live).
    let _ = pod_registry_add("podREADY1", "runpod", "demiurge", "qforge", "1.2.3.4", "22001", "READY")
    let f4 = pod_registry_find_by_purpose("demiurge", "qforge")
    if f4 != "podREADY1" {
        println("FAIL 4 ready-reuse: expected 'podREADY1' got '" + f4 + "'")
        ok = 0
    } else {
        println("PASS 4 READY pod reused (live status)")
    }

    // 5. STOPPING pod is NOT reused (on its way out → a fresh rent is right).
    let _ = pod_registry_add("podGONE1", "runpod", "anima", "teardown-soon", "", "", "STOPPING")
    let f5 = pod_registry_find_by_purpose("anima", "teardown-soon")
    if f5 != "" {
        println("FAIL 5 stopping-skip: expected \"\" got '" + f5 + "'")
        ok = 0
    } else {
        println("PASS 5 STOPPING pod NOT reused (find=\"\")")
    }

    // 6. blank project/purpose → dedup disabled (unattributed first-rent path).
    let _ = pod_registry_add("podBLANK1", "runpod", "", "", "", "", "RENTING")
    let f6 = pod_registry_find_by_purpose("", "")
    if f6 != "" {
        println("FAIL 6 blank-key: expected \"\" got '" + f6 + "'")
        ok = 0
    } else {
        println("PASS 6 blank project/purpose → dedup disabled (find=\"\")")
    }

    // 7. IDEMPOTENCE: repeated same-key find returns the SAME id every time.
    let r1 = pod_registry_find_by_purpose("anima", "d768-recover")
    let r2 = pod_registry_find_by_purpose("anima", "d768-recover")
    let r3 = pod_registry_find_by_purpose("anima", "d768-recover")
    if r1 == "38977997" && r2 == "38977997" && r3 == "38977997" {
        println("PASS 7 repeated same-key rent → SAME pod 3/3 (38977997)")
    } else {
        println("FAIL 7 idempotence: got '" + r1 + "' '" + r2 + "' '" + r3 + "'")
        ok = 0
    }

    // tear down the sandbox (the operator's live ING.jsonl was never touched).
    let _ = exec("rm -f ./.hexa-cloud-ing-sandbox 2>/dev/null")
    let _ = exec("rm -rf " + sbx + " 2>/dev/null")

    if ok == 1 {
        println("rent_selftest PASS — idempotent-rent dedup verified (no provider call)")
        return 0
    }
    println("rent_selftest FAIL")
    return 1
}

// _cpu_ram_mb_suspect — 1 iff `query` constrains `cpu_ram` with a value that
// looks like MEGABYTES mistakenly passed where vast's query DSL expects
// GIGABYTES (ING #71). vast `cpu_ram` is GB (2TB box = `cpu_ram>=2000`), but
// the `cloud api /bundles` JSON reports cpu_ram in MB (2052096) — so a user
// who copies the MB number into `--query 'cpu_ram>=2000000'` asks for ~2M GB
// (impossible) and gets a SILENT 0-match. Heuristic: a cpu_ram value ≥ 100000
// (= 100 TB as GB) is almost certainly an MB value. Scans the first digit run
// after the `cpu_ram` token's operator.
fn _cpu_ram_mb_suspect(query: str) -> int {
    let at = query.index_of("cpu_ram")
    if at < 0 { return 0 }
    // Skip the field name + operator/space chars to the first digit.
    let mut i = at + 7
    let mut digits = ""
    let mut in_num = 0
    while i < len(query) {
        let c = query.substring(i, i + 1)
        if c >= "0" && c <= "9" {
            digits = digits + c
            in_num = 1
        } else if in_num == 1 {
            // first non-digit after the number ends the scan
            i = len(query)
        } else if c == "=" || c == ">" || c == "<" || c == " " {
            // still skipping the operator gap before the number
        } else {
            // a non-operator before any digit → not a numeric cpu_ram constraint
            return 0
        }
        i = i + 1
    }
    if len(digits) == 0 { return 0 }
    if _cli_atoi(digits) >= 100000 { return 1 }
    return 0
}

// _push_args_cli — collect every `--push <local:remote>` pair (repeatable),
// stopping at `--`. The bootstrap one-shot (ING #78) sequences these uploads.
fn _push_args_cli(av: [str], start: int) -> [str] {
    let mut out = []
    let mut i = start
    while i < len(av) {
        let t = av[i]
        if t == "--" { return out }
        else if t == "--push" {
            out.push(_need_val(av, i, "--push"))
            i = i + 2
        } else {
            i = i + 1
        }
    }
    return out
}

// _split_first_colon — split "local:remote" on the FIRST ':' into [local, remote].
// Local filesystem paths rarely contain ':'; a remote path never starts with one.
// Returns [whole, ""] when there is no ':'.
fn _split_first_colon(s: str) -> [str] {
    let mut i = 0
    while i < len(s) {
        if s.substring(i, i + 1) == ":" {
            return [s.substring(0, i), s.substring(i + 1, len(s))]
        }
        i = i + 1
    }
    return [s, ""]
}

// _remote_dirname — the parent directory of a remote path, i.e. everything
// before the last "/". "/root/anima/state/x.bin" → "/root/anima/state";
// "bins" (no slash) → "" (cwd-relative, no parent to create). Trailing slashes
// are trimmed first so ".../state/" → ".../state"'s parent ".../" collapses
// sanely. Used by copy-to to `mkdir -p` the destination parent (ING #75).
fn _remote_dirname(path: str) -> str {
    let mut p = path
    // trim trailing slashes (but keep a lone "/")
    while len(p) > 1 && p.substring(len(p) - 1, len(p)) == "/" {
        p = p.substring(0, len(p) - 1)
    }
    let mut last = -1
    let mut i = 0
    while i < len(p) {
        if p.substring(i, i + 1) == "/" { last = i }
        i = i + 1
    }
    if last < 0 { return "" }
    if last == 0 { return "/" }
    return p.substring(0, last)
}

// _cloud_rent_vast — vast.ai provision path: search-offers → create → wait
// ssh-ready → register. Prints host:port + instance id. Returns the exit
// code (0 ok, 1 failure). The created instance is registered with the
// owner tag BEFORE the ssh wait so a slow boot / crash never leaks an
// untracked billing instance.
fn _cloud_rent_vast(av: [str], start: int) -> int {
    let image = _flag_val(av, start, "--image", "ubuntu:22.04")
    let disk = _cli_atoi(_flag_val(av, start, "--disk", "30"))
    let owner = _flag_val(av, start, "--owner", "(hexa-cloud rent)")
    // Project attribution (down-guard source) — explicit --project, else cwd
    // git-repo basename, else cwd folder basename; @-prefixed (e.g. @demiurge).
    let project = _resolve_project(av, start)
    // Purpose / task description — --desc/--purpose, else legacy --owner, else
    // "unspecified". This is the (project,purpose) dedup key + the list surface.
    let purpose = _resolve_purpose(av, start)
    // Provider-side label slug (@L3) so a raw `vastai show instances` carries
    // the project-purpose attribution too (e.g. demiurge-r12-gold).
    let prov_label = _project_purpose_label(project, purpose)
    let raw_query = _flag_val(av, start, "--query", "")
    // --gpu FAMILY|VARIANT — was declared in help but NEVER read, so an empty
    // --query searched with NO gpu filter and rented an arbitrary GPU (a B200
    // for `--gpu H100`). Convert it to a vast predicate (exact `gpu_name=` for
    // a variant/unknown, `gpu_name in [...]` for a known family) and prepend
    // it so a caller --query token can still override (vastai last-wins).
    let gpu = _flag_val(av, start, "--gpu", "")
    let gpu_pred = vast_gpu_predicate(gpu)
    let mut query = raw_query
    if len(gpu_pred) > 0 {
        if len(raw_query) > 0 {
            query = gpu_pred + " " + raw_query
        } else {
            query = gpu_pred
        }
    }
    // CPU-pod note (ING #30-vast): vast's `search offers` returns GPU boxes by
    // default even with no num_gpus constraint — the CPU pool surfaces ONLY
    // with `num_gpus=0` (which vast_gpu_predicate now emits for `--gpu cpu`).
    // Before this, `--gpu cpu` searched `gpu_name=cpu` → 0 offers.
    let mut image_eff = image
    if gpu_pred == "num_gpus=0" {
        println("[cloud] rent vast: CPU-only pod (num_gpus=0; vast CPU pool, ~\$0.01/hr cores)")
        // (ING #34-(5)) sshd-bearing default image for the CPU pool: the vast
        // `--image` default is `ubuntu:22.04`, which has NO sshd → ssh-ready
        // loops until the bounded gate destroys the (healthy) pod. With no
        // explicit --image, swap a known sshd-less default to the official
        // sshd image; an explicit user image is honored (warn only).
        let v_image_set = _has_flag(av, start, "--image")
        image_eff = cloud_resolve_cpu_image(image, v_image_set, cloud_cpu_sshd_image())
        if v_image_set == 1 && _cloud_image_lacks_sshd(image) == 1 {
            println("[cloud] rent vast: ⚠ --image " + image + " has no sshd — ssh-ready will likely fail until the bounded gate destroys the pod. Pick a sshd-bearing image (e.g. " + cloud_cpu_sshd_image() + ") or set HEXA_CLOUD_CPU_IMAGE.")
        } else if image_eff != image {
            println("[cloud] rent vast: CPU default image → " + image_eff + " (sshd-bearing; bare " + image + " has no sshd → ssh-ready would never succeed). Override with --image or HEXA_CLOUD_CPU_IMAGE.")
        }
        // (ING #34-(4)) --docker-args is a runpod-only knob; vast's create
        // (`vastai create instance`) does not take it, so it is silently
        // dropped. Warn rather than let the user assume it applied.
        if _has_flag(av, start, "--docker-args") == 1 {
            println("[cloud] rent vast: ⚠ --docker-args is IGNORED on vast (no equivalent create flag) — the value is dropped. Bake it into the image / use --env-file instead.")
        }
    }
    // M1 — bounded SSH-readiness gate. Default 180s; 0/negative = legacy
    // unbounded (opt-in). Caps the rent so a ghost-RUNNING pod whose ssh
    // transport never comes up (exit 255 forever) can't bleed billing.
    let max_wait_sec = _cli_atoi(_flag_val(av, start, "--max-wait-sec", "300"))
    // M2/M3 — opt-in guard limits (stored in registry after READY).
    let ttl_sec = _ttl_to_sec(_flag_val(av, start, "--ttl", ""))
    let max_cost = _flag_val(av, start, "--max-cost-usd", "")
    let mut disk_gb = disk
    if disk_gb <= 0 {
        disk_gb = 30
    }
    // IDEMPOTENT RENT (rent-leak fix) — before provisioning a NEW billing
    // instance, check the M5 registry for a live pod with the SAME
    // (project, purpose=owner). If found, REUSE it (print its id + exit 0)
    // rather than leaking another orphan. `--force-new` opts out for the
    // rare case a genuinely fresh pod is wanted. Disabled when project or
    // owner is blank (no stable dedup key → legacy first-rent path).
    // `--force-new` is a MANUAL, explicit single-rent flag — a human may force
    // one fresh pod. It is NEVER auto-invoked. The automatic re-rent rotation
    // (the 2026-06-02 fire2→fire5 leak: a driver re-renting a fresh pod on every
    // pod-death) has been DEPRECATED — a fire that loses its pod NO LONGER
    // auto-rents; pod-loss FAILS LOUD and the user must `cloud rent` again.
    if _has_flag(av, start, "--force-new") == 0 {
        let existing = pod_registry_find_by_purpose(project, purpose)
        if len(existing) > 0 {
            println("[cloud] rent vast: reusing existing pod " + existing + " for " + project + "/" + purpose + " (M5 registry; pass --force-new to override)")
            println("instance_id=" + existing)
            println("owner=" + owner)
            return 0
        }
    }
    // --offer <id> — PIN a specific box (box-specific rent). vast offers
    // rotate every few minutes, so a `--query` that looked like the cheap
    // 1.5TB box can silently bind a $30/h box on the next call (2026-06-21
    // anima incident). Pinning the exact id confirms it is still listed +
    // captures its live dph BEFORE create, so the human commits to a known
    // box at a known rate. Empty → legacy query-search path (unchanged).
    let pin_offer = _flag_val(av, start, "--offer", "")
    // --max-dph <usd> — pre-rent rate ceiling (opt-in). REFUSES the rent if
    // the chosen offer's dollars-per-hour exceeds <usd>, on BOTH the pinned
    // and the query-search path — the direct guard against the rate surprise.
    let max_dph = _flag_val(av, start, "--max-dph", "")
    // CANONICAL TIER (ING #34) on vast: `vastai create instance` with NO `--bid`
    // is ALREADY an ON-DEMAND, NON-INTERRUPTIBLE rent — the host does not reclaim
    // it mid-run (the reclaim-loss the optA byte-eq run hit was a vast COMMUNITY/
    // interruptible pod). So `--tier secure` (alias `--secure`) is the DEFAULT
    // path here — we confirm it loudly so the operator never has to reach for a
    // raw provider flag. `--tier community`/`interruptible` (a cheap pre-emptible
    // bid via `vastai --bid`) is NOT wired through the canonical surface yet;
    // fail loud rather than silently renting a reclaimable pod. Default (no tier
    // flag) is UNCHANGED (on-demand, no bid).
    let v_tier_ct = _resolve_tier(av, start)
    if v_tier_ct == "SECURE" {
        println("[cloud] rent vast: tier=secure (on-demand, non-interruptible — vast create has no `--bid`, so the host does NOT reclaim it mid-run; this is the default vast path).")
    } else if v_tier_ct == "COMMUNITY" {
        println("[cloud] rent vast: ✗ --tier community/interruptible is NOT supported on vast via the canonical surface (interruptible-bid `vastai --bid` is unwired). vast's on-demand default (no flag, or `--tier secure`) is already non-reclaimable — re-run without the tier flag, or use runpod `--tier community`.")
        return 2
    }
    // --include-unverified — reach the cheap large-RAM / CPU-only boxes that the
    // default `verified=true` filter hides (ING #73). Appends `verified=false`,
    // which _vast_build_query now treats as a caller override (drops the default
    // verified=true). No-op on the --offer pin path (it searches the general
    // pool already). Skip if the caller already set verified in --query.
    if _has_flag(av, start, "--include-unverified") == 1 && query.index_of("verified") < 0 {
        if len(query) > 0 { query = query + " verified=false" }
        else { query = "verified=false" }
    }
    // --max-dph search injection (ING #72): push the ceiling into the SEARCH
    // predicate (`dph_total<=N`) so an over-budget box is never even picked —
    // not only refused post-pick. The post-pick vast_dph_exceeds guard below
    // stays as the authoritative belt-and-suspenders (catches a rotated rate).
    // Only inject on the query-search path (pin path is a single named box) and
    // only when the caller didn't already constrain dph_total.
    if len(max_dph) > 0 && len(pin_offer) == 0 && query.index_of("dph_total") < 0 {
        if len(query) > 0 { query = query + " dph_total<=" + max_dph }
        else { query = "dph_total<=" + max_dph }
    }
    // cpu_ram unit guard (ING #71): vast's query DSL `cpu_ram` is in GB
    // (2TB = cpu_ram>=2000); a value ≥100000 is almost certainly an MB number
    // copied from `cloud api /bundles` → an impossible filter → silent 0-match.
    if _cpu_ram_mb_suspect(query) == 1 {
        println("[cloud] rent vast: ⚠ --query cpu_ram looks like MEGABYTES — vast cpu_ram is in GB")
        println("                   (2TB RAM = `cpu_ram>=2000`, NOT 2000000). An MB value matches 0 offers.")
    }
    // verified_only=1 → vast.hexa applies the campaign-proven default
    // filters (reliability>=0.95 + verified + rentable). An explicit
    // --query opts into the caller's raw predicate string instead. A
    // non-empty --offer takes the box-specific pin path (vast_pick_offer).
    let offer = vast_pick_offer(pin_offer, query, 1)
    if offer.ok == 0 {
        println("[cloud] rent vast: " + offer.message)
        return 1
    }
    // Rate ceiling — refuse a box over --max-dph BEFORE the billing create.
    if vast_dph_exceeds(offer.dph, max_dph) == 1 {
        // Release the claim lock so a sibling rent can reuse the offer.
        vast_offer_release(offer.offer_id)
        println("[cloud] rent vast: REFUSED — offer " + offer.offer_id + " is $" + offer.dph + "/hr > --max-dph $" + max_dph + "/hr (no pod created)")
        return 1
    }
    println("[cloud] rent vast: picked offer " + offer.offer_id + " ($" + offer.dph + "/hr)")
    let inst = vast_create_labeled(offer.offer_id, image_eff, disk_gb, prov_label)
    if inst.ok == 0 {
        // create failed → return the offer claim so a sibling can reuse it.
        vast_offer_release(offer.offer_id)
        println("[cloud] rent vast: " + inst.message)
        return 1
    }
    // Register IMMEDIATELY (before the ssh wait) so a billing instance is
    // never untracked, then release the offer claim (the rent succeeded).
    pod_registry_record(inst.instance_id, owner, "running")
    // M5 — crash-safe registry @ ~/.hx/cloud/active-pods.json (RENTING
    // before ssh-ready; flipped to READY below once ssh handshakes).
    let _ = pod_registry_add(inst.instance_id, "vast", project, purpose, "", "", "RENTING")
    vast_offer_release(offer.offer_id)
    println("[cloud] rent vast: created instance " + inst.instance_id + " (owner=" + owner + ", registered)")
    // M1 — bounded SSH-readiness gate. Sleep cadence is 10s (vast boot is
    // not sub-10s anyway); tries = max(1, max_wait_sec / 10). 0 / negative
    // max_wait_sec restores legacy 30 × 20s = 600s.
    let sleep_each = 10
    let mut tries = 30
    let mut bounded = false
    if max_wait_sec > 0 {
        bounded = true
        tries = max_wait_sec / sleep_each
        if tries < 1 {
            tries = 1
        }
    } else {
        tries = 30
    }
    let mut wait_cadence = sleep_each
    if bounded == false {
        wait_cadence = 20
    }
    // Identity for the readiness probe: explicit --identity, else the
    // campaign-default vast key (HEXA_VAST_IDENTITY / ~/.ssh/id_vast_anima —
    // the SAME key auto-injected to ~/.ssh/config below). WITHOUT this the
    // probe ssh offers only the Mac default key, so a vast-registered
    // non-default key is never presented → `Permission denied (publickey)`
    // → the bounded gate declares a good pod "never ready" and DESTROYS it.
    let rent_identity = _flag_val(av, start, "--identity", _vast_default_identity())
    // GONE-aware readiness gate (Bug 1: created ≠ live). Cross-verifies the
    // instance's actual_status every tick so a host that never brought the
    // contract up (→ vast auto-removed it) is detected IMMEDIATELY and FAILS
    // LOUD + rolls back, instead of silently registering a GHOST and burning
    // the whole --max-wait-sec budget on an ssh endpoint that can't appear.
    let ready = vast_wait_ssh_status(inst.instance_id, tries, wait_cadence, rent_identity)
    if ready.gone == 1 {
        // LOUD FAIL — the host never brought the pod up. Roll the rent back:
        // best-effort destroy (idempotent — it may already be removed) + drop
        // the GHOST registry row so `cloud alive`/`pods` never reports a pod
        // that does not exist. No host:port is printed (there is none).
        let v = vast_destroy(inst.instance_id)
        let _ = pod_registry_forget(inst.instance_id)
        println("[cloud] rent vast: ✗ FAILED — instance " + inst.instance_id + " is GONE (" + ready.status + "): " + ready.message)
        println("[cloud] rent vast: the host failed to provision it (created ≠ live). Rolled back: registry row dropped" + _vast_rollback_destroy_note(v.ok, v.message))
        println("[cloud] rent vast: no charge should accrue for an instance that never ran; verify with `cloud api vast GET instances`. Re-run `cloud rent` (a different offer often provisions).")
        return 2
    }
    if ready.ok == 0 {
        if bounded {
            // Auto-teardown — the M1 contract. A billing pod whose ssh
            // never came up is a 100% loss; destroy it rather than leak.
            let v = vast_destroy(inst.instance_id)
            if v.ok == 1 {
                let _ = pod_registry_forget(inst.instance_id)
                println("[cloud] rent: SSH never ready within " + str(max_wait_sec) + "s, pod " + inst.instance_id + " destroyed")
                println("[cloud] rent: large-RAM (2TB) pods can take 5min+ to boot — retry with `--max-wait-sec 600` (ING #77)")
            } else {
                println("[cloud] rent: SSH never ready within " + str(max_wait_sec) + "s, pod " + inst.instance_id + " ALIVE — manual destroy required (vast_destroy: " + v.message + ")")
            }
            return 2
        }
        println("[cloud] rent vast: " + ready.message)
        println("[cloud] instance " + inst.instance_id + " is created + tracked; ssh not yet ready — re-check with: cloud list / cloud ssh-port " + inst.instance_id)
        return 1
    }
    let ssh_host = ready.host
    let ssh_port = ready.port
    println("[cloud] rent vast: READY " + ssh_host + ":" + ssh_port + " (root@" + ssh_host + " -p " + ssh_port + ")")
    let _ = pod_registry_add(inst.instance_id, "vast", project, purpose, ssh_host, ssh_port, "READY")
    // (ING #34-(1)) /workspace mount df-check: some images/regions bring
    // /workspace up on the container overlay instead of the requested disk,
    // so the capacity isn't there and writes silently land on ephemeral disk.
    // Overlay is the authoritative signal; the size floor uses --disk (the
    // vast instance-disk request). Only when --disk was sized (disk_gb > 0).
    if disk_gb > 0 {
        let v_ws = cloud_check_workspace_mount("root@" + ssh_host, vast_ssh_opts_id(ssh_port, rent_identity), disk_gb)
        if v_ws.exit_code == 1 || v_ws.exit_code == 2 {
            println("[cloud] rent vast: ⚠ /workspace MOUNT SUSPECT — " + v_ws.message)
            println("                   work under /workspace may be on EPHEMERAL overlay (not the " + str(disk_gb) + " GiB disk). Verify: cloud run root@" + ssh_host + " -p " + ssh_port + " -- df -h /workspace")
        }
    }
    // Always capture the vast offer's hourly rate (dph_total) into the registry
    // so `cloud list` can render the dph column even without a cost-cap flag.
    // "" when the offer JSON didn't carry dph (column shows "-").
    if len(offer.dph) > 0 {
        let _ = pod_registry_set_dph(inst.instance_id, offer.dph)
    }
    if ttl_sec >= 0 || len(max_cost) > 0 {
        // Capture the vast offer's hourly rate (dph_total) so the cost-cap can
        // accrue. "" when the offer JSON didn't carry dph (cost-cap inert, TTL ok).
        let _ = pod_registry_set_limits(inst.instance_id, ttl_sec, max_cost, offer.dph)
        println("[cloud] M2/M3 guard: ttl_sec=" + str(ttl_sec) + " max_cost_usd=" + max_cost + " rate=" + offer.dph + "/hr (enforced by `cloud watchdog`)")
    }
    // #1155 zero-flag: write the bare-IP Host block → ~/.ssh/config so a later
    // `cloud run root@<ip>` (or raw ssh) presents the vast key with no
    // --identity. No-op when no vast key is available (graceful).
    let _injected = vast_ssh_config_autoinject(inst.instance_id)
    if len(_injected) > 0 {
        println("[cloud] rent vast: ~/.ssh/config Host " + _injected + " → vast identity (auto · zero-flag ssh; #1155)")
    }
    // OWNERSHIP SPLIT — hexa cloud is POD-OPS-ONLY and WRITE-FORBIDDEN to the
    // attribution harness. It no longer fabricates the ./pods.json attribution
    // row (the old `_rent_register_pods_json` `--kind=rent` write); instead it
    // EMITS the raw pod facts on a `rent-result` line. The sidecar recorder
    // consumes that line + caller context and OWNS the {project·candidate·lane·
    // kind} attribution write (no-omission + fallback). `--no-register` is kept
    // as a contract-stable no-op so existing callers / hooks never break.
    if _has_flag(av, start, "--no-register") == 0 {
        _emit_rent_result(inst.instance_id, ssh_host, "vast", "READY", project, "")
    }
    println("instance_id=" + inst.instance_id)
    println("host=" + ssh_host)
    println("port=" + ssh_port)
    println("owner=" + owner)
    return 0
}

// _vast_rollback_destroy_note — diag tail for the GONE LOUD-FAIL message:
// names whether the rollback destroy confirmed (idempotent — the contract may
// already be gone) or needs a manual check. Pure formatting helper; takes the
// primitives (not the VastInstance struct) so it stays module-local.
fn _vast_rollback_destroy_note(destroy_ok: int, destroy_msg: str) -> str {
    if destroy_ok == 1 {
        return " + destroy confirmed."
    }
    return " (destroy: " + destroy_msg + " — likely already removed; confirm with `cloud api vast GET instances`)."
}

// _cloud_rent_runpod — runpod provision path: create (single GPU type) →
// wait ssh-ready → register. Auto-resolves the key via
// cloud_runpod_must_have_api_key (M7) and a public key at
// ~/.ssh/id_ed25519.pub (same contract as e2e_smoke.hexa). --gpu picks the
// GPU type (RunPod has no offer-search; the type IS the selector).
// Returns 0 ok / 1 failure.
fn _cloud_rent_runpod(av: [str], start: int) -> int {
    let api_key = cloud_runpod_must_have_api_key("rent")
    let pubkey = read_file(env_var("HOME") + "/.ssh/id_ed25519.pub").trim()
    if len(pubkey) == 0 {
        println("[cloud] rent runpod: no ~/.ssh/id_ed25519.pub")
        return 1
    }
    let gpu = _flag_val(av, start, "--gpu", "NVIDIA A100 80GB PCIe")
    let image = _flag_val(av, start, "--image", "runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04")
    let owner = _flag_val(av, start, "--owner", "(hexa-cloud rent)")
    // Project attribution (down-guard source) — explicit --project, else cwd
    // git-repo basename, else cwd folder basename; @-prefixed (e.g. @demiurge).
    let project = _resolve_project(av, start)
    // Purpose / task description — --desc/--purpose, else legacy --owner, else
    // "unspecified". (project,purpose) dedup key + the list surface.
    let purpose = _resolve_purpose(av, start)
    // Provider-side name slug (@L3) so `runpodctl get pod` carries attribution.
    let prov_label = _project_purpose_label(project, purpose)
    // M1 — bounded SSH-readiness gate (default 180s). The 2026-05-28
    // RunPod H100 SXM dump (pod RUNNING + ssh exit 255 forever) is the
    // motivating incident; without a cap a dead-ssh pod bleeds billing.
    let max_wait_sec = _cli_atoi(_flag_val(av, start, "--max-wait-sec", "300"))
    // M2/M3 — opt-in guard limits stored in the M5 registry after READY.
    // ttl: --ttl 30m/90s/3600 → deadman teardown. cost: --max-cost-usd 5.
    let ttl_sec = _ttl_to_sec(_flag_val(av, start, "--ttl", ""))
    let max_cost = _flag_val(av, start, "--max-cost-usd", "")
    // IDEMPOTENT RENT (rent-leak fix) — reuse a live (project, purpose) pod
    // from the M5 registry instead of provisioning another orphan. The
    // 2026-05-31 incident (38977997→38978180→38979746: 3 rents for one
    // purpose) is exactly this gap. `--force-new` overrides; a blank
    // project/owner disables dedup (legacy first-rent path).
    // `--force-new` is a MANUAL, explicit single-rent flag (never auto-invoked).
    // The automatic re-rent rotation has been DEPRECATED — a fire that loses its
    // pod NO LONGER auto-rents; pod-loss FAILS LOUD (the user must `cloud rent`).
    if _has_flag(av, start, "--force-new") == 0 {
        let existing = pod_registry_find_by_purpose(project, purpose)
        if len(existing) > 0 {
            println("[cloud] rent runpod: reusing existing pod " + existing + " for " + project + "/" + purpose + " (M5 registry; pass --force-new to override)")
            println("pod_id=" + existing)
            println("owner=" + owner)
            return 0
        }
    }
    // PERSISTENT-VOLUME DEFAULT (@L3): rent provisions a persistent
    // /workspace volume by default so a pod kill never wipes the run (the
    // live anima incident lost a full training run on ephemeral disk). The
    // size defaults to runpod_default_volume_gb (>= 40); `--volume-gb N`
    // overrides; `--ephemeral` opts OUT (with a loud warning).
    let mut volume_gb = runpod_default_volume_gb()
    let vg = _flag_val(av, start, "--volume-gb", "")
    if len(vg) > 0 {
        let v = _cli_atoi(vg)
        if v > 0 { volume_gb = v }
    }
    if _has_flag(av, start, "--ephemeral") == 1 {
        volume_gb = 0
    }
    if volume_gb <= 0 {
        println("[cloud] rent runpod: WARNING — EPHEMERAL container disk (no persistent volume). A pod kill / preemption WIPES all work under /workspace. Drop --ephemeral to get a persistent volume (the anima incident lost a full training run this way).")
    } else {
        println("[cloud] rent runpod: persistent /workspace volume " + str(volume_gb) + " GiB (pod-kill-survivable; --ephemeral to opt out)")
    }
    // CONTAINER-DISK (`--disk GiB`, ING #30): runpod previously ignored --disk
    // and hardcoded an 80 GiB container disk. Thread it through; <= 0 keeps the
    // 80 GiB default inside runpod_create_vol. (vast already wires --disk.)
    let mut disk_gb = 0
    let dv = _flag_val(av, start, "--disk", "")
    if len(dv) > 0 {
        let d = _cli_atoi(dv)
        if d > 0 { disk_gb = d }
    }
    if disk_gb > 0 {
        println("[cloud] rent runpod: container disk " + str(disk_gb) + " GiB (--disk)")
    }
    // CPU-POD path (ING #30): `--gpu cpu` (or none/empty) launches a CPU-only
    // pod via the REST v1 API (computeType:CPU) — runpodctl `pod create`
    // requires a GPU. `--vcpu N` sizes the vCPU count (default 4); `--cpu-flavor
    // cpu5c,cpu5g` overrides the flavor preference list. These flags are inert
    // on the GPU path.
    let mut pod = RunPodPod { ok: 0, pod_id: "", cost_per_hr: "", message: "" }
    if runpod_is_cpu_selector(gpu) == 1 {
        let vcpu = _cli_atoi(_flag_val(av, start, "--vcpu", "4"))
        let flavors = _flag_val(av, start, "--cpu-flavor", "")
        // (ING #34-(4)) --docker-args is INERT on the CPU path: the REST v1
        // CPU deploy body has no dockerArgs field (only the retired GPU
        // GraphQL mutation carried it), so a `--docker-args …` here is
        // SILENTLY dropped by the provider. Warn loudly rather than let the
        // user believe their container args took effect.
        if _has_flag(av, start, "--docker-args") == 1 {
            println("[cloud] rent runpod: ⚠ --docker-args is IGNORED on a CPU pod (REST v1 computeType=CPU has no dockerArgs field) — the value is dropped. Use the image's onstart / an env var (--env-file) instead.")
        }
        // (ING #34-(5)) sshd-bearing default image: a bare base (ubuntu:22.04
        // etc.) has no sshd, so ssh-ready loops until the bounded gate
        // DESTROYS the healthy-but-unreachable pod. With no explicit --image,
        // swap a known sshd-less default to the official sshd image; an
        // explicit user image is honored (warn only).
        let image_set = _has_flag(av, start, "--image")
        let cpu_image = cloud_resolve_cpu_image(image, image_set, cloud_cpu_sshd_image())
        if image_set == 1 && _cloud_image_lacks_sshd(image) == 1 {
            println("[cloud] rent runpod: ⚠ --image " + image + " has no sshd — ssh-ready will likely fail until the bounded gate destroys the pod. Pick a sshd-bearing image (e.g. " + cloud_cpu_sshd_image() + ") or set HEXA_CLOUD_CPU_IMAGE.")
        } else if cpu_image != image {
            println("[cloud] rent runpod: CPU default image → " + cpu_image + " (sshd-bearing; bare " + image + " has no sshd → ssh-ready would never succeed). Override with --image or HEXA_CLOUD_CPU_IMAGE.")
        }
        // CPU disk routing (ING #31, edge-proven): RunPod caps a CPU pod's
        // containerDiskInGb at 20, so a large `--disk` must size the PERSISTENT
        // volume, not the container disk. `--disk N` (explicit) is the disk the
        // user wants → it drives volumeInGb and takes precedence over the
        // default volume; without --disk, the default /workspace volume stands.
        // `_runpod_create_cpu_rest` caps containerDiskInGb ≤20 regardless.
        let mut cpu_vol = volume_gb
        if disk_gb > 0 { cpu_vol = disk_gb }
        println("[cloud] rent runpod: CPU pod (computeType=CPU, " + str(vcpu) + " vCPU, /workspace volume " + str(cpu_vol) + " GiB, container disk ≤20, cloudType=COMMUNITY) via REST v1 API")
        pod = runpod_create_cpu(api_key, cpu_image, pubkey, prov_label, cpu_vol, disk_gb, vcpu, flavors)
    } else {
        // --cloud-type SECURE|COMMUNITY|ALL — defaults to ALL (was an implicit
        // hardcoded SECURE that silently excluded the COMMUNITY datacenters
        // holding most RTX4090/A40 stock → "no longer any instances available"
        // even at high capacity). A typo warns and falls back to ALL.
        //
        // CANONICAL TIER (ING #34): `--tier secure|community` (alias `--secure`)
        // is the provider-agnostic surface — it REPLACES reaching for the raw
        // `runpodctl ... --secureCloud` flag (canonical-cli governance).
        // `--tier secure` rents the on-demand SECURE tier (no mid-run reclaim →
        // a build completes), which is exactly the reclaim-loss fix the optA
        // cuda byte-eq run needs. The low-level `--cloud-type` still WINS when
        // explicitly given (it is the fine-grained pin); `--tier` only supplies
        // the cloud-type when `--cloud-type` is absent. Default (neither flag) is
        // UNCHANGED — ALL.
        let tier_ct = _resolve_tier(av, start)
        let mut ct_raw = _flag_val(av, start, "--cloud-type", "ALL")
        if _has_flag(av, start, "--cloud-type") == 0 && len(tier_ct) > 0 {
            ct_raw = tier_ct
        }
        if runpod_cloud_type_valid(ct_raw) == 0 {
            println("[cloud] rent runpod: ⚠ --cloud-type '" + ct_raw + "' not recognized (expected SECURE|COMMUNITY|ALL) — defaulting to ALL")
        }
        let cloud_type = runpod_norm_cloud_type(ct_raw)
        println("[cloud] rent runpod: cloud-type " + cloud_type + " (SECURE+COMMUNITY search when ALL; --cloud-type / --tier to pin)")
        pod = runpod_create_vol_ct(api_key, gpu, image, pubkey, prov_label, volume_gb, disk_gb, cloud_type)
    }
    if pod.ok == 0 {
        println("[cloud] rent runpod: " + pod.message)
        return 1
    }
    pod_registry_record(pod.pod_id, owner, "running")
    // M5 — crash-safe registry @ ~/.hx/cloud/active-pods.json (RENTING
    // before ssh-ready; flipped to READY below once ssh handshakes).
    let _ = pod_registry_add(pod.pod_id, "runpod", project, purpose, "", "", "RENTING")
    println("[cloud] rent runpod: created pod " + pod.pod_id + " (owner=" + owner + ", registered)")
    // M1 — bounded path. sleep_each=10s; tries = max(1, max_wait_sec/10).
    // 0 / negative max_wait_sec restores legacy 40 × 15s = 600s unbounded.
    let sleep_each = 10
    let mut tries = 40
    let mut bounded = false
    let mut wait_cadence = 15
    if max_wait_sec > 0 {
        bounded = true
        tries = max_wait_sec / sleep_each
        if tries < 1 {
            tries = 1
        }
        wait_cadence = sleep_each
    }
    let port = runpod_wait_ssh(api_key, pod.pod_id, tries, wait_cadence)
    if port.ok == 0 {
        if bounded {
            // Auto-teardown — M1 contract. Idempotent: forget the registry
            // row only on a confirmed terminate; print ALIVE hint otherwise.
            let term_ok = runpod_terminate(api_key, pod.pod_id)
            if term_ok == 1 {
                let _ = pod_registry_forget(pod.pod_id)
                println("[cloud] rent: SSH never ready within " + str(max_wait_sec) + "s, pod " + pod.pod_id + " destroyed")
            } else {
                println("[cloud] rent: SSH never ready within " + str(max_wait_sec) + "s, pod " + pod.pod_id + " ALIVE — manual destroy required (runpod_terminate FAILED)")
            }
            return 2
        }
        println("[cloud] rent runpod: " + port.message)
        println("[cloud] pod " + pod.pod_id + " is created + tracked; ssh not yet ready — re-check with: cloud list")
        return 1
    }
    println("[cloud] rent runpod: READY " + port.ip + ":" + port.port + " (root@" + port.ip + " -p " + port.port + ")")
    let _ = pod_registry_add(pod.pod_id, "runpod", project, purpose, port.ip, port.port, "READY")
    // (ING #34-(1)) volume mount df-check: a requested /workspace volume can
    // SILENTLY land on the container overlay (community CPU + some regions),
    // so the requested capacity isn't there and a pod kill wipes the data.
    // Re-read `df /workspace` and LOUD-warn on overlay/undersize. Only when a
    // persistent volume was actually requested (volume_gb > 0).
    if volume_gb > 0 {
        let wsv = cloud_check_workspace_mount("root@" + port.ip, runpod_pod_opts(port.port), volume_gb)
        if wsv.exit_code == 1 || wsv.exit_code == 2 {
            println("[cloud] rent runpod: ⚠ /workspace VOLUME MOUNT SUSPECT — " + wsv.message)
            println("                     work written under /workspace may be on EPHEMERAL disk (pod kill wipes it) and the requested " + str(volume_gb) + " GiB may not be present. Verify: cloud run root@" + port.ip + " -p " + port.port + " -- df -h /workspace")
        }
    }
    // Always capture the RunPod hourly rate into the registry so `cloud list`
    // renders the dph column even without a cost-cap flag ("" → column "-").
    let mut dph_now = pod.cost_per_hr
    if len(dph_now) == 0 {
        dph_now = runpod_pod_cost_per_hr(api_key, pod.pod_id)
    }
    if len(dph_now) > 0 {
        let _ = pod_registry_set_dph(pod.pod_id, dph_now)
    }
    if ttl_sec >= 0 || len(max_cost) > 0 {
        // Capture the RunPod pod's hourly rate (`costPerHr`) so the M3 cost-cap
        // can accrue. Prefer the value the create response carried; if it was
        // absent (older runpodctl shapes) fall back to a `pod get` lookup. ""
        // when neither surfaces it (cost-cap inert, TTL still enforces).
        let mut rate = pod.cost_per_hr
        if len(rate) == 0 {
            rate = runpod_pod_cost_per_hr(api_key, pod.pod_id)
        }
        let _ = pod_registry_set_limits(pod.pod_id, ttl_sec, max_cost, rate)
        println("[cloud] M2/M3 guard: ttl_sec=" + str(ttl_sec) + " max_cost_usd=" + max_cost + " rate=" + rate + "/hr (enforced by `cloud watchdog`)")
    }
    // OWNERSHIP SPLIT — POD-OPS-ONLY. Emit raw `rent-result` facts instead of
    // fabricating the ./pods.json attribution row; the sidecar recorder OWNS
    // the attribution write (see _emit_rent_result). `--no-register` kept as a
    // contract-stable no-op.
    if _has_flag(av, start, "--no-register") == 0 {
        _emit_rent_result(pod.pod_id, port.ip, "runpod", "READY", project, "")
    }
    println("pod_id=" + pod.pod_id)
    println("host=" + port.ip)
    println("port=" + port.port)
    println("owner=" + owner)
    return 0
}

// _id_looks_vast — 1 iff `id` is all-digits with length 6-9 (vast.ai
// instance ids are short ints). Pure/CPU, no provider call. Used as the
// fallback when an id is untracked in the registry. An empty id, or any
// non-digit char, fails the test (→ treated as runpod).
fn _id_looks_vast(id: str) -> int {
    let n = len(id)
    if n < 6 || n > 9 {
        return 0
    }
    let mut i = 0
    while i < n {
        let cc = char_code(id.substring(i, i + 1))
        if cc < 48 || cc > 57 {
            return 0
        }
        i = i + 1
    }
    return 1
}

// _provider_for_id — the canonical provider resolver for id-taking
// lifecycle verbs (down/resolve/ssh-port). Source of truth = the M5 pod
// registry, which already stamps each pod's provider at rent time. When
// the id is untracked, fall back to an id-shape heuristic: all-digit,
// short (len 6-9) → "vast" (vast.ai instance ids); anything else →
// "runpod" (runpod ids are alphanumeric). Pure/CPU; the only read is the
// local registry JSONL (no live vastai/runpodctl call). This is what
// keeps a runpod id from mis-routing to `vastai destroy`.
fn _provider_for_id(id: str) -> str {
    let recorded = pod_registry_provider_of(id)
    if len(recorded) > 0 {
        return recorded
    }
    if _id_looks_vast(id) == 1 {
        return "vast"
    }
    return "runpod"
}

// _cloud_down — destroy a pod by id, then forget it from the registry.
// --provider picks the teardown path; when absent it is resolved from the
// registry via _provider_for_id (runpod needs an api key). The registry
// forget runs regardless of the provider verdict so a confirmed-gone pod
// never lingers as a GHOST row.
// _down_guard_refuses — cross-project kill-guard (the near-miss fix: anima's
// RTSC pods were almost destroyed from another project's session). Look up the
// target pod's stored `project`, derive the cwd project, and REFUSE the
// teardown when they MISMATCH and the pod is attributed to a REAL project
// (not ""/"unattributed"). `--force` bypasses; same-project or unattributed
// pods behave as before. NO env-var opt-out (sidecar s11). Returns 1 = refuse
// (caller exits non-zero), 0 = allow.
fn _down_guard_refuses(id: str, force: int, asserted: str) -> int {
    // @convergence state=in_flight id=CLOUD-CROSSPROJECT-FORCE value="--force is a CONFIRM-skip, NOT a cross-project license: a rent-session trap auto-passing --force (with a mis-parsed id) destroyed another project's pod (an anima session killed a runpod pod tagged to a different project). SEPARATELY: the cwd project was a WORKTREE basename, so sibling worktrees of ONE repo (e.g. anima's evaluate-py-option vs clm303-noverfit-retrain) mis-resolved as foreign projects and blocked legitimate same-repo teardown" threshold="cwd project = worktree-safe canonical repo (git-common-dir parent basename, @-prefixed) so all worktrees of one repo interoperate; --force still never bypasses a REAL cross-repo mismatch; the ONLY cross-project escape is an EXPLICIT --project <owner> that EXACTLY equals the pod's stored owner (immune to the mis-parsed-id incident, which supplied no correct owner string) — reaps a legacy pod tagged from a now-gone worktree"
    // --force NO LONGER bypasses the cross-project guard. It skips the [y/N]
    // confirm, but a REAL cross-project mismatch is refused REGARDLESS, so an
    // automated `--force` teardown (e.g. a rent-session trap that mis-parsed
    // the pod id) can never reach another project's pods. Same-project, orphan,
    // and unattributed pods are unaffected (fall through to return 0).
    let _ = force
    let records = pod_registry_load()
    let idx = _m5_find(records, id)
    if idx < 0 {
        // Untracked pod (orphan / never-registered) — no attribution to guard.
        return 0
    }
    // Normalize BOTH sides to the canonical `@`-prefixed tag before comparing.
    // Pods are STAMPED via _resolve_project (always `@`-prefixed, e.g. `@rtsc`),
    // but _cwd_project derives the BARE git basename (e.g. `rtsc`). Without this
    // normalization a same-project teardown string-compares `@rtsc` != `rtsc`
    // and the guard fires a FALSE cross-project refusal. _at_prefix is
    // idempotent, so a legacy bare-stored tag normalizes the same way.
    let owner = _at_prefix(records[idx].project)
    if len(owner) == 0 || owner == "@unattributed" {
        return 0
    }
    let cur = _at_prefix(_cwd_project())
    if owner == cur {
        return 0
    }
    // Explicit same-owner assertion escape: `--project <owner>` must EXACTLY
    // equal the pod's stored owner. This reaps a legacy pod tagged from a
    // now-gone worktree WITHOUT weakening the guard: the mis-parsed-id +
    // blanket --force incident supplied NO correct owner string, so requiring
    // the caller to name the exact owner is immune to it. Distinct from --force
    // (a confirm-skip, never a cross-project license).
    if len(asserted) > 0 && _at_prefix(asserted) == _at_prefix(owner) {
        println("[cloud] cross-project guard: --project '" + owner
            + "' matches pod " + id + " owner — teardown allowed (explicit assertion).")
        return 0
    }
    println("[cloud] REFUSE: pod " + id + " belongs to project '" + owner
        + "' (cwd='" + cur + "'). --force does NOT override — re-run from the owner repo, or assert `--project " + owner + "` if you own it.")
    return 1
}

// _down_has_running_job — 1 iff the cwd dispatch ledger (pods.json) carries a
// PENDING (= still-running) job pinned to this pod id. The running-job half of
// the @L9 pre-teardown surface: tearing down a pod with a live job loses it.
fn _down_has_running_job(id: str) -> int {
    let active = pods_local_active_pod_ids()
    let mut i = 0
    while i < len(active) {
        if active[i] == id {
            return 1
        }
        i = i + 1
    }
    return 0
}

// _down_attribution_surface — print the target pod's project · purpose + a
// running-job check BEFORE any teardown (@L9), so the operator sees WHAT they
// are about to destroy (the cross-project near-miss + the lost-job hazard).
// Read-only; never mutates. Returns 1 iff a running job is pinned to the pod
// (the caller raises the confirm bar). An untracked pod prints a "no
// attribution" line so the absence is explicit, not silent.
fn _down_attribution_surface(id: str) -> int {
    let records = pod_registry_load()
    let idx = _m5_find(records, id)
    if idx < 0 {
        println("[cloud] down: pod " + id + " — no registry attribution (untracked / orphan)")
    } else {
        let r = records[idx]
        let mut proj = r.project
        if len(proj) == 0 { proj = "⚠unattributed" }
        let mut purp = r.purpose
        if len(purp) == 0 { purp = "(no purpose recorded)" }
        println("[cloud] down: pod " + id + " — project '" + proj + "' · purpose \"" + purp + "\" · provider " + r.provider + " · status " + r.status)
    }
    let running = _down_has_running_job(id)
    if running == 1 {
        println("[cloud] down: ⚠ a PENDING (running) job is pinned to pod " + id + " in this repo's dispatch ledger — tearing it down LOSES that job.")
    } else {
        println("[cloud] down: no PENDING job pinned to pod " + id + " in this repo's dispatch ledger.")
    }
    return running
}

// _down_confirm_gate — the @L9 confirm gate for `down`/`destroy`. Prints the
// project·purpose + running-job surface, then prompts (default N) unless
// `force` (--force/--yes). When a running job is pinned, the prompt names it so
// a careless `y` is harder. Returns 1 = proceed, 0 = cancel.
fn _down_confirm_gate(id: str, provider: str, force: int) -> int {
    let running = _down_attribution_surface(id)
    if force == 1 {
        return 1
    }
    let mut q = "[cloud] down " + id + " (provider=" + provider + "): destroy this pod? [y/N]"
    if running == 1 {
        q = "[cloud] down " + id + " (provider=" + provider + ") — a RUNNING job is pinned: destroy anyway? [y/N]"
    }
    println(q)
    let ans = sys_stdin_read_line()
    if _rm_confirm_yes(ans) == 0 {
        // RECURRENCE GUARD (트러블슈팅 재발금지): an empty/EOF read means a
        // NON-INTERACTIVE stdin (agent / pipe / `hexa cloud run`). Silently
        // "cancelling" there leaves the pod ALIVE + billing while the caller
        // assumes the teardown went through (this bit a demiurge session: a flaky
        // pod survived `rm` without --force and kept billing until a --force rerun).
        // Make the non-interactive case LOUD + actionable so a pod-leak can't hide.
        if len(ans.trim()) == 0 {
            println("[cloud] down: NOT DESTROYED — non-interactive stdin gave no [y/N] answer.")
            println("[cloud]   pod " + id + " is STILL ALIVE + billing → re-run with --force (or --yes).")
        } else {
            println("[cloud] down: cancelled (no destroy issued)")
        }
        return 0
    }
    return 1
}

fn _cloud_down(id: str, provider: str) -> int {
    // M5 — flag the pod STOPPING before issuing teardown, so an
    // agent-crash between here and provider-confirm still leaves an
    // external reader (cloud reap) a hint to retry teardown.
    let _ = pod_registry_update_status(id, "STOPPING")
    let mut ok = 0
    if provider == "runpod" {
        let api_key = cloud_runpod_must_have_api_key("down")
        ok = runpod_terminate(api_key, id)
        if ok == 1 {
            println("[cloud] down runpod: terminated " + id)
        } else {
            println("[cloud] down runpod: terminate FAILED for " + id + " — verify manually")
        }
    } else {
        let v = vast_destroy(id)
        ok = v.ok
        println("[cloud] down vast: " + v.message)
    }
    // Forget the registry row (status=closed) on a confirmed destroy.
    if ok == 1 {
        let _ = pod_registry_forget(id)
        let _ = pod_registry_remove(id)
        println("[cloud] forgot " + id + " (registry status=closed)")
        return 0
    }
    return 1
}

// _cloud_reboot — reboot (restart container of) a pod by id, preserving
// disk. (INBOX #1963) A vast.ai instance can stay alive+billing yet stop
// accepting SSH after a host migration / sshd restart; rebooting restarts
// the container so the image onstart hook re-injects authorized_keys, and
// in-flight QE jobs resume from their .save recovery files. --provider
// picks the path; only vast is wired (vast_reboot) — runpod reboot is not
// yet implemented, so it reports clearly and exits 2 instead of guessing.
fn _cloud_reboot(id: str, provider: str) -> int {
    if provider == "runpod" {
        println("[cloud] reboot: runpod reboot not yet wired — use `cloud rm` + re-rent, or reboot via the runpod console")
        return 2
    }
    let v = vast_reboot(id)
    println("[cloud] reboot vast: " + v.message)
    if v.ok == 1 {
        return 0
    }
    return 1
}

// _rm_lookup_provider — registry-aware provider inference for `cloud rm`.
// Loads ~/.hx/cloud/active-pods.json (M5 SSOT) and returns the provider
// string ("vast" / "runpod" / ...) for the matching pod_id. Empty string
// signals "not in registry" — caller then requires an explicit --provider.
// Registry-load failures (perms / corrupt) degrade to "" so the caller
// surfaces the explicit-provider requirement instead of guessing.
fn _rm_lookup_provider(id: str) -> str {
    if len(id) == 0 {
        return ""
    }
    let records = pod_registry_load()
    let mut i = 0
    while i < len(records) {
        if records[i].id == id {
            return records[i].provider
        }
        i = i + 1
    }
    return ""
}

// _rm_pod_in_registry — 1 iff `id` is tracked in the M5 registry. Used to
// route the idempotent "not found" exit path (registry + provider absent →
// exit 0 with informational verdict).
fn _rm_pod_in_registry(id: str) -> int {
    if len(id) == 0 {
        return 0
    }
    let records = pod_registry_load()
    let mut i = 0
    while i < len(records) {
        if records[i].id == id {
            return 1
        }
        i = i + 1
    }
    return 0
}

// _rm_confirm_yes — 1 iff the answer reads as affirmative ("y" / "yes",
// case-insensitive). Anything else (including empty, "n", "no", garbage)
// rejects — the prompt defaults to N for safety.
fn _rm_confirm_yes(ans: str) -> int {
    let t = ans.trim()
    if len(t) == 0 {
        return 0
    }
    if t == "y" || t == "Y" || t == "yes" || t == "YES" || t == "Yes" {
        return 1
    }
    return 0
}

// _cloud_rm — M4 canonical teardown verb. Unifies the scattered
// down/destroy/forget surfaces behind a single confirm-gated entry:
//   1. infer provider from the M5 registry when --provider is absent
//   2. if the pod is absent from BOTH registry and the caller did not
//      pass --provider, idempotent-exit 0 ("not found")
//   3. otherwise prompt "destroy this pod? [y/N]" unless force == 1
//   4. on confirm: provider-terminate (runpod_terminate / vast_destroy),
//      then pod_registry_remove + pod_registry_forget — registry cleanup
//      runs even on provider failure so a confirmed-gone pod never lingers
//   5. exit 0 on destroyed, 1 on provider-rejected, 2 on cancel
fn _cloud_rm(id: str, provider_in: str, force: int, asserted: str) -> int {
    if len(id) == 0 {
        println("[cloud] rm: empty <id>")
        return 2
    }
    // (1) infer provider from registry when caller did not pass one
    let mut provider = provider_in
    let in_reg = _rm_pod_in_registry(id)
    if len(provider) == 0 {
        provider = _rm_lookup_provider(id)
    }
    // (2) idempotent: not in registry AND no explicit provider → exit 0
    if len(provider) == 0 && in_reg == 0 {
        println("[cloud] rm: " + id + " not found (provider + registry) — nothing to do")
        return 0
    }
    if len(provider) == 0 {
        // Tracked but provider field empty (corrupt row) — require explicit.
        println("[cloud] rm: " + id + " — provider unknown, pass --provider <vast|runpod>")
        return 2
    }
    // (2.5) cross-project kill-guard + attribution surface — rm is the M4
    // CANONICAL teardown ("unifies down/destroy/forget") yet historically
    // skipped the _down_guard_refuses + _down_attribution_surface that `down`
    // runs, leaving an UNGUARDED back-door: an auto-trap `rm --force` (with a
    // mis-parsed id) destroyed another project's pod. Mirror down's pre-
    // teardown safety here so rm is no longer the unguarded path.
    if _down_guard_refuses(id, force, asserted) == 1 {
        return 2
    }
    let _ = _down_attribution_surface(id)
    // (3) confirm gate (skipped on --force)
    if force == 0 {
        println("[cloud] rm " + id + " (provider=" + provider + "): destroy this pod? [y/N]")
        let ans = sys_stdin_read_line()
        if _rm_confirm_yes(ans) == 0 {
            println("[cloud] rm: cancelled (no destroy issued)")
            return 2
        }
    }
    // (4) flag STOPPING + provider teardown + registry cleanup
    let _ = pod_registry_update_status(id, "STOPPING")
    let mut ok = 0
    let mut why = ""
    // confirmed_alive — a DEFINITE "the provider still reports this pod live
    // after the delete" signal (ING #34-(2)). When set we MUST NOT scrub the
    // registry row: scrubbing would orphan a billing pod from tracking. An
    // ambiguous/failed delete (ok==0 without this flag) still scrubs, matching
    // the prior "confirmed-gone never lingers" semantics.
    let mut confirmed_alive = 0
    if provider == "runpod" {
        let api_key = cloud_runpod_must_have_api_key("rm")
        ok = runpod_terminate(api_key, id)
        if ok == 1 {
            // (ING #34-(2)) "delete returned" ≠ "pod gone": a runpodctl
            // `pod delete` can reply success/"not found" while the pod is
            // STILL ALIVE and billing (stale cache, races a migration, a
            // no-op podId). Cross-verify with a GraphQL pod-get: a live
            // object means the delete did NOT take → DON'T claim success
            // (and keep the registry row so the pod stays tracked).
            if runpod_pod_exists(api_key, id) == 1 {
                ok = 0
                confirmed_alive = 1
                why = "runpod terminate returned success but `pod get` STILL shows the pod LIVE — NOT deleted, BILLING CONTINUES. Retry `cloud rm " + id + "` or destroy via the RunPod console."
            } else {
                why = "runpod terminated (404-confirmed gone)"
            }
        } else {
            why = "runpod terminate rejected"
        }
    } else {
        let v = vast_destroy(id)
        ok = v.ok
        why = "vast: " + v.message
        // vast_destroy already cross-verifies via `show instance` — a
        // "LEAK SUSPECTED" verdict (ok==0 with a live status) is the same
        // confirmed-alive case: keep the registry row.
        if v.ok == 0 && v.message.index_of("LEAK SUSPECTED") >= 0 {
            confirmed_alive = 1
        }
    }
    // Registry cleanup runs on a confirmed-gone OR an ambiguous teardown — a
    // confirmed-gone pod never lingers as a GHOST row (mirrors _cloud_down).
    // The ONE exception: a confirmed-STILL-ALIVE pod keeps its row so the
    // billing pod stays tracked (ING #34-(2)), not orphaned out of the registry.
    if confirmed_alive == 1 {
        let _ = pod_registry_update_status(id, "RUNNING")
        println("[cloud] rm: " + id + " — KEPT in registry (still live · billing); status reset to RUNNING")
        println("[cloud] rm: " + id + " destroy FAILED — " + why)
        return 1
    }
    let _ = pod_registry_forget(id)
    let _ = pod_registry_remove(id)
    if ok == 1 {
        println("[cloud] rm: destroyed " + id + " (" + why + ")")
        return 0
    }
    println("[cloud] rm: " + id + " destroy FAILED — " + why)
    return 1
}

// _cloud_list_print — print live pods. With --provider it queries one
// provider; bare it queries BOTH (vast + runpod). Read-only ($-free for
// vast: `show instances`; runpod: `runpod_list_pods`). Returns 0 always
// (an empty / failed list is informational, not an error).
fn _cloud_list_print(provider: str) -> int {
    let do_vast = provider == "" || provider == "vast"
    let do_runpod = provider == "" || provider == "runpod"
    if do_vast {
        let vl = vast_list_instances()
        println("[cloud] vast: " + vl.message)
        let mut i = 0
        while i < len(vl.instance_ids) {
            println("  vast   " + vl.instance_ids[i])
            i = i + 1
        }
    }
    if do_runpod {
        let rl = runpod_list_pods()
        println("[cloud] runpod: " + rl.message)
        let mut j = 0
        while j < len(rl.pod_ids) {
            println("  runpod " + rl.pod_ids[j])
            j = j + 1
        }
    }
    // M5 registry view — the crash-safe SSOT (~/.hx/cloud/active-pods.json),
    // which (unlike the provider live-id lists above) carries the project +
    // purpose attribution used by the cross-project down-guard. Empty registry
    // → no section (no clutter).
    let reg = pod_registry_list()
    if len(reg) > 0 {
        println("[cloud] registry (project attribution):")
        println("  ID                       PROVIDER  PROJECT          PURPOSE               STATUS     DPH      AGE")
        let mut k = 0
        while k < len(reg) {
            let r = reg[k]
            let mut proj = r.project
            if len(proj) == 0 {
                proj = "⚠unattributed"
            }
            let mut purp = r.purpose
            if len(purp) == 0 {
                purp = "(legacy)"
            }
            let mut dph = r.cost_per_hr_usd
            if len(dph) == 0 {
                dph = "-"
            }
            println("  " + _reg_pad(r.id, 24) + " " + _reg_pad(r.provider, 9) + " "
                + _reg_pad(proj, 16) + " " + _reg_pad(purp, 21) + " "
                + _reg_pad(r.status, 10) + " " + _reg_pad(dph, 8) + " "
                + _cloud_age_str(r.created_at))
            k = k + 1
        }
    }
    return 0
}

// _cloud_age_str — human age of a pod from its created_at ISO ts (e.g. "3h12m",
// "45m", "8s"). "-" when the ts is absent / unparseable / in the future. The
// list-render + --json age column source.
fn _cloud_age_str(created_at: str) -> str {
    if len(created_at) == 0 {
        return "-"
    }
    let born = _reg_iso_to_sec(created_at)
    let now = _reg_now_sec()
    if born <= 0 || now <= 0 || now < born {
        return "-"
    }
    let secs = now - born
    if secs < 60 {
        return str(secs) + "s"
    }
    let mins = secs / 60
    if mins < 60 {
        return str(mins) + "m"
    }
    let hrs = mins / 60
    let rem_m = mins - hrs * 60
    return str(hrs) + "h" + str(rem_m) + "m"
}

// _cloud_list_json — `cloud list --json/--raw` machine output: the full M5
// registry as a JSON array, one object per pod carrying every attribution +
// guard field PLUS a derived `age` string. Mirrors the human table's columns
// (id·provider·project·purpose·status·dph·age) so a tool sees the same data.
fn _cloud_list_json() -> int {
    let reg = pod_registry_list()
    let mut out = "["
    let mut k = 0
    while k < len(reg) {
        let r = reg[k]
        if k > 0 {
            out = out + ","
        }
        out = out + "{"
            + "\"id\":\"" + _reg_jstr(r.id) + "\","
            + "\"provider\":\"" + _reg_jstr(r.provider) + "\","
            + "\"project\":\"" + _reg_jstr(r.project) + "\","
            + "\"purpose\":\"" + _reg_jstr(r.purpose) + "\","
            + "\"status\":\"" + _reg_jstr(r.status) + "\","
            + "\"dph\":\"" + _reg_jstr(r.cost_per_hr_usd) + "\","
            + "\"created_at\":\"" + _reg_jstr(r.created_at) + "\","
            + "\"age\":\"" + _reg_jstr(_cloud_age_str(r.created_at)) + "\""
            + "}"
        k = k + 1
    }
    out = out + "]"
    println(out)
    return 0
}

// _cloud_reap — M6 orphan finder + optional teardown. Enumerate the
// provider(s) live pod set + the M5 registry, then set-diff to find pods
// alive on the provider but absent from registry (billing leaks the M5
// SSOT can't see — an agent crashed mid-rent before registering).
//
// bare (apply=0) = dry-run table + summary line, exit 0.
// --apply (apply=1) = same enumeration + destroy each orphan via the
// existing _cloud_down path. Exit 0 on full success, 1 if any destroy
// failed. (`_cloud_down` already runs pod_registry_forget on the legacy
// JSONL + pod_registry_remove on the M5 SSOT through the rent wire.)
fn _cloud_reap(provider_scope: str, apply: int) -> int {
    let do_runpod = provider_scope == "" || provider_scope == "runpod"
    let do_vast = provider_scope == "" || provider_scope == "vast"
    // Registry ids — the canonical M5 active-pods.json (post-M5 SSOT).
    let reg = pod_registry_list()
    let mut reg_ids = []
    let mut ri = 0
    while ri < len(reg) {
        reg_ids.push(reg[ri].id)
        ri = ri + 1
    }
    // Provider id enumeration (per scope).
    let mut orphans = []
    if do_runpod {
        let rl = runpod_list_pods()
        if rl.ok == 0 {
            println("[cloud] reap: runpod list unavailable (" + rl.message + ") — skipping runpod scope")
        } else {
            let rp = pod_registry_orphans(rl.pod_ids, reg_ids, "runpod")
            let mut i = 0
            while i < len(rp) { orphans.push(rp[i]); i = i + 1 }
        }
    }
    if do_vast {
        let vl = vast_list_instances()
        if vl.ok == 0 {
            println("[cloud] reap: vast list unavailable (" + vl.message + ") — skipping vast scope")
        } else {
            let vp = pod_registry_orphans(vl.instance_ids, reg_ids, "vast")
            let mut j = 0
            while j < len(vp) { orphans.push(vp[j]); j = j + 1 }
        }
    }
    // ── M6 dead-owner / TTL-expired sweep ─────────────────────────────
    // The INVERSE leak axis (live anima incident, 2026-06-04): a registry-
    // TRACKED pod still ALIVE on the provider whose owning agent is DEAD
    // (kill -0 → gone, e.g. a rate-limit storm killed it) or whose heartbeat
    // has gone silent past its max-ttl. Build a merged provider-alive id set,
    // resolve each tracked pod's owner liveness (kill -0), classify (pure).
    // g63: every reap decision is against the AUTHORITATIVE provider-alive id
    // set + the recorded owner pid/heartbeat — never a fabricated state.
    let mut alive_ids = []
    if do_runpod {
        let rl2 = runpod_list_pods()
        if rl2.ok == 1 {
            let mut a = 0
            while a < len(rl2.pod_ids) { alive_ids.push(rl2.pod_ids[a]); a = a + 1 }
        }
    }
    if do_vast {
        let vl2 = vast_list_instances()
        if vl2.ok == 1 {
            let mut b = 0
            while b < len(vl2.instance_ids) { alive_ids.push(vl2.instance_ids[b]); b = b + 1 }
        }
    }
    let mut owner_alive = []
    let mut oi = 0
    while oi < len(reg) {
        owner_alive.push(pod_registry_owner_alive(reg[oi].owner_pid))
        oi = oi + 1
    }
    let dead = pod_registry_reap_dead_rows(reg, alive_ids, owner_alive, _reg_now_sec())

    // Table — even when empty so the verb's contract is uniform.
    if len(orphans) == 0 && len(dead) == 0 {
        println("[cloud] reap: 0 orphans · 0 dead-owner/TTL-expired · registry covers every alive pod")
        return 0
    }
    println("ID                       PROVIDER  CLASS         ACTION")
    let mut k = 0
    while k < len(orphans) {
        let o = orphans[k]
        let mut act = "(dry-run)"
        if apply == 1 { act = "DESTROY" }
        println(_reg_pad(o.id, 24) + " " + _reg_pad(o.provider, 9) + " "
            + _reg_pad("orphan", 13) + " " + act)
        k = k + 1
    }
    let mut dk = 0
    while dk < len(dead) {
        let d = dead[dk]
        let mut dact = "(dry-run)"
        if apply == 1 { dact = "DESTROY" }
        println(_reg_pad(d.id, 24) + " " + _reg_pad(d.provider, 9) + " "
            + _reg_pad(d.reason, 13) + " " + dact)
        dk = dk + 1
    }
    if apply == 0 {
        println("[cloud] reap: " + str(len(orphans)) + " orphans · " + str(len(dead))
            + " dead-owner/TTL-expired · DRY-RUN (use --yes / --apply to terminate)")
        return 0
    }
    // execute: route every orphan AND dead-owner pod through _cloud_down
    // (idempotent teardown + registry forget/remove). g63: only the pods
    // positively classified above — never a foreign/unattributed pod.
    let mut failed = 0
    let total = len(orphans) + len(dead)
    let mut m = 0
    while m < len(orphans) {
        let o = orphans[m]
        let rc = _cloud_down(o.id, o.provider)
        if rc != 0 {
            failed = failed + 1
            println("[cloud] reap: FAILED to destroy " + o.id + " (" + o.provider + ")")
        }
        m = m + 1
    }
    let mut dm = 0
    while dm < len(dead) {
        let d = dead[dm]
        let rc = _cloud_down(d.id, d.provider)
        if rc != 0 {
            failed = failed + 1
            println("[cloud] reap: FAILED to destroy " + d.id + " (" + d.provider + ", " + d.reason + ")")
        }
        dm = dm + 1
    }
    println("[cloud] reap: " + str(total - failed) + "/" + str(total)
        + " terminated · " + str(failed) + " failed")
    if failed > 0 {
        return 1
    }
    return 0
}

// _idle_reap_probe_busy — tri-value liveness for an idle-reap candidate id:
// 1 = reachable+compute-proc-present (busy) · 0 = reachable+no-compute-proc
// (idle) · -1 = unreachable / probe-undetermined. Resolves the bare provider id
// to its live ssh endpoint (proxy-first, per #2318/#2342) then reuses the
// watchdog's canonical compute-proc probe (_wd_has_compute_proc). No live
// endpoint / unreachable host → -1, which idle_reap_classify fails safe on.
fn _idle_reap_probe_busy(id: str) -> int {
    let rh = _resolve_cloud_host(id)
    // strip a leading user@ (the watchdog probe re-adds root@ itself).
    let mut host = rh.host
    let at = host.index_of("@")
    if at >= 0 { host = host.substring(at + 1, len(host)) }
    if len(host) == 0 { return -1 }
    return _wd_has_compute_proc(host, rh.port)
}

// _idle_reap_reachable — 1 iff the candidate id resolves to a live ssh endpoint
// (proxy or direct, OR a real dotted host). 0 = no live endpoint mapped → the
// pod is gone/stale (billing-but-down), which idle_reap_classify reclaims.
fn _idle_reap_reachable(id: str) -> int {
    let rh = _resolve_cloud_host(id)
    if rh.resolved == 1 { return 1 }
    if rh.host.contains(".") { return 1 }
    return 0
}

// _cloud_idle_reap — complement of `reap`: provider pods that ARE billing but
// are NOT in the active set AND are verified idle/dead. The active set is the
// UNION of ./pods.json PENDING-job pod ids AND every instance_id recorded in the
// campaign's deck `.dft_detach.state` files (LIVE endpoint truth — job.pod
// drifts stale on re-fires). Each not-active billing pod is classified by
// liveness (idle_reap_classify):
//   REAP              — unreachable OR reachable+no-compute-proc → safe destroy.
//   BUSY-UNMANIFESTED — reachable+compute-proc-present → live duplicate, WARN.
// REPORT-only by default (apply=0, exit 0); --reap (apply=1) destroys ONLY the
// REAP class. BUSY-UNMANIFESTED is NEVER auto-reaped; an undetermined probe
// fails safe to BUSY-UNMANIFESTED (no reap on uncertainty).
fn _cloud_idle_reap(provider_scope: str, apply: int) -> int {
    let do_runpod = provider_scope == "" || provider_scope == "runpod"
    let do_vast = provider_scope == "" || provider_scope == "vast"
    // active = PENDING-job pod ids ∪ deck-state instance_ids (live endpoint truth).
    let active = pods_local_merge_ids(pods_local_active_pod_ids(), pods_local_state_active_ids())
    // (provider-id, provider-name) pairs for billing pods, per scope.
    let mut bill_ids = []
    let mut bill_prov = []
    if do_runpod {
        let rl = runpod_list_pods()
        if rl.ok == 0 {
            println("[cloud] idle-reap: runpod list unavailable (" + rl.message + ") — skipping runpod scope")
        } else {
            let mut i = 0
            while i < len(rl.pod_ids) { bill_ids.push(rl.pod_ids[i]); bill_prov.push("runpod"); i = i + 1 }
        }
    }
    if do_vast {
        let vl = vast_list_instances()
        if vl.ok == 0 {
            println("[cloud] idle-reap: vast list unavailable (" + vl.message + ") — skipping vast scope")
        } else {
            let mut j = 0
            while j < len(vl.instance_ids) { bill_ids.push(vl.instance_ids[j]); bill_prov.push("vast"); j = j + 1 }
        }
    }
    // not-active billing pods (the set-diff candidates), then classify each by liveness.
    let cand = pods_local_idle_orphans(bill_ids, active)
    if len(cand) == 0 {
        println("[cloud] idle-reap: 0 candidates · every billing pod is active (PENDING job or live deck-state instance)")
        return 0
    }
    println("ID                       PROVIDER  CLASS              ACTION")
    let mut reaped = 0
    let mut failed = 0
    let mut busy_n = 0
    let mut k = 0
    while k < len(cand) {
        let id = cand[k]
        let prov = _idle_prov_of(id, bill_ids, bill_prov)
        let reach = _idle_reap_reachable(id)
        // only probe the proc state when reachable (an unreachable pod is dead → REAP).
        let mut busy = -1
        if reach == 1 { busy = _idle_reap_probe_busy(id) }
        // handoff d1410e5b: consult the live PROVIDER STATUS so a pod the
        // provider reports exited/stopped/gone is reaped even when its ssh probe
        // is ambiguous (the inst 38711598 actual_status=exited + ssh-refused case
        // that was stranded BUSY-UNMANIFESTED forever). UNKNOWN/MISSING-CRED/
        // RUNNING fall back to the ssh-only discipline (no behaviour change).
        let pstatus = alive_probe_status(id, prov)
        let klass = idle_reap_classify_status(reach, busy, pstatus)
        if klass == "BUSY_UNMANIFESTED" {
            busy_n = busy_n + 1
            println(_reg_pad(id, 24) + " " + _reg_pad(prov, 9) + " BUSY-UNMANIFESTED  WARN (live dup — consolidate, never reap)")
        } else {
            if apply == 0 {
                println(_reg_pad(id, 24) + " " + _reg_pad(prov, 9) + " REAP               (report — use --reap to destroy)")
            } else {
                let rc = _cloud_down(id, prov)
                let act = if rc == 0 { reaped = reaped + 1; "DESTROYED" } else { failed = failed + 1; "FAILED" }
                println(_reg_pad(id, 24) + " " + _reg_pad(prov, 9) + " REAP               " + act)
            }
        }
        k = k + 1
    }
    let reap_n = len(cand) - busy_n
    if busy_n > 0 {
        println("[cloud] idle-reap: ⚠ " + str(busy_n) + " BUSY-UNMANIFESTED (reachable+busy, NOT reaped) — live duplicate(s) needing consolidation")
    }
    if apply == 0 {
        println("[cloud] idle-reap: " + str(reap_n) + " REAP-eligible · read-only report · use --reap to destroy (BUSY-UNMANIFESTED excluded)")
        return 0
    }
    println("[cloud] idle-reap: " + str(reaped) + "/" + str(reap_n)
        + " reaped · " + str(failed) + " failed · " + str(busy_n) + " BUSY-UNMANIFESTED spared")
    if failed > 0 { return 1 }
    return 0
}

// _idle_prov_of — provider label for an id from the parallel (id, provider)
// billing arrays; default "vast" if unmatched (the _cloud_down fallback path).
fn _idle_prov_of(id: str, bill_ids, bill_prov) -> str {
    let mut b = 0
    while b < len(bill_ids) {
        if bill_ids[b] == id { return bill_prov[b] }
        b = b + 1
    }
    return "vast"
}

// _provider_ssh_port_lookup — the PROVIDER-API ssh endpoint lookup that
// `ssh-port`/`resolve` runs, factored out so the run/copy-to RESOLVER can reuse
// the EXACT same path (Bug-cloud-resolver: a pod registered while still RENTING
// has no host/port in the registry, so the resolver used to hand the bare
// pod-id straight to ssh → "Could not resolve hostname <pod-id>"). Returns a
// ResolvedHost so a registry miss can fall back to the live provider state the
// same way `ssh-port` already does. resolved=0 (host=id) when the provider has
// not mapped port 22 yet (still RENTING) or the CLI/key is unavailable. via is
// "provider" so the run/poll banner names the resolution source. The dest is
// `root@<ip>` (pods are root), matching _registry_resolved_host + the proxy/
// direct branches. KEEP the runpod/vast arms byte-identical to the printing
// _cloud_ssh_port below — they MUST resolve the same endpoint.
fn _provider_ssh_port_lookup(id: str, provider: str) -> ResolvedHost {
    if provider == "runpod" {
        // handoff 676f7db5: use the OPTIONAL key resolver (cloud_runpod_api_key,
        // "" when unset) — NOT must_have, which exit(2)s. The runpod arm is
        // reached for ANY non-vast, non-dotted, non-pool, registry-miss name,
        // including a plain ~/.ssh/config Host alias (default provider="runpod").
        // With no runpod key, hard-exiting would REGRESS that keyless alias path
        // (run/copy-to to an ssh-config Host would die instead of falling through
        // to the legacy alias passthrough). So: key UNSET → return via="" (guard
        // does NOT fire) so the alias still resolves keyless; key SET → behavior is
        // unchanged (live-resolve the pod-id → root@ip:port, or via="unresolved" +
        // loud-fail when the provider has no live endpoint for a real pod-id).
        let api_key = cloud_runpod_api_key()
        if len(api_key) == 0 {
            // KEY UNSET: leave the name untouched (via="" → the guard does NOT
            // fire) so a plain ~/.ssh/config Host alias still resolves keyless via
            // the legacy alias passthrough. Returning via="unresolved" here would
            // loud-fail an ssh-config alias too — the regression the optional-key
            // guard exists to prevent.
            return ResolvedHost { host: id, port: "", resolved: 0, via: "" }
        }
        let r = runpod_get_ssh_port(api_key, id)
        if r.ok == 1 {
            return ResolvedHost { host: "root@" + r.ip, port: r.port, resolved: 1, via: "provider" }
        }
        // KEY SET but the provider has no live ssh endpoint (still RENTING / id
        // unknown): via="unresolved" so the run/copy-to call site can fail LOUD
        // instead of ssh-ing the bare pod-id (it is NOT a real ssh dest).
        return ResolvedHost { host: id, port: "", resolved: 0, via: "unresolved" }
    }
    let v = vast_ssh_endpoint(id)
    if v.ok == 1 {
        return ResolvedHost { host: "root@" + v.host, port: v.port, resolved: 1, via: "provider" }
    }
    return ResolvedHost { host: id, port: "", resolved: 0, via: "unresolved" }
}

// _cloud_ssh_port — print the live ssh endpoint (host + port) of an
// existing pod by id (P4). Wires runpod_get_ssh_port / vast_ssh_endpoint via
// the shared _provider_ssh_port_lookup (the run/copy-to resolver reuses the
// same fn). --provider default vast; runpod auto-resolves the key via
// cloud_runpod_must_have_api_key (M7: env-passthrough → Keychain →
// ~/.runpod/config.toml). Returns 0 when the endpoint is mapped, else 1.
fn _cloud_ssh_port(id: str, provider: str) -> int {
    if provider == "runpod" {
        let api_key = cloud_runpod_must_have_api_key("ssh-port")
        let r = runpod_get_ssh_port(api_key, id)
        if r.ok == 1 {
            println("[cloud] ssh-port runpod: " + r.ip + ":" + r.port + " (root@" + r.ip + " -p " + r.port + ")")
            println("host=" + r.ip)
            println("port=" + r.port)
            return 0
        }
        println("[cloud] ssh-port runpod: " + r.message)
        return 1
    }
    let v = vast_ssh_endpoint(id)
    if v.ok == 1 {
        println("[cloud] ssh-port vast: " + v.host + ":" + v.port + " (root@" + v.host + " -p " + v.port + ")")
        println("host=" + v.host)
        println("port=" + v.port)
        return 0
    }
    println("[cloud] ssh-port vast: " + v.message)
    return 1
}

// _cloud_ssh_port_json — handoff fb0ae653: the `--json` variant of
// _cloud_ssh_port. Emits exactly ONE stable machine-readable line —
// {"host":"<ip>","port":"<port>"} — on success (rc 0) so a parser (the
// hf-recover-guard) gets a contract instead of scraping the human `host=`/
// `port=` lines and silently degrading if that text drifts. On miss it emits
// {"host":null,"port":null} and returns 1, mirroring _cloud_ssh_port's exit
// codes EXACTLY. host/port are JSON-escaped via _mh_json_str (the same escaper
// the nohup marker uses). The human format is untouched — this is additive.
fn _cloud_ssh_port_json(id: str, provider: str) -> int {
    if provider == "runpod" {
        let api_key = cloud_runpod_must_have_api_key("ssh-port")
        let r = runpod_get_ssh_port(api_key, id)
        if r.ok == 1 {
            println("{\"host\":" + _mh_json_str(r.ip) + ",\"port\":" + _mh_json_str(r.port) + "}")
            return 0
        }
        println("{\"host\":null,\"port\":null}")
        return 1
    }
    let v = vast_ssh_endpoint(id)
    if v.ok == 1 {
        println("{\"host\":" + _mh_json_str(v.host) + ",\"port\":" + _mh_json_str(v.port) + "}")
        return 0
    }
    println("{\"host\":null,\"port\":null}")
    return 1
}

// _cloud_watch — poll a remote pid every `interval` s until it dies (the
// auto-loop substitute for repeatedly calling `poll`, P3). Returns 0 when
// the pid is gone, 124 if `max_wait` s elapse first. `max_wait <= 0` waits
// unboundedly (the default "babysit until the job finishes" mode).
fn _cloud_watch(host: str, ssh_opts: [str], pid: int, interval: int, max_wait: int) -> int {
    let mut step = interval
    if step <= 0 {
        step = 30
    }
    let mut elapsed = 0
    while max_wait <= 0 || elapsed < max_wait {
        let alive = cloud_poll_opts(host, ssh_opts, pid)
        if alive == 0 {
            println("[cloud] watch: pid " + str(pid) + " DEAD after ~" + str(elapsed) + "s")
            return 0
        }
        let _ = exec("sleep " + str(step))
        elapsed = elapsed + step
    }
    println("[cloud] watch: pid " + str(pid) + " still ALIVE after max-wait " + str(max_wait) + "s (exit 124)")
    return 124
}

// _cloud_early_life_check — after a detached nohup launch, sleep `sec` s
// then poll the remote pid ONCE. Returns 0 if the process is still alive
// (it cleared the early-death window), else 3 — the silent class-1 failure
// mode where a launcher execs and dies immediately (bad script path, bad
// argv) while the pod keeps billing. A distinct nonzero return lets the
// caller tear the pod down at once instead of waiting out a watchdog
// timeout on a job that never started (the 158-min idle-burn anima fire).
fn _cloud_early_life_check(host: str, ssh_opts: [str], pid: int, sec: int) -> int {
    if sec <= 0 {
        return 0
    }
    let _ = exec("sleep " + str(sec))
    let alive = cloud_poll_opts(host, ssh_opts, pid)
    if alive == 1 {
        println("[cloud] early-life check OK — pid " + str(pid) + " alive after " + str(sec) + "s")
        return 0
    }
    println("[cloud] early-life check FAILED — pid " + str(pid) + " DIED within " + str(sec) + "s (silent class-1 launch failure; tear the pod down)")
    return 3
}

// Default `cloud tail` terminal mode (INBOX gap 1, 2026-05-28): when
// --until is ABSENT the tail handler routes to cloud_tail_cmd_taxonomy_opts,
// the 3-tier failure-first classifier — DONE (exit 0) / TIMEOUT-RESUMABLE
// (exit 3) / CRASHED (exit 4) — instead of the old "first marker match ==
// exit 0" that mis-read a walltime-timed-out QE job (which prints `Maximum
// CPU time exceeded` then a deceptive `JOB DONE` then `STOP 1`) as SUCCESS.
// The pattern TABLES live in stdlib/cloud/cloud.hexa (g20). An operator who
// wants the old single-block behaviour passes an explicit `--until <ere>`;
// `--until ''` still follows forever.

// _watchdog_budget_guard — Q4 budget cross-ref. Reads the per-project
// ./pods.json budget.cap (USD), compares it against the M5 registry's total
// accrued spend, and on a breach alerts + (when kill==1) tears down the
// LOWEST-VALUE running pod (cheapest accrued — claw spend back under cap with
// the least sunk loss; g64 honor-cap). No budget.cap declared → no-op.
// Returns 1 iff a breach was detected (whether or not a kill fired), else 0.
fn _watchdog_budget_guard(api_key: str, kill: int) -> int {
    let cap_usd = pods_local_budget_cap_usd()
    if len(cap_usd) == 0 {
        return 0
    }
    let cap_c = pod_registry_usd_to_cents(cap_usd)
    if cap_c <= 0 {
        return 0
    }
    let spent_c = pod_registry_total_accrued_cents()
    let cap_d = cap_c / 100
    let spent_d = spent_c / 100
    if spent_c < cap_c {
        println("[cloud] watchdog budget: $" + str(spent_d) + " accrued / $" + cap_usd + " cap — under budget")
        return 0
    }
    println("[cloud] ⚠ watchdog budget BREACH: $" + str(spent_d) + " accrued ≥ $" + cap_usd + " cap (./ING.jsonl)")
    let victim = pod_registry_lowest_value_id()
    if len(victim) == 0 {
        println("[cloud] watchdog budget: no running pod to sacrifice")
        return 1
    }
    let provider = pod_registry_provider_of(victim)
    if kill == 0 {
        println("[cloud] watchdog budget: DRY-RUN — would kill lowest-value pod " + victim + " (" + provider + "); pass --kill to enforce")
        return 1
    }
    println("[cloud] watchdog budget: killing lowest-value pod " + victim + " (" + provider + ") to honor cap")
    let _ = _cloud_down(victim, provider)
    return 1
}

fn main() {
    let av = args()
    let mut si = -1
    let mut sub = ""
    let mut i = 0
    while i < len(av) {
        let t = av[i]
        if si < 0 {
            if t == "rent" || t == "up" || t == "rm" || t == "down" || t == "destroy" || t == "reboot" || t == "list" || t == "status" || t == "preflight" || t == "watchdog" || t == "run" || t == "exec" || t == "nohup" || t == "fire" || t == "fire-shards" || t == "poll" || t == "tail" || t == "watch" || t == "ssh-port" || t == "resolve" || t == "alive" || t == "probe" || t == "copy-to" || t == "copy-from" || t == "bootstrap" || t == "orphans" || t == "reconcile" || t == "reap" || t == "idle-reap" || t == "adopt" || t == "attribute" || t == "forget" || t == "api" || t == "provider-cli" || t == "dft-run" || t == "dft-fanout" || t == "parallel-audit" || t == "pods" || t == "dispatch" || t == "providers" || t == "help" || t == "--help" || t == "-h" || t == "version" || t == "--version" || t == "-v" {
                si = i
                sub = t
            }
        }
        i = i + 1
    }
    if si < 0 {
        _cloud_help()
        return
    }
    if sub == "help" || sub == "--help" || sub == "-h" {
        _cloud_help()
        return
    }
    if sub == "version" || sub == "--version" || sub == "-v" {
        println("hexa cloud 0.6.0 — AUTOMATIC re-rent DEPRECATED: the re-rent rotation-cap machinery (the bounded auto-re-rent backstop, its env overrides, its rerent ledger, and the re-arm escape) is REMOVED — a fire that loses its pod NO LONGER auto-rents a fresh one; pod-loss now FAILS LOUD and the user must `cloud rent` again explicitly. `--force-new` survives ONLY as a MANUAL single-rent flag, never auto-invoked (2026-06-02 fire2→fire5 orphan-leak fix). #2671 orphan-cleanup safety net (reap-guard · heartbeat-TTL · reconcile · persistent /workspace volume default) is UNCHANGED · [0.5.1: `rent` IDEMPOTENT per (project,purpose) — a repeated same-key rent REUSES the live M5 pod (--force-new overrides) · `rent` auto-registers a ./pods.json row (--no-register opts out) · `watchdog` COMPOSITE idle classifier + ./pods.json budget.cap cross-ref · 0.4.1: rent --max-wait-sec bounded SSH gate · 0.4.0: nohup/fire --register · 0.3.x: resolve/ssh-config/identity/registry-guard/dft-run]")
        return
    }
    if sub == "rent" || sub == "up" {
        // SELFTEST (must be FIRST, before any provider dispatch) — exercises
        // the IDEMPOTENT-RENT dedup logic against an in-process M5 registry
        // (snapshot/restore the operator's live file). NO provider call, NO
        // billing instance. `cloud rent --selftest`.
        if _has_flag(av, si + 1, "--selftest") == 1 {
            exit(_cloud_rent_selftest())
        }
        // Provision a GPU pod. The first post-verb token is the provider
        // (vast|runpod); flags follow. Wires vast.hexa / runpod.hexa
        // lifecycle fns + pod_registry. $-INCURRING — the only verb that
        // creates a billing instance.
        //
        // FOOTGUN GUARD (must be FIRST, before any offer-pick / instance
        // create): `cloud rent vast --help` previously fell through and
        // RENTED a real pod because -h/--help was just an unparsed trailing
        // token. Print usage and exit 0 — creating NOTHING.
        if _has_flag(av, si + 1, "--help") == 1 || _has_flag(av, si + 1, "-h") == 1 {
            println("usage: cloud rent <vast|runpod> [--gpu FAMILY|N|cpu] [--image IMG] [--disk GiB] [--vcpu N] [--cpu-flavor IDS] [--tier secure|community] [--secure] [--cloud-type SECURE|COMMUNITY|ALL] [--owner TAG] [--query Q] [--offer ID] [--max-dph USD] [--max-wait-sec N] [--no-register] [--force-new]")
            println("  --tier secure|community (CANONICAL · alias --secure=`--tier secure`) — provider-agnostic tier select, the sanctioned surface that REPLACES raw `runpodctl --secureCloud`. secure = on-demand (host does NOT reclaim mid-run → a build completes; the reclaim-loss fix). runpod: maps to --cloud-type SECURE/COMMUNITY (explicit --cloud-type still wins). vast: secure = the on-demand default (no `--bid` → non-interruptible); community/interruptible is NOT wired (fails loud). Default (no tier flag) is UNCHANGED.")
            println("  --cloud-type (runpod) SECURE|COMMUNITY|ALL — low-level pin; default ALL (searches BOTH clouds; was an implicit SECURE-only that excluded the COMMUNITY datacenters holding most RTX4090/A40 stock → 'no longer any instances available' even at high capacity). Pin SECURE/COMMUNITY only when required, or use the canonical --tier.")
            println("  --gpu cpu    launch a CPU-only pod. runpod: REST v1 computeType=CPU (runpodctl can't) — --vcpu N (default 4) + --cpu-flavor cpu5c,cpu5g. vast: searches the CPU pool (num_gpus=0; vast's search returns GPU boxes by default — `--gpu cpu` used to find 0). --disk GiB now sizes the runpod container disk too (vast already wired it).")
            println("  --offer ID   (vast) PIN a specific offer id — skips the query search and binds THAT box, confirming it is still listed + capturing its dph before create (offers rotate; --query can silently bind a different box). --max-dph USD refuses any offer over USD/hr BEFORE billing.")
            println("  CPU pods default to a sshd-bearing image (a bare ubuntu:22.04 has NO sshd → ssh-ready would loop until the gate destroys the pod). Override with --image or HEXA_CLOUD_CPU_IMAGE; --docker-args is IGNORED on CPU pods (warns).")
            println("  POST-RENT GUARDS: warns if /workspace mounted on the container overlay instead of the requested volume (silent data loss); `cloud rm` cross-checks the provider after delete and KEEPS a still-live pod tracked (billing leak guard).")
            println("  IDEMPOTENT per (project,owner): a repeated same-key rent REUSES the live M5 pod; --force-new is a MANUAL flag to provision one fresh pod (never auto-invoked). Automatic re-rent on pod-loss is DEPRECATED — pod-loss FAILS LOUD; rent again explicitly. `cloud rent --selftest` checks the dedup offline.")
            return
        }
        if si + 1 >= len(av) {
            println("[cloud] rent: missing <provider> — usage: cloud rent <vast|runpod> [--gpu FAMILY|N] [--image IMG] [--disk GiB] [--owner TAG] [--query Q] [--offer ID] [--max-dph USD] [--max-wait-sec N]")
            exit(2)
        }
        let provider = av[si + 1]
        if provider == "vast" {
            exit(_cloud_rent_vast(av, si + 2))
        }
        if provider == "runpod" {
            exit(_cloud_rent_runpod(av, si + 2))
        }
        println("[cloud] rent: unknown provider '" + provider + "' — expected vast or runpod")
        exit(2)
    }
    if sub == "rm" {
        // M4 canonical teardown — unifies down/destroy/forget behind a
        // confirm-gated entry. --provider inferred from the M5 registry
        // when absent; --force skips the confirm prompt. Idempotent: rm
        // of an absent pod exits 0. Exit 0 destroyed · 1 provider-rejected
        // · 2 cancel / usage.
        if si + 1 >= len(av) {
            println("[cloud] rm: missing <id> — usage: cloud rm <id> [--provider vast|runpod] [--force]")
            exit(2)
        }
        let id = av[si + 1]
        let provider = _flag_val(av, si + 2, "--provider", "")
        let force = _has_flag(av, si + 2, "--force")
        let asserted = _flag_val(av, si + 2, "--project", "")
        exit(_cloud_rm(id, provider, force, asserted))
    }
    if sub == "down" || sub == "destroy" {
        // (legacy alias of `cloud rm` — kept for back-compat with deployed
        // automation; new callers should prefer `cloud rm`.) Destroy a pod
        // by id + forget it from the registry. --provider selects the
        // teardown path (default vast). Wires vast_destroy /
        // runpod_terminate + pod_registry_forget.
        if si + 1 >= len(av) {
            println("[cloud] down: missing <id> — usage: cloud down <id> [--provider vast|runpod] [--yes|--force]")
            exit(2)
        }
        let id = av[si + 1]
        // No explicit --provider → resolve from the registry (runpod ids
        // must NOT default to the vast destroy path). Explicit flag overrides.
        let mut provider = _flag_val(av, si + 2, "--provider", "")
        if len(provider) == 0 {
            provider = _provider_for_id(id)
        }
        // Cross-project kill-guard — refuse a teardown of a pod owned by a
        // different project (--force does NOT override a cross-project kill;
        // re-run from the owner repo). (The anima RTSC near-miss fix.)
        let mut force = _has_flag(av, si + 2, "--force")
        if _has_flag(av, si + 2, "--yes") == 1 {
            force = 1
        }
        let asserted = _flag_val(av, si + 2, "--project", "")
        if _down_guard_refuses(id, force, asserted) == 1 {
            exit(3)
        }
        // @L9 — surface project·purpose + running-job check, then require
        // confirmation (default N) unless --force/--yes. Code only; this is the
        // pre-destroy attribution gate (the wrong-pod / lost-job safety add).
        if _down_confirm_gate(id, provider, force) == 0 {
            exit(2)
        }
        exit(_cloud_down(id, provider))
    }
    if sub == "reboot" {
        // (INBOX #1963) Restart a pod's container (preserving disk) to
        // recover a dark pod — one that is alive+billing but no longer
        // accepting SSH (host migration / sshd restart dropped its
        // authorized_keys). The reboot re-runs the image onstart hook that
        // re-injects the key; in-flight QE jobs resume from .save recovery
        // files. --provider selects the path (default vast; runpod not yet
        // wired). Exit 0 reboot-confirmed · 1 provider-rejected · 2 usage.
        if si + 1 >= len(av) {
            println("[cloud] reboot: missing <id> — usage: cloud reboot <id> [--provider vast|runpod]")
            exit(2)
        }
        let id = av[si + 1]
        let provider = _flag_val(av, si + 2, "--provider", "vast")
        exit(_cloud_reboot(id, provider))
    }
    if sub == "list" || sub == "status" {
        // List live pods (read-only, $-free). Bare → both providers;
        // --provider <p> narrows. Wires vast_list_instances /
        // runpod_list_pods. `--json`/`--raw` emit the M5 registry as a JSON
        // array (machine output; carries project·purpose·dph·age·status).
        let provider = _flag_val(av, si + 1, "--provider", "")
        if _has_flag(av, si + 1, "--json") == 1 || _has_flag(av, si + 1, "--raw") == 1 {
            exit(_cloud_list_json())
        }
        exit(_cloud_list_print(provider))
    }
    if sub == "preflight" {
        // Closed-form GPU memory budget check. No ssh / pod-spinup / LLM —
        // pure arithmetic on the workload spec (preflight.hexa). The post-
        // verb argv (av[si+1..]) is forwarded to preflight_run, which parses
        // --params / --gpu / --optimizer / ... and exits 0 (fits) / 1
        // (invalid args / help) / 2 (budget exceeds cap).
        let rc = preflight_run(av, si + 1)
        exit(rc)
    }
    if sub == "watchdog" {
        // Idle-pod autokill sweep (1 cycle). DRY-RUN by default — only an
        // explicit `--kill` / `--no-dry-run` (post-verb, needs RUNPOD_API_KEY)
        // actually terminates. The post-verb argv (av[si+1..]) is forwarded
        // to watchdog_run, which parses --threshold-min / --util-cap-pct /
        // --kill and exits 0 (clean sweep) / 1 (invalid args / help) / 2
        // (sweep failed: no runpodctl / no pods / list error).
        //
        // M2/M3 — registry limit sweep runs FIRST: tear down pods that opted
        // into `--ttl` (deadman) or `--max-cost-usd` (cost cap) and breached.
        // DRY-RUN unless `--kill`; only --kill resolves the runpod key (so a
        // dry-run with no runpod pods needs no creds). Opt-in invariant: pods
        // with no limit set are never touched.
        let m23_kill = _has_flag(av, si + 1, "--kill")
        // SOFT runpod key (M7 secret-get path, non-exiting): "" when absent
        // so a vast-only sweep doesn't die on a missing runpod key.
        let m23_key = exec("secret get runpod.api_key 2>/dev/null").trim()
        if m23_kill == 1 {
            let n = pod_registry_limit_sweep(m23_key, 0)
            if n > 0 {
                println("[cloud] watchdog: " + str(n) + " pod(s) torn down by M2/M3 limit (ttl/cost)")
            }
        } else {
            let _ = pod_registry_limit_sweep("", 1)
        }
        // Q3 — COMPOSITE idle sweep over the M5 registry (the RTSC leak-guard):
        // idle = uptime≥thr AND util≤cap AND no-compute-proc AND no-workdir.
        // A slow-but-working pod (compute proc present) is NEVER killed. Honors
        // the same --threshold-min / --util-cap-pct flags; DRY-RUN unless --kill.
        let wd_thr = _cli_atoi(_flag_val(av, si + 1, "--threshold-min", "60"))
        let wd_cap = _cli_atoi(_flag_val(av, si + 1, "--util-cap-pct", "5"))
        let mut wd_thr_eff = wd_thr
        if wd_thr_eff < 5 { wd_thr_eff = 60 }
        let wd_dry = 1 - m23_kill
        let _ic = composite_watchdog_sweep(m23_key, wd_thr_eff, wd_cap, wd_dry)
        // Q4 — budget cross-ref: if ./pods.json declares budget.cap and current
        // accrued spend breaches it, alert + (on --kill) tear down the lowest-
        // value running pod (g64 honor-cap — sacrifice the cheapest first).
        let _bg = _watchdog_budget_guard(m23_key, m23_kill)
        // Legacy runpod util sweep (kept for the runpodctl-only path / back-compat).
        let rc = watchdog_run(av, si + 1)
        exit(rc)
    }
    if sub == "parallel-audit" {
        // d_parallel_fire 위반 가드 (T2). pod 의 live state 를 flag 로 받아
        // single-pod-sequential-queue 위반(1 live job + queued decks + spare
        // cores)을 순수 감사하고, VIOLATION → exit 1 + split 제안 · OK → exit 0.
        // 네트워크/pod 접근 없음 — 호출자가 physcores/live/ranks/queued 를 전달.
        let rc = parallel_audit_run(av, si + 1)
        exit(rc)
    }
    if sub == "dft-run" {
        // Guarded DFT el-ph pod dispatch (QE pw.x/ph.x). PREVIEW by default
        // ($0: validate deck + plan + parse a local relax.out); --go rents a
        // billing pod and runs the rent/transport/chain/monitor-guarded chain.
        // Encodes the demiurge RTSC checklist (dft_dispatch.hexa, INBOX #1249).
        let rc = dft_run(av, si + 1)
        exit(rc)
    }
    if sub == "dft-fanout" {
        // §4b SEPARATE-PODS-PER-CANDIDATE executor (PR #2125 follow-up, handoff
        // 22486f26): fan N candidate decks onto N pods, exactly one deck per pod
        // (project.tape d_parallel_fire 1순위 + d17). PREVIEW roll-call by default
        // ($0); --go rents one pod per READY deck and dispatches each chain.
        let rc = dft_fanout(av, si + 1)
        exit(rc)
    }
    if sub == "pods" {
        // ACTIVE reconcile FIRST (anima ghost-drift fix, plan @L2): before
        // rendering anything, reconcile the global M5 registry against the
        // AUTHORITATIVE runpod myself.pods GraphQL (+ vast) — prune ghost rows
        // (in registry, absent from the provider's own ledger) and surface
        // real orphans. `--no-reconcile` opts out (offline / no-key hosts).
        let mut do_reconcile = 1
        let mut show_all = 0
        let mut pi = si + 1
        while pi < len(av) {
            if av[pi] == "--no-reconcile" { do_reconcile = 0 }
            if av[pi] == "--all" { show_all = 1 }
            pi = pi + 1
        }
        if do_reconcile == 1 {
            let _ = cloud_pods_reconcile_prune()
        }
        // Per-project active pod/job work manifest at cwd's ./pods.json — but
        // LIVENESS is the PROVIDER's, not the manifest's (anima phantom-pod
        // fix). The manifest used to render every job as `running` even after
        // the provider reclaimed its pod (8× edge-vllm-serve, edge-genall,
        // rent-vast GONE rows shown alive). We now resolve the AUTHORITATIVE
        // provider-alive set (the SAME runpod myself.pods + vast path that
        // probe/reap/idle-reap trust) and LEFT-JOIN it onto the manifest:
        // provider-confirmed-GONE phantoms are dropped (--all to list them),
        // real pods show their true provider state. When BOTH providers are
        // unreachable (ok=0) we DON'T hide rows — liveness is UNKNOWN, not
        // dead (g63: never invent GONE from a blind probe).
        let pa = cloud_provider_alive_ids()
        if pa.ok == 0 {
            println("[cloud] pods: provider liveness UNREACHABLE (" + pa.message
                + ") — showing tracked jobs UNVERIFIED (not confirmed alive)")
        } else if pa.runpod_ok == 0 {
            println("[cloud] pods: runpod degraded (" + pa.message
                + ") — its pods shown UNKNOWN (not GONE); vast authoritative")
        } else if pa.vast_ok == 0 {
            println("[cloud] pods: vast degraded (" + pa.message
                + ") — its pods shown UNKNOWN (not GONE); runpod authoritative")
        }
        // Per-provider authority — a degraded provider must not GONE its own
        // pods (the merged-ok bug: vast-only ok=1 marked live runpod pods GONE).
        exit(pods_local_print_table_live(false, pa.runpod_ok, pa.vast_ok, pa.ids, show_all))
    }
    if sub == "dispatch" {
        // Manage the per-project ./pods.json manifest:
        //   bare      → full table (same as `cloud pods`)
        //   tree      → pod-grouped ASCII (orphans at tail)
        //   active    → verdict=PENDING jobs only
        //   add       → add/overwrite a job entry (auto-stubs pod entry)
        //   verdict   → rewrite verdict + verdict_utc (preserve other fields)
        //   rm        → delete a job (then pod, refused if pod has pinned jobs)
        // update-form: each add rewrites the full job entry; verdict touches
        // only the verdict fields; rm deletes. Atomic write + .bak rotation.
        exit(pods_local_dispatch(av, si + 1))
    }
    if sub == "providers" {
        // Read-only compute-provider resource catalog (CLOUD M8/M9) at
        // ~/.hx/cloud/providers.json (decision reference for `cloud rent` —
        // which provider, what cost, what walltime speedup). Subverbs:
        //   bare/list → all tiers · fit → best-fit (fit_score=3) · recommend
        //   → current campaign recommendation. Hand-curated catalog, no write
        //   verb (seed from a PROVIDERS.json). Distinct from `pods`/`dispatch`
        //   (runtime work state) and `orphans`/`reconcile` (billing registry).
        exit(providers_catalog_dispatch(av, si + 1))
    }
    if sub == "run" {
        if si + 1 >= len(av) {
            println("[cloud] run: missing <host> — usage: cloud run <host> [--port N] [--insecure] -- <argv...>")
            exit(2)
        }
        let _id = _checked_host(av[si + 1])
        let _rh = _resolve_cloud_host(_id)
        _guard_resolved_or_die("run", _id, _rh)
        let host = _rh.host
        if _rh.resolved == 1 {
            println("[cloud] run: resolved pod-id → " + host + " :" + _rh.port + " (" + _rh.via + ")")
        }
        let base_opts = _ssh_opts_cli(av, si + 2)
        let ssh_opts = _apply_resolved_port(base_opts, _rh)
        let max_wall = _max_wall_cli(av, si + 2)
        let env_kvs = _env_args_cli(av, si + 2)
        // gap-2 (cmd-mangle): `--script <file>` delivers an arbitrary command
        // body over STDIN to a remote `bash -s` — no argv-length limit, no
        // multiline / `&` corruption (the bytes arrive identical). When set,
        // it takes precedence over the positional `-- <argv>` path.
        let script_path = _flag_val(av, si + 2, "--script", "")
        if len(script_path) > 0 {
            let body = read_file(script_path)
            if len(body) == 0 {
                println("[cloud] run: --script " + script_path + " is empty or unreadable")
                exit(2)
            }
            let rs = cloud_run_script_opts(host, ssh_opts, body)
            if len(rs.stdout_) > 0 {
                println(rs.stdout_)
            }
            println("[cloud] " + rs.message)
            _print_fail_tail(rs.stdout_, rs.exit_code, 30)
            exit(rs.exit_code)
        }
        let mut argv = _collect_after(av, si + 2)
        if len(argv) == 0 {
            println("[cloud] run: empty argv — usage: cloud run <host> [--port N] [--insecure] [--max-wall S] [--env K=V] [--source P] [--script F] [--raw-argv] -- <argv...>")
            exit(2)
        }
        argv = _with_env(env_kvs, argv)
        argv = _with_source(_source_args_cli(av, si + 2), argv)
        // gap-2 (cmd-mangle): by DEFAULT the positional `-- <cmd>` body is
        // reassembled and run as `bash -lc <body>` so multiline / `&` /
        // redirection survive a login shell. `--raw-argv` opts back into the
        // strict structured-argv path (no shell, L145-class corruption
        // impossible) for pure program dispatch. --env/--source already wrap
        // in `bash -c`, so they keep the structured path.
        let mut r = CloudResult { ok: 0, exit_code: -1, pid: 0, stdout_: "", message: "", logfile: "" }
        if _has_flag(av, si + 2, "--raw-argv") == 1 || len(env_kvs) > 0 || len(_source_args_cli(av, si + 2)) > 0 {
            r = cloud_run_wall_opts(host, ssh_opts, argv, max_wall)
        } else {
            r = cloud_run_bashlc_opts(host, ssh_opts, argv)
        }
        // Fix-cloud-1: proxy→direct single retry on a TRANSPORT OUTAGE (255).
        let _fb = _proxy_fallback_direct(_id, _rh, base_opts, r.exit_code)
        if _fb.retry == 1 {
            println("[cloud] run: proxy unreachable (transport 255) → retrying once via direct " + _fb.host)
            if _has_flag(av, si + 2, "--raw-argv") == 1 || len(env_kvs) > 0 || len(_source_args_cli(av, si + 2)) > 0 {
                r = cloud_run_wall_opts(_fb.host, _fb.ssh_opts, argv, max_wall)
            } else {
                r = cloud_run_bashlc_opts(_fb.host, _fb.ssh_opts, argv)
            }
        }
        // NOTE (#1229 B): `run` does NOT register the host. The registry holds
        // provider pod-ids (for reconcile vs the provider live set), and `host`
        // is an ssh destination (`root@<ip>`), not a pod-id — recording it
        // poisoned the table with phantom GHOST rows. The pod is tracked at
        // `rent`/`adopt` time by its real id; `run` is a host operation.
        if len(r.stdout_) > 0 {
            println(r.stdout_)
        }
        println("[cloud] " + r.message)
        _print_fail_tail(r.stdout_, r.exit_code, 30)
        exit(r.exit_code)
    }
    if sub == "exec" {
        if si + 1 >= len(av) {
            println("[cloud] exec: missing <host> — usage: cloud exec <host> [--port N] [--insecure] -- <shell-cmd>")
            exit(2)
        }
        let _id = _checked_host(av[si + 1])
        let _rh = _resolve_cloud_host(_id)
        _guard_resolved_or_die("exec", _id, _rh)
        let host = _rh.host
        if _rh.resolved == 1 {
            println("[cloud] exec: resolved vast id → " + host + " :" + _rh.port + " (" + _rh.via + ")")
        }
        let base_opts = _ssh_opts_cli(av, si + 2)
        let ssh_opts = _apply_resolved_port(base_opts, _rh)
        let tokens = _collect_after(av, si + 2)
        if len(tokens) == 0 {
            println("[cloud] exec: empty shell-cmd — usage: cloud exec <host> [--port N] [--insecure] -- <shell-cmd>")
            exit(2)
        }
        let mut cmd_str = ""
        let mut ei = 0
        while ei < len(tokens) {
            if ei > 0 {
                cmd_str = cmd_str + " "
            }
            cmd_str = cmd_str + tokens[ei]
            ei = ei + 1
        }
        let mut r = cloud_exec_opts(host, ssh_opts, cmd_str)
        // Fix-cloud-1: proxy→direct single retry on a TRANSPORT OUTAGE (255).
        let _fb = _proxy_fallback_direct(_id, _rh, base_opts, r.exit_code)
        if _fb.retry == 1 {
            println("[cloud] exec: proxy unreachable (transport 255) → retrying once via direct " + _fb.host)
            r = cloud_exec_opts(_fb.host, _fb.ssh_opts, cmd_str)
        }
        if len(r.stdout_) > 0 {
            println(r.stdout_)
        }
        println("[cloud] " + r.message)
        _print_fail_tail(r.stdout_, r.exit_code, 30)
        exit(r.exit_code)
    }
    if sub == "nohup" {
        if si + 2 >= len(av) {
            println("[cloud] nohup: usage — cloud nohup <host> <logfile> [--port N] [--insecure] [--early-life-check N] [--env K=V] [--source P] [--register [<jid>]] -- <argv...>")
            exit(2)
        }
        let _id = _checked_host(av[si + 1])
        let _rh = _resolve_cloud_host(_id)
        _guard_resolved_or_die("nohup", _id, _rh)
        let host = _rh.host
        if _rh.resolved == 1 {
            println("[cloud] nohup: resolved vast id → " + host + " :" + _rh.port + " (" + _rh.via + ")")
        }
        let logfile = av[si + 2]
        let ssh_opts = _apply_resolved_port(_ssh_opts_cli(av, si + 3), _rh)
        let env_kvs = _env_args_cli(av, si + 3)
        let early_life = _early_life_cli(av, si + 3)
        let reg_token = _register_cli(av, si + 3)
        let mut argv = _collect_after(av, si + 3)
        if len(argv) == 0 {
            println("[cloud] nohup: empty argv — usage: cloud nohup <host> <logfile> [--port N] [--insecure] [--early-life-check N] [--env K=V] [--source P] [--register [<jid>]] -- <argv...>")
            exit(2)
        }
        argv = _with_env(env_kvs, argv)
        argv = _with_source(_source_args_cli(av, si + 3), argv)
        let r = cloud_nohup_opts(host, ssh_opts, argv, logfile)
        // NOTE (#1229 B): `nohup` does NOT register the host (see `run` above) —
        // `host` is an ssh destination, not a provider pod-id. Tracking happens
        // at `rent`/`adopt`; recording the host poisoned reconcile with GHOSTs.
        if len(r.stdout_) > 0 {
            println(r.stdout_)
        }
        println("[cloud] " + r.message)
        // __MONITOR_HANDLE__= : grep-able JSON one-liner so a harness (Monitor
        // attach, micro-exp batch driver, a wrapping skill) can pick up host +
        // pid + logfile + ready-to-run tail_cmd without parsing the human
        // [cloud] message. Mirrors the existing __CLOUD_PID__= marker pattern.
        // Emitted only on a successful dispatch with a known logfile path.
        if r.ok == 1 && len(r.logfile) > 0 {
            println("__MONITOR_HANDLE__={"
                + "\"host\":" + _mh_json_str(host)
                + ",\"pid\":" + str(r.pid)
                + ",\"log\":" + _mh_json_str(r.logfile)
                + ",\"tail_cmd\":" + _mh_json_str("hexa cloud tail " + host + " " + r.logfile)
                + "}")
            // ghost-pod 자동 차단 — `--register` 가 있으면 in-process로 ./pods.json
            // 갱신 (Fix A, PR L2-auto). 없으면 기존 advisory line 유지 (PR #1769 L2-aware).
            if len(reg_token) > 0 {
                let _ = _auto_register(reg_token, host, r.pid)
            } else {
                println("[cloud] 📋 ledger: hexa cloud dispatch add <jid> " + str(r.pid) + " \"$(pwd)\" --host " + host + "  # cwd ./pods.json 에 등록 (commons g57; --register 로 자동화)")
            }
        }
