    }
    if sub == "fire" {
        // Atomic "fire and Monitor" — like nohup but the logfile is OPTIONAL
        // (auto-generated /tmp/cloud-<unix_ts>.log when --log omitted). Same
        // __MONITOR_HANDLE__= JSON line so a harness picks up host/pid/log/
        // tail_cmd from one verb call. The whole point: the caller no longer
        // has to invent a logfile path AND thread it through to `cloud tail`.
        if si + 1 >= len(av) {
            println("[cloud] fire: usage — cloud fire <host> [--log <path>] [--port N] [--insecure] [--early-life-check N] [--env K=V] [--source P] [--register [<jid>]] -- <argv...>")
            exit(2)
        }
        let _id = _checked_host(av[si + 1])
        let _rh = _resolve_cloud_host(_id)
        _guard_resolved_or_die("fire", _id, _rh)
        let host = _rh.host
        if _rh.resolved == 1 {
            println("[cloud] fire: resolved vast id → " + host + " :" + _rh.port + " (" + _rh.via + ")")
        }
        let ssh_opts = _apply_resolved_port(_ssh_opts_cli(av, si + 2), _rh)
        let env_kvs = _env_args_cli(av, si + 2)
        let early_life = _early_life_cli(av, si + 2)
        let log_path = _log_path_cli(av, si + 2)
        let reg_token = _register_cli(av, si + 2)
        let mut argv = _collect_after(av, si + 2)
        if len(argv) == 0 {
            println("[cloud] fire: empty argv — usage: cloud fire <host> [--log <path>] [--port N] [--insecure] [--early-life-check N] [--env K=V] [--source P] [--register [<jid>]] -- <argv...>")
            exit(2)
        }
        argv = _with_env(env_kvs, argv)
        argv = _with_source(_source_args_cli(av, si + 2), argv)
        // Auto-gen canonical /tmp/cloud-<unix_ts>.log when --log omitted, so
        // the caller does not have to invent the path. cloud_nohup_opts then
        // does the actual dispatch (no cloud_fire_opts shim needed in cloud.hexa).
        let mut effective_log = log_path
        if effective_log == "" {
            effective_log = "/tmp/cloud-" + str(timestamp()) + ".log"
        }
        let r = cloud_nohup_opts(host, ssh_opts, argv, effective_log)
        if len(r.stdout_) > 0 {
            println(r.stdout_)
        }
        println("[cloud] " + r.message)
        // Same __MONITOR_HANDLE__= line as cloud nohup (PR1) so callers parse
        // a single shape across both verbs.
        if r.ok == 1 && len(r.logfile) > 0 {
            println("__MONITOR_HANDLE__={"
                + "\"host\":" + _mh_json_str(host)
                + ",\"pid\":" + str(r.pid)
                + ",\"log\":" + _mh_json_str(r.logfile)
                + ",\"tail_cmd\":" + _mh_json_str("hexa cloud tail " + host + " " + r.logfile)
                + "}")
            // ghost-pod 자동 차단 — `--register` 있으면 in-process로 ./pods.json
            // 갱신 (Fix A, PR L2-auto). 없으면 advisory line 유지 (PR #1769 L2-aware).
            if len(reg_token) > 0 {
                let _ = _auto_register(reg_token, host, r.pid)
            } else {
                println("[cloud] 📋 ledger: hexa cloud dispatch add <jid> " + str(r.pid) + " \"$(pwd)\" --host " + host + "  # cwd ./pods.json 에 등록 (commons g57; --register 로 자동화)")
            }
        }
        if r.ok == 1 {
            let rc = _cloud_early_life_check(host, ssh_opts, r.pid, early_life)
            exit(rc)
        }
        exit(1)
    }
    if sub == "fire-shards" {
        // GENERIC sharded-batch dispatch (root-fix for the hand-rolled
        // /tmp/<x>_launch.sh anti-pattern): split a job list into N line-
        // balanced shards on the pod, then stagger-fire each shard detached via
        // the SAME setsid-nohup mechanism cloud fire/nohup use. ONE copy-to + a
        // REMOTE `split -n l/<N>` (no N local copy-to's), ONE consolidated
        // Monitor handle + ONE optional ./pods.json registration. See
        // stdlib/cloud/fire_shards.hexa for the pure builders + the placeholder
        // convention ({shard}/{i}/{out}/{log}).
        if si + 1 >= len(av) {
            println("[cloud] fire-shards: usage — cloud fire-shards <host> --jobs <file> --shards <N> --cmd '<tmpl>' [--stagger S] [--remote-dir D] [--prefix P] [conn] [--env K=V] [--source P] [--register [<jid>]] [--dry-run]")
            println("           {shard}=remote shard path · {i}=zero-padded index · {out}=<shard>.out · {log}=<shard>.log; --cmd MUST contain {shard}.")
            exit(2)
        }
        let _id = _checked_host(av[si + 1])
        let _rh = _resolve_cloud_host(_id)
        _guard_resolved_or_die("fire-shards", _id, _rh)
        let host = _rh.host
        if _rh.resolved == 1 {
            println("[cloud] fire-shards: resolved pod-id → " + host + " :" + _rh.port + " (" + _rh.via + ")")
        }
        let ssh_opts = _apply_resolved_port(_ssh_opts_cli(av, si + 2), _rh)
        let job_file = _flag_val(av, si + 2, "--jobs", "")
        let shards = _cli_atoi(_flag_val(av, si + 2, "--shards", "0"))
        let tmpl = _flag_val(av, si + 2, "--cmd", "")
        let stagger = _cli_atoi(_flag_val(av, si + 2, "--stagger", "0"))
        let remote_dir = _flag_val(av, si + 2, "--remote-dir", "/tmp/fire-shards-" + str(timestamp()))
        let prefix = _flag_val(av, si + 2, "--prefix", "shard_")
        let dry_run = _has_flag(av, si + 2, "--dry-run")
        let reg_token = _register_cli(av, si + 2)
        // env / source compose into the per-shard `pre` exactly as cloud fire's
        // --env (env K=V prefix) / --source (. <f> &&) do, so a shard runs in the
        // same toolchain context (conda/PATH) a single fire would.
        let env_kvs = _env_args_cli(av, si + 2)
        let src_files = _source_args_cli(av, si + 2)
        // validation — root-cause loud, never a silent half-launch.
        if len(job_file) == 0 || shards <= 0 || len(tmpl) == 0 {
            println("[cloud] fire-shards: need --jobs <file> --shards <N> --cmd '<tmpl>' (got jobs='" + job_file + "' shards=" + str(shards) + " cmd='" + tmpl + "')")
            exit(2)
        }
        if tmpl.index_of("{shard}") < 0 {
            println("[cloud] fire-shards: --cmd template has no {shard} placeholder — a shard launcher that ignores its shard is a bug. Add {shard} (and optionally {out}/{log}/{i}).")
            exit(2)
        }
        let job_remote = remote_dir + "/" + _basename(job_file)
        // assemble the per-shard `pre` (env K=V … and . <src> && …), reused by
        // both the plan text and the live launcher so preview == reality.
        let mut pre = ""
        let mut ei = 0
        while ei < len(src_files) {
            pre = pre + ". " + _shq_src(src_files[ei]) + " && "
            ei = ei + 1
        }
        if len(env_kvs) > 0 {
            pre = pre + "env"
            let mut vi = 0
            while vi < len(env_kvs) {
                pre = pre + " " + _shq_src(env_kvs[vi])
                vi = vi + 1
            }
            pre = pre + " "
        }
        // PLAN (always print) — the exact split + per-shard commands.
        print(_fs_plan_text(host, job_file, job_remote, remote_dir, prefix, tmpl, pre, shards, stagger))
        if dry_run == 1 {
            exit(0)
        }
        if !file_exists(job_file) {
            println("[cloud] fire-shards: local --jobs file not found: " + job_file)
            exit(2)
        }
        // ① upload the job file (ONE copy-to), creating the remote dir first.
        let _mk = cloud_exec_opts(host, ssh_opts, "mkdir -p " + _shq_src(remote_dir))
        if _mk.ok == 0 {
            println("[cloud] fire-shards: remote mkdir failed — " + _mk.message)
            exit(1)
        }
        let up = _copy_to_run(host, ssh_opts, job_file, job_remote, 0)
        if up.ok == 0 {
            println("[cloud] fire-shards: upload failed — " + up.message)
            exit(1)
        }
        println("[cloud] fire-shards: uploaded " + job_file + " -> " + host + ":" + job_remote)
        // ② remote line-balanced split into N shard files.
        let sp = cloud_exec_opts(host, ssh_opts, _fs_remote_split(job_remote, remote_dir, prefix, shards))
        if sp.ok == 0 {
            println("[cloud] fire-shards: remote split failed — " + sp.message)
            exit(1)
        }
        let made = _parse_uint_after(sp.stdout_, "__FS_SHARDS__=")
        if made != shards {
            println("[cloud] fire-shards: split produced " + str(made) + " shard file(s), expected " + str(shards)
                + " — the job file likely has fewer lines than shards. Reduce --shards.")
            exit(1)
        }
        println("[cloud] fire-shards: split into " + str(made) + " shard(s) under " + host + ":" + remote_dir + "/" + prefix + "NN")
        // ③ stagger-fire every shard detached (the launcher returns at once —
        // each shard is backgrounded with setsid, so the ssh call does not block).
        let launcher = _fs_remote_launcher(tmpl, pre, remote_dir, prefix, shards, stagger)
        let fr = cloud_exec_opts(host, ssh_opts, launcher)
        if fr.ok == 0 {
            println("[cloud] fire-shards: launcher failed — " + fr.message)
            exit(1)
        }
        let launched = _parse_uint_after(fr.stdout_, "__FS_LAUNCHED__=")
        println("[cloud] fire-shards: launched " + str(launched) + " shard(s) (stagger " + str(stagger) + "s) — pids in launcher output above; per-shard logs at " + remote_dir + "/" + prefix + "NN.log")
        // ④ ONE consolidated Monitor handle covering the whole batch. There is no
        // single batch pid (N detached shards), so the handle's pid is 0 and
        // `log`/`tail_cmd` point at the shard log DIRECTORY glob — a harness tails
        // every shard log at once. shards/dir carried so a driver can fan poll.
        if fr.ok == 1 {
            let glob = remote_dir + "/" + prefix + "*.log"
            println("__MONITOR_HANDLE__={"
                + "\"host\":" + _mh_json_str(host)
                + ",\"pid\":0"
                + ",\"shards\":" + str(launched)
                + ",\"dir\":" + _mh_json_str(remote_dir)
                + ",\"log\":" + _mh_json_str(glob)
                + ",\"tail_cmd\":" + _mh_json_str("hexa cloud exec " + host + " -- tail -n +1 -f " + glob)
                + "}")
            // ⑤ ONE ./pods.json row for the whole batch (not N untracked
            // launches) — same _auto_register gateway nohup/fire use. pid 0 is a
            // batch sentinel (no single tracked pid); the dir/shards live in the
            // Monitor handle above for a driver to fan out polls.
            if len(reg_token) > 0 {
                let _ = _auto_register(reg_token, host, 0)
            } else {
                println("[cloud] 📋 ledger: hexa cloud dispatch add <jid> 0 \"$(pwd)\" --host " + host + "  # batch row (--register to automate)")
            }
        }
        exit(0)
    }
    if sub == "poll" {
        if si + 2 >= len(av) {
            println("[cloud] poll: usage — cloud poll <host> <pid> [--port N] [--insecure] [--expect-artifact <p1,p2,…>]  (with --expect-artifact, a DEAD pid is success ONLY if every listed remote artifact exists + is non-empty)")
            exit(2)
        }
        let _rh = _resolve_cloud_host(_checked_host(av[si + 1]))
        let host = _rh.host
        if _rh.resolved == 1 {
            println("[cloud] poll: resolved pod-id → " + host + " :" + _rh.port + " (" + _rh.via + ")")
        }
        let pid = _cli_atoi(av[si + 2])
        let ssh_opts = _apply_resolved_port(_ssh_opts_cli(av, si + 3), _rh)
        // Bug-2 (@L6): 3-state poll. DEAD only when ssh CONNECTED and the pid
        // was absent; a transport outage (ssh exit 255 — refused / timeout /
        // publickey / changed host key) is UNREACHABLE, NOT a death.
        let status = cloud_poll_status_opts(host, ssh_opts, pid)
        if status == CLOUD_POLL_ALIVE {
            println("[cloud] pid " + str(pid) + " ALIVE")
            exit(0)
        }
        if status == CLOUD_POLL_UNREACHABLE {
            // The pod may be alive + billing but momentarily unreachable — this
            // is the edge-genall failure mode. Report UNKNOWN and do NOT flip a
            // verdict / tear down. exit 2 = distinct from ALIVE(0) / DEAD(1).
            println("[cloud] pid " + str(pid) + " UNREACHABLE — ssh transport failure (255: refused / timeout / publickey / host-key). Pod may be ALIVE + billing; verdict NOT flipped, NOT torn down. Verify reachability (host / port) or tear the pod down manually.")
            exit(2)
        }
        println("[cloud] pid " + str(pid) + " DEAD")
        // --expect-artifact <csv>: a DEAD process is a SUCCESSFUL completion
        // ONLY if every expected output artifact actually wrote. Catches the
        // silent-loss mode where proc EXITED clean but the final ckpt/result
        // was never saved (anima 7B, 2026-06). Opt-in: without the flag, a
        // DEAD pid stays exit 1 (unchanged behavior for existing callers).
        let _arts = _flag_val(av, si + 3, "--expect-artifact", "")
        if len(_arts) > 0 {
            let _paths = _arts.split(",")
            let mut _all_ok = 1
            let mut _ai = 0
            while _ai < len(_paths) {
                let _p = _paths[_ai].trim()
                if len(_p) > 0 {
                    let _ar = cloud_expect_artifact(host, ssh_opts, _p)
                    println("[cloud]   " + _ar.message)
                    if _ar.ok == 0 {
                        _all_ok = 0
                    }
                }
                _ai = _ai + 1
            }
            let _ = _teardown_verdict_if_registered(pid)
            if _all_ok == 1 {
                println("[cloud] pid " + str(pid) + " DEAD-COMPLETE — all expected artifacts present")
                exit(0)
            }
            println("[cloud] pid " + str(pid) + " DEAD-INCOMPLETE — an expected artifact is MISSING/zero (silent training-loss); NOT a success")
            exit(1)
        }
        // Fix B — teardown auto-verdict. If this pid was registered via Fix A
        // (`--register` on fire/nohup), flip its verdict PENDING→FAIL so the
        // ledger never carries a stale-PENDING row for a DEAD remote job. Runs
        // ONLY on a genuine DEAD (ssh connected, pid absent) — never on an
        // UNREACHABLE transport outage (handled above). Conservative default: a
        // launcher that wants PASS calls `cloud dispatch verdict <jid> PASS`
        // itself (poll cannot see exit code).
        let _ = _teardown_verdict_if_registered(pid)
        exit(1)
    }
    if sub == "tail" {
        // Live-stream a remote logfile to stdout so a harness (Monitor) can
        // attach to a remote job's progress with no polling — the canonical
        // bridge for `@D g57` ("attach Monitor to the LOG"). The remote
        // `tail -F | awk` does the grep filter + terminal-exit.
        //
        // We exec_replace() (execvp /bin/sh -c) rather than exec_stream():
        // the hexa process BECOMES the ssh pipeline, inheriting this stdout
        // fd, so each line reaches the local end live with zero buffering and
        // the process simply exits when the pipeline ends (until-match closes
        // the pipe → tail SIGPIPE → ssh returns). exec_stream's callback
        // fn-pointer path segfaults in a `hexa build` standalone binary
        // (upstream gap, logged to INBOX) — exec_replace has no callback and
        // is the same primitive `hexa lsp` uses for clean stream passthrough.
        if si + 2 >= len(av) {
            println("[cloud] tail: usage — cloud tail <host> <logfile> [--port N] [--insecure] [--grep RE] [--until RE]")
            exit(2)
        }
        let _rh = _resolve_cloud_host(_checked_host(av[si + 1]))
        let host = _rh.host
        let logfile = av[si + 2]
        let ssh_opts = _apply_resolved_port(_ssh_opts_cli(av, si + 3), _rh)
        let grep_re = _flag_val(av, si + 3, "--grep", "")
        // Terminal mode (INBOX gap 1, 2026-05-28):
        //   - --until ABSENT  → the 3-tier failure-first taxonomy (exit
        //     0 DONE / 3 TIMEOUT-RESUMABLE / 4 CRASHED). This is the default
        //     so a walltime-timed-out QE job is no longer mis-read as success.
        //   - --until <ere>   → legacy single terminal block (exit 0 on first
        //     match). Explicit pattern = opt back into the old behaviour.
        //   - --until ''      → empty ERE = follow forever (no terminal block).
        let mut cmd = ""
        if _has_flag(av, si + 3, "--until") == 1 {
            let until_re = _flag_val(av, si + 3, "--until", "")
            cmd = cloud_tail_cmd_opts(host, ssh_opts, logfile, grep_re, until_re)
        } else {
            cmd = cloud_tail_cmd_taxonomy_opts(host, ssh_opts, logfile, grep_re)
        }
        let _ = exec_replace(cmd)
        // exec_replace only returns on execvp failure (no /bin/sh) — surface it.
        println("[cloud] tail: exec_replace failed — could not spawn ssh pipeline")
        exit(1)
    }
    if sub == "watch" {
        if si + 2 >= len(av) {
            println("[cloud] watch: usage — cloud watch <host> <pid> [--port N] [--insecure] [--interval N] [--max-wait S] [--then-down <id> [--provider P]]")
            println("[cloud]        OR — cloud watch <host> <logfile> --until <marker> --detach [--grep RE]  (session-independent durable watcher)")
            exit(2)
        }
        // gap-3 (watch-detach): `cloud watch <host> <log> --until <marker>
        // --detach` spawns a SESSION-INDEPENDENT watcher (setsid + nohup,
        // durable log) over the `cloud tail` 3-tier failure-first exit taxonomy
        // (0 DONE / 3 TIMEOUT / 4 CRASH / 255 transport). It survives the
        // parent shell SIGHUP / session re-auth (the exit-144 mass-death this
        // campaign). The 2nd positional is a LOGFILE here, not a pid.
        if _has_flag(av, si + 3, "--detach") == 1 {
            let _rhd = _resolve_cloud_host(_checked_host(av[si + 1]))
            let host_d = _rhd.host
            let logfile = av[si + 2]
            let ssh_opts_d = _apply_resolved_port(_ssh_opts_cli(av, si + 3), _rhd)
            let grep_re = _flag_val(av, si + 3, "--grep", "")
            // Build the inner tail command: an explicit --until uses the legacy
            // single terminal block; absent --until uses the 3-tier taxonomy.
            let mut inner = ""
            if _has_flag(av, si + 3, "--until") == 1 {
                let until_re = _flag_val(av, si + 3, "--until", "")
                inner = cloud_tail_cmd_opts(host_d, ssh_opts_d, logfile, grep_re, until_re)
            } else {
                inner = cloud_tail_cmd_taxonomy_opts(host_d, ssh_opts_d, logfile, grep_re)
            }
            // Durable log: explicit --log, else canonical /tmp/cloud-watch-<ts>.log.
            let mut durable = _flag_val(av, si + 3, "--log", "")
            if durable == "" {
                durable = "/tmp/cloud-watch-" + str(timestamp()) + ".log"
            }
            let wr = cloud_watch_detach_opts(inner, durable)
            println("[cloud] " + wr.message)
            if wr.ok == 1 {
                // __MONITOR_HANDLE__= JSON: a harness picks up the durable log +
                // watcher pid without parsing the human line (mirrors nohup/fire).
                println("__MONITOR_HANDLE__={"
                    + "\"watcher_pid\":" + str(wr.pid)
                    + ",\"log\":" + _mh_json_str(durable)
                    + ",\"detached\":1}")
                exit(0)
            }
            exit(1)
        }
        let _rh = _resolve_cloud_host(_checked_host(av[si + 1]))
        let host = _rh.host
        let pid = _cli_atoi(av[si + 2])
        let ssh_opts = _apply_resolved_port(_ssh_opts_cli(av, si + 3), _rh)
        let interval = _cli_atoi(_flag_val(av, si + 3, "--interval", "30"))
        let max_wait = _cli_atoi(_flag_val(av, si + 3, "--max-wait", "0"))
        let rc = _cloud_watch(host, ssh_opts, pid, interval, max_wait)
        // On completion (pid gone), optionally tear the pod down — closes the
        // "auto-loop-until-done + teardown" pattern (R2/P3) so the operator
        // need not babysit. Skipped on timeout (rc 124).
        if rc == 0 {
            let down_id = _flag_val(av, si + 3, "--then-down", "")
            if len(down_id) > 0 {
                let provider = _flag_val(av, si + 3, "--provider", "vast")
                exit(_cloud_down(down_id, provider))
            }
        }
        exit(rc)
    }
    if sub == "ssh-port" || sub == "resolve" {
        // `resolve` is a discoverable alias of `ssh-port`: turn a provider
        // pod-id into the live ssh endpoint (host + port) so the result can
        // be fed to `cloud run/exec/copy-to <root@ip> --port <n>`. A live
        // RunPod fire-path agent reached for the name `resolve` and, finding
        // no such verb in a stale 0.1.0 binary, mis-diagnosed a transport
        // deadlock (INBOX 2026-05-27) — the resolver (runpod_get_ssh_port)
        // already existed under `ssh-port`; only the deployed bin was stale.
        if si + 1 >= len(av) {
            println("[cloud] " + sub + ": missing <id> — usage: cloud " + sub + " <id> [--provider vast|runpod]")
            exit(2)
        }
        let id = av[si + 1]
        // No explicit --provider → resolve from the registry so a runpod id
        // hits runpod_get_ssh_port, not the vast endpoint. Flag overrides.
        let mut provider = _flag_val(av, si + 2, "--provider", "")
        if len(provider) == 0 {
            provider = _provider_for_id(id)
        }
        // handoff fb0ae653: `--json` is ADDITIVE — emits a single stable
        // machine-readable {"host":...,"port":...} line so parsers (hf-recover-
        // guard) stop scraping the human `host=`/`port=` text and silently
        // degrading if that format drifts. The default human format is
        // UNCHANGED; --json fully replaces it only when requested.
        if _has_flag(av, si + 2, "--json") == 1 {
            exit(_cloud_ssh_port_json(id, provider))
        }
        exit(_cloud_ssh_port(id, provider))
    }
    if sub == "alive" || sub == "probe" {
        // PROVIDER-API liveness (NOT ssh) — disambiguate "transport outage,
        // pod alive + billing" from "pod reclaimed/dead". Read-only; queries
        // the SAME vast/runpod API clients rent/down use (alive.hexa). Collect
        // all post-verb positional tokens as ids (skip --provider <v> and its
        // value, and the bare --json flag), then classify each. Aggregate exit
        // = worst/most-actionable: 0=RUNNING · 3=STOPPED · 4=GONE · 255=api/cred.
        let provider = _flag_val(av, si + 1, "--provider", "")
        let as_json = _has_flag(av, si + 1, "--json")
        let mut ids = []
        let mut ai = si + 1
        while ai < len(av) {
            let t = av[ai]
            if t == "--provider" {
                ai = ai + 2
            } else { if t == "--json" {
                ai = ai + 1
            } else {
                ids.push(t)
                ai = ai + 1
            } }
        }
        exit(alive_run(ids, provider, as_json))
    }
    if sub == "api" {
        // UNIVERSAL authenticated REST passthrough (api.hexa) — makes hexa
        // cloud a full substitute for the provider REST API so cloud-guard
        // (commons g8) never strands an unwrapped operation. Positional shape:
        //   cloud api <provider> <METHOD> <endpoint> [--data JSON] [--json] [--allow-mutate]
        // GET / vast-search pass freely; a registry-MUTATING call is REFUSED
        // and redirected to rent/rm unless --allow-mutate (then auto-reconcile).
        let as_json = _has_flag(av, si + 1, "--json")
        let allow_mutate = _has_flag(av, si + 1, "--allow-mutate")
        let data = _flag_val(av, si + 1, "--data", "")
        let mut pos = []
        let mut ai = si + 1
        while ai < len(av) {
            let t = av[ai]
            if t == "--data" {
                ai = ai + 2
            } else { if t == "--json" || t == "--allow-mutate" {
                ai = ai + 1
            } else {
                pos.push(t)
                ai = ai + 1
            } }
        }
        if len(pos) < 3 {
            println("[cloud] api: usage — cloud api <vast|runpod> <GET|POST|PUT|DELETE> <endpoint> [--data JSON] [--json] [--allow-mutate]")
            exit(2)
        }
        exit(api_run(pos[0], pos[1], pos[2], data, as_json, allow_mutate))
    }
    if sub == "provider-cli" {
        // Proxy the provider's OWN cli (vastai|runpodctl) THROUGH the guarded
        // path with creds injected (provider_cli.hexa) — keeps CLI-only
        // conveniences reachable without an un-guarded raw `vastai`. Shape:
        //   cloud provider-cli <vast|runpod> [--allow-mutate] -- <args...>
        // Everything AFTER `--` is the verbatim provider argv; a registry-
        // mutating subcommand is refused unless --allow-mutate (then reconcile).
        let allow_mutate = _has_flag(av, si + 1, "--allow-mutate")
        // first positional after the verb (skipping flags) = the provider.
        let mut provider = ""
        let mut sep = -1
        let mut ai = si + 1
        while ai < len(av) {
            let t = av[ai]
            if t == "--" {
                sep = ai
                ai = len(av)
            } else { if t == "--allow-mutate" {
                ai = ai + 1
            } else {
                if len(provider) == 0 { provider = t }
                ai = ai + 1
            } }
        }
        let mut pargs = []
        if sep >= 0 {
            let mut pi = sep + 1
            while pi < len(av) {
                pargs.push(av[pi])
                pi = pi + 1
            }
        }
        if len(provider) == 0 {
            println("[cloud] provider-cli: usage — cloud provider-cli <vast|runpod> [--allow-mutate] -- <args...>")
            exit(2)
        }
        exit(provider_cli_run(provider, pargs, allow_mutate))
    }
    if sub == "orphans" {
        // List tracked pods, flagging stale ones (created > N hours ago and
        // not marked closed). Optional `--hours N` overrides the default 6h.
        let mut hours = 6
        let mut oi = si + 1
        while oi < len(av) {
            if av[oi] == "--hours" && oi + 1 < len(av) {
                hours = _cli_atoi(av[oi + 1])
                oi = oi + 2
            } else {
                oi = oi + 1
            }
        }
        if hours <= 0 {
            hours = 6
        }
        let stale = cloud_orphans_print(hours)
        if stale > 0 {
            exit(1)
        }
        exit(0)
    }
    if sub == "reconcile" {
        // Cross-reference the registry (pods.jsonl) against the provider's
        // live pod list (runpod_list_pods) and print the ORPHAN/GHOST/OK
        // table. Exit 1 when registry and provider disagree (any ORPHAN /
        // GHOST), else 0. No ssh / pod-spinup — the only outbound call is the
        // wrapped provider list (runpodctl); absent runpodctl reconciles
        // against an empty provider set (every tracked pod → GHOST).
        let drift = cloud_reconcile_print()
        if drift > 0 {
            exit(1)
        }
        exit(0)
    }
    if sub == "reap" {
        // M6 orphan finder — set-diff alive(provider) − registry(M5) =
        // orphans (alive on provider but the M5 SSOT does not know about
        // them). bare = dry-run table + exit 0; --apply destroys via the
        // existing _cloud_down path. --provider runpod|vast narrows scope.
        let provider = _flag_val(av, si + 1, "--provider", "")
        let mut apply = 0
        let mut ri = si + 1
        while ri < len(av) {
            // `--yes` is the plan-spec execute flag; `--apply` kept as the
            // pre-existing alias (no breakage for existing reap callers).
            if av[ri] == "--apply" || av[ri] == "--yes" {
                apply = 1
            }
            ri = ri + 1
        }
        exit(_cloud_reap(provider, apply))
    }
    if sub == "idle-reap" {
        // Complement of `reap`: provider pods that ARE billing but have NO
        // active (verdict=PENDING) job pinned in ./pods.json — the dup-idle-
        // pod leak. REPORT-only by default (read-only, exit 0); --reap
        // destroys via _cloud_down. --provider runpod|vast narrows scope.
        let provider = _flag_val(av, si + 1, "--provider", "")
        let mut apply = 0
        let mut ii = si + 1
        while ii < len(av) {
            if av[ii] == "--reap" {
                apply = 1
            }
            ii = ii + 1
        }
        exit(_cloud_idle_reap(provider, apply))
    }
    if sub == "adopt" {
        // Track a previously-untracked (ORPHAN) pod so it regains a
        // poll/pull/lifecycle handle. `--purpose TEXT` sets the registry
        // label; defaults to "(adopted)".
        if si + 1 >= len(av) {
            println("[cloud] adopt: missing <pod_id> — usage: cloud adopt <pod_id> [--purpose TEXT] [--project NAME]")
            exit(2)
        }
        // help-guard (#cloud-adopt-help): `cloud adopt --help`/`-h` 는 usage 를
        // 출력하고 정상(0) 종료 — `--help` 를 pod-id 로 오인해 "adopted --help" 를
        // 찍던 misparse 차단. 일반화: `-` 로 시작하는 pod-id 토큰은 pod-id 가 아니라
        // 놓친 flag 로 보고 거부(exit 2) — _pod_id_looks_valid 의 write-side 거부가
        // registry 오염은 이미 막지만, verb 가 그 전에 거짓 success 를 찍었다.
        let _adopt_first = av[si + 1]
        if _adopt_first == "--help" || _adopt_first == "-h" {
            println("usage: cloud adopt <pod_id> [--purpose TEXT] [--project NAME]")
            println("  track an untracked (ORPHAN) pod — stamps M5 project/purpose for the down-guard.")
            exit(0)
        }
        if len(_adopt_first) >= 1 && _adopt_first.substring(0, 1) == "-" {
            println("[cloud] adopt: '" + _adopt_first + "' is not a pod-id (starts with '-') — did you mean a flag? usage: cloud adopt <pod_id> [--purpose TEXT] [--project NAME]")
            exit(2)
        }
        let pod_id = av[si + 1]
        let mut purpose = "(adopted)"
        let mut ai = si + 2
        while ai < len(av) {
            if av[ai] == "--purpose" && ai + 1 < len(av) {
                purpose = av[ai + 1]
                ai = ai + 2
            } else {
                ai = ai + 1
            }
        }
        // Project attribution for the M5 down-guard — explicit --project, else
        // cwd git-repo basename, else "unattributed".
        let adopt_project = _resolve_project(av, si + 2)
        let ok = pod_registry_adopt(pod_id, purpose)
        // Also stamp the M5 SSOT (active-pods.json) with project/purpose so the
        // adopted pod gains cross-project down-guard attribution. provider ""
        // is preserved/inferred elsewhere; status READY (adopt = it's alive).
        let _m5 = pod_registry_add(pod_id, "", adopt_project, purpose, "", "", "READY")
        if ok == 1 {
            println("[cloud] adopted " + pod_id + " (project=" + adopt_project + ", purpose=" + purpose + ", status=running)")
            // #1155 zero-flag: if this is a vast instance, write its bare-IP
            // Host block → ~/.ssh/config (no-op for runpod / no vast key).
            let _inj = vast_ssh_config_autoinject(pod_id)
            if len(_inj) > 0 {
                println("[cloud] adopt: ~/.ssh/config Host " + _inj + " → vast identity (auto; #1155)")
            }
            exit(0)
        }
        println("[cloud] adopt: empty pod_id")
        exit(2)
    }
    if sub == "attribute" {
        // Re-stamp project/purpose attribution on an ALREADY-tracked pod for
        // the M5 cross-project down-guard. Distinct from `adopt`: `adopt` is
        // for an untracked ORPHAN (registers it); `attribute` REQUIRES the pod
        // to be tracked and only updates its attribution in place (provider /
        // created_at / status / ssh are preserved by the pod_registry_add
        // upsert when ""/unchanged are passed). At least one of --project /
        // --purpose must be supplied.
        if si + 1 >= len(av) {
            println("[cloud] attribute: missing <pod_id> — usage: cloud attribute <pod_id> --project NAME [--purpose TEXT]")
            exit(2)
        }
        let _attr_first = av[si + 1]
        if _attr_first == "--help" || _attr_first == "-h" {
            println("usage: cloud attribute <pod_id> --project NAME [--purpose TEXT]")
            println("  re-stamp project/purpose on an ALREADY-tracked pod (M5 down-guard attribution).")
            println("  distinct from `adopt`, which registers an untracked ORPHAN.")
            exit(0)
        }
        if len(_attr_first) >= 1 && _attr_first.substring(0, 1) == "-" {
            println("[cloud] attribute: '" + _attr_first + "' is not a pod-id (starts with '-') — did you mean a flag? usage: cloud attribute <pod_id> --project NAME [--purpose TEXT]")
            exit(2)
        }
        let attr_pod = _attr_first
        if pod_registry_is_tracked(attr_pod) == 0 {
            println("[cloud] attribute: '" + attr_pod + "' is not tracked — use `cloud adopt " + attr_pod + " --project NAME` to track an orphan first")
            exit(2)
        }
        // Explicit flags only — no cwd-fallback. attribute is a deliberate
        // re-stamp, so absent flags mean "leave that field unchanged" ("").
        let attr_project = _flag_val(av, si + 2, "--project", "")
        let attr_purpose = _flag_val(av, si + 2, "--purpose", "")
        if len(attr_project) == 0 && len(attr_purpose) == 0 {
            println("[cloud] attribute: nothing to set — supply --project NAME and/or --purpose TEXT")
            exit(2)
        }
        // "" leaves the prior value untouched (pod_registry_add upsert rule).
        let _attr_ok = pod_registry_add(attr_pod, "", attr_project, attr_purpose, "", "", "")
        if _attr_ok == 1 {
            let _shown_proj = pod_registry_project_of(attr_pod)
            println("[cloud] attributed " + attr_pod + " (project=" + _shown_proj + ")")
            exit(0)
        }
        println("[cloud] attribute: failed to update " + attr_pod)
        exit(2)
    }
    if sub == "forget" {
        // Mark a tracked (GHOST) pod's record status=closed. The record is
        // retained (closed rows are excluded from staleness flagging) so the
        // launch history survives. The arg is matched LITERALLY against the
        // registry `pod_id` field, so any form `cloud reconcile` shows in its
        // GHOST column closes — numeric provider-id, ssh-form (`root@<ip>`),
        // bare IP, alias (`ubu-2`), or a `--help`-as-id edge case (legacy
        // pollution the write-side guard now blocks). This makes the
        // reconcile→forget cleanup loop closed-form (INBOX 2026-05-28).
        if si + 1 >= len(av) {
            println("[cloud] forget: missing <pod_id> — usage: cloud forget <pod_id|ssh-form|ip|alias>")
            exit(2)
        }
        let pod_id = av[si + 1]
        let ok = pod_registry_forget(pod_id)
        if ok == 1 {
            println("[cloud] forgot " + pod_id + " (status=closed)")
            exit(0)
        }
        // Not found — hint the open (non-closed) candidate ids so the caller
        // can copy the exact registry form (it must match LITERALLY).
        println("[cloud] forget: '" + pod_id + "' not found in registry (matched literally against the pod_id field)")
        let rows = pod_registry_rows(0)
        let mut hint = ""
        let mut hn = 0
        let mut hi = 0
        while hi < len(rows) && hn < 12 {
            let r = rows[hi]
            if r.status != "closed" {
                if len(hint) > 0 { hint = hint + ", " }
                hint = hint + r.pod_id
                hn = hn + 1
            }
            hi = hi + 1
        }
        if len(hint) > 0 {
            println("[cloud] forget: open candidates — " + hint)
            println("[cloud] forget: run `cloud reconcile` for the full GHOST list, then forget the exact form shown")
        } else {
            println("[cloud] forget: no open (non-closed) rows tracked — registry is clean")
        }
        exit(1)
    }
    if sub == "copy-to" {
        if si + 1 >= len(av) {
            println("[cloud] copy-to: usage — cloud copy-to <host> <local> <remote> [--port N] [--insecure]")
            exit(2)
        }
        let _id = _checked_host(av[si + 1])
        let _rh = _resolve_cloud_host(_id)
        _guard_resolved_or_die("copy-to", _id, _rh)
        let host = _rh.host
        if _rh.resolved == 1 {
            println("[cloud] copy-to: resolved pod-id → " + host + " :" + _rh.port + " (" + _rh.via + ")")
        }
        // Bug-3 (@L7): collect <local> <remote> as FLAG-SKIPPING positionals so
        // a `--port N` anywhere (incl. between the paths) is parsed as a flag,
        // never read as the source path (the `root@host:--port` exit-255 bug).
        let _pos = _copy_positionals(av, si + 2)
        if len(_pos) < 2 {
            println("[cloud] copy-to: need <local> <remote> — usage: cloud copy-to <host> <local> <remote> [--port N] [--insecure]")
            exit(2)
        }
        let local_path = _pos[0]
        let remote_path = _pos[1]
        let ssh_opts = _apply_resolved_port(_ssh_opts_cli(av, si + 2), _rh)
        let mut want_recursive = _has_flag(av, si + 2, "--recursive")
        if _has_flag(av, si + 2, "-r") == 1 {
            want_recursive = 1
        }
        // ING #75 — scp can't create a missing destination PARENT, so a
        // copy-to into /root/anima/state/... died with a silent `scp exit 1`
        // when the parent dir didn't exist. mkdir -p the remote parent FIRST
        // (idempotent; no-op when the dir already exists or the dest is
        // cwd-relative with no parent). `--no-mkparent` opts out.
        //
        // IDEMPOTENT-DIR (bug-fix 2026-06-24): for the RECURSIVE (`-r`) path
        // mkdir -p the DEST dir ITSELF (not just its parent). cloud_copy_to_
        // recursive_opts now copies the source's CONTENTS (`localdir/.`) INTO
        // remote_path so a `copy-to dir dir` merges instead of nesting
        // (destdir/localdir) — but `scp -r src/. dest` needs `dest` to already
        // exist as a directory. Creating it here makes the merge target present
        // on a first copy too (and is a no-op when it already exists). The
        // single-file path keeps the parent-only mkdir (scp creates the file).
        // (cloud_copy_to_recursive_opts ALSO mkdir-p's the dest defensively, so
        // non-CLI callers like dft_dispatch's _dft_upload are correct too; the
        // double mkdir -p is harmless / idempotent.)
        let mut _mkdir_target = _remote_dirname(remote_path)
        if want_recursive == 1 {
            _mkdir_target = remote_path
        }
        if len(_mkdir_target) > 0 && _has_flag(av, si + 2, "--no-mkparent") == 0 {
            let _mk = cloud_exec_opts(host, ssh_opts, "mkdir -p " + _shq(_mkdir_target))
            if _mk.ok == 0 {
                println("[cloud] copy-to: ⚠ remote mkdir -p " + _mkdir_target + " failed (rc "
                    + to_string(_mk.exit_code) + ") — scp may fail if the dir is absent")
            }
        }
        let r = _copy_to_run(host, ssh_opts, local_path, remote_path, want_recursive)
        println("[cloud] " + r.message + " · " + local_path + " -> " + host + ":" + remote_path)
        if r.ok == 1 && _has_flag(av, si + 2, "--verify-sha") == 1 {
            let v = cloud_verify_sha(host, ssh_opts, remote_path, local_path)
            println("[cloud] verify-sha: " + v.message)
            exit(v.exit_code)
        }
        exit(r.exit_code)
    }
    if sub == "bootstrap" {
        // ING #78 — one-shot pod setup that composes the now-hardened
        // primitives so a fresh pod never re-treads the #71~77 traps:
        //   [--hexa edge|stable]  install hexa on the pod
        //   [--push local:remote] (repeatable)  SEQUENTIAL copy-to with auto
        //        parent-mkdir (#75) + scp retry (#74) + sha verify, one stream
        //        at a time (#76 — never concurrent over a vast proxy)
        //   [--exec cmd]          run a final command on the pod
        // Pure composition of verified verbs (exec/copy-to); rents nothing.
        if si + 1 >= len(av) {
            println("[cloud] bootstrap: usage — cloud bootstrap <id> [--hexa edge|stable] [--push local:remote]... [--exec 'cmd'] [--port N] [--insecure]")
            exit(2)
        }
        let _id = _checked_host(av[si + 1])
        let _rh = _resolve_cloud_host(_id)
        _guard_resolved_or_die("bootstrap", _id, _rh)
        let host = _rh.host
        let ssh_opts = _apply_resolved_port(_ssh_opts_cli(av, si + 2), _rh)
        // 1) install hexa (optional)
        let hexa_ver = _flag_val(av, si + 2, "--hexa", "")
        if len(hexa_ver) > 0 {
            let mut inst_cmd = "curl -fsSL https://raw.githubusercontent.com/dancinlab/hexa-lang/main/install.sh | sh"
            if hexa_ver == "edge" {
                inst_cmd = "curl -fsSL https://raw.githubusercontent.com/dancinlab/hexa-lang/main/install.sh | HEXA_VERSION=edge sh"
            }
            println("[cloud] bootstrap: installing hexa (" + hexa_ver + ") …")
            let ir = cloud_exec_opts(host, ssh_opts, inst_cmd)
            if ir.ok == 0 {
                println("[cloud] bootstrap: hexa install FAILED (rc " + to_string(ir.exit_code) + ") — aborting")
                exit(ir.exit_code)
            }
        }
        // 2) sequential pushes (parent-mkdir + scp-retry + verify, one at a time)
        let pushes = _push_args_cli(av, si + 2)
        let mut pi = 0
        while pi < len(pushes) {
            let pair = _split_first_colon(pushes[pi])
            let lp = pair[0]
            let rp = pair[1]
            if len(rp) == 0 {
                println("[cloud] bootstrap: --push '" + pushes[pi] + "' missing :remote — skipped")
                pi = pi + 1
                continue
            }
            let parent = _remote_dirname(rp)
            if len(parent) > 0 {
                let _ = cloud_exec_opts(host, ssh_opts, "mkdir -p " + _shq(parent))
            }
            println("[cloud] bootstrap: push " + lp + " -> " + rp + " …")
            let cr = _copy_to_run(host, ssh_opts, lp, rp, 1)
            if cr.ok == 0 {
                println("[cloud] bootstrap: push FAILED (" + cr.message + ") — aborting")
                exit(cr.exit_code)
            }
            let v = cloud_verify_sha(host, ssh_opts, rp, lp)
            println("[cloud] bootstrap: verify-sha " + rp + " — " + v.message)
            if v.exit_code != 0 {
                println("[cloud] bootstrap: sha mismatch — aborting")
                exit(v.exit_code)
            }
            pi = pi + 1
        }
        // 3) final exec (optional)
        let exec_cmd = _flag_val(av, si + 2, "--exec", "")
        if len(exec_cmd) > 0 {
            println("[cloud] bootstrap: exec " + exec_cmd)
            let er = cloud_exec_opts(host, ssh_opts, exec_cmd)
            if len(er.stdout_) > 0 { print(er.stdout_) }
            println("[cloud] bootstrap: " + er.message)
            exit(er.exit_code)
        }
        println("[cloud] bootstrap: DONE (" + to_string(len(pushes)) + " push(es))")
        exit(0)
    }
    if sub == "copy-from" {
        if si + 1 >= len(av) {
            println("[cloud] copy-from: usage — cloud copy-from <host> <remote> <local> [--port N] [--insecure]")
            exit(2)
        }
        let _id = _checked_host(av[si + 1])
        let _rh = _resolve_cloud_host(_id)
        _guard_resolved_or_die("copy-from", _id, _rh)
        let host = _rh.host
        if _rh.resolved == 1 {
            println("[cloud] copy-from: resolved pod-id → " + host + " :" + _rh.port + " (" + _rh.via + ")")
        }
        // Bug-3 (@L7): collect <remote> <local> as FLAG-SKIPPING positionals so
        // a `--port N` anywhere is parsed as a flag, never read as the remote
        // source path (`root@ssh1.vast.ai:--port` scp exit 255 — the live bug).
        let _pos = _copy_positionals(av, si + 2)
        if len(_pos) < 2 {
            println("[cloud] copy-from: need <remote> <local> — usage: cloud copy-from <host> <remote> <local> [--port N] [--insecure]")
            exit(2)
        }
        let remote_path = _pos[0]
        let local_path = _pos[1]
        let ssh_opts = _apply_resolved_port(_ssh_opts_cli(av, si + 2), _rh)
        let want_resume = _has_flag(av, si + 2, "--resume")
        let r = _copy_from_run(host, ssh_opts, remote_path, local_path, want_resume)
        println("[cloud] " + r.message + " · " + host + ":" + remote_path + " -> " + local_path)
        if r.ok == 1 && _has_flag(av, si + 2, "--verify-sha") == 1 {
            let v = cloud_verify_sha(host, ssh_opts, remote_path, local_path)
            println("[cloud] verify-sha: " + v.message)
            exit(v.exit_code)
        }
        exit(r.exit_code)
    }
}
