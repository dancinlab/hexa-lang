// HEXA Standard Library — cloud/fire_shards
//
// @version 0.1.0
// @capabilities [pure-builders + 1 CLI glue]
//
// GENERIC sharded-batch dispatch — `hexa cloud fire-shards`.
//
// THE GAP THIS CLOSES. A 60-job decode batch needed to be split into N shards
// and stagger-launched as N detached background jobs on a GPU pod. There was no
// `hexa cloud` verb for "split a job list into N line-balanced shards and
// fire each shard as a detached job", so an operator hand-wrote a
// /tmp/<x>_launch.sh that did `split -d -n l/12 jobs.tsv …; for s in …; do
// setsid nohup hexa run … "$s" … & sleep 8; done`, copy-to'd it, and ran it.
// That BYPASSES hexa cloud's structured dispatch, its detach/log plumbing
// (cloud fire / cloud nohup), and its ./pods.json registration. `fire-shards`
// makes that pattern first-class: ONE copy-to of the job file + a REMOTE
// `split -n l/<N>` (mirrors how dft_fanout/fire move work onto the pod —
// remote-split beats N local copy-to's), then a single remote launcher that
// stagger-fires each shard detached via the SAME `setsid nohup … >log 2>&1 &`
// mechanism `cloud fire`/`cloud nohup` use, capturing each shard's PID. ONE
// consolidated __MONITOR_HANDLE__= (covering all shards) + ONE optional
// ./pods.json registration row are emitted by the caller (cloud_cli.hexa).
//
// PLACEHOLDER CONVENTION (in --cmd '<template>'), substituted PER shard:
//   {shard}  → the remote shard file path  (<remote-dir>/<prefix>NN)
//   {i}      → the shard index, zero-padded 2-wide (00, 01, … same width split
//              uses with `-d`), so {i} and the shard suffix line up
//   {out}    → the per-shard output path    (<remote-dir>/<prefix>NN.out)
//   {log}    → the per-shard log file path  (<remote-dir>/<prefix>NN.log)
// A template with NO {shard} is refused (a shard launcher that ignores its
// shard is a bug, not a sweep). Unknown {…} tokens are left verbatim (no
// silent drop). {{ / }} escape a literal brace.
//
// COOPERATION WITH parallel-audit (d_parallel_fire). The parallel-audit guard
// flags a SINGLE pod running 1 job while N decks sit queued idle — the
// sequential-queue anti-pattern. `fire-shards` is the LEGITIMATE structured
// way to do the parallel launch that guard tells you to do: one explicit verb
// the operator invoked fires every shard concurrently (subject to --stagger),
// so it never IS the violation, and it is the canonical remedy FOR it. It does
// not auto-fire, is never invoked behind the user's back, and emits one
// registration covering all shards (not N untracked launches).
//
// DESIGN SPLIT. The remote-bash builders here are PURE (no I/O — a test asserts
// the exact emitted script). The host-resolve + copy-to + remote-exec + Monitor
// handle + ./pods.json registration glue lives in cloud_cli.hexa, which calls
// these builders. Mirrors parallel_audit.hexa (pure verdict) + cloud_cli glue.
//
// NO `use "stdlib/cloud/cloud"`: this is a LEAF builder module — it owns its own
// POSIX quoter (_fs_shq, byte-identical to cloud.hexa::_shq) so importing it
// (incl. from its pure unit test) does NOT drag in the whole ssh/exec surface.
// cloud_cli.hexa already pulls cloud.hexa for the live glue; here purity matters
// more than the d3 single-quoter ideal (parallel_audit.hexa is likewise self-
// contained). The quoter is exercised by fire_shards_test.hexa's exact-string
// assertions, so any drift from _shq is caught.

// _fs_shq — POSIX single-quote one token (mirror of cloud.hexa::_shq). Wraps in
// single quotes and escapes any embedded single quote as '\'' — safe to embed
// in a `bash -c` string for ssh.
fn _fs_shq(s: str) -> str {
    let mut out = "'"
    let mut i = 0
    let n = len(s)
    while i < n {
        let c = s.substring(i, i + 1)
        if c == "'" {
            out = out + "'\\''"
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out + "'"
}

// ── pure builders ─────────────────────────────────────────────────────

// _fs_zpad2 — zero-pad a non-negative int to width 2 (00..99), wider for >=100.
// Matches `split -d`'s default 2-wide numeric suffix so {i} lines up with the
// shard file's suffix (shard 7 → file <prefix>07, {i} → "07").
pub fn _fs_zpad2(n: int) -> str {
    if n < 0 { return to_string(n) }
    if n < 10 { return "0" + to_string(n) }
    return to_string(n)
}

// _fs_subst — substitute the {shard}/{i}/{out}/{log} placeholders in `tmpl`.
// `{{` and `}}` are literal braces. An unrecognised `{token}` is emitted
// verbatim (braces kept) so a typo surfaces in the remote command rather than
// vanishing. Pure string transform — the heart of the per-shard command build.
pub fn _fs_subst(tmpl: str, shard: str, idx: str, out_path: str, log_path: str) -> str {
    let mut res = ""
    let n = len(tmpl)
    let mut i = 0
    while i < n {
        let c = tmpl.substring(i, i + 1)
        if c == "{" {
            // {{ escape → literal {
            if i + 1 < n && tmpl.substring(i + 1, i + 2) == "{" {
                res = res + "{"
                i = i + 2
                continue
            }
            // find the closing brace
            let mut j = i + 1
            let mut close = -1
            while j < n {
                if tmpl.substring(j, j + 1) == "}" {
                    close = j
                    j = n
                } else {
                    j = j + 1
                }
            }
            if close < 0 {
                // no closer — literal '{' and continue
                res = res + "{"
                i = i + 1
                continue
            }
            let key = tmpl.substring(i + 1, close)
            if key == "shard" {
                res = res + shard
            } else if key == "i" {
                res = res + idx
            } else if key == "out" {
                res = res + out_path
            } else if key == "log" {
                res = res + log_path
            } else {
                // unknown token — keep verbatim (braces included)
                res = res + "{" + key + "}"
            }
            i = close + 1
        } else if c == "}" {
            // }} escape → literal }
            if i + 1 < n && tmpl.substring(i + 1, i + 2) == "}" {
                res = res + "}"
                i = i + 2
                continue
            }
            res = res + "}"
            i = i + 1
        } else {
            res = res + c
            i = i + 1
        }
    }
    return res
}

// _fs_remote_split — the remote command that (1) makes <remote_dir>, (2)
// line-balanced-splits the uploaded <job_remote> into <shards> files named
// <prefix>00, <prefix>01, … under <remote_dir>. `split -d -n l/<N>` keeps whole
// lines together (no job is bisected) and uses a numeric suffix. Echoes a
// SHARD-COUNT marker so the caller can verify split produced exactly N files
// (a job file with fewer lines than shards yields fewer files — caught loudly).
pub fn _fs_remote_split(job_remote: str, remote_dir: str, prefix: str, shards: int) -> str {
    let dir_q = _fs_shq(remote_dir)
    let job_q = _fs_shq(job_remote)
    let base_q = _fs_shq(remote_dir + "/" + prefix)
    return "mkdir -p " + dir_q
        + " && split -d -n l/" + to_string(shards) + " " + job_q + " " + base_q
        + " && echo __FS_SHARDS__=$(ls " + base_q + "* 2>/dev/null | wc -l | tr -d ' ')"
}

// _fs_launch_block — the per-shard launch lines of the remote launcher: for each
// shard index 0..N-1, build the shard's command (template substituted), then
// fire it detached via `setsid nohup <cmd> </dev/null >log 2>&1 &` and capture
// its PID on a `__FS_PID__<i>=<pid>` marker line. `stagger` sleeps between
// launches (0 = no sleep). `pre` (the optional `. <source> && ` dot-source +
// `env K=V ` prefix the caller already assembled) is prepended INSIDE each
// shard's subshell so conda/PATH + env reach every shard exactly as cloud
// fire's --source/--env do. Pure — emits the bash text only.
pub fn _fs_launch_block(tmpl: str, pre: str, remote_dir: str, prefix: str, shards: int, stagger: int) -> str {
    let mut body = ""
    let mut i = 0
    while i < shards {
        let suf = _fs_zpad2(i)
        let shard_path = remote_dir + "/" + prefix + suf
        let out_path = remote_dir + "/" + prefix + suf + ".out"
        let log_path = remote_dir + "/" + prefix + suf + ".log"
        let cmd = _fs_subst(tmpl, shard_path, suf, out_path, log_path)
        // setsid → detach from the launcher's session so the shards outlive the
        // ssh channel (same intent as cloud_nohup's `nohup … &`). The launcher
        // captures each pid; the consolidated handle tracks the LAUNCHER but the
        // pids are logged so a later poll can target any single shard.
        let log_q = _fs_shq(log_path)
        body = body + "setsid bash -c " + _fs_shq(pre + cmd)
            + " </dev/null >" + log_q + " 2>&1 &\n"
        body = body + "echo __FS_PID__" + to_string(i) + "=$!\n"
        if stagger > 0 && i + 1 < shards {
            body = body + "sleep " + to_string(stagger) + "\n"
        }
        i = i + 1
    }
    return body
}

// _fs_remote_launcher — the full remote launcher script (fed to `bash -s` /
// `bash -c` by the caller): launch every shard (staggered), then echo a
// __FS_LAUNCHED__=<n> tally + a __FS_DIR__= marker so the caller can build the
// consolidated Monitor handle without re-deriving paths. The launcher itself
// returns immediately (every shard is backgrounded), so the caller's ssh call
// does not block on the batch.
pub fn _fs_remote_launcher(tmpl: str, pre: str, remote_dir: str, prefix: str, shards: int, stagger: int) -> str {
    let block = _fs_launch_block(tmpl, pre, remote_dir, prefix, shards, stagger)
    return block
        + "echo __FS_LAUNCHED__=" + to_string(shards) + "\n"
        + "echo __FS_DIR__=" + _fs_shq(remote_dir) + "\n"
}

// _fs_plan_text — PURE preview text for --dry-run (and the default $0 preview):
// the exact split command, the per-shard command lines that WOULD fire, and the
// stagger. No I/O. A test asserts this verbatim, and --dry-run prints it instead
// of touching the pod.
pub fn _fs_plan_text(host: str, job_file: str, job_remote: str, remote_dir: str, prefix: str, tmpl: str, pre: str, shards: int, stagger: int) -> str {
    let mut s = "[fire-shards] PLAN — " + to_string(shards) + " shard(s) on " + host + "\n"
    s = s + "[fire-shards] upload : " + job_file + " -> " + host + ":" + job_remote + "\n"
    s = s + "[fire-shards] split  : " + _fs_remote_split(job_remote, remote_dir, prefix, shards) + "\n"
    s = s + "[fire-shards] stagger: " + to_string(stagger) + "s between launches\n"
    let mut i = 0
    while i < shards {
        let suf = _fs_zpad2(i)
        let shard_path = remote_dir + "/" + prefix + suf
        let out_path = remote_dir + "/" + prefix + suf + ".out"
        let log_path = remote_dir + "/" + prefix + suf + ".log"
        let cmd = _fs_subst(tmpl, shard_path, suf, out_path, log_path)
        s = s + "  [shard " + suf + "] " + pre + cmd + "  (>" + log_path + ")\n"
        i = i + 1
    }
    s = s + "[fire-shards] (PLAN only — re-run without --dry-run to upload + split + fire)\n"
    return s
}
