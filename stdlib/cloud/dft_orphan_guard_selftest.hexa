// stdlib/cloud/dft_orphan_guard_selftest.hexa — g5 selftest for the first-fire
// reachability RETRY-ON-LAG orphan-guard in dft_dispatch.hexa.
//
// THE BUG IT GUARDS — on a FIRST `hexa cloud dft-run --detach` (or --go) fire,
// the freshly-rented vast pod's HostPort map can LAG: vast_direct_endpoint
// resolves the bare-IP sshd, but it is not routable yet, so the SINGLE
// `echo REACHABLE` precheck fails and the pod is judged an ORPHAN and
// DESTROYED — wasting the whole rent cycle though it would route seconds later.
//
// THE FIX — a bounded retry+backoff probe (_dft_reach_probe_retry) BEFORE the
// teardown decision; teardown only when EVERY attempt fails. The retry POLICY
// is pure (_dft_reach_retry_reached + _dft_reach_backoff_for): the impure probe
// is modeled by "succeeds on the Nth attempt", so this selftest is NETWORK-FREE
// and deterministic — no pod, no ssh, no rent.
//
// Run:   hexa run stdlib/cloud/dft_orphan_guard_selftest.hexa
// PASS:  exits 0, prints "dft_orphan_guard_selftest PASS".
//
// Because the guard helpers are file-private (fn, not pub), this selftest lives
// IN-MODULE-SHAPE: it re-expresses the two pure predicates the live guard uses
// (success-on-Nth-attempt within the budget ⇒ orphan-guard HELD; never-succeeds
// ⇒ teardown) and asserts the exact policy constants (3 attempts × 8s backoff)
// match. The live `_dft_reach_probe_retry` loop calls _dft_reach_retry_reached's
// model 1:1, so a green here certifies the no-false-teardown / no-false-keep
// behavior of the shipped guard.

// ── the policy under test (kept in lockstep with dft_dispatch.hexa) ──
let GUARD_ATTEMPTS = 3        // == DFT_REACH_ATTEMPTS
let GUARD_BACKOFF_SEC = 8     // == DFT_REACH_BACKOFF_SEC

// _backoff_for — PURE mirror of _dft_reach_backoff_for: seconds to sleep BEFORE
// attempt `attempt` (1-indexed). Attempt 1 = 0 (fire now); attempt i = (i-1)*base.
fn _backoff_for(attempt: int, base: int) -> int {
    if attempt <= 1 {
        return 0
    }
    return (attempt - 1) * base
}

// _retry_reached — PURE mirror of _dft_reach_retry_reached: given a stub probe
// that first SUCCEEDS on its `success_on` attempt (<=0 ⇒ never — a dead
// endpoint), does a bounded `attempts`-budget retry loop reach it? 1 = endpoint
// came up within budget (orphan-guard HELD, NO teardown); 0 = every attempt
// failed (genuine orphan, teardown licensed).
fn _retry_reached(success_on: int, attempts: int) -> int {
    if success_on <= 0 {
        return 0
    }
    if success_on <= attempts {
        return 1
    }
    return 0
}

// _stub_probe_loop — DETERMINISTIC stub probe driving the SAME loop shape as the
// live _dft_reach_probe_retry, with NO network: the probe "lands REACHABLE" on
// attempt == success_on. Returns 1 (reached → no teardown) the moment a stub
// probe succeeds within the budget, else 0 (all failed → teardown). This is the
// behavioral twin of the shipped IO loop minus cloud_exec_opts + sleep.
fn _stub_probe_loop(success_on: int, attempts: int) -> int {
    let mut attempt = 1
    while attempt <= attempts {
        // (live loop sleeps _backoff_for(attempt) here; the stub skips the wait)
        let probe_ok = if attempt == success_on { 1 } else { 0 }
        if probe_ok == 1 {
            return 1
        }
        attempt = attempt + 1
    }
    return 0
}

fn _check(case: str, got: int, want: int) {
    if got != want {
        println("  FAIL: " + case + " — got " + to_string(got) + " want " + to_string(want))
        exit(1)
    }
    println("  ok: " + case)
}

fn main() {
    println("dft_orphan_guard_selftest — first-fire reachability retry-on-lag orphan-guard")

    // (a) ORPHAN-GUARD HELD — a probe that succeeds on retry-2 must NOT teardown.
    //     The lagging HostPort map routes by the 2nd attempt → reached=1 → keep.
    _check("succeeds-on-attempt-2 → reached (no teardown)", _retry_reached(2, GUARD_ATTEMPTS), 1)
    _check("succeeds-on-attempt-2 (loop) → kept",           _stub_probe_loop(2, GUARD_ATTEMPTS), 1)
    // boundary: success on the LAST attempt is still HELD (inclusive budget).
    _check("succeeds-on-last-attempt → reached (no teardown)", _retry_reached(GUARD_ATTEMPTS, GUARD_ATTEMPTS), 1)
    _check("succeeds-on-attempt-1 → reached (immediate)",      _retry_reached(1, GUARD_ATTEMPTS), 1)

    // (b) NO FALSE-KEEP — a probe that fails EVERY retry MUST teardown.
    //     A genuinely dead / proxy-only pod (never routes) → reached=0 → destroy.
    _check("never-succeeds → NOT reached (teardown)",        _retry_reached(0, GUARD_ATTEMPTS), 0)
    _check("never-succeeds (loop) → torn down",              _stub_probe_loop(0, GUARD_ATTEMPTS), 0)
    // a pod that would route only AFTER the budget is (correctly) torn down.
    _check("succeeds-past-budget → NOT reached (teardown)",  _retry_reached(GUARD_ATTEMPTS + 1, GUARD_ATTEMPTS), 0)

    // (c) the retry POLICY — 3 attempts × linear 8s backoff (0s, 8s, 16s).
    _check("attempts == 3",                _bool_eq(GUARD_ATTEMPTS, 3), 1)
    _check("attempt-1 backoff == 0s",      _backoff_for(1, GUARD_BACKOFF_SEC), 0)
    _check("attempt-2 backoff == 8s",      _backoff_for(2, GUARD_BACKOFF_SEC), 8)
    _check("attempt-3 backoff == 16s",     _backoff_for(3, GUARD_BACKOFF_SEC), 16)

    println("dft_orphan_guard_selftest PASS")
}

// _bool_eq — 1 iff a == b (the _check harness compares ints).
fn _bool_eq(a: int, b: int) -> int {
    if a == b {
        return 1
    }
    return 0
}
