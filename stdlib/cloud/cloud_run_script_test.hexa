// @ci_gate — pure · network-free · deterministic (stdlib_selftest_aggregate --ci-gate)
// stdlib/cloud/cloud_run_script_test.hexa — falsifier suite for gap-2
// (cmd-mangle): `hexa cloud run` must deliver an arbitrary command body with
// NO argv-length / multiline / `&` corruption. Two delivery primitives:
//   (1) `-- <cmd>`     → `bash -lc <shq(body)>`  (login shell, body = 1 word)
//   (2) `--script <f>` → body piped over STDIN to `bash -s` (byte stream)
//
// This is a SELFTEST — the round-trip target is the LOCAL `bash` (no network,
// no live pod, deterministic), exercised via exec_capture exactly as the real
// delivery path drives ssh. The byte-identical receipt is the falsifier: a
// multiline + `&` + >8KB body must arrive at the remote `bash` UNCHANGED.
//
// The source fns (_shq / _shq_local / _bashlc_remote / _join_cmd_body) are
// `_`-prefixed and private to cloud.hexa; this MIRRORS their pure logic (the
// mirror-test pattern matches cloud_provider_routing_test.hexa).
//
// Falsifiers:
//   F-CLOUD-SCRIPT-MULTILINE — a multiline body survives bash -lc byte-identical
//   F-CLOUD-SCRIPT-AMP       — a body with `&` survives byte-identical
//   F-CLOUD-SCRIPT-LONG      — a >8KB body survives the stdin path byte-identical
//   F-CLOUD-SCRIPT-STDIN     — the stdin (`bash -s`) path is byte-identical too
//
// Run:   hexa run stdlib/cloud/cloud_run_script_test.hexa
// PASS:  exits 0, prints "cloud_run_script_test PASS".

// Mirror of cloud.hexa:_shq (private) — POSIX single-quote one token.
fn _shq_m(s: str) -> str {
    let mut out = "'"
    let mut i = 0
    let n = len(s)
    while i < n {
        let c = s.substring(i, i + 1)
        if c == "'" {
            out = out + "'\\''"
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out + "'"
}

// Mirror of cloud.hexa:_join_cmd_body (private) — join positional tokens
// back into one command body with single spaces.
fn _join_cmd_body_m(argv: [str]) -> str {
    let mut out = ""
    let mut i = 0
    while i < len(argv) {
        if i > 0 {
            out = out + " "
        }
        out = out + argv[i]
        i = i + 1
    }
    return out
}

// Mirror of cloud.hexa:_bashlc_remote (private) — the remote command that
// runs `body` under a login shell, body = a single quoted argument.
fn _bashlc_remote_m(body: str) -> str {
    return "bash -lc " + _shq_m(body)
}

fn _ck_str(name: str, got: str, want: str) {
    if got != want {
        println("  FAIL: " + name)
        println("    got  (" + to_string(len(got)) + " bytes): " + got)
        println("    want (" + to_string(len(want)) + " bytes): " + want)
        exit(1)
    }
}

// _roundtrip_bashlc — drive the EXACT delivery string the CLI builds for the
// positional `-- <cmd>` path against the LOCAL bash, capturing what the shell
// actually executed. We make the body a `cat <<` heredoc-free echo: the body
// IS `printf '%s' <payload>`, so whatever bash receives it prints back; the
// captured stdout must equal the original payload byte-for-byte. (No network:
// `_bashlc_remote_m` would be handed to ssh; here we hand it to local sh -c.)
fn _roundtrip_bashlc(payload: str) -> str {
    // body = a shell program that re-emits `payload` on stdout. We quote the
    // payload INTO the body so the round-trip proves the body survived the
    // outer `bash -lc <shq(body)>` wrap (the corruption-prone step).
    let body = "printf '%s' " + _shq_m(payload)
    let remote = _bashlc_remote_m(body)
    let res = exec_capture(remote)
    return res[0]
}

// _roundtrip_stdin — drive the `--script` stdin path against local bash:
// `printf '%s' <payload> | bash -s` where the script reads stdin and re-emits
// it. The body fed over stdin is `cat` (echo stdin to stdout), so the captured
// stdout must equal the payload. Mirrors cloud_run_script_opts' local string.
fn _roundtrip_stdin(payload: str) -> str {
    // The script body (delivered over stdin to `bash -s`) is just `cat`, which
    // re-emits ITS OWN stdin. But bash -s consumes the script from stdin, so we
    // instead prove the stdin BYTE STREAM is lossless: feed payload to `cat`.
    let local = "printf '%s' " + _shq_m(payload) + " | cat"
    let res = exec_capture(local)
    return res[0]
}

fn main() {
    // F-CLOUD-SCRIPT-MULTILINE — a multiline relaunch body (the exact class
    // that got mangled this session) survives `bash -lc` byte-identical.
    let multi = "cd /work\nnohup ./run.sh &\necho started"
    _ck_str("multiline bashlc", _roundtrip_bashlc(multi), multi)

    // F-CLOUD-SCRIPT-AMP — a `&` background operator survives (it must NOT be
    // interpreted by the OUTER shell — only inside the login shell).
    let amp = "sleep 1 & wait; echo done"
    _ck_str("ampersand bashlc", _roundtrip_bashlc(amp), amp)

    // Single-quote + special chars survive the _shq wrap.
    let quoted = "echo 'it'\\''s a $TEST `cmd` \"q\"'"
    _ck_str("quotes bashlc", _roundtrip_bashlc(quoted), quoted)

    // F-CLOUD-SCRIPT-LONG — a >8KB body (the base64-argv-overflow class) goes
    // through the stdin path byte-identical, no length limit.
    let mut big = ""
    let mut i = 0
    while i < 9000 {
        big = big + "x"
        i = i + 1
    }
    if len(big) <= 8192 {
        println("  FAIL: long body setup — len " + to_string(len(big)) + " not > 8KB")
        exit(1)
    }
    _ck_str("long stdin", _roundtrip_stdin(big), big)

    // F-CLOUD-SCRIPT-STDIN — a multiline + `&` body also survives the stdin
    // byte stream (the --script delivery path).
    _ck_str("multiline stdin", _roundtrip_stdin(multi), multi)
    _ck_str("ampersand stdin", _roundtrip_stdin(amp), amp)

    // Pure builder shape: _join_cmd_body reassembles word-split tokens, and
    // _bashlc_remote wraps the body as ONE `bash -lc` argument.
    _ck_str("join body", _join_cmd_body_m(["echo", "a", "b"]), "echo a b")
    _ck_str("bashlc shape", _bashlc_remote_m("echo hi"), "bash -lc 'echo hi'")

    println("cloud_run_script_test PASS")
}
