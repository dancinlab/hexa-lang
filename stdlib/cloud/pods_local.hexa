// stdlib/cloud/pods_local.hexa — per-project active pod/job manifest.
//
// File: ./ING.jsonl (cwd-local · per-project SSOT, NOT global). Plain JSON
//   Lines — one object per line — SHARED with harness `ing` (the "now" board:
//   work/next/pod rows). hexa OWNS the `kind:"pod"` rows and may carry rich
//   fields on them (host/jobs/status/verdict/billing/...) beyond the small set
//   harness ing reads (id/ts/provider/gpu/purpose/cost); harness ing ignores
//   unknown fields, so the file is a lossless shared SSOT. This module replaces
//   the retired per-project ./pods.json AND folds the per-pod job set onto each
//   pod row. The global pod_registry.hexa (billing/orphan) also lands on these
//   ING.jsonl pod rows, scanning sibling repos' ING.jsonl for the cross-project view.
//
// ING.jsonl pod-row schema (one line per pod, kind:"pod", keyed by `id`):
//   {"kind":"pod","id":"<pod-id>","ts":"<iso>",
//    "provider":"vast|runpod|local-pool","gpu":"-","purpose":"...","cost":"-",
//    // hexa-owned rich fields (harness ing ignores these):
//    "host":"...","registered_utc":"...","status":"...","project":"...",
//    "created_at":"...","rented_by":"...","ssh_host":"...","ssh_port":"...",
//    "ttl_sec":-1,"max_cost_usd":"","cumulative_cost_usd":"0.0",
//    "cost_per_hr_usd":"","owner_pid":-1,"last_heartbeat":"...","max_ttl_sec":-1,
//    // folded per-project dispatch jobs (was ./pods.json jobs{}):
//    "jobs":[{"job_id":"..","dir":"..","kind":"..","stage":"..","pid":N,
//             "watcher":"..","watcher_output":"..","started_utc":"..",
//             "verdict":"PENDING|PASS|FAIL|DOWN|..","verdict_utc":".."}]}
//   plus an OPTIONAL non-pod budget row this module also owns:
//     {"kind":"budget","cap":"20.00","currency":"USD"}
//
// In-memory model (UNCHANGED — the 17 pub fns below operate on this shape,
// reconstructed from / serialized to ING.jsonl by _pl_load / _pl_save):
//   { "version":"1.0", "last_updated_utc":"<iso>",
//     "pods": { "<pod-id>": {"host":"..","provider":"..", ...} },
//     "jobs": { "<job-id>": {"pod":"..","dir":"..","verdict":"..", ...} },
//     "budget"?: {"cap":"..","currency":".."} }
//
// PRESERVE-OTHER-ROWS invariant: _pl_load keeps every NON-(pod|budget) line
// (harness ing work/next, anything else) verbatim in a hidden "_passthru"
// string array on the root; _pl_save re-emits those lines untouched, then the
// pod rows hexa owns. work/next rows are NEVER clobbered.
//
// Write hardening (mirrors pool.hexa _save / stdlib/cloud/pod_registry):
//   1. atomic write — mktemp in cwd + `mv -f` rename(2)
//   2. .bak rotation — snapshot prior state before each write
//   3. last_updated_utc auto-stamp — stale detection (on the in-memory root)
//
// Concurrent writers within a single project are rare (one operator
// session per repo); we do not flock — atomic rename + .bak recovery is
// sufficient for the observed pattern. Cross-project isolation is
// structural (different cwd → different file).
//
// Public surface — called from cloud_cli.hexa `pods` / `dispatch` verbs.

use "stdlib/alloc/json"
use "stdlib/alloc/json_object"

// ── paths / time ─────────────────────────────────────────────────────

fn _pl_path() -> str {
    return "./ING.jsonl"
}

fn _pl_now_iso() -> str {
    return exec("date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null").trim()
}

fn _pl_path_exists(path: str) -> bool {
    let r = exec_capture("test -e " + path + " && echo y")
    return r[0] == "y\n"
}

fn _pl_empty() {
    return json_parse("{\"version\":\"1.0\",\"last_updated_utc\":\"\",\"pods\":{},\"jobs\":{}}")
}

// ── ING.jsonl ⟷ in-memory mapping ────────────────────────────────────
//
// The module's pub fns operate on the legacy {pods{},jobs{}} object. These
// helpers translate that to/from ING.jsonl `kind:"pod"` rows (each pod row
// carries its jobs[] inline) while preserving every other line verbatim.

// _pl_copy_str_field — copy "key" from src obj to dst obj if present + non-empty.
fn _pl_copy_str_field(src, dst, key: str) {
    let v = json_object_get_str(src, key, "")
    if len(v) > 0 { let _ = json_object_set(dst, key, v) }
}

// _pl_parse_ing — read ./ING.jsonl text, return the {pods,jobs,budget?}
// in-memory root with a "_passthru" [str] of every non-(pod|budget) line
// preserved verbatim. A `kind:"pod"` row maps to a pods{} entry
// (host/provider/registered_utc) plus its inline jobs[] flattened into jobs{}
// (each keyed by job_id, stamped with "pod":<id>). A `kind:"budget"` row →
// root.budget. work/next/etc. lines pass through untouched.
fn _pl_parse_ing(raw: str) {
    let root = _pl_empty()
    let pods = json_object_get_object(root, "pods")
    let jobs = json_object_get_object(root, "jobs")
    let mut passthru = []
    let lines = raw.split("\n")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i].trim()
        if len(ln) == 0 {
            i = i + 1
            continue
        }
        let row = json_parse(ln)
        let kind = json_object_get_str(row, "kind", "")
        if kind == "pod" {
            let pid = json_object_get_str(row, "id", "")
            if len(pid) > 0 {
                let p = json_parse("{}")
                _pl_copy_str_field(row, p, "host")
                _pl_copy_str_field(row, p, "provider")
                _pl_copy_str_field(row, p, "registered_utc")
                // Stash the FULL original pod row so _pl_emit_ing can preserve
                // every field this module does NOT own (project/purpose/ssh_host/
                // status/billing — owned by pod_registry; gpu/cost/ts — harness
                // ing). Without this, a save() here would strip the registry's
                // co-managed fields off the shared pod row (cross-module data loss).
                let _ = json_object_set(p, "_row", row)
                let _ = json_object_set(pods, pid, p)
                if json_object_has(row, "jobs") {
                    let jarr = json_object_get_array(row, "jobs")
                    let mut k = 0
                    while k < len(jarr) {
                        let jrow = jarr[k]
                        let jid = json_object_get_str(jrow, "job_id", "")
                        if len(jid) > 0 {
                            let j = json_parse("{}")
                            let _ = json_object_set(j, "pod", pid)
                            _pl_copy_str_field(jrow, j, "dir")
                            _pl_copy_str_field(jrow, j, "kind")
                            _pl_copy_str_field(jrow, j, "stage")
                            let jp = json_object_get_int(jrow, "pid", 0)
                            if jp > 0 { let _ = json_object_set(j, "pid", jp) }
                            _pl_copy_str_field(jrow, j, "watcher")
                            _pl_copy_str_field(jrow, j, "watcher_output")
                            _pl_copy_str_field(jrow, j, "started_utc")
                            _pl_copy_str_field(jrow, j, "verdict")
                            _pl_copy_str_field(jrow, j, "verdict_utc")
                            let _ = json_object_set(jobs, jid, j)
                        }
                        k = k + 1
                    }
                }
            }
        } else if kind == "budget" {
            let b = json_parse("{}")
            _pl_copy_str_field(row, b, "cap")
            _pl_copy_str_field(row, b, "currency")
            let _ = json_object_set(root, "budget", b)
        } else {
            // work / next / anything else — preserve the line verbatim.
            passthru.push(ln)
        }
        i = i + 1
    }
    let _ = json_object_set(root, "_passthru", passthru)
    return root
}

// _pl_emit_ing — serialize the in-memory {pods,jobs,budget?,_passthru} root
// back to ING.jsonl text: passthru lines first (work/next preserved verbatim),
// then one `kind:"pod"` line per pod (with its jobs[] folded back in), then an
// optional `kind:"budget"` line. Jobs whose pod has no pods{} entry get a stub
// pod row so an orphan job is never lost.
fn _pl_emit_ing(root) -> str {
    let now = _pl_now_iso()
    let mut out = ""
    // 1) preserve every non-pod/budget line verbatim.
    if json_object_has(root, "_passthru") {
        let pt = json_object_get_array(root, "_passthru")
        let mut i = 0
        while i < len(pt) {
            out = out + pt[i] + "\n"
            i = i + 1
        }
    }
    let pods = json_object_get_object(root, "pods")
    let jobs = json_object_get_object(root, "jobs")
    let job_ids = json_object_keys(jobs)
    // union of pod ids: those in pods{} plus any pod referenced by a job but
    // absent from pods{} (orphan-job's pod → stub row so the job survives).
    let mut pid_list = json_object_keys(pods)
    let mut ji = 0
    while ji < len(job_ids) {
        let jp = json_object_get_str(json_object_get(jobs, job_ids[ji]), "pod", "")
        if len(jp) > 0 && !json_object_has(pods, jp) {
            if _pl_str_in(pid_list, jp) == 0 { pid_list.push(jp) }
        }
        ji = ji + 1
    }
    // 2) one pod line per id.
    let mut pi = 0
    while pi < len(pid_list) {
        let pid = pid_list[pi]
        // Start from the FULL preserved original row (keeps every co-managed
        // field: pod_registry's project/purpose/ssh/status/billing + harness
        // ing's gpu/cost), then overlay this module's owned fields. A brand-new
        // pod (no preserved row) starts empty.
        let mut row = json_parse("{}")
        if json_object_has(pods, pid) {
            let p = json_object_get(pods, pid)
            if json_object_has(p, "_row") {
                row = json_object_get(p, "_row")
                let _ = json_object_delete(row, "jobs")  // re-folded fresh below
            }
        }
        let _ = json_object_set(row, "kind", "pod")
        let _ = json_object_set(row, "id", pid)
        let _ = json_object_set(row, "ts", now)
        if json_object_has(pods, pid) {
            let p = json_object_get(pods, pid)
            _pl_copy_str_field(p, row, "host")
            _pl_copy_str_field(p, row, "provider")
            _pl_copy_str_field(p, row, "registered_utc")
        }
        // fold this pod's jobs back into a jobs[] array.
        let jarr = json_parse("[]")
        let mut jk = 0
        while jk < len(job_ids) {
            let jid = job_ids[jk]
            let j = json_object_get(jobs, jid)
            if json_object_get_str(j, "pod", "") == pid {
                let jrow = json_parse("{}")
                let _ = json_object_set(jrow, "job_id", jid)
                _pl_copy_str_field(j, jrow, "dir")
                _pl_copy_str_field(j, jrow, "kind")
                _pl_copy_str_field(j, jrow, "stage")
                let jp = json_object_get_int(j, "pid", 0)
                if jp > 0 { let _ = json_object_set(jrow, "pid", jp) }
                _pl_copy_str_field(j, jrow, "watcher")
                _pl_copy_str_field(j, jrow, "watcher_output")
                _pl_copy_str_field(j, jrow, "started_utc")
                _pl_copy_str_field(j, jrow, "verdict")
                _pl_copy_str_field(j, jrow, "verdict_utc")
                json_array_push(jarr, jrow)
            }
            jk = jk + 1
        }
        let _ = json_object_set(row, "jobs", jarr)
        out = out + json_stringify_value(row) + "\n"
        pi = pi + 1
    }
    // 3) optional budget line.
    if json_object_has(root, "budget") {
        let b = json_object_get_object(root, "budget")
        let brow = json_parse("{}")
        let _ = json_object_set(brow, "kind", "budget")
        _pl_copy_str_field(b, brow, "cap")
        _pl_copy_str_field(b, brow, "currency")
        out = out + json_stringify_value(brow) + "\n"
    }
    return out
}

// ── load / save ──────────────────────────────────────────────────────

fn _pl_load() {
    let path = _pl_path()
    if !_pl_path_exists(path) { return _pl_empty() }
    let raw = read_file(path)
    if len(raw.trim()) == 0 {
        let bak = path + ".bak"
        if _pl_path_exists(bak) {
            let braw = read_file(bak)
            if len(braw.trim()) > 0 { return _pl_parse_ing(braw) }
        }
        return _pl_empty()
    }
    return _pl_parse_ing(raw)
}

fn _pl_save(root) {
    let path = _pl_path()
    let _ = json_object_set(root, "last_updated_utc", _pl_now_iso())
    let body = _pl_emit_ing(root)
    if _pl_path_exists(path) {
        let _ = exec_capture("cp -p " + path + " " + path + ".bak")
    }
    // mktemp in cwd (same fs as target → atomic rename(2))
    let tr = exec_capture("mktemp ./ING.jsonl.XXXXXX")
    let tmp = tr[0].trim()
    write_file(tmp, body)
    let _ = exec_capture("mv -f " + tmp + " " + path)
}

// ── string formatting helpers (local, ASCII-only widths) ─────────────

fn _pl_pad(s: str, n: int) -> str {
    let mut r = s
    while len(r) < n { r = r + " " }
    return r
}

// ── verb runners (called from cloud_cli.hexa) ────────────────────────

// pods_local_print_table — RAW manifest table (NO provider join): the
// `cloud dispatch` / `cloud dispatch active` editor view (filter_pending =
// PENDING only). `cloud pods` now goes through pods_local_print_table_live
// (provider-API liveness join) — this raw form is the manifest-only surface
// dispatch's add/verdict/rm editing flow renders against. Returns 0.
pub fn pods_local_print_table(filter_pending: bool) -> int {
    let root = _pl_load()
    let pods = json_object_get_object(root, "pods")
    let jobs = json_object_get_object(root, "jobs")
    let job_ids = json_object_keys(jobs)
    let pod_ids = json_object_keys(pods)
    let ts_raw = json_object_get_str(root, "last_updated_utc", "")
    let mut ts = ts_raw
    if len(ts_raw) == 0 { ts = "—" }
    let mut suffix = ""
    if filter_pending { suffix = "  (active = verdict=PENDING)" }
    println("cloud pods (./ING.jsonl · last_updated " + ts + ")" + suffix)
    println("  pods=" + str(len(pod_ids)) + "   jobs=" + str(len(job_ids)))
    if len(job_ids) == 0 { return 0 }

    let mut wid = 6
    let mut wpod = 3
    let mut wkind = 4
    let mut wstage = 5
    let mut wver = 7
    let mut i = 0
    while i < len(job_ids) {
        let jid = job_ids[i]
        let j = json_object_get(jobs, jid)
        if len(jid) > wid { wid = len(jid) }
        let p = json_object_get_str(j, "pod", "-")
        if len(p) > wpod { wpod = len(p) }
        let k = json_object_get_str(j, "kind", "-")
        if len(k) > wkind { wkind = len(k) }
        let s = json_object_get_str(j, "stage", "-")
        if len(s) > wstage { wstage = len(s) }
        let v = json_object_get_str(j, "verdict", "PENDING")
        if len(v) > wver { wver = len(v) }
        i = i + 1
    }
    println("  " + _pl_pad("job-id", wid) + "  " + _pl_pad("pod", wpod) + "  " + _pl_pad("kind", wkind) + "  " + _pl_pad("stage", wstage) + "  " + _pl_pad("verdict", wver) + "  dir")
    i = 0
    while i < len(job_ids) {
        let jid = job_ids[i]
        let j = json_object_get(jobs, jid)
        let v = json_object_get_str(j, "verdict", "PENDING")
        if !(filter_pending && v != "PENDING") {
            let p = json_object_get_str(j, "pod", "-")
            let k = json_object_get_str(j, "kind", "-")
            let s = json_object_get_str(j, "stage", "-")
            let d = json_object_get_str(j, "dir", "-")
            println("  " + _pl_pad(jid, wid) + "  " + _pl_pad(p, wpod) + "  " + _pl_pad(k, wkind) + "  " + _pl_pad(s, wstage) + "  " + _pl_pad(v, wver) + "  " + d)
        }
        i = i + 1
    }
    return 0
}

// pods_local_print_table_live — `cloud pods` with PROVIDER-API liveness join
// (anima phantom-pod fix). Renders ONLY jobs whose pinned pod the provider
// actually reports (RUNNING/UNKNOWN/NO-POD), DROPPING the GONE phantoms whose
// pod the provider has reclaimed — unless `show_all` is 1 (then GONE rows are
// shown flagged, for forensics). A `live` column carries the real provider
// state; the local `stage` is LEFT-JOIN metadata only, never the liveness
// source of truth.
//
//   alive_ids  — merged provider-alive pod/instance ids (caller-resolved:
//                runpod myself.pods + vast show instances).
//   provider_ok — 1 iff the caller reached >=1 provider (empty alive_ids then
//                means a trustworthy "none"); 0 iff BOTH degraded → liveness
//                is UNKNOWN for every pinned pod (we DON'T hide rows then —
//                hiding on a blind probe would mimic the old phantom bug in
//                reverse, vanishing real pods we just couldn't see).
//
// Returns 0.
pub fn pods_local_print_table_live(filter_pending: bool, runpod_ok: int, vast_ok: int, alive_ids, show_all: int) -> int {
    let root = _pl_load()
    let pods = json_object_get_object(root, "pods")
    let jobs = json_object_get_object(root, "jobs")
    let job_ids = json_object_keys(jobs)
    let pod_ids = json_object_keys(pods)
    let ts_raw = json_object_get_str(root, "last_updated_utc", "")
    let mut ts = ts_raw
    if len(ts_raw) == 0 { ts = "—" }
    let mut suffix = ""
    if filter_pending { suffix = "  (active = verdict=PENDING)" }
    // Merged liveness for the header only; per-row GONE judgement gates on the
    // OWNING provider's flag below (a degraded provider must not GONE its pods).
    let mut any_ok = 0
    if runpod_ok == 1 || vast_ok == 1 { any_ok = 1 }
    let mut src = "PROVIDER-API liveness (runpod myself.pods + vast)"
    if any_ok == 0 {
        src = "PROVIDER UNREACHABLE — liveness UNKNOWN, showing all (NOT confirmed alive)"
    } else if runpod_ok == 0 {
        src = "PROVIDER-API liveness — vast only (runpod degraded → its pods UNVERIFIED, not GONE)"
    } else if vast_ok == 0 {
        src = "PROVIDER-API liveness — runpod only (vast degraded → its pods UNVERIFIED, not GONE)"
    }
    println("cloud pods (" + src + " · ./ING.jsonl meta · last_updated " + ts + ")" + suffix)

    // Decide row visibility + the live-state per job up front so we can both
    // size columns to the SHOWN rows and report the hidden-phantom count.
    let mut show = []
    let mut live = []
    let mut hidden_gone = 0
    let mut i = 0
    while i < len(job_ids) {
        let jid = job_ids[i]
        let j = json_object_get(jobs, jid)
        let p = json_object_get_str(j, "pod", "-")
        let v = json_object_get_str(j, "verdict", "PENDING")
        // Resolve provider-liveness flags here (array membership stays out of
        // the pure classifier's signature), then classify.
        let mut has_pod = 1
        if len(p) == 0 { has_pod = 0 }
        if p == "-" { has_pod = 0 }
        let mut in_alive = 0
        if has_pod == 1 {
            if _pl_str_in(alive_ids, p) == 1 { in_alive = 1 }
        }
        // Gate GONE on the OWNING provider's authority, not the merged flag:
        // a runpod pod is only GONE if runpod ANSWERED (runpod_ok==1) and the
        // pod is absent; if runpod degraded it is UNKNOWN, never GONE (g63).
        // Pods with no/unknown provider field fall back to "any provider
        // answered" (legacy back-compat — no behavior change for old rows).
        let mut row_ok = any_ok
        if has_pod == 1 {
            let pod_entry = json_object_get(pods, p)
            let prov = json_object_get_str(pod_entry, "provider", "")
            if prov == "runpod" { row_ok = runpod_ok }
            else if prov == "vast" { row_ok = vast_ok }
        }
        let st = pods_local_job_live_state(has_pod, in_alive, row_ok)
        let mut vis = 1
        if filter_pending && v != "PENDING" { vis = 0 }
        // Default view DROPS provider-confirmed-GONE phantoms; --all keeps them.
        if st == "GONE" && show_all == 0 {
            vis = 0
            hidden_gone = hidden_gone + 1
        }
        if vis == 1 {
            show.push(jid)
            live.push(st)
        }
        i = i + 1
    }

    let mut live_running = 0
    let mut lr = 0
    while lr < len(live) {
        if live[lr] == "RUNNING" { live_running = live_running + 1 }
        lr = lr + 1
    }
    println("  jobs-shown=" + str(len(show)) + " (RUNNING=" + str(live_running)
        + ")   provider-gone-hidden=" + str(hidden_gone) + "   pods-meta=" + str(len(pod_ids)))
    if len(show) == 0 {
        if hidden_gone > 0 {
            println("  (all " + str(hidden_gone) + " tracked job(s) pin pods the provider reports GONE — `--all` to list them)")
        }
        return 0
    }

    let mut wid = 6
    let mut wpod = 3
    let mut wlive = 4
    let mut wkind = 4
    let mut wstage = 5
    let mut wver = 7
    let mut a = 0
    while a < len(show) {
        let jid = show[a]
        let j = json_object_get(jobs, jid)
        if len(jid) > wid { wid = len(jid) }
        let p = json_object_get_str(j, "pod", "-")
        if len(p) > wpod { wpod = len(p) }
        if len(live[a]) > wlive { wlive = len(live[a]) }
        let k = json_object_get_str(j, "kind", "-")
        if len(k) > wkind { wkind = len(k) }
        let s = json_object_get_str(j, "stage", "-")
        if len(s) > wstage { wstage = len(s) }
        let v = json_object_get_str(j, "verdict", "PENDING")
        if len(v) > wver { wver = len(v) }
        a = a + 1
    }
    println("  " + _pl_pad("job-id", wid) + "  " + _pl_pad("pod", wpod) + "  " + _pl_pad("live", wlive) + "  " + _pl_pad("kind", wkind) + "  " + _pl_pad("stage", wstage) + "  " + _pl_pad("verdict", wver) + "  dir")
    a = 0
    while a < len(show) {
        let jid = show[a]
        let j = json_object_get(jobs, jid)
        let p = json_object_get_str(j, "pod", "-")
        let k = json_object_get_str(j, "kind", "-")
        let s = json_object_get_str(j, "stage", "-")
        let d = json_object_get_str(j, "dir", "-")
        let v = json_object_get_str(j, "verdict", "PENDING")
        println("  " + _pl_pad(jid, wid) + "  " + _pl_pad(p, wpod) + "  " + _pl_pad(live[a], wlive) + "  " + _pl_pad(k, wkind) + "  " + _pl_pad(s, wstage) + "  " + _pl_pad(v, wver) + "  " + d)
        a = a + 1
    }
    return 0
}

// pods_local_tree — `cloud dispatch tree`: pod-grouped ASCII (orphan jobs
// at the tail under their own section).
pub fn pods_local_tree() -> int {
    let root = _pl_load()
    let pods = json_object_get_object(root, "pods")
    let jobs = json_object_get_object(root, "jobs")
    let pod_ids = json_object_keys(pods)
    let job_ids = json_object_keys(jobs)
    let ts_raw = json_object_get_str(root, "last_updated_utc", "")
    let mut ts = ts_raw
    if len(ts_raw) == 0 { ts = "—" }
    println("cloud pods tree (./ING.jsonl · " + ts + ")")
    if len(pod_ids) == 0 && len(job_ids) == 0 {
        println("  (empty)")
        return 0
    }
    let mut pi = 0
    while pi < len(pod_ids) {
        let pid = pod_ids[pi]
        let pod = json_object_get(pods, pid)
        let host = json_object_get_str(pod, "host", "-")
        let provider = json_object_get_str(pod, "provider", "-")
        println("├── pod " + pid + " · " + provider + " · " + host)
        let mut ji = 0
        while ji < len(job_ids) {
            let jid = job_ids[ji]
            let j = json_object_get(jobs, jid)
            if json_object_get_str(j, "pod", "") == pid {
                let v = json_object_get_str(j, "verdict", "PENDING")
                let k = json_object_get_str(j, "kind", "-")
                let s = json_object_get_str(j, "stage", "-")
                println("│   ├── " + jid + " · " + k + "/" + s + " [" + v + "]")
            }
            ji = ji + 1
        }
        pi = pi + 1
    }
    let mut printed_orphan = false
    let mut ji = 0
    while ji < len(job_ids) {
        let jid = job_ids[ji]
        let j = json_object_get(jobs, jid)
        let p = json_object_get_str(j, "pod", "")
        if len(p) == 0 || !json_object_has(pods, p) {
            if !printed_orphan {
                println("└── (orphan jobs — pod-id not in pods map)")
                printed_orphan = true
            }
            let v = json_object_get_str(j, "verdict", "PENDING")
            let k = json_object_get_str(j, "kind", "-")
            let s = json_object_get_str(j, "stage", "-")
            println("    ├── " + jid + " · pod=" + p + " · " + k + "/" + s + " [" + v + "]")
        }
        ji = ji + 1
    }
    return 0
}

// pods_local_add — `cloud dispatch add <job-id> <pod-id> <dir> [--host=H
// --provider=P --kind=K --stage=S --pid=N --watcher=W --watcher-output=P
// --verdict=V]`. Job entry is OVERWRITTEN (update-form); use verdict for
// in-place verdict-only edits. Auto-stubs pod entry on first reference.
// `av` is the full argv from main(); `idx` is the position of the first
// positional argument (job-id).
pub fn pods_local_add(av, idx: int) -> int {
    if idx + 2 >= len(av) {
        println("usage: cloud dispatch add <job-id> <pod-id> <dir> [--host=H --provider=P --kind=K --stage=S --pid=N --watcher=W --watcher-output=P --verdict=V]")
        return 2
    }
    let jid = av[idx]
    let pid = av[idx + 1]
    let dir = av[idx + 2]
    let mut host = ""
    let mut provider = ""
    let mut kind = ""
    let mut stage = ""
    let mut pid_n = 0
    let mut watcher = ""
    let mut woutput = ""
    let mut verdict = "PENDING"
    let mut i = idx + 3
    while i < len(av) {
        let a = av[i]
        if a.starts_with("--host=") { host = a.substring(7, len(a)) }
        if a.starts_with("--provider=") { provider = a.substring(11, len(a)) }
        if a.starts_with("--kind=") { kind = a.substring(7, len(a)) }
        if a.starts_with("--stage=") { stage = a.substring(8, len(a)) }
        if a.starts_with("--pid=") { pid_n = to_int(a.substring(6, len(a))) }
        if a.starts_with("--watcher=") { watcher = a.substring(10, len(a)) }
        if a.starts_with("--watcher-output=") { woutput = a.substring(17, len(a)) }
        if a.starts_with("--verdict=") { verdict = a.substring(10, len(a)) }
        i = i + 1
    }
    let root = _pl_load()
    let pods = json_object_get_object(root, "pods")
    if !json_object_has(pods, pid) {
        let p = json_parse("{}")
        if len(host) > 0 { let _ = json_object_set(p, "host", host) }
        if len(provider) > 0 { let _ = json_object_set(p, "provider", provider) }
        let _ = json_object_set(p, "registered_utc", _pl_now_iso())
        let _ = json_object_set(pods, pid, p)
    } else {
        let p = json_object_get(pods, pid)
        if len(host) > 0 { let _ = json_object_set(p, "host", host) }
        if len(provider) > 0 { let _ = json_object_set(p, "provider", provider) }
    }
    let jobs = json_object_get_object(root, "jobs")
    let j = json_parse("{}")
    let _ = json_object_set(j, "pod", pid)
    let _ = json_object_set(j, "dir", dir)
    if len(kind) > 0 { let _ = json_object_set(j, "kind", kind) }
    if len(stage) > 0 { let _ = json_object_set(j, "stage", stage) }
    if pid_n > 0 { let _ = json_object_set(j, "pid", pid_n) }
    if len(watcher) > 0 { let _ = json_object_set(j, "watcher", watcher) }
    if len(woutput) > 0 { let _ = json_object_set(j, "watcher_output", woutput) }
    let _ = json_object_set(j, "started_utc", _pl_now_iso())
    let _ = json_object_set(j, "verdict", verdict)
    let _ = json_object_set(jobs, jid, j)
    _pl_save(root)
    println("dispatch: " + jid + " → pod " + pid + " [" + verdict + "]")
    return 0
}

// pods_local_verdict — `cloud dispatch verdict <job-id> <status>`: rewrite
// only the verdict + verdict_utc fields, preserving everything else.
pub fn pods_local_verdict(jid: str, status: str) -> int {
    let root = _pl_load()
    let jobs = json_object_get_object(root, "jobs")
    if !json_object_has(jobs, jid) {
        println("dispatch: no such job: " + jid)
        return 1
    }
    let j = json_object_get(jobs, jid)
    let prev = json_object_get_str(j, "verdict", "PENDING")
    let _ = json_object_set(j, "verdict", status)
    let _ = json_object_set(j, "verdict_utc", _pl_now_iso())
    _pl_save(root)
    println("dispatch: " + jid + " · " + prev + " → " + status)
    return 0
}

// pods_local_rm — `cloud dispatch rm <target>`: deletes a job (first
// match) or a pod (refuses if jobs are still pinned to it — caller must
// `rm` those first or flip their verdict).
pub fn pods_local_rm(target: str) -> int {
    let root = _pl_load()
    let jobs = json_object_get_object(root, "jobs")
    if json_object_has(jobs, target) {
        let _ = json_object_delete(jobs, target)
        _pl_save(root)
        println("dispatch: removed job " + target)
        return 0
    }
    let pods = json_object_get_object(root, "pods")
    if !json_object_has(pods, target) {
        println("dispatch: no such job or pod: " + target)
        return 1
    }
    let job_ids = json_object_keys(jobs)
    let mut i = 0
    while i < len(job_ids) {
        let j = json_object_get(jobs, job_ids[i])
        if json_object_get_str(j, "pod", "") == target {
            println("dispatch: refusing to rm pod '" + target + "' — job '" + job_ids[i] + "' still pinned to it (rm jobs first or set their verdict to DOWN)")
            return 1
        }
        i = i + 1
    }
    let _ = json_object_delete(pods, target)
    _pl_save(root)
    println("dispatch: removed pod " + target)
    return 0
}

// ── budget cap (optional top-level `budget` object) ───────────────────
//
// Schema extension (additive, optional): a project can declare a spend
// ceiling in ./pods.json so the watchdog has a per-project budget to honor:
//   { ..., "budget": { "cap": "20.00", "currency": "USD" } }
// `cloud watchdog` cross-refs this cap (Q4): on breach it alerts + kills the
// lowest-value running pod. Absent budget object → "" (no cap, watchdog
// budget guard inert — only the idle classifier fires).

// pods_local_budget_cap_usd — read the project's spend cap from ./pods.json's
// optional top-level `budget.cap`. Returns "" when no budget object / cap is
// declared (budget guard inert). The value is returned verbatim (a USD
// string like "20.00") so the caller parses it with its own cents helper.
pub fn pods_local_budget_cap_usd() -> str {
    let root = _pl_load()
    if !json_object_has(root, "budget") {
        return ""
    }
    let b = json_object_get_object(root, "budget")
    return json_object_get_str(b, "cap", "")
}

// pods_local_dispatch — `cloud dispatch [tree|active|add|verdict|rm] ...`
// sub-router. Bare `cloud dispatch` renders the full table (same as
// `cloud pods`).
pub fn pods_local_dispatch(av, idx: int) -> int {
    if idx >= len(av) {
        return pods_local_print_table(false)
    }
    let sub = av[idx]
    if sub == "tree" { return pods_local_tree() }
    if sub == "active" { return pods_local_print_table(true) }
    if sub == "add" { return pods_local_add(av, idx + 1) }
    if sub == "verdict" {
        if idx + 2 >= len(av) {
            println("usage: cloud dispatch verdict <job-id> <status>")
            return 2
        }
        return pods_local_verdict(av[idx + 1], av[idx + 2])
    }
    if sub == "rm" {
        if idx + 1 >= len(av) {
            println("usage: cloud dispatch rm <job-id|pod-id>")
            return 2
        }
        return pods_local_rm(av[idx + 1])
    }
    println("usage: cloud dispatch [tree|active|add|verdict|rm] ...")
    println("       cloud dispatch                  # full table (same as `cloud pods`)")
    return 2
}

// ── idle-orphan reconcile (billing-pod ⟂ manifest-job set-diff) ──────────
// `cloud reap` finds provider pods ABSENT from the M5 registry. These find the
// complementary leak: a provider pod that IS billing but has NO ACTIVE
// (verdict=PENDING) job pinned in ./pods.json — the dup-idle-pod class
// (re-fired deck orphaned the old pod, 2026-06-01).

// _pl_str_in — PURE: 1 iff `needle` appears in the `[str]` list.
fn _pl_str_in(xs, needle: str) -> int {
    let mut i = 0
    while i < len(xs) {
        if xs[i] == needle { return 1 }
        i = i + 1
    }
    return 0
}

// pods_local_active_pod_ids — pod ids with >=1 ACTIVE (verdict=PENDING) job in
// ./pods.json. A pod whose jobs are all terminal (PASS/FAIL) is NOT active → a
// reclaim candidate if still billing.
pub fn pods_local_active_pod_ids() -> [str] {
    let root = _pl_load()
    let jobs = json_object_get_object(root, "jobs")
    let job_ids = json_object_keys(jobs)
    let mut active = []
    let mut i = 0
    while i < len(job_ids) {
        let j = json_object_get(jobs, job_ids[i])
        let v = json_object_get_str(j, "verdict", "PENDING")
        let p = json_object_get_str(j, "pod", "")
        if v == "PENDING" && len(p) > 0 {
            if _pl_str_in(active, p) == 0 { active.push(p) }
        }
        i = i + 1
    }
    return active
}

// pods_local_idle_orphans — PURE set-difference billing_ids − active_ids: a
// billing id with NO active job pinned is an idle-orphan (reclaim candidate).
pub fn pods_local_idle_orphans(billing_ids, active_ids) -> [str] {
    let mut orphans = []
    let mut i = 0
    while i < len(billing_ids) {
        let id = billing_ids[i]
        if _pl_str_in(active_ids, id) == 0 {
            if _pl_str_in(orphans, id) == 0 { orphans.push(id) }
        }
        i = i + 1
    }
    return orphans
}

// ── deck-state instance ids (LIVE endpoint truth, beyond job.pod) ────────
// idle-reap's active set used ONLY ./pods.json jobs' `pod` field. But a deck's
// LIVE endpoint is recorded in <workdir>/.dft_detach.state (`instance_id=`).
// When job.pod drifts stale (re-fires re-point the real instance), the set-diff
// false-flags LIVE pods as orphans (19 mis-flagged, 2026-06-01). The active set
// must ALSO include every instance_id found in the campaign's deck state files.

// pods_local_state_instance_id — PURE: extract the `instance_id=` value from a
// `.dft_detach.state` blob (KEY=VALUE lines). "" when absent. Network-free so
// the classifier stays unit-testable; the file read is the caller's concern.
pub fn pods_local_state_instance_id(raw: str) -> str {
    let lines = raw.split("\n")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i]
        if len(ln) >= 12 && ln.substring(0, 12) == "instance_id=" {
            return ln.substring(12, len(ln)).trim()
        }
        i = i + 1
    }
    return ""
}

// pods_local_state_active_ids — scan jobs' workdir `.dft_detach.state` files PLUS
// the conventional exports/**/.dft_detach.state tree for live instance_ids. The
// union with pods_local_active_pod_ids() is the robust active set idle-reap must
// diff against. Best-effort: a missing/unreadable state file contributes nothing.
pub fn pods_local_state_active_ids() -> [str] {
    let mut ids = []
    // jobs' own workdir state files (dir field → <dir>/.dft_detach.state).
    let root = _pl_load()
    let jobs = json_object_get_object(root, "jobs")
    let job_ids = json_object_keys(jobs)
    let mut ji = 0
    while ji < len(job_ids) {
        let j = json_object_get(jobs, job_ids[ji])
        let d = json_object_get_str(j, "dir", "")
        if len(d) > 0 {
            let sp = d + "/.dft_detach.state"
            if _pl_path_exists(sp) {
                let iid = pods_local_state_instance_id(read_file(sp))
                if len(iid) > 0 && _pl_str_in(ids, iid) == 0 { ids.push(iid) }
            }
        }
        ji = ji + 1
    }
    // conventional campaign tree — every exports/**/.dft_detach.state file.
    let found = exec("find exports -name .dft_detach.state 2>/dev/null").trim()
    if len(found) > 0 {
        let paths = found.split("\n")
        let mut pi = 0
        while pi < len(paths) {
            let sp = paths[pi].trim()
            if len(sp) > 0 && _pl_path_exists(sp) {
                let iid = pods_local_state_instance_id(read_file(sp))
                if len(iid) > 0 && _pl_str_in(ids, iid) == 0 { ids.push(iid) }
            }
            pi = pi + 1
        }
    }
    return ids
}

// pods_local_merge_ids — PURE union of two id lists (dedup, order-preserving).
pub fn pods_local_merge_ids(a, b) -> [str] {
    let mut out = []
    let mut i = 0
    while i < len(a) { if _pl_str_in(out, a[i]) == 0 { out.push(a[i]) } i = i + 1 }
    let mut j = 0
    while j < len(b) { if _pl_str_in(out, b[j]) == 0 { out.push(b[j]) } j = j + 1 }
    return out
}

// ── idle-reap 3-way classifier (active / idle-dead / busy-unmanifested) ──
// "idle-reap" never checked idleness — it flagged purely on manifest-absence, so
// a pod ABSENT from the manifest but BUSY (running pw.x/ph.x) got flagged and
// --reap would destroy a running DFT job (instance 38815600, procs=13 busy,
// 2026-06-01). A pod is REAP-eligible ONLY when it is NOT active AND verified
// idle (unreachable, OR reachable with zero compute procs). A not-active pod
// that is reachable+busy is a LIVE DUPLICATE — surface separately, NEVER reap.
//
// `busy` is the tri-value liveness probe: 1 = reachable+compute-proc-present,
// 0 = reachable+no-compute-proc (idle), -1 = probe-undetermined (fail safe).
//
// Returns "REAP" | "BUSY_UNMANIFESTED". Active pods never reach the classifier.
pub fn idle_reap_classify(reachable: int, busy: int) -> str {
    // unreachable → dead/stale billing pod → safe to reclaim.
    if reachable == 0 { return "REAP" }
    // reachable but a compute proc is running (or probe undetermined) → live
    // duplicate, NEVER reap. busy==-1 (probe could not confirm idle) fails safe.
    if busy != 0 { return "BUSY_UNMANIFESTED" }
    // reachable AND verified zero compute procs → genuinely idle → reclaim.
    return "REAP"
}

// idle_reap_classify_status — handoff d1410e5b. The ssh-only classifier above
// fails SAFE on an undetermined probe (busy==-1 → BUSY_UNMANIFESTED, never
// reaped). That is correct when the probe is the ONLY signal, but it strands a
// pod whose provider STATUS is unambiguously dead: vast inst 38711598 reported
// actual_status=exited yet its proxy ssh was refused (busy==-1), so it was
// mis-held as BUSY-UNMANIFESTED forever and lingered billing until a manual
// `hexa cloud down`. status=exited/stopped (vast actual_status) and the GONE/
// stopped runpod desiredStatus are UNAMBIGUOUS — they license a REAP regardless
// of what the ssh probe could (not) tell us.
//
// `status` is the live PROVIDER-API state from _alive_probe (alive.hexa):
//   "STOPPED" | "GONE"               → REAP   (provider says the pod is dead —
//                                       exited/stopped/terminated/reclaimed;
//                                       authoritative over an ambiguous probe).
//   "RUNNING" | "UNKNOWN" | "" |     → fall through to the ssh-only classifier
//   "MISSING-CRED"                     (NO behaviour change — a RUNNING provider
//                                       state with a busy proc is still BUSY,
//                                       and an UNKNOWN/cred-less status NEVER
//                                       upgrades a fail-safe HOLD to a reap; @L4
//                                       g63 — a degraded provider query must not
//                                       tear down real compute).
// This is purely ADDITIVE safety: it can only convert a previously-stranded
// BUSY_UNMANIFESTED into a REAP when the provider POSITIVELY reports dead; it
// never makes a RUNNING/UNKNOWN pod more reapable. Returns "REAP" |
// "BUSY_UNMANIFESTED" (same domain as idle_reap_classify). PURE — string status
// in, so the selftest injects fixtures with no network.
pub fn idle_reap_classify_status(reachable: int, busy: int, status: str) -> str {
    // provider POSITIVELY dead → reap regardless of the ssh probe ambiguity.
    if status == "STOPPED" { return "REAP" }
    if status == "GONE" { return "REAP" }
    // RUNNING / UNKNOWN / MISSING-CRED / "" → defer to the ssh-only discipline
    // (fail-safe HOLD on an undetermined probe is preserved).
    return idle_reap_classify(reachable, busy)
}

// pods_local_job_live_state — PURE provider-liveness classifier (the `cloud
// pods` phantom-pod fix). Closed-form int inputs mirror idle_reap_classify so
// the caller resolves pod-id membership against the provider-alive set and
// passes the flags in. has_pod=1 iff the job pins a real pod; in_alive=1 iff
// that pod is in the provider-alive set; provider_ok=1 iff the caller reached
// at least one provider (so in_alive==0 + ok==1 is a TRUSTWORTHY GONE), 0 iff
// both provider queries degraded → never assert GONE, return UNKNOWN (g63).
pub fn pods_local_job_live_state(has_pod: int, in_alive: int, provider_ok: int) -> str {
    if has_pod == 0 { return "NO-POD" }
    if in_alive == 1 { return "RUNNING" }
    if provider_ok == 0 { return "UNKNOWN" }
    return "GONE"
}
