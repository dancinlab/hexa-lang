// stdlib/cloud/pod_registry.hexa — minimal persistent pod registry (MVP).
//
// `hexa cloud` is the single gateway through which pods get dispatched, but
// before this module the only trace of a launched pod was the volatile state
// of the launching shell (dispatch.log + an attached Monitor). A reboot / new
// session / different machine lost that handle entirely → the pod became an
// ORPHAN: still billing, results unrecoverable, no poll/pull handle. See
// archive/patches/hexa-cloud-pod-registry-tracking-2026-05-24.md for the
// incident (7× A100 @ $10.43/h with zero local trace after a reboot).
//
// This MVP is the minimal SSOT it asks for: an append-only JSONL file at
// $HOME/.hexa-cloud/pods.jsonl, a single write helper the `run`/`nohup` verbs
// call, and a `cloud orphans` read verb that lists tracked pods and flags
// stale ones. Provider provisioning (rent/destroy) is DEFERRED to RFC 088
// P-series — this registry only tracks pods that get launched/used, it does
// not create them. runpod_list_pods() cross-reconcile is a documented BONUS,
// landed below (reconcile/adopt/forget) as the PR #761 follow-up.

use "stdlib/cloud/runpod"
use "stdlib/cloud/vast"
use "stdlib/alloc/json"
use "stdlib/alloc/json_object"

// ── paths (ING.jsonl SSOT — retires ~/.hexa-cloud/pods.jsonl + ~/.hx/cloud/active-pods.json) ──
//
// The pod registry no longer lives in a global file. Pods are tracked in each
// project's `./ING.jsonl` `kind:"pod"` rows (the SAME rows pods_local.hexa +
// harness `ing` share). The GLOBAL cross-project billing/orphan view is
// reconstructed by SCANNING every sibling project's ING.jsonl under
// $HOME/dancinlab (the orphan-defense that survived the 7×A100 reboot incident
// — see header below — now spans repos by union, not one central file).
//
// A pod's HOME file = its owning project's ING.jsonl (`<root>/<project>/ING.jsonl`
// when that repo exists), else the cwd `./ING.jsonl` (the renting project).

use "stdlib/cloud/pods_local"

// _reg_sandbox — a test-isolation root override. "" in normal operation. Set
// by EITHER the HEXA_CLOUD_ING_ROOT env (the canonical hermetic knob) OR — since
// the runtime's setenv() is a no-op, so an in-process test cannot export an env
// — a `./.hexa-cloud-ing-sandbox` sentinel FILE whose first line is the sandbox
// dir. When sandboxed, BOTH the sibling-scan root AND the cwd-fallback live
// under the sandbox, so a test (or any caller) NEVER touches a real sibling repo.
fn _reg_sandbox() -> str {
    let e = env_var("HEXA_CLOUD_ING_ROOT")
    if len(e) > 0 {
        return e
    }
    let sentinel = "./.hexa-cloud-ing-sandbox"
    let r = exec_capture("test -f " + sentinel + " && echo y")
    if r[0] == "y\n" {
        let raw = read_file(sentinel)
        let s = raw.trim()
        if len(s) > 0 {
            return s
        }
    }
    return ""
}

// _reg_ing_root — the sibling-scan root. The sandbox override (env / sentinel)
// wins; else $HOME/dancinlab (every project repo's ING.jsonl is scanned).
fn _reg_ing_root() -> str {
    let sb = _reg_sandbox()
    if len(sb) > 0 {
        return sb
    }
    return env_var("HOME") + "/dancinlab"
}

// _reg_cwd_ing — the local ING.jsonl for a pod with no resolvable project home.
// Normally the cwd `./ING.jsonl`; under a sandbox, `<sandbox>/_cwd/ING.jsonl`
// so an unattributed/blank-project pod also stays inside the test sandbox.
fn _reg_cwd_ing() -> str {
    let sb = _reg_sandbox()
    if len(sb) > 0 {
        return sb + "/_cwd/ING.jsonl"
    }
    return "./ING.jsonl"
}

// _reg_project_file — the home ING.jsonl for a project. `<root>/<project>/ING.jsonl`
// when the project repo dir exists, else the cwd ING.jsonl (so an unattributed /
// no-repo pod still lands somewhere durable). project "" / "unattributed" → cwd.
fn _reg_project_file(project: str) -> str {
    if len(project) == 0 || project == "unattributed" {
        return _reg_cwd_ing()
    }
    let cand = _reg_ing_root() + "/" + project + "/ING.jsonl"
    let dir = _reg_ing_root() + "/" + project
    let r = exec_capture("test -d " + _reg_shq(dir) + " && echo y")
    if r[0] == "y\n" {
        return cand
    }
    return _reg_cwd_ing()
}

// _reg_ing_files — every ING.jsonl to scan for the global registry view: each
// `<root>/*/ING.jsonl` plus the cwd `./ING.jsonl`, deduped (order-preserving).
// Best-effort: a missing root contributes nothing.
fn _reg_ing_files() -> [str] {
    let mut out = []
    let root = _reg_ing_root()
    let found = exec("ls -d " + _reg_shq(root) + "/*/ING.jsonl 2>/dev/null").trim()
    if len(found) > 0 {
        let lines = found.split("\n")
        let mut i = 0
        while i < len(lines) {
            let p = lines[i].trim()
            if len(p) > 0 && _recon_id_in(out, p) == 0 { out.push(p) }
            i = i + 1
        }
    }
    // Add the cwd ING.jsonl unless the sibling glob already covered it (cwd is
    // a repo under <root>). Compare by realpath so `./ING.jsonl` and the
    // absolute `<root>/<cwd-repo>/ING.jsonl` dedup correctly (no double-scan).
    let cwd_abs = exec("cd \"$(dirname ./ING.jsonl)\" 2>/dev/null && printf '%s/ING.jsonl' \"$(pwd -P)\"").trim()
    let mut covered = 0
    let mut k = 0
    while k < len(out) {
        if out[k] == cwd_abs { covered = 1 }
        k = k + 1
    }
    if covered == 0 { out.push(_reg_cwd_ing()) }
    return out
}

// _reg_shq — POSIX-quote a token for the local /bin/sh -c (mkdir/date).
fn _reg_shq(s: str) -> str {
    let mut out = "'"
    let mut i = 0
    let n = len(s)
    while i < n {
        let c = s.substring(i, i + 1)
        if c == "'" {
            out = out + "'\\''"
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out + "'"
}

// ── time ─────────────────────────────────────────────────────────────

// _reg_now_iso — UTC ISO-8601 timestamp (date -u). "" if unavailable.
fn _reg_now_iso() -> str {
    return exec("date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null").trim()
}

// _reg_now_sec — unix epoch seconds; 0 if unavailable (staleness degrades
// to "not stale" rather than false-flagging everything).
fn _reg_now_sec() -> int {
    let s = exec("date +%s 2>/dev/null").trim()
    return _reg_atoi(s)
}

// _reg_iso_to_sec — epoch seconds for an ISO-8601 UTC ts via `date -d`/`-jf`.
// Returns -1 if the platform's date(1) cannot parse it (e.g. BSD without the
// -j form), so staleness math degrades to "skip" rather than mis-flag.
fn _reg_iso_to_sec(iso: str) -> int {
    if len(iso) == 0 {
        return -1
    }
    let q = _reg_shq(iso)
    // GNU date first, then BSD/macOS `-jf`. Both print epoch on success.
    let cmd = "date -u -d " + q + " +%s 2>/dev/null || date -u -jf %Y-%m-%dT%H:%M:%SZ " + q + " +%s 2>/dev/null"
    let s = exec(cmd).trim()
    return _reg_atoi(s)
}

// -- M6 reap-guard heartbeat-TTL helpers ------------------------------
//
// _reg_owner_pid - the OS pid of the process renting the pod (this hexa
// CLI). Stamped into the registry at rent so `cloud reap` can later check
// owner liveness via kill -0. Prefers an explicit HEXA_OWNER_PID (a parent
// agent can pin its own pid through the env so the reap signal survives the
// short-lived `hexa cloud rent` child), else this process's own pid. -1 if
// neither is resolvable (heartbeat-pid signal simply unset, never false).
fn _reg_owner_pid() -> int {
    let env_pid = env_var("HEXA_OWNER_PID")
    if len(env_pid) > 0 {
        let v = _reg_atoi(env_pid)
        if v > 0 { return v }
    }
    let p = exec("echo $$ 2>/dev/null").trim()
    let pv = _reg_atoi(p)
    if pv > 0 { return pv }
    return -1
}

// _reg_default_max_ttl_sec - the self-expiry window stamped at rent. A pod
// whose owner has gone silent for longer than this is reapable even if a
// kill -0 liveness probe is inconclusive (e.g. the owner pid was recycled).
// Overridable via HEXA_CLOUD_MAX_TTL_SEC; default 6h (21600s) - long enough
// not to reap a healthy long training run, short enough to bound a leak.
fn _reg_default_max_ttl_sec() -> int {
    let e = env_var("HEXA_CLOUD_MAX_TTL_SEC")
    if len(e) > 0 {
        let v = _reg_atoi(e)
        if v > 0 { return v }
    }
    return 21600
}

// pod_registry_owner_alive - kill -0 liveness for a recorded owner pid.
// 1 = the pid is alive (signal-0 succeeds) * 0 = the pid is gone (no such
// process) * -1 = UNDETERMINED (pid unset, or the probe could not run). The
// reaper treats -1 as "no death signal from the pid axis" (fail-safe: never
// reap on an inconclusive liveness probe alone - TTL must also be exceeded).
fn pod_registry_owner_alive(pid: int) -> int {
    if pid <= 0 {
        return -1
    }
    // kill -0 <pid>: exit 0 iff the process exists AND is signalable. We
    // print a sentinel token per branch so a degraded shell can't be
    // misread as "alive". ALIVE/DEAD are authoritative; anything else -> -1.
    let out = exec("kill -0 " + str(pid) + " 2>/dev/null && echo __ALIVE__ || echo __DEAD__").trim()
    if out.index_of("__ALIVE__") >= 0 { return 1 }
    if out.index_of("__DEAD__") >= 0 { return 0 }
    return -1
}

// _reg_atoi — leading run of decimal digits; -1 if none.
fn _reg_atoi(s: str) -> int {
    let n = len(s)
    let mut i = 0
    let mut val = 0
    let mut got = 0
    while i < n {
        let cc = char_code(s.substring(i, i + 1))
        if cc >= 48 && cc <= 57 {
            val = val * 10 + (cc - 48)
            got = 1
            i = i + 1
        } else {
            i = n
        }
    }
    if got == 0 {
        return -1
    }
    return val
}

// ── JSON value escaping / field extraction ───────────────────────────

// _reg_jstr — JSON-escape a string value (quotes, backslash, newline) so a
// label/purpose with a quote can't break the JSONL line.
fn _reg_jstr(s: str) -> str {
    let mut out = ""
    let mut i = 0
    let n = len(s)
    while i < n {
        let c = s.substring(i, i + 1)
        if c == "\"" {
            out = out + "\\\""
        } else if c == "\\" {
            out = out + "\\\\"
        } else if c == "\n" {
            out = out + "\\n"
        } else if c == "\t" {
            out = out + "\\t"
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

// _reg_field — extract the string value of "key":"value" from one JSONL
// line. Conservative: assumes the value has no escaped quote (true for the
// fields we write: ids, labels, ISO ts, status). "" if the key is absent.
fn _reg_field(line: str, key: str) -> str {
    let marker = "\"" + key + "\":\""
    let at = line.index_of(marker)
    if at < 0 {
        return ""
    }
    let start = at + len(marker)
    let mut i = start
    let n = len(line)
    while i < n {
        if line.substring(i, i + 1) == "\"" {
            return line.substring(start, i)
        }
        i = i + 1
    }
    return ""
}

// ── write helper (the single gateway hook) ───────────────────────────

// pod_registry_record — append/update one pod's record in pods.jsonl. The
// `cloud run` / `cloud nohup` verbs call this after a dispatch so every pod
// that goes through the gateway lands in one SSOT. Same-id re-dispatch
// updates the existing record's last_seen + status in place (the file is
// rewritten with the prior records minus the matching id, then the fresh
// record appended) so the file does not grow one line per poll.
//
// `pod_id`  — the PROVIDER pod/instance id ONLY (numeric vast instance-id or
//             alphanumeric runpod pod-id). NOT an ssh destination, path, or
//             argv fragment — reconcile matches this id against the provider
//             live-id sets, so an `root@<ip>` / `ssh1.vast.ai` / `/root/run.sh`
//             / bare-flag value can never match and pollutes the table with
//             phantom GHOST rows (INBOX #1229 B → A). `_pod_id_looks_valid`
//             rejects those shapes.
// `label`   — free-form purpose/name ("p21h-v3-qwen", launching repo, ...).
// `status`  — "running" | "closed" | "lost".

// _pod_id_looks_valid — a provider pod-id is a bare token (vast: digits;
// runpod: alnum + `-`/`_`). Reject ssh destinations (`@`), hosts / IPs (`.`),
// paths (`/`), whitespace (argv fragments), and leading-`-` flag values — the
// pollution classes filed in INBOX #1229 B. 1 = looks like a real id, 0 = drop.
fn _pod_id_looks_valid(pod_id: str) -> int {
    let n = len(pod_id)
    if n == 0 {
        return 0
    }
    if pod_id.substring(0, 1) == "-" {
        return 0
    }
    let mut i = 0
    while i < n {
        let c = pod_id.substring(i, i + 1)
        if c == "@" || c == "/" || c == "." || c == " " || c == "\t" {
            return 0
        }
        i = i + 1
    }
    return 1
}

// pod_registry_record — LEGACY shim, now folded onto the unified ING/M5 layer.
// Was a separate ~/.hexa-cloud/pods.jsonl writer; the registry is now the
// per-project ING.jsonl `kind:"pod"` rows. Maps the legacy {label,status}
// to the M5 record: label→purpose, status running→READY / closed→GONE. project
// is left "" (the upsert preserves any project a prior pod_registry_add set, so
// calling record() after add() at rent never erases attribution). The #1229
// sink guard lives in pod_registry_add.
fn pod_registry_record(pod_id: str, label: str, status: str) {
    if len(pod_id) == 0 {
        return
    }
    let mut st = status
    if status == "running" { st = "READY" }
    if status == "closed" { st = "GONE" }
    let _ = pod_registry_add(pod_id, "", "", label, "", "", st)
}

// ── read verb (cloud orphans) ────────────────────────────────────────

// PodRow — one parsed registry record, plus the derived staleness flag.
struct PodRow {
    pod_id:     str,
    label:      str,
    created_at: str,
    last_seen:  str,
    status:     str,
    stale:      int    // 1 iff created > stale_hours ago and not closed
}

// pod_registry_rows — derive the legacy PodRow view from the unified ING/M5
// registry (pod_registry_load). label=purpose, last_seen=last_heartbeat; a M5
// "GONE" status maps to the legacy "closed" so the orphans/reconcile staleness
// logic (which checks `status != "closed"`) is unchanged. Flags each row stale
// when created_at is older than `stale_hours` and the pod is not closed.
fn pod_registry_rows(stale_hours: int) -> [PodRow] {
    let mut rows = []
    let records = pod_registry_load()
    let now = _reg_now_sec()
    let threshold = stale_hours * 3600
    let mut i = 0
    while i < len(records) {
        let r = records[i]
        let id = r.id
        if len(id) > 0 {
            let created = r.created_at
            let mut status = r.status
            if status == "GONE" { status = "closed" }
            let mut stale = 0
            if status != "closed" && now > 0 {
                let csec = _reg_iso_to_sec(created)
                if csec > 0 && (now - csec) > threshold {
                    stale = 1
                }
            }
            rows.push(PodRow {
                pod_id: id,
                label: r.purpose,
                created_at: created,
                last_seen: r.last_heartbeat,
                status: status,
                stale: stale
            })
        }
        i = i + 1
    }
    return rows
}

// cloud_orphans_print — render the registry to stdout, flagging stale pods.
// `stale_hours` is the age threshold (default caller passes 6). Returns the
// number of stale rows so the verb can set a nonzero exit when orphans exist.
fn cloud_orphans_print(stale_hours: int) -> int {
    let rows = pod_registry_rows(stale_hours)
    if len(rows) == 0 {
        println("[cloud] pod registry empty (ING.jsonl kind:\"pod\" rows across " + _reg_ing_root() + "/*/)")
        println("[cloud] pods dispatched via `cloud run` / `cloud nohup` / `cloud rent` are tracked here.")
        return 0
    }
    println("POD/HOST                 STATUS    CREATED               LABEL          FLAG")
    let mut stale_n = 0
    let mut i = 0
    while i < len(rows) {
        let r = rows[i]
        let mut flag = "ok"
        if r.stale == 1 {
            flag = "STALE >" + str(stale_hours) + "h"
            stale_n = stale_n + 1
        }
        println(_reg_pad(r.pod_id, 24) + " " + _reg_pad(r.status, 9) + " "
            + _reg_pad(r.created_at, 21) + " " + _reg_pad(r.label, 14) + " " + flag)
        i = i + 1
    }
    println("[cloud] " + str(len(rows)) + " tracked · " + str(stale_n)
        + " stale (created > " + str(stale_hours) + "h ago, not closed) · ING.jsonl SSOT (" + _reg_ing_root() + "/*/)")
    return stale_n
}

// _reg_pad — right-pad `s` to `width` columns for a fixed-width table.
fn _reg_pad(s: str, width: int) -> str {
    let mut out = s
    let mut i = len(s)
    while i < width {
        out = out + " "
        i = i + 1
    }
    return out
}

// ── adopt / forget (write verbs) ──────────────────────────────────────

// pod_registry_adopt — register a previously-untracked pod into the
// registry so it regains a poll/pull/lifecycle handle. This is the
// recovery path for an ORPHAN found by reconcile (provider-RUNNING but
// absent from pods.jsonl). `label` carries the free-form purpose. Reuses
// pod_registry_record so the same-id de-dup + created_at preservation
// behaviour applies (re-adopting an id just refreshes last_seen). Returns
// 1 on success, 0 when the id is empty.
fn pod_registry_adopt(pod_id: str, label: str) -> int {
    if len(pod_id) == 0 {
        return 0
    }
    pod_registry_record(pod_id, label, "running")
    return 1
}

// pod_registry_forget — mark a tracked pod's record status=closed (the
// GHOST recovery path: registry-tracked but provider-gone). The record is
// kept (closed rows are excluded from staleness flagging) rather than
// deleted so the launch history survives. Returns 1 if the id was found
// and flipped, 0 if the id is absent / registry empty.
//
// Cleanup symmetry (INBOX 2026-05-28): `cloud reconcile` flags GHOST rows
// by their literal `pod_id` field, which for legacy rows can be an ssh-form
// (`root@<ip>` · `ssh1.vast.ai`), a bare IP, an alias (`ubu-2`), or even a
// `--help`-as-id edge case — values the #1229 `_pod_id_looks_valid` sink
// guard now rejects at WRITE time, but which already sit in the registry.
// forget MUST be able to close any of those (the reconcile→forget loop is
// otherwise half-closed: numeric GHOSTs forget, ssh-form GHOSTs accumulate
// forever). So this closes the matched row IN PLACE — a literal-match
// status flip that does NOT route through pod_registry_record, whose sink
// guard would refuse the very ssh-form/IP/alias ids we are cleaning up. The
// guard stays intact for record/adopt, so no NEW pollution enters; forget
// only closes what physically exists, regardless of id shape.
fn pod_registry_forget(pod_id: str) -> int {
    if len(pod_id) == 0 {
        return 0
    }
    // Unified ING/M5 layer: a "forgotten" pod is its row flipped to status=GONE
    // (pod_registry_list / rows exclude GONE, so the launch history survives but
    // the pod stops being claimed alive). update_status finds the record across
    // the per-project ING.jsonl set + persists in place (preserving every other
    // field + row). The legacy ssh-form/IP/alias GHOST-cleanup case is moot now:
    // such non-pod-id rows never become tracked records (`_pod_id_looks_valid`
    // filters them at load), so there is nothing to close for those shapes.
    return pod_registry_update_status(pod_id, "GONE")
}

// ── reconcile (ORPHAN / GHOST / OK classification) ────────────────────

// ReconRow — one classified pod after cross-referencing the registry
// against the provider's live pod list.
struct ReconRow {
    pod_id: str,
    label:  str,        // registry label, or "(unknown)" for an ORPHAN
    status: str,        // registry status, or "running" for a live ORPHAN
    klass:  str         // "ORPHAN" | "GHOST" | "OK"
}

// _recon_id_in — membership test for a pod id in a [str] list.
fn _recon_id_in(ids: [str], pod_id: str) -> int {
    let mut i = 0
    while i < len(ids) {
        if ids[i] == pod_id {
            return 1
        }
        i = i + 1
    }
    return 0
}

// pod_registry_reconcile_rows — classify every pod across the registry and
// the supplied provider id list. `provider_ids` is the set of pod ids the
// provider reports as live (from runpod_list_pods().pod_ids). A non-closed
// registry row whose id is absent from provider_ids is a GHOST; a registry
// row present in provider_ids is OK; a provider id absent from the registry
// is an ORPHAN. Closed registry rows that the provider no longer reports are
// skipped (already-reconciled history, not a ghost). Pure over its inputs —
// the caller fetches the provider list, so this is deterministically
// testable with a canned id list (no live runpodctl).
fn pod_registry_reconcile_rows(provider_ids: [str]) -> [ReconRow] {
    let mut out = []
    let rows = pod_registry_rows(0)   // 0h threshold: no staleness math needed here
    // Pass 1: every registry row → OK (in provider list) or GHOST (gone).
    let mut i = 0
    while i < len(rows) {
        let r = rows[i]
        if _recon_id_in(provider_ids, r.pod_id) == 1 {
            out.push(ReconRow { pod_id: r.pod_id, label: r.label, status: r.status, klass: "OK" })
        } else if r.status != "closed" {
            out.push(ReconRow { pod_id: r.pod_id, label: r.label, status: r.status, klass: "GHOST" })
        }
        i = i + 1
    }
    // Pass 2: every provider id not in the registry → ORPHAN.
    let mut p = 0
    while p < len(provider_ids) {
        let pid = provider_ids[p]
        let mut tracked = 0
        let mut k = 0
        while k < len(rows) {
            if rows[k].pod_id == pid {
                tracked = 1
                k = len(rows)
            } else {
                k = k + 1
            }
        }
        if tracked == 0 {
            out.push(ReconRow { pod_id: pid, label: "(unknown)", status: "running", klass: "ORPHAN" })
        }
        p = p + 1
    }
    return out
}

// cloud_reconcile_print — fetch the provider pod lists and print the
// ORPHAN/GHOST/OK reconcile table. Returns the count of ORPHAN+GHOST rows so
// the verb can exit nonzero when the registry and provider disagree.
//
// The registry is provider-agnostic (it tracks both runpod and vast pods),
// so reconcile MUST union BOTH provider live-id sets before classifying — a
// vast-provisioned pod that is RUNNING on vast.ai must not classify GHOST
// merely because the runpod list omits it (and vice versa). Querying only
// runpod was the GHOST-misclassification bug: every live vast instance fell
// through to GHOST. When a provider's CLI is unavailable its set is empty
// (the honest "I can't see that provider" degrade, distinct from a confirmed
// teardown) — only pods absent from BOTH live sets classify GHOST.
fn cloud_reconcile_print() -> int {
    // AUTHORITATIVE runpod source: the `myself.pods` GraphQL query (the
    // provider's own ledger), CLI-fallback only when that is degraded. The
    // live ghost-drift incident (2026-06-04: registry showed 3 RENTING pods
    // absent from myself.pods, real count 1) is exactly what this refutes.
    let rl = runpod_authoritative_pods()
    let vl = vast_list_instances()
    let mut provider_ids = []
    let mut ri = 0
    while ri < len(rl.pod_ids) {
        provider_ids.push(rl.pod_ids[ri])
        ri = ri + 1
    }
    let mut vi = 0
    while vi < len(vl.instance_ids) {
        provider_ids.push(vl.instance_ids[vi])
        vi = vi + 1
    }
    if rl.ok == 0 && vl.ok == 0 {
        println("[cloud] both provider lists unavailable (runpod: " + rl.message
            + " · vast: " + vl.message + ") — reconciling against empty set")
    } else if rl.ok == 0 {
        println("[cloud] runpod list unavailable (" + rl.message + ") — vast-only provider set")
    } else if vl.ok == 0 {
        println("[cloud] vast list unavailable (" + vl.message + ") — runpod-only provider set")
    }
    let rows = pod_registry_reconcile_rows(provider_ids)
    if len(rows) == 0 {
        println("[cloud] reconcile clean — no tracked pods and no live provider pods (ING.jsonl SSOT " + _reg_ing_root() + "/*/)")
        return 0
    }
    println("POD/HOST                 STATUS    LABEL          CLASS")
    let mut drift = 0
    let mut i = 0
    while i < len(rows) {
        let r = rows[i]
        if r.klass != "OK" {
            drift = drift + 1
        }
        println(_reg_pad(r.pod_id, 24) + " " + _reg_pad(r.status, 9) + " "
            + _reg_pad(r.label, 14) + " " + r.klass)
        i = i + 1
    }
    println("[cloud] " + str(len(rows)) + " reconciled · " + str(drift)
        + " drift (ORPHAN=adopt|stop · GHOST=forget) · ING.jsonl SSOT (" + _reg_ing_root() + "/*/)")
    return drift
}

// ── shared provider-alive set (the single liveness source of truth) ──────
// ProviderAlive — the merged authoritative provider-live id set + an `ok`
// flag. `ok == 1` iff AT LEAST ONE provider query returned (so an empty
// `ids` is a trustworthy "provider reports none"); `ok == 0` iff BOTH the
// runpod (myself.pods, CLI-fallback) and vast (show instances) queries were
// degraded → callers must NOT treat the empty set as "everything is dead".
// runpod_ok / vast_ok carry PER-PROVIDER authority so a consumer can judge a
// pod GONE only against the provider that actually answered. The merged `ok`
// (≥1 provider answered) is NOT enough on its own: when one provider degrades
// but the other answers, the merged `ids` holds only the answering provider's
// pods, so a blind membership test would falsely mark every pod of the degraded
// provider GONE (g63 — never invent GONE from a blind probe). Consumers that
// classify liveness MUST gate on the owning provider's flag, not merged `ok`.
struct ProviderAlive {
    ok:        int,
    runpod_ok: int,
    vast_ok:   int,
    ids:       [str],
    message:   str
}

// cloud_provider_alive_ids — resolve the merged provider-alive id set the way
// `probe`/`reap`/`idle-reap`/reconcile already do: runpod authoritative
// (myself.pods GraphQL, CLI-fallback) ∪ vast show instances. This is the ONE
// helper `cloud pods` joins against so the table can no longer trust a stale
// local manifest. ok=0 ONLY when BOTH providers are unreachable.
pub fn cloud_provider_alive_ids() -> ProviderAlive {
    let rl = runpod_authoritative_pods()
    let vl = vast_list_instances()
    let mut ids = []
    let mut ri = 0
    while ri < len(rl.pod_ids) { ids.push(rl.pod_ids[ri]); ri = ri + 1 }
    let mut vi = 0
    while vi < len(vl.instance_ids) { ids.push(vl.instance_ids[vi]); vi = vi + 1 }
    let mut ok = 1
    let mut msg = "runpod: " + rl.message + " · vast: " + vl.message
    if rl.ok == 0 && vl.ok == 0 {
        ok = 0
        msg = "BOTH providers unreachable — " + msg
    } else if rl.ok == 0 {
        msg = "vast-only (runpod degraded) — " + msg
    } else if vl.ok == 0 {
        msg = "runpod-only (vast degraded) — " + msg
    }
    return ProviderAlive { ok: ok, runpod_ok: rl.ok, vast_ok: vl.ok, ids: ids, message: msg }
}

// cloud_pods_reconcile_prune — ACTIVE reconcile pass for `cloud pods` (anima
// ghost-drift fix, plan @L2). Fetches the AUTHORITATIVE merged provider-alive
// id set (runpod myself.pods GraphQL + vast), then over the M5 registry:
//   GHOST  (tracked RENTING/READY but absent from the authoritative set)
//          → auto-forget (pod_registry_remove): the registry stops claiming a
//          pod RunPod no longer reports. This is the exact drift the live hook
//          showed (3 phantom RENTING rows vs 1 real pod).
//   ORPHAN (alive on the provider but untracked) → SURFACED (warned, never
//          auto-touched — a human adopts or reaps it).
// Returns the count of ghosts pruned. SKIPPED ENTIRELY when BOTH provider
// queries are degraded (no authoritative truth → never prune on a blind set,
// g63: never invent "gone" from an unreachable provider).
fn cloud_pods_reconcile_prune() -> int {
    let rl = runpod_authoritative_pods()
    let vl = vast_list_instances()
    if rl.ok == 0 {
        if vl.ok == 0 {
            println("[cloud] pods: reconcile SKIPPED — no authoritative provider truth (runpod: "
                + rl.message + " · vast: " + vl.message + ")")
            return 0
        }
    }
    let mut alive = []
    let mut ri = 0
    while ri < len(rl.pod_ids) { alive.push(rl.pod_ids[ri]); ri = ri + 1 }
    let mut vi = 0
    while vi < len(vl.instance_ids) { alive.push(vl.instance_ids[vi]); vi = vi + 1 }
    // Prune GHOST M5 rows + surface ORPHANs.
    let reg = pod_registry_list()
    let mut ghosts = []
    let mut gi = 0
    while gi < len(reg) {
        let r = reg[gi]
        let mut tracked_alive = 0
        if _recon_id_in(alive, r.id) == 1 { tracked_alive = 1 }
        // only a live-intent row (RENTING/READY) is a meaningful ghost; a
        // STOPPING row is already on its way out.
        let mut live_intent = 0
        if r.status == "RENTING" { live_intent = 1 }
        if r.status == "READY" { live_intent = 1 }
        if tracked_alive == 0 {
            if live_intent == 1 {
                ghosts.push(r.id)
            }
        }
        gi = gi + 1
    }
    let mut pruned = 0
    let mut pi = 0
    while pi < len(ghosts) {
        println("[cloud] pods: GHOST " + ghosts[pi]
            + " — in registry, absent from authoritative provider set → forgetting")
        let _ = pod_registry_remove(ghosts[pi])
        pruned = pruned + 1
        pi = pi + 1
    }
    // Surface real orphans (alive on provider, untracked) for human action.
    let mut reg_ids = []
    let mut k = 0
    while k < len(reg) { reg_ids.push(reg[k].id); k = k + 1 }
    let mut ai = 0
    while ai < len(alive) {
        let id = alive[ai]
        if _recon_id_in(reg_ids, id) == 0 {
            println("[cloud] pods: ORPHAN " + id
                + " — alive on provider, untracked (adopt or `cloud reap`)")
        }
        ai = ai + 1
    }
    if pruned > 0 {
        println("[cloud] pods: pruned " + str(pruned) + " ghost row(s) against authoritative myself.pods")
    }
    return pruned
}

// ── M5 — crash-safe pod registry over ING.jsonl (cross-project SSOT) ──
//
// SSOT MIGRATION (2026-06-18): the registry no longer lives in a single global
// file (`~/.hx/cloud/active-pods.json`). Each pod is a `kind:"pod"` row in its
// OWNING PROJECT's `./ING.jsonl` — the SAME row pods_local.hexa + harness `ing`
// share. The GLOBAL cross-project billing/orphan view (the defense born of the
// 7×A100-after-reboot incident — see file header) is RECONSTRUCTED by scanning
// every sibling `$HOME/dancinlab/*/ING.jsonl`. The orphan/billing/down-guard
// logic below is UNCHANGED; only its storage backend moved.
//
// Per-pod home file = `_reg_project_file(project)` (the project repo's ING.jsonl
// when it exists, else cwd ./ING.jsonl). A pod's row also carries the
// pods_local-owned fields (host / jobs[] / gpu / purpose / cost / ts) and the
// harness-ing fields; writes here PRESERVE those (read-merge-write per row), and
// every NON-(matching-pod) line in the target file is re-emitted verbatim, so
// work/next rows + OTHER pods' rows are never clobbered.
//
// Crash-safety: every per-file mutation writes `<path>.tmp.<pid>` first, then
// rename(2) to the final path (POSIX-atomic on the same fs) + a `.bak` snapshot
// — same hardening the M5 single-file + pods_local writers had.
//
// Wire points (UNCHANGED): `cloud rent` success → pod_registry_add(...READY).
// `cloud down` confirmed teardown → pod_registry_remove(id). Status flips
// (STOPPING, GONE) go through pod_registry_update_status.

// pod_registry_path — DEPRECATED single-file path (retained as a compat shim
// for callers/tests that print it). The live SSOT is now the per-project
// ING.jsonl set (`_reg_ing_files()`); this returns the cwd ING.jsonl as the
// canonical "where this project's pods live" answer.
fn pod_registry_path() -> str {
    return _reg_cwd_ing()
}

// _m5_pid — current process pid (for the temp-file suffix). Falls back to
// the timestamp ns when /bin/sh is unavailable so two near-simultaneous
// writes still pick distinct temp names.
fn _m5_pid() -> str {
    let s = exec("echo $$ 2>/dev/null").trim()
    if len(s) > 0 {
        return s
    }
    return exec("date +%s%N 2>/dev/null").trim()
}

// PodRecord — one parsed registry record (one ING.jsonl `kind:"pod"` row).
// `src` is the source ING.jsonl path the row came from (the per-file write
// target); "" for a freshly-constructed record not yet persisted (its home is
// resolved from `project` at write time). All other fields mirror the schema.
struct PodRecord {
    id:                    str,
    provider:              str,    // "runpod" | "vast" | "ssh"
    created_at:            str,    // ISO-8601 UTC
    rented_by:             str,    // optional agent tag ("" if absent)
    project:               str,    // owning project ("anima"/"demiurge"/...; "" = unattributed — cross-project down-guard source)
    purpose:              str,    // free-form purpose/label ("" if absent; surfaces the existing adopt --purpose / rent --owner intent)
    ssh_host:              str,
    ssh_port:              str,
    status:                str,    // "RENTING" | "READY" | "STOPPING" | "GONE"
    ttl_sec:               int,    // -1 = unset (M2 will populate)
    max_cost_usd:          str,    // "" = unset (M3; str to preserve "5.00")
    cumulative_cost_usd:   str,    // "0.0" default (M3; derived-on-read in the sweep, not persisted)
    cost_per_hr_usd:       str,    // "" = unset (M3 rate source; provider dph captured at rent)
    // ── M6 reap-guard heartbeat-TTL (anima orphan-leak fix, 2026-06-04) ──
    // Deterministic owner-death / expiry signal for `cloud reap`. The owning
    // agent stamps its OS pid + a last-heartbeat ts at rent; the reaper treats
    // a registry pod still ALIVE on the provider as dead-owned when the pid is
    // gone (kill -0) OR (now − last_heartbeat) > max_ttl_sec.
    owner_pid:             int,    // -1 = unset (no owner pid recorded)
    last_heartbeat:        str,    // ISO-8601 UTC; "" = unset (never beaten)
    max_ttl_sec:           int,    // -1 = unset (no self-expiry signal)
    src:                   str     // source ING.jsonl path; "" = not yet persisted
}

// _reg_row_record — build a PodRecord from one parsed ING.jsonl `kind:"pod"`
// JSON row object (already json_parse'd), tagged with its source file `src`.
// Reads the rich M5 fields, defaulting unset numerics to -1 / "0.0" so a
// minimal harness-ing-authored pod row (only provider/gpu/purpose/cost) reads
// back cleanly. `created_at` falls back to the row's `ts` (harness ing stamps
// `ts`, not `created_at`) so age/accrual math still has an anchor.
fn _reg_row_record(row, src: str) -> PodRecord {
    let id = json_object_get_str(row, "id", "")
    let mut created = json_object_get_str(row, "created_at", "")
    if len(created) == 0 {
        created = json_object_get_str(row, "ts", "")
    }
    let ttl = to_int(json_object_get_int(row, "ttl_sec", -1))
    let opid = to_int(json_object_get_int(row, "owner_pid", -1))
    let mttl = to_int(json_object_get_int(row, "max_ttl_sec", -1))
    let mut cum = json_object_get_str(row, "cumulative_cost_usd", "")
    if len(cum) == 0 { cum = "0.0" }
    return PodRecord {
        id: id,
        provider: json_object_get_str(row, "provider", ""),
        created_at: created,
        rented_by: json_object_get_str(row, "rented_by", ""),
        project: json_object_get_str(row, "project", ""),
        purpose: json_object_get_str(row, "purpose", ""),
        ssh_host: json_object_get_str(row, "ssh_host", ""),
        ssh_port: json_object_get_str(row, "ssh_port", ""),
        status: json_object_get_str(row, "status", ""),
        ttl_sec: ttl,
        max_cost_usd: json_object_get_str(row, "max_cost_usd", ""),
        cumulative_cost_usd: cum,
        cost_per_hr_usd: json_object_get_str(row, "cost_per_hr_usd", ""),
        owner_pid: opid,
        last_heartbeat: json_object_get_str(row, "last_heartbeat", ""),
        max_ttl_sec: mttl,
        src: src
    }
}

// _reg_load_file — parse one ING.jsonl file, returning its `kind:"pod"` rows
// as PodRecords. Best-effort: a missing/empty file → []. ONLY rows whose `id`
// is a VALID provider pod-id (`_pod_id_looks_valid`) become records — this
// excludes harness-ing's free-form prose pod notes (ids with spaces / sentences)
// so the billing/orphan scan never mistakes a human note for a live billing pod.
fn _reg_load_file(path: str) -> [PodRecord] {
    let mut out = []
    if !file_exists(path) {
        return out
    }
    let body = read_file(path)
    if len(body.trim()) == 0 {
        return out
    }
    let lines = body.split("\n")
    let mut i = 0
    while i < len(lines) {
        let ln = lines[i].trim()
        if len(ln) > 0 {
            let row = json_parse(ln)
            if json_object_get_str(row, "kind", "") == "pod" {
                let id = json_object_get_str(row, "id", "")
                if len(id) > 0 && _pod_id_looks_valid(id) == 1 {
                    out.push(_reg_row_record(row, path))
                }
            }
        }
        i = i + 1
    }
    return out
}

// pod_registry_load — the GLOBAL cross-project registry view: scan every
// sibling `$HOME/dancinlab/*/ING.jsonl` (+ cwd) and union their machine pod
// rows into PodRecords. This is how the billing/orphan/down-guard defense
// spans projects now that the central active-pods.json is retired. Empty when
// no ING.jsonl carries a valid machine pod row.
fn pod_registry_load() -> [PodRecord] {
    let mut out = []
    let files = _reg_ing_files()
    let mut f = 0
    while f < len(files) {
        let recs = _reg_load_file(files[f])
        let mut j = 0
        while j < len(recs) {
            out.push(recs[j])
            j = j + 1
        }
        f = f + 1
    }
    return out
}

// PodEndpoint — the ssh destination resolved out of the M5 registry for a
// bare pod-id. `resolved=1` iff a matching record carried a non-empty
// ssh_host; `port` is the stored ssh_port ("" when unset). Lets a transport
// verb (poll/run/exec/nohup/copy) reach a pod by its registry id WITHOUT a
// hand-typed host/port — the root-cause-#1 fix (edge-genall pod 38961119 had
// ssh_port "11118" in the registry all along, but poll defaulted to :22 →
// false DEAD → teardown).
struct PodEndpoint {
    host:     str,
    port:     str,
    resolved: int
}

// pod_registry_resolve_endpoint — look `pod_id` up in the M5 registry and
// return its stored ssh_host + ssh_port. resolved=0 (host/port "") when the
// id is absent OR has no recorded ssh_host yet (still RENTING / never mapped),
// so the caller falls back to its existing resolution paths unchanged. Pure
// read — never mutates the registry.
fn pod_registry_resolve_endpoint(pod_id: str) -> PodEndpoint {
    if len(pod_id) == 0 {
        return PodEndpoint { host: "", port: "", resolved: 0 }
    }
    let records = pod_registry_load()
    let idx = _m5_find(records, pod_id)
    if idx < 0 {
        return PodEndpoint { host: "", port: "", resolved: 0 }
    }
    let r = records[idx]
    if len(r.ssh_host) == 0 {
        return PodEndpoint { host: "", port: "", resolved: 0 }
    }
    return PodEndpoint { host: r.ssh_host, port: r.ssh_port, resolved: 1 }
}

// _reg_set_num — set "key":int on a row, or remove the key when v < 0 (unset).
fn _reg_set_num(row, key: str, v: int) {
    if v >= 0 {
        let _ = json_object_set(row, key, v)
    } else {
        let _ = json_object_delete(row, key)
    }
}

// _reg_set_str — set "key":"val" when non-empty, else remove the key.
fn _reg_set_str(row, key: str, val: str) {
    if len(val) > 0 {
        let _ = json_object_set(row, key, val)
    } else {
        let _ = json_object_delete(row, key)
    }
}

// _reg_merge_record_into_row — stamp a PodRecord's M5 fields onto an ING pod
// `row` JSON object (kind:"pod"), PRESERVING every field the row already had
// that pod_registry does NOT own (host / jobs / gpu / purpose-display / cost /
// any future key) so a co-managed pods_local/harness-ing row is never stripped.
// The shared `ts` is refreshed; `id` + `kind` are stamped (idempotent).
fn _reg_merge_record_into_row(row, r: PodRecord) {
    let now = _reg_now_iso()
    let _ = json_object_set(row, "kind", "pod")
    let _ = json_object_set(row, "id", r.id)
    let _ = json_object_set(row, "ts", now)
    _reg_set_str(row, "provider", r.provider)
    _reg_set_str(row, "created_at", r.created_at)
    _reg_set_str(row, "rented_by", r.rented_by)
    _reg_set_str(row, "project", r.project)
    // `purpose` is shared with harness ing — always reflect the M5 purpose.
    _reg_set_str(row, "purpose", r.purpose)
    _reg_set_str(row, "ssh_host", r.ssh_host)
    _reg_set_str(row, "ssh_port", r.ssh_port)
    _reg_set_str(row, "status", r.status)
    _reg_set_num(row, "ttl_sec", r.ttl_sec)
    _reg_set_str(row, "max_cost_usd", r.max_cost_usd)
    let mut cum = r.cumulative_cost_usd
    if len(cum) == 0 { cum = "0.0" }
    let _ = json_object_set(row, "cumulative_cost_usd", cum)
    _reg_set_str(row, "cost_per_hr_usd", r.cost_per_hr_usd)
    _reg_set_num(row, "owner_pid", r.owner_pid)
    _reg_set_str(row, "last_heartbeat", r.last_heartbeat)
    _reg_set_num(row, "max_ttl_sec", r.max_ttl_sec)
}

// _reg_write_file — rewrite ONE ING.jsonl file applying `recs` (the records
// that belong to this file). Per line: a `kind:"pod"` row whose id matches a
// record is MERGED in place (preserving its non-registry fields) and the
// record marked written; every other line (work/next, other pods, anything)
// is re-emitted verbatim. Records with no existing row are appended as fresh
// pod rows. Records that carry `_remove==1` (id in `remove_ids`) drop their row
// entirely. Atomic: mktemp in the file's dir + `.bak` snapshot + `mv -f`.
fn _reg_write_file(path: str, recs: [PodRecord], remove_ids: [str]) {
    // ensure the parent dir exists (a project repo always will; cwd always does).
    let dir = exec("dirname " + _reg_shq(path) + " 2>/dev/null").trim()
    if len(dir) > 0 {
        let _ = exec("mkdir -p " + _reg_shq(dir) + " 2>/dev/null")
    }
    let mut written = []   // ids of recs already merged onto an existing row
    let mut out = ""
    if file_exists(path) {
        let body = read_file(path)
        let lines = body.split("\n")
        let mut i = 0
        while i < len(lines) {
            let ln = lines[i].trim()
            if len(ln) == 0 {
                i = i + 1
                continue
            }
            let row = json_parse(ln)
            let is_pod = json_object_get_str(row, "kind", "") == "pod"
            let rid = json_object_get_str(row, "id", "")
            if is_pod && _recon_id_in(remove_ids, rid) == 1 {
                // dropped pod — skip this line entirely.
                i = i + 1
                continue
            }
            let mut handled = 0
            if is_pod && len(rid) > 0 {
                let mut k = 0
                while k < len(recs) {
                    if recs[k].id == rid {
                        _reg_merge_record_into_row(row, recs[k])
                        written.push(rid)
                        handled = 1
                        k = len(recs)
                    } else {
                        k = k + 1
                    }
                }
            }
            if handled == 1 {
                out = out + json_stringify_value(row) + "\n"
            } else {
                // verbatim — work/next, other pods, anything else.
                out = out + ln + "\n"
            }
            i = i + 1
        }
    }
    // append any record that had no existing row (and isn't being removed).
    let mut a = 0
    while a < len(recs) {
        let r = recs[a]
        if _recon_id_in(written, r.id) == 0 && _recon_id_in(remove_ids, r.id) == 0 {
            let row = json_parse("{}")
            _reg_merge_record_into_row(row, r)
            out = out + json_stringify_value(row) + "\n"
        }
        a = a + 1
    }
    // atomic write (mktemp in the target dir + .bak rotation + rename).
    if file_exists(path) {
        let _ = exec("cp -p " + _reg_shq(path) + " " + _reg_shq(path) + ".bak 2>/dev/null")
    }
    let tmp = path + ".tmp." + _m5_pid()
    write_file(tmp, out)
    let _ = exec("mv -f " + _reg_shq(tmp) + " " + _reg_shq(path) + " 2>/dev/null")
}

// _reg_target_file — the home ING.jsonl a record persists to: its loaded
// `src`, else the owning project's repo file (`_reg_project_file`).
fn _reg_target_file(r: PodRecord) -> str {
    if len(r.src) > 0 {
        return r.src
    }
    return _reg_project_file(r.project)
}

// _reg_persist_one — persist a SINGLE mutated record to its home file (merge
// in place, preserving every other row). This is the common write path for the
// per-id mutators (add/update/set_*) — it touches ONLY the affected file, so a
// status flip never rewrites sibling repos' ING.jsonl. Atomic + .bak per file.
fn _reg_persist_one(r: PodRecord) {
    let path = _reg_target_file(r)
    let mut recs = []
    recs.push(r)
    let no_remove = []
    _reg_write_file(path, recs, no_remove)
}

// _reg_remove_one — drop a SINGLE record's pod row from its home file (the
// confirmed-teardown path), preserving every other row. Atomic + .bak.
fn _reg_remove_one(r: PodRecord) {
    let path = _reg_target_file(r)
    let no_recs = []
    let mut rm = []
    rm.push(r.id)
    _reg_write_file(path, no_recs, rm)
}

// _m5_write_atomic — persist the full record set across its per-project home
// ING.jsonl files (used by bulk callers). Records are grouped by target file;
// each touched file is rewritten via _reg_write_file (merge-preserving every
// other row). The per-id mutators use _reg_persist_one instead (single file).
fn _m5_write_atomic(records: [PodRecord]) {
    // Collect the distinct target files + the records routed to each.
    let mut files = []
    let mut i = 0
    while i < len(records) {
        let tgt = _reg_target_file(records[i])
        if _recon_id_in(files, tgt) == 0 { files.push(tgt) }
        i = i + 1
    }
    let mut f = 0
    while f < len(files) {
        let path = files[f]
        let mut recs = []
        let mut j = 0
        while j < len(records) {
            if _reg_target_file(records[j]) == path { recs.push(records[j]) }
            j = j + 1
        }
        let no_remove = []
        _reg_write_file(path, recs, no_remove)
        f = f + 1
    }
}

// _m5_find — return the index of `pod_id` in `records`, or -1.
fn _m5_find(records: [PodRecord], pod_id: str) -> int {
    let mut i = 0
    while i < len(records) {
        if records[i].id == pod_id {
            return i
        }
        i = i + 1
    }
    return -1
}

// pod_registry_add — register a freshly-rented pod. Idempotent on `id`
// (same id → update in place, preserving created_at). Returns 1 on
// success, 0 on empty id.
fn pod_registry_add(pod_id: str, provider: str, project: str, purpose: str, ssh_host: str, ssh_port: str, status: str) -> int {
    if len(pod_id) == 0 {
        return 0
    }
    if _pod_id_looks_valid(pod_id) == 0 {
        eprintln("[cloud] M5: refusing non-pod-id '" + pod_id + "'")
        return 0
    }
    let mut records = pod_registry_load()
    let now = _reg_now_iso()
    let agent_tag = env_var("HEXA_AGENT_TAG")
    let idx = _m5_find(records, pod_id)
    if idx >= 0 {
        // update in place, preserve created_at + project/purpose attribution
        // (a status flip / ssh-ready update must NOT erase the owning project;
        // a non-empty incoming value overrides, "" keeps the prior).
        let prev = records[idx]
        let mut proj = prev.project
        if len(project) > 0 {
            proj = project
        }
        let mut purp = prev.purpose
        if len(purpose) > 0 {
            purp = purpose
        }
        // Preserve a known provider when the caller passes "" (e.g. `adopt`
        // stamping project/purpose without re-asserting the provider).
        let mut prov = prev.provider
        if len(provider) > 0 {
            prov = provider
        }
        // Preserve the prior status when the caller passes "" — a pure
        // attribution re-stamp (`cloud attribute`) must NOT reset a live
        // pod's status to empty. A non-empty incoming status overrides.
        let mut st = prev.status
        if len(status) > 0 {
            st = status
        }
        // Preserve prior ssh coordinates when the caller passes "" so an
        // attribution-only update never erases a resolved host/port.
        let mut sh = prev.ssh_host
        if len(ssh_host) > 0 {
            sh = ssh_host
        }
        let mut sp = prev.ssh_port
        if len(ssh_port) > 0 {
            sp = ssh_port
        }
        records[idx] = PodRecord {
            id: pod_id,
            provider: prov,
            created_at: prev.created_at,
            rented_by: prev.rented_by,
            project: proj,
            purpose: purp,
            ssh_host: sh,
            ssh_port: sp,
            status: st,
            ttl_sec: prev.ttl_sec,
            max_cost_usd: prev.max_cost_usd,
            cumulative_cost_usd: prev.cumulative_cost_usd,
            cost_per_hr_usd: prev.cost_per_hr_usd,
            // An in-place update (status flip / ssh-ready) doubles as a
            // liveness heartbeat — the owning agent is demonstrably still
            // alive, so refresh last_heartbeat; preserve owner_pid/max_ttl.
            owner_pid: prev.owner_pid,
            last_heartbeat: now,
            max_ttl_sec: prev.max_ttl_sec,
            src: prev.src
        }
        _reg_persist_one(records[idx])
    } else {
        // First rent — stamp the M6 heartbeat-TTL owner-death/expiry signal:
        // the owning OS pid (kill -0 liveness), a last-heartbeat ts, and a
        // default max-ttl (env HEXA_CLOUD_MAX_TTL_SEC, else 6h). The reaper
        // treats a still-billing pod as dead-owned when the pid is gone OR
        // (now − last_heartbeat) > max_ttl_sec.
        let fresh = PodRecord {
            id: pod_id,
            provider: provider,
            created_at: now,
            rented_by: agent_tag,
            project: project,
            purpose: purpose,
            ssh_host: ssh_host,
            ssh_port: ssh_port,
            status: status,
            ttl_sec: -1,
            max_cost_usd: "",
            cumulative_cost_usd: "0.0",
            cost_per_hr_usd: "",
            owner_pid: _reg_owner_pid(),
            last_heartbeat: now,
            max_ttl_sec: _reg_default_max_ttl_sec(),
            src: ""
        }
        _reg_persist_one(fresh)
    }
    return 1
}

// pod_registry_update_status — flip a pod's status (READY → STOPPING,
// etc.). Returns 1 on a successful flip, 0 if `pod_id` is absent.
fn pod_registry_update_status(pod_id: str, status: str) -> int {
    if len(pod_id) == 0 {
        return 0
    }
    let mut records = pod_registry_load()
    let idx = _m5_find(records, pod_id)
    if idx < 0 {
        return 0
    }
    let prev = records[idx]
    records[idx] = PodRecord {
        id: prev.id,
        provider: prev.provider,
        created_at: prev.created_at,
        rented_by: prev.rented_by,
        project: prev.project,
        purpose: prev.purpose,
        ssh_host: prev.ssh_host,
        ssh_port: prev.ssh_port,
        status: status,
        ttl_sec: prev.ttl_sec,
        max_cost_usd: prev.max_cost_usd,
        cumulative_cost_usd: prev.cumulative_cost_usd,
        cost_per_hr_usd: prev.cost_per_hr_usd,
        // A status flip is owner activity → refresh the heartbeat.
        owner_pid: prev.owner_pid,
        last_heartbeat: _reg_now_iso(),
        max_ttl_sec: prev.max_ttl_sec,
        src: prev.src
    }
    _reg_persist_one(records[idx])
    return 1
}

// pod_registry_set_limits — populate the M2 (ttl_sec) + M3 (max_cost_usd +
// cost_per_hr_usd) guard fields on a tracked pod. `ttl_sec < 0` /
// `max_cost_usd == ""` leave that limit UNSET (no enforcement). The hourly
// rate (`cost_per_hr_usd`, captured from the provider offer at rent time) is
// the M3 cost-cap accrual source — the sweep derives cumulative cost on read
// from `(now − created_at) × rate`. "" leaves no rate (cost-cap inert; TTL
// still works). Called by `cloud rent` after the pod reaches READY. Returns
// 1 on a successful set, 0 if absent.
fn pod_registry_set_limits(pod_id: str, ttl_sec: int, max_cost_usd: str, cost_per_hr_usd: str) -> int {
    if len(pod_id) == 0 {
        return 0
    }
    let mut records = pod_registry_load()
    let idx = _m5_find(records, pod_id)
    if idx < 0 {
        return 0
    }
    let prev = records[idx]
    records[idx] = PodRecord {
        id: prev.id,
        provider: prev.provider,
        created_at: prev.created_at,
        rented_by: prev.rented_by,
        project: prev.project,
        purpose: prev.purpose,
        ssh_host: prev.ssh_host,
        ssh_port: prev.ssh_port,
        status: prev.status,
        ttl_sec: ttl_sec,
        max_cost_usd: max_cost_usd,
        cumulative_cost_usd: prev.cumulative_cost_usd,
        cost_per_hr_usd: cost_per_hr_usd,
        owner_pid: prev.owner_pid,
        last_heartbeat: prev.last_heartbeat,
        max_ttl_sec: prev.max_ttl_sec,
        src: prev.src
    }
    _reg_persist_one(records[idx])
    return 1
}

// pod_registry_set_dph — stamp ONLY the captured hourly rate (cost_per_hr_usd,
// the provider dph at rent time) on a tracked pod, leaving every other field
// (incl. ttl/max-cost) untouched. `cloud rent` calls this UNCONDITIONALLY at
// READY so `cloud list` can render the dph column even when no cost-cap flag was
// passed (set_limits only fires behind --ttl/--max-cost). Idempotent; a blank
// rate is a no-op so a later real rate is never clobbered by "". Returns 1 on a
// set, 0 if the pod is absent or the rate is blank.
fn pod_registry_set_dph(pod_id: str, cost_per_hr_usd: str) -> int {
    if len(pod_id) == 0 || len(cost_per_hr_usd) == 0 {
        return 0
    }
    let mut records = pod_registry_load()
    let idx = _m5_find(records, pod_id)
    if idx < 0 {
        return 0
    }
    let prev = records[idx]
    records[idx] = PodRecord {
        id: prev.id,
        provider: prev.provider,
        created_at: prev.created_at,
        rented_by: prev.rented_by,
        project: prev.project,
        purpose: prev.purpose,
        ssh_host: prev.ssh_host,
        ssh_port: prev.ssh_port,
        status: prev.status,
        ttl_sec: prev.ttl_sec,
        max_cost_usd: prev.max_cost_usd,
        cumulative_cost_usd: prev.cumulative_cost_usd,
        cost_per_hr_usd: cost_per_hr_usd,
        owner_pid: prev.owner_pid,
        last_heartbeat: prev.last_heartbeat,
        max_ttl_sec: prev.max_ttl_sec,
        src: prev.src
    }
    _reg_persist_one(records[idx])
    return 1
}

// pod_registry_find_by_purpose — IDEMPOTENT-RENT lookup. Returns the id of
// an EXISTING live pod (status RENTING or READY) that already owns the same
// (project, purpose) key, or "" when none is tracked. This is the core of
// the rent-leak fix (2026-05-31 orphan incident): a repeated `cloud rent`
// for the SAME purpose reuses the live pod instead of provisioning another.
//
// Match rule: project AND purpose must match EXACTLY (both non-empty), and
// the record's status must be RENTING|READY (a STOPPING/GONE pod is on its
// way out and must NOT be reused). A blank project or purpose disables the
// dedup (returns "") — an unattributed rent has no stable key to dedup on,
// so it falls through to the FIRST-rent path (preserves legacy behavior).
//
// First match wins (the oldest live pod for the key); GONE/STOPPING skipped.
fn pod_registry_find_by_purpose(project: str, purpose: str) -> str {
    if len(project) == 0 || len(purpose) == 0 {
        return ""
    }
    let records = pod_registry_load()
    let mut i = 0
    while i < len(records) {
        let r = records[i]
        if r.project == project && r.purpose == purpose {
            if r.status == "RENTING" || r.status == "READY" {
                return r.id
            }
        }
        i = i + 1
    }
    return ""
}

// _usd_cents — parse a USD string ("5" / "5.00" / "0.50") to integer cents.
// Avoids float; 2-decimal precision is enough for a cost cap. "" / junk → 0.
fn _usd_cents(s: str) -> int {
    let n = len(s)
    if n == 0 {
        return 0
    }
    let mut dollars = 0
    let mut cents = 0
    let mut seen_dot = false
    let mut dec_digits = 0
    let mut i = 0
    while i < n {
        let c = s.substring(i, i + 1)
        if c == "." {
            seen_dot = true
        } else {
            let cc = char_code(c)
            if cc >= 48 && cc <= 57 {
                if !seen_dot {
                    dollars = dollars * 10 + (cc - 48)
                } else if dec_digits < 2 {
                    cents = cents * 10 + (cc - 48)
                    dec_digits = dec_digits + 1
                }
            }
        }
        i = i + 1
    }
    while dec_digits < 2 {
        cents = cents * 10
        dec_digits = dec_digits + 1
    }
    return dollars * 100 + cents
}

// _sweep_confirm_gone — robustness cross-check for an ASYNC teardown that
// reported failure. vast's `destroy instance` is async: the destroy command
// can be ACCEPTED (and the instance genuinely on its way out) while a tight
// follow-up `show instance` STILL reports `running` for a few seconds — so
// vast_destroy's own immediate cross-verify (vast.hexa `_vast_instance_still_live`)
// returns ok=0 even though the destroy succeeded (the M2 LIVE-test false
// negative). After such an ok=0, we poll the provider's LIVE id list a few
// times: if the id has DROPPED OUT of the live set, the teardown is CONFIRMED
// gone and the sweep may safely remove + count it.
//
// SAFETY: returns 1 (confirmed gone) ONLY when the provider list query
// SUCCEEDED (ok == 1) AND the id is ABSENT. An unavailable / errored list
// (ok == 0 → empty ids) is the honest "I can't see that provider" degrade and
// must NEVER be read as "gone" — otherwise a transient CLI failure would
// silently drop a still-billing pod from the registry. So a failed query keeps
// the FAILED posture (return 0 → caller leaves the pod in the registry).
fn _sweep_confirm_gone(provider: str, pod_id: str) -> int {
    let mut attempt = 0
    // 3 polls × ~4s settle each = up to ~12s for the async teardown to clear
    // the live list, then give up (honest FAILED) rather than block forever.
    while attempt < 3 {
        let _settle = exec("sleep 4 2>/dev/null || sleep 1")
        if provider == "vast" {
            let vl = vast_list_instances()
            if vl.ok == 1 && _recon_id_in(vl.instance_ids, pod_id) == 0 {
                return 1
            }
        } else if provider == "runpod" {
            let rl = runpod_list_pods()
            if rl.ok == 1 && _recon_id_in(rl.pod_ids, pod_id) == 0 {
                return 1
            }
        }
        attempt = attempt + 1
    }
    return 0
}

// _accrued_cents — integer-only cost accrual: an hourly rate (`rate_usd`, e.g.
// "0.412") billed over `elapsed_sec` → cumulative cost in cents. Float-free:
// rate_cents = _usd_cents(rate_usd), then cents = rate_cents × elapsed_sec /
// 3600 (integer division, truncating sub-cent). `elapsed_sec <= 0` or an
// unparseable / zero rate → 0 (cost-cap stays inert, never false-fires).
fn _accrued_cents(rate_usd: str, elapsed_sec: int) -> int {
    if elapsed_sec <= 0 {
        return 0
    }
    let rate_cents = _usd_cents(rate_usd)
    if rate_cents <= 0 {
        return 0
    }
    return rate_cents * elapsed_sec / 3600
}

// pod_registry_limit_sweep — M2/M3 enforcement. Scan the registry; for each
// ALIVE pod that has OPTED IN to a limit (ttl_sec >= 0 or max_cost_usd set)
// AND BREACHED it, tear the pod down (runpod_terminate / vast_destroy) +
// remove it. Pods with no limit set (ttl_sec < 0 AND max_cost_usd == "") are
// NEVER touched — the opt-in invariant. dry_run == 1 → report only, no kill.
//   M2 (TTL): elapsed = now − created_at ≥ ttl_sec.
//   M3 (cost): cumulative ≥ max_cost_usd (cents compare). Cumulative is DERIVED
//              ON READ from the captured hourly rate: cumulative = cost_per_hr_usd
//              × (now − created_at). No per-sweep write (idempotent). A pod with
//              max_cost_usd set but no captured rate (cost_per_hr_usd == "") is
//              cost-inert — its TTL guard still applies.
// `api_key` is consumed only by runpod_terminate when an actual kill fires.
// Returns the number of pods torn down (0 under dry_run).
fn pod_registry_limit_sweep(api_key: str, dry_run: int) -> int {
    let records = pod_registry_load()
    let now = _reg_now_sec()
    let mut killed = 0
    let mut i = 0
    while i < len(records) {
        let r = records[i]
        if r.status != "GONE" {
            let has_ttl = r.ttl_sec >= 0
            let has_cost = len(r.max_cost_usd) > 0
            if has_ttl || has_cost {
                let mut breach = false
                let mut why = ""
                if has_ttl && now > 0 {
                    let born = _reg_iso_to_sec(r.created_at)
                    if born > 0 {
                        let elapsed = now - born
                        if elapsed >= r.ttl_sec {
                            breach = true
                            why = "TTL " + str(elapsed) + "s ≥ " + str(r.ttl_sec) + "s"
                        }
                    }
                }
                if has_cost && !breach {
                    // Derived-on-read accrual: cumulative = rate × elapsed.
                    // Idempotent (no per-sweep write); needs both a captured
                    // hourly rate AND a parseable created_at. Missing either →
                    // skip (cost-cap inert, never false-fires). The TTL guard
                    // still protects rate-less pods.
                    let cap_c = _usd_cents(r.max_cost_usd)
                    if cap_c > 0 && len(r.cost_per_hr_usd) > 0 && now > 0 {
                        let born_c = _reg_iso_to_sec(r.created_at)
                        if born_c > 0 {
                            let elapsed_c = now - born_c
                            let cum_c = _accrued_cents(r.cost_per_hr_usd, elapsed_c)
                            if cum_c >= cap_c {
                                breach = true
                                let cum_dollars = cum_c / 100
                                let cum_rem = cum_c - cum_dollars * 100
                                let mut cum_str = str(cum_dollars) + "."
                                if cum_rem < 10 {
                                    cum_str = cum_str + "0"
                                }
                                cum_str = cum_str + str(cum_rem)
                                why = "cost ~$" + cum_str + " (" + r.cost_per_hr_usd + "/hr × " + str(elapsed_c) + "s) ≥ $" + r.max_cost_usd
                            }
                        }
                    }
                }
                if breach {
                    if dry_run == 1 {
                        eprintln("[cloud] watchdog DRY: " + r.id + " (" + r.provider + ") would teardown — " + why)
                    } else {
                        eprintln("[cloud] watchdog: " + r.id + " (" + r.provider + ") teardown — " + why)
                        let mut term_ok = 0
                        if r.provider == "runpod" {
                            term_ok = runpod_terminate(api_key, r.id)
                        } else if r.provider == "vast" {
                            let vi = vast_destroy(r.id)
                            if vi.ok == 1 {
                                term_ok = 1
                            }
                        }
                        // ASYNC false-negative guard: a teardown that reported
                        // failure may still have SUCCEEDED (vast's destroy is
                        // async — the instance lingers in `show instance` for a
                        // few seconds, so vast_destroy's immediate cross-verify
                        // returns ok=0). Before honoring the FAILED report, poll
                        // the provider's live id list: if the id has dropped out,
                        // the teardown is CONFIRMED gone. A failed/unavailable
                        // list query stays FAILED (safe posture — never removes a
                        // pod we cannot confirm gone).
                        if term_ok == 0 {
                            if _sweep_confirm_gone(r.provider, r.id) == 1 {
                                eprintln("[cloud] watchdog: " + r.id + " teardown CONFIRMED gone on re-check (async settle) — removing")
                                term_ok = 1
                            }
                        }
                        if term_ok == 1 {
                            let _ = pod_registry_remove(r.id)
                            killed = killed + 1
                        } else {
                            eprintln("[cloud] watchdog: " + r.id + " teardown FAILED — manual destroy required")
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return killed
}

// ── budget cross-ref (Q4 — watchdog honors a ./pods.json budget.cap) ──
//
// The per-project ./pods.json may declare a spend ceiling (budget.cap). The
// watchdog cross-refs it: on breach it kills the LOWEST-VALUE running pod (g64
// honor-cap — sacrifice the cheapest pod first to claw spend back under cap).
// These helpers expose the cost accrual + selection so cloud_cli can wire the
// guard WITHOUT duplicating the private cents/accrual math (d4 single source).

// pod_registry_total_accrued_cents — sum of derived-on-read accrued cost
// (cost_per_hr × elapsed) across every ALIVE pod, in integer cents. A pod
// with no captured rate / unparseable created_at contributes 0 (conservative
// — never over-counts). This is the watchdog's "current spend" estimate to
// compare against budget.cap.
pub fn pod_registry_total_accrued_cents() -> int {
    let records = pod_registry_load()
    let now = _reg_now_sec()
    let mut total = 0
    let mut i = 0
    while i < len(records) {
        let r = records[i]
        if r.status != "GONE" && now > 0 && len(r.cost_per_hr_usd) > 0 {
            let born = _reg_iso_to_sec(r.created_at)
            if born > 0 {
                total = total + _accrued_cents(r.cost_per_hr_usd, now - born)
            }
        }
        i = i + 1
    }
    return total
}

// pod_registry_lowest_value_id — the ALIVE pod whose accrued cost is lowest
// (the cheapest to sacrifice when over budget). Ties broken by registry
// order. Returns "" when no alive pod is tracked. "value" = accrued cost so
// far: killing the lowest-accrued pod claws back the least sunk spend while
// reducing the ongoing burn rate.
pub fn pod_registry_lowest_value_id() -> str {
    let records = pod_registry_load()
    let now = _reg_now_sec()
    let mut best_id = ""
    let mut best_cents = -1
    let mut i = 0
    while i < len(records) {
        let r = records[i]
        if r.status != "GONE" {
            let mut c = 0
            if now > 0 && len(r.cost_per_hr_usd) > 0 {
                let born = _reg_iso_to_sec(r.created_at)
                if born > 0 {
                    c = _accrued_cents(r.cost_per_hr_usd, now - born)
                }
            }
            if best_cents < 0 || c < best_cents {
                best_cents = c
                best_id = r.id
            }
        }
        i = i + 1
    }
    return best_id
}

// pod_registry_provider_of — provider string ("vast"|"runpod"|...) for a
// tracked id, "" when absent. Lets the budget killer pick the teardown path.
pub fn pod_registry_provider_of(pod_id: str) -> str {
    let records = pod_registry_load()
    let mut i = 0
    while i < len(records) {
        if records[i].id == pod_id {
            return records[i].provider
        }
        i = i + 1
    }
    return ""
}

// pod_registry_project_of — the owning project stamped on a tracked pod
// (the M5 down-guard attribution), or "" if the pod is absent. Symmetric
// with pod_registry_provider_of; lets cloud_cli echo the effective value
// after an `attribute` re-stamp without re-loading the registry by hand.
pub fn pod_registry_project_of(pod_id: str) -> str {
    let records = pod_registry_load()
    let mut i = 0
    while i < len(records) {
        if records[i].id == pod_id {
            return records[i].project
        }
        i = i + 1
    }
    return ""
}

// pod_registry_is_tracked — 1 if `pod_id` already has a registry record
// (any status, including closed), else 0. A reliable presence test that
// `provider_of` cannot give (provider may legitimately be ""). Used by the
// `attribute` verb to distinguish a re-stamp on an ALREADY-tracked pod from
// `adopt`, which is for untracked ORPHANS.
pub fn pod_registry_is_tracked(pod_id: str) -> int {
    let records = pod_registry_load()
    if _m5_find(records, pod_id) >= 0 {
        return 1
    }
    return 0
}

// pod_registry_usd_to_cents — public wrapper over the private cents parser so
// cloud_cli can compare a budget.cap USD string against accrued cents without
// re-implementing the parse (d4 single source).
pub fn pod_registry_usd_to_cents(s: str) -> int {
    return _usd_cents(s)
}

// pod_registry_remove — drop a pod from the registry (confirmed teardown).
// Returns 1 on a successful removal, 0 if `pod_id` is absent.
fn pod_registry_remove(pod_id: str) -> int {
    if len(pod_id) == 0 {
        return 0
    }
    let records = pod_registry_load()
    let idx = _m5_find(records, pod_id)
    if idx < 0 {
        return 0
    }
    // Drop only this pod's row from its home file (preserve every other row).
    _reg_remove_one(records[idx])
    return 1
}

// pod_registry_list — return only alive pods (status != "GONE"). External
// readers (`cloud reap`, dashboards) use this to enumerate live billing
// pods after an agent crash.
fn pod_registry_list() -> [PodRecord] {
    let all = pod_registry_load()
    let mut out = []
    let mut i = 0
    while i < len(all) {
        if all[i].status != "GONE" {
            out.push(all[i])
        }
        i = i + 1
    }
    return out
}

// ── M6 — orphan finder (cloud reap) ───────────────────────────────────
//
// Orphan = pod alive on the provider but absent from the M5 registry
// (`~/.hx/cloud/active-pods.json`). The inverse (registry-tracked but
// provider-gone) is handled by `cloud reconcile` (GHOST) — keep `reap`
// scoped to billing-leaks only.
//
// `cloud reap` bare = dry-run (enumerate + print). `--apply` = destroy
// each orphan via the existing `_cloud_down` path.

// Orphan — one classified orphan row for the `cloud reap` table.
struct Orphan {
    id:       str,
    provider: str    // "runpod" | "vast"
}

// pod_registry_orphans — set-diff over the provider's alive id list and
// the M5 registry id list: an id alive on the provider but absent from
// the registry is an orphan. Pure over its inputs so a network-free test
// can drive it with mock id lists. `provider_label` is stamped onto each
// returned row (the caller knows which provider it queried).
fn pod_registry_orphans(provider_alive_ids: [str], registry_ids: [str], provider_label: str) -> [Orphan] {
    let mut out = []
    let mut i = 0
    while i < len(provider_alive_ids) {
        let pid = provider_alive_ids[i]
        let mut tracked = 0
        let mut k = 0
        while k < len(registry_ids) {
            if registry_ids[k] == pid {
                tracked = 1
                k = len(registry_ids)
            } else {
                k = k + 1
            }
        }
        if tracked == 0 {
            out.push(Orphan { id: pid, provider: provider_label })
        }
        i = i + 1
    }
    return out
}

// -- M6 reap-guard - DEAD-OWNER / TTL-EXPIRED sweep --------------------
//
// Complements pod_registry_orphans (provider-alive-but-untracked). This axis
// is the inverse leak the live incident exposed: a pod the registry KNOWS it
// owns, still ALIVE on the provider, whose OWNING AGENT IS DEAD (rate-limit
// storm killed it) so it never tore the pod down. Reap criteria (g63 - every
// decision is against authoritative provider-alive ids + recorded owner pid /
// heartbeat, never a fabricated state):
//   REAP  iff  the pod is alive on the provider
//         AND  it is positively anima/agent-owned (project/rented_by non-empty)
//         AND  ( owner_pid is DEAD (kill -0 -> gone)
//                OR (now - last_heartbeat) > max_ttl_sec )
// FAIL-SAFE: a pod with NO ownership attribution (blank project AND blank
// rented_by) is NEVER reaped (could be a foreign/protected pod) - it surfaces
// only via the orphan axis for human review. An UNDETERMINED liveness probe
// (owner_alive == -1) does NOT by itself reap; the TTL axis must also fire.

struct ReapDead {
    id:       str,
    provider: str,
    reason:   str    // "owner-dead" | "ttl-expired" | "owner-dead+ttl"
}

// pod_registry_reap_dead_rows - PURE classifier over explicit inputs so a
// network-free test drives it with canned rows. `owner_alive` per row is a
// tri-value (1 alive / 0 dead / -1 undetermined) the CALLER resolves (via
// pod_registry_owner_alive) - keeping the kill -0 side-effect out of the pure
// core. A pod absent from `provider_alive_ids` is NOT reaped here (it is a
// GHOST - reconcile's job, never billing). `now_sec <= 0` disables the TTL
// axis (degrade to owner-pid-only rather than mis-expire on a broken clock).
fn pod_registry_reap_dead_rows(records: [PodRecord], provider_alive_ids: [str], owner_alive: [int], now_sec: int) -> [ReapDead] {
    let mut out = []
    let mut i = 0
    while i < len(records) {
        let r = records[i]
        // owned = positively anima/agent-attributed (1) vs unattributed (0).
        let mut owned = 0
        if len(r.project) > 0 { owned = 1 }
        if len(r.rented_by) > 0 { owned = 1 }
        // alive on provider (1) - only a billing pod can leak.
        let mut alive = 0
        if _recon_id_in(provider_alive_ids, r.id) == 1 { alive = 1 }
        // owner_pid DEAD (the per-row liveness the caller resolved; 0 = dead).
        let mut dead = 0
        if i < len(owner_alive) {
            if owner_alive[i] == 0 { dead = 1 }
        }
        // heartbeat silent past max-ttl (TTL axis; clock<=0 disables it).
        let mut ttl_expired = 0
        if now_sec > 0 {
            if r.max_ttl_sec >= 0 {
                if len(r.last_heartbeat) > 0 {
                    let hb = _reg_iso_to_sec(r.last_heartbeat)
                    if hb >= 0 {
                        if (now_sec - hb) > r.max_ttl_sec { ttl_expired = 1 }
                    }
                }
            }
        }
        if alive == 1 {
            if owned == 1 {
                if dead == 1 {
                    if ttl_expired == 1 {
                        out.push(ReapDead { id: r.id, provider: r.provider, reason: "owner-dead+ttl" })
                    } else {
                        out.push(ReapDead { id: r.id, provider: r.provider, reason: "owner-dead" })
                    }
                } else {
                    if ttl_expired == 1 {
                        out.push(ReapDead { id: r.id, provider: r.provider, reason: "ttl-expired" })
                    }
                }
            }
        }
        i = i + 1
    }
    return out
}
