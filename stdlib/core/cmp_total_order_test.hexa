// stdlib/core/cmp_total_order_test.hexa
//
// OP-121 — comparator / total-order guard test (HEXA-0POD campaign).
//
// hexa `int` is 64-bit SIGNED and WRAPS on overflow (confirmed real in
// OP-118: ASN.1 length wrap, websocket 64-bit top-bit). A comparator of
// the form `cmp(a, b) := a - b` therefore returns the WRONG SIGN whenever
// `a - b` overflows the i64 range — e.g. large-magnitude or opposite-sign
// operands — silently BREAKING the strict total order a sort / heap /
// binary-search relies on, producing MIS-SORTED output.
//
// The correct form is a BRANCH COMPARE:
//     if a < b { return -1 }; if a > b { return 1 }; return 0
//
// This test is a REGRESSION GUARD + LEAF ORACLE locking that:
//   (1) the subtract-comparator anti-pattern DEMONSTRABLY mis-sorts on
//       extreme i64 inputs (the falsifier — it must reject), and
//   (2) the branch comparator gives the correct total order on the same
//       inputs (the oracle — it must accept), matching Python sorted().
//
// COVERAGE MATRIX (sweep OP-121, stdlib/ + self/, 2026-06-13) — every
// shipping comparator already uses branch-compare or BOUNDED subtraction
// (char-codes 0..0x10FFFF / non-negative lengths cannot wrap i64):
//   - stdlib/alloc/collections.hexa  sort            < (branch)   CLEAN
//   - stdlib/runtime/numeric.hexa    sort_float/_by  <= (branch)  CLEAN
//   - stdlib/crypto/{p256,secp256k1,rsa_pkcs1}.hexa  _cmp branch  CLEAN
//   - stdlib/semver.hexa · self/package.hexa  semver cmp branch   CLEAN
//   - stdlib/core/math/permille.hexa pm_cmp          branch       CLEAN
//   - stdlib/core/trait_design_fixture.hexa cmp_int/float/str br  CLEAN
//   - self/rt/core.hexa _rt_num_cmp branch · _rt_str_cmp ca-cb /
//     na-nb = BOUNDED (char-code & length) subtraction             SAFE
//   - self/runtime/heap_pure.hexa · sort_variants_pure.hexa  br   CLEAN
//   - self/stdlib/sort.hexa merge sort_by                  br     CLEAN
// => OP-121 verdict: 🟢 CONVERGED (0 total-order bugs). This file is the
//    guard locking that the cleared surface STAYS branch-compare.

let mut pass_count = 0
let mut fail_count = 0

fn check(name, actual, expected) {
    if to_string(actual) == to_string(expected) {
        println("[PASS] " + name)
        pass_count = pass_count + 1
    } else {
        println("[FAIL] " + name + " — got " + to_string(actual) + " want " + to_string(expected))
        fail_count = fail_count + 1
    }
}

// ── the two comparator forms ────────────────────────────────────

// BUGGY: subtraction wraps for opposite-sign / large-magnitude i64
fn cmp_sub(a, b) { return a - b }

// CORRECT: branch compare — never wraps, total order holds for all i64
fn cmp_branch(a, b) {
    if a < b { return 0 - 1 }
    if a > b { return 1 }
    return 0
}

// generic selection sort over a 3-element array using a passed comparator.
// (selection sort makes the comparator the SOLE decider of order, so a
// broken comparator deterministically yields a broken result.)
fn sort3(arr, cmp) {
    let mut r = [arr[0], arr[1], arr[2]]
    let mut i = 0
    while i < 3 {
        let mut j = i + 1
        while j < 3 {
            if cmp(r[j], r[i]) < 0 {
                let tmp = r[i]
                r[i] = r[j]
                r[j] = tmp
            }
            j = j + 1
        }
        i = i + 1
    }
    return r
}

fn main() {
    // i64 extremes — opposite sign, max magnitude.
    let big   = 9223372036854775807        // i64 max
    let small = 0 - 9223372036854775807    // near i64 min (-(2^63 - 1))
    // True total order: small < 0 < big.
    // Python oracle: sorted([big, small, 0]) == [small, 0, big].

    println("--- raw comparator sign on extremes (big vs small) ---")
    // CORRECT comparator: big > small => positive.
    check("branch(big,small) > 0", cmp_branch(big, small) > 0, true)
    // BUGGY comparator: big - small = 2*(2^63-1) WRAPS to a NEGATIVE value
    // => reports big < small => total order VIOLATED. We LOCK that the
    // wrap really happens (falsifier reproduced), so the guard is honest.
    check("sub(big,small) WRAPS to <= 0 (the bug)", cmp_sub(big, small) <= 0, true)

    println("")
    println("--- sort [big, small, 0] : branch=correct, sub=mis-sorts ---")
    let input = [big, small, 0]

    // ORACLE: branch comparator yields the true order [small, 0, big].
    let ok = sort3(input, cmp_branch)
    check("branch sort[0] == small", ok[0] == small, true)
    check("branch sort[1] == 0",     ok[1] == 0,     true)
    check("branch sort[2] == big",   ok[2] == big,   true)

    // FALSIFIER: subtract comparator does NOT reproduce the true order
    // (its first element is not `small`) — proving it is a real
    // total-order violator that a sort would silently propagate.
    let bad = sort3(input, cmp_sub)
    check("sub sort MIS-ORDERS (head != small)", bad[0] == small, false)

    println("")
    println("--- antisymmetry / trichotomy of the branch comparator ---")
    check("branch(a,b) == -branch(b,a) [extremes]",
          cmp_branch(big, small) == 0 - cmp_branch(small, big), true)
    check("branch(x,x) == 0", cmp_branch(big, big) == 0, true)
    // mid value preserves order both ways
    check("branch(0,big) < 0",   cmp_branch(0, big)   < 0, true)
    check("branch(0,small) > 0", cmp_branch(0, small) > 0, true)

    println("")
    println("═══════════════════════════════════════════════════════")
    println("  Results: " + to_string(pass_count) + " passed, " + to_string(fail_count) + " failed")
    println("═══════════════════════════════════════════════════════")

    if fail_count > 0 {
        println("FAIL")
        exit(1)
    }
    println("ALL PASS")
}
