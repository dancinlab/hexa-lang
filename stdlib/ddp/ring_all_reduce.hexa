// ════════════════════════════════════════════════════════════════════════════
//  ring_all_reduce.hexa — hexa-native ring all-reduce collective (DDP-M1).
//
//  WIP SKELETON — collective-correctness leg only. See HEXA-DDP DDP-M1.
//
//  Canonical ring all-reduce over N ranks, each holding a length-S vector.
//  The vector is split into N contiguous chunks; the algorithm runs in
//  2(N-1) communication steps:
//    Phase 1 — reduce-scatter (N-1 steps): in step i, rank r sends one chunk
//      to its right neighbour (r+1)%N and adds the chunk it receives from its
//      left neighbour (r-1+N)%N. After N-1 steps each rank owns the full SUM
//      of exactly one distinct chunk.
//    Phase 2 — all-gather (N-1 steps): circulate those fully-reduced chunks
//      around the ring so every rank ends holding the complete summed vector.
//
//  HARDWARE-FREE SIM: the N ranks are modelled as N rows of a single
//  host buffer (a flat float array of N*S elements, rank r at offset r*S).
//  The "transport" is a plain in-process array copy — M3 later swaps this
//  copy for real cudaMemcpyPeer / NVLink P2P with the schedule unchanged.
//
//  HONEST (g5): M1 proves the COLLECTIVE ALGORITHM is bit-exact vs a serial
//  elementwise sum. It does NOT mean parallel training runs — real
//  multi-GPU transport is M3 and multi-GPU hardware is M2 (the wildcard).
// ════════════════════════════════════════════════════════════════════════════

use "stdlib/flame/tensor_lib"

// chunk boundaries: split S into N contiguous chunks as evenly as possible.
// chunk c spans [chunk_start(c), chunk_start(c+1)). When S is not a multiple
// of N the first (S % N) chunks get one extra element (boundary case).
pub fn ring_chunk_start(S: int, N: int, c: int) -> int {
    if N <= 0 { return 0 }   // 0 ranks → S/N divide-by-zero
    let base = S / N
    let rem = S % N
    // each of the first `rem` chunks is (base+1); the rest are `base`.
    if c <= rem { return c * (base + 1) }
    return rem * (base + 1) + (c - rem) * base
}

// number of ring communication steps for the canonical schedule = 2(N-1).
pub fn ring_step_count(N: int) -> int {
    return 2 * (N - 1)
}

// Copy a chunk's worth of elements from one rank's row into another's.
// `t_get`/`t_set` are the flame tensor host-array accessors (RFC 040 farr).
fn _ring_copy_chunk(buf: int, S: int, src_rank: int, dst_rank: int,
                    start: int, stop: int, out: int) {
    let mut i = start
    while i < stop {
        t_set(out, dst_rank * S + i, t_get(buf, src_rank * S + i))
        i = i + 1
    }
}

// reduce-scatter phase (N-1 steps). In step i, rank r sends the chunk it is
// currently responsible for to its right neighbour and the receiver ADDS it.
// The send-chunk index for rank r at step i is (r - i + N) % N, so after the
// last step rank r holds the full sum of chunk (r + 1) % N.
//
// We materialise each step into a fresh staging buffer to model the
// simultaneous P2P sends of one ring step (no rank reads a value another
// rank has already overwritten within the same step) — exactly what the
// real transport guarantees.
fn _ring_reduce_scatter(buf: int, N: int, S: int) {
    let mut step = 0
    while step < N - 1 {
        // staging[dst_rank*S + i] = incoming chunk value to ADD at dst.
        let staging = t_zeros(N * S)
        let mut r = 0
        while r < N {
            let send_chunk = (r - step + N) % N
            let dst = (r + 1) % N
            let start = ring_chunk_start(S, N, send_chunk)
            let stop = ring_chunk_start(S, N, send_chunk + 1)
            _ring_copy_chunk(buf, S, r, dst, start, stop, staging)
            r = r + 1
        }
        // apply the adds (dst += incoming) for the chunks that moved.
        r = 0
        while r < N {
            let recv_chunk = ((r - 1 + N) % N - step + N) % N
            let start = ring_chunk_start(S, N, recv_chunk)
            let stop = ring_chunk_start(S, N, recv_chunk + 1)
            let mut i = start
            while i < stop {
                t_set(buf, r * S + i,
                      t_get(buf, r * S + i) + t_get(staging, r * S + i))
                i = i + 1
            }
            r = r + 1
        }
        step = step + 1
    }
}

// all-gather phase (N-1 steps). Each rank now owns one fully-reduced chunk;
// circulate them so every rank ends holding the complete summed vector.
// After reduce-scatter, rank r owns the reduced chunk (r + 1) % N. In step i
// rank r forwards the chunk (r - i + 1 + N) % N to its right neighbour
// (overwrite, no add).
fn _ring_all_gather(buf: int, N: int, S: int) {
    let mut step = 0
    while step < N - 1 {
        let staging = t_zeros(N * S)
        let mut r = 0
        while r < N {
            let send_chunk = (r - step + 1 + N) % N
            let dst = (r + 1) % N
            let start = ring_chunk_start(S, N, send_chunk)
            let stop = ring_chunk_start(S, N, send_chunk + 1)
            _ring_copy_chunk(buf, S, r, dst, start, stop, staging)
            r = r + 1
        }
        r = 0
        while r < N {
            let recv_chunk = (r - step + N) % N
            let start = ring_chunk_start(S, N, recv_chunk)
            let stop = ring_chunk_start(S, N, recv_chunk + 1)
            let mut i = start
            while i < stop {
                t_set(buf, r * S + i, t_get(staging, r * S + i))
                i = i + 1
            }
            r = r + 1
        }
        step = step + 1
    }
}

// Full ring all-reduce over `buf` (N rows of S elements, rank r at r*S).
// On return every rank's row holds the elementwise SUM across all N ranks.
// Total communication steps = ring_step_count(N) = 2(N-1) (canonical optimum).
pub fn ring_all_reduce(buf: int, N: int, S: int) {
    if N <= 1 { return }
    _ring_reduce_scatter(buf, N, S)
    _ring_all_gather(buf, N, S)
}
