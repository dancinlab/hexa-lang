// HEXA Standard Library — atlas_constants math-constant transcription KAT
//
// OP-144 (HEXA-0POD): named-mathematical-constant magic-literal lock.
// atlas_constants.hexa hard-codes the decimal expansions of well-known
// irrational constants (π, e, φ, √2, √3, √5, ζ(3), γ, Catalan, ln2).
// OP-144 found two CORRUPTED long expansions — the published-reference
// digit sequence diverged mid-string into wrong-sequence garbage:
//   • √3   — file correct for 215 frac digits then a wrong tail (idx 216+)
//   • ζ(3) — file correct for 125 frac digits then a wrong tail (idx 126+)
//          (Apéry's constant; the 20-sig-fig short value was fine — the
//           long `digits` field was the corrupted one.)
//
// Both were corrected against the canonical OEIS digit sequences:
//   π   A000796 · √2 A002193 · √3 A002194 · √5 A002163 · φ A001622
//   e   A001113 · ζ(3) A002117 · γ A001620 · Catalan A006752 · ln2 A002162
//
// This test pins the STORED frac field of every constant in the module
// against its published OEIS reference. `stored` below is copied verbatim
// from atlas_constants.hexa's MATH_CONSTANTS table; `ref` is the OEIS
// canonical prefix. The check asserts the stored expansion STARTS WITH
// the published reference — a single-digit transcription typo (the
// OP-140/OP-144 silent-wrong-constant class) flips a check → FAIL.

let mut pass_count = 0
let mut total_count = 0
let mut failed = ""

// stored starts-with ref ?
fn check_prefix(name: string, stored: string, ref: string) {
    total_count = total_count + 1
    let n = ref.len()
    let ok = stored.len() >= n && stored.substring(0, n) == ref
    if ok { pass_count = pass_count + 1 }
    else { if failed == "" { failed = name } }
}

fn main() {
    // pi — OEIS A000796 (frac digits, 60-digit reference prefix)
    check_prefix("pi",
        "",
        "141592653589793238462643383279502884197169399375105820974944")
    // e — A001113
    check_prefix("e",
        "",
        "718281828459045235360287471352662497757247093699959574966967")
    // phi — A001622
    check_prefix("phi_golden",
        "",
        "618033988749894848204586834365638117720309179805762862135448")
    // sqrt2 — A002193
    check_prefix("sqrt2",
        "",
        "414213562373095048801688724209698078569671875376948073176679")
    // sqrt3 — A002194  (FIXED in OP-144)
    check_prefix("sqrt3",
        "",
        "732050807568877293527446341505872366942805253810380628055806")
    // sqrt5 — A002163
    check_prefix("sqrt5",
        "",
        "236067977499789696409173668731276235440618359611525724270897")
    // zeta3 Apery — A002117  (FIXED in OP-144)
    check_prefix("zeta3",
        "",
        "202056903159594285399738161511449990764986292340498881792271")
    // euler_gamma — A001620
    check_prefix("euler_gamma",
        "",
        "577215664901532860606512090082402431042159335939923598805767")
    // catalan — A006752
    check_prefix("catalan",
        "91596559417721901505460351493238411077414937428167213426649811962176301977625476947935651292611510624857442261919619957031047742793818170546729779471720931551289871437960832983057830060949895041905849041290948",
        "915965594177219015054603514932384110774149374281672134266498")
    // ln2 — A002162
    check_prefix("ln2",
        "69314718055994530941723212145817656807550013436025525412068000949339362196969471560586332699641868754200148102057068573368552023575813055703267075163507596193072757082837143519030703862389167347112335011",
        "693147180559945309417232121458176568075500134360255254120680")

    if pass_count == total_count {
        println("PASS atlas_constants transcription KAT — " +
            to_string(pass_count) + "/" + to_string(total_count) +
            " constants match OEIS reference prefixes")
    } else {
        println("FAIL atlas_constants — first failing: " + failed +
            " (" + to_string(pass_count) + "/" + to_string(total_count) + ")")
    }
}
