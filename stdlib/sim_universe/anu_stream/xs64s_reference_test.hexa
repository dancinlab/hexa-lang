// HEXA Standard Library — sim_universe/anu_stream xorshift64* reference-vector test
//
// OP-140 (2026-06-13) regression lock. The output scrambler multiplier in
// client_example.hexa had a transcription error in its HIGH 32-bit word
// (625058449 = 0x2541A291 vs the correct 0x2545F491 = 625341585), silently
// diverging the emitted stream from the documented Vigna 2014 xorshift64*
// reference sequence. The low word (0x4F6CDD1D = 1332534557) was correct, so
// the bug hid behind a matching low-half. This test pins the FULL (hi, lo)
// 64-bit output for seed (hi=1, lo=1) against the canonical xorshift64*
// reference computed by a 64-bit oracle (numpy/python uint64). Any future
// drift in shifts (12/25/27), the multiplier, or the pair-arithmetic helpers
// re-fails this test.
//
// Reference (canonical xorshift64*, seed s = 0x0000000100000001):
//   step1: out = 0x84E9495AFD4C80BD -> hi=2229881178 lo=4249649341
//   step2:        0xFE7E298FEF5749ED -> hi=4270084175 lo=4015758125
//   step3:        0xD512F1E59F3247B1 -> hi=3574873509 lo=2671303217
//   step4:        0xF6AA8104C3F90BB7 -> hi=4138503428 lo=3287688887
//   step5:        0xD3E92069014EFA3C -> hi=3555259689 lo=351018684

let M32 = 4294967295

// ── pair-arithmetic helpers (ported verbatim from client_example.hexa) ──────
fn shl64_pair_hi(hi: int, lo: int, k: int) -> int {
    if k == 0 { return hi }
    if k == 32 { return lo & M32 }
    if k < 32 {
        let mut p = 1; let mut i = 0
        while i < k { p = p * 2; i = i + 1 }
        let mut q = 1; let mut j = 0
        while j < (32 - k) { q = q * 2; j = j + 1 }
        let hi_shifted = (hi * p) & M32
        let lo_top = lo / q
        (hi_shifted ^ lo_top) & M32
    } else {
        let kk = k - 32
        let mut p = 1; let mut i = 0
        while i < kk { p = p * 2; i = i + 1 }
        (lo * p) & M32
    }
}
fn shl64_pair_lo(lo: int, k: int) -> int {
    if k == 0 { return lo }
    if k >= 32 { return 0 }
    let mut p = 1; let mut i = 0
    while i < k { p = p * 2; i = i + 1 }
    (lo * p) & M32
}
fn shr64_pair_hi(hi: int, k: int) -> int {
    if k == 0 { return hi }
    if k >= 32 { return 0 }
    let mut p = 1; let mut i = 0
    while i < k { p = p * 2; i = i + 1 }
    hi / p
}
fn shr64_pair_lo(hi: int, lo: int, k: int) -> int {
    if k == 0 { return lo }
    if k == 32 { return hi & M32 }
    if k < 32 {
        let mut p = 1; let mut i = 0
        while i < k { p = p * 2; i = i + 1 }
        let mut q = 1; let mut j = 0
        while j < (32 - k) { q = q * 2; j = j + 1 }
        let lo_shifted = lo / p
        let hi_bottom = hi & (p - 1)
        let hi_bottom_up = (hi_bottom * q) & M32
        (lo_shifted ^ hi_bottom_up) & M32
    } else {
        let kk = k - 32
        let mut p = 1; let mut i = 0
        while i < kk { p = p * 2; i = i + 1 }
        hi / p
    }
}
fn u32mul_lo(a: int, b: int) -> int {
    let a_h = a / 65536
    let a_l = a % 65536
    let b_h = b / 65536
    let b_l = b % 65536
    let p_ll = a_l * b_l
    let mid = a_l * b_h + a_h * b_l
    let mid_lo = mid % 65536
    (p_ll + mid_lo * 65536) & M32
}
fn u32mul_full_hi(a: int, b: int) -> int {
    let a_h = a / 65536
    let a_l = a % 65536
    let b_h = b / 65536
    let b_l = b % 65536
    let p_ll = a_l * b_l
    let p_lh = a_l * b_h
    let p_hl = a_h * b_l
    let p_hh = a_h * b_h
    let mid = p_lh + p_hl
    let mid_hi = mid / 65536
    let mid_lo = mid % 65536
    let lo_sum = p_ll + mid_lo * 65536
    let carry = lo_sum / (M32 + 1)
    (p_hh + mid_hi + carry) & M32
}
fn mul64_hi(a_hi: int, a_lo: int, b_hi: int, b_lo: int) -> int {
    let ll_hi = u32mul_full_hi(a_lo, b_lo)
    let lh_lo = u32mul_lo(a_lo, b_hi)
    let hl_lo = u32mul_lo(a_hi, b_lo)
    (ll_hi + lh_lo + hl_lo) & M32
}
fn mul64_lo(a_lo: int, b_lo: int) -> int {
    u32mul_lo(a_lo, b_lo)
}

// ── xs64s_step — MUST use the CORRECTED multiplier hi word 625341585 ─────────
fn xs64s_step(shi: int, slo: int) -> [int] {
    let t1_hi = shr64_pair_hi(shi, 12)
    let t1_lo = shr64_pair_lo(shi, slo, 12)
    let a_hi = shi ^ t1_hi
    let a_lo = slo ^ t1_lo
    let t2_hi = shl64_pair_hi(a_hi, a_lo, 25)
    let t2_lo = shl64_pair_lo(a_lo, 25)
    let b_hi = a_hi ^ t2_hi
    let b_lo = a_lo ^ t2_lo
    let t3_hi = shr64_pair_hi(b_hi, 27)
    let t3_lo = shr64_pair_lo(b_hi, b_lo, 27)
    let new_hi = b_hi ^ t3_hi
    let new_lo = b_lo ^ t3_lo
    let out_hi = mul64_hi(new_hi, new_lo, 625341585, 1332534557)
    let out_lo = mul64_lo(new_lo, 1332534557)
    [new_hi, new_lo, out_hi, out_lo]
}

let mut pass_count = 0
let mut total_count = 0
let mut failed = ""

fn check_eq(name, got, want) {
    total_count = total_count + 1
    if got == want {
        pass_count = pass_count + 1
    } else {
        if failed == "" { failed = name }
        println("FAIL " + name + " got=" + to_string(got) + " want=" + to_string(want))
    }
}

// canonical reference vectors (hi, lo) for seed (1,1)
let exp_hi = [2229881178, 4270084175, 3574873509, 4138503428, 3555259689]
let exp_lo = [4249649341, 4015758125, 2671303217, 3287688887, 351018684]

let mut shi = 1
let mut slo = 1
let mut i = 0
while i < 5 {
    let r = xs64s_step(shi, slo)
    shi = r[0]
    slo = r[1]
    check_eq("xs64s hi[" + to_string(i) + "]", r[2], exp_hi[i])
    check_eq("xs64s lo[" + to_string(i) + "]", r[3], exp_lo[i])
    i = i + 1
}

if pass_count == total_count {
    println("PASS: xs64s_reference " + to_string(pass_count) + "/" + to_string(total_count))
    exit(0)
} else {
    println("FAIL " + failed + " (" + to_string(pass_count) + "/" + to_string(total_count) + ")")
    exit(1)
}
