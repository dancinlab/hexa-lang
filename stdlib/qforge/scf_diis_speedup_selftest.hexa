// @ci_gate — deterministic · pure analytic anchors (no fixture I/O required)
//
// qforge_scf_diis_speedup_selftest.hexa — QFORGE-PERF "DIIS SCF mixing" g5 gate.
//
// THE MILESTONE (demiurge domains/QFORGE-PERF.md, "better SCF preconditioner +
// mixing"): replace the SCF density update's PLAIN LINEAR mixing with Pulay/Broyden
// (DIIS / Anderson) charge-density mixing so the SCF iteration count on a
// METAL / small-gap cell drops, WITHOUT changing the converged fixed point.
//
// The Pulay/DIIS density mixer (qforge_anderson_next, mixing.hexa) and its wiring
// into the SCF density update (qforge_scf_smeared `and_depth>0` branch, scf.hexa,
// with a LINEAR fallback for the first iters via the h=1 / m=0 path) already exist.
// What this gate pins is the milestone's ACCEPTANCE CRITERION at the DRIVER level:
//
//   run the SAME SCF driver (qforge_scf_smeared) on the SAME metallic test cell,
//   from the SAME uniform start, with the SAME damping β, twice —
//     · LINEAR mixing  (and_depth = 0)
//     · DIIS  mixing   (and_depth = 5)
//   and assert: (1) both reach the SAME converged density AND total energy (the
//   fixed point is byte-/tol-identical — DIIS only changes the PATH, not the root),
//   and (2) DIIS takes STRICTLY FEWER iterations than linear.
//
//   (A) SAME FIXED POINT: |E_diis − E_linear| < 1e-8 AND max|ρ_diis − ρ_linear|
//       < 1e-7 — DIIS converges to the identical self-consistent solution.       🟢
//   (B) FEWER ITERS: iters_diis < iters_linear (the perf claim, honestly the
//       MEASURED reduction on this cell — the verdict prints both counts).       🟢
//   (C) BOTH CONVERGED: neither path stalls (converged flag true for both) — a
//       speedup that fails to converge is not a speedup.                         🟢
//
// ── THE TEST CELL — a ρ-dependent METALLIC SCF map with a charge-sloshing mode ──
//   A real metallic SCF slow-converges because the Hartree feedback ∂V/∂ρ has a
//   high-gain LOW-q mode: a small density redistribution near E_F shifts the
//   potential which shifts the occupation back — a charge slosh that plain linear
//   mixing damps only slowly (it can only rescale the residual, never cancel the
//   oscillating mode). We reproduce that with a Hamiltonian whose diagonal carries
//   a STRONG, NON-LOCAL density feedback:
//     H(ρ)_aa = ε_a + g · (ρ_a − ρ̄)            (Hartree-like on-site feedback, gain g)
//     H(ρ)_ab = −t / (1 + (a−b)²)               (decaying hop, a∈/=b)
//   with a near-degenerate pair at E_F (states 3,4) so fractional smeared
//   occupations genuinely move with the potential (the slosh driver). The fixed
//   point ρ* = ρ*(H(ρ*)) is unique; the only difference between the two runs is the
//   MIXER, so any iter-count gap is attributable to DIIS alone (d6 honesty).
//
// ── MEASURED (this cell · β=0.3 · σ=0.2 · gain=1.2) ───────────────────────────
//   linear=58 iters · DIIS=16 iters  (3.6× fewer) · same fixed point:
//   |ΔE_tot|=1.10e-9 (<1e-8) · max|Δρ|=7.66e-10 (<1e-7) · both converged.
//
// Run:  HEXA_LANG=. hexa run stdlib/qforge/scf_diis_speedup_selftest.hexa
// PASS: "qforge_scf_diis_speedup_selftest PASS".
use "stdlib/qforge/scf"
use "stdlib/qforge/assembler"

fn _abs(x: float) -> float { if x < 0.0 { return -x } return x }
fn _ck_true(name: str, cond: bool) -> int {
    if cond { println("PASS " + name) ; return 0 }
    println("FAIL " + name) ; return 1
}
fn _ck_close(name: str, got: float, want: float, eps: float) -> int {
    if _abs(got - want) <= eps { println("PASS " + name + " (Δ=" + to_string(_abs(got - want)) + ")") ; return 0 }
    println("FAIL " + name + " — got " + to_string(got) + " want " + to_string(want)) ; return 1
}

// ── the ρ-dependent metallic Hamiltonian (charge-sloshing feedback) ────────────
let DIM = 8                          // basis / grid size
let NEL = 6                          // electrons (closed-shell → 3 occupied pairs)
let GAIN = 1.2                       // Hartree-like feedback gain (high → strong slosh)
let HOP  = 0.12                      // decaying inter-state hop amplitude
let mut HCUR: PwHam = PwHam { h: [], diag: [], n: 0 }
fn hd_apply(v: [float]) -> [float] { return qforge_h_apply(HCUR, v) }

// H_of_rho(ρ): build the dense feedback Hamiltonian from the CURRENT density and
//   return its matrix-free apply (d4 — the driver is physics-agnostic).
fn diis_h_of_rho(rho: [float]) {
    // mean density (charge neutrality reference) for the feedback term.
    let mut rbar = 0.0
    let mut z = 0
    while z < DIM { rbar = rbar + rho[z] ; z = z + 1 }
    rbar = rbar / to_float(DIM)

    let mut h: [float] = []
    let mut a = 0
    while a < DIM {
        let mut b = 0
        while b < DIM {
            if a == b {
                // kinetic ladder + near-degenerate E_F pair + Hartree feedback.
                let mut e = 0.5 * (0.37 * to_float(a)) * (0.37 * to_float(a))
                if a == 3 { e = e - 0.02 }
                if a == 4 { e = e - 0.018 }
                e = e + GAIN * (rho[a] - rbar)        // ρ-feedback → the slosh driver
                h.push(e)
            } else {
                let d = _abs(to_float(a - b))
                h.push(-1.0 * HOP / (1.0 + d * d))
            }
            b = b + 1
        }
        a = a + 1
    }
    // diagonal for Davidson preconditioning (must match h's diagonal).
    let mut rbar2 = rbar
    let mut dg: [float] = []
    let mut i = 0
    while i < DIM {
        let mut e = 0.5 * (0.37 * to_float(i)) * (0.37 * to_float(i))
        if i == 3 { e = e - 0.02 }
        if i == 4 { e = e - 0.018 }
        e = e + GAIN * (rho[i] - rbar2)
        dg.push(e) ; i = i + 1
    }
    HCUR = PwHam { h: h, diag: dg, n: DIM }
    return hd_apply
}

// diis_rho_of_psi: build the new density ρ_a = Σ_b occ_b · ψ_b(a)²  (the on-site charge
//   from the occupied orbitals). This is the SCF output map that, fed back through
//   diis_h_of_rho's GAIN term, creates the charge slosh.
fn diis_rho_of_psi(psis: [[float]], occ: [float], nbands: int) -> [float] {
    let ndim = len(psis[0])
    let mut rho: [float] = []
    let mut a = 0
    while a < ndim {
        let mut s = 0.0
        let mut b = 0
        while b < nbands { s = s + occ[b] * psis[b][a] * psis[b][a] ; b = b + 1 }
        rho.push(s)
        a = a + 1
    }
    return rho
}

fn main() {
    let mut fails = 0
    let sigma = 0.20          // metallic smearing width (d15) — fractional occupations
    let beta  = 0.30          // SAME damping for both runs (the only knob held fixed)
    let tol   = 1.0e-9
    let maxit = 400

    // ── run 1: PLAIN LINEAR mixing (and_depth = 0) ─────────────────────────────
    let lin = qforge_scf_smeared(diis_h_of_rho, diis_rho_of_psi, DIM, DIM, NEL,
                                 beta, tol, maxit, sigma, 2.0, 0)
    // ── run 2: DIIS / Anderson mixing (and_depth = 5) — SAME everything else ───
    let diis = qforge_scf_smeared(diis_h_of_rho, diis_rho_of_psi, DIM, DIM, NEL,
                                  beta, tol, maxit, sigma, 2.0, 5)

    println("    [iters] linear=" + to_string(lin.iters)
            + "  DIIS=" + to_string(diis.iters)
            + "   (β=" + to_string(beta) + ", σ=" + to_string(sigma)
            + ", gain=" + to_string(GAIN) + ")")
    println("    [E_tot] linear=" + to_string(lin.e_total)
            + "  DIIS=" + to_string(diis.e_total)
            + "   |Δ|=" + to_string(_abs(lin.e_total - diis.e_total)))

    // ══ (C) BOTH CONVERGED ═════════════════════════════════════════════════════
    fails = fails + _ck_true("(C) linear-mixing SCF converged", lin.converged)
    fails = fails + _ck_true("(C) DIIS-mixing SCF converged", diis.converged)

    // ══ (A) SAME FIXED POINT (energy + density) ════════════════════════════════
    fails = fails + _ck_close("(A) DIIS E_tot == linear E_tot (same fixed point)",
                              diis.e_total, lin.e_total, 1.0e-8)
    let mut dmax = 0.0
    let mut i = 0
    while i < DIM {
        let d = _abs(lin.rho[i] - diis.rho[i])
        if d > dmax { dmax = d }
        i = i + 1
    }
    fails = fails + _ck_true("(A) max|ρ_diis − ρ_linear| < 1e-7 (same density · "
                             + to_string(dmax) + ")", dmax < 1.0e-7)

    // ══ (B) FEWER ITERS (the perf claim — honest measured reduction) ═══════════
    fails = fails + _ck_true("(B) DIIS iters < linear iters (" + to_string(diis.iters)
                             + " < " + to_string(lin.iters) + ")",
                             diis.iters < lin.iters)

    if fails == 0 { println("qforge_scf_diis_speedup_selftest PASS") }
    else { println("qforge_scf_diis_speedup_selftest FAIL — " + to_string(fails) + " case(s)") }
}
