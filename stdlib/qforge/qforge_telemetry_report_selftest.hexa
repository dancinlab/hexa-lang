// @ci_gate — deterministic · network-free · pure JSONL-text analyzer g5 gate
//
// qforge_telemetry_report_selftest.hexa — QFORGE-PROCESS telemetry analyzer
//   (qforge_telemetry_report, stdlib/qforge/telemetry_report.hexa) g5 gate.
//   The analyzer INGESTS the `.dft_telemetry.jsonl` text emitted by PR#2474
//   (stdlib/cloud/dft_dispatch.hexa `_dft_telemetry_line`, 6 keys
//   ts·stage·event·wall_s·rss_kb·exit) and produces a ranked per-stage
//   bottleneck report — wall + peak-rss aggregated per stage, sorted by wall
//   desc with %-of-total, slowest flagged.
//
// 검증 케이스 (all on a fixture JSONL string — NO pod, NO file, pure text):
//  🔵 (A) PARSE + per-stage wall SUM: a relax·scf·ph:q1·ph:q2·lambda fixture
//         (with paired start/done) → each stage wall = sum of its done wall_s.
//  🔵 (B) BOTTLENECK = max-wall stage: rows ranked wall DESC, row[0].slowest,
//         total_wall = Σ stage wall, pct = 100·wall/total (integer).
//  🔵 (C) rss-null PASSTHROUGH (d6): a stage whose done line has rss_kb:null
//         → has_rss=false, renders "null" — NEVER a fabricated 0. A stage with
//         a real rss → peak = max done rss_kb.
//  🔵 (D) MALFORMED-line guard: bad JSON · a 5-key line (missing a required
//         key) · an unknown event value → counted in `malformed`, NEVER
//         bucketed into a stage; blank lines skipped (not malformed).
//  🔵 (E) UNPAIRED-event guard: a `start` with no matching `done` → counted in
//         `unpaired`, contributes 0 wall, surfaced (not silently dropped).
//
// Run (point HEXA_STDLIB_ROOT at THIS worktree's stdlib):
//   HEXA_STDLIB_ROOT="$PWD/stdlib" hexa run --no-sentinel \
//     stdlib/qforge/qforge_telemetry_report_selftest.hexa
// PASS: "qforge_telemetry_report_selftest PASS".
use "stdlib/qforge/telemetry_report"

fn _ck_int(name: str, got: int, want: int) -> int {
    if got == want { println("PASS " + name + " (" + to_string(got) + ")") ; return 0 }
    println("FAIL " + name + " — got " + to_string(got) + " want " + to_string(want)) ; return 1
}
fn _ck_str(name: str, got: str, want: str) -> int {
    if got == want { println("PASS " + name + " (" + got + ")") ; return 0 }
    println("FAIL " + name + " — got '" + got + "' want '" + want + "'") ; return 1
}
fn _ck_bool(name: str, got: bool, want: bool) -> int {
    if got == want { println("PASS " + name + " (" + to_string(got) + ")") ; return 0 }
    println("FAIL " + name + " — got " + to_string(got) + " want " + to_string(want)) ; return 1
}
// row lookup by stage label
fn _row(rep: Report, stage: str) -> StageRow {
    let mut i = 0
    while i < len(rep.rows) {
        if rep.rows[i].stage == stage { return rep.rows[i] }
        i = i + 1
    }
    return StageRow { stage: "", wall_s: -1, peak_rss: -1, has_rss: false, exit: -1, pct: -1, slowest: false }
}

fn main() {
    let mut fails = 0

    // ── (A)+(B)+(C) a full, well-formed el-ph fixture ───────────────────────
    //   relax  done wall=120 rss=500000
    //   scf    done wall=300 rss=900000   ← max wall ⇒ slowest
    //   ph:q1  done wall=200 rss=700000
    //   ph:q2  done wall=180 rss=null     ← rss-null passthrough (d6)
    //   lambda done wall= 10 rss= 20000
    //   total = 120+300+200+180+10 = 810
    let fix = "{\"ts\":100,\"stage\":\"relax\",\"event\":\"start\",\"wall_s\":0,\"rss_kb\":null,\"exit\":null}\n"
        + "{\"ts\":220,\"stage\":\"relax\",\"event\":\"done\",\"wall_s\":120,\"rss_kb\":500000,\"exit\":0}\n"
        + "{\"ts\":220,\"stage\":\"scf\",\"event\":\"start\",\"wall_s\":0,\"rss_kb\":null,\"exit\":null}\n"
        + "{\"ts\":520,\"stage\":\"scf\",\"event\":\"done\",\"wall_s\":300,\"rss_kb\":900000,\"exit\":0}\n"
        + "{\"ts\":520,\"stage\":\"ph:q1\",\"event\":\"start\",\"wall_s\":0,\"rss_kb\":null,\"exit\":null}\n"
        + "{\"ts\":720,\"stage\":\"ph:q1\",\"event\":\"done\",\"wall_s\":200,\"rss_kb\":700000,\"exit\":0}\n"
        + "{\"ts\":720,\"stage\":\"ph:q2\",\"event\":\"start\",\"wall_s\":0,\"rss_kb\":null,\"exit\":null}\n"
        + "{\"ts\":900,\"stage\":\"ph:q2\",\"event\":\"done\",\"wall_s\":180,\"rss_kb\":null,\"exit\":0}\n"
        + "{\"ts\":900,\"stage\":\"lambda\",\"event\":\"start\",\"wall_s\":0,\"rss_kb\":null,\"exit\":null}\n"
        + "{\"ts\":910,\"stage\":\"lambda\",\"event\":\"done\",\"wall_s\":10,\"rss_kb\":20000,\"exit\":0}\n"
    let rep = qforge_telemetry_report(fix)

    // (A) parse + per-stage wall sum
    fails = fails + _ck_int("(A) n_stages parsed", rep.n_stages, 5)
    fails = fails + _ck_int("(A) relax wall", _row(rep, "relax").wall_s, 120)
    fails = fails + _ck_int("(A) scf wall", _row(rep, "scf").wall_s, 300)
    fails = fails + _ck_int("(A) ph:q1 wall", _row(rep, "ph:q1").wall_s, 200)
    fails = fails + _ck_int("(A) ph:q2 wall", _row(rep, "ph:q2").wall_s, 180)
    fails = fails + _ck_int("(A) lambda wall", _row(rep, "lambda").wall_s, 10)

    // (B) bottleneck = max-wall, ranked desc, total + pct
    fails = fails + _ck_int("(B) total_wall = Σ stage wall", rep.total_wall, 810)
    fails = fails + _ck_str("(B) row[0] (slowest) = scf", rep.rows[0].stage, "scf")
    fails = fails + _ck_bool("(B) row[0].slowest flagged", rep.rows[0].slowest, true)
    fails = fails + _ck_bool("(B) row[1] NOT slowest", rep.rows[1].slowest, false)
    // ranked wall DESC: scf 300 > ph:q1 200 > ph:q2 180 > relax 120 > lambda 10
    fails = fails + _ck_str("(B) rank[1] = ph:q1", rep.rows[1].stage, "ph:q1")
    fails = fails + _ck_str("(B) rank[2] = ph:q2", rep.rows[2].stage, "ph:q2")
    fails = fails + _ck_str("(B) rank[3] = relax", rep.rows[3].stage, "relax")
    fails = fails + _ck_str("(B) rank[4] = lambda", rep.rows[4].stage, "lambda")
    fails = fails + _ck_int("(B) scf %tot = 100·300/810 = 37", _row(rep, "scf").pct, 37)
    fails = fails + _ck_int("(B) lambda %tot = 100·10/810 = 1", _row(rep, "lambda").pct, 1)

    // (C) rss: real peak vs null passthrough — NEVER fabricate
    fails = fails + _ck_bool("(C) scf has_rss", _row(rep, "scf").has_rss, true)
    fails = fails + _ck_int("(C) scf peak_rss = 900000", _row(rep, "scf").peak_rss, 900000)
    fails = fails + _ck_bool("(C) ph:q2 rss-null passthrough → has_rss=false", _row(rep, "ph:q2").has_rss, false)
    // the rendered table shows the literal "null" for ph:q2, never "0"
    let rendered = qforge_telemetry_report_render(rep)
    fails = fails + _ck_bool("(C) render contains 'null' (d6 no fabrication)", rendered.contains("null"), true)
    fails = fails + _ck_bool("(C) render flags slowest", rendered.contains("slowest"), true)

    // peak-rss = MAX over multiple done lines for one stage
    let multi = "{\"ts\":1,\"stage\":\"scf\",\"event\":\"done\",\"wall_s\":50,\"rss_kb\":100000,\"exit\":0}\n"
        + "{\"ts\":2,\"stage\":\"scf\",\"event\":\"done\",\"wall_s\":70,\"rss_kb\":400000,\"exit\":0}\n"
        + "{\"ts\":3,\"stage\":\"scf\",\"event\":\"done\",\"wall_s\":30,\"rss_kb\":250000,\"exit\":0}\n"
    let repm = qforge_telemetry_report(multi)
    fails = fails + _ck_int("(C) multi-done wall sum = 150", _row(repm, "scf").wall_s, 150)
    fails = fails + _ck_int("(C) multi-done peak rss = max 400000", _row(repm, "scf").peak_rss, 400000)

    // ── (D) MALFORMED-line guard ────────────────────────────────────────────
    //   line 1: valid done · line 2: bad JSON · line 3: blank (skip) ·
    //   line 4: 5-key (missing rss_kb) → malformed · line 5: unknown event ·
    //   line 6: bare text → malformed
    let bad = "{\"ts\":1,\"stage\":\"scf\",\"event\":\"done\",\"wall_s\":42,\"rss_kb\":1000,\"exit\":0}\n"
        + "{not valid json at all\n"
        + "\n"
        + "{\"ts\":2,\"stage\":\"scf\",\"event\":\"done\",\"wall_s\":99,\"exit\":0}\n"
        + "{\"ts\":3,\"stage\":\"scf\",\"event\":\"weird\",\"wall_s\":7,\"rss_kb\":5,\"exit\":0}\n"
        + "just some log noise line\n"
    let repb = qforge_telemetry_report(bad)
    fails = fails + _ck_int("(D) malformed counted = 4 (badjson·5key·unknown-event·text)", repb.malformed, 4)
    // ONLY the one valid done bucketed → scf wall = 42 (the 5-key/unknown NOT added)
    fails = fails + _ck_int("(D) malformed NOT bucketed → scf wall = 42", _row(repb, "scf").wall_s, 42)
    fails = fails + _ck_int("(D) only 1 stage from 1 valid line", repb.n_stages, 1)

    // ── (E) UNPAIRED-event guard ────────────────────────────────────────────
    //   relax start+done (paired) · scf start ONLY (unpaired) ·
    //   ph:q1 done ONLY (paired-enough: has the done with wall)
    let unp = "{\"ts\":1,\"stage\":\"relax\",\"event\":\"start\",\"wall_s\":0,\"rss_kb\":null,\"exit\":null}\n"
        + "{\"ts\":2,\"stage\":\"relax\",\"event\":\"done\",\"wall_s\":60,\"rss_kb\":300000,\"exit\":0}\n"
        + "{\"ts\":2,\"stage\":\"scf\",\"event\":\"start\",\"wall_s\":0,\"rss_kb\":null,\"exit\":null}\n"
    let repu = qforge_telemetry_report(unp)
    fails = fails + _ck_int("(E) unpaired count = 1 (scf start, no done)", repu.unpaired, 1)
    fails = fails + _ck_int("(E) unpaired scf wall = 0 (no done)", _row(repu, "scf").wall_s, 0)
    fails = fails + _ck_int("(E) relax paired wall = 60", _row(repu, "relax").wall_s, 60)
    fails = fails + _ck_bool("(E) scf (0 wall) NOT slowest", _row(repu, "scf").slowest, false)

    // ── edge: empty input → empty report (no crash, no fabrication) ──────────
    let repe = qforge_telemetry_report("")
    fails = fails + _ck_int("(edge) empty input → 0 stages", repe.n_stages, 0)
    fails = fails + _ck_int("(edge) empty input → 0 total", repe.total_wall, 0)

    if fails == 0 { println("qforge_telemetry_report_selftest PASS") }
    else { println("qforge_telemetry_report_selftest FAIL — " + to_string(fails) + " case(s)") }
}
