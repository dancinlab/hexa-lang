// HEXA Standard Library — qforge/adaptive_qgrid
//
// @version 0.1.0
// @capabilities [pure]
//
// QFORGE-PERF — adaptive q-grid sampling for the el-ph λ integral.
//
// ── THE PROBLEM ──────────────────────────────────────────────────────────────
//   λ = Σ_q w_q · λ_q   (the per-q el-ph contribution; in α²F terms 2∫α²F/ω).
//   For nesting-driven / high-DOS superconductors the q-dependence of λ_q is
//   SHARPLY PEAKED in a small region of the BZ (the nesting wavevector) on top
//   of a flat background. A UNIFORM q-mesh must be fine EVERYWHERE to resolve
//   that peak → O(N) expensive DFPT runs, most of them in the flat region where
//   a coarse mesh would already be exact.
//
// ── THE FIX (this module) ────────────────────────────────────────────────────
//   ADAPTIVE refinement: start coarse, evaluate λ_q, then SUBDIVIDE only the
//   q-intervals whose local curvature (trapezoid-vs-midpoint mismatch) exceeds a
//   tolerance — refine where λ_q varies fast (the peak), leave the flat region
//   coarse. Reaches the dense-uniform λ to a target accuracy with FAR fewer total
//   q-points. d2 (breakthrough) · d19 (reuses the same 2∫α²F/ω λ-integral
//   convention as qforge_a2f_lambda — the per-q λ_q is the integrand).
//
//   This is the GENERIC 1-D adaptive quadrature engine over a q-axis; the caller
//   supplies λ_q(q) (real DFPT, or — in the selftest — a synthetic peaked model
//   with a known analytic λ). The BZ generalization tiles this per axis.

use "stdlib/material/sim"

// ── trapezoidal integral of a callback-sampled set over a SORTED q-mesh ───────
//   qs : strictly-increasing q-nodes (length m) · fs : λ_q at each node.
//   ∫ ≈ Σ_i ½(f_i+f_{i+1})(q_{i+1}−q_i).  0 on malformed input.
pub fn qforge_aq_trapz(qs: [float], fs: [float]) -> float {
    let m = len(qs)
    if m < 2 || len(fs) != m { return 0.0 }
    let mut acc = 0.0
    let mut i = 0
    while i < m - 1 {
        let dq = qs[i + 1] - qs[i]
        acc = acc + 0.5 * (fs[i] + fs[i + 1]) * dq
        i = i + 1
    }
    return acc
}

// ── ADAPTIVE q-refinement ────────────────────────────────────────────────────
//   f          : callback λ_q(q) — the per-q el-ph contribution.
//   q_lo, q_hi : q-axis bounds (e.g. 0 .. 1 in reduced BZ units).
//   n_coarse   : initial uniform interval count.
//   err_tol    : refine an interval while its curvature error > err_tol.
//   max_pts    : hard cap on total q-evaluations (budget).
//   Returns [lambda, nq_used] — the trapezoidal λ over the final adaptive mesh
//   and the number of DISTINCT q-points f was evaluated at (= DFPT cost proxy).
//
//   Refinement rule: for interval [a,b] with midpoint c, the curvature error is
//   |f(c) − ½(f(a)+f(b))| · (b−a) — the deviation of the true midpoint from the
//   trapezoid's linear interpolant, weighted by width. An interval over err_tol
//   is bisected (c inserted). Flat regions converge immediately (error ≈ 0) and
//   are never refined; the sharp peak is recursively bisected.
pub fn qforge_aq_adaptive(f, q_lo: float, q_hi: float, n_coarse: int,
                          err_tol: float, max_pts: int) -> [float] {
    if q_hi <= q_lo || n_coarse < 1 { return [0.0, 0.0] }
    let mut qs: [float] = []
    let mut fs: [float] = []
    let dq0 = (q_hi - q_lo) / to_float(n_coarse)
    let mut k = 0
    while k <= n_coarse {
        let q = q_lo + to_float(k) * dq0
        qs.push(q)
        fs.push(f(q))
        k = k + 1
    }
    let mut nq = n_coarse + 1
    let mut pass = 0
    while pass < max_pts {
        if nq >= max_pts { break }
        let mut nqs: [float] = []
        let mut nfs: [float] = []
        let mut split_any = false
        let m = len(qs)
        let mut i = 0
        while i < m - 1 {
            let a = qs[i] ; let b = qs[i + 1]
            let fa = fs[i] ; let fb = fs[i + 1]
            nqs.push(a) ; nfs.push(fa)
            let c = 0.5 * (a + b)
            let fc = f(c)
            let lin = 0.5 * (fa + fb)
            let mut err = fc - lin
            if err < 0.0 { err = -err }
            err = err * (b - a)
            if err > err_tol && nq < max_pts {
                nqs.push(c) ; nfs.push(fc)
                nq = nq + 1
                split_any = true
            }
            i = i + 1
        }
        nqs.push(qs[m - 1]) ; nfs.push(fs[m - 1])
        qs = nqs ; fs = nfs
        if !split_any { break }
        pass = pass + 1
    }
    return [qforge_aq_trapz(qs, fs), to_float(nq)]
}

// ── uniform-mesh λ at a given node count (the baseline to beat) ───────────────
//   ∫ λ_q dq on a UNIFORM nq-node mesh — the conventional non-adaptive q-grid.
pub fn qforge_aq_uniform(f, q_lo: float, q_hi: float, nq: int) -> float {
    if q_hi <= q_lo || nq < 2 { return 0.0 }
    let mut qs: [float] = []
    let mut fs: [float] = []
    let dq = (q_hi - q_lo) / to_float(nq - 1)
    let mut k = 0
    while k < nq {
        let q = q_lo + to_float(k) * dq
        qs.push(q)
        fs.push(f(q))
        k = k + 1
    }
    return qforge_aq_trapz(qs, fs)
}
