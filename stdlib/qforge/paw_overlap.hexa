// HEXA Standard Library — qforge/paw_overlap
//
// @version 0.1.0
// @capabilities [pure]
//
// QFORGE-PAW Route A brick 2/3 — the GENERALIZED-OVERLAP operator S and the
// ultrasoft/PAW el-ph ∂S/∂u correction.  H ψ = ε S ψ ,  S = 1 + Σ_ij |β_i⟩q_ij⟨β_j|.
//
// ── Why this brick (the genuinely-untested Route A axis) ─────────────────────
// QFORGE-PAW round-4 (dvaug_du.hexa) proved the BARE augmentation el-ph vertex
// ∂V_aug/∂u is zero on TWO grounds — Q_ij≡0 for the NC deck, AND (with a finite
// Q_ij) the co-located self-vertex cancels by the translational-invariance sum
// rule. BUT round-4 overlaid that vertex on the NC eigenstates; it NEVER solved
// the generalized-overlap eigenproblem, so the eigenSTATES (and hence
// |g| = ⟨ψ_m|ΔV|ψ_n⟩) were never modified. Route A imports the REAL finite q_ij
// (brick 1, upf_aug) and asks the one question round-4 left open: when S ≠ 1
// orthonormalizes the states AND adds an explicit −ε ∂S/∂u el-ph term, does |g|
// move toward QE?
//
// ── The ultrasoft/PAW el-ph matrix element (Giustino RMP 2017, USPP form) ─────
//   g_mn = ⟨ψ_m | ∂V_scf/∂u − ε_n ∂S/∂u | ψ_n⟩ ,   ⟨ψ_n|S|ψ_n⟩ = 1.
// Two NEW pieces vs the NC g = ⟨ψ_m|∂V_scf/∂u|ψ_n⟩:
//   (i)  S-orthonormalization:  ψ_n^S = ψ_n / √⟨ψ_n|S|ψ_n⟩  (the soft pseudo-
//        orbital's norm is restored by the augmentation charge q_ij);
//   (ii) the explicit −ε_n ∂S/∂u term,  ∂S/∂u = Σ_ij |∂β_i⟩q_ij⟨β_j| + h.c.,
//        ∂β_i = −i q_d β_i (the SAME (★) identity as dvnl/dvaug, d19).
// For a single rigidly-displaced atom the ⟨ψ|∂S/∂u|ψ⟩ DIAGONAL element vanishes
// by the SAME translational-invariance sum rule that killed ∂V_aug (brick 1's
// note) — so the explicit-term contribution to the on-shell g is, like B3, an
// upper bound that is itself ~0.  What does NOT vanish is (i): the overlap S
// RENORMALIZES every eigenstate by 1/√(1+δ_n), δ_n = ⟨ψ_n|(S−1)|ψ_n⟩ ≥ 0, which
// rescales |g| by 1/(1+δ) (bra and ket each ÷√(1+δ)).  THIS is the sole surviving
// Route-A lever on |g|, and this brick measures it for the real q_ij.
//
// d3/d4 generic: branches only on q_ij presence; NC ⇒ q_ij all-zero ⇒ S=1 ⇒
// δ=0 ⇒ |g| unchanged (strict superset of the round-1..4 NC path).
use "stdlib/qforge/projector"

let _PAWS_4PI: float = 12.56637061435917295384   // 4π

// ── ⟨β_i|ψ⟩ for one projector over a PW state (real PW coeffs) ────────────────
// betaq[a] = the phased projector amplitude β_i(q_a) (real radial · structure
// phase folded by caller into a real array for the diagonal δ estimate; for the
// scalar overlap δ_n only the |⟨β|ψ⟩|² magnitude enters, so a real proxy is exact
// for the Γ-diagonal). psi[a] = real PW coefficient. Returns Σ_a β_i(q_a)·ψ(q_a).
pub fn qforge_paw_beta_psi(betaq: [float], psi: [float], nq: int) -> float {
    if len(betaq) != nq || len(psi) != nq { return 0.0 }
    let mut s = 0.0
    let mut a = 0
    while a < nq { s = s + betaq[a] * psi[a] ; a = a + 1 }
    return s
}

// ── δ_n = ⟨ψ_n | (S − 1) | ψ_n⟩ = Σ_ij q_ij ⟨ψ|β_i⟩⟨β_j|ψ⟩ ────────────────────
// The augmentation overlap excess for state ψ_n. q_ij = flat [nproj·nproj] (the
// integrated L=0 monopole moments from upf_aug). betaq = flat [nproj·nq] phased
// projector amplitudes β_i(q_a). Returns δ_n ≥ 0 (S is positive-definite for a
// physical USPP).  NC ⇒ q_ij all-zero ⇒ δ_n = 0.
pub fn qforge_paw_delta(qij: [float], betaq: [float], psi: [float],
                        nproj: int, nq: int) -> float {
    if len(qij) != nproj * nproj || len(betaq) != nproj * nq || len(psi) != nq {
        return 0.0
    }
    // bp[i] = ⟨β_i|ψ⟩
    let mut bp: [float] = []
    let mut i = 0
    while i < nproj {
        let mut row: [float] = []
        let mut a = 0
        while a < nq { row.push(betaq[i * nq + a]) ; a = a + 1 }
        bp.push(qforge_paw_beta_psi(row, psi, nq))
        i = i + 1
    }
    let mut d = 0.0
    let mut ii = 0
    while ii < nproj {
        let mut jj = 0
        while jj < nproj {
            d = d + qij[ii * nproj + jj] * bp[ii] * bp[jj]
            jj = jj + 1
        }
        ii = ii + 1
    }
    return d
}

// ── S-orthonormalization factor 1/√(1+δ_n) applied to a state ─────────────────
// The physical effect: ⟨ψ|S|ψ⟩ = 1 + δ_n, so the S-normalized state is
// ψ^S = ψ/√(1+δ_n).  Returns the scale factor (NC ⇒ δ=0 ⇒ 1.0).
pub fn qforge_paw_snorm_scale(delta: float) -> float {
    if delta <= 0.0 { return 1.0 }
    return 1.0 / sqrt(1.0 + delta)
}

// ── |g|^PAW / |g|^NC for a (m,n) el-ph element under S-orthonormalization ──────
// g^PAW = ⟨ψ_m^S | ∂V | ψ_n^S⟩ = g^NC / √((1+δ_m)(1+δ_n))  (bra & ket each ÷√).
// The explicit −ε ∂S/∂u term's on-shell DIAGONAL contribution vanishes by the
// translational-invariance sum rule (brick 1 / round-4 finding), so the surviving
// Route-A rescale of |g| is exactly the S-norm factor.  delta_m, delta_n ≥ 0.
// Returns the multiplicative factor on |g| (1.0 for NC).  λ ∝ |g|² ⇒ the factor
// on λ for the diagonal channel is the SQUARE of this.
pub fn qforge_paw_g_scale(delta_m: float, delta_n: float) -> float {
    let sm = qforge_paw_snorm_scale(delta_m)
    let sn = qforge_paw_snorm_scale(delta_n)
    return sm * sn
}

// ── Build phased projector amplitudes β_i(q_a) over a q-grid (real proxy) ──────
// betas = flat [nproj·mesh] radial β_i(r); ls = [nproj]; r,rab the mesh; qmag =
// [nq] |q_a|. Returns flat [nproj·nq] real radial projector amplitudes (the
// structure phase cancels in the |⟨β|ψ⟩|² magnitude that enters δ_n at Γ, so the
// real radial transform is exact for the diagonal overlap excess).
pub fn qforge_paw_betaq(r: [float], rab: [float], betas: [float], ls: [int],
                        nproj: int, qmag: [float]) -> [float] {
    let n = len(r)
    let nq = len(qmag)
    let mut out: [float] = []
    let mut i = 0
    while i < nproj {
        let mut beta_i: [float] = []
        let mut t = 0
        while t < n { beta_i.push(betas[i * n + t]) ; t = t + 1 }
        let li = ls[i]
        let mut a = 0
        while a < nq {
            out.push(qforge_proj_radial(r, rab, beta_i, li, qmag[a]))
            a = a + 1
        }
        i = i + 1
    }
    return out
}
