// @ci_gate — deterministic · network-free · NO pod ops · UNIFIED off-diag vertex g5 게이트
//
// elph_offdiag_integrated_selftest.hexa — QFORGE 통합 dense off-diag V_scr(G_a−G_b)
//   vertex assembler g5 gate. 이 모듈은 세 경로(DENSE 정의 / APPLY=compose / CUBE)가
//   정규화-일관 하에서 동일한 g_mn 을 낸다는 것을 THEOREM 으로 증명한다 (아키텍처 잔여 종결).
//
// 게이트가 검증하는 것 (어떤 케이스도 λ 를 조작하지 않음 — 정규화-일관성 정리만):
//   A const ΔV(ΔG)=V̄·δ ⇒ dense==diag, off-diag g_mn=0 (직교 ψ → V̄·δ_mn).
//   B route A(dense Σ_{Ga,Gb}) == route B(apply col, =compose qforge_realcell_g_offdiag).
//   C route A == route C(real-space cube ∫ψ ΔV(r) ψ dr) — PW-norm 하 Parseval 일치
//       → cube 경로의 ~10-order 결손이 누락된 PW-norm 임을 증명 (물리 아님).
//   D structured off-diag ΔV(ΔG) lifts Σ|g|² over the diagonal floor (lift>1).
//   E Hermiticity: ΔV(ΔG) 짝함수 ⇒ g_mn=g_nm (herm_residual≈0).
//   F dense λ 경로가 유한·물리적 (closed-form 2-band anchor 와 일치).
//
// Run:  HEXA_STDLIB_ROOT="$PWD/stdlib" hexa run --no-sentinel stdlib/qforge/elph_offdiag_integrated_selftest.hexa
// PASS: "qforge_elph_offdiag_integrated_selftest PASS".
use "stdlib/qforge/elph_offdiag_integrated"
use "stdlib/qforge/elph_offdiag"

let PI2: float = 3.14159265358979323846

fn _abs(x: float) -> float { if x < 0.0 { return -x } return x }
fn _ck_close(name: str, got: float, want: float, eps: float) -> int {
    if _abs(got - want) <= eps { println("PASS " + name + " (" + to_string(got) + ")") ; return 0 }
    println("FAIL " + name + " — got " + to_string(got) + " want " + to_string(want)) ; return 1
}
fn _ck_bool(name: str, got: bool, want: bool) -> int {
    if got == want { println("PASS " + name + " (" + to_string(got) + ")") ; return 0 }
    println("FAIL " + name + " — got " + to_string(got) + " want " + to_string(want)) ; return 1
}

// build a dense convolution matrix dv_conv[a*n+b] = vrow[(a-b) mod n] from a
// real, EVEN 1-D row vrow (length n) — a circulant = the PW representation of a
// local potential ΔV(r) with Fourier coefficients vrow. Even vrow ⇒ Hermitian.
fn _circulant(vrow: [float], n: int) -> [float] {
    let mut m: [float] = []
    let mut a = 0
    while a < n {
        let mut b = 0
        while b < n {
            let mut idx = a - b
            while idx < 0 { idx = idx + n }
            while idx >= n { idx = idx - n }
            m.push(vrow[idx])
            b = b + 1
        }
        a = a + 1
    }
    return m
}

fn main() {
    let mut fails = 0
    println("── QFORGE 통합 dense off-diag V_scr(G_a−G_b) vertex g5 게이트 ──")

    // ── (A) CONST potential: ΔV(ΔG)=V̄ on the diagonal, 0 off-diagonal ────────
    //   vrow=[V̄,0,0,0] ⇒ ΔV(ΔG)=V̄·δ_{ΔG,0}. dense vertex == diag vertex; for
    //   orthonormal ψ the off-diagonal g_mn=0 (the no-spurious-structure case).
    let n = 4
    let vbar = 0.7
    let dv_const = _circulant([vbar, 0.0, 0.0, 0.0], n)
    // two orthonormal PW states (basis vectors e0,e2).
    let p0 = [1.0, 0.0, 0.0, 0.0]
    let p1 = [0.0, 0.0, 1.0, 0.0]
    let g00_d = qforge_gmn_dense(p0, p0, dv_const)
    let g01_d = qforge_gmn_dense(p0, p1, dv_const)
    fails = fails + _ck_close("(A) const ΔV: g00_dense == V̄", g00_d, vbar, 1.0e-14)
    fails = fails + _ck_close("(A) const ΔV: g01_dense == 0 (orthonormal off-diag)", g01_d, 0.0, 1.0e-14)
    let g00_diag = qforge_gmn_dense_diag(p0, p0, dv_const)
    fails = fails + _ck_close("(A) const ΔV: dense==diag on diagonal", g00_d, g00_diag, 1.0e-14)

    // ── (B) STRUCTURED potential: dense (route A) == apply-col (route B=compose) ─
    //   vrow with off-diagonal Fourier content → a genuine dense ΔV(G_a−G_b).
    let vrow = [0.5, 0.20, -0.10, 0.20]   // EVEN (vrow[1]==vrow[3]) → Hermitian
    let dv_s = _circulant(vrow, n)
    // two generic (non-basis) normalized-ish states.
    let q0 = [0.6, 0.3, -0.2, 0.1]
    let q1 = [0.1, -0.5, 0.4, 0.2]
    // route A: dense double sum.
    let gA = qforge_gmn_dense(q0, q1, dv_s)
    // route B: apply ΔV to ψ_n → column, then ⟨ψ_m| column⟩ (the compose overlap).
    let wcol = qforge_dv_apply_col(dv_s, q1)
    let gB = qforge_realcell_g_offdiag(q0, wcol)
    fails = fails + _ck_close("(B) route A (dense) == route B (apply=compose)", gA, gB, 1.0e-13)

    // ── (C) route A == route C (real-space cube) — the FULL complex identity ─
    //   The canonical matrix element is g_mn = ⟨ψ_m|ΔV|ψ_n⟩ = (1/N) Σ_j ψ_m*(r_j)·
    //   ΔV(r_j)·ψ_n(r_j) — note the BRA CONJUGATE ψ_m*(r)=Σ_G c_m(G)e^{−iG r}. The
    //   prior cube route (elph_vscr_realspace) took the REAL part of ifft for ALL
    //   three factors, dropping the bra conjugation — which for OFF-DIAGONAL Γ
    //   elements is NOT zero. THAT (on top of the PW-norm scale) is the cube route's
    //   true residual. Building ψ_m*(r) with the −iG phase + ψ_n(r), ΔV(r) with +iG
    //   and taking the real part of the triple product recovers route A EXACTLY,
    //   proving the unification (A==B==C) is a normalization+phase THEOREM, not a fit.
    let nf = to_float(n)
    let mut gC = 0.0
    let mut gC_im = 0.0
    let mut r = 0
    while r < n {
        // explicit IDFT phase θ = 2π·G·j/N ; G index = the circulant coefficient index.
        let mut mr = 0.0 ; let mut mi = 0.0   // ψ_m*(r_j): e^{−iθ} (conjugate bra)
        let mut vr = 0.0 ; let mut vi = 0.0   // ΔV(r_j): e^{+iθ}
        let mut nr = 0.0 ; let mut ni = 0.0   // ψ_n(r_j): e^{+iθ}
        let mut g = 0
        while g < n {
            let th = 2.0 * PI2 * to_float(g) * to_float(r) / nf
            let cth = cos(th) ; let sth = sin(th)
            mr = mr + q0[g] * cth ; mi = mi - q0[g] * sth   // CONJUGATE bra
            vr = vr + vrow[g] * cth ; vi = vi + vrow[g] * sth
            nr = nr + q1[g] * cth ; ni = ni + q1[g] * sth
            g = g + 1
        }
        // (mr+i·mi)(vr+i·vi) → p1 ; p1·(nr+i·ni) → triple, real & imag parts.
        let p1r = mr * vr - mi * vi ; let p1i = mr * vi + mi * vr
        gC = gC + (p1r * nr - p1i * ni)
        gC_im = gC_im + (p1r * ni + p1i * nr)
        r = r + 1
    }
    gC = gC / nf                            // (1/N) cell average
    gC_im = gC_im / nf
    fails = fails + _ck_close("(C) route A (dense) == route C (cube, full complex ψ_m*)", gA, gC, 1.0e-12)
    fails = fails + _ck_close("(C) route C imaginary part ≈ 0 (Hermitian/real at Γ)", gC_im, 0.0, 1.0e-12)

    // ── (D) the off-diagonal STRUCTURE lifts Σ|g|² over the diagonal floor ────
    //   Build the full 2×2 vertex from the structured ΔV vs its diagonal-only slice.
    let states = [q0, q1]
    let g_dense = qforge_gmn_dense_matrix(states, dv_s)
    let g_diag  = qforge_gmn_dense_matrix_diag(states, dv_s)
    fails = fails + _ck_bool("(D) dense matrix is 2×2", len(g_dense) == 4, true)
    let lift = qforge_gmn_dense_lift(g_dense, g_diag, 2)
    fails = fails + _ck_bool("(D) off-diag lifts Σ|g|² (lift>1)", lift > 1.0, true)
    println("     [D] Σ|g|²_dense/Σ|g|²_diag lift = " + to_string(lift))

    // ── (E) Hermiticity: even ΔV(ΔG) ⇒ g_mn = g_nm ───────────────────────────
    let herm = qforge_gmn_dense_herm(g_dense, 2)
    fails = fails + _ck_close("(E) Hermitian vertex (herm_residual≈0)", herm, 0.0, 1.0e-12)

    // ── (F) the dense λ path is finite + physical on a 2-band closed-form anchor ─
    //   Put both bands AT E_F so the double-δ is maximal; one ω mode; bare g² (mass≤0).
    //   λ must be finite, positive, and increase when the off-diagonal g grows — the
    //   physical monotonicity the unified path must preserve (no number forced).
    let eps = [0.0, 0.0]               // both bands at E_F
    let e_fermi = 0.0
    let omega_band = [800.0]           // K
    let n_ef = 2.0
    let samp = qforge_gmn_dense_samples(states, dv_s, eps, omega_band, -1.0)
    fails = fails + _ck_bool("(F) dense samples built (4 blocks)", len(samp) == 4, true)
    let lam = qforge_lambda_dense(samp, e_fermi, n_ef, 0.05, 50.0)
    fails = fails + _ck_bool("(F) dense λ finite + positive", lam > 0.0, true)
    println("     [F] dense-path λ (2-band anchor, bare) = " + to_string(lam))
    // a LARGER off-diagonal coupling → larger λ (physical monotone). Scale vrow×2.
    let vrow2 = [0.5, 0.40, -0.20, 0.40]
    let dv_s2 = _circulant(vrow2, n)
    let samp2 = qforge_gmn_dense_samples(states, dv_s2, eps, omega_band, -1.0)
    let lam2 = qforge_lambda_dense(samp2, e_fermi, n_ef, 0.05, 50.0)
    fails = fails + _ck_bool("(F) stronger off-diag → larger λ (monotone)", lam2 > lam, true)
    println("     [F] λ(×2 off-diag) = " + to_string(lam2) + " > " + to_string(lam))

    // ── (G) route-B columns path (the REAL-CELL entry) == dense-matrix path ──
    //   The real cell never materializes the dense ΔV(ΔG) matrix — the screening
    //   brick hands applied columns w_n = ΔV_scr·ψ_n directly. Build those columns
    //   from the SAME dv_s, feed qforge_gmn_cols_samples, and prove its λ == the
    //   dense-matrix λ (A=B end-to-end at the λ level), plus the diagonal floor < full.
    let mut cols: [[float]] = []
    let mut ci = 0
    while ci < len(states) {
        cols.push(qforge_dv_apply_col(dv_s, states[ci]))
        ci = ci + 1
    }
    let samp_cols = qforge_gmn_cols_samples(states, cols, eps, omega_band, true, -1.0)
    fails = fails + _ck_bool("(G) cols samples built (4 blocks)", len(samp_cols) == 4, true)
    let lam_cols = qforge_lambda_dense(samp_cols, e_fermi, n_ef, 0.05, 50.0)
    fails = fails + _ck_close("(G) cols-path λ == dense-matrix λ (route A=B end-to-end)", lam_cols, lam, 1.0e-9)
    let samp_cols_diag = qforge_gmn_cols_samples_diag(states, cols, eps, omega_band, -1.0)
    let lam_cols_diag = qforge_lambda_dense(samp_cols_diag, e_fermi, n_ef, 0.05, 50.0)
    fails = fails + _ck_bool("(G) diagonal floor λ ≤ full λ (off-diag adds coupling)", lam_cols_diag <= lam_cols, true)
    println("     [G] λ_full(cols)=" + to_string(lam_cols) + "  λ_diag-floor=" + to_string(lam_cols_diag))

    if fails == 0 { println("qforge_elph_offdiag_integrated_selftest PASS") }
    else { println("qforge_elph_offdiag_integrated_selftest FAIL (" + to_string(fails) + ")") }
}
