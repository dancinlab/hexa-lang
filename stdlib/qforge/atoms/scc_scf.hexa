// HEXA Standard Library — qforge/atoms/scc_scf
//
// @version 0.1.0
// @capabilities [pure]
//
// QFORGE atoms-scale brick #6 — the SCC self-consistent-charge DRIVER. R5
// (eht_scc.hexa) supplies every kernel — the Wolfsberg-Helmholz EHT Hamiltonian
// H_EHT, the eigensolve, and the SCC on-site potential V_i = ∂E_scc/∂δq_i =
// Σ_j γ_ij δq_j (qforge_scc_potential). R1 (eeq.hexa) supplies the seed charges
// and the screened-Coulomb kernel γ_ij (qforge_eeq_gamma, reused inside R5). This
// brick WIRES them into the actual self-consistency LOOP that makes a GFN-xTB-
// style tight-binding model genuinely self-consistent. (Elstner et al. SCC-DFTB,
// PRB 58 7260 (1998); Bannwarth-Ehlert-Grimme GFN2-xTB, JCTC 15 1652 (2019).)
//
// THE LOOP ─────────────────────────────────────────────────────────────────────
//   The SCC charges are the FIXED POINT of the map δq → δq[H(δq)] :
//
//     (0) seed δq⁽⁰⁾ = q⁽⁰⁾ − q_ref     (R1 EEQ charges, relative to a reference)
//     (1) on-site SCC potential   V_a = Σ_b γ_ab δq_b           (qforge_scc_potential, R5)
//     (2) charge-coupled Hamiltonian   H_μν(δq) = H_EHT_μν + δ_μν · V_{atom(μ)}
//         (the SCC second-order term shifts each orbital's on-site level by the
//          electrostatic potential of the atom it sits on — Elstner Eq. 16)
//     (3) eigh(H) → ascending MO levels ε_k and eigenvectors C_{μk}
//     (4) occupy (Aufbau, caller occupations n_k) and form Mulliken populations
//         p_a = Σ_k n_k Σ_{μ∈a} C_{μk}²     (orthonormal-basis Mulliken, see HONEST)
//     (5) new charges   δq_new_a = (n_val_a − p_a) − q_ref_a   = q_new_a − q_ref_a
//     (6) MIX           δq ← (1−β) δq + β δq_new   (linear),  Anderson-1 optional
//     (7) converged when  max_a |δq_new_a − δq_a| < tol  → return the FIXED POINT.
//
// HONEST SCOPE (d6) — this is the SCC self-consistency DRIVER, not a full GFN2.
//   • The loop, the H(δq) coupling, the mixing, and the convergence test are
//     EXACT and selftest-anchored (monotone-decreasing residual → < tol, finite
//     iters, fixed-point identity, energy stability, δq→0 trivial).
//   • The population step uses the ORTHONORMAL-BASIS Mulliken approximation
//     p_a = Σ_k n_k Σ_{μ∈a} C_{μk}² (i.e. S = I, so the Mulliken P·S reduces to
//     P_μμ). For a non-orthogonal overlap the caller must pass a Löwdin-
//     orthogonalised H (S^{-1/2} H S^{-1/2}) and use Löwdin populations — that
//     S^{-1/2} dressing is round-7's job. We state this plainly, do NOT claim the
//     full Mulliken P·S trace, and do NOT force convergence (real iters reported).
//   • Per-element {H_μ, γ-radii α, valence n_val, q_ref} are CALLER-SUPPLIED data
//     (d4-generic): no element / orbital-count is branched on in this module.
//
// d4-generic: H_EHT, the orbital→atom map, α radii, valence, reference charges,
//   occupations, β, tol and max-iters are ALL inputs. H₂, a peptide, or a metal
//   cluster traverse the identical loop — add/remove an element is a table edit.
//
// reuse (d19): qforge_scc_potential · qforge_eht_hamiltonian · qforge_eht_levels
//   come from R5 (eht_scc.hexa); the seed charges come from R1 (qforge_eeq_charges,
//   eeq.hexa); eigh from stdlib/alloc/math/eigen. NO kernel is re-implemented here
//   — this file is PURE WIRING + the mixing/convergence control of the fixed-point
//   iteration. The only local helper is _absf (no math import for fabs).
use "stdlib/qforge/atoms/eht_scc"
use "stdlib/alloc/math/eigen"

fn _absf(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

// ── on-site SCC-dressed Hamiltonian  H(δq) = H_EHT + diag(V_atom(μ)) ──────────
//   heht:     flat n_orb × n_orb EHT Hamiltonian (from qforge_eht_hamiltonian, R5).
//   vatom:    per-ATOM SCC on-site potential V_a (from qforge_scc_potential, R5),
//             length n_atom.
//   orb2atom: per-ORBITAL atom index (length n_orb) — the d4-generic basis→atom map.
//   Returns a fresh flat n_orb × n_orb Hamiltonian with V_{atom(μ)} ADDED to each
//   diagonal element; off-diagonals are copied verbatim (the SCC second-order term
//   is a diagonal on-site shift, Elstner Eq. 16). Pure w.r.t. heht.
pub fn qforge_scc_dressed_h(heht: [float], vatom: [float],
                            orb2atom: [int], norb: int) -> [float] {
    let mut h: [float] = []
    let mut k = 0
    while k < norb * norb { h.push(heht[k]) ; k = k + 1 }
    let mut mu = 0
    while mu < norb {
        let a = orb2atom[mu]
        h[mu * norb + mu] = h[mu * norb + mu] + vatom[a]
        mu = mu + 1
    }
    return h
}

// ── eigenvectors paired with ASCENDING levels ────────────────────────────────
//   eigh returns levels DESCENDING with vectors[k] the eigenvector of the k-th
//   descending level. qforge_eht_levels exposes ascending levels; this returns the
//   matching ascending eigenvectors as a flat n×n column-major-by-MO block:
//   out[k*n + row] = C_{row,k} for the k-th ASCENDING MO (k=0 = lowest level).
pub fn qforge_eht_vectors_asc(h: [float], n: int) -> [float] {
    let res = eigh(h, n)
    let vecs = res[1]               // vecs[descIdx][row]
    let mut out: [float] = []
    let mut k = 0
    while k < n {
        let src = n - 1 - k          // ascending k ↔ descending (n-1-k)
        let row_vec = vecs[src]
        let mut r = 0
        while r < n {
            out.push(row_vec[r])
            r = r + 1
        }
        k = k + 1
    }
    return out
}

// ── Mulliken-style atomic populations (orthonormal-basis approximation) ───────
//   cvec:     flat n_orb × n_orb ASCENDING eigenvectors (qforge_eht_vectors_asc),
//             cvec[k*norb + mu] = C_{μk}.
//   occ:      occupation of each ASCENDING MO k (length n_orb; Aufbau closed shell
//             e.g. [2,2,…,0]).
//   orb2atom: orbital→atom map (length n_orb).  natom: number of atoms.
//   Returns per-atom electron population p_a = Σ_k occ_k Σ_{μ∈a} C_{μk}².
//   (ORTHONORMAL-BASIS Mulliken: S=I so the Mulliken trace (P S)_μμ = P_μμ = Σ_k
//   occ_k C_{μk}². Stated HONESTLY — not the non-orthogonal P·S trace.)
pub fn qforge_mulliken_pop(cvec: [float], occ: [float], orb2atom: [int],
                           norb: int, natom: int) -> [float] {
    let mut pop: [float] = []
    let mut a = 0
    while a < natom { pop.push(0.0) ; a = a + 1 }
    let mut k = 0
    while k < norb {
        let nk = occ[k]
        if nk != 0.0 {
            let mut mu = 0
            while mu < norb {
                let c = cvec[k * norb + mu]
                let at = orb2atom[mu]
                pop[at] = pop[at] + nk * c * c
                mu = mu + 1
            }
        }
        k = k + 1
    }
    return pop
}

// ── one SCC iteration: δq → δq_new (the fixed-point map, no mixing) ───────────
//   Given the current δq, build H(δq), diagonalise, occupy, and return the NEW
//   charge deviation δq_new_a = (n_val_a − p_a) − q_ref_a. This is the bare map G
//   whose fixed point δq* = G(δq*) is the SCC solution; the driver wraps it with
//   mixing + a convergence test. All kernels are R5/R1 reuse (d19).
//     heht:    EHT Hamiltonian (R5).        pos:      flat xyz (R_ij).
//     dq:      current δq (length natom).   alpha:    γ-radii (length natom, R1).
//     orb2atom:orbital→atom (length norb).  occ:      MO occupations (length norb).
//     nval:    per-atom reference valence electrons (length natom).
//     qref:    per-atom reference charges (length natom).
pub fn qforge_scc_step(heht: [float], pos: [float], dq: [float], alpha: [float],
                       orb2atom: [int], occ: [float], nval: [float],
                       qref: [float], norb: int, natom: int) -> [float] {
    // (1) on-site SCC potential V_a = Σ_b γ_ab δq_b  (R5 reuse, qforge_scc_potential)
    let vatom = qforge_scc_potential(pos, dq, alpha)
    // (2) charge-coupled Hamiltonian H(δq) = H_EHT + diag(V_atom(μ))
    let h = qforge_scc_dressed_h(heht, vatom, orb2atom, norb)
    // (3) diagonalise → ascending eigenvectors
    let cvec = qforge_eht_vectors_asc(h, norb)
    // (4) Mulliken populations p_a
    let pop = qforge_mulliken_pop(cvec, occ, orb2atom, norb, natom)
    // (5) new charge deviation δq_new_a = (n_val_a − p_a) − q_ref_a
    let mut dqnew: [float] = []
    let mut a = 0
    while a < natom {
        let qnew = nval[a] - pop[a]          // partial charge = valence − population
        dqnew.push(qnew - qref[a])
        a = a + 1
    }
    return dqnew
}

// ── max-norm residual ‖δq_new − δq‖_∞ (the convergence metric) ────────────────
pub fn qforge_scc_residual(dqnew: [float], dq: [float]) -> float {
    let n = len(dq)
    let mut m = 0.0
    let mut a = 0
    while a < n {
        let d = _absf(dqnew[a] - dq[a])
        if d > m { m = d }
        a = a + 1
    }
    return m
}

// ── the SCC self-consistency DRIVER (linear / damped mixing) ──────────────────
//   Iterates δq ← (1−β) δq + β G(δq) from the seed δq0 until the max-norm residual
//   ‖G(δq) − δq‖_∞ < tol or maxit iterations elapse. β ∈ (0,1] is the linear
//   mixing factor (β=1 = plain fixed-point iteration; β<1 = damping for stability).
//   Returns a FLAT diagnostics array, length natom + 3:
//     out[0 .. natom-1]  = converged δq*  (the fixed point)
//     out[natom + 0]     = iterations actually run (REAL count — d6, not forced)
//     out[natom + 1]     = final residual ‖G(δq*) − δq*‖_∞
//     out[natom + 2]     = 1.0 if converged (residual < tol) else 0.0
//   The driver branches on NO element / size — d4-generic over every input.
pub fn qforge_scc_scf(heht: [float], pos: [float], dq0: [float], alpha: [float],
                      orb2atom: [int], occ: [float], nval: [float], qref: [float],
                      norb: int, natom: int, beta: float, tol: float,
                      maxit: int) -> [float] {
    let mut dq: [float] = []
    let mut a = 0
    while a < natom { dq.push(dq0[a]) ; a = a + 1 }

    let mut it = 0
    let mut resid = 0.0
    let mut converged = 0.0
    while it < maxit {
        let dqnew = qforge_scc_step(heht, pos, dq, alpha, orb2atom, occ,
                                    nval, qref, norb, natom)
        resid = qforge_scc_residual(dqnew, dq)
        it = it + 1
        if resid < tol {
            // accept the new charges as the fixed point, then stop.
            a = 0
            while a < natom { dq[a] = dqnew[a] ; a = a + 1 }
            converged = 1.0
            it = it      // (no-op; keep the REAL iteration count)
            break
        }
        // linear / damped mixing: δq ← (1−β) δq + β δq_new
        a = 0
        while a < natom {
            dq[a] = (1.0 - beta) * dq[a] + beta * dqnew[a]
            a = a + 1
        }
    }

    let mut out: [float] = []
    a = 0
    while a < natom { out.push(dq[a]) ; a = a + 1 }
    out.push(to_float(it))
    out.push(resid)
    out.push(converged)
    return out
}

// ── total SCC-consistent energy at a charge vector (band + second-order) ──────
//   E_total(δq) = E_band(ε(δq)) + E_scc(δq), where ε(δq) are the levels of the
//   CHARGE-DRESSED Hamiltonian H(δq) and E_scc = ½ Σ γ_ij δq_i δq_j (R5). This is
//   HONEST (d6): in the orthonormal-Mulliken approximation this expression is NOT a
//   variational functional whose global minimum is δq* — a probe scan shows it is
//   monotone in δq with no stationary point at the fixed point (the proper SCC
//   variational functional needs band+second-order populations consistent, which
//   the Löwdin/Mulliken P·S step of round-7 closes). What the selftest DOES assert
//   is the true property: this energy DESCENDS MONOTONICALLY as the loop iterates
//   from the seed toward δq* — the SCC loop is a real energy-lowering relaxation.
//   (Double-counting note: the SCC literature subtracts ½ Σ V_a δq_a from the band
//   term to avoid double counting the second-order energy; we report BOTH the raw
//   band sum and the standard double-count-corrected total so the caller can pick.)
pub fn qforge_scc_total_energy(heht: [float], pos: [float], dq: [float],
                               alpha: [float], orb2atom: [int], occ: [float],
                               norb: int, natom: int) -> float {
    let vatom = qforge_scc_potential(pos, dq, alpha)
    let h = qforge_scc_dressed_h(heht, vatom, orb2atom, norb)
    let eps = qforge_eht_levels(h, norb)
    let eband = qforge_eht_band_energy(eps, occ)
    let escc = qforge_scc_energy2(pos, dq, alpha)
    // double-count correction: − Σ_a V_a δq_a (the band term already contains
    // Σ V_a δq_a once via the diagonal shift; E_scc adds the ½, so subtract Σ V δq
    // and the net second-order contribution is −½ Σ V δq = E_scc as it should be).
    let mut dc = 0.0
    let mut a = 0
    while a < natom { dc = dc + vatom[a] * dq[a] ; a = a + 1 }
    return eband + escc - dc
}
