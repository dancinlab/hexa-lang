// @ci_gate — deterministic · Harris-Foulkes/Mermin variational-stationarity anchors
//
// qforge/atoms/harris_foulkes_selftest.hexa — QFORGE atoms brick #8 (Harris-Foulkes
// variational functional) g5. This brick CLOSES the round-6/round-7 energy-stationarity
// gap: R6 reported (its (c) anchor) that the SCC total energy had NO stationary point
// at the fixed point, and the R7 report measured dE/dδq = −1.33 ≠ 0 there. The Harris-
// Foulkes functional E_HF[δq] = Σ_occ n_k ε_k[δq] − ½ Σ γ δq δq + E_rep, with the SCC
// variable taken as the self-consistent Mulliken POPULATION (δq* = p[δq*]), has a
// gradient that VANISHES at the fixed point. The four g5 anchors prove that closure on
// REAL numerical output (d6 — printed verbatim, NOT forced):
//
//   (a) STATIONARITY (the r6/r7 gap CLOSED): at the relaxed fixed point δq* = p[δq*],
//       the analytic gradient ∂E_HF/∂δq = Σ_a γ_ac(p_a − δq_a) AND a central finite-
//       difference of E_HF BOTH have max-norm < 1e-6 — dE/dδq = 0 is sealed.        🟢
//   (b) DOUBLE-COUNTING: E_band − E_HF = ½ Σ γ δq δq exactly (the second-order
//       correction the bare band sum over-counts); and E_rep shifts E_HF by exactly
//       E_rep while leaving the gradient untouched (a constant in δq).               🟢
//   (c) SECOND-ORDER STATIONARY POINT: a ±δ probe about δq* is a symmetric parabola
//       (E(+δ) = E(−δ) to machine precision, |2nd-diff| > 0). HONEST (d6): the sign
//       is NEGATIVE — δq* is a variational MAXIMUM, the genuine Foulkes-Haydock
//       reversed-curvature property — we PRINT it, we do NOT claim a minimum.        🟢
//   (d) FIXED-POINT SELF-CONSISTENCY + R6 BRIDGE: the relaxed δq* reproduces itself
//       under one more population step (p[δq*] = δq* within tol), and its derived
//       Mulliken charge q = n_val − δq* is a valid SCC charge. HONEST (d6): this is
//       the VARIATIONAL refinement of R6's charge-map loop — R6's charge fixed point
//       is a DIFFERENT (non-variational) self-consistency convention, so we assert
//       the population self-consistency, NOT numerical equality with R6's q*.        🟢
//
// HONEST (d6): the deep result is that R6's charge map δq = n_val − p − q_ref is NOT
//   a variational stationary point of any Σ n ε ± ½ γ δq δq functional (verified — its
//   gradient there is O(1)); the ONLY variable that makes E_HF stationary is the
//   population itself (δq = p). We report that plainly: the closure of dE/dδq = 0 is
//   real and exact, the curvature is the reversed Harris-Foulkes sign, and the R6
//   bridge is a convention map, not an identity. Nothing is forced.
//
// Run:  HEXA_LANG=. hexa run stdlib/qforge/atoms/harris_foulkes_selftest.hexa
// PASS: "qforge_harris_foulkes_selftest PASS".
use "stdlib/qforge/atoms/harris_foulkes"
use "stdlib/qforge/atoms/scc_scf"
use "stdlib/qforge/atoms/eht_scc"

fn _abs(x: float) -> float { if x < 0.0 { return -x } return x }
fn _ck_close(name: str, got: float, want: float, eps: float) -> int {
    if _abs(got - want) <= eps { println("PASS " + name + " (" + to_string(got) + ")") ; return 0 }
    println("FAIL " + name + " — got " + to_string(got) + " want " + to_string(want)) ; return 1
}
fn _ck_true(name: str, cond: bool) -> int {
    if cond { println("PASS " + name) ; return 0 }
    println("FAIL " + name) ; return 1
}

// central finite-difference of E_HF along component c (numeric gradient cross-check)
fn _numgrad(heht: [float], pos: [float], dq: [float], alpha: [float], orb2atom: [int],
            occ: [float], norb: int, natom: int, c: int) -> float {
    let h = 0.000001
    let mut dp: [float] = []
    let mut dm: [float] = []
    let mut a = 0
    while a < natom {
        if a == c { dp.push(dq[a] + h) ; dm.push(dq[a] - h) }
        else { dp.push(dq[a]) ; dm.push(dq[a]) }
        a = a + 1
    }
    let ep = qforge_hf_energy(heht, pos, dp, alpha, orb2atom, occ, norb, natom, 0.0)
    let em = qforge_hf_energy(heht, pos, dm, alpha, orb2atom, occ, norb, natom, 0.0)
    return (ep - em) / (2.0 * h)
}

fn main() {
    let mut fails = 0

    // ══ SYSTEM A — asymmetric 2-atom / 2-orbital (1 s-orbital per atom) ═════════
    // Same heteronuclear test system as the R5/R6 selftests: two distinct atoms
    // (different on-site H_μ, different α) at R = 1.5, one orbital per atom, closed
    // shell (2 e⁻ in the lower MO). n_val = 1 each (neutral molecule).
    let posA = [0.0, 0.0, 0.0,  1.5, 0.0, 0.0]
    let honA = [-0.62, -0.94]
    let overlapA = [1.0, 0.32, 0.32, 1.0]
    let Kwh = 1.75
    let hehtA = qforge_eht_hamiltonian(honA, overlapA, Kwh)
    let alphaA = [1.05, 0.80]
    let orb2atomA = [0, 1]
    let occA = [2.0, 0.0]
    let nvalA = [1.0, 1.0]
    let qrefA = [0.0, 0.0]

    // ── relax the Harris-Foulkes functional to its stationary point δq* = p[δq*] ──
    // population variable: seed at the neutral population (1 e⁻/atom), damped mixing.
    let dq0 = [0.5, 0.5]
    let beta = 0.15
    let tol = 1.0e-12
    let maxit = 4000
    let resA = qforge_hf_relax(hehtA, posA, dq0, alphaA, orb2atomA, occA, 2, 2,
                               beta, tol, maxit)
    let dqstar = [resA[0], resA[1]]
    let it_run = resA[2]
    let pop_resid = resA[3]
    let grad_norm = resA[4]
    let conv = resA[5]
    println("    [relax] δq* = (" + to_string(dqstar[0]) + ", " + to_string(dqstar[1])
            + ")  iters=" + to_string(it_run) + "  pop_resid=" + to_string(pop_resid)
            + "  grad=" + to_string(grad_norm) + "  conv=" + to_string(conv))
    fails = fails + _ck_true("(relax) converged within maxit", conv > 0.5)
    fails = fails + _ck_true("(relax) finite iteration count", it_run < to_float(maxit))

    // ── (a) STATIONARITY — analytic AND numeric gradient vanish at δq* ───────────
    // THE r6/r7 CLOSURE: dE_HF/dδq = 0. Anchored on the REAL output (printed), and
    // cross-checked by a central finite difference of E_HF (independent of the
    // analytic Hellmann-Feynman formula). Both must be < 1e-6.
    let g = qforge_hf_gradient(hehtA, posA, dqstar, alphaA, orb2atomA, occA, 2, 2)
    let gn = qforge_hf_grad_norm(g)
    let ng0 = _numgrad(hehtA, posA, dqstar, alphaA, orb2atomA, occA, 2, 2, 0)
    let ng1 = _numgrad(hehtA, posA, dqstar, alphaA, orb2atomA, occA, 2, 2, 1)
    println("    [a] analytic ∂E/∂δq = (" + to_string(g[0]) + ", " + to_string(g[1])
            + ")   numeric (" + to_string(ng0) + ", " + to_string(ng1) + ")")
    fails = fails + _ck_true("(a) analytic ‖∂E_HF/∂δq*‖_∞ < 1e-6 (dE/dδq=0 CLOSED)",
                             gn < 0.000001)
    fails = fails + _ck_true("(a) numeric ‖∂E_HF/∂δq*‖_∞ < 1e-6 (FD cross-check)",
                             _abs(ng0) < 0.000001 && _abs(ng1) < 0.000001)
    fails = fails + _ck_close("(a) analytic == numeric grad[0]", g[0], ng0, 0.00001)
    fails = fails + _ck_close("(a) analytic == numeric grad[1]", g[1], ng1, 0.00001)

    // ── (b) DOUBLE-COUNTING + E_rep shift ───────────────────────────────────────
    // E_band − E_HF = ½ Σ γ δq δq exactly (the second-order correction the bare band
    // sum over-counts). And E_rep shifts E_HF by exactly E_rep, leaving the gradient
    // untouched (a δq-constant).
    let vstar = qforge_scc_potential(posA, dqstar, alphaA)
    let hstar = qforge_scc_dressed_h(hehtA, vstar, orb2atomA, 2)
    let epsstar = qforge_eht_levels(hstar, 2)
    let ebandstar = qforge_eht_band_energy(epsstar, occA)
    let dc = qforge_hf_double_count(hehtA, posA, dqstar, alphaA, orb2atomA, occA, 2, 2, 0.0)
    let escc = qforge_scc_energy2(posA, dqstar, alphaA)
    println("    [b] E_band=" + to_string(ebandstar) + "  E_band−E_HF=" + to_string(dc)
            + "  ½γδqδq=" + to_string(escc))
    fails = fails + _ck_close("(b) double-count E_band−E_HF == ½γδqδq", dc, escc, 1.0e-9)
    let erepv = 3.7
    let e_no = qforge_hf_energy(hehtA, posA, dqstar, alphaA, orb2atomA, occA, 2, 2, 0.0)
    let e_rep = qforge_hf_energy(hehtA, posA, dqstar, alphaA, orb2atomA, occA, 2, 2, erepv)
    fails = fails + _ck_close("(b) E_rep shifts E_HF by exactly E_rep", e_rep - e_no, erepv, 1.0e-12)
    // gradient is invariant to E_rep (it's a constant) — analytic grad has no E_rep arg,
    // so this is true by construction; assert the value matches the un-shifted grad.
    let g_chk = qforge_hf_gradient(hehtA, posA, dqstar, alphaA, orb2atomA, occA, 2, 2)
    fails = fails + _ck_close("(b) gradient invariant to E_rep", qforge_hf_grad_norm(g_chk), gn, 1.0e-15)

    // ── (c) SECOND-ORDER STATIONARY POINT (symmetric parabola; sign printed) ─────
    // A ±δ probe along each charge direction: E(+δ) == E(−δ) to high precision (the
    // first-order term is zero ⇒ symmetric), and the second difference is non-zero
    // (a genuine quadratic stationary point). HONEST (d6): the second difference is
    // NEGATIVE — δq* is a variational MAXIMUM (Foulkes-Haydock reversed curvature).
    // We assert the SYMMETRY + non-zero curvature + report the sign, NOT a minimum.
    let d = 0.02
    let e0 = e_no
    // antisymmetric direction (+δ,−δ)
    let ea_p = qforge_hf_energy(hehtA, posA, [dqstar[0]+d, dqstar[1]-d], alphaA, orb2atomA, occA, 2, 2, 0.0)
    let ea_m = qforge_hf_energy(hehtA, posA, [dqstar[0]-d, dqstar[1]+d], alphaA, orb2atomA, occA, 2, 2, 0.0)
    let sd_anti = ea_p + ea_m - 2.0 * e0
    // symmetric direction (+δ,+δ)
    let es_p = qforge_hf_energy(hehtA, posA, [dqstar[0]+d, dqstar[1]+d], alphaA, orb2atomA, occA, 2, 2, 0.0)
    let es_m = qforge_hf_energy(hehtA, posA, [dqstar[0]-d, dqstar[1]-d], alphaA, orb2atomA, occA, 2, 2, 0.0)
    let sd_sym = es_p + es_m - 2.0 * e0
    println("    [c] E(δq*)=" + to_string(e0)
            + "  anti: E(+δ)=" + to_string(ea_p) + " E(−δ)=" + to_string(ea_m)
            + " 2nd-diff=" + to_string(sd_anti))
    println("    [c] sym 2nd-diff=" + to_string(sd_sym)
            + "  (sign NEGATIVE ⇒ variational MAXIMUM — Foulkes-Haydock reversed curvature)")
    // symmetry tol: the eigh-Jacobi noise floor sits at ~1e-9; the curvature signal
    // (|2nd-diff| ≈ 4e-4) is 5 orders larger, so a 1e-6 symmetry tol still proves the
    // first-order term is zero to >100× the curvature (a genuine symmetric parabola).
    fails = fails + _ck_close("(c) probe symmetric E(+δ)==E(−δ) anti (1st-order=0)",
                              ea_p, ea_m, 1.0e-6)
    fails = fails + _ck_close("(c) probe symmetric E(+δ)==E(−δ) sym (1st-order=0)",
                              es_p, es_m, 1.0e-6)
    fails = fails + _ck_true("(c) non-zero second-order curvature (genuine stationary point)",
                             _abs(sd_anti) > 1.0e-7 && _abs(sd_sym) > 1.0e-7)
    fails = fails + _ck_true("(c) curvature sign NEGATIVE (HF maximum — honest, not forced)",
                             sd_anti < 0.0 && sd_sym < 0.0)

    // ── (d) FIXED-POINT SELF-CONSISTENCY + R6 BRIDGE ────────────────────────────
    // p[δq*] == δq* within tol (one more population step reproduces δq*). And the
    // derived Mulliken charge q = n_val − δq* is reported. HONEST: this is the
    // variational refinement of R6's charge-map loop — NOT numerical equality with
    // R6's q* (R6's convention is non-variational, verified by its O(1) gradient).
    let pstar = qforge_hf_populations(hehtA, posA, dqstar, alphaA, orb2atomA, occA, 2, 2)
    let fp0 = _abs(pstar[0] - dqstar[0])
    let fp1 = _abs(pstar[1] - dqstar[1])
    println("    [d] p[δq*] = (" + to_string(pstar[0]) + ", " + to_string(pstar[1])
            + ")   ‖p−δq*‖_∞ = " + to_string(fp0 + fp1))
    fails = fails + _ck_true("(d) p[δq*] == δq* (population self-consistent)",
                             fp0 < 1.0e-8 && fp1 < 1.0e-8)
    let qcharge = qforge_hf_to_scc_charge(dqstar, nvalA, qrefA, 2)
    println("    [d] derived Mulliken charge q = n_val − δq* = ("
            + to_string(qcharge[0]) + ", " + to_string(qcharge[1]) + ")")
    // charge conservation: Σ q = Σ n_val − Σ p = 2 − 2 = 0 (closed shell, 2 e⁻).
    fails = fails + _ck_close("(d) charge conservation Σq = 0", qcharge[0] + qcharge[1], 0.0, 1.0e-8)
    // honest R6 bridge: R6's charge map is non-variational — its gradient at ITS fixed
    // point is O(1), NOT zero. Assert that explicitly (the gap R8 explains).
    let r6 = qforge_scc_scf(hehtA, posA, [0.0, 0.0], alphaA, orb2atomA, occA,
                            nvalA, qrefA, 2, 2, 0.5, 1.0e-12, 400)
    let r6q = [r6[0], r6[1]]
    // E_HF gradient EVALUATED at R6's charge fixed point (treating it as a δq) — O(1).
    let gr6 = qforge_hf_gradient(hehtA, posA, r6q, alphaA, orb2atomA, occA, 2, 2)
    let gr6n = qforge_hf_grad_norm(gr6)
    println("    [d] R6 charge q*=(" + to_string(r6q[0]) + ", " + to_string(r6q[1])
            + ")  ‖∂E_HF/∂δq|_R6‖_∞=" + to_string(gr6n)
            + "  (O(1) ⇒ R6 fixed point is NON-variational — the r6/r7 gap R8 closes)")
    fails = fails + _ck_true("(d) R6 charge fixed point is NON-variational (grad O(1) there)",
                             gr6n > 0.1)

    // ══ SYSTEM B — symmetric homonuclear dimer (δq* equal populations) ══════════
    // Two IDENTICAL atoms, symmetric geometry. The HF stationary populations are
    // EQUAL (1 e⁻ each by symmetry), the gradient still vanishes, and the derived
    // charge is zero — the symmetric reference IS the variational stationary point.
    let posB = [0.0, 0.0, 0.0,  1.4, 0.0, 0.0]
    let honB = [-0.70, -0.70]
    let overlapB = [1.0, 0.30, 0.30, 1.0]
    let hehtB = qforge_eht_hamiltonian(honB, overlapB, Kwh)
    let alphaB = [0.95, 0.95]
    let orb2atomB = [0, 1]
    let occB = [2.0, 0.0]
    let resB = qforge_hf_relax(hehtB, posB, [0.5, 0.5], alphaB, orb2atomB, occB, 2, 2,
                               0.2, 1.0e-12, 4000)
    let dqB = [resB[0], resB[1]]
    let gB = qforge_hf_gradient(hehtB, posB, dqB, alphaB, orb2atomB, occB, 2, 2)
    println("    [B] symmetric δq* = (" + to_string(dqB[0]) + ", " + to_string(dqB[1])
            + ")  grad=" + to_string(qforge_hf_grad_norm(gB)))
    fails = fails + _ck_close("(B) symmetric δq*₀ == δq*₁ (equal populations)",
                              dqB[0], dqB[1], 1.0e-8)
    fails = fails + _ck_true("(B) symmetric ‖∂E_HF/∂δq*‖_∞ < 1e-6 (stationary)",
                             qforge_hf_grad_norm(gB) < 0.000001)
    let qB = qforge_hf_to_scc_charge(dqB, [1.0, 1.0], [0.0, 0.0], 2)
    fails = fails + _ck_close("(B) symmetric derived charge q₀ → 0", qB[0], 0.0, 1.0e-8)

    if fails == 0 { println("qforge_harris_foulkes_selftest PASS") }
    else { println("qforge_harris_foulkes_selftest FAIL — " + to_string(fails) + " case(s)") }
}
