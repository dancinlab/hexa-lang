// HEXA Standard Library — qforge/atoms/torsion_grad
//
// @version 0.1.0
// @capabilities [pure]
//
// QFORGE atoms-scale brick #7b — the analytic dihedral Jacobian ∂φ/∂R that folds
// the R5 torsion potential ∂V/∂φ (torsion.hexa, qforge_torsion_dedphi) onto the
// Cartesian coordinates of the four dihedral atoms. R5 owned V(φ) and ∂V/∂φ
// exactly but left ∂φ/∂R to round-7; this brick supplies the standard
// Blondel-Karplus analytic dihedral gradient and completes the torsional force
//
//     F_i = − ∂V/∂R_i = − (∂V/∂φ) (∂φ/∂R_i) .
//
// (Blondel & Karplus, J. Comput. Chem. 17 1132 (1996) — the closed-form dihedral
// derivative; Bekker et al. for the equivalent cross-product form; the same
// gradient used by GROMACS / every MD engine.)
//
// THE GEOMETRY ────────────────────────────────────────────────────────────────
//   Four bonded atoms i-j-k-l with bond vectors
//       F = r_i − r_j ,   G = r_j − r_k ,   H = r_l − r_k .
//   Define the plane normals  A = F × G ,  B = H × G . The signed dihedral φ
//   satisfies  cos φ = (A·B)/(|A||B|) ,  sin φ ∝ (B×A)·G. The Blondel-Karplus
//   analytic gradient of φ w.r.t. the four positions is
//
//       ∂φ/∂r_i = −(|G| / |A|²) A
//       ∂φ/∂r_l =  (|G| / |B|²) B
//       ∂φ/∂r_j = ( (F·G)/|G|² − 1 ) ∂φ/∂r_i − ( (H·G)/|G|² ) ∂φ/∂r_l
//       ∂φ/∂r_k = −( (F·G)/|G|² )     ∂φ/∂r_i + ( (H·G)/|G|² − 1 ) ∂φ/∂r_l
//
//   These four 3-vectors satisfy ∂φ/∂r_i + ∂φ/∂r_j + ∂φ/∂r_k + ∂φ/∂r_l = 0
//   (translational invariance — a rigid shift of all four atoms leaves φ
//   unchanged), so the total torsional force on the four-atom cluster is zero.
//   This is the exact analytic Jacobian; the selftest cross-checks it against a
//   central finite difference of qforge_dihedral_angle (torsion.hexa).
//
// d4-generic: the four atom indices (i,j,k,l) and the flat position array are the
//   ONLY inputs — no bond type, element, or multiplicity is referenced here. The
//   force assembly multiplies by the caller's ∂V/∂φ (any V_n, δ_n, n table).
//
// reuse (d19): the dihedral ANGLE φ itself comes from qforge_dihedral_angle in
//   torsion.hexa (one source for φ); ∂V/∂φ from qforge_torsion_dedphi (R5). This
//   brick adds ONLY the geometric Jacobian ∂φ/∂R and the chain-rule assembly —
//   no potential, no angle, no element is re-implemented (d3).
use "stdlib/qforge/atoms/torsion"

// ── small vector helpers (flat 3-vectors) ────────────────────────────────────
fn _sub3(pos: [float], a: int, b: int) -> [float] {
    return [pos[3*a+0]-pos[3*b+0], pos[3*a+1]-pos[3*b+1], pos[3*a+2]-pos[3*b+2]]
}
fn _cross3(u: [float], v: [float]) -> [float] {
    return [u[1]*v[2]-u[2]*v[1], u[2]*v[0]-u[0]*v[2], u[0]*v[1]-u[1]*v[0]]
}
fn _dot3(u: [float], v: [float]) -> float { return u[0]*v[0]+u[1]*v[1]+u[2]*v[2] }
fn _sqrtf(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x
    if g < 1.0 { g = 1.0 }
    let mut it = 0
    while it < 60 { let ng = 0.5*(g + x/g) ; if ng == g { break } ; g = ng ; it = it + 1 }
    return g
}
fn _norm3(u: [float]) -> float { return _sqrtf(_dot3(u, u)) }

// ── Blondel-Karplus analytic ∂φ/∂R for atoms i-j-k-l ─────────────────────────
//   Returns a FLAT length-12 array = the four 3-vectors stacked:
//     out[0..2]  = ∂φ/∂r_i      out[3..5]  = ∂φ/∂r_j
//     out[6..8]  = ∂φ/∂r_k      out[9..11] = ∂φ/∂r_l
//   Exact closed form (above). By translational invariance the four 3-vectors
//   sum componentwise to zero — verified in the selftest. d4-generic over (i,j,k,l)
//   and any geometry that is not a degenerate (collinear) dihedral.
pub fn qforge_dihedral_dphi_dr(pos: [float], i: int, j: int, k: int,
                               l: int) -> [float] {
    let fvec = _sub3(pos, i, j)        // F = r_i − r_j
    let gvec = _sub3(pos, j, k)        // G = r_j − r_k
    let hvec = _sub3(pos, l, k)        // H = r_l − r_k
    let avec = _cross3(fvec, gvec)     // A = F × G   (normal of plane i,j,k)
    let bvec = _cross3(hvec, gvec)     // B = H × G   (normal of plane j,k,l)
    let gnorm = _norm3(gvec)
    let a2 = _dot3(avec, avec)         // |A|²
    let b2 = _dot3(bvec, bvec)         // |B|²

    // ∂φ/∂r_i = −(|G|/|A|²) A ,  ∂φ/∂r_l = +(|G|/|B|²) B
    let mut di: [float] = [0.0, 0.0, 0.0]
    let mut dl: [float] = [0.0, 0.0, 0.0]
    if a2 > 0.0 {
        let ca = 0.0 - gnorm / a2
        di = [ca*avec[0], ca*avec[1], ca*avec[2]]
    }
    if b2 > 0.0 {
        let cb = gnorm / b2
        dl = [cb*bvec[0], cb*bvec[1], cb*bvec[2]]
    }

    // projection coefficients  p = (F·G)/|G|² ,  q = (H·G)/|G|²
    let g2 = gnorm * gnorm
    let mut pcoef = 0.0
    let mut qcoef = 0.0
    if g2 > 0.0 {
        pcoef = _dot3(fvec, gvec) / g2
        qcoef = _dot3(hvec, gvec) / g2
    }

    // ∂φ/∂r_j = (p − 1) ∂φ/∂r_i − q ∂φ/∂r_l
    // ∂φ/∂r_k = −p ∂φ/∂r_i + (q − 1) ∂φ/∂r_l
    let mut dj: [float] = [0.0, 0.0, 0.0]
    let mut dk: [float] = [0.0, 0.0, 0.0]
    let mut c = 0
    while c < 3 {
        dj[c] = (pcoef - 1.0) * di[c] - qcoef * dl[c]
        dk[c] = (0.0 - pcoef) * di[c] + (qcoef - 1.0) * dl[c]
        c = c + 1
    }

    return [di[0], di[1], di[2],  dj[0], dj[1], dj[2],
            dk[0], dk[1], dk[2],  dl[0], dl[1], dl[2]]
}

// ── Cartesian torsional force on the four dihedral atoms ──────────────────────
//   Chain rule  F = −∂V/∂φ · ∂φ/∂R, with ∂V/∂φ = qforge_torsion_dedphi (R5) and
//   ∂φ/∂R = qforge_dihedral_dphi_dr (above). Returns a flat length-12 force array
//   in the SAME stacked i,j,k,l layout. Σ forces = 0 (Newton's third law over the
//   four-atom cluster) because Σ ∂φ/∂R = 0. d4-generic in the {mult,barrier,phase}
//   torsion table.
pub fn qforge_torsion_force(pos: [float], i: int, j: int, k: int, l: int,
                            mult: [float], barrier: [float],
                            phase: [float]) -> [float] {
    let phi = qforge_dihedral_angle(pos, i, j, k, l)
    let dvdphi = qforge_torsion_dedphi(phi, mult, barrier, phase)
    let dphidr = qforge_dihedral_dphi_dr(pos, i, j, k, l)
    let mut force: [float] = []
    let mut c = 0
    while c < 12 {
        force.push(0.0 - dvdphi * dphidr[c])     // F = −(∂V/∂φ)(∂φ/∂R)
        c = c + 1
    }
    return force
}
