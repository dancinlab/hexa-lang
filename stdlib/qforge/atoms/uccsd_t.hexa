// HEXA Standard Library — qforge/atoms/uccsd_t
//
// @version 0.1.0
// @capabilities [pure]
//
// QFORGE-ATOMS brick #27 — UNRESTRICTED CCSD(T) (UCCSD(T)): the perturbative
// connected-triples correction E_(T) on the converged UCCSD amplitudes for an
// OPEN-SHELL (UHF) reference. This completes the open-shell ladder to the full
// gold standard — the open-shell analogue of the r18 closed-shell RCCSD(T):
//
//   closed shell:  RHF → RMP2 → RCCSD → RCCSD(T)         (r16/r17/r18)
//   open shell:    UHF → UMP2 → UCCSD → UCCSD(T)         (r25/r26/THIS)
//
// ── the key realization (d19 — REUSE the r18 spin-orbital (T) VERBATIM) ───────────────
//   The r18 (T) kernel `ccsd_t_energy(W, t1, t2, eps_so, nso, nocc)` (Raghavachari-
//   Trucks-Pople-Head-Gordon spin-orbital form) is ALREADY spin-general: it contracts
//   ONLY the converged T1/T2, the antisymmetrized spin-orbital tensor ⟨pq||rs⟩, and the
//   spin-orbital energies ε_so, with the occupied set contiguous 0..nocc−1. It NEVER
//   assumes the reference is restricted. So UCCSD(T) = feed the UHF spin-orbital data
//   (the SAME permuted W + eps_so + converged T1/T2 that r26 uccsd_from_uhf builds and
//   iterates) into the EXISTING r18 ccsd_t_energy. ccsd_t.hexa is BYTE-UNTOUCHED — the
//   entire (T) machinery (disconnected/connected triples, P(i/jk)P(a/bc), the 1/36 sum)
//   is reused unmodified. UCCSD(T) is pure ADDITIVE WIRING.
//
// ── what is new here (the ONLY new piece) ─────────────────────────────────────────────
//   r26 uccsd_from_uhf returns the energy but DISCARDS the converged T1/T2 + W + eps_so
//   that the (T) correction needs. So uccsd_amps_from_uhf below re-runs the IDENTICAL r26
//   UHF spin-orbital setup (the four-block tensor, the occupied-first permutation, the
//   r17 ccsd_iterate loop — reused verbatim) and RETURNS the converged amplitudes +
//   permuted W + eps_so, exactly mirroring r18's ccsd_amps_from_mo_eri. The UCCSD energy
//   is byte-identical to r26 (same loop). Then uccsd_t_from_uhf adds ccsd_t_energy on top.
//
// ── closed-shell reduction (g5 verdict a) ─────────────────────────────────────────────
//   When n_α=n_β and Cα=Cβ (εα=εβ), the UHF spin-orbital tensor collapses to the
//   restricted tensor, the permutation is the identity-on-occ, and UCCSD(T) reproduces
//   the SEALED r18 RCCSD(T) E_(T) = −9.987727211e-05 (H₂O/STO-3G) to machine precision —
//   the open-shell (T) reduces EXACTLY to the closed-shell (T) when unpolarized.
//
// ── honest scope (d6) ─────────────────────────────────────────────────────────────────
//   UCCSD(T) sits on a SPIN-CONTAMINATED UHF reference (⟨S²⟩≠S(S+1) exactly — the
//   selftest REPORTS the UHF ⟨S²⟩ for CH₃ = 0.7652248, never hides it). The (T) correction
//   INHERITS that contamination from the UHF orbitals; the spin-adapted ROHF-CCSD(T) is the
//   cleaner variant. The amplitude iteration and the triples sums are EXACT for the supplied
//   integrals; nothing is fitted or forced. STO-3G minimal basis still bounds the absolute
//   energy (basis-set limit needs cc-pVXZ — the r16 cc-pVDZ/TZ bricks).
//
// reuse (d19 · d3): the r18 ccsd_t_energy (the spin-orbital (T) — BYTE-UNTOUCHED) + the
//   r26 uccsd_spinorb_eri_uhf / uccsd_spinorb_eps_uhf (the UHF four-block tensor + ε_so) +
//   the r17 ccsd_iterate / ccsd_energy / ccsd_mp2_guess / ccsd_t2_rmsd (BYTE-UNTOUCHED).
//   No new (T) kernel, no new amplitude solver, no new transform minted.
//
// ⚠ PARSER (f37015ac): every long index-summed arithmetic assignment is one physical line.

use "stdlib/qforge/atoms/ccsd"
use "stdlib/qforge/atoms/ccsd_t"
use "stdlib/qforge/atoms/uccsd"

// ════════════════════════════════════════════════════════════════════════════
//   converged UCCSD amplitudes on a UHF reference (re-run r26, RETURN T1/T2/W/eps)
// ════════════════════════════════════════════════════════════════════════════
//
// Mirrors r18 ccsd_amps_from_mo_eri, but for the UHF reference: builds the r26 UHF
// spin-orbital tensor + the occupied-first permutation, runs the r17 ccsd_iterate to
// convergence, and RETURNS the converged amplitudes + the permuted (occ-contiguous) W
// and eps_so so the r18 (T) builder reads them directly. The UCCSD energy is byte-
// identical to r26 uccsd_from_uhf (same setup, same loop).
//
// Returns [ e_uccsd, e_mp2_first, t1, t2, W, eps_so, iters, residual, converged ].
pub fn uccsd_amps_from_uhf(
    eri_ao: [float], Ca: [float], Cb: [float],
    eps_a: [float], eps_b: [float],
    n: int, na: int, nb: int,
    max_iter: int, e_tol: float
) -> [any] {
    let nso = 2 * n
    let nocc = na + nb
    // UHF spin-orbital integrals + energies in the NATURAL (2k+σ) order (r26 reuse).
    let W0 = uccsd_spinorb_eri_uhf(eri_ao, Ca, Cb, n)
    let eps0 = uccsd_spinorb_eps_uhf(eps_a, eps_b, n)

    // ── permutation: occupied spin-orbitals first (contiguous), virtual last (r26) ──
    let mut perm: [int] = []
    let mut k = 0
    while k < na { perm.push(2 * k) ; k = k + 1 }
    k = 0
    while k < nb { perm.push(2 * k + 1) ; k = k + 1 }
    k = na
    while k < n { perm.push(2 * k) ; k = k + 1 }
    k = nb
    while k < n { perm.push(2 * k + 1) ; k = k + 1 }

    // permuted energies
    let mut eps_so: [float] = []
    let mut a0 = 0
    while a0 < nso { eps_so.push(eps0[perm[a0]]) ; a0 = a0 + 1 }
    // permuted antisymmetrized tensor: W[(p,q,r,s)] = W0[(perm[p],perm[q],perm[r],perm[s])]
    let mut W: [float] = []
    let mut p = 0
    while p < nso {
        let op = perm[p]
        let mut q = 0
        while q < nso {
            let oq = perm[q]
            let mut r = 0
            while r < nso {
                let or0 = perm[r]
                let mut s = 0
                while s < nso {
                    let os = perm[s]
                    W.push(W0[((op * nso + oq) * nso + or0) * nso + os])
                    s = s + 1
                }
                r = r + 1
            }
            q = q + 1
        }
        p = p + 1
    }

    // ── reuse the r17 spin-orbital CCSD solver VERBATIM (return the converged amps) ──
    let mut t1: [float] = []
    let mut ii = 0
    while ii < nso * nso { t1.push(0.0) ; ii = ii + 1 }
    let mut t2 = ccsd_mp2_guess(W, eps_so, nso, nocc)

    let e_mp2_first = ccsd_energy(W, t1, t2, nso, nocc)
    let mut e_old = e_mp2_first
    let mut iters = 0
    let mut residual = 1.0
    let mut converged = false
    while iters < max_iter {
        let res = ccsd_iterate(W, eps_so, t1, t2, nso, nocc)
        let t1new: [float] = res[0]
        let t2new: [float] = res[1]
        residual = ccsd_t2_rmsd(t2new, t2, nso)
        t1 = t1new
        t2 = t2new
        let e_new = ccsd_energy(W, t1, t2, nso, nocc)
        iters = iters + 1
        let de = e_new - e_old
        let ade = if de < 0.0 { 0.0 - de } else { de }
        e_old = e_new
        if ade < e_tol && residual < e_tol { converged = true ; break }
    }
    let e_uccsd = ccsd_energy(W, t1, t2, nso, nocc)
    return [e_uccsd, e_mp2_first, t1, t2, W, eps_so, iters, residual, converged]
}

// ════════════════════════════════════════════════════════════════════════════
//   driver — converged UHF MO data  →  full UCCSD(T)
// ════════════════════════════════════════════════════════════════════════════
//
// One call: re-run r26 UCCSD to convergence (returns the same E_UCCSD), then add the
// r18 perturbative (T) correction on the converged spin-orbital amplitudes. Returns
//   [ e_uccsd, e_t, e_uccsd_t, e_uccsd_t_total, e_mp2_first, iters, residual, converged ]
// with e_uccsd_t = e_uccsd + e_t (the open-shell gold-standard correlation energy) and
// e_uccsd_t_total = e_uhf + e_uccsd_t. e_t < 0 (triples lower the energy further).
pub fn uccsd_t_from_uhf(
    eri_ao: [float], Ca: [float], Cb: [float],
    eps_a: [float], eps_b: [float],
    n: int, na: int, nb: int, e_uhf: float,
    max_iter: int, e_tol: float
) -> [any] {
    let nso = 2 * n
    let nocc = na + nb
    let uc = uccsd_amps_from_uhf(eri_ao, Ca, Cb, eps_a, eps_b, n, na, nb, max_iter, e_tol)
    let e_uccsd: float = uc[0]
    let e_mp2_first: float = uc[1]
    let t1: [float] = uc[2]
    let t2: [float] = uc[3]
    let W: [float] = uc[4]
    let eps_so: [float] = uc[5]
    let iters: int = uc[6]
    let residual: float = uc[7]
    let converged: bool = uc[8]
    // reuse the r18 spin-orbital (T) kernel VERBATIM on the UHF spin-orbital amplitudes
    let e_t = ccsd_t_energy(W, t1, t2, eps_so, nso, nocc)
    let e_uccsd_t = e_uccsd + e_t
    let e_total = e_uhf + e_uccsd_t
    return [e_uccsd, e_t, e_uccsd_t, e_total, e_mp2_first, iters, residual, converged]
}
