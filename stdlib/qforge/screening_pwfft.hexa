// HEXA Standard Library — qforge/screening_pwfft
//
// @version 0.1.0
// @capabilities [pure]
//
// QFORGE migration-gate breakthrough — the POW2-PADDED REAL-SPACE FFT POISSON for
// the screened el-ph vertex (the scf_pw.hexa:88 non-pow2 FFT-Poisson wall, the
// precisely-localized migration-gate blocker).
//
// ── THE WALL (d2/d6, exposed on the CONVERGED CaH6 cell n=645) ────────────────────
//   The screened-ΔV Dyson loop (qforge_screened_dv_columns_anderson) folds a
//   screening kernel (V_H+f_xc)[Δρ] over the 1st-order density response Δρ. The
//   prior kernel (qpwd_drho_to_dvscf, pw_frontend.hexa) screens in COEFFICIENT
//   space with a G-DIAGONAL proxy:
//       drho[i]      = Σ_n 2·c_n(G_i)·Δc_n(G_i)          (the G-DIAGONAL of the
//                                                          density-matrix response)
//       ΔV_H[i]      = 4π·drho[i]/|G_i|²
//   This proxy is NOT the physical density response Δρ̂(G). The true Fourier
//   component is the AUTOCORRELATION (a convolution in G):
//       Δρ̂(G) = Σ_n 2·Σ_{G'} c_n(G')·Δc_n(G'−G)          (≠ the diagonal G'=G term)
//   On the under-converged basis (n=16) the diagonal proxy happened to carry a
//   metallic-stable signal (ratio≈1.82, Anderson iterated); on the CONVERGED basis
//   (n=645) the diagonal term vanishes (orthogonality of the converged manifold) →
//   the kernel returns ≈0 → Anderson sees f_0≈0 → 0 iters → screened == bare → λ
//   stuck at the BARE 4.137 (the #2771 honest-negative finding).
//
// ── THE FIX — GENUINE REAL-SPACE FFT POISSON (this module) ────────────────────────
//   Compute the density response by the REAL convolution, on a pow2-PADDED grid so
//   the radix-2 core_fft (each axis must be a power of two) ALWAYS applies, at ANY
//   PW count n (not just pow2 n):
//       ① recover the integer Miller indices (h,k,l) of every PW coefficient from
//          its cartesian G = h·b1+k·b2+l·b3 (the qpw_gvectors basis).
//       ② size a regular Miller grid that contains every (h,k,l), then PAD each axis
//          up to the next power of two (Nx,Ny,Nz) — the pow2 FFT requirement met for
//          an ARBITRARY converged basis.
//       ③ scatter c_n(G_i) and Δc_n(G_i) onto the (Nx,Ny,Nz) reciprocal grid.
//       ④ inverse-FFT each → ψ_n(r), Δψ_n(r) on the real-space cube.
//       ⑤ Δρ(r) = Σ_n 2·ψ_n(r)·Δψ_n(r)        (the REAL pointwise product = the
//                                               convolution theorem applied genuinely).
//       ⑥ forward-FFT Δρ(r) → Δρ̂(G), apply the Poisson kernel V_H(G)=4π Δρ̂(G)/|G|²
//          (G=0 → 0, neutral-cell gauge), inverse-FFT → V_H(r); plus the local LDA
//          f_xc[ρ̄]·Δρ(r) term (uniform-gas, the basis-decoupled scf_pw convention).
//       ⑦ forward-FFT ΔV_scr(r) → ΔV_scr(G), GATHER back onto the PW coefficients.
//   The screening correction on coefficient i is ΔV_scr(G_i) — the genuine RPA+ALDA
//   dielectric response, non-zero at ANY n.
//
// d4 GENERIC — the Miller grid + reciprocal basis + ρ̄ are DATA; CaH6/LaH10/Li2MgH16
//   all traverse this one path. d19 REUSE — stdlib/signal/core_fft fft3/ifft3 (the
//   verified radix-2 3D FFT) verbatim; ZERO FFT re-implementation.
//
// d6 HONEST — at Γ with a real local potential the PW coefficients are REAL
//   (assembler.hexa:17). We carry the imaginary channel through the FFTs (it is
//   produced by e^{iG·r}); the physical V_H(r) and Δρ(r) are real → we take the real
//   part on the way back, and the gathered ΔV_scr(G_i) real part is the screening
//   correction. The pow2 padding is EXACT (zero-padding a band-limited spectrum does
//   not alias when the grid contains 2·max|h| per axis — we size for it).

use "stdlib/signal/core_fft"
use "stdlib/qforge/screening"      // qforge_fx_lda — LDA-exchange kernel f_x[ρ]
use "stdlib/qforge/correlation"    // qforge_fc_pw92 — PW92 correlation kernel f_c[ρ]

let PWFFT_PI: float = 3.14159265358979323846
let PWFFT_4PI: float = 12.5663706143591729539

// ── next power of two ≥ m (m≤1 → 1) ─────────────────────────────────────────────
pub fn qpwfft_next_pow2(m: int) -> int {
    if m <= 1 { return 1 }
    let mut p = 1
    while p < m { p = p * 2 }
    return p
}

// ── staged Miller grid for the PW-coefficient FFT-Poisson screening ──────────────
//   Filled once per cell by qpwfft_stage from the gvecs + reciprocal basis. The
//   per-coefficient Miller indices (hh,kk,ll) and the pow2 grid dims (Nx,Ny,Nz) let
//   the kernel scatter/gather between the PW basis and the real-space cube.
let mut PWFFT_ON: bool = false
let mut PWFFT_N: int = 0            // number of PW coefficients
let mut PWFFT_HH: [int] = []        // Miller h per coefficient
let mut PWFFT_KK: [int] = []        // Miller k per coefficient
let mut PWFFT_LL: [int] = []        // Miller l per coefficient
let mut PWFFT_NX: int = 0           // pow2 grid dims
let mut PWFFT_NY: int = 0
let mut PWFFT_NZ: int = 0
let mut PWFFT_B1: [float] = []      // reciprocal basis (for |G|² on the grid)
let mut PWFFT_B2: [float] = []
let mut PWFFT_B3: [float] = []
let mut PWFFT_FXC: float = 0.0      // uniform-gas f_xc[ρ̄] local kernel coeff (FALLBACK)
let mut PWFFT_LIN: [int] = []       // precomputed grid linear index per coefficient

// ── LOCAL-ALDA (Adler-Wiser local-field) kernel state — the RPA+ALDA closure ─────
//   The uniform-gas PWFFT_FXC above is a SINGLE scalar f_xc[ρ̄] at the MEAN density —
//   the QE-miss residual the gate isolated (screened CaH6 λ=5.05, 15.44% off QE
//   4.376). The GENUINE adiabatic-LDA local-field kernel is SPATIALLY LOCAL:
//       ΔV_xc(r) = f_xc[ρ(r)]·Δρ(r),   f_xc[ρ] = dV_xc/dρ |_{ρ(r)}
//   evaluated at the LOCAL ground-state density ρ(r) on the real-space grid (NOT ρ̄).
//   ρ(r) is reconstructed from the SAME ψ_n columns the convolution already FFTs
//   (ρ(r)=Σ_n 2ψ_n(r)², spin-degenerate occ=2) and normalized to a physical density
//   by the cell volume Ω / Ntot (the real-space cube's volume element). This is the
//   beyond-uniform-gas correction QE's ε⁻¹-screened |g|² carries. d6 — reported as a
//   witness (PWFFT_LOCAL_XC count) so a run shows whether the local kernel fired.
let mut PWFFT_LOCAL: bool = false   // local-ALDA mode (vs uniform-gas scalar fallback)
let mut PWFFT_OMEGA: float = 0.0    // cell volume Ω (bohr³) — ρ(r) physical normalization
let mut PWFFT_XCMODE: int = 1       // 0=Hartree-only · 1=+LDA-x · 2=+LDA-x+PW92-c
let mut PWFFT_LOCAL_XC: int = 0     // witness: #folds that used the local-ALDA kernel
pub fn qpwfft_local_xc_folds() -> int { return PWFFT_LOCAL_XC }
pub fn qpwfft_is_local() -> bool { return PWFFT_LOCAL }

// ── recover the integer Miller index of a cartesian G against the reciprocal basis
//   Solve G = h·b1 + k·b2 + l·b3 for integer (h,k,l) by the closed-form inverse of
//   the 3×3 reciprocal matrix B = [b1 b2 b3] (columns). Robust for the small integer
//   combinations qpw_gvectors emits; rounds to the nearest integer. det≈0 → (0,0,0).
fn qpwfft_miller(gx: float, gy: float, gz: float,
                 b1: [float], b2: [float], b3: [float]) -> [int] {
    // B columns: b1,b2,b3. Solve B·m = G.
    let a11 = b1[0] ; let a12 = b2[0] ; let a13 = b3[0]
    let a21 = b1[1] ; let a22 = b2[1] ; let a23 = b3[1]
    let a31 = b1[2] ; let a32 = b2[2] ; let a33 = b3[2]
    let det = a11 * (a22 * a33 - a23 * a32)
            - a12 * (a21 * a33 - a23 * a31)
            + a13 * (a21 * a32 - a22 * a31)
    if det < 1.0e-30 && det > -1.0e-30 { return [0, 0, 0] }
    let inv = 1.0 / det
    // Cramer's rule (det of B with the respective column replaced by G).
    let dh = gx * (a22 * a33 - a23 * a32)
           - a12 * (gy * a33 - a23 * gz)
           + a13 * (gy * a32 - a22 * gz)
    let dk = a11 * (gy * a33 - a23 * gz)
           - gx * (a21 * a33 - a23 * a31)
           + a13 * (a21 * gz - gy * a31)
    let dl = a11 * (a22 * gz - gy * a32)
           - a12 * (a21 * gz - gy * a31)
           + gx * (a21 * a32 - a22 * a31)
    let h = _qpwfft_round(dh * inv)
    let k = _qpwfft_round(dk * inv)
    let l = _qpwfft_round(dl * inv)
    return [h, k, l]
}

fn _qpwfft_round(x: float) -> int {
    if x >= 0.0 { return to_int(x + 0.5) }
    return to_int(x - 0.5)
}

// ── wrap a signed Miller index onto the [0,N) FFT grid (negative → N+idx) ─────────
fn _qpwfft_wrap(idx: int, n: int) -> int {
    let mut w = idx
    while w < 0 { w = w + n }
    while w >= n { w = w - n }
    return w
}

// ── stage the cell's Miller grid (call once per cell before the screening loop) ──
//   gvecs : flat cartesian G (length 3n) — the qpw_gvectors basis.
//   b1,b2,b3 : reciprocal basis (each 3 floats) — physical |G|².
//   fxc   : uniform-gas f_xc[ρ̄] local kernel coefficient (0 → Hartree-only).
//   Returns true on success (grid sized + Miller recovered), false on malformed.
pub fn qpwfft_stage(gvecs: [float], b1: [float], b2: [float], b3: [float],
                    fxc: float) -> bool {
    let n = len(gvecs) / 3
    if n < 1 || len(b1) != 3 || len(b2) != 3 || len(b3) != 3 {
        PWFFT_ON = false
        return false
    }
    // recover the integer Miller index per coefficient by inverting B (the legacy path).
    // ⚠ FAILS for a SINGULAR reciprocal matrix (det(B)=0 → every G maps to (0,0,0) → a
    // degenerate 1×1×1 grid that collapses the spatial Poisson convolution to a single
    // point). When the caller knows the integer Miller indices (qpw_gvectors_miller),
    // prefer qpwfft_stage_miller — it carries them exactly and is singular-B-immune.
    let mut hh: [int] = [] ; let mut kk: [int] = [] ; let mut ll: [int] = []
    let mut i = 0
    while i < n {
        let m = qpwfft_miller(gvecs[i * 3], gvecs[i * 3 + 1], gvecs[i * 3 + 2], b1, b2, b3)
        hh.push(m[0]) ; kk.push(m[1]) ; ll.push(m[2])
        i = i + 1
    }
    return _qpwfft_stage_core(n, hh, kk, ll, b1, b2, b3, fxc)
}

// ── qpwfft_stage_miller — stage from the EXACT integer Miller indices (no matrix
//    inverse). miller = flat 3·n [(h0,k0,l0),(h1,k1,l1),…] aligned 1:1 with gvecs.
//    This is the SINGULAR-B-SAFE staging path (the BCC primitive's coplanar reciprocal
//    has det(B)=0; the inverse-based qpwfft_stage collapses to 1×1×1, this does NOT).
//    d4 GENERIC — the Miller indices are DATA carried from the generator. d6.
pub fn qpwfft_stage_miller(gvecs: [float], miller: [float],
                           b1: [float], b2: [float], b3: [float], fxc: float) -> bool {
    let n = len(gvecs) / 3
    if n < 1 || len(miller) != 3 * n || len(b1) != 3 || len(b2) != 3 || len(b3) != 3 {
        PWFFT_ON = false
        return false
    }
    let mut hh: [int] = [] ; let mut kk: [int] = [] ; let mut ll: [int] = []
    let mut i = 0
    while i < n {
        hh.push(to_int(miller[i * 3])) ; kk.push(to_int(miller[i * 3 + 1]))
        ll.push(to_int(miller[i * 3 + 2]))
        i = i + 1
    }
    return _qpwfft_stage_core(n, hh, kk, ll, b1, b2, b3, fxc)
}

// ── shared staging core: size the pow2 Miller grid + precompute linear indices ──
fn _qpwfft_stage_core(n: int, hh: [int], kk: [int], ll: [int],
                      b1: [float], b2: [float], b3: [float], fxc: float) -> bool {
    let mut hmax = 0 ; let mut kmax = 0 ; let mut lmax = 0
    let mut i = 0
    while i < n {
        let ah = if hh[i] < 0 { -hh[i] } else { hh[i] }
        let ak = if kk[i] < 0 { -kk[i] } else { kk[i] }
        let al = if ll[i] < 0 { -ll[i] } else { ll[i] }
        if ah > hmax { hmax = ah }
        if ak > kmax { kmax = ak }
        if al > lmax { lmax = al }
        i = i + 1
    }
    // grid must hold the full signed range [−max,+max] AND the Δρ=ψ·Δψ product whose
    // spectrum doubles the band limit → size for 2·max+1 to avoid product aliasing,
    // then pad each axis to the next power of two.
    let nx = qpwfft_next_pow2(4 * hmax + 1)
    let ny = qpwfft_next_pow2(4 * kmax + 1)
    let nz = qpwfft_next_pow2(4 * lmax + 1)
    // precompute the grid linear index of each coefficient (row-major (ix·Ny+iy)·Nz+iz).
    let mut lin: [int] = []
    i = 0
    while i < n {
        let ix = _qpwfft_wrap(hh[i], nx)
        let iy = _qpwfft_wrap(kk[i], ny)
        let iz = _qpwfft_wrap(ll[i], nz)
        lin.push((ix * ny + iy) * nz + iz)
        i = i + 1
    }
    PWFFT_N = n ; PWFFT_HH = hh ; PWFFT_KK = kk ; PWFFT_LL = ll
    PWFFT_NX = nx ; PWFFT_NY = ny ; PWFFT_NZ = nz
    PWFFT_B1 = b1 ; PWFFT_B2 = b2 ; PWFFT_B3 = b3
    PWFFT_FXC = fxc ; PWFFT_LIN = lin
    PWFFT_ON = true
    return true
}

pub fn qpwfft_is_on() -> bool { return PWFFT_ON }
pub fn qpwfft_grid_dims() -> [int] { return [PWFFT_NX, PWFFT_NY, PWFFT_NZ] }

// ── qpwfft_enable_local_alda — switch the screening kernel from the uniform-gas
//    scalar f_xc[ρ̄] to the SPATIALLY-LOCAL adiabatic-LDA f_xc[ρ(r)]·Δρ(r) (the
//    Adler-Wiser local-field / RPA+ALDA closure). Call AFTER qpwfft_stage(_miller).
//      omega   : cell volume Ω (bohr³) — physical ρ(r) normalization (ρ = weight·Ntot/Ω).
//      xc_mode : 0=Hartree-only · 1=+LDA-exchange · 2=+LDA-x+PW92-correlation.
//    The local kernel is evaluated per real-space grid point from ρ(r)=Σ_n 2ψ_n(r)²
//    reconstructed inside qpwfft_dvscr_from_dpsi (the ψ columns are already FFT'd
//    there for Δρ — zero extra transforms beyond the ground-state |ψ|² accumulation).
//    d4 GENERIC — Ω + xc_mode are DATA; d6 — PWFFT_LOCAL_XC witnesses the engage.
pub fn qpwfft_enable_local_alda(omega: float, xc_mode: int) {
    if omega > 0.0 { PWFFT_LOCAL = true ; PWFFT_OMEGA = omega ; PWFFT_XCMODE = xc_mode }
}
pub fn qpwfft_disable_local_alda() { PWFFT_LOCAL = false }

// ── ROUTING WITNESS (d6) — observability for the ad_map→FFT engage path ──────────
//   PWFFT_FOLDS counts how many times qpwfft_dvscr_from_dpsi returned a VALID length-n
//   correction (the genuine convolution actually folded). PWFFT_LAST_ERR records the
//   guard that fired on the LAST call (0=ok · 1=off · 2=nb-bad · 3=col-len · 4=ifft
//   psi · 5=fft drho · 6=ifft vh · 7=fft vscr). At the converged n=645 a 0-fold /
//   nonzero-err witness PROVES the FFT path silently fell back to the diagonal — the
//   precise root-cause signal the 0-iter verdict lacked.
let mut PWFFT_FOLDS: int = 0
let mut PWFFT_LAST_ERR: int = 0
pub fn qpwfft_folds() -> int { return PWFFT_FOLDS }
pub fn qpwfft_last_err() -> int { return PWFFT_LAST_ERR }
pub fn qpwfft_reset_witness() { PWFFT_FOLDS = 0 ; PWFFT_LAST_ERR = 0 ; PWFFT_LOCAL_XC = 0 }

// ── REUSABLE SCRATCH (memory-efficiency, the n=645 DEFER retry-recipe #1) ─────────
//   The per-fold convolution allocated ~20 fresh Ntot grids PER CALL × nb bands ×
//   {6,40} Anderson iters × 3 dirs at the converged basis → OOM-killed mid-screening
//   (RSS 4-5 GB, jetsam). These module-level buffers are sized once per cell (in
//   qpwfft_*_stage_core) and CLEARED (not reallocated) per use, eliminating the
//   N×folds allocation churn. d4/d6 — pure scratch, zero physics change.
let mut PWFFT_ZIM: [float] = []          // reusable zero-imaginary Ntot buffer
fn _qpwfft_zim() -> [float] {
    let ntot = PWFFT_NX * PWFFT_NY * PWFFT_NZ
    if len(PWFFT_ZIM) != ntot {
        PWFFT_ZIM = []
        let mut p = 0
        while p < ntot { PWFFT_ZIM.push(0.0) ; p = p + 1 }
    } else {
        let mut p = 0
        while p < ntot { PWFFT_ZIM[p] = 0.0 ; p = p + 1 }
    }
    return PWFFT_ZIM
}

// ── reusable scratch (OOM fix, d4/d6 — pure-memory, zero physics change): the
//    converged n=645 fold churn (per-band scatter + 2 real-space transforms × 8
//    bands × Anderson iters × 3 dirs) allocated a fresh Ntot grid each call → 4-5GB
//    RSS → jetsam. These module buffers are resized once then CLEARED in place.
//    REAL0/REAL1 are TWO distinct real-space slots so psi_r (slot 0) and dps_r
//    (slot 1) — used together in the ψ·Δψ product — never alias.
let mut PWFFT_SCAT: [float] = []
let mut PWFFT_REAL0: [float] = []
let mut PWFFT_REAL1: [float] = []
let mut PWFFT_DRHO: [float] = []         // reusable Δρ(r) accumulator (per-fold)
let mut PWFFT_RHO: [float] = []          // reusable ρ(r) accumulator (local-ALDA)
fn _qpwfft_grid_zeroed(buf: [float], ntot: int) -> [float] {
    if len(buf) != ntot {
        let mut nb: [float] = []
        let mut p = 0
        while p < ntot { nb.push(0.0) ; p = p + 1 }
        return nb
    }
    let mut p = 0
    while p < ntot { buf[p] = 0.0 ; p = p + 1 }
    return buf
}

// ── scatter a PW-coefficient vector c (length n) onto the (Nx,Ny,Nz) reciprocal
//    grid (re part; im supplied separately as the zeroed PWFFT_ZIM). Reuses PWFFT_SCAT
//    — SAFE because the result is consumed by ifft3 immediately, before the next scatter.
fn _qpwfft_scatter(c: [float]) -> [float] {
    let ntot = PWFFT_NX * PWFFT_NY * PWFFT_NZ
    PWFFT_SCAT = _qpwfft_grid_zeroed(PWFFT_SCAT, ntot)
    let mut i = 0
    while i < PWFFT_N { PWFFT_SCAT[PWFFT_LIN[i]] = PWFFT_SCAT[PWFFT_LIN[i]] + c[i] ; i = i + 1 }
    return PWFFT_SCAT
}

// ── inverse-FFT a scattered reciprocal field → real-space field (real part, length Ntot).
//    slot 0/1 selects a distinct module scratch buffer so two concurrently-live results
//    (psi_r + dps_r) never alias. [] on dim mismatch.
fn _qpwfft_to_real(re_grid: [float], slot: int) -> [float] {
    let ntot = PWFFT_NX * PWFFT_NY * PWFFT_NZ
    let inter = ifft3(re_grid, _qpwfft_zim(), PWFFT_NX, PWFFT_NY, PWFFT_NZ)
    if len(inter) != 2 * ntot { return [] }
    let mut out = if slot == 0 { _qpwfft_grid_zeroed(PWFFT_REAL0, ntot) }
                  else { _qpwfft_grid_zeroed(PWFFT_REAL1, ntot) }
    let mut p = 0
    while p < ntot { out[p] = inter[p * 2] ; p = p + 1 }   // real part
    if slot == 0 { PWFFT_REAL0 = out } else { PWFFT_REAL1 = out }
    return out
}

// ── THE KERNEL: genuine real-space FFT-Poisson screening correction ──────────────
//   psis : ground-state ψ_n PW-coefficient columns (nb × n, the converged manifold).
//   dpsi : 1st-order Δψ_n PW-coefficient columns (nb × n, from Sternheimer).
//   Returns ΔV_scr(G_i) on the PW basis (length n) — the (V_H+f_xc)[Δρ] screening
//   correction, computed by the REAL convolution. [] on malformed / grid off.
pub fn qpwfft_dvscr_from_dpsi(psis: [[float]], dpsi: [[float]]) -> [float] {
    if !PWFFT_ON { PWFFT_LAST_ERR = 1 ; return [] }
    let nb = len(psis)
    if nb < 1 || len(dpsi) != nb { PWFFT_LAST_ERR = 2 ; return [] }
    let n = PWFFT_N
    let ntot = PWFFT_NX * PWFFT_NY * PWFFT_NZ
    // ⑤ accumulate Δρ(r) = Σ_n 2·ψ_n(r)·Δψ_n(r) on the real-space cube. When the
    //   LOCAL-ALDA kernel is on, ALSO accumulate the ground-state ρ(r)=Σ_n 2·ψ_n(r)²
    //   from the SAME ψ_n(r) transforms (zero extra FFTs) — the LOCAL density at
    //   which f_xc[ρ(r)] is evaluated (the Adler-Wiser local-field, beyond ρ̄).
    PWFFT_DRHO = _qpwfft_grid_zeroed(PWFFT_DRHO, ntot)
    PWFFT_RHO = _qpwfft_grid_zeroed(PWFFT_RHO, ntot)
    let drho_r = PWFFT_DRHO
    let rho_r = PWFFT_RHO
    let mut p = 0
    let mut nbnd = 0
    while nbnd < nb {
        if len(psis[nbnd]) != n || len(dpsi[nbnd]) != n { PWFFT_LAST_ERR = 3 ; return [] }
        let psi_r = _qpwfft_to_real(_qpwfft_scatter(psis[nbnd]), 0)
        let dps_r = _qpwfft_to_real(_qpwfft_scatter(dpsi[nbnd]), 1)
        if len(psi_r) != ntot || len(dps_r) != ntot { PWFFT_LAST_ERR = 4 ; return [] }
        let mut r = 0
        while r < ntot {
            drho_r[r] = drho_r[r] + 2.0 * psi_r[r] * dps_r[r]
            if PWFFT_LOCAL { rho_r[r] = rho_r[r] + 2.0 * psi_r[r] * psi_r[r] }
            r = r + 1
        }
        nbnd = nbnd + 1
    }
    // ── FFT-NORMALIZATION FIX (the migration-gate magnitude bug, d6 — DERIVED) ────────
    //   _qpwfft_to_real uses ifft3 (÷Ntot convention), so psi_r = ψ_phys/Ntot and the
    //   ψ_n·Δψ_n product above carries a spurious 1/Ntot². The physical density response
    //   is Δρ(r)=Σ_n 2·ψ_n(r)·Δψ_n(r) with ψ(r)=Σ_G c(G)e^{iGr} (NO 1/Ntot). Restore it
    //   by ×Ntot² so BOTH downstream terms land at the correct coefficient magnitude:
    //     • Poisson  V_H(G)=4π Δρ̂(G)/|G|²   (via fft3(drho_r) → ÷Ntot at the gather)
    //     • local    f_xc·Δρ(r)              (added in real space at ⑥, same scale)
    //   Without this the screening correction is ~1/Ntot² ≈ 1e-9 of bare → 0 Anderson
    //   iters → screened==bare → λ stuck at 4.137 (the #2771/#2781 0-iter symptom).
    //   Factor is the DFT convention (not tuned): each ifft3-real ψ is ψ_phys/Ntot, and
    //   the product of two restores ×Ntot². Verified: f_xc & V_H terms both → O(1).
    let nt2 = to_float(ntot) * to_float(ntot)
    let mut rsc = 0
    while rsc < ntot { drho_r[rsc] = drho_r[rsc] * nt2 ; rsc = rsc + 1 }
    // ⑥ forward-FFT Δρ(r) → Δρ̂(G); apply Poisson V_H(G)=4π Δρ̂(G)/|G|² (G=0→0).
    let spec = fft3(drho_r, _qpwfft_zim(), PWFFT_NX, PWFFT_NY, PWFFT_NZ)
    if len(spec) != 2 * ntot { PWFFT_LAST_ERR = 5 ; return [] }
    let mut vh_re: [float] = [] ; let mut vh_im: [float] = []
    let mut ix = 0
    while ix < PWFFT_NX {
        let mut iy = 0
        while iy < PWFFT_NY {
            let mut iz = 0
            while iz < PWFFT_NZ {
                let h = _qpwfft_freq(ix, PWFFT_NX)
                let k = _qpwfft_freq(iy, PWFFT_NY)
                let l = _qpwfft_freq(iz, PWFFT_NZ)
                let gx = to_float(h) * PWFFT_B1[0] + to_float(k) * PWFFT_B2[0] + to_float(l) * PWFFT_B3[0]
                let gy = to_float(h) * PWFFT_B1[1] + to_float(k) * PWFFT_B2[1] + to_float(l) * PWFFT_B3[1]
                let gz = to_float(h) * PWFFT_B1[2] + to_float(k) * PWFFT_B2[2] + to_float(l) * PWFFT_B3[2]
                let g2 = gx * gx + gy * gy + gz * gz
                let lin = (ix * PWFFT_NY + iy) * PWFFT_NZ + iz
                if g2 < 1.0e-12 {
                    vh_re.push(0.0) ; vh_im.push(0.0)            // G=0 gauge
                } else {
                    let f = PWFFT_4PI / g2
                    vh_re.push(f * spec[lin * 2]) ; vh_im.push(f * spec[lin * 2 + 1])
                }
                iz = iz + 1
            }
            iy = iy + 1
        }
        ix = ix + 1
    }
    // inverse-FFT V_H(G) → V_H(r), then add the adiabatic-LDA xc kernel ΔV_xc(r).
    //   ── LOCAL-ALDA (the RPA+ALDA / Adler-Wiser local-field closure, d2/d6) ──
    //   ΔV_xc(r) = f_xc[ρ(r)]·Δρ(r) with f_xc evaluated at the LOCAL physical density
    //   ρ_phys(r) = ρ_weight(r)·Ntot/Ω (the |ψ|² FFT round-trip carries a 1/Ntot grid
    //   normalization; ×Ntot/Ω restores the physical density in bohr⁻³). f_x[ρ] (LDA-
    //   exchange, xc_mode≥1) + f_c[ρ] (PW92 correlation, xc_mode≥2). This REPLACES the
    //   single uniform-gas scalar PWFFT_FXC·Δρ — the QE-miss residual the gate isolated.
    //   ── FALLBACK (PWFFT_LOCAL off): the prior uniform-gas scalar f_xc[ρ̄] term. ──
    let vh_back = ifft3(vh_re, vh_im, PWFFT_NX, PWFFT_NY, PWFFT_NZ)
    if len(vh_back) != 2 * ntot { PWFFT_LAST_ERR = 6 ; return [] }
    let mut dvscr_r: [float] = []
    if PWFFT_LOCAL && PWFFT_OMEGA > 0.0 {
        let dens_scale = to_float(ntot) / PWFFT_OMEGA   // grid weight → physical ρ(r)
        p = 0
        while p < ntot {
            let rho_phys = rho_r[p] * dens_scale
            let mut fxc = 0.0
            if PWFFT_XCMODE >= 1 { fxc = fxc + qforge_fx_lda(rho_phys) }   // LDA exchange
            if PWFFT_XCMODE >= 2 { fxc = fxc + qforge_fc_pw92(rho_phys) }  // PW92 correlation
            dvscr_r.push(vh_back[p * 2] + fxc * drho_r[p])                 // f_xc[ρ(r)]·Δρ(r)
            p = p + 1
        }
        PWFFT_LOCAL_XC = PWFFT_LOCAL_XC + 1                                // d6 engage witness
    } else {
        p = 0
        while p < ntot { dvscr_r.push(vh_back[p * 2] + PWFFT_FXC * drho_r[p]) ; p = p + 1 }
    }
    // ⑦ forward-FFT ΔV_scr(r) → ΔV_scr(G); GATHER onto the PW coefficients.
    let vspec = fft3(dvscr_r, _qpwfft_zim(), PWFFT_NX, PWFFT_NY, PWFFT_NZ)
    if len(vspec) != 2 * ntot { PWFFT_LAST_ERR = 7 ; return [] }
    let inv_ntot = 1.0 / to_float(ntot)
    let mut out: [float] = []
    let mut i = 0
    while i < n {
        // ΔV_scr(G_i) = spectrum at the coefficient's grid line; fft3 is UNnormalized
        // forward (Σ, no 1/N), so the coefficient amplitude is the spectrum ÷ Ntot
        // (matching the scatter→ifft round-trip normalization). Real part is physical.
        out.push(vspec[PWFFT_LIN[i] * 2] * inv_ntot)
        i = i + 1
    }
    PWFFT_LAST_ERR = 0 ; PWFFT_FOLDS = PWFFT_FOLDS + 1   // genuine fold succeeded (d6 witness)
    return out
}

// ── signed FFT frequency index: 0..N/2 = +, N/2<..<N = (k−N) ─────────────────────
fn _qpwfft_freq(k: int, n: int) -> int {
    if k > n / 2 { return k - n }
    return k
}
