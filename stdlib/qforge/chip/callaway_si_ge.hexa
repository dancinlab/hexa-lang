// HEXA Standard Library — qforge/chip/callaway_si_ge
//
// QFORGE universal-engine · CHIP scale · round-4 (R4) brick — ABSOLUTE-κ DATA SWAP.
//   scale ladder (QFORGE.md §122):  chip = device 밴드·수송·열(TCAD).
//
// R10 (callaway_bte.hexa) closed the N/U-separated Callaway CROSSOVER STRUCTURE with
// MODEL coefficients; R11 (verify_adapter.hexa) gated the chip outputs and CORRECTLY
// flagged the absolute Si κ as 🟠 STRUCTURAL-ONLY — the generic coefficients over-predict
// κ_Si(300K) ~1.9× (≈280 vs measured 148 W/m·K).  That 🟠 is the named NEXUS-edge frontier:
// "the ABSOLUTE κ needs ab-initio B_U/B_iso from QFORGE-materials DFPT (data feed)".
//
// R4 CLOSES that 🟠 with a genuine DATA SWAP (d4) — NOT a back-fit (d6).  It supplies a
// CITED, physically-derived Callaway coefficient SET for real Si and Ge and computes the
// absolute κ(T), which the R4 selftest gates against the experimental κ(300K).
//
// ── THE TWO CITED COEFFICIENT SETS (every value sourced, none fitted to the target) ──
//
//   SILICON — Mingo single-mode EDIP-fit set (N. Mingo, Phys. Rev. B 68, 113308 (2003);
//   tabulated/popularised via the nanoHUB "Role of Normal Processes in Thermal
//   Conductivity of Silicon" tool).  Single-mode relaxation rates:
//       1/τ_N   = B_N ω² T³ ,            B_N   = 2.0e-24  s·K⁻³
//       1/τ_U   = B_U ω² T exp(−C/T),    B_U   = 1.73e-19 s·K⁻¹ ,  C = 137.39 K
//       1/τ_iso = A_iso ω⁴ ,             A_iso = 2.2e-45  s³        (0.22e-44)
//   acoustic Debye cutoff Θ_D = 645 K, group velocity v = 6400 m/s, bulk rod L = 7.16 mm.
//   CROSS-VALIDATION (d19, independent): the Slack–Morelli first-principles Grüneisen
//   Umklapp prefactor  B_U = ħγ²/(M̄ v² θ_a)  with γ=1.06, M̄=28.08 amu, v=6084 m/s,
//   θ_a=395 K  gives B_U = 1.74e-19 — agreeing with Mingo's fitted 1.73e-19 to <1%, and
//   C=θ_a/3≈132 K vs Mingo's 137 K (<4%).  Two unrelated sources → the same coefficient.
//
//   GERMANIUM — Slack–Morelli first-principles set (D. T. Morelli, J. P. Heremans, G. A.
//   Slack, Phys. Rev. B 66, 195304 (2002); Morelli & Slack, "High Lattice Thermal
//   Conductivity Solids", 2006, Table 2.2).  All from independent physical constants:
//       γ = 1.06 ,  M̄ = 72.59 amu ,  θ_a = 235 K ,  v = 3540 m/s ,  a = 5.658 Å (8 at/cell),
//       natural-Ge isotope mass-variance  Γ = 5.87e-4.  Closed forms:
//       B_U   = ħγ²/(M̄ v² θ_a)         = 3.34e-19  s·K⁻¹ ,  C = θ_a/3 = 78.33 K
//       A_iso = V₀ Γ /(4π v³)           = 2.38e-44  s³     (Tamura/Klemens point-defect)
//       B_N   = (B_N/B_U)_Si · B_U_Ge   = 3.86e-24  s·K⁻³  (N/U prefactor ratio carried
//                                          from the cited Si set — same group-IV phonon class)
//   acoustic Debye cutoff Θ_D = 374 K (Itoh et al., Ge isotope study), bulk L = 5.0 mm.
//
// ── HONEST RESULT (d6 — the genuine residual, no knob forced to the target) ──────────
//   Si κ(300K) = 146 W/m·K  vs experimental 148  → rel-ε ≈ 1.2 %   (Mingo cited set)
//   Ge κ(300K) =  68 W/m·K  vs experimental  60  → rel-ε ≈ 14  %   (Slack-Morelli set)
//   Both land within the ~10-20 % Callaway-is-a-MODEL band — the legitimate published
//   result.  The Callaway correction is LOAD-BEARING for Si: κ_RTA alone ≈ 89 (under-
//   predicts badly); the β-correction restores it to 146.  The κ(T) curve shape matches
//   the known Si/Ge trend (T³ rise → peak → 1/T fall): Si 588/245/146/101 W/m·K and Ge
//   253/114/68/47 W/m·K at 100/200/300/400 K (cf. Si lit. ~884/264/148/98).
//
//   refs: Mingo PRB 68,113308 (2003); Morelli-Heremans-Slack PRB 66,195304 (2002);
//         Morelli&Slack "High Lattice Thermal Conductivity Solids" (2006) Tab.2.2;
//         Glassbrenner & Slack PR 134,A1058 (1964) (Si/Ge κ measurements);
//         Itoh et al. (Ge isotope, Θ_D=374 K); Tamura PRB 27,858 (1983) (isotope ω⁴).
//
// ── d4 generic / d19 reuse contract ──────────────────────────────────────────────────
//   • this is a DATA brick: the coefficients are SUPPLIED (d4), the κ traverses ONE
//     generic Callaway path — adding a 3rd material (diamond, GaAs) is one more accessor,
//     no path edit.  R10 callaway_bte + R11 verify_adapter MODEL BYTES are UNTOUCHED.
//   • REUSES R8 τ primitives verbatim (d19): τ_iso (ω⁴), τ_bd (Casimir), Matthiessen.
//   • REUSES R10's Bose Debye kernel K(x)=x⁴e^x/(e^x−1)² and Simpson quadrature (d19).
//   • the ONLY new physics vs R10 is a GENERALISED Umklapp 1/τ_U=B_U ω²T exp(−C/T) that
//     accepts the cited INDEPENDENT exp constant C (R10's bte τ_U hardcodes C=Θ_D/3; the
//     cited Si C=137.39 ≠ Θ_D/3=215, so R4 must carry C as a free CITED input — d4).
//
//   pub fn qforge_chip_si_*  / qforge_chip_ge_*  — cited coefficient accessors
//   pub fn qforge_chip_callaway_kappa_cited(temp_k, ...11 cited params..., nq) -> float
//
// Run:  HEXA_LANG=. hexa run stdlib/qforge/chip/callaway_si_ge_selftest.hexa
use "stdlib/qforge/chip/callaway_bte"
use "stdlib/qforge/chip/bte_kappa"

fn _kb()   -> float { return 1.380649e-23 }
fn _hbar() -> float { return 6.62607015e-34 / (2.0 * 3.14159265358979323846) }
fn _pi()   -> float { return 3.14159265358979323846 }
fn _abs(x: float) -> float { if x < 0.0 { return -x } return x }

// ── GENERALISED Umklapp lifetime  1/τ_U = B_U ω² T exp(−C/T) (cited independent C) ────
//   R8/R10's qforge_chip_bte_tau_umklapp hardcodes the exp constant to Θ_D/3.  The CITED
//   single-mode sets carry an INDEPENDENT C (Si: 137.39 K ≠ 645/3) — so R4 supplies C as
//   a free d4 input.  Same Slack ω²T·exp form, just the cited exponent.
pub fn qforge_chip_callaway_tau_umklapp_cited(omega: float, temp_k: float,
                                              b_u: float, c_exp: float) -> float {
    let w = _abs(omega)
    let rate = b_u * w * w * temp_k * exp(-c_exp / temp_k)
    if rate <= 0.0 { return 1.0e300 }
    return 1.0 / rate
}

// ── resistive τ_R(x) with the CITED Umklapp C + R8 isotope/boundary (d19 reuse) ──────
fn _tau_resistive_cited(x: float, temp_k: float, vel: float, length: float, fgeom: float,
                        b_u: float, c_exp: float, a_iso: float) -> float {
    let omega = x * _kb() * temp_k / _hbar()
    let tu = qforge_chip_callaway_tau_umklapp_cited(omega, temp_k, b_u, c_exp)
    let ti = qforge_chip_bte_tau_isotope(omega, a_iso)                  // d19 R8 ω⁴
    let tb = qforge_chip_bte_tau_boundary(vel, length, fgeom)           // d19 R8 Casimir
    return qforge_chip_bte_matthiessen([tu, ti, tb])                    // d19 R8 Matthiessen
}

// Normal τ_N(x) — 1/τ_N = B_N ω^a T^b (R10's form, cited B_N/exponents).
fn _tau_normal_cited(x: float, temp_k: float, b_n: float, a_pow: float, b_pow: float) -> float {
    let omega = x * _kb() * temp_k / _hbar()
    return qforge_chip_callaway_tau_normal(omega, temp_k, b_n, a_pow, b_pow)   // d19 R10
}

// R10 Bose Debye kernel K(x)=x⁴e^x/(e^x−1)² (d19 — same function, x→0 → x²).
fn _kK(x: float) -> float {
    if x < 1.0e-9 { return x * x }
    let ex = exp(x)
    let d  = ex - 1.0
    return x * x * x * x * ex / (d * d)
}

// Debye prefactor (k_B/2π²v)(k_BT/ħ)³ (R10 identical).
fn _pref(temp_k: float, vel: float) -> float {
    let kb = _kb()
    let kbt_hbar = kb * temp_k / _hbar()
    return (kb / (2.0 * _pi() * _pi() * vel)) * kbt_hbar * kbt_hbar * kbt_hbar
}

// Composite Simpson ∫ f·K over the Debye range; mode 0=τ_c·K 1=(τ_c/τ_N)K 2=(τ_c/(τ_N τ_R))K.
fn _integral_cited(mode: int, temp_k: float, theta_d: float, vel: float, length: float,
                   fgeom: float, b_u: float, c_exp: float, a_iso: float,
                   b_n: float, a_pow: float, b_pow: float, nq: int) -> float {
    let lo = 1.0e-6
    let mut xd = theta_d / temp_k
    if xd <= lo { xd = lo + 1.0e-6 }
    let n = nq
    let h_step = (xd - lo) / (n + 0.0)
    let mut acc = 0.0
    let mut i = 0
    while i <= n {
        let x = lo + (i + 0.0) * h_step
        let tn = _tau_normal_cited(x, temp_k, b_n, a_pow, b_pow)
        let tr = _tau_resistive_cited(x, temp_k, vel, length, fgeom, b_u, c_exp, a_iso)
        let tc = qforge_chip_bte_matthiessen([tn, tr])
        let mut f = tc
        if mode == 1 { f = tc / tn }
        if mode == 2 { f = tc / (tn * tr) }
        let val = f * _kK(x)
        if i == 0 || i == n { acc = acc + val }
        else if (i / 2) * 2 == i { acc = acc + 2.0 * val }
        else { acc = acc + 4.0 * val }
        i = i + 1
    }
    return acc * h_step / 3.0
}

// ── (core) ABSOLUTE Callaway κ with a CITED coefficient set  κ = κ_RTA + κ_corr ──────
//   The full N/U-separated Callaway thermal conductivity driven by the SUPPLIED cited
//   coefficients (d4 — Si: Mingo PRB 68,113308 · Ge: Morelli-Slack PRB 66,195304).
//   Reuses R10's β-correction structure; the only difference vs R10's qforge_chip_callaway_kappa
//   is the GENERALISED Umklapp exp constant C (cited, independent of Θ_D).  Returns W·m⁻¹·K⁻¹.
pub fn qforge_chip_callaway_kappa_cited(temp_k: float, theta_d: float, vel: float,
                                        length: float, fgeom: float,
                                        b_u: float, c_exp: float, a_iso: float,
                                        b_n: float, a_pow: float, b_pow: float, nq: int) -> float {
    let pref = _pref(temp_k, vel)
    let i0 = _integral_cited(0, temp_k, theta_d, vel, length, fgeom, b_u, c_exp, a_iso, b_n, a_pow, b_pow, nq)
    let krta = pref * i0
    let i1 = _integral_cited(1, temp_k, theta_d, vel, length, fgeom, b_u, c_exp, a_iso, b_n, a_pow, b_pow, nq)
    let i2 = _integral_cited(2, temp_k, theta_d, vel, length, fgeom, b_u, c_exp, a_iso, b_n, a_pow, b_pow, nq)
    let mut kcorr = 0.0
    if i2 > 0.0 { kcorr = pref * (i1 * i1) / i2 }
    return krta + kcorr
}

// ── RTA-only κ with the cited set (the β-correction DROPPED) — to show it's load-bearing.
pub fn qforge_chip_callaway_kappa_cited_rta(temp_k: float, theta_d: float, vel: float,
                                            length: float, fgeom: float,
                                            b_u: float, c_exp: float, a_iso: float,
                                            b_n: float, a_pow: float, b_pow: float, nq: int) -> float {
    let pref = _pref(temp_k, vel)
    let i0 = _integral_cited(0, temp_k, theta_d, vel, length, fgeom, b_u, c_exp, a_iso, b_n, a_pow, b_pow, nq)
    return pref * i0
}

// ════════════════ CITED COEFFICIENT ACCESSORS (the d4 DATA, named per material) ══════
//   Each returns the material's Callaway parameter set as a flat [float]:
//     [ theta_d, vel, length, fgeom, b_u, c_exp, a_iso, b_n, a_pow, b_pow, kappa_exp_300 ]
//   so a caller drives qforge_chip_callaway_kappa_cited(...) with NO per-material branch.

// SILICON — Mingo PRB 68,113308 (2003) single-mode EDIP set (nanoHUB tabulation).
pub fn qforge_chip_si_callaway_params() -> [float] {
    return [645.0, 6400.0, 7.16e-3, 1.0, 1.73e-19, 137.39, 2.2e-45, 2.0e-24, 2.0, 3.0, 148.0]
}

// GERMANIUM — Slack-Morelli PRB 66,195304 (2002) first-principles set (γ/M/θ_a/v/Γ closed form).
pub fn qforge_chip_ge_callaway_params() -> [float] {
    return [374.0, 3540.0, 5.0e-3, 1.0, 3.338e-19, 78.333, 2.384e-44, 3.859e-24, 2.0, 3.0, 60.0]
}

// drive a material param vector → κ(T) (the d4-generic one-path call).
pub fn qforge_chip_callaway_kappa_of(p: [float], temp_k: float, nq: int) -> float {
    return qforge_chip_callaway_kappa_cited(temp_k, p[0], p[1], p[2], p[3],
                                            p[4], p[5], p[6], p[7], p[8], p[9], nq)
}
