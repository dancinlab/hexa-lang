// @ci_gate — deterministic · pure analytic anchors
//
// qforge_chip_callaway_bte_selftest.hexa — QFORGE CHIP round-10 g5 gate.
//
// callaway_bte.hexa refines the ballistic↔diffusive crossover of the chip THERMAL leg
// with the CALLAWAY model (Phys Rev 113, 1046 (1959)): it SEPARATES Normal (N,
// momentum-conserving) from resistive (R = Umklapp+isotope+boundary) phonon scattering
// and adds a β-correction restoring the crystal momentum N-processes REDISTRIBUTE (not
// destroy).  In the Debye-integral form  κ = κ_RTA + κ_corr,  K(x)=x⁴e^x/(e^x−1)²,
//   κ_RTA  = pref ∫ τ_c K dx,    1/τ_c = 1/τ_N + 1/τ_R,
//   κ_corr = pref [∫(τ_c/τ_N)K]² / [∫(τ_c/(τ_N τ_R))K],   pref=(k_B/2π²v)(k_BT/ħ)³.
//
// Every anchor below is an EXACT analytic identity or a closed-form limit (d6 — none tuned):
//
//   (a) RTA-LIMIT RECOVERY — as τ_N→∞ (Normal negligible): τ_c→τ_R and ∫(τ_c/τ_N)K→0 so
//       κ_corr→0, hence κ_Callaway → κ_RTA(τ_R) EXACTLY (the round-8 RTA Debye κ).         🔵
//   (b) BALLISTIC CEILING — pure-N / clean low-T with a Casimir boundary floor: κ stays
//       BOUNDED by the boundary-limited ballistic ceiling κ_ball=pref·τ_bd·∫K, NOT
//       divergent.  The β-correction is what tames the spurious pure-RTA κ→∞.            🔵
//   (c) CROSSOVER T-SCALING — low-T κ ∝ T³ (Debye, boundary/N-limited) → peak → high-T
//       κ ∝ 1/T (Umklapp).  Verified at two T extremes; β-correction is LOAD-BEARING
//       (dropping κ_corr changes the low-T behaviour).                                    🔵
//   (d) REGRESSION — round-4 (ballistic g₀) + round-8 (RTA-BTE) selftests still PASS;
//       the shared phonon_kappa/bte_kappa primitives are unchanged where Callaway reuses
//       them (τ_U/τ_iso/τ_bd/Matthiessen identical; verified by recomputing here).        🔵
//
// HONEST SCOPE (d6): τ_N/τ_U use the STANDARD Callaway power-laws with MODEL coefficients
// (1/τ_N=B_N ω^a T^b · 1/τ_U=B_U ω²T e^{−Θ/αT}) — d4 inputs, NOT ab-initio el-ph (the
// QE/QFORGE-materials DFPT lane).  The deliverable is the correct N/U-separated crossover
// STRUCTURE with the right RTA-recovery / ceiling / T³–1/T limits; a fitted Si/Ge κ(T) is a
// published-coefficient data swap (d4), NOT claimed here.
//
// Run:  HEXA_LANG=. hexa run stdlib/qforge/chip/callaway_bte_selftest.hexa
// PASS: "qforge_chip_callaway_bte_selftest PASS".
use "stdlib/qforge/chip/callaway_bte"
use "stdlib/qforge/chip/bte_kappa"
use "stdlib/qforge/chip/phonon_kappa"

fn _abs(x: float) -> float { if x < 0.0 { return -x } return x }
fn _kb()   -> float { return 1.380649e-23 }
fn _hbar() -> float { return 6.62607015e-34 / (2.0 * 3.14159265358979323846) }
fn _pi()   -> float { return 3.14159265358979323846 }

fn _ck_rel(name: str, got: float, want: float, rel: float) -> int {
    let denom = _abs(want)
    let tol = rel * denom
    if _abs(got - want) <= tol { println("PASS " + name + " (" + to_string(got) + ")") ; return 0 }
    println("FAIL " + name + " — got " + to_string(got) + " want " + to_string(want)) ; return 1
}
fn _ck_true(name: str, cond: bool) -> int {
    if cond { println("PASS " + name) ; return 0 }
    println("FAIL " + name) ; return 1
}

// Independent reference: RTA Debye κ = pref ∫ τ_R K(x) dx (NO Normal, NO correction).
//   This is the round-8 RTA-BTE κ recast into the Debye-integral form — the target that
//   the Callaway κ must reproduce when τ_N→∞.  Built here from round-8 τ primitives (d19).
fn _ref_rta_debye(temp_k: float, theta_d: float, vel: float, length: float, fgeom: float,
                  a_u: float, b_iso: float, nq: int) -> float {
    let kb = _kb()
    let hbar = _hbar()
    let pi = _pi()
    let kbt_hbar = kb * temp_k / hbar
    let pref = (kb / (2.0 * pi * pi * vel)) * kbt_hbar * kbt_hbar * kbt_hbar
    let lo = 1.0e-6
    let mut xd = theta_d / temp_k
    if xd <= lo { xd = lo + 1.0e-6 }
    let n = nq
    let h_step = (xd - lo) / (n + 0.0)
    let mut acc = 0.0
    let mut i = 0
    while i <= n {
        let x = lo + (i + 0.0) * h_step
        let omega = x * kb * temp_k / hbar
        let tu = qforge_chip_bte_tau_umklapp(omega, temp_k, theta_d, a_u)   // d19
        let ti = qforge_chip_bte_tau_isotope(omega, b_iso)                  // d19
        let tb = qforge_chip_bte_tau_boundary(vel, length, fgeom)          // d19
        let tr = qforge_chip_bte_matthiessen([tu, ti, tb])                 // d19
        let ex = exp(x)
        let d = ex - 1.0
        let mut kK = x * x
        if x >= 1.0e-9 { kK = x * x * x * x * ex / (d * d) }
        let val = tr * kK
        if i == 0 || i == n { acc = acc + val }
        else if (i / 2) * 2 == i { acc = acc + 2.0 * val }
        else { acc = acc + 4.0 * val }
        i = i + 1
    }
    return pref * acc * h_step / 3.0
}

fn main() {
    let mut fails = 0

    // shared device / material parameters (analytic — d4 inputs, none material-hardcoded)
    let vs      = 5000.0          // acoustic group velocity v_s (m/s) — Si-scale
    let len     = 1.0e-6         // device width L = 1 µm
    let fgeom   = 1.0            // diffuse-boundary Casimir factor
    let theta_d = 645.0          // Debye temperature (K) — Si-scale
    let a_u     = 1.0e-19        // Umklapp prefactor (s·K⁻¹, d4 input)
    let b_iso   = 1.0e-45        // isotope prefactor (s³, d4 input)
    let b_n     = 1.0e-13        // Normal prefactor (d4 input)
    let a_pow   = 2.0            // Normal ω-exponent (a=2)
    let b_pow   = 3.0            // Normal T-exponent (b=3)  (1/τ_N = B_N ω²T³)
    let nq      = 2000           // Simpson resolution (even)

    // ══ (a) RTA-LIMIT RECOVERY — τ_N→∞ ⇒ κ_Callaway → κ_RTA(τ_R), κ_corr → 0 ════════
    // Make Normal scattering negligible (B_N→0 ⇒ 1/τ_N→0 ⇒ τ_N→∞).  Then τ_c→τ_R and the
    // β-correction numerator ∫(τ_c/τ_N)K→0, so κ_Callaway collapses onto the round-8 RTA
    // Debye κ EXACTLY.  Anchor on the independent _ref_rta_debye (round-8 τ primitives).
    let bn_tiny = 1.0e-40        // 1/τ_N = B_N ω²T³ → ~0 (τ_N → ~1e300)
    let k_call_noN = qforge_chip_callaway_kappa(300.0, theta_d, vs, len, fgeom,
                                                a_u, b_iso, bn_tiny, a_pow, b_pow, nq)
    let k_corr_noN = qforge_chip_callaway_kappa_corr(300.0, theta_d, vs, len, fgeom,
                                                     a_u, b_iso, bn_tiny, a_pow, b_pow, nq)
    let k_rta_ref  = _ref_rta_debye(300.0, theta_d, vs, len, fgeom, a_u, b_iso, nq)
    fails = fails + _ck_rel("(a) τ_N→∞: κ_Callaway → κ_RTA(τ_R) exact [round-8 baseline]",
                            k_call_noN, k_rta_ref, 1.0e-6)
    fails = fails + _ck_true("(a) τ_N→∞: β-correction κ_corr → 0 (vanishes vs κ_RTA scale)",
                             _abs(k_corr_noN) <= 1.0e-6 * _abs(k_rta_ref))
    // and the Callaway κ_RTA part alone EQUALS the round-8 RTA Debye κ (combined τ_c→τ_R).
    let k_call_rta_part = qforge_chip_callaway_kappa_rta(300.0, theta_d, vs, len, fgeom,
                                                         a_u, b_iso, bn_tiny, a_pow, b_pow, nq)
    fails = fails + _ck_rel("(a) κ_RTA part == round-8 RTA Debye κ (τ_c→τ_R reduction)",
                            k_call_rta_part, k_rta_ref, 1.0e-6)

    // ══ (b) BALLISTIC CEILING — pure-N / clean low-T stays bounded, NOT divergent ════
    // Turn OFF intrinsic resistive (Umklapp a_u→0, isotope b_iso→0) so the ONLY resistive
    // channel is the Casimir boundary (τ_R=τ_bd).  N-processes dominate.  The Callaway κ
    // must stay BOUNDED by the boundary-limited ballistic ceiling κ_ball=pref·τ_bd·∫K.
    let t_lo   = 15.0           // low-T (clean / N-dominated regime)
    let b_n_strong = 1.0e-11    // strong Normal scattering (N dominates over boundary)
    let k_call_pureN = qforge_chip_callaway_kappa(t_lo, theta_d, vs, len, fgeom,
                                                  0.0, 0.0, b_n_strong, a_pow, b_pow, nq)
    let k_ceiling    = qforge_chip_callaway_ballistic_ceiling(t_lo, theta_d, vs, len, fgeom, nq)
    fails = fails + _ck_true("(b) low-T pure-N κ_Callaway BOUNDED by boundary ballistic ceiling",
                             k_call_pureN <= k_ceiling * 1.000001 && k_call_pureN > 0.0)
    // and the κ is FINITE (not the spurious pure-RTA divergence): report the ratio to ceiling.
    let ratio_ceiling = k_call_pureN / k_ceiling
    fails = fails + _ck_true("(b) κ_Callaway/κ_ceiling ∈ (0,1] (finite, no κ→∞)",
                             ratio_ceiling > 0.0 && ratio_ceiling <= 1.000001)
    println("    [b] low-T(15K) pure-N κ_Callaway=" + to_string(k_call_pureN)
            + "  ceiling κ_ball=" + to_string(k_ceiling)
            + "  ratio=" + to_string(ratio_ceiling) + " (=1: N is flux-NEUTRAL, β-corr restores boundary κ)")
    // The ratio=1 is the SIGNATURE Callaway result: pure-N processes do NOT relax heat flux,
    // so with only boundary+N the κ equals the boundary-limited ceiling EXACTLY regardless of
    // N strength — the β-correction restores precisely the momentum RTA would spuriously remove.
    // The NON-TRIVIAL bound: add intrinsic Umklapp and κ drops STRICTLY below the ceiling.
    let k_with_U = qforge_chip_callaway_kappa(t_lo, theta_d, vs, len, fgeom,
                                              a_u, b_iso, b_n_strong, a_pow, b_pow, nq)
    fails = fails + _ck_true("(b) +Umklapp: κ_Callaway STRICTLY below ceiling (non-trivial bound)",
                             k_with_U < k_ceiling && k_with_U > 0.0)
    // ANCHOR vs round-4 Landauer N·g₀: the boundary-limited Debye ceiling is the diffusive
    // bridge to the round-4 ballistic floor.  Report the round-4 N·g₀ (per-channel) for the
    // record — both are ballistic upper-bound anchors of the SAME thermal leg (d19).
    let ng0_r4 = qforge_chip_phonon_kappa_quantum_floor(1.0, t_lo)       // d19 round-4 N·g₀
    println("    [b] round-4 ballistic N·g₀(1ch,15K)=" + to_string(ng0_r4) + " W/K (Landauer floor anchor)")

    // ══ (c) CROSSOVER T-SCALING — low-T κ∝T³ · high-T κ∝1/T · β-correction load-bearing ═
    // (c1) HIGH-T Umklapp κ∝1/T: at T≫Θ_D, 1/τ_U∝ω²T (exp factor saturates) so τ_R∝1/T and
    //   κ∝1/T (Peierls).  Verify κ(2T)/κ(T)→1/2 at T≫Θ_D (resistive Umklapp-dominated).
    let t_hi = 6000.0          // ≫ Θ_D=645
    let k_hi_t  = qforge_chip_callaway_kappa(t_hi, theta_d, vs, len, fgeom,
                                             a_u, b_iso, b_n, a_pow, b_pow, nq)
    let k_hi_2t = qforge_chip_callaway_kappa(2.0 * t_hi, theta_d, vs, len, fgeom,
                                             a_u, b_iso, b_n, a_pow, b_pow, nq)
    fails = fails + _ck_rel("(c) high-T κ(2T)/κ(T) → 1/2 (Umklapp κ∝1/T, Peierls)",
                            k_hi_2t / k_hi_t, 0.5, 5.0e-2)
    println("    [c] high-T κ(" + to_string(t_hi) + "K)=" + to_string(k_hi_t)
            + "  κ(2T)=" + to_string(k_hi_2t) + "  ratio=" + to_string(k_hi_2t / k_hi_t) + " (→1/2)")
    // (c2) LOW-T κ∝T³ Debye regime: below the Debye T the integral ∫K saturates (xD=Θ/T→∞)
    //   and τ→τ_bd (boundary-limited, T-independent), so κ → pref·τ_bd·∫K ∝ T³ (pref∝T³).
    //   Verify κ(2T)/κ(T)→8 (=2³) in the boundary-plateau low-T regime (intrinsic OFF).
    let t_c1 = 4.0
    let t_c2 = 8.0
    let k_c1 = qforge_chip_callaway_kappa(t_c1, theta_d, vs, len, fgeom,
                                          0.0, 0.0, 0.0, a_pow, b_pow, nq)   // boundary-only
    let k_c2 = qforge_chip_callaway_kappa(t_c2, theta_d, vs, len, fgeom,
                                          0.0, 0.0, 0.0, a_pow, b_pow, nq)
    fails = fails + _ck_rel("(c) low-T κ(2T)/κ(T) → 8 (=2³, Debye boundary plateau κ∝T³)",
                            k_c2 / k_c1, 8.0, 3.0e-2)
    println("    [c] low-T κ(" + to_string(t_c1) + "K)=" + to_string(k_c1)
            + "  κ(" + to_string(t_c2) + "K)=" + to_string(k_c2)
            + "  ratio=" + to_string(k_c2 / k_c1) + " (→8=2³)")
    // (c3) β-correction is LOAD-BEARING: with strong N + a boundary floor, dropping κ_corr
    //   (RTA-only) gives a STRICTLY SMALLER κ than the full Callaway κ — RTA under-estimates
    //   κ in the N-dominated regime (the whole point of Callaway).  κ_corr > 0, load-bearing.
    let k_full = qforge_chip_callaway_kappa(t_lo, theta_d, vs, len, fgeom,
                                            a_u, b_iso, b_n_strong, a_pow, b_pow, nq)
    let k_rta_only = qforge_chip_callaway_kappa_rta(t_lo, theta_d, vs, len, fgeom,
                                                    a_u, b_iso, b_n_strong, a_pow, b_pow, nq)
    let k_corr_part = qforge_chip_callaway_kappa_corr(t_lo, theta_d, vs, len, fgeom,
                                                      a_u, b_iso, b_n_strong, a_pow, b_pow, nq)
    fails = fails + _ck_true("(c) β-correction LOAD-BEARING: κ_full > κ_RTA-only (N-dominated)",
                             k_full > k_rta_only && k_corr_part > 0.0)
    println("    [c] N-dominated κ_full=" + to_string(k_full)
            + "  κ_RTA-only=" + to_string(k_rta_only)
            + "  κ_corr=" + to_string(k_corr_part) + " (>0, load-bearing)")

    // ══ (d) REGRESSION — round-8 τ primitives unchanged where Callaway reuses them ════
    // Callaway REUSES round-8 τ_U/τ_iso/τ_bd/Matthiessen verbatim (d19).  Recompute the
    // round-8 anchors here to prove the shared primitives are unchanged by this round.
    let kb = _kb()
    let hbar = _hbar()
    let omega = (kb * 100.0) / hbar
    // τ_bd Casimir (round-8 identity)
    let tau_bd = qforge_chip_bte_tau_boundary(vs, len, fgeom)
    fails = fails + _ck_rel("(d) round-8 τ_bd=F·L/v unchanged", tau_bd, (fgeom * len) / vs, 1.0e-12)
    // isotope ω⁴ (round-8 identity)
    let r_w  = 1.0 / qforge_chip_bte_tau_isotope(omega, b_iso)
    let r_2w = 1.0 / qforge_chip_bte_tau_isotope(2.0 * omega, b_iso)
    fails = fails + _ck_rel("(d) round-8 isotope ω⁴ ratio(2ω/ω)=16 unchanged", r_2w / r_w, 16.0, 1.0e-9)
    // Umklapp ω² (round-8 identity)
    let ru_w  = 1.0 / qforge_chip_bte_tau_umklapp(omega, 100.0, theta_d, a_u)
    let ru_2w = 1.0 / qforge_chip_bte_tau_umklapp(2.0 * omega, 100.0, theta_d, a_u)
    fails = fails + _ck_rel("(d) round-8 Umklapp ω² ratio(2ω/ω)=4 unchanged", ru_2w / ru_w, 4.0, 1.0e-9)
    // Matthiessen rate-sum (round-8 identity)
    let tau_iso = qforge_chip_bte_tau_isotope(omega, b_iso)
    let tau_u   = qforge_chip_bte_tau_umklapp(omega, 100.0, theta_d, a_u)
    let tau_m   = qforge_chip_bte_matthiessen([tau_u, tau_iso, tau_bd])
    let rate_sum = 1.0 / tau_u + 1.0 / tau_iso + 1.0 / tau_bd
    fails = fails + _ck_rel("(d) round-8 Matthiessen 1/τ=Σ1/τ_i unchanged", 1.0 / tau_m, rate_sum, 1.0e-9)
    // round-4 ballistic g₀ (round-4 identity) — κ(1ch,1K)=9.46431e-13 W/K
    let g0_anchor = qforge_chip_phonon_kappa_quantum_floor(1.0, 1.0)
    fails = fails + _ck_rel("(d) round-4 g₀(1ch,1K)=9.46431e-13 W/K unchanged", g0_anchor, 9.464311e-13, 1.0e-5)

    if fails == 0 { println("qforge_chip_callaway_bte_selftest PASS") }
    else { println("qforge_chip_callaway_bte_selftest FAIL (" + to_string(fails) + ")") }
}
