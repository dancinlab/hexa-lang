// HEXA Standard Library — qforge/chip/band_scf_gfull
//
// QFORGE universal-engine · CHIP scale · round-7 brick.
//   scale ladder (QFORGE.md §122):  chip = device 밴드·수송·열(TCAD).
//   round-1 (band_transport.hexa)  analytic SPINE (ε(k), diatomic GAP, Landauer, g₀).
//   round-2 (band_kmesh.hexa)      k-MESH band + 1D van-Hove DOS + mode-count NEGF.
//   round-3 (band_scf.hexa)        H(k)=T(k)+V wired to the plane-wave SCF structure;
//                                  V supplied as an ANALYTIC Fourier `vshell` map.
//   round-4 (phonon_kappa.hexa)    thermal leg (ballistic N·g₀ floor).
//   round-5 (negf_scatter.hexa)    coherent Σ-NEGF  T(E)=Tr[Γ_L Gʳ Γ_R Gᵃ].
//   round-6 (band_scf_real.hexa)   REAL SCF V_scr(G=0)=V_xc(ρ̄_sc) → vshell[0]
//                                  self-consistent; vshell[1+] (G≠0 Bragg shells) STILL
//                                  a FIXED analytic `vbragg`. ← the round-6 honest gap.
//
// Round-7 CLOSES round-6's last fixed leg: the OFF-DIAGONAL Bragg shells V_scr(G≠0).
// Round-6 honestly labelled vshell[1+] as a caller-supplied analytic `vbragg` because the
// assembler only carries the G=0 (spatial-average) screening on the diagonal it accepts —
// the G≠0 Fourier components of the screened lattice potential need the dense FFT-grid
// G-space screening. THIS brick builds exactly that:
//
//   ρ_sc(r) ─fft3→ ρ(G) ─Poisson 4π/|G|²→ V_H(G); V_xc[ρ](r) ─fft3→ V_xc(G)
//             V_scr(G) = V_H(G) + V_xc(G)   (FULL G-space, every shell, NOT just G=0)
//             H(k)_{G,G'} = ½|k+G|²·δ_{GG'} + V_scr(G−G')   (full Fourier matrix)
//             ─eigh→ ε_n(k)   ← now self-consistent on EVERY reciprocal shell.
//
// The G=0 component recovers round-6's V_scr(G=0)=V_xc(ρ̄) EXACTLY (continuity); the
// G≠0 components are NO LONGER a fixed `vbragg` — they are the real Fourier transform of
// the self-consistent screening V_scr[ρ_sc](r). When ρ has spatial structure, V_scr(G≠0)
// is nonzero and OPENS a Bragg gap that is SELF-CONSISTENT (a functional of ρ_sc), not an
// assumed analytic amplitude. When ρ is uniform (the round-6 jellium cell), V_scr(G≠0)→0
// and round-7 reduces to round-6 verbatim — the continuity leg.
//
// ── d19 reuse contract ────────────────────────────────────────────────────────────
//   • V_H[ρ](G) Poisson 4π/|G|²  : qforge_vhartree_from_rho (screening.hexa) — the SAME
//       G-space Poisson core the SCF in-loop Hartree uses. NO FFT/Poisson re-impl.
//   • the forward FFT ρ(r)→ρ(G), V_scr(r)→V_scr(G) : fft3_real (signal/core_fft.hexa,
//       brick 1/5 #2076) — the SAME 3D FFT screening.hexa / dfpt_response.hexa use.
//   • V_xc[ρ] pointwise           : qforge_vxc_point (scf_pw.hexa) = qforge_vx_lda +
//       qforge_vc_pw92 (screening.hexa / correlation.hexa). NO re-derived LDA.
//   • H(k)=T(k)+V eig            : qforge_chip_scf_band_eps (band_scf.hexa, R3) — it
//       already consumes an ARBITRARY-length `vshell` (`vshell[|i−j|]`), so the full
//       self-consistent shells drop in UNCHANGED (a data swap, d4). NO new eig path.
//
// ── d4 generic ─────────────────────────────────────────────────────────────────────
//   The cell (ρ grid · reciprocal basis · xc_mode · lattice a) is DATA. A uniform jellium
//   ρ, a sinusoidally-modulated ρ, or a real converged SCF ρ all traverse ONE path. No
//   material name hardcoded; no per-case branch.
//
// ── Honest scope (d6 / @L5) ──────────────────────────────────────────────────────────
//   • SELF-CONSISTENT on G≠0: V_scr(G) for EVERY G is the FFT of V_scr[ρ](r) where ρ is
//     the converged density — the off-diagonal shells are a FUNCTIONAL of ρ, not a fixed
//     input. This is the genuine round-7 advance over round-6's fixed `vbragg`.
//   • The screening representation here is the real-space-grid V_scr[ρ](r) FFT'd to G —
//     it carries the FULL G-space lattice structure (every reciprocal shell the grid
//     resolves), in contrast to round-6's diagonal-only G=0 term. The 1D-chip mapping
//     samples the converged ρ on a pow2 line of length a (one cell), b1=2π/a, so the FFT
//     frequency index m lands on the chip band's G_m=(2π/a)·m EXACTLY.
//   • If the supplied ρ is NOT a converged SCF fixed point, the caller is told (the
//     residual fn qforge_chip_gfull_sc_residual reports ‖V_scr[ρ]−V_scr_prev‖ — a true
//     self-consistency check, not papered over).
//
//   pub fn qforge_chip_vscr_rgrid_1d(rho,n,b1,xc_mode)            -> [float]  // V_scr(r) line
//   pub fn qforge_chip_vscr_gshells_1d(rho,n,b1,xc_mode,nshell)   -> [float]  // V_scr(G_m) shells
//   pub fn qforge_chip_gfull_vshell(rho,n,b1,xc_mode,nshell)      -> [float]  // full self-consistent vshell
//   pub fn qforge_chip_scf_gfull_band_eps(a,mmax,k,rho,n,xc_mode) -> [float]  // ε_n(k) ascending
//   pub fn qforge_chip_scf_gfull_band_min(a,mmax,k,rho,n,xc_mode) -> float    // lowest ε(k)
//   pub fn qforge_chip_scf_gfull_gap(a,mmax,rho,n,xc_mode)        -> float    // self-consistent Bragg gap
//   pub fn qforge_chip_gfull_sc_residual(rho,rho_prev,n,b1,xc_mode,nshell) -> float // SC residual
//
// Run:  HEXA_LANG=. hexa run stdlib/qforge/chip/band_scf_gfull_selftest.hexa
use "stdlib/qforge/chip/band_scf"            // R3 H(k)=T(k)+V eig path (full vshell consumer)
use "stdlib/qforge/scf_pw"                   // qforge_vxc_point (LDA V_xc point, d19)
use "stdlib/qforge/screening"                // qforge_vhartree_from_rho (G-space Poisson, d19)
use "stdlib/signal/core_fft"                 // fft3_real forward 3D FFT (d19, #2076)

fn _pi_r7() -> float { return 3.14159265358979323846 }
fn _abs_r7(x: float) -> float { if x < 0.0 { return -x } return x }

// ══ (1) V_scr(r) on a 1D pow2 line from a converged ρ(r) ═══════════════════════════
// Build the full real-space screening potential V_scr(r) = V_H[ρ](r) + V_xc[ρ](r) on a
// 1D line of n grid points (n MUST be a power of two — fft3 constraint) representing one
// crystal cell of length a (so b1 = 2π/a is the first reciprocal vector |g|).
//   • V_H[ρ]: the G-space Poisson 4π/|G|² (G=0→0, neutral gauge) — qforge_vhartree_from_rho
//     reused VERBATIM (d19), the SAME Hartree the SCF in-loop screening uses. For a 1D line
//     the grid is (n,1,1) and the reciprocal basis is (b1,0,0)·(0,large,0)·(0,0,large) so
//     only the x-axis G's are physical (the y,z reciprocal vectors are huge → those G²≫0 →
//     their Hartree contribution is negligible, and ρ is constant along y,z so ρ(G_y≠0)=0).
//   • V_xc[ρ]: pointwise qforge_vxc_point (LDA, d19) — V_x(ρ(r)) (+V_c for xc_mode≥1).
// Returns the length-n real V_scr(r). xc_mode<0 → free-electron (no screening) → all 0.
// d4: ρ is data (uniform / modulated / converged-SCF) — one path, no branch.
pub fn qforge_chip_vscr_rgrid_1d(rho: [float], n: int, b1: float, xc_mode: int) -> [float] {
    let mut out: [float] = []
    if n <= 0 { return out }
    if len(rho) != n { return out }
    if xc_mode < 0 {
        let mut z = 0
        while z < n { out.push(0.0) ; z = z + 1 }
        return out
    }
    // V_H[ρ](r) via the G-space Poisson on a (n,1,1) line. The transverse reciprocal
    // vectors are pinned LARGE so off-axis G's carry no spurious Hartree (ρ is uniform
    // transverse → ρ(G_⊥≠0)=0 anyway; this keeps the |G|² physical along x).
    let bx = [b1, 0.0, 0.0]
    let big = 1.0e6
    let by = [0.0, big, 0.0]
    let bz = [0.0, 0.0, big]
    let vh = qforge_vhartree_from_rho(rho, n, 1, 1, bx, by, bz)
    let have_vh = len(vh) == n
    let mut i = 0
    while i < n {
        let mut v = qforge_vxc_point(rho[i], xc_mode)         // V_xc[ρ](r) (LDA, d19)
        if have_vh { v = v + vh[i] }                          // + V_H[ρ](r) (Poisson, d19)
        out.push(v)
        i = i + 1
    }
    return out
}

// ══ (2) V_scr(G_m) Fourier shells from a converged ρ — the FULL G-space screening ═══
// FFT the real-space V_scr(r) to V_scr(G) and read off the 1D reciprocal shells
// V_scr(G_m), m = 0 … nshell−1, where G_m = (2π/a)·m = m·b1 (one cell on the line).
// The chip band H(k)_{G_i,G_j} = V_scr(G_i−G_j) needs exactly these shell amplitudes
// indexed by |Δm| (R3's `vshell[|i−j|]`). For a REAL physical potential V_scr(G_m) is
// real (the line ρ is real & the cell is inversion-related), so we return the real part
// (the |imag| is asserted ≪ tol by the caller's selftest).
//
// Normalisation: fft3_real returns the UNnormalised DFT  V(G_m)=Σ_r V(r)·e^{−i2π m r/n}.
// The plane-wave Fourier amplitude that enters H is the cell average per component,
// V_scr(G_m) = (1/n)·Σ_r V(r)·e^{−i…} — so we divide the spectrum by n. The m=0 bin is
// then (1/n)Σ V(r) = ⟨V_scr⟩ = V_scr(G=0) (continuity with round-6's V_xc(ρ̄)).
// Returns [V(G_0), V(G_1), …, V(G_{nshell−1})] (real parts). Malformed → [].
pub fn qforge_chip_vscr_gshells_1d(rho: [float], n: int, b1: float,
                                   xc_mode: int, nshell: int) -> [float] {
    let mut out: [float] = []
    if n <= 0 { return out }
    if nshell <= 0 { return out }
    let vscr_r = qforge_chip_vscr_rgrid_1d(rho, n, b1, xc_mode)
    if len(vscr_r) != n { return out }
    // forward FFT on the (n,1,1) line → interleaved [re,im,…] (2n).
    let spec = fft3_real(vscr_r, n, 1, 1)
    if len(spec) != 2 * n { return out }
    let inv_n = 1.0 / to_float(n)
    let mut m = 0
    while m < nshell {
        // shell m maps to FFT bin m (m < n/2 → +G_m). For m ≥ n the shell is unresolved
        // by this grid → 0 (the finite grid cannot represent that high a Fourier shell).
        if m < n {
            let re = spec[m * 2] * inv_n                       // real Fourier amplitude
            out.push(re)
        } else {
            out.push(0.0)
        }
        m = m + 1
    }
    return out
}

// ══ (3) the FULL self-consistent vshell (G=0 + all G≠0 shells) ═════════════════════
// Round-6 built vshell = [V_scr(G=0), vbragg] with vbragg a FIXED analytic input. Round-7
// builds vshell = [V_scr(G_0), V_scr(G_1), …, V_scr(G_{nshell−1})] where EVERY entry —
// including the off-diagonal G≠0 shells — is the FFT of the self-consistent V_scr[ρ](r).
// This is the data the R3 H(k) eig consumes UNCHANGED (d4 data-swap). nshell typically =
// mmax+1 (the chip band needs shells up to |Δm|=2·mmax, but the dominant gap-opening
// shells are the low ones; the caller picks nshell to cover the basis).
pub fn qforge_chip_gfull_vshell(rho: [float], n: int, b1: float,
                                xc_mode: int, nshell: int) -> [float] {
    return qforge_chip_vscr_gshells_1d(rho, n, b1, xc_mode, nshell)
}

// ══ (4) self-consistent ε_n(k) = eig[ T(k) + V_scr ] with the FULL G-space screening ═
// Build the full self-consistent vshell from the converged ρ and drop it into R3's
// qforge_chip_scf_band_eps — the EXACT same H(k)=T(k)+V eig path, now with EVERY
// reciprocal shell (G=0 AND G≠0) supplied self-consistently from ρ. Returns ε_n(k)
// ascending. nshell is fixed to cover the basis (2·mmax+1 G-differences → mmax+1 shells
// span |Δm|=0…mmax; the brick uses nshell = n so every resolvable shell is carried).
// b1 = 2π/a so the FFT frequency lands on the chip G-set. d4/d19: data-swap + reused eig.
pub fn qforge_chip_scf_gfull_band_eps(a: float, mmax: int, k: float,
                                      rho: [float], n: int, xc_mode: int) -> [float] {
    if a <= 0.0 { return [] }   // lattice length a≤0 → 2π/a Inf
    let b1 = 2.0 * _pi_r7() / a
    let nshell = 2 * mmax + 1                                  // |Δm| up to 2·mmax needs this many
    let vshell = qforge_chip_gfull_vshell(rho, n, b1, xc_mode, nshell)
    if len(vshell) == 0 { return [] }
    return qforge_chip_scf_band_eps(a, mmax, k, vshell)
}

// lowest band ε₀(k) with the full self-consistent G-space screening folded in.
pub fn qforge_chip_scf_gfull_band_min(a: float, mmax: int, k: float,
                                      rho: [float], n: int, xc_mode: int) -> float {
    let eps = qforge_chip_scf_gfull_band_eps(a, mmax, k, rho, n, xc_mode)
    if len(eps) == 0 { return 0.0 }
    let mut lo = eps[0]
    let mut i = 1
    let ne = len(eps)
    while i < ne {
        let e = eps[i]
        if e < lo { lo = e }
        i = i + 1
    }
    return lo
}

// ══ (5) the SELF-CONSISTENT Bragg gap at the zone boundary k=π/a ════════════════════
// The gap at the first Bragg plane, NOW formed by the real self-consistent V_scr(G=±g)
// (= vshell[1] from the FFT of V_scr[ρ]), not a fixed vbragg. For a UNIFORM ρ this gap
// is 0 (V_scr(G≠0)=0 → metal); for a STRUCTURED ρ the self-consistent first shell opens
// gap = ε₁−ε₀ at k=π/a. The metal↔insulator lever, now driven by ρ_sc — not assumed.
pub fn qforge_chip_scf_gfull_gap(a: float, mmax: int,
                                 rho: [float], n: int, xc_mode: int) -> float {
    if a <= 0.0 { return 0.0 }   // lattice length a≤0 → π/a Inf
    let kbz = _pi_r7() / a
    let eps = qforge_chip_scf_gfull_band_eps(a, mmax, kbz, rho, n, xc_mode)
    if len(eps) < 2 { return 0.0 }
    let g = eps[1] - eps[0]
    if g < 0.0 { return -g }
    return g
}

// ══ (6) self-consistency residual — honest SC check (d6) ════════════════════════════
// A TRUE self-consistent screening means V_scr[ρ] is a fixed point: feeding the same ρ
// reproduces the same V_scr(G) shells. This fn measures ‖V_scr(G)[ρ] − V_scr(G)[ρ_prev]‖∞
// across the shells — a caller iterating ρ to convergence drives this → 0. If a caller
// hands a NON-converged ρ, the residual exposes it (never papered over). Returns the max
// per-shell |Δ| over nshell shells; ρ==ρ_prev → 0 exactly (idempotent fixed point).
pub fn qforge_chip_gfull_sc_residual(rho: [float], rho_prev: [float], n: int,
                                     b1: float, xc_mode: int, nshell: int) -> float {
    let va = qforge_chip_vscr_gshells_1d(rho, n, b1, xc_mode, nshell)
    let vb = qforge_chip_vscr_gshells_1d(rho_prev, n, b1, xc_mode, nshell)
    let na = len(va)
    let nb = len(vb)
    if na == 0 { return 0.0 }
    if na != nb { return 1.0e30 }                             // shape mismatch — surfaced loud
    let mut mx = 0.0
    let mut i = 0
    while i < na {
        let d = _abs_r7(va[i] - vb[i])
        if d > mx { mx = d }
        i = i + 1
    }
    return mx
}
