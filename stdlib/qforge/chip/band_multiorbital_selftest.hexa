// @ci_gate — deterministic · multi-orbital H(k) eig vs closed-form anchors
//
// qforge_chip_band_multiorbital_selftest.hexa — QFORGE CHIP round-9 g5 gate.
//
// band_multiorbital.hexa promotes the band leg from a SINGLE-BAND H(k) (R1 cosine
// dispersion / R3 plane-wave) to a MULTI-ORBITAL / MULTI-BAND H(k):
//   H_{αβ}(k) = onsite[α]·δ_{αβ} + Σ_hop t·cos(k·dx·a),   ε_n(k) = eig[ H(k) ].
// Each site carries n_orb local orbitals (Slater-Koster s/p two-centre integrals or a
// generic 2-band model), so eig[H(k)] yields n_orb bands. H(k) is diagonalised by the
// GENERIC eigh (d19 — round-1's diatomic gap / round-3's plane-wave H(k) / L1 / Davidson
// all share it). Every anchor is an EXACT closed form (d6 — derivable, none tuned):
//
//   (A) MULTI-BAND DIMENSION — H(k) is n_orb×n_orb (n_orb² flat entries) and eig returns
//       EXACTLY n_orb real eigenvalues per k. We build a 2-orbital (s,p) chain and a
//       3-orbital chain and assert dim(H)=n_orb², len(ε(k))=n_orb at every sampled k.
//       The R1/R3 single-band band is the n_orb=1 limit (also asserted).            🔵
//   (B) EFFECTIVE MASS — for the closed 1-orbital cosine band ε(k)=ε₀−2t·cos(ka) the
//       curvature at the band BOTTOM k=0 is ε''=2t·a² ⇒ m*=ħ²/(2 t a²) EXACTLY
//       (Ashcroft-Mermin Ch.12). We compute m* by a finite-difference d²ε/dk² of the
//       eig band and check it against this closed form; we also confirm a FLATTER band
//       (smaller |t|) gives a HEAVIER mass (m*∝1/t) and a band MAXIMUM gives m*<0
//       (hole). The curvature→mass map, from the real eig band.                     🔵
//   (C) DIRECT / INDIRECT GAP — VBM = max of the valence (lowest) band, CBM = min of the
//       conduction (highest) band over a k-mesh. A 2-band model with a k-INDEPENDENT
//       coupling keeps both extrema at the SAME k ⇒ DIRECT; a model whose conduction
//       band is pushed to the zone boundary by a hopping sign gives k_VBM≠k_CBM ⇒
//       INDIRECT. Both verdicts are read off the SAME eig[H(k)] machine (d4 — data,
//       not a branch). We assert the direct model is DIRECT and the indirect is
//       INDIRECT, with gap≥0 in both.                                              🔵
//   (D) 2-BAND CLOSED FORM — a 2×2 H=[[Ea,V],[V,Eb]] has EXACT eigenvalues
//       ε_±=½(Ea+Eb)±√((½(Ea−Eb))²+V²) (Wolfsberg / two-level secular). At Ea=Eb the
//       gap is 2|V| (avoided crossing). We assert eig[H(k)] reproduces this closed form
//       across k (including the degenerate avoided-crossing width 2|V|), AND that H(k)
//       is Hermitian (real-symmetric) at every k.                                  🔵
//   (E) VALLEY COUNT — the number of conduction-band minima over the zone (degenerate
//       valleys, e.g. Si's reduced-zone valley multiplicity). A single-minimum band → 1
//       valley; a double-well conduction band (sign-frustrated hop) → 2 valleys.    🔵
//
// HONEST SCOPE (d6): hoppings are SLATER-KOSTER / generic 2-band MODEL parameters — this
// gate proves MULTI-BAND STRUCTURE + EFFECTIVE-MASS curvature + DIRECT/INDIRECT verdict
// + 2-band closed form on derivable references, NOT a fitted Si/Ge parametrisation (no
// empirical ss/sp tables, no spin-orbit, no d-orbitals). A real material is a DATA swap
// into the same OrbitalModel (d4). The matrix-H(k)/eig/curvature/valley machinery is the
// deliverable; the numbers are textbook two-level / cosine-band closed forms.
//
// Run:  HEXA_LANG=. hexa run stdlib/qforge/chip/band_multiorbital_selftest.hexa
// PASS: "qforge_chip_band_multiorbital_selftest PASS".
use "stdlib/qforge/chip/band_multiorbital"

fn _abs(x: float) -> float { if x < 0.0 { return -x } return x }
fn _pi() -> float { return 3.14159265358979323846 }
fn _ck_close(name: str, got: float, want: float, eps: float) -> int {
    if _abs(got - want) <= eps { println("PASS " + name + " (" + to_string(got) + ")") ; return 0 }
    println("FAIL " + name + " — got " + to_string(got) + " want " + to_string(want)) ; return 1
}
fn _ck_int(name: str, got: int, want: int) -> int {
    if got == want { println("PASS " + name + " (" + to_string(got) + ")") ; return 0 }
    println("FAIL " + name + " — got " + to_string(got) + " want " + to_string(want)) ; return 1
}
fn _ck_true(name: str, cond: bool) -> int {
    if cond { println("PASS " + name) ; return 0 }
    println("FAIL " + name) ; return 1
}

fn main() {
    let mut fails = 0
    let pi = _pi()
    let a = 4.0                                  // lattice constant (bohr analogue)
    let hbar = 1.0                               // natural units (m* in ħ²/[E·L²])

    // ════════════════════════════════════════════════════════════════════════
    // (A) MULTI-BAND DIMENSION — eig[H(k)] returns n_orb bands per k.
    // ════════════════════════════════════════════════════════════════════════
    // 2-orbital (s,p) chain: onsite Es=−1, Ep=+2; self-hops ts=−2t_s, tp=+2t_p
    //   (encoding: a self-hop {α,α,1,T} contributes T·cos(ka); choosing T=−2t gives
    //    the textbook ε_α(k)=E_α − 2t·cos(ka)).  An on-cell s↔p mixing {0,1,0,m}.
    let es = -1.0
    let ep = 2.0
    let onsite2 = [es, ep]
    // hops: [α,β,dx,t]  — s self-hop (−2·0.5), p self-hop (−2·0.25 with + sign), s-p k-dep mix.
    let hops2 = [0.0, 0.0, 1.0, -1.0,            // s band: ε_s = Es − 1·cos(ka)
                 1.0, 1.0, 1.0, -0.5]            // p band: ε_p = Ep − 0.5·cos(ka)
    // dim of H(k) = norb² = 4.
    let hk0 = qforge_chip_mo_hk(2, onsite2, hops2, 0.0, a)
    fails = fails + _ck_int("(A) dim H(k) = norb²=4 (2-orbital)", len(hk0), 4)
    // eig returns 2 bands at several k.
    let kA = pi / (3.0 * a)
    let bA = qforge_chip_mo_bands(2, onsite2, hops2, kA, a)
    fails = fails + _ck_int("(A) #bands = norb=2 @k=π/3a", len(bA), 2)
    // bands are ascending and DECOUPLED (no off-diagonal at this k) → closed cosine bands.
    // at k=0: ε_s=Es−1=−2, ε_p=Ep−0.5=1.5  (ascending: −2, 1.5).
    let b0 = qforge_chip_mo_bands(2, onsite2, hops2, 0.0, a)
    fails = fails + _ck_close("(A) band0(k=0)=Es−1=−2 (s-like)", b0[0], es - 1.0, 1.0e-9)
    fails = fails + _ck_close("(A) band1(k=0)=Ep−0.5=1.5 (p-like)", b0[1], ep - 0.5, 1.0e-9)
    // 3-orbital chain → 3 bands, dim 9.
    let onsite3 = [-2.0, 0.0, 3.0]
    let hops3 = [0.0, 0.0, 1.0, -0.6, 1.0, 1.0, 1.0, -0.4, 2.0, 2.0, 1.0, -0.2]
    let hk3 = qforge_chip_mo_hk(3, onsite3, hops3, kA, a)
    fails = fails + _ck_int("(A) dim H(k)=norb²=9 (3-orbital)", len(hk3), 9)
    let b3 = qforge_chip_mo_bands(3, onsite3, hops3, kA, a)
    fails = fails + _ck_int("(A) #bands=norb=3", len(b3), 3)
    // single-band (norb=1) limit = R1/R3 cosine band.
    let b1 = qforge_chip_mo_bands(1, [0.5], [0.0, 0.0, 1.0, -2.0], 0.0, a)
    fails = fails + _ck_int("(A) norb=1 → 1 band (R1/R3 limit)", len(b1), 1)
    fails = fails + _ck_close("(A) norb=1 band(k=0)=ε₀−2t=0.5−2", b1[0], 0.5 - 2.0, 1.0e-9)

    // ════════════════════════════════════════════════════════════════════════
    // (B) EFFECTIVE MASS — m* = ħ²/(d²ε/dk²) at the band edge vs closed form.
    // ════════════════════════════════════════════════════════════════════════
    // single-band cosine ε(k)=ε₀−2t·cos(ka): at k=0 curvature ε''=2t·a² ⇒ m*=ħ²/(2 t a²).
    // encode as self-hop {0,0,1,−2t}: T=−2t ⇒ band = ε₀ + T·cos(ka) = ε₀−2t·cos(ka). ✓
    let t_s = 0.5
    let eps0 = 0.0
    let hopsM = [0.0, 0.0, 1.0, -2.0 * t_s]      // T=−2t ⇒ ε(k)=−2t·cos(ka)
    let mstar = qforge_chip_mo_effmass(1, [eps0], hopsM, a, 0, 0.0, hbar)
    let mstar_ref = hbar * hbar / (2.0 * t_s * a * a)
    fails = fails + _ck_close("(B) m*=ħ²/(2 t a²) @band bottom (t=0.5)", mstar, mstar_ref, 1.0e-4)
    // heavier mass for a flatter band: halve t → double m* (m*∝1/t).
    let t_flat = 0.25
    let hopsF = [0.0, 0.0, 1.0, -2.0 * t_flat]
    let mflat = qforge_chip_mo_effmass(1, [eps0], hopsF, a, 0, 0.0, hbar)
    fails = fails + _ck_close("(B) flatter band (t→t/2) → 2× heavier m*", mflat, 2.0 * mstar_ref, 1.0e-4)
    fails = fails + _ck_true("(B) m*(flat) > m*(sharp) (small t = heavy)", mflat > mstar)
    // band MAXIMUM (k=π/a) of the SAME cosine band has ε''<0 ⇒ m*<0 (a hole).
    let mhole = qforge_chip_mo_effmass(1, [eps0], hopsM, a, 0, pi / a, hbar)
    fails = fails + _ck_true("(B) band-top curvature<0 → m*<0 (hole)", mhole < 0.0)
    fails = fails + _ck_close("(B) |m*(top)|=|m*(bottom)| (symmetric cosine)", _abs(mhole), mstar_ref, 1.0e-4)

    // ════════════════════════════════════════════════════════════════════════
    // (C) DIRECT / INDIRECT GAP — VBM vs CBM k-position from eig[H(k)].
    // ════════════════════════════════════════════════════════════════════════
    let nk = 41
    // DIRECT model: two decoupled bands, BOTH extremal at k=0 (no sign frustration).
    //   valence ε_v=−1·cos(ka) (max at k=0… actually −cos has MIN at k=0); choose signs so
    //   valence band MAX and conduction band MIN are BOTH at k=0.
    //   valence: T_v=+1 ⇒ ε_v=+cos(ka), MAX at k=0 (=+1).  conduction: onsite gap + T_c=−1 ⇒
    //   ε_c=Eg+(−1)cos(ka)… min at k=0? −cos min at k=0 → ε_c min at k=0. Both at k=0 ⇒ DIRECT.
    let eg = 3.0
    let onsiteDir = [0.0, eg]
    let hopsDir = [0.0, 0.0, 1.0, 1.0,           // valence: ε_v=+cos(ka), MAX at k=0
                   1.0, 1.0, 1.0, -1.0]          // conduction: ε_c=Eg−cos(ka), MIN at k=0
    let scanDir = qforge_chip_mo_gap_scan(2, onsiteDir, hopsDir, a, nk)
    fails = fails + _ck_true("(C) DIRECT model: k_VBM ≈ k_CBM (both at Γ)", scanDir[3] > 0.5)
    fails = fails + _ck_close("(C) DIRECT k_VBM = 0 (Γ)", scanDir[1], 0.0, 1.0e-9)
    fails = fails + _ck_close("(C) DIRECT k_CBM = 0 (Γ)", scanDir[2], 0.0, 1.0e-9)
    fails = fails + _ck_true("(C) DIRECT gap ≥ 0", scanDir[0] >= 0.0)
    // gap = ε_c(0) − ε_v(0) = (Eg−1) − (+1) = Eg−2 = 1.
    fails = fails + _ck_close("(C) DIRECT gap = Eg−2 = 1", scanDir[0], eg - 2.0, 1.0e-9)
    // INDIRECT model: valence MAX at k=0, conduction MIN pushed to zone BOUNDARY k=π/a
    //   conduction ε_c=Eg+1·cos(ka): MIN at k=π/a (cos=−1) → ε_c=Eg−1 at boundary.
    let onsiteInd = [0.0, eg]
    let hopsInd = [0.0, 0.0, 1.0, 1.0,           // valence: ε_v=+cos(ka), MAX at k=0
                   1.0, 1.0, 1.0, 1.0]           // conduction: ε_c=Eg+cos(ka), MIN at k=π/a
    let scanInd = qforge_chip_mo_gap_scan(2, onsiteInd, hopsInd, a, nk)
    fails = fails + _ck_true("(C) INDIRECT model: k_VBM ≠ k_CBM", scanInd[3] < 0.5)
    fails = fails + _ck_close("(C) INDIRECT k_VBM = 0 (Γ)", scanInd[1], 0.0, 1.0e-9)
    fails = fails + _ck_close("(C) INDIRECT k_CBM = π/a (zone boundary)", scanInd[2], pi / a, 1.0e-9)
    fails = fails + _ck_true("(C) INDIRECT gap ≥ 0", scanInd[0] >= 0.0)
    // indirect gap = ε_c(π/a) − ε_v(0) = (Eg−1) − (+1) = Eg−2 = 1.
    fails = fails + _ck_close("(C) INDIRECT gap = Eg−2 = 1", scanInd[0], eg - 2.0, 1.0e-9)

    // ════════════════════════════════════════════════════════════════════════
    // (D) 2-BAND CLOSED FORM — eig[[Ea,V],[V,Eb]] = ½(Ea+Eb)±√((½ΔE)²+V²).
    // ════════════════════════════════════════════════════════════════════════
    // build a 2×2 H(k) directly: onsite [Ea,Eb], an on-cell (dx=0) s↔p coupling V.
    let ea = 1.0
    let eb = 4.0
    let vcpl = 1.2
    // on-cell off-diagonal mixing {0,1,0,V} → k-independent coupling V.
    let hops2b = [0.0, 1.0, 0.0, vcpl]
    let k_any = pi / (5.0 * a)                   // arbitrary k — V is k-independent here
    let b2 = qforge_chip_mo_bands(2, [ea, eb], hops2b, k_any, a)
    let ref2 = qforge_chip_mo_two_band(ea, eb, vcpl)
    fails = fails + _ck_close("(D) eig ε− = ½(Ea+Eb)−√((½ΔE)²+V²)", b2[0], ref2[0], 1.0e-9)
    fails = fails + _ck_close("(D) eig ε+ = ½(Ea+Eb)+√((½ΔE)²+V²)", b2[1], ref2[1], 1.0e-9)
    // closed-form value check: ½(1+4)=2.5, √((1.5)²+1.2²)=√(2.25+1.44)=√3.69.
    let disc = sqrt(1.5 * 1.5 + vcpl * vcpl)
    fails = fails + _ck_close("(D) ε− closed value = 2.5−√3.69", ref2[0], 2.5 - disc, 1.0e-12)
    fails = fails + _ck_close("(D) ε+ closed value = 2.5+√3.69", ref2[1], 2.5 + disc, 1.0e-12)
    // DEGENERATE avoided crossing Ea=Eb → gap = 2|V|.
    let degb = qforge_chip_mo_bands(2, [2.0, 2.0], [0.0, 1.0, 0.0, 0.7], k_any, a)
    fails = fails + _ck_close("(D) degenerate Ea=Eb → gap = 2|V| = 1.4", degb[1] - degb[0], 2.0 * 0.7, 1.0e-9)
    // Hermiticity: H(k) symmetric — H_01 == H_10 for the coupled model at several k.
    let hkc = qforge_chip_mo_hk(2, [ea, eb], hops2b, k_any, a)
    fails = fails + _ck_close("(D) H(k) Hermitian: H_01 == H_10", hkc[1], hkc[2], 1.0e-12)
    // with a k-DEPENDENT inter-orbital hop, still symmetric at every k.
    let hkc2 = qforge_chip_mo_hk(2, [ea, eb], [0.0, 1.0, 1.0, 0.9], pi / (7.0 * a), a)
    fails = fails + _ck_close("(D) H(k) Hermitian w/ k-dep hop: H_01==H_10", hkc2[1], hkc2[2], 1.0e-12)

    // ════════════════════════════════════════════════════════════════════════
    // (E) VALLEY COUNT — conduction-band minima over the zone.
    // ════════════════════════════════════════════════════════════════════════
    // single-minimum conduction band ε_c=Eg−cos(ka) (min at k=0) → 1 valley.
    let nv1 = qforge_chip_mo_valley_count(2, onsiteDir, hopsDir, a, nk)
    fails = fails + _ck_int("(E) single-well conduction band → 1 valley", nv1, 1)
    // a frustrated conduction band with BOTH cos and cos2 components → double well.
    //   ε_c = Eg + cos(ka) + γ·cos(2ka).  pick γ so two minima appear away from k=0,π/a.
    //   encode cos(2ka) via a dx=2 self-hop {1,1,2,γ}.
    let gamma = 0.9
    let onsiteW = [0.0, 3.0]
    let hopsW = [0.0, 0.0, 1.0, 1.0,             // valence
                 1.0, 1.0, 1.0, 1.0,             // conduction +cos(ka)
                 1.0, 1.0, 2.0, gamma]           // conduction +γcos(2ka) → double well
    let nv2 = qforge_chip_mo_valley_count(2, onsiteW, hopsW, a, nk)
    fails = fails + _ck_true("(E) double-well conduction band → ≥2 valleys", nv2 >= 2)

    // ════════════════════════════════════════════════════════════════════════
    if fails == 0 {
        println("qforge_chip_band_multiorbital_selftest PASS")
    } else {
        println("qforge_chip_band_multiorbital_selftest FAIL — " + to_string(fails) + " check(s)")
    }
}
