// HEXA Standard Library — qforge/chip/band_kmesh
//
// QFORGE universal-engine · CHIP scale · round-2 brick.
//   scale ladder (QFORGE.md §122):  chip = device 밴드·수송·열(TCAD).
//   round-1 (band_transport.hexa) laid the analytic SPINE: a single ε(k), the
//   diatomic GAP via generic eigh, Landauer ΣTₙ, and the thermal quantum g₀.
//
// Round-2 promotes the band leg from a single k to a k-MESH manifold and wires
// the transport leg to a 2-terminal NEGF transmission, closing the band↔transport
// BRIDGE that round-1 only encoded as an identity. Every anchor is again an EXACT
// closed form (d6 — derivable, none tuned), so this is a g5 anchor an SCF-fed band
// machine (round-3) must reproduce:
//
//   ① k-MESH BAND SWEEP — evaluate ε_n(k) on a Monkhorst-Pack mesh (REUSE of
//      stdlib/qforge/mpgrid, d19 — the SAME generator that feeds the SCF k-mesh
//      and DFPT q-mesh). For the 1D TB chain the mesh collapses to the kx column;
//      we sample ε(k) at every mesh point and recover the band edges (min/max →
//      bandwidth = 4t) directly from the swept manifold.
//
//   ② 1D DOS (van-Hove) — the density of states of ε(k)=ε₀−2t·cos(ka) is
//          g(E) = 1/(π a)·1/√((2t)² − (E−ε₀)²),
//      diverging as 1/√ at BOTH band edges E=ε₀∓2t (the 1D van-Hove singularity
//      that fixes the effective mass). The DOS integrates to exactly 1 state per
//      band over [ε₀−2t, ε₀+2t] (normalisation), via the closed-form arcsin
//      antiderivative — no numerical quadrature needed for the anchor.
//
//   ③ 2-TERMINAL NEGF TRANSMISSION — a uniform 1D TB lead-channel transmits
//      perfectly inside its band: the Fisher-Lee / mode-count transmission of a
//      reflectionless N-mode conductor is the INTEGER mode count N(E) — the number
//      of sub-bands the energy E cuts. So T(E) is a staircase, G(E)=T(E)·G₀, and
//      the band↔transport BRIDGE goes LIVE: the Landauer plateau count equals the
//      number of bands crossing E, computed from the SAME band kernel as ①.
//      (The lead surface Green's function / self-energy Σ(E) machinery the FULL
//      scattering-NEGF needs is deferred to round-3; here the ballistic mode count
//      IS the transmission — the exact reflectionless limit, the g5 anchor.)
//
// ── d4 generic / d19 reuse contract ──────────────────────────────────────────
//   • k-mesh comes from qforge_mp_grid — NO new mesh generator (d19).
//   • the DOS and mode-count are pure (ε₀,t,a,E) maps — no per-material branch (d4).
//   • mode-count over a band list traverses ONE generic loop — adding a band is a
//     data change, never a code branch (d4).
//
//   pub fn qforge_chip_kmesh_band(eps0,t,a, n1, shift1)   -> [float]  // ε at each mesh kx
//   pub fn qforge_chip_kmesh_edges(eps0,t,a, n1, shift1)  -> [float]  // [ε_min, ε_max]
//   pub fn qforge_chip_dos1d(eps0,t,a, e)                 -> float    // van-Hove DOS g(E)
//   pub fn qforge_chip_dos1d_norm(eps0,t,a)              -> float    // ∫g dE over band = 1
//   pub fn qforge_chip_negf_modecount(band_lo, band_hi, e) -> int    // sub-bands cut by E
//   pub fn qforge_chip_negf_transmission(bands, e)       -> int      // T(E) = N(E)
//   pub fn qforge_chip_negf_conductance(bands, e, g0)    -> float    // G(E) = N(E)·G₀
//
// Run:  HEXA_LANG=. hexa run stdlib/qforge/chip/band_kmesh_selftest.hexa
use "stdlib/qforge/mpgrid"
use "stdlib/qforge/chip/band_transport"

// π to double precision (local const — no stdlib PI export; grep-verified d19).
fn _pi() -> float { return 3.14159265358979323846 }

// ── ① k-mesh band sweep ──────────────────────────────────────────────────────
// Evaluate the 1D TB dispersion ε(k)=ε₀−2t·cos(ka) at every point of a Monkhorst-
// Pack mesh generated by qforge_mp_grid (d19 REUSE). For the 1D chain only the kx
// axis is physical, so we build an (n1×1×1) MP grid and read the kx column
// (coords flat-laid kx,ky,kz). Fractional kx ∈ (−½,½] maps to crystal momentum
// k = 2π·kx / a. Returns ε at each mesh point, in MP point order.
pub fn qforge_chip_kmesh_band(eps0: float, t: float, a: float, n1: int, shift1: int) -> [float] {
    if a <= 0.0 { return [] }   // lattice length a≤0 → /a Inf
    let grid = qforge_mp_grid(n1, 1, 1, shift1, 0, 0)
    let coords = grid.coords
    let np = grid.npoints
    let twopi = 2.0 * _pi()
    let mut out: [float] = []
    let mut i = 0
    while i < np {
        let kx_frac = coords[i * 3]            // kx of point i (ky,kz are 0 in 1D)
        let k = twopi * kx_frac / a            // fractional → crystal momentum
        out.push(qforge_chip_tb1d_band(eps0, t, a, k))
        i = i + 1
    }
    return out
}

// Band edges recovered from the swept manifold: [ε_min, ε_max]. The bandwidth
// ε_max−ε_min = 4t EXACTLY iff the mesh hits BOTH the zone centre k=0 (ε₀−2t) and
// boundary k=π/a (ε₀+2t). Per the MP coordinate u_r=(2r−n−1)/(2n) (honest d6):
//   • a SHIFTED even-n grid (shift=1) has u_min=−½+1/n, u_max=+½ → hits BOTH edges
//     exactly (true even for n=2) — the exact bandwidth anchor;
//   • an UNSHIFTED odd-n grid is Γ-centred → hits k=0 exactly (lower edge);
//   • an UNSHIFTED even-n grid hits NEITHER edge (offset 1/(2n)) → bandwidth only
//     ASYMPTOTES to 4t as n→∞ (e.g. n=64 → 4.794, not 4.8).
// Returns scalars materialised immediately (gen3 arena-return guard).
pub fn qforge_chip_kmesh_edges(eps0: float, t: float, a: float, n1: int, shift1: int) -> [float] {
    let eps = qforge_chip_kmesh_band(eps0, t, a, n1, shift1)
    let np = len(eps)
    let mut lo = eps[0]
    let mut hi = eps[0]
    let mut i = 1
    while i < np {
        let e = eps[i]
        if e < lo { lo = e }
        if e > hi { hi = e }
        i = i + 1
    }
    return [lo, hi]
}

// ── ② 1D density of states (van-Hove singularity) ───────────────────────────
// For ε(k)=ε₀−2t·cos(ka) on a chain of lattice a, the DOS per unit length is
//     g(E) = (1/π)·|dk/dE| · 2   (two ±k branches)  →  g(E) = 1/(π a √((2t)²−(E−ε₀)²)).
// We return g(E) per site (×a folds out the length), i.e.  1/(π √((2t)²−(E−ε₀)²)).
// Outside the band (|E−ε₀| ≥ 2t) the DOS is 0; at the edges it diverges as 1/√
// (the 1D van-Hove singularity). `t` enters via |t| (sign-independent half-width).
pub fn qforge_chip_dos1d(eps0: float, t: float, a: float, e: float) -> float {
    let halfw = 2.0 * t
    let hw = if halfw < 0.0 { -halfw } else { halfw }   // (2|t|) band half-width
    let x = e - eps0
    let arg = hw * hw - x * x
    if arg <= 0.0 { return 0.0 }                         // outside the band → 0
    return 1.0 / (_pi() * sqrt(arg))
}

// Closed-form band-occupation normalisation: ∫_{ε₀−2t}^{ε₀+2t} g(E) dE.
// With the substitution x=E−ε₀ the integral is (1/π)∫_{−2t}^{2t} dx/√((2t)²−x²)
// = (1/π)[arcsin(x/2t)]_{−2t}^{2t} = (1/π)(π/2 − (−π/2)) = 1 (exactly one state
// per band). We evaluate it via the arcsin antiderivative — NO numerical
// quadrature, so the anchor is exact. `asin` is a stdlib builtin (grep-verified
// in stdlib/kernels/geodesy — asin(1)=+π/2, asin(−1)=−π/2 exactly).
pub fn qforge_chip_dos1d_norm(eps0: float, t: float, a: float) -> float {
    // arcsin(1) − arcsin(−1) = π, so (1/π)·π = 1, independent of (ε₀,t).
    let halfw = 2.0 * t
    let hw = if halfw < 0.0 { -halfw } else { halfw }
    if hw == 0.0 { return 0.0 }                          // flat band → degenerate
    let asin_hi = asin(1.0)                              // +π/2 at upper edge u=+1
    let asin_lo = asin(-1.0)                             // −π/2 at lower edge u=−1
    return (asin_hi - asin_lo) / _pi()
}

// ── ③ 2-terminal NEGF transmission (reflectionless mode count) ──────────────
// A single band [band_lo, band_hi] contributes ONE open transmission mode when
// the probe energy E lies inside it (band_lo ≤ E ≤ band_hi), else zero. This is
// the exact reflectionless (ballistic) limit of the Fisher-Lee transmission for a
// uniform lead — the surface-Green's-function self-energy Σ(E) and the full
// T(E)=Tr[ΓL G^r ΓR G^a] reduce to the integer open-mode count for a clean
// channel (Datta). Returns 1 (open) or 0 (closed) for this band.
pub fn qforge_chip_negf_modecount(band_lo: float, band_hi: float, e: float) -> int {
    if e >= band_lo && e <= band_hi { return 1 }
    return 0
}

// Total NEGF transmission T(E) = Σ_bands [E ∈ band] — the number of sub-bands the
// energy cuts. `bands` is a flat [lo0,hi0, lo1,hi1, …] list (2 floats per band);
// ONE generic loop sums the per-band mode count (d4 — adding a band is data, not a
// branch). This IS the Landauer channel count, so G(E)=T(E)·G₀ quantizes exactly.
pub fn qforge_chip_negf_transmission(bands: [float], e: float) -> int {
    let nflt = len(bands)
    let nband = nflt / 2
    let mut t = 0
    let mut b = 0
    while b < nband {
        let lo = bands[b * 2]
        let hi = bands[b * 2 + 1]
        t = t + qforge_chip_negf_modecount(lo, hi, e)
        b = b + 1
    }
    return t
}

// 2-terminal NEGF conductance G(E) = T(E)·G₀ — the band↔transport BRIDGE made
// live: T(E) is the open-mode count of the band manifold (③), so this is exactly
// the Landauer N·G₀ plateau, now driven by the SAME band kernel as ① (not an
// independent channel list as in round-1's qforge_chip_landauer_g).
pub fn qforge_chip_negf_conductance(bands: [float], e: float, g0: float) -> float {
    let t = qforge_chip_negf_transmission(bands, e)
    return to_float(t) * g0
}
