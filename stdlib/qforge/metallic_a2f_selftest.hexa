// @ci_gate — pure · network-free · deterministic (stdlib_selftest_aggregate --ci-gate)
//
// metallic_a2f_selftest.hexa — QFORGE L3.q (multi-q α²F driver) g5 gate.
//
// Closes the gate on the MULTI-q α²F ASSEMBLY DRIVER (qforge_metallic_a2f_mesh):
// a real Monkhorst-Pack q-mesh sweep + a per-q el-ph PROVIDER CLOSURE → one flat
// (q,ν) sample list → the verified L3 BZ double-δ assembler → multi-q α²F →
// λ = 2∫α²F/ω. The driver is what lifts the metallic λ BEYOND the Γ-only
// single-Einstein coarse estimate. Honest tier (d6):
//
//   🔵 (closed-form, exact)  multi-q λ = Σ_{q,ν} λ(q,ν). The synthetic provider
//        puts on-shell electrons (ε=E_F) + a q-dependent mode ω(q) at every
//        q-point, so the FS double-δ collapses and the assembled-then-integrated
//        λ EQUALS the independent closed-form Σ_q 2·(w_q g²_q δ_σel(0)²/N)/ω_q
//        in the σ_ph→0 limit — an algebraic identity through the SAME L2 path.
//   🟢 (rel-ε numerical)     σ_ph→0 MONOTONE convergence: shrinking the phonon
//        smearing on a dense ω grid drives the multi-q λ rel-err to the analytic
//        Σ monotonically down (12,6,3,1.5 K), tightest ≤ 1%.
//   🟢 (DISTINCTNESS)        multi-q ≠ Γ-only: a 4×4×4 (64-q) mesh whose modes
//        DISPERSE across q gives a λ materially different from the Γ-only
//        single-Einstein estimate (same total coupling collapsed onto ω(Γ)) —
//        proving the driver samples the BZ, not a single point.
//   🟢 (d4 generic)          two DIFFERENT providers (constant-ω vs dispersing-ω)
//        traverse the IDENTICAL driver; the constant-ω mesh reproduces the
//        Γ-only Einstein λ (mesh-invariance when there is no dispersion).
//   guard  bad provider block size / empty mesh → [-1.0] / ok==0 sentinel.
//
// No QE-anchored λ is hard-wired (d6): the synthetic Σ_q closed form is the only
// reference. The converged-CaH6 QFORGE-vs-QE λ cross-val (real DFPT |g| over a
// q-mesh) is the REMAINING GATED step for the metallic wall — NOT faked here.
//
// Run:  HEXA_STDLIB_ROOT="$PWD/stdlib" hexa run \
//         stdlib/qforge/metallic_a2f_selftest.hexa
// PASS: exits printing "metallic_a2f_selftest PASS".

use "stdlib/qforge/metallic_a2f"
use "stdlib/qforge/mpgrid"
use "stdlib/qforge/tc"
use "stdlib/material/sim"

let _M_SQRT2PI: float = 2.50662827463100050242
let _M_NK: int = 80          // on-shell electrons per (q,ν) mode (FS double-δ)
let _M_NEF: float = 1.0      // N(E_F) unit reference
let _M_SIGEL: float = 0.05   // electron FS smearing (on-shell ⇒ σ-independent)
let _M_G2: float = 30.0      // base |g|² magnitude per mode
let _M_W0: float = 300.0     // Γ mode frequency (K) — the dispersion baseline

fn _abs(x: float) -> float { if x < 0.0 { return -x } return x }

fn _ck(name: str, got: float, want: float, tol: float) -> int {
    let w = _abs(want)
    let d = _abs(got - want)
    let rel = if w < 1e-12 { d } else { d / w }
    if rel <= tol {
        println("PASS " + name + " (got " + to_string(got) + ")")
        return 0
    }
    println("FAIL " + name + " — got " + to_string(got) + " want " + to_string(want))
    return 1
}

fn _assert(name: str, cond: bool, detail: str) -> int {
    if cond { println("PASS " + name + "  " + detail) ; return 0 }
    println("FAIL " + name + "  " + detail) ; return 1
}

fn _grid(wlo: float, whi: float, ng: int) -> [float] {
    let mut g: [float] = []
    let step = (whi - wlo) / to_float(ng - 1)
    let mut j = 0
    while j < ng { g.push(wlo + step * to_float(j)) ; j = j + 1 }
    return g
}

// ── synthetic per-q PROVIDERS (d4 — caller closures) ────────────────────────
// Each returns a flat [4·nmode] pack for one q: [ω…, g2…, eps_k…, eps_kq…].
// ONE mode per q (nmode=1); _M_NK on-shell electrons fold into the prefactor via
// a per-mode |g|² scaled by _M_NK (the FS sum over on-shell electrons).
// The electron blocks are ε=0 (on-shell, E_F=0).

// DISPERSING provider: ω(q) = w0·(1 + 0.6·(|qx|+|qy|+|qz|)) — modes spread over
// the BZ (a real metallic phonon branch disperses). g2 constant across q.
fn _prov_disperse(qx: float, qy: float, qz: float) -> [float] {
    let aq = _abs(qx) + _abs(qy) + _abs(qz)
    let w = _M_W0 * (1.0 + 0.6 * aq)
    // per-mode |g|² already summed over the _M_NK on-shell electrons:
    let g2_mode = _M_G2 * to_float(_M_NK)
    return [w, g2_mode, 0.0, 0.0]
}

// CONSTANT-ω provider: ω(q) = w0 for ALL q (no dispersion). The mesh sum must
// then reproduce the Γ-only single-Einstein λ (mesh-invariance test).
fn _prov_const(qx: float, qy: float, qz: float) -> [float] {
    let g2_mode = _M_G2 * to_float(_M_NK)
    return [_M_W0, g2_mode, 0.0, 0.0]
}

// closed-form λ for a provider over a grid: λ = Σ_q 2·(w_q·g2_mode·δ(0)²/N)/ω_q.
// (w_q = MP star weight; δ(0) = 1/(σ_el√2π); on-shell ⇒ both electron δ = δ(0).)
fn _analytic_lambda_disperse(grid: MpGrid) -> float {
    let d0 = 1.0 / (_M_SIGEL * _M_SQRT2PI)
    let g2_mode = _M_G2 * to_float(_M_NK)
    let mut lam = 0.0
    let mut iq = 0
    while iq < grid.npoints {
        let qx = grid.coords[3 * iq]
        let qy = grid.coords[3 * iq + 1]
        let qz = grid.coords[3 * iq + 2]
        let aq = _abs(qx) + _abs(qy) + _abs(qz)
        let w = _M_W0 * (1.0 + 0.6 * aq)
        let wq = grid.weights[iq]
        let big_d = wq * g2_mode * d0 * d0 / _M_NEF
        // F2: ω divisor in the α²F numerator's ENERGY unit (Ha), not K.
        lam = lam + 2.0 * big_d / (w * ha_per_kelvin())
        iq = iq + 1
    }
    return lam
}

fn main() {
    let mut fails = 0

    // ── q-mesh: 4×4×4 Γ-centred MP grid (d19 reuse — the SCF k-mesh generator) ─
    let grid = qforge_mp_grid(4, 4, 4, 0, 0, 0)
    println("[mesh] " + to_string(grid.npoints) + "-point MP q-grid (4×4×4)")

    let wlo = 60.0
    let whi = 1600.0       // wide enough to bracket the dispersed ω(q) up to ~840

    // ── 🔵 sub-check 1 — multi-q λ = Σ_{q,ν} λ(q,ν) (σ_ph→0 limit) ────────────
    let lam_analytic = _analytic_lambda_disperse(grid)
    println("[multi-q] analytic Σ_q λ(q) = " + to_string(lam_analytic))
    let lam_sharp = qforge_metallic_lambda_mesh(grid, _prov_disperse, 1, 0.0,
                                                _M_NEF, _grid(wlo, whi, 40001),
                                                _M_SIGEL, 0.8)
    fails = fails + _ck("🔵 multi-q λ = Σ_{q,ν} λ(q,ν)  (2∫α²F/ω)",
                        lam_sharp, lam_analytic, 1e-2)

    // ── 🟢 sub-check 2 — σ_ph→0 MONOTONE convergence to Σ_q ──────────────────
    let ng = 40001
    let og = _grid(wlo, whi, ng)
    let l12 = qforge_metallic_lambda_mesh(grid, _prov_disperse, 1, 0.0, _M_NEF, og, _M_SIGEL, 12.0)
    let l6  = qforge_metallic_lambda_mesh(grid, _prov_disperse, 1, 0.0, _M_NEF, og, _M_SIGEL, 6.0)
    let l3  = qforge_metallic_lambda_mesh(grid, _prov_disperse, 1, 0.0, _M_NEF, og, _M_SIGEL, 3.0)
    let l15 = qforge_metallic_lambda_mesh(grid, _prov_disperse, 1, 0.0, _M_NEF, og, _M_SIGEL, 1.5)
    let e12 = _abs(l12 - lam_analytic) / lam_analytic
    let e6  = _abs(l6  - lam_analytic) / lam_analytic
    let e3  = _abs(l3  - lam_analytic) / lam_analytic
    let e15 = _abs(l15 - lam_analytic) / lam_analytic
    println("[converge] σ_ph=12→λ=" + to_string(l12) + " (relerr " + to_string(e12) + ")")
    println("[converge] σ_ph= 6→λ=" + to_string(l6)  + " (relerr " + to_string(e6)  + ")")
    println("[converge] σ_ph= 3→λ=" + to_string(l3)  + " (relerr " + to_string(e3)  + ")")
    println("[converge] σ_ph=1.5→λ=" + to_string(l15) + " (relerr " + to_string(e15) + ")")
    fails = fails + _assert("🟢 σ_ph→0 convergence MONOTONE",
                            e12 > e6 && e6 > e3 && e3 > e15,
                            "(" + to_string(e12) + " > " + to_string(e6) + " > " +
                            to_string(e3) + " > " + to_string(e15) + ")")
    fails = fails + _assert("🟢 tightest σ_ph rel-err ≤ 1%", e15 <= 1e-2,
                            "(relerr=" + to_string(e15) + ")")

    // ── 🟢 sub-check 3 — multi-q ≠ Γ-only (the metallic wall's whole point) ───
    // Γ-only estimate: ALL the coupling collapsed onto the single Γ mode ω(Γ)=w0
    // (this is the M5.8 single-Einstein coarse estimate). The dispersing-mesh λ
    // MUST differ materially — proving the driver samples the BZ, not just Γ.
    let d0 = 1.0 / (_M_SIGEL * _M_SQRT2PI)
    let g2_mode = _M_G2 * to_float(_M_NK)
    // Γ-only: total weight (Σw_q=1) on one mode at ω(Γ)=w0. F2: ω in Ha.
    let lam_gamma_only = 2.0 * (1.0 * g2_mode * d0 * d0 / _M_NEF) / (_M_W0 * ha_per_kelvin())
    println("[Γ-only] single-Einstein λ(Γ) = " + to_string(lam_gamma_only) +
            "   vs multi-q λ = " + to_string(lam_sharp))
    let rel_gap = _abs(lam_sharp - lam_gamma_only) / lam_gamma_only
    fails = fails + _assert("🟢 multi-q ≠ Γ-only (distinct)",
                            rel_gap > 0.10,
                            "(rel gap " + to_string(rel_gap) + " > 0.10)")
    // dispersion pushes weight to HIGHER ω(q) ⇒ smaller λ than Γ-only.
    fails = fails + _assert("🟢 dispersion lowers λ vs Γ-only",
                            lam_sharp < lam_gamma_only,
                            "(" + to_string(lam_sharp) + " < " +
                            to_string(lam_gamma_only) + ")")

    // ── 🟢 sub-check 4 — d4 generic: constant-ω mesh reproduces Γ-only Einstein ─
    // The SAME driver with a non-dispersing provider must reproduce the Γ-only
    // λ (no dispersion ⇒ mesh-invariant). Proves the driver is generic over the
    // provider and the multi-q path degenerates correctly to the single point.
    let lam_const = qforge_metallic_lambda_mesh(grid, _prov_const, 1, 0.0,
                                                _M_NEF, _grid(wlo, whi, 40001),
                                                _M_SIGEL, 1.5)
    println("[mesh-invariance] constant-ω mesh λ = " + to_string(lam_const) +
            "   Γ-only λ = " + to_string(lam_gamma_only))
    fails = fails + _ck("🟢 constant-ω mesh = Γ-only Einstein (d4 generic)",
                        lam_const, lam_gamma_only, 1e-2)

    // ── 🟢 sub-check 5 — bundled entry {λ, ω_log, α²F} ───────────────────────
    let res = qforge_metallic_a2f(grid, _prov_disperse, 1, 0.0, _M_NEF,
                                  _grid(wlo, whi, 40001), _M_SIGEL, 1.5)
    println("[bundle] ok=" + to_string(res.ok) + " λ=" + to_string(res.lambda) +
            " ω_log=" + to_string(res.omega_log) + " K  α²F-len=" +
            to_string(len(res.a2f)))
    fails = fails + _assert("🟢 bundle ok==1 + λ matches analytic",
                            res.ok == 1 &&
                            _abs(res.lambda - lam_analytic) / lam_analytic <= 1e-2,
                            "(λ=" + to_string(res.lambda) + ")")
    fails = fails + _assert("🟢 ω_log within dispersed band [w0, 840]",
                            res.omega_log > _M_W0 && res.omega_log < 900.0,
                            "(ω_log=" + to_string(res.omega_log) + ")")

    // ── guard — bad provider block size → [-1.0]/ok==0 sentinel ──────────────
    let bad = qforge_metallic_a2f_mesh(grid, _prov_disperse, 2, 0.0, _M_NEF,
                                       _grid(wlo, whi, 100), _M_SIGEL, 1.5)
    fails = fails + _assert("guard bad provider block size → [-1.0]",
                            len(bad) == 1 && bad[0] < 0.0,
                            "(len=" + to_string(len(bad)) + ")")
    let res_bad = qforge_metallic_a2f(grid, _prov_disperse, 2, 0.0, _M_NEF,
                                      _grid(wlo, whi, 100), _M_SIGEL, 1.5)
    fails = fails + _assert("guard bundled bad provider → ok==0",
                            res_bad.ok == 0, "(ok=" + to_string(res_bad.ok) + ")")

    // ── 🔵 F2 DIMENSIONAL-CLOSURE — the assertion that fences the unit bug ─────
    // This is WHY the ~10^5.5 λ gap survived: every prior λ check was scale-
    // INVARIANT (ratios, monotone convergence, assembled-vs-analytic with the
    // SAME K unit on BOTH sides). Add a REAL dimensional assertion that can only
    // pass with a unit-consistent divisor: assemble the SAME physical Einstein
    // spectrum on a KELVIN ω-grid and on a HARTREE ω-grid (the phonon ω₀ and the
    // grid + σ_ph all converted K→Ha together — a genuine change of unit), then
    // integrate each with the divisor in its OWN grid unit:
    //   λ_K  = qforge_a2f_lambda(K-grid α²F)    — K grid + the F2 K→Ha divisor
    //   λ_Ha = scaled(Ha-grid α²F, 1.0)         — Ha grid + Ha divisor (native)
    // A unit-consistent λ is a PHYSICAL number → INVARIANT to the grid's unit.
    // The buggy raw-K divisor makes λ_K too small by EXACTLY Ha/K vs the physical
    // λ_Ha; a synthetic test on a single unit could never catch that. Both must
    // now agree, and the legacy raw-K path must be off by exactly Ha/K.
    let w0K = 1000.0
    let pack = qforge_a2f_einstein_samples(_M_NK, 0.0, _M_G2, w0K)
    let mut ek: [float] = [] ; let mut ekq: [float] = []
    let mut gg: [float] = [] ; let mut wq: [float] = []
    let mut jc = 0
    while jc < _M_NK { ek.push(pack[jc]) ; ekq.push(pack[_M_NK + jc])
                       gg.push(pack[2 * _M_NK + jc]) ; wq.push(pack[3 * _M_NK + jc]) ; jc = jc + 1 }
    // Kelvin assembly (grid + σ_ph in K).
    let gridK = _grid(200.0, 2400.0, 20001)
    let a2fK = qforge_a2f_from_elph(ek, ekq, gg, wq, 0.0, _M_NEF, gridK, 1.0, _M_SIGEL, 8.0)
    let lam_K = qforge_a2f_lambda(gridK, a2fK)
    // Hartree assembly: the SAME physics, ω₀+grid+σ_ph all scaled K→Ha together.
    let s = ha_per_kelvin()
    let mut wqHa: [float] = []
    jc = 0 ; while jc < _M_NK { wqHa.push(w0K * s) ; jc = jc + 1 }
    let mut gridHa: [float] = []
    jc = 0 ; while jc < len(gridK) { gridHa.push(gridK[jc] * s) ; jc = jc + 1 }
    let a2fHa = qforge_a2f_from_elph(ek, ekq, gg, wqHa, 0.0, _M_NEF, gridHa, 1.0, _M_SIGEL, 8.0 * s)
    let lam_Ha = eliashberg_moments_from_a2f_scaled(gridHa, a2fHa, 1.0)[0]
    println("[F2-closure] λ(K-grid,K→Ha)=" + to_string(lam_K)
            + "  λ(Ha-grid,native)=" + to_string(lam_Ha))
    fails = fails + _ck("🔵 F2 unit-invariance: K-grid λ = Ha-grid λ (physical)",
                        lam_K, lam_Ha, 1e-4)
    // and the OLD buggy raw-K divisor path is too SMALL by EXACTLY Ha/K.
    let lam_buggy = eliashberg_moments_from_a2f(gridK, a2fK)[0]   // legacy: ω in K
    let corr = lam_K / lam_buggy
    fails = fails + _ck("🔵 F2 correction factor vs legacy raw-K path = Ha/K",
                        corr, kelvin_per_hartree(), 1e-6)

    if fails == 0 {
        println("metallic_a2f_selftest PASS")
    } else {
        println("metallic_a2f_selftest FAIL — " + to_string(fails) + " case(s)")
    }
}
