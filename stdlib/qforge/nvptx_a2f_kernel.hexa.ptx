    fma.rn.f64 %fd_exp_p_88, %fd_exp_r_88, %fd_exp_p_88, 0d3FE0000000000000;  // exp f64 Horner step
    fma.rn.f64 %fd_exp_p_88, %fd_exp_r_88, %fd_exp_p_88, 0d3FF0000000000000;  // exp f64 Horner step
    fma.rn.f64 %fd_exp_p_88, %fd_exp_r_88, %fd_exp_p_88, 0d3FF0000000000000;  // exp f64 Horner step
    add.s64 %rd_exp_b_88, %rd_exp_k_88, 1023;  // exp f64: b = k + 1023 (IEEE bias)
    shl.b64 %rd_exp_b_88, %rd_exp_b_88, 52;  // exp f64: b <<= 52 (exponent field)
    mov.b64 %fd_exp_pow2k_88, %rd_exp_b_88;  // exp f64: pow2k = bit-cast b
    mul.f64 %fd88, %fd_exp_p_88, %fd_exp_pow2k_88;  // exp f64: dst = poly * 2^k = e^x
    mul.f64 %fd89, %fd88, %fd41;  // binop *
    mov.f64 %fd85, %fd89;  // assign
    bra $L_11;  // br -> $L_11
$L_11:
    mul.f64 %fd90, %fd77, %fd85;  // binop *
    add.f64 %fd91, %fd45, %fd90;  // binop +
    mov.f64 %fd45, %fd91;  // assign
    add.s64 %rd92, %rd46, 1;  // binop +
    mov.u64 %rd46, %rd92;  // assign
    bra $L_3;  // br -> $L_3
}
