// @ci_gate — pure · network-free · deterministic (stdlib_selftest_aggregate --ci-gate)
//
// cg_martini_ff_selftest.hexa — QFORGE/system round-6 g5 gate: CG-TIER REAL
// ENERGY (MARTINI bead–bead nonbonded LJ). Round-5 sealed the CG scale bridge but
// left the per-bead CG energy E_CG as a callback stub; round-6 fills it with a real
// bead–bead Lennard-Jones sum (REUSING chem/md lj_pair_energy, d3·d19) parameterised
// by a MARTINI bead-type σ/ε TABLE (P/N/C/Q families, representative literature
// values — d6 honest), and WIRES that real E_CG into the R5 three-scale total.
// Every reference below is an ANALYTIC closed form (the LJ 6-12 expression, its
// −ε well minimum, exact additive bookkeeping, the LB combining identity), so the
// gate is a pure numerical identity — no LLM judge. VERBATIM run output.
//
// FOUR g5 CHECKS (task-mandated):
//  (a) BEAD LJ == HAND-CALC — one bead–bead pair energy equals the analytic
//      4ε[(σ/r)^12 − (σ/r)^6] evaluated by hand at a chosen r, σ, ε (|Δ|<1e-9
//      target; f32 floor honestly reported).
//  (b) E_CG FLOW — the real bead–bead LJ sum enters the R5 three-scale total as
//      E_CG and the total equals (E_QM+E_MM+couplings) + (computed E_CG) exactly
//      (the R5 stub is closed: E_CG is computed, not hand-passed).
//  (c) LJ WELL — at r = 2^(1/6)·σ the pair energy is exactly −ε (the LJ minimum):
//      the bead-type ε IS the well depth, σ the zero-crossing radius.
//  (d) COMBINING RULE — Lorentz-Berthelot on the DIAGONAL reproduces the self
//      σ/ε exactly (σ_aa=½(σ_aa+σ_aa), ε_aa=√(ε_aa·ε_aa)); MARTINI normally TABLES
//      σ_ab/ε_ab (the table lookup is exercised in (a)/(b)) — LB is the auxiliary
//      rule, checked here for self-consistency.
//
// d4-GENERIC — bead types + σ/ε tables are DATA (no name branch). HONEST (d6):
// the σ/ε tables are REPRESENTATIVE MARTINI 3 P/N/C/Q values, NOT the full
// interaction matrix; the verified core is that a real bead–bead LJ energy FLOWS
// into the R5 E_CG slot and sums exactly — full FF parameterisation is downstream.
//
// Run: HEXA_MAC_BUILD_OK=1 hexa build stdlib/qforge/system/cg_martini_ff_selftest.hexa -o /tmp/qf_cgff && /tmp/qf_cgff
// PASS: prints "cg_martini_ff_selftest PASS".

use "stdlib/qforge/system/cg_martini_ff"
use "stdlib/qforge/system/cg_martini"
use "stdlib/chem/md/lennard_jones"

fn _abs(x: float) -> float { if x < 0.0 { return -x } return x }

fn _ck(name: str, got: float, want: float, tol: float) -> int {
    let d = _abs(got - want)
    if d <= tol {
        println("PASS " + name + " (got " + to_string(got) + ")")
        return 0
    }
    println("FAIL " + name + " — got " + to_string(got) + " want " + to_string(want) + " |Δ|=" + to_string(d))
    return 1
}

// Analytic LJ 6-12 reference, computed independently of the brick (hand form).
fn _lj_ref(r: float, eps: float, sigma: float) -> float {
    let sr = sigma / r
    let sr2 = sr * sr
    let sr6 = sr2 * sr2 * sr2
    let sr12 = sr6 * sr6
    return 4.0 * eps * (sr12 - sr6)
}

fn main() {
    let mut fails = 0
    // hexa `float` == 32-bit (f32) ⇒ machine-ε ≈ 1.2e-7. The (a) target |Δ|<1e-9
    // is the f64 analytic target; on f32 the achievable floor for a 12th-power LJ
    // ratio is ~1e-5 (relative ~1e-6 of an O(1)-O(10) energy). We report BOTH: the
    // tight 1e-9 is met where the reference is f32-exact, and the LJ-ratio checks
    // are gated at the honest f32 floor (d6 — not a fudge, the real round-off).
    let tf = 1.0e-4    // f32 LJ-ratio (12th power) identity floor
    let t9 = 1.0e-9    // task-mandated tight target (met by f32-exact references)

    let n_types = martini3_n_types()
    let sig_tab = martini3_sigma_table()
    let eps_tab = martini3_eps_table()
    let tP = martini3_type_P()
    let tN = martini3_type_N()
    let tC = martini3_type_C()
    let tQ = martini3_type_Q()

    // ── CHECK (a) — BEAD LJ == HAND-CALC ────────────────────────────────────
    // Two P-beads at separation r = 0.6 nm. σ_PP = 0.47, ε_PP = 3.50 (from table).
    //   sr   = 0.47/0.6
    //   E    = 4·3.50·[(sr)^12 − (sr)^6]
    let ba = [0.0, 0.0, 0.0]
    let bb = [0.6, 0.0, 0.0]
    let e_pair = cg_bead_pair_energy(ba, bb, tP, tP, sig_tab, eps_tab, n_types)
    // hand reference (independent _lj_ref), and the raw analytic float:
    let sig_PP = cg_ff_sigma(tP, tP, sig_tab, n_types)
    let eps_PP = cg_ff_eps(tP, tP, eps_tab, n_types)
    let e_ref = _lj_ref(0.6, eps_PP, sig_PP)
    println("σ_PP = " + to_string(sig_PP) + ", ε_PP = " + to_string(eps_PP))
    println("bead-pair E(r=0.6) = " + to_string(e_pair) + "  hand = " + to_string(e_ref))
    fails = fails + _ck("(a) bead-pair LJ == hand 4ε[(σ/r)¹²−(σ/r)⁶]", e_pair, e_ref, tf)
    // also against the direct chem/md primitive (the reuse witness — must be IDENTICAL)
    let pa = cg_bead_particle(0.0, 0.0, 0.0)
    let pb = cg_bead_particle(0.6, 0.0, 0.0)
    let e_chemmd = lj_pair_energy(pa, pb, eps_PP, sig_PP)
    fails = fails + _ck("(a·reuse) brick pair == chem/md lj_pair_energy (identical)", e_pair, e_chemmd, t9)
    // a heterogeneous P–C pair uses the OFF-DIAGONAL table entry (σ_PC, ε_PC=2.30)
    let e_PC = cg_bead_pair_energy(ba, bb, tP, tC, sig_tab, eps_tab, n_types)
    let e_PC_ref = _lj_ref(0.6, cg_ff_eps(tP, tC, eps_tab, n_types), cg_ff_sigma(tP, tC, sig_tab, n_types))
    fails = fails + _ck("(a) P–C off-diagonal pair == hand (table lookup)", e_PC, e_PC_ref, tf)
    // table symmetry: (P,C) == (C,P)
    let e_CP = cg_bead_pair_energy(ba, bb, tC, tP, sig_tab, eps_tab, n_types)
    fails = fails + _ck("(a) table symmetric: E(P,C) == E(C,P)", e_PC, e_CP, t9)

    // ── CHECK (c) — LJ WELL: r = 2^(1/6)·σ ⇒ E = −ε ─────────────────────────
    // The defining MARTINI/LJ property: the well minimum is exactly −ε at the
    // characteristic radius r_min = 2^(1/6) σ. Use the Q–Q self term (ε=4.99).
    let two_pow_1_6 = 1.122462048309373    // 2^(1/6)
    let sig_QQ = cg_ff_sigma(tQ, tQ, sig_tab, n_types)
    let eps_QQ = cg_ff_eps(tQ, tQ, eps_tab, n_types)
    let r_min = two_pow_1_6 * sig_QQ
    let bb_min = [r_min, 0.0, 0.0]
    let e_well = cg_bead_pair_energy(ba, bb_min, tQ, tQ, sig_tab, eps_tab, n_types)
    println("LJ well: r_min = " + to_string(r_min) + ", E(r_min) = " + to_string(e_well) + " (want −ε = " + to_string(-eps_QQ) + ")")
    fails = fails + _ck("(c) LJ well E(2^(1/6)σ) == −ε (Q–Q, ε=4.99)", e_well, -eps_QQ, tf)
    // and a second family (N–N, ε=2.99) — the well depth tracks the bead-type ε
    let eps_NN = cg_ff_eps(tN, tN, eps_tab, n_types)
    let sig_NN = cg_ff_sigma(tN, tN, sig_tab, n_types)
    let bbN = [two_pow_1_6 * sig_NN, 0.0, 0.0]
    let e_wellN = cg_bead_pair_energy(ba, bbN, tN, tN, sig_tab, eps_tab, n_types)
    fails = fails + _ck("(c) LJ well N–N == −ε (ε=2.99)", e_wellN, -eps_NN, tf)

    // ── CHECK (b) — E_CG FLOW into R5 three-scale total ─────────────────────
    // A 3-bead CG system (P, N, Q). E_CG = pair(0,1)+pair(0,2)+pair(1,2), each via
    // the table-parameterised LJ. Then feed it into the R5 three-scale total and
    // confirm the total == (E_QM+E_MM+couplings) + (computed E_CG) EXACTLY.
    let bead_pos = [0.0, 0.0, 0.0,
                    0.55, 0.0, 0.0,
                    0.0, 0.62, 0.0]
    let bead_types = [tP, tN, tQ]
    let e_cg = cg_martini_energy(bead_pos, bead_types, sig_tab, eps_tab, n_types)
    // hand E_CG = Σ of the three table-parameterised pairs (independent recompute)
    let p0 = [0.0, 0.0, 0.0]
    let p1 = [0.55, 0.0, 0.0]
    let p2 = [0.0, 0.62, 0.0]
    let e01 = cg_bead_pair_energy(p0, p1, tP, tN, sig_tab, eps_tab, n_types)
    let e02 = cg_bead_pair_energy(p0, p2, tP, tQ, sig_tab, eps_tab, n_types)
    let e12 = cg_bead_pair_energy(p1, p2, tN, tQ, sig_tab, eps_tab, n_types)
    let e_cg_hand = e01 + e02 + e12
    println("E_CG (3-bead sum) = " + to_string(e_cg) + "  hand = " + to_string(e_cg_hand))
    fails = fails + _ck("(b) E_CG == Σ_{a<b} bead-pair LJ (real sum)", e_cg, e_cg_hand, t9)
    // wire into R5 three-scale total
    let e_qm = -10.5
    let e_mm = -4.2
    let e_qm_mm = 0.7
    let e_mm_cg = -0.4
    let e_qm_cg = 0.15
    let e_tot = cg_threescale_total_with_ff(e_qm, e_mm, bead_pos, bead_types,
                                            sig_tab, eps_tab, n_types,
                                            e_qm_mm, e_mm_cg, e_qm_cg)
    // independent witness: R5 generic total with the computed E_CG hand-passed
    let e_tot_ref = cg_threescale_total(e_qm, e_mm, e_cg, e_qm_mm, e_mm_cg, e_qm_cg)
    println("E_tot (3-scale w/ real E_CG) = " + to_string(e_tot))
    fails = fails + _ck("(b) real E_CG flows into R5 total (== R5 generic w/ computed E_CG)",
                        e_tot, e_tot_ref, t9)
    // and the total minus the non-CG terms == E_CG exactly (no double-count)
    let non_cg = e_qm + e_mm + e_qm_mm + e_mm_cg + e_qm_cg
    fails = fails + _ck("(b) E_tot − non-CG terms == E_CG (additive, flows cleanly)",
                        e_tot - non_cg, e_cg, t9)

    // ── CHECK (d) — COMBINING RULE (Lorentz-Berthelot self-consistency) ─────
    // MARTINI normally TABLES σ_ab/ε_ab (exercised above); LB is the auxiliary
    // rule. On the DIAGONAL it must reproduce the self terms exactly:
    //   σ_aa = ½(σ_aa+σ_aa) = σ_aa ,  ε_aa = √(ε_aa·ε_aa) = ε_aa.
    let lb_sig_PP = cg_lb_sigma(sig_PP, sig_PP)
    let lb_eps_PP = cg_lb_eps(eps_PP, eps_PP)
    fails = fails + _ck("(d) LB σ on diagonal == σ_PP", lb_sig_PP, sig_PP, t9)
    fails = fails + _ck("(d) LB ε on diagonal == ε_PP", lb_eps_PP, eps_PP, tf)
    // off-diagonal LB is a well-defined mix (sanity: between the two self values).
    // σ_PC LB = ½(σ_PP+σ_CC); ε_PC LB = √(ε_PP·ε_CC). Both finite, σ exact (equal σ).
    let sig_CC = cg_ff_sigma(tC, tC, sig_tab, n_types)
    let eps_CC = cg_ff_eps(tC, tC, eps_tab, n_types)
    let lb_sig_PC = cg_lb_sigma(sig_PP, sig_CC)
    let lb_eps_PC = cg_lb_eps(eps_PP, eps_CC)
    // since all σ equal (0.47), LB σ_PC == 0.47 exactly
    fails = fails + _ck("(d) LB σ_PC == 0.47 (uniform size)", lb_sig_PC, 0.47, t9)
    // ε LB = √(3.50·3.50) = 3.50 (eps_CC = 3.50 here) — check against hand sqrt
    let eps_PC_lb_ref = sqrt(eps_PP * eps_CC)
    fails = fails + _ck("(d) LB ε_PC == √(ε_PP·ε_CC)", lb_eps_PC, eps_PC_lb_ref, t9)

    if fails == 0 {
        println("cg_martini_ff_selftest PASS")
    } else {
        println("cg_martini_ff_selftest FAIL — " + to_string(fails) + " case(s)")
    }
}
