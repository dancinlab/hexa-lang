// HEXA Standard Library — qforge/smearing
//
// @version 0.1.0
// @capabilities [pure]
//
// QFORGE M5.8① — FRACTIONAL Fermi-Dirac occupations + an E_F-by-bisection solver.
//
// The SCF driver (scf.hexa) fills nelec electrons with FIXED INTEGER closed-shell
// occupation (2e per state, lowest-first). For a METAL (CaH6) bands straddle the
// Fermi level E_F, so the integer fill SWAPS which band is occupied between SCF
// iterations whenever two near-E_F eigenvalues cross → ρ jumps → a charge-sloshing
// limit cycle (the M5.7 PR3 residual: pinned ~0.83–1.7, no decrease).
//
// The textbook fix is to give each state a FRACTIONAL occupation set by a smooth
// occupation function f((ε−E_F)/σ) of width σ, with E_F fixed by charge
// conservation Σ_k f_k·(spin) = nelec. Then a band crossing E_F changes occupation
// CONTINUOUSLY (no discrete swap) and ρ varies smoothly with ε → the limit cycle
// is removed. This brick supplies:
//
//   · qforge_fermi_dirac(eps, ef, sigma)   — f(ε) = 1/(1+exp((ε−E_F)/σ))      (∈[0,1])
//   · qforge_occ_sum(evals, ef, sigma, sd) — Σ_k spin_deg·f(ε_k)               (electron count)
//   · qforge_fermi_level(evals, nelec, sigma, spin_deg) — E_F by BISECTION so
//        Σ spin_deg·f(ε_k) == nelec to tolerance.
//   · qforge_fermi_occupations(...)        — the per-band occupation VECTOR
//        spin_deg·f(ε_k − E_F) (the fractional analogue of scf_occupations).
//
// ── σ→0 INSULATOR / backward-compat limit (d6) ───────────────────────────────
//   As σ→0, f → a step: 1 below E_F, 0 above, ½ exactly at E_F. For a gapped
//   spectrum with E_F placed inside the gap the fractional occupations RECOVER the
//   integer fill EXACTLY — so an insulator (or σ=0) reproduces scf_occupations.
//   This is the property that lets M5.8 stay a no-regression opt-in (the driver
//   keeps the integer path when smearing is disabled).
//
// reuse (d19): builtin `exp` (used across qforge/correlation, qforge/elph). The
//   bisection is plain numerics — no new dependency.

// ── Fermi-Dirac occupation of a single state (per spin channel) ──────────────
//   f(ε) = 1 / (1 + exp((ε − E_F)/σ)) ∈ (0,1).  σ in the SAME energy unit as ε
//   (the SCF carries Hartree). The exp argument is clamped to avoid overflow on
//   states far from E_F (f→1 or f→0 then, the correct limits).
pub fn qforge_fermi_dirac(eps: float, ef: float, sigma: float) -> float {
    if sigma <= 0.0 {
        // σ=0 step limit: below → 1, above → 0, exactly at → ½.
        if eps < ef { return 1.0 }
        if eps > ef { return 0.0 }
        return 0.5
    }
    let x = (eps - ef) / sigma
    if x > 40.0 { return 0.0 }       // exp(40)≈2.4e17 → f≈0 (state well above E_F)
    if x < -40.0 { return 1.0 }      // exp(−40)≈0 → f≈1 (state well below E_F)
    return 1.0 / (1.0 + exp(x))
}

// ── total electron count Σ_k spin_deg·f(ε_k) at a trial E_F ──────────────────
//   spin_deg = 2.0 for spin-degenerate (closed-shell) bands, 1.0 for spin-resolved.
pub fn qforge_occ_sum(evals: [float], ef: float, sigma: float,
                      spin_deg: float) -> float {
    let n = len(evals)
    let mut s = 0.0
    let mut k = 0
    while k < n {
        s = s + spin_deg * qforge_fermi_dirac(evals[k], ef, sigma)
        k = k + 1
    }
    return s
}

// ── E_F by BISECTION so Σ spin_deg·f(ε_k) == nelec ───────────────────────────
//   The occupation sum is MONOTONE DECREASING in E_F? No — f is INCREASING in E_F
//   (raising E_F occupies more states), so Σ f(ε_k) is monotone INCREASING in E_F.
//   Bisection brackets E_F between [ε_min − pad, ε_max + pad] (where the sum is 0
//   and N_max·spin respectively) and halves until the count matches nelec to tol.
//   Returns the converged E_F.  Robust: a flat (degenerate) spectrum still
//   brackets because the pad pushes the sum past nelec at the top end.
pub fn qforge_fermi_level(evals: [float], nelec: int, sigma: float,
                          spin_deg: float) -> float {
    let n = len(evals)
    if n == 0 { return 0.0 }   // empty spectrum → no Fermi level (avoid evals[0] OOB)
    let target = to_float(nelec)
    // bracket: lo below all states (sum→0), hi above all states (sum→N·spin).
    let mut lo = evals[0]
    let mut hi = evals[0]
    let mut k = 1
    while k < n {
        if evals[k] < lo { lo = evals[k] }
        if evals[k] > hi { hi = evals[k] }
        k = k + 1
    }
    // pad the bracket by max(10σ, span) so the endpoints truly straddle the target.
    let span = hi - lo
    let mut pad = 10.0 * sigma
    if span > pad { pad = span }
    if pad < 1.0 { pad = 1.0 }
    lo = lo - pad
    hi = hi + pad
    // bisection: ~60 halvings → ef to ~(span)·2^-60 (machine precision on the count).
    let mut it = 0
    while it < 100 {
        let mid = 0.5 * (lo + hi)
        let cnt = qforge_occ_sum(evals, mid, sigma, spin_deg)
        // sum increasing in E_F: too many electrons → lower E_F; too few → raise it.
        if cnt > target { hi = mid } else { lo = mid }
        // tight enough on the bracket → done.
        if (hi - lo) < 1.0e-12 { break }
        it = it + 1
    }
    return 0.5 * (lo + hi)
}

// ── WEIGHTED occupation count Σ_i w_i·f(ε_i−E_F) (k-mesh BZ integration) ──────
//   For a k-mesh spin SCF: flatten ALL (k,spin,band) eigenvalues into `evals` with a
//   parallel `weights` array (w_i = the k-point weight of entry i; each spin channel
//   carries weight 1, so w_i = w_k). One shared E_F counts the BZ-integrated charge.
pub fn qforge_occ_sum_weighted(evals: [float], weights: [float], ef: float, sigma: float) -> float {
    let n = len(evals)
    let mut s = 0.0
    let mut k = 0
    while k < n { s = s + weights[k] * qforge_fermi_dirac(evals[k], ef, sigma) ; k = k + 1 }
    return s
}

// ── shared E_F by bisection so Σ_i w_i·f(ε_i) == nelec (k-mesh, all k+spin) ────
//   Same bracket/iteration logic as qforge_fermi_level, over the weighted multi-set.
//   The per-STATE occupation is then f(ε−E_F) (unweighted); the w_k multiplies that
//   k-point's contribution to ρ in the density sum (caller).
pub fn qforge_fermi_level_weighted(evals: [float], weights: [float], nelec: int, sigma: float) -> float {
    let n = len(evals)
    if n == 0 { return 0.0 }   // empty spectrum → no Fermi level (avoid evals[0] OOB)
    let target = to_float(nelec)
    let mut lo = evals[0]
    let mut hi = evals[0]
    let mut k = 1
    while k < n {
        if evals[k] < lo { lo = evals[k] }
        if evals[k] > hi { hi = evals[k] }
        k = k + 1
    }
    let span = hi - lo
    let mut pad = 10.0 * sigma
    if span > pad { pad = span }
    if pad < 1.0 { pad = 1.0 }
    lo = lo - pad
    hi = hi + pad
    let mut it = 0
    while it < 100 {
        let mid = 0.5 * (lo + hi)
        let cnt = qforge_occ_sum_weighted(evals, weights, mid, sigma)
        if cnt > target { hi = mid } else { lo = mid }
        if (hi - lo) < 1.0e-12 { break }
        it = it + 1
    }
    return 0.5 * (lo + hi)
}

// ── smearing entropy S = −Σ_k [ f̃ ln f̃ + (1−f̃) ln(1−f̃) ] (per spin channel) ─
//   The Mermin finite-T entropy of the Fermi-Dirac occupations. occ_k carries the
//   spin-degenerate occupation (spin_deg·f̃, f̃ ∈ [0,1] the per-channel filling);
//   the entropy is computed on the PER-CHANNEL f̃ = occ_k/spin_deg and re-scaled by
//   spin_deg (each of the spin_deg degenerate channels contributes the same S_k).
//
//   WHY THIS EXISTS (the CaH6 basis-instability fix): the bare band-energy sum
//   Σ occ_k·ε_k is NOT a variational functional once occupations are FRACTIONAL —
//   only the MERMIN FREE ENERGY  F = Σ occ_k·ε_k − σ·S  is stationary at the SCF
//   fixed point and MONOTONE-DECREASING in the basis size (Rayleigh-Ritz on ε plus
//   a continuous, basis-smooth entropy). qforge_scf_smeared reports F (not the bare
//   sum) so etot CONVERGES MONOTONICALLY with NPW (the −13→−18→−37 Ry CaH6 scatter
//   is the bare-sum artifact). S ≥ 0; a fully-occupied/empty state contributes 0.
//
//   The −x·ln(x) terms are evaluated with the x→0 limit x·ln(x)→0 (a state pinned
//   at f̃=0 or f̃=1 has zero entropy) so the sum is finite for any occupation set.
pub fn qforge_smearing_entropy(occ: [float], spin_deg: float) -> float {
    let mut sd = spin_deg
    if sd <= 0.0 { sd = 2.0 }
    let n = len(occ)
    let mut s = 0.0
    let mut k = 0
    while k < n {
        let f = occ[k] / sd                              // per-channel filling f̃ ∈ [0,1]
        // x·ln(x) with the x→0 limit = 0 (clamp tiny/edge values out of the log).
        if f > 1.0e-12 && f < 1.0 - 1.0e-12 {
            s = s + sd * (-1.0 * (f * log(f) + (1.0 - f) * log(1.0 - f)))
        }
        k = k + 1
    }
    return s
}

// ── per-band fractional occupation vector occ_k = spin_deg·f(ε_k − E_F) ───────
//   The fractional analogue of scf_occupations. Solves E_F internally so the
//   returned vector sums (Σ occ_k) to nelec to bisection tolerance. nbands is the
//   number of computed bands; evals must be at least nbands long.
pub fn qforge_fermi_occupations(evals: [float], nbands: int, nelec: int,
                                sigma: float, spin_deg: float) -> [float] {
    // build the band-restricted spectrum the E_F solve sees (lowest nbands).
    let mut sp: [float] = []
    let mut k = 0
    while k < nbands { sp.push(evals[k]) ; k = k + 1 }
    let ef = qforge_fermi_level(sp, nelec, sigma, spin_deg)
    let mut occ: [float] = []
    k = 0
    while k < nbands {
        occ.push(spin_deg * qforge_fermi_dirac(evals[k], ef, sigma))
        k = k + 1
    }
    return occ
}

// ══ SPIN-POLARIZED (LSDA / nspin=2) — SHARED-E_F two-channel occupation ═══════
//
// QFORGE handoff bb095261 (CoSn magnetic kagome, nspin=2). A spin-polarized system
// carries TWO eigenvalue spectra ε_up_k and ε_dn_k that are NOT equal (exchange
// splits the channels). Both channels share ONE common Fermi level E_F (the chemical
// potential is a single scalar for the whole cell — electrons flow freely between
// spin channels until a single E_F equalizes). Each channel has spin_deg=1 (a
// spin-resolved band holds ONE electron per state, not two), so the combined count
// is Σ_k f(ε_up_k − E_F) + Σ_k f(ε_dn_k − E_F) == nelec.
//
//   NON-MAGNETIC LIMIT (the regression pin): when ε_up == ε_dn the two unit-weight
//   channels at identical evals are EXACTLY one channel of weight 2 — so
//   qforge_fermi_level_spin(E,E,nelec,σ) == qforge_fermi_level(E,nelec,σ,2.0) and the
//   summed occupation equals the spin_deg=2 restricted result. This is the additive,
//   regression-safe property: the restricted path is a special case of the shared-E_F
//   spin path, never modified by it.
//
// reuse (d19): qforge_fermi_dirac (the single-state f), the SAME bracket/iteration
//   logic as qforge_fermi_level (60→100 halvings, 1e-12 bracket tol) over the
//   combined two-channel count. No new numerics.

// ── combined two-channel count Σ f(ε_up_k − E_F) + Σ f(ε_dn_k − E_F) at trial E_F ─
//   Each channel weight 1 (spin-resolved), ONE shared E_F. The non-magnetic case
//   evals_up==evals_dn gives 2·Σ f(ε_k) == the spin_deg=2 qforge_occ_sum.
pub fn qforge_occ_sum_spin(evals_up: [float], evals_dn: [float], ef: float,
                           sigma: float) -> float {
    let mut s = 0.0
    let nu = len(evals_up)
    let mut k = 0
    while k < nu {
        s = s + qforge_fermi_dirac(evals_up[k], ef, sigma)
        k = k + 1
    }
    let nd = len(evals_dn)
    k = 0
    while k < nd {
        s = s + qforge_fermi_dirac(evals_dn[k], ef, sigma)
        k = k + 1
    }
    return s
}

// ── single SHARED E_F by BISECTION so the combined two-channel count == nelec ──
//   Mirrors qforge_fermi_level EXACTLY (same bracket expansion, same 100-iter cap,
//   same 1e-12 bracket tol) over Σf_up + Σf_down. The bracket lo/hi straddle the
//   MIN/MAX over BOTH eval arrays (so the endpoints truly bound every state in both
//   channels). The combined sum is monotone INCREASING in E_F (each f is), so the
//   identical "too many → lower, too few → raise" bisection invariant holds.
pub fn qforge_fermi_level_spin(evals_up: [float], evals_dn: [float], nelec: int,
                               sigma: float) -> float {
    let target = to_float(nelec)
    // bracket: lo below all states (sum→0), hi above all states (sum→(N_up+N_dn)).
    // initialise from the first available eigenvalue across both channels.
    let nu = len(evals_up)
    let nd = len(evals_dn)
    if nu == 0 && nd == 0 { return 0.0 }   // both spin channels empty → evals_dn[0] OOB
    let mut lo = 0.0
    let mut hi = 0.0
    if nu > 0 { lo = evals_up[0] ; hi = evals_up[0] }
    else { lo = evals_dn[0] ; hi = evals_dn[0] }
    let mut k = 0
    while k < nu {
        if evals_up[k] < lo { lo = evals_up[k] }
        if evals_up[k] > hi { hi = evals_up[k] }
        k = k + 1
    }
    k = 0
    while k < nd {
        if evals_dn[k] < lo { lo = evals_dn[k] }
        if evals_dn[k] > hi { hi = evals_dn[k] }
        k = k + 1
    }
    // pad the bracket by max(10σ, span) so the endpoints truly straddle the target.
    let span = hi - lo
    let mut pad = 10.0 * sigma
    if span > pad { pad = span }
    if pad < 1.0 { pad = 1.0 }
    lo = lo - pad
    hi = hi + pad
    // bisection: ~60 halvings → ef to ~(span)·2^-60 (machine precision on the count).
    let mut it = 0
    while it < 100 {
        let mid = 0.5 * (lo + hi)
        let cnt = qforge_occ_sum_spin(evals_up, evals_dn, mid, sigma)
        // sum increasing in E_F: too many electrons → lower E_F; too few → raise it.
        if cnt > target { hi = mid } else { lo = mid }
        // tight enough on the bracket → done.
        if (hi - lo) < 1.0e-12 { break }
        it = it + 1
    }
    return 0.5 * (lo + hi)
}

// ── per-channel occupation vectors [occ_up, occ_dn], occ_σk = f(ε_σk − E_F) ────
//   Solves the single SHARED E_F internally (qforge_fermi_level_spin) so the two
//   returned vectors TOGETHER sum (Σ occ_up + Σ occ_dn) to nelec. Each occ_σk is a
//   spin-resolved (weight-1) Fermi-Dirac occupation ∈ [0,1].
pub fn qforge_fermi_occupations_spin(evals_up: [float], evals_dn: [float],
                                     nelec: int, sigma: float) -> [[float]] {
    let ef = qforge_fermi_level_spin(evals_up, evals_dn, nelec, sigma)
    let mut occ_up: [float] = []
    let nu = len(evals_up)
    let mut k = 0
    while k < nu {
        occ_up.push(qforge_fermi_dirac(evals_up[k], ef, sigma))
        k = k + 1
    }
    let mut occ_dn: [float] = []
    let nd = len(evals_dn)
    k = 0
    while k < nd {
        occ_dn.push(qforge_fermi_dirac(evals_dn[k], ef, sigma))
        k = k + 1
    }
    return [occ_up, occ_dn]
}

// ── net magnetization m = Σ occ_up − Σ occ_dn (μ_B per cell) ──────────────────
//   The cell's net spin moment: the excess of spin-up over spin-down occupation.
//   m=0 for a non-magnetic system (occ_up==occ_dn), m>0 for a majority-up cell.
pub fn qforge_magnetization(occ_up: [float], occ_dn: [float]) -> float {
    let mut su = 0.0
    let nu = len(occ_up)
    let mut k = 0
    while k < nu { su = su + occ_up[k] ; k = k + 1 }
    let mut sd = 0.0
    let nd = len(occ_dn)
    k = 0
    while k < nd { sd = sd + occ_dn[k] ; k = k + 1 }
    return su - sd
}
