// Tiny probe: recover Miller indices for the REAL CaH6 reciprocal basis using a
// SMALL npw_cap (fast — no full SCF). Loads geom only via a light front-end path is
// too slow, so we hardcode-read the deck geometry through qforge_pw_frontend at a
// TINY npw_cap=8 (fast SCF) and dump b1/b2/b3 + sample G→Miller. Localizes the
// grid=1x1x1 (hmax=0) bug.

use "stdlib/qforge/pw_frontend"
use "stdlib/qforge/screening_pwfft"

fn main() {
    let av = args()
    let deck = if len(av) > 1 { av[1] } else {
        "/Users/mini/dancinlab/demiurge/exports/rtsc/decks/CaH6_NC" }
    // tiny npw_cap → fast SCF, just to recover geom.b1/b2/b3 + gvecs.
    let fe = qforge_pw_frontend(deck, 32, 1, 0.02, 1236.4)
    if !fe.ok { println("DEFER: " + fe.error) ; return }
    let geom = fe.geom
    println("b1=[" + to_string(geom.b1[0]) + "," + to_string(geom.b1[1]) + "," + to_string(geom.b1[2]) + "]")
    println("b2=[" + to_string(geom.b2[0]) + "," + to_string(geom.b2[1]) + "," + to_string(geom.b2[2]) + "]")
    println("b3=[" + to_string(geom.b3[0]) + "," + to_string(geom.b3[1]) + "," + to_string(geom.b3[2]) + "]")
    let ecut_ha = if geom.ecutwfc > 0.0 { 0.5 * geom.ecutwfc } else { 0.0 }
    let gvecs = qpw_gvectors(geom.b1, geom.b2, geom.b3, ecut_ha, 4, 32)
    let n = len(gvecs) / 3
    println("n(gvecs)=" + to_string(n))
    let mut i = 0
    while i < n && i < 12 {
        let gx = gvecs[i*3] ; let gy = gvecs[i*3+1] ; let gz = gvecs[i*3+2]
        let m = qpwfft_miller(gx, gy, gz, geom.b1, geom.b2, geom.b3)
        println("G[" + to_string(i) + "]=(" + to_string(gx) + "," + to_string(gy) + "," + to_string(gz)
            + ")  Miller=(" + to_string(m[0]) + "," + to_string(m[1]) + "," + to_string(m[2]) + ")")
        i = i + 1
    }
}
