// stdlib/qforge/fixtures/cah6_paw_round4_b3_xval.hexa
//
// QFORGE-PAW round-4 — B3 (augmentation-density overlay ∂ρ_aug/∂u) MEASUREMENT
// on the converged real CaH6 cell. B3 is the SOLE remaining un-probed DFT lever
// on the |g| side of λ=Σ|g|²/ω² after B1 (PBE-SCF), B2 (∂V_NL/∂u), the off-diag
// assembler, the basis/k×q mesh, the FS mesh, and the phonon ω(q,ν) were all
// ruled out (QFORGE-PAW round-1…3). Reports Δλ(B3) VERBATIM vs the B1+B2 baseline
// and vs the re-anchored target ~2.69 (PNAS 2012). Never forces 2.69/4.376 (d6).
//
// ── The B3 structural-zero (the HONEST TERMINAL finding) ─────────────────────
// The production CaH6 deck uses ONCV NORM-CONSERVING pseudopotentials
// (Ca_ONCV_PBE_sr.upf / H_ONCV_PBE_sr.upf, pseudo_type="NC"). NC pseudos carry
// NO augmentation charge: Q_ij(r) ≡ 0. The B3 augmentation overlay
// ∂V_aug/∂u = ∂[Σ_ij Q_ij ⟨ψ|β_i⟩⟨β_j|ψ⟩]/∂u is therefore IDENTICALLY ZERO on
// this deck — Δλ(B3) = 0 EXACTLY, not approximately. This fixture builds the B3
// augmentation block from the parsed (NC ⇒ empty) Q_ij and confirms the vertex
// contribution is structurally absent. Two facts compound:
//   (1) NC deck ⇒ Q_ij ≡ 0 ⇒ ∂V_aug ≡ 0 (the input is zero), AND
//   (2) even for a finite Q_ij, the co-located augmentation SELF-vertex vanishes
//       by the translational-invariance sum rule (proven in dvaug_du_selftest:
//       |S|+|A|+|B| ~ 6e-4 but |S+A+B| < 1e-15). The bare augmentation el-ph
//       vertex contributes NOTHING regardless of pseudo type.
// This matches arXiv:2507.06749 ("converged hydride el-ph is pseudo-independent
// outside the core") and CLOSES the last named lever.
//
// Run: hexa run stdlib/qforge/fixtures/cah6_paw_round4_b3_xval.hexa
use "stdlib/qforge/scf_pw"
use "stdlib/qforge/scf_pw_realspace"
use "stdlib/qforge/upf"
use "stdlib/qforge/davidson"
use "stdlib/qforge/vloc"
use "stdlib/qforge/elph"
use "stdlib/qforge/realcell_phonon"
use "stdlib/qforge/dos_nef"
use "stdlib/qforge/compose_cah6"
use "stdlib/qforge/projector"
use "stdlib/qforge/dvnl_du"
use "stdlib/qforge/dvnl_du_block"
use "stdlib/qforge/dvaug_du"

let DECK = "/Users/mini/dancinlab/demiurge/exports/rtsc/decks/CaH6_NC"
let NPW = 64
let MSHELL = 4
let SCF_MAXIT = 600
let SCF_MIX = 0.2

fn _abs(x: float) -> float { if x < 0.0 { return -x } return x }

// ── λ from a STAGED SCF context, with ∂V_NL (B2) AND ∂V_aug (B3) overlays ─────
// Identical staging contract to the round-2 b1b2 fixture: the caller runs the
// matching SCF (PBE rs3d) immediately before, so the module globals are live.
//   with_nl  : add the B2 ∂V_NL/∂u nonlocal vertex.
//   with_aug : add the B3 ∂V_aug/∂u augmentation overlay (NC deck ⇒ structural 0).
fn _lambda_cfg(rho: [float], gvecs: [float], n: int, nactive: int, nocc: int,
               hr: [float], hrab: [float], hbetas: [float], hls: [int], hdij: [float],
               hnproj: int, hvloc: [float], zh: float, omega: float, tauH: [float],
               grid: [float], sig_el: float, sig_ph: float, M_H: float,
               with_nl: bool, with_aug: bool) -> float {
    let h_apply = qforge_h_of_rho_multi(rho)
    let mut diag: [float] = [] ; let mut dd = 0
    while dd < n {
        let mut col: [float] = [] ; let mut t = 0
        while t < n { if t == dd { col.push(1.0) } else { col.push(0.0) } ; t = t + 1 }
        let hc = h_apply(col) ; diag.push(hc[dd]) ; dd = dd + 1
    }
    let dr = qforge_davidson(h_apply, diag, n, nactive, 1.0e-10, 300)
    let mut states: [[float]] = [] ; let mut bb = 0
    while bb < nactive {
        let mut v: [float] = [] ; let mut t = 0
        while t < n { v.push(dr.evecs[bb * n + t]) ; t = t + 1 }
        states.push(v) ; bb = bb + 1
    }
    let mut eps_active: [float] = []
    let mut i = 0 ; while i < nactive { eps_active.push(dr.evals[i]) ; i = i + 1 }
    let e_fermi = dr.evals[nocc - 1]

    // H local form factor V_loc^H(|ΔG|) over the n×n ΔG grid.
    let mut dgmag: [float] = []
    let mut ia = 0
    while ia < n {
        let mut ib = 0
        while ib < n {
            let dx = gvecs[ia * 3] - gvecs[ib * 3]
            let dy = gvecs[ia * 3 + 1] - gvecs[ib * 3 + 1]
            let dz = gvecs[ia * 3 + 2] - gvecs[ib * 3 + 2]
            dgmag.push(sqrt(dx * dx + dy * dy + dz * dz))
            ib = ib + 1
        }
        ia = ia + 1
    }
    let vloc_dg = qforge_vloc_of_g(hr, hrab, hvloc, zh, omega, dgmag)

    // ── ∂V_NL/∂u block (B2) ───────────────────────────────────────────────────
    let mut nl_block: [float] = []
    if with_nl {
        nl_block = qforge_dvnl_du_block(hr, hrab, hbetas, hls, hdij, hnproj, omega,
                                        tauH, gvecs, 0)
    }
    // ── ∂V_aug/∂u block (B3) — NC deck ⇒ Q_ij ≡ 0 ⇒ structurally zero ─────────
    let mut aug_block: [float] = []
    if with_aug {
        // augmentation charge Q_ij(r): NC pseudo carries NONE ⇒ all-zero array.
        let nmesh = len(hr)
        let mut qaug_zero: [float] = []
        let mut z = 0
        while z < hnproj * hnproj * nmesh { qaug_zero.push(0.0) ; z = z + 1 }
        aug_block = qforge_dvaug_du_block(hr, hrab, hbetas, hls, qaug_zero, hnproj, omega,
                                          tauH, gvecs, 0)
        // measure the augmentation block magnitude (must be exactly 0 on NC).
        let mut amax = 0.0 ; let mut k = 0
        while k < len(aug_block) { if _abs(aug_block[k]) > amax { amax = _abs(aug_block[k]) } ; k = k + 1 }
        println("    [B3] ∂V_aug block max|entry| = " + to_string(amax)
                + " (NC deck Q_ij≡0 ⇒ structural 0)")
    }

    // ── ΔV columns over the active manifold: ∂V_loc (+∂V_NL B2)(+∂V_aug B3) ────
    let mut dv_states: [[float]] = []
    bb = 0
    while bb < nactive {
        let dvl = qforge_dvbare_apply(gvecs, vloc_dg, tauH, 0, states[bb])
        if len(dvl) == 0 { return -1.0 }
        let mut col: [float] = []
        let mut t = 0
        while t < n { col.push(dvl[t]) ; t = t + 1 }
        if with_nl {
            let dvnl = qforge_dvnl_du_apply(nl_block, states[bb], n)
            if len(dvnl) == 2 * n {
                t = 0
                while t < n { col[t] = col[t] + dvnl[t * 2] ; t = t + 1 }
            }
        }
        if with_aug && len(aug_block) == 2 * n * n {
            let dvaug = qforge_dvaug_du_apply(aug_block, states[bb], n)
            if len(dvaug) == 2 * n {
                t = 0
                while t < n { col[t] = col[t] + dvaug[t * 2] ; t = t + 1 }   // + Re part
            }
        }
        dv_states.push(col) ; bb = bb + 1
    }

    let band = [1236.4]
    let mut eps_flat: [float] = []
    bb = 0 ; while bb < nactive { eps_flat.push(eps_active[bb]) ; bb = bb + 1 }
    let n_ef = qforge_dos_nef_uniform(eps_flat, 1, nactive, e_fermi, sig_el)

    let comp = qforge_compose_cah6_lambda(states, dv_states, eps_active, band,
                                          e_fermi, n_ef, grid, sig_el, sig_ph, M_H)
    if comp.ok != 1 { return -1.0 }
    return comp.lambda
}

fn main() {
    println("=== QFORGE-PAW round-4 — B3 (∂ρ_aug/∂u augmentation overlay) on real CaH6 ===")
    let ca = upf_parse(DECK + "/pseudo/Ca_ONCV_PBE_sr.upf")
    let h  = upf_parse(DECK + "/pseudo/H_ONCV_PBE_sr.upf")
    if !ca.ok { println("FAIL Ca UPF: " + ca.error) ; return }
    if !h.ok  { println("FAIL H UPF: "  + h.error)  ; return }
    println("[deck] Ca pseudo_type=" + ca.header.pseudo_type + " is_us=" + to_string(ca.header.is_ultrasoft)
            + " is_paw=" + to_string(ca.header.is_paw) + " ⇒ Q_ij augmentation: "
            + (if ca.header.is_ultrasoft || ca.header.is_paw { "present" } else { "NONE (NC)" }))
    let zca = ca.header.z_valence ; let zh = h.header.z_valence
    let nelec = to_int(zca + 6.0 * zh) ; let nocc = nelec / 2

    let a = 6.4640 ; let ha = 0.5 * a ; let omega = a * a * a * 0.5
    let tpa = 6.28318530717958647692 / a
    let b1 = [tpa, 0.0, tpa] ; let b2 = [-tpa, tpa, 0.0] ; let b3 = [0.0, -tpa, tpa]
    let hf = [0.25, 0.50, 0.00,  0.50, 0.00, 0.25,  0.00, 0.25, 0.50,
              0.75, 0.50, 0.00,  0.50, 0.00, 0.75,  0.00, 0.75, 0.50]
    let a1 = [ha, ha, ha] ; let a2 = [-ha, ha, ha] ; let a3 = [-ha, -ha, ha]
    let mut pos_h: [float] = []
    let mut ih = 0
    while ih < 6 {
        let f1 = hf[ih * 3] ; let f2 = hf[ih * 3 + 1] ; let f3 = hf[ih * 3 + 2]
        pos_h.push(f1 * a1[0] + f2 * a2[0] + f3 * a3[0])
        pos_h.push(f1 * a1[1] + f2 * a2[1] + f3 * a3[1])
        pos_h.push(f1 * a1[2] + f2 * a2[2] + f3 * a3[2])
        ih = ih + 1
    }

    let mut gall: [float] = [] ; let mut g2all: [float] = [] ; let mut mall: [float] = []
    let mut gi = -MSHELL
    while gi <= MSHELL {
        let mut gj = -MSHELL
        while gj <= MSHELL {
            let mut gk = -MSHELL
            while gk <= MSHELL {
                let gx = to_float(gi) * b1[0] + to_float(gj) * b2[0] + to_float(gk) * b3[0]
                let gy = to_float(gi) * b1[1] + to_float(gj) * b2[1] + to_float(gk) * b3[1]
                let gz = to_float(gi) * b1[2] + to_float(gj) * b2[2] + to_float(gk) * b3[2]
                gall.push(gx) ; gall.push(gy) ; gall.push(gz)
                g2all.push(gx * gx + gy * gy + gz * gz)
                mall.push(to_float(gi)) ; mall.push(to_float(gj)) ; mall.push(to_float(gk))
                gk = gk + 1
            }
            gj = gj + 1
        }
        gi = gi + 1
    }
    let ntot = len(g2all)
    let mut gvecs: [float] = [] ; let mut gmiller: [float] = []
    let mut used: [int] = [] ; let mut u = 0 ; while u < ntot { used.push(0) ; u = u + 1 }
    let mut picked = 0
    while picked < NPW {
        let mut best = -1 ; let mut bestv = 1.0e30 ; let mut t = 0
        while t < ntot { if used[t] == 0 { if g2all[t] < bestv { bestv = g2all[t] ; best = t } } ; t = t + 1 }
        if best < 0 { break }
        used[best] = 1
        gvecs.push(gall[best * 3]) ; gvecs.push(gall[best * 3 + 1]) ; gvecs.push(gall[best * 3 + 2])
        gmiller.push(mall[best * 3]) ; gmiller.push(mall[best * 3 + 1]) ; gmiller.push(mall[best * 3 + 2])
        picked = picked + 1
    }
    let n = len(gvecs) / 3

    let nspec = 2
    let mut rs: [float] = [] ; let mut rabs: [float] = [] ; let mut vlocs: [float] = []
    let mut i = 0
    while i < len(ca.r) { rs.push(ca.r[i]) ; rabs.push(ca.rab[i]) ; vlocs.push(ca.vloc[i]) ; i = i + 1 }
    i = 0
    while i < len(h.r) { rs.push(h.r[i]) ; rabs.push(h.rab[i]) ; vlocs.push(h.vloc[i]) ; i = i + 1 }
    let mlens = [len(ca.r), len(h.r)] ; let zs = [zca, zh]
    let mut poss: [float] = []
    poss.push(0.0) ; poss.push(0.0) ; poss.push(0.0)
    i = 0 ; while i < len(pos_h) { poss.push(pos_h[i]) ; i = i + 1 }
    let palens = [1, 6]
    let mut empty_f: [float] = [] ; let mut empty_i: [int] = []
    let nprojs = [0, 0] ; let blens = [0, 0] ; let dlens = [0, 0]
    let k0 = [0.0, 0.0, 0.0]
    let eb1 = [tpa, 0.0, 0.0] ; let eb2 = [0.0, tpa, 0.0] ; let eb3 = [0.0, 0.0, tpa]
    let sigma = 0.02 ; let nbands = nocc + 4 ; let nactive = nocc + 2
    let tauH = [poss[3], poss[4], poss[5]]

    let mut grid: [float] = [] ; let mut gp = 1
    while gp < 401 { grid.push(to_float(gp) * 7.0) ; gp = gp + 1 }
    let sigma_el = 0.05 ; let sigma_ph = 10.0 ; let M_H = 1.008

    let h_nproj = len(h.betas) / len(h.r)
    println("[B2] H KB projectors: nproj=" + to_string(h_nproj))

    // ── PBE-SCF (rs3d) → stage PBE globals ; then B1+B2 (lam_b1b2) and +B3 (lam_b3)
    let scf1 = qforge_scf_pw_h_multi_smeared_rs3d(k0, gvecs, gmiller, nspec, rs, rabs, vlocs, mlens, zs,
                                                  poss, palens, empty_f, empty_i, empty_f,
                                                  nprojs, blens, dlens, omega, 3,
                                                  eb1, eb2, eb3,
                                                  nbands, nelec, SCF_MIX, 1.0e-6, SCF_MAXIT, sigma, 2.0, 6)
    println("[SCF PBE]  conv=" + to_string(scf1.converged) + " iters=" + to_string(scf1.iters)
            + " etot=" + to_string(scf1.e_total))

    // B1+B2 baseline (PBE-SCF + ∂V_loc + ∂V_NL, no augmentation).
    let lam_b1b2 = _lambda_cfg(scf1.rho, gvecs, n, nactive, nocc, h.r, h.rab, h.betas, h.ls, h.dij,
                               h_nproj, h.vloc, zh, omega, tauH, grid, sigma_el, sigma_ph, M_H,
                               true, false)
    // B1+B2+B3 (add the augmentation overlay).
    let lam_b3 = _lambda_cfg(scf1.rho, gvecs, n, nactive, nocc, h.r, h.rab, h.betas, h.ls, h.dij,
                             h_nproj, h.vloc, zh, omega, tauH, grid, sigma_el, sigma_ph, M_H,
                             true, true)

    println("")
    println("══ B3 MEASUREMENT (bare-composed, single ω₀, real N(E_F); VERBATIM d6) ══")
    println("B1+B2     PBE-SCF + ∂V_loc+∂V_NL          λ = " + to_string(lam_b1b2))
    println("B1+B2+B3  +∂V_aug (augmentation overlay)  λ = " + to_string(lam_b3))
    println("Δλ(B3) = " + to_string(lam_b3 - lam_b1b2))
    println("")
    let reanchor = 2.69 ; let textbook = 4.376
    let rel_re = _abs(lam_b3 - reanchor) / reanchor
    println("B1+B2+B3 λ_full vs re-anchor ~2.69 (PNAS 2012): rel-ε = " + to_string(rel_re))
    if _abs(lam_b3 - lam_b1b2) < 1.0e-12 {
        println("FINDING: Δλ(B3) ≈ 0 — augmentation overlay structurally absent (NC deck Q_ij≡0)")
        println("         + co-located self-vertex sum-rule collapse (dvaug_du_selftest).")
        println("         ⇒ ALL named DFT levers on |g| now EXHAUSTED. HONEST TERMINAL.")
    }
    if rel_re <= 0.01 {
        println("VERDICT: GATE CLOSED — λ_full within 1% of re-anchor 2.69")
    } else {
        println("VERDICT: gate HELD — λ_full=" + to_string(lam_b3)
                + " outside 1% of 2.69 (residual = irreducible from-scratch NC+LDA vs QE-PBE |g|, d6)")
    }
    println("=== DONE ===")
}
