// stdlib/qforge/fixtures/cah6_kmesh_nef_probe.hexa — QFORGE-PERF dense-k N(E_F).
//
// PURPOSE (QFORGE-PERF CaH6 gate, knob #1 — the dominant suspect): the composed
// λ used a Γ-ONLY N(E_F)=19.95. λ ∝ N(E_F); the converged literature λ=2.27 used a
// 96³ k-mesh. This probe converges ρ ONCE at Γ (the heavy SCF), then does a cheap
// NSCF band solve at every Monkhorst-Pack k-point at FIXED ρ, recomputes E_F over
// the FULL mesh (uniform weights → flat-evals Fermi bisection with target nk·nelec),
// and reports N(E_F) vs k-mesh. d6: VERBATIM, NOT tuned. Reuses verified bricks:
//   qforge_mp_grid (mpgrid) · qforge_dos_nef_uniform (dos_nef) · qforge_fermi_level
//   (smearing) · qforge_pwm_set_kvec (scf_pw NSCF setter) · qforge_davidson.
//
// Run: HEXA_STDLIB_ROOT="$PWD/stdlib" hexa run --no-sentinel \
//        stdlib/qforge/fixtures/cah6_kmesh_nef_probe.hexa
// cachebust qforge-perf-kmesh-nef-v1
use "stdlib/qforge/scf_pw"
use "stdlib/qforge/upf"
use "stdlib/qforge/davidson"
use "stdlib/qforge/dos_nef"
use "stdlib/qforge/mpgrid"
use "stdlib/qforge/smearing"

let DECK = "/home/aiden/qf-xval-wt/_deck_CaH6_NC"
let NPW = 64
let MSHELL = 4
let SCF_MAXIT = 600
let SCF_MIX = 0.2

// NSCF band solve at one k-point on the converged ρ. Returns the lowest nb evals.
fn _bands_at_k(kx: float, ky: float, kz: float, rho: [float], n: int, nb: int) -> [float] {
    qforge_pwm_set_kvec([kx, ky, kz])
    let h_apply = qforge_h_of_rho_multi(rho)
    let mut diag: [float] = [] ; let mut dd = 0
    while dd < n {
        let mut col: [float] = [] ; let mut t = 0
        while t < n { if t == dd { col.push(1.0) } else { col.push(0.0) } ; t = t + 1 }
        let hc = h_apply(col) ; diag.push(hc[dd]) ; dd = dd + 1
    }
    let dr = qforge_davidson(h_apply, diag, n, nb, 1.0e-10, 300)
    let mut ev: [float] = [] ; let mut i = 0
    while i < nb { ev.push(dr.evals[i]) ; i = i + 1 }
    return ev
}

// N(E_F) over an MP n1×n2×n3 mesh (Γ-centred, shift=0). Prints the verbatim row.
fn _nef_on_mesh(n1: int, n2: int, n3: int, rho: [float], n: int, nb: int,
                nelec: int, sigma: float) {
    let g = qforge_mp_grid(n1, n2, n3, 0, 0, 0)
    let nk = g.npoints
    let mut eps_flat: [float] = []
    let mut kk = 0
    while kk < nk {
        let kx = g.coords[kk * 3] ; let ky = g.coords[kk * 3 + 1] ; let kz = g.coords[kk * 3 + 2]
        let ev = _bands_at_k(kx, ky, kz, rho, n, nb)
        let mut b = 0 ; while b < nb { eps_flat.push(ev[b]) ; b = b + 1 }
        kk = kk + 1
    }
    // E_F over the full mesh: uniform-weight MP → flat-evals bisection, target nk*nelec.
    let ef = qforge_fermi_level(eps_flat, nk * nelec, sigma, 2.0)
    let nef = qforge_dos_nef_uniform(eps_flat, nk, nb, ef, sigma)
    println("[kmesh " + to_string(n1) + "x" + to_string(n2) + "x" + to_string(n3)
            + "] nk=" + to_string(nk) + " E_F=" + to_string(ef)
            + " N(E_F)=" + to_string(nef))
}

fn main() {
    println("=== QFORGE-PERF CaH6 N(E_F) vs Monkhorst-Pack k-mesh (knob #1) ===")
    let ca = upf_parse(DECK + "/pseudo/Ca_ONCV_PBE_sr.upf")
    let h  = upf_parse(DECK + "/pseudo/H_ONCV_PBE_sr.upf")
    if !ca.ok { println("FAIL Ca UPF: " + ca.error) ; return }
    if !h.ok  { println("FAIL H UPF: "  + h.error)  ; return }
    let zca = ca.header.z_valence ; let zh = h.header.z_valence
    let nelec = to_int(zca + 6.0 * zh) ; let nocc = nelec / 2
    // ── CaH6 BCC cell — correct (PR#2536) recip basis ────────────────────────
    let a = 6.4640 ; let ha = 0.5 * a ; let omega = a * a * a * 0.5
    let tpa = 6.28318530717958647692 / a
    let b1 = [tpa, 0.0, tpa] ; let b2 = [-tpa, tpa, 0.0] ; let b3 = [0.0, -tpa, tpa]
    let hf = [0.25, 0.50, 0.00,  0.50, 0.00, 0.25,  0.00, 0.25, 0.50,
              0.75, 0.50, 0.00,  0.50, 0.00, 0.75,  0.00, 0.75, 0.50]
    let a1 = [ha, ha, ha] ; let a2 = [-ha, ha, ha] ; let a3 = [-ha, -ha, ha]
    let mut pos_h: [float] = []
    let mut ih = 0
    while ih < 6 {
        let f1 = hf[ih * 3] ; let f2 = hf[ih * 3 + 1] ; let f3 = hf[ih * 3 + 2]
        pos_h.push(f1 * a1[0] + f2 * a2[0] + f3 * a3[0])
        pos_h.push(f1 * a1[1] + f2 * a2[1] + f3 * a3[1])
        pos_h.push(f1 * a1[2] + f2 * a2[2] + f3 * a3[2])
        ih = ih + 1
    }
    // ── PW basis: NPW lowest-|G|² ────────────────────────────────────────────
    let mut gall: [float] = [] ; let mut g2all: [float] = []
    let mut gi = -MSHELL
    while gi <= MSHELL {
        let mut gj = -MSHELL
        while gj <= MSHELL {
            let mut gk = -MSHELL
            while gk <= MSHELL {
                let gx = to_float(gi) * b1[0] + to_float(gj) * b2[0] + to_float(gk) * b3[0]
                let gy = to_float(gi) * b1[1] + to_float(gj) * b2[1] + to_float(gk) * b3[1]
                let gz = to_float(gi) * b1[2] + to_float(gj) * b2[2] + to_float(gk) * b3[2]
                gall.push(gx) ; gall.push(gy) ; gall.push(gz)
                g2all.push(gx * gx + gy * gy + gz * gz)
                gk = gk + 1
            }
            gj = gj + 1
        }
        gi = gi + 1
    }
    let ntot = len(g2all)
    let mut gvecs: [float] = []
    let mut used: [int] = [] ; let mut u = 0 ; while u < ntot { used.push(0) ; u = u + 1 }
    let mut picked = 0
    while picked < NPW {
        let mut best = -1 ; let mut bestv = 1.0e30 ; let mut t = 0
        while t < ntot { if used[t] == 0 { if g2all[t] < bestv { bestv = g2all[t] ; best = t } } ; t = t + 1 }
        if best < 0 { break }
        used[best] = 1
        gvecs.push(gall[best * 3]) ; gvecs.push(gall[best * 3 + 1]) ; gvecs.push(gall[best * 3 + 2])
        picked = picked + 1
    }
    let n = len(gvecs) / 3
    // ── multi-species staging + smeared ground-state SCF at Γ (converge ρ) ────
    let nspec = 2
    let mut rs: [float] = [] ; let mut rabs: [float] = [] ; let mut vlocs: [float] = []
    let mut i = 0
    while i < len(ca.r) { rs.push(ca.r[i]) ; rabs.push(ca.rab[i]) ; vlocs.push(ca.vloc[i]) ; i = i + 1 }
    i = 0
    while i < len(h.r) { rs.push(h.r[i]) ; rabs.push(h.rab[i]) ; vlocs.push(h.vloc[i]) ; i = i + 1 }
    let mlens = [len(ca.r), len(h.r)] ; let zs = [zca, zh]
    let mut poss: [float] = []
    poss.push(0.0) ; poss.push(0.0) ; poss.push(0.0)
    i = 0 ; while i < len(pos_h) { poss.push(pos_h[i]) ; i = i + 1 }
    let palens = [1, 6]
    let mut empty_f: [float] = [] ; let mut empty_i: [int] = []
    let nprojs = [0, 0] ; let blens = [0, 0] ; let dlens = [0, 0]
    let k0 = [0.0, 0.0, 0.0] ; let xc_mode = 1
    let eb1 = [tpa, 0.0, 0.0] ; let eb2 = [0.0, tpa, 0.0] ; let eb3 = [0.0, 0.0, tpa]
    let sigma = 0.02 ; let nbands = nocc + 4
    let scf = qforge_scf_pw_h_multi_smeared(k0, gvecs, nspec, rs, rabs, vlocs, mlens, zs,
                                            poss, palens, empty_f, empty_i, empty_f,
                                            nprojs, blens, dlens, omega, xc_mode,
                                            1, 1, n, eb1, eb2, eb3,
                                            nbands, nelec, SCF_MIX, 1.0e-6, SCF_MAXIT, sigma, 2.0, 6)
    println("[ground SCF Γ] NPW=" + to_string(n) + " converged=" + to_string(scf.converged)
            + " iters=" + to_string(scf.iters) + " etot=" + to_string(scf.e_total))
    if !scf.converged { println("WARN — SCF did not converge; N(E_F) below is off a non-converged ρ") }
    let nb = nocc + 4
    println("nelec=" + to_string(nelec) + " nocc=" + to_string(nocc) + " nbands(DOS)=" + to_string(nb)
            + " sigma=" + to_string(sigma))
    println("── N(E_F) vs k-mesh (VERBATIM, d6 NOT tuned) — Γ baseline then dense MP ──")
    _nef_on_mesh(1, 1, 1, scf.rho, n, nb, nelec, sigma)
    _nef_on_mesh(2, 2, 2, scf.rho, n, nb, nelec, sigma)
    _nef_on_mesh(4, 4, 4, scf.rho, n, nb, nelec, sigma)
    _nef_on_mesh(6, 6, 6, scf.rho, n, nb, nelec, sigma)
    println("=== DONE ===")
}
