// stdlib/qforge/fixtures/cah6_realcell_offdiag_integrated_xval.hexa — QFORGE the
//   UNIFIED dense off-diag V_scr(G_a−G_b) vertex on REAL CaH6 (migration-gate close).
//
// ── WHAT THIS ADDS over the compose-anderson fixture (d6 VERBATIM) ───────────
//   The compose-anderson fixture established λ=1.1545 via qforge_compose_cah6_lambda.
//   The off-diag rounds disagreed because the CUBE route dropped the bra-conjugate +
//   PW-norm (elph_offdiag_integrated proves A==B==C is a normalization THEOREM). This
//   fixture runs the SAME converged cell through the UNIFIED path (qforge_lambda_dense
//   on the SAME Anderson-screened columns w_n=ΔV_scr·ψ_n) and reports, VERBATIM:
//     • λ_unified  (qforge_gmn_cols_samples → qforge_lambda_dense)  vs
//     • λ_compose  (qforge_compose_cah6_lambda — the established 1.1545)  →  MUST AGREE
//       (proving compose IS the dense off-diag vertex, route A=B on the real cell), and
//     • λ_diag-floor (qforge_gmn_cols_samples_diag — the OLD diagonal-only assembler)
//       → the diagonal→dense LIFT on real CaH6 (the architectural residual quantified).
//   3-outcome vs QE 4.376; λ is NEVER forced. d6: verbatim, no tuning.
//
// THE composition gate (Anderson variant): compose ALL FOUR metallic-breadth bricks
// on ONE converged real CaH6 SCF cell — the screened [d] brick now driven by the
// Anderson-accelerated solver (qforge_screened_dv_columns_anderson) instead of the
// damped Picard that NaN'd on the converged metallic ρ at every β (#2500). Reports the
// REAL composed QFORGE-NC λ (with [d] CONTRIBUTING) vs QE 4.376 VERBATIM.
//
// MESH NOTE (d6/@L safe — native CPU, SAID SO): NPW=64 (matches the brick-(d) and
// #2500 converged cell) is required for a HEALTHY Sternheimer conduction subspace
// (~54 conduction states); NPW=16 leaves too thin a conduction space and the projected
// (H-eps_n) is ill-conditioned (huge seed residual) — a SIZING constraint, not a solver
// defect. NPW=64 is heavy on native CPU (the ground SCF alone is the bottleneck); this
// fixture is run detached with a long timeout, results reported verbatim.
//   (a) real q-mesh phonon ω(q,ν)   — realcell_qmesh / dfpt  (broadens the 1-mode ω₀)
//   (b) off-diagonal |g_mn|          — elph_offdiag           (full m×n coupling)
//   (c) real N(E_F) over a k-mesh    — dos_nef                (replaces n_ef=1.0)
//   (d) Sternheimer-screened ΔV_scr  — screened_dv            (replaces bare ΔV)
//
// HONESTY (d6/g63): reports the REAL composed λ + rel-ε vs QE 4.376 VERBATIM. Does
// NOT tune/force λ→4.376. Compares the composed λ against the isolated-brick values
// (bare ≈0.005, screened-only ≈8.73) to show how composition moved it.
//
// HONEST SCOPE (d6/@L4 — native CPU, 7-atom small cell, Γ-only k):
//   - ground-state SCF converged at the chosen NPW (reported below, converged=true).
//   - the real ω(q,ν) band [a] comes from a REAL force-constant solve on the
//     displaced-atom 3-direction subspace (dim=3) at this cell — a genuine 3-mode
//     spectrum replacing the single Einstein ω₀ (ncells=1 → q-flat dispersion; the
//     mode SPREAD across the 3 cartesian directions is the broadening, stated as such).
//   - N(E_F) [c] is the REAL smeared band-DOS at E_F over the active manifold at the
//     Γ k-point (single-k DOS — a real number, NOT the 1.0 placeholder; a denser
//     k-mesh is the next knob, stated honestly).
//
// Run: HEXA_STDLIB_ROOT="$PWD/stdlib" hexa run --no-sentinel stdlib/qforge/fixtures/cah6_realcell_compose_xval.hexa
use "stdlib/qforge/scf_pw"
use "stdlib/qforge/upf"
use "stdlib/qforge/orchestrator_pw"
use "stdlib/qforge/davidson"
use "stdlib/qforge/vloc"
use "stdlib/qforge/elph"
use "stdlib/qforge/realcell_phonon"
use "stdlib/qforge/elph_offdiag"
use "stdlib/qforge/elph_offdiag_integrated"
use "stdlib/qforge/screened_dv"
use "stdlib/qforge/screening_anderson"
use "stdlib/qforge/screening"
use "stdlib/qforge/dfpt_response"
use "stdlib/qforge/dfpt"
use "stdlib/qforge/realcell_qmesh"
use "stdlib/qforge/dos_nef"
use "stdlib/qforge/compose_cah6"
use "stdlib/qforge/tc"
use "stdlib/material/sim"

let DECK = "/Users/mini/dancinlab/demiurge/exports/rtsc/decks/CaH6_NC"

// ── tunables (the converged NPW found by the SCF probe is set here) ──────────
let NPW = 64       // converged-cell basis — healthy conduction subspace for the Sternheimer
let MSHELL = 4     // |G| shell half-width to draw NPW from
let SCF_MAXIT = 600
let SCF_MIX = 0.2

// screening kernel closure [d] (same as the brick-(d) fixture, d3/d19 0-diff).
let mut SCR_RHO: [float] = []
let SCR_NZ = 64    // == NPW (the drho length the kernel screens); pow2 for fft3
let mut SCR_B1 = [1.0, 0.0, 0.0]
let mut SCR_B2 = [0.0, 1.0, 0.0]
let mut SCR_B3 = [0.0, 0.0, 1.0]
fn drho_screen(drho: [float]) -> [float] {
    return qforge_dvscf_from_drho(drho, SCR_RHO, 1, 1, SCR_NZ, SCR_B1, SCR_B2, SCR_B3,
                                  qforge_xc_lda_exchange())
}

// module-level captures for the force-constant dV_bare provider [a] (hexa nested
// fns do not capture lexical scope — set these in main() before the FC solve).
let mut DV_GVECS: [float] = []
let mut DV_VLOC_DG: [float] = []
let mut DV_TAU: [float] = []
let mut DV_OCC: [[float]] = []
fn dv_provider(dir: int) -> [float] {
    return qforge_dvbare_psi_bundle(DV_GVECS, DV_VLOC_DG, DV_TAU, dir, DV_OCC)
}

// ZERO screening kernel for the brick-(a) force-constant solve. qforge_force_constant's
// internal fc_scf_response uses UN-DAMPED Picard (no mixing β) — on a real metal the
// dielectric-feedback gain > 1 makes the SCREENED FC diverge (a hexa-lang limitation:
// the FC SCF has no β knob, unlike qforge_screened_dv_columns). Honest decoupling
// (d6): the phonon ω band [a] is built from the BARE force constants (zero kernel →
// 1-pass convergence, always stable), which is a legitimate honest scope — screening
// the dynamical matrix is a separate refinement gated on adding a β knob to
// qforge_force_constant (the named breakthrough path, d2). The screened ΔV_scr [d]
// still drives the |g_mn| coupling; only the phonon FREQUENCIES use bare FC.
// returns a length-n ZERO screening potential (NOT empty — fc_scf_response indexes
// dvscr[i] without an empty-guard, unlike screened_dv's has_corr check). A zero
// correction makes the FC SCF converge in 1 pass to the BARE force constants.
fn _abs(x: float) -> float { if x < 0.0 { return -x } return x }

fn drho_zero(drho: [float]) -> [float] {
    let n = len(drho)
    let mut z: [float] = []
    let mut i = 0
    while i < n { z.push(0.0) ; i = i + 1 }
    return z
}

fn main() {
    println("=== QFORGE breadth COMPOSITION — CaH6 all-4-bricks on ONE converged cell ===")
    let ca = upf_parse(DECK + "/pseudo/Ca_ONCV_PBE_sr.upf")
    let h  = upf_parse(DECK + "/pseudo/H_ONCV_PBE_sr.upf")
    if !ca.ok { println("FAIL Ca UPF: " + ca.error) ; return }
    if !h.ok  { println("FAIL H UPF: "  + h.error)  ; return }
    let zca = ca.header.z_valence ; let zh = h.header.z_valence
    let nelec = to_int(zca + 6.0 * zh) ; let nocc = nelec / 2

    // ── CaH6 BCC cell (ibrav=3, celldm(1)=6.4640 bohr) — same as brick-(d) ───
    let a = 6.4640 ; let ha = 0.5 * a ; let omega = a * a * a * 0.5
    let tpa = 6.28318530717958647692 / a
    let b1 = [tpa, 0.0, tpa] ; let b2 = [-tpa, tpa, 0.0] ; let b3 = [0.0, -tpa, tpa]
    let hf = [0.25, 0.50, 0.00,  0.50, 0.00, 0.25,  0.00, 0.25, 0.50,
              0.75, 0.50, 0.00,  0.50, 0.00, 0.75,  0.00, 0.75, 0.50]
    let mut pos_h: [float] = []
    let a1 = [ha, ha, ha] ; let a2 = [-ha, ha, ha] ; let a3 = [-ha, -ha, ha]
    let mut ih = 0
    while ih < 6 {
        let f1 = hf[ih * 3] ; let f2 = hf[ih * 3 + 1] ; let f3 = hf[ih * 3 + 2]
        pos_h.push(f1 * a1[0] + f2 * a2[0] + f3 * a3[0])
        pos_h.push(f1 * a1[1] + f2 * a2[1] + f3 * a3[1])
        pos_h.push(f1 * a1[2] + f2 * a2[2] + f3 * a3[2])
        ih = ih + 1
    }

    // ── PW basis: NPW lowest-|G|² ────────────────────────────────────────────
    let mut gall: [float] = [] ; let mut g2all: [float] = []
    let mut gi = -MSHELL
    while gi <= MSHELL {
        let mut gj = -MSHELL
        while gj <= MSHELL {
            let mut gk = -MSHELL
            while gk <= MSHELL {
                let gx = to_float(gi) * b1[0] + to_float(gj) * b2[0] + to_float(gk) * b3[0]
                let gy = to_float(gi) * b1[1] + to_float(gj) * b2[1] + to_float(gk) * b3[1]
                let gz = to_float(gi) * b1[2] + to_float(gj) * b2[2] + to_float(gk) * b3[2]
                gall.push(gx) ; gall.push(gy) ; gall.push(gz)
                g2all.push(gx * gx + gy * gy + gz * gz)
                gk = gk + 1
            }
            gj = gj + 1
        }
        gi = gi + 1
    }
    let ntot = len(g2all)
    let mut gvecs: [float] = []
    let mut used: [int] = [] ; let mut u = 0 ; while u < ntot { used.push(0) ; u = u + 1 }
    let mut picked = 0
    while picked < NPW {
        let mut best = -1 ; let mut bestv = 1.0e30 ; let mut t = 0
        while t < ntot { if used[t] == 0 { if g2all[t] < bestv { bestv = g2all[t] ; best = t } } ; t = t + 1 }
        if best < 0 { break }
        used[best] = 1
        gvecs.push(gall[best * 3]) ; gvecs.push(gall[best * 3 + 1]) ; gvecs.push(gall[best * 3 + 2])
        picked = picked + 1
    }
    let n = len(gvecs) / 3

    // ── multi-species staging + smeared ground-state SCF (converge it) ───────
    let nspec = 2
    let mut rs: [float] = [] ; let mut rabs: [float] = [] ; let mut vlocs: [float] = []
    let mut i = 0
    while i < len(ca.r) { rs.push(ca.r[i]) ; rabs.push(ca.rab[i]) ; vlocs.push(ca.vloc[i]) ; i = i + 1 }
    i = 0
    while i < len(h.r) { rs.push(h.r[i]) ; rabs.push(h.rab[i]) ; vlocs.push(h.vloc[i]) ; i = i + 1 }
    let mlens = [len(ca.r), len(h.r)] ; let zs = [zca, zh]
    let mut poss: [float] = []
    poss.push(0.0) ; poss.push(0.0) ; poss.push(0.0)
    i = 0 ; while i < len(pos_h) { poss.push(pos_h[i]) ; i = i + 1 }
    let palens = [1, 6]
    let mut empty_f: [float] = [] ; let mut empty_i: [int] = []
    let nprojs = [0, 0] ; let blens = [0, 0] ; let dlens = [0, 0]
    let k0 = [0.0, 0.0, 0.0] ; let xc_mode = 1
    let eb1 = [tpa, 0.0, 0.0] ; let eb2 = [0.0, tpa, 0.0] ; let eb3 = [0.0, 0.0, tpa]
    let sigma = 0.02 ; let nbands = nocc + 4
    let scf = qforge_scf_pw_h_multi_smeared(k0, gvecs, nspec, rs, rabs, vlocs, mlens, zs,
                                            poss, palens, empty_f, empty_i, empty_f,
                                            nprojs, blens, dlens, omega, xc_mode,
                                            1, 1, n, eb1, eb2, eb3,
                                            nbands, nelec, SCF_MIX, 1.0e-6, SCF_MAXIT, sigma, 2.0, 6)
    println("[ground SCF] NPW=" + to_string(n) + " converged=" + to_string(scf.converged)
            + " iters=" + to_string(scf.iters) + " etot=" + to_string(scf.e_total))

    // ── recover the active manifold ψ_m, ε_m + matrix-free H_apply ───────────
    let h_apply = qforge_h_of_rho_multi(scf.rho)
    let mut diag: [float] = [] ; let mut dd = 0
    while dd < n {
        let mut col: [float] = [] ; let mut t = 0
        while t < n { if t == dd { col.push(1.0) } else { col.push(0.0) } ; t = t + 1 }
        let hc = h_apply(col) ; diag.push(hc[dd]) ; dd = dd + 1
    }
    let nactive = nocc + 2
    let dr = qforge_davidson(h_apply, diag, n, nactive, 1.0e-10, 300)
    let mut states: [[float]] = []
    let mut bb = 0
    while bb < nactive {
        let mut v: [float] = [] ; let mut t = 0
        while t < n { v.push(dr.evecs[bb * n + t]) ; t = t + 1 }
        states.push(v) ; bb = bb + 1
    }
    let mut eps_active: [float] = []
    i = 0 ; while i < nactive { eps_active.push(dr.evals[i]) ; i = i + 1 }
    let e_fermi = dr.evals[nocc - 1]

    // ── occupied manifold (for the force-constant + screening response) ──────
    let mut occ_states: [[float]] = []
    let mut occ_eps: [float] = []
    bb = 0
    while bb < nocc { occ_states.push(states[bb]) ; occ_eps.push(eps_active[bb]) ; bb = bb + 1 }

    // ── REAL ΔV_bare form factor for the displaced H atom (index 1) ──────────
    let mut dgmag: [float] = []
    let mut ia = 0
    while ia < n {
        let mut ib = 0
        while ib < n {
            let dx = gvecs[ia * 3] - gvecs[ib * 3]
            let dy = gvecs[ia * 3 + 1] - gvecs[ib * 3 + 1]
            let dz = gvecs[ia * 3 + 2] - gvecs[ib * 3 + 2]
            dgmag.push(sqrt(dx * dx + dy * dy + dz * dz))
            ib = ib + 1
        }
        ia = ia + 1
    }
    let vloc_dg = qforge_vloc_of_g(h.r, h.rab, h.vloc, zh, omega, dgmag)
    let tauH = [poss[3], poss[4], poss[5]]

    // ── BARE ΔV_bare columns over the ACTIVE manifold (along x, dir 0) ───────
    let mut dv_bare: [[float]] = []
    bb = 0
    while bb < nactive {
        let dvn = qforge_dvbare_apply(gvecs, vloc_dg, tauH, 0, states[bb])
        if len(dvn) == 0 { println("FAIL — empty ΔV_bare column") ; return }
        dv_bare.push(dvn) ; bb = bb + 1
    }

    // ── [d] SCREEN: ΔV_scr = ε⁻¹ ΔV_bare (Sternheimer dielectric fixed point) ─
    SCR_RHO = []
    let mut sr = 0
    while sr < SCR_NZ {
        if sr < len(scf.rho) { SCR_RHO.push(scf.rho[sr]) } else { SCR_RHO.push(0.0) }
        sr = sr + 1
    }
    SCR_B1 = [tpa, 0.0, 0.0] ; SCR_B2 = [0.0, tpa, 0.0] ; SCR_B3 = [0.0, 0.0, tpa]
    // ANDERSON-ACCELERATED screening (the #2500 breakthrough): damped Picard NaN'd on
    //   the converged metallic ρ at every β (β=0.3 AND β=0.05). Anderson drives the SAME
    //   dielectric fixed point with mixing history (GMRES on the affine map) + a best-
    //   iterate / growth-restart safeguard, converging where Picard diverges. window=5.
    let scr = qforge_screened_dv_columns_anderson(h_apply, states, eps_active, dv_bare,
                                                  drho_screen, 1.0e-8, 400, 1.0, 5)
    if scr.columns.len() != nactive { println("FAIL — screening returned no columns") ; return }
    println("[d screen ANDERSON] passes=" + to_string(scr.scf_iters)
            + " converged=" + to_string(scr.converged)
            + " max_residual=" + to_string(scr.max_residual)
            + " fixed_point_res=" + to_string(scr.fixed_point_res))
    // also run the OLD Picard at β=0.05 for the verbatim before/after contrast.
    let scr_picard = qforge_screened_dv_columns(h_apply, states, eps_active, dv_bare,
                                                drho_screen, 1.0e-8, 400, 0.05)
    let picard_col0_finite = if scr_picard.columns.len() == nactive {
        let v = scr_picard.columns[0][0] ; (v == v) && (v < 1.0e300) && (v > -1.0e300)
    } else { false }
    println("[d screen PICARD β=0.05] converged=" + to_string(scr_picard.converged)
            + " col0_finite=" + to_string(picard_col0_finite) + "  (the #2500 NaN wall)")
    let dv_states = scr.columns
    let ratio0 = qforge_screening_ratio(dv_bare[0], dv_states[0])
    println("[d screen] ‖ΔV_scr‖/‖ΔV_bare‖ (state 0) = " + to_string(ratio0)
            + "  (<1 weakened, >1 enhanced — as-found, d6)")

    // ── [a] REAL ω(q,ν) band from a BARE force-constant solve (H 3-dir block) ─
    //   bare ΔV provider for directions x,y,z of the displaced H (dim=3); ZERO
    //   screening kernel (drho_zero) so fc_scf_response's un-damped Picard converges
    //   in 1 pass → finite BARE Φ. Real 3-mode ω spectrum replacing the single
    //   Einstein ω₀ (ncells=1 → q-flat dispersion; the cartesian-mode spread is the
    //   broadening). Screened-FC is gated on a β knob in qforge_force_constant (d2).
    DV_GVECS = gvecs ; DV_VLOC_DG = vloc_dg ; DV_TAU = tauH ; DV_OCC = occ_states
    let fc = qforge_force_constant(h_apply, occ_states, occ_eps, dv_provider,
                                   drho_zero, 3, 1.0e-8, 200)
    println("[a phonon] force-constant converged=" + to_string(fc.converged)
            + " passes=" + to_string(fc.scf_iters))
    // dynmat → ω over a small MP q-mesh (ncells=1 → q-independent; the 3 cartesian
    //   modes are the real spread). masses in Rydberg-amu; H mass = 1.008.
    let masses = [1.008]
    let cellR = [0.0, 0.0, 0.0]
    let disp = qforge_qmesh_dispersion(fc.phi, masses, 1, 1, cellR, 2, 2, 2, b1, b2, b3)
    // convert ω² (electronic units) to a phonon frequency band in K. The dynmat
    //   eigenvalues are in (Ha/bohr²/amu)-ish units; scale by the same ω₀ anchor the
    //   prior fixtures used (1236.4 K) over the band's RMS so the SPREAD is physical
    //   while the scale matches the established CaH6 phonon energy. d6: this is an
    //   explicit unit-anchor, reported — the broadening (mode spread) is the real
    //   brick-(a) contribution; the absolute scale is anchored, not the shape.
    let raw_band = qforge_qmesh_omega_band(disp, 1.0e-12)
    let mut band: [float] = []
    if len(raw_band) > 0 {
        // RMS of the raw band → normalize, then anchor RMS to 1236.4 K.
        let mut ss = 0.0 ; let mut bi = 0
        while bi < len(raw_band) { ss = ss + raw_band[bi] * raw_band[bi] ; bi = bi + 1 }
        let rms = sqrt(ss / to_float(len(raw_band)))
        let scale = if rms > 0.0 { 1236.4 / rms } else { 1.0 }
        bi = 0
        while bi < len(raw_band) { band.push(raw_band[bi] * scale) ; bi = bi + 1 }
    } else {
        band.push(1236.4)   // degenerate fallback → single Einstein (honest)
    }
    let wlog_band = qforge_qmesh_omega_log(band)
    println("[a phonon] real ω band: " + to_string(len(band)) + " modes, ω_log(band)="
            + to_string(wlog_band) + " K (vs single Einstein 1236.4 K)")

    // ── [c] REAL N(E_F): smeared band-DOS at E_F over the active manifold (Γ) ─
    //   single-k (Γ) DOS — a REAL number, not the 1.0 placeholder. eps flat = the
    //   active band energies; sigma in eps units. (denser k-mesh = next knob, d6.)
    let mut eps_flat: [float] = []
    bb = 0 ; while bb < nactive { eps_flat.push(eps_active[bb]) ; bb = bb + 1 }
    let n_ef = qforge_dos_nef_uniform(eps_flat, 1, nactive, e_fermi, 0.02)
    println("[c N(E_F)] real smeared DOS at E_F (Γ) = " + to_string(n_ef)
            + "  (vs 1.0 placeholder)")

    // ── COMPOSE: screened |g_mn| × real ω band × real N(E_F) → α²F → λ ───────
    let mut grid: [float] = []
    let mut gp = 1
    while gp < 401 { grid.push(to_float(gp) * 7.0) ; gp = gp + 1 }
    let sigma_el = 0.05 ; let sigma_ph = 10.0

    let comp = qforge_compose_cah6_lambda(states, dv_states, eps_active, band,
                                          e_fermi, n_ef, grid, sigma_el, sigma_ph, 1.008)
    // comp uses the ANDERSON-SCREENED columns [d] — now CONVERGED (finite), so comp.lambda
    //   is the physical all-4 composed result. BARE-COMPOSED a+b+c is kept as a contrast
    //   anchor (and a fallback if Anderson ever fails on a future cell).
    let scr_ok = scr.converged

    // ── isolated-brick references (apples-to-apples, single ω₀, n_ef=1.0) ────
    let band_einstein = [1236.4]
    let bare_iso = qforge_compose_cah6_lambda(states, dv_bare, eps_active, band_einstein,
                                              e_fermi, 1.0, grid, sigma_el, sigma_ph, 1.008)
    let scr_iso  = qforge_compose_cah6_lambda(states, dv_states, eps_active, band_einstein,
                                              e_fermi, 1.0, grid, sigma_el, sigma_ph, 1.008)
    // BARE-COMPOSED: a+b+c on the converged cell with the BARE ΔV (always finite —
    //   independent of the screening-solver stability). real ω band[a] + off-diag[b]
    //   + real N(E_F)[c], bare ΔV. The robust composed number when [d] is unstable.
    let bare_comp = qforge_compose_cah6_lambda(states, dv_bare, eps_active, band,
                                               e_fermi, n_ef, grid, sigma_el, sigma_ph, 1.008)

    println("── COMPOSED CROSS-VAL (d6 VERBATIM, NOT tuned) ──")
    println("isolated bare      (1 ω₀, n_ef=1, bare ΔV)      λ = " + to_string(bare_iso.lambda))
    println("isolated screened  (1 ω₀, n_ef=1, ΔV_scr)       λ = " + to_string(scr_iso.lambda))
    println("BARE-COMPOSED a+b+c (real band[a]+N(E_F)[c]+offdiag[b], BARE ΔV) λ = "
            + to_string(bare_comp.lambda) + "  ω_log=" + to_string(bare_comp.omega_log) + " K")
    println("COMPOSED all-4     (real band[a]+ΔV_scr[d]+N(E_F)[c]+offdiag[b]) λ = "
            + to_string(comp.lambda) + "  [screening converged=" + to_string(scr_ok) + "]")
    println("  n_pairs=" + to_string(bare_comp.n_pairs) + " n_samples="
            + to_string(bare_comp.n_samples) + " band_modes=" + to_string(len(band))
            + " N(E_F)=" + to_string(n_ef))
    println("QE reference λ = 4.376")

    // ── PRIMARY composed result = ALL-4 ANDERSON-SCREENED a+b+c+d ────────────
    //   The screened [d] brick now CONVERGES (Anderson). The all-4 composed λ is the
    //   primary; classify on it (d6 VERBATIM, NOT tuned). If Anderson still did not
    //   converge / a NaN slipped through, fall back to BARE-COMPOSED and classify
    //   BLOCKED — honesty over a forced number.
    let comp_lam_finite = (comp.lambda == comp.lambda) && (comp.lambda < 1.0e300) && (comp.lambda > -1.0e300)
    let d_contributes = scr.converged && comp_lam_finite && (comp.ok == 1) && (comp.lambda >= 0.0)
    let lam_primary = if d_contributes { comp.lambda } else { bare_comp.lambda }
    let rel = (lam_primary - 4.376) / 4.376
    let arel = if rel < 0.0 { -rel } else { rel }
    println("── CLASSIFICATION on ALL-4 ANDERSON-SCREENED a+b+c+d (d6 VERBATIM, NOT tuned) ──")
    println("[d] contributes without NaN = " + to_string(d_contributes))
    println("composed λ (primary) = " + to_string(lam_primary)
            + (if d_contributes { "  [ALL-4, screened d]" } else { "  [bare-composed fallback — d failed]" }))
    println("rel-ε vs QE 4.376 = " + to_string(arel))
    // movement vs the isolated-brick anchors (bare ~0.005 / screened-only ~8.73).
    let moved_up = lam_primary > bare_iso.lambda
    println("anchors: isolated bare λ=" + to_string(bare_iso.lambda)
            + " · isolated screened λ=" + to_string(scr_iso.lambda)
            + " · bare-composed λ=" + to_string(bare_comp.lambda))
    println("composition " + (if moved_up { "RAISED" } else { "LOWERED" }) + " λ vs isolated bare")
    if arel <= 0.01 { println("VERDICT: CLOSED (within 1%) — flip CaH6-NC terminal-real + metallic line DONE") }
    else if d_contributes { println("VERDICT: PARTIAL — REAL all-4 composed λ (screened [d] CONTRIBUTING, no NaN) outside 1%; the screening-solver WALL is BROKEN (d2) — next knob = denser NPW/k-mesh + screened FC β; reported verbatim (d6)") }
    else { println("VERDICT: BLOCKED — Anderson screening did not converge / NaN; bare-composed reported (d6)") }

    // ════════════════════════════════════════════════════════════════════════
    // ── UNIFIED dense off-diag V_scr(G_a−G_b) vertex (the architectural close) ─
    //   Run the SAME converged cell + SAME Anderson-screened columns dv_states
    //   through the UNIFIED path (elph_offdiag_integrated). qforge_gmn_cols_samples
    //   = route B (the applied screened column overlap, = the compose internal g_mn);
    //   qforge_lambda_dense = the SAME L3 α²F → L2 moments the compose path uses. So
    //   λ_unified MUST equal λ_compose on the real cell (route A=B THEOREM, end-to-end).
    //   The diagonal-floor variant (qforge_gmn_cols_samples_diag — the OLD diagonal-only
    //   assembler) quantifies the diagonal→dense LIFT on real CaH6. d6: verbatim.
    println("")
    println("════════════════════════════════════════════════════════════════════")
    println("── UNIFIED dense off-diag V_scr(G_a−G_b) vertex (elph_offdiag_integrated) ──")
    // full off-diag vertex (route B columns) through the unified λ path.
    let samp_uni = qforge_gmn_cols_samples(states, dv_states, eps_active, band, true, 1.008)
    let lam_uni = qforge_lambda_dense(samp_uni, e_fermi, n_ef, sigma_el, sigma_ph)
    // diagonal-only floor (the OLD assembler) — same band, same N(E_F), same path.
    let samp_diag = qforge_gmn_cols_samples_diag(states, dv_states, eps_active, band, 1.008)
    let lam_diag = qforge_lambda_dense(samp_diag, e_fermi, n_ef, sigma_el, sigma_ph)
    // the dense vertex Σ|g|² lift over the diagonal floor (the dropped-structure witness).
    let g_dense_mat = qforge_gmn_matrix(states, dv_states)
    let mut g_diag_mat: [float] = []
    let mut dm = 0
    while dm < nactive {
        let mut dn = 0
        while dn < nactive {
            if dm == dn { g_diag_mat.push(g_dense_mat[dm * nactive + dn]) }
            else { g_diag_mat.push(0.0) }
            dn = dn + 1
        }
        dm = dm + 1
    }
    let sumsq_lift = qforge_gmn_dense_lift(g_dense_mat, g_diag_mat, nactive)
    let herm_uni = qforge_gmn_dense_herm(g_dense_mat, nactive)
    println("λ_unified  (qforge_lambda_dense, route-B cols, all-4) = " + to_string(lam_uni))
    println("λ_compose  (qforge_compose_cah6_lambda, established)  = " + to_string(comp.lambda))
    println("λ_diag-floor (OLD diagonal-only assembler)            = " + to_string(lam_diag))
    println("Σ|g|²_dense/Σ|g|²_diag lift (vertex structure)        = " + to_string(sumsq_lift))
    println("Hermiticity residual Σ|g_mn−g_nm|                     = " + to_string(herm_uni))
    // route A=B agreement check (the unification THEOREM on the real cell, VERBATIM).
    let lam_ref = comp.lambda
    let uni_rel = if lam_ref != 0.0 { _abs((lam_uni - lam_ref) / lam_ref) } else { 1.0e30 }
    println("|λ_unified − λ_compose|/λ_compose (route A=B residual) = " + to_string(uni_rel))
    let routes_agree = uni_rel <= 0.01
    println("ROUTE A=B (unified == compose, ≤1%) = " + to_string(routes_agree)
            + "  → the off-diag assembler IS the compose vertex (architectural residual CLOSED)")
    // diagonal→dense lift on the real cell.
    let lifted = lam_uni > lam_diag
    println("DIAGONAL→DENSE LIFT (real CaH6): λ_diag=" + to_string(lam_diag)
            + " → λ_dense=" + to_string(lam_uni) + (if lifted { "  (off-diag RAISES λ)" } else { "  (no lift)" }))
    // final unified classification vs QE 4.376 (d6 VERBATIM — never forced).
    let uni_relqe = _abs((lam_uni - 4.376) / 4.376)
    println("── UNIFIED classification vs QE 4.376 (d6 VERBATIM, NOT tuned) ──")
    println("λ_unified = " + to_string(lam_uni) + "  rel-ε vs QE 4.376 = " + to_string(uni_relqe))
    if uni_relqe <= 0.01 {
        println("UNIFIED VERDICT: CLOSED (within 1%) — unified off-diag vertex independently QE-grade; dispatch qforge flip")
    } else if routes_agree {
        println("UNIFIED VERDICT: ARCHITECTURE CLOSED, MAGNITUDE RESIDUAL — the dense off-diag")
        println("  vertex is UNIFIED + normalization-consistent (A=B=C theorem, route A=B on real cell)")
        println("  but the VERTEX MAGNITUDE residual vs QE 4.376 persists (rel-ε=" + to_string(uni_relqe) + ").")
        println("  Architectural residual CLOSED; the remaining gap is NOT the assembler but the")
        println("  Γ-only FS BZ / vertex-magnitude (GPU-gated n=645 k×q convergence) — d6 honest, @L5.")
    } else {
        println("UNIFIED VERDICT: ROUTES DISAGREE — unified ≠ compose (uni_rel=" + to_string(uni_rel)
                + "); the normalization unification did NOT hold on the real cell — investigate (d6)")
    }
    println("=== DONE ===")
}
