// stdlib/qforge/fixtures/cah6_realcell_offdiag_xval.hexa — QFORGE breadth (b) XVAL.
//
// The OFF-DIAGONAL cross-val: re-run the CaH6 el-ph→λ with the FULL inter-band
// |g_mn|=⟨ψ_m|ΔV_bare|ψ_n⟩ matrix (brick (b) elph_offdiag, m≠n included) instead of
// the DIAGONAL-only g_nn the cah6_realcell_xval fixture used (λ=0.00011464 vs QE 4.376).
//
// HONESTY (d6/g63 — the metallic-wall hinge): this reports the REAL QFORGE-NC λ
// from the genuine full m×n matrix VERBATIM and its rel-ε vs QE 4.376. It does NOT
// tune/force λ→4.376. Adding inter-band coupling is breadth brick (b)/4 — the real
// λ may still be outside 1% (real N(E_F)+k-mesh (c) and screening (d) remain).
//
// PATH (all verified bricks, d3/d19 reuse — 0-diff existing files):
//   real ONCV UPF → CaH6 BCC cell → PW basis → smeared SCF (converged ρ) →
//   Davidson active ψ_m,ε_m → REAL ΔV_bare(displace 1 H, x) via qforge_dvbare_apply
//   → FULL |g_mn|² = ⟨ψ_m|ΔV_bare|ψ_n⟩² over the active manifold (brick (b)) →
//   el-ph→λ with the Fermi-surface double-δ weight (L3 α²F) → λ, ω_log.
//
// Run: HEXA_STDLIB_ROOT="$PWD/stdlib" hexa run --no-sentinel stdlib/qforge/fixtures/cah6_realcell_offdiag_xval.hexa
use "stdlib/qforge/scf_pw"
use "stdlib/qforge/upf"
use "stdlib/qforge/orchestrator_pw"
use "stdlib/qforge/orchestrator"
use "stdlib/qforge/davidson"
use "stdlib/qforge/vloc"
use "stdlib/qforge/elph"
use "stdlib/qforge/elph_scf"
use "stdlib/qforge/realcell_phonon"
use "stdlib/qforge/elph_offdiag"
use "stdlib/qforge/tc"
use "stdlib/material/sim"

let DECK = "/Users/mini/dancinlab/demiurge/exports/rtsc/decks/CaH6_NC"

fn main() {
    println("=== QFORGE breadth (b) — REAL-CELL CaH6 off-diagonal |g_mn| cross-val ===")

    let ca = upf_parse(DECK + "/pseudo/Ca_ONCV_PBE_sr.upf")
    let h  = upf_parse(DECK + "/pseudo/H_ONCV_PBE_sr.upf")
    if !ca.ok { println("FAIL Ca UPF: " + ca.error) ; return }
    if !h.ok  { println("FAIL H UPF: "  + h.error)  ; return }
    let zca = ca.header.z_valence ; let zh = h.header.z_valence
    let nelec = to_int(zca + 6.0 * zh) ; let nocc = nelec / 2

    // ── CaH6 BCC cell (ibrav=3, celldm(1)=6.4640 bohr) ──────────────────────
    let a = 6.4640 ; let ha = 0.5 * a ; let omega = a * a * a * 0.5
    let tpa = 6.28318530717958647692 / a
    let b1 = [0.0, tpa, tpa] ; let b2 = [-tpa, 0.0, tpa] ; let b3 = [-tpa, -tpa, 0.0]
    let hf = [0.25, 0.50, 0.00,  0.50, 0.00, 0.25,  0.00, 0.25, 0.50,
              0.75, 0.50, 0.00,  0.50, 0.00, 0.75,  0.00, 0.75, 0.50]
    let pos_ca = [0.0, 0.0, 0.0]
    let mut pos_h: [float] = []
    let a1 = [ha, ha, ha] ; let a2 = [-ha, ha, ha] ; let a3 = [-ha, -ha, ha]
    let mut ih = 0
    while ih < 6 {
        let f1 = hf[ih * 3] ; let f2 = hf[ih * 3 + 1] ; let f3 = hf[ih * 3 + 2]
        pos_h.push(f1 * a1[0] + f2 * a2[0] + f3 * a3[0])
        pos_h.push(f1 * a1[1] + f2 * a2[1] + f3 * a3[1])
        pos_h.push(f1 * a1[2] + f2 * a2[2] + f3 * a3[2])
        ih = ih + 1
    }

    // ── PW G-basis: NPW lowest-|G|² (same convention as cah6_realcell_xval) ──
    let NPW = 16 ; let M = 3
    let mut gall: [float] = [] ; let mut g2all: [float] = []
    let mut gi = -M
    while gi <= M {
        let mut gj = -M
        while gj <= M {
            let mut gk = -M
            while gk <= M {
                let gx = to_float(gi) * b1[0] + to_float(gj) * b2[0] + to_float(gk) * b3[0]
                let gy = to_float(gi) * b1[1] + to_float(gj) * b2[1] + to_float(gk) * b3[1]
                let gz = to_float(gi) * b1[2] + to_float(gj) * b2[2] + to_float(gk) * b3[2]
                gall.push(gx) ; gall.push(gy) ; gall.push(gz)
                g2all.push(gx * gx + gy * gy + gz * gz)
                gk = gk + 1
            }
            gj = gj + 1
        }
        gi = gi + 1
    }
    let ntot = len(g2all)
    let mut gvecs: [float] = []
    let mut used: [int] = [] ; let mut u = 0 ; while u < ntot { used.push(0) ; u = u + 1 }
    let mut picked = 0
    while picked < NPW {
        let mut best = -1 ; let mut bestv = 1.0e30 ; let mut t = 0
        while t < ntot {
            if used[t] == 0 { if g2all[t] < bestv { bestv = g2all[t] ; best = t } }
            t = t + 1
        }
        if best < 0 { break }
        used[best] = 1
        gvecs.push(gall[best * 3]) ; gvecs.push(gall[best * 3 + 1]) ; gvecs.push(gall[best * 3 + 2])
        picked = picked + 1
    }
    let n = len(gvecs) / 3

    // ── multi-species staging + smeared SCF (same as cah6_realcell_xval) ────
    let nspec = 2
    let mut rs: [float] = [] ; let mut rabs: [float] = [] ; let mut vlocs: [float] = []
    let mut i = 0
    while i < len(ca.r) { rs.push(ca.r[i]) ; rabs.push(ca.rab[i]) ; vlocs.push(ca.vloc[i]) ; i = i + 1 }
    i = 0
    while i < len(h.r) { rs.push(h.r[i]) ; rabs.push(h.rab[i]) ; vlocs.push(h.vloc[i]) ; i = i + 1 }
    let mlens = [len(ca.r), len(h.r)] ; let zs = [zca, zh]
    let mut poss: [float] = []
    poss.push(pos_ca[0]) ; poss.push(pos_ca[1]) ; poss.push(pos_ca[2])
    i = 0 ; while i < len(pos_h) { poss.push(pos_h[i]) ; i = i + 1 }
    let palens = [1, 6]
    let mut empty_f: [float] = [] ; let mut empty_i: [int] = []
    let nprojs = [0, 0] ; let blens = [0, 0] ; let dlens = [0, 0]
    let k0 = [0.0, 0.0, 0.0] ; let xc_mode = 1
    let eb1 = [tpa, 0.0, 0.0] ; let eb2 = [0.0, tpa, 0.0] ; let eb3 = [0.0, 0.0, tpa]
    let sigma = 0.02 ; let nbands = nocc + 4
    let scf = qforge_scf_pw_h_multi_smeared(k0, gvecs, nspec, rs, rabs, vlocs, mlens, zs,
                                            poss, palens, empty_f, empty_i, empty_f,
                                            nprojs, blens, dlens, omega, xc_mode,
                                            1, 1, n, eb1, eb2, eb3,
                                            nbands, nelec, 0.3, 1.0e-6, 200, sigma, 2.0, 6)
    println("SCF converged=" + to_string(scf.converged) + " iters=" + to_string(scf.iters))

    // ── recover the ACTIVE manifold ψ_m, ε_m (occ + a few empty near E_F) ───
    //   Off-diagonal |g_mn| mixes bands; include a few states ABOVE the occupied
    //   edge so the inter-band Fermi-surface scattering (occ↔unocc near E_F) is
    //   captured, not just occ↔occ. nactive = nocc + 2 (kept small — alloc guard).
    let h_apply = qforge_h_of_rho_multi(scf.rho)
    let mut diag: [float] = [] ; let mut dd = 0
    while dd < n {
        let mut col: [float] = [] ; let mut t = 0
        while t < n { if t == dd { col.push(1.0) } else { col.push(0.0) } ; t = t + 1 }
        let hc = h_apply(col) ; diag.push(hc[dd]) ; dd = dd + 1
    }
    let nactive = nocc + 2
    let dr = qforge_davidson(h_apply, diag, n, nactive, 1.0e-10, 300)
    let mut states: [[float]] = []
    let mut bb = 0
    while bb < nactive {
        let mut v: [float] = [] ; let mut t = 0
        while t < n { v.push(dr.evecs[bb * n + t]) ; t = t + 1 }
        states.push(v) ; bb = bb + 1
    }
    let mut eps_active: [float] = []
    i = 0 ; while i < nactive { eps_active.push(dr.evals[i]) ; i = i + 1 }

    // ── REAL ΔV_bare: displace ONE H atom (index 1 = first H) along x ────────
    let mut dgmag: [float] = []
    let mut ia = 0
    while ia < n {
        let mut ib = 0
        while ib < n {
            let dx = gvecs[ia * 3] - gvecs[ib * 3]
            let dy = gvecs[ia * 3 + 1] - gvecs[ib * 3 + 1]
            let dz = gvecs[ia * 3 + 2] - gvecs[ib * 3 + 2]
            dgmag.push(sqrt(dx * dx + dy * dy + dz * dz))
            ib = ib + 1
        }
        ia = ia + 1
    }
    let vloc_dg = qforge_vloc_of_g(h.r, h.rab, h.vloc, zh, omega, dgmag)   // [n*n]
    let tauH = [poss[3], poss[4], poss[5]]

    // pre-apply ΔV_bare to EVERY active state → the columns (ΔV_bare ψ_n) (brick 2/2).
    let mut dv_states: [[float]] = []
    bb = 0
    while bb < nactive {
        let dvn = qforge_dvbare_apply(gvecs, vloc_dg, tauH, 0, states[bb])
        if len(dvn) == 0 { println("FAIL — empty ΔV_bare column") ; return }
        dv_states.push(dvn) ; bb = bb + 1
    }

    // ── FULL nb×nb |g_mn| matrix (brick (b)) + Hermiticity witness ──────────
    let gmat = qforge_gmn_matrix(states, dv_states)
    let herm = qforge_gmn_herm_residual(gmat, nactive)
    println("|g_mn| matrix " + to_string(nactive) + "×" + to_string(nactive)
            + "  Hermiticity residual Σ|g_mn−g_nm| = " + to_string(herm) + " (≈0 expected, Γ real-sym)")

    // off-diagonal magnitude sum (the inter-band weight the diagonal-only path dropped)
    let mut off_sum = 0.0 ; let mut diag_sum = 0.0
    let mut mm = 0
    while mm < nactive {
        let mut nn = 0
        while nn < nactive {
            let gv = gmat[mm * nactive + nn]
            let ag = if gv < 0.0 { -gv } else { gv }
            if mm == nn { diag_sum = diag_sum + ag } else { off_sum = off_sum + ag }
            nn = nn + 1
        }
        mm = mm + 1
    }
    println("Σ|g_nn| (diagonal) = " + to_string(diag_sum)
            + "   Σ|g_mn| m≠n (off-diagonal) = " + to_string(off_sum))

    // ── el-ph → λ with the Fermi-surface DOUBLE-δ weight (L3 α²F) ────────────
    let omega0 = 1236.4 ; let e_fermi = dr.evals[nocc - 1] ; let n_ef = 1.0
    let mut grid: [float] = []
    let mut gp = 1
    while gp < 401 { grid.push(to_float(gp) * 7.0) ; gp = gp + 1 }
    let sigma_el = 0.05 ; let sigma_ph = 10.0

    // FULL matrix (diagonal + off-diagonal) — the physical inter-band el-ph sum.
    let s_full = qforge_gmn_samples(states, dv_states, eps_active, omega0, true)
    let a2f_full = qforge_a2f_from_elph(s_full[0], s_full[1], s_full[2], s_full[3],
                                        e_fermi, n_ef, grid, 1.0, sigma_el, sigma_ph)
    let mfull = eliashberg_moments_from_a2f(grid, a2f_full)
    let lambda_full = mfull[0] ; let omega_log_full = mfull[1]

    // diagonal-only baseline over the SAME active manifold (apples-to-apples Δ).
    let mut ek: [float] = [] ; let mut g2d: [float] = [] ; let mut wqd: [float] = []
    mm = 0
    while mm < nactive {
        let gnn = gmat[mm * nactive + mm]
        ek.push(eps_active[mm]) ; g2d.push(gnn * gnn) ; wqd.push(omega0)
        mm = mm + 1
    }
    let a2f_diag = qforge_a2f_from_elph(ek, ek, g2d, wqd, e_fermi, n_ef, grid,
                                        1.0, sigma_el, sigma_ph)
    let mdiag = eliashberg_moments_from_a2f(grid, a2f_diag)
    let lambda_diag = mdiag[0]

    println("── OFF-DIAGONAL CROSS-VAL (d6 VERBATIM, NOT tuned) ──")
    println("QFORGE-NC λ (diagonal-only, same manifold) = " + to_string(lambda_diag))
    println("QFORGE-NC λ (FULL m×n off-diagonal)        = " + to_string(lambda_full))
    let lift = if lambda_diag > 0.0 { lambda_full / lambda_diag } else { 0.0 }
    println("off-diagonal lift λ_full/λ_diag           = " + to_string(lift))
    println("QE reference λ                            = 4.376")
    let rel = (lambda_full - 4.376) / 4.376
    let arel = if rel < 0.0 { -rel } else { rel }
    println("rel-ε vs QE 4.376 (full)                  = " + to_string(arel))
    println("ω_log (full) = " + to_string(omega_log_full) + " K")
    if arel <= 0.01 { println("VERDICT: CLOSED (within 1%)") }
    else { println("VERDICT: PARTIAL/BLOCKED — broader real λ outside 1%, reported verbatim (d6)") }
    println("=== DONE ===")
}
