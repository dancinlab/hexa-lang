// Probe qpwfft_stage on the REAL converged CaH6 G-basis (n=645) — measures the
// Miller hmax/kmax/lmax and the resulting pow2 grid dims, and whether staging
// succeeds. Localizes the n=645 0-iter screening failure: if staging FAILS or the
// grid is enormous, that is the root cause of the diagonal-fallback at convergence.
//
// args: <deck_dir> <npw_cap>   (npw_cap=0 → full ecut shell n~645)

use "stdlib/qforge/pw_frontend"
use "stdlib/qforge/screening_pwfft"

fn main() {
    let av = args()
    let deck_dir = if len(av) > 1 { av[1] } else {
        "/Users/mini/dancinlab/demiurge/exports/rtsc/decks/CaH6_NC" }
    let npw_cap = if len(av) > 2 { to_int(av[2]) } else { 0 }

    // converged SCF front-end to recover geom + ecut (xc=1, sigma=0.02).
    let fe = qforge_pw_frontend(deck_dir, npw_cap, 1, 0.02, 1236.4)
    if !fe.ok { println("DEFER front-end: " + fe.error) ; return }
    let geom = fe.geom
    let n = fe.n
    println("n(PW)=" + to_string(n) + " ecutwfc=" + to_string(geom.ecutwfc) + " Ry")

    let ecut_ha = if geom.ecutwfc > 0.0 { 0.5 * geom.ecutwfc } else { 0.0 }
    let gvecs = qpw_gvectors(geom.b1, geom.b2, geom.b3, ecut_ha, 4, npw_cap)
    println("gvecs n=" + to_string(len(gvecs) / 3))

    // measure Miller hmax/kmax/lmax exactly as qpwfft_stage does.
    let mut hmax = 0 ; let mut kmax = 0 ; let mut lmax = 0
    let nn = len(gvecs) / 3
    let mut i = 0
    while i < nn {
        let m = qpwfft_miller(gvecs[i*3], gvecs[i*3+1], gvecs[i*3+2], geom.b1, geom.b2, geom.b3)
        let ah = if m[0] < 0 { -m[0] } else { m[0] }
        let ak = if m[1] < 0 { -m[1] } else { m[1] }
        let al = if m[2] < 0 { -m[2] } else { m[2] }
        if ah > hmax { hmax = ah }
        if ak > kmax { kmax = ak }
        if al > lmax { lmax = al }
        i = i + 1
    }
    println("Miller hmax=" + to_string(hmax) + " kmax=" + to_string(kmax) + " lmax=" + to_string(lmax))
    let nx = qpwfft_next_pow2(4 * hmax + 1)
    let ny = qpwfft_next_pow2(4 * kmax + 1)
    let nz = qpwfft_next_pow2(4 * lmax + 1)
    println("pow2 grid = " + to_string(nx) + " x " + to_string(ny) + " x " + to_string(nz)
        + " = " + to_string(nx * ny * nz) + " grid points")

    // actually stage and report on/off.
    let rho_bar = if geom.omega > 0.0 { to_float(fe.nelec) / geom.omega } else { 0.0 }
    let fxc = qforge_fx_lda(rho_bar) + qforge_fc_pw92(rho_bar)
    let ok = qpwfft_stage(gvecs, geom.b1, geom.b2, geom.b3, fxc)
    let dims = qpwfft_grid_dims()
    println("qpwfft_stage ok=" + to_string(ok) + " is_on=" + to_string(qpwfft_is_on())
        + " staged-grid=" + to_string(dims[0]) + "x" + to_string(dims[1]) + "x" + to_string(dims[2]))
    if !ok {
        println("ROOT CAUSE: qpwfft_stage RETURNED FALSE at n=" + to_string(n)
            + " → ad_map falls back to vanishing G-diagonal → 0-iter witness.")
    } else {
        println("STAGE OK at n=" + to_string(n) + " — grid usable; if the converged run was 0-iter,"
            + " the cause is upstream (stale binary / a different staging path).")
    }
}
