// cah6_realcell_etot_monotone_nl.hexa — VARIATIONAL E_tot vs NPW (real cell, KB nonlocal).
//
// STEP 2 of the QFORGE-PERF variational-energy task (demiurge): the prior plateau test
// (cah6_realcell_fdg_monotone_nl) measured the BARE band sum Σocc·ε − σ·S, which double-
// counts Hartree+xc and omits Ewald → could NOT plateau by construction. This fixture
// runs the SAME real CaH6 BCC cell + FULL H (KB nonlocal nprojs=[6,2]) + FDG screening,
// over NPW ∈ {48,64,96,128}, and reports BOTH:
//   (a) F_band = qforge_scf_pw_h_multi_smeared_fdg.e_total  (the OLD bare band sum)
//   (b) E_tot  = qforge_scf_pw_h_multi_smeared_fdg_etot.e_total  (band sum + e_dc + Ewald)
// E_ewald computed ONCE via qforge_ewald (NPW-independent). KEY TEST: does the variational
// E_tot CONVERGE+plateau (|ΔE_tot|_last small) where F_band did not?
use "stdlib/qforge/scf_pw"
use "stdlib/qforge/scf_etot"
use "stdlib/qforge/upf"
use "stdlib/qforge/orchestrator_pw"
use "stdlib/qforge/davidson"
let DECK = "/Users/mini/dancinlab/demiurge/exports/rtsc/decks/CaH6_NC"  // canonical SSOT deck (override per-host)
let SCF_MAXIT = 550
let SCF_MIX = 0.2
fn build_npw(npw: int, mshell: int, b1: [float], b2: [float], b3: [float]) -> [float] {
    let mut gall: [float] = [] ; let mut g2all: [float] = []
    let mut gi = -mshell
    while gi <= mshell {
        let mut gj = -mshell
        while gj <= mshell {
            let mut gk = -mshell
            while gk <= mshell {
                let gx = to_float(gi) * b1[0] + to_float(gj) * b2[0] + to_float(gk) * b3[0]
                let gy = to_float(gi) * b1[1] + to_float(gj) * b2[1] + to_float(gk) * b3[1]
                let gz = to_float(gi) * b1[2] + to_float(gj) * b2[2] + to_float(gk) * b3[2]
                gall.push(gx) ; gall.push(gy) ; gall.push(gz)
                g2all.push(gx * gx + gy * gy + gz * gz)
                gk = gk + 1
            }
            gj = gj + 1
        }
        gi = gi + 1
    }
    let ntot = len(g2all)
    let mut gvecs: [float] = []
    let mut used: [int] = [] ; let mut u = 0 ; while u < ntot { used.push(0) ; u = u + 1 }
    let mut picked = 0
    while picked < npw {
        let mut best = -1 ; let mut bestv = 1.0e30 ; let mut t = 0
        while t < ntot { if used[t] == 0 { if g2all[t] < bestv { bestv = g2all[t] ; best = t } } ; t = t + 1 }
        if best < 0 { break }
        used[best] = 1
        gvecs.push(gall[best * 3]) ; gvecs.push(gall[best * 3 + 1]) ; gvecs.push(gall[best * 3 + 2])
        picked = picked + 1
    }
    return gvecs
}
fn main() {
    println("=== QFORGE CaH6 real-cell VARIATIONAL E_tot vs NPW — FULL H WITH KB NONLOCAL ===")
    let ca = upf_parse(DECK + "/pseudo/Ca_ONCV_PBE_sr.upf")
    let h  = upf_parse(DECK + "/pseudo/H_ONCV_PBE_sr.upf")
    if !ca.ok { println("FAIL Ca UPF: " + ca.error) ; return }
    if !h.ok  { println("FAIL H UPF: "  + h.error)  ; return }
    let zca = ca.header.z_valence ; let zh = h.header.z_valence
    let nelec = to_int(zca + 6.0 * zh) ; let nocc = nelec / 2
    let a = 6.4640 ; let ha = 0.5 * a ; let omega = a * a * a * 0.5
    let tpa = 6.28318530717958647692 / a
    let b1 = [tpa, 0.0, tpa] ; let b2 = [-tpa, tpa, 0.0] ; let b3 = [0.0, -tpa, tpa]
    let hf = [0.25, 0.50, 0.00,  0.50, 0.00, 0.25,  0.00, 0.25, 0.50,
              0.75, 0.50, 0.00,  0.50, 0.00, 0.75,  0.00, 0.75, 0.50]
    let mut pos_h: [float] = []
    let a1 = [ha, ha, ha] ; let a2 = [-ha, ha, ha] ; let a3 = [-ha, -ha, ha]
    let mut ih = 0
    while ih < 6 {
        let f1 = hf[ih * 3] ; let f2 = hf[ih * 3 + 1] ; let f3 = hf[ih * 3 + 2]
        pos_h.push(f1 * a1[0] + f2 * a2[0] + f3 * a3[0])
        pos_h.push(f1 * a1[1] + f2 * a2[1] + f3 * a3[1])
        pos_h.push(f1 * a1[2] + f2 * a2[2] + f3 * a3[2])
        ih = ih + 1
    }
    let nspec = 2
    let mut rs: [float] = [] ; let mut rabs: [float] = [] ; let mut vlocs: [float] = []
    let mut i = 0
    while i < len(ca.r) { rs.push(ca.r[i]) ; rabs.push(ca.rab[i]) ; vlocs.push(ca.vloc[i]) ; i = i + 1 }
    i = 0
    while i < len(h.r) { rs.push(h.r[i]) ; rabs.push(h.rab[i]) ; vlocs.push(h.vloc[i]) ; i = i + 1 }
    let mlens = [len(ca.r), len(h.r)] ; let zs = [zca, zh]
    let mut poss: [float] = []
    poss.push(0.0) ; poss.push(0.0) ; poss.push(0.0)
    i = 0 ; while i < len(pos_h) { poss.push(pos_h[i]) ; i = i + 1 }
    let palens = [1, 6]
    let mut betas: [float] = []
    i=0; while i<len(ca.betas) { betas.push(ca.betas[i]); i=i+1 }
    i=0; while i<len(h.betas)  { betas.push(h.betas[i]);  i=i+1 }
    let mut ls: [int] = []
    i=0; while i<len(ca.ls) { ls.push(ca.ls[i]); i=i+1 }
    i=0; while i<len(h.ls)  { ls.push(h.ls[i]);  i=i+1 }
    let mut dij: [float] = []
    i=0; while i<len(ca.dij) { dij.push(ca.dij[i]); i=i+1 }
    i=0; while i<len(h.dij)  { dij.push(h.dij[i]);  i=i+1 }
    let nprojs = [ca.header.number_of_proj, h.header.number_of_proj]
    let blens = [len(ca.betas), len(h.betas)]
    let dlens = [len(ca.dij), len(h.dij)]
    let k0 = [0.0, 0.0, 0.0] ; let xc_mode = 1
    let sigma = 0.02 ; let nbands = nocc + 4

    // ── E_ewald — the ion-ion Madelung constant for the CaH6 BCC cell (NPW-indep) ──
    //   ions = Ca(q=zca) at origin + 6 H(q=zh). real lattice a1,a2,a3 (bohr), recip
    //   eb1..eb3 (with 2π). eta tuned to the cell (~3/L); nshell=8 for convergence.
    let mut ewpos: [float] = []
    ewpos.push(0.0); ewpos.push(0.0); ewpos.push(0.0)
    i=0; while i<len(pos_h) { ewpos.push(pos_h[i]); i=i+1 }
    let mut ewq: [float] = []
    ewq.push(zca)
    let mut jq = 0; while jq < 6 { ewq.push(zh); jq = jq + 1 }
    let rb = qforge_recip_basis(a1, a2, a3)
    let eb1 = [rb[0], rb[1], rb[2]]
    let eb2 = [rb[3], rb[4], rb[5]]
    let eb3 = [rb[6], rb[7], rb[8]]
    let eta = 0.45
    let e_ewald = qforge_ewald(a1, a2, a3, eb1, eb2, eb3, ewpos, ewq, omega, eta, 8)
    let e_ewald2 = qforge_ewald(a1, a2, a3, eb1, eb2, eb3, ewpos, ewq, omega, 0.60, 8)
    println("E_ewald(eta=0.45)=" + to_string(e_ewald) + "  E_ewald(eta=0.60)=" + to_string(e_ewald2)
            + "  (eta-indep check)")
    let edc = qforge_edc_uniform(to_float(nelec)/omega, nelec, xc_mode)
    println("e_dc(xc double-count, rhobar=nelec/Omega)=" + to_string(edc)
            + "  total const shift e_dc+E_ewald=" + to_string(edc + e_ewald))

    let npws = [48, 64, 96, 128]
    let mshells = [4, 4, 5, 5]
    let mut prevFb = 1.0e30 ; let mut prevEt = 1.0e30
    let mut mono_band = true ; let mut mono_etot = true
    let mut fbvals: [float] = [] ; let mut etvals: [float] = []
    println("NPW  n   F_band(Σocc·ε−σS)    E_tot(variational)")
    let mut ci = 0
    while ci < len(npws) {
        let gvecs = build_npw(npws[ci], mshells[ci], b1, b2, b3)
        let n = len(gvecs) / 3
        let scfb = qforge_scf_pw_h_multi_smeared_fdg(k0, gvecs, nspec, rs, rabs, vlocs, mlens, zs,
                                                     poss, palens, betas, ls, dij,
                                                     nprojs, blens, dlens, omega, xc_mode,
                                                     nbands, nelec, SCF_MIX, 1.0e-6, SCF_MAXIT,
                                                     sigma, 2.0, 6)
        let scfe = qforge_scf_pw_h_multi_smeared_fdg_etot(k0, gvecs, nspec, rs, rabs, vlocs, mlens, zs,
                                                          poss, palens, betas, ls, dij,
                                                          nprojs, blens, dlens, omega, xc_mode,
                                                          nbands, nelec, SCF_MIX, 1.0e-6, SCF_MAXIT,
                                                          sigma, 2.0, 6, e_ewald)
        println(to_string(npws[ci]) + "  " + to_string(n) + "  "
                + to_string(scfb.e_total) + "    " + to_string(scfe.e_total))
        if ci > 0 && scfb.e_total > prevFb + 1.0e-6 { mono_band = false }
        if ci > 0 && scfe.e_total > prevEt + 1.0e-6 { mono_etot = false }
        fbvals.push(scfb.e_total) ; etvals.push(scfe.e_total)
        prevFb = scfb.e_total ; prevEt = scfe.e_total
        ci = ci + 1
    }
    println("── VERDICT (d6 VERBATIM) ──")
    println("F_band monotone = " + to_string(mono_band))
    println("E_tot (variational) monotone = " + to_string(mono_etot))
    let nl = len(fbvals)
    if nl >= 2 {
        let mut db = fbvals[nl-1] - fbvals[nl-2] ; if db < 0.0 { db = -db }
        let mut de = etvals[nl-1] - etvals[nl-2] ; if de < 0.0 { de = -de }
        println("|ΔF_band| last (NPW=" + to_string(npws[nl-2]) + "→" + to_string(npws[nl-1])
                + ") = " + to_string(db) + " Ha")
        println("|ΔE_tot| last (NPW=" + to_string(npws[nl-2]) + "→" + to_string(npws[nl-1])
                + ") = " + to_string(de) + " Ha  (PLATEAU if small, e.g. <1e-2)")
    }
    println("=== DONE ===")
}
