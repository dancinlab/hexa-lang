// scf_etot_selftest — Ewald + xc double-count sanity (QFORGE-PERF variational E_tot).
use "stdlib/qforge/scf_etot"

fn approx(a: float, b: float, tol: float) -> bool {
    let mut d = a - b ; if d < 0.0 { d = -d }
    return d < tol
}

fn main() {
    println("=== scf_etot selftest ===")
    let mut pass = true

    // (1) Ewald of a single point charge in a cubic cell with neutralizing bg.
    //     Madelung-like: well-known NaCl/bcc constants are reference, but here we
    //     pin the SELF + BG analytic pieces by a known limit: for a SINGLE unit
    //     charge q=1 in a cubic box L, the Ewald energy must be NEGATIVE (self +
    //     background dominate) and FINITE. We assert finiteness + sign + eta-
    //     INDEPENDENCE (the hallmark of a correct Ewald split).
    let L = 5.0
    let a1 = [L, 0.0, 0.0] ; let a2 = [0.0, L, 0.0] ; let a3 = [0.0, 0.0, L]
    let tp = 6.28318530717958647692 / L
    let b1 = [tp, 0.0, 0.0] ; let b2 = [0.0, tp, 0.0] ; let b3 = [0.0, 0.0, tp]
    let pos = [0.0, 0.0, 0.0]
    let q = [1.0]
    let omega = L * L * L
    let e1 = qforge_ewald(a1, a2, a3, b1, b2, b3, pos, q, omega, 0.30, 6)
    let e2 = qforge_ewald(a1, a2, a3, b1, b2, b3, pos, q, omega, 0.45, 6)
    println("single q=1 cubic L=5: E(eta=.30)=" + to_string(e1) + "  E(eta=.45)=" + to_string(e2))
    if !approx(e1, e2, 5.0e-3) { println("FAIL eta-independence") ; pass = false }
    if e1 > 0.0 { println("FAIL sign (expect <0 for single charge + bg)") ; pass = false }

    // (2) Two unit charges +1 separated by L/2 in the box: eta-independence again.
    let pos2 = [0.0, 0.0, 0.0,  2.5, 0.0, 0.0]
    let q2 = [1.0, 1.0]
    let e2a = qforge_ewald(a1, a2, a3, b1, b2, b3, pos2, q2, omega, 0.30, 6)
    let e2b = qforge_ewald(a1, a2, a3, b1, b2, b3, pos2, q2, omega, 0.50, 6)
    println("two q=1 sep 2.5: E(.30)=" + to_string(e2a) + "  E(.50)=" + to_string(e2b))
    if !approx(e2a, e2b, 1.0e-2) { println("FAIL two-charge eta-independence") ; pass = false }

    // (3) xc double-count: eps_xc - V_xc for uniform gas, exchange-only.
    //     eps_x = 3/4 V_x  =>  edc_per_e = eps_x - V_x = -1/4 V_x.  For rhobar>0,
    //     V_x<0  =>  edc_per_e = -1/4 V_x > 0.
    let rhobar = 0.05 ; let nelec = 10 ; let xc_x = 0
    let edc = qforge_edc_uniform(rhobar, nelec, xc_x)
    println("edc(rhobar=0.05,nelec=10,x-only)=" + to_string(edc))
    if edc <= 0.0 { println("FAIL edc sign (x-only expect >0)") ; pass = false }
    // analytic: V_x = -(3 rhobar/pi)^(1/3); edc = nelec * (-1/4) V_x
    let vx = -1.0 * pow(3.0 * rhobar / 3.14159265358979323846, 1.0/3.0)
    let edc_ref = to_float(nelec) * (-0.25) * vx
    println("edc analytic ref = " + to_string(edc_ref))
    if !approx(edc, edc_ref, 1.0e-5) { println("FAIL edc analytic") ; pass = false }

    if pass { println("ALL_PASS") } else { println("SOME_FAIL") }
    println("=== DONE ===")
}
