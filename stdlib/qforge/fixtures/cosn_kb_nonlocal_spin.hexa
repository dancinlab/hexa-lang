// cosn_kb_nonlocal_spin.hexa — CoSn Γ LSDA spin SCF WITH KB nonlocal projectors ON.
//
// Lane qforge-magmom-basis (reduced-basis lever). Every prior CoSn fixture
// (cosn_kagome_spin / cosn_gga_gamma / cosn_kmesh*_spin) ran with nprojs=[0,0]
// — LOCAL-ONLY pseudopotential, the nonlocal KB projectors DISABLED. The Co
// ONCV_PBE_sr.upf carries 6 projectors INCLUDING 2 d-channel (l=2) ones — the
// channel that binds the Co-3d shell. With it OFF, the 3d states are unbound
// regardless of PW count, so the m≈0 result is not a clean basis refutation.
//
// This fixture wires the parsed KB projectors (betas/ls/dij from upf.hexa) into
// the SAME g5-verified spin-fast entry (qforge_scf_pw_h_multi_smeared_spin_fast),
// at a TRACTABLE npw, so the d-channel projector localizes the moment without
// brute-force PW (a reduced-basis-style lever).
//
// Run: HEXA_STDLIB_ROOT="$PWD/stdlib" hexa run --no-sentinel stdlib/qforge/fixtures/cosn_kb_nonlocal_spin.hexa
use "stdlib/qforge/scf_pw"
use "stdlib/qforge/upf"
use "stdlib/qforge/davidson"

let DECK = "/Users/mini/dancinlab/demiurge/exports/rtsc/decks/cosn"

fn build_npw(npw: int, mshell: int, b1: [float], b2: [float], b3: [float]) -> [float] {
    let mut gall: [float] = [] ; let mut g2all: [float] = []
    let mut gi = -mshell
    while gi <= mshell {
        let mut gj = -mshell
        while gj <= mshell {
            let mut gk = -mshell
            while gk <= mshell {
                let gx = to_float(gi) * b1[0] + to_float(gj) * b2[0] + to_float(gk) * b3[0]
                let gy = to_float(gi) * b1[1] + to_float(gj) * b2[1] + to_float(gk) * b3[1]
                let gz = to_float(gi) * b1[2] + to_float(gj) * b2[2] + to_float(gk) * b3[2]
                gall.push(gx) ; gall.push(gy) ; gall.push(gz)
                g2all.push(gx * gx + gy * gy + gz * gz)
                gk = gk + 1
            }
            gj = gj + 1
        }
        gi = gi + 1
    }
    let ntot = len(g2all)
    let mut gvecs: [float] = []
    let mut used: [int] = [] ; let mut u = 0 ; while u < ntot { used.push(0) ; u = u + 1 }
    let mut picked = 0
    while picked < npw {
        let mut best = -1 ; let mut bestv = 1.0e30 ; let mut t = 0
        while t < ntot { if used[t] == 0 { if g2all[t] < bestv { bestv = g2all[t] ; best = t } } ; t = t + 1 }
        if best < 0 { break }
        used[best] = 1
        gvecs.push(gall[best * 3]) ; gvecs.push(gall[best * 3 + 1]) ; gvecs.push(gall[best * 3 + 2])
        picked = picked + 1
    }
    return gvecs
}

fn main() {
    println("=== QFORGE CoSn Γ LSDA spin SCF — KB NONLOCAL ON (magmom reduced-basis lever) ===")
    let co = upf_parse(DECK + "/pseudo/Co_ONCV_PBE_sr.upf")
    let sn = upf_parse(DECK + "/pseudo/Sn_ONCV_PBE_sr.upf")
    if !co.ok { println("MISSING-INPUT Co UPF: " + co.error) ; return }
    if !sn.ok { println("MISSING-INPUT Sn UPF: " + sn.error) ; return }
    let zco = co.header.z_valence ; let zsn = sn.header.z_valence
    let nelec = to_int(3.0 * zco + 3.0 * zsn) ; let nocc = nelec / 2

    let a = 9.9760 ; let c = 0.8068 * a ; let r3 = 1.7320508075688772
    let tpa = 6.28318530717958647692 / a ; let tpc = 6.28318530717958647692 / c
    let b1 = [tpa, tpa / r3, 0.0]
    let b2 = [0.0, 2.0 * tpa / r3, 0.0]
    let b3 = [0.0, 0.0, tpc]
    let omega = a * a * c * r3 / 2.0
    let mut poss: [float] = []
    poss.push(a / 2.0) ; poss.push(0.0) ; poss.push(0.0)
    poss.push(-a / 4.0) ; poss.push(a * r3 / 4.0) ; poss.push(0.0)
    poss.push(a / 4.0) ; poss.push(a * r3 / 4.0) ; poss.push(0.0)
    poss.push(0.0) ; poss.push(0.0) ; poss.push(0.0)
    poss.push(0.0) ; poss.push(a * r3 / 3.0) ; poss.push(c / 2.0)
    poss.push(a / 2.0) ; poss.push(a * r3 / 6.0) ; poss.push(c / 2.0)

    let nspec = 2
    // ── radial mesh + Vloc per species (Co then Sn) ──────────────────────────
    let mut rs: [float] = [] ; let mut rabs: [float] = [] ; let mut vlocs: [float] = []
    let mut i = 0
    while i < len(co.r) { rs.push(co.r[i]) ; rabs.push(co.rab[i]) ; vlocs.push(co.vloc[i]) ; i = i + 1 }
    i = 0
    while i < len(sn.r) { rs.push(sn.r[i]) ; rabs.push(sn.rab[i]) ; vlocs.push(sn.vloc[i]) ; i = i + 1 }
    let mlens = [len(co.r), len(sn.r)] ; let zs = [zco, zsn]
    let palens = [3, 3]

    // ── KB nonlocal projector staging (THE LEVER — previously [0,0]) ──────────
    //   betas: flat [Σ_s nproj_s · mesh_s]  (Co betas then Sn betas)
    //   ls:    flat [Σ_s nproj_s]           angular momenta (incl. l=2 d-channel)
    //   dij:   flat [Σ_s nproj_s²]          couplings (Ry)
    //   nprojs[s] = co/sn.header.number_of_proj ; blens[s]=nproj·mesh ; dlens[s]=nproj²
    let nco = co.header.number_of_proj
    let nsn = sn.header.number_of_proj
    let mut betas: [float] = [] ; let mut ls: [int] = [] ; let mut dij: [float] = []
    let mut bi = 0
    while bi < len(co.betas) { betas.push(co.betas[bi]) ; bi = bi + 1 }
    bi = 0
    while bi < len(sn.betas) { betas.push(sn.betas[bi]) ; bi = bi + 1 }
    let mut li = 0
    while li < len(co.ls) { ls.push(co.ls[li]) ; li = li + 1 }
    li = 0
    while li < len(sn.ls) { ls.push(sn.ls[li]) ; li = li + 1 }
    let mut di = 0
    while di < len(co.dij) { dij.push(co.dij[di]) ; di = di + 1 }
    di = 0
    while di < len(sn.dij) { dij.push(sn.dij[di]) ; di = di + 1 }
    let nprojs = [nco, nsn]
    let blens = [len(co.betas), len(sn.betas)]
    let dlens = [nco * nco, nsn * nsn]

    let k0 = [0.0, 0.0, 0.0] ; let xc_mode = 1
    let eb1 = [tpa, 0.0, 0.0] ; let eb2 = [0.0, tpa, 0.0] ; let eb3 = [0.0, 0.0, tpc]
    let sigma = 0.02 ; let nbands = nocc + 8

    // tractable basis (npw≈80, mshell 4) — the d-channel KB projector supplies the
    // short-range Co-3d form factor analytically, so brute-force PW is not needed.
    let gvecs = build_npw(80, 4, b1, b2, b3)
    let n = len(gvecs) / 3
    let mut ndch = 0 ; let mut ll = 0
    while ll < len(co.ls) { if co.ls[ll] == 2 { ndch = ndch + 1 } ll = ll + 1 }
    println("nelec=" + to_string(nelec) + " nbands=" + to_string(nbands) + " NPW=" + to_string(n)
            + " | KB: Co nproj=" + to_string(nco) + " (d-channel l=2 count=" + to_string(ndch) + ") Sn nproj=" + to_string(nsn))

    // seed 1 μ_B/Co (init_mag=3.0 across 3 Co) — let it relax.
    let sp = qforge_scf_pw_h_multi_smeared_spin_fast(k0, gvecs, nspec, rs, rabs, vlocs, mlens, zs,
                                                poss, palens, betas, ls, dij,
                                                nprojs, blens, dlens, omega, xc_mode,
                                                1, 1, n, eb1, eb2, eb3,
                                                nbands, nelec, 0.3, 1.0e-5, 120, sigma, 6, 3.0)
    println("converged=" + to_string(sp.converged) + " iters=" + to_string(sp.iters))
    println("e_total=" + to_string(sp.e_total) + " Ha")
    println("MAGNETIZATION m = " + to_string(sp.magnetization) + " μ_B/cell")
    println("QE ref (PBE, k-mesh): m=0.43 μ_B. Prior local-only(nprojs=[0,0]) Γ: m≈0.")
    if sp.magnetization > 0.05 {
        println("VERDICT: KB-nonlocal ON gives a NON-ZERO Γ moment m=" + to_string(sp.magnetization)
                + " (local-only gave ≈0). Lever moves the needle; magnitude vs QE 0.43 below.")
    } else {
        println("VERDICT: m still ≈0 at Γ even with KB-nonlocal ON — Γ-only Stoner wall holds (BZ-integrated). Next: k-mesh+GPU.")
    }
    println("=== DONE ===")
}
