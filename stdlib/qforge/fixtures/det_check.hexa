use "stdlib/qforge/screening_pwfft"
fn main() {
    let tpa = 1.234   // any nonzero scale
    // BCC reciprocal as the front-end builds it (lines 267-269).
    let b1 = [0.0, tpa, tpa]
    let b2 = [-tpa, 0.0, tpa]
    let b3 = [-tpa, -tpa, 0.0]
    // det of B (columns b1,b2,b3) — same formula qpwfft_miller uses.
    let a11 = b1[0] ; let a12 = b2[0] ; let a13 = b3[0]
    let a21 = b1[1] ; let a22 = b2[1] ; let a23 = b3[1]
    let a31 = b1[2] ; let a32 = b2[2] ; let a33 = b3[2]
    let det = a11 * (a22 * a33 - a23 * a32)
            - a12 * (a21 * a33 - a23 * a31)
            + a13 * (a21 * a32 - a22 * a31)
    println("det(B_BCC) = " + to_string(det) + "  (tpa=" + to_string(tpa) + ")")
    // recover Miller of a known G = 2*b1 + (-3)*b2 + 1*b3 → expect (2,-3,1).
    let gx = 2.0*b1[0] + (-3.0)*b2[0] + 1.0*b3[0]
    let gy = 2.0*b1[1] + (-3.0)*b2[1] + 1.0*b3[1]
    let gz = 2.0*b1[2] + (-3.0)*b2[2] + 1.0*b3[2]
    let m = qpwfft_miller(gx, gy, gz, b1, b2, b3)
    println("G=2b1-3b2+1b3 → Miller recovered=(" + to_string(m[0]) + "," + to_string(m[1]) + "," + to_string(m[2]) + ")  expect (2,-3,1)")
    if det > -1.0e-12 && det < 1.0e-12 {
        println("CONFIRMED: BCC reciprocal det=0 (coplanar) → qpwfft_miller returns (0,0,0) → grid 1x1x1 collapse.")
    }
}
