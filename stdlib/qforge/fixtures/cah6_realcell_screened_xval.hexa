// stdlib/qforge/fixtures/cah6_realcell_screened_xval.hexa — QFORGE breadth (d) XVAL.
//
// The SCREENED cross-val: re-run the CaH6 off-diagonal el-ph→λ with the SCREENED
// perturbation ΔV_scr = ε⁻¹ ΔV_bare (brick (d) screened_dv) instead of the BARE
// ΔV_bare the brick-(b) off-diag fixture used (λ_full=0.000392 vs QE 4.376).
//
// HONESTY (d6/g63 — the metallic-wall hinge): this reports the REAL QFORGE-NC λ
// from the genuine SCREENED full m×n |g_mn| matrix VERBATIM and its rel-ε vs QE
// 4.376. It does NOT tune/force λ→4.376. Screening can RAISE or LOWER λ — the
// induced Δρ opposes the bare Coulomb tail (weakening) but can enhance the
// short-range on-site coupling; the actual direction is reported as-found.
//
// PATH (all verified bricks, d3/d19 reuse — 0-diff existing files):
//   real ONCV UPF → CaH6 BCC cell → PW basis → smeared SCF (converged ρ) →
//   Davidson active ψ_m,ε_m → REAL ΔV_bare(displace 1 H, x) via qforge_dvbare_apply
//   → SCREEN: qforge_screened_dv_columns (Sternheimer Δρ → Hartree+XC kernel →
//   ε⁻¹ ΔV_bare, brick (d)) → FULL |g_mn|² over the active manifold (brick (b)) →
//   el-ph→λ with the Fermi-surface double-δ weight (L3 α²F) → λ, ω_log.
//
// Run: HEXA_STDLIB_ROOT="$PWD/stdlib" hexa run --no-sentinel stdlib/qforge/fixtures/cah6_realcell_screened_xval.hexa
use "stdlib/qforge/scf_pw"
use "stdlib/qforge/upf"
use "stdlib/qforge/orchestrator_pw"
use "stdlib/qforge/orchestrator"
use "stdlib/qforge/davidson"
use "stdlib/qforge/vloc"
use "stdlib/qforge/elph"
use "stdlib/qforge/elph_scf"
use "stdlib/qforge/realcell_phonon"
use "stdlib/qforge/elph_offdiag"
use "stdlib/qforge/screened_dv"
use "stdlib/qforge/screening"
use "stdlib/qforge/tc"
use "stdlib/material/sim"

let DECK = "/Users/mini/dancinlab/demiurge/exports/rtsc/decks/CaH6_NC"

// ── screening kernel closure (d4): Δρ(length n=NPW) → (V_H+f_xc)[Δρ] on the
//    1×1×NPW real-space grid the SCF Hartree used, with the CELL's PHYSICAL
//    grid reciprocal basis (eb1,eb2,eb3 = 2π/a axes) — NOT a unit-spacing wrap.
//    The physical |G|² keeps the Hartree 4π/|G|² gain bounded. NPW=16 pow2 (fft3).
//    Hartree+LDA exchange (mode 1). Basis set in main() from the cell's tpa=2π/a.
let mut SCR_RHO: [float] = []
let SCR_NZ = 64
let mut SCR_B1 = [1.0, 0.0, 0.0]
let mut SCR_B2 = [0.0, 1.0, 0.0]
let mut SCR_B3 = [0.0, 0.0, 1.0]
fn drho_screen(drho: [float]) -> [float] {
    return qforge_dvscf_from_drho(drho, SCR_RHO, 1, 1, SCR_NZ, SCR_B1, SCR_B2, SCR_B3,
                                  qforge_xc_lda_exchange())
}

fn main() {
    println("=== QFORGE breadth (d) — REAL-CELL CaH6 SCREENED ΔV_scr cross-val ===")

    let ca = upf_parse(DECK + "/pseudo/Ca_ONCV_PBE_sr.upf")
    let h  = upf_parse(DECK + "/pseudo/H_ONCV_PBE_sr.upf")
    if !ca.ok { println("FAIL Ca UPF: " + ca.error) ; return }
    if !h.ok  { println("FAIL H UPF: "  + h.error)  ; return }
    let zca = ca.header.z_valence ; let zh = h.header.z_valence
    let nelec = to_int(zca + 6.0 * zh) ; let nocc = nelec / 2

    // ── CaH6 BCC cell (ibrav=3, celldm(1)=6.4640 bohr) ──────────────────────
    let a = 6.4640 ; let ha = 0.5 * a ; let omega = a * a * a * 0.5
    let tpa = 6.28318530717958647692 / a
    let b1 = [tpa, 0.0, tpa] ; let b2 = [-tpa, tpa, 0.0] ; let b3 = [0.0, -tpa, tpa]
    let hf = [0.25, 0.50, 0.00,  0.50, 0.00, 0.25,  0.00, 0.25, 0.50,
              0.75, 0.50, 0.00,  0.50, 0.00, 0.75,  0.00, 0.75, 0.50]
    let pos_ca = [0.0, 0.0, 0.0]
    let mut pos_h: [float] = []
    let a1 = [ha, ha, ha] ; let a2 = [-ha, ha, ha] ; let a3 = [-ha, -ha, ha]
    let mut ih = 0
    while ih < 6 {
        let f1 = hf[ih * 3] ; let f2 = hf[ih * 3 + 1] ; let f3 = hf[ih * 3 + 2]
        pos_h.push(f1 * a1[0] + f2 * a2[0] + f3 * a3[0])
        pos_h.push(f1 * a1[1] + f2 * a2[1] + f3 * a3[1])
        pos_h.push(f1 * a1[2] + f2 * a2[2] + f3 * a3[2])
        ih = ih + 1
    }

    // ── PW G-basis: NPW lowest-|G|² (same convention as off-diag fixture) ────
    // breadth (d) needs a LARGER basis than the bare |g_mn| fixtures: the
    // Sternheimer density response projects the occupied manifold OUT of the PW
    // space, so the conduction subspace (NPW − nactive) must be well-sized or
    // (H−ε_n)|_cond is ill-conditioned and the response diverges (the metallic
    // near-degeneracy, e[6]→e[7] gap ≈ 0.003 Ha). NPW=64 gives ~54 conduction
    // states for a well-conditioned P_c. Native-CPU bounded (7-atom, Γ-only).
    let NPW = 64 ; let M = 4
    let mut gall: [float] = [] ; let mut g2all: [float] = []
    let mut gi = -M
    while gi <= M {
        let mut gj = -M
        while gj <= M {
            let mut gk = -M
            while gk <= M {
                let gx = to_float(gi) * b1[0] + to_float(gj) * b2[0] + to_float(gk) * b3[0]
                let gy = to_float(gi) * b1[1] + to_float(gj) * b2[1] + to_float(gk) * b3[1]
                let gz = to_float(gi) * b1[2] + to_float(gj) * b2[2] + to_float(gk) * b3[2]
                gall.push(gx) ; gall.push(gy) ; gall.push(gz)
                g2all.push(gx * gx + gy * gy + gz * gz)
                gk = gk + 1
            }
            gj = gj + 1
        }
        gi = gi + 1
    }
    let ntot = len(g2all)
    let mut gvecs: [float] = []
    let mut used: [int] = [] ; let mut u = 0 ; while u < ntot { used.push(0) ; u = u + 1 }
    let mut picked = 0
    while picked < NPW {
        let mut best = -1 ; let mut bestv = 1.0e30 ; let mut t = 0
        while t < ntot {
            if used[t] == 0 { if g2all[t] < bestv { bestv = g2all[t] ; best = t } }
            t = t + 1
        }
        if best < 0 { break }
        used[best] = 1
        gvecs.push(gall[best * 3]) ; gvecs.push(gall[best * 3 + 1]) ; gvecs.push(gall[best * 3 + 2])
        picked = picked + 1
    }
    let n = len(gvecs) / 3

    // ── multi-species staging + smeared SCF (same as off-diag fixture) ──────
    let nspec = 2
    let mut rs: [float] = [] ; let mut rabs: [float] = [] ; let mut vlocs: [float] = []
    let mut i = 0
    while i < len(ca.r) { rs.push(ca.r[i]) ; rabs.push(ca.rab[i]) ; vlocs.push(ca.vloc[i]) ; i = i + 1 }
    i = 0
    while i < len(h.r) { rs.push(h.r[i]) ; rabs.push(h.rab[i]) ; vlocs.push(h.vloc[i]) ; i = i + 1 }
    let mlens = [len(ca.r), len(h.r)] ; let zs = [zca, zh]
    let mut poss: [float] = []
    poss.push(pos_ca[0]) ; poss.push(pos_ca[1]) ; poss.push(pos_ca[2])
    i = 0 ; while i < len(pos_h) { poss.push(pos_h[i]) ; i = i + 1 }
    let palens = [1, 6]
    let mut empty_f: [float] = [] ; let mut empty_i: [int] = []
    let nprojs = [0, 0] ; let blens = [0, 0] ; let dlens = [0, 0]
    let k0 = [0.0, 0.0, 0.0] ; let xc_mode = 1
    let eb1 = [tpa, 0.0, 0.0] ; let eb2 = [0.0, tpa, 0.0] ; let eb3 = [0.0, 0.0, tpa]
    let sigma = 0.02 ; let nbands = nocc + 4
    let scf = qforge_scf_pw_h_multi_smeared(k0, gvecs, nspec, rs, rabs, vlocs, mlens, zs,
                                            poss, palens, empty_f, empty_i, empty_f,
                                            nprojs, blens, dlens, omega, xc_mode,
                                            1, 1, n, eb1, eb2, eb3,
                                            nbands, nelec, 0.3, 1.0e-6, 200, sigma, 2.0, 6)
    println("SCF converged=" + to_string(scf.converged) + " iters=" + to_string(scf.iters))

    // ── recover the ACTIVE manifold ψ_m, ε_m + the matrix-free H_apply ──────
    let h_apply = qforge_h_of_rho_multi(scf.rho)
    let mut diag: [float] = [] ; let mut dd = 0
    while dd < n {
        let mut col: [float] = [] ; let mut t = 0
        while t < n { if t == dd { col.push(1.0) } else { col.push(0.0) } ; t = t + 1 }
        let hc = h_apply(col) ; diag.push(hc[dd]) ; dd = dd + 1
    }
    let nactive = nocc + 2
    let dr = qforge_davidson(h_apply, diag, n, nactive, 1.0e-10, 300)
    let mut states: [[float]] = []
    let mut bb = 0
    while bb < nactive {
        let mut v: [float] = [] ; let mut t = 0
        while t < n { v.push(dr.evecs[bb * n + t]) ; t = t + 1 }
        states.push(v) ; bb = bb + 1
    }
    let mut eps_active: [float] = []
    i = 0 ; while i < nactive { eps_active.push(dr.evals[i]) ; i = i + 1 }

    // ── REAL ΔV_bare: displace ONE H atom (index 1 = first H) along x ────────
    let mut dgmag: [float] = []
    let mut ia = 0
    while ia < n {
        let mut ib = 0
        while ib < n {
            let dx = gvecs[ia * 3] - gvecs[ib * 3]
            let dy = gvecs[ia * 3 + 1] - gvecs[ib * 3 + 1]
            let dz = gvecs[ia * 3 + 2] - gvecs[ib * 3 + 2]
            dgmag.push(sqrt(dx * dx + dy * dy + dz * dz))
            ib = ib + 1
        }
        ia = ia + 1
    }
    let vloc_dg = qforge_vloc_of_g(h.r, h.rab, h.vloc, zh, omega, dgmag)   // [n*n]
    let tauH = [poss[3], poss[4], poss[5]]

    // BARE ΔV_bare columns over the active manifold.
    let mut dv_bare: [[float]] = []
    bb = 0
    while bb < nactive {
        let dvn = qforge_dvbare_apply(gvecs, vloc_dg, tauH, 0, states[bb])
        if len(dvn) == 0 { println("FAIL — empty ΔV_bare column") ; return }
        dv_bare.push(dvn) ; bb = bb + 1
    }

    // ── SCREEN: ΔV_scr = ε⁻¹ ΔV_bare (brick (d) self-consistent dielectric) ──
    //   ground ρ sampled onto the SCR grid (here uniform-normalized — Hartree
    //   dominates; LDA exchange uses ρ pointwise). Use the SCF ρ first n entries.
    SCR_RHO = []
    let mut sr = 0
    while sr < SCR_NZ {
        if sr < len(scf.rho) { SCR_RHO.push(scf.rho[sr]) } else { SCR_RHO.push(0.0) }
        sr = sr + 1
    }
    // physical grid reciprocal basis (matches the SCF Hartree eb1,eb2,eb3 = 2π/a).
    SCR_B1 = [tpa, 0.0, 0.0] ; SCR_B2 = [0.0, tpa, 0.0] ; SCR_B3 = [0.0, 0.0, tpa]
    //   β=0.3 linear mixing — the metallic dielectric feedback gain > 1 makes the
    //   un-damped Picard iteration diverge (d15-class instability); damping
    //   stabilizes the screening fixed point on the real CaH6 system.
    let scr = qforge_screened_dv_columns(h_apply, states, eps_active, dv_bare,
                                         drho_screen, 1.0e-8, 120, 0.3)
    if scr.columns.len() != nactive { println("FAIL — screening returned no columns") ; return }
    println("screened-ΔV SCF passes=" + to_string(scr.scf_iters)
            + " converged=" + to_string(scr.converged)
            + " max_residual=" + to_string(scr.max_residual))
    let dv_states = scr.columns

    // screening witness: ‖ΔV_scr‖/‖ΔV_bare‖ on the lowest active state (verbatim).
    let ratio0 = qforge_screening_ratio(dv_bare[0], dv_states[0])
    println("screening ratio ‖ΔV_scr‖/‖ΔV_bare‖ (state 0) = " + to_string(ratio0)
            + "  (<1 = weakened, >1 = enhanced — reported as-found, d6)")

    // ── FULL nb×nb |g_mn| matrix from the SCREENED columns (brick (b)) ──────
    let gmat = qforge_gmn_matrix(states, dv_states)
    let herm = qforge_gmn_herm_residual(gmat, nactive)
    println("|g_mn| matrix " + to_string(nactive) + "×" + to_string(nactive)
            + "  Hermiticity residual Σ|g_mn−g_nm| = " + to_string(herm))

    let mut off_sum = 0.0 ; let mut diag_sum = 0.0
    let mut mm = 0
    while mm < nactive {
        let mut nn = 0
        while nn < nactive {
            let gv = gmat[mm * nactive + nn]
            let ag = if gv < 0.0 { -gv } else { gv }
            if mm == nn { diag_sum = diag_sum + ag } else { off_sum = off_sum + ag }
            nn = nn + 1
        }
        mm = mm + 1
    }
    println("Σ|g_nn| (diagonal) = " + to_string(diag_sum)
            + "   Σ|g_mn| m≠n (off-diagonal) = " + to_string(off_sum))

    // ── el-ph → λ with the Fermi-surface DOUBLE-δ weight (L3 α²F) ────────────
    let omega0 = 1236.4 ; let e_fermi = dr.evals[nocc - 1] ; let n_ef = 1.0
    let mut grid: [float] = []
    let mut gp = 1
    while gp < 401 { grid.push(to_float(gp) * 7.0) ; gp = gp + 1 }
    let sigma_el = 0.05 ; let sigma_ph = 10.0

    // FULL matrix (diagonal + off-diagonal) from the SCREENED |g_mn|.
    let s_full = qforge_gmn_samples(states, dv_states, eps_active, omega0, true, 1.008)  // F1: H mass
    let a2f_full = qforge_a2f_from_elph(s_full[0], s_full[1], s_full[2], s_full[3],
                                        e_fermi, n_ef, grid, 1.0, sigma_el, sigma_ph)
    let mfull = eliashberg_moments_from_a2f_scaled(grid, a2f_full, ha_per_kelvin())  // F2
    let lambda_full = mfull[0] ; let omega_log_full = mfull[1]

    // bare full-matrix baseline (apples-to-apples Δ vs the screened λ).
    let sb_full = qforge_gmn_samples(states, dv_bare, eps_active, omega0, true, 1.008)  // F1: H mass
    let a2f_bare = qforge_a2f_from_elph(sb_full[0], sb_full[1], sb_full[2], sb_full[3],
                                        e_fermi, n_ef, grid, 1.0, sigma_el, sigma_ph)
    let mbare = eliashberg_moments_from_a2f_scaled(grid, a2f_bare, ha_per_kelvin())  // F2
    let lambda_bare = mbare[0]

    println("── SCREENED CROSS-VAL (d6 VERBATIM, NOT tuned) ──")
    println("QFORGE-NC λ (BARE full m×n,    same manifold) = " + to_string(lambda_bare))
    println("QFORGE-NC λ (SCREENED full m×n ΔV_scr)        = " + to_string(lambda_full))
    let lift = if lambda_bare > 0.0 { lambda_full / lambda_bare } else { 0.0 }
    println("screening effect λ_scr/λ_bare                = " + to_string(lift)
            + "  (>1 = screening RAISED λ, <1 = LOWERED)")
    println("QE reference λ                               = 4.376")
    let rel = (lambda_full - 4.376) / 4.376
    let arel = if rel < 0.0 { -rel } else { rel }
    println("rel-ε vs QE 4.376 (screened)                 = " + to_string(arel))
    println("ω_log (screened) = " + to_string(omega_log_full) + " K")
    if arel <= 0.01 { println("VERDICT: CLOSED (within 1%)") }
    else { println("VERDICT: PARTIAL/BLOCKED — broader real λ outside 1%, reported verbatim (d6)") }
    println("=== DONE ===")
}
