// stdlib/qforge/fixtures/cah6_realcell_xval.hexa — QFORGE metallic-unblock 2/2 XVAL.
//
// The REAL-CELL cross-val: re-run the CaH6 el-ph→λ with the REAL ΔV_bare matrix
// element (qforge_dvbare_psi_bundle, brick 2/2) instead of the constant stand-in
// (g_target=0.30) the cah6_scf_run fixture used (which gave λ=0.0208 vs QE 4.376).
//
// HONESTY (d6/g63 — the metallic-wall hinge): this reports the REAL QFORGE-NC λ
// from the genuine matrix element VERBATIM and its rel-ε vs QE 4.376. It does NOT
// tune/force λ→4.376. The number is whatever the real bare |g| over this fixture's
// SCF + basis gives — CLOSED, PARTIAL, or pointing at the next missing brick.
//
// PATH (all verified bricks, d3/d19 reuse — 0-diff existing files):
//   real ONCV UPF → CaH6 BCC cell → PW basis → smeared SCF (converged ρ) →
//   Davidson occ ψ_n,ε_n → REAL ΔV_bare(displace 1 H, x) via qforge_dvbare_psi_bundle
//   → bare |g_nn|² = ⟨ψ_n|ΔV_bare|ψ_n⟩² (Hellmann-Feynman, NO stand-in) →
//   el-ph→Tc tail (same Einstein histogram) → λ, ω_log, Tc.
//
// Run: HEXA_STDLIB_ROOT="$PWD/stdlib" hexa run --no-sentinel stdlib/qforge/fixtures/cah6_realcell_xval.hexa
use "stdlib/qforge/scf_pw"
use "stdlib/qforge/upf"
use "stdlib/qforge/orchestrator_pw"
use "stdlib/qforge/orchestrator"
use "stdlib/qforge/davidson"
use "stdlib/qforge/vloc"
use "stdlib/qforge/elph"
use "stdlib/qforge/elph_scf"
use "stdlib/qforge/realcell_phonon"

let DECK = "/Users/mini/dancinlab/demiurge/exports/rtsc/decks/CaH6_NC"

fn main() {
    println("=== QFORGE metallic 2/2 — REAL-CELL CaH6 cross-val (real ΔV_bare |g|) ===")

    let ca = upf_parse(DECK + "/pseudo/Ca_ONCV_PBE_sr.upf")
    let h  = upf_parse(DECK + "/pseudo/H_ONCV_PBE_sr.upf")
    if !ca.ok { println("FAIL Ca UPF: " + ca.error) ; return }
    if !h.ok  { println("FAIL H UPF: "  + h.error)  ; return }
    let zca = ca.header.z_valence ; let zh = h.header.z_valence
    let nelec = to_int(zca + 6.0 * zh) ; let nocc = nelec / 2

    // ── CaH6 BCC cell (ibrav=3, celldm(1)=6.4640 bohr) ──────────────────────
    let a = 6.4640 ; let ha = 0.5 * a ; let omega = a * a * a * 0.5
    let tpa = 6.28318530717958647692 / a
    let b1 = [0.0, tpa, tpa] ; let b2 = [-tpa, 0.0, tpa] ; let b3 = [-tpa, -tpa, 0.0]
    let hf = [0.25, 0.50, 0.00,  0.50, 0.00, 0.25,  0.00, 0.25, 0.50,
              0.75, 0.50, 0.00,  0.50, 0.00, 0.75,  0.00, 0.75, 0.50]
    let pos_ca = [0.0, 0.0, 0.0]
    let mut pos_h: [float] = []
    let a1 = [ha, ha, ha] ; let a2 = [-ha, ha, ha] ; let a3 = [-ha, -ha, ha]
    let mut ih = 0
    while ih < 6 {
        let f1 = hf[ih * 3] ; let f2 = hf[ih * 3 + 1] ; let f3 = hf[ih * 3 + 2]
        pos_h.push(f1 * a1[0] + f2 * a2[0] + f3 * a3[0])
        pos_h.push(f1 * a1[1] + f2 * a2[1] + f3 * a3[1])
        pos_h.push(f1 * a1[2] + f2 * a2[2] + f3 * a3[2])
        ih = ih + 1
    }

    // ── PW G-basis: NPW lowest-|G|² (same convention as cah6_scf_run) ───────
    let NPW = 16 ; let M = 3
    let mut gall: [float] = [] ; let mut g2all: [float] = []
    let mut gi = -M
    while gi <= M {
        let mut gj = -M
        while gj <= M {
            let mut gk = -M
            while gk <= M {
                let gx = to_float(gi) * b1[0] + to_float(gj) * b2[0] + to_float(gk) * b3[0]
                let gy = to_float(gi) * b1[1] + to_float(gj) * b2[1] + to_float(gk) * b3[1]
                let gz = to_float(gi) * b1[2] + to_float(gj) * b2[2] + to_float(gk) * b3[2]
                gall.push(gx) ; gall.push(gy) ; gall.push(gz)
                g2all.push(gx * gx + gy * gy + gz * gz)
                gk = gk + 1
            }
            gj = gj + 1
        }
        gi = gi + 1
    }
    let ntot = len(g2all)
    let mut gvecs: [float] = []
    let mut used: [int] = [] ; let mut u = 0 ; while u < ntot { used.push(0) ; u = u + 1 }
    let mut picked = 0
    while picked < NPW {
        let mut best = -1 ; let mut bestv = 1.0e30 ; let mut t = 0
        while t < ntot {
            if used[t] == 0 { if g2all[t] < bestv { bestv = g2all[t] ; best = t } }
            t = t + 1
        }
        if best < 0 { break }
        used[best] = 1
        gvecs.push(gall[best * 3]) ; gvecs.push(gall[best * 3 + 1]) ; gvecs.push(gall[best * 3 + 2])
        picked = picked + 1
    }
    let n = len(gvecs) / 3

    // ── multi-species staging + smeared SCF (same as cah6_scf_run) ──────────
    let nspec = 2
    let mut rs: [float] = [] ; let mut rabs: [float] = [] ; let mut vlocs: [float] = []
    let mut i = 0
    while i < len(ca.r) { rs.push(ca.r[i]) ; rabs.push(ca.rab[i]) ; vlocs.push(ca.vloc[i]) ; i = i + 1 }
    i = 0
    while i < len(h.r) { rs.push(h.r[i]) ; rabs.push(h.rab[i]) ; vlocs.push(h.vloc[i]) ; i = i + 1 }
    let mlens = [len(ca.r), len(h.r)] ; let zs = [zca, zh]
    let mut poss: [float] = []
    poss.push(pos_ca[0]) ; poss.push(pos_ca[1]) ; poss.push(pos_ca[2])
    i = 0 ; while i < len(pos_h) { poss.push(pos_h[i]) ; i = i + 1 }
    let palens = [1, 6]
    let mut empty_f: [float] = [] ; let mut empty_i: [int] = []
    let nprojs = [0, 0] ; let blens = [0, 0] ; let dlens = [0, 0]
    let k0 = [0.0, 0.0, 0.0] ; let xc_mode = 1
    let eb1 = [tpa, 0.0, 0.0] ; let eb2 = [0.0, tpa, 0.0] ; let eb3 = [0.0, 0.0, tpa]
    let sigma = 0.02 ; let nbands = nocc + 4
    let scf = qforge_scf_pw_h_multi_smeared(k0, gvecs, nspec, rs, rabs, vlocs, mlens, zs,
                                            poss, palens, empty_f, empty_i, empty_f,
                                            nprojs, blens, dlens, omega, xc_mode,
                                            1, 1, n, eb1, eb2, eb3,
                                            nbands, nelec, 0.3, 1.0e-6, 200, sigma, 2.0, 6)
    println("SCF converged=" + to_string(scf.converged) + " iters=" + to_string(scf.iters))

    // ── recover occupied ψ_n, ε_n by re-diagonalizing H(ρ) ──────────────────
    let h_apply = qforge_h_of_rho_multi(scf.rho)
    let mut diag: [float] = [] ; let mut dd = 0
    while dd < n {
        let mut col: [float] = [] ; let mut t = 0
        while t < n { if t == dd { col.push(1.0) } else { col.push(0.0) } ; t = t + 1 }
        let hc = h_apply(col) ; diag.push(hc[dd]) ; dd = dd + 1
    }
    let dr = qforge_davidson(h_apply, diag, n, nocc, 1.0e-10, 300)
    let mut occ_states: [[float]] = []
    let mut bb = 0
    while bb < nocc {
        let mut v: [float] = [] ; let mut t = 0
        while t < n { v.push(dr.evecs[bb * n + t]) ; t = t + 1 }
        occ_states.push(v) ; bb = bb + 1
    }
    let mut eps_occ: [float] = []
    i = 0 ; while i < nocc { eps_occ.push(dr.evals[i]) ; i = i + 1 }

    // ── REAL ΔV_bare: displace ONE H atom (index 1 = first H) along x ────────
    //   Build the per-ΔG H-species form factor V_loc^H(|G_a−G_b|) over the n×n
    //   difference vectors (the SAME quantity the H assembler uses), then the real
    //   ΔV_bare matrix element via brick 1/2 wired by brick 2/2.
    let mut dgmag: [float] = []
    let mut ia = 0
    while ia < n {
        let mut ib = 0
        while ib < n {
            let dx = gvecs[ia * 3] - gvecs[ib * 3]
            let dy = gvecs[ia * 3 + 1] - gvecs[ib * 3 + 1]
            let dz = gvecs[ia * 3 + 2] - gvecs[ib * 3 + 2]
            dgmag.push(sqrt(dx * dx + dy * dy + dz * dz))
            ib = ib + 1
        }
        ia = ia + 1
    }
    let vloc_dg = qforge_vloc_of_g(h.r, h.rab, h.vloc, zh, omega, dgmag)   // [n*n]
    // τ of the displaced H atom (first H site = poss index 3,4,5).
    let tauH = [poss[3], poss[4], poss[5]]
    println("real ΔV_bare: displace H@(" + to_string(tauH[0]) + "," + to_string(tauH[1])
            + "," + to_string(tauH[2]) + ") along x (vloc_dg len=" + to_string(len(vloc_dg)) + ")")

    // bare ΔV_bare|ψ_n⟩ bundle (brick 2/2 — the stand-in REPLACEMENT).
    let bundle = qforge_dvbare_psi_bundle(gvecs, vloc_dg, tauH, 0, occ_states)
    if len(bundle) == 0 { println("FAIL — empty ΔV_bare bundle") ; return }

    // ── REAL diagonal |g_nn|² = ⟨ψ_n|ΔV_bare|ψ_n⟩² (Hellmann-Feynman, no scalar) ──
    let omega0 = 1236.4 ; let e_fermi = dr.evals[nocc - 1] ; let n_ef = 1.0
    let mut grid: [float] = []
    let mut gp = 1
    while gp < 401 { grid.push(to_float(gp) * 7.0) ; gp = gp + 1 }
    let mut eps_k: [float] = [] ; let mut eps_kq: [float] = []
    let mut g2: [float] = [] ; let mut wq: [float] = []
    let mut g_sum = 0.0
    let mut nn = 0
    while nn < nocc {
        let mut dvn: [float] = [] ; let mut t = 0
        while t < n { dvn.push(bundle[nn * n + t]) ; t = t + 1 }
        let gnn = qforge_realcell_g_diag(occ_states[nn], dvn)
        eps_k.push(eps_occ[nn]) ; eps_kq.push(eps_occ[nn])
        g2.push(gnn * gnn) ; wq.push(omega0)
        let ag = if gnn < 0.0 { -gnn } else { gnn }
        g_sum = g_sum + ag
        nn = nn + 1
    }
    println("REAL |g_nn| (Hellmann-Feynman) Σ|g_nn| over occ = " + to_string(g_sum)
            + "  (stand-in was 8·0.30 = 2.40)")

    let res = qforge_elph_to_tc(eps_k, eps_kq, g2, wq, e_fermi, n_ef, grid,
                                1.0, 0.05, 10.0, 0.10, 256)
    println("── REAL-CELL CROSS-VAL (d6 VERBATIM, NOT tuned) ──")
    println("QFORGE-NC λ (REAL ΔV_bare) = " + to_string(res.lambda))
    println("QE reference λ            = 4.376")
    let rel = (res.lambda - 4.376) / 4.376
    let arel = if rel < 0.0 { -rel } else { rel }
    println("rel-ε vs QE 4.376         = " + to_string(arel))
    println("ω_log = " + to_string(res.omega_log) + " K · Tc_AD = " + to_string(res.tc_ad) + " K")
    if arel <= 0.01 { println("VERDICT: CLOSED (within 1%)") }
    else { println("VERDICT: PARTIAL/BLOCKED — real λ outside 1%, reported verbatim (d6)") }
    println("=== DONE ===")
}
