// stdlib/qforge/fixtures/cah6_paw_round2_b1b2_xval.hexa
//
// QFORGE-PAW round-2 — B1 (LDA→PBE ground-state SCF) + B2 (missing ∂V_NL/∂u)
// MEASUREMENT on the converged real CaH6 cell. Decomposes each lever's Δλ vs the
// established from-scratch baseline (LDA-SCF, local-only ΔV → λ≈1.1545, the
// qforge-offdiag-integrated verdict) and reports vs the re-anchored target ~2.69
// (PNAS 2012, converged PBE+PAW) AND the textbook 4.376, all VERBATIM (d6/@L5).
//
// FOUR configurations on ONE cell (apples-to-apples):
//   (0) BASELINE : LDA-SCF (xc_mode=1, G-diag) + ∂V_loc/∂u only        → λ_base
//   (1) B1       : PBE-SCF (xc_mode=3, RS3D)   + ∂V_loc/∂u only        → λ_B1
//   (2) B2       : LDA-SCF                      + ∂V_loc/∂u + ∂V_NL/∂u  → λ_B2
//   (3) B1+B2    : PBE-SCF                      + ∂V_loc/∂u + ∂V_NL/∂u  → λ_full
//
// Δλ(B1)=λ_B1−λ_base · Δλ(B2)=λ_B2−λ_base · gate: |λ_full−2.69|/2.69 ≤ 1% ?
//
// HONEST (d6): single Einstein ω₀=1236.4 K phonon band + real N(E_F) [c] + bare
// ΔV (the robust, screening-solver-independent vertex). The phonon band + N(E_F)
// are IDENTICAL across all 4 configs (same cell), so they CANCEL in the Δλ
// decomposition — the Δλ reflects PURELY the |g|² change (SCF functional B1 +
// nonlocal vertex B2), which is exactly what this round probes. λ VERBATIM,
// never forced to 2.69/4.376.
//
// Run: hexa run stdlib/qforge/fixtures/cah6_paw_round2_b1b2_xval.hexa
use "stdlib/qforge/scf_pw"
use "stdlib/qforge/scf_pw_realspace"
use "stdlib/qforge/upf"
use "stdlib/qforge/davidson"
use "stdlib/qforge/vloc"
use "stdlib/qforge/elph"
use "stdlib/qforge/realcell_phonon"
use "stdlib/qforge/dos_nef"
use "stdlib/qforge/compose_cah6"
use "stdlib/qforge/projector"
use "stdlib/qforge/dvnl_du"
use "stdlib/qforge/dvnl_du_block"

let DECK = "/Users/mini/dancinlab/demiurge/exports/rtsc/decks/CaH6_NC"
let NPW = 64
let MSHELL = 4
let SCF_MAXIT = 600
let SCF_MIX = 0.2

fn _abs(x: float) -> float { if x < 0.0 { return -x } return x }

// ── λ from a STAGED SCF context (rho + the live H_of_rho globals), ∂V_NL on/off ─
// CRITICAL: qforge_h_of_rho_multi reads MODULE globals (PW_XCMODE / PW_RS3D_ON /
// captured ψ) staged by the LAST SCF call. The caller MUST run the matching SCF
// (LDA via …_smeared, PBE via …_rs3d) IMMEDIATELY before calling this, so the
// staged operator is the right flavor. We re-derive the davidson manifold from
// the staged H here (the SCF `rho` only seeds the diagonal probe), then build the
// bare ∂V_loc/∂u columns (+ ∂V_NL/∂u when with_nl), single-ω₀ band, real N(E_F).
//   rho : the converged density JUST returned by the matching SCF (globals live).
// Returns λ (bare-composed, single Einstein ω₀, real N(E_F)).
fn _lambda_cfg(rho: [float], gvecs: [float], n: int, nactive: int, nocc: int,
               hr: [float], hrab: [float], hbetas: [float], hls: [int], hdij: [float],
               hnproj: int, hvloc: [float], zh: float, omega: float, tauH: [float],
               grid: [float], sig_el: float, sig_ph: float, M_H: float,
               with_nl: bool) -> float {
    // active manifold ψ_m,ε_m via matrix-free H_of_rho + davidson.
    let h_apply = qforge_h_of_rho_multi(rho)
    let mut diag: [float] = [] ; let mut dd = 0
    while dd < n {
        let mut col: [float] = [] ; let mut t = 0
        while t < n { if t == dd { col.push(1.0) } else { col.push(0.0) } ; t = t + 1 }
        let hc = h_apply(col) ; diag.push(hc[dd]) ; dd = dd + 1
    }
    let dr = qforge_davidson(h_apply, diag, n, nactive, 1.0e-10, 300)
    let mut states: [[float]] = [] ; let mut bb = 0
    while bb < nactive {
        let mut v: [float] = [] ; let mut t = 0
        while t < n { v.push(dr.evecs[bb * n + t]) ; t = t + 1 }
        states.push(v) ; bb = bb + 1
    }
    let mut eps_active: [float] = []
    let mut i = 0 ; while i < nactive { eps_active.push(dr.evals[i]) ; i = i + 1 }
    let e_fermi = dr.evals[nocc - 1]
    // manifold probe (physicality: non-degenerate spread, real e_fermi).
    let espread = eps_active[nactive - 1] - eps_active[0]
    println("    [manifold] e_fermi=" + to_string(e_fermi) + " eps[0]=" + to_string(eps_active[0])
            + " eps[last]=" + to_string(eps_active[nactive - 1]) + " spread=" + to_string(espread)
            + " nl=" + to_string(with_nl))

    // ── H local form factor V_loc^H(|ΔG|) over the n×n ΔG grid ────────────────
    let mut dgmag: [float] = []
    let mut ia = 0
    while ia < n {
        let mut ib = 0
        while ib < n {
            let dx = gvecs[ia * 3] - gvecs[ib * 3]
            let dy = gvecs[ia * 3 + 1] - gvecs[ib * 3 + 1]
            let dz = gvecs[ia * 3 + 2] - gvecs[ib * 3 + 2]
            dgmag.push(sqrt(dx * dx + dy * dy + dz * dz))
            ib = ib + 1
        }
        ia = ia + 1
    }
    let vloc_dg = qforge_vloc_of_g(hr, hrab, hvloc, zh, omega, dgmag)

    // ── ∂V_NL/∂u block (B2) — built once, applied per state when with_nl ──────
    let mut nl_block: [float] = []
    if with_nl {
        // β_i(r) padded to mesh; use the H radial mesh + parsed ls/dij.
        nl_block = qforge_dvnl_du_block(hr, hrab, hbetas, hls, hdij, hnproj, omega,
                                        tauH, gvecs, 0)   // q=G at Γ, dir=x
    }

    // ── ΔV columns over the active manifold: ∂V_loc/∂u (+ ∂V_NL/∂u Re) ────────
    let mut dv_states: [[float]] = []
    bb = 0
    while bb < nactive {
        let dvl = qforge_dvbare_apply(gvecs, vloc_dg, tauH, 0, states[bb])
        if len(dvl) == 0 { return -1.0 }
        let mut col: [float] = []
        let mut t = 0
        while t < n { col.push(dvl[t]) ; t = t + 1 }
        if with_nl {
            // (∂V_NL/∂u · ψ)(a) complex → take Re (H real at Γ).
            let dvnl = qforge_dvnl_du_apply(nl_block, states[bb], n)
            if len(dvnl) == 2 * n {
                t = 0
                while t < n { col[t] = col[t] + dvnl[t * 2] ; t = t + 1 }   // + Re part
            }
        }
        dv_states.push(col) ; bb = bb + 1
    }

    // ── single Einstein ω₀ band + real N(E_F) [c] ─────────────────────────────
    let band = [1236.4]
    let mut eps_flat: [float] = []
    bb = 0 ; while bb < nactive { eps_flat.push(eps_active[bb]) ; bb = bb + 1 }
    let n_ef = qforge_dos_nef_uniform(eps_flat, 1, nactive, e_fermi, sig_el)

    let comp = qforge_compose_cah6_lambda(states, dv_states, eps_active, band,
                                          e_fermi, n_ef, grid, sig_el, sig_ph, M_H)
    if comp.ok != 1 { return -1.0 }
    return comp.lambda
}

fn main() {
    println("=== QFORGE-PAW round-2 — B1(PBE-SCF)+B2(∂V_NL/∂u) on real CaH6 ===")
    let ca = upf_parse(DECK + "/pseudo/Ca_ONCV_PBE_sr.upf")
    let h  = upf_parse(DECK + "/pseudo/H_ONCV_PBE_sr.upf")
    if !ca.ok { println("FAIL Ca UPF: " + ca.error) ; return }
    if !h.ok  { println("FAIL H UPF: "  + h.error)  ; return }
    let zca = ca.header.z_valence ; let zh = h.header.z_valence
    let nelec = to_int(zca + 6.0 * zh) ; let nocc = nelec / 2

    let a = 6.4640 ; let ha = 0.5 * a ; let omega = a * a * a * 0.5
    let tpa = 6.28318530717958647692 / a
    let b1 = [tpa, 0.0, tpa] ; let b2 = [-tpa, tpa, 0.0] ; let b3 = [0.0, -tpa, tpa]
    let hf = [0.25, 0.50, 0.00,  0.50, 0.00, 0.25,  0.00, 0.25, 0.50,
              0.75, 0.50, 0.00,  0.50, 0.00, 0.75,  0.00, 0.75, 0.50]
    let a1 = [ha, ha, ha] ; let a2 = [-ha, ha, ha] ; let a3 = [-ha, -ha, ha]
    let mut pos_h: [float] = []
    let mut ih = 0
    while ih < 6 {
        let f1 = hf[ih * 3] ; let f2 = hf[ih * 3 + 1] ; let f3 = hf[ih * 3 + 2]
        pos_h.push(f1 * a1[0] + f2 * a2[0] + f3 * a3[0])
        pos_h.push(f1 * a1[1] + f2 * a2[1] + f3 * a3[1])
        pos_h.push(f1 * a1[2] + f2 * a2[2] + f3 * a3[2])
        ih = ih + 1
    }

    // PW basis: NPW lowest-|G|², CARRYING integer Miller (gi,gj,gk) for RS3D.
    let mut gall: [float] = [] ; let mut g2all: [float] = [] ; let mut mall: [float] = []
    let mut gi = -MSHELL
    while gi <= MSHELL {
        let mut gj = -MSHELL
        while gj <= MSHELL {
            let mut gk = -MSHELL
            while gk <= MSHELL {
                let gx = to_float(gi) * b1[0] + to_float(gj) * b2[0] + to_float(gk) * b3[0]
                let gy = to_float(gi) * b1[1] + to_float(gj) * b2[1] + to_float(gk) * b3[1]
                let gz = to_float(gi) * b1[2] + to_float(gj) * b2[2] + to_float(gk) * b3[2]
                gall.push(gx) ; gall.push(gy) ; gall.push(gz)
                g2all.push(gx * gx + gy * gy + gz * gz)
                mall.push(to_float(gi)) ; mall.push(to_float(gj)) ; mall.push(to_float(gk))
                gk = gk + 1
            }
            gj = gj + 1
        }
        gi = gi + 1
    }
    let ntot = len(g2all)
    let mut gvecs: [float] = [] ; let mut gmiller: [float] = []
    let mut used: [int] = [] ; let mut u = 0 ; while u < ntot { used.push(0) ; u = u + 1 }
    let mut picked = 0
    while picked < NPW {
        let mut best = -1 ; let mut bestv = 1.0e30 ; let mut t = 0
        while t < ntot { if used[t] == 0 { if g2all[t] < bestv { bestv = g2all[t] ; best = t } } ; t = t + 1 }
        if best < 0 { break }
        used[best] = 1
        gvecs.push(gall[best * 3]) ; gvecs.push(gall[best * 3 + 1]) ; gvecs.push(gall[best * 3 + 2])
        gmiller.push(mall[best * 3]) ; gmiller.push(mall[best * 3 + 1]) ; gmiller.push(mall[best * 3 + 2])
        picked = picked + 1
    }
    let n = len(gvecs) / 3

    let nspec = 2
    let mut rs: [float] = [] ; let mut rabs: [float] = [] ; let mut vlocs: [float] = []
    let mut i = 0
    while i < len(ca.r) { rs.push(ca.r[i]) ; rabs.push(ca.rab[i]) ; vlocs.push(ca.vloc[i]) ; i = i + 1 }
    i = 0
    while i < len(h.r) { rs.push(h.r[i]) ; rabs.push(h.rab[i]) ; vlocs.push(h.vloc[i]) ; i = i + 1 }
    let mlens = [len(ca.r), len(h.r)] ; let zs = [zca, zh]
    let mut poss: [float] = []
    poss.push(0.0) ; poss.push(0.0) ; poss.push(0.0)
    i = 0 ; while i < len(pos_h) { poss.push(pos_h[i]) ; i = i + 1 }
    let palens = [1, 6]
    let mut empty_f: [float] = [] ; let mut empty_i: [int] = []
    let nprojs = [0, 0] ; let blens = [0, 0] ; let dlens = [0, 0]
    let k0 = [0.0, 0.0, 0.0]
    let eb1 = [tpa, 0.0, 0.0] ; let eb2 = [0.0, tpa, 0.0] ; let eb3 = [0.0, 0.0, tpa]
    let sigma = 0.02 ; let nbands = nocc + 4 ; let nactive = nocc + 2
    let tauH = [poss[3], poss[4], poss[5]]

    let mut grid: [float] = [] ; let mut gp = 1
    while gp < 401 { grid.push(to_float(gp) * 7.0) ; gp = gp + 1 }
    let sigma_el = 0.05 ; let sigma_ph = 10.0 ; let M_H = 1.008

    // H projectors for B2.
    let h_nproj = len(h.betas) / len(h.r)
    println("[B2] H KB projectors: nproj=" + to_string(h_nproj)
            + " ls=" + to_string(len(h.ls)) + " dij=" + to_string(len(h.dij)))

    // ── LDA-SCF → lam0 (loc) + lam2 (loc+NL); globals staged LDA right here ────
    let scf0 = qforge_scf_pw_h_multi_smeared(k0, gvecs, nspec, rs, rabs, vlocs, mlens, zs,
                                             poss, palens, empty_f, empty_i, empty_f,
                                             nprojs, blens, dlens, omega, 1,
                                             1, 1, n, eb1, eb2, eb3,
                                             nbands, nelec, SCF_MIX, 1.0e-6, SCF_MAXIT, sigma, 2.0, 6)
    println("[SCF LDA]  conv=" + to_string(scf0.converged) + " iters=" + to_string(scf0.iters)
            + " etot=" + to_string(scf0.e_total))
    let lam0 = _lambda_cfg(scf0.rho, gvecs, n, nactive, nocc, h.r, h.rab, h.betas, h.ls, h.dij,
                           h_nproj, h.vloc, zh, omega, tauH, grid, sigma_el, sigma_ph, M_H, false)
    let lam2 = _lambda_cfg(scf0.rho, gvecs, n, nactive, nocc, h.r, h.rab, h.betas, h.ls, h.dij,
                           h_nproj, h.vloc, zh, omega, tauH, grid, sigma_el, sigma_ph, M_H, true)

    // ── PBE-SCF (rs3d) → lam1 (loc) + lam3 (loc+NL); globals staged PBE here ───
    let scf1 = qforge_scf_pw_h_multi_smeared_rs3d(k0, gvecs, gmiller, nspec, rs, rabs, vlocs, mlens, zs,
                                                  poss, palens, empty_f, empty_i, empty_f,
                                                  nprojs, blens, dlens, omega, 3,
                                                  eb1, eb2, eb3,
                                                  nbands, nelec, SCF_MIX, 1.0e-6, SCF_MAXIT, sigma, 2.0, 6)
    println("[SCF PBE]  conv=" + to_string(scf1.converged) + " iters=" + to_string(scf1.iters)
            + " etot=" + to_string(scf1.e_total))
    println("[B1] Δetot(PBE−LDA) = " + to_string(scf1.e_total - scf0.e_total) + " Ha")
    let lam1 = _lambda_cfg(scf1.rho, gvecs, n, nactive, nocc, h.r, h.rab, h.betas, h.ls, h.dij,
                           h_nproj, h.vloc, zh, omega, tauH, grid, sigma_el, sigma_ph, M_H, false)
    let lam3 = _lambda_cfg(scf1.rho, gvecs, n, nactive, nocc, h.r, h.rab, h.betas, h.ls, h.dij,
                           h_nproj, h.vloc, zh, omega, tauH, grid, sigma_el, sigma_ph, M_H, true)

    println("")
    println("══ DECOMPOSITION (bare-composed, single ω₀, real N(E_F); VERBATIM d6) ══")
    println("(0) BASELINE  LDA-SCF + ∂V_loc        λ = " + to_string(lam0))
    println("(1) B1        PBE-SCF + ∂V_loc        λ = " + to_string(lam1)
            + "   Δλ(B1) = " + to_string(lam1 - lam0))
    println("(2) B2        LDA-SCF + ∂V_loc+∂V_NL  λ = " + to_string(lam2)
            + "   Δλ(B2) = " + to_string(lam2 - lam0))
    println("(3) B1+B2     PBE-SCF + ∂V_loc+∂V_NL  λ = " + to_string(lam3))
    println("")
    let reanchor = 2.69 ; let textbook = 4.376
    let rel_re = _abs(lam3 - reanchor) / reanchor
    let rel_tb = _abs(lam3 - textbook) / textbook
    println("re-anchor target ~2.69 (PNAS 2012): rel-ε = " + to_string(rel_re))
    println("textbook 4.376 (under-converged):   rel-ε = " + to_string(rel_tb))
    if rel_re <= 0.01 {
        println("VERDICT: GATE CLOSED — λ_full within 1% of re-anchor 2.69")
    } else {
        println("VERDICT: gate HELD — λ_full=" + to_string(lam3)
                + " outside 1% of 2.69; B1 Δλ=" + to_string(lam1 - lam0)
                + " B2 Δλ=" + to_string(lam2 - lam0) + " (residual reported, d6)")
    }
    println("=== DONE ===")
}
