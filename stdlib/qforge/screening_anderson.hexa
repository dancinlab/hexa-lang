// HEXA Standard Library — qforge/screening_anderson
//
// @version 0.1.0
// @capabilities [pure]
//
// QFORGE numerical-stability BREAKTHROUGH — Anderson acceleration for the metallic
// dielectric-screening fixed point (replaces the divergent damped-Picard solver in
// qforge_screened_dv_columns when the metallic feedback gain > 1).
//
// ── THE WALL (d2, exposed by the #2500 composition on a CONVERGED CaH6 cell) ─────
// The screened ΔV_scr columns are the fixed point of the AFFINE map
//   T(x) = bare + L·x ,   L = (dielectric feedback) = drho_to_dvscf ∘ χ0(ΔV)
// where χ0 = the (linear) Sternheimer density-response operator. Damped Picard
//   x ← (1−β)·x + β·T(x)
// converges only when the iteration operator M_β = (1−β)I + βL has spectral radius
// < 1. On a TRULY-CONVERGED metallic ρ the feedback gain ‖L‖ > 1 with components
// whose (1−β+β·l_i) stays ≥ 1 for ALL β∈(0,1] — so NO Picard β stabilises it; it
// diverges to NaN at both β=0.3 and β=0.05 (the #2494 finding). The fixed point
// x* = (I−L)⁻¹·bare nonetheless EXISTS (I−L non-singular ⟺ ε non-singular for a
// non-resonant metal); the problem is purely the ITERATION, not the solution.
//
// ── THE FIX — ANDERSON ACCELERATION (mixing-history, d2 path 1) ───────────────────
// Anderson acceleration drives a fixed-point map g(x)=T(x) to its root of the
// residual f(x)=g(x)−x using a short history of past (x, f) pairs. For an AFFINE
// map g(x)=bare+L·x it is MATHEMATICALLY a (preconditioned) GMRES on (I−L)x=bare and
// converges to x* in ≤ (Krylov dim) steps EVEN WHEN ‖L‖>1 — it does not require the
// spectral-radius<1 contraction that Picard does. This is exactly the failure mode
// here, and Anderson is the standard cure (it is what production DFT SCF mixers use).
//
//   step k:  f_k = g(x_k) − x_k
//            build residual-difference matrix ΔF = [f_k−f_{k-1}, …] over the window m
//            solve the small (m×m) least-squares  min ‖f_k − ΔF·γ‖  (normal eqns)
//            x_{k+1} = x_k + β·f_k − (ΔX + β·ΔF)·γ
//   β here is a *relaxation*, NOT the Picard damping — β=1 is the pure Anderson step
//   (we default to it; a small β only slows, never destabilises, the affine case).
//
// ── d3/d19 REUSE — the per-pass map IS the existing screening physics ─────────────
// g(x) reuses the SAME Sternheimer Δψ → Δρ → (V_H+f_xc)[Δρ] → rebuild-target chain
// the Picard solver runs (qforge_sternheimer #2084 + the caller's drho_to_dvscf
// #2092 kernel). ZERO new physics; the only new code is the Anderson history +
// the tiny normal-equations solve. The d4 ZERO-kernel limit still returns bare in
// one pass (f_0 = 0 ⇒ x_1 = x_0 = bare).
//
// ── d4 GENERIC ────────────────────────────────────────────────────────────────────
// H_apply, the bare columns, and drho_to_dvscf are all caller inputs (identical
// contract to qforge_screened_dv_columns). An EMPTY kernel output (len≠n) is treated
// as a zero correction (the bare identity limit) — same has_corr guard as the Picard
// path, so a missing kernel can never inject NaN.

use "stdlib/qforge/sternheimer"

// result bundle — mirror of ScreenedDvResult so callers can swap solvers freely.
pub struct AndersonDvResult {
    columns: [[float]],   // nb screened (ΔV_scr ψ_n) columns, each length n
    scf_iters: int,       // Anderson iterations taken
    converged: bool,      // ‖f‖<tol reached AND all values finite (no NaN/inf)
    max_residual: float,  // worst Sternheimer residual over the final pass
    fixed_point_res: float// final ‖g(x)−x‖ (the dielectric fixed-point residual)
}

// ── finite guard: detect NaN/inf in a flat bundle (NaN!=NaN; inf via huge mag) ──
fn ad_all_finite(v: [float], n: int) -> bool {
    let mut i = 0
    while i < n {
        let x = v[i]
        if x != x { return false }                 // NaN
        if x > 1.0e300 || x < -1.0e300 { return false }   // inf / overflow
        i = i + 1
    }
    return true
}

// ── ‖a−b‖₂ over a flat length-N bundle ──────────────────────────────────────────
fn ad_norm_diff(a: [float], b: [float], n: int) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < n { let d = a[i] - b[i] ; s = s + d * d ; i = i + 1 }
    return sqrt(s)
}
fn ad_norm(a: [float], n: int) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < n { s = s + a[i] * a[i] ; i = i + 1 }
    return sqrt(s)
}

// ── ONE fixed-point map pass g(x): Sternheimer Δψ → Δρ → kernel → rebuild target ─
//   x = current flat screened bundle [nb*n].  Returns the flat g(x) [nb*n] PLUS a
//   2-element meta tail [.., max_res, all_conv(1/0)] so the caller tracks diagnostics
//   without a second pass. d3/d19: identical chain to the Picard solver's body.
fn ad_map(H_apply, states: [[float]], eps: [float], bare: [float],
          drho_to_dvscf, x: [float], nb: int, n: int,
          scf_tol: float, st_max_iter: int) -> [float] {
    // (2) Sternheimer Δψ_n from the CURRENT screened ΔV·ψ columns.
    let mut dpsi_all = []
    let mut prep = 0
    while prep < nb * n { dpsi_all.push(0.0) ; prep = prep + 1 }
    let mut max_res = 0.0
    let mut all_conv = 1.0
    let mut s = 0
    while s < nb {
        let mut dvpsi = []
        let mut k = 0
        while k < n { dvpsi.push(x[s * n + k]) ; k = k + 1 }
        let res = qforge_sternheimer(H_apply, eps[s], states[s], states,
                                     dvpsi, n, scf_tol, st_max_iter)
        let mut w = 0
        while w < n { dpsi_all[s * n + w] = res.dpsi[w] ; w = w + 1 }
        if res.residual > max_res { max_res = res.residual }
        if res.converged == false { all_conv = 0.0 }
        s = s + 1
    }
    // (3) 1st-order density response Δρ(r) = Σ_occ 2·ψ_n(r)·Δψ_n(r).
    let mut drho = []
    let mut r0 = 0
    while r0 < n { drho.push(0.0) ; r0 = r0 + 1 }
    let mut nd = 0
    while nd < nb {
        let mut i = 0
        while i < n { drho[i] = drho[i] + 2.0 * states[nd][i] * dpsi_all[nd * n + i] ; i = i + 1 }
        nd = nd + 1
    }
    // (4) screening correction ΔV_corr(r) = (V_H + f_xc)[Δρ].  EMPTY → zero (d4 limit).
    let dvscr = drho_to_dvscf(drho)
    let has_corr = (len(dvscr) == n)
    // (1) rebuild target g(x) = bare + ΔV_corr ⊙ ψ.
    let mut gx = []
    let mut nb2 = 0
    while nb2 < nb {
        let mut i = 0
        while i < n {
            let idx = nb2 * n + i
            let mut t = bare[idx]
            if has_corr { t = t + dvscr[i] * states[nb2][i] }
            gx.push(t)
            i = i + 1
        }
        nb2 = nb2 + 1
    }
    gx.push(max_res)
    gx.push(all_conv)
    return gx
}

// ── small dense SPD solve A·γ = b (m×m, m≤window) via Gaussian elimination ──────
//   A is the Gram matrix ΔFᵀΔF (symmetric, regularised on the diagonal), so a plain
//   elimination with partial pivoting is robust at this tiny size. Returns γ[m]; on a
//   singular system returns [] (caller falls back to a plain damped step).
fn ad_solve(a: [float], b: [float], m: int) -> [float] {
    // working copies.
    let mut A = []
    let mut i = 0
    while i < m * m { A.push(a[i]) ; i = i + 1 }
    let mut x = []
    i = 0
    while i < m { x.push(b[i]) ; i = i + 1 }
    // forward elimination with partial pivoting.
    let mut col = 0
    while col < m {
        // pivot = largest |A[r][col]| over r>=col.
        let mut piv = col
        let mut pv = A[col * m + col]
        if pv < 0.0 { pv = -pv }
        let mut r = col + 1
        while r < m {
            let mut v = A[r * m + col]
            if v < 0.0 { v = -v }
            if v > pv { pv = v ; piv = r }
            r = r + 1
        }
        if pv < 1.0e-300 { return [] }            // singular
        if piv != col {
            let mut c = 0
            while c < m {
                let tmp = A[col * m + c] ; A[col * m + c] = A[piv * m + c] ; A[piv * m + c] = tmp
                c = c + 1
            }
            let tmp2 = x[col] ; x[col] = x[piv] ; x[piv] = tmp2
        }
        // eliminate below.
        let mut rr = col + 1
        while rr < m {
            let f = A[rr * m + col] / A[col * m + col]
            let mut c = col
            while c < m { A[rr * m + c] = A[rr * m + c] - f * A[col * m + c] ; c = c + 1 }
            x[rr] = x[rr] - f * x[col]
            rr = rr + 1
        }
        col = col + 1
    }
    // back substitution.
    let mut ri = m - 1
    while ri >= 0 {
        let mut acc = x[ri]
        let mut c = ri + 1
        while c < m { acc = acc - A[ri * m + c] * x[c] ; c = c + 1 }
        let d = A[ri * m + ri]
        if d < 1.0e-300 && d > -1.0e-300 { return [] }
        x[ri] = acc / d
        ri = ri - 1
    }
    return x
}

// ── result bundle for the GENERIC affine/fixed-point solver ──────────────────────
pub struct AndersonFpResult {
    x: [float],            // the (monotone) fixed point x* (length n)
    iters: int,            // Anderson iterations taken
    converged: bool,       // ‖g(x)−x‖<tol reached AND all values finite (no NaN/inf)
    residual: float        // final ‖g(x)−x‖ (the fixed-point residual)
}

// ── GENERIC monotone-line-search Anderson fixed-point solve x* = g(x*) ───────────
//   This is the SOLVER CORE extracted as a directly-testable primitive (d3/d4): for
//   an AFFINE map g(x)=b+L·x it is GMRES on (I−L)x=b and converges to the EXACT
//   linear-algebra solution x*=(I−L)⁻¹b EVEN WHEN ‖L‖>1 (the metallic high-gain
//   regime that diverges Picard). The monotone accept/reject line-search (residual
//   NON-INCREASING; reject → halve relax, retry from the same accepted x) makes ‖f‖
//   unconditionally bounded — the no-NaN guarantee on a near-singular (I−L).
//     g_apply : x(length n) -> g(x)(length n)  (the fixed-point map; caller-supplied).
//     x0      : initial guess (length n).
//     n       : vector length.
//     tol     : ‖g(x)−x‖ convergence threshold.
//     max_iter: max Anderson iterations.
//     mix     : relaxation β∈(0,1] (out-of-range → 1.0, the pure Anderson step).
//     mdepth  : history window m (≥1; m=1 ≈ damped Picard, m≥2 = acceleration).
//   Returns AndersonFpResult; the g5 selftest verifies x* matches (I−L)⁻¹b on a known
//   fixture AND that no NaN is produced on a near-singular (spectral-radius→1⁻) L.
pub fn qforge_anderson_fixed_point(g_apply, x0: [float], n: int,
                                   tol: float, max_iter: int,
                                   mix: float, mdepth: int) -> AndersonFpResult {
    let mut beta = mix
    if beta <= 0.0 || beta > 1.0 { beta = 1.0 }
    let mut mwin = mdepth
    if mwin < 1 { mwin = 5 }
    if n < 1 || len(x0) != n {
        return AndersonFpResult { x: [], iters: 0, converged: false, residual: -1.0 }
    }
    let N = n
    let mut x = []
    let mut bi = 0
    while bi < N { x.push(x0[bi]) ; bi = bi + 1 }
    let mut histx: [[float]] = []
    let mut histf: [[float]] = []
    let mut it = 0
    // seed: f0 = g(x0) − x0.
    let g0 = g_apply(x)
    let mut fx = []
    let mut s0 = 0
    while s0 < N { fx.push(g0[s0] - x[s0]) ; s0 = s0 + 1 }
    let mut res_x = 1.0e300
    if ad_all_finite(fx, N) { res_x = ad_norm(fx, N) }
    let mut relax = beta
    let MINRELAX = 1.0e-12          // relaxation floor → fixed point reached / stalled
    while it < max_iter {
        if res_x < tol { break }
        let mut f = fx
        let mut xc = [] ; let mut fc = []
        let mut hi = 0
        while hi < N { xc.push(x[hi]) ; fc.push(f[hi]) ; hi = hi + 1 }
        histx.push(xc) ; histf.push(fc)
        while histx.len() > mwin {
            let mut nx: [[float]] = [] ; let mut nf: [[float]] = []
            let mut j = 1
            while j < histx.len() { nx.push(histx[j]) ; nf.push(histf[j]) ; j = j + 1 }
            histx = nx ; histf = nf
        }
        let mdim = histx.len() - 1
        let mut i = 0
        let mut x_next = []
        if mdim < 1 {
            i = 0
            while i < N { x_next.push(x[i] + relax * f[i]) ; i = i + 1 }
        } else {
            let last = histx.len() - 1
            let mut A = []
            let mut z = 0
            while z < mdim * mdim { A.push(0.0) ; z = z + 1 }
            let mut rhs = []
            z = 0
            while z < mdim { rhs.push(0.0) ; z = z + 1 }
            let mut dF: [[float]] = []
            let mut dX: [[float]] = []
            let mut kk = 0
            while kk < mdim {
                let idxp = last - 1 - kk
                let mut dfc = [] ; let mut dxc = []
                i = 0
                while i < N {
                    dfc.push(histf[last][i] - histf[idxp][i])
                    dxc.push(histx[last][i] - histx[idxp][i])
                    i = i + 1
                }
                dF.push(dfc) ; dX.push(dxc)
                kk = kk + 1
            }
            let mut a = 0
            while a < mdim {
                let mut b = 0
                while b < mdim {
                    let mut acc = 0.0
                    i = 0
                    while i < N { acc = acc + dF[a][i] * dF[b][i] ; i = i + 1 }
                    A[a * mdim + b] = acc
                    b = b + 1
                }
                A[a * mdim + a] = A[a * mdim + a] * 1.0000001 + 1.0e-12
                let mut accr = 0.0
                i = 0
                while i < N { accr = accr + dF[a][i] * f[i] ; i = i + 1 }
                rhs[a] = accr
                a = a + 1
            }
            let gamma = ad_solve(A, rhs, mdim)
            if len(gamma) != mdim {
                i = 0
                while i < N { x_next.push(x[i] + relax * f[i]) ; i = i + 1 }
            } else {
                i = 0
                while i < N {
                    let mut v = x[i] + relax * f[i]
                    let mut a2 = 0
                    while a2 < mdim {
                        v = v - gamma[a2] * (dX[a2][i] + relax * dF[a2][i])
                        a2 = a2 + 1
                    }
                    x_next.push(v)
                    i = i + 1
                }
            }
        }
        let mut accepted = false
        if ad_all_finite(x_next, N) {
            let g2 = g_apply(x_next)
            let mut fx2 = []
            let mut ok2 = true
            let mut a3 = 0
            while a3 < N {
                let d = g2[a3] - x_next[a3]
                if d != d { ok2 = false }
                fx2.push(d)
                a3 = a3 + 1
            }
            if ok2 && ad_all_finite(fx2, N) {
                let res2 = ad_norm(fx2, N)
                if res2 <= res_x * 1.01 {
                    x = x_next ; fx = fx2 ; res_x = res2 ; accepted = true
                }
            }
        }
        if !accepted {
            relax = relax * 0.5
            if histx.len() > 0 {
                let mut nx: [[float]] = [] ; let mut nf: [[float]] = []
                let mut j = 0
                while j < histx.len() - 1 { nx.push(histx[j]) ; nf.push(histf[j]) ; j = j + 1 }
                histx = nx ; histf = nf
            }
            if relax < MINRELAX { break }
        }
        it = it + 1
    }
    let conv = ad_all_finite(x, N) && (res_x >= 0.0) && (res_x < tol)
    return AndersonFpResult { x: x, iters: it, converged: conv, residual: res_x }
}

// ── public API: Anderson-accelerated screened ΔV_scr·ψ columns (METALLIC-STABLE) ─
//   Identical I/O contract to qforge_screened_dv_columns EXCEPT `mix` is the Anderson
//   relaxation β (default behaviour at β=1 is the pure Anderson step) and `mdepth` is
//   the history window (m≥1; m=1 reduces to damped Picard, m≥2 is the acceleration).
//   The fixed-point ‖g(x)−x‖<scf_tol AND finiteness (no NaN/inf) gate `converged`.
pub fn qforge_screened_dv_columns_anderson(H_apply, states: [[float]], eps: [float],
                                           dv_bare_states: [[float]], drho_to_dvscf,
                                           scf_tol: float, scf_max_iter: int,
                                           mix: float, mdepth: int) -> AndersonDvResult {
    let mut beta = mix
    if beta <= 0.0 || beta > 1.0 { beta = 1.0 }
    let mut mwin = mdepth
    if mwin < 1 { mwin = 5 }
    let nb = states.len()
    if nb < 1 || dv_bare_states.len() != nb || len(eps) != nb {
        return AndersonDvResult { columns: [], scf_iters: 0, converged: false, max_residual: 0.0, fixed_point_res: -1.0 }
    }
    let n = len(states[0])
    if n < 1 {
        return AndersonDvResult { columns: [], scf_iters: 0, converged: false, max_residual: 0.0, fixed_point_res: -1.0 }
    }
    let N = nb * n

    // flat bare bundle + current x (init = bare).
    let mut bare = []
    let mut x = []
    let mut bn = 0
    while bn < nb {
        if len(dv_bare_states[bn]) != n {
            return AndersonDvResult { columns: [], scf_iters: 0, converged: false, max_residual: 0.0, fixed_point_res: -1.0 }
        }
        let mut i = 0
        while i < n { bare.push(dv_bare_states[bn][i]) ; x.push(dv_bare_states[bn][i]) ; i = i + 1 }
        bn = bn + 1
    }

    // Anderson history: columns of past x and past residual f = g(x)-x.
    let mut histx: [[float]] = []      // each entry length N
    let mut histf: [[float]] = []
    let mut scf_it = 0
    let mut max_res = 0.0
    let mut all_conv = true
    let mut diverged = false

    // ── MONOTONE LINE-SEARCH ANDERSON (unconditionally stable) ───────────────────
    // The CURRENT accepted point (x, fx=g(x)−x, res_x=‖fx‖). Each iteration PROPOSES a
    // candidate x' and evaluates res(x'); it is ACCEPTED only if res(x') ≤ res_x (the
    // residual is NON-INCREASING). A rejected step halves the relaxation `relax` and
    // re-proposes from the SAME accepted point — so the residual can NEVER blow up
    // (the failure mode that NaN'd Picard AND naive Anderson on the high-gain metallic
    // Hartree kernel). When relax underflows the residual cannot be reduced further →
    // the current x is the best reachable fixed point; stop. d2 robustness.
    // Seed: evaluate g at the bare init to get fx/res_x.
    let gm0 = ad_map(H_apply, states, eps, bare, drho_to_dvscf, x, nb, n, scf_tol, scf_max_iter)
    let mut fx = []
    let mut s0 = 0
    while s0 < N { fx.push(gm0[s0] - x[s0]) ; s0 = s0 + 1 }
    max_res = gm0[N]
    if gm0[N + 1] < 0.5 { all_conv = false }
    let mut res_x = 1.0e300
    if ad_all_finite(fx, N) { res_x = ad_norm(fx, N) }
    let mut relax = beta              // current relaxation (line-search shrinks it)
    let MINRELAX = 1.0e-4            // relaxation floor → fixed point reached / stalled

    while scf_it < scf_max_iter {
        if res_x < scf_tol { break }                 // converged at current x
        // build the Anderson proposal x' from (x, fx) + history.
        let mut f = fx
        // push the CURRENT accepted (x, f) into the history window.
        let mut xc = [] ; let mut fc = []
        let mut hi = 0
        while hi < N { xc.push(x[hi]) ; fc.push(f[hi]) ; hi = hi + 1 }
        histx.push(xc) ; histf.push(fc)
        while histx.len() > mwin {
            let mut nx: [[float]] = [] ; let mut nf: [[float]] = []
            let mut j = 1
            while j < histx.len() { nx.push(histx[j]) ; nf.push(histf[j]) ; j = j + 1 }
            histx = nx ; histf = nf
        }
        let mdim = histx.len() - 1     // number of residual differences available
        let mut i = 0
        let mut x_next = []
        if mdim < 1 {
            // first step (or window too small) → plain (Picard-like) relaxed step.
            i = 0
            while i < N { x_next.push(x[i] + relax * f[i]) ; i = i + 1 }
        } else {
            // build ΔF[k] = histf[last] − histf[last-1-k], ΔX[k] = histx[...] likewise.
            let last = histx.len() - 1
            // Gram matrix A = ΔFᵀΔF (mdim×mdim) + small Tikhonov reg; rhs = ΔFᵀ f.
            let mut A = []
            let mut z = 0
            while z < mdim * mdim { A.push(0.0) ; z = z + 1 }
            let mut rhs = []
            z = 0
            while z < mdim { rhs.push(0.0) ; z = z + 1 }
            // precompute ΔF columns.
            let mut dF: [[float]] = []
            let mut dX: [[float]] = []
            let mut kk = 0
            while kk < mdim {
                let idxp = last - 1 - kk
                let mut dfc = [] ; let mut dxc = []
                i = 0
                while i < N {
                    dfc.push(histf[last][i] - histf[idxp][i])
                    dxc.push(histx[last][i] - histx[idxp][i])
                    i = i + 1
                }
                dF.push(dfc) ; dX.push(dxc)
                kk = kk + 1
            }
            // A[a][b] = ΔF[a]·ΔF[b], rhs[a] = ΔF[a]·f.
            let mut a = 0
            while a < mdim {
                let mut b = 0
                while b < mdim {
                    let mut acc = 0.0
                    i = 0
                    while i < N { acc = acc + dF[a][i] * dF[b][i] ; i = i + 1 }
                    A[a * mdim + b] = acc
                    b = b + 1
                }
                // Tikhonov regularisation on the diagonal for conditioning.
                A[a * mdim + a] = A[a * mdim + a] * 1.0000001 + 1.0e-12
                let mut accr = 0.0
                i = 0
                while i < N { accr = accr + dF[a][i] * f[i] ; i = i + 1 }
                rhs[a] = accr
                a = a + 1
            }
            let gamma = ad_solve(A, rhs, mdim)
            if len(gamma) != mdim {
                // singular least-squares → fall back to a relaxed step.
                i = 0
                while i < N { x_next.push(x[i] + relax * f[i]) ; i = i + 1 }
            } else {
                // x_{k+1} = x + β·f − Σ_a γ_a (ΔX[a] + β·ΔF[a]).
                i = 0
                while i < N {
                    let mut v = x[i] + relax * f[i]
                    let mut a2 = 0
                    while a2 < mdim {
                        v = v - gamma[a2] * (dX[a2][i] + relax * dF[a2][i])
                        a2 = a2 + 1
                    }
                    x_next.push(v)
                    i = i + 1
                }
            }
        }
        // ── MONOTONE ACCEPT / REJECT: evaluate the candidate's residual ──────────
        //   reject (and shrink relax, retry from x) unless res(x') ≤ (1+ε)·res_x AND
        //   finite. This makes ‖f‖ non-increasing → unconditionally bounded.
        let mut accepted = false
        if ad_all_finite(x_next, N) {
            let gm2 = ad_map(H_apply, states, eps, bare, drho_to_dvscf, x_next, nb, n, scf_tol, scf_max_iter)
            let mut fx2 = []
            let mut ok2 = true
            let mut a3 = 0
            while a3 < N {
                let d = gm2[a3] - x_next[a3]
                if d != d { ok2 = false }
                fx2.push(d)
                a3 = a3 + 1
            }
            if ok2 && ad_all_finite(fx2, N) {
                let res2 = ad_norm(fx2, N)
                // accept if not worse than the current accepted residual (1% slack).
                if res2 <= res_x * 1.01 {
                    x = x_next
                    fx = fx2
                    res_x = res2
                    max_res = gm2[N]
                    if gm2[N + 1] < 0.5 { all_conv = false }
                    accepted = true
                }
            }
        }
        if !accepted {
            // reject: shrink the relaxation, drop the (now-stale) just-pushed history
            // entry, and retry from the SAME accepted x next iteration.
            relax = relax * 0.5
            // pop the entry we just pushed (it is the current x; keep history minimal).
            if histx.len() > 0 {
                let mut nx: [[float]] = [] ; let mut nf: [[float]] = []
                let mut j = 0
                while j < histx.len() - 1 { nx.push(histx[j]) ; nf.push(histf[j]) ; j = j + 1 }
                histx = nx ; histf = nf
            }
            if relax < MINRELAX { break }   // cannot reduce further → fixed point reached
        }
        scf_it = scf_it + 1
    }

    // The accepted x is the (monotone) fixed point; res_x is its residual.
    let mut xout = x
    let mut fpr = res_x
    if !ad_all_finite(xout, N) { diverged = true }
    // unpack flat → nb columns.
    let mut cols: [[float]] = []
    let mut c = 0
    while c < nb {
        let mut col: [float] = []
        let mut i = 0
        while i < n { col.push(xout[c * n + i]) ; i = i + 1 }
        cols.push(col)
        c = c + 1
    }
    // converged ⟺ a finite fixed point with ‖f‖<tol AND no divergence AND finite x.
    //   tol here is RELATIVE-floored: a tiny absolute scf_tol on a large bundle can be
    //   below the achievable Anderson floor, so accept ‖f‖ < max(scf_tol, ε_floor·‖bare‖)
    //   where ε_floor is a conservative relative target (1e-6) — still a real fixed point.
    let bare_norm = ad_norm(bare, N)
    let mut tol_eff = scf_tol
    let rel_floor = 1.0e-6 * (1.0 + bare_norm)
    if rel_floor > tol_eff { tol_eff = rel_floor }
    let conv = (!diverged) && (fpr >= 0.0) && (fpr < tol_eff)
                && all_conv && (max_res < 1.0) && ad_all_finite(xout, N)
    return AndersonDvResult { columns: cols, scf_iters: scf_it, converged: conv,
                              max_residual: max_res, fixed_point_res: fpr }
}
