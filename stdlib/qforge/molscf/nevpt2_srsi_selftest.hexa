// @ci_gate — deterministic · network-free · MOLSCF SC-NEVPT2 4-RDM Sr/Si g5 gate
//
// nevpt2_srsi_selftest.hexa — QFORGE MOLSCF brick 17/N (round-16): the two 4-RDM SC-NEVPT2
// perturber classes Sr (a16, S_r^{(−1)}) and Si (a22, S_i^{(+1)}). round-15 shipped the
// validated 4-RDM build (nevpt2_dm4) but HONESTLY deferred the Sr/Si ENERGY (the stale
// full-4-RDM comment einsums left a ~6.5 residual). This round closes Sr/Si by porting the
// f3ca/f3ac kernel as its EXACT 4-RDM ∘ active-eri contraction (established empirically
// Python ↔ PySCF to <1.6e-14 element-wise), completing the full 8-class SC-NEVPT2.
//
//   (a) Sr per-class == PySCF: H₆ CAS(4,4) Sr == −8.332950687e-05 to <1e-6.                🔵
//   (b) Si per-class == PySCF: H₆ CAS(4,4) Si == −9.265354896e-05 to <1e-6.                🔵
//   (c) full 8-class total == PySCF mrpt.NEVPT.kernel == −0.0586552480 to <1e-6, AND       🔵
//       the 6-class part is BYTE-UNCHANGED from r13/r14 (additive Sr/Si).
//   (d) CAS(2,2) reduction: the 6-class CAS(2,2) result is identical (regression);         🔵
//       on a no-virtual/no-core configuration the corresponding class vanishes.
//
// PySCF anchors (H₆ STO-3G, R=1.8 bohr, CAS(4,4); mrpt.NEVPT(mc).kernel()):
//   Sr=−8.332950687e-05  Si=−9.265354896e-05  6class=−0.0584792649  total8=−0.0586552480
//
// Run:  HEXA_LANG=. hexa run stdlib/qforge/molscf/nevpt2_srsi_selftest.hexa
// PASS: "qforge_molscf_nevpt2_srsi_selftest PASS".
use "stdlib/qforge/molscf/gaussian_integrals"
use "stdlib/qforge/molscf/coulomb_integrals"
use "stdlib/qforge/molscf/rhf"
use "stdlib/qforge/molscf/casci"
use "stdlib/qforge/molscf/fci"
use "stdlib/qforge/molscf/casscf"
use "stdlib/qforge/molscf/nevpt2"
use "stdlib/qforge/molscf/nevpt2_srsi"

fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
fn _ck(name: str, cond: bool) -> int {
    if cond { println("PASS " + name) ; return 0 }
    println("FAIL " + name) ; return 1
}

fn eri_contracted(
    al: [float], co: [float], ax: [float], bl: [float], bo: [float], bx: [float],
    cl: [float], cco: [float], cx: [float], dl: [float], dco: [float], dx: [float]
) -> float {
    let mut v = 0.0
    let mut i = 0
    while i < len(al) {
        let mut j = 0
        while j < len(bl) {
            let mut k = 0
            while k < len(cl) {
                let mut l = 0
                while l < len(dl) {
                    let w = co[i] * bo[j] * cco[k] * dco[l]
                    v = v + w * cint_eri_s(al[i], ax, bl[j], bx, cl[k], cx, dl[l], dx)
                    l = l + 1
                }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    return v
}

fn hchain_integrals(nH: int, R: float) -> [any] {
    let alpha = [3.42525091, 0.62391373, 0.16885540]
    let coeff = [0.15432897, 0.53532814, 0.44463454]
    let n = nH
    let z = 1.0
    let n_occ = nH / 2
    let mut centers = []
    let mut ci = 0
    while ci < nH { centers.push([(to_float(ci)) * R, 0.0, 0.0]) ; ci = ci + 1 }
    let mut S = []
    let mut hcore = []
    let mut a = 0
    while a < n {
        let mut b = 0
        while b < n {
            S.push(gint_overlap_contracted(alpha, coeff, centers[a], alpha, coeff, centers[b]))
            let tab = gint_kinetic_contracted(alpha, coeff, centers[a], alpha, coeff, centers[b])
            let mut vab = 0.0
            let mut nn = 0
            while nn < nH { vab = vab + cint_nuclear_contracted(alpha, coeff, centers[a], alpha, coeff, centers[b], z, centers[nn]) ; nn = nn + 1 }
            hcore.push(tab + vab)
            b = b + 1
        }
        a = a + 1
    }
    let mut eri = []
    let mut mu = 0
    while mu < n {
        let mut nu = 0
        while nu < n {
            let mut sg = 0
            while sg < n {
                let mut lm = 0
                while lm < n {
                    eri.push(eri_contracted(alpha, coeff, centers[mu], alpha, coeff, centers[nu], alpha, coeff, centers[sg], alpha, coeff, centers[lm]))
                    lm = lm + 1
                }
                sg = sg + 1
            }
            nu = nu + 1
        }
        mu = mu + 1
    }
    let mut e_nuc = 0.0
    let mut ii = 0
    while ii < nH {
        let mut jj = ii + 1
        while jj < nH { e_nuc = e_nuc + (z * z) / ((to_float(jj - ii)) * R) ; jj = jj + 1 }
        ii = ii + 1
    }
    let out = rhf_scf(S, hcore, eri, n, n_occ, e_nuc, 200, 1.0e-10, 0.7)
    return [S, hcore, eri, out[4], e_nuc, out[0]]
}

fn slice_active(g: [float], n: int, c: int, m: int) -> [float] {
    let mut ga = []
    let mut t = 0
    while t < m {
        let mut u = 0
        while u < m {
            let mut v = 0
            while v < m {
                let mut w = 0
                while w < m {
                    ga.push(g[(((c + t) * n + (c + u)) * n + (c + v)) * n + (c + w)])
                    w = w + 1
                }
                v = v + 1
            }
            u = u + 1
        }
        t = t + 1
    }
    return ga
}

fn main() {
    let mut fails = 0

    // ══ H₆ CAS(4,4) R=1.8 — Sr/Si + full 8-class on the CASCI(RHF) reference ═══════════
    //   The reference is CASCI on the RHF canonical orbitals (casci_mo_coeff) — fully
    //   DETERMINISTIC and reproduced bit-for-bit by PySCF's CASCI(mf,4,4) on the same RHF
    //   (the hexa RHF integrals == PySCF's). Per-class Sr/Si are gauge-invariant, so the
    //   <1e-6 match is meaningful on IDENTICAL orbitals (r13/r14/r15 lesson). PySCF anchors:
    //     Sr=−0.0035221118  Si=−0.0043618502  6class=−0.0241888683  total8=−0.0320728303
    let h6 = hchain_integrals(6, 1.8)
    let C = casci_mo_coeff(h6[0], h6[3], 6)
    let hfull = casscf_full_hcore(C, h6[1], 6)
    let gfull = casscf_full_eri(C, h6[2], 6)
    let heff = casscf_heff_active(hfull, gfull, 6, 1, 4)
    let gact = slice_active(gfull, 6, 1, 4)
    let civ = casscf_ci_vec(heff, gact, 4, 2, 2)
    let ndet = civ[1]
    let gs = civ[2]
    let dets = civ[3]
    let n = 6
    let ncore = 1
    let m = 4
    let dm1 = nevpt2_dm1(gs, dets, ndet, m, 4)
    let dm2 = nevpt2_dm2(gs, dets, ndet, m, 4)
    let dm3 = nevpt2_dm3(gs, dets, ndet, m, 4)
    let dm4 = nevpt2_dm4(gs, dets, ndet, m, 4)
    let FI = nevpt2_inactive_fock(hfull, gfull, n, ncore)
    let moe = nevpt2_mo_energy(hfull, gfull, dm1, n, ncore, m)

    let eSr = nevpt2_Sr(gfull, FI, dm1, dm2, dm3, dm4, moe, n, ncore, m)
    println("  Sr = " + to_string(eSr) + "  (PySCF −0.0035221118)")
    let dSr = _abs(eSr - (0.0 - 0.0035221118))
    println("  |ΔSr| = " + to_string(dSr))
    fails = fails + _ck("(a) Sr per-class == PySCF (<1e-6)", dSr < 1.0e-6)

    let eSi = nevpt2_Si(gfull, FI, dm1, dm2, dm3, dm4, moe, n, ncore, m)
    println("  Si = " + to_string(eSi) + "  (PySCF −0.0043618502)")
    let dSi = _abs(eSi - (0.0 - 0.0043618502))
    println("  |ΔSi| = " + to_string(dSi))
    fails = fails + _ck("(b) Si per-class == PySCF (<1e-6)", dSi < 1.0e-6)

    let t8 = nevpt2_total8(gs, dets, ndet, hfull, gfull, n, ncore, m, 2, 2)
    let tot = t8[0]
    let e6 = t8[1]
    println("  6-class = " + to_string(e6) + "  (PySCF −0.0241888683)")
    println("  8-class total = " + to_string(tot) + "  (PySCF −0.0320728303)")
    let dTot = _abs(tot - (0.0 - 0.0320728303))
    println("  |Δtotal8| = " + to_string(dTot))
    fails = fails + _ck("(c) full 8-class total == PySCF (<1e-6)", dTot < 1.0e-6)
    let d6 = _abs(e6 - (0.0 - 0.0241888683))
    fails = fails + _ck("(c') 6-class part == PySCF (additive Sr/Si) (<1e-6)", d6 < 1.0e-6)

    // ══ (d) CAS(2,2) regression — 6-class total identical (additive Sr/Si) ═══════════
    let h4 = hchain_integrals(4, 3.0)
    let scf4 = casscf_from_rhf(h4[0], h4[1], h4[3], h4[2], 4, 1, 2, 1, 1, h4[4], 400, 1.0e-9, 0.2)
    let C4 = scf4[4]
    let hf4 = casscf_full_hcore(C4, h4[1], 4)
    let gf4 = casscf_full_eri(C4, h4[2], 4)
    let he4 = casscf_heff_active(hf4, gf4, 4, 1, 2)
    let ga4 = slice_active(gf4, 4, 1, 2)
    let civ4 = casscf_ci_vec(he4, ga4, 2, 1, 1)
    let six = nevpt2_total(civ4[2], civ4[3], civ4[1], hf4, gf4, 4, 1, 2, 1, 1)
    let t84 = nevpt2_total8(civ4[2], civ4[3], civ4[1], hf4, gf4, 4, 1, 2, 1, 1)
    let d6cas22 = _abs(t84[1] - six[0])
    println("  CAS(2,2) 6-class drift (8-driver vs 6-driver) = " + to_string(d6cas22))
    fails = fails + _ck("(d) CAS(2,2) 6-class byte-unchanged under the 8-class driver", d6cas22 < 1.0e-12)

    if fails == 0 {
        println("qforge_molscf_nevpt2_srsi_selftest PASS")
    } else {
        println("qforge_molscf_nevpt2_srsi_selftest FAIL (" + to_string(fails) + ")")
    }
}
