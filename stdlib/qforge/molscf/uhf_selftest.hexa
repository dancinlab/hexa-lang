// @ci_gate — deterministic · network-free · MOLSCF UHF + DIIS g5 gate
//
// uhf_selftest.hexa — QFORGE MOLSCF brick 7/N (UHF + DIIS + level-shift) g5 gate.
// BREAKS the closed-shell wall: rhf_scf is RHF (doubly-occupied only); uhf_scf
// runs separate α/β spin densities, so a genuine OPEN-SHELL molecule gets a real
// ab-initio SCF energy. Four verdicts, each printed VERBATIM (d6 — no LLM judge):
//
//   (a) UHF == RHF for closed-shell — H₂/STO-3G @1.4 bohr through uhf_scf with
//       n_α = n_β = 1 converges to the SEALED RHF anchor −1.11671 Ha (|Δ|        🔵
//       reported). Proves UHF reduces correctly to RHF when unpolarized.
//   (b) open-shell energy — the H atom (1 electron, doublet, n_α=1 n_β=0,
//       STO-3G) through uhf_scf vs the PySCF/Gaussian STO-3G reference          🔵
//       E = −0.466582 Ha. E_UHF + |Δ| + ⟨S²⟩ reported (⟨S²⟩=0.75 exact, a
//       1-electron doublet is contamination-free). Bonus: triplet H₂ (n_α=2,
//       n_β=0) exercises the α≠β path with two same-spin electrons; ⟨S²⟩=2.0
//       exact for S=1.
//   (c) DIIS acceleration — a STIFF open-shell case (linear H₃ doublet radical,
//       n_α=2 n_β=1) converges in FEWER iterations with DIIS than with plain     🔵
//       density mixing. iters-with vs iters-without reported VERBATIM; both
//       reach the same energy; the DIIS residual ‖FPS−SPF‖→0 at convergence.
//   (d) regression — handled by the r1..r6 selftests (run separately in CI); the
//       closed-shell rhf.hexa path is byte-untouched (UHF is a NEW file).        🔵
//
// HONEST (d6): every converged energy is printed verbatim, references are CITED,
// ⟨S²⟩ contamination is REPORTED (never hidden). The H₃ energy has no standard
// textbook anchor — it is reported verbatim with the internal cross-check that
// DIIS / plain-mixing / level-shift all reach the SAME value (self-consistency),
// while the H-atom −0.466582 Ha is the rock-solid cited open-shell anchor.
//
// Run:  HEXA_LANG=. hexa run stdlib/qforge/molscf/uhf_selftest.hexa
// PASS: "qforge_molscf_uhf_selftest PASS".
use "stdlib/qforge/molscf/gaussian_integrals"
use "stdlib/qforge/molscf/coulomb_integrals"
use "stdlib/qforge/molscf/rhf"
use "stdlib/qforge/molscf/uhf"

fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
fn _ck_close(name: str, got: float, want: float, eps: float) -> int {
    if _abs(got - want) <= eps { println("PASS " + name + " (" + to_string(got) + ")") ; return 0 }
    println("FAIL " + name + " — got " + to_string(got) + " want " + to_string(want)) ; return 1
}
fn _ck_true(name: str, cond: bool) -> int {
    if cond { println("PASS " + name) ; return 0 }
    println("FAIL " + name) ; return 1
}

// contracted (μν|σλ) over single STO-3G 1s contractions (same helper as rhf gate).
fn eri_contracted(
    al: [float], co: [float], ax: [float],
    bl: [float], bo: [float], bx: [float],
    cl: [float], cco: [float], cx: [float],
    dl: [float], dco: [float], dx: [float]
) -> float {
    let mut v = 0.0
    let mut i = 0
    while i < len(al) {
        let mut j = 0
        while j < len(bl) {
            let mut k = 0
            while k < len(cl) {
                let mut l = 0
                while l < len(dl) {
                    let w = co[i] * bo[j] * cco[k] * dco[l]
                    v = v + w * cint_eri_s(al[i], ax, bl[j], bx, cl[k], cx, dl[l], dx)
                    l = l + 1
                }
                k = k + 1
            }
            j = j + 1
        }
        i = i + 1
    }
    return v
}

// STO-3G H 1s primitives (ζ=1.0) — the textbook anchor shared with brick 1/2/3.
fn h1s_alpha() -> [float] { return [3.42525091, 0.62391373, 0.16885540] }
fn h1s_coeff() -> [float] { return [0.15432897, 0.53532814, 0.44463454] }

// Assemble S, H_core, ERI, E_nuc for a chain of N hydrogens on the x-axis at the
// given centers (each a single STO-3G 1s). d4-generic: geometry → matrices, the
// SCF never branches on which molecule this is.
fn build_h_chain(cen: [any], n: int) -> [any] {
    let a = h1s_alpha()
    let c = h1s_coeff()
    let z = 1.0
    let mut S = []
    let mut H = []
    let mut i = 0
    while i < n {
        let mut j = 0
        while j < n {
            S.push(gint_overlap_contracted(a, c, cen[i], a, c, cen[j]))
            let t = gint_kinetic_contracted(a, c, cen[i], a, c, cen[j])
            let mut v = 0.0
            let mut k = 0
            while k < n {
                v = v + cint_nuclear_contracted(a, c, cen[i], a, c, cen[j], z, cen[k])
                k = k + 1
            }
            H.push(t + v)
            j = j + 1
        }
        i = i + 1
    }
    let mut eri = []
    let mut mu = 0
    while mu < n {
        let mut nu = 0
        while nu < n {
            let mut sg = 0
            while sg < n {
                let mut lm = 0
                while lm < n {
                    eri.push(eri_contracted(
                        a, c, cen[mu], a, c, cen[nu],
                        a, c, cen[sg], a, c, cen[lm]))
                    lm = lm + 1
                }
                sg = sg + 1
            }
            nu = nu + 1
        }
        mu = mu + 1
    }
    let mut enuc = 0.0
    let mut A = 0
    while A < n {
        let mut B = A + 1
        while B < n {
            let dx = cen[A][0] - cen[B][0]
            let r = if dx < 0.0 { 0.0 - dx } else { dx }
            enuc = enuc + z * z / r
            B = B + 1
        }
        A = A + 1
    }
    return [S, H, eri, enuc]
}

fn main() {
    let mut fails = 0

    // ══ (a) UHF == RHF for closed-shell — H₂/STO-3G @1.4 bohr, n_α=n_β=1 ════════
    let cenH2 = [[0.0, 0.0, 0.0], [1.4, 0.0, 0.0]]
    let bh2 = build_h_chain(cenH2, 2)
    let S2 = bh2[0]
    let outA = uhf_scf(S2, bh2[1], bh2[2], 2, 1, 1, bh2[3], 100, 1.0e-11, 1.0, true, 0.0)
    let eA = outA[0]
    let s2A = uhf_spin_squared(outA[9], outA[10], S2, 2, 1, 1)
    println("── (a) H₂ closed-shell via UHF (n_α=n_β=1) ──")
    println("  E_UHF   = " + to_string(eA) + "  Ha")
    println("  E_RHF anchor = −1.11671 Ha   |Δ| = " + to_string(_abs(eA - (0.0 - 1.11671))))
    println("  ⟨S²⟩ = " + to_string(s2A) + "  (singlet exact 0.0)")
    fails = fails + _ck_close("(a) UHF(α=β) == sealed RHF anchor −1.11671 Ha",
                              eA, 0.0 - 1.11671, 1.0e-4)
    fails = fails + _ck_true("(a) UHF closed-shell converged", outA[11])
    fails = fails + _ck_close("(a) ⟨S²⟩ singlet = 0", s2A, 0.0, 1.0e-7)

    // ══ (b) open-shell — H atom (n_α=1, n_β=0) vs PySCF STO-3G −0.466582 Ha ═════
    let a = h1s_alpha()
    let c = h1s_coeff()
    let O = [0.0, 0.0, 0.0]
    let s11 = gint_overlap_contracted(a, c, O, a, c, O)
    let t11 = gint_kinetic_contracted(a, c, O, a, c, O)
    let v11 = cint_nuclear_contracted(a, c, O, a, c, O, 1.0, O)
    let Sh = [s11]
    let Hh = [t11 + v11]
    let eri_h = [eri_contracted(a, c, O, a, c, O, a, c, O, a, c, O)]
    let outB = uhf_scf(Sh, Hh, eri_h, 1, 1, 0, 0.0, 100, 1.0e-11, 1.0, true, 0.0)
    let eB = outB[0]
    let s2B = uhf_spin_squared(outB[9], outB[10], Sh, 1, 1, 0)
    let ref_h = 0.0 - 0.466582           // PySCF/Gaussian UHF/STO-3G H atom
    println("── (b) H atom open-shell via UHF (n_α=1, n_β=0) ──")
    println("  E_UHF = " + to_string(eB) + "  Ha   (PySCF STO-3G ref −0.466582)")
    println("  |Δ|   = " + to_string(_abs(eB - ref_h)))
    println("  ⟨S²⟩  = " + to_string(s2B) + "  (exact S(S+1)=0.75 — doublet, contamination-free)")
    fails = fails + _ck_close("(b) H atom UHF E vs PySCF STO-3G −0.466582 Ha",
                              eB, ref_h, 1.0e-5)
    fails = fails + _ck_true("(b) H atom UHF converged", outB[11])
    fails = fails + _ck_close("(b) H atom ⟨S²⟩ = 0.75 (exact doublet)", s2B, 0.75, 1.0e-9)

    // bonus: triplet H₂ (n_α=2, n_β=0) — α≠β with two same-spin electrons.
    let outT = uhf_scf(S2, bh2[1], bh2[2], 2, 2, 0, bh2[3], 100, 1.0e-11, 1.0, true, 0.0)
    let s2T = uhf_spin_squared(outT[9], outT[10], S2, 2, 2, 0)
    println("  bonus triplet H₂ (n_α=2,n_β=0): E = " + to_string(outT[0])
            + "  ⟨S²⟩ = " + to_string(s2T) + "  (exact S=1 → 2.0)")
    fails = fails + _ck_true("(b) triplet H₂ converged", outT[11])
    fails = fails + _ck_close("(b) triplet H₂ ⟨S²⟩ = 2.0 (exact S=1)", s2T, 2.0, 1.0e-7)

    // ══ (c) DIIS acceleration — stiff linear H₃ doublet radical (n_α=2, n_β=1) ══
    //   Three H on the x-axis, R=1.8 bohr spacing. The near-degenerate symmetric
    //   chain makes plain density mixing slow; DIIS cuts the iteration count.
    let R = 1.8
    let cenH3 = [[0.0, 0.0, 0.0], [R, 0.0, 0.0], [2.0 * R, 0.0, 0.0]]
    let bh3 = build_h_chain(cenH3, 3)
    let S3 = bh3[0]
    // plain mixing, NO DIIS.
    let noD = uhf_scf(S3, bh3[1], bh3[2], 3, 2, 1, bh3[3], 500, 1.0e-9, 1.0, false, 0.0)
    // with DIIS.
    let wD = uhf_scf(S3, bh3[1], bh3[2], 3, 2, 1, bh3[3], 500, 1.0e-9, 1.0, true, 0.0)
    let iters_no = noD[1]
    let iters_di = wD[1]
    let eH3 = wD[0]
    let s2H3 = uhf_spin_squared(wD[9], wD[10], S3, 3, 2, 1)
    println("── (c) DIIS acceleration — linear H₃ doublet radical (R=1.8 bohr) ──")
    println("  iters WITHOUT DIIS (plain mix) = " + to_string(iters_no))
    println("  iters WITH    DIIS            = " + to_string(iters_di))
    println("  E_UHF (both) = " + to_string(eH3) + "  Ha   (no-DIIS E = " + to_string(noD[0]) + ")")
    println("  DIIS residual ‖FPS−SPF‖ at conv = " + to_string(wD[12]))
    println("  ⟨S²⟩ = " + to_string(s2H3) + "  (exact doublet 0.75 → contamination "
            + to_string(s2H3 - 0.75) + ")")
    fails = fails + _ck_true("(c) H₃ radical converged with DIIS", wD[11])
    fails = fails + _ck_true("(c) H₃ radical converged without DIIS", noD[11])
    fails = fails + _ck_true("(c) DIIS REDUCES iteration count (di < no)",
                             iters_di < iters_no)
    fails = fails + _ck_close("(c) DIIS and plain-mix reach SAME energy",
                              eH3, noD[0], 1.0e-6)
    fails = fails + _ck_true("(c) DIIS residual ‖FPS−SPF‖ → 0 (< 1e-6)",
                             wD[12] < 1.0e-6)
    fails = fails + _ck_true("(c) ⟨S²⟩ > exact 0.75 (UHF contamination, honest)",
                             s2H3 > 0.75)

    // ══ generic guards — DIIS B-matrix solver + spin density round-trips ═══════
    //   tiny 2×2 linear solve: [[2,1],[1,3]] x = [3,5] → x = [0.8, 1.4].
    let xs = uhf_lin_solve([2.0, 1.0, 1.0, 3.0], [3.0, 5.0], 2)
    fails = fails + _ck_close("(guard) lin_solve 2×2 x0", xs[0], 0.8, 1.0e-9)
    fails = fails + _ck_close("(guard) lin_solve 2×2 x1", xs[1], 1.4, 1.0e-9)
    //   single-spin density trace: tr(P^α S) = n_α for an orthonormal H₂ build.
    let Pa = outA[3]
    let psA = rhf_matmul(Pa, S2, 2)
    fails = fails + _ck_close("(guard) tr(P^α S) = n_α = 1", psA[0] + psA[3], 1.0, 1.0e-8)

    if fails == 0 {
        println("qforge_molscf_uhf_selftest PASS")
    } else {
        println("qforge_molscf_uhf_selftest FAIL (" + to_string(fails) + ")")
    }
}
