// @ci_gate — deterministic · network-free · Anderson metallic-screening g5 gate
//
// screening_anderson_selftest.hexa — QFORGE numerical-stability BREAKTHROUGH g5 gate.
//   qforge_screened_dv_columns_anderson drives the SAME dielectric fixed point as the
//   damped-Picard qforge_screened_dv_columns (#2494) but with Anderson acceleration,
//   so it converges on a metallic feedback gain ‖L‖>1 where Picard diverges to NaN.
//
// Verification cases (the task's g5 list):
//   🔵 (A) ZERO-KERNEL identity (d4): kernel → [] ⇒ Anderson returns bare EXACTLY in
//          one pass (f_0=0). The bare path is the d4 identity limit.
//   🟢 (B) METALLIC HIGH-GAIN STABILITY: on a fixture whose dielectric feedback gain
//          > 1 (an AMPLIFYING kernel — the metallic instability that NaN'd #2494's
//          Picard at every β), Picard does NOT converge (converged=false or NaN);
//          Anderson DOES converge to a FINITE fixed point (no NaN/inf).
//   🔵 (C) ε(q→0) SANITY: the screened result is finite and the dielectric effective
//          factor ε_eff = ‖ΔV_bare‖/‖ΔV_scr‖ is finite and ≥ a physical floor (no
//          amplification blow-up; the fixed point is bounded).
//   🔵 (D) ZERO-KERNEL → BARE (d4) under Anderson with the EMPTY kernel guard: a
//          missing kernel never injects NaN — converged=true, columns==bare.
//   🟢 (E) COMPOSED λ FINITE: feeding the Anderson screened columns into the verified
//          composer (qforge_compose_cah6_lambda) yields a FINITE, non-negative λ.
//   🔵 (F) MALFORMED guard: bare-column count mismatch → empty columns, not converged.
//
// Run: HEXA_STDLIB_ROOT="$PWD/stdlib" hexa run --no-sentinel stdlib/qforge/screening_anderson_selftest.hexa
// PASS: "qforge_screening_anderson_selftest PASS".
use "stdlib/qforge/screening_anderson"
use "stdlib/qforge/screened_dv"
use "stdlib/qforge/compose_cah6"
use "stdlib/alloc/math/eigen"

fn _abs(x: float) -> float { if x < 0.0 { return -x } return x }
fn _finite(x: float) -> bool {
    if x != x { return false }
    if x > 1.0e300 || x < -1.0e300 { return false }
    return true
}
fn _ck_bool(name: str, got: bool, want: bool) -> int {
    if got == want { println("PASS " + name + " (" + to_string(got) + ")") ; return 0 }
    println("FAIL " + name + " — got " + to_string(got) + " want " + to_string(want)) ; return 1
}
fn _ck_lt(name: str, got: float, bound: float) -> int {
    if got < bound { println("PASS " + name + " (" + to_string(got) + " < " + to_string(bound) + ")") ; return 0 }
    println("FAIL " + name + " — got " + to_string(got) + " NOT < " + to_string(bound)) ; return 1
}
fn _ck_ge(name: str, got: float, bound: float) -> int {
    if got >= bound { println("PASS " + name + " (" + to_string(got) + " >= " + to_string(bound) + ")") ; return 0 }
    println("FAIL " + name + " — got " + to_string(got) + " NOT >= " + to_string(bound)) ; return 1
}

// ── matrix-free H·v from an explicit dense symmetric matrix (d19 idiom) ──────
let mut G_MAT = []
let mut G_N = 0
fn h_apply(v: [float]) -> [float] {
    let mut out = []
    let mut i = 0
    while i < G_N {
        let mut s = 0.0
        let mut j = 0
        while j < G_N { s = s + G_MAT[i * G_N + j] * v[j] ; j = j + 1 }
        out.push(s)
        i = i + 1
    }
    return out
}

// ── ZERO kernel (returns [] → screened == bare, d4 identity) ─────────────────
fn drho_zero(drho: [float]) -> [float] { return [] }

// ── AMPLIFYING (high-gain) kernel: ΔV_corr(r) = +GAIN·Δρ(r).  A POSITIVE local
//    kernel with GAIN large enough that the dielectric feedback gain exceeds 1 —
//    the metallic instability that diverged #2494's Picard. Note the response Δρ on
//    this fixture builds POSITIVE feedback, so Picard amplifies each pass; Anderson
//    (GMRES on the affine map) still finds the bounded fixed point. ────────────
let mut G_GAIN = 0.0
fn drho_amplify(drho: [float]) -> [float] {
    let n = len(drho)
    let mut out: [float] = []
    let mut i = 0
    while i < n { out.push(G_GAIN * drho[i]) ; i = i + 1 }
    return out
}

// ── EXPLICIT AFFINE MAP g(x)=b+L·x with a KNOWN closed-form fixed point ──────
//   The g5 linear-algebra identity: the Anderson core solves (I−L)x=b → x*. We use
//   an L whose spectral radius EXCEEDS 1 (the metallic high-gain regime: Picard
//   x←(1−β)x+βg(x) DIVERGES) yet (I−L) is non-singular, so x*=(I−L)⁻¹b EXISTS and is
//   computable independently (Gaussian elimination here). Anderson (= GMRES on the
//   affine map) must reproduce x* to tol. dim=4. d4: g_apply is a caller closure.
let mut L_MAT: [float] = []      // n×n linear part L
let mut L_B:   [float] = []      // affine offset b
let mut L_N = 0
fn affine_map(x: [float]) -> [float] {
    // g(x) = b + L·x.
    let mut out: [float] = []
    let mut i = 0
    while i < L_N {
        let mut s = L_B[i]
        let mut j = 0
        while j < L_N { s = s + L_MAT[i * L_N + j] * x[j] ; j = j + 1 }
        out.push(s)
        i = i + 1
    }
    return out
}
// solve (I−L)x = b directly (reference x*); plain Gaussian elimination w/ pivoting.
fn iml_solve(Lm: [float], b: [float], n: int) -> [float] {
    let mut A: [float] = []
    let mut i = 0
    while i < n {
        let mut j = 0
        while j < n {
            let id = if i == j { 1.0 } else { 0.0 }
            A.push(id - Lm[i * n + j]) ; j = j + 1
        }
        i = i + 1
    }
    let mut x: [float] = []
    i = 0 ; while i < n { x.push(b[i]) ; i = i + 1 }
    let mut col = 0
    while col < n {
        let mut piv = col ; let mut pv = _abs(A[col * n + col])
        let mut r = col + 1
        while r < n { let v = _abs(A[r * n + col]) ; if v > pv { pv = v ; piv = r } ; r = r + 1 }
        if piv != col {
            let mut c = 0
            while c < n { let t = A[col*n+c] ; A[col*n+c] = A[piv*n+c] ; A[piv*n+c] = t ; c = c + 1 }
            let t2 = x[col] ; x[col] = x[piv] ; x[piv] = t2
        }
        let mut rr = col + 1
        while rr < n {
            let f = A[rr*n+col] / A[col*n+col]
            let mut c = col
            while c < n { A[rr*n+c] = A[rr*n+c] - f * A[col*n+c] ; c = c + 1 }
            x[rr] = x[rr] - f * x[col]
            rr = rr + 1
        }
        col = col + 1
    }
    let mut ri = n - 1
    while ri >= 0 {
        let mut acc = x[ri]
        let mut c = ri + 1
        while c < n { acc = acc - A[ri*n+c] * x[c] ; c = c + 1 }
        x[ri] = acc / A[ri*n+ri]
        ri = ri - 1
    }
    return x
}

fn main() {
    let mut fails = 0
    let N = 8
    let TOL = 1.0e-8

    // ── 8×8 symmetric H with small spectral gaps (near-degenerate → strong
    //    Sternheimer response → easy to push the feedback gain past 1). ──────
    let mut M = []
    let mut ii = 0
    while ii < N {
        let mut jj = 0
        while jj < N {
            if ii == jj { M.push(1.0 + 0.05 * to_float(ii)) }   // tightly-packed diagonal
            else {
                let d = if ii > jj { ii - jj } else { jj - ii }
                M.push(0.10 / to_float(d))
            }
            jj = jj + 1
        }
        ii = ii + 1
    }
    G_MAT = M ; G_N = N

    let eg = eigh(M, N)
    let vals = eg[0] ; let vecs = eg[1]
    let mut eps = [] ; let mut psi = []
    let mut s0 = 0
    while s0 < N { eps.push(vals[N - 1 - s0]) ; psi.push(vecs[N - 1 - s0]) ; s0 = s0 + 1 }

    let NB = 3
    let mut states: [[float]] = []
    let mut eps_a: [float] = []
    let mut a = 0
    while a < NB { states.push(psi[a]) ; eps_a.push(eps[a]) ; a = a + 1 }

    // bare columns: smooth long-range profile + state mixing.
    let mut dv_bare: [[float]] = []
    let mut b = 0
    while b < NB {
        let mut col: [float] = []
        let mut i = 0
        while i < N {
            let phase = 6.28318530717958647692 * to_float(i) / to_float(N)
            col.push(cos(phase) * (1.0 + 0.3 * states[b][i]))
            i = i + 1
        }
        dv_bare.push(col)
        b = b + 1
    }

    // ── (A) ZERO-KERNEL identity under Anderson: screened == bare, one pass ──
    let r0 = qforge_screened_dv_columns_anderson(h_apply, states, eps_a, dv_bare,
                                                 drho_zero, TOL, 80, 1.0, 5)
    let mut maxdiff = 0.0
    let mut c = 0
    while c < NB {
        let mut i = 0
        while i < N {
            let d = _abs(r0.columns[c][i] - dv_bare[c][i])
            if d > maxdiff { maxdiff = d }
            i = i + 1
        }
        c = c + 1
    }
    fails = fails + _ck_lt("(A) zero-kernel == bare (max|Δ|)", maxdiff, 1.0e-12)
    fails = fails + _ck_bool("(A) zero-kernel one-pass converged", r0.converged, true)

    // ── (B) METALLIC HIGH-GAIN: a feedback gain where damped Picard NaN's. ──
    //   Probe finding: at β=0.05 Picard converges up to gain≈5 then DIVERGES to NaN at
    //   gain≥8 (the converged-metal regime that NaN'd #2494). GAIN=8 is the smallest
    //   gain where Picard NaN's — assert Picard fails AND Anderson finds a finite,
    //   converged fixed point at the SAME gain (the breakthrough, d2).
    G_GAIN = 8.0
    // Picard (the #2494 solver) at the most-damped β it allowed:
    let pic = qforge_screened_dv_columns(h_apply, states, eps_a, dv_bare,
                                         drho_amplify, TOL, 200, 0.05)
    // Picard must NOT reach a clean converged fixed point here (diverges / NaN).
    let pic_col0_finite = if pic.columns.len() == NB { _finite(pic.columns[0][0]) } else { false }
    let pic_failed = (pic.converged == false) || (!pic_col0_finite)
    fails = fails + _ck_bool("(B) Picard diverges at metallic gain (β=0.05)", pic_failed, true)

    // Anderson at the SAME gain → finite, converged fixed point.
    let and = qforge_screened_dv_columns_anderson(h_apply, states, eps_a, dv_bare,
                                                  drho_amplify, TOL, 300, 1.0, 5)
    fails = fails + _ck_bool("(B) Anderson columns present", and.columns.len() == NB, true)
    let mut all_finite = true
    c = 0
    while c < and.columns.len() {
        let mut i = 0
        while i < N { if !_finite(and.columns[c][i]) { all_finite = false } ; i = i + 1 }
        c = c + 1
    }
    fails = fails + _ck_bool("(B) Anderson screened columns all FINITE (no NaN/inf)", all_finite, true)
    fails = fails + _ck_bool("(B) Anderson converged at metallic gain", and.converged, true)
    fails = fails + _ck_lt("(B) Anderson fixed-point residual < 1e-4",
                           and.fixed_point_res, 1.0e-4)

    // ── (C) ε(q→0) SANITY: bounded fixed point, finite dielectric factor ────
    let ratio0 = qforge_screening_ratio(dv_bare[0], and.columns[0])
    fails = fails + _ck_lt("(C) screened/bare ratio finite (< 1e6)", ratio0, 1.0e6)
    fails = fails + _ck_ge("(C) screened/bare ratio physical (> 0)", ratio0, 0.0)
    let eps_eff = if ratio0 > 0.0 { 1.0 / ratio0 } else { -1.0 }
    fails = fails + _ck_lt("(C) dielectric eps_eff finite (< 1e6)", eps_eff, 1.0e6)
    fails = fails + _ck_bool("(C) eps_eff is finite (not NaN/inf)", _finite(eps_eff), true)

    // ── (D) ZERO-KERNEL → BARE under Anderson empty-kernel guard (re-affirm) ─
    fails = fails + _ck_bool("(D) zero-kernel converged (empty-kernel guard)", r0.converged, true)

    // ── (E) COMPOSED λ FINITE: Anderson screened columns → composer → λ ─────
    let band = [800.0, 1000.0, 1200.0]
    let mut grid: [float] = []
    let mut gp = 1
    while gp < 201 { grid.push(to_float(gp) * 10.0) ; gp = gp + 1 }
    let e_fermi = eps_a[0]
    let comp = qforge_compose_cah6_lambda(states, and.columns, eps_a, band,
                                          e_fermi, 1.0, grid, 0.05, 10.0, 0.0)
    fails = fails + _ck_bool("(E) composed result ok", comp.ok == 1, true)
    fails = fails + _ck_bool("(E) composed λ finite", _finite(comp.lambda), true)
    fails = fails + _ck_ge("(E) composed λ >= 0", comp.lambda, 0.0)

    // ── (F) MALFORMED guard: bare-column count mismatch → empty, not converged ─
    let mut short_bare: [[float]] = []
    short_bare.push(dv_bare[0])
    let rf = qforge_screened_dv_columns_anderson(h_apply, states, eps_a, short_bare,
                                                 drho_amplify, TOL, 80, 1.0, 5)
    fails = fails + _ck_bool("(F) malformed → empty columns", rf.columns.len() == 0, true)
    fails = fails + _ck_bool("(F) malformed → not converged", rf.converged, false)

    // ── (G) LINEAR-ALGEBRA IDENTITY: generic Anderson solves (I−L)x=b → x* ──────
    //   high-gain L (spectral radius > 1, so Picard diverges) but (I−L) non-singular.
    //   L = 0.6·(ones off-diag) + 1.4 on diag over dim 4 → ‖L‖>1; compare the
    //   Anderson core's x* against the directly-computed (I−L)⁻¹b. residual < tol.
    let GN = 4
    let mut Lm: [float] = []
    let mut gi = 0
    while gi < GN {
        let mut gj = 0
        while gj < GN {
            if gi == gj { Lm.push(1.4) } else { Lm.push(0.6) }
            gj = gj + 1
        }
        gi = gi + 1
    }
    let bb = [1.0, -2.0, 0.5, 3.0]
    L_MAT = Lm ; L_B = bb ; L_N = GN
    let xref = iml_solve(Lm, bb, GN)            // reference x* = (I−L)⁻¹b
    let mut x0: [float] = [] ; let mut zi = 0
    while zi < GN { x0.push(0.0) ; zi = zi + 1 }
    let afp = qforge_anderson_fixed_point(affine_map, x0, GN, 1.0e-10, 200, 1.0, 5)
    let mut maxe = 0.0
    let mut ci = 0
    while ci < GN { let e = _abs(afp.x[ci] - xref[ci]) ; if e > maxe { maxe = e } ; ci = ci + 1 }
    fails = fails + _ck_bool("(G) Anderson affine converged", afp.converged, true)
    fails = fails + _ck_lt("(G) Anderson x* == (I−L)⁻¹b (max|Δ|)", maxe, 1.0e-7)
    fails = fails + _ck_lt("(G) Anderson fixed-point residual < tol", afp.residual, 1.0e-10)

    // ── (G') NEAR-SINGULAR (I−L): spectral radius → 1⁻, ill-conditioned, NO NaN ──
    //   L diag 0.999 (so I−L diag ≈ 1e-3, near-singular but non-singular) → x* large
    //   but FINITE; assert the no-NaN guarantee holds and x* matches the reference.
    let mut Ls: [float] = []
    gi = 0
    while gi < GN {
        let mut gj = 0
        while gj < GN {
            if gi == gj { Ls.push(0.999) } else { Ls.push(0.0001) }
            gj = gj + 1
        }
        gi = gi + 1
    }
    L_MAT = Ls ; L_B = bb ; L_N = GN
    let xref2 = iml_solve(Ls, bb, GN)
    let afp2 = qforge_anderson_fixed_point(affine_map, x0, GN, 1.0e-9, 600, 1.0, 6)
    let mut all_fin2 = true
    ci = 0
    while ci < GN { if !_finite(afp2.x[ci]) { all_fin2 = false } ; ci = ci + 1 }
    fails = fails + _ck_bool("(G') near-singular x* all FINITE (no NaN/inf)", all_fin2, true)
    let mut maxe2 = 0.0
    let mut maxref2 = 1.0e-30
    ci = 0
    while ci < GN {
        let e = _abs(afp2.x[ci] - xref2[ci]) ; if e > maxe2 { maxe2 = e }
        let a = _abs(xref2[ci]) ; if a > maxref2 { maxref2 = a }
        ci = ci + 1
    }
    let relerr2 = maxe2 / maxref2
    fails = fails + _ck_lt("(G') near-singular x* rel-ε vs (I−L)⁻¹b", relerr2, 1.0e-4)

    if fails == 0 { println("qforge_screening_anderson_selftest PASS") }
    else { println("qforge_screening_anderson_selftest FAIL — " + to_string(fails) + " case(s)") }
}
