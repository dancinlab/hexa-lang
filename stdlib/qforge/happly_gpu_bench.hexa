// ════════════════════════════════════════════════════════════════════════
// stdlib/qforge/happly_gpu_bench.hexa — QFORGE-PERF Lane A ⚡ H_apply GPU bench
//
// Benches qforge_h_apply (scalar O(n²) matvec) vs qforge_h_apply_forge (the
// forge_dispatch_matmul GPU-GEMM seam, assembler.hexa). On a CUDA-built hexa
// the forge path fires cuBLAS; on a no-GPU build it routes to the IDENTICAL
// hexa_farr_matmul FP64 baseline. Either way the two paths must be element-eq
// (byte-eq on the CPU build, FP-tol on the GPU build).
//
// Reports per n ∈ {256,512,1024}:
//   · scalar wall (ns)  + GFLOP/s  (2·n² flops per matvec)
//   · forge  wall (ns)  + GFLOP/s
//   · wall Δ (scalar / forge)  · max |Δ| scalar-vs-forge (byte-eq check)
//
// HONESTY (d6/g63): the bench prints the REAL measured numbers. The 0.140
// GFLOP/s figure in QFORGE-PERF.bench is the CPU scalar baseline; the forge
// GFLOP/s + wall Δ are whatever the hardware delivers (a memory-bound ceiling
// or a transfer-dominated small-n no-speedup is a VALID honest result).
//
// Run (CPU, byte-eq gate):
//   HEXA_STDLIB_ROOT="$PWD/stdlib" hexa run stdlib/qforge/happly_gpu_bench.hexa
// Run (GPU pod, CUDA build): same command on the cuda-built hexa.
// ════════════════════════════════════════════════════════════════════════
use "stdlib/qforge/assembler"

fn _abs(x: float) -> float { if x < 0.0 { return -x } return x }

// Deterministic pseudo-random fill in [-1,1) — a cheap LCG, no RNG dep.
fn _lcg_next(state: int) -> int {
    // 32-bit LCG (Numerical Recipes constants), kept positive via mask.
    let nxt = (state * 1103515245 + 12345)
    let masked = nxt % 2147483647
    if masked < 0 { return masked + 2147483647 }
    return masked
}

fn main() {
    let ns = [256, 512, 1024]
    println("QFORGE-PERF Lane A — H_apply scalar vs forge-GEMM bench")
    println("n , scalar_ns , scalar_GFLOPs , forge_ns , forge_GFLOPs , wallDelta , maxAbsDiff")

    let mut ni = 0
    while ni < len(ns) {
        let n = ns[ni]

        // ── Build a synthetic dense H[n,n] and vector v[n] (deterministic) ──
        let mut h: [float] = []
        let mut seed = 2463534242 + n
        let mut idx = 0
        while idx < n * n {
            seed = _lcg_next(seed)
            // map to [-1,1)
            let r = (to_float(seed % 20000) / 10000.0) - 1.0
            h.push(r)
            idx = idx + 1
        }
        let mut v: [float] = []
        let mut vi = 0
        while vi < n {
            seed = _lcg_next(seed)
            let r = (to_float(seed % 20000) / 10000.0) - 1.0
            v.push(r)
            vi = vi + 1
        }
        let mut diag: [float] = []
        let mut di = 0
        while di < n { diag.push(h[di * n + di]) ; di = di + 1 }
        let ham = PwHam { h: h, diag: diag, n: n }

        // ── Time the scalar path ───────────────────────────────────────────
        let t0 = mono_ns()
        let out_scalar = qforge_h_apply(ham, v)
        let t1 = mono_ns()
        let scalar_ns = t1 - t0

        // ── Time the forge (GPU-GEMM / CPU-GEMM) path ──────────────────────
        let t2 = mono_ns()
        let out_forge = qforge_h_apply_forge(ham, v)
        let t3 = mono_ns()
        let forge_ns = t3 - t2

        // ── byte-eq / fp-tol check ─────────────────────────────────────────
        let mut max_diff = 0.0
        let mut ok = true
        if len(out_forge) != n { ok = false }
        if ok {
            let mut c = 0
            while c < n {
                let d = _abs(out_scalar[c] - out_forge[c])
                if d > max_diff { max_diff = d }
                c = c + 1
            }
        }

        // ── GFLOP/s = 2·n² flops / wall_seconds ────────────────────────────
        let flops = 2.0 * to_float(n) * to_float(n)
        let mut scalar_gflops = 0.0
        if scalar_ns > 0 { scalar_gflops = flops / to_float(scalar_ns) }
        let mut forge_gflops = 0.0
        if forge_ns > 0 { forge_gflops = flops / to_float(forge_ns) }
        let mut wall_delta = 0.0
        if forge_ns > 0 { wall_delta = to_float(scalar_ns) / to_float(forge_ns) }

        if ok {
            println(to_string(n) + " , " + to_string(scalar_ns) + " , "
                + to_string(scalar_gflops) + " , " + to_string(forge_ns) + " , "
                + to_string(forge_gflops) + " , " + to_string(wall_delta) + " , "
                + to_string(max_diff))
        } else {
            println(to_string(n) + " , FORGE-PATH-FAIL (bad handle / len mismatch)")
        }
        ni = ni + 1
    }
    println("happly_gpu_bench DONE")
}
