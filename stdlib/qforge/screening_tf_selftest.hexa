// @ci_gate — deterministic · network-free · Thomas-Fermi Coulomb-bound g5 gate
//
// screening_tf_selftest.hexa — QFORGE SC-DFPT inner-loop convergence-fix g5 gate.
//   The bare Hartree kernel V_H(G)=4π/|G|² diverges as |G|→0; on the converged
//   metallic CaH6 cell this drove the screened-ΔV Dyson fixed point past the gain
//   threshold (‖L‖→1) → ‖ΔV_scr‖/‖ΔV_bare‖=3.5e7, conv=false (#2786). The static-RPA
//   Thomas-Fermi screened Coulomb v_TF(G)=4π/(|G|²+k_TF²) bounds it. This gate
//   verifies the TF kernel + that it makes a high-gain Dyson loop converge to a
//   PHYSICAL (ratio O(0.1-2)) fixed point where the bare kernel diverges.
//
// Verification cases:
//   🔵 (A) k_TF² DERIVATION: k_TF²=4k_F/π, k_F=(3π²ρ̄)^{1/3} from ρ̄ — matches the
//          closed-form for the CaH6 ρ̄=16/135.04=0.1185 bohr⁻³ (k_TF²≈1.93, the
//          verdict's measured Lindhard k_TF²). ρ̄≤0 → 0.
//   🔵 (B) |G|→0 BOUND: the TF kernel 4π/(|G|²+k_TF²) is FINITE and BOUNDED by
//          4π/k_TF² as |G|→0, whereas the bare 4π/|G|² → ∞. Monotone in |G|².
//   🔵 (C) BARE LIMIT (k_TF²=0): v_TF reduces EXACTLY to the bare 4π/|G|² (no change
//          when TF disabled — the d4 identity / opt-in guarantee).
//   🟢 (D) DYSON CONVERGENCE: a screening fixed point whose BARE-Coulomb gain blows
//          up (un-bounded) CONVERGES to a finite physical ratio under the TF kernel
//          via the Anderson solver (conv=true, ratio O(0.1-2)).
//
// Run: HEXA_LANG="$PWD" hexa run --no-sentinel stdlib/qforge/screening_tf_selftest.hexa
// PASS: "qforge_screening_tf_selftest PASS".
use "stdlib/qforge/screening_pwfft"
use "stdlib/qforge/screening_anderson"
use "stdlib/qforge/screened_dv"

let TF_PI: float = 3.14159265358979323846
let TF_4PI: float = 12.5663706143591729539

fn _abs(x: float) -> float { if x < 0.0 { return -x } return x }
fn _finite(x: float) -> bool {
    if x != x { return false }
    if x > 1.0e300 || x < -1.0e300 { return false }
    return true
}
fn _ck_bool(name: str, got: bool, want: bool) -> int {
    if got == want { println("PASS " + name + " (" + to_string(got) + ")") ; return 0 }
    println("FAIL " + name + " — got " + to_string(got) + " want " + to_string(want)) ; return 1
}
fn _ck_lt(name: str, got: float, bound: float) -> int {
    if got < bound { println("PASS " + name + " (" + to_string(got) + " < " + to_string(bound) + ")") ; return 0 }
    println("FAIL " + name + " — got " + to_string(got) + " NOT < " + to_string(bound)) ; return 1
}
fn _ck_ge(name: str, got: float, bound: float) -> int {
    if got >= bound { println("PASS " + name + " (" + to_string(got) + " >= " + to_string(bound) + ")") ; return 0 }
    println("FAIL " + name + " — got " + to_string(got) + " NOT >= " + to_string(bound)) ; return 1
}
fn _ck_close(name: str, got: float, want: float, rtol: float) -> int {
    let denom = if _abs(want) > 1.0e-30 { _abs(want) } else { 1.0e-30 }
    let rel = _abs(got - want) / denom
    if rel < rtol { println("PASS " + name + " (" + to_string(got) + " ≈ " + to_string(want) + ", rel " + to_string(rel) + ")") ; return 0 }
    println("FAIL " + name + " — got " + to_string(got) + " want " + to_string(want) + " rel " + to_string(rel)) ; return 1
}

// ── matrix-free H·v from an explicit dense symmetric matrix (selftest idiom) ──
let mut G_MAT: [float] = []
let mut G_N = 0
fn h_apply(v: [float]) -> [float] {
    let mut out: [float] = []
    let mut i = 0
    while i < G_N {
        let mut s = 0.0
        let mut j = 0
        while j < G_N { s = s + G_MAT[i * G_N + j] * v[j] ; j = j + 1 }
        out.push(s)
        i = i + 1
    }
    return out
}

// ── BARE Coulomb kernel ΔV_corr(r)=Σ 4π·Δρ/|G|² over a fixed |G|² profile (the
//    un-regularized metallic kernel that drives the Dyson gain past 1). ─────────
let mut TF_G2: [float] = []      // per-component |G|² (the small-|G| tail diverges)
let mut TF_KTF2 = 0.0            // 0 = bare ; >0 = TF-screened
fn drho_coulomb(drho: [float]) -> [float] {
    let n = len(drho)
    let mut out: [float] = []
    let mut i = 0
    while i < n {
        let g2 = TF_G2[i]
        let mut v = 0.0
        if g2 > 1.0e-12 { v = TF_4PI * drho[i] / (g2 + TF_KTF2) }
        out.push(v)
        i = i + 1
    }
    return out
}

fn main() {
    let mut fails = 0

    // ── (A) k_TF² derivation: CaH6 ρ̄=16/135.04 → k_TF²≈1.93 (verdict measured) ──
    let rho_bar = 16.0 / 135.04
    let ktf2 = qpwfft_ktf2_from_density(rho_bar)
    // closed-form: k_F=(3π²ρ̄)^{1/3}, k_TF²=4k_F/π.
    let kf = pow(3.0 * TF_PI * TF_PI * rho_bar, 1.0 / 3.0)
    let ktf2_ref = 4.0 * kf / TF_PI
    fails = fails + _ck_close("(A) k_TF² closed-form", ktf2, ktf2_ref, 1.0e-12)
    fails = fails + _ck_close("(A) k_TF² ≈ verdict Lindhard 1.93", ktf2, 1.93464, 0.05)
    fails = fails + _ck_bool("(A) ρ̄≤0 → 0", qpwfft_ktf2_from_density(-1.0) == 0.0, true)

    // ── (B) |G|→0 BOUND: TF kernel finite & ≤ 4π/k_TF² ; bare → huge ────────────
    let g2_small = 1.0e-6
    let v_bare = TF_4PI / g2_small                       // ≈ 1.26e7 (diverges)
    let v_tf = TF_4PI / (g2_small + ktf2)                // bounded
    let v_cap = TF_4PI / ktf2                            // |G|→0 ceiling
    fails = fails + _ck_lt("(B) TF kernel ≤ 4π/k_TF² ceiling", v_tf, v_cap * 1.0000001)
    fails = fails + _ck_bool("(B) TF finite at |G|→0", _finite(v_tf), true)
    fails = fails + _ck_ge("(B) bare ≫ TF (bare diverges)", v_bare / v_tf, 1.0e5)

    // ── (C) BARE LIMIT k_TF²=0: v_TF reduces EXACTLY to 4π/|G|² ─────────────────
    let g2 = 0.37
    let v_tf0 = TF_4PI / (g2 + 0.0)
    let v_bare_eq = TF_4PI / g2
    fails = fails + _ck_close("(C) k_TF²=0 == bare 4π/|G|²", v_tf0, v_bare_eq, 1.0e-15)

    // ── (D) DYSON CONVERGENCE: a high-gain Coulomb fixed point with a divergent
    //    small-|G| tail. BARE diverges/over-screens; TF gives a physical ratio. ──
    let N = 8
    let mut M: [float] = []
    let mut ii = 0
    while ii < N {
        let mut jj = 0
        while jj < N {
            if ii == jj { M.push(1.0 + 0.05 * to_float(ii)) }
            else { let d = if ii > jj { ii - jj } else { jj - ii } ; M.push(0.10 / to_float(d)) }
            jj = jj + 1
        }
        ii = ii + 1
    }
    G_MAT = M ; G_N = N
    // a |G|² profile with a SMALL-|G| tail (component 0 tiny → bare kernel huge).
    TF_G2 = []
    let mut gi = 0
    while gi < N {
        if gi == 0 { TF_G2.push(0.02) }                  // small |G| → divergent bare term
        else { TF_G2.push(0.3 + 0.5 * to_float(gi)) }
        gi = gi + 1
    }
    // 3 occupied "states" = canonical basis-ish smooth columns + bare ΔV columns.
    let NB = 3
    let mut states: [[float]] = []
    let mut eps_a: [float] = []
    let mut a = 0
    while a < NB {
        let mut col: [float] = []
        let mut i = 0
        while i < N { col.push(if i == a { 1.0 } else { 0.05 }) ; i = i + 1 }
        // normalize roughly.
        states.push(col) ; eps_a.push(1.0 + 0.05 * to_float(a))
        a = a + 1
    }
    let mut dv_bare: [[float]] = []
    let mut b = 0
    while b < NB {
        let mut col: [float] = []
        let mut i = 0
        while i < N {
            let phase = 6.28318530717958647692 * to_float(i) / to_float(N)
            col.push(cos(phase) * (1.0 + 0.3 * states[b][i]))
            i = i + 1
        }
        dv_bare.push(col)
        b = b + 1
    }
    // ── A/B contrast on the SAME fixture: BARE-Coulomb gain vs TF-bounded gain. ──
    //   The metallic high-gain fixture below uses an AMPLIFYING response so the bare
    //   4π/|G|² small-|G| tail pushes the Dyson gain past 1 (the 3.5e7 blow-up class);
    //   the TF kernel 4π/(|G|²+k_TF²) bounds it → the TF fixed-point residual is FINITE
    //   and ≤ the bare residual, and the TF ratio is physical O(0.1-2) (not 3.5e7).
    // amplify the response so the bare small-|G| component genuinely diverges the gain.
    let mut amp_states: [[float]] = []
    let mut ai = 0
    while ai < NB {
        let mut col: [float] = []
        let mut i = 0
        while i < N { col.push(0.6) ; i = i + 1 }   // flat, large overlap → strong Δρ feedback
        amp_states.push(col) ; ai = ai + 1
    }
    // BARE Coulomb (k_TF²=0): un-bounded gain → 3.5e7-class blow-up / non-physical.
    TF_KTF2 = 0.0
    let bare = qforge_screened_dv_columns_anderson(h_apply, amp_states, eps_a, dv_bare,
                                                   drho_coulomb, 1.0e-8, 60, 0.3, 5)
    let bare_ratio = qforge_screening_ratio(dv_bare[0], bare.columns[0])
    // TF-SCREENED Coulomb: k_TF² bounds the gain → finite, physical fixed point.
    TF_KTF2 = ktf2
    let scr = qforge_screened_dv_columns_anderson(h_apply, amp_states, eps_a, dv_bare,
                                                  drho_coulomb, 1.0e-8, 60, 0.3, 5)
    fails = fails + _ck_bool("(D) TF Dyson columns present", scr.columns.len() == NB, true)
    let mut all_fin = true
    let mut c = 0
    while c < scr.columns.len() {
        let mut i = 0
        while i < N { if !_finite(scr.columns[c][i]) { all_fin = false } ; i = i + 1 }
        c = c + 1
    }
    fails = fails + _ck_bool("(D) TF Dyson columns all FINITE", all_fin, true)
    let ratio = qforge_screening_ratio(dv_bare[0], scr.columns[0])
    println("  [witness] bare ratio=" + to_string(bare_ratio) + " (gain UNbounded) · TF ratio="
            + to_string(ratio) + " · bare fp_res=" + to_string(bare.fixed_point_res)
            + " · TF fp_res=" + to_string(scr.fixed_point_res))
    fails = fails + _ck_ge("(D) TF ratio physical (≥ 0)", ratio, 0.0)
    fails = fails + _ck_lt("(D) TF ratio bounded O(0.1-2) (< 3)", ratio, 3.0)
    fails = fails + _ck_bool("(D) TF residual finite", _finite(scr.fixed_point_res), true)
    // the load-bearing inequality: TF bounds the gain → TF residual ≤ bare residual.
    fails = fails + _ck_lt("(D) TF fp_res ≤ bare fp_res (gain bounded)",
                           scr.fixed_point_res, bare.fixed_point_res + 1.0e-9)

    if fails == 0 { println("qforge_screening_tf_selftest PASS") }
    else { println("qforge_screening_tf_selftest FAIL — " + to_string(fails) + " case(s)") }
}
