// HEXA Standard Library — qforge/scf
//
// QFORGE 통합① — 평면파 DFT 의 Kohn-Sham 자기무모순(SCF) 드라이버.
//
// 이미 g5-검증된 L5 브릭들(Davidson 대각화기 · eigen 의 eigh)을 하나의
// 자기무모순 Kohn-Sham 루프로 엮는다. 입력 밀도 ρ 로부터
//
//   1. 호출자의 H_of_rho(rho) → H_apply  (행렬-자유 연산자, d4) 로 해밀토니안을 만든다.
//   2. qforge_davidson 으로 최저 nbands 고유쌍을 대각화한다 (d19 재사용).
//   3. nelec 전자를 최저 상태부터 채운다(occupation; 이중점유 2e/state).
//   4. 호출자의 rho_of_psi(occupied_psis) → rho_out 으로 새 밀도를 만든다.
//   5. 선형 혼합 ρ_new = (1−mix)·ρ_in + mix·ρ_out 으로 진동을 억제한다.
//   6. 자기무모순 잔차 max(|Δρ|, |ΔE|) < tol 까지 (5) 를 반복한다.
//
// 수렴 시 수렴 밀도 · KS 고유값 · 총 에너지 · 반복수 · 수렴 플래그를 돌려준다.
//
// ── d4 generic 계약 (one driver, many physics) ───────────────────────────
//   루프는 물리-무관(physics-agnostic)이다. 호출자가 H_of_rho 와 rho_of_psi 를
//   공급하므로, 같은 드라이버가
//     (a) selftest 의 모델 H (해석적 고정점이 알려진 toy), 그리고
//     (b) 미래의 실제 평면파 H
//   둘 다를 그대로 구동한다 — 이름 하드코딩 없음(d4).
//
// ── 미래 통합 NEXT (이 파일에서 절대 half-구현 금지) ──────────────────────
//   실제 PW H_of_rho 조립은 명시적 다음 통합 조각이며 <200줄 예산을 깬다:
//     · Ewald 합(이온-이온 에너지)
//     · FFT-Poisson Hartree[ρ]   (signal/core_fft 의 fft3/ifft3 재사용)
//     · LDA 교환-상관 함수(V_xc[ρ], E_xc[ρ])
//     · UPF-구동 V_loc + 비국소 투영(qforge/upf)
//     · 운동 에너지(FFT 로 |G+k|²/2)
//   본 파일은 DRIVER 만 제공하고 모델로 SCF 수학을 실검증한다. 실제 PW H 는
//   상위 호출자가 위 조각을 조립해 H_of_rho 클로저로 넘긴다 (d4).
//
// reuse (d19): 대각화는 stdlib/qforge/davidson 의 qforge_davidson 를,
//   그 내부는 stdlib/alloc/math/eigen 의 eigh 를 재사용한다. M5.8: 금속 SCF 수렴은
//   smearing (Fermi-Dirac occ + E_F bisection) + mixing (Anderson) 를 재사용한다.
use "stdlib/qforge/davidson"
use "stdlib/qforge/smearing"
use "stdlib/qforge/mixing"
use "stdlib/qforge/checkpoint"

// SCF 결과 묶음: 수렴 밀도 · KS 고유값(오름차순) · 총 에너지 · 반복수 · 수렴 플래그.
pub struct ScfResult {
    rho: [float],        // 수렴한 밀도(길이 = H_of_rho 가 기대하는 grid 차원)
    evals: [float],      // 최저 nbands KS 고유값, 오름차순
    e_total: float,      // 총 에너지(밴드 에너지 합 = Σ occ_k · ε_k)
    iters: int,
    converged: bool
}

// |x|.
fn scf_abs(x: float) -> float { if x < 0.0 { return -x } return x }

// 두 밀도의 L∞ 거리(자기무모순 잔차의 밀도 성분).
fn scf_dmax(a: [float], b: [float], n: int) -> float {
    let mut m = 0.0
    let mut i = 0
    while i < n {
        let d = scf_abs(a[i] - b[i])
        if d > m { m = d }
        i = i + 1
    }
    return m
}

// 점유(occupation): nelec 전자를 최저 상태부터 채운다. 닫힌-껍질 이중점유
// (state 당 2e). 반환 = 각 밴드 점유수 [float] (0, 1, 또는 2).
fn scf_occupations(nbands: int, nelec: int) -> [float] {
    let mut occ = []
    let mut left = to_float(nelec)
    let mut k = 0
    while k < nbands {
        if left >= 2.0 { occ.push(2.0) ; left = left - 2.0 }
        else { if left >= 1.0 { occ.push(left) ; left = 0.0 } else { occ.push(0.0) } }
        k = k + 1
    }
    return occ
}

// 밴드 에너지 합 E = Σ_k occ_k · ε_k (모델의 KS 총-에너지 대용).
fn scf_band_energy(evals: [float], occ: [float], nbands: int) -> float {
    let mut e = 0.0
    let mut k = 0
    while k < nbands { e = e + occ[k] * evals[k] ; k = k + 1 }
    return e
}

// 점유된 KS 궤도(행=벡터)를 evecs 평탄 배열에서 잘라 호출자에게 넘길 형태로 만든다.
// occupied_psis[b] = b-번째 밴드의 고유벡터(길이 ndim), occ_b 와 함께 전달.
fn scf_slice_psis(evecs: [float], nbands: int, ndim: int) -> [[float]] {
    let mut psis = []
    let mut b = 0
    while b < nbands {
        let mut v = []
        let mut i = 0
        while i < ndim { v.push(evecs[b * ndim + i]) ; i = i + 1 }
        psis.push(v)
        b = b + 1
    }
    return psis
}

// ── SCF 본체 ────────────────────────────────────────────────────────────
// H_of_rho:   rho -> H_apply   (행렬-자유 연산자 클로저; d4 — 물리는 호출자가 결정)
// rho_of_psi: (psis, occ, nbands) -> rho_out   (점유 궤도에서 새 밀도)
// n:        H 의 차원(npw / grid 점수)
// nbands:   대각화할 최저 밴드 수(점유 + 일부 미점유 가능)
// nelec:    전자 수(닫힌-껍질 이중점유로 점유)
// mix:      선형 혼합 계수 ∈ (0,1]; 0<mix≤1 권장
// tol:      자기무모순 허용오차 max(|Δρ|∞, |ΔE|) < tol
// max_iter: 최대 SCF 반복
pub fn qforge_scf(H_of_rho, rho_of_psi, n: int, nbands: int, nelec: int,
                  mix: float, tol: float, max_iter: int) -> ScfResult {
    // ── mixing 안정성 가드(d4): 발산을 유발하는 비물리적 혼합을 damp ──────
    //   mix ≤ 0 또는 mix > 1 은 선형 혼합에서 비물리적(발산/부호반전). 안전구간으로 clamp.
    let mut a = mix
    if a <= 0.0 { a = 0.1 }     // 0 이하 → 진전 없음/부호반전 → 보수적 0.1 로 damp
    if a > 1.0 { a = 1.0 }      // 1 초과 → over-relaxation 발산 위험 → 1.0 로 clamp

    // 초기 밀도 = 균일(전하 중성으로 정규화: 합 = nelec). 모델에서는 grid 차원 = n.
    let mut rho = []
    let mut i = 0
    let rho0 = to_float(nelec) / to_float(n)
    while i < n { rho.push(rho0) ; i = i + 1 }

    let occ = scf_occupations(nbands, nelec)

    let mut evals = []
    let mut e_total = 0.0
    let mut e_prev = 0.0
    let mut iters = 0
    let mut converged = false
    let mut first = true

    while iters < max_iter {
        iters = iters + 1

        // (1) 입력 밀도로 해밀토니안 조립 (호출자 H_of_rho → H_apply, d4).
        let H_apply = H_of_rho(rho)

        // H 의 대각선(Davidson 전처리기용). 단위벡터에 H_apply 를 때려 추출.
        let mut diag = []
        let mut d = 0
        while d < n {
            let mut e = []
            let mut t = 0
            while t < n { if t == d { e.push(1.0) } else { e.push(0.0) } ; t = t + 1 }
            let col = H_apply(e)
            diag.push(col[d])
            d = d + 1
        }

        // (2) 최저 nbands 대각화 (qforge_davidson 재사용, d19).
        let dr = qforge_davidson(H_apply, diag, n, nbands, 1.0e-10, 200)
        evals = dr.evals

        // (3) 점유 → (4) 새 밀도 (호출자 rho_of_psi).
        let psis = scf_slice_psis(dr.evecs, nbands, n)
        let rho_out = rho_of_psi(psis, occ, nbands)

        // 총 에너지(모델: 밴드 에너지 합).
        e_total = scf_band_energy(evals, occ, nbands)

        // 자기무모순 잔차: max(|Δρ|∞, |ΔE|).
        let dr_rho = scf_dmax(rho, rho_out, n)
        let dr_e = if first { tol + 1.0 } else { scf_abs(e_total - e_prev) }
        let resid = if dr_rho > dr_e { dr_rho } else { dr_e }

        // (5) 선형 혼합: ρ_new = (1−a)·ρ_in + a·ρ_out.
        let mut rho_new = []
        let mut k = 0
        while k < n { rho_new.push((1.0 - a) * rho[k] + a * rho_out[k]) ; k = k + 1 }
        rho = rho_new

        e_prev = e_total
        first = false

        // (6) 수렴 판정.
        if resid < tol {
            converged = true
            return ScfResult { rho: rho, evals: evals, e_total: e_total,
                               iters: iters, converged: true }
        }
    }
    return ScfResult { rho: rho, evals: evals, e_total: e_total,
                       iters: iters, converged: converged }
}

// ── QFORGE-PERF round 2: BLOCK-WIRED SCF (GPU-GEMM Davidson hot path) ──────────
//   Identical SCF math to qforge_scf above, but each inner diagonalize calls
//   qforge_davidson_block — which folds the per-iteration m× scalar H-apply into
//   ONE GEMM H[n,n]@Ψ[n,m] via the caller's BLOCK closure. On a CUDA-built hexa
//   that GEMM fires cuBLAS (74.9× vs CPU at n=2048,m=64; QFORGE-PERF.bench.md §8);
//   on a no-GPU build it routes to the identical FP64 CPU GEMM and is still a few×
//   faster than the scalar loop (CPU GEMM-tier wins; davidson_block_e2e_bench).
//
//   d4 generic contract preserved — the driver names NO physics:
//     H_of_rho        : rho -> H_apply(v)            (scalar matrix-free, kept for
//                                                      diag extraction + [] fallback)
//     H_block_of_rho  : rho -> H_block(psi_flat, m)  (ROW-MAJOR Ψ[n,m] -> Y[n,m])
//   The two closures MUST describe the SAME H(rho); the production PW caller builds
//   both from the same assembled PwHam (scf_pw.hexa: qforge_pw_h_apply /
//   qforge_pw_h_apply_block over the shared PW_HAM slot). If H_block returns [] for
//   an iteration (bad GPU handle / shape) qforge_davidson_block transparently falls
//   back to the scalar path, so the result is ALWAYS bit-identical to qforge_scf
//   (eigenvalues parity max |Δλ| ≤ 9e-16, machine-eps; davidson_block_e2e_bench).
//
//   This is a SEPARATE entry so qforge_scf stays byte-identical for every existing
//   caller (no-regression) — exactly the qforge_scf_smeared convention.
pub fn qforge_scf_block(H_of_rho, H_block_of_rho, rho_of_psi,
                        n: int, nbands: int, nelec: int,
                        mix: float, tol: float, max_iter: int) -> ScfResult {
    let mut a = mix
    if a <= 0.0 { a = 0.1 }
    if a > 1.0 { a = 1.0 }

    let mut rho = []
    let mut i = 0
    let rho0 = to_float(nelec) / to_float(n)
    while i < n { rho.push(rho0) ; i = i + 1 }

    let occ = scf_occupations(nbands, nelec)

    let mut evals = []
    let mut e_total = 0.0
    let mut e_prev = 0.0
    let mut iters = 0
    let mut converged = false
    let mut first = true

    while iters < max_iter {
        iters = iters + 1

        // (1) 입력 밀도로 H_apply(스칼라) + H_block(배치) 둘 다 조립 — 같은 H(ρ).
        let H_apply = H_of_rho(rho)
        let H_block = H_block_of_rho(rho)

        // H 의 대각선(Davidson 전처리기용) — 스칼라 apply 로 추출(블록과 동일 H).
        let mut diag = []
        let mut d = 0
        while d < n {
            let mut e = []
            let mut t = 0
            while t < n { if t == d { e.push(1.0) } else { e.push(0.0) } ; t = t + 1 }
            let col = H_apply(e)
            diag.push(col[d])
            d = d + 1
        }

        // (2) 최저 nbands 대각화 — BLOCK 경로(반복당 GEMM 1회; davidson.hexa d4).
        let dr = qforge_davidson_block(H_apply, H_block, diag, n, nbands, 1.0e-10, 200)
        evals = dr.evals

        // (3) 점유 → (4) 새 밀도 (호출자 rho_of_psi).
        let psis = scf_slice_psis(dr.evecs, nbands, n)
        let rho_out = rho_of_psi(psis, occ, nbands)

        e_total = scf_band_energy(evals, occ, nbands)

        let dr_rho = scf_dmax(rho, rho_out, n)
        let dr_e = if first { tol + 1.0 } else { scf_abs(e_total - e_prev) }
        let resid = if dr_rho > dr_e { dr_rho } else { dr_e }

        let mut rho_new = []
        let mut k = 0
        while k < n { rho_new.push((1.0 - a) * rho[k] + a * rho_out[k]) ; k = k + 1 }
        rho = rho_new

        e_prev = e_total
        first = false

        if resid < tol {
            converged = true
            return ScfResult { rho: rho, evals: evals, e_total: e_total,
                               iters: iters, converged: true }
        }
    }
    return ScfResult { rho: rho, evals: evals, e_total: e_total,
                       iters: iters, converged: converged }
}

// ── M5.8: SMEARED + ANDERSON SCF (the metallic-convergence driver) ─────────────
// qforge_scf above fills FIXED INTEGER occupation + PLAIN LINEAR mixing — for a
// METAL the integer fill swaps as bands cross E_F → ρ limit-cycle that linear
// mixing cannot kill (the M5.7 PR3 CaH6 residual). This variant adds:
//   · FRACTIONAL Fermi-Dirac occupations with E_F by bisection (smearing.hexa) —
//     a band crossing E_F now changes occupation CONTINUOUSLY (no swap).
//   · ANDERSON history mixing (mixing.hexa) — cancels the oscillating mode.
// It is a SEPARATE entry so qforge_scf stays bit-identical for every existing
// caller (no-regression). OPT-IN params:
//   sigma     : smearing width (same energy unit as ε; SCF carries Hartree).
//               sigma ≤ 0 → FIXED INTEGER occupation (the old scf_occupations).
//   spin_deg  : 2.0 closed-shell (spin-degenerate) · 1.0 spin-resolved.
//   and_depth : Anderson history depth m (≤0 → plain linear mixing of mix).
// With sigma≤0 AND and_depth≤0 this reproduces qforge_scf EXACTLY (a smearing/
// mixing-disabled run is the regression pin).
//
// ── QFORGE-PERF: the VARIATIONAL TOTAL ENERGY (the e_dc correction) ────────────
//   The band sum Σocc·ε − σ·S is NOT the Kohn-Sham total energy: V_H, V_xc already
//   fold their contribution into each ε_i, so the sum DOUBLE-COUNTS Hartree+xc and
//   OMITS the ion-ion Ewald constant. The variational E_tot is
//     E_tot = Σocc·ε − σ·S  +  e_dc,
//   with e_dc = (−½∫V_H·ρ) + (E_xc[ρ] − ∫V_xc·ρ) + E_ewald — the double-count
//   correction PLUS Ewald, a value the CALLER computes from ρ (scf_etot.hexa) and
//   passes in (d4 — the driver stays physics-agnostic; the correction is data).
//   In the basis-DECOUPLED FDG screening this is a single NPW-independent constant
//   (ρ̄ + Ewald), so this entry adds it as a precomputed scalar. qforge_scf_smeared
//   delegates with e_dc=0.0 → bit-identical to the prior band-sum behaviour.
pub fn qforge_scf_smeared(H_of_rho, rho_of_psi, n: int, nbands: int, nelec: int,
                          mix: float, tol: float, max_iter: int,
                          sigma: float, spin_deg: float, and_depth: int) -> ScfResult {
    return qforge_scf_smeared_dc(H_of_rho, rho_of_psi, n, nbands, nelec,
                                 mix, tol, max_iter, sigma, spin_deg, and_depth, 0.0)
}

// ── the VARIATIONAL-energy SCF (adds the precomputed double-count+Ewald e_dc) ──
pub fn qforge_scf_smeared_dc(H_of_rho, rho_of_psi, n: int, nbands: int, nelec: int,
                             mix: float, tol: float, max_iter: int,
                             sigma: float, spin_deg: float, and_depth: int,
                             e_dc: float) -> ScfResult {
    let mut a = mix
    if a <= 0.0 { a = 0.1 }
    if a > 1.0 { a = 1.0 }
    let mut sd = spin_deg
    if sd <= 0.0 { sd = 2.0 }                       // default closed-shell

    let mut rho = []
    let mut i = 0
    let rho0 = to_float(nelec) / to_float(n)
    while i < n { rho.push(rho0) ; i = i + 1 }

    // Anderson history (flat h×n input/output density buffers, newest appended).
    let mut hist_in: [float] = []
    let mut hist_out: [float] = []
    let mut h = 0

    let mut evals = []
    let mut e_total = 0.0
    let mut e_prev = 0.0
    let mut iters = 0
    let mut converged = false
    let mut first = true

    while iters < max_iter {
        iters = iters + 1

        let H_apply = H_of_rho(rho)

        let mut diag = []
        let mut d = 0
        while d < n {
            let mut e = []
            let mut t = 0
            while t < n { if t == d { e.push(1.0) } else { e.push(0.0) } ; t = t + 1 }
            let col = H_apply(e)
            diag.push(col[d])
            d = d + 1
        }

        let dr = qforge_davidson(H_apply, diag, n, nbands, 1.0e-10, 200)
        evals = dr.evals

        // (3') occupation: FRACTIONAL Fermi-Dirac (E_F by bisection) when sigma>0,
        //      else FIXED INTEGER (the old closed-shell fill) — reuses smearing.hexa.
        let mut occ: [float] = []
        if sigma > 0.0 {
            occ = qforge_fermi_occupations(evals, nbands, nelec, sigma, sd)
        } else {
            occ = scf_occupations(nbands, nelec)
        }

        let psis = scf_slice_psis(dr.evecs, nbands, n)
        let rho_out = rho_of_psi(psis, occ, nbands)

        // ── energy: the MERMIN FREE ENERGY F = Σ occ·ε − σ·S when smeared ──────
        //   The bare band sum Σ occ·ε is NOT variational once occupations are
        //   FRACTIONAL — only F is stationary at the fixed point AND monotone-
        //   decreasing in the basis size (the CaH6 etot-vs-NPW monotonicity).
        //   σ≤0 (integer fill) → S=0 → F = the bare sum (bit-identical old path).
        e_total = scf_band_energy(evals, occ, nbands)
        if sigma > 0.0 {
            e_total = e_total - sigma * qforge_smearing_entropy(occ, sd)
        }
        // QFORGE-PERF: add the variational double-count + Ewald correction (a
        //   precomputed scalar, NPW-independent in the FDG path). e_dc=0 → the
        //   bare band-sum behaviour (the regression-pin delegation above).
        e_total = e_total + e_dc

        let dr_rho = scf_dmax(rho, rho_out, n)
        let dr_e = if first { tol + 1.0 } else { scf_abs(e_total - e_prev) }
        let resid = if dr_rho > dr_e { dr_rho } else { dr_e }

        // (5') mixing: append the (ρ_in, ρ_out) pair to the history, then take an
        //      ANDERSON step (and_depth>0) or PLAIN LINEAR (and_depth≤0). Anderson
        //      with h=1 internally falls back to linear — identical first step.
        let mut t2 = 0
        while t2 < n { hist_in.push(rho[t2]) ; hist_out.push(rho_out[t2]) ; t2 = t2 + 1 }
        h = h + 1
        let mut rho_new: [float] = []
        if and_depth > 0 {
            rho_new = qforge_anderson_next(hist_in, hist_out, h, n, and_depth, a)
        } else {
            let mut k = 0
            while k < n { rho_new.push((1.0 - a) * rho[k] + a * rho_out[k]) ; k = k + 1 }
        }
        // cap the stored history at and_depth+2 pairs (trim oldest) to bound cost
        // and keep the Gram well-conditioned (stale vectors → near-singular).
        let cap = and_depth + 2
        if and_depth > 0 && h > cap {
            let ndrop = h - cap
            let mut trimmed_in: [float] = []
            let mut trimmed_out: [float] = []
            let mut keep = ndrop
            while keep < h {
                let mut tt = 0
                while tt < n {
                    trimmed_in.push(hist_in[keep * n + tt])
                    trimmed_out.push(hist_out[keep * n + tt])
                    tt = tt + 1
                }
                keep = keep + 1
            }
            hist_in = trimmed_in ; hist_out = trimmed_out ; h = cap
        }
        rho = rho_new

        e_prev = e_total
        first = false

        if resid < tol {
            converged = true
            return ScfResult { rho: rho, evals: evals, e_total: e_total,
                               iters: iters, converged: true }
        }
    }
    return ScfResult { rho: rho, evals: evals, e_total: e_total,
                       iters: iters, converged: converged }
}

// ════════════════════════════════════════════════════════════════════════════
// SPIN-POLARIZED (LSDA, nspin=2) SCF DRIVER — handoff bb095261 (CoSn kagome)
// ════════════════════════════════════════════════════════════════════════════
// Two coupled Kohn-Sham channels (↑,↓) sharing ONE Fermi level. Each iteration
// builds a per-spin H from BOTH densities (V_xc^σ depends on ρ↑,ρ↓; V_H on ρ↑+ρ↓),
// diagonalizes each channel, fills both via a single shared E_F (smearing.hexa
// qforge_fermi_occupations_spin), rebuilds ρ↑,ρ↓, mixes each (plain linear), and
// tracks the magnetization m=Σocc↑−Σocc↓. Physics-agnostic (d4): the per-spin
// Hamiltonian is supplied by the caller's H_of_rho_spin(ρ↑,ρ↓,sign)→H_apply
// closure (sign=+1 up, −1 down); ρ_of_psi reused unchanged.
//
// REGRESSION PIN: a spin-SYMMETRIC closure (H_of_rho_spin ignores sign, depends
//   only on ρ↑+ρ↓) with init_mag=0 reproduces qforge_scf_smeared(...,spin_deg=2,
//   and_depth=0): two identical channels each weight-1 ≡ one channel weight-2
//   (shared E_F over [E,E] == restricted E_F with sd=2; band sum & entropy add).
// Smeared (sigma>0) only — magnetic metals always smear; verified path.
// Mixing: per-channel Anderson when and_depth>0 (qforge_anderson_next on each spin's
// own history — cuts TM-metal iter-count ~3-5×), else plain linear. and_depth=0 keeps
// the linear regression pin (CaH6 nspin2≡nspin1).
pub struct ScfResultSpin {
    rho_up: [float],
    rho_dn: [float],
    evals_up: [float],
    evals_dn: [float],
    e_total: float,
    magnetization: float,   // m = Σ occ↑ − Σ occ↓  (μ_B per cell)
    iters: int,
    converged: bool
}

pub fn qforge_scf_spin_smeared_dc(H_of_rho_spin, rho_of_psi, n: int, nbands: int, nelec: int,
                                  mix: float, tol: float, max_iter: int,
                                  sigma: float, and_depth: int, e_dc: float, init_mag: float) -> ScfResultSpin {
    let mut a = mix
    if a <= 0.0 { a = 0.1 }
    if a > 1.0 { a = 1.0 }

    // init spin densities: ρ↑+ρ↓ = nelec/n (charge), ρ↑−ρ↓ = init_mag/n (moment seed).
    let nf = to_float(nelec)
    let nnf = to_float(n)
    let r_up0 = (nf + init_mag) / (2.0 * nnf)
    let r_dn0 = (nf - init_mag) / (2.0 * nnf)
    let mut rho_up: [float] = []
    let mut rho_dn: [float] = []
    let mut i = 0
    while i < n { rho_up.push(r_up0) ; rho_dn.push(r_dn0) ; i = i + 1 }

    let mut evals_up: [float] = []
    let mut evals_dn: [float] = []
    let mut e_total = 0.0
    let mut e_prev = 0.0
    let mut mag = 0.0
    let mut iters = 0
    let mut converged = false
    let mut first = true

    // per-channel Anderson history (flat h×n buffers) — and_depth>0 enables it,
    // ≤0 → plain linear. Anderson cuts metal SCF iter-count ~3-5× (the restricted
    // CaH6 needed it; linear alone limit-cycles / converges slowly on TM cells).
    let mut hin_u: [float] = [] ; let mut hout_u: [float] = []
    let mut hin_d: [float] = [] ; let mut hout_d: [float] = []
    let mut hh = 0

    while iters < max_iter {
        iters = iters + 1

        let H_up = H_of_rho_spin(rho_up, rho_dn, 1.0)
        let H_dn = H_of_rho_spin(rho_up, rho_dn, -1.0)

        // per-channel diagonal (unit-vector probe — same as restricted driver).
        let mut diag_u: [float] = []
        let mut diag_d: [float] = []
        let mut d = 0
        while d < n {
            let mut e = []
            let mut t = 0
            while t < n { if t == d { e.push(1.0) } else { e.push(0.0) } ; t = t + 1 }
            let cu = H_up(e)
            let cd = H_dn(e)
            diag_u.push(cu[d])
            diag_d.push(cd[d])
            d = d + 1
        }

        let dr_u = qforge_davidson(H_up, diag_u, n, nbands, 1.0e-10, 200)
        let dr_d = qforge_davidson(H_dn, diag_d, n, nbands, 1.0e-10, 200)
        evals_up = dr_u.evals
        evals_dn = dr_d.evals

        // shared E_F → spin occupations (each channel spin_deg=1).
        let occs = qforge_fermi_occupations_spin(evals_up, evals_dn, nelec, sigma)
        let occ_u = occs[0]
        let occ_d = occs[1]

        let psis_u = scf_slice_psis(dr_u.evecs, nbands, n)
        let psis_d = scf_slice_psis(dr_d.evecs, nbands, n)
        let rho_out_u = rho_of_psi(psis_u, occ_u, nbands)
        let rho_out_d = rho_of_psi(psis_d, occ_d, nbands)
        mag = qforge_magnetization(occ_u, occ_d)

        // Mermin free energy: Σ_σ (band sum − σ·entropy_σ) + e_dc.
        e_total = scf_band_energy(evals_up, occ_u, nbands) + scf_band_energy(evals_dn, occ_d, nbands)
        e_total = e_total - sigma * (qforge_smearing_entropy(occ_u, 1.0) + qforge_smearing_entropy(occ_d, 1.0))
        e_total = e_total + e_dc

        let dru = scf_dmax(rho_up, rho_out_u, n)
        let drd = scf_dmax(rho_dn, rho_out_d, n)
        let mut dr_rho = dru
        if drd > dr_rho { dr_rho = drd }
        let dr_e = if first { tol + 1.0 } else { scf_abs(e_total - e_prev) }
        let resid = if dr_rho > dr_e { dr_rho } else { dr_e }

        // mixing, per channel: Anderson (and_depth>0) or plain linear (≤0).
        let mut t2 = 0
        while t2 < n {
            hin_u.push(rho_up[t2]) ; hout_u.push(rho_out_u[t2])
            hin_d.push(rho_dn[t2]) ; hout_d.push(rho_out_d[t2])
            t2 = t2 + 1
        }
        hh = hh + 1
        let mut rho_new_u: [float] = []
        let mut rho_new_d: [float] = []
        if and_depth > 0 {
            rho_new_u = qforge_anderson_next(hin_u, hout_u, hh, n, and_depth, a)
            rho_new_d = qforge_anderson_next(hin_d, hout_d, hh, n, and_depth, a)
        } else {
            let mut k = 0
            while k < n {
                rho_new_u.push((1.0 - a) * rho_up[k] + a * rho_out_u[k])
                rho_new_d.push((1.0 - a) * rho_dn[k] + a * rho_out_d[k])
                k = k + 1
            }
        }
        // trim both histories to and_depth+2 pairs (bound cost + keep Gram conditioned).
        let cap = and_depth + 2
        if and_depth > 0 && hh > cap {
            let ndrop = hh - cap
            let mut ti_u: [float] = [] ; let mut to_u: [float] = []
            let mut ti_d: [float] = [] ; let mut to_d: [float] = []
            let mut keep = ndrop
            while keep < hh {
                let mut tt = 0
                while tt < n {
                    ti_u.push(hin_u[keep * n + tt]) ; to_u.push(hout_u[keep * n + tt])
                    ti_d.push(hin_d[keep * n + tt]) ; to_d.push(hout_d[keep * n + tt])
                    tt = tt + 1
                }
                keep = keep + 1
            }
            hin_u = ti_u ; hout_u = to_u ; hin_d = ti_d ; hout_d = to_d ; hh = cap
        }
        rho_up = rho_new_u
        rho_dn = rho_new_d

        e_prev = e_total
        first = false

        if resid < tol {
            converged = true
            return ScfResultSpin { rho_up: rho_up, rho_dn: rho_dn,
                                   evals_up: evals_up, evals_dn: evals_dn,
                                   e_total: e_total, magnetization: mag,
                                   iters: iters, converged: true }
        }
    }
    return ScfResultSpin { rho_up: rho_up, rho_dn: rho_dn,
                           evals_up: evals_up, evals_dn: evals_dn,
                           e_total: e_total, magnetization: mag,
                           iters: iters, converged: converged }
}

// ════════════════════════════════════════════════════════════════════════════
// OPT-IN CRASH-RESILIENT RESUME (qforge/checkpoint, PR2) — recover-EOF 구조적 불가능화
// ════════════════════════════════════════════════════════════════════════════
// qforge_scf is an iterative fixed-point loop; a crash mid-convergence restarts
// from the uniform guess (all progress lost). This OPT-IN entry checkpoints the
// density ρ after each SCF iteration (atomic + checksummed, qforge_checkpoint),
// using the iteration index as the checkpoint "q". On restart it resumes from the
// LAST verified ρ at its iteration offset — never replaying a torn density blob;
// a corrupt/truncated checkpoint is rejected (integrity) and that iteration is
// re-driven from the last CLEAN ρ. Same recover=.false. salvage default the gate
// anchors needed. Mirrors the qforge_scf_smeared opt-in pattern (separate entry →
// qforge_scf stays bit-identical for every existing caller; resume_dir=="" here
// delegates VERBATIM to qforge_scf → the non-resumed path is byte-identical).

// per-iteration payload codec (d4 — driver owns its codec). Encodes ρ as
// "n\nr0 r1 …". The decode re-derives n and validates the length defensively.
fn _scf_encode_rho(rho: [float]) -> str {
    let mut parts: [str] = []
    let mut i = 0
    let n = len(rho)
    while i < n { parts.push(to_string(rho[i])) ; i = i + 1 }
    return to_string(n) + "\n" + parts.join(" ")
}
fn _scf_decode_rho(body: str, n: int) -> [float] {
    let lines = body.split("\n")
    if len(lines) < 2 { return [] }
    if to_int(lines[0]) != n { return [] }
    let toks = lines[1].split(" ")
    if len(toks) != n { return [] }
    let mut out: [float] = []
    let mut i = 0
    while i < n { out.push(to_float(toks[i])) ; i = i + 1 }
    return out
}

// ── qforge_scf_resumable — opt-in crash-resilient linear-mixing SCF ──────────
//   Identical signature + result to qforge_scf, plus a trailing resume_dir and
//   max_ckpt (number of checkpoint slots to scan for the resume point — pass
//   max_iter). resume_dir=="" → delegate to qforge_scf (0-diff). Otherwise the
//   density at each iteration is checkpointed; on entry we resume from the last
//   verified ρ. A bad checkpoint is skipped (integrity) — never replayed.
pub fn qforge_scf_resumable(H_of_rho, rho_of_psi, n: int, nbands: int, nelec: int,
                            mix: float, tol: float, max_iter: int,
                            resume_dir: str, max_ckpt: int) -> ScfResult {
    if len(resume_dir) == 0 {
        return qforge_scf(H_of_rho, rho_of_psi, n, nbands, nelec, mix, tol, max_iter)
    }
    let mut a = mix
    if a <= 0.0 { a = 0.1 }
    if a > 1.0 { a = 1.0 }

    // ── resume: take the LAST verified iteration's ρ as the start (clean state) ──
    let scan = qforge_resume_scan(resume_dir, max_ckpt)
    let mut rho: [float] = []
    let mut start_iter = 0
    if scan.next_q > 0 {
        let last = scan.next_q - 1            // highest committed iteration
        let ck = qforge_checkpoint_read(resume_dir, last)
        if ck.ok {
            let restored = _scf_decode_rho(ck.payload, n)
            if len(restored) == n { rho = restored ; start_iter = scan.next_q }
        }
    }
    if len(rho) != n {
        // no usable checkpoint (fresh run OR all corrupt) → CLEAN uniform guess.
        rho = []
        let rho0 = to_float(nelec) / to_float(n)
        let mut i = 0
        while i < n { rho.push(rho0) ; i = i + 1 }
        start_iter = 0
    }

    let occ = scf_occupations(nbands, nelec)
    let mut evals = []
    let mut e_total = 0.0
    let mut e_prev = 0.0
    let mut iters = start_iter
    let mut converged = false
    let mut first = true

    while iters < max_iter {
        let H_apply = H_of_rho(rho)
        let mut diag = []
        let mut d = 0
        while d < n {
            let mut e = []
            let mut t = 0
            while t < n { if t == d { e.push(1.0) } else { e.push(0.0) } ; t = t + 1 }
            let col = H_apply(e)
            diag.push(col[d])
            d = d + 1
        }
        let dr = qforge_davidson(H_apply, diag, n, nbands, 1.0e-10, 200)
        evals = dr.evals
        let psis = scf_slice_psis(dr.evecs, nbands, n)
        let rho_out = rho_of_psi(psis, occ, nbands)
        e_total = scf_band_energy(evals, occ, nbands)
        let dr_rho = scf_dmax(rho, rho_out, n)
        let dr_e = if first { tol + 1.0 } else { scf_abs(e_total - e_prev) }
        let resid = if dr_rho > dr_e { dr_rho } else { dr_e }
        let mut rho_new = []
        let mut k = 0
        while k < n { rho_new.push((1.0 - a) * rho[k] + a * rho_out[k]) ; k = k + 1 }
        rho = rho_new
        e_prev = e_total
        first = false
        iters = iters + 1
        // atomically checkpoint this iteration's density (payload first, marker last).
        if iters - 1 < max_ckpt {
            let _ = qforge_checkpoint_write(resume_dir, iters - 1, _scf_encode_rho(rho))
        }
        if resid < tol {
            converged = true
            return ScfResult { rho: rho, evals: evals, e_total: e_total,
                               iters: iters, converged: true }
        }
    }
    return ScfResult { rho: rho, evals: evals, e_total: e_total,
                       iters: iters, converged: converged }
}
