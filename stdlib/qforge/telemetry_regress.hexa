// telemetry_regress.hexa — QFORGE-PROCESS cross-run REGRESSION detector.
//
// PR#2474 made the el-ph dispatcher EMIT a sibling `.dft_telemetry.jsonl`
// (6 keys ts·stage·event·wall_s·rss_kb·exit). PR#2477 (telemetry_report.hexa)
// INGESTS that text → a ranked per-stage bottleneck `Report`.
//
// This module is the NEXT lever the domain's @goal calls for: given a BASELINE
// run's telemetry and a CURRENT run's telemetry, JOIN per stage and flag any
// stage whose wall (or peak RSS) GREW beyond a percent threshold — the
// "improvement lever" cross-run signal (a stage that got slower run-over-run).
// IMPROVED stages (got faster past threshold) are surfaced too.
//
// @L1 — qforge_telemetry_regress(baseline_jsonl, current_jsonl, pct_threshold)
//   parses BOTH via the existing qforge_telemetry_report (d3/d19 reuse — NO
//   re-implemented parser), joins per stage, computes Δwall %/Δrss %, flags
//   stages over threshold REGRESSED (and surfaces IMPROVED), ranked Δ% desc.
//
// @L2 — real edge cases: a stage in current but absent in baseline = NEW · a
//   stage absent from current = DROPPED · rss null on EITHER side → skip the
//   rss-Δ for that stage (d6: render `null`, NEVER fabricate) keeping the
//   wall-Δ · zero-baseline-wall guard (no divide-by-zero, NEW-class instead).
//
// @L3 — READ-only PURE function over two JSONL TEXTs. No pod ops, no mutation,
//   no I/O. Reuses qforge_telemetry_report; does NOT edit telemetry_report.hexa
//   (separate NEW module, 0-diff existing files). The caller prints the render.
use "stdlib/qforge/telemetry_report"

// ── per-stage cross-run delta row ─────────────────────────────────────────
//   stage       — the transition label (relax · scf · ph:qN · lambda)
//   kind        — one of: REGRESSED · IMPROVED · SAME · NEW · DROPPED
//   base_wall   — baseline wall_s for the stage (0 if NEW)
//   cur_wall    — current  wall_s for the stage (0 if DROPPED)
//   dwall_pct   — signed %Δ wall vs baseline (100·(cur-base)/base); 0 if NEW/
//                 DROPPED (no finite ratio — surfaced via `kind`, not a number)
//   has_dwall   — true iff a finite wall-Δ% exists (both sides present, base>0)
//   base_rss    — baseline peak rss_kb (valid iff has_base_rss)
//   cur_rss     — current  peak rss_kb (valid iff has_cur_rss)
//   has_rss     — true iff BOTH sides carried a real rss (d6: else skip rss-Δ)
//   drss_pct    — signed %Δ rss vs baseline; only meaningful when has_rss
struct RegressRow {
    stage: str,
    kind: str,
    base_wall: int,
    cur_wall: int,
    dwall_pct: int,
    has_dwall: bool,
    base_rss: int,
    cur_rss: int,
    has_rss: bool,
    drss_pct: int,
}

// ── the cross-run regression report ───────────────────────────────────────
//   rows          — RegressRow[] ranked by dwall_pct DESC (worst regression
//                   first); NEW/DROPPED (no finite Δ) sink to the tail
//   pct_threshold — the flag threshold this report was computed against
//   n_regressed   — count of stages flagged REGRESSED (wall OR rss > threshold)
//   n_improved    — count of stages flagged IMPROVED (wall dropped > threshold)
//   n_new         — stages present only in current
//   n_dropped     — stages present only in baseline
//   base_total    — baseline total wall (s)
//   cur_total     — current  total wall (s)
struct RegressReport {
    rows: [RegressRow],
    pct_threshold: int,
    n_regressed: int,
    n_improved: int,
    n_new: int,
    n_dropped: int,
    base_total: int,
    cur_total: int,
}

// ── internal: locate a StageRow by label in a Report, or a sentinel ───────
//   found=false sentinel lets the join treat "absent" structurally (NEW/DROPPED)
//   without a parallel presence array.
fn _rr_find(rep: Report, stage: str) -> StageRow {
    let mut i = 0
    while i < len(rep.rows) {
        if rep.rows[i].stage == stage { return rep.rows[i] }
        i = i + 1
    }
    return StageRow { stage: "", wall_s: -1, peak_rss: -1, has_rss: false, exit: -1, pct: -1, slowest: false }
}
fn _rr_present(r: StageRow) -> bool { return r.stage != "" }

// ── internal: signed integer %Δ = 100·(cur-base)/base. Caller guards base>0. ─
fn _rr_pct(base: int, cur: int) -> int {
    return 100 * (cur - base) / base
}

// qforge_telemetry_regress — parse BOTH runs (reusing qforge_telemetry_report),
// JOIN per stage, compute Δwall%/Δrss%, classify each stage, and rank.
//
// Classification per stage (in priority order):
//   NEW       — absent in baseline OR baseline wall==0 (no finite ratio); the
//               zero-baseline-wall guard lands here (NEVER divide-by-zero).
//   DROPPED   — present in baseline, absent in current.
//   REGRESSED — finite Δ and (Δwall% > threshold) OR (rss on both sides and
//               Δrss% > threshold).
//   IMPROVED  — finite Δ and Δwall% < -threshold (got faster past threshold).
//   SAME      — finite Δ within ±threshold on wall (and rss not regressed).
//
// rss-Δ (d6): computed ONLY when BOTH runs carried a real rss for the stage;
// otherwise has_rss=false and drss_pct stays 0 (the render shows `null`).
pub fn qforge_telemetry_regress(baseline_jsonl: str, current_jsonl: str, pct_threshold: int) -> RegressReport {
    let base = qforge_telemetry_report(baseline_jsonl)
    let cur = qforge_telemetry_report(current_jsonl)

    let mut rows = []
    let mut n_regressed = 0
    let mut n_improved = 0
    let mut n_new = 0
    let mut n_dropped = 0

    // union of stage labels: every current stage, then baseline-only stages.
    // current rows first preserves current ranking as the secondary order.
    let mut ci = 0
    while ci < len(cur.rows) {
        let c = cur.rows[ci]
        ci = ci + 1
        let b = _rr_find(base, c.stage)

        let mut kind = "SAME"
        let mut dwall = 0
        let mut has_dwall = false
        // rss-Δ only when BOTH sides carry a real rss (d6 no fabrication)
        let mut has_rss = _rr_present(b) && b.has_rss && c.has_rss
        let mut drss = 0
        let mut regressed = false

        if !_rr_present(b) || b.wall_s == 0 {
            // absent in baseline OR zero-baseline-wall guard → NEW (no ratio)
            kind = "NEW"
            n_new = n_new + 1
            has_rss = false
        } else {
            has_dwall = true
            dwall = _rr_pct(b.wall_s, c.wall_s)
            if has_rss && b.peak_rss != 0 {
                drss = _rr_pct(b.peak_rss, c.peak_rss)
            } else {
                has_rss = false
            }
            let wall_reg = dwall > pct_threshold
            let rss_reg = has_rss && drss > pct_threshold
            if wall_reg || rss_reg {
                kind = "REGRESSED"
                regressed = true
                n_regressed = n_regressed + 1
            } else if dwall < (0 - pct_threshold) {
                kind = "IMPROVED"
                n_improved = n_improved + 1
            } else {
                kind = "SAME"
            }
        }

        rows.push(RegressRow {
            stage: c.stage,
            kind: kind,
            base_wall: _rr_base_wall(b),
            cur_wall: c.wall_s,
            dwall_pct: dwall,
            has_dwall: has_dwall,
            base_rss: _rr_base_rss(b),
            cur_rss: c.peak_rss,
            has_rss: has_rss,
            drss_pct: drss,
        })
    }

    // baseline-only stages = DROPPED (present baseline, absent current)
    let mut bi = 0
    while bi < len(base.rows) {
        let b = base.rows[bi]
        bi = bi + 1
        if _rr_present(_rr_find(cur, b.stage)) { continue }
        n_dropped = n_dropped + 1
        rows.push(RegressRow {
            stage: b.stage,
            kind: "DROPPED",
            base_wall: b.wall_s,
            cur_wall: 0,
            dwall_pct: 0,
            has_dwall: false,
            base_rss: b.peak_rss,
            cur_rss: 0,
            has_rss: false,
            drss_pct: 0,
        })
    }

    // rank by dwall_pct DESC; rows with no finite Δ (has_dwall=false: NEW/
    // DROPPED) sink to the tail (treated as -infinity for ordering).
    _rr_sort(rows)

    return RegressReport {
        rows: rows,
        pct_threshold: pct_threshold,
        n_regressed: n_regressed,
        n_improved: n_improved,
        n_new: n_new,
        n_dropped: n_dropped,
        base_total: base.total_wall,
        cur_total: cur.total_wall,
    }
}

// ── internal: baseline cell accessors (sentinel → 0, never a -1 leak) ─────
fn _rr_base_wall(b: StageRow) -> int {
    if _rr_present(b) { return b.wall_s }
    return 0
}
fn _rr_base_rss(b: StageRow) -> int {
    if _rr_present(b) && b.has_rss { return b.peak_rss }
    return 0
}

// ── internal: selection-sort rows by dwall_pct DESC; no-finite-Δ rows last ─
// A row with has_dwall=false ranks below ANY finite-Δ row (regardless of sign).
fn _rr_rank_lt(x: RegressRow, y: RegressRow) -> bool {
    // returns true iff x should rank BEFORE y (x is "more regressed")
    if x.has_dwall && !y.has_dwall { return true }
    if !x.has_dwall && y.has_dwall { return false }
    if !x.has_dwall && !y.has_dwall { return false }
    return x.dwall_pct > y.dwall_pct
}
fn _rr_sort(rows: [RegressRow]) {
    let mut a = 0
    while a < len(rows) {
        let mut best = a
        let mut b = a + 1
        while b < len(rows) {
            if _rr_rank_lt(rows[b], rows[best]) { best = b }
            b = b + 1
        }
        if best != a {
            let tmp = rows[a]
            rows[a] = rows[best]
            rows[best] = tmp
        }
        a = a + 1
    }
}

// ── internal: signed-pct render with explicit '+' on growth, `null` on no-Δ ─
fn _rr_dwall_str(r: RegressRow) -> str {
    if !r.has_dwall { return "  --" }
    if r.dwall_pct >= 0 { return "+" + to_string(r.dwall_pct) + "%" }
    return to_string(r.dwall_pct) + "%"
}
fn _rr_drss_str(r: RegressRow) -> str {
    if !r.has_rss { return "null" }
    if r.drss_pct >= 0 { return "+" + to_string(r.drss_pct) + "%" }
    return to_string(r.drss_pct) + "%"
}
fn _rr_padr(s: str, w: int) -> str {
    let mut out = s
    let mut n = len(s)
    while n < w { out = out + " " ; n = n + 1 }
    return out
}
fn _rr_padl(s: str, w: int) -> str {
    let mut pad = ""
    let mut n = len(s)
    while n < w { pad = pad + " " ; n = n + 1 }
    return pad + s
}

// qforge_telemetry_regress_render — a fixed-width text table of the cross-run
// regression report, ranked worst-first. Columns: stage · kind · base_wall ·
// cur_wall · Δwall% · Δrss%. REGRESSED rows carry a trailing `◄ REGRESSED`.
// rss Δ renders the literal `null` when either side lacked a real rss (d6).
// Pure (no I/O) — the caller prints.
pub fn qforge_telemetry_regress_render(rep: RegressReport) -> str {
    let mut out = "QFORGE-PROCESS cross-run regression report (threshold=+"
    out = out + to_string(rep.pct_threshold) + "%)\n"
    out = out + "stage        kind        base_w   cur_w   Δwall   Δrss\n"
    out = out + "-----------  ----------  -------  ------  ------  ------\n"
    let mut i = 0
    while i < len(rep.rows) {
        let r = rep.rows[i]
        let mut line = _rr_padr(r.stage, 11) + "  "
        line = line + _rr_padr(r.kind, 10) + "  "
        line = line + _rr_padl(to_string(r.base_wall), 7) + "  "
        line = line + _rr_padl(to_string(r.cur_wall), 6) + "  "
        line = line + _rr_padl(_rr_dwall_str(r), 6) + "  "
        line = line + _rr_padl(_rr_drss_str(r), 6)
        if r.kind == "REGRESSED" { line = line + "  ◄ REGRESSED" }
        out = out + line + "\n"
        i = i + 1
    }
    out = out + "-----------  ----------  -------  ------  ------  ------\n"
    out = out + "base_total=" + to_string(rep.base_total)
    out = out + "  cur_total=" + to_string(rep.cur_total)
    out = out + "  regressed=" + to_string(rep.n_regressed)
    out = out + "  improved=" + to_string(rep.n_improved)
    out = out + "  new=" + to_string(rep.n_new)
    out = out + "  dropped=" + to_string(rep.n_dropped) + "\n"
    return out
}
