// HEXA Standard Library — qforge/scf_pw
//
// @version 0.1.0
// @capabilities [pure]
//
// QFORGE M5.5 — the DENSITY-DEPENDENT plane-wave SCF orchestrator.
//
// scf.hexa provides the physics-agnostic Kohn-Sham SCF DRIVER (qforge_scf) but
// its end-to-end gate fed a DENSITY-INDEPENDENT `H_of_rho` stub (the assembler
// selftest's `gh_of_rho` ignores ρ and returns a fixed free-electron operator).
// That proved the WIRING, not a real self-consistent calculation. This brick
// closes the gap: it builds the REAL `H_of_rho(ρ)` closure that, every SCF
// iteration, rebuilds the screening potential V_scr = V_H(ρ) + V_xc(ρ) FROM the
// current density and re-assembles H via assembler.hexa — so the operator
// genuinely depends on ρ and the fixed point is a true self-consistent KS state.
//
//   ρ(r)  ──▶  V_H[ρ](r)  (Hartree, neutral cell → 0 for uniform ρ)
//        ╲─▶  V_xc[ρ](r)  (LDA x: −(3ρ/π)^⅓ · c: PW92, correlation.hexa)
//             │
//             ▼  V_scr(r) = V_H + V_xc  (the G-diagonal local screening term)
//   [ qforge_assemble_h(cell, UPF, V_scr) ]  ──▶  H(ρ)  ──▶  H_apply
//             │
//   qforge_scf  ──diagonalize(davidson)──occupy──new ρ──mix──┘  (iterate to SC)
//
// ── d4 generic contract (module-global cell slot, named-fn closure) ──────────
//   hexa codegen does NOT capture local params in a nested `fn` (the existing
//   qforge selftests use the SAME module-global pattern). So the cell + UPF +
//   xc_mode are staged into module-global `let mut` slots by qforge_scf_pw_set,
//   and the named module-level `qforge_h_of_rho_global` is the H_of_rho closure
//   qforge_scf calls — physics-agnostic driver, name not hardcoded (d4).
//
// ── Honest scope (d6) ────────────────────────────────────────────────────────
//   The screening enters as a LOCAL real-space potential sampled on the same
//   index grid the SCF density carries (the assembler's G-diagonal vscr_diag).
//   The g5 gate verifies the SELF-CONSISTENT physics on cases whose fixed point
//   is analytic (uniform/jellium V_xc shift; a ρ-coupled fixed point; the free-
//   electron limit). The G-space Hartree for an arbitrary aperiodic ρ on the PW
//   basis is the next integration piece (needs the dense FFT grid, not the n-PW
//   diagonal); it is supplied here as a caller-provided vh_diag (or [] for the
//   neutral uniform cell where V_H=0) — NOT faked.
//
// reuse (d19): assembler (H_of_rho compose) · screening (Hartree+LDA-x) ·
//   correlation (PW92 c) · scf (the driver) · davidson (diagonalizer).
use "stdlib/qforge/assembler"
use "stdlib/qforge/screening"
use "stdlib/qforge/correlation"
use "stdlib/qforge/scf"
use "stdlib/qforge/scf_etot"
use "stdlib/qforge/davidson"
use "stdlib/qforge/smearing"
use "stdlib/qforge/mixing"

// ── module-global cell slot for the H_of_rho closure (named-fn pattern, d4) ───
//   Staged by qforge_scf_pw_set; read by qforge_h_of_rho_global. The same slots
//   serve a single-atom cell, an H₂-like cell, or a real metallic hydride —
//   add/swap a material = re-stage the slots, no name hardcoded.
let mut PW_KVEC: [float] = []
let mut PW_GVECS: [float] = []
let mut PW_POS: [float] = []
let mut PW_R: [float] = []
let mut PW_RAB: [float] = []
let mut PW_VLOC: [float] = []
let mut PW_Z: float = 0.0
let mut PW_BETAS: [float] = []
let mut PW_LS: [int] = []
let mut PW_DIJ: [float] = []
let mut PW_NPROJ: int = 0
let mut PW_OMEGA: float = 1.0
let mut PW_VH: [float] = []
let mut PW_XCMODE: int = 0
// ── M5.7: in-loop ground-state Hartree V_H[ρ] FFT-grid slots ──────────────────
//   When PW_HGRID_ON, qforge_h_of_rho_global builds vh_diag FROM the current ρ
//   each SCF iteration via qforge_vhartree_from_rho (screening.hexa) — V_H now
//   updates self-consistently with V_xc, instead of the frozen caller PW_VH.
//   When OFF (the jellium/free-electron anchors), the frozen PW_VH path is kept
//   verbatim (backward-compat — a caller may still supply a fixed vh_diag).
let mut PW_HGRID_ON: bool = false
let mut PW_NX: int = 0
let mut PW_NY: int = 0
let mut PW_NZ: int = 0
let mut PW_B1: [float] = []
let mut PW_B2: [float] = []
let mut PW_B3: [float] = []

// ── QFORGE-PERF: BASIS-DECOUPLED screening grid (the real-cell monotonicity fix) ─
//   THE WALL (demiurge 8ffac91): the real CaH6 SCF F(NPW) SCATTERED 48→−37.08,
//   64→−28.61, 96→−52.79 Ha — NON-monotone, no plateau. Diagnosed (no guessing,
//   cah6_grid_coupling_probe.hexa) to a GRID-COUPLING confound, NOT the energy
//   functional:
//     (i) the in-loop V_H grid was staged as (1,1,NPW). core_fft requires EACH
//         axis pow2 → for NPW∈{48,96} qforge_vhartree_from_rho returns [] →
//         Hartree SILENTLY DROPPED, but for NPW=64 (pow2) it is APPLIED. The
//         screening Hamiltonian thus CHANGES KIND across the sweep.
//     (ii) the SCF `rho` (length n=NPW) is the G-SPACE occupation Σocc·|c(G_i)|²
//         (the diagonal of the density matrix in G), NOT a real-space ρ(r); feeding
//         it pointwise to V_xc makes the screening representation move with NPW.
//   ROOT FIX (path #1 — decouple ρ/V_xc from the PW count): the assembler can only
//   carry the G=0 (spatial-average) screening on the diagonal it accepts. The
//   basis-INDEPENDENT G=0 screening of a charge-neutral cell is the uniform-
//   electron-gas LDA shift evaluated at the EXACT average density ρ̄ = nelec/Ω
//   (⟨V_H⟩=0 by the neutral gauge). ρ̄ does NOT depend on NPW, so the diagonal
//   shift is identical for every NPW → the remaining energy is purely the
//   kinetic+V_ext+V_NL Rayleigh-Ritz functional → MONOTONE + PLATEAU in NPW.
//   When PW_FDG_ON, qforge_vscr_diag_fdg supplies this constant shift; the (1,1,NPW)
//   FFT path is bypassed entirely (no silent Hartree flip). d4-generic — ρ̄ is data.
let mut PW_FDG_ON: bool = false
let mut PW_FDG_RHOBAR: float = 0.0     // ρ̄ = nelec/Ω (basis-independent average density)

// ── LDA xc potential at a single density point (Hartree units) ────────────────
//   xc_mode: 0=x-only(Slater) · ≥1=x+c(PW92).  ρ≤0 → 0 (no electrons → no xc).
//   Reuses screening.qforge_vx_lda + correlation.qforge_vc_pw92_from_rho (d19).
pub fn qforge_vxc_point(rho: float, xc_mode: int) -> float {
    if rho <= 0.0 { return 0.0 }
    let mut v = qforge_vx_lda(rho)                       // Slater exchange V_x
    if xc_mode >= 1 { v = v + qforge_vc_pw92_from_rho(rho) }   // PW92 correlation V_c
    return v
}

// ── Build the G-diagonal screening potential V_scr(i) = V_H(i) + V_xc(i) ──────
//   rho       : length-n density on the PW-site grid (the SCF carries this)
//   vh_diag   : length-n Hartree potential on the same grid, or [] (neutral
//               uniform cell → V_H=0; caller supplies the dense-grid V_H when an
//               aperiodic ρ needs it — d4, screening.hexa produces it)
//   xc_mode   : <0 → no screening (free-electron) · 0 → x-only · ≥1 → x+c
//   Returns length-n vscr_diag for qforge_assemble_h, or [] for the bare H.
pub fn qforge_vscr_diag(rho: [float], vh_diag: [float], xc_mode: int) -> [float] {
    if xc_mode < 0 { return [] }                          // free-electron: no screening
    let n = len(rho)
    let have_vh = len(vh_diag) == n
    let mut vscr: [float] = []
    let mut i = 0
    while i < n {
        let mut v = qforge_vxc_point(rho[i], xc_mode)
        if have_vh { v = v + vh_diag[i] }
        vscr.push(v)
        i = i + 1
    }
    return vscr
}

// ── LDA SPIN xc potential at one site (LSDA, handoff bb095261) ────────────────
//   V_xc^σ = V_x(2ρ_σ) + [xc_mode≥1] V_c^σ(ρ↑,ρ↓).  sign=+1 → ↑, −1 → ↓.
//   Reuses screening.qforge_vx_lda_spin + correlation.qforge_vc_pw92_spin (PR1).
pub fn qforge_vxc_point_spin(rho_up: float, rho_dn: float, sign: float, xc_mode: int) -> float {
    let vx = qforge_vx_lda_spin(rho_up, rho_dn)             // [V_x^↑, V_x^↓]
    let mut v = vx[0]
    if sign <= 0.0 { v = vx[1] }
    if xc_mode >= 1 {
        let vc = qforge_vc_pw92_spin(rho_up, rho_dn)        // [V_c^↑, V_c^↓]
        if sign > 0.0 { v = v + vc[0] } else { v = v + vc[1] }
    }
    return v
}

// ── SPIN G-diagonal screening V_scr^σ(i) = V_H[ρ↑+ρ↓](i) + V_xc^σ(ρ↑,ρ↓)(i) ────
//   V_H couples to the TOTAL density (spin-independent); V_xc is spin-resolved.
//   xc_mode<0 → no screening. vh_diag built by caller from ρ_tot (or []).
pub fn qforge_vscr_diag_spin(rho_up: [float], rho_dn: [float], vh_diag: [float],
                             xc_mode: int, sign: float) -> [float] {
    if xc_mode < 0 { return [] }
    let n = len(rho_up)
    let have_vh = len(vh_diag) == n
    let mut vscr: [float] = []
    let mut i = 0
    while i < n {
        let mut v = qforge_vxc_point_spin(rho_up[i], rho_dn[i], sign, xc_mode)
        if have_vh { v = v + vh_diag[i] }
        vscr.push(v)
        i = i + 1
    }
    return vscr
}

// ── BASIS-DECOUPLED G=0 screening diagonal (QFORGE-PERF real-cell monotonicity) ─
//   Returns a length-n CONSTANT vscr_diag = V_xc(ρ̄) on every G (the spatial-average
//   / G=0 component of the screening), with ρ̄ = nelec/Ω the basis-INDEPENDENT mean
//   density. ⟨V_H⟩=0 for a neutral cell (G=0 gauge), so only V_xc(ρ̄) enters. This
//   is identical for every NPW → no basis-coupling injected into the diagonal.
//   xc_mode<0 → no screening (free-electron); else V_xc(ρ̄) per the LDA point fn.
pub fn qforge_vscr_diag_fdg(n: int, rhobar: float, xc_mode: int) -> [float] {
    if xc_mode < 0 { return [] }
    let shift = qforge_vxc_point(rhobar, xc_mode)
    let mut vscr: [float] = []
    let mut i = 0
    while i < n { vscr.push(shift) ; i = i + 1 }
    return vscr
}

// ── Site density from occupied PW coefficients ρ(i)=Σ_b occ_b·|ψ_b(i)|² ───────
//   The standard rho_of_psi qforge_scf consumes (closed-shell double occupation
//   handled by the occ vector). Pure — no material coupling (d4).
pub fn qforge_rho_of_psi(psis: [[float]], occ: [float], nbands: int) -> [float] {
    let ndim = len(psis[0])
    let mut rho: [float] = []
    let mut i = 0
    while i < ndim { rho.push(0.0) ; i = i + 1 }
    let mut b = 0
    while b < nbands {
        let mut t = 0
        while t < ndim { rho[t] = rho[t] + occ[b] * psis[b][t] * psis[b][t] ; t = t + 1 }
        b = b + 1
    }
    return rho
}

// ── stage the cell into the module-global slots (call before qforge_scf) ──────
//   d4: every material traverses this one staging path — no per-instance branch.
pub fn qforge_scf_pw_set(kvec: [float], gvecs: [float], pos: [float],
                         r: [float], rab: [float], vloc_r: [float], z: float,
                         betas: [float], ls: [int], dij: [float], nproj: int,
                         omega: float, vh_diag: [float], xc_mode: int) {
    PW_KVEC = kvec ; PW_GVECS = gvecs ; PW_POS = pos
    PW_R = r ; PW_RAB = rab ; PW_VLOC = vloc_r ; PW_Z = z
    PW_BETAS = betas ; PW_LS = ls ; PW_DIJ = dij ; PW_NPROJ = nproj
    PW_OMEGA = omega ; PW_VH = vh_diag ; PW_XCMODE = xc_mode
    // reset the in-loop V_H grid (a fresh stage starts on the frozen-PW_VH path
    // until qforge_scf_pw_set_hgrid enables it) — no stale grid leaks across cells.
    PW_HGRID_ON = false
    PW_FDG_ON = false       // basis-decoupled screening is opt-in (the _fdg entry)
}

// ── the density-dependent H_of_rho closure (the M5.5 deliverable) ─────────────
//   ρ → (rebuild V_scr(ρ) → assemble H(ρ) → matrix-free apply). Reads the staged
//   cell from the module-global slots. This is what qforge_scf calls each
//   iteration — the operator genuinely tracks ρ (no fixed-stub).
// ── stage the FFT grid for in-loop ground-state V_H[ρ] (M5.7) ─────────────────
//   Call AFTER qforge_scf_pw_set with the real-space grid (nx,ny,nz) the density
//   lives on and the reciprocal basis (b1,b2,b3) for |G|². Enables the in-loop
//   Hartree build. Pass nx=ny=nz=0 (or never call) to keep the frozen-PW_VH path
//   (backward-compat with every jellium/free-electron anchor). d4 — generic.
pub fn qforge_scf_pw_set_hgrid(nx: int, ny: int, nz: int,
                               b1: [float], b2: [float], b3: [float]) {
    PW_NX = nx ; PW_NY = ny ; PW_NZ = nz
    PW_B1 = b1 ; PW_B2 = b2 ; PW_B3 = b3
    PW_HGRID_ON = nx * ny * nz > 0
}

pub fn qforge_h_of_rho_global(rho: [float]) {
    // M5.7: build the ground-state Hartree FROM the current ρ in-loop (self-
    //   consistent with V_xc), or fall back to the frozen caller PW_VH when the
    //   FFT grid is not staged (free-electron/jellium — V_H=0 in a neutral cell).
    let mut vh = PW_VH
    if PW_HGRID_ON {
        if len(rho) == PW_NX * PW_NY * PW_NZ {
            vh = qforge_vhartree_from_rho(rho, PW_NX, PW_NY, PW_NZ, PW_B1, PW_B2, PW_B3)
        }
    }
    let vscr = qforge_vscr_diag(rho, vh, PW_XCMODE)
    let ham = qforge_assemble_h(PW_KVEC, PW_GVECS, PW_POS,
                                PW_R, PW_RAB, PW_VLOC, PW_Z,
                                PW_BETAS, PW_LS, PW_DIJ, PW_NPROJ,
                                PW_OMEGA, vscr)
    return qforge_pw_apply_global(ham)
}

// helper: bind the assembled PwHam to a named apply closure (global slot).
let mut PW_HAM: PwHam = PwHam { h: [], diag: [], n: 0 }
pub fn qforge_pw_apply_global(ham: PwHam) {
    PW_HAM = ham
    return qforge_pw_h_apply
}
pub fn qforge_pw_h_apply(v: [float]) { return qforge_h_apply(PW_HAM, v) }

// ── doubled apply slots for the LSDA driver (↑,↓ live simultaneously) ─────────
//   The spin SCF driver probes H↑ and H↓ in the same iteration, so each spin
//   binds its own PwHam slot + named apply fn (the single PW_HAM would alias).
let mut PW_HAM_UP: PwHam = PwHam { h: [], diag: [], n: 0 }
let mut PW_HAM_DN: PwHam = PwHam { h: [], diag: [], n: 0 }
pub fn qforge_pw_h_apply_up(v: [float]) { return qforge_h_apply(PW_HAM_UP, v) }
pub fn qforge_pw_h_apply_dn(v: [float]) { return qforge_h_apply(PW_HAM_DN, v) }

// ── the SPIN density-dependent H_of_rho closure (LSDA, multi-species) ─────────
//   (ρ↑,ρ↓,sign) → per-spin V_scr^σ (V_H[ρ↑+ρ↓] + V_xc^σ) → assemble H → apply.
//   sign=+1 stages PW_HAM_UP/returns ↑ apply; −1 stages PW_HAM_DN/returns ↓ apply.
//   Uses the in-loop V_H[ρ_tot] (PW_HGRID_ON) — the physically-correct magnetic
//   path (FDG's frozen ρ̄ cannot carry the self-consistent moment).
pub fn qforge_h_of_rho_multi_spin(rho_up: [float], rho_dn: [float], sign: float) {
    let n = len(rho_up)
    let mut rho_tot: [float] = []
    let mut i = 0
    while i < n { rho_tot.push(rho_up[i] + rho_dn[i]) ; i = i + 1 }
    let mut vh = PW_VH
    if PW_HGRID_ON {
        if n == PW_NX * PW_NY * PW_NZ {
            vh = qforge_vhartree_from_rho(rho_tot, PW_NX, PW_NY, PW_NZ, PW_B1, PW_B2, PW_B3)
        }
    }
    let vscr = qforge_vscr_diag_spin(rho_up, rho_dn, vh, PW_XCMODE, sign)
    let ham = qforge_assemble_h_multi(PWM_KVEC, PWM_GVECS, PWM_NSPEC,
                                      PWM_RS, PWM_RABS, PWM_VLOCS, PWM_MLENS, PWM_ZS,
                                      PWM_POSS, PWM_PALENS,
                                      PWM_BETAS, PWM_LS, PWM_DIJ,
                                      PWM_NPROJS, PWM_BLENS, PWM_DLENS,
                                      PWM_OMEGA, vscr)
    if sign > 0.0 {
        PW_HAM_UP = ham
        return qforge_pw_h_apply_up
    }
    PW_HAM_DN = ham
    return qforge_pw_h_apply_dn
}

// ── One-call self-consistent PW SCF: cell + UPF + xc_mode → ScfResult ─────────
//
//   Stages the cell then drives qforge_scf with the density-dependent closure.
//   This is the independent atoms→SCF entry point (no QE moment boundary).
//   Returns the SCF driver's ScfResult (converged density · KS eigenvalues ·
//   total energy · iters · converged flag).
//
//   d6: `converged` is the driver's honest flag — a non-converged (oscillating)
//   run returns converged=false; the caller must not treat it as self-consistent.
pub fn qforge_scf_pw(kvec: [float], gvecs: [float], pos: [float],
                     r: [float], rab: [float], vloc_r: [float], z: float,
                     betas: [float], ls: [int], dij: [float], nproj: int,
                     omega: float, vh_diag: [float], xc_mode: int,
                     nbands: int, nelec: int, mix: float, tol: float,
                     max_iter: int) -> ScfResult {
    qforge_scf_pw_set(kvec, gvecs, pos, r, rab, vloc_r, z,
                      betas, ls, dij, nproj, omega, vh_diag, xc_mode)
    let n = len(gvecs) / 3
    return qforge_scf(qforge_h_of_rho_global, qforge_rho_of_psi, n, nbands, nelec,
                      mix, tol, max_iter)
}

// ── One-call self-consistent PW SCF WITH in-loop ground-state V_H[ρ] (M5.7) ───
//
//   Same as qforge_scf_pw, but ALSO stages the FFT grid so qforge_h_of_rho_global
//   rebuilds the ground-state Hartree FROM the current ρ each iteration (V_H now
//   self-consistent with V_xc — the real-cell path). The density grid is the
//   nx·ny·nz real-space cube; its length must equal the PW basis dim n (the SCF
//   carries ρ on that grid). b1,b2,b3 = reciprocal basis for |G|². vh_diag here is
//   the INITIAL/override (use [] for the pure in-loop build). d4 — generic, no
//   material hardcoded; CaH6 / LaH10 / Li2MgH16 all traverse this one entry.
pub fn qforge_scf_pw_h(kvec: [float], gvecs: [float], pos: [float],
                       r: [float], rab: [float], vloc_r: [float], z: float,
                       betas: [float], ls: [int], dij: [float], nproj: int,
                       omega: float, vh_diag: [float], xc_mode: int,
                       nx: int, ny: int, nz: int,
                       b1: [float], b2: [float], b3: [float],
                       nbands: int, nelec: int, mix: float, tol: float,
                       max_iter: int) -> ScfResult {
    qforge_scf_pw_set(kvec, gvecs, pos, r, rab, vloc_r, z,
                      betas, ls, dij, nproj, omega, vh_diag, xc_mode)
    qforge_scf_pw_set_hgrid(nx, ny, nz, b1, b2, b3)        // enable in-loop V_H[ρ]
    let n = len(gvecs) / 3
    return qforge_scf(qforge_h_of_rho_global, qforge_rho_of_psi, n, nbands, nelec,
                      mix, tol, max_iter)
}

// ── MULTI-SPECIES in-loop-V_H PW SCF (M5.7 PR3 — real heteroatomic cell) ───────
//   The single-species qforge_scf_pw_h staging composes V_ext from one channel.
//   A real hydride (CaH6 = Ca + 6·H) needs Σ_s V_loc^s·S_s — this entry stages a
//   species list and drives qforge_assemble_h_multi each SCF iteration with the
//   in-loop ground-state V_H[ρ] (M5.7) active. d4-generic: the species list is
//   data; CaH6 / LaH10 / Li2MgH16 all traverse this one entry. The slice arrays
//   (mlens · palens · blens · dlens · nprojs) mirror qforge_assemble_h_multi.
let mut PWM_KVEC: [float] = []
let mut PWM_GVECS: [float] = []
let mut PWM_NSPEC: int = 0
let mut PWM_RS: [float] = []
let mut PWM_RABS: [float] = []
let mut PWM_VLOCS: [float] = []
let mut PWM_MLENS: [int] = []
let mut PWM_ZS: [float] = []
let mut PWM_POSS: [float] = []
let mut PWM_PALENS: [int] = []
let mut PWM_BETAS: [float] = []
let mut PWM_LS: [int] = []
let mut PWM_DIJ: [float] = []
let mut PWM_NPROJS: [int] = []
let mut PWM_BLENS: [int] = []
let mut PWM_DLENS: [int] = []
let mut PWM_OMEGA: float = 1.0

// ── NSCF k-point setter (QFORGE-PERF dense-k DOS) ────────────────────────────
//   After a converged Γ SCF (qforge_scf_pw_h_multi_smeared), the PWM_* staging
//   globals hold the full multi-species Hamiltonian context. To evaluate the band
//   structure at ANOTHER k-point on a Monkhorst-Pack mesh at FIXED converged ρ
//   (a standard NSCF / band-DOS step), set PWM_KVEC to the new k and call
//   qforge_h_of_rho_multi(rho) — the G-basis is shared across k (only the kinetic
//   |k+G|² diag and the KB k+G q-vectors change, assembler.hexa). d4-generic: no
//   material/k hardcoded; the same setter serves the SCF k and every DOS k.
pub fn qforge_pwm_set_kvec(kvec: [float]) {
    PWM_KVEC = kvec
}

pub fn qforge_h_of_rho_multi(rho: [float]) {
    let n = len(rho)
    // QFORGE-PERF: basis-decoupled G=0 screening (uniform-gas V_xc(ρ̄)) — bypasses
    //   the NPW-coupled (1,1,NPW) FFT path entirely (no silent Hartree flip).
    let mut vscr: [float] = []
    if PW_FDG_ON {
        vscr = qforge_vscr_diag_fdg(n, PW_FDG_RHOBAR, PW_XCMODE)
    } else {
    let mut vh = PW_VH
    if PW_HGRID_ON {
        if len(rho) == PW_NX * PW_NY * PW_NZ {
            vh = qforge_vhartree_from_rho(rho, PW_NX, PW_NY, PW_NZ, PW_B1, PW_B2, PW_B3)
        }
    }
    vscr = qforge_vscr_diag(rho, vh, PW_XCMODE)
    }
    let ham = qforge_assemble_h_multi(PWM_KVEC, PWM_GVECS, PWM_NSPEC,
                                      PWM_RS, PWM_RABS, PWM_VLOCS, PWM_MLENS, PWM_ZS,
                                      PWM_POSS, PWM_PALENS,
                                      PWM_BETAS, PWM_LS, PWM_DIJ,
                                      PWM_NPROJS, PWM_BLENS, PWM_DLENS,
                                      PWM_OMEGA, vscr)
    return qforge_pw_apply_global(ham)
}

pub fn qforge_scf_pw_h_multi(kvec: [float], gvecs: [float], nspec: int,
                             rs: [float], rabs: [float], vlocs: [float],
                             mlens: [int], zs: [float],
                             poss: [float], palens: [int],
                             betas: [float], ls: [int], dij: [float],
                             nprojs: [int], blens: [int], dlens: [int],
                             omega: float, xc_mode: int,
                             nx: int, ny: int, nz: int,
                             b1: [float], b2: [float], b3: [float],
                             nbands: int, nelec: int, mix: float, tol: float,
                             max_iter: int) -> ScfResult {
    PWM_KVEC = kvec ; PWM_GVECS = gvecs ; PWM_NSPEC = nspec
    PWM_RS = rs ; PWM_RABS = rabs ; PWM_VLOCS = vlocs ; PWM_MLENS = mlens ; PWM_ZS = zs
    PWM_POSS = poss ; PWM_PALENS = palens
    PWM_BETAS = betas ; PWM_LS = ls ; PWM_DIJ = dij
    PWM_NPROJS = nprojs ; PWM_BLENS = blens ; PWM_DLENS = dlens
    PWM_OMEGA = omega
    let mut empty_f: [float] = []
    PW_VH = empty_f ; PW_XCMODE = xc_mode
    PW_FDG_ON = false                                      // legacy path (no FDG) — regression-pin
    qforge_scf_pw_set_hgrid(nx, ny, nz, b1, b2, b3)        // enable in-loop V_H[ρ]
    let n = len(gvecs) / 3
    return qforge_scf(qforge_h_of_rho_multi, qforge_rho_of_psi, n, nbands, nelec,
                      mix, tol, max_iter)
}

// ── MULTI-SPECIES SMEARED + ANDERSON SCF (M5.8 — metallic hydride convergence) ─
//   Same staging + in-loop V_H[ρ] as qforge_scf_pw_h_multi, but drives the M5.8
//   smeared+Anderson SCF (qforge_scf_smeared): FRACTIONAL Fermi-Dirac occupations
//   (E_F by bisection) + Anderson history mixing. This is the entry CaH6 (a metal)
//   needs — the integer-occupation path limit-cycled. d4-generic: the species list
//   is data; sigma/spin_deg/and_depth are the only added knobs. sigma≤0 + and_depth≤0
//   reproduces qforge_scf_pw_h_multi exactly (no-regression).
pub fn qforge_scf_pw_h_multi_smeared(kvec: [float], gvecs: [float], nspec: int,
                                     rs: [float], rabs: [float], vlocs: [float],
                                     mlens: [int], zs: [float],
                                     poss: [float], palens: [int],
                                     betas: [float], ls: [int], dij: [float],
                                     nprojs: [int], blens: [int], dlens: [int],
                                     omega: float, xc_mode: int,
                                     nx: int, ny: int, nz: int,
                                     b1: [float], b2: [float], b3: [float],
                                     nbands: int, nelec: int, mix: float, tol: float,
                                     max_iter: int, sigma: float, spin_deg: float,
                                     and_depth: int) -> ScfResult {
    PWM_KVEC = kvec ; PWM_GVECS = gvecs ; PWM_NSPEC = nspec
    PWM_RS = rs ; PWM_RABS = rabs ; PWM_VLOCS = vlocs ; PWM_MLENS = mlens ; PWM_ZS = zs
    PWM_POSS = poss ; PWM_PALENS = palens
    PWM_BETAS = betas ; PWM_LS = ls ; PWM_DIJ = dij
    PWM_NPROJS = nprojs ; PWM_BLENS = blens ; PWM_DLENS = dlens
    PWM_OMEGA = omega
    let mut empty_f: [float] = []
    PW_VH = empty_f ; PW_XCMODE = xc_mode
    PW_FDG_ON = false                                      // legacy path (no FDG) — regression-pin
    qforge_scf_pw_set_hgrid(nx, ny, nz, b1, b2, b3)        // enable in-loop V_H[ρ]
    let n = len(gvecs) / 3
    return qforge_scf_smeared(qforge_h_of_rho_multi, qforge_rho_of_psi, n, nbands,
                              nelec, mix, tol, max_iter, sigma, spin_deg, and_depth)
}

// ── BARE-H CACHE for the LSDA closure (QFORGE-PERF, handoff bb095261 d2) ──────
//   H(ρ↑,ρ↓) = H_bare + diag(V_scr^σ).  H_bare (kinetic + V_loc form factors +
//   V_NL KB) is ρ-INDEPENDENT and spin-INDEPENDENT (assembler.hexa adds vscr ONLY
//   on the diagonal, L261) — so re-integrating the V_loc(G) form factors over the
//   pseudo r-grid every SCF iteration is pure waste. Assemble H_bare ONCE, then per
//   iteration apply H·v = H_bare·v + V_scr^σ⊙v (O(n) diagonal add). This is the
//   speed lever that makes a Co-3d cell (CoSn, npw≳120) local-tractable — the
//   per-iter form-factor integral (n²·r_grid·nspec·2) dominated otherwise.
let mut PW_BARE: PwHam = PwHam { h: [], diag: [], n: 0 }
let mut PW_BARE_READY: bool = false
let mut PW_VSCR_UP: [float] = []
let mut PW_VSCR_DN: [float] = []
pub fn qforge_pw_bare_apply_up(v: [float]) {
    let hv = qforge_h_apply(PW_BARE, v)
    let n = len(hv)
    let mut out: [float] = []
    let mut i = 0
    while i < n {
        let mut x = hv[i]
        if i < len(PW_VSCR_UP) { x = x + PW_VSCR_UP[i] * v[i] }
        out.push(x)
        i = i + 1
    }
    return out
}
pub fn qforge_pw_bare_apply_dn(v: [float]) {
    let hv = qforge_h_apply(PW_BARE, v)
    let n = len(hv)
    let mut out: [float] = []
    let mut i = 0
    while i < n {
        let mut x = hv[i]
        if i < len(PW_VSCR_DN) { x = x + PW_VSCR_DN[i] * v[i] }
        out.push(x)
        i = i + 1
    }
    return out
}

// ── bare-cached SPIN closure (drop-in for qforge_h_of_rho_multi_spin) ──────────
pub fn qforge_h_of_rho_multi_spin_fast(rho_up: [float], rho_dn: [float], sign: float) {
    if !PW_BARE_READY {
        let mut no_scr: [float] = []
        PW_BARE = qforge_assemble_h_multi(PWM_KVEC, PWM_GVECS, PWM_NSPEC,
                                          PWM_RS, PWM_RABS, PWM_VLOCS, PWM_MLENS, PWM_ZS,
                                          PWM_POSS, PWM_PALENS,
                                          PWM_BETAS, PWM_LS, PWM_DIJ,
                                          PWM_NPROJS, PWM_BLENS, PWM_DLENS,
                                          PWM_OMEGA, no_scr)         // H_bare — ρ-independent, computed ONCE
        PW_BARE_READY = true
    }
    let n = len(rho_up)
    let mut rho_tot: [float] = []
    let mut i = 0
    while i < n { rho_tot.push(rho_up[i] + rho_dn[i]) ; i = i + 1 }
    let mut vh = PW_VH
    if PW_HGRID_ON {
        if n == PW_NX * PW_NY * PW_NZ {
            vh = qforge_vhartree_from_rho(rho_tot, PW_NX, PW_NY, PW_NZ, PW_B1, PW_B2, PW_B3)
        }
    }
    let vscr = qforge_vscr_diag_spin(rho_up, rho_dn, vh, PW_XCMODE, sign)
    if sign > 0.0 {
        PW_VSCR_UP = vscr
        return qforge_pw_bare_apply_up
    }
    PW_VSCR_DN = vscr
    return qforge_pw_bare_apply_dn
}

// ── MULTI-SPECIES SPIN-POLARIZED (LSDA, nspin=2) SCF (handoff bb095261) ───────
//   Same cell staging + in-loop V_H[ρ_tot] as qforge_scf_pw_h_multi_smeared, but
//   drives the two-channel LSDA driver (qforge_scf_spin_smeared_dc) via the spin
//   closure qforge_h_of_rho_multi_spin. init_mag seeds the ↑−↓ moment (e.g. from a
//   starting_magnetization). Returns ScfResultSpin (ρ↑,ρ↓,evals↑,evals↓,m,…).
//   REGRESSION: init_mag=0 on a non-magnetic cell → m≈0 and the converged total
//   energy reproduces qforge_scf_pw_h_multi_smeared(spin_deg=2) (CaH6 pin). d4 —
//   the species list is data; CoSn / any transition-metal kagome traverse this.
pub fn qforge_scf_pw_h_multi_smeared_spin(kvec: [float], gvecs: [float], nspec: int,
                                          rs: [float], rabs: [float], vlocs: [float],
                                          mlens: [int], zs: [float],
                                          poss: [float], palens: [int],
                                          betas: [float], ls: [int], dij: [float],
                                          nprojs: [int], blens: [int], dlens: [int],
                                          omega: float, xc_mode: int,
                                          nx: int, ny: int, nz: int,
                                          b1: [float], b2: [float], b3: [float],
                                          nbands: int, nelec: int, mix: float, tol: float,
                                          max_iter: int, sigma: float, and_depth: int,
                                          init_mag: float) -> ScfResultSpin {
    PWM_KVEC = kvec ; PWM_GVECS = gvecs ; PWM_NSPEC = nspec
    PWM_RS = rs ; PWM_RABS = rabs ; PWM_VLOCS = vlocs ; PWM_MLENS = mlens ; PWM_ZS = zs
    PWM_POSS = poss ; PWM_PALENS = palens
    PWM_BETAS = betas ; PWM_LS = ls ; PWM_DIJ = dij
    PWM_NPROJS = nprojs ; PWM_BLENS = blens ; PWM_DLENS = dlens
    PWM_OMEGA = omega
    let mut empty_f: [float] = []
    PW_VH = empty_f ; PW_XCMODE = xc_mode
    PW_FDG_ON = false                                      // real-density screening (magnetic path)
    qforge_scf_pw_set_hgrid(nx, ny, nz, b1, b2, b3)        // in-loop V_H[ρ_tot]
    let n = len(gvecs) / 3
    return qforge_scf_spin_smeared_dc(qforge_h_of_rho_multi_spin, qforge_rho_of_psi,
                                      n, nbands, nelec, mix, tol, max_iter,
                                      sigma, and_depth, 0.0, init_mag)
}

// ── BARE-CACHED LSDA SCF (QFORGE-PERF — H_bare computed once, handoff d2) ──────
//   Identical physics + result to qforge_scf_pw_h_multi_smeared_spin, but uses the
//   bare-H-cache closure: the V_loc form factors + V_NL are assembled ONCE and
//   reused every SCF iteration (only V_scr^σ on the diagonal updates). Use this for
//   transition-metal cells (CoSn) where the per-iter form-factor integral dominated.
//   Resets PW_BARE_READY so each call re-derives H_bare for the staged cell.
pub fn qforge_scf_pw_h_multi_smeared_spin_fast(kvec: [float], gvecs: [float], nspec: int,
                                               rs: [float], rabs: [float], vlocs: [float],
                                               mlens: [int], zs: [float],
                                               poss: [float], palens: [int],
                                               betas: [float], ls: [int], dij: [float],
                                               nprojs: [int], blens: [int], dlens: [int],
                                               omega: float, xc_mode: int,
                                               nx: int, ny: int, nz: int,
                                               b1: [float], b2: [float], b3: [float],
                                               nbands: int, nelec: int, mix: float, tol: float,
                                               max_iter: int, sigma: float, and_depth: int,
                                               init_mag: float) -> ScfResultSpin {
    PWM_KVEC = kvec ; PWM_GVECS = gvecs ; PWM_NSPEC = nspec
    PWM_RS = rs ; PWM_RABS = rabs ; PWM_VLOCS = vlocs ; PWM_MLENS = mlens ; PWM_ZS = zs
    PWM_POSS = poss ; PWM_PALENS = palens
    PWM_BETAS = betas ; PWM_LS = ls ; PWM_DIJ = dij
    PWM_NPROJS = nprojs ; PWM_BLENS = blens ; PWM_DLENS = dlens
    PWM_OMEGA = omega
    let mut empty_f: [float] = []
    PW_VH = empty_f ; PW_XCMODE = xc_mode
    PW_FDG_ON = false
    PW_BARE_READY = false                                  // re-derive H_bare for this cell
    qforge_scf_pw_set_hgrid(nx, ny, nz, b1, b2, b3)
    let n = len(gvecs) / 3
    return qforge_scf_spin_smeared_dc(qforge_h_of_rho_multi_spin_fast, qforge_rho_of_psi,
                                      n, nbands, nelec, mix, tol, max_iter,
                                      sigma, and_depth, 0.0, init_mag)
}

// ── k-MESH SPIN-POLARIZED (LSDA) SCF — itinerant magnetism (handoff bb095261 d2) ─
//   The Γ-only spin SCF gives m≈0 for CoSn because itinerant (Stoner) magnetism is
//   BZ-INTEGRATED: the moment is driven by N(E_F) summed over k, which a single Γ point
//   cannot represent (the flat band sits below E_F at Γ, fully occupied in both spins).
//   This entry runs the LSDA SCF over a WEIGHTED k-mesh: per (k,spin) Hamiltonian
//   H_{σk}=H_bare(k)+diag(V_scr^σ), ONE shared E_F over all (k,spin) bands (weighted),
//   ρ_σ=Σ_k w_k·Σ_b f|ψ|². H_bare(k) is cached once per k (bare-H reuse). Anderson per
//   spin. kvecs=flat[3·Nk] · kweights[Nk] (Σ=1). Returns ScfResultSpin (Γ evals + m).
//   REGRESSION: Nk=1, k=Γ, w=1 ≡ qforge_scf_pw_h_multi_smeared_spin_fast.
pub fn qforge_scf_pw_kmesh_spin(kvecs: [float], kweights: [float], gvecs: [float], nspec: int,
                                rs: [float], rabs: [float], vlocs: [float],
                                mlens: [int], zs: [float],
                                poss: [float], palens: [int],
                                betas: [float], ls: [int], dij: [float],
                                nprojs: [int], blens: [int], dlens: [int],
                                omega: float, xc_mode: int,
                                nx: int, ny: int, nz: int,
                                b1: [float], b2: [float], b3: [float],
                                nbands: int, nelec: int, mix: float, tol: float,
                                max_iter: int, sigma: float, and_depth: int,
                                init_mag: float) -> ScfResultSpin {
    PWM_GVECS = gvecs ; PWM_NSPEC = nspec
    PWM_RS = rs ; PWM_RABS = rabs ; PWM_VLOCS = vlocs ; PWM_MLENS = mlens ; PWM_ZS = zs
    PWM_POSS = poss ; PWM_PALENS = palens
    PWM_BETAS = betas ; PWM_LS = ls ; PWM_DIJ = dij
    PWM_NPROJS = nprojs ; PWM_BLENS = blens ; PWM_DLENS = dlens
    PWM_OMEGA = omega ; PW_XCMODE = xc_mode
    let mut empty_f: [float] = []
    PW_VH = empty_f
    PW_FDG_ON = false
    qforge_scf_pw_set_hgrid(nx, ny, nz, b1, b2, b3)
    let n = len(gvecs) / 3
    let nk = len(kweights)

    // ── precompute H_bare(k) once per k (ρ-independent — V_loc + V_NL) ──────────
    let mut bare_k: [PwHam] = []
    let mut ik = 0
    while ik < nk {
        let mut kv: [float] = []
        kv.push(kvecs[ik * 3]) ; kv.push(kvecs[ik * 3 + 1]) ; kv.push(kvecs[ik * 3 + 2])
        PWM_KVEC = kv
        let mut no_scr: [float] = []
        let hk = qforge_assemble_h_multi(PWM_KVEC, PWM_GVECS, PWM_NSPEC,
                                         PWM_RS, PWM_RABS, PWM_VLOCS, PWM_MLENS, PWM_ZS,
                                         PWM_POSS, PWM_PALENS, PWM_BETAS, PWM_LS, PWM_DIJ,
                                         PWM_NPROJS, PWM_BLENS, PWM_DLENS, PWM_OMEGA, no_scr)
        bare_k.push(hk)
        ik = ik + 1
    }

    let nf = to_float(nelec) ; let nnf = to_float(n)
    let r_up0 = (nf + init_mag) / (2.0 * nnf)
    let r_dn0 = (nf - init_mag) / (2.0 * nnf)
    let mut rho_up: [float] = [] ; let mut rho_dn: [float] = []
    let mut ii = 0
    while ii < n { rho_up.push(r_up0) ; rho_dn.push(r_dn0) ; ii = ii + 1 }

    let mut hin_u: [float] = [] ; let mut hout_u: [float] = []
    let mut hin_d: [float] = [] ; let mut hout_d: [float] = []
    let mut hh = 0
    let mut evals_up0: [float] = [] ; let mut evals_dn0: [float] = []
    let mut e_total = 0.0 ; let mut e_prev = 0.0 ; let mut mag = 0.0
    let mut iters = 0 ; let mut converged = false ; let mut first = true

    while iters < max_iter {
        iters = iters + 1
        // k-independent screening per spin (V_H[ρ_tot] + V_xc^σ).
        let mut rho_tot: [float] = []
        let mut tt = 0
        while tt < n { rho_tot.push(rho_up[tt] + rho_dn[tt]) ; tt = tt + 1 }
        let mut vh = PW_VH
        if PW_HGRID_ON {
            if n == PW_NX * PW_NY * PW_NZ {
                vh = qforge_vhartree_from_rho(rho_tot, PW_NX, PW_NY, PW_NZ, PW_B1, PW_B2, PW_B3)
            }
        }
        let vscr_up = qforge_vscr_diag_spin(rho_up, rho_dn, vh, PW_XCMODE, 1.0)
        let vscr_dn = qforge_vscr_diag_spin(rho_up, rho_dn, vh, PW_XCMODE, -1.0)

        // per (k,spin): diagonalize H_bare(k)+diag(vscr_σ). Collect evals + evecs.
        let mut all_ev: [float] = [] ; let mut all_w: [float] = []
        let mut ev_u_k: [[float]] = [] ; let mut ev_d_k: [[float]] = []
        let mut vec_u_k: [[float]] = [] ; let mut vec_d_k: [[float]] = []
        ik = 0
        while ik < nk {
            let bk = bare_k[ik]
            let mut diag_u: [float] = [] ; let mut diag_d: [float] = []
            let mut di = 0
            while di < n { diag_u.push(bk.diag[di] + vscr_up[di]) ; diag_d.push(bk.diag[di] + vscr_dn[di]) ; di = di + 1 }
            PW_BARE = bk
            PW_VSCR_UP = vscr_up
            let dru = qforge_davidson(qforge_pw_bare_apply_up, diag_u, n, nbands, 1.0e-10, 200)
            PW_VSCR_DN = vscr_dn
            let drd = qforge_davidson(qforge_pw_bare_apply_dn, diag_d, n, nbands, 1.0e-10, 200)
            ev_u_k.push(dru.evals) ; ev_d_k.push(drd.evals)
            vec_u_k.push(dru.evecs) ; vec_d_k.push(drd.evecs)
            let wk = kweights[ik]
            let mut bb = 0
            while bb < nbands {
                all_ev.push(dru.evals[bb]) ; all_w.push(wk)
                all_ev.push(drd.evals[bb]) ; all_w.push(wk)
                bb = bb + 1
            }
            ik = ik + 1
        }
        evals_up0 = ev_u_k[0] ; evals_dn0 = ev_d_k[0]

        // ONE shared E_F over the weighted BZ multi-set.
        let ef = qforge_fermi_level_weighted(all_ev, all_w, nelec, sigma)

        // ρ_σ = Σ_k w_k Σ_b f(ε−E_F)|ψ|²; magnetization + band energy + entropy.
        let mut rho_out_u: [float] = [] ; let mut rho_out_d: [float] = []
        let mut z = 0
        while z < n { rho_out_u.push(0.0) ; rho_out_d.push(0.0) ; z = z + 1 }
        let mut n_up = 0.0 ; let mut n_dn = 0.0
        let mut eband = 0.0 ; let mut entropy = 0.0
        ik = 0
        while ik < nk {
            let wk = kweights[ik]
            let mut occ_u: [float] = [] ; let mut occ_d: [float] = []
            let mut bb = 0
            while bb < nbands {
                let fu = qforge_fermi_dirac(ev_u_k[ik][bb], ef, sigma)
                let fd = qforge_fermi_dirac(ev_d_k[ik][bb], ef, sigma)
                occ_u.push(fu) ; occ_d.push(fd)
                n_up = n_up + wk * fu ; n_dn = n_dn + wk * fd
                eband = eband + wk * (fu * ev_u_k[ik][bb] + fd * ev_d_k[ik][bb])
                bb = bb + 1
            }
            entropy = entropy + wk * (qforge_smearing_entropy(occ_u, 1.0) + qforge_smearing_entropy(occ_d, 1.0))
            let psis_u = scf_slice_psis(vec_u_k[ik], nbands, n)
            let psis_d = scf_slice_psis(vec_d_k[ik], nbands, n)
            let rk_u = qforge_rho_of_psi(psis_u, occ_u, nbands)
            let rk_d = qforge_rho_of_psi(psis_d, occ_d, nbands)
            let mut q = 0
            while q < n { rho_out_u[q] = rho_out_u[q] + wk * rk_u[q] ; rho_out_d[q] = rho_out_d[q] + wk * rk_d[q] ; q = q + 1 }
            ik = ik + 1
        }
        mag = n_up - n_dn
        e_total = eband - sigma * entropy

        let dru2 = scf_dmax(rho_up, rho_out_u, n)
        let drd2 = scf_dmax(rho_dn, rho_out_d, n)
        let mut dr_rho = dru2
        if drd2 > dr_rho { dr_rho = drd2 }
        let dr_e = if first { tol + 1.0 } else { scf_abs(e_total - e_prev) }
        let resid = if dr_rho > dr_e { dr_rho } else { dr_e }

        // Anderson (per spin) / linear mixing.
        let mut t2 = 0
        while t2 < n {
            hin_u.push(rho_up[t2]) ; hout_u.push(rho_out_u[t2])
            hin_d.push(rho_dn[t2]) ; hout_d.push(rho_out_d[t2])
            t2 = t2 + 1
        }
        hh = hh + 1
        let mut a = mix
        if a <= 0.0 { a = 0.1 }
        if a > 1.0 { a = 1.0 }
        let mut rnu: [float] = [] ; let mut rnd: [float] = []
        if and_depth > 0 {
            rnu = qforge_anderson_next(hin_u, hout_u, hh, n, and_depth, a)
            rnd = qforge_anderson_next(hin_d, hout_d, hh, n, and_depth, a)
        } else {
            let mut k2 = 0
            while k2 < n { rnu.push((1.0 - a) * rho_up[k2] + a * rho_out_u[k2]) ; rnd.push((1.0 - a) * rho_dn[k2] + a * rho_out_d[k2]) ; k2 = k2 + 1 }
        }
        let cap = and_depth + 2
        if and_depth > 0 && hh > cap {
            let ndrop = hh - cap
            let mut tiu: [float] = [] ; let mut tou: [float] = [] ; let mut tid: [float] = [] ; let mut tod: [float] = []
            let mut keep = ndrop
            while keep < hh {
                let mut z2 = 0
                while z2 < n {
                    tiu.push(hin_u[keep * n + z2]) ; tou.push(hout_u[keep * n + z2])
                    tid.push(hin_d[keep * n + z2]) ; tod.push(hout_d[keep * n + z2])
                    z2 = z2 + 1
                }
                keep = keep + 1
            }
            hin_u = tiu ; hout_u = tou ; hin_d = tid ; hout_d = tod ; hh = cap
        }
        rho_up = rnu ; rho_dn = rnd
        e_prev = e_total ; first = false
        if resid < tol {
            converged = true
            return ScfResultSpin { rho_up: rho_up, rho_dn: rho_dn,
                                   evals_up: evals_up0, evals_dn: evals_dn0,
                                   e_total: e_total, magnetization: mag, iters: iters, converged: true }
        }
    }
    return ScfResultSpin { rho_up: rho_up, rho_dn: rho_dn,
                           evals_up: evals_up0, evals_dn: evals_dn0,
                           e_total: e_total, magnetization: mag, iters: iters, converged: converged }
}

// ── MULTI-SPECIES SMEARED SCF with BASIS-DECOUPLED screening (QFORGE-PERF fix) ──
//   Same staging + smeared+Anderson driver as qforge_scf_pw_h_multi_smeared, but
//   enables the basis-DECOUPLED G=0 screening (uniform-gas V_xc(ρ̄), ρ̄=nelec/Ω):
//   the (1,1,NPW) FFT path is bypassed (no silent Hartree flip across NPW) and the
//   diagonal screening is identical for every NPW. The remaining energy is then the
//   kinetic+V_ext+V_NL Rayleigh-Ritz functional → MONOTONE + PLATEAU in NPW. This
//   is the entry the real-cell CaH6 monotonicity gate drives. d4-generic — every
//   hydride traverses this one path; ρ̄ = nelec/Ω is the only added datum.
pub fn qforge_scf_pw_h_multi_smeared_fdg(kvec: [float], gvecs: [float], nspec: int,
                                         rs: [float], rabs: [float], vlocs: [float],
                                         mlens: [int], zs: [float],
                                         poss: [float], palens: [int],
                                         betas: [float], ls: [int], dij: [float],
                                         nprojs: [int], blens: [int], dlens: [int],
                                         omega: float, xc_mode: int,
                                         nbands: int, nelec: int, mix: float, tol: float,
                                         max_iter: int, sigma: float, spin_deg: float,
                                         and_depth: int) -> ScfResult {
    PWM_KVEC = kvec ; PWM_GVECS = gvecs ; PWM_NSPEC = nspec
    PWM_RS = rs ; PWM_RABS = rabs ; PWM_VLOCS = vlocs ; PWM_MLENS = mlens ; PWM_ZS = zs
    PWM_POSS = poss ; PWM_PALENS = palens
    PWM_BETAS = betas ; PWM_LS = ls ; PWM_DIJ = dij
    PWM_NPROJS = nprojs ; PWM_BLENS = blens ; PWM_DLENS = dlens
    PWM_OMEGA = omega
    let mut empty_f: [float] = []
    PW_VH = empty_f ; PW_XCMODE = xc_mode
    PW_HGRID_ON = false                                    // bypass the (1,1,NPW) FFT path
    PW_FDG_ON = true                                       // enable basis-decoupled screening
    PW_FDG_RHOBAR = (if omega > 0.0 { to_float(nelec) / omega } else { 0.0 })                // ρ̄ — NPW-independent
    let n = len(gvecs) / 3
    return qforge_scf_smeared(qforge_h_of_rho_multi, qforge_rho_of_psi, n, nbands,
                              nelec, mix, tol, max_iter, sigma, spin_deg, and_depth)
}

// ── FDG SCF reporting the VARIATIONAL TOTAL ENERGY (QFORGE-PERF e_tot) ─────────
//   Same staging + basis-decoupled FDG screening as qforge_scf_pw_h_multi_smeared_fdg,
//   but reports the variational Kohn-Sham total energy instead of the bare band sum:
//     E_tot = Σocc·ε − σ·S  +  e_dc,   e_dc = (E_xc[ρ̄] − ∫V_xc·ρ̄) + 0(V_H) + E_ewald.
//   The xc double-count is closed-form from ρ̄=nelec/Ω (scf_etot.qforge_edc_uniform);
//   the Hartree double-count is 0 in the neutral G=0 gauge; E_ewald (the ion-ion
//   Madelung constant) is supplied by the caller (scf_etot.qforge_ewald — a basis-
//   independent constant for the cell). All e_dc terms are NPW-INDEPENDENT, so this
//   tests whether the variational E_tot plateaus where the bare band sum did not.
//   d4-generic — e_ewald is data; every hydride traverses this one path.
pub fn qforge_scf_pw_h_multi_smeared_fdg_etot(kvec: [float], gvecs: [float], nspec: int,
                                              rs: [float], rabs: [float], vlocs: [float],
                                              mlens: [int], zs: [float],
                                              poss: [float], palens: [int],
                                              betas: [float], ls: [int], dij: [float],
                                              nprojs: [int], blens: [int], dlens: [int],
                                              omega: float, xc_mode: int,
                                              nbands: int, nelec: int, mix: float, tol: float,
                                              max_iter: int, sigma: float, spin_deg: float,
                                              and_depth: int, e_ewald: float) -> ScfResult {
    PWM_KVEC = kvec ; PWM_GVECS = gvecs ; PWM_NSPEC = nspec
    PWM_RS = rs ; PWM_RABS = rabs ; PWM_VLOCS = vlocs ; PWM_MLENS = mlens ; PWM_ZS = zs
    PWM_POSS = poss ; PWM_PALENS = palens
    PWM_BETAS = betas ; PWM_LS = ls ; PWM_DIJ = dij
    PWM_NPROJS = nprojs ; PWM_BLENS = blens ; PWM_DLENS = dlens
    PWM_OMEGA = omega
    let mut empty_f: [float] = []
    PW_VH = empty_f ; PW_XCMODE = xc_mode
    PW_HGRID_ON = false                                    // bypass the (1,1,NPW) FFT path
    PW_FDG_ON = true                                       // enable basis-decoupled screening
    let rhobar = (if omega > 0.0 { to_float(nelec) / omega } else { 0.0 })                   // ρ̄ — NPW-independent
    PW_FDG_RHOBAR = rhobar
    // the variational correction: xc double-count (closed-form in ρ̄) + Ewald.
    //   V_H double-count = 0 (neutral G=0 gauge); both terms NPW-independent.
    let e_dc = qforge_edc_uniform(rhobar, nelec, xc_mode) + e_ewald
    let n = len(gvecs) / 3
    return qforge_scf_smeared_dc(qforge_h_of_rho_multi, qforge_rho_of_psi, n, nbands,
                                 nelec, mix, tol, max_iter, sigma, spin_deg, and_depth, e_dc)
}
