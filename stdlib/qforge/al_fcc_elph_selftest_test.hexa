// @ci_gate — pure · network-free · deterministic (stdlib_selftest_aggregate --ci-gate)
//
// al_fcc_elph_selftest.hexa — g5 INVARIANT selftest for the fcc-Al composed
// el-ph validation harness (al_fcc_elph_xval). Asserts the harness primitives
// hold the physical invariants INDEPENDENT of the literature comparison:
//   (1) α²F(ω) ≥ 0 everywhere (a spectral function is non-negative)
//   (2) λ ≥ 0 for a physical (D>0) dataset
//   (3) zero-coupling (D=0) → no positive λ (the orchestrator non-positive sentinel)
//   (4) λ is LINEAR in the deformation potential D (2× D → 2× λ) — the property
//       the calibration relies on
//   (5) BZ convergence is MONOTONE-bounded: λ at successively finer q-meshes
//       stays within a small band (the plateau the headline gate asserts)
//   (6) Einstein closed-form round-trip: the SAME assembler reproduces the
//       analytic single-mode λ to rel-ε (qforge_einstein_lambda_analytic) —
//       pins that the composed back-end the Al harness uses is the verified one.
//
// Run:  HEXA_STDLIB_ROOT=<worktree> hexa run stdlib/qforge/al_fcc_elph_selftest_test.hexa
// PASS: exits printing "al_fcc_elph_selftest PASS".

use "stdlib/qforge/elph"
use "stdlib/qforge/orchestrator"

fn _abs(x: float) -> float { if x < 0.0 { return -x } return x }

fn _rel(got: float, want: float) -> float {
    let w = _abs(want)
    let d = _abs(got - want)
    if w < 1e-12 { return d }
    return d / w
}

// Minimal physical el-ph dataset on a uniform ω grid: nq modes on E_F, single
// Einstein-like ω₀, constant |g|² = g2c. Returns the QforgeElphResult.
fn _mini_run(nq: int, g2c: float, omega0_K: float, n_ef: float) -> QforgeElphResult {
    let mut eps_k: [float] = []
    let mut eps_kq: [float] = []
    let mut g2: [float] = []
    let mut om: [float] = []
    let ef = 0.0
    let mut i = 0
    while i < nq {
        eps_k = eps_k.push(ef)
        eps_kq = eps_kq.push(ef)
        g2 = g2.push(g2c)
        om = om.push(omega0_K)
        i = i + 1
    }
    let ng = 400
    let wmax = omega0_K * 2.0
    let mut grid: [float] = []
    let mut j = 0
    while j < ng {
        grid = grid.push(wmax * to_float(j + 1) / to_float(ng))
        j = j + 1
    }
    let weight = 1.0 / to_float(nq)
    let sigma_el = 0.30
    let sigma_ph = wmax / to_float(ng) * 1.5
    return qforge_elph_to_tc(eps_k, eps_kq, g2, om, ef, n_ef, grid, weight,
                             sigma_el, sigma_ph, 0.13, 256)
}

fn main() {
    let mut fails = 0
    println("── al_fcc_elph_selftest — composed-harness invariants (g5) ──")

    let nef = 0.386                  // Al free-electron N(E_F) [st/eV/cell]
    let w0 = 300.0                   // Einstein ω₀ [K]

    // (1)+(2) α²F ≥ 0 everywhere, λ ≥ 0 for a physical dataset.
    let r1 = _mini_run(64, 1.0e-22, w0, nef)
    if r1.ok != 1 {
        println("FAIL (1/2) physical dataset returned ok=0 (" + r1.err + ")")
        fails = fails + 1
    } else {
        let mut neg = false
        let mut k = 0
        while k < len(r1.a2f) {
            if r1.a2f[k] < 0.0 { neg = true }
            k = k + 1
        }
        if neg { println("FAIL (1) α²F has a negative bin"); fails = fails + 1 }
        else { println("PASS (1) α²F(ω) ≥ 0 everywhere (" + to_string(len(r1.a2f)) + " bins)") }
        if r1.lambda >= 0.0 { println("PASS (2) λ ≥ 0 (λ=" + to_string(r1.lambda) + ")") }
        else { println("FAIL (2) λ<0 (" + to_string(r1.lambda) + ")"); fails = fails + 1 }
    }

    // (3) zero-coupling D=0 → no positive λ (orchestrator non-positive sentinel).
    let r0 = _mini_run(64, 0.0, w0, nef)
    if r0.lambda <= 0.0 {
        println("PASS (3) zero-coupling → no positive λ (got " + to_string(r0.lambda) + ")")
    } else {
        println("FAIL (3) zero-coupling produced λ=" + to_string(r0.lambda))
        fails = fails + 1
    }

    // (4) λ LINEAR in |g|² (= linear in D): 2× g2 → 2× λ to rel-ε.
    let ra = _mini_run(64, 1.0e-22, w0, nef)
    let rb = _mini_run(64, 2.0e-22, w0, nef)
    if ra.ok == 1 && rb.ok == 1 && ra.lambda > 0.0 {
        let ratio = rb.lambda / ra.lambda
        let rel = _rel(ratio, 2.0)
        if rel <= 1e-6 {
            println("PASS (4) λ linear in |g|² (2× → ratio=" + to_string(ratio) + ")")
        } else {
            println("FAIL (4) λ not linear in |g|² (ratio=" + to_string(ratio) + ")")
            fails = fails + 1
        }
    } else {
        println("FAIL (4) linearity probe returned a sentinel")
        fails = fails + 1
    }

    // (5) BZ-convergence bounded: finer nq stays within a small band of coarse.
    let c1 = _mini_run(32, 1.0e-22, w0, nef)
    let c2 = _mini_run(256, 1.0e-22, w0, nef)
    if c1.ok == 1 && c2.ok == 1 && c1.lambda > 0.0 {
        let drift = _rel(c2.lambda, c1.lambda)
        if drift < 0.05 {
            println("PASS (5) BZ-convergence bounded (32↔256 modes drift=" + to_string(drift) + " < 5%)")
        } else {
            println("FAIL (5) BZ drift=" + to_string(drift) + " ≥ 5% (not converging)")
            fails = fails + 1
        }
    } else {
        println("FAIL (5) convergence probe returned a sentinel")
        fails = fails + 1
    }

    // (6) Einstein closed-form round-trip — the assembler reproduces the analytic
    // single-mode λ for the SAME inputs (proves the composed path == verified one).
    let nk = 64
    let g2c = 1.0e-22
    let weight = 1.0 / to_float(nk)
    let sigma_el = 0.30
    let packed = qforge_a2f_einstein_samples(nk, 0.0, g2c, w0)
    let mut ek: [float] = []
    let mut ekq: [float] = []
    let mut gg: [float] = []
    let mut oo: [float] = []
    let mut p = 0
    while p < nk { ek = ek.push(packed[p]); p = p + 1 }
    p = 0
    while p < nk { ekq = ekq.push(packed[nk + p]); p = p + 1 }
    p = 0
    while p < nk { gg = gg.push(packed[2 * nk + p]); p = p + 1 }
    p = 0
    while p < nk { oo = oo.push(packed[3 * nk + p]); p = p + 1 }
    let ng = 4000
    let wmax = w0 * 2.0
    let mut grid: [float] = []
    let mut j = 0
    while j < ng { grid = grid.push(wmax * to_float(j + 1) / to_float(ng)); j = j + 1 }
    let sigma_ph = wmax / to_float(ng) * 1.2
    let a2f = qforge_a2f_from_elph_impl(ek, ekq, gg, oo, 0.0, nef, grid,
                                        weight, sigma_el, sigma_ph)
    let lam_qf = qforge_a2f_lambda(grid, a2f)
    let lam_an = qforge_einstein_lambda_analytic(nk, g2c, w0, nef, weight, sigma_el)
    let rel6 = _rel(lam_qf, lam_an)
    if rel6 <= 0.02 {
        println("PASS (6) Einstein round-trip λ_assembled=" + to_string(lam_qf)
                + " ≈ analytic " + to_string(lam_an) + " (rel-ε=" + to_string(rel6) + ")")
    } else {
        println("FAIL (6) Einstein round-trip λ_assembled=" + to_string(lam_qf)
                + " vs analytic " + to_string(lam_an) + " (rel-ε=" + to_string(rel6) + " > 2%)")
        fails = fails + 1
    }

    if fails == 0 {
        println("al_fcc_elph_selftest PASS")
    } else {
        println("al_fcc_elph_selftest FAIL — " + to_string(fails) + " invariant(s)")
    }
}
