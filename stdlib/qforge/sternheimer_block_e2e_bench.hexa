// ════════════════════════════════════════════════════════════════════════
// stdlib/qforge/sternheimer_block_e2e_bench.hexa — QFORGE-PERF round 2 ⚡
//   END-TO-END Sternheimer DFPT solve: SCALAR path (per-state loop of
//   qforge_sternheimer — the current caller pattern in screened_dv / elph_scf /
//   dfpt_response) vs BLOCK path (qforge_sternheimer_block — ONE GEMM
//   H[n,n]@P[n,nb] per CG iter). The win must show in the FULL multi-state
//   solve wall, not just the H-apply microbench.
//
//   PARITY GATE: per-state |Δψ_block − Δψ_scalar| must agree to tight tol.
//   occ_states are a synthetic ORTHONORMAL set (Gram-Schmidt on deterministic
//   random vectors) — the P_c projection / CG only need an orthonormal basis,
//   and BOTH paths get the identical set, so parity is the meaningful gate.
//   (No dense eigh setup → tractable at n≥1024; the solver math is unchanged.)
//
// Run (CPU parity gate):
//   HEXA_STDLIB_ROOT="$PWD/stdlib" hexa run stdlib/qforge/sternheimer_block_e2e_bench.hexa
// Run (GPU pod, CUDA build): same command on the cuda-built hexa.
// ════════════════════════════════════════════════════════════════════════
use "stdlib/qforge/assembler"
use "stdlib/qforge/sternheimer"

fn _abs(x: float) -> float { if x < 0.0 { return -x } return x }

fn _lcg_next(state: int) -> int {
    let nxt = (state * 1103515245 + 12345)
    let masked = nxt % 2147483647
    if masked < 0 { return masked + 2147483647 }
    return masked
}

fn build_sym_ham(n: int, seed0: int) -> PwHam {
    let mut h: [float] = []
    let mut t = 0
    while t < n * n { h.push(0.0) ; t = t + 1 }
    let mut seed = seed0
    let mut i = 0
    while i < n {
        let mut j = i
        while j < n {
            seed = _lcg_next(seed)
            let mut v = ((to_float(seed % 20000) / 10000.0) - 1.0) * 0.05
            if i == j { v = to_float(i) + 1.0 }
            h[i * n + j] = v
            h[j * n + i] = v
            j = j + 1
        }
        i = i + 1
    }
    let mut diag: [float] = []
    let mut d = 0
    while d < n { diag.push(h[d * n + d]) ; d = d + 1 }
    return PwHam { h: h, diag: diag, n: n }
}

fn vdot(a: [float], b: [float], n: int) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < n { s = s + a[i] * b[i] ; i = i + 1 }
    return s
}

fn main() {
    println("QFORGE-PERF round 2 — Sternheimer FULL-SOLVE scalar-loop vs block")
    println("n , nb , scalar_ns , block_ns , wallDelta , maxAbsDdpsi , scalarConv , blockConv")

    let ns  = [1024, 1024, 1536]
    let nbs = [4,    8,    6]      // occupied-band count (small for our cells)
    let TOL = 1.0e-8

    let mut c = 0
    while c < len(ns) {
        let n = ns[c]
        let nb = nbs[c]
        let ham = build_sym_ham(n, 11357 + n + nb)

        // ── synthetic ORTHONORMAL occ_states (Gram-Schmidt on random) ──────
        let mut occ_states = []
        let mut eps = []
        let mut psi_states = []
        let mut seed = 424242 + n
        let mut s = 0
        while s < nb {
            // raw random vector
            let mut w = []
            let mut k = 0
            while k < n {
                seed = _lcg_next(seed)
                w.push((to_float(seed % 20000) / 10000.0) - 1.0)
                k = k + 1
            }
            // orthogonalize vs previous occ_states
            let mut p = 0
            while p < s {
                let proj = vdot(occ_states[p], w, n)
                let mut i = 0
                while i < n { w[i] = w[i] - proj * occ_states[p][i] ; i = i + 1 }
                p = p + 1
            }
            // normalize
            let nrm = sqrt(vdot(w, w, n))
            let mut i2 = 0
            while i2 < n { w[i2] = w[i2] / nrm ; i2 = i2 + 1 }
            occ_states.push(w)
            psi_states.push(w)
            // ε_s well BELOW the spectrum (diag starts at 1.0) → (H−ε_s) is SPD,
            // so the projected CG is SPD-convergent and BOTH paths reach the same
            // solution — a clean solver-equivalence (parity) gate. (Physical ε
            // would be an occupied eigenvalue; the GEMM seam is ε-independent.)
            eps.push(-10.0)
            s = s + 1
        }

        // perturbation dV·ψ_s : deterministic per-state vector.
        let mut dV_psi_flat = []
        let mut seed2 = 99173 + n
        let mut q = 0
        while q < nb * n {
            seed2 = _lcg_next(seed2)
            dV_psi_flat.push((to_float(seed2 % 20000) / 10000.0) - 1.0)
            q = q + 1
        }

        let h_apply = fn(v: [float]) -> [float] { return qforge_h_apply(ham, v) }
        let h_block = fn(p_flat: [float], mm: int) -> [float] {
            return qforge_h_apply_forge_block(ham, p_flat, mm)
        }

        // ── SCALAR per-state loop (current caller pattern) ─────────────────
        let mut dpsi_scalar = []
        let mut prep = 0
        while prep < nb * n { dpsi_scalar.push(0.0) ; prep = prep + 1 }
        let mut scalarConv = true
        let t0 = mono_ns()
        let mut ss = 0
        while ss < nb {
            let mut dvp = []
            let mut k = 0
            while k < n { dvp.push(dV_psi_flat[ss * n + k]) ; k = k + 1 }
            let res = qforge_sternheimer(h_apply, eps[ss], psi_states[ss],
                                         occ_states, dvp, n, TOL, 400)
            let mut w = 0
            while w < n { dpsi_scalar[ss * n + w] = res.dpsi[w] ; w = w + 1 }
            if res.converged == false { scalarConv = false }
            ss = ss + 1
        }
        let t1 = mono_ns()
        let scalar_ns = t1 - t0

        // ── BLOCK solve ────────────────────────────────────────────────────
        let t2 = mono_ns()
        let rb = qforge_sternheimer_block(h_apply, h_block, eps, psi_states,
                                          occ_states, dV_psi_flat, nb, n, TOL, 400)
        let t3 = mono_ns()
        let block_ns = t3 - t2

        // ── parity ─────────────────────────────────────────────────────────
        let mut maxd = 0.0
        let mut z = 0
        while z < nb * n {
            let d = _abs(dpsi_scalar[z] - rb.dpsi[z])
            if d > maxd { maxd = d }
            z = z + 1
        }
        let mut wall_delta = 0.0
        if block_ns > 0 { wall_delta = to_float(scalar_ns) / to_float(block_ns) }

        println(to_string(n) + " , " + to_string(nb) + " , "
            + to_string(scalar_ns) + " , " + to_string(block_ns) + " , "
            + to_string(wall_delta) + " , " + to_string(maxd) + " , "
            + to_string(scalarConv) + " , " + to_string(rb.all_converged))
        c = c + 1
    }
    println("sternheimer_block_e2e_bench DONE")
}
