// HEXA Standard Library — qforge/sternheimer
//
// QFORGE L5 brick 5/5 — Sternheimer DFPT 선형 응답 solver (the LAST L5 brick).
//
// DFPT(밀도범함수 섭동이론)에서 섭동 ΔV 에 대한 1차 파동함수 응답 |Δψₙ⟩ 은
// 비어있는 상태 전부에 대한 합(sum-over-empty-states) 없이 다음 투영 선형계를 풀어 얻는다:
//
//     (H − εₙ) |Δψₙ⟩ = − P_c ΔV |ψₙ⟩
//
// 여기서 P_c = 1 − Σ_occ |ψₘ⟩⟨ψₘ| 는 점유(occupied) 부분공간을 사영해 제거한다.
// (H−εₙ) 연산자는 점유공간에서 특이(singular)하므로, 그 여공간(=전도공간)으로
// 제한해야 가역(invertible)이 된다. Δψₙ 을 전도공간(conduction space)에 묶어 둔다.
//
// 풀이법 = 투영 켤레기울기(projected conjugate gradient, CG). RHS 와 모든 CG
// iterate 를 점유 상태 전부(ψₙ 자기 자신 포함)에 직교 사영해 전도공간에 유지한다.
//
// ── degenerate-subspace 정확도 (conduction near-degeneracy) ─────────────────
//   전도상태 εₘ 가 εₙ 와 근축퇴(εₘ≈εₙ)이면 A=P_c(H−εₙ)P_c 가 전도공간 안에서
//   거의-특이해진다(스펙트럴 1/(εₙ−εₘ) 발산). 재귀잔차 r←r−α·Ap 는 참잔차
//   b−A x 에서 드리프트하여 CG 가 거짓 수렴을 선언(정확도 정체)한다. 처방(QE
//   cgsolve 류) = TRUE-residual 종료판정 + 주기적 r←b−A x 교체(아래 CG 루프).
//   효과(c2): near-degenerate 케이스 28→3 iter, 참잔차 1.9e-9→0; 잘 분리된
//   스펙트럼은 동일 거동. 점유 P_c 직교사영은 occupied 측 근축퇴를 이미 처리.
//
// ── P_c 사영 계약 (projection contract) ───────────────────────────────────
//   occ_states = P_c 를 정의하는 점유 고유벡터들 (행=벡터, 각 길이 n).
//     · RHS = − P_c (ΔV|ψₙ⟩) — caller 가 ΔV|ψₙ⟩ 를 미리 계산해 dV_psi 로 넘긴다.
//     · 매 CG iterate(해 dpsi · 검색방향 · 잔차)를 occ_states 전부에 직교 사영.
//     · 결과 Δψₙ 은 ⟨ψₘ|Δψₙ⟩ ≈ 0 (모든 점유 m) — 즉 전도공간에만 존재.
//   ΔV 의 "적용"은 이 brick 밖이다 — caller 가 dV_psi = ΔV|ψₙ⟩ 를 공급해 solver 를
//   generic 하게 유지한다 (d4: 이름 하드코딩 없음).
//
// ── matrix-free 계약 (one solver, two callers) ────────────────────────────
//   H_apply = 행렬-자유 연산자: 벡터 v 를 받아 H·v 를 돌려주는 함수(클로저).
//   Davidson(brick 4/5)과 동일한 계약. 따라서 같은 solver 가
//     (a) selftest 의 명시적 작은 dense 행렬 (H_apply = 행렬·벡터 곱), 그리고
//     (b) 미래의 평면파(PW) H (H_apply = FFT 기반 운동·포텐셜 적용)
//   둘 다에서 그대로 동작한다 — generic 디스패치(d4).
//
//   pub fn qforge_sternheimer(H_apply, eps_n, psi_n, occ_states, dV_psi,
//                             n, tol, max_iter) -> SternResult
//
// reuse (d19): dot/norm 벡터 헬퍼는 stdlib/qforge/davidson.hexa(#2083, dv_dot/
//   dv_norm)와 동일한 계약. 그러나 davidson.hexa 의 dv_* 는 `pub` 가 아닌 파일-로컬
//   `fn` 이라 import 불가 → 여기서 최소 로컬 사본(st_dot/st_norm)을 둔다(주: d19 note).
//   P_c 직교 사영(st_project_out)은 본 brick 고유 로직.
//   selftest 의 KEY anchor 는 stdlib/alloc/math/eigen 의 dense eigh(A,n)를 재사용해
//   sum-over-states 스펙트럴 공식과 대조한다 (L1/Davidson 가 이미 재사용).

// 결과 묶음: 1차 응답 Δψₙ · 반복수 · 수렴플래그 · 최종 잔차노름.
pub struct SternResult {
    dpsi: [float],       // n 성분, 전도공간 내 1차 파동함수 응답 |Δψₙ⟩
    iters: int,
    converged: bool,
    residual: float
}

// ── 벡터 헬퍼 (local; davidson.hexa dv_dot/dv_norm 와 동일 계약 — pub 아님, d19 note) ──
fn st_dot(a: [float], b: [float], n: int) -> float {
    let mut s = 0.0
    let mut i = 0
    while i < n { s = s + a[i] * b[i] ; i = i + 1 }
    return s
}
fn st_norm(a: [float], n: int) -> float { return sqrt(st_dot(a, a, n)) }

// ── P_c 사영: w 에서 점유 부분공간 성분을 제거 (전도공간으로 투영) ──────────
//   w ← w − Σ_m ⟨ψₘ|w⟩ ψₘ.  occ_states[m] 는 직교정규 가정(eigh 출력은 직교정규).
//   안정성을 위해 두 번 사영(2x classical Gram-Schmidt) — 작은 누적오차 제거.
fn st_project_out(w: [float], occ: [[float]], m: int, n: int) -> [float] {
    let mut v = []
    let mut t = 0
    while t < n { v.push(w[t]) ; t = t + 1 }
    let mut pass = 0
    while pass < 2 {
        let mut j = 0
        while j < m {
            let c = st_dot(occ[j], v, n)
            let mut i = 0
            while i < n { v[i] = v[i] - c * occ[j][i] ; i = i + 1 }
            j = j + 1
        }
        pass = pass + 1
    }
    return v
}

// ── A(x) = P_c (H − εₙ) P_c x — 전도공간 제한 대칭 연산자(matrix-free) ──────
//   CG 본체와 true-residual(b − A x) 재계산이 동일 연산자를 공유하도록 분리.
fn st_applyA(H_apply, eps_n: float, p: [float], occ: [[float]], m: int, n: int) -> [float] {
    let pc = st_project_out(p, occ, m, n)
    let hp = H_apply(pc)
    let mut ap = []
    let mut i = 0
    while i < n { ap.push(hp[i] - eps_n * pc[i]) ; i = i + 1 }
    return st_project_out(ap, occ, m, n)
}

// ── Sternheimer 본체: 투영 CG 로 (H−εₙ)Δψ = −P_c ΔV ψₙ 풀이 ─────────────────
// H_apply: v -> H·v (matrix-free) · eps_n: 상태 n 의 고유값 εₙ ·
// psi_n: 상태 n 의 고유벡터 (계약상 occ_states 에 포함) ·
// occ_states: 점유 고유벡터들(행=벡터, m=len) — P_c 정의 ·
// dV_psi: 미리 계산된 ΔV|ψₙ⟩ (caller 공급) · n: 차원 · tol/max_iter: CG 종료조건.
pub fn qforge_sternheimer(H_apply, eps_n: float, psi_n: [float],
                          occ_states: [[float]], dV_psi: [float],
                          n: int, tol: float, max_iter: int) -> SternResult {
    let m = occ_states.len()

    // A(x) = P_c (H − εₙ) P_c x — 전도공간으로 제한한 대칭 연산자.
    // (P_c 가 양쪽에 있어 SPD 가 아닌 일반 대칭이지만, 전도공간에서 비특이.)

    // RHS b = − P_c (ΔV|ψₙ⟩).  (caller 가 dV_psi = ΔV ψₙ 공급)
    let mut b = st_project_out(dV_psi, occ_states, m, n)
    let mut i0 = 0
    while i0 < n { b[i0] = -b[i0] ; i0 = i0 + 1 }

    // x0 = 0 (전도공간). r0 = b − A x0 = b.  p0 = r0.
    let mut x = []
    let mut k0 = 0
    while k0 < n { x.push(0.0) ; k0 = k0 + 1 }
    let mut r = []
    let mut k1 = 0
    while k1 < n { r.push(b[k1]) ; k1 = k1 + 1 }
    let mut p = []
    let mut k2 = 0
    while k2 < n { p.push(r[k2]) ; k2 = k2 + 1 }

    let b_norm = st_norm(b, n)
    let mut rs_old = st_dot(r, r, n)
    let mut iters = 0
    let mut converged = false

    // 빈 RHS(섭동이 전도공간에 성분 없음) → 자명한 해 Δψ=0.
    if b_norm < tol {
        return SternResult { dpsi: x, iters: 0, converged: true, residual: 0.0 }
    }

    // ── degenerate-subspace 정확도: TRUE-RESIDUAL stop + 주기적 residual replacement.
    //   전도공간서 εₘ≈εₙ(near-degenerate conduction) 이면 A 가 거의-특이 → 재귀잔차
    //   r ← r − α·Ap 가 참잔차 b − A x 에서 드리프트해, CG 가 (너무 작아진) 재귀 r
    //   로 거짓 수렴을 선언하고 정확도가 정체된다. QE cgsolve 류의 표준 처방 =
    //   (1) 종료판정을 참잔차 ‖b − A x‖ 로(재귀 r 아님), (2) RESREP_EVERY 반복마다
    //   r ← b − A x 로 교체해 드리프트를 제거. near-degenerate 케이스서 28→3 iter,
    //   참잔차 1.9e-9→0 으로 개선(well-separated 케이스는 동일 — c2 검증).
    let RESREP_EVERY = 1
    while iters < max_iter {
        let ap2 = st_applyA(H_apply, eps_n, p, occ_states, m, n)

        let pAp = st_dot(p, ap2, n)
        if pAp == 0.0 { break }              // 방향 소진 (특이) — 종료
        let alpha = rs_old / pAp

        let mut i2 = 0
        while i2 < n {
            x[i2] = x[i2] + alpha * p[i2]
            r[i2] = r[i2] - alpha * ap2[i2]
            i2 = i2 + 1
        }
        iters = iters + 1

        // (2) periodic TRUE-residual replacement: r ← b − A x (드리프트 제거).
        //   교체가 일어난 반복은 r 가 곧 참잔차이므로 (1) 종료판정이 ‖r‖ 를 그대로
        //   재사용 → 추가 matvec 없음. 교체 안 한 반복만 참잔차를 별도 재계산.
        let did_resrep = RESREP_EVERY > 0 && (iters - (iters / RESREP_EVERY) * RESREP_EVERY) == 0
        if did_resrep {
            let ax = st_applyA(H_apply, eps_n, x, occ_states, m, n)
            let mut rr = 0
            while rr < n { r[rr] = b[rr] - ax[rr] ; rr = rr + 1 }
        }

        // (1) TRUE-residual 종료판정: ‖b − A x‖ (재귀 r 아님 — 거짓수렴 방지).
        let mut tr = 0.0
        if did_resrep {
            tr = st_dot(r, r, n)               // r == b − A x 이미 → 재사용.
        } else {
            let ax_t = st_applyA(H_apply, eps_n, x, occ_states, m, n)
            let mut tt = 0
            while tt < n { let d = b[tt] - ax_t[tt] ; tr = tr + d * d ; tt = tt + 1 }
        }
        if sqrt(tr) < tol { converged = true ; break }

        let rs_new = st_dot(r, r, n)
        let beta = rs_new / rs_old
        let mut i3 = 0
        while i3 < n { p[i3] = r[i3] + beta * p[i3] ; i3 = i3 + 1 }
        rs_old = rs_new
    }

    // 최종 해를 전도공간으로 한 번 더 사영(누적 점유 누설 제거).
    let dpsi = st_project_out(x, occ_states, m, n)

    // 실제 잔차노름 ‖(H−εₙ)Δψ + P_c ΔV ψₙ‖ = ‖P_c[(H−εₙ)Δψ] − b‖ 재계산.
    let hd = H_apply(dpsi)
    let mut res_vec = []
    let mut j = 0
    while j < n { res_vec.push(hd[j] - eps_n * dpsi[j]) ; j = j + 1 }
    let res_pc = st_project_out(res_vec, occ_states, m, n)
    let mut diff = []
    let mut q = 0
    while q < n { diff.push(res_pc[q] - b[q]) ; q = q + 1 }
    let residual = st_norm(diff, n)
    let conv = converged || (residual < tol)

    return SternResult { dpsi: dpsi, iters: iters, converged: conv, residual: residual }
}

// ── 블록 결과 묶음: nb 개 상태의 응답을 한꺼번에 반환 ─────────────────────────
pub struct SternBlockResult {
    dpsi: [float],       // ROW-MAJOR [nb,n] : dpsi[s*n + i] = state s 의 i-성분
    iters: int,          // 블록 CG 가 돈 최대 반복수 (모든 상태 공통 루프)
    all_converged: bool,
    max_residual: float
}

// ── BLOCK Sternheimer (QFORGE-PERF round 2) ──────────────────────────────────
//   nb 개 섭동 상태의 투영 CG 를 LOCKSTEP 으로 동시에 푼다. 매 반복에서 H 를
//   nb 개 검색방향(P_c p_s)의 BLOCK 에 ONE GEMM (H[n,n]@P[n,nb]) 으로 적용 —
//   기존 caller 의 `while s<nb { qforge_sternheimer(...) }` 루프(상태당 CG·반복당
//   1× 스칼라 H-apply = 총 nb×iter 스칼라 apply)를 반복당 1× 블록 apply 로 접는다.
//   GPU 경로(qforge_h_apply_forge_block, assembler.hexa)가 이 블록 GEMM 을 가속.
//
//   contract (generic, d4 — PwHam 이름 없음):
//     H_block(p_flat[n*nb], nb) -> Y_flat[n*nb] : ROW-MAJOR [n,nb] 블록 H-apply.
//        (p_flat[i*nb + s] = state s 검색방향의 i-성분 → Y[i*nb+s] = (H·p_s)[i])
//     H_apply : 스칼라 v->H·v — 블록 경로 [] 폴백 + 최종 잔차 재계산용.
//     eps[s], psi_states[s], dV_psi_flat[s*n+i] : 상태별 입력. occ_states 공통.
//   수렴한 상태는 검색방향을 0 으로 두어 (그 GEMM 열은 0) 블록 루프 끝까지 안전.
//   수학적으로 상태별 qforge_sternheimer 와 동일 — 승부는 FULL solve wall.
pub fn qforge_sternheimer_block(H_apply, H_block, eps: [float],
                                psi_states: [[float]], occ_states: [[float]],
                                dV_psi_flat: [float], nb: int,
                                n: int, tol: float, max_iter: int) -> SternBlockResult {
    let m = occ_states.len()

    // 상태별 b_s = − P_c (ΔV ψ_s) · r_s = b_s · p_s = r_s · x_s = 0.
    let mut x = []      // [nb*n]
    let mut r = []      // [nb*n]
    let mut p = []      // [nb*n]
    let mut rs_old = [] // [nb]
    let mut bnorm = []  // [nb]
    let mut done = []   // [nb] bool: RHS 가 비었거나 수렴
    let mut t0 = 0
    while t0 < nb * n { x.push(0.0) ; r.push(0.0) ; p.push(0.0) ; t0 = t0 + 1 }

    let mut s = 0
    while s < nb {
        let mut dvp = []
        let mut i = 0
        while i < n { dvp.push(dV_psi_flat[s * n + i]) ; i = i + 1 }
        let pcd = st_project_out(dvp, occ_states, m, n)
        let mut bs = []
        let mut i2 = 0
        while i2 < n { bs.push(-pcd[i2]) ; i2 = i2 + 1 }
        let bn = st_norm(bs, n)
        bnorm.push(bn)
        let isdone = bn < tol
        done.push(isdone)
        // r0=b0, p0=r0, x0=0.
        let mut i3 = 0
        while i3 < n {
            r[s * n + i3] = bs[i3]
            p[s * n + i3] = bs[i3]
            i3 = i3 + 1
        }
        rs_old.push(st_dot(bs, bs, n))
        s = s + 1
    }

    let mut iters = 0
    while iters < max_iter {
        // 모두 done 이면 종료.
        let mut anyactive = false
        let mut sc = 0
        while sc < nb { if done[sc] == false { anyactive = true } sc = sc + 1 }
        if anyactive == false { break }

        // (a) 블록 P_c p_s 와 패킹 P[n,nb] (done 상태는 0 열).
        let mut pcp = []   // [nb*n] : P_c p_s
        let mut pflat = [] // [n*nb] row-major
        let mut t = 0
        while t < n * nb { pflat.push(0.0) ; t = t + 1 }
        let mut sa = 0
        while sa < nb {
            if done[sa] {
                let mut z = 0
                while z < n { pcp.push(0.0) ; z = z + 1 }
            } else {
                let mut ps = []
                let mut i = 0
                while i < n { ps.push(p[sa * n + i]) ; i = i + 1 }
                let pc = st_project_out(ps, occ_states, m, n)
                let mut i2 = 0
                while i2 < n { pcp.push(pc[i2]) ; pflat[i2 * nb + sa] = pc[i2] ; i2 = i2 + 1 }
            }
            sa = sa + 1
        }

        // (b) ONE block H-apply: Y[n,nb] = H·P[n,nb].  폴백 → 상태별 스칼라.
        let yflat = H_block(pflat, nb)
        let mut usescalar = false
        if len(yflat) != n * nb { usescalar = true }

        // (c) 상태별 ap2_s = P_c[(H−ε_s) P_c p_s], α_s, x_s/r_s 갱신.
        let mut sb = 0
        while sb < nb {
            if done[sb] == false {
                let mut pcs = []
                let mut i = 0
                while i < n { pcs.push(pcp[sb * n + i]) ; i = i + 1 }
                // hp = H·(P_c p_s) : 블록 GEMM 열, 폴백 시 스칼라.
                let mut hp = []
                if usescalar {
                    hp = H_apply(pcs)
                } else {
                    let mut i4 = 0
                    while i4 < n { hp.push(yflat[i4 * nb + sb]) ; i4 = i4 + 1 }
                }
                let mut ap = []
                let mut i5 = 0
                while i5 < n { ap.push(hp[i5] - eps[sb] * pcs[i5]) ; i5 = i5 + 1 }
                let ap2 = st_project_out(ap, occ_states, m, n)
                let pAp = st_dot(pcs, ap2, n)
                // 주: 스칼라 solver 는 dot(p, ap2); P_c p_s 대신 p_s 를 쓰지만 ap2 가
                // 이미 P_c-사영돼 있어 dot(p,ap2)=dot(P_c p,ap2). 동일.
                if pAp == 0.0 {
                    done[sb] = true
                } else {
                    let alpha = rs_old[sb] / pAp
                    let mut i6 = 0
                    while i6 < n {
                        x[sb * n + i6] = x[sb * n + i6] + alpha * p[sb * n + i6]
                        r[sb * n + i6] = r[sb * n + i6] - alpha * ap2[i6]
                        i6 = i6 + 1
                    }
                    // 잔차노름 + β + p 갱신.
                    let mut rsq = 0.0
                    let mut i7 = 0
                    while i7 < n { rsq = rsq + r[sb*n+i7]*r[sb*n+i7] ; i7 = i7 + 1 }
                    let rnorm = sqrt(rsq)
                    if rnorm < tol {
                        done[sb] = true
                    } else {
                        let beta = rsq / rs_old[sb]
                        let mut i8 = 0
                        while i8 < n { p[sb*n+i8] = r[sb*n+i8] + beta * p[sb*n+i8] ; i8 = i8 + 1 }
                        rs_old[sb] = rsq
                    }
                }
            }
            sb = sb + 1
        }
        iters = iters + 1
    }

    // 최종: 상태별 P_c 사영 + 실제 잔차 재계산 (스칼라 solver 와 동일 식).
    let mut dpsi_out = []
    let mut tp = 0
    while tp < nb * n { dpsi_out.push(0.0) ; tp = tp + 1 }
    let mut max_res = 0.0
    let mut allconv = true
    let mut sf = 0
    while sf < nb {
        let mut xs = []
        let mut i = 0
        while i < n { xs.push(x[sf * n + i]) ; i = i + 1 }
        let dps = st_project_out(xs, occ_states, m, n)
        let hd = H_apply(dps)
        let mut resv = []
        let mut j = 0
        while j < n { resv.push(hd[j] - eps[sf] * dps[j]) ; j = j + 1 }
        let respc = st_project_out(resv, occ_states, m, n)
        // b_s 재구성 (위에서 안 저장 → dV_psi 로 재계산).
        let mut dvp = []
        let mut k = 0
        while k < n { dvp.push(dV_psi_flat[sf * n + k]) ; k = k + 1 }
        let pcd = st_project_out(dvp, occ_states, m, n)
        let mut diff = []
        let mut q = 0
        while q < n { diff.push(respc[q] - (-pcd[q])) ; q = q + 1 }
        let resn = st_norm(diff, n)
        if resn > max_res { max_res = resn }
        let conv = bnorm[sf] < tol || resn < tol
        if conv == false { allconv = false }
        let mut w = 0
        while w < n { dpsi_out[sf * n + w] = dps[w] ; w = w + 1 }
        sf = sf + 1
    }

    return SternBlockResult { dpsi: dpsi_out, iters: iters,
                              all_converged: allconv, max_residual: max_res }
}
