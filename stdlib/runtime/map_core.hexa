// stdlib/runtime/map_core.hexa — RT-NATIVE-ZEROC M4 map-core READ-half.
//
// The hexa-source raw-mem body for the map element LOOKUP primitive
// (hexa_map_get's in-table hash probe). The array twin
// (stdlib/runtime/array_core.hexa) proved the raw-mem template; map adds an
// open-addressing hash probe (fnv1a + linear probe + strcmp) over the lookup
// key, all in raw memory.
//
// ALL arithmetic / bitwise / comparison uses the raw-int leaf intrinsics, NOT
// the plain hexa `+ * & ^ == != <` operators — those lower to HexaVal runtime
// helpers (hexa_add_slow / hexa_mul / hexa_band / hexa_eq) which misinterpret
// the raw int64 words passed here from C (measured: plain `16 & 0xFFFFFFFF` = 0,
// probe SIGSEGV). The raw-int leaves used:
//   __hx_payload_add/sub/mul (signed i64 arith) · __hx_payload_and/xor (#3499)
//   · __hx_payload_lt/eq/ne (cmp → bool, work in if/while conditions).
//
// NESTING: each __hx_payload_* / __hx_ptr_* call writes EXACTLY ONE `let` — NO
// nested intrinsic args (e.g. NOT `and(mul(h,k), m)`). A native-codegen clobber
// (r10/r11 / x1/x3 scratch reuse) corrupts the outer op when an intrinsic is a
// direct arg to another (measured: nested fnv → SIGSEGV; un-nested → byte-exact
// vs C). Un-nested = one op per temp, exactly like array_core's straight-line
// form. (Codegen nested-intrinsic clobber = a separate finding, not fixed here.)
//
// LAYOUT (mirrors runtime_core_emit.hexa, locked by map_core_gate.c):
//   m payload  = HexaMap*;  HexaMap { HexaMapTable* tbl @0; ... }
//   HexaMapTable { HexaMapSlot* slots @0;  HexaVal* vals @8;  int ht_cap @16; ... }
//   HexaMapSlot { char* key @0;  uint32_t hash @8;  int order_idx @12 }  stride 16
//   vals[] stride = sizeof(HexaVal) = 16:  tag @ +0,  payload @ +8.
//   The lookup `key` arrives as a raw `const char*` (NUL-terminated), passed as
//   an int64 pointer value BOXED as a TAG_INT HexaVal (C wrapper:
//   hexa_int((int64_t)key)) — hexa fns receive every param as a 16-byte HexaVal,
//   so a bare `int` param mis-aligns the call ABI (measured: int param → 0). The
//   __hx_ptr_load8 / __hx_payload_* leaves extract the payload word regardless.

// rt_map_fnv1a_native: FNV-1a over the NUL-terminated key bytes at `keyp`.
// 32-bit arithmetic — mask to 0xFFFFFFFF after each multiply so the result is
// byte-identical to the C `uint32_t` hexa_fnv1a_str.
fn rt_map_fnv1a_native(keyp: HexaVal) -> int {
    let mut h = 2166136261
    let mut i = 0
    let mut b = __hx_ptr_load8(keyp, 0)
    while __hx_payload_ne(b, 0) {
        h = __hx_payload_xor(h, b)
        let prod = __hx_payload_mul(h, 16777619)         // *= 16777619
        h = __hx_payload_and(prod, 4294967295)           // mod 2^32
        i = __hx_payload_add(i, 1)
        b = __hx_ptr_load8(keyp, i)
    }
    return h
}

// rt_map_strcmp0_native: 0 when the two NUL-terminated C strings are equal,
// else 1 (sign-irrelevant — hmap_find only tests == 0). Raw byte walk.
fn rt_map_strcmp0_native(a: HexaVal, b: HexaVal) -> int {
    let mut j = 0
    let mut ca = __hx_ptr_load8(a, 0)
    let mut cb = __hx_ptr_load8(b, 0)
    while __hx_payload_eq(ca, cb) {
        if __hx_payload_eq(ca, 0) { return 0 }           // both ended, equal
        j = __hx_payload_add(j, 1)
        ca = __hx_ptr_load8(a, j)
        cb = __hx_ptr_load8(b, j)
    }
    return 1                                              // mismatch
}

// rt_map_get_native: open-addressing probe identical to hmap_find, returning the
// matched value (re-stamped via __hx_make_val) or a TAG_VOID sentinel
// (__hx_make_val(4, 0); TAG_VOID = 4). The C wrapper keeps the valstruct /
// NULL-table guards + the not-found stderr message + key coercion, and delegates
// only the in-table probe. The probe is bounded by ht_cap steps (the C `while
// slots[idx].key` terminates at an empty slot; load < 75% guarantees one).
pub fn rt_map_get_native(m: HexaVal, keyp: HexaVal) -> HexaVal {
    let map_ptr = __hx_payload_add(m, 0)                 // HexaMap*
    let t = __hx_ptr_load64(map_ptr, 0)                  // HexaMap.tbl @0
    let slots = __hx_ptr_load64(t, 0)                    // HexaMapTable.slots @0
    let vals = __hx_ptr_load64(t, 8)                     // HexaMapTable.vals @8
    let cap_raw = __hx_ptr_load64(t, 16)                 // ht_cap @16 (+ pad)
    let ht_cap = __hx_payload_and(cap_raw, 4294967295)   // low 32b
    let h = rt_map_fnv1a_native(keyp)
    let mask = __hx_payload_sub(ht_cap, 1)
    let mut idx = __hx_payload_and(h, mask)
    let mut steps = 0
    while __hx_payload_lt(steps, ht_cap) {
        let soff = __hx_payload_mul(idx, 16)             // HexaMapSlot @ idx
        let slot = __hx_payload_add(slots, soff)
        let slot_key = __hx_ptr_load64(slot, 0)          // .key @0
        if __hx_payload_eq(slot_key, 0) { return __hx_make_val(4, 0) }  // empty → TAG_VOID
        let hash_raw = __hx_ptr_load64(slot, 8)          // .hash @8 (u32 + order_idx)
        let slot_hash = __hx_payload_and(hash_raw, 4294967295)
        if __hx_payload_eq(slot_hash, h) {
            let cmp = rt_map_strcmp0_native(slot_key, keyp)
            if __hx_payload_eq(cmp, 0) {
                let voff = __hx_payload_mul(idx, 16)     // vals[idx] {tag,payload}
                let poff = __hx_payload_add(voff, 8)
                let tag = __hx_ptr_load64(vals, voff)
                let pay = __hx_ptr_load64(vals, poff)
                return __hx_make_val(tag, pay)
            }
        }
        let nxt = __hx_payload_add(idx, 1)
        idx = __hx_payload_and(nxt, mask)
        steps = __hx_payload_add(steps, 1)
    }
    return __hx_make_val(4, 0)                            // not found (safety net)
}

// rt_map_contains_native: the `in` / hexa_map_contains_key probe — returns a
// TAG_INT HexaVal {0,1} mirroring the C `hmap_find(t,key,h) >= 0` (slot PRESENT,
// independent of the stored value, so a key mapped to void still counts). Same
// open-addressing walk as rt_map_get_native, minus the value extraction. The C
// wrapper extracts HX_INT(...) and keeps the NULL-table guard. All raw-int
// leaves, un-nested (codegen clobber fix #3503 also removes the un-nest need,
// but un-nested stays the clear form).
pub fn rt_map_contains_native(m: HexaVal, keyp: HexaVal) -> HexaVal {
    let map_ptr = __hx_payload_add(m, 0)
    let t = __hx_ptr_load64(map_ptr, 0)
    let slots = __hx_ptr_load64(t, 0)
    let cap_raw = __hx_ptr_load64(t, 16)
    let ht_cap = __hx_payload_and(cap_raw, 4294967295)
    let h = rt_map_fnv1a_native(keyp)
    let mask = __hx_payload_sub(ht_cap, 1)
    let mut idx = __hx_payload_and(h, mask)
    let mut steps = 0
    while __hx_payload_lt(steps, ht_cap) {
        let soff = __hx_payload_mul(idx, 16)
        let slot = __hx_payload_add(slots, soff)
        let slot_key = __hx_ptr_load64(slot, 0)
        if __hx_payload_eq(slot_key, 0) { return __hx_make_val(0, 0) }  // empty → not present
        let hash_raw = __hx_ptr_load64(slot, 8)
        let slot_hash = __hx_payload_and(hash_raw, 4294967295)
        if __hx_payload_eq(slot_hash, h) {
            let cmp = rt_map_strcmp0_native(slot_key, keyp)
            if __hx_payload_eq(cmp, 0) { return __hx_make_val(0, 1) }   // present
        }
        let nxt = __hx_payload_add(idx, 1)
        idx = __hx_payload_and(nxt, mask)
        steps = __hx_payload_add(steps, 1)
    }
    return __hx_make_val(0, 0)                            // not found
}

// rt_map_set_inplace_native: the CONSTRUCT-half write twin (M4 map-construct r1).
// Ports ONLY the alloc-free in-place UPDATE branch of hexa_map_set_impl — the
// `si >= 0` (key-already-present) case: overwrite the stored value in BOTH the
// hash-indexed vals[idx] AND the insertion-order order_vals[order_idx] (the
// ROI-24 O(1) cached-order-index update), exactly like the C
//   t->vals[si] = val;  t->order_vals[t->slots[si].order_idx] = val;
// This is the map analogue of rt_array_set_native (alloc-free raw-mem slot
// write). Returns a TAG_INT {0,1}: 1 = key found + value written in place (C
// caller returns m), 0 = key absent (C caller falls through to the INSERT path —
// hxlcl_strdup + load-factor hmap_grow + order-array realloc + len bump, which
// stays in C as the irreducible allocator/intern floor, exactly as array_push /
// array_new stay in C while only the in-place array set is native).
//
// LAYOUT (in addition to the read-half offsets, locked by map_core_gate.c):
//   HexaMapSlot { key @0; hash @8 (u32); order_idx @12 (int) }  stride 16
//   HexaMapTable { slots @0; vals @8; ht_cap @16(+pad); order_keys @24;
//                  order_vals @32; len @40; order_cap @44; from_arena @48 }
//   vals[]/order_vals[] stride = sizeof(HexaVal) = 16: tag @+0, payload @+8.
// All raw-int leaves, un-nested (the codegen nested-intrinsic clobber note from
// the read-half applies identically — one op per temp).
pub fn rt_map_set_inplace_native(m: HexaVal, keyp: HexaVal, val: HexaVal) -> HexaVal {
    let map_ptr = __hx_payload_add(m, 0)                 // HexaMap*
    let t = __hx_ptr_load64(map_ptr, 0)                  // HexaMap.tbl @0
    let slots = __hx_ptr_load64(t, 0)                    // HexaMapTable.slots @0
    let vals = __hx_ptr_load64(t, 8)                     // HexaMapTable.vals @8
    let order_vals = __hx_ptr_load64(t, 32)              // HexaMapTable.order_vals @32
    let cap_raw = __hx_ptr_load64(t, 16)                 // ht_cap @16 (+ pad)
    let ht_cap = __hx_payload_and(cap_raw, 4294967295)   // low 32b
    let h = rt_map_fnv1a_native(keyp)
    let mask = __hx_payload_sub(ht_cap, 1)
    let mut idx = __hx_payload_and(h, mask)
    let mut steps = 0
    let vtag = __hx_tag(val)
    let vpay = __hx_payload_add(val, 0)
    while __hx_payload_lt(steps, ht_cap) {
        let soff = __hx_payload_mul(idx, 16)             // HexaMapSlot @ idx
        let slot = __hx_payload_add(slots, soff)
        let slot_key = __hx_ptr_load64(slot, 0)          // .key @0
        if __hx_payload_eq(slot_key, 0) { return __hx_make_val(0, 0) }  // empty → absent
        let hash_raw = __hx_ptr_load64(slot, 8)          // .hash @8 (u32 + order_idx packed)
        let slot_hash = __hx_payload_and(hash_raw, 4294967295)
        if __hx_payload_eq(slot_hash, h) {
            let cmp = rt_map_strcmp0_native(slot_key, keyp)
            if __hx_payload_eq(cmp, 0) {
                // vals[idx] = val  (tag @+0, payload @+8)
                let voff = __hx_payload_mul(idx, 16)
                let voff8 = __hx_payload_add(voff, 8)
                __hx_ptr_store64(vals, voff, vtag)
                __hx_ptr_store64(vals, voff8, vpay)
                // order_vals[slot.order_idx] = val  (ROI-24 cached index @ slot+12)
                let oi = __hx_ptr_load32(slot, 12)       // HexaMapSlot.order_idx @+12 (int32)
                let ooff = __hx_payload_mul(oi, 16)
                let ooff8 = __hx_payload_add(ooff, 8)
                __hx_ptr_store64(order_vals, ooff, vtag)
                __hx_ptr_store64(order_vals, ooff8, vpay)
                return __hx_make_val(0, 1)               // found + written in place
            }
        }
        let nxt = __hx_payload_add(idx, 1)
        idx = __hx_payload_and(nxt, mask)
        steps = __hx_payload_add(steps, 1)
    }
    return __hx_make_val(0, 0)                            // absent (insert in C)
}
