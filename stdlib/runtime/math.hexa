// stdlib/runtime/math.hexa — RUNTIME.md step-2 cycle 2.
//
// Hexa-source replacements for `hxlcl_cos`/_sin/_exp/_log/_fmod
// (self/runtime.c cycle 59). Taylor / range-reduction approximations.
// NOT bit-exact with libm. aprime_cc never calls them in compile-
// then-exit (flame/NN code paths linked but unreachable from the
// compiler hot loop).
//
// Cost model: HexaVal wrap is `hexa_float` (8-byte allocation in
// TAG_FLOAT slot) + return unwrap is `HX_FLOAT`. Two ~5ns each
// surrounding a ~100ns Taylor body. Acceptable for any caller.

// Step 3 cycle 7 — square root (Newton-Raphson). Replaces libm sqrt()
// in self/runtime_core.c::hexa_sqrt. Convergence is quadratic; the 40-
// iter cap is conservative for double precision (typical convergence
// at ~6 iterations). Negative input clamps to 0.0 (matches libm sqrt's
// domain-error → NaN replaced with conservative 0 for hexa user code).
pub fn rt_sqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x * 0.5
    if g < 1.0 { g = 1.0 }
    let mut i = 0
    while i < 40 {
        let next = 0.5 * (g + x / g)
        if next == g { return next }
        g = next
        i = i + 1
    }
    return g
}

// Step 3 cycle 8 — tan (sin/cos). Pole near x = π/2 + kπ saturates to a
// large finite value (1e308 ≈ DBL_MAX) instead of libm's HUGE_VAL/inf —
// hexa user code at this entry rarely hits the pole exactly.
pub fn rt_tan(x: float) -> float {
    let c = rt_cos(x)
    if c == 0.0 { return 1e308 }
    return rt_sin(x) / c
}

// Step 3 cycle 8 — log base 2 via natural log / ln(2).
pub fn rt_log2(x: float) -> float {
    let LN2 = 0.6931471805599453
    return rt_log(x) / LN2
}

// Step 3 cycle 9 — log base 10 via natural log / ln(10).
pub fn rt_log10(x: float) -> float {
    let LN10 = 2.302585092994046
    return rt_log(x) / LN10
}

// Step 3 cycle 14 — log gamma via Stirling series with shift.
// Stirling: log Γ(z) ≈ (z-0.5)log(z) - z + 0.5*log(2π) + Σ B_{2k}/(2k(2k-1)z^{2k-1})
// = (z-0.5)log(z) - z + 0.918938533204673 +
//   1/(12z) - 1/(360z^3) + 1/(1260z^5) - 1/(1680z^7) + 1/(1188z^9)
// Series accurate for z >= 7; shift up via Γ(z)=Γ(z+1)/z so we always
// evaluate at z' >= 7. Returns log of the resulting Γ.
// Reflection (Γ(z)Γ(1-z)=π/sin(πz)) handles z<=0; conservative 1e308
// at non-positive integer poles.
pub fn rt_lgamma(z: float) -> float {
    let LOG_SQRT_2PI = 0.9189385332046727
    let PI = 3.141592653589793
    if z <= 0.0 {
        let zi = z as int
        if (zi as float) == z { return 1e308 }
        let sinpz = rt_sin(PI * z)
        if sinpz == 0.0 { return 1e308 }
        let abss = if sinpz < 0.0 { 0.0 - sinpz } else { sinpz }
        return rt_log(PI / abss) - rt_lgamma(1.0 - z)
    }
    let mut x = z
    let mut shift = 0.0
    while x < 7.0 {
        shift = shift + rt_log(x)
        x = x + 1.0
    }
    let inv = 1.0 / x
    let inv2 = inv * inv
    let series = inv * (1.0 / 12.0)
                - inv * inv2 * (1.0 / 360.0)
                + inv * inv2 * inv2 * (1.0 / 1260.0)
                - inv * inv2 * inv2 * inv2 * (1.0 / 1680.0)
                + inv * inv2 * inv2 * inv2 * inv2 * (1.0 / 1188.0)
    return (x - 0.5) * rt_log(x) - x + LOG_SQRT_2PI + series - shift
}

// ── error function (erf / erfc) — reference-match: W.J. Cody, "Rational
//    Chebyshev approximation for the error function" (Math. Comp. 1969),
//    as implemented in SPECFUN CALERF / Cephes erf.c / Boost / fdlibm-class
//    libm. Three rational-Chebyshev regions give full-double accuracy
//    (the surrounding rt_exp/rt_log approximations cap residual at ~1e-12,
//    which is why callers gate with verify --tol). Replaces the
//    unconditional libm erf/erfc in self/runtime.c (VERIFY-KIT V4:
//    native-accurate, NOT collapsing hand-Taylor). zero-c #29.

// |x| <= 0.46875: erf(x) = x · P(x²)/Q(x²) (signed, direct).
fn _rt_erf_small(x: float) -> float {
    let a0 = 3.16112374387056560e0
    let a1 = 1.13864154151050156e2
    let a2 = 3.77485237685302021e2
    let a3 = 3.20937758913846947e3
    let a4 = 1.85777706184603153e-1
    let b0 = 2.36012909523441209e1
    let b1 = 2.44024637934444173e2
    let b2 = 1.28261652607737228e3
    let b3 = 2.84423683343917062e3
    let ysq = x * x
    let mut xnum = a4 * ysq
    let mut xden = ysq
    xnum = (xnum + a0) * ysq
    xden = (xden + b0) * ysq
    xnum = (xnum + a1) * ysq
    xden = (xden + b1) * ysq
    xnum = (xnum + a2) * ysq
    xden = (xden + b2) * ysq
    return x * (xnum + a3) / (xden + b3)
}

// erfc(y) for y > 0.46875 (accurate tail path). Regions 2 (y<=4) and 3 (y>4).
fn _rt_erfc_pos(y: float) -> float {
    if y > 26.5 { return 0.0 }  // exp(-y²) underflows to 0
    let mut result = 0.0
    if y <= 4.0 {
        // 0.46875 < y <= 4: erfc(y) = exp(-y²) · P(y)/Q(y)
        let c0 = 5.64188496988670089e-1
        let c1 = 8.88314979438837594e0
        let c2 = 6.61191906371416295e1
        let c3 = 2.98635138197400131e2
        let c4 = 8.81952221241769090e2
        let c5 = 1.71204761263407058e3
        let c6 = 2.05107837782607147e3
        let c7 = 1.23033935479799725e3
        let c8 = 2.15311535474403846e-8
        let d0 = 1.57449261107098347e1
        let d1 = 1.17693950891312499e2
        let d2 = 5.37181101862009858e2
        let d3 = 1.62138957456669019e3
        let d4 = 3.29079923573345963e3
        let d5 = 4.36261909014324716e3
        let d6 = 3.43936767414372164e3
        let d7 = 1.23033935480374942e3
        let mut xnum = c8 * y
        let mut xden = y
        xnum = (xnum + c0) * y
        xden = (xden + d0) * y
        xnum = (xnum + c1) * y
        xden = (xden + d1) * y
        xnum = (xnum + c2) * y
        xden = (xden + d2) * y
        xnum = (xnum + c3) * y
        xden = (xden + d3) * y
        xnum = (xnum + c4) * y
        xden = (xden + d4) * y
        xnum = (xnum + c5) * y
        xden = (xden + d5) * y
        xnum = (xnum + c6) * y
        xden = (xden + d6) * y
        result = (xnum + c7) / (xden + d7)
    } else {
        // y > 4: erfc(y) = exp(-y²)/y · (1/√π - P(1/y²)/Q(1/y²)/y²)
        let p0 = 3.05326634961232344e-1
        let p1 = 3.60344899949804439e-1
        let p2 = 1.25781726111229246e-1
        let p3 = 1.60837851487422766e-2
        let p4 = 6.58749161529837803e-4
        let p5 = 1.63153871373020978e-2
        let q0 = 2.56852019228982242e0
        let q1 = 1.87295284992346047e0
        let q2 = 5.27905102951428412e-1
        let q3 = 6.05183413124413191e-2
        let q4 = 2.33520497626869185e-3
        let SQRPI = 5.64189583547756287e-1
        let zsq = 1.0 / (y * y)
        let mut xnum = p5 * zsq
        let mut xden = zsq
        xnum = (xnum + p0) * zsq
        xden = (xden + q0) * zsq
        xnum = (xnum + p1) * zsq
        xden = (xden + q1) * zsq
        xnum = (xnum + p2) * zsq
        xden = (xden + q2) * zsq
        xnum = (xnum + p3) * zsq
        xden = (xden + q3) * zsq
        result = zsq * (xnum + p4) / (xden + q4)
        result = (SQRPI - result) / y
    }
    // Cody exp-cancellation guard: split y² into a 16ths-truncated part
    // (exact) + remainder so exp(-ysq²) stays well-conditioned.
    let ti = (y * 16.0) as int
    let ysq = (ti as float) / 16.0
    let del = (y - ysq) * (y + ysq)
    return rt_exp(0.0 - ysq * ysq) * rt_exp(0.0 - del) * result
}

// erf(x) — odd; small region direct, else 1 - erfc(|x|).
pub fn rt_erf(x: float) -> float {
    let ax = if x < 0.0 { 0.0 - x } else { x }
    if ax <= 0.46875 { return _rt_erf_small(x) }
    let r = 1.0 - _rt_erfc_pos(ax)
    return if x < 0.0 { 0.0 - r } else { r }
}

// erfc(x) = 1 - erf(x); positive tail uses the direct accurate path,
// negative side via erfc(x) = 2 - erfc(-x) (erfc(neg) ∈ (1,2], no tail loss).
pub fn rt_erfc(x: float) -> float {
    if x < 0.0 { return 2.0 - rt_erfc(0.0 - x) }
    if x <= 0.46875 { return 1.0 - _rt_erf_small(x) }
    return _rt_erfc_pos(x)
}

// Γ(x) — gamma via exp(lgamma) for x>0, reflection Γ(x)=π/(sin(πx)·Γ(1-x))
//   for x<0. Poles at non-positive integers saturate to 1e308 (matches
//   rt_lgamma's pole convention). Reuses rt_lgamma (Stirling+reflection).
pub fn rt_tgamma(x: float) -> float {
    if x > 0.0 { return rt_exp(rt_lgamma(x)) }
    let xi = x as int
    if (xi as float) == x { return 1e308 }  // pole at 0, -1, -2, …
    let PI = 3.141592653589793
    let sinpx = rt_sin(PI * x)
    if sinpx == 0.0 { return 1e308 }
    let g1mx = rt_exp(rt_lgamma(1.0 - x))   // Γ(1-x) > 0 (1-x > 1)
    return PI / (sinpx * g1mx)
}

// ── Bessel J0 / J1 — reference-match: fdlibm e_j0.c / e_j1.c (Sun Micro,
//    netlib.org/fdlibm; the musl/fdlibm-class libm reference). zero-c #29:
//    drop libm j0/j1 externs. fdlibm's high-word `ix` range selection is
//    replaced by EQUIVALENT value thresholds (0x40200000=8.0 · 0x40122E8B≈
//    4.5454 · 0x4006DB6D≈2.8571 · 0x40000000=2.0), so no float→bits
//    reinterpret is needed. invsqrtpi = 1/√π. Residual ~1e-12 from native
//    rt_sin/rt_cos/rt_sqrt (verify --tol posture). ──

// numerator Horner p0 + z(p1 + z(p2 + z(p3 + z(p4 + z·p5)))).
fn _bz_num6(z: float, p0: float, p1: float, p2: float, p3: float, p4: float, p5: float) -> float {
    return p0 + z * (p1 + z * (p2 + z * (p3 + z * (p4 + z * p5))))
}
// denominator 1 + z(q0 + … + z·q4)  (5 terms · pzero/pone).
fn _bz_den5(z: float, q0: float, q1: float, q2: float, q3: float, q4: float) -> float {
    return 1.0 + z * (q0 + z * (q1 + z * (q2 + z * (q3 + z * q4))))
}
// denominator 1 + z(q0 + … + z·q5)  (6 terms · qzero/qone).
fn _bz_den6(z: float, q0: float, q1: float, q2: float, q3: float, q4: float, q5: float) -> float {
    return 1.0 + z * (q0 + z * (q1 + z * (q2 + z * (q3 + z * (q4 + z * q5)))))
}

// pzero(x) — j0 asymptotic numerator factor, |x|>=2. return 1 + r/s.
fn _rt_pzero(x: float) -> float {
    let z = 1.0 / (x * x)
    let mut r = 0.0
    let mut s = 1.0
    if x >= 8.0 {
        r = _bz_num6(z, 0.0, -7.03124999999900357484e-02, -8.08167041275349795626e+00, -2.57063105679704847262e+02, -2.48521641009428822144e+03, -5.25304380490729545272e+03)
        s = _bz_den5(z, 1.16534364619668181717e+02, 3.83374475364121826715e+03, 4.05978572648472545552e+04, 1.16752972564375915681e+05, 4.76277284146730962675e+04)
    } else if x >= 4.5454 {
        r = _bz_num6(z, -1.14125464691894502584e-11, -7.03124940873599280078e-02, -4.15961064470587782438e+00, -6.76747652265167261021e+01, -3.31231299649172967747e+02, -3.46433388365604912451e+02)
        s = _bz_den5(z, 6.07539382692300335975e+01, 1.05125230595704579173e+03, 5.97897094333855784498e+03, 9.62544514357774460223e+03, 2.40605815922939109441e+03)
    } else if x >= 2.8571 {
        r = _bz_num6(z, -2.54704601771951915620e-09, -7.03119616381481654654e-02, -2.40903221549529611423e+00, -2.19659774734883086467e+01, -5.80791704701737572236e+01, -3.14479470594888503854e+01)
        s = _bz_den5(z, 3.58560338055209726349e+01, 3.61513983050303863820e+02, 1.19360783792111533330e+03, 1.12799679856907414432e+03, 1.73580930813335754692e+02)
    } else {
        r = _bz_num6(z, -8.87534333032526411254e-08, -7.03030995483624743247e-02, -1.45073846780952986357e+00, -7.63569613823527770791e+00, -1.11931668860356747786e+01, -3.23364579351335335033e+00)
        s = _bz_den5(z, 2.22202997532088808441e+01, 1.36206794218215208048e+02, 2.70470278658083486789e+02, 1.53875394208320329881e+02, 1.46576176948256193810e+01)
    }
    return 1.0 + r / s
}

// qzero(x) — j0 asymptotic, |x|>=2. return (-0.125 + r/s)/x.
fn _rt_qzero(x: float) -> float {
    let z = 1.0 / (x * x)
    let mut r = 0.0
    let mut s = 1.0
    if x >= 8.0 {
        r = _bz_num6(z, 0.0, 7.32421874999935051953e-02, 1.17682064682252693899e+01, 5.57673380256401856059e+02, 8.85919720756468632317e+03, 3.70146267776887834771e+04)
        s = _bz_den6(z, 1.63776026895689824414e+02, 8.09834494656449805916e+03, 1.42538291419120476348e+05, 8.03309257119514397345e+05, 8.40501579819060512818e+05, -3.43899293537866615225e+05)
    } else if x >= 4.5454 {
        r = _bz_num6(z, 1.84085963594515531381e-11, 7.32421766612684765896e-02, 5.83563508962056953777e+00, 1.35111577286449829671e+02, 1.02724376596164097464e+03, 1.98997785864605384631e+03)
        s = _bz_den6(z, 8.27766102236537761883e+01, 2.07781416421392987104e+03, 1.88472887785718085070e+04, 5.67511122894947329769e+04, 3.59767538425114471465e+04, -5.35434275601944773371e+03)
    } else if x >= 2.8571 {
        r = _bz_num6(z, 4.37741014089738620906e-09, 7.32411180042911447163e-02, 3.34423137516170720929e+00, 4.26218440745412650017e+01, 1.70808091340565596283e+02, 1.66733948696651168575e+02)
        s = _bz_den6(z, 4.87588729724587182091e+01, 7.09689221056606015736e+02, 3.70414822620111362994e+03, 6.46042516752568917582e+03, 2.51633368920368957333e+03, -1.49247451836156386662e+02)
    } else {
        r = _bz_num6(z, 1.50444444886983272379e-07, 7.32234265963079278272e-02, 1.99819174093815998816e+00, 1.44956029347885735348e+01, 3.16662317504781540833e+01, 1.62527075710929267416e+01)
        s = _bz_den6(z, 3.03655848355219184498e+01, 2.69348118608049844624e+02, 8.44783757595320139444e+02, 8.82935845112488550512e+02, 2.12666388511798828631e+02, -5.31095493882666946917e+00)
    }
    return (-0.125 + r / s) / x
}

// j0(x) — Bessel function of the first kind, order 0.
pub fn rt_j0(x: float) -> float {
    let ax = if x < 0.0 { 0.0 - x } else { x }
    if ax < 2.0 {
        let z = ax * ax
        let r = z * (1.56249999999999947958e-02 + z * (-1.89979294238854721751e-04 + z * (1.82954049532700665670e-06 + z * -4.61832688532103189199e-09)))
        let s = 1.0 + z * (1.56191029464890010492e-02 + z * (1.16926784663337450260e-04 + z * (5.13546550207318111446e-07 + z * 1.16614003333790000205e-09)))
        if ax < 1.0 { return 1.0 + z * (-0.25 + r / s) }
        let u = 0.5 * ax
        return (1.0 + u) * (1.0 - u) + z * (r / s)
    }
    // |x| >= 2: asymptotic.
    let INVSQRTPI = 5.64189583547756279280e-01
    let sn = rt_sin(ax)
    let cn = rt_cos(ax)
    let mut ss = sn - cn
    let mut cc = sn + cn
    // cancellation-avoiding refinement: z = -cos(2x).
    let zc = 0.0 - rt_cos(ax + ax)
    if sn * cn < 0.0 { cc = zc / ss } else { ss = zc / cc }
    let u = _rt_pzero(ax)
    let v = _rt_qzero(ax)
    return INVSQRTPI * (u * cc - v * ss) / rt_sqrt(ax)
}

// pone(x) — j1 asymptotic, |x|>=2. return 1 + r/s.
fn _rt_pone(x: float) -> float {
    let z = 1.0 / (x * x)
    let mut r = 0.0
    let mut s = 1.0
    if x >= 8.0 {
        r = _bz_num6(z, 0.0, 1.17187499999988647970e-01, 1.32394806593073575129e+01, 4.12051854307378562225e+02, 3.87474538913960532227e+03, 7.91447954031891731574e+03)
        s = _bz_den5(z, 1.14207370375678408436e+02, 3.65093083420853463394e+03, 3.69562060269033463555e+04, 9.76027935934950801311e+04, 3.08042720627888811578e+04)
    } else if x >= 4.5454 {
        r = _bz_num6(z, 1.31990519556243522749e-11, 1.17187493190614097638e-01, 6.80275127868432871736e+00, 1.08308182990189109773e+02, 5.17636139533199752805e+02, 5.28715201363337541807e+02)
        s = _bz_den5(z, 5.92805987221131331921e+01, 9.91401418733614377743e+02, 5.35326695291487976647e+03, 7.84469031749551231769e+03, 1.50404688810361062679e+03)
    } else if x >= 2.8571 {
        r = _bz_num6(z, 3.02503916137373618024e-09, 1.17186865567253592491e-01, 3.93297750033315640650e+00, 3.51194035591636932736e+01, 9.10550110750781271918e+01, 4.85590685197364919645e+01)
        s = _bz_den5(z, 3.47913095001251519989e+01, 3.36762458747825746741e+02, 1.04687139975775130551e+03, 8.90811346398256432622e+02, 1.03787932439639277504e+02)
    } else {
        r = _bz_num6(z, 1.07710830106873743082e-07, 1.17176219462683348094e-01, 2.36851496667608785174e+00, 1.22426109148261232917e+01, 1.76939711271687727390e+01, 5.07352312588818499250e+00)
        s = _bz_den5(z, 2.14364859363821409488e+01, 1.25290227168402751090e+02, 2.32276469057162813669e+02, 1.17679373287147100768e+02, 8.36463893371618283368e+00)
    }
    return 1.0 + r / s
}

// qone(x) — j1 asymptotic, |x|>=2. return (0.375 + r/s)/x.
fn _rt_qone(x: float) -> float {
    let z = 1.0 / (x * x)
    let mut r = 0.0
    let mut s = 1.0
    if x >= 8.0 {
        r = _bz_num6(z, 0.0, -1.02539062499992714161e-01, -1.62717534544589987888e+01, -7.59601722513950107896e+02, -1.18498066702429587167e+04, -4.84385124285750353010e+04)
        s = _bz_den6(z, 1.61395369700722909556e+02, 7.82538599923348465381e+03, 1.33875336287249578163e+05, 7.19657723683240939863e+05, 6.66601232617776375264e+05, -2.94490264303834643215e+05)
    } else if x >= 4.5454 {
        r = _bz_num6(z, -2.08979931141764104297e-11, -1.02539050241375426231e-01, -8.05644828123936029840e+00, -1.83669607474888380239e+02, -1.37319376065508163265e+03, -2.61244440453215656817e+03)
        s = _bz_den6(z, 8.12765501384335777857e+01, 1.99179873460485964642e+03, 1.74684851924908907677e+04, 4.98514270910352279316e+04, 2.79480751638918118260e+04, -4.71918354795128470869e+03)
    } else if x >= 2.8571 {
        r = _bz_num6(z, -5.07831226461766561369e-09, -1.02537829820837089745e-01, -4.61011581139473403113e+00, -5.78472216562783643212e+01, -2.28244540737631695038e+02, -2.19210128478909325622e+02)
        s = _bz_den6(z, 4.76651550323729509273e+01, 6.73865112676699709482e+02, 3.38015286679526343505e+03, 5.54772909720722782367e+03, 1.90311919338810798763e+03, -1.35201191444307340817e+02)
    } else {
        r = _bz_num6(z, -1.78381727510958865572e-07, -1.02517042607985553460e-01, -2.75220568278187460720e+00, -1.96636162643703720221e+01, -4.23253133372830490089e+01, -2.13719211703704061733e+01)
        s = _bz_den6(z, 2.95333629060523854548e+01, 2.52981549982190529136e+02, 7.57502834868645436472e+02, 7.39393205320467245656e+02, 1.55949003336666123687e+02, -4.95949898822628210127e+00)
    }
    return (0.375 + r / s) / x
}

// j1(x) — Bessel function of the first kind, order 1 (odd function).
pub fn rt_j1(x: float) -> float {
    let ax = if x < 0.0 { 0.0 - x } else { x }
    if ax < 2.0 {
        let z = ax * ax
        let mut r = z * (-6.25e-02 + z * (1.40705666955189706048e-03 + z * (-1.59955631084035597520e-05 + z * 4.96727999609584448412e-08)))
        let s = 1.0 + z * (1.91537599538363460805e-02 + z * (1.85946785588630915560e-04 + z * (1.17718464042623683263e-06 + z * (5.04636257076217042715e-09 + z * 1.23542274426137913908e-11))))
        r = r * ax
        let res = ax * 0.5 + r / s
        return if x < 0.0 { 0.0 - res } else { res }
    }
    // |x| >= 2: asymptotic.
    let INVSQRTPI = 5.64189583547756279280e-01
    let sn = rt_sin(ax)
    let cn = rt_cos(ax)
    let mut ss = (0.0 - sn) - cn
    let mut cc = sn - cn
    // cancellation-avoiding refinement: z = cos(2x) (positive, unlike j0).
    let zc = rt_cos(ax + ax)
    if sn * cn > 0.0 { cc = zc / ss } else { ss = zc / cc }
    let u = _rt_pone(ax)
    let v = _rt_qone(ax)
    let z = INVSQRTPI * (u * cc - v * ss) / rt_sqrt(ax)
    return if x < 0.0 { 0.0 - z } else { z }
}

// Step 3 cycle 19 — naive matmul (row-major, cblas-style M/K/N order).
//   C[i*N + j] = Σ_p A[i*K + p] * B[p*N + j]
// Bounds-guarded inner accumulator (skips out-of-range index instead of
// faulting) matches the C body's defensive contract.
pub fn rt_matmul(a: [float], b: [float], m: int, k: int, n: int) -> [float] {
    let mut out: [float] = []
    if m < 0 { return out }
    if k < 0 { return out }
    if n < 0 { return out }
    let alen = len(a)
    let blen = len(b)
    let mut i = 0
    while i < m {
        let mut j = 0
        while j < n {
            let mut s = 0.0
            let mut p = 0
            while p < k {
                let ai = i * k + p
                let bi = p * n + j
                if ai < alen {
                    if bi < blen {
                        s = s + a[ai] * b[bi]
                    }
                }
                p = p + 1
            }
            out = out.push(s)
            j = j + 1
        }
        i = i + 1
    }
    return out
}

// Step 3 cycle 18 — naive matrix-vector multiply (row-major).
//   out[r] = Σ_c w[r*cols + c] * x[c]   for r ∈ [0, rows)
// Hot path; C wrapper retains the rows/cols int extraction.
pub fn rt_matvec(w: [float], x: [float], rows: int, cols: int) -> [float] {
    let mut out: [float] = []
    if rows <= 0 { return out }
    if cols <= 0 { return out }
    let mut r = 0
    while r < rows {
        let mut acc = 0.0
        let mut c = 0
        let base = r * cols
        while c < cols {
            acc = acc + w[base + c] * x[c]
            c = c + 1
        }
        out = out.push(acc)
        r = r + 1
    }
    return out
}

// Step 3 cycle 17 — SiLU (Swish-1) activation: x / (1 + exp(-x))
pub fn rt_silu(a: [float]) -> [float] {
    let mut out: [float] = []
    let n = len(a)
    let mut i = 0
    while i < n {
        let x = a[i]
        out = out.push(x / (1.0 + rt_exp(0.0 - x)))
        i = i + 1
    }
    return out
}

// Step 3 cycle 17 — GELU (tanh approximation):
//   0.5 * x * (1 + tanh(sqrt(2/π) * (x + 0.044715 * x³)))
pub fn rt_gelu(a: [float]) -> [float] {
    let mut out: [float] = []
    let n = len(a)
    let K = 0.7978845608028654   // sqrt(2/π)
    let mut i = 0
    while i < n {
        let x = a[i]
        let inner = K * (x + 0.044715 * x * x * x)
        out = out.push(0.5 * x * (1.0 + rt_tanh(inner)))
        i = i + 1
    }
    return out
}

// Step 3 cycle 17 — argmax (returns int index, -1 for empty/non-array).
// Ties → lowest index.
pub fn rt_argmax(a: [float]) -> int {
    let n = len(a)
    if n == 0 { return -1 }
    let mut best_i = 0
    let mut best_v = a[0]
    let mut i = 1
    while i < n {
        if a[i] > best_v {
            best_v = a[i]
            best_i = i
        }
        i = i + 1
    }
    return best_i
}

// Step 3 cycle 16 — RMS normalization. Two-arity polymorphism (scalar vs
// array gamma) split into separate hexa fns; C wrapper dispatches.
//   out[i] = gamma[i?] * x[i] / sqrt(mean(x²) + eps)
// Mean-square + reciprocal sqrt reuse rt_sqrt from this file.
fn _rms_norm_inv(x: [float], eps: float) -> float {
    let n = len(x)
    if n == 0 { return 0.0 }
    let mut ss = 0.0
    let mut i = 0
    while i < n {
        ss = ss + x[i] * x[i]
        i = i + 1
    }
    let mean = ss / (n as float)
    let s = rt_sqrt(mean + eps)
    if s == 0.0 { return 0.0 }
    return 1.0 / s
}

pub fn rt_rms_norm_scalar(x: [float], gamma: float, eps: float) -> [float] {
    let mut out: [float] = []
    let n = len(x)
    if n == 0 { return out }
    let inv = _rms_norm_inv(x, eps)
    let mut j = 0
    while j < n {
        out = out.push(gamma * x[j] * inv)
        j = j + 1
    }
    return out
}

pub fn rt_rms_norm_array(x: [float], gamma: [float], eps: float) -> [float] {
    let mut out: [float] = []
    let n = len(x)
    if n == 0 { return out }
    let gn = len(gamma)
    let inv = _rms_norm_inv(x, eps)
    let mut j = 0
    while j < n {
        let gi = if j < gn { j } else { 0 }
        out = out.push(gamma[gi] * x[j] * inv)
        j = j + 1
    }
    return out
}

// Step 3 cycle 15 — stable softmax. Subtract max for numerical stability,
// then exp + normalize. Composition: rt_exp from this file. Empty input
// returns empty; degenerate sum=0 (all -inf or empty after exp underflow)
// returns all-zero vector matching the C implementation's `inv = 0`.
pub fn rt_softmax(a: [float]) -> [float] {
    let mut out: [float] = []
    let n = len(a)
    if n == 0 { return out }
    let mut m = a[0]
    let mut i = 1
    while i < n {
        if a[i] > m { m = a[i] }
        i = i + 1
    }
    let mut sum = 0.0
    let mut tmp: [float] = []
    let mut j = 0
    while j < n {
        let e = rt_exp(a[j] - m)
        tmp = tmp.push(e)
        sum = sum + e
        j = j + 1
    }
    let inv = if sum > 0.0 { 1.0 / sum } else { 0.0 }
    let mut k = 0
    while k < n {
        out = out.push(tmp[k] * inv)
        k = k + 1
    }
    return out
}

// Step 3 cycle 11 — float power. Composes rt_exp + rt_log to remove the
// last libm pow() dependency in self/runtime{,_core}.c.
//   pow(b, e) = exp(e * log(b))  when b > 0
// Edge cases:
//   - b == 0.0       : 0^e = 0 for e>0, 1 for e==0, +inf for e<0 (saturate
//                      to 1e308 — hexa has no native +inf)
//   - b < 0.0        : NaN per IEEE for non-integer e; we conservatively
//                      flip sign on |b|^e when e is exact integer, else NaN
//                      via the (x != x) idiom (0.0/0.0). Hexa user code at
//                      this entry point doesn't traffic in negative-base
//                      fractional powers.
pub fn rt_pow_float(b: float, e: float) -> float {
    if b > 0.0 { return rt_exp(e * rt_log(b)) }
    if b == 0.0 {
        if e == 0.0 { return 1.0 }
        if e > 0.0  { return 0.0 }
        return 1e308
    }
    // b < 0 — only well-defined for integer e
    let ei = e as int
    if (ei as float) == e {
        let p = rt_exp(e * rt_log(0.0 - b))
        if (ei & 1) != 0 { return 0.0 - p }
        return p
    }
    // Negative base + fractional exponent: undefined in real math.
    // Conservative fallback: return 0.0 (hexa user-code at this entry
    // point doesn't traffic in negative-base fractional powers; explicit
    // 0.0 avoids the divide-by-zero risk of (0.0/0.0)).
    return 0.0
}

// Step 3 cycle 9 — hyperbolic tangent via exp.
//   tanh(x) = (e^(2x) - 1) / (e^(2x) + 1)
// Saturates explicitly for |x| > ~22 (e^44 overflows double easily).
pub fn rt_tanh(x: float) -> float {
    if x > 22.0  { return 1.0 }
    if x < -22.0 { return -1.0 }
    let e2 = rt_exp(2.0 * x)
    return (e2 - 1.0) / (e2 + 1.0)
}

pub fn rt_fmod(x: float, y: float) -> float {
    if y == 0.0 { return 0.0 }
    let q = x / y
    let iq = q as int  // truncation
    return x - (iq as float) * y
}

pub fn rt_exp(x: float) -> float {
    // Range reduction: x = n*ln2 + r, |r| <= ln2/2. exp(x) = 2^n * exp(r)
    let LN2 = 0.6931471805599453
    let n_d = x / LN2
    let mut n_i: int = 0
    if n_d >= 0.0 {
        n_i = (n_d + 0.5) as int
    } else {
        n_i = (n_d - 0.5) as int
    }
    let r = x - (n_i as float) * LN2
    // Taylor: 1 + r + r²/2 + r³/6 + ... up to r^7/5040
    let r2 = r * r
    let r3 = r2 * r
    let r4 = r2 * r2
    let sum = 1.0 + r + r2 * 0.5 + r3 * (1.0 / 6.0) + r4 * (1.0 / 24.0)
            + r4 * r * (1.0 / 120.0) + r4 * r2 * (1.0 / 720.0)
            + r4 * r3 * (1.0 / 5040.0)
    // 2^n via repeated double (cap for safety)
    let mut nc = n_i
    if nc > 1023 { nc = 1023 }
    if nc < -1022 { nc = -1022 }
    let mut pow2 = 1.0
    if nc >= 0 {
        let mut i = 0
        while i < nc {
            pow2 = pow2 * 2.0
            i = i + 1
        }
    } else {
        let mut i = 0
        let limit = -nc
        while i < limit {
            pow2 = pow2 * 0.5
            i = i + 1
        }
    }
    return sum * pow2
}

pub fn rt_log(x: float) -> float {
    if x <= 0.0 { return -1e308 }  // -inf approximation
    // log(x) = log(m * 2^e) = log(m) + e*ln2 where m in [1, 2)
    let mut m = x
    let mut e: int = 0
    while m >= 2.0 {
        m = m * 0.5
        e = e + 1
    }
    while m < 1.0 {
        m = m * 2.0
        e = e - 1
    }
    // log((1+u)/(1-u)) with u = (m-1)/(m+1). Series 2(u + u^3/3 + u^5/5 + ...).
    let u = (m - 1.0) / (m + 1.0)
    let u2 = u * u
    let u3 = u2 * u
    let u5 = u3 * u2
    let u7 = u5 * u2
    let sum = 2.0 * (u + u3 / 3.0 + u5 / 5.0 + u7 / 7.0 + u7 * u2 / 9.0)
    return sum + (e as float) * 0.6931471805599453
}

// zero-c #29: accurate cos/sin — reference-match musl src/math/__cos.c /__sin.c
// minimax kernels + Cody-Waite 2-word pi/2 range reduction. Replaces the crude
// 8-term Taylor + naive `while a-=2pi` reduction (which lost precision at large
// angles → RoPE quality regression). ~1e-15 for |x| up to ~2^28 (RoPE angle
// th = pos*inv_freq <= ~8192), byteeq-safe (double IEEE), drops libc cos/sin.
fn _kcos(r: float) -> float {
    let C1 = 4.16666666666666019037e-02
    let C2 = -1.38888888888741095749e-03
    let C3 = 2.48015872894767294178e-05
    let C4 = -2.75573143513906633035e-07
    let C5 = 2.08757232129817482790e-09
    let C6 = -1.13596475577881948265e-11
    let z = r * r
    let w = z * z
    let cr = z * (C1 + z * (C2 + z * C3)) + w * w * (C4 + z * (C5 + z * C6))
    let hz = 0.5 * z
    let ww = 1.0 - hz
    return ww + ((1.0 - ww) - hz) + z * cr
}
fn _ksin(r: float) -> float {
    let S1 = -1.66666666666666324348e-01
    let S2 = 8.33333333332248946124e-03
    let S3 = -1.98412698298579493134e-04
    let S4 = 2.75573137070700676789e-06
    let S5 = -2.50507602534068634195e-08
    let S6 = 1.58969099521155010221e-10
    let z = r * r
    let w = z * z
    let sr = S2 + z * (S3 + z * S4) + z * w * (S5 + z * S6)
    let v = z * r
    return r + v * (S1 + z * sr)
}
pub fn rt_cos(x: float) -> float {
    let invpio2 = 6.36619772367581382433e-01
    let PIO2_1  = 1.57079632673412561417e+00
    let PIO2_1t = 6.07710050650619224932e-11
    let mut ax = x
    if ax < 0.0 { ax = 0.0 - ax }             // cos is even
    let n = (ax * invpio2 + 0.5) as int       // round to nearest quadrant (ax>=0)
    let nf = n as float
    let r = (ax - nf * PIO2_1) - nf * PIO2_1t  // Cody-Waite reduce to [-pi/4, pi/4]
    let q = n & 3
    if q == 0 { return _kcos(r) }
    if q == 1 { return 0.0 - _ksin(r) }
    if q == 2 { return 0.0 - _kcos(r) }
    return _ksin(r)
}

pub fn rt_sin(x: float) -> float {
    let invpio2 = 6.36619772367581382433e-01
    let PIO2_1  = 1.57079632673412561417e+00
    let PIO2_1t = 6.07710050650619224932e-11
    let neg = x < 0.0
    let mut ax = x
    if neg { ax = 0.0 - ax }                   // sin is odd
    let n = (ax * invpio2 + 0.5) as int
    let nf = n as float
    let r = (ax - nf * PIO2_1) - nf * PIO2_1t
    let q = n & 3
    let mut res = 0.0 - _kcos(r)               // q == 3
    if q == 0 { res = _ksin(r) }
    if q == 1 { res = _kcos(r) }
    if q == 2 { res = 0.0 - _ksin(r) }
    if neg { res = 0.0 - res }
    return res
}

// Step 3 cycle 40 — inverse trig (atan + asin + acos).
//
// rt_atan uses two-stage range reduction:
//   (1) |x| > 1 → atan(x) = sign(x)*pi/2 - atan(1/x), so |1/x| <= 1
//   (2) |x| > tan(pi/8) ≈ 0.4142 → atan(a) = pi/4 + atan((a-1)/(a+1)),
//       so the inner |y| <= tan(pi/8) for fast Maclaurin convergence
// Then 6-term Maclaurin: atan(a) ≈ a - a³/3 + a⁵/5 - a⁷/7 + a⁹/9 - a¹¹/11
// gives ~1e-9 precision on the reduced domain.
pub fn rt_atan(x: float) -> float {
    let PI_HALF = 1.5707963267948966
    let PI_QUARTER = 0.7853981633974483
    let TAN_PI8 = 0.4142135623730951
    let mut sign = 1.0
    let mut a = x
    if a < 0.0 { a = -a; sign = -1.0 }
    let mut reduced_inv = false
    if a > 1.0 {
        a = 1.0 / a
        reduced_inv = true
    }
    let mut reduced_quarter = false
    if a > TAN_PI8 {
        a = (a - 1.0) / (a + 1.0)
        reduced_quarter = true
    }
    let a2 = a * a
    let a3 = a2 * a
    let a5 = a3 * a2
    let a7 = a5 * a2
    let a9 = a7 * a2
    let a11 = a9 * a2
    let mut result = a - a3 / 3.0 + a5 / 5.0 - a7 / 7.0 + a9 / 9.0 - a11 / 11.0
    if reduced_quarter { result = PI_QUARTER + result }
    if reduced_inv { result = PI_HALF - result }
    return sign * result
}

// rt_asin via the standard identity asin(x) = atan(x / sqrt(1 - x²)).
// Clamps |x| > 1 to +/-pi/2 (NaN-free fallback). Precision degrades near
// |x| = 1 because sqrt(1-x²) → 0 amplifies floor-noise; that is the
// expected trade-off for a naive port and matches libm's behaviour at
// the cycle-2/4 precision budget.
pub fn rt_asin(x: float) -> float {
    let PI_HALF = 1.5707963267948966
    if x >= 1.0 { return PI_HALF }
    if x <= -1.0 { return -PI_HALF }
    let s = rt_sqrt(1.0 - x * x)
    if s == 0.0 {
        if x > 0.0 { return PI_HALF }
        return -PI_HALF
    }
    return rt_atan(x / s)
}

// rt_acos via the standard identity acos(x) = pi/2 - asin(x).
pub fn rt_acos(x: float) -> float {
    let PI_HALF = 1.5707963267948966
    return PI_HALF - rt_asin(x)
}

// Step 3 cycle 41 — atan2 with quadrant resolution. Returns the angle
// of (x, y) in radians ∈ (-π, π].
//   x > 0           → atan(y/x)
//   x < 0, y ≥ 0    → atan(y/x) + π
//   x < 0, y < 0    → atan(y/x) − π
//   x = 0, y > 0    → π/2
//   x = 0, y < 0    → −π/2
//   x = 0, y = 0    → 0  (libm returns 0; some impls return NaN)
pub fn rt_atan2(y: float, x: float) -> float {
    let PI = 3.141592653589793
    let PI_HALF = 1.5707963267948966
    if x > 0.0 {
        return rt_atan(y / x)
    }
    if x < 0.0 {
        if y >= 0.0 { return rt_atan(y / x) + PI }
        return rt_atan(y / x) - PI
    }
    // x == 0
    if y > 0.0 { return PI_HALF }
    if y < 0.0 { return -PI_HALF }
    return 0.0
}
