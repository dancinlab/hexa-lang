// stdlib/runtime/array_new_leaf.hexa — axis-② unit #6: the empty-array constructor hexa_array_new().
//
// The own-native body for hexa_array_new() that runtime_core.c externs away under the
// HEXA_RT_CORE_ARRAY_NEW_NATIVE sub-guard. Zero-arg → trivially pair-clean (HexaVal return rides the
// {tag,payload} pair), NO ABI wall / NO C-shim. Sibling of the deployed arr-zeros-leaf constructor.
//
// Body = an EMPTY boxed array: calloc a zeroed HexaArr descriptor (items@0=NULL len@8=0 cap@16=0
// heap_water@24=0, sizeof=32) + mint TAG_ARRAY=5 over it. calloc(1,32) == the C body's
// `HX_SET_ARR_PTR(v, calloc(1, sizeof(HexaArr)))`; __hx_make_val(5, a) == HX_MAKE_TAG(TAG_ARRAY)
// + HX_SET_ARR_PTR (the deployed zeros_leaf mint idiom).
//
// ★ PARITY DELTA (Fable design · stats-bump DROP): the C body bumps a debug-only static counter
// `_hx_stats_array_new++` (HX_RTCORE_LOCAL, gated on `_hx_stats_on()` which is OFF by default, read
// only by a stderr stats dump). A seed in a separate .o cannot see the file-scoped static, so the
// bump is DROPPED — byteeq-safe by construction (the counter never feeds emitted bytes; gen3≡gen4
// unaffected; the compiler's own hexa_array_new use during self-compile never observes it with stats
// off). Same accepted debug-only parity delta as the i64/f64/zeros seeds' dropped fprintf-OOM richness.
//
// SEED-ONLY SSOT: imported by NOTHING — enters runtime.a only via
// tool/regen_array_new_leaf_native_s.sh / stage_resolve_runtime_a resolve_native_array_new_seed.
// nm contract = hexa_array_new (single global). U-floor = { hexa_ptr_alloc, hexa_exit } — carrier-only,
// no libc entrant.
//
// ★★ ABI RULE — allocate through the HexaVal CARRIER, never through a raw libc extern.
// aprime's native emit lowers EVERY call in this seed with the hexa pair-ABI: arguments ride
// (tag,payload) register pairs and a result's payload is read from the SECOND return register (rdx/x1).
// A raw `extern fn calloc(...)` therefore emits a bare `call calloc` whose U-symbol binds at link time
// to the C-ABI libc calloc — which reads (rdi,rsi) as (nmemb,size) and returns the pointer in rax ALONE.
// The old body thus called calloc(0,1) and minted the descriptor out of whatever garbage sat in the dead
// rdx. Measured on the pre-revert seed, 3/3 runs on each target:
//     linux-x86_64 (glibc)   rdx = 0        -> the seed's own OOM guard fires -> hexa_exit(1)
//     darwin-arm64           x1  = garbage  -> a readable address -> SILENTLY wrong descriptor
// The x86_64 backend already documents this exact trap (compiler/codegen/x86_64_linux.hexa:2236 — a pair
// call into a C-ABI symbol "reads the caller's single rdi as the TAG and walks garbage"), which is why
// Route C keeps an _is_cabi allowlist; `calloc` was never on it and this seed never took Route C.
// hexa_ptr_alloc IS a HexaVal-ABI function (`HexaVal hexa_ptr_alloc(HexaVal size)`, self/runtime.h:872),
// so the pair lowering is CORRECT for it. It is malloc-backed and does NOT zero — which is the whole
// reason the calloc shortcut was reached for — hence the explicit four-word zero below.
// This is a CLASS defect: arr_zeros_leaf / array_typed_leaf / array_typed_leaf_f64 still declare raw libc
// externs and carry the same latent break (ARCHITECTURE convergence array-new-leaf-x86-64-s-1).

extern fn hexa_ptr_alloc(size: int) -> int    // HexaVal-ABI carrier (runtime.h:872) — malloc-backed, NOT zeroing
extern fn hexa_exit(code: int)                // HexaVal-ABI carrier — OOM abort

// hexa_array_new(): an empty boxed [HexaVal] array. Allocate the HexaArr descriptor through the carrier,
// zero its four words, and box it as TAG_ARRAY.
pub fn hexa_array_new() -> HexaVal {
    let a = hexa_ptr_alloc(32)            // 32B HexaArr descriptor (malloc-backed -> contents undefined)
    // __hx_payload_eq, NOT a plain `a == 0`: a plain int comparison lowers to the BOXED hexa_eq slow
    // call (convergence array-core-hexa-1), which drags `hexa_eq` into the seed's U-floor. And it does
    // so TARGET-DEPENDENTLY — x86_64 folds it to an inline cmp, arm64 emits `bl hexa_eq` — so the
    // x86-only cross-assemble check passed while both arm64 targets failed to link (measured on the
    // first regen of this fix). Leaf ops keep the U-floor carrier-only on every target.
    if __hx_payload_eq(a, 0) {
        hexa_exit(1)                      // OOM — matches the C body's abort path
    }
    __hx_ptr_store64(a, 0, 0)             // items      @0  = NULL
    __hx_ptr_store64(a, 8, 0)             // len        @8  = 0
    __hx_ptr_store64(a, 16, 0)            // cap        @16 = 0
    __hx_ptr_store64(a, 24, 0)            // heap_water @24 = 0
    return __hx_make_val(5, a)            // TAG_ARRAY=5, payload = descriptor ptr
}
