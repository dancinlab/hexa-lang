// stdlib/runtime/str_core.hexa — RT-NATIVE-ZEROC M4 str-core SCAN/COMPARE half.
//
// The hexa-source raw-mem body for the public string SCAN/COMPARE primitive
// rt_str_eq (byte-equality of two hexa strings). The array twin
// (stdlib/runtime/array_core.hexa) proved the raw-mem template; map added an
// open-addressing probe (map_core.hexa) with a NUL-terminated key strcmp
// (rt_map_strcmp0_native). This lane ports the PUBLIC string equality surface —
// distinct from intern/map's internal key strcmp (those take a raw `char*`
// boxed as TAG_INT; here the two params are real TAG_STR HexaVals as they arrive
// from the codegen `==` lowering / hexa_str_eq C wrapper).
//
// READ-ONLY / NO ALLOC: a byte walk over two existing string buffers + an int
// result. No calloc/realloc/arena — so it ports here (the alloc-bearing write
// prims — concat / substring / replace / strbuf — touch hexa_strbuf_alloc and
// are the libc-irreducible WALL owned by the alloc lane; NOT touched here).
//
// RAW-MEM, un-nested (NESTING finding, map_core.hexa): every __hx_payload_* /
// __hx_ptr_* call writes EXACTLY ONE `let` — NO nested intrinsic args. A native
// codegen clobber (r10/r11 / x1/x3 scratch reuse) corrupts the outer op when an
// intrinsic is a direct arg to another (measured in the map lane: nested → SEGV,
// un-nested → byte-exact vs C). One op per temp, exactly like array_core's
// straight-line form.
//
// ALL comparison uses the raw-int leaf intrinsics (__hx_payload_eq/ne), NOT the
// plain hexa `==`/`!=` operators — those lower to HexaVal runtime helpers
// (hexa_eq) which misinterpret the raw byte words. The __hx_ptr_load8 leaf reads
// one byte ZERO-EXTENDED into a TAG_INT payload (proven by m4_x86_leaf_ptr8 +
// __hx_str_byte), so the 0x00 NUL terminator compares as the int 0.
//
// LAYOUT (mirrors runtime_core_emit.hexa HexaStrHdr, locked by
// scripts/scratch/rt_native/str_core_gate.c):
//   a TAG_STR HexaVal's payload word (= __hx_payload_add(s, 0)) is the data
//   `char*` (HX_STR(v) == v.s; payload aliases .s in the union, same offset).
//   The buffer is NUL-terminated (HexaStrHdr.data[len] = '\0', and every
//   non-header path — literals, arena keys — is also C-NUL-terminated), so a
//   NUL-stop byte walk is byte-faithful to the C `hxlcl_strcmp(...) == 0` body.
//
// CIRCULARITY (array/map r1 trap, c1): the body must NOT use `s.byte_at(i)` /
// `byte_len(s)` / `a == b` over the string values — those re-enter the runtime
// (hexa_str_byte_at / hexa_byte_len / hexa_str_eq) and would be self-recursive.
// Every byte access here is RAW MEM via __hx_ptr_load8 over the data pointer,
// exactly the sequence the C `strcmp` body compiles to.
//
// These live in the LINKED rt-stdlib object set, provided to the shipped
// runtime.a ONLY via the frozen .s seed (self/native/str_core_*.s) — the
// __hx_ptr_load8 / __hx_payload_* leaves are gen2-native-only (the hexat
// C-transpile bootstrap cannot lower them), exactly like array_core / map_core.
// The runtime_core_emit.hexa `#ifdef HEXA_RT_STR_EQ_NATIVE` arm delegates to
// this body; the C `#else` (hxlcl_strcmp) is RETAINED for the no-seed fallback.

// NOT @pure: the body touches raw memory through __hx_ptr_load8 (loads of
// external buffer bytes). @pure would license the optimizer to CSE/elide the
// loads — wrong for raw-mem. Mirrors rt_map_strcmp0_native (also un-pure).

// rt_str_eq_native: true when the two NUL-terminated string buffers are
// byte-equal, else false. Raw byte walk over both data pointers — byte-faithful
// to the C body's `hxlcl_strcmp(HX_STR(a), HX_STR(b)) == 0`. The C wrapper keeps
// the TAG_STR guards + the interned-pointer fast-path (HX_STR(a) == HX_STR(b))
// since hexa source can't observe HX_STR identity, and delegates only the
// byte-compare on the distinct-pointer path.
pub fn rt_str_eq_native(a: HexaVal, b: HexaVal) -> bool {
    let pa = __hx_payload_add(a, 0)                  // char* of a (payload word)
    let pb = __hx_payload_add(b, 0)                  // char* of b
    let mut j = 0
    let mut ca = __hx_ptr_load8(pa, 0)
    let mut cb = __hx_ptr_load8(pb, 0)
    while __hx_payload_eq(ca, cb) {
        if __hx_payload_eq(ca, 0) { return true }    // both hit NUL together → equal
        j = __hx_payload_add(j, 1)
        ca = __hx_ptr_load8(pa, j)
        cb = __hx_ptr_load8(pb, j)
    }
    return false                                      // first mismatching byte
}

// rt_str_starts_with_native (str r2 — sh-str-scan): true when `s` begins with
// `prefix`, byte-faithful to the C body's
// `hxlcl_strncmp(HX_STR(s), HX_STR(prefix), HX_STRLEN(prefix)) == 0`. SAME
// raw-mem template as rt_str_eq_native — a NUL-stop byte walk, but driven by the
// PREFIX terminator (not a symmetric both-NUL stop): we consume prefix bytes
// until the prefix's NUL, comparing each against the same-offset haystack byte.
//
// The C reference uses `strncmp(s, prefix, plen)`; here the prefix is its own
// NUL-terminated buffer, so walking to the prefix's 0x00 is exactly `plen`
// bytes. If the haystack is SHORTER, its NUL (read as int 0 via __hx_ptr_load8)
// will never equal the corresponding non-NUL prefix byte → the mismatch branch
// returns false (matching strncmp, which stops at s's NUL and reports !=). The
// empty prefix (first byte NUL) returns true immediately — strncmp(...,0)==0.
//
// READ-ONLY / NO ALLOC, un-nested (1-op-per-temp, NESTING-SEGV guard), raw-int
// leaf comparison via __hx_payload_eq ONLY — the IDENTICAL intrinsic set as
// rt_str_eq_native (no __hx_payload_ne), so the body resolves under the same
// proven gate. The C wrapper (rt_str_starts_with in runtime_core_emit.hexa)
// keeps the TAG_STR guards; this body is the distinct-pointer byte walk it
// delegates to.
pub fn rt_str_starts_with_native(s: HexaVal, prefix: HexaVal) -> bool {
    let ps = __hx_payload_add(s, 0)                  // char* of haystack
    let pp = __hx_payload_add(prefix, 0)             // char* of prefix
    let mut j = 0
    let mut cp = __hx_ptr_load8(pp, 0)
    let mut cs = __hx_ptr_load8(ps, 0)
    // Walk while the prefix byte equals the haystack byte. Uses ONLY the
    // __hx_payload_eq leaf (same intrinsic set as rt_str_eq_native — no _ne) so
    // the body resolves under the identical proven gate.
    while __hx_payload_eq(cp, cs) {
        if __hx_payload_eq(cp, 0) { return true }    // prefix exhausted (both NUL here) → match
        j = __hx_payload_add(j, 1)
        cp = __hx_ptr_load8(pp, j)
        cs = __hx_ptr_load8(ps, j)
    }
    // Loop exited because cp != cs. If the prefix had already ended (cp == 0)
    // the bytes would have matched (haystack NUL) and we'd have returned above,
    // so reaching here always means a genuine prefix-byte mismatch → no match.
    return __hx_payload_eq(cp, 0)                     // true iff prefix ended exactly at the diff point
}
