// stdlib/runtime/valop_core.hexa — RT-NATIVE-ZEROC M4 VALOP-core (sh-val-core).
//
// The hexa-source raw-mem bodies for the SCALAR value-op kernel of the runtime:
// the tag-dispatch + scalar int/float/bool arithmetic & truthiness that
// hexa_truthy / hexa_sub / hexa_mul (runtime_core_emit.hexa) compute on a
// HexaVal's {tag, payload} image. The array twin (array_core.hexa) proved the
// __hx_tag / __hx_make_val read/write template; num (num_core.hexa) proved the
// raw byte→int accumulate; this VALOP lane is the FIRST to TAG-DISPATCH a
// HexaVal natively (read the tag word, branch on TAG_INT/FLOAT/BOOL, recompute,
// re-box) without re-entering the C runtime — the keystone the floor census
// flagged as the largest un-ported on-path family (~34 on-path, no native seed).
//
// READ-ONLY / NO ALLOC: each body reads one-or-two HexaVal images (tag + payload
// words held in registers) and returns a scalar HexaVal. No calloc/realloc/arena,
// no libm, no @syscall — so the SCALAR cases port here. The non-scalar arms
// (string concat / array concat / map / valstruct / the cross-type ↔ string
// throw paths) re-enter the runtime (HX_STR/len/hmap/throw) and STAY C — the C
// wrapper guards them and delegates only the scalar fast path. That C↔native
// split mirrors array_core's guard-C / body-rt split exactly.
//
// RAW-MEM, un-nested (NESTING finding, map_core.hexa): every __hx_* call writes
// EXACTLY ONE `let` — NO nested intrinsic args. The native-codegen nested-
// intrinsic clobber (#3503) corrupts the outer op when an intrinsic is a direct
// arg to another. One op per temp, straight-line, exactly like array/num_core.
//
// ALL tag reads / payload arithmetic / comparison use the raw leaf intrinsics
// (__hx_tag · __hx_payload_add/eq/lt · __hx_payload_fadd/fsub/fmul/fdiv ·
// __hx_to_double · __hx_make_val), NOT the plain hexa `+ - * == <` operators —
// those lower to the HexaVal runtime helpers (hexa_add_slow / hexa_eq / hexa_sub)
// we are PORTING, so using them here would be self-recursive (the array/map/str
// r1 circularity trap, c1). The intrinsics lower inline on the gen2 native
// backend; the hexat C-transpile bootstrap cannot lower them — hence these enter
// the shipped runtime.a ONLY via the frozen .s seed (self/native/valop_core_*.s),
// exactly like array/map/str/num_core. runtime_core_emit.hexa's
// `#ifdef HEXA_RT_VALOP_NATIVE` arms delegate to these bodies; the C `#else`
// (the legacy switch) is RETAINED for the no-seed fallback.

// NOT @pure: __hx_tag / __hx_to_double read the HexaVal union fields by tag; the
// optimizer must not CSE/elide across the tag branch (a @pure annotation would
// license that). Mirrors array_core's bodies (also un-pure).

// Tag constants (runtime_core_emit.hexa:1109):
//   TAG_INT = 0, TAG_FLOAT = 1, TAG_BOOL = 2, TAG_STR = 3, TAG_VOID = 4

// rt_truthy_native: the SCALAR arm of hexa_truthy (runtime_core_emit.hexa:7509).
// Returns hexa_bool(1)/hexa_bool(0) — but as a plain int payload the C wrapper
// reads via hexa_truthy(...) (the seed result is a TAG_BOOL HexaVal whose payload
// is 0/1, the same image hexa_bool produces). Byte-faithful to the C switch arms:
//   TAG_BOOL  → HX_BOOL(v)            (payload word, 0/1)
//   TAG_INT   → HX_INT(v)  != 0
//   TAG_FLOAT → HX_FLOAT(v) != 0.0    (NaN is non-zero → truthy, matches C)
//   TAG_VOID  → 0
// The C wrapper handles TAG_STR / TAG_ARRAY / TAG_MAP / TAG_VALSTRUCT (len /
// HX_STR / hmap / pointer — runtime re-entry) and only delegates the 4 scalar
// tags above; on any other tag this body returns the C default (1) too. Returns
// a TAG_BOOL HexaVal (tag 2) so the result image is identical to hexa_bool's.
fn rt_truthy_native(v: HexaVal) -> HexaVal {
    let tag = __hx_tag(v)

    // TAG_BOOL (2): result is the payload word verbatim (already 0/1).
    if __hx_payload_eq(tag, 2) {
        let p = __hx_payload_add(v, 0)               // HX_BOOL(v) (== HX_INT, union)
        return __hx_make_val(2, p)
    }

    // TAG_INT (0): payload != 0.
    if __hx_payload_eq(tag, 0) {
        let p = __hx_payload_add(v, 0)               // HX_INT(v)
        let nz = __hx_payload_ne(p, 0)               // bool 0/1 image
        let nzp = __hx_payload_add(nz, 0)            // payload word of the bool
        return __hx_make_val(2, nzp)
    }

    // TAG_FLOAT (1): HX_FLOAT(v) != 0.0 (NaN → true, matches C `!= 0.0`).
    // The native backend has no float `!=` leaf, so express `v != 0.0` as
    // `!(v <= 0.0 && v >= 0.0)`: le && ge is true ONLY for ±0.0 (both false for
    // NaN, exactly one true for any nonzero finite). So iszero captures ±0.0 and
    // truthy = !iszero gives ±0.0→0, NaN→1, finite-nonzero→1 — byte-faithful to C.
    if __hx_payload_eq(tag, 1) {
        let zf = __hx_to_double(0)                   // 0.0 as a float HexaVal
        let le = __hx_payload_fle(v, zf)             // v <= 0.0  (false for NaN)
        let ge = __hx_payload_fge(v, zf)             // v >= 0.0  (false for NaN)
        let lep = __hx_payload_add(le, 0)
        let gep = __hx_payload_add(ge, 0)
        let iszero = __hx_payload_and(lep, gep)      // 1 ONLY for ±0.0; 0 for NaN & nonzero
        let truthy = __hx_payload_eq(iszero, 0)      // bool: NOT iszero
        let tp = __hx_payload_add(truthy, 0)
        return __hx_make_val(2, tp)
    }

    // TAG_VOID (4): falsy.
    if __hx_payload_eq(tag, 4) {
        return __hx_make_val(2, 0)
    }

    // TAG_STR (3): HX_STR(v) != NULL && HX_STR(v)[0] != 0 (runtime_core.c:8290).
    if __hx_payload_eq(tag, 3) {
        let p = __hx_str_ptr(v)                       // char* base as int payload
        let pnz = __hx_payload_nz(p)
        let pnzp = __hx_payload_add(pnz, 0)
        if __hx_payload_eq(pnzp, 0) { return __hx_make_val(2, 0) }
        let b0 = __hx_str_byte(v, 0)                  // movzx s[0]
        let nz = __hx_payload_ne(b0, 0)
        let nzp = __hx_payload_add(nz, 0)
        return __hx_make_val(2, nzp)
    }

    // TAG_ARRAY (5): HX_ARR_LEN(v) > 0 (runtime_core.c:8295; len is i32 >= 0).
    if __hx_payload_eq(tag, 5) {
        let n = __hx_arr_len(v)
        let z = __hx_make_val(0, 0)
        let gt = __hx_payload_gt(n, z)
        let gtp = __hx_payload_add(gt, 0)
        return __hx_make_val(2, gtp)
    }

    // TAG_VALSTRUCT (10): HX_VS(v) != NULL (runtime_core.c:8306).
    if __hx_payload_eq(tag, 10) {
        let p = __hx_payload_add(v, 0)
        let nz = __hx_payload_nz(p)
        let nzp = __hx_payload_add(nz, 0)
        return __hx_make_val(2, nzp)
    }

    // TAG_MAP (6) stays C (the __type__ probe needs hmap_find + a string literal —
    // breaks the zero-.LC/zero-extern seed contract; named wall). Any other tag:
    // the C default (return 1). The C wrapper only delegates the tags handled here.
    return __hx_make_val(2, 1)
}

// rt_sub_native: the SCALAR numeric arm of hexa_sub (runtime_core.c via
// numeric.hexa::rt_sub). Byte-faithful to the int-int and float/mixed paths:
//   int  - int  → TAG_INT (payload subtract)
//   else (any float, with the other int coerced to double) → TAG_FLOAT
// bool→int coercion (true=1) and the non-numeric throw STAY in the C wrapper —
// it pre-coerces bool operands to TAG_INT and rejects non-numeric BEFORE
// delegating, so this body only ever sees TAG_INT / TAG_FLOAT operands. Mirrors
// the rt_sub dispatch in numeric.hexa, but native (no type_of re-entry).
fn rt_sub_native(a: HexaVal, b: HexaVal) -> HexaVal {
    let ta = __hx_tag(a)
    let tb = __hx_tag(b)
    let a_int = __hx_payload_eq(ta, 0)               // a is TAG_INT
    let b_int = __hx_payload_eq(tb, 0)               // b is TAG_INT
    let both_int = __hx_payload_and(a_int, b_int)
    if __hx_payload_ne(both_int, 0) {
        let r = __hx_payload_sub(a, b)               // HX_INT(a) - HX_INT(b)
        let rp = __hx_payload_add(r, 0)
        return __hx_make_val(0, rp)
    }
    let af = __hx_to_double(a)                        // int|float → double
    let bf = __hx_to_double(b)
    let rf = __hx_payload_fsub(af, bf)               // double subtract, TAG_FLOAT
    let rfp = __hx_payload_add(rf, 0)
    return __hx_make_val(1, rfp)
}

// rt_mul_native: the SCALAR numeric arm of hexa_mul (same shape as rt_sub_native,
// proven by numeric.hexa::rt_mul). int*int → TAG_INT; any float → TAG_FLOAT. The
// C wrapper owns bool→int coerce + non-numeric throw (hexa_mul has no string-
// repeat), so this body only sees TAG_INT / TAG_FLOAT.
fn rt_mul_native(a: HexaVal, b: HexaVal) -> HexaVal {
    let ta = __hx_tag(a)
    let tb = __hx_tag(b)
    let a_int = __hx_payload_eq(ta, 0)
    let b_int = __hx_payload_eq(tb, 0)
    let both_int = __hx_payload_and(a_int, b_int)
    if __hx_payload_ne(both_int, 0) {
        let r = __hx_payload_mul(a, b)               // HX_INT(a) * HX_INT(b)
        let rp = __hx_payload_add(r, 0)
        return __hx_make_val(0, rp)
    }
    let af = __hx_to_double(a)
    let bf = __hx_to_double(b)
    let rf = __hx_payload_fmul(af, bf)
    let rfp = __hx_payload_add(rf, 0)
    return __hx_make_val(1, rfp)
}

// rt_add_native: the SCALAR numeric arm of hexa_add_slow (the slow path behind the
// int+int hexa_add MACRO). Same shape as rt_sub_native/rt_mul_native, proven by
// numeric.hexa::rt_add_slow's scalar branches: int+int → TAG_INT (payload add),
// else (any float, the other int coerced to double) → TAG_FLOAT. The C wrapper
// (hexa_add_slow under HEXA_RT_VALOP_NATIVE) owns bool→int coerce, the array-concat
// branch, and the to_string/str_concat fallback — it delegates here ONLY when both
// operands are already TAG_INT/TAG_FLOAT, so this body never sees a string/array/
// bool/void. Mirrors rt_sub_native exactly with `+` in place of `-` (the int arm
// uses __hx_payload_add(a,b) — the 2-arg signed-i64 add that boxes TAG_INT, same
// leaf rt_sub_native uses for subtract; the float arm uses __hx_payload_fadd).
fn rt_add_native(a: HexaVal, b: HexaVal) -> HexaVal {
    let ta = __hx_tag(a)
    let tb = __hx_tag(b)
    let a_int = __hx_payload_eq(ta, 0)               // a is TAG_INT
    let b_int = __hx_payload_eq(tb, 0)               // b is TAG_INT
    let both_int = __hx_payload_and(a_int, b_int)
    if __hx_payload_ne(both_int, 0) {
        let r = __hx_payload_add(a, b)               // HX_INT(a) + HX_INT(b)
        let rp = __hx_payload_add(r, 0)
        return __hx_make_val(0, rp)
    }
    let af = __hx_to_double(a)                        // int|float → double
    let bf = __hx_to_double(b)
    let rf = __hx_payload_fadd(af, bf)               // double add, TAG_FLOAT
    let rfp = __hx_payload_add(rf, 0)
    return __hx_make_val(1, rfp)
}

// ── rt_cmp_{lt,gt,le,ge}_native: the SCALAR ordered-compare arm of hexa_cmp_*
// (runtime_core.c #else: int-int via HX_INT(a) < HX_INT(b), float/valstruct via
// __hx_to_double(a) < __hx_to_double(b)). Each returns a TAG_BOOL HexaVal (0/1),
// byte-identical to hexa_bool(...). The C wrapper (hexa_cmp_* under
// HEXA_RT_VALOP_NATIVE) keeps the enum-pair (_hexa_enum_pair_idx), string
// (hxlcl_strcmp), and incomparable-throw (_hx_cmp_guard) arms — all runtime
// re-entry — and delegates here ONLY when both operands are scalar int/float
// (no enum/str), exactly the array/map guard-C / body-native split. The int arm
// uses the __hx_payload_{lt,gt,le,ge} signed-i64 compare leaves (map_core/rt_str
// proven); the float/mixed arm uses __hx_to_double + __hx_payload_{flt,fgt,fle,
// fge} — NO runtime call, no recursion (the rt_cmp hexa-source path's eq→cmp_le
// circularity does NOT apply: these read raw leaves, never hexa_eq/hexa_cmp).
// un-nested 1-op-per-temp (NESTING-SEGV guard); the float compare's NaN behavior
// matches C's `<`/`>`/`<=`/`>=` (all false for NaN) since the leaves lower to the
// same ucomisd/fcmp the C operators emit.
//
// rt_cmp_lt_native: a < b.
fn rt_cmp_lt_native(a: HexaVal, b: HexaVal) -> HexaVal {
    let ta = __hx_tag(a)
    let tb = __hx_tag(b)
    let a_int = __hx_payload_eq(ta, 0)               // a is TAG_INT
    let b_int = __hx_payload_eq(tb, 0)               // b is TAG_INT
    let both_int = __hx_payload_and(a_int, b_int)
    if __hx_payload_ne(both_int, 0) {
        let lt = __hx_payload_lt(a, b)               // HX_INT(a) < HX_INT(b)
        let ltp = __hx_payload_add(lt, 0)
        return __hx_make_val(2, ltp)
    }
    let af = __hx_to_double(a)                        // int|float → double
    let bf = __hx_to_double(b)
    let flt = __hx_payload_flt(af, bf)               // af < bf (false for NaN)
    let fltp = __hx_payload_add(flt, 0)
    return __hx_make_val(2, fltp)
}

// rt_cmp_gt_native: a > b.
fn rt_cmp_gt_native(a: HexaVal, b: HexaVal) -> HexaVal {
    let ta = __hx_tag(a)
    let tb = __hx_tag(b)
    let a_int = __hx_payload_eq(ta, 0)
    let b_int = __hx_payload_eq(tb, 0)
    let both_int = __hx_payload_and(a_int, b_int)
    if __hx_payload_ne(both_int, 0) {
        let gt = __hx_payload_gt(a, b)               // HX_INT(a) > HX_INT(b)
        let gtp = __hx_payload_add(gt, 0)
        return __hx_make_val(2, gtp)
    }
    let af = __hx_to_double(a)
    let bf = __hx_to_double(b)
    let fgt = __hx_payload_fgt(af, bf)               // af > bf (false for NaN)
    let fgtp = __hx_payload_add(fgt, 0)
    return __hx_make_val(2, fgtp)
}

// rt_cmp_le_native: a <= b.
fn rt_cmp_le_native(a: HexaVal, b: HexaVal) -> HexaVal {
    let ta = __hx_tag(a)
    let tb = __hx_tag(b)
    let a_int = __hx_payload_eq(ta, 0)
    let b_int = __hx_payload_eq(tb, 0)
    let both_int = __hx_payload_and(a_int, b_int)
    if __hx_payload_ne(both_int, 0) {
        let le = __hx_payload_le(a, b)               // HX_INT(a) <= HX_INT(b)
        let lep = __hx_payload_add(le, 0)
        return __hx_make_val(2, lep)
    }
    let af = __hx_to_double(a)
    let bf = __hx_to_double(b)
    let fle = __hx_payload_fle(af, bf)               // af <= bf (false for NaN)
    let flep = __hx_payload_add(fle, 0)
    return __hx_make_val(2, flep)
}

// rt_cmp_ge_native: a >= b.
fn rt_cmp_ge_native(a: HexaVal, b: HexaVal) -> HexaVal {
    let ta = __hx_tag(a)
    let tb = __hx_tag(b)
    let a_int = __hx_payload_eq(ta, 0)
    let b_int = __hx_payload_eq(tb, 0)
    let both_int = __hx_payload_and(a_int, b_int)
    if __hx_payload_ne(both_int, 0) {
        let ge = __hx_payload_ge(a, b)               // HX_INT(a) >= HX_INT(b)
        let gep = __hx_payload_add(ge, 0)
        return __hx_make_val(2, gep)
    }
    let af = __hx_to_double(a)
    let bf = __hx_to_double(b)
    let fge = __hx_payload_fge(af, bf)               // af >= bf (false for NaN)
    let fgep = __hx_payload_add(fge, 0)
    return __hx_make_val(2, fgep)
}

// ── rt_div_native / rt_mod_native: the INT-INT arm of hexa_div / hexa_mod,
// unlocked by the new __hx_payload_div / __hx_payload_mod codegen leaves (signed
// i64 idiv/sdiv + remainder). int/int → TAG_INT. The C wrapper (hexa_div/hexa_mod
// under HEXA_RT_VALOP_NATIVE) keeps EVERYTHING ELSE in C: the divide-by-zero
// throw (hexa_throw = runtime re-entry, OUT of the leaf class), bool→int coerce,
// the float/mixed IEEE path (rt_div's __raw_*_f / fdiv), and the non-numeric
// throw. It delegates here ONLY when both operands are TAG_INT *and* the divisor
// is nonzero — so this body never divides by zero (the leaf's only UB, same as C
// int64 `/`/`%`; INT64_MIN/-1 #DE is the identical UB the C body also leaves
// unguarded). Mirrors rt_sub/mul/add_native exactly, with the int-div leaves.
//
// rt_div_native: int/int quotient (truncating toward zero, == C `/`).
fn rt_div_native(a: HexaVal, b: HexaVal) -> HexaVal {
    let r = __hx_payload_div(a, b)                   // HX_INT(a) / HX_INT(b)
    let rp = __hx_payload_add(r, 0)
    return __hx_make_val(0, rp)
}

// rt_mod_native: int/int remainder (sign follows dividend, == C `%`).
fn rt_mod_native(a: HexaVal, b: HexaVal) -> HexaVal {
    let r = __hx_payload_mod(a, b)                   // HX_INT(a) % HX_INT(b)
    let rp = __hx_payload_add(r, 0)
    return __hx_make_val(0, rp)
}

// ── axis-② Tier-1 #2: eqtruthy/coercion scalar arms (HEXA_RT_VALOP_EQCOERCE_NATIVE) ──
// Byte-parity native bodies for the scalar arms of the eq/coercion C dispatchers
// (self/runtime_core_emit.hexa). Each is called by the C wrapper ONLY on the eligible
// scalar tags; non-scalar/STR/MAP arms stay C (named walls). le&&ge == `==` for i64 and
// IEEE double (NaN → both false → 0). RAW-MEM un-nested (#3503): one __hx_* per let.

// rt_eq_scalar_native: scalar arm of hexa_eq — HX_TAG(a)<=BOOL && HX_TAG(b)<=BOOL.
// Cross int<->float (== as fle&&fge) → same-tag i64/bool payload eq → tag-mismatch false.
fn rt_eq_scalar_native(a: HexaVal, b: HexaVal) -> HexaVal {
    let ta = __hx_tag(a)
    let tb = __hx_tag(b)
    let a_int = __hx_payload_eq(ta, 0)
    let a_flt = __hx_payload_eq(ta, 1)
    let b_int = __hx_payload_eq(tb, 0)
    let b_flt = __hx_payload_eq(tb, 1)
    let c1 = __hx_payload_and(a_int, b_flt)          // int == float
    let c2 = __hx_payload_and(a_flt, b_int)          // float == int
    let cross = __hx_payload_or(c1, c2)
    let both_f = __hx_payload_and(a_flt, b_flt)      // float == float
    let feq = __hx_payload_or(cross, both_f)
    if __hx_payload_ne(feq, 0) {
        let af = __hx_to_double(a)
        let bf = __hx_to_double(b)
        let le = __hx_payload_fle(af, bf)            // false for NaN
        let ge = __hx_payload_fge(af, bf)            // false for NaN
        let lep = __hx_payload_add(le, 0)
        let gep = __hx_payload_add(ge, 0)
        let r = __hx_payload_and(lep, gep)           // IEEE == (NaN -> 0)
        return __hx_make_val(2, r)
    }
    let both_i = __hx_payload_and(a_int, b_int)      // int == int
    if __hx_payload_ne(both_i, 0) {
        let le = __hx_payload_le(a, b)
        let ge = __hx_payload_ge(a, b)
        let lep = __hx_payload_add(le, 0)
        let gep = __hx_payload_add(ge, 0)
        let r = __hx_payload_and(lep, gep)
        return __hx_make_val(2, r)
    }
    let a_b = __hx_payload_eq(ta, 2)
    let b_b = __hx_payload_eq(tb, 2)
    let both_b = __hx_payload_and(a_b, b_b)          // bool == bool (0/1 payload)
    if __hx_payload_ne(both_b, 0) {
        let le = __hx_payload_le(a, b)
        let ge = __hx_payload_ge(a, b)
        let lep = __hx_payload_add(le, 0)
        let gep = __hx_payload_add(ge, 0)
        let r = __hx_payload_and(lep, gep)
        return __hx_make_val(2, r)
    }
    return __hx_make_val(2, 0)                        // bool x int / bool x float: mismatch -> false
}

// rt_to_int_native: hexa_to_int scalar arm — tags {INT,FLOAT}. STR-parse stays C.
fn rt_to_int_native(v: HexaVal) -> HexaVal {
    let tag = __hx_tag(v)
    if __hx_payload_eq(tag, 0) { return v }           // int passthrough (== rt_to_int)
    let r = __hx_payload_f2i(v)                       // (int64_t)HX_FLOAT(v) — cvttsd2si/fcvtzs
    let rp = __hx_payload_add(r, 0)
    return __hx_make_val(0, rp)
}

// rt_to_float_native: hexa_to_float scalar arm — tags {INT,FLOAT,BOOL}. STR/VS stay C.
fn rt_to_float_native(v: HexaVal) -> HexaVal {
    let tag = __hx_tag(v)
    if __hx_payload_eq(tag, 1) { return v }           // float: rebox == identity
    let rf = __hx_payload_i2f(v)                       // int(0)/bool(2) payload -> (double)
    let rfp = __hx_payload_add(rf, 0)
    return __hx_make_val(1, rfp)
}

// rt_abs_native: hexa_abs — INT (non-INT64_MIN, pre-guarded by the C wrapper) + FLOAT.
// -0.0/NaN passthrough == rt_abs_float; 0-v for negatives.
fn rt_abs_native(v: HexaVal) -> HexaVal {
    let tag = __hx_tag(v)
    if __hx_payload_eq(tag, 0) {
        let z = __hx_make_val(0, 0)
        let lt = __hx_payload_lt(v, z)
        let ltp = __hx_payload_add(lt, 0)
        if __hx_payload_eq(ltp, 0) { return v }
        let r = __hx_payload_sub(z, v)                // 0 - v (== rt_abs_int)
        let rp = __hx_payload_add(r, 0)
        return __hx_make_val(0, rp)
    }
    let zf = __hx_to_double(0)
    let lt = __hx_payload_flt(v, zf)                  // false for NaN and -0.0
    let ltp = __hx_payload_add(lt, 0)
    if __hx_payload_eq(ltp, 0) { return v }           // NaN/-0.0 passthrough == rt_abs_float
    let rf = __hx_payload_fsub(zf, v)                 // 0.0 - v
    let rfp = __hx_payload_add(rf, 0)
    return __hx_make_val(1, rfp)
}

// rt_null_coal_native: hexa_null_coal — fully native (no wall). VOID -> b; STR NULL/lead-NUL -> b.
fn rt_null_coal_native(a: HexaVal, b: HexaVal) -> HexaVal {
    let tag = __hx_tag(a)
    if __hx_payload_eq(tag, 4) { return b }           // TAG_VOID
    if __hx_payload_eq(tag, 3) {                       // TAG_STR
        let p = __hx_str_ptr(a)
        let pnz = __hx_payload_nz(p)
        let pnzp = __hx_payload_add(pnz, 0)
        if __hx_payload_eq(pnzp, 0) { return b }
        let b0 = __hx_str_byte(a, 0)
        let b0p = __hx_payload_add(b0, 0)
        if __hx_payload_eq(b0p, 0) { return b }
        return a
    }
    return a
}
