}

pub fn hxlcl_getppid() -> int {
    let mut nr = 39                            // Darwin SYS_GETPPID (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 110 }     // Linux x86_64 __NR_getppid
        else { nr = 173 }                      // Linux arm64 __NR_getppid
    }
