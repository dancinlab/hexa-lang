// ── SYSCALL FAMILY (Route C errno-bearing · ② extern-data substrate via accessor) ──
//
// hxlcl_close is the FIRST errno-BEARING Route C syscall leaf. Unlike the
// errno-free family above (getpid/getuid/…), a failed syscall must set the C
// `errno` so the generated-C callers (self/native/net_emit.hexa:195
// `if(hxlcl_close(fd)<0) return -errno`, signal_flock_emit.hexa:287) observe the
// same libc-`close` contract (return -1 + errno SET).
//
// FROZEN-SAFE errno store via the canonical thread-local accessor (NO new
// builtin/syntax — the substrate is built from existing constructs):
//   - `__errno_location()` is the LSB/glibc/musl standard `int *(void)`
//     returning the address of the calling thread's errno (errno is a macro
//     `(*__errno_location())`). Declared here as an `extern fn` (no body →
//     undefined-external resolved at link), mirroring hxlcl_atoll/hxlcl_malloc
//     above; whitelisting it in `_is_cabi` makes the inner `bl __errno_location`
//     lower single-register C-ABI (0 args; ptr ← rax/x0).
//   - `__hx_ptr_store32(ptr, off, val)` writes the 32-bit `errno` (errno is an
//     int) to that address. (store32, not store64 — errno is int-width.)
//
// Linux returns `-errno` directly (no carry flag), so the store is
// `*errno_p = -r` and the fn returns -1, exactly like musl's __syscall_ret
// (`if (r > -4096UL) { errno = -r; return -1; }`). The errno store is gated on
// `target_is_linux()` — DARWIN signals errors via the carry flag with a POSITIVE
// errno (not -r), so the Linux store would be wrong there; on darwin the gate is
// a compile-time-false const → DCE drops the `__errno_location` call entirely
// (darwin errno = a separate round via `__error()`, the darwin accessor). The
// darwin smoke therefore asserts only close's return value (0 / -1), while the
// LINUX routec-smoke asserts errno == EBADF (value-exact, the substrate's core
// claim).
//
// PER-TARGET close NR (compile-time consts → DCE):
//   Linux x86_64 = 3   (syscall_64.tbl)              · Linux arm64 = 57 (asm-generic)
//   Darwin       = 6   (SYS_CLOSE; __hx_syscall6's BSD trap OR-bakes 0x2000000)
// BYTE-FAITHFUL to the floor (self/codegen/runtime_arm64.hexa:2809):
//   hxlcl_close(int fd) { return (int)_hxlcl_syscall1_cf(SYS_CLOSE, fd); }

extern fn __errno_location() -> int

pub fn hxlcl_close(fd: HexaVal) -> int {
    let mut nr = 6                             // Darwin SYS_CLOSE (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 3 }       // Linux x86_64 __NR_close
        else { nr = 57 }                       // Linux arm64 __NR_close
    }
    let r = __hx_syscall6(nr, fd, 0, 0, 0, 0, 0)
    // IN-BODY OPERATOR DISCIPLINE (Route C): the 3-boundary C-ABI lowering does
    // NOT touch in-body operators — a plain `r < 0` / `0 - r` would lower to the
    // PAIR-MODEL helpers (hexa_cmp_lt / hexa_sub), which are undefined in the raw
    // C-ABI link (the #4042-RED root cause). Use the raw-payload leaf intrinsics
    // instead — the same rule the composite family follows (hxlcl_core.hexa:77
    // `__hx_payload_lt`, :146 `__hx_payload_sub`). Each writes exactly one `let`
    // (un-nested), so a codegen scratch clobber can't corrupt an outer op.
    let neg = __hx_payload_lt(r, 0)            // r < 0 (raw signed payload compare)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()         // &errno (thread-local)
            let e = __hx_payload_sub(0, r)     // -(-errno) = positive errno
            __hx_ptr_store32(p, 0, e)          // *errno_p = e
        }
        return -1
    }
    return r                                    // fd close result (0)
}

// ── ERRNO-BEARING CHAIN (close mirror) — uniform 3-arg syscalls read / lseek ──
//
// Both follow the EXACT close pattern: a __hx_syscall6 trap, then the Route C
// in-body discipline (raw-payload `__hx_payload_lt`/`_ne`/`_sub`, never bare
// `<`/`-`) + the target_is_linux()-gated errno store via __errno_location. They
// are uniform 3-arg across all targets (no arm64 dup3/mkdirat-style call-shape
// divergence), so the body is a verbatim mirror with only the NR + arg names
// changed. NR ref-match (no black-box):
//   read : x86_64 0 · arm64 63 · darwin 3   (syscall_64.tbl / asm-generic
//          unistd.h __NR_read 63 / runtime.c HXLCL_SYS_READ 3)
//   lseek: x86_64 8 · arm64 62 · darwin 199 (syscall_64.tbl / __NR_lseek 62 /
//          runtime.c HXLCL_SYS_LSEEK 199; darwin 0x20000c7)

pub fn hxlcl_read(fd: HexaVal, buf: HexaVal, n: HexaVal) -> int {
    let mut nr = 3                             // Darwin SYS_READ (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 0 }       // Linux x86_64 __NR_read
        else { nr = 63 }                       // Linux arm64 __NR_read
    }
    let r = __hx_syscall6(nr, fd, buf, n, 0, 0, 0)
    let neg = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // bytes read (>= 0)
}

pub fn hxlcl_lseek(fd: HexaVal, off: HexaVal, whence: HexaVal) -> int {
    let mut nr = 199                           // Darwin SYS_LSEEK (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 8 }       // Linux x86_64 __NR_lseek
        else { nr = 62 }                       // Linux arm64 __NR_lseek
    }
    let r = __hx_syscall6(nr, fd, off, whence, 0, 0, 0)
    let neg = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // resulting file offset (>= 0)
}

// ── ERRNO-BEARING CHAIN r2 — arm64 CALL-SHAPE DIVERGENCE (5th discipline) ──
//
// dup2 and mkdir have NO plain syscall on arm64-linux (asm-generic dropped the
// legacy numbers); they must use the *at-variant with an extra arg:
//   dup2  → dup3(old, new, FLAGS=0)        (arm64 __NR_dup3 = 24, 3-arg)
//   mkdir → mkdirat(AT_FDCWD=-100, path, mode) (arm64 __NR_mkdirat = 34, 3-arg)
// x86_64-linux + darwin keep the plain 2-arg form (dup2 33/90, mkdir 83/136).
// NR + AT_FDCWD ref-match (no black-box): x86_64 = syscall_64.tbl; arm64 dup3=24/
// mkdirat=34 = include/uapi/asm-generic/unistd.h (NO plain dup2/mkdir there);
// darwin = runtime.c HXLCL_SYS_DUP2 90 / HXLCL_SYS_MKDIR 136; AT_FDCWD=-100 =
// self/rt/syscall.hexa:153,161. errno-store = the close discipline verbatim.

// dup2: the arm64 dup3 call takes the SAME old/new args plus a trailing flags=0,
// so passing `(nr, old, new, 0, …)` is correct on EVERY target — x86_64/darwin
// dup2 ignore the unused arg slot, arm64 dup3 reads arg[2]=0 as flags=0. Hence
// only the NR differs (uniform arg tuple), exactly like read/lseek.
pub fn hxlcl_dup2(oldfd: HexaVal, newfd: HexaVal) -> int {
    let mut nr = 90                            // Darwin SYS_DUP2 (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 33 }      // Linux x86_64 __NR_dup2
        else { nr = 24 }                       // Linux arm64 __NR_dup3 (flags=0)
    }
    let r = __hx_syscall6(nr, oldfd, newfd, 0, 0, 0, 0)
    let neg = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // newfd (>= 0)
}

// mkdir: the arm64 mkdirat call PREPENDS AT_FDCWD, shifting path/mode right by
// one — a genuine per-arch ARG-TUPLE divergence (not just a NR swap). So the
// syscall is issued in per-arch branches with the correct argument shape; the
// result `r` then flows into the shared close-pattern errno epilogue.
pub fn hxlcl_mkdir(path: HexaVal, mode: HexaVal) -> int {
    let mut r = 0
    if target_is_linux() {
        if target_is_x86_64() {
            r = __hx_syscall6(83, path, mode, 0, 0, 0, 0)        // x86_64 mkdir(path, mode)
        } else {
            r = __hx_syscall6(34, -100, path, mode, 0, 0, 0)     // arm64 mkdirat(AT_FDCWD, path, mode)
        }
    } else {
        r = __hx_syscall6(136, path, mode, 0, 0, 0, 0)           // darwin SYS_MKDIR(path, mode)
    }
    let neg = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // 0 on success
}

// ── ERRNO-BEARING CHAIN r3 — FINAL batch: stat (struct-out buf) + waitpid ──
//
// The last two errno-bearing leaves. Both share the close errno epilogue
// (raw-payload `__hx_payload_lt`/`_ne`/`_sub` + target_is_linux()-gated store via
// __errno_location); they differ only in argument shape.
//
//   stat → arm64 has NO plain stat; it uses fstatat(AT_FDCWD=-100, path, buf,
//          flags=0) — a 4-arg PREPEND divergence exactly like mkdir→mkdirat. So
//          the syscall is issued in per-arch branches (per-arch arg tuple), then
//          the shared epilogue runs on the result.
//          NR ref-match (no black-box): x86_64 __NR_stat = 4 (2-arg path,buf) ·
//          arm64 __NR_fstatat = 79 (4-arg AT_FDCWD,path,buf,flags) — plain stat
//          dropped on asm-generic · darwin SYS_STAT = 338 (2-arg path,buf).
//          (stdlib/posix/linux_syscalls.hexa:129/102 · self/codegen/
//          runtime_arm64.hexa:4198-4199 darwin 338 · AT_FDCWD=-100 = the same
//          literal mkdir uses above.)
//
//   waitpid → routed to wait4(pid, status, options, rusage=NULL) on every target
//          — a UNIFORM 4-arg shape (no at-variant / no prepend), so only the NR
//          differs, exactly like read/lseek. NR ref-match: x86_64 __NR_wait4 = 61
//          · arm64 __NR_wait4 = 260 · darwin SYS_WAIT4 = 7 (rusage NULL ⇒ 0).
//          (linux_syscalls.hexa:123/95 · self/codegen/runtime_arm64.hexa:5218
//          darwin 7. The floor routes waitpid → wait4 with a NULL 4th arg:
//          runtime.c hxlcl_waitpid(pid,status,opts){ wait4(pid,status,opts,0) }.)

// stat: per-arch arg tuple (arm64 fstatat prepends AT_FDCWD, shifting path/buf
// right by one — a genuine divergence, mirrors mkdir). The result flows into the
// shared close-pattern errno epilogue.
pub fn hxlcl_stat(path: HexaVal, statbuf: HexaVal) -> int {
    let mut r = 0
    if target_is_linux() {
        if target_is_x86_64() {
            r = __hx_syscall6(4, path, statbuf, 0, 0, 0, 0)          // x86_64 stat(path, buf)
        } else {
            r = __hx_syscall6(79, -100, path, statbuf, 0, 0, 0)      // arm64 fstatat(AT_FDCWD, path, buf, flags=0)
        }
    } else {
        r = __hx_syscall6(338, path, statbuf, 0, 0, 0, 0)            // darwin SYS_STAT(path, buf)
    }
    let neg = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // 0 on success
}

// waitpid: uniform wait4(pid, status, options, rusage=NULL) — only the NR varies,
// so a single trap with the same arg tuple is correct on every target (like
// read/lseek). The 4th arg (rusage) is 0 = NULL.
pub fn hxlcl_waitpid(pid: HexaVal, status: HexaVal, opts: HexaVal) -> int {
    let mut nr = 7                             // Darwin SYS_WAIT4 (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 61 }      // Linux x86_64 __NR_wait4
        else { nr = 260 }                      // Linux arm64 __NR_wait4
    }
    let r = __hx_syscall6(nr, pid, status, opts, 0, 0, 0)
    let neg = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // reaped pid (> 0)
}

// ── ERRNO-BEARING CHAIN — batch C: write + fcntl + mmap (plain syscalls) ──
//
// Three more errno-bearing leaves, all uniform across targets (no arm64
// dup3/mkdirat/fstatat call-shape divergence — each has a plain syscall on
// arm64-linux, so only the NR varies, exactly like read/lseek/waitpid). All
// three follow the close errno epilogue verbatim: a __hx_syscall6 trap, then
// the Route C in-body discipline (raw-payload `__hx_payload_lt`/`_ne`/`_sub`,
// never bare `<`/`-`) + the target_is_linux()-gated errno store via the already
// whitelisted __errno_location.
//
//   write : x86_64 1 · arm64 64 · darwin 4   (syscall_64.tbl write=1 /
//           asm-generic unistd.h __NR_write 64 / runtime.c HXLCL_SYS_WRITE 4,
//           darwin BSD trap OR-bakes 0x2000000). The exact 3-arg mirror of read
//           (floor: hxlcl_write = _hxlcl_syscall3_cf, errno-bearing like read).
//   fcntl : x86_64 72 · arm64 25 · darwin 92  (syscall_64.tbl fcntl=72 /
//           asm-generic __NR_fcntl 25 / runtime.c HXLCL_SYS_FCNTL 92). A plain
//           3-arg (fd, cmd, arg). On Linux a failing fcntl returns -errno (the
//           uniform raw-syscall convention), so the same errno-store leg is
//           correct; the floor uses the NON-_cf path (no darwin errno), which
//           matches our discipline ④ (darwin carry deferred → store DCE'd).
//   mmap  : x86_64 9 · arm64 222 · darwin 197 (syscall_64.tbl mmap=9 /
//           asm-generic __NR_mmap 222 / runtime.c HXLCL_SYS_MMAP 197). 6-arg
//           (addr, len, prot, flags, fd, off).
//
// ⚠️ mmap ERROR-DETECTION root-cause (NOT the libc MAP_FAILED sentinel):
// at the RAW Linux syscall level — which this Route C body issues directly —
// mmap returns the mapped address on success (a positive user-space address,
// well below 2^63 ⇒ signed-positive) or `-errno` in [-4095, -1] on error,
// EXACTLY like every other syscall. The `MAP_FAILED == (void*)-1` sentinel is a
// LIBC-WRAPPER artifact: glibc's mmap wrapper converts the raw `-errno` range to
// MAP_FAILED via the `> -4096UL` threshold (musl src/internal/syscall_ret.c:
// `if(r > -4096UL){ errno=-r; return -1; }`), and the darwin `_cf` floor
// (runtime_arm64.hexa:5309 `mov x0,#-1` on carry) does the same. Our body is the
// raw layer BELOW that wrapper, so the correct error check is the uniform
// `__hx_payload_lt(r, 0)` (raw `-errno` is negative) — NOT a `payload_eq -1`
// MAP_FAILED check, which would only fire on the already-converted libc value
// and would mis-treat a valid high address or a different -errno. So mmap is a
// uniform `-errno` mirror like read/write; the errno-store leg then writes -r
// and returns -1 (which the C caller reads as MAP_FAILED on Linux, since
// (void*)-1 == the -1 we return).

pub fn hxlcl_write(fd: HexaVal, buf: HexaVal, n: HexaVal) -> int {
    let mut nr = 4                             // Darwin SYS_WRITE (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 1 }       // Linux x86_64 __NR_write
        else { nr = 64 }                       // Linux arm64 __NR_write
    }
    let r = __hx_syscall6(nr, fd, buf, n, 0, 0, 0)
    let neg = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // bytes written (>= 0)
}

pub fn hxlcl_fcntl(fd: HexaVal, cmd: HexaVal, arg: HexaVal) -> int {
    let mut nr = 92                            // Darwin SYS_FCNTL (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 72 }      // Linux x86_64 __NR_fcntl
        else { nr = 25 }                       // Linux arm64 __NR_fcntl
    }
    let r = __hx_syscall6(nr, fd, cmd, arg, 0, 0, 0)
    let neg = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // cmd-dependent result (>= 0)
}

// mmap: 6-arg uniform trap (see the error-detection root-cause above — the raw
// syscall returns the address on success or -errno on failure, so the close
// `__hx_payload_lt(r, 0)` check is correct, NOT a MAP_FAILED `== -1` check).
pub fn hxlcl_mmap(addr: HexaVal, len: HexaVal, prot: HexaVal, flags: HexaVal, fd: HexaVal, off: HexaVal) -> int {
    let mut nr = 197                           // Darwin SYS_MMAP (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 9 }       // Linux x86_64 __NR_mmap
        else { nr = 222 }                      // Linux arm64 __NR_mmap
    }
    let r = __hx_syscall6(nr, addr, len, prot, flags, fd, off)
    let neg = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // mapped address (raw pointer word)
}

// ── ERRNO-BEARING CHAIN batch D — DIVERGENCE syscalls: open_sys + getrusage ──
//
// Two more errno-bearing leaves. Both share the close errno epilogue verbatim
// (raw-payload `__hx_payload_lt`/`_ne`/`_sub`, never bare `<`/`-`, +
// target_is_linux()-gated store via the already-whitelisted __errno_location).
// They differ only in CALL SHAPE — open_sys is the arm64 AT_FDCWD-prepend kind
// (a genuine per-arch arg-tuple divergence, exactly mirroring mkdir→mkdirat and
// stat→fstatat), getrusage is a plain uniform 2-arg (only the NR varies, like
// read/lseek/waitpid).
//
//   open_sys → arm64 has NO plain open; it uses openat(AT_FDCWD=-100, path,
//          flags, mode) — a 4-arg PREPEND divergence exactly like mkdir→mkdirat
//          and stat→fstatat. So the syscall is issued in per-arch branches (the
//          arm64 branch prepends AT_FDCWD, shifting path/flags/mode right by one),
//          then the shared epilogue runs on the result. x86_64 + darwin keep the
//          plain 3-arg open(path, flags, mode).
//          NR + AT_FDCWD ref-match (no black-box):
//            x86_64 __NR_open    = 2   (arch/x86 syscall_64.tbl;
//                                       stdlib/posix/linux_syscalls.hexa:116)
//            arm64  __NR_openat  = 56  (asm-generic unistd.h — plain "open"
//                                       dropped; linux_syscalls.hexa:83)
//            darwin SYS_OPEN     = 5   (xnu bsd/kern/syscalls.master; the BSD
//                                       trap OR-bakes 0x2000000 in __hx_syscall6)
//            AT_FDCWD = -100           (the same literal mkdir/stat use above;
//                                       self/rt/syscall.hexa:153,161)
//          open is errno-bearing (a bad path → -1 + ENOENT on the raw Linux
//          syscall, the uniform `-errno` convention). Named `hxlcl_open_sys`
//          rather than `hxlcl_open` to match the floor's open routing symbol and
//          avoid shadowing the higher-level open wrapper.
//
//   getrusage → a plain UNIFORM 2-arg (who, usage*) on every target — no
//          at-variant / no prepend, so only the NR differs, exactly like
//          read/lseek/waitpid. The 2nd arg is an OUT-pointer (the struct rusage*
//          the kernel fills), the same out-ptr shape as stat's statbuf.
//          NR ref-match (no black-box):
//            x86_64 __NR_getrusage = 98   (arch/x86 syscall_64.tbl)
//            arm64  __NR_getrusage = 165  (asm-generic unistd.h)
//            darwin SYS_GETRUSAGE  = 117  (xnu bsd/kern/syscalls.master)
//          errno-bearing: a bad `who` → -1 + EINVAL (getrusage(2): "EINVAL ...
//          who is invalid").
//
// DEFERRED to a later batch (honest — trickier divergence, not attempted here):
//   time    → arm64/darwin have NO plain time; they need gettimeofday(tv*,0) with
//             a DIFFERENT return semantics (gettimeofday writes a struct + returns
//             0, vs time returns the epoch seconds) — a return-value mismatch, not
//             just a NR/arg swap. (x86_64 time=201, arm64 gettimeofday=169.)
//   poll    → arm64 has NO plain poll; ppoll takes an EXTRA timespec* + sigmask +
//             sigsetsize (arg-COUNT divergence, not just a prepend).
//             (x86_64 poll=7, arm64 ppoll=73, darwin poll=230.)
//   pipe    → a 2nd-RETURN-register / int[2] out-array shape (the kernel returns
//             both fds), which the single-result __hx_syscall6 path doesn't expose
//             — a genuinely different lowering. (x86_64 pipe=22/pipe2=293, arm64
//             pipe2=59, darwin pipe=42.)

// open_sys: per-arch arg tuple (arm64 openat prepends AT_FDCWD, shifting
// path/flags/mode right by one — a genuine divergence, mirrors mkdir/stat). The
// result flows into the shared close-pattern errno epilogue.
pub fn hxlcl_open_sys(path: HexaVal, flags: HexaVal, mode: HexaVal) -> int {
    let mut r = 0
    if target_is_linux() {
        if target_is_x86_64() {
            r = __hx_syscall6(2, path, flags, mode, 0, 0, 0)        // x86_64 open(path, flags, mode)
        } else {
            r = __hx_syscall6(56, -100, path, flags, mode, 0, 0)    // arm64 openat(AT_FDCWD, path, flags, mode)
        }
    } else {
        r = __hx_syscall6(5, path, flags, mode, 0, 0, 0)            // darwin SYS_OPEN(path, flags, mode)
    }
    let neg = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // fd (>= 0)
}

// getrusage: plain uniform 2-arg (who, usage*); only the NR varies (no at-variant),
// like read/lseek. The 2nd arg is an out-ptr the kernel fills (stat-statbuf shape).
pub fn hxlcl_getrusage(who: HexaVal, usage: HexaVal) -> int {
    let mut nr = 117                           // Darwin SYS_GETRUSAGE (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 98 }      // Linux x86_64 __NR_getrusage
        else { nr = 165 }                      // Linux arm64 __NR_getrusage
    }
    let r = __hx_syscall6(nr, who, usage, 0, 0, 0, 0)
    let neg = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // 0 on success
}

// ── batch E: pipe (out-ptr int[2] — Linux DISSOLVES, darwin is the genuine wall) ─
//
// CENSUS CORRECTION (batch D deferred "pipe = 2nd-return-register"): that label
// conflated Linux and darwin. The Linux pipe ABI is an OUT-POINTER — the kernel
// WRITES both fds into the caller's int[2] buffer and returns 0/-errno (the same
// out-ptr shape as getrusage's usage* and stat's statbuf). The 2nd-return-register
// (r0/r1 dual-fd) divergence is DARWIN-ONLY (BSD pipe). So the Linux legs dissolve
// cleanly with the established close errno epilogue; only darwin is a real wall.
//
//   x86_64 / arm64-linux → pipe2(fds, flags=0). Using pipe2 (not the legacy
//          x86_64 pipe=22) gives a UNIFORM 2-arg shape on BOTH arches — arm64 has
//          NO plain pipe, only pipe2; x86_64 pipe2 takes the same (fds, flags).
//          This is the "flags-trailing uniform" pattern (exactly like dup2→dup3:
//          flags=0 trails, so one shape serves both arches, only the NR varies).
//          errno-bearing: a bad fds ptr / EMFILE → -1 + errno on the Linux leg.
//   darwin → SYS_pipe (42) returns the two fds in x0/x1 (2nd return register);
//          the single-result __hx_syscall6 exposes only x0. This DISSOLVES via the
//          __hx_syscall6_out2 intrinsic (the dual-return sibling that writes x0/x1
//          + the carry flag into a heap scratch — mirrors the floor _hxlcl_pipe_cf
//          dual-register asm shim, self/runtime_emit_full.hexa:1794). The darwin
//          carry-flag error → errno store is deferred (discipline ④).
//   NR ref-match (no black-box; WebFetch-confirmed 2026-06-27):
//     x86_64 __NR_pipe2 = 293  (arch/x86 syscall_64.tbl)
//     arm64  __NR_pipe2 = 59   (asm-generic unistd.h — no plain pipe/poll on arm64)
//     darwin SYS_pipe   = 42   (xnu; 2nd-return-reg, via __hx_syscall6_out2)
//
// time / poll: LANDED in batch H below (the scratch-buffer substrate the batch E
// census flagged turned out NOT to need a new intrinsic — see the batch H header).
pub fn hxlcl_pipe(fds: HexaVal) -> int {
    if target_is_linux() {
        let mut r = 0
        if target_is_x86_64() {
            r = __hx_syscall6(293, fds, 0, 0, 0, 0, 0)     // x86_64 pipe2(fds, flags=0)
        } else {
            r = __hx_syscall6(59, fds, 0, 0, 0, 0, 0)      // arm64 pipe2(fds, flags=0)
        }
        let neg = __hx_payload_lt(r, 0)
        if __hx_payload_ne(neg, 0) {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
            return -1
        }
        return r                                // 0 on success (kernel wrote fds[0],fds[1])
    }
    // darwin: BSD pipe(42) is a 2nd-return-register syscall — the kernel returns
    // the two fds in x0/x1 (NOT the user buffer). __hx_syscall6_out2 issues the
    // single trap and captures BOTH return regs + the carry/error flag into a
    // 24-byte heap scratch (3 slots: x0, x1, carry); we then copy the fds into the
    // caller's int[2]. (The scratch leaks 24B on the bump arena — pipe is not
    // hot-looped; same heap-scratch caveat as the batch-H time/poll legs.) The
    // darwin carry-flag error → errno store is DEFERRED (darwin __error() round,
    // discipline ④); on error we return -1 without setting errno.
    let szp = __hx_payload_add(0, 24)           // HexaVal-box the scratch size
    let scr = hxlcl_malloc(szp)
    __hx_syscall6_out2(42, 0, 0, 0, 0, 0, 0, scr)   // BSD pipe — no args; fds in x0/x1
    let cf = __hx_ptr_load64(scr, 16)
    if __hx_payload_ne(cf, 0) {
        return -1                               // darwin error (carry set); errno deferred
    }
    let fd0 = __hx_ptr_load64(scr, 0)           // x0 = fds[0]
    let fd1 = __hx_ptr_load64(scr, 8)           // x1 = fds[1]
    __hx_ptr_store32(fds, 0, fd0)               // fds[0]
    __hx_ptr_store32(fds, 4, fd1)               // fds[1] (int = 4 bytes)
    return 0
}

// ── batch H: time + poll (the SCRATCH-BUFFER substrate — NO new intrinsic) ──────
//
// SCRATCH-BUFFER CENSUS VERDICT (the batch-E deferral resolved): time and poll
// each have register-clean legs and ONE divergent leg that needs a small in-body
// struct buffer (timeval / timespec). The campaign has NO `__hx_stack_alloc`-class
// intrinsic (grep-clean: no addr-of / alloca / stack-slot leaf), so a TRUE in-body
// STACK scratch buffer is a substrate gap — it would need a new codegen builtin
// (the frozen-151c52c8-unsafe path the campaign forbids). BUT the buffer NEED is
// satisfiable with ZERO new intrinsics by reusing the already-whitelisted
// hxlcl_malloc as a HEAP scratch + the proven raw-ptr ops:
//   • hxlcl_malloc(16)        — inner C-ABI `bl` (ON-path-proven by strdup/calloc/
//                               realloc), returns a 16-byte raw region.
//   • __hx_ptr_store64(p,off,v) — write the synthesized struct fields (proven by
//                               strtoll's endptr store64).
//   • __hx_ptr_load64(p,off)   — read a struct field back (proven by realloc's
//                               negative-offset header read).
//   • __hx_payload_div/_mod/_mul — the ms→{sec,nsec} arithmetic (proven int-div
//                               leaves — x86_64_linux.hexa:2741 / arm64_darwin:2088).
// So the substrate is NOT a wall; the only thing genuinely missing (a true stack
// scratch) is an OPTIMIZATION, not a blocker. HONEST CAVEAT (recorded for the
// campaign SSOT): the heap-scratch leaks the 16-byte region per call on the
// arm64-linux divergent legs (hxlcl_malloc's bump arena has free=noop). For time
// that is negligible (every caller passes NULL and time() is never hot-looped),
// but hxlcl_poll IS hot-looped on a finite timeout (self/native/term_ffi_emit.hexa
// documents a "tight-looped hxlcl_poll → 36 GB RSS" history), so the arm64-linux
// finite-timeout ppoll leg accrues that per-call 16-byte leak — the ONE spot a
// true __hx_stack_alloc would be cleaner. Acceptable on this default-OFF research
// path (HEXA_CABI_HXLCL=1, never shipped); flagged, not papered over.
//
// In-body operator discipline (the #4042 rule) + un-nested lets throughout, same
// as the syscall family above. errno epilogue = the close discipline verbatim.

// hxlcl_time: return the epoch seconds (a la `time(NULL)`); if `t` is non-NULL also
// write `*t = (int)sec` (NULL-gated, like strtoll's endptr). BYTE-FAITHFUL to the
// floor shim runtime_core_hxlcl_shim.c:560 (`int hxlcl_time(int *t){ time_t r =
// time(NULL); if(t) *t=(int)r; return (int)r; }`) — every caller in the runtime
// passes NULL (`hxlcl_time(NULL)`), so the out-param write is exercised only for
// faithfulness. The `int` return carries the low 32 bits of the epoch (matching the
// floor's `(int)r`; valid until 2038, the same window as the int-typed floor).
//
// PER-TARGET (compile-time target_is_* consts → DCE drops the dead legs):
//   x86_64-linux : time(201) — REGISTER-CLEAN: the kernel returns the epoch in the
//                  result reg; NO buffer. (Passing tloc=0/NULL to the syscall, then
//                  doing the int-width *t store OURSELVES — the kernel would write 8
//                  bytes (time_t) into a 4-byte int* t, so we never hand it `t`.)
//   arm64-linux  : NO __NR_time (asm-generic dropped it); gettimeofday(169, &tv,
//                  NULL) writes timeval{tv_sec,tv_usec}; read tv_sec at offset 0.
//   darwin       : NO BSD `time` trap; gettimeofday(116, &tv, NULL) (the floor's
//                  hxlcl_clock_gettime uses the same syscall, runtime_emit_full:1983);
//                  read tv_sec. (__hx_syscall6 issues `svc #0x80` with the bare BSD
//                  NR — no 0x2000000 OR on arm64, like getrusage=117.)
// NR ref-match (no black-box): x86_64 time=201 (arch/x86 syscall_64.tbl) · arm64
// gettimeofday=169 / darwin gettimeofday=116 (asm-generic unistd.h __NR_gettimeofday
// 169 · runtime_emit_full.hexa:1943 HXLCL_SYS_GETTIMEOFDAY 116).
pub fn hxlcl_time(t: HexaVal) -> int {
    let pt = __hx_payload_add(t, 0)            // int* t (raw, may be NULL)
    if target_is_linux() {
        if target_is_x86_64() {
            let r = __hx_syscall6(201, 0, 0, 0, 0, 0, 0)   // time(NULL) → epoch in result reg
            if __hx_payload_ne(pt, 0) {
                __hx_ptr_store32(pt, 0, r)     // *t = (int)epoch
            }
            return r
        }
        // arm64-linux: gettimeofday(&tv, NULL); tv_sec at offset 0.
        // hxlcl_malloc's declared param is `HexaVal` (the C-ABI lowering is at the
        // call boundary, but the TYPE-CHECK is on the signature), so a bare i64 `16`
        // mismatches. Box it via __hx_payload_add(0,16) → HexaVal{TAG_INT,16} — the
        // exact close/strtoll `__hx_payload_sub(0, x)` shape (the __hx_payload_*
        // intrinsics accept i64 literals and return HexaVal, unlike a declared
        // extern fn). strdup/calloc pass HexaVal the same way (cap=__hx_payload_add,
        // total=__hx_payload_mul). The malloc result is `int` (raw ptr word), fed
        // straight to the raw-ptr intrinsics like strdup/calloc do.
        let szl = __hx_payload_add(0, 16)      // HexaVal-box the scratch size
        let buf = hxlcl_malloc(szl)            // scratch timeval (heap — see header)
        __hx_syscall6(169, buf, 0, 0, 0, 0, 0) // gettimeofday(&tv, NULL)
        let sec = __hx_ptr_load64(buf, 0)      // tv.tv_sec
        if __hx_payload_ne(pt, 0) {
            __hx_ptr_store32(pt, 0, sec)
        }
        return sec
    }
    // darwin: gettimeofday(&tv, NULL); tv_sec at offset 0. Same HexaVal-box of the
    // literal size as the arm64-linux leg above (hxlcl_malloc expects HexaVal).
    let szd = __hx_payload_add(0, 16)
    let buf = hxlcl_malloc(szd)
    __hx_syscall6(116, buf, 0, 0, 0, 0, 0)
    let sec = __hx_ptr_load64(buf, 0)
    if __hx_payload_ne(pt, 0) {
        __hx_ptr_store32(pt, 0, sec)
    }
    return sec
}

// hxlcl_poll: wait for events on `fds` (nfds pollfds) up to `timeout` ms; return
// the ready count (0 on timeout) or -1 + errno. BYTE-FAITHFUL to the floor
// (runtime_emit_full.hexa:2042 `poll((struct pollfd*)fds,(nfds_t)nfds,timeout)`).
// `nfds` is an `unsigned int` passed raw — every C caller zero-extends it (a 32-bit
// `mov` clears the upper word), exactly like read/write pass `unsigned long n` raw.
//
// PER-TARGET (compile-time target_is_* consts → DCE):
//   x86_64-linux : poll(7)   — plain 3-arg (fds, nfds, timeout_ms). REGISTER-CLEAN.
//   darwin       : poll(230) — plain 3-arg, same shape (bare BSD NR, `svc #0x80`).
//   arm64-linux  : NO __NR_poll (asm-generic dropped it); ppoll(73, fds, nfds,
//                  &ts | NULL, sigmask=NULL, sigsetsize=8). The C `int timeout` (ms)
//                  is SYNTHESIZED into a timespec: timeout<0 → tmo=NULL (block
//                  forever); else {tv_sec = ms/1000, tv_nsec = (ms%1000)*1e6}. This
//                  is the divergent leg that needs the scratch buffer (see header).
//                  (sigmask NULL ⇒ the kernel ignores sigsetsize, but 8 = _NSIG/8 is
//                  the canonical value glibc passes.)
// NR + arg-shape ref-match (no black-box): x86_64 poll=7 / darwin poll=230
// (syscall_64.tbl · runtime_emit_full.hexa:1369 HXLCL_SYS_POLL 230) · arm64 ppoll=73
// (asm-generic unistd.h __NR_ppoll — no plain poll on arm64) · ppoll signature
// (fds,nfds,tmo_p,sigmask,sigsetsize) = man ppoll(2). The errno epilogue is the
// close discipline verbatim (Linux returns -errno; darwin carry-flag deferred).
pub fn hxlcl_poll(fds: HexaVal, nfds: HexaVal, timeout: HexaVal) -> int {
    let mut r = 0
    if target_is_linux() {
        if target_is_x86_64() {
            r = __hx_syscall6(7, fds, nfds, timeout, 0, 0, 0)    // poll(fds, nfds, timeout_ms)
        } else {
            // arm64-linux: ppoll(fds, nfds, &ts | NULL, sigmask=NULL, sigsetsize=8).
            let neg = __hx_payload_lt(timeout, 0)
            if __hx_payload_ne(neg, 0) {
                r = __hx_syscall6(73, fds, nfds, 0, 0, 8, 0)     // timeout<0 → tmo=NULL (infinite)
            } else {
                let szp = __hx_payload_add(0, 16)                // HexaVal-box the scratch size (malloc expects HexaVal)
                let ts = hxlcl_malloc(szp)                       // scratch timespec (heap — see header)
                let sec = __hx_payload_div(timeout, 1000)        // ms / 1000  → tv_sec
                let rem = __hx_payload_mod(timeout, 1000)        // ms % 1000
                let nsec = __hx_payload_mul(rem, 1000000)        // → tv_nsec (nanoseconds)
                __hx_ptr_store64(ts, 0, sec)                     // ts.tv_sec
                __hx_ptr_store64(ts, 8, nsec)                    // ts.tv_nsec
                r = __hx_syscall6(73, fds, nfds, ts, 0, 8, 0)
            }
        }
    } else {
        r = __hx_syscall6(230, fds, nfds, timeout, 0, 0, 0)      // darwin poll(fds, nfds, timeout_ms)
    }
    let neg2 = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg2, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // ready count (0 on timeout)
}

// ── batch I: clock_gettime + execve (clean syscall leaves) ─────────────────────
//
// Two more errno-bearing leaves continuing the close-mirror discipline (raw-payload
// `__hx_payload_lt`/`_ne`/`_sub`, never bare `<`/`-`, + the target_is_linux()-gated
// errno store via the already-whitelisted __errno_location). Both reuse the proven
// patterns from earlier batches:
//   clock_gettime → getrusage's OUT-PTR shape (the caller's timespec* the kernel
//        fills). UNIFORM 2-arg on Linux (only the NR varies, x86_64=228/arm64=113),
//        like read/lseek/getrusage. Darwin has NO clock_gettime trap (it is a
//        commpage/vDSO routine with no stable BSD syscall number — confirmed by the
//        floor self/runtime_emit_full.hexa:1977 which uses gettimeofday(116)), so
//        the darwin leg synthesizes a timespec from gettimeofday(116) — the batch-H
//        time/poll gettimeofday pattern, but writing the timespec DIRECTLY into the
//        caller's out-ptr (leak-free, no heap scratch — clock_gettime is often hot-
//        looped in timing loops, so the time/poll per-call heap leak is avoided).
//   execve → plain 3-arg (path, argv, envp). Only the NR diverges on arm64
//        (x86_64=59/arm64=221/darwin=59) — NO arg-shape change (no AT_FDCWD prepend,
//        no flags-trailing), the read/lseek/getrusage uniform-NR class. execve only
//        returns ON FAILURE (success replaces the process image), so the errno
//        epilogue is the whole story: a bad path → -1 + ENOENT on the raw Linux
//        syscall (the uniform -errno convention).
//
// NR ref-match (no black-box; in-repo tables + WebFetch-confirmed asm-generic):
//   clock_gettime  x86_64 = 228  (arch/x86 syscall_64.tbl; self/rt/syscall.hexa:79
//                                 SYS_LINUX_CLOCK_GETTIME)
//                  arm64  = 113  (asm-generic unistd.h __NR_clock_gettime)
//                  darwin =  —   (no trap → gettimeofday(116), self/runtime_emit_full
//                                 .hexa:1943 HXLCL_SYS_GETTIMEOFDAY 116)
//   execve         x86_64 =  59  (arch/x86 syscall_64.tbl; syscall.hexa:75
//                                 SYS_LINUX_EXECVE)
//                  arm64  = 221  (asm-generic unistd.h __NR_execve)
//                  darwin =  59  (xnu bsd/kern/syscalls.master; runtime_emit_full
//                                 .hexa:1375 HXLCL_SYS_EXECVE — bare BSD trap)
//
// DEFERRED to batch J (honest — measured darwin wall + smoke complexity, not done
// here):
//   fork → arm64 has NO plain fork; it uses clone(220, SIGCHLD=17, 0,0,0,0) — and
//          because every clone arg past `flags` is 0, the CONFIG_CLONE_BACKWARDS
//          arg-order divergence is MOOT (only flags is non-zero), so the LINUX legs
//          dissolve cleanly (x86_64 fork=57 / arm64 clone=220). BUT darwin fork(2)
//          is a 2nd-RETURN-REGISTER syscall: it returns the child pid in x0 for BOTH
//          processes and disambiguates the child by x1==1 (confirmed by the floor
//          self/runtime_emit_full.hexa:1795-1808 _cf-style dual-register capture).
//          The single-result __hx_syscall6 exposes only x0, so the Route C darwin
//          leg CANNOT tell parent from child — a genuine wall identical to darwin
//          pipe (the real darwin fork stays the floor's raw-asm dual-reg shim). On
//          top of that the SMOKE harness for fork must actually fork+_exit+waitpid a
//          live process (vs the composition tests here), so batch J carries fork
//          alone with its own careful process-fork harness.

// clock_gettime: out-ptr timespec (getrusage shape). Linux = uniform 2-arg, kernel
// writes *ts; only the NR varies per-arch. darwin = no trap → synthesize from
// gettimeofday(116) directly into the caller's ts (leak-free).
pub fn hxlcl_clock_gettime(clk: HexaVal, ts: HexaVal) -> int {
    if target_is_linux() {
        let mut nr = 113                       // Linux arm64 __NR_clock_gettime
        if target_is_x86_64() { nr = 228 }     // Linux x86_64 __NR_clock_gettime
        let r = __hx_syscall6(nr, clk, ts, 0, 0, 0, 0)
        let neg = __hx_payload_lt(r, 0)
        if __hx_payload_ne(neg, 0) {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
            return -1
        }
        return r                                // 0 on success (kernel wrote *ts)
    }
    // darwin: no clock_gettime trap → gettimeofday(116, ts, NULL) writes a timeval
    // {tv_sec @0 (8B), tv_usec @8 (32-bit suseconds_t)} INTO the caller's timespec
    // buffer; convert to timespec {tv_sec @0, tv_nsec @8 (64-bit) = usec*1000} in
    // place. The store64 of nsec overwrites the 32-bit usec slot AND the trailing 4
    // garbage bytes (timeval is 12B, timespec is 16B). NULL-gated: clock_gettime
    // with a NULL ts is meaningless, and we cannot gettimeofday into NULL. The
    // load32 reads exactly the 32-bit usec (zero-extended) — no zero-init needed.
    let pts = __hx_payload_add(ts, 0)          // timespec* ts (raw, may be NULL)
    if __hx_payload_ne(pts, 0) {
        __hx_syscall6(116, pts, 0, 0, 0, 0, 0) // gettimeofday(ts, NULL)
        let usec = __hx_ptr_load32(pts, 8)     // tv_usec (32-bit, zero-extended)
        let nsec = __hx_payload_mul(usec, 1000)
        __hx_ptr_store64(pts, 8, nsec)         // ts.tv_nsec = usec * 1000
    }
    return 0
}

// execve: plain 3-arg (path, argv, envp); only the NR diverges on arm64. Returns
// ONLY on failure (success replaces the process), so the errno epilogue is the
// whole body. Linux failure → -1 + errno; darwin returns the raw positive errno
// (carry-flag not read — the documented deferred darwin errno path).
pub fn hxlcl_execve(path: HexaVal, argv: HexaVal, envp: HexaVal) -> int {
    let mut nr = 59                            // darwin SYS_execve / x86_64 default
    if target_is_linux() {
        if target_is_x86_64() { nr = 59 }      // Linux x86_64 __NR_execve
        else { nr = 221 }                      // Linux arm64 __NR_execve
    }
    let r = __hx_syscall6(nr, path, argv, envp, 0, 0, 0)
    let neg = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // unreachable on success (image replaced)
}

// ── batch J: fork (clean syscall family LAST leaf) ─────────────────────────────
//
// fork() = the 0-arg process clone — the final clean errno-bearing syscall leaf
// closing the Route C syscall family. Continues the close-mirror discipline (raw-
// payload `__hx_payload_lt`/`_ne`/`_sub`, never bare `<`/`-`, + the target_is_linux()
// -gated errno store via the already-whitelisted __errno_location). It is the EXACT
// pipe (#4076) pattern: the LINUX legs DISSOLVE via the single-result __hx_syscall6,
// and the darwin 2nd-return-register leg DISSOLVES via __hx_syscall6_out2 (the
// dual-return intrinsic capturing x0/x1 + carry).
//
//   LINUX dissolve — fork returns the child pid to the parent and 0 to the child in
//        a SINGLE result register (rax/x0), uniform -errno on failure, so the close
//        errno epilogue is the whole story. The NR (and the arm64 arg-shape) diverge:
//          x86_64 → __NR_fork = 57, plain 0-arg.
//          arm64  → has NO plain fork; the asm-generic ABI provides only clone, so
//                   fork is clone(220, flags = SIGCHLD = 17, 0,0,0,0). Because EVERY
//                   clone arg past `flags` is 0, the CONFIG_CLONE_BACKWARDS arg-order
//                   divergence (stack/parent_tid/child_tid/tls ordering) is MOOT —
//                   only `flags` is non-zero, so the order of the trailing zeros is
//                   irrelevant. SIGCHLD=17 = the child-exit signal that makes the
//                   clone behave as a fork (parent gets SIGCHLD on child exit). This
//                   is the dup2→dup3 "extra-flag-arg" divergence class (batch's
//                   established pattern), not a new arg-shape.
//   DARWIN dissolve — fork(2) is a 2nd-RETURN-REGISTER syscall: the BSD trap returns
//        the child pid in x0 for BOTH processes and disambiguates the child by x1==1
//        (parent has x1==0; carry-set → failure). This DISSOLVES via the
//        __hx_syscall6_out2 intrinsic, which captures x0/x1 + the carry flag into a
//        heap scratch — mirroring the floor's raw-asm dual-register shim
//        (self/runtime_emit_full.hexa:1801-1808, the `cset cf,cs / mov x0 / mov x1`
//        explicit-asm dual capture). The darwin carry-flag error → errno store is
//        deferred (discipline ④). default-OFF so the floor shim is the live darwin
//        fork — Route C darwin is research-only.
//
// NR ref-match (no black-box; in-repo tables + WebFetch-confirmed asm-generic):
//   fork  x86_64 = 57   (arch/x86 syscall_64.tbl; self/rt/syscall.hexa:74
//                        SYS_LINUX_FORK -> 57)
//         arm64  = 220  (no plain fork → __NR_clone; uapi/asm-generic/unistd.h
//                        `#define __NR_clone 220`, WebFetch-confirmed) flags=SIGCHLD=17
//         darwin = 2    (BSD SYS_fork; self/rt/syscall.hexa:103 SYS_DARWIN_FORK ->
//                        0x2000002 — 2nd-return-reg wall, floor dual-reg shim only)
//
// _is_cabi has hxlcl_fork (#4087). The darwin leg adds ONE new ADD-only intrinsic
// __hx_syscall6_out2 (the dual-return sibling — bind.hexa whitelist + arm64/x86_64
// STMT_CALL special-case; NO new parser keyword/@attr, so frozen 151c52c8 immutable).
// Otherwise reuses __hx_payload_eq/_ne/_add + __hx_ptr_load64/store32 + hxlcl_malloc.
// default-OFF byteeq-neutral (HEXA_CABI_HXLCL unset → empty whitelist → PAIR-MODEL
// emit byte-identical; the new intrinsic only emits when a whitelisted body calls it).
//
// With the darwin 2nd-return-register dissolve, the Route C syscall family is dry
// (remaining walls: stdio FILE* struct, getenv frozen-export, TERMINAL [float
// XMM-ABI / setjmp]).
pub fn hxlcl_fork() -> int {
    if target_is_linux() {
        let mut nr = 220                       // Linux arm64 __NR_clone (no plain fork)
        let mut a1 = 17                        //   clone flags = SIGCHLD (child-exit signal)
        if target_is_x86_64() {
            nr = 57                            // Linux x86_64 __NR_fork
            a1 = 0                             //   plain fork: no clone arg
        }
        let r = __hx_syscall6(nr, a1, 0, 0, 0, 0, 0)
        let neg = __hx_payload_lt(r, 0)
        if __hx_payload_ne(neg, 0) {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
            return -1
        }
        return r                                // parent: child pid · child: 0
    }
    // darwin: fork(2) is a 2nd-return-register syscall — both processes get the
    // child pid in x0; the CHILD is disambiguated by x1==1 (parent has x1==0).
    // __hx_syscall6_out2 captures x0/x1/carry into a 24-byte heap scratch (leaks
    // 24B — fork is not hot-looped). This mirrors the floor's raw-asm dual-register
    // shim (self/runtime_emit_full.hexa:1801-1808: `svc; cset cf,cs; mov x0; mov
    // x1; if cf errno; if x1==1 child`). The darwin carry-flag error → errno store
    // is DEFERRED (darwin __error() round, discipline ④); on error we return -1.
    let szf = __hx_payload_add(0, 24)           // HexaVal-box the scratch size
    let scr = hxlcl_malloc(szf)
    __hx_syscall6_out2(2, 0, 0, 0, 0, 0, 0, scr)    // BSD fork — no args; x0=pid, x1==1 ⇒ child
    let cf = __hx_ptr_load64(scr, 16)
    if __hx_payload_ne(cf, 0) {
        return -1                               // darwin error (carry set); errno deferred
    }
    let x1v = __hx_ptr_load64(scr, 8)           // x1: ==1 in child, 0 in parent
    let ischild = __hx_payload_eq(x1v, 1)
    if __hx_payload_ne(ischild, 0) {
        return 0                                // child
    }
    let x0v = __hx_ptr_load64(scr, 0)           // x0 = child pid
    return x0v                                   // parent: child pid
}
