pub fn hxlcl_getegid() -> int {
    let mut nr = 43                            // Darwin SYS_GETEGID (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 108 }     // Linux x86_64 __NR_getegid
        else { nr = 177 }                      // Linux arm64 __NR_getegid
