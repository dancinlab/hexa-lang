    let mut nr = 47                            // Darwin SYS_GETGID (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 104 }     // Linux x86_64 __NR_getgid
        else { nr = 176 }                      // Linux arm64 __NR_getgid
    }
