// stdlib/runtime/hxlcl_core.hexa — RFC061 §M8 Route C libc-floor C-ABI SSOT.
//
// The hexa-source raw-mem bodies for the libc-floor substrate symbols
// `hxlcl_strlen` (`size_t hxlcl_strlen(const char*)`), `hxlcl_memcpy`
// (`void *hxlcl_memcpy(void*,const void*,size_t)`) and `hxlcl_memset`
// (`void *hxlcl_memset(void*,int,size_t)`), emitted through the
// compiler's portable `aprime_cc --emit=asm --target=` cross-target path under
// the Route C C-ABI calling-convention gate (HEXA_CABI_HXLCL=1 · _is_cabi in
// compiler/codegen/x86_64_linux.hexa + arm64_darwin.hexa).
//
// WHY A SEPARATE FILE (not str_core.hexa): str_core's prims are HexaVal-ABI
// (their C wrappers pass real TAG_STR HexaVals). hxlcl_* are the OPPOSITE layer —
// raw C-ABI, called with a bare `char*` register throughout the frozen C runtime
// amalgam (self/runtime_core.c, runtime_core_hxlcl_shim.c). The Route C ingress
// lands that single arg register as this fn's param PAYLOAD with TAG_INT(0), and
// the Route C return ships the count back in a SINGLE result register — so the
// body below is byte-walk-identical to str_core, only the ABI boundary differs.
//
// RAW-MEM, un-nested (str_core NESTING finding): every __hx_payload_* /
// __hx_ptr_* call writes EXACTLY ONE `let` — no nested intrinsic args (a native
// codegen scratch clobber corrupts the outer op otherwise). Comparison uses the
// raw-int leaf intrinsics (__hx_payload_ne), NOT plain `==`/`!=` (those lower to
// HexaVal runtime helpers that misread the raw byte words). __hx_ptr_load8 reads
// one byte ZERO-EXTENDED into a TAG_INT payload, so the 0x00 NUL compares as 0.
//
// BYTE-FAITHFUL to the C body it replaces (runtime_core_hxlcl_shim.c:212):
//   size_t hxlcl_strlen(const char *s){ if(!s) return 0; size_t n=0;
//                                       while(s[n]) n++; return n; }
// (the NULL guard is the caller's responsibility on this PoC path — the frozen
// runtime never calls hxlcl_strlen with NULL; same precondition the SELFEMIT
// hand-assembled seeds in test/native_build/emit_hxlcl_strlen_*.hexa carry.)
//
// NOT @pure: the body touches external buffer memory through __hx_ptr_load8.

// hxlcl_strlen: count bytes up to (not including) the NUL terminator. Under the
// Route C C-ABI gate the param arrives raw in rdi/x0 and the return ships the
// count raw in rax/x0; under the default (PAIR-MODEL, gate OFF) it compiles as an
// ordinary HexaVal fn (byteeq-neutral — never linked into the runtime in that
// mode).
pub fn hxlcl_strlen(s: HexaVal) -> int {
    let p = __hx_payload_add(s, 0)            // char* (payload word)
    let mut n = 0
    let mut c = __hx_ptr_load8(p, 0)          // s[0]
    while __hx_payload_ne(c, 0) {
        n = __hx_payload_add(n, 1)
        c = __hx_ptr_load8(p, n)              // s[n]
    }
    return n
}

// BYTE-FAITHFUL to the C body it replaces (self/runtime.c:586, rt_memcpy 32 B):
//   void *hxlcl_memcpy(void *dst, const void *src, size_t n){
//       unsigned char *d=dst; const unsigned char *s=src;
//       for(size_t i=0;i<n;i++) d[i]=s[i]; return dst; }
// Three raw C-ABI args (dst,src,n) arrive in rdi/rsi/rdx (x0/x1/x2); the return
// ships the dst pointer raw in rax/x0. (n==0 → the while never enters, exactly
// like the C for-loop; the frozen runtime never calls memcpy with NULL/overlap —
// same precondition as hxlcl_strlen and the SELFEMIT hand-assembled seed
// test/native_build/emit_hxlcl_memcpy_o.hexa.) Forward byte copy only — overlap
// is hxlcl_memmove's job, never aliased onto this symbol.
//
// RAW-MEM, un-nested (same str_core NESTING rule as hxlcl_strlen above): every
// __hx_payload_* / __hx_ptr_* call writes EXACTLY ONE `let`/assignment with no
// nested intrinsic args. __hx_payload_lt(i, n) tests the raw payload words (NOT
// `<`, which lowers to a HexaVal helper that misreads the raw byte words);
// __hx_ptr_load8 reads one byte ZERO-EXTENDED into a TAG_INT payload and
// __hx_ptr_store8 writes the low byte of that payload back to dst[i].

// hxlcl_memcpy: copy `n` bytes src→dst (forward), return dst. Under the Route C
// C-ABI gate the params arrive raw in rdi,rsi,rdx / x0,x1,x2 and the return ships
// the dst pointer raw in rax/x0; under the default (PAIR-MODEL, gate OFF) it
// compiles as an ordinary HexaVal fn (byteeq-neutral — never linked in that mode).
pub fn hxlcl_memcpy(dst: HexaVal, src: HexaVal, n: HexaVal) -> int {
    let pd = __hx_payload_add(dst, 0)         // dst char* (payload word)
    let ps = __hx_payload_add(src, 0)         // src char* (payload word)
    let mut i = 0
    while __hx_payload_lt(i, n) {
        let b = __hx_ptr_load8(ps, i)         // src[i]
        __hx_ptr_store8(pd, i, b)             // dst[i] = src[i]
        i = __hx_payload_add(i, 1)
    }
    return pd
}

// BYTE-FAITHFUL to the C body it replaces (self/runtime.c:613, rt_memset 28 B):
//   void *hxlcl_memset(void *s, int c, size_t n){
//       unsigned char *p=s; unsigned char v=(unsigned char)c;
//       for(size_t i=0;i<n;i++) p[i]=v; return s; }
// Three raw C-ABI args (s,c,n) arrive in rdi/rsi/rdx (x0/x1/x2); the return ships
// the dst pointer raw in rax/x0. (n==0 → the while never enters, exactly like the
// C for-loop; the frozen runtime never calls memset with NULL — same precondition
// as hxlcl_memcpy and the SELFEMIT hand-assembled seed
// test/native_build/emit_hxlcl_memset_o.hexa, whose `strb w1,[x0,x3]` loop writes
// only the LOW byte of the c register — identical to the C `(unsigned char)c`.)
//
// RAW-MEM, un-nested (same str_core NESTING rule): every __hx_payload_* /
// __hx_ptr_* call writes EXACTLY ONE `let`/assignment with no nested intrinsic
// args. __hx_payload_lt(i, n) tests the raw payload words (NOT `<`, which lowers
// to a HexaVal helper that misreads the raw byte words); __hx_ptr_store8 writes
// the LOW byte of the c payload to s[i] (the `(unsigned char)c` truncation).

// hxlcl_memset: write the low byte of `c` into `n` bytes of `s`, return s. Under
// the Route C C-ABI gate the params arrive raw in rdi,rsi,rdx / x0,x1,x2 and the
// return ships the s pointer raw in rax/x0; under the default (PAIR-MODEL, gate
// OFF) it compiles as an ordinary HexaVal fn (byteeq-neutral — never linked in
// that mode).
pub fn hxlcl_memset(s: HexaVal, c: HexaVal, n: HexaVal) -> int {
    let ps = __hx_payload_add(s, 0)           // s char* (payload word)
    let mut i = 0
    while __hx_payload_lt(i, n) {
        __hx_ptr_store8(ps, i, c)             // s[i] = (unsigned char)c
        i = __hx_payload_add(i, 1)
    }
    return ps
}

// ── COMPARE FAMILY (Route C r5 · pure byte-walk, no syscall/float/composite) ──
//
// The compare leaves return an `int` derived from a byte difference; the C bodies
// (runtime_core_hxlcl_shim.c + self/runtime.c) all compute
//   (int)(unsigned char)pa[i] - (int)(unsigned char)pb[i]
// at the first mismatch, else 0/the terminator rule. The Route C ingress lands
// each raw pointer/length arg as a TAG_INT(0) payload; __hx_ptr_load8 reads ONE
// byte ZERO-EXTENDED (so the 0..255 byte compares as itself, matching the C
// `(unsigned char)` cast), and __hx_payload_sub computes the signed difference
// shipped raw in rax/x0. Reference-checked byte-for-byte against the SELFEMIT
// arm64 seeds (test/native_build/emit_hxlcl_{memcmp,strcmp,strncmp,strchr}_o.hexa,
// each `subs w6,w4,w5` / `ldrb` verbatim from self/codegen/runtime_arm64.hexa).
//
// RAW-MEM, un-nested (same str_core NESTING rule as the mem leaves above): every
// __hx_payload_* / __hx_ptr_* call writes EXACTLY ONE `let`/assignment with no
// nested intrinsic args. Comparisons use raw-int leaf intrinsics
// (__hx_payload_lt / __hx_payload_ne), NOT `<`/`!=` (those lower to HexaVal
// helpers that misread the raw byte words).

// hxlcl_memcmp: compare n bytes a vs b; return first signed byte diff, else 0.
// BYTE-FAITHFUL to runtime_core_hxlcl_shim.c:188 (hxlcl_memcmp) /
// self/runtime.c rt_memcmp: for(i<n){ d=(int)pa[i]-(int)pb[i]; if(d) return d; } 0.
pub fn hxlcl_memcmp(a: HexaVal, b: HexaVal, n: HexaVal) -> int {
    let pa = __hx_payload_add(a, 0)           // a char* (payload word)
    let pb = __hx_payload_add(b, 0)           // b char* (payload word)
    let mut i = 0
    while __hx_payload_lt(i, n) {
        let ca = __hx_ptr_load8(pa, i)        // (unsigned char)a[i]
        let cb = __hx_ptr_load8(pb, i)        // (unsigned char)b[i]
        let d = __hx_payload_sub(ca, cb)      // (int)ca - (int)cb
        if __hx_payload_ne(d, 0) {
            return d
        }
        i = __hx_payload_add(i, 1)
    }
    return 0
}

// hxlcl_strcmp: compare NUL-terminated a vs b; first signed byte diff, else 0.
// BYTE-FAITHFUL to runtime_core_hxlcl_shim.c:231 (hxlcl_strcmp) /
// self/runtime.c rt_strcmp: for(i;;i++){ ca=a[i]; cb=b[i];
//   if(ca!=cb) return ca-cb; if(ca==0) return 0; }.
pub fn hxlcl_strcmp(a: HexaVal, b: HexaVal) -> int {
    let pa = __hx_payload_add(a, 0)
    let pb = __hx_payload_add(b, 0)
    let mut i = 0
    while true {
        let ca = __hx_ptr_load8(pa, i)        // (unsigned char)a[i]
        let cb = __hx_ptr_load8(pb, i)        // (unsigned char)b[i]
        let d = __hx_payload_sub(ca, cb)
        if __hx_payload_ne(d, 0) {
            return d
        }
        if __hx_payload_eq(ca, 0) {
            return 0
        }
        i = __hx_payload_add(i, 1)
    }
    return 0
}

// hxlcl_strncmp: compare up to n bytes of NUL-terminated a vs b.
// BYTE-FAITHFUL to runtime_core_hxlcl_shim.c:251 (hxlcl_strncmp): for(i<n){
//   ca=a[i]; cb=b[i]; if(ca!=cb) return ca-cb; if(ca==0) return 0; } 0.
pub fn hxlcl_strncmp(a: HexaVal, b: HexaVal, n: HexaVal) -> int {
    let pa = __hx_payload_add(a, 0)
    let pb = __hx_payload_add(b, 0)
    let mut i = 0
    while __hx_payload_lt(i, n) {
        let ca = __hx_ptr_load8(pa, i)
        let cb = __hx_ptr_load8(pb, i)
        let d = __hx_payload_sub(ca, cb)
        if __hx_payload_ne(d, 0) {
            return d
        }
        if __hx_payload_eq(ca, 0) {
            return 0
        }
        i = __hx_payload_add(i, 1)
    }
    return 0
}

// ── COPY FAMILY (Route C r6 · pure byte-copy, returns the dst pointer raw) ──
//
// The copy leaves return the dst `char*` (shipped raw in rax/x0 under Route C —
// the `int` return type carries the raw pointer word, never boxed). Each writes
// the NUL terminator the C body writes; __hx_ptr_load8 reads ZERO-EXTENDED and
// __hx_ptr_store8 writes the low byte. Reference-matched against the SELFEMIT
// arm64 seeds (test/native_build/emit_hxlcl_{strcpy,strncpy,strcat}_o.hexa,
// verbatim from self/codegen/runtime_arm64.hexa). Same un-nested raw-mem rule.

// hxlcl_strcpy: copy NUL-terminated src→dst (incl. terminator), return dst.
// BYTE-FAITHFUL to runtime_core_hxlcl_shim.c:272 (hxlcl_strcpy):
//   i=0; while(src[i]){ dst[i]=src[i]; i++; } dst[i]='\0'; return dst.
pub fn hxlcl_strcpy(dst: HexaVal, src: HexaVal) -> int {
    let pd = __hx_payload_add(dst, 0)
    let ps = __hx_payload_add(src, 0)
    let mut i = 0
    let mut c = __hx_ptr_load8(ps, 0)         // src[0]
    while __hx_payload_ne(c, 0) {
        __hx_ptr_store8(pd, i, c)             // dst[i] = src[i]
        i = __hx_payload_add(i, 1)
        c = __hx_ptr_load8(ps, i)             // src[i]
    }
    __hx_ptr_store8(pd, i, 0)                 // dst[i] = '\0'
    return pd
}

// hxlcl_strncpy: copy up to n bytes of src→dst, NUL-pad the remainder, return dst.
// BYTE-FAITHFUL to runtime_core_hxlcl_shim.c:290 (hxlcl_strncpy):
//   i=0; for(;i<n && src[i];i++) dst[i]=src[i]; for(;i<n;i++) dst[i]='\0'; ret dst.
pub fn hxlcl_strncpy(dst: HexaVal, src: HexaVal, n: HexaVal) -> int {
    let pd = __hx_payload_add(dst, 0)
    let ps = __hx_payload_add(src, 0)
    // Phase 1: copy src bytes while i<n and src[i]!=0. `stop` carries the C
    // body's preserved `i` across the two for-loops (no rescan — untouched dst
    // bytes are not yet zeroed, so re-deriving the boundary by reading dst is
    // unsound).
    let mut i = 0
    let mut stop = n
    let mut c = __hx_ptr_load8(ps, 0)         // src[0]
    while __hx_payload_lt(i, n) {
        if __hx_payload_eq(c, 0) {
            stop = i                          // src exhausted at i
            i = n                             // break the copy loop
        }
        if __hx_payload_lt(i, n) {
            __hx_ptr_store8(pd, i, c)         // dst[i] = src[i]
            i = __hx_payload_add(i, 1)
            c = __hx_ptr_load8(ps, i)         // src[i]
        }
    }
    // Phase 2: NUL-pad dst[stop..n).
    let mut j = stop
    while __hx_payload_lt(j, n) {
        __hx_ptr_store8(pd, j, 0)             // dst[j] = '\0'
        j = __hx_payload_add(j, 1)
    }
    return pd
}

// hxlcl_strcat: append NUL-terminated src to the end of dst, return dst.
// BYTE-FAITHFUL to runtime_core_hxlcl_shim.c:308 (hxlcl_strcat):
//   p=dst; while(*p) p++; i=0; while(src[i]){ p[i]=src[i]; i++; } p[i]='\0'; ret dst.
pub fn hxlcl_strcat(dst: HexaVal, src: HexaVal) -> int {
    let pd = __hx_payload_add(dst, 0)
    let ps = __hx_payload_add(src, 0)
    let mut e = 0
    let mut ce = __hx_ptr_load8(pd, 0)        // dst[0] — scan to NUL
    while __hx_payload_ne(ce, 0) {
        e = __hx_payload_add(e, 1)
        ce = __hx_ptr_load8(pd, e)            // dst[e]
    }
    let mut i = 0
    let mut c = __hx_ptr_load8(ps, 0)         // src[0]
    while __hx_payload_ne(c, 0) {
        let off = __hx_payload_add(e, i)      // dst[e + i]
        __hx_ptr_store8(pd, off, c)
        i = __hx_payload_add(i, 1)
        c = __hx_ptr_load8(ps, i)             // src[i]
    }
    let endoff = __hx_payload_add(e, i)
    __hx_ptr_store8(pd, endoff, 0)            // terminator
    return pd
}

// ── SEARCH FAMILY (Route C batch F · pure byte-scan leaves, return raw pointer) ──
//
// SEARCH = a self-contained byte walk that returns a raw char* INTO the input
// (the match position) or NULL(0). Same leaf class as the compare/copy family:
// no syscall, no float, no inner call, no errno — every op is a raw-payload
// intrinsic over ZERO-EXTENDED byte loads (__hx_ptr_load8). The `int` return
// type carries the raw pointer word (never boxed), exactly like the
// strcpy/strncpy/strcat leaves return the dst pointer raw. Reference-matched to
// the frozen 0-libc floor bodies self/runtime.c rt_strchr:407 / rt_strstr:433 —
// the same non-NULL-guarded source the compare leaves cite (C strchr/strstr with
// a NULL arg is UB; every non-NULL caller is byte-identical). No arm64 call-shape
// divergence (pure compute · NR-irrelevant · identical x86_64/arm64 codegen).

// hxlcl_strchr: return a pointer to the first `c` byte of NUL-terminated `s`,
// or NULL. BYTE-FAITHFUL to self/runtime.c:407 (rt_strchr):
//   target=(unsigned char)c; for(i;;i++){ x=(unsigned char)s[i];
//     if(x==target) return s+i; if(x==0) return (target==0)?s+i:NULL; }.
// The (target==0) special case folds away by testing the target match BEFORE the
// NUL check: for c==0 the terminator is the first byte equal to target, so the
// match branch returns s+i there — musl's strchr.c relies on the same ordering.
pub fn hxlcl_strchr(s: HexaVal, c: HexaVal) -> int {
    let ps = __hx_payload_add(s, 0)
    let target = __hx_payload_and(c, 255)     // (unsigned char)c
    let mut i = 0
    while true {
        let x = __hx_ptr_load8(ps, i)         // (unsigned char)s[i]
        if __hx_payload_eq(x, target) {
            return __hx_payload_add(ps, i)    // s + i (match; also the NUL when target==0)
        }
        if __hx_payload_eq(x, 0) {
            return 0                          // end of string, no match → NULL
        }
        i = __hx_payload_add(i, 1)
    }
    return 0
}

// hxlcl_strstr: return a pointer to the first occurrence of NUL-terminated needle
// `n` in haystack `h`, or NULL. BYTE-FAITHFUL to self/runtime.c:433 (rt_strstr ·
// naive O(|h|·|n|) byte compare — correctness, not two-way speed):
//   if(n[0]==0) return h;
//   for(i=0; h[i]; i++){ j=0; while(n[j] && h[i+j]==n[j]) j++;
//                        if(n[j]==0) return h+i; }  return NULL.
// `break`-free in the frozen-parser style of hxlcl_strncpy: the inner scan stops
// by clearing a `cont` flag (needle exhausted OR mismatch), and after the inner
// loop `nj` still holds n[j] — nj==0 means the needle was fully matched.
pub fn hxlcl_strstr(h: HexaVal, n: HexaVal) -> int {
    let ph = __hx_payload_add(h, 0)
    let pn = __hx_payload_add(n, 0)
    let n0 = __hx_ptr_load8(pn, 0)            // n[0]
    if __hx_payload_eq(n0, 0) {
        return ph                             // empty needle → match at h[0]
    }
    let mut i = 0
    let mut hi = __hx_ptr_load8(ph, 0)        // h[i]
    while __hx_payload_ne(hi, 0) {            // for(; h[i]; )
        let mut j = 0
        let mut nj = __hx_ptr_load8(pn, 0)    // n[j] (n[0] at j=0)
        let mut cont = 1
        while __hx_payload_ne(cont, 0) {      // while(n[j] && h[i+j]==n[j])
            if __hx_payload_eq(nj, 0) {
                cont = 0                      // needle exhausted → full match
            }
            if __hx_payload_ne(cont, 0) {
                let off = __hx_payload_add(i, j)
                let hij = __hx_ptr_load8(ph, off)   // h[i+j]
                if __hx_payload_ne(hij, nj) {
                    cont = 0                  // mismatch → stop inner scan
                } else {
                    j = __hx_payload_add(j, 1)
                    nj = __hx_ptr_load8(pn, j)      // n[j]
                }
            }
        }
        if __hx_payload_eq(nj, 0) {           // n[j]==0 → needle fully matched
            return __hx_payload_add(ph, i)    // h + i
        }
        i = __hx_payload_add(i, 1)
        hi = __hx_ptr_load8(ph, i)            // h[i]
    }
    return 0                                  // not found → NULL
}

// ── PARSE FAMILY (Route C batch G · pure-compute leaf with an OUT-PARAM write) ──
//
// hxlcl_strtoll is the string family's last leaf: a from-scratch string→long long
// parse (whitespace skip · sign · base-0/16 prefix · digit accumulation) that, on
// success, also writes the parse-end position back through the caller's `char**
// endptr` out-param. That endptr write is the FIRST raw-pointer store64 a Route C
// body issues to a CALLER-PROVIDED out-pointer — but it is the SAME class as the
// copy family's caller-`dst` writes (strcpy/strncpy/strcat → __hx_ptr_store8 into
// the caller's buffer, all merged byteeq-green), here widened to __hx_ptr_store64
// for the pointer word and NULL-gated (endptr may be NULL — both callers below
// sometimes pass NULL). It is NOT the errno-store extern-data class (#4042): no
// __errno_location call, no syscall, no target-gating, no darwin carry-flag — a
// plain store to a param pointer. Pure compute otherwise → cross-target-identical
// (no NR, no arm64 call-shape divergence), like the strchr/strstr search leaves.
//
// IN-BODY OPERATOR DISCIPLINE (Route C, the #4042 rule): every arithmetic /
// comparison op is a raw-payload intrinsic (__hx_payload_{add,sub,mul,and,eq,ne,
// lt,le,ge}) — never a bare `<`/`-`/`*`, which would lower to the PAIR-MODEL
// helpers (hexa_cmp_lt / hexa_sub / …) undefined in the raw-C-ABI link. Each
// intrinsic result lands in its own `let` (un-nested) so a codegen scratch
// clobber cannot corrupt an outer op (the close/compare-family rule). The moving
// `const char *s` of the C body is modelled as a base pointer `p` (the raw nptr
// payload) + an index `i`; loads are __hx_ptr_load8(p, i) (ZERO-EXTENDED, exactly
// matching the digit-range behaviour of the C `char c = *s` — bytes ≥ 0x80 fall
// out of every ['0'..'9'],['a'..'z'],['A'..'Z'] range and stop the scan, the same
// as the C body's signed-or-unsigned-char break). `break` is avoided in the
// frozen-parser style (hxlcl_strncpy / hxlcl_strstr): each loop stops by clearing
// a `cont` flag. The endptr (s = p + i) is written via __hx_ptr_store64.
//
// endptr IS live (not dead): self/runtime.c routes `strtoll(p,&endptr,base)` →
// hxlcl_strtoll in hexa_str_parse_int (:4347, `if (endptr == p) throw`) and
// hexa_pinned_epoch (:12015, `if (endp != sde)`), so a wrong/absent endptr write
// would break those — the smoke asserts the endptr value-exact (== nptr + len).
//
// BYTE-FAITHFUL to the frozen 0-libc floor self/runtime.c:513 (hxlcl_strtoll) /
// the byte-identical shim runtime_core_hxlcl_shim.c:404. Char codes: ' '=32
// '\t'=9 '\n'=10 '-'=45 '+'=43 '0'=48 '9'=57 'x'=120 'X'=88 'a'=97 'z'=122
// 'A'=65 'Z'=90. The unsigned-accumulation `n = n*base + d` uses signed
// __hx_payload_mul/_add: bit-identical to the C body for any non-overflowing
// value (the real callers parse small env/limit strings), overflow is the same
// wrap-UB-adjacent territory as the C body and unobserved here.
pub fn hxlcl_strtoll(nptr: HexaVal, endptr: HexaVal, base: HexaVal) -> int {
    let p = __hx_payload_add(nptr, 0)          // const char* s = nptr (raw)
    let pe = __hx_payload_add(endptr, 0)       // char** endptr (raw, may be NULL)
    // NULL nptr: if (!nptr) { if (endptr) *endptr = nptr; return 0; }
    if __hx_payload_eq(p, 0) {
        if __hx_payload_ne(pe, 0) {
            __hx_ptr_store64(pe, 0, p)         // *endptr = (char*)nptr (NULL)
        }
        return 0
    }
    let mut b = __hx_payload_add(base, 0)      // int base (raw)
    let mut i = 0
    // whitespace skip: while(*s==' '||*s=='\t'||*s=='\n') s++;
    let mut ws = __hx_ptr_load8(p, i)
    let mut wcont = 1
    while __hx_payload_ne(wcont, 0) {
        let is_sp = __hx_payload_eq(ws, 32)
        let is_tab = __hx_payload_eq(ws, 9)
        let is_nl = __hx_payload_eq(ws, 10)
        let a1 = __hx_payload_add(is_sp, is_tab)
        let a2 = __hx_payload_add(a1, is_nl)
        if __hx_payload_ne(a2, 0) {
            i = __hx_payload_add(i, 1)
            ws = __hx_ptr_load8(p, i)
        } else {
            wcont = 0
        }
    }
    // sign: if(*s=='-'){sign=-1;s++;} else if(*s=='+')s++;
    let cs = __hx_ptr_load8(p, i)
    let mut neg = 0
    if __hx_payload_eq(cs, 45) {                // '-'
        neg = 1
        i = __hx_payload_add(i, 1)
    } else {
        if __hx_payload_eq(cs, 43) {            // '+'
            i = __hx_payload_add(i, 1)
        }
    }
    // base prefix: base-0 auto-detect (0x→16, 0→8, else 10); base-16 0x-skip.
    let i1 = __hx_payload_add(i, 1)
    let c0 = __hx_ptr_load8(p, i)
    let c1 = __hx_ptr_load8(p, i1)
    let is0 = __hx_payload_eq(c0, 48)           // s[0]=='0'
    let isx = __hx_payload_eq(c1, 120)          // s[1]=='x'
    let isX = __hx_payload_eq(c1, 88)           // s[1]=='X'
    let isxX = __hx_payload_add(isx, isX)       // 1 iff s[1] in {x,X} (exclusive)
    if __hx_payload_eq(b, 0) {
        if __hx_payload_ne(is0, 0) {
            if __hx_payload_ne(isxX, 0) {
                b = 16
                i = __hx_payload_add(i, 2)
            } else {
                b = 8
                i = __hx_payload_add(i, 1)
            }
        } else {
            b = 10
        }
    } else {
        if __hx_payload_eq(b, 16) {
            if __hx_payload_ne(is0, 0) {
                if __hx_payload_ne(isxX, 0) {
                    i = __hx_payload_add(i, 2)
                }
            }
        }
    }
    // digit accumulation: for(;;){ d=digit(c); if(none||d>=base) break;
    //                              n = n*base + d; s++; }
    let mut n = 0
    let mut cont = 1
    while __hx_payload_ne(cont, 0) {
        let c = __hx_ptr_load8(p, i)
        let mut isdig = 0
        let mut d = 0
        let ge0 = __hx_payload_ge(c, 48)        // c>='0'
        let le9 = __hx_payload_le(c, 57)        // c<='9'
        let is09 = __hx_payload_and(ge0, le9)
        if __hx_payload_ne(is09, 0) {
            isdig = 1
            d = __hx_payload_sub(c, 48)         // c-'0'
        } else {
            let gea = __hx_payload_ge(c, 97)    // c>='a'
            let lez = __hx_payload_le(c, 122)   // c<='z'
            let isaz = __hx_payload_and(gea, lez)
            if __hx_payload_ne(isaz, 0) {
                isdig = 1
                let da = __hx_payload_sub(c, 97)
                d = __hx_payload_add(da, 10)    // c-'a'+10
            } else {
                let geA = __hx_payload_ge(c, 65)  // c>='A'
                let leZ = __hx_payload_le(c, 90)  // c<='Z'
                let isAZ = __hx_payload_and(geA, leZ)
                if __hx_payload_ne(isAZ, 0) {
                    isdig = 1
                    let dA = __hx_payload_sub(c, 65)
                    d = __hx_payload_add(dA, 10)  // c-'A'+10
                }
            }
        }
        if __hx_payload_eq(isdig, 0) {
            cont = 0                            // non-digit → stop
        } else {
            if __hx_payload_ge(d, b) {
                cont = 0                        // digit out of base → stop
            } else {
                let nb = __hx_payload_mul(n, b)
                n = __hx_payload_add(nb, d)     // n = n*base + d
                i = __hx_payload_add(i, 1)
            }
        }
    }
    // if (endptr) *endptr = (char *)s;   (s = nptr + i)
    let endp = __hx_payload_add(p, i)
    if __hx_payload_ne(pe, 0) {
        __hx_ptr_store64(pe, 0, endp)
    }
    // return (sign < 0) ? -n : n;
    if __hx_payload_ne(neg, 0) {
        let r = __hx_payload_sub(0, n)
        return r
    }
    return n
}

// ── COMPOSITE FAMILY (Route C r7 · non-leaf — inner C-ABI bl to a sibling) ──
//
// COMPOSITE = the body is not a self-contained byte loop; it CALLS another
// hxlcl_* symbol. The Route C call-boundary keys on the CALLEE name
// (`_is_cabi(s.op)` · compiler/codegen/x86_64_linux.hexa:2482 · arm64_darwin.hexa
// _is_cabi(s.op)), so whitelisting BOTH the outer fn AND its inner callee makes
// the inner `bl` lower at the single-register C-ABI (arg payload → rdi/x0, raw
// result ← rax/x0) and bind cross-object to the callee. This dissolves the
// composite "wall" the earlier closure enumerated: that wall held ONLY for an
// UN-whitelisted callee (PAIR-MODEL inner call vs raw-C-ABI shim = mismatch); a
// whitelisted callee is C-ABI on both sides.
//
// PoC POLARITY (r7 = atoi only): hxlcl_atoi gets a Route C body whose sole op is
// the inner `bl hxlcl_atoll`; hxlcl_atoll stays the RETAINED C shim
// (runtime_core_hxlcl_shim.c:385 — `long long hxlcl_atoll(const char*)`), declared
// here as an `extern fn` (no body → undefined-external symbol resolved at link by
// the shim, mirroring the SELFEMIT seed test/native_build/emit_hxlcl_atoi_o.hexa's
// undefined-external `_hxlcl_atoll` + ARM64_RELOC_BRANCH26). atoll is whitelisted
// purely so the inner call lowers C-ABI — it is NOT self-emitted in this round.
// The int truncation (`(int)hxlcl_atoll`) is implicit: the result register carries
// the value and a C `int` caller reads only the low 32 bits.

// hxlcl_atoll: raw-C-ABI long-long parse leaf — RETAINED C shim body (not self-
// emitted this round). Declared so hxlcl_atoi's inner call binds at link.
extern fn hxlcl_atoll(s: HexaVal) -> int

// hxlcl_atoi: parse `s` as int by delegating to hxlcl_atoll. BYTE-FAITHFUL to
// runtime_core_hxlcl_shim.c:396 (`int hxlcl_atoi(const char *s){return (int)hxlcl_atoll(s);}`).
// Under the Route C gate the param arrives raw in rdi/x0, the inner `bl hxlcl_atoll`
// is a C-ABI call (s → rdi/x0, result ← rax/x0), and the return ships that result
// raw; under the default (gate OFF) it compiles as an ordinary HexaVal fn
// (byteeq-neutral — never linked in that mode).
pub fn hxlcl_atoi(s: HexaVal) -> int {
    return hxlcl_atoll(s)
}

// ── COMPOSITE FAMILY r8 (strdup → inner C-ABI bl hxlcl_malloc + byte loops) ──
//
// strdup is the r8 composite: a NON-LEAF that mixes inline byte loops (strlen
// scan + copy) with ONE inner C-ABI call `bl hxlcl_malloc`. Same dissolve as
// atoi — whitelisting BOTH hxlcl_strdup AND its inner callee hxlcl_malloc makes
// the inner `bl` lower single-register C-ABI (size → rdi/x0, raw ptr ← rax/x0)
// and bind cross-object. hxlcl_malloc stays the RETAINED C shim
// (runtime_core_hxlcl_shim.c:101 — `void *hxlcl_malloc(size_t)` = malloc delegate;
// NOT self-emitted this round), declared as an `extern fn` (undefined-external,
// resolved at link) mirroring the SELFEMIT seed
// test/native_build/emit_hxlcl_strdup_o.hexa (112 B: frame + strlen loop +
// `bl _hxlcl_malloc` BRANCH26 @0x30 + copy loop + NULL/return epilogue).

// hxlcl_malloc: raw-C-ABI allocator — RETAINED C shim (not self-emitted this
// round). Declared so hxlcl_strdup's inner call binds C-ABI at link.
extern fn hxlcl_malloc(n: HexaVal) -> int

// hxlcl_strdup: duplicate NUL-terminated `s` into a fresh malloc'd buffer,
// return it. BYTE-FAITHFUL to runtime_core_hxlcl_shim.c:333 (hxlcl_strdup):
//   n=0; while(s[n]) n++; out=hxlcl_malloc(n+1); for(i<n) out[i]=s[i];
//   out[n]='\0'; return out.
// (the NULL guard is the caller's responsibility on this PoC path — the frozen
// runtime never calls strdup with NULL, same precondition as the SELFEMIT seed.)
// Under the Route C gate the param arrives raw in rdi/x0; the inner
// `bl hxlcl_malloc` is C-ABI (size → rdi/x0, ptr ← rax/x0); the return ships the
// out pointer raw. Default (gate OFF) compiles as a HexaVal fn (byteeq-neutral).
pub fn hxlcl_strdup(s: HexaVal) -> int {
    let ps = __hx_payload_add(s, 0)           // src char* (payload word)
    let mut n = 0
    let mut c = __hx_ptr_load8(ps, 0)         // s[0]
    while __hx_payload_ne(c, 0) {
        n = __hx_payload_add(n, 1)
        c = __hx_ptr_load8(ps, n)             // s[n]
    }
    let cap = __hx_payload_add(n, 1)          // n + 1 (incl. terminator)
    let out = hxlcl_malloc(cap)               // C-ABI bl → raw ptr
    let mut i = 0
    while __hx_payload_lt(i, n) {
        let b = __hx_ptr_load8(ps, i)         // s[i]
        __hx_ptr_store8(out, i, b)            // out[i] = s[i]
        i = __hx_payload_add(i, 1)
    }
    __hx_ptr_store8(out, n, 0)                // out[n] = '\0'
    return out
}

// ── COMPOSITE FAMILY r9 (calloc → inner C-ABI bl hxlcl_malloc + zero loop) ──
//
// calloc = composite with ZERO new codegen patterns vs already-merged symbols:
//   • inner `bl hxlcl_malloc` — ON-path confirmed by hxlcl_strdup's routec-smoke.
//   • zero-loop `__hx_ptr_store8` — ON-path confirmed by hxlcl_memset.
// Its inner callee hxlcl_malloc is the SAME extern declared above (shared with
// hxlcl_strdup — not re-declared). Self-covering: this round adds the calloc
// behaviour assert to tool/routec_cabi_smoke.sh, so the routec-smoke job emits +
// links + runs calloc directly (not seed shape-match inference).

// hxlcl_calloc: allocate nmemb*size zeroed bytes, return the buffer. BYTE-FAITHFUL
// to runtime_core_hxlcl_shim.c:132 (the BYTEID 0-libc floor body):
//   total = nmemb*size; p = hxlcl_malloc(total); if(p) for(i<total) p[i]=0; ret p.
// (the frozen runtime never calls calloc with a 0×0 → malloc(0); same precondition
// as the other composites.) Under the Route C gate the two size args arrive raw in
// rdi,rsi / x0,x1, the inner `bl hxlcl_malloc` is C-ABI, and the return ships the
// buffer pointer raw. Default (gate OFF) compiles as a HexaVal fn (byteeq-neutral).
pub fn hxlcl_calloc(nmemb: HexaVal, size: HexaVal) -> int {
    let total = __hx_payload_mul(nmemb, size)  // nmemb * size
    let p = hxlcl_malloc(total)                // C-ABI bl → raw ptr
    let mut i = 0
    while __hx_payload_lt(i, total) {
        __hx_ptr_store8(p, i, 0)               // p[i] = 0
        i = __hx_payload_add(i, 1)
    }
    return p
}

// ── COMPOSITE FAMILY r10 (realloc → inner bl malloc + NEGATIVE-OFFSET header read) ──
//
// realloc is the LAST composite. Its load-bearing NEW codegen pattern is the
// header read `*(size_t *)((char *)p - HXLCL_HDR_BYTES)` — a `__hx_ptr_load64`
// at a NEGATIVE offset (p - 16). No prior Route C symbol exercised a negative
// ptr-load, so the routec-smoke job gains a dedicated realloc behaviour assert
// (the first ON-path verification of this pattern). The negative offset is
// expressible because both backends lower `__hx_ptr_load64(ptr, off)` as a plain
// 64-bit register add `addr = ptr + off` (x86_64_linux.hexa:2453 `add r10,r11` /
// arm64_darwin.hexa:2295 `add x1,x1,x3`) — a negative `off` payload (here via
// `__hx_payload_sub(0, 16)`) yields `ptr - 16` with no special handling.
//
// BYTE-FAITHFUL to runtime_core_hxlcl_shim.c:112 (the BYTEID 0-libc floor body):
//   if(!p) return malloc(n); if(n==0) return 0; np=malloc(n); if(!np) return 0;
//   old_n=*(size_t*)(p-16); copy_n=min(n,old_n); memcpy(np,p,copy_n); return np.
// PoC precondition (same as the other composites): the frozen runtime calls
// hxlcl_realloc only with a non-NULL p that carries the 16-byte size header the
// floor hxlcl_malloc writes, and n>0 — so the NULL/n==0 guards are the caller's
// responsibility on this path. The smoke harness's hxlcl_malloc writes the same
// 16-byte header so the header read is meaningful (see tool/routec_cabi_smoke.sh).

// hxlcl_realloc: grow/shrink `p` to `n` bytes, preserving min(n, old_n) content.
pub fn hxlcl_realloc(p: HexaVal, n: HexaVal) -> int {
    let pp = __hx_payload_add(p, 0)            // old buffer (payload word)
    let np = hxlcl_malloc(n)                   // C-ABI bl → new raw ptr
    let neg_hdr = __hx_payload_sub(0, 16)      // -HXLCL_HDR_BYTES
    let old_n = __hx_ptr_load64(pp, neg_hdr)   // *(size_t*)(p - 16)
    let mut copy_n = n
    if __hx_payload_lt(old_n, n) {
        copy_n = old_n                         // copy_n = min(n, old_n)
    }
    let mut i = 0
    while __hx_payload_lt(i, copy_n) {
        let b = __hx_ptr_load8(pp, i)          // p[i]
        __hx_ptr_store8(np, i, b)              // np[i] = p[i]
        i = __hx_payload_add(i, 1)
    }
    return np
}

// ── SYSCALL FAMILY (Route C r11 · errno-free 0-arg leaf — first syscall body) ──
//
// hxlcl_getpid is the FIRST Route C leaf whose body ISSUES A SYSCALL (not a raw
// memory walk). It proves the Route C C-ABI lowering composes with the syscall
// intrinsic on the ERRNO-FREE subset:
//   - 0 args + cannot-fail: getpid never errors (no errno / carry-flag path —
//     identical to getuid), so the body returns the kernel pid RAW in the single
//     C-ABI result register with NO errno store. (errno-bearing syscalls —
//     close/read/lseek/stat/dup2/mkdir/waitpid — additionally need to write the
//     C global `errno`, which hexa source has no extern-data-write intrinsic for:
//     a measured wall deferred to a separate extern-data substrate round.)
//   - the per-OS trap is already emitted by the backend's `__hx_syscall0`
//     (x86_64 `syscall` / arm64 `svc #0x80`|`svc #0`, x86_64_linux.hexa:2392 /
//     arm64_darwin.hexa:2190), so the body only selects the per-target NUMBER.
//
// PER-TARGET getpid NR (compile-time consts → DCE drops the dead branch):
//   Linux x86_64 = 39   (stdlib/posix/linux_syscalls.hexa:124, syscall_64.tbl)
//   Linux arm64  = 172  (stdlib/posix/linux_syscalls.hexa:96, asm-generic)
//   Darwin arm64 = 20   (SYS_GETPID | 0x2000000 baked by __hx_syscall0's BSD trap
//                        path; the bare 20 here matches the seed
//                        test/native_build/emit_hxlcl_getpid_o.hexa `mov w16,#20`).
//
// BYTE-FAITHFUL to the C floor (self/runtime_emit_full.hexa:1662):
//   hxlcl_getpid(void) { return (int)_hxlcl_syscall1(HXLCL_SYS_GETPID, 0); }
// (0-arg under the unified syscall0; the floor passes a dummy 0 to its syscall1
// helper, but the kernel ignores args for getpid).
pub fn hxlcl_getpid() -> int {
    let mut nr = 20                            // Darwin SYS_GETPID (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 39 }      // Linux x86_64 __NR_getpid
        else { nr = 172 }                      // Linux arm64 __NR_getpid
    }
    return __hx_syscall0(nr)                    // kernel pid → raw C-ABI result reg
}

// r2 — errno-free 0-arg family chain (getpid mirror). Each is class-C
// cannot-fail (no errno / carry-flag path), so the body returns the raw kernel
// value in the single C-ABI result register with NO errno store, exactly like
// getpid. Per-target NR via compile-time target_is_* consts (DCE drops the dead
// branch). NR ref-match (no black-box):
//   getuid : x86_64 102 · arm64 174 · darwin 24   (syscall_64.tbl / asm-generic
//            unistd.h __NR_getuid 174 / runtime.c HXLCL_SYS_GETUID 24)
//   getgid : x86_64 104 · arm64 176 · darwin 47
//   getppid: x86_64 110 · arm64 173 · darwin 39
//   geteuid: x86_64 107 · arm64 175 · darwin 25
//   getegid: x86_64 108 · arm64 177 · darwin 43
// (Linux x86_64 = syscall_64.tbl · Linux arm64 = include/uapi/asm-generic/
// unistd.h · darwin = runtime.c HXLCL_SYS_* table, matching the floor bodies
// self/runtime.c:1690-1719 `_hxlcl_syscall1(HXLCL_SYS_GET*, 0)`.)

pub fn hxlcl_getuid() -> int {
    let mut nr = 24                            // Darwin SYS_GETUID (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 102 }     // Linux x86_64 __NR_getuid
        else { nr = 174 }                      // Linux arm64 __NR_getuid
    }
    return __hx_syscall0(nr)                    // uid → raw C-ABI result reg
}

