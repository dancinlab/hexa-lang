}

pub fn hxlcl_geteuid() -> int {
    let mut nr = 25                            // Darwin SYS_GETEUID (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 107 }     // Linux x86_64 __NR_geteuid
        else { nr = 175 }                      // Linux arm64 __NR_geteuid
    }
