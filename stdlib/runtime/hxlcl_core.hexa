// stdlib/runtime/hxlcl_core.hexa — RFC061 §M8 Route C libc-floor C-ABI SSOT.
//
// The hexa-source raw-mem bodies for the libc-floor substrate symbols
// `hxlcl_strlen` (`size_t hxlcl_strlen(const char*)`), `hxlcl_memcpy`
// (`void *hxlcl_memcpy(void*,const void*,size_t)`) and `hxlcl_memset`
// (`void *hxlcl_memset(void*,int,size_t)`), emitted through the
// compiler's portable `aprime_cc --emit=asm --target=` cross-target path under
// the Route C C-ABI calling-convention gate (HEXA_CABI_HXLCL=1 · _is_cabi in
// compiler/codegen/x86_64_linux.hexa + arm64_darwin.hexa).
//
// WHY A SEPARATE FILE (not str_core.hexa): str_core's prims are HexaVal-ABI
// (their C wrappers pass real TAG_STR HexaVals). hxlcl_* are the OPPOSITE layer —
// raw C-ABI, called with a bare `char*` register throughout the frozen C runtime
// amalgam (self/runtime_core.c, runtime_core_hxlcl_shim.c). The Route C ingress
// lands that single arg register as this fn's param PAYLOAD with TAG_INT(0), and
// the Route C return ships the count back in a SINGLE result register — so the
// body below is byte-walk-identical to str_core, only the ABI boundary differs.
//
// RAW-MEM, un-nested (str_core NESTING finding): every __hx_payload_* /
// __hx_ptr_* call writes EXACTLY ONE `let` — no nested intrinsic args (a native
// codegen scratch clobber corrupts the outer op otherwise). Comparison uses the
// raw-int leaf intrinsics (__hx_payload_ne), NOT plain `==`/`!=` (those lower to
// HexaVal runtime helpers that misread the raw byte words). __hx_ptr_load8 reads
// one byte ZERO-EXTENDED into a TAG_INT payload, so the 0x00 NUL compares as 0.
//
// BYTE-FAITHFUL to the C body it replaces (runtime_core_hxlcl_shim.c:212):
//   size_t hxlcl_strlen(const char *s){ if(!s) return 0; size_t n=0;
//                                       while(s[n]) n++; return n; }
// (the NULL guard is the caller's responsibility on this PoC path — the frozen
// runtime never calls hxlcl_strlen with NULL; same precondition the SELFEMIT
// hand-assembled seeds in test/native_build/emit_hxlcl_strlen_*.hexa carry.)
//
// NOT @pure: the body touches external buffer memory through __hx_ptr_load8.

// hxlcl_strlen: count bytes up to (not including) the NUL terminator. Under the
// Route C C-ABI gate the param arrives raw in rdi/x0 and the return ships the
// count raw in rax/x0; under the default (PAIR-MODEL, gate OFF) it compiles as an
// ordinary HexaVal fn (byteeq-neutral — never linked into the runtime in that
// mode).
pub fn hxlcl_strlen(s: HexaVal) -> int {
    let p = __hx_payload_add(s, 0)            // char* (payload word)
    let mut n = 0
    let mut c = __hx_ptr_load8(p, 0)          // s[0]
    while __hx_payload_ne(c, 0) {
        n = __hx_payload_add(n, 1)
        c = __hx_ptr_load8(p, n)              // s[n]
    }
    return n
}

// BYTE-FAITHFUL to the C body it replaces (self/runtime.c:586, rt_memcpy 32 B):
//   void *hxlcl_memcpy(void *dst, const void *src, size_t n){
//       unsigned char *d=dst; const unsigned char *s=src;
//       for(size_t i=0;i<n;i++) d[i]=s[i]; return dst; }
// Three raw C-ABI args (dst,src,n) arrive in rdi/rsi/rdx (x0/x1/x2); the return
// ships the dst pointer raw in rax/x0. (n==0 → the while never enters, exactly
// like the C for-loop; the frozen runtime never calls memcpy with NULL/overlap —
// same precondition as hxlcl_strlen and the SELFEMIT hand-assembled seed
// test/native_build/emit_hxlcl_memcpy_o.hexa.) Forward byte copy only — overlap
// is hxlcl_memmove's job, never aliased onto this symbol.
//
// RAW-MEM, un-nested (same str_core NESTING rule as hxlcl_strlen above): every
// __hx_payload_* / __hx_ptr_* call writes EXACTLY ONE `let`/assignment with no
// nested intrinsic args. __hx_payload_lt(i, n) tests the raw payload words (NOT
// `<`, which lowers to a HexaVal helper that misreads the raw byte words);
// __hx_ptr_load8 reads one byte ZERO-EXTENDED into a TAG_INT payload and
// __hx_ptr_store8 writes the low byte of that payload back to dst[i].

// hxlcl_memcpy: copy `n` bytes src→dst (forward), return dst. Under the Route C
// C-ABI gate the params arrive raw in rdi,rsi,rdx / x0,x1,x2 and the return ships
// the dst pointer raw in rax/x0; under the default (PAIR-MODEL, gate OFF) it
// compiles as an ordinary HexaVal fn (byteeq-neutral — never linked in that mode).
pub fn hxlcl_memcpy(dst: HexaVal, src: HexaVal, n: HexaVal) -> int {
    let pd = __hx_payload_add(dst, 0)         // dst char* (payload word)
    let ps = __hx_payload_add(src, 0)         // src char* (payload word)
    let mut i = 0
    while __hx_payload_lt(i, n) {
        let b = __hx_ptr_load8(ps, i)         // src[i]
        __hx_ptr_store8(pd, i, b)             // dst[i] = src[i]
        i = __hx_payload_add(i, 1)
    }
    return pd
}

// BYTE-FAITHFUL to the C body it replaces (self/runtime.c:613, rt_memset 28 B):
//   void *hxlcl_memset(void *s, int c, size_t n){
//       unsigned char *p=s; unsigned char v=(unsigned char)c;
//       for(size_t i=0;i<n;i++) p[i]=v; return s; }
// Three raw C-ABI args (s,c,n) arrive in rdi/rsi/rdx (x0/x1/x2); the return ships
// the dst pointer raw in rax/x0. (n==0 → the while never enters, exactly like the
// C for-loop; the frozen runtime never calls memset with NULL — same precondition
// as hxlcl_memcpy and the SELFEMIT hand-assembled seed
// test/native_build/emit_hxlcl_memset_o.hexa, whose `strb w1,[x0,x3]` loop writes
// only the LOW byte of the c register — identical to the C `(unsigned char)c`.)
//
// RAW-MEM, un-nested (same str_core NESTING rule): every __hx_payload_* /
// __hx_ptr_* call writes EXACTLY ONE `let`/assignment with no nested intrinsic
// args. __hx_payload_lt(i, n) tests the raw payload words (NOT `<`, which lowers
// to a HexaVal helper that misreads the raw byte words); __hx_ptr_store8 writes
// the LOW byte of the c payload to s[i] (the `(unsigned char)c` truncation).

// hxlcl_memset: write the low byte of `c` into `n` bytes of `s`, return s. Under
// the Route C C-ABI gate the params arrive raw in rdi,rsi,rdx / x0,x1,x2 and the
// return ships the s pointer raw in rax/x0; under the default (PAIR-MODEL, gate
// OFF) it compiles as an ordinary HexaVal fn (byteeq-neutral — never linked in
// that mode).
pub fn hxlcl_memset(s: HexaVal, c: HexaVal, n: HexaVal) -> int {
    let ps = __hx_payload_add(s, 0)           // s char* (payload word)
    let mut i = 0
    while __hx_payload_lt(i, n) {
        __hx_ptr_store8(ps, i, c)             // s[i] = (unsigned char)c
        i = __hx_payload_add(i, 1)
    }
    return ps
}

// ── COMPARE FAMILY (Route C r5 · pure byte-walk, no syscall/float/composite) ──
//
// The compare leaves return an `int` derived from a byte difference; the C bodies
// (runtime_core_hxlcl_shim.c + self/runtime.c) all compute
//   (int)(unsigned char)pa[i] - (int)(unsigned char)pb[i]
// at the first mismatch, else 0/the terminator rule. The Route C ingress lands
// each raw pointer/length arg as a TAG_INT(0) payload; __hx_ptr_load8 reads ONE
// byte ZERO-EXTENDED (so the 0..255 byte compares as itself, matching the C
// `(unsigned char)` cast), and __hx_payload_sub computes the signed difference
// shipped raw in rax/x0. Reference-checked byte-for-byte against the SELFEMIT
// arm64 seeds (test/native_build/emit_hxlcl_{memcmp,strcmp,strncmp,strchr}_o.hexa,
// each `subs w6,w4,w5` / `ldrb` verbatim from self/codegen/runtime_arm64.hexa).
//
// RAW-MEM, un-nested (same str_core NESTING rule as the mem leaves above): every
// __hx_payload_* / __hx_ptr_* call writes EXACTLY ONE `let`/assignment with no
// nested intrinsic args. Comparisons use raw-int leaf intrinsics
// (__hx_payload_lt / __hx_payload_ne), NOT `<`/`!=` (those lower to HexaVal
// helpers that misread the raw byte words).

// hxlcl_memcmp: compare n bytes a vs b; return first signed byte diff, else 0.
// BYTE-FAITHFUL to runtime_core_hxlcl_shim.c:188 (hxlcl_memcmp) /
// self/runtime.c rt_memcmp: for(i<n){ d=(int)pa[i]-(int)pb[i]; if(d) return d; } 0.
pub fn hxlcl_memcmp(a: HexaVal, b: HexaVal, n: HexaVal) -> int {
    let pa = __hx_payload_add(a, 0)           // a char* (payload word)
    let pb = __hx_payload_add(b, 0)           // b char* (payload word)
    let mut i = 0
    while __hx_payload_lt(i, n) {
        let ca = __hx_ptr_load8(pa, i)        // (unsigned char)a[i]
        let cb = __hx_ptr_load8(pb, i)        // (unsigned char)b[i]
        let d = __hx_payload_sub(ca, cb)      // (int)ca - (int)cb
        if __hx_payload_ne(d, 0) {
            return d
        }
        i = __hx_payload_add(i, 1)
    }
    return 0
}

// hxlcl_strcmp: compare NUL-terminated a vs b; first signed byte diff, else 0.
// BYTE-FAITHFUL to runtime_core_hxlcl_shim.c:231 (hxlcl_strcmp) /
// self/runtime.c rt_strcmp: for(i;;i++){ ca=a[i]; cb=b[i];
//   if(ca!=cb) return ca-cb; if(ca==0) return 0; }.
pub fn hxlcl_strcmp(a: HexaVal, b: HexaVal) -> int {
    let pa = __hx_payload_add(a, 0)
    let pb = __hx_payload_add(b, 0)
    let mut i = 0
    while true {
        let ca = __hx_ptr_load8(pa, i)        // (unsigned char)a[i]
        let cb = __hx_ptr_load8(pb, i)        // (unsigned char)b[i]
        let d = __hx_payload_sub(ca, cb)
        if __hx_payload_ne(d, 0) {
            return d
        }
        if __hx_payload_eq(ca, 0) {
            return 0
        }
        i = __hx_payload_add(i, 1)
    }
    return 0
}

// hxlcl_strncmp: compare up to n bytes of NUL-terminated a vs b.
// BYTE-FAITHFUL to runtime_core_hxlcl_shim.c:251 (hxlcl_strncmp): for(i<n){
//   ca=a[i]; cb=b[i]; if(ca!=cb) return ca-cb; if(ca==0) return 0; } 0.
pub fn hxlcl_strncmp(a: HexaVal, b: HexaVal, n: HexaVal) -> int {
    let pa = __hx_payload_add(a, 0)
    let pb = __hx_payload_add(b, 0)
    let mut i = 0
    while __hx_payload_lt(i, n) {
        let ca = __hx_ptr_load8(pa, i)
        let cb = __hx_ptr_load8(pb, i)
        let d = __hx_payload_sub(ca, cb)
        if __hx_payload_ne(d, 0) {
            return d
        }
        if __hx_payload_eq(ca, 0) {
            return 0
        }
        i = __hx_payload_add(i, 1)
    }
    return 0
}

// ── COPY FAMILY (Route C r6 · pure byte-copy, returns the dst pointer raw) ──
//
// The copy leaves return the dst `char*` (shipped raw in rax/x0 under Route C —
// the `int` return type carries the raw pointer word, never boxed). Each writes
// the NUL terminator the C body writes; __hx_ptr_load8 reads ZERO-EXTENDED and
// __hx_ptr_store8 writes the low byte. Reference-matched against the SELFEMIT
// arm64 seeds (test/native_build/emit_hxlcl_{strcpy,strncpy,strcat}_o.hexa,
// verbatim from self/codegen/runtime_arm64.hexa). Same un-nested raw-mem rule.

// hxlcl_strcpy: copy NUL-terminated src→dst (incl. terminator), return dst.
// BYTE-FAITHFUL to runtime_core_hxlcl_shim.c:272 (hxlcl_strcpy):
//   i=0; while(src[i]){ dst[i]=src[i]; i++; } dst[i]='\0'; return dst.
pub fn hxlcl_strcpy(dst: HexaVal, src: HexaVal) -> int {
    let pd = __hx_payload_add(dst, 0)
    let ps = __hx_payload_add(src, 0)
    let mut i = 0
    let mut c = __hx_ptr_load8(ps, 0)         // src[0]
    while __hx_payload_ne(c, 0) {
        __hx_ptr_store8(pd, i, c)             // dst[i] = src[i]
        i = __hx_payload_add(i, 1)
        c = __hx_ptr_load8(ps, i)             // src[i]
    }
    __hx_ptr_store8(pd, i, 0)                 // dst[i] = '\0'
    return pd
}

// hxlcl_strncpy: copy up to n bytes of src→dst, NUL-pad the remainder, return dst.
// BYTE-FAITHFUL to runtime_core_hxlcl_shim.c:290 (hxlcl_strncpy):
//   i=0; for(;i<n && src[i];i++) dst[i]=src[i]; for(;i<n;i++) dst[i]='\0'; ret dst.
pub fn hxlcl_strncpy(dst: HexaVal, src: HexaVal, n: HexaVal) -> int {
    let pd = __hx_payload_add(dst, 0)
    let ps = __hx_payload_add(src, 0)
    // Phase 1: copy src bytes while i<n and src[i]!=0. `stop` carries the C
    // body's preserved `i` across the two for-loops (no rescan — untouched dst
    // bytes are not yet zeroed, so re-deriving the boundary by reading dst is
    // unsound).
    let mut i = 0
    let mut stop = n
    let mut c = __hx_ptr_load8(ps, 0)         // src[0]
    while __hx_payload_lt(i, n) {
        if __hx_payload_eq(c, 0) {
            stop = i                          // src exhausted at i
            i = n                             // break the copy loop
        }
        if __hx_payload_lt(i, n) {
            __hx_ptr_store8(pd, i, c)         // dst[i] = src[i]
            i = __hx_payload_add(i, 1)
            c = __hx_ptr_load8(ps, i)         // src[i]
        }
    }
    // Phase 2: NUL-pad dst[stop..n).
    let mut j = stop
    while __hx_payload_lt(j, n) {
        __hx_ptr_store8(pd, j, 0)             // dst[j] = '\0'
        j = __hx_payload_add(j, 1)
    }
    return pd
}

// hxlcl_strcat: append NUL-terminated src to the end of dst, return dst.
// BYTE-FAITHFUL to runtime_core_hxlcl_shim.c:308 (hxlcl_strcat):
//   p=dst; while(*p) p++; i=0; while(src[i]){ p[i]=src[i]; i++; } p[i]='\0'; ret dst.
pub fn hxlcl_strcat(dst: HexaVal, src: HexaVal) -> int {
    let pd = __hx_payload_add(dst, 0)
    let ps = __hx_payload_add(src, 0)
    let mut e = 0
    let mut ce = __hx_ptr_load8(pd, 0)        // dst[0] — scan to NUL
    while __hx_payload_ne(ce, 0) {
        e = __hx_payload_add(e, 1)
        ce = __hx_ptr_load8(pd, e)            // dst[e]
    }
    let mut i = 0
    let mut c = __hx_ptr_load8(ps, 0)         // src[0]
    while __hx_payload_ne(c, 0) {
        let off = __hx_payload_add(e, i)      // dst[e + i]
        __hx_ptr_store8(pd, off, c)
        i = __hx_payload_add(i, 1)
        c = __hx_ptr_load8(ps, i)             // src[i]
    }
    let endoff = __hx_payload_add(e, i)
    __hx_ptr_store8(pd, endoff, 0)            // terminator
    return pd
}

// ── SEARCH FAMILY (Route C batch F · pure byte-scan leaves, return raw pointer) ──
//
// SEARCH = a self-contained byte walk that returns a raw char* INTO the input
// (the match position) or NULL(0). Same leaf class as the compare/copy family:
// no syscall, no float, no inner call, no errno — every op is a raw-payload
// intrinsic over ZERO-EXTENDED byte loads (__hx_ptr_load8). The `int` return
// type carries the raw pointer word (never boxed), exactly like the
// strcpy/strncpy/strcat leaves return the dst pointer raw. Reference-matched to
// the frozen 0-libc floor bodies self/runtime.c rt_strchr:407 / rt_strstr:433 —
// the same non-NULL-guarded source the compare leaves cite (C strchr/strstr with
// a NULL arg is UB; every non-NULL caller is byte-identical). No arm64 call-shape
// divergence (pure compute · NR-irrelevant · identical x86_64/arm64 codegen).

// hxlcl_strchr: return a pointer to the first `c` byte of NUL-terminated `s`,
// or NULL. BYTE-FAITHFUL to self/runtime.c:407 (rt_strchr):
//   target=(unsigned char)c; for(i;;i++){ x=(unsigned char)s[i];
//     if(x==target) return s+i; if(x==0) return (target==0)?s+i:NULL; }.
// The (target==0) special case folds away by testing the target match BEFORE the
// NUL check: for c==0 the terminator is the first byte equal to target, so the
// match branch returns s+i there — musl's strchr.c relies on the same ordering.
pub fn hxlcl_strchr(s: HexaVal, c: HexaVal) -> int {
    let ps = __hx_payload_add(s, 0)
    let target = __hx_payload_and(c, 255)     // (unsigned char)c
    let mut i = 0
    while true {
        let x = __hx_ptr_load8(ps, i)         // (unsigned char)s[i]
        if __hx_payload_eq(x, target) {
            return __hx_payload_add(ps, i)    // s + i (match; also the NUL when target==0)
        }
        if __hx_payload_eq(x, 0) {
            return 0                          // end of string, no match → NULL
        }
        i = __hx_payload_add(i, 1)
    }
    return 0
}

// hxlcl_strstr: return a pointer to the first occurrence of NUL-terminated needle
// `n` in haystack `h`, or NULL. BYTE-FAITHFUL to self/runtime.c:433 (rt_strstr ·
// naive O(|h|·|n|) byte compare — correctness, not two-way speed):
//   if(n[0]==0) return h;
//   for(i=0; h[i]; i++){ j=0; while(n[j] && h[i+j]==n[j]) j++;
//                        if(n[j]==0) return h+i; }  return NULL.
// `break`-free in the frozen-parser style of hxlcl_strncpy: the inner scan stops
// by clearing a `cont` flag (needle exhausted OR mismatch), and after the inner
// loop `nj` still holds n[j] — nj==0 means the needle was fully matched.
pub fn hxlcl_strstr(h: HexaVal, n: HexaVal) -> int {
    let ph = __hx_payload_add(h, 0)
    let pn = __hx_payload_add(n, 0)
    let n0 = __hx_ptr_load8(pn, 0)            // n[0]
    if __hx_payload_eq(n0, 0) {
        return ph                             // empty needle → match at h[0]
    }
    let mut i = 0
    let mut hi = __hx_ptr_load8(ph, 0)        // h[i]
    while __hx_payload_ne(hi, 0) {            // for(; h[i]; )
        let mut j = 0
        let mut nj = __hx_ptr_load8(pn, 0)    // n[j] (n[0] at j=0)
        let mut cont = 1
        while __hx_payload_ne(cont, 0) {      // while(n[j] && h[i+j]==n[j])
            if __hx_payload_eq(nj, 0) {
                cont = 0                      // needle exhausted → full match
            }
            if __hx_payload_ne(cont, 0) {
                let off = __hx_payload_add(i, j)
                let hij = __hx_ptr_load8(ph, off)   // h[i+j]
                if __hx_payload_ne(hij, nj) {
                    cont = 0                  // mismatch → stop inner scan
                } else {
                    j = __hx_payload_add(j, 1)
                    nj = __hx_ptr_load8(pn, j)      // n[j]
                }
            }
        }
        if __hx_payload_eq(nj, 0) {           // n[j]==0 → needle fully matched
            return __hx_payload_add(ph, i)    // h + i
        }
        i = __hx_payload_add(i, 1)
        hi = __hx_ptr_load8(ph, i)            // h[i]
    }
    return 0                                  // not found → NULL
}

// ── PURE-LEAF MIRROR BATCH (Route C · strrchr / memmove / bzero) ──────────────
//
// Three more pure-compute leaves that add NO new codegen mechanism — each is a
// byte-faithful mirror of an already-wired Route C leaf (strchr / memcpy / memset):
// no syscall, no errno, no float, no inner C-ABI call, no out-ptr extern-data.
// Cross-target-identical compute (the byteeq build proves the emit is bit-equal on
// all 3 targets; the routec-smoke run proves the BEHAVIOUR). Same un-nested raw-mem
// rule as the mem/compare/copy/search leaves above: every __hx_payload_* /
// __hx_ptr_* call writes EXACTLY ONE `let`/assignment with no nested intrinsic args;
// comparisons use raw-int leaf intrinsics (__hx_payload_lt / _eq / _ne), NOT `<`/
// `==`/`!=` (those lower to HexaVal helpers that misread the raw byte words).

// hxlcl_strrchr: return a pointer to the LAST `c` byte of NUL-terminated `s`, or
// NULL. BYTE-FAITHFUL to the frozen 0-libc floor body self/runtime.c:422 (rt_strrchr):
//   if(!s) return NULL; target=(unsigned char)c; last=NULL;
//   for(i=0;;i++){ x=(unsigned char)s[i]; if(x==target) last=s+i;
//                  if(x==0) return last; }.
// The c==0 case naturally returns the terminator pointer (the NUL matches target==0
// and is the last byte scanned). Returns the raw char* in the single C-ABI result
// register — the same pointer-into-input class as strchr/strstr.
pub fn hxlcl_strrchr(s: HexaVal, c: HexaVal) -> int {
    let ps = __hx_payload_add(s, 0)           // char* (payload word)
    if __hx_payload_eq(ps, 0) {
        return 0                              // NULL s → NULL (frozen `if(!s)`)
    }
    let target = __hx_payload_and(c, 255)     // (unsigned char)c
    let mut last = 0                          // const char *last = NULL
    let mut i = 0
    while true {
        let x = __hx_ptr_load8(ps, i)         // (unsigned char)s[i]
        if __hx_payload_eq(x, target) {
            last = __hx_payload_add(ps, i)    // last = s + i
        }
        if __hx_payload_eq(x, 0) {
            return last                       // end of string → last match (or NULL)
        }
        i = __hx_payload_add(i, 1)
    }
    return last
}

// hxlcl_memmove: copy `n` bytes src→dst handling OVERLAP, return dst. BYTE-FAITHFUL
// to the frozen 0-libc floor body self/runtime.c:627 (rt_memmove):
//   d=dst; s=src; if(d==s || n==0) return dst;
//   if(d<s) for(i=0;i<n;i++) d[i]=s[i];
//   else    for(i=n;i>0;i--) d[i-1]=s[i-1];  return dst.
// Forward copy when dst<src, backward copy otherwise — the only difference from
// hxlcl_memcpy (which is forward-only and never aliased onto overlap). Returns the
// dst pointer raw in the single C-ABI result register, like the copy family.
pub fn hxlcl_memmove(dst: HexaVal, src: HexaVal, n: HexaVal) -> int {
    let pd = __hx_payload_add(dst, 0)         // dst char* (payload word)
    let ps = __hx_payload_add(src, 0)         // src char* (payload word)
    if __hx_payload_eq(pd, ps) {
        return pd                             // d == s → no-op
    }
    if __hx_payload_eq(n, 0) {
        return pd                             // n == 0 → no-op
    }
    if __hx_payload_lt(pd, ps) {
        // forward copy: for(i=0;i<n;i++) d[i]=s[i]
        let mut i = 0
        while __hx_payload_lt(i, n) {
            let b = __hx_ptr_load8(ps, i)     // src[i]
            __hx_ptr_store8(pd, i, b)         // dst[i] = src[i]
            i = __hx_payload_add(i, 1)
        }
    } else {
        // backward copy: for(i=n;i>0;i--) d[i-1]=s[i-1]
        let mut j = n
        while __hx_payload_ne(j, 0) {
            let k = __hx_payload_sub(j, 1)    // i-1
            let b = __hx_ptr_load8(ps, k)     // src[i-1]
            __hx_ptr_store8(pd, k, b)         // dst[i-1] = src[i-1]
            j = k
        }
    }
    return pd
}

// hxlcl_bzero: write 0 into `n` bytes of `s`. BYTE-FAITHFUL to the frozen 0-libc
// floor body self/runtime.c:575 (hxlcl_bzero):
//   p=s; for(i=0;i<n;i++) p[i]=0;  (void return).
// A trivial mirror of hxlcl_memset with c==0. The C body is `void`; the `int`
// result register is unused by every caller (the frozen `#define bzero(p,n)`
// expansion discards it), so a 0 return word is sound.
pub fn hxlcl_bzero(s: HexaVal, n: HexaVal) -> int {
    let ps = __hx_payload_add(s, 0)           // s char* (payload word)
    let mut i = 0
    while __hx_payload_lt(i, n) {
        __hx_ptr_store8(ps, i, 0)             // s[i] = 0
        i = __hx_payload_add(i, 1)
    }
    return 0
}

// ── ENV FAMILY (Route C Wall 2-b · extern-data named-data GOT reloc) ───────────
//
// hxlcl_getenv: look up `name` in the process environment, returning a pointer to
// its value (the bytes after `=`), or NULL. BYTE-FAITHFUL to the frozen 0-libc
// floor body self/runtime_core_hxlcl_shim.c (HEXA_ZEROC_SHIM_BYTEID_EMIT
// hxlcl_getenv, lines 447-460):
//   if(!name) return 0; e=environ; if(!e) return 0; nlen=strlen(name);
//   while(*e){ entry=*e; i=0; while(i<nlen && entry[i] && entry[i]==name[i]) i++;
//              if(i==nlen && entry[i]=='=') return entry+nlen+1; e++; }
//   return 0;
//
// The ONE new substrate piece is `__hx_environ_ptr()` — a 0-arg intrinsic that
// loads the ADDRESS of the libc `extern char **environ` global through the GOT
// (x86_64 `mov rax,[rip+environ@GOTPCREL]` / arm64 `adrp+ldr …@GOTPAGE`), boxed as
// a TAG_INT payload. It returns `&environ` (char***), so ONE __hx_ptr_load64
// dereference yields `environ` itself (the char** array base). Everything after is
// the proven byte-walk: __hx_ptr_load64 steps the char* slots (+8 each),
// __hx_ptr_load8 compares key bytes. The inner key-compare uses the break-free
// `cont`-flag form (mirror of hxlcl_strstr) so it NEVER reads past a short entry's
// NUL — exactly the early-stop the C `while(i<nlen && entry[i] && …)` guarantees.
// The `int` return carries the raw value pointer (entry+nlen+1) unboxed, the same
// class as strchr/strstr returning a raw char* in rax/x0. '=' == 61.
//
// NOT @pure (touches external environ memory) · NO formula → no @cite/@grace (a
// byte-walk, like strchr/strstr). getenv-ONLY this round; setenv is the deferred
// sibling (it MUTATES environ — realloc/putenv array-rebuild semantics, a heavier
// wall) and stays on the libc-`setenv` shim delegate for now.
pub fn hxlcl_getenv(name: HexaVal) -> int {
    let pname = __hx_payload_add(name, 0)        // char* name (payload word)
    if __hx_payload_eq(pname, 0) {
        return 0                                  // NULL name → NULL
    }
    // nlen = strlen(name)
    let mut nlen = 0
    let mut nc = __hx_ptr_load8(pname, 0)         // name[0]
    while __hx_payload_ne(nc, 0) {
        nlen = __hx_payload_add(nlen, 1)
        nc = __hx_ptr_load8(pname, nlen)          // name[nlen]
    }
    let envpp = __hx_environ_ptr()                // &environ (char***)
    let mut e = __hx_ptr_load64(envpp, 0)         // environ (char** array base)
    if __hx_payload_eq(e, 0) {
        return 0                                  // environ == NULL → NULL
    }
    let mut entry = __hx_ptr_load64(e, 0)         // *e (first char* entry)
    while __hx_payload_ne(entry, 0) {             // while(*e)
        // i = 0; while(i<nlen && entry[i] && entry[i]==name[i]) i++;  (break-free)
        let mut i = 0
        let mut cont = 1
        while __hx_payload_ne(cont, 0) {
            if __hx_payload_ge(i, nlen) {
                cont = 0                          // i==nlen → full key prefix matched
            }
            if __hx_payload_ne(cont, 0) {
                let ce = __hx_ptr_load8(entry, i) // entry[i]
                if __hx_payload_eq(ce, 0) {
                    cont = 0                      // entry shorter than name → stop
                }
                if __hx_payload_ne(cont, 0) {
                    let cn = __hx_ptr_load8(pname, i)  // name[i]
                    if __hx_payload_ne(ce, cn) {
                        cont = 0                  // byte mismatch → stop
                    } else {
                        i = __hx_payload_add(i, 1)
                    }
                }
            }
        }
        if __hx_payload_eq(i, nlen) {             // i==nlen (full key matched)
            let eqc = __hx_ptr_load8(entry, nlen) // entry[nlen]
            if __hx_payload_eq(eqc, 61) {         // '=' → this is our variable
                let base = __hx_payload_add(entry, nlen)
                return __hx_payload_add(base, 1)  // entry + nlen + 1 (value ptr)
            }
        }
        e = __hx_payload_add(e, 8)                // e++ (next char* slot)
        entry = __hx_ptr_load64(e, 0)             // *e
    }
    return 0                                       // not found → NULL
}

// ── ENV MUTATE (Route C Wall 2-b sibling · environ WRITE-BACK via __hx_ptr_store64) ──
//
// hxlcl_setenv: set environment variable `name` to `value`. If it already exists and
// `overwrite` is non-zero replace its slot; if it exists and overwrite==0 leave it; if
// it is absent GROW the environ array. POSIX setenv(3). This is the FIRST Route C body
// to WRITE BACK to the `&environ` global — getenv (Wall 2-b) only READ it. The new
// capability is the final `__hx_ptr_store64(envpp, 0, newarr)`: storing a freshly-built
// char** array pointer into the slot __hx_environ_ptr() addresses (offset 0 of &environ
// == the `environ` pointer word itself). NO NEW INTRINSIC — it composes the already-
// whitelisted __hx_environ_ptr (returns &environ, #4098) + __hx_ptr_store64 (the writable
// pointer-word store, proven by hxlcl_strtoll's endptr write) + __hx_ptr_load64 (the
// getenv walk) + the inner C-ABI `bl hxlcl_malloc` (proven by strdup/calloc/realloc).
//
// REFERENCE-MATCH musl src/env/setenv.c + src/env/putenv.c (the canonical algorithm):
//   s = malloc(l1+l2+2); memcpy(s,name,l1); s[l1]='='; memcpy(s+l1+1,value,l2);
//   s[l1+l2+1]=0;                                  // build "name=value\0"
//   for(e=environ; *e; e++) if(!strncmp(*e,s,l1) && (*e)[l1]=='='){       // key match
//        if(!overwrite) return 0; *e=s; return 0; }                       // replace slot
//   N=count(environ); new=malloc((N+2)*8); copy N ptrs; new[N]=s; new[N+1]=0;
//   environ=new; return 0;                         // grow (fresh array on every grow)
// The faithful 0-libc floor SIMPLIFIES musl's __env_map leak-tracking: it allocates a
// FRESH array on every grow (fully correct — each grow re-reads the current environ and
// copies all live slots; it merely leaks the old array under the arena's no-free model,
// where the floor hxlcl_malloc is a bump allocator). POSIX EINVAL is honoured for
// name==NULL and empty name (→ -1). The embedded-'=' EINVAL case is NOT special-cased
// (frozen-floor callers pass '='-free names — documented deviation, deterministic either
// way: l1 = strlen up to the NUL). Slot-replace writes `*e = s` directly into the live
// environ array exactly like musl __putenv (the array word is writable — argv/envp on
// the stack, or a prior fresh malloc'd array).
//
// IN-BODY OPERATOR DISCIPLINE (Route C #4042 rule): every arithmetic/comparison is a raw
// __hx_payload_* intrinsic (never a bare op → PAIR-MODEL helper undefined in the raw-C-ABI
// link); each intrinsic result lands in its own un-nested `let`. '=' == 61.
pub fn hxlcl_setenv(name: HexaVal, value: HexaVal, overwrite: HexaVal) -> int {
    let pname = __hx_payload_add(name, 0)         // char* name (payload word)
    let pvalue = __hx_payload_add(value, 0)       // char* value (payload word)
    if __hx_payload_eq(pname, 0) {
        return __hx_payload_sub(0, 1)             // NULL name → EINVAL (-1)
    }
    // l1 = strlen(name)
    let mut l1 = 0
    let mut nc = __hx_ptr_load8(pname, 0)         // name[0]
    while __hx_payload_ne(nc, 0) {
        l1 = __hx_payload_add(l1, 1)
        nc = __hx_ptr_load8(pname, l1)            // name[l1]
    }
    if __hx_payload_eq(l1, 0) {
        return __hx_payload_sub(0, 1)             // empty name → EINVAL (-1)
    }
    // l2 = strlen(value)
    let mut l2 = 0
    let mut vc = __hx_ptr_load8(pvalue, 0)        // value[0]
    while __hx_payload_ne(vc, 0) {
        l2 = __hx_payload_add(l2, 1)
        vc = __hx_ptr_load8(pvalue, l2)           // value[l2]
    }
    // s = malloc(l1 + l2 + 2); build "name=value\0"
    let l12 = __hx_payload_add(l1, l2)            // l1 + l2
    let scap = __hx_payload_add(l12, 2)           // l1 + l2 + 2
    let s = hxlcl_malloc(scap)                    // C-ABI bl → raw ptr
    let mut i = 0
    while __hx_payload_lt(i, l1) {
        let b = __hx_ptr_load8(pname, i)          // name[i]
        __hx_ptr_store8(s, i, b)                  // s[i] = name[i]
        i = __hx_payload_add(i, 1)
    }
    __hx_ptr_store8(s, l1, 61)                    // s[l1] = '='
    let voff = __hx_payload_add(l1, 1)            // l1 + 1
    let mut j = 0
    while __hx_payload_lt(j, l2) {
        let b2 = __hx_ptr_load8(pvalue, j)        // value[j]
        let dst = __hx_payload_add(voff, j)       // l1 + 1 + j
        __hx_ptr_store8(s, dst, b2)               // s[l1+1+j] = value[j]
        j = __hx_payload_add(j, 1)
    }
    let term = __hx_payload_add(l12, 1)           // l1 + l2 + 1
    __hx_ptr_store8(s, term, 0)                   // s[l1+l2+1] = '\0'
    // walk environ: replace-on-match (return), else count N (for the grow path)
    let envpp = __hx_environ_ptr()                // &environ (char***)
    let arr = __hx_ptr_load64(envpp, 0)           // environ (char** base) or NULL
    let mut n = 0
    if __hx_payload_ne(arr, 0) {
        let mut e = __hx_payload_add(arr, 0)      // moving char** slot ptr
        let mut entry = __hx_ptr_load64(e, 0)     // *e (first char* entry)
        while __hx_payload_ne(entry, 0) {         // while(*e)
            // strncmp(entry, name, l1)==0 && entry[l1]=='='  (break-free key compare)
            let mut k = 0
            let mut cont = 1
            while __hx_payload_ne(cont, 0) {
                if __hx_payload_ge(k, l1) {
                    cont = 0                       // matched l1 bytes
                }
                if __hx_payload_ne(cont, 0) {
                    let ce = __hx_ptr_load8(entry, k)   // entry[k]
                    if __hx_payload_eq(ce, 0) {
                        cont = 0                   // entry shorter than name → no match
                    }
                    if __hx_payload_ne(cont, 0) {
                        let ck = __hx_ptr_load8(pname, k)  // name[k]
                        if __hx_payload_ne(ce, ck) {
                            cont = 0               // byte mismatch → no match
                        } else {
                            k = __hx_payload_add(k, 1)
                        }
                    }
                }
            }
            if __hx_payload_eq(k, l1) {           // full key prefix matched
                let eqc = __hx_ptr_load8(entry, l1)  // entry[l1]
                if __hx_payload_eq(eqc, 61) {     // '=' → same variable
                    if __hx_payload_eq(overwrite, 0) {
                        return 0                  // exists + no overwrite → success no-op
                    }
                    __hx_ptr_store64(e, 0, s)     // *e = s (replace slot in place)
                    return 0
                }
            }
            n = __hx_payload_add(n, 1)            // count this entry
            e = __hx_payload_add(e, 8)            // e++ (next char* slot)
            entry = __hx_ptr_load64(e, 0)         // *e
        }
    }
    // not found → GROW: new=malloc((n+2)*8); copy n ptrs; new[n]=s; new[n+1]=0; environ=new
    let n2 = __hx_payload_add(n, 2)               // n + 2
    let bytes = __hx_payload_mul(n2, 8)           // (n+2) * 8
    let newarr = hxlcl_malloc(bytes)              // C-ABI bl → raw ptr
    let mut c = 0
    while __hx_payload_lt(c, n) {
        let off = __hx_payload_mul(c, 8)          // c * 8
        let oldp = __hx_ptr_load64(arr, off)      // environ[c]
        __hx_ptr_store64(newarr, off, oldp)       // newarr[c] = environ[c]
        c = __hx_payload_add(c, 1)
    }
    let noff = __hx_payload_mul(n, 8)             // n * 8
    __hx_ptr_store64(newarr, noff, s)             // newarr[n] = s
    let noff1 = __hx_payload_add(noff, 8)         // (n+1) * 8
    __hx_ptr_store64(newarr, noff1, 0)            // newarr[n+1] = NULL
    __hx_ptr_store64(envpp, 0, newarr)            // environ = newarr (WRITE-BACK)
    return 0
}

// ── PARSE FAMILY (Route C batch G · pure-compute leaf with an OUT-PARAM write) ──
//
// hxlcl_strtoll is the string family's last leaf: a from-scratch string→long long
// parse (whitespace skip · sign · base-0/16 prefix · digit accumulation) that, on
// success, also writes the parse-end position back through the caller's `char**
// endptr` out-param. That endptr write is the FIRST raw-pointer store64 a Route C
// body issues to a CALLER-PROVIDED out-pointer — but it is the SAME class as the
// copy family's caller-`dst` writes (strcpy/strncpy/strcat → __hx_ptr_store8 into
// the caller's buffer, all merged byteeq-green), here widened to __hx_ptr_store64
// for the pointer word and NULL-gated (endptr may be NULL — both callers below
// sometimes pass NULL). It is NOT the errno-store extern-data class (#4042): no
// __errno_location call, no syscall, no target-gating, no darwin carry-flag — a
// plain store to a param pointer. Pure compute otherwise → cross-target-identical
// (no NR, no arm64 call-shape divergence), like the strchr/strstr search leaves.
//
// IN-BODY OPERATOR DISCIPLINE (Route C, the #4042 rule): every arithmetic /
// comparison op is a raw-payload intrinsic (__hx_payload_{add,sub,mul,and,eq,ne,
// lt,le,ge}) — never a bare `<`/`-`/`*`, which would lower to the PAIR-MODEL
// helpers (hexa_cmp_lt / hexa_sub / …) undefined in the raw-C-ABI link. Each
// intrinsic result lands in its own `let` (un-nested) so a codegen scratch
// clobber cannot corrupt an outer op (the close/compare-family rule). The moving
// `const char *s` of the C body is modelled as a base pointer `p` (the raw nptr
// payload) + an index `i`; loads are __hx_ptr_load8(p, i) (ZERO-EXTENDED, exactly
// matching the digit-range behaviour of the C `char c = *s` — bytes ≥ 0x80 fall
// out of every ['0'..'9'],['a'..'z'],['A'..'Z'] range and stop the scan, the same
// as the C body's signed-or-unsigned-char break). `break` is avoided in the
// frozen-parser style (hxlcl_strncpy / hxlcl_strstr): each loop stops by clearing
// a `cont` flag. The endptr (s = p + i) is written via __hx_ptr_store64.
//
// endptr IS live (not dead): self/runtime.c routes `strtoll(p,&endptr,base)` →
// hxlcl_strtoll in hexa_str_parse_int (:4347, `if (endptr == p) throw`) and
// hexa_pinned_epoch (:12015, `if (endp != sde)`), so a wrong/absent endptr write
// would break those — the smoke asserts the endptr value-exact (== nptr + len).
//
// BYTE-FAITHFUL to the frozen 0-libc floor self/runtime.c:513 (hxlcl_strtoll) /
// the byte-identical shim runtime_core_hxlcl_shim.c:404. Char codes: ' '=32
// '\t'=9 '\n'=10 '-'=45 '+'=43 '0'=48 '9'=57 'x'=120 'X'=88 'a'=97 'z'=122
// 'A'=65 'Z'=90. The unsigned-accumulation `n = n*base + d` uses signed
// __hx_payload_mul/_add: bit-identical to the C body for any non-overflowing
// value (the real callers parse small env/limit strings), overflow is the same
// wrap-UB-adjacent territory as the C body and unobserved here.
pub fn hxlcl_strtoll(nptr: HexaVal, endptr: HexaVal, base: HexaVal) -> int {
    let p = __hx_payload_add(nptr, 0)          // const char* s = nptr (raw)
    let pe = __hx_payload_add(endptr, 0)       // char** endptr (raw, may be NULL)
    // NULL nptr: if (!nptr) { if (endptr) *endptr = nptr; return 0; }
    if __hx_payload_eq(p, 0) {
        if __hx_payload_ne(pe, 0) {
            __hx_ptr_store64(pe, 0, p)         // *endptr = (char*)nptr (NULL)
        }
        return 0
    }
    let mut b = __hx_payload_add(base, 0)      // int base (raw)
    let mut i = 0
    // whitespace skip: while(*s==' '||*s=='\t'||*s=='\n') s++;
    let mut ws = __hx_ptr_load8(p, i)
    let mut wcont = 1
    while __hx_payload_ne(wcont, 0) {
        let is_sp = __hx_payload_eq(ws, 32)
        let is_tab = __hx_payload_eq(ws, 9)
        let is_nl = __hx_payload_eq(ws, 10)
        let a1 = __hx_payload_add(is_sp, is_tab)
        let a2 = __hx_payload_add(a1, is_nl)
        if __hx_payload_ne(a2, 0) {
            i = __hx_payload_add(i, 1)
            ws = __hx_ptr_load8(p, i)
        } else {
            wcont = 0
        }
    }
    // sign: if(*s=='-'){sign=-1;s++;} else if(*s=='+')s++;
    let cs = __hx_ptr_load8(p, i)
    let mut neg = 0
    if __hx_payload_eq(cs, 45) {                // '-'
        neg = 1
        i = __hx_payload_add(i, 1)
    } else {
        if __hx_payload_eq(cs, 43) {            // '+'
            i = __hx_payload_add(i, 1)
        }
    }
    // base prefix: base-0 auto-detect (0x→16, 0→8, else 10); base-16 0x-skip.
    let i1 = __hx_payload_add(i, 1)
    let c0 = __hx_ptr_load8(p, i)
    let c1 = __hx_ptr_load8(p, i1)
    let is0 = __hx_payload_eq(c0, 48)           // s[0]=='0'
    let isx = __hx_payload_eq(c1, 120)          // s[1]=='x'
    let isX = __hx_payload_eq(c1, 88)           // s[1]=='X'
    let isxX = __hx_payload_add(isx, isX)       // 1 iff s[1] in {x,X} (exclusive)
    if __hx_payload_eq(b, 0) {
        if __hx_payload_ne(is0, 0) {
            if __hx_payload_ne(isxX, 0) {
                b = 16
                i = __hx_payload_add(i, 2)
            } else {
                b = 8
                i = __hx_payload_add(i, 1)
            }
        } else {
            b = 10
        }
    } else {
        if __hx_payload_eq(b, 16) {
            if __hx_payload_ne(is0, 0) {
                if __hx_payload_ne(isxX, 0) {
                    i = __hx_payload_add(i, 2)
                }
            }
        }
    }
    // digit accumulation: for(;;){ d=digit(c); if(none||d>=base) break;
    //                              n = n*base + d; s++; }
    let mut n = 0
    let mut cont = 1
    while __hx_payload_ne(cont, 0) {
        let c = __hx_ptr_load8(p, i)
        let mut isdig = 0
        let mut d = 0
        let ge0 = __hx_payload_ge(c, 48)        // c>='0'
        let le9 = __hx_payload_le(c, 57)        // c<='9'
        let is09 = __hx_payload_and(ge0, le9)
        if __hx_payload_ne(is09, 0) {
            isdig = 1
            d = __hx_payload_sub(c, 48)         // c-'0'
        } else {
            let gea = __hx_payload_ge(c, 97)    // c>='a'
            let lez = __hx_payload_le(c, 122)   // c<='z'
            let isaz = __hx_payload_and(gea, lez)
            if __hx_payload_ne(isaz, 0) {
                isdig = 1
                let da = __hx_payload_sub(c, 97)
                d = __hx_payload_add(da, 10)    // c-'a'+10
            } else {
                let geA = __hx_payload_ge(c, 65)  // c>='A'
                let leZ = __hx_payload_le(c, 90)  // c<='Z'
                let isAZ = __hx_payload_and(geA, leZ)
                if __hx_payload_ne(isAZ, 0) {
                    isdig = 1
                    let dA = __hx_payload_sub(c, 65)
                    d = __hx_payload_add(dA, 10)  // c-'A'+10
                }
            }
        }
        if __hx_payload_eq(isdig, 0) {
            cont = 0                            // non-digit → stop
        } else {
            if __hx_payload_ge(d, b) {
                cont = 0                        // digit out of base → stop
            } else {
                let nb = __hx_payload_mul(n, b)
                n = __hx_payload_add(nb, d)     // n = n*base + d
                i = __hx_payload_add(i, 1)
            }
        }
    }
    // if (endptr) *endptr = (char *)s;   (s = nptr + i)
    let endp = __hx_payload_add(p, i)
    if __hx_payload_ne(pe, 0) {
        __hx_ptr_store64(pe, 0, endp)
    }
    // return (sign < 0) ? -n : n;
    if __hx_payload_ne(neg, 0) {
        let r = __hx_payload_sub(0, n)
        return r
    }
    return n
}

// ── PARSE MIRROR (Route C · strtoull) ─────────────────────────────────────────
//
// hxlcl_strtoull is the EXACT unsigned mirror of hxlcl_strtoll above — same parse
// leaf class, adding NO new codegen mechanism: same whitespace skip, same base-0/16
// prefix detection, same digit-accumulation loop, and the SAME NULL-gated `char**
// endptr` store64 out-param write (the already-merged caller-pointer store class).
// The ONLY two differences from strtoll: (a) no '-' sign — the C body skips a
// leading '+' but never negates; (b) the result is the raw unsigned accumulation
// `n`, returned directly (no sign branch). Pure compute otherwise → cross-target-
// identical (no NR, no arm64 call-shape divergence), like strtoll.
//
// Same IN-BODY OPERATOR DISCIPLINE as strtoll: every op is a raw-payload intrinsic
// (__hx_payload_{add,sub,mul,and,eq,ne,lt,le,ge}) in its own un-nested `let`, loads
// are __hx_ptr_load8 (ZERO-EXTENDED — bytes ≥ 0x80 fall out of every digit range
// and stop the scan), the endptr is __hx_ptr_store64. BYTE-FAITHFUL to the frozen
// 0-libc floor self/runtime.c:542 (hxlcl_strtoull). Char codes as in strtoll.
pub fn hxlcl_strtoull(nptr: HexaVal, endptr: HexaVal, base: HexaVal) -> int {
    let p = __hx_payload_add(nptr, 0)          // const char* s = nptr (raw)
    let pe = __hx_payload_add(endptr, 0)       // char** endptr (raw, may be NULL)
    // NULL nptr: if (!nptr) { if (endptr) *endptr = nptr; return 0; }
    if __hx_payload_eq(p, 0) {
        if __hx_payload_ne(pe, 0) {
            __hx_ptr_store64(pe, 0, p)         // *endptr = (char*)nptr (NULL)
        }
        return 0
    }
    let mut b = __hx_payload_add(base, 0)      // int base (raw)
    let mut i = 0
    // whitespace skip: while(*s==' '||*s=='\t'||*s=='\n') s++;
    let mut ws = __hx_ptr_load8(p, i)
    let mut wcont = 1
    while __hx_payload_ne(wcont, 0) {
        let is_sp = __hx_payload_eq(ws, 32)
        let is_tab = __hx_payload_eq(ws, 9)
        let is_nl = __hx_payload_eq(ws, 10)
        let a1 = __hx_payload_add(is_sp, is_tab)
        let a2 = __hx_payload_add(a1, is_nl)
        if __hx_payload_ne(a2, 0) {
            i = __hx_payload_add(i, 1)
            ws = __hx_ptr_load8(p, i)
        } else {
            wcont = 0
        }
    }
    // sign: if(*s=='+')s++;   (strtoull has NO '-' negate)
    let cs = __hx_ptr_load8(p, i)
    if __hx_payload_eq(cs, 43) {                // '+'
        i = __hx_payload_add(i, 1)
    }
    // base prefix: base-0 auto-detect (0x→16, 0→8, else 10); base-16 0x-skip.
    let i1 = __hx_payload_add(i, 1)
    let c0 = __hx_ptr_load8(p, i)
    let c1 = __hx_ptr_load8(p, i1)
    let is0 = __hx_payload_eq(c0, 48)           // s[0]=='0'
    let isx = __hx_payload_eq(c1, 120)          // s[1]=='x'
    let isX = __hx_payload_eq(c1, 88)           // s[1]=='X'
    let isxX = __hx_payload_add(isx, isX)       // 1 iff s[1] in {x,X} (exclusive)
    if __hx_payload_eq(b, 0) {
        if __hx_payload_ne(is0, 0) {
            if __hx_payload_ne(isxX, 0) {
                b = 16
                i = __hx_payload_add(i, 2)
            } else {
                b = 8
                i = __hx_payload_add(i, 1)
            }
        } else {
            b = 10
        }
    } else {
        if __hx_payload_eq(b, 16) {
            if __hx_payload_ne(is0, 0) {
                if __hx_payload_ne(isxX, 0) {
                    i = __hx_payload_add(i, 2)
                }
            }
        }
    }
    // digit accumulation: for(;;){ d=digit(c); if(none||d>=base) break;
    //                              n = n*base + d; s++; }
    let mut n = 0
    let mut cont = 1
    while __hx_payload_ne(cont, 0) {
        let c = __hx_ptr_load8(p, i)
        let mut isdig = 0
        let mut d = 0
        let ge0 = __hx_payload_ge(c, 48)        // c>='0'
        let le9 = __hx_payload_le(c, 57)        // c<='9'
        let is09 = __hx_payload_and(ge0, le9)
        if __hx_payload_ne(is09, 0) {
            isdig = 1
            d = __hx_payload_sub(c, 48)         // c-'0'
        } else {
            let gea = __hx_payload_ge(c, 97)    // c>='a'
            let lez = __hx_payload_le(c, 122)   // c<='z'
            let isaz = __hx_payload_and(gea, lez)
            if __hx_payload_ne(isaz, 0) {
                isdig = 1
                let da = __hx_payload_sub(c, 97)
                d = __hx_payload_add(da, 10)    // c-'a'+10
            } else {
                let geA = __hx_payload_ge(c, 65)  // c>='A'
                let leZ = __hx_payload_le(c, 90)  // c<='Z'
                let isAZ = __hx_payload_and(geA, leZ)
                if __hx_payload_ne(isAZ, 0) {
                    isdig = 1
                    let dA = __hx_payload_sub(c, 65)
                    d = __hx_payload_add(dA, 10)  // c-'A'+10
                }
            }
        }
        if __hx_payload_eq(isdig, 0) {
            cont = 0                            // non-digit → stop
        } else {
            if __hx_payload_ge(d, b) {
                cont = 0                        // digit out of base → stop
            } else {
                let nb = __hx_payload_mul(n, b)
                n = __hx_payload_add(nb, d)     // n = n*base + d
                i = __hx_payload_add(i, 1)
            }
        }
    }
    // if (endptr) *endptr = (char *)s;   (s = nptr + i)
    let endp = __hx_payload_add(p, i)
    if __hx_payload_ne(pe, 0) {
        __hx_ptr_store64(pe, 0, endp)
    }
    return n                                    // unsigned: no sign branch
}

// ── COMPOSITE FAMILY (Route C r7 · non-leaf — inner C-ABI bl to a sibling) ──
//
// COMPOSITE = the body is not a self-contained byte loop; it CALLS another
// hxlcl_* symbol. The Route C call-boundary keys on the CALLEE name
// (`_is_cabi(s.op)` · compiler/codegen/x86_64_linux.hexa:2482 · arm64_darwin.hexa
// _is_cabi(s.op)), so whitelisting BOTH the outer fn AND its inner callee makes
// the inner `bl` lower at the single-register C-ABI (arg payload → rdi/x0, raw
// result ← rax/x0) and bind cross-object to the callee. This dissolves the
// composite "wall" the earlier closure enumerated: that wall held ONLY for an
// UN-whitelisted callee (PAIR-MODEL inner call vs raw-C-ABI shim = mismatch); a
// whitelisted callee is C-ABI on both sides.
//
// PoC POLARITY (r7 = atoi only): hxlcl_atoi gets a Route C body whose sole op is
// the inner `bl hxlcl_atoll`; hxlcl_atoll stays the RETAINED C shim
// (runtime_core_hxlcl_shim.c:385 — `long long hxlcl_atoll(const char*)`), declared
// here as an `extern fn` (no body → undefined-external symbol resolved at link by
// the shim, mirroring the SELFEMIT seed test/native_build/emit_hxlcl_atoi_o.hexa's
// undefined-external `_hxlcl_atoll` + ARM64_RELOC_BRANCH26). atoll is whitelisted
// purely so the inner call lowers C-ABI — it is NOT self-emitted in this round.
// The int truncation (`(int)hxlcl_atoll`) is implicit: the result register carries
// the value and a C `int` caller reads only the low 32 bits.

// ── PARSE LEAF PROMOTION (Route C · atoll real leaf) ──────────────────────────
//
// hxlcl_atoll was the RETAINED C shim extern that hxlcl_atoi (and the libc `atoll`
// macro) bl into. This round PROMOTES it to a real self-emitted leaf — the
// composite extern becomes a genuine Route C leaf, so atoi's inner `bl hxlcl_atoll`
// now binds cross-object to THIS hexa-emitted body (within routec.o) instead of the
// harness/shim atoll. It is a strict SIMPLIFICATION of hxlcl_strtoll above: base is
// FIXED at 10 (no base-0/16 auto-detect, no 0x prefix skip) and there is NO endptr
// out-param (no __hx_ptr_store64) — a pure-compute byte-walk parse with no syscall,
// no errno, no inner call, no float. Cross-target-identical (no NR / no arm64 call-
// shape divergence), exactly the strtoll/strtoull parse-leaf class.
//
// Same IN-BODY OPERATOR DISCIPLINE as strtoll: every op is a raw-payload intrinsic
// (__hx_payload_{add,sub,mul,and,eq,ne,ge,le}) in its own un-nested `let`; loads are
// __hx_ptr_load8 (ZERO-EXTENDED — bytes ≥ 0x80 fall out of the ['0'..'9'] range and
// stop the scan, matching the C `s[i] >= '0' && s[i] <= '9'` break); `break` is
// avoided in the frozen-parser style (each loop stops by clearing a `cont` flag).
//
// BYTE-FAITHFUL to the frozen 0-libc floor body (self/runtime_emit_full.hexa:2352,
// the #else hxlcl_atoll fallback = lenient decimal):
//   if(!s) return 0; i=0; while(s[i]==' '||'\t'||'\n') i++;
//   sign=1; if(s[i]=='-'){sign=-1;i++;} else if(s[i]=='+')i++;
//   n=0; while(s[i]>='0'&&s[i]<='9'){ n=n*10+(s[i]-'0'); i++; }
//   return (sign<0)? -n : n;
// (the unsigned-accumulation of the C body uses signed __hx_payload_mul/_add: bit-
// identical for any non-overflowing value — the real callers parse small ints.)
// Under the Route C gate the param arrives raw in rdi/x0 and the result ships raw in
// rax/x0; default (gate OFF) compiles as a HexaVal fn (byteeq-neutral).
pub fn hxlcl_atoll(s: HexaVal) -> int {
    let p = __hx_payload_add(s, 0)             // const char* s (raw)
    if __hx_payload_eq(p, 0) {
        return 0                               // if(!s) return 0
    }
    let mut i = 0
    // whitespace skip: while(s[i]==' '||s[i]=='\t'||s[i]=='\n') i++;
    let mut ws = __hx_ptr_load8(p, i)
    let mut wcont = 1
    while __hx_payload_ne(wcont, 0) {
        let is_sp = __hx_payload_eq(ws, 32)
        let is_tab = __hx_payload_eq(ws, 9)
        let is_nl = __hx_payload_eq(ws, 10)
        let a1 = __hx_payload_add(is_sp, is_tab)
        let a2 = __hx_payload_add(a1, is_nl)
        if __hx_payload_ne(a2, 0) {
            i = __hx_payload_add(i, 1)
            ws = __hx_ptr_load8(p, i)
        } else {
            wcont = 0
        }
    }
    // sign: if(s[i]=='-'){neg;i++;} else if(s[i]=='+')i++;
    let cs = __hx_ptr_load8(p, i)
    let mut neg = 0
    if __hx_payload_eq(cs, 45) {                // '-'
        neg = 1
        i = __hx_payload_add(i, 1)
    } else {
        if __hx_payload_eq(cs, 43) {            // '+'
            i = __hx_payload_add(i, 1)
        }
    }
    // digit accumulation (base 10): while(s[i] in ['0'..'9']) n = n*10 + (s[i]-'0');
    let mut n = 0
    let mut cont = 1
    while __hx_payload_ne(cont, 0) {
        let c = __hx_ptr_load8(p, i)
        let ge0 = __hx_payload_ge(c, 48)        // c>='0'
        let le9 = __hx_payload_le(c, 57)        // c<='9'
        let is09 = __hx_payload_and(ge0, le9)
        if __hx_payload_eq(is09, 0) {
            cont = 0                            // non-digit → stop
        } else {
            let d = __hx_payload_sub(c, 48)     // c-'0'
            let nb = __hx_payload_mul(n, 10)
            n = __hx_payload_add(nb, d)         // n = n*10 + d
            i = __hx_payload_add(i, 1)
        }
    }
    // return (sign < 0) ? -n : n;
    if __hx_payload_ne(neg, 0) {
        let r = __hx_payload_sub(0, n)
        return r
    }
    return n
}

// hxlcl_atoi: parse `s` as int by delegating to hxlcl_atoll. BYTE-FAITHFUL to
// runtime_core_hxlcl_shim.c:396 (`int hxlcl_atoi(const char *s){return (int)hxlcl_atoll(s);}`).
// Under the Route C gate the param arrives raw in rdi/x0, the inner `bl hxlcl_atoll`
// is a C-ABI call (s → rdi/x0, result ← rax/x0), and the return ships that result
// raw; under the default (gate OFF) it compiles as an ordinary HexaVal fn
// (byteeq-neutral — never linked in that mode).
pub fn hxlcl_atoi(s: HexaVal) -> int {
    return hxlcl_atoll(s)
}

// ── COMPOSITE FAMILY r8 (strdup → inner C-ABI bl hxlcl_malloc + byte loops) ──
//
// strdup is the r8 composite: a NON-LEAF that mixes inline byte loops (strlen
// scan + copy) with ONE inner C-ABI call `bl hxlcl_malloc`. Same dissolve as
// atoi — whitelisting BOTH hxlcl_strdup AND its inner callee hxlcl_malloc makes
// the inner `bl` lower single-register C-ABI (size → rdi/x0, raw ptr ← rax/x0)
// and bind cross-object. hxlcl_malloc stays the RETAINED C shim
// (runtime_core_hxlcl_shim.c:101 — `void *hxlcl_malloc(size_t)` = malloc delegate;
// NOT self-emitted this round), declared as an `extern fn` (undefined-external,
// resolved at link) mirroring the SELFEMIT seed
// test/native_build/emit_hxlcl_strdup_o.hexa (112 B: frame + strlen loop +
// `bl _hxlcl_malloc` BRANCH26 @0x30 + copy loop + NULL/return epilogue).

// hxlcl_malloc: raw-C-ABI allocator — RETAINED C shim (not self-emitted this
// round). Declared so hxlcl_strdup's inner call binds C-ABI at link.
extern fn hxlcl_malloc(n: HexaVal) -> int

// hxlcl_strdup: duplicate NUL-terminated `s` into a fresh malloc'd buffer,
// return it. BYTE-FAITHFUL to runtime_core_hxlcl_shim.c:333 (hxlcl_strdup):
//   n=0; while(s[n]) n++; out=hxlcl_malloc(n+1); for(i<n) out[i]=s[i];
//   out[n]='\0'; return out.
// (the NULL guard is the caller's responsibility on this PoC path — the frozen
// runtime never calls strdup with NULL, same precondition as the SELFEMIT seed.)
// Under the Route C gate the param arrives raw in rdi/x0; the inner
// `bl hxlcl_malloc` is C-ABI (size → rdi/x0, ptr ← rax/x0); the return ships the
// out pointer raw. Default (gate OFF) compiles as a HexaVal fn (byteeq-neutral).
pub fn hxlcl_strdup(s: HexaVal) -> int {
    let ps = __hx_payload_add(s, 0)           // src char* (payload word)
    let mut n = 0
    let mut c = __hx_ptr_load8(ps, 0)         // s[0]
    while __hx_payload_ne(c, 0) {
        n = __hx_payload_add(n, 1)
        c = __hx_ptr_load8(ps, n)             // s[n]
    }
    let cap = __hx_payload_add(n, 1)          // n + 1 (incl. terminator)
    let out = hxlcl_malloc(cap)               // C-ABI bl → raw ptr
    let mut i = 0
    while __hx_payload_lt(i, n) {
        let b = __hx_ptr_load8(ps, i)         // s[i]
        __hx_ptr_store8(out, i, b)            // out[i] = s[i]
        i = __hx_payload_add(i, 1)
    }
    __hx_ptr_store8(out, n, 0)                // out[n] = '\0'
    return out
}

// ── DUP MIRROR (Route C · strndup) ────────────────────────────────────────────
//
// hxlcl_strndup is the EXACT mirror of the r8 strdup composite above — same inner
// C-ABI `bl hxlcl_malloc` + strlen-scan + copy + NUL-terminate byte loops, adding
// NO new codegen mechanism. The ONLY difference is the scan loop is CAP-BOUNDED
// (`while(n<cap && s[n]) n++`): the `n < cap` test is a `__hx_payload_lt(n, cap)`
// guard already used throughout, and the `&&` short-circuit is expanded into the
// un-nested two-condition stop-flag form (the frozen-parser `cont`-flag style) so
// no `&&` lowers to a HexaVal helper. The inner callee hxlcl_malloc is the SAME
// `extern fn hxlcl_malloc` declared above (shared with strdup/calloc/realloc).
//
// BYTE-FAITHFUL to the frozen 0-libc floor self/runtime.c:481 (hxlcl_strndup):
//   if(!s) return NULL; n=0; while(n<cap && s[n]) n++; out=hxlcl_malloc(n+1);
//   for(i<n) out[i]=s[i]; out[n]='\0'; return out.
// The `if(!out) return NULL` malloc-failure guard is elided as a caller-precondition
// on this PoC path (the floor hxlcl_malloc is a never-failing bump allocator), the
// SAME precondition strdup's Route C body uses. Under the Route C gate the two args
// arrive raw in rdi,rsi / x0,x1, the inner `bl hxlcl_malloc` is C-ABI, and the
// return ships the out pointer raw. Default (gate OFF) compiles as a HexaVal fn
// (byteeq-neutral — never linked in that mode).
pub fn hxlcl_strndup(s: HexaVal, cap: HexaVal) -> int {
    let ps = __hx_payload_add(s, 0)           // src char* (payload word)
    if __hx_payload_eq(ps, 0) {
        return 0                              // NULL s → NULL (frozen `if(!s)`)
    }
    // cap-bounded strlen scan: while(n<cap && s[n]) n++   (un-nested && form)
    let mut n = 0
    let mut scont = 1
    while __hx_payload_ne(scont, 0) {
        let lt = __hx_payload_lt(n, cap)      // n < cap
        if __hx_payload_eq(lt, 0) {
            scont = 0                          // n >= cap → stop
        } else {
            let c = __hx_ptr_load8(ps, n)     // s[n]
            if __hx_payload_eq(c, 0) {
                scont = 0                      // NUL → stop
            } else {
                n = __hx_payload_add(n, 1)
            }
        }
    }
    let total = __hx_payload_add(n, 1)        // n + 1 (incl. terminator)
    let out = hxlcl_malloc(total)             // C-ABI bl → raw ptr
    let mut i = 0
    while __hx_payload_lt(i, n) {
        let b = __hx_ptr_load8(ps, i)         // s[i]
        __hx_ptr_store8(out, i, b)            // out[i] = s[i]
        i = __hx_payload_add(i, 1)
    }
    __hx_ptr_store8(out, n, 0)                // out[n] = '\0'
    return out
}

// ── COMPOSITE FAMILY r9 (calloc → inner C-ABI bl hxlcl_malloc + zero loop) ──
//
// calloc = composite with ZERO new codegen patterns vs already-merged symbols:
//   • inner `bl hxlcl_malloc` — ON-path confirmed by hxlcl_strdup's routec-smoke.
//   • zero-loop `__hx_ptr_store8` — ON-path confirmed by hxlcl_memset.
// Its inner callee hxlcl_malloc is the SAME extern declared above (shared with
// hxlcl_strdup — not re-declared). Self-covering: this round adds the calloc
// behaviour assert to tool/routec_cabi_smoke.sh, so the routec-smoke job emits +
// links + runs calloc directly (not seed shape-match inference).

// hxlcl_calloc: allocate nmemb*size zeroed bytes, return the buffer. BYTE-FAITHFUL
// to runtime_core_hxlcl_shim.c:132 (the BYTEID 0-libc floor body):
//   total = nmemb*size; p = hxlcl_malloc(total); if(p) for(i<total) p[i]=0; ret p.
// (the frozen runtime never calls calloc with a 0×0 → malloc(0); same precondition
// as the other composites.) Under the Route C gate the two size args arrive raw in
// rdi,rsi / x0,x1, the inner `bl hxlcl_malloc` is C-ABI, and the return ships the
// buffer pointer raw. Default (gate OFF) compiles as a HexaVal fn (byteeq-neutral).
pub fn hxlcl_calloc(nmemb: HexaVal, size: HexaVal) -> int {
    let total = __hx_payload_mul(nmemb, size)  // nmemb * size
    let p = hxlcl_malloc(total)                // C-ABI bl → raw ptr
    let mut i = 0
    while __hx_payload_lt(i, total) {
        __hx_ptr_store8(p, i, 0)               // p[i] = 0
        i = __hx_payload_add(i, 1)
    }
    return p
}

// ── COMPOSITE FAMILY r10 (realloc → inner bl malloc + NEGATIVE-OFFSET header read) ──
//
// realloc is the LAST composite. Its load-bearing NEW codegen pattern is the
// header read `*(size_t *)((char *)p - HXLCL_HDR_BYTES)` — a `__hx_ptr_load64`
// at a NEGATIVE offset (p - 16). No prior Route C symbol exercised a negative
// ptr-load, so the routec-smoke job gains a dedicated realloc behaviour assert
// (the first ON-path verification of this pattern). The negative offset is
// expressible because both backends lower `__hx_ptr_load64(ptr, off)` as a plain
// 64-bit register add `addr = ptr + off` (x86_64_linux.hexa:2453 `add r10,r11` /
// arm64_darwin.hexa:2295 `add x1,x1,x3`) — a negative `off` payload (here via
// `__hx_payload_sub(0, 16)`) yields `ptr - 16` with no special handling.
//
// BYTE-FAITHFUL to runtime_core_hxlcl_shim.c:112 (the BYTEID 0-libc floor body):
//   if(!p) return malloc(n); if(n==0) return 0; np=malloc(n); if(!np) return 0;
//   old_n=*(size_t*)(p-16); copy_n=min(n,old_n); memcpy(np,p,copy_n); return np.
// PoC precondition (same as the other composites): the frozen runtime calls
// hxlcl_realloc only with a non-NULL p that carries the 16-byte size header the
// floor hxlcl_malloc writes, and n>0 — so the NULL/n==0 guards are the caller's
// responsibility on this path. The smoke harness's hxlcl_malloc writes the same
// 16-byte header so the header read is meaningful (see tool/routec_cabi_smoke.sh).

// hxlcl_realloc: grow/shrink `p` to `n` bytes, preserving min(n, old_n) content.
pub fn hxlcl_realloc(p: HexaVal, n: HexaVal) -> int {
    let pp = __hx_payload_add(p, 0)            // old buffer (payload word)
    let np = hxlcl_malloc(n)                   // C-ABI bl → new raw ptr
    let neg_hdr = __hx_payload_sub(0, 16)      // -HXLCL_HDR_BYTES
    let old_n = __hx_ptr_load64(pp, neg_hdr)   // *(size_t*)(p - 16)
    let mut copy_n = n
    if __hx_payload_lt(old_n, n) {
        copy_n = old_n                         // copy_n = min(n, old_n)
    }
    let mut i = 0
    while __hx_payload_lt(i, copy_n) {
        let b = __hx_ptr_load8(pp, i)          // p[i]
        __hx_ptr_store8(np, i, b)              // np[i] = p[i]
        i = __hx_payload_add(i, 1)
    }
    return np
}

// ── SYSCALL FAMILY (Route C r11 · errno-free 0-arg leaf — first syscall body) ──
//
// hxlcl_getpid is the FIRST Route C leaf whose body ISSUES A SYSCALL (not a raw
// memory walk). It proves the Route C C-ABI lowering composes with the syscall
// intrinsic on the ERRNO-FREE subset:
//   - 0 args + cannot-fail: getpid never errors (no errno / carry-flag path —
//     identical to getuid), so the body returns the kernel pid RAW in the single
//     C-ABI result register with NO errno store. (errno-bearing syscalls —
//     close/read/lseek/stat/dup2/mkdir/waitpid — additionally need to write the
//     C global `errno`, which hexa source has no extern-data-write intrinsic for:
//     a measured wall deferred to a separate extern-data substrate round.)
//   - the per-OS trap is already emitted by the backend's `__hx_syscall0`
//     (x86_64 `syscall` / arm64 `svc #0x80`|`svc #0`, x86_64_linux.hexa:2392 /
//     arm64_darwin.hexa:2190), so the body only selects the per-target NUMBER.
//
// PER-TARGET getpid NR (compile-time consts → DCE drops the dead branch):
//   Linux x86_64 = 39   (stdlib/posix/linux_syscalls.hexa:124, syscall_64.tbl)
//   Linux arm64  = 172  (stdlib/posix/linux_syscalls.hexa:96, asm-generic)
//   Darwin arm64 = 20   (SYS_GETPID | 0x2000000 baked by __hx_syscall0's BSD trap
//                        path; the bare 20 here matches the seed
//                        test/native_build/emit_hxlcl_getpid_o.hexa `mov w16,#20`).
//
// BYTE-FAITHFUL to the C floor (self/runtime_emit_full.hexa:1662):
//   hxlcl_getpid(void) { return (int)_hxlcl_syscall1(HXLCL_SYS_GETPID, 0); }
// (0-arg under the unified syscall0; the floor passes a dummy 0 to its syscall1
// helper, but the kernel ignores args for getpid).
pub fn hxlcl_getpid() -> int {
    let mut nr = 20                            // Darwin SYS_GETPID (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 39 }      // Linux x86_64 __NR_getpid
        else { nr = 172 }                      // Linux arm64 __NR_getpid
    }
    return __hx_syscall0(nr)                    // kernel pid → raw C-ABI result reg
}

// r2 — errno-free 0-arg family chain (getpid mirror). Each is class-C
// cannot-fail (no errno / carry-flag path), so the body returns the raw kernel
// value in the single C-ABI result register with NO errno store, exactly like
// getpid. Per-target NR via compile-time target_is_* consts (DCE drops the dead
// branch). NR ref-match (no black-box):
//   getuid : x86_64 102 · arm64 174 · darwin 24   (syscall_64.tbl / asm-generic
//            unistd.h __NR_getuid 174 / runtime.c HXLCL_SYS_GETUID 24)
//   getgid : x86_64 104 · arm64 176 · darwin 47
//   getppid: x86_64 110 · arm64 173 · darwin 39
//   geteuid: x86_64 107 · arm64 175 · darwin 25
//   getegid: x86_64 108 · arm64 177 · darwin 43
// (Linux x86_64 = syscall_64.tbl · Linux arm64 = include/uapi/asm-generic/
// unistd.h · darwin = runtime.c HXLCL_SYS_* table, matching the floor bodies
// self/runtime.c:1690-1719 `_hxlcl_syscall1(HXLCL_SYS_GET*, 0)`.)

pub fn hxlcl_getuid() -> int {
    let mut nr = 24                            // Darwin SYS_GETUID (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 102 }     // Linux x86_64 __NR_getuid
        else { nr = 174 }                      // Linux arm64 __NR_getuid
    }
    return __hx_syscall0(nr)                    // uid → raw C-ABI result reg
}

pub fn hxlcl_getgid() -> int {
    let mut nr = 47                            // Darwin SYS_GETGID (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 104 }     // Linux x86_64 __NR_getgid
        else { nr = 176 }                      // Linux arm64 __NR_getgid
    }
    return __hx_syscall0(nr)                    // gid → raw C-ABI result reg
}

pub fn hxlcl_getppid() -> int {
    let mut nr = 39                            // Darwin SYS_GETPPID (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 110 }     // Linux x86_64 __NR_getppid
        else { nr = 173 }                      // Linux arm64 __NR_getppid
    }
    return __hx_syscall0(nr)                    // ppid → raw C-ABI result reg
}

pub fn hxlcl_geteuid() -> int {
    let mut nr = 25                            // Darwin SYS_GETEUID (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 107 }     // Linux x86_64 __NR_geteuid
        else { nr = 175 }                      // Linux arm64 __NR_geteuid
    }
    return __hx_syscall0(nr)                    // euid → raw C-ABI result reg
}

pub fn hxlcl_getegid() -> int {
    let mut nr = 43                            // Darwin SYS_GETEGID (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 108 }     // Linux x86_64 __NR_getegid
        else { nr = 177 }                      // Linux arm64 __NR_getegid
    }
    return __hx_syscall0(nr)                    // egid → raw C-ABI result reg
}

// ── SYSCALL FAMILY (Route C errno-bearing · ② extern-data substrate via accessor) ──
//
// hxlcl_close is the FIRST errno-BEARING Route C syscall leaf. Unlike the
// errno-free family above (getpid/getuid/…), a failed syscall must set the C
// `errno` so the generated-C callers (self/native/net_emit.hexa:195
// `if(hxlcl_close(fd)<0) return -errno`, signal_flock_emit.hexa:287) observe the
// same libc-`close` contract (return -1 + errno SET).
//
// FROZEN-SAFE errno store via the canonical thread-local accessor (NO new
// builtin/syntax — the substrate is built from existing constructs):
//   - `__errno_location()` is the LSB/glibc/musl standard `int *(void)`
//     returning the address of the calling thread's errno (errno is a macro
//     `(*__errno_location())`). Declared here as an `extern fn` (no body →
//     undefined-external resolved at link), mirroring hxlcl_atoll/hxlcl_malloc
//     above; whitelisting it in `_is_cabi` makes the inner `bl __errno_location`
//     lower single-register C-ABI (0 args; ptr ← rax/x0).
//   - `__hx_ptr_store32(ptr, off, val)` writes the 32-bit `errno` (errno is an
//     int) to that address. (store32, not store64 — errno is int-width.)
//
// Linux returns `-errno` directly (no carry flag), so the store is
// `*errno_p = -r` and the fn returns -1, exactly like musl's __syscall_ret
// (`if (r > -4096UL) { errno = -r; return -1; }`). The errno store is gated on
// `target_is_linux()` — DARWIN signals errors via the carry flag with a POSITIVE
// errno (not -r), so the Linux store would be wrong there; on darwin the gate is
// a compile-time-false const → DCE drops the `__errno_location` call entirely
// (darwin errno = a separate round via `__error()`, the darwin accessor). The
// darwin smoke therefore asserts only close's return value (0 / -1), while the
// LINUX routec-smoke asserts errno == EBADF (value-exact, the substrate's core
// claim).
//
// PER-TARGET close NR (compile-time consts → DCE):
//   Linux x86_64 = 3   (syscall_64.tbl)              · Linux arm64 = 57 (asm-generic)
//   Darwin       = 6   (SYS_CLOSE; __hx_syscall6's BSD trap OR-bakes 0x2000000)
// BYTE-FAITHFUL to the floor (self/codegen/runtime_arm64.hexa:2809):
//   hxlcl_close(int fd) { return (int)_hxlcl_syscall1_cf(SYS_CLOSE, fd); }

extern fn __errno_location() -> int

pub fn hxlcl_close(fd: HexaVal) -> int {
    let mut nr = 6                             // Darwin SYS_CLOSE (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 3 }       // Linux x86_64 __NR_close
        else { nr = 57 }                       // Linux arm64 __NR_close
    }
    let r = __hx_syscall6(nr, fd, 0, 0, 0, 0, 0)
    // IN-BODY OPERATOR DISCIPLINE (Route C): the 3-boundary C-ABI lowering does
    // NOT touch in-body operators — a plain `r < 0` / `0 - r` would lower to the
    // PAIR-MODEL helpers (hexa_cmp_lt / hexa_sub), which are undefined in the raw
    // C-ABI link (the #4042-RED root cause). Use the raw-payload leaf intrinsics
    // instead — the same rule the composite family follows (hxlcl_core.hexa:77
    // `__hx_payload_lt`, :146 `__hx_payload_sub`). Each writes exactly one `let`
    // (un-nested), so a codegen scratch clobber can't corrupt an outer op.
    let neg = __hx_payload_lt(r, 0)            // r < 0 (raw signed payload compare)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()         // &errno (thread-local)
            let e = __hx_payload_sub(0, r)     // -(-errno) = positive errno
            __hx_ptr_store32(p, 0, e)          // *errno_p = e
        }
        return -1
    }
    return r                                    // fd close result (0)
}

// ── ERRNO-BEARING CHAIN (close mirror) — uniform 3-arg syscalls read / lseek ──
//
// Both follow the EXACT close pattern: a __hx_syscall6 trap, then the Route C
// in-body discipline (raw-payload `__hx_payload_lt`/`_ne`/`_sub`, never bare
// `<`/`-`) + the target_is_linux()-gated errno store via __errno_location. They
// are uniform 3-arg across all targets (no arm64 dup3/mkdirat-style call-shape
// divergence), so the body is a verbatim mirror with only the NR + arg names
// changed. NR ref-match (no black-box):
//   read : x86_64 0 · arm64 63 · darwin 3   (syscall_64.tbl / asm-generic
//          unistd.h __NR_read 63 / runtime.c HXLCL_SYS_READ 3)
//   lseek: x86_64 8 · arm64 62 · darwin 199 (syscall_64.tbl / __NR_lseek 62 /
//          runtime.c HXLCL_SYS_LSEEK 199; darwin 0x20000c7)

pub fn hxlcl_read(fd: HexaVal, buf: HexaVal, n: HexaVal) -> int {
    let mut nr = 3                             // Darwin SYS_READ (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 0 }       // Linux x86_64 __NR_read
        else { nr = 63 }                       // Linux arm64 __NR_read
    }
    let r = __hx_syscall6(nr, fd, buf, n, 0, 0, 0)
    let neg = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // bytes read (>= 0)
}

pub fn hxlcl_lseek(fd: HexaVal, off: HexaVal, whence: HexaVal) -> int {
    let mut nr = 199                           // Darwin SYS_LSEEK (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 8 }       // Linux x86_64 __NR_lseek
        else { nr = 62 }                       // Linux arm64 __NR_lseek
    }
    let r = __hx_syscall6(nr, fd, off, whence, 0, 0, 0)
    let neg = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // resulting file offset (>= 0)
}

// ── ERRNO-BEARING CHAIN r2 — arm64 CALL-SHAPE DIVERGENCE (5th discipline) ──
//
// dup2 and mkdir have NO plain syscall on arm64-linux (asm-generic dropped the
// legacy numbers); they must use the *at-variant with an extra arg:
//   dup2  → dup3(old, new, FLAGS=0)        (arm64 __NR_dup3 = 24, 3-arg)
//   mkdir → mkdirat(AT_FDCWD=-100, path, mode) (arm64 __NR_mkdirat = 34, 3-arg)
// x86_64-linux + darwin keep the plain 2-arg form (dup2 33/90, mkdir 83/136).
// NR + AT_FDCWD ref-match (no black-box): x86_64 = syscall_64.tbl; arm64 dup3=24/
// mkdirat=34 = include/uapi/asm-generic/unistd.h (NO plain dup2/mkdir there);
// darwin = runtime.c HXLCL_SYS_DUP2 90 / HXLCL_SYS_MKDIR 136; AT_FDCWD=-100 =
// self/rt/syscall.hexa:153,161. errno-store = the close discipline verbatim.

// dup2: the arm64 dup3 call takes the SAME old/new args plus a trailing flags=0,
// so passing `(nr, old, new, 0, …)` is correct on EVERY target — x86_64/darwin
// dup2 ignore the unused arg slot, arm64 dup3 reads arg[2]=0 as flags=0. Hence
// only the NR differs (uniform arg tuple), exactly like read/lseek.
pub fn hxlcl_dup2(oldfd: HexaVal, newfd: HexaVal) -> int {
    let mut nr = 90                            // Darwin SYS_DUP2 (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 33 }      // Linux x86_64 __NR_dup2
        else { nr = 24 }                       // Linux arm64 __NR_dup3 (flags=0)
    }
    let r = __hx_syscall6(nr, oldfd, newfd, 0, 0, 0, 0)
    let neg = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // newfd (>= 0)
}

// mkdir: the arm64 mkdirat call PREPENDS AT_FDCWD, shifting path/mode right by
// one — a genuine per-arch ARG-TUPLE divergence (not just a NR swap). So the
// syscall is issued in per-arch branches with the correct argument shape; the
// result `r` then flows into the shared close-pattern errno epilogue.
pub fn hxlcl_mkdir(path: HexaVal, mode: HexaVal) -> int {
    let mut r = 0
    if target_is_linux() {
        if target_is_x86_64() {
            r = __hx_syscall6(83, path, mode, 0, 0, 0, 0)        // x86_64 mkdir(path, mode)
        } else {
            r = __hx_syscall6(34, -100, path, mode, 0, 0, 0)     // arm64 mkdirat(AT_FDCWD, path, mode)
        }
    } else {
        r = __hx_syscall6(136, path, mode, 0, 0, 0, 0)           // darwin SYS_MKDIR(path, mode)
    }
    let neg = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // 0 on success
}

// ── ERRNO-BEARING CHAIN r3 — FINAL batch: stat (struct-out buf) + waitpid ──
//
// The last two errno-bearing leaves. Both share the close errno epilogue
// (raw-payload `__hx_payload_lt`/`_ne`/`_sub` + target_is_linux()-gated store via
// __errno_location); they differ only in argument shape.
//
//   stat → arm64 has NO plain stat; it uses fstatat(AT_FDCWD=-100, path, buf,
//          flags=0) — a 4-arg PREPEND divergence exactly like mkdir→mkdirat. So
//          the syscall is issued in per-arch branches (per-arch arg tuple), then
//          the shared epilogue runs on the result.
//          NR ref-match (no black-box): x86_64 __NR_stat = 4 (2-arg path,buf) ·
//          arm64 __NR_fstatat = 79 (4-arg AT_FDCWD,path,buf,flags) — plain stat
//          dropped on asm-generic · darwin SYS_STAT = 338 (2-arg path,buf).
//          (stdlib/posix/linux_syscalls.hexa:129/102 · self/codegen/
//          runtime_arm64.hexa:4198-4199 darwin 338 · AT_FDCWD=-100 = the same
//          literal mkdir uses above.)
//
//   waitpid → routed to wait4(pid, status, options, rusage=NULL) on every target
//          — a UNIFORM 4-arg shape (no at-variant / no prepend), so only the NR
//          differs, exactly like read/lseek. NR ref-match: x86_64 __NR_wait4 = 61
//          · arm64 __NR_wait4 = 260 · darwin SYS_WAIT4 = 7 (rusage NULL ⇒ 0).
//          (linux_syscalls.hexa:123/95 · self/codegen/runtime_arm64.hexa:5218
//          darwin 7. The floor routes waitpid → wait4 with a NULL 4th arg:
//          runtime.c hxlcl_waitpid(pid,status,opts){ wait4(pid,status,opts,0) }.)

// stat: per-arch arg tuple (arm64 fstatat prepends AT_FDCWD, shifting path/buf
// right by one — a genuine divergence, mirrors mkdir). The result flows into the
// shared close-pattern errno epilogue.
pub fn hxlcl_stat(path: HexaVal, statbuf: HexaVal) -> int {
    let mut r = 0
    if target_is_linux() {
        if target_is_x86_64() {
            r = __hx_syscall6(4, path, statbuf, 0, 0, 0, 0)          // x86_64 stat(path, buf)
        } else {
            r = __hx_syscall6(79, -100, path, statbuf, 0, 0, 0)      // arm64 fstatat(AT_FDCWD, path, buf, flags=0)
        }
    } else {
        r = __hx_syscall6(338, path, statbuf, 0, 0, 0, 0)            // darwin SYS_STAT(path, buf)
    }
    let neg = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // 0 on success
}

// waitpid: uniform wait4(pid, status, options, rusage=NULL) — only the NR varies,
// so a single trap with the same arg tuple is correct on every target (like
// read/lseek). The 4th arg (rusage) is 0 = NULL.
pub fn hxlcl_waitpid(pid: HexaVal, status: HexaVal, opts: HexaVal) -> int {
    let mut nr = 7                             // Darwin SYS_WAIT4 (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 61 }      // Linux x86_64 __NR_wait4
        else { nr = 260 }                      // Linux arm64 __NR_wait4
    }
    let r = __hx_syscall6(nr, pid, status, opts, 0, 0, 0)
    let neg = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // reaped pid (> 0)
}

// ── ERRNO-BEARING CHAIN — batch C: write + fcntl + mmap (plain syscalls) ──
//
// Three more errno-bearing leaves, all uniform across targets (no arm64
// dup3/mkdirat/fstatat call-shape divergence — each has a plain syscall on
// arm64-linux, so only the NR varies, exactly like read/lseek/waitpid). All
// three follow the close errno epilogue verbatim: a __hx_syscall6 trap, then
// the Route C in-body discipline (raw-payload `__hx_payload_lt`/`_ne`/`_sub`,
// never bare `<`/`-`) + the target_is_linux()-gated errno store via the already
// whitelisted __errno_location.
//
//   write : x86_64 1 · arm64 64 · darwin 4   (syscall_64.tbl write=1 /
//           asm-generic unistd.h __NR_write 64 / runtime.c HXLCL_SYS_WRITE 4,
//           darwin BSD trap OR-bakes 0x2000000). The exact 3-arg mirror of read
//           (floor: hxlcl_write = _hxlcl_syscall3_cf, errno-bearing like read).
//   fcntl : x86_64 72 · arm64 25 · darwin 92  (syscall_64.tbl fcntl=72 /
//           asm-generic __NR_fcntl 25 / runtime.c HXLCL_SYS_FCNTL 92). A plain
//           3-arg (fd, cmd, arg). On Linux a failing fcntl returns -errno (the
//           uniform raw-syscall convention), so the same errno-store leg is
//           correct; the floor uses the NON-_cf path (no darwin errno), which
//           matches our discipline ④ (darwin carry deferred → store DCE'd).
//   mmap  : x86_64 9 · arm64 222 · darwin 197 (syscall_64.tbl mmap=9 /
//           asm-generic __NR_mmap 222 / runtime.c HXLCL_SYS_MMAP 197). 6-arg
//           (addr, len, prot, flags, fd, off).
//
// ⚠️ mmap ERROR-DETECTION root-cause (NOT the libc MAP_FAILED sentinel):
// at the RAW Linux syscall level — which this Route C body issues directly —
// mmap returns the mapped address on success (a positive user-space address,
// well below 2^63 ⇒ signed-positive) or `-errno` in [-4095, -1] on error,
// EXACTLY like every other syscall. The `MAP_FAILED == (void*)-1` sentinel is a
// LIBC-WRAPPER artifact: glibc's mmap wrapper converts the raw `-errno` range to
// MAP_FAILED via the `> -4096UL` threshold (musl src/internal/syscall_ret.c:
// `if(r > -4096UL){ errno=-r; return -1; }`), and the darwin `_cf` floor
// (runtime_arm64.hexa:5309 `mov x0,#-1` on carry) does the same. Our body is the
// raw layer BELOW that wrapper, so the correct error check is the uniform
// `__hx_payload_lt(r, 0)` (raw `-errno` is negative) — NOT a `payload_eq -1`
// MAP_FAILED check, which would only fire on the already-converted libc value
// and would mis-treat a valid high address or a different -errno. So mmap is a
// uniform `-errno` mirror like read/write; the errno-store leg then writes -r
// and returns -1 (which the C caller reads as MAP_FAILED on Linux, since
// (void*)-1 == the -1 we return).

pub fn hxlcl_write(fd: HexaVal, buf: HexaVal, n: HexaVal) -> int {
    let mut nr = 4                             // Darwin SYS_WRITE (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 1 }       // Linux x86_64 __NR_write
        else { nr = 64 }                       // Linux arm64 __NR_write
    }
    let r = __hx_syscall6(nr, fd, buf, n, 0, 0, 0)
    let neg = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // bytes written (>= 0)
}

pub fn hxlcl_fcntl(fd: HexaVal, cmd: HexaVal, arg: HexaVal) -> int {
    let mut nr = 92                            // Darwin SYS_FCNTL (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 72 }      // Linux x86_64 __NR_fcntl
        else { nr = 25 }                       // Linux arm64 __NR_fcntl
    }
    let r = __hx_syscall6(nr, fd, cmd, arg, 0, 0, 0)
    let neg = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // cmd-dependent result (>= 0)
}

// mmap: 6-arg uniform trap (see the error-detection root-cause above — the raw
// syscall returns the address on success or -errno on failure, so the close
// `__hx_payload_lt(r, 0)` check is correct, NOT a MAP_FAILED `== -1` check).
pub fn hxlcl_mmap(addr: HexaVal, len: HexaVal, prot: HexaVal, flags: HexaVal, fd: HexaVal, off: HexaVal) -> int {
    let mut nr = 197                           // Darwin SYS_MMAP (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 9 }       // Linux x86_64 __NR_mmap
        else { nr = 222 }                      // Linux arm64 __NR_mmap
    }
    let r = __hx_syscall6(nr, addr, len, prot, flags, fd, off)
    let neg = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // mapped address (raw pointer word)
}

// ── ERRNO-BEARING CHAIN batch D — DIVERGENCE syscalls: open_sys + getrusage ──
//
// Two more errno-bearing leaves. Both share the close errno epilogue verbatim
// (raw-payload `__hx_payload_lt`/`_ne`/`_sub`, never bare `<`/`-`, +
// target_is_linux()-gated store via the already-whitelisted __errno_location).
// They differ only in CALL SHAPE — open_sys is the arm64 AT_FDCWD-prepend kind
// (a genuine per-arch arg-tuple divergence, exactly mirroring mkdir→mkdirat and
// stat→fstatat), getrusage is a plain uniform 2-arg (only the NR varies, like
// read/lseek/waitpid).
//
//   open_sys → arm64 has NO plain open; it uses openat(AT_FDCWD=-100, path,
//          flags, mode) — a 4-arg PREPEND divergence exactly like mkdir→mkdirat
//          and stat→fstatat. So the syscall is issued in per-arch branches (the
//          arm64 branch prepends AT_FDCWD, shifting path/flags/mode right by one),
//          then the shared epilogue runs on the result. x86_64 + darwin keep the
//          plain 3-arg open(path, flags, mode).
//          NR + AT_FDCWD ref-match (no black-box):
//            x86_64 __NR_open    = 2   (arch/x86 syscall_64.tbl;
//                                       stdlib/posix/linux_syscalls.hexa:116)
//            arm64  __NR_openat  = 56  (asm-generic unistd.h — plain "open"
//                                       dropped; linux_syscalls.hexa:83)
//            darwin SYS_OPEN     = 5   (xnu bsd/kern/syscalls.master; the BSD
//                                       trap OR-bakes 0x2000000 in __hx_syscall6)
//            AT_FDCWD = -100           (the same literal mkdir/stat use above;
//                                       self/rt/syscall.hexa:153,161)
//          open is errno-bearing (a bad path → -1 + ENOENT on the raw Linux
//          syscall, the uniform `-errno` convention). Named `hxlcl_open_sys`
//          rather than `hxlcl_open` to match the floor's open routing symbol and
//          avoid shadowing the higher-level open wrapper.
//
//   getrusage → a plain UNIFORM 2-arg (who, usage*) on every target — no
//          at-variant / no prepend, so only the NR differs, exactly like
//          read/lseek/waitpid. The 2nd arg is an OUT-pointer (the struct rusage*
//          the kernel fills), the same out-ptr shape as stat's statbuf.
//          NR ref-match (no black-box):
//            x86_64 __NR_getrusage = 98   (arch/x86 syscall_64.tbl)
//            arm64  __NR_getrusage = 165  (asm-generic unistd.h)
//            darwin SYS_GETRUSAGE  = 117  (xnu bsd/kern/syscalls.master)
//          errno-bearing: a bad `who` → -1 + EINVAL (getrusage(2): "EINVAL ...
//          who is invalid").
//
// DEFERRED to a later batch (honest — trickier divergence, not attempted here):
//   time    → arm64/darwin have NO plain time; they need gettimeofday(tv*,0) with
//             a DIFFERENT return semantics (gettimeofday writes a struct + returns
//             0, vs time returns the epoch seconds) — a return-value mismatch, not
//             just a NR/arg swap. (x86_64 time=201, arm64 gettimeofday=169.)
//   poll    → arm64 has NO plain poll; ppoll takes an EXTRA timespec* + sigmask +
//             sigsetsize (arg-COUNT divergence, not just a prepend).
//             (x86_64 poll=7, arm64 ppoll=73, darwin poll=230.)
//   pipe    → a 2nd-RETURN-register / int[2] out-array shape (the kernel returns
//             both fds), which the single-result __hx_syscall6 path doesn't expose
//             — a genuinely different lowering. (x86_64 pipe=22/pipe2=293, arm64
//             pipe2=59, darwin pipe=42.)

// open_sys: per-arch arg tuple (arm64 openat prepends AT_FDCWD, shifting
// path/flags/mode right by one — a genuine divergence, mirrors mkdir/stat). The
// result flows into the shared close-pattern errno epilogue.
pub fn hxlcl_open_sys(path: HexaVal, flags: HexaVal, mode: HexaVal) -> int {
    let mut r = 0
    if target_is_linux() {
        if target_is_x86_64() {
            r = __hx_syscall6(2, path, flags, mode, 0, 0, 0)        // x86_64 open(path, flags, mode)
        } else {
            r = __hx_syscall6(56, -100, path, flags, mode, 0, 0)    // arm64 openat(AT_FDCWD, path, flags, mode)
        }
    } else {
        r = __hx_syscall6(5, path, flags, mode, 0, 0, 0)            // darwin SYS_OPEN(path, flags, mode)
    }
    let neg = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // fd (>= 0)
}

// getrusage: plain uniform 2-arg (who, usage*); only the NR varies (no at-variant),
// like read/lseek. The 2nd arg is an out-ptr the kernel fills (stat-statbuf shape).
pub fn hxlcl_getrusage(who: HexaVal, usage: HexaVal) -> int {
    let mut nr = 117                           // Darwin SYS_GETRUSAGE (default)
    if target_is_linux() {
        if target_is_x86_64() { nr = 98 }      // Linux x86_64 __NR_getrusage
        else { nr = 165 }                      // Linux arm64 __NR_getrusage
    }
    let r = __hx_syscall6(nr, who, usage, 0, 0, 0, 0)
    let neg = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // 0 on success
}

// ── batch E: pipe (out-ptr int[2] — Linux DISSOLVES, darwin is the genuine wall) ─
//
// CENSUS CORRECTION (batch D deferred "pipe = 2nd-return-register"): that label
// conflated Linux and darwin. The Linux pipe ABI is an OUT-POINTER — the kernel
// WRITES both fds into the caller's int[2] buffer and returns 0/-errno (the same
// out-ptr shape as getrusage's usage* and stat's statbuf). The 2nd-return-register
// (r0/r1 dual-fd) divergence is DARWIN-ONLY (BSD pipe). So the Linux legs dissolve
// cleanly with the established close errno epilogue; only darwin is a real wall.
//
//   x86_64 / arm64-linux → pipe2(fds, flags=0). Using pipe2 (not the legacy
//          x86_64 pipe=22) gives a UNIFORM 2-arg shape on BOTH arches — arm64 has
//          NO plain pipe, only pipe2; x86_64 pipe2 takes the same (fds, flags).
//          This is the "flags-trailing uniform" pattern (exactly like dup2→dup3:
//          flags=0 trails, so one shape serves both arches, only the NR varies).
//          errno-bearing: a bad fds ptr / EMFILE → -1 + errno on the Linux leg.
//   darwin → SYS_pipe (42) returns the two fds in x0/x1 (2nd return register);
//          the single-result __hx_syscall6 exposes only x0. This DISSOLVES via the
//          __hx_syscall6_out2 intrinsic (the dual-return sibling that writes x0/x1
//          + the carry flag into a heap scratch — mirrors the floor _hxlcl_pipe_cf
//          dual-register asm shim, self/runtime_emit_full.hexa:1794). The darwin
//          carry-flag error → errno store is deferred (discipline ④).
//   NR ref-match (no black-box; WebFetch-confirmed 2026-06-27):
//     x86_64 __NR_pipe2 = 293  (arch/x86 syscall_64.tbl)
//     arm64  __NR_pipe2 = 59   (asm-generic unistd.h — no plain pipe/poll on arm64)
//     darwin SYS_pipe   = 42   (xnu; 2nd-return-reg, via __hx_syscall6_out2)
//
// time / poll: LANDED in batch H below (the scratch-buffer substrate the batch E
// census flagged turned out NOT to need a new intrinsic — see the batch H header).
pub fn hxlcl_pipe(fds: HexaVal) -> int {
    if target_is_linux() {
        let mut r = 0
        if target_is_x86_64() {
            r = __hx_syscall6(293, fds, 0, 0, 0, 0, 0)     // x86_64 pipe2(fds, flags=0)
        } else {
            r = __hx_syscall6(59, fds, 0, 0, 0, 0, 0)      // arm64 pipe2(fds, flags=0)
        }
        let neg = __hx_payload_lt(r, 0)
        if __hx_payload_ne(neg, 0) {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
            return -1
        }
        return r                                // 0 on success (kernel wrote fds[0],fds[1])
    }
    // darwin: BSD pipe(42) is a 2nd-return-register syscall — the kernel returns
    // the two fds in x0/x1 (NOT the user buffer). __hx_syscall6_out2 issues the
    // single trap and captures BOTH return regs + the carry/error flag into a
    // 24-byte heap scratch (3 slots: x0, x1, carry); we then copy the fds into the
    // caller's int[2]. (The scratch leaks 24B on the bump arena — pipe is not
    // hot-looped; same heap-scratch caveat as the batch-H time/poll legs.) The
    // darwin carry-flag error → errno store is DEFERRED (darwin __error() round,
    // discipline ④); on error we return -1 without setting errno.
    let szp = __hx_payload_add(0, 24)           // HexaVal-box the scratch size
    let scr = hxlcl_malloc(szp)
    __hx_syscall6_out2(42, 0, 0, 0, 0, 0, 0, scr)   // BSD pipe — no args; fds in x0/x1
    let cf = __hx_ptr_load64(scr, 16)
    if __hx_payload_ne(cf, 0) {
        return -1                               // darwin error (carry set); errno deferred
    }
    let fd0 = __hx_ptr_load64(scr, 0)           // x0 = fds[0]
    let fd1 = __hx_ptr_load64(scr, 8)           // x1 = fds[1]
    __hx_ptr_store32(fds, 0, fd0)               // fds[0]
    __hx_ptr_store32(fds, 4, fd1)               // fds[1] (int = 4 bytes)
    return 0
}

// ── batch H: time + poll (the SCRATCH-BUFFER substrate — NO new intrinsic) ──────
//
// SCRATCH-BUFFER CENSUS VERDICT (the batch-E deferral resolved): time and poll
// each have register-clean legs and ONE divergent leg that needs a small in-body
// struct buffer (timeval / timespec). The campaign has NO `__hx_stack_alloc`-class
// intrinsic (grep-clean: no addr-of / alloca / stack-slot leaf), so a TRUE in-body
// STACK scratch buffer is a substrate gap — it would need a new codegen builtin
// (the frozen-151c52c8-unsafe path the campaign forbids). BUT the buffer NEED is
// satisfiable with ZERO new intrinsics by reusing the already-whitelisted
// hxlcl_malloc as a HEAP scratch + the proven raw-ptr ops:
//   • hxlcl_malloc(16)        — inner C-ABI `bl` (ON-path-proven by strdup/calloc/
//                               realloc), returns a 16-byte raw region.
//   • __hx_ptr_store64(p,off,v) — write the synthesized struct fields (proven by
//                               strtoll's endptr store64).
//   • __hx_ptr_load64(p,off)   — read a struct field back (proven by realloc's
//                               negative-offset header read).
//   • __hx_payload_div/_mod/_mul — the ms→{sec,nsec} arithmetic (proven int-div
//                               leaves — x86_64_linux.hexa:2741 / arm64_darwin:2088).
// So the substrate is NOT a wall; the only thing genuinely missing (a true stack
// scratch) is an OPTIMIZATION, not a blocker. HONEST CAVEAT (recorded for the
// campaign SSOT): the heap-scratch leaks the 16-byte region per call on the
// arm64-linux divergent legs (hxlcl_malloc's bump arena has free=noop). For time
// that is negligible (every caller passes NULL and time() is never hot-looped),
// but hxlcl_poll IS hot-looped on a finite timeout (self/native/term_ffi_emit.hexa
// documents a "tight-looped hxlcl_poll → 36 GB RSS" history), so the arm64-linux
// finite-timeout ppoll leg accrues that per-call 16-byte leak — the ONE spot a
// true __hx_stack_alloc would be cleaner. Acceptable on this default-OFF research
// path (HEXA_CABI_HXLCL=1, never shipped); flagged, not papered over.
//
// In-body operator discipline (the #4042 rule) + un-nested lets throughout, same
// as the syscall family above. errno epilogue = the close discipline verbatim.

// hxlcl_time: return the epoch seconds (a la `time(NULL)`); if `t` is non-NULL also
// write `*t = (int)sec` (NULL-gated, like strtoll's endptr). BYTE-FAITHFUL to the
// floor shim runtime_core_hxlcl_shim.c:560 (`int hxlcl_time(int *t){ time_t r =
// time(NULL); if(t) *t=(int)r; return (int)r; }`) — every caller in the runtime
// passes NULL (`hxlcl_time(NULL)`), so the out-param write is exercised only for
// faithfulness. The `int` return carries the low 32 bits of the epoch (matching the
// floor's `(int)r`; valid until 2038, the same window as the int-typed floor).
//
// PER-TARGET (compile-time target_is_* consts → DCE drops the dead legs):
//   x86_64-linux : time(201) — REGISTER-CLEAN: the kernel returns the epoch in the
//                  result reg; NO buffer. (Passing tloc=0/NULL to the syscall, then
//                  doing the int-width *t store OURSELVES — the kernel would write 8
//                  bytes (time_t) into a 4-byte int* t, so we never hand it `t`.)
//   arm64-linux  : NO __NR_time (asm-generic dropped it); gettimeofday(169, &tv,
//                  NULL) writes timeval{tv_sec,tv_usec}; read tv_sec at offset 0.
//   darwin       : NO BSD `time` trap; gettimeofday(116, &tv, NULL) (the floor's
//                  hxlcl_clock_gettime uses the same syscall, runtime_emit_full:1983);
//                  read tv_sec. (__hx_syscall6 issues `svc #0x80` with the bare BSD
//                  NR — no 0x2000000 OR on arm64, like getrusage=117.)
// NR ref-match (no black-box): x86_64 time=201 (arch/x86 syscall_64.tbl) · arm64
// gettimeofday=169 / darwin gettimeofday=116 (asm-generic unistd.h __NR_gettimeofday
// 169 · runtime_emit_full.hexa:1943 HXLCL_SYS_GETTIMEOFDAY 116).
pub fn hxlcl_time(t: HexaVal) -> int {
    let pt = __hx_payload_add(t, 0)            // int* t (raw, may be NULL)
    if target_is_linux() {
        if target_is_x86_64() {
            let r = __hx_syscall6(201, 0, 0, 0, 0, 0, 0)   // time(NULL) → epoch in result reg
            if __hx_payload_ne(pt, 0) {
                __hx_ptr_store32(pt, 0, r)     // *t = (int)epoch
            }
            return r
        }
        // arm64-linux: gettimeofday(&tv, NULL); tv_sec at offset 0.
        // hxlcl_malloc's declared param is `HexaVal` (the C-ABI lowering is at the
        // call boundary, but the TYPE-CHECK is on the signature), so a bare i64 `16`
        // mismatches. Box it via __hx_payload_add(0,16) → HexaVal{TAG_INT,16} — the
        // exact close/strtoll `__hx_payload_sub(0, x)` shape (the __hx_payload_*
        // intrinsics accept i64 literals and return HexaVal, unlike a declared
        // extern qn). strdup/calloc pass HexaVal the same way (cap=__hx_payload_add,
        // total=__hx_payload_mul). The malloc result is `int` (raw ptr word), fed
        // straight to the raw-ptr intrinsics like strdup/calloc do.
        let szl = __hx_payload_add(0, 16)      // HexaVal-box the scratch size
        let buf = hxlcl_malloc(szl)            // scratch timeval (heap — see header)
        __hx_syscall6(169, buf, 0, 0, 0, 0, 0) // gettimeofday(&tv, NULL)
        let sec = __hx_ptr_load64(buf, 0)      // tv.tv_sec
        if __hx_payload_ne(pt, 0) {
            __hx_ptr_store32(pt, 0, sec)
        }
        return sec
    }
    // darwin: gettimeofday(&tv, NULL); tv_sec at offset 0. Same HexaVal-box of the
    // literal size as the arm64-linux leg above (hxlcl_malloc expects HexaVal).
    let szd = __hx_payload_add(0, 16)
    let buf = hxlcl_malloc(szd)
    __hx_syscall6(116, buf, 0, 0, 0, 0, 0)
    let sec = __hx_ptr_load64(buf, 0)
    if __hx_payload_ne(pt, 0) {
        __hx_ptr_store32(pt, 0, sec)
    }
    return sec
}

// hxlcl_poll: wait for events on `fds` (nfds pollfds) up to `timeout` ms; return
// the ready count (0 on timeout) or -1 + errno. BYTE-FAITHFUL to the floor
// (runtime_emit_full.hexa:2042 `poll((struct pollfd*)fds,(nfds_t)nfds,timeout)`).
// `nfds` is an `unsigned int` passed raw — every C caller zero-extends it (a 32-bit
// `mov` clears the upper word), exactly like read/write pass `unsigned long n` raw.
//
// PER-TARGET (compile-time target_is_* consts → DCE):
//   x86_64-linux : poll(7)   — plain 3-arg (fds, nfds, timeout_ms). REGISTER-CLEAN.
//   darwin       : poll(230) — plain 3-arg, same shape (bare BSD NR, `svc #0x80`).
//   arm64-linux  : NO __NR_poll (asm-generic dropped it); ppoll(73, fds, nfds,
//                  &ts | NULL, sigmask=NULL, sigsetsize=8). The C `int timeout` (ms)
//                  is SYNTHESIZED into a timespec: timeout<0 → tmo=NULL (block
//                  forever); else {tv_sec = ms/1000, tv_nsec = (ms%1000)*1e6}. This
//                  is the divergent leg that needs the scratch buffer (see header).
//                  (sigmask NULL ⇒ the kernel ignores sigsetsize, but 8 = _NSIG/8 is
//                  the canonical value glibc passes.)
// NR + arg-shape ref-match (no black-box): x86_64 poll=7 / darwin poll=230
// (syscall_64.tbl · runtime_emit_full.hexa:1369 HXLCL_SYS_POLL 230) · arm64 ppoll=73
// (asm-generic unistd.h __NR_ppoll — no plain poll on arm64) · ppoll signature
// (fds,nfds,tmo_p,sigmask,sigsetsize) = man ppoll(2). The errno epilogue is the
// close discipline verbatim (Linux returns -errno; darwin carry-flag deferred).
pub fn hxlcl_poll(fds: HexaVal, nfds: HexaVal, timeout: HexaVal) -> int {
    let mut r = 0
    if target_is_linux() {
        if target_is_x86_64() {
            r = __hx_syscall6(7, fds, nfds, timeout, 0, 0, 0)    // poll(fds, nfds, timeout_ms)
        } else {
            // arm64-linux: ppoll(fds, nfds, &ts | NULL, sigmask=NULL, sigsetsize=8).
            let neg = __hx_payload_lt(timeout, 0)
            if __hx_payload_ne(neg, 0) {
                r = __hx_syscall6(73, fds, nfds, 0, 0, 8, 0)     // timeout<0 → tmo=NULL (infinite)
            } else {
                let szp = __hx_payload_add(0, 16)                // HexaVal-box the scratch size (malloc expects HexaVal)
                let ts = hxlcl_malloc(szp)                       // scratch timespec (heap — see header)
                let sec = __hx_payload_div(timeout, 1000)        // ms / 1000  → tv_sec
                let rem = __hx_payload_mod(timeout, 1000)        // ms % 1000
                let nsec = __hx_payload_mul(rem, 1000000)        // → tv_nsec (nanoseconds)
                __hx_ptr_store64(ts, 0, sec)                     // ts.tv_sec
                __hx_ptr_store64(ts, 8, nsec)                    // ts.tv_nsec
                r = __hx_syscall6(73, fds, nfds, ts, 0, 8, 0)
            }
        }
    } else {
        r = __hx_syscall6(230, fds, nfds, timeout, 0, 0, 0)      // darwin poll(fds, nfds, timeout_ms)
    }
    let neg2 = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg2, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // ready count (0 on timeout)
}

// ── batch I: clock_gettime + execve (clean syscall leaves) ─────────────────────
//
// Two more errno-bearing leaves continuing the close-mirror discipline (raw-payload
// `__hx_payload_lt`/`_ne`/`_sub`, never bare `<`/`-`, + the target_is_linux()-gated
// errno store via the already-whitelisted __errno_location). Both reuse the proven
// patterns from earlier batches:
//   clock_gettime → getrusage's OUT-PTR shape (the caller's timespec* the kernel
//        fills). UNIFORM 2-arg on Linux (only the NR varies, x86_64=228/arm64=113),
//        like read/lseek/getrusage. Darwin has NO clock_gettime trap (it is a
//        commpage/vDSO routine with no stable BSD syscall number — confirmed by the
//        floor self/runtime_emit_full.hexa:1977 which uses gettimeofday(116)), so
//        the darwin leg synthesizes a timespec from gettimeofday(116) — the batch-H
//        time/poll gettimeofday pattern, but writing the timespec DIRECTLY into the
//        caller's out-ptr (leak-free, no heap scratch — clock_gettime is often hot-
//        looped in timing loops, so the time/poll per-call heap leak is avoided).
//   execve → plain 3-arg (path, argv, envp). Only the NR diverges on arm64
//        (x86_64=59/arm64=221/darwin=59) — NO arg-shape change (no AT_FDCWD prepend,
//        no flags-trailing), the read/lseek/getrusage uniform-NR class. execve only
//        returns ON FAILURE (success replaces the process image), so the errno
//        epilogue is the whole story: a bad path → -1 + ENOENT on the raw Linux
//        syscall (the uniform -errno convention).
//
// NR ref-match (no black-box; in-repo tables + WebFetch-confirmed asm-generic):
//   clock_gettime  x86_64 = 228  (arch/x86 syscall_64.tbl; self/rt/syscall.hexa:79
//                                 SYS_LINUX_CLOCK_GETTIME)
//                  arm64  = 113  (asm-generic unistd.h __NR_clock_gettime)
//                  darwin =  —   (no trap → gettimeofday(116), self/runtime_emit_full
//                                 .hexa:1943 HXLCL_SYS_GETTIMEOFDAY 116)
//   execve         x86_64 =  59  (arch/x86 syscall_64.tbl; syscall.hexa:75
//                                 SYS_LINUX_EXECVE)
//                  arm64  = 221  (asm-generic unistd.h __NR_execve)
//                  darwin =  59  (xnu bsd/kern/syscalls.master; runtime_emit_full
//                                 .hexa:1375 HXLCL_SYS_EXECVE — bare BSD trap)
//
// DEFERRED to batch J (honest — measured darwin wall + smoke complexity, not done
// here):
//   fork → arm64 has NO plain fork; it uses clone(220, SIGCHLD=17, 0,0,0,0) — and
//          because every clone arg past `flags` is 0, the CONFIG_CLONE_BACKWARDS
//          arg-order divergence is MOOT (only flags is non-zero), so the LINUX legs
//          dissolve cleanly (x86_64 fork=57 / arm64 clone=220). BUT darwin fork(2)
//          is a 2nd-RETURN-REGISTER syscall: it returns the child pid in x0 for BOTH
//          processes and disambiguates the child by x1==1 (confirmed by the floor
//          self/runtime_emit_full.hexa:1795-1808 _cf-style dual-register capture).
//          The single-result __hx_syscall6 exposes only x0, so the Route C darwin
//          leg CANNOT tell parent from child — a genuine wall identical to darwin
//          pipe (the real darwin fork stays the floor's raw-asm dual-reg shim). On
//          top of that the SMOKE harness for fork must actually fork+_exit+waitpid a
//          live process (vs the composition tests here), so batch J carries fork
//          alone with its own careful process-fork harness.

// clock_gettime: out-ptr timespec (getrusage shape). Linux = uniform 2-arg, kernel
// writes *ts; only the NR varies per-arch. darwin = no trap → synthesize from
// gettimeofday(116) directly into the caller's ts (leak-free).
pub fn hxlcl_clock_gettime(clk: HexaVal, ts: HexaVal) -> int {
    if target_is_linux() {
        let mut nr = 113                       // Linux arm64 __NR_clock_gettime
        if target_is_x86_64() { nr = 228 }     // Linux x86_64 __NR_clock_gettime
        let r = __hx_syscall6(nr, clk, ts, 0, 0, 0, 0)
        let neg = __hx_payload_lt(r, 0)
        if __hx_payload_ne(neg, 0) {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
            return -1
        }
        return r                                // 0 on success (kernel wrote *ts)
    }
    // darwin: no clock_gettime trap → gettimeofday(116, ts, NULL) writes a timeval
    // {tv_sec @0 (8B), tv_usec @8 (32-bit suseconds_t)} INTO the caller's timespec
    // buffer; convert to timespec {tv_sec @0, tv_nsec @8 (64-bit) = usec*1000} in
    // place. The store64 of nsec overwrites the 32-bit usec slot AND the trailing 4
    // garbage bytes (timeval is 12B, timespec is 16B). NULL-gated: clock_gettime
    // with a NULL ts is meaningless, and we cannot gettimeofday into NULL. The
    // load32 reads exactly the 32-bit usec (zero-extended) — no zero-init needed.
    let pts = __hx_payload_add(ts, 0)          // timespec* ts (raw, may be NULL)
    if __hx_payload_ne(pts, 0) {
        __hx_syscall6(116, pts, 0, 0, 0, 0, 0) // gettimeofday(ts, NULL)
        let usec = __hx_ptr_load32(pts, 8)     // tv_usec (32-bit, zero-extended)
        let nsec = __hx_payload_mul(usec, 1000)
        __hx_ptr_store64(pts, 8, nsec)         // ts.tv_nsec = usec * 1000
    }
    return 0
}

// execve: plain 3-arg (path, argv, envp); only the NR diverges on arm64. Returns
// ONLY on failure (success replaces the process), so the errno epilogue is the
// whole body. Linux failure → -1 + errno; darwin returns the raw positive errno
// (carry-flag not read — the documented deferred darwin errno path).
pub fn hxlcl_execve(path: HexaVal, argv: HexaVal, envp: HexaVal) -> int {
    let mut nr = 59                            // darwin SYS_execve / x86_64 default
    if target_is_linux() {
        if target_is_x86_64() { nr = 59 }      // Linux x86_64 __NR_execve
        else { nr = 221 }                      // Linux arm64 __NR_execve
    }
    let r = __hx_syscall6(nr, path, argv, envp, 0, 0, 0)
    let neg = __hx_payload_lt(r, 0)
    if __hx_payload_ne(neg, 0) {
        if target_is_linux() {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
        }
        return -1
    }
    return r                                    // unreachable on success (image replaced)
}

// ── batch J: fork (clean syscall family LAST leaf) ─────────────────────────────
//
// fork() = the 0-arg process clone — the final clean errno-bearing syscall leaf
// closing the Route C syscall family. Continues the close-mirror discipline (raw-
// payload `__hx_payload_lt`/`_ne`/`_sub`, never bare `<`/`-`, + the target_is_linux()
// -gated errno store via the already-whitelisted __errno_location). It is the EXACT
// pipe (#4076) pattern: the LINUX legs DISSOLVE via the single-result __hx_syscall6,
// and the darwin 2nd-return-register leg DISSOLVES via __hx_syscall6_out2 (the
// dual-return intrinsic capturing x0/x1 + carry).
//
//   LINUX dissolve — fork returns the child pid to the parent and 0 to the child in
//        a SINGLE result register (rax/x0), uniform -errno on failure, so the close
//        errno epilogue is the whole story. The NR (and the arm64 arg-shape) diverge:
//          x86_64 → __NR_fork = 57, plain 0-arg.
//          arm64  → has NO plain fork; the asm-generic ABI provides only clone, so
//                   fork is clone(220, flags = SIGCHLD = 17, 0,0,0,0). Because EVERY
//                   clone arg past `flags` is 0, the CONFIG_CLONE_BACKWARDS arg-order
//                   divergence (stack/parent_tid/child_tid/tls ordering) is MOOT —
//                   only `flags` is non-zero, so the order of the trailing zeros is
//                   irrelevant. SIGCHLD=17 = the child-exit signal that makes the
//                   clone behave as a fork (parent gets SIGCHLD on child exit). This
//                   is the dup2→dup3 "extra-flag-arg" divergence class (batch's
//                   established pattern), not a new arg-shape.
//   DARWIN dissolve — fork(2) is a 2nd-RETURN-REGISTER syscall: the BSD trap returns
//        the child pid in x0 for BOTH processes and disambiguates the child by x1==1
//        (parent has x1==0; carry-set → failure). This DISSOLVES via the
//        __hx_syscall6_out2 intrinsic, which captures x0/x1 + the carry flag into a
//        heap scratch — mirroring the floor's raw-asm dual-register shim
//        (self/runtime_emit_full.hexa:1801-1808, the `cset cf,cs / mov x0 / mov x1`
//        explicit-asm dual capture). The darwin carry-flag error → errno store is
//        deferred (discipline ④). default-OFF so the floor shim is the live darwin
//        fork — Route C darwin is research-only.
//
// NR ref-match (no black-box; in-repo tables + WebFetch-confirmed asm-generic):
//   fork  x86_64 = 57   (arch/x86 syscall_64.tbl; self/rt/syscall.hexa:74
//                        SYS_LINUX_FORK -> 57)
//         arm64  = 220  (no plain fork → __NR_clone; uapi/asm-generic/unistd.h
//                        `#define __NR_clone 220`, WebFetch-confirmed) flags=SIGCHLD=17
//         darwin = 2    (BSD SYS_fork; self/rt/syscall.hexa:103 SYS_DARWIN_FORK ->
//                        0x2000002 — 2nd-return-reg wall, floor dual-reg shim only)
//
// _is_cabi has hxlcl_fork (#4087). The darwin leg adds ONE new ADD-only intrinsic
// __hx_syscall6_out2 (the dual-return sibling — bind.hexa whitelist + arm64/x86_64
// STMT_CALL special-case; NO new parser keyword/@attr, so frozen 151c52c8 immutable).
// Otherwise reuses __hx_payload_eq/_ne/_add + __hx_ptr_load64/store32 + hxlcl_malloc.
// default-OFF byteeq-neutral (HEXA_CABI_HXLCL unset → empty whitelist → PAIR-MODEL
// emit byte-identical; the new intrinsic only emits when a whitelisted body calls it).
//
// With the darwin 2nd-return-register dissolve, the Route C syscall family is dry
// (remaining walls: stdio FILE* struct, getenv frozen-export, TERMINAL [float
// XMM-ABI / setjmp]).
pub fn hxlcl_fork() -> int {
    if target_is_linux() {
        let mut nr = 220                       // Linux arm64 __NR_clone (no plain fork)
        let mut a1 = 17                        //   clone flags = SIGCHLD (child-exit signal)
        if target_is_x86_64() {
            nr = 57                            // Linux x86_64 __NR_fork
            a1 = 0                             //   plain fork: no clone arg
        }
        let r = __hx_syscall6(nr, a1, 0, 0, 0, 0, 0)
        let neg = __hx_payload_lt(r, 0)
        if __hx_payload_ne(neg, 0) {
            let p = __errno_location()
            let e = __hx_payload_sub(0, r)
            __hx_ptr_store32(p, 0, e)
            return -1
        }
        return r                                // parent: child pid · child: 0
    }
    // darwin: fork(2) is a 2nd-return-register syscall — both processes get the
    // child pid in x0; the CHILD is disambiguated by x1==1 (parent has x1==0).
    // __hx_syscall6_out2 captures x0/x1/carry into a 24-byte heap scratch (leaks
    // 24B — fork is not hot-looped). This mirrors the floor's raw-asm dual-register
    // shim (self/runtime_emit_full.hexa:1801-1808: `svc; cset cf,cs; mov x0; mov
    // x1; if cf errno; if x1==1 child`). The darwin carry-flag error → errno store
    // is DEFERRED (darwin __error() round, discipline ④); on error we return -1.
    let szf = __hx_payload_add(0, 24)           // HexaVal-box the scratch size
    let scr = hxlcl_malloc(szf)
    __hx_syscall6_out2(2, 0, 0, 0, 0, 0, 0, scr)    // BSD fork — no args; x0=pid, x1==1 ⇒ child
    let cf = __hx_ptr_load64(scr, 16)
    if __hx_payload_ne(cf, 0) {
        return -1                               // darwin error (carry set); errno deferred
    }
    let x1v = __hx_ptr_load64(scr, 8)           // x1: ==1 in child, 0 in parent
    let ischild = __hx_payload_eq(x1v, 1)
    if __hx_payload_ne(ischild, 0) {
        return 0                                // child
    }
    let x0v = __hx_ptr_load64(scr, 0)           // x0 = child pid
    return x0v                                   // parent: child pid
}

// ── WALL 3-a — CORE FILE* FAMILY (fd-level fake-pointer stdio subset) ────────
//
// The FROZEN 0-libc floor (self/runtime_emit_full.hexa:1153-1242) encodes a FILE*
// as `(void *)(uintptr_t)(fd + 1)` — NOT a libc stdio struct. So the whole
// fopen/fread/fwrite/fseek/ftell/fclose/fdopen subset is a PURE COMPOSITION over
// the already-dissolved Route C syscall leaves (open_sys / read / write / lseek /
// close) + raw-payload pointer arithmetic — ZERO new intrinsic, ZERO libc-struct
// coupling. The `(fd+1)` wrap/unwrap is literally `__hx_payload_add(fd,1)` /
// `__hx_payload_sub(fp,1)`. Reference-matched body-for-body to the frozen emitter
// bodies cited at each fn.
//
// IN-BODY OPERATOR DISCIPLINE (same as the syscall family above): every test uses
// the raw-payload leaf intrinsics (__hx_payload_lt/le/ge/eq/ne/add/sub/mul/div),
// NEVER bare `<`/`-`/`*` (which lower to the PAIR-MODEL HexaVal helpers undefined
// in the raw C-ABI link), each writing exactly one un-nested `let`. Inner calls to
// the sibling C-ABI leaves (hxlcl_open_sys/read/write/lseek/close) lower as
// single-register `bl` (the call boundary keys on the whitelisted callee name).
//
// SCOPE (honest): the libc-global streams stderr/stdout/stdin (the frozen
// _hxlcl_fp_fd `v >= 0x1000` branch) are OUT of this wall — a fake FILE* here is
// always a freshly-fopen'd / fdopen'd fd+1 handle (the only kind the floor's file
// helpers rt_read_file/rt_write_file ever pass). A high pointer (a libc stdio
// global) is therefore failed-safe (fread/fwrite → 0 items, ftell/fseek → -1,
// fclose → 0 no-op), the same fail-closed treatment the frozen `v >= 0x1000`
// guard gives fclose; their real handling stays on the shim (addressed later via
// @asm + fd constants, per the runtime_emit_full.hexa:1147-1152 note).

// hxlcl_fopen: map the mode string to open(2) flags, issue the open_sys syscall,
// and return the fd+1 fake FILE* (0/NULL on any error). BYTE-FAITHFUL to
// self/runtime_emit_full.hexa:1153-1177. O_* flag VALUES differ per OS, so they
// are compile-time consts selected by target_is_linux() (DCE drops the dead leg),
// exactly like the per-target syscall NRs; the access/create/trunc/append bits are
// DISJOINT, so `__hx_payload_add` composes them as bitwise-OR. mode 0644 == 420.
pub fn hxlcl_fopen(path: HexaVal, mode: HexaVal) -> int {
    let pnull = __hx_payload_eq(path, 0)
    if __hx_payload_ne(pnull, 0) { return 0 }
    let mnull = __hx_payload_eq(mode, 0)
    if __hx_payload_ne(mnull, 0) { return 0 }
    // per-target O_CREAT/O_TRUNC/O_APPEND (darwin defaults; Linux overrides).
    let mut o_creat = 512                        // darwin O_CREAT (0x0200)
    let mut o_trunc = 1024                       // darwin O_TRUNC (0x0400)
    let mut o_append = 8                         // darwin O_APPEND (0x0008)
    if target_is_linux() {
        o_creat = 64                             // Linux O_CREAT (0100)
        o_trunc = 512                            // Linux O_TRUNC (01000)
        o_append = 1024                          // Linux O_APPEND (02000)
    }
    // detect the '+' update flag: mode[1]=='+' OR (mode[1]!=0 AND mode[2]=='+').
    let c0 = __hx_ptr_load8(mode, 0)             // mode[0]
    let c1 = __hx_ptr_load8(mode, 1)             // mode[1]
    let mut plus = 0
    let p1 = __hx_payload_eq(c1, 43)             // mode[1] == '+'
    if __hx_payload_ne(p1, 0) {
        plus = 1
    } else {
        let c1nz = __hx_payload_ne(c1, 0)        // mode[1] != 0
        if __hx_payload_ne(c1nz, 0) {
            let c2 = __hx_ptr_load8(mode, 2)     // mode[2]
            let p2 = __hx_payload_eq(c2, 43)     // mode[2] == '+'
            if __hx_payload_ne(p2, 0) { plus = 1 }
        }
    }
    // access mode → flags. '+' upgrades the access bits to O_RDWR (2); the
    // create/trunc/append extras are preserved (disjoint-bit ADD == OR).
    let mut flags = 0
    let mut ok = 0
    let isr = __hx_payload_eq(c0, 114)           // 'r'
    if __hx_payload_ne(isr, 0) {
        flags = 0                                // O_RDONLY
        if __hx_payload_ne(plus, 0) { flags = 2 }   // O_RDWR
        ok = 1
    }
    let isw = __hx_payload_eq(c0, 119)           // 'w'
    if __hx_payload_ne(isw, 0) {
        let extras = __hx_payload_add(o_creat, o_trunc)
        let mut acc = 1                          // O_WRONLY
        if __hx_payload_ne(plus, 0) { acc = 2 }  // O_RDWR
        flags = __hx_payload_add(acc, extras)
        ok = 1
    }
    let isa = __hx_payload_eq(c0, 97)            // 'a'
    if __hx_payload_ne(isa, 0) {
        let extras = __hx_payload_add(o_creat, o_append)
        let mut acc = 1                          // O_WRONLY
        if __hx_payload_ne(plus, 0) { acc = 2 }  // O_RDWR
        flags = __hx_payload_add(acc, extras)
        ok = 1
    }
    let badmode = __hx_payload_eq(ok, 0)         // mode[0] not r/w/a
    if __hx_payload_ne(badmode, 0) { return 0 }
    let fd = hxlcl_open_sys(path, flags, __hx_payload_add(0, 420))    // 0644 (HexaVal-boxed mode)
    let bad = __hx_payload_lt(fd, 0)
    if __hx_payload_ne(bad, 0) { return 0 }      // open failed → NULL
    // leak guard (frozen :1175): a fresh file fd can only be 0/1/2 if a
    // syscall-wrapper regression returned errno-as-fd; fail closed, never alias
    // stdin/stdout/stderr and leak user content.
    let le2 = __hx_payload_le(fd, 2)
    if __hx_payload_ne(le2, 0) { return 0 }
    return __hx_payload_add(fd, 1)               // fake FILE* = (fd + 1)
}

// hxlcl_fclose: unwrap fd+1 and close(2). BYTE-FAITHFUL to
// self/runtime_emit_full.hexa:1178-1187. A NULL fp → -1; a libc-global FILE*
// (>= 0x1000) → 0 (never close it); 0/1/2 → 0 (never close the std streams).
pub fn hxlcl_fclose(fp: HexaVal) -> int {
    let fnull = __hx_payload_eq(fp, 0)
    if __hx_payload_ne(fnull, 0) { return -1 }
    let fhigh = __hx_payload_ge(fp, 4096)        // 0x1000 — libc FILE* sentinel
    if __hx_payload_ne(fhigh, 0) { return 0 }    // libc stdio global — don't close
    let fd = __hx_payload_sub(fp, 1)
    let lo = __hx_payload_lt(fd, 3)
    if __hx_payload_ne(lo, 0) { return 0 }       // never close 0/1/2
    return hxlcl_close(fd)
}

// hxlcl_fread: unwrap fd+1, read `size`-byte items, loop over partial reads, and
// return the ITEM count (got / size — the libc contract, NOT a byte count).
// BYTE-FAITHFUL to self/runtime_emit_full.hexa:1199-1213 (the _hxlcl_fp_fd fd+1
// branch; the libc-global branch is out of scope → high pointers yield 0 items).
// Unbuffered fd wrapper — no stdio buffering (matches the floor).
pub fn hxlcl_fread(buf: HexaVal, sz: HexaVal, n: HexaVal, fp: HexaVal) -> int {
    let bnull = __hx_payload_eq(buf, 0)
    if __hx_payload_ne(bnull, 0) { return 0 }
    let szz = __hx_payload_eq(sz, 0)
    if __hx_payload_ne(szz, 0) { return 0 }
    let nz = __hx_payload_eq(n, 0)
    if __hx_payload_ne(nz, 0) { return 0 }
    let fnull = __hx_payload_eq(fp, 0)
    if __hx_payload_ne(fnull, 0) { return 0 }
    let fhigh = __hx_payload_ge(fp, 4096)
    if __hx_payload_ne(fhigh, 0) { return 0 }    // libc FILE* unsupported here
    let fd = __hx_payload_sub(fp, 1)
    let total = __hx_payload_mul(sz, n)
    let mut got = 0
    let mut cont = __hx_payload_lt(got, total)
    while __hx_payload_ne(cont, 0) {
        let remain = __hx_payload_sub(total, got)
        let dstp = __hx_payload_add(buf, got)
        let r = hxlcl_read(fd, dstp, remain)
        let stop = __hx_payload_le(r, 0)         // EOF or error → stop
        if __hx_payload_ne(stop, 0) {
            cont = 0
        } else {
            got = __hx_payload_add(got, r)
            cont = __hx_payload_lt(got, total)
        }
    }
    return __hx_payload_div(got, sz)             // item count
}

// hxlcl_fwrite: write-side mirror of fread (calls hxlcl_write). BYTE-FAITHFUL to
// self/runtime_emit_full.hexa:1214-1227. Returns the item count (put / size).
pub fn hxlcl_fwrite(buf: HexaVal, sz: HexaVal, n: HexaVal, fp: HexaVal) -> int {
    let bnull = __hx_payload_eq(buf, 0)
    if __hx_payload_ne(bnull, 0) { return 0 }
    let szz = __hx_payload_eq(sz, 0)
    if __hx_payload_ne(szz, 0) { return 0 }
    let nz = __hx_payload_eq(n, 0)
    if __hx_payload_ne(nz, 0) { return 0 }
    let fnull = __hx_payload_eq(fp, 0)
    if __hx_payload_ne(fnull, 0) { return 0 }
    let fhigh = __hx_payload_ge(fp, 4096)
    if __hx_payload_ne(fhigh, 0) { return 0 }    // libc FILE* unsupported here
    let fd = __hx_payload_sub(fp, 1)
    let total = __hx_payload_mul(sz, n)
    let mut put = 0
    let mut cont = __hx_payload_lt(put, total)
    while __hx_payload_ne(cont, 0) {
        let remain = __hx_payload_sub(total, put)
        let srcp = __hx_payload_add(buf, put)
        let r = hxlcl_write(fd, srcp, remain)
        let stop = __hx_payload_le(r, 0)         // error or zero-progress → stop
        if __hx_payload_ne(stop, 0) {
            cont = 0
        } else {
            put = __hx_payload_add(put, r)
            cont = __hx_payload_lt(put, total)
        }
    }
    return __hx_payload_div(put, sz)             // item count
}

// hxlcl_ftell: current offset via lseek(fd, 0, SEEK_CUR=1). BYTE-FAITHFUL to
// self/runtime_emit_full.hexa:1228-1232. NULL / libc-global fp → -1.
pub fn hxlcl_ftell(fp: HexaVal) -> int {
    let fnull = __hx_payload_eq(fp, 0)
    if __hx_payload_ne(fnull, 0) { return -1 }
    let fhigh = __hx_payload_ge(fp, 4096)
    if __hx_payload_ne(fhigh, 0) { return -1 }   // libc FILE* unsupported here
    let fd = __hx_payload_sub(fp, 1)
    return hxlcl_lseek(fd, __hx_payload_add(0, 0), __hx_payload_add(0, 1))   // off=0, SEEK_CUR=1 (HexaVal-boxed)
}

// hxlcl_fseek: lseek(fd, offset, whence) → 0 on success, -1 on failure.
// BYTE-FAITHFUL to self/runtime_emit_full.hexa:1233-1237. SEEK_* constants are
// uniform across Linux/darwin so `whence` passes through unchanged.
pub fn hxlcl_fseek(fp: HexaVal, offset: HexaVal, whence: HexaVal) -> int {
    let fnull = __hx_payload_eq(fp, 0)
    if __hx_payload_ne(fnull, 0) { return -1 }
    let fhigh = __hx_payload_ge(fp, 4096)
    if __hx_payload_ne(fhigh, 0) { return -1 }   // libc FILE* unsupported here
    let fd = __hx_payload_sub(fp, 1)
    let r = hxlcl_lseek(fd, offset, whence)
    let bad = __hx_payload_lt(r, 0)
    if __hx_payload_ne(bad, 0) { return -1 }
    return 0
}

// hxlcl_fdopen: wrap a raw fd as the fd+1 fake FILE* (mode ignored — these are
// unbuffered fd wrappers). BYTE-FAITHFUL to self/runtime_emit_full.hexa:1238-1242.
pub fn hxlcl_fdopen(fd: HexaVal, mode: HexaVal) -> int {
    let bad = __hx_payload_lt(fd, 0)
    if __hx_payload_ne(bad, 0) { return 0 }
    return __hx_payload_add(fd, 1)              // (mode unused — unbuffered wrapper)
}

// ── WALL 3-b — STD-STREAM FAMILY (fputs/fputc/fflush · std-fd dissolve) ──────
//
// The frozen 0-libc floor keeps THREE stdio helpers on the libc-global path that
// the CORE FILE* family (Wall 3-a) explicitly carved out: hxlcl_fputs / hxlcl_fputc
// / hxlcl_fflush. Their real callers in the runtime (self/runtime_emit_full.hexa:
// 6132 `fputs(prompt, stdout)` · 11788 `fputs(line, stderr)` · 11790 `fputc('\n',
// stderr)` · the `fflush(NULL)`/`fflush(stdout)` sites) pass the LIBC GLOBALS
// stdout/stderr — NOT the fd+1 fake FILE* of the CORE family — so the frozen body
// detects the target fd by the pointer-compare `if (fp == (void*)stderr) fd = 2;`
// (default fd=1), self/runtime_emit_full.hexa:1014-1027. That extern-global
// pointer-compare is what kept these on the shim: a Route C body could not read the
// ADDRESS of the libc `stderr`/`stdout` globals.
//
// The ONE new substrate piece (the named-data sibling of __hx_environ_ptr / #4098)
// is `__hx_stderr_ptr()` — a 0-arg intrinsic loading `&stderr` (FILE**) through the
// GOT (x86_64-linux glibc `stderr@GOTPCREL`; darwin `__stderrp@GOTPAGE`, the
// `#define stderr __stderrp` macro target). ONE __hx_ptr_load64 deref yields the
// `stderr` FILE* value itself, so `__hx_payload_eq(fp, stderrval)` replicates the
// frozen `fp == (void*)stderr` BYTE-FAITHFULLY — no behavioural deviation, the
// `fputs(line, stderr)` site still routes to fd 2. (A companion __hx_stdout_ptr is
// whitelisted for symmetry but the faithful body needs only the stderr compare, to
// match the frozen single `if(fp==stderr)`.) Once fd is known these compose the
// already-dissolved Route C `bl hxlcl_write` syscall leaf (Wall 1) + a strlen scan.
//
// fprintf is the DEFERRED sibling (NOT in this wall): its frozen body
// (self/runtime_emit_full.hexa:1006 `hxlcl_fprintf(void*,const char*,...)`) takes a
// C `va_list ap` and forwards it to hxlcl_vfprintf_fd — hexa has NO va_list type,
// no va_start/va_copy/va_end intrinsics, and no variadic-arg forwarding across the
// C-ABI boundary, so it is a genuine architectural varargs-ABI wall (a whole new
// ABI, not realistic this round). fprintf stays the retained shim; std-stream is
// the fputs/fputc/fflush GO subset the census green-lit.
//
// IN-BODY OPERATOR DISCIPLINE (the #4042 rule) + un-nested lets throughout, same as
// the CORE FILE* family above: every test is a raw-payload leaf intrinsic, never a
// bare op (which would lower to the PAIR-MODEL HexaVal helpers undefined in the raw
// C-ABI link); the inner `bl hxlcl_write` lowers single-register C-ABI on the
// whitelisted callee name.

// hxlcl_write: raw-C-ABI write(2) syscall leaf — the Wall 1 dissolved body (defined
// above at the ERRNO-BEARING batch C). Declared so the std-stream bodies' inner
// `bl hxlcl_write` binds C-ABI; it is the SAME symbol, not re-emitted here.
//
// (No `extern fn` needed — hxlcl_write is a `pub fn` already in this file; the inner
// call resolves intra-object.)

// hxlcl_fputs: write the NUL-terminated string `s` to the stream `fp`, returning the
// byte count (>=0) or -1. BYTE-FAITHFUL to self/runtime_emit_full.hexa:1014-1019:
//   int fd = 1; if (fp == (void *)stderr) fd = 2;
//   if (!s) return -1; size_t n=0; while(s[n]) n++; return (int)hxlcl_write(fd,s,n);
// The std-stream detection is the frozen single `if(fp==stderr)`: default fd=1
// (stdout AND any other handle), fd=2 only when fp matches the libc stderr global —
// read via __hx_stderr_ptr()+__hx_ptr_load64 (the GOT named-data deref) so the
// compare is value-exact against the live `stderr` FILE*.
pub fn hxlcl_fputs(s: HexaVal, fp: HexaVal) -> int {
    let ps = __hx_payload_add(s, 0)               // const char* s (payload word)
    let pfp = __hx_payload_add(fp, 0)             // void* fp (payload word)
    let snull = __hx_payload_eq(ps, 0)
    if __hx_payload_ne(snull, 0) {
        return __hx_payload_sub(0, 1)             // !s → -1
    }
    // fd = 1; if (fp == stderr) fd = 2;
    let mut fd = 1
    let perr = __hx_stderr_ptr()                  // &stderr (FILE**)
    let errval = __hx_ptr_load64(perr, 0)         // *(&stderr) == the stderr FILE*
    let iserr = __hx_payload_eq(pfp, errval)
    if __hx_payload_ne(iserr, 0) {
        fd = 2
    }
    // n = strlen(s)
    let mut n = 0
    let mut c = __hx_ptr_load8(ps, 0)             // s[0]
    while __hx_payload_ne(c, 0) {
        n = __hx_payload_add(n, 1)
        c = __hx_ptr_load8(ps, n)                 // s[n]
    }
    return hxlcl_write(fd, ps, n)                 // C-ABI bl → bytes written
}

// hxlcl_fputc: write the single byte `c` to the stream `fp`, returning `c` on
// success or -1. BYTE-FAITHFUL to self/runtime_emit_full.hexa:1020-1024:
//   int fd = 1; if (fp == (void *)stderr) fd = 2;
//   unsigned char ch = (unsigned char)c; return hxlcl_write(fd,&ch,1)==1 ? c : -1;
// Same stderr detection as fputs. The frozen `unsigned char ch` stack scratch is a
// 1-byte HEAP scratch here (hxlcl_malloc(1) — no in-body stack-alloc intrinsic on
// this campaign, the batch-H scratch-buffer precedent); the low byte of `c` is
// stored and written. (Leaks 1 byte/call on the default-OFF HEXA_CABI_HXLCL=1
// research path — never shipped; flagged, like the batch-H poll caveat.)
pub fn hxlcl_fputc(c: HexaVal, fp: HexaVal) -> int {
    let pfp = __hx_payload_add(fp, 0)             // void* fp (payload word)
    // fd = 1; if (fp == stderr) fd = 2;
    let mut fd = 1
    let perr = __hx_stderr_ptr()                  // &stderr (FILE**)
    let errval = __hx_ptr_load64(perr, 0)         // *(&stderr) == the stderr FILE*
    let iserr = __hx_payload_eq(pfp, errval)
    if __hx_payload_ne(iserr, 0) {
        fd = 2
    }
    // ch = (unsigned char)c; write(fd, &ch, 1)
    let lowc = __hx_payload_and(c, 255)           // (unsigned char)c
    let one = __hx_payload_add(0, 1)              // HexaVal-box the literal 1 (#4082)
    let scratch = hxlcl_malloc(one)               // 1-byte heap scratch
    __hx_ptr_store8(scratch, 0, lowc)             // ch
    let w = hxlcl_write(fd, scratch, one)         // C-ABI bl → bytes written
    if __hx_payload_eq(w, 1) {
        return __hx_payload_add(c, 0)             // success → c (the ORIGINAL int, byte-faithful to the frozen `return c`)
    }
    return __hx_payload_sub(0, 1)                 // write failed → -1
}

// hxlcl_fflush: flush the stream `fp`. BYTE-FAITHFUL to
// self/runtime_emit_full.hexa:1025-1028 (`int hxlcl_fflush(void *fp){ (void)fp;
// return 0; }`) — the floor is UNBUFFERED (every write is a direct syscall, no
// stdio buffer), so flush is a definitional no-op returning success. No fd
// detection, no syscall, no new intrinsic — the trivial GO leaf of this wall.
pub fn hxlcl_fflush(fp: HexaVal) -> int {
    let _pfp = __hx_payload_add(fp, 0)            // (void)fp
    return 0
}

// ── WALL 3-c — POPEN FAMILY (pipe+fork+execve / close+waitpid · the LAST
//                             frozen-floor static-array dependency) ──────────
//
// hxlcl_popen/hxlcl_pclose replicate libc popen/pclose with NO libc popen call.
// popen("cmd","r") = pipe() + fork(); child dup2's the pipe write end onto fd 1 and
// execve("/bin/sh","-c",cmd); parent stores (read_fd, child_pid) in a file-local
// fd→pid table and returns the CORE-family `(fd+1)` fake FILE* (so hxlcl_fread reads
// the child's stdout). pclose(fp) decodes fd = fp-1, looks the pid up in the table,
// close()'s the fd and waitpid()'s the child → exit status. This is the EXACT frozen
// floor body (self/runtime_emit_full.hexa:3051-3091), reference-matched, composed
// purely over the ALREADY-dissolved Route C leaves — pipe (#4076), fork (#4087),
// dup2/close/execve/waitpid (Route C syscall family), malloc, fdopen (Wall 3-a).
//
// THE ONE NEW SUBSTRATE — file-local STATIC MUTABLE state. The frozen floor keeps the
// fd→pid map in three `static` C arrays (`_hxlcl_popen_fds[64]`, `_hxlcl_popen_pids[64]`,
// `_hxlcl_popen_init_done`). hxlcl_core.hexa has ZERO static-decl syntax and bind.hexa
// no static-alloc intrinsic, so this is the campaign's last frozen-safe lever:
// __hx_static_slot(slot_id, size_bytes) — a 0-source-keyword codegen intrinsic that
// DEFINES a self-static, zero-initialized .data buffer (`.zero N` via the system
// assembler under Route C) and returns its address. We use ONE 1024-byte slot of 64
// 16-byte entries: entry i = [fd_plus_1 : u64 @ +0][pid : u64 @ +8]. BSS is zero-init,
// so we encode "empty" as fd_plus_1==0 (store fd+1, never -1) — this DISSOLVES the
// frozen `_hxlcl_popen_init()` -1-fill entirely (no init pass needed). slot_id=900.
//
// IN-BODY OPERATOR DISCIPLINE (the #4042/#4082 rule): every test/arith is a raw-payload
// intrinsic (__hx_payload_{eq,ne,lt,add,sub,mul}), never a bare `==`/`<`/`-`; every raw
// integer literal crossing a HexaVal-param boundary is boxed via __hx_payload_add(0,N).
// Each intrinsic result lands in its own un-nested `let` (scratch-clobber safety).
//
// _is_cabi has hxlcl_popen/hxlcl_pclose (Wall 3-c). default-OFF byteeq-neutral
// (HEXA_CABI_HXLCL unset → empty whitelist → PAIR-MODEL emit byte-identical; the new
// __hx_static_slot only emits when a whitelisted body addresses it).

// Remember (read_fd, child_pid) in the next empty slot (fd_plus_1==0). No-op if full.
pub fn hxlcl_popen_remember(fd: HexaVal, pid: HexaVal) -> int {
    let tbl = __hx_static_slot(900, 1024)         // 64 × 16-byte entries, zero-init
    let fdp1 = __hx_payload_add(fd, 1)            // store fd+1 (0 = empty sentinel)
    let mut i = 0
    let cap = __hx_payload_add(0, 64)             // box literal 64 (#4082)
    while __hx_payload_lt(i, cap) {
        let off = __hx_payload_mul(i, 16)         // entry i base
        let cur = __hx_ptr_load64(tbl, off)       // current fd_plus_1
        if __hx_payload_eq(cur, 0) {              // empty slot
            __hx_ptr_store64(tbl, off, fdp1)      // entry.fd_plus_1 = fd+1
            let poff = __hx_payload_add(off, 8)   // entry.pid offset
            __hx_ptr_store64(tbl, poff, pid)      // entry.pid = pid
            return 0
        }
        i = __hx_payload_add(i, 1)
    }
    return -1                                      // table full
}

// Find+clear the entry for `fd`, return its pid (or -1 if not found).
pub fn hxlcl_popen_forget(fd: HexaVal) -> int {
    let tbl = __hx_static_slot(900, 1024)
    let fdp1 = __hx_payload_add(fd, 1)            // match on fd+1
    let mut i = 0
    let cap = __hx_payload_add(0, 64)
    while __hx_payload_lt(i, cap) {
        let off = __hx_payload_mul(i, 16)
        let cur = __hx_ptr_load64(tbl, off)
        if __hx_payload_eq(cur, fdp1) {           // match
            let poff = __hx_payload_add(off, 8)
            let pid = __hx_ptr_load64(tbl, poff)  // saved pid
            __hx_ptr_store64(tbl, off, 0)         // clear fd_plus_1 (mark empty)
            __hx_ptr_store64(tbl, poff, 0)        // clear pid
            return pid
        }
        i = __hx_payload_add(i, 1)
    }
    return -1
}

// hxlcl_popen(cmd, mode) — "r"-mode only (the only mode hexa_exec uses).
// Returns the CORE-family fake FILE* `(read_fd + 1)`, or 0 on failure.
pub fn hxlcl_popen(cmd: HexaVal, mode: HexaVal) -> int {
    let pcmd = __hx_payload_add(cmd, 0)           // char* cmd (payload word)
    if __hx_payload_eq(pcmd, 0) {
        return 0                                   // NULL cmd
    }
    let pmode = __hx_payload_add(mode, 0)         // char* mode
    if __hx_payload_eq(pmode, 0) {
        return 0
    }
    let m0 = __hx_ptr_load8(pmode, 0)             // mode[0]
    if __hx_payload_ne(m0, 114) {                 // 'r' == 114; only "r" supported
        return 0
    }
    // int pfd[2]; if (pipe(pfd) != 0) return 0;
    let two = __hx_payload_add(0, 2)
    let pfdsz = __hx_payload_mul(two, 4)          // 2 * sizeof(int)=8 bytes
    let pfd = hxlcl_malloc(pfdsz)
    let pr = hxlcl_pipe(pfd)
    if __hx_payload_ne(pr, 0) {
        return 0
    }
    let rfd = __hx_ptr_load32(pfd, 0)             // pfd[0] (read end)
    let wfd = __hx_ptr_load32(pfd, 4)             // pfd[1] (write end)
    let pid = hxlcl_fork()
    let isneg = __hx_payload_lt(pid, 0)
    if __hx_payload_ne(isneg, 0) {
        let _c0 = hxlcl_close(rfd)
        let _c1 = hxlcl_close(wfd)
        return 0
    }
    let ischild = __hx_payload_eq(pid, 0)
    if __hx_payload_ne(ischild, 0) {
        // child: dup2(wfd, 1); close both pipe fds; execve("/bin/sh","-c",cmd)
        let one = __hx_payload_add(0, 1)
        let _d = hxlcl_dup2(wfd, one)             // stdout = pipe write end
        let _cr = hxlcl_close(rfd)
        let _cw = hxlcl_close(wfd)
        // build argv = ["/bin/sh", "-c", cmd, NULL] as a char**[4]
        let four = __hx_payload_add(0, 4)
        let avsz = __hx_payload_mul(four, 8)      // 4 pointer slots
        let argv = hxlcl_malloc(avsz)
        let psh = __hx_payload_add("/bin/sh", 0)  // char* "/bin/sh"
        let pdc = __hx_payload_add("-c", 0)       // char* "-c"
        __hx_ptr_store64(argv, 0, psh)            // argv[0]
        __hx_ptr_store64(argv, 8, pdc)            // argv[1]
        __hx_ptr_store64(argv, 16, pcmd)          // argv[2] = cmd
        __hx_ptr_store64(argv, 24, 0)             // argv[3] = NULL
        let psh2 = __hx_payload_add("/bin/sh", 0) // path
        let _e = hxlcl_execve(psh2, argv, __hx_payload_add(0, 0))      // envp=NULL (HexaVal-boxed)
        // execve only returns on failure → terminate the child via exit syscall.
        // close everything we can and fall through to the parent-style cleanup is
        // unsafe (child must not return into the caller); issue exit(127) directly.
        let exnr = hxlcl_child_exit_nr()
        let onetwoseven = __hx_payload_add(0, 127)
        __hx_syscall6(exnr, onetwoseven, 0, 0, 0, 0, 0)  // _exit(127)
        return 0                                   // unreachable
    }
    // parent: close write end; remember (rfd, pid); return fdopen(rfd,"r")
    let _cw2 = hxlcl_close(wfd)
    let _rm = hxlcl_popen_remember(rfd, pid)
    return hxlcl_fdopen(rfd, mode)               // (rfd + 1) fake FILE*
}

// Per-target _exit syscall number (no errno path — the process is dying).
// Linux x86_64 __NR_exit=60 / arm64 __NR_exit=93 / darwin SYS_exit=1.
pub fn hxlcl_child_exit_nr() -> int {
    if target_is_linux() {
        if target_is_x86_64() { return 60 }
        return 93
    }
    return 1
}

// hxlcl_pclose(stream) — decode fd, waitpid the child, return status.
pub fn hxlcl_pclose(stream: HexaVal) -> int {
    let pstream = __hx_payload_add(stream, 0)     // the (fd+1) fake FILE* payload
    if __hx_payload_eq(pstream, 0) {
        return -1                                  // NULL stream
    }
    let fd = __hx_payload_sub(pstream, 1)         // fd = stream - 1
    let badfd = __hx_payload_lt(fd, 0)
    if __hx_payload_ne(badfd, 0) {
        return -1
    }
    let pid = hxlcl_popen_forget(fd)              // child pid (or -1)
    let _c = hxlcl_close(fd)
    let nopid = __hx_payload_lt(pid, 1)           // pid <= 0 → no child
    if __hx_payload_ne(nopid, 0) {
        return -1
    }
    // int status=0; waitpid(pid, &status, 0); return status;
    let four = __hx_payload_add(0, 4)
    let stbuf = hxlcl_malloc(four)                // 4-byte int status slot
    __hx_ptr_store32(stbuf, 0, 0)                 // status = 0
    let _w = hxlcl_waitpid(pid, stbuf, __hx_payload_add(0, 0))   // options=0 (HexaVal-boxed)
    let status = __hx_ptr_load32(stbuf, 0)        // raw wait status (frozen returns it)
    return status
}

// ── CTYPE FAMILY (Route C · isalnum/isalpha — pure register-only ASCII class) ──
//
// hxlcl_isalnum/hxlcl_isalpha are the FIRST register-only pure-compute Route C
// leaves: the arg is an `int c` VALUE (not a pointer), so the body does ZERO memory
// access (no __hx_ptr_load8) — only raw-payload range comparisons — and returns the
// classification 0/1 in the single C-ABI result register. No syscall, no errno, no
// inner call, no float; cross-target-identical (no NR / no arm64 call-shape
// divergence). The ranges are MUTUALLY EXCLUSIVE so the OR is a faithful add of the
// at-most-one set range flag (`(a)+(b)+(c)` is 0 or 1, never wraps).
//
// Same IN-BODY OPERATOR DISCIPLINE as the parse leaves: every test is a raw-payload
// intrinsic (__hx_payload_{add,ge,le,and,ne}) in its own un-nested `let`, never a
// bare op (which lowers to the PAIR-MODEL HexaVal helpers undefined in the raw C-ABI
// link). BYTE-FAITHFUL to the frozen 0-libc floor rt_isalnum/rt_isalpha bodies
// (self/runtime_emit_full.hexa:2265-2278, the #elif !HEXA_HAS_HEXA_RT_STDLIB
// fallback): '0'=48 '9'=57 'A'=65 'Z'=90 'a'=97 'z'=122.

// hxlcl_isalnum: 1 iff c is an ASCII letter or digit, else 0. Under the Route C gate
// the arg arrives raw in rdi/x0 and the result ships raw in rax/x0; default (gate
// OFF) compiles as a HexaVal fn (byteeq-neutral).
pub fn hxlcl_isalnum(c: HexaVal) -> int {
    let v = __hx_payload_add(c, 0)             // int c (raw value)
    let ge0 = __hx_payload_ge(v, 48)           // c>='0'
    let le9 = __hx_payload_le(v, 57)           // c<='9'
    let dig = __hx_payload_and(ge0, le9)
    let geA = __hx_payload_ge(v, 65)           // c>='A'
    let leZ = __hx_payload_le(v, 90)           // c<='Z'
    let upper = __hx_payload_and(geA, leZ)
    let gea = __hx_payload_ge(v, 97)           // c>='a'
    let lez = __hx_payload_le(v, 122)          // c<='z'
    let lower = __hx_payload_and(gea, lez)
    let s1 = __hx_payload_add(dig, upper)
    let s2 = __hx_payload_add(s1, lower)       // at most one range matches → 0/1
    if __hx_payload_ne(s2, 0) {
        return 1
    }
    return 0
}

// hxlcl_isalpha: 1 iff c is an ASCII letter, else 0. (isalnum minus the digit range.)
pub fn hxlcl_isalpha(c: HexaVal) -> int {
    let v = __hx_payload_add(c, 0)             // int c (raw value)
    let geA = __hx_payload_ge(v, 65)           // c>='A'
    let leZ = __hx_payload_le(v, 90)           // c<='Z'
    let upper = __hx_payload_and(geA, leZ)
    let gea = __hx_payload_ge(v, 97)           // c>='a'
    let lez = __hx_payload_le(v, 122)          // c<='z'
    let lower = __hx_payload_and(gea, lez)
    let s2 = __hx_payload_add(upper, lower)    // at most one range matches → 0/1
    if __hx_payload_ne(s2, 0) {
        return 1
    }
    return 0
}

// ── ALLOC RESIDUE (Route C · free — no-op leaf) ───────────────────────────────
//
// hxlcl_free is the frozen 0-libc floor's NO-OP free: the floor allocator is a bump
// arena (hxlcl_malloc never reclaims), so the floor body is literally `(void)p;`
// (self/runtime_core_hxlcl_shim.c:104 under HEXA_ZEROC_SHIM_BYTEID_EMIT — `void
// hxlcl_free(void *p){ (void)p; }`). Self-emitting it removes one more shim
// dependency from the Route C link with ZERO new mechanism: it touches the raw `p`
// payload (the `(void)p`) and returns — no syscall, no inner call, no memory access.
// (The sibling hxlcl_malloc stays the RETAINED extern — it routes to libc malloc /
// the live arena, which is genuinely arena-coupled and NOT a pure-compute leaf.)
//
// C declares `void hxlcl_free(void*)`; modelling it `-> int` returning the raw
// pointer word is harmless — every caller ignores the void return register.
// BYTE-FAITHFUL to the no-op floor body. Default (gate OFF) compiles as a HexaVal fn
// (byteeq-neutral — never linked in that mode).
pub fn hxlcl_free(p: HexaVal) -> int {
    let pp = __hx_payload_add(p, 0)            // (void)p — touch the arg, reclaim nothing
    return pp
}

// ── PURE-COMPUTE MIRROR batch 4 (Route C · parse leaf + no-op leaves) ──────────
//
// Three byte-faithful mirrors of the frozen 0-libc floor that need ZERO new codegen
// mechanism — each composes only the already-proven raw-payload intrinsics
// (__hx_payload_{add,sub,mul,div,and,eq,ne,ge,le,gt}) + __hx_ptr_{load8,store8}
// (the byte-scan + caller-write classes proven by strchr / strncpy). No syscall,
// no float, no inner call, no varargs → cross-target-identical bodies. Default
// (gate OFF) compiles as ordinary HexaVal fns (byteeq-neutral — never linked).

// hxlcl_inet_pton: parse a dotted-quad IPv4 string `src` into the 4-byte caller
// buffer `dst`; return 1 on success, 0 on malformed input (dst UNMODIFIED), -1 if
// `af` is not AF_INET (==2 on Linux AND Darwin). BYTE-FAITHFUL to the frozen 0-libc
// floor body (self/runtime_emit_full.hexa:2905-2929). The frozen C buffers the four
// octets in a `unsigned char b[4]` local and writes dst only after full validation
// (so a malformed input leaves dst untouched). With NO __hx_stack_alloc intrinsic
// in this campaign, the b[4] local is restructured into a single i64 `packed`
// accumulator (`packed = packed*256 + octet`, big-endian) — pure register
// arithmetic, no scratch buffer, no malloc — and the four bytes are extracted
// (div/and) and stored to dst ONLY on the success path: byte-for-byte the same
// observable contract (validate-all-then-write), just register-resident.
//   '0'=48 '9'=57 '.'=46  NUL=0.
pub fn hxlcl_inet_pton(af: HexaVal, src: HexaVal, dst: HexaVal) -> int {
    let afv = __hx_payload_add(af, 0)          // int af (raw value)
    if __hx_payload_ne(afv, 2) {               // af != AF_INET → -1
        return -1
    }
    let ps = __hx_payload_add(src, 0)          // const char *src
    let pd = __hx_payload_add(dst, 0)          // unsigned char *dst
    let mut i = 0                              // index into src
    let mut oct = 0                            // octets committed so far
    let mut cur = 0                            // current octet accumulator
    let mut hasdig = 0                         // 1 iff current octet saw ≥1 digit
    let mut packed = 0                         // committed octets, big-endian pack
    let mut ok = 1                             // 0 → malformed, will return 0
    let mut done = 0                           // 1 → stop scanning (NUL or error)
    while __hx_payload_eq(done, 0) {
        let c = __hx_ptr_load8(ps, i)          // (unsigned char)src[i]
        i = __hx_payload_add(i, 1)
        let dlo = __hx_payload_ge(c, 48)       // c >= '0'
        let dhi = __hx_payload_le(c, 57)       // c <= '9'
        let isdig = __hx_payload_and(dlo, dhi)
        if __hx_payload_ne(isdig, 0) {
            let d = __hx_payload_sub(c, 48)    // c - '0'
            let m = __hx_payload_mul(cur, 10)
            cur = __hx_payload_add(m, d)       // cur = cur*10 + (c-'0')
            hasdig = 1
            let over = __hx_payload_gt(cur, 255)
            if __hx_payload_ne(over, 0) {      // octet > 255 → malformed
                ok = 0
                done = 1
            }
        } else {
            let isdot = __hx_payload_eq(c, 46) // '.'
            let isnul = __hx_payload_eq(c, 0)  // '\0'
            let term = __hx_payload_add(isdot, isnul)  // 1 iff '.' or NUL (disjoint)
            if __hx_payload_ne(term, 0) {
                let nodig = __hx_payload_eq(hasdig, 0) // empty octet
                let toomany = __hx_payload_ge(oct, 4)  // already 4 octets
                let bad = __hx_payload_add(nodig, toomany)
                if __hx_payload_ne(bad, 0) {
                    ok = 0
                    done = 1
                } else {
                    let p8 = __hx_payload_mul(packed, 256)
                    packed = __hx_payload_add(p8, cur)  // commit octet (big-endian)
                    oct = __hx_payload_add(oct, 1)
                    cur = 0
                    hasdig = 0
                    if __hx_payload_ne(isnul, 0) {
                        done = 1               // end of string
                    }
                }
            } else {
                ok = 0                         // stray non-digit, non-'.' char
                done = 1
            }
        }
    }
    if __hx_payload_eq(ok, 0) {
        return 0
    }
    if __hx_payload_ne(oct, 4) {              // need EXACTLY four octets
        return 0
    }
    // Success: extract the four big-endian octets and write the caller buffer.
    let q3 = __hx_payload_div(packed, 16777216)
    let b0 = __hx_payload_and(q3, 255)         // first octet
    let q2 = __hx_payload_div(packed, 65536)
    let b1 = __hx_payload_and(q2, 255)
    let q1 = __hx_payload_div(packed, 256)
    let b2 = __hx_payload_and(q1, 255)
    let b3 = __hx_payload_and(packed, 255)     // last octet
    __hx_ptr_store8(pd, 0, b0)
    __hx_ptr_store8(pd, 1, b1)
    __hx_ptr_store8(pd, 2, b2)
    __hx_ptr_store8(pd, 3, b3)
    return 1
}

// hxlcl_setvbuf: the frozen floor's trivial no-op buffering stub — `(void)fp;
// (void)buf; (void)mode; (void)sz; return 0;` (self/runtime_emit_full.hexa:1247-1250,
// the 0-libc floor has no stdio buffering to configure). Register-only, returns the
// const success code 0 (like hxlcl_fflush). The four args are ignored.
pub fn hxlcl_setvbuf(fp: HexaVal, buf: HexaVal, mode: HexaVal, sz: HexaVal) -> int {
    return 0
}

// hxlcl_darwin_check_fd_set_overflow: the frozen floor's no-op fd_set overflow check —
// `(void)fd; (void)p; (void)n; return 0;  // never overflowing`
// (self/runtime_emit_full.hexa:2060-2063). Register-only, returns const 0. (This is
// the plain helper, distinct from hxlcl_fd_overflow which is a Darwin asm-label alias
// of ___darwin_check_fd_set_overflow and stays the floor — not a Route C target.)
pub fn hxlcl_darwin_check_fd_set_overflow(fd: HexaVal, p: HexaVal, n: HexaVal) -> int {
    return 0
}

// fp-ABI (xmm) RUNG 1 — the FIRST Route C symbol with SSE-class (`double`)
// params + return, exercising the new SysV §3.2.3 SSE-class boundary lowering
// (args xmm0/xmm1, return xmm0) added to compiler/codegen/x86_64_linux.hexa
// (`_cabi_sse_arg`/`_cabi_sse_ret`). This is the prerequisite root mechanism for
// native-emitting the libc-floor libm family (`double sin(double)` etc.) — the
// TERMINAL "[float XMM-ABI]" wall noted at hxlcl_core.hexa:2188.
//
// SYNTHETIC C-ABI prototype: `double hxlcl_fp_addmul(double x, double y)` returns
// `x * y + x`. The body uses the existing __hx_payload_fmul/fadd float intrinsics
// — those already movq the IEEE-754 bits GP↔xmm internally and run mulsd/addsd —
// so once the BOUNDARY (ingress xmm→gp, return gp→xmm0) is correct the whole fn
// computes the double result. `x` is reused twice (a*b + a), proving the SSE arg
// reaches the GP home intact. Params/return are typed HexaVal/int at the source
// level; the SSE class is asserted by the per-fn name-keyed classifier in codegen
// (no MIR type_id dependence — frozen-build-safe). default-OFF byteeq-neutral.
pub fn hxlcl_fp_addmul(x: HexaVal, y: HexaVal) -> int {
    let prod = __hx_payload_fmul(x, y)        // xmm: x * y  (bits in GP home)
    let sum = __hx_payload_fadd(prod, x)      // xmm: (x*y) + x
    return sum                                 // SSE-class return → xmm0
}

// hxlcl_fmod — FIRST native-emit libm leaf via the fp-ABI (xmm) Route C path.
// `double hxlcl_fmod(double x, double y)` returns the IEEE-754 remainder of x/y,
// libm-FREE: a 1:1 port of musl src/math/fmod.c (the modern 64-bit-uint64
// rewrite of SunPro fdlibm e_fmod.c — netlib.org/fdlibm/e_fmod.c). The result of
// fmod is mathematically EXACT, so this is CORRECTLY-ROUNDED (0 ULP vs libc fmod
// for every finite input). NO fmod()/<math.h> function: the only float ops are
// the NaN/Inf propagation `(x*y)/(x*y)` and the signed-zero `0*x`, bare hardware
// mulsd/divsd (no -lm symbol).
//
// THE BIT-REINTERPRET IS FREE. The SSE-class Route C ingress (PSABI §3.2.3)
// movq's x/y's xmm bits into their GP payload home (TAG_FLOAT). That payload word
// IS the raw IEEE-754 bit pattern — so the integer payload intrinsics
// (__hx_payload_and/or/shl/shr/sub/mul) operate on `ux.i` directly with NO
// reinterpret step. The float ops (__hx_payload_fmul/fdiv) read the SAME word as
// a double via movq GP→xmm. The return ships `uxi`'s payload word back through
// xmm0 (the SSE-ret branch movq's payload→xmm0 regardless of tag).
//
// LOGICAL shifts: musl uses C `uint64_t >>` (ZERO-FILL). __hx_payload_shr is the
// logical (shr/lsrv) shift, NOT the BinOp `>>` which is arithmetic (sar) — a
// negative double's sign bit must not sign-extend on `ux.i>>52`/`>>63`.
//
// UN-NESTED (str_core NESTING discipline, this file's header): every intrinsic
// call writes EXACTLY ONE `let`; comparisons use __hx_payload_eq/ne/lt/le/ge.
// reference: musl src/math/fmod.c (commit-stable; == fdlibm e_fmod.c algorithm).
// default-OFF byteeq-neutral (HEXA_CABI_HXLCL/HEXA_LIBM_NATIVE_FMOD off).
pub fn hxlcl_fmod(x: HexaVal, y: HexaVal) -> int {
    // ux.i / uy.i — the raw IEEE-754 bits (the FLOAT-tagged param payload word).
    let mut uxi = __hx_payload_add(x, 0)          // uint64_t uxi = ux.i
    let mut uyi = __hx_payload_add(y, 0)          // uint64_t uy.i
    // ex = ux.i>>52 & 0x7ff ;  ey = uy.i>>52 & 0x7ff ;  sx = ux.i>>63
    let ux52 = __hx_payload_shr(uxi, 52)
    let mut ex = __hx_payload_and(ux52, 2047)     // 0x7ff
    let uy52 = __hx_payload_shr(uyi, 52)
    let mut ey = __hx_payload_and(uy52, 2047)     // 0x7ff
    let sx = __hx_payload_shr(uxi, 63)            // sign of x (0 or 1)

    // if (uy.i<<1 == 0 || isnan(y) || ex == 0x7ff) return (x*y)/(x*y);
    //   uy.i<<1 == 0      → y is ±0
    //   isnan(y)          → (uy.i<<1) > (0x7ff0000000000000<<1) i.e. exp all-ones + frac!=0
    //   ex == 0x7ff       → x is inf/nan
    let uy1 = __hx_payload_shl(uyi, 1)            // uy.i<<1
    let y_is_zero = __hx_payload_eq(uy1, 0)
    // isnan(y): (uy.i<<1) >  (0x7ff0000000000000 << 1) == 0xffe0000000000000.
    // Compare as UNSIGNED magnitude: shr by 1 then >. Equivalent: uy1 > 0xffe0...
    // Use logical compare via subtraction-free path: isnan iff ey==0x7ff AND frac!=0.
    let y_exp_max = __hx_payload_eq(ey, 2047)
    let uy_frac = __hx_payload_and(uyi, 4503599627370495) // 0x000fffffffffffff
    let uy_frac_nz = __hx_payload_ne(uy_frac, 0)
    let y_is_nan = __hx_payload_and(y_exp_max, uy_frac_nz)
    let x_exp_max = __hx_payload_eq(ex, 2047)
    let e1 = __hx_payload_add(y_is_zero, y_is_nan)
    let e2 = __hx_payload_add(e1, x_exp_max)
    if __hx_payload_ne(e2, 0) {
        let p = __hx_payload_fmul(x, y)           // x*y
        let q = __hx_payload_fdiv(p, p)           // (x*y)/(x*y)  → NaN propagation
        return q
    }

    // if (uxi<<1 <= uy.i<<1) { if (uxi<<1 == uy.i<<1) return 0*x; return x; }
    // Compare the sign-stripped 64-bit magnitude words UNSIGNED (__hx_payload_ule):
    // after `<<1` the old exponent-MSB lands in bit-63, which is DATA not a sign, so
    // a signed compare would misorder large-exponent operands (musl uses C unsigned
    // `<=`). bits<<1 drops the sign bit; the rest orders by numeric magnitude.
    let ux1 = __hx_payload_shl(uxi, 1)
    let mag_le = __hx_payload_ule(ux1, uy1)       // |x| <= |y|  (unsigned)
    let mag_eq = __hx_payload_eq(ux1, uy1)        // |x| == |y|
    if __hx_payload_ne(mag_le, 0) {
        if __hx_payload_ne(mag_eq, 0) {
            let zx = __hx_payload_fmul(0.0, x)    // 0*x (signed zero)
            return zx
        }
        return uxi                                // bits of x (TAG carried via xmm0 ret)
    }

    // normalize x:  if (!ex) { for(i=uxi<<12; i>>63==0; ex--,i<<=1); uxi <<= -ex+1; }
    //               else { uxi &= -1ULL>>12; uxi |= 1ULL<<52; }
    if __hx_payload_eq(ex, 0) {
        let mut ii = __hx_payload_shl(uxi, 12)
        let mut hb = __hx_payload_shr(ii, 63)
        while __hx_payload_eq(hb, 0) {
            ex = __hx_payload_sub(ex, 1)
            ii = __hx_payload_shl(ii, 1)
            hb = __hx_payload_shr(ii, 63)
        }
        let negex = __hx_payload_sub(0, ex)       // -ex
        let sh = __hx_payload_add(negex, 1)       // -ex + 1
        uxi = __hx_payload_shl(uxi, sh)
    } else {
        let m = __hx_payload_and(uxi, 4503599627370495) // -1ULL>>12 == 0x000fffffffffffff
        let imp = __hx_payload_or(m, 4503599627370496)  // 1ULL<<52 == 0x0010000000000000
        uxi = __hx_payload_add(imp, 0)
    }
    // normalize y (mirror)
    if __hx_payload_eq(ey, 0) {
        let mut jj = __hx_payload_shl(uyi, 12)
        let mut hb2 = __hx_payload_shr(jj, 63)
        while __hx_payload_eq(hb2, 0) {
            ey = __hx_payload_sub(ey, 1)
            jj = __hx_payload_shl(jj, 1)
            hb2 = __hx_payload_shr(jj, 63)
        }
        let negey = __hx_payload_sub(0, ey)
        let shy = __hx_payload_add(negey, 1)
        uyi = __hx_payload_shl(uyi, shy)
    } else {
        let my = __hx_payload_and(uyi, 4503599627370495)
        let impy = __hx_payload_or(my, 4503599627370496)
        uyi = __hx_payload_add(impy, 0)
    }

    // x mod y:  for (; ex>ey; ex--) { i=uxi-uy.i; if(i>>63==0){ if(i==0) return 0*x; uxi=i;} uxi<<=1; }
    while __hx_payload_lt(ey, ex) {               // ex > ey
        let d = __hx_payload_sub(uxi, uyi)        // i = uxi - uy.i
        let dsign = __hx_payload_shr(d, 63)       // i>>63
        if __hx_payload_eq(dsign, 0) {
            if __hx_payload_eq(d, 0) {
                let zx2 = __hx_payload_fmul(0.0, x)
                return zx2
            }
            uxi = __hx_payload_add(d, 0)          // uxi = i
        }
        uxi = __hx_payload_shl(uxi, 1)            // uxi <<= 1
        ex = __hx_payload_sub(ex, 1)
    }
    // tail (one more subtract):  i=uxi-uy.i; if(i>>63==0){ if(i==0) return 0*x; uxi=i; }
    let dt = __hx_payload_sub(uxi, uyi)
    let dtsign = __hx_payload_shr(dt, 63)
    if __hx_payload_eq(dtsign, 0) {
        if __hx_payload_eq(dt, 0) {
            let zx3 = __hx_payload_fmul(0.0, x)
            return zx3
        }
        uxi = __hx_payload_add(dt, 0)
    }
    // for (; uxi>>52 == 0; uxi<<=1, ex--);  (renormalize)
    let mut top = __hx_payload_shr(uxi, 52)
    while __hx_payload_eq(top, 0) {
        uxi = __hx_payload_shl(uxi, 1)
        ex = __hx_payload_sub(ex, 1)
        top = __hx_payload_shr(uxi, 52)
    }

    // scale result:  if (ex>0) { uxi -= 1ULL<<52; uxi |= (uint64_t)ex<<52; }
    //                else { uxi >>= -ex + 1; }
    if __hx_payload_lt(0, ex) {                   // ex > 0
        uxi = __hx_payload_sub(uxi, 4503599627370496) // -= 1ULL<<52
        let exb = __hx_payload_shl(ex, 52)        // (uint64_t)ex << 52
        uxi = __hx_payload_or(uxi, exb)
    } else {
        let negex2 = __hx_payload_sub(0, ex)
        let rsh = __hx_payload_add(negex2, 1)     // -ex + 1
        uxi = __hx_payload_shr(uxi, rsh)
    }
    // uxi |= (uint64_t)sx << 63;  ux.i = uxi;  return ux.f;
    let sxb = __hx_payload_shl(sx, 63)            // sx << 63
    uxi = __hx_payload_or(uxi, sxb)
    return uxi                                     // bits → xmm0 (SSE-class return)
}

// ── hxlcl_sin — libm `double sin(double)` native-emit via the fp-ABI (xmm) Route C
// path. A 1:1 port of musl src/math/{sin,__sin,__cos,__rem_pio2}.c (SunPro/FreeBSD
// msun s_sin.c / k_sin.c / k_cos.c / e_rem_pio2.c), the small + medium
// argument-reduction paths. libm-FREE: NO sin()/<math.h>, only SSE
// mulsd/addsd/subsd via the __hx_payload_f* intrinsics + the integer bit-intrinsics
// on the raw IEEE-754 payload word.
//
// The __sin / __cos kernels are INLINED here (single self-contained fn — same
// discipline as hxlcl_fmod): the dispatch fills the top-level kernel args
// (kx/ky/kiy + want_cos/neg) per the n&3 musl table, then ONE inlined __sin block
// + ONE inlined __cos block compute the result (selected by want_cos, negated by
// neg). This avoids inter-fn HexaVal-typed literal args (the typechecker rejects a
// raw f64/i64 where a HexaVal param is declared) and the inner SSE-class call
// boundary entirely. Every `mut` carried across nested blocks is hoisted to the
// function-top scope (the hxlcl_fmod discipline — a block-local `let mut` reassigned
// from a sibling/child block is rejected by the binder).
//
// COVERAGE / measured wall: SMALL (|x| ~<= 9pi/4, plain double k*pi/2 subtraction) +
// MEDIUM (|x| < 2^20*pi/2 ≈ 1.647e6, the toint round-to-int + 3-round Cody-Waite
// reduction) ported VERBATIM. The LARGE path (Payne-Hanek __rem_pio2_large, a 66-int
// two_over_pi table) is NOT ported (🧱 separate ~400-line table leaf = honest next
// rung); for |x| beyond the threshold this returns x-x (NaN-ish), and the verify
// sweep stays inside the covered domain.
//
// The double→bits reinterpret is FREE (SSE-class Route C ingress movq's x's xmm bits
// into the GP payload home — same as hxlcl_fmod). The S1..S6/C1..C6 minimax
// coefficients + pio2 split constants become exact 64-bit immediates via
// const_float→float_to_bits→movq xmm. reference: musl src/math/{sin,__sin,__cos,
// __rem_pio2}.c (all constants verified bit-exact). default-OFF byteeq-neutral.
pub fn hxlcl_sin(x: HexaVal) -> int {
    // GET_HIGH_WORD(ix0, x); ix = ix0 & 0x7fffffff.  (uxi = the payload word)
    let uxi = __hx_payload_add(x, 0)              // raw IEEE-754 bits of x
    let hi = __hx_payload_shr(uxi, 32)            // high 32 bits
    let ix = __hx_payload_and(hi, 2147483647)     // & 0x7fffffff

    // |x| < 2**-26 (ix < 0x3e500000) → return x.  (test BEFORE the |x|<pi/4 kernel)
    if __hx_payload_ult(ix, 1045430272) {
        return uxi
    }
    // sin(Inf or NaN) is NaN :  ix >= 0x7ff00000  → return x - x
    if __hx_payload_ule(2146435072, ix) {
        let nan = __hx_payload_fsub(x, x)
        return nan
    }

    // ── top-level carried state (hoisted muts — fmod discipline) ──
    let sign = __hx_payload_shr(uxi, 63)          // sign of x (large-path only)
    let mut n = 0                                  // k mod 4 accumulator
    let mut reduced = 0                            // 1 once kx/ky/kiy are set
    let mut kx = __hx_payload_add(uxi, 0)          // kernel x  (reduced remainder)
    let mut ky = __hx_payload_fsub(x, x)           // kernel y  (tail; +0.0 default)
    let mut kiy = 0                                // kernel iy flag (tail-present)
    // medium-path scratch (hoisted)
    let mut qn = __hx_payload_fsub(x, x)           // round(x/(pi/2)) as a double
    let mut r = __hx_payload_fsub(x, x)            // reduced remainder hi
    let mut w = __hx_payload_fsub(x, x)            // reduction correction
    let mut ey = 0                                 // exponent of y[0]

    // |x| ~< pi/4 :  ix <= 0x3fe921fb  → __sin(x, 0.0, 0)  (no reduction, iy=0)
    if __hx_payload_ule(ix, 1072243195) {
        kx = __hx_payload_add(uxi, 0)             // kernel x = x
        kiy = 0                                    // iy = 0 (tail absent)
        n = 0                                      // sin path
        reduced = 1
    }

    // ── argument reduction (musl __rem_pio2 small + medium) ──
    // SMALL path bands: |x| in (pi/4, 9pi/4], plain double k*pi/2 subtraction,
    // diverting the |x|~=k*pi/2 cancellation cases to the MEDIUM toint path.
    let frac = __hx_payload_and(ix, 1048575)      // ix & 0xfffff
    let is_half = __hx_payload_eq(frac, 598523)   // == 0x921fb → near k*pi/2 (medium)

    // |x| ~<= 3pi/4 : ix <= 0x4002d97c  → k=1
    if __hx_payload_eq(reduced, 0) {
        let in_band1 = __hx_payload_ule(ix, 1073928572)
        let nothalf = __hx_payload_eq(is_half, 0)
        let do1 = __hx_payload_and(in_band1, nothalf)
        if __hx_payload_ne(do1, 0) {
            if __hx_payload_eq(sign, 0) {
                let z = __hx_payload_fsub(x, 1.57079632673412561417e+00)        // x - pio2_1
                ky = __hx_payload_fsub(z, 6.07710050650619224932e-11)           // z - pio2_1t
                let d = __hx_payload_fsub(z, ky)
                let t = __hx_payload_fsub(d, 6.07710050650619224932e-11)
                kx = __hx_payload_add(ky, 0)
                ky = __hx_payload_add(t, 0)
                n = 1
            } else {
                let z = __hx_payload_fadd(x, 1.57079632673412561417e+00)        // x + pio2_1
                ky = __hx_payload_fadd(z, 6.07710050650619224932e-11)
                let d = __hx_payload_fsub(z, ky)
                let t = __hx_payload_fadd(d, 6.07710050650619224932e-11)
                kx = __hx_payload_add(ky, 0)
                ky = __hx_payload_add(t, 0)
                n = -1
            }
            kiy = 1
            reduced = 1
        }
    }
    // 3pi/4 < |x| ~<= 5pi/4 : ix <= 0x400f6a7a  → k=2
    if __hx_payload_eq(reduced, 0) {
        let in_band2 = __hx_payload_ule(ix, 1074752122)
        let nothalf = __hx_payload_eq(is_half, 0)
        let do2 = __hx_payload_and(in_band2, nothalf)
        if __hx_payload_ne(do2, 0) {
            // 2*pio2_1 = 3.14159265346825122834e+00 ; 2*pio2_1t = 1.21542010130123844986e-10
            if __hx_payload_eq(sign, 0) {
                let z = __hx_payload_fsub(x, 3.14159265346825122834e+00)
                ky = __hx_payload_fsub(z, 1.21542010130123844986e-10)
                let d = __hx_payload_fsub(z, ky)
                let t = __hx_payload_fsub(d, 1.21542010130123844986e-10)
                kx = __hx_payload_add(ky, 0)
                ky = __hx_payload_add(t, 0)
                n = 2
            } else {
                let z = __hx_payload_fadd(x, 3.14159265346825122834e+00)
                ky = __hx_payload_fadd(z, 1.21542010130123844986e-10)
                let d = __hx_payload_fsub(z, ky)
                let t = __hx_payload_fadd(d, 1.21542010130123844986e-10)
                kx = __hx_payload_add(ky, 0)
                ky = __hx_payload_add(t, 0)
                n = -2
            }
            kiy = 1
            reduced = 1
        }
    }
    // 5pi/4 < |x| ~<= 7pi/4 : ix <= 0x4015fdbc  → k=3 (skip near 3pi/2 = 0x4012d97c)
    if __hx_payload_eq(reduced, 0) {
        let in_band3 = __hx_payload_ule(ix, 1075183036)
        let near32 = __hx_payload_eq(ix, 1074977148)
        let not32 = __hx_payload_eq(near32, 0)
        let do3 = __hx_payload_and(in_band3, not32)
        if __hx_payload_ne(do3, 0) {
            // 3*pio2_1 = 4.71238898020237684251e+00 ; 3*pio2_1t = 1.82313015195185767498e-10
            if __hx_payload_eq(sign, 0) {
                let z = __hx_payload_fsub(x, 4.71238898020237684251e+00)
                ky = __hx_payload_fsub(z, 1.82313015195185767498e-10)
                let d = __hx_payload_fsub(z, ky)
                let t = __hx_payload_fsub(d, 1.82313015195185767498e-10)
                kx = __hx_payload_add(ky, 0)
                ky = __hx_payload_add(t, 0)
                n = 3
            } else {
                let z = __hx_payload_fadd(x, 4.71238898020237684251e+00)
                ky = __hx_payload_fadd(z, 1.82313015195185767498e-10)
                let d = __hx_payload_fsub(z, ky)
                let t = __hx_payload_fadd(d, 1.82313015195185767498e-10)
                kx = __hx_payload_add(ky, 0)
                ky = __hx_payload_add(t, 0)
                n = -3
            }
            kiy = 1
            reduced = 1
        }
    }
    // 7pi/4 < |x| ~<= 9pi/4 : ix <= 0x401c463b  → k=4 (skip near 4pi/2 = 0x401921fb)
    if __hx_payload_eq(reduced, 0) {
        let in_band4 = __hx_payload_ule(ix, 1075594811)
        let near42 = __hx_payload_eq(ix, 1075388923)
        let not42 = __hx_payload_eq(near42, 0)
        let do4 = __hx_payload_and(in_band4, not42)
        if __hx_payload_ne(do4, 0) {
            // 4*pio2_1 = 6.28318530693650245667e+00 ; 4*pio2_1t = 2.43084020260247689972e-10
            if __hx_payload_eq(sign, 0) {
                let z = __hx_payload_fsub(x, 6.28318530693650245667e+00)
                ky = __hx_payload_fsub(z, 2.43084020260247689972e-10)
                let d = __hx_payload_fsub(z, ky)
                let t = __hx_payload_fsub(d, 2.43084020260247689972e-10)
                kx = __hx_payload_add(ky, 0)
                ky = __hx_payload_add(t, 0)
                n = 4
            } else {
                let z = __hx_payload_fadd(x, 6.28318530693650245667e+00)
                ky = __hx_payload_fadd(z, 2.43084020260247689972e-10)
                let d = __hx_payload_fsub(z, ky)
                let t = __hx_payload_fadd(d, 2.43084020260247689972e-10)
                kx = __hx_payload_add(ky, 0)
                ky = __hx_payload_add(t, 0)
                n = -4
            }
            kiy = 1
            reduced = 1
        }
    }

    // MEDIUM path: |x| < 2^20*(pi/2)  (ix < 0x413921fb).  toint = 0x1.8p52 = 1.5/EPS.
    if __hx_payload_eq(reduced, 0) {
        if __hx_payload_ult(ix, 1094263291) {
            // fn = x*invpio2 + toint - toint    (round-to-nearest-int as a double)
            let xi = __hx_payload_fmul(x, 6.36619772367581382433e-01)   // x*invpio2
            let fa = __hx_payload_fadd(xi, 6755399441055744.0)          // + toint
            qn = __hx_payload_fsub(fa, 6755399441055744.0)              // - toint
            n = __hx_payload_f2i(qn)              // n = (int32_t)qn
            // r = x - fn*pio2_1 ;  w = fn*pio2_1t
            let fnp1 = __hx_payload_fmul(qn, 1.57079632673412561417e+00)
            r = __hx_payload_fsub(x, fnp1)
            w = __hx_payload_fmul(qn, 6.07710050650619224932e-11)
            // pio4 = 0x1.921fb54442d18p-1 = 7.85398163397448278999e-01
            let rmw = __hx_payload_fsub(r, w)
            if __hx_payload_flt(rmw, -7.85398163397448278999e-01) {
                n = __hx_payload_sub(n, 1)
                qn = __hx_payload_fsub(qn, 1.0)
                let fnp1b = __hx_payload_fmul(qn, 1.57079632673412561417e+00)
                r = __hx_payload_fsub(x, fnp1b)
                w = __hx_payload_fmul(qn, 6.07710050650619224932e-11)
            } else {
                if __hx_payload_fgt(rmw, 7.85398163397448278999e-01) {
                    n = __hx_payload_add(n, 1)
                    qn = __hx_payload_fadd(qn, 1.0)
                    let fnp1c = __hx_payload_fmul(qn, 1.57079632673412561417e+00)
                    r = __hx_payload_fsub(x, fnp1c)
                    w = __hx_payload_fmul(qn, 6.07710050650619224932e-11)
                }
            }
            ky = __hx_payload_fsub(r, w)          // y[0] = r - w  (1st round)
            // ey = bits(y0)>>52 & 0x7ff ;  ex = ix>>20.
            let y0bits = __hx_payload_add(ky, 0)
            let y0sh = __hx_payload_shr(y0bits, 52)
            ey = __hx_payload_and(y0sh, 2047)
            let ex = __hx_payload_shr(ix, 20)
            let exmey = __hx_payload_sub(ex, ey)
            if __hx_payload_lt(16, exmey) {       // ex - ey > 16  → 2nd round
                // pio2_2 = 6.07710050630396597660e-11 ; pio2_2t = 2.02226624879595063154e-21
                let t = __hx_payload_add(r, 0)
                w = __hx_payload_fmul(qn, 6.07710050630396597660e-11)
                r = __hx_payload_fsub(t, w)
                let tmr = __hx_payload_fsub(t, r)
                let tmrmw = __hx_payload_fsub(tmr, w)
                let fp2t = __hx_payload_fmul(qn, 2.02226624879595063154e-21)
                w = __hx_payload_fsub(fp2t, tmrmw)
                ky = __hx_payload_fsub(r, w)
                let y0b2 = __hx_payload_add(ky, 0)
                let y0s2 = __hx_payload_shr(y0b2, 52)
                ey = __hx_payload_and(y0s2, 2047)
                let exmey2 = __hx_payload_sub(ex, ey)
                if __hx_payload_lt(49, exmey2) {  // ex - ey > 49  → 3rd round
                    // pio2_3 = 2.02226624871116645580e-21 ; pio2_3t = 8.47842766036889956997e-32
                    let t3 = __hx_payload_add(r, 0)
                    w = __hx_payload_fmul(qn, 2.02226624871116645580e-21)
                    r = __hx_payload_fsub(t3, w)
                    let tmr3 = __hx_payload_fsub(t3, r)
                    let tmrmw3 = __hx_payload_fsub(tmr3, w)
                    let fp3t = __hx_payload_fmul(qn, 8.47842766036889956997e-32)
                    w = __hx_payload_fsub(fp3t, tmrmw3)
                    ky = __hx_payload_fsub(r, w)
                }
            }
            let rmy0 = __hx_payload_fsub(r, ky)
            let y1v = __hx_payload_fsub(rmy0, w)  // y[1] = (r - y[0]) - w
            kx = __hx_payload_add(ky, 0)          // kernel x = y[0]
            ky = __hx_payload_add(y1v, 0)         // kernel y = y[1]
            kiy = 1
            reduced = 1
        }
    }

    // LARGE path NOT ported (🧱 Payne-Hanek __rem_pio2_large table) — return x-x.
    if __hx_payload_eq(reduced, 0) {
        let big = __hx_payload_fsub(x, x)
        return big
    }

    // ── n&3 → (want_cos, neg) per the musl sin.c switch ──
    //   case 0:  __sin(kx,ky,kiy)        want_cos=0 neg=0
    //   case 1:  __cos(kx,ky)            want_cos=1 neg=0
    //   case 2: -__sin(kx,ky,kiy)        want_cos=0 neg=1
    //   case 3: -__cos(kx,ky)            want_cos=1 neg=1
    let nm3 = __hx_payload_and(n, 3)
    let mut want_cos = 0
    let mut neg = 0
    if __hx_payload_eq(nm3, 1) { want_cos = 1 }
    if __hx_payload_eq(nm3, 2) { neg = 1 }
    if __hx_payload_eq(nm3, 3) {
        want_cos = 1
        neg = 1
    }

    // ── inlined __sin kernel (musl __sin.c · S1..S6) on (kx, ky, kiy) ──
    //   z=kx*kx; w=z*z; r=S2+z*(S3+z*S4)+z*w*(S5+z*S6); v=z*kx;
    //   kiy==0 ? kx + v*(S1+z*r) : kx - ((z*(0.5*ky - v*r) - ky) - v*S1)
    let mut sin_res = __hx_payload_fsub(x, x)
    if __hx_payload_eq(want_cos, 0) {
        let z = __hx_payload_fmul(kx, kx)
        let ww = __hx_payload_fmul(z, z)
        let zS4 = __hx_payload_fmul(z, 2.75573137070700676789e-06)        // z*S4
        let S3zS4 = __hx_payload_fadd(zS4, -1.98412698298579493134e-04)   // S3 + z*S4
        let zInner = __hx_payload_fmul(z, S3zS4)
        let part1 = __hx_payload_fadd(zInner, 8.33333333332248946124e-03) // S2 + …
        let zS6 = __hx_payload_fmul(z, 1.58969099521155010221e-10)        // z*S6
        let S5zS6 = __hx_payload_fadd(zS6, -2.50507602534068634195e-08)   // S5 + z*S6
        let zw = __hx_payload_fmul(z, ww)
        let part2 = __hx_payload_fmul(zw, S5zS6)
        let rr = __hx_payload_fadd(part1, part2)                          // r
        let v = __hx_payload_fmul(z, kx)                                  // v = z*kx
        if __hx_payload_eq(kiy, 0) {
            let zr = __hx_payload_fmul(z, rr)
            let s1zr = __hx_payload_fadd(zr, -1.66666666666666324348e-01) // S1 + z*r
            let vterm = __hx_payload_fmul(v, s1zr)
            sin_res = __hx_payload_fadd(kx, vterm)                        // kx + v*(…)
        } else {
            let halfy = __hx_payload_fmul(0.5, ky)
            let vr = __hx_payload_fmul(v, rr)
            let inner = __hx_payload_fsub(halfy, vr)                      // 0.5*ky - v*r
            let zin = __hx_payload_fmul(z, inner)
            let zinmy = __hx_payload_fsub(zin, ky)                        // z*(…) - ky
            let vS1 = __hx_payload_fmul(v, -1.66666666666666324348e-01)   // v*S1
            let bracket = __hx_payload_fsub(zinmy, vS1)
            sin_res = __hx_payload_fsub(kx, bracket)                      // kx - (…)
        }
    }

    // ── inlined __cos kernel (musl __cos.c · C1..C6) on (kx, ky) ──
    //   z=kx*kx; w=z*z; r=z*(C1+z*(C2+z*C3)) + w*w*(C4+z*(C5+z*C6));
    //   hz=0.5*z; w=1.0-hz; return w + (((1.0-w)-hz) + (z*r - kx*ky))
    let mut cos_res = __hx_payload_fsub(x, x)
    if __hx_payload_eq(want_cos, 1) {
        let z = __hx_payload_fmul(kx, kx)
        let w0 = __hx_payload_fmul(z, z)
        let zC3 = __hx_payload_fmul(z, 2.48015872894767294178e-05)        // z*C3
        let C2zC3 = __hx_payload_fadd(zC3, -1.38888888888741095749e-03)   // C2 + z*C3
        let zC2 = __hx_payload_fmul(z, C2zC3)
        let C1in = __hx_payload_fadd(zC2, 4.16666666666666019037e-02)     // C1 + …
        let rA = __hx_payload_fmul(z, C1in)
        let zC6 = __hx_payload_fmul(z, -1.13596475577881948265e-11)       // z*C6 (neg)
        let C5zC6 = __hx_payload_fadd(zC6, 2.08757232129817482790e-09)    // C5 + z*C6
        let zC5 = __hx_payload_fmul(z, C5zC6)
        let C4in = __hx_payload_fadd(zC5, -2.75573143513906633035e-07)    // C4 + …
        let wwc = __hx_payload_fmul(w0, w0)                               // w*w
        let rB = __hx_payload_fmul(wwc, C4in)
        let rr = __hx_payload_fadd(rA, rB)                               // r
        let hz = __hx_payload_fmul(0.5, z)                               // hz = 0.5*z
        let wc = __hx_payload_fsub(1.0, hz)                              // w = 1.0 - hz
        let omw = __hx_payload_fsub(1.0, wc)                             // 1.0 - w
        let omwmhz = __hx_payload_fsub(omw, hz)                          // (1.0-w) - hz
        let zr = __hx_payload_fmul(z, rr)                               // z*r
        let xy = __hx_payload_fmul(kx, ky)                              // kx*ky
        let zrmxy = __hx_payload_fsub(zr, xy)                           // z*r - kx*ky
        let tail = __hx_payload_fadd(omwmhz, zrmxy)
        cos_res = __hx_payload_fadd(wc, tail)                           // w + (…)
    }

    // select kernel result, then apply the sign from the n&3 table.
    let mut res = __hx_payload_add(sin_res, 0)
    if __hx_payload_eq(want_cos, 1) {
        res = __hx_payload_add(cos_res, 0)
    }
    if __hx_payload_eq(neg, 1) {
        let nres = __hx_payload_fsub(0.0, res)
        return nres
    }
    return res
}
