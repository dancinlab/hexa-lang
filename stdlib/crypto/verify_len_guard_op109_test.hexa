// HEXA Standard Library — crypto/verify_len_guard_op109_test
//
// @version 0.1.0
// @capabilities [pure]
//
// OP-109 PART A (LANE-2 0-pod) lock test — close the verify-side OOB flagged
// by OP-107: ed25519_verify / p256_verify lacked a DIRECT-call sig/pubkey
// LENGTH guard. A malformed direct call (short sig/pubkey/coordinate) OOB-reads
// the fixed-position indexing inside the verifier and traps `index out of
// bounds` (process abort = DoS). All in-tree callers happen to guard, so this is
// defense-in-depth, not forgery — but a malformed call must return false, never
// OOB.
//
// HERMETIC — the guard prologues below are VERBATIM-INLINED from the shipping
// ed25519_verify / p256_verify (no `use`, to dodge the stale-bundle resolution
// OP-87/88), so `hexa run` exercises the EXACT guard + the EXACT indexing that
// would OOB without it.
//
// What this locks:
//   1. ed25519: pubkey must be 32 bytes, signature 64 bytes (RFC 8032).
//      short sig OR short pubkey ⇒ guard returns false (no OOB);
//      correct lengths ⇒ guard passes and the 0..32 / 0..64 reads are in-bounds.
//   2. p256: every big-endian field (qx,qy,hash,r,s) is exactly 32 bytes.
//      any short field ⇒ guard returns false (no OOB);
//      correct lengths ⇒ guard passes and _be32_to_limbs' b[30]/b[31] is in-bounds.

// ── locked guard #1: ed25519_verify prologue + the indexing it protects ──
// VERBATIM from ed25519_verify: `if len(pubk)!=32 || len(sig)!=64 {return false}`
// then the first loops read sig[0..32] and pubk[0..32].
@pure
fn _ed25519_verify_guarded(pubk: [int], sig: [int]) -> bool {
    if len(pubk) != 32 || len(sig) != 64 { return false }
    // these reads (verbatim shape from ed25519_verify) would OOB without the guard
    let mut acc = 0
    let mut i = 0
    while i < 32 { acc = acc + sig[i]; i = i + 1 }
    i = 0
    while i < 32 { acc = acc + pubk[i]; i = i + 1 }
    i = 32
    while i < 64 { acc = acc + sig[i]; i = i + 1 }   // S = sig[32..64]
    return acc >= 0   // reached here ⇒ all reads in-bounds
}

// ── locked guard #2: p256_verify prologue + _be32_to_limbs indexing ──────
// VERBATIM from p256_verify: 5 fields each must be len 32; _be32_to_limbs reads
// b[30],b[31] (down to b[0],b[1]).
@pure
fn _be32_read(b: [int]) -> int {
    // verbatim _be32_to_limbs shape: highest limb reads b[30],b[31]
    let hi = b[30] & 0xFF
    let lo = b[31] & 0xFF
    return (hi << 8) | lo
}
@pure
fn _p256_verify_guarded(qx: [int], qy: [int], h: [int], r: [int], s: [int]) -> bool {
    if len(qx) != 32 || len(qy) != 32 || len(h) != 32 { return false }
    if len(r) != 32 || len(s) != 32 { return false }
    // these reads would OOB without the guard
    let _a = _be32_read(qx)
    let _b = _be32_read(qy)
    let _c = _be32_read(h)
    let _d = _be32_read(r)
    let _e = _be32_read(s)
    return true   // reached here ⇒ all _be32_to_limbs reads in-bounds
}

@pure
fn _zeros(n: int) -> [int] {
    let mut o: [int] = []
    let mut i = 0
    while i < n { o.push(0); i = i + 1 }
    return o
}

fn main() {
    let mut pass = 0
    let mut fail = 0

    // ─ ed25519 length guard ─
    let pubk32 = _zeros(32)
    let sig64 = _zeros(64)
    // correct lengths → guard passes, reads in-bounds (no OOB, returns true)
    if _ed25519_verify_guarded(pubk32, sig64) { pass = pass + 1 } else { fail = fail + 1; println("FAIL ed25519 valid-lengths pass") }
    // short sig (len 10) → guard rejects, NO OOB
    if !_ed25519_verify_guarded(pubk32, _zeros(10)) { pass = pass + 1 } else { fail = fail + 1; println("FAIL ed25519 short-sig reject") }
    // short pubkey (len 16) → guard rejects, NO OOB
    if !_ed25519_verify_guarded(_zeros(16), sig64) { pass = pass + 1 } else { fail = fail + 1; println("FAIL ed25519 short-pubkey reject") }
    // empty sig → guard rejects, NO OOB
    if !_ed25519_verify_guarded(pubk32, _zeros(0)) { pass = pass + 1 } else { fail = fail + 1; println("FAIL ed25519 empty-sig reject") }
    // sig too long (65) → guard rejects (strict equality)
    if !_ed25519_verify_guarded(pubk32, _zeros(65)) { pass = pass + 1 } else { fail = fail + 1; println("FAIL ed25519 long-sig reject") }

    // ─ p256 length guard ─
    let f32 = _zeros(32)
    // all correct → guard passes, reads in-bounds
    if _p256_verify_guarded(f32, f32, f32, f32, f32) { pass = pass + 1 } else { fail = fail + 1; println("FAIL p256 valid-lengths pass") }
    // short qx (len 4) → reject, NO OOB
    if !_p256_verify_guarded(_zeros(4), f32, f32, f32, f32) { pass = pass + 1 } else { fail = fail + 1; println("FAIL p256 short-qx reject") }
    // short qy → reject
    if !_p256_verify_guarded(f32, _zeros(4), f32, f32, f32) { pass = pass + 1 } else { fail = fail + 1; println("FAIL p256 short-qy reject") }
    // short hash → reject
    if !_p256_verify_guarded(f32, f32, _zeros(31), f32, f32) { pass = pass + 1 } else { fail = fail + 1; println("FAIL p256 short-hash reject") }
    // short r → reject
    if !_p256_verify_guarded(f32, f32, f32, _zeros(0), f32) { pass = pass + 1 } else { fail = fail + 1; println("FAIL p256 short-r reject") }
    // short s → reject
    if !_p256_verify_guarded(f32, f32, f32, f32, _zeros(2)) { pass = pass + 1 } else { fail = fail + 1; println("FAIL p256 short-s reject") }

    print("OP109-A verify-len-guard pass=")
    print(pass)
    print(" fail=")
    println(fail)
    if fail == 0 { println("OP109-A ALL GREEN") } else { println("OP109-A RED") }
}
