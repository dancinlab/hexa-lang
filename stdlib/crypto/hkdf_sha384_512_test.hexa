// HEXA Standard Library — HKDF-SHA384 / HKDF-SHA512 self-test (OP-83 leaf)
//
// Locks two UNTESTED high-value modules:
//   stdlib/crypto/hkdf_sha384.hexa
//   stdlib/crypto/hkdf_sha512.hexa
//
// HKDF (RFC 5869) publishes official test vectors only for SHA-256 / SHA-1,
// so the SHA-384/512 variants have NO RFC known-answer set. The reference
// here is a FAITHFUL PYTHON PORT of RFC 5869 §2 run over the §A.1 inputs
// with hashlib.sha384 / hashlib.sha512:
//
//   IKM  = 0x0b x22
//   salt = 0x00 0x01 .. 0x0c   (13 bytes)
//   info = 0xf0 0xf1 .. 0xf9   (10 bytes)
//   L    = 42
//
// Python reference (hmac/hashlib, byte-identical RFC 5869 algorithm):
//   sha384 PRK 704b39990779ce1dc548052c7dc39f303570dd13fb39f7acc564680bef80e8de
//              c70ee9a7e1f3e293ef68eceb072a5ade
//   sha384 OKM 9b5097a86038b805309076a44b3a9f38063e25b516dcbf369f394cfab43685f7
//              48b6457763e4f0204fc5
//   sha512 PRK 665799823737ded04a88e47e54a5890bb2c3d247c7a4254a8e61350723590a26
//              c36238127d8661b88cf80ef802d57e2f7cebcf1e00e083848be19929c61b4237
//   sha512 OKM 832390086cda71fb47625bb5ceb168e4c8e26a1a16ed34d9fc7fe92c1481579338
//              da362cb8d9f925d7cb
//
// Plus the documented HKDF construction invariants:
//   - extract(salt, ikm) length == hashlen (48 / 64)
//   - HKDF(ikm,salt,info,L) == Expand(Extract(salt,ikm), info, L)
//   - empty-salt path zero-fills to hashlen (RFC 5869 §2.2)
//
// LEAF pattern: SHA-384/512 core is `use`d from the verified sha512 module;
// the HMAC wrapper + HKDF extract/expand are inlined, so the test cannot
// drift the audited closure.

use "stdlib/crypto/sha512"

let mut pass = 0
let mut total = 0
let mut first_fail = ""

fn ck(name: string, got: string, want: string) {
    total = total + 1
    if got == want { pass = pass + 1 } else {
        if first_fail == "" { first_fail = name }
        println("FAIL " + name)
        println("  got  = " + got)
        println("  want = " + want)
    }
}

fn ckb(name: string, cond: bool) {
    total = total + 1
    if cond { pass = pass + 1 } else {
        if first_fail == "" { first_fail = name }
        println("FAIL " + name)
    }
}

fn to_hex(bytes: [int]) -> string {
    let hex = "0123456789abcdef"
    let mut r = ""
    let mut i = 0
    while i < len(bytes) {
        r = r + hex[bytes[i] / 16] + hex[bytes[i] % 16]
        i = i + 1
    }
    return r
}

// ── inlined HMAC-SHA384/512 (over the verified sha512 core) ─────────────

fn hmac384(key: [int], data: [int]) -> [int] {
    let block_size = 128
    let mut key_bytes: [int] = []
    let mut i = 0
    if len(key) > block_size {
        let h = sha384_bytes(key)
        while i < len(h) { key_bytes.push(h[i]); i = i + 1 }
    } else {
        while i < len(key) { key_bytes.push(key[i]); i = i + 1 }
    }
    while len(key_bytes) < block_size { key_bytes.push(0) }
    let mut ipad: [int] = []
    let mut opad: [int] = []
    i = 0
    while i < block_size {
        ipad.push(0x36 ^ key_bytes[i]); opad.push(0x5c ^ key_bytes[i]); i = i + 1
    }
    let mut inner_msg = ipad
    i = 0
    while i < len(data) { inner_msg.push(data[i]); i = i + 1 }
    let inner_digest = sha384_bytes(inner_msg)
    let mut outer_msg = opad
    i = 0
    while i < len(inner_digest) { outer_msg.push(inner_digest[i]); i = i + 1 }
    return sha384_bytes(outer_msg)
}

fn hmac512(key: [int], data: [int]) -> [int] {
    let block_size = 128
    let mut key_bytes: [int] = []
    let mut i = 0
    if len(key) > block_size {
        let h = sha512_bytes(key)
        while i < len(h) { key_bytes.push(h[i]); i = i + 1 }
    } else {
        while i < len(key) { key_bytes.push(key[i]); i = i + 1 }
    }
    while len(key_bytes) < block_size { key_bytes.push(0) }
    let mut ipad: [int] = []
    let mut opad: [int] = []
    i = 0
    while i < block_size {
        ipad.push(0x36 ^ key_bytes[i]); opad.push(0x5c ^ key_bytes[i]); i = i + 1
    }
    let mut inner_msg = ipad
    i = 0
    while i < len(data) { inner_msg.push(data[i]); i = i + 1 }
    let inner_digest = sha512_bytes(inner_msg)
    let mut outer_msg = opad
    i = 0
    while i < len(inner_digest) { outer_msg.push(inner_digest[i]); i = i + 1 }
    return sha512_bytes(outer_msg)
}

// ── inlined HKDF extract / expand (verbatim, hashlen-parameterized) ─────

fn hkdf_extract(salt: [int], ikm: [int], hashlen: int, is384: bool) -> [int] {
    let mut s = salt
    if len(s) == 0 {
        let mut zero: [int] = []
        let mut i = 0
        while i < hashlen { zero.push(0); i = i + 1 }
        s = zero
    }
    if is384 { return hmac384(s, ikm) }
    return hmac512(s, ikm)
}

fn hkdf_expand(prk: [int], info: [int], length: int, is384: bool) -> [int] {
    let mut okm: [int] = []
    let mut t: [int] = []
    let mut i = 1
    while len(okm) < length {
        let mut block: [int] = []
        let mut j = 0
        while j < len(t) { block.push(t[j]); j = j + 1 }
        j = 0
        while j < len(info) { block.push(info[j]); j = j + 1 }
        block.push(i & 0xFF)
        if is384 { t = hmac384(prk, block) } else { t = hmac512(prk, block) }
        j = 0
        while j < len(t) { okm.push(t[j]); j = j + 1 }
        i = i + 1
    }
    let mut out: [int] = []
    i = 0
    while i < length { out.push(okm[i]); i = i + 1 }
    return out
}

fn hkdf(ikm: [int], salt: [int], info: [int], length: int, hashlen: int, is384: bool) -> [int] {
    return hkdf_expand(hkdf_extract(salt, ikm, hashlen, is384), info, length, is384)
}

fn rng(lo: int, hi: int) -> [int] {
    let mut r: [int] = []
    let mut v = lo
    while v <= hi { r.push(v); v = v + 1 }
    return r
}

fn rep(b: int, n: int) -> [int] {
    let mut r: [int] = []
    let mut i = 0
    while i < n { r.push(b); i = i + 1 }
    return r
}

fn main() {
    // RFC 5869 §A.1 inputs
    let ikm  = rep(0x0b, 22)
    let salt = rng(0x00, 0x0c)
    let info = rng(0xf0, 0xf9)

    // ── PRK length invariant ───────────────────────────────────────────
    ckb("hkdf384 PRK len == 48", len(hkdf_extract(salt, ikm, 48, true)) == 48)
    ckb("hkdf512 PRK len == 64", len(hkdf_extract(salt, ikm, 64, false)) == 64)

    // ── extract (PRK) vs Python RFC 5869 reference ─────────────────────
    ck("hkdf384 PRK", to_hex(hkdf_extract(salt, ikm, 48, true)),
        "704b39990779ce1dc548052c7dc39f303570dd13fb39f7acc564680bef80e8dec70ee9a7e1f3e293ef68eceb072a5ade")
    ck("hkdf512 PRK", to_hex(hkdf_extract(salt, ikm, 64, false)),
        "665799823737ded04a88e47e54a5890bb2c3d247c7a4254a8e61350723590a26c36238127d8661b88cf80ef802d57e2f7cebcf1e00e083848be19929c61b4237")

    // ── full HKDF OKM (L=42) vs Python RFC 5869 reference ──────────────
    ck("hkdf384 OKM L=42", to_hex(hkdf(ikm, salt, info, 42, 48, true)),
        "9b5097a86038b805309076a44b3a9f38063e25b516dcbf369f394cfab43685f748b6457763e4f0204fc5")
    ck("hkdf512 OKM L=42", to_hex(hkdf(ikm, salt, info, 42, 64, false)),
        "832390086cda71fb47625bb5ceb168e4c8e26a1a16ed34d9fc7fe92c1481579338da362cb8d9f925d7cb")

    // ── construction invariant: HKDF == Expand(Extract()) ──────────────
    let prk384 = hkdf_extract(salt, ikm, 48, true)
    ckb("hkdf384 == Expand(Extract)",
        to_hex(hkdf(ikm, salt, info, 42, 48, true)) == to_hex(hkdf_expand(prk384, info, 42, true)))

    // ── empty-salt path zero-fills to hashlen (RFC 5869 §2.2) ──────────
    let z48 = rep(0, 48)
    ckb("hkdf384 empty-salt == zero-salt",
        to_hex(hkdf_extract([], ikm, 48, true)) == to_hex(hmac384(z48, ikm)))

    println("hkdf_sha384/512 self-test: " + to_string(pass) + "/" + to_string(total))
    if pass == total { println("PASS") } else {
        println("first fail: " + first_fail)
        exit(1)
    }
}
