// HEXA Standard Library — crypto/poly1305 self-test
// @ci_gate
//
// Authoritative KAT: RFC 8439 §2.5.2 (Poly1305 one-time MAC).
//   key = 85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b
//   msg = "Cryptographic Forum Research Group"
//   tag = a8061dc1305136c6c22b8baf0c0127a9
// Cross-checked 0-mismatch vs a faithful Python (1<<130)-5 reference port.
use "stdlib/crypto/poly1305"
let mut pass = 0
let mut total = 0
fn hx(b: [int]) -> string {
    let H = "0123456789abcdef"
    let mut p: [string] = []
    let mut i = 0
    while i < len(b) { p.push(H.substring((b[i]>>4)&15,((b[i]>>4)&15)+1)); p.push(H.substring(b[i]&15,(b[i]&15)+1)); i=i+1 }
    return p.join("")
}
fn ck(name: string, got: string, want: string) {
    total = total + 1
    if got == want { pass = pass + 1 } else { println("FAIL " + name + " got=" + got + " want=" + want) }
}
fn main() {
    // RFC 8439 §2.5.2 one-time-key + the ASCII message bytes.
    let key = [133,214,190,120,87,85,109,51,127,68,82,254,66,213,6,168,
               1,3,128,138,251,13,178,253,74,191,246,175,65,73,245,27]
    let msg = [67,114,121,112,116,111,103,114,97,112,104,105,99,32,70,111,
               114,117,109,32,82,101,115,101,97,114,99,104,32,71,114,111,117,112]
    let tag = poly1305_mac(msg, key)
    ck("rfc8439_2.5.2_tag", hx(tag), "a8061dc1305136c6c22b8baf0c0127a9")

    // Determinism invariant: MAC is a pure function of (msg, key).
    let tag2 = poly1305_mac(msg, key)
    ck("determinism", hx(tag2), hx(tag))

    // Empty-message edge (RFC: tag = s for empty msg; s = key[16..32]).
    // Here msg=[] so acc stays 0 and tag = (0 + s) mod 2^128 = s little-endian.
    let empty: [int] = []
    let etag = poly1305_mac(empty, key)
    ck("empty_msg_equals_s", hx(etag), "0103808afb0db2fd4abff6af4149f51b")

    println("poly1305 self-test: " + to_string(pass) + "/" + to_string(total))
    if pass == total { println("PASS") } else { println("FAILED") }
}
