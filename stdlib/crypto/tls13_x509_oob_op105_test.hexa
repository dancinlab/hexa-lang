// HEXA Standard Library — length-prefixed-binary OOB-read class lock (OP-105)
// @ci_gate
//
// Closes the length-prefixed/framed-binary OOB-read class surfaced by OP-104.
// A family of TLS 1.3 handshake/extension parsers and the ASN.1 DER / X.509
// decoders read a LENGTH field from untrusted wire bytes and then copy that
// many bytes WITHOUT checking the declared length fits the buffer. A truncated
// or malicious wire length overruns the buffer (which faults the VM with
// "index N out of bounds"). Each fix mirrors OP-104's inner-bound guard
// (`while i < declared && base + i < len(buf)`): a truncated input yields a
// graceful SHORT/empty value, never an out-of-bounds read.
//
// HERMETIC: every parse body is VERBATIM-INLINED (no `use`) so the lock holds
// on the shipping `hexa run` regardless of any stale bundled copy (OP-87/88).
// The inlined bodies are byte-for-byte the FIXED stdlib sources.

// ── tls13_ch_session_id (truncated session_id length) ──────────────────
fn _ch_session_id(body: [int], o: int) -> [int] {
    let sl = body[o + 34] & 0xFF
    let mut s: [int] = []
    let mut i = 0
    while i < sl && o + 35 + i < len(body) { s.push(body[o + 35 + i]); i = i + 1 }
    return s
}

// ── tls13_cr_context (truncated CertificateRequest context length) ─────
fn _cr_context(body: [int]) -> [int] {
    let n = body[0] & 0xFF
    let mut c: [int] = []
    let mut i = 0
    while i < n && 1 + i < len(body) { c.push(body[1 + i]); i = i + 1 }
    return c
}

// ── tls13_nst_nonce (truncated NewSessionTicket nonce length) ──────────
fn _nst_nonce(body: [int]) -> [int] {
    let nl = body[8] & 0xFF
    let mut n: [int] = []
    let mut i = 0
    while i < nl && 9 + i < len(body) { n.push(body[9 + i]); i = i + 1 }
    return n
}

// ── der_value_len long-form (truncated DER length bytes) ───────────────
fn _der_value_len(b: [int], o: int) -> int {
    let n = b[o + 1] & 0xFF
    if n < 0x80 { return n }
    let nbytes = n & 0x7F
    let mut v = 0
    let mut i = 0
    while i < nbytes && o + 2 + i < len(b) {
        v = (v << 8) | (b[o + 2 + i] & 0xFF)
        i = i + 1
    }
    return v
}

// ── der_oid_str inner continuation (truncated OID, dangling high bit) ──
fn _der_oid_str(b: [int], voff: int, vlen: int) -> string {
    if vlen == 0 { return "" }
    if voff >= len(b) { return "" }
    let first = b[voff] & 0xFF
    let v1 = first / 40
    let v2 = first - 40 * v1
    let mut parts: [string] = []
    parts.push(str(v1))
    parts.push(str(v2))
    let mut i = 1
    while i < vlen && voff + i < len(b) {
        let mut acc = 0
        let mut more = 1
        while more == 1 && voff + i < len(b) {
            let by = b[voff + i] & 0xFF
            acc = (acc << 7) | (by & 0x7F)
            i = i + 1
            if (by & 0x80) == 0 { more = 0 }
        }
        parts.push(str(acc))
    }
    return parts.join(".")
}

fn _eq(a: [int], b: [int]) -> bool {
    if len(a) != len(b) { return false }
    let mut i = 0
    while i < len(a) { if a[i] != b[i] { return false }; i = i + 1 }
    return true
}

fn main() {
    let mut total = 0
    let mut pass = 0

    // (1) tls13_ch_session_id — TRUNCATED: body[34]=32 declared, but buffer ends
    //     at index 34 (len 35). Pre-fix reads body[35] → OOB fault. Fix: [] gracefully.
    let mut trunc_ch: [int] = []
    let mut k = 0
    while k < 34 { trunc_ch.push(0); k = k + 1 }
    trunc_ch.push(32)
    total = total + 1
    if _eq(_ch_session_id(trunc_ch, 0), []) { pass = pass + 1 }
    // Well-formed: 5 session_id bytes present → exact read.
    let mut good_ch: [int] = []
    k = 0
    while k < 34 { good_ch.push(0); k = k + 1 }
    good_ch.push(5)
    k = 0
    while k < 5 { good_ch.push(100 + k); k = k + 1 }
    total = total + 1
    if _eq(_ch_session_id(good_ch, 0), [100, 101, 102, 103, 104]) { pass = pass + 1 }

    // (2) tls13_cr_context — TRUNCATED: body[0]=4 declared, only 2 ctx bytes present.
    total = total + 1
    if _eq(_cr_context([4, 0xAA, 0xBB]), [0xAA, 0xBB]) { pass = pass + 1 }
    // Well-formed: declared 2, 2 present.
    total = total + 1
    if _eq(_cr_context([2, 0x11, 0x22]), [0x11, 0x22]) { pass = pass + 1 }

    // (3) tls13_nst_nonce — TRUNCATED: body[8]=8 declared, only 3 nonce bytes present.
    total = total + 1
    if _eq(_nst_nonce([0, 0, 0, 0, 0, 0, 0, 0, 8, 1, 2, 3]), [1, 2, 3]) { pass = pass + 1 }

    // (4) der_value_len long-form — TRUNCATED: 0x82 declares 2 length bytes, only
    //     1 present (buffer ends). Pre-fix reads b[3] of a length-3 buffer → OOB.
    //     Fix: stops at the buffer edge, returns the partial value (0x01).
    total = total + 1
    if _der_value_len([0x30, 0x82, 0x01], 0) == 0x01 { pass = pass + 1 }
    // Well-formed: 0x82 0x01 0x00 → 256.
    total = total + 1
    if _der_value_len([0x30, 0x82, 0x01, 0x00], 0) == 256 { pass = pass + 1 }
    // Short form unaffected.
    total = total + 1
    if _der_value_len([0x04, 0x05], 0) == 5 { pass = pass + 1 }

    // (5) der_oid_str — TRUNCATED OID whose final byte still sets the high
    //     (continuation) bit: [0x2a, 0x86] with vlen=3 (claims a 3rd byte absent).
    //     Pre-fix the inner continuation loop reads b[2] of a length-2 buffer → OOB.
    //     Fix: terminates at the buffer edge. Well-formed control below.
    total = total + 1
    let oid_trunc = _der_oid_str([0x2a, 0x86], 0, 3)
    // graceful: no fault; first arc "1.2" always present.
    if len(oid_trunc) >= 3 { pass = pass + 1 }
    // Well-formed: 2a 86 48 86 f7 0d → "1.2.840.113549" (RSA prefix).
    total = total + 1
    if _der_oid_str([0x2a, 0x86, 0x48, 0x86, 0xf7, 0x0d], 0, 6) == "1.2.840.113549" { pass = pass + 1 }

    // (6) Negative control: empty / undersized inputs → graceful empties, no fault.
    total = total + 1
    if _eq(_nst_nonce([0, 0, 0, 0, 0, 0, 0, 0, 0]), []) { pass = pass + 1 }
    total = total + 1
    if _der_oid_str([], 0, 0) == "" { pass = pass + 1 }

    if pass == total {
        println("[tls13_x509_oob_op105_test] " + str(total) + "/" + str(total) + " asserts passed")
        println("__HEXA_TLS13_X509_OOB_OP105__ PASS " + str(total) + "/" + str(total))
    } else {
        println("__HEXA_TLS13_X509_OOB_OP105__ FAIL " + str(pass) + "/" + str(total))
    }
}
