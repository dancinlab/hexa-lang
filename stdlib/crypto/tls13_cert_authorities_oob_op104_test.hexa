// HEXA Standard Library — crypto/tls13_cert_authorities OOB-truncation lock (OP-104)
// @ci_gate
//
// Locks the OP-104 fix: tls13_cert_authorities_at MUST bounds-guard its inner
// DistinguishedName name-byte read against a truncated/malformed extension
// where the declared length `nl` overruns the buffer — a truncated DN yields a
// graceful SHORT name, never an out-of-bounds read (which would fault the VM).
// Mirrors the SAFE inner-guard pattern already used by tls13_alpn_parse.
//
// HERMETIC: the parse body is VERBATIM-INLINED (no `use`) so the lock holds on
// the shipping `hexa run` regardless of any stale bundled copy (OP-87/88 lesson).
// The inlined bodies are byte-for-byte the FIXED stdlib/crypto/tls13_cert_authorities.hexa.

// --- verbatim inline of the (fixed) cert_authorities parse surface ---

fn _ca_count(ext_value: [int]) -> int {
    if len(ext_value) < 2 { return 0 }
    let list_len = ((ext_value[0] & 0xFF) << 8) | (ext_value[1] & 0xFF)
    let mut count = 0
    let mut i = 2
    let end = 2 + list_len
    while i + 1 < end && i + 1 < len(ext_value) {
        let nl = ((ext_value[i] & 0xFF) << 8) | (ext_value[i + 1] & 0xFF)
        i = i + 2 + nl
        count = count + 1
    }
    return count
}

fn _ca_at(ext_value: [int], idx: int) -> [int] {
    if len(ext_value) < 2 { return [] }
    let list_len = ((ext_value[0] & 0xFF) << 8) | (ext_value[1] & 0xFF)
    let mut i = 2
    let end = 2 + list_len
    let mut k = 0
    while i + 1 < end && i + 1 < len(ext_value) {
        let nl = ((ext_value[i] & 0xFF) << 8) | (ext_value[i + 1] & 0xFF)
        if k == idx {
            let mut name: [int] = []
            let mut j = 0
            // OP-104 FIX: inner bounds guard against a truncated `nl`.
            while j < nl && i + 2 + j < len(ext_value) { name.push(ext_value[i + 2 + j]); j = j + 1 }
            return name
        }
        i = i + 2 + nl
        k = k + 1
    }
    return []
}

fn _eq(a: [int], b: [int]) -> bool {
    if len(a) != len(b) { return false }
    let mut i = 0
    while i < len(a) { if a[i] != b[i] { return false }; i = i + 1 }
    return true
}

fn main() {
    let mut total = 0
    let mut pass = 0

    // (1) TRUNCATED extension: inner list_len=7 (claims a 2-byte hdr + 5-byte DN),
    //     entry nl=5, but only 2 name bytes [0xAA,0xBB] actually present.
    //     The FIX returns the 2 available bytes (graceful) — pre-fix this read
    //     ext_value[6] out of a length-6 buffer (OOB fault).
    let trunc = [0, 7, 0, 5, 0xAA, 0xBB]
    total = total + 1
    if _eq(_ca_at(trunc, 0), [0xAA, 0xBB]) { pass = pass + 1 }

    // (2) Well-formed round-trip still exact: 2 DNs [1,2,3] and [0xAA].
    //     inner = list_len(=7) || (nl=3 || 1,2,3) || (nl=1 || 0xAA)
    let good = [0, 7, 0, 3, 1, 2, 3, 0, 1, 0xAA]
    total = total + 1
    if _ca_count(good) == 2 { pass = pass + 1 }
    total = total + 1
    if _eq(_ca_at(good, 0), [1, 2, 3]) { pass = pass + 1 }
    total = total + 1
    if _eq(_ca_at(good, 1), [0xAA]) { pass = pass + 1 }

    // (3) Empty / undersized inputs: graceful empties, no fault.
    total = total + 1
    if _eq(_ca_at([], 0), []) { pass = pass + 1 }
    total = total + 1
    if _eq(_ca_at([0], 0), []) { pass = pass + 1 }

    // (4) Out-of-range idx → empty.
    total = total + 1
    if _eq(_ca_at(good, 9), []) { pass = pass + 1 }

    if pass == total {
        println("[tls13_cert_authorities_oob_op104_test] " + str(total) + "/" + str(total) + " asserts passed")
        println("__HEXA_TLS13_CA_OOB_OP104__ PASS " + str(total) + "/" + str(total))
    } else {
        println("__HEXA_TLS13_CA_OOB_OP104__ FAIL " + str(pass) + "/" + str(total))
    }
}
