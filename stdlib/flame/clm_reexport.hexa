// ════════════════════════════════════════════════════════════════════════════
//  clm_reexport_v2.hexa — LOCAL ($0-CPU) re-export of a TRAINED CLMConvMoE to the
//  .clm v0.2 format (conv int4 blocks + the v0.2 EXT trailer: trained embed
//  table + conv biases + GroupNorm affine).
//
//  WHY this file exists (a_fire_recover_complete + a_completeness_over_cheap):
//  the production trainer stdlib/flame/clm_prod.hexa serialized ONLY the 6 conv
//  blocks (v0.1) — the trained embed table + GN affine were never persisted, so
//  the d768 GPU fire's measured CE descent (4.88) is NOT reconstructible from
//  the saved artifact (the named ENGINE root cause). clm_prod.hexa now ALSO
//  writes the v0.2 trailer, but it links the CUDA-only forge_dispatch_adamw
//  builtin and so cannot run on the prebuilt mac binary. This driver is the
//  HONEST local re-export: a REAL int4-QAT training run that produces a genuine
//  TRAINED v0.2 .clm using ONLY host flame ops (nn_conv1d_fwd/bwd · nn_groupnorm
//  · nn_moe_router · nn_gelu · nn_embedding · opt_adamw_step), NO forge dispatch,
//  NO PyTorch/ATen. It is byte-graph-faithful to clm_prod_fwd/clm_prod_bwd (same
//  weight-only int4 fake-quant + STE), differing only in the matmul SUBSTRATE
//  (host t_matmul vs forge cuBLAS — F-CLM-CONV-GPU-EQ documents these byte-eq).
//
//  Output: env CLM_REEXPORT_OUT (.clm path). The trained embed+GN ARE persisted,
//  so a CORE-mounted decode (anima generator.hexa::clm_decode_ce) can finally
//  reproduce the descent through the engine. NO fabricated CE: the descent is
//  whatever this real training run achieves on the real corpus.
// ════════════════════════════════════════════════════════════════════════════

use "stdlib/flame/tensor_lib"
use "stdlib/flame/conv_lib"
use "stdlib/flame/gn_lib"
use "stdlib/flame/moe_lib"
use "stdlib/flame/nn_lib"
use "stdlib/flame/quant_lib"
use "stdlib/flame/optim_lib"

// fake-quant a weight into wq + write the STE mask (weight-only int4 QAT).
fn _rq(w: int, wq: int, mask: int, Cout: int, rest: int) {
    let sc = t_zeros(Cout); let ql = t_zeros(Cout * rest)
    nn_int4_quant_fwd(w, wq, sc, ql, mask, Cout, rest)
}

// Forward with weight-only int4 QAT — host ops, byte-graph-faithful to
// clm_prod_fwd. Fills the activation caches the backward needs.
fn _re_fwd(tok: int,
           embed: int, ecW: int, ecB: int, tcW: int, tcB: int, tgG: int, tgB: int,
           rW: int, rB: int, e0W: int, e0B: int, e1W: int, e1B: int,
           noG: int, noB: int, roW: int, roB: int,
           ecWq: int, ecM: int, tcWq: int, tcM: int, e0Wq: int, e0M: int,
           e1Wq: int, e1M: int, rWq: int, rM: int, roWq: int, roM: int,
           xe: int, xec: int, xt: int, hn0: int, xhat0: int, inv0: int,
           eo0: int, eo1: int, probs: int, ex_out: int, yn: int, xhatN: int, invN: int,
           out_logits: int, T: int, d: int, E: int, V: int, K: int) {
    _rq(ecW, ecWq, ecM, d, d * K)
    _rq(tcW, tcWq, tcM, d, d * K)
    _rq(e0W, e0Wq, e0M, d, d * K)
    _rq(e1W, e1Wq, e1M, d, d * K)
    _rq(rW, rWq, rM, E, d)
    _rq(roW, roWq, roM, V, d)

    nn_embedding_fwd(tok, embed, xe, T, d)
    nn_conv1d_fwd(xe, ecWq, ecB, xec, T, d, d, K, 1)
    let h0 = t_zeros(T * d)
    nn_conv1d_fwd(xec, tcWq, tcB, h0, T, d, d, K, 1)
    let mean0 = t_zeros(1)
    nn_groupnorm_fwd(h0, tgG, tgB, hn0, mean0, inv0, xhat0, T, d, 1)
    let hg0 = t_zeros(T * d); nn_gelu_fwd(hn0, hg0, T * d)
    let mut i = 0
    while i < T * d { t_set(xt, i, t_get(xec, i) + t_get(hg0, i)); i = i + 1 }
    let logits_r = t_zeros(T * E)
    nn_conv1d_fwd(xt, rWq, rB, logits_r, T, d, E, 1, 1)
    nn_conv1d_fwd(xt, e0Wq, e0B, eo0, T, d, d, K, 1)
    nn_conv1d_fwd(xt, e1Wq, e1B, eo1, T, d, d, K, 1)
    let ex0 = t_zeros(T * d); nn_gelu_fwd(eo0, ex0, T * d)
    let ex1 = t_zeros(T * d); nn_gelu_fwd(eo1, ex1, T * d)
    let mut j = 0
    while j < T * d {
        t_set(ex_out, 0 * T * d + j, t_get(ex0, j))
        t_set(ex_out, 1 * T * d + j, t_get(ex1, j))
        j = j + 1
    }
    let y = t_zeros(T * d)
    nn_moe_router_fwd(logits_r, ex_out, probs, y, T, E, d)
    let meanN = t_zeros(1)
    nn_groupnorm_fwd(y, noG, noB, yn, meanN, invN, xhatN, T, d, 1)
    nn_conv1d_fwd(yn, roWq, roB, out_logits, T, d, V, 1, 1)
    // stash router logits for the backward (probs cached by nn_moe_router_fwd).
}

fn _re_ce_grad(logits: int, tgt: int, dlogits: int, T: int, V: int) {
    let mut t = 0
    while t < T {
        let base = t * V
        let mut mx = t_get(logits, base)
        let mut i = 1
        while i < V { let v = t_get(logits, base + i); if v > mx { mx = v }; i = i + 1 }
        let mut sm = 0.0
        let mut i2 = 0
        while i2 < V { sm = sm + exp(t_get(logits, base + i2) - mx); i2 = i2 + 1 }
        let invT = 1.0 / to_float(T)
        let mut v3 = 0
        while v3 < V {
            let p = exp(t_get(logits, base + v3) - mx) / sm
            t_set(dlogits, base + v3, p * invT)
            v3 = v3 + 1
        }
        let g = to_int(t_get(tgt, t))
        t_set(dlogits, base + g, t_get(dlogits, base + g) - invT)
        t = t + 1
    }
}

// Backward (host ops, STE). Mirrors clm_prod_bwd. Re-runs the router forward to
// re-cache probs/logits_r for the moe backward (host, cheap at this scale).
fn _re_bwd(dlogits: int, tok: int,
           embed: int, ecWq: int, tcWq: int, tgG: int, rWq: int, e0Wq: int, e1Wq: int, noG: int, roWq: int,
           ecM: int, tcM: int, e0M: int, e1M: int, rM: int, roM: int,
           xe: int, xec: int, xt: int, hn0: int, xhat0: int, inv0: int,
           eo0: int, eo1: int, probs: int, ex_out: int, yn: int, xhatN: int, invN: int,
           dembed: int, decW: int, decB: int, dtcW: int, dtcB: int, dtgG: int, dtgB: int,
           drW: int, drB: int, de0W: int, de0B: int, de1W: int, de1B: int,
           dnoG: int, dnoB: int, droW: int, droB: int,
           T: int, d: int, E: int, V: int, K: int) {
    let dynorm = t_zeros(T * d); let droWq = t_zeros(V * d)
    nn_conv1d_bwd(yn, roWq, dlogits, droWq, dynorm, droB, T, d, V, 1, 1)
    nn_int4_quant_bwd(droWq, roM, droW, V, d)
    let dy = t_zeros(T * d)
    nn_groupnorm_bwd(xhatN, invN, noG, dynorm, dnoG, dnoB, dy, T, d, 1)
    let dlogits_r = t_zeros(T * E); let dex_out = t_zeros(E * T * d)
    nn_moe_router_bwd(probs, ex_out, dy, dlogits_r, dex_out, T, E, d)
    let dxt_r = t_zeros(T * d); let drWq = t_zeros(E * d)
    nn_conv1d_bwd(xt, rWq, dlogits_r, drWq, dxt_r, drB, T, d, E, 1, 1)
    nn_int4_quant_bwd(drWq, rM, drW, E, d)
    let dex0 = t_zeros(T * d); let dex1 = t_zeros(T * d)
    let mut ei = 0
    while ei < T * d {
        t_set(dex0, ei, t_get(dex_out, 0 * T * d + ei))
        t_set(dex1, ei, t_get(dex_out, 1 * T * d + ei))
        ei = ei + 1
    }
    let deo0 = t_zeros(T * d); nn_gelu_bwd(eo0, dex0, deo0, T * d)
    let deo1 = t_zeros(T * d); nn_gelu_bwd(eo1, dex1, deo1, T * d)
    let dxt_e0 = t_zeros(T * d); let de0Wq = t_zeros(d * d * K)
    nn_conv1d_bwd(xt, e0Wq, deo0, de0Wq, dxt_e0, de0B, T, d, d, K, 1)
    let dxt_e1 = t_zeros(T * d); let de1Wq = t_zeros(d * d * K)
    nn_conv1d_bwd(xt, e1Wq, deo1, de1Wq, dxt_e1, de1B, T, d, d, K, 1)
    nn_int4_quant_bwd(de0Wq, e0M, de0W, d, d * K)
    nn_int4_quant_bwd(de1Wq, e1M, de1W, d, d * K)
    let dxt = t_zeros(T * d)
    let mut xi = 0
    while xi < T * d {
        t_set(dxt, xi, t_get(dxt_r, xi) + t_get(dxt_e0, xi) + t_get(dxt_e1, xi))
        xi = xi + 1
    }
    let dhn0 = t_zeros(T * d); nn_gelu_bwd(hn0, dxt, dhn0, T * d)
    let dh0 = t_zeros(T * d)
    nn_groupnorm_bwd(xhat0, inv0, tgG, dhn0, dtgG, dtgB, dh0, T, d, 1)
    let dxec_b = t_zeros(T * d); let dtcWq = t_zeros(d * d * K)
    nn_conv1d_bwd(xec, tcWq, dh0, dtcWq, dxec_b, dtcB, T, d, d, K, 1)
    nn_int4_quant_bwd(dtcWq, tcM, dtcW, d, d * K)
    let dxec = t_zeros(T * d)
    let mut ci = 0
    while ci < T * d { t_set(dxec, ci, t_get(dxt, ci) + t_get(dxec_b, ci)); ci = ci + 1 }
    let dxe = t_zeros(T * d); let decWq = t_zeros(d * d * K)
    nn_conv1d_bwd(xe, ecWq, dxec, decWq, dxe, decB, T, d, d, K, 1)
    nn_int4_quant_bwd(decWq, ecM, decW, d, d * K)
    let mut zi = 0
    while zi < V * d { t_set(dembed, zi, 0.0); zi = zi + 1 }
    nn_embedding_bwd_scatter(dxe, tok, dembed, T, d)
}

fn _adam(W: int, gW: int, m: int, v: int, n: int, t: int) {
    opt_adamw_step(W, gW, m, v, n, 0.05, 0.9, 0.999, 0.00000001, 0.0, t)
}

// local v0.2 serialization writers (self-contained — same byte layout as
// clm_ckpt.hexa save_block/clm_ext_*, kept local so this driver does not depend
// on the importer resolving every pub fn of a main()-bearing module).
fn _re_push_u32(buf, n: int) {
    buf.push(n & 0xFF); buf.push((n / 0x100) & 0xFF)
    buf.push((n / 0x10000) & 0xFF); buf.push((n / 0x1000000) & 0xFF)
}
fn _re_push_f32(buf, f: float) {
    let b = f32_to_bytes_le(f); let mut i = 0
    while i < 4 { buf.push(b[i]); i = i + 1 }
}
fn _re_ext_begin(buf, n_ext: int) {
    buf.push(67); buf.push(76); buf.push(77); buf.push(88)   // "CLMX"
    buf.push(n_ext)
}
fn _re_ext_save_entry(buf, t: int, n: int) {
    _re_push_u32(buf, n)
    let mut i = 0
    while i < n { _re_push_f32(buf, t_get(t, i)); i = i + 1 }
}
fn _re_save_block(buf, ql: int, scale: int, cout: int, rest: int) {
    _re_push_u32(buf, cout); _re_push_u32(buf, rest)
    let n = cout * rest
    let mut i = 0
    while i < n {
        let lo = (to_int(t_get(ql, i)) + 8) & 0xF
        let mut hi = 8
        if i + 1 < n { hi = (to_int(t_get(ql, i + 1)) + 8) & 0xF }
        buf.push(lo + hi * 16)
        i = i + 2
    }
    let mut c = 0
    while c < cout { _re_push_f32(buf, t_get(scale, c)); c = c + 1 }
}

fn _windows(bytes_arr: int, n_bytes: int, IDS: int, TGT: int,
            nsamp: int, T: int, stride: int) -> int {
    let mut filled = 0; let mut s = 0
    while s < nsamp {
        let off = s * stride
        if off + T + 1 <= n_bytes {
            let mut p = 0
            while p < T {
                t_set(IDS, s * T + p, to_float(bytes_arr[off + p]))
                t_set(TGT, s * T + p, to_float(bytes_arr[off + p + 1]))
                p = p + 1
            }
            filled = filled + 1
        }
        s = s + 1
    }
    return filled
}

fn main() {
    println("clm_reexport — TRAINED CLMConvMoE → .clm v0.2 (host, $0-CPU)")
    let _envd = env("CLM_PROD_D"); let _enve = env("CLM_PROD_E")
    let _envn = env("CLM_PROD_NSAMP"); let _envt = env("CLM_PROD_T")
    let _enve2 = env("CLM_PROD_EPOCHS")
    let d = if _envd == "" { 8 } else { to_int(_envd) }
    let E = if _enve == "" { 2 } else { to_int(_enve) }
    let nsamp = if _envn == "" { 8 } else { to_int(_envn) }
    let T = if _envt == "" { 24 } else { to_int(_envt) }
    let epochs = if _enve2 == "" { 12 } else { to_int(_enve2) }
    let V = 256; let K = 3
    let dd = d * d * K; let ed = E * d; let vd = V * d

    let envp = env("CLM_PROD_CORPUS")
    let path = if envp == "" { "stdlib/flame/testdata/clm_semantic_parallel.txt" } else { envp }
    let bytes_arr = read_file_bytes(path)
    let n_bytes = len(bytes_arr)
    let mut stride = (n_bytes - T - 1) / nsamp
    if stride < 1 { stride = 1 }
    print("  corpus: "); print(path); print("  ("); print(n_bytes); println(" bytes, V=256)")
    let IDS = t_zeros(nsamp * T); let TGT = t_zeros(nsamp * T)
    let nwin = _windows(bytes_arr, n_bytes, IDS, TGT, nsamp, T, stride)
    print("  windows: "); print(nwin); print("/"); print(nsamp)
    print("  (T="); print(T); print(" stride="); print(stride); println(")")
    if nwin < 2 { println("F-CLM-REEXPORT-DESCENT = 0"); println("FAIL — corpus too short"); return }

    // weights (LCG init — same seeds/scheme as clm_prod.hexa)
    let embed=t_zeros(vd); t_fill_lcg(embed, vd, 1, 0.3)
    let ecW=t_zeros(dd); t_fill_lcg(ecW, dd, 2, 0.2); let ecB=t_zeros(d); t_fill_lcg(ecB, d, 3, 0.1)
    let tcW=t_zeros(dd); t_fill_lcg(tcW, dd, 4, 0.2); let tcB=t_zeros(d); t_fill_lcg(tcB, d, 5, 0.1)
    let tgG=t_zeros(d); t_fill_lcg(tgG, d, 6, 0.5); let tgB=t_zeros(d); t_fill_lcg(tgB, d, 7, 0.1)
    let rW=t_zeros(ed); t_fill_lcg(rW, ed, 12, 0.2); let rB=t_zeros(E); t_fill_lcg(rB, E, 13, 0.1)
    let e0W=t_zeros(dd); t_fill_lcg(e0W, dd, 14, 0.2); let e0B=t_zeros(d); t_fill_lcg(e0B, d, 15, 0.1)
    let e1W=t_zeros(dd); t_fill_lcg(e1W, dd, 16, 0.2); let e1B=t_zeros(d); t_fill_lcg(e1B, d, 17, 0.1)
    let noG=t_zeros(d); t_fill_lcg(noG, d, 18, 0.5); let noB=t_zeros(d); t_fill_lcg(noB, d, 19, 0.1)
    let roW=t_zeros(vd); t_fill_lcg(roW, vd, 20, 0.2); let roB=t_zeros(V); t_fill_lcg(roB, V, 21, 0.1)

    // grads
    let dembed=t_zeros(vd); let decW=t_zeros(dd); let decB=t_zeros(d)
    let dtcW=t_zeros(dd); let dtcB=t_zeros(d); let dtgG=t_zeros(d); let dtgB=t_zeros(d)
    let drW=t_zeros(ed); let drB=t_zeros(E)
    let de0W=t_zeros(dd); let de0B=t_zeros(d); let de1W=t_zeros(dd); let de1B=t_zeros(d)
    let dnoG=t_zeros(d); let dnoB=t_zeros(d); let droW=t_zeros(vd); let droB=t_zeros(V)
    // adam state
    let m_embed=t_zeros(vd); let v_embed=t_zeros(vd)
    let m_ecW=t_zeros(dd); let v_ecW=t_zeros(dd); let m_ecB=t_zeros(d); let v_ecB=t_zeros(d)
    let m_tcW=t_zeros(dd); let v_tcW=t_zeros(dd); let m_tcB=t_zeros(d); let v_tcB=t_zeros(d)
    let m_tgG=t_zeros(d); let v_tgG=t_zeros(d); let m_tgB=t_zeros(d); let v_tgB=t_zeros(d)
    let m_rW=t_zeros(ed); let v_rW=t_zeros(ed); let m_rB=t_zeros(E); let v_rB=t_zeros(E)
    let m_e0W=t_zeros(dd); let v_e0W=t_zeros(dd); let m_e0B=t_zeros(d); let v_e0B=t_zeros(d)
    let m_e1W=t_zeros(dd); let v_e1W=t_zeros(dd); let m_e1B=t_zeros(d); let v_e1B=t_zeros(d)
    let m_noG=t_zeros(d); let v_noG=t_zeros(d); let m_noB=t_zeros(d); let v_noB=t_zeros(d)
    let m_roW=t_zeros(vd); let v_roW=t_zeros(vd); let m_roB=t_zeros(V); let v_roB=t_zeros(V)
    // q caches + masks
    let ecWq=t_zeros(dd); let ecM=t_zeros(dd); let tcWq=t_zeros(dd); let tcM=t_zeros(dd)
    let e0Wq=t_zeros(dd); let e0M=t_zeros(dd); let e1Wq=t_zeros(dd); let e1M=t_zeros(dd)
    let rWq=t_zeros(ed); let rM=t_zeros(ed); let roWq=t_zeros(vd); let roM=t_zeros(vd)
    // act caches
    let xe=t_zeros(T*d); let xec=t_zeros(T*d); let xt=t_zeros(T*d)
    let hn0=t_zeros(T*d); let xhat0=t_zeros(T*d); let inv0=t_zeros(1)
    let eo0=t_zeros(T*d); let eo1=t_zeros(T*d); let probs=t_zeros(T*E); let ex_out=t_zeros(E*T*d)
    let yn=t_zeros(T*d); let xhatN=t_zeros(T*d); let invN=t_zeros(1)
    let logits=t_zeros(T*V); let dlogits=t_zeros(T*V)
    let tok=t_zeros(T); let tgt=t_zeros(T)

    let steps = epochs * nwin
    let mut sum_first = 0.0; let mut sum_last = 0.0
    let mut step = 1
    while step <= steps {
        let w = (step - 1) % nwin
        let mut p = 0
        while p < T {
            t_set(tok, p, t_get(IDS, w * T + p))
            t_set(tgt, p, t_get(TGT, w * T + p))
            p = p + 1
        }
        _re_fwd(tok, embed, ecW, ecB, tcW, tcB, tgG, tgB, rW, rB,
                e0W, e0B, e1W, e1B, noG, noB, roW, roB,
                ecWq, ecM, tcWq, tcM, e0Wq, e0M, e1Wq, e1M, rWq, rM, roWq, roM,
                xe, xec, xt, hn0, xhat0, inv0, eo0, eo1, probs, ex_out, yn, xhatN, invN,
                logits, T, d, E, V, K)
        let loss = nn_ce_loss_allpos(logits, tgt, T, V)
        if step <= nwin { sum_first = sum_first + loss }
        if step > steps - nwin { sum_last = sum_last + loss }
        _re_ce_grad(logits, tgt, dlogits, T, V)
        _re_bwd(dlogits, tok, embed, ecWq, tcWq, tgG, rWq, e0Wq, e1Wq, noG, roWq,
                ecM, tcM, e0M, e1M, rM, roM,
                xe, xec, xt, hn0, xhat0, inv0, eo0, eo1, probs, ex_out, yn, xhatN, invN,
                dembed, decW, decB, dtcW, dtcB, dtgG, dtgB, drW, drB, de0W, de0B, de1W, de1B,
                dnoG, dnoB, droW, droB, T, d, E, V, K)
        _adam(embed, dembed, m_embed, v_embed, vd, step)
        _adam(ecW, decW, m_ecW, v_ecW, dd, step); _adam(ecB, decB, m_ecB, v_ecB, d, step)
        _adam(tcW, dtcW, m_tcW, v_tcW, dd, step); _adam(tcB, dtcB, m_tcB, v_tcB, d, step)
        _adam(tgG, dtgG, m_tgG, v_tgG, d, step);  _adam(tgB, dtgB, m_tgB, v_tgB, d, step)
        _adam(rW, drW, m_rW, v_rW, ed, step);     _adam(rB, drB, m_rB, v_rB, E, step)
        _adam(e0W, de0W, m_e0W, v_e0W, dd, step); _adam(e0B, de0B, m_e0B, v_e0B, d, step)
        _adam(e1W, de1W, m_e1W, v_e1W, dd, step); _adam(e1B, de1B, m_e1B, v_e1B, d, step)
        _adam(noG, dnoG, m_noG, v_noG, d, step);  _adam(noB, dnoB, m_noB, v_noB, d, step)
        _adam(roW, droW, m_roW, v_roW, vd, step); _adam(roB, droB, m_roB, v_roB, V, step)
        step = step + 1
    }
    let first_ce = sum_first / to_float(nwin)
    let last_ce = sum_last / to_float(nwin)
    print("  epoch-1 mean CE = "); println(to_string(first_ce))
    print("  epoch-"); print(epochs); print(" mean CE = "); println(to_string(last_ce))

    // ---- serialize v0.2 .clm (6 conv int4 blocks + ext embed/bias/GN) ----
    let _outp = env("CLM_REEXPORT_OUT")
    if _outp != "" {
        let buf = []
        buf.push(67); buf.push(76); buf.push(77); buf.push(1)   // MAGIC "CLM\x01"
        buf.push(6)
        // int4-quantize the 6 conv weights → _re_save_block (clm_ckpt format).
        let ecQ=t_zeros(dd); let ecMk=t_zeros(dd); let ecSc=t_zeros(d); let ecQl=t_zeros(dd)
        nn_int4_quant_fwd(ecW, ecQ, ecSc, ecQl, ecMk, d, d*K); _re_save_block(buf, ecQl, ecSc, d, d*K)
        let tcQ=t_zeros(dd); let tcMk=t_zeros(dd); let tcSc=t_zeros(d); let tcQl=t_zeros(dd)
        nn_int4_quant_fwd(tcW, tcQ, tcSc, tcQl, tcMk, d, d*K); _re_save_block(buf, tcQl, tcSc, d, d*K)
        let e0Q=t_zeros(dd); let e0Mk=t_zeros(dd); let e0Sc=t_zeros(d); let e0Ql=t_zeros(dd)
        nn_int4_quant_fwd(e0W, e0Q, e0Sc, e0Ql, e0Mk, d, d*K); _re_save_block(buf, e0Ql, e0Sc, d, d*K)
        let e1Q=t_zeros(dd); let e1Mk=t_zeros(dd); let e1Sc=t_zeros(d); let e1Ql=t_zeros(dd)
        nn_int4_quant_fwd(e1W, e1Q, e1Sc, e1Ql, e1Mk, d, d*K); _re_save_block(buf, e1Ql, e1Sc, d, d*K)
        let rQ=t_zeros(ed); let rMk=t_zeros(ed); let rSc=t_zeros(E); let rQl=t_zeros(ed)
        nn_int4_quant_fwd(rW, rQ, rSc, rQl, rMk, E, d); _re_save_block(buf, rQl, rSc, E, d)
        let roQ=t_zeros(vd); let roMk=t_zeros(vd); let roSc=t_zeros(V); let roQl=t_zeros(vd)
        nn_int4_quant_fwd(roW, roQ, roSc, roQl, roMk, V, d); _re_save_block(buf, roQl, roSc, V, d)
        // v0.2 EXT trailer (embed + biases + GN affine), full fp32.
        _re_ext_begin(buf, 11)
        _re_ext_save_entry(buf, embed, vd)
        _re_ext_save_entry(buf, ecB, d); _re_ext_save_entry(buf, tcB, d)
        _re_ext_save_entry(buf, e0B, d); _re_ext_save_entry(buf, e1B, d)
        _re_ext_save_entry(buf, rB, E);  _re_ext_save_entry(buf, roB, V)
        _re_ext_save_entry(buf, tgG, d); _re_ext_save_entry(buf, tgB, d)
        _re_ext_save_entry(buf, noG, d); _re_ext_save_entry(buf, noB, d)
        write_bytes(_outp, buf)
        print("  CLM_REEXPORT_OUT wrote "); print(_outp); print("  (")
        print(len(buf)); println(" bytes, 6 blocks + v0.2 ext, CLM\\x01+CLMX)")
        print("  config d="); print(d); print(" E="); print(E)
        print(" epochs="); print(epochs); print(" nwin="); print(nwin); println("")
    }

    if last_ce < first_ce {
        println("F-CLM-REEXPORT-DESCENT = 1")
        println("PASS — host re-export trains a REAL descent; v0.2 embed+GN persisted")
        return
    }
    println("F-CLM-REEXPORT-DESCENT = 0")
    println("FAIL")
}
