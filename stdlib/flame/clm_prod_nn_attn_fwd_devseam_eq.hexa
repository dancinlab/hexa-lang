// ════════════════════════════════════════════════════════════════════════════
//  clm_prod_nn_attn_fwd_devseam_eq.hexa — LLM-path GQA attention-core FWD
//  host-seam byte-eq ORACLE.
//
//  HEXA-0POD: 0-GPU (`hexa run`) oracle proving the NEW device-resident seam in
//  stdlib/flame nn_lib (nn_attn_core_fwd) routes through the
//  forge_dispatch_attn_core_fwd host body BYTE-EQ to the pure-host
//  nn_attn_core_fwd reference loop. Off-CUDA the dispatcher takes the host
//  fallback body (rc=0); on-CUDA it takes the single-thread device kernel —
//  both are locked byte-eq to this host reference (max|Δ|=0).
//
//  BIT-EXACT CONTRACT: the scores dot and the softmax Σe / ctx reductions
//  accumulate SEQUENTIALLY under the host (hh→i→j→c) order with ONE thread (NO
//  atomics, NO tree re-assoc); scale = 1/libm-sqrt(hd) (IEEE correctly-rounded,
//  == device sqrt(double)); every mul-into-add uses __dmul_rn/__dadd_rn (host
//  FP_CONTRACT OFF) → NO FMA fuse.
//
//  THE SOFTMAX exp: the host _nn_softmax_row migrated libm exp → dt_exp
//  (F-OP19), and the device kernel routes the SAME 12-term scaled-Taylor /
//  range-halving through _hx_dt_exp_dev — byte-identical on all arch/OS. That
//  migration is what UN-DEFERRED the FWD seam (libm exp diverged 1 ULP arm64-
//  macos vs x86-linux, which no device exp could match). It also stays byte-eq
//  to the frozen F-RFC043-LAYER-EQ-ATTN-FWD max|Δ|=0 anchor, whose in-test
//  reference softmax migrated to dt_exp in lockstep.
//
//  F-ATTN-FWD-SEAM : dispatcher body == host nn_attn_core_fwd.
// ════════════════════════════════════════════════════════════════════════════

use "stdlib/flame/tensor_lib"
use "stdlib/flame/nn_lib"

fn _ab(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
fn _md(a: int, b: int, n: int) -> float {
    let mut m = 0.0
    let mut i = 0
    while i < n { let d = _ab(t_get(a, i) - t_get(b, i)); if d > m { m = d }; i = i + 1 }
    return m
}
fn _fill(a: int, n: int, seed: int) {
    let mut i = 0
    let mut s = seed
    while i < n {
        s = (s * 1103515245 + 12345) & 0x7FFFFFFF
        t_set(a, i, (to_float(s % 1000) - 500.0) * 0.01)
        i = i + 1
    }
}

fn main() {
    println("clm_prod_nn_attn_fwd_devseam_eq — attn_core_fwd device seam (host body) == host nn_attn_core_fwd")

    // GQA shape (n_rep = nh/nkv = 2). Deliberately non-square so kvh grouping,
    // the causal L=i+1 triangle, and the d=nh*hd context stride are all exercised.
    let T = 6
    let nh = 4
    let nkv = 2
    let hd = 4
    let d = nh * hd

    let Q = t_zeros(T * nh * hd)
    let K = t_zeros(T * nkv * hd)
    let V = t_zeros(T * nkv * hd)
    _fill(Q, T * nh * hd, 71)
    _fill(K, T * nkv * hd, 72)
    _fill(V, T * nkv * hd, 73)

    // ── host reference (env unset → host loop) ──
    let P_h   = t_zeros(nh * T * T)
    let ctx_h = t_zeros(T * d)
    nn_attn_core_fwd(Q, K, V, P_h, ctx_h, T, nh, nkv, hd)

    // ── dispatcher (off-CUDA host fallback body, or device kernel on-CUDA) ──
    let P_d   = t_zeros(nh * T * T)
    let ctx_d = t_zeros(T * d)
    let rcf = forge_dispatch_attn_core_fwd(Q, K, V, P_d, ctx_d, T, nh, nkv, hd)

    let db_P   = _md(P_h, P_d, nh * T * T)
    let db_ctx = _md(ctx_h, ctx_d, T * d)
    let mut db = db_P
    if db_ctx > db { db = db_ctx }

    if rcf != 0 {
        println("  !! dispatcher returned rc!=0 (host body not linked?)")
        println("  rc attn_core_fwd=" + to_string(rcf))
    }
    println("  attn_core fwd max|Δ| = " + to_string(db) + "   (P=" + to_string(db_P) + " ctx=" + to_string(db_ctx) + ")")

    if db == 0.0 { println("F-ATTN-FWD-SEAM = 1") } else { println("F-ATTN-FWD-SEAM = 0") }

    let ok = db == 0.0 && rcf == 0
    if ok {
        println("PASS — attn_core_fwd device seam (host body) == host nn_attn_core_fwd, byte-eq (max|Δ|=0)")
    } else {
        println("FAIL — max|Δ| = " + to_string(db))
    }
}
