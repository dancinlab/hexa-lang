// ════════════════════════════════════════════════════════════════════════════
//  clm_prod.hexa — CLMConvMoE production corpus loop (PR1 of CLM_PROD_TRAINER_PLAN).
//
//  Lifts the assembly-3b smoke (clm_qat.hexa, one hard-coded 4-token sequence)
//  to a REAL-CORPUS, multi-window training loop — the measure-track production
//  trainer skeleton (PLASTI-SIM; anima learns on-chip per H_904). The int4-QAT
//  fwd/bwd chain is reused verbatim from clm_qat (clm flame files cannot `use`
//  one another — each carries its own main — so the verified chain is inlined).
//
//  What PR1 adds over clm_qat:
//    · corpus loader — read_file_bytes(byte-vocab V=256) → nsamp causal windows
//      (input = bytes[off..off+T], target = bytes[off+1..off+T+1]).
//    · round-robin multi-window loop — one window per step, epochs passes.
//    · honest descent measure — mean CE over the first epoch vs the last epoch.
//
//  PR3 wiring: the forward conv 6× (embed·trunk·router·2 experts·readout) route
//  through conv1d_via_forge (im2col + forge_dispatch_matmul, byte-eq per
//  F-CLM-CONV-GPU-EQ #2352) instead of host nn_conv1d_fwd — so on a CUDA host the
//  matmul bulk rides cuBLAS. Corpus = cross-lingual-semantic parallel fixture.
//
//  Phase-4 wiring (this revision): the backward conv 6× now route through
//  conv1d_bwd_via_forge (col2im + forge_dispatch_matmul, byte-eq to nn_conv1d_bwd
//  per F-CLM-CONV-BWD-FORGE-EQ #2383) instead of host nn_conv1d_bwd — so the
//  backward GEMMs ride forge cuBLAS too. GRAD-EXACT preserved (byte-eq, identical
//  CE descent); the GPU util-GREEN measurement itself is the next H100 fire.
//
//  F-CLM-PROD-DESCENT: real-corpus mean CE strictly descends (last_epoch <
//  first_epoch · finite). Corpus = stdlib/flame/testdata/clm_semantic_parallel.txt
//  (in-repo, machine-independent, repo-root relative). Config tiny (d=8) for $0
//  CPU verify; PR4 fires large d768/12L on H100 (forge=cuBLAS) with the real anima corpus.
// ════════════════════════════════════════════════════════════════════════════

use "stdlib/flame/tensor_lib"
use "stdlib/flame/conv_lib"
use "stdlib/flame/gn_lib"
use "stdlib/flame/moe_lib"
use "stdlib/flame/nn_lib"
use "stdlib/flame/quant_lib"
use "stdlib/flame/optim_lib"
use "stdlib/flame/flame_math"   // dt_exp — deterministic CE-bwd exp (F-OP19)

// ── HEXA-FUSION E2: HEXA_FUSE_ALL convenience meta-flag ──────────────────────
// The full landed fusion + device-resident stack is 100% opt-in env flags,
// default OFF (H1D-ANIMA-ENV-WIRING.md #2727). A consumer (anima clm_prod) must
// otherwise hand-export ~8 byte-eq levers to escape the un-fused baseline. This
// helper folds the whole byte-eq stack behind ONE gate:
//
//   HEXA_FUSE_ALL=1  ⇒  every CLM_PROD_DEVRESIDENT / DEVFEED / BATCHED and every
//                       HEXA_FUSE_* lever reads as SET (HEXA_CUDA_ASYNC follows
//                       CLM_PROD_DEVRESIDENT in the runtime, so it turns on too).
//
// ADDITIVE + SAFE: an explicit individual flag still independently turns its own
// lever on — the meta-flag only ORs an extra "on" source, it never forces a
// lever OFF. BYTE-EQ ONLY: this gate covers exactly the verified max|Δ|=0 levers
// (L3-a/b/c/d fusion + device-resident chain, F-FUSION-L3*-AB verdicts). It does
// NOT touch HEXA_OWN_GEMM* — that is a TF32 precision change and stays an
// explicit opt-in (see RECOMMENDED-ENV.md / H1D §5).
fn _fuse_on(flag: string) -> bool {
    if env(flag) != "" { return true }
    if env("HEXA_FUSE_ALL") != "" { return true }
    return false
}

// HEXA-FUSION P1B-a' (byte-eq capstone): device-resident EAGER reference. The
// P1B re-baseline (#2777) closed the GEMM reduction-order axis (own-mega vs
// own-eager max|Δ|=8.882e-16, NOT the conv k-order) and pinned the residual to
// a host↔device TRANSCENDENTAL: the eager reference's gelu ran on HOST (libm
// erf) while the megakernel's gelu runs on DEVICE (CUDA erf). erf is a libm
// builtin (stdlib_trig_libm: no hand-rolled Taylor erf to port), so the only way
// to share the SAME erf is to make the EAGER reference itself device-resident —
// run the fwd glue (gelu/groupnorm/softmax) ON DEVICE as SEPARATE launches (NOT
// the cooperative megakernel), with the SAME CUDA erf. HEXA_EAGER_DEVRESIDENT
// turns the fwd glue device-resident WITHOUT the megastep, so the byte-eq oracle
// becomes device-eager (CUDA erf, separate launches) — both arms then share CUDA
// erf + identical naive-k own-GEMM + order-independent elementwise glue.
// _devres_glue_on() = the fwd-glue device gate: ON under either the standard
// CLM_PROD_DEVRESIDENT chain OR the P1B-a' HEXA_EAGER_DEVRESIDENT capstone flag.
fn _devres_glue_on() -> bool {
    if _fuse_on("CLM_PROD_DEVRESIDENT") { return true }
    if _fuse_on("HEXA_EAGER_DEVRESIDENT") { return true }
    return false
}

// conv1d (causal dilated) via im2col + forge matmul — inlined from clm_conv_gpu
// (clm flame files cannot `use` one another). Mirrors nn_conv1d_fwd's gather
// exactly: p = t − dil·(K−1−k); rows below p<0 are zero (left causal pad). On a
// CUDA host the matmul rides cuBLAS; on CPU it is the identical farr_matmul, so
// the routed forward is byte-eq to the host baseline (F-CLM-CONV-GPU-EQ #2352).
// ── LEVER (a): device-resident im2col / col2im helpers (forge device-feed) ──
// Env CLM_PROD_DEVFEED gates the device builtins (forge_dispatch_im2col /
// _im2col_t / _col2im), which engage ONLY in the self-host-rebuilt pod binary
// (the prebuilt mac binary lacks them; the env gate keeps `hexa run` from link-
// referencing them). On CUDA the gather/scatter run on-device and KEEP x_col
// FARR_DEVICE so the follow-up forge GEMM reads it in place — NO host roundtrip
// (the dominant Lane-G util peg). rc 0 = done on-device; else the host gather/
// scatter below runs (byte-eq oracle, clm_conv_devfeed.hexa F-CLM-DEVFEED-*).
fn _clmp_im2col(x: int, xcol: int, T: int, Cin: int, K: int, dil: int) {
    if _fuse_on("CLM_PROD_DEVFEED") {
        let rc = forge_dispatch_im2col(x, xcol, T, Cin, K, dil)
        if rc == 0 { return }
    }
    let Kdim = Cin * K
    let mut iz = 0
    while iz < T * Kdim { t_set(xcol, iz, 0.0); iz = iz + 1 }
    let mut t = 0
    while t < T {
        let mut ci = 0
        while ci < Cin {
            let mut k = 0
            while k < K {
                let p = t - dil * (K - 1 - k)
                if p >= 0 { t_set(xcol, t * Kdim + ci * K + k, t_get(x, p * Cin + ci)) }
                k = k + 1
            }
            ci = ci + 1
        }
        t = t + 1
    }
}
fn _clmp_im2col_t(x: int, xcolT: int, T: int, Cin: int, K: int, dil: int) {
    if _fuse_on("CLM_PROD_DEVFEED") {
        let rc = forge_dispatch_im2col_t(x, xcolT, T, Cin, K, dil)
        if rc == 0 { return }
    }
    let Kdim = Cin * K
    let mut iz = 0
    while iz < Kdim * T { t_set(xcolT, iz, 0.0); iz = iz + 1 }
    let mut t = 0
    while t < T {
        let mut ci = 0
        while ci < Cin {
            let mut k = 0
            while k < K {
                let p = t - dil * (K - 1 - k)
                if p >= 0 { let j = ci * K + k; t_set(xcolT, j * T + t, t_get(x, p * Cin + ci)) }
                k = k + 1
            }
            ci = ci + 1
        }
        t = t + 1
    }
}
fn _clmp_col2im(dXcol: int, dX_out: int, T: int, Cin: int, K: int, dil: int) {
    if _fuse_on("CLM_PROD_DEVFEED") {
        let rc = forge_dispatch_col2im(dXcol, dX_out, T, Cin, K, dil)
        if rc == 0 { return }
    }
    // host transpose-gather scatter (byte-eq to the device kernel; each dX[p,ci]
    // sums its K dilated taps once — deterministic, no double-count).
    let Kdim = Cin * K
    let mut iz = 0
    while iz < T * Cin { t_set(dX_out, iz, 0.0); iz = iz + 1 }
    let mut p = 0
    while p < T {
        let mut ci = 0
        while ci < Cin {
            let mut acc = 0.0
            let mut k = 0
            while k < K {
                let tt = p + dil * (K - 1 - k)
                if tt < T { let j = ci * K + k; acc = acc + t_get(dXcol, tt * Kdim + j) }
                k = k + 1
            }
            t_set(dX_out, p * Cin + ci, acc)
            ci = ci + 1
        }
        p = p + 1
    }
}

// HEXA-FUSION L1 (GRAD half): device-resident bias-gradient column sum.
// db_out[co] = Σ_{t=0..T-1} dy[t,co]. Under CLM_PROD_DEVRESIDENT this runs
// on-device (forge_dispatch_db_colsum) keeping db_out FARR_DEVICE so the
// follow-up _adam(W, db_out, ...) H2D-skips the grad — the conv bias grads
// d*B escape ONLY into _adam (nothing on the host reads them between bwd and
// the optimizer), so the per-step db D2H (read dy back) + next H2D is a pure
// removable grad roundtrip. The device kernel sums T SEQUENTIALLY per channel
// (NO tree re-association) → bit-exact to the host loop below (max|Δ|=0). rc 0
// = done on-device; else the host reduction runs (byte-eq oracle). Engages
// only in the self-host-rebuilt pod binary (env-gated so the prebuilt mac
// binary, which lacks the builtin, never link-references it under `hexa run`).
fn _clmp_db_colsum(dy: int, db_out: int, T: int, Cout: int) {
    if _fuse_on("CLM_PROD_DEVRESIDENT") {
        let rc = forge_dispatch_db_colsum(dy, db_out, T, Cout)
        if rc == 0 { return }
    }
    let mut cb = 0
    while cb < Cout {
        let mut acc = 0.0
        let mut tb = 0
        while tb < T {
            acc = acc + t_get(dy, tb * Cout + cb)
            tb = tb + 1
        }
        t_set(db_out, cb, acc)
        cb = cb + 1
    }
}

fn conv1d_via_forge(x: int, w: int, b: int, y_out: int,
                    T: int, Cin: int, Cout: int, K: int, dil: int) {
    let Kdim = Cin * K
    let xcol = t_zeros(T * Kdim)
    _clmp_im2col(x, xcol, T, Cin, K, dil)
    let Wt = t_zeros(Kdim * Cout)
    let mut co = 0
    while co < Cout {
        let mut j = 0
        while j < Kdim { t_set(Wt, j * Cout + co, t_get(w, co * Kdim + j)); j = j + 1 }
        co = co + 1
    }
    let mm = forge_dispatch_matmul(xcol, T, Kdim, Wt, Cout)
    let mut t2 = 0
    while t2 < T {
        let mut c2 = 0
        while c2 < Cout {
            t_set(y_out, t2 * Cout + c2, t_get(mm, t2 * Cout + c2) + t_get(b, c2))
            c2 = c2 + 1
        }
        t2 = t2 + 1
    }
}

// conv1d backward (causal dilated) via forge matmul + col2im — inlined from
// clm_conv_gpu (clm flame files cannot `use` one another). Expresses the two
// heavy gradients (dW, dX) as GEMMs routed through forge_dispatch_matmul
// (cuBLAS on a CUDA host, identical farr_matmul on CPU) so the backward stops
// being a host scalar loop. Byte-eq to nn_conv1d_bwd (dW 1.67e-16 / dX 8.3e-17
// / db 0.0 per F-CLM-CONV-BWD-FORGE-EQ #2383). col index j = ci*K + k.
fn conv1d_bwd_via_forge(x: int, w: int, dy: int,
                        dW_out: int, dX_out: int, db_out: int,
                        T: int, Cin: int, Cout: int, K: int, dil: int) {
    let Kdim = Cin * K
    // im2col_t: xcolT[j, t] = (p>=0) ? x[p, ci] : 0, j = ci*K+k, p = t - dil*(K-1-k).
    // LEVER (a): device-resident under CLM_PROD_DEVFEED (no host roundtrip).
    let xcolT = t_zeros(Kdim * T)
    _clmp_im2col_t(x, xcolT, T, Cin, K, dil)
    // dW: dW_flat[Kdim, Cout] = xcolT[Kdim,T] @ dy[T,Cout] (forge GEMM)
    //
    // HEXA-0POD OP-2 (BENCH-10 transpose-elim) — READY but DEFERRED to the GPU
    // build (needs the runtime.c hexa_forge_dispatch_matmul_t wrapper body, which
    // is build-time-assembled, not in this worktree). When that body lands, swap
    // the two lines above for the transpose-elim path under HEXA_BWD_TRANSPOSE_ELIM:
    //     let xcol = t_zeros(T * Kdim)
    //     _clmp_im2col(x, xcol, T, Cin, K, dil)           // SAME layout as the fwd
    //     dW_flat = forge_dispatch_matmul_t(xcol, T, Kdim, dy, Cout)  // cuBLAS OP_T
    // which drops the separate transpose-layout im2col_t pass entirely. Byte-eq to
    // this path proven max|Δ|=0 in clm_prod_transpose_elim_eq.hexa. The GPU kernel
    // (_hx_cuda_farr_matmul_tn_gpu), codegen mapping, and runtime.h proto are landed.
    let dW_flat = forge_dispatch_matmul(xcolT, Kdim, T, dy, Cout)
    let mut co = 0
    while co < Cout {
        let mut j = 0
        while j < Kdim {
            t_set(dW_out, co * Kdim + j, t_get(dW_flat, j * Cout + co))
            j = j + 1
        }
        co = co + 1
    }
    // dX: dXcol[T, Kdim] = dy[T,Cout] @ Wflat[Cout,Kdim] (forge GEMM), then col2im.
    // LEVER (a): device-resident col2im scatter under CLM_PROD_DEVFEED.
    let dXcol = forge_dispatch_matmul(dy, T, Cout, w, Kdim)
    _clmp_col2im(dXcol, dX_out, T, Cin, K, dil)
    // db: db_out[co] = Σ_t dy[t,co]. HEXA-FUSION L1 (GRAD half): device-resident
    // under CLM_PROD_DEVRESIDENT (keeps db_out FARR_DEVICE → next _adam H2D-skips
    // the grad), else host reduction (byte-eq). Sequential t-sum either way.
    _clmp_db_colsum(dy, db_out, T, Cout)
}

// ── LEVER (b): batched strided GEMM helper (inlined from clm_conv_batched) ──
// forge_matmul_batched is the CPU oracle: `batch` independent forge_dispatch_
// matmul calls scattered into c_all (caller-allocated, batch·M·N) — byte-eq to
// the un-batched path. On a CUDA host (env CLM_PROD_BATCHED != "") the trainer
// routes the 2-expert convs through forge_dispatch_matmul_batched (ONE
// cublasDgemmStridedBatched launch) instead — the util lever vs 2 micro-launches.
fn _fmb_oracle(a_all: int, M: int, K: int, b_all: int, N: int, batch: int, c_all: int) {
    let mut g = 0
    while g < batch {
        let aoff = g * M * K; let boff = g * K * N; let coff = g * M * N
        let asl = t_zeros(M * K)
        let mut ia = 0
        while ia < M * K { t_set(asl, ia, t_get(a_all, aoff + ia)); ia = ia + 1 }
        let bsl = t_zeros(K * N)
        let mut ib = 0
        while ib < K * N { t_set(bsl, ib, t_get(b_all, boff + ib)); ib = ib + 1 }
        let csl = forge_dispatch_matmul(asl, M, K, bsl, N)
        let mut ic = 0
        while ic < M * N { t_set(c_all, coff + ic, t_get(csl, ic)); ic = ic + 1 }
        t_free(asl); t_free(bsl); t_free(csl)
        g = g + 1
    }
}
fn _clmp_matmul_batched(a_all: int, M: int, K: int, b_all: int, N: int, batch: int, c_all: int) {
    // GPU strided-batched path engages only in the self-host-rebuilt pod binary
    // (env-gated so the prebuilt mac binary, which lacks the batched builtin,
    // never link-references it under `hexa run`). rc 0 = done; else CPU oracle.
    if _fuse_on("CLM_PROD_BATCHED") {
        let rc = forge_dispatch_matmul_batched(a_all, M, K, b_all, N, batch, c_all)
        if rc == 0 { return }
    }
    _fmb_oracle(a_all, M, K, b_all, N, batch, c_all)
}

// forward of the TWO identical-shape ConvExperts (e0,e1: d→d, K) fused into ONE
// batched im2col-matmul. Both read the same trunk input x. Byte-eq to two
// conv1d_via_forge calls (F-CLM-CONV2-BATCHED-FWD-EQ, clm_conv_batched.hexa).
fn conv2_fwd_via_forge_batched(x: int, w0: int, b0: int, w1: int, b1: int,
                               y0_out: int, y1_out: int,
                               T: int, Cin: int, Cout: int, K: int, dil: int) {
    let Kdim = Cin * K
    // F-RFC046: route the shared expert im2col through the lever-(a) device helper
    // (_clmp_im2col, device-resident under CLM_PROD_DEVFEED) instead of an inline
    // host t_set gather. Byte-eq: _clmp_im2col's host fallback IS this exact gather
    // (F-CLM-DEVFEED-IM2COL-EQ max|Δ|=0.0); on a CUDA host it stays FARR_DEVICE so
    // the follow-up batched GEMM reads it with no H2D roundtrip — off the host hot path.
    let xcol = t_zeros(T * Kdim)
    _clmp_im2col(x, xcol, T, Cin, K, dil)
    let a_all = t_zeros(2 * T * Kdim)
    let mut ia = 0
    while ia < T * Kdim {
        t_set(a_all, ia, t_get(xcol, ia)); t_set(a_all, T * Kdim + ia, t_get(xcol, ia)); ia = ia + 1
    }
    let b_all = t_zeros(2 * Kdim * Cout)
    let mut co = 0
    while co < Cout {
        let mut j = 0
        while j < Kdim {
            t_set(b_all, j * Cout + co, t_get(w0, co * Kdim + j))
            t_set(b_all, Kdim * Cout + j * Cout + co, t_get(w1, co * Kdim + j))
            j = j + 1
        }
        co = co + 1
    }
    let c_all = t_zeros(2 * T * Cout)
    _clmp_matmul_batched(a_all, T, Kdim, b_all, Cout, 2, c_all)
    let mut t2 = 0
    while t2 < T {
        let mut c2 = 0
        while c2 < Cout {
            t_set(y0_out, t2 * Cout + c2, t_get(c_all, t2 * Cout + c2) + t_get(b0, c2))
            t_set(y1_out, t2 * Cout + c2, t_get(c_all, T * Cout + t2 * Cout + c2) + t_get(b1, c2))
            c2 = c2 + 1
        }
        t2 = t2 + 1
    }
    t_free(xcol); t_free(a_all); t_free(b_all); t_free(c_all)
}

// backward of the TWO ConvExperts fused: batched dW + batched dX GEMM. Byte-eq
// to two conv1d_bwd_via_forge calls (F-CLM-CONV2-BATCHED-BWD-EQ).
fn conv2_bwd_via_forge_batched(x: int, w0: int, w1: int, dy0: int, dy1: int,
                               dW0_out: int, dX0_out: int, db0_out: int,
                               dW1_out: int, dX1_out: int, db1_out: int,
                               T: int, Cin: int, Cout: int, K: int, dil: int) {
    let Kdim = Cin * K
    // F-RFC046: route the shared expert transpose-im2col through the lever-(a)
    // device helper (_clmp_im2col_t) instead of an inline host t_set gather.
    // Byte-eq: _clmp_im2col_t's host fallback IS this exact transpose-gather
    // (F-CLM-DEVFEED-IM2COL-EQ); device-resident under CLM_PROD_DEVFEED → off the
    // host hot path, fed straight into the batched dW GEMM.
    let xcolT = t_zeros(Kdim * T)
    _clmp_im2col_t(x, xcolT, T, Cin, K, dil)
    let dwA = t_zeros(2 * Kdim * T)
    let mut ia = 0
    while ia < Kdim * T { t_set(dwA, ia, t_get(xcolT, ia)); t_set(dwA, Kdim * T + ia, t_get(xcolT, ia)); ia = ia + 1 }
    let dwB = t_zeros(2 * T * Cout)
    let mut ib = 0
    while ib < T * Cout { t_set(dwB, ib, t_get(dy0, ib)); t_set(dwB, T * Cout + ib, t_get(dy1, ib)); ib = ib + 1 }
    let dW_flat_all = t_zeros(2 * Kdim * Cout)
    _clmp_matmul_batched(dwA, Kdim, T, dwB, Cout, 2, dW_flat_all)
    let mut co = 0
    while co < Cout {
        let mut j = 0
        while j < Kdim {
            t_set(dW0_out, co * Kdim + j, t_get(dW_flat_all, j * Cout + co))
            t_set(dW1_out, co * Kdim + j, t_get(dW_flat_all, Kdim * Cout + j * Cout + co))
            j = j + 1
        }
        co = co + 1
    }
    let dxA = t_zeros(2 * T * Cout)
    let mut ja = 0
    while ja < T * Cout { t_set(dxA, ja, t_get(dy0, ja)); t_set(dxA, T * Cout + ja, t_get(dy1, ja)); ja = ja + 1 }
    let dxB = t_zeros(2 * Cout * Kdim)
    let mut jb = 0
    while jb < Cout * Kdim { t_set(dxB, jb, t_get(w0, jb)); t_set(dxB, Cout * Kdim + jb, t_get(w1, jb)); jb = jb + 1 }
    let dXcol_all = t_zeros(2 * T * Kdim)
    _clmp_matmul_batched(dxA, T, Cout, dxB, Kdim, 2, dXcol_all)
    let mut iz = 0
    while iz < T * Cin { t_set(dX0_out, iz, 0.0); t_set(dX1_out, iz, 0.0); iz = iz + 1 }
    let mut t2 = 0
    while t2 < T {
        let mut ci2 = 0
        while ci2 < Cin {
            let mut k2 = 0
            while k2 < K {
                let p = t2 - dil * (K - 1 - k2)
                if p >= 0 {
                    let j = ci2 * K + k2; let xidx = p * Cin + ci2
                    t_set(dX0_out, xidx, t_get(dX0_out, xidx) + t_get(dXcol_all, t2 * Kdim + j))
                    t_set(dX1_out, xidx, t_get(dX1_out, xidx) + t_get(dXcol_all, T * Kdim + t2 * Kdim + j))
                }
                k2 = k2 + 1
            }
            ci2 = ci2 + 1
        }
        t2 = t2 + 1
    }
    // db0/db1: each db[co] = Σ_t dy{0,1}[t,co]. HEXA-FUSION L1 (GRAD half):
    // device-resident under CLM_PROD_DEVRESIDENT (each kept FARR_DEVICE → next
    // _adam H2D-skips the grad), else host reduction (byte-eq). The two sums are
    // independent so routing each through _clmp_db_colsum is identical to the
    // prior fused loop (same sequential t-order per channel → max|Δ|=0).
    _clmp_db_colsum(dy0, db0_out, T, Cout)
    _clmp_db_colsum(dy1, db1_out, T, Cout)
    t_free(xcolT); t_free(dwA); t_free(dwB); t_free(dW_flat_all)
    t_free(dxA); t_free(dxB); t_free(dXcol_all)
}

// fake-quant a weight into wq (caller-allocated) + write the STE mask.
// HEXA-FUSION L1 (PARAM half): device-resident int4 fake-quant. Under env
// CLM_PROD_DEVRESIDENT the per-channel quant runs ON DEVICE
// (forge_dispatch_int4_quant) so W stays FARR_DEVICE (no per-step W D2H — the
// last host roundtrip blocking full device-residency) and wq/sc/ql/mask stay
// device-resident (wq feeds the GEMM, mask feeds the device STE bwd). int4 is
// INTEGER rounding + per-channel sequential max → NO fp re-association → the
// device quant is BIT-EXACT to nn_int4_quant_fwd (max|Δ|=0). rc 0 = done on
// device; else the host fake-quant runs (byte-eq). Engages only in the
// self-host-rebuilt pod binary (env-gated so the prebuilt mac binary, which
// lacks the builtin, never link-references it under `hexa run`).
fn _fq(w: int, wq: int, mask: int, Cout: int, rest: int) {
    let sc = t_zeros(Cout); let ql = t_zeros(Cout * rest)
    if _fuse_on("CLM_PROD_DEVRESIDENT") {
        let rc = forge_dispatch_int4_quant(w, wq, sc, ql, mask, Cout, rest)
        if rc == 0 { return }
    }
    nn_int4_quant_fwd(w, wq, sc, ql, mask, Cout, rest)
}

// HEXA-FUSION L1 (PARAM half): device-resident int4 STE backward.
// dW[i] = dy[i]·mask[i] (clipped straight-through estimator). Under
// CLM_PROD_DEVRESIDENT this runs on-device (forge_dispatch_int4_quant_bwd)
// keeping dW FARR_DEVICE so the follow-up _adam(W, dW, ...) H2D-skips the grad
// — the int4 W grads escape ONLY into _adam (nothing on the host reads them
// between bwd and the optimizer). The STE is a pure elementwise multiply (no
// reduction) → bit-exact to nn_int4_quant_bwd (max|Δ|=0). rc 0 = done on
// device; else the host STE runs (byte-eq). Env-gated like _fq above.
fn _qbwd(dy: int, mask: int, dW: int, Cout: int, rest: int) {
    if _fuse_on("CLM_PROD_DEVRESIDENT") {
        let rc = forge_dispatch_int4_quant_bwd(dy, mask, dW, Cout * rest)
        if rc == 0 { return }
    }
    nn_int4_quant_bwd(dy, mask, dW, Cout, rest)
}

// HEXA-FUSION L3 (glue half): device-resident elementwise residual-add.
// out[i] = a[i] + b[i] for i in 0..n. This is the highest-frequency
// interpreted inter-op host glue in clm_prod_fwd — the residual xt = xec + hg0
// run T·d times in the interpreter between device GEMM spikes (the ③ fwd-only
// 0% util floor: tensors device-resident is necessary but NOT sufficient while
// the inter-op glue stays interpreted on host). Under CLM_PROD_DEVRESIDENT the
// add runs on-device (forge_dispatch_residual_add) keeping out FARR_DEVICE so
// the next conv GEMM (conv1d_via_forge over rWq, then conv2 experts) H2D-skips
// it, and — critically — the interpreter leaves the per-step hot path. Pure
// elementwise add (no reduction) → bit-exact to the host scalar loop
// (max|Δ|=0). rc 0 = done on device; else the host loop runs (byte-eq).
// Env-gated like _fq / _qbwd above (no-CUDA / prebuilt mac binary → host loop).
fn _residual_add(a: int, b: int, out: int, n: int) {
    if _devres_glue_on() {
        let rc = forge_dispatch_residual_add(a, b, out, n)
        if rc == 0 { return }
    }
    let mut i = 0
    while i < n { t_set(out, i, t_get(a, i) + t_get(b, i)); i = i + 1 }
}

// HEXA-FUSION L3 (glue half): device-resident elementwise GELU.
// out[i] = GELU(in[i]) for i in 0..n — gelu ×3 in clm_prod_fwd (hg0/ex0/ex1)
// are the 2nd-highest interpreted inter-op host glue after the residual (the ③
// fwd-only 0% floor). Under CLM_PROD_DEVRESIDENT the activation runs on-device
// (forge_dispatch_gelu), keeping out FARR_DEVICE so the next conv GEMM
// H2D-skips it and the interpreter leaves the per-step hot path. erf-based GELU,
// pure elementwise (no reduction) → bit-exact to nn_gelu_fwd (max|Δ|=0). rc 0 =
// done on device; else the proven host nn_gelu_fwd runs (byte-eq). Env-gated
// like _residual_add (no-CUDA / prebuilt mac binary → host gelu).
fn _gelu(g: int, out: int, n: int) {
    if _devres_glue_on() {
        let rc = forge_dispatch_gelu(g, out, n)
        if rc == 0 { return }
    }
    nn_gelu_fwd(g, out, n)
}

// HEXA-FUSION L3-b (op-boundary fusion): the 2 INDEPENDENT same-shape expert-conv
// activations (eo0->a0, eo1->a1, both n = T*d) fused into ONE device launch — two
// micro gelu kernels collapse into a single thread-grid pass to raise H100
// occupancy. byte-eq to two separate _gelu calls (each write reproduces the same
// erf-based gelu on its own input, max|Δ|=0). Gated by env HEXA_FUSE_GELU2 on the
// device-resident chain; OFF / no-CUDA / rc!=0 → the two host _gelu calls run
// UNCHANGED (byte-eq reference).
fn _gelu2(g0: int, a0: int, g1: int, a1: int, n: int) {
    if _fuse_on("HEXA_FUSE_GELU2") && _fuse_on("CLM_PROD_DEVRESIDENT") {
        let rc = forge_dispatch_gelu2(g0, a0, g1, a1, n)
        if rc == 0 { return }
    }
    _gelu(g0, a0, n)
    _gelu(g1, a1, n)
}

// HEXA-FUSION L3 (glue half): device-resident GroupNorm forward.
// groupnorm ×2 in clm_prod_fwd (h0→hn0, y→yn) are interpreted inter-op host
// glue with a per-group reduction (the ③ fwd-only 0% floor). Under
// CLM_PROD_DEVRESIDENT the norm runs on-device (forge_dispatch_groupnorm),
// keeping y/xhat/mean/inv FARR_DEVICE so the next conv GEMM / gelu H2D-skips
// them. The device kernel reduces SEQUENTIALLY (t outer, c inner) per group and
// uses the SAME Newton-Raphson 40-iter sqrt as the host (NO tree re-assoc) →
// bit-exact to nn_groupnorm_fwd (max|Δ|=0). rc 0 = done on device; else the
// proven host nn_groupnorm_fwd runs (byte-eq). Env-gated like _gelu above.
fn _groupnorm(x: int, gamma: int, beta: int, y: int, mean: int, inv: int, xhat: int, T: int, C: int, G: int) {
    if _devres_glue_on() {
        let rc = forge_dispatch_groupnorm(x, gamma, beta, y, mean, inv, xhat, T, C, G)
        if rc == 0 { return }
    }
    nn_groupnorm_fwd(x, gamma, beta, y, mean, inv, xhat, T, C, G)
}

// HEXA-FUSION L3-a (op-boundary fusion): groupnorm #1 → gelu #1 in ONE device
// kernel (y = pre-gelu GN out for bwd, a = gelu out). The GN→GELU pair at the
// fwd head (h0→hn0→hg0) is the first adjacent small-kernel pair; collapsing the
// two launches into one raises occupancy (the only remaining util lever after
// host-removal ②④⑤ bottomed out ~13%). Gated by env HEXA_FUSE_GN_GELU on the
// device-resident chain; OFF / device-fail → the SEPARATE _groupnorm + _gelu run
// (byte-identical reference — same erf-gelu, same GN reduction order).
fn _groupnorm_gelu(x: int, gamma: int, beta: int, y: int, a: int, mean: int, inv: int, xhat: int, T: int, C: int, G: int) {
    if _fuse_on("HEXA_FUSE_GN_GELU") && _fuse_on("CLM_PROD_DEVRESIDENT") {
        let rc = forge_dispatch_groupnorm_gelu(x, gamma, beta, y, a, mean, inv, xhat, T, C, G)
        if rc == 0 { return }
    }
    _groupnorm(x, gamma, beta, y, mean, inv, xhat, T, C, G)
    _gelu(y, a, T * C)
}

// HEXA-FUSION L3-c (op-boundary fusion): groupnorm #1 → gelu #1 → residual-add
// fused into ONE device kernel (y = pre-gelu GN out for bwd, a = gelu out, out =
// r + a = the residual xt). Extends L3-a by also folding the immediately-adjacent
// _residual_add(xec, hg0, xt) at the fwd head — collapsing 2 launches
// (groupnorm_gelu + residual_add) into 1 raises occupancy (the only remaining util
// lever after host-removal ②④⑤ bottomed out ~13% and cublasLt epilogue fusion was
// ruled out — FP64 has no GELU epilogue). Gated by env HEXA_FUSE_GN_GELU_RESID on
// the device-resident chain; OFF / device-fail → the SEPARATE _groupnorm_gelu +
// _residual_add run (byte-identical reference — same erf-gelu, same GN reduction
// order, same residual add order, max|Δ|=0).
fn _groupnorm_gelu_residual(x: int, gamma: int, beta: int, r: int, y: int, a: int, out: int, mean: int, inv: int, xhat: int, T: int, C: int, G: int) {
    if _fuse_on("HEXA_FUSE_GN_GELU_RESID") && _fuse_on("CLM_PROD_DEVRESIDENT") {
        let rc = forge_dispatch_groupnorm_gelu_residual(x, gamma, beta, r, y, a, out, mean, inv, xhat, T, C, G)
        if rc == 0 { return }
    }
    _groupnorm_gelu(x, gamma, beta, y, a, mean, inv, xhat, T, C, G)
    _residual_add(r, a, out, T * C)
}

// HEXA-FUSION L3 (glue half · final slice ⑤c): device-resident embedding gather.
// The token-gather at the head of clm_prod_fwd (xe[i·d+c] = embed[tok·d+c]) is
// interpreted inter-op host glue (the ③ fwd-only 0% floor). Under
// CLM_PROD_DEVRESIDENT it fuses onto the device (forge_dispatch_embedding),
// keeping xe FARR_DEVICE so the first conv GEMM H2D-skips it. Pure gather, NO
// reduction → bit-exact to nn_embedding_fwd (max|Δ|=0). rc 0 = on device; else
// the proven host nn_embedding_fwd runs (byte-eq). Env-gated like _gelu above.
fn _embedding(ids: int, table: int, out: int, T: int, d: int) {
    if _devres_glue_on() {
        let rc = forge_dispatch_embedding(ids, table, out, T, d)
        if rc == 0 { return }
    }
    nn_embedding_fwd(ids, table, out, T, d)
}

// HEXA-FUSION L3 (glue half · final slice ⑤c): device-resident expert-pack copy.
// The clm_prod_fwd j-loop that stacks the 2 expert activations ex0/ex1 into
// ex_out[E·T·d] (ex_out[0·n+j]=ex0[j], ex_out[1·n+j]=ex1[j], n=T·d) is
// interpreted inter-op host glue (the ③ fwd-only 0% floor). Under
// CLM_PROD_DEVRESIDENT it fuses onto the device (forge_dispatch_expert_pack2),
// keeping ex_out FARR_DEVICE so the moe-router H2D-skips it. Pure copy, NO
// reduction → bit-exact (max|Δ|=0). rc 0 = on device; else the byte-identical
// host pack loop runs. Env-gated like _gelu above.
fn _expert_pack2(ex0: int, ex1: int, ex_out: int, n: int) {
    if _devres_glue_on() {
        let rc = forge_dispatch_expert_pack2(ex0, ex1, ex_out, n)
        if rc == 0 { return }
    }
    let mut j = 0
    while j < n {
        t_set(ex_out, 0 * n + j, t_get(ex0, j))
        t_set(ex_out, 1 * n + j, t_get(ex1, j))
        j = j + 1
    }
}

// HEXA-FUSION L3 (glue half · final slice ⑤c): device-resident MoE router.
// The moe-router (softmax gate over E experts + gate-weighted combine, logits_r
// · ex_out → y/probs) is interpreted inter-op host glue with a per-position
// REDUCTION (the ③ fwd-only 0% floor). Under CLM_PROD_DEVRESIDENT it fuses onto
// the device (forge_dispatch_moe_router), keeping y/probs FARR_DEVICE so the
// next groupnorm/conv H2D-skips them. The device kernel replays moe_lib's
// hand-rolled _moe_exp (scaled-Taylor, NOT CUDA exp) and accumulates BOTH
// reductions SEQUENTIALLY (NO tree re-assoc) → bit-exact to nn_moe_router_fwd
// (max|Δ|=0). rc 0 = on device; else the proven host nn_moe_router_fwd runs
// (byte-eq). Env-gated like _gelu above.
fn _moe_router(logits: int, ex_out: int, probs: int, y: int, T: int, E: int, C: int) {
    if _devres_glue_on() {
        let rc = forge_dispatch_moe_router(logits, ex_out, probs, y, T, E, C)
        if rc == 0 { return }
    }
    nn_moe_router_fwd(logits, ex_out, probs, y, T, E, C)
}

// HEXA-FUSION L3-d (GLUE-BLOCK megakernel · fwd glue block 2): the 3 adjacent
// device kernels _gelu2 (gelu ×2 experts) + _expert_pack2 (pack into ex_out) +
// _moe_router (softmax + weighted combine) fused into ONE device launch under
// HEXA_FUSE_MOE_BLOCK2 + CLM_PROD_DEVRESIDENT (3 launches -> 1, the grid-sync-free
// prefix of block 2 — groupnorm#2 stays separate, its full-y reduction needs a
// grid barrier). ex0/ex1/ex_out/probs written byte-for-byte so the bwd is
// UNCHANGED. OFF / device-fail → the 3 separate helpers run (byte-identical
// reference — same erf-gelu, same _moe_exp softmax, same sequential reductions,
// max|Δ|=0). The whole-step megakernel design (FULL = closed: FP64 hand-GEMM
// breaks byte-eq + roofline) reduces to this achievable GLUE-BLOCK form.
fn _moe_block2(eo0: int, eo1: int, logits: int, ex0: int, ex1: int, ex_out: int, probs: int, y: int, T: int, E: int, C: int) {
    if _fuse_on("HEXA_FUSE_MOE_BLOCK2") && _fuse_on("CLM_PROD_DEVRESIDENT") {
        let rc = forge_dispatch_moe_block2(eo0, eo1, logits, ex0, ex1, ex_out, probs, y, T, E, C)
        if rc == 0 { return }
    }
    _gelu2(eo0, ex0, eo1, ex1, T * C)
    _expert_pack2(ex0, ex1, ex_out, T * C)
    _moe_router(logits, ex_out, probs, y, T, E, C)
}

// HEXA-FUSION L3 (BWD glue half): device-resident elementwise GELU backward.
// dg[i] = da[i]·GELU'(g[i]) (g = pre-activation saved from fwd). gelu_bwd ×3 in
// clm_prod_bwd (deo0/deo1/dhn0) are the bwd MIRROR of the fwd gelu ×3 host glue —
// the bwd-tail counterpart of the ③ fwd-only 0% floor. Under CLM_PROD_DEVRESIDENT
// the grad runs on-device (forge_dispatch_gelu_bwd), keeping dg FARR_DEVICE so the
// follow-up conv-bwd GEMM H2D-skips it. erf/exp-based GELU' (cdf + x·pdf), pure
// elementwise (no reduction) → bit-exact to nn_gelu_bwd (max|Δ|=0). rc 0 = on
// device; else the proven host nn_gelu_bwd runs (byte-eq). Env-gated like _gelu.
fn _gelu_bwd(g: int, da: int, dg: int, n: int) {
    if _fuse_on("CLM_PROD_DEVRESIDENT") {
        let rc = forge_dispatch_gelu_bwd(g, da, dg, n)
        if rc == 0 { return }
    }
    nn_gelu_bwd(g, da, dg, n)
}

// HEXA-FUSION L3 (BWD glue half): device-resident GroupNorm backward.
// groupnorm_bwd ×2 in clm_prod_bwd (dy←dynorm, dh0←dhn0) are the bwd MIRROR of the
// fwd groupnorm ×2 host glue (per-channel + per-group reductions). Under
// CLM_PROD_DEVRESIDENT the grad runs on-device (forge_dispatch_groupnorm_bwd),
// keeping dgamma/dbeta/dx FARR_DEVICE so the follow-up conv-bwd / gelu_bwd
// H2D-skips them. The device kernel reduces SEQUENTIALLY (per-channel over t;
// per-group s1/s2 over t outer c inner) in the host order (NO tree re-assoc) and
// reads the SAVED forward inv (no sqrt re-derivation) → bit-exact to
// nn_groupnorm_bwd (max|Δ|=0). rc 0 = on device; else the proven host
// nn_groupnorm_bwd runs (byte-eq). Env-gated like _groupnorm.
fn _groupnorm_bwd(xhat: int, inv: int, gamma: int, dy: int,
                  dgamma: int, dbeta: int, dX: int, T: int, C: int, G: int) {
    if _fuse_on("CLM_PROD_DEVRESIDENT") {
        let rc = forge_dispatch_groupnorm_bwd(xhat, inv, gamma, dy, dgamma, dbeta, dX, T, C, G)
        if rc == 0 { return }
    }
    nn_groupnorm_bwd(xhat, inv, gamma, dy, dgamma, dbeta, dX, T, C, G)
}

// HEXA-FUSION L3 (BWD glue half): device-resident expert-unpack (residual grad
// split). dex0[i]=dex_out[0·n+i], dex1[i]=dex_out[1·n+i] for i in 0..n (n=T·d) —
// the bwd MIRROR of _expert_pack2, splitting the moe-router grad dex_out[E·T·d]
// back into the 2 per-expert grads. Under CLM_PROD_DEVRESIDENT it fuses onto the
// device (forge_dispatch_expert_unpack2), keeping dex0/dex1 FARR_DEVICE so the
// follow-up gelu_bwd H2D-skips them. Pure copy, NO reduction → bit-exact
// (max|Δ|=0). rc 0 = on device; else the byte-identical host unpack loop runs.
// Env-gated like _expert_pack2.
fn _expert_unpack2(dex_out: int, dex0: int, dex1: int, n: int) {
    if _fuse_on("CLM_PROD_DEVRESIDENT") {
        let rc = forge_dispatch_expert_unpack2(dex_out, dex0, dex1, n)
        if rc == 0 { return }
    }
    let mut i = 0
    while i < n {
        t_set(dex0, i, t_get(dex_out, 0 * n + i))
        t_set(dex1, i, t_get(dex_out, 1 * n + i))
        i = i + 1
    }
}

// HEXA-FUSION L3 (BWD glue half · ⑤-bwd2): device-resident CE softmax grad. The
// clm_ce_grad host glue (softmax-grad per position) at the head of the full-step
// driver — interpreted before clm_prod_bwd. Under CLM_PROD_DEVRESIDENT the grad
// runs on-device (forge_dispatch_ce_grad), keeping dlogits FARR_DEVICE so the
// first conv-bwd GEMM H2D-skips it. Per-row sequential (max + sum + writes).
// F-OP19: exp = the HAND-ROLLED dt_exp Taylor on BOTH host AND device (the GPU
// kernel replays _hx_dt_exp_dev term-for-term, the _moe_exp precedent) → bit-exact
// host↔device (max|Δ|=0) AND cross-platform deterministic (libm exp diverged
// arm64-macos vs x86-linux 1 ULP). rc 0 = on device; else the proven host loop
// runs (byte-eq). Env-gated like _gelu.
fn _ce_grad(logits: int, targets: int, dlogits_out: int, T: int, V: int) {
    if _fuse_on("CLM_PROD_DEVRESIDENT") {
        let rc = forge_dispatch_ce_grad(logits, targets, dlogits_out, T, V)
        if rc == 0 { return }
    }
    clm_ce_grad(logits, targets, dlogits_out, T, V)
}

// HEXA-FUSION L3 (BWD glue half · ⑤-bwd2): device-resident MoE-router backward.
// The nn_moe_router_bwd host glue in clm_prod_bwd (softmax-Jacobian + dex_out
// fill, 2-pass over E with inner C reduction). Under CLM_PROD_DEVRESIDENT it runs
// on-device (forge_dispatch_moe_router_bwd), keeping dlogits_r/dex_out
// FARR_DEVICE so the follow-up conv-bwd + expert-unpack H2D-skip them. Reads
// CACHED probs (NO _moe_exp replay) and reduces SEQUENTIALLY (Σ_c, Σ_e dot) in
// the host order (NO tree re-assoc) → bit-exact to nn_moe_router_bwd (max|Δ|=0).
// rc 0 = on device; else the proven host bwd runs (byte-eq). Env-gated like _moe_router.
fn _moe_router_bwd(probs: int, ex_out: int, dy: int, dlogits_out: int, dex_out: int,
                   T: int, E: int, C: int) {
    if _fuse_on("CLM_PROD_DEVRESIDENT") {
        let rc = forge_dispatch_moe_router_bwd(probs, ex_out, dy, dlogits_out, dex_out, T, E, C)
        if rc == 0 { return }
    }
    nn_moe_router_bwd(probs, ex_out, dy, dlogits_out, dex_out, T, E, C)
}

// HEXA-FUSION L3 (BWD glue half · ⑤-bwd2): device-resident 3-way grad sum. The
// dxt accumulation in clm_prod_bwd (dxt = dxt_r + dxt_e0 + dxt_e1 — the router +
// 2 expert dX paths). Under CLM_PROD_DEVRESIDENT it fuses onto the device
// (forge_dispatch_grad_sum3), keeping out FARR_DEVICE so the follow-up gelu_bwd
// H2D-skips it. Pure elementwise, fixed (a+b)+c association → bit-exact (max|Δ|=0).
// rc 0 = on device; else the byte-identical host sum loop runs. Env-gated.
fn _grad_sum3(a: int, b: int, c: int, out: int, n: int) {
    if _fuse_on("CLM_PROD_DEVRESIDENT") {
        let rc = forge_dispatch_grad_sum3(a, b, c, out, n)
        if rc == 0 { return }
    }
    let mut i = 0
    while i < n {
        t_set(out, i, t_get(a, i) + t_get(b, i) + t_get(c, i))
        i = i + 1
    }
}

// HEXA-FUSION L3 (BWD glue half · ⑤-bwd2): device-resident 2-way grad sum. The
// dxec accumulation in clm_prod_bwd (dxec = dxt + dxec_b). Under
// CLM_PROD_DEVRESIDENT it fuses onto the device (forge_dispatch_grad_sum2),
// keeping out FARR_DEVICE so the follow-up conv-bwd GEMM H2D-skips it. Pure
// elementwise → bit-exact (max|Δ|=0). rc 0 = on device; else the byte-identical
// host sum loop runs. Env-gated.
fn _grad_sum2(a: int, b: int, out: int, n: int) {
    if _fuse_on("CLM_PROD_DEVRESIDENT") {
        let rc = forge_dispatch_grad_sum2(a, b, out, n)
        if rc == 0 { return }
    }
    let mut i = 0
    while i < n {
        t_set(out, i, t_get(a, i) + t_get(b, i))
        i = i + 1
    }
}

// HEXA-FUSION L3 (BWD glue half · ⑤-bwd2): device-resident deterministic
// embedding scatter (grad accumulate into the table). The nn_embedding_bwd_scatter
// host glue at the tail of clm_prod_bwd (dembed[tok·d+c] += dxe[i·d+c]). Under
// CLM_PROD_DEVRESIDENT it fuses onto the device
// (forge_dispatch_embedding_bwd_scatter), keeping dembed FARR_DEVICE so the
// follow-up AdamW H2D-skips it. The device kernel uses ONE thread per vocab row
// scanning tokens in ascending-i order (NO atomics, NO tree re-assoc) →
// bit-exact to nn_embedding_bwd_scatter (max|Δ|=0). dtable must be pre-zeroed by
// the caller. rc 0 = on device; else the proven host scatter runs (byte-eq).
// Env-gated. NOTE the extra V param (vocab rows) the device kernel needs.
fn _embedding_bwd_scatter(dX: int, ids: int, dtable_inout: int, T: int, d: int, V: int) {
    if _fuse_on("CLM_PROD_DEVRESIDENT") {
        let rc = forge_dispatch_embedding_bwd_scatter(dX, ids, dtable_inout, T, d, V)
        if rc == 0 { return }
    }
    nn_embedding_bwd_scatter(dX, ids, dtable_inout, T, d)
}

// Forward with weight-only int4 QAT (verbatim from clm_qat assembly-3b).
// HEXA-FUSION B3 (REAL-TRAINER full-fwd MEGAKERNEL): wire the B2-proven
// `_hx_k_clm_megafwd` cooperative full-fwd megakernel (PR #2743, branch
// domain/hexa-fusion-b2-megafwd) into the REAL clm_prod_fwd path. Under
// env HEXA_CLM_MEGASTEP the WHOLE fwd DAG — GEMM1 → [groupnorm→gelu→residual]
// → GEMM2 → [gelu2→expert_pack→moe_router] — runs in ONE cudaLaunchCooperative
// Kernel persistent grid (intermediates device-resident across grid.sync(), no
// relaunch gap), instead of the eager per-op kernel sequence below. The host
// wrapper forge_dispatch_clm_megafwd marshals the FARR ids + shapes and routes
// to _hx_cuda_farr_clm_megafwd_gpu (the cooperative launcher emitted into
// runtime_cuda.c). It writes hn0/xhat0/inv0/eo0/eo1/probs/ex_out/yn/xhatN/invN
// byte-for-byte so clm_prod_bwd is UNCHANGED, then conv1d(yn→out_logits) is the
// final eager GEMM (kept outside the megakernel — same boundary as B2 fwd).
//
// ⚠ BYTE-EQ NOTE (the decisive structural gate): the megakernel pulls the conv
// GEMMs INSIDE the cooperative launch as TF32/own-GEMM tiles (a persistent kernel
// cannot nest cublasDgemm — F-FUSION-MEGAKERNEL-DESIGN WALL 1). The eager fwd
// uses FP64 cublasDgemm. So the megastep path is NOT max|Δ|=0 byte-eq to the
// eager FP64 path (rel-RMS ~1e-3, the TF32 own-GEMM bar). It is therefore gated
// SEPARATELY from CLM_PROD_DEVRESIDENT and returns rc != 0 (falls back to eager)
// unless the launcher explicitly asserts the own-GEMM precision-eq contract. The
// byte-eq-SAFE realization is the GLUE-ONLY megakernel (GEMMs kept as separate
// cublasDgemm launches) already built+fired+measured by P2A
// (F-FUSION-P2A-MEGAKERNEL.txt: real-step util 10.71→10.63%, Δ -0.08pp NOISE,
// byte-eq PASS). rc 0 = megakernel ran (out_logits + bwd intermediates filled);
// else the eager sequence runs (the byte-eq FP64 reference).
fn _clm_megafwd(xe: int, ecWq: int, ecB: int, tcWq: int, tcB: int,
                tgG: int, tgB: int, xec: int, hn0: int, hg0: int, xt: int,
                mean0: int, inv0: int, xhat0: int,
                rWq: int, rB: int, logits_r: int,
                e0Wq: int, e0B: int, e1Wq: int, e1B: int, eo0: int, eo1: int,
                ex_out: int, probs: int, y: int,
                noG: int, noB: int, yn: int, meanN: int, invN: int, xhatN: int,
                T: int, d: int, E: int, K: int) -> int {
    if _fuse_on("HEXA_CLM_MEGASTEP") {
        let rc = forge_dispatch_clm_megafwd(xe, ecWq, ecB, tcWq, tcB,
                                            tgG, tgB, xec, hn0, hg0, xt,
                                            mean0, inv0, xhat0,
                                            rWq, rB, logits_r,
                                            e0Wq, e0B, e1Wq, e1B, eo0, eo1,
                                            ex_out, probs, y,
                                            noG, noB, yn, meanN, invN, xhatN,
                                            T, d, E, K)
        if rc == 0 {
            return 0
        }
    }
    return -1
}

fn clm_prod_fwd(tokens: int,
               embed: int, ecW: int, ecB: int, tcW: int, tcB: int, tgG: int, tgB: int,
               rW: int, rB: int, e0W: int, e0B: int, e1W: int, e1B: int,
               noG: int, noB: int, roW: int, roB: int,
               ecWq: int, ecM: int, tcWq: int, tcM: int, e0Wq: int, e0M: int,
               e1Wq: int, e1M: int, rWq: int, rM: int, roWq: int, roM: int,
               xe: int, xec: int, xt: int, hn0: int, xhat0: int, inv0: int,
               eo0: int, eo1: int, probs: int, ex_out: int, yn: int, xhatN: int, invN: int,
               out_logits: int, T: int, d: int, E: int, V: int, K: int) {
    _fq(ecW, ecWq, ecM, d, d * K)
    _fq(tcW, tcWq, tcM, d, d * K)
    _fq(e0W, e0Wq, e0M, d, d * K)
    _fq(e1W, e1Wq, e1M, d, d * K)
    _fq(rW, rWq, rM, E, d)
    _fq(roW, roWq, roM, V, d)

    // HEXA-FUSION L3 (glue half · final ⑤c): embedding gather (tokens→xe) —
    // interpreted inter-op host glue at the fwd head. Device path keeps xe
    // FARR_DEVICE so the first conv GEMM H2D-skips it (byte-eq); else host loop.
    _embedding(tokens, embed, xe, T, d)

    // HEXA-FUSION B3: full-fwd MEGAKERNEL gate. Under HEXA_CLM_MEGASTEP the whole
    // fwd DAG (GEMM1 → [gn→gelu→resid] → GEMM2 → [gelu2→pack→router]) runs in ONE
    // cooperative launch; the bwd intermediates are written byte-for-byte. On
    // success only the final conv1d(yn→out_logits) GEMM remains. rc != 0 (gate
    // unset / device lacks coop launch / precision-eq not asserted) → eager path.
    let mega_hg0 = t_zeros(T * d)
    let mega_logits_r = t_zeros(T * E)
    let mega_mean0 = t_zeros(1)
    let mega_y = t_zeros(T * d)
    // HEXA-FUSION P1: groupnorm#2 is per-token (G=1 over D), so the megakernel
    // writes T mean/inv entries (not 1 like the whole-tensor groupnorm#1). The
    // launcher's _ensure_dev_alloc_out(meanN/invN, T) requires host len >= T.
    let mega_meanN = t_zeros(T)
    let mrc = _clm_megafwd(xe, ecWq, ecB, tcWq, tcB,
                           tgG, tgB, xec, hn0, mega_hg0, xt,
                           mega_mean0, inv0, xhat0,
                           rWq, rB, mega_logits_r,
                           e0Wq, e0B, e1Wq, e1B, eo0, eo1,
                           ex_out, probs, mega_y,
                           noG, noB, yn, mega_meanN, invN, xhatN,
                           T, d, E, K)
    if mrc == 0 {
        conv1d_via_forge(yn, roWq, roB, out_logits, T, d, V, 1, 1)
        return
    }

    conv1d_via_forge(xe, ecWq, ecB, xec, T, d, d, K, 1)
    let h0 = t_zeros(T * d)
    conv1d_via_forge(xec, tcWq, tcB, h0, T, d, d, K, 1)
    let mean0 = t_zeros(1)
    // HEXA-FUSION L3 (glue half): groupnorm #1 (h0→hn0) — interpreted inter-op
    // host glue with a per-group reduction. Device path keeps hn0/xhat0/inv0
    // FARR_DEVICE (byte-eq via sequential reduction + NR sqrt); else host loop.
    // HEXA-FUSION L3-a: groupnorm #1 → gelu #1 (h0→hn0→hg0) — the adjacent
    // GN→GELU pair fused into ONE device kernel under HEXA_FUSE_GN_GELU (occupancy
    // lever). hn0 (= pre-gelu GN) is still written for the bwd. OFF → the original
    // separate _groupnorm + _gelu run (byte-identical).
    let hg0 = t_zeros(T * d)
    // HEXA-FUSION L3-c: groupnorm #1 → gelu #1 → residual (h0→hn0→hg0, xt=xec+hg0)
    // fused into ONE device kernel under HEXA_FUSE_GN_GELU_RESID (occupancy lever —
    // collapses the groupnorm_gelu + residual_add launch pair into 1). hn0/hg0 are
    // still written byte-for-byte so the bwd is UNCHANGED. OFF → the separate
    // _groupnorm_gelu + _residual_add run (byte-identical). The residual xt = xec +
    // hg0 is the highest-frequency interpreted inter-op host glue in this fwd path.
    _groupnorm_gelu_residual(h0, tgG, tgB, xec, hn0, hg0, xt, mean0, inv0, xhat0, T, d, 1)
    let logits_r = t_zeros(T * E)
    conv1d_via_forge(xt, rWq, rB, logits_r, T, d, E, 1, 1)
    // LEVER (b): the 2 identical-shape ConvExperts fused into ONE batched GEMM
    // (byte-eq to the 2 separate conv1d_via_forge calls — F-CLM-CONV2-BATCHED-
    // FWD-EQ; on a CUDA host = 1 cublasDgemmStridedBatched vs 2 micro-launches).
    conv2_fwd_via_forge_batched(xt, e0Wq, e0B, e1Wq, e1B, eo0, eo1, T, d, d, K, 1)
    // HEXA-FUSION L3-b (op-boundary fusion): gelu #2/#3 (eo0→ex0, eo1→ex1, the 2
    // expert activations) — the 2 INDEPENDENT same-shape gelus fused into ONE
    // device launch under HEXA_FUSE_GELU2 + CLM_PROD_DEVRESIDENT (byte-eq); else
    // the two host _gelu calls (byte-eq reference).
    let ex0 = t_zeros(T * d); let ex1 = t_zeros(T * d)
    let y = t_zeros(T * d)
    // HEXA-FUSION L3-d (glue-block megakernel · block 2): gelu2 + expert_pack2 +
    // moe_router fused into ONE device launch under HEXA_FUSE_MOE_BLOCK2 (3 launches
    // -> 1, the grid-sync-free prefix of block 2). ex0/ex1/ex_out/probs/y written
    // byte-for-byte so the bwd is UNCHANGED. OFF → the 3 separate helpers run
    // (byte-identical: erf-gelu + hand-rolled _moe_exp softmax + sequential combine).
    _moe_block2(eo0, eo1, logits_r, ex0, ex1, ex_out, probs, y, T, E, d)
    let meanN = t_zeros(1)
    // HEXA-FUSION L3 (glue half): groupnorm #2 (norm_out, y→yn) — interpreted
    // inter-op host glue with a per-group reduction. Device path keeps
    // yn/xhatN/invN FARR_DEVICE (byte-eq); else host loop.
    _groupnorm(y, noG, noB, yn, meanN, invN, xhatN, T, d, 1)
    conv1d_via_forge(yn, roWq, roB, out_logits, T, d, V, 1, 1)
}

fn clm_ce_grad(logits: int, targets: int, dlogits_out: int, T: int, V: int) {
    let mut t = 0
    while t < T {
        let base = t * V
        let mut mx = t_get(logits, base)
        let mut i = 1
        while i < V { let v = t_get(logits, base + i); if v > mx { mx = v }; i = i + 1 }
        let mut sm = 0.0
        let mut i2 = 0
        // F-OP19 cross-platform fix: dt_exp (flame_math Taylor), NOT the libm `exp`
        // builtin. MEASURED (local+ghost arm64-macos vs aiden x86-linux, byte dump):
        // libm exp diverged 4/4096 grad elems by 1 ULP across arch/OS; dt_exp is
        // byte-IDENTICAL on all three. Trades "matches libm" for "matches across ALL
        // platforms" — the flame reproducibility-first identity (matches the CE-FWD
        // nn_ce_loss_allpos which already uses dt_exp). ~exp-Taylor-vs-libm ULPs.
        while i2 < V { sm = sm + dt_exp(t_get(logits, base + i2) - mx); i2 = i2 + 1 }
        let invT = 1.0 / to_float(T)
        let mut v3 = 0
        while v3 < V {
            let p = dt_exp(t_get(logits, base + v3) - mx) / sm
            t_set(dlogits_out, base + v3, p * invT)
            v3 = v3 + 1
        }
        let tgt = to_int(t_get(targets, t))
        t_set(dlogits_out, base + tgt, t_get(dlogits_out, base + tgt) - invT)
        t = t + 1
    }
}

// Backward with STE (verbatim from clm_qat assembly-3b).
fn clm_prod_bwd(dlogits: int, tokens: int,
               embed: int, ecWq: int, tcWq: int, tgG: int, rWq: int, e0Wq: int, e1Wq: int, noG: int, roWq: int,
               ecM: int, tcM: int, e0M: int, e1M: int, rM: int, roM: int,
               xe: int, xec: int, xt: int, hn0: int, xhat0: int, inv0: int,
               eo0: int, eo1: int, probs: int, ex_out: int, yn: int, xhatN: int, invN: int,
               dembed: int, decW: int, decB: int, dtcW: int, dtcB: int, dtgG: int, dtgB: int,
               drW: int, drB: int, de0W: int, de0B: int, de1W: int, de1B: int,
               dnoG: int, dnoB: int, droW: int, droB: int,
               T: int, d: int, E: int, V: int, K: int) {
    let dynorm = t_zeros(T * d)
    let droWq = t_zeros(V * d)
    conv1d_bwd_via_forge(yn, roWq, dlogits, droWq, dynorm, droB, T, d, V, 1, 1)
    _qbwd(droWq, roM, droW, V, d)
    let dy = t_zeros(T * d)
    // HEXA-FUSION L3 (BWD glue half): groupnorm_bwd #2 (norm_out, dynorm→dy) —
    // interpreted inter-op host glue (per-channel + per-group reductions), the bwd
    // mirror of the fwd groupnorm #2. Device path keeps dnoG/dnoB/dy FARR_DEVICE
    // (byte-eq via sequential reduction + saved inv); else host nn_groupnorm_bwd.
    _groupnorm_bwd(xhatN, invN, noG, dynorm, dnoG, dnoB, dy, T, d, 1)
    let dlogits_r = t_zeros(T * E)
    let dex_out = t_zeros(E * T * d)
    // HEXA-FUSION L3 (BWD glue half · ⑤-bwd2): moe-router bwd (probs/ex_out/dy →
    // dlogits_r/dex_out) — interpreted host glue (softmax-Jacobian + dex_out fill,
    // 2-pass over E with inner C reduction). Device path keeps dlogits_r/dex_out
    // FARR_DEVICE so the next conv-bwd + expert-unpack H2D-skip them (byte-eq via
    // sequential reduction + cached probs); else host nn_moe_router_bwd.
    _moe_router_bwd(probs, ex_out, dy, dlogits_r, dex_out, T, E, d)
    let dxt_r = t_zeros(T * d); let drWq = t_zeros(E * d)
    conv1d_bwd_via_forge(xt, rWq, dlogits_r, drWq, dxt_r, drB, T, d, E, 1, 1)
    _qbwd(drWq, rM, drW, E, d)
    // HEXA-FUSION L3 (BWD glue half): expert-unpack (dex_out→dex0/dex1) — the bwd
    // mirror of _expert_pack2 (T·d host t_get/t_set per step). Device path keeps
    // dex0/dex1 FARR_DEVICE so the next gelu_bwd H2D-skips them (byte-eq); else the
    // byte-identical host unpack loop.
    let dex0 = t_zeros(T * d); let dex1 = t_zeros(T * d)
    _expert_unpack2(dex_out, dex0, dex1, T * d)
    // HEXA-FUSION L3 (BWD glue half): gelu_bwd #1/#2 (eo0/dex0→deo0, eo1/dex1→deo1)
    // — the bwd mirror of the fwd gelu #2/#3 expert activations. Device path keeps
    // deo0/deo1 FARR_DEVICE (byte-eq, erf/exp grad); else host nn_gelu_bwd.
    let deo0 = t_zeros(T * d); _gelu_bwd(eo0, dex0, deo0, T * d)
    let deo1 = t_zeros(T * d); _gelu_bwd(eo1, dex1, deo1, T * d)
    // LEVER (b): the 2 ConvExperts' backward (dW + dX GEMMs) fused into batched
    // GEMMs (byte-eq to 2 separate conv1d_bwd_via_forge — F-CLM-CONV2-BATCHED-
    // BWD-EQ; on a CUDA host = 1 strided-batched launch per GEMM vs 2 each).
    let dxt_e0 = t_zeros(T * d); let de0Wq = t_zeros(d * d * K)
    let dxt_e1 = t_zeros(T * d); let de1Wq = t_zeros(d * d * K)
    conv2_bwd_via_forge_batched(xt, e0Wq, e1Wq, deo0, deo1,
                                de0Wq, dxt_e0, de0B, de1Wq, dxt_e1, de1B, T, d, d, K, 1)
    _qbwd(de0Wq, e0M, de0W, d, d * K)
    _qbwd(de1Wq, e1M, de1W, d, d * K)
    // HEXA-FUSION L3 (BWD glue half · ⑤-bwd2): dxt 3-way grad sum (dxt = dxt_r +
    // dxt_e0 + dxt_e1) — interpreted host glue. Device path keeps dxt FARR_DEVICE
    // so the next gelu_bwd H2D-skips it (byte-eq, fixed (a+b)+c association); else
    // the byte-identical host sum loop.
    let dxt = t_zeros(T * d)
    _grad_sum3(dxt_r, dxt_e0, dxt_e1, dxt, T * d)
    // HEXA-FUSION L3 (BWD glue half): gelu_bwd #3 (hn0/dxt→dhn0) — the bwd mirror
    // of the fwd gelu #1. Device path keeps dhn0 FARR_DEVICE (byte-eq); else host.
    let dhn0 = t_zeros(T * d); _gelu_bwd(hn0, dxt, dhn0, T * d)
    let dh0 = t_zeros(T * d)
    // HEXA-FUSION L3 (BWD glue half): groupnorm_bwd #1 (dhn0→dh0) — the bwd mirror
    // of the fwd groupnorm #1. Device path keeps dtgG/dtgB/dh0 FARR_DEVICE (byte-eq
    // via sequential reduction + saved inv); else host nn_groupnorm_bwd.
    _groupnorm_bwd(xhat0, inv0, tgG, dhn0, dtgG, dtgB, dh0, T, d, 1)
    let dxec_b = t_zeros(T * d); let dtcWq = t_zeros(d * d * K)
    conv1d_bwd_via_forge(xec, tcWq, dh0, dtcWq, dxec_b, dtcB, T, d, d, K, 1)
    _qbwd(dtcWq, tcM, dtcW, d, d * K)
    // HEXA-FUSION L3 (BWD glue half · ⑤-bwd2): dxec 2-way grad sum (dxec = dxt +
    // dxec_b) — interpreted host glue. Device path keeps dxec FARR_DEVICE so the
    // next conv-bwd GEMM H2D-skips it (byte-eq); else the byte-identical host loop.
    let dxec = t_zeros(T * d)
    _grad_sum2(dxt, dxec_b, dxec, T * d)
    let dxe = t_zeros(T * d); let decWq = t_zeros(d * d * K)
    conv1d_bwd_via_forge(xe, ecWq, dxec, decWq, dxe, decB, T, d, d, K, 1)
    _qbwd(decWq, ecM, decW, d, d * K)
    let mut zi = 0
    while zi < V * d { t_set(dembed, zi, 0.0); zi = zi + 1 }
    // HEXA-FUSION L3 (BWD glue half · ⑤-bwd2): embedding bwd scatter (dxe → dembed,
    // grad accumulate per token row) — interpreted host glue at the bwd tail. Device
    // path uses ONE thread per vocab row scanning tokens in ascending-i order (NO
    // atomics) so dembed stays FARR_DEVICE for the follow-up AdamW (byte-eq); else
    // host nn_embedding_bwd_scatter. dembed pre-zeroed just above (required).
    _embedding_bwd_scatter(dxe, tokens, dembed, T, d, V)
}

fn _adam(W: int, gW: int, m: int, v: int, n: int, t: int) {
    // LEVER (a): on-device AdamW under CLM_PROD_DEVFEED. forge_dispatch_adamw
    // routes to _hx_cuda_farr_adamw_step_inplace_gpu (byte-eq to the host oracle,
    // W/m/v device-resident — the optimizer step stops being a host scalar loop
    // between micro-GEMMs). rc 0 = applied on-device; -1 (no-CUDA / GPU fail) →
    // the proven host opt_adamw_step (byte-eq fallback). Engages only in the
    // self-host-rebuilt pod binary (env-gated so the prebuilt mac binary, which
    // lacks the builtin, never link-references it under `hexa run`).
    // residency-fix (DEVRESIDENT frozen-train): the device adamw path does NOT
    // propagate the W update when W is device-resident. Under CLM_PROD_DEVRESIDENT
    // the forward int4 fake-quant (_fq -> forge_dispatch_int4_quant) leaves the conv
    // weight W loc=FARR_DEVICE, dirty_host=0. The device adamw then updates W on the
    // device in place, but the next step's forward re-quant H2D-SKIPs W (device-
    // resident, dirty_host=0) and reads the SAME device buffer — so the optimizer
    // step never reaches the weights the forward consumes -> weights frozen -> no
    // learning (measured: step-1 fwd byte-eq REF, then flat ~4.80; the force-host-
    // adam bisect descends to REF). The host opt_adamw_step writes W on the HOST
    // (hexa_farr_set -> dirty_host=1), making W host-authoritative so the next
    // forward re-uploads it and the update lands. Route DEVRESIDENT to the proven
    // host optimizer (verified DEVRESIDENT epoch-3 mean CE 3.55084 == REF, vs the
    // frozen 4.80056 before). NOTE: drops the device-resident optimizer micro-opt
    // for DEVRESIDENT — re-enabling it is a perf follow-on needing the runtime to
    // mark W dirty_host=1 (or D2H it) after the device adamw. CLM_PROD_DEVFEED
    // (W host-resident) is unaffected and keeps its on-device adamw below.
    if _fuse_on("CLM_PROD_DEVFEED") {
        let rc = forge_dispatch_adamw(W, gW, m, v, n, 0.05, 0.9, 0.999, 0.00000001, 0.0, t)
        if rc == 0 { return }
    }
    opt_adamw_step(W, gW, m, v, n, 0.05, 0.9, 0.999, 0.00000001, 0.0, t)
}

// HEXA-FUSION M2 (FULL-STEP): fused cooperative AdamW over ALL params in ONE
// cudaLaunchCooperativeKernel. The clm_prod step ends with 18 separate _adam
// calls (each its own kernel launch + launch/sync gap with the host on the
// critical path). Under env HEXA_CLM_FULLSTEP, this packs the 18 param tensors'
// (W, grad, m, v) farr-ids + lengths into FIVE packed-id farrs and dispatches
// forge_dispatch_adamw_fused -> _hx_cuda_farr_adamw_fused_gpu, which collapses
// the whole optimizer tail into ONE cooperative launch (host off the critical
// path between every micro-update). Arithmetic is BYTE-IDENTICAL to the per-
// param _adam (same elementwise AdamW; shared step_t bias-correction). rc 0 =
// fused launch applied; rc != 0 (gate unset / no-CUDA / no-coop) -> the caller
// runs the per-param _adam loop (byte-eq reference). The packed-id farrs
// w_ids/m_ids/v_ids/g_ids/ns are pre-built ONCE by the caller (their contents
// are step-invariant — same tensors every step); only `t` changes per step.
fn _adam_fused(w_ids: int, g_ids: int, m_ids: int, v_ids: int, ns: int,
               np: int, t: int) -> int {
    if _fuse_on("HEXA_CLM_FULLSTEP") {
        let rc = forge_dispatch_adamw_fused(w_ids, m_ids, v_ids, g_ids, ns, np,
                                            0.05, 0.9, 0.999, 0.00000001, 0.0, t)
        if rc == 0 { return 0 }
    }
    return -1
}

// Load nsamp causal windows of length T from a byte corpus into IDS/TGT.
// IDS[s*T+p] = byte[off+p], TGT[s*T+p] = byte[off+p+1]; off = s*stride.
// Returns the number of windows actually filled (<= nsamp if corpus is short).
fn clm_corpus_windows(bytes_arr: int, n_bytes: int, IDS: int, TGT: int,
                      nsamp: int, T: int, stride: int) -> int {
    let mut filled = 0
    let mut s = 0
    while s < nsamp {
        let off = s * stride
        if off + T + 1 <= n_bytes {
            let mut p = 0
            while p < T {
                t_set(IDS, s * T + p, to_float(bytes_arr[off + p]))
                t_set(TGT, s * T + p, to_float(bytes_arr[off + p + 1]))
                p = p + 1
            }
            filled = filled + 1
        }
        s = s + 1
    }
    return filled
}

// ── .clm weight serialization (PR4 — mirrors clm_ckpt.hexa save format) ──
// Saves the 6 trained CLMConvMoE conv weights to the anima `.clm` format
// ("CLM\x01" magic + per-block int4-sym nibbles + per-channel fp32-le scale)
// so the trained model is a REAL, recoverable, sha256-verifiable artifact
// (a_fire_recover_complete: a printed CE descent with no saved weights = a
// lost model — this is the root fix). Path = env CLM_PROD_OUT (empty = skip).
fn _clmp_push_u32(buf, n: int) {
    buf.push(n & 0xFF); buf.push((n / 0x100) & 0xFF)
    buf.push((n / 0x10000) & 0xFF); buf.push((n / 0x1000000) & 0xFF)
}
fn _clmp_push_f32(buf, f: float) {
    let b = f32_to_bytes_le(f)
    let mut i = 0
    while i < 4 { buf.push(b[i]); i = i + 1 }
}
fn _clmp_save_block(buf, w: int, cout: int, rest: int) {
    // int4-sym quantize this trained weight -> integer codes (qlevel_out) +
    // per-channel fp32 scale. We pack the CODES (q in [-7,7], +8 offset),
    // identical to clm_ckpt.hexa::save_block (F-CLM-CKPT-ROUNDTRIP format).
    let wq_dq = t_zeros(cout * rest)   // dequant temp (discarded)
    let codes = t_zeros(cout * rest)   // integer qlevel codes (what we pack)
    let mask  = t_zeros(cout * rest)
    let scale = t_zeros(cout)
    nn_int4_quant_fwd(w, wq_dq, scale, codes, mask, cout, rest)
    _clmp_push_u32(buf, cout); _clmp_push_u32(buf, rest)
    let n = cout * rest
    let mut i = 0
    while i < n {
        let lo = (to_int(t_get(codes, i)) + 8) & 0xF
        let mut hi = 8
        if i + 1 < n { hi = (to_int(t_get(codes, i + 1)) + 8) & 0xF }
        buf.push(lo + hi * 16)
        i = i + 2
    }
    let mut c = 0
    while c < cout { _clmp_push_f32(buf, t_get(scale, c)); c = c + 1 }
}

// v0.2 EXT trailer (embed + conv biases + GN affine), full-precision fp32. The
// trained 6 conv blocks alone can NOT reproduce the GPU-measured descent CORE-
// side because the embed table + GroupNorm affine are absent; serializing them
// here (after the 6 v0.1 blocks, behind a "CLMX" magic) closes that format gap
// while keeping a v0.1 reader byte-eq (it stops after nblocks conv blocks).
fn _clmp_ext_begin(buf, n_ext: int) {
    buf.push(67); buf.push(76); buf.push(77); buf.push(88)   // EXT_MAGIC "CLMX"
    buf.push(n_ext)
}
fn _clmp_ext_save_entry(buf, t: int, n: int) {
    _clmp_push_u32(buf, n)
    let mut i = 0
    while i < n { _clmp_push_f32(buf, t_get(t, i)); i = i + 1 }
}

fn main() {
    println("clm_prod — CLMConvMoE production corpus loop (PR1)")
    // PR4: d / E / epochs / nsamp overridable via env for the H100 d768/12L
    // fire (CLM_PROD_D, CLM_PROD_E, CLM_PROD_EPOCHS, CLM_PROD_NSAMP). Empty
    // env keeps the tiny d=8 $0-CPU verify config (byte-eq back-compat).
    let _envd = env("CLM_PROD_D")
    let _enve = env("CLM_PROD_E")
    let _envn = env("CLM_PROD_NSAMP")
    let _envt = env("CLM_PROD_T")
    let d = if _envd == "" { 8 } else { to_int(_envd) }
    let E = if _enve == "" { 2 } else { to_int(_enve) }
    let nsamp = if _envn == "" { 8 } else { to_int(_envn) }
    // PERF-LEVER (c) — raise effective M. Every conv GEMM has M=T rows; at the
    // prior fire's T=24 the d768 conv→cuBLAS GEMMs were M=24 latency-bound micro-
    // ops (util RED PEAK=5%). T is a pure causal-window-length parameter (flows
    // identically through conv1d_via_forge / nn_ce_loss_allpos / clm_prod_bwd —
    // GRAD-EXACT, no math change), so raising it lifts M of EVERY forge GEMM and
    // amortizes the host im2col/col2im/adam feed over a longer sequence (fewer
    // steps per token budget). Env CLM_PROD_T overrides; empty keeps the byte-eq
    // T=24 verify config (back-compat).
    let Tw = if _envt == "" { 24 } else { to_int(_envt) }
    // HEXA-FUSION M5 (BATCH-FILL): true data-batch lever. The M2 full-step verdict
    // (F-FUSION-M2-FULLSTEP) pinned the util-low cause as a FILL problem — at
    // batch=1/D1536 the cooperative grid (≈528-660 blocks) UNDER-FILLS the H100's
    // 132 SMs. Every conv GEMM has M = (sequence length) rows; a true data-batch of
    // B independent windows stacks them into M = B*Tw rows, so a single launch's
    // grid grows ≈linearly with B and fills more SMs. CLM_PROD_BATCH=B concatenates
    // B consecutive DISTINCT windows per step into one length-(B*Tw) buffer; every
    // op is per-position (ConvMoE — no attention, no cross-position mixing except the
    // causal conv's K-1 receptive field, whose only effect is a tiny value perturbation
    // at the B-1 window seams that does NOT change any GEMM shape and keeps CE
    // descending). T below = the EFFECTIVE per-step sequence length = B*Tw, which
    // flows identically through conv1d / nn_ce_loss_allpos / clm_prod_bwd (the same
    // GRAD-EXACT path the T-lever already documents). B=1 = exact prior behavior.
    let _envb = env("CLM_PROD_BATCH")
    let B = if _envb == "" { 1 } else { to_int(_envb) }
    let T = Tw * B
    let V = 256; let K = 3
    let dd = d * d * K; let ed = E * d; let vd = V * d

    // ---- corpus → nsamp windows (in-repo fixture, repo-root relative) ----
    // cross-lingual-semantic corpus: 5 concept × 5 lang (en·zh·ru·ja·ko) PARALLEL-
    // aligned (Lab-11 / H_911 semantic-linkage; anima clm_p1.corpus.kosmos mirror).
    // stride spreads the nsamp windows across all 5 languages so the routed forge
    // forward learns the cross-lingual MEANING coupling, not a single-language head.
    // corpus path: env CLM_PROD_CORPUS overrides the in-repo fixture (PR4 real
    // anima .kosmos corpus); empty env keeps the byte-eq fixture (back-compat).
    let envp = env("CLM_PROD_CORPUS")
    let path = if envp == "" { "stdlib/flame/testdata/clm_semantic_parallel.txt" } else { envp }
    let bytes_arr = read_file_bytes(path)
    let n_bytes = len(bytes_arr)
    // stride spans the WHOLE corpus so the nsamp windows are spread across every
    // language section (multilingual: en·zh·ru·ja·ko), not just the head.
    // windows are built at the BASE window length Tw (one causal sequence each);
    // the per-step batch concatenates B of them into the effective length T = B*Tw.
    let mut stride = (n_bytes - Tw - 1) / nsamp
    if stride < 1 { stride = 1 }
    print("  corpus: "); print(path); print("  ("); print(n_bytes); println(" bytes, V=256)")
    let IDS = t_zeros(nsamp * Tw)
    let TGT = t_zeros(nsamp * Tw)
    let nwin = clm_corpus_windows(bytes_arr, n_bytes, IDS, TGT, nsamp, Tw, stride)
    print("  windows: "); print(nwin); print("/"); print(nsamp)
    print("  (Tw="); print(Tw); print(" B="); print(B); print(" T_eff="); print(T)
    print(" stride="); print(stride); println(")")
    if nwin < 2 { println("F-CLM-PROD-DESCENT = 0"); println("FAIL — corpus too short"); return }
    if nwin < B { println("F-CLM-PROD-DESCENT = 0"); println("FAIL — fewer windows than batch B"); return }

    // ---- weights (LCG init, same scheme as clm_qat) ----
    let embed=t_zeros(vd); t_fill_lcg(embed, vd, 1, 0.3)
    let ecW=t_zeros(dd); t_fill_lcg(ecW, dd, 2, 0.2); let ecB=t_zeros(d); t_fill_lcg(ecB, d, 3, 0.1)
    let tcW=t_zeros(dd); t_fill_lcg(tcW, dd, 4, 0.2); let tcB=t_zeros(d); t_fill_lcg(tcB, d, 5, 0.1)
    let tgG=t_zeros(d); t_fill_lcg(tgG, d, 6, 0.5); let tgB=t_zeros(d); t_fill_lcg(tgB, d, 7, 0.1)
    let rW=t_zeros(ed); t_fill_lcg(rW, ed, 12, 0.2); let rB=t_zeros(E); t_fill_lcg(rB, E, 13, 0.1)
    let e0W=t_zeros(dd); t_fill_lcg(e0W, dd, 14, 0.2); let e0B=t_zeros(d); t_fill_lcg(e0B, d, 15, 0.1)
    let e1W=t_zeros(dd); t_fill_lcg(e1W, dd, 16, 0.2); let e1B=t_zeros(d); t_fill_lcg(e1B, d, 17, 0.1)
    let noG=t_zeros(d); t_fill_lcg(noG, d, 18, 0.5); let noB=t_zeros(d); t_fill_lcg(noB, d, 19, 0.1)
    let roW=t_zeros(vd); t_fill_lcg(roW, vd, 20, 0.2); let roB=t_zeros(V); t_fill_lcg(roB, V, 21, 0.1)

    // grads
    let dembed=t_zeros(vd); let decW=t_zeros(dd); let decB=t_zeros(d)
    let dtcW=t_zeros(dd); let dtcB=t_zeros(d); let dtgG=t_zeros(d); let dtgB=t_zeros(d)
    let drW=t_zeros(ed); let drB=t_zeros(E)
    let de0W=t_zeros(dd); let de0B=t_zeros(d); let de1W=t_zeros(dd); let de1B=t_zeros(d)
    let dnoG=t_zeros(d); let dnoB=t_zeros(d); let droW=t_zeros(vd); let droB=t_zeros(V)
    // adam state
    let m_embed=t_zeros(vd); let v_embed=t_zeros(vd)
    let m_ecW=t_zeros(dd); let v_ecW=t_zeros(dd); let m_ecB=t_zeros(d); let v_ecB=t_zeros(d)
    let m_tcW=t_zeros(dd); let v_tcW=t_zeros(dd); let m_tcB=t_zeros(d); let v_tcB=t_zeros(d)
    let m_tgG=t_zeros(d); let v_tgG=t_zeros(d); let m_tgB=t_zeros(d); let v_tgB=t_zeros(d)
    let m_rW=t_zeros(ed); let v_rW=t_zeros(ed); let m_rB=t_zeros(E); let v_rB=t_zeros(E)
    let m_e0W=t_zeros(dd); let v_e0W=t_zeros(dd); let m_e0B=t_zeros(d); let v_e0B=t_zeros(d)
    let m_e1W=t_zeros(dd); let v_e1W=t_zeros(dd); let m_e1B=t_zeros(d); let v_e1B=t_zeros(d)
    let m_noG=t_zeros(d); let v_noG=t_zeros(d); let m_noB=t_zeros(d); let v_noB=t_zeros(d)
    let m_roW=t_zeros(vd); let v_roW=t_zeros(vd); let m_roB=t_zeros(V); let v_roB=t_zeros(V)
    // q-weight + mask caches
    let ecWq=t_zeros(dd); let ecM=t_zeros(dd); let tcWq=t_zeros(dd); let tcM=t_zeros(dd)
    let e0Wq=t_zeros(dd); let e0M=t_zeros(dd); let e1Wq=t_zeros(dd); let e1M=t_zeros(dd)
    let rWq=t_zeros(ed); let rM=t_zeros(ed); let roWq=t_zeros(vd); let roM=t_zeros(vd)
    // act caches (T-sized)
    let xe=t_zeros(T*d); let xec=t_zeros(T*d); let xt=t_zeros(T*d)
    let hn0=t_zeros(T*d); let xhat0=t_zeros(T*d); let inv0=t_zeros(1)
    let eo0=t_zeros(T*d); let eo1=t_zeros(T*d); let probs=t_zeros(T*E); let ex_out=t_zeros(E*T*d)
    let yn=t_zeros(T*d); let xhatN=t_zeros(T*d); let invN=t_zeros(T)
    let logits=t_zeros(T*V); let dlogits=t_zeros(T*V)
    // per-step window buffers
    let tok=t_zeros(T); let tgt=t_zeros(T)

    // HEXA-FUSION M2 (FULL-STEP): pack the 18 param tensors' (W, grad, m, v)
    // farr-ids + lengths into FIVE packed-id farrs (built ONCE — the tensor set
    // is step-invariant). Under env HEXA_CLM_FULLSTEP the step's optimizer tail
    // (18 separate _adam launches) collapses into ONE cooperative AdamW launch
    // (_adam_fused → forge_dispatch_adamw_fused). Ids stored as doubles; the C
    // wrapper reads them back and builds the device pointer table. NOTE: the
    // ROUTER bias rB (E) and the LCG-init E=2 → tiny tensors are included — the
    // fused kernel grid-strides over their concatenation, so heterogeneous
    // lengths are handled by the prefix-offset lookup (byte-eq per element).
    let _NP = 17
    let fs_w  = t_zeros(_NP); let fs_g  = t_zeros(_NP)
    let fs_m  = t_zeros(_NP); let fs_v  = t_zeros(_NP); let fs_n = t_zeros(_NP)
    t_set(fs_w,0,to_float(embed)); t_set(fs_g,0,to_float(dembed)); t_set(fs_m,0,to_float(m_embed)); t_set(fs_v,0,to_float(v_embed)); t_set(fs_n,0,to_float(vd))
    t_set(fs_w,1,to_float(ecW));   t_set(fs_g,1,to_float(decW));   t_set(fs_m,1,to_float(m_ecW));   t_set(fs_v,1,to_float(v_ecW));   t_set(fs_n,1,to_float(dd))
    t_set(fs_w,2,to_float(ecB));   t_set(fs_g,2,to_float(decB));   t_set(fs_m,2,to_float(m_ecB));   t_set(fs_v,2,to_float(v_ecB));   t_set(fs_n,2,to_float(d))
    t_set(fs_w,3,to_float(tcW));   t_set(fs_g,3,to_float(dtcW));   t_set(fs_m,3,to_float(m_tcW));   t_set(fs_v,3,to_float(v_tcW));   t_set(fs_n,3,to_float(dd))
    t_set(fs_w,4,to_float(tcB));   t_set(fs_g,4,to_float(dtcB));   t_set(fs_m,4,to_float(m_tcB));   t_set(fs_v,4,to_float(v_tcB));   t_set(fs_n,4,to_float(d))
    t_set(fs_w,5,to_float(tgG));   t_set(fs_g,5,to_float(dtgG));   t_set(fs_m,5,to_float(m_tgG));   t_set(fs_v,5,to_float(v_tgG));   t_set(fs_n,5,to_float(d))
    t_set(fs_w,6,to_float(tgB));   t_set(fs_g,6,to_float(dtgB));   t_set(fs_m,6,to_float(m_tgB));   t_set(fs_v,6,to_float(v_tgB));   t_set(fs_n,6,to_float(d))
    t_set(fs_w,7,to_float(rW));    t_set(fs_g,7,to_float(drW));    t_set(fs_m,7,to_float(m_rW));    t_set(fs_v,7,to_float(v_rW));    t_set(fs_n,7,to_float(ed))
    t_set(fs_w,8,to_float(rB));    t_set(fs_g,8,to_float(drB));    t_set(fs_m,8,to_float(m_rB));    t_set(fs_v,8,to_float(v_rB));    t_set(fs_n,8,to_float(E))
    t_set(fs_w,9,to_float(e0W));   t_set(fs_g,9,to_float(de0W));   t_set(fs_m,9,to_float(m_e0W));   t_set(fs_v,9,to_float(v_e0W));   t_set(fs_n,9,to_float(dd))
    t_set(fs_w,10,to_float(e0B));  t_set(fs_g,10,to_float(de0B));  t_set(fs_m,10,to_float(m_e0B));  t_set(fs_v,10,to_float(v_e0B));  t_set(fs_n,10,to_float(d))
    t_set(fs_w,11,to_float(e1W));  t_set(fs_g,11,to_float(de1W));  t_set(fs_m,11,to_float(m_e1W));  t_set(fs_v,11,to_float(v_e1W));  t_set(fs_n,11,to_float(dd))
    t_set(fs_w,12,to_float(e1B));  t_set(fs_g,12,to_float(de1B));  t_set(fs_m,12,to_float(m_e1B));  t_set(fs_v,12,to_float(v_e1B));  t_set(fs_n,12,to_float(d))
    t_set(fs_w,13,to_float(noG));  t_set(fs_g,13,to_float(dnoG));  t_set(fs_m,13,to_float(m_noG));  t_set(fs_v,13,to_float(v_noG));  t_set(fs_n,13,to_float(d))
    t_set(fs_w,14,to_float(noB));  t_set(fs_g,14,to_float(dnoB));  t_set(fs_m,14,to_float(m_noB));  t_set(fs_v,14,to_float(v_noB));  t_set(fs_n,14,to_float(d))
    t_set(fs_w,15,to_float(roW));  t_set(fs_g,15,to_float(droW));  t_set(fs_m,15,to_float(m_roW));  t_set(fs_v,15,to_float(v_roW));  t_set(fs_n,15,to_float(vd))
    t_set(fs_w,16,to_float(roB));  t_set(fs_g,16,to_float(droB));  t_set(fs_m,16,to_float(m_roB));  t_set(fs_v,16,to_float(v_roB));  t_set(fs_n,16,to_float(V))
    // 17 distinct param tensors (slots 0..16). The fused kernel applies AdamW to
    // each EXACTLY ONCE — byte-eq to the 17 per-param _adam calls below.

    // ---- round-robin multi-window loop; epochs full passes over nwin ----
    let _enve2 = env("CLM_PROD_EPOCHS")
    let epochs = if _enve2 == "" { 12 } else { to_int(_enve2) }
    // M5: one STEP now processes one BATCH of B windows. nbatch = floor(nwin / B)
    // batches per epoch (B=1 → nbatch=nwin → exact prior behavior). Each step fills
    // the length-T=B*Tw buffer with B distinct consecutive windows (wrap-around).
    let mut nbatch = nwin / B
    if nbatch < 1 { nbatch = 1 }
    let steps = epochs * nbatch
    let mut sum_first = 0.0
    let mut sum_last = 0.0
    let mut step = 1
    while step <= steps {
        // batch start window index (round-robin over the nbatch batches)
        let b0 = ((step - 1) % nbatch) * B
        let mut bj = 0
        while bj < B {
            let w = (b0 + bj) % nwin
            let mut q = 0
            while q < Tw {
                t_set(tok, bj * Tw + q, t_get(IDS, w * Tw + q))
                t_set(tgt, bj * Tw + q, t_get(TGT, w * Tw + q))
                q = q + 1
            }
            bj = bj + 1
        }
        clm_prod_fwd(tok, embed, ecW, ecB, tcW, tcB, tgG, tgB, rW, rB,
                    e0W, e0B, e1W, e1B, noG, noB, roW, roB,
                    ecWq, ecM, tcWq, tcM, e0Wq, e0M, e1Wq, e1M, rWq, rM, roWq, roM,
                    xe, xec, xt, hn0, xhat0, inv0, eo0, eo1, probs, ex_out, yn, xhatN, invN,
                    logits, T, d, E, V, K)
        let loss = nn_ce_loss_allpos(logits, tgt, T, V)
        if step <= nbatch { sum_first = sum_first + loss }
        if step > steps - nbatch { sum_last = sum_last + loss }
        // HEXA-FUSION L3 (BWD glue half · ⑤-bwd2): CE softmax grad (logits/tgt →
        // dlogits) — interpreted host glue at the head of the bwd. Device path keeps
        // dlogits FARR_DEVICE so clm_prod_bwd's first conv-bwd GEMM H2D-skips it
        // (byte-eq via per-row sequential softmax-grad + libm exp); else host clm_ce_grad.
        _ce_grad(logits, tgt, dlogits, T, V)
        clm_prod_bwd(dlogits, tok, embed, ecWq, tcWq, tgG, rWq, e0Wq, e1Wq, noG, roWq,
                    ecM, tcM, e0M, e1M, rM, roM,
                    xe, xec, xt, hn0, xhat0, inv0, eo0, eo1, probs, ex_out, yn, xhatN, invN,
                    dembed, decW, decB, dtcW, dtcB, dtgG, dtgB, drW, drB, de0W, de0B, de1W, de1B,
                    dnoG, dnoB, droW, droB, T, d, E, V, K)
        // HEXA-FUSION M2 (FULL-STEP): collapse the 17 per-param AdamW launches
        // into ONE cooperative launch under HEXA_CLM_FULLSTEP. rc 0 = fused
        // applied (optimizer tail off the host critical path); else the per-param
        // _adam loop runs (byte-eq reference).
        let _fs_rc = _adam_fused(fs_w, fs_g, fs_m, fs_v, fs_n, _NP, step)
        if _fs_rc != 0 {
        _adam(embed, dembed, m_embed, v_embed, vd, step)
        _adam(ecW, decW, m_ecW, v_ecW, dd, step); _adam(ecB, decB, m_ecB, v_ecB, d, step)
        _adam(tcW, dtcW, m_tcW, v_tcW, dd, step); _adam(tcB, dtcB, m_tcB, v_tcB, d, step)
        _adam(tgG, dtgG, m_tgG, v_tgG, d, step);  _adam(tgB, dtgB, m_tgB, v_tgB, d, step)
        _adam(rW, drW, m_rW, v_rW, ed, step);     _adam(rB, drB, m_rB, v_rB, E, step)
        _adam(e0W, de0W, m_e0W, v_e0W, dd, step); _adam(e0B, de0B, m_e0B, v_e0B, d, step)
        _adam(e1W, de1W, m_e1W, v_e1W, dd, step); _adam(e1B, de1B, m_e1B, v_e1B, d, step)
        _adam(noG, dnoG, m_noG, v_noG, d, step);  _adam(noB, dnoB, m_noB, v_noB, d, step)
        _adam(roW, droW, m_roW, v_roW, vd, step); _adam(roB, droB, m_roB, v_roB, V, step)
        }
        step = step + 1
    }
    let first_ce = sum_first / to_float(nbatch)
    let last_ce = sum_last / to_float(nbatch)
    print("  epoch-1 mean CE = "); println(to_string(first_ce))
    print("  epoch-"); print(epochs); print(" mean CE = "); println(to_string(last_ce))
    // M5 batch-fill diagnostic — verbatim so the util run can correlate util vs B.
    print("  [M5-BATCH] B="); print(B); print(" Tw="); print(Tw);
    print(" T_eff="); print(T); print(" nbatch="); print(nbatch);
    print(" steps="); print(steps); println("")

    // ---- PR4: serialize the 6 trained CLMConvMoE conv weights to .clm ----
    // (a_fire_recover_complete) — the trained model is now a real artifact.
    let _outp = env("CLM_PROD_OUT")
    if _outp != "" {
        let buf = []
        buf.push(67); buf.push(76); buf.push(77); buf.push(1)   // MAGIC "CLM\x01"
        buf.push(6)                                              // nblocks
        // block order + (cout, rest) mirror clm_ckpt.hexa exactly:
        //   ecW/tcW/e0W/e1W : (d, d*K)   rW : (E, d)   roW : (V, d)
        _clmp_save_block(buf, ecW, d, d * K)
        _clmp_save_block(buf, tcW, d, d * K)
        _clmp_save_block(buf, e0W, d, d * K)
        _clmp_save_block(buf, e1W, d, d * K)
        _clmp_save_block(buf, rW,  E, d)
        _clmp_save_block(buf, roW, V, d)
        // v0.2 EXT trailer — trained embed table + conv biases + GN affine, stored
        // FULL-PRECISION fp32 (descent-critical, small). Order MUST match
        // clm_ckpt.hexa header + the CORE decoder (generator.hexa::clm_decode_ce):
        //   0 embed[V·d] 1 ecB 2 tcB 3 e0B 4 e1B 5 rB 6 roB 7 tgG 8 tgB 9 noG 10 noB
        // BACKWARD-COMPAT: appended AFTER the 6 v0.1 conv blocks; a v0.1 reader
        // reads exactly nblocks=6 and never sees these bytes (byte-eq old path).
        _clmp_ext_begin(buf, 11)
        _clmp_ext_save_entry(buf, embed, vd)
        _clmp_ext_save_entry(buf, ecB, d)
        _clmp_ext_save_entry(buf, tcB, d)
        _clmp_ext_save_entry(buf, e0B, d)
        _clmp_ext_save_entry(buf, e1B, d)
        _clmp_ext_save_entry(buf, rB, E)
        _clmp_ext_save_entry(buf, roB, V)
        _clmp_ext_save_entry(buf, tgG, d)
        _clmp_ext_save_entry(buf, tgB, d)
        _clmp_ext_save_entry(buf, noG, d)
        _clmp_ext_save_entry(buf, noB, d)
        write_bytes(_outp, buf)
        print("  CLM_PROD_OUT wrote "); print(_outp); print("  (")
        print(len(buf)); println(" bytes, 6 blocks + v0.2 ext[embed+bias+GN], CLM\\x01+CLMX)")
        print("  config d="); print(d); print(" E="); print(E)
        print(" epochs="); print(epochs); print(" nwin="); print(nwin); println("")
    }

    if last_ce < first_ce {
        println("F-CLM-PROD-DESCENT = 1")
        println("PASS — real-corpus mean CE descends under int4 envelope")
        return
    }
    println("F-CLM-PROD-DESCENT = 0")
    println("FAIL")
}
