// ════════════════════════════════════════════════════════════════════════════
//  clm_step_determinism_eq.hexa — F-OP15 INTEGRATION byte-eq determinism ORACLE.
//
//  HEXA-0POD OP-15: CPU-LOCAL (`hexa run`, 0-GPU) COMPOSITION-level reproducibility
//  proof for the flame CLMConvMoE micro train-step. The OP-2/7/8/9/10/11/12/13 series
//  locked each PER-OP identity bit-exactly; what is NOT yet locked is the COMPOSITION —
//  that the FULL step (embed → conv → GroupNorm → MoE → CE → backward → AdamW), with
//  ALL its state threading (cache buffers, optimizer m/v carry, deterministic init),
//  produces BYTE-IDENTICAL post-step state when run TWICE from the same seed.
//
//  Per-op oracles can ALL pass while a composition bug — uninitialized scratch, a
//  non-deterministic iteration over a dict/set, an address-dependent ordering — still
//  breaks run-to-run determinism. OP-15 is the end-to-end guard the per-op oracles
//  cannot give: it runs the SAME composed micro-step TWICE from the SAME init and
//  asserts max|Δ| = 0 over EVERY post-step parameter, EVERY optimizer m/v buffer, AND
//  the loss scalar.
//
//  ── SCOPE (the composed sub-sequence locked) ─────────────────────────────────────
//  The EXACT composed step from stdlib/flame/clm_step.hexa main() — the CLMConvMoE QAT
//  train-step assembly 3a, verified #2294/#2302:
//      clm_fwd_full  : embed → conv(ec) → conv(tc) → GroupNorm(tg) → GELU → residual →
//                      conv(router) + conv(e0)/conv(e1) → GELU×2 → MoE router combine →
//                      GroupNorm(no) → conv(ro) → logits
//      nn_ce_loss_allpos : all-position CE loss
//      clm_ce_grad   : softmax-gradient seed dlogits
//      clm_bwd       : the full reverse chain (conv_bwd · groupnorm_bwd · moe_router_bwd
//                      · gelu_bwd · embedding scatter-add) writing every param grad
//      _adam (opt_adamw_step) on ALL 17 parameter tensors → W', m', v' in place
//  ONE full micro-step (fwd→loss→bwd→AdamW over every param). This is the LARGEST
//  composed sub-sequence — the complete step — and it runs on CPU in `hexa run`.
//
//  ── why this harness inlines GroupNorm (gn_lib NOT imported) ──────────────────────
//  gn_lib's nn_gn_gelu_fused_off references the GPU forge dispatch symbol
//  forge_dispatch_groupnorm_gelu, which is host-undefined on the 0-GPU `hexa run` link
//  path (it only resolves in a CUDA build). Importing gn_lib therefore fails to LINK
//  locally. So this oracle imports the cleanly-linking production libs (conv_lib,
//  moe_lib, nn_lib, optim_lib) DIRECTLY and inlines ONLY GroupNorm fwd/bwd as _gn_fwd /
//  _gn_bwd — byte-identical copies of gn_lib nn_groupnorm_fwd / nn_groupnorm_bwd
//  (same eps=1e-5, same 40-iter Newton _gn_sqrt, same (t,c) reduction order). The
//  composition determinism property OP-15 locks does not depend on the fused kernel;
//  the unfused CPU GroupNorm is the production reference path anyway (gn_lib runs it
//  byte-eq when HEXA_FUSE_GN_GELU is off — the default).
//
//  ── GATE (g5) ────────────────────────────────────────────────────────────────────
//  max|Δ(W', W'')| = 0 AND max|Δ(m', m'')| = 0 AND max|Δ(v', v'')| = 0 AND
//  loss' === loss''  — RUN-TO-RUN determinism of the COMPOSED step, NO tolerance.
//  A clean max|Δ|=0 proves the composition is deterministic. A nonzero Δ is a REAL
//  composition-determinism defect (the bug-class the per-op oracles miss) — reported
//  honestly, not faked.
//
//  F-OP15-STEP-DETERMINISM : composed micro-step byte-identical run-to-run.
// ════════════════════════════════════════════════════════════════════════════════

use "stdlib/flame/tensor_lib"
use "stdlib/flame/conv_lib"
use "stdlib/flame/moe_lib"
use "stdlib/flame/nn_lib"
use "stdlib/flame/optim_lib"

fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x }; return x }

// ── GroupNorm fwd/bwd — byte-identical mirror of gn_lib nn_groupnorm_fwd /
//    nn_groupnorm_bwd (inlined so gn_lib's GPU-forge symbol is not link-pulled). ──
fn _gn_sqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x
    let mut i = 0
    while i < 40 { g = 0.5 * (g + x / g); i = i + 1 }
    return g
}

fn _gn_fwd(x: int, gamma: int, beta: int,
           y_out: int, mean_out: int, inv_out: int, xhat_out: int,
           T: int, C: int, G: int) {
    let eps = 0.00001
    let cg = C / G
    let m = to_float(cg * T)
    let mut g = 0
    while g < G {
        let c0 = g * cg
        let mut sum = 0.0
        let mut t = 0
        while t < T {
            let mut c = 0
            while c < cg { sum = sum + t_get(x, t * C + (c0 + c)); c = c + 1 }
            t = t + 1
        }
        let mu = sum / m
        let mut vs = 0.0
        let mut t2 = 0
        while t2 < T {
            let mut c2 = 0
            while c2 < cg {
                let d = t_get(x, t2 * C + (c0 + c2)) - mu
                vs = vs + d * d
                c2 = c2 + 1
            }
            t2 = t2 + 1
        }
        let var = vs / m
        let inv = 1.0 / _gn_sqrt(var + eps)
        t_set(mean_out, g, mu)
        t_set(inv_out, g, inv)
        let mut t3 = 0
        while t3 < T {
            let mut c3 = 0
            while c3 < cg {
                let ch = c0 + c3
                let xh = (t_get(x, t3 * C + ch) - mu) * inv
                t_set(xhat_out, t3 * C + ch, xh)
                t_set(y_out, t3 * C + ch, t_get(gamma, ch) * xh + t_get(beta, ch))
                c3 = c3 + 1
            }
            t3 = t3 + 1
        }
        g = g + 1
    }
}

fn _gn_bwd(xhat: int, inv: int, gamma: int, dy: int,
           dgamma_out: int, dbeta_out: int, dX_out: int,
           T: int, C: int, G: int) {
    let cg = C / G
    let m = to_float(cg * T)
    let mut c = 0
    while c < C {
        let mut sg = 0.0
        let mut sb = 0.0
        let mut t = 0
        while t < T {
            let idx = t * C + c
            let gy = t_get(dy, idx)
            sg = sg + gy * t_get(xhat, idx)
            sb = sb + gy
            t = t + 1
        }
        t_set(dgamma_out, c, sg)
        t_set(dbeta_out, c, sb)
        c = c + 1
    }
    let mut g = 0
    while g < G {
        let c0 = g * cg
        let inv_g = t_get(inv, g)
        let mut s1 = 0.0
        let mut s2 = 0.0
        let mut t = 0
        while t < T {
            let mut cc = 0
            while cc < cg {
                let ch = c0 + cc
                let idx = t * C + ch
                let dxh = t_get(dy, idx) * t_get(gamma, ch)
                s1 = s1 + dxh
                s2 = s2 + dxh * t_get(xhat, idx)
                cc = cc + 1
            }
            t = t + 1
        }
        let mut t2 = 0
        while t2 < T {
            let mut cc2 = 0
            while cc2 < cg {
                let ch = c0 + cc2
                let idx = t2 * C + ch
                let dxh = t_get(dy, idx) * t_get(gamma, ch)
                let dx = inv_g * (dxh - s1 / m - t_get(xhat, idx) * s2 / m)
                t_set(dX_out, idx, dx)
                cc2 = cc2 + 1
            }
            t2 = t2 + 1
        }
        g = g + 1
    }
}

// ── clm_fwd_full — verbatim from clm_step.hexa (gn calls → inlined _gn_fwd) ──
fn clm_fwd_full(tokens: int,
                embed: int, ecW: int, ecB: int, tcW: int, tcB: int, tgG: int, tgB: int,
                rW: int, rB: int, e0W: int, e0B: int, e1W: int, e1B: int,
                noG: int, noB: int, roW: int, roB: int,
                xe: int, xec: int, xt: int, hn0: int, xhat0: int, inv0: int,
                eo0: int, eo1: int, probs: int, ex_out: int, yn: int, xhatN: int, invN: int,
                out_logits: int, T: int, d: int, E: int, V: int, K: int) {
    nn_embedding_fwd(tokens, embed, xe, T, d)
    nn_conv1d_fwd(xe, ecW, ecB, xec, T, d, d, K, 1)
    let h0 = t_zeros(T * d)
    nn_conv1d_fwd(xec, tcW, tcB, h0, T, d, d, K, 1)
    let mean0 = t_zeros(1)
    _gn_fwd(h0, tgG, tgB, hn0, mean0, inv0, xhat0, T, d, 1)
    let hg0 = t_zeros(T * d); nn_gelu_fwd(hn0, hg0, T * d)
    let mut i = 0
    while i < T * d { t_set(xt, i, t_get(xec, i) + t_get(hg0, i)); i = i + 1 }
    let logits_r = t_zeros(T * E)
    nn_conv1d_fwd(xt, rW, rB, logits_r, T, d, E, 1, 1)
    nn_conv1d_fwd(xt, e0W, e0B, eo0, T, d, d, K, 1)
    nn_conv1d_fwd(xt, e1W, e1B, eo1, T, d, d, K, 1)
    let ex0 = t_zeros(T * d); nn_gelu_fwd(eo0, ex0, T * d)
    let ex1 = t_zeros(T * d); nn_gelu_fwd(eo1, ex1, T * d)
    let mut j = 0
    while j < T * d {
        t_set(ex_out, 0 * T * d + j, t_get(ex0, j))
        t_set(ex_out, 1 * T * d + j, t_get(ex1, j))
        j = j + 1
    }
    let y = t_zeros(T * d)
    nn_moe_router_fwd(logits_r, ex_out, probs, y, T, E, d)
    let meanN = t_zeros(1)
    _gn_fwd(y, noG, noB, yn, meanN, invN, xhatN, T, d, 1)
    nn_conv1d_fwd(yn, roW, roB, out_logits, T, d, V, 1, 1)
}

// CE gradient seed (verbatim from clm_step.hexa).
fn clm_ce_grad(logits: int, targets: int, dlogits_out: int, T: int, V: int) {
    let mut t = 0
    while t < T {
        let base = t * V
        let mut mx = t_get(logits, base)
        let mut i = 1
        while i < V { let v = t_get(logits, base + i); if v > mx { mx = v }; i = i + 1 }
        let mut sm = 0.0
        let mut i2 = 0
        while i2 < V { sm = sm + exp(t_get(logits, base + i2) - mx); i2 = i2 + 1 }
        let invT = 1.0 / to_float(T)
        let mut v3 = 0
        while v3 < V {
            let p = exp(t_get(logits, base + v3) - mx) / sm
            t_set(dlogits_out, base + v3, p * invT)
            v3 = v3 + 1
        }
        let tgt = to_int(t_get(targets, t))
        t_set(dlogits_out, base + tgt, t_get(dlogits_out, base + tgt) - invT)
        t = t + 1
    }
}

// Backward chain (verbatim from clm_step.hexa; gn calls → inlined _gn_bwd).
fn clm_bwd(dlogits: int, tokens: int,
           embed: int, ecW: int, tcW: int, tgG: int, rW: int, e0W: int, e1W: int, noG: int, roW: int,
           xe: int, xec: int, xt: int, hn0: int, xhat0: int, inv0: int,
           eo0: int, eo1: int, probs: int, ex_out: int, yn: int, xhatN: int, invN: int,
           dembed: int, decW: int, decB: int, dtcW: int, dtcB: int, dtgG: int, dtgB: int,
           drW: int, drB: int, de0W: int, de0B: int, de1W: int, de1B: int,
           dnoG: int, dnoB: int, droW: int, droB: int,
           T: int, d: int, E: int, V: int, K: int) {
    let dynorm = t_zeros(T * d)
    nn_conv1d_bwd(yn, roW, dlogits, droW, dynorm, droB, T, d, V, 1, 1)
    let dy = t_zeros(T * d)
    _gn_bwd(xhatN, invN, noG, dynorm, dnoG, dnoB, dy, T, d, 1)
    let dlogits_r = t_zeros(T * E)
    let dex_out = t_zeros(E * T * d)
    nn_moe_router_bwd(probs, ex_out, dy, dlogits_r, dex_out, T, E, d)
    let dxt_r = t_zeros(T * d)
    nn_conv1d_bwd(xt, rW, dlogits_r, drW, dxt_r, drB, T, d, E, 1, 1)
    let dex0 = t_zeros(T * d); let dex1 = t_zeros(T * d)
    let mut ei = 0
    while ei < T * d {
        t_set(dex0, ei, t_get(dex_out, 0 * T * d + ei))
        t_set(dex1, ei, t_get(dex_out, 1 * T * d + ei))
        ei = ei + 1
    }
    let deo0 = t_zeros(T * d); nn_gelu_bwd(eo0, dex0, deo0, T * d)
    let deo1 = t_zeros(T * d); nn_gelu_bwd(eo1, dex1, deo1, T * d)
    let dxt_e0 = t_zeros(T * d); nn_conv1d_bwd(xt, e0W, deo0, de0W, dxt_e0, de0B, T, d, d, K, 1)
    let dxt_e1 = t_zeros(T * d); nn_conv1d_bwd(xt, e1W, deo1, de1W, dxt_e1, de1B, T, d, d, K, 1)
    let dxt = t_zeros(T * d)
    let mut xi = 0
    while xi < T * d {
        t_set(dxt, xi, t_get(dxt_r, xi) + t_get(dxt_e0, xi) + t_get(dxt_e1, xi))
        xi = xi + 1
    }
    let dhn0 = t_zeros(T * d); nn_gelu_bwd(hn0, dxt, dhn0, T * d)
    let dh0 = t_zeros(T * d)
    _gn_bwd(xhat0, inv0, tgG, dhn0, dtgG, dtgB, dh0, T, d, 1)
    let dxec_b = t_zeros(T * d)
    nn_conv1d_bwd(xec, tcW, dh0, dtcW, dxec_b, dtcB, T, d, d, K, 1)
    let dxec = t_zeros(T * d)
    let mut ci = 0
    while ci < T * d { t_set(dxec, ci, t_get(dxt, ci) + t_get(dxec_b, ci)); ci = ci + 1 }
    let dxe = t_zeros(T * d)
    nn_conv1d_bwd(xe, ecW, dxec, decW, dxe, decB, T, d, d, K, 1)
    let mut zi = 0
    while zi < V * d { t_set(dembed, zi, 0.0); zi = zi + 1 }
    nn_embedding_bwd_scatter(dxe, tokens, dembed, T, d)
}

fn _adam(W: int, gW: int, m: int, v: int, n: int, t: int) {
    opt_adamw_step(W, gW, m, v, n, 0.05, 0.9, 0.999, 0.00000001, 0.0, t)
}

// ── ONE composed micro-step (fwd→loss→bwd→AdamW over EVERY param). Snapshots
//    every post-step W / m / v tensor (via farr_copy) into the 17-slot packs
//    (each slot stores a tensor handle as a float). DETERMINISTIC init from the
//    SAME fixed LCG seeds used by clm_step.hexa main(). Returns the step loss. ──
fn run_step(pack: int, mpack: int, vpack: int) -> float {
    let T = 4; let d = 8; let E = 2; let V = 256; let K = 3
    let dd = d * d * K; let ed = E * d; let vd = V * d

    let tokens = t_zeros(T)
    t_set(tokens, 0, 3.0); t_set(tokens, 1, 14.0); t_set(tokens, 2, 159.0); t_set(tokens, 3, 26.0)
    let targets = t_zeros(T)
    t_set(targets, 0, 14.0); t_set(targets, 1, 159.0); t_set(targets, 2, 26.0); t_set(targets, 3, 7.0)

    // params — DETERMINISTIC fill (fixed LCG seeds, no RNG/wall-clock)
    let embed = t_zeros(vd);  t_fill_lcg(embed, vd, 1, 0.3)
    let ecW = t_zeros(dd);    t_fill_lcg(ecW, dd, 2, 0.2)
    let ecB = t_zeros(d);     t_fill_lcg(ecB, d, 3, 0.1)
    let tcW = t_zeros(dd);    t_fill_lcg(tcW, dd, 4, 0.2)
    let tcB = t_zeros(d);     t_fill_lcg(tcB, d, 5, 0.1)
    let tgG = t_zeros(d);     t_fill_lcg(tgG, d, 6, 0.5)
    let tgB = t_zeros(d);     t_fill_lcg(tgB, d, 7, 0.1)
    let rW = t_zeros(ed);     t_fill_lcg(rW, ed, 12, 0.2)
    let rB = t_zeros(E);      t_fill_lcg(rB, E, 13, 0.1)
    let e0W = t_zeros(dd);    t_fill_lcg(e0W, dd, 14, 0.2)
    let e0B = t_zeros(d);     t_fill_lcg(e0B, d, 15, 0.1)
    let e1W = t_zeros(dd);    t_fill_lcg(e1W, dd, 16, 0.2)
    let e1B = t_zeros(d);     t_fill_lcg(e1B, d, 17, 0.1)
    let noG = t_zeros(d);     t_fill_lcg(noG, d, 18, 0.5)
    let noB = t_zeros(d);     t_fill_lcg(noB, d, 19, 0.1)
    let roW = t_zeros(vd);    t_fill_lcg(roW, vd, 20, 0.2)
    let roB = t_zeros(V);     t_fill_lcg(roB, V, 21, 0.1)

    // grads
    let dembed=t_zeros(vd); let decW=t_zeros(dd); let decB=t_zeros(d)
    let dtcW=t_zeros(dd); let dtcB=t_zeros(d); let dtgG=t_zeros(d); let dtgB=t_zeros(d)
    let drW=t_zeros(ed); let drB=t_zeros(E)
    let de0W=t_zeros(dd); let de0B=t_zeros(d); let de1W=t_zeros(dd); let de1B=t_zeros(d)
    let dnoG=t_zeros(d); let dnoB=t_zeros(d); let droW=t_zeros(vd); let droB=t_zeros(V)

    // adam state (m, v) per param — zero-initialized
    let m_embed=t_zeros(vd); let v_embed=t_zeros(vd)
    let m_ecW=t_zeros(dd); let v_ecW=t_zeros(dd); let m_ecB=t_zeros(d); let v_ecB=t_zeros(d)
    let m_tcW=t_zeros(dd); let v_tcW=t_zeros(dd); let m_tcB=t_zeros(d); let v_tcB=t_zeros(d)
    let m_tgG=t_zeros(d); let v_tgG=t_zeros(d); let m_tgB=t_zeros(d); let v_tgB=t_zeros(d)
    let m_rW=t_zeros(ed); let v_rW=t_zeros(ed); let m_rB=t_zeros(E); let v_rB=t_zeros(E)
    let m_e0W=t_zeros(dd); let v_e0W=t_zeros(dd); let m_e0B=t_zeros(d); let v_e0B=t_zeros(d)
    let m_e1W=t_zeros(dd); let v_e1W=t_zeros(dd); let m_e1B=t_zeros(d); let v_e1B=t_zeros(d)
    let m_noG=t_zeros(d); let v_noG=t_zeros(d); let m_noB=t_zeros(d); let v_noB=t_zeros(d)
    let m_roW=t_zeros(vd); let v_roW=t_zeros(vd); let m_roB=t_zeros(V); let v_roB=t_zeros(V)

    // caches
    let xe=t_zeros(T*d); let xec=t_zeros(T*d); let xt=t_zeros(T*d)
    let hn0=t_zeros(T*d); let xhat0=t_zeros(T*d); let inv0=t_zeros(1)
    let eo0=t_zeros(T*d); let eo1=t_zeros(T*d); let probs=t_zeros(T*E); let ex_out=t_zeros(E*T*d)
    let yn=t_zeros(T*d); let xhatN=t_zeros(T*d); let invN=t_zeros(1)
    let logits=t_zeros(T*V); let dlogits=t_zeros(T*V)

    let step = 1

    // ── fwd → loss → bwd → AdamW (the composed micro-step) ──
    clm_fwd_full(tokens, embed, ecW, ecB, tcW, tcB, tgG, tgB, rW, rB,
                 e0W, e0B, e1W, e1B, noG, noB, roW, roB,
                 xe, xec, xt, hn0, xhat0, inv0, eo0, eo1, probs, ex_out,
                 yn, xhatN, invN, logits, T, d, E, V, K)
    let loss = nn_ce_loss_allpos(logits, targets, T, V)
    clm_ce_grad(logits, targets, dlogits, T, V)
    clm_bwd(dlogits, tokens, embed, ecW, tcW, tgG, rW, e0W, e1W, noG, roW,
            xe, xec, xt, hn0, xhat0, inv0, eo0, eo1, probs, ex_out, yn, xhatN, invN,
            dembed, decW, decB, dtcW, dtcB, dtgG, dtgB, drW, drB, de0W, de0B, de1W, de1B,
            dnoG, dnoB, droW, droB, T, d, E, V, K)
    _adam(embed, dembed, m_embed, v_embed, vd, step)
    _adam(ecW, decW, m_ecW, v_ecW, dd, step); _adam(ecB, decB, m_ecB, v_ecB, d, step)
    _adam(tcW, dtcW, m_tcW, v_tcW, dd, step); _adam(tcB, dtcB, m_tcB, v_tcB, d, step)
    _adam(tgG, dtgG, m_tgG, v_tgG, d, step);  _adam(tgB, dtgB, m_tgB, v_tgB, d, step)
    _adam(rW, drW, m_rW, v_rW, ed, step);     _adam(rB, drB, m_rB, v_rB, E, step)
    _adam(e0W, de0W, m_e0W, v_e0W, dd, step); _adam(e0B, de0B, m_e0B, v_e0B, d, step)
    _adam(e1W, de1W, m_e1W, v_e1W, dd, step); _adam(e1B, de1B, m_e1B, v_e1B, d, step)
    _adam(noG, dnoG, m_noG, v_noG, d, step);  _adam(noB, dnoB, m_noB, v_noB, d, step)
    _adam(roW, droW, m_roW, v_roW, vd, step); _adam(roB, droB, m_roB, v_roB, V, step)

    // ── snapshot post-step W / m / v (farr_copy handle stored as float) ──
    let _ = farr_set(pack,  0, to_float(farr_copy(embed)))
    let _ = farr_set(pack,  1, to_float(farr_copy(ecW)))
    let _ = farr_set(pack,  2, to_float(farr_copy(ecB)))
    let _ = farr_set(pack,  3, to_float(farr_copy(tcW)))
    let _ = farr_set(pack,  4, to_float(farr_copy(tcB)))
    let _ = farr_set(pack,  5, to_float(farr_copy(tgG)))
    let _ = farr_set(pack,  6, to_float(farr_copy(tgB)))
    let _ = farr_set(pack,  7, to_float(farr_copy(rW)))
    let _ = farr_set(pack,  8, to_float(farr_copy(rB)))
    let _ = farr_set(pack,  9, to_float(farr_copy(e0W)))
    let _ = farr_set(pack, 10, to_float(farr_copy(e0B)))
    let _ = farr_set(pack, 11, to_float(farr_copy(e1W)))
    let _ = farr_set(pack, 12, to_float(farr_copy(e1B)))
    let _ = farr_set(pack, 13, to_float(farr_copy(noG)))
    let _ = farr_set(pack, 14, to_float(farr_copy(noB)))
    let _ = farr_set(pack, 15, to_float(farr_copy(roW)))
    let _ = farr_set(pack, 16, to_float(farr_copy(roB)))

    let _ = farr_set(mpack,  0, to_float(farr_copy(m_embed)))
    let _ = farr_set(mpack,  1, to_float(farr_copy(m_ecW)))
    let _ = farr_set(mpack,  2, to_float(farr_copy(m_ecB)))
    let _ = farr_set(mpack,  3, to_float(farr_copy(m_tcW)))
    let _ = farr_set(mpack,  4, to_float(farr_copy(m_tcB)))
    let _ = farr_set(mpack,  5, to_float(farr_copy(m_tgG)))
    let _ = farr_set(mpack,  6, to_float(farr_copy(m_tgB)))
    let _ = farr_set(mpack,  7, to_float(farr_copy(m_rW)))
    let _ = farr_set(mpack,  8, to_float(farr_copy(m_rB)))
    let _ = farr_set(mpack,  9, to_float(farr_copy(m_e0W)))
    let _ = farr_set(mpack, 10, to_float(farr_copy(m_e0B)))
    let _ = farr_set(mpack, 11, to_float(farr_copy(m_e1W)))
    let _ = farr_set(mpack, 12, to_float(farr_copy(m_e1B)))
    let _ = farr_set(mpack, 13, to_float(farr_copy(m_noG)))
    let _ = farr_set(mpack, 14, to_float(farr_copy(m_noB)))
    let _ = farr_set(mpack, 15, to_float(farr_copy(m_roW)))
    let _ = farr_set(mpack, 16, to_float(farr_copy(m_roB)))

    let _ = farr_set(vpack,  0, to_float(farr_copy(v_embed)))
    let _ = farr_set(vpack,  1, to_float(farr_copy(v_ecW)))
    let _ = farr_set(vpack,  2, to_float(farr_copy(v_ecB)))
    let _ = farr_set(vpack,  3, to_float(farr_copy(v_tcW)))
    let _ = farr_set(vpack,  4, to_float(farr_copy(v_tcB)))
    let _ = farr_set(vpack,  5, to_float(farr_copy(v_tgG)))
    let _ = farr_set(vpack,  6, to_float(farr_copy(v_tgB)))
    let _ = farr_set(vpack,  7, to_float(farr_copy(v_rW)))
    let _ = farr_set(vpack,  8, to_float(farr_copy(v_rB)))
    let _ = farr_set(vpack,  9, to_float(farr_copy(v_e0W)))
    let _ = farr_set(vpack, 10, to_float(farr_copy(v_e0B)))
    let _ = farr_set(vpack, 11, to_float(farr_copy(v_e1W)))
    let _ = farr_set(vpack, 12, to_float(farr_copy(v_e1B)))
    let _ = farr_set(vpack, 13, to_float(farr_copy(v_noG)))
    let _ = farr_set(vpack, 14, to_float(farr_copy(v_noB)))
    let _ = farr_set(vpack, 15, to_float(farr_copy(v_roW)))
    let _ = farr_set(vpack, 16, to_float(farr_copy(v_roB)))

    return loss
}

// max|Δ| over two tensor-handle packs (slots 0..n-1; each slot holds a farr id
// stored as float). Returns the worst elementwise abs-diff across all tensors.
fn pack_max_dev(packA: int, packB: int, n: int) -> float {
    let mut worst = 0.0
    let mut s = 0
    while s < n {
        let a = to_int(farr_get(packA, s))
        let b = to_int(farr_get(packB, s))
        let la = farr_len(a)
        let mut i = 0
        while i < la {
            let dev = _abs(farr_get(a, i) - farr_get(b, i))
            if dev > worst { worst = dev }
            i = i + 1
        }
        s = s + 1
    }
    return worst
}

fn main() {
    println("clm_step_determinism_eq — F-OP15 INTEGRATION byte-eq run-to-run determinism (CPU oracle)")
    println("  scope: ONE full CLMConvMoE micro-step (embed->conv->GroupNorm->MoE->CE->bwd->AdamW), 17 params + m/v + loss")
    let NP = 17

    // RUN 1 — composed step from fixed-seed init.
    let W1 = t_zeros(NP); let M1 = t_zeros(NP); let V1 = t_zeros(NP)
    let loss1 = run_step(W1, M1, V1)

    // RUN 2 — the SAME composed step from the SAME fixed-seed init.
    let W2 = t_zeros(NP); let M2 = t_zeros(NP); let V2 = t_zeros(NP)
    let loss2 = run_step(W2, M2, V2)

    let dW = pack_max_dev(W1, W2, NP)
    let dM = pack_max_dev(M1, M2, NP)
    let dV = pack_max_dev(V1, V2, NP)
    let dL = _abs(loss1 - loss2)

    println("  loss run1 = " + to_string(loss1))
    println("  loss run2 = " + to_string(loss2))
    println("  max|d(W', W'')|   = " + to_string(dW))
    println("  max|d(m', m'')|   = " + to_string(dM))
    println("  max|d(v', v'')|   = " + to_string(dV))
    println("  |d(loss', loss'')| = " + to_string(dL))

    if dW == 0.0 && dM == 0.0 && dV == 0.0 && dL == 0.0 {
        println("F-OP15-STEP-DETERMINISM = 1")
        println("PASS - composed CLMConvMoE micro-step is BYTE-IDENTICAL run-to-run (max|d|=0 over W, m, v, loss). Composition is deterministic; no uninit-scratch / non-det-iteration / address-ordered hole.")
        return
    }
    println("F-OP15-STEP-DETERMINISM = 0")
    println("FAIL - composition determinism HOLE found (nonzero run-to-run d above) - REAL bug-class the per-op oracles miss; see diverging state.")
}
