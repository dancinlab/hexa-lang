// @raw117_exempt
// ════════════════════════════════════════════════════════════════════════
// stdlib/flame/op29_decoder_block_selfcontained.hexa
// HEXA-0POD OP-29 · SELF-CONTAINED 2nd-arch machine-indep oracle (NO `use`)
//
// Single-file twin of op29_decoder_block_determinism_eq.hexa: inlines the
// decoder_block_lib fwd/bwd (verbatim algorithm) + flame_math dt_*/d5_* +
// the LCG fill, so it runs via scp/stdin on ANY host (the OP-28 cross-
// platform pattern) with NO stdlib checkout dependency. Used to prove the
// 2nd-arch byte-eq fingerprint is IDENTICAL on local arm64-macos vs aiden
// x86-linux — machine-independence GENERALIZES beyond CLMConvMoE.
//
// 2nd arch = pre-norm Transformer decoder block: GQA scaled-dot attention +
// RoPE + SwiGLU + RMSNorm. Built libm-free (dt_exp/dt_sqrt + deterministic
// RoPE via dt_ln/dt_exp/d5_cos/d5_sin — closes the nn_rope_build_tables
// libm ln/exp hole).
// ════════════════════════════════════════════════════════════════════════

// ── flame_math dt_*/d5_* (inlined verbatim) ─────────────────────────
pub fn dt_sqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = if x > 1.0 { x } else { 1.0 }
    let mut i = 0
    while i < 24 {
        g = 0.5 * (g + x / g)
        i = i + 1
    }
    return g
}

// dt_exp : range-reduce until |xr| ≤ 0.25, 12-term Taylor, then
// repeated-square 2^r times. Stable for the softmax range we'll
// encounter in trainer (|x − x_max| typically < 30).
pub fn dt_exp(x: float) -> float {
    let mut r = 0
    let mut xr = x
    while (if xr > 0.0 { xr } else { 0.0 - xr }) > 0.25 {
        xr = xr / 2.0
        r = r + 1
    }
    let mut term = 1.0
    let mut acc = 1.0
    let mut k = 1
    while k < 12 {
        term = term * xr / to_float(k)
        acc = acc + term
        k = k + 1
    }
    let mut s = 0
    while s < r { acc = acc * acc; s = s + 1 }
    return acc
}

// dt_erf : PURE-FP deterministic error function — NO libm. Abramowitz & Stegun
// 7.1.26 rational approximation, with the single transcendental routed through the
// deterministic `dt_exp` Taylor (above):
//     erf(z) = 1 − (a₁t + a₂t² + a₃t³ + a₄t⁴ + a₅t⁵)·exp(−z²),  t = 1/(1 + p·z)
// BRANCHLESS in z (the ONLY conditional is the odd-symmetry sign flip at z = 0,
// which is exact) — so it is a SINGLE continuous arithmetic expression with no
// value-dependent branch. That branchlessness is load-bearing for byte-eq: a
// piecewise erf (series-then-clamp, or series-then-tail) straddles its branch
// boundary under in-register vs stored-reload rounding of the GELU argument and
// breaks max|Δ|=0; the unconditional A&S form has no boundary to straddle.
// EVERY op is +,-,*,/ on fp64 plus dt_exp (itself +,-,*,/ only), so the result is
// bit-IDENTICAL on any IEEE-754 platform (x86/arm64 · Darwin/Linux) — the OP-19b
// reproducibility identity. max|dt_erf − libm erf| = 1.38e-7 (HEXA-0POD F-OP19B),
// ≤ the GELU training tolerance. The deterministic twin of the libm `erf` GELU
// path; with OP-19's dt_exp this removes the LAST libm transcendental in the step.
pub fn dt_erf(x: float) -> float {
    let mut sign = 1.0
    let mut z = x
    if z < 0.0 { sign = 0.0 - 1.0; z = 0.0 - z }
    let t = 1.0 / (1.0 + 0.3275911 * z)
    let a1 = 0.254829592
    let a2 = 0.0 - 0.284496736
    let a3 = 1.421413741
    let a4 = 0.0 - 1.453152027
    let a5 = 1.061405429
    let poly = ((((a5 * t + a4) * t + a3) * t + a2) * t + a1) * t
    return sign * (1.0 - poly * dt_exp(0.0 - z * z))
}

// dt_ln : 2 · Σ_{k=0..23} u^(2k+1)/(2k+1), u = (x-1)/(x+1).
// Valid for x > 0; series converges fastest near x = 1.
pub fn dt_ln(x: float) -> float {
    let u = (x - 1.0) / (x + 1.0)
    let u2 = u * u
    let mut termp = u
    let mut acc = 0.0
    let mut k = 0
    while k < 24 {
        acc = acc + termp / to_float(2 * k + 1)
        termp = termp * u2
        k = k + 1
    }
    return 2.0 * acc
}

// d5_two_pi / d5_pi : exact constants (matches anima d_train5_lib).
pub fn d5_two_pi() -> float { return 6.283185307179586 }
pub fn d5_pi() -> float { return 3.141592653589793 }

// d5_reduce : argument reduction mod 2π so |r| ≤ π (Taylor convergence
// floor for sin/cos 14-term).
pub fn d5_reduce(x: float) -> float {
    let tp = d5_two_pi()
    let mut r = x
    while r > d5_pi()  { r = r - tp }
    while r < 0.0 - d5_pi() { r = r + tp }
    return r
}

// d5_sin / d5_cos : 14-term Taylor series after argument reduction.
// Identical to anima d_train5_lib.hexa §271 / §284. Used by RoPE
// tables — strict bit-eq path to anima d5_rope_tables output.
pub fn d5_sin(x: float) -> float {
    let r = d5_reduce(x)
    let r2 = r * r
    let mut term = r
    let mut acc = r
    let mut k = 1
    while k < 14 {
        term = 0.0 - term * r2 / to_float((2*k) * (2*k+1))
        acc = acc + term
        k = k + 1
    }
    return acc
}

pub fn d5_cos(x: float) -> float {
    let r = d5_reduce(x)
    let r2 = r * r
    let mut term = 1.0
    let mut acc = 1.0
    let mut k = 1
    while k < 14 {
        term = 0.0 - term * r2 / to_float((2*k-1) * (2*k))
        acc = acc + term
        k = k + 1
    }
    return acc
}

// ── tensor LCG fill (inlined from tensor_lib) ───────────────────────
fn _flame_lcg_next(state: int) -> int {
    let s = state * 6364136223846793005 + 1442695040888963407
    let m = s % 2147483647
    if m < 0 { return 0 - m }
    return m
}

fn _flame_lcg_unit(v: int) -> float {
    let f = (to_float(v) / 2147483647.0)
    return f * 2.0 - 1.0
}
fn t_fill_lcg2(t: int, n: int, seed: int, scale: float) {
    let mut st = seed
    let mut i = 0
    while i < n {
        st = _flame_lcg_next(st)
        let _ = farr_set(t, i, _flame_lcg_unit(st) * scale)
        i = i + 1
    }
}

// ── decoder_block_lib (inlined verbatim, pub stripped) ──────────────
// ── dim helpers ────────────────────────────────────────────────────────
fn _hd_of(d: int, nh: int) -> int { return d / nh }
fn _kvd_of(d: int, nh: int, nkv: int) -> int { return nkv * (d / nh) }

// ── Bp (params) offset helpers (public — caller indexes into Bp) ──────
fn bp_off_g1(d: int, nh: int, nkv: int, h: int) -> int { return 0 }
fn bp_off_Wq(d: int, nh: int, nkv: int, h: int) -> int { return d }
fn bp_off_Wk(d: int, nh: int, nkv: int, h: int) -> int { return d + d*d }
fn bp_off_Wv(d: int, nh: int, nkv: int, h: int) -> int {
    return d + d*d + _kvd_of(d, nh, nkv)*d
}
fn bp_off_Wo(d: int, nh: int, nkv: int, h: int) -> int {
    return d + d*d + 2*_kvd_of(d, nh, nkv)*d
}
fn bp_off_g2(d: int, nh: int, nkv: int, h: int) -> int {
    return d + 2*d*d + 2*_kvd_of(d, nh, nkv)*d
}
fn bp_off_Wg(d: int, nh: int, nkv: int, h: int) -> int {
    return 2*d + 2*d*d + 2*_kvd_of(d, nh, nkv)*d
}
fn bp_off_Wu(d: int, nh: int, nkv: int, h: int) -> int {
    return 2*d + 2*d*d + 2*_kvd_of(d, nh, nkv)*d + h*d
}
fn bp_off_Wd(d: int, nh: int, nkv: int, h: int) -> int {
    return 2*d + 2*d*d + 2*_kvd_of(d, nh, nkv)*d + 2*h*d
}
fn bp_total(d: int, nh: int, nkv: int, h: int) -> int {
    return 2*d + 2*d*d + 2*_kvd_of(d, nh, nkv)*d + 3*h*d
}

// ── Bc (cache) offset helpers ──────────────────────────────────────────
fn bc_off_Xout(T: int, d: int, nh: int, nkv: int, h: int) -> int { return 0 }
fn bc_off_hstate(T: int, d: int, nh: int, nkv: int, h: int) -> int { return T*d }
fn bc_off_rin(T: int, d: int, nh: int, nkv: int, h: int) -> int { return 2*T*d }
fn bc_off_rin2(T: int, d: int, nh: int, nkv: int, h: int) -> int { return 3*T*d }
fn bc_off_rm1xn(T: int, d: int, nh: int, nkv: int, h: int) -> int { return 4*T*d }
fn bc_off_rm2xn(T: int, d: int, nh: int, nkv: int, h: int) -> int { return 5*T*d }
fn bc_off_ctx(T: int, d: int, nh: int, nkv: int, h: int) -> int { return 6*T*d }
fn bc_off_Q(T: int, d: int, nh: int, nkv: int, h: int) -> int { return 7*T*d }
fn bc_off_K(T: int, d: int, nh: int, nkv: int, h: int) -> int { return 8*T*d }
fn bc_off_V(T: int, d: int, nh: int, nkv: int, h: int) -> int {
    return 8*T*d + T*_kvd_of(d, nh, nkv)
}
fn bc_off_P(T: int, d: int, nh: int, nkv: int, h: int) -> int {
    return 8*T*d + 2*T*_kvd_of(d, nh, nkv)
}
fn bc_off_sw_a(T: int, d: int, nh: int, nkv: int, h: int) -> int {
    return 8*T*d + 2*T*_kvd_of(d, nh, nkv) + nh*T*T
}
fn bc_off_sw_b(T: int, d: int, nh: int, nkv: int, h: int) -> int {
    return 8*T*d + 2*T*_kvd_of(d, nh, nkv) + nh*T*T + T*h
}
fn bc_off_sw_s(T: int, d: int, nh: int, nkv: int, h: int) -> int {
    return 8*T*d + 2*T*_kvd_of(d, nh, nkv) + nh*T*T + 2*T*h
}
fn bc_off_rm1inv(T: int, d: int, nh: int, nkv: int, h: int) -> int {
    return 8*T*d + 2*T*_kvd_of(d, nh, nkv) + nh*T*T + 3*T*h
}
fn bc_off_rm2inv(T: int, d: int, nh: int, nkv: int, h: int) -> int {
    return 8*T*d + 2*T*_kvd_of(d, nh, nkv) + nh*T*T + 3*T*h + T
}
fn bc_total(T: int, d: int, nh: int, nkv: int, h: int) -> int {
    return 8*T*d + 2*T*_kvd_of(d, nh, nkv) + nh*T*T + 3*T*h + 2*T
}

// ── private inline helpers (dt_* anima-aligned transcendentals) ───────
fn _db_sigmoid(x: float) -> float { return 1.0 / (1.0 + dt_exp(0.0 - x)) }
fn _db_silu(x: float) -> float { return x * _db_sigmoid(x) }
fn _db_silu_grad(x: float) -> float {
    let s = _db_sigmoid(x)
    return s + x * s * (1.0 - s)
}

// Phase 4-A-bwd helper: accumulate dW += dY^T · X where dY [T·d_out],
// X [T·d_in], dW [d_out·d_in]. Uses the same farr_matmul kernel as
// anima's d5_outer_g via reshape. Writes dW ACCUMULATING (+=) at the
// given offset in the destination farr.
//   dW[r][c] += Σ_t dY[t][r] · X[t][c]
//             = Σ_t (dY^T)[r][t] · X[t][c]
//             = (dY^T · X)[r][c]
// Layout: dY in [T·d_out] row-major (matches Phase 3 nn_decoder_block_bwd
// dQ/dK/dV); X in [T·d_in] row-major (matches Bc.oRin / Bc.oSwS layout).
// OP-29 MACHINE-INDEPENDENT REWRITE: dW[r][c] += Σ_t dY[t·d_out+r]·X[t·d_in+c]
// computed INLINE in fixed ascending t order — NOT via the C farr_matmul
// kernel, whose ikj FMA-fused accumulation contracts a*b+c into a single
// fused-multiply-add on arm64 but NOT on x86 (clang -O2), producing a sub-ULP
// ISA-dependent result (OP-29 root cause: farr_matmul 8×8·8×4 byte-diverges
// arm64 vs x86 on otherwise byte-identical fp64 inputs). The inline dot emits
// plain mul+add in hexa codegen → bit-identical on any IEEE-754 platform.
fn _db_grad_accum_farr(dY: int, dY_off: int, X: int, X_off: int,
                       dW_dst: int, dW_off: int,
                       T: int, d_out: int, d_in: int) {
    let mut r = 0
    while r < d_out {
        let mut c = 0
        while c < d_in {
            let mut acc = 0.0
            let mut t = 0
            while t < T {
                acc = acc + farr_get(dY, dY_off + t * d_out + r)
                          * farr_get(X, X_off + t * d_in + c)
                t = t + 1
            }
            let cur = farr_get(dW_dst, dW_off + r * d_in + c)
            let _ = farr_set(dW_dst, dW_off + r * d_in + c, cur + acc)
            c = c + 1
        }
        r = r + 1
    }
}

// Phase 3-J helper: project Y [T·d_out] = X [T·d_in] · W^T [d_in·d_out]
// via the same transpose-matmul-transpose pattern as anima
// d5_proj_batch_g — routing through the C farr_matmul kernel so clang
// FMA fusion behaves consistently across flame and anima. Y[t][r] =
// Σ_c W[r·d_in + c] · X[t·d_in + c]. inputs (W, X) read at given
// offsets in their packed farrs; Y written at given offset. Allocates
// 3 scratch farrs (xbt [d_in·T], W_buf [d_out·d_in], C [d_out·T]).
// OP-29 MACHINE-INDEPENDENT REWRITE: Y[t·d_out+r] = Σ_c W[r·d_in+c]·X[t·d_in+c]
// computed INLINE in fixed ascending c order — NOT via the C farr_matmul
// kernel (same ISA-dependent FMA-fusion root cause as _db_grad_accum_farr
// above). Plain mul+add → bit-identical arm64/x86, Darwin/Linux.
fn _db_proj_batch_farr(W: int, W_off: int, X: int, X_off: int,
                       Y: int, Y_off: int,
                       T: int, d_out: int, d_in: int) {
    let mut t = 0
    while t < T {
        let mut r = 0
        while r < d_out {
            let mut acc = 0.0
            let mut c = 0
            while c < d_in {
                acc = acc + farr_get(W, W_off + r * d_in + c)
                          * farr_get(X, X_off + t * d_in + c)
                c = c + 1
            }
            let _ = farr_set(Y, Y_off + t * d_out + r, acc)
            r = r + 1
        }
        t = t + 1
    }
}

// ── one decoder block forward ──────────────────────────────────────────
// Reads X (T·d) and Bp (packed params), cos/sin (T·hd each).
// Writes Xout + all cache fields into Bc (caller-allocated and pre-zeroed).
fn nn_decoder_block_fwd(X: int, Bp: int, Bc: int,
                            cos: int, sin: int,
                            T: int, d: int, nh: int, nkv: int, h: int) {
    let hd = d / nh
    let kvd = nkv * hd

    let G1 = bp_off_g1(d, nh, nkv, h)
    let WQ = bp_off_Wq(d, nh, nkv, h)
    let WK = bp_off_Wk(d, nh, nkv, h)
    let WV = bp_off_Wv(d, nh, nkv, h)
    let WO = bp_off_Wo(d, nh, nkv, h)
    let G2 = bp_off_g2(d, nh, nkv, h)
    let WG = bp_off_Wg(d, nh, nkv, h)
    let WU = bp_off_Wu(d, nh, nkv, h)
    let WD = bp_off_Wd(d, nh, nkv, h)

    let oXout   = bc_off_Xout(T, d, nh, nkv, h)
    let oHstate = bc_off_hstate(T, d, nh, nkv, h)
    let oRin    = bc_off_rin(T, d, nh, nkv, h)
    let oRin2   = bc_off_rin2(T, d, nh, nkv, h)
    let oRm1xn  = bc_off_rm1xn(T, d, nh, nkv, h)
    let oRm2xn  = bc_off_rm2xn(T, d, nh, nkv, h)
    let oCtx    = bc_off_ctx(T, d, nh, nkv, h)
    let oQ      = bc_off_Q(T, d, nh, nkv, h)
    let oK      = bc_off_K(T, d, nh, nkv, h)
    let oV      = bc_off_V(T, d, nh, nkv, h)
    let oP      = bc_off_P(T, d, nh, nkv, h)
    let oSwA    = bc_off_sw_a(T, d, nh, nkv, h)
    let oSwB    = bc_off_sw_b(T, d, nh, nkv, h)
    let oSwS    = bc_off_sw_s(T, d, nh, nkv, h)
    let oR1inv  = bc_off_rm1inv(T, d, nh, nkv, h)
    let oR2inv  = bc_off_rm2inv(T, d, nh, nkv, h)
    let eps = 0.000001

    // 1. per-position RMSNorm(X, g1) → rin, rm1xn, rm1inv
    let mut i = 0
    while i < T {
        let mut ms = 0.0
        let mut c = 0
        while c < d {
            let xi = farr_get(X, i * d + c)
            ms = ms + xi * xi
            c = c + 1
        }
        ms = ms / to_float(d)
        let inv = 1.0 / dt_sqrt(ms + eps)
        let _ = farr_set(Bc, oR1inv + i, inv)
        let mut c2 = 0
        while c2 < d {
            let xni = farr_get(X, i * d + c2) * inv
            let _ = farr_set(Bc, oRm1xn + i * d + c2, xni)
            let _ = farr_set(Bc, oRin + i * d + c2,
                             farr_get(Bp, G1 + c2) * xni)
            c2 = c2 + 1
        }
        i = i + 1
    }

    // 2. Q/K/V projections via anima-byte-eq farr_matmul-routed helper.
    //    Y[t][r] = Σ_c W[r·d_in + c] · X[t·d_in + c]  for X = rin.
    _db_proj_batch_farr(Bp, WQ, Bc, oRin, Bc, oQ, T, d,   d)
    _db_proj_batch_farr(Bp, WK, Bc, oRin, Bc, oK, T, kvd, d)
    _db_proj_batch_farr(Bp, WV, Bc, oRin, Bc, oV, T, kvd, d)

    // 3. RoPE rotation on Q (per-head) and K (per-kv-head)
    let half = hd / 2
    let mut t_r = 0
    while t_r < T {
        let bse = t_r * hd
        // Q: nh heads at (t_r·nh + hh)·hd
        let mut hh = 0
        while hh < nh {
            let row_off = oQ + (t_r * nh + hh) * hd
            // out[c] = q[c]·cos + rh(q)[c]·sin  ;  rh: [-x2, x1]
            let mut cc = 0
            // We need a stable scratch: compute new values into a tmp
            // tuple by reading first all the originals, then writing.
            // Use cache offsets oR1inv+T as scratch... actually simpler:
            // hand-write the rotation, two passes via local pair.
            // Pass 1: save first-half originals (since they're read by
            // second half via rh).
            // Easier: do hd iters, using "if c<half" to compute rh from
            // either Q[half+c] (still original — we haven't written to it
            // yet) or Q[c-half] (already overwritten — BUG).
            // To fix: write to a separate temp region in Bc. Use the
            // ROW (hd) at end of cache — we have rm1inv at oR1inv (size T)
            // which doesn't overlap. Just allocate inline scratch:
            cc = 0  // placeholder; real loop below
            hh = hh + 1
        }
        t_r = t_r + 1
    }
    // Restart RoPE with explicit per-head scratch farr (allocate once).
    let q_scratch = farr_zeros(hd)
    let mut t_r2 = 0
    while t_r2 < T {
        let bse = t_r2 * hd
        let mut hh2 = 0
        while hh2 < nh {
            let row_off = oQ + (t_r2 * nh + hh2) * hd
            let mut c = 0
            while c < hd {
                let rh_c = if c < half {
                    0.0 - farr_get(Bc, row_off + half + c)
                } else {
                    farr_get(Bc, row_off + c - half)
                }
                let v = farr_get(Bc, row_off + c) * farr_get(cos, bse + c)
                      + rh_c * farr_get(sin, bse + c)
                let _ = farr_set(q_scratch, c, v)
                c = c + 1
            }
            let mut c3 = 0
            while c3 < hd {
                let _ = farr_set(Bc, row_off + c3, farr_get(q_scratch, c3))
                c3 = c3 + 1
            }
            hh2 = hh2 + 1
        }
        // K: nkv heads at (t_r2·nkv + hh)·hd, offset oK
        let mut hk = 0
        while hk < nkv {
            let row_off_k = oK + (t_r2 * nkv + hk) * hd
            let mut c = 0
            while c < hd {
                let rh_c = if c < half {
                    0.0 - farr_get(Bc, row_off_k + half + c)
                } else {
                    farr_get(Bc, row_off_k + c - half)
                }
                let v = farr_get(Bc, row_off_k + c) * farr_get(cos, bse + c)
                      + rh_c * farr_get(sin, bse + c)
                let _ = farr_set(q_scratch, c, v)
                c = c + 1
            }
            let mut c3 = 0
            while c3 < hd {
                let _ = farr_set(Bc, row_off_k + c3, farr_get(q_scratch, c3))
                c3 = c3 + 1
            }
            hk = hk + 1
        }
        t_r2 = t_r2 + 1
    }
    let _ = farr_free(q_scratch)

    // 4. attention core (causal GQA scaled-dot + softmax + value combine).
    // Inline (parallel to nn_attn_core_fwd, but reading from Bc offsets).
    let n_rep = nh / nkv
    let scale = 1.0 / dt_sqrt(to_float(hd))
    let srow_at = farr_zeros(T)
    // ctx_local accumulator at offset oXout (we'll later add residual).
    // For now we use offset oXout to temporarily hold ctx (overwritten
    // after the output projection + residual add).
    // Per-head per-position:
    let mut hh_a = 0
    while hh_a < nh {
        let kvh = hh_a / n_rep
        let mut i_a = 0
        while i_a < T {
            let L = i_a + 1
            let mut j = 0
            while j < L {
                let mut dot = 0.0
                let mut c = 0
                while c < hd {
                    dot = dot + farr_get(Bc, oQ + (i_a * nh + hh_a) * hd + c)
                              * farr_get(Bc, oK + (j * nkv + kvh) * hd + c)
                    c = c + 1
                }
                let _ = farr_set(srow_at, j, dot * scale)
                j = j + 1
            }
            // softmax_row → P at (hh_a·T + i_a)·T + 0..L
            let mut m_max = farr_get(srow_at, 0)
            let mut jj = 1
            while jj < L {
                if farr_get(srow_at, jj) > m_max { m_max = farr_get(srow_at, jj) }
                jj = jj + 1
            }
            let mut tot = 0.0
            let mut jj2 = 0
            while jj2 < L {
                let e = dt_exp(farr_get(srow_at, jj2) - m_max)
                let _ = farr_set(Bc, oP + (hh_a * T + i_a) * T + jj2, e)
                tot = tot + e
                jj2 = jj2 + 1
            }
            let mut jj3 = 0
            while jj3 < L {
                let cur = farr_get(Bc, oP + (hh_a * T + i_a) * T + jj3)
                let _ = farr_set(Bc, oP + (hh_a * T + i_a) * T + jj3, cur / tot)
                jj3 = jj3 + 1
            }
            // ctx[i_a · d + hh_a·hd + c] = Σ_j P · V — write into dedicated
            // oCtx slot (preserved for backward Wo grad).
            let mut c_v = 0
            while c_v < hd {
                let mut acc = 0.0
                let mut j_v = 0
                while j_v < L {
                    acc = acc + farr_get(Bc, oP + (hh_a * T + i_a) * T + j_v)
                              * farr_get(Bc, oV + (j_v * nkv + kvh) * hd + c_v)
                    j_v = j_v + 1
                }
                let _ = farr_set(Bc, oCtx + i_a * d + hh_a * hd + c_v, acc)
                c_v = c_v + 1
            }
            i_a = i_a + 1
        }
        hh_a = hh_a + 1
    }
    let _ = farr_free(srow_at)

    // 5. output projection: attn_out[t][r] = Σ_c Wo[r·d+c] · ctx[t·d+c].
    // farr_matmul-routed (anima d5_proj_batch_g pattern).
    let attn_out = farr_zeros(T * d)
    _db_proj_batch_farr(Bp, WO, Bc, oCtx, attn_out, 0, T, d, d)

    // 6. residual: hstate = X + attn_out
    let mut idx = 0
    while idx < T * d {
        let _ = farr_set(Bc, oHstate + idx,
                         farr_get(X, idx) + farr_get(attn_out, idx))
        idx = idx + 1
    }
    let _ = farr_free(attn_out)

    // 7. per-position RMSNorm(hstate, g2) → rin2, rm2xn, rm2inv
    let mut i2 = 0
    while i2 < T {
        let mut ms = 0.0
        let mut c = 0
        while c < d {
            let xi = farr_get(Bc, oHstate + i2 * d + c)
            ms = ms + xi * xi
            c = c + 1
        }
        ms = ms / to_float(d)
        let inv = 1.0 / dt_sqrt(ms + eps)
        let _ = farr_set(Bc, oR2inv + i2, inv)
        let mut c2 = 0
        while c2 < d {
            let xni = farr_get(Bc, oHstate + i2 * d + c2) * inv
            let _ = farr_set(Bc, oRm2xn + i2 * d + c2, xni)
            let _ = farr_set(Bc, oRin2 + i2 * d + c2,
                             farr_get(Bp, G2 + c2) * xni)
            c2 = c2 + 1
        }
        i2 = i2 + 1
    }

    // 8. SwiGLU: a = Wg·rin2 (T·h), b = Wu·rin2 (T·h), s = silu(a)·b,
    //    o = Wd·s (T·d). Projections farr_matmul-routed (anima eq).
    _db_proj_batch_farr(Bp, WG, Bc, oRin2, Bc, oSwA, T, h, d)
    _db_proj_batch_farr(Bp, WU, Bc, oRin2, Bc, oSwB, T, h, d)
    // s[ts·h + k] = silu(a) * b, in place (sw_s stored separately)
    let mut ts = 0
    while ts < T {
        let mut k = 0
        while k < h {
            let av = farr_get(Bc, oSwA + ts * h + k)
            let bv = farr_get(Bc, oSwB + ts * h + k)
            let _ = farr_set(Bc, oSwS + ts * h + k, _db_silu(av) * bv)
            k = k + 1
        }
        ts = ts + 1
    }
    // o = Wd·s   shape [T·d];  output into a temp, then add to hstate
    let sw_o = farr_zeros(T * d)
    _db_proj_batch_farr(Bp, WD, Bc, oSwS, sw_o, 0, T, d, h)
    // 9. residual: Xout = hstate + sw_o
    let mut idx2 = 0
    while idx2 < T * d {
        let _ = farr_set(Bc, oXout + idx2,
                         farr_get(Bc, oHstate + idx2) + farr_get(sw_o, idx2))
        idx2 = idx2 + 1
    }
    let _ = farr_free(sw_o)
}

// ── one decoder block backward ─────────────────────────────────────────
// Inputs:
//   X    [T·d]                       — block input (same as fwd)
//   Bp   packed params               — same as fwd
//   Bc   packed fwd cache            — fully populated by nn_decoder_block_fwd
//   dXout[T·d]                       — upstream gradient on Xout
//   cos/sin [T·hd]                   — same as fwd
//   dims: T, d, nh, nkv, h
// Outputs (all caller-allocated, pre-zeroed; this fn ACCUMULATES):
//   Bg   packed gradients (same layout as Bp; +=, not =)
//   dX   [T·d]                       — input gradient (+=)
fn nn_decoder_block_bwd(X: int, Bp: int, Bc: int,
                            dXout: int, dX_out: int, Bg: int,
                            cos: int, sin: int,
                            T: int, d: int, nh: int, nkv: int, h: int) {
    let hd = d / nh
    let kvd = nkv * hd
    let n_rep = nh / nkv
    let scale = 1.0 / dt_sqrt(to_float(hd))

    let G1 = bp_off_g1(d, nh, nkv, h)
    let WQ = bp_off_Wq(d, nh, nkv, h)
    let WK = bp_off_Wk(d, nh, nkv, h)
    let WV = bp_off_Wv(d, nh, nkv, h)
    let WO = bp_off_Wo(d, nh, nkv, h)
    let G2 = bp_off_g2(d, nh, nkv, h)
    let WG = bp_off_Wg(d, nh, nkv, h)
    let WU = bp_off_Wu(d, nh, nkv, h)
    let WD = bp_off_Wd(d, nh, nkv, h)

    let oHstate = bc_off_hstate(T, d, nh, nkv, h)
    let oRin    = bc_off_rin(T, d, nh, nkv, h)
    let oRin2   = bc_off_rin2(T, d, nh, nkv, h)
    let oRm1xn  = bc_off_rm1xn(T, d, nh, nkv, h)
    let oRm2xn  = bc_off_rm2xn(T, d, nh, nkv, h)
    let oCtx    = bc_off_ctx(T, d, nh, nkv, h)
    let oQ      = bc_off_Q(T, d, nh, nkv, h)
    let oK      = bc_off_K(T, d, nh, nkv, h)
    let oV      = bc_off_V(T, d, nh, nkv, h)
    let oP      = bc_off_P(T, d, nh, nkv, h)
    let oSwA    = bc_off_sw_a(T, d, nh, nkv, h)
    let oSwB    = bc_off_sw_b(T, d, nh, nkv, h)
    let oSwS    = bc_off_sw_s(T, d, nh, nkv, h)
    let oR1inv  = bc_off_rm1inv(T, d, nh, nkv, h)
    let oR2inv  = bc_off_rm2inv(T, d, nh, nkv, h)

    // 9 reversed (Xout = hstate + sw_o): dh = dXout (residual), dsw_o = dXout.
    // dh accumulator (in a fresh T·d farr — will be added to dX_out at end).
    let dh = farr_zeros(T * d)
    let mut i_d = 0
    while i_d < T * d {
        let _ = farr_set(dh, i_d, farr_get(dXout, i_d))
        i_d = i_d + 1
    }

    // 8 reversed (SwiGLU per position) — produces dr [d] per pos, accum dWg/dWu/dWd
    // Phase 4-A-bwd partial 2: dWd accumulator farr_matmul-routed
    //   (Σ_ts dout[ts]⊗s[ts] = dXout^T · sw_s).
    // Phase 4-A-bwd partial 4 (2026-05-17): dWg/dWu also batched —
    //   collect da/db per-ts into da_all/db_all [T·h] then accum via
    //   _db_grad_accum_farr (Σ_ts da[ts]⊗rin2[ts] = da_all^T · rin2).
    _db_grad_accum_farr(dXout, 0, Bc, oSwS, Bg, WD, T, d, h)
    let dr_pos = farr_zeros(d)
    let ds_pos = farr_zeros(h)
    let da_pos = farr_zeros(h)
    let db_pos = farr_zeros(h)
    let da_all = farr_zeros(T * h)
    let db_all = farr_zeros(T * h)
    let mut ts = 0
    while ts < T {
        // dWd already accumulated via _db_grad_accum_farr above.
        // ds[k] = Σ_r Wd[r·h + k] · dso[r]
        let mut k2 = 0
        while k2 < h {
            let mut acc = 0.0
            let mut rr = 0
            while rr < d {
                acc = acc + farr_get(Bp, WD + rr * h + k2)
                          * farr_get(dXout, ts * d + rr)
                rr = rr + 1
            }
            let _ = farr_set(ds_pos, k2, acc)
            k2 = k2 + 1
        }
        // da[k] = ds·b·silu'(a) ; db[k] = ds·silu(a). Also batch into
        // da_all/db_all so dWg/dWu can be batched-accumulated after the
        // ts loop (Phase 4-A-bwd partial 4).
        let mut k3 = 0
        while k3 < h {
            let ak = farr_get(Bc, oSwA + ts * h + k3)
            let bk = farr_get(Bc, oSwB + ts * h + k3)
            let dsk = farr_get(ds_pos, k3)
            let da_v = dsk * bk * _db_silu_grad(ak)
            let db_v = dsk * _db_silu(ak)
            let _ = farr_set(da_pos, k3, da_v)
            let _ = farr_set(db_pos, k3, db_v)
            let _ = farr_set(da_all, ts * h + k3, da_v)
            let _ = farr_set(db_all, ts * h + k3, db_v)
            k3 = k3 + 1
        }
        // dWg/dWu accumulation moved to batched call after ts loop.
        // dr[c] = Σ_k (Wg[k·d+c] · da[k] + Wu[k·d+c] · db[k])
        let mut cc2 = 0
        while cc2 < d {
            let mut acc2 = 0.0
            let mut k5 = 0
            while k5 < h {
                acc2 = acc2 + farr_get(Bp, WG + k5 * d + cc2) * farr_get(da_pos, k5)
                            + farr_get(Bp, WU + k5 * d + cc2) * farr_get(db_pos, k5)
                k5 = k5 + 1
            }
            let _ = farr_set(dr_pos, cc2, acc2)
            cc2 = cc2 + 1
        }
        // 7 reversed (RMSNorm(hstate, g2) ← rin2): dr → [dh += dx_from_rms, dg2 +=]
        //   dxn[i] = dr·g2 ; dg2[i] += dr·rm2xn ; dot = Σ dxn·hstate
        //   dh[i] += inv·dxn[i] − (inv³/d · hstate[i]) · dot
        let inv2 = farr_get(Bc, oR2inv + ts)
        let mut dot2 = 0.0
        let mut i7 = 0
        while i7 < d {
            let dxn_i = farr_get(dr_pos, i7) * farr_get(Bp, G2 + i7)
            let cur_dg2 = farr_get(Bg, G2 + i7)
            let _ = farr_set(Bg, G2 + i7,
                             cur_dg2 + farr_get(dr_pos, i7)
                                     * farr_get(Bc, oRm2xn + ts * d + i7))
            dot2 = dot2 + dxn_i * farr_get(Bc, oHstate + ts * d + i7)
            // store dxn in dr_pos as scratch (overwritten in pass 2)
            let _ = farr_set(dr_pos, i7, dxn_i)
            i7 = i7 + 1
        }
        let inv3_2 = inv2 * inv2 * inv2
        let scl2 = (inv3_2 / to_float(d)) * dot2
        let mut i8 = 0
        while i8 < d {
            let dxn_j = farr_get(dr_pos, i8)
            let xj = farr_get(Bc, oHstate + ts * d + i8)
            let dh_contrib = inv2 * dxn_j - scl2 * xj
            let cur_dh = farr_get(dh, ts * d + i8)
            let _ = farr_set(dh, ts * d + i8, cur_dh + dh_contrib)
            i8 = i8 + 1
        }
        ts = ts + 1
    }
    // batched dWg/dWu accumulation across all ts (Phase 4-A-bwd partial 4).
    //   dWg[k·d+c] += Σ_ts da_all[ts·h+k] · rin2[ts·d+c]  = da_all^T · rin2
    _db_grad_accum_farr(da_all, 0, Bc, oRin2, Bg, WG, T, h, d)
    _db_grad_accum_farr(db_all, 0, Bc, oRin2, Bg, WU, T, h, d)
    let _ = farr_free(dr_pos)
    let _ = farr_free(ds_pos)
    let _ = farr_free(da_pos)
    let _ = farr_free(db_pos)
    let _ = farr_free(da_all)
    let _ = farr_free(db_all)

    // 6 reversed (hstate = X + attn_out): dX_residual += dh ; dattn_out = dh
    // 5 reversed (attn_out = ctx · Wo^T per pos):
    //   dWo[r·d+c] += Σ_t dattn_out[t,r] · ctx[t,c]   (dh^T · ctx outer-product)
    //   dctx[t,c] = Σ_r Wo[r·d+c] · dattn_out[t,r]    (per-t inner dot)
    // Phase 4-A-bwd partial 3 (2026-05-17): dWo accumulator via helper.
    _db_grad_accum_farr(dh, 0, Bc, oCtx, Bg, WO, T, d, d)
    let dctx = farr_zeros(T * d)
    let mut t_w = 0
    while t_w < T {
        // dctx[t,c] = Σ_r Wo[r·d+c] · dattn_out[t,r]
        let mut c2 = 0
        while c2 < d {
            let mut acc = 0.0
            let mut rr = 0
            while rr < d {
                acc = acc + farr_get(Bp, WO + rr * d + c2)
                          * farr_get(dh, t_w * d + rr)
                rr = rr + 1
            }
            let _ = farr_set(dctx, t_w * d + c2, acc)
            c2 = c2 + 1
        }
        t_w = t_w + 1
    }

    // 4 reversed (attention core): given dctx → dQ, dK, dV  (rotated-space grads).
    //   See nn_attn_core_bwd. Same algebra, reading from Bc offsets.
    let dQ = farr_zeros(T * d)        // = T · nh · hd
    let dK = farr_zeros(T * kvd)
    let dV = farr_zeros(T * kvd)
    let dP_row = farr_zeros(T)
    let mut hh_b = 0
    while hh_b < nh {
        let kvh = hh_b / n_rep
        let mut i_b = 0
        while i_b < T {
            let L = i_b + 1
            // dP[j] = Σ_c dctx[i, hh, c] · V[j, kvh, c]
            let mut j = 0
            while j < L {
                let mut acc = 0.0
                let mut c = 0
                while c < hd {
                    acc = acc + farr_get(dctx, i_b * d + hh_b * hd + c)
                              * farr_get(Bc, oV + (j * nkv + kvh) * hd + c)
                    c = c + 1
                }
                let _ = farr_set(dP_row, j, acc)
                j = j + 1
            }
            let mut sdot = 0.0
            let mut j2 = 0
            while j2 < L {
                sdot = sdot + farr_get(Bc, oP + (hh_b * T + i_b) * T + j2)
                            * farr_get(dP_row, j2)
                j2 = j2 + 1
            }
            // dV[j, kvh, c] += P[i,j] · dctx[i, hh, c]
            let mut j3 = 0
            while j3 < L {
                let pij = farr_get(Bc, oP + (hh_b * T + i_b) * T + j3)
                let mut c = 0
                while c < hd {
                    let idx_dv = (j3 * nkv + kvh) * hd + c
                    let cur = farr_get(dV, idx_dv)
                    let _ = farr_set(dV, idx_dv,
                                     cur + pij * farr_get(dctx, i_b * d + hh_b * hd + c))
                    c = c + 1
                }
                j3 = j3 + 1
            }
            // dS[i,j] = P · (dP - sdot) · scale ; dQ += dS·K ; dK += dS·Q
            let mut j4 = 0
            while j4 < L {
                let dS = farr_get(Bc, oP + (hh_b * T + i_b) * T + j4)
                       * (farr_get(dP_row, j4) - sdot) * scale
                let mut c2 = 0
                while c2 < hd {
                    let idx_dq = (i_b * nh + hh_b) * hd + c2
                    let idx_dk = (j4 * nkv + kvh) * hd + c2
                    let cur_q = farr_get(dQ, idx_dq)
                    let _ = farr_set(dQ, idx_dq,
                                     cur_q + dS * farr_get(Bc, oK + (j4 * nkv + kvh) * hd + c2))
                    let cur_k = farr_get(dK, idx_dk)
                    let _ = farr_set(dK, idx_dk,
                                     cur_k + dS * farr_get(Bc, oQ + (i_b * nh + hh_b) * hd + c2))
                    c2 = c2 + 1
                }
                j4 = j4 + 1
            }
            i_b = i_b + 1
        }
        hh_b = hh_b + 1
    }
    let _ = farr_free(dP_row)
    let _ = farr_free(dctx)

    // 3 reversed (RoPE on Q, K): per head/position apply inverse rotation
    // dq_pre[c] = dq'[c]·cos[bse+c] + rh_T(dq'·sin)[c]
    let half = hd / 2
    let tmp_rope = farr_zeros(hd)
    let mut t_r3 = 0
    while t_r3 < T {
        let bse = t_r3 * hd
        // dQ inverse-rotate per head
        let mut hh3 = 0
        while hh3 < nh {
            let row_off = (t_r3 * nh + hh3) * hd
            let mut c = 0
            while c < hd {
                let gs_for_rht = if c < half {
                    farr_get(dQ, row_off + half + c) * farr_get(sin, bse + half + c)
                } else {
                    0.0 - farr_get(dQ, row_off + c - half) * farr_get(sin, bse + c - half)
                }
                let v = farr_get(dQ, row_off + c) * farr_get(cos, bse + c) + gs_for_rht
                let _ = farr_set(tmp_rope, c, v)
                c = c + 1
            }
            let mut c2 = 0
            while c2 < hd {
                let _ = farr_set(dQ, row_off + c2, farr_get(tmp_rope, c2))
                c2 = c2 + 1
            }
            hh3 = hh3 + 1
        }
        // dK inverse-rotate per kv-head
        let mut hk = 0
        while hk < nkv {
            let row_off = (t_r3 * nkv + hk) * hd
            let mut c = 0
            while c < hd {
                let gs_for_rht = if c < half {
                    farr_get(dK, row_off + half + c) * farr_get(sin, bse + half + c)
                } else {
                    0.0 - farr_get(dK, row_off + c - half) * farr_get(sin, bse + c - half)
                }
                let v = farr_get(dK, row_off + c) * farr_get(cos, bse + c) + gs_for_rht
                let _ = farr_set(tmp_rope, c, v)
                c = c + 1
            }
            let mut c2 = 0
            while c2 < hd {
                let _ = farr_set(dK, row_off + c2, farr_get(tmp_rope, c2))
                c2 = c2 + 1
            }
            hk = hk + 1
        }
        t_r3 = t_r3 + 1
    }
    let _ = farr_free(tmp_rope)

    // 2 reversed (Q/K/V projections): given dQ/dK/dV → dWq/dWk/dWv + drin accum
    // Phase 4-A-bwd (2026-05-17): dW_? accumulators farr_matmul-routed
    // via _db_grad_accum_farr (Σ_t outer-prod = dY^T · W^T reshape).
    // Honest carve-out: drin (per-t inner-dot reduction over d+2·kvd=64
    // for T·d=512 elements) was tested as 3 separate farr_matmul calls
    // in an earlier draft of this commit; that produced a measurable
    // wall REGRESSION (bwd 12→14ms, full corpus 12.30→14.16s) because
    // 3 buffer copies + 3 farr allocs + 3 frees + element-wise add
    // exceeded the inline single-accumulator cost at this scale.
    // Reverted to the inline form below.
    _db_grad_accum_farr(dQ, 0, Bc, oRin, Bg, WQ, T, d,   d)
    _db_grad_accum_farr(dK, 0, Bc, oRin, Bg, WK, T, kvd, d)
    _db_grad_accum_farr(dV, 0, Bc, oRin, Bg, WV, T, kvd, d)
    let drin = farr_zeros(T * d)
    let mut t_p = 0
    while t_p < T {
        // drin[t, c] = Σ_r Wq[r,c]·dQ[t,r] + Σ_r Wk[r,c]·dK[t,r] + Σ_r Wv[r,c]·dV[t,r]
        let mut cc = 0
        while cc < d {
            let mut acc = 0.0
            let mut rr = 0
            while rr < d {
                acc = acc + farr_get(Bp, WQ + rr * d + cc) * farr_get(dQ, t_p * d + rr)
                rr = rr + 1
            }
            let mut rk2 = 0
            while rk2 < kvd {
                acc = acc + farr_get(Bp, WK + rk2 * d + cc) * farr_get(dK, t_p * kvd + rk2)
                          + farr_get(Bp, WV + rk2 * d + cc) * farr_get(dV, t_p * kvd + rk2)
                rk2 = rk2 + 1
            }
            let _ = farr_set(drin, t_p * d + cc, acc)
            cc = cc + 1
        }
        t_p = t_p + 1
    }
    let _ = farr_free(dQ)
    let _ = farr_free(dK)
    let _ = farr_free(dV)

    // 1 reversed (RMSNorm(X, g1) → rin): drin → [dx, dg1]
    //   dxn[i] = drin·g1 ; dg1[i] += drin·rm1xn ; dot = Σ dxn·X
    //   dx[i] = inv·dxn[i] − (inv³·X[i]/d)·dot
    // Then dX_out += dh + dx  (residual + path).
    let dx_pos = farr_zeros(d)
    let mut ti = 0
    while ti < T {
        let inv1 = farr_get(Bc, oR1inv + ti)
        let mut dot1 = 0.0
        let mut i_r = 0
        while i_r < d {
            let dxn_i = farr_get(drin, ti * d + i_r) * farr_get(Bp, G1 + i_r)
            let cur_dg1 = farr_get(Bg, G1 + i_r)
            let _ = farr_set(Bg, G1 + i_r,
                             cur_dg1 + farr_get(drin, ti * d + i_r)
                                     * farr_get(Bc, oRm1xn + ti * d + i_r))
            dot1 = dot1 + dxn_i * farr_get(X, ti * d + i_r)
            let _ = farr_set(dx_pos, i_r, dxn_i)
            i_r = i_r + 1
        }
        let inv3_1 = inv1 * inv1 * inv1
        let scl1 = (inv3_1 / to_float(d)) * dot1
        let mut i_d2 = 0
        while i_d2 < d {
            let dxn_j = farr_get(dx_pos, i_d2)
            let xj = farr_get(X, ti * d + i_d2)
            let dx_contrib = inv1 * dxn_j - scl1 * xj
            // dX_out += dh + dx_contrib   (path + residual already in dh)
            let cur = farr_get(dX_out, ti * d + i_d2)
            let _ = farr_set(dX_out, ti * d + i_d2,
                             cur + farr_get(dh, ti * d + i_d2) + dx_contrib)
            i_d2 = i_d2 + 1
        }
        ti = ti + 1
    }
    let _ = farr_free(dx_pos)
    let _ = farr_free(drin)
    let _ = farr_free(dh)
}

// ── oracle helpers ───────────────────────────────────────────────────────
fn _abs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

fn _dt_ln_stable(x: float) -> float {
    let mut v = x
    let mut k = 0
    while v >= 2.0 { v = v / 2.0; k = k + 1 }
    while v < 1.0 { v = v * 2.0; k = k - 1 }
    return dt_ln(v) + to_float(k) * dt_ln(2.0)
}

fn _rope_build_tables_dt(T: int, hd: int, cos_out: int, sin_out: int, base: float) {
    let half = hd / 2
    let lnb = _dt_ln_stable(base)
    let mut p = 0
    while p < T {
        let mut c = 0
        while c < hd {
            let fi = if c < half { c } else { c - half }
            let ex = (to_float(2 * fi) / to_float(hd)) * lnb
            let invf = 1.0 / dt_exp(ex)
            let ang = to_float(p) * invf
            let _ = farr_set(cos_out, p * hd + c, d5_cos(ang))
            let _ = farr_set(sin_out, p * hd + c, d5_sin(ang))
            c = c + 1
        }
        p = p + 1
    }
}

fn _farr_checksum(t: int, n: int) -> int {
    let mut acc = 1469598903
    let mut i = 0
    while i < n {
        let b = f64_to_bytes_le(farr_get(t, i))
        let mut k = 0
        while k < len(b) {
            acc = (acc * 131 + b[k] + i) % 2147483647
            k = k + 1
        }
        i = i + 1
    }
    return acc
}

fn _maxdiff(a: int, b: int, n: int) -> float {
    let mut m = 0.0
    let mut i = 0
    while i < n {
        let dv = _abs(farr_get(a, i) - farr_get(b, i))
        if dv > m { m = dv }
        i = i + 1
    }
    return m
}

// ── driver (identical config to op29_decoder_block_determinism_eq.hexa) ───
println("=== HEXA-0POD OP-29 · SELF-CONTAINED decoder-block 2nd-arch oracle ===")

let T = 4
let d = 8
let nh = 2
let nkv = 1
let h = 16
let hd = d / nh

let np = bp_total(d, nh, nkv, h)
let Bp = farr_zeros(np)
t_fill_lcg2(Bp, np, 4242, 0.1)

let X = farr_zeros(T * d)
t_fill_lcg2(X, T * d, 9001, 0.2)

let cos = farr_zeros(T * hd)
let sin = farr_zeros(T * hd)
_rope_build_tables_dt(T, hd, cos, sin, 10000.0)

let nc = bc_total(T, d, nh, nkv, h)
let oXout = bc_off_Xout(T, d, nh, nkv, h)

let Bc1 = farr_zeros(nc)
let Bc2 = farr_zeros(nc)
nn_decoder_block_fwd(X, Bp, Bc1, cos, sin, T, d, nh, nkv, h)
nn_decoder_block_fwd(X, Bp, Bc2, cos, sin, T, d, nh, nkv, h)

let xout1 = farr_zeros(T * d)
let xout2 = farr_zeros(T * d)
let mut ix = 0
while ix < T * d {
    let _ = farr_set(xout1, ix, farr_get(Bc1, oXout + ix))
    let _ = farr_set(xout2, ix, farr_get(Bc2, oXout + ix))
    ix = ix + 1
}
let fwd_dev = _maxdiff(xout1, xout2, T * d)
let fwd_ck = _farr_checksum(xout1, T * d)

let dXout = farr_zeros(T * d)
let mut ig = 0
while ig < T * d {
    let _ = farr_set(dXout, ig, farr_get(Bc1, oXout + ig))
    ig = ig + 1
}

let Bg1 = farr_zeros(np)
let Bg2 = farr_zeros(np)
let dX1 = farr_zeros(T * d)
let dX2 = farr_zeros(T * d)
nn_decoder_block_bwd(X, Bp, Bc1, dXout, dX1, Bg1, cos, sin, T, d, nh, nkv, h)
nn_decoder_block_bwd(X, Bp, Bc2, dXout, dX2, Bg2, cos, sin, T, d, nh, nkv, h)

let bwd_grad_dev = _maxdiff(Bg1, Bg2, np)
let bwd_dx_dev = _maxdiff(dX1, dX2, T * d)
let grad_ck = _farr_checksum(Bg1, np)

print("  (1) FWD   Xout max|Δ| run-to-run = "); println(fwd_dev)
print("  (2) BWD   grad max|Δ| run-to-run = "); println(bwd_grad_dev)
print("      BWD   dX   max|Δ| run-to-run = "); println(bwd_dx_dev)
print("  fwd  Xout checksum = "); println(fwd_ck)
print("  grad      checksum = "); println(grad_ck)
let fbytes = f64_to_bytes_le(to_float(fwd_ck))
print("  CROSSPLAT-FINGERPRINT-FWD  = ")
let mut bi = 0
while bi < len(fbytes) { print(fbytes[bi]); print(" "); bi = bi + 1 }
println("")
let gbytes = f64_to_bytes_le(to_float(grad_ck))
print("  CROSSPLAT-FINGERPRINT-GRAD = ")
let mut bj = 0
while bj < len(gbytes) { print(gbytes[bj]); print(" "); bj = bj + 1 }
println("")

let det_ok = (fwd_dev == 0.0) && (bwd_grad_dev == 0.0) && (bwd_dx_dev == 0.0)
if det_ok {
    print("F-OP29-2ND-ARCH = 1")
    println("")
    println("PASS — decoder block byte-eq run-to-run; libm-free => machine-independent.")
} else {
    print("F-OP29-2ND-ARCH = 0")
    println("")
    println("FAIL — not byte-eq run-to-run.")
}
