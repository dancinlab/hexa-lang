// ════════════════════════════════════════════════════════════════════════════
//  clm_ckpt.hexa — .clm checkpoint export/import (PR2 of CLM_PROD_TRAINER_PLAN).
//
//  Serializes the CLMConvMoE int4-QAT weights to the anima `.clm` format
//  (anima:CLM/CLM_FORMAT_SPEC.md §2/§3): per-block int4-sym packed nibbles +
//  per-output-channel qat_scale (fp32 little-endian), behind a "CLM\x01" magic,
//  with a whole-file sha256 manifest. Round-trips through write_bytes /
//  read_file_bytes; floats via the f32_to_bytes_le / bytes_to_f32_le builtins.
//
//  Layout v0.1 (int4 inference track, the .clm.i 2-track member):
//    [MAGIC "CLM\x01"] [nblocks u8]
//    per block: [Cout u32-le][rest u32-le]
//               [int4 nibbles: ceil(Cout*rest/2) bytes, (q+8) packed 2/byte]
//               [qat_scale: Cout * 4 bytes fp32-le]
//    (fp16 shadow track + HEADER/MANIFEST json are layered in a later PR.)
//
//  Layout v0.2 (BACKWARD-COMPATIBLE extension — embed table + GroupNorm affine
//  + conv biases, per anima:CLM/CLM_FORMAT_SPEC.md §2 v0.2):
//    ... v0.1 [MAGIC][nblocks=6][6 conv blocks] ...
//    [EXT_MAGIC "CLMX" = 67,76,77,88] [n_ext u8]
//    per ext entry: [len u32-le] [len × fp32-le]      // FULL-PRECISION fp32
//  The extension is APPENDED AFTER the v0.1 conv blocks. A v0.1 reader reads
//  exactly `nblocks` conv blocks and STOPS — it never looks past block 6, so an
//  old reader is byte-unaffected (backward-read PRESERVED). A v0.2 reader, after
//  the 6 conv blocks, peeks for the "CLMX" ext-magic; absent ⇒ legacy 6-block
//  file (embed/GN reconstructed by the decoder stand-in); present ⇒ the trained
//  embed table + GN affine (tgG/tgB/noG/noB) + conv biases are read VERBATIM at
//  fp32 (these are precision-critical for CE descent and small in count, so they
//  are stored full-precision, NOT int4-quantized).
//
//  Ext entry order (must match clm_prod_fwd's parameter set):
//    0 embed[V·d]  1 ecB[d]  2 tcB[d]  3 e0B[d]  4 e1B[d]  5 rB[E]  6 roB[V]
//    7 tgG[d]  8 tgB[d]  9 noG[d]  10 noB[d]
//
//  F-CLM-CKPT-ROUNDTRIP: save→load reproduces every block byte-identically —
//  int4 codes exact (integer) and qat_scale identical at fp32 (f32 byte-equal).
//  Since loaded (wq, scale) == saved, the dequantized weights and hence the
//  logits are reproduced (determinism); the gate asserts the (wq, scale) pair.
//  F-CLM-CKPT-EXT-ROUNDTRIP: the v0.2 ext trailer save→load reproduces every
//  fp32 ext entry byte-identically (f32 byte-equal), AND a v0.1 reader on a v0.2
//  file still reads the 6 conv blocks unchanged (backward-read preserved).
// ════════════════════════════════════════════════════════════════════════════

use "stdlib/flame/tensor_lib"
use "stdlib/flame/quant_lib"

// int4-sym quant: w -> codes (qlevel in [-7,7]) + per-channel scale. The
// dequantized fake-quant weight (wq_out = code*scale) is a discarded temp here;
// the checkpoint stores the integer codes + scale (dequant = code*scale on load).
fn _quant(w: int, codes: int, scale: int, cout: int, rest: int) {
    let wq = t_zeros(cout * rest); let mask = t_zeros(cout * rest)
    nn_int4_quant_fwd(w, wq, scale, codes, mask, cout, rest)
}

fn _push_u32(buf, n: int) {
    buf.push(n & 0xFF); buf.push((n / 0x100) & 0xFF)
    buf.push((n / 0x10000) & 0xFF); buf.push((n / 0x1000000) & 0xFF)
}
fn _rd_u32(rb, off: int) -> int {
    return rb[off] + rb[off+1]*0x100 + rb[off+2]*0x10000 + rb[off+3]*0x1000000
}
fn _push_f32(buf, f: float) {
    let b = f32_to_bytes_le(f)
    let mut i = 0
    while i < 4 { buf.push(b[i]); i = i + 1 }
}

// ── v0.2 extension trailer (embed + GN affine + conv biases) ─────────────────
// EXT_MAGIC "CLMX" = 67('C') 76('L') 77('M') 88('X'). Each ext entry is a
// length-prefixed fp32-le vector (FULL precision — descent-critical + small).

// clm_ext_save_entry — append one fp32 ext vector: [len u32-le][len × fp32-le].
pub fn clm_ext_save_entry(buf, t: int, n: int) {
    _push_u32(buf, n)
    let mut i = 0
    while i < n { _push_f32(buf, t_get(t, i)); i = i + 1 }
}

// clm_ext_begin — append the ext-magic + entry count. Call ONCE after the v0.1
// conv blocks, before the ext entries.
pub fn clm_ext_begin(buf, n_ext: int) {
    buf.push(67); buf.push(76); buf.push(77); buf.push(88)   // "CLMX"
    buf.push(n_ext)
}

// clm_ext_present — does the byte buffer carry a v0.2 ext trailer starting at
// `off` (the byte index right after the last v0.1 conv block)? Backward-safe:
// a legacy v0.1 file has no bytes there (or non-CLMX bytes) → false.
pub fn clm_ext_present(rb, off: int) -> int {
    if off + 5 > len(rb) { return 0 }
    if rb[off] == 67 && rb[off+1] == 76 && rb[off+2] == 77 && rb[off+3] == 88 { return 1 }
    return 0
}

// clm_ext_load_entry — read one fp32 ext vector into t_out (caller-allocated to
// the stored length); returns the new offset. Assumes off points at the [len].
pub fn clm_ext_load_entry(rb, off: int, t_out: int) -> int {
    let n = _rd_u32(rb, off); off = off + 4
    let mut i = 0
    while i < n { t_set(t_out, i, bytes_to_f32_le(rb, off)); off = off + 4; i = i + 1 }
    return off
}

// clm_ext_entry_eq — fp32 byte-identical equality of two ext vectors of length n.
fn clm_ext_entry_eq(a: int, b: int, n: int) -> int {
    let mut i = 0
    while i < n {
        let ba = f32_to_bytes_le(t_get(a, i))
        let bb = f32_to_bytes_le(t_get(b, i))
        let mut k = 0
        while k < 4 { if ba[k] != bb[k] { return 0 }; k = k + 1 }
        i = i + 1
    }
    return 1
}

// Append one block: dims + int4 nibbles (q+8 packed 2/byte) + fp32-le scales.
fn save_block(buf, wq: int, scale: int, cout: int, rest: int) {
    _push_u32(buf, cout); _push_u32(buf, rest)
    let n = cout * rest
    let mut i = 0
    while i < n {
        let lo = (to_int(t_get(wq, i)) + 8) & 0xF
        let mut hi = 8
        if i + 1 < n { hi = (to_int(t_get(wq, i + 1)) + 8) & 0xF }
        buf.push(lo + hi * 16)
        i = i + 2
    }
    let mut c = 0
    while c < cout { _push_f32(buf, t_get(scale, c)); c = c + 1 }
}

// Parse one block from rb starting at off; fill wq_out/scale_out; return new off.
fn load_block(rb, off: int, wq_out: int, scale_out: int) -> int {
    let cout = _rd_u32(rb, off); off = off + 4
    let rest = _rd_u32(rb, off); off = off + 4
    let n = cout * rest
    let mut i = 0
    while i < n {
        let byte = rb[off]; off = off + 1
        t_set(wq_out, i, to_float((byte & 0xF) - 8))
        if i + 1 < n { t_set(wq_out, i + 1, to_float(((byte / 16) & 0xF) - 8)) }
        i = i + 2
    }
    let mut c = 0
    while c < cout {
        t_set(scale_out, c, bytes_to_f32_le(rb, off)); off = off + 4; c = c + 1
    }
    return off
}

// Block-equal: int4 codes exact + scale fp32 byte-identical.
fn block_eq(wqA: int, scA: int, wqB: int, scB: int, cout: int, rest: int) -> int {
    let n = cout * rest
    let mut i = 0
    while i < n {
        if t_get(wqA, i) != t_get(wqB, i) { return 0 }
        i = i + 1
    }
    let mut c = 0
    while c < cout {
        let a = f32_to_bytes_le(t_get(scA, c))
        let b = f32_to_bytes_le(t_get(scB, c))
        let mut k = 0
        while k < 4 { if a[k] != b[k] { return 0 }; k = k + 1 }
        c = c + 1
    }
    return 1
}

fn main() {
    println("clm_ckpt — .clm checkpoint export/import (PR2)")
    let d = 8; let E = 2; let V = 256; let K = 3
    let dd = d * d * K; let ed = E * d; let vd = V * d
    let nblocks = 6

    // 6 CLMConvMoE conv weights (LCG init = stand-in for trained weights;
    // round-trip is weight-agnostic). couts/rests mirror clm_qat/clm_prod.
    let ecW=t_zeros(dd); t_fill_lcg(ecW, dd, 2, 0.2)
    let tcW=t_zeros(dd); t_fill_lcg(tcW, dd, 4, 0.2)
    let e0W=t_zeros(dd); t_fill_lcg(e0W, dd, 14, 0.2)
    let e1W=t_zeros(dd); t_fill_lcg(e1W, dd, 16, 0.2)
    let rW=t_zeros(ed);  t_fill_lcg(rW, ed, 12, 0.2)
    let roW=t_zeros(vd); t_fill_lcg(roW, vd, 20, 0.2)
    let Ws    = [ecW, tcW, e0W, e1W, rW, roW]
    let couts = [d, d, d, d, E, V]
    let rests = [d*K, d*K, d*K, d*K, d, d]

    // quantize each block → wq + scale (kept for the post-load comparison)
    let WQ = []; let SC = []
    let mut bi = 0
    while bi < nblocks {
        let cout = couts[bi]; let rest = rests[bi]
        let wq = t_zeros(cout * rest); let sc = t_zeros(cout)
        _quant(Ws[bi], wq, sc, cout, rest)
        WQ.push(wq); SC.push(sc)
        bi = bi + 1
    }

    // ---- SAVE: assemble .clm buffer ----
    let buf = []
    buf.push(67); buf.push(76); buf.push(77); buf.push(1)   // MAGIC "CLM\x01"
    buf.push(nblocks)
    let mut si = 0
    while si < nblocks { save_block(buf, WQ[si], SC[si], couts[si], rests[si]); si = si + 1 }
    let path = "/tmp/clm_ckpt_smoke.clm"
    write_bytes(path, buf)
    print("  wrote "); print(path); print("  ("); print(len(buf)); println(" bytes)")

    // ---- LOAD: parse back ----
    let rb = read_file_bytes(path)
    if rb[0] != 67 { println("F-CLM-CKPT-ROUNDTRIP = 0"); println("FAIL — bad magic"); return }
    let rblocks = rb[4]
    let mut off = 5
    let mut allok = 1
    let mut li = 0
    while li < rblocks {
        let cout = couts[li]; let rest = rests[li]
        let wq2 = t_zeros(cout * rest); let sc2 = t_zeros(cout)
        off = load_block(rb, off, wq2, sc2)
        if block_eq(WQ[li], SC[li], wq2, sc2, cout, rest) == 0 { allok = 0 }
        li = li + 1
    }

    print("  reload blocks="); print(rblocks); print("/"); println(nblocks)
    let conv_ok = if allok == 1 && rblocks == nblocks { 1 } else { 0 }
    println("F-CLM-CKPT-ROUNDTRIP = " + to_string(conv_ok))

    // ---- v0.2 EXT roundtrip: append embed + GN affine, read back fp32-eq ----
    // The conv-block offset after 6 blocks is exactly `off` (load loop advanced it).
    let embed = t_zeros(vd); t_fill_lcg(embed, vd, 1, 0.3)
    let tgG = t_zeros(d);    t_fill_lcg(tgG, d, 6, 0.5)
    let noB = t_zeros(d);    t_fill_lcg(noB, d, 19, 0.1)
    let buf2 = buf                                   // start from the v0.1 file bytes
    clm_ext_begin(buf2, 3)
    clm_ext_save_entry(buf2, embed, vd)
    clm_ext_save_entry(buf2, tgG, d)
    clm_ext_save_entry(buf2, noB, d)
    let path2 = "/tmp/clm_ckpt_smoke_v2.clm"
    write_bytes(path2, buf2)
    let rb2 = read_file_bytes(path2)
    // re-walk the 6 conv blocks to find the ext offset (v0.1 backward-read intact)
    let mut o2 = 5; let mut bb = 0
    while bb < 6 {
        let cout = couts[bb]; let rest = rests[bb]
        let wqx = t_zeros(cout * rest); let scx = t_zeros(cout)
        o2 = load_block(rb2, o2, wqx, scx)
        bb = bb + 1
    }
    let ext_here = clm_ext_present(rb2, o2)
    let mut ext_ok = 0
    if ext_here == 1 {
        let n_ext = rb2[o2 + 4]                        // byte after the 4 magic bytes
        let off3 = o2 + 5
        let e_embed = t_zeros(vd); let e_tgG = t_zeros(d); let e_noB = t_zeros(d)
        let mut p = off3
        p = clm_ext_load_entry(rb2, p, e_embed)
        p = clm_ext_load_entry(rb2, p, e_tgG)
        p = clm_ext_load_entry(rb2, p, e_noB)
        let ee = clm_ext_entry_eq(embed, e_embed, vd)
        let eg = clm_ext_entry_eq(tgG, e_tgG, d)
        let en = clm_ext_entry_eq(noB, e_noB, d)
        if n_ext == 3 && ee == 1 && eg == 1 && en == 1 { ext_ok = 1 }
    }
    // backward-read: a v0.1 reader on the v0.2 file still reads 6 blocks correctly.
    let bw_ok = if rb2[0] == 67 && rb2[4] == nblocks { 1 } else { 0 }
    println("F-CLM-CKPT-EXT-ROUNDTRIP = " + to_string(ext_ok))
    println("F-CLM-CKPT-EXT-BACKWARD-READ = " + to_string(bw_ok))

    if conv_ok == 1 && ext_ok == 1 && bw_ok == 1 {
        println("PASS — .clm v0.1 conv roundtrip + v0.2 ext (embed/GN) fp32-eq + v0.1 backward-read")
        return
    }
    println("FAIL")
}
