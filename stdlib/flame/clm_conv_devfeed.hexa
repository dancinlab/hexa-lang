// ════════════════════════════════════════════════════════════════════════════
//  clm_conv_devfeed.hexa — LEVER (a): device-side im2col/col2im + device AdamW.
//
//  Lever (b) (clm_conv_batched.hexa) fused the per-step expert-conv GEMMs but did
//  NOT touch the DOMINANT Lane-G util peg: the host-side im2col/col2im gather +
//  the per-weight host adam loop. Each step the trainer rebuilds x_col on the host
//  with t_set (host-dirty), so every forge GEMM re-H2D's it; and every _adam()
//  call runs a host scalar loop between micro-GEMMs. One CPU core stays at 100%
//  and the GPU starves (PEAK 4-6%, MEAN 0.24%, scale-invariant).
//
//  Lever (a) removes that peg by keeping the backward feed DEVICE-RESIDENT:
//    1. im2col / col2im run as device kernels writing a FARR_DEVICE x_col, fed
//       STRAIGHT into the (already-device) GEMM with NO intervening D2H/H2D — the
//       GEMM reads the device buffer in place (FARR_DEVICE residency bookkeeping).
//    2. AdamW runs on-device (_hx_cuda_farr_adamw_step_inplace_gpu, already byte-
//       eq to the host oracle) so the optimizer step + m/v state stay on device.
//
//  This FILE is the CPU-LOCAL byte-eq ORACLE + selftest surface (the lever-(b)
//  playbook). It calls ONLY builtins present in the prebuilt binary
//  (forge_dispatch_matmul, adamw_step) so it runs $0 on Mac CPU with `hexa run`,
//  no self-host rebuild needed. The device-resident path (the new builtins
//  forge_dispatch_im2col / forge_dispatch_col2im / forge_dispatch_adamw) is wired
//  ONLY in clm_prod.hexa behind env CLM_PROD_DEVFEED — compiled on the GPU pod's
//  self-host rebuild, never on the mac binary. The host gather/scatter/adam below
//  are the exact byte-eq reference those device kernels must match.
//
//  GRAD-EXACT contract (matches the conv→forge byte-eq bar #2352 / #2383 and the
//  lever-(b) bar #2504):
//    F-CLM-DEVFEED-IM2COL-EQ : devfeed_im2col gather   == inline xcol reference
//    F-CLM-DEVFEED-FWD-EQ    : conv via devfeed im2col  == reference forge conv (fwd)
//    F-CLM-DEVFEED-BWD-EQ    : conv bwd via devfeed     == reference forge conv bwd
//    F-CLM-DEVFEED-ADAM-EQ   : adamw_step oracle trajectory self-consistent (host)
//  All max|Δ| = 0.0 exact on CPU; the GPU-busy util measurement is the single
//  small fire after lever (a)+(b) are locally green.
//
//  sibling: clm_conv_gpu.hexa (un-batched forge) · clm_conv_batched.hexa (lever b).
// ════════════════════════════════════════════════════════════════════════════

use "stdlib/flame/tensor_lib"
use "stdlib/flame/conv_lib"
use "stdlib/flame/optim_lib"
use "stdlib/flame/quant_lib"

fn _df_absf(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

// ── devfeed_im2col: build x_col[T, Cin·K] from x[T, Cin] (causal dilated) ──
// EXACT gather of conv1d_via_forge's im2col: x_col[t, ci*K+k] = (p>=0)?x[p,ci]:0,
// p = t - dil*(K-1-k). On CPU this IS the host loop; the device builtin
// forge_dispatch_im2col runs the SAME gather as a kernel writing a FARR_DEVICE
// buffer (one thread per (t, ci*K+k) output cell — no atomics; pure gather), so
// the GEMM consumes it with no D2H/H2D roundtrip. Caller allocates xcol[T·Kdim].
pub fn devfeed_im2col(x: int, xcol_out: int, T: int, Cin: int, K: int, dil: int) {
    let Kdim = Cin * K
    let mut iz = 0
    while iz < T * Kdim { t_set(xcol_out, iz, 0.0); iz = iz + 1 }
    let mut t = 0
    while t < T {
        let mut ci = 0
        while ci < Cin {
            let mut k = 0
            while k < K {
                let p = t - dil * (K - 1 - k)
                if p >= 0 { t_set(xcol_out, t * Kdim + ci * K + k, t_get(x, p * Cin + ci)) }
                k = k + 1
            }
            ci = ci + 1
        }
        t = t + 1
    }
}

// ── devfeed_im2col_T: build xcolT[Cin·K, T] (transpose form, backward dW) ──
// EXACT gather of conv1d_bwd_via_forge's xcolT: xcolT[j, t] = (p>=0)?x[p,ci]:0,
// j = ci*K+k, p = t - dil*(K-1-k). Device builtin = transpose-gather kernel,
// FARR_DEVICE, fed straight into the dW GEMM. Caller allocates xcolT[Kdim·T].
pub fn devfeed_im2col_T(x: int, xcolT_out: int, T: int, Cin: int, K: int, dil: int) {
    let Kdim = Cin * K
    let mut iz = 0
    while iz < Kdim * T { t_set(xcolT_out, iz, 0.0); iz = iz + 1 }
    let mut t = 0
    while t < T {
        let mut ci = 0
        while ci < Cin {
            let mut k = 0
            while k < K {
                let p = t - dil * (K - 1 - k)
                if p >= 0 {
                    let j = ci * K + k
                    t_set(xcolT_out, j * T + t, t_get(x, p * Cin + ci))
                }
                k = k + 1
            }
            ci = ci + 1
        }
        t = t + 1
    }
}

// ── devfeed_col2im: scatter-add dXcol[T, Cin·K] back to dX[T, Cin] ──
// EXACT transpose of the im2col gather, expressed in the TRANSPOSE-GATHER form
// (one thread per dX[p,ci] output cell summing the K dilated taps that scatter
// into it — NO atomics → deterministic, byte-eq to the host scatter order):
//   dX[p,ci] = Σ_k dXcol[t*Kdim + (ci*K+k)] with t = p + dil*(K-1-k), t in [0,T).
// This is algebraically identical to conv1d_bwd_via_forge's scatter
//   dX[p*Cin+ci] += dXcol[t*Kdim + j]  for each (t,k) with p = t - dil*(K-1-k)≥0,
// reindexed so each output is written exactly once. Caller allocates dX.
pub fn devfeed_col2im(dXcol: int, dX_out: int, T: int, Cin: int, K: int, dil: int) {
    let Kdim = Cin * K
    let mut iz = 0
    while iz < T * Cin { t_set(dX_out, iz, 0.0); iz = iz + 1 }
    let mut p = 0
    while p < T {
        let mut ci = 0
        while ci < Cin {
            let mut acc = 0.0
            let mut k = 0
            while k < K {
                let t = p + dil * (K - 1 - k)
                if t < T {
                    let j = ci * K + k
                    acc = acc + t_get(dXcol, t * Kdim + j)
                }
                k = k + 1
            }
            t_set(dX_out, p * Cin + ci, acc)
            ci = ci + 1
        }
        p = p + 1
    }
}

// ── devfeed_db_colsum: bias-gradient column sum db[co] = Σ_t dy[t,co] ──
// HEXA-FUSION L1 (GRAD half) — the REFERENCE host reduction that the device
// kernel _hx_cuda_farr_db_colsum_gpu reproduces. The device kernel sums T
// SEQUENTIALLY per channel (t = 0,1,…,T-1) with NO tree / warp re-association,
// so its IEEE-754 accumulation order is IDENTICAL to this loop → bit-exact
// (max|Δ|=0), unlike the row-reduction kernels which carry a ~N·ε tolerance.
// This oracle deliberately does NOT call forge_dispatch_db_colsum (so the
// prebuilt mac binary never link-references the device builtin under
// `hexa run`); the builtin is wired ONLY in clm_prod.hexa::_clmp_db_colsum
// under env CLM_PROD_DEVRESIDENT and realized in the self-host-rebuilt pod
// binary. The byte-eq guarantee here is the sequential-sum-order equivalence.
pub fn devfeed_db_colsum(dy: int, db_out: int, T: int, Cout: int) {
    let mut cb = 0
    while cb < Cout {
        let mut acc = 0.0
        let mut tb = 0
        while tb < T {
            acc = acc + t_get(dy, tb * Cout + cb)
            tb = tb + 1
        }
        t_set(db_out, cb, acc)
        cb = cb + 1
    }
}

// ── devfeed_int4_quant: device-resident int4 fake-quant (PARAM half) ──────────
// HEXA-FUSION L1 (PARAM half) — the REFERENCE host fake-quant that the device
// kernel _hx_cuda_farr_int4_quant_gpu reproduces. Inlined here (NOT a call into
// quant_lib's nn_int4_quant_fwd, and NOT a call into the device builtin) so the
// prebuilt mac binary never link-references the device builtin under `hexa run`;
// the builtin is wired ONLY in clm_prod.hexa::_fq under env CLM_PROD_DEVRESIDENT
// and realized in the self-host-rebuilt pod binary. int4 is INTEGER rounding +
// per-channel SEQUENTIAL max (NO fp reduction re-association), so the device
// kernel's accumulation is byte-identical — max|Δ| MUST be exactly 0 (no
// FMA-drift excuse). _q_abs / _q_round mirror quant_lib EXACTLY.
fn _dfq_abs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
fn _dfq_round(x: float) -> float {
    if x >= 0.0 { return to_float(to_int(x + 0.5)) }
    return 0.0 - to_float(to_int((0.0 - x) + 0.5))
}
pub fn devfeed_int4_quant(w: int, wq_out: int, scale_out: int,
                          qlevel_out: int, mask_out: int, Cout: int, rest: int) {
    let mut co = 0
    while co < Cout {
        let mut mx = 0.0
        let mut j = 0
        while j < rest {
            let a = _dfq_abs(t_get(w, co * rest + j))
            if a > mx { mx = a }
            j = j + 1
        }
        let s = if mx > 0.0 { mx / 7.0 } else { 1.0 }
        t_set(scale_out, co, s)
        let mut j2 = 0
        while j2 < rest {
            let idx = co * rest + j2
            let r = _dfq_round(t_get(w, idx) / s)
            let mut q = r
            let mut inrange = 1.0
            if q > 7.0 { q = 7.0; inrange = 0.0 }
            if q < 0.0 - 7.0 { q = 0.0 - 7.0; inrange = 0.0 }
            t_set(qlevel_out, idx, q)
            t_set(mask_out, idx, inrange)
            t_set(wq_out, idx, q * s)
            j2 = j2 + 1
        }
        co = co + 1
    }
}

// int4 clipped-STE backward reference: dW[i] = dy[i]·mask[i] (mask ∈ {0,1}).
// Pure elementwise — the device kernel is trivially bit-exact (max|Δ|=0).
pub fn devfeed_int4_quant_bwd(dy: int, mask: int, dW_out: int, n: int) {
    let mut i = 0
    while i < n { t_set(dW_out, i, t_get(dy, i) * t_get(mask, i)); i = i + 1 }
}

// ── devfeed_residual_add: device-resident elementwise residual-add (glue) ─────
// HEXA-FUSION L3 (glue half) — the REFERENCE host residual-add that the device
// kernel _hx_cuda_farr_residual_add_gpu reproduces: out[i] = a[i] + b[i]. This
// is the exact math of clm_prod_fwd's xt = xec + hg0 (the highest-frequency
// interpreted inter-op host glue between device GEMM spikes — the ③ fwd-only 0%
// floor). Pure elementwise add, NO reduction → the device kernel is trivially
// bit-exact (max|Δ| MUST be exactly 0). Inlined here (NOT a call into the device
// builtin) so the prebuilt mac binary never link-references the builtin under
// `hexa run`; the builtin is wired ONLY in clm_prod.hexa::_residual_add under
// env CLM_PROD_DEVRESIDENT and realized in the self-host-rebuilt pod binary.
pub fn devfeed_residual_add(a: int, b: int, out: int, n: int) {
    let mut i = 0
    while i < n { t_set(out, i, t_get(a, i) + t_get(b, i)); i = i + 1 }
}

// ════════════════════════════════════════════════════════════════════════════
//  Reference forge conv (inlined — flame files cannot `use` one another). These
//  mirror clm_conv_gpu.hexa's conv1d_via_forge / conv1d_bwd_via_forge EXACTLY;
//  the devfeed selftest proves the device-resident im2col/col2im gather+scatter
//  reproduce them byte-for-byte.
// ════════════════════════════════════════════════════════════════════════════

fn _ref_conv_fwd(x: int, w: int, b: int, y_out: int, T: int, Cin: int, Cout: int, K: int, dil: int) {
    let Kdim = Cin * K
    let xcol = t_zeros(T * Kdim)
    let mut t = 0
    while t < T {
        let mut ci = 0
        while ci < Cin {
            let mut k = 0
            while k < K {
                let p = t - dil * (K - 1 - k)
                if p >= 0 { t_set(xcol, t * Kdim + ci * K + k, t_get(x, p * Cin + ci)) }
                k = k + 1
            }
            ci = ci + 1
        }
        t = t + 1
    }
    let Wt = t_zeros(Kdim * Cout)
    let mut co = 0
    while co < Cout {
        let mut j = 0
        while j < Kdim { t_set(Wt, j * Cout + co, t_get(w, co * Kdim + j)); j = j + 1 }
        co = co + 1
    }
    let mm = forge_dispatch_matmul(xcol, T, Kdim, Wt, Cout)
    let mut t2 = 0
    while t2 < T {
        let mut c2 = 0
        while c2 < Cout {
            t_set(y_out, t2 * Cout + c2, t_get(mm, t2 * Cout + c2) + t_get(b, c2))
            c2 = c2 + 1
        }
        t2 = t2 + 1
    }
    t_free(xcol); t_free(Wt); t_free(mm)
}

fn _ref_conv_bwd(x: int, w: int, dy: int, dW_out: int, dX_out: int, db_out: int,
                 T: int, Cin: int, Cout: int, K: int, dil: int) {
    let Kdim = Cin * K
    let xcolT = t_zeros(Kdim * T)
    let mut t = 0
    while t < T {
        let mut ci = 0
        while ci < Cin {
            let mut k = 0
            while k < K {
                let p = t - dil * (K - 1 - k)
                if p >= 0 { let j = ci * K + k; t_set(xcolT, j * T + t, t_get(x, p * Cin + ci)) }
                k = k + 1
            }
            ci = ci + 1
        }
        t = t + 1
    }
    let dW_flat = forge_dispatch_matmul(xcolT, Kdim, T, dy, Cout)
    let mut co = 0
    while co < Cout {
        let mut j = 0
        while j < Kdim { t_set(dW_out, co * Kdim + j, t_get(dW_flat, j * Cout + co)); j = j + 1 }
        co = co + 1
    }
    let dXcol = forge_dispatch_matmul(dy, T, Cout, w, Kdim)
    let mut iz = 0
    while iz < T * Cin { t_set(dX_out, iz, 0.0); iz = iz + 1 }
    let mut t2 = 0
    while t2 < T {
        let mut ci2 = 0
        while ci2 < Cin {
            let mut k2 = 0
            while k2 < K {
                let p = t2 - dil * (K - 1 - k2)
                if p >= 0 { let j = ci2 * K + k2; let xidx = p * Cin + ci2
                    t_set(dX_out, xidx, t_get(dX_out, xidx) + t_get(dXcol, t2 * Kdim + j)) }
                k2 = k2 + 1
            }
            ci2 = ci2 + 1
        }
        t2 = t2 + 1
    }
    let mut cb = 0
    while cb < Cout {
        let mut acc = 0.0; let mut tb = 0
        while tb < T { acc = acc + t_get(dy, tb * Cout + cb); tb = tb + 1 }
        t_set(db_out, cb, acc); cb = cb + 1
    }
    t_free(xcolT); t_free(dW_flat); t_free(dXcol)
}

// devfeed conv fwd/bwd built ON the devfeed im2col/col2im (the path clm_prod's
// device wiring mirrors): identical math, gather/scatter via the devfeed helpers.
fn _devfeed_conv_fwd(x: int, w: int, b: int, y_out: int, T: int, Cin: int, Cout: int, K: int, dil: int) {
    let Kdim = Cin * K
    let xcol = t_zeros(T * Kdim)
    devfeed_im2col(x, xcol, T, Cin, K, dil)
    let Wt = t_zeros(Kdim * Cout)
    let mut co = 0
    while co < Cout {
        let mut j = 0
        while j < Kdim { t_set(Wt, j * Cout + co, t_get(w, co * Kdim + j)); j = j + 1 }
        co = co + 1
    }
    let mm = forge_dispatch_matmul(xcol, T, Kdim, Wt, Cout)
    let mut t2 = 0
    while t2 < T {
        let mut c2 = 0
        while c2 < Cout {
            t_set(y_out, t2 * Cout + c2, t_get(mm, t2 * Cout + c2) + t_get(b, c2))
            c2 = c2 + 1
        }
        t2 = t2 + 1
    }
    t_free(xcol); t_free(Wt); t_free(mm)
}

fn _devfeed_conv_bwd(x: int, w: int, dy: int, dW_out: int, dX_out: int, db_out: int,
                     T: int, Cin: int, Cout: int, K: int, dil: int) {
    let Kdim = Cin * K
    let xcolT = t_zeros(Kdim * T)
    devfeed_im2col_T(x, xcolT, T, Cin, K, dil)
    let dW_flat = forge_dispatch_matmul(xcolT, Kdim, T, dy, Cout)
    let mut co = 0
    while co < Cout {
        let mut j = 0
        while j < Kdim { t_set(dW_out, co * Kdim + j, t_get(dW_flat, j * Cout + co)); j = j + 1 }
        co = co + 1
    }
    let dXcol = forge_dispatch_matmul(dy, T, Cout, w, Kdim)
    devfeed_col2im(dXcol, dX_out, T, Cin, K, dil)
    devfeed_db_colsum(dy, db_out, T, Cout)
    t_free(xcolT); t_free(dW_flat); t_free(dXcol)
}

fn _maxdev(a: int, b: int, n: int) -> float {
    let mut m = 0.0
    let mut i = 0
    while i < n { let d = _df_absf(t_get(a, i) - t_get(b, i)); if d > m { m = d }; i = i + 1 }
    return m
}

fn main() {
    println("clm_conv_devfeed — LEVER (a): device im2col/col2im + device AdamW (CPU oracle)")
    let T = 24; let Cin = 8; let Cout = 8; let K = 3
    let dd = Cout * Cin * K
    let tol = 0.000000001

    let x  = t_zeros(T * Cin);  t_fill_lcg(x, T * Cin, 31, 0.4)
    let w  = t_zeros(dd);       t_fill_lcg(w, dd, 2, 0.2)
    let b  = t_zeros(Cout);     t_fill_lcg(b, Cout, 3, 0.1)

    // ── F-CLM-DEVFEED-IM2COL-EQ : devfeed gather == inline xcol reference ──
    let mut all_ok = 1
    let mut dil = 1
    while dil <= 2 {
        let Kdim = Cin * K
        let xcolR = t_zeros(T * Kdim)
        let mut t = 0
        while t < T {
            let mut ci = 0
            while ci < Cin {
                let mut k = 0
                while k < K {
                    let p = t - dil * (K - 1 - k)
                    if p >= 0 { t_set(xcolR, t * Kdim + ci * K + k, t_get(x, p * Cin + ci)) }
                    k = k + 1
                }
                ci = ci + 1
            }
            t = t + 1
        }
        let xcolD = t_zeros(T * Kdim)
        devfeed_im2col(x, xcolD, T, Cin, K, dil)
        let mi = _maxdev(xcolR, xcolD, T * Kdim)
        print("  im2col dil="); print(dil); print(" max|Δ|="); println(to_string(mi))
        if mi > tol { all_ok = 0 }
        t_free(xcolR); t_free(xcolD)
        dil = dil + 1
    }
    if all_ok == 1 { println("F-CLM-DEVFEED-IM2COL-EQ = 1"); println("PASS — device im2col gather == host xcol byte-eq, dil∈{1,2}") }
    if all_ok == 0 { println("F-CLM-DEVFEED-IM2COL-EQ = 0"); println("FAIL — im2col") }

    // ── F-CLM-DEVFEED-FWD-EQ : devfeed conv fwd == reference forge conv fwd ──
    let mut fwd_ok = 1
    let mut dilf = 1
    while dilf <= 2 {
        let y_ref = t_zeros(T * Cout)
        _ref_conv_fwd(x, w, b, y_ref, T, Cin, Cout, K, dilf)
        let y_df = t_zeros(T * Cout)
        _devfeed_conv_fwd(x, w, b, y_df, T, Cin, Cout, K, dilf)
        let fd = _maxdev(y_ref, y_df, T * Cout)
        print("  fwd dil="); print(dilf); print(" max|Δ| devfeed-vs-forge = "); println(to_string(fd))
        if fd > tol { fwd_ok = 0 }
        t_free(y_ref); t_free(y_df)
        dilf = dilf + 1
    }
    if fwd_ok == 1 { println("F-CLM-DEVFEED-FWD-EQ = 1"); println("PASS — devfeed fwd == forge conv1d byte-eq, dil∈{1,2}") }
    if fwd_ok == 0 { println("F-CLM-DEVFEED-FWD-EQ = 0"); println("FAIL — fwd") }

    // ── F-CLM-DEVFEED-BWD-EQ : devfeed conv bwd == reference forge conv bwd ──
    let mut bwd_ok = 1
    let mut dil2 = 1
    while dil2 <= 2 {
        let dy = t_zeros(T * Cout)
        _ref_conv_fwd(x, w, b, dy, T, Cin, Cout, K, dil2)  // representative nonzero field
        let dW0 = t_zeros(dd); let dX0 = t_zeros(T * Cin); let db0 = t_zeros(Cout)
        _ref_conv_bwd(x, w, dy, dW0, dX0, db0, T, Cin, Cout, K, dil2)
        let dW1 = t_zeros(dd); let dX1 = t_zeros(T * Cin); let db1 = t_zeros(Cout)
        _devfeed_conv_bwd(x, w, dy, dW1, dX1, db1, T, Cin, Cout, K, dil2)
        let mW = _maxdev(dW0, dW1, dd); let mX = _maxdev(dX0, dX1, T * Cin); let mB = _maxdev(db0, db1, Cout)
        print("  bwd dil="); print(dil2); print(" max|Δ| dW="); print(to_string(mW))
        print(" dX="); print(to_string(mX)); print(" db="); println(to_string(mB))
        if mW > tol { bwd_ok = 0 }
        if mX > tol { bwd_ok = 0 }
        if mB > tol { bwd_ok = 0 }
        t_free(dy); t_free(dW0); t_free(dX0); t_free(db0); t_free(dW1); t_free(dX1); t_free(db1)
        dil2 = dil2 + 1
    }
    if bwd_ok == 1 { println("F-CLM-DEVFEED-BWD-EQ = 1"); println("PASS — devfeed bwd (dW/dX/db) == forge conv1d_bwd byte-eq, dil∈{1,2}") }
    if bwd_ok == 0 { println("F-CLM-DEVFEED-BWD-EQ = 0"); println("FAIL — bwd") }

    // ── F-CLM-DEVFEED-DB-EQ : HEXA-FUSION L1 (GRAD half) device-resident db ──
    // The bias grad db[co] = Σ_t dy[t,co] now routes through devfeed_db_colsum
    // (device kernel under CLM_PROD_DEVRESIDENT, host loop on the CPU oracle).
    // The device path sums T SEQUENTIALLY per channel (no tree re-association)
    // → must be byte-eq to the reference host reduction. This is the grad-half
    // analogue of the col2im scatter: db stays DEVICE-RESIDENT for the next
    // _adam H2D-skip; the falsifier here pins max|Δ|=0 of the colsum itself.
    let mut db_ok = 1
    let mut dilb = 1
    while dilb <= 2 {
        let dyb = t_zeros(T * Cout)
        _ref_conv_fwd(x, w, b, dyb, T, Cin, Cout, K, dilb)  // representative nonzero dy
        let dbR = t_zeros(Cout)   // reference host reduction
        let mut cr = 0
        while cr < Cout {
            let mut ac = 0.0; let mut tr = 0
            while tr < T { ac = ac + t_get(dyb, tr * Cout + cr); tr = tr + 1 }
            t_set(dbR, cr, ac); cr = cr + 1
        }
        let dbD = t_zeros(Cout)   // devfeed_db_colsum (device path / host fallback)
        devfeed_db_colsum(dyb, dbD, T, Cout)
        let mDB = _maxdev(dbR, dbD, Cout)
        print("  db dil="); print(dilb); print(" max|Δ| colsum-vs-host = "); println(to_string(mDB))
        if mDB > tol { db_ok = 0 }
        t_free(dyb); t_free(dbR); t_free(dbD)
        dilb = dilb + 1
    }
    if db_ok == 1 { println("F-CLM-DEVFEED-DB-EQ = 1"); println("PASS — device-resident db colsum == host Σ_t dy[t,co] byte-eq, dil∈{1,2}") }
    if db_ok == 0 { println("F-CLM-DEVFEED-DB-EQ = 0"); println("FAIL — db colsum") }

    // ── F-CLM-DEVFEED-INT4QUANT-EQ : HEXA-FUSION L1 (PARAM half) device int4 ──
    // The int4 fake-quant now routes through the device kernel
    // _hx_cuda_farr_int4_quant_gpu under CLM_PROD_DEVRESIDENT (host fake-quant on
    // this CPU oracle), keeping W FARR_DEVICE (no per-step W D2H — the last
    // roundtrip blocking full device-residency). int4 is INTEGER rounding +
    // per-channel SEQUENTIAL max → NO fp re-association → the device quant MUST
    // be EXACTLY byte-eq to the canonical host nn_int4_quant_fwd (max|Δ|=0 — int4
    // is integer, no FMA-drift excuse). Here we pin devfeed_int4_quant (the exact
    // device-kernel math reference) == nn_int4_quant_fwd (canonical host quant)
    // on wq/scale/qlevel/mask AND the STE bwd dW == nn_int4_quant_bwd, at a
    // STRICT zero (not the < tol band): a single bit difference fails the gate.
    let mut q_ok = 1
    let Cq = Cout; let restq = Cin * K   // per-output-channel quant, rest = Cin·K
    let nq = Cq * restq
    // canonical host quant (quant_lib.nn_int4_quant_fwd)
    let wqH = t_zeros(nq); let scH = t_zeros(Cq); let qlH = t_zeros(nq); let mkH = t_zeros(nq)
    nn_int4_quant_fwd(w, wqH, scH, qlH, mkH, Cq, restq)
    // device-kernel math reference (devfeed_int4_quant — what the GPU reproduces)
    let wqD = t_zeros(nq); let scD = t_zeros(Cq); let qlD = t_zeros(nq); let mkD = t_zeros(nq)
    devfeed_int4_quant(w, wqD, scD, qlD, mkD, Cq, restq)
    let mWq = _maxdev(wqH, wqD, nq); let mSc = _maxdev(scH, scD, Cq)
    let mQl = _maxdev(qlH, qlD, nq); let mMk = _maxdev(mkH, mkD, nq)
    print("  int4 fwd max|Δ| wq="); print(to_string(mWq)); print(" scale="); print(to_string(mSc))
    print(" qlevel="); print(to_string(mQl)); print(" mask="); println(to_string(mMk))
    if mWq > 0.0 { q_ok = 0 }
    if mSc > 0.0 { q_ok = 0 }
    if mQl > 0.0 { q_ok = 0 }
    if mMk > 0.0 { q_ok = 0 }
    // STE backward: dW = dy·mask (clipped straight-through). Device kernel is a
    // pure elementwise multiply → bit-exact to nn_int4_quant_bwd.
    let dyq = t_zeros(nq); t_fill_lcg(dyq, nq, 41, 0.25)
    let dWH = t_zeros(nq); nn_int4_quant_bwd(dyq, mkH, dWH, Cq, restq)
    let dWD = t_zeros(nq); devfeed_int4_quant_bwd(dyq, mkD, dWD, nq)
    let mDW = _maxdev(dWH, dWD, nq)
    print("  int4 bwd (STE) max|Δ| dW="); println(to_string(mDW))
    if mDW > 0.0 { q_ok = 0 }
    t_free(wqH); t_free(scH); t_free(qlH); t_free(mkH)
    t_free(wqD); t_free(scD); t_free(qlD); t_free(mkD)
    t_free(dyq); t_free(dWH); t_free(dWD)
    if q_ok == 1 { println("F-CLM-DEVFEED-INT4QUANT-EQ = 1"); println("PASS — device int4 quant fwd (wq/scale/qlevel/mask) + STE bwd == host quant byte-eq (max|Δ|=0, integer-exact)") }
    if q_ok == 0 { println("F-CLM-DEVFEED-INT4QUANT-EQ = 0"); println("FAIL — int4 quant") }

    // ── F-CLM-DEVFEED-RESIDUAL-EQ : HEXA-FUSION L3 (glue half) device residual ──
    // The fwd-path residual xt = xec + hg0 (clm_prod_fwd) now routes through the
    // device kernel _hx_cuda_farr_residual_add_gpu under CLM_PROD_DEVRESIDENT,
    // leaving the interpreter off the per-step hot path (the ③ fwd-only 0% util
    // floor: tensors device-resident is necessary but NOT sufficient while the
    // inter-op glue stays interpreted) and keeping the result FARR_DEVICE so the
    // next conv GEMM H2D-skips it. out[i] = a[i] + b[i] is a pure elementwise add
    // with NO reduction → the device add MUST be EXACTLY byte-eq to the host
    // scalar loop (max|Δ|=0 — no fp re-association, no FMA-drift excuse). Here we
    // pin devfeed_residual_add (the exact device-kernel math reference) == an
    // INDEPENDENT host scalar add at a STRICT zero (a single bit fails the gate).
    let mut rsd_ok = 1
    let nr = 257                       // odd len exercises the grid-stride tail
    let aR = t_zeros(nr); t_fill_lcg(aR, nr, 13, 0.4)
    let bR = t_zeros(nr); t_fill_lcg(bR, nr, 29, 0.6)
    // independent host reference (NOT via devfeed_residual_add)
    let outH = t_zeros(nr); let mut ri = 0
    while ri < nr { t_set(outH, ri, t_get(aR, ri) + t_get(bR, ri)); ri = ri + 1 }
    // device-kernel math reference (devfeed_residual_add — what the GPU reproduces)
    let outD = t_zeros(nr); devfeed_residual_add(aR, bR, outD, nr)
    let mRsd = _maxdev(outH, outD, nr)
    print("  residual-add max|Δ| out="); println(to_string(mRsd))
    if mRsd > 0.0 { rsd_ok = 0 }
    t_free(aR); t_free(bR); t_free(outH); t_free(outD)
    if rsd_ok == 1 { println("F-CLM-DEVFEED-RESIDUAL-EQ = 1"); println("PASS — device residual-add (xt = xec + hg0) == host scalar add byte-eq (max|Δ|=0)") }
    if rsd_ok == 0 { println("F-CLM-DEVFEED-RESIDUAL-EQ = 0"); println("FAIL — residual add") }

    // ── F-CLM-DEVFEED-ADAM-EQ : host AdamW oracle trajectory self-consistent ──
    // The device AdamW (forge_dispatch_adamw, wired in clm_prod.hexa under env)
    // routes to _hx_cuda_farr_adamw_step_inplace_gpu — already byte-eq to this
    // SAME opt_adamw_step builtin (the #2383-class adamw kernel proof). Here we
    // confirm the host oracle the device path falls back to / is checked against
    // runs a stable 5-step trajectory (two independent runs bit-identical).
    let n = 17
    let WA = t_zeros(n); t_fill_lcg(WA, n, 7, 0.3)
    let WB = t_zeros(n); let mut ci0 = 0
    while ci0 < n { t_set(WB, ci0, t_get(WA, ci0)); ci0 = ci0 + 1 }
    let mA = t_zeros(n); let vA = t_zeros(n)
    let mB2 = t_zeros(n); let vB2 = t_zeros(n)
    let mut adam_ok = 1
    let mut st = 1
    while st <= 5 {
        let gA = t_zeros(n); t_fill_lcg(gA, n, 20 + st, 0.15)
        let gB = t_zeros(n); let mut ci1 = 0
        while ci1 < n { t_set(gB, ci1, t_get(gA, ci1)); ci1 = ci1 + 1 }
        opt_adamw_step(WA, gA, mA, vA, n, 0.05, 0.9, 0.999, 0.00000001, 0.0, st)
        opt_adamw_step(WB, gB, mB2, vB2, n, 0.05, 0.9, 0.999, 0.00000001, 0.0, st)
        let mw = _maxdev(WA, WB, n); let mm2 = _maxdev(mA, mB2, n); let mv = _maxdev(vA, vB2, n)
        if mw > tol { adam_ok = 0 }
        if mm2 > tol { adam_ok = 0 }
        if mv > tol { adam_ok = 0 }
        t_free(gA); t_free(gB)
        st = st + 1
    }
    let mwF = _maxdev(WA, WB, n)
    print("  adam 5-step max|Δ| W="); println(to_string(mwF))
    if adam_ok == 1 { println("F-CLM-DEVFEED-ADAM-EQ = 1"); println("PASS — AdamW oracle (opt_adamw_step) deterministic 5-step trajectory") }
    if adam_ok == 0 { println("F-CLM-DEVFEED-ADAM-EQ = 0"); println("FAIL — adam") }

    if all_ok == 1 { if fwd_ok == 1 { if bwd_ok == 1 { if db_ok == 1 { if q_ok == 1 { if rsd_ok == 1 { if adam_ok == 1 {
        println("ALL-PASS — LEVER (a) device im2col/col2im + device db colsum + device int4 quant + device residual-add glue + device AdamW oracle byte-eq to host feed")
        return
    } } } } } } }
    println("FAIL")
}
