// ════════════════════════════════════════════════════════════════════════════
//  clm_conv_devfeed.hexa — LEVER (a): device-side im2col/col2im + device AdamW.
//
//  Lever (b) (clm_conv_batched.hexa) fused the per-step expert-conv GEMMs but did
//  NOT touch the DOMINANT Lane-G util peg: the host-side im2col/col2im gather +
//  the per-weight host adam loop. Each step the trainer rebuilds x_col on the host
//  with t_set (host-dirty), so every forge GEMM re-H2D's it; and every _adam()
//  call runs a host scalar loop between micro-GEMMs. One CPU core stays at 100%
//  and the GPU starves (PEAK 4-6%, MEAN 0.24%, scale-invariant).
//
//  Lever (a) removes that peg by keeping the backward feed DEVICE-RESIDENT:
//    1. im2col / col2im run as device kernels writing a FARR_DEVICE x_col, fed
//       STRAIGHT into the (already-device) GEMM with NO intervening D2H/H2D — the
//       GEMM reads the device buffer in place (FARR_DEVICE residency bookkeeping).
//    2. AdamW runs on-device (_hx_cuda_farr_adamw_step_inplace_gpu, already byte-
//       eq to the host oracle) so the optimizer step + m/v state stay on device.
//
//  This FILE is the CPU-LOCAL byte-eq ORACLE + selftest surface (the lever-(b)
//  playbook). It calls ONLY builtins present in the prebuilt binary
//  (forge_dispatch_matmul, adamw_step) so it runs $0 on Mac CPU with `hexa run`,
//  no self-host rebuild needed. The device-resident path (the new builtins
//  forge_dispatch_im2col / forge_dispatch_col2im / forge_dispatch_adamw) is wired
//  ONLY in clm_prod.hexa behind env CLM_PROD_DEVFEED — compiled on the GPU pod's
//  self-host rebuild, never on the mac binary. The host gather/scatter/adam below
//  are the exact byte-eq reference those device kernels must match.
//
//  GRAD-EXACT contract (matches the conv→forge byte-eq bar #2352 / #2383 and the
//  lever-(b) bar #2504):
//    F-CLM-DEVFEED-IM2COL-EQ : devfeed_im2col gather   == inline xcol reference
//    F-CLM-DEVFEED-FWD-EQ    : conv via devfeed im2col  == reference forge conv (fwd)
//    F-CLM-DEVFEED-BWD-EQ    : conv bwd via devfeed     == reference forge conv bwd
//    F-CLM-DEVFEED-ADAM-EQ   : adamw_step oracle trajectory self-consistent (host)
//  All max|Δ| = 0.0 exact on CPU; the GPU-busy util measurement is the single
//  small fire after lever (a)+(b) are locally green.
//
//  sibling: clm_conv_gpu.hexa (un-batched forge) · clm_conv_batched.hexa (lever b).
//
//  #4204 HEXA_DET safety-pin (GPU device-feed byte-eq oracle): the forge runtime
//  default flipped to own-native NON-deterministic fast kernels (atomic split-K
//  GEMM/GEMV, atomic-scatter col2im, atomic embedding grad-accum) — training gets
//  the fast benefit. The col2im/grad-accum device kernels this oracle asserts
//  byte-eq against are now atomic-by-DEFAULT, so the max|Δ|=0 reference-match ONLY
//  holds on the DET path. When running the GPU device-feed leg on a CUDA pod
//  (summer BuildStage), the launcher MUST export HEXA_DET=1 so _forge_det_on()
//  selects the fixed-order / non-atomic kernels (the bit-identical reference).
//  Without HEXA_DET=1 the atomic default re-orders the fp accumulation and the
//  byte-eq bar legitimately goes non-zero (that is the fast path, NOT a defect).
// ════════════════════════════════════════════════════════════════════════════

use "stdlib/flame/tensor_lib"
use "stdlib/flame/conv_lib"
use "stdlib/flame/optim_lib"
use "stdlib/flame/quant_lib"

fn _df_absf(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

// ── devfeed_im2col: build x_col[T, Cin·K] from x[T, Cin] (causal dilated) ──
// EXACT gather of conv1d_via_forge's im2col: x_col[t, ci*K+k] = (p>=0)?x[p,ci]:0,
// p = t - dil*(K-1-k). On CPU this IS the host loop; the device builtin
// forge_dispatch_im2col runs the SAME gather as a kernel writing a FARR_DEVICE
// buffer (one thread per (t, ci*K+k) output cell — no atomics; pure gather), so
// the GEMM consumes it with no D2H/H2D roundtrip. Caller allocates xcol[T·Kdim].
pub fn devfeed_im2col(x: int, xcol_out: int, T: int, Cin: int, K: int, dil: int) {
    let Kdim = Cin * K
    let mut iz = 0
    while iz < T * Kdim { t_set(xcol_out, iz, 0.0); iz = iz + 1 }
    let mut t = 0
    while t < T {
        let mut ci = 0
        while ci < Cin {
            let mut k = 0
            while k < K {
                let p = t - dil * (K - 1 - k)
                if p >= 0 { t_set(xcol_out, t * Kdim + ci * K + k, t_get(x, p * Cin + ci)) }
                k = k + 1
            }
            ci = ci + 1
        }
        t = t + 1
    }
}

// ── devfeed_im2col_T: build xcolT[Cin·K, T] (transpose form, backward dW) ──
// EXACT gather of conv1d_bwd_via_forge's xcolT: xcolT[j, t] = (p>=0)?x[p,ci]:0,
// j = ci*K+k, p = t - dil*(K-1-k). Device builtin = transpose-gather kernel,
// FARR_DEVICE, fed straight into the dW GEMM. Caller allocates xcolT[Kdim·T].
pub fn devfeed_im2col_T(x: int, xcolT_out: int, T: int, Cin: int, K: int, dil: int) {
    let Kdim = Cin * K
    let mut iz = 0
    while iz < Kdim * T { t_set(xcolT_out, iz, 0.0); iz = iz + 1 }
    let mut t = 0
    while t < T {
        let mut ci = 0
        while ci < Cin {
            let mut k = 0
            while k < K {
                let p = t - dil * (K - 1 - k)
                if p >= 0 {
                    let j = ci * K + k
                    t_set(xcolT_out, j * T + t, t_get(x, p * Cin + ci))
                }
                k = k + 1
            }
            ci = ci + 1
        }
        t = t + 1
    }
}

// ── devfeed_col2im: scatter-add dXcol[T, Cin·K] back to dX[T, Cin] ──
// EXACT transpose of the im2col gather, expressed in the TRANSPOSE-GATHER form
// (one thread per dX[p,ci] output cell summing the K dilated taps that scatter
// into it — NO atomics → deterministic, byte-eq to the host scatter order):
//   dX[p,ci] = Σ_k dXcol[t*Kdim + (ci*K+k)] with t = p + dil*(K-1-k), t in [0,T).
// This is algebraically identical to conv1d_bwd_via_forge's scatter
//   dX[p*Cin+ci] += dXcol[t*Kdim + j]  for each (t,k) with p = t - dil*(K-1-k)≥0,
// reindexed so each output is written exactly once. Caller allocates dX.
pub fn devfeed_col2im(dXcol: int, dX_out: int, T: int, Cin: int, K: int, dil: int) {
    let Kdim = Cin * K
    let mut iz = 0
    while iz < T * Cin { t_set(dX_out, iz, 0.0); iz = iz + 1 }
    let mut p = 0
    while p < T {
        let mut ci = 0
        while ci < Cin {
            let mut acc = 0.0
            let mut k = 0
            while k < K {
                let t = p + dil * (K - 1 - k)
                if t < T {
                    let j = ci * K + k
                    acc = acc + t_get(dXcol, t * Kdim + j)
                }
                k = k + 1
            }
            t_set(dX_out, p * Cin + ci, acc)
            ci = ci + 1
        }
        p = p + 1
    }
}

// ── devfeed_db_colsum: bias-gradient column sum db[co] = Σ_t dy[t,co] ──
// HEXA-FUSION L1 (GRAD half) — the REFERENCE host reduction that the device
// kernel _hx_cuda_farr_db_colsum_gpu reproduces. The device kernel sums T
// SEQUENTIALLY per channel (t = 0,1,…,T-1) with NO tree / warp re-association,
// so its IEEE-754 accumulation order is IDENTICAL to this loop → bit-exact
// (max|Δ|=0), unlike the row-reduction kernels which carry a ~N·ε tolerance.
// This oracle deliberately does NOT call forge_dispatch_db_colsum (so the
// prebuilt mac binary never link-references the device builtin under
// `hexa run`); the builtin is wired ONLY in clm_prod.hexa::_clmp_db_colsum
// under env CLM_PROD_DEVRESIDENT and realized in the self-host-rebuilt pod
// binary. The byte-eq guarantee here is the sequential-sum-order equivalence.
pub fn devfeed_db_colsum(dy: int, db_out: int, T: int, Cout: int) {
    let mut cb = 0
    while cb < Cout {
        let mut acc = 0.0
        let mut tb = 0
        while tb < T {
            acc = acc + t_get(dy, tb * Cout + cb)
            tb = tb + 1
        }
        t_set(db_out, cb, acc)
        cb = cb + 1
    }
}

// ── devfeed_int4_quant: device-resident int4 fake-quant (PARAM half) ──────────
// HEXA-FUSION L1 (PARAM half) — the REFERENCE host fake-quant that the device
// kernel _hx_cuda_farr_int4_quant_gpu reproduces. Inlined here (NOT a call into
// quant_lib's nn_int4_quant_fwd, and NOT a call into the device builtin) so the
// prebuilt mac binary never link-references the device builtin under `hexa run`;
// the builtin is wired ONLY in clm_prod.hexa::_fq under env CLM_PROD_DEVRESIDENT
// and realized in the self-host-rebuilt pod binary. int4 is INTEGER rounding +
// per-channel SEQUENTIAL max (NO fp reduction re-association), so the device
// kernel's accumulation is byte-identical — max|Δ| MUST be exactly 0 (no
// FMA-drift excuse). _q_abs / _q_round mirror quant_lib EXACTLY.
fn _dfq_abs(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }
fn _dfq_round(x: float) -> float {
    if x >= 0.0 { return to_float(to_int(x + 0.5)) }
    return 0.0 - to_float(to_int((0.0 - x) + 0.5))
}
pub fn devfeed_int4_quant(w: int, wq_out: int, scale_out: int,
                          qlevel_out: int, mask_out: int, Cout: int, rest: int) {
    let mut co = 0
    while co < Cout {
        let mut mx = 0.0
        let mut j = 0
        while j < rest {
            let a = _dfq_abs(t_get(w, co * rest + j))
            if a > mx { mx = a }
            j = j + 1
        }
        let s = if mx > 0.0 { mx / 7.0 } else { 1.0 }
        t_set(scale_out, co, s)
        let mut j2 = 0
        while j2 < rest {
            let idx = co * rest + j2
            let r = _dfq_round(t_get(w, idx) / s)
            let mut q = r
            let mut inrange = 1.0
            if q > 7.0 { q = 7.0; inrange = 0.0 }
            if q < 0.0 - 7.0 { q = 0.0 - 7.0; inrange = 0.0 }
            t_set(qlevel_out, idx, q)
            t_set(mask_out, idx, inrange)
            t_set(wq_out, idx, q * s)
            j2 = j2 + 1
        }
        co = co + 1
    }
}

// int4 clipped-STE backward reference: dW[i] = dy[i]·mask[i] (mask ∈ {0,1}).
// Pure elementwise — the device kernel is trivially bit-exact (max|Δ|=0).
pub fn devfeed_int4_quant_bwd(dy: int, mask: int, dW_out: int, n: int) {
    let mut i = 0
    while i < n { t_set(dW_out, i, t_get(dy, i) * t_get(mask, i)); i = i + 1 }
}

// ── devfeed_residual_add: device-resident elementwise residual-add (glue) ─────
// HEXA-FUSION L3 (glue half) — the REFERENCE host residual-add that the device
// kernel _hx_cuda_farr_residual_add_gpu reproduces: out[i] = a[i] + b[i]. This
// is the exact math of clm_prod_fwd's xt = xec + hg0 (the highest-frequency
// interpreted inter-op host glue between device GEMM spikes — the ③ fwd-only 0%
// floor). Pure elementwise add, NO reduction → the device kernel is trivially
// bit-exact (max|Δ| MUST be exactly 0). Inlined here (NOT a call into the device
// builtin) so the prebuilt mac binary never link-references the builtin under
// `hexa run`; the builtin is wired ONLY in clm_prod.hexa::_residual_add under
// env CLM_PROD_DEVRESIDENT and realized in the self-host-rebuilt pod binary.
pub fn devfeed_residual_add(a: int, b: int, out: int, n: int) {
    let mut i = 0
    while i < n { t_set(out, i, t_get(a, i) + t_get(b, i)); i = i + 1 }
}

// ── OP-19b deterministic transcendental replicas (NO libm) ────────────────────
// Byte-for-byte the flame_math.hexa dt_erf / dt_exp SSOT. Replicated (not
// cross-imported) because these flame libs only `use` sibling data libs and a
// cross-lib fn-value reference does not codegen here (same reason gn_lib._gn_gelu
// replicates nn_lib's GELU). The devfeed REFERENCE GELU below is the host oracle
// the device kernel must match max|Δ|=0; since the device kernel now uses
// _hx_dt_erf_dev/_hx_dt_exp_dev (OP-19b), this reference uses the same dt_erf/dt_exp.
fn _devfeed_dt_exp(x: float) -> float {
    let mut r = 0
    let mut xr = x
    while (if xr > 0.0 { xr } else { 0.0 - xr }) > 0.25 { xr = xr / 2.0; r = r + 1 }
    let mut term = 1.0
    let mut acc = 1.0
    let mut k = 1
    while k < 12 { term = term * xr / to_float(k); acc = acc + term; k = k + 1 }
    let mut s = 0
    while s < r { acc = acc * acc; s = s + 1 }
    return acc
}
fn _devfeed_dt_erf(x: float) -> float {
    let mut sign = 1.0
    let mut z = x
    if z < 0.0 { sign = 0.0 - 1.0; z = 0.0 - z }
    let t = 1.0 / (1.0 + 0.3275911 * z)
    let a1 = 0.254829592
    let a2 = 0.0 - 0.284496736
    let a3 = 1.421413741
    let a4 = 0.0 - 1.453152027
    let a5 = 1.061405429
    let poly = ((((a5 * t + a4) * t + a3) * t + a2) * t + a1) * t
    return sign * (1.0 - poly * _devfeed_dt_exp(0.0 - z * z))
}

// ── devfeed_gelu: device-resident elementwise GELU (glue) ─────────────────────
// HEXA-FUSION L3 (glue half) — the REFERENCE host GELU that the device kernel
// _hx_cuda_farr_gelu_gpu reproduces: out[i] = in[i]·0.5·(1+erf(in[i]/√2)), the
// EXACT erf-based GELU of nn_lib.hexa _nn_gelu (the 1/√2 literal and x·cdf op
// order match the kernel verbatim). Pure elementwise, NO reduction → the device
// kernel is trivially bit-exact (max|Δ| MUST be exactly 0). OP-19b: `erf` →
// _devfeed_dt_erf (deterministic Maclaurin, NO libm) — matches _hx_dt_erf_dev on
// the device so the byte-eq assertion holds AND is cross-platform deterministic.
pub fn devfeed_gelu(g: int, out: int, n: int) {
    let inv_sqrt2 = 0.70710678118654752440
    let mut i = 0
    while i < n {
        let x = t_get(g, i)
        let cdf = 0.5 * (1.0 + _devfeed_dt_erf(x * inv_sqrt2))
        t_set(out, i, x * cdf)
        i = i + 1
    }
}

// Newton-Raphson sqrt (byte-identical to gn_lib.hexa _gn_sqrt AND to the device
// kernel's _hx_gn_sqrt_dev — 40 iters, NO libm sqrt → no codegen sqrt-impl skew).
fn _devfeed_gn_sqrt(x: float) -> float {
    if x <= 0.0 { return 0.0 }
    let mut g = x
    let mut i = 0
    while i < 40 { g = 0.5 * (g + x / g); i = i + 1 }
    return g
}

// ── devfeed_groupnorm: device-resident GroupNorm forward (glue) ───────────────
// HEXA-FUSION L3 (glue half) — the REFERENCE host GroupNorm that the device
// kernel _hx_cuda_farr_groupnorm_gpu reproduces, byte-identical to gn_lib.hexa
// nn_groupnorm_fwd: per group g, mu = mean over (Cg·T), var = mean (x-mu)²,
// inv = 1/sqrt(var+eps) (eps=1e-5), xhat=(x-mu)·inv, y=gamma·xhat+beta. The two
// reductions accumulate SEQUENTIALLY (t outer, c inner) in the SAME order the
// device kernel's single-thread-per-group loop uses (NO tree re-assoc), and inv
// uses the SAME NR-40 sqrt (NO CUDA rsqrt) → max|Δ| MUST be exactly 0. Inlined
// here so the prebuilt mac binary never link-references the device builtin; the
// builtin is wired ONLY in clm_prod.hexa::_groupnorm under CLM_PROD_DEVRESIDENT.
pub fn devfeed_groupnorm(x: int, gamma: int, beta: int, y_out: int, mean_out: int, inv_out: int, xhat_out: int, T: int, C: int, G: int) {
    let eps = 0.00001
    let cg = C / G
    let m = to_float(cg * T)
    let mut g = 0
    while g < G {
        let c0 = g * cg
        let mut sum = 0.0
        let mut t = 0
        while t < T {
            let mut c = 0
            while c < cg { sum = sum + t_get(x, t * C + (c0 + c)); c = c + 1 }
            t = t + 1
        }
        let mu = sum / m
        let mut vs = 0.0
        let mut t2 = 0
        while t2 < T {
            let mut c2 = 0
            while c2 < cg { let dd = t_get(x, t2 * C + (c0 + c2)) - mu; vs = vs + dd * dd; c2 = c2 + 1 }
            t2 = t2 + 1
        }
        let var = vs / m
        let inv = 1.0 / _devfeed_gn_sqrt(var + eps)
        t_set(mean_out, g, mu)
        t_set(inv_out, g, inv)
        let mut t3 = 0
        while t3 < T {
            let mut c3 = 0
            while c3 < cg {
                let ch = c0 + c3
                let xh = (t_get(x, t3 * C + ch) - mu) * inv
                t_set(xhat_out, t3 * C + ch, xh)
                t_set(y_out, t3 * C + ch, t_get(gamma, ch) * xh + t_get(beta, ch))
                c3 = c3 + 1
            }
            t3 = t3 + 1
        }
        g = g + 1
    }
}

// ── devfeed_expert_pack2: device-resident expert-pack copy (glue) ─────────────
// HEXA-FUSION L3 (glue half · final ⑤c) — the REFERENCE host pack that the device
// kernel _hx_cuda_farr_expert_pack2_gpu reproduces, byte-identical to the
// clm_prod_fwd j-loop: ex_out[0·n+j]=ex0[j], ex_out[1·n+j]=ex1[j] for j in 0..n.
// Pure copy, NO arithmetic → the device kernel is trivially bit-exact (max|Δ|=0).
// Inlined here so the prebuilt mac binary never link-references the device
// builtin; the builtin is wired ONLY in clm_prod.hexa::_expert_pack2 under env.
pub fn devfeed_expert_pack2(ex0: int, ex1: int, ex_out: int, n: int) {
    let mut j = 0
    while j < n {
        t_set(ex_out, 0 * n + j, t_get(ex0, j))
        t_set(ex_out, 1 * n + j, t_get(ex1, j))
        j = j + 1
    }
}

// _moe_exp byte-identical to moe_lib.hexa _moe_exp (hand-rolled scaled-Taylor
// e^x, NOT libm exp — the device kernel's _hx_moe_exp_dev replays it term-for-
// term). Same range reduction + 13-term Taylor + 2^n by repeated ·2/÷2.
fn _devfeed_moe_exp(x: float) -> float {
    let ln2 = 0.6931471805599453
    let mut n = 0
    let mut r = x
    while r > 0.34657359 { r = r - ln2; n = n + 1 }
    while r < 0.0 - 0.34657359 { r = r + ln2; n = n - 1 }
    let mut term = 1.0
    let mut sum = 1.0
    let mut k = 1
    while k < 14 { term = term * r / to_float(k); sum = sum + term; k = k + 1 }
    let mut p = sum
    if n >= 0 {
        let mut i = 0
        while i < n { p = p * 2.0; i = i + 1 }
    } else {
        let mut i = 0
        while i < (0 - n) { p = p / 2.0; i = i + 1 }
    }
    return p
}

// ── devfeed_moe_router: device-resident MoE router (glue, HAS A REDUCTION) ─────
// HEXA-FUSION L3 (glue half · final ⑤c) — the REFERENCE host router that the
// device kernel _hx_cuda_farr_moe_router_gpu reproduces, byte-identical to
// moe_lib.hexa nn_moe_router_fwd: per t, probs=softmax(logits) (stable, max-sub,
// _moe_exp), y[t,c]=Σ_e probs[t,e]·ex_out[e·T·C+t·C+c]. The softmax sum and the
// combine acc accumulate SEQUENTIALLY (e=0..E) in the SAME order the device
// kernel's single-thread-per-t loop uses (NO tree re-assoc), and exp uses the
// SAME hand-rolled _moe_exp (NO CUDA exp) → max|Δ| MUST be exactly 0. Inlined
// here so the prebuilt mac binary never link-references the device builtin.
pub fn devfeed_moe_router(logits: int, ex_out: int, probs: int, y: int, T: int, E: int, C: int) {
    // softmax (stable, sequential sum)
    let mut t = 0
    while t < T {
        let base = t * E
        let mut mx = t_get(logits, base)
        let mut e = 1
        while e < E { let v = t_get(logits, base + e); if v > mx { mx = v }; e = e + 1 }
        let mut s = 0.0
        let mut e2 = 0
        while e2 < E {
            let ev = _devfeed_moe_exp(t_get(logits, base + e2) - mx)
            t_set(probs, base + e2, ev); s = s + ev; e2 = e2 + 1
        }
        let mut e3 = 0
        while e3 < E { t_set(probs, base + e3, t_get(probs, base + e3) / s); e3 = e3 + 1 }
        t = t + 1
    }
    // weighted combine (sequential acc over experts)
    let mut t2 = 0
    while t2 < T {
        let mut c = 0
        while c < C {
            let mut acc = 0.0
            let mut e = 0
            while e < E {
                acc = acc + t_get(probs, t2 * E + e) * t_get(ex_out, e * T * C + t2 * C + c)
                e = e + 1
            }
            t_set(y, t2 * C + c, acc)
            c = c + 1
        }
        t2 = t2 + 1
    }
}

// ── devfeed_embedding: device-resident embedding gather (glue) ────────────────
// HEXA-FUSION L3 (glue half · final ⑤c) — the REFERENCE host gather that the
// device kernel _hx_cuda_farr_embedding_gpu reproduces, byte-identical to
// nn_lib.hexa nn_embedding_fwd: for each i, tok=(int)ids[i] (truncate-toward-zero
// = the kernel's (int64_t) cast), x_out[i·d+c]=table[tok·d+c]. Pure gather, NO
// arithmetic → trivially bit-exact (max|Δ|=0). Inlined here so the prebuilt mac
// binary never link-references the device builtin.
pub fn devfeed_embedding(ids: int, table: int, x_out: int, T: int, d: int) {
    let mut i = 0
    while i < T {
        let tok = to_int(t_get(ids, i))
        let mut c = 0
        while c < d { t_set(x_out, i * d + c, t_get(table, tok * d + c)); c = c + 1 }
        i = i + 1
    }
}

// ── devfeed_gelu_bwd: device-resident elementwise GELU backward (BWD glue) ─────
// HEXA-FUSION L3 (BWD glue half) — the REFERENCE host gelu_bwd that the device
// kernel _hx_cuda_farr_gelu_bwd_gpu reproduces, byte-identical to nn_lib.hexa
// nn_gelu_bwd: dg[i]=da[i]·GELU'(g[i]), GELU'(x)=Φ(x)+x·φ(x), Φ(x)=0.5·(1+erf(x/√2)),
// φ(x)=(1/√(2π))·exp(-0.5·x²). The 1/√2 + 1/√(2π) literals and the cdf + x·pdf op
// order match the kernel verbatim; erf/exp are the libm codegen builtins (IEEE-
// correct host + CUDA). Pure elementwise, NO reduction → bit-exact (max|Δ|=0).
// Inlined here so the prebuilt mac binary never link-references the device builtin;
// the builtin is wired ONLY in clm_prod.hexa::_gelu_bwd under CLM_PROD_DEVRESIDENT.
pub fn devfeed_gelu_bwd(g: int, da: int, dg: int, n: int) {
    let inv_sqrt2 = 0.70710678118654752440
    let inv_sqrt2pi = 0.39894228040143267794
    let mut i = 0
    while i < n {
        let x = t_get(g, i)
        let cdf = 0.5 * (1.0 + _devfeed_dt_erf(x * inv_sqrt2))
        let pdf = inv_sqrt2pi * _devfeed_dt_exp(0.0 - 0.5 * x * x)
        let grad = cdf + x * pdf
        t_set(dg, i, t_get(da, i) * grad)
        i = i + 1
    }
}

// ── devfeed_groupnorm_bwd: device-resident GroupNorm backward (BWD glue) ───────
// HEXA-FUSION L3 (BWD glue half) — the REFERENCE host groupnorm_bwd that the device
// kernel _hx_cuda_farr_groupnorm_bwd_gpu reproduces, byte-identical to gn_lib.hexa
// nn_groupnorm_bwd: per channel dgamma[c]=Σ_t dy·xhat, dbeta[c]=Σ_t dy; per group
// s1=Σ dxh, s2=Σ dxh·xhat (dxh=dy·gamma), dX=inv·(dxh - s1/m - xhat·s2/m), m=Cg·T.
// Every reduction accumulates SEQUENTIALLY in the SAME order the device kernel uses
// (per-channel over t; per-group s1/s2 over t outer c inner — NO tree re-assoc),
// and inv is the SAVED forward reciprocal-stddev (no sqrt re-derivation) → max|Δ|
// MUST be exactly 0. Inlined here so the prebuilt mac binary never link-references
// the device builtin; the builtin is wired ONLY in clm_prod.hexa::_groupnorm_bwd.
pub fn devfeed_groupnorm_bwd(xhat: int, inv: int, gamma: int, dy: int,
                             dgamma_out: int, dbeta_out: int, dX_out: int,
                             T: int, C: int, G: int) {
    let cg = C / G
    let m = to_float(cg * T)
    let mut c = 0
    while c < C {
        let mut sg = 0.0
        let mut sb = 0.0
        let mut t = 0
        while t < T {
            let idx = t * C + c
            let gy = t_get(dy, idx)
            sg = sg + gy * t_get(xhat, idx)
            sb = sb + gy
            t = t + 1
        }
        t_set(dgamma_out, c, sg)
        t_set(dbeta_out, c, sb)
        c = c + 1
    }
    let mut g = 0
    while g < G {
        let c0 = g * cg
        let inv_g = t_get(inv, g)
        let mut s1 = 0.0
        let mut s2 = 0.0
        let mut t = 0
        while t < T {
            let mut cc = 0
            while cc < cg {
                let ch = c0 + cc
                let idx = t * C + ch
                let dxh = t_get(dy, idx) * t_get(gamma, ch)
                s1 = s1 + dxh
                s2 = s2 + dxh * t_get(xhat, idx)
                cc = cc + 1
            }
            t = t + 1
        }
        let mut t2 = 0
        while t2 < T {
            let mut cc2 = 0
            while cc2 < cg {
                let ch = c0 + cc2
                let idx = t2 * C + ch
                let dxh = t_get(dy, idx) * t_get(gamma, ch)
                let dx = inv_g * (dxh - s1 / m - t_get(xhat, idx) * s2 / m)
                t_set(dX_out, idx, dx)
                cc2 = cc2 + 1
            }
            t2 = t2 + 1
        }
        g = g + 1
    }
}

// ── devfeed_expert_unpack2: device-resident expert-unpack (BWD glue) ───────────
// HEXA-FUSION L3 (BWD glue half) — the REFERENCE host unpack that the device
// kernel _hx_cuda_farr_expert_unpack2_gpu reproduces, byte-identical to the
// clm_prod_bwd ei-loop: dex0[i]=dex_out[0·n+i], dex1[i]=dex_out[1·n+i] for i in
// 0..n. The bwd mirror of devfeed_expert_pack2. Pure copy, NO arithmetic → the
// device kernel is trivially bit-exact (max|Δ|=0). Inlined here so the prebuilt
// mac binary never link-references the device builtin; the builtin is wired ONLY
// in clm_prod.hexa::_expert_unpack2 under CLM_PROD_DEVRESIDENT.
pub fn devfeed_expert_unpack2(dex_out: int, dex0: int, dex1: int, n: int) {
    let mut i = 0
    while i < n {
        t_set(dex0, i, t_get(dex_out, 0 * n + i))
        t_set(dex1, i, t_get(dex_out, 1 * n + i))
        i = i + 1
    }
}

// ── devfeed_ce_grad: device-resident CE softmax grad (BWD glue · ⑤-bwd2) ───────
// HEXA-FUSION L3 (BWD glue half) — the REFERENCE host ce_grad that the device
// kernel _hx_cuda_farr_ce_grad_gpu reproduces, byte-identical to clm_prod.hexa
// clm_ce_grad: per t, mx=max_v logit, sm=Σ_v exp(logit-mx),
// dlogits[t,v]=(exp(logit-mx)/sm)·(1/T), dlogits[t,tgt]-=1/T. The max, the sum and
// the per-col writes run SEQUENTIALLY in the host scan order (v ascending) and the
// 1/T = 1.0/to_float(T) scaling matches verbatim; exp() is the libm codegen builtin
// (IEEE-correct host + CUDA) → bit-exact (max|Δ|=0). Inlined here so the prebuilt
// mac binary never link-references the device builtin; wired ONLY in
// clm_prod.hexa::_ce_grad under CLM_PROD_DEVRESIDENT.
pub fn devfeed_ce_grad(logits: int, targets: int, dlogits_out: int, T: int, V: int) {
    let mut t = 0
    while t < T {
        let base = t * V
        let mut mx = t_get(logits, base)
        let mut i = 1
        while i < V { let v = t_get(logits, base + i); if v > mx { mx = v }; i = i + 1 }
        let mut sm = 0.0
        let mut i2 = 0
        while i2 < V { sm = sm + exp(t_get(logits, base + i2) - mx); i2 = i2 + 1 }
        let invT = 1.0 / to_float(T)
        let mut v3 = 0
        while v3 < V {
            let p = exp(t_get(logits, base + v3) - mx) / sm
            t_set(dlogits_out, base + v3, p * invT)
            v3 = v3 + 1
        }
        let tgt = to_int(t_get(targets, t))
        t_set(dlogits_out, base + tgt, t_get(dlogits_out, base + tgt) - invT)
        t = t + 1
    }
}

// ── devfeed_moe_router_bwd: device-resident MoE-router bwd (BWD glue · ⑤-bwd2) ──
// HEXA-FUSION L3 (BWD glue half) — the REFERENCE host moe-router bwd that the device
// kernel _hx_cuda_farr_moe_router_bwd_gpu reproduces, byte-identical to moe_lib.hexa
// nn_moe_router_bwd: per t a 2-pass over E with inner Σ_c — pass1 dg[e]=Σ_c dy·ex_out,
// dex_out[e,t,c]=probs[t,e]·dy[t,c], stash dg in dlogits, dot=Σ_e probs·dg; pass2
// dlogits[e]=probs[e]·(dg[e]-dot). Reads CACHED probs (NO _moe_exp replay). Every
// reduction accumulates SEQUENTIALLY in the SAME order the device kernel uses (one
// thread per t) → max|Δ| MUST be exactly 0. Inlined here so the prebuilt mac binary
// never link-references the device builtin; wired ONLY in clm_prod.hexa::_moe_router_bwd.
pub fn devfeed_moe_router_bwd(probs: int, ex_out: int, dy: int,
                              dlogits_out: int, dex_out: int,
                              T: int, E: int, C: int) {
    let mut t = 0
    while t < T {
        let mut dot = 0.0
        let mut e = 0
        while e < E {
            let pte = t_get(probs, t * E + e)
            let mut dg = 0.0
            let mut c = 0
            while c < C {
                let gy = t_get(dy, t * C + c)
                dg = dg + gy * t_get(ex_out, e * T * C + t * C + c)
                t_set(dex_out, e * T * C + t * C + c, pte * gy)
                c = c + 1
            }
            t_set(dlogits_out, t * E + e, dg)
            dot = dot + pte * dg
            e = e + 1
        }
        let mut e2 = 0
        while e2 < E {
            let pte = t_get(probs, t * E + e2)
            let dg = t_get(dlogits_out, t * E + e2)
            t_set(dlogits_out, t * E + e2, pte * (dg - dot))
            e2 = e2 + 1
        }
        t = t + 1
    }
}

// ── devfeed_grad_sum3 / devfeed_grad_sum2: device-resident grad sums (⑤-bwd2) ──
// HEXA-FUSION L3 (BWD glue half) — the REFERENCE host grad sums the device kernels
// _hx_cuda_farr_grad_sum3_gpu / _hx_cuda_farr_grad_sum2_gpu reproduce, byte-identical
// to the clm_prod_bwd dxt / dxec accumulations: out[i]=a[i]+b[i]+c[i] (fixed (a+b)+c)
// and out[i]=a[i]+b[i]. Pure elementwise, NO reduction → trivially bit-exact (max|Δ|=0).
pub fn devfeed_grad_sum3(a: int, b: int, c: int, out: int, n: int) {
    let mut i = 0
    while i < n { t_set(out, i, t_get(a, i) + t_get(b, i) + t_get(c, i)); i = i + 1 }
}
pub fn devfeed_grad_sum2(a: int, b: int, out: int, n: int) {
    let mut i = 0
    while i < n { t_set(out, i, t_get(a, i) + t_get(b, i)); i = i + 1 }
}

// ── devfeed_embedding_bwd_scatter: device-resident embedding scatter (⑤-bwd2) ──
// HEXA-FUSION L3 (BWD glue half) — the REFERENCE host scatter the device kernel
// _hx_cuda_farr_embedding_bwd_scatter_gpu reproduces, byte-identical to nn_lib.hexa
// nn_embedding_bwd_scatter: for i in 0..T, tok=(int)ids[i], dtable[tok·d+c] +=
// dx[i·d+c] (c ascending), i ascending. The device kernel uses one thread per vocab
// row scanning i ascending (NO atomics) so colliding tokens accumulate in the SAME
// ascending-i order → max|Δ| MUST be exactly 0. dtable must be pre-zeroed by the
// caller. Inlined here so the prebuilt mac binary never link-references the device
// builtin; wired ONLY in clm_prod.hexa::_embedding_bwd_scatter under CLM_PROD_DEVRESIDENT.
pub fn devfeed_embedding_bwd_scatter(dX: int, ids: int, dtable_inout: int,
                                     T: int, d: int) {
    let mut i = 0
    while i < T {
        let tok = to_int(t_get(ids, i))
        let mut c = 0
        while c < d {
            let cur = t_get(dtable_inout, tok * d + c)
            t_set(dtable_inout, tok * d + c, cur + t_get(dX, i * d + c))
            c = c + 1
        }
        i = i + 1
    }
}

// ════════════════════════════════════════════════════════════════════════════
//  Reference forge conv (inlined — flame files cannot `use` one another). These
//  mirror clm_conv_gpu.hexa's conv1d_via_forge / conv1d_bwd_via_forge EXACTLY;
//  the devfeed selftest proves the device-resident im2col/col2im gather+scatter
//  reproduce them byte-for-byte.
// ════════════════════════════════════════════════════════════════════════════

fn _ref_conv_fwd(x: int, w: int, b: int, y_out: int, T: int, Cin: int, Cout: int, K: int, dil: int) {
    let Kdim = Cin * K
    let xcol = t_zeros(T * Kdim)
    let mut t = 0
    while t < T {
        let mut ci = 0
        while ci < Cin {
            let mut k = 0
            while k < K {
                let p = t - dil * (K - 1 - k)
                if p >= 0 { t_set(xcol, t * Kdim + ci * K + k, t_get(x, p * Cin + ci)) }
                k = k + 1
            }
            ci = ci + 1
        }
        t = t + 1
    }
    let Wt = t_zeros(Kdim * Cout)
    let mut co = 0
    while co < Cout {
        let mut j = 0
        while j < Kdim { t_set(Wt, j * Cout + co, t_get(w, co * Kdim + j)); j = j + 1 }
        co = co + 1
    }
    let mm = forge_dispatch_matmul(xcol, T, Kdim, Wt, Cout)
    let mut t2 = 0
    while t2 < T {
        let mut c2 = 0
        while c2 < Cout {
            t_set(y_out, t2 * Cout + c2, t_get(mm, t2 * Cout + c2) + t_get(b, c2))
            c2 = c2 + 1
        }
        t2 = t2 + 1
    }
    t_free(xcol); t_free(Wt); t_free(mm)
}

fn _ref_conv_bwd(x: int, w: int, dy: int, dW_out: int, dX_out: int, db_out: int,
                 T: int, Cin: int, Cout: int, K: int, dil: int) {
    let Kdim = Cin * K
    let xcolT = t_zeros(Kdim * T)
    let mut t = 0
    while t < T {
        let mut ci = 0
        while ci < Cin {
            let mut k = 0
            while k < K {
                let p = t - dil * (K - 1 - k)
                if p >= 0 { let j = ci * K + k; t_set(xcolT, j * T + t, t_get(x, p * Cin + ci)) }
                k = k + 1
            }
            ci = ci + 1
        }
        t = t + 1
    }
    let dW_flat = forge_dispatch_matmul(xcolT, Kdim, T, dy, Cout)
    let mut co = 0
    while co < Cout {
        let mut j = 0
        while j < Kdim { t_set(dW_out, co * Kdim + j, t_get(dW_flat, j * Cout + co)); j = j + 1 }
        co = co + 1
    }
    let dXcol = forge_dispatch_matmul(dy, T, Cout, w, Kdim)
    let mut iz = 0
    while iz < T * Cin { t_set(dX_out, iz, 0.0); iz = iz + 1 }
    let mut t2 = 0
    while t2 < T {
        let mut ci2 = 0
        while ci2 < Cin {
            let mut k2 = 0
            while k2 < K {
                let p = t2 - dil * (K - 1 - k2)
                if p >= 0 { let j = ci2 * K + k2; let xidx = p * Cin + ci2
                    t_set(dX_out, xidx, t_get(dX_out, xidx) + t_get(dXcol, t2 * Kdim + j)) }
                k2 = k2 + 1
            }
            ci2 = ci2 + 1
        }
        t2 = t2 + 1
    }
    let mut cb = 0
    while cb < Cout {
        let mut acc = 0.0; let mut tb = 0
        while tb < T { acc = acc + t_get(dy, tb * Cout + cb); tb = tb + 1 }
        t_set(db_out, cb, acc); cb = cb + 1
    }
    t_free(xcolT); t_free(dW_flat); t_free(dXcol)
}

// devfeed conv fwd/bwd built ON the devfeed im2col/col2im (the path clm_prod's
// device wiring mirrors): identical math, gather/scatter via the devfeed helpers.
fn _devfeed_conv_fwd(x: int, w: int, b: int, y_out: int, T: int, Cin: int, Cout: int, K: int, dil: int) {
    let Kdim = Cin * K
    let xcol = t_zeros(T * Kdim)
    devfeed_im2col(x, xcol, T, Cin, K, dil)
    let Wt = t_zeros(Kdim * Cout)
    let mut co = 0
    while co < Cout {
        let mut j = 0
        while j < Kdim { t_set(Wt, j * Cout + co, t_get(w, co * Kdim + j)); j = j + 1 }
        co = co + 1
    }
    let mm = forge_dispatch_matmul(xcol, T, Kdim, Wt, Cout)
    let mut t2 = 0
    while t2 < T {
        let mut c2 = 0
        while c2 < Cout {
            t_set(y_out, t2 * Cout + c2, t_get(mm, t2 * Cout + c2) + t_get(b, c2))
            c2 = c2 + 1
        }
        t2 = t2 + 1
    }
    t_free(xcol); t_free(Wt); t_free(mm)
}

fn _devfeed_conv_bwd(x: int, w: int, dy: int, dW_out: int, dX_out: int, db_out: int,
                     T: int, Cin: int, Cout: int, K: int, dil: int) {
    let Kdim = Cin * K
    let xcolT = t_zeros(Kdim * T)
    devfeed_im2col_T(x, xcolT, T, Cin, K, dil)
    let dW_flat = forge_dispatch_matmul(xcolT, Kdim, T, dy, Cout)
    let mut co = 0
    while co < Cout {
        let mut j = 0
        while j < Kdim { t_set(dW_out, co * Kdim + j, t_get(dW_flat, j * Cout + co)); j = j + 1 }
        co = co + 1
    }
    let dXcol = forge_dispatch_matmul(dy, T, Cout, w, Kdim)
    devfeed_col2im(dXcol, dX_out, T, Cin, K, dil)
    devfeed_db_colsum(dy, db_out, T, Cout)
    t_free(xcolT); t_free(dW_flat); t_free(dXcol)
}

fn _maxdev(a: int, b: int, n: int) -> float {
    let mut m = 0.0
    let mut i = 0
    while i < n { let d = _df_absf(t_get(a, i) - t_get(b, i)); if d > m { m = d }; i = i + 1 }
    return m
}

fn main() {
    println("clm_conv_devfeed — LEVER (a): device im2col/col2im + device AdamW (CPU oracle)")
    let T = 24; let Cin = 8; let Cout = 8; let K = 3
    let dd = Cout * Cin * K
    let tol = 0.000000001

    let x  = t_zeros(T * Cin);  t_fill_lcg(x, T * Cin, 31, 0.4)
    let w  = t_zeros(dd);       t_fill_lcg(w, dd, 2, 0.2)
    let b  = t_zeros(Cout);     t_fill_lcg(b, Cout, 3, 0.1)

    // ── F-CLM-DEVFEED-IM2COL-EQ : devfeed gather == inline xcol reference ──
    let mut all_ok = 1
    let mut dil = 1
    while dil <= 2 {
        let Kdim = Cin * K
        let xcolR = t_zeros(T * Kdim)
        let mut t = 0
        while t < T {
            let mut ci = 0
            while ci < Cin {
                let mut k = 0
                while k < K {
                    let p = t - dil * (K - 1 - k)
                    if p >= 0 { t_set(xcolR, t * Kdim + ci * K + k, t_get(x, p * Cin + ci)) }
                    k = k + 1
                }
                ci = ci + 1
            }
            t = t + 1
        }
        let xcolD = t_zeros(T * Kdim)
        devfeed_im2col(x, xcolD, T, Cin, K, dil)
        let mi = _maxdev(xcolR, xcolD, T * Kdim)
        print("  im2col dil="); print(dil); print(" max|Δ|="); println(to_string(mi))
        if mi > tol { all_ok = 0 }
        t_free(xcolR); t_free(xcolD)
        dil = dil + 1
    }
    if all_ok == 1 { println("F-CLM-DEVFEED-IM2COL-EQ = 1"); println("PASS — device im2col gather == host xcol byte-eq, dil∈{1,2}") }
    if all_ok == 0 { println("F-CLM-DEVFEED-IM2COL-EQ = 0"); println("FAIL — im2col") }

    // ── F-CLM-DEVFEED-FWD-EQ : devfeed conv fwd == reference forge conv fwd ──
    let mut fwd_ok = 1
    let mut dilf = 1
    while dilf <= 2 {
        let y_ref = t_zeros(T * Cout)
        _ref_conv_fwd(x, w, b, y_ref, T, Cin, Cout, K, dilf)
        let y_df = t_zeros(T * Cout)
        _devfeed_conv_fwd(x, w, b, y_df, T, Cin, Cout, K, dilf)
        let fd = _maxdev(y_ref, y_df, T * Cout)
        print("  fwd dil="); print(dilf); print(" max|Δ| devfeed-vs-forge = "); println(to_string(fd))
        if fd > tol { fwd_ok = 0 }
        t_free(y_ref); t_free(y_df)
        dilf = dilf + 1
    }
    if fwd_ok == 1 { println("F-CLM-DEVFEED-FWD-EQ = 1"); println("PASS — devfeed fwd == forge conv1d byte-eq, dil∈{1,2}") }
    if fwd_ok == 0 { println("F-CLM-DEVFEED-FWD-EQ = 0"); println("FAIL — fwd") }

    // ── F-CLM-DEVFEED-BWD-EQ : devfeed conv bwd == reference forge conv bwd ──
    let mut bwd_ok = 1
    let mut dil2 = 1
    while dil2 <= 2 {
        let dy = t_zeros(T * Cout)
        _ref_conv_fwd(x, w, b, dy, T, Cin, Cout, K, dil2)  // representative nonzero field
        let dW0 = t_zeros(dd); let dX0 = t_zeros(T * Cin); let db0 = t_zeros(Cout)
        _ref_conv_bwd(x, w, dy, dW0, dX0, db0, T, Cin, Cout, K, dil2)
        let dW1 = t_zeros(dd); let dX1 = t_zeros(T * Cin); let db1 = t_zeros(Cout)
        _devfeed_conv_bwd(x, w, dy, dW1, dX1, db1, T, Cin, Cout, K, dil2)
        let mW = _maxdev(dW0, dW1, dd); let mX = _maxdev(dX0, dX1, T * Cin); let mB = _maxdev(db0, db1, Cout)
        print("  bwd dil="); print(dil2); print(" max|Δ| dW="); print(to_string(mW))
        print(" dX="); print(to_string(mX)); print(" db="); println(to_string(mB))
        if mW > tol { bwd_ok = 0 }
        if mX > tol { bwd_ok = 0 }
        if mB > tol { bwd_ok = 0 }
        t_free(dy); t_free(dW0); t_free(dX0); t_free(db0); t_free(dW1); t_free(dX1); t_free(db1)
        dil2 = dil2 + 1
    }
    if bwd_ok == 1 { println("F-CLM-DEVFEED-BWD-EQ = 1"); println("PASS — devfeed bwd (dW/dX/db) == forge conv1d_bwd byte-eq, dil∈{1,2}") }
    if bwd_ok == 0 { println("F-CLM-DEVFEED-BWD-EQ = 0"); println("FAIL — bwd") }

    // ── F-CLM-DEVFEED-DB-EQ : HEXA-FUSION L1 (GRAD half) device-resident db ──
    // The bias grad db[co] = Σ_t dy[t,co] now routes through devfeed_db_colsum
    // (device kernel under CLM_PROD_DEVRESIDENT, host loop on the CPU oracle).
    // The device path sums T SEQUENTIALLY per channel (no tree re-association)
    // → must be byte-eq to the reference host reduction. This is the grad-half
    // analogue of the col2im scatter: db stays DEVICE-RESIDENT for the next
    // _adam H2D-skip; the falsifier here pins max|Δ|=0 of the colsum itself.
    let mut db_ok = 1
    let mut dilb = 1
    while dilb <= 2 {
        let dyb = t_zeros(T * Cout)
        _ref_conv_fwd(x, w, b, dyb, T, Cin, Cout, K, dilb)  // representative nonzero dy
        let dbR = t_zeros(Cout)   // reference host reduction
        let mut cr = 0
        while cr < Cout {
            let mut ac = 0.0; let mut tr = 0
            while tr < T { ac = ac + t_get(dyb, tr * Cout + cr); tr = tr + 1 }
            t_set(dbR, cr, ac); cr = cr + 1
        }
        let dbD = t_zeros(Cout)   // devfeed_db_colsum (device path / host fallback)
        devfeed_db_colsum(dyb, dbD, T, Cout)
        let mDB = _maxdev(dbR, dbD, Cout)
        print("  db dil="); print(dilb); print(" max|Δ| colsum-vs-host = "); println(to_string(mDB))
        if mDB > tol { db_ok = 0 }
        t_free(dyb); t_free(dbR); t_free(dbD)
        dilb = dilb + 1
    }
    if db_ok == 1 { println("F-CLM-DEVFEED-DB-EQ = 1"); println("PASS — device-resident db colsum == host Σ_t dy[t,co] byte-eq, dil∈{1,2}") }
    if db_ok == 0 { println("F-CLM-DEVFEED-DB-EQ = 0"); println("FAIL — db colsum") }

    // ── F-CLM-DEVFEED-INT4QUANT-EQ : HEXA-FUSION L1 (PARAM half) device int4 ──
    // The int4 fake-quant now routes through the device kernel
    // _hx_cuda_farr_int4_quant_gpu under CLM_PROD_DEVRESIDENT (host fake-quant on
    // this CPU oracle), keeping W FARR_DEVICE (no per-step W D2H — the last
    // roundtrip blocking full device-residency). int4 is INTEGER rounding +
    // per-channel SEQUENTIAL max → NO fp re-association → the device quant MUST
    // be EXACTLY byte-eq to the canonical host nn_int4_quant_fwd (max|Δ|=0 — int4
    // is integer, no FMA-drift excuse). Here we pin devfeed_int4_quant (the exact
    // device-kernel math reference) == nn_int4_quant_fwd (canonical host quant)
    // on wq/scale/qlevel/mask AND the STE bwd dW == nn_int4_quant_bwd, at a
    // STRICT zero (not the < tol band): a single bit difference fails the gate.
    let mut q_ok = 1
    let Cq = Cout; let restq = Cin * K   // per-output-channel quant, rest = Cin·K
    let nq = Cq * restq
    // canonical host quant (quant_lib.nn_int4_quant_fwd)
    let wqH = t_zeros(nq); let scH = t_zeros(Cq); let qlH = t_zeros(nq); let mkH = t_zeros(nq)
    nn_int4_quant_fwd(w, wqH, scH, qlH, mkH, Cq, restq)
    // device-kernel math reference (devfeed_int4_quant — what the GPU reproduces)
    let wqD = t_zeros(nq); let scD = t_zeros(Cq); let qlD = t_zeros(nq); let mkD = t_zeros(nq)
    devfeed_int4_quant(w, wqD, scD, qlD, mkD, Cq, restq)
    let mWq = _maxdev(wqH, wqD, nq); let mSc = _maxdev(scH, scD, Cq)
    let mQl = _maxdev(qlH, qlD, nq); let mMk = _maxdev(mkH, mkD, nq)
    print("  int4 fwd max|Δ| wq="); print(to_string(mWq)); print(" scale="); print(to_string(mSc))
    print(" qlevel="); print(to_string(mQl)); print(" mask="); println(to_string(mMk))
    if mWq > 0.0 { q_ok = 0 }
    if mSc > 0.0 { q_ok = 0 }
    if mQl > 0.0 { q_ok = 0 }
    if mMk > 0.0 { q_ok = 0 }
    // STE backward: dW = dy·mask (clipped straight-through). Device kernel is a
    // pure elementwise multiply → bit-exact to nn_int4_quant_bwd.
    let dyq = t_zeros(nq); t_fill_lcg(dyq, nq, 41, 0.25)
    let dWH = t_zeros(nq); nn_int4_quant_bwd(dyq, mkH, dWH, Cq, restq)
    let dWD = t_zeros(nq); devfeed_int4_quant_bwd(dyq, mkD, dWD, nq)
    let mDW = _maxdev(dWH, dWD, nq)
    print("  int4 bwd (STE) max|Δ| dW="); println(to_string(mDW))
    if mDW > 0.0 { q_ok = 0 }
    t_free(wqH); t_free(scH); t_free(qlH); t_free(mkH)
    t_free(wqD); t_free(scD); t_free(qlD); t_free(mkD)
    t_free(dyq); t_free(dWH); t_free(dWD)
    if q_ok == 1 { println("F-CLM-DEVFEED-INT4QUANT-EQ = 1"); println("PASS — device int4 quant fwd (wq/scale/qlevel/mask) + STE bwd == host quant byte-eq (max|Δ|=0, integer-exact)") }
    if q_ok == 0 { println("F-CLM-DEVFEED-INT4QUANT-EQ = 0"); println("FAIL — int4 quant") }

    // ── F-CLM-DEVFEED-RESIDUAL-EQ : HEXA-FUSION L3 (glue half) device residual ──
    // The fwd-path residual xt = xec + hg0 (clm_prod_fwd) now routes through the
    // device kernel _hx_cuda_farr_residual_add_gpu under CLM_PROD_DEVRESIDENT,
    // leaving the interpreter off the per-step hot path (the ③ fwd-only 0% util
    // floor: tensors device-resident is necessary but NOT sufficient while the
    // inter-op glue stays interpreted) and keeping the result FARR_DEVICE so the
    // next conv GEMM H2D-skips it. out[i] = a[i] + b[i] is a pure elementwise add
    // with NO reduction → the device add MUST be EXACTLY byte-eq to the host
    // scalar loop (max|Δ|=0 — no fp re-association, no FMA-drift excuse). Here we
    // pin devfeed_residual_add (the exact device-kernel math reference) == an
    // INDEPENDENT host scalar add at a STRICT zero (a single bit fails the gate).
    let mut rsd_ok = 1
    let nr = 257                       // odd len exercises the grid-stride tail
    let aR = t_zeros(nr); t_fill_lcg(aR, nr, 13, 0.4)
    let bR = t_zeros(nr); t_fill_lcg(bR, nr, 29, 0.6)
    // independent host reference (NOT via devfeed_residual_add)
    let outH = t_zeros(nr); let mut ri = 0
    while ri < nr { t_set(outH, ri, t_get(aR, ri) + t_get(bR, ri)); ri = ri + 1 }
    // device-kernel math reference (devfeed_residual_add — what the GPU reproduces)
    let outD = t_zeros(nr); devfeed_residual_add(aR, bR, outD, nr)
    let mRsd = _maxdev(outH, outD, nr)
    print("  residual-add max|Δ| out="); println(to_string(mRsd))
    if mRsd > 0.0 { rsd_ok = 0 }
    t_free(aR); t_free(bR); t_free(outH); t_free(outD)
    if rsd_ok == 1 { println("F-CLM-DEVFEED-RESIDUAL-EQ = 1"); println("PASS — device residual-add (xt = xec + hg0) == host scalar add byte-eq (max|Δ|=0)") }
    if rsd_ok == 0 { println("F-CLM-DEVFEED-RESIDUAL-EQ = 0"); println("FAIL — residual add") }

    // ── F-CLM-DEVFEED-GELU-EQ : HEXA-FUSION L3 (glue half) device GELU ──────────
    // The gelu ×3 in clm_prod_fwd (hg0/ex0/ex1) now route through the device
    // kernel _hx_cuda_farr_gelu_gpu under CLM_PROD_DEVRESIDENT, keeping out
    // FARR_DEVICE. out[i] = in[i]·0.5·(1+erf(in[i]/√2)) is the EXACT erf-based
    // GELU of nn_lib _nn_gelu — pure elementwise, NO reduction → the device gelu
    // MUST be EXACTLY byte-eq to an independent host erf-GELU (max|Δ|=0; erf is
    // the IEEE libm builtin, same contract host + CUDA). Pins devfeed_gelu (the
    // device-kernel math reference) == an INDEPENDENT inline host gelu at STRICT 0.
    let mut gel_ok = 1
    let ng = 257                       // odd len exercises the grid-stride tail
    let gG = t_zeros(ng); t_fill_lcg(gG, ng, 41, 1.5)   // wide range hits erf tails
    // independent inline host reference (NOT via devfeed_gelu)
    let gOH = t_zeros(ng); let isq2 = 0.70710678118654752440; let mut gi = 0
    while gi < ng {
        let xv = t_get(gG, gi)
        t_set(gOH, gi, xv * (0.5 * (1.0 + _devfeed_dt_erf(xv * isq2))))
        gi = gi + 1
    }
    // device-kernel math reference (devfeed_gelu — what the GPU reproduces)
    let gOD = t_zeros(ng); devfeed_gelu(gG, gOD, ng)
    let mGel = _maxdev(gOH, gOD, ng)
    print("  gelu max|Δ| out="); println(to_string(mGel))
    if mGel > 0.0 { gel_ok = 0 }
    t_free(gG); t_free(gOH); t_free(gOD)
    if gel_ok == 1 { println("F-CLM-DEVFEED-GELU-EQ = 1"); println("PASS — device GELU (hg0/ex0/ex1) == host erf-GELU byte-eq (max|Δ|=0)") }
    if gel_ok == 0 { println("F-CLM-DEVFEED-GELU-EQ = 0"); println("FAIL — gelu") }

    // ── F-CLM-DEVFEED-GROUPNORM-EQ : HEXA-FUSION L3 (glue half) device GroupNorm ─
    // The groupnorm ×2 in clm_prod_fwd (h0→hn0, y→yn) now route through the device
    // kernel _hx_cuda_farr_groupnorm_gpu under CLM_PROD_DEVRESIDENT, keeping
    // y/xhat/mean/inv FARR_DEVICE. GroupNorm has a per-group REDUCTION — the HARD
    // case for bit-exactness. The device kernel reduces SEQUENTIALLY (t outer, c
    // inner) under ONE thread per group (NO tree re-assoc) and uses the SAME
    // Newton-Raphson 40-iter sqrt as the host (NO CUDA rsqrt) → max|Δ| MUST be
    // EXACTLY 0. Pins devfeed_groupnorm (the device-kernel math reference, same
    // sequential order + same NR sqrt) == an INDEPENDENT inline host GroupNorm
    // (also sequential, same NR sqrt) on y/xhat/mean/inv at a STRICT zero.
    let mut gn_ok = 1
    let Tn = 13; let Cn = 8; let Gn = 2   // C%G==0; Cg=4; T·Cg=52 elems/group reduce
    let xN = t_zeros(Tn * Cn); t_fill_lcg(xN, Tn * Cn, 53, 1.2)
    let gaN = t_zeros(Cn); t_fill_lcg(gaN, Cn, 61, 0.7)
    let beN = t_zeros(Cn); t_fill_lcg(beN, Cn, 67, 0.5)
    // device-kernel math reference (devfeed_groupnorm — what the GPU reproduces)
    let yD = t_zeros(Tn * Cn); let mnD = t_zeros(Gn); let ivD = t_zeros(Gn); let xhD = t_zeros(Tn * Cn)
    devfeed_groupnorm(xN, gaN, beN, yD, mnD, ivD, xhD, Tn, Cn, Gn)
    // independent inline host reference (sequential reduction + NR-40 sqrt)
    let yH = t_zeros(Tn * Cn); let mnH = t_zeros(Gn); let ivH = t_zeros(Gn); let xhH = t_zeros(Tn * Cn)
    let epsN = 0.00001; let cgN = Cn / Gn; let mN = to_float(cgN * Tn)
    let mut gg = 0
    while gg < Gn {
        let c0 = gg * cgN
        let mut s = 0.0; let mut tt = 0
        while tt < Tn { let mut cc = 0; while cc < cgN { s = s + t_get(xN, tt * Cn + (c0 + cc)); cc = cc + 1 }; tt = tt + 1 }
        let mu = s / mN
        let mut vsum = 0.0; let mut t2 = 0
        while t2 < Tn { let mut c2 = 0; while c2 < cgN { let dd = t_get(xN, t2 * Cn + (c0 + c2)) - mu; vsum = vsum + dd * dd; c2 = c2 + 1 }; t2 = t2 + 1 }
        let varr = vsum / mN
        let invv = 1.0 / _devfeed_gn_sqrt(varr + epsN)
        t_set(mnH, gg, mu); t_set(ivH, gg, invv)
        let mut t3 = 0
        while t3 < Tn {
            let mut c3 = 0
            while c3 < cgN {
                let ch = c0 + c3
                let xh = (t_get(xN, t3 * Cn + ch) - mu) * invv
                t_set(xhH, t3 * Cn + ch, xh)
                t_set(yH, t3 * Cn + ch, t_get(gaN, ch) * xh + t_get(beN, ch))
                c3 = c3 + 1
            }
            t3 = t3 + 1
        }
        gg = gg + 1
    }
    let mGnY = _maxdev(yH, yD, Tn * Cn)
    let mGnXh = _maxdev(xhH, xhD, Tn * Cn)
    let mGnMn = _maxdev(mnH, mnD, Gn)
    let mGnIv = _maxdev(ivH, ivD, Gn)
    print("  groupnorm max|Δ| y="); print(to_string(mGnY)); print(" xhat="); print(to_string(mGnXh))
    print(" mean="); print(to_string(mGnMn)); print(" inv="); println(to_string(mGnIv))
    if mGnY > 0.0 { gn_ok = 0 }
    if mGnXh > 0.0 { gn_ok = 0 }
    if mGnMn > 0.0 { gn_ok = 0 }
    if mGnIv > 0.0 { gn_ok = 0 }
    t_free(xN); t_free(gaN); t_free(beN)
    t_free(yD); t_free(mnD); t_free(ivD); t_free(xhD)
    t_free(yH); t_free(mnH); t_free(ivH); t_free(xhH)
    if gn_ok == 1 { println("F-CLM-DEVFEED-GROUPNORM-EQ = 1"); println("PASS — device GroupNorm (h0→hn0, y→yn; seq reduction + NR sqrt) == host byte-eq (max|Δ|=0)") }
    if gn_ok == 0 { println("F-CLM-DEVFEED-GROUPNORM-EQ = 0"); println("FAIL — groupnorm") }

    // ── F-CLM-DEVFEED-EXPACK-EQ : HEXA-FUSION L3 (final ⑤c) device expert-pack ──
    // The clm_prod_fwd j-loop (ex0/ex1 → ex_out[E·T·d]) now routes through the
    // device kernel _hx_cuda_farr_expert_pack2_gpu under CLM_PROD_DEVRESIDENT,
    // keeping ex_out FARR_DEVICE. Pure copy, NO reduction → MUST be EXACTLY
    // byte-eq (max|Δ|=0). Pins devfeed_expert_pack2 (the device-kernel reference)
    // == an INDEPENDENT inline host pack at STRICT 0 (E=2 stack, n=T·d).
    let mut ep_ok = 1
    let epN = 251                       // odd len exercises the grid-stride tail
    let ep0 = t_zeros(epN); t_fill_lcg(ep0, epN, 71, 1.1)
    let ep1 = t_zeros(epN); t_fill_lcg(ep1, epN, 73, 0.9)
    // device-kernel reference (devfeed_expert_pack2 — what the GPU reproduces)
    let epD = t_zeros(2 * epN); devfeed_expert_pack2(ep0, ep1, epD, epN)
    // independent inline host pack (NOT via devfeed_expert_pack2)
    let epH = t_zeros(2 * epN); let mut epj = 0
    while epj < epN {
        t_set(epH, 0 * epN + epj, t_get(ep0, epj))
        t_set(epH, 1 * epN + epj, t_get(ep1, epj))
        epj = epj + 1
    }
    let mEp = _maxdev(epH, epD, 2 * epN)
    print("  expert-pack max|Δ| ex_out="); println(to_string(mEp))
    if mEp > 0.0 { ep_ok = 0 }
    t_free(ep0); t_free(ep1); t_free(epD); t_free(epH)
    if ep_ok == 1 { println("F-CLM-DEVFEED-EXPACK-EQ = 1"); println("PASS — device expert-pack (ex0/ex1→ex_out) == host pack byte-eq (max|Δ|=0)") }
    if ep_ok == 0 { println("F-CLM-DEVFEED-EXPACK-EQ = 0"); println("FAIL — expert-pack") }

    // ── F-CLM-DEVFEED-MOEROUTER-EQ : HEXA-FUSION L3 (final ⑤c) device MoE router ─
    // The moe-router (logits_r·ex_out → y, probs) now routes through the device
    // kernel _hx_cuda_farr_moe_router_gpu under CLM_PROD_DEVRESIDENT, keeping
    // y/probs FARR_DEVICE. The router HAS A REDUCTION (softmax sum + weighted
    // combine) — the HARD case. The device kernel uses the SAME hand-rolled
    // _moe_exp (NOT CUDA exp) and reduces SEQUENTIALLY (e=0..E) under ONE thread
    // per t (NO tree re-assoc) → max|Δ| MUST be EXACTLY 0. Pins devfeed_moe_router
    // (the device-kernel reference) == an INDEPENDENT inline host router (also
    // sequential, same _moe_exp) on y AND probs at a STRICT zero.
    let mut mr_ok = 1
    let Tm = 11; let Em = 2; let Cm = 9   // E=2 experts (model shape), T·C combine
    let lgM = t_zeros(Tm * Em); t_fill_lcg(lgM, Tm * Em, 81, 1.3)   // logits range hits softmax tails
    let exM = t_zeros(Em * Tm * Cm); t_fill_lcg(exM, Em * Tm * Cm, 83, 1.0)
    // device-kernel reference (devfeed_moe_router — what the GPU reproduces)
    let prD = t_zeros(Tm * Em); let yD2 = t_zeros(Tm * Cm)
    devfeed_moe_router(lgM, exM, prD, yD2, Tm, Em, Cm)
    // independent inline host router (sequential softmax + sequential combine)
    let prH = t_zeros(Tm * Em); let yH2 = t_zeros(Tm * Cm)
    let mut tr = 0
    while tr < Tm {
        let bs = tr * Em
        let mut mxr = t_get(lgM, bs)
        let mut er = 1
        while er < Em { let vr = t_get(lgM, bs + er); if vr > mxr { mxr = vr }; er = er + 1 }
        let mut sr = 0.0; let mut er2 = 0
        while er2 < Em { let evr = _devfeed_moe_exp(t_get(lgM, bs + er2) - mxr); t_set(prH, bs + er2, evr); sr = sr + evr; er2 = er2 + 1 }
        let mut er3 = 0
        while er3 < Em { t_set(prH, bs + er3, t_get(prH, bs + er3) / sr); er3 = er3 + 1 }
        tr = tr + 1
    }
    let mut tr2 = 0
    while tr2 < Tm {
        let mut cr = 0
        while cr < Cm {
            let mut accr = 0.0; let mut er4 = 0
            while er4 < Em { accr = accr + t_get(prH, tr2 * Em + er4) * t_get(exM, er4 * Tm * Cm + tr2 * Cm + cr); er4 = er4 + 1 }
            t_set(yH2, tr2 * Cm + cr, accr)
            cr = cr + 1
        }
        tr2 = tr2 + 1
    }
    let mMrY = _maxdev(yH2, yD2, Tm * Cm)
    let mMrP = _maxdev(prH, prD, Tm * Em)
    print("  moe-router max|Δ| y="); print(to_string(mMrY)); print(" probs="); println(to_string(mMrP))
    if mMrY > 0.0 { mr_ok = 0 }
    if mMrP > 0.0 { mr_ok = 0 }
    t_free(lgM); t_free(exM); t_free(prD); t_free(yD2); t_free(prH); t_free(yH2)
    if mr_ok == 1 { println("F-CLM-DEVFEED-MOEROUTER-EQ = 1"); println("PASS — device MoE router (softmax+combine; seq reduction + _moe_exp) == host byte-eq (max|Δ|=0)") }
    if mr_ok == 0 { println("F-CLM-DEVFEED-MOEROUTER-EQ = 0"); println("FAIL — moe-router") }

    // ── F-CLM-DEVFEED-EMBED-EQ : HEXA-FUSION L3 (final ⑤c) device embedding gather ─
    // The embedding gather (tokens→xe) at the fwd head now routes through the
    // device kernel _hx_cuda_farr_embedding_gpu under CLM_PROD_DEVRESIDENT,
    // keeping xe FARR_DEVICE. Pure gather, NO reduction → MUST be EXACTLY byte-eq
    // (max|Δ|=0). Pins devfeed_embedding (tok=(int)ids[i] truncate, table gather —
    // the device-kernel reference) == an INDEPENDENT inline host gather at STRICT 0.
    let mut em_ok = 1
    let Te = 19; let de = 7; let Ve = 23   // T positions gather rows from a V·d table
    let idE = t_zeros(Te); let mut ie = 0
    while ie < Te { t_set(idE, ie, to_float((ie * 7 + 3) % Ve)); ie = ie + 1 }   // varied token ids in [0,V)
    let tbE = t_zeros(Ve * de); t_fill_lcg(tbE, Ve * de, 91, 1.4)
    // device-kernel reference (devfeed_embedding — what the GPU reproduces)
    let xeD = t_zeros(Te * de); devfeed_embedding(idE, tbE, xeD, Te, de)
    // independent inline host gather (NOT via devfeed_embedding)
    let xeH = t_zeros(Te * de); let mut ie2 = 0
    while ie2 < Te {
        let tok = to_int(t_get(idE, ie2))
        let mut ce = 0
        while ce < de { t_set(xeH, ie2 * de + ce, t_get(tbE, tok * de + ce)); ce = ce + 1 }
        ie2 = ie2 + 1
    }
    let mEm = _maxdev(xeH, xeD, Te * de)
    print("  embedding max|Δ| xe="); println(to_string(mEm))
    if mEm > 0.0 { em_ok = 0 }
    t_free(idE); t_free(tbE); t_free(xeD); t_free(xeH)
    if em_ok == 1 { println("F-CLM-DEVFEED-EMBED-EQ = 1"); println("PASS — device embedding gather (tokens→xe) == host gather byte-eq (max|Δ|=0)") }
    if em_ok == 0 { println("F-CLM-DEVFEED-EMBED-EQ = 0"); println("FAIL — embedding") }

    // ── F-CLM-DEVFEED-GELU-BWD-EQ : HEXA-FUSION L3 (BWD glue half) device gelu_bwd ─
    // The gelu_bwd ×3 in clm_prod_bwd (deo0/deo1/dhn0) now route through the device
    // kernel _hx_cuda_farr_gelu_bwd_gpu under CLM_PROD_DEVRESIDENT, keeping dg
    // FARR_DEVICE. dg[i]=da[i]·GELU'(g[i]), GELU'(x)=Φ(x)+x·φ(x) is the EXACT
    // erf/exp-based gelu grad of nn_lib nn_gelu_bwd — pure elementwise, NO reduction
    // → the device gelu_bwd MUST be EXACTLY byte-eq to an independent host erf/exp
    // grad (max|Δ|=0; erf/exp are the IEEE libm builtins, same contract host + CUDA).
    // Pins devfeed_gelu_bwd (the device-kernel math reference) == an INDEPENDENT
    // inline host gelu_bwd at STRICT 0.
    let mut gelb_ok = 1
    let ngb = 257                      // odd len exercises the grid-stride tail
    let gGb = t_zeros(ngb); t_fill_lcg(gGb, ngb, 53, 1.5)   // wide range hits erf/exp tails
    let daB = t_zeros(ngb); t_fill_lcg(daB, ngb, 67, 0.8)   // upstream grad
    // device-kernel reference (devfeed_gelu_bwd — what the GPU reproduces)
    let dgD = t_zeros(ngb); devfeed_gelu_bwd(gGb, daB, dgD, ngb)
    // independent inline host reference (NOT via devfeed_gelu_bwd)
    let dgH = t_zeros(ngb); let isq2b = 0.70710678118654752440; let isq2pi = 0.39894228040143267794
    let mut gbi = 0
    while gbi < ngb {
        let xv = t_get(gGb, gbi)
        let cdf = 0.5 * (1.0 + _devfeed_dt_erf(xv * isq2b))
        let pdf = isq2pi * _devfeed_dt_exp(0.0 - 0.5 * xv * xv)
        t_set(dgH, gbi, t_get(daB, gbi) * (cdf + xv * pdf))
        gbi = gbi + 1
    }
    let mGelb = _maxdev(dgH, dgD, ngb)
    print("  gelu_bwd max|Δ| dg="); println(to_string(mGelb))
    if mGelb > 0.0 { gelb_ok = 0 }
    t_free(gGb); t_free(daB); t_free(dgD); t_free(dgH)
    if gelb_ok == 1 { println("F-CLM-DEVFEED-GELU-BWD-EQ = 1"); println("PASS — device GELU bwd (deo0/deo1/dhn0) == host erf/exp gelu-grad byte-eq (max|Δ|=0)") }
    if gelb_ok == 0 { println("F-CLM-DEVFEED-GELU-BWD-EQ = 0"); println("FAIL — gelu_bwd") }

    // ── F-CLM-DEVFEED-GROUPNORM-BWD-EQ : HEXA-FUSION L3 (BWD glue half) device gn_bwd ─
    // The groupnorm_bwd ×2 in clm_prod_bwd (dy←dynorm, dh0←dhn0) now route through
    // the device kernel _hx_cuda_farr_groupnorm_bwd_gpu under CLM_PROD_DEVRESIDENT,
    // keeping dgamma/dbeta/dx FARR_DEVICE. The per-channel + per-group reductions
    // accumulate SEQUENTIALLY in the host order (NO tree re-assoc) and read the SAVED
    // forward inv → the device gn_bwd MUST be EXACTLY byte-eq to an INDEPENDENT
    // inline host gn_bwd (max|Δ|=0). We first run the fwd (devfeed_groupnorm) to
    // produce a consistent xhat/inv, then pin devfeed_groupnorm_bwd (the device-
    // kernel math reference) == an INDEPENDENT inline host bwd (NOT via the device
    // reference, the same gn_lib nn_groupnorm_bwd math) at STRICT 0 on dgamma/dbeta/dx.
    let mut gnb_ok = 1
    let Tg = 12; let Cg = 8; let Gg = 2   // C%G==0, cg=4
    let xG = t_zeros(Tg * Cg); t_fill_lcg(xG, Tg * Cg, 31, 1.1)
    let gaG = t_zeros(Cg); t_fill_lcg(gaG, Cg, 37, 0.9)
    let beG = t_zeros(Cg); t_fill_lcg(beG, Cg, 41, 0.5)
    let yG = t_zeros(Tg * Cg); let mnG = t_zeros(Gg); let ivG = t_zeros(Gg); let xhG = t_zeros(Tg * Cg)
    devfeed_groupnorm(xG, gaG, beG, yG, mnG, ivG, xhG, Tg, Cg, Gg)   // produce xhat/inv
    let dyG = t_zeros(Tg * Cg); t_fill_lcg(dyG, Tg * Cg, 59, 0.7)    // upstream grad
    // device-kernel reference (devfeed_groupnorm_bwd — what the GPU reproduces)
    let dgaD = t_zeros(Cg); let dbeD = t_zeros(Cg); let dxD = t_zeros(Tg * Cg)
    devfeed_groupnorm_bwd(xhG, ivG, gaG, dyG, dgaD, dbeD, dxD, Tg, Cg, Gg)
    // INDEPENDENT inline host bwd (NOT via devfeed_groupnorm_bwd — gn_lib math)
    let dgaH = t_zeros(Cg); let dbeH = t_zeros(Cg); let dxH = t_zeros(Tg * Cg)
    let cgh = Cg / Gg; let mh = to_float(cgh * Tg)
    let mut chn = 0
    while chn < Cg {
        let mut sgh = 0.0; let mut sbh = 0.0; let mut tch = 0
        while tch < Tg {
            let idxh = tch * Cg + chn; let gyh = t_get(dyG, idxh)
            sgh = sgh + gyh * t_get(xhG, idxh); sbh = sbh + gyh; tch = tch + 1
        }
        t_set(dgaH, chn, sgh); t_set(dbeH, chn, sbh); chn = chn + 1
    }
    let mut grh = 0
    while grh < Gg {
        let c0h = grh * cgh; let invh = t_get(ivG, grh)
        let mut s1h = 0.0; let mut s2h = 0.0; let mut t1h = 0
        while t1h < Tg {
            let mut cc1 = 0
            while cc1 < cgh {
                let chh = c0h + cc1; let idxh = t1h * Cg + chh
                let dxhh = t_get(dyG, idxh) * t_get(gaG, chh)
                s1h = s1h + dxhh; s2h = s2h + dxhh * t_get(xhG, idxh); cc1 = cc1 + 1
            }
            t1h = t1h + 1
        }
        let mut t2h = 0
        while t2h < Tg {
            let mut cc2 = 0
            while cc2 < cgh {
                let chh = c0h + cc2; let idxh = t2h * Cg + chh
                let dxhh = t_get(dyG, idxh) * t_get(gaG, chh)
                t_set(dxH, idxh, invh * (dxhh - s1h / mh - t_get(xhG, idxh) * s2h / mh)); cc2 = cc2 + 1
            }
            t2h = t2h + 1
        }
        grh = grh + 1
    }
    let mDga = _maxdev(dgaH, dgaD, Cg); let mDbe = _maxdev(dbeH, dbeD, Cg); let mDx = _maxdev(dxH, dxD, Tg * Cg)
    print("  groupnorm_bwd max|Δ| dgamma="); print(to_string(mDga)); print(" dbeta="); print(to_string(mDbe)); print(" dX="); println(to_string(mDx))
    if mDga > 0.0 { gnb_ok = 0 }
    if mDbe > 0.0 { gnb_ok = 0 }
    if mDx > 0.0 { gnb_ok = 0 }
    t_free(xG); t_free(gaG); t_free(beG); t_free(yG); t_free(mnG); t_free(ivG); t_free(xhG)
    t_free(dyG); t_free(dgaD); t_free(dbeD); t_free(dxD); t_free(dgaH); t_free(dbeH); t_free(dxH)
    if gnb_ok == 1 { println("F-CLM-DEVFEED-GROUPNORM-BWD-EQ = 1"); println("PASS — device GroupNorm bwd (dgamma/dbeta/dX; seq reduction + saved inv) == host nn_groupnorm_bwd byte-eq (max|Δ|=0)") }
    if gnb_ok == 0 { println("F-CLM-DEVFEED-GROUPNORM-BWD-EQ = 0"); println("FAIL — groupnorm_bwd") }

    // ── F-CLM-DEVFEED-EXUNPACK-EQ : HEXA-FUSION L3 (BWD glue half) device unpack ──
    // The expert-unpack (dex_out→dex0/dex1) in clm_prod_bwd now routes through the
    // device kernel _hx_cuda_farr_expert_unpack2_gpu under CLM_PROD_DEVRESIDENT,
    // keeping dex0/dex1 FARR_DEVICE. dex0[i]=dex_out[0·n+i], dex1[i]=dex_out[1·n+i]
    // is a pure copy with NO arithmetic → the device unpack MUST be EXACTLY byte-eq
    // to the host scalar loop (max|Δ|=0). Pins devfeed_expert_unpack2 (the device-
    // kernel reference) == an INDEPENDENT inline host unpack at STRICT 0.
    let mut exu_ok = 1
    let nu = 257                       // odd len exercises the grid-stride tail
    let dexAll = t_zeros(2 * nu); t_fill_lcg(dexAll, 2 * nu, 71, 0.9)
    // device-kernel reference (devfeed_expert_unpack2 — what the GPU reproduces)
    let d0D = t_zeros(nu); let d1D = t_zeros(nu); devfeed_expert_unpack2(dexAll, d0D, d1D, nu)
    // independent inline host unpack (NOT via devfeed_expert_unpack2)
    let d0H = t_zeros(nu); let d1H = t_zeros(nu); let mut ui = 0
    while ui < nu {
        t_set(d0H, ui, t_get(dexAll, 0 * nu + ui))
        t_set(d1H, ui, t_get(dexAll, 1 * nu + ui))
        ui = ui + 1
    }
    let mEx0 = _maxdev(d0H, d0D, nu); let mEx1 = _maxdev(d1H, d1D, nu)
    print("  expert-unpack max|Δ| dex0="); print(to_string(mEx0)); print(" dex1="); println(to_string(mEx1))
    if mEx0 > 0.0 { exu_ok = 0 }
    if mEx1 > 0.0 { exu_ok = 0 }
    t_free(dexAll); t_free(d0D); t_free(d1D); t_free(d0H); t_free(d1H)
    if exu_ok == 1 { println("F-CLM-DEVFEED-EXUNPACK-EQ = 1"); println("PASS — device expert-unpack (dex_out→dex0/dex1) == host unpack byte-eq (max|Δ|=0)") }
    if exu_ok == 0 { println("F-CLM-DEVFEED-EXUNPACK-EQ = 0"); println("FAIL — expert-unpack") }

    // ── F-CLM-DEVFEED-CE-GRAD-EQ : HEXA-FUSION L3 (BWD glue · ⑤-bwd2) device ce_grad ─
    // The clm_ce_grad host glue at the head of the bwd now routes through the device
    // kernel _hx_cuda_farr_ce_grad_gpu under CLM_PROD_DEVRESIDENT, keeping dlogits
    // FARR_DEVICE. dlogits[t,v]=(exp(logit-mx)/sm)·(1/T), dlogits[t,tgt]-=1/T is a
    // per-row sequential softmax-grad (libm exp, same host contract) → the device
    // ce_grad MUST be EXACTLY byte-eq to an INDEPENDENT inline host softmax-grad
    // (max|Δ|=0). Pins devfeed_ce_grad (device-kernel reference) == independent host.
    let mut ceg_ok = 1
    let Tce = 9; let Vce = 17                 // small T·V, odd to exercise tails
    let lgCe = t_zeros(Tce * Vce); t_fill_lcg(lgCe, Tce * Vce, 83, 1.3)
    let tgCe = t_zeros(Tce)                   // integer-valued targets in [0,Vce)
    let mut tci = 0
    while tci < Tce { t_set(tgCe, tci, to_float((tci * 5 + 3) - ((tci * 5 + 3) / Vce) * Vce)); tci = tci + 1 }
    // device-kernel reference (devfeed_ce_grad — what the GPU reproduces)
    let dlD = t_zeros(Tce * Vce); devfeed_ce_grad(lgCe, tgCe, dlD, Tce, Vce)
    // INDEPENDENT inline host softmax-grad (NOT via devfeed_ce_grad)
    let dlH = t_zeros(Tce * Vce)
    let mut tH = 0
    while tH < Tce {
        let bs = tH * Vce
        let mut mxh = t_get(lgCe, bs); let mut ih = 1
        while ih < Vce { let vv = t_get(lgCe, bs + ih); if vv > mxh { mxh = vv }; ih = ih + 1 }
        let mut smh = 0.0; let mut ih2 = 0
        while ih2 < Vce { smh = smh + exp(t_get(lgCe, bs + ih2) - mxh); ih2 = ih2 + 1 }
        let invTh = 1.0 / to_float(Tce)
        let mut vh = 0
        while vh < Vce { t_set(dlH, bs + vh, (exp(t_get(lgCe, bs + vh) - mxh) / smh) * invTh); vh = vh + 1 }
        let tgth = to_int(t_get(tgCe, tH))
        t_set(dlH, bs + tgth, t_get(dlH, bs + tgth) - invTh)
        tH = tH + 1
    }
    let mCeg = _maxdev(dlH, dlD, Tce * Vce)
    print("  ce_grad max|Δ| dlogits="); println(to_string(mCeg))
    if mCeg > 0.0 { ceg_ok = 0 }
    t_free(lgCe); t_free(tgCe); t_free(dlD); t_free(dlH)
    if ceg_ok == 1 { println("F-CLM-DEVFEED-CE-GRAD-EQ = 1"); println("PASS — device CE softmax-grad (dlogits) == host clm_ce_grad byte-eq (max|Δ|=0)") }
    if ceg_ok == 0 { println("F-CLM-DEVFEED-CE-GRAD-EQ = 0"); println("FAIL — ce_grad") }

    // ── F-CLM-DEVFEED-MOEROUTER-BWD-EQ : HEXA-FUSION L3 (BWD · ⑤-bwd2) device moe_bwd ─
    // The nn_moe_router_bwd host glue in clm_prod_bwd now routes through the device
    // kernel _hx_cuda_farr_moe_router_bwd_gpu under CLM_PROD_DEVRESIDENT, keeping
    // dlogits/dex_out FARR_DEVICE. The 2-pass-over-E + inner-C reductions accumulate
    // SEQUENTIALLY in the host order (NO tree re-assoc) and read CACHED probs (NO
    // _moe_exp replay) → the device moe_bwd MUST be EXACTLY byte-eq to an INDEPENDENT
    // inline host bwd (max|Δ|=0). Pins devfeed_moe_router_bwd == independent host.
    let mut mrb_ok = 1
    let Tm = 7; let Em = 2; let Cm = 6
    let prM = t_zeros(Tm * Em); t_fill_lcg(prM, Tm * Em, 89, 0.4)   // any probs (bwd reads them verbatim)
    let exM = t_zeros(Em * Tm * Cm); t_fill_lcg(exM, Em * Tm * Cm, 97, 1.0)
    let dyM = t_zeros(Tm * Cm); t_fill_lcg(dyM, Tm * Cm, 101, 0.6)
    // device-kernel reference
    let dlmD = t_zeros(Tm * Em); let dexD = t_zeros(Em * Tm * Cm)
    devfeed_moe_router_bwd(prM, exM, dyM, dlmD, dexD, Tm, Em, Cm)
    // INDEPENDENT inline host bwd (NOT via devfeed_moe_router_bwd)
    let dlmH = t_zeros(Tm * Em); let dexH = t_zeros(Em * Tm * Cm)
    let mut tm = 0
    while tm < Tm {
        let mut doth = 0.0; let mut em = 0
        while em < Em {
            let pteh = t_get(prM, tm * Em + em); let mut dgh = 0.0; let mut cm = 0
            while cm < Cm {
                let gyh = t_get(dyM, tm * Cm + cm)
                dgh = dgh + gyh * t_get(exM, em * Tm * Cm + tm * Cm + cm)
                t_set(dexH, em * Tm * Cm + tm * Cm + cm, pteh * gyh); cm = cm + 1
            }
            t_set(dlmH, tm * Em + em, dgh); doth = doth + pteh * dgh; em = em + 1
        }
        let mut em2 = 0
        while em2 < Em {
            let pteh = t_get(prM, tm * Em + em2); let dgh = t_get(dlmH, tm * Em + em2)
            t_set(dlmH, tm * Em + em2, pteh * (dgh - doth)); em2 = em2 + 1
        }
        tm = tm + 1
    }
    let mDlm = _maxdev(dlmH, dlmD, Tm * Em); let mDex = _maxdev(dexH, dexD, Em * Tm * Cm)
    print("  moe_router_bwd max|Δ| dlogits="); print(to_string(mDlm)); print(" dex_out="); println(to_string(mDex))
    if mDlm > 0.0 { mrb_ok = 0 }
    if mDex > 0.0 { mrb_ok = 0 }
    t_free(prM); t_free(exM); t_free(dyM); t_free(dlmD); t_free(dexD); t_free(dlmH); t_free(dexH)
    if mrb_ok == 1 { println("F-CLM-DEVFEED-MOEROUTER-BWD-EQ = 1"); println("PASS — device MoE-router bwd (dlogits/dex_out; seq reduction + cached probs) == host nn_moe_router_bwd byte-eq (max|Δ|=0)") }
    if mrb_ok == 0 { println("F-CLM-DEVFEED-MOEROUTER-BWD-EQ = 0"); println("FAIL — moe_router_bwd") }

    // ── F-CLM-DEVFEED-GRADSUM-EQ : HEXA-FUSION L3 (BWD · ⑤-bwd2) device grad sums ─
    // The dxt 3-way (dxt_r+dxt_e0+dxt_e1) and dxec 2-way (dxt+dxec_b) grad sums in
    // clm_prod_bwd now route through _hx_cuda_farr_grad_sum3_gpu /
    // _hx_cuda_farr_grad_sum2_gpu under CLM_PROD_DEVRESIDENT, keeping the result
    // FARR_DEVICE. Pure elementwise (fixed (a+b)+c / a+b association) → the device
    // sums MUST be EXACTLY byte-eq to an INDEPENDENT inline host sum (max|Δ|=0).
    let mut gs_ok = 1
    let ns = 259                       // odd len exercises the grid-stride tail
    let saA = t_zeros(ns); t_fill_lcg(saA, ns, 103, 0.9)
    let saB = t_zeros(ns); t_fill_lcg(saB, ns, 107, 0.7)
    let saC = t_zeros(ns); t_fill_lcg(saC, ns, 109, 0.5)
    let s3D = t_zeros(ns); devfeed_grad_sum3(saA, saB, saC, s3D, ns)
    let s2D = t_zeros(ns); devfeed_grad_sum2(saA, saB, s2D, ns)
    let s3H = t_zeros(ns); let s2H = t_zeros(ns); let mut si = 0
    while si < ns {
        t_set(s3H, si, t_get(saA, si) + t_get(saB, si) + t_get(saC, si))
        t_set(s2H, si, t_get(saA, si) + t_get(saB, si))
        si = si + 1
    }
    let mS3 = _maxdev(s3H, s3D, ns); let mS2 = _maxdev(s2H, s2D, ns)
    print("  grad-sum max|Δ| sum3="); print(to_string(mS3)); print(" sum2="); println(to_string(mS2))
    if mS3 > 0.0 { gs_ok = 0 }
    if mS2 > 0.0 { gs_ok = 0 }
    t_free(saA); t_free(saB); t_free(saC); t_free(s3D); t_free(s2D); t_free(s3H); t_free(s2H)
    if gs_ok == 1 { println("F-CLM-DEVFEED-GRADSUM-EQ = 1"); println("PASS — device grad sums (dxt 3-way + dxec 2-way) == host sum byte-eq (max|Δ|=0)") }
    if gs_ok == 0 { println("F-CLM-DEVFEED-GRADSUM-EQ = 0"); println("FAIL — grad-sum") }

    // ── F-CLM-DEVFEED-EMBSCATTER-EQ : HEXA-FUSION L3 (BWD · ⑤-bwd2) device scatter ─
    // The nn_embedding_bwd_scatter host glue at the bwd tail now routes through the
    // device kernel _hx_cuda_farr_embedding_bwd_scatter_gpu under CLM_PROD_DEVRESIDENT,
    // keeping dembed FARR_DEVICE. dtable[tok·d+c] += dx[i·d+c] (tok=(int)ids[i], i
    // ascending) — the device kernel uses ONE thread per vocab row scanning i
    // ascending so COLLIDING tokens accumulate in the SAME order → the device scatter
    // MUST be EXACTLY byte-eq to an INDEPENDENT inline host scatter (max|Δ|=0). The
    // ids deliberately COLLIDE (multiple positions → same row) to exercise the
    // accumulation order. Pins devfeed_embedding_bwd_scatter == independent host.
    let mut ebs_ok = 1
    let Te = 11; let de = 4; let Ve = 5      // Te > Ve forces collisions
    let dxe2 = t_zeros(Te * de); t_fill_lcg(dxe2, Te * de, 113, 0.8)
    let idse = t_zeros(Te)
    let mut iei = 0
    while iei < Te { t_set(idse, iei, to_float((iei * 3) - ((iei * 3) / Ve) * Ve)); iei = iei + 1 }   // ids in [0,Ve), colliding
    // device-kernel reference (dtable pre-zeroed)
    let dtD = t_zeros(Ve * de); devfeed_embedding_bwd_scatter(dxe2, idse, dtD, Te, de)
    // INDEPENDENT inline host scatter (NOT via devfeed_embedding_bwd_scatter; pre-zeroed)
    let dtH = t_zeros(Ve * de)
    let mut ie = 0
    while ie < Te {
        let toke = to_int(t_get(idse, ie)); let mut ce = 0
        while ce < de {
            let cure = t_get(dtH, toke * de + ce)
            t_set(dtH, toke * de + ce, cure + t_get(dxe2, ie * de + ce)); ce = ce + 1
        }
        ie = ie + 1
    }
    let mEbs = _maxdev(dtH, dtD, Ve * de)
    print("  embedding-scatter max|Δ| dtable="); println(to_string(mEbs))
    if mEbs > 0.0 { ebs_ok = 0 }
    t_free(dxe2); t_free(idse); t_free(dtD); t_free(dtH)
    if ebs_ok == 1 { println("F-CLM-DEVFEED-EMBSCATTER-EQ = 1"); println("PASS — device embedding scatter (dembed grad accumulate; per-row seq, NO atomics) == host nn_embedding_bwd_scatter byte-eq (max|Δ|=0)") }
    if ebs_ok == 0 { println("F-CLM-DEVFEED-EMBSCATTER-EQ = 0"); println("FAIL — embedding-scatter") }

    // ── F-CLM-DEVFEED-ADAM-EQ : host AdamW oracle trajectory self-consistent ──
    // The device AdamW (forge_dispatch_adamw, wired in clm_prod.hexa under env)
    // routes to _hx_cuda_farr_adamw_step_inplace_gpu — already byte-eq to this
    // SAME opt_adamw_step builtin (the #2383-class adamw kernel proof). Here we
    // confirm the host oracle the device path falls back to / is checked against
    // runs a stable 5-step trajectory (two independent runs bit-identical).
    let n = 17
    let WA = t_zeros(n); t_fill_lcg(WA, n, 7, 0.3)
    let WB = t_zeros(n); let mut ci0 = 0
    while ci0 < n { t_set(WB, ci0, t_get(WA, ci0)); ci0 = ci0 + 1 }
    let mA = t_zeros(n); let vA = t_zeros(n)
    let mB2 = t_zeros(n); let vB2 = t_zeros(n)
    let mut adam_ok = 1
    let mut st = 1
    while st <= 5 {
        let gA = t_zeros(n); t_fill_lcg(gA, n, 20 + st, 0.15)
        let gB = t_zeros(n); let mut ci1 = 0
        while ci1 < n { t_set(gB, ci1, t_get(gA, ci1)); ci1 = ci1 + 1 }
        opt_adamw_step(WA, gA, mA, vA, n, 0.05, 0.9, 0.999, 0.00000001, 0.0, st)
        opt_adamw_step(WB, gB, mB2, vB2, n, 0.05, 0.9, 0.999, 0.00000001, 0.0, st)
        let mw = _maxdev(WA, WB, n); let mm2 = _maxdev(mA, mB2, n); let mv = _maxdev(vA, vB2, n)
        if mw > tol { adam_ok = 0 }
        if mm2 > tol { adam_ok = 0 }
        if mv > tol { adam_ok = 0 }
        t_free(gA); t_free(gB)
        st = st + 1
    }
    let mwF = _maxdev(WA, WB, n)
    print("  adam 5-step max|Δ| W="); println(to_string(mwF))
    if adam_ok == 1 { println("F-CLM-DEVFEED-ADAM-EQ = 1"); println("PASS — AdamW oracle (opt_adamw_step) deterministic 5-step trajectory") }
    if adam_ok == 0 { println("F-CLM-DEVFEED-ADAM-EQ = 0"); println("FAIL — adam") }

    if all_ok == 1 { if fwd_ok == 1 { if bwd_ok == 1 { if db_ok == 1 { if q_ok == 1 { if rsd_ok == 1 { if gel_ok == 1 { if gn_ok == 1 { if ep_ok == 1 { if mr_ok == 1 { if em_ok == 1 { if gelb_ok == 1 { if gnb_ok == 1 { if exu_ok == 1 { if ceg_ok == 1 { if mrb_ok == 1 { if gs_ok == 1 { if ebs_ok == 1 { if adam_ok == 1 {
        println("ALL-PASS — LEVER (a) device im2col/col2im + device db colsum + device int4 quant + device residual-add + device gelu + device groupnorm + device expert-pack + device moe-router + device embedding glue + BWD device gelu_bwd + device groupnorm_bwd + device expert-unpack + device ce_grad + device moe-router_bwd + device grad-sums + device embedding-scatter glue + device AdamW oracle byte-eq to host feed")
        return
    } } } } } } } } } } } } } } } } } } }
    println("FAIL")
}
