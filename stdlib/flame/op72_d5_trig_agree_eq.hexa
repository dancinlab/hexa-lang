// stdlib/flame/op72_d5_trig_agree_eq.hexa
// HEXA-0POD OP-72 · d5_sin / d5_cos AGREEMENT + DETERMINISM oracle · NO `use`
//
// THE GAP (documented-but-UNlocked, the OP-33 class):
//   flame_math.hexa's `d5_sin` / `d5_cos` (mod-2π reduce + 14-term Taylor)
//   carry an explicit docstring claim — "Identical to anima d_train5_lib.hexa
//   §271 / §284 … strict bit-eq path to anima d5_rope_tables output" — and are
//   PRODUCTION primitives: wired into the RoPE cos/sin tables
//   (nn_lib.hexa nn_rope_build_tables_base) AND the LR schedule
//   (optim_lib.hexa opt_lr_warmup_cosine, via d5_cos). Yet flame_math_test.hexa
//   locks only the dt_* siblings (dt_sqrt/dt_exp/dt_ln/dt_lcg) and dt_erf is
//   locked separately (F-OP19B). The d5 TRIG pair had NO agreement oracle:
//   nothing asserted d5_sin/d5_cos actually match libm sin/cos to a usable
//   tolerance over the RoPE+schedule input range, nor that they are
//   bit-reproducible run-to-run (the determinism property that makes them
//   libm-free / arch-OS-independent in the first place — F-OP33's premise).
//   OP-33 LOCKED THE SCHEDULE but ASSUMED d5_cos correct; this oracle closes
//   that assumption at the primitive level.
//
// THE LOCK (two gates, $0 / CPU-only / `hexa run`):
//   (1) AGREE  — over a 12-point probe spanning the production range
//       (schedule: |x| ≤ π·1 ≈ 3.14 ; RoPE: ang = pos·invf, pos up to ~10³,
//       invf ≤ 1 → |x| up to ~10³), assert max|d5_sin − sin| and
//       max|d5_cos − cos| are both ≤ 1e-9. (Measured ~1.3e-12 at x=1000;
//       the 1e-9 gate carries margin for the iterative-subtraction
//       range-reduction error that grows with |x|, matching libm's own
//       large-argument behaviour. The schedule range |x| ≤ π is ~1e-16.)
//   (2) DETERMINISM — d5_sin(x) and d5_cos(x) called twice on the SAME input
//       return byte-IDENTICAL doubles (max|Δ| via f64 bytes == 0) across the
//       full probe incl. the large-x reduction regime. This is the pure-FP
//       (+ − × ÷ only, NO libm) reproducibility that makes the RoPE tables and
//       the LR schedule arch/OS-independent.
//
// Self-contained (OP-28/29/33 scp/stdin pattern): d5 primitives inlined
// VERBATIM from stdlib/flame/flame_math.hexa so the oracle runs on ANY hexa
// host with no checkout. Keep in sync with flame_math.hexa.
//
// F-OP72-D5-TRIG-AGREE : .verdicts/hexa-0pod/F-OP72-D5-TRIG-AGREE.txt
// ════════════════════════════════════════════════════════════════════════

// ── flame_math d5 primitives (inlined VERBATIM — keep in sync) ──────────
fn d5_two_pi() -> float { return 6.283185307179586 }
fn d5_pi() -> float { return 3.141592653589793 }

fn d5_reduce(x: float) -> float {
    let tp = d5_two_pi()
    let mut r = x
    while r > d5_pi()  { r = r - tp }
    while r < 0.0 - d5_pi() { r = r + tp }
    return r
}

fn d5_sin(x: float) -> float {
    let r = d5_reduce(x)
    let r2 = r * r
    let mut term = r
    let mut acc = r
    let mut k = 1
    while k < 14 {
        term = 0.0 - term * r2 / to_float((2*k) * (2*k+1))
        acc = acc + term
        k = k + 1
    }
    return acc
}

fn d5_cos(x: float) -> float {
    let r = d5_reduce(x)
    let r2 = r * r
    let mut term = 1.0
    let mut acc = 1.0
    let mut k = 1
    while k < 14 {
        term = 0.0 - term * r2 / to_float((2*k-1) * (2*k))
        acc = acc + term
        k = k + 1
    }
    return acc
}

// ── helpers ─────────────────────────────────────────────────────────────
fn _m_abs(x: float) -> float {
    if x < 0.0 { return 0.0 - x }
    return x
}

// production-range probe: schedule (|x| ≤ π) + RoPE angles (pos·invf, up to ~10³)
fn _probe(xs: int) {
    farr_set(xs,  0, 0.0 - 3.1)
    farr_set(xs,  1, 0.0 - 1.5)
    farr_set(xs,  2, 0.0 - 0.5)
    farr_set(xs,  3, 0.0)
    farr_set(xs,  4, 0.3)
    farr_set(xs,  5, 1.0)
    farr_set(xs,  6, 1.5707963267948966)   // π/2
    farr_set(xs,  7, 3.141592653589793)    // π (schedule cosine-decay endpoint)
    farr_set(xs,  8, 6.283185307179586)    // 2π (reduction boundary)
    farr_set(xs,  9, 10.0)
    farr_set(xs, 10, 100.0)
    farr_set(xs, 11, 1000.0)               // RoPE long-context position scale
}

// ── (1) AGREE vs libm sin/cos ───────────────────────────────────────────
fn check_agree_sin() -> float {
    let xs = farr_zeros(12); _probe(xs)
    let mut max_dev = 0.0
    let mut i = 0
    while i < 12 {
        let x = farr_get(xs, i)
        let dev = _m_abs(d5_sin(x) - sin(x))
        if dev > max_dev { max_dev = dev }
        i = i + 1
    }
    let _ = farr_free(xs)
    return max_dev
}

fn check_agree_cos() -> float {
    let xs = farr_zeros(12); _probe(xs)
    let mut max_dev = 0.0
    let mut i = 0
    while i < 12 {
        let x = farr_get(xs, i)
        let dev = _m_abs(d5_cos(x) - cos(x))
        if dev > max_dev { max_dev = dev }
        i = i + 1
    }
    let _ = farr_free(xs)
    return max_dev
}

// ── (2) DETERMINISM — byte-identical run-to-run on same input ────────────
// f64_to_bytes_le gives the exact IEEE-754 pattern; max|Δ| over bytes == 0
// proves bit-equality (not just |a−b| float compare).
fn _bytes_eq_f64(a: float, b: float) -> int {
    let ba = f64_to_bytes_le(a)
    let bb = f64_to_bytes_le(b)
    let mut j = 0
    let mut eq = 1
    while j < len(ba) {
        if ba[j] != bb[j] { eq = 0 }
        j = j + 1
    }
    return eq
}

fn check_det() -> int {
    let xs = farr_zeros(12); _probe(xs)
    let mut all_eq = 1
    let mut i = 0
    while i < 12 {
        let x = farr_get(xs, i)
        if _bytes_eq_f64(d5_sin(x), d5_sin(x)) == 0 { all_eq = 0 }
        if _bytes_eq_f64(d5_cos(x), d5_cos(x)) == 0 { all_eq = 0 }
        i = i + 1
    }
    let _ = farr_free(xs)
    return all_eq
}

// pythagorean closure: sin²+cos² == 1 within Taylor tol (closed invariant,
// independent of libm — locks internal algebraic consistency of the pair).
fn check_pythagoras() -> float {
    let xs = farr_zeros(12); _probe(xs)
    let mut max_dev = 0.0
    let mut i = 0
    while i < 12 {
        let x = farr_get(xs, i)
        let s = d5_sin(x)
        let c = d5_cos(x)
        let dev = _m_abs(s * s + c * c - 1.0)
        if dev > max_dev { max_dev = dev }
        i = i + 1
    }
    let _ = farr_free(xs)
    return max_dev
}

// ── entrypoint ──────────────────────────────────────────────────────────
println("=== HEXA-0POD OP-72 · d5_sin/d5_cos AGREE + DETERMINISM oracle ===")

let mut pass = 0
let total = 4

let sdev = check_agree_sin()
if sdev <= 1e-9 {
    print("PASS  F-OP72-D5-SIN-AGREE   max|d5_sin − libm sin| = ")
    print(sdev)
    println(" <= 1e-9 over [-3.1 .. 1000] (RoPE + schedule range)")
    pass = pass + 1
} else {
    print("FAIL  F-OP72-D5-SIN-AGREE   max|Δ| = "); print(sdev); println("")
}

let cdev = check_agree_cos()
if cdev <= 1e-9 {
    print("PASS  F-OP72-D5-COS-AGREE   max|d5_cos − libm cos| = ")
    print(cdev)
    println(" <= 1e-9 over [-3.1 .. 1000] (RoPE + schedule range)")
    pass = pass + 1
} else {
    print("FAIL  F-OP72-D5-COS-AGREE   max|Δ| = "); print(cdev); println("")
}

let det = check_det()
if det == 1 {
    println("PASS  F-OP72-D5-DETERMINISM 12 probes × {sin,cos}: d5_*(x) twice → byte-IDENTICAL f64 (max|Δbytes|=0); pure +−×÷ no libm → arch/OS-independent (the F-OP33 schedule + RoPE-table premise)")
    pass = pass + 1
} else {
    println("FAIL  F-OP72-D5-DETERMINISM  d5 trig not byte-reproducible run-to-run")
}

let pdev = check_pythagoras()
if pdev <= 1e-9 {
    print("PASS  F-OP72-D5-PYTHAGORAS  max|sin²+cos²−1| = ")
    print(pdev)
    println(" <= 1e-9 (closed algebraic invariant, libm-independent)")
    pass = pass + 1
} else {
    print("FAIL  F-OP72-D5-PYTHAGORAS  max|Δ| = "); print(pdev); println("")
}

println("")
print("=== OP-72: ")
print(pass)
print("/")
print(total)
println(" PASS ===")
if pass == total {
    println("PASS — d5_sin/d5_cos (flame_math) AGREE with libm sin/cos within RoPE+schedule tolerance AND are byte-deterministic. The 'strict bit-eq path' docstring claim is now LOCKED at the primitive level; closes the d5-trig assumption under F-OP33 (LR schedule) and nn_rope_build_tables_base (RoPE).")
} else {
    println("FAIL — OP-72 d5-trig contract not locked")
}
