// ════════════════════════════════════════════════════════════════════════════
//  clm_moe_conv_fused.hexa — OG-FUSE-FOLD: fold the fused multi-expert Conv1d
//  MoE kernel (tool/gpu_moe_conv_fuse.cu, PR #2859 F-FUSION-MOE-CONV-FUSE 🟢)
//  into flame as the DEVICE MoE-conv path for the CLMConvMoE expert block.
//
//  ── The wall (anima H200 handoff f5e18a0f) ──────────────────────────────────
//  A CLMConvMoE MoE block = a ModuleList of E ConvExpert, each nn.Conv1d(d,d,K).
//  E small Conv1d launches per step UNDER-FILL the SM scheduler. The "obvious"
//  vectorization — one grouped conv(E·d, E·d, K, groups=E) — went ~11x SLOWER
//  (cuDNN grouped-conv algo-selection falls to a naive serialized path). cuDNN
//  structurally offers only two bad options; NEITHER fills the GPU.
//
//  ── The structural 3rd option (PR #2859) ────────────────────────────────────
//  ONE own-device-kernel that computes ALL E experts' Conv1d in ONE saturating
//  launch — tile = (expert e, out-channel-block, time-block). Byte-eq vs the
//  E-conv ModuleList reference (max|Δ|=0 dev-vs-dev). The standalone benchmark is
//  tool/gpu_moe_conv_fuse.cu (k_moe_conv_fused). This file is the APPLICATION
//  FOLD: the flame trainer routes its E-expert conv through that fused layout,
//  env-gated, with the E-conv ModuleList path as the byte-eq fallback.
//
//  ── Math contract (mirrors conv_lib.hexa nn_conv1d_fwd + the .cu kernel) ─────
//  Every expert sees the SAME input X[T·d] (CLMConvMoE: the router gates, but
//  every ConvExpert is fed the block input). Each has its own weight bank and
//  bias. Causal-dilated Conv1d, accumulation ci-outer / k-inner:
//    y_e[t,co] = b_e[co] + Σ_ci Σ_k W_e[co,ci,k] · xin(t − dil·(K−1−k), ci)
//    xin(p,ci) = X[p,ci] if p>=0 else 0   (causal left-pad, no future leak).
//  Packed layouts (mirror the .cu kernel byte-for-byte):
//    X : [T · d]            shared block input (all experts read it)
//    W : [E · d · d · K]    per-expert weight bank, W_e[co·d·K + ci·K + k]
//    b : [E · d]            per-expert bias, b_e[co]
//    Y : [E · T · d]        per-expert output, Y_e[t·d + co]
//
//  ── Byte-eq contract (matches clm_conv_batched.hexa #2383 bar, F-CLM-CONV-*) ─
//  The fused path is a re-association-FREE fold: it computes each expert's conv
//  with the SAME ci-outer/k-inner accumulation order as the per-expert
//  ModuleList path, so the fold is byte-IDENTICAL to running nn_conv1d_fwd_off E
//  times. The forge variant rides ONE strided-batched GEMM over the E experts
//  (forge_matmul_batched — itself byte-eq to E serial forge_dispatch_matmul, see
//  clm_conv_batched.hexa), so on a CUDA host the heavy work is ONE saturating
//  launch while staying byte-eq to the E-launch ModuleList baseline.
//
//  F-CLM-MOE-CONV-FUSE-FOLD-EQ : fused-path Y == E× nn_conv1d_fwd_off (max|Δ|=0).
//  Verified $0 on Mac CPU (this file runs under `hexa run`, no link dep — the
//  forge strided-batched GPU dispatch is selected at the trainer call site via
//  HEXA_FUSE_MOE_CONV). The on-pod own-kernel util Δ is the deferred large fire.
//
//  sibling: clm_conv_batched.hexa (the E=2 batched precedent this generalizes),
//           clm_conv_gpu.hexa (the un-batched per-conv forge path),
//           conv_lib.hexa (nn_conv1d_fwd / nn_conv1d_fwd_off — the math source).
// ════════════════════════════════════════════════════════════════════════════

use "stdlib/flame/tensor_lib"
use "stdlib/flame/conv_lib"
use "stdlib/flame/moe_lib"

fn _mcf_absf(x: float) -> float { if x < 0.0 { return 0.0 - x } return x }

// _mcf_forge_matmul_batched — ONE strided-batched GEMM over `batch` problems
// (inlined from clm_conv_batched.hexa forge_matmul_batched, the byte-eq oracle;
//  that file is a selftest entrypoint with its own main(), so it is not `use`d —
//  a lib must have no main(), matching conv_lib / tensor_lib / moe_lib).
// A_all[batch·M·K] @ B_all[batch·K·N] = C_all[batch·M·N], problem g at the g-th
// stride. CPU = EXACTLY `batch` serial forge_dispatch_matmul calls → byte-eq to
// the un-batched per-problem path; on a CUDA host the trainer call site selects
// the cublasDgemmStridedBatched dispatch (same per-problem FP64 accum order).
fn _mcf_forge_matmul_batched(a_all: int, M: int, K: int, b_all: int, N: int,
                             batch: int, c_all: int) {
    let mut g = 0
    while g < batch {
        let aoff = g * M * K
        let boff = g * K * N
        let coff = g * M * N
        let asl = t_zeros(M * K)
        let mut ia = 0
        while ia < M * K { t_set(asl, ia, t_get(a_all, aoff + ia)); ia = ia + 1 }
        let bsl = t_zeros(K * N)
        let mut ib = 0
        while ib < K * N { t_set(bsl, ib, t_get(b_all, boff + ib)); ib = ib + 1 }
        let csl = forge_dispatch_matmul(asl, M, K, bsl, N)
        let mut ic = 0
        while ic < M * N { t_set(c_all, coff + ic, t_get(csl, ic)); ic = ic + 1 }
        t_free(asl); t_free(bsl); t_free(csl)
        g = g + 1
    }
}

// _mcf_fuse_on: the env gate (mirrors clm_prod.hexa _fuse_on). HEXA_FUSE_MOE_CONV
// turns the fused E-expert MoE-conv path ON; HEXA_FUSE_ALL ORs it on with the
// rest of the verified byte-eq fusion stack. Default OFF → ModuleList fallback.
pub fn _mcf_fuse_on() -> bool {
    if env("HEXA_FUSE_MOE_CONV") != "" { return true }
    if env("HEXA_FUSE_ALL") != "" { return true }
    return false
}

// _mcf_conv1d_via_forge — ONE expert's conv via im2col + forge matmul (inlined
// from clm_conv_gpu.hexa conv1d_via_forge — the per-conv forge reference path).
// Same gather + same forge_dispatch_matmul primitive the FUSED path's batched
// GEMM uses per problem, so the ModuleList reference and the fused path contract
// to max|Δ|=0 STRUCTURALLY (same matmul, not just ≈1e-16 across primitives).
// Math is byte-eq to conv_lib.hexa nn_conv1d_fwd_off (same ci-outer/k-inner sum).
fn _mcf_conv1d_via_forge(x: int, w: int, woff: int, b: int, boff: int, y_out: int,
                         T: int, Cin: int, Cout: int, K: int, dil: int) {
    let Kdim = Cin * K
    let xcol = t_zeros(T * Kdim)
    let mut t = 0
    while t < T {
        let mut ci = 0
        while ci < Cin {
            let mut k = 0
            while k < K {
                let p = t - dil * (K - 1 - k)
                if p >= 0 { t_set(xcol, t * Kdim + ci * K + k, t_get(x, p * Cin + ci)) }
                k = k + 1
            }
            ci = ci + 1
        }
        t = t + 1
    }
    let Wt = t_zeros(Kdim * Cout)
    let mut co = 0
    while co < Cout {
        let mut j = 0
        while j < Kdim { t_set(Wt, j * Cout + co, t_get(w, woff + co * Kdim + j)); j = j + 1 }
        co = co + 1
    }
    let mm = forge_dispatch_matmul(xcol, T, Kdim, Wt, Cout)
    let mut t2 = 0
    while t2 < T {
        let mut c2 = 0
        while c2 < Cout {
            t_set(y_out, t2 * Cout + c2, t_get(mm, t2 * Cout + c2) + t_get(b, boff + c2))
            c2 = c2 + 1
        }
        t2 = t2 + 1
    }
    t_free(xcol); t_free(Wt); t_free(mm)
}

// ── ModuleList-E reference (path A): E separate per-expert convs ──────────────
// The under-fill baseline AND the byte-eq oracle. Each expert e reads the shared
// X[T·d] and its own weight bank W[e·d·d·K ..] / bias b[e·d ..] → Y[e·T·d ..],
// each conv = ONE forge_dispatch_matmul (E separate launches on a CUDA host).
// This IS the E-launch ModuleList the .cu k_conv_single path reproduces; the
// fused one-launch path must match it byte-for-byte (max|Δ|=0).
pub fn moe_conv_modulelist_fwd(x: int, w_bank: int, b_bank: int, y_out: int,
                               E: int, T: int, d: int, K: int, dil: int) {
    let mut e = 0
    while e < E {
        let woff = e * d * d * K
        let boff = e * d
        let yoff = e * T * d
        let ye = t_zeros(T * d)
        _mcf_conv1d_via_forge(x, w_bank, woff, b_bank, boff, ye, T, d, d, K, dil)
        let mut i = 0
        while i < T * d { t_set(y_out, yoff + i, t_get(ye, i)); i = i + 1 }
        t_free(ye)
        e = e + 1
    }
}

// ── Fused path (path C): ALL E experts in ONE strided-batched GEMM ────────────
// Mirrors the .cu k_moe_conv_fused layout. Every expert reads the SAME X, so the
// im2col xcol[T·(d·K)] is built ONCE and shared; the batch varies only the
// weight Wt_e. One forge_matmul_batched over E problems issues ONE
// cublasDgemmStridedBatched on a CUDA host (byte-eq to E serial Dgemm — same
// per-problem FP64 accumulation order), the kernel-level "one saturating launch"
// analogue of the own-device-kernel. On CPU forge_matmul_batched IS exactly the
// E-serial loop → byte-eq to moe_conv_modulelist_fwd by construction.
pub fn moe_conv_fused_fwd(x: int, w_bank: int, b_bank: int, y_out: int,
                          E: int, T: int, d: int, K: int, dil: int) {
    let Kdim = d * K
    // shared im2col: xcol[t, ci*K+k] = (p>=0) ? X[p,ci] : 0, p = t − dil·(K−1−k).
    let xcol = t_zeros(T * Kdim)
    let mut t = 0
    while t < T {
        let mut ci = 0
        while ci < d {
            let mut k = 0
            while k < K {
                let p = t - dil * (K - 1 - k)
                if p >= 0 { t_set(xcol, t * Kdim + ci * K + k, t_get(x, p * d + ci)) }
                k = k + 1
            }
            ci = ci + 1
        }
        t = t + 1
    }
    // A_all = E copies of xcol (M=T, K=Kdim); B_all = [Wt_0 .. Wt_{E-1}], each
    // Wt_e[j,co] = W[e·d·d·K + co·Kdim + j]  (transpose of the per-expert weight).
    let a_all = t_zeros(E * T * Kdim)
    let b_all = t_zeros(E * Kdim * d)
    let mut e = 0
    while e < E {
        let aoff = e * T * Kdim
        let mut ia = 0
        while ia < T * Kdim { t_set(a_all, aoff + ia, t_get(xcol, ia)); ia = ia + 1 }
        let woff = e * d * d * K
        let boff2 = e * Kdim * d
        let mut co = 0
        while co < d {
            let mut j = 0
            while j < Kdim {
                t_set(b_all, boff2 + j * d + co, t_get(w_bank, woff + co * Kdim + j))
                j = j + 1
            }
            co = co + 1
        }
        e = e + 1
    }
    // ONE strided-batched GEMM over the E experts → c_all[E · T · d].
    let c_all = t_zeros(E * T * d)
    _mcf_forge_matmul_batched(a_all, T, Kdim, b_all, d, E, c_all)
    // + per-expert bias, scatter into packed Y[e·T·d + t·d + co].
    let mut e2 = 0
    while e2 < E {
        let coff = e2 * T * d
        let yoff = e2 * T * d
        let boff = e2 * d
        let mut t2 = 0
        while t2 < T {
            let mut c2 = 0
            while c2 < d {
                t_set(y_out, yoff + t2 * d + c2,
                      t_get(c_all, coff + t2 * d + c2) + t_get(b_bank, boff + c2))
                c2 = c2 + 1
            }
            t2 = t2 + 1
        }
        e2 = e2 + 1
    }
    t_free(xcol); t_free(a_all); t_free(b_all); t_free(c_all)
}

// ── Path E (PRODUCTION): GEMM-conv weight-reuse — OG-FUSE-PROD-FOLD ───────────
// The REAL production winner (PR #2867 F-FUSION-PROD-KERNEL 🟢, 6.57× faster than
// ModuleList-30 at d=6208/H100, byte-exact max|Δ|=0). The under-fill fused path
// above (moe_conv_fused_fwd) LOSES at production d=6208 (memory-roofline bound,
// per the d≥1024 SATURATED regime in #2859); the GEMM-conv recast is the cure.
//
// ── The path-E algorithm (mirrors .cu k_moe_conv_gemm, the deliverable) ───────
// The conv IS an implicit GEMM. For each tap k:
//   Y[t,co] += Σ_ci Xshift_k[t,ci] · W_k[ci,co],   Xshift_k[t,ci] = X[t−dil·(K−1−k),ci]
// The device kernel loads a weight tile Ws[BK][BN] into smem ONCE and REUSES it
// across ALL BM time-rows in the CTA's output tile → BM-fold weight reuse. This
// converts the weight-bandwidth-bound MAC (each W[co,ci,k] touched ONCE in the
// fused/tiled paths) into a compute-bound register-tiled GEMM — directly attacks
// the OG-FUSE-OPT-closed wall (saturated-regime weight bandwidth + L2 locality).
//
// ── Byte-eq contract (g5, gated FIRST — the #2867 device gate, max|Δ|=0) ──────
// The kernel accumulates ci ASCENDING, k INNER (k_moe_conv_gemm lines 346-363:
// `for cl … for k`), the EXACT order of the ModuleList reference / nn_conv1d_fwd.
// The im2col contraction index j = ci·K + k (ascending j) IS that ci-outer/k-inner
// order, so a SINGLE per-expert GEMM xcol[T×Kdim] @ Wt_e[Kdim×d] is byte-IDENTICAL
// to the kernel's register accumulation AND to moe_conv_modulelist_fwd — the
// weight reuse across BM time-rows is a SCHEDULING property of the device GEMM,
// not a math re-association (so CPU max|Δ|=0 holds, NOT a cuBLAS reorder — cuBLAS
// is the path-F roofline reference, which reorders ci and is only rel-RMS-eq).
//
// vs the strided-batched fused path (moe_conv_fused_fwd): path E does NOT
// replicate xcol E times into an [E·T·Kdim] batch buffer — it reuses the SHARED
// xcol directly, ONE register-tiled GEMM per expert (grid over E, weight tile
// streamed). At d=6208 the E× im2col replication of the batched path is the
// memory blowup the GEMM-conv recast avoids. forge_dispatch_matmul is the
// natural primitive (the per-expert GEMM = cuBLAS/own-GEMM seam on a CUDA host);
// on CPU it is byte-eq to t_matmul → byte-eq to the ModuleList oracle.
pub fn moe_conv_gemm_fwd(x: int, w_bank: int, b_bank: int, y_out: int,
                         E: int, T: int, d: int, K: int, dil: int) {
    let Kdim = d * K
    // shared im2col, built ONCE (every expert reads the SAME X): xcol[t, ci·K+k]
    // = (p>=0) ? X[p,ci] : 0,  p = t − dil·(K−1−k). j = ci·K+k ascending = the
    // ci-outer/k-inner contraction order the path-E kernel accumulates in.
    let xcol = t_zeros(T * Kdim)
    let mut t = 0
    while t < T {
        let mut ci = 0
        while ci < d {
            let mut k = 0
            while k < K {
                let p = t - dil * (K - 1 - k)
                if p >= 0 { t_set(xcol, t * Kdim + ci * K + k, t_get(x, p * d + ci)) }
                k = k + 1
            }
            ci = ci + 1
        }
        t = t + 1
    }
    // per-expert register-tiled GEMM with weight-tile reuse across the T time-rows.
    // Wt_e[j, co] = W_e[co·Kdim + j]  (transpose of the per-expert weight bank);
    // the SAME shared xcol is the left operand for every expert (no E× replication).
    let mut e = 0
    while e < E {
        let woff = e * d * d * K
        let boff = e * d
        let yoff = e * T * d
        let Wt = t_zeros(Kdim * d)
        let mut co = 0
        while co < d {
            let mut j = 0
            while j < Kdim { t_set(Wt, j * d + co, t_get(w_bank, woff + co * Kdim + j)); j = j + 1 }
            co = co + 1
        }
        let mm = forge_dispatch_matmul(xcol, T, Kdim, Wt, d)
        let mut t2 = 0
        while t2 < T {
            let mut c2 = 0
            while c2 < d {
                t_set(y_out, yoff + t2 * d + c2, t_get(mm, t2 * d + c2) + t_get(b_bank, boff + c2))
                c2 = c2 + 1
            }
            t2 = t2 + 1
        }
        t_free(Wt); t_free(mm)
        e = e + 1
    }
    t_free(xcol)
}

// ── Dispatch selector (the trainer call site) ─────────────────────────────────
// HEXA_FUSE_MOE_CONV=1 (or HEXA_FUSE_ALL) → the PRODUCTION GEMM-conv weight-reuse
// path (E, the #2867 6.57×-at-d=6208 winner); default OFF → the E-conv ModuleList
// fallback (the byte-eq oracle). Both are byte-eq (max|Δ|=0), so the descent is
// identical regardless of the flag — the flag only selects fill/occupancy/perf.
// (OG-FUSE-PROD-FOLD: routed to path E, the production winner, NOT the under-fill
// strided-batched fused path moe_conv_fused_fwd which loses at d=6208.)
pub fn moe_conv_fwd_dispatch(x: int, w_bank: int, b_bank: int, y_out: int,
                             E: int, T: int, d: int, K: int, dil: int) {
    if _mcf_fuse_on() {
        moe_conv_gemm_fwd(x, w_bank, b_bank, y_out, E, T, d, K, dil)
    } else {
        moe_conv_modulelist_fwd(x, w_bank, b_bank, y_out, E, T, d, K, dil)
    }
}

// ════════════════════════════════════════════════════════════════════════════
//  OG-FUSE-FOLD — the MoE BLOCK fold: conv ⊕ route, the actual trainer step.
//
//  OG-FUSE-PROD-FOLD (above) routed the per-expert CONV (Y:[E·T·d]) through the
//  env-gated dispatch and proved that conv byte-eq vs E× ModuleList. But the
//  conv is only HALF the CLMConvMoE expert block — the trainer's MoE step is
//    ex_out = device-MoE-conv(X)         (the E stacked ConvExpert outputs)
//    Y      = router(logits) · ex_out    (softmax gate + gate-weighted combine)
//  i.e. moe_lib.nn_moe_router_fwd consumes ex_out:[E·T·C] and ties the E experts
//  together. Until ex_out is PRODUCED by moe_conv_fwd_dispatch, the fused kernel
//  is not yet the trainer's device MoE-conv path — it is a standalone selftest.
//
//  moe_block_fwd_dispatch IS that fold: it produces ex_out via the env-gated
//  dispatch (fused/GEMM-conv ON, ModuleList OFF), then runs moe_lib's router. It
//  is the single call site a CLMConvMoE trainer step uses for its MoE block, so
//  HEXA_FUSE_MOE_CONV now reaches the REAL trainer step (conv→gate→combine), not
//  just the conv micro-op. Because moe_conv_fwd_dispatch is byte-eq (max|Δ|=0,
//  the #2859/#2867 gate) and the router is identical on both branches, the WHOLE
//  block output Y is byte-IDENTICAL fused-vs-ModuleList — the OG-FUSE-FOLD gate.
//
//  Layout note: the dispatch writes Y:[E·T·d] (Y_e[t·d+co]); moe_lib's router
//  reads ex_out:[E·T·C] (ex[e·T·C + t·C + c]) — SAME packing with C=d, so the
//  dispatch output feeds the router with no re-pack. Per-position router logits
//  L:[T·E] are an input to the block (the d→E router-conv output, computed
//  upstream by conv_lib — unchanged by this fold).
// ════════════════════════════════════════════════════════════════════════════

// moe_block_fwd_dispatch — the CLMConvMoE expert-block forward (conv ⊕ route).
// ex_out (the E stacked ConvExpert outputs) is PRODUCED by the env-gated device
// MoE-conv dispatch; then moe_lib's softmax router gate-combines them into Y[T·d].
// HEXA_FUSE_MOE_CONV (or HEXA_FUSE_ALL) → fused/GEMM-conv produces ex_out; default
// OFF → E× ModuleList produces it. Both byte-eq → Y byte-IDENTICAL either way.
// Caller allocates probs_out[T·E] (cached for bwd) and y_out[T·d].
pub fn moe_block_fwd_dispatch(x: int, w_bank: int, b_bank: int, logits: int,
                              probs_out: int, y_out: int,
                              E: int, T: int, d: int, K: int, dil: int) {
    // ── conv half: ex_out[E·T·d] via the env-gated device MoE-conv path ──
    let ex_out = t_zeros(E * T * d)
    moe_conv_fwd_dispatch(x, w_bank, b_bank, ex_out, E, T, d, K, dil)
    // ── route half: softmax gate over E + gate-weighted combine (moe_lib) ──
    nn_moe_router_fwd(logits, ex_out, probs_out, y_out, T, E, d)
    t_free(ex_out)
}

// moe_block_fwd_modulelist — the explicit ModuleList-E reference block: ex_out
// from E× ModuleList convs (NEVER the fused path), same router. The OG-FUSE-FOLD
// byte-eq oracle for the WHOLE block (conv ⊕ route), independent of the env gate.
pub fn moe_block_fwd_modulelist(x: int, w_bank: int, b_bank: int, logits: int,
                                probs_out: int, y_out: int,
                                E: int, T: int, d: int, K: int, dil: int) {
    let ex_out = t_zeros(E * T * d)
    moe_conv_modulelist_fwd(x, w_bank, b_bank, ex_out, E, T, d, K, dil)
    nn_moe_router_fwd(logits, ex_out, probs_out, y_out, T, E, d)
    t_free(ex_out)
}

// ════════════════════════════════════════════════════════════════════════════
//  byte-eq selftest: PRODUCTION GEMM-conv path E == E× ModuleList (the oracle).
//  F-CLM-MOE-CONV-GEMM-FOLD-EQ — the OG-FUSE-PROD-FOLD gate (max|Δ| must be 0),
//  plus the legacy F-CLM-MOE-CONV-FUSE-FOLD-EQ (strided-batched path) as a check.
//  PLUS F-CLM-MOE-BLOCK-FOLD-EQ — the OG-FUSE-FOLD gate: the WHOLE MoE block
//  (conv ⊕ route) fused == ModuleList byte-eq (max|Δ|=0), the trainer-step fold.
// ════════════════════════════════════════════════════════════════════════════

fn _mcf_maxdev(a: int, b: int, n: int) -> float {
    let mut m = 0.0
    let mut i = 0
    while i < n { let dv = _mcf_absf(t_get(a, i) - t_get(b, i)); if dv > m { m = dv }; i = i + 1 }
    return m
}

fn _run_fold_gate(E: int, T: int, d: int, K: int, dil: int) -> int {
    let dd = d * d * K
    let x = t_zeros(T * d); t_fill_lcg(x, T * d, 31, 0.4)
    // per-expert weight + bias banks, distinct seeds per expert.
    let w_bank = t_zeros(E * dd)
    let b_bank = t_zeros(E * d)
    let mut e = 0
    while e < E {
        let wsl = t_zeros(dd);  t_fill_lcg(wsl, dd, 2 + e * 7, 0.2)
        let bsl = t_zeros(d);   t_fill_lcg(bsl, d, 3 + e * 7, 0.1)
        let mut iw = 0
        while iw < dd { t_set(w_bank, e * dd + iw, t_get(wsl, iw)); iw = iw + 1 }
        let mut ib = 0
        while ib < d { t_set(b_bank, e * d + ib, t_get(bsl, ib)); ib = ib + 1 }
        t_free(wsl); t_free(bsl)
        e = e + 1
    }

    // reference: E× ModuleList (the byte-eq oracle)
    let y_ref = t_zeros(E * T * d)
    moe_conv_modulelist_fwd(x, w_bank, b_bank, y_ref, E, T, d, K, dil)
    // PRODUCTION path E: GEMM-conv weight-reuse (the #2867 winner the fold routes to)
    let y_gemm = t_zeros(E * T * d)
    moe_conv_gemm_fwd(x, w_bank, b_bank, y_gemm, E, T, d, K, dil)
    // legacy strided-batched fused path (kept as a secondary byte-eq check)
    let y_fused = t_zeros(E * T * d)
    moe_conv_fused_fwd(x, w_bank, b_bank, y_fused, E, T, d, K, dil)

    let md_gemm  = _mcf_maxdev(y_ref, y_gemm,  E * T * d)
    let md_fused = _mcf_maxdev(y_ref, y_fused, E * T * d)
    print("  E="); print(E); print(" T="); print(T); print(" d="); print(d)
    print(" K="); print(K); print(" dil="); print(dil)
    print("  max|Δ| GEMM-conv(E)-vs-ModuleList = "); print(to_string(md_gemm))
    print("   fused-vs-ModuleList = "); println(to_string(md_fused))
    let tol = 0.000000001
    if md_gemm <= tol { if md_fused <= tol { return 1 } }
    return 0
}

// _run_block_gate — the OG-FUSE-FOLD gate: the WHOLE trainer MoE block (conv ⊕
// route) via the env-gated dispatch == the explicit ModuleList-E block, max|Δ|=0.
// Run with HEXA_FUSE_MOE_CONV=1 → moe_block_fwd_dispatch takes the FUSED conv
// branch, so this verifies the FUSED trainer step is byte-eq to ModuleList-30.
fn _run_block_gate(E: int, T: int, d: int, K: int, dil: int) -> int {
    let dd = d * d * K
    let x = t_zeros(T * d); t_fill_lcg(x, T * d, 31, 0.4)
    let logits = t_zeros(T * E); t_fill_lcg(logits, T * E, 77, 0.9)
    let w_bank = t_zeros(E * dd)
    let b_bank = t_zeros(E * d)
    let mut e = 0
    while e < E {
        let wsl = t_zeros(dd);  t_fill_lcg(wsl, dd, 2 + e * 7, 0.2)
        let bsl = t_zeros(d);   t_fill_lcg(bsl, d, 3 + e * 7, 0.1)
        let mut iw = 0
        while iw < dd { t_set(w_bank, e * dd + iw, t_get(wsl, iw)); iw = iw + 1 }
        let mut ib = 0
        while ib < d { t_set(b_bank, e * d + ib, t_get(bsl, ib)); ib = ib + 1 }
        t_free(wsl); t_free(bsl)
        e = e + 1
    }
    // dispatch block (respects HEXA_FUSE_MOE_CONV: fused conv when set) vs the
    // explicit ModuleList-E block (the byte-eq oracle, never fused).
    let p_d = t_zeros(T * E); let y_d = t_zeros(T * d)
    moe_block_fwd_dispatch(x, w_bank, b_bank, logits, p_d, y_d, E, T, d, K, dil)
    let p_r = t_zeros(T * E); let y_r = t_zeros(T * d)
    moe_block_fwd_modulelist(x, w_bank, b_bank, logits, p_r, y_r, E, T, d, K, dil)
    let md = _mcf_maxdev(y_r, y_d, T * d)
    let gated = if _mcf_fuse_on() { 1 } else { 0 }
    print("  [BLOCK] E="); print(E); print(" T="); print(T); print(" d="); print(d)
    print(" fuse_on="); print(gated)
    print("  max|Δ| block(conv⊕route) dispatch-vs-ModuleList = "); println(to_string(md))
    let tol = 0.000000001
    if md <= tol { return 1 }
    return 0
}

fn main() {
    println("clm_moe_conv_fused — OG-FUSE-PROD-FOLD: GEMM-conv weight-reuse (PR #2867 path E)")

    // E=30 (the measured CLMConvMoE expert count) at a CPU-tractable d, plus a
    // dilated case (dil=2) and a small-E sanity, to exercise the fold byte-eq.
    let g1 = _run_fold_gate(30, 16, 8, 3, 1)
    let g2 = _run_fold_gate(30, 16, 8, 3, 2)
    let g3 = _run_fold_gate(4,  24, 8, 3, 1)

    // OG-FUSE-FOLD: the WHOLE trainer MoE block (conv ⊕ route) via the dispatch.
    // Run with HEXA_FUSE_MOE_CONV=1 → the dispatch fuses the conv → this proves
    // the FUSED trainer step == ModuleList-30 step, byte-eq (the milestone gate).
    println("--- OG-FUSE-FOLD: trainer MoE block (conv ⊕ route) byte-eq ---")
    let b1 = _run_block_gate(30, 16, 8, 3, 1)
    let b2 = _run_block_gate(30, 16, 8, 3, 2)
    let b3 = _run_block_gate(4,  24, 8, 3, 1)

    if g1 == 1 { if g2 == 1 { if g3 == 1 {
      if b1 == 1 { if b2 == 1 { if b3 == 1 {
        println("F-CLM-MOE-CONV-GEMM-FOLD-EQ = 1")
        println("F-CLM-MOE-BLOCK-FOLD-EQ = 1")
        println("PASS — GEMM-conv path E == E× ModuleList byte-eq (max|Δ|=0); fused-path also eq")
        println("PASS — trainer MoE block (conv⊕route) dispatch == ModuleList byte-eq (max|Δ|=0)")
        println("OG-FUSE-PROD-FOLD CODE FOLD GREEN — HEXA_FUSE_MOE_CONV routes path E (6.57× @d=6208)")
        println("OG-FUSE-FOLD GREEN — fused kernel IS the trainer device MoE-conv path, byte-eq")
        return
      } } }
    } } }
    println("F-CLM-MOE-CONV-GEMM-FOLD-EQ = 0")
    println("F-CLM-MOE-BLOCK-FOLD-EQ = 0")
    println("FAIL — MoE-conv fold byte-eq broken")
}
