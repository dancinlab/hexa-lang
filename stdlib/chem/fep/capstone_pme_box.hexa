// stdlib/chem/fep/capstone_pme_box.hexa — PERIODIC cubic box + PME
// (Ewald) hydration ΔG (QFORGE-BIO round-16).
//
// @version 0.1.0
// @capabilities [pure, randomness]
//
// ── PURPOSE ──────────────────────────────────────────────────────────
// R15 (capstone_full_nonbonded.hexa) widened R14's single C···OW site to
// the FULL solute-solvent nonbonded sum over an EXPLICIT but FINITE,
// NON-PERIODIC TIP3P shell, with electrostatics done as a DIRECT pair sum
// (no long-range Ewald). It honestly reported a *systematic* bias: the
// full sum is more physical (cavity term present) yet ΔG moved the WRONG
// way (−1.115 vs single −0.242, residual vs exp +2.0 GREW to 3.115). R15
// diagnosed the cause: a finite explicit shell + no periodic boundary +
// no PME long-range ⇒ the cavity-FORMATION work term is missing and the
// dispersion is over-counted at the shell edge.
//
// R16 removes the finite/aperiodic reduction. It builds a PERIODIC cubic
// box (R6 solvate_box: methane solute at box centre, TIP3P waters filled
// to bulk density on a lattice, overlap-pruned), and decouples the solute
// nonbonded interaction with:
//   • soft-core LJ under the MINIMUM-IMAGE convention (periodic, R6 pbc
//     min-image) — the periodic box now supplies the cavity-formation work
//     naturally (at λ=1 the solute excludes water → a cavity must form;
//     at λ=0 it does not — the ΔG difference IS the cavity work + dispersion),
//   • PERIODIC PME electrostatics (R10 pme.hexa — Ewald real+recip+self,
//     fft3-accelerated reciprocal sum) instead of a direct charge pair sum.
//     The alchemical electrostatic contribution is the DIFFERENCE of two PME
//     energies: the full box vs the box with the solute charges scaled by λ.
//
// ── WHAT CHANGED vs R15 (honest, d6/@L5) ─────────────────────────────
//   R15 finite shell             →  R16 PERIODIC cubic box
//   explicit Fibonacci shell      →  R6 solvate_box lattice at bulk ρ
//   no periodic boundary          →  minimum-image (cubic L) for soft-core LJ
//   direct Coulomb pair sum        →  PME Ewald periodic (real+recip+self)
//   cavity-FORMATION work ABSENT  →  present (periodic exclusion at fixed ρ)
//   long-range electrostatics CUT  →  full Ewald lattice sum
// The ε/σ/q are STILL the real GAFF/TIP3P literature values from the
// perception front-end — R16 changes the BOUNDARY + the electrostatics
// summation, not the force field.
//
// ── d3 / d4 compliance ───────────────────────────────────────────────
// d3: NO new physics. The soft-core LJ is the R3 Beutler closed form (the
//     IDENTICAL fast form R15 cross-checked against the autograd tape), the
//     min-image is R6 pbc, the water box is R6 solvate_box / tip3p_molecule,
//     the periodic electrostatics are R10 pme_total_energy (which itself
//     reuses ewald.hexa real/self verbatim), the sampling is run_abfe (R5
//     HREX + R4 MBAR). This file COMPOSES sealed bricks; it re-derives none.
// d4: solute (atoms+coords+types), box edge L, target density, λ ladder,
//     PME grid/order/tolerance, sweeps and step are GENERIC arguments. NO
//     molecule name is branched on; swap the solute and the SAME path
//     yields its periodic-box ΔG.
//
// ── Public surface ───────────────────────────────────────────────────
//   pub fn build_periodic_box(ff, geo_coords, L, density, overlap_cut)
//        -> dict { solute_n, water_atoms, L, solute_charges[], solute_eps[],
//                  solute_sigma[] }  — methane centred at L/2, waters filled.
//   pub fn box_lj_softcore_energy(sol_coords, box, lam) -> float
//        Σ_{i∈solute} Σ_{j∈water-O} U_sc^LJ(min-image r_ij, λ)  (kcal/mol).
//   pub fn box_pme_elec_lambda(sol_coords, box, lam) -> float
//        λ-coupled periodic electrostatic CONTRIBUTION of the solute:
//        E_pme(waters + λ·q_solute) − E_pme(waters only)   (kcal/mol).
//   pub fn box_decouple_energy(sol_coords, box, lam) -> float
//        the FULL periodic alchemical energy = LJ soft-core + PME elec.
//   pub fn run_hydration_pme_box(ff, opts) -> dict
//        the end-to-end periodic-box ΔG_hyd via run_abfe. Returns the
//        run_abfe bundle + { dG_hyd_kcal, dG_ti_kcal, ref_kcal, abs_dev,
//        n_waters, L, density, pme_grid, pme_order }.

use "stdlib/math/logsumexp"
use "stdlib/chem/md/ewald"
use "stdlib/chem/md/pme"
use "stdlib/chem/fep/softcore"
use "stdlib/chem/fep/mbar"
use "stdlib/chem/fep/hrex"
use "stdlib/chem/fep/abfe_demo"
use "stdlib/chem/ff/amber"
use "stdlib/chem/solvate/tip3p"
use "stdlib/chem/fep/capstone_methane_hyd"

// methane experimental hydration free energy ≈ +2.0 kcal/mol (FreeSolv).
let PMEBOX_HYD_REF_KCAL = 2.0
let PMEBOX_KE = 332.0637          // Coulomb constant in kcal·Å/(mol·e²)

fn _absf(x: float) -> float { if x < 0.0 { return 0.0 - x } else { return x } }

// minimum-image of a single-axis displacement (cubic box edge L).
fn _mim(d: float, L: float) -> float {
    if L <= 0.0 { return d }
    let q = d / L + 0.5
    return d - L * to_float(floor(q))
}

// ── build the periodic cubic box (R6 solvate_box) ────────────────────
// The methane solute is placed at the box CENTRE (L/2) and the rest of the
// cubic box is filled with TIP3P waters at `density` g/cm³ on the generic
// R6 lattice, overlap-pruned against the solute. Returns the water atoms as
// EwaldCharge-compatible records plus the solute's real per-atom ε/σ/q (from
// the perception front-end). The solute heavy atom (c3) is the only solute
// LJ site that matters for dispersion, but ALL solute charges enter PME.
// d4: L / density / overlap_cut are arguments; no molecule-name branch.
pub fn build_periodic_box(ff: dict, geo_coords: array, L: float,
                          density: float, overlap_cut: float) -> dict {
    let db = gaff_tip3p_types()
    let types = ff["types"]
    let charges = ff["charges"]
    let epses   = ff["eps"]
    let sigmas  = ff["sigma"]
    let ns = geo_coords.len()
    let halfL = 0.5 * L

    // solute SolvAtom list (centred at L/2) for the R6 overlap test, plus
    // parallel real-FF arrays kept for the alchemical energy.
    let mut solute = []
    let mut sol_q   = []
    let mut sol_eps = []
    let mut sol_sig = []
    let mut i = 0
    while i < ns {
        let c = geo_coords[i]
        let cx = c["x"] + halfL
        let cy = c["y"] + halfL
        let cz = c["z"] + halfL
        let a = SolvAtom{
            x: cx, y: cy, z: cz,
            q: charges[i], eps: epses[i], sigma: sigmas[i],
            mass: 1.0, is_o: false,
        }
        solute = solute.push(a)
        sol_q.push(charges[i])
        sol_eps.push(epses[i])
        sol_sig.push(sigmas[i])
        i = i + 1
    }

    // R6 generic solvation fill (returns [solute..., water...]).
    let allatoms = solvate_box(solute, L, density, overlap_cut)

    // split out the waters as EwaldCharge records (PME input) + keep the OW
    // LJ sites for the soft-core dispersion sum.
    let mut water_e = []          // EwaldCharge[] for PME (all water atoms)
    let mut ow_coords = []        // OW positions (LJ sites) {x,y,z,eps,sigma}
    let mut k = ns
    while k < allatoms.len() {
        let w = allatoms[k]
        let ec = EwaldCharge{ x: w.x, y: w.y, z: w.z, q: w.q }
        water_e = water_e.push(ec)
        if w.is_o {
            let o = #{}
            o["x"] = w.x
            o["y"] = w.y
            o["z"] = w.z
            o["eps"]   = w.eps
            o["sigma"] = w.sigma
            ow_coords.push(o)
        }
        k = k + 1
    }

    let out = #{}
    out["solute_n"]       = ns
    out["L"]              = L
    out["water_e"]        = water_e
    out["ow_coords"]      = ow_coords
    out["solute_q"]       = sol_q
    out["solute_eps"]     = sol_eps
    out["solute_sigma"]   = sol_sig
    out["n_waters"]       = box_water_count(allatoms)
    out["density_real"]   = box_density(allatoms, L)
    return out
}

// ── periodic soft-core LJ: solute × water-O, minimum-image ───────────
// Σ_{i∈solute} Σ_{j∈OW} U_sc^LJ(r_ij, λ) with r_ij the minimum-image
// distance (cubic box). HW carries no LJ (TIP3P convention) so only OW
// sites enter the dispersion sum. ε/σ are LB-combined (amber.hexa) per
// solute atom × OW. This is the IDENTICAL Beutler soft-core fast form R15
// cross-checked against the R3 autograd tape (d3 — same physics).
//   U_sc^LJ = 4ε·λ·[D⁻² − D⁻¹],  D = α_lj·(1−λ)² + (r/σ)⁶
pub fn box_lj_softcore_energy(sol_coords: array, box: dict, lam: float) -> float {
    let db = gaff_tip3p_types()
    let ow = box["ow_coords"]
    let sol_eps = box["solute_eps"]
    let sol_sig = box["solute_sigma"]
    let L = box["L"]
    let ns = sol_coords.len()
    let now = ow.len()

    let alpha_lj = 0.5
    let oml = 1.0 - lam
    let oml2 = oml * oml

    let mut u = 0.0
    let mut i = 0
    while i < ns {
        let eps_s = sol_eps[i]
        let sig_s = sol_sig[i]
        if eps_s != 0.0 {
            let pi = sol_coords[i]
            let pix = pi["x"]
            let piy = pi["y"]
            let piz = pi["z"]
            let mut j = 0
            while j < now {
                let oj = ow[j]
                let eps_w = oj["eps"]
                let sig_w = oj["sigma"]
                let eps_ij = lb_epsilon(eps_s, eps_w)     // √(ε_s·ε_w)
                let sig_ij = lb_sigma(sig_s, sig_w)       // ½(σ_s+σ_w)
                let dx = _mim(pix - oj["x"], L)
                let dy = _mim(piy - oj["y"], L)
                let dz = _mim(piz - oj["z"], L)
                let r2 = dx * dx + dy * dy + dz * dz
                let s2 = sig_ij * sig_ij
                let s6 = s2 * s2 * s2
                let r6 = r2 * r2 * r2
                let r_over_sigma6 = r6 / s6
                let d = alpha_lj * oml2 + r_over_sigma6
                let d_inv1 = 1.0 / d
                let d_inv2 = d_inv1 * d_inv1
                u = u + 4.0 * eps_ij * lam * (d_inv2 - d_inv1)
                j = j + 1
            }
        }
        i = i + 1
    }
    return u
}

// ── periodic PME electrostatic CONTRIBUTION of the solute (λ-coupled) ─
// The alchemical electrostatic energy of the solute in the periodic box is
//   ΔE_elec(λ) = E_pme(waters + λ·q_solute) − E_pme(waters alone)
// i.e. the FULL periodic Ewald (real+recip+self, R10 pme_total_energy) of
// the box with the solute charges linearly scaled by λ, minus the same PME
// energy of the bare water box (the solute-independent solvent self-energy,
// subtracted so only the SOLUTE's electrostatic coupling remains). At λ=0
// the contribution is exactly 0 (charges off); at λ=1 it is the full
// periodic solute-solvent + solute-solute electrostatics. d3: pme.hexa does
// the lattice sum verbatim; this only assembles the alchemical difference.
//
// (For neutral methane the per-atom partials nearly cancel, so this term is
// small but PHYSICALLY periodic — it is the long-range piece R15 omitted.)
pub fn box_pme_elec_lambda(sol_coords: array, box: dict, lam: float,
                           tol: float, grid: int, order: int) -> float {
    let water_e = box["water_e"]
    let sol_q   = box["solute_q"]
    let L = box["L"]
    let ns = sol_coords.len()

    // bare-water PME energy (solute-independent baseline).
    let e_water = pme_total_energy(water_e, L, tol, grid, order)

    // box with the solute charges scaled by λ, appended to the waters.
    let mut full = []
    let mut w = 0
    while w < water_e.len() {
        full = full.push(water_e[w])
        w = w + 1
    }
    let mut i = 0
    while i < ns {
        let p = sol_coords[i]
        let ec = EwaldCharge{ x: p["x"], y: p["y"], z: p["z"], q: lam * sol_q[i] }
        full = full.push(ec)
        i = i + 1
    }
    let e_full = pme_total_energy(full, L, tol, grid, order)
    return e_full - e_water
}

// ── full periodic alchemical energy = LJ soft-core + PME electrostatics ─
// The decoupling energy of the solute in the periodic box. include_elec
// toggles the PME term (LJ-only by default = clean hydrophobic dispersion +
// cavity, mirroring R14/R15's default neutral-solute convention). d4.
pub fn box_decouple_energy(sol_coords: array, box: dict, lam: float,
                           include_elec: bool, tol: float,
                           grid: int, order: int) -> float {
    let mut u = box_lj_softcore_energy(sol_coords, box, lam)
    if include_elec {
        u = u + box_pme_elec_lambda(sol_coords, box, lam, tol, grid, order)
    }
    return u
}

// ── numerical dU/dλ (central difference) for the independent TI anchor ─
// The PME term is not closed-form-differentiable here (it is an Ewald lattice
// sum), so the TI cross-check uses a central finite difference of the full
// periodic energy. d6: honest — TI here is a numerical-derivative anchor, not
// an autograd one; the selftest reports the MBAR↔TI band it produces.
pub fn box_decouple_dudlam(sol_coords: array, box: dict, lam: float,
                           include_elec: bool, tol: float,
                           grid: int, order: int) -> float {
    let h = 1.0e-4
    let mut lp = lam + h
    let mut lm = lam - h
    if lp > 1.0 { lp = 1.0 }
    if lm < 0.0 { lm = 0.0 }
    let up = box_decouple_energy(sol_coords, box, lp, include_elec, tol, grid, order)
    let um = box_decouple_energy(sol_coords, box, lm, include_elec, tol, grid, order)
    let span = lp - lm
    if span <= 0.0 { return 0.0 }
    return (up - um) / span
}

// ── config ↔ solute-coords flattening (generic; config = [Ns*3] floats) ─
fn _flatten_coords(coords: array) -> array {
    let mut out = []
    let mut i = 0
    while i < coords.len() {
        let c = coords[i]
        out.push(c["x"])
        out.push(c["y"])
        out.push(c["z"])
        i = i + 1
    }
    return out
}
fn _unflatten_coords(flat: array, ns: int) -> array {
    let mut out = []
    let mut i = 0
    while i < ns {
        let c = #{}
        c["x"] = flat[i * 3 + 0]
        c["y"] = flat[i * 3 + 1]
        c["z"] = flat[i * 3 + 2]
        out.push(c)
        i = i + 1
    }
    return out
}

// ── reduced-potential factory: ufn(config, lam) = β·U_box ────────────
// config = flattened solute coords [Ns*3] (the solute translates rigidly in
// the periodic box; waters are fixed — the decoupling DOF is the solute-
// solvent relative configuration). β folds kcal/mol → reduced potential.
fn _box_ufn_factory(box, ns: int, beta: float, include_elec: bool,
                    tol: float, grid: int, order: int) {
    return fn(config, lam) {
        let sc = _unflatten_coords(config, ns)
        return beta * box_decouple_energy(sc, box, lam, include_elec, tol, grid, order)
    }
}
fn _box_dudl_factory(box, ns: int, beta: float, include_elec: bool,
                     tol: float, grid: int, order: int) {
    return fn(config, lam) {
        let sc = _unflatten_coords(config, ns)
        return beta * box_decouple_dudlam(sc, box, lam, include_elec, tol, grid, order)
    }
}

// ── MC propagator: rigid solute translation inside the periodic box ──
// A rigid-body translation of the WHOLE solute preserves the methane
// internal geometry exactly (intramolecular terms excluded from the
// alchemical sum), so the move samples only the solute–solvent relative
// configuration in the periodic box. Metropolis on ΔU via hrex_accept_prob;
// threads the HREX LCG. (reuse of the R15 / abfe_demo propagator structure.)
fn _b_lcg(state: int) -> array {
    let nx = (1664525 * state + 1013904223) & 0xFFFFFFFF
    return [nx, to_float(nx) / 4294967296.0]
}
fn _b_gauss(state: int) -> array {
    let a = _b_lcg(state)
    let b = _b_lcg(to_int(a[0]))
    let mut u1 = a[1]
    if u1 < 1.0e-12 { u1 = 1.0e-12 }
    let z = sqrt(0.0 - 2.0 * ln(u1)) * cos(6.283185307179586 * b[1])
    return [b[0], z]
}
fn _box_prop_factory(ufn, step: float, ns: int) {
    return fn(config, lam, lcg) {
        let g1 = _b_gauss(lcg)
        let s1 = to_int(g1[0])
        let g2 = _b_gauss(s1)
        let s2 = to_int(g2[0])
        let g3 = _b_gauss(s2)
        let s3 = to_int(g3[0])
        let dx = step * g1[1]
        let dy = step * g2[1]
        let dz = step * g3[1]
        let mut trial = []
        let mut i = 0
        while i < ns {
            trial.push(config[i * 3 + 0] + dx)
            trial.push(config[i * 3 + 1] + dy)
            trial.push(config[i * 3 + 2] + dz)
            i = i + 1
        }
        let du = ufn(trial, lam) - ufn(config, lam)
        let acc = _b_lcg(s3)
        let s4 = to_int(acc[0])
        if acc[1] < hrex_accept_prob(du) {
            return [trial, s4]
        }
        return [config, s4]
    }
}

fn _optf(opts, key: string, dflt) {
    if opts.contains_key(key) { return opts[key] }
    return dflt
}

// ── run_hydration_pme_box: end-to-end periodic-box ΔG_hyd ────────────
// ff   : perceive_real_ff output (real per-atom params + perceived types).
// opts : generic dict — L, density, overlap_cut, include_elec, pme_tol,
//        pme_grid, pme_order, ladder, n_sweeps, swap_period,
//        md_steps_per_sweep, seed, mbar_tol, mbar_max_iter, T, step,
//        geo_coords. Every knob is data (d4).
// Decouples the periodic methane···(water box) soft-core LJ + PME elec block
// λ:1→0 through HREX + MBAR (run_abfe). ΔG_hyd reported vs +2.0 exp anchor.
pub fn run_hydration_pme_box(ff: dict, opts) -> dict {
    let L          = _optf(opts, "L", 12.0)
    let density    = _optf(opts, "density", 0.997)
    let overlap    = _optf(opts, "overlap_cut", 2.6)
    let include_e  = _optf(opts, "include_elec", false)
    let pme_tol    = _optf(opts, "pme_tol", 1.0e-5)
    let pme_grid   = _optf(opts, "pme_grid", 16)
    let pme_order  = _optf(opts, "pme_order", 4)

    let mut geo = _optf(opts, "geo_coords", [])
    if geo.len() == 0 {
        if ff.contains_key("geo_coords") { geo = ff["geo_coords"] }
    }
    let ns = geo.len()
    let halfL = 0.5 * L

    let box = build_periodic_box(ff, geo, L, density, overlap)

    // solute starting coords = geometry shifted to the box centre (matches
    // build_periodic_box). The config the sampler threads is these coords.
    let mut geo_c = []
    let mut gi = 0
    while gi < ns {
        let c = geo[gi]
        let cc = #{}
        cc["x"] = c["x"] + halfL
        cc["y"] = c["y"] + halfL
        cc["z"] = c["z"] + halfL
        geo_c.push(cc)
        gi = gi + 1
    }
    let flat0 = _flatten_coords(geo_c)

    let T    = _optf(opts, "T", 298.15)
    let kT   = 0.0019872041 * T
    let beta = 1.0 / kT

    let ufn  = _box_ufn_factory(box, ns, beta, include_e, pme_tol, pme_grid, pme_order)
    let dudl = _box_dudl_factory(box, ns, beta, include_e, pme_tol, pme_grid, pme_order)
    let step = _optf(opts, "step", 0.12)
    let prop = _box_prop_factory(ufn, step, ns)

    // λ ladder 1→0 (coupled → decoupled): ΔG = G(off) − G(on).
    let ladder = _optf(opts, "ladder", [1.0, 0.8, 0.6, 0.4, 0.2, 0.0])
    let K = ladder.len()
    let mut configs0 = []
    let mut i = 0
    while i < K { configs0.push(flat0) i = i + 1 }

    let cfg = abfe_config(ladder,
                          _optf(opts, "n_sweeps", 200),
                          _optf(opts, "swap_period", 1),
                          _optf(opts, "md_steps_per_sweep", 2),
                          0.0,
                          kT,
                          _optf(opts, "seed", 90909),
                          _optf(opts, "mbar_tol", 1.0e-12),
                          _optf(opts, "mbar_max_iter", 800))
    let res = run_abfe(ufn, prop, configs0, cfg)
    let dG_hyd = res["dG"]

    // independent TI cross-check over the real samples (numerical dU/dλ).
    let sbr = res["samples_by_rung"]
    let mut dudl_nodes = []
    let mut rb = 0
    while rb < K {
        let lst = sbr[rb]
        let mut s = 0.0
        let mut c = 0
        while c < lst.len() {
            s = s + dudl(lst[c], ladder[rb])
            c = c + 1
        }
        let mut avg = 0.0
        if lst.len() > 0 { avg = s / to_float(lst.len()) }
        dudl_nodes.push(avg)
        rb = rb + 1
    }
    let mut dG_ti_kT = 0.0
    let mut it = 0
    while it < K - 1 {
        let l0 = ladder[it]
        let l1 = ladder[it + 1]
        dG_ti_kT = dG_ti_kT + 0.5 * (dudl_nodes[it + 1] + dudl_nodes[it]) * (l1 - l0)
        it = it + 1
    }
    let dG_ti = dG_ti_kT * kT

    let out = #{}
    out["dG"]            = res["dG"]
    out["dG_kT"]         = res["dG_kT"]
    out["dG_hyd_kcal"]   = dG_hyd
    out["dG_ti_kcal"]    = dG_ti
    out["ref_kcal"]      = PMEBOX_HYD_REF_KCAL
    out["abs_dev"]       = _absf(dG_hyd - PMEBOX_HYD_REF_KCAL)
    out["kT_kcal"]       = kT
    out["converged"]     = res["converged"]
    out["acc_rate"]      = res["acc_rate"]
    out["round_trips"]   = res["round_trips"]
    out["K"]             = res["K"]
    out["Ntot"]          = res["Ntot"]
    out["overlap"]       = res["overlap"]
    out["partial_dG"]    = res["partial_dG"]
    out["u_kn"]          = res["u_kn"]
    out["N_k"]           = res["N_k"]
    out["n_waters"]      = box["n_waters"]
    out["L"]             = L
    out["density_real"]  = box["density_real"]
    out["pme_grid"]      = pme_grid
    out["pme_order"]     = pme_order
    out["include_elec"]  = include_e
    out["samples_by_rung"] = res["samples_by_rung"]
    return out
}

println("[capstone_pme_box loaded]")

// ── HONEST SCOPE (d6/@L5) ─────────────────────────────────────────────
