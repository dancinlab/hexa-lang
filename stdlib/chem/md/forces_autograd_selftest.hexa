// stdlib/chem/md/forces_autograd_selftest.hexa — g5 seal for autograd forces.
//
// QFORGE-BIO round-2, first verify-able brick:
//   LJ + Coulomb single-pair force, autograd reverse-mode
//     == analytic (lj_pair_force + Coulomb hand-derivative)
//     == central finite-difference
//   all within |Δ| < 1e-6.
//
// Run:
//   hexa run stdlib/chem/md/forces_autograd_selftest.hexa
//
// Checks:
//   (a) autograd F  vs  analytic F (LJ analytic + Coulomb analytic)   |Δ|<1e-6
//   (b) autograd F  vs  central FD F  ( −(U(x+h)−U(x−h))/2h )          |Δ|<1e-6
//   (c) Newton's 3rd law: F on p1 = −F on p2 (componentwise)          |Δ|<1e-9
//   (d) r→∞ ⇒ F→0. NOTE: Coulomb is long-range (~r⁻², the very reason
//       Ewald/PME exist) so it only vanishes at VERY large r. We assert
//       two honest things: (d1) at r=1e6 the total force < 1e-6, and
//       (d2) at r=500 the autograd force EQUALS the analytic Coulomb tail
//       ke·q1·q2/r² (LJ already ~r⁻⁷≈0), proving autograd tracks the
//       long-range tail correctly rather than spuriously zeroing it.

use "stdlib/tensor/mod"
use "stdlib/tensor/shape"
use "stdlib/tensor/ops"
use "stdlib/autograd"
use "stdlib/chem/md/lennard_jones"
use "stdlib/chem/md/forces_autograd"

let mut pass_count = 0
let mut total = 0
let mut first_fail = ""

fn abs_f(x: float) -> float { if x < 0.0 { return 0.0 - x } else { return x } }

fn check(name: string, cond: bool, detail: string) {
    total = total + 1
    if cond {
        pass_count = pass_count + 1
        println("  ok : " + name + " " + detail)
    } else {
        if first_fail == "" { first_fail = name }
        println("  FAIL " + name + " " + detail)
    }
}

// ── analytic reference forces (independent of forces_autograd.hexa) ──

// Coulomb analytic force on p1 due to p2:
//   U = ke q1 q2 / r ,  F = −∇U = ke q1 q2 / r³ · (r_p1 − r_p2)
fn coulomb_force_analytic(coords6: array, q1: float, q2: float, ke: float) -> array {
    let dx = coords6[0] - coords6[3]
    let dy = coords6[1] - coords6[4]
    let dz = coords6[2] - coords6[5]
    let r2 = dx*dx + dy*dy + dz*dz
    let r  = sqrt(r2)
    let r3 = r2 * r
    let c  = ke * q1 * q2 / r3
    // force on p1 = +c·(r_p1−r_p2); on p2 = −that.
    return [c*dx, c*dy, c*dz, 0.0 - c*dx, 0.0 - c*dy, 0.0 - c*dz]
}

// Full analytic F (length-6): LJ (lj_pair_force, both bodies) + Coulomb.
fn analytic_force6(coords6: array, eps: float, sigma: float, q1: float, q2: float, ke: float) -> array {
    let p1 = MdParticle{ x: coords6[0], y: coords6[1], z: coords6[2],
                         vx:0.0, vy:0.0, vz:0.0, mass:1.0, fx:0.0, fy:0.0, fz:0.0 }
    let p2 = MdParticle{ x: coords6[3], y: coords6[4], z: coords6[5],
                         vx:0.0, vy:0.0, vz:0.0, mass:1.0, fx:0.0, fy:0.0, fz:0.0 }
    let flj = lj_pair_force(p1, p2, eps, sigma)        // force on p1
    let fcb = coulomb_force_analytic(coords6, q1, q2, ke)
    // p1 = LJ(p1) + Coulomb(p1) ; p2 = −LJ(p1) + Coulomb(p2)
    return [
        flj[0] + fcb[0], flj[1] + fcb[1], flj[2] + fcb[2],
        (0.0 - flj[0]) + fcb[3], (0.0 - flj[1]) + fcb[4], (0.0 - flj[2]) + fcb[5]
    ]
}

// ── central finite-difference force from the SAME energy fn ──────────
// F_i = −∂U/∂x_i ≈ −(U(x_i+h) − U(x_i−h)) / 2h
fn fd_force6(coords6: array, eps: float, sigma: float, q1: float, q2: float, ke: float, h: float) -> array {
    let mut f = []
    let mut i = 0
    while i < 6 {
        let mut cp = []
        let mut cm = []
        let mut k = 0
        while k < 6 {
            cp.push(coords6[k])
            cm.push(coords6[k])
            k = k + 1
        }
        cp[i] = coords6[i] + h
        cm[i] = coords6[i] - h
        let up = pair_energy_value(cp, eps, sigma, q1, q2, ke)
        let um = pair_energy_value(cm, eps, sigma, q1, q2, ke)
        f.push(0.0 - (up - um) / (2.0 * h))
        i = i + 1
    }
    return f
}

// componentwise max abs diff between two length-6 arrays.
fn max_abs_diff6(a: array, b: array) -> float {
    let mut w = 0.0
    let mut i = 0
    while i < 6 {
        let d = abs_f(a[i] - b[i])
        if d > w { w = d }
        i = i + 1
    }
    return w
}

fn fmt6(a: array) -> string {
    return "[" + to_string(a[0]) + "," + to_string(a[1]) + "," + to_string(a[2])
         + "," + to_string(a[3]) + "," + to_string(a[4]) + "," + to_string(a[5]) + "]"
}

// ── fixtures ─────────────────────────────────────────────────────────
let eps   = 0.65          // kJ/mol-ish, arbitrary but non-trivial
let sigma = 3.15          // Å (water O-O-ish)
let q1    =  0.84         // e
let q2    = -0.42         // e
let ke    = 138.9354859   // kJ·mol⁻¹·nm·e⁻²  (Coulomb const, MD units) — any nonzero
// Off-axis geometry so all 3 components are nonzero & exercised.
let coords = [0.0, 0.0, 0.0,  2.6, 1.3, 0.9]

println("── forces_autograd selftest (LJ+Coulomb single pair) ──")
println("  fixture: eps=" + to_string(eps) + " sigma=" + to_string(sigma)
        + " q1=" + to_string(q1) + " q2=" + to_string(q2) + " ke=" + to_string(ke))

let f_ag = pair_force_autograd(coords, eps, sigma, q1, q2, ke)
let f_an = analytic_force6(coords, eps, sigma, q1, q2, ke)
let h = 1.0e-5
let f_fd = fd_force6(coords, eps, sigma, q1, q2, ke, h)

println("  F_autograd = " + fmt6(f_ag))
println("  F_analytic = " + fmt6(f_an))
println("  F_finitedf = " + fmt6(f_fd))

// ── (a) autograd vs analytic ─────────────────────────────────────────
let d_ag_an = max_abs_diff6(f_ag, f_an)
check("(a) autograd == analytic", d_ag_an < 1.0e-6,
      "max|Δ|=" + to_string(d_ag_an))

// ── (b) autograd vs central FD ───────────────────────────────────────
let d_ag_fd = max_abs_diff6(f_ag, f_fd)
check("(b) autograd == finite-diff", d_ag_fd < 1.0e-6,
      "max|Δ|=" + to_string(d_ag_fd))

// ── (c) Newton's 3rd law: F(p1) = −F(p2) ─────────────────────────────
// F = [F1x,F1y,F1z, F2x,F2y,F2z]; require F1 = −F2 componentwise.
let n3x = abs_f(f_ag[0] + f_ag[3])
let n3y = abs_f(f_ag[1] + f_ag[4])
let n3z = abs_f(f_ag[2] + f_ag[5])
let n3 = if n3x > n3y { if n3x > n3z { n3x } else { n3z } } else { if n3y > n3z { n3y } else { n3z } }
check("(c) Newton 3rd F_i=−F_j", n3 < 1.0e-9,
      "max|F1+F2|=" + to_string(n3))

// ── (d1) r→∞ ⇒ total F→0 (at r=1e6 even the Coulomb tail < 1e-6) ──────
let coords_vfar = [0.0, 0.0, 0.0,  1.0e6, 0.0, 0.0]
let f_vfar = pair_force_autograd(coords_vfar, eps, sigma, q1, q2, ke)
let mut fmag = 0.0
let mut i = 0
while i < 6 {
    let a = abs_f(f_vfar[i])
    if a > fmag { fmag = a }
    i = i + 1
}
check("(d1) r→∞ ⇒ F→0 (r=1e6)", fmag < 1.0e-6,
      "max|F(r=1e6)|=" + to_string(fmag))

// ── (d2) at r=500 LJ≈0, autograd F equals analytic Coulomb tail ──────
// Proves autograd does NOT spuriously zero the long-range part: the
// surviving force is exactly the Coulomb tail (ke q1 q2 / r²) along x.
let coords_far = [0.0, 0.0, 0.0,  500.0, 0.0, 0.0]
let f_far = pair_force_autograd(coords_far, eps, sigma, q1, q2, ke)
let f_far_an = analytic_force6(coords_far, eps, sigma, q1, q2, ke)
let d_far = max_abs_diff6(f_far, f_far_an)
let coulomb_x = ke * q1 * q2 / (500.0 * 500.0)   // expected surviving Fx on p1
check("(d2) r=500 Coulomb tail == analytic", d_far < 1.0e-6,
      "max|Δ|=" + to_string(d_far) + " (Fx≈" + to_string(coulomb_x) + ", LJ≈0)")

// ── verdict ──────────────────────────────────────────────────────────
println("")
if pass_count == total {
    println("PASS: forces_autograd " + to_string(pass_count) + "/" + to_string(total))
    exit(0)
} else {
    println("FAIL: forces_autograd first=" + first_fail
            + " (" + to_string(pass_count) + "/" + to_string(total) + ")")
    exit(1)
}
