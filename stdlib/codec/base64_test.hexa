// HEXA Standard Library — codec/base64 self-test (@ci_gate).
// Golden vectors = RFC 4648 §10 (authoritative; identical to CPython
// `base64.b64encode`). Locks the encode∘decode round-trip across every
// length-mod-3 remainder — the regression OP-75 fixed, where the decoder
// dropped the trailing partial group for any non-multiple-of-3 input.
// @sentinel(__HEXA_CODEC_BASE64__ <PASS|FAIL> N/N)

use "stdlib/codec/base64"

let SENT_T = "__HEXA_CODEC_BASE64__"

fn _bytes(s: string) -> [int] {
    let n = byte_len(s)
    let mut out: [int] = []
    let mut i = 0
    while i < n { out = out + [s.byte_at(i)]; i = i + 1 }
    return out
}

fn _eq(a: [int], b: [int]) -> int {
    if len(a) != len(b) { return 0 }
    let mut i = 0
    while i < len(a) { if (a[i] & 0xFF) != (b[i] & 0xFF) { return 0 }; i = i + 1 }
    return 1
}

fn main() {
    // RFC 4648 §10 vectors — each plaintext maps to a fixed base64 string.
    // Lengths 0..6 cover remainder 0,1,2 mod 3 and partial trailing groups.
    let plains = ["", "f", "fo", "foo", "foob", "fooba", "foobar"]
    let b64s   = ["", "Zg==", "Zm8=", "Zm9v", "Zm9vYg==", "Zm9vYmE=", "Zm9vYmFy"]

    let mut pass = 0
    let mut total = 0

    let mut i = 0
    while i < len(plains) {
        // encode matches the golden vector
        total = total + 1
        if codec_base64_encode_str(plains[i]) == b64s[i] { pass = pass + 1 } else { eprintln("FAIL encode " + plains[i]) }

        // decode of the golden vector matches the plaintext bytes
        total = total + 1
        if _eq(codec_base64_decode(b64s[i]), _bytes(plains[i])) == 1 { pass = pass + 1 } else { eprintln("FAIL decode " + b64s[i]) }

        // round-trip identity: decode(encode(p)) == p  (the OP-75 lock)
        total = total + 1
        if codec_base64_decode_str(codec_base64_encode_str(plains[i])) == plains[i] { pass = pass + 1 } else { eprintln("FAIL roundtrip " + plains[i]) }

        i = i + 1
    }

    // Whitespace tolerance: line-folded base64 still decodes ("foobar").
    total = total + 1
    if codec_base64_decode_str("Zm9v\nYmFy") == "foobar" { pass = pass + 1 } else { eprintln("FAIL whitespace fold") }

    // Invalid byte (non-alphabet) -> [] (empty).
    total = total + 1
    if len(codec_base64_decode("@@@@")) == 0 { pass = pass + 1 } else { eprintln("FAIL invalid byte") }

    // Binary round-trip over all single-byte values 0..255 (1-byte msgs
    // exercise the rem==2 trailing-group path that OP-75 restored).
    let mut bvalbad = 0
    let mut k = 0
    while k < 256 {
        let enc = codec_base64_encode([k])
        let dec = codec_base64_decode(enc)
        if _eq(dec, [k]) != 1 { bvalbad = bvalbad + 1 }
        k = k + 1
    }
    total = total + 1
    if bvalbad == 0 { pass = pass + 1 } else { eprintln("FAIL single-byte roundtrip count=" + str(bvalbad)) }

    let verdict = if pass == total { "PASS" } else { "FAIL" }
    println(SENT_T + " " + verdict + " " + str(pass) + "/" + str(total))
}
