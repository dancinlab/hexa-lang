// HEXA Standard Library — dojo/rl
//
// @version 0.1.0
// @capabilities [pure]
//
// FULL rl (reinforcement-learning) domain emitter for the dojo generator —
// the POLICY-GRADIENT arm. Sibling of dojo/flame_forge: emits a SMALL,
// SELF-CONTAINED, REAL flame `.hexa` REINFORCE TRAINER over the stdlib/flame
// substrate (t_* tensor ops · t_fill_lcg deterministic init · opt_adamw_step
// optimizer). The policy is a softmax over a linear score; the kata runs a
// REINFORCE (vanilla policy-gradient) loop on a tiny tabular environment and
// emits an ASCENT gate (mean episode reward strictly ascends) — the RL dual
// of dojo/flame_forge's loss-descent gate.
//
// Determinism: action sampling uses an inline integer LCG (no RNG builtin),
// so `hexa run train.hexa` is bit-reproducible across hosts. The REINFORCE
// gradient is the textbook  ∇ = -(R - b)·∇log π(a|s)  with a running-mean
// baseline b — a real (not faked) policy-gradient update.
//
// Emits per kata (kind):
//   train.hexa  — the flame `.hexa` REINFORCE trainer: tiny env, softmax
//                 policy, sampled action, reward, log-prob gradient,
//                 AdamW step, an ASCENT gate. `hexa run train.hexa`.
//   run.sh      — the .sh GLUE: `hexa run train.hexa` + assert the gate.
//   README.md   — the kata brief: env · policy · objective · ladder rung.
//   ref.py      — a torch REINFORCE REFERENCE (--lang=py|both; NOT prod).
//
// `--lang` filters the contrast surface (gen.lang_keep):
//   hexa (default) → hexa-only (train.hexa + run.sh + README.md)
//   py             → a torch REINFORCE REFERENCE — ref.py
//   both           → side-by-side (hexa trainer + torch ref + README)
//
// SPEC schema (rl keys):
//   kata       — bandit-pg | gridworld-pg   (default "bandit-pg")
//   states     — number of contexts/states int (default "4")
//   actions    — number of actions int (default "4")
//   T          — episodes per epoch int (default "64")
//   d          — (gridworld) feature width int (default "8")
//   epochs     — training epochs int (default "80")
//   lr         — learning rate, pre-formatted string (default "0.05")
//   host       — cloud pool host echo for the README (default "ubu-1")
//   output_dir — staged kata dir echo for the README (default "out")

import "stdlib/dojo/gen.hexa"

pub fn emit_rl(slug: string, spec: DojoSpec, lang: string) -> [DojoFile] {
    let files: [DojoFile] = []
    let kata = _rl_kata(spec)
    if lang_keep(lang, "hexa") {
        dojo_push(files, "train.hexa", _rl_trainer(slug, kata, spec))
    }
    if lang_keep(lang, "py") {
        dojo_push(files, "ref.py", _rl_torch_ref(slug, kata, spec))
    }
    if lang_keep(lang, "sh") {
        dojo_push(files, "run.sh", _rl_glue(slug, kata, spec))
        dojo_push(files, "README.md", _rl_readme(slug, kata, spec))
    }
    return files
}

fn _rl_kata(spec: DojoSpec) -> string {
    let k = spec_get_or(spec, "kata", "bandit-pg")
    if k == "bandit" || k == "pg" || k == "reinforce" { return "bandit-pg" }
    if k == "gridworld" || k == "grid" { return "gridworld-pg" }
    return k
}

// rl kata ladder — the known rungs, low → high.
pub fn rl_katas() -> [string] {
    return ["bandit-pg", "gridworld-pg"]
}

// ── train.hexa emit (one REINFORCE trainer per kata) ─────────────────

fn _rl_trainer(slug: string, kata: string, spec: DojoSpec) -> string {
    if kata == "bandit-pg"    { return _rl_t_bandit(slug, spec) }
    if kata == "gridworld-pg" { return _rl_t_gridworld(slug, spec) }
    return _rl_t_bandit(slug, spec)
}

fn _rl_head(slug: string, kata: string, spec: DojoSpec) -> string {
    let st = spec_get_or(spec, "states", "4")
    let ac = spec_get_or(spec, "actions", "4")
    let T  = spec_get_or(spec, "T", "64")
    let ep = spec_get_or(spec, "epochs", "80")
    let lr = spec_get_or(spec, "lr", "0.05")
    let mut s = ""
    s = s + "// rl dojo kata — generated by stdlib/dojo/rl\n"
    s = s + "// slug: " + slug + "  ·  kata: " + kata + "\n"
    s = s + "//\n"
    s = s + "// A self-contained flame REINFORCE (policy-gradient) trainer over\n"
    s = s + "// the stdlib/flame substrate (t_* tensor ops · t_fill_lcg init ·\n"
    s = s + "// opt_adamw_step optimizer). A softmax policy over a linear score;\n"
    s = s + "// vanilla policy-gradient with a running-mean baseline. Action\n"
    s = s + "// sampling is a deterministic inline LCG (bit-reproducible).\n"
    s = s + "// Emits an ASCENT gate (mean episode reward strictly ascends).\n"
    s = s + "//\n"
    s = s + "// spec: states=" + st + "  actions=" + ac + "  episodes=" + T + "  epochs=" + ep + "  lr=" + lr + "\n"
    s = s + "// run: bash run.sh   (hexa run train.hexa)\n"
    s = s + "\n"
    s = s + "use \"stdlib/flame/tensor_lib\"\n"
    s = s + "use \"stdlib/flame/optim_lib\"\n"
    s = s + "\n"
    s = s + "// inline integer LCG → a deterministic pseudo-random float in [0,1).\n"
    s = s + "// state is carried in a 1-elem tensor so it threads across calls.\n"
    s = s + "fn _rand01(rng: int) -> float {\n"
    s = s + "    let x = to_int(t_get(rng, 0))\n"
    s = s + "    let nx = (x * 1103515245 + 12345) % 2147483648\n"
    s = s + "    t_set(rng, 0, to_float(nx))\n"
    s = s + "    return to_float(nx) / 2147483648.0\n"
    s = s + "}\n"
    s = s + "\n"
    return s
}

// rung 1 — contextual-bandit REINFORCE. Each episode: a context s is drawn,
// the softmax policy π(a|s) = softmax(W[s,:]) samples an action a, the env
// rewards +1 iff a == correct(s) (correct(s) = (s+1) % A), else 0. The
// REINFORCE gradient on the policy logits is  (π - onehot(a))·(R - b), with
// a running-mean baseline b. AdamW on W. The floor rung.
fn _rl_t_bandit(slug: string, spec: DojoSpec) -> string {
    let st = spec_get_or(spec, "states", "4")
    let ac = spec_get_or(spec, "actions", "4")
    let T  = spec_get_or(spec, "T", "64")
    let ep = spec_get_or(spec, "epochs", "80")
    let lr = spec_get_or(spec, "lr", "0.05")
    let mut s = _rl_head(slug, "bandit-pg", spec)
    s = s + "fn main() {\n"
    s = s + "    let S = " + st + "       // context/state count\n"
    s = s + "    let A = " + ac + "       // action count\n"
    s = s + "    let T = " + T + "       // episodes per epoch\n"
    s = s + "    let epochs = " + ep + "\n"
    s = s + "    let lr = " + lr + "\n"
    s = s + "\n"
    s = s + "    // policy params: W (S×A) logits, one row per context\n"
    s = s + "    let W = t_zeros(S * A); t_fill_lcg(W, S * A, 3, 0.05)\n"
    s = s + "    let gW = t_zeros(S * A)\n"
    s = s + "    let mW = t_zeros(S * A); let vW = t_zeros(S * A)\n"
    s = s + "    let probs = t_zeros(A)\n"
    s = s + "    let rng = t_zeros(1); t_set(rng, 0, 20240607.0)\n"
    s = s + "    let mut baseline = 0.0\n"
    s = s + "\n"
    s = s + "    let mut first_r = 0.0\n"
    s = s + "    let mut last_r = 0.0\n"
    s = s + "    let mut ep = 1\n"
    s = s + "    while ep <= epochs {\n"
    s = s + "        let mut z = 0\n"
    s = s + "        while z < S * A { t_set(gW, z, 0.0); z = z + 1 }\n"
    s = s + "        let mut reward_sum = 0.0\n"
    s = s + "\n"
    s = s + "        let mut t = 0\n"
    s = s + "        while t < T {\n"
    s = s + "            // draw a context deterministically\n"
    s = s + "            let st = to_int(_rand01(rng) * to_float(S)) % S\n"
    s = s + "            let correct = (st + 1) % A\n"
    s = s + "            // softmax over W[st,:] (numerically stable)\n"
    s = s + "            let mut mx = t_get(W, st * A)\n"
    s = s + "            let mut c = 1\n"
    s = s + "            while c < A { if t_get(W, st * A + c) > mx { mx = t_get(W, st * A + c) } c = c + 1 }\n"
    s = s + "            let mut Z = 0.0\n"
    s = s + "            let mut c2 = 0\n"
    s = s + "            while c2 < A { let e = exp(t_get(W, st * A + c2) - mx); t_set(probs, c2, e); Z = Z + e; c2 = c2 + 1 }\n"
    s = s + "            let mut c3 = 0\n"
    s = s + "            while c3 < A { t_set(probs, c3, t_get(probs, c3) / Z); c3 = c3 + 1 }\n"
    s = s + "            // sample an action a ~ π via inverse-CDF on the LCG draw\n"
    s = s + "            let u = _rand01(rng)\n"
    s = s + "            let mut acc = 0.0\n"
    s = s + "            let mut a = 0\n"
    s = s + "            let mut c4 = 0\n"
    s = s + "            while c4 < A { acc = acc + t_get(probs, c4); if u <= acc { a = c4; c4 = A } else { c4 = c4 + 1 } }\n"
    s = s + "            let R = if a == correct { 1.0 } else { 0.0 }\n"
    s = s + "            reward_sum = reward_sum + R\n"
    s = s + "            // REINFORCE: g_logit[c] = (π[c] - onehot(a)[c])·(R - baseline)\n"
    s = s + "            let adv = R - baseline\n"
    s = s + "            let mut c5 = 0\n"
    s = s + "            while c5 < A {\n"
    s = s + "                let dl = (t_get(probs, c5) - (if c5 == a { 1.0 } else { 0.0 })) * adv\n"
    s = s + "                t_set(gW, st * A + c5, t_get(gW, st * A + c5) + dl)\n"
    s = s + "                c5 = c5 + 1\n"
    s = s + "            }\n"
    s = s + "            t = t + 1\n"
    s = s + "        }\n"
    s = s + "        let mean_r = reward_sum / to_float(T)\n"
    s = s + "        baseline = 0.9 * baseline + 0.1 * mean_r   // running-mean baseline\n"
    s = s + "        if ep == 1 { first_r = mean_r }\n"
    s = s + "        last_r = mean_r\n"
    s = s + "        // ascend reward → descend on (-g); opt_adamw_step descends, so pass gW.\n"
    s = s + "        opt_adamw_step(W, gW, mW, vW, S * A, lr, 0.9, 0.999, 0.00000001, 0.0, ep)\n"
    s = s + "        ep = ep + 1\n"
    s = s + "    }\n"
    s = s + "    print(\"  epoch-1 mean reward   = \"); println(to_string(first_r))\n"
    s = s + "    print(\"  epoch-\"); print(epochs); print(\" mean reward = \"); println(to_string(last_r))\n"
    s = s + _rl_gate_tail("BANDITPG")
    s = s + "}\n"
    return s
}

// rung 2 — gridworld-style contextual REINFORCE. The same REINFORCE machinery
// over a richer feature: state is embedded into a d-dim feature φ(s) (a fixed
// deterministic embedding), policy logits = φ(s)·W (d×A). Reward +1 iff the
// sampled action equals the state-dependent optimal action. Adds a feature
// projection (a learned linear policy over features) over the tabular bandit.
fn _rl_t_gridworld(slug: string, spec: DojoSpec) -> string {
    let st = spec_get_or(spec, "states", "4")
    let ac = spec_get_or(spec, "actions", "4")
    let T  = spec_get_or(spec, "T", "64")
    let d  = spec_get_or(spec, "d", "8")
    let ep = spec_get_or(spec, "epochs", "80")
    let lr = spec_get_or(spec, "lr", "0.05")
    let mut s = _rl_head(slug, "gridworld-pg", spec)
    s = s + "fn main() {\n"
    s = s + "    let S = " + st + "       // state count\n"
    s = s + "    let A = " + ac + "       // action count\n"
    s = s + "    let d = " + d + "       // feature width φ(s)\n"
    s = s + "    let T = " + T + "       // episodes per epoch\n"
    s = s + "    let epochs = " + ep + "\n"
    s = s + "    let lr = " + lr + "\n"
    s = s + "\n"
    s = s + "    // fixed deterministic feature table φ (S×d), learned policy W (d×A)\n"
    s = s + "    let phi = t_zeros(S * d); t_fill_lcg(phi, S * d, 2, 1.0)\n"
    s = s + "    let W = t_zeros(d * A); t_fill_lcg(W, d * A, 3, 0.05)\n"
    s = s + "    let gW = t_zeros(d * A)\n"
    s = s + "    let mW = t_zeros(d * A); let vW = t_zeros(d * A)\n"
    s = s + "    let logits = t_zeros(A); let probs = t_zeros(A)\n"
    s = s + "    let rng = t_zeros(1); t_set(rng, 0, 20240607.0)\n"
    s = s + "    let mut baseline = 0.0\n"
    s = s + "\n"
    s = s + "    let mut first_r = 0.0\n"
    s = s + "    let mut last_r = 0.0\n"
    s = s + "    let mut ep = 1\n"
    s = s + "    while ep <= epochs {\n"
    s = s + "        let mut z = 0\n"
    s = s + "        while z < d * A { t_set(gW, z, 0.0); z = z + 1 }\n"
    s = s + "        let mut reward_sum = 0.0\n"
    s = s + "\n"
    s = s + "        let mut t = 0\n"
    s = s + "        while t < T {\n"
    s = s + "            let st = to_int(_rand01(rng) * to_float(S)) % S\n"
    s = s + "            let correct = (st + 1) % A\n"
    s = s + "            // logits[c] = Σ_k φ[st,k]·W[k,c]\n"
    s = s + "            let mut c = 0\n"
    s = s + "            while c < A {\n"
    s = s + "                let mut acc = 0.0\n"
    s = s + "                let mut k = 0\n"
    s = s + "                while k < d { acc = acc + t_get(phi, st * d + k) * t_get(W, k * A + c); k = k + 1 }\n"
    s = s + "                t_set(logits, c, acc)\n"
    s = s + "                c = c + 1\n"
    s = s + "            }\n"
    s = s + "            let mut mx = t_get(logits, 0)\n"
    s = s + "            let mut c0 = 1\n"
    s = s + "            while c0 < A { if t_get(logits, c0) > mx { mx = t_get(logits, c0) } c0 = c0 + 1 }\n"
    s = s + "            let mut Z = 0.0\n"
    s = s + "            let mut c1 = 0\n"
    s = s + "            while c1 < A { let e = exp(t_get(logits, c1) - mx); t_set(probs, c1, e); Z = Z + e; c1 = c1 + 1 }\n"
    s = s + "            let mut c2 = 0\n"
    s = s + "            while c2 < A { t_set(probs, c2, t_get(probs, c2) / Z); c2 = c2 + 1 }\n"
    s = s + "            let u = _rand01(rng)\n"
    s = s + "            let mut accu = 0.0\n"
    s = s + "            let mut a = 0\n"
    s = s + "            let mut c3 = 0\n"
    s = s + "            while c3 < A { accu = accu + t_get(probs, c3); if u <= accu { a = c3; c3 = A } else { c3 = c3 + 1 } }\n"
    s = s + "            let R = if a == correct { 1.0 } else { 0.0 }\n"
    s = s + "            reward_sum = reward_sum + R\n"
    s = s + "            let adv = R - baseline\n"
    s = s + "            // dlogit[c] = (π[c] - onehot(a))·adv ; gW[k,c] += φ[st,k]·dlogit[c]\n"
    s = s + "            let mut c4 = 0\n"
    s = s + "            while c4 < A {\n"
    s = s + "                let dl = (t_get(probs, c4) - (if c4 == a { 1.0 } else { 0.0 })) * adv\n"
    s = s + "                let mut k = 0\n"
    s = s + "                while k < d { t_set(gW, k * A + c4, t_get(gW, k * A + c4) + t_get(phi, st * d + k) * dl); k = k + 1 }\n"
    s = s + "                c4 = c4 + 1\n"
    s = s + "            }\n"
    s = s + "            t = t + 1\n"
    s = s + "        }\n"
    s = s + "        let mean_r = reward_sum / to_float(T)\n"
    s = s + "        baseline = 0.9 * baseline + 0.1 * mean_r\n"
    s = s + "        if ep == 1 { first_r = mean_r }\n"
    s = s + "        last_r = mean_r\n"
    s = s + "        opt_adamw_step(W, gW, mW, vW, d * A, lr, 0.9, 0.999, 0.00000001, 0.0, ep)\n"
    s = s + "        ep = ep + 1\n"
    s = s + "    }\n"
    s = s + "    print(\"  epoch-1 mean reward   = \"); println(to_string(first_r))\n"
    s = s + "    print(\"  epoch-\"); print(epochs); print(\" mean reward = \"); println(to_string(last_r))\n"
    s = s + _rl_gate_tail("GRIDWORLDPG")
    s = s + "}\n"
    return s
}

// ASCENT gate tail — RL maximizes reward, so the gate asserts the mean
// episode reward ROSE (last_r > first_r), the dual of the loss-descent gate.
fn _rl_gate_tail(gate: string) -> string {
    let mut s = ""
    s = s + "    if last_r > first_r {\n"
    s = s + "        println(\"F-RL-" + gate + " = 1\")\n"
    s = s + "        println(\"PASS — mean episode reward strictly ascends over training\")\n"
    s = s + "        return\n"
    s = s + "    }\n"
    s = s + "    println(\"F-RL-" + gate + " = 0\")\n"
    s = s + "    println(\"FAIL — mean reward did not ascend\")\n"
    return s
}

fn _rl_gate_id(kata: string) -> string {
    if kata == "gridworld-pg" { return "GRIDWORLDPG" }
    return "BANDITPG"
}

// ── torch reference (--lang=py | both) — emitted-string content only ──

fn _rl_torch_ref(slug: string, kata: string, spec: DojoSpec) -> string {
    let st = spec_get_or(spec, "states", "4")
    let ac = spec_get_or(spec, "actions", "4")
    let T  = spec_get_or(spec, "T", "64")
    let ep = spec_get_or(spec, "epochs", "80")
    let lr = spec_get_or(spec, "lr", "0.05")
    let mut s = ""
    s = s + "#!/usr/bin/env python3\n"
    s = s + "# rl dojo kata — torch REINFORCE REFERENCE (NOT the production path)\n"
    s = s + "# slug: " + slug + "  ·  kata: " + kata + "\n"
    s = s + "#\n"
    s = s + "# A side-by-side PyTorch REINFORCE reference for the SAME tiny env.\n"
    s = s + "# The hexa train.hexa is the production surface (flame substrate, a\n"
    s = s + "# deterministic inline-LCG sampler); this torch script is the\n"
    s = s + "# familiar-framework CONTRAST that motivates the kata. NOT what ships.\n"
    s = s + "import torch\n"
    s = s + "\n"
    s = s + "torch.manual_seed(0)\n"
    s = s + "S, A, T, EPOCHS, LR = " + st + ", " + ac + ", " + T + ", " + ep + ", " + lr + "\n"
    s = s + "W = torch.zeros(S, A, requires_grad=True)\n"
    s = s + "opt = torch.optim.AdamW([W], lr=LR)\n"
    s = s + "baseline = 0.0\n"
    s = s + "for ep in range(EPOCHS):\n"
    s = s + "    opt.zero_grad()\n"
    s = s + "    states = torch.randint(0, S, (T,))\n"
    s = s + "    logits = W[states]\n"
    s = s + "    dist = torch.distributions.Categorical(logits=logits)\n"
    s = s + "    acts = dist.sample()\n"
    s = s + "    correct = (states + 1) % A\n"
    s = s + "    R = (acts == correct).float()\n"
    s = s + "    loss = -(dist.log_prob(acts) * (R - baseline)).mean()\n"
    s = s + "    baseline = 0.9 * baseline + 0.1 * R.mean().item()\n"
    s = s + "    if ep == 0: first = R.mean().item()\n"
    s = s + "    loss.backward(); opt.step()\n"
    s = s + "print(f'epoch-1 reward={first}  epoch-{EPOCHS} reward={R.mean().item()}')\n"
    return s
}

// ── run.sh glue + README (emitted-string content only) ───────────────

fn _rl_glue(slug: string, kata: string, spec: DojoSpec) -> string {
    let gate = _rl_gate_id(kata)
    let mut s = ""
    s = s + "#!/usr/bin/env bash\n"
    s = s + "# rl dojo run glue — generated by stdlib/dojo/rl\n"
    s = s + "# slug: " + slug + "  ·  kata: " + kata + "\n"
    s = s + "set -euo pipefail\n"
    s = s + "cd \"$(dirname \"$0\")\"\n"
    s = s + "\n"
    s = s + "# local CPU path — the REINFORCE ascent-gate kata. Run the\n"
    s = s + "# self-contained flame policy-gradient trainer (deterministic inline\n"
    s = s + "# LCG sampler), then assert the reward-ascent gate.\n"
    s = s + "RUN_LOG=\"$PWD/train.$$.log\"\n"
    s = s + "echo \"rl: hexa run train.hexa\"\n"
    s = s + "hexa run train.hexa 2>&1 | tee \"$RUN_LOG\"\n"
    s = s + "\n"
    s = s + "if grep -q \"F-RL-" + gate + " = 1\" \"$RUN_LOG\"; then\n"
    s = s + "    echo \"GATE F-RL-" + gate + ": GREEN (reward ascends)\"\n"
    s = s + "else\n"
    s = s + "    echo \"GATE F-RL-" + gate + ": RED (no ascent)\" >&2\n"
    s = s + "    exit 1\n"
    s = s + "fi\n"
    return s
}

fn _rl_readme(slug: string, kata: string, spec: DojoSpec) -> string {
    let st = spec_get_or(spec, "states", "4")
    let ac = spec_get_or(spec, "actions", "4")
    let T  = spec_get_or(spec, "T", "64")
    let ep = spec_get_or(spec, "epochs", "80")
    let lr = spec_get_or(spec, "lr", "0.05")
    let host = spec_get_or(spec, "host", "ubu-1")
    let mut s = ""
    s = s + "# rl dojo kata — " + slug + " (" + kata + ")\n"
    s = s + "\n"
    s = s + "The **policy-gradient** arm of the dojo. Each kata is a small,\n"
    s = s + "complete flame REINFORCE trainer over the stdlib/flame substrate\n"
    s = s + "(`t_*` tensor ops, `opt_adamw_step` optimizer) on a tiny tabular\n"
    s = s + "environment. A softmax policy over a linear score, vanilla\n"
    s = s + "policy-gradient with a running-mean baseline, deterministic\n"
    s = s + "inline-LCG action sampling. Each emits an **ascent gate** (mean\n"
    s = s + "episode reward strictly ascends) — the RL dual of the loss-descent\n"
    s = s + "gate the flame-forge/vision/tabular arms use.\n"
    s = s + "\n"
    s = s + "- spec: `states=" + st + "`  `actions=" + ac + "`  `episodes=" + T + "`  `epochs=" + ep + "`  `lr=" + lr + "`  `host=" + host + "`\n"
    s = s + "- run: `bash run.sh`  (`hexa run train.hexa` + assert the gate)\n"
    s = s + "\n"
    s = s + "## kata ladder\n"
    s = s + "\n"
    s = s + "| rung | kata | env · policy · objective |\n"
    s = s + "|---|---|---|\n"
    s = s + "| 1 | bandit-pg | contextual bandit · softmax(W[s]) · REINFORCE + baseline |\n"
    s = s + "| 2 | gridworld-pg | feature φ(s)·W policy · REINFORCE + baseline |\n"
    s = s + "\n"
    s = s + "## the REINFORCE update\n"
    s = s + "\n"
    s = s + "Per episode the policy π(a|s) = softmax(score) samples an action a;\n"
    s = s + "the env returns reward R (+1 iff a matches the state's optimal\n"
    s = s + "action). The policy-gradient on the logits is the textbook\n"
    s = s + "`(π - onehot(a))·(R - b)` with a running-mean baseline `b` —\n"
    s = s + "`opt_adamw_step` descends on that gradient, which ascends reward.\n"
    s = s + "Action sampling is a deterministic inline integer LCG, so the run\n"
    s = s + "is bit-reproducible across hosts (no RNG builtin needed).\n"
    s = s + "\n"
    s = s + "## files\n"
    s = s + "\n"
    s = s + "- `train.hexa` — the self-contained flame REINFORCE trainer + ascent gate\n"
    s = s + "- `run.sh` — `hexa run train.hexa` + assert `F-RL-" + _rl_gate_id(kata) + "`\n"
    s = s + "- `ref.py` — the torch REINFORCE reference (`--lang=py|both`; NOT production)\n"
    s = s + "\n"
    s = s + "## references\n"
    s = s + "\n"
    s = s + "- `stdlib/flame/` — the flame substrate (`tensor_lib` · `optim_lib`)\n"
    s = s + "- `stdlib/dojo/flame_forge.hexa` — the supervised NN-training sibling arm\n"
    s = s + "- `docs/hexa-dojo.md` — the dojo tracks + the kata ladders\n"
    return s
}
