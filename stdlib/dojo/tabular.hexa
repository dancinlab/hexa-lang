// HEXA Standard Library — dojo/tabular
//
// @version 0.1.0
// @capabilities [pure]
//
// FULL tabular domain emitter for the dojo generator — the TABULAR-CLASSIFIER
// arm. Sibling of dojo/flame_forge: emits a SMALL, SELF-CONTAINED, REAL flame
// `.hexa` TRAINER over the stdlib/flame substrate (t_* tensor ops · t_matmul
// forge matmul · t_fill_lcg deterministic init · opt_adamw_step optimizer) on
// a synthetic tabular feature matrix with a deterministic class signal, with a
// softmax cross-entropy DESCENT gate (mean CE strictly descends) — the same
// discipline as dojo/clm's prod loop.
//
// Emits per kata (kind):
//   train.hexa  — the flame `.hexa` classifier: synthetic (T × F) feature
//                 matrix, forward, closed softmax-CE backward, optimizer
//                 step, a descent gate. `hexa run train.hexa`.
//   run.sh      — the .sh GLUE: `hexa run train.hexa` + assert the gate.
//   README.md   — the kata brief: model · loss · ladder rung.
//   ref.py      — a torch MLP-on-tabular REFERENCE (--lang=py|both; NOT prod).
//
// `--lang` filters the contrast surface (gen.lang_keep):
//   hexa (default) → hexa-only (train.hexa + run.sh + README.md)
//   py             → a torch tabular-MLP REFERENCE — ref.py
//   both           → side-by-side (hexa trainer + torch ref + README)
//
// SPEC schema (tabular keys):
//   kata       — logreg | mlp-tab   (default "logreg")
//   features   — input feature count int (default "12")
//   classes    — number of output classes int (default "3")
//   T          — synthetic row count int (default "96")
//   d          — hidden width for mlp-tab int (default "24")
//   epochs     — training epochs int (default "60")
//   lr         — learning rate, pre-formatted string (default "0.03")
//   host       — cloud pool host echo for the README (default "ubu-1")
//   output_dir — staged kata dir echo for the README (default "out")

import "stdlib/dojo/gen.hexa"

pub fn emit_tabular(slug: string, spec: DojoSpec, lang: string) -> [DojoFile] {
    let files: [DojoFile] = []
    let kata = _tab_kata(spec)
    if lang_keep(lang, "hexa") {
        dojo_push(files, "train.hexa", _tab_trainer(slug, kata, spec))
    }
    if lang_keep(lang, "py") {
        dojo_push(files, "ref.py", _tab_torch_ref(slug, kata, spec))
    }
    if lang_keep(lang, "sh") {
        dojo_push(files, "run.sh", _tab_glue(slug, kata, spec))
        dojo_push(files, "README.md", _tab_readme(slug, kata, spec))
    }
    return files
}

fn _tab_kata(spec: DojoSpec) -> string {
    let k = spec_get_or(spec, "kata", "logreg")
    if k == "logistic" || k == "linear" || k == "softmax" { return "logreg" }
    if k == "mlp" || k == "mlptab" || k == "mlp_tab" { return "mlp-tab" }
    return k
}

// tabular kata ladder — the known rungs, low → high.
pub fn tabular_katas() -> [string] {
    return ["logreg", "mlp-tab"]
}

// ── train.hexa emit (one flame classifier per kata) ──────────────────

fn _tab_trainer(slug: string, kata: string, spec: DojoSpec) -> string {
    if kata == "logreg"  { return _tab_t_logreg(slug, spec) }
    if kata == "mlp-tab" { return _tab_t_mlp(slug, spec) }
    return _tab_t_logreg(slug, spec)
}

fn _tab_head(slug: string, kata: string, spec: DojoSpec) -> string {
    let ft = spec_get_or(spec, "features", "12")
    let cl = spec_get_or(spec, "classes", "3")
    let T  = spec_get_or(spec, "T", "96")
    let ep = spec_get_or(spec, "epochs", "60")
    let lr = spec_get_or(spec, "lr", "0.03")
    let mut s = ""
    s = s + "// tabular dojo kata — generated by stdlib/dojo/tabular\n"
    s = s + "// slug: " + slug + "  ·  kata: " + kata + "\n"
    s = s + "//\n"
    s = s + "// A self-contained flame tabular classifier over the stdlib/flame\n"
    s = s + "// substrate (t_* tensor ops · t_matmul forge matmul · t_fill_lcg\n"
    s = s + "// init · opt_adamw_step optimizer). A synthetic (T × F) feature\n"
    s = s + "// matrix, a deterministic class signal, softmax cross-entropy.\n"
    s = s + "// Emits a DESCENT gate (mean CE strictly descends). Runs on a CPU\n"
    s = s + "// host (forge matmul CPU farr fallback); a forge-GPU host\n"
    s = s + "// accelerates the SAME code unchanged.\n"
    s = s + "//\n"
    s = s + "// spec: features=" + ft + "  classes=" + cl + "  T=" + T + "  epochs=" + ep + "  lr=" + lr + "\n"
    s = s + "// run: bash run.sh   (hexa run train.hexa)\n"
    s = s + "\n"
    s = s + "use \"stdlib/flame/tensor_lib\"\n"
    s = s + "use \"stdlib/flame/optim_lib\"\n"
    s = s + "\n"
    return s
}

// deterministic synthetic tabular data: row i belongs to class (i % C);
// each feature is a class-dependent offset + a low-amplitude LCG noise so
// the classes are linearly separable enough for logreg to descend.
fn _tab_data_emit() -> string {
    let mut s = ""
    s = s + "    // synthetic features: X (T × F), label[i] = i % C\n"
    s = s + "    let X = t_zeros(T * F)\n"
    s = s + "    let lab = t_zeros(T)\n"
    s = s + "    let noise = t_zeros(T * F); t_fill_lcg(noise, T * F, 5, 0.1)\n"
    s = s + "    let mut i = 0\n"
    s = s + "    while i < T {\n"
    s = s + "        let cls = i % C\n"
    s = s + "        t_set(lab, i, to_float(cls))\n"
    s = s + "        let mut f = 0\n"
    s = s + "        while f < F {\n"
    s = s + "            // class-dependent offset on feature (f mod C == cls) channels\n"
    s = s + "            let offset = if (f % C) == cls { to_float(cls + 1) } else { 0.0 }\n"
    s = s + "            t_set(X, i * F + f, offset + t_get(noise, i * F + f))\n"
    s = s + "            f = f + 1\n"
    s = s + "        }\n"
    s = s + "        i = i + 1\n"
    s = s + "    }\n"
    return s
}

// rung 1 — multinomial logistic regression. logits = X·W + b over C classes,
// softmax cross-entropy, full closed backward (dlogits = probs - onehot),
// AdamW. The floor rung — one matmul forward + the softmax-CE vjp.
fn _tab_t_logreg(slug: string, spec: DojoSpec) -> string {
    let ft = spec_get_or(spec, "features", "12")
    let cl = spec_get_or(spec, "classes", "3")
    let T  = spec_get_or(spec, "T", "96")
    let ep = spec_get_or(spec, "epochs", "60")
    let lr = spec_get_or(spec, "lr", "0.03")
    let mut s = _tab_head(slug, "logreg", spec)
    s = s + "fn main() {\n"
    s = s + "    let F = " + ft + "      // feature count\n"
    s = s + "    let C = " + cl + "      // class count\n"
    s = s + "    let T = " + T + "       // row count\n"
    s = s + "    let epochs = " + ep + "\n"
    s = s + "    let lr = " + lr + "\n"
    s = s + "\n"
    s = s + _tab_data_emit()
    s = s + "\n"
    s = s + "    // params: W (F×C), b (C)\n"
    s = s + "    let W = t_zeros(F * C); t_fill_lcg(W, F * C, 7, 0.1)\n"
    s = s + "    let b = t_zeros(C)\n"
    s = s + "    let gW = t_zeros(F * C); let gb = t_zeros(C)\n"
    s = s + "    let mW = t_zeros(F * C); let vW = t_zeros(F * C)\n"
    s = s + "    let mb = t_zeros(C); let vb = t_zeros(C)\n"
    s = s + "    let probs = t_zeros(C)\n"
    s = s + "\n"
    s = s + "    let mut first_ce = 0.0\n"
    s = s + "    let mut last_ce = 0.0\n"
    s = s + "    let mut ep = 1\n"
    s = s + "    while ep <= epochs {\n"
    s = s + "        let mut z = 0\n"
    s = s + "        while z < F * C { t_set(gW, z, 0.0); z = z + 1 }\n"
    s = s + "        let mut z2 = 0\n"
    s = s + "        while z2 < C { t_set(gb, z2, 0.0); z2 = z2 + 1 }\n"
    s = s + "        let mut ce_sum = 0.0\n"
    s = s + "\n"
    s = s + "        // logits = X·W + b  (T×F)·(F×C)\n"
    s = s + "        let logits = t_matmul(X, T, F, W, C)\n"
    s = s + "        let mut t = 0\n"
    s = s + "        while t < T {\n"
    s = s + "            let tg = to_int(t_get(lab, t))\n"
    s = s + "            let mut mx = t_get(logits, t * C) + t_get(b, 0)\n"
    s = s + "            let mut c = 1\n"
    s = s + "            while c < C {\n"
    s = s + "                let v = t_get(logits, t * C + c) + t_get(b, c)\n"
    s = s + "                if v > mx { mx = v }\n"
    s = s + "                c = c + 1\n"
    s = s + "            }\n"
    s = s + "            let mut Z = 0.0\n"
    s = s + "            let mut c2 = 0\n"
    s = s + "            while c2 < C {\n"
    s = s + "                let e = exp(t_get(logits, t * C + c2) + t_get(b, c2) - mx)\n"
    s = s + "                t_set(probs, c2, e); Z = Z + e; c2 = c2 + 1\n"
    s = s + "            }\n"
    s = s + "            let mut c3 = 0\n"
    s = s + "            while c3 < C { t_set(probs, c3, t_get(probs, c3) / Z); c3 = c3 + 1 }\n"
    s = s + "            ce_sum = ce_sum - log(t_get(probs, tg) + 0.00000001)\n"
    s = s + "            let mut c4 = 0\n"
    s = s + "            while c4 < C {\n"
    s = s + "                let dl = t_get(probs, c4) - (if c4 == tg { 1.0 } else { 0.0 })\n"
    s = s + "                t_set(gb, c4, t_get(gb, c4) + dl)\n"
    s = s + "                let mut f = 0\n"
    s = s + "                while f < F {\n"
    s = s + "                    t_set(gW, f * C + c4, t_get(gW, f * C + c4) + t_get(X, t * F + f) * dl)\n"
    s = s + "                    f = f + 1\n"
    s = s + "                }\n"
    s = s + "                c4 = c4 + 1\n"
    s = s + "            }\n"
    s = s + "            t = t + 1\n"
    s = s + "        }\n"
    s = s + "        let ce = ce_sum / to_float(T)\n"
    s = s + "        if ep == 1 { first_ce = ce }\n"
    s = s + "        last_ce = ce\n"
    s = s + "\n"
    s = s + "        opt_adamw_step(W, gW, mW, vW, F * C, lr, 0.9, 0.999, 0.00000001, 0.0, ep)\n"
    s = s + "        opt_adamw_step(b, gb, mb, vb, C, lr, 0.9, 0.999, 0.00000001, 0.0, ep)\n"
    s = s + "        t_free(logits)\n"
    s = s + "        ep = ep + 1\n"
    s = s + "    }\n"
    s = s + "    print(\"  epoch-1 mean CE   = \"); println(to_string(first_ce))\n"
    s = s + "    print(\"  epoch-\"); print(epochs); print(\" mean CE = \"); println(to_string(last_ce))\n"
    s = s + _tab_gate_tail("LOGREG")
    s = s + "}\n"
    return s
}

// rung 2 — tabular MLP. h = relu(X·W1 + b1) ; logits = h·W2 + b2. Adds a
// hidden layer + nonlinearity over logreg; full backprop through relu,
// softmax cross-entropy, AdamW.
fn _tab_t_mlp(slug: string, spec: DojoSpec) -> string {
    let ft = spec_get_or(spec, "features", "12")
    let cl = spec_get_or(spec, "classes", "3")
    let T  = spec_get_or(spec, "T", "96")
    let d  = spec_get_or(spec, "d", "24")
    let ep = spec_get_or(spec, "epochs", "60")
    let lr = spec_get_or(spec, "lr", "0.03")
    let mut s = _tab_head(slug, "mlp-tab", spec)
    s = s + "// relu(x) = max(x, 0) elementwise.\n"
    s = s + "fn _relu(z: int, out: int, n: int) {\n"
    s = s + "    let mut i = 0\n"
    s = s + "    while i < n {\n"
    s = s + "        let v = t_get(z, i)\n"
    s = s + "        t_set(out, i, if v > 0.0 { v } else { 0.0 })\n"
    s = s + "        i = i + 1\n"
    s = s + "    }\n"
    s = s + "}\n"
    s = s + "\n"
    s = s + "fn main() {\n"
    s = s + "    let F = " + ft + "      // feature count\n"
    s = s + "    let C = " + cl + "      // class count\n"
    s = s + "    let T = " + T + "       // row count\n"
    s = s + "    let h = " + d + "       // hidden width\n"
    s = s + "    let epochs = " + ep + "\n"
    s = s + "    let lr = " + lr + "\n"
    s = s + "\n"
    s = s + _tab_data_emit()
    s = s + "\n"
    s = s + "    // params: W1 (F×h), b1 (h), W2 (h×C), b2 (C)\n"
    s = s + "    let W1 = t_zeros(F * h); t_fill_lcg(W1, F * h, 7, 0.1)\n"
    s = s + "    let b1 = t_zeros(h)\n"
    s = s + "    let W2 = t_zeros(h * C); t_fill_lcg(W2, h * C, 8, 0.1)\n"
    s = s + "    let b2 = t_zeros(C)\n"
    s = s + "    let gW1 = t_zeros(F * h); let gb1 = t_zeros(h)\n"
    s = s + "    let gW2 = t_zeros(h * C); let gb2 = t_zeros(C)\n"
    s = s + "    let mW1 = t_zeros(F * h); let vW1 = t_zeros(F * h)\n"
    s = s + "    let mb1 = t_zeros(h); let vb1 = t_zeros(h)\n"
    s = s + "    let mW2 = t_zeros(h * C); let vW2 = t_zeros(h * C)\n"
    s = s + "    let mb2 = t_zeros(C); let vb2 = t_zeros(C)\n"
    s = s + "    let pre = t_zeros(T * h); let act = t_zeros(T * h)\n"
    s = s + "    let dact = t_zeros(T * h)\n"
    s = s + "    let probs = t_zeros(C)\n"
    s = s + "\n"
    s = s + "    let mut first_ce = 0.0\n"
    s = s + "    let mut last_ce = 0.0\n"
    s = s + "    let mut ep = 1\n"
    s = s + "    while ep <= epochs {\n"
    s = s + "        let mut z = 0\n"
    s = s + "        while z < F * h { t_set(gW1, z, 0.0); z = z + 1 }\n"
    s = s + "        let mut z1 = 0\n"
    s = s + "        while z1 < h { t_set(gb1, z1, 0.0); z1 = z1 + 1 }\n"
    s = s + "        let mut z2 = 0\n"
    s = s + "        while z2 < h * C { t_set(gW2, z2, 0.0); z2 = z2 + 1 }\n"
    s = s + "        let mut z3 = 0\n"
    s = s + "        while z3 < C { t_set(gb2, z3, 0.0); z3 = z3 + 1 }\n"
    s = s + "        let mut z4 = 0\n"
    s = s + "        while z4 < T * h { t_set(dact, z4, 0.0); z4 = z4 + 1 }\n"
    s = s + "        let mut ce_sum = 0.0\n"
    s = s + "\n"
    s = s + "        // forward layer 1: pre = X·W1 + b1 ; act = relu(pre)\n"
    s = s + "        let xw1 = t_matmul(X, T, F, W1, h)\n"
    s = s + "        let mut r = 0\n"
    s = s + "        while r < T {\n"
    s = s + "            let mut c = 0\n"
    s = s + "            while c < h {\n"
    s = s + "                t_set(pre, r * h + c, t_get(xw1, r * h + c) + t_get(b1, c))\n"
    s = s + "                c = c + 1\n"
    s = s + "            }\n"
    s = s + "            r = r + 1\n"
    s = s + "        }\n"
    s = s + "        _relu(pre, act, T * h)\n"
    s = s + "        // forward layer 2: logits = act·W2 + b2\n"
    s = s + "        let aw2 = t_matmul(act, T, h, W2, C)\n"
    s = s + "\n"
    s = s + "        let mut t = 0\n"
    s = s + "        while t < T {\n"
    s = s + "            let tg = to_int(t_get(lab, t))\n"
    s = s + "            let mut mx = t_get(aw2, t * C) + t_get(b2, 0)\n"
    s = s + "            let mut c0 = 1\n"
    s = s + "            while c0 < C {\n"
    s = s + "                let v = t_get(aw2, t * C + c0) + t_get(b2, c0)\n"
    s = s + "                if v > mx { mx = v }\n"
    s = s + "                c0 = c0 + 1\n"
    s = s + "            }\n"
    s = s + "            let mut Z = 0.0\n"
    s = s + "            let mut c1 = 0\n"
    s = s + "            while c1 < C {\n"
    s = s + "                let e = exp(t_get(aw2, t * C + c1) + t_get(b2, c1) - mx)\n"
    s = s + "                t_set(probs, c1, e); Z = Z + e; c1 = c1 + 1\n"
    s = s + "            }\n"
    s = s + "            let mut c2 = 0\n"
    s = s + "            while c2 < C { t_set(probs, c2, t_get(probs, c2) / Z); c2 = c2 + 1 }\n"
    s = s + "            ce_sum = ce_sum - log(t_get(probs, tg) + 0.00000001)\n"
    s = s + "            let mut c3 = 0\n"
    s = s + "            while c3 < C {\n"
    s = s + "                let dl = t_get(probs, c3) - (if c3 == tg { 1.0 } else { 0.0 })\n"
    s = s + "                t_set(gb2, c3, t_get(gb2, c3) + dl)\n"
    s = s + "                let mut k = 0\n"
    s = s + "                while k < h {\n"
    s = s + "                    t_set(gW2, k * C + c3, t_get(gW2, k * C + c3) + t_get(act, t * h + k) * dl)\n"
    s = s + "                    t_set(dact, t * h + k, t_get(dact, t * h + k) + dl * t_get(W2, k * C + c3))\n"
    s = s + "                    k = k + 1\n"
    s = s + "                }\n"
    s = s + "                c3 = c3 + 1\n"
    s = s + "            }\n"
    s = s + "            t = t + 1\n"
    s = s + "        }\n"
    s = s + "        let ce = ce_sum / to_float(T)\n"
    s = s + "        if ep == 1 { first_ce = ce }\n"
    s = s + "        last_ce = ce\n"
    s = s + "\n"
    s = s + "        // backward into layer 1: dpre = dact·relu'(pre) ; gW1, gb1\n"
    s = s + "        let mut ti = 0\n"
    s = s + "        while ti < T {\n"
    s = s + "            let mut ci = 0\n"
    s = s + "            while ci < h {\n"
    s = s + "                let dp = if t_get(pre, ti * h + ci) > 0.0 { t_get(dact, ti * h + ci) } else { 0.0 }\n"
    s = s + "                t_set(gb1, ci, t_get(gb1, ci) + dp)\n"
    s = s + "                let mut f = 0\n"
    s = s + "                while f < F {\n"
    s = s + "                    t_set(gW1, f * h + ci, t_get(gW1, f * h + ci) + t_get(X, ti * F + f) * dp)\n"
    s = s + "                    f = f + 1\n"
    s = s + "                }\n"
    s = s + "                ci = ci + 1\n"
    s = s + "            }\n"
    s = s + "            ti = ti + 1\n"
    s = s + "        }\n"
    s = s + "\n"
    s = s + "        opt_adamw_step(W1, gW1, mW1, vW1, F * h, lr, 0.9, 0.999, 0.00000001, 0.0, ep)\n"
    s = s + "        opt_adamw_step(b1, gb1, mb1, vb1, h, lr, 0.9, 0.999, 0.00000001, 0.0, ep)\n"
    s = s + "        opt_adamw_step(W2, gW2, mW2, vW2, h * C, lr, 0.9, 0.999, 0.00000001, 0.0, ep)\n"
    s = s + "        opt_adamw_step(b2, gb2, mb2, vb2, C, lr, 0.9, 0.999, 0.00000001, 0.0, ep)\n"
    s = s + "        t_free(xw1); t_free(aw2)\n"
    s = s + "        ep = ep + 1\n"
    s = s + "    }\n"
    s = s + "    print(\"  epoch-1 mean CE   = \"); println(to_string(first_ce))\n"
    s = s + "    print(\"  epoch-\"); print(epochs); print(\" mean CE = \"); println(to_string(last_ce))\n"
    s = s + _tab_gate_tail("MLPTAB")
    s = s + "}\n"
    return s
}

// descent-gate tail (first_ce / last_ce).
fn _tab_gate_tail(gate: string) -> string {
    let mut s = ""
    s = s + "    if last_ce < first_ce {\n"
    s = s + "        println(\"F-TABULAR-" + gate + " = 1\")\n"
    s = s + "        println(\"PASS — mean CE strictly descends over training\")\n"
    s = s + "        return\n"
    s = s + "    }\n"
    s = s + "    println(\"F-TABULAR-" + gate + " = 0\")\n"
    s = s + "    println(\"FAIL — mean CE did not descend\")\n"
    return s
}

fn _tab_gate_id(kata: string) -> string {
    if kata == "mlp-tab" { return "MLPTAB" }
    return "LOGREG"
}

// ── torch reference (--lang=py | both) — emitted-string content only ──

fn _tab_torch_ref(slug: string, kata: string, spec: DojoSpec) -> string {
    let ft = spec_get_or(spec, "features", "12")
    let cl = spec_get_or(spec, "classes", "3")
    let T  = spec_get_or(spec, "T", "96")
    let d  = spec_get_or(spec, "d", "24")
    let ep = spec_get_or(spec, "epochs", "60")
    let lr = spec_get_or(spec, "lr", "0.03")
    let mut s = ""
    s = s + "#!/usr/bin/env python3\n"
    s = s + "# tabular dojo kata — torch REFERENCE (NOT the production path)\n"
    s = s + "# slug: " + slug + "  ·  kata: " + kata + "\n"
    s = s + "#\n"
    s = s + "# A side-by-side PyTorch reference for the SAME tabular kata. The\n"
    s = s + "# hexa train.hexa is the production surface (flame substrate, self/\n"
    s = s + "# forge GPU); this torch script is the familiar-framework CONTRAST.\n"
    s = s + "# NOT what ships — the oracle you compare the flame descent against.\n"
    s = s + "import torch\n"
    s = s + "\n"
    s = s + "torch.manual_seed(0)\n"
    s = s + "F, C, T, H, EPOCHS, LR = " + ft + ", " + cl + ", " + T + ", " + d + ", " + ep + ", " + lr + "\n"
    s = s + "lab = torch.arange(T) % C\n"
    s = s + "X = 0.1 * torch.rand(T, F)\n"
    s = s + "for i in range(T):\n"
    s = s + "    for f in range(F):\n"
    s = s + "        if f % C == int(lab[i]): X[i, f] += int(lab[i]) + 1\n"
    if kata == "mlp-tab" {
        s = s + "model = torch.nn.Sequential(torch.nn.Linear(F, H), torch.nn.ReLU(), torch.nn.Linear(H, C))\n"
    } else {
        s = s + "model = torch.nn.Linear(F, C)\n"
    }
    s = s + "opt = torch.optim.AdamW(model.parameters(), lr=LR)\n"
    s = s + "lossfn = torch.nn.CrossEntropyLoss()\n"
    s = s + "for ep in range(EPOCHS):\n"
    s = s + "    opt.zero_grad()\n"
    s = s + "    loss = lossfn(model(X), lab)\n"
    s = s + "    if ep == 0: first = loss.item()\n"
    s = s + "    loss.backward(); opt.step()\n"
    s = s + "print(f'epoch-1 CE={first}  epoch-{EPOCHS} CE={loss.item()}')\n"
    return s
}

// ── run.sh glue + README (emitted-string content only) ───────────────

fn _tab_glue(slug: string, kata: string, spec: DojoSpec) -> string {
    let gate = _tab_gate_id(kata)
    let mut s = ""
    s = s + "#!/usr/bin/env bash\n"
    s = s + "# tabular dojo run glue — generated by stdlib/dojo/tabular\n"
    s = s + "# slug: " + slug + "  ·  kata: " + kata + "\n"
    s = s + "set -euo pipefail\n"
    s = s + "cd \"$(dirname \"$0\")\"\n"
    s = s + "\n"
    s = s + "# local CPU path — the descent-gate kata. Run the self-contained flame\n"
    s = s + "# classifier (CPU farr matmul fallback; a forge-GPU host accelerates\n"
    s = s + "# the SAME code unchanged), then assert the descent gate.\n"
    s = s + "RUN_LOG=\"$PWD/train.$$.log\"\n"
    s = s + "echo \"tabular: hexa run train.hexa\"\n"
    s = s + "hexa run train.hexa 2>&1 | tee \"$RUN_LOG\"\n"
    s = s + "\n"
    s = s + "if grep -q \"F-TABULAR-" + gate + " = 1\" \"$RUN_LOG\"; then\n"
    s = s + "    echo \"GATE F-TABULAR-" + gate + ": GREEN (mean CE descends)\"\n"
    s = s + "else\n"
    s = s + "    echo \"GATE F-TABULAR-" + gate + ": RED (no descent)\" >&2\n"
    s = s + "    exit 1\n"
    s = s + "fi\n"
    return s
}

fn _tab_readme(slug: string, kata: string, spec: DojoSpec) -> string {
    let ft = spec_get_or(spec, "features", "12")
    let cl = spec_get_or(spec, "classes", "3")
    let T  = spec_get_or(spec, "T", "96")
    let ep = spec_get_or(spec, "epochs", "60")
    let lr = spec_get_or(spec, "lr", "0.03")
    let host = spec_get_or(spec, "host", "ubu-1")
    let mut s = ""
    s = s + "# tabular dojo kata — " + slug + " (" + kata + ")\n"
    s = s + "\n"
    s = s + "The **tabular-classifier** arm of the dojo. Each kata is a small,\n"
    s = s + "complete flame classifier over the stdlib/flame substrate (`t_*`\n"
    s = s + "tensor ops, `t_matmul` forge matmul, `opt_adamw_step` optimizer) on a\n"
    s = s + "synthetic (T × F) feature matrix with a deterministic class signal.\n"
    s = s + "Each emits a **descent gate** (mean cross-entropy strictly descends).\n"
    s = s + "\n"
    s = s + "- spec: `features=" + ft + "`  `classes=" + cl + "`  `T=" + T + "`  `epochs=" + ep + "`  `lr=" + lr + "`  `host=" + host + "`\n"
    s = s + "- run: `bash run.sh`  (`hexa run train.hexa` + assert the gate)\n"
    s = s + "\n"
    s = s + "## kata ladder\n"
    s = s + "\n"
    s = s + "| rung | kata | model · loss |\n"
    s = s + "|---|---|---|\n"
    s = s + "| 1 | logreg | `logits = X·W + b` · softmax CE · closed backward |\n"
    s = s + "| 2 | mlp-tab | `relu(X·W1+b1)·W2+b2` · softmax CE · 2-stage backprop |\n"
    s = s + "\n"
    s = s + "## files\n"
    s = s + "\n"
    s = s + "- `train.hexa` — the self-contained flame classifier + descent gate\n"
    s = s + "- `run.sh` — `hexa run train.hexa` + assert `F-TABULAR-" + _tab_gate_id(kata) + "`\n"
    s = s + "- `ref.py` — the torch tabular reference (`--lang=py|both`; NOT production)\n"
    s = s + "\n"
    s = s + "## references\n"
    s = s + "\n"
    s = s + "- `stdlib/flame/` — the flame substrate (`tensor_lib` · `optim_lib`)\n"
    s = s + "- `stdlib/dojo/flame_forge.hexa` — the NN-training sibling arm (linreg/mlp/tiny-clm)\n"
    s = s + "- `docs/hexa-dojo.md` — the dojo tracks + the kata ladders\n"
    return s
}
