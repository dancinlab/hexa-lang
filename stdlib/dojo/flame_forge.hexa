// HEXA Standard Library — dojo/flame_forge
//
// @version 0.1.0
// @capabilities [pure]
//
// FULL flame-forge domain emitter for the dojo generator — the NN-TRAINING
// authoring arm. Where the `llm`/`clm` domains emit CLOUD training jobs, this
// domain emits SMALL, SELF-CONTAINED, REAL flame `.hexa` TRAINERS over the
// stdlib/flame substrate (t_* tensor ops · t_matmul forge matmul · t_fill_lcg
// deterministic init · opt_adamw_step optimizer). Each kata is a complete
// train-loop you read + run end-to-end, emitting a DESCENT gate (loss
// strictly descends), the same discipline as dojo/clm's clm_prod loop.
//
// Emits per kata (kind):
//   train.hexa  — the flame `.hexa` TRAINER: deterministic data, forward,
//                 closed-form backward, optimizer step, a descent gate.
//                 Self-contained — `hexa run train.hexa` on a CPU host
//                 (the forge substrate falls back to the CPU farr matmul;
//                 a forge-GPU host accelerates the same code unchanged).
//   run.sh      — the .sh GLUE: `hexa run train.hexa` + assert the descent gate.
//   README.md   — the kata brief: model · loss · ladder rung.
//
// `--lang` filters the contrast surface (gen.lang_keep):
//   hexa (default) → hexa-only (train.hexa + run.sh + README.md)
//   py             → a torch REFERENCE (clearly NOT-production) — ref.py
//   both           → side-by-side (hexa trainer + torch ref + README)
//
// SPEC schema (flame-forge keys):
//   kata       — linreg | mlp | tiny-clm  (default "linreg")
//   d          — feature / hidden width int (default "16")
//   T          — sequence / sample count int (default "64")
//   epochs     — training epochs int (default "50")
//   lr         — learning rate, pre-formatted string (default "0.01")
//   host       — cloud pool host echo for the README (default "ubu-1")
//   output_dir — staged kata dir echo for the README (default "out")

import "stdlib/dojo/gen.hexa"

pub fn emit_flame_forge(slug: string, spec: DojoSpec, lang: string) -> [DojoFile] {
    let files: [DojoFile] = []
    let kata = _ff_kata(spec)
    if lang_keep(lang, "hexa") {
        dojo_push(files, "train.hexa", _ff_trainer(slug, kata, spec))
    }
    if lang_keep(lang, "py") {
        dojo_push(files, "ref.py", _ff_torch_ref(slug, kata, spec))
    }
    if lang_keep(lang, "sh") {
        dojo_push(files, "run.sh", _ff_glue(slug, kata, spec))
        dojo_push(files, "README.md", _ff_readme(slug, kata, spec))
    }
    return files
}

fn _ff_kata(spec: DojoSpec) -> string {
    let k = spec_get_or(spec, "kata", "linreg")
    if k == "linear" || k == "lin_reg" { return "linreg" }
    if k == "clm" || k == "tinyclm" || k == "tiny_clm" { return "tiny-clm" }
    return k
}

// flame-forge kata ladder — the known rungs, low → high.
pub fn flame_forge_katas() -> [string] {
    return ["linreg", "mlp", "tiny-clm"]
}

// ── train.hexa emit (one flame trainer per kata) ─────────────────────

fn _ff_trainer(slug: string, kata: string, spec: DojoSpec) -> string {
    if kata == "linreg"   { return _ff_t_linreg(slug, spec) }
    if kata == "mlp"      { return _ff_t_mlp(slug, spec) }
    if kata == "tiny-clm" { return _ff_t_tiny_clm(slug, spec) }
    return _ff_t_linreg(slug, spec)
}

fn _ff_head(slug: string, kata: string, spec: DojoSpec) -> string {
    let d  = spec_get_or(spec, "d", "16")
    let T  = spec_get_or(spec, "T", "64")
    let ep = spec_get_or(spec, "epochs", "50")
    let lr = spec_get_or(spec, "lr", "0.01")
    let mut s = ""
    s = s + "// flame-forge dojo kata — generated by stdlib/dojo/flame_forge\n"
    s = s + "// slug: " + slug + "  ·  kata: " + kata + "\n"
    s = s + "//\n"
    s = s + "// A self-contained flame trainer over the stdlib/flame substrate\n"
    s = s + "// (t_* tensor ops · t_matmul forge matmul · t_fill_lcg init ·\n"
    s = s + "// opt_adamw_step optimizer). Runs on a CPU host today (the forge\n"
    s = s + "// matmul falls back to the CPU farr path); a forge-GPU host\n"
    s = s + "// accelerates the SAME code unchanged. Emits a DESCENT gate.\n"
    s = s + "//\n"
    s = s + "// spec: d=" + d + "  T=" + T + "  epochs=" + ep + "  lr=" + lr + "\n"
    s = s + "// run: bash run.sh   (hexa run train.hexa)\n"
    s = s + "\n"
    s = s + "use \"stdlib/flame/tensor_lib\"\n"
    s = s + "use \"stdlib/flame/optim_lib\"\n"
    s = s + "\n"
    return s
}

// rung 1 — linear regression. y = X·w + b, MSE loss, closed-form
// gradient, AdamW step. The floor rung: one matmul forward, the
// closed vjp (dw = Xᵀ·dy / n, db = mean(dy)), a descent gate.
fn _ff_t_linreg(slug: string, spec: DojoSpec) -> string {
    let d  = spec_get_or(spec, "d", "16")
    let T  = spec_get_or(spec, "T", "64")
    let ep = spec_get_or(spec, "epochs", "50")
    let lr = spec_get_or(spec, "lr", "0.01")
    let mut s = _ff_head(slug, "linreg", spec)
    s = s + "fn main() {\n"
    s = s + "    let d = " + d + "       // feature width\n"
    s = s + "    let N = " + T + "       // sample count\n"
    s = s + "    let epochs = " + ep + "\n"
    s = s + "    let lr = " + lr + "\n"
    s = s + "\n"
    s = s + "    // deterministic data: X (N×d), a planted true w (d) + bias, y = X·w_true + b_true\n"
    s = s + "    let X = t_zeros(N * d); t_fill_lcg(X, N * d, 1, 1.0)\n"
    s = s + "    let w_true = t_zeros(d); t_fill_lcg(w_true, d, 2, 1.0)\n"
    s = s + "    let b_true = 0.5\n"
    s = s + "    let y = t_zeros(N)\n"
    s = s + "    let mut i = 0\n"
    s = s + "    while i < N {\n"
    s = s + "        let mut acc = 0.0\n"
    s = s + "        let mut j = 0\n"
    s = s + "        while j < d { acc = acc + t_get(X, i * d + j) * t_get(w_true, j); j = j + 1 }\n"
    s = s + "        t_set(y, i, acc + b_true)\n"
    s = s + "        i = i + 1\n"
    s = s + "    }\n"
    s = s + "\n"
    s = s + "    // params (init away from the solution) + AdamW state\n"
    s = s + "    let w = t_zeros(d); t_fill_lcg(w, d, 7, 0.1)\n"
    s = s + "    let b = t_zeros(1)\n"
    s = s + "    let gw = t_zeros(d); let gb = t_zeros(1)\n"
    s = s + "    let mw = t_zeros(d); let vw = t_zeros(d)\n"
    s = s + "    let mb = t_zeros(1); let vb = t_zeros(1)\n"
    s = s + "\n"
    s = s + "    let mut first_loss = 0.0\n"
    s = s + "    let mut last_loss = 0.0\n"
    s = s + "    let mut ep = 1\n"
    s = s + "    while ep <= epochs {\n"
    s = s + "        // forward: yhat = X·w + b ; residual r = yhat - y ; MSE = mean(r²)\n"
    s = s + "        let yhat = t_matmul(X, N, d, w, 1)   // (N×d)·(d×1) → (N×1)\n"
    s = s + "        let mut loss = 0.0\n"
    s = s + "        let resid = t_zeros(N)\n"
    s = s + "        let mut ii = 0\n"
    s = s + "        while ii < N {\n"
    s = s + "            let r = t_get(yhat, ii) + t_get(b, 0) - t_get(y, ii)\n"
    s = s + "            t_set(resid, ii, r)\n"
    s = s + "            loss = loss + r * r\n"
    s = s + "            ii = ii + 1\n"
    s = s + "        }\n"
    s = s + "        loss = loss / to_float(N)\n"
    s = s + "        if ep == 1 { first_loss = loss }\n"
    s = s + "        last_loss = loss\n"
    s = s + "\n"
    s = s + "        // closed gradient: dw[j] = (2/N) Σ_i r_i·X[i,j] ; db = (2/N) Σ_i r_i\n"
    s = s + "        let mut jj = 0\n"
    s = s + "        while jj < d {\n"
    s = s + "            let mut g = 0.0\n"
    s = s + "            let mut k = 0\n"
    s = s + "            while k < N { g = g + t_get(resid, k) * t_get(X, k * d + jj); k = k + 1 }\n"
    s = s + "            t_set(gw, jj, (2.0 / to_float(N)) * g)\n"
    s = s + "            jj = jj + 1\n"
    s = s + "        }\n"
    s = s + "        let mut gbacc = 0.0\n"
    s = s + "        let mut k2 = 0\n"
    s = s + "        while k2 < N { gbacc = gbacc + t_get(resid, k2); k2 = k2 + 1 }\n"
    s = s + "        t_set(gb, 0, (2.0 / to_float(N)) * gbacc)\n"
    s = s + "\n"
    s = s + "        // AdamW step (forge optimizer; eq to ag_adamw_step builtin)\n"
    s = s + "        opt_adamw_step(w, gw, mw, vw, d, lr, 0.9, 0.999, 0.00000001, 0.0, ep)\n"
    s = s + "        opt_adamw_step(b, gb, mb, vb, 1, lr, 0.9, 0.999, 0.00000001, 0.0, ep)\n"
    s = s + "        t_free(yhat); t_free(resid)\n"
    s = s + "        ep = ep + 1\n"
    s = s + "    }\n"
    s = s + "    print(\"  epoch-1 MSE   = \"); println(to_string(first_loss))\n"
    s = s + "    print(\"  epoch-\"); print(epochs); print(\" MSE = \"); println(to_string(last_loss))\n"
    s = s + _ff_gate_tail("LINREG")
    s = s + "}\n"
    return s
}

// rung 2 — 2-layer MLP regression. h = relu(X·W1 + b1) ; yhat = h·W2 + b2.
// MSE loss, full backprop through the relu, AdamW. Exercises the hidden
// layer + nonlinearity + a 2-stage closed backward.
fn _ff_t_mlp(slug: string, spec: DojoSpec) -> string {
    let d  = spec_get_or(spec, "d", "16")
    let T  = spec_get_or(spec, "T", "64")
    let ep = spec_get_or(spec, "epochs", "50")
    let lr = spec_get_or(spec, "lr", "0.01")
    let mut s = _ff_head(slug, "mlp", spec)
    s = s + "// relu(x) = max(x, 0) elementwise.\n"
    s = s + "fn _relu(z: int, out: int, n: int) {\n"
    s = s + "    let mut i = 0\n"
    s = s + "    while i < n {\n"
    s = s + "        let v = t_get(z, i)\n"
    s = s + "        t_set(out, i, if v > 0.0 { v } else { 0.0 })\n"
    s = s + "        i = i + 1\n"
    s = s + "    }\n"
    s = s + "}\n"
    s = s + "\n"
    s = s + "fn main() {\n"
    s = s + "    let d = " + d + "       // input + hidden width\n"
    s = s + "    let h = " + d + "       // hidden width (= d for this kata)\n"
    s = s + "    let N = " + T + "       // sample count\n"
    s = s + "    let epochs = " + ep + "\n"
    s = s + "    let lr = " + lr + "\n"
    s = s + "\n"
    s = s + "    // deterministic data: X (N×d), planted nonlinear target\n"
    s = s + "    let X = t_zeros(N * d); t_fill_lcg(X, N * d, 1, 1.0)\n"
    s = s + "    let y = t_zeros(N)\n"
    s = s + "    let mut i = 0\n"
    s = s + "    while i < N {\n"
    s = s + "        let mut acc = 0.0\n"
    s = s + "        let mut j = 0\n"
    s = s + "        while j < d {\n"
    s = s + "            let xv = t_get(X, i * d + j)\n"
    s = s + "            acc = acc + (if xv > 0.0 { xv } else { 0.0 })\n"
    s = s + "            j = j + 1\n"
    s = s + "        }\n"
    s = s + "        t_set(y, i, acc)\n"
    s = s + "        i = i + 1\n"
    s = s + "    }\n"
    s = s + "\n"
    s = s + "    // params: W1 (d×h), b1 (h), W2 (h×1), b2 (1)\n"
    s = s + "    let W1 = t_zeros(d * h); t_fill_lcg(W1, d * h, 7, 0.2)\n"
    s = s + "    let b1 = t_zeros(h)\n"
    s = s + "    let W2 = t_zeros(h * 1); t_fill_lcg(W2, h, 8, 0.2)\n"
    s = s + "    let b2 = t_zeros(1)\n"
    s = s + "    let gW1 = t_zeros(d * h); let gb1 = t_zeros(h)\n"
    s = s + "    let gW2 = t_zeros(h * 1); let gb2 = t_zeros(1)\n"
    s = s + "    let mW1 = t_zeros(d * h); let vW1 = t_zeros(d * h)\n"
    s = s + "    let mb1 = t_zeros(h); let vb1 = t_zeros(h)\n"
    s = s + "    let mW2 = t_zeros(h * 1); let vW2 = t_zeros(h * 1)\n"
    s = s + "    let mb2 = t_zeros(1); let vb2 = t_zeros(1)\n"
    s = s + "\n"
    s = s + "    let pre = t_zeros(N * h)    // X·W1 + b1\n"
    s = s + "    let act = t_zeros(N * h)    // relu(pre)\n"
    s = s + "    let dpre = t_zeros(N * h)\n"
    s = s + "    let resid = t_zeros(N)\n"
    s = s + "\n"
    s = s + "    let mut first_loss = 0.0\n"
    s = s + "    let mut last_loss = 0.0\n"
    s = s + "    let mut ep = 1\n"
    s = s + "    while ep <= epochs {\n"
    s = s + "        // forward layer 1: pre = X·W1 + b1 ; act = relu(pre)\n"
    s = s + "        let xw1 = t_matmul(X, N, d, W1, h)\n"
    s = s + "        let mut r = 0\n"
    s = s + "        while r < N {\n"
    s = s + "            let mut c = 0\n"
    s = s + "            while c < h {\n"
    s = s + "                t_set(pre, r * h + c, t_get(xw1, r * h + c) + t_get(b1, c))\n"
    s = s + "                c = c + 1\n"
    s = s + "            }\n"
    s = s + "            r = r + 1\n"
    s = s + "        }\n"
    s = s + "        _relu(pre, act, N * h)\n"
    s = s + "        // forward layer 2: yhat = act·W2 + b2\n"
    s = s + "        let aw2 = t_matmul(act, N, h, W2, 1)\n"
    s = s + "        let mut loss = 0.0\n"
    s = s + "        let mut ii = 0\n"
    s = s + "        while ii < N {\n"
    s = s + "            let rr = t_get(aw2, ii) + t_get(b2, 0) - t_get(y, ii)\n"
    s = s + "            t_set(resid, ii, rr)\n"
    s = s + "            loss = loss + rr * rr\n"
    s = s + "            ii = ii + 1\n"
    s = s + "        }\n"
    s = s + "        loss = loss / to_float(N)\n"
    s = s + "        if ep == 1 { first_loss = loss }\n"
    s = s + "        last_loss = loss\n"
    s = s + "\n"
    s = s + "        // backward layer 2: dyhat = (2/N)·resid\n"
    s = s + "        //   gW2[c] = Σ_i act[i,c]·dyhat_i ; gb2 = Σ_i dyhat_i\n"
    s = s + "        let scale = 2.0 / to_float(N)\n"
    s = s + "        let mut c2 = 0\n"
    s = s + "        while c2 < h {\n"
    s = s + "            let mut g = 0.0\n"
    s = s + "            let mut k = 0\n"
    s = s + "            while k < N { g = g + t_get(act, k * h + c2) * scale * t_get(resid, k); k = k + 1 }\n"
    s = s + "            t_set(gW2, c2, g)\n"
    s = s + "            c2 = c2 + 1\n"
    s = s + "        }\n"
    s = s + "        let mut gb2acc = 0.0\n"
    s = s + "        let mut kb = 0\n"
    s = s + "        while kb < N { gb2acc = gb2acc + scale * t_get(resid, kb); kb = kb + 1 }\n"
    s = s + "        t_set(gb2, 0, gb2acc)\n"
    s = s + "\n"
    s = s + "        // backward into hidden: dact[i,c] = dyhat_i·W2[c] ; dpre = dact·relu'(pre)\n"
    s = s + "        let mut ri = 0\n"
    s = s + "        while ri < N {\n"
    s = s + "            let mut ci = 0\n"
    s = s + "            while ci < h {\n"
    s = s + "                let dact = scale * t_get(resid, ri) * t_get(W2, ci)\n"
    s = s + "                let grad = if t_get(pre, ri * h + ci) > 0.0 { dact } else { 0.0 }\n"
    s = s + "                t_set(dpre, ri * h + ci, grad)\n"
    s = s + "                ci = ci + 1\n"
    s = s + "            }\n"
    s = s + "            ri = ri + 1\n"
    s = s + "        }\n"
    s = s + "        // gW1[j,c] = Σ_i X[i,j]·dpre[i,c] ; gb1[c] = Σ_i dpre[i,c]\n"
    s = s + "        let mut j1 = 0\n"
    s = s + "        while j1 < d {\n"
    s = s + "            let mut c1 = 0\n"
    s = s + "            while c1 < h {\n"
    s = s + "                let mut g = 0.0\n"
    s = s + "                let mut k = 0\n"
    s = s + "                while k < N { g = g + t_get(X, k * d + j1) * t_get(dpre, k * h + c1); k = k + 1 }\n"
    s = s + "                t_set(gW1, j1 * h + c1, g)\n"
    s = s + "                c1 = c1 + 1\n"
    s = s + "            }\n"
    s = s + "            j1 = j1 + 1\n"
    s = s + "        }\n"
    s = s + "        let mut cb = 0\n"
    s = s + "        while cb < h {\n"
    s = s + "            let mut g = 0.0\n"
    s = s + "            let mut k = 0\n"
    s = s + "            while k < N { g = g + t_get(dpre, k * h + cb); k = k + 1 }\n"
    s = s + "            t_set(gb1, cb, g)\n"
    s = s + "            cb = cb + 1\n"
    s = s + "        }\n"
    s = s + "\n"
    s = s + "        opt_adamw_step(W1, gW1, mW1, vW1, d * h, lr, 0.9, 0.999, 0.00000001, 0.0, ep)\n"
    s = s + "        opt_adamw_step(b1, gb1, mb1, vb1, h, lr, 0.9, 0.999, 0.00000001, 0.0, ep)\n"
    s = s + "        opt_adamw_step(W2, gW2, mW2, vW2, h, lr, 0.9, 0.999, 0.00000001, 0.0, ep)\n"
    s = s + "        opt_adamw_step(b2, gb2, mb2, vb2, 1, lr, 0.9, 0.999, 0.00000001, 0.0, ep)\n"
    s = s + "        t_free(xw1); t_free(aw2)\n"
    s = s + "        ep = ep + 1\n"
    s = s + "    }\n"
    s = s + "    print(\"  epoch-1 MSE   = \"); println(to_string(first_loss))\n"
    s = s + "    print(\"  epoch-\"); print(epochs); print(\" MSE = \"); println(to_string(last_loss))\n"
    s = s + _ff_gate_tail("MLP")
    s = s + "}\n"
    return s
}

// rung 3 — tiny causal LM (byte-vocab embedding + linear head, mean CE).
// A minimal next-token loop: embed a byte id → linear logits over a small
// vocab → softmax CE, full closed backward through the head + embedding,
// AdamW. The bridge toward the full dojo/clm CLMConvMoE trainer.
fn _ff_t_tiny_clm(slug: string, spec: DojoSpec) -> string {
    let d  = spec_get_or(spec, "d", "16")
    let T  = spec_get_or(spec, "T", "64")
    let ep = spec_get_or(spec, "epochs", "50")
    let lr = spec_get_or(spec, "lr", "0.01")
    let mut s = _ff_head(slug, "tiny-clm", spec)
    s = s + "fn main() {\n"
    s = s + "    let d = " + d + "       // embedding width\n"
    s = s + "    let V = 16             // tiny byte-vocab (ids 0..15)\n"
    s = s + "    let T = " + T + "       // sequence length\n"
    s = s + "    let epochs = " + ep + "\n"
    s = s + "    let lr = " + lr + "\n"
    s = s + "\n"
    s = s + "    // deterministic toy corpus: ids[t] in 0..V, target = next id (cyclic)\n"
    s = s + "    let ids = t_zeros(T); let tgt = t_zeros(T)\n"
    s = s + "    let mut i = 0\n"
    s = s + "    while i < T {\n"
    s = s + "        let id = i % V\n"
    s = s + "        t_set(ids, i, to_float(id))\n"
    s = s + "        t_set(tgt, i, to_float((id + 1) % V))\n"
    s = s + "        i = i + 1\n"
    s = s + "    }\n"
    s = s + "\n"
    s = s + "    // params: embed (V×d), head W (d×V), head b (V)\n"
    s = s + "    let embed = t_zeros(V * d); t_fill_lcg(embed, V * d, 1, 0.3)\n"
    s = s + "    let hW = t_zeros(d * V); t_fill_lcg(hW, d * V, 2, 0.2)\n"
    s = s + "    let hB = t_zeros(V)\n"
    s = s + "    let dembed = t_zeros(V * d); let dhW = t_zeros(d * V); let dhB = t_zeros(V)\n"
    s = s + "    let m_e = t_zeros(V * d); let v_e = t_zeros(V * d)\n"
    s = s + "    let m_hW = t_zeros(d * V); let v_hW = t_zeros(d * V)\n"
    s = s + "    let m_hB = t_zeros(V); let v_hB = t_zeros(V)\n"
    s = s + "    let logits = t_zeros(V); let probs = t_zeros(V)\n"
    s = s + "\n"
    s = s + "    let mut first_ce = 0.0\n"
    s = s + "    let mut last_ce = 0.0\n"
    s = s + "    let mut ep = 1\n"
    s = s + "    while ep <= epochs {\n"
    s = s + "        // zero grads\n"
    s = s + "        let mut z = 0\n"
    s = s + "        while z < V * d { t_set(dembed, z, 0.0); z = z + 1 }\n"
    s = s + "        let mut z2 = 0\n"
    s = s + "        while z2 < d * V { t_set(dhW, z2, 0.0); z2 = z2 + 1 }\n"
    s = s + "        let mut z3 = 0\n"
    s = s + "        while z3 < V { t_set(dhB, z3, 0.0); z3 = z3 + 1 }\n"
    s = s + "        let mut ce_sum = 0.0\n"
    s = s + "\n"
    s = s + "        let mut t = 0\n"
    s = s + "        while t < T {\n"
    s = s + "            let id = to_int(t_get(ids, t))\n"
    s = s + "            let tg = to_int(t_get(tgt, t))\n"
    s = s + "            // logits[c] = Σ_k embed[id,k]·hW[k,c] + hB[c]\n"
    s = s + "            let mut c = 0\n"
    s = s + "            while c < V {\n"
    s = s + "                let mut acc = 0.0\n"
    s = s + "                let mut k = 0\n"
    s = s + "                while k < d { acc = acc + t_get(embed, id * d + k) * t_get(hW, k * V + c); k = k + 1 }\n"
    s = s + "                t_set(logits, c, acc + t_get(hB, c))\n"
    s = s + "                c = c + 1\n"
    s = s + "            }\n"
    s = s + "            // softmax (numerically stable)\n"
    s = s + "            let mut mx = t_get(logits, 0)\n"
    s = s + "            let mut c2 = 1\n"
    s = s + "            while c2 < V { if t_get(logits, c2) > mx { mx = t_get(logits, c2) } c2 = c2 + 1 }\n"
    s = s + "            let mut Z = 0.0\n"
    s = s + "            let mut c3 = 0\n"
    s = s + "            while c3 < V { let e = exp(t_get(logits, c3) - mx); t_set(probs, c3, e); Z = Z + e; c3 = c3 + 1 }\n"
    s = s + "            let mut c4 = 0\n"
    s = s + "            while c4 < V { t_set(probs, c4, t_get(probs, c4) / Z); c4 = c4 + 1 }\n"
    s = s + "            ce_sum = ce_sum - log(t_get(probs, tg) + 0.00000001)\n"
    s = s + "            // dlogits = probs - onehot(tg)\n"
    s = s + "            // grads: dhW[k,c] += embed[id,k]·dlogit_c ; dhB[c] += dlogit_c\n"
    s = s + "            //        dembed[id,k] += Σ_c dlogit_c·hW[k,c]\n"
    s = s + "            let mut c5 = 0\n"
    s = s + "            while c5 < V {\n"
    s = s + "                let dl = t_get(probs, c5) - (if c5 == tg { 1.0 } else { 0.0 })\n"
    s = s + "                t_set(dhB, c5, t_get(dhB, c5) + dl)\n"
    s = s + "                let mut k = 0\n"
    s = s + "                while k < d {\n"
    s = s + "                    t_set(dhW, k * V + c5, t_get(dhW, k * V + c5) + t_get(embed, id * d + k) * dl)\n"
    s = s + "                    t_set(dembed, id * d + k, t_get(dembed, id * d + k) + dl * t_get(hW, k * V + c5))\n"
    s = s + "                    k = k + 1\n"
    s = s + "                }\n"
    s = s + "                c5 = c5 + 1\n"
    s = s + "            }\n"
    s = s + "            t = t + 1\n"
    s = s + "        }\n"
    s = s + "        let ce = ce_sum / to_float(T)\n"
    s = s + "        if ep == 1 { first_ce = ce }\n"
    s = s + "        last_ce = ce\n"
    s = s + "\n"
    s = s + "        opt_adamw_step(embed, dembed, m_e, v_e, V * d, lr, 0.9, 0.999, 0.00000001, 0.0, ep)\n"
    s = s + "        opt_adamw_step(hW, dhW, m_hW, v_hW, d * V, lr, 0.9, 0.999, 0.00000001, 0.0, ep)\n"
    s = s + "        opt_adamw_step(hB, dhB, m_hB, v_hB, V, lr, 0.9, 0.999, 0.00000001, 0.0, ep)\n"
    s = s + "        ep = ep + 1\n"
    s = s + "    }\n"
    s = s + "    print(\"  epoch-1 mean CE   = \"); println(to_string(first_ce))\n"
    s = s + "    print(\"  epoch-\"); print(epochs); print(\" mean CE = \"); println(to_string(last_ce))\n"
    s = s + _ff_gate_tail2("TINYCLM", "first_ce", "last_ce")
    s = s + "}\n"
    return s
}

// shared descent-gate tail for the MSE katas (first_loss / last_loss).
fn _ff_gate_tail(gate: string) -> string {
    return _ff_gate_tail2(gate, "first_loss", "last_loss")
}

fn _ff_gate_tail2(gate: string, first: string, last: string) -> string {
    let mut s = ""
    s = s + "    if " + last + " < " + first + " {\n"
    s = s + "        println(\"F-FLAMEFORGE-" + gate + " = 1\")\n"
    s = s + "        println(\"PASS — loss strictly descends over training\")\n"
    s = s + "        return\n"
    s = s + "    }\n"
    s = s + "    println(\"F-FLAMEFORGE-" + gate + " = 0\")\n"
    s = s + "    println(\"FAIL — loss did not descend\")\n"
    return s
}

// ── torch reference (--lang=py | both) — emitted-string content only ──

fn _ff_torch_ref(slug: string, kata: string, spec: DojoSpec) -> string {
    let d  = spec_get_or(spec, "d", "16")
    let T  = spec_get_or(spec, "T", "64")
    let ep = spec_get_or(spec, "epochs", "50")
    let lr = spec_get_or(spec, "lr", "0.01")
    let mut s = ""
    s = s + "#!/usr/bin/env python3\n"
    s = s + "# flame-forge dojo kata — torch REFERENCE (NOT the production path)\n"
    s = s + "# slug: " + slug + "  ·  kata: " + kata + "\n"
    s = s + "#\n"
    s = s + "# A side-by-side PyTorch reference for the SAME kata. The hexa\n"
    s = s + "# train.hexa is the production surface (flame substrate, self/forge\n"
    s = s + "# GPU); this torch script is the familiar-framework CONTRAST that\n"
    s = s + "# motivates the kata. It is NOT what ships — it is the oracle you\n"
    s = s + "# compare the flame descent against.\n"
    s = s + "import torch\n"
    s = s + "\n"
    s = s + "torch.manual_seed(0)\n"
    s = s + "d, N, EPOCHS, LR = " + d + ", " + T + ", " + ep + ", " + lr + "\n"
    s = s + "\n"
    if kata == "mlp" {
        s = s + "X = torch.randn(N, d)\n"
        s = s + "y = X.clamp(min=0).sum(dim=1, keepdim=True)\n"
        s = s + "model = torch.nn.Sequential(torch.nn.Linear(d, d), torch.nn.ReLU(), torch.nn.Linear(d, 1))\n"
        s = s + "opt = torch.optim.AdamW(model.parameters(), lr=LR)\n"
        s = s + "for ep in range(EPOCHS):\n"
        s = s + "    opt.zero_grad()\n"
        s = s + "    loss = ((model(X) - y) ** 2).mean()\n"
        s = s + "    if ep == 0: first = loss.item()\n"
        s = s + "    loss.backward(); opt.step()\n"
        s = s + "print(f'epoch-1 MSE={first}  epoch-{EPOCHS} MSE={loss.item()}')\n"
    } else if kata == "tiny-clm" {
        s = s + "V = 16\n"
        s = s + "ids = torch.arange(N) % V\n"
        s = s + "tgt = (ids + 1) % V\n"
        s = s + "embed = torch.nn.Embedding(V, d)\n"
        s = s + "head = torch.nn.Linear(d, V)\n"
        s = s + "opt = torch.optim.AdamW(list(embed.parameters()) + list(head.parameters()), lr=LR)\n"
        s = s + "lossfn = torch.nn.CrossEntropyLoss()\n"
        s = s + "for ep in range(EPOCHS):\n"
        s = s + "    opt.zero_grad()\n"
        s = s + "    loss = lossfn(head(embed(ids)), tgt)\n"
        s = s + "    if ep == 0: first = loss.item()\n"
        s = s + "    loss.backward(); opt.step()\n"
        s = s + "print(f'epoch-1 CE={first}  epoch-{EPOCHS} CE={loss.item()}')\n"
    } else {
        s = s + "w_true = torch.randn(d, 1); b_true = 0.5\n"
        s = s + "X = torch.randn(N, d)\n"
        s = s + "y = X @ w_true + b_true\n"
        s = s + "model = torch.nn.Linear(d, 1)\n"
        s = s + "opt = torch.optim.AdamW(model.parameters(), lr=LR)\n"
        s = s + "for ep in range(EPOCHS):\n"
        s = s + "    opt.zero_grad()\n"
        s = s + "    loss = ((model(X) - y) ** 2).mean()\n"
        s = s + "    if ep == 0: first = loss.item()\n"
        s = s + "    loss.backward(); opt.step()\n"
        s = s + "print(f'epoch-1 MSE={first}  epoch-{EPOCHS} MSE={loss.item()}')\n"
    }
    return s
}

// ── run.sh glue + README (emitted-string content only) ───────────────

fn _ff_glue(slug: string, kata: string, spec: DojoSpec) -> string {
    let gate = _ff_gate_id(kata)
    let mut s = ""
    s = s + "#!/usr/bin/env bash\n"
    s = s + "# flame-forge dojo run glue — generated by stdlib/dojo/flame_forge\n"
    s = s + "# slug: " + slug + "  ·  kata: " + kata + "\n"
    s = s + "set -euo pipefail\n"
    s = s + "cd \"$(dirname \"$0\")\"\n"
    s = s + "\n"
    s = s + "# Run the self-contained flame trainer on this host (CPU farr matmul\n"
    s = s + "# fallback; a forge-GPU host accelerates the SAME code unchanged),\n"
    s = s + "# then assert the descent gate. Machine-independent $0 gate.\n"
    s = s + "RUN_LOG=\"$PWD/train.$$.log\"\n"
    s = s + "echo \"flame-forge: hexa run train.hexa\"\n"
    s = s + "hexa run train.hexa 2>&1 | tee \"$RUN_LOG\"\n"
    s = s + "\n"
    s = s + "if grep -q \"F-FLAMEFORGE-" + gate + " = 1\" \"$RUN_LOG\"; then\n"
    s = s + "    echo \"GATE F-FLAMEFORGE-" + gate + ": GREEN (loss descends)\"\n"
    s = s + "else\n"
    s = s + "    echo \"GATE F-FLAMEFORGE-" + gate + ": RED (no descent)\" >&2\n"
    s = s + "    exit 1\n"
    s = s + "fi\n"
    return s
}

fn _ff_gate_id(kata: string) -> string {
    if kata == "mlp" { return "MLP" }
    if kata == "tiny-clm" { return "TINYCLM" }
    return "LINREG"
}

fn _ff_readme(slug: string, kata: string, spec: DojoSpec) -> string {
    let d  = spec_get_or(spec, "d", "16")
    let T  = spec_get_or(spec, "T", "64")
    let ep = spec_get_or(spec, "epochs", "50")
    let lr = spec_get_or(spec, "lr", "0.01")
    let host = spec_get_or(spec, "host", "ubu-1")
    let mut s = ""
    s = s + "# flame-forge dojo kata — " + slug + " (" + kata + ")\n"
    s = s + "\n"
    s = s + "The **NN-training** arm of the dojo. Each kata is a small, complete\n"
    s = s + "flame trainer over the stdlib/flame substrate (`t_*` tensor ops,\n"
    s = s + "`t_matmul` forge matmul, `opt_adamw_step` optimizer) you read + run\n"
    s = s + "end-to-end. Each emits a **descent gate** (loss strictly descends).\n"
    s = s + "\n"
    s = s + "- spec: `d=" + d + "`  `T=" + T + "`  `epochs=" + ep + "`  `lr=" + lr + "`  `host=" + host + "`\n"
    s = s + "- run: `bash run.sh`  (`hexa run train.hexa` + assert the gate)\n"
    s = s + "\n"
    s = s + "## kata ladder\n"
    s = s + "\n"
    s = s + "| rung | kata | model · loss |\n"
    s = s + "|---|---|---|\n"
    s = s + "| 1 | linreg | `y = X·w + b` · MSE · closed gradient |\n"
    s = s + "| 2 | mlp | `relu(X·W1+b1)·W2+b2` · MSE · 2-stage backprop |\n"
    s = s + "| 3 | tiny-clm | byte-vocab embed + linear head · mean CE · softmax backward |\n"
    s = s + "\n"
    s = s + "## this kata: " + kata + "\n"
    s = s + "\n"
    s = s + _ff_readme_body(kata)
    s = s + "\n"
    s = s + "## files\n"
    s = s + "\n"
    s = s + "- `train.hexa` — the self-contained flame trainer + descent gate\n"
    s = s + "- `run.sh` — `hexa run train.hexa` + assert `F-FLAMEFORGE-" + _ff_gate_id(kata) + "`\n"
    s = s + "- `ref.py` — the torch REFERENCE contrast (emitted with `--lang=py|both`; NOT production)\n"
    s = s + "\n"
    s = s + "## references\n"
    s = s + "\n"
    s = s + "- `stdlib/flame/` — the flame substrate (`tensor_lib` · `nn_lib` · `optim_lib` · `ag_tape`)\n"
    s = s + "- `stdlib/dojo/clm.hexa` — the full CLMConvMoE cloud trainer this ladder bridges toward\n"
    s = s + "- `docs/hexa-dojo.md` — the two dojo tracks + the kata ladder\n"
    return s
}

fn _ff_readme_body(kata: string) -> string {
    if kata == "linreg" {
        return "Linear regression `y = X·w + b` against a planted true `w`/bias.\nForward is one `t_matmul`; the closed gradient is `dw = (2/N)·Xᵀ·r`,\n`db = (2/N)·Σ r` (r = residual). One `opt_adamw_step` per param. The\nfloor rung — a single matmul + the closed vjp + the descent gate.\n"
    }
    if kata == "mlp" {
        return "A 2-layer MLP `h = relu(X·W1 + b1)`, `yhat = h·W2 + b2`, MSE loss.\nFull backprop: the layer-2 vjp, then `relu'` masking into the hidden\ngradient, then the layer-1 vjp. Four `opt_adamw_step` updates. Adds\nthe hidden layer + the nonlinearity over the linreg rung.\n"
    }
    if kata == "tiny-clm" {
        return "A minimal causal LM: a byte-vocab embedding → a linear head →\nsoftmax cross-entropy on next-token prediction. Closed softmax-CE\nbackward (`dlogits = probs - onehot`) scatters into the head + the\nembedding row. The bridge toward the full `dojo/clm` CLMConvMoE\ntrainer — same descent discipline, a fraction of the model.\n"
    }
    return "linreg floor rung.\n"
}
