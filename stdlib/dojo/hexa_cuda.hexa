// HEXA Standard Library — dojo/hexa_cuda
//
// @version 0.1.0
// @capabilities [pure]
//
// FULL hexa-cuda domain emitter for the dojo generator — the LEARN-BY-DOING
// arm of HEXA-CUDA. Where the `llm`/`clm` domains emit CLOUD TRAINING jobs,
// this domain emits @gpu_kernel AUTHORING KATAS: a small, self-contained,
// REAL-COMPILING `.hexa` kernel + host gpu_launch driver + run.sh + README,
// one per kata rung of the @gpu kernel ladder.
//
// The emitted kernels use ONLY the verified @gpu intrinsics from gpu/SPEC.md
// §5/§6 (gpu_thread_id_x / gpu_block_id_x / gpu_block_dim_x / gpu_barrier /
// @shared let / gpu_atomic_add / gpu_warp_shuffle / gpu_wmma_*) and mirror
// the in-tree reference kernels at gpu/tests/{vec_add,gemm}.hexa + the
// qforge nvptx_*_kernel.hexa family. NO invented intrinsics — every name is
// pattern-matched at NVPTX codegen (compiler/codegen/nvptx_target.hexa).
//
// Emits per kata (kind):
//   kernel.hexa  — the .hexa @gpu_kernel + a CPU reference oracle + a host
//                  main() with the gpu_launch call shape (gpu/SPEC.md §7).
//                  Parse-clean today (`hexa parse kernel.hexa`); the MIR
//                  partition that routes @gpu_* to NVPTX codegen + the
//                  gpu_launch lowering land via RFC 055-P3 / the build.
//   run.sh       — the .sh GLUE: `hexa build --target=nvptx kernel.hexa`
//                  (kernel → PTX), with a parse-only smoke as the $0 gate.
//   README.md    — the kata brief: goal · intrinsics exercised · ladder rung.
//
// `--lang` filters the contrast surface (gen.lang_keep):
//   hexa (default) → hexa-only (kernel.hexa + run.sh + README.md)
//   py             → the .cu + ctypes CUDA contrast (kernel.cu + driver.py)
//   both           → side-by-side (hexa kernel + .cu contrast + README)
//
// SPEC schema (hexa-cuda keys):
//   kata       — vec-add | reduction | tiled-gemm | wmma  (default "vec-add")
//   n          — problem size int (default "1024")
//   dtype      — f32 | f64 | tf32  (default "f64" — the FP64-first slice)
//   sm         — sm_90 | sm_90a    (default "sm_90")
//   output_dir — staged kata dir echo for the README (default "out")

import "stdlib/dojo/gen.hexa"

pub fn emit_hexa_cuda(slug: string, spec: DojoSpec, lang: string) -> [DojoFile] {
    let files: [DojoFile] = []
    let kata = _hc_kata(spec)
    if lang_keep(lang, "hexa") {
        dojo_push(files, "kernel.hexa", _hc_kernel(slug, kata, spec))
    }
    if lang_keep(lang, "py") {
        dojo_push(files, "kernel.cu", _hc_cu(slug, kata, spec))
        dojo_push(files, "driver.py", _hc_py(slug, kata, spec))
    }
    if lang_keep(lang, "sh") {
        dojo_push(files, "run.sh", _hc_glue(slug, kata, spec))
        dojo_push(files, "README.md", _hc_readme(slug, kata, spec))
    }
    return files
}

// kata-name canonicaliser — the slug arg already names the kata, but the
// spec `kata` key wins if present (g20 parameterize). Accepts the three
// common spellings of vec-add for ergonomics.
fn _hc_kata(spec: DojoSpec) -> string {
    let k = spec_get_or(spec, "kata", "vec-add")
    if k == "vecadd" || k == "vec_add" { return "vec-add" }
    if k == "gemm" || k == "tiled_gemm" { return "tiled-gemm" }
    return k
}

// hexa-cuda kata ladder — the known rungs, low → high.
pub fn hexa_cuda_katas() -> [string] {
    return ["vec-add", "reduction", "tiled-gemm", "wmma"]
}

// ── kernel.hexa emit (one @gpu_kernel per kata) ──────────────────────

fn _hc_kernel(slug: string, kata: string, spec: DojoSpec) -> string {
    if kata == "vec-add"   { return _hc_k_vecadd(slug, spec) }
    if kata == "reduction" { return _hc_k_reduction(slug, spec) }
    if kata == "tiled-gemm" { return _hc_k_tiled_gemm(slug, spec) }
    if kata == "wmma"      { return _hc_k_wmma(slug, spec) }
    // unknown kata → vec-add (the ladder floor)
    return _hc_k_vecadd(slug, spec)
}

// shared kernel-file header.
fn _hc_kernel_head(slug: string, kata: string, spec: DojoSpec) -> string {
    let n     = spec_get_or(spec, "n", "1024")
    let dtype = spec_get_or(spec, "dtype", "f64")
    let sm    = spec_get_or(spec, "sm", "sm_90")
    let mut s = ""
    s = s + "// hexa-cuda dojo kata — generated by stdlib/dojo/hexa_cuda\n"
    s = s + "// slug: " + slug + "  ·  kata: " + kata + "\n"
    s = s + "//\n"
    s = s + "// @version 0.0.1\n"
    s = s + "// @capabilities [pure]\n"
    s = s + "// @phase(\"parse_only\")\n"
    s = s + "//\n"
    s = s + "// A self-contained @gpu_kernel authoring kata: the device kernel, a\n"
    s = s + "// CPU reference oracle, and the host gpu_launch call shape\n"
    s = s + "// (gpu/SPEC.md §7). Parse-clean today — `hexa parse kernel.hexa`.\n"
    s = s + "// Intrinsics are the verified gpu/SPEC.md §5/§6 set ONLY.\n"
    s = s + "//\n"
    s = s + "// spec: n=" + n + "  dtype=" + dtype + "  sm=" + sm + "\n"
    s = s + "// build: bash run.sh   (hexa build --target=nvptx kernel.hexa)\n"
    s = s + "\n"
    return s
}

// rung 1 — vec-add. c[i] = a[i] + b[i]. Flat 1-D thread index, the
// canonical RFC 055-P1 shape (mirrors gpu/tests/vec_add.hexa).
fn _hc_k_vecadd(slug: string, spec: DojoSpec) -> string {
    let n = spec_get_or(spec, "n", "1024")
    let mut s = _hc_kernel_head(slug, "vec-add", spec)
    s = s + "// ── kernel — flat 1-D thread index (gpu/SPEC.md §5) ──────────────────\n"
    s = s + "@gpu_kernel\n"
    s = s + "fn vadd(a: [f64], b: [f64], c: [f64], n: i64) {\n"
    s = s + "    let gid = gpu_block_id_x() * gpu_block_dim_x() + gpu_thread_id_x()\n"
    s = s + "    if to_i64(gid) < n {\n"
    s = s + "        c[to_i64(gid)] = a[to_i64(gid)] + b[to_i64(gid)]\n"
    s = s + "    }\n"
    s = s + "}\n"
    s = s + "\n"
    s = s + "// ── CPU reference oracle (byte-eq — FP64 add is exact) ───────────────\n"
    s = s + "fn cpu_vadd(a: [f64], b: [f64], c: [f64], n: i64) {\n"
    s = s + "    let mut i = 0\n"
    s = s + "    while i < n { c[i] = a[i] + b[i]; i = i + 1 }\n"
    s = s + "}\n"
    s = s + "\n"
    s = s + _hc_main_1d("vadd", n,
        "    gpu_launch(vadd, grid_x, 1, 1, block_x, 1, 1, a_h, b_h, c_h, n)",
        "cpu_vadd(a_h, b_h, c_ref, n)", "VECADD", true)
    return s
}

// rung 2 — block reduction → atomic accumulate. out[0] = Σ a[i]. Each
// block reduces its slice into a @shared scratch, then one thread
// gpu_atomic_add's the block partial into the global accumulator
// (gpu/SPEC.md §5 atomics + §6 shared memory + gpu_barrier).
fn _hc_k_reduction(slug: string, spec: DojoSpec) -> string {
    let n = spec_get_or(spec, "n", "1024")
    let mut s = _hc_kernel_head(slug, "reduction", spec)
    s = s + "// ── kernel — @shared block reduction + gpu_atomic_add (§5/§6) ────────\n"
    s = s + "@gpu_kernel\n"
    s = s + "fn reduce_sum(a: [f64], out: [f64], n: i64) {\n"
    s = s + "    @shared let scratch: [f64; 256] = []\n"
    s = s + "    let tid = gpu_thread_id_x()\n"
    s = s + "    let gid = gpu_block_id_x() * gpu_block_dim_x() + gpu_thread_id_x()\n"
    s = s + "    let mut v: f64 = 0.0\n"
    s = s + "    if to_i64(gid) < n { v = a[to_i64(gid)] }\n"
    s = s + "    scratch[to_i64(tid)] = v\n"
    s = s + "    gpu_barrier()\n"
    s = s + "    // tree reduction within the block (stride halving)\n"
    s = s + "    let mut stride = gpu_block_dim_x() / 2\n"
    s = s + "    while stride > 0 {\n"
    s = s + "        if tid < stride {\n"
    s = s + "            scratch[to_i64(tid)] = scratch[to_i64(tid)] + scratch[to_i64(tid + stride)]\n"
    s = s + "        }\n"
    s = s + "        gpu_barrier()\n"
    s = s + "        stride = stride / 2\n"
    s = s + "    }\n"
    s = s + "    // thread 0 publishes the block partial into the global accumulator\n"
    s = s + "    if tid == 0 {\n"
    s = s + "        let _ = gpu_atomic_add(out, scratch[0])\n"
    s = s + "    }\n"
    s = s + "}\n"
    s = s + "\n"
    s = s + "// ── CPU reference oracle (tolerance — reduction is order-dependent) ──\n"
    s = s + "fn cpu_reduce_sum(a: [f64], out: [f64], n: i64) {\n"
    s = s + "    let mut acc: f64 = 0.0\n"
    s = s + "    let mut i = 0\n"
    s = s + "    while i < n { acc = acc + a[i]; i = i + 1 }\n"
    s = s + "    out[0] = acc\n"
    s = s + "}\n"
    s = s + "\n"
    s = s + _hc_main_reduce(n)
    return s
}

// rung 3 — tiled GEMM with @shared staging + gpu_barrier. C = A·B,
// row-major, naive-then-tiled (gpu/SPEC.md §6). One thread computes one
// C element; the K dimension is streamed through a @shared tile so the
// barrier-publish discipline is exercised.
fn _hc_k_tiled_gemm(slug: string, spec: DojoSpec) -> string {
    let mut s = _hc_kernel_head(slug, "tiled-gemm", spec)
    s = s + "// ── kernel — 2-D thread index + fma.rn.f64 contraction (§5) ──────────\n"
    s = s + "// One thread computes one C element. A is row-major m×k, B is\n"
    s = s + "// row-major k×n, C is row-major m×n. `acc + a*b` lowers to a single\n"
    s = s + "// fma.rn.f64 (mirrors gpu/tests/gemm.hexa).\n"
    s = s + "@gpu_kernel\n"
    s = s + "fn gemm(a: [f64], b: [f64], c: [f64], m: i64, n: i64, k: i64) {\n"
    s = s + "    let row = gpu_block_id_y() * gpu_block_dim_y() + gpu_thread_id_y()\n"
    s = s + "    let col = gpu_block_id_x() * gpu_block_dim_x() + gpu_thread_id_x()\n"
    s = s + "    if to_i64(row) < m {\n"
    s = s + "        if to_i64(col) < n {\n"
    s = s + "            let mut acc: f64 = 0.0\n"
    s = s + "            let mut kk: i64 = 0\n"
    s = s + "            while kk < k {\n"
    s = s + "                acc = acc + a[to_i64(row) * k + kk] * b[kk * n + to_i64(col)]\n"
    s = s + "                kk = kk + 1\n"
    s = s + "            }\n"
    s = s + "            c[to_i64(row) * n + to_i64(col)] = acc\n"
    s = s + "        }\n"
    s = s + "    }\n"
    s = s + "}\n"
    s = s + "\n"
    s = s + "// ── tiled variant — @shared A/B tiles + gpu_barrier (§6) ─────────────\n"
    s = s + "// Each block stages a TILE×TILE sub-block of A and B into @shared,\n"
    s = s + "// barriers, then accumulates from shared. The barrier-publish\n"
    s = s + "// discipline (write shared → gpu_barrier() → cross-thread read) is\n"
    s = s + "// the lesson of this rung.\n"
    s = s + "@gpu_kernel\n"
    s = s + "fn gemm_tiled(a: [f64], b: [f64], c: [f64], m: i64, n: i64, k: i64) {\n"
    s = s + "    @shared let as_tile: [f64; 256] = []\n"
    s = s + "    @shared let bs_tile: [f64; 256] = []\n"
    s = s + "    let ty = gpu_thread_id_y()\n"
    s = s + "    let tx = gpu_thread_id_x()\n"
    s = s + "    let row = gpu_block_id_y() * gpu_block_dim_y() + gpu_thread_id_y()\n"
    s = s + "    let col = gpu_block_id_x() * gpu_block_dim_x() + gpu_thread_id_x()\n"
    s = s + "    let tile: i64 = 16\n"
    s = s + "    let mut acc: f64 = 0.0\n"
    s = s + "    let mut t: i64 = 0\n"
    s = s + "    while t < k {\n"
    s = s + "        // stage one tile column of A and one tile row of B\n"
    s = s + "        let a_col = t + to_i64(tx)\n"
    s = s + "        let b_row = t + to_i64(ty)\n"
    s = s + "        if to_i64(row) < m {\n"
    s = s + "            if a_col < k {\n"
    s = s + "                as_tile[to_i64(ty) * tile + to_i64(tx)] = a[to_i64(row) * k + a_col]\n"
    s = s + "            }\n"
    s = s + "        }\n"
    s = s + "        if b_row < k {\n"
    s = s + "            if to_i64(col) < n {\n"
    s = s + "                bs_tile[to_i64(ty) * tile + to_i64(tx)] = b[b_row * n + to_i64(col)]\n"
    s = s + "            }\n"
    s = s + "        }\n"
    s = s + "        gpu_barrier()\n"
    s = s + "        let mut kk: i64 = 0\n"
    s = s + "        while kk < tile {\n"
    s = s + "            acc = acc + as_tile[to_i64(ty) * tile + kk] * bs_tile[kk * tile + to_i64(tx)]\n"
    s = s + "            kk = kk + 1\n"
    s = s + "        }\n"
    s = s + "        gpu_barrier()\n"
    s = s + "        t = t + tile\n"
    s = s + "    }\n"
    s = s + "    if to_i64(row) < m {\n"
    s = s + "        if to_i64(col) < n {\n"
    s = s + "            c[to_i64(row) * n + to_i64(col)] = acc\n"
    s = s + "        }\n"
    s = s + "    }\n"
    s = s + "}\n"
    s = s + "\n"
    s = s + "// ── CPU reference oracle (tolerance — GEMM reduces) ──────────────────\n"
    s = s + "fn cpu_gemm(a: [f64], b: [f64], c: [f64], m: i64, n: i64, k: i64) {\n"
    s = s + "    let mut row = 0\n"
    s = s + "    while row < m {\n"
    s = s + "        let mut col = 0\n"
    s = s + "        while col < n {\n"
    s = s + "            let mut acc: f64 = 0.0\n"
    s = s + "            let mut kk = 0\n"
    s = s + "            while kk < k {\n"
    s = s + "                acc = acc + a[row * k + kk] * b[kk * n + col]\n"
    s = s + "                kk = kk + 1\n"
    s = s + "            }\n"
    s = s + "            c[row * n + col] = acc\n"
    s = s + "            col = col + 1\n"
    s = s + "        }\n"
    s = s + "        row = row + 1\n"
    s = s + "    }\n"
    s = s + "}\n"
    s = s + "\n"
    s = s + _hc_main_gemm()
    return s
}

// rung 4 — WMMA Tensor-Core MMA. A 16×16×16 tile multiply-accumulate via
// the gpu_wmma_* intrinsic family (compiler/codegen/nvptx_target.hexa
// _nvptx_wmma_mnemonic): load_a (row, f16) · load_b (col, f16) · mma
// (A·B → f32 accumulator) · store_c (row, f32). The kernel SHAPE matches
// tool/probe_bf16_wmma.hexa (the named-fragment grammar is RFC 067/068;
// the f64 stand-in body keeps the fixture parse-clean today).
fn _hc_k_wmma(slug: string, spec: DojoSpec) -> string {
    let mut s = _hc_kernel_head(slug, "wmma", spec)
    s = s + "// ── kernel — gpu_wmma_* 16×16×16 tile MMA (RFC 067) ──────────────────\n"
    s = s + "// The Tensor-Core path: each warp cooperatively loads a 16×16 A\n"
    s = s + "// fragment (row-major, f16) + a 16×16 B fragment (col-major, f16),\n"
    s = s + "// multiply-accumulates into an f32 C fragment, and stores it back.\n"
    s = s + "// The gpu_wmma_* names lower to wmma.{load,mma,store}.sync.aligned\n"
    s = s + "// .m16n16k16 PTX (compiler/codegen/nvptx_target.hexa).\n"
    s = s + "//\n"
    s = s + "// Honest scope: the gpu_wmma_* family is a CODEGEN-LEVEL op set —\n"
    s = s + "// the fragments are built in the MIR (compiler/codegen/nvptx_target\n"
    s = s + "// .hexa _nvptx_wmma_mnemonic) as STMT_CALL ops, NOT a source-level\n"
    s = s + "// expression grammar (that named-fragment surface is RFC 067/068).\n"
    s = s + "// This kata mirrors tool/probe_bf16_wmma.hexa: the kernel SHAPE is a\n"
    s = s + "// 16×16 tile multiply with an f32 accumulator; the f64 stand-in body\n"
    s = s + "// keeps the fixture parse-clean today. The gpu_wmma_* lowering this\n"
    s = s + "// rung teaches (lower-tier in tool/fusion_wmma_override_probe.hexa):\n"
    s = s + "//   gpu_wmma_load_a  → wmma.load.a.sync.aligned.row.m16n16k16.shared.f16\n"
    s = s + "//   gpu_wmma_load_b  → wmma.load.b.sync.aligned.col.m16n16k16.shared.f16\n"
    s = s + "//   gpu_wmma_mma     → wmma.mma.sync.aligned.row.col.m16n16k16.f32.f32\n"
    s = s + "//   gpu_wmma_store_c → wmma.store.d.sync.aligned.row.m16n16k16.shared.f32\n"
    s = s + "@gpu_kernel\n"
    s = s + "fn wmma_tile(a: [f64], b: [f64], c: [f64], n: i64) {\n"
    s = s + "    @shared let stage: [f64; 256] = []\n"
    s = s + "    let tid = gpu_thread_id_x()\n"
    s = s + "    // stage the A tile into @shared (one element per lane) — the\n"
    s = s + "    // .shared staging slot the gpu_wmma_load_* ops read fragments from.\n"
    s = s + "    if to_i64(tid) < n {\n"
    s = s + "        stage[to_i64(tid)] = a[to_i64(tid)]\n"
    s = s + "    }\n"
    s = s + "    gpu_barrier()\n"
    s = s + "    // f64 stand-in tile product keeps the host-eq oracle exercised; the\n"
    s = s + "    // real Tensor-Core fragment MMA (load_a·load_b·mma·store_c) is the\n"
    s = s + "    // codegen lowering listed above, wired by the MIR (RFC 067).\n"
    s = s + "    if to_i64(tid) < n {\n"
    s = s + "        c[to_i64(tid)] = stage[to_i64(tid)] * b[to_i64(tid)]\n"
    s = s + "    }\n"
    s = s + "}\n"
    s = s + "\n"
    s = s + "// ── CPU reference oracle (the f64 stand-in elementwise product) ──────\n"
    s = s + "fn cpu_wmma_tile(a: [f64], b: [f64], c: [f64], n: i64) {\n"
    s = s + "    let mut i = 0\n"
    s = s + "    while i < n { c[i] = a[i] * b[i]; i = i + 1 }\n"
    s = s + "}\n"
    s = s + "\n"
    s = s + _hc_main_1d("wmma_tile", spec_get_or(spec, "n", "256"),
        "    gpu_launch(wmma_tile, grid_x, 1, 1, block_x, 1, 1, a_h, b_h, c_h, n)",
        "cpu_wmma_tile(a_h, b_h, c_ref, n)", "WMMA", false)
    return s
}

// ── host main() emitters (gpu_launch call shape, gpu/SPEC.md §7) ──────

// 1-D launch harness: alloc a/b/c [f64], CPU ref, the gpu_launch comment-
// shape, byte-eq (mul=false → exact add) OR tolerance (true) compare.
fn _hc_main_1d(kernel: string, n: string, launch: string, cpuref: string,
               gate: string, byte_eq: bool) -> string {
    let mut s = ""
    s = s + "// ── host harness (gpu/SPEC.md §7 — gpu_launch ABI) ───────────────────\n"
    s = s + "fn main() {\n"
    s = s + "    let n: i64 = " + n + "\n"
    s = s + "    let block_x: i64 = 256\n"
    s = s + "    let grid_x: i64 = (n + block_x - 1) / block_x\n"
    s = s + "    let mut a_h: [f64] = []\n"
    s = s + "    let mut b_h: [f64] = []\n"
    s = s + "    let mut c_h: [f64] = []\n"
    s = s + "    let mut i = 0\n"
    s = s + "    while i < n {\n"
    s = s + "        a_h.push(to_f64(i))\n"
    s = s + "        b_h.push(to_f64(n - i))\n"
    s = s + "        c_h.push(0.0)\n"
    s = s + "        i = i + 1\n"
    s = s + "    }\n"
    s = s + "    let mut c_ref: [f64] = []\n"
    s = s + "    let mut k = 0\n"
    s = s + "    while k < n { c_ref.push(0.0); k = k + 1 }\n"
    s = s + "    " + cpuref + "\n"
    s = s + "    // GPU launch (RFC 055-P3 lowering — today a declaration shape):\n"
    s = s + "    //\n"
    s = s + "    //" + launch + "\n"
    s = s + "    //\n"
    s = s + "    // run.sh fires the PTX via a thin host wrapper that calls\n"
    s = s + "    // hexa_cuda_launch_kernel directly; this is the future one-liner.\n"
    s = s + "    let mut max_delta: f64 = 0.0\n"
    s = s + "    let mut j = 0\n"
    s = s + "    while j < n {\n"
    s = s + "        let d = c_h[j] - c_ref[j]\n"
    s = s + "        let abs_d = if d < 0.0 { -d } else { d }\n"
    s = s + "        if abs_d > max_delta { max_delta = abs_d }\n"
    s = s + "        j = j + 1\n"
    s = s + "    }\n"
    if byte_eq {
        s = s + "    let tol: f64 = 0.000001\n"
        s = s + "    if max_delta <= tol {\n"
        s = s + "        println(\"F-HEXACUDA-" + gate + " PASS — max|Δ| within tolerance\")\n"
        s = s + "    } else {\n"
        s = s + "        println(\"F-HEXACUDA-" + gate + " FAIL — max|Δ| = \" + to_string(max_delta))\n"
        s = s + "    }\n"
    } else {
        s = s + "    if max_delta == 0.0 {\n"
        s = s + "        println(\"F-HEXACUDA-" + gate + " PASS — max|Δ| = 0\")\n"
        s = s + "    } else {\n"
        s = s + "        println(\"F-HEXACUDA-" + gate + " FAIL — max|Δ| = \" + to_string(max_delta))\n"
        s = s + "    }\n"
    }
    s = s + "}\n"
    return s
}

// reduction harness — scalar out[0], tolerance compare.
fn _hc_main_reduce(n: string) -> string {
    let mut s = ""
    s = s + "// ── host harness (gpu/SPEC.md §7 — gpu_launch ABI) ───────────────────\n"
    s = s + "fn main() {\n"
    s = s + "    let n: i64 = " + n + "\n"
    s = s + "    let block_x: i64 = 256\n"
    s = s + "    let grid_x: i64 = (n + block_x - 1) / block_x\n"
    s = s + "    let mut a_h: [f64] = []\n"
    s = s + "    let mut i = 0\n"
    s = s + "    while i < n { a_h.push(to_f64(i % 7)); i = i + 1 }\n"
    s = s + "    let mut out_h: [f64] = []\n"
    s = s + "    out_h.push(0.0)\n"
    s = s + "    let mut out_ref: [f64] = []\n"
    s = s + "    out_ref.push(0.0)\n"
    s = s + "    cpu_reduce_sum(a_h, out_ref, n)\n"
    s = s + "    // GPU launch (RFC 055-P3 lowering — today a declaration shape):\n"
    s = s + "    //\n"
    s = s + "    //  gpu_launch(reduce_sum, grid_x, 1, 1, block_x, 1, 1, a_h, out_h, n)\n"
    s = s + "    //\n"
    s = s + "    let d = out_h[0] - out_ref[0]\n"
    s = s + "    let abs_d = if d < 0.0 { -d } else { d }\n"
    s = s + "    let tol: f64 = 0.000001\n"
    s = s + "    if abs_d <= tol {\n"
    s = s + "        println(\"F-HEXACUDA-REDUCE PASS — |Δ| within tolerance\")\n"
    s = s + "    } else {\n"
    s = s + "        println(\"F-HEXACUDA-REDUCE FAIL — |Δ| = \" + to_string(abs_d))\n"
    s = s + "    }\n"
    s = s + "}\n"
    return s
}

// GEMM harness — m=n=k=64, tolerance compare (mirrors gpu/tests/gemm.hexa).
fn _hc_main_gemm() -> string {
    let mut s = ""
    s = s + "// ── host harness (gpu/SPEC.md §7 — gpu_launch ABI) ───────────────────\n"
    s = s + "fn main() {\n"
    s = s + "    let m: i64 = 64\n"
    s = s + "    let n: i64 = 64\n"
    s = s + "    let k: i64 = 64\n"
    s = s + "    let mut a_h: [f64] = []\n"
    s = s + "    let mut b_h: [f64] = []\n"
    s = s + "    let mut i = 0\n"
    s = s + "    while i < m * k { a_h.push(to_f64(i % 7)); i = i + 1 }\n"
    s = s + "    let mut j = 0\n"
    s = s + "    while j < k * n { b_h.push(to_f64(j % 5)); j = j + 1 }\n"
    s = s + "    let mut c_h: [f64] = []\n"
    s = s + "    let mut p = 0\n"
    s = s + "    while p < m * n { c_h.push(0.0); p = p + 1 }\n"
    s = s + "    let mut c_ref: [f64] = []\n"
    s = s + "    let mut q = 0\n"
    s = s + "    while q < m * n { c_ref.push(0.0); q = q + 1 }\n"
    s = s + "    cpu_gemm(a_h, b_h, c_ref, m, n, k)\n"
    s = s + "    // GPU launch (RFC 055-P3 lowering — today a declaration shape):\n"
    s = s + "    //\n"
    s = s + "    //  let bx: i64 = 16\n"
    s = s + "    //  let by: i64 = 16\n"
    s = s + "    //  gpu_launch(gemm_tiled, (n + bx - 1) / bx, (m + by - 1) / by, 1,\n"
    s = s + "    //                         bx, by, 1, a_h, b_h, c_h, m, n, k)\n"
    s = s + "    //\n"
    s = s + "    let mut max_delta: f64 = 0.0\n"
    s = s + "    let mut r = 0\n"
    s = s + "    while r < m * n {\n"
    s = s + "        let d = c_h[r] - c_ref[r]\n"
    s = s + "        let abs_d = if d < 0.0 { -d } else { d }\n"
    s = s + "        if abs_d > max_delta { max_delta = abs_d }\n"
    s = s + "        r = r + 1\n"
    s = s + "    }\n"
    s = s + "    let tol: f64 = 0.000001\n"
    s = s + "    if max_delta <= tol {\n"
    s = s + "        println(\"F-HEXACUDA-GEMM PASS — max|Δ| within tolerance\")\n"
    s = s + "    } else {\n"
    s = s + "        println(\"F-HEXACUDA-GEMM FAIL — max|Δ| = \" + to_string(max_delta))\n"
    s = s + "    }\n"
    s = s + "}\n"
    return s
}

// ── .cu contrast (--lang=py | both) — emitted-string content only ────

fn _hc_cu(slug: string, kata: string, spec: DojoSpec) -> string {
    let mut s = ""
    s = s + "// hexa-cuda dojo kata — CUDA .cu CONTRAST (NOT the production path)\n"
    s = s + "// slug: " + slug + "  ·  kata: " + kata + "\n"
    s = s + "//\n"
    s = s + "// Side-by-side reference of the SAME kata in CUDA C++. The hexa\n"
    s = s + "// kernel.hexa is the production surface; this .cu shows the 1:1\n"
    s = s + "// intrinsic mapping (gpu/SPEC.md §5 table): threadIdx.x →\n"
    s = s + "// gpu_thread_id_x(), __syncthreads() → gpu_barrier(), atomicAdd →\n"
    s = s + "// gpu_atomic_add, __shared__ → @shared let. Compile contrast only:\n"
    s = s + "//   nvcc -arch=" + spec_get_or(spec, "sm", "sm_90") + " kernel.cu -o kernel_cu\n"
    s = s + "#include <cstdio>\n"
    s = s + "\n"
    if kata == "vec-add" {
        s = s + "__global__ void vadd(const double* a, const double* b, double* c, long n) {\n"
        s = s + "    long gid = blockIdx.x * blockDim.x + threadIdx.x;\n"
        s = s + "    if (gid < n) c[gid] = a[gid] + b[gid];\n"
        s = s + "}\n"
    } else if kata == "reduction" {
        s = s + "__global__ void reduce_sum(const double* a, double* out, long n) {\n"
        s = s + "    __shared__ double scratch[256];\n"
        s = s + "    int tid = threadIdx.x;\n"
        s = s + "    long gid = blockIdx.x * blockDim.x + threadIdx.x;\n"
        s = s + "    scratch[tid] = (gid < n) ? a[gid] : 0.0;\n"
        s = s + "    __syncthreads();\n"
        s = s + "    for (int s = blockDim.x / 2; s > 0; s >>= 1) {\n"
        s = s + "        if (tid < s) scratch[tid] += scratch[tid + s];\n"
        s = s + "        __syncthreads();\n"
        s = s + "    }\n"
        s = s + "    if (tid == 0) atomicAdd(out, scratch[0]);\n"
        s = s + "}\n"
    } else if kata == "tiled-gemm" {
        s = s + "#define TILE 16\n"
        s = s + "__global__ void gemm_tiled(const double* a, const double* b, double* c,\n"
        s = s + "                           long m, long n, long k) {\n"
        s = s + "    __shared__ double as_tile[TILE*TILE];\n"
        s = s + "    __shared__ double bs_tile[TILE*TILE];\n"
        s = s + "    long row = blockIdx.y * blockDim.y + threadIdx.y;\n"
        s = s + "    long col = blockIdx.x * blockDim.x + threadIdx.x;\n"
        s = s + "    double acc = 0.0;\n"
        s = s + "    for (long t = 0; t < k; t += TILE) {\n"
        s = s + "        if (row < m && t + threadIdx.x < k)\n"
        s = s + "            as_tile[threadIdx.y*TILE+threadIdx.x] = a[row*k + t + threadIdx.x];\n"
        s = s + "        if (t + threadIdx.y < k && col < n)\n"
        s = s + "            bs_tile[threadIdx.y*TILE+threadIdx.x] = b[(t+threadIdx.y)*n + col];\n"
        s = s + "        __syncthreads();\n"
        s = s + "        for (int kk = 0; kk < TILE; kk++)\n"
        s = s + "            acc += as_tile[threadIdx.y*TILE+kk] * bs_tile[kk*TILE+threadIdx.x];\n"
        s = s + "        __syncthreads();\n"
        s = s + "    }\n"
        s = s + "    if (row < m && col < n) c[row*n+col] = acc;\n"
        s = s + "}\n"
    } else {
        s = s + "#include <mma.h>\n"
        s = s + "using namespace nvcuda::wmma;\n"
        s = s + "// 16x16x16 Tensor-Core tile MMA (half x half -> float accumulator).\n"
        s = s + "__global__ void wmma_tile(const half* a, const half* b, float* c) {\n"
        s = s + "    fragment<matrix_a, 16,16,16, half, row_major> fa;\n"
        s = s + "    fragment<matrix_b, 16,16,16, half, col_major> fb;\n"
        s = s + "    fragment<accumulator, 16,16,16, float> fc;\n"
        s = s + "    fill_fragment(fc, 0.0f);\n"
        s = s + "    load_matrix_sync(fa, a, 16);\n"
        s = s + "    load_matrix_sync(fb, b, 16);\n"
        s = s + "    mma_sync(fc, fa, fb, fc);\n"
        s = s + "    store_matrix_sync(c, fc, 16, mem_row_major);\n"
        s = s + "}\n"
    }
    return s
}

fn _hc_py(slug: string, kata: string, spec: DojoSpec) -> string {
    let mut s = ""
    s = s + "#!/usr/bin/env python3\n"
    s = s + "# hexa-cuda dojo kata — ctypes CONTRAST driver (NOT the production path)\n"
    s = s + "# slug: " + slug + "  ·  kata: " + kata + "\n"
    s = s + "#\n"
    s = s + "# Shows the classic CUDA-from-Python flow: nvcc the .cu to a shared\n"
    s = s + "# object, ctypes-load it, marshal host buffers. The hexa path\n"
    s = s + "# (kernel.hexa + gpu_launch) needs NONE of this glue — it is the\n"
    s = s + "# contrast that motivates the kata. Edit the spec, re-emit.\n"
    s = s + "import ctypes, subprocess, sys\n"
    s = s + "\n"
    s = s + "SM = \"" + spec_get_or(spec, "sm", "sm_90") + "\"\n"
    s = s + "N = " + spec_get_or(spec, "n", "1024") + "\n"
    s = s + "\n"
    s = s + "def build():\n"
    s = s + "    # nvcc -shared -Xcompiler -fPIC -arch=SM kernel.cu -o kernel.so\n"
    s = s + "    subprocess.run([\n"
    s = s + "        \"nvcc\", \"-shared\", \"-Xcompiler\", \"-fPIC\",\n"
    s = s + "        \"-arch=\" + SM, \"kernel.cu\", \"-o\", \"kernel.so\",\n"
    s = s + "    ], check=True)\n"
    s = s + "\n"
    s = s + "def main():\n"
    s = s + "    build()\n"
    s = s + "    lib = ctypes.CDLL(\"./kernel.so\")\n"
    s = s + "    # NOTE: a real launch needs a host wrapper that cudaMalloc/Memcpy\n"
    s = s + "    # and cudaLaunchKernel — the .cu above is device-only. This\n"
    s = s + "    # contrast stops at the build to keep the kata self-contained;\n"
    s = s + "    # the hexa path replaces ALL of this with one gpu_launch line.\n"
    s = s + "    print(f\"hexa-cuda contrast: built kernel.so (arch={SM}, N={N})\")\n"
    s = s + "    print(\"see kernel.hexa for the production hexa-native path\")\n"
    s = s + "\n"
    s = s + "if __name__ == \"__main__\":\n"
    s = s + "    main()\n"
    return s
}

// ── run.sh glue + README (emitted-string content only) ───────────────

fn _hc_glue(slug: string, kata: string, spec: DojoSpec) -> string {
    let mut s = ""
    s = s + "#!/usr/bin/env bash\n"
    s = s + "# hexa-cuda dojo run glue — generated by stdlib/dojo/hexa_cuda\n"
    s = s + "# slug: " + slug + "  ·  kata: " + kata + "\n"
    s = s + "set -euo pipefail\n"
    s = s + "cd \"$(dirname \"$0\")\"\n"
    s = s + "\n"
    s = s + "# ── $0 gate — parse-check the kernel (no GPU, no nvcc needed) ──\n"
    s = s + "# The @gpu_kernel fixture is parse-clean today (gpu/SPEC.md §2). This\n"
    s = s + "# is the machine-independent kata gate — it catches every intrinsic\n"
    s = s + "# / syntax error without a GPU.\n"
    s = s + "echo \"hexa-cuda: parse-check kernel.hexa\"\n"
    s = s + "hexa parse kernel.hexa\n"
    s = s + "\n"
    s = s + "# ── build → NVPTX (needs a CUDA toolchain; RFC 055-P3 lowering) ──\n"
    s = s + "# hexa partitions @gpu_* fns to the NVPTX codegen target and emits\n"
    s = s + "# cubin-ready PTX; the host glue stays CPU-native. ptxas (PTX→SASS)\n"
    s = s + "# is an external NVIDIA tool — the hexa→PTX TEXT path is LLVM-free.\n"
    s = s + "if command -v ptxas >/dev/null 2>&1; then\n"
    s = s + "    echo \"hexa-cuda: build --target=nvptx kernel.hexa\"\n"
    s = s + "    hexa build --target=nvptx kernel.hexa\n"
    s = s + "else\n"
    s = s + "    echo \"hexa-cuda: ptxas not found — parse gate only (NVPTX build needs a CUDA host)\"\n"
    s = s + "fi\n"
    return s
}

fn _hc_readme(slug: string, kata: string, spec: DojoSpec) -> string {
    let n     = spec_get_or(spec, "n", "1024")
    let dtype = spec_get_or(spec, "dtype", "f64")
    let sm    = spec_get_or(spec, "sm", "sm_90")
    let mut s = ""
    s = s + "# hexa-cuda dojo kata — " + slug + " (" + kata + ")\n"
    s = s + "\n"
    s = s + "The **learn-by-doing** arm of HEXA-CUDA. Each kata is a small,\n"
    s = s + "self-contained `@gpu_kernel` you build and read end-to-end.\n"
    s = s + "\n"
    s = s + "- spec: `n=" + n + "`  `dtype=" + dtype + "`  `sm=" + sm + "`\n"
    s = s + "- build: `bash run.sh`  (parse gate + `hexa build --target=nvptx kernel.hexa`)\n"
    s = s + "\n"
    s = s + "## kata ladder\n"
    s = s + "\n"
    s = s + "| rung | kata | intrinsics exercised |\n"
    s = s + "|---|---|---|\n"
    s = s + "| 1 | vec-add | `gpu_block_id_x` · `gpu_block_dim_x` · `gpu_thread_id_x` |\n"
    s = s + "| 2 | reduction | `@shared let` · `gpu_barrier` · `gpu_atomic_add` |\n"
    s = s + "| 3 | tiled-gemm | 2-D thread index · `@shared` tiles · `gpu_barrier` |\n"
    s = s + "| 4 | wmma | `gpu_wmma_load_a` · `gpu_wmma_load_b` · `gpu_wmma_mma` · `gpu_wmma_store_c` |\n"
    s = s + "\n"
    s = s + "## this kata: " + kata + "\n"
    s = s + "\n"
    s = s + _hc_readme_body(kata)
    s = s + "\n"
    s = s + "## files\n"
    s = s + "\n"
    s = s + "- `kernel.hexa` — the `@gpu_kernel` + CPU reference oracle + host `gpu_launch` shape\n"
    s = s + "- `run.sh` — parse gate, then `hexa build --target=nvptx`\n"
    s = s + "- `kernel.cu` / `driver.py` — the CUDA C++ + ctypes contrast (emitted with `--lang=py|both`)\n"
    s = s + "\n"
    s = s + "## references\n"
    s = s + "\n"
    s = s + "- `gpu/SPEC.md` — the `@gpu` subset SSOT (§5 intrinsics · §6 shared mem · §7 launch ABI)\n"
    s = s + "- `gpu/tests/{vec_add,gemm}.hexa` — the in-tree reference kernels this kata mirrors\n"
    s = s + "- `docs/hexa-dojo.md` — the two dojo tracks + the kata ladder\n"
    s = s + "- `HEXA-CUDA.md` — the GPU-native domain home\n"
    return s
}

fn _hc_readme_body(kata: string) -> string {
    if kata == "vec-add" {
        return "`c[i] = a[i] + b[i]` over a flat 1-D thread index. The floor\nrung: compose a global id from `gpu_block_id_x() * gpu_block_dim_x()\n+ gpu_thread_id_x()`, bounds-check against `n`, write one element.\nFP64 add is exact → the CPU-reference oracle is a byte-eq gate.\n"
    }
    if kata == "reduction" {
        return "`out[0] = Σ a[i]`. Each block reduces its slice into a\n`@shared` scratch via a stride-halving tree (with a `gpu_barrier()`\nbetween passes), then thread 0 `gpu_atomic_add`s the block partial\ninto the global accumulator. Reduction is order-dependent → a\ntolerance gate.\n"
    }
    if kata == "tiled-gemm" {
        return "`C = A·B`, row-major. The naive kernel does one thread per C\nelement with an `fma.rn.f64` contraction loop; the tiled variant\nstages `@shared` A/B tiles and barriers between the load and the\naccumulate (the publish discipline). GEMM reduces → a tolerance gate.\n"
    }
    if kata == "wmma" {
        return "A 16×16×16 Tensor-Core tile multiply-accumulate via the\n`gpu_wmma_*` family: `load_a` (row, f16) · `load_b` (col, f16) ·\n`mma` (A·B → f32 accumulator) · `store_c` (row, f32). The named-\nfragment grammar is RFC 067/068; the f64 stand-in body keeps the\nfixture parse-clean (mirrors `tool/probe_bf16_wmma.hexa`).\n"
    }
    return "vec-add floor rung.\n"
}
