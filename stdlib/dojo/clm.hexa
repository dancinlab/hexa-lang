// HEXA Standard Library — dojo/clm
//
// @version 0.1.0
// @capabilities [pure]
//
// FULL clm training-job emitter for the dojo generator — the hexa-native
// CLMConvMoE PRODUCTION trainer (parallels the `llm` HF-Trainer domain, but
// trains on-chip via clm_prod, NOT a HuggingFace Trainer).
//
// Emits a 3-file cloud training-job set from a DojoSpec:
//   job.hexa     — the .hexa DRIVER: a SELF-CONTAINED CLMConvMoE corpus
//                  training loop (int4-QAT fwd/bwd routed through forge
//                  cuBLAS, the verified clm_prod chain). Reads the corpus
//                  path from env CLM_PROD_CORPUS (empty → in-repo fixture),
//                  config (d / layers / T / experts) baked from the spec.
//                  Emits the F-CLM-PROD-DESCENT gate (mean CE strictly
//                  descends). clm_prod.hexa carries its own main() and so
//                  cannot be `use`d — the verified loop is inlined here, the
//                  same discipline clm_prod itself uses for the clm flame
//                  chain. Run from the job dir:  hexa run job.hexa
//   run.sh       — the .sh GLUE: pull the spec's HF kosmos_dataset → extract
//                  the packed .limen payloads to a plain newline corpus →
//                  export CLM_PROD_CORPUS → `hexa run job.hexa` → assert BOTH
//                  gates: F-CLM-PROD-DESCENT (CE descends) AND util-GREEN
//                  (forge cuBLAS GPU util — re-checks the F-RFC046 1-4% util
//                  bottleneck; util is reported HONESTLY, never faked GREEN).
//   manifest.json — spec echo + corpus provenance + gate list + config.
//
// `--lang` filters which survive (see gen.lang_keep): the clm domain is
// hexa-native (no .py payload), so "py" yields an empty set — both/hexa keep
// job.hexa; both keeps run.sh + manifest.json too.
//
// SPEC schema (clm keys):
//   kosmos_dataset — HF dataset id, .limen-packed corpus (default
//                    "dancinlab/clm-h911-trainset-5lang-parallel")
//   d              — model width int (default "768")
//   layers         — CLMConvMoE block count int (default "12")
//   T              — causal window length int (default "24")
//   experts        — MoE expert count int (default "2")
//   host           — cloud pool host for the H100 fire (default "h100-1")
//   output_dir     — remote ckpt output dir (default "out")

import "stdlib/dojo/gen.hexa"

pub fn emit_clm(slug: string, spec: DojoSpec, lang: string) -> [DojoFile] {
    let files: [DojoFile] = []
    if lang_keep(lang, "hexa") {
        dojo_push(files, "job.hexa", _clm_driver(slug, spec))
    }
    if lang_keep(lang, "sh") {
        dojo_push(files, "run.sh", _clm_glue(slug, spec))
        dojo_push(files, "manifest.json", _clm_manifest(slug, spec))
    }
    return files
}

// ── .hexa driver — self-contained CLMConvMoE corpus loop ─────────────
//
// Inlines the verified clm_prod fwd/bwd/corpus chain (clm_prod.hexa cannot
// be `use`d — it carries its own main). Config knobs (d / T / E / K / epochs)
// are baked from the spec; the corpus path is read at RUNTIME from env
// CLM_PROD_CORPUS (empty → the in-repo fixture), so run.sh wires the pulled
// corpus through without re-emitting the driver.

fn _clm_driver(slug: string, spec: DojoSpec) -> string {
    let d       = spec_get_or(spec, "d", "768")
    let layers  = spec_get_or(spec, "layers", "12")
    let T       = spec_get_or(spec, "T", "24")
    let experts = spec_get_or(spec, "experts", "2")

    let mut s = ""
    s = s + "// dojo clm job driver — generated by stdlib/dojo/clm\n"
    s = s + "// slug: " + slug + "\n"
    s = s + "//\n"
    s = s + "// Self-contained CLMConvMoE production corpus loop (the verified\n"
    s = s + "// clm_prod int4-QAT fwd/bwd chain, routed through forge cuBLAS).\n"
    s = s + "// Corpus path = env CLM_PROD_CORPUS (empty → in-repo fixture).\n"
    s = s + "// Config baked from the dojo spec; layers=" + layers + " (single\n"
    s = s + "// verified CLMConvMoE block per clm_prod — multi-block stacking is\n"
    s = s + "// the H100-scale extension, the block count is echoed for provenance).\n"
    s = s + "// Run from this job dir:  hexa run job.hexa\n"
    s = s + "\n"
    s = s + "use \"stdlib/flame/tensor_lib\"\n"
    s = s + "use \"stdlib/flame/conv_lib\"\n"
    s = s + "use \"stdlib/flame/gn_lib\"\n"
    s = s + "use \"stdlib/flame/moe_lib\"\n"
    s = s + "use \"stdlib/flame/nn_lib\"\n"
    s = s + "use \"stdlib/flame/quant_lib\"\n"
    s = s + "use \"stdlib/flame/optim_lib\"\n"
    s = s + "\n"
    s = s + _conv_fwd_src()
    s = s + _conv_bwd_src()
    s = s + _fwd_chain_src()
    s = s + _ce_grad_src()
    s = s + _bwd_chain_src()
    s = s + _adam_helper_src()
    s = s + _corpus_windows_src()
    s = s + _main_src(d, T, experts)
    return s
}

// conv1d (causal dilated) via im2col + forge matmul — verbatim clm_prod.
fn _conv_fwd_src() -> string {
    let mut s = ""
    s = s + "fn conv1d_via_forge(x: int, w: int, b: int, y_out: int,\n"
    s = s + "                    T: int, Cin: int, Cout: int, K: int, dil: int) {\n"
    s = s + "    let Kdim = Cin * K\n"
    s = s + "    let xcol = t_zeros(T * Kdim)\n"
    s = s + "    let mut t = 0\n"
    s = s + "    while t < T {\n"
    s = s + "        let mut ci = 0\n"
    s = s + "        while ci < Cin {\n"
    s = s + "            let mut k = 0\n"
    s = s + "            while k < K {\n"
    s = s + "                let p = t - dil * (K - 1 - k)\n"
    s = s + "                if p >= 0 { t_set(xcol, t * Kdim + ci * K + k, t_get(x, p * Cin + ci)) }\n"
    s = s + "                k = k + 1\n"
    s = s + "            }\n"
    s = s + "            ci = ci + 1\n"
    s = s + "        }\n"
    s = s + "        t = t + 1\n"
    s = s + "    }\n"
    s = s + "    let Wt = t_zeros(Kdim * Cout)\n"
    s = s + "    let mut co = 0\n"
    s = s + "    while co < Cout {\n"
    s = s + "        let mut j = 0\n"
    s = s + "        while j < Kdim { t_set(Wt, j * Cout + co, t_get(w, co * Kdim + j)); j = j + 1 }\n"
    s = s + "        co = co + 1\n"
    s = s + "    }\n"
    s = s + "    let mm = forge_dispatch_matmul(xcol, T, Kdim, Wt, Cout)\n"
    s = s + "    let mut t2 = 0\n"
    s = s + "    while t2 < T {\n"
    s = s + "        let mut c2 = 0\n"
    s = s + "        while c2 < Cout {\n"
    s = s + "            t_set(y_out, t2 * Cout + c2, t_get(mm, t2 * Cout + c2) + t_get(b, c2))\n"
    s = s + "            c2 = c2 + 1\n"
    s = s + "        }\n"
    s = s + "        t2 = t2 + 1\n"
    s = s + "    }\n"
    s = s + "}\n\n"
    return s
}

// conv1d backward (causal dilated) via forge matmul + col2im — verbatim clm_prod.
fn _conv_bwd_src() -> string {
    let mut s = ""
    s = s + "fn conv1d_bwd_via_forge(x: int, w: int, dy: int,\n"
    s = s + "                        dW_out: int, dX_out: int, db_out: int,\n"
    s = s + "                        T: int, Cin: int, Cout: int, K: int, dil: int) {\n"
    s = s + "    let Kdim = Cin * K\n"
    s = s + "    let xcolT = t_zeros(Kdim * T)\n"
    s = s + "    let mut t = 0\n"
    s = s + "    while t < T {\n"
    s = s + "        let mut ci = 0\n"
    s = s + "        while ci < Cin {\n"
    s = s + "            let mut k = 0\n"
    s = s + "            while k < K {\n"
    s = s + "                let p = t - dil * (K - 1 - k)\n"
    s = s + "                if p >= 0 {\n"
    s = s + "                    let j = ci * K + k\n"
    s = s + "                    t_set(xcolT, j * T + t, t_get(x, p * Cin + ci))\n"
    s = s + "                }\n"
    s = s + "                k = k + 1\n"
    s = s + "            }\n"
    s = s + "            ci = ci + 1\n"
    s = s + "        }\n"
    s = s + "        t = t + 1\n"
    s = s + "    }\n"
    s = s + "    let dW_flat = forge_dispatch_matmul(xcolT, Kdim, T, dy, Cout)\n"
    s = s + "    let mut co = 0\n"
    s = s + "    while co < Cout {\n"
    s = s + "        let mut j = 0\n"
    s = s + "        while j < Kdim {\n"
    s = s + "            t_set(dW_out, co * Kdim + j, t_get(dW_flat, j * Cout + co))\n"
    s = s + "            j = j + 1\n"
    s = s + "        }\n"
    s = s + "        co = co + 1\n"
    s = s + "    }\n"
    s = s + "    let dXcol = forge_dispatch_matmul(dy, T, Cout, w, Kdim)\n"
    s = s + "    let mut iz = 0\n"
    s = s + "    while iz < T * Cin {\n"
    s = s + "        t_set(dX_out, iz, 0.0)\n"
    s = s + "        iz = iz + 1\n"
    s = s + "    }\n"
    s = s + "    let mut t2b = 0\n"
    s = s + "    while t2b < T {\n"
    s = s + "        let mut ci2 = 0\n"
    s = s + "        while ci2 < Cin {\n"
    s = s + "            let mut k2 = 0\n"
    s = s + "            while k2 < K {\n"
    s = s + "                let p = t2b - dil * (K - 1 - k2)\n"
    s = s + "                if p >= 0 {\n"
    s = s + "                    let j = ci2 * K + k2\n"
    s = s + "                    let xidx = p * Cin + ci2\n"
    s = s + "                    t_set(dX_out, xidx, t_get(dX_out, xidx) + t_get(dXcol, t2b * Kdim + j))\n"
    s = s + "                }\n"
    s = s + "                k2 = k2 + 1\n"
    s = s + "            }\n"
    s = s + "            ci2 = ci2 + 1\n"
    s = s + "        }\n"
    s = s + "        t2b = t2b + 1\n"
    s = s + "    }\n"
    s = s + "    let mut cb = 0\n"
    s = s + "    while cb < Cout {\n"
    s = s + "        let mut acc = 0.0\n"
    s = s + "        let mut tb = 0\n"
    s = s + "        while tb < T {\n"
    s = s + "            acc = acc + t_get(dy, tb * Cout + cb)\n"
    s = s + "            tb = tb + 1\n"
    s = s + "        }\n"
    s = s + "        t_set(db_out, cb, acc)\n"
    s = s + "        cb = cb + 1\n"
    s = s + "    }\n"
    s = s + "}\n\n"
    return s
}

// forward chain (int4-QAT CLMConvMoE block) — verbatim clm_prod.
fn _fwd_chain_src() -> string {
    let mut s = ""
    s = s + "fn _fq(w: int, wq: int, mask: int, Cout: int, rest: int) {\n"
    s = s + "    let sc = t_zeros(Cout); let ql = t_zeros(Cout * rest)\n"
    s = s + "    nn_int4_quant_fwd(w, wq, sc, ql, mask, Cout, rest)\n"
    s = s + "}\n\n"
    s = s + "fn clm_prod_fwd(tokens: int,\n"
    s = s + "               embed: int, ecW: int, ecB: int, tcW: int, tcB: int, tgG: int, tgB: int,\n"
    s = s + "               rW: int, rB: int, e0W: int, e0B: int, e1W: int, e1B: int,\n"
    s = s + "               noG: int, noB: int, roW: int, roB: int,\n"
    s = s + "               ecWq: int, ecM: int, tcWq: int, tcM: int, e0Wq: int, e0M: int,\n"
    s = s + "               e1Wq: int, e1M: int, rWq: int, rM: int, roWq: int, roM: int,\n"
    s = s + "               xe: int, xec: int, xt: int, hn0: int, xhat0: int, inv0: int,\n"
    s = s + "               eo0: int, eo1: int, probs: int, ex_out: int, yn: int, xhatN: int, invN: int,\n"
    s = s + "               out_logits: int, T: int, d: int, E: int, V: int, K: int) {\n"
    s = s + "    _fq(ecW, ecWq, ecM, d, d * K)\n"
    s = s + "    _fq(tcW, tcWq, tcM, d, d * K)\n"
    s = s + "    _fq(e0W, e0Wq, e0M, d, d * K)\n"
    s = s + "    _fq(e1W, e1Wq, e1M, d, d * K)\n"
    s = s + "    _fq(rW, rWq, rM, E, d)\n"
    s = s + "    _fq(roW, roWq, roM, V, d)\n"
    s = s + "\n"
    s = s + "    nn_embedding_fwd(tokens, embed, xe, T, d)\n"
    s = s + "    conv1d_via_forge(xe, ecWq, ecB, xec, T, d, d, K, 1)\n"
    s = s + "    let h0 = t_zeros(T * d)\n"
    s = s + "    conv1d_via_forge(xec, tcWq, tcB, h0, T, d, d, K, 1)\n"
    s = s + "    let mean0 = t_zeros(1)\n"
    s = s + "    nn_groupnorm_fwd(h0, tgG, tgB, hn0, mean0, inv0, xhat0, T, d, 1)\n"
    s = s + "    let hg0 = t_zeros(T * d); nn_gelu_fwd(hn0, hg0, T * d)\n"
    s = s + "    let mut i = 0\n"
    s = s + "    while i < T * d { t_set(xt, i, t_get(xec, i) + t_get(hg0, i)); i = i + 1 }\n"
    s = s + "    let logits_r = t_zeros(T * E)\n"
    s = s + "    conv1d_via_forge(xt, rWq, rB, logits_r, T, d, E, 1, 1)\n"
    s = s + "    conv1d_via_forge(xt, e0Wq, e0B, eo0, T, d, d, K, 1)\n"
    s = s + "    conv1d_via_forge(xt, e1Wq, e1B, eo1, T, d, d, K, 1)\n"
    s = s + "    let ex0 = t_zeros(T * d); nn_gelu_fwd(eo0, ex0, T * d)\n"
    s = s + "    let ex1 = t_zeros(T * d); nn_gelu_fwd(eo1, ex1, T * d)\n"
    s = s + "    let mut j = 0\n"
    s = s + "    while j < T * d {\n"
    s = s + "        t_set(ex_out, 0 * T * d + j, t_get(ex0, j))\n"
    s = s + "        t_set(ex_out, 1 * T * d + j, t_get(ex1, j))\n"
    s = s + "        j = j + 1\n"
    s = s + "    }\n"
    s = s + "    let y = t_zeros(T * d)\n"
    s = s + "    nn_moe_router_fwd(logits_r, ex_out, probs, y, T, E, d)\n"
    s = s + "    let meanN = t_zeros(1)\n"
    s = s + "    nn_groupnorm_fwd(y, noG, noB, yn, meanN, invN, xhatN, T, d, 1)\n"
    s = s + "    conv1d_via_forge(yn, roWq, roB, out_logits, T, d, V, 1, 1)\n"
    s = s + "}\n\n"
    return s
}

fn _ce_grad_src() -> string {
    let mut s = ""
    s = s + "fn clm_ce_grad(logits: int, targets: int, dlogits_out: int, T: int, V: int) {\n"
    s = s + "    let mut t = 0\n"
    s = s + "    while t < T {\n"
    s = s + "        let base = t * V\n"
    s = s + "        let mut mx = t_get(logits, base)\n"
    s = s + "        let mut i = 1\n"
    s = s + "        while i < V { let v = t_get(logits, base + i); if v > mx { mx = v }; i = i + 1 }\n"
    s = s + "        let mut sm = 0.0\n"
    s = s + "        let mut i2 = 0\n"
    s = s + "        while i2 < V { sm = sm + exp(t_get(logits, base + i2) - mx); i2 = i2 + 1 }\n"
    s = s + "        let invT = 1.0 / to_float(T)\n"
    s = s + "        let mut v3 = 0\n"
    s = s + "        while v3 < V {\n"
    s = s + "            let p = exp(t_get(logits, base + v3) - mx) / sm\n"
    s = s + "            t_set(dlogits_out, base + v3, p * invT)\n"
    s = s + "            v3 = v3 + 1\n"
    s = s + "        }\n"
    s = s + "        let tgt = to_int(t_get(targets, t))\n"
    s = s + "        t_set(dlogits_out, base + tgt, t_get(dlogits_out, base + tgt) - invT)\n"
    s = s + "        t = t + 1\n"
    s = s + "    }\n"
    s = s + "}\n\n"
    return s
}

fn _bwd_chain_src() -> string {
    let mut s = ""
    s = s + "fn clm_prod_bwd(dlogits: int, tokens: int,\n"
    s = s + "               embed: int, ecWq: int, tcWq: int, tgG: int, rWq: int, e0Wq: int, e1Wq: int, noG: int, roWq: int,\n"
    s = s + "               ecM: int, tcM: int, e0M: int, e1M: int, rM: int, roM: int,\n"
    s = s + "               xe: int, xec: int, xt: int, hn0: int, xhat0: int, inv0: int,\n"
    s = s + "               eo0: int, eo1: int, probs: int, ex_out: int, yn: int, xhatN: int, invN: int,\n"
    s = s + "               dembed: int, decW: int, decB: int, dtcW: int, dtcB: int, dtgG: int, dtgB: int,\n"
    s = s + "               drW: int, drB: int, de0W: int, de0B: int, de1W: int, de1B: int,\n"
    s = s + "               dnoG: int, dnoB: int, droW: int, droB: int,\n"
    s = s + "               T: int, d: int, E: int, V: int, K: int) {\n"
    s = s + "    let dynorm = t_zeros(T * d)\n"
    s = s + "    let droWq = t_zeros(V * d)\n"
    s = s + "    conv1d_bwd_via_forge(yn, roWq, dlogits, droWq, dynorm, droB, T, d, V, 1, 1)\n"
    s = s + "    nn_int4_quant_bwd(droWq, roM, droW, V, d)\n"
    s = s + "    let dy = t_zeros(T * d)\n"
    s = s + "    nn_groupnorm_bwd(xhatN, invN, noG, dynorm, dnoG, dnoB, dy, T, d, 1)\n"
    s = s + "    let dlogits_r = t_zeros(T * E)\n"
    s = s + "    let dex_out = t_zeros(E * T * d)\n"
    s = s + "    nn_moe_router_bwd(probs, ex_out, dy, dlogits_r, dex_out, T, E, d)\n"
    s = s + "    let dxt_r = t_zeros(T * d); let drWq = t_zeros(E * d)\n"
    s = s + "    conv1d_bwd_via_forge(xt, rWq, dlogits_r, drWq, dxt_r, drB, T, d, E, 1, 1)\n"
    s = s + "    nn_int4_quant_bwd(drWq, rM, drW, E, d)\n"
    s = s + "    let dex0 = t_zeros(T * d); let dex1 = t_zeros(T * d)\n"
    s = s + "    let mut ei = 0\n"
    s = s + "    while ei < T * d {\n"
    s = s + "        t_set(dex0, ei, t_get(dex_out, 0 * T * d + ei))\n"
    s = s + "        t_set(dex1, ei, t_get(dex_out, 1 * T * d + ei))\n"
    s = s + "        ei = ei + 1\n"
    s = s + "    }\n"
    s = s + "    let deo0 = t_zeros(T * d); nn_gelu_bwd(eo0, dex0, deo0, T * d)\n"
    s = s + "    let deo1 = t_zeros(T * d); nn_gelu_bwd(eo1, dex1, deo1, T * d)\n"
    s = s + "    let dxt_e0 = t_zeros(T * d); let de0Wq = t_zeros(d * d * K)\n"
    s = s + "    conv1d_bwd_via_forge(xt, e0Wq, deo0, de0Wq, dxt_e0, de0B, T, d, d, K, 1)\n"
    s = s + "    nn_int4_quant_bwd(de0Wq, e0M, de0W, d, d * K)\n"
    s = s + "    let dxt_e1 = t_zeros(T * d); let de1Wq = t_zeros(d * d * K)\n"
    s = s + "    conv1d_bwd_via_forge(xt, e1Wq, deo1, de1Wq, dxt_e1, de1B, T, d, d, K, 1)\n"
    s = s + "    nn_int4_quant_bwd(de1Wq, e1M, de1W, d, d * K)\n"
    s = s + "    let dxt = t_zeros(T * d)\n"
    s = s + "    let mut xi = 0\n"
    s = s + "    while xi < T * d {\n"
    s = s + "        t_set(dxt, xi, t_get(dxt_r, xi) + t_get(dxt_e0, xi) + t_get(dxt_e1, xi))\n"
    s = s + "        xi = xi + 1\n"
    s = s + "    }\n"
    s = s + "    let dhn0 = t_zeros(T * d); nn_gelu_bwd(hn0, dxt, dhn0, T * d)\n"
    s = s + "    let dh0 = t_zeros(T * d)\n"
    s = s + "    nn_groupnorm_bwd(xhat0, inv0, tgG, dhn0, dtgG, dtgB, dh0, T, d, 1)\n"
    s = s + "    let dxec_b = t_zeros(T * d); let dtcWq = t_zeros(d * d * K)\n"
    s = s + "    conv1d_bwd_via_forge(xec, tcWq, dh0, dtcWq, dxec_b, dtcB, T, d, d, K, 1)\n"
    s = s + "    nn_int4_quant_bwd(dtcWq, tcM, dtcW, d, d * K)\n"
    s = s + "    let dxec = t_zeros(T * d)\n"
    s = s + "    let mut ci = 0\n"
    s = s + "    while ci < T * d { t_set(dxec, ci, t_get(dxt, ci) + t_get(dxec_b, ci)); ci = ci + 1 }\n"
    s = s + "    let dxe = t_zeros(T * d); let decWq = t_zeros(d * d * K)\n"
    s = s + "    conv1d_bwd_via_forge(xe, ecWq, dxec, decWq, dxe, decB, T, d, d, K, 1)\n"
    s = s + "    nn_int4_quant_bwd(decWq, ecM, decW, d, d * K)\n"
    s = s + "    let mut zi = 0\n"
    s = s + "    while zi < V * d { t_set(dembed, zi, 0.0); zi = zi + 1 }\n"
    s = s + "    nn_embedding_bwd_scatter(dxe, tokens, dembed, T, d)\n"
    s = s + "}\n\n"
    return s
}

fn _adam_helper_src() -> string {
    let mut s = ""
    s = s + "fn _adam(W: int, gW: int, m: int, v: int, n: int, t: int) {\n"
    s = s + "    opt_adamw_step(W, gW, m, v, n, 0.05, 0.9, 0.999, 0.00000001, 0.0, t)\n"
    s = s + "}\n\n"
    return s
}

fn _corpus_windows_src() -> string {
    let mut s = ""
    s = s + "fn clm_corpus_windows(bytes_arr: int, n_bytes: int, IDS: int, TGT: int,\n"
    s = s + "                      nsamp: int, T: int, stride: int) -> int {\n"
    s = s + "    let mut filled = 0\n"
    s = s + "    let mut s = 0\n"
    s = s + "    while s < nsamp {\n"
    s = s + "        let off = s * stride\n"
    s = s + "        if off + T + 1 <= n_bytes {\n"
    s = s + "            let mut p = 0\n"
    s = s + "            while p < T {\n"
    s = s + "                t_set(IDS, s * T + p, to_float(bytes_arr[off + p]))\n"
    s = s + "                t_set(TGT, s * T + p, to_float(bytes_arr[off + p + 1]))\n"
    s = s + "                p = p + 1\n"
    s = s + "            }\n"
    s = s + "            filled = filled + 1\n"
    s = s + "        }\n"
    s = s + "        s = s + 1\n"
    s = s + "    }\n"
    s = s + "    return filled\n"
    s = s + "}\n\n"
    return s
}

// main() — config baked from spec; corpus path read from env at runtime.
fn _main_src(d: string, T: string, experts: string) -> string {
    let mut s = ""
    s = s + "fn main() {\n"
    s = s + "    println(\"clm_prod (dojo) — CLMConvMoE production corpus loop\")\n"
    s = s + "    let T = " + T + "; let d = " + d + "; let E = " + experts + "; let V = 256; let K = 3\n"
    s = s + "    let nsamp = 8\n"
    s = s + "    let dd = d * d * K; let ed = E * d; let vd = V * d\n"
    s = s + "\n"
    s = s + "    // corpus path: env CLM_PROD_CORPUS (run.sh exports the pulled HF corpus);\n"
    s = s + "    // empty → the in-repo cross-lingual fixture (machine-independent $0 verify).\n"
    s = s + "    let mut path = env_var(\"CLM_PROD_CORPUS\")\n"
    s = s + "    if len(path) == 0 { path = \"stdlib/flame/testdata/clm_semantic_parallel.txt\" }\n"
    s = s + "    let bytes_arr = read_file_bytes(path)\n"
    s = s + "    let n_bytes = len(bytes_arr)\n"
    s = s + "    let mut stride = (n_bytes - T - 1) / nsamp\n"
    s = s + "    if stride < 1 { stride = 1 }\n"
    s = s + "    print(\"  corpus: \"); print(path); print(\"  (\"); print(n_bytes); println(\" bytes, V=256)\")\n"
    s = s + "    let IDS = t_zeros(nsamp * T)\n"
    s = s + "    let TGT = t_zeros(nsamp * T)\n"
    s = s + "    let nwin = clm_corpus_windows(bytes_arr, n_bytes, IDS, TGT, nsamp, T, stride)\n"
    s = s + "    print(\"  windows: \"); print(nwin); print(\"/\"); print(nsamp)\n"
    s = s + "    print(\"  (T=\"); print(T); print(\" stride=\"); print(stride); println(\")\")\n"
    s = s + "    if nwin < 2 { println(\"F-CLM-PROD-DESCENT = 0\"); println(\"FAIL — corpus too short\"); return }\n"
    s = s + "\n"
    s = s + "    let embed=t_zeros(vd); t_fill_lcg(embed, vd, 1, 0.3)\n"
    s = s + "    let ecW=t_zeros(dd); t_fill_lcg(ecW, dd, 2, 0.2); let ecB=t_zeros(d); t_fill_lcg(ecB, d, 3, 0.1)\n"
    s = s + "    let tcW=t_zeros(dd); t_fill_lcg(tcW, dd, 4, 0.2); let tcB=t_zeros(d); t_fill_lcg(tcB, d, 5, 0.1)\n"
    s = s + "    let tgG=t_zeros(d); t_fill_lcg(tgG, d, 6, 0.5); let tgB=t_zeros(d); t_fill_lcg(tgB, d, 7, 0.1)\n"
    s = s + "    let rW=t_zeros(ed); t_fill_lcg(rW, ed, 12, 0.2); let rB=t_zeros(E); t_fill_lcg(rB, E, 13, 0.1)\n"
    s = s + "    let e0W=t_zeros(dd); t_fill_lcg(e0W, dd, 14, 0.2); let e0B=t_zeros(d); t_fill_lcg(e0B, d, 15, 0.1)\n"
    s = s + "    let e1W=t_zeros(dd); t_fill_lcg(e1W, dd, 16, 0.2); let e1B=t_zeros(d); t_fill_lcg(e1B, d, 17, 0.1)\n"
    s = s + "    let noG=t_zeros(d); t_fill_lcg(noG, d, 18, 0.5); let noB=t_zeros(d); t_fill_lcg(noB, d, 19, 0.1)\n"
    s = s + "    let roW=t_zeros(vd); t_fill_lcg(roW, vd, 20, 0.2); let roB=t_zeros(V); t_fill_lcg(roB, V, 21, 0.1)\n"
    s = s + "\n"
    s = s + "    let dembed=t_zeros(vd); let decW=t_zeros(dd); let decB=t_zeros(d)\n"
    s = s + "    let dtcW=t_zeros(dd); let dtcB=t_zeros(d); let dtgG=t_zeros(d); let dtgB=t_zeros(d)\n"
    s = s + "    let drW=t_zeros(ed); let drB=t_zeros(E)\n"
    s = s + "    let de0W=t_zeros(dd); let de0B=t_zeros(d); let de1W=t_zeros(dd); let de1B=t_zeros(d)\n"
    s = s + "    let dnoG=t_zeros(d); let dnoB=t_zeros(d); let droW=t_zeros(vd); let droB=t_zeros(V)\n"
    s = s + "    let m_embed=t_zeros(vd); let v_embed=t_zeros(vd)\n"
    s = s + "    let m_ecW=t_zeros(dd); let v_ecW=t_zeros(dd); let m_ecB=t_zeros(d); let v_ecB=t_zeros(d)\n"
    s = s + "    let m_tcW=t_zeros(dd); let v_tcW=t_zeros(dd); let m_tcB=t_zeros(d); let v_tcB=t_zeros(d)\n"
    s = s + "    let m_tgG=t_zeros(d); let v_tgG=t_zeros(d); let m_tgB=t_zeros(d); let v_tgB=t_zeros(d)\n"
    s = s + "    let m_rW=t_zeros(ed); let v_rW=t_zeros(ed); let m_rB=t_zeros(E); let v_rB=t_zeros(E)\n"
    s = s + "    let m_e0W=t_zeros(dd); let v_e0W=t_zeros(dd); let m_e0B=t_zeros(d); let v_e0B=t_zeros(d)\n"
    s = s + "    let m_e1W=t_zeros(dd); let v_e1W=t_zeros(dd); let m_e1B=t_zeros(d); let v_e1B=t_zeros(d)\n"
    s = s + "    let m_noG=t_zeros(d); let v_noG=t_zeros(d); let m_noB=t_zeros(d); let v_noB=t_zeros(d)\n"
    s = s + "    let m_roW=t_zeros(vd); let v_roW=t_zeros(vd); let m_roB=t_zeros(V); let v_roB=t_zeros(V)\n"
    s = s + "    let ecWq=t_zeros(dd); let ecM=t_zeros(dd); let tcWq=t_zeros(dd); let tcM=t_zeros(dd)\n"
    s = s + "    let e0Wq=t_zeros(dd); let e0M=t_zeros(dd); let e1Wq=t_zeros(dd); let e1M=t_zeros(dd)\n"
    s = s + "    let rWq=t_zeros(ed); let rM=t_zeros(ed); let roWq=t_zeros(vd); let roM=t_zeros(vd)\n"
    s = s + "    let xe=t_zeros(T*d); let xec=t_zeros(T*d); let xt=t_zeros(T*d)\n"
    s = s + "    let hn0=t_zeros(T*d); let xhat0=t_zeros(T*d); let inv0=t_zeros(1)\n"
    s = s + "    let eo0=t_zeros(T*d); let eo1=t_zeros(T*d); let probs=t_zeros(T*E); let ex_out=t_zeros(E*T*d)\n"
    s = s + "    let yn=t_zeros(T*d); let xhatN=t_zeros(T*d); let invN=t_zeros(1)\n"
    s = s + "    let logits=t_zeros(T*V); let dlogits=t_zeros(T*V)\n"
    s = s + "    let tok=t_zeros(T); let tgt=t_zeros(T)\n"
    s = s + "\n"
    s = s + "    let epochs = 12\n"
    s = s + "    let steps = epochs * nwin\n"
    s = s + "    let mut sum_first = 0.0\n"
    s = s + "    let mut sum_last = 0.0\n"
    s = s + "    let mut step = 1\n"
    s = s + "    while step <= steps {\n"
    s = s + "        let w = (step - 1) % nwin\n"
    s = s + "        let mut p = 0\n"
    s = s + "        while p < T {\n"
    s = s + "            t_set(tok, p, t_get(IDS, w * T + p))\n"
    s = s + "            t_set(tgt, p, t_get(TGT, w * T + p))\n"
    s = s + "            p = p + 1\n"
    s = s + "        }\n"
    s = s + "        clm_prod_fwd(tok, embed, ecW, ecB, tcW, tcB, tgG, tgB, rW, rB,\n"
    s = s + "                    e0W, e0B, e1W, e1B, noG, noB, roW, roB,\n"
    s = s + "                    ecWq, ecM, tcWq, tcM, e0Wq, e0M, e1Wq, e1M, rWq, rM, roWq, roM,\n"
    s = s + "                    xe, xec, xt, hn0, xhat0, inv0, eo0, eo1, probs, ex_out, yn, xhatN, invN,\n"
    s = s + "                    logits, T, d, E, V, K)\n"
    s = s + "        let loss = nn_ce_loss_allpos(logits, tgt, T, V)\n"
    s = s + "        if step <= nwin { sum_first = sum_first + loss }\n"
    s = s + "        if step > steps - nwin { sum_last = sum_last + loss }\n"
    s = s + "        clm_ce_grad(logits, tgt, dlogits, T, V)\n"
    s = s + "        clm_prod_bwd(dlogits, tok, embed, ecWq, tcWq, tgG, rWq, e0Wq, e1Wq, noG, roWq,\n"
    s = s + "                    ecM, tcM, e0M, e1M, rM, roM,\n"
    s = s + "                    xe, xec, xt, hn0, xhat0, inv0, eo0, eo1, probs, ex_out, yn, xhatN, invN,\n"
    s = s + "                    dembed, decW, decB, dtcW, dtcB, dtgG, dtgB, drW, drB, de0W, de0B, de1W, de1B,\n"
    s = s + "                    dnoG, dnoB, droW, droB, T, d, E, V, K)\n"
    s = s + "        _adam(embed, dembed, m_embed, v_embed, vd, step)\n"
    s = s + "        _adam(ecW, decW, m_ecW, v_ecW, dd, step); _adam(ecB, decB, m_ecB, v_ecB, d, step)\n"
    s = s + "        _adam(tcW, dtcW, m_tcW, v_tcW, dd, step); _adam(tcB, dtcB, m_tcB, v_tcB, d, step)\n"
    s = s + "        _adam(tgG, dtgG, m_tgG, v_tgG, d, step);  _adam(tgB, dtgB, m_tgB, v_tgB, d, step)\n"
    s = s + "        _adam(rW, drW, m_rW, v_rW, ed, step);     _adam(rB, drB, m_rB, v_rB, E, step)\n"
    s = s + "        _adam(e0W, de0W, m_e0W, v_e0W, dd, step); _adam(e0B, de0B, m_e0B, v_e0B, d, step)\n"
    s = s + "        _adam(e1W, de1W, m_e1W, v_e1W, dd, step); _adam(e1B, de1B, m_e1B, v_e1B, d, step)\n"
    s = s + "        _adam(noG, dnoG, m_noG, v_noG, d, step);  _adam(noB, dnoB, m_noB, v_noB, d, step)\n"
    s = s + "        _adam(roW, droW, m_roW, v_roW, vd, step); _adam(roB, droB, m_roB, v_roB, V, step)\n"
    s = s + "        step = step + 1\n"
    s = s + "    }\n"
    s = s + "    let first_ce = sum_first / to_float(nwin)\n"
    s = s + "    let last_ce = sum_last / to_float(nwin)\n"
    s = s + "    print(\"  epoch-1 mean CE = \"); println(to_string(first_ce))\n"
    s = s + "    print(\"  epoch-\"); print(epochs); print(\" mean CE = \"); println(to_string(last_ce))\n"
    s = s + "    if last_ce < first_ce {\n"
    s = s + "        println(\"F-CLM-PROD-DESCENT = 1\")\n"
    s = s + "        println(\"PASS — real-corpus mean CE descends under int4 envelope\")\n"
    s = s + "        return\n"
    s = s + "    }\n"
    s = s + "    println(\"F-CLM-PROD-DESCENT = 0\")\n"
    s = s + "    println(\"FAIL\")\n"
    s = s + "}\n"
    return s
}

// ── run.sh glue (emitted-string content only) ────────────────────────
//
// HF pull → .limen extract → CLM_PROD_CORPUS export → hexa run → BOTH gates.

fn _clm_glue(slug: string, spec: DojoSpec) -> string {
    let dataset = spec_get_or(spec, "kosmos_dataset", "dancinlab/clm-h911-trainset-5lang-parallel")
    let host    = spec_get_or(spec, "host", "h100-1")
    let outdir  = spec_get_or(spec, "output_dir", "out")
    let mut s = ""
    s = s + "#!/usr/bin/env bash\n"
    s = s + "# dojo clm run glue — generated by stdlib/dojo/clm\n"
    s = s + "# slug: " + slug + "\n"
    s = s + "#\n"
    s = s + "# Pull the HF kosmos_dataset → extract .limen payloads to a plain\n"
    s = s + "# newline corpus → export CLM_PROD_CORPUS → hexa run job.hexa →\n"
    s = s + "# assert BOTH gates (F-CLM-PROD-DESCENT + util-GREEN). util is\n"
    s = s + "# reported HONESTLY (F-RFC046 1-4% util bottleneck) — never faked.\n"
    s = s + "set -euo pipefail\n"
    s = s + "cd \"$(dirname \"$0\")\"\n"
    s = s + "\n"
    s = s + "KOSMOS_DATASET=\"" + dataset + "\"\n"
    s = s + "HOST=\"" + host + "\"\n"
    s = s + "OUTPUT_DIR=\"" + outdir + "\"\n"
    s = s + "CORPUS_TXT=\"$PWD/corpus.txt\"\n"
    s = s + "\n"
    s = s + "# d16 governance — a FREE pool dry-run BEFORE any cost-bearing remote\n"
    s = s + "# launch catches import/path errors without renting GPU time:\n"
    s = s + "#   pool on $HOST 'python3 -c \"import datasets, huggingface_hub\"'\n"
    s = s + "\n"
    s = s + "# ── 1. pull HF dataset + extract .limen payloads → plain corpus ──\n"
    s = s + "# Each .limen packs newline records; extract the text payload to a\n"
    s = s + "# byte corpus clm_prod reads via read_file_bytes (V=256 byte-vocab).\n"
    s = s + "echo \"dojo clm: pulling $KOSMOS_DATASET → $CORPUS_TXT\"\n"
    s = s + "python3 - \"$KOSMOS_DATASET\" \"$CORPUS_TXT\" <<'PY'\n"
    s = s + "import sys, os, glob\n"
    s = s + "ds_id, out_path = sys.argv[1], sys.argv[2]\n"
    s = s + "from huggingface_hub import snapshot_download\n"
    s = s + "root = snapshot_download(repo_id=ds_id, repo_type=\"dataset\")\n"
    s = s + "limen = sorted(glob.glob(os.path.join(root, \"**\", \"*.limen\"), recursive=True))\n"
    s = s + "lines = []\n"
    s = s + "if limen:\n"
    s = s + "    # .limen = newline-delimited UTF-8 text records (limen pack format).\n"
    s = s + "    for fp in limen:\n"
    s = s + "        with open(fp, \"rb\") as fh:\n"
    s = s + "            for raw in fh.read().split(b\"\\n\"):\n"
    s = s + "                t = raw.decode(\"utf-8\", \"replace\").strip()\n"
    s = s + "                if t:\n"
    s = s + "                    lines.append(t)\n"
    s = s + "else:\n"
    s = s + "    # fallback: any .txt / .jsonl text payloads in the snapshot.\n"
    s = s + "    for fp in sorted(glob.glob(os.path.join(root, \"**\", \"*.txt\"), recursive=True)):\n"
    s = s + "        with open(fp, \"r\", encoding=\"utf-8\", errors=\"replace\") as fh:\n"
    s = s + "            for ln in fh:\n"
    s = s + "                ln = ln.strip()\n"
    s = s + "                if ln:\n"
    s = s + "                    lines.append(ln)\n"
    s = s + "if not lines:\n"
    s = s + "    sys.exit(f\"dojo clm: no .limen/.txt payload found under {root}\")\n"
    s = s + "with open(out_path, \"w\", encoding=\"utf-8\") as fh:\n"
    s = s + "    fh.write(\"\\n\".join(lines) + \"\\n\")\n"
    s = s + "print(f\"dojo clm: wrote {len(lines)} records → {out_path}\")\n"
    s = s + "PY\n"
    s = s + "\n"
    s = s + "# ── 2. export corpus + run the hexa-native CLMConvMoE driver ──\n"
    s = s + "export CLM_PROD_CORPUS=\"$CORPUS_TXT\"\n"
    s = s + "echo \"dojo clm: CLM_PROD_CORPUS=$CLM_PROD_CORPUS\"\n"
    s = s + "RUN_LOG=\"$PWD/train.$$.log\"\n"
    s = s + "hexa run job.hexa 2>&1 | tee \"$RUN_LOG\"\n"
    s = s + "\n"
    s = s + "# ── 3. gate A — F-CLM-PROD-DESCENT (mean CE strictly descends) ──\n"
    s = s + "if grep -q \"F-CLM-PROD-DESCENT = 1\" \"$RUN_LOG\"; then\n"
    s = s + "    echo \"GATE F-CLM-PROD-DESCENT: GREEN\"\n"
    s = s + "else\n"
    s = s + "    echo \"GATE F-CLM-PROD-DESCENT: RED\" >&2\n"
    s = s + "    exit 1\n"
    s = s + "fi\n"
    s = s + "\n"
    s = s + "# ── 4. gate B — util-GREEN (forge cuBLAS GPU utilisation) ──\n"
    s = s + "# HONEST: re-check the F-RFC046 util 1-4% bottleneck. Sample nvidia-smi\n"
    s = s + "# utilization during the run; GREEN only if sustained util passes the\n"
    s = s + "# threshold. If util stays in the 1-4% F-RFC046 band, this gate is RED\n"
    s = s + "# — report it honestly, do NOT fake GREEN (the host-backward bottleneck\n"
    s = s + "# is a known open RED until the forge backward fully rides cuBLAS).\n"
    s = s + "UTIL_THRESHOLD=\"${CLM_UTIL_THRESHOLD:-20}\"\n"
    s = s + "if command -v nvidia-smi >/dev/null 2>&1; then\n"
    s = s + "    UTIL=$(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits | head -1 | tr -d ' ')\n"
    s = s + "    echo \"dojo clm: GPU util=${UTIL}% (F-RFC046 threshold ${UTIL_THRESHOLD}%)\"\n"
    s = s + "    if [ \"${UTIL:-0}\" -ge \"$UTIL_THRESHOLD\" ]; then\n"
    s = s + "        echo \"GATE util-GREEN: GREEN (util ${UTIL}%)\"\n"
    s = s + "    else\n"
    s = s + "        echo \"GATE util-GREEN: RED (util ${UTIL}% < ${UTIL_THRESHOLD}% — F-RFC046 host-backward bottleneck)\" >&2\n"
    s = s + "        exit 2\n"
    s = s + "    fi\n"
    s = s + "else\n"
    s = s + "    echo \"GATE util-GREEN: SKIP (no nvidia-smi — CPU host; util-GREEN is an H100-only gate)\" >&2\n"
    s = s + "fi\n"
    s = s + "\n"
    s = s + "echo \"dojo clm: BOTH gates evaluated (see GATE lines above)\"\n"
    return s
}

// ── manifest.json (emitted-string content only) ──────────────────────

fn _clm_manifest(slug: string, spec: DojoSpec) -> string {
    let dataset = spec_get_or(spec, "kosmos_dataset", "dancinlab/clm-h911-trainset-5lang-parallel")
    let d       = spec_get_or(spec, "d", "768")
    let layers  = spec_get_or(spec, "layers", "12")
    let T       = spec_get_or(spec, "T", "24")
    let experts = spec_get_or(spec, "experts", "2")
    let host    = spec_get_or(spec, "host", "h100-1")
    let outdir  = spec_get_or(spec, "output_dir", "out")
    let mut s = ""
    s = s + "{\n"
    s = s + "  \"domain\": \"clm\",\n"
    s = s + "  \"slug\": \"" + slug + "\",\n"
    s = s + "  \"trainer\": \"clm_prod (CLMConvMoE, forge=cuBLAS, hexa-native — NOT HF Trainer)\",\n"
    s = s + "  \"spec\": {\n"
    s = s + "    \"kosmos_dataset\": \"" + dataset + "\",\n"
    s = s + "    \"d\": " + d + ",\n"
    s = s + "    \"layers\": " + layers + ",\n"
    s = s + "    \"T\": " + T + ",\n"
    s = s + "    \"experts\": " + experts + ",\n"
    s = s + "    \"host\": \"" + host + "\",\n"
    s = s + "    \"output_dir\": \"" + outdir + "\"\n"
    s = s + "  },\n"
    s = s + "  \"corpus_provenance\": {\n"
    s = s + "    \"source\": \"" + dataset + "\",\n"
    s = s + "    \"format\": \".limen-packed (newline UTF-8 records) → plain corpus.txt → CLM_PROD_CORPUS\",\n"
    s = s + "    \"byte_vocab\": 256,\n"
    s = s + "    \"fallback\": \"empty CLM_PROD_CORPUS → in-repo fixture stdlib/flame/testdata/clm_semantic_parallel.txt\"\n"
    s = s + "  },\n"
    s = s + "  \"gates\": [\n"
    s = s + "    \"F-CLM-PROD-DESCENT (mean CE strictly descends; verified baseline epoch-1 4.667 → epoch-12 1.298 on FLORES-200 5-lang)\",\n"
    s = s + "    \"util-GREEN (forge cuBLAS GPU util; re-checks F-RFC046 1-4% host-backward bottleneck — reported honestly)\"\n"
    s = s + "  ]\n"
    s = s + "}\n"
    return s
}
