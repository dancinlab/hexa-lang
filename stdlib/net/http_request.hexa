// HEXA Standard Library — net/http_request
//
// @version 0.1.0
// @capabilities [pure]
//
// HTTP/1.1 요청 파서. self/serve/http_server.hexa (컴파일러 내부)의
// parse_request / parse_query 를 사용자 응용 코드용으로 포팅한 버전.
//
// Request 는 struct 대신 map 으로 표현한다(기존 서버와의 호환). 맵 키:
//   method  : string    ("GET", "POST", ...)
//   path    : string    ("/api/ping")
//   query   : string    (물음표 뒤 전체 raw 문자열)
//   body    : string
//   remote  : string    (상위 계층이 채워넣음; 파서는 "")
//   headers : map       (키 소문자 정규화)

// -- Parse raw HTTP request --

pub fn parse_request(raw) {
    let mut method = "GET"
    let mut path = "/"
    let mut query = ""
    let mut body = ""
    let mut headers = #{}

    // Split header block from body on the FIRST double CRLF only.
    // OP-92: split("\r\n\r\n") then parts[1] truncated any body that
    // itself contained a blank line (multipart forms, nested HTTP,
    // plain text with paragraph breaks) — parts[2..] were dropped.
    // index_of finds the first separator; everything after it (CRLFs
    // included) is the body, matching RFC 7230 message framing.
    let sep = raw.index_of("\r\n\r\n")
    let mut header_block = raw
    if sep >= 0 {
        header_block = raw.substring(0, sep)
        body = raw.substring(sep + 4, len(raw))
    }

    // Split header lines
    let lines = header_block.split("\r\n")
    if len(lines) > 0 {
        // Request line: "METHOD /path HTTP/1.1"
        let req_parts = lines[0].split(" ")
        if len(req_parts) >= 2 {
            method = req_parts[0]
            let full_path = req_parts[1]
            let qidx = full_path.index_of("?")
            if qidx >= 0 {
                path = full_path.substring(0, qidx)
                query = full_path.substring(qidx + 1, len(full_path))
            } else {
                path = full_path
            }
        }
    }

    // Parse headers
    let mut i = 1
    while i < len(lines) {
        let line = lines[i]
        let colon = line.index_of(":")
        if colon > 0 {
            let key = line.substring(0, colon).trim().to_lower()
            let val = line.substring(colon + 1, len(line)).trim()
            headers[key] = val
        }
        i = i + 1
    }

    let result = #{}
    result["method"] = method
    result["path"] = path
    result["query"] = query
    result["body"] = body
    result["remote"] = ""
    result["headers"] = headers
    return result
}

// -- Parse query string "a=1&b=2" into map --
//
// Matches urllib.parse.parse_qsl(keep_blank_values=True) shape (last
// value wins, like a map assignment):
//   - the value is split on the FIRST "=" only, so "a=b=c" -> a="b=c"
//     (a naive .split("=") would truncate the value at the first "=");
//   - an empty pair (from "a&&b" or a trailing "&") is SKIPPED, not
//     turned into a spurious "" key;
//   - a pair with no "=" ("flag") yields an empty value ("flag" -> "").

pub fn parse_query(qs) {
    let result = #{}
    if len(qs) == 0 { return result }
    let pairs = qs.split("&")
    let mut i = 0
    while i < len(pairs) {
        let pair = pairs[i]
        if len(pair) > 0 {
            let eq = pair.index_of("=")
            if eq >= 0 {
                // Split on the FIRST "=" only — keep "=" inside the value.
                result[pair.substring(0, eq)] = pair.substring(eq + 1, len(pair))
            } else {
                result[pair] = ""
            }
        }
        i = i + 1
    }
    return result
}

// -- Helper: get Content-Length header as int (0 if absent or invalid) --

pub fn content_length_of(request) {
    let headers = request["headers"]
    if type_of(headers) == "void" { return 0 }
    let v = headers["content-length"]
    if type_of(v) == "void" { return 0 }
    return to_int(v)
}
