// stdlib/loop/conjecture.hexa — exact-int verify-gate for `hexa loop --dfs`.
//
// THE WIRING (Ralph 378 · 2026-06-27): the LLM-DFS surface (stdlib/loop/dfs.hexa)
// previously gated LLM-proposed children ONLY on cite / English-only / non-trivial
// heuristics (dfs_verify_child) — an LLM arithmetic CONJECTURE could survive with
// NO exact-int check. This module connects that surface to the compiler's REAL
// exact-int verifier (compiler/atlas/identity_engine.hexa), the same engine
// `hexa drill` delegates to. An LLM child that declares a machine-checkable
// arithmetic relation must now PASS exact-int evaluation over n∈[2,N] (bounded-
// unique singleton n≥4, universal-in-[2,N], or a holding arithmetic-progression
// congruence) or it is dropped. A false guess is refuted by the verifier — the
// LLM proposes, exact-int disposes.
//
// Grammars accepted (the prompt in dfs.hexa asks the LLM to emit exactly one
// `CONJECTURE:` line per child in one of these · 18-fn vocab matches af() idx):
//   identity     :  A*B = C*D                 (e.g. phi*J2 = n*psi)
//   composition  :  f o g = <k>*n | <fn>+n | <fn>   (o = U+2218 ∘ · σ∘φ etc.)
//   congruence   :  seq(a*n+b) = 0 mod m      (e.g. partition(5n+4) = 0 mod 5)
// where A..,f,g,fn ∈ {sigma sigma2 sigma3 phi tau n sopfr rad J2 psi Omega omega
//   mu lam mu2 J3 tw_om core}  and  seq ∈ {partition bell fib lucas}.
//
// HONESTY (c2): a "verified" identity/composition is BOUNDED-UNIQUE (🟩, exact
// over [2,N]) or universal-in-[2,N]; a "verified" congruence holds for the
// sampled progression — the ∀n statement stays UNPROVEN until a proof lands. This
// gate never folds anything (atlas write = `hexa verify` g5 / PR path only); it
// only FILTERS LLM guesses to the exact-int-confirmed ones and labels each
// known (classical) vs novel (un-catalogued) for honest reporting.

use "compiler/atlas/identity_engine"

// ── 18-fn name -> af() index (mirror compiler/drill/drill.hexa::_fn_index) ──
fn _cj_fn_index(name: string) -> int {
    let s = name.trim()
    if s == "sigma"  { return 0 }
    if s == "sigma2" { return 1 }
    if s == "sigma3" { return 2 }
    if s == "phi"    { return 3 }
    if s == "tau"    { return 4 }
    if s == "n"      { return 5 }
    if s == "sopfr"  { return 6 }
    if s == "rad"    { return 7 }
    if s == "J2"     { return 8 }
    if s == "psi"    { return 9 }
    if s == "Omega"  { return 10 }
    if s == "omega"  { return 11 }
    if s == "mu"     { return 12 }
    if s == "lam"    { return 13 }
    if s == "mu2"    { return 14 }
    if s == "J3"     { return 15 }
    if s == "tw_om"  { return 16 }
    if s == "core"   { return 17 }
    return 0 - 1
}

// af() index -> name (inverse · for canonical known-set key)
fn _cj_fn_name(idx: int) -> string {
    if idx == 0  { return "sigma" }
    if idx == 1  { return "sigma2" }
    if idx == 2  { return "sigma3" }
    if idx == 3  { return "phi" }
    if idx == 4  { return "tau" }
    if idx == 5  { return "n" }
    if idx == 6  { return "sopfr" }
    if idx == 7  { return "rad" }
    if idx == 8  { return "J2" }
    if idx == 9  { return "psi" }
    if idx == 10 { return "Omega" }
    if idx == 11 { return "omega" }
    if idx == 12 { return "mu" }
    if idx == 13 { return "lam" }
    if idx == 14 { return "mu2" }
    if idx == 15 { return "J3" }
    if idx == 16 { return "tw_om" }
    if idx == 17 { return "core" }
    return ""
}

// non-negative integer parse (optional leading '+'); -1 on any non-digit char or
// empty. Avoids try/catch fragility for the small numeric tokens we parse.
fn _cj_parse_int(s: string) -> int {
    let t = s.trim()
    if len(t) == 0 { return 0 - 1 }
    let mut i = 0
    if t.substring(0, 1) == "+" { i = 1 }
    if i >= len(t) { return 0 - 1 }
    let mut n = 0
    while i < len(t) {
        let c = t.substring(i, i + 1)
        if c == "0" { n = n * 10 + 0 }
        else if c == "1" { n = n * 10 + 1 }
        else if c == "2" { n = n * 10 + 2 }
        else if c == "3" { n = n * 10 + 3 }
        else if c == "4" { n = n * 10 + 4 }
        else if c == "5" { n = n * 10 + 5 }
        else if c == "6" { n = n * 10 + 6 }
        else if c == "7" { n = n * 10 + 7 }
        else if c == "8" { n = n * 10 + 8 }
        else if c == "9" { n = n * 10 + 9 }
        else { return 0 - 1 }
        i = i + 1
    }
    return n
}

// Greek glyph -> ASCII fn-name normalization (subset that occurs in this atlas's
// vocabulary). Lets the LLM write `sigma∘phi = 2n` interchangeably with ASCII.
fn _cj_normalize(s: string) -> string {
    let mut r = s
    r = r.replace("σ", "sigma")
    r = r.replace("ς", "sigma")
    r = r.replace("φ", "phi")
    r = r.replace("ϕ", "phi")
    r = r.replace("τ", "tau")
    r = r.replace("ψ", "psi")
    r = r.replace("μ", "mu")
    r = r.replace("λ", "lam")
    r = r.replace("Ω", "Omega")
    r = r.replace("ω", "omega")
    r = r.replace("·", "*")
    r = r.replace("×", "*")
    r = r.replace("²", "2")
    return r
}

// ── identity parse: "A*B = C*D" -> [a,b,c,d] (af idx), else [] ──
fn _cj_parse_identity(expr: string) -> array {
    let empty: array = []
    let mut e = expr
    e = e.replace(" ", "")
    let sides = e.split("=")
    if len(sides) != 2 { return empty }
    let lhs = to_string(sides[0]).split("*")
    let rhs = to_string(sides[1]).split("*")
    if len(lhs) != 2 || len(rhs) != 2 { return empty }
    let a = _cj_fn_index(to_string(lhs[0]))
    let b = _cj_fn_index(to_string(lhs[1]))
    let c = _cj_fn_index(to_string(rhs[0]))
    let d = _cj_fn_index(to_string(rhs[1]))
    if a < 0 || b < 0 || c < 0 || d < 0 { return empty }
    let mut out: array = []
    out.push(a); out.push(b); out.push(c); out.push(d)
    return out
}

// canonical "A*B = C*D" key (factors-in-side sorted, sides sorted) so commutative
// restatements collapse — mirrors drill::_canon_identity for the known-set check.
fn _cj_canon_identity(a: int, b: int, c: int, d: int) -> string {
    let mut l0 = a
    let mut l1 = b
    if l1 < l0 { let t = l0; l0 = l1; l1 = t }
    let mut r0 = c
    let mut r1 = d
    if r1 < r0 { let t = r0; r0 = r1; r1 = t }
    let lhs_first = l0 < r0 || (l0 == r0 && l1 <= r1)
    if lhs_first {
        return _cj_fn_name(l0) + "*" + _cj_fn_name(l1) + " = " + _cj_fn_name(r0) + "*" + _cj_fn_name(r1)
    }
    return _cj_fn_name(r0) + "*" + _cj_fn_name(r1) + " = " + _cj_fn_name(l0) + "*" + _cj_fn_name(l1)
}

// G1-G3 documented classical bounded-unique identities (identity_engine selftest
// sanity family + commutative twins, collapsed by canon). True = classical/known.
fn _cj_is_known_identity(a: int, b: int, c: int, d: int) -> bool {
    let canon = _cj_canon_identity(a, b, c, d)
    if canon == _cj_canon_identity(3, 8, 5, 9) { return true }   // G1 phi*J2 = n*psi
    if canon == _cj_canon_identity(3, 8, 6, 9) { return true }   // G2 phi*J2 = sopfr*psi
    if canon == _cj_canon_identity(0, 9, 1, 3) { return true }   // G3 sigma*psi = sigma2*phi
    return false
}

// ── composition parse: "f o g = <k>*n | <fn>+n | <fn>" -> [f,g,mode,p], else [] ──
// (mirror drill::_parse_composition · '∘' U+2218 the composition operator)
fn _cj_parse_composition(expr: string) -> array {
    let empty: array = []
    let mut e = expr
    e = e.replace(" ", "")
    let sides = e.split("=")
    if len(sides) != 2 { return empty }
    let lhs = to_string(sides[0]).split("∘")
    if len(lhs) != 2 { return empty }
    let f = _cj_fn_index(to_string(lhs[0]))
    let g = _cj_fn_index(to_string(lhs[1]))
    if f < 0 || g < 0 { return empty }
    let rhs = to_string(sides[1])
    // mode 1: <fn>+n
    let plus = rhs.split("+")
    if len(plus) == 2 && to_string(plus[1]) == "n" {
        let h1 = _cj_fn_index(to_string(plus[0]))
        if h1 < 0 { return empty }
        let mut o1: array = []
        o1.push(f); o1.push(g); o1.push(1); o1.push(h1)
        return o1
    }
    // mode 0: <k>*n  or  <k>n
    let star = rhs.split("*")
    let mut knum = ""
    if len(star) == 2 && to_string(star[1]) == "n" {
        knum = to_string(star[0])
    } else {
        let L = len(rhs)
        if L >= 2 && rhs.substring(L - 1, L) == "n" { knum = rhs.substring(0, L - 1) }
    }
    if len(knum) > 0 {
        let k = _cj_parse_int(knum)
        if k >= 0 {
            let mut o0: array = []
            o0.push(f); o0.push(g); o0.push(0); o0.push(k)
            return o0
        }
    }
    // mode 2: <fn>
    let h2 = _cj_fn_index(rhs)
    if h2 >= 0 {
        let mut o2: array = []
        o2.push(f); o2.push(g); o2.push(2); o2.push(h2)
        return o2
    }
    return empty
}

// classical bounded-unique composition: σ∘φ=2n ⟺ n=1209 (f=0,g=3,mode=0,p=2).
fn _cj_is_known_composition(f: int, g: int, mode: int, p: int) -> bool {
    if f == 0 && g == 3 && mode == 0 && p == 2 { return true }
    return false
}

// ── congruence parse: "seq(a*n+b) = 0 mod m" -> [which,a,b,m], else [] ──
fn _cj_seq_which(name: string) -> int {
    let s = name.trim()
    if s == "partition" || s == "p" || s == "P" { return 0 }
    if s == "bell" || s == "B" { return 2 }
    if s == "fib" || s == "fibonacci" || s == "F" { return 3 }
    if s == "lucas" || s == "L" { return 4 }
    return 0 - 1
}

fn _cj_parse_congruence(expr: string) -> array {
    let empty: array = []
    let mut e = expr
    e = e.replace("≡", "=")
    e = e.replace(" ", "")
    let mi = e.index_of("mod")
    if mi < 0 { return empty }
    let m_str = e.substring(mi + 3, len(e))
    let head = e.substring(0, mi)            // "seq(a*n+b)=0"
    let eqi = head.index_of("=")
    if eqi < 0 { return empty }
    if head.substring(eqi + 1, len(head)).trim() != "0" { return empty }
    let lhs0 = head.substring(0, eqi)        // "seq(a*n+b)"
    let lpi = lhs0.index_of("(")
    let rpi = lhs0.index_of(")")
    if lpi < 0 || rpi <= lpi { return empty }
    let which = _cj_seq_which(lhs0.substring(0, lpi))
    if which < 0 { return empty }
    let mut inner = lhs0.substring(lpi + 1, rpi)  // "a*n+b" / "5n+4"
    inner = inner.replace("*", "")               // "5n+4"
    let mut beta = 0
    let mut anpart = inner
    let pi = inner.index_of("+")
    if pi >= 0 {
        anpart = inner.substring(0, pi)
        beta = _cj_parse_int(inner.substring(pi + 1, len(inner)))
        if beta < 0 { return empty }
    }
    let ni = anpart.index_of("n")
    if ni < 0 { return empty }
    let alpha_str = anpart.substring(0, ni)
    let mut alpha = 1
    if len(alpha_str) > 0 { alpha = _cj_parse_int(alpha_str) }
    let m = _cj_parse_int(m_str)
    if alpha <= 0 || m <= 0 { return empty }
    let mut out: array = []
    out.push(which); out.push(alpha); out.push(beta); out.push(m)
    return out
}

fn _cj_is_known_congruence(which: int, a: int, b: int, m: int) -> bool {
    // Ramanujan 1919: p(5n+4)≡0 mod5 · p(7n+5)≡0 mod7 · p(11n+6)≡0 mod11
    if which != 0 { return false }
    if a == 5 && b == 4 && m == 5 { return true }
    if a == 7 && b == 5 && m == 7 { return true }
    if a == 11 && b == 6 && m == 11 { return true }
    return false
}

// ── extract a single `CONJECTURE:` claim from a child body ──
// Scans lines for a marker prefix (CONJECTURE: / conjecture: / identity: /
// composition: / congruence:), tolerating a leading "- " front-matter dash.
// Returns the expression after the colon (trimmed), or "" if none present.
pub fn cj_extract(body: string) -> string {
    let lines = body.split("\n")
    let n = len(lines)
    let mut i = 0
    while i < n {
        let mut t = lines[i].trim()
        if t.starts_with("- ") { t = t.substring(2, len(t)).trim() }
        let v = _cj_marker_value(t)
        if len(v) > 0 { return v }
        i = i + 1
    }
    return ""
}

fn _cj_marker_value(line: string) -> string {
    let markers = ["CONJECTURE:", "Conjecture:", "conjecture:",
                   "IDENTITY:", "identity:", "COMPOSITION:", "composition:",
                   "CONGRUENCE:", "congruence:"]
    let mn = len(markers)
    let mut i = 0
    while i < mn {
        let m = to_string(markers[i])
        if line.starts_with(m) { return line.substring(len(m), len(line)).trim() }
        i = i + 1
    }
    return ""
}

// ── the verdict: route an extracted claim to the right exact-int verifier ──
// Returns one of:
//   ""               — no machine-checkable claim in the body (prose child)
//   "unparseable"    — a CONJECTURE: line present but grammar not recognized
//   "unverified"     — parsed, but exact-int evaluation REFUTES it
//   "verified-known" — exact-int confirmed AND in the documented classical set
//                      (G1-G3 / σ∘φ=2n / Ramanujan), OR a universal-in-[2,N] identity
//   "verified-novel" — exact-int confirmed AND NOT in any classical set
pub fn cj_verdict(body: string) -> string {
    let raw = cj_extract(body)
    if len(raw) == 0 { return "" }
    let expr = _cj_normalize(raw)
    let n_id = 20000
    let n_cong = 4000

    // congruence (has "mod")
    if expr.index_of("mod") >= 0 {
        let cg = _cj_parse_congruence(expr)
        if len(cg) != 4 { return "unparseable" }
        let r = verify_congruence(cg[0], cg[1], cg[2], cg[3], n_cong)
        if r == 1 {
            if _cj_is_known_congruence(cg[0], cg[1], cg[2], cg[3]) { return "verified-known" }
            return "verified-novel"
        }
        return "unverified"
    }

    // composition (has '∘')
    if expr.index_of("∘") >= 0 {
        let cp = _cj_parse_composition(expr)
        if len(cp) != 4 { return "unparseable" }
        let r = verify_composition(cp[0], cp[1], cp[2], cp[3], n_id)
        if r >= 4 {
            if _cj_is_known_composition(cp[0], cp[1], cp[2], cp[3]) { return "verified-known" }
            return "verified-novel"
        }
        return "unverified"
    }

    // identity (A*B = C*D)
    let idx = _cj_parse_identity(expr)
    if len(idx) != 4 { return "unparseable" }
    let r = verify_identity(idx[0], idx[1], idx[2], idx[3], n_id)
    if r >= 4 {
        if _cj_is_known_identity(idx[0], idx[1], idx[2], idx[3]) { return "verified-known" }
        return "verified-novel"
    }
    // bounded-unique failed — accept a universal-in-[2,N] relation as classical
    // (every clean 18-fn universal is classical/definitional · measured
    // vocab_universal_hunt.py CLEAN_GENERATORS=2, both classical).
    if is_universal2(idx[0], idx[1], idx[2], idx[3], n_id) == 1 { return "verified-known" }
    return "unverified"
}
