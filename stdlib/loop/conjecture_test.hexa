// stdlib/loop/conjecture_test.hexa — selftest for the exact-int verify-gate
// (Ralph 378). Proves cj_verdict routes an LLM-style child body through the
// REAL compiler exact-int verifier (compiler/atlas/identity_engine) and returns
// the honest verdict: a false guess is "unverified", a true relation is
// "verified-known"/"verified-novel", prose is "". Light closure (conjecture +
// identity_engine) — runs via `hexa run stdlib/loop/conjecture_test.hexa`.

use "stdlib/loop/conjecture"
use "stdlib/io"

fn body(claim: string) -> string {
    // mimic the child markdown the LLM emits — a CONJECTURE line inside prose.
    return "This child explores a sub-claim of the parent law.\n"
         + "CONJECTURE: " + claim + "\n"
         + "We expect the relation to hold for the multiplicative structure of n.\n"
}

fn gate(label: string, got: string, want: string) -> int {
    if got == want {
        println("  [PASS] " + label + "  -> " + got)
        return 0
    }
    println("  [FAIL] " + label + "  -> got '" + got + "' want '" + want + "'")
    return 1
}

fn main() {
    println("=== conjecture verify-gate SELFTEST (Ralph 378) ===")
    let mut f = 0

    // ── IDENTITY frame ──
    // G1 phi*J2 = n*psi — classical bounded-unique (identity_engine G1) -> known.
    f = f + gate("ID G1 phi*J2=n*psi (classical)", cj_verdict(body("phi*J2 = n*psi")), "verified-known")
    // G3 sigma*psi = sigma2*phi -> known.
    f = f + gate("ID G3 sigma*psi=sigma2*phi", cj_verdict(body("sigma*psi = sigma2*phi")), "verified-known")
    // A false product identity (no bounded-unique, not universal) -> unverified.
    f = f + gate("ID false sigma*tau=phi*phi", cj_verdict(body("sigma*tau = phi*phi")), "unverified")
    // 2-vs-1 form (phi*psi = J2) — the strict A*B=C*D grammar requires exactly two
    // factors per side (same as drill::_parse_identity), so this is unparseable.
    f = f + gate("ID 2-vs-1 phi*psi=J2 (grammar)", cj_verdict(body("phi*psi = J2")), "unparseable")
    // Commutative restatement phi*J2 = J2*phi holds for ALL n (universal-in-[2,N],
    // not a singleton) -> verified-known via is_universal2 (exercises that branch).
    f = f + gate("ID universal phi*J2=J2*phi", cj_verdict(body("phi*J2 = J2*phi")), "verified-known")

    // ── COMPOSITION frame (∘ = U+2218) ──
    // σ∘φ=2n is bounded-unique ⟺ n=1209 (identity_engine CMP5) — classical -> known.
    f = f + gate("COMP sigma o phi=2n (n=1209)", cj_verdict(body("sigma ∘ phi = 2*n")), "verified-known")
    // σ∘σ=2n is the superperfect SET (count 5, not a singleton) -> unverified by
    // the bounded-unique gate (honest: it is a family, not a singleton).
    f = f + gate("COMP sigma o sigma=2n (set)", cj_verdict(body("sigma ∘ sigma = 2*n")), "unverified")

    // ── CONGRUENCE frame ──
    // Ramanujan p(5n+4)≡0 mod5 — in the documented known set -> known.
    f = f + gate("CONG partition(5n+4)=0 mod5", cj_verdict(body("partition(5*n+4) = 0 mod 5")), "verified-known")
    // Watson's mod-25 extension p(25n+24)≡0 mod25 holds and is the classical
    // Ramanujan-Watson tower (24*24≡1 mod25, m=5^2) -> demoted to verified-known
    // by the C1-WATSON-TOWER closure (see below). NOT in the 3-element base table,
    // but classical (Watson 1938) -> honestly known, not novel.
    f = f + gate("CONG partition(25n+24)=0 mod25 (Watson)", cj_verdict(body("partition(25*n+24) = 0 mod 25")), "verified-known")
    // A false congruence p(5n+3)≡0 mod5 -> unverified.
    f = f + gate("CONG partition(5n+3)=0 mod5 (false)", cj_verdict(body("partition(5*n+3) = 0 mod 5")), "unverified")

    // ── NOVEL-CLOSURE gate (PR #4120 port) — false-positive demotion ──
    // The closure is what makes the engine's NOVEL verdict TRUSTWORTHY: an
    // exact-int-confirmed relation that is one of the four measured false-positive
    // classes (C1-C4) is DEMOTED from verified-novel to verified-known (true, but
    // not genuinely novel). Without the closure these would surface as "?NOVEL?".
    //
    // C4 BOUNDED-COINCIDENCE — a 2-vs-2 multiplicative bounded-unique singleton is
    // a coincidence, not a forall-n law. sigma*phi=tau*n holds at exactly n=6 over
    // [2,20000] (reference: ATLAS/state/novel-dfs singleton sweep) — exact-int
    // confirmed, NOT classical, but demoted by C4 -> verified-known (NOT novel).
    f = f + gate("CLO C4 sigma*phi=tau*n (n=6 coinc)", cj_verdict(body("sigma*phi = tau*n")), "verified-known")
    f = f + gate("CLO C4 sigma*tau=phi*J2 (n=6 coinc)", cj_verdict(body("sigma*tau = phi*J2")), "verified-known")
    // C3 SQUARE-SUPPORT — the singleton witness is a perfect square (lambda(square)
    // = +1 coincidence). phi*phi=sopfr*core holds at exactly n=16 -> demoted by C3.
    f = f + gate("CLO C3 phi*phi=sopfr*core (n=16 sq)", cj_verdict(body("phi*phi = sopfr*core")), "verified-known")
    // C1 ASSOC-CHAIN (congruence) — p(10n+9) = 0 mod5 is a sub-progression of the
    // base Ramanujan p(5n+4) = 0 mod5 (10n+9 = 5(2n+1)+4) -> a re-statement, demoted.
    f = f + gate("CLO C1 p(10n+9)=0 mod5 (subprog)", cj_verdict(body("partition(10*n+9) = 0 mod 5")), "verified-known")

    // closure CLASS tags (honest provenance for the PR reviewer) ──
    f = f + gate("CLOcls sigma*phi=tau*n -> C4", cj_closure_class(body("sigma*phi = tau*n")), "C4-COINCIDENCE")
    f = f + gate("CLOcls phi*phi=sopfr*core -> C3", cj_closure_class(body("phi*phi = sopfr*core")), "C3-SQUARE")
    f = f + gate("CLOcls p(10n+9)=0 mod5 -> C1", cj_closure_class(body("partition(10*n+9) = 0 mod 5")), "C1-ASSOC-CHAIN")
    // C1 WATSON-TOWER (measured live run #3, 2026-06-28) — the classical Ramanujan-
    // Watson partition tower: p(m·n+δ)≡0 mod m with 24δ≡1 mod m and m smooth over
    // {5,7,11}. Watson 1938 / Ahlgren-Ono 2000. The live LLM surfaced 12 of these
    // (mod 25/49/35/55/77/121) — all classical, demoted to verified-known / C1.
    // (Proven: NO simple linear partition congruence exists at a modulus with a
    // prime factor outside {5,7,11} — so this closes the simple-congruence space.)
    f = f + gate("CLO Watson p(25n+24)=0 mod25", cj_verdict(body("partition(25*n+24) = 0 mod 25")), "verified-known")
    f = f + gate("CLO Watson p(49n+47)=0 mod49", cj_verdict(body("partition(49*n+47) = 0 mod 49")), "verified-known")
    f = f + gate("CLO Watson p(35n+19)=0 mod35", cj_verdict(body("partition(35*n+19) = 0 mod 35")), "verified-known")
    f = f + gate("CLOcls p(25n+24)=0 mod25 -> C1-WATSON", cj_closure_class(body("partition(25*n+24) = 0 mod 25")), "C1-WATSON-TOWER")
    f = f + gate("CLOcls p(121n+116)=0 mod121 -> C1-WATSON", cj_closure_class(body("partition(121*n+116) = 0 mod 121")), "C1-WATSON-TOWER")
    // REGRESSION (2026-07-02) — a SUB-PROGRESSION of a tower modulus (a≠m) must NOT
    // survive as novel. p(50n+49)≡0 mod25 = p(25(2n+1)+24) is a trivial odd-index
    // sub-progression of Watson's p(25n+24); a=50≠m=25 slipped BOTH the old 3-base
    // table and the canonical a==m check → mislabelled verified-novel. Now C1.
    f = f + gate("CLO p(50n+49)=0 mod25 (Watson subprog)", cj_verdict(body("partition(50*n+49) = 0 mod 25")), "verified-known")
    f = f + gate("CLOcls p(50n+49)=0 mod25 -> C1", cj_closure_class(body("partition(50*n+49) = 0 mod 25")), "C1-ASSOC-CHAIN")
    // a classical-known relation is NOT closure-classified (returns "").
    f = f + gate("CLOcls phi*J2=n*psi (classical) -> empty", cj_closure_class(body("phi*J2 = n*psi")), "")

    // C5 RECURRENCE-PERIODIC — fib/lucas/bell are finite-state recurrences, so
    // their mod-m zero-set is structurally periodic (Pisano/Touchard); EVERY
    // holding congruence AP is classical (rank-of-apparition), never novel. These
    // exact CONJECTUREs were surfaced as raw "survivors" by the first live LLM run
    // (2026-06-28) and are now correctly demoted -> verified-known / C5.
    f = f + gate("CLO C5 fib(7n)=0 mod13 (apparition)", cj_verdict(body("fib(7*n) = 0 mod 13")), "verified-known")
    f = f + gate("CLO C5 fib(6n)=0 mod8 (F6=8)", cj_verdict(body("fib(6*n+0) = 0 mod 8")), "verified-known")
    f = f + gate("CLO C5 bell(3n+2)=0 mod2 (period3)", cj_verdict(body("bell(3*n+2) = 0 mod 2")), "verified-known")
    f = f + gate("CLO C5 lucas(4n+2)=0 mod3 (Pisano)", cj_verdict(body("lucas(4*n+2) = 0 mod 3")), "verified-known")
    f = f + gate("CLOcls fib(7n)=0 mod13 -> C5", cj_closure_class(body("fib(7*n) = 0 mod 13")), "C5-RECURRENCE-PERIODIC")
    // Partition (which 0) is NOT finite-state mod m -> a new-modulus partition
    // congruence is STILL the only thing that can survive (p(25n+24) mod25 above).

    // ── prose / unparseable ──
    // No CONJECTURE line -> "" (prose hypothesis, falls through the gate).
    f = f + gate("PROSE no claim", cj_verdict("Just a prose hypothesis about sigma growth, no formal relation."), "")
    // Claim present but vocab not recognized -> unparseable (grammar enforced).
    f = f + gate("UNPARSE foo*bar=baz*qux", cj_verdict(body("foo*bar = baz*qux")), "unparseable")
    // REGRESSION (2026-07-02) — congruence coefficient frame is strictly α·n. A
    // residual after 'n' (e.g. n^2) must NOT be silently dropped and re-read as
    // a DIFFERENT (linear) claim; it is unparseable. Guards the c2 mis-label where
    // "p(5n^2+4)=0 mod5" was verified AS "p(5n+4)=0 mod5".
    f = f + gate("UNPARSE p(5n^2+4)=0 mod5 (nonlinear)", cj_verdict(body("partition(5*n^2+4) = 0 mod 5")), "unparseable")
    // Greek glyphs accepted (σ·J2 = n·ψ == G1) -> known.
    f = f + gate("ID greek σ glyphs G1", cj_verdict(body("φ·J2 = n·ψ")), "verified-known")

    println("")
    if f == 0 {
        println("RESULT: PASS — exact-int verify-gate wired (LLM proposes, exact-int disposes)")
        exit(0)
    }
    println("RESULT: FAIL (" + to_string(f) + ")")
    exit(1)
}
