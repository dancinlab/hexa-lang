// Memory repro (da19aa72): hot loop, each iteration calls a fn that builds a
// transient push-grown array that does NOT escape (dropped at fn return).
// Baseline peak RSS scales LINEARLY with iteration count (true leak):
//   20k iters -> ~1.28 GB, 100k iters -> ~6.4 GB.
fn build_transient(n) {
  let mut xs = []
  let mut i = 0
  while i < n {
    xs = xs.push(i * 3 + 1)
    i = i + 1
  }
  let mut s = 0
  let mut j = 0
  while j < xs.len() { s = s + xs[j]; j = j + 1 }
  s
}
fn main() {
  let mut total = 0
  let mut k = 0
  while k < 20000 {
    total = total + build_transient(2000)
    k = k + 1
  }
  println(total)   // expect 119980000000
}
