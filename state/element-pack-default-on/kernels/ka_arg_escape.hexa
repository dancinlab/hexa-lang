// Ka — ESCAPE via function arg. xs is passed to sumarr() as a call-arg, which
// is NOT in the lattice whitelist (index/index_set/push/len/let only) -> the
// escape scan MUST void xs -> stays BOXED. OFF==ON expected.
fn sumarr(a: [i64], n: i64) -> i64 {
    let mut s = 0
    let mut k = 0
    while k < n {
        s = s + a[k]
        k = k + 1
    }
    return s
}
fn main() {
    let N = 64
    let mut xs: [i64] = []
    let mut i = 0
    while i < N {
        xs.push(i * 2 + 1)
        i = i + 1
    }
    let s = sumarr(xs, N)
    println(s)
}
