// K0 — POSITIVE CONTROL (packable). Array used ONLY via push/index/index_set.
// Lattice MUST keep this PACKED under HEXA_PACK_ARRAY=1. Tests the fast path's
// own bit-correctness: OFF==ON here proves packed raw-ALU emit is faithful.
fn main() {
    let N = 64
    let mut xs: [i64] = []
    let mut i = 0
    while i < N {
        xs.push(i * 2 + 1)
        i = i + 1
    }
    let mut acc = 0
    let mut j = 0
    while j < N {
        let v = xs[j]
        xs[j] = v + 7
        acc = acc + xs[j]
        j = j + 1
    }
    println(acc)
}
