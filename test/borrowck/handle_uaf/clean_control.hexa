// HEXA-OWN L5 R1 — HX3060 NEGATIVE control: the correct lifecycle.
//
// Two handles, every read strictly before its free, each freed exactly once.
// This is the shape virtually all real farr code has — if the rule fires here it
// has an FP on the shipping corpus and can never reach default-ON.
//
// Expect: HEXA_BORROWCK_HANDLE=1 → 0 HX3060.
fn main() {
    let a = farr_zeros(4)
    farr_set(a, 0, 111.0)

    let b = farr_zeros(4)
    farr_set(b, 0, 222.0)

    println("a[0] = " + to_string(farr_get(a, 0)))
    println("b[0] = " + to_string(farr_get(b, 0)))

    farr_free(a)
    farr_free(b)
}
