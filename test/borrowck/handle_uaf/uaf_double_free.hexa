// HEXA-OWN L5 R1 — HX3060 fixture: double free.
//
// The second `farr_free(t)` consumes an already-freed handle, corrupting the
// runtime freelist (the slot lands on it twice, so two future producers get the
// SAME slot back — the ABA in uaf_aba.hexa, but now guaranteed).
//
// The free SITE itself is silent (a handle's own consuming read is logged as a
// USE before its MOVE), so the FIRST free never fires — only the second one,
// whose arg-read sees the moved state.
//
// Expect: HEXA_BORROWCK_HANDLE=1 → exactly 1 HX3060, at the second farr_free.
fn main() {
    let t = farr_zeros(4)
    farr_set(t, 0, 1.0)

    farr_free(t)
    farr_free(t)                    // HX3060: `t` was already freed above

    println("done")
}
