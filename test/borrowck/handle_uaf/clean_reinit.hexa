// HEXA-OWN L5 R1 — HX3060 NEGATIVE control: free-then-reinitialize is LEGAL.
//
// Re-initializing a freed handle with a fresh producer call makes it usable
// again — exactly as rustc lets you assign to a moved-out place and use it. The
// assign arm re-points `t` to a FRESH group, so the post-reinit reads no longer
// name the freed slot and the checker must stay SILENT.
//
// This is the fixture that proves the rule is not simply "any read after any
// free". A checker that fires here is unshippable — it would flag correct code.
//
// Expect: HEXA_BORROWCK_HANDLE=1 → 0 HX3060.
fn main() {
    let mut t = farr_zeros(4)
    farr_set(t, 0, 1.0)
    farr_free(t)

    t = farr_zeros(8)               // legal re-initialization — `t` owns a NEW slot
    farr_set(t, 0, 2.0)
    println("t[0] = " + to_string(farr_get(t, 0)))

    farr_free(t)
}
