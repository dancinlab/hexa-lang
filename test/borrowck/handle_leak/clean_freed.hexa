// HEXA-OWN L5 R2 — HX3061 NEGATIVE control: a freed handle does NOT leak.
//
// Same as leak_simple but the function frees `t` before returning, discharging the
// obligation on the (single) exit path. A checker that fires here is unshippable.
//
// Expect: HEXA_BORROWCK_LEAK=1 → 0 HX3061.
fn main() {
    let t = farr_zeros(4)
    farr_set(t, 0, 1.0)
    farr_free(t)
    println("done")
}
