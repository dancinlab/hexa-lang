// test/op143_sort_stable.hexa — regression lock for OP-143
//
// @version 0.1.0
// @capabilities [pure]
//
// Run:  hexa build test/op143_sort_stable.hexa -o /tmp/op143.bin && /tmp/op143.bin
// Sentinel: __OP143_SORT_STABLE__ PASS|FAIL on the final line.
//
// CONTRACT (OP-143): stdlib/alloc/collections.sort() is STABLE — equal keys
// keep their relative input order, matching Python `sorted`. The prior
// selection-sort variant (swap on strict `<`) sorted keys correctly but was
// UNSTABLE: it could reverse equal-key elements. This test encodes equal
// keys as `k*10 + payload` so the SORTED-BY-KEY order is checkable on plain
// ints: after a stable sort, within each key block the payloads must stay in
// ascending input-emission order (the witness of stability).
//
// Encoding: value = key*10 + tag, sort by key (value/10). Stable sort keeps
// tags ascending within a key block; an unstable sort would scramble them.

import "stdlib/alloc/collections.hexa"

let mut PASS = 0
let mut FAIL = 0

fn check(label, cond) {
    if cond {
        PASS = PASS + 1
        println("[PASS] " + label)
    } else {
        FAIL = FAIL + 1
        println("[FAIL] " + label)
    }
}

fn key_of(v) { v / 10 }
fn tag_of(v) { v - (v / 10) * 10 }

// Assert: sorted by key ascending, and stable (tags ascending within a key run).
fn assert_sorted_stable(label, got) {
    let mut ok = true
    let mut i = 1
    while i < len(got) {
        let pk = key_of(got[i - 1])
        let ck = key_of(got[i])
        if ck < pk { ok = false }
        if ck == pk {
            // same key block — payload tags must be non-decreasing (stable)
            if tag_of(got[i]) < tag_of(got[i - 1]) { ok = false }
        }
        i = i + 1
    }
    check(label, ok)
}

// Case 1: [(1,a)=10,(1,b)=11,(0,c)=2] — equal-key 10,11 must NOT reverse.
assert_sorted_stable("eq-keys-1-1-0", sort([10, 11, 2]))

// Case 2: keys 2,1,2,1,2 with tags 0..4 → within key=1: tags 1,3 ; key=2: 0,2,4
assert_sorted_stable("interleaved-2-1-2-1-2", sort([20, 11, 22, 13, 24]))

// Case 3: all-equal key 0, tags 0..3 — must be identity-order
assert_sorted_stable("all-equal-key", sort([0, 1, 2, 3]))

// Case 4: 7 elements, keys {3,1,2,1,3,2,1} tags 0..6
assert_sorted_stable("seven-elem", sort([30, 11, 22, 13, 34, 25, 16]))

// Plain integer correctness (no stability concern)
let r = sort([5, 3, 8, 1, 9, 2, 7, 4, 6, 0])
let mut asc = true
let mut k = 1
while k < len(r) { if r[k] < r[k - 1] { asc = false }; k = k + 1 }
check("plain-ints-ascending", asc)
check("plain-ints-len", len(r) == 10)
check("singleton", len(sort([42])) == 1)
check("empty", len(sort([])) == 0)

// Negatives + dups
let n = sort([-3, 5, -1, 0, -2, 5, -3])
let mut nasc = true
let mut m = 1
while m < len(n) { if n[m] < n[m - 1] { nasc = false }; m = m + 1 }
check("negatives-dups-ascending", nasc)

if FAIL == 0 {
    println("__OP143_SORT_STABLE__ PASS")
} else {
    println("__OP143_SORT_STABLE__ FAIL")
}
