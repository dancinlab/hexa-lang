// ═══════════════════════════════════════════════════════════
//  t55_hexaw_farr32_rss.hexa — boxing-unbox r2 parity + RSS gate
//
//  Proves the hexaw HEXAW2 loader streams tensor payloads into a
//  farr32 handle (4 B/elem, RSS≈raw) instead of a boxed [float]
//  (~176 B/elem, the 44× blowup r1 measured). Two assertions:
//
//   1. PARITY — every loaded f32 is bit-identical to the value
//      decoded straight from the file bytes (read_bytes_at +
//      hexaw_bytes_to_f32, the same LE IEEE-754 decode the old
//      boxed path used). No value drift from the unbox.
//
//   2. RSS — resident set after loading a large synthetic tensor
//      is ~1× the raw f32 size, NOT 44×. Printed from
//      /proc/self/statm (Linux); on darwin the print is skipped
//      (statm absent) but parity still gates.
//
//  Run: hexa run test/t55_hexaw_farr32_rss.hexa
// ═══════════════════════════════════════════════════════════

use "../self/ml/hexaw"
use "self/stdlib/law_io"

let mut ok = true
fn must(label, cond) {
    if cond { println("  ok   " + label) }
    else    { println("  FAIL " + label); ok = false }
}

// ── RSS reader (Linux /proc/self/statm: size resident ...) ──
// Returns resident pages * 4096 bytes, or -1 if unavailable.
fn rss_bytes() {
    let src = read_file("/proc/self/statm")
    if len(src) < 1 { return -1 }
    let parts = src.split(" ")
    if len(parts) < 2 { return -1 }
    // field[1] = resident set size in pages
    return to_int(parts[1]) * 4096
}

// ── Build a synthetic HEXAW2 file with one big tensor ───────
//  N f32 values: v[i] = (i % 1000) * 0.5 - 250.0  (mix of signs,
//  all exactly representable in f32 so parity is exact).
let path = "/tmp/_t55_hexaw_farr32.hexaw"
let N = 4000000            // 4M f32 = 16 MB raw payload
let mut ref_vals = []      // boxed reference (small build window OK)
let mut payload = []
let mut i = 0
while i < N {
    let v = to_float(i % 1000) * 0.5 - 250.0
    ref_vals = ref_vals + [v]
    let bs = hexaw_f32_to_bytes(v)
    payload = payload + bs
    i = i + 1
}

// Header + payload, written as raw bytes (HEXAW2 layout).
let hdr = "HEXAW2\n1\nbig\n1\n" + to_string(N) + "\n" + to_string(N) + "\n"
let mut buf = []
let mut hi = 0
while hi < len(hdr) {
    buf = buf + [char_code(hdr, hi)]
    hi = hi + 1
}
buf = buf + payload
write_bytes(path, buf)

let rss_pre = rss_bytes()

// ── Load via the new farr32 loader ──────────────────────────
let hxw = hexaw_load(path)
must("1 tensor", len(hxw.names) == 1)
must("name == big", hxw.names[0] == "big")
must("count == N", hexaw_count(hxw, "big") == N)

let data = hexaw_tensor(hxw, "big")

let rss_post = rss_bytes()

// ── PARITY: spot-check + full scan (bit-exact) ──────────────
let mut parity_ok = true
let mut p = 0
while p < N {
    if farr32_get(data, p) != ref_vals[p] {
        if parity_ok {
            println("  parity diff idx=" + to_string(p)
                  + " got=" + to_string(farr32_get(data, p))
                  + " want=" + to_string(ref_vals[p]))
        }
        parity_ok = false
    }
    p = p + 1
}
must("parity: all N f32 bit-identical to file decode", parity_ok)

// ── RSS report (Linux) ──────────────────────────────────────
let raw_bytes = N * 4
if rss_pre >= 0 && rss_post >= 0 {
    let delta = rss_post - rss_pre
    let ratio = to_float(delta) / to_float(raw_bytes)
    println("[t55] raw f32 payload = " + to_string(raw_bytes) + " B (" + to_string(raw_bytes / 1048576) + " MB)")
    println("[t55] RSS pre-load    = " + to_string(rss_pre / 1048576) + " MB")
    println("[t55] RSS post-load   = " + to_string(rss_post / 1048576) + " MB")
    println("[t55] RSS delta       = " + to_string(delta / 1048576) + " MB")
    println("[t55] RSS/raw ratio   = " + to_string(ratio) + "x  (target ~1x; boxed was ~44x)")
    // Gate: farr32 resident must be well under the boxed 44x blowup.
    // Allow generous slack (≤4x) for the boxed ref_vals + transient build
    // arrays still live in this test process; the LOADER's contribution is
    // the farr32 (1x). On a real loader-only process this is ~1x.
    must("RSS delta < 8x raw (farr32, not 44x boxed)", to_float(delta) < 8.0 * to_float(raw_bytes))
} else {
    println("[t55] /proc/self/statm unavailable (darwin) — RSS gate skipped, parity still enforced")
}

if ok { println("PASS t55_hexaw_farr32_rss") } else { println("FAIL t55_hexaw_farr32_rss") }
