@discovery := "B3 real-trainer fwd megakernel — util-99%-path FALSIFIED on the real clm_prod step"
  id     = "F-FUSION-B3-REALTRAINER"
  domain = "HEXA-FUSION"
  date   = "2026-06-05"
  seed   = "wire B2 full-fwd megakernel (PR #2743) into REAL clm_prod_fwd; measure real-step util A/B at CE byte-eq"
  verdict-tier-target = "ruled-out axis (closed-negative on the real workload)"

  finding = "No megakernel realization BOTH passes CE byte-eq AND lifts real-step util."
  wall-1  = "B2's full-fwd megakernel pulls conv GEMMs INSIDE the cooperative launch as TF32 own-GEMM; real clm_prod GEMMs are FP64 cublasDgemm → TF32 ≠ FP64 → CE byte-eq HARD gate FAILS by construction (F-FUSION-MEGAKERNEL-DESIGN WALL 1)."
  wall-2  = "the byte-eq-SAFE glue-only megakernel was ALREADY built+fired+measured on real clm_prod_gpu (P2A, D1536 T512, B200): real-step util 10.71→10.63% Δ -0.08pp NOISE, byte-eq PASS — util-INERT."
  decisive-number = "real-step util eager→mega = 10.71% → 10.63% (Δ -0.08pp NOISE), median 2%, no lift above eager ~10-13%."
  util-ceiling = "NOT the launch gap — it is cuBLAS FP64 GEMM-gap occupancy (D1536 under-fills GPU) + single-thread byte-eq reduction floor; glue-boundary removal touches neither."

  wired   = "stdlib/flame/clm_prod.hexa _clm_megafwd gate + codegen builtin + runtime.h decls + runtime.c wrapper (env HEXA_CLM_MEGASTEP, eager FP64 fallback, byte-eq-safe, OFF default)"
  pod     = "none rented (decisive A/B already exists at P2A on the real trainer; new pod = budget-waste on a ruled-out axis); leak 0"
  next    = "the only util levers are (i) byte-eq FP64 own-GEMM register/WMMA tiling to close the FLOPS gap (P1B campaign, precision-gated) or (ii) larger-batch/right-sized GPU (reframes hardware, not the OCCUPANCY-WALL goal) — NOT glue megakernel-ization"
  link    = ".verdicts/hexa-fusion/F-FUSION-B3-REALTRAINER.txt · F-FUSION-P2A-MEGAKERNEL.txt · F-FUSION-MEGAKERNEL-DESIGN.txt · F-FUSION-B2-MEGAFWD.txt (branch domain/hexa-fusion-b2-megafwd, PR #2743)"
