// RUNG-2a inter-procedural ADVERSARY: MUTUALLY RECURSIVE callees (an SCC) that
// transitively stash a parameter into a global. The monotone worklist fixpoint
// MUST propagate param-Escape around the cycle (no topo order exists) → the cand
// escapes → the loop is REJECTED. EXPECT: 0 widened (FP=0). Proves the fixpoint
// handles recursion / SCC conservatively without an explicit Tarjan pass.
let mut SINK = []
fn ping(x, n) {
  if n > 0 {
    pong(x, n - 1)
  } else {
    SINK = x        // deep-recursion base case leaks the param to a global
  }
  0
}
fn pong(x, n) {
  ping(x, n - 1)    // mutual recursion — forwards the param straight back
  0
}
fn churn(m) {
  let mut acc = 0
  let mut a = 0
  while a < m {
    let mut t = []
    let mut b = 0
    while b < 12 { t = t.push(a + b); b = b + 1 }
    ping(t, 3)
    acc = acc + t[0]
    a = a + 1
  }
  acc
}
fn main() {
  println(churn(30))
  println(SINK.len())
}
