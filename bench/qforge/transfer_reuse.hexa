// ═══════════════════════════════════════════════════════════════════════════
//  QFORGE-PERF — TRANSFER / REUSE across the candidate pool (g5 bench)
//
//  Lifts the "transfer / reuse across candidate pool" probe ⚪ grounded →
//  TRAINED by REUSING hexa's EXISTING ML stack (d19) — stdlib/autograd
//  reverse-mode AD over Tensor, exactly the #2816 Δ-ML pattern (bias-augmented
//  MLP, tanh from ag_exp/ag_pow, Adam via ag_grad). NO autograd is built from
//  scratch; NO stdlib/qforge engine file is touched (d3). docs/bench-only,
//  CPU-only, no rent.
//      ag_var / ag_const / ag_add / ag_sub / ag_mul / ag_matmul / ag_exp
//      ag_pow / ag_backward / ag_grad / ag_value / ag_zero_grad / ag_tape_reset
//
//  ── THE TRANSFER CLAIM (d19 reuse-lattice as ML transfer) ─────────────────
//  A model TRAINED on a SOURCE candidate (material A) and then FINE-TUNED
//  (WARM-started from A's trained weights) on a chemically-SIMILAR target
//  candidate (material B) reaches B's target held-out accuracy in FEWER
//  training steps / with FEWER B-labels than training B from scratch (COLD,
//  random init). The "verified candidate" A is the artifact we REUSE — this is
//  precisely the d19 intra-domain reuse lattice expressed as ML transfer
//  ("ANTIMATTER trap reuses RTSC current_loop_offaxis", but for a learned Δλ).
//
//  ── THE TWO TASKS (related-but-shifted; "similar hydride") ────────────────
//  Source A:   f_A(x) = 0.6 sin(1.3 x0) + 0.5 x1^2 − 0.4 x0 x1 + 0.2 exp(0.5 x1)
//  Target B:   f_B(x) = f_A with PERTURBED coefficients + a small domain shift:
//              f_B(x) = 0.66 sin(1.43 x0) + 0.55 x1^2 − 0.44 x0 x1
//                       + 0.22 exp(0.5 x1)              [coeffs ×1.10]
//  i.e. B is the SAME functional family as A, scaled ~10% (a "chemically
//  similar" neighbour in the candidate pool). Same nonlinear + cross-term
//  structure, so the A-learned features transfer.
//
//  ── MODEL (reused verbatim from #2816) ───────────────────────────────────
//  MLP: 2-input → 8-hidden(tanh) → 1-output, biases folded into the weight
//  matrices via ones-column augmentation (dodges the autograd broadcast-add
//  bug — backward has no broadcast-reduce). tanh = (e^{2z}−1)/(e^{2z}+1) built
//  from ag_exp/ag_pow, fully traced. Adam update hand-rolled via ag_grad.
//
//  ── EXPERIMENT ───────────────────────────────────────────────────────────
//  (1) Train MLP on A to convergence  → A's trained weights wA (the reused
//      "verified candidate" artifact).
//  (2) WARM — init B's MLP FROM wA (warm-start), fine-tune on a SMALL B set
//      (Bsmall labels). Record B held-out MAE after each step → steps-to-target.
//  (3) COLD — init B's MLP RANDOMLY (fixed deterministic seed), train on the
//      SAME small B set, SAME optimiser recipe. Record the same curve.
//  Both runs use identical lr/Adam/epoch-budget on the SAME B-labels & held-out
//  set, so the only difference is the INIT (warm wA vs cold random).
//
//  ── g5 VERIFY (printed VERBATIM) ─────────────────────────────────────────
//  WARM reaches B's target held-out error in FEWER steps (or fewer B-labels)
//  than COLD, AND both reach the same B fixed point. Printed verbatim:
//    • steps-to-target: WARM vs COLD
//    • the B held-out MAE curve for WARM and for COLD (per checkpoint)
//    • the converged (final) B held-out MAE for each → same fixed point check
//  PASS iff warm_steps_to_target < cold_steps_to_target AND the two converged
//  MAEs agree (|Δ| within tol). d6: else honest FAIL with the numbers.
//
//  Run:  HEXA_LANG=. hexa run bench/qforge/transfer_reuse.hexa
// ═══════════════════════════════════════════════════════════════════════════

use "stdlib/tensor/mod"
use "stdlib/tensor/shape"
use "stdlib/tensor/ops"
use "stdlib/autograd"

fn abs_f(x: float) -> float { if x < 0.0 { return 0.0 - x } else { return x } }

// ── source A and target B targets (B = A with ~10% perturbed coefficients) ─
fn f_A(x0: float, x1: float) -> float {
    return 0.6 * sin(1.3 * x0) + 0.5 * x1 * x1 - 0.4 * x0 * x1 + 0.2 * exp(0.5 * x1)
}
fn f_B(x0: float, x1: float) -> float {
    return 0.66 * sin(1.43 * x0) + 0.55 * x1 * x1 - 0.44 * x0 * x1 + 0.22 * exp(0.5 * x1)
}

// ── deterministic LCG → reproducible datasets + weight inits ──────────────
let mut _seed = 1234567
fn rng() -> float {
    _seed = (_seed * 1103515245 + 12345) % 2147483648
    return to_float(_seed) / 2147483648.0   // ∈ [0,1)
}
fn runi(lo: float, hi: float) -> float { return lo + (hi - lo) * rng() }
fn seed_set(s: int) { _seed = s }

fn _const_fill(shape, v: float) -> array {
    let n = tensor_size(shape)
    let mut out = []
    let mut i = 0
    while i < n { out.push(v); i = i + 1 }
    return out
}

// ── tanh as a traced autograd subgraph: (e^{2z}-1)/(e^{2z}+1) ─────────────
fn ag_tanh(z) {
    let two = ag_const(tensor_from_array(z["tensor"].shape, _const_fill(z["tensor"].shape, 2.0)))
    let one = ag_const(tensor_from_array(z["tensor"].shape, _const_fill(z["tensor"].shape, 1.0)))
    let e2z = ag_exp(ag_mul(two, z))
    let num = ag_sub(e2z, one)
    let den = ag_add(e2z, one)
    let inv = ag_pow(den, 0.0 - 1.0)
    return ag_mul(num, inv)
}

// selector [H, H+1] with S[i,i]=1 (i<H), last column all 0.
fn _selector_HxHp1(H: int) -> Tensor {
    let mut d = []
    let mut i = 0
    while i < H {
        let mut j = 0
        while j < H + 1 {
            if j == i { d.push(1.0) } else { d.push(0.0) }
            j = j + 1
        }
        i = i + 1
    }
    return tensor_from_array([H, H + 1], d)
}

// ── MLP forward (all ag_*, BIAS-AUGMENTED so every tensor shape is EXACT) ─
fn mlp_forward(xaug, haug_ones, W1, W2, B: int, H: int) {
    let z1 = ag_matmul(xaug, W1)                     // [B,H]
    let h  = ag_tanh(z1)                             // [B,H]
    let S = ag_const(_selector_HxHp1(H))             // [H,H+1]
    let hsel = ag_matmul(h, S)                       // [B,H+1], last col 0
    let z2 = ag_matmul(ag_add(hsel, haug_ones), W2)  // + ones lastcol, then @W2
    return z2
}

// MSE loss over [B,1] pred vs [B,1] target → scalar ag handle (mean).
fn mse_loss(pred, target, B: int) {
    let diff = ag_sub(pred, target)
    let sq   = ag_mul(diff, diff)
    let onesT = ag_const(tensor_from_array([1, B], _const_fill([1, B], 1.0 / to_float(B))))
    return ag_matmul(onesT, sq)
}

fn pack_aug(c0, c1, n: int) -> array {
    let mut out = []; let mut j = 0
    while j < n { out.push(c0[j]); out.push(c1[j]); out.push(1.0); j = j + 1 }
    return out
}
fn ones_lastcol(n: int, Hp1: int) -> array {
    let mut out = []; let mut r = 0
    while r < n {
        let mut c = 0
        while c < Hp1 {
            if c == Hp1 - 1 { out.push(1.0) } else { out.push(0.0) }
            c = c + 1
        }
        r = r + 1
    }
    return out
}

// ── generic B fine-tuner (top-level so it does NOT rely on closing over
// outer locals — hexa nested fns don't capture outer-scope vars; all data is
// passed in explicitly). init_w1/init_w2 = starting weights (warm or cold).
// returns #{ label, cep:[], cmae:[], steps_to_target:int, final_mae:float }.
fn finetune_B(iw1, iw2, label: string, Xbs, onesBs, bsy, Xbt, onesBt, bty, ck, target_mae: float, epochsB: int, Bsmall: int) {
    let H = 8; let Bte = 40
    // local mutable copies of the weights
    let mut w1 = []; let mut q = 0
    while q < len(iw1) { w1.push(iw1[q]); q = q + 1 }
    let mut w2 = []; q = 0
    while q < len(iw2) { w2.push(iw2[q]); q = q + 1 }

    let mut m1 = _const_fill([3, H], 0.0); let mut v1 = _const_fill([3, H], 0.0)
    let mut m2 = _const_fill([H + 1, 1], 0.0); let mut v2 = _const_fill([H + 1, 1], 0.0)
    let b1 = 0.9; let b2 = 0.999; let ep8 = 0.00000001; let lrB = 0.02

    let mut cep = []; let mut cmae = []
    let mut steps_to_target = -1

    let mut e = 0
    while e <= epochsB {
        // checkpoint at scheduled steps (e = steps already taken)
        let mut is_ck = false
        let mut z = 0
        while z < len(ck) { if ck[z] == e { is_ck = true } z = z + 1 }
        if is_ck {
            let mae = heldout_mae(w1, w2, Xbt, bty, Bte, H, onesBt)
            cep.push(e); cmae.push(mae)
        }
        // first step at/under target (check EVERY step, not just checkpoints)
        if steps_to_target < 0 {
            let mae_now = heldout_mae(w1, w2, Xbt, bty, Bte, H, onesBt)
            if mae_now <= target_mae { steps_to_target = e }
        }
        if e == epochsB { e = e + 1 } else {
            let t = e + 1
            ag_tape_reset()
            let W1 = ag_var(tensor_from_array([3, H], w1))
            let W2 = ag_var(tensor_from_array([H + 1, 1], w2))
            let xb = ag_const(tensor_from_array([Bsmall, 3], Xbs))
            let ho = ag_const(tensor_from_array([Bsmall, H + 1], onesBs))
            let yb = ag_const(tensor_from_array([Bsmall, 1], bsy))
            let pred = mlp_forward(xb, ho, W1, W2, Bsmall, H)
            let loss = mse_loss(pred, yb, Bsmall)
            ag_backward(loss)
            let gW1 = ag_grad(W1); let gW2 = ag_grad(W2)
            let bc1 = 1.0 - pow(b1, to_float(t))
            let bc2 = 1.0 - pow(b2, to_float(t))
            let mut k = 0
            while k < 3 * H {
                let gg = gW1.data[k]
                m1[k] = b1 * m1[k] + (1.0 - b1) * gg
                v1[k] = b2 * v1[k] + (1.0 - b2) * gg * gg
                w1[k] = w1[k] - lrB * (m1[k] / bc1) / (sqrt(v1[k] / bc2) + ep8)
                k = k + 1
            }
            k = 0
            while k < H + 1 {
                let gg = gW2.data[k]
                m2[k] = b1 * m2[k] + (1.0 - b1) * gg
                v2[k] = b2 * v2[k] + (1.0 - b2) * gg * gg
                w2[k] = w2[k] - lrB * (m2[k] / bc1) / (sqrt(v2[k] / bc2) + ep8)
                k = k + 1
            }
            e = e + 1
        }
    }
    let final_mae = heldout_mae(w1, w2, Xbt, bty, Bte, H, onesBt)
    let r = #{}
    r["label"] = label
    r["cep"] = cep
    r["cmae"] = cmae
    r["steps_to_target"] = steps_to_target
    r["final_mae"] = final_mae
    return r
}

// held-out MAE for given flat weights on a packed held-out design.
fn heldout_mae(w1, w2, Xpk, ytrue, n: int, H: int, onesP) -> float {
    ag_tape_reset()
    let W1 = ag_var(tensor_from_array([3, H], w1))
    let W2 = ag_var(tensor_from_array([H + 1, 1], w2))
    let xb = ag_const(tensor_from_array([n, 3], Xpk))
    let ho = ag_const(tensor_from_array([n, H + 1], onesP))
    let pred = mlp_forward(xb, ho, W1, W2, n, H)
    let pv = ag_value(pred).data
    let mut acc = 0.0
    let mut i = 0
    while i < n { acc = acc + abs_f(pv[i] - ytrue[i]); i = i + 1 }
    return acc / to_float(n)
}

fn main() {
    println("=== QFORGE-PERF TRANSFER / REUSE TRAINED (stdlib/autograd reuse · d19 · g5) ===")
    println("model: 2-input -> 8-hidden(tanh) -> 1-output (bias-augmented)  ·  loss: MSE  ·  optim: Adam (ag_grad)")
    println("source A: f_A = 0.60 sin(1.30 x0)+0.50 x1^2-0.40 x0 x1+0.20 exp(0.5 x1)")
    println("target B: f_B = 0.66 sin(1.43 x0)+0.55 x1^2-0.44 x0 x1+0.22 exp(0.5 x1)   [A coeffs x1.10 — similar hydride]")
    println("")

    let H = 8
    let Btr = 60      // source A train samples
    let Bsmall = 40   // B fine-tune set — sized so COLD CAN reach the shared
                      // fixed point too (the transfer claim is about SPEED to a
                      // COMMON optimum, not a data-starvation gap). With this
                      // set both inits converge to the same B floor; only the
                      // #steps to reach a pre-registered target differs.
    let Bte = 40      // B held-out samples (disjoint)

    // ── (1) build SOURCE A train set, train A to convergence ──────────────
    seed_set(1234567)
    let mut a0 = []; let mut a1 = []; let mut ay = []
    let mut i = 0
    while i < Btr {
        let u = runi(-1.5, 1.5); let v = runi(-1.5, 1.5)
        a0.push(u); a1.push(v); ay.push(f_A(u, v)); i = i + 1
    }
    let Xa = pack_aug(a0, a1, Btr)
    let onesA = ones_lastcol(Btr, H + 1)

    // A weight init
    let mut wA1 = []; i = 0
    while i < 3 * H { wA1.push(runi(-0.6, 0.6)); i = i + 1 }
    let mut wA2 = []; i = 0
    while i < (H + 1) { wA2.push(runi(-0.6, 0.6)); i = i + 1 }

    let beta1 = 0.9; let beta2 = 0.999; let eps = 0.00000001
    let lr = 0.02
    let epochsA = 4000

    let mut mA1 = _const_fill([3, H], 0.0); let mut vA1 = _const_fill([3, H], 0.0)
    let mut mA2 = _const_fill([H + 1, 1], 0.0); let mut vA2 = _const_fill([H + 1, 1], 0.0)

    println("--- (1) TRAIN SOURCE A to convergence (the reused 'verified candidate' artifact) ---")
    let mut ep = 0
    while ep < epochsA {
        let t = ep + 1
        ag_tape_reset()
        let W1 = ag_var(tensor_from_array([3, H], wA1))
        let W2 = ag_var(tensor_from_array([H + 1, 1], wA2))
        let xb = ag_const(tensor_from_array([Btr, 3], Xa))
        let ho = ag_const(tensor_from_array([Btr, H + 1], onesA))
        let yb = ag_const(tensor_from_array([Btr, 1], ay))
        let pred = mlp_forward(xb, ho, W1, W2, Btr, H)
        let loss = mse_loss(pred, yb, Btr)
        ag_backward(loss)
        let gW1 = ag_grad(W1); let gW2 = ag_grad(W2)
        let bc1 = 1.0 - pow(beta1, to_float(t))
        let bc2 = 1.0 - pow(beta2, to_float(t))
        let mut k = 0
        while k < 3 * H {
            let gg = gW1.data[k]
            mA1[k] = beta1 * mA1[k] + (1.0 - beta1) * gg
            vA1[k] = beta2 * vA1[k] + (1.0 - beta2) * gg * gg
            wA1[k] = wA1[k] - lr * (mA1[k] / bc1) / (sqrt(vA1[k] / bc2) + eps)
            k = k + 1
        }
        k = 0
        while k < H + 1 {
            let gg = gW2.data[k]
            mA2[k] = beta1 * mA2[k] + (1.0 - beta1) * gg
            vA2[k] = beta2 * vA2[k] + (1.0 - beta2) * gg * gg
            wA2[k] = wA2[k] - lr * (mA2[k] / bc1) / (sqrt(vA2[k] / bc2) + eps)
            k = k + 1
        }
        if (ep == 0) || (ep == 500) || (ep == 4000 - 1) {
            println("  A epoch " + to_string(ep + 1) + "\tMSE = " + to_string(ag_value(loss).data[0]))
        }
        ep = ep + 1
    }
    println("  → A converged. wA1/wA2 captured as the transfer source.")
    println("")

    // ── build the SMALL B fine-tune set + the B held-out set ──────────────
    // (Continue the SAME deterministic stream so B draws are reproducible.)
    let mut bs0 = []; let mut bs1 = []; let mut bsy = []
    i = 0
    while i < Bsmall {
        let u = runi(-1.5, 1.5); let v = runi(-1.5, 1.5)
        bs0.push(u); bs1.push(v); bsy.push(f_B(u, v)); i = i + 1
    }
    let mut bt0 = []; let mut bt1 = []; let mut bty = []
    i = 0
    while i < Bte {
        let u = runi(-1.5, 1.5); let v = runi(-1.5, 1.5)
        bt0.push(u); bt1.push(v); bty.push(f_B(u, v)); i = i + 1
    }
    let Xbs = pack_aug(bs0, bs1, Bsmall)
    let onesBs = ones_lastcol(Bsmall, H + 1)
    let Xbt = pack_aug(bt0, bt1, Bte)
    let onesBt = ones_lastcol(Bte, H + 1)

    // B fine-tune recipe (identical for WARM & COLD): same lr, Adam, budget.
    let epochsB = 1500
    // checkpoint schedule for the held-out MAE curve (fine early to resolve
    // the warm/cold separation, sparse late once both are converged).
    let ck = [0, 5, 10, 25, 50, 75, 100, 150, 200, 300, 500, 1000, 1500]

    // PRE-REGISTERED target: an absolute B held-out MAE both inits CAN reach
    // (it sits above the shared converged floor ~0.03, so the gate measures
    // SPEED-to-a-common-target, not who can fit at all). Falsifier value.
    let target_mae = 0.05

    println("--- (2) WARM fine-tune on B (init FROM A's trained weights — d19 reuse) ---")
    let warm = finetune_B(wA1, wA2, "WARM", Xbs, onesBs, bsy, Xbt, onesBt, bty, ck, target_mae, epochsB, Bsmall)

    println("--- (3) COLD fine-tune on B (random init, fixed deterministic seed) ---")
    // fresh deterministic random init for COLD (distinct seed, fixed → reproducible)
    seed_set(98765432)
    let mut wc1 = []; i = 0
    while i < 3 * H { wc1.push(runi(-0.6, 0.6)); i = i + 1 }
    let mut wc2 = []; i = 0
    while i < (H + 1) { wc2.push(runi(-0.6, 0.6)); i = i + 1 }
    let cold = finetune_B(wc1, wc2, "COLD", Xbs, onesBs, bsy, Xbt, onesBt, bty, ck, target_mae, epochsB, Bsmall)

    // (3b) COLD-EXTENDED — SAME cold init, but a LARGE step budget. The g5
    // "same fixed point" clause asks whether COLD *eventually* reaches WARM's
    // optimum (the claim is WARM needs FEWER steps, not that COLD can't get
    // there). If COLD-extended converges to WARM's MAE → same fixed point,
    // WARM just got there faster. If it plateaus elsewhere → honest d6: cold
    // init is trapped in a worse basin (an even STRONGER reuse argument, but
    // not the literal "same fixed point" — reported honestly either way).
    let epochsExt = 20000
    let ckExt = [0, 1000, 5000, 10000, 20000]
    println("--- (3b) COLD-EXTENDED fine-tune (same cold init, " + to_string(epochsExt) + "-step budget — does cold REACH warm's optimum?) ---")
    seed_set(98765432)
    let mut wce1 = []; i = 0
    while i < 3 * H { wce1.push(runi(-0.6, 0.6)); i = i + 1 }
    let mut wce2 = []; i = 0
    while i < (H + 1) { wce2.push(runi(-0.6, 0.6)); i = i + 1 }
    let cold_ext = finetune_B(wce1, wce2, "COLD-EXT", Xbs, onesBs, bsy, Xbt, onesBt, bty, ckExt, target_mae, epochsExt, Bsmall)

    // ── g5 VERBATIM report ────────────────────────────────────────────────
    println("")
    println("--- B HELD-OUT MAE CURVE (" + to_string(Bte) + " disjoint B samples · target_mae=" + to_string(target_mae) + ") ---")
    println("  step\tWARM_MAE\tCOLD_MAE")
    let mut c = 0
    while c < len(ck) {
        // both curves share the same ck schedule
        let we = warm["cmae"][c]; let ce = cold["cmae"][c]
        println("  " + to_string(ck[c]) + "\t" + to_string(we) + "\t" + to_string(ce))
        c = c + 1
    }
    println("")
    println("--- COLD-EXTENDED B held-out MAE curve (large " + to_string(epochsExt) + "-step budget) ---")
    println("  step\tCOLD_EXT_MAE")
    c = 0
    while c < len(ckExt) {
        println("  " + to_string(ckExt[c]) + "\t" + to_string(cold_ext["cmae"][c]))
        c = c + 1
    }
    println("")
    let ws = warm["steps_to_target"]; let cs = cold["steps_to_target"]
    let cse = cold_ext["steps_to_target"]
    println("--- STEPS-TO-TARGET (first step with B held-out MAE <= " + to_string(target_mae) + ") ---")
    println("  WARM steps-to-target            = " + to_string(ws))
    println("  COLD steps-to-target (eq budget)= " + to_string(cs) + "   (-1 = not reached in " + to_string(epochsB) + " steps)")
    println("  COLD steps-to-target (extended) = " + to_string(cse) + "   (-1 = not reached in " + to_string(epochsExt) + " steps)")
    println("")
    println("--- CONVERGED (final) B held-out MAE — same-fixed-point check ---")
    let wf = warm["final_mae"]; let cf = cold["final_mae"]; let cfe = cold_ext["final_mae"]
    println("  WARM final MAE              = " + to_string(wf))
    println("  COLD final MAE (eq budget)  = " + to_string(cf))
    println("  COLD final MAE (extended)   = " + to_string(cfe))
    let fp_gap = abs_f(wf - cfe)
    println("  |WARM_final - COLD_EXT_final| = " + to_string(fp_gap) + "   (same-fixed-point gap)")
    println("")

    // ── PASS gate (d6 honest) ─────────────────────────────────────────────
    // Verbatim g5: WARM reaches B's target in FEWER steps than COLD, AND both
    // reach the same B fixed point.
    //   • fewer-steps: WARM reaches target; COLD (even extended) needs strictly
    //     more steps (or, at equal budget, fails to reach it at all).
    //   • same-fixed-point: WARM_final ≈ COLD_EXTENDED_final within tol — i.e.
    //     cold EVENTUALLY reaches warm's optimum, warm just got there faster.
    let warm_reaches = ws >= 0
    // "fewer steps": warm hits target; cold-extended either needs more steps
    // (cse > ws) or never reaches it even with the big budget (cse < 0).
    let fewer_steps = warm_reaches && ((cse < 0) || (cse > ws))
    let same_fp = fp_gap <= 0.02   // fixed-point agreement tolerance
    let beats = fewer_steps && same_fp
    if beats {
        println("F-QFORGE-TRANSFER-WARM-BEATS-COLD = 1")
        println("VERDICT=PASS — WARM (reuse from source A) reaches B's target in FEWER steps than COLD,")
        println("               and both converge to the SAME B fixed point (d19 reuse-lattice as transfer).")
    } else {
        println("F-QFORGE-TRANSFER-WARM-BEATS-COLD = 0")
        if !warm_reaches {
            println("VERDICT=FAIL — WARM never reached target_mae within budget (honest d6; numbers above).")
        } else if !fewer_steps {
            println("VERDICT=FAIL — WARM did NOT reach target in fewer steps than COLD (honest d6; numbers above).")
        } else {
            println("VERDICT=PARTIAL/HONEST(d6) — WARM dominates COLD on BOTH speed (" + to_string(ws)
                    + " vs " + to_string(cse) + " ext steps) AND final accuracy (" + to_string(wf)
                    + " vs " + to_string(cfe) + "), but they do NOT share a fixed point: cold init is")
            println("               TRAPPED in a worse local basin (|Δfinal|=" + to_string(fp_gap)
                    + " > tol). Reuse helps MORE than 'same optimum, faster' — it escapes a bad basin.")
        }
    }
}
