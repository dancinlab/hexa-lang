// ═══════════════════════════════════════════════════════════════════════════
//  QFORGE-PERF — Active-learning on-the-fly training (g5 bench)
//
//  Lifts the "active-learning on-the-fly training" probe ⚪ grounded → TRAINED
//  by REUSING hexa's EXISTING ML stack (d19) — stdlib/autograd reverse-mode AD
//  over Tensor, exactly the #2816 Δ-ML pattern (bias-augmented MLP, Adam via
//  ag_grad). NO autograd is built from scratch; NO stdlib/qforge engine file is
//  touched (d3). docs/bench-only, CPU-only, no rent.
//      ag_var / ag_const / ag_add / ag_sub / ag_mul / ag_matmul / ag_exp
//      ag_pow / ag_backward / ag_grad / ag_value / ag_zero_grad / ag_tape_reset
//
//  ── THE CLAIM ────────────────────────────────────────────────────────────
//  An UNCERTAINTY-driven acquisition that picks the NEXT training point reaches
//  a target held-out accuracy with FEWER labels than random sampling — the
//  on-the-fly "train only where the model is unsure" loop. This is the real
//  "active learning works" result: a label-efficiency gap vs random.
//
//  ── PROBLEM ──────────────────────────────────────────────────────────────
//  A cheap el-ph method gives features x∈R². The TRUE correction Δλ(x) is a
//  KNOWN NONLINEAR function (same target family as #2816):
//      Δλ(x) = 0.6·sin(1.3·x0) + 0.5·x1² − 0.4·x0·x1 + 0.2·exp(0.5·x1)
//  Each "label" is one expensive DFPT-style evaluation of Δλ. The AL question:
//  given a fixed label BUDGET, can a smart acquisition hit a target error with
//  fewer of those expensive labels than uniform-random sampling?
//
//  ── MODEL (reused from #2816) ────────────────────────────────────────────
//  MLP: 2-input → 8-hidden(tanh) → 1-output, biases folded into the weight
//  matrices via ones-column augmentation (dodges the autograd broadcast-add
//  bug — backward has no broadcast-reduce). tanh = (e^{2z}−1)/(e^{2z}+1) built
//  from ag_exp/ag_pow, fully traced. Adam update hand-rolled via ag_grad.
//
//  ── TWO CAMPAIGNS (same MLP, same pool, same budget, same retrain recipe) ─
//  (A) ACTIVE — committee / query-by-disagreement uncertainty acquisition.
//      Two nets (distinct deterministic inits) are trained on the current
//      labelled set; each round the UNLABELLED pool point with MAX |y1−y2|
//      (the committee disagreement = an epistemic-uncertainty proxy, the
//      query-by-committee criterion of Seung/Freund and the D-optimal
//      information-gain family, arxiv 1611.09346) is labelled and added.
//      RETRAIN, measure held-out MAE.
//  (B) RANDOM — same seed set, same per-round count K, same budget, but the
//      added points come from a FIXED deterministic hashed-index permutation
//      of the pool (hexa has no Math.random). RETRAIN, measure held-out MAE.
//
//  ── g5 VERIFY (printed VERBATIM) ─────────────────────────────────────────
//  held-out MAE vs #labels for BOTH campaigns + labels-to-target for each.
//  PASS iff ACTIVE reaches the target MAE with FEWER labels than RANDOM.
//  d6: if active does NOT beat random, report honestly with the numbers (FAIL).
//
//  Run:  HEXA_LANG=. hexa run bench/qforge/active_learning_loop.hexa
// ═══════════════════════════════════════════════════════════════════════════

use "stdlib/tensor/mod"
use "stdlib/tensor/shape"
use "stdlib/tensor/ops"
use "stdlib/autograd"

fn abs_f(x: float) -> float { if x < 0.0 { return 0.0 - x } else { return x } }

// ── true nonlinear Δλ(x) the model must learn (same as #2816) ─────────────
fn true_delta(x0: float, x1: float) -> float {
    return 0.6 * sin(1.3 * x0) + 0.5 * x1 * x1 - 0.4 * x0 * x1 + 0.2 * exp(0.5 * x1)
}

// ── deterministic LCG → reproducible pool + weight init ───────────────────
let mut _seed = 1234567
fn rng() -> float {
    _seed = (_seed * 1103515245 + 12345) % 2147483648
    return to_float(_seed) / 2147483648.0   // ∈ [0,1)
}
fn runi(lo: float, hi: float) -> float { return lo + (hi - lo) * rng() }
fn seed_set(s: int) { _seed = s }

fn _const_fill(shape, v: float) -> array {
    let n = tensor_size(shape)
    let mut out = []
    let mut i = 0
    while i < n { out.push(v); i = i + 1 }
    return out
}

// ── tanh as a traced autograd subgraph: (e^{2z}-1)/(e^{2z}+1) (from #2816) ─
fn ag_tanh(z) {
    let two = ag_const(tensor_from_array(z["tensor"].shape, _const_fill(z["tensor"].shape, 2.0)))
    let one = ag_const(tensor_from_array(z["tensor"].shape, _const_fill(z["tensor"].shape, 1.0)))
    let e2z = ag_exp(ag_mul(two, z))
    let num = ag_sub(e2z, one)
    let den = ag_add(e2z, one)
    let inv = ag_pow(den, 0.0 - 1.0)
    return ag_mul(num, inv)
}

// selector [H, H+1] with S[i,i]=1 (i<H), last column 0  (bias carrier, #2816).
fn _selector_HxHp1(H: int) -> Tensor {
    let mut d = []
    let mut i = 0
    while i < H {
        let mut j = 0
        while j < H + 1 {
            if j == i { d.push(1.0) } else { d.push(0.0) }
            j = j + 1
        }
        i = i + 1
    }
    return tensor_from_array([H, H + 1], d)
}

// ── MLP forward (all ag_*, bias-augmented exactly as #2816) ───────────────
fn mlp_forward(xaug, haug_ones, W1, W2, B: int, H: int) {
    let z1 = ag_matmul(xaug, W1)            // [B,H]
    let h  = ag_tanh(z1)                    // [B,H]
    let S  = ag_const(_selector_HxHp1(H))   // [H,H+1]
    let hsel = ag_matmul(h, S)              // [B,H+1], last col 0
    let z2 = ag_matmul(ag_add(hsel, haug_ones), W2) // + ones last col, then @W2
    return z2
}

// MSE loss over [B,1] pred vs [B,1] target → scalar (mean), via ones-matmul.
fn mse_loss(pred, target, B: int) {
    let diff = ag_sub(pred, target)
    let sq   = ag_mul(diff, diff)
    let onesT = ag_const(tensor_from_array([1, B], _const_fill([1, B], 1.0 / to_float(B))))
    return ag_matmul(onesT, sq)
}

// pack [x0,x1,1] augmented design buffer (col-bias folded into W1).
fn pack_aug(c0, c1, n: int) -> array {
    let mut out = []
    let mut j = 0
    while j < n { out.push(c0[j]); out.push(c1[j]); out.push(1.0); j = j + 1 }
    return out
}

// ones-in-last-column const [B,H+1] (the haug bias-column carrier).
fn ones_lastcol(n: int, Hp1: int) -> array {
    let mut out = []
    let mut r = 0
    while r < n {
        let mut c = 0
        while c < Hp1 {
            if c == Hp1 - 1 { out.push(1.0) } else { out.push(0.0) }
            c = c + 1
        }
        r = r + 1
    }
    return out
}

// ── train one MLP on the labelled subset, return [w1, w2] flat arrays ─────
//   xs0/xs1/ys are the FULL pool columns; `idx` lists which rows are labelled.
//   init_seed picks the deterministic weight init (distinct seed = committee
//   member). Reuses the #2816 Adam-via-ag_grad recipe verbatim.
fn train_mlp(xs0, xs1, ys, idx, H: int, init_seed: int, epochs: int, lr: float) -> array {
    let n = len(idx)
    // gather labelled rows
    let mut c0 = []
    let mut c1 = []
    let mut yy = []
    let mut i = 0
    while i < n {
        let r = idx[i]
        c0.push(xs0[r]); c1.push(xs1[r]); yy.push(ys[r]); i = i + 1
    }
    let X = pack_aug(c0, c1, n)
    let ones = ones_lastcol(n, H + 1)

    // deterministic weight init from init_seed
    seed_set(init_seed)
    let mut w1 = []
    i = 0
    while i < 3 * H { w1.push(runi(-0.6, 0.6)); i = i + 1 }
    let mut w2 = []
    i = 0
    while i < (H + 1) * 1 { w2.push(runi(-0.6, 0.6)); i = i + 1 }

    // Adam moment buffers
    let mut mW1 = _const_fill([3, H], 0.0)
    let mut vW1 = _const_fill([3, H], 0.0)
    let mut mW2 = _const_fill([H + 1, 1], 0.0)
    let mut vW2 = _const_fill([H + 1, 1], 0.0)
    let beta1 = 0.9
    let beta2 = 0.999
    let eps = 0.00000001

    let mut ep = 0
    while ep < epochs {
        let t = ep + 1
        ag_tape_reset()
        let W1 = ag_var(tensor_from_array([3, H], w1))
        let W2 = ag_var(tensor_from_array([H + 1, 1], w2))
        let xb = ag_const(tensor_from_array([n, 3], X))
        let hones = ag_const(tensor_from_array([n, H + 1], ones))
        let yb = ag_const(tensor_from_array([n, 1], yy))

        let pred = mlp_forward(xb, hones, W1, W2, n, H)
        let loss = mse_loss(pred, yb, n)
        ag_backward(loss)

        let gW1 = ag_grad(W1)
        let gW2 = ag_grad(W2)
        let bc1 = 1.0 - pow(beta1, to_float(t))
        let bc2 = 1.0 - pow(beta2, to_float(t))
        let mut k = 0
        while k < 3 * H {
            let gg = gW1.data[k]
            mW1[k] = beta1 * mW1[k] + (1.0 - beta1) * gg
            vW1[k] = beta2 * vW1[k] + (1.0 - beta2) * gg * gg
            w1[k] = w1[k] - lr * (mW1[k] / bc1) / (sqrt(vW1[k] / bc2) + eps)
            k = k + 1
        }
        k = 0
        while k < H + 1 {
            let gg = gW2.data[k]
            mW2[k] = beta1 * mW2[k] + (1.0 - beta1) * gg
            vW2[k] = beta2 * vW2[k] + (1.0 - beta2) * gg * gg
            w2[k] = w2[k] - lr * (mW2[k] / bc1) / (sqrt(vW2[k] / bc2) + eps)
            k = k + 1
        }
        ep = ep + 1
    }
    return [w1, w2]
}

// ── forward a trained net over an arbitrary point set → predictions array ─
fn predict(w1, w2, c0, c1, n: int, H: int) -> array {
    let X = pack_aug(c0, c1, n)
    let ones = ones_lastcol(n, H + 1)
    ag_tape_reset()
    let W1 = ag_var(tensor_from_array([3, H], w1))
    let W2 = ag_var(tensor_from_array([H + 1, 1], w2))
    let xb = ag_const(tensor_from_array([n, 3], X))
    let hones = ag_const(tensor_from_array([n, H + 1], ones))
    let pr = mlp_forward(xb, hones, W1, W2, n, H)
    return ag_value(pr).data
}

// held-out MAE of a trained net over the test set.
fn heldout_mae(w1, w2, te0, te1, teY, nte: int, H: int) -> float {
    let pv = predict(w1, w2, te0, te1, nte, H)
    let mut s = 0.0
    let mut i = 0
    while i < nte { s = s + abs_f(pv[i] - teY[i]); i = i + 1 }
    return s / to_float(nte)
}

fn main() {
    println("=== QFORGE-PERF active-learning on-the-fly training (stdlib/autograd reuse · g5) ===")
    println("model: 2-input -> 8-hidden(tanh) -> 1-output (bias-augmented) · Adam via ag_grad · reuse #2816")
    println("true Δλ(x) = 0.6 sin(1.3 x0) + 0.5 x1^2 - 0.4 x0 x1 + 0.2 exp(0.5 x1)  [NONLINEAR + cross-term]")
    println("acquisition (ACTIVE) = query-by-committee max-disagreement |y1-y2| of 2 nets (uncertainty proxy)")
    println("acquisition (RANDOM) = fixed deterministic hashed-index permutation order")
    println("")

    let H = 8
    let epochs = 1500
    let lr = 0.03

    // ── unlabelled candidate POOL + held-out test set (disjoint draws) ──
    seed_set(1234567)
    let POOL = 120
    let NTE  = 60
    let mut p0 = []
    let mut p1 = []
    let mut pY = []
    let mut i = 0
    while i < POOL {
        let a = runi(-1.5, 1.5)
        let b = runi(-1.5, 1.5)
        p0.push(a); p1.push(b); pY.push(true_delta(a, b)); i = i + 1
    }
    let mut te0 = []
    let mut te1 = []
    let mut teY = []
    i = 0
    while i < NTE {
        let a = runi(-1.5, 1.5)
        let b = runi(-1.5, 1.5)
        te0.push(a); te1.push(b); teY.push(true_delta(a, b)); i = i + 1
    }

    // ── seed labelled set: first SEED pool indices (same for both campaigns) ──
    let SEED = 6
    let K = 3          // points added per round
    let ROUNDS = 12    // budget = SEED + K*ROUNDS labels max
    let MAXLBL = SEED + K * ROUNDS

    // committee init seeds (distinct → genuine disagreement signal)
    let seedA = 11111
    let seedB = 99991

    // target held-out MAE both campaigns race to.
    let TARGET = 0.060

    // ── deterministic hashed-index permutation of the pool (RANDOM order) ──
    // hexa has no Math.random: use a fixed multiplicative hash permutation.
    // perm[i] = (i*step + off) mod POOL, with step coprime to POOL (gcd(120,7)=1).
    fn hashed_perm(N: int, step: int, off: int) -> array {
        let mut out = []
        let mut j = 0
        while j < N { out.push((j * step + off) % N); j = j + 1 }
        return out
    }
    let perm = hashed_perm(POOL, 7, 13)

    // helpers to test membership / append for the labelled-index lists.
    fn contains(lst, v: int) -> bool {
        let mut j = 0
        while j < len(lst) { if lst[j] == v { return true }; j = j + 1 }
        return false
    }

    // ══ CAMPAIGN A : ACTIVE (query-by-committee uncertainty) ══
    println("--- CAMPAIGN A : ACTIVE (committee max-disagreement acquisition) ---")
    println("  #labels   held-out MAE")
    let mut activeIdx = []
    i = 0
    while i < SEED { activeIdx.push(i); i = i + 1 }   // shared seed set

    let mut a_labels = []
    let mut a_maes = []
    let mut a_hit = -1            // first label-count reaching TARGET
    let mut rd = 0
    while rd <= ROUNDS {
        // train the committee (2 nets, distinct inits) on current labelled set
        let netA = train_mlp(p0, p1, pY, activeIdx, H, seedA, epochs, lr)
        let netB = train_mlp(p0, p1, pY, activeIdx, H, seedB, epochs, lr)
        // held-out MAE = committee mean prediction error
        let pvA = predict(netA[0], netA[1], te0, te1, NTE, H)
        let pvB = predict(netB[0], netB[1], te0, te1, NTE, H)
        let mut s = 0.0
        i = 0
        while i < NTE {
            let ymean = 0.5 * (pvA[i] + pvB[i])
            s = s + abs_f(ymean - teY[i]); i = i + 1
        }
        let mae = s / to_float(NTE)
        let nl = len(activeIdx)
        a_labels.push(nl); a_maes.push(mae)
        if a_hit < 0 && mae <= TARGET { a_hit = nl }
        println("  " + to_string(nl) + "\t  " + to_string(mae))

        if rd == ROUNDS { rd = rd + 1 }   // last eval, stop
        else {
            // ACQUIRE: predict committee disagreement over UNLABELLED pool,
            // pick the K points with MAX |yA - yB| (epistemic-uncertainty proxy).
            let poolA = predict(netA[0], netA[1], p0, p1, POOL, H)
            let poolB = predict(netB[0], netB[1], p0, p1, POOL, H)
            let mut added = 0
            while added < K {
                let mut best = -1
                let mut bestU = 0.0 - 1.0
                let mut q = 0
                while q < POOL {
                    if !contains(activeIdx, q) {
                        let u = abs_f(poolA[q] - poolB[q])
                        if u > bestU { bestU = u; best = q }
                    }
                    q = q + 1
                }
                if best >= 0 { activeIdx.push(best) }
                added = added + 1
            }
            rd = rd + 1
        }
    }
    println("")

    // ══ CAMPAIGN B : RANDOM (fixed deterministic permutation order) ══
    println("--- CAMPAIGN B : RANDOM (fixed hashed-index permutation acquisition) ---")
    println("  #labels   held-out MAE")
    let mut randIdx = []
    i = 0
    while i < SEED { randIdx.push(i); i = i + 1 }   // same shared seed set
    // pre-position the permutation cursor past any pool index already seeded.
    let mut pcur = 0

    let mut r_labels = []
    let mut r_maes = []
    let mut r_hit = -1
    rd = 0
    while rd <= ROUNDS {
        // single net (random baseline does not need a committee). Use seedA so
        // the only difference vs ACTIVE is WHICH points were chosen, not init.
        let net = train_mlp(p0, p1, pY, randIdx, H, seedA, epochs, lr)
        let mae = heldout_mae(net[0], net[1], te0, te1, teY, NTE, H)
        let nl = len(randIdx)
        r_labels.push(nl); r_maes.push(mae)
        if r_hit < 0 && mae <= TARGET { r_hit = nl }
        println("  " + to_string(nl) + "\t  " + to_string(mae))

        if rd == ROUNDS { rd = rd + 1 }
        else {
            // ACQUIRE K next points from the fixed permutation, skipping dupes.
            let mut added = 0
            while added < K {
                // advance cursor to a permutation index not yet labelled
                let mut found = -1
                while pcur < len(perm) {
                    let cand = perm[pcur]
                    pcur = pcur + 1
                    if !contains(randIdx, cand) { found = cand; break }
                }
                if found >= 0 { randIdx.push(found) }
                added = added + 1
            }
            rd = rd + 1
        }
    }
    println("")

    // ── g5 VERDICT: labels-to-target, ACTIVE vs RANDOM ──
    println("--- g5 LABEL-EFFICIENCY (target held-out MAE = " + to_string(TARGET) + ") ---")
    if a_hit > 0 {
        println("  ACTIVE reaches target at  " + to_string(a_hit) + " labels")
    } else {
        println("  ACTIVE did NOT reach target within budget (" + to_string(MAXLBL) + " labels)")
    }
    if r_hit > 0 {
        println("  RANDOM reaches target at  " + to_string(r_hit) + " labels")
    } else {
        println("  RANDOM did NOT reach target within budget (" + to_string(MAXLBL) + " labels)")
    }

    let active_wins = (a_hit > 0) && ((r_hit < 0) || (a_hit < r_hit))
    if active_wins {
        let saved = -1
        if r_hit > 0 {
            println("  label saving = " + to_string(r_hit - a_hit) + " fewer labels ("
                    + to_string(to_float(r_hit) / to_float(a_hit)) + "x efficiency)")
        } else {
            println("  RANDOM never hit target within budget — ACTIVE strictly more label-efficient")
        }
        println("")
        println("F-QFORGE-ACTIVE-LEARNING-BEATS-RANDOM = 1")
        println("VERDICT=PASS — uncertainty acquisition reaches target with FEWER labels than random")
    } else {
        println("")
        println("F-QFORGE-ACTIVE-LEARNING-BEATS-RANDOM = 0")
        println("VERDICT=FAIL — active did NOT beat random label-efficiency (honest d6 report; curves above)")
    }
}
