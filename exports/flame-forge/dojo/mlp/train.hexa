// flame-forge dojo kata — generated by stdlib/dojo/flame_forge
// slug: mlp  ·  kata: mlp
//
// A self-contained flame trainer over the stdlib/flame substrate
// (t_* tensor ops · t_matmul forge matmul · t_fill_lcg init ·
// opt_adamw_step optimizer). Runs on a CPU host today (the forge
// matmul falls back to the CPU farr path); a forge-GPU host
// accelerates the SAME code unchanged. Emits a DESCENT gate.
//
// spec: d=16  T=64  epochs=50  lr=0.01
// run: bash run.sh   (hexa run train.hexa)

use "stdlib/flame/tensor_lib"
use "stdlib/flame/optim_lib"

// relu(x) = max(x, 0) elementwise.
fn _relu(z: int, out: int, n: int) {
    let mut i = 0
    while i < n {
        let v = t_get(z, i)
        t_set(out, i, if v > 0.0 { v } else { 0.0 })
        i = i + 1
    }
}

fn main() {
    let d = 16       // input + hidden width
    let h = 16       // hidden width (= d for this kata)
    let N = 64       // sample count
    let epochs = 50
    let lr = 0.01

    // deterministic data: X (N×d), planted nonlinear target
    let X = t_zeros(N * d); t_fill_lcg(X, N * d, 1, 1.0)
    let y = t_zeros(N)
    let mut i = 0
    while i < N {
        let mut acc = 0.0
        let mut j = 0
        while j < d {
            let xv = t_get(X, i * d + j)
            acc = acc + (if xv > 0.0 { xv } else { 0.0 })
            j = j + 1
        }
        t_set(y, i, acc)
        i = i + 1
    }

    // params: W1 (d×h), b1 (h), W2 (h×1), b2 (1)
    let W1 = t_zeros(d * h); t_fill_lcg(W1, d * h, 7, 0.2)
    let b1 = t_zeros(h)
    let W2 = t_zeros(h * 1); t_fill_lcg(W2, h, 8, 0.2)
    let b2 = t_zeros(1)
    let gW1 = t_zeros(d * h); let gb1 = t_zeros(h)
    let gW2 = t_zeros(h * 1); let gb2 = t_zeros(1)
    let mW1 = t_zeros(d * h); let vW1 = t_zeros(d * h)
    let mb1 = t_zeros(h); let vb1 = t_zeros(h)
    let mW2 = t_zeros(h * 1); let vW2 = t_zeros(h * 1)
    let mb2 = t_zeros(1); let vb2 = t_zeros(1)

    let pre = t_zeros(N * h)    // X·W1 + b1
    let act = t_zeros(N * h)    // relu(pre)
    let dpre = t_zeros(N * h)
    let resid = t_zeros(N)

    let mut first_loss = 0.0
    let mut last_loss = 0.0
    let mut ep = 1
    while ep <= epochs {
        // forward layer 1: pre = X·W1 + b1 ; act = relu(pre)
        let xw1 = t_matmul(X, N, d, W1, h)
        let mut r = 0
        while r < N {
            let mut c = 0
            while c < h {
                t_set(pre, r * h + c, t_get(xw1, r * h + c) + t_get(b1, c))
                c = c + 1
            }
            r = r + 1
        }
        _relu(pre, act, N * h)
        // forward layer 2: yhat = act·W2 + b2
        let aw2 = t_matmul(act, N, h, W2, 1)
        let mut loss = 0.0
        let mut ii = 0
        while ii < N {
            let rr = t_get(aw2, ii) + t_get(b2, 0) - t_get(y, ii)
            t_set(resid, ii, rr)
            loss = loss + rr * rr
            ii = ii + 1
        }
        loss = loss / to_float(N)
        if ep == 1 { first_loss = loss }
        last_loss = loss

        // backward layer 2: dyhat = (2/N)·resid
        //   gW2[c] = Σ_i act[i,c]·dyhat_i ; gb2 = Σ_i dyhat_i
        let scale = 2.0 / to_float(N)
        let mut c2 = 0
        while c2 < h {
            let mut g = 0.0
            let mut k = 0
            while k < N { g = g + t_get(act, k * h + c2) * scale * t_get(resid, k); k = k + 1 }
            t_set(gW2, c2, g)
            c2 = c2 + 1
        }
        let mut gb2acc = 0.0
        let mut kb = 0
        while kb < N { gb2acc = gb2acc + scale * t_get(resid, kb); kb = kb + 1 }
        t_set(gb2, 0, gb2acc)

        // backward into hidden: dact[i,c] = dyhat_i·W2[c] ; dpre = dact·relu'(pre)
        let mut ri = 0
        while ri < N {
            let mut ci = 0
            while ci < h {
                let dact = scale * t_get(resid, ri) * t_get(W2, ci)
                let grad = if t_get(pre, ri * h + ci) > 0.0 { dact } else { 0.0 }
                t_set(dpre, ri * h + ci, grad)
                ci = ci + 1
            }
            ri = ri + 1
        }
        // gW1[j,c] = Σ_i X[i,j]·dpre[i,c] ; gb1[c] = Σ_i dpre[i,c]
        let mut j1 = 0
        while j1 < d {
            let mut c1 = 0
            while c1 < h {
                let mut g = 0.0
                let mut k = 0
                while k < N { g = g + t_get(X, k * d + j1) * t_get(dpre, k * h + c1); k = k + 1 }
                t_set(gW1, j1 * h + c1, g)
                c1 = c1 + 1
            }
            j1 = j1 + 1
        }
        let mut cb = 0
        while cb < h {
            let mut g = 0.0
            let mut k = 0
            while k < N { g = g + t_get(dpre, k * h + cb); k = k + 1 }
            t_set(gb1, cb, g)
            cb = cb + 1
        }

        opt_adamw_step(W1, gW1, mW1, vW1, d * h, lr, 0.9, 0.999, 0.00000001, 0.0, ep)
        opt_adamw_step(b1, gb1, mb1, vb1, h, lr, 0.9, 0.999, 0.00000001, 0.0, ep)
        opt_adamw_step(W2, gW2, mW2, vW2, h, lr, 0.9, 0.999, 0.00000001, 0.0, ep)
        opt_adamw_step(b2, gb2, mb2, vb2, 1, lr, 0.9, 0.999, 0.00000001, 0.0, ep)
        t_free(xw1); t_free(aw2)
        ep = ep + 1
    }
    print("  epoch-1 MSE   = "); println(to_string(first_loss))
    print("  epoch-"); print(epochs); print(" MSE = "); println(to_string(last_loss))
    if last_loss < first_loss {
        println("F-FLAMEFORGE-MLP = 1")
        println("PASS — loss strictly descends over training")
        return
    }
    println("F-FLAMEFORGE-MLP = 0")
    println("FAIL — loss did not descend")
}
