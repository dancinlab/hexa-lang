// flame-forge dojo kata — generated by stdlib/dojo/flame_forge
// slug: tiny-clm  ·  kata: tiny-clm
//
// A self-contained flame trainer over the stdlib/flame substrate
// (t_* tensor ops · t_matmul forge matmul · t_fill_lcg init ·
// opt_adamw_step optimizer). Runs on a CPU host today (the forge
// matmul falls back to the CPU farr path); a forge-GPU host
// accelerates the SAME code unchanged. Emits a DESCENT gate.
//
// spec: d=16  T=64  epochs=50  lr=0.01
// run: bash run.sh   (hexa run train.hexa)

use "stdlib/flame/tensor_lib"
use "stdlib/flame/optim_lib"

fn main() {
    let d = 16       // embedding width
    let V = 16             // tiny byte-vocab (ids 0..15)
    let T = 64       // sequence length
    let epochs = 50
    let lr = 0.01

    // deterministic toy corpus: ids[t] in 0..V, target = next id (cyclic)
    let ids = t_zeros(T); let tgt = t_zeros(T)
    let mut i = 0
    while i < T {
        let id = i % V
        t_set(ids, i, to_float(id))
        t_set(tgt, i, to_float((id + 1) % V))
        i = i + 1
    }

    // params: embed (V×d), head W (d×V), head b (V)
    let embed = t_zeros(V * d); t_fill_lcg(embed, V * d, 1, 0.3)
    let hW = t_zeros(d * V); t_fill_lcg(hW, d * V, 2, 0.2)
    let hB = t_zeros(V)
    let dembed = t_zeros(V * d); let dhW = t_zeros(d * V); let dhB = t_zeros(V)
    let m_e = t_zeros(V * d); let v_e = t_zeros(V * d)
    let m_hW = t_zeros(d * V); let v_hW = t_zeros(d * V)
    let m_hB = t_zeros(V); let v_hB = t_zeros(V)
    let logits = t_zeros(V); let probs = t_zeros(V)

    let mut first_ce = 0.0
    let mut last_ce = 0.0
    let mut ep = 1
    while ep <= epochs {
        // zero grads
        let mut z = 0
        while z < V * d { t_set(dembed, z, 0.0); z = z + 1 }
        let mut z2 = 0
        while z2 < d * V { t_set(dhW, z2, 0.0); z2 = z2 + 1 }
        let mut z3 = 0
        while z3 < V { t_set(dhB, z3, 0.0); z3 = z3 + 1 }
        let mut ce_sum = 0.0

        let mut t = 0
        while t < T {
            let id = to_int(t_get(ids, t))
            let tg = to_int(t_get(tgt, t))
            // logits[c] = Σ_k embed[id,k]·hW[k,c] + hB[c]
            let mut c = 0
            while c < V {
                let mut acc = 0.0
                let mut k = 0
                while k < d { acc = acc + t_get(embed, id * d + k) * t_get(hW, k * V + c); k = k + 1 }
                t_set(logits, c, acc + t_get(hB, c))
                c = c + 1
            }
            // softmax (numerically stable)
            let mut mx = t_get(logits, 0)
            let mut c2 = 1
            while c2 < V { if t_get(logits, c2) > mx { mx = t_get(logits, c2) } c2 = c2 + 1 }
            let mut Z = 0.0
            let mut c3 = 0
            while c3 < V { let e = exp(t_get(logits, c3) - mx); t_set(probs, c3, e); Z = Z + e; c3 = c3 + 1 }
            let mut c4 = 0
            while c4 < V { t_set(probs, c4, t_get(probs, c4) / Z); c4 = c4 + 1 }
            ce_sum = ce_sum - log(t_get(probs, tg) + 0.00000001)
            // dlogits = probs - onehot(tg)
            // grads: dhW[k,c] += embed[id,k]·dlogit_c ; dhB[c] += dlogit_c
            //        dembed[id,k] += Σ_c dlogit_c·hW[k,c]
            let mut c5 = 0
            while c5 < V {
                let dl = t_get(probs, c5) - (if c5 == tg { 1.0 } else { 0.0 })
                t_set(dhB, c5, t_get(dhB, c5) + dl)
                let mut k = 0
                while k < d {
                    t_set(dhW, k * V + c5, t_get(dhW, k * V + c5) + t_get(embed, id * d + k) * dl)
                    t_set(dembed, id * d + k, t_get(dembed, id * d + k) + dl * t_get(hW, k * V + c5))
                    k = k + 1
                }
                c5 = c5 + 1
            }
            t = t + 1
        }
        let ce = ce_sum / to_float(T)
        if ep == 1 { first_ce = ce }
        last_ce = ce

        opt_adamw_step(embed, dembed, m_e, v_e, V * d, lr, 0.9, 0.999, 0.00000001, 0.0, ep)
        opt_adamw_step(hW, dhW, m_hW, v_hW, d * V, lr, 0.9, 0.999, 0.00000001, 0.0, ep)
        opt_adamw_step(hB, dhB, m_hB, v_hB, V, lr, 0.9, 0.999, 0.00000001, 0.0, ep)
        ep = ep + 1
    }
    print("  epoch-1 mean CE   = "); println(to_string(first_ce))
    print("  epoch-"); print(epochs); print(" mean CE = "); println(to_string(last_ce))
    if last_ce < first_ce {
        println("F-FLAMEFORGE-TINYCLM = 1")
        println("PASS — loss strictly descends over training")
        return
    }
    println("F-FLAMEFORGE-TINYCLM = 0")
    println("FAIL — loss did not descend")
}
