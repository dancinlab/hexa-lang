// flame-forge dojo kata — generated by stdlib/dojo/flame_forge
// slug: linreg  ·  kata: linreg
//
// A self-contained flame trainer over the stdlib/flame substrate
// (t_* tensor ops · t_matmul forge matmul · t_fill_lcg init ·
// opt_adamw_step optimizer). Runs on a CPU host today (the forge
// matmul falls back to the CPU farr path); a forge-GPU host
// accelerates the SAME code unchanged. Emits a DESCENT gate.
//
// spec: d=16  T=64  epochs=50  lr=0.01
// run: bash run.sh   (hexa run train.hexa)

use "stdlib/flame/tensor_lib"
use "stdlib/flame/optim_lib"

fn main() {
    let d = 16       // feature width
    let N = 64       // sample count
    let epochs = 50
    let lr = 0.01

    // deterministic data: X (N×d), a planted true w (d) + bias, y = X·w_true + b_true
    let X = t_zeros(N * d); t_fill_lcg(X, N * d, 1, 1.0)
    let w_true = t_zeros(d); t_fill_lcg(w_true, d, 2, 1.0)
    let b_true = 0.5
    let y = t_zeros(N)
    let mut i = 0
    while i < N {
        let mut acc = 0.0
        let mut j = 0
        while j < d { acc = acc + t_get(X, i * d + j) * t_get(w_true, j); j = j + 1 }
        t_set(y, i, acc + b_true)
        i = i + 1
    }

    // params (init away from the solution) + AdamW state
    let w = t_zeros(d); t_fill_lcg(w, d, 7, 0.1)
    let b = t_zeros(1)
    let gw = t_zeros(d); let gb = t_zeros(1)
    let mw = t_zeros(d); let vw = t_zeros(d)
    let mb = t_zeros(1); let vb = t_zeros(1)

    let mut first_loss = 0.0
    let mut last_loss = 0.0
    let mut ep = 1
    while ep <= epochs {
        // forward: yhat = X·w + b ; residual r = yhat - y ; MSE = mean(r²)
        let yhat = t_matmul(X, N, d, w, 1)   // (N×d)·(d×1) → (N×1)
        let mut loss = 0.0
        let resid = t_zeros(N)
        let mut ii = 0
        while ii < N {
            let r = t_get(yhat, ii) + t_get(b, 0) - t_get(y, ii)
            t_set(resid, ii, r)
            loss = loss + r * r
            ii = ii + 1
        }
        loss = loss / to_float(N)
        if ep == 1 { first_loss = loss }
        last_loss = loss

        // closed gradient: dw[j] = (2/N) Σ_i r_i·X[i,j] ; db = (2/N) Σ_i r_i
        let mut jj = 0
        while jj < d {
            let mut g = 0.0
            let mut k = 0
            while k < N { g = g + t_get(resid, k) * t_get(X, k * d + jj); k = k + 1 }
            t_set(gw, jj, (2.0 / to_float(N)) * g)
            jj = jj + 1
        }
        let mut gbacc = 0.0
        let mut k2 = 0
        while k2 < N { gbacc = gbacc + t_get(resid, k2); k2 = k2 + 1 }
        t_set(gb, 0, (2.0 / to_float(N)) * gbacc)

        // AdamW step (forge optimizer; eq to ag_adamw_step builtin)
        opt_adamw_step(w, gw, mw, vw, d, lr, 0.9, 0.999, 0.00000001, 0.0, ep)
        opt_adamw_step(b, gb, mb, vb, 1, lr, 0.9, 0.999, 0.00000001, 0.0, ep)
        t_free(yhat); t_free(resid)
        ep = ep + 1
    }
    print("  epoch-1 MSE   = "); println(to_string(first_loss))
    print("  epoch-"); print(epochs); print(" MSE = "); println(to_string(last_loss))
    if last_loss < first_loss {
        println("F-FLAMEFORGE-LINREG = 1")
        println("PASS — loss strictly descends over training")
        return
    }
    println("F-FLAMEFORGE-LINREG = 0")
    println("FAIL — loss did not descend")
}
