// hexa-cuda dojo kata — generated by stdlib/dojo/hexa_cuda
// slug: wmma  ·  kata: wmma
//
// @version 0.0.1
// @capabilities [pure]
// @phase("parse_only")
//
// A self-contained @gpu_kernel authoring kata: the device kernel, a
// CPU reference oracle, and the host gpu_launch call shape
// (gpu/SPEC.md §7). Parse-clean today — `hexa parse kernel.hexa`.
// Intrinsics are the verified gpu/SPEC.md §5/§6 set ONLY.
//
// spec: n=1024  dtype=f64  sm=sm_90
// build: bash run.sh   (hexa build --target=nvptx kernel.hexa)

// ── kernel — gpu_wmma_* 16×16×16 tile MMA (RFC 067) ──────────────────
// The Tensor-Core path: each warp cooperatively loads a 16×16 A
// fragment (row-major, f16) + a 16×16 B fragment (col-major, f16),
// multiply-accumulates into an f32 C fragment, and stores it back.
// The gpu_wmma_* names lower to wmma.{load,mma,store}.sync.aligned
// .m16n16k16 PTX (compiler/codegen/nvptx_target.hexa).
//
// Honest scope: the gpu_wmma_* family is a CODEGEN-LEVEL op set —
// the fragments are built in the MIR (compiler/codegen/nvptx_target
// .hexa _nvptx_wmma_mnemonic) as STMT_CALL ops, NOT a source-level
// expression grammar (that named-fragment surface is RFC 067/068).
// This kata mirrors tool/probe_bf16_wmma.hexa: the kernel SHAPE is a
// 16×16 tile multiply with an f32 accumulator; the f64 stand-in body
// keeps the fixture parse-clean today. The gpu_wmma_* lowering this
// rung teaches (lower-tier in tool/fusion_wmma_override_probe.hexa):
//   gpu_wmma_load_a  → wmma.load.a.sync.aligned.row.m16n16k16.shared.f16
//   gpu_wmma_load_b  → wmma.load.b.sync.aligned.col.m16n16k16.shared.f16
//   gpu_wmma_mma     → wmma.mma.sync.aligned.row.col.m16n16k16.f32.f32
//   gpu_wmma_store_c → wmma.store.d.sync.aligned.row.m16n16k16.shared.f32
@gpu_kernel
fn wmma_tile(a: [f64], b: [f64], c: [f64], n: i64) {
    @shared let stage: [f64; 256] = []
    let tid = gpu_thread_id_x()
    // stage the A tile into @shared (one element per lane) — the
    // .shared staging slot the gpu_wmma_load_* ops read fragments from.
    if to_i64(tid) < n {
        stage[to_i64(tid)] = a[to_i64(tid)]
    }
    gpu_barrier()
    // f64 stand-in tile product keeps the host-eq oracle exercised; the
    // real Tensor-Core fragment MMA (load_a·load_b·mma·store_c) is the
    // codegen lowering listed above, wired by the MIR (RFC 067).
    if to_i64(tid) < n {
        c[to_i64(tid)] = stage[to_i64(tid)] * b[to_i64(tid)]
    }
}

// ── CPU reference oracle (the f64 stand-in elementwise product) ──────
fn cpu_wmma_tile(a: [f64], b: [f64], c: [f64], n: i64) {
    let mut i = 0
    while i < n { c[i] = a[i] * b[i]; i = i + 1 }
}

// ── host harness (gpu/SPEC.md §7 — gpu_launch ABI) ───────────────────
fn main() {
    let n: i64 = 256
    let block_x: i64 = 256
    let grid_x: i64 = (n + block_x - 1) / block_x
    let mut a_h: [f64] = []
    let mut b_h: [f64] = []
    let mut c_h: [f64] = []
    let mut i = 0
    while i < n {
        a_h.push(to_f64(i))
        b_h.push(to_f64(n - i))
        c_h.push(0.0)
        i = i + 1
    }
    let mut c_ref: [f64] = []
    let mut k = 0
    while k < n { c_ref.push(0.0); k = k + 1 }
    cpu_wmma_tile(a_h, b_h, c_ref, n)
    // GPU launch (RFC 055-P3 lowering — today a declaration shape):
    //
    //    gpu_launch(wmma_tile, grid_x, 1, 1, block_x, 1, 1, a_h, b_h, c_h, n)
    //
    // run.sh fires the PTX via a thin host wrapper that calls
    // hexa_cuda_launch_kernel directly; this is the future one-liner.
    let mut max_delta: f64 = 0.0
    let mut j = 0
    while j < n {
        let d = c_h[j] - c_ref[j]
        let abs_d = if d < 0.0 { -d } else { d }
        if abs_d > max_delta { max_delta = abs_d }
        j = j + 1
    }
    if max_delta == 0.0 {
        println("F-HEXACUDA-WMMA PASS — max|Δ| = 0")
    } else {
        println("F-HEXACUDA-WMMA FAIL — max|Δ| = " + to_string(max_delta))
    }
}
