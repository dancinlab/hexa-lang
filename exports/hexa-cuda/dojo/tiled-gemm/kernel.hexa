// hexa-cuda dojo kata — generated by stdlib/dojo/hexa_cuda
// slug: tiled-gemm  ·  kata: tiled-gemm
//
// @version 0.0.1
// @capabilities [pure]
// @phase("parse_only")
//
// A self-contained @gpu_kernel authoring kata: the device kernel, a
// CPU reference oracle, and the host gpu_launch call shape
// (gpu/SPEC.md §7). Parse-clean today — `hexa parse kernel.hexa`.
// Intrinsics are the verified gpu/SPEC.md §5/§6 set ONLY.
//
// spec: n=1024  dtype=f64  sm=sm_90
// build: bash run.sh   (hexa build --target=nvptx kernel.hexa)

// ── kernel — 2-D thread index + fma.rn.f64 contraction (§5) ──────────
// One thread computes one C element. A is row-major m×k, B is
// row-major k×n, C is row-major m×n. `acc + a*b` lowers to a single
// fma.rn.f64 (mirrors gpu/tests/gemm.hexa).
@gpu_kernel
fn gemm(a: [f64], b: [f64], c: [f64], m: i64, n: i64, k: i64) {
    let row = gpu_block_id_y() * gpu_block_dim_y() + gpu_thread_id_y()
    let col = gpu_block_id_x() * gpu_block_dim_x() + gpu_thread_id_x()
    if to_i64(row) < m {
        if to_i64(col) < n {
            let mut acc: f64 = 0.0
            let mut kk: i64 = 0
            while kk < k {
                acc = acc + a[to_i64(row) * k + kk] * b[kk * n + to_i64(col)]
                kk = kk + 1
            }
            c[to_i64(row) * n + to_i64(col)] = acc
        }
    }
}

// ── tiled variant — @shared A/B tiles + gpu_barrier (§6) ─────────────
// Each block stages a TILE×TILE sub-block of A and B into @shared,
// barriers, then accumulates from shared. The barrier-publish
// discipline (write shared → gpu_barrier() → cross-thread read) is
// the lesson of this rung.
@gpu_kernel
fn gemm_tiled(a: [f64], b: [f64], c: [f64], m: i64, n: i64, k: i64) {
    @shared let as_tile: [f64; 256] = []
    @shared let bs_tile: [f64; 256] = []
    let ty = gpu_thread_id_y()
    let tx = gpu_thread_id_x()
    let row = gpu_block_id_y() * gpu_block_dim_y() + gpu_thread_id_y()
    let col = gpu_block_id_x() * gpu_block_dim_x() + gpu_thread_id_x()
    let tile: i64 = 16
    let mut acc: f64 = 0.0
    let mut t: i64 = 0
    while t < k {
        // stage one tile column of A and one tile row of B
        let a_col = t + to_i64(tx)
        let b_row = t + to_i64(ty)
        if to_i64(row) < m {
            if a_col < k {
                as_tile[to_i64(ty) * tile + to_i64(tx)] = a[to_i64(row) * k + a_col]
            }
        }
        if b_row < k {
            if to_i64(col) < n {
                bs_tile[to_i64(ty) * tile + to_i64(tx)] = b[b_row * n + to_i64(col)]
            }
        }
        gpu_barrier()
        let mut kk: i64 = 0
        while kk < tile {
            acc = acc + as_tile[to_i64(ty) * tile + kk] * bs_tile[kk * tile + to_i64(tx)]
            kk = kk + 1
        }
        gpu_barrier()
        t = t + tile
    }
    if to_i64(row) < m {
        if to_i64(col) < n {
            c[to_i64(row) * n + to_i64(col)] = acc
        }
    }
}

// ── CPU reference oracle (tolerance — GEMM reduces) ──────────────────
fn cpu_gemm(a: [f64], b: [f64], c: [f64], m: i64, n: i64, k: i64) {
    let mut row = 0
    while row < m {
        let mut col = 0
        while col < n {
            let mut acc: f64 = 0.0
            let mut kk = 0
            while kk < k {
                acc = acc + a[row * k + kk] * b[kk * n + col]
                kk = kk + 1
            }
            c[row * n + col] = acc
            col = col + 1
        }
        row = row + 1
    }
}

// ── host harness (gpu/SPEC.md §7 — gpu_launch ABI) ───────────────────
fn main() {
    let m: i64 = 64
    let n: i64 = 64
    let k: i64 = 64
    let mut a_h: [f64] = []
    let mut b_h: [f64] = []
    let mut i = 0
    while i < m * k { a_h.push(to_f64(i % 7)); i = i + 1 }
    let mut j = 0
    while j < k * n { b_h.push(to_f64(j % 5)); j = j + 1 }
    let mut c_h: [f64] = []
    let mut p = 0
    while p < m * n { c_h.push(0.0); p = p + 1 }
    let mut c_ref: [f64] = []
    let mut q = 0
    while q < m * n { c_ref.push(0.0); q = q + 1 }
    cpu_gemm(a_h, b_h, c_ref, m, n, k)
    // GPU launch (RFC 055-P3 lowering — today a declaration shape):
    //
    //  let bx: i64 = 16
    //  let by: i64 = 16
    //  gpu_launch(gemm_tiled, (n + bx - 1) / bx, (m + by - 1) / by, 1,
    //                         bx, by, 1, a_h, b_h, c_h, m, n, k)
    //
    let mut max_delta: f64 = 0.0
    let mut r = 0
    while r < m * n {
        let d = c_h[r] - c_ref[r]
        let abs_d = if d < 0.0 { -d } else { d }
        if abs_d > max_delta { max_delta = abs_d }
        r = r + 1
    }
    let tol: f64 = 0.000001
    if max_delta <= tol {
        println("F-HEXACUDA-GEMM PASS — max|Δ| within tolerance")
    } else {
        println("F-HEXACUDA-GEMM FAIL — max|Δ| = " + to_string(max_delta))
    }
}
