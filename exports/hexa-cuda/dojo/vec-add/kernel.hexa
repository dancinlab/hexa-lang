// hexa-cuda dojo kata — generated by stdlib/dojo/hexa_cuda
// slug: vec-add  ·  kata: vec-add
//
// @version 0.0.1
// @capabilities [pure]
// @phase("parse_only")
//
// A self-contained @gpu_kernel authoring kata: the device kernel, a
// CPU reference oracle, and the host gpu_launch call shape
// (gpu/SPEC.md §7). Parse-clean today — `hexa parse kernel.hexa`.
// Intrinsics are the verified gpu/SPEC.md §5/§6 set ONLY.
//
// spec: n=1024  dtype=f64  sm=sm_90
// build: bash run.sh   (hexa build --target=nvptx kernel.hexa)

// ── kernel — flat 1-D thread index (gpu/SPEC.md §5) ──────────────────
@gpu_kernel
fn vadd(a: [f64], b: [f64], c: [f64], n: i64) {
    let gid = gpu_block_id_x() * gpu_block_dim_x() + gpu_thread_id_x()
    if to_i64(gid) < n {
        c[to_i64(gid)] = a[to_i64(gid)] + b[to_i64(gid)]
    }
}

// ── CPU reference oracle (byte-eq — FP64 add is exact) ───────────────
fn cpu_vadd(a: [f64], b: [f64], c: [f64], n: i64) {
    let mut i = 0
    while i < n { c[i] = a[i] + b[i]; i = i + 1 }
}

// ── host harness (gpu/SPEC.md §7 — gpu_launch ABI) ───────────────────
fn main() {
    let n: i64 = 1024
    let block_x: i64 = 256
    let grid_x: i64 = (n + block_x - 1) / block_x
    let mut a_h: [f64] = []
    let mut b_h: [f64] = []
    let mut c_h: [f64] = []
    let mut i = 0
    while i < n {
        a_h.push(to_f64(i))
        b_h.push(to_f64(n - i))
        c_h.push(0.0)
        i = i + 1
    }
    let mut c_ref: [f64] = []
    let mut k = 0
    while k < n { c_ref.push(0.0); k = k + 1 }
    cpu_vadd(a_h, b_h, c_ref, n)
    // GPU launch (RFC 055-P3 lowering — today a declaration shape):
    //
    //    gpu_launch(vadd, grid_x, 1, 1, block_x, 1, 1, a_h, b_h, c_h, n)
    //
    // run.sh fires the PTX via a thin host wrapper that calls
    // hexa_cuda_launch_kernel directly; this is the future one-liner.
    let mut max_delta: f64 = 0.0
    let mut j = 0
    while j < n {
        let d = c_h[j] - c_ref[j]
        let abs_d = if d < 0.0 { -d } else { d }
        if abs_d > max_delta { max_delta = abs_d }
        j = j + 1
    }
    let tol: f64 = 0.000001
    if max_delta <= tol {
        println("F-HEXACUDA-VECADD PASS — max|Δ| within tolerance")
    } else {
        println("F-HEXACUDA-VECADD FAIL — max|Δ| = " + to_string(max_delta))
    }
}
