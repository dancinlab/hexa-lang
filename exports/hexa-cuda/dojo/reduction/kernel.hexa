// hexa-cuda dojo kata — generated by stdlib/dojo/hexa_cuda
// slug: reduction  ·  kata: reduction
//
// @version 0.0.1
// @capabilities [pure]
// @phase("parse_only")
//
// A self-contained @gpu_kernel authoring kata: the device kernel, a
// CPU reference oracle, and the host gpu_launch call shape
// (gpu/SPEC.md §7). Parse-clean today — `hexa parse kernel.hexa`.
// Intrinsics are the verified gpu/SPEC.md §5/§6 set ONLY.
//
// spec: n=1024  dtype=f64  sm=sm_90
// build: bash run.sh   (hexa build --target=nvptx kernel.hexa)

// ── kernel — @shared block reduction + gpu_atomic_add (§5/§6) ────────
@gpu_kernel
fn reduce_sum(a: [f64], out: [f64], n: i64) {
    @shared let scratch: [f64; 256] = []
    let tid = gpu_thread_id_x()
    let gid = gpu_block_id_x() * gpu_block_dim_x() + gpu_thread_id_x()
    let mut v: f64 = 0.0
    if to_i64(gid) < n { v = a[to_i64(gid)] }
    scratch[to_i64(tid)] = v
    gpu_barrier()
    // tree reduction within the block (stride halving)
    let mut stride = gpu_block_dim_x() / 2
    while stride > 0 {
        if tid < stride {
            scratch[to_i64(tid)] = scratch[to_i64(tid)] + scratch[to_i64(tid + stride)]
        }
        gpu_barrier()
        stride = stride / 2
    }
    // thread 0 publishes the block partial into the global accumulator
    if tid == 0 {
        let _ = gpu_atomic_add(out, scratch[0])
    }
}

// ── CPU reference oracle (tolerance — reduction is order-dependent) ──
fn cpu_reduce_sum(a: [f64], out: [f64], n: i64) {
    let mut acc: f64 = 0.0
    let mut i = 0
    while i < n { acc = acc + a[i]; i = i + 1 }
    out[0] = acc
}

// ── host harness (gpu/SPEC.md §7 — gpu_launch ABI) ───────────────────
fn main() {
    let n: i64 = 1024
    let block_x: i64 = 256
    let grid_x: i64 = (n + block_x - 1) / block_x
    let mut a_h: [f64] = []
    let mut i = 0
    while i < n { a_h.push(to_f64(i % 7)); i = i + 1 }
    let mut out_h: [f64] = []
    out_h.push(0.0)
    let mut out_ref: [f64] = []
    out_ref.push(0.0)
    cpu_reduce_sum(a_h, out_ref, n)
    // GPU launch (RFC 055-P3 lowering — today a declaration shape):
    //
    //  gpu_launch(reduce_sum, grid_x, 1, 1, block_x, 1, 1, a_h, out_h, n)
    //
    let d = out_h[0] - out_ref[0]
    let abs_d = if d < 0.0 { -d } else { d }
    let tol: f64 = 0.000001
    if abs_d <= tol {
        println("F-HEXACUDA-REDUCE PASS — |Δ| within tolerance")
    } else {
        println("F-HEXACUDA-REDUCE FAIL — |Δ| = " + to_string(abs_d))
    }
}
